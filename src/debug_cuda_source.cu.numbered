 6188: #ifdef DONTCOMPILE
 6189: __device__ void computeVerticalAdvection(void) {
 6190:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6191: 
 6192:    sdbt(1:2,:,:)=0.d0
 6193: 
 6194:    const Side *side = FROM kernel;
 6195: 
 6196:    if(side->isDry) return;
 6197: 
 6198:    // If side is wet...
 6199: 
 6200: 
 6201:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6202:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6203:    double ws[nvrt] = {} // w @ side
 6204:    int icount = 0;
 6205:    for (int j=0; j<2; j++) {
 6206:       const Element *elem = side->elements[j];
 6207:        
 6208:       if(elem != nullptr) {
 6209:          icount++;
 6210:          for (int k=0; k<nvrt; k++) {
 6211:             ws[k] = ws[k] + elem->w[k];
 6212:          }
 6213:       }
 6214:    }  // for j
 6215: 
 6216:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6217:    ws = ws/icount;
 6218: 
 6219:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6220:    // Splines allow for a smooth transition between vertical levels.
 6221:    // Splines have continuity restrictions at the internal knots, but
 6222:    // we have to provide the 1st derivatives at the endpoints.
 6223:    const int kbs = side->kbs; 
 6224:    
 6225:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6226:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6227:    initCubicSpline(kbs, nvrt, side, ws, up)
 6228: 
 6229:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6230:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6231:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6232: 
 6233:    // Total advection (average onto side)
 6234:    const Node *node1 = side->nodes[0];
 6235:    const Node *node2 = side->nodes[1];
 6236:    for (int k=kbs(i); k<nvrt; k++) {
 6237: 
 6238:       if constexpr(ics==1) {
 6239:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6240:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6241:       } else {
 6242:          // XXX IMPLEMENT THIS
 6243:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6244:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6245:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6246:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6247:       }  // if ics
 6248: 
 6249: 
 6250:    }
 6251: }
 6252: #endif
 6253: 
 6254: 
 6255: extern "C" {
 6256:    __global__ void computeElemAverageGhat(void) {
 6257:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6258: 
 6259:       ELEM(elem);
 6260:       
 6261:       elem->ghat1= {0.0, 0.0};  
 6262: 
 6263:       if constexpr(ihydraulics != 0) {
 6264:          if (nhtblocks > 0 && elem->isblock) return;
 6265:       }
 6266: 
 6267:       if (elem->isDry) return;
 6268: 
 6269:       // Wet elements.
 6270:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6271:       // tidal potential, horizontal diffusion, and baroclinic etc
 6272:       // Remember to update both fb and F 
 6273:       // If ics=2, ghat1 are in eframe (ll)
 6274:       // cff1-3: coefficients for 2D/3D
 6275:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6276:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6277:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6278: 
 6279:       double av_cff1 = 0.0;  // av. for cff1
 6280:       double av_cff2 = 0.0;  // av. for cff2
 6281:       double av_cff3 = 0.0;  // av. for cff3
 6282:       double av_df = 0.0;  // av. for H^\alpha / H
 6283:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6284:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6285: 
 6286:       const int i34 = elem->i34;
 6287:       const int kb = elem->kb;
 6288: 
 6289:       for (int j=1; j<i34; j++) {
 6290:          // For each node and side in the element...
 6291: 
 6292:          const Node *node = elem->nodes[j];
 6293:          const Side *side = elem->sides[j];
 6294: 
 6295:          const double chi      = side->chi;
 6296:          const double veg_c2   = side->veg_c2;
 6297:          const double veg_beta = side->veg_beta;
 6298:          const double veg_h    = side->veg_h();
 6299:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6300: 
 6301:          // Node - const in elem
 6302:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6303:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6304: 
 6305:          if (elem->depth >= tip_dp) {
 6306:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6307:          }
 6308: 
 6309:          
 6310:          const double htot  = side->htot2();        // Total depth at the side
 6311:          const double zctr2 = side->zTopCanopy();  
 6312: 
 6313:          double cff1; 
 6314:          double cff2; 
 6315:          double cff3;   
 6316:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6317:          // coefficients applied to 2D/3D case 
 6318:             cff1 = side->hhat/htot;
 6319:             cff2 = 0.0;
 6320:             cff3 = 0.0;
 6321:          } else { //3D
 6322:             //Init for no-veg case
 6323:             cff1 = 1.0;
 6324:             cff2 = 1.0;
 6325:             cff3 = 0.0;
 6326: 
 6327:             if constexpr(iveg != 0) {
 6328:                // Computes coefficients used with vegetation terms G1, G2
 6329:                // cff1, cff3 are used for the first two terms in G1, G2:
 6330:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6331:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6332:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6333:                if(veg_h < 0.99*htot) { // submergent vegetation
 6334:                   cff1=1;
 6335:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6336:                   cff3 = veg_c;
 6337: 
 6338:                } else { // emergent vegetation
 6339:                   cff1 = 1.0/(1.0 + veg_c2);
 6340:                   cff2 = cff1;
 6341:                   cff3 = 0.0;
 6342: 
 6343:                }
 6344:             } // if iveg
 6345:          } //  2D/3D
 6346: 
 6347:          av_cff1 += cff1/i34;
 6348:          av_cff2 += cff2/i34;
 6349:          av_cff3 += cff3/i34;
 6350:          av_cff2_chi += cff2*chi/i34;
 6351:          av_cff3_chi += cff3*chi/i34;
 6352:          av_df += min(htot, veg_h)/(htot*i34);
 6353: 
 6354: 
 6355:          // btrack values: U^\star, U^{\star\alpha}
 6356:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6357:          Vector2 Ustar       = {0.0, 0.0}; 
 6358:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6359: 
 6360:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6361:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6362:          } else { //3D
 6363:             for (int k = side->kb; k < nvrt; k++) {
 6364:             
 6365:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6366:                Ustar += w2;
 6367: 
 6368:                if constexpr(iveg != 0) {
 6369:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6370:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6371:                        Ustar_alpha += zrat*w2; // XXXX
 6372:                    }
 6373:                }  // if iveg
 6374:             }  // for k
 6375:          }  //2D/3D
 6376:          
 6377: 
 6378:          // Add btrack & surface stress terms to \breve{G} first
 6379:          if constexpr(ics==1) {
 6380:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6381:          } else {
 6382:             // XXX IMPLEMENT THIS
 6383:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6384:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6385:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6386:          }  // if ics
 6387: 
 6388:          // Surface and bottom stress terms
 6389:          if constexpr(ics==1) {
 6390:             const Vector2 tau    = side->tau();
 6391:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6392: 
 6393:             // Term for surface and bottom stress
 6394:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6395:          } else {
 6396:             // XXX IMPLEMENT THIS
 6397:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6398:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6399:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6400:             // tau_x=(vn1+tt1)/2.d0
 6401:             // tau_y=(vn2+ss1)/2.d0
 6402:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6403:          }  // if ics
 6404: 
 6405:          
 6406: 
 6407:          // All terms in F,F^\alpha,f_b except baroclinic
 6408:          // F, f_b: all explicit terms excluding vegetation 
 6409:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6410:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6411:          const double coriolis = side->coriolis;
 6412:          Vector2 F  =  coriolis*side->U;  // F_x
 6413:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6414:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6415: 
 6416:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6417:             
 6418:             for (int k = side->kb; k < nvrt; k++) {
 6419:                if (zctr2 > side->zc[k-1]) {
 6420:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6421:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6422:                    Fa +=  coriolis*w2*zrat;
 6423:                } // if zctr2
 6424:             } // k
 6425:          } // iveg
 6426: 
 6427:          // Integrate horizontal viscosity force vertically
 6428:          for (int k=side->kb + 1; k<nvrt; k++) {
 6429:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 6430: 
 6431:             F += levelHorVisc;
 6432: 
 6433:             // Vegetation term
 6434:             if constexpr(iveg!=0) {
 6435:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6436:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6437:                   Fa += levelHorVisc*zrat;
 6438:                } 
 6439:             } // if iveg
 6440:          } // for k
 6441: 
 6442:          fb += side->d2uv[side->kb];
 6443: 
 6444: 
 6445:          // Add to ghat1
 6446:          if constexpr(ics==2) {
 6447:             // XXX IMPLEMENT THIS
 6448:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6449:             // bigf1=vn1; bigf2=vn2
 6450:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6451:             // botf1=vn1; botf2=vn2
 6452:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6453:             // bigfa1=vn1; bigfa2=vn2
 6454:          } // if ics
 6455: 
 6456:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6457:       } // for j (nodes and sides)
 6458: 
 6459:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6460:          
 6461:       // Finish off terms in F, F^\alpha and f_b
 6462:       const double grav3 = elem->mean(&Node::grav2);
 6463:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6464: 
 6465: 
 6466:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6467:       for (int j=1; j<i34; j++) { 
 6468:          // For each side in the element...
 6469:          const Side *side = elem->sides[j];
 6470:          const double chi = side->chi;
 6471: 
 6472:          const double htot = side->htot2();
 6473:          const double veg_h = side->veg_h();
 6474:          const Vector2 F  = htot*fb;
 6475:          const Vector2 Fa = min(htot, veg_h)*fb;
 6476: 
 6477:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6478:       } // for j
 6479: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6480:       //botf1 etc are already in elem frame
 6481:       elem->ghat1 += tmp/i34;
 6482: 
 6483:       // Baroclinic force
 6484:       if constexpr(ibc==0) {
 6485:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6486: 
 6487:          Vector2 Fa = {0.0, 0.0};
 6488:          Vector2 intGradRho = {0.0, 0.0};
 6489:          
 6490:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6491:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6492:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6493: 
 6494:             // \in F [m^2/s/s]
 6495:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6496:          }
 6497: 
 6498:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6499:          const Vector2 F = av_df*Fa; //approx
 6500:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6501: 
 6502:       } // if ibc
 6503: 
 6504: 
 6505: 
 6506:    }
 6507: 
 6508: } // extern "C"
 6509: 
 6510: 
 6511: 
 6512: #ifdef DONTCOMPILE
 6513: __global__ void checkMassConservation(Tracers* sumtr) {
 6514: 
 6515:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6516: 
 6517:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6518: 
 6519:    Element *elem = &(mesh->localElemData[i]);
 6520: 
 6521:    // Skip dry elements
 6522:    if (elem->isDry) return;
 6523: 
 6524:    // Local sum array for this thread
 6525:    double localSum[N_TRACERS] = {0.0};
 6526: 
 6527:    // Sum over vertical levels for this element
 6528:    const int kbe = elem->kbe;
 6529:    const double area = elem->area;
 6530: 
 6531:    for (int k = kbe; k < nvrt; k++) {
 6532:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6533:       
 6534:       // Accumulate tracer mass
 6535:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6536:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6537:       }
 6538:    }
 6539: 
 6540:    
 6541: 
 6542:    //  This function returns per element sums. A reduction must be done on the host side.
 6543: }
 6544: 
 6545: 
 6546: __global__ void transport(void) {
 6547: 
 6548:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6549: 
 6550:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6551: 
 6552:    Element *elem = &(mesh->localElemData[ie]);
 6553: 
 6554:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6555: 
 6556:                for (int m=0; m<ntr; m++) {
 6557:                   for (int k=kbe(ie); k<nvrt; k++) {
 6558:                      // Calculate each polynomial's weight 
 6559:                      wm=0.d0; sum1=0.d0; 
 6560:                      wm1=0.d0; wm2=0.d0; 
 6561:                      for (int i=0; i<elem->nweno2; i++) {
 6562:                   
 6563:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6564:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6565:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6566:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6567:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6568:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6569:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6570:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6571:                      // -----------------Hu and Shu (1999)'s method----------------
 6572:                      b4=b1+b2+b3
 6573: 
 6574: //Error: add PRODUCTION CPP
 6575: #ifdef DEBUG
 6576:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6577:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6578:                     call parallel_abort(errmsg)
 6579:                   }
 6580: #endif
 6581: 
 6582:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6583:                   // !----test-------------- 
 6584:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6585:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6586:                   // !wm(i)=wm1(i)*wm2(i)
 6587:                   // !---------------------- 
 6588:                   sum1=sum1+wm(i)
 6589:                 } // end for i
 6590: 
 6591:                 wm=wm/sum1
 6592: 
 6593:                 for (int j=0; j<elem->i34; j++) {
 6594: 
 6595:                   const Side *side  = elem->sides[j];
 6596:                   const Node *node1 = side->n1;
 6597:                   const Node *node2 = side->n2;
 6598: 
 6599:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6600:                      trsd=0.d0
 6601:                      for (int kk=0; kk<nquad; kk++) {
 6602:                         for (int i=0; i<elem->nweno2; i++) {
 6603:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6604:                         } // end for i   
 6605:                      } // end for kk
 6606:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6607:                   } // outward flux
 6608:                } // end for j=1,i34(ie) ! side
 6609:             }
 6610:          }
 6611:               
 6612: 
 6613: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6614: //             //   calculate each polynomial's weight 
 6615: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6616: //                 wm=0.d0; sum1=0.d0
 6617: //                 do i=1,nweno1(ie) !for each polynomial
 6618: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6619: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6620: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6621: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6622: //                   wm(i)=b2
 6623: //                   sum1=sum1+b2
 6624: //                   !wm(i)=1.d0
 6625: //                   !sum1=sum1+1.d0
 6626: 
 6627: // // Error: PRODUCTION
 6628: // #ifdef DEBUG
 6629: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6630: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6631: //                     call parallel_abort(errmsg)
 6632: //                   endif
 6633: // #endif
 6634: 
 6635: //                 enddo !i
 6636: //                 wm=wm/sum1 !final weight
 6637: 
 6638:                 for (int j=0; j<elem->i34; j++) { // side
 6639:                   const Side *side = elem->sides[j];
 6640:                   const Node *node1 = side->n1;
 6641:                   const Node *node2 = side->n2;
 6642: 
 6643:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6644:                     trsd=0.d0
 6645:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6646:                       for (int i=0; i<elem->nweno1; i++) {
 6647:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6648:                       }
 6649:                     enddo //kk
 6650:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6651:                   } // outward flux
 6652:                 } // end for j=1,i34(ie) ! side
 6653:               } // end for k; ntr 
 6654: 
 6655:             else !simple upwind method
 6656:               do j=1,i34(ie)
 6657:                 jsj=elside(j,ie)
 6658:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6659:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6660:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6661:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6662:                   endif
 6663:                 enddo  !vertical layers
 6664:               enddo !j=1,i34(ie) ! side
 6665:             endif !order of accuracy
 6666: 
 6667:          //  enddo !ie
 6668: // !$OMP     end do
