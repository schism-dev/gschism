 3818: 
 3819: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3820: 
 3821: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3822: 
 3823:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3824:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3825: 
 3826: 
 3827: 
 3828:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3829:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3830: 
 3831:    double fun_lat = 0.0;
 3832:    switch (jspc[idxComp]) {
 3833:       case 0:
 3834:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3835:          break;
 3836:       case 1:
 3837:          fun_lat = sin(2.0*lat);
 3838:          break;
 3839:       case 2:
 3840:          fun_lat = pow<2>(cos(lat));
 3841:          break;
 3842:       default:
 3843:          assert(false && "computeETP: invalid jspc");
 3844:    }
 3845:    
 3846:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3847: 
 3848: }
