 3898: __device__ __inline__ void Node::updateZCoordData(void) {
 3899: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3900: 
 3901:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3902:    // if (isDry2()) {
 3903:    //    kb = -1;  // XXXXXXXX KKKKK
 3904:    //    return;
 3905:    // }
 3906: 
 3907: 
 3908:    if constexpr(ivcor == 2) {  // SZ coordinates
 3909:       
 3910:       // Compute bottom level index
 3911:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3912:    } 
 3913:    else {  // if (ivcor == 1) Localized sigma
 3914:       // Do nothing
 3915:    }
 3916: 
 3917: 
 3918: }
