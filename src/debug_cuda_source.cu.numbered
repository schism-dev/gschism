 4460: // //       zt: desired interpolation level
 4461: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 4462: // //       s_in[0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 4463: // //     Outputs:
 4464: // //       s_out: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 4465: // //                   is used below bottom or above surface.
 4466: // //       ibelow: flag indicating if zt is below za(k1)
 4467: // //
 4468: 
 4469: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4470: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4471:    
 4472: //    ibelow = 0;
 4473: 
 4474: //    if (zt < za[k1]) {
 4475: //       // Below bottom
 4476: //       ibelow = 1;
 4477: //       s_out = s_in[k1];
 4478: 
 4479: //    } else if(zt>=za[k2]) {
 4480: //       // Above surface
 4481: //       s_out = s_in[k2];
 4482: 
 4483: //    } else {
 4484: //       // Normal case (between bottom and surface)
 4485:       
 4486: //       // Finds the level index using binary search
 4487: //       int l1 = k1;
 4488: //       int l2 = k2;
 4489: //       int k = (l1 + l2)/2;
 4490: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 4491: //           int k = (l1 + l2)/2;
 4492: //           if (zt >= za[k]) l1 = k;
 4493: //           else             l2 = k;
