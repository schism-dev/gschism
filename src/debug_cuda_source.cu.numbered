 2609: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2610: 
 2611: /**
 2612:  * This method performs backtracking from the side center until a time -dt back in time 
 2613:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2614:  * intermediate point.
 2615:  *
 2616:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2617:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2618:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2619:  * remaining time.
 2620:  * 
 2621:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2622:  * 
 2623:  * @param uuint, vvint, wwint: Velocities at the final point
 2624:  * @param jlev: Level at which the backtracking is performed
 2625:  * @param dt, dtbk: Tracking timesteps
 2626:  * @return: True if the backtracking was successful, false otherwise
 2627:  */
 2628: __inline__ __device__ bool Side::btrack(
 2629:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2630:       double dt,            // Tracking time
 2631:       double dtbk,          // Tracking timestep
 2632:       Vector3 &u_int        // Velocities at the initial point
 2633: ) const {
 2634: 
 2635:    // Start from side center
 2636:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2637: 
 2638:  
 2639:    double time_rm = dt; // Remaining time
 2640: 
 2641: 
 2642:    // Initial velocities
 2643:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2644: 
 2645:    // Find the element that is in the direction opposite to the velocity
 2646:    Element* curElem = findElementTowards(toVector2(u_int));
 2647:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2648: 
 2649: 
 2650:    // Nudges it towards the barycenter
 2651:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2652: 
 2653: 
 2654:    const int MAX_ITERATIONS = 100; 
 2655:    Element* nextElem = nullptr;
 2656:    int iter = 0;
 2657:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2658:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2659:    while(true) {
 2660: 
 2661:       // Calculate timestep
 2662:       double dtb = min(dtbk, time_rm);
 2663: 
 2664: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2665: 
 2666:       // Next point in the backtracking curve
 2667: // if (iter >= MAX_ITERATIONS - 50)  {
 2668: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2669: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2670: // }
 2671:         
 2672:       xt = x0 - dtb*u_int;
 2673: 
 2674:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2675:       assert(found && "Backtracking failed in btrack");
 2676: 
 2677: 
 2678:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2679:                       // then time_rm needs to be increased by the unused time.
 2680: 
 2681:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2682: 
 2683:       // If the velocity is too small, we stop the backtracking
 2684:       const double vmag = length(toVector2(u_int));
 2685:       if (vmag <= velmin_btrack) break;
 2686: 
 2687:       // The current point becomes the next segment's starting point.
 2688:       x0 = xt;
 2689:  
 2690:       curElem = nextElem;
 2691: 
 2692:       iter++;
 2693: 
 2694:       if (iter >= MAX_ITERATIONS) break;
 2695: 
 2696:       // if (iter >= MAX_ITERATIONS - 50) {
 2697:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 2698:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 2699:       //    }
 2700:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2701:    }
 2702: 
 2703:    assert(!curElem->isDry && "Final element is dry");
 2704: double shpDummyCoords[4];
 2705: if (!(curElem->containsPoint(toPoint2(xt)))) curElem->computeShapeCoords(toPoint2(xt), shpDummyCoords, Element::fiAnywhere);
 2706:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element"); 
 2707: 
 2708:    // Interpolate the velocities at the final point
 2709:    curElem->interpolateVelocities(xt, u_int);
 2710: 
 2711:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 2712: 
 2713: 
 2714: }
 2715: 
