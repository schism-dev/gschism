  474: struct Element {
  475: 
  476:    // Geometry information
  477:    int idx;               // Index of the element
  478:    int i34;               // Number of sides for the element 
  479:    Side *sides[4];        // Sides of the element
  480:    Node *nodes[4];        // Nodes of the element
  481:    Element *nghbElems[4]; // Neighbors of the element
  482: 
  483:    int kb;                    // Bottom index of the element
  484:    double area;               // Area of the element
  485:    double ssign[4];           // Sign associated with each side of an element
  486:    double radius;             // Element equivalent radii
  487: 
  488:    Frame frame;
  489: 
  490:    Vector2 gradPhi[4];       // Derivatives of shape functions
  491:    Vector2 gradEta;          // Gradient of free surface elevation
  492:    Vector2 gradPr;           // Gradient of pressure    
  493:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  494: 
  495:    bool isDry;                // True if the element is dry
  496: 
  497:    Vector3 center;            // Element center coordinates
  498:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  499:    double depth;              // Depth at element (min of all nodes)
  500:    double z[nvrt];            // z-coord  (local frame - vertical up)
  501: 
  502:    // Physical information
  503:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  504: 
  505:    static const bool isblock = false;              // Always false
  506: 
  507:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  508:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  509: 
  510:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  511: 
  512:    
  513: 
  514:    double vsource;            // Volumetric source/sink term [m^3/s]
  515: 
  516:    double rho[nvrt];          // Density at each prism center
  517:    double rho_mean[nvrt];     // Mean density at each prism center
  518:    CubicSpline rho_spl;
  519:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  520:    double rho_z[nvrt];        // First derivative of density at each prism center
  521:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  522: 
  523:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  524: 
  525:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  526:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  527: 
  528:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  529:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  530: 
  531:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  532:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  533:       // Find the local index of the node in the element (0,1,2,3)
  534:       int res = __ffs((nodes[0] == node) | 
  535:                      ((nodes[1] == node) << 1) | 
  536:                      ((nodes[2] == node) << 2) | 
  537:                      ((nodes[3] == node) << 3)) - 1;
  538:       
  539:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  540:       return res;
  541:    }
  542: 
  543:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  544:       // Find the local index of the side in the element (0,1,2,3)
  545:       int res = __ffs((sides[0] == side) | 
  546:                      ((sides[1] == side) << 1) | 
  547:                      ((sides[2] == side) << 2) | 
  548:                      ((sides[3] == side) << 3)) - 1;
  549:       
  550:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  551:       return res;
  552:    }
  553: 
  554: 
  555:    __inline__ __device__ int findLevel(double z1, int k) const {
  556:       // Starting at index k, find sequentially the level that contains z
  557: 
  558:       // if z is already betweeen z[k] and z[k+1], return k
  559:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  560:       else if (z1 < z[k]) { 
  561:          // Search for increasing levels
  562:          for (int kk = k; kk < nvrt - 1; kk++) {
  563:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  564:          }
  565:          return nvrt - 1;
  566:       }
  567:       else {
  568:          // Search for decreasing levels
  569:          for (int kk = k; kk > 0; kk--) {
  570:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  571:          }
  572:          return 0;
  573:       }
  574:    }
  575: 
  576:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  577:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  578: 
  579:    // Check if the element is dry using the more up-to-date elevation.
  580:    __inline__ __device__ bool isDry2(void) const;
