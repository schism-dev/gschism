 1470:    //    return nodes[idx] + idx;
 1471:    // }
 1472: 
 1473:    // // Get's the pointer to the element using the array of global pointers to elements
 1474:    // __device__ const Element *getGlobalElem(int je) {
 1475:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1476:    //    return elems[idx] + idx;
 1477:    // }
 1478: 
 1479:    // // Get's the pointer to the side using the array of global pointers to sides
 1480:    // __device__ const Side *getGlobalSide(int js) {
 1481:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1482:    //    return sides[idx] + idx;
 1483:    // }
 1484: 
 1485:    // // Get's the global index of local node idx
 1486:    // __device__ int getGlobalNodeIndex(int idx) {
 1487:    //    return idx + partNum * max_np;
 1488:    // }
 1489: 
 1490:    // // Get's the global index of local element idx
 1491:    // __device__ int getGlobalElemIndex(int idx) {
 1492:    //    return idx + partNum * max_ne;
 1493:    // }
 1494: 
 1495:    // // Get's the global index of local side idx
 1496:    // __device__ int getGlobalSideIndex(int idx) {
 1497:    //    return idx + partNum * max_ns;
 1498:    // }  
 1499: 
 1500:    __device__ Mesh(int partNum,
 1501:                    int npgb, int negb, int nsgb, 
 1502:                    int np, int ne, int ns,
 1503:                    int max_np, int max_ne, int max_ns, int nseg,
 1504:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1505:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1506:                    Node    **localNodeNeighNodesMem,
 1507:                    Element **localNodeNeighElemsMem,
 1508:                    double *partCoeffMatrixMem,
 1509:                    NodeBoundary *localNodeBoundaryMem,
 1510:                    SideBoundary *localSideBoundaryMem,
 1511:                    BoundarySegment *localSegmentMem,
 1512:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1513:                    double *cs, double *dcs
 1514:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1515:                        np(np), ne(ne), ns(ns),
 1516:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1517:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1518:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1519:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1520:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1521:                        localSegmentMem(localSegmentMem),
 1522:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1523:                        cs(cs), dcs(dcs),
 1524:                        coeffMatrixMem(partCoeffMatrixMem),
 1525:                        landBoundarySegment(true),
 1526:                        landBoundaryNode(true)
 1527:    {
 1528:       printf("Mesh constructor for partition %d\n", partNum);
 1529: 
