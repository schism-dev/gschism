 6002: extern "C" {
 6003: 
 6004:    __global__ void scaleGravity(double loadtide_coef) {
 6005: 
 6006: 
 6007:       NODE(node);
 6008: 
 6009:       // SAL option: scale gravity
 6010:       if constexpr(iloadtide==2) {  // simple const
 6011:          node->grav2 = grav*(1.0 - loadtide_coef);
 6012: 
 6013:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6014:         
 6015:           const double depth = max(node->depth, 0.0);
 6016:           const double tmp1 = sqrt(depth);
 6017:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6018:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6019:                              2.6969e-13*depth*depth*depth*tmp1;
 6020:           
 6021:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6022:           
 6023: 
 6024: 
 6025:           node->grav2 = grav*(1.0 - beta_bar);
 6026: 
 6027:       } else {  // iloadtide=0,1
 6028:           node->grav2 = grav;
 6029: 
 6030:       }
 6031: 
 6032:    }
 6033: 
