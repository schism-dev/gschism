 1988:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1989:                               const bool valid = (idx_node < mesh->np);                   
 1990: 
 1991: 
 1992: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1993:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1994:                            if (idx_node_bnd >= mesh->nbp) return;
 1995: 
 1996: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1997:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1998:                            if (idx_side_bnd >= mesh->nbs) return;  
