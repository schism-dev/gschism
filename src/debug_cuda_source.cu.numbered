 2303: /**
 2304:  * Find the element that contains the target point.
 2305:  * 
 2306:  * @param x0,y0,z0     Starting position coordinates
 2307:  * @param xt,yt,zt     Target position coordinates
 2308:  * @param dtb          Time step for tracking
 2309:  * @param u_int        Initial velocity components
 2310:  * @param nextElem     Starting/resulting element index
 2311:  * 
 2312:  * @return Status code of type trackExitCodes
 2313:  * 
 2314:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2315:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2316:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2317:  * as close the the segment AB as possible, the next point at each iteration is computed
 2318:  * along segment AB, but just after the current element.
 2319:  */
 2320: 
 2321: 
 2322: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2323: 
 2324:    constexpr int MAX_ITERATIONS = 40;
 2325: 
 2326:    int iter = 0;
 2327:    double fac = 0.00001;
 2328:    while (iter < MAX_ITERATIONS) {
 2329:       iter++;
 2330: 
 2331:       Bool4 isLeft, isObtuse, isBisector;
 2332:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2333: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2334:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2335: 
 2336: 
 2337:       if (isValid.none()) 
 2338:       // Inside the element if none of the edges is a valid continuation
 2339:       {
 2340:          // Just returns true and the element (curElem) is unchanged).
 2341:          // This means that the algorithm has found the element that contains the target point.
 2342:          return true;
 2343:       }
 2344:       else { // Outside the element
 2345: 
 2346:          // Outside this element. Pick the first valid exit side and cross.
 2347:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2348:          Element *prevElem = curElem;
 2349:          curElem = lastCrossSide->otherElem(curElem);
 2350: 
 2351:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2352:          // along the boundary.
 2353:          if (curElem == nullptr || curElem->isDry) {
 2354:          
 2355:             curElem = prevElem;
 2356:             return false;
 2357:          }
 2358:          
 2359:       }
 2360: 
 2361:    }
 2362: 
 2363:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2364: }
 2365: 
 2366: 
