  803:    __device__ Vector2 grad2(double *a) const
  804:    {
  805:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  806:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  807:       if (isQuad()) {
  808:          gx += a[3]*gradPhi[3].x;
  809:          gy += a[3]*gradPhi[3].y;
  810:       }
  811:       return {gx, gy};
  812:    }
  813: 
  814:    __device__ Vector2 grad2(double Node::* field) const
  815:    {
  816:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  817:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  818:       if (isQuad()) {
  819:          gx += (nodes[3]->*field)*gradPhi[3].x;
  820:          gy += (nodes[3]->*field)*gradPhi[3].y;
  821:       }
  822:       return {gx, gy};
  823:    }
