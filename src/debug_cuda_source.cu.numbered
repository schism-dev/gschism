 3109: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE(BTPoint &curPoint, Point3 &xt) {
 3110: // This function deals with the case where the point is moving outside the side. In other words, the point is in a side and it is moving out of the mesh or into a dry element.
 3111: // This is one of the cases where sliding along a side happens.
 3112: 
 3113:    // Instead of the interpolated velocity, we use the tangent of the velocity *at the side center* as the velocity of the point. 
 3114: 
 3115:    const Side *side = curPoint.side;
 3116: // // Debug: Check assertion conditions
 3117: // const bool isBnd = side->isBnd();
 3118: // Element *otherElem = side->otherElem(curPoint.elem);
 3119: // const bool otherIsDry = (otherElem != nullptr) ? otherElem->isDry : false;
 3120: // const bool curElemIsDry = (curPoint.elem != nullptr) ? curPoint.elem->isDry : true;
 3121:   
 3122: //   printf("DEAL_WITH_POINT_MOVING_OUTSIDE_SIDE: side->idx = %d, side->isBnd() = %d, curPoint.elem = %p, curPoint.elem->isDry = %d, otherElem = %p, otherElem->isDry = %d, assertion = %d\n",
 3123: //          side->idx, isBnd, curPoint.elem, curElemIsDry, otherElem, otherIsDry, (isBnd || otherIsDry));
 3124: 
 3125: //    // We start with a point on the side and it is moving along it. First we check that it is a side in a boundary.
 3126: //    assert(side->isBnd() || side->otherElem(curPoint.elem)->isDry && "Side is not a boundary between wet and dry elements (or boundary side)");
 3127: 
 3128:    const Vector2 tangent = side->t12();
 3129: 
 3130:    // In this case, the particle slides along the side. The next point is calculated using the tangent component of the side velocity.
 3131:    const Vector3 uSide = side->interpolateCenterVelocityVertically(xt);
 3132:    toVector2(curPoint.u) = dot(toVector2(uSide), tangent)*tangent;
 3133:    curPoint.u.z = uSide.z;
 3134: 
 3135:    // Computes the new location of the point sliding along the side. The z-coordinate is not changed because curPoint.u.z is also unchanged.
 3136:    xt = curPoint.x - curPoint.dt*curPoint.u;   
 3137: 
 3138:    // This is a situation we know how to handle. A point that is moving along a side.
 3139:    DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3140: 
 3141: }
 3142: 
 3143: __device__ void DEAL_WITH_POINT_MOVING_ALONG_SIDE(BTPoint &curPoint, Point3 &xt) {
 3144:    // This function deals with the case where the point is moving along a side.
 3145: 
 3146:    Side *side = curPoint.side;
 3147:    const Point3 x0 = curPoint.x;
 3148:    const Vector2 tangent = side->t12();
 3149:    const double len = length(toPoint2(xt) - toPoint2(x0));
 3150: 
 3151:    const double t = dot(toPoint2(xt) - side->n1->p, tangent)/side->len;  // Parameterization of the location of the point on the side (0 at n1, 1 at n2)
 3152: 
 3153:    if (curPoint.elem == nullptr) curPoint.elem = side->elems[0];  // elems[0] is never nullptr. This is done in case the element is not set yet.
 3154: assert(side->elems[0] != nullptr && "side->elems[0] is nullptr");
 3155: // if (side->elems[0] != nullptr) printf("PPPP side->elems[0]->isDry = %d\n", side->elems[0]->isDry);
 3156: // if (side->elems[1] != nullptr) printf("PPPP2 side->elems[1]->isDry = %d\n", side->elems[1]->isDry);
 3157: 
 3158:    if (t < geometricEpsilon) {
 3159:       // The point is at a node.
 3160:       curPoint.type = BTPoint::BTPointType::btNode;
 3161:       curPoint.node = side->n1;
 3162:       curPoint.side = side;
 3163:       curPoint.t = 0.0; // Not really needed.
 3164: 
 3165:       
 3166:    }
 3167:    else if (t > 1.0 - geometricEpsilon) {
 3168:       // The point is at a node.
 3169:       curPoint.type = BTPoint::BTPointType::btNode;
 3170:       curPoint.node = side->n2;
 3171:       curPoint.side = side;
 3172:       curPoint.t = 1.0; 
 3173: 
 3174:    }
 3175:    else {
 3176:       // The point is along the side.
 3177:       curPoint.type = BTPoint::BTPointType::btSide;
 3178:       curPoint.node = nullptr;
 3179:       curPoint.side = side;
 3180:       curPoint.t = t;
 3181:       
 3182:    }
 3183: if (curPoint.t != t) printf("YYY2 curPoint.t=%.17f, t=%.17f\n", curPoint.t, t);
 3184:    toPoint2(curPoint.x) = side->p_t(curPoint.t);
 3185: 
 3186:    // Computes the fraction between the lenth it should have traveled if the side was infinite and
 3187:    // the actual length it has traveled.
 3188:    const double lenOrig  = length(side->p_t(t, false) - toPoint2(x0));
 3189:    const double lenFinal = length(toPoint2(curPoint.x) - toPoint2(x0));
 3190:    const double fractionOfLength = lenFinal/lenOrig;
 3191:   
 3192:    curPoint.x.z = (1.0 - fractionOfLength)*x0.z + fractionOfLength*xt.z;   
 3193:    curPoint.dt = curPoint.dt*fractionOfLength; 
 3194: 
 3195: addDebugPlot(x0, curPoint.x, 0xFF010F, 'x');
 3196: }
 3197: 
 3198: __device__ void DEAL_WITH_POINT_MOVING_OUTSIDE_NODE(BTPoint &curPoint, Point3 &xt) {
 3199: // This function deals with the case where the point is moving outside from a node. In other words, the point is in a node and it is moving out of the mesh or into a dry element.
 3200: 
 3201:    const Element *elem = curPoint.elem;
 3202:    const Node *node    = curPoint.node;
 3203:    const Point3 x0     = curPoint.x;
 3204: 
 3205: curPoint.t = 0.0;
 3206: return;
 3207: 
 3208:    // computes the sides that delimit the contiguous block of wet elements containing elem
 3209: 
 3210:    assert(elem != nullptr && "elem is nullptr");
 3211:    assert(!elem->isDry && "elem is dry");
 3212:    assert(node != nullptr && "node cannot be nullptr");
 3213: 
 3214:    const int numSides = node->numSides;
 3215: 
 3216:    int idxStartWet = 0;      // First wet side index
 3217:    int idxEndWet = numSides; // Last wet side index
 3218: 
 3219: printf("BBBBB numSides = %d\n", numSides);
 3220: 
 3221: 
 3222: 
 3223:    // Finds the first wet side index
 3224:    for (int i = 0; i < numSides; i++) {
 3225:       const int prevIdx = (i + numSides - 1) % numSides;
 3226: if (it>=141) printf("BBBBB i = %d, prevIdx = %d, numSides = %d, node = %p\n", i, prevIdx, numSides, node);
 3227: if (it>=141) printf("BBBBB node->idx = %d, node->sides = %p\n", node->idx, node->sides);
 3228: if (it>=141) printf("BBBBB i = %d, node->sides[prevIdx] = %p, node->sides[i] = %p\n", i, node->sides[prevIdx], node->sides[i]);
 3229: // if (it>=135 && node != nullptr) printf("BBBBB prevIdx = %d, i = %d, node->sides[prevIdx] = %p, node->sides[i] = %p\n", prevIdx, i, node->sides[prevIdx], node->sides[i]);
 3230:       if (node->sides[prevIdx]->isDry && !node->sides[i]->isDry) idxStartWet = i;
 3231: if (it>=141) printf("BBBBB idxStartWet = %d, elem->containsSide(node->sides[i]) = %d\n", idxStartWet, elem->containsSide(node->sides[i]));
 3232:       if (elem->containsSide(node->sides[i])) break;
 3233:    }
 3234: 
 3235:    // Finds the last wet side index
 3236:    for (int i = numSides - 1; i >= 0; i--) {
 3237:       const int nextIdx = (i + 1) % numSides;
 3238: 
 3239:       if (node->sides[nextIdx]->isDry && !node->sides[i]->isDry) idxEndWet = i - 1;
 3240: 
 3241:       if (elem->containsSide(node->sides[nextIdx])) break;
 3242:    }
 3243: 
 3244: if (it>=141) printf("BBBBB idxEndWet = %d, elem->containsSide(node->sides[i]) = %d\n", idxEndWet, elem->containsSide(node->sides[idxEndWet]));
 3245: 
 3246:    // At this point idxStartWet and idxEndWet are the indices of the first and last wet sides in the contiguous block of wet sides containing elem.
 3247:    // If idxStartWet == 0 and idxEndWet == numSides - 1, all the sides are wet. This is only possible if the node is a boundary node.
 3248: 
 3249:    // These two sides are the ones that delimit the contiguous block of wet sides containing elem.
 3250:    Side *s1 = node->sides[idxStartWet];
 3251:    Side *s2 = node->sides[idxEndWet];
 3252: 
 3253:    assert(idxStartWet != 0 || idxEndWet != numSides - 1 || s1->sideBnd != nullptr || s2->sideBnd != nullptr && "Node is not a boundary node");
 3254: 
 3255:    // Now, there are two possibilities: 
 3256:    // - If any (or both) side velocities point away from the node, the point will slide along the side with the highest velocity component pointing away from the node.
 3257:    // - If both side velocities point towards the node, This is considered a death trap and the algorithm will stop here.
 3258:    const Vector3 uSide1 = s1->interpolateCenterVelocityVertically(xt);
 3259:    const Vector3 uSide2 = s2->interpolateCenterVelocityVertically(xt);
 3260:    const double u1tan = -dot(toVector2(uSide1), s1->t(node));  // s1->t(node) is the unitary tangent vector to the side s1 pointing towards 'node'.
 3261:    const double u2tan = -dot(toVector2(uSide2), s2->t(node));  // s2->t(node) is the unitary tangent vector to the side s2 pointing towards 'node'.
 3262: if (it>=141) printf("BBBBB node->idx = %d, elem->idx = %d, u1tan = %f, u2tan = %f\n", node->idx, elem->idx, u1tan, u2tan);
 3263:    if (u1tan < 0.0 || u2tan < 0.0) {
 3264:       // The point will slide along the side with the highest velocity component pointing away from the node.
 3265:       if (u1tan < u2tan) {
 3266:          // sliding along s1
 3267:          toVector2(curPoint.u) = u1tan * s1->t(node);
 3268:          curPoint.u.z = uSide1.z;
 3269:          xt = x0 - curPoint.dt*curPoint.u;
 3270:          curPoint.side = s1;
 3271: 
 3272:          // Once xt and curPoint.u are updated to slide along s1, we can call the function to deal with the case where the point is moving along a side.
 3273:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3274:       }
 3275:       else {
 3276:          // sliding along s2
 3277:          toVector2(curPoint.u) = u2tan * s2->t(node);
 3278:          curPoint.u.z = uSide2.z;
 3279:          xt = x0 - curPoint.dt*curPoint.u;
 3280:          curPoint.side = s2;
 3281: 
 3282:          // Once xt and curPoint.u are updated to slide along s2, we can call the function to deal with the case where the point is moving along a side.
 3283:          DEAL_WITH_POINT_MOVING_ALONG_SIDE(curPoint, xt);
 3284:       }
 3285: 
 3286: 
 3287:       return;
 3288:    }
 3289:    else
 3290:    {
 3291:       // DEATH TRAP: Both side velocities point towards the node. This is considered a death trap and the algorithm will stop here.
 3292: printf("DEATH TRAP: Both side velocities point towards the node. IMPLEMENT THIS CASE\n");
 3293: curPoint.t = 0.0;
 3294: return;
 3295:       assert(false && "DEATH TRAP: Both side velocities point towards the node. IMPLEMENT THIS CASE");
 3296:    }
 3297: 
 3298: 
 3299: 
 3300: }
 3301: 
 3302: 
 3303: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3304: 
 3305: 
 3306: __device__ void Node::updateKb(void) {
 3307: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3308: 
 3309:    if constexpr(ivcor == 1) return;
 3310: 
 3311: 
 3312:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3313: 
 3314:    if constexpr(ivcor == 2) {  // SZ coordinates
 3315:       
 3316:       // Compute bottom level index
 3317:       if (depth <= mesh->h_s) {
 3318:          kb = izlev;   
 3319:          
 3320:       } else {
 3321:          kb = -1;
 3322:          int L = 0;
 3323:          int R = nzlev; 
 3324:          
 3325:          while (L <= R) {
 3326:             int M = (R + L) / 2;
 3327: 
 3328: 
 3329:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3330:             
 3331:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3332:                R = M;
 3333:             } else {
 3334:                L = M;
 3335:             }
 3336: 
 3337:             if (R - L == 1) {
 3338:                kb = L;
 3339:                break;
 3340:             }
 3341:          }
 3342: 
 3343:          // Checks that the binary search was successful
 3344:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3345:        
 3346:       }
 3347:    } 
 3348: }
 3349: 
 3350: 
 3351: __device__ __inline__ void Node::updateZCoordData(void) {
 3352: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3353: 
 3354:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3355:    // if (isDry2()) {
 3356:    //    kb = -1;  // XXXXXXXX KKKKK
 3357:    //    return;
 3358:    // }
 3359: 
 3360: 
 3361:    if constexpr(ivcor == 2) {  // SZ coordinates
 3362:       
 3363:       // Compute bottom level index
 3364:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3365:    } 
 3366:    else if (ivcor == 1) {  // Localized sigma
 3367:       // Do nothing
 3368:    }
 3369: 
 3370: 
 3371: }
