 9510: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9511:    // Get the value of a variable from an side
 9512:    // varName is the name of the variable to get
 9513:    // var is the array to store the value
 9514:    // k is the vertical level index of the variable to get
 9515:    SIDE_BND(sideBnd);   
 9516: 
 9517:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9518:    if (sideBnd->segment->isLand) idx = -7;
 9519: 
 9520:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9521:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9522: 
 9523: }
