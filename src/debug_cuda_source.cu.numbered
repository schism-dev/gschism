 9827: extern "C" __global__ void getNodeVarFunc(int varCode, double *res) {
 9828: 
 9829:    NODE(node);
 9830: 
 9831:    switch (varCode) {
 9832:       case (int)VarCode::outputCoords:
 9833:          const Point2 coords = node->outputCoords();
 9834:          res[node->idx*2    ] = coords.x;
 9835:          res[node->idx*2 + 1] = coords.y;
 9836:          break;
 9837:    }
 9838: }
