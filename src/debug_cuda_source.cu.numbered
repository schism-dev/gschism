 8049: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8050:    Node *nodes = mesh->localNodeData;
 8051: 
 8052:    *addr = nodes;
 8053:    *sizeNode = sizeof(Node);
 8054: 
 8055:    switch (varCode) {
 8056:       case (int)VarCode::depth:
 8057:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8058:          *sizeType = sizeof(double);
 8059:          break;
 8060:       case (int)VarCode::eta:
 8061:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8062:          *sizeType = sizeof(double);
 8063:          break;
 8064:       case (int)VarCode::x:
 8065:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8066:          *sizeType = sizeof(Vector2);
 8067:          break;
 8068:       case (int)VarCode::z:
 8069:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8070:          *sizeType = sizeof(double);
 8071:          break;
 8072:       case (int)VarCode::kb:
 8073:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8074:          *sizeType = sizeof(int);
 8075:          break;
 8076:       case (int)VarCode::isdry:
 8077:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8078:          *sizeType = sizeof(int);
 8079:          break;         
 8080:       case (int)VarCode::w:
 8081:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8082:          *sizeType = sizeof(double);
 8083:          break;
 8084:       case (int)VarCode::u:
 8085:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8086:          *sizeType = sizeof(Vector2);
 8087:          break;         
 8088:       default:
 8089:          *offset = -1;    
 8090:    }  
 8091:    
 8092: }
