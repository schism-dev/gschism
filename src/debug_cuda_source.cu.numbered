 2512: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2513:    // Returns the value of the velocity at the side center
 2514:    const double w1 = getBoundaryArrayValueWeight();
 2515:    const double w2 = 1.0 - w1;
 2516:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2517:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2518: 
 2519:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2520: }
