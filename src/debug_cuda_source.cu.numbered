  291: 
  292: 
  293: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  294:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  295:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  296: }
  297: 
  298: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  299:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  300:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  301: }
  302: 
  303: 
  304: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  305:    x3 = y1*z2 - y2*z1;
  306:    y3 = x2*z1 - x1*z2;
  307:    z3 = x1*y2 - x2*y1;
  308: }
  309: 
  310: 
  311: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  312: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  313: 
  314:    const double radius2 = dot(p, p);
  315:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  316:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  317: 
  318:    rlon = atan2(p.y, p.x); // (-pi,pi]
  319: 
  320:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  321:       rlat = asin(p.z/sqrt(radius2));
  322:    } else {
  323:       rlat = asin(p.z/rearth_pole);
  324:    }
  325:   
  326: }
  327: 
  328: __inline__ __device__ void Error(const char* msg) {
  329:    printf("Error: %s\n", msg);
  330:    assert(false);
  331: }
