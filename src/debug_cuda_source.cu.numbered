 2795: 
 2796: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2797: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2798: // Returns the normal vector and the area of the element at this level
 2799:    
 2800:    double nx, ny, nz;
 2801: 
 2802:    if (isTri()) {
 2803:       // For triangles...
 2804: 
 2805:       // Indices of the nodes at level k, taking care of not going below the bed
 2806:       const int k0 = max(k, nodes[0]->kb);
 2807:       const int k1 = max(k, nodes[1]->kb);
 2808:       const int k2 = max(k, nodes[2]->kb);
 2809: 
 2810:       // Gets the element frame coordinates of the nodes at level k
 2811:       Point3 x0, x1, x2;
 2812:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2813:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2814:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2815:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2816: 
 2817:       } else {  // ics == 2
 2818:          Point2 h0, h1, h2;
 2819: 
 2820:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2821: 
 2822:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2823:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2824:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2825:       }
 2826: 
 2827:       const Vector3 n20 = x2 - x0;
 2828:       const Vector3 n10 = x1 - x0; 
 2829: 
 2830:       // Computes the cross product of vectors n20 and n10. 
 2831:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2832:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2833:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2834: 
 2835:   
 2836:    }
 2837:    else {
 2838:       // For quads...
 2839:       Point2 h0, h1, h2, h3;
 2840: 
 2841:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2842: 
 2843:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2844:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2845:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2846:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2847: 
 2848:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2849:       nx = n20.y*n31.z - n20.z*n31.y;
 2850:       ny = n20.z*n31.x - n20.x*n31.z;
 2851:       nz = n20.x*n31.y - n20.y*n31.x;
 2852: 
 2853:    }
 2854: 
 2855:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2856:    area3D = 0.5*len;
 2857: 
 2858:    const double inv_len = 1.0/len;
 2859: 
 2860:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2861: 
 2862: }
 2863: 
 2864: 
 2865: // Helper functions to get the 2D local node position for the Celestial walk
 2866: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2867:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2868:    const Node *node = getNodeInOrder(idx2);
 2869: 
 2870:    double z = 0.0;
 2871:    if constexpr(ics == 2) z = node->gz;
 2872:    
 2873:    Point3 p = toPoint3(node->p, z);
 2874: 
 2875:    return toPoint2(origSide->toLocalFrame(p));
 2876: }
 2877: 
 2878: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2879:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2880: }
 2881: 
 2882: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2883:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2884: // Computes the three per-side predicates needed for the celestial walk
 2885: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2886: //
 2887: // xt is in local frame coordinates for origSide if ics == 2.
 2888: //
 2889: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2890: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2891: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2892: // meaningless on triangles are masked to a safe value (see comments below).
 2893: {
 2894:    // Project all 4 corner positions once into the local 2D frame.
 2895:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2896:    // getLocalNodePosition only transforms/projects if ics == 2.
 2897:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2898:                         getLocalNodePosition(1, origSide), 
 2899:                         getLocalNodePosition(2, origSide), 
 2900:                         getLocalNodePosition(3, origSide)};
 2901: 
 2902:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2903:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2904:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2905:    // But still farther towards the target point from the current point.
 2906:    const Vector2 vt0 = xt - x0;
 2907:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2908:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2909:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2910: 
 2911:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2912:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2913: 
 2914: 
 2915: // if (origSide->idx == 2860848 && jlev == 46) {
 2916: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2917: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2918: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2919: // }
 2920:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2921:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2922:    //  here the orientation is baked into the corners array.)
 2923:    const int i3 = nxq(3);
 2924:    const Vector2 s0 = C[ 1] - C[ 0];
 2925:    const Vector2 s1 = C[ 2] - C[ 1];
 2926:    const Vector2 s2 = C[i3] - C[ 2];
 2927:    const Vector2 s3 = C[ 0] - C[i3];
 2928:    
 2929:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2930:    // The corners array is built from getNode in CCW order, so the orientation
 2931:    // is already correct and no ssign factor is needed in the formulas below.
 2932:    //
 2933:    // i3 = nxq(3): the index of the corner after side 2.
 2934:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2935:    //   Quad:     i3 == 3.
 2936:    //
 2937:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2938:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2939:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2940:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2941:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2942:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2943: 
 2944: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2945: 
 2946:    // For triangles, the corner after side 2 is the closing corner where
 2947:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2948:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2949:    // s0 for triangles, s3 for quads.
 2950:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2951: 
 2952:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2953:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2954:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2955:    //
 2956:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2957:    // result is false naturally. No sentinel needed.
 2958:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2959:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2960:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2961:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2962: 
 2963:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2964:    // on the "exit through side I" half of the corner cone, separated by the
 2965:    // approximate angular bisector of the celestial walk. The bisector is
 2966:    // perpendicular to the chord across the corner; the test is the sign of
 2967:    // (xt - corner_vertex) projected onto that chord.
 2968:    //
 2969:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2970:    // (the validity rule sets valid_3 = false), so its computed value for
 2971:    // triangles doesn't matter. No sentinel needed.
 2972:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2973:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2974:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2975:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2976: 
 2977: }
 2978: 
 2979: 
 2980: __inline__ __device__ double Element::computeSignedArea(void) const {
 2981:    // Compute the area of the element
 2982: 
 2983:    Point2 x0, x1, x2, x3;
 2984:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2985: 
 2986: 
 2987:    double res = signedArea(x0, x1, x2);
 2988: 
 2989:    // In the quad case we need to add the area of the other triangle.
 2990:    if (isQuad()) {
 2991:       x3 = getLocalHorizontalNodePosition(3);
 2992:       double ar1 = signedArea(x0, x2, x3);
 2993:       double ar2 = signedArea(x0, x1, x3);
 2994:       double ar3 = signedArea(x1, x2, x3);
 2995:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2996: 
 2997:       res += ar1;
 2998: 
 2999:    }
 3000: 
 3001:    return res;
 3002: }
 3003: 
 3004: 
 3005: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 3006:                                                                 (nodes[1]->isDry2()) ||
 3007:                                                                 (nodes[2]->isDry2()) ||
 3008:                                                                 (isQuad() && nodes[3]->isDry2());
 3009: }
 3010: 
 3011: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3012:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 3013: }
 3014: 
 3015: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3016:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 3017: }
 3018: 
 3019: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 3020:    // In boundary sides, the element 1 is nullptr
 3021:    return side->elems[1] == nullptr; 
 3022: }
 3023: 
 3024: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 3025:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 3026:    // For ics == 2, this function uses local frame coordinates.
 3027: 
 3028:    assert(isQuad());
 3029: 
 3030:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 3031:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 3032:    // where vxi, veta, vb are vectors and c is the center of the element.
 3033: 
 3034:    Point2 p0, p1, p2, p3;
 3035: 
 3036:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 3037: 
 3038:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 3039:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 3040:    // vectors vxi and veta connect the centers of opposite sides
 3041:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 3042:    // vb is zero for parallelogram elements.
 3043:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 3044: 
 3045:    //  The bilinear mapping is:
 3046:    //      P(s,t) = C + s*U + t*V + s*t*W
 3047:    //
 3048:    //  where:
 3049:    //    C = centroid (average of four vertices)
 3050:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 3051:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 3052:    //    W = bilinear correction; measures deviation from parallelogram
 3053:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 3054:    //        W = 0 for parallelogram elements.
 3055:    //
 3056:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3057:    //
 3058:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3059:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3060:    //
 3061:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3062:    //
 3063:    //  Geometrically, (L) projects everything onto the direction
 3064:    //  perpendicular to W, where the mapping is purely affine.
 3065:    //
 3066:    //  The dot product with nb retains the nonlinear term:
 3067:    //
 3068:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3069:    //
 3070:    //  Geometrically, (Q) projects onto the W direction, where
 3071:    //  the nonlinearity lives.
 3072:    //
 3073:    //  We solve (L) for whichever variable has the larger coefficient
 3074:    //  (better conditioned back-substitution), substitute into (Q),
 3075:    //  and get a scalar quadratic in the other variable.
 3076:    // ================================================================
 3077: 
 3078:    // ---- Basis vectors ----
 3079:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3080:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3081:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3082:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3083:    // W: nonlinear correction. Difference between quad and parallelogram.
 3084:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3085:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3086: 
 3087:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3088:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3089:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3090:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3091:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3092: 
 3093:    // ---- nb: direction parallel to W, L1-normalized ----
 3094:    // We don't need a unit vector -- just a well-scaled direction parallel
 3095:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3096:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3097:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3098:    //
 3099:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3100:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3101:    // and the quadratic solver takes its linear path (a ~ 0).
 3102:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3103:    const double inv_wlen = 1.0 / wlen1;
 3104:    const Vector2 nb = vb * inv_wlen;
 3105: 
 3106:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3107:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3108:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3109:    // What remains is a pure affine relationship between xi and eta.
 3110:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3111:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3112:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3113: 
 3114:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3115:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3116:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3117:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3118:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3119:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3120:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3121: 
 3122:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3123:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3124:    // minimizing round-off amplification.
 3125:    //
 3126:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3127:    // that uses predicated moves.
 3128:    //
 3129:    // if (fabs(Ls) > fabs(Lt)) {
 3130:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3131:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3132:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3133:    //    const double A = -Qw * Lt;
 3134:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3135:    //    const double C =  Qs * Lp - Qp * Ls;
 3136: 
 3137:    //    double eta1, eta2;
 3138:    //    solveQuadratic(A, B, C, eta1, eta2);
 3139: 
 3140:    //    // Pick root with smaller |eta| (domain centered at 0).
 3141:    //    // Ternary-> predicated move, no branch divergence.
 3142:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3143: 
 3144:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3145:    //    xi = (Lp - Lt * eta) / Ls;
 3146: 
 3147:    // } else {
 3148:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3149:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3150:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3151:    //    const double A = -Qw * Ls;
 3152:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3153:    //    const double C =  Qt * Lp - Qp * Lt;
 3154: 
 3155:    //    double xi1, xi2;
 3156:    //    solveQuadratic(A, B, C, xi1, xi2);
 3157: 
 3158:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3159: 
 3160:    //    eta = (Lp - Ls * xi) / Lt;
 3161:    // }
 3162:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3163:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3164:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3165:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3166:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3167: 
 3168:    // Quadratic:  A*r^2 + B*r + C = 0
 3169:    // (same formula for both cases, just with swapped coefficients)
 3170:    const double A = -Qw * Lb;
 3171:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3172:    const double C =  Qa * Lp - Qp * La;
 3173: 
 3174:    double r1, r2;
 3175:    solveQuadratic(A, B, C, r1, r2);
 3176: 
 3177:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3178:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3179: 
 3180:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3181:    const double other = (Lp - Lb * r) / La;
 3182: 
 3183:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3184:    xi  = solve_s ? r     : other;
 3185:    eta = solve_s ? other : r;
 3186: 
 3187: 
 3188:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3189:    xi  = clamp(xi,  -1.0, 1.0);
 3190:    eta = clamp(eta, -1.0, 1.0);
 3191: 
 3192:    // ---- Shape functions ----
 3193:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3194:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3195:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3196:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3197:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3198:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3199:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3200:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3201: 
 3202:    return true;
 3203: }
 3204: 
 3205: /**
 3206:    Compute the shape coordinates of the point (xt,yt) in the element.
 3207:    @param xt (input): x-coordinate of the point
 3208:    @param shpCoords (output): shape coordinates of the point
 3209:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3210:    @return true if the point is inside the element, false otherwise
 3211: **/
 3212: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3213: 
 3214:    // Compute the shape coordinates of the point xt in the element.
 3215:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3216:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3217:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3218:    // from the local frame, so use additional check.
 3219: 
 3220: 
 3221:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3222: 
 3223:    if (isTri()) { // Triangular element
 3224: 
 3225:       // Horizontal local node coordinates. 
 3226:       Point2 x0, x1, x2;
 3227:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3228: 
 3229:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3230:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3231:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3232:       shpCoords[3] = 0.0;
 3233: 
 3234:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3235:       const bool res = (tmpmin >= -small);  
 3236:       
 3237:       // When to fix the negative shape coordinates?
 3238:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3239: 
 3240:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3241:       // then we fix the negative shape coordinates.
 3242:       if ((tmpmin < 0) && fix) {
 3243: 
 3244:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3245:          // keeping the sum of the shape coordinates equal to 1.
 3246:          // I have tested and compared the new algorithm with the old one, and they give
 3247:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3248:          // The new algorithm should be faster since it is branchless.
 3249:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3250:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3251: 
 3252:          shpCoords[0] = (shpCoords[0] + a)*b;
 3253:          shpCoords[1] = (shpCoords[1] + a)*b;
 3254:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3255: 
 3256:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3257:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3258:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3259: 
 3260:          // Update the point coordinates for the new shape coordinates
 3261:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3262:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3263: 
 3264:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3265: 
 3266:       }
 3267: 
 3268:       // Return true if the point is inside the element
 3269:       return res;      
 3270:    }
 3271:    else {
 3272:       assert(isQuad() && "computeShapeCoords");
 3273: 
 3274:       // Horizontal local node coordinates with respect to the original side.
 3275:       Point2 x0, x1, x2, x3;
 3276:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3277: 
 3278:       const double a0 = signedArea(x0, x1, xt);
 3279:       const double a1 = signedArea(x1, x2, xt);
 3280:       const double a2 = signedArea(x2, x3, xt);
 3281:       const double a3 = signedArea(x3, x0, xt);
 3282: 
 3283:       const double minArea = min4(a0, a1, a2, a3);
 3284:       
 3285:       const bool res = (minArea > -small*area);
 3286: 
 3287:       // When to fix the negative shape coordinates?
 3288:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3289: 
 3290:       double xi, eta;    
 3291: 
 3292:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3293:       // Does nothing if ics == 1.
 3294:       assert(origSide != nullptr);
 3295:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3296: 
 3297:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3298: 
 3299:       if (fix) {
 3300:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3301:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3302:          xt.x = interpolate(shpCoords, xn);
 3303:          xt.y = interpolate(shpCoords, yn);
 3304:       }
 3305: 
 3306:       return res;
 3307:    }
 3308: 
 3309: 
 3310:    assert(false && "computeShapeCoords: should never reach this point");
 3311:    return false;  // Never reached
 3312: 
 3313: }
 3314: 
 3315: 
 3316: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3317: // Convert shape coordinates to cartesian coordinates
 3318: 
 3319:    if (isTri()) {
 3320:       // Triangular element
 3321: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3322:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3323:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3324:    }
 3325:    else {
 3326:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3327:    }
 3328: 
 3329: }
 3330: 
 3331: 
 3332: 
 3333: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3334:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3335:    
 3336:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3337: }
 3338: 
 3339: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3340:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3341:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3342:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3343:    return area * dot(gradPhi[i], gradPhi[j]);
 3344: }
 3345: 
 3346: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3347:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3348:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3349:    // The formula for the integral is:
 3350:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3351:    
 3352:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3353:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3354:    const double eta_sum  = eta_n(i) + eta_n(j);
 3355:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3356: 
 3357:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3358:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3359: 
 3360: 
 3361:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3362: }
 3363:    
 3364: 
 3365: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3366:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3367:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3368:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3369:    // The formula is also based on the identity:
 3370:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3371:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3372: 
 3373:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3374: 
 3375: 
 3376: 
 3377:    double res = 0.0;
 3378:    
 3379:    // Quadrature points in xi and eta coordinates
 3380:    #pragma unroll
 3381:    for (int i = 0; i < 4; i++) {
 3382:       // For each quadrature point...
 3383: 
 3384:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3385:       const double eta = p.x;
 3386:       const double xi  = p.y;
 3387: 
 3388:       // Jacobian entries at the Gauss point p
 3389:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3390:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3391:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3392:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3393: 
 3394:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3395:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3396: 
 3397:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3398:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3399:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3400:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3401:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3402: 
 3403:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3404:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3405:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3406:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3407:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3408: 
 3409:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3410:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3411:    }
 3412: 
 3413:    return res;
 3414: }
 3415: 
 3416: 
 3417: /**  Interpolate velocities at a given point (xt,yt,zt)
 3418: 
 3419:    @param xt, yt, zt: coordinates of the point to interpolate
 3420:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3421: 
 3422:    This is done in four steps:
 3423: 
 3424:    1. Find the shape coordinates for the final position in the element.
 3425:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3426:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3427:       z levels at xt, yt at each step.   
 3428:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3429:       horizontally and vertically.
 3430: **/
 3431: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3432:    // Interpolate the velocities at the point xt. 
 3433:    // This function works the same for triangular and quadrilateral elements.
 3434:    double shpCoord[4];
 3435:    Vector3 u_int;
 3436: 
 3437: 
 3438:    // First step is to compute the shape coordinates of (xt,yt)
 3439: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3440:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3441: 
 3442:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3443: 
 3444:    // Second step is to find the level that contains zt
 3445:    // Uses a binary search to find the level
 3446:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3447:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3448:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3449:    int R = nvrt - 1;
 3450: 
 3451:    // Get the z coordinates at the nodes of the element at the levels L and R
 3452:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3453:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3454:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3455: 
 3456: 
 3457:    double zL = interpolate(shpCoord, zLAtNodes);
 3458:    double zR = interpolate(shpCoord, zRAtNodes);
 3459: 
 3460:    // Interpolates vertically the velocities
 3461:    double wght1, wght2;
 3462:    if (xt.z <= zL) {
 3463:       wght1 = 1.0;
 3464:       wght2 = 0.0;
 3465:       xt.z = zL;
 3466:    }
 3467:    else if (xt.z >= zR) {
 3468:       wght1 = 0.0;
 3469:       wght2 = 1.0;
 3470:       xt.z = zR;
 3471:    }
 3472:    else {
 3473:       // Perform a binary search to find the levels between L and R that contain xt.z
 3474:       while (R - L > 1) {
 3475:          int M = (L + R) / 2.0;
 3476: 
 3477:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3478:          double zM = interpolate(shpCoord, zMAtNodes);
 3479:          if (zM < xt.z) 
 3480:          {
 3481:             L = M;
 3482:             zL = zM;
 3483:          }
 3484:          else 
 3485:          {
 3486:             R = M;
 3487:             zR = zM;
 3488:          }
 3489:       }
 3490:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3491:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3492: 
 3493:       wght2 = (xt.z - zL)/(zR - zL);
 3494:       wght1 = 1.0 - wght2;
 3495: 
 3496:    }
 3497: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3498: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3499:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3500:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3501:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3502:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3503: 
 3504:    // Project the velocity from the local frame to the origSide frame
 3505:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3506:    u_int = {uv.x, uv.y, w};
 3507: 
 3508:    // Neither of the interpolated velocities should be NaN
 3509:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3510: 
 3511:    return u_int;
 3512: 
 3513: }
 3514: 
 3515: 
 3516: 
 3517: 
 3518: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3519: 
 3520:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3521:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3522:    const Node *n1 = side->n1;
 3523:    const Node *n2 = side->n2;
 3524: 
 3525:    bool n1_match = (n1->nodeBnd->segment == segment);
 3526:    bool n2_match = (n2->nodeBnd->segment == segment);
 3527: 
 3528:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3529:    if (n1_match && n2_match) {
 3530:       return 0.5;
 3531:    } else if (n1_match) {
 3532:       return 1.0;
 3533:    } else if (n2_match) {
 3534:       return 0.0;
 3535:    }
 3536: 
 3537:    return 0.0;
 3538: }
 3539: 
 3540: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3541: 
 3542: 
 3543: 
 3544: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3545:    // Returns the value of the velocity at the side center
 3546:    const double w1 = getBoundaryArrayValueWeight();
 3547:    const double w2 = 1.0 - w1;
 3548:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3549:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3550: 
 3551:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3552: }
 3553: 
 3554: 
 3555: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3556:    // Returns the value of the normal component of the velocity at the side center
 3557:    const double w1 = getBoundaryArrayValueWeight();
 3558:    const double w2 = 1.0 - w1;
 3559:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3560:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3561: 
 3562:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3563: }
