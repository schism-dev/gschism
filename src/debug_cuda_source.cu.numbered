  979: struct Side {
  980: 
  981:    // Geometry information
  982:    int idx;               // Index of the side
  983:    Node *n1, *n2;
  984:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  985: 
  986:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  987:    Vector2 center;        // Location of side center. 
  988:    double zc[nvrt];       // Side center z-coord at each vertical level
  989: 
  990: #ifdef USE_FRAMES
  991:    Frame frame;
  992: #endif
  993: 
  994:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  995:                           // this is nullptr
  996:    
  997:    int kb;                // Bottom index of the side
  998:    bool isDry;            // True if the side is dry
  999:  
 1000:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1001: 
 1002:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1003: 
 1004:    // Physical information
 1005:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1006:    Vector2 btu[nvrt];           // Back-tracked velocity
 1007:    Vector2 U;                   // Vertically averaged velocity vector  
 1008: 
 1009:    Vector2 nuGradU[nvrt];          // nu*grad u
 1010: 
 1011:    Vector2 bcc[nvrt];           // Baroclinic term
 1012:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1013: 
 1014:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1015:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1016:    Vector2 gradPr;               // Gradient of pressure
 1017:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1018: 
 1019: 
 1020:    double hhat;                 // \breve{H} in notes
 1021: 
 1022:    double shapiro;
 1023: 
 1024:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1025: 
 1026:    double coriolis;             // Coriolis parameter
 1027: 
 1028:    // Vegetation parameters
 1029:    double veg_c2;
 1030:    double veg_beta;
 1031: 
 1032:    // Bottom drag parameters.
 1033:    double chi;
 1034:    double chi2;
 1035: 
 1036:    __inline__ __device__ double x(double t) const;
 1037:    __inline__ __device__ double y(double t) const;
 1038:    __inline__ __device__ double lon(void) const;
 1039:    __inline__ __device__ double lat(void) const;
 1040:    __inline__ __device__ Point2 p_t(double t) const;
 1041: 
 1042:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1043:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1044:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1045: 
 1046:    __inline__ __device__ Side* neigh(int index) const { 
 1047:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1048:       assert(index >= 0 && index < 4); 
 1049:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1050: 
 1051:       const int ielem = index & 1;           // 0 or 1
 1052:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1053: 
 1054:       const Element* elem = elems[ielem];
 1055: 
 1056:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1057: 
 1058:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1059: 
 1060:    }
 1061: 
 1062:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1063: 
 1064:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1065: 
 1066:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1067:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1068:    __inline__ __device__ int iadv(void) const;
 1069: 
 1070:    __inline__ __device__ double grav3(void) const;
 1071:    
 1072:    __inline__ __device__ double eta2(void) const;
 1073:    __inline__ __device__ double eta1(void) const;
 1074:    __inline__ __device__ double w2(int k) const;
 1075:    __inline__ __device__ double depth(void) const;
 1076:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1077:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1078: 
 1079:    __inline__ __device__ double dfv(int k) const;
 1080: 
 1081:    __inline__ __device__ double veg_h(void)  const;
 1082:    __inline__ __device__ double veg_nv(void) const;
 1083:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1084:    __inline__ __device__ double veg_alpha3D(int k) const;
 1085:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1086: 
 1087:    __inline__ __device__ double Cd(void) const;
 1088: 
 1089:    __inline__ __device__ Vector2 tau(void) const;
 1090: 
 1091:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1092:    
 1093: 
 1094:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1095:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1096:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1097:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1098:    } 
 1099:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1100:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1101:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1102:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1103: 
 1104:    // Get valid starting element (for backtracking)
 1105:    __inline__ __device__ Element* getStartElement() {
 1106:       return elems[0] ? elems[0] : elems[1];
 1107:    }
 1108: 
 1109:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1110:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1111:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1112: 
 1113:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1114: 
 1115:       // Dot product of the negative velocity vector with the side normal vector
 1116:       const double dot_prod1 = -dot(u, n);
 1117: 
 1118:       // Vector from side center to element 0 centroid
 1119:       const Vector2 v2 = elems[0]->center - center;
 1120: 
 1121:       // Dot product of the vector with the side normal vector
 1122:       const double dot_prod2 = dot(v2, n);
 1123: 
 1124:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1125:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1126: 
 1127:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1128:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1129: 
 1130:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1131: 
 1132:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1133:       else                           return !isDry1 ? elems[1] : elems[0];
 1134: 
 1135:  
 1136:    }
 1137: 
 1138:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1139:       // Given an element, returns the other element that shares this side
 1140:       return (elems[0] == elem) ? elems[1] : elems[0];
 1141:    }
 1142: 
 1143:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1144:       // Given a node, returns the other node that shares this side
 1145:       return (n1 == node) ? n2 : n1;
 1146:    }
 1147:  
 1148:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1149: 
 1150: 
 1151: 
 1152: 
 1153: };
 1154: 
 1155: 
 1156: // This struct is used to store the boundary information for a node.
 1157: struct NodeBoundary {   
 1158:    int idx;
 1159:    BoundarySegment *segment;
 1160:    Node *node;
 1161:    
 1162:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1163:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1164: 
 1165:    bool isLand;
 1166: 
 1167:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1168:    double elbc;   // Elevation boundary condition
 1169:    double eth;    // Elevation time history
 1170: 
 1171:    double eta_mean; // Mean elevation at nodes
 1172: 
 1173:    bool isEssentialBC;
 1174: 
 1175:    Vector2 uth[nvrt];  // "Time history" velocity
 1176: 
 1177:    // Arrays for harmonic constituents (if needed)
 1178:    double  emo[nbfr];  // Elevation amplitude
 1179:    double  efa[nbfr];  // Elevation phase
 1180:    Vector2 umo[nbfr];  // velocity amplitude
 1181:    Vector2 ufa[nbfr];  // velocity phase
 1182: 
 1183: 
 1184:    NodeBoundary(void) {
 1185:       isLand = false;
 1186:    }
 1187:    NodeBoundary(bool _isLand) {
 1188:       isLand = _isLand;
 1189:    }
 1190: 
 1191:    
 1192:    __forceinline__ __device__ int numSidesForAverage() const {
 1193:    // Returns the number of sides that are connected to the node and have the same segment.
 1194:    // This is used to compute the average velocity at the node for open boundary nodes.
 1195:       int res = 0;
 1196:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1197:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1198: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1199:       return res;
 1200:    }
 1201: 
 1202: 
 1203:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1204:       assert(index == 0 || index == 1); 
 1205:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1206:    }
 1207: 
 1208: 
 1209: };
