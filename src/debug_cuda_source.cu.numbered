 6200: extern "C" {
 6201: 
 6202:    __global__ void scaleGravity(double loadtide_coef) {
 6203: 
 6204: 
 6205:       NODE(node);
 6206: 
 6207:       // SAL option: scale gravity
 6208:       if constexpr(iloadtide==2) {  // simple const
 6209:          node->grav2 = grav*(1.0 - loadtide_coef);
 6210: 
 6211:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6212:         
 6213:           const double depth = max(node->depth, 0.0);
 6214:           const double tmp1 = sqrt(depth);
 6215:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6216:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6217:                              2.6969e-13*depth*depth*depth*tmp1;
 6218:           
 6219:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6220:           
 6221: 
 6222: 
 6223:           node->grav2 = grav*(1.0 - beta_bar);
 6224: 
 6225:       } else {  // iloadtide=0,1
 6226:           node->grav2 = grav;
 6227: 
 6228:       }
 6229: 
 6230:    }
 6231: 
 6232: 
 6233:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6234:       NODE(node);
 6235: 
 6236:       const int idx = node->idx;
 6237:       Vector2 wind = {xWind[idx], yWind[idx]};
 6238: 
 6239:       if constexpr(nws != 0 && iwindoff != 0) {
 6240:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6241:       }
 6242: 
 6243:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6244:       node->setWind(wind);
 6245: 
 6246:       node->pr = pressAir[idx];
 6247:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6248: 
 6249:    }
