 1804: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1805:                                               double &t, double& tIntersect) {
 1806: 
 1807:    double closest_intersect_t = 1e10;
 1808:    bool found_intersection = false;
 1809: 
 1810: double minDelta = 1e10; 
 1811: double btt1 = 1e10, btt2;
 1812:    for (int i = 0; i < i34; i++) {
 1813: 
 1814:       Side *side2 = sides[i];
 1815: 
 1816:       // (x3,y3)-(x4,y4) is the element side line
 1817:       const Point2 x3 = side2->n1->p2();
 1818:       const Point2 x4 = side2->n2->p2();
 1819: 
 1820:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1821:       const double delta = cross(x2 - x1, x3 - x4);
 1822: 
 1823:       if (abs(delta) > 0) {
 1824: 
 1825:          const double delta1 = cross(x3 - x1, x3 - x4);
 1826:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1827: 
 1828:          // Solves the two linear equations for tt1 and tt2
 1829:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1830:          const double tt2 = delta2/delta;
 1831: 
 1832: if (abs(tt1) < abs(btt1)) {
 1833:    minDelta = abs(delta);
 1834:    btt1 = tt1;
 1835:    btt2 = tt2;
 1836: }
 1837: 
 1838: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1839:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1840:             closest_intersect_t = min(closest_intersect_t, tt1);
 1841:             side = side2;
 1842:             nextElement = side->otherElem(this);
 1843:             t = tt2;
 1844:             tIntersect = max(small, min(tt1, 1.0-small));
 1845:             found_intersection = true;
 1846:          }
 1847:       
 1848:       }
 1849:       else {  // parallel segments
 1850:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1851:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1852: 
 1853:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1854: 
 1855:          // const double dist = dot(x1 - x3, side2->n);
 1856:          // if (abs(dist) < small*length(x3 - x4)) {
 1857:          //    const double2 unitarySide = normalize(x4 - x3);
 1858:          //    const double len = dot(x2 - x1, unitarySide);
 1859:          //    t = t + len;
 1860:          //    t = max(0.0, min(t, 1.0));
 1861:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1862: 
 1863: 
 1864:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1865:          //    // t = tt2;
 1866:          //    found_intersection = true;
 1867:          // }
 1868:       }
 1869: 
 1870: 
 1871:    }
 1872: 
 1873:    if (!found_intersection) {
 1874:       
 1875: if (idx == 0) printf("ZZ No intersection found:\n"
 1876:            "Element %d\n"
 1877:            "in = %d\n"
 1878:            "minDelta = %e\n"
 1879:            "tt1 = %e, tt2 = %e\n"
 1880:            "segment: (%f, %f)-(%f, %f)\n"
 1881:            "Vertices:\n"
 1882:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1883:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1884:            IDX(nextElement),
 1885:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1886:            minDelta,
 1887:            btt1, btt2,
 1888:            x1.x, x1.y,
 1889:            x2.x, x2.y,
 1890:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1891:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1892:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1893:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1894:            nodes[0]->p.x, nodes[0]->p.y,
 1895:            nodes[1]->p.x, nodes[1]->p.y,
 1896:            nodes[2]->p.x, nodes[2]->p.y,
 1897:            nodes[0]->p.x, nodes[0]->p.y);
 1898: 
 1899:    }
 1900: 
 1901:    // assert(found_intersection && "No intersection found");
 1902: 
 1903:    // found_intersection should always be true, since we checked all the sides.  
 1904:    return found_intersection;
 1905: }
