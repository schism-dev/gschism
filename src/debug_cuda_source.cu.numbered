 8546:          break;
 8547:       case (int)VarCode::eta:
 8548:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8549:          *sizeType = sizeof(double);
 8550:          break;
 8551:       case (int)VarCode::x:
 8552:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8553:          *sizeType = sizeof(Vector2);
 8554:          break;
 8555:       case (int)VarCode::z:
 8556:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8557:          *sizeType = sizeof(double);
 8558:          break;
 8559:       case (int)VarCode::kb:
 8560:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8561:          *sizeType = sizeof(int);
 8562:          break;
 8563:       case (int)VarCode::isdry:
 8564:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8565:          *sizeType = sizeof(int);
 8566:          break;         
 8567:       case (int)VarCode::w:
 8568:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8569:          *sizeType = sizeof(double);
 8570:          break;
 8571:       case (int)VarCode::u:
 8572:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8573:          *sizeType = sizeof(Vector2);
 8574:          break;  
 8575:       case (int)VarCode::u_air:
 8576:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8577:          *sizeType = sizeof(Vector2);
 8578:          break;
 8579:       default:
 8580:          *offset = -1;    
 8581:    }  
 8582:    
 8583: }
