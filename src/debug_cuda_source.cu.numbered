 1276: // This struct is used to store the boundary information for a node.
 1277: struct NodeBoundary {   
 1278:    int idx;
 1279:    BoundarySegment *segment;
 1280:    Node *node;
 1281:    
 1282:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1283:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1284: 
 1285:    bool isLand;
 1286: 
 1287:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1288:    double elbc;   // Elevation boundary condition
 1289:    double eth;    // Elevation time history
 1290: 
 1291:    double eta_mean; // Mean elevation at nodes
 1292: 
 1293:    bool isEssentialBC;
 1294: 
 1295:    Vector2 uth[nvrt];  // "Time history" velocity
 1296: 
 1297:    // Arrays for harmonic constituents (if needed)
 1298:    double  emo[nbfr];  // Elevation amplitude
 1299:    double  efa[nbfr];  // Elevation phase
 1300:    Vector2 umo[nbfr];  // velocity amplitude
 1301:    Vector2 ufa[nbfr];  // velocity phase
 1302: 
 1303: 
 1304:    NodeBoundary(void) {
 1305:       isLand = false;
 1306:    }
 1307:    NodeBoundary(bool _isLand) {
 1308:       isLand = _isLand;
 1309:    }
 1310: 
 1311:    
 1312:    __forceinline__ __device__ int numSidesForAverage() const {
 1313:    // Returns the number of sides that are connected to the node and have the same segment.
 1314:    // This is used to compute the average velocity at the node for open boundary nodes.
 1315:       int res = 0;
 1316:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1317:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1318: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1319:       return res;
 1320:    }
 1321: 
 1322: 
 1323:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1324:       assert(index == 0 || index == 1); 
 1325:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1326:    }
 1327: 
 1328: 
 1329: };
 1330: 
 1331: struct Node {
 1332: 
 1333:    // Geometry information
 1334:    int idx;        // Index of the node
 1335:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1336:    int numNodes;   // Number of nodes neighbors of this node
 1337: 
 1338:    Element **elements; // Array of pointers to the elements that share this node
 1339:    int numElements;    // Number of elements that share this node
 1340: 
 1341:    int numSides;       // Number of sides that are connected to this node
 1342: 
 1343:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1344:    double gz;          // Global vertical coordinate at the node.
 1345:    Vector2 u2[nvrt];
 1346:    double  w2[nvrt];
 1347:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1348:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1349:    double lon, lat;
 1350:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1351:    double depth;
 1352: 
 1353:    #ifdef USE_FRAMES
 1354:    Frame frame;
 1355:    #endif
 1356: 
 1357:    #ifdef USE_LOCALIZED_SIGMA   
 1358:    double localSigma[nvrt];
 1359:    #endif
 1360: 
 1361:    int kb;       // Bottom index of the node
 1362: 
 1363:    bool isDry;     // True if the node is dry
 1364: 
 1365:    int iadv;     // Advection flag
 1366: 
 1367:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1368:                           // this is nullptr
 1369: 
 1370:    TempVar tmp; // Temporary variable to store different types of variables
 1371: 
 1372:    // Physical information
 1373:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1374:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1375: 
 1376:    double rho[nvrt];     // Density
 1377:    double dfv[nvrt];     // Vertical viscosity
 1378: 
 1379:    double eta1; // Elevation at nodes at previous timestep
 1380:    double eta2; // Elevation at nodes at current timestep
 1381: 
 1382:    double ETP;  // Earth Tidal Potential
 1383: 
 1384:    double pr;    // Air pressure
 1385:    double grav2; // Gravity 
 1386:    
 1387:    Vector2 dav;  // Depth averaged velocity
 1388: 
 1389:    Vector2 tau; // Wind stress vector
 1390: 
 1391:    // Vegetation parameters
 1392:    double veg_h;
 1393:    double veg_nv;
 1394:    double veg_di;
 1395:    double veg_Cd;
 1396:    double veg_h_unbent;
 1397:    double veg_di_unbent;
 1398:    double veg_nv_unbent;
 1399:    double veg_alpha_vert_mean;
 1400:    double veg_alpha0;
 1401:    double veg_alpha3D[nvrt];
 1402: 
 1403:    // Bottom drag parameters
 1404:    double Cd;       // Bottom drag coefficient   
 1405: 
 1406:    // These three are mutually exclusive
 1407:    union {
 1408:       double rmanning; // Bottom Manning's coefficient
 1409:       double rough;    // Bottom roughness length
 1410:       double drag;     // Bottom drag coefficient
 1411:    };
 1412:    Vector2 tau_bot; // Bottom stress vector
 1413: 
 1414:    // XXXX REMOVE FOR IMM>0???
 1415:    double bdef1; // Bottom deformation at previous timestep
 1416:    double bdef2; // Bottom deformation at current timestep
 1417: 
 1418:    double qel; // RHS
 1419:    double coeffDiag; // Diagonal coefficient of the matrix
 1420:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1421: 
 1422:    // This was used by a previous version of the conjugate gradient method
 1423:    // double mP; // Search direction for conjugate gradient method
 1424:    // double mR; // Residual for conjugate gradient method
 1425:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1426: 
 1427:    double mX; // Solution of the FEM system
 1428: 
 1429:    // Meteorological forcing
 1430:    Vector2 u_air;
 1431:    double p_air;  // XXXX is this the same as pr?
 1432:    double t_air;
 1433:    double q_air;
 1434:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1435: 
 1436:    __device__ void setWind(Vector2 &u) {
 1437:    // Sets the wind vector taking into account the mesh angle
 1438:    
 1439:       const double speed = length(u);
 1440: 
 1441:       // Rotate wind vector to the node frame
 1442:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1443: 
 1444:       // Sets the surface stress vector due to wind.
 1445:       if constexpr(nws == 0) {
 1446:          tau = {0.0, 0.0};
 1447: 
 1448:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1449:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1450: 
 1451:       } else {
 1452: 
 1453:          double dragcoef;
 1454: 
 1455:          if constexpr(iwind_form == -1) {
 1456:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1457:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1458: 
 1459:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1460:             tau = cff*u_air;
 1461:  
 1462:          } else if constexpr(iwind_form == 1) {
 1463:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1464:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1465: 
 1466:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1467:             tau = cff*u_air;
 1468: 
 1469:          } else {
 1470:             tau = {0.0, 0.0};
 1471:          }
 1472:       }
 1473:    }
 1474: 
 1475:    #ifdef USE_FRAMES
 1476:    __device__ void setFrame(double lat, double lon) {
 1477: 
 1478:       frame.update(lat, lon);        
 1479:     }
 1480:    #endif
 1481: 
 1482:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1483: 
 1484:    __device__ double sigmaTransitionDepth(void) const;
 1485: 
 1486:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1487: 
 1488:    __inline__ __device__ Point2 outputCoords(void) const {
 1489:       if constexpr(ics == 1)  return p;
 1490:       else                    return {rad2deg*lon, rad2deg*lat};
 1491:    }
 1492: 
 1493:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1494:    // If ics == 2, convert the global point to the local frame
 1495:       
 1496:       if constexpr (ics == 1) {
 1497:          return p;
 1498:       } else {
 1499:          const Point3 c = {p.x, p.y, gz};
 1500:          const Point3 local = frame.G2L(p - c);
 1501:          return local;
 1502:       }
 1503:    }
 1504: 
 1505:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1506:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1507:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1508:    
 1509:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1510: 
 1511:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1512: 
 1513:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1514:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1515: 
 1516:    __device__ __forceinline__ void clearMatrixRow(void) {
 1517:       // Clear the matrix row for this node
 1518: 
 1519: 
 1520:       coeffDiag = 0.0;
 1521: 
 1522:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1523: 
 1524:    }
 1525: 
 1526:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1527:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1528:       
 1529:       if (node == this) {
 1530:          coeffDiag += value;
 1531:      
 1532:       } else {
 1533:          // Search (linearly)the index of the node in the array of nodes
 1534:          // XXX: This is not efficient, see if we can improve this
 1535:          int i;
 1536:          for (i = 0; i < numNodes; i++) {
 1537:             if (nodes[i] == node) {
 1538:                break;
 1539:             }
 1540:          }
 1541:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1542:          coeffMatrix[i] += value;
 1543:       }
 1544:    }
