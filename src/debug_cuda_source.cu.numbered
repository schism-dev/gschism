 1247:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1248:    {
 1249:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1250:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1251:       if (isQuad()) {
 1252:          gx += a[3]*gradPhi[3].x;
 1253:          gy += a[3]*gradPhi[3].y;
 1254:       }
 1255:       return {gx, gy};
 1256:    }
 1257: 
 1258:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1259:    {
 1260:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1261:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1262:       if (isQuad()) {
 1263:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1264:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1265:       }
 1266:       return {gx, gy};
 1267:    }
 1268: 
 1269:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
 1270:    __device__ __forceinline__ Vector3 n(int k) const {
 1271:       double area3D;
 1272:       return n(k, area3D);
 1273:     }
