 2622:    template<typename T>
 2623:    __device__ __forceinline__ T Element::mean(int level, T (Side::* field)[nvrt]) const {
 2624:       T values[4];
 2625:       getSideValues(level, field, values);
 2626: 
 2627:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2628:       if constexpr (IsVector2<T>::value && ics == 2) {
 2629: // XXXXX printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2630:          projectSideVectorsToElementFrame(values);
 2631: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2632:       }
 2633: 
 2634:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2635:    }   
