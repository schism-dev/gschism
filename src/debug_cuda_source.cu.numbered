 4221:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4222: 
 4223:       SIDE(side);
 4224: 
 4225: 
 4226:       side->U = {0.0, 0.0}; 
 4227:          
 4228:       if(side->isDry) return;
 4229: 
 4230:       const Node *node1 = side->n1;
 4231:       const Node *node2 = side->n2;
 4232: 
 4233:       // Vertically integrated velocity U (in ll if ics=2)
 4234:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4235:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4236:       }
 4237: 
 4238:    }
 4239: 
 4240:    __global__ void computeBottomDragVegetation(void) {
 4241:       // UNFINISHED. CHECK THIS:
 4242:       // How many kernels are needed? Why so many for loops?
 4243:       // Is the loop on sides needed?
 4244: 
 4245:       NODE(node);
 4246: 
 4247:       const int    kb      = node->kb;
 4248:       const double htot    = node->htot2();
 4249:       const double rough   = node->rough;
 4250: 
 4251: 
 4252:       if (node->isDry) {
 4253:          // Default values for dry nodes
 4254:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4255:          /// XXX CHECK INDICES
 4256:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4257:       }
 4258: 
 4259:       // Compute bottom drag Cd
 4260:       //--------------------------------
 4261: 
 4262:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4263:       if (nchi==1) {
 4264: 
 4265:          bool ltmp = false; // for WBL iteration
 4266: 
 4267:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4268:          // Drag at nodes
 4269:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4270:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4271:         
 4272:          const double rough = node->rough;
 4273:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4274:          if (node->rough == 0.0) {
 4275:             node->Cd = 0.0;
 4276: 
 4277:          } else { //roughness >0 
 4278:             
 4279:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4280:             const double bthick = max(dzb_min, bthick_ori);
 4281: 
 4282:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4283: 
 4284:             double tmp = 1.0/(2.5*log(bthick/rough));
 4285:             node->Cd = tmp*tmp;
 4286: 
 4287:          } // if rough
 4288: 
 4289: 
 4290:          // RECOVER THIS: XXX
 4291:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4292:          // Output warning for WBL if iteration didn't converge
 4293: 
 4294: 
 4295:       } // nchi==1
 4296: 
 4297:       //   Bottom stress in m^2/s^2
 4298:       if (node->rho[kb + 1] >= -98.0)
 4299:       {
 4300:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4301:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4302:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4303:          // !sediment erosion: this part needs more documentation
 4304:       }
 4305: 
 4306:     
 4307:       // Compute vegetation parameters
 4308:       //--------------------------------
 4309: 
 4310:       // SAV constants
 4311:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4312:       constexpr double veg_cfpsi = 0.16;
 4313: 
 4314:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4315:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4316: 
 4317:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4318:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4319:          int kbin = 0; // bin index
 4320:          for (int k = kb; k < nvrt; k++) {
 4321:             // Computes node height above the bottom level
 4322:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4323:             assert(false && "Vertical variation of vegetation not implemented");
 4324: 
 4325:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4326:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4327:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4328:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4329:             // } else {
 4330:             //    // Find the bin at which the current vertical level is
 4331:             //    while (kbin<nbins_veg_vert) {
 4332:             //       const double zn = node->z[kbin];
 4333:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4334:             //          break;
 4335:             //       } // if
 4336:             //       kbin++;
 4337:             //    } // while
 4338:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4339: 
 4340:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4341:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4342:                
 4343:             //    // Linear interpolation of the vegetation parameters
 4344:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4345:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4346:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4347:             // } // if rl10
 4348: 
 4349:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4350: 
 4351:          } // for k
 4352: 
 4353: 
 4354:       } else { // Ganthy (iveg=2)
 4355:       //  Modify canopy height, diameter, and density
 4356: 
 4357:          // Make sure there is vegetation on this node
 4358:          if (node->veg_h_unbent > 0.0) {
 4359:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4360: 
 4361:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4362:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4363:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4364: 
 4365:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4366:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4367:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4368:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4369:          } // if veg_h_unbent
 4370: 
 4371:          for (int k = 0; k < nvrt; k++) {
 4372:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4373:          } // for k
 4374:       
 4375: 
 4376:       } // if iveg
 4377:      
 4378:          
 4379: 
 4380:       // Compute vertical mean of veg_alpha3D
 4381:       if (iveg != 0) {
 4382:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4383:          double sum1=0.0;
 4384:          double sum2=0.0;
 4385:          // Integrate over each level under the canopy...
 4386:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4387:             const double Dz = node->Dz(k);
 4388: 
 4389:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4390:             sum2 += Dz;
 4391: 
 4392:          } // for k
 4393: 
 4394:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4395:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4396: 
 4397:       } // if iveg
 4398: 
 4399:    }
 4400: 
 4401:    __global__ void computeVegetationAndDragParameters(void) {
 4402:       // Computes the vegetation and drag model parameters:
 4403:       // chi, \tilde\chi, beta, \breve{H}
 4404:       
 4405:       SIDE(side);
 4406: 
 4407:       const double htot = side->htot2();
 4408:       const int    kb   = side->kb;
 4409: 
 4410:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4411: 
 4412:       const double veg_h     = side->veg_h();
 4413:       const double veg_nv    = side->veg_nv();
 4414:       const double veg_c     = side->veg_c();
 4415:       const double veg_beta  = side->veg_beta;
 4416:       const double veg_alpha = side->veg_alpha_vert_mean();
 4417: 
 4418:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4419:       // Velocity magnitude at the bottom level
 4420:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4421:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4422:       side->chi2 = side->Cd()*vmag1;
 4423:       side->chi  = side->chi2;
 4424:       if constexpr(iveg != 0) {
 4425:          const Node *n1 = side->n1;
 4426:          const Node *n2 = side->n2;
 4427:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4428:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4429:       }
 4430: 
 4431:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4432: 
 4433:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4434:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4435:       double magUa = 0.0;
 4436:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4437:          // 3D wet side with veg...
 4438: 
 4439:          double magUa = 0.0;
 4440:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4441:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4442: 
 4443:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4444:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4445:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4446: 
 4447:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4448:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4449: 
 4450:                // Velocity magnitude at the bottom (l) of the level
 4451:                const double ul = length(side->u2[k]);
 4452: 
 4453:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4454:                magUa += Dz*0.5*(uh + ul);
 4455: 
 4456:             } // if HasVegetation
 4457:          } // for k
 4458:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4459: 
 4460:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4461:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4462:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4463:             const double zCpy = side->zTopCanopy();
 4464:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4465:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4466:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4467:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4468:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4469:          } // if isSubmerged
 4470:       } // if iveg   
 4471: 
 4472:       // Computes the friction modified depth, \breve{H} in notes
 4473:       if (side->is2D()) { // 2D
 4474: 
 4475:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4476:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4477: 
 4478:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4479: 
 4480:          side->hhat = htot*htot/fricH; 
 4481: 
 4482:       } else { // 3D
 4483:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4484: 
 4485:          if constexpr(iveg != 0) {
 4486:             
 4487:             if (side->isSubmerged()) { 
 4488:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4489:                side->hhat -= veg_c*Hhat_alpha;
 4490: 
 4491:             } else { // Emergent
 4492:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4493:             }
 4494:          } // if iveg
 4495: 
 4496:          // Enforce positivity for 3D model
 4497:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4498:       } // if 3D
 4499: 
 4500:    }
 4501: 
 4502: 
 4503: 
 4504:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4505:    // Computes the density gradient between two elements, e1 and e2.
 4506:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4507:    // zero in the direction normal to the side. 
 4508:    // 
 4509:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4510:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4511:    //
 4512:    // Input:
 4513:    //    e1: Element
 4514:    //    e2: Neighbor element (or nullptr if boundary)
 4515:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4516:    //    k: Index of the half-level at which the density is interpolated
 4517:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4518:    // 
 4519:    // Output:
 4520:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4521:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4522: 
 4523:       if (e2 == nullptr || e2->isDry) {
 4524:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4525: 
 4526:          Side *side = e1->sides[j];
 4527:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4528:                  
 4529:          if constexpr(ics == 1) {
 4530:             vec = side->n; // Normal vector to the side
 4531:          } else {
 4532:             // IMPLEMENT THIS XXXXXX
 4533:             // !replace with xel, yel?
 4534:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4535:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4536:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4537:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4538:          } //ics
 4539:                    
 4540:          diffRho = 0.0;
 4541: 
 4542:       } else { //internal and wet
 4543:          if constexpr(ics==1) {
 4544:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4545: 
 4546:             // Vector from e1 to e2
 4547:             vec = toVector2(e2->center - e1->center);
 4548: 
 4549:          } else { 
 4550:             // IMPLEMENT THIS XXXXXX
 4551:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4552:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4553:             //                   alow(j)=xctr2
 4554:             //                   bdia(j)=yctr2
 4555:          } // ics
 4556: 
 4557:          diffRho = rho2 - e1->demeanedDensity(k);
 4558:       }
 4559: 
 4560:    }
 4561: 
 4562:    __global__ void computeDensityCubicSplines(void) {
 4563:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4564: 
 4565:       ELEM(elem);
 4566: 
 4567:       if (elem->isDry) return;
 4568: 
 4569:       const int kb = elem->kb;
 4570: 
 4571:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4572:       if (elem->is2D()) {
 4573:          // In the 2D case, the density is constant at the prism level. 
 4574:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4575:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4576:       } else { //3D
 4577: 
 4578:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4579:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4580:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4581:          ///// XXXX CHECK INDICES!!!!!
 4582:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4583:       } // 2D/3D
 4584: 
 4585:    }
 4586: } // extern "C"
 4587: 
 4588: 
 4589: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4590: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4591: 
 4592:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4593: 
 4594:    const int kb  = elem->kb;
 4595:    const int kb2 = elem2->kb;
 4596: 
 4597:    // z-coordinate of prism of elem
 4598:    const double zp = elem->z_prism(k);
 4599: 
 4600:    double rho = 0.0;
 4601: 
 4602:    if (elem2->is2D()) {
 4603:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4604: 
 4605:    } else {  // 3D
 4606: 
 4607:       // eta_min may be < zmax
 4608:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4609:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4610: 
 4611:       // (Extrapolate density below bottom, we will fix it later)
 4612:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4613:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4614:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4615:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4616:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4617:    } // 2D/3D
 4618:      
 4619: 
 4620:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4621:    // Now we need to fix it.
 4622:    if (elem->z[k] < elem2->z[kb2]) {
 4623:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4624: 
 4625:       // There are two methods to adjust the density at the bottom of the element.
 4626:       // iunder_deep=0: 
 4627:       const double depth1 = abs(elem->z[kb]); // larger depth
 4628: 
 4629:       if (iunder_deep==0) {
 4630: 
 4631:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4632: 
 4633:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4634: 
 4635:       } else { // iunder_deep != 0
 4636: 
 4637:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4638: 
 4639:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4640: 
 4641:          //   Demeaned density at the same z coordinate as
 4642:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4643:          }
 4644: 
 4645:       } // if iunder_deep
 4646:    } // if elem->z[kb] < elem2->z[kb]
 4647: 
 4648:    return rho;
 4649: }
 4650: 
 4651: 
 4652: extern "C" {
 4653:    __global__ void computeDensityGradient(void) {
 4654: 
 4655:          // Compute the horizontal density gradient at each element.
 4656:       // It works in two steps:
 4657:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4658:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4659:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4660:       //             gradRho.r1 = rho1 - rho0
 4661:       //             gradRho.r2 = rho2 - rho0
 4662:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4663:       // 
 4664:       //  NOTE: We use de-meaned densities.
 4665: 
 4666:       ELEM(elem);
 4667: 
 4668:       if (elem->isDry) return;
 4669: 
 4670:       const int kb  = elem->kb;
 4671:       const int i34 = elem->i34;
 4672: 
 4673:       for (int k = kb + 1; k < nvrt; k++) {
 4674:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4675:          //             gradRho.r1 = rho1 - rho0
 4676:          //             gradRho.r2 = rho2 - rho0
 4677:          int icount = 0;
 4678:          double sumRx = 0.0;
 4679:          double sumRy = 0.0;
 4680:          for (int j1=0; j1<i34; j1++) { 
 4681: 
 4682:             const int j2 = elem->nxq(j1 + 1);
 4683: 
 4684:             // Pairs of consecutive neighbor elements of elem
 4685:             const Element *e1 = elem->nghbElems[j1];
 4686:             const Element *e2 = elem->nghbElems[j2];
 4687: 
 4688:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4689:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4690:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4691: 
 4692:             // Compute the density difference and the vector from elem to e1 and e2
 4693:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4694:             double diffRho1, diffRho2;
 4695:             Vector2 vec1, vec2;
 4696:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4697:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4698: 
 4699:             const double rl1 = length(vec1);
 4700:             const double rl2 = length(vec2);
 4701:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4702: 
 4703:             const double delta = cross(vec1, vec2);
 4704:             const double sintheta = abs(delta)/(rl1*rl2);
 4705: 
 4706:             // To avoid problems, avoid elements with small angle between vectors
 4707:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4708:             const bool validEq = (sintheta > sin_one_deg);
 4709: 
 4710:             if (validEq) {
 4711:                // Solve the system of equations to get the density gradient at elem
 4712:                icount++;
 4713:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4714:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4715:                sumRx += Rx;
 4716:                sumRy += Ry;
 4717:             }
 4718:          } // for j1
 4719: 
 4720:          // Compute the average density gradient at elem
 4721:          if (icount==0) {
 4722:            // Bad mesh quality; bail out with 0 b-cc
 4723:            elem->gradRho[k] = {0.0, 0.0};
 4724:          } else {
 4725:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4726:          }
 4727: 
 4728:       } // for k
 4729: 
 4730:    }
 4731: 
 4732:    __global__ void computeBaroclinicTerm(void) {
 4733:    // Computes the baroclinic term at sides (at half levels).
 4734:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4735:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4736: 
 4737:       SIDE(side);
 4738: 
 4739:       if (side->isDry) return;
 4740: 
 4741:       const Element *e1 = side->elems[0];
 4742:       const Element *e2 = side->elems[1];      
 4743:       const int kb = side->kb;
 4744:       
 4745:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4746: 
 4747:       // interpolates vertically the density gradient of the two elements at the half level/
 4748: 
 4749:       // Starts the integration at the surface and goes down to the bottom
 4750:       int k1 = nvrt - 1;
 4751:       int k2 = nvrt - 1;
 4752: 
 4753:       side->bcc[nvrt-1] = {0.0, 0.0};
 4754:       for (int k = nvrt-2; k >= kb; k--) {
 4755:       // For each prism level (from surface to bottom)...
 4756: 
 4757:          // For both elements, interpolate density gradient at the side's half level.
 4758:          // The gradient at the side is the average of the gradients at the elements.
 4759:          // w1, w2 are used to take into account boundary sides, with just one element.
 4760:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4761:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4762:          const double wsum = w1 + w2;
 4763:          w1 = w1/wsum;
 4764:          w2 = w2/wsum;
 4765:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4766: 
 4767:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4768:          Vector2 gradRho = {0.0, 0.0};
 4769:          if (e1 != nullptr && k > kb) {
 4770:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4771:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4772:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4773:             
 4774:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4775:          }      
 4776:          if (e2 != nullptr && k > kb) {
 4777:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4778:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4779:             
 4780:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4781:          }
 4782: 
 4783:          if constexpr(ics==2) {
 4784:             // IMPLEMENT THIS XXXXXX
 4785:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4786:             // swild(1)=tmp1
 4787:             // swild(2)=tmp2
 4788:          }
 4789:          
 4790:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4791:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4792:          // CHECK INDICES!!! XXX
 4793:          const double grav3 = side->grav3();
 4794:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4795: 
 4796:       } // for
 4797: 
 4798:    }
 4799: 
 4800: 
 4801: 
 4802:    __global__ void computeHorGradientAtSide(void) {
 4803: 
 4804:       // Compute the horizontal density gradient at each element.
 4805:       // It works in two steps:
 4806:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4807:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4808:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4809:       //             gradRho.r1 = rho1 - rho0
 4810:       //             gradRho.r2 = rho2 - rho0
 4811:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4812:       // 
 4813:       //  NOTE: We use de-meaned densities.
 4814: 
 4815:       SIDE(side);
 4816: 
 4817: // printf("side->isDry: %d\n", side->isDry);
 4818:       if (side->isDry) return;
 4819: 
 4820:       // Computes the gradient of the variables at the side center.
 4821:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4822:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4823:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4824: 
 4825:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4826:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4827:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4828:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4829: // printf("gradEta1: %.15f, %.15f\n", side->gradEta1.x, side->gradEta1.y);
 4830: // printf("gradEta2: %.15f, %.15f\n", side->gradEta2.x, side->gradEta2.y);
 4831: // printf("gradETP: %.15f, %.15f\n", side->gradETP.x, side->gradETP.y);
 4832: // printf("gradPr: %.15f, %.15f\n", side->gradPr.x, side->gradPr.y);
 4833: 
 4834: 
 4835:    }
 4836: 
 4837: 
 4838:    __global__ void solveMomentumEquations(double time) {
 4839: 
 4840:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4841:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4842: 
 4843:       SIDE(side);
 4844: 
 4845:       if (side->isDry) 
 4846:       {
 4847:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4848: 
 4849:          return;
 4850:       }
 4851: 
 4852:       const Node *n1 = side->n1;
 4853:       const Node *n2 = side->n2;
 4854: 
 4855:       const int kb = side->kb;
 4856: 
 4857:       const double veg_h = side->veg_h();
 4858:       const double grav3 = side->grav3();
 4859: 
 4860:       if (side->is2D()) {
 4861:          // Warning: Do not use htot2, which is updated.
 4862:          const double htot = side->htot1();
 4863:          const double hhat = side->hhat;
 4864: 
 4865:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4866: 
 4867:          Vector2 tau2 = {0.0, 0.0};
 4868:           
 4869:          if constexpr(ics==1) {
 4870:             tau2 = side->tau();
 4871: 
 4872:          } else {
 4873:             assert(false && "Not implemented: ics == 2");
 4874:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4875:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4876:             // taux2=(vn1+tt1)*0.5d0
 4877:             // tauy2=(vn2+ss1)*0.5d0
 4878:          } // if ics         
 4879: 
 4880:          // hat_gam has units of m/s
 4881: 
 4882:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4883: 
 4884:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4885:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4886: 
 4887:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4888: 
 4889:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4890:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4891: 
 4892:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4893: 
 4894:       }
 4895:       else { // 3D
 4896: 
 4897:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4898:          // 
 4899:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4900:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4901:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4902:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4903:          // k+1 and k.
 4904: 
 4905: 
 4906:          // // Define layer thickness & viscosity
 4907:          // for (int k=kb + 1; k<nvrt; k++) {
 4908:          //    const double dzz = side->Dz(k - 1);
 4909: 
 4910:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4911: 
 4912:          //    // Vertical viscosity at the face center
 4913:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4914:         
 4915:          // }
 4916: 
 4917: 
 4918:          const int ndim = nvrt - kb;
 4919:          const double zTopCanopy = side->zTopCanopy();
 4920: 
 4921:          // Initialize the tridiagonal system
 4922:          for (int k = kb + 1; k<nvrt; k++) {
 4923:             
 4924:             const int kin = k - kb;
 4925: 
 4926:             // Vertical viscosity at the face center
 4927:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4928:             const double dzz = side->Dz(k);
 4929: 
 4930:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4931: 
 4932:             alow[kin] = 0.0;
 4933:             cupp[kin] = 0.0;
 4934:             bdia[kin] = 0.0;
 4935: 
 4936:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4937:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4938: 
 4939:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4940:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4941:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4942: 
 4943:             // First part: layers k, k+1
 4944:             if (k < nvrt - 1) {
 4945:                              
 4946:                if constexpr(iveg != 0) {
 4947: 
 4948:                   // If there is vegetation at this level...
 4949:                   if (zTopCanopy > side->zc[k]) {
 4950:                      // If the canopy is above the k layer...
 4951:                      
 4952:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4953:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4954:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4955:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4956: 
 4957:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4958:                      const double vmag2 = length(ut2);
 4959:                      const double vmag1 = length(side->u2[k]);
 4960:                      const double vmag = 0.5*(vmag1 + vmag2);
 4961:                      
 4962:                      // Computes the vegetation alpha at the face center
 4963:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4964: 
 4965:                      cff1 += veg_alpha_sd*dt*vmag;
 4966: 
 4967:                   } // if (zTopCanopy
 4968:                } // if iveg
 4969: 
 4970:                const double tmp = dt*dfz/dzz;
 4971:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4972:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4973:             }
 4974: 
 4975: 
 4976:             // Second part: layers k-1, k
 4977:             if (k > kb + 1) {
 4978: 
 4979:                double cff1 = 1.0; //init \bar{c^k}
 4980: 
 4981:                if constexpr(iveg != 0) {
 4982:                   // If there is vegetation at this level...
 4983:                   if (zTopCanopy > side->zc[k-1]) {
 4984:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4985:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4986: 
 4987:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4988: 
 4989:                      const double vmag2 = length(ut2);
 4990:                      const double vmag1 = length(side->u2[k-1]);
 4991:                      const double vmag = 0.5*(vmag1 + vmag2);
 4992: 
 4993:                      // Computes the vegetation alpha at the face center
 4994:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4995:                      cff1 += veg_alpha_sd*dt*vmag;
 4996:                   } // if zTopCanopy
 4997: 
 4998:                } // if iveg
 4999: 
 5000:                const double tmp = dt*dfz/dzz;
 5001:                alow[kin] += cff1*dzz/6.0 - tmp;
 5002:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5003: 
 5004:             } else { // Bottom boundary
 5005:                // This occurs at the bottom, where the bottom drag is applied.
 5006: 
 5007:                bdia[kin] += dt*side->chi2;
 5008: 
 5009:             } // if (k > kb + 1)
 5010: 
 5011: 
 5012: 
 5013:          } // for (int k
 5014: 
 5015: 
 5016: 
 5017:          // Computes the RHS.
 5018:          // -----------------
 5019: 
 5020:          //	BC to be imposed at the end.
 5021: 
 5022:          const Vector2 gradETP  = side->gradETP;
 5023:          const Vector2 gradPr   = side->gradPr;
 5024:          const Vector2 gradEta1 = side->gradEta1;
 5025:          const Vector2 gradEta2 = side->gradEta2;
 5026: 
 5027:          const Vector2 *btu = side->btu;
 5028:          const Vector2 *u2  = side->u2;
 5029:          const double coriolis = side->coriolis;
 5030:          const Vector2 *nuGradU = side->nuGradU;
 5031: 
 5032: 
 5033:          for (int k = kb + 1; k<nvrt; k++) {
 5034:             const int kin = k - kb;
 5035: 
 5036:             const double dz_0 = side->Dz(k);
 5037:             const double dz_1 = side->Dz(k+1);  
 5038: 
 5039:             rrhs[kin] = {0.0, 0.0};
 5040:             double dz = 0.0;
 5041: 
 5042:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5043:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5044:             if (k < nvrt  ) dz += 0.5*dz_1;
 5045:             if (k > kb + 1) dz += 0.5*dz_0;
 5046: 
 5047:             // Elevation gradient, atmospheric pressure and tidal potential
 5048:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5049: 
 5050:             // Coriolis, advection, wind stress, and horizontal viscosity
 5051:             if (k < nvrt - 1) {
 5052: 
 5053: 
 5054:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5055:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5056:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5057: 
 5058:                //diff stress tensors 1006
 5059:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5060:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5061:                   assert(false && "Not implemented: itur == 5");
 5062:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5063:                }
 5064: 
 5065:             } else { // k=nvrt
 5066:                Vector2 tau2 = {0.0, 0.0};
 5067:                if constexpr(ics==1) {
 5068:                   tau2 = side->tau();
 5069:                } else {
 5070:                   assert(false && "Not implemented: ics == 2");
 5071:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5072:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5073:                   // taux2=(vn1+tt1)*0.5d0
 5074:                   // tauy2=(vn2+ss1)*0.5d0
 5075:                } // if ics
 5076: 
 5077:                rrhs[kin] += dt*tau2;
 5078: 
 5079:             } // if k<nvrt
 5080: 
 5081:             if (k > kb + 1) {
 5082:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5083:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5084:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5085: 
 5086: 
 5087:                // diff stress tensors 1006
 5088:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5089:                   assert(false && "Not implemented: itur == 5");
 5090:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5091:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5092:                }
 5093: 
 5094:             } // if k>kbs + 1
 5095: 
 5096:             // Baroclinic
 5097:             Vector2 *bcc = side->bcc;
 5098:             if constexpr(ibc == 0) {
 5099:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5100:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5101: 
 5102:             } // if ibc==0
 5103: 
 5104: 
 5105:          } // k=kb + 1,nvrt
 5106: 
 5107:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5108:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5109: 
 5110: 
 5111:          for (int k=kb + 1; k<nvrt; k++) {
 5112:             const int kin = k - kb;
 5113: 
 5114:             // Velocity is always clamped to maximum values
 5115:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5116:          } // k
 5117: 
 5118:       } // if side->is2D()
 5119:       
 5120: 
 5121:       // Impose velocity boundary condition at the bottom
 5122:       if constexpr(imm == 2) { // 3D bed deformation model
 5123:          double dep;
 5124:          Vector2 vel;
 5125: 
 5126:          assert(false && "Not implemented: imm == 2");
 5127:          //update_bdef(time, x0, y0, dep, vel);
 5128:          // side->u2[kb] = vel;
 5129: 
 5130:       } else { // imm = 0 or 1
 5131:          if (side->Cd() == 0.0) {
 5132:             side->u2[kb] = side->u2[kb + 1];
 5133:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5134:             side->u2[kb] = {0.0, 0.0};
 5135:          }
 5136:           
 5137:       } // if imm
 5138: 
 5139:       // The velocities below the bottom level are set to zero
 5140:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5141: 
 5142: 
 5143:    }
 5144: 
 5145: 
 5146:    __global__ void applyMomentumBC(void) {
 5147: 
 5148:       SIDE_BND(sideBnd);
 5149: 
 5150:       Side *side = sideBnd->side;
 5151:       const BoundarySegment *segment = sideBnd->segment;
 5152:       const Node *n1 = side->n1;
 5153:       const Node *n2 = side->n2;
 5154: 
 5155:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5156: 
 5157:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5158:       const bool isLand = segment->isLand;
 5159:       const int ifltype = segment->ifltype;
 5160: 
 5161:       const int kb = side->kb;
 5162: 
 5163:       if (!isLand && ifltype != 0) {
 5164:          const Vector2 *ubc = sideBnd->ubc;
 5165:   
 5166:          for (int k=kb; k < nvrt; k++) {
 5167:             
 5168:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5169:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5170: 
 5171:             if (ifltype == -1) {
 5172:                // Flather 1
 5173: 
 5174:                const double depth = side->depth();
 5175: 
 5176:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5177: 
 5178:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5179: 
 5180:                side->u2[k] = vnorm*side->n;
 5181: 
 5182:             } else if (ifltype == -2) { // Discharge
 5183: 
 5184:                const double eta1 = side->eta1();
 5185:                const double eta2 = side->eta2();
 5186:                const double htot = side->htot2();
 5187: 
 5188:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5189:                assert(false && "Not implemented: Discharge bc");
 5190:                // const double dischrg = discharge(eta1);
 5191:                const double dischrg = 0.0; // XXX REMOVE
 5192:                
 5193: 
 5194:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5195: 
 5196:                const double vnorm = dischrg*eta2/htot;
 5197: 
 5198:                side->u2[k] = vnorm*side->n;
 5199: 
 5200: 
 5201:             }
 5202:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5203:                const double vnorm = dot(side->u2[k], side->n);
 5204: 
 5205:                double rat;
 5206:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5207:                else              rat = segment->vobc2; // outgoing
 5208: 
 5209:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5210:             }
 5211:             else { // not Flather or 3D radiation
 5212:                side->u2[k] = ubc[k];
 5213: 
 5214:             } // if (segment->ifltype...
 5215: 
 5216:          }
 5217: 
 5218:       }
 5219:       else if (isLand) { // if it is land boundary side
 5220: 
 5221:          if constexpr(islip == 0) { // free slip
 5222:             for (int k=kb; k < nvrt; k++) {
 5223: 
 5224:                const Vector2 t = side->t();
 5225:                const Vector2 n = side->n;
 5226: 
 5227:                double vnorm = 0.0; // for most cases
 5228:                const double vtan = dot(side->u2[k], t);
 5229:                
 5230:                side->u2[k] = vtan*t - vnorm*n;
 5231: 
 5232:             }
 5233: 
 5234:          } else { // no slip
 5235:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5236: 
 5237:          }
 5238:       } // if (side segment type...
 5239: 
 5240:    
 5241: 
 5242:    }
 5243: 
 5244: 
 5245:    __global__ void shapiroFilter1(void) {
 5246:       // First step of the Shapiro filter (normally used if indvel<=0)
 5247:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5248: 
 5249:       SIDE(side);
 5250: 
 5251:       // Only internal wet sides are processed
 5252:       if (side->isDry || !(side->isInternal())) return;
 5253: 
 5254:       const int kb = side->kb;
 5255: 
 5256:       for (int mm = 1; mm <= niter_shap; mm++) {
 5257: 
 5258:          for (int k = kb + 1; k < nvrt; k++) {
 5259:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5260:             side->bcc[k] = {0.0, 0.0};
 5261:             Vector2 suru = {0.0, 0.0};
 5262: 
 5263:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5264: 
 5265:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5266: 
 5267:                int kin = k;
 5268:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5269:                
 5270:                if constexpr(ics==1) {
 5271:                   suru += nSide->u2[kin];
 5272: 
 5273:                } else {
 5274:                   assert(false && "Not implemented: ics == 2");
 5275:                   // Vector2 vn1, vn2;
 5276:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5277:                   // suru=suru+vn1;
 5278:                   // surv=surv+vn2;
 5279:                }
 5280:             }
 5281: 
 5282: 
 5283:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5284: 
 5285:          }
 5286:       }
 5287:    }
 5288: 
 5289:    __global__ void shapiroFilter2(void) {
 5290:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5291: 
 5292:       SIDE(side);
 5293: 
 5294: // side->u2[1] = {10.0,-10.0}; 
 5295: // side->u2[0] = {10.0,-10.0};
 5296: // return;      
 5297: 
 5298:       if (side->isDry || !(side->isInternal())) return;
 5299: 
 5300:       const int kb = side->kb;
 5301: 
 5302:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5303: 
 5304:       if (side->is2D()) {
 5305:          // side->u2[kb] = side->u2[nvrt - 1];
 5306:          side->u2[kb + 1] = side->bcc[kb + 1];
 5307:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5308: 
 5309:       } else {
 5310:          // 3D
 5311:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5312:          
 5313:       }
 5314: 
 5315:    }
 5316: 
 5317: 
 5318:    __global__ void ul0UpdateZCoords(void) {
 5319:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5320:       
 5321:       NODE(node);      
 5322: 
 5323:       if (node->isDry2()) { 
 5324: 
 5325:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5326: 
 5327:          if constexpr(ivcor != 1) node->kb = 0;
 5328: 
 5329:       } else {
 5330: 
 5331:          node->updateKb();
 5332:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5333: 
 5334:       }
 5335: 
 5336:       // We use the temp.b field to store the previous state of isDry.
 5337:       node->tmp.b = node->isDry;
 5338: 
 5339:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5340:       node->isDry = true;
 5341: 
 5342:    }
 5343: 
 5344:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5345:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5346:    {
 5347:       ELEM(elem);
 5348: 
 5349:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5350: 
 5351:       // All the nodes of a wet element are wet.
 5352:       if (!elem->isDry) {
 5353:          elem->nodes[0]->isDry = false;
 5354:          elem->nodes[1]->isDry = false;
 5355:          elem->nodes[2]->isDry = false;
 5356:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5357: 
 5358:       }
 5359: 
 5360: 
 5361:       elem->kb = 0;
 5362: 
 5363:       if (elem->isDry) return;
 5364: 
 5365:       // Wet
 5366:       const Node *n1 = elem->nodes[0];
 5367:       const Node *n2 = elem->nodes[1];
 5368:       const Node *n3 = elem->nodes[2];  
 5369:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5370: 
 5371:    //    if(elem->isDry2()) {
 5372:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5373:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5374:    //        call parallel_abort(errmsg)
 5375:    //    }
 5376: 
 5377: 
 5378:       // Computes element's kb as the minimum of the nodes' kb.
 5379:       const int kb1 = n1->kb;
 5380:       const int kb2 = n2->kb;
 5381:       const int kb3 = n3->kb;
 5382:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5383: 
 5384: 
 5385:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5386: 
 5387: 
 5388:       // Computes the element z as the mean of the nodes z.
 5389:       for (int k = elem->kb; k < nvrt; k++) {
 5390: 
 5391:          // Compute the element z as the mean of the nodes z.
 5392:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5393:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5394:          elem->z[k] /= elem->i34;
 5395: 
 5396:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5397:       }
 5398:                   
 5399:    }
 5400: 
 5401:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5402:    {
 5403:       NODE(node);
 5404:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5405: 
 5406:       if (it == iths) return;
 5407: 
 5408: 
 5409:       if(!node->isDry && node->tmp.b) { // rewetted
 5410:          for (int k=0; k < nvrt; k++) {
 5411: 
 5412:             Vector3 utmp={0.0, 0.0, 0.0};
 5413: 
 5414:             double ttmp=0.0;
 5415:             double stmp=0.0;
 5416:             int icount=0;
 5417:             for (int j = 0; j < node->numNodes; j++) {
 5418: 
 5419: 
 5420:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5421:                if (!node->isDry) { // all indices extended
 5422:                   icount++;
 5423: 
 5424:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5425:                   utmp += node->u2[k];
 5426:                   
 5427:                   ttmp += node->tracers[k].tracer[0]; 
 5428:                   stmp += node->tracers[k].tracer[1]; 
 5429:                }
 5430:             }
 5431: 
 5432:             if(icount > 0) {
 5433:                const double inv_icount = 1.0/icount;
 5434:                node->u2[k]     = inv_icount*utmp;
 5435:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5436:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5437:             }
 5438:          }
 5439:       }
 5440:    }
 5441: 
 5442: 
 5443:    __global__ void ul0UpdateSides(int it, int iths) {
 5444: 
 5445:       SIDE(side);
 5446: 
 5447:       // A side is wet if and only if at least one of its elements is wet.
 5448:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5449: 
 5450:       const Node *n1 = side->n1;
 5451:       const Node *n2 = side->n2;
 5452:       const int kb1 = n1->kb;
 5453:       const int kb2 = n2->kb;
 5454: 
 5455:       side->kb = 0; // dry
 5456: 
 5457:       if (isWet) {
 5458: 
 5459:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5460: 
 5461:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5462: 
 5463:          side->kb = min(kb1, kb2);
 5464: 
 5465:          for (int k = side->kb; k < nvrt; k++) {
 5466:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5467: 
 5468:          
 5469:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5470: 
 5471:             // Compute velocity for re-wetted sides 
 5472:             if ((it != iths) && (side->isDry && isWet)) {
 5473:             
 5474:                Vector2 utmp={0.0, 0.0};
 5475: 
 5476:                int icount=0;
 5477: 
 5478:                // For all the sides on the two elements that share this side
 5479:                for (int j=0; j < 2; j++) {
 5480:                   const Element *elem = side->elems[j];
 5481:                   if (elem == nullptr) continue;
 5482: 
 5483:                   for (int jj=0; jj < elem->i34; jj++) {
 5484:                      const Side *nSide = elem->sides[jj];
 5485:                      if (nSide->isDry) continue;
 5486: 
 5487:                      icount++;
 5488:                      utmp += nSide->u2[k];                     
 5489:                   }
 5490:                }
 5491:                   
 5492:                assert(icount > 0 && "No wet sides around this side");
 5493:                if (icount > 0)  side->u2[k] = utmp/icount;
 5494:                   
 5495:             } // if ((it != iths) && (side->isDry && isWet))
 5496: 
 5497:          } // for k
 5498: 
 5499:       } // if isWet
 5500:    
 5501:       side->isDry = !isWet;
 5502: 
 5503:    }
 5504: 
 5505: 
 5506:    __global__ void zeroNodalVelocities(void) {
 5507:       NODE(node);
 5508: 
 5509:       for (int k = 0; k < nvrt; k++) {
 5510:          node->u2[k]   = {0.0, 0.0, 0.0};
 5511:          node->utmp[k] = {0.0, 0.0};
 5512:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5513:       }
 5514:    }
 5515: 
 5516:    __global__ void computeNodalVerticalVelocities1(void) {
 5517:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5518:    // Adds the element's vertical velocity times the element's area.
 5519:       ELEM(elem);
 5520: 
 5521:       for (int j = 0; j < elem->i34; j++) {
 5522:          Node *node = elem->nodes[j];
 5523: 
 5524:          for (int k = node->kb; k < nvrt; k++) {
 5525:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5526:          }
 5527:          atomicAdd(&(node->tmp.d), elem->area);
 5528:       }
 5529:    }
 5530: 
 5531:    __global__ void computeNodalVerticalVelocities2(void) {
 5532:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5533:    // Divides by the total area of the elements sharing the    node.
 5534:       NODE(node);
 5535: 
 5536:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5537:    }
 5538: 
 5539: 
 5540:    __global__ void computeNodalHorizontalVelocities1(void) {
 5541:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5542:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5543: 
 5544:       ELEM(elem);
 5545: 
 5546:       const int kb = elem->kb;
 5547:       const bool isTri = elem->isTri();
 5548: 
 5549:       if constexpr(indvel <= 0) {
 5550:          // Assuming discontinoius hvel.
 5551: 
 5552: 
 5553:          if (isTri) { // For triangles
 5554:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5555:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5556: 
 5557:             for (int j = 0; j < 3; j++) {
 5558:                // For every node of the triangle...
 5559:                Node *node = elem->nodes[j];
 5560: 
 5561:                const Side *s1 = elem->sides[j];
 5562:                const Side *s2 = elem->sides[(j + 1) % 3];
 5563:                const Side *s3 = elem->sides[(j + 2) % 3];
 5564: 
 5565:                const int numElements = node->numElements;
 5566: 
 5567:                for (int k = kb; k < nvrt; k++)  {
 5568:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5569:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5570:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5571:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5572:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5573:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5574: 
 5575:                }
 5576: 
 5577:             }
 5578:          }
 5579:          else { // For quads
 5580: 
 5581:          }
 5582: 
 5583:       }
 5584:       
 5585:    }
 5586: 
 5587: 
 5588:    __global__ void computeNodalHorizontalVelocities2(void) {
 5589:       NODE(node);
 5590: 
 5591:       for (int k = 0; k < nvrt; k++) {
 5592:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5593:       }
 5594:       
 5595:    }   
 5596: 
 5597:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5598:    // XXXX I'm not sure where I got this function from. 
 5599:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5600:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5601:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5602:    // It uses the utmp array as a temporary array to store the velocities.
 5603: 
 5604:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5605: 
 5606:       SIDE(side);
 5607: 
 5608:       const int kb = side->kb;
 5609: 
 5610:       Node *n1 = side->n1;
 5611:       Node *n2 = side->n2;
 5612: 
 5613:       for (int k = kb; k < nvrt; k++) {
 5614: 
 5615:          // Cast the u2 vector into a Vector2 
 5616:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5617:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5618: 
 5619:          n1_u2 = side->u2[k]/n1->numSides;
 5620:          n2_u2 = side->u2[k]/n2->numSides;
 5621: 
 5622:       }
 5623: 
 5624: 
 5625:    }
 5626: 
 5627:    __global__ void resetVelocityOpenBndNodes(void) {
 5628:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5629: 
 5630:       NODE_BND(nodebnd);
 5631: 
 5632:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5633:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5634:       }
 5635: 
 5636:    }
 5637: 
 5638: 
 5639:    __global__ void setVelocityOpenBndNodes(void) {
 5640:    // For open boundary nodes sets their velocity to the imposed values.
 5641: 
 5642:       SIDE_BND(sidebnd);
 5643: 
 5644:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5645:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5646:          // to its segment to the average of the side velocity.
 5647: 
 5648:          for (int k = 0; k < nvrt; k++) {
 5649:             Node *n1 = sidebnd->side->n1;
 5650:             Node *n2 = sidebnd->side->n2;
 5651: 
 5652:             // Cast the u2 vector into a Vector2 
 5653:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5654:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5655: 
 5656:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5657:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5658:          }
 5659:       }
 5660: 
 5661:    }
 5662: 
 5663: 
 5664:    __global__ void computeVerticalVelocity(void) {
 5665:       // Computes the vertical velocity at the (2D) element's centroid.
 5666:       // In this function we will be considering volumetric elements, with side faces and a 
 5667:       // bottom and a top face. We will call them SFs, BF and TF.
 5668:       // It computes the flux coming from BF and the SFs.
 5669:       // If the bed is moving, it takes that into account.
 5670:       // Since water is incompressible, the integral of the velocity times the normal vector
 5671:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5672:       // and the BF is equal to the flux going out from the TF.
 5673:       // TF = - BF - sum(SFs).
 5674:       // It then computes the horizontal velocity at the center of TF.
 5675:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5676:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5677:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5678: 
 5679:       ELEM(elem);
 5680: 
 5681:       if (elem->isDry) return;
 5682: 
 5683:       const int kb = elem->kb;
 5684:       const bool isTri = elem->isTri();
 5685: 
 5686:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5687: 
 5688:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5689:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5690:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5691: 
 5692:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5693: 
 5694:       double area3D;
 5695: 
 5696:       // Bottom face flux
 5697:       double bottomFlux = 0.0;
 5698:       Vector2 u2meanBottom = {0.0, 0.0};
 5699:       const Vector2 gradh = elem->grad2(&Node::depth);
 5700:       if constexpr(imm==2) {
 5701:          Vector3 ubed;
 5702: 
 5703:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5704:          // updateBDEF(ubed);
 5705:      
 5706:          // const double bflux0 = dot(ubed, elem_n1);
 5707: 
 5708:          // elem->w[kb] += ubed.z;
 5709:       }
 5710:       else {
 5711:          Vector2 umean;
 5712:          if constexpr(ics == 1) {
 5713:             u2meanBottom = elem->mean(kb, &Side::u2);
 5714:          }
 5715:          else {
 5716:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5717:          }
 5718: 
 5719:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5720:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5721: 
 5722:          bottomFlux = - dot(gradh, u2meanBottom);
 5723:       } // if imm
 5724: 
 5725:       // Compute w for kb+1 to nvrt-1
 5726:       for (int l = kb; l < nvrt - 1; l++) {
 5727: 
 5728:          // normal vector to the top face of the "volumetric" element (3D)
 5729:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5730: 
 5731:          // Compute the total flux at the sides
 5732:          double sideFlux = 0.0;
 5733:          Vector2 u2top = {0.0, 0.0};
 5734:          for (int j = 0; j < elem->i34; j++) {
 5735:             const Side *side = elem->sides[j];
 5736: 
 5737:             const double sideArea = side->area(l);
 5738:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5739:             const double sign = elem->ssign[j]; 
 5740: 
 5741:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5742:          }
 5743:          
 5744:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5745:          //velocities at the centers of the sides
 5746:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5747: 
 5748:          // The flx at the top ace can be computed from the other flows.
 5749:          const double topFlux = - sideFlux - bottomFlux;
 5750:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5751: 
 5752:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5753: 
 5754:          elem_n1 = elem_n2;
 5755: 
 5756:          bottomFlux = - topFlux;
 5757:       }
 5758:    }  
 5759: 
 5760: 
 5761: 
 5762: 
 5763: 
