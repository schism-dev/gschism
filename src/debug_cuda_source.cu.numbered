 2163:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2164:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2165:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2166:       else          v[3] = Vector2();
 2167:    }
