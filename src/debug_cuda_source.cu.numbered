 7497: __global__ void returnMatrix(double *res) {
 7498:    // Debugging: returns the matrix as a CuPy array
 7499: 
 7500:    const int size = mesh->np;
 7501:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7502:       const Node *node = mesh->localNodeData + idx_node;
 7503:       res[idx_node*size + idx_node] = node->coeffDiag;
 7504:       for (int j = 0; j < node->numNodes; j++) {
 7505:          Node* nbNode = node->nodes[j];
 7506:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7507:       }
 7508: 
 7509:    }
 7510:    
 7511: }
