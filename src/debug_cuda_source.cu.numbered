 9082: __global__ void printMatrix(bool full) {
 9083:    // Debugging: print the FEM matrix row for each local node
 9084: 
 9085:    const int size = mesh->np;
 9086:    double sum = 0.0;
 9087: 
 9088:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9089:       const Node *node = mesh->localNodeData + idx_node;
 9090: 
 9091:       if (full)
 9092:          printf("idx_node = %d [%d] diag=%lf, [",
 9093:                 idx_node, node->numNodes, *(node->coeffDiag));
 9094: 
 9095:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9096:       for (int k = 0; k < node->numNodes + 1; k++)
 9097:          sum += node->coeffRow[k];
 9098: 
 9099:       for (int j = 0; j < node->numNodes; j++) {
 9100:          const Node *nbNode = node->nodes[j];
 9101:          const double aij = node->coeffRow[node->csrSlot[j]];
 9102:          if (full && aij != 0.0)
 9103:             printf("%d:%f,  ", nbNode->idx, aij);
 9104:       }
 9105: 
 9106:       if (full) printf("]\n");
 9107:    }
 9108: 
 9109:    if (!full) printf("sum=%lf\n", sum);
 9110: }
