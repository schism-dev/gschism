 2739: 
 2740: //       const Side& side = sides[i];
 2741: 
 2742: //       xIntersect=-1.e25;
 2743: //       yIntersect=-1.e25;
 2744: 
 2745: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2746: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2747: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2748: 
 2749: //       if (delta != 0.0) {
 2750: //          // Solves the two linear equations for tt1 and tt2
 2751: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2752: //          const double tt2 = delta2/delta;
 2753: 
 2754: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2755: //          // Similarly, we use tt2 to compute the intersection point.
 2756: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2757: //             xIntersect = x3 + (x4 - x3)*tt2;
