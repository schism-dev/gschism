 2810: 
 2811: __device__ void Node::updateKb(void) {
 2812: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2813: 
 2814:    if constexpr(ivcor == 1) return;
 2815: 
 2816: 
 2817:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2818: 
 2819:    if constexpr(ivcor == 2) {  // SZ coordinates
 2820:       
 2821:       // Compute bottom level index
 2822:       if (depth <= mesh->h_s) {
 2823:          kb = izlev;   
 2824:          
 2825:       } else {
 2826:          kb = -1;
 2827:          int L = 0;
 2828:          int R = nzlev; 
 2829:          
 2830:          while (L <= R) {
 2831:             int M = (R + L) / 2;
 2832: 
 2833: 
 2834:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2835:             
 2836:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2837:                R = M;
 2838:             } else {
 2839:                L = M;
 2840:             }
 2841: 
 2842:             if (R - L == 1) {
 2843:                kb = L;
 2844:                break;
 2845:             }
 2846:          }
 2847: 
 2848:          // Checks that the binary search was successful
 2849:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2850:        
 2851:       }
 2852:    } 
 2853: }
 2854: 
