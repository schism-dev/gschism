  497: 
  498: // Polynomial class
  499: template<int grade>
  500: struct Polynomial {
  501:     // Static assertion to give a clear error message at compile time
  502:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  503: };
  504: 
  505: 
  506: // Explicit specialization for grade 4
  507: template<>
  508: struct Polynomial<4> {
  509:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  510: 
  511:    // Constructor from coefficients
  512:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  513: 
  514:    __device__ __forceinline__ double eval(double x) const {
  515:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  516:    }
  517: };
  518: 
  519: // ------------------------------------------------------------------------------------------------
  520: 
  521: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  522:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  523:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  524: }
  525: 
  526: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  527:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  528:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  529: }
  530: 
  531: 
  532: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  533:    x3 = y1*z2 - y2*z1;
  534:    y3 = x2*z1 - x1*z2;
  535:    z3 = x1*y2 - x2*y1;
  536: // XXXXXX IS THIS REPEATED????
  537: }
  538: 
  539: 
  540: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  541: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  542: //
  543: 
  544:    const double radius2 = dot(p, p);
  545:    const double radius = sqrt(radius2);
  546:  
  547:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  548:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  549: 
  550:    rlon = atan2(p.y, p.x); // (-pi,pi]
  551: 
  552:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  553:       rlat = asin(p.z/radius);
  554:    } else {
  555:       rlat = asin(p.z/rearth_pole);
  556:    }
  557:   
  558: }
  559: 
  560: 
  561: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  562: // Compute the 3D Cartesian coordinates from the latitude and longitude
  563: // Inputs:
  564: //        lat: latitude in radians
  565: //        lon: longitude in radians
  566: // Output:
  567: //        x, y, z: 3D Cartesian coordinates
  568: 
  569:    double sin_lat, cos_lat, sin_lon, cos_lon;
  570: 
  571:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  572:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  573: 
  574:    sincos(lat, &sin_lat, &cos_lat);
  575:    sincos(lon, &sin_lon, &cos_lon);
  576: 
  577:    const double x = rearth_eq*cos_lat*cos_lon;
  578:    const double y = rearth_eq*cos_lat*sin_lon;
  579:    const double z = rearth_pole*sin_lat;
  580: 
  581:    return make_double3(x, y, z);
  582: }
  583: 
  584: __inline__ __device__ void Error(const char* msg) {
  585:    printf("Error: %s\n", msg);
  586:    assert(false);
  587: }
