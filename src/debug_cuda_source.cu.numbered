 2559:    
 2560: //    Assumption: the 4 points (including those of the side segment) are different.
 2561: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2562: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2563: //    If true, (xIntersect,yIntersect) is the intersection.				
 2564: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2565: // **/
 2566: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2567: //                                                          Side& intersectingSide, Element& nextElement,
 2568: //                                                          double& xIntersect, double& yIntersect) {
 2569: //    for (int i = 0; i < i34; i++) {
