 2766: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2767: 
 2768: 
 2769: __device__ void Node::updateKb(void) {
 2770: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2771: 
 2772:    if constexpr(ivcor == 1) return;
 2773: 
 2774: 
 2775:    if (isDry2()) return;
 2776: 
 2777:    if constexpr(ivcor == 2) {  // SZ coordinates
 2778:       
 2779:       // Compute bottom level index
 2780:       if (depth <= mesh->h_s) {
 2781:          kb = izlev;
 2782:          
 2783:       } else {
 2784:          kb = -1;
 2785:          int L = 0;
 2786:          int R = nzlev; 
 2787:          
 2788:          while (L <= R) {
 2789:             int M = (R + L) / 2;
 2790: 
 2791: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2792:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2793:             
 2794:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2795:                R = M;
 2796:             } else {
 2797:                L = M;
 2798:             }
 2799: 
 2800:             if (R - L == 1) {
 2801:                kb = L;
 2802:                break;
 2803:             }
 2804:          }
 2805:       }
 2806:    } 
 2807: }
 2808: 
 2809: 
 2810: __device__ __inline__ void Node::updateZCoordData(void) {
 2811: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2812: 
 2813:    if (isDry2()) {
 2814:       kb = -1;
 2815:       return;
 2816:    }
 2817: 
 2818:    if constexpr(ivcor == 2) {  // SZ coordinates
 2819:       
 2820:       // Compute bottom level index
 2821:       if (depth <= mesh->h_s) {
 2822:             kb = izlev;
 2823: 
 2824:       } else {
 2825:          kb = -1;
 2826:          for (int i = 0; i < nzlev; i++) {
 2827:             // XXX Use binary search
 2828:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2829:                kb = i;
 2830:                break;
 2831:             }
 2832:          }
 2833:       }
 2834:    } 
 2835:    else if (ivcor == 1) {  // Localized sigma
 2836:       // Do nothing
 2837:    }
 2838: 
 2839: }
 2840: 
 2841: __device__ double Node::compZCoord(int k) const {
 2842:    // Computes the z coordinate at level k.
 2843:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2844:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2845:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2846:    // used 
 2847:    
 2848:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2849: 
 2850:    if (isDry2()) return 0.0;
 2851: // if (htot2() <= h0) printf("idx = %d, htot2() = %f, h0 = %f\n", idx, htot2(), h0); XXX
 2852: // if (htot2() <= h0) return 0.0; // XXX
 2853:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2854: 
 2855:    if constexpr(ivcor == 2) {
 2856: 
 2857:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2858:       const double h_c = mesh->h_c;
 2859:       const double theta_f = mesh->theta_f;
 2860:       const double sinh_theta_f = mesh->sinh_theta_f;
 2861: 
 2862:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2863:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2864:       // once per time step/node.
 2865:       // CHECK: updateZCoordData
 2866: 
 2867:       //  To simplify comparisons, I define index versions of count variables.
 2868:       if      (k == ivrt)           return eta2; 
 2869:       else if (k == izlev)          return -hmod2;
 2870:       else if (k == kb)             return -depth;
 2871:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2872:       else if (k > izlev) {
 2873:          const int ksig = k - izlev;
 2874: 
 2875:          if (hmod2 <= h_c) {
 2876: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2877:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2878:          } 
 2879:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2880:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2881:             assert(false && "ZCOOR: invalid h_c\n");
 2882:          } 
 2883:          else {
 2884: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2885:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2886:                          h_c * mesh->sigma[ksig] + 
 2887:                          (hmod2 - h_c) * mesh->cs[ksig];
 2888:          }
 2889:       } else { 
 2890:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2891:       }
 2892: 
 2893:    }
 2894:    else if constexpr(ivcor == 1) {
 2895:       if (k == kb) return -depth;
 2896:       else if (k == nvrt-1) return eta2;
 2897:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2898:    }
 2899:    
 2900:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2901:    return 0.0;
 2902: }
 2903: 
 2904: 
 2905: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2906:    // Checks if a side in on the boundary
 2907:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2908: 
 2909:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2910:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2911: 
 2912:    // Indices of the nodes that form the side
 2913:    const int n1 = side.n1->idx;
 2914:    const int n2 = side.n2->idx;
 2915:    isLand = false;
 2916:    
 2917: if (n1 == 10) printf("nland = %d, nope = %d, ilnd[0] = %d, ilnd[1*nland] = %d, ilnd[2*nland] = %d, ilnd[3*nland] = %d\n", nland, nope, ilnd[0], ilnd[1*nland], ilnd[2*nland], ilnd[3*nland]);
 2918:    // Check if the side is on a land boundary
 2919:    for (int i = 0; i < nland; i++) {
 2920:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2921:          // Consecutive nodes in the land boundary segment
 2922:          const int b1 = ilnd[i + j*nland];
 2923:          const int b2 = ilnd[i + (j + 1)*nland];
 2924: 
 2925:          assert(b1 != -1 && b2 != -1);
 2926: 
 2927:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2928:             
 2929:             isLand = true;
 2930:             return i;
 2931:          }
 2932:       }
 2933:    }
 2934: 
 2935:    // Check if the side is on an open boundary
 2936:    for (int i = 0; i < nope; i++) {
 2937:       for (int j = 0; j < nond[i] - 1; j++) {
 2938:          // Consecutive nodes in the open boundary segment
 2939:          const int b1 = iond[i + j*nope];
 2940:          const int b2 = iond[i + (j + 1)*nope];
 2941: 
 2942:          assert(b1 != -1 && b2 != -1);
 2943: 
 2944:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2945:             isLand = false;
 2946:             return i;
 2947:          }
 2948:       }
 2949:    }
 2950: // printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2951:    return -1;
 2952: }
 2953: 
 2954: 
 2955: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2956:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2957:                                     double *wind_rotate_angle, 
 2958:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2959:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2960:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2961:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2962:                                     double *drag, double *roughness) {
 2963: 
 2964:    NODE(pnode);  
 2965:    const int i = idx_node;
 2966:    Node &node(*pnode);
 2967: 
 2968:    node.idx = i;
 2969: 
 2970:    const int idxNodeStart = nodeNeighNodesStart[i];
 2971:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2972:    node.numNodes = idxNodeEnd - idxNodeStart;
 2973:    node.nodes = nodeNeighNodes + idxNodeStart;
 2974:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2975: 
 2976: 
 2977: 
 2978:    const int idxElemStart = nodeNeighElemsStart[i];
 2979:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2980:    node.numElements = idxElemEnd - idxElemStart;
 2981:    node.elements = nodeNeighElems + idxElemStart;
 2982: 
 2983:    
 2984:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2985:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2986:       const int partNode = localNodePart[idxNodeGlobal]; 
 2987:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2988: 
 2989:       Node *node_ptr = nodes[partNode] + idxNode;
 2990:       
 2991:       nodeNeighNodes[idx] = node_ptr;
 2992:    }
 2993: 
 2994: 
 2995:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2996:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2997:       const int partElem = localElemPart[idxElemGlobal];
 2998:       const int idxElem  = localElemIndices[idxElemGlobal];
 2999: 
 3000:       Element *elem_ptr = elems[partElem] + idxElem;
 3001: 
 3002:       nodeNeighElems[idx] = elem_ptr;
 3003:    }      
 3004: 
 3005: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3006: 
 3007:    node.wind_angle = wind_rotate_angle[i];
 3008: 
 3009: 
 3010:    node.p.x   = node_coords[i * 3];
 3011:    node.p.y   = node_coords[i * 3 + 1];
 3012:    node.depth = node_coords[i * 3 + 2];
 3013: 
 3014:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3015:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3016: 
 3017:    node.numSides = 0;
 3018: 
 3019:    node.Cd = drag[i];
 3020:    node.rough = roughness[i];
 3021:    
 3022:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3023: 
 3024:    // Links the node to the boundary information
 3025:    if (isbnd[i] >= 0) {
 3026: 
 3027:      
 3028:       // Get the index of the node boundary
 3029:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3030: 
 3031:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3032:       node.nodeBnd->node = &node;
 3033: 
 3034:       node.nodeBnd->sideBnd1 = nullptr;
 3035:       node.nodeBnd->sideBnd2 = nullptr;
 3036: 
 3037:       if (isbnd[i]>=0) {
 3038: 
 3039:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3040:          
 3041:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3042:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3043: 
 3044:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3045:          node.nodeBnd->segment->clen  = nan("1");
 3046:          node.nodeBnd->segment->carea = nan("1");
 3047: 
 3048:       }
 3049: //          else {  XXXXXX
 3050: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3051: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3052: //          }
 3053:       
 3054: 
 3055:    }
 3056:    else {
 3057: 
 3058:       node.nodeBnd = nullptr; // For internal nodes
 3059: 
 3060:       if (isbnd[i] == landSegment) {
 3061:          node.nodeBnd = &landBoundaryNode;
 3062:          node.nodeBnd->segment = &landBoundarySegment;
 3063:       }
 3064:       // node.nodeBnd->node = &node;
 3065:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3066:       // // node.nodeBnd = nullptr;
 3067:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3068:       
 3069:    }
 3070: 
 3071:    // XXXX GAUSSIAN HILL VELOCITIES
 3072: #ifdef GAUSSIAN_HILL_VELOCITIES
 3073:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3074:       constexpr double rot_per = 3000.0;
 3075:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3076:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3077:    // XXXXX
 3078: #endif
 3079: 
 3080: }
 3081: 
 3082: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3083:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3084:                                     double *wind_rotate_angle,   
 3085:                                     int *isdel, int *isidenode, int *isbnd,
 3086:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3087:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3088:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3089:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3090:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3091:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3092:                                     double *drag, double *roughness) {
 3093: 
 3094: 
 3095:    SIDE(pside);
 3096:    Side &side(*pside);
 3097:    const int i = idx_side;
 3098: 
 3099:    side.idx = i;  
 3100:    
 3101:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3102:    const double fc   = 2.0*omega_e*sin(sfea0);
 3103:    const double beta = 2.0*omega_e*cos(sfea0);
 3104: 
 3105:    // finding the pointer to the nodes that form the side
 3106:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3107:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3108: 
 3109:    const int locidx_n1 = localNodeIndices[idx_n1];
 3110:    const int locidx_n2 = localNodeIndices[idx_n2];
 3111:    const int part_n1 =   localNodePart[idx_n1];
 3112:    const int part_n2 =   localNodePart[idx_n2];
 3113: 
 3114:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3115:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3116: 
 3117:    // Counts the number of sides connected to each node
 3118:    side.n1->numSides++;
 3119:    side.n2->numSides++;
 3120: 
 3121:    // Normal, unitary vector to the side
 3122:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3123:    side.n = normalize(side.n);
 3124: 
 3125:    // Side boundary type
 3126:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3127:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3128: 
 3129:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3130:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3131:    {
 3132:       bool isLand = false;
 3133:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3134:       
 3135:       if (isbs > -1) {
 3136:          // assert(isLand || isbs>=0);
 3137:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3138: 
 3139:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3140:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3141:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3142: 
 3143:          assert (isLand == side.sideBnd->segment->isLand);
 3144: 
 3145:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3146:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3147:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3148: 
 3149:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3150:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3151:          
 3152:          side.sideBnd->side = &side;
 3153: 
 3154:       }
 3155:       else {
 3156:          side.sideBnd = nullptr;
 3157:       }
 3158:    }
 3159:    else 
 3160:    {
 3161:       side.sideBnd = nullptr;
 3162:    }
 3163: 
 3164: 
 3165:    // finding the pointer to the elements that share the side
 3166:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3167:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3168: 
 3169:    if (idx_e1 > -1) {
 3170:       const int locidx_e1 = localElemIndices[idx_e1];
 3171:       const int part_e1 =  localElemPart[idx_e1];
 3172:       side.elems[0] = elems[part_e1] + locidx_e1;
 3173: 
 3174:    }
 3175:    else {
 3176:       side.elems[0] = nullptr;
 3177:    }
 3178: 
 3179:    if (idx_e2 > -1) {
 3180:       const int locidx_e2 = localElemIndices[idx_e2];
 3181:       const int part_e2 =  localElemPart[idx_e2];
 3182:       side.elems[1] = elems[part_e2] + locidx_e2;
 3183:    }
 3184:    else {
 3185:       side.elems[1] = nullptr;
 3186:    }
 3187: 
 3188:    // Compute the center of the side
 3189:    side.center = 0.5*(side.n1->p + side.n2->p);
 3190: 
 3191:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3192:    side.shapiro = shapiro0;
 3193: 
 3194: #ifdef GAUSSIAN_HILL_VELOCITIES
 3195: // XXXX
 3196: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3197: constexpr double rot_per=3000.0;
 3198: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3199: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3200: // XXXXX      
 3201: #endif
 3202:    // Compute the z level at the center of the side
 3203:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3204: 
 3205:    // Compute the length of the side
 3206:    const Vector2 vLen = side.n2->p - side.n1->p;
 3207:    side.len = sqrt(dot(vLen, vLen));
 3208: 
 3209: 
 3210:    // Compute the Coriolis coefficient
 3211: 
 3212:    if constexpr(ncor == -1 || ncor == 0) {
 3213:       side.coriolis = coricoef;
 3214:    }
 3215:    else {
 3216:       const double sphi = side.lat();  // Latitude at the center of the side
 3217: 
 3218: 
 3219:       if constexpr(ics == 1) {
 3220:          // XXXXXXX
 3221:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3222:       }
 3223:       else {
 3224:          side.coriolis = 2.0*omega_e*sin(sphi);
 3225:       }
 3226: 
 3227:    }
 3228: }
 3229: 
 3230: 
 3231: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3232:    double *node_coords, double *node_coords_ll, bool use_ll,
 3233:    double *wind_rotate_angle,   
 3234:    int *isdel, int *isidenode, int *isbnd,
 3235:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3236:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3237:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3238:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3239:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3240:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3241:    double *drag, double *roughness) {
 3242: 
 3243:    ELEM(pelem);
 3244:    Element &elem(*pelem);
 3245:    const int i = idx_elem;
 3246:    
 3247:    elem.idx = i;
 3248: 
 3249:    for (int j = 0; j < i34[i]; j++) {
 3250:       const int idxNode = elnode[i*4 + j];  
 3251:       const int idxSide = elside[i*4 + j];
 3252:       
 3253:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3254:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3255: 
 3256: 
 3257:       // Find the neighboring element  
 3258:       if (elem.sides[j]->elems[0] == &elem) {
 3259:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3260:       }
 3261:       else {
 3262:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3263:       }
 3264:       
 3265:    }
 3266: 
 3267:    elem.i34 = i34[i];
 3268: 
 3269:    // Compute the centroid of the element and its depth
 3270:    Vector2 center = {0.0, 0.0};
 3271:    elem.depth = 0.0;
 3272:    for (int j = 0; j < i34[i]; j++) {
 3273:       center += elem.nodes[j]->p/i34[i];
 3274:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3275:    }
 3276:    elem.center = center;
 3277: 
 3278:    
 3279:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3280:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3281: 
 3282:    elem.area = elem.computeSignedArea(); 
 3283:    elem.radius = sqrt(elem.area)/pi; 
 3284:    
 3285:    // Determines which way the normal vector to each side is oriented.
 3286:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3287:    for (int j = 0; j < i34[i]; j++)  
 3288:    {
 3289:       if (elem.sides[j]->elems[0] == &elem) {
 3290:          elem.ssign[j] =  1.0;
 3291:       }
 3292:       else {
 3293:          elem.ssign[j] = -1.0;
 3294:       }
 3295: 
 3296:    }
 3297: 
 3298:    // Derivatives of shape functions
 3299:    //  For ics=2, this is done inside element/ll frame XXX
 3300:    //  For quads, the derivative is evaluated at centroid
 3301:    for (int j = 0; j < elem.i34; j++) {
 3302:       const double area = elem.area;
 3303:       const int id2 = elem.nxq(1 + j);
 3304:       const int id3 = elem.nxq(2 + j);
 3305:       const int id4 = elem.nxq(3 + j);
 3306:       if (elem.isTri()) {
 3307:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3308:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3309:          // da1/dx = (y1 - y2)/(2*area)
 3310:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3311:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3312:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3313:       }
 3314:       else  { // Quad; evaluate at centroid
 3315:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3316:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3317:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3318:       } // if Tri
 3319: 
 3320:    } // for j   
 3321:    
 3322:    
 3323: 
 3324: }
 3325: 
 3326: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3327:                                             double *emo, double *efa, 
 3328:                                             double *umo, double *ufa, 
 3329:                                             double *vmo, double *vfa) {
 3330: 
 3331: 
 3332:    NODE_BND(nodeBnd);
 3333:    const int idx = idx_node_bnd;    
 3334: 
 3335:    nodeBnd->idx = idx;
 3336: 
 3337:    // Need to find the segment index and the index of the node on the segment
 3338:    int idxNode = -1;
 3339:    int iseg, i;
 3340:    for (iseg = 0; iseg < nope; iseg++) {
 3341:       // for each segment...
 3342:       for (i = 0; i < nond[iseg]; i++) {
 3343:          idxNode = iond[iseg + i*nope];
 3344:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3345:          
 3346:       }
 3347:    }
 3348: 
 3349:    assert(iseg < nope && "iseg is out of bounds");
 3350: 
 3351: found: // Jumped here when the node was found
 3352: 
 3353:    nodeBnd->isEssentialBC = true;
 3354:    nodeBnd->elbc = 0.0;
 3355: 
 3356:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3357: 
 3358:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3359:       nodeBnd->efa[jfr] = efa[idx2];
 3360:       nodeBnd->emo[jfr] = emo[idx2];
 3361:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3362:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3363: 
 3364:    }
 3365:         
 3366: 
 3367: }
