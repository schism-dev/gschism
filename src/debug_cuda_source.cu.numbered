  751:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  752: 
  753:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo) const;
  754:    
  755:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  756: 
  757:    __device__ double intPhiPhi(int i1, int i2) const;
  758: 
  759:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  760: 
  761:    __device__ Vector2 grad2(double *a) const
  762:    {
  763:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  764:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  765:       if (isQuad()) {
  766:          gx += a[3]*gradPhi[3].x;
  767:          gy += a[3]*gradPhi[3].y;
  768:       }
  769:       return {gx, gy};
  770:    }
  771: 
  772:    __device__ Vector2 grad2(double Node::* field) const
  773:    {
  774:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  775:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  776:       if (isQuad()) {
  777:          gx += (nodes[3]->*field)*gradPhi[3].x;
  778:          gy += (nodes[3]->*field)*gradPhi[3].y;
  779:       }
  780:       return {gx, gy};
  781:    }
