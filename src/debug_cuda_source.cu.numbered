 3816: 
 3817: __device__ __forceinline__ int Node::packedIndex() const {
 3818:    // Returns the packed index of the node
 3819:    // Packed index is the index of the partition-block matrices and vectors.
 3820:    return nodeOffsetPerPartition[part] + localIndex();
 3821: }
