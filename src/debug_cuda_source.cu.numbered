 2459: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2460: // return;   
 2461:    // Lock the mutex
 2462:    lock(&debugPlotMutex);
 2463:  
 2464:    bool ok = true;
 2465:    if (debugPlotIdx == nullptr) ok = false;
 2466:    if (*debugPlotIdx >= 1000000) ok = false;
 2467:    if (ok) {
 2468:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2469:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2470:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2471:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2472:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2473:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2474:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2475:       (*debugPlotIdx)++;
 2476:    }
 2477: 
 2478:    __threadfence();               // ensure all above writes are visible
 2479:    // Unlock the mutex
 2480:    unlock(&debugPlotMutex);
 2481: 
 2482: }
