 7683: __global__ void returnMatrix(double *res) {
 7684:    // Debugging: returns the matrix as a CuPy array
 7685: 
 7686:    const int size = mesh->np;
 7687:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7688:       const Node *node = mesh->localNodeData + idx_node;
 7689:       res[idx_node*size + idx_node] = node->coeffDiag;
 7690:       for (int j = 0; j < node->numNodes; j++) {
 7691:          Node* nbNode = node->nodes[j];
 7692:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7693:       }
 7694: 
 7695:    }
 7696:    
 7697: }
