 6214:    //          do j=1,nond_global(k)
 6215:    //            icount2=icount2+1
 6216:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 6217: 
 6218:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 6219:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 6220:    //          enddo !j
 6221:    //        endif
 6222:    //      enddo !k
 6223:    //    endif !nfltype2
 6224:    }
