 1849: // Helper functions for computing the local node index at a given offset from another.
 1850: __device__ __inline__ int nxq(int offset, int index, int size) {
 1851:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1852:    // to the index to make it positive
 1853:    assert(index + offset + 16*size >= 0);
 1854:    return (index + offset + 16*size) % size;  
 1855: }
 1856: 
 1857: __device__ __inline__ int nxq(int index, int size) {
 1858:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1859:    // to the index to make it positive
 1860:    assert(index + 16*size >= 0);
 1861:    return (index + 16*size) % size; 
 1862: }
