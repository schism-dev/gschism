 1403: struct Side {
 1404: 
 1405:    // Geometry information
 1406:    int idx;               // Index of the side
 1407:    Node *n1, *n2;
 1408:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1409: 
 1410:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1411:    Vector2 center;        // Location of side center. 
 1412:    double zc[nvrt];       // Side center z-coord at each vertical level
 1413: 
 1414:    Frame<ics> frame;
 1415:    
 1416:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1417:                           // this is nullptr
 1418:    
 1419:    int16_t kb;            // Bottom index of the side
 1420:    bool isDry;            // True if the side is dry
 1421:  
 1422:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1423: 
 1424:    Tracers tracers[nvrt]; // Tracer concentrations at nodes
 1425: 
 1426:    // Physical information
 1427:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1428:    Vector2 btu[nvrt];           // Back-tracked velocity
 1429:    Vector2 U;                   // Vertically averaged velocity vector  
 1430: 
 1431:    Vector2 nuGradU[nvrt];          // nu*grad u
 1432: 
 1433:    Vector2 bcc[nvrt];           // Baroclinic term
 1434:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1435: 
 1436:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1437:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1438:    Vector2 gradPr;               // Gradient of pressure
 1439:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1440: 
 1441: 
 1442:    double hhat;                 // \breve{H} in notes
 1443: 
 1444:    double shapiro;
 1445: 
 1446:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1447: 
 1448:    double coriolis;             // Coriolis parameter
 1449: 
 1450:    // Vegetation parameters
 1451:    double veg_c2;
 1452:    double veg_beta;
 1453: 
 1454:    // Bottom drag parameters.
 1455:    double chi;
 1456:    double chi2;
 1457: 
 1458:    __inline__ __device__ Point2 outputCoords(void) const;
 1459: 
 1460:    __inline__ __device__ double x(double t) const;
 1461:    __inline__ __device__ double y(double t) const;
 1462:    __inline__ __device__ double z(double t) const;
 1463:    __inline__ __device__ double lon(void) const;
 1464:    __inline__ __device__ double lat(void) const;
 1465:    __inline__ __device__ Point2 p2_t(double t) const;
 1466: 
 1467:    __device__ void setFrame(void) {
 1468:       if constexpr(ics == 1) return;
 1469: 
 1470:       double lat, lon;
 1471:       const Point3 p = toPoint3(center, centerZ());
 1472: 
 1473:       // Compute the latitude and longitude of the element center
 1474:       computeLatLon(p, lat, lon);
 1475: 
 1476:       frame.update(lat, lon);        
 1477:    }
 1478:    
 1479: 
 1480:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1481:    // If ics == 2, convert the global point to the local frame of the side
 1482:       
 1483:       if constexpr (ics == 1) {
 1484:          return p;
 1485:       } else {
 1486:          const Point3 c = {center.x, center.y, centerZ()};
 1487:          const Point3 local = frame.G2L(p - c);
 1488:          return local;
 1489:       }
 1490:    }
 1491: 
 1492:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1493:       if constexpr (ics == 1) {
 1494:          return p;
 1495:       } else {
 1496:          const Point3 c = {center.x, center.y, centerZ()};
 1497:          return c + frame.L2G(p);
 1498:       }
 1499:    }
 1500: 
 1501: 
 1502:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1503:       if constexpr(ics == 1) return v;
 1504:       else return v_frame.projHorVec(v, frame);
 1505:    }
 1506: 
 1507:    __inline__ __device__ double centerZ(void)      const;
 1508:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1509:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1510:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1511:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1512: 
 1513:    __inline__ __device__ Side* neigh(int index) const { 
 1514:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1515:       assert(index >= 0 && index < 4); 
 1516:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1517: 
 1518:       const int ielem = index & 1;           // 0 or 1
 1519:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1520: 
 1521:       const Element* elem = elems[ielem];
 1522: 
 1523:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1524: 
 1525:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1526: 
 1527:    }
 1528: 
 1529:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1530: 
 1531:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1532: 
 1533:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1534:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1535:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1536:    __inline__ __device__ int iadv(void) const;
 1537: 
 1538:    __inline__ __device__ double grav3(void) const;
 1539:    
 1540:    __inline__ __device__ double eta2(void) const;
 1541:    __inline__ __device__ double eta1(void) const;
 1542:    __inline__ __device__ double w2(int k) const;
 1543:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1544:    __inline__ __device__ double depth(void) const;
 1545:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1546:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1547: 
 1548:    __inline__ __device__ double dfv(int k) const;
 1549: 
 1550:    __inline__ __device__ double veg_h(void)  const;
 1551:    __inline__ __device__ double veg_nv(void) const;
 1552:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1553:    __inline__ __device__ double veg_alpha3D(int k) const;
 1554:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1555: 
 1556:    __inline__ __device__ double Cd(void) const;
 1557: 
 1558:    __inline__ __device__ Vector2 tau(void) const;
 1559: 
 1560:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1561:    
 1562: 
 1563:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1564:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1565:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1566:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1567:    } 
 1568:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1569:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1570:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1571:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1572: 
 1573:    // Get valid starting element (for backtracking)
 1574:    __inline__ __device__ Element* getStartElement() {
 1575:       return elems[0] ? elems[0] : elems[1];
 1576:    }
 1577: 
 1578:    
 1579:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1580:       // Given an element, returns the other element that shares this side
 1581:       return (elems[0] == elem) ? elems[1] : elems[0];
 1582:    }
 1583: 
 1584:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1585:       // Given a node, returns the other node that shares this side
 1586:       return (n1 == node) ? n2 : n1;
 1587:    }
 1588:  
 1589:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1590: 
 1591: 
 1592: 
 1593: 
 1594: };
 1595: 
 1596: 
 1597: // This struct is used to store the boundary information for a node.
 1598: struct NodeBoundary {   
 1599:    int idx;
 1600:    BoundarySegment *segment;
 1601:    Node *node;
 1602:    
 1603:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1604:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1605: 
 1606:    bool isLand;
 1607: 
 1608:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1609:    double elbc;   // Elevation boundary condition
 1610:    double eth;    // Elevation time history
 1611: 
 1612:    double eta_mean; // Mean elevation at nodes
 1613: 
 1614:    bool isEssentialBC;
 1615: 
 1616:    Vector2 uth[nvrt];  // "Time history" velocity
 1617: 
 1618:    // Arrays for harmonic constituents (if needed)
 1619:    double  emo[nbfr];  // Elevation amplitude
 1620:    double  efa[nbfr];  // Elevation phase
 1621: 
 1622: 
 1623:    NodeBoundary(void) {
 1624:       isLand = false;
 1625:    }
 1626:    NodeBoundary(bool _isLand) {
 1627:       isLand = _isLand;
 1628:    }
 1629: 
 1630:    
 1631:    __forceinline__ __device__ int numSidesForAverage() const {
 1632:    // Returns the number of sides that are connected to the node and have the same segment.
 1633:    // This is used to compute the average velocity at the node for open boundary nodes.
 1634:       int res = 0;
 1635:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1636:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1637: // printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1638:       return res;
 1639:    }
 1640: 
 1641: 
 1642:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1643:       assert(index == 0 || index == 1); 
 1644:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1645:    }
 1646: 
 1647:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1648:       if (isLand) return;  // land never uses these links
 1649: 
 1650:       SideBoundary *nullSideBoundary = nullptr;
 1651:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1652: 
 1653:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1654:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1655: 
 1656:       // both slots taken. OK if this side was already linked
 1657:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1658:    }
 1659: 
 1660: 
 1661: };
 1662: 
 1663: struct Node {
 1664: 
 1665:    // Geometry information
 1666:    int idx;            // Global index of the node
 1667:    int16_t part;       // Partition of the node
 1668: 
 1669:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1670:    int16_t numNodes;   // Number of nodes neighbors of this node
 1671: 
 1672:    Element **elements; // Array of pointers to the elements that share this node
 1673:    int16_t numElements;// Number of elements that share this node
 1674: 
 1675:    int16_t numSides;   // Number of sides that are connected to this node
 1676: 
 1677: 
 1678:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1679:    double gz;          // Global vertical coordinate at the node.
 1680:    Vector2 u2[nvrt];
 1681:    double  w2[nvrt];
 1682:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1683:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1684:    double lon, lat;
 1685:    double depth;
 1686: 
 1687:    Frame<ics> frame;
 1688: 
 1689:    LocalSigma<ivcor> localSigma;  
 1690: 
 1691:    int16_t kb;     // Bottom index of the node
 1692: 
 1693:    bool isDry;     // True if the node is dry
 1694: 
 1695:    int16_t iadv;   // Advection flag
 1696: 
 1697:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1698:                           // this is nullptr
 1699: 
 1700:    TempVar tmp; // Temporary variable to store different types of variables
 1701: 
 1702:    // Physical information
 1703:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1704:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1705: 
 1706:    double rho[nvrt];     // Density
 1707:    double dfv[nvrt];     // Vertical viscosity
 1708:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1709: 
 1710:    Turbulence<turbulenceModel> turb;
 1711: 
 1712:    double eta1; // Elevation at nodes at previous timestep
 1713:    double eta2; // Elevation at nodes at current timestep
 1714: 
 1715:    double ETP;  // Earth Tidal Potential
 1716: 
 1717:    double pr;    // Air pressure
 1718:    double grav2; // Gravity 
 1719:    
 1720:    Vector2 dav;  // Depth averaged velocity
 1721: 
 1722:    Vector2 tau; // Wind stress vector
 1723: 
 1724:    // Vegetation parameters
 1725:    double veg_h;
 1726:    double veg_nv;
 1727:    double veg_di;
 1728:    double veg_Cd;
 1729:    double veg_h_unbent;
 1730:    double veg_di_unbent;
 1731:    double veg_nv_unbent;
 1732:    double veg_alpha_vert_mean;
 1733:    double veg_alpha0;
 1734:    double veg_alpha3D[nvrt];
 1735: 
 1736:    // Bottom drag parameters
 1737:    double Cd;       // Bottom drag coefficient   
 1738: 
 1739:    // These three are mutually exclusive
 1740:    union {
 1741:       double rmanning; // Bottom Manning's coefficient
 1742:       double rough;    // Bottom roughness length
 1743:       double drag;     // Bottom drag coefficient
 1744:    };
 1745:    Vector2 tau_bot; // Bottom stress vector
 1746: 
 1747:    // XXXX REMOVE FOR IMM>0???
 1748:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1749:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1750: 
 1751:    
 1752:    double qel; // RHS
 1753:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1754:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1755:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1756:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1757: 
 1758:    double mX; // Solution of the FEM system
 1759: 
 1760:    // Meteorological forcing
 1761:    Vector2 u_air;
 1762:    double p_air;  // XXXX is this the same as pr?
 1763:    double t_air;
 1764:    double q_air;
 1765:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1766: 
 1767: 
 1768: 
 1769:    __device__ __forceinline__ int localIndex() const;
 1770:    __device__ __forceinline__ int packedIndex() const;
 1771: 
 1772: 
 1773:    __device__ void setWind(Vector2 &u) {
 1774:    // Sets the wind vector taking into account the mesh angle
 1775:    
 1776:       const double speed = length(u);
 1777: 
 1778:       // Rotate wind vector to the node frame
 1779:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1780: 
 1781:       // Sets the surface stress vector due to wind.
 1782:       if constexpr(nws == 0) {
 1783:          tau = {0.0, 0.0};
 1784: 
 1785:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1786:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1787: 
 1788:       } else {
 1789: 
 1790:          double dragcoef;
 1791: 
 1792:          if constexpr(iwind_form == -1) {
 1793:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1794:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1795: 
 1796:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1797:             tau = cff*u_air;
 1798:  
 1799:          } else if constexpr(iwind_form == 1) {
 1800:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1801:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1802: 
 1803:             dragcoef = max(dragcoef, 4.0e-4);
 1804:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1805:             tau = cff*u_air;
 1806: 
 1807:          } else {
 1808:             tau = {0.0, 0.0};
 1809:          }
 1810:       }
 1811:    }
 1812: 
 1813: 
 1814:    __device__ void setFrame(double lat, double lon) {
 1815:       if constexpr(ics == 1) return;
 1816: 
 1817:       frame.update(lat, lon);        
 1818:     }
 1819: 
 1820:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1821: 
 1822:    __device__ double sigmaTransitionDepth(void) const;
 1823: 
 1824:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1825: 
 1826:    __inline__ __device__ Point2 outputCoords(void) const {
 1827:       if constexpr(ics == 1)  return p;
 1828:       else                    return {rad2deg*lon, rad2deg*lat};
 1829:    }
 1830: 
 1831:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1832:    // If ics == 2, convert the global point to the local frame
 1833:       
 1834:       if constexpr (ics == 1) {
 1835:          return p;
 1836:       } else {
 1837:          const Point3 c = {p.x, p.y, gz};
 1838:          const Point3 local = frame.G2L(p - c);
 1839:          return local;
 1840:       }
 1841:    }
 1842: 
 1843:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1844:    // If ics == 2, convert the global point to the local frame
 1845:       
 1846:       if constexpr (ics == 1) {
 1847:          return p;
 1848:       } else {
 1849:          const Point3 c = {p.x, p.y, gz};
 1850:          return c + frame.L2G(p);
 1851:       }
 1852:    }
 1853: 
 1854:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1855:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1856:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1857:    
 1858:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1859: 
 1860:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1861:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1862:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1863: 
 1864:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1865:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1866: 
 1867:    __device__ __forceinline__ void clearMatrixRow(void) {
 1868:       // Clear the matrix row for this node
 1869: 
 1870:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1871: 
 1872:    }
 1873: 
 1874:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1875:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1876:       
 1877:       if (node == this) {
 1878:          *coeffDiag += value;
 1879:          return;
 1880:       }
 1881: 
 1882:       int i;
 1883:       for (i = 0; i < numNodes; i++) {
 1884:          if (nodes[i] == node) break;
 1885:       }
 1886: 
 1887:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1888:       coeffRow[csrSlot[i]] += value;
 1889:    }
 1890: 
 1891: 
 1892:    __device__ __inline__ void updateZCoordData(void);
 1893: 
 1894:    __device__ __forceinline__ double compZCoord(int k) const;
 1895: 
 1896:    __device__ void updateKb(void);
 1897: 
 1898:    __device__ __forceinline__ void computeBottomDragCd(void);
 1899: 
 1900: 
 1901: 
 1902: };
