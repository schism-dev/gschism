 4605:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4606: 
 4607:       NODE_BND(nodeBnd);
 4608: 
 4609:       Node *node = nodeBnd->node;
 4610: 
 4611:       node->ETP = 0.0;
 4612: 
 4613:       for (int j=0; j<ntip; j++) {
 4614: 
 4615:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4616:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4617:    
 4618:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4619: 
 4620:          if constexpr(iloadtide==1) { // loading tide
 4621:             assert(false && "Loading tide not implemented");
 4622:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4623:          }
 4624:          
 4625:       }
 4626:       
 4627:    }
