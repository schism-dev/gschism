  328: __device__ __forceinline__ double clamp(double x, double minval, double maxval) {
  329:    assert(minval <= maxval && "clamp: minval > maxval");
  330:    return fmin(fmax(x, minval), maxval);
  331: }
  332: 
  333: __device__ __forceinline__ int clamp(int x, int minval, int maxval) {
  334:    assert(minval <= maxval && "clamp: minval > maxval");
  335:    return max(minval, min(x, maxval));
  336: }
