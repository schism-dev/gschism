 5325:    __global__ void resetBoundaryAreas(void) {
 5326:       // Reset boundary areas and lengths for each segment.
 5327: 
 5328:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5329:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5330:       SIDE_BND(sideBnd);
 5331: 
 5332:       BoundarySegment *segment = sideBnd->segment;
 5333: 
 5334:       segment->carea = 0.0;
 5335:       segment->clen = 0.0;
 5336:  
 5337:    }
 5338: 
 5339:    __global__ void computeBoundaryAreas(void) {
 5340:    // Calculation of cross-section areas and lengths for flow b.c.
 5341: 
 5342:       SIDE_BND(sideBnd);
 5343: 
 5344:       const Side *side = sideBnd->side;
 5345:       BoundarySegment *segment = sideBnd->segment;
 5346: 
 5347:       if (segment->ifltype != 0) {
 5348: 
 5349:          const Node *n1 = side->n1;
 5350:          const Node *n2 = side->n2;
 5351: 
 5352:          const double htot = side->htot2();
 5353: 
 5354:          if (!side->isDry) {
 5355:             atomicAdd(&segment->carea, htot*side->len);
 5356:             atomicAdd(&segment->clen, side->len);
 5357:          }
 5358:       }
 5359: 
 5360:    }
 5361: 
 5362: 
 5363:    __global__ void computeFlowBcVelocities(double time) {
 5364: 
 5365:       SIDE_BND(sideBnd);
 5366: 
 5367:       const Side *side = sideBnd->side;
 5368:  
 5369:       const bool isDry = side->isDry;
 5370:       const bool isLand = sideBnd->segment->isLand;
 5371: 
 5372:    
 5373:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5374: 
 5375:       if (isDry || isLand) return;
 5376: 
 5377:       // For wet sides in open boundaries...
 5378:       const Vector2 n = side->n;
 5379:       const BoundarySegment *segment = sideBnd->segment;
 5380: 
 5381:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5382: 
 5383:       const int ifltype = segment->ifltype;
 5384: 
 5385:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5386:       const Vector2 r_nuth0 = r_uth0*n;
 5387: 
 5388: 
 5389:       if (ifltype == 1 || ifltype == 2) {
 5390:       
 5391:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5392: 
 5393:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5394:          
 5395:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5396:          
 5397:       } else if (ifltype == -1) { // Flather 1
 5398: 
 5399:          for (int k = 0; k < nvrt; k++) {
 5400: 
 5401:             // uth is the normal vel.; no ramp up
 5402:             const double uth = sideBnd->nuth(k);
 5403:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5404: 
 5405:             sideBnd->ubc[k] += uth*n;
 5406:          }
 5407: 
 5408:       } else if (ifltype == 3 || ifltype == 5) {
 5409:          // vnth0=0 !normal vel.
 5410: 
 5411:          Vector2 r_u1_bar = {0.0, 0.0};
 5412:          // Computes the contribution to the velocity from all tide frequencies
 5413:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5414: 
 5415:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5416:             const Vector2 umo  = sideBnd->umo(jfr); 
 5417: 
 5418:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5419:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5420:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5421:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5422: 
 5423:          }
 5424: 
 5425: 
 5426:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5427: 
 5428:       } // if (ifltype = 3 || ifltype == 5
 5429: 
 5430: 
 5431: 
 5432:    }
 5433: 
 5434:    __global__ void computeElevationBoundaryConditions(double time) {
 5435:       // Compute elevation essential boundary conditions 
 5436: 
 5437:       NODE_BND(nodeBnd); // Each boundary node.
 5438: 
 5439:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5440: 
 5441:       const Node *node = nodeBnd->node;
 5442:       const BoundarySegment *segment = nodeBnd->segment;
 5443:       const int iettype = segment->iettype;
 5444:       
 5445: 
 5446:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5447:       double eic = 0.0;
 5448:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5449:       else                 eic = 0.0;
 5450: 
 5451:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5452:       const double r_eth = ramp*nodeBnd->eth;
 5453:       double r_eta1_bar = 0.0;
 5454: 
 5455:       // Compute tide elevation
 5456:       if (iettype == 3 || iettype == 5) {   
 5457: 
 5458:          if constexpr(iloadtide==1) { // loading tide
 5459:             assert(false && "Loading tide not implemented");
 5460:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5461:          }
 5462:          
 5463:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5464: 
 5465:             const double efa  = nodeBnd->efa[jfr]; 
 5466:             const double emo  = nodeBnd->emo[jfr]; 
 5467: 
 5468:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5469:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5470:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5471: 
 5472: 
 5473:          } // for jfr
 5474: 
 5475:       } // if iettype
 5476: 
 5477:       switch (iettype) {
 5478:          case 1:
 5479:          case 2:
 5480:          case 4:
 5481:             nodeBnd->elbc = r_eic + r_eth;
 5482:             break;
 5483:          case 3:
 5484:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5485:             break;
 5486:          case 5:
 5487:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5488:             break;
 5489:       } // switch
 5490: 
 5491: 
 5492:       //Add inverse barometric effects
 5493:       if (iettype != 0 && inv_atm_bnd == 1) {
 5494:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5495:       }
 5496: 
 5497:    }
 5498: 
 5499: 
 5500:    __global__ void computeHorizontalViscosity(void) { 
 5501: 
 5502:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5503: 
 5504:       SIDE(side);
 5505: 
 5506:       if (side->isDry) return;
 5507: 
 5508:       for (int k = 0; k < nvrt; k++) {
 5509:          side->nuGradU[k] = {0.0, 0.0};
 5510:       }
 5511: 
 5512:       if constexpr(ihorcon == 1) {
 5513:          for (int k = side->kb; k < nvrt - 1; k++) {
 5514:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5515:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5516:             // By Zhang and Baptista.
 5517: 
 5518:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5519:             // This is a standard discretization of the Laplacian operator.
 5520:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5521:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5522:             // Gamma is hvis_coef0 in the code.
 5523:             // The value of gamma needs to be < 0.5.
 5524: 
 5525:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5526:             // side under consideration in each of the two possible elements that share the side.
 5527:             Vector2 sumU = {0.0, 0.0};
 5528:             for (int l = 0; l < 2; l++) {
 5529:                const Element *elem = side->elems[l];
 5530: 
 5531:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5532: 
 5533:                // Find the local index of the side in the element
 5534:                const int idxSide = elem->sideLocalIdx(side);
 5535: 
 5536:                // Find the two sides that are connected to the side under consideration
 5537:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5538:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5539: 
 5540:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5541: 
 5542:             }
 5543: 
 5544:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5545: 
 5546:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5547:    
 5548:          }
 5549:       }
 5550:       else if constexpr(ihorcon == 2) {
 5551:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5552:       }
 5553: 
 5554: 
 5555:    }
 5556: 
 5557: 
 5558:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5559: 
 5560:       // Set essential boundary conditions 
 5561:       NODE(node); // Each boundary node
 5562:       NodeBoundary *nodeBnd = node->nodeBnd;
 5563:       
 5564:  
 5565:       // Check if this node has essential BC
 5566:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5567:          // Verify BC value is valid
 5568:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5569: 
 5570:        
 5571:          // Set diagonal to 1 and zero off-diagonals
 5572:          node->coeffDiag = 1.0;
 5573: 
 5574:          for (int j = 0; j < node->numNodes; j++) {
 5575:                node->coeffMatrix[j] = 0.0;
 5576:          }
 5577:          
 5578:          // Set solution and RHS to BC value
 5579:          node->mX  = nodeBnd->elbc;
 5580:          node->qel = nodeBnd->elbc;
 5581: 
 5582:       } else {
 5583:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5584: 
 5585:          for (int j = 0; j < node->numNodes; j++) {
 5586:                Node* nbNode = node->nodes[j];
 5587:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5588:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5589:                   // Verify neighbor's BC value
 5590:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5591: 
 5592:                   // Subtract contribution to RHS
 5593:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5594:                   node->coeffMatrix[j] = 0.0;  
 5595:                }
 5596:          }
 5597:       }
 5598:    }
 5599: 
 5600: 
 5601:    __global__ void updateElevation(void) {
 5602:       NODE(node);
 5603: 
 5604: 
 5605:       node->eta2 = node->mX;
 5606: 
 5607:       node->updateZCoordData();
 5608:    }
