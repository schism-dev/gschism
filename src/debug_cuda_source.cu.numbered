 2418: 
 2419: __device__ void Node::updateKb(void) {
 2420: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2421: 
 2422:    if constexpr(ivcor == 1) return;
 2423: 
 2424: 
 2425:    // Check if node is wet
 2426:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2427: 
 2428:    if (isDry) return;
 2429: 
 2430:    if constexpr(ivcor == 2) {  // SZ coordinates
 2431:       
 2432:       // Compute bottom level index
 2433:       if (depth <= mesh->h_s) {
 2434:          kb = mesh->kz - 1;
 2435:       } else {
 2436:          kb = -1;
 2437:          int L = 0;
 2438:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2439:          
 2440:          while (L <= R) {
 2441:             int M = (R + L) / 2;
 2442: 
 2443:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2444:             
 2445:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2446:                R = M;
 2447:             } else {
 2448:                L = M;
 2449:             }
 2450: 
 2451:             if (R - L == 1) {
 2452:                kb = L;
 2453:                break;
 2454:             }
 2455:          }
 2456:       }
 2457:    } 
 2458: }
 2459: 
 2460: 
 2461: __device__ double Node::compZCoord(int k) const {
 2462:    // Computes the z coordinate at level k.
 2463:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2464:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2465:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2466:    // used 
 2467:    
 2468:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2469:       
 2470:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2471: 
 2472:    if constexpr(ivcor == 2) {
 2473: 
 2474:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2475:       const int kz = mesh->kz;
 2476:       const double h_c = mesh->h_c;
 2477:       const double theta_f = mesh->theta_f;
 2478:       const double sinh_theta_f = mesh->sinh_theta_f;
 2479: 
 2480:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2481:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2482:       // once per time step/node.
 2483:       // CHECK: updateZCoordData
 2484: 
 2485:       if      (k == nvrt-1)      { return eta2; }
 2486:       else if (k == kz)          return -hmod2;
 2487:       else if (k == kb)          return -depth;
 2488:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2489:       else if (k > kz) {
 2490:          const int ksig = k - kz + 1;
 2491: 
 2492:          if (hmod2 <= h_c) {
 2493:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2494:          } 
 2495:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2496:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2497:             assert(false && "ZCOOR: invalid h_c\n");
 2498:          } 
 2499:          else {
 2500:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2501:                          h_c * mesh->sigma[ksig] + 
 2502:                          (hmod2 - h_c) * mesh->cs[ksig];
 2503:          }
 2504:       } else { 
 2505:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2506:       }
 2507: 
 2508:    }
 2509:    else if constexpr(ivcor == 1) {
 2510:       if (k == kb) return -depth;
 2511:       else if (k == nvrt-1) return eta2;
 2512:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2513:    }
 2514:    
 2515:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2516:    return 0.0;
 2517: }
 2518: 
 2519: 
 2520: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2521:                 double *node_coords, double *wind_rotate_angle, 
 2522:                 int *isdel, int *isidenode, int *isbnd,
 2523:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2524:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2525:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2526:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2527:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2528:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2529:                 double *emo, double *efa, 
 2530:                 double *umo, double *ufa, 
 2531:                 double *vmo, double *vfa) {
 2532: 
 2533:    printf("Populating mesh for partition %d\n", partNum);
 2534: 
 2535:    // Horizontal grid
 2536:    printf("Processing %d nodes\n", np);    
 2537: 
 2538: 
 2539:    int idxNodeBoundary = 0;  
 2540:    for (int i = 0; i < np; i++)
 2541:    {
 2542:       Node &node = localNodeData[i];
 2543: 
 2544:       node.idx = i;
 2545: 
 2546:       const int idxNodeStart = nodeNeighNodesStart[i];
 2547:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2548:       node.numNodes = idxNodeEnd - idxNodeStart;
 2549:       node.nodes = nodeNeighNodes + idxNodeStart;
 2550:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2551: 
 2552: 
 2553: 
 2554:       const int idxElemStart = nodeNeighElemsStart[i];
 2555:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2556:       node.numElements = idxElemEnd - idxElemStart;
 2557:       node.elements = nodeNeighElems + idxElemStart;
 2558: 
 2559: 
 2560:       
 2561:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2562:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2563:          const int partNode = localNodePart[idxNodeGlobal]; 
 2564:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2565: 
 2566: 
 2567:          Node *node_ptr = nodes[partNode] + idxNode;
 2568:          
 2569:          nodeNeighNodes[idx] = node_ptr;
 2570:       }
 2571: 
 2572:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2573:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2574:          const int partElem = localElemPart[idxElemGlobal];
 2575:          const int idxElem  = localElemIndices[idxElemGlobal];
 2576: 
 2577:          Element *elem_ptr = elems[partElem] + idxElem;
 2578: 
 2579:          nodeNeighElems[idx] = elem_ptr;
 2580:       }      
 2581: 
 2582: 
 2583:       node.wind_angle = wind_rotate_angle[i];
 2584: 
 2585:       // Element **elements; // pointer to the elements connected to this node
 2586:       // int numElements;   // number of elements shared by this node
 2587: 
 2588:       node.p.x   = node_coords[i * 3];
 2589:       node.p.y   = node_coords[i * 3 + 1];
 2590:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2591:       node.depth = node_coords[i * 3 + 2];
 2592: 
 2593:       node.numSides = 0;
 2594: 
 2595:       // Links the node to the boundary information
 2596:       if (isbnd[i] >= 0) {
 2597:        
 2598:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2599:          node.nodeBnd->node = &node;
 2600: 
 2601: 
 2602:          if (isbnd[i]>0) {
 2603: 
 2604:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2605:             node.nodeBnd->segment->ifltype = isbnd[i];
 2606: 
 2607:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2608:             node.nodeBnd->segment->clen  = nan("1");
 2609:             node.nodeBnd->segment->carea = nan("1");
 2610: 
 2611:          }
 2612:          else {
 2613:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2614:          }
 2615:          
 2616:          idxNodeBoundary++;
 2617:       }
 2618:       else {
 2619:          node.nodeBnd = nullptr;
 2620:       }
 2621: 
 2622:       // XXXX GAUSSIAN HILL VELOCITIES
 2623: #ifdef GAUSSIAN_HILL_VELOCITIES
 2624:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2625:          constexpr double rot_per = 3000.0;
 2626:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2627:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2628:       // XXXXX
 2629: #endif
 2630:    }
 2631: 
 2632:    nbp = idxNodeBoundary;
 2633: 
 2634:    printf("Processing %d sides\n", ns);
 2635:    int idxSideBoundary = 0;
 2636:    for (int i = 0; i < ns; i++)
 2637:    {
 2638:       Side &side = localSideData[i];
 2639:       side.idx = i;
 2640:       // finding the pointer to the nodes that form the side
 2641:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2642:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2643: 
 2644:       const int locidx_n1 = localNodeIndices[idx_n1];
 2645:       const int locidx_n2 = localNodeIndices[idx_n2];
 2646:       const int part_n1 =   localNodePart[idx_n1];
 2647:       const int part_n2 =   localNodePart[idx_n2];
 2648: 
 2649:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2650:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2651: 
 2652:       // Counts the number of sides connected to each node
 2653:       side.n1->numSides++;
 2654:       side.n2->numSides++;
 2655: 
 2656:       // Normal, unitary vector to the side
 2657:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2658:       side.n = normalize(side.n);
 2659: 
 2660:       // Side boundary type
 2661:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2662:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2663:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2664:       
 2665:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2666:       {
 2667:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2668:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2669:          else                  side.sideBnd->segment = n2bnd->segment;
 2670:          side.sideBnd->side = &side;
 2671:          idxSideBoundary++;
 2672:       }
 2673:       else side.sideBnd = nullptr;
 2674: 
 2675:       nbs = idxSideBoundary;
 2676: 
 2677:       // finding the pointer to the elements that share the side
 2678:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2679:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2680: 
 2681:       if (idx_e1 > -1) {
 2682:          const int locidx_e1 = localElemIndices[idx_e1];
 2683:          const int part_e1 =  localElemPart[idx_e1];
 2684:          side.elems[0] = elems[part_e1] + locidx_e1;
 2685: 
 2686:       }
 2687:       else {
 2688:          side.elems[0] = nullptr;
 2689:       }
 2690: 
 2691:       if (idx_e2 > -1) {
 2692:          const int locidx_e2 = localElemIndices[idx_e2];
 2693:          const int part_e2 =  localElemPart[idx_e2];
 2694:          side.elems[1] = elems[part_e2] + locidx_e2;
 2695:       }
 2696:       else {
 2697:          side.elems[1] = nullptr;
 2698:       }
 2699: 
 2700: 
 2701: 
 2702:       // Compute the center of the side
 2703:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2704: 
 2705: #ifdef GAUSSIAN_HILL_VELOCITIES
 2706: // XXXX
 2707: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2708: constexpr double rot_per=3000.0;
 2709: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2710: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2711: // XXXXX      
 2712: #endif
 2713:       // Compute the z level at the center of the side
 2714:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2715: 
 2716:       // Compute the length of the side
 2717:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2718:       side.len = sqrt(dot(vLen, vLen));
 2719: 
 2720:    }
 2721: 
 2722:    printf("Processing %d elements\n", ne);
 2723:    for (int i = 0; i < ne; i++)
 2724:    {
 2725:       Element &elem = localElemData[i];
 2726:       elem.idx = i;
 2727:       for (int j = 0; j < i34[i]; j++) {
 2728:          const int idxNode = elnode[i*4 + j];  
 2729:          const int idxSide = elside[i*4 + j];
 2730:          
 2731:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2732:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2733: 
 2734: 
 2735: 
 2736:          // Find the neighboring element  
 2737:          if (elem.sides[j]->elems[0] == &elem) {
 2738:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2739:          }
 2740:          else {
 2741:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2742:          }
 2743:          
 2744:       }
 2745: 
 2746:       elem.i34 = i34[i];
 2747: 
 2748: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2749: 
 2750:       // Compute the centroid of the element and its depth
 2751:       Vector2 center = {0.0, 0.0};
 2752:       elem.depth = 0.0;
 2753:       for (int j = 0; j < i34[i]; j++) {
 2754:          center += elem.nodes[j]->p2()/i34[i];
 2755:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2756:       }
 2757:       elem.center.x = center.x;
 2758:       elem.center.y = center.y;
 2759: 
 2760:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2761:       
 2762:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2763:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2764: 
 2765:       elem.area = elem.computeSignedArea(); 
 2766:       elem.radius = sqrt(elem.area)/pi; 
 2767:       
 2768:       // Determines which way the normal vector to each side is oriented.
 2769:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2770:       for (int j = 0; j < i34[i]; j++)  
 2771:       {
 2772:          if (elem.sides[j]->elems[0] == &elem) {
 2773:             elem.ssign[j] =  1.0;
 2774:          }
 2775:          else {
 2776:             elem.ssign[j] = -1.0;
 2777:          }
 2778: 
 2779:       }
 2780: 
 2781:       // Derivatives of shape functions
 2782:       //  For ics=2, this is done inside element/ll frame XXX
 2783:       //  For quads, the derivative is evaluated at centroid
 2784:       const int i34 = elem.i34;
 2785:       for (int j = 0; j < i34; j++) {
 2786:          const double area = elem.area;
 2787:          const int id2 = elem.nxq(1 + j);
 2788:          const int id3 = elem.nxq(2 + j);
 2789:          const int id4 = elem.nxq(3 + j);
 2790:          if (elem.isTri()) {
 2791:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2792:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2793:             // da1/dx = (y1 - y2)/(2*area)
 2794:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2795:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2796:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2797:          }
 2798:          else  { // Quad; evaluate at centroid
 2799:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2800:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2801:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2802:          } // if Tri
 2803: 
 2804:       } // for j
 2805: 
 2806:    }
 2807: 
 2808: 
 2809:    // Processing the boundary nodes
 2810:    int idx = 0;
 2811:    for (int iseg = 0; iseg < nope; iseg++) {
 2812:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2813: 
 2814:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2815: 
 2816:          nodeBnd->isEssentialBC = true;
 2817: nodeBnd->iettype = 3;
 2818:          nodeBnd->elbc = 0.0;
 2819: 
 2820:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2821:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2822:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2823:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2824:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2825:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2826:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2827: 
 2828:          }
 2829: 
 2830:          idx++;
 2831:       }
 2832: 
 2833:    }
 2834: 
 2835: }
 2836: 
 2837: 
 2838: 
 2839: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2840:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2841:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2842:    // 
 2843:    // This kernel is called for all nodes.
 2844: 
 2845: 
 2846:    NODE(node1);
 2847: 
 2848: 
 2849:    node1->clearMatrixRow();
 2850:    node1->qel = 0.0;
 2851: 
 2852:    // THIS IS FOR STRUCTURES XXX
 2853:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 2854: 
 2855:    
 2856:    for (int j=0; j<node1->numElements; j++) {
 2857:       // For each element connected to the node...
 2858: 
 2859:       Element *elem = node1->elements[j];
 2860: 
 2861:       // Compute the average gravity
 2862:       const double grav3 = elem->mean(&Node::grav2);
 2863: 
 2864:       // Look at the documentation for the description of the terms in the following integrals
 2865: 
 2866:       // Integral I_1 
 2867:       // \bar{\breve{H}} 
 2868:       const double hhatb = elem->mean(&Side::hhat);        
 2869: 
 2870: 
 2871:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 2872: 
 2873:       const int id1 = elem->nodeLocalIdx(node1); 
 2874:       const double area = elem->area;
 2875: 
 2876:       if (elem->isTri()) {
 2877: 
 2878:          // To clarify the notation in this section: 
 2879:          //   i stands for the node under consideration (node1)
 2880:          //   j (node2) and k (node3) are the other nodes of the triangle.
 2881:          const int id2 = elem->nxq(1 + id1);
 2882:          const int id3 = elem->nxq(2 + id1);
 2883:          Node *node2 = elem->nodes[id2];
 2884:          Node *node3 = elem->nodes[id3];
 2885: 
 2886:          const Point2 x1 = node1->p2();
 2887:          const Point2 x2 = node2->p2();
 2888:          const Point2 x3 = node3->p2();
 2889: 
 2890:          // integral of phi_i*phi_j
 2891:          const double ipp_ii = (1.0/6.0 )*area;
 2892:          const double ipp_ij = (1.0/12.0)*area;
 2893:          const double ipp_ik = (1.0/12.0)*area;
 2894: 
 2895:          // integral of [(grad phi_i) * (grad phi_j)]
 2896:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 2897:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 2898:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 2899: 
 2900:          // Computes the different components of integral I_1 of each node with respect to node i.
 2901:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 2902:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 2903:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 2904: 
 2905: if (j==node1->numElements-1) {
 2906: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 2907: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 2908: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2909: }
 2910: 
 2911:          node1->addToSparseMatrix(node1, I1_ii);
 2912:          node1->addToSparseMatrix(node2, I1_ij); 
 2913:          node1->addToSparseMatrix(node3, I1_ik);
 2914: 
 2915: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 2916:      
 2917:       }
 2918:       else { // Quad
 2919:          // XXX IMPLEMENT THIS
 2920:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2921:       } 
 2922: 
 2923:  
 2924:       // Integral I_4
 2925:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 2926:       // Where
 2927:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 2928: 
 2929:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 2930:       // of U over the element.
 2931:       Vector2 Umean = {0.0, 0.0};
 2932:       for (int m=0; m<elem->i34; m++) {      
 2933:          const Side *side = elem->sides[m];
 2934: 
 2935:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 2936:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 2937:       }
 2938:       Umean = Umean/elem->i34;
 2939: 
 2940:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 2941: 
 2942:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 2943:       const double I_4_1 = dot(gradPhi_1, Umean);
 2944: 
 2945:       // Integral of \nabla\phi_i \cdot \pmb{E}
 2946:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 2947:      
 2948:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 2949: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 2950: 
 2951:       // Additional terms 
 2952:       double vnorm = 0.0;
 2953:       if (imm == 2)  { // Pre-compute vnorm on the element
 2954:          Vector3 ubed;
 2955:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 2956: 
 2957:          Vector3 gradP = {0.0, 0.0, 1.0};
 2958:          for (int m=0; m < elem->i34; m++) {
 2959:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 2960:            gradP += toVector3(gradP_2D, 0.0);
 2961:          }   
 2962:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 2963:       } // imm==2
 2964: 
 2965:       if (elem->isTri()) {
 2966:          for (int l=0; l<3; l++) {
 2967:            double fac;
 2968: 
 2969:            Node *node = elem->nodes[l];
 2970: 
 2971:            (node == node1)? fac=2.0 : fac=1.0;
 2972: 
 2973:            if (imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 2974:            else        node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 2975:            
 2976:          }
 2977: 
 2978: 
 2979:          if (!elem->isDry) {
 2980:            const Vector2 gradEta = elem->nodes[0]->eta2*elem->gradPhi[0] +
 2981:                                    elem->nodes[1]->eta2*elem->gradPhi[1] +
 2982:                                    elem->nodes[2]->eta2*elem->gradPhi[2];
 2983: 
 2984:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 2985:          }
 2986: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 2987: 
 2988:       } // isTri
 2989:       else { // isQuad
 2990:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 2991:          // for (int l=0; l<4; l++) {
 2992:          //   const Node *node = elem->nodes[l];
 2993: 
 2994:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 2995:          //   else        tmp2 = node->bdef2 - node->bdef1;
 2996: 
 2997:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 2998:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 2999:          // }
 3000: 
 3001:       } // isQuad
 3002: 
 3003: 
 3004:       node1->qel += (dt/elem->i34)*elem->vsource;
 3005:       
 3006: 
 3007:    } // for all elements connected to the node
 3008:    
 3009: 
 3010: 
 3011:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3012:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3013:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3014:    if (nodeBnd != nullptr)  { 
 3015:       // If it is an open boundary node...
 3016: 
 3017:       // At least one open bnd side, maybe two
 3018:       for (int l=0; l<2; l++) { 
 3019: 
 3020:          // Gets each of the sides sharing the node. 
 3021:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3022: 
 3023:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3024: 
 3025:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3026: 
 3027: 
 3028:          if (sideBnd != nullptr) {
 3029:             // If the side is on a boundary...
 3030: 
 3031:             // Get the boundary segment
 3032:             const BoundarySegment *sideSegment = sideBnd->segment;
 3033:             const Side *side = sideBnd->side;
 3034: 
 3035:             // Integral I_3
 3036:             if (sideSegment->ifltype != 0) {
 3037:             // Natural or Flather b.c.
 3038: 
 3039:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3040:                // especially for Flather b.c.
 3041:                double ri3 = 0.0;
 3042:                if (!side->isDry) {
 3043:                   // If the side is not dry
 3044:                   
 3045:                   // Computes the side flux of (uth, vth)
 3046:                   double Vn = 0.0;
 3047:                   for (int k = side->kb; k<nvrt-1; k++) {
 3048:                      // uth, vth in lat/lon frame if ics=2
 3049:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3050:                      const double vn1 = dot(side->uth[k  ], side->n); // outer normal
 3051:                      const double vn2 = dot(side->uth[k+1], side->n);
 3052: 
 3053:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3054:                   }
 3055: 
 3056:                   ri3 = 0.5*side->len*Vn;
 3057:                }
 3058: 
 3059:                if (sideSegment->ifltype == -1) { // Flather 1
 3060: 
 3061:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3062:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3063: 
 3064:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3065:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3066:                   
 3067:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3068:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3069: 
 3070:                } 
 3071:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3072:                   // Reset ri3
 3073:                   ri3 = 0.0;
 3074: 
 3075:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3076: 
 3077:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3078: 
 3079:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3080:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3081: 
 3082:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3083:                   node1->addToSparseMatrix(node1, con0*2.0);
 3084:                   node1->addToSparseMatrix(node2, con0);
 3085: 
 3086:                } // if Flather or Discharge
 3087: 
 3088:                node1->qel -= thetai*dt*ri3;
 3089: 
 3090:             } // I_3
 3091:           
 3092: 
 3093:             // Integral I_5
 3094:             if(!side->isDry) {
 3095: 
 3096:                const double Unbar = dot(side->U, side->n);
 3097: 
 3098:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3099:                
 3100:             } // I_5
 3101: 
 3102:          } // if is boundary side
 3103: 
 3104:       } // for l
 3105: 
 3106:    } // if isbnd
 3107: 
 3108: 
 3109:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3110: 
 3111: }
 3112: 
 3113: 
 3114: 
 3115: extern "C" {
 3116:    __global__ void rollUpElevation(void) {
 3117: 
 3118:       NODE(node);
 3119: 
 3120:       node->eta2 += node->eta1;
 3121: 
 3122:    }
 3123: 
 3124: 
 3125:    __global__ void backtrackAllNodes(void) {
 3126: 
 3127:       // max/min # of sub-divisions
 3128:       const int ndelt_max = max(1.0, dt/dtb_min);
 3129:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3130: 
 3131:       // Removed all references to swild98 XXX
 3132:       // swild98=0.d0 !init
 3133: 
 3134: 
 3135:       SIDE(side);
 3136: 
 3137:       const int kb = side->kb;
 3138: 
 3139:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 3140: 
 3141:       // Initialize btrack velocities to the actual velocities at the side 
 3142:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3143: 
 3144: 
 3145:       if (side->isDry) return;
 3146: 
 3147: 
 3148:       // Checks that at least one element is not dry
 3149:       const Element *elem1 = side->elems[0];
 3150:       const Element *elem2 = side->elems[1];
 3151: 
 3152: 
 3153:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3154:       
 3155:       // XXXXXX
 3156:       // !swild_tmp to store global coord. of the starting side
 3157:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3158:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3159:       // !Use sframe2 
 3160:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3161: 
 3162: 
 3163:       for (int k = kb; k < nvrt; k++) {
 3164:       //  Initialize (xt,yt,zt), nnel and vel.
 3165:       //  For ics=2, the coordinates are in local frames
 3166:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3167: 
 3168: 
 3169:          const int iadvf = side->iadv();  // Advection flag
 3170: 
 3171:          Point3 xt;
 3172:          if constexpr(ics==1) {
 3173:             xt = side->center3D(k); 
 3174:          }
 3175:          else // lat/lon; in side lat/lon frame
 3176:          {
 3177:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3178:          // XXX IMPLEMENT THIS
 3179:       //          xt=0.d0
 3180:       //          yt=0.d0
 3181:       //          !centroid coord. for nudging
 3182:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3183:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3184:          }  // ics
 3185: 
 3186: 
 3187:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3188:          // XXX IS THIS NECESSARY?
 3189:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3190: 
 3191:          // If on land or open boundary...
 3192:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3193:          
 3194:          const double vmag = length(toVector2(u_int));
 3195: 
 3196:          if (vmag <= velmin_btrack) {
 3197:             // No activity 
 3198: 
 3199:             side->btu[k] = side->u2[k];
 3200:             
 3201:          } else {  // do btrack
 3202: 
 3203:             // Compute number of sub-divisions based on local gradients 
 3204:             // XXX IS THIS NECESSARY?
 3205:             double suma = 0.0;
 3206:             int icount = 0;
 3207:             for (int ii=0; ii<2; ii++) {
 3208: 
 3209:                const Element *elem = side->elems[ii];
 3210:                  
 3211:                if (elem == nullptr) continue;
 3212: 
 3213:                icount++;
 3214: 
 3215:                // Not strictly along z; in ll frame for ics=2
 3216: 
 3217:                double utmp[4];
 3218:                double vtmp[4];
 3219:                for (int jj = 0; jj < elem->i34; jj++) {
 3220: 
 3221:                   const Node *node = elem->nodes[jj];
 3222: 
 3223:                   if constexpr(ics==1) {
 3224:                      utmp[jj] = node->u2[k].x;
 3225:                      vtmp[jj] = node->u2[k].y;  
 3226:                   } else {
 3227:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3228:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3229:                   }
 3230:                } // for jj
 3231: 
 3232:                const Vector2 grad_u = elem->grad2(utmp); 
 3233:                const Vector2 grad_v = elem->grad2(vtmp);
 3234: 
 3235:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3236:             } // for ii
 3237: 
 3238:             assert(icount > 0 && "Impossible 77");
 3239: 
 3240:             // '4' is somewhat arbitrary
 3241:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3242: 
 3243:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3244:          
 3245: 
 3246:             Vector3 u_int = {0.0, 0.0, 0.0};
 3247: 
 3248:             side->btrack(k, dt, dtbk, u_int);
 3249:                
 3250:          } // if vmag (do backtrack)
 3251: 
 3252:       } // for j=jmin,nvrt-1
 3253: 
 3254:    }
 3255: } // extern "C"
 3256: 
 3257: template<int nc>
 3258: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3259: 
 3260: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3261: //
 3262: // a,b,c,rhs: input vectors and are not modified by this program.
 3263: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3264: // rhs is the r.h.s.
 3265: // n: actual rank of the system.
 3266: // rows in u() and rhs();
 3267: // u: output with nc columns (transposed to rows)
 3268: // gam: a working array.
 3269: //
 3270: // NOTES:
 3271: // This is a template function that allows for different numbers of columns in the rhs vector.
 3272: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3273: 
 3274:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3275:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3276: 
 3277:    double bet = b[0];
 3278:    if constexpr (nc == 1) {
 3279:       u[0] = rhs[0]/bet;
 3280:    } else {
 3281:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3282:    }
 3283: 
 3284:    for (int j = 1; j < n; j++) {
 3285:       gam[j] = c[j-1]/bet;
 3286:       bet = b[j] - a[j]*gam[j];
 3287: 
 3288:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3289: 
 3290:       if constexpr (nc == 1) {
 3291:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3292:       } else {
 3293:          for (int k = 0; k < nc; k++) {
 3294:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3295:          }
 3296:       }
 3297:    }
 3298: 
 3299:    // Back-substitution
 3300:    for (int j=n-1; j>=1; j--) {
 3301:       if constexpr (nc == 1) {
 3302:          u[j] = u[j] - gam[j+1]*u[j-1];
 3303:       } else {
 3304:          for (int k = 0; k < nc; k++) {
 3305:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3306:          }
 3307:       }
 3308:    }
 3309: }
 3310: 
 3311: 
 3312: 
 3313: // Helper function that contains the core algorithm
 3314: template<typename XAccessor, typename YAccessor>
 3315: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3316:                                     double  yp_top, double  yp_bot, 
 3317:                                     CubicSpline &spline) {
 3318:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3319:    // 
 3320:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3321:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3322:    //
 3323:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3324:    // 
 3325:    // Inputs: 
 3326:    //            n: dimension for x etc; # of data pts (>=2);
 3327:    //            getX, getY: functions to access x,y coordinates
 3328:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3329:    //     Output: 
 3330:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3331: 
 3332:    const int n = k2 - k1 + 1;
 3333:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3334: 
 3335:    // Allocate memory for the splines
 3336:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3337:    spline.x   = new double[n];
 3338:    spline.y   = new double[n];
 3339:    spline.yp  = new double[n];
 3340:    spline.ypp = new double[n];
 3341: 
 3342:    for (int k=k1; k<=k2; k++) {
 3343:       spline.x[k] = getX(k);
 3344:       spline.y[k] = getY(k);
 3345:    }
 3346: 
 3347:    // This is to simplify expressions later
 3348:    double *x = spline.x;
 3349:    double *y = spline.y;
 3350: 
 3351:    double *a = nullptr;
 3352:    double *b = nullptr;
 3353:    double *c = nullptr;
 3354:    double *gam = nullptr;
 3355:    double *rhs = nullptr;
 3356:    
 3357: 
 3358:       a = new double[n];   // Lower diagonal
 3359:       b = new double[n];   // Diagonal
 3360:       c = new double[n];   // Upper diagonal
 3361:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3362:       rhs = new double[n]; // Right-hand side
 3363: 
 3364:    for (int k=k1; k<=k2; k++) {
 3365:       if (k == k1) {
 3366:          // Bottom level
 3367:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3368:          b[k] = (x[k+1] - x[k])/3.0;
 3369:          c[k] = b[k]/2.0;
 3370:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3371:       } else if (k == n - 1) {
 3372:          // Top level (surface)
 3373:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3374:          b[k] = (x[k] - x[k-1])/3.0;
 3375:          a[k] = b[k]/2.0;
 3376:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3377:       } else {
 3378:          // Intermediate levels
 3379:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3380:          b[k] = (x[k+1] - x[k-1])/3.0;
 3381:          a[k] = (x[k  ] - x[k-1])/6.0;
 3382:          c[k] = (x[k+1] - x[k  ])/6.0;
 3383:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3384:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3385:       }
 3386:    }
 3387: 
 3388:    // Solve the tridiagonal system
 3389:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3390:    
 3391:    spline.yp[k1] = yp_bot;
 3392:    spline.yp[k2] = yp_top;
 3393: 
 3394:    // Compute rest of 1st derivatives using the splines
 3395:    for (int k=k1+1; k<k2; k++) {
 3396:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3397:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3398:    }
 3399:    
 3400:    delete[] a;
 3401:    delete[] b;
 3402:    delete[] c;
 3403:    delete[] gam;
 3404:    delete[] rhs;
 3405: 
 3406: }
 3407: 
 3408: // Array version
 3409: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3410:                                 double y_top, double y_bot, 
 3411:                                 CubicSpline &spline) {
 3412:    auto getX = [x] (int k) { return x[k]; };
 3413:    auto getY = [y] (int k) { return y[k]; };
 3414:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3415: }
 3416: 
 3417: // Lambda version - allows custom access patterns
 3418: template<typename XFunc, typename YFunc>
 3419: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3420:                                 double y_top, double y_bot,
 3421:                                 CubicSpline &spline) {
 3422:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3423: }
 3424: 
 3425: 
 3426: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3427: {
 3428:    assert("Not implemented");
 3429: 
 3430:    return 0.0;
 3431: }
