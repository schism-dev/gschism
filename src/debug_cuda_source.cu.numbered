  933:    __device__ __forceinline__ double intPhiPhiTri(int i, int j) const;
  934: 
  935:    __device__ __forceinline__ double intGradPhiGradPhiTri(int i, int j) const;
  936: 
  937:    __device__ __forceinline__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  938: 
  939:    __device__ __forceinline__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  940: 
  941:    __device__ __forceinline__ Vector2 grad2(double *a) const
  942:    {
  943:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  944:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  945:       if (isQuad()) {
  946:          gx += a[3]*gradPhi[3].x;
  947:          gy += a[3]*gradPhi[3].y;
  948:       }
  949:       return {gx, gy};
  950:    }
  951: 
  952:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
  953:    {
  954:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  955:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  956:       if (isQuad()) {
  957:          gx += (nodes[3]->*field)*gradPhi[3].x;
  958:          gy += (nodes[3]->*field)*gradPhi[3].y;
  959:       }
  960:       return {gx, gy};
  961:    }
  962: 
  963:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  964:    __device__ __forceinline__ Vector3 n(int k) const {
  965:       double area3D;
  966:       return n(k, area3D);
  967:     }
