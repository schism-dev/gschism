 3728:    __global__ void solverCopyResult(double* x) {
 3729:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3730:       NODE(node);
 3731:       const int idx = node->idx;
 3732: 
 3733:       node->mX = x[idx];
 3734:    }
