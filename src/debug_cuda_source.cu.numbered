 1812: // Convenience macros for accessing the objects in kernels.
 1813: 
 1814: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1815:                    Side *side = &(mesh->localSideData[idx_side]); \
 1816:                    if (idx_side >= mesh->ns) return;
 1817: 
 1818: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1819:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1820:                    if (idx_elem >= mesh->ne) return;
 1821: 
 1822: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1823:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1824:                    if (idx_node >= mesh->np) return;
 1825: 
 1826: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1827:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1828:                               const bool valid = (idx_node < mesh->np);                   
 1829: 
 1830: 
 1831: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1832:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1833:                            if (idx_node_bnd >= mesh->nbp) return;
 1834: 
 1835: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1836:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1837:                            if (idx_side_bnd >= mesh->nbs) return;                           
