 2002: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2003: // return;   
 2004:    // Lock the mutex
 2005:    lock(&debugPlotMutex);
 2006:  
 2007:    bool ok = true;
 2008:    if (debugPlotIdx == nullptr) ok = false;
 2009:    if (*debugPlotIdx >= 1000000) ok = false;
 2010:    if (ok) {
 2011:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2012:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2013:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2014:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2015:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2016:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2017:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2018:       (*debugPlotIdx)++;
 2019:    }
 2020: 
 2021:    __threadfence();               // ensure all above writes are visible
 2022:    // Unlock the mutex
 2023:    unlock(&debugPlotMutex);
 2024: 
 2025: }
