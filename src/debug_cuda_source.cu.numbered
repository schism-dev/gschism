 2190: 
 2191: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2192: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2193: // Returns the normal vector and the area of the element at this level
 2194: 
 2195:    double nx, ny, nz;
 2196: 
 2197:    if (isTri()) {
 2198:       // For triangles...
 2199: 
 2200:       // Indices of the nodes at level k, taking care of not going below the bed
 2201:       const int k0 = max(k, nodes[0]->kb);
 2202:       const int k1 = max(k, nodes[1]->kb);
 2203:       const int k2 = max(k, nodes[2]->kb);
 2204: 
 2205:       // Gets the element frame coordinates of the nodes at level k
 2206:       Point3 x0, x1, x2;
 2207:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2208:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2209:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2210:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2211: 
 2212:       } else {  // ics == 2
 2213:          Point2 h0, h1, h2;
 2214: 
 2215:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2216: 
 2217:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2218:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2219:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2220:       }
 2221: 
 2222:       const Vector3 n20 = x2 - x0;
 2223:       const Vector3 n10 = x1 - x0; 
 2224: 
 2225:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2226:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2227:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2228:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2229:    
 2230:    }
 2231:    else {
 2232:       // For quads...
 2233:       Point2 h0, h1, h2, h3;
 2234: 
 2235:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2236: 
 2237:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2238:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2239:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2240:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2241: 
 2242:       nx = n20.y*n31.z - n20.z*n31.y;
 2243:       ny = n20.z*n31.x - n20.x*n31.z;
 2244:       nz = n20.x*n31.y - n20.y*n31.x;
 2245: 
 2246:    }
 2247: 
 2248:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2249:    area3D = 0.5*len;
 2250: 
 2251:    const double inv_len = 1.0/len;
 2252: 
 2253:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2254: 
 2255: }
 2256: 
 2257: /**
 2258:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2259:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2260:    If the segment is completely inside the element, then it returns true.
 2261: 
 2262:    This function assumes:
 2263:    - The initial point is on a side of the element. 
 2264:    - Its position is given by parameter t in the range [0,1].
 2265:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2266:       intersects the element (elements are convex).
 2267: 
 2268:    To find the intersection point, this function does the following:
 2269:    - it finds the intersection of the line segment with all the element side lines,
 2270:       except for the one that contains the initial point.
 2271:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2272:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2273:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2274:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2275:       track segment is almost parallel to the element side line.
 2276: 
 2277:    Inputs:
 2278:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2279:    @param x2, y2: other end of the line segment
 2280: 
 2281:    Outputs:
 2282:    @param side:  side that intersects the line segment (input and output)
 2283:    @param nextElement (output): element that contains the intersection point
 2284:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2285:    @param zint (input/output): Vertical coordinate of the intersection point
 2286: 
 2287:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2288:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2289:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2290: 
 2291:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2292:    (Delta) being zero.
 2293: 
 2294:    The intersection2 point happens when:
 2295:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2296:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2297:    
 2298:    Assumption: the 4 points (including those of the side segment) are different.
 2299:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2300:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2301:    If true, (xIntersect,yIntersect) is the intersection.				
 2302:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2303: **/
 2304: 
 2305: 
 2306: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2307:                                               double &t, double& tIntersect, const Side *origSide) {
 2308:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2309: if (!containsPoint(x1, origSide)) printf("111: x1 = (%f, %f), origSide.center = (%f, %f)\n", x1.x, x1.y, origSide->center.x, origSide->center.y); 
 2310:    assert( containsPoint(x1, origSide) && "Starting point is not inside the element");                                    
 2311:    assert(!containsPoint(x2, origSide) && "Ending point is not outside the element");
 2312: 
 2313:    double closest_intersect_t = 1e10;
 2314:    bool found_intersection = false;
 2315: 
 2316:    for (int i = 0; i < i34; i++) {
 2317: 
 2318:       Side *side2 = sides[i];
 2319: 
 2320:       // (x3,y3)-(x4,y4) is the element side line
 2321:       const Point2 x3 = side2->n1->p;
 2322:       const Point2 x4 = side2->n2->p;
 2323: 
 2324:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2325:       const double delta = cross(x2 - x1, x3 - x4);
 2326: 
 2327:       if (abs(delta) > 0) {
 2328: 
 2329:          const double delta1 = cross(x3 - x1, x3 - x4);
 2330:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2331: 
 2332:          // Solves the two linear equations for tt1 and tt2
 2333:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2334:          const double tt2 = delta2/delta;
 2335: 
 2336:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2337:             closest_intersect_t = min(closest_intersect_t, tt1);
 2338:             side = side2;
 2339:             nextElement = side->otherElem(this);
 2340:             t =          clamp(tt2, small, 1.0-small);
 2341:             tIntersect = clamp(tt1, small, 1.0-small);
 2342:             found_intersection = true;
 2343:          }
 2344: 
 2345:       
 2346:       }
 2347:       else {  // parallel segments
 2348: 
 2349:          continue; 
 2350:          assert(false && "Parallel segments should not happen under the new code");
 2351:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2352:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2353: 
 2354:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2355:          const double dist = dot(x1 - x3, side2->n);
 2356:          if (abs(dist) < small*length(x3 - x4)) {
 2357:             const double2 unitarySide = normalize(x4 - x3);
 2358:             const double len = dot(x2 - x1, unitarySide);
 2359:             t = t + len;
 2360:             t = max(0.0, min(t, 1.0));
 2361:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2362: 
 2363: 
 2364:             // tIntersect = max(small, min(tt1, 1.0-small));
 2365:             // t = tt2;
 2366:             found_intersection = true;
 2367:          }
 2368:       }
 2369: 
 2370: 
 2371:    }
 2372: 
 2373: 
 2374: if (!found_intersection) {if (idx == 15876) printf("11111: No intersection found\n"); return false;}
 2375:    assert(found_intersection && "No intersection found");
 2376: 
 2377:    // found_intersection should always be true, since we checked all the sides.  
 2378:    return found_intersection;
 2379: }
 2380: 
 2381: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2382:    // Check if the point (xt,yt) is inside the element.
 2383:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2384:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2385: 
 2386:    double shpCoords[4];
 2387: if (origSide->idx == 15876) printf("containsPoint 1: xt = (%f, %f), elem->idx = %d, origSide->idx = %d\n", xt.x, xt.y, idx, origSide->idx);
 2388:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2389: if (origSide->idx == 15876) printf("containsPoint 11: shpCoords = (%f, %f, %f, %f), origSide->idx = %d\n", shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3], origSide->idx);
 2390:    return res;
 2391: }
 2392: 
 2393: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2394:    // Check if the point (xt,yt) is inside the element.
 2395:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2396:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2397:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa");
 2398: 
 2399:    double shpCoords[4];
 2400: if (origSide->idx == 15876) printf("containsPoint 2: xt = (%f, %f), elem->idx = %d, side = %p\n", xt.x, xt.y, idx, origSide);
 2401:    Vector2 tmp_xt = xt;
 2402:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2403:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2404: 
 2405:    if (fixCoords && res) xt = tmp_xt;
 2406: 
 2407:    return res;
 2408: }
 2409: 
 2410: 
 2411: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2412:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2413: 
 2414:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2415:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2416:    // curElement.
 2417: 
 2418:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2419:    // And uses this velocity instead to continue the tracking.
 2420: 
 2421:    // computes the intersection point in cartesian coordinates
 2422:    Point2 intersection = nextSide->p2_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2423: 
 2424:    // Nudges the point to the barycenter of the element. 
 2425:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2426:    // next segment intersects the element sides. 
 2427:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2428: 
 2429: 
 2430:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2431:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2432:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2433:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2434: 
 2435:    // If the side is an open boundary, the tangential velocity is set to zero.
 2436:    if (nextSide->isBnd()) vtan = 0.0;
 2437: 
 2438:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2439:    const double us = vtan*nextSide->t().x;
 2440:    const double vs = vtan*nextSide->t().y;
 2441:    const double ws = nextSide->w2(jlev); 
 2442: 
 2443:    u_int = {us, vs, ws};
 2444: 
 2445:    // The end of this tracking segment is now the intersection point.
 2446:    xt = {intersection.x, intersection.y, zint};
 2447:    
 2448: }
 2449: 
 2450: /**
 2451:  * Tracks a particle through elements and vertical levels in the mesh.
 2452:  * 
 2453:  * @param x0,y0,z0     Starting position coordinates
 2454:  * @param xt,yt,zt     Target position coordinates
 2455:  * @param dtb          Time step for tracking
 2456:  * @param u_int        Initial velocity components
 2457:  * @param nextElem     Starting/resulting element index
 2458:  * 
 2459:  * @return Status code of type trackExitCodes
 2460:  * 
 2461:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2462:  * of the details are different. The idea is that the code requires less branches and is better fit
 2463:  * for GPU execution.
 2464:  * 
 2465:  * The main ideas here are:
 2466:  * - The starting point is expected to be in the starting element.
 2467:  * - since the starting point is inside the element, there are only two cases: 
 2468:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2469:  *     (b) it does not and (xt,yt) is already in the starting element.
 2470:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2471:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2472:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2473:  * - tt1 can be positive or negative. We only consider the positive values.
 2474:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2475:  * - The next intersection will occur at the smallest positive tt1.
 2476:  * - This intersection will be the next (x0,y0) position.
 2477:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2478:  *   of getting stuck in a loop.
 2479:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2480:  *   was found.
 2481:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2482:  */
 2483: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2484:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2485:                                                        const Side *origSide) {
 2486:                                                             
 2487:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2488:    // else to do. This means that the full step occurred within the current element.
 2489:    assert(!isDry && "Starting element is dry");
 2490:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2491: Vector2 x0_tmp = toVector2(x0);
 2492: if (!containsPoint(toPoint2(x0), origSide)) {if (idx == 15876) printf("1111: elem->idx = %d, origSide->idx = %d, x0_tmp = (%f, %f), x0 = (%f, %f), origSide.center = (%f, %f)\n", idx, origSide->idx, x0_tmp.x, x0_tmp.y, x0.x, x0.y, origSide->center.x, origSide->center.y); return false;}
 2493:    assert(containsPoint(toPoint2(x0), origSide) && "Starting point is not inside the element");
 2494: 
 2495:    if (containsPoint(toPoint2(xt), true, origSide)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2496: 
 2497:       assert(containsPoint(toPoint2(xt), origSide) && "Target point is not inside the element");
 2498:       assert(!isDry && "Target point is inside a dry element");
 2499: 
 2500:       u_int = interpolateVelocities(xt, origSide);
 2501: 
 2502:       nextElem = this;
 2503: 
 2504:       return true;
 2505:    }
 2506: 
 2507: 
 2508:    
 2509: 
 2510:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2511:    
 2512:    double t;
 2513:    Side *nextSide = nullptr;
 2514:    double tIntersect = 1e10;
 2515: 
 2516: 
 2517:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2518:    // (x0,y0) is inside the element but the target point is not.
 2519:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect, origSide);
 2520: if (!found_intersection) {if (idx == 15876) printf("111112: No intersection found\n"); return false;}
 2521:    assert(found_intersection && "No intersection found at %d");
 2522: 
 2523:    Point2 xtmp = toPoint2(toLocalFrame(nextSide->p3_t(t), origSide)); // If needed, moves the target point to the intersection point
 2524: 
 2525:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2526:    if (nextElem != nullptr && !nextElem->isDry) {
 2527:       assert(nextElem->containsPoint(xtmp, origSide) && "Intersection point is not inside the next element");
 2528:       nextElem->nudgeToBarycenter(xtmp, origSide);
 2529:    }
 2530: 
 2531:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2532:    xt = {xtmp.x, xtmp.y, zint};
 2533: 
 2534:    // if the tracking segment goes out of water (either dry or edge boundary)
 2535:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2536: 
 2537: 
 2538:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2539: 
 2540:       assert(this->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the current element");
 2541:       // When this happens, the backtracking stops.
 2542: 
 2543:       dt *= tIntersect;
 2544: 
 2545:       // In this case, the next element is again the current element.
 2546:       nextElem = this;
 2547: 
 2548: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2549: 
 2550:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2551:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2552:       return true;    
 2553:    }
 2554: 
 2555: 
 2556:    assert(nextElem->containsPoint(toPoint2(xt), origSide) && "Target point is not inside the next element");
 2557:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2558:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2559: 
 2560:    
 2561:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2562: 
 2563:    u_int = nextElem->interpolateVelocities(xt, origSide); 
 2564: 
 2565:    assert(nextElem != this && "Next element is the same as the current element");
 2566: 
 2567:    return true;
 2568: }
 2569: 
 2570: 
 2571: __inline__ __device__ double Element::computeSignedArea(void) const {
 2572:    // Compute the area of the element
 2573: 
 2574:    Point2 x0, x1, x2, x3;
 2575:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2576: 
 2577:    double res = signedArea(x0, x1, x2);
 2578: 
 2579:    // In the quad case we need to add the area of the other triangle.
 2580:    if (isQuad()) {
 2581:       x3 = getLocalHorizontalNodePosition(3);
 2582:       double ar1 = signedArea(x0, x2, x3);
 2583:       double ar2 = signedArea(x0, x1, x3);
 2584:       double ar3 = signedArea(x1, x2, x3);
 2585:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2586: 
 2587:       res += ar1 + ar2 + ar3;
 2588:    }
 2589: 
 2590:    return res;
 2591: }
 2592: 
 2593: 
 2594: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2595: // Nudges the point (x,y) to the barycenter of the element
 2596: 
 2597:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2598: 
 2599:    Point3 c = toLocalFrame(toPoint3(center, centerZ()), origSide); // In local frame coordinates if ics == 2
 2600: if (origSide->idx == 15876) printf("nudgeToBarycenter 1: center = (%f, %f) p = (%f, %f) elem->idx = %d, origSide->idx = %d, c = (%f, %f)\n", center.x, center.y, p.x, p.y, idx, origSide->idx, c.x, c.y);
 2601:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2602: }
 2603: 
 2604: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2605:                                                                 (nodes[1]->isDry2()) ||
 2606:                                                                 (nodes[2]->isDry2()) ||
 2607:                                                                 (i34==4 && nodes[3]->isDry2());
 2608: }
 2609: 
 2610: __inline__ __device__ double Element::detJ_eta(void) const {
 2611:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2612:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2613: }
 2614: 
 2615: __inline__ __device__ double Element::detJ_xi(void) const {
 2616:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2617:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2618: }
 2619: 
 2620: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2621:    // In boundary sides, the element 1 is nullptr
 2622:    return side->elems[1] == nullptr; 
 2623: }
 2624: 
 2625: 
 2626: 
 2627: /**
 2628:    Compute the shape coordinates of the point (xt,yt) in the element.
 2629:    @param xt (input): x-coordinate of the point
 2630:    @param shpCoords (output): shape coordinates of the point
 2631:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2632:    @return true if the point is inside the element, false otherwise
 2633: **/
 2634: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2635: 
 2636:    // Compute the shape coordinates of the point xt in the element.
 2637:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2638:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2639:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2640:    // from the local frame, so use additional check.
 2641: 
 2642:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2643: 
 2644:    if (isTri()) { // Triangular element
 2645: 
 2646:       // Horizontal local node coordinates. 
 2647:       Point2 x0 = nodes[0]->p;
 2648:       Point2 x1 = nodes[1]->p;
 2649:       Point2 x2 = nodes[2]->p;
 2650: 
 2651:       // If ics == 2, the node coordinates are transformed to local frame.
 2652:       if constexpr(ics==2) {
 2653:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2654:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2655:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2656: 
 2657:          // Coordinates of the center of the original side
 2658:          const Point3 c = {origSide->center.x, origSide->center.y, origSide->centerZ()}; 
 2659: 
 2660:          // Convert the node coordinates to the local frame centered at the element center
 2661:          x0 = toVector2(origSide->frame.G2L(p0 - c));
 2662:          x1 = toVector2(origSide->frame.G2L(p1 - c));
 2663:          x2 = toVector2(origSide->frame.G2L(p2 - c));
 2664:       }
 2665: 
 2666:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2667:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2668:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2669:       shpCoords[3] = 0.0;
 2670: 
 2671: if (origSide->idx == 15876) printf("computeShapeCoords 1: x,y = (%f, %f), elem->idx = %d, shpCoords = (%f, %f, %f, %f)\n", xt.x, xt.y, idx, shpCoords[0], shpCoords[1], shpCoords[2], shpCoords[3]);
 2672: 
 2673:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2674:       const bool res = (tmpmin >= -small);  
 2675:       
 2676:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2677:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2678: 
 2679:       
 2680:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2681:       // then we fix the negative shape coordinates.
 2682:       if ((tmpmin < 0) && fix) {
 2683: 
 2684:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2685:          // keeping the sum of the shape coordinates equal to 1.
 2686:          // I have tested and compared the new algorithm with the old one, and they give
 2687:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2688:          // The new algorithm should be faster since it is branchless.
 2689:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2690:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2691:          
 2692:          shpCoords[0] = (shpCoords[0] + a)*b;
 2693:          shpCoords[1] = (shpCoords[1] + a)*b;
 2694:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2695: 
 2696:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2697:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2698:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2699: 
 2700:          // Update the point coordinates for the new shape coordinates
 2701:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2702:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2703:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2704: 
 2705:       }
 2706: 
 2707:       // Check if the point is inside the element
 2708:       return res;      
 2709:    }
 2710:    else {
 2711:       Error("Not implemented yet");
 2712: #ifdef QUADS
 2713:       // Reproject pt in eframe of nel for ics=2
 2714:       if constexpr(ics==1) {
 2715:          xn2 = xt; 
 2716:          yn2 = yt;
 2717:       }
 2718:       else {
 2719:          // Transform the point coordinates to the local frame
 2720:          frame.G2L(xt, xn2);
 2721:          frame.G2L(yt, yn2);
 2722:       }
 2723: 
 2724:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2725: #endif
 2726:    }
 2727: 
 2728:    assert(false && "computeShapeCoords: should never reach this point");
 2729:    return false;  // Never reached
 2730: 
 2731: }
 2732: 
 2733: 
 2734: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2735: // Convert shape coordinates to cartesian coordinates
 2736: 
 2737:    if (i34 == 3) {
 2738:       // Triangular element
 2739:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2740:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2741:    }
 2742:    else {
 2743:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2744:    }
 2745: 
 2746: }
 2747: 
 2748: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2749:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2750:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2751:    // The formula for the integral is:
 2752:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2753: 
 2754:    printf("intPhiPhi: TEST\n");
 2755: 
 2756:    const Node *n0 = nodes[0];
 2757:    const Node *n1 = nodes[1];
 2758:    const Node *n2 = nodes[2];
 2759:    const Node *n3 = nodes[3];
 2760: 
 2761:    const Vector2 p0 = n0->p;
 2762:    const Vector2 p1 = n1->p;
 2763:    const Vector2 p2 = n2->p;
 2764:    const Vector2 p3 = n3->p;
 2765: 
 2766:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2767:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2768:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2769:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2770: 
 2771:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2772: }
 2773:    
 2774: 
 2775: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2776:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2777:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2778:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2779:    // The formula is also based on the identity:
 2780:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2781:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2782: 
 2783:    printf("intGradPhiGradPhi: TEST\n");   
 2784: 
 2785:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2786: 
 2787:    const double x0 = nodes[0]->p.x;
 2788:    const double y0 = nodes[0]->p.y;
 2789:    const double x1 = nodes[1]->p.x;
 2790:    const double y1 = nodes[1]->p.y;
 2791:    const double x2 = nodes[2]->p.x;
 2792:    const double y2 = nodes[2]->p.y;
 2793:    const double x3 = nodes[3]->p.x;
 2794:    const double y3 = nodes[3]->p.y;
 2795: 
 2796:    double res = 0.0;
 2797:    
 2798:    // Quadrature points in xi and eta coordinates
 2799:    #pragma unroll
 2800:    for (int i = 0; i < 4; i++) {
 2801:       // For each quadrature point...
 2802: 
 2803:       const Point2 p = GaussPoint(i);
 2804:       const double eta = p.x;
 2805:       const double xi  = p.y;
 2806: 
 2807:       // Jacobian entries at the Gauss point p
 2808:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2809:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2810:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2811:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2812: 
 2813:       const double detJ = jacobianDet(p);
 2814:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2815: 
 2816:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2817:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2818:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2819:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2820:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2821: 
 2822:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2823:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2824:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2825:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2826:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2827: 
 2828:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2829:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2830:    }
 2831: 
 2832:    return res;
 2833: }
 2834: 
 2835: 
 2836: /**  Interpolate velocities at a given point (xt,yt,zt)
 2837: 
 2838:    @param xt, yt, zt: coordinates of the point to interpolate
 2839:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2840: 
 2841:    This is done in four steps:
 2842: 
 2843:    1. Find the shape coordinates for the final position in the element.
 2844:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2845:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2846:       z levels at xt, yt at each step.   
 2847:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2848:       horizontally and vertically.
 2849: **/
 2850: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 2851:    // Interpolate the velocities at the point xt. 
 2852:    // This function works the same for triangular and quadrilateral elements.
 2853:    double shpCoord[4];
 2854:    Vector3 u_int;
 2855: 
 2856:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 2857: 
 2858:    // First step is to compute the shape coordinates of (xt,yt)
 2859: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 2860:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 2861: 
 2862:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2863: 
 2864:    // Second step is to find the level that contains zt
 2865:    // Uses a binary search to find the level
 2866:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2867:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2868:    int R = nvrt - 1;
 2869: 
 2870:    // Get the z coordinates at the nodes of the element at the levels L and R
 2871:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2872:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2873:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2874: 
 2875:    double zL = interpolate(shpCoord, zLAtNodes);
 2876:    double zR = interpolate(shpCoord, zRAtNodes);
 2877:    
 2878:    // Interpolates vertically the velocities
 2879:    double wght1, wght2;
 2880:    if (xt.z<=zL) {
 2881:       wght1 = 1.0;
 2882:       wght2 = 0.0;
 2883:       xt.z = zL;
 2884:    }
 2885:    else if (xt.z>=zR) {
 2886:       wght1 = 0.0;
 2887:       wght2 = 1.0;
 2888:       xt.z = zR;
 2889:    }
 2890:    else {
 2891:       // Perform a binary search to find the levels between L and R that contain xt.z
 2892:       while (R - L > 1) {
 2893:          int M = (L + R) / 2.0;
 2894: 
 2895:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2896:          double zM = interpolate(shpCoord, zMAtNodes);
 2897:          if (zM < xt.z) 
 2898:          {
 2899:             L = M;
 2900:             zL = zM;
 2901:          }
 2902:          else 
 2903:          {
 2904:             R = M;
 2905:             zR = zM;
 2906:          }
 2907:       }
 2908:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2909:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2910: 
 2911:       wght2 = (xt.z - zL)/(zR - zL);
 2912:       wght1 = 1.0 - wght2;
 2913: 
 2914:    }
 2915: 
 2916: 
 2917:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2918:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 2919:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2920:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 2921: 
 2922:    // Neither of the interpolated velocities should be NaN
 2923:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2924: 
 2925:    return u_int;
 2926: 
 2927: }
 2928: 
 2929: 
 2930: 
 2931: 
 2932: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2933: 
 2934:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2935:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2936:    const Node *n1 = side->n1;
 2937:    const Node *n2 = side->n2;
 2938: 
 2939:    bool n1_match = (n1->nodeBnd->segment == segment);
 2940:    bool n2_match = (n2->nodeBnd->segment == segment);
 2941: 
 2942:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2943:    if (n1_match && n2_match) {
 2944:       return 0.5;
 2945:    } else if (n1_match) {
 2946:       return 1.0;
 2947:    } else if (n2_match) {
 2948:       return 0.0;
 2949:    }
 2950: 
 2951:    return 0.0;
 2952: }
 2953: 
 2954: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2955: 
 2956: 
 2957: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2958: 
 2959:    const double w1 = getBoundaryArrayValueWeight();
 2960:    const double w2 = 1.0 - w1;
 2961:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2962:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2963: 
 2964:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2965: }
 2966: 
 2967: 
 2968: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2969:    const double w1 = getBoundaryArrayValueWeight();
 2970:    const double w2 = 1.0 - w1;
 2971:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2972:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2973: 
 2974:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2975: 
 2976: }
 2977: 
 2978: 
 2979: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2980:    // Returns the value of the velocity at the side center
 2981:    const double w1 = getBoundaryArrayValueWeight();
 2982:    const double w2 = 1.0 - w1;
 2983:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2984:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2985: 
 2986:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2987: }
 2988: 
 2989: 
 2990: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2991:    // Returns the value of the normal component of the velocity at the side center
 2992:    const double w1 = getBoundaryArrayValueWeight();
 2993:    const double w2 = 1.0 - w1;
 2994:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2995:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2996: 
 2997:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2998: }
