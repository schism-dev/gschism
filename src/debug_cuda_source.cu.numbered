 2632: 
 2633: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2634: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2635: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2636: // Only when ics == 2, the origin is at the element center.
 2637: 
 2638:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2639: 
 2640:    const Node *node = nodes[idxNode];
 2641: 
 2642:    if constexpr(ics==1) {
 2643:       return node->p;
 2644: 
 2645:    } else {
 2646:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2647: 
 2648:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2649: 
 2650:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2651:    }
 2652: 
 2653: }
 2654: 
 2655: 
 2656: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2657:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2658: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2659: 
 2660:    const int id1 = idx;
 2661:    const int id2 = nxq(1 + id1);
 2662:    const int id3 = nxq(2 + id1);
 2663: 
 2664:    if constexpr(ics==1) {
 2665:       x0 = nodes[id1]->p;
 2666:       x1 = nodes[id2]->p;
 2667:       x2 = nodes[id3]->p;
 2668: 
 2669:    } else {
 2670: 
 2671:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2672:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2673:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2674: 
 2675:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2676:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2677:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2678: 
 2679:    }
 2680: 
 2681: }
 2682: 
 2683: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2684:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2685: }
 2686: 
 2687: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2688:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2689:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2690: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2691: 
 2692:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2693: 
 2694: 
 2695: 
 2696:    if constexpr(ics==1) {
 2697:       x0 = nodes[0]->p;
 2698:       x1 = nodes[1]->p;
 2699:       x2 = nodes[2]->p;  
 2700:       x3 = nodes[3]->p;
 2701: 
 2702:    } else {
 2703: 
 2704:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2705:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2706:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2707:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2708: 
 2709:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2710:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2711:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2712:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2713:    }
 2714: 
 2715: }
 2716: 
 2717: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2718:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2719: {
 2720:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2721: }
