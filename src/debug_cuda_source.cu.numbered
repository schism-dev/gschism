  163: // VECTOR/POINT operations ---------------------------------------------------------------------------
  164: 
  165: using Vector2 = double2; 
  166: using Vector3 = double3;
  167: using Point2  = double2;
  168: using Point3  = double3;
  169: 
  170: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  171:     return make_double2(a.x + b.x, a.y + b.y);
  172: }
  173: 
  174: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  175:     a.x += b.x;
  176:     a.y += b.y;
  177:     return a;
  178: }
  179: 
  180: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  181:     return make_double2(a.x - b.x, a.y - b.y);
  182: }
  183: 
  184: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  185:     a.x -= b.x;
  186:     a.y -= b.y;
  187:     return a;
  188: }
  189: 
  190: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  191:     return make_double2(v.x * s, v.y * s);
  192: }
  193: 
  194: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  195:     return v * s;  // reuse the previous operator
  196: }
  197: 
  198: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  199:     return make_double2(v.x / s, v.y / s);
  200: }
  201: 
  202: __device__ __forceinline__ double norm2(const double2& v) {
  203:     return v.x*v.x + v.y*v.y;
  204: }
  205: 
  206: __device__ __forceinline__ double length(const double2& v) {
  207:     return sqrt(v.x*v.x + v.y*v.y);
  208: }
  209: 
  210: __device__ __forceinline__ double2 normalize(const double2& v) {
  211:     return v / length(v);
  212: }
  213: 
  214: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  215:     return v.x*w.x + v.y*w.y;
  216: }
  217: 
  218: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  219:     return v.x*w.y - v.y*w.x;
  220: }
  221: 
  222: __device__ __forceinline__ double2 rot90(const double2& a) {
  223:     return make_double2(a.y, -a.x);
  224: }
  225: 
  226: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  227:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  228: }
  229: 
  230: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  231:     a.x += b.x;
  232:     a.y += b.y;
  233:     a.z += b.z;
  234:     return a;
  235: }
  236: 
  237: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  238:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  239: }
  240: 
  241: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  242:     return make_double3(v.x * s, v.y * s, v.z * s);
  243: }
  244: 
  245: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  246:     return v * s;
  247: }
  248: 
  249: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  250:     return make_double3(v.x / s, v.y / s, v.z / s);
  251: }
  252: 
  253: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  254:     return v.x*w.x + v.y*w.y + v.z*w.z;
  255: }
  256: 
  257: __device__ __forceinline__ double norm2(const double3& v) {
  258:     return v.x*v.x + v.y*v.y + v.z*v.z;
  259: }
  260: 
  261: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
  262:     return make_double2(v.x, v.y);
  263: }
  264: 
  265: __device__ __forceinline__ double3 toVector3(const double2& v, double w) {
  266:     return make_double3(v.x, v.y, w);
  267: }
  268: 
  269: __device__ __forceinline__ Point2 toPoint2(const double3& p) {
  270:     return make_double2(p.x, p.y);
  271: }
  272: 
  273: __device__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  274:     return make_double3(p.x, p.y, z);
  275: }
