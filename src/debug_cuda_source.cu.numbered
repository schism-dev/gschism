 2169:    template<typename T>
 2170:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2171:       T values[4];
 2172:       getNodalValues(level, func, values);
 2173: 
 2174:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2175:       if constexpr (IsVector2<T>::value && ics == 2) {
 2176: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2177:          projectNodeVectorsToElementFrame(values);
 2178: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2179:       }
 2180: 
 2181:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2182:    }
 2183: 
 2184:    template<typename T>
 2185:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2186:       T values[4];
 2187:       getNodalValues(field, values);
 2188: 
 2189:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2190:       if constexpr (IsVector2<T>::value && ics == 2) {
 2191: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2192:          projectNodeVectorsToElementFrame(values);
 2193: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2194:       }
 2195:       
 2196:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2197:    }
 2198: 
