10109: extern "C" __global__ void getNodeVarFunc(int varCode, double *res) {
10110: 
10111:    NODE(node);
10112: 
10113:    switch (varCode) {
10114:       case (int)VarCode::outputCoords:
10115:          const Point2 coords = node->outputCoords();
10116:          res[node->idx*2    ] = coords.x;
10117:          res[node->idx*2 + 1] = coords.y;
10118:          break;
10119:    }
10120: }
