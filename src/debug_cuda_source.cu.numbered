 4693:    __global__ void computeFlowBcVelocities(double time) {
 4694: 
 4695:       SIDE_BND(sideBnd);
 4696: 
 4697:       const Side *side = sideBnd->side;
 4698:  
 4699:       const bool isDry = side->isDry;
 4700:       const bool isLand = sideBnd->segment->isLand;
 4701: 
 4702:    
 4703:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4704: 
 4705:       if (isDry || isLand) return;
 4706: 
 4707:       // For wet sides in open boundaries...
 4708:       const Vector2 n = side->n;
 4709:       const BoundarySegment *segment = sideBnd->segment;
 4710: 
 4711:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4712: 
 4713:       const int ifltype = segment->ifltype;
 4714: 
 4715:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4716:       const Vector2 r_nuth0 = r_uth0*n;
 4717: 
 4718: 
 4719:       if (ifltype == 1 || ifltype == 2) {
 4720:       
 4721:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4722: 
 4723:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4724:          
 4725:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4726:          
 4727:       } else if (ifltype == -1) { // Flather 1
 4728: 
 4729:          for (int k = 0; k < nvrt; k++) {
 4730: 
 4731:             // uth is the normal vel.; no ramp up
 4732:             const double uth = sideBnd->nuth(k);
 4733:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4734: 
 4735:             sideBnd->ubc[k] += uth*n;
 4736:          }
 4737: 
 4738:       } else if (ifltype == 3 || ifltype == 5) {
 4739:          // vnth0=0 !normal vel.
 4740: 
 4741:          Vector2 r_u1_bar = {0.0, 0.0};
 4742:          // Computes the contribution to the velocity from all tide frequencies
 4743:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4744: 
 4745:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4746:             const Vector2 umo  = sideBnd->umo(jfr); 
 4747: 
 4748:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4749:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4750:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4751:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4752:          }
 4753: 
 4754: 
 4755:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4756: 
 4757:       } // if (ifltype = 3 || ifltype == 5
 4758: 
 4759: 
 4760: 
 4761:    }
 4762: 
 4763:    __global__ void computeElevationBoundaryConditions(double time) {
 4764:       // Compute elevation essential boundary conditions 
 4765: 
 4766:       NODE_BND(nodeBnd); // Each boundary node.
 4767: 
 4768:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4769: 
 4770:       const Node *node = nodeBnd->node;
 4771:       const BoundarySegment *segment = nodeBnd->segment;
 4772:       const int iettype = segment->iettype;
 4773:       
 4774: 
 4775:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4776:       double eic = 0.0;
 4777:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4778:       else                 eic = 0.0;
 4779: 
 4780:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4781:       const double r_eth = ramp*nodeBnd->eth;
 4782:       double r_eta1_bar = 0.0;
 4783: 
 4784: 
 4785:       // Compute tide elevation
 4786:       if (iettype == 3 || iettype == 5) {   
 4787: 
 4788:          if constexpr(iloadtide==1) { // loading tide
 4789:             assert(false && "Loading tide not implemented");
 4790:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4791:          }
 4792:          
 4793:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4794: 
 4795:             const double efa  = nodeBnd->efa[jfr]; 
 4796:             const double emo  = nodeBnd->emo[jfr]; 
 4797: 
 4798:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4799:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4800:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4801: 
 4802:          } // for jfr
 4803: 
 4804:       } // if iettype
 4805: 
 4806:       switch (iettype) {
 4807:          case 1:
 4808:          case 2:
 4809:          case 4:
 4810:             nodeBnd->elbc = r_eic + r_eth;
 4811:             break;
 4812:          case 3:
 4813:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4814:             break;
 4815:          case 5:
 4816:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4817:             break;
 4818:       } // switch
 4819: 
 4820: 
 4821:       //Add inverse barometric effects
 4822:       if (iettype != 0 && inv_atm_bnd == 1) {
 4823:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4824:       }
 4825: 
 4826:    }
 4827: 
 4828: 
 4829:    __global__ void computeHorizontalViscosity(void) { 
 4830: 
 4831:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4832: 
 4833:       SIDE(side);
 4834: 
 4835:       if (side->isDry) return;
 4836: 
 4837:       for (int k = 0; k < nvrt; k++) {
 4838:          side->nuGradU[k] = {0.0, 0.0};
 4839:       }
 4840: 
 4841:       if constexpr(ihorcon == 1) {
 4842:          for (int k = side->kb; k < nvrt - 1; k++) {
 4843:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4844:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4845:             // By Zhang and Baptista.
 4846: 
 4847:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4848:             // This is a standard discretization of the Laplacian operator.
 4849:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4850:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4851:             // Gamma is hvis_coef0 in the code.
 4852:             // The value of gamma needs to be < 0.5.
 4853: 
 4854:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4855:             // side under consideration in each of the two possible elements that share the side.
 4856:             Vector2 sumU = {0.0, 0.0};
 4857:             for (int l = 0; l < 2; l++) {
 4858:                const Element *elem = side->elems[l];
 4859: 
 4860:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4861: 
 4862:                // Find the local index of the side in the element
 4863:                const int idxSide = elem->sideLocalIdx(side);
 4864:                // Find the two sides that are connected to the side under consideration
 4865:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4866:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4867: 
 4868:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4869: 
 4870:             }
 4871: 
 4872:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4873:    
 4874:          }
 4875:       }
 4876:       else if constexpr(ihorcon == 2) {
 4877:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4878:       }
 4879: 
 4880: 
 4881:    }
 4882: 
 4883: 
 4884:    __global__ void setEssentialBC(void) {
 4885:       // Set essential boundary conditions 
 4886:       NODE(node); // Each boundary node
 4887:       NodeBoundary *nodeBnd = node->nodeBnd;
 4888:       
 4889: // nodeBnd->isEssentialBC = true;      
 4890:       // Check if this node has essential BC
 4891:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4892:          // Verify BC value is valid
 4893:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4894: 
 4895:        
 4896:          // Set diagonal to 1 and zero off-diagonals
 4897:          node->coeffDiag = 1.0;
 4898: 
 4899:          for (int j = 0; j < node->numNodes; j++) {
 4900:                node->coeffMatrix[j] = 0.0;
 4901:          }
 4902:          
 4903:          // Set solution and RHS to BC value
 4904:          node->mX  = nodeBnd->elbc;
 4905:          node->qel = nodeBnd->elbc;
 4906: // printf("bbbbb\n");
 4907:       } else {
 4908:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4909: // printf("aaaaaa\n");
 4910:          for (int j = 0; j < node->numNodes; j++) {
 4911:                Node* nbNode = node->nodes[j];
 4912:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4913:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4914:                   // Verify neighbor's BC value
 4915:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4916: 
 4917:                   // Subtract contribution to RHS
 4918:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4919:                   node->coeffMatrix[j] = 0.0;  
 4920:                }
 4921:          }
 4922:       }
 4923:    }
 4924: 
 4925: 
 4926:    __global__ void updateElevation(void) {
 4927:       NODE(node);
 4928: 
 4929:       node->eta2 = node->mX;
 4930: 
 4931:       node->updateZCoordData();
 4932:    }
