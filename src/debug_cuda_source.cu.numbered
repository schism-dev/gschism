 1535:    __device__ void setFrame(void) {
 1536:       if constexpr(ics == 1) return;
 1537: 
 1538:       double lat, lon;
 1539:       const Point3 p = toPoint3(center, centerZ());
 1540: 
 1541:       // Compute the latitude and longitude of the element center
 1542:       computeLatLon(p, lat, lon);
 1543: 
 1544:       frame.update(lat, lon);        
 1545:    }
 1546:    
 1547: 
 1548:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1549:    // If ics == 2, convert the global point to the local frame of the side
 1550:       
 1551:       if constexpr (ics == 1) {
 1552:          return p;
 1553:       } else {
 1554:          const Point3 c = {center.x, center.y, centerZ()};
 1555:          const Point3 local = frame.G2L(p - c);
 1556:          return local;
 1557:       }
 1558:    }
 1559: 
 1560:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1561:       if constexpr (ics == 1) {
 1562:          return p;
 1563:       } else {
 1564:          const Point3 c = {center.x, center.y, centerZ()};
 1565:          return c + frame.L2G(p);
 1566:       }
 1567:    }
 1568: 
 1569: 
 1570:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1571:       if constexpr(ics == 1) return v;
 1572:       else return v_frame.projHorVec(v, frame);
 1573:    }
 1574: 
 1575:    __inline__ __device__ double centerZ(void)      const;
 1576:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1577:    // k is the upper level of the layer (same convention as Dz).
 1578:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt && k > 0); return zc[k] - zc[k - 1]; }
 1579:    __inline__ __device__ double area(int k)        const { assert(k < nvrt && k > 0); return len*Dz(k); }
 1580:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt && k > 0); return len*(zc[max(k, kb)] - zc[max(k - 1, kb)]); }
 1581: 
 1582:    __inline__ __device__ Side* neigh(int index) const { 
 1583:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1584:       assert(index >= 0 && index < 4); 
 1585:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1586: 
 1587:       const int ielem = index & 1;           // 0 or 1
 1588:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1589: 
 1590:       const Element* elem = elems[ielem];
 1591: 
 1592:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1593: 
 1594:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1595: 
 1596:    }
 1597: 
 1598:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1599: 
 1600:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1601: 
 1602:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1603:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1604:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1605:    __inline__ __device__ int iadv(void) const;
 1606: 
 1607:    __inline__ __device__ double grav3(void) const;
 1608:    
 1609:    __inline__ __device__ double eta2(void) const;
 1610:    __inline__ __device__ double eta1(void) const;
 1611:    __inline__ __device__ double w2(int k) const;
 1612:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1613:    __inline__ __device__ double depth(void) const;
 1614:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1615:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1616: 
 1617:    __inline__ __device__ double dfv(int k) const;
 1618: 
 1619:    __inline__ __device__ double veg_h(void)  const;
 1620:    __inline__ __device__ double veg_nv(void) const;
 1621:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1622:    __inline__ __device__ double veg_alpha3D(int k) const;
 1623:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1624: 
 1625:    __inline__ __device__ double Cd(void) const;
 1626: 
 1627:    __inline__ __device__ Vector2 tau(void) const;
 1628: 
 1629:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1630:    
 1631: 
 1632:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1633:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1634:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1635:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1636:    } 
 1637:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1638:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1639:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1640:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1641: 
 1642:    // Get valid starting element (for backtracking)
 1643:    __inline__ __device__ Element* getStartElement() {
 1644:       return elems[0] ? elems[0] : elems[1];
 1645:    }
 1646: 
 1647:    
 1648:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1649:       // Given an element, returns the other element that shares this side
 1650:       return (elems[0] == elem) ? elems[1] : elems[0];
 1651:    }
 1652: 
 1653:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1654:       // Given a node, returns the other node that shares this side
 1655:       return (n1 == node) ? n2 : n1;
 1656:    }
 1657:  
 1658:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1659: 
 1660: 
 1661: 
 1662: 
 1663: };
 1664: 
 1665: 
 1666: // This struct is used to store the boundary information for a node.
 1667: struct NodeBoundary {   
 1668:    int idx;
 1669:    BoundarySegment *segment;
 1670:    Node *node;
 1671:    
 1672:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1673:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1674: 
 1675:    bool isLand;
 1676: 
 1677:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1678:    double elbc;   // Elevation boundary condition
 1679:    double eth;    // Elevation time history
 1680: 
 1681:    double eta_mean; // Mean elevation at nodes
 1682: 
 1683:    bool isEssentialBC;
 1684: 
 1685:    Vector2 uth[nvrt];  // "Time history" velocity
 1686: 
 1687:    // Arrays for harmonic constituents (if needed)
 1688:    // nbfr ? nbfr : 1 is there to avoid a 0-sized array.
 1689:    double  emo[nbfr ? nbfr : 1];  // Elevation amplitude
 1690:    double  efa[nbfr ? nbfr : 1];  // Elevation phase
 1691: 
 1692: 
 1693:    NodeBoundary(void) {
 1694:       isLand = false;
 1695:    }
 1696:    NodeBoundary(bool _isLand) {
 1697:       isLand = _isLand;
 1698:    }
 1699: 
 1700:    
 1701:    __forceinline__ __device__ int numSidesForAverage() const {
 1702:    // Returns the number of sides that are connected to the node and have the same segment.
 1703:    // This is used to compute the average velocity at the node for open boundary nodes.
 1704:       int res = 0;
 1705:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1706:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1707: 
 1708:       return res;
 1709:    }
 1710: 
 1711: 
 1712:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1713:       assert(index == 0 || index == 1); 
 1714:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1715:    }
 1716: 
 1717:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1718:       if (isLand) return;  // land never uses these links
 1719: 
 1720:       SideBoundary *nullSideBoundary = nullptr;
 1721:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1722: 
 1723:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1724:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1725: 
 1726:       // both slots taken. OK if this side was already linked
 1727:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1728:    }
 1729: 
 1730: 
 1731: };
 1732: 
 1733: struct Node {
 1734: 
 1735:    // Geometry information
 1736:    int idx;            // Global index of the node
 1737:    int16_t part;       // Partition of the node
 1738: 
 1739:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1740:    int16_t numNodes;   // Number of nodes neighbors of this node
 1741: 
 1742:    Element **elements; // Array of pointers to the elements that share this node
 1743:    int16_t numElements;// Number of elements that share this node
 1744: 
 1745:    int16_t numSides;   // Number of sides that are connected to this node
 1746: 
 1747: 
 1748:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1749:    double gz;          // Global vertical coordinate at the node.
 1750:    Vector2 u2[nvrt];
 1751:    double  w2[nvrt];
 1752:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1753:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1754:    double lon, lat;
 1755:    double depth;
 1756: 
 1757:    Frame<ics> frame;
 1758: 
 1759:    LocalSigma<ivcor> localSigma;  
 1760: 
 1761:    int16_t kb;     // Bottom index of the node
 1762: 
 1763:    bool isDry;     // True if the node is dry
 1764: 
 1765:    int16_t iadv;   // Advection flag
 1766: 
 1767:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1768:                           // this is nullptr
 1769: 
 1770:    TempVar tmp; // Temporary variable to store different types of variables
 1771: 
 1772:    // Physical information
 1773:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1774:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1775: 
 1776:    double rho[nvrt];     // Density
 1777:    double dfv[nvrt];     // Vertical viscosity
 1778:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1779: 
 1780:    Turbulence<turbulenceModel> turb;
 1781: 
 1782:    double eta1; // Elevation at nodes at previous timestep
 1783:    double eta2; // Elevation at nodes at current timestep
 1784: 
 1785:    double ETP;  // Earth Tidal Potential
 1786: 
 1787:    double pr;    // Air pressure
 1788:    double grav2; // Gravity 
 1789:    
 1790:    Vector2 dav;  // Depth averaged velocity
 1791: 
 1792:    Vector2 tau; // Wind stress vector
 1793: 
 1794:    // Vegetation parameters
 1795:    double veg_h;
 1796:    double veg_nv;
 1797:    double veg_di;
 1798:    double veg_Cd;
 1799:    double veg_h_unbent;
 1800:    double veg_di_unbent;
 1801:    double veg_nv_unbent;
 1802:    double veg_alpha_vert_mean;
 1803:    double veg_alpha0;
 1804:    double veg_alpha3D[nvrt];
 1805: 
 1806:    // Bottom drag parameters
 1807:    double Cd;       // Bottom drag coefficient   
 1808: 
 1809:    // These three are mutually exclusive
 1810:    union {
 1811:       double rmanning; // Bottom Manning's coefficient
 1812:       double rough;    // Bottom roughness length
 1813:       double drag;     // Bottom drag coefficient
 1814:    };
 1815:    Vector2 tau_bot; // Bottom stress vector
 1816: 
 1817:    // XXXX REMOVE FOR IMM>0???
 1818:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1819:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1820: 
 1821:    
 1822:    double qel; // RHS
 1823:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1824:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1825:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1826:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1827: 
 1828:    double mX; // Solution of the FEM system
 1829: 
 1830:    // Meteorological forcing
 1831:    Vector2 u_air;
 1832:    double p_air;  // XXXX is this the same as pr?
 1833:    double t_air;
 1834:    double q_air;
 1835:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1836: 
 1837: 
 1838: 
 1839:    __device__ __forceinline__ int localIndex() const;
 1840:    __device__ __forceinline__ int packedIndex() const;
 1841: 
 1842: 
 1843:    __device__ void setWind(Vector2 &u) {
 1844:    // Sets the wind vector taking into account the mesh angle
 1845:    
 1846:       const double speed = length(u);
 1847: 
 1848:       // Rotate wind vector to the node frame
 1849:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1850: 
 1851:       // Sets the surface stress vector due to wind.
 1852:       if constexpr(nws == 0) {
 1853:          tau = {0.0, 0.0};
 1854: 
 1855:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1856:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1857: 
 1858:       } else {
 1859: 
 1860:          double dragcoef;
 1861: 
 1862:          if constexpr(iwind_form == -1) {
 1863:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1864:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1865: 
 1866:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1867:             tau = cff*u_air;
 1868:  
 1869:          } else if constexpr(iwind_form == 1) {
 1870:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1871:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1872: 
 1873:             dragcoef = max(dragcoef, 4.0e-4);
 1874:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1875:             tau = cff*u_air;
 1876: 
 1877:          } else {
 1878:             tau = {0.0, 0.0};
 1879:          }
 1880:       }
 1881:    }
 1882: 
 1883: 
 1884:    __device__ void setFrame(double lat, double lon) {
 1885:       if constexpr(ics == 1) return;
 1886: 
 1887:       frame.update(lat, lon);        
 1888:     }
 1889: 
 1890:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1891: 
 1892:    __device__ double sigmaTransitionDepth(void) const;
 1893: 
 1894:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1895: 
 1896:    __inline__ __device__ Point2 outputCoords(void) const {
 1897:       if constexpr(ics == 1)  return p;
 1898:       else                    return {rad2deg*lon, rad2deg*lat};
 1899:    }
 1900: 
 1901:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1902:    // If ics == 2, convert the global point to the local frame
 1903:       
 1904:       if constexpr (ics == 1) {
 1905:          return p;
 1906:       } else {
 1907:          const Point3 c = {p.x, p.y, gz};
 1908:          const Point3 local = frame.G2L(p - c);
 1909:          return local;
 1910:       }
 1911:    }
 1912: 
 1913:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1914:    // If ics == 2, convert the global point to the local frame
 1915:       
 1916:       if constexpr (ics == 1) {
 1917:          return p;
 1918:       } else {
 1919:          const Point3 c = {p.x, p.y, gz};
 1920:          return c + frame.L2G(p);
 1921:       }
 1922:    }
 1923: 
 1924:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1925:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1926:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1927:    
 1928:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1929: 
 1930:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1931:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1932:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1933: 
 1934:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1935:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1936: 
 1937:    __device__ __forceinline__ void clearMatrixRow(void) {
 1938:       // Clear the matrix row for this node
 1939: 
 1940:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1941: 
 1942:    }
 1943: 
 1944:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1945:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1946:       
 1947:       if (node == this) {
 1948:          *coeffDiag += value;
 1949:          return;
 1950:       }
 1951: 
 1952:       int i;
 1953:       for (i = 0; i < numNodes; i++) {
 1954:          if (nodes[i] == node) break;
 1955:       }
 1956: 
 1957:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1958:       coeffRow[csrSlot[i]] += value;
 1959:    }
 1960: 
 1961: 
 1962:    __device__ __inline__ void updateZCoordData(void);
 1963: 
 1964:    __device__ __forceinline__ double compZCoord(int k) const;
 1965: 
 1966:    __device__ void updateKb(void);
 1967: 
 1968:    __device__ __forceinline__ void computeBottomDragCd(void);
 1969: 
 1970: 
 1971: 
 1972: };
