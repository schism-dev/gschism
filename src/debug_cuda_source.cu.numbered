 5640:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5641:                                  int* indices, int* indptr) {
 5642:       // XXXXXXXXXXXX REMOVE!!!
 5643:       assert(false && "setupCGSolver has beed deprecated");
 5644: 
 5645:       // NODE(node);
 5646:       
 5647:       // const int idx = node->idx;
 5648:       
 5649:       // // Computes the index in the nzz array      
 5650:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5651: 
 5652: 
 5653:       // indptr[idx] = nzzIdx;
 5654:       // indices[nzzIdx] = idx;
 5655: 
 5656:       // data_d[nzzIdx]    = node->coeffDiag;
 5657: 
