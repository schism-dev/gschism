 4909:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4910: 
 4911:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4912:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4913:    //          enddo !j
 4914:    //        endif
 4915:    //      enddo !k
 4916:    //    endif !nfltype2
 4917:    }
 4918: 
 4919: 
 4920:    __global__ void computeFlowBcVelocities(double time) {
 4921: 
 4922:       SIDE_BND(sideBnd);
 4923: 
 4924:       const Side *side = sideBnd->side;
 4925:  
 4926:       const bool isDry = side->isDry;
 4927:       const bool isLand = sideBnd->segment->isLand;
 4928: 
 4929:    
 4930:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4931: 
 4932:       if (isDry || isLand) return;
 4933: 
 4934:       // For wet sides in open boundaries...
 4935:       const Vector2 n = side->n;
 4936:       const BoundarySegment *segment = sideBnd->segment;
 4937: 
 4938:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4939: 
 4940:       const int ifltype = segment->ifltype;
 4941: 
 4942:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4943:       const Vector2 r_nuth0 = r_uth0*n;
 4944: 
 4945: 
 4946:       if (ifltype == 1 || ifltype == 2) {
 4947:       
 4948:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4949: 
 4950:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4951:          
 4952:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4953:          
 4954:       } else if (ifltype == -1) { // Flather 1
 4955: 
 4956:          for (int k = 0; k < nvrt; k++) {
 4957: 
 4958:             // uth is the normal vel.; no ramp up
 4959:             const double uth = sideBnd->nuth(k);
 4960:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4961: 
 4962:             sideBnd->ubc[k] += uth*n;
 4963:          }
 4964: 
 4965:       } else if (ifltype == 3 || ifltype == 5) {
 4966:          // vnth0=0 !normal vel.
 4967: 
 4968:          Vector2 r_u1_bar = {0.0, 0.0};
 4969:          // Computes the contribution to the velocity from all tide frequencies
 4970:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4971: 
 4972:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4973:             const Vector2 umo  = sideBnd->umo(jfr); 
 4974: 
 4975:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4976:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4977:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4978:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4979: 
 4980:          }
 4981: 
 4982: 
 4983:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4984: 
 4985:       } // if (ifltype = 3 || ifltype == 5
 4986: 
 4987: 
 4988: 
 4989:    }
 4990: 
 4991:    __global__ void computeElevationBoundaryConditions(double time) {
 4992:       // Compute elevation essential boundary conditions 
 4993: 
 4994:       NODE_BND(nodeBnd); // Each boundary node.
 4995: 
 4996:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4997: 
 4998:       const Node *node = nodeBnd->node;
 4999:       const BoundarySegment *segment = nodeBnd->segment;
 5000:       const int iettype = segment->iettype;
 5001:       
 5002: 
 5003:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5004:       double eic = 0.0;
 5005:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5006:       else                 eic = 0.0;
 5007: 
 5008:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5009:       const double r_eth = ramp*nodeBnd->eth;
 5010:       double r_eta1_bar = 0.0;
 5011: 
 5012: 
 5013:       // Compute tide elevation
 5014:       if (iettype == 3 || iettype == 5) {   
 5015: 
 5016:          if constexpr(iloadtide==1) { // loading tide
 5017:             assert(false && "Loading tide not implemented");
 5018:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5019:          }
 5020:          
 5021:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5022: 
 5023:             const double efa  = nodeBnd->efa[jfr]; 
 5024:             const double emo  = nodeBnd->emo[jfr]; 
 5025: 
 5026:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5027:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5028:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5029: 
 5030:          } // for jfr
 5031: 
 5032:       } // if iettype
 5033: 
 5034:       switch (iettype) {
 5035:          case 1:
 5036:          case 2:
 5037:          case 4:
 5038:             nodeBnd->elbc = r_eic + r_eth;
 5039:             break;
 5040:          case 3:
 5041:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5042:             break;
 5043:          case 5:
 5044:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5045:             break;
 5046:       } // switch
 5047: 
 5048: 
 5049:       //Add inverse barometric effects
 5050:       if (iettype != 0 && inv_atm_bnd == 1) {
 5051:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5052:       }
 5053: 
 5054:    }
 5055: 
 5056: 
 5057:    __global__ void computeHorizontalViscosity(void) { 
 5058: 
 5059:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5060: 
 5061:       SIDE(side);
 5062: 
 5063:       if (side->isDry) return;
 5064: 
 5065:       for (int k = 0; k < nvrt; k++) {
 5066:          side->nuGradU[k] = {0.0, 0.0};
 5067:       }
 5068: 
 5069:       if constexpr(ihorcon == 1) {
 5070:          for (int k = side->kb; k < nvrt - 1; k++) {
 5071:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5072:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5073:             // By Zhang and Baptista.
 5074: 
 5075:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5076:             // This is a standard discretization of the Laplacian operator.
 5077:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5078:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5079:             // Gamma is hvis_coef0 in the code.
 5080:             // The value of gamma needs to be < 0.5.
 5081: 
 5082:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5083:             // side under consideration in each of the two possible elements that share the side.
 5084:             Vector2 sumU = {0.0, 0.0};
 5085:             for (int l = 0; l < 2; l++) {
 5086:                const Element *elem = side->elems[l];
 5087: 
 5088:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5089: 
 5090:                // Find the local index of the side in the element
 5091:                const int idxSide = elem->sideLocalIdx(side);
 5092: 
 5093:                // Find the two sides that are connected to the side under consideration
 5094:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5095:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5096: 
 5097:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5098: 
 5099:             }
 5100: 
 5101:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5102: 
 5103:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5104:    
 5105:          }
 5106:       }
 5107:       else if constexpr(ihorcon == 2) {
 5108:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5109:       }
 5110: 
 5111: 
 5112:    }
 5113: 
 5114: 
 5115:    __global__ void setEssentialBC(void) {
 5116:       // Set essential boundary conditions 
 5117:       NODE(node); // Each boundary node
 5118:       NodeBoundary *nodeBnd = node->nodeBnd;
 5119:       
 5120:  
 5121:       // Check if this node has essential BC
 5122:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5123:          // Verify BC value is valid
 5124:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5125: 
 5126:        
 5127:          // Set diagonal to 1 and zero off-diagonals
 5128:          node->coeffDiag = 1.0;
 5129: 
 5130:          for (int j = 0; j < node->numNodes; j++) {
 5131:                node->coeffMatrix[j] = 0.0;
 5132:          }
 5133:          
 5134:          // Set solution and RHS to BC value
 5135:          node->mX  = nodeBnd->elbc;
 5136:          node->qel = nodeBnd->elbc;
 5137: 
 5138:       } else {
 5139:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5140: 
 5141:          for (int j = 0; j < node->numNodes; j++) {
 5142:                Node* nbNode = node->nodes[j];
 5143:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5144:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5145:                   // Verify neighbor's BC value
 5146:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5147: 
 5148:                   // Subtract contribution to RHS
 5149:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5150:                   node->coeffMatrix[j] = 0.0;  
 5151:                }
 5152:          }
 5153:       }
 5154:    }
 5155: 
 5156: 
 5157:    __global__ void updateElevation(void) {
 5158:       NODE(node);
 5159: 
 5160: 
 5161:       node->eta2 = node->mX;
 5162: 
 5163:       node->updateZCoordData();
 5164:    }
