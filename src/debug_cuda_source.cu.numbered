 2002: 
 2003:    template<typename T>
 2004:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2005:       T values[4];
 2006:       getNodalValues(level, func, values);
 2007: 
 2008:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2009:       if constexpr (IsVector2<T>::value && ics == 2) {
 2010: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2011:          projectNodeVectorsToElementFrame(values);
 2012: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2013:       }
 2014: 
 2015:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2016:    }
 2017: 
 2018:    template<typename T>
 2019:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2020:       T values[4];
 2021:       getNodalValues(field, values);
 2022: 
 2023:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2024:       if constexpr (IsVector2<T>::value && ics == 2) {
 2025: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2026:          projectNodeVectorsToElementFrame(values);
 2027: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2028:       }
 2029:       
 2030:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2031:    }
 2032: 
 2033: 
 2034:    template<typename T>
 2035:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2036:       T values[4];
 2037:       getNodalValues(level, field, values);
 2038:       
 2039:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2040:       if constexpr (IsVector2<T>::value && ics == 2) {
 2041: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2042:          projectNodeVectorsToElementFrame(values);
 2043: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2044:       }
 2045: 
 2046:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2047:    }
