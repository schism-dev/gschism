 8185: #ifdef OLD_PCG_SOLVER
 8186: __global__ void computeMatrixProductAndDotProducts() {
 8187:    // Computes A*p, r'Mr and p'Ap
 8188: 
 8189:    // 1) shared buffer: first half for rMr, second for pAp
 8190:    __shared__ double sdata[2*BLOCK_SIZE];
 8191:    double* s_rMr = sdata;
 8192:    double* s_pAp = sdata + BLOCK_SIZE;
 8193: 
 8194:    const int tid = threadIdx.x;
 8195: 
 8196:    double l_pAp = 0.0;
 8197: 
 8198:    s_rMr[tid] = 0.0;
 8199:    s_pAp[tid] = 0.0;
 8200: 
 8201:    // 2) get your node pointer
 8202:    // NODE(node);   
 8203:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8204:    Node *node = &(mesh->localNodeData[idx_node]); 
 8205:       if (idx_node < mesh->np) {
 8206: 
 8207:       const double diag = node->coeffDiag;
 8208:       const double r    = node->mR;
 8209:       const double p    = node->mP;  
 8210: 
 8211:       // apply preconditioner on the fly:
 8212:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8213: 
 8214:       // 4) compute Ap = A.p
 8215:       double Ap = node->coeffDiag * node->mP;
 8216:       for (int j = 0; j < node->numNodes; ++j) {
 8217:          const Node *nbNode = node->nodes[j];
 8218:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8219: 
 8220:       }
 8221: 
 8222:       node->mAp = Ap;
 8223:       
 8224: 
 8225:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8226:       // const double l_rMr = r*Mr;  // r'Mr
 8227:       l_pAp = p*Ap;  // p'Ap
 8228: 
 8229: 
 8230:    }
 8231: 
 8232:    // 6) write into shared mem
 8233:    // s_rMr[tid] = l_rMr;
 8234:    s_pAp[tid] = l_pAp;
 8235: 
 8236:    __syncthreads();
 8237: 
 8238:    // 7) block-wide tree reduction
 8239:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8240:       if (tid < stride)  {
 8241:          s_pAp[tid] += s_pAp[tid + stride];
 8242:       }
 8243:       __syncthreads();
 8244:    }
 8245: 
 8246:    // 8) thread 0 atomically accumulates into the globals
 8247:    // XXX: This is slower than it needs to be, but it is simple and works
 8248:    if (tid == 0) {
 8249:       atomicAdd(pAp, s_pAp[0]);
 8250:    }
 8251: 
 8252: 
 8253: }
 8254: 
 8255: 
 8256: __global__ void updateSolutionAndDotProducts(void) {
 8257:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8258: 
 8259:    const int tid = threadIdx.x;
 8260: 
 8261:    s_rMr[tid] = 0.0;
 8262: 
 8263:    // get node & bounds-check:
 8264:    NODE(node);
 8265: 
 8266:    
 8267:    // Compute alpha
 8268:    const double alpha = (*rMr_old)/(*pAp); 
 8269: 
 8270: 
 8271:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8272: 
 8273: 
 8274:    // load scalars
 8275:    const double diag = node->coeffDiag;
 8276:    const double p    = node->mP;
 8277:    const double Ap   = node->mAp;
 8278:    const double x    = node->mX;
 8279:    const double r    = node->mR;
 8280:    
 8281:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8282: 
 8283:    // 1) update solution & residual
 8284:    const double x_new = x + alpha*p;
 8285:    const double r_new = r - alpha*Ap;
 8286:    node->mX = x_new;
 8287:    node->mR = r_new;
 8288: 
 8289:    // 2) apply Jacobi preconditioner on the fly
 8290:    const double Mr_new = r_new/diag;
 8291: 
 8292: 
 8293:    // 3) local contributions for the two dot-products
 8294:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8295: 
 8296:    // 4) write into shared-mem
 8297:    s_rMr[tid] = l_rMr;
 8298: 
 8299:    __syncthreads();
 8300: 
 8301: 
 8302:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8303:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8304:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8305:       __syncthreads();
 8306:    }
 8307: 
 8308:    // 6) thread 0 atomically folds into the global accumulators
 8309:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8310: 
 8311: 
 8312: }
 8313: 
 8314: 
 8315: __global__ void updateSearchDirection() {
 8316: 
 8317:     NODE(node);
 8318: 
 8319:     // recompute z on-the-fly
 8320:     const double z = node->mR / node->coeffDiag;
 8321:     const double p = node->mP;
 8322: 
 8323:     const double beta = (*rMr_new)/(*rMr_old);
 8324: 
 8325: 
 8326:     // p =z + beta*p
 8327:     node->mP = z + beta*p;
 8328: 
 8329: }
 8330: 
 8331: __global__ void initializeScalars(double *scalars) {
 8332: 
 8333:    // These point to a cupy array in the host code
 8334:    rMr_old = scalars + 0;
 8335:    rMr_new = scalars + 1;
 8336:    pAp     = scalars + 2;
 8337: }
 8338: 
 8339: __global__ void initializePreconditionedResidual(void) {
 8340: 
 8341:     __shared__ double s_rMr[BLOCK_SIZE];  
 8342: 
 8343:     s_rMr[threadIdx.x] = 0.0;
 8344: 
 8345:     NODE_ALL(node, valid);
 8346:     const int tid = threadIdx.x;
 8347:     // For the first iteration:
 8348:     // 1. Initial solution x = 0 (already set)
 8349:     // 2. Initial residual r = b (stored in qel)
 8350:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8351: 
 8352: // XXX we should use the guess solution here    
 8353: 
 8354:     double l_rMr = 0.0;
 8355:     if (valid) {
 8356:       // Set initial residual r = b (from qel)
 8357:       node->mR = node->qel;
 8358: 
 8359:       // Compute z = M^-1 * r (preconditioned residual)
 8360:       const double z = node->mR / node->coeffDiag;
 8361: 
 8362:       // Set initial search direction p = z
 8363:       node->mP = z;
 8364: 
 8365:       // Initialize other variables needed for CG
 8366:       node->mX = 0.0;  // Initial solution
 8367:       node->mAp = 0.0; // Will be computed in first iteration
 8368: 
 8369: 
 8370:       // Computes the first r'Mr (reduction)
 8371:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8372:     }
 8373:     // 4) write into shared-mem
 8374:     s_rMr[tid] = l_rMr;
 8375: 
 8376:     __syncthreads();
 8377: 
 8378: 
 8379:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8380:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8381:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8382:         __syncthreads();
 8383:     }
 8384: 
 8385:     // 6) thread 0 atomically folds into the global accumulators
 8386:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8387: 
 8388:     *rMr_old = 0.0;
 8389:     *pAp = 0.0;
 8390: }
 8391: #endif
 8392: 
 8393: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8394: 
 8395:    ELEM(elem);
 8396: 
 8397:    switch (varCode) {
 8398:       case (int)VarCode::outputCoords:
 8399:          const Point2 coords = elem->outputCoords();
 8400:          res[elem->idx*2    ] = coords.x;
 8401:          res[elem->idx*2 + 1] = coords.y;
 8402:          break;
 8403:    }
 8404: }
