 2563: 
 2564: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2565: 
 2566: 
 2567: __device__ void Node::updateKb(void) {
 2568: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2569: 
 2570:    if constexpr(ivcor == 1) return;
 2571: 
 2572: 
 2573:    // Check if node is wet
 2574:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2575: 
 2576:    if (isDry) return;
 2577: 
 2578:    if constexpr(ivcor == 2) {  // SZ coordinates
 2579:       
 2580:       // Compute bottom level index
 2581:       if (depth <= mesh->h_s) {
 2582:          kb = mesh->kz - 1;
 2583:       } else {
 2584:          kb = -1;
 2585:          int L = 0;
 2586:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2587:          
 2588:          while (L <= R) {
 2589:             int M = (R + L) / 2;
 2590: 
 2591:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2592:             
 2593:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2594:                R = M;
 2595:             } else {
 2596:                L = M;
 2597:             }
 2598: 
 2599:             if (R - L == 1) {
 2600:                kb = L;
 2601:                break;
 2602:             }
 2603:          }
 2604:       }
 2605:    } 
 2606: }
 2607: 
 2608: 
 2609: __device__ double Node::compZCoord(int k) const {
 2610:    // Computes the z coordinate at level k.
 2611:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2612:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2613:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2614:    // used 
 2615:    
 2616:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2617:       
 2618:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2619: 
 2620:    if constexpr(ivcor == 2) {
 2621: 
 2622:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2623:       const int kz = mesh->kz;
 2624:       const double h_c = mesh->h_c;
 2625:       const double theta_f = mesh->theta_f;
 2626:       const double sinh_theta_f = mesh->sinh_theta_f;
 2627: 
 2628:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2629:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2630:       // once per time step/node.
 2631:       // CHECK: updateZCoordData
 2632: 
 2633:       if      (k == nvrt-1)      { return eta2; }
 2634:       else if (k == kz)          return -hmod2;
 2635:       else if (k == kb)          return -depth;
 2636:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2637:       else if (k > kz) {
 2638:          const int ksig = k - kz + 1;
 2639: 
 2640:          if (hmod2 <= h_c) {
 2641:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2642:          } 
 2643:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2644:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2645:             assert(false && "ZCOOR: invalid h_c\n");
 2646:          } 
 2647:          else {
 2648:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2649:                          h_c * mesh->sigma[ksig] + 
 2650:                          (hmod2 - h_c) * mesh->cs[ksig];
 2651:          }
 2652:       } else { 
 2653:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2654:       }
 2655: 
 2656:    }
 2657:    else if constexpr(ivcor == 1) {
 2658:       if (k == kb) return -depth;
 2659:       else if (k == nvrt-1) return eta2;
 2660:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2661:    }
 2662:    
 2663:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2664:    return 0.0;
 2665: }
 2666: 
 2667: 
 2668: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2669:                 double *node_coords, double *wind_rotate_angle, 
 2670:                 int *isdel, int *isidenode, int *isbnd,
 2671:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2672:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2673:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2674:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2675:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2676:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2677:                 double *emo, double *efa, 
 2678:                 double *umo, double *ufa, 
 2679:                 double *vmo, double *vfa) {
 2680: 
 2681:    printf("Populating mesh for partition %d\n", partNum);
 2682: 
 2683:    // Horizontal grid
 2684:    printf("Processing %d nodes\n", np);    
 2685: 
 2686: 
 2687:    int idxNodeBoundary = 0;  
 2688:    for (int i = 0; i < np; i++)
 2689:    {
 2690:       Node &node = localNodeData[i];
 2691: 
 2692:       node.idx = i;
 2693: 
 2694:       const int idxNodeStart = nodeNeighNodesStart[i];
 2695:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2696:       node.numNodes = idxNodeEnd - idxNodeStart;
 2697:       node.nodes = nodeNeighNodes + idxNodeStart;
 2698:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2699: 
 2700: 
 2701: 
 2702:       const int idxElemStart = nodeNeighElemsStart[i];
 2703:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2704:       node.numElements = idxElemEnd - idxElemStart;
 2705:       node.elements = nodeNeighElems + idxElemStart;
 2706: 
 2707: 
 2708:       
 2709:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2710:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2711:          const int partNode = localNodePart[idxNodeGlobal]; 
 2712:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2713: 
 2714: 
 2715:          Node *node_ptr = nodes[partNode] + idxNode;
 2716:          
 2717:          nodeNeighNodes[idx] = node_ptr;
 2718:       }
 2719: 
 2720:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2721:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2722:          const int partElem = localElemPart[idxElemGlobal];
 2723:          const int idxElem  = localElemIndices[idxElemGlobal];
 2724: 
 2725:          Element *elem_ptr = elems[partElem] + idxElem;
 2726: 
 2727:          nodeNeighElems[idx] = elem_ptr;
 2728:       }      
 2729: 
 2730: 
 2731:       node.wind_angle = wind_rotate_angle[i];
 2732: 
 2733:       // Element **elements; // pointer to the elements connected to this node
 2734:       // int numElements;   // number of elements shared by this node
 2735: 
 2736:       node.p.x   = node_coords[i * 3];
 2737:       node.p.y   = node_coords[i * 3 + 1];
 2738:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2739:       node.depth = node_coords[i * 3 + 2];
 2740: 
 2741:       node.numSides = 0;
 2742: 
 2743:       // Links the node to the boundary information
 2744:       if (isbnd[i] >= 0) {
 2745:        
 2746:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2747:          node.nodeBnd->node = &node;
 2748: 
 2749: 
 2750:          if (isbnd[i]>0) {
 2751: 
 2752:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2753:             node.nodeBnd->segment->ifltype = isbnd[i];
 2754: 
 2755:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2756:             node.nodeBnd->segment->clen  = nan("1");
 2757:             node.nodeBnd->segment->carea = nan("1");
 2758: 
 2759:          }
 2760:          else {
 2761:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2762:          }
 2763:          
 2764:          idxNodeBoundary++;
 2765:       }
 2766:       else {
 2767:          node.nodeBnd = nullptr;
 2768:       }
 2769: 
 2770:       // XXXX GAUSSIAN HILL VELOCITIES
 2771: #ifdef GAUSSIAN_HILL_VELOCITIES
 2772:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2773:          constexpr double rot_per = 3000.0;
 2774:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2775:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2776:       // XXXXX
 2777: #endif
 2778:    }
 2779: 
 2780:    nbp = idxNodeBoundary;
 2781: 
 2782:    printf("Processing %d sides\n", ns);
 2783:    int idxSideBoundary = 0;
 2784:    for (int i = 0; i < ns; i++)
 2785:    {
 2786:       Side &side = localSideData[i];
 2787:       side.idx = i;
 2788:       // finding the pointer to the nodes that form the side
 2789:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2790:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2791: 
 2792:       const int locidx_n1 = localNodeIndices[idx_n1];
 2793:       const int locidx_n2 = localNodeIndices[idx_n2];
 2794:       const int part_n1 =   localNodePart[idx_n1];
 2795:       const int part_n2 =   localNodePart[idx_n2];
 2796: 
 2797:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2798:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2799: 
 2800:       // Counts the number of sides connected to each node
 2801:       side.n1->numSides++;
 2802:       side.n2->numSides++;
 2803: 
 2804:       // Normal, unitary vector to the side
 2805:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2806:       side.n = normalize(side.n);
 2807: 
 2808:       // Side boundary type
 2809:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2810:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2811:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2812:       
 2813:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2814:       {
 2815:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2816:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2817:          else                  side.sideBnd->segment = n2bnd->segment;
 2818:          side.sideBnd->side = &side;
 2819:          idxSideBoundary++;
 2820:       }
 2821:       else side.sideBnd = nullptr;
 2822: 
 2823:       nbs = idxSideBoundary;
 2824: 
 2825:       // finding the pointer to the elements that share the side
 2826:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2827:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2828: 
 2829:       if (idx_e1 > -1) {
 2830:          const int locidx_e1 = localElemIndices[idx_e1];
 2831:          const int part_e1 =  localElemPart[idx_e1];
 2832:          side.elems[0] = elems[part_e1] + locidx_e1;
 2833: 
 2834:       }
 2835:       else {
 2836:          side.elems[0] = nullptr;
 2837:       }
 2838: 
 2839:       if (idx_e2 > -1) {
 2840:          const int locidx_e2 = localElemIndices[idx_e2];
 2841:          const int part_e2 =  localElemPart[idx_e2];
 2842:          side.elems[1] = elems[part_e2] + locidx_e2;
 2843:       }
 2844:       else {
 2845:          side.elems[1] = nullptr;
 2846:       }
 2847: 
 2848: 
 2849: 
 2850:       // Compute the center of the side
 2851:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2852: 
 2853: #ifdef GAUSSIAN_HILL_VELOCITIES
 2854: // XXXX
 2855: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2856: constexpr double rot_per=3000.0;
 2857: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2858: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2859: // XXXXX      
 2860: #endif
 2861:       // Compute the z level at the center of the side
 2862:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2863: 
 2864:       // Compute the length of the side
 2865:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2866:       side.len = sqrt(dot(vLen, vLen));
 2867: 
 2868:    }
 2869: 
 2870:    printf("Processing %d elements\n", ne);
 2871:    for (int i = 0; i < ne; i++)
 2872:    {
 2873:       Element &elem = localElemData[i];
 2874:       elem.idx = i;
 2875:       for (int j = 0; j < i34[i]; j++) {
 2876:          const int idxNode = elnode[i*4 + j];  
 2877:          const int idxSide = elside[i*4 + j];
 2878:          
 2879:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2880:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2881: 
 2882: 
 2883: 
 2884:          // Find the neighboring element  
 2885:          if (elem.sides[j]->elems[0] == &elem) {
 2886:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2887:          }
 2888:          else {
 2889:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2890:          }
 2891:          
 2892:       }
 2893: 
 2894:       elem.i34 = i34[i];
 2895: 
 2896: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2897: 
 2898:       // Compute the centroid of the element and its depth
 2899:       Vector2 center = {0.0, 0.0};
 2900:       elem.depth = 0.0;
 2901:       for (int j = 0; j < i34[i]; j++) {
 2902:          center += elem.nodes[j]->p2()/i34[i];
 2903:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2904:       }
 2905:       elem.center.x = center.x;
 2906:       elem.center.y = center.y;
 2907: 
 2908:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2909:       
 2910:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2911:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2912: 
 2913:       elem.area = elem.computeSignedArea(); 
 2914:       elem.radius = sqrt(elem.area)/pi; 
 2915:       
 2916:       // Determines which way the normal vector to each side is oriented.
 2917:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2918:       for (int j = 0; j < i34[i]; j++)  
 2919:       {
 2920:          if (elem.sides[j]->elems[0] == &elem) {
 2921:             elem.ssign[j] =  1.0;
 2922:          }
 2923:          else {
 2924:             elem.ssign[j] = -1.0;
 2925:          }
 2926: 
 2927:       }
 2928: 
 2929:       // Derivatives of shape functions
 2930:       //  For ics=2, this is done inside element/ll frame XXX
 2931:       //  For quads, the derivative is evaluated at centroid
 2932:       const int i34 = elem.i34;
 2933:       for (int j = 0; j < i34; j++) {
 2934:          const double area = elem.area;
 2935:          const int id2 = elem.nxq(1 + j);
 2936:          const int id3 = elem.nxq(2 + j);
 2937:          const int id4 = elem.nxq(3 + j);
 2938:          if (elem.isTri()) {
 2939:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2940:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2941:             // da1/dx = (y1 - y2)/(2*area)
 2942:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2943:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2944:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2945:          }
 2946:          else  { // Quad; evaluate at centroid
 2947:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2948:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2949:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2950:          } // if Tri
 2951: 
 2952:       } // for j
 2953: 
 2954:    }
 2955: 
 2956: 
 2957:    // Processing the boundary nodes
 2958:    int idx = 0;
 2959:    for (int iseg = 0; iseg < nope; iseg++) {
 2960:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2961: 
 2962:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2963: 
 2964:          nodeBnd->isEssentialBC = true;
 2965: nodeBnd->iettype = 3; // XXXXXXXXX
 2966:          nodeBnd->elbc = 0.0;
 2967: 
 2968:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2969:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2970:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2971:             nodeBnd->umo[jfr] = {umo[jfr + iseg*nbfr], vmo[jfr + iseg*nbfr]};
 2972:             nodeBnd->ufa[jfr] = {ufa[jfr + iseg*nbfr], vfa[jfr + iseg*nbfr]};
 2973: 
 2974:          }
 2975: 
 2976:          idx++;
 2977:       }
 2978: 
 2979:    }
 2980: 
 2981: }
 2982: 
 2983: 
 2984: 
 2985: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 2986:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 2987:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 2988:    // 
 2989:    // This kernel is called for all nodes.
 2990: 
 2991: 
 2992:    NODE(node1);
 2993: 
 2994: 
 2995:    node1->clearMatrixRow();
 2996:    node1->qel = 0.0;
 2997: 
 2998:    // THIS IS FOR STRUCTURES XXX
 2999:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3000: 
 3001:    
 3002:    for (int j=0; j<node1->numElements; j++) {
 3003:       // For each element connected to the node...
 3004: 
 3005:       Element *elem = node1->elements[j];
 3006: 
 3007:       // Compute the average gravity
 3008:       const double grav3 = elem->mean(&Node::grav2);
 3009: 
 3010:       // Look at the documentation for the description of the terms in the following integrals
 3011: 
 3012:       // Integral I_1 
 3013:       // \bar{\breve{H}} 
 3014:       const double hhatb = elem->mean(&Side::hhat);        
 3015: 
 3016: 
 3017:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3018: 
 3019:       const int id1 = elem->nodeLocalIdx(node1); 
 3020:       const double area = elem->area;
 3021: 
 3022:       if (elem->isTri()) {
 3023: 
 3024:          // To clarify the notation in this section: 
 3025:          //   i stands for the node under consideration (node1)
 3026:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3027:          const int id2 = elem->nxq(1 + id1);
 3028:          const int id3 = elem->nxq(2 + id1);
 3029:          Node *node2 = elem->nodes[id2];
 3030:          Node *node3 = elem->nodes[id3];
 3031: 
 3032:          const Point2 x1 = node1->p2();
 3033:          const Point2 x2 = node2->p2();
 3034:          const Point2 x3 = node3->p2();
 3035: 
 3036:          // integral of phi_i*phi_j
 3037:          const double ipp_ii = (1.0/6.0 )*area;
 3038:          const double ipp_ij = (1.0/12.0)*area;
 3039:          const double ipp_ik = (1.0/12.0)*area;
 3040: 
 3041:          // integral of [(grad phi_i) * (grad phi_j)]
 3042:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3043:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3044:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3045: 
 3046:          // Computes the different components of integral I_1 of each node with respect to node i.
 3047:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3048:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3049:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3050: 
 3051: if (j==node1->numElements-1) {
 3052: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3053: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3054: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3055: }
 3056: 
 3057:          node1->addToSparseMatrix(node1, I1_ii);
 3058:          node1->addToSparseMatrix(node2, I1_ij); 
 3059:          node1->addToSparseMatrix(node3, I1_ik);
 3060: 
 3061: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3062:      
 3063:       }
 3064:       else { // Quad
 3065:          // XXX IMPLEMENT THIS
 3066:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3067:       } 
 3068: 
 3069:  
 3070:       // Integral I_4
 3071:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3072:       // Where
 3073:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3074: 
 3075:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3076:       // of U over the element.
 3077:       Vector2 Umean = {0.0, 0.0};
 3078:       for (int m=0; m<elem->i34; m++) {      
 3079:          const Side *side = elem->sides[m];
 3080: 
 3081:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3082:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3083:       }
 3084:       Umean = Umean/elem->i34;
 3085: 
 3086:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3087: 
 3088:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3089:       const double I_4_1 = dot(gradPhi_1, Umean);
 3090: 
 3091:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3092:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3093:      
 3094:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3095: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3096: 
 3097:       // Additional terms 
 3098:       double vnorm = 0.0;
 3099:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3100:          Vector3 ubed;
 3101:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3102: 
 3103:          Vector3 gradP = {0.0, 0.0, 1.0};
 3104:          for (int m=0; m < elem->i34; m++) {
 3105:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3106:            gradP += toVector3(gradP_2D, 0.0);
 3107:          }   
 3108:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3109:       } // imm==2
 3110: 
 3111:       if (elem->isTri()) {
 3112:          for (int l=0; l<3; l++) {
 3113:            double fac;
 3114: 
 3115:            Node *node = elem->nodes[l];
 3116: 
 3117:            (node == node1)? fac=2.0 : fac=1.0;
 3118: 
 3119:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3120:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3121:            
 3122:          }
 3123: 
 3124: 
 3125:          if (!elem->isDry) {
 3126:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3127: 
 3128:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3129:          }
 3130: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3131: 
 3132:       } // isTri
 3133:       else { // isQuad
 3134:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3135:          // for (int l=0; l<4; l++) {
 3136:          //   const Node *node = elem->nodes[l];
 3137: 
 3138:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3139:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3140: 
 3141:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3142:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3143:          // }
 3144: 
 3145:       } // isQuad
 3146: 
 3147: 
 3148:       node1->qel += (dt/elem->i34)*elem->vsource;
 3149:       
 3150: 
 3151:    } // for all elements connected to the node
 3152:    
 3153: 
 3154: 
 3155:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3156:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3157:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3158:    if (nodeBnd != nullptr)  { 
 3159:       // If it is an open boundary node...
 3160: 
 3161:       // At least one open bnd side, maybe two
 3162:       for (int l=0; l<2; l++) { 
 3163: 
 3164:          // Gets each of the sides sharing the node. 
 3165:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3166: 
 3167:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3168: 
 3169:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3170: 
 3171:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3172:          if (sideBnd != nullptr) {
 3173:             // If the side is on a boundary...
 3174: 
 3175:             // Get the boundary segment
 3176:             const BoundarySegment *sideSegment = sideBnd->segment;
 3177:             const Side *side = sideBnd->side;
 3178: 
 3179:             // Integral I_3
 3180:             if (sideSegment->ifltype != 0) {
 3181:             // Natural or Flather b.c.
 3182: 
 3183:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3184:                // especially for Flather b.c.
 3185:                double ri3 = 0.0;
 3186:                if (!side->isDry) {
 3187:                   // If the side is not dry
 3188:                   
 3189:                   // Computes the side flux of (uth, vth)
 3190:                   double Vn = 0.0;
 3191:                   for (int k = side->kb; k<nvrt-1; k++) {
 3192:                      // uth, vth in lat/lon frame if ics=2
 3193:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3194:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3195:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3196: 
 3197:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3198:                   }
 3199: 
 3200:                   ri3 = 0.5*side->len*Vn;
 3201:                }
 3202: 
 3203:                if (sideSegment->ifltype == -1) { // Flather 1
 3204: 
 3205:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3206:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3207: 
 3208:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3209:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3210:                   
 3211:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3212:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3213: 
 3214:                } 
 3215:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3216:                   // Reset ri3
 3217:                   ri3 = 0.0;
 3218: 
 3219:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3220: 
 3221:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3222: 
 3223:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3224:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3225: 
 3226:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3227:                   node1->addToSparseMatrix(node1, con0*2.0);
 3228:                   node1->addToSparseMatrix(node2, con0);
 3229: 
 3230:                } // if Flather or Discharge
 3231: 
 3232:                node1->qel -= thetai*dt*ri3;
 3233: 
 3234:             } // I_3
 3235:           
 3236: 
 3237:             // Integral I_5
 3238:             if(!side->isDry) {
 3239: 
 3240:                const double Unbar = dot(side->U, side->n);
 3241: 
 3242:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3243:                
 3244:             } // I_5
 3245: 
 3246:          } // if is boundary side
 3247: 
 3248:       } // for l
 3249: 
 3250:    } // if isbnd
 3251: 
 3252: 
 3253:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3254: 
 3255: }
 3256: 
