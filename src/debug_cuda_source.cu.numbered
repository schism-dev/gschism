 8187: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8188:    // Get the value of a variable from an element
 8189:    // varName is the name of the variable to get
 8190:    // var is the array to store the value
 8191:    // k is the vertical level index of the variable to get
 8192: 
 8193:    ELEM(elem);
 8194:    
 8195:    int idx = elem->idx;
 8196:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8197: 
 8198:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8199:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8200:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8201:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8202:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8203:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8204:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8205:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8206:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8207:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8208:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8209:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8210:       
 8211:    
 8212: }
 8213: 
 8214: 
 8215: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8216:    // Get the value of a variable from an node
 8217:    // varName is the name of the variable to get
 8218:    // var is the array to store the value
 8219:    // k is the vertical level index of the variable to get
 8220: 
 8221:    NODE(node);
 8222:    
 8223:    int idx = node->idx;
 8224:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8225: 
 8226:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8227:    
 8228:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8229:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8230:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8231:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8232:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8233:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8234:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8235:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8236:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8237:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8238:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8239:    
 8240:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8241:       
 8242:    
 8243: }
 8244: 
 8245: 
 8246: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8247:    // Get the value of a variable from an side
 8248:    // varName is the name of the variable to get
 8249:    // var is the array to store the value
 8250:    // k is the vertical level index of the variable to get
 8251:    SIDE(side);
 8252:    
 8253:    int idx = side->idx;
 8254:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8255: 
 8256:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8257:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8258:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8259:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8260:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8261:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8262:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8263:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8264:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8265:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8266:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8267:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8268:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8269:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8270:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8271:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8272:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8273:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8274:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8275:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8276:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8277:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8278:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8279:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8280:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8281:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8282:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8283:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8284:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8285:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8286:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8287:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8288:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8289:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8290:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8291:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8292: }
 8293: 
 8294: 
 8295: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8296:    // Get the value of a variable from an side
 8297:    // varName is the name of the variable to get
 8298:    // var is the array to store the value
 8299:    // k is the vertical level index of the variable to get
 8300:    SIDE_BND(sideBnd);   
 8301: 
 8302:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8303:    if (sideBnd->segment->isLand) idx = -7;
 8304: 
 8305:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8306:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8307: 
 8308: }
