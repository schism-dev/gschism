 2525: 
 2526: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2527:    // Returns the value of the velocity at the side center
 2528:    const double w1 = getBoundaryArrayValueWeight();
 2529:    const double w2 = 1.0 - w1;
 2530:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2531:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2532: 
 2533:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2534: }
 2535: 
 2536: 
 2537: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2538:    // Returns the value of the normal component of the velocity at the side center
 2539:    const double w1 = getBoundaryArrayValueWeight();
 2540:    const double w2 = 1.0 - w1;
 2541:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2542:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2543: 
 2544:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2545: }
