 4535: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4536:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4537:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4538:                 int *isdel, int *isidenode, int *isbnd,
 4539:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4540:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4541:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4542:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4543:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4544:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4545:                 double *drag, double *roughness,
 4546:                 double *emo, double *efa, 
 4547:                 double *umo, double *ufa, 
 4548:                 double *vmo, double *vfa) {
 4549: 
 4550:    printf("Populating mesh for partition %d\n", partNum);
 4551: 
 4552:    // XXXXXX THIS function does almost nothing. 
 4553: 
 4554:    nbs = *sharedIdxSideBoundary + 1;
 4555:    nbp = *sharedIdxNodeBoundary + 1;
 4556: 
 4557:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4558: 
 4559: }
 4560: 
 4561: 
 4562: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4563:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4564:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4565: 
 4566: 
 4567:    NODE(node1);
 4568: 
 4569:    node1->clearMatrixRow();
 4570:    node1->qel = 0.0;
 4571: 
 4572:    // THIS IS FOR STRUCTURES XXX
 4573:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4574: 
 4575:    
 4576:    for (int j=0; j<node1->numElements; j++) {
 4577:       // For each element connected to the node...
 4578: 
 4579:       Element *elem = node1->elements[j];
 4580: 
 4581: 
 4582: 
 4583:       // Compute the average gravity
 4584:       const double grav3 = elem->mean(&Node::grav2);
 4585: 
 4586:       // Look at the documentation for the description of the terms in the following integrals
 4587: 
 4588:       // Integral I_1 
 4589:       // \bar{\breve{H}} 
 4590:       const double hhatb = elem->mean(&Side::hhat);        
 4591: 
 4592:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4593: 
 4594:       const int id1 = elem->nodeLocalIdx(node1); 
 4595:       const double area = elem->area;
 4596: 
 4597:       if (elem->isTri()) {
 4598: 
 4599:          // To clarify the notation in this section: 
 4600:          //   i stands for the node under consideration (node1)
 4601:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4602:          const int id2 = elem->nxq(1 + id1);
 4603:          const int id3 = elem->nxq(2 + id1);
 4604:          Node *node2 = elem->nodes[id2];
 4605:          Node *node3 = elem->nodes[id3];
 4606: 
 4607:          Point2 x1, x2, x3;
 4608:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4609: 
 4610: 
 4611:          // integral of phi_i*phi_j
 4612:          const double ipp_ii = (1.0/6.0 )*area;
 4613:          const double ipp_ij = (1.0/12.0)*area;
 4614:          const double ipp_ik = (1.0/12.0)*area;
 4615: 
 4616:          // integral of [(grad phi_i) * (grad phi_j)]
 4617:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4618:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4619:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4620: 
 4621:          // Computes the different components of integral I_1 of each node with respect to node i.
 4622:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4623:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4624:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4625: 
 4626:          node1->addToSparseMatrix(node1, I1_ii);
 4627:          node1->addToSparseMatrix(node2, I1_ij); 
 4628:          node1->addToSparseMatrix(node3, I1_ik);
 4629: 
 4630:       }
 4631:       else { // Quad
 4632:          // XXX IMPLEMENT THIS
 4633:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4634: 
 4635:          // // To clarify the notation in this section: 
 4636:          // //   i stands for the node under consideration (node1)
 4637:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4638:          // const int id2 = elem->nxq(1 + id1);
 4639:          // const int id3 = elem->nxq(2 + id1);
 4640:          // const int id4 = elem->nxq(3 + id1);
 4641:          // Node *node2 = elem->nodes[id2];
 4642:          // Node *node3 = elem->nodes[id3];
 4643:          // Node *node4 = elem->nodes[id4];         
 4644: 
 4645:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4646:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4647:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4648:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4649:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4650: 
 4651:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4652:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4653:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4654:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4655:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4656: 
 4657:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4658:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4659:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4660:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4661:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4662: 
 4663:          // node1->addToSparseMatrix(node1, I1_ii);
 4664:          // node1->addToSparseMatrix(node2, I1_ij); 
 4665:          // node1->addToSparseMatrix(node3, I1_ik);
 4666:          // node1->addToSparseMatrix(node4, I1_il);
 4667:   
 4668:       } 
 4669: 
 4670:  
 4671:       // Integral I_4
 4672:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4673:       // Where
 4674:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4675: 
 4676:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4677:       // of U over the element.
 4678:       Vector2 U = {0.0, 0.0};
 4679:       for (int m=0; m < elem->i34; m++) {      
 4680:          const Side *side = elem->sides[m];
 4681: 
 4682:          if constexpr(ics == 1) U += side->U; 
 4683:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4684: 
 4685:       }
 4686:       U = U/elem->i34;
 4687: 
 4688: 
 4689:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4690: 
 4691: 
 4692:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4693:       const double I_4_1 = dot(gradPhi_1, U);
 4694: 
 4695: 
 4696:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4697:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4698: 
 4699:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4700: 
 4701:       // Additional terms 
 4702:       double vnorm = 0.0;
 4703:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4704:          Vector3 ubed = {0.0, 0.0, 0.0};
 4705:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4706:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4707: 
 4708:          Vector3 gradP = {0.0, 0.0, 1.0};
 4709:          for (int m=0; m < elem->i34; m++) {
 4710:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4711:            gradP += toVector3(gradP_2D, 0.0);
 4712:          }   
 4713:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4714:       } // imm==2
 4715: 
 4716:       if (elem->isTri()) {
 4717:          for (int l=0; l<3; l++) {
 4718: 
 4719:             Node *node = elem->nodes[l];
 4720: 
 4721:             double fac = (node == node1) ? 2.0 : 1.0;
 4722:    
 4723:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4724:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4725:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4726:            
 4727:          }
 4728: 
 4729: 
 4730:          if (!elem->isDry) {
 4731:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4732: 
 4733:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4734: 
 4735:          }
 4736: 
 4737:       } // isTri
 4738:       else { // isQuad
 4739:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4740:          // for (int l=0; l<4; l++) {
 4741:          //   const Node *node = elem->nodes[l];
 4742: 
 4743:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4744:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4745: 
 4746:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4747:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4748:          // }
 4749: 
 4750:       } // isQuad
 4751: 
 4752: 
 4753:      node1->qel += (dt/elem->i34)*elem->vsource;
 4754:       
 4755: 
 4756:    } // for all elements connected to the node
 4757:    
 4758: 
 4759:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4760:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4761:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4762:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4763:       // If it is an open boundary node...
 4764: 
 4765:       // At least one open bnd side, maybe two
 4766:       for (int l=0; l<2; l++) { 
 4767: 
 4768:          // Gets each of the sides sharing the node. 
 4769:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4770: 
 4771:        
 4772: 
 4773:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4774:          if (sideBnd != nullptr) {
 4775:             // If the side is on a boundary...
 4776: 
 4777:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4778: 
 4779:             // Get the boundary segment
 4780:             const BoundarySegment *sideSegment = sideBnd->segment;
 4781:             const Side *side = sideBnd->side;
 4782: 
 4783:             // Integral I_3
 4784:             if (sideSegment->ifltype != 0) {
 4785:             // Natural or Flather b.c.
 4786: 
 4787:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4788:                // especially for Flather b.c.
 4789:                double ri3 = 0.0;
 4790:                if (!side->isDry) {
 4791:                   // If the side is not dry
 4792:                   
 4793:                   // Computes the side flux of (uth, vth)
 4794:                   double Vn = 0.0;
 4795:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4796:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4797:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4798: 
 4799:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4800:                   }
 4801: 
 4802:                   ri3 = 0.5*side->len*Vn;
 4803:                }
 4804: 
 4805:                if (sideSegment->ifltype == -1) { // Flather 1
 4806: 
 4807:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4808:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4809: 
 4810:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4811:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4812:                   
 4813:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4814:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4815: 
 4816:                } 
 4817:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4818:                   // Reset ri3
 4819:                   ri3 = 0.0;
 4820: 
 4821:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4822:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4823: 
 4824:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4825: 
 4826:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4827:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4828: 
 4829:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4830:                   node1->addToSparseMatrix(node1, con0*2.0);
 4831:                   node1->addToSparseMatrix(node2, con0);
 4832: 
 4833:                } // if Flather or Discharge
 4834: 
 4835:                node1->qel -= thetai*dt*ri3;
 4836: 
 4837: 
 4838:             } // I_3
 4839:           
 4840: 
 4841:             // Integral I_5
 4842:             if(!side->isDry) {
 4843: 
 4844:                const double Unbar = dot(side->U, side->n);
 4845:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4846: 
 4847:             } // I_5
 4848: 
 4849:          } // if is boundary side
 4850: 
 4851:       } // for l
 4852: 
 4853:    } // if isbnd
 4854: 
 4855: 
 4856: }
 4857: 
 4858: 
