 4676:    __global__ void computeFlowBcVelocities(double time) {
 4677: 
 4678:       SIDE_BND(sideBnd);
 4679: 
 4680:       const Side *side = sideBnd->side;
 4681:  
 4682:       const bool isDry = side->isDry;
 4683: 
 4684:    
 4685:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4686: 
 4687:       if (isDry) return;
 4688: 
 4689:       // For wet sides in open boundaries...
 4690:       const Vector2 n = side->n;
 4691:       const BoundarySegment *segment = sideBnd->segment;
 4692: 
 4693:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4694: 
 4695:       const int ifltype = segment->ifltype;
 4696: 
 4697:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4698:       const Vector2 r_nuth0 = r_uth0*n;
 4699: 
 4700: 
 4701:       if (ifltype == 1 || ifltype == 2) {
 4702:       
 4703:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4704: 
 4705:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4706:          
 4707:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4708:          
 4709:       } else if (ifltype == -1) { // Flather 1
 4710: 
 4711:          for (int k = 0; k < nvrt; k++) {
 4712: 
 4713:             // uth is the normal vel.; no ramp up
 4714:             const double uth = sideBnd->nuth(k);
 4715:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4716: 
 4717:             sideBnd->ubc[k] += uth*n;
 4718:          }
 4719: 
 4720:       } else if (ifltype == 3 || ifltype == 5) {
 4721:          // vnth0=0 !normal vel.
 4722: 
 4723:          Vector2 r_u1_bar = {0.0, 0.0};
 4724:          // Computes the contribution to the velocity from all tide frequencies
 4725:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4726: 
 4727:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4728:             const Vector2 umo  = sideBnd->umo(jfr); 
 4729: 
 4730:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4731:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4732:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4733:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4734:          }
 4735: 
 4736:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4737: 
 4738:       } // if (ifltype = 3 || ifltype == 5
 4739: 
 4740: 
 4741: 
 4742:    }
 4743: 
 4744:    __global__ void computeElevationBoundaryConditions(double time) {
 4745:       // Compute elevation essential boundary conditions 
 4746: 
 4747:       NODE_BND(nodeBnd); // Each boundary node.
 4748: 
 4749:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4750: 
 4751:       const Node *node = nodeBnd->node;
 4752:       const BoundarySegment *segment = nodeBnd->segment;
 4753:       const int iettype = segment->iettype;
 4754:       
 4755: 
 4756:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4757:       double eic = 0.0;
 4758:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4759:       else                 eic = 0.0;
 4760: 
 4761:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4762:       const double r_eth = ramp*nodeBnd->eth;
 4763:       double r_eta1_bar = 0.0;
 4764: 
 4765: 
 4766:       // Compute tide elevation
 4767:       if (iettype == 3 || iettype == 5) {   
 4768: 
 4769:          if constexpr(iloadtide==1) { // loading tide
 4770:             assert(false && "Loading tide not implemented");
 4771:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4772:          }
 4773:          
 4774:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4775: 
 4776:             const double efa  = nodeBnd->efa[jfr]; 
 4777:             const double emo  = nodeBnd->emo[jfr]; 
 4778: 
 4779:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4780:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4781:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4782: 
 4783:          } // for jfr
 4784: 
 4785:       } // if iettype
 4786: 
 4787:       switch (iettype) {
 4788:          case 1:
 4789:          case 2:
 4790:          case 4:
 4791:             nodeBnd->elbc = r_eic + r_eth;
 4792:             break;
 4793:          case 3:
 4794:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4795:             break;
 4796:          case 5:
 4797:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4798:             break;
 4799:       } // switch
 4800: 
 4801: 
 4802:       //Add inverse barometric effects
 4803:       if (iettype != 0 && inv_atm_bnd == 1) {
 4804:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4805:       }
 4806: 
 4807:    }
 4808: 
 4809: 
 4810:    __global__ void computeHorizontalViscosity(void) { 
 4811: 
 4812:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4813: 
 4814:       SIDE(side);
 4815: 
 4816:       if (side->isDry) return;
 4817: 
 4818:       for (int k = 0; k < nvrt; k++) {
 4819:          side->nuGradU[k] = {0.0, 0.0};
 4820:       }
 4821: 
 4822:       if constexpr(ihorcon == 1) {
 4823:          for (int k = side->kb; k < nvrt - 1; k++) {
 4824:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4825:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4826:             // By Zhang and Baptista.
 4827: 
 4828:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4829:             // This is a standard discretization of the Laplacian operator.
 4830:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4831:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4832:             // Gamma is hvis_coef0 in the code.
 4833:             // The value of gamma needs to be < 0.5.
 4834: 
 4835:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4836:             // side under consideration in each of the two possible elements that share the side.
 4837:             Vector2 sumU = {0.0, 0.0};
 4838:             for (int l = 0; l < 2; l++) {
 4839:                const Element *elem = side->elems[l];
 4840: 
 4841:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4842: 
 4843:                // Find the local index of the side in the element
 4844:                const int idxSide = elem->sideLocalIdx(side);
 4845:                // Find the two sides that are connected to the side under consideration
 4846:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4847:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4848: 
 4849:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4850: 
 4851:             }
 4852: 
 4853:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4854:    
 4855:          }
 4856:       }
 4857:       else if constexpr(ihorcon == 2) {
 4858:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4859:       }
 4860: 
 4861: 
 4862:    }
 4863: 
 4864: 
 4865:    __global__ void setEssentialBC(void) {
 4866:       // Set essential boundary conditions 
 4867:       NODE(node); // Each boundary node
 4868:       NodeBoundary *nodeBnd = node->nodeBnd;
 4869:       
 4870: // nodeBnd->isEssentialBC = true;      
 4871:       // Check if this node has essential BC
 4872:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4873:          // Verify BC value is valid
 4874:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4875: 
 4876:        
 4877:          // Set diagonal to 1 and zero off-diagonals
 4878:          node->coeffDiag = 1.0;
 4879: 
 4880:          for (int j = 0; j < node->numNodes; j++) {
 4881:                node->coeffMatrix[j] = 0.0;
 4882:          }
 4883:          
 4884:          // Set solution and RHS to BC value
 4885:          node->mX  = nodeBnd->elbc;
 4886:          node->qel = nodeBnd->elbc;
 4887: // printf("bbbbb\n");
 4888:       } else {
 4889:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4890: // printf("aaaaaa\n");
 4891:          for (int j = 0; j < node->numNodes; j++) {
 4892:                Node* nbNode = node->nodes[j];
 4893:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4894:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4895:                   // Verify neighbor's BC value
 4896:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4897: 
 4898:                   // Subtract contribution to RHS
 4899:                   // node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4900:                   node->coeffMatrix[j] = 0.0;  
 4901:                }
 4902:          }
 4903:       }
 4904:    }
 4905: 
 4906: 
 4907:    __global__ void updateElevation(void) {
 4908:       NODE(node);
 4909: 
 4910:       node->eta2 = node->mX;
 4911: 
 4912:       node->updateZCoordData();
 4913:    }
 4914: 
 4915: 
 4916:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4917: 
 4918:       SIDE(side);
 4919: 
 4920: 
 4921:       side->U = {0.0, 0.0}; 
 4922:          
 4923:       if(side->isDry) return;
 4924: 
 4925:       const Node *node1 = side->n1;
 4926:       const Node *node2 = side->n2;
 4927: 
 4928:       // Vertically integrated velocity U (in ll if ics=2)
 4929:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4930:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4931:       }
 4932: 
 4933:    }
 4934: 
 4935:    __global__ void computeBottomDragVegetation(void) {
 4936:       // UNFINISHED. CHECK THIS:
 4937:       // How many kernels are needed? Why so many for loops?
 4938:       // Is the loop on sides needed?
 4939: 
 4940:       NODE(node);
 4941: 
 4942: 
 4943:       const int    kb      = node->kb;
 4944:       const double htot    = node->htot2(); 
 4945:       const double rough   = node->rough;
 4946: 
 4947:       
 4948:       if (node->isDry) {
 4949:          // Default values for dry nodes
 4950:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4951:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4952: 
 4953:          return;
 4954:        
 4955:       }
 4956: 
 4957:       // Compute bottom drag Cd
 4958:       //--------------------------------
 4959: 
 4960:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4961:       if constexpr(nchi == 1) {
 4962: 
 4963:          bool ltmp = false; // for WBL iteration
 4964: 
 4965:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4966:          // Drag at nodes
 4967:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4968:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4969:         
 4970:          const double rough = node->rough;
 4971:         
 4972:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4973:          if (node->rough == 0.0) {
 4974:             node->Cd = 0.0;
 4975: 
 4976:          } else { //roughness >0 
 4977:           
 4978:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4979:             const double bthick = max(dzb_min, bthick_ori);
 4980: 
 4981:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4982: 
 4983:             double tmp = 1.0/(2.5*log(bthick/rough));
 4984:             node->Cd = tmp*tmp;
 4985: 
 4986:          } // if rough
 4987: 
 4988: 
 4989:          // RECOVER THIS: XXX
 4990:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4991:          // Output warning for WBL if iteration didn't converge
 4992: 
 4993: 
 4994:       } // nchi==1
 4995: 
 4996: 
 4997:       //   Bottom stress in m^2/s^2
 4998:       if (node->rho[kb + 1] >= -98.0)
 4999:       {
 5000:          const double mag_u = length(node->u2[kb + 1]);
 5001:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5002: 
 5003:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5004:          // !sediment erosion: this part needs more documentation
 5005:       }
 5006:     
 5007: 
 5008: 
 5009:       // Compute vegetation parameters
 5010:       //--------------------------------
 5011: 
 5012:       // SAV constants
 5013:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5014:       constexpr double veg_cfpsi = 0.16;
 5015: 
 5016:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5017:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5018: 
 5019:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5020:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5021:          int kbin = 0; // bin index
 5022:          for (int k = kb; k < nvrt; k++) {
 5023:             // Computes node height above the bottom level
 5024:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5025:             assert(false && "Vertical variation of vegetation not implemented");
 5026: 
 5027:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5028:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5029:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5030:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5031:             // } else {
 5032:             //    // Find the bin at which the current vertical level is
 5033:             //    while (kbin<nbins_veg_vert) {
 5034:             //       const double zn = node->z[kbin];
 5035:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5036:             //          break;
 5037:             //       } // if
 5038:             //       kbin++;
 5039:             //    } // while
 5040:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5041: 
 5042:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5043:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5044:                
 5045:             //    // Linear interpolation of the vegetation parameters
 5046:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5047:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5048:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5049:             // } // if rl10
 5050: 
 5051:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5052: 
 5053:          } // for k
 5054: 
 5055: 
 5056:       } else { // Ganthy (iveg==2)
 5057:       //  Modify canopy height, diameter, and density
 5058: 
 5059:          // Make sure there is vegetation on this node
 5060:          if (node->veg_h_unbent > 0.0) {
 5061:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5062: 
 5063:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5064:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5065:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5066: 
 5067:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5068:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5069:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5070:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5071:          } // if veg_h_unbent
 5072: 
 5073:          for (int k = 0; k < nvrt; k++) {
 5074:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5075:          } // for k
 5076:       
 5077: 
 5078:       } // if iveg
 5079:      
 5080: 
 5081:       // Compute vertical mean of veg_alpha3D
 5082:       if (iveg != 0) {
 5083:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5084:          double sum1=0.0;
 5085:          double sum2=0.0;
 5086:          // Integrate over each level under the canopy...
 5087:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5088:             const double Dz = node->Dz(k);
 5089: 
 5090:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5091:             sum2 += Dz;
 5092: 
 5093:          } // for k
 5094:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5095:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5096: 
 5097:       } // if iveg
 5098: 
 5099:    }
 5100: 
 5101:    __global__ void computeVegetationAndDragParameters(void) {
 5102:       // Computes the vegetation and drag model parameters:
 5103:       // chi, \tilde\chi, beta, \breve{H}
 5104:       
 5105:       SIDE(side);
 5106: 
 5107:       if (side->isDry) return;
 5108: 
 5109:       const double htot = side->htot2();
 5110:       const int    kb   = side->kb;
 5111: 
 5112:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5113: 
 5114:       const double veg_h     = side->veg_h();
 5115:       const double veg_nv    = side->veg_nv();
 5116:       const double veg_c     = side->veg_c();
 5117:       const double veg_beta  = side->veg_beta;
 5118:       const double veg_alpha = side->veg_alpha_vert_mean();
 5119: 
 5120:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5121:       // Velocity magnitude at the bottom level
 5122:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5123:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 5124:       side->chi2 = side->Cd()*vmag1;
 5125:       side->chi  = side->chi2;
 5126:       if constexpr(iveg != 0) {
 5127:          const Node *n1 = side->n1;
 5128:          const Node *n2 = side->n2;
 5129:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5130:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5131:       }
 5132: 
 5133:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5134: 
 5135:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5136:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5137:       double magUa = 0.0;
 5138:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5139:          // 3D wet side with veg...
 5140: 
 5141:          double magUa = 0.0;
 5142:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5143:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5144: 
 5145:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5146:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5147:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5148: 
 5149:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5150:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5151: 
 5152:                // Velocity magnitude at the bottom (l) of the level
 5153:                const double ul = length(side->u2[k]);
 5154: 
 5155:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5156:                magUa += Dz*0.5*(uh + ul);
 5157: 
 5158:             } // if HasVegetation
 5159:          } // for k
 5160:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5161: 
 5162:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5163:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5164:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5165:             const double zCpy = side->zTopCanopy();
 5166:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5167:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5168:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5169:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5170:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5171:          } // if isSubmerged
 5172:       } // if iveg   
 5173: 
 5174:       // Computes the friction modified depth, \breve{H} in notes
 5175:       if (side->is2D()) { // 2D
 5176: 
 5177:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5178:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5179: 
 5180:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5181: 
 5182:          side->hhat = htot*htot/fricH; 
 5183: 
 5184:       } else { // 3D
 5185:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5186: 
 5187:          if constexpr(iveg != 0) {
 5188:             
 5189:             if (side->isSubmerged()) { 
 5190:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5191:                side->hhat -= veg_c*Hhat_alpha;
 5192: 
 5193:             } else { // Emergent
 5194:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5195:             }
 5196:          } // if iveg
 5197: 
 5198:          // Enforce positivity for 3D model
 5199:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5200:       } // if 3D
 5201: 
 5202:    }
 5203: 
 5204: 
 5205: 
 5206:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5207:    // Computes the density gradient between two elements, e1 and e2.
 5208:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5209:    // zero in the direction normal to the side. 
 5210:    // 
 5211:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5212:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5213:    //
 5214:    // Input:
 5215:    //    e1: Element
 5216:    //    e2: Neighbor element (or nullptr if boundary)
 5217:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5218:    //    k: Index of the half-level at which the density is interpolated
 5219:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5220:    // 
 5221:    // Output:
 5222:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5223:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5224: 
 5225:       if (e2 == nullptr || e2->isDry) {
 5226:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5227: 
 5228:          Side *side = e1->sides[j];
 5229:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5230:                  
 5231:          if constexpr(ics == 1) {
 5232:             vec = side->n; // Normal vector to the side
 5233:          } else {
 5234:             // IMPLEMENT THIS XXXXXX
 5235:             // !replace with xel, yel?
 5236:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5237:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5238:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5239:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5240:          } //ics
 5241:                    
 5242:          diffRho = 0.0;
 5243: 
 5244:       } else { //internal and wet
 5245:          if constexpr(ics==1) {
 5246:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5247: 
 5248:             // Vector from e1 to e2
 5249:             vec = e2->center - e1->center;
 5250: 
 5251:          } else { 
 5252:             // IMPLEMENT THIS XXXXXX
 5253:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5254:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5255:             //                   alow(j)=xctr2
 5256:             //                   bdia(j)=yctr2
 5257:          } // ics
 5258: 
 5259:          diffRho = rho2 - e1->demeanedDensity(k);
 5260:       }
 5261: 
 5262:    }
 5263: 
 5264:    __global__ void computeDensityCubicSplines(void) {
 5265:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5266: 
 5267:       ELEM(elem);
 5268: 
 5269:       if (elem->isDry) return;
 5270: 
 5271:       const int kb = elem->kb;
 5272: 
 5273:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5274:       if (elem->is2D()) {
 5275:          // In the 2D case, the density is constant at the prism level. 
 5276:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5277:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5278:       } else { //3D
 5279: 
 5280:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5281:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5282:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5283:          ///// XXXX CHECK INDICES!!!!!
 5284:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5285:       } // 2D/3D
 5286: 
 5287:    }
 5288: } // extern "C"
 5289: 
 5290: 
 5291: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5292: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5293: 
 5294:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5295: 
 5296:    const int kb  = elem->kb;
 5297:    const int kb2 = elem2->kb;
 5298: 
 5299:    // z-coordinate of prism of elem
 5300:    const double zp = elem->z_prism(k);
 5301: 
 5302:    double rho = 0.0;
 5303: 
 5304:    if (elem2->is2D()) {
 5305:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5306: 
 5307:    } else {  // 3D
 5308: 
 5309:       // eta_min may be < zmax
 5310:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5311:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5312: 
 5313:       // (Extrapolate density below bottom, we will fix it later)
 5314:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5315:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5316:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5317:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5318:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5319:    } // 2D/3D
 5320:      
 5321: 
 5322:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5323:    // Now we need to fix it.
 5324:    if (elem->z[k] < elem2->z[kb2]) {
 5325:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5326: 
 5327:       // There are two methods to adjust the density at the bottom of the element.
 5328:       // iunder_deep=0: 
 5329:       const double depth1 = abs(elem->z[kb]); // larger depth
 5330: 
 5331:       if (iunder_deep==0) {
 5332: 
 5333:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5334: 
 5335:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5336: 
 5337:       } else { // iunder_deep != 0
 5338: 
 5339:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5340: 
 5341:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5342: 
 5343:          //   Demeaned density at the same z coordinate as
 5344:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5345:          }
 5346: 
 5347:       } // if iunder_deep
 5348:    } // if elem->z[kb] < elem2->z[kb]
 5349: 
 5350:    return rho;
 5351: }
 5352: 
 5353: 
 5354: extern "C" {
 5355:    __global__ void computeDensityGradient(void) {
 5356: 
 5357:       if constexpr(ibc != 0) return;
 5358: 
 5359:          // Compute the horizontal density gradient at each element.
 5360:       // It works in two steps:
 5361:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5362:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5363:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5364:       //             gradRho.r1 = rho1 - rho0
 5365:       //             gradRho.r2 = rho2 - rho0
 5366:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5367:       // 
 5368:       //  NOTE: We use de-meaned densities.
 5369: 
 5370:       ELEM(elem);
 5371: 
 5372:       if (elem->isDry) return;
 5373: 
 5374:       const int kb  = elem->kb;
 5375:       const int i34 = elem->i34;
 5376: 
 5377:       for (int k = kb + 1; k < nvrt; k++) {
 5378:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5379:          //             gradRho.r1 = rho1 - rho0
 5380:          //             gradRho.r2 = rho2 - rho0
 5381:          int icount = 0;
 5382:          double sumRx = 0.0;
 5383:          double sumRy = 0.0;
 5384:          for (int j1=0; j1<i34; j1++) { 
 5385: 
 5386:             const int j2 = elem->nxq(j1 + 1);
 5387: 
 5388:             // Pairs of consecutive neighbor elements of elem
 5389:             const Element *e1 = elem->nghbElems[j1];
 5390:             const Element *e2 = elem->nghbElems[j2];
 5391: 
 5392:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5393:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5394:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5395: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 5396: 
 5397:             // Compute the density difference and the vector from elem to e1 and e2
 5398:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5399:             double diffRho1, diffRho2;
 5400:             Vector2 vec1, vec2;
 5401:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5402:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5403: 
 5404:             const double rl1 = length(vec1);
 5405:             const double rl2 = length(vec2);
 5406:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5407: 
 5408:             const double delta = cross(vec1, vec2);
 5409:             const double sintheta = abs(delta)/(rl1*rl2);
 5410: 
 5411:             // To avoid problems, avoid elements with small angle between vectors
 5412:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5413:             const bool validEq = (sintheta > sin_one_deg);
 5414: 
 5415:             if (validEq) {
 5416:                // Solve the system of equations to get the density gradient at elem
 5417:                icount++;
 5418:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5419:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5420:                sumRx += Rx;
 5421:                sumRy += Ry;
 5422:             }
 5423:          } // for j1
 5424: 
 5425:          // Compute the average density gradient at elem
 5426:          if (icount==0) {
 5427:            // Bad mesh quality; bail out with 0 b-cc
 5428:            elem->gradRho[k] = {0.0, 0.0};
 5429:          } else {
 5430:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5431:          }
 5432: 
 5433:       } // for k
 5434: 
 5435:    }
 5436: 
 5437:    __global__ void computeBaroclinicTerm(void) {
 5438:    // Computes the baroclinic term at sides (at half levels).
 5439:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5440:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5441: 
 5442:       if (ibc == 1) return;
 5443: 
 5444:       SIDE(side);
 5445: 
 5446:       if (side->isDry) return;
 5447: 
 5448:       const Element *e1 = side->elems[0];
 5449:       const Element *e2 = side->elems[1];      
 5450:       const int kb = side->kb;
 5451:       
 5452:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5453: 
 5454:       // interpolates vertically the density gradient of the two elements at the half level/
 5455: 
 5456:       int k1 = max(kb, nvrt / 2);
 5457:       int k2 = max(kb, nvrt / 2);
 5458: 
 5459:       // Starts the integration at the surface and goes down to the bottom
 5460:       side->bcc[nvrt-1] = {0.0, 0.0};
 5461:       for (int k = nvrt - 2; k >= kb; k--) {
 5462:       // For each prism level (from surface to bottom)...
 5463: 
 5464:          // For both elements, interpolate density gradient at the side's half level.
 5465:          // The gradient at the side is the average of the gradients at the elements.
 5466:          // w1, w2 are used to take into account boundary sides, with just one element.
 5467:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5468:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5469:          const double wsum = w1 + w2;
 5470:          w1 = w1/wsum;
 5471:          w2 = w2/wsum;
 5472:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5473: 
 5474:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5475:          Vector2 gradRho = {0.0, 0.0};
 5476:          if (e1 != nullptr && k > kb) {
 5477:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5478:             
 5479:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5480:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5481:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5482: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5483:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5484:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5485:          }      
 5486:          if (e2 != nullptr && k > kb) {
 5487:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5488:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5489:             
 5490:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5491:          }
 5492: 
 5493:          if constexpr(ics==2) {
 5494:             assert(false && "Not implemented: ics == 2");
 5495:             // IMPLEMENT THIS XXXXXX
 5496:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5497:             // swild(1)=tmp1
 5498:             // swild(2)=tmp2
 5499:          }
 5500:          
 5501:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5502:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5503:          // CHECK INDICES!!! XXX
 5504:          const double grav3 = side->grav3();
 5505:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5506: 
 5507:       } // for
 5508: 
 5509:    }
 5510: 
 5511: 
 5512: 
 5513:    __global__ void computeHorGradientAtSide(void) {
 5514: 
 5515:       // Compute the horizontal density gradient at each element.
 5516:       // It works in two steps:
 5517:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5518:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5519:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5520:       //             gradRho.r1 = rho1 - rho0
 5521:       //             gradRho.r2 = rho2 - rho0
 5522:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5523:       // 
 5524:       //  NOTE: We use de-meaned densities.
 5525: 
 5526:       SIDE(side);
 5527: 
 5528: // printf("side->isDry: %d\n", side->isDry);
 5529:       if (side->isDry) return;
 5530: 
 5531:       // Computes the gradient of the variables at the side center.
 5532:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5533:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5534:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5535: 
 5536:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5537:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5538:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5539:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5540: 
 5541: 
 5542:    }
 5543: 
 5544: 
 5545:    __global__ void solveMomentumEquations(double time) {
 5546: 
 5547:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5548:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5549: 
 5550:       SIDE(side);
 5551: 
 5552:       if (side->isDry) 
 5553:       {
 5554:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5555: 
 5556:          return;
 5557:       }
 5558: 
 5559:       const Node *n1 = side->n1;
 5560:       const Node *n2 = side->n2;
 5561: 
 5562:       const int kb = side->kb;
 5563: 
 5564:       const double veg_h = side->veg_h();
 5565:       const double grav3 = side->grav3();
 5566: 
 5567:       if (side->is2D()) {
 5568:          // Warning: Do not use htot2, which is updated.
 5569:          const double htot = side->htot1();
 5570:          const double hhat = side->hhat;
 5571: 
 5572:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5573: 
 5574:          Vector2 tau2 = {0.0, 0.0};
 5575:           
 5576:          if constexpr(ics==1) {
 5577:             tau2 = side->tau();
 5578: 
 5579:          } else {
 5580:             assert(false && "Not implemented: ics == 2");
 5581:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5582:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5583:             // taux2=(vn1+tt1)*0.5d0
 5584:             // tauy2=(vn2+ss1)*0.5d0
 5585:          } // if ics         
 5586: 
 5587:          // hat_gam has units of m/s
 5588: 
 5589:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5590: 
 5591:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5592:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5593: 
 5594:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5595: 
 5596: 
 5597:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5598:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5599: 
 5600:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5601: 
 5602: 
 5603:       }
 5604:       else { // 3D
 5605: 
 5606:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5607:          // 
 5608:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5609:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5610:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5611:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5612:          // k+1 and k.
 5613: 
 5614: 
 5615:    
 5616: 
 5617: 
 5618:          const int ndim = nvrt - kb;
 5619:          const double zTopCanopy = side->zTopCanopy();
 5620: 
 5621:          // Initialize the tridiagonal system
 5622:          for (int k = kb + 1; k < nvrt; k++) {
 5623:             
 5624:             const int kin = k - (kb + 1);
 5625: 
 5626:             // Vertical viscosity at the face center
 5627:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5628:            
 5629: 
 5630:             alow[kin] = 0.0;
 5631:             cupp[kin] = 0.0;
 5632:             bdia[kin] = 0.0;
 5633: 
 5634:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5635:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5636: 
 5637:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5638:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5639:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5640: 
 5641:             // First part: layers k, k+1
 5642:             if (k < nvrt - 1) {
 5643:                              
 5644:                if constexpr(iveg != 0) {
 5645: 
 5646:                   // If there is vegetation at this level...
 5647:                   if (zTopCanopy > side->zc[k]) {
 5648:                      // If the canopy is above the k layer...
 5649:                      
 5650:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5651:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5652:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5653:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5654: 
 5655:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5656:                      const double vmag2 = length(ut2);
 5657:                      const double vmag1 = length(side->u2[k]);
 5658:                      const double vmag = 0.5*(vmag1 + vmag2);
 5659:                      
 5660:                      // Computes the vegetation alpha at the face center
 5661:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5662: 
 5663:                      cff1 += veg_alpha_sd*dt*vmag;
 5664: 
 5665:                   } // if (zTopCanopy
 5666:                } // if iveg
 5667: 
 5668:                const double dzz = side->Dz(k + 1);
 5669:                const double tmp = dt*dfz/dzz;
 5670:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5671: 
 5672:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5673:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5674:             }
 5675: 
 5676: 
 5677:             // Second part: layers k-1, k
 5678:             if (k > kb + 1) {
 5679: 
 5680:                double cff1 = 1.0; //init \bar{c^k}
 5681: 
 5682:                if constexpr(iveg != 0) {
 5683:                   // If there is vegetation at this level...
 5684:                   if (zTopCanopy > side->zc[k-1]) {
 5685:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5686:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5687: 
 5688:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5689: 
 5690:                      const double vmag2 = length(ut2);
 5691:                      const double vmag1 = length(side->u2[k-1]);
 5692:                      const double vmag = 0.5*(vmag1 + vmag2);
 5693: 
 5694:                      // Computes the vegetation alpha at the face center
 5695:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5696:                      cff1 += veg_alpha_sd*dt*vmag;
 5697:                   } // if zTopCanopy
 5698: 
 5699:                } // if iveg
 5700: 
 5701:                const double dzz = side->Dz(k);
 5702:                const double tmp = dt*dfz/dzz;
 5703:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5704: 
 5705:                alow[kin] += cff1*dzz/6.0 - tmp;
 5706:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5707: 
 5708:             } else { // Bottom boundary
 5709:                // This occurs at the bottom, where the bottom drag is applied.
 5710: 
 5711:                bdia[kin] += dt*side->chi2; // XXXX
 5712: 
 5713: 
 5714:             } // if (k > kb + 1)
 5715: 
 5716: 
 5717: 
 5718:          } // for (int k
 5719: 
 5720: 
 5721: 
 5722:          // Computes the RHS.
 5723:          // -----------------
 5724: 
 5725:          //	BC to be imposed at the end.
 5726: 
 5727:          const Vector2 gradETP  = side->gradETP;
 5728:          const Vector2 gradPr   = side->gradPr;
 5729:          const Vector2 gradEta1 = side->gradEta1;
 5730:          const Vector2 gradEta2 = side->gradEta2;
 5731: 
 5732:          const Vector2 *btu = side->btu;
 5733:          const Vector2 *u2  = side->u2;
 5734:          const double coriolis = side->coriolis;
 5735:          const Vector2 *nuGradU = side->nuGradU;
 5736: 
 5737: 
 5738:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5739: 
 5740:          for (int k = kb + 1; k < nvrt; k++) {
 5741:             const int kin = k - kb - 1;
 5742: 
 5743:             const double dz_0 = side->Dz(k);
 5744:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5745: 
 5746:             rrhs[kin] = {0.0, 0.0};
 5747:             double dz = 0.0;
 5748: 
 5749:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5750:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5751:             if (k < nvrt  ) dz += dz_1;
 5752:             if (k > kb + 1) dz += dz_0;
 5753: 
 5754:             // Elevation gradient, atmospheric pressure and tidal potential
 5755:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5756: 
 5757:             // Coriolis, advection, wind stress, and horizontal viscosity
 5758:             if (k < nvrt - 1) {
 5759: 
 5760: 
 5761:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5762:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5763:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5764:                                                 
 5765: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5766:                //diff stress tensors 1006
 5767:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5768:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5769:                   assert(false && "Not implemented: itur == 5");
 5770:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5771:                }
 5772: 
 5773:             } else { // k == nvrt - 1 SURFACE
 5774:                Vector2 tau2 = {0.0, 0.0};
 5775:                if constexpr(ics==1) {
 5776:                   tau2 = side->tau();
 5777:       
 5778:                } else {
 5779:                   assert(false && "Not implemented: ics == 2");
 5780:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5781:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5782:                   // taux2=(vn1+tt1)*0.5d0
 5783:                   // tauy2=(vn2+ss1)*0.5d0
 5784:                } // if ics
 5785: 
 5786:                rrhs[kin] += dt*tau2;
 5787: 
 5788:             } // if k<nvrt
 5789: 
 5790:             if (k > kb + 1) {
 5791:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5792:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5793:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5794: 
 5795:                // diff stress tensors 1006
 5796:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5797:                   assert(false && "Not implemented: itur == 5");
 5798:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5799:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5800:                }
 5801: 
 5802:             } // if k>kbs + 1
 5803: 
 5804:             // Baroclinic
 5805:             Vector2 *bcc = side->bcc;
 5806:             if constexpr(ibc == 0) {
 5807:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5808:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5809: 
 5810:             } // if ibc==0
 5811: 
 5812:          } // k=kb + 1,nvrt
 5813: 
 5814: 
 5815:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5816: 
 5817:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5818:             const int kin = k - kb - 1;
 5819: 
 5820:             // Velocity is always clamped to maximum values
 5821:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5822:          } // k
 5823: 
 5824:       } // if side->is2D()
 5825:       
 5826: 
 5827:       // Impose velocity boundary condition at the bottom
 5828:       if constexpr(imm == 2) { // 3D bed deformation model
 5829:          double dep;
 5830:          Vector2 vel;
 5831: 
 5832:          assert(false && "Not implemented: imm == 2");
 5833:          //update_bdef(time, x0, y0, dep, vel);
 5834:          // side->u2[kb] = vel;
 5835: 
 5836:       } else { // imm = 0 or 1
 5837:          if (side->Cd() == 0.0) {
 5838:             side->u2[kb] = side->u2[kb + 1];
 5839: 
 5840:          } else if (side->is3D()) { // 3D no slip bottom   
 5841:             side->u2[kb] = {0.0, 0.0};
 5842:          }
 5843:           
 5844:       } // if imm
 5845: 
 5846:       // The velocities below the bottom level are set to zero
 5847:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5848: 
 5849: 
 5850:    }
 5851: 
 5852: 
 5853:    __global__ void applyMomentumBC(void) {
 5854: 
 5855:       SIDE_BND(sideBnd);
 5856: 
 5857:       Side *side = sideBnd->side;
 5858:       const BoundarySegment *segment = sideBnd->segment;
 5859:       const Node *n1 = side->n1;
 5860:       const Node *n2 = side->n2;
 5861: 
 5862:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5863: 
 5864:       const bool isLand = segment->isLand;
 5865:       const int ifltype = segment->ifltype;
 5866: 
 5867:       const int kb = side->kb;
 5868: 
 5869:       if (!isLand && ifltype != 0) {
 5870:          const Vector2 *ubc = sideBnd->ubc;
 5871:   
 5872:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5873:             
 5874:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5875:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5876: 
 5877:             if (ifltype == -1) {
 5878:                // Flather 1
 5879: 
 5880:                const double depth = side->depth();
 5881: 
 5882:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5883: 
 5884:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5885: 
 5886:                side->u2[k] = vnorm*side->n;
 5887: 
 5888:             } else if (ifltype == -2) { // Discharge
 5889: 
 5890:                const double eta1 = side->eta1();
 5891:                const double eta2 = side->eta2();
 5892:                const double htot = side->htot2();
 5893: 
 5894:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5895:                assert(false && "Not implemented: Discharge bc");
 5896:                // const double dischrg = discharge(eta1);
 5897:                const double dischrg = 0.0; // XXX REMOVE
 5898:                
 5899: 
 5900:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5901: 
 5902:                const double vnorm = dischrg*eta2/htot;
 5903: 
 5904:                side->u2[k] = vnorm*side->n;
 5905: 
 5906:             }
 5907:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5908:                const double vnorm = dot(side->u2[k], side->n);
 5909: 
 5910:                double rat;
 5911:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5912:                else              rat = segment->vobc2; // outgoing
 5913: 
 5914:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5915: 
 5916:             }
 5917:             else { // not Flather or 3D radiation
 5918:                side->u2[k] = ubc[k];
 5919: 
 5920:             } // if (segment->ifltype...
 5921: 
 5922:          }
 5923: 
 5924:       }
 5925:       else if (isLand) { // if it is land boundary side
 5926: 
 5927:          if constexpr(islip == 0) { // free slip
 5928: 
 5929:             for (int k = kb; k < nvrt; k++) {
 5930: 
 5931:                const Vector2 t = side->t();
 5932:                const Vector2 n = side->n;
 5933: 
 5934:                double vnorm = 0.0; // for most cases
 5935:                const double vtan = dot(side->u2[k], t);
 5936:                
 5937:                side->u2[k] = vtan*t - vnorm*n;
 5938: 
 5939:             }
 5940: 
 5941:          } else { // no slip
 5942:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5943: 
 5944:          }
 5945:       } // if (side segment type...
 5946: 
 5947:    
 5948: 
 5949:    }
 5950: 
 5951: 
 5952:    __global__ void shapiroFilter1(void) {
 5953:       // First step of the Shapiro filter (normally used if indvel<=0)
 5954:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5955: 
 5956:       SIDE(side);
 5957: 
 5958:       // Only internal wet sides are processed
 5959:       if (side->isDry || !(side->isInternal())) return;
 5960: 
 5961:       const int kb = side->kb;
 5962: 
 5963:       for (int mm = 0; mm < niter_shap; mm++) {
 5964: 
 5965:          for (int k = kb + 1; k < nvrt; k++) {
 5966:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5967:             Vector2 suru = {0.0, 0.0};
 5968: 
 5969:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5970: 
 5971:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5972: 
 5973:                int kin = k;
 5974:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5975:                
 5976:                if constexpr(ics==1) {
 5977:                   suru += nSide->u2[kin];
 5978: 
 5979:                } else {
 5980:                   assert(false && "Not implemented: ics == 2");
 5981:                   // Vector2 vn1, vn2;
 5982:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5983:                   // suru=suru+vn1;
 5984:                   // surv=surv+vn2;
 5985:                }
 5986:             }
 5987: 
 5988: 
 5989:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5990: 
 5991:          }
 5992:       }
 5993:    }
 5994: 
 5995:    __global__ void shapiroFilter2(void) {
 5996:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5997: 
 5998:       SIDE(side);
 5999: 
 6000:       if (side->isDry || !(side->isInternal())) return;
 6001: 
 6002:       const int kb = side->kb;
 6003: 
 6004:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6005: 
 6006:       if (side->is2D()) {
 6007:          side->u2[kb + 1] = side->bcc[kb + 1];
 6008:          side->u2[kb    ] = side->u2 [nvrt - 1];
 6009: 
 6010:       } else {
 6011:          // 3D
 6012:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6013:          
 6014:       }
 6015: 
 6016:    }
 6017: 
 6018: 
 6019:    __global__ void ul0UpdateZCoords(void) {
 6020:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6021:       
 6022:       NODE(node);      
 6023: 
 6024: 
 6025:       if (node->isDry2()) { 
 6026: 
 6027:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6028: 
 6029:          if constexpr(ivcor != 1) node->kb = 0;
 6030: 
 6031:       } else {
 6032: 
 6033:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6034:          node->updateKb();
 6035: 
 6036:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6037: 
 6038:       }
 6039: 
 6040:       // We use the temp.b field to store the previous state of isDry.
 6041:       node->tmp.b = node->isDry;
 6042: 
 6043:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6044:       node->isDry = true;
 6045: 
 6046:    }
 6047: 
 6048:    __global__ void ul0ComputeDryElementsAndNodes(void)
 6049:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 6050:    {
 6051:       ELEM(elem);
 6052: 
 6053:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 6054: 
 6055:       // All the nodes of a wet element are wet.
 6056:       if (!elem->isDry) {
 6057:          elem->nodes[0]->isDry = false;
 6058:          elem->nodes[1]->isDry = false;
 6059:          elem->nodes[2]->isDry = false;
 6060:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 6061: 
 6062:       }
 6063: 
 6064: 
 6065:       elem->kb = 0;
 6066: 
 6067:       if (elem->isDry) return;
 6068: 
 6069:       // Wet
 6070:       const Node *n1 = elem->nodes[0];
 6071:       const Node *n2 = elem->nodes[1];
 6072:       const Node *n3 = elem->nodes[2];  
 6073:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 6074: 
 6075:    //    if(elem->isDry2()) {
 6076:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6077:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6078:    //        call parallel_abort(errmsg)
 6079:    //    }
 6080: 
 6081: 
 6082:       // Computes element's kb as the minimum of the nodes' kb.
 6083:       const int kb1 = n1->kb;
 6084:       const int kb2 = n2->kb;
 6085:       const int kb3 = n3->kb;
 6086:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6087: 
 6088: 
 6089:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6090: 
 6091: 
 6092:       // Computes the element z as the mean of the nodes z.
 6093:       for (int k = elem->kb; k < nvrt; k++) {
 6094: 
 6095:          // Compute the element z as the mean of the nodes z.
 6096:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 6097:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6098:          elem->z[k] /= elem->i34;
 6099: 
 6100:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6101:       }
 6102:                   
 6103:    }
 6104: 
 6105:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6106:    {
 6107:       NODE(node);
 6108:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6109: 
 6110:       if (it == iths) return;
 6111: 
 6112: 
 6113:       if(!node->isDry && node->tmp.b) { // rewetted
 6114:          for (int k=0; k < nvrt; k++) {
 6115: 
 6116:             Vector3 utmp={0.0, 0.0, 0.0};
 6117: 
 6118:             double ttmp=0.0;
 6119:             double stmp=0.0;
 6120:             int icount=0;
 6121:             for (int j = 0; j < node->numNodes; j++) {
 6122: 
 6123: 
 6124:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 6125:                if (!node->isDry) { // all indices extended
 6126:                   icount++;
 6127: 
 6128:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6129:                   utmp += node->uvw2(k);
 6130:                   
 6131:                   ttmp += node->tracers[k].tracer[0]; 
 6132:                   stmp += node->tracers[k].tracer[1]; 
 6133:                }
 6134:             }
 6135: 
 6136:             if(icount > 0) {
 6137:                const double inv_icount = 1.0/icount;
 6138:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 6139:                node->w2[k]     = inv_icount*utmp.z;
 6140:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6141:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6142:             }
 6143:          }
 6144:       }
 6145:    }
 6146: 
 6147: 
 6148:    __global__ void ul0UpdateSides(int it, int iths) {
 6149: 
 6150:       SIDE(side);
 6151: 
 6152:       // A side is wet if and only if at least one of its elements is wet.
 6153:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6154: 
 6155:       const Node *n1 = side->n1;
 6156:       const Node *n2 = side->n2;
 6157:       const int kb1 = n1->kb;
 6158:       const int kb2 = n2->kb;
 6159: 
 6160:       side->kb = 0; // dry
 6161: 
 6162:       if (isWet) {
 6163: 
 6164:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6165: 
 6166:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6167: 
 6168:          side->kb = min(kb1, kb2);
 6169: 
 6170:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6171: 
 6172:          for (int k = side->kb; k < nvrt; k++) {
 6173:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6174: 
 6175:          
 6176:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6177: 
 6178:             // Compute velocity for re-wetted sides 
 6179:             if ((it != iths) && (side->isDry && isWet)) {
 6180:             
 6181:                Vector2 utmp={0.0, 0.0};
 6182: 
 6183:                int icount=0;
 6184: 
 6185:                // For all the sides on the two elements that share this side
 6186:                for (int j=0; j < 2; j++) {
 6187:                   const Element *elem = side->elems[j];
 6188:                   if (elem == nullptr) continue;
 6189: 
 6190:                   for (int jj=0; jj < elem->i34; jj++) {
 6191:                      const Side *nSide = elem->sides[jj];
 6192:                      if (nSide->isDry) continue;
 6193: 
 6194:                      icount++;
 6195:                      utmp += nSide->u2[k];                     
 6196:                   }
 6197:                }
 6198:                   
 6199:                assert(icount > 0 && "No wet sides around this side");
 6200:                if (icount > 0)  side->u2[k] = utmp/icount;
 6201:                   
 6202:             } // if ((it != iths) && (side->isDry && isWet))
 6203: 
 6204:          } // for k
 6205: 
 6206:       } // if isWet
 6207:    
 6208:       side->isDry = !isWet;
 6209: 
 6210:    }
 6211: 
 6212: 
 6213:    __global__ void zeroNodalVelocities(void) {
 6214:       NODE(node);
 6215: 
 6216:       for (int k = 0; k < nvrt; k++) {
 6217:          node->u2[k]   = {0.0, 0.0};
 6218:          node->w2[k]   = 0.0;
 6219:          node->utmp[k] = {0.0, 0.0};
 6220:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6221:       }
 6222:    }
 6223: 
 6224:  
 6225: 
 6226:    __global__ void computeNodalVerticalVelocities1(void) {
 6227:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6228:    // Adds the element's vertical velocity times the element's area.
 6229:       ELEM(elem);
 6230: 
 6231:       for (int j = 0; j < elem->i34; j++) {
 6232:          Node *node = elem->nodes[j];
 6233: 
 6234:          for (int k = node->kb; k < nvrt; k++) {
 6235:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6236:          }
 6237:          atomicAdd(&(node->tmp.d), elem->area);
 6238:       }
 6239:    }
 6240: 
 6241:    __global__ void computeNodalVerticalVelocities2(void) {
 6242:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6243:    // Divides by the total area of the elements sharing the    node.
 6244:       NODE(node);
 6245: 
 6246:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6247:    }
 6248: 
 6249: 
 6250:    __global__ void computeNodalHorizontalVelocities1(void) {
 6251:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6252:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6253: 
 6254:       ELEM(elem);
 6255: 
 6256:       const int kb = elem->kb;
 6257:       const bool isTri = elem->isTri();
 6258: 
 6259:       if constexpr(indvel <= 0) {
 6260:          // Assuming discontinoius hvel.
 6261: 
 6262: 
 6263:          if (isTri) { // For triangles
 6264:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6265:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6266: 
 6267:             for (int j = 0; j < 3; j++) {
 6268:                // For every node of the triangle...
 6269:                Node *node = elem->nodes[j];
 6270: 
 6271:                const Side *s1 = elem->sides[j];
 6272:                const Side *s2 = elem->sides[(j + 1) % 3];
 6273:                const Side *s3 = elem->sides[(j + 2) % 3];
 6274: 
 6275:                const int numElements = node->numElements;
 6276:                const double inv_numElements = 1.0/numElements;
 6277: 
 6278:                for (int k = kb; k < nvrt; k++)  {
 6279:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6280:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6281:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6282:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6283:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6284:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6285: 
 6286:                }
 6287: 
 6288:             }
 6289:          }
 6290:          else { // For quads
 6291:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6292: 
 6293:          }
 6294: 
 6295:       }
 6296:       
 6297:    }
 6298: 
 6299: 
 6300:    __global__ void computeNodalHorizontalVelocities2(void) {
 6301:       NODE(node);
 6302: 
 6303:       for (int k = 0; k < nvrt; k++) {
 6304:          node->u2[k] = node->utmp[k];
 6305:          node->w2[k] = node->w2[k];
 6306:       }
 6307:       
 6308:    }   
 6309: 
 6310:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6311:    // XXXX I'm not sure where I got this function from. 
 6312:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6313:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6314:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6315:    // It uses the utmp array as a temporary array to store the velocities.
 6316: 
 6317:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6318: 
 6319:       SIDE(side);
 6320: 
 6321:       const int kb = side->kb;
 6322: 
 6323:       Node *n1 = side->n1;
 6324:       Node *n2 = side->n2;
 6325: 
 6326:       for (int k = kb; k < nvrt; k++) {
 6327: 
 6328:          // Cast the u2 vector into a Vector2 
 6329:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6330:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6331: 
 6332:          n1_u2 = side->u2[k]/n1->numSides;
 6333:          n2_u2 = side->u2[k]/n2->numSides;
 6334: 
 6335:       }
 6336: 
 6337: 
 6338:    }
 6339: 
 6340:    __global__ void resetVelocityOpenBndNodes(void) {
 6341:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6342: 
 6343:       NODE_BND(nodebnd);
 6344: 
 6345:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6346:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6347:       }
 6348: 
 6349:    }
 6350: 
 6351: 
 6352:    __global__ void setVelocityOpenBndNodes(void) {
 6353:    // For open boundary nodes sets their velocity to the imposed values.
 6354: 
 6355:       SIDE_BND(sidebnd);
 6356: 
 6357:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6358:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6359:          // to its segment to the average of the side velocity.
 6360: 
 6361:          for (int k = 0; k < nvrt; k++) {
 6362:             Node *n1 = sidebnd->side->n1;
 6363:             Node *n2 = sidebnd->side->n2;
 6364: 
 6365: 
 6366:             Vector2 n1_u2(n1->u2[k]);
 6367:             Vector2 n2_u2(n2->u2[k]);
 6368: 
 6369:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6370:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6371:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6372:             }
 6373:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6374:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6375:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6376:             }
 6377: 
 6378:          }
 6379: 
 6380:       }
 6381: 
 6382:    }
 6383: 
 6384: 
 6385:    __global__ void computeVerticalVelocity(void) {
 6386:       // Computes the vertical velocity at the (2D) element's centroid.
 6387:       // In this function we will be considering volumetric elements, with side faces and a 
 6388:       // bottom and a top face. We will call them SFs, BF and TF.
 6389:       // It computes the flux coming from BF and the SFs.
 6390:       // If the bed is moving, it takes that into account.
 6391:       // Since water is incompressible, the integral of the velocity times the normal vector
 6392:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6393:       // and the BF is equal to the flux going out from the TF.
 6394:       // TF = - BF - sum(SFs).
 6395:       // It then computes the horizontal velocity at the center of TF.
 6396:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6397:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6398:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6399: 
 6400:       ELEM(elem);
 6401: 
 6402:       if (elem->isDry) return;
 6403: 
 6404:       const int kb = elem->kb;
 6405:       const bool isTri = elem->isTri();
 6406: 
 6407:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6408: 
 6409:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6410:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6411:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6412: 
 6413:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6414: 
 6415:       double area3D;
 6416: 
 6417:       // Bottom face flux
 6418:       double bottomFlux = 0.0;
 6419:       Vector2 u2meanBottom = {0.0, 0.0};
 6420:       const Vector2 gradh = elem->grad2(&Node::depth);
 6421:       if constexpr(imm==2) {
 6422:          Vector3 ubed;
 6423: 
 6424:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6425:          // updateBDEF(ubed);
 6426:      
 6427:          // const double bflux0 = dot(ubed, elem_n1);
 6428: 
 6429:          // elem->w[kb] += ubed.z;
 6430:       }
 6431:       else {
 6432:          Vector2 umean;
 6433:          if constexpr(ics == 1) {
 6434:             u2meanBottom = elem->mean(kb, &Side::u2);
 6435:          }
 6436:          else {
 6437:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6438:          }
 6439: 
 6440:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6441:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6442: 
 6443:          bottomFlux = - dot(gradh, u2meanBottom);
 6444:       } // if imm
 6445: 
 6446:       // Compute w for kb+1 to nvrt-1
 6447:       for (int l = kb; l < nvrt - 1; l++) {
 6448: 
 6449:          // normal vector to the top face of the "volumetric" element (3D)
 6450:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6451: 
 6452:          // Compute the total flux at the sides
 6453:          double sideFlux = 0.0;
 6454:          Vector2 u2top = {0.0, 0.0};
 6455:          for (int j = 0; j < elem->i34; j++) {
 6456:             const Side *side = elem->sides[j];
 6457: 
 6458:             const double sideArea = side->area(l);
 6459:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6460:             const double sign = elem->ssign[j]; 
 6461: 
 6462:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6463:          }
 6464:          
 6465:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6466:          //velocities at the centers of the sides
 6467:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6468: 
 6469:          // The flx at the top ace can be computed from the other flows.
 6470:          const double topFlux = - sideFlux - bottomFlux;
 6471:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6472: 
 6473:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6474: 
 6475:          elem_n1 = elem_n2;
 6476: 
 6477:          bottomFlux = - topFlux;
 6478:       }
 6479:    }  
 6480: 
