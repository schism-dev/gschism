 2467: //    @param nextElement: element that contains the intersection point
 2468: //    @param xIntersect, yIntersect: intersection point  
 2469: 
 2470: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2471: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2472: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
