 8128: #ifdef OLD_PCG_SOLVER
 8129: __global__ void computeMatrixProductAndDotProducts() {
 8130:    // Computes A*p, r'Mr and p'Ap
 8131: 
 8132:    // 1) shared buffer: first half for rMr, second for pAp
 8133:    __shared__ double sdata[2*BLOCK_SIZE];
 8134:    double* s_rMr = sdata;
 8135:    double* s_pAp = sdata + BLOCK_SIZE;
 8136: 
 8137:    const int tid = threadIdx.x;
 8138: 
 8139:    double l_pAp = 0.0;
 8140: 
 8141:    s_rMr[tid] = 0.0;
 8142:    s_pAp[tid] = 0.0;
 8143: 
 8144:    // 2) get your node pointer
 8145:    // NODE(node);   
 8146:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8147:    Node *node = &(mesh->localNodeData[idx_node]); 
 8148:       if (idx_node < mesh->np) {
 8149: 
 8150:       const double diag = node->coeffDiag;
 8151:       const double r    = node->mR;
 8152:       const double p    = node->mP;  
 8153: 
 8154:       // apply preconditioner on the fly:
 8155:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8156: 
 8157:       // 4) compute Ap = A.p
 8158:       double Ap = node->coeffDiag * node->mP;
 8159:       for (int j = 0; j < node->numNodes; ++j) {
 8160:          const Node *nbNode = node->nodes[j];
 8161:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8162: 
 8163:       }
 8164: 
 8165:       node->mAp = Ap;
 8166:       
 8167: 
 8168:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8169:       // const double l_rMr = r*Mr;  // r'Mr
 8170:       l_pAp = p*Ap;  // p'Ap
 8171: 
 8172: 
 8173:    }
 8174: 
 8175:    // 6) write into shared mem
 8176:    // s_rMr[tid] = l_rMr;
 8177:    s_pAp[tid] = l_pAp;
 8178: 
 8179:    __syncthreads();
 8180: 
 8181:    // 7) block-wide tree reduction
 8182:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8183:       if (tid < stride)  {
 8184:          s_pAp[tid] += s_pAp[tid + stride];
 8185:       }
 8186:       __syncthreads();
 8187:    }
 8188: 
 8189:    // 8) thread 0 atomically accumulates into the globals
 8190:    // XXX: This is slower than it needs to be, but it is simple and works
 8191:    if (tid == 0) {
 8192:       atomicAdd(pAp, s_pAp[0]);
 8193:    }
 8194: 
 8195: 
 8196: }
 8197: 
 8198: 
 8199: __global__ void updateSolutionAndDotProducts(void) {
 8200:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8201: 
 8202:    const int tid = threadIdx.x;
 8203: 
 8204:    s_rMr[tid] = 0.0;
 8205: 
 8206:    // get node & bounds-check:
 8207:    NODE(node);
 8208: 
 8209:    
 8210:    // Compute alpha
 8211:    const double alpha = (*rMr_old)/(*pAp); 
 8212: 
 8213: 
 8214:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8215: 
 8216: 
 8217:    // load scalars
 8218:    const double diag = node->coeffDiag;
 8219:    const double p    = node->mP;
 8220:    const double Ap   = node->mAp;
 8221:    const double x    = node->mX;
 8222:    const double r    = node->mR;
 8223:    
 8224:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8225: 
 8226:    // 1) update solution & residual
 8227:    const double x_new = x + alpha*p;
 8228:    const double r_new = r - alpha*Ap;
 8229:    node->mX = x_new;
 8230:    node->mR = r_new;
 8231: 
 8232:    // 2) apply Jacobi preconditioner on the fly
 8233:    const double Mr_new = r_new/diag;
 8234: 
 8235: 
 8236:    // 3) local contributions for the two dot-products
 8237:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8238: 
 8239:    // 4) write into shared-mem
 8240:    s_rMr[tid] = l_rMr;
 8241: 
 8242:    __syncthreads();
 8243: 
 8244: 
 8245:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8246:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8247:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8248:       __syncthreads();
 8249:    }
 8250: 
 8251:    // 6) thread 0 atomically folds into the global accumulators
 8252:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8253: 
 8254: 
 8255: }
 8256: 
 8257: 
 8258: __global__ void updateSearchDirection() {
 8259: 
 8260:     NODE(node);
 8261: 
 8262:     // recompute z on-the-fly
 8263:     const double z = node->mR / node->coeffDiag;
 8264:     const double p = node->mP;
 8265: 
 8266:     const double beta = (*rMr_new)/(*rMr_old);
 8267: 
 8268: 
 8269:     // p =z + beta*p
 8270:     node->mP = z + beta*p;
 8271: 
 8272: }
 8273: 
 8274: __global__ void initializeScalars(double *scalars) {
 8275: 
 8276:    // These point to a cupy array in the host code
 8277:    rMr_old = scalars + 0;
 8278:    rMr_new = scalars + 1;
 8279:    pAp     = scalars + 2;
 8280: }
 8281: 
 8282: __global__ void initializePreconditionedResidual(void) {
 8283: 
 8284:     __shared__ double s_rMr[BLOCK_SIZE];  
 8285: 
 8286:     s_rMr[threadIdx.x] = 0.0;
 8287: 
 8288:     NODE_ALL(node, valid);
 8289:     const int tid = threadIdx.x;
 8290:     // For the first iteration:
 8291:     // 1. Initial solution x = 0 (already set)
 8292:     // 2. Initial residual r = b (stored in qel)
 8293:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8294: 
 8295: // XXX we should use the guess solution here    
 8296: 
 8297:     double l_rMr = 0.0;
 8298:     if (valid) {
 8299:       // Set initial residual r = b (from qel)
 8300:       node->mR = node->qel;
 8301: 
 8302:       // Compute z = M^-1 * r (preconditioned residual)
 8303:       const double z = node->mR / node->coeffDiag;
 8304: 
 8305:       // Set initial search direction p = z
 8306:       node->mP = z;
 8307: 
 8308:       // Initialize other variables needed for CG
 8309:       node->mX = 0.0;  // Initial solution
 8310:       node->mAp = 0.0; // Will be computed in first iteration
 8311: 
 8312: 
 8313:       // Computes the first r'Mr (reduction)
 8314:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8315:     }
 8316:     // 4) write into shared-mem
 8317:     s_rMr[tid] = l_rMr;
 8318: 
 8319:     __syncthreads();
 8320: 
 8321: 
 8322:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8323:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8324:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8325:         __syncthreads();
 8326:     }
 8327: 
 8328:     // 6) thread 0 atomically folds into the global accumulators
 8329:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8330: 
 8331:     *rMr_old = 0.0;
 8332:     *pAp = 0.0;
 8333: }
 8334: #endif
 8335: 
 8336: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8337: 
 8338:    ELEM(elem);
 8339: 
 8340:    switch (varCode) {
 8341:       case (int)VarCode::outputCoords:
 8342:          const Point2 coords = elem->outputCoords();
 8343:          res[elem->idx*2    ] = coords.x;
 8344:          res[elem->idx*2 + 1] = coords.y;
 8345:          break;
 8346:    }
 8347: }
