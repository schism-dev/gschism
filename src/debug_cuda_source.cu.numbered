 7723: __global__ void returnMatrix(double *res) {
 7724:    // Debugging: returns the matrix as a CuPy array
 7725: 
 7726:    const int size = mesh->np;
 7727:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7728:       const Node *node = mesh->localNodeData + idx_node;
 7729:       res[idx_node*size + idx_node] = node->coeffDiag;
 7730:       for (int j = 0; j < node->numNodes; j++) {
 7731:          Node* nbNode = node->nodes[j];
 7732:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7733:       }
 7734: 
 7735:    }
 7736:    
 7737: }
