 1653: // Helper functions for computing the local node index at a given offset from another.
 1654: __device__ __inline__ int nxq(int offset, int index, int size) {
 1655:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1656:    // to the index to make it positive
 1657:    assert(index + offset + 16*size >= 0);
 1658:    return (index + offset + 16*size) % size;  
 1659: }
 1660: 
 1661: __device__ __inline__ int nxq(int index, int size) {
 1662:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1663:    // to the index to make it positive
 1664:    assert(index + 16*size >= 0);
 1665:    return (index + 16*size) % size; 
 1666: }
