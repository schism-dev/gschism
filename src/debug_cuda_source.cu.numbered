 1942: // Convenience macros for accessing the objects in kernels.
 1943: 
 1944: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1945:                    Side *side = &(mesh->localSideData[idx_side]); \
 1946:                    if (idx_side >= mesh->ns) return;
 1947: 
 1948: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1949:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1950:                    if (idx_elem >= mesh->ne) return;
 1951: 
 1952: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1953:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1954:                    if (idx_node >= mesh->np) return;
 1955: 
 1956: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1957:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1958:                               const bool valid = (idx_node < mesh->np);                   
 1959: 
 1960: 
 1961: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1962:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1963:                            if (idx_node_bnd >= mesh->nbp) return;
 1964: 
 1965: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1966:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1967:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1968: 
