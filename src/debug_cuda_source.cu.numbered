 7963:                                  
 7964:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7965:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7966:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7967:                    int *isdel, int *isidenode, int *isbnd,
 7968:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7969:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7970:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7971:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7972:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7973:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7974:                    double *drag, double *roughness,
 7975:                    double *emo, double *efa, 
 7976:                    double *umo, double *ufa, 
 7977:                    double *vmo, double *vfa) {
 7978: 
 7979:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7980:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7981:                        isdel, isidenode, isbnd,
 7982:                        nond, nlnd, iond, ilnd, 
 7983:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7984:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7985:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7986:                        localNodeIndices, localElemIndices, localSideIndices,
 7987:                        localNodePart, localElemPart, localSidePart,
 7988:                        drag, roughness,
 7989:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7990:   }
