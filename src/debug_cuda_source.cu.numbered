 2588: //       const double y4 = nodes[nxq(i+1)]->y;
 2589: 
 2590: //       const Side& side = sides[i];
 2591: 
 2592: //       xIntersect=-1.e25;
 2593: //       yIntersect=-1.e25;
 2594: 
 2595: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2596: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2597: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2598: 
 2599: //       if (delta != 0.0) {
 2600: //          // Solves the two linear equations for tt1 and tt2
 2601: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2602: //          const double tt2 = delta2/delta;
 2603: 
 2604: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2605: //          // Similarly, we use tt2 to compute the intersection point.
 2606: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2607: //             xIntersect = x3 + (x4 - x3)*tt2;
 2608: //             yIntersect = y3 + (y4 - y3)*tt2;
 2609: 
 2610: //             intersectingSide = side;
 2611: //             nextElement = nghbElems[i];
 2612: 
 2613: //             return true;
 2614: //          }
 2615:       
 2616: //       }
 2617: //       else {
 2618: //          // The two segments are parallel
 2619: //          return false;
 2620: //       }
 2621: 
