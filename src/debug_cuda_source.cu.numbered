 1074: 
 1075:    __host__ __device__ void setWind(Vector2 &u) {
 1076:    // Sets the wind vector taking into account the wind rotation angle
 1077:    
 1078:       const double dir = atan2(-u.x,-u.y);
 1079:       const double speed = length(u);
 1080: 
 1081:       // Calculate new u and v components with added rotation angle
 1082:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1083:    }
 1084: 
 1085:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1086: 
 1087:    __host__ __device__ double sigmaTransitionDepth(void) const;
 1088: 
 1089:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1090:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1091:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1092: 
 1093:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1094: 
 1095:    __device__ void clearMatrixRow(void) {
 1096:       // Clear the matrix row for this node
 1097:       coeffDiag = 0.0;
 1098:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1099: 
 1100:    }
 1101: 
 1102:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1103:       // Add the value to the sparse matrix for this node
 1104:       
 1105:       if (node == this) {
 1106:          coeffDiag += value;
 1107: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1108:       } else {
 1109:          // Search (linearly)the index of the node in the array of nodes
 1110:          // XXX: This is not efficient, see if we can improve this
 1111:          int i;
 1112:          for (i = 0; i < numNodes; i++) {
 1113:             if (nodes[i] == node) {
 1114:                break;
 1115:             }
 1116:          }
 1117:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1118:          coeffMatrix[i] += value;
 1119:       }
 1120:    }
 1121: 
 1122: #ifdef BACKTRACKING
 1123:    __device__ void updateZCoordData() {
 1124:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1125: 
 1126:       // Check if node is wet
 1127:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1128: 
 1129:       if (idry) return;
 1130: 
 1131:       if constexpr(ivcor == 2) {  // SZ coordinates
 1132:          
 1133:          // Compute bottom level index
 1134:          if (depth <= mesh->h_s) {
 1135:                kb = mesh->nzlevels;
 1136:          } else {
 1137:                kb = -1;
 1138:                for (int i = 0; i < mesh->kz-1; i++) {
 1139:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1140:                      kb = i;
 1141:                      break;
 1142:                   }
 1143:                }
 1144:          }
 1145:       } 
 1146:       else if (ivcor == 1) {  // Localized sigma
 1147:          // Do nothing
 1148:       }
 1149: 
 1150:    }
 1151: #endif   
