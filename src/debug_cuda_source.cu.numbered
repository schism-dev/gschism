 5228: extern "C" {
 5229: 
 5230:    __global__ void scaleGravity(double loadtide_coef) {
 5231: 
 5232: 
 5233:       NODE(node);
 5234: 
 5235:       // SAL option: scale gravity
 5236:       if constexpr(iloadtide==2) {  // simple const
 5237:          node->grav2 = grav*(1.0 - loadtide_coef);
 5238: 
 5239:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5240:         
 5241:           const double depth = max(node->depth, 0.0);
 5242:           const double tmp1 = sqrt(depth);
 5243:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5244:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5245:                              2.6969e-13*depth*depth*depth*tmp1;
 5246:           
 5247:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5248:           
 5249: 
 5250: 
 5251:           node->grav2 = grav*(1.0 - beta_bar);
 5252: 
 5253:       } else {  // iloadtide=0,1
 5254:           node->grav2 = grav;
 5255: 
 5256:       }
 5257: 
 5258:    }
 5259: 
 5260: 
 5261:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5262:       NODE(node);
 5263: 
 5264:       const int idx = node->idx;
 5265:       Vector2 wind = {xWind[idx], yWind[idx]};
 5266: 
 5267:       if constexpr(nws != 0 && iwindoff != 0) {
 5268:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5269:       }
 5270: 
 5271:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5272:       node->setWind(wind);
 5273: 
 5274:       node->pr = pressAir[idx];
 5275:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5276: 
 5277:    }
