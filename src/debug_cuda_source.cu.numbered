 8592:       case (int)VarCode::x:
 8593:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8594:          *sizeType = sizeof(Vector2);
 8595:          break;
 8596:       case (int)VarCode::z:
 8597:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8598:          *sizeType = sizeof(double);
 8599:          break;
 8600:       case (int)VarCode::kb:
 8601:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8602:          *sizeType = sizeof(int);
 8603:          break;
 8604:       case (int)VarCode::isdry:
 8605:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8606:          *sizeType = sizeof(int);
 8607:          break;         
 8608:       case (int)VarCode::w:
 8609:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8610:          *sizeType = sizeof(double);
 8611:          break;
 8612:       case (int)VarCode::u:
 8613:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8614:          *sizeType = sizeof(Vector2);
 8615:          break;  
 8616:       case (int)VarCode::u_air:
 8617:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8618:          *sizeType = sizeof(Vector2);
 8619:          break;
 8620:       default:
 8621:          *offset = -1;    
 8622:    }  
 8623:    
 8624: }
