 1806:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1807:       // Compute the different time ramps used in the code 
 1808:       // This function is performed by just one thread
 1809: 
 1810:       rampbc = 1.0;
 1811:       if constexpr(ibc == 0) {
 1812:          if (drampbc > 0.0) {
 1813:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1814:          } else {
 1815:             rampbc = 1.0;
 1816:          }
 1817:       }
 1818: 
 1819:       if (nws != 0) {
 1820:          if (drampwind > 0.0) {
 1821:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1822:          } else {
 1823:             rampwind = 1.0;
 1824:          }
 1825:       }
 1826: 
 1827:       if (drampwafo > 0.0) {
 1828:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1829:       } else {
 1830:          rampwafo = 1.0;
 1831:       }
 1832: 
 1833:       // For source/sinks
 1834:       if (if_source && dramp_ss > 0.0) {
 1835:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1836:       } else {
 1837:          ramp_ss = 1.0;
 1838:       }
 1839: 
 1840:       if (dramp > 0.0) {
 1841:          ramp = tanh(2.0*time/86400.0/dramp);
 1842:       } else {
 1843:          ramp = 1.0;
 1844:       }
 1845: 
 1846: 
 1847:    }
