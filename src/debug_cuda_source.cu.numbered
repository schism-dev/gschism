 2629: 
 2630: 
 2631: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2632: 
 2633: 
 2634: __device__ void Node::updateKb(void) {
 2635: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2636: 
 2637:    if constexpr(ivcor == 1) return;
 2638: 
 2639: 
 2640:    // Check if node is wet
 2641:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2642: 
 2643:    if (isDry) return;
 2644: 
 2645:    if constexpr(ivcor == 2) {  // SZ coordinates
 2646:       
 2647:       // Compute bottom level index
 2648:       if (depth <= mesh->h_s) {
 2649:          kb = mesh->kz - 1;
 2650:       } else {
 2651:          kb = -1;
 2652:          int L = 0;
 2653:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2654:          
 2655:          while (L <= R) {
 2656:             int M = (R + L) / 2;
 2657: 
 2658:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2659:             
 2660:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2661:                R = M;
 2662:             } else {
 2663:                L = M;
 2664:             }
 2665: 
 2666:             if (R - L == 1) {
 2667:                kb = L;
 2668:                break;
 2669:             }
 2670:          }
 2671:       }
 2672:    } 
 2673: }
 2674: 
 2675: 
 2676: __device__ double Node::compZCoord(int k) const {
 2677:    // Computes the z coordinate at level k.
 2678:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2679:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2680:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2681:    // used 
 2682:    
 2683:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2684:       
 2685:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2686: 
 2687:    if constexpr(ivcor == 2) {
 2688: 
 2689:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2690:       const int kz = mesh->kz;
 2691:       const double h_c = mesh->h_c;
 2692:       const double theta_f = mesh->theta_f;
 2693:       const double sinh_theta_f = mesh->sinh_theta_f;
 2694: 
 2695:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2696:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2697:       // once per time step/node.
 2698:       // CHECK: updateZCoordData
 2699: 
 2700:       if      (k == nvrt-1)      { return eta2; }
 2701:       else if (k == kz)          return -hmod2;
 2702:       else if (k == kb)          return -depth;
 2703:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2704:       else if (k > kz) {
 2705:          const int ksig = k - kz + 1;
 2706: 
 2707:          if (hmod2 <= h_c) {
 2708:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2709:          } 
 2710:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2711:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2712:             assert(false && "ZCOOR: invalid h_c\n");
 2713:          } 
 2714:          else {
 2715:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2716:                          h_c * mesh->sigma[ksig] + 
 2717:                          (hmod2 - h_c) * mesh->cs[ksig];
 2718:          }
 2719:       } else { 
 2720:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2721:       }
 2722: 
 2723:    }
 2724:    else if constexpr(ivcor == 1) {
 2725:       if (k == kb) return -depth;
 2726:       else if (k == nvrt-1) return eta2;
 2727:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2728:    }
 2729:    
 2730:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2731:    return 0.0;
 2732: }
 2733: 
 2734: 
 2735: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2736:    // Checks if a side in on the boundary
 2737:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2738: 
 2739:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2740:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2741: 
 2742:    // Indices of the nodes that form the side
 2743:    const int n1 = side.n1->idx;
 2744:    const int n2 = side.n2->idx;
 2745: 
 2746:    // Check if the side is on a land boundary
 2747:    for (int i = 0; i < nland; i++) {
 2748:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2749:          // Consecutive nodes in the land boundary segment
 2750:          const int b1 = ilnd[i*mnlnd + j];
 2751:          const int b2 = ilnd[i*mnlnd + j + 1];
 2752: 
 2753:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2754:             isLand = true;
 2755:             return i;
 2756:          }
 2757:       }
 2758:    }
 2759: 
 2760:    // Check if the side is on an open boundary
 2761:    for (int i = 0; i < nope; i++) {
 2762:       for (int j = 0; j < nond[i] - 1; j++) {
 2763:          // Consecutive nodes in the open boundary segment
 2764:          const int b1 = iond[i*mnond + j];
 2765:          const int b2 = iond[i*mnond + j + 1];
 2766: 
 2767:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2768:             isLand = false;
 2769:             return i;
 2770:          }
 2771:       }
 2772:    }
 2773:    return -1;
 2774: }
