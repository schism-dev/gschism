 1791: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1792:    // Computes the 3D normal vector to the element at level k
 1793:    // Returns the normal vector and the area of the element
 1794: 
 1795:       if (isTri()) {
 1796:          // For triangles...
 1797: 
 1798:          // Gets the normal vector to the element (with a length equal to twice the area)
 1799:          if constexpr(ics==1) {
 1800:             const int kb0 = max(k, nodes[0]->kb);
 1801:             const int kb1 = max(k, nodes[1]->kb);
 1802:             const int kb2 = max(k, nodes[2]->kb);
 1803: 
 1804:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1805:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1806:             
 1807:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1808:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1809:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1810:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1811: 
 1812:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1813:             area3D = 0.5*len;
 1814: 
 1815:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1816: 
 1817:             return {nx/len, ny/len, nz/len};
 1818: 
 1819:            
 1820:          }
 1821:          else {  // lat/lon
 1822:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1823:             return {0.0, 0.0, 0.0};
 1824: 
 1825:          } // if ics
 1826:       }
 1827:       else {
 1828:          // For quads...
 1829: 
 1830:          assert(false && "Element normal vector: quads not yet implemented");
 1831:          return {0.0, 0.0, 0.0};
 1832: 
 1833: 
 1834:       }
 1835:    }
 1836: 
 1837: /**
 1838:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1839:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1840:    If the segment is completely inside the element, then it returns true.
 1841: 
 1842:    This function assumes:
 1843:    - The initial point is on a side of the element. 
 1844:    - Its position is given by parameter t in the range [0,1].
 1845:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1846:       intersects the element (elements are convex).
 1847: 
 1848:    To find the intersection point, this function does the following:
 1849:    - it finds the intersection of the line segment with all the element side lines,
 1850:       except for the one that contains the initial point.
 1851:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1852:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1853:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1854:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1855:       track segment is almost parallel to the element side line.
 1856: 
 1857:    Inputs:
 1858:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1859:    @param x2, y2: other end of the line segment
 1860: 
 1861:    Outputs:
 1862:    @param side:  side that intersects the line segment (input and output)
 1863:    @param nextElement (output): element that contains the intersection point
 1864:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1865:    @param zint (input/output): Vertical coordinate of the intersection point
 1866: 
 1867:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1868:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1869:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1870: 
 1871:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1872:    (Delta) being zero.
 1873: 
 1874:    The intersection2 point happens when:
 1875:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1876:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1877:    
 1878:    Assumption: the 4 points (including those of the side segment) are different.
 1879:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1880:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1881:    If true, (xIntersect,yIntersect) is the intersection.				
 1882:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1883: **/
 1884: 
 1885: 
 1886: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1887:                                               double &t, double& tIntersect) {
 1888:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1889:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1890: 
 1891:    double closest_intersect_t = 1e10;
 1892:    bool found_intersection = false;
 1893: 
 1894:    for (int i = 0; i < i34; i++) {
 1895: 
 1896:       Side *side2 = sides[i];
 1897: 
 1898:       // (x3,y3)-(x4,y4) is the element side line
 1899:       const Point2 x3 = side2->n1->p;
 1900:       const Point2 x4 = side2->n2->p;
 1901: 
 1902:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1903:       const double delta = cross(x2 - x1, x3 - x4);
 1904: 
 1905:       if (abs(delta) > 0) {
 1906: 
 1907:          const double delta1 = cross(x3 - x1, x3 - x4);
 1908:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1909: 
 1910:          // Solves the two linear equations for tt1 and tt2
 1911:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1912:          const double tt2 = delta2/delta;
 1913: 
 1914:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1915:             closest_intersect_t = min(closest_intersect_t, tt1);
 1916:             side = side2;
 1917:             nextElement = side->otherElem(this);
 1918:             t =          clamp(tt2, small, 1.0-small);
 1919:             tIntersect = clamp(tt1, small, 1.0-small);
 1920:             found_intersection = true;
 1921:          }
 1922: 
 1923:       
 1924:       }
 1925:       else {  // parallel segments
 1926: 
 1927:          assert(false && "Parallel segments should not happen under the new code");
 1928:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1929:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1930: 
 1931:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1932:          const double dist = dot(x1 - x3, side2->n);
 1933:          if (abs(dist) < small*length(x3 - x4)) {
 1934:             const double2 unitarySide = normalize(x4 - x3);
 1935:             const double len = dot(x2 - x1, unitarySide);
 1936:             t = t + len;
 1937:             t = max(0.0, min(t, 1.0));
 1938:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1939: 
 1940: 
 1941:             // tIntersect = max(small, min(tt1, 1.0-small));
 1942:             // t = tt2;
 1943:             found_intersection = true;
 1944:          }
 1945:       }
 1946: 
 1947: 
 1948:    }
 1949: 
 1950: 
 1951:    assert(found_intersection && "No intersection found");
 1952: 
 1953:    // found_intersection should always be true, since we checked all the sides.  
 1954:    return found_intersection;
 1955: }
 1956: 
 1957: 
 1958: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1959:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1960: 
 1961:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1962:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1963:    // curElement.
 1964: 
 1965:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1966:    // And uses this velocity instead to continue the tracking.
 1967: 
 1968:    // computes the intersection point in cartesian coordinates
 1969:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1970: 
 1971:    // Nudges the point to the barycenter of the element. 
 1972:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1973:    // next segment intersects the element sides. 
 1974:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1975: 
 1976: 
 1977:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1978:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1979:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1980:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1981: 
 1982:    // If the side is an open boundary, the tangential velocity is set to zero.
 1983:    if (nextSide->isBnd()) vtan = 0.0;
 1984: 
 1985:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1986:    const double us = vtan*nextSide->t().x;
 1987:    const double vs = vtan*nextSide->t().y;
 1988:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 1989: 
 1990:    
 1991:    // The end of this tracking segment is now the intersection point.
 1992:    xt = {intersection.x, intersection.y, zint};
 1993: 
 1994: 
 1995:    u_int = {us, vs, ws};
 1996:    
 1997: }
 1998: 
 1999: /**
 2000:  * Tracks a particle through elements and vertical levels in the mesh.
 2001:  * 
 2002:  * @param x0,y0,z0     Starting position coordinates
 2003:  * @param xt,yt,zt     Target position coordinates
 2004:  * @param dtb          Time step for tracking
 2005:  * @param u_int        Initial velocity components
 2006:  * @param nextElem     Starting/resulting element index
 2007:  * 
 2008:  * @return Status code of type trackExitCodes
 2009:  * 
 2010:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2011:  * of the details are different. The idea is that the code requires less branches and is better fit
 2012:  * for GPU execution.
 2013:  * 
 2014:  * The main ideas here are:
 2015:  * - The starting point is expected to be in the starting element.
 2016:  * - since the starting point is inside the element, there are only two cases: 
 2017:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2018:  *     (b) it does not and (xt,yt) is already in the starting element.
 2019:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2020:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2021:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2022:  * - tt1 can be positive or negative. We only consider the positive values.
 2023:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2024:  * - The next intersection will occur at the smallest positive tt1.
 2025:  * - This intersection will be the next (x0,y0) position.
 2026:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2027:  *   of getting stuck in a loop.
 2028:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2029:  *   was found.
 2030:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2031:  */
 2032: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2033:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2034:                                                        const Side *origSide) {
 2035:                                                             
 2036:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2037:    // else to do. This means that the full step occurred within the current element.
 2038:    assert(!isDry && "Starting element is dry");
 2039:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2040: 
 2041:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2042: 
 2043:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2044:       assert(!isDry && "Target point is inside a dry element");
 2045: 
 2046:       interpolateVelocities(xt, u_int);
 2047: 
 2048:       nextElem = this;
 2049: 
 2050: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2051:       return true;
 2052:    }
 2053: 
 2054: 
 2055:    
 2056: 
 2057:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2058:    
 2059:    double t;
 2060:    Side *nextSide = nullptr;
 2061:    double tIntersect = 1e10;
 2062: 
 2063: 
 2064:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2065:    // (x0,y0) is inside the element but the target point is not.
 2066:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2067:    assert(found_intersection && "No intersection found at %d");
 2068: 
 2069:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2070: 
 2071:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2072: 
 2073:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2074:    if (nextElem != nullptr && !nextElem->isDry) nextElem->nudgeToBarycenter(xtmp);
 2075: 
 2076:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2077:    xt = {xtmp.x, xtmp.y, zint};
 2078: 
 2079:    // if the tracking segment goes out of water (either dry or edge boundary)
 2080:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2081: 
 2082: 
 2083:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2084: 
 2085: 
 2086:       // When this happens, the backtracking stops.
 2087:       dt = time_rm;
 2088: 
 2089:       // In this case, the next element is again the current element.
 2090:       nextElem = this;
 2091: 
 2092:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2093:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2094:       return true;    
 2095:    }
 2096: 
 2097: 
 2098:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2099:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2100:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2101: 
 2102:    nextElem->interpolateVelocities(xt, u_int); 
 2103: 
 2104:    assert(nextElem != this && "Next element is the same as the current element");
 2105: 
 2106:    return true;
 2107: }
 2108: 
 2109: 
 2110: __inline__ __device__ double Element::computeSignedArea(void) const {
 2111:    // Compute the area of the element
 2112: 
 2113:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2114: 
 2115:    // In the quad case we need to add the area of the other triangle.
 2116:    if (isQuad()) {
 2117:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2118:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2119:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2120:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2121: 
 2122:       res += ar1;
 2123:    }
 2124: 
 2125:    return res;
 2126: }
 2127: 
 2128: 
 2129: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2130:                                                                 (nodes[1]->isDry2()) ||
 2131:                                                                 (nodes[2]->isDry2()) ||
 2132:                                                                 (i34==4 && nodes[3]->isDry2());
 2133: }
 2134: 
 2135: __inline__ __device__ double Element::detJ_eta(void) const {
 2136:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2137:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2138: }
 2139: 
 2140: __inline__ __device__ double Element::detJ_xi(void) const {
 2141:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2142:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2143: }
