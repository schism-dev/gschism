  624:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  625:       // Check if the point (xt,yt) is inside the element
  626:       double shpCoords[4];
  627: 
  628:       bool res = computeShapeCoords(xt, shpCoords, false);
  629: 
