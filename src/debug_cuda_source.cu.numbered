  578:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  579:    
  580:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  581: 
  582:    __device__ Vector2 grad2(double *a) const
  583:    {
  584:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  585:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  586:       if (isQuad()) {
  587:          gx += a[3]*gradPhi[3].x;
  588:          gy += a[3]*gradPhi[3].y;
  589:       }
  590:       return {gx, gy};
  591:    }
  592: 
  593:    __device__ Vector2 grad2(double Node::* field) const
  594:    {
  595:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  596:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  597:       if (isQuad()) {
  598:          gx += (nodes[3]->*field)*gradPhi[3].x;
  599:          gy += (nodes[3]->*field)*gradPhi[3].y;
  600:       }
  601:       return {gx, gy};
  602:    }
  603: 
  604:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  605:    __device__ __forceinline__ Vector3 n(int k) const {
  606:       double area3D;
  607:       return n(k, area3D);
  608:     }
