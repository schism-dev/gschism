 1422: // Helper functions for computing the local node index at a given offset from another.
 1423: __device__ __inline__ int nxq(int offset, int index, int size) {
 1424:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1425:    // to the index to make it positive
 1426:    assert(index + offset + 16*size >= 0);
 1427:    return (index + offset + 16*size) % size;  
 1428: }
 1429: 
 1430: __device__ __inline__ int nxq(int index, int size) {
 1431:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1432:    // to the index to make it positive
 1433:    assert(index + 16*size >= 0);
 1434:    return (index + 16*size) % size; 
 1435: }
