 1924: 
 1925: 
 1926: /**
 1927:  * Find the element that contains the target point.
 1928:  * 
 1929:  * @param x0,y0,z0     Starting position coordinates
 1930:  * @param xt,yt,zt     Target position coordinates
 1931:  * @param dtb          Time step for tracking
 1932:  * @param u_int        Initial velocity components
 1933:  * @param nextElem     Starting/resulting element index
 1934:  * 
 1935:  * @return Status code of type trackExitCodes
 1936:  * 
 1937:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1938:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1939:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1940:  * as close the the segment AB as possible, the next point at each iteration is computed
 1941:  * along segment AB, but just after the current element.
 1942:  */
 1943: 
 1944: 
 1945: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1946: 
 1947:    constexpr int MAX_ITERATIONS = 40;
 1948: 
 1949:    int iter = 0;
 1950:    double fac = 0.00001;
 1951:    while (iter < MAX_ITERATIONS) {
 1952:       iter++;
 1953: 
 1954:       Bool4 isLeft, isObtuse, isBisector;
 1955:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 1956: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 1957:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 1958: 
 1959: 
 1960:       if (isValid.none()) 
 1961:       // Inside the element if none of the edges is a valid continuation
 1962:       {
 1963:          // Just returns true and the element (curElem) is unchanged).
 1964:          // This means that the algorithm has found the element that contains the target point.
 1965:          return true;
 1966:       }
 1967:       else { // Outside the element
 1968: 
 1969:          // Outside this element. Pick the first valid exit side and cross.
 1970:          lastCrossSide = curElem->sides[isValid.firstOne()];
 1971:          Element *prevElem = curElem;
 1972:          curElem = lastCrossSide->otherElem(curElem);
 1973: 
 1974:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 1975:          // along the boundary.
 1976:          if (curElem == nullptr || curElem->isDry) {
 1977:          
 1978:             curElem = prevElem;
 1979:             return false;
 1980:          }
 1981:          
 1982:       }
 1983: 
 1984:    }
 1985: 
 1986:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 1987: }
 1988: 
 1989: 
