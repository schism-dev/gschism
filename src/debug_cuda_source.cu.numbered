  829:    int**    indptr_ptrs,
  830:    int*     nrows,
  831:    int*     ncols,
  832:    double** x_ptrs,
  833:    double** b_ptrs);
  834: 
  835: 
  836: // ------------------------------------------------------------
  837: 
  838: 
  839: struct Element {
  840: 
  841:    // Geometry information
  842:    int idx;                   // Index of the element
  843:    int16_t i34;               // Number of sides for the element 
  844:    Side *sides[4];            // Sides of the element
  845:    Node *nodes[4];            // Nodes of the element
  846:    Element *nghbElems[4];     // Neighbors of the element
  847: 
  848:    int16_t kb;                // Bottom index of the element
  849:    double area;               // Area of the element
  850:    double ssign[4];           // Sign associated with each side of an element
  851:    double radius;             // Element equivalent radii
  852: 
  853:    Frame<ics> frame;
  854: 
  855:    Vector2 gradPhi[4];        // Derivatives of shape functions
  856:    Vector2 gradEta;           // Gradient of free surface elevation
  857:    Vector2 gradPr;            // Gradient of pressure    
  858:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  859: 
  860:    bool isDry;                // True if the element is dry
  861: 
  862:    Point2 center;            // Element center coordinates (global coordinates)
  863: 
  864:    double depth;              // Depth at element (min of all nodes)
  865:    double z[nvrt];            // z-coord  (local frame - vertical up)
  866: 
  867:    // Physical information
  868:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  869: 
  870:    static const bool isblock = false;              // Always false
  871: 
  872:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  873:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  874: 
  875:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  876:    
  877: 
  878:    double vsource;            // Volumetric source/sink term [m^3/s]
  879: 
  880:    double rho[nvrt];          // Density at each prism center
  881:    double rho_mean[nvrt];     // Mean density at each prism center
  882:    CubicSpline rho_spl;
  883:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  884:    double rho_z[nvrt];        // First derivative of density at each prism center
  885:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  886:    
  887: 
  888:    __inline__ __device__ Point2 outputCoords(void) const;
  889: 
  890:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  891: 
  892:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  893:    // If ics == 2, convert the global point to the local frame of the element
  894:       
  895:       if constexpr (ics == 1) {
  896:          return p;
  897:       } else {
  898:          const Point3 c = {center.x, center.y, centerZ()};
  899:          return frame.G2L(p - c);
  900:       }
  901:    }
  902: 
  903:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
  904:    // If ics == 2, convert the local point to a global point
  905:       
  906:       if constexpr (ics == 1) {
  907:          return p;
  908:       } else {
  909:          const Point3 c = {center.x, center.y, centerZ()};
  910:          return c + frame.L2G(p);
  911:       }
  912:    }
  913: 
  914:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  915:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  916: 
  917:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  918:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  919: 
  920:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  921:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  922:       // Find the local index of the node in the element (0,1,2,3)
  923:       int res = __ffs((nodes[0] == node) | 
  924:                      ((nodes[1] == node) << 1) | 
  925:                      ((nodes[2] == node) << 2) | 
  926:                      ((nodes[3] == node) << 3)) - 1;
  927:       
  928:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  929:       return res;  
  930:    }
  931: 
  932:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  933:       // Find the local index of the side in the element (0,1,2,3)
  934:       int res = __ffs((sides[0] == side) | 
  935:                      ((sides[1] == side) << 1) | 
  936:                      ((sides[2] == side) << 2) | 
  937:                      ((sides[3] == side) << 3)) - 1;
  938:       
  939:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  940:       return res;
  941:    }
  942: 
  943:    __inline__ __device__ int findLevel(double z1, int k) const {
  944:       // Starting at index k, find sequentially the level that contains z
  945: 
  946:       // For testing purposes, forgets k and performs a full search.
  947:       for (k = kb; k < nvrt - 1; k++) {
  948:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  949:       }
  950:       return nvrt - 2;
  951: 
  952: 
  953:       // if z is already betweeen z[k] and z[k+1], return k
  954:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  955:       else if (z1 <  z[k]) { 
  956:          // Search for increasing levels
  957:          for (int kk = k; kk < nvrt - 1; kk++) {
  958:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  959:          }
  960:          return nvrt - 1;
  961:       }
  962:       else {
  963:          // Search for decreasing levels
  964:          for (int kk = k; kk >= kb; kk--) {
  965:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  966:          }
  967:          return 0;
  968:       }
  969:    }
  970: 
  971:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  972:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  973: 
  974: 
  975:    __device__ __forceinline__ double centerZ(void) const;
  976: 
  977:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  978:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  979:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  980:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
  981:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
  982:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  983:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
  984:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
  985:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  986: 
  987: 
  988:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  989:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  990:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  991:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  992:        const double eta = (idxNode & 1) ? +g : -g;
  993:        const double xi  = (idxNode & 2) ? +g : -g;
  994:        return {eta, xi};
  995:    }  
  996: 
  997: 
  998: 
  999:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1000:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1001:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1002:    }
 1003: 
 1004:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1005:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1006:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1007:    }   
 1008: 
 1009:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1010:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1011:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1012:    }      
 1013:    
 1014:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1015: 
 1016:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1017: 
 1018:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1019:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
