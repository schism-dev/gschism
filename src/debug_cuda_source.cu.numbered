 1774:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1775:       // Compute the different time ramps used in the code 
 1776:       // This function is performed by just one thread
 1777: 
 1778:       rampbc = 1.0;
 1779:       if constexpr(ibc == 0) {
 1780:          if (drampbc > 0.0) {
 1781:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1782:          } else {
 1783:             rampbc = 1.0;
 1784:          }
 1785:       }
 1786: 
 1787:       if (nws != 0) {
 1788:          if (drampwind > 0.0) {
 1789:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1790:          } else {
 1791:             rampwind = 1.0;
 1792:          }
 1793:       }
 1794: 
 1795:       if (drampwafo > 0.0) {
 1796:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1797:       } else {
 1798:          rampwafo = 1.0;
 1799:       }
 1800: 
 1801:       // For source/sinks
 1802:       if (if_source && dramp_ss > 0.0) {
 1803:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1804:       } else {
 1805:          ramp_ss = 1.0;
 1806:       }
 1807: 
 1808:       if (dramp > 0.0) {
 1809:          ramp = tanh(2.0*time/86400.0/dramp);
 1810:       } else {
 1811:          ramp = 1.0;
 1812:       }
 1813: 
 1814: 
 1815:    }
