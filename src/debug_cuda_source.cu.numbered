 3834: extern "C" {
 3835:    __global__ void solverCopyResult(double* x) {
 3836:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3837:       NODE(node);
 3838:       const int idx = node->idx;
 3839: 
 3840:       node->mX = x[idx];
 3841:    }
 3842: }
 3843: 
 3844: extern "C" {
 3845:    __global__ void rollUpElevation(void) {
 3846: 
 3847:       NODE(node);
 3848: 
 3849:       node->eta1 = node->eta2;
 3850: 
 3851:    }
 3852: 
 3853: 
 3854:    __global__ void backtrackAllNodes(void) {
 3855: 
 3856:       // max/min # of sub-divisions
 3857:       const int ndelt_max = max(1.0, dt/dtb_min);
 3858:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3859: 
 3860:       // Removed all references to swild98 XXX
 3861:       // swild98=0.d0 !init
 3862: 
 3863: 
 3864:       SIDE(side);
 3865: 
 3866:       const int kb = side->kb;
 3867: 
 3868: 
 3869:       // Initialize btrack velocities to the actual velocities at the side 
 3870:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3871: 
 3872:       if (side->isDry) return;
 3873: 
 3874: 
 3875:       // Checks that at least one element is not dry
 3876:       const Element *elem1 = side->elems[0];
 3877:       const Element *elem2 = side->elems[1];
 3878: 
 3879: 
 3880:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3881:       
 3882:       // XXXXXX
 3883:       // !swild_tmp to store global coord. of the starting side
 3884:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3885:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3886:       // !Use sframe2 
 3887:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3888: 
 3889: 
 3890:       for (int k = kb; k < nvrt; k++) {
 3891:       //  Initialize (xt,yt,zt), nnel and vel.
 3892:       //  For ics=2, the coordinates are in local frames
 3893:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3894: 
 3895: 
 3896:          const int iadvf = side->iadv();  // Advection flag
 3897: 
 3898:          Point3 xt;
 3899:          if constexpr(ics==1) {
 3900:             xt = side->center3D(k); 
 3901:          }
 3902:          else // lat/lon; in side lat/lon frame
 3903:          {
 3904:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3905:          // XXX IMPLEMENT THIS
 3906:       //          xt=0.d0
 3907:       //          yt=0.d0
 3908:       //          !centroid coord. for nudging
 3909:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3910:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3911:          }  // ics
 3912: 
 3913: 
 3914: 
 3915:          // If on land or open boundary...
 3916:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3917:          
 3918:          const double vmag = length(side->u2[k]);
 3919: 
 3920:          if (vmag <= velmin_btrack) {
 3921:             // No activity 
 3922: 
 3923:             side->btu[k] = side->u2[k];
 3924:             
 3925:          } else {  // do btrack
 3926: 
 3927:             // Compute number of sub-divisions based on local gradients 
 3928:             // XXX IS THIS NECESSARY?
 3929:             double suma = 0.0;
 3930:             int icount = 0;
 3931:             for (int ii=0; ii<2; ii++) {
 3932: 
 3933:                const Element *elem = side->elems[ii];
 3934:                  
 3935:                if (elem == nullptr) continue;
 3936: 
 3937:                icount++;
 3938: 
 3939:                // Not strictly along z; in ll frame for ics=2
 3940: 
 3941:                double utmp[4];
 3942:                double vtmp[4];
 3943:                for (int jj = 0; jj < elem->i34; jj++) {
 3944: 
 3945:                   const Node *node = elem->nodes[jj];
 3946: 
 3947:                   if constexpr(ics==1) {
 3948:                      utmp[jj] = node->u2[k].x;
 3949:                      vtmp[jj] = node->u2[k].y;  
 3950:                   } else {
 3951:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3952:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3953:                   }
 3954:                } // for jj
 3955: 
 3956:                const Vector2 grad_u = elem->grad2(utmp); 
 3957:                const Vector2 grad_v = elem->grad2(vtmp);
 3958: 
 3959:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3960:             } // for ii
 3961: 
 3962:             assert(icount > 0 && "Impossible 77");
 3963: 
 3964:             // '4' is somewhat arbitrary
 3965:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3966: 
 3967:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3968:          
 3969: 
 3970:             Vector3 u_int = {0.0, 0.0, 0.0};
 3971: 
 3972:             side->btrack(k, dt, dtbk, u_int);
 3973:             side->btu[k] = toVector2(u_int);
 3974:                
 3975:          } // if vmag (do backtrack)
 3976: 
 3977:       } // for k=kb,nvrt-1
 3978: 
 3979:    }
 3980: 
 3981: } // extern "C"
 3982: 
 3983: template<int nc>
 3984: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3985: 
 3986: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3987: //
 3988: // a,b,c,rhs: input vectors and are not modified by this program.
 3989: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3990: // rhs is the r.h.s.
 3991: // n: actual rank of the system.
 3992: // rows in u() and rhs();
 3993: // u: output with nc columns (transposed to rows)
 3994: // gam: a working array.
 3995: //
 3996: // NOTES:
 3997: // This is a template function that allows for different numbers of columns in the rhs vector.
 3998: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3999: 
 4000:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4001:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4002: 
 4003:    double bet = b[0];
 4004:    if constexpr (nc == 1) {
 4005:       u[0] = rhs[0]/bet;
 4006:    } else {
 4007:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4008:    }
 4009: 
 4010:    for (int j = 1; j < n; j++) {
 4011:       gam[j] = c[j - 1]/bet;
 4012:       bet = b[j] - a[j]*gam[j];
 4013: 
 4014:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4015: 
 4016:       if constexpr (nc == 1) {
 4017:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4018:       } else {
 4019:          for (int l = 0; l < nc; l++) {
 4020:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4021:          }
 4022:       }
 4023:    }
 4024: 
 4025:    // Back-substitution
 4026:    for (int j = n - 2; j >= 0; j--) {
 4027:       if constexpr (nc == 1) {
 4028:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4029:       } else {
 4030:          for (int l = 0; l < nc; l++) {
 4031:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4032:          }
 4033:       }
 4034:    }
 4035: }
 4036: 
 4037: 
 4038: 
 4039: // Helper function that contains the core algorithm
 4040: template<typename XAccessor, typename YAccessor>
 4041: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4042:                                     double  yp_top, double  yp_bot, 
 4043:                                     CubicSpline &spline) {
 4044:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4045:    // 
 4046:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4047:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4048:    //
 4049:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4050:    // 
 4051:    // Inputs: 
 4052:    //            n: dimension for x etc; # of data pts (>=2);
 4053:    //            getX, getY: functions to access x,y coordinates
 4054:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4055:    //     Output: 
 4056:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4057: 
 4058:    const int n = k2 - k1 + 1;
 4059:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4060: 
 4061:    // Allocate memory for the splines
 4062:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4063:    spline.x   = new double[n];
 4064:    spline.y   = new double[n];
 4065:    spline.yp  = new double[n];
 4066:    spline.ypp = new double[n];
 4067: 
 4068:    for (int k=k1; k<=k2; k++) {
 4069:       spline.x[k] = getX(k);
 4070:       spline.y[k] = getY(k);
 4071:    }
 4072: 
 4073:    // This is to simplify expressions later
 4074:    double *x = spline.x;
 4075:    double *y = spline.y;
 4076: 
 4077:    double *a = nullptr;
 4078:    double *b = nullptr;
 4079:    double *c = nullptr;
 4080:    double *gam = nullptr;
 4081:    double *rhs = nullptr;
 4082:    
 4083: 
 4084:       a = new double[n];   // Lower diagonal
 4085:       b = new double[n];   // Diagonal
 4086:       c = new double[n];   // Upper diagonal
 4087:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4088:       rhs = new double[n]; // Right-hand side
 4089: 
 4090:    for (int k=k1; k<=k2; k++) {
 4091:       if (k == k1) {
 4092:          // Bottom level
 4093:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4094:          b[k] = (x[k+1] - x[k])/3.0;
 4095:          c[k] = b[k]/2.0;
 4096:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4097:       } else if (k == n - 1) {
 4098:          // Top level (surface)
 4099:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4100:          b[k] = (x[k] - x[k-1])/3.0;
 4101:          a[k] = b[k]/2.0;
 4102:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4103:       } else {
 4104:          // Intermediate levels
 4105:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4106:          b[k] = (x[k+1] - x[k-1])/3.0;
 4107:          a[k] = (x[k  ] - x[k-1])/6.0;
 4108:          c[k] = (x[k+1] - x[k  ])/6.0;
 4109:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4110:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4111:       }
 4112:    }
 4113: 
 4114:    // Solve the tridiagonal system
 4115:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4116:    
 4117:    spline.yp[k1] = yp_bot;
 4118:    spline.yp[k2] = yp_top;
 4119: 
 4120:    // Compute rest of 1st derivatives using the splines
 4121:    for (int k=k1+1; k<k2; k++) {
 4122:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4123:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4124:    }
 4125:    
 4126:    delete[] a;
 4127:    delete[] b;
 4128:    delete[] c;
 4129:    delete[] gam;
 4130:    delete[] rhs;
 4131: 
 4132: }
 4133: 
 4134: // Array version
 4135: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4136:                                 double y_top, double y_bot, 
 4137:                                 CubicSpline &spline) {
 4138:    auto getX = [x] (int k) { return x[k]; };
 4139:    auto getY = [y] (int k) { return y[k]; };
 4140:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4141: }
 4142: 
 4143: // Lambda version - allows custom access patterns
 4144: template<typename XFunc, typename YFunc>
 4145: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4146:                                 double y_top, double y_bot,
 4147:                                 CubicSpline &spline) {
 4148:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4149: }
