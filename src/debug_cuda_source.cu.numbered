  598: // ----------------------------- Turbulence -----------------------------
  599: 
  600: 
  601: 
  602: constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
  603: constexpr double veg_cfpsi = 0.16;
  604: 
  605: 
  606: template<TurbulenceModel Model>
  607: struct Turbulence {};   
  608: 
  609: // GLS turbulence model
  610: template<>
  611: struct Turbulence<TurbulenceModel::GLS> {
  612:    using enum TurbulenceSubmodel;
  613:    using enum StabilityModel;
  614: 
  615:    double tke[nvrt];    // TKE
  616:    double mxl[nvrt];    // mixing length for GLS
  617:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  618:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  619:    
  620:    
  621: 
  622:    __device__ __forceinline__ constexpr double cpsi1() const {
  623:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  624:       else if constexpr (turbSubmodel == KL)             return 0.9;
  625:       else if constexpr (turbSubmodel == KE)             return 1.44;
  626:       else if constexpr (turbSubmodel == KW)             return 0.555;
  627:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  628:       else { assert(false && "unknown submodel"); return 0.0; }
  629:    }
  630: 
  631:    
  632:    __device__ __forceinline__ constexpr double cpsi2() const {
  633:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  634:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  635:       else if constexpr (turbSubmodel == KL)             return 0.5;
  636:       else if constexpr (turbSubmodel == KE)             return 1.92;
  637:       else if constexpr (turbSubmodel == KW)             return 0.833;
  638:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  639:       else { assert(false && "unknown submodel"); return 0.0; }
  640:    }
  641: 
  642: 
  643:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  644: 
  645:    __device__ __forceinline__ double cpsi3(double N2) const {
  646: 
  647:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  648:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  649: 
  650:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  651: 
  652:       if constexpr (turbSubmodel == MellorYamada) {
  653:          return 0.9;   
  654: 
  655:       } else { // Other GLS submodels
  656: 
  657: 
  658:          if (N2 > 0.0) { // unstable (inverse stratification)
  659:             return 1.0;   
  660: 
  661:          } else { // stable (regular stratification)
  662: 
  663:             if      constexpr (turbSubmodel == KL)             return 2.53;
  664:             else if constexpr (turbSubmodel == KE)             return -0.52;
  665:             else if constexpr (turbSubmodel == KW)             return -0.58;
  666:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  667:             else { assert(false && "unknown submodel"); return 0.0; }
  668:          }
  669: 
  670:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  671: 
  672:    }
  673: 
  674:    
  675:    __device__ __forceinline__ constexpr double rpub(void) const {
  676:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  677:       else if constexpr (turbSubmodel == KL)             return  0.0;
  678:       else if constexpr (turbSubmodel == KE)             return  3.0;
  679:       else if constexpr (turbSubmodel == KW)             return -1.0;
  680:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  681:       else { assert(false && "unknown submodel"); return 0.0; }
  682:    }
  683: 
  684: 
  685:    __device__ __forceinline__ constexpr double rmub(void) const {
  686:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  687:       else if constexpr (turbSubmodel == KL)             return 1.0;
  688:       else if constexpr (turbSubmodel == KE)             return 1.5;
  689:       else if constexpr (turbSubmodel == KW)             return 0.5;
  690:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  691:       else { assert(false && "unknown submodel"); return 0.0; }
  692:    }
  693: 
  694: 
  695:    __device__ __forceinline__ constexpr double rnub(void) const {
  696:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  697:       else if constexpr (turbSubmodel == KL)             return  1.0;
  698:       else if constexpr (turbSubmodel == KE)             return -1.0;
  699:       else if constexpr (turbSubmodel == KW)             return -1.0;
  700:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  701:       else { assert(false && "unknown submodel"); return 0.0; }
  702:    }
  703: 
  704: 
  705:    __device__ __forceinline__ constexpr double schk(void) const {
  706:       if      constexpr (turbSubmodel == KL)             return 2.44;
  707:       else if constexpr (turbSubmodel == KE)             return 1.0;
  708:       else if constexpr (turbSubmodel == KW)             return 2.0;
  709:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  710:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  711:    }
  712: 
  713: 
  714:    __device__ __forceinline__ constexpr double schpsi(void) const {
  715:       if      constexpr (turbSubmodel == KL)             return 2.44;
  716:       else if constexpr (turbSubmodel == KE)             return 1.3;
  717:       else if constexpr (turbSubmodel == KW)             return 2.0;
  718:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  719:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  720:    }
  721: 
  722: 
  723:    __device__ __forceinline__ constexpr double tkemin(void) const {
  724:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  725:          return 5.0e-6;
  726:       else
  727:          return 7.6e-6; // Warner et al., OM 2005
  728:    }
  729: 
  730: 
  731:    __device__ __forceinline__ constexpr double psimin(void) const {
  732:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  733:          return 1.0e-8;
  734:       else
  735:          return 1.0e-12; // Warner et al., OM 2005
  736:    }
  737: 
  738:    __device__ __forceinline__ constexpr double epsmin(void) const {
  739:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  740:    }
  741: 
  742:    __device__ __forceinline__ double mxlmin(double depth) const;
  743: 
  744:    __device__ __forceinline__ double diffmin(void) const {
  745:       // XXXXXXXX: This is a placeholder.
  746:       return 1.0e-6;
  747:    }
  748: 
  749:    __device__ __forceinline__ double diffmax(void) const {
  750:       return 1.0;
  751:    }
  752: 
  753:    
  754:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  755: 
  756:    __device__ __forceinline__ double N2(Node *node, int k) const;
  757: 
  758: 
  759:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  760: 
  761:    __device__ void computeDiffusivities(Node *node);
  762: 
  763:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  764: 
  765: 
  766:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  767:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  768:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  769:    }
  770: 
  771: 
  772:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  773:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  774:    }
  775: 
  776: };
