 5046: extern "C" {
 5047: 
 5048:    __global__ void scaleGravity(double loadtide_coef) {
 5049: 
 5050: 
 5051:       NODE(node);
 5052: 
 5053:       // SAL option: scale gravity
 5054:       if constexpr(iloadtide==2) {  // simple const
 5055:          node->grav2 = grav*(1.0 - loadtide_coef);
 5056: 
 5057:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5058:         
 5059:           const double depth = max(node->depth, 0.0);
 5060:           const double tmp1 = sqrt(depth);
 5061:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5062:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5063:                              2.6969e-13*depth*depth*depth*tmp1;
 5064:           
 5065:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5066:           
 5067: 
 5068: 
 5069:           node->grav2 = grav*(1.0 - beta_bar);
 5070: 
 5071:       } else {  // iloadtide=0,1
 5072:           node->grav2 = grav;
 5073: 
 5074:       }
 5075: 
 5076:    }
 5077: 
