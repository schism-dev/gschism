 6275:    __global__ void resetVelocityOpenBndNodes(void) {
 6276:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6277: 
 6278:       NODE_BND(nodebnd);
 6279: 
 6280:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6281:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6282:       }
 6283: 
 6284:    }
 6285: 
 6286: 
 6287:    __global__ void setVelocityOpenBndNodes(void) {
 6288:    // For open boundary nodes sets their velocity to the imposed values.
 6289: 
 6290:       SIDE_BND(sidebnd);
 6291: 
 6292:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6293:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6294:          // to its segment to the average of the side velocity.
 6295: 
 6296:          for (int k = 0; k < nvrt; k++) {
 6297:             Node *n1 = sidebnd->side->n1;
 6298:             Node *n2 = sidebnd->side->n2;
 6299: 
 6300: 
 6301:             Vector2 n1_u2(n1->u2[k]);
 6302:             Vector2 n2_u2(n2->u2[k]);
 6303: 
 6304:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6305:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6306:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6307:             }
 6308:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6309:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6310:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6311:             }
 6312: 
 6313:          }
 6314: 
 6315:       }
 6316: 
 6317:    }
 6318: 
 6319: 
 6320:    __global__ void computeVerticalVelocity(void) {
 6321:       // Computes the vertical velocity at the (2D) element's centroid.
 6322:       // In this function we will be considering volumetric elements, with side faces and a 
 6323:       // bottom and a top face. We will call them SFs, BF and TF.
 6324:       // It computes the flux coming from BF and the SFs.
 6325:       // If the bed is moving, it takes that into account.
 6326:       // Since water is incompressible, the integral of the velocity times the normal vector
 6327:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6328:       // and the BF is equal to the flux going out from the TF.
 6329:       // TF = - BF - sum(SFs).
 6330:       // It then computes the horizontal velocity at the center of TF.
 6331:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6332:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6333:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6334: 
 6335:       ELEM(elem);
 6336: 
 6337:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6338: 
 6339:       if (elem->isDry) return;
 6340: 
 6341:       const int kb = elem->kb;
 6342:       const bool isTri = elem->isTri();
 6343: 
 6344:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6345: 
 6346:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6347:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6348:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6349: 
 6350:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6351: 
 6352:       double area3D;
 6353: 
 6354:       // Bottom face flux
 6355:       double bottomFlux = 0.0;
 6356:       Vector2 u2meanBottom = {0.0, 0.0};
 6357:       const Vector2 gradh = elem->grad2(&Node::depth);
 6358:       if constexpr(imm==2) {
 6359:          Vector3 ubed;
 6360: 
 6361:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6362:          // updateBDEF(ubed);
 6363:      
 6364:          // const double bflux0 = dot(ubed, elem_n1);
 6365: 
 6366:          // elem->w[kb] += ubed.z;
 6367:       }
 6368:       else {
 6369:          Vector2 umean;
 6370:          if constexpr(ics == 1) {
 6371:             u2meanBottom = elem->mean(kb, &Side::u2);
 6372:          }
 6373:          else {
 6374:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6375:          }
 6376: 
 6377:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6378:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6379: 
 6380:          bottomFlux = - dot(gradh, u2meanBottom);
 6381:       } // if imm
 6382: 
 6383:       // Compute w for kb+1 to nvrt-1
 6384:       for (int l = kb; l < nvrt - 1; l++) {
 6385: 
 6386:          // normal vector to the top face of the "volumetric" element (3D)
 6387:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6388: 
 6389:          // Compute the total flux at the sides
 6390:          double sideFlux = 0.0;
 6391: 
 6392:          for (int j = 0; j < elem->i34; j++) {
 6393:             const Side *side = elem->sides[j];
 6394: 
 6395:             const double sideArea = side->area(l);
 6396:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6397:             const double sign = elem->ssign[j]; 
 6398: 
 6399:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6400:          }
 6401:          
 6402:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6403:          //velocities at the centers of the sides
 6404:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6405: 
 6406:          // The flx at the top ace can be computed from the other flows.
 6407:          const double topFlux = - sideFlux - bottomFlux;
 6408:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6409: 
 6410:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6411: 
 6412:          elem_n1 = elem_n2;
 6413: 
 6414:          bottomFlux = - topFlux;
 6415:       }
 6416:    }  
 6417: 
 6418: 
 6419: 
 6420: 
 6421: 
 6422: 
 6423: 
