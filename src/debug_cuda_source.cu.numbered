 2739: 
 2740: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2741: //          // Similarly, we use tt2 to compute the intersection point.
 2742: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2743: //             xIntersect = x3 + (x4 - x3)*tt2;
