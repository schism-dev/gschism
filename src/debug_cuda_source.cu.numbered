 4617:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4618: 
 4619:       SIDE(side);
 4620: 
 4621:       side->U = {0.0, 0.0}; 
 4622:          
 4623:       if(side->isDry) return;
 4624: 
 4625:       // Vertically integrated velocity U (in ll if ics=2)
 4626:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4627:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4628:          side->U += side->Dz(k + 1)*uc;  
 4629:       }
 4630: 
 4631:    }
