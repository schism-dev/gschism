 8115: __global__ void printMatrix(bool full) {
 8116:    // Debugging: print the matrix
 8117: 
 8118:    const int size = mesh->np;
 8119:    double sum = 0.0;
 8120:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8121:       const Node *node = mesh->localNodeData + idx_node;
 8122:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8123:       for (int j = 0; j < node->numNodes; j++) {
 8124:          Node* nbNode = node->nodes[j];
 8125:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8126:          sum += node->coeffMatrix[j];
 8127:       }
 8128:       if (full) printf("]\n");
 8129: 
 8130: 
 8131:    }
 8132:    if (!full) printf("sum=%lf\n", sum);
 8133: }
