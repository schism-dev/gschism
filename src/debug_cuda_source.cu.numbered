 9030: __global__ void getStructSizes(int* sizes)  {
 9031:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9032:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9033:       sizes[0] = (int)sizeof(Node);
 9034:       sizes[1] = (int)sizeof(Element);
 9035:       sizes[2] = (int)sizeof(Side);
 9036:       sizes[3] = (int)sizeof(NodeBoundary);
 9037:       sizes[4] = (int)sizeof(SideBoundary);
 9038:       sizes[5] = (int)sizeof(BoundarySegment);
 9039: }
