  299: // ------------------------------------------------------------------------------------------------
  300: 
  301: 
  302: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  303:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  304:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  305: }
  306: 
  307: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  308:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  309:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  310: }
  311: 
  312: 
  313: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  314:    x3 = y1*z2 - y2*z1;
  315:    y3 = x2*z1 - x1*z2;
  316:    z3 = x1*y2 - x2*y1;
  317: }
  318: 
  319: 
  320: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  321: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  322: 
  323:    const double radius2 = dot(p, p);
  324:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  325:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  326: 
  327:    rlon = atan2(p.y, p.x); // (-pi,pi]
  328: 
  329:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  330:       rlat = asin(p.z/sqrt(radius2));
  331:    } else {
  332:       rlat = asin(p.z/rearth_pole);
  333:    }
  334:   
  335: }
  336: 
  337: __inline__ __device__ void Error(const char* msg) {
  338:    printf("Error: %s\n", msg);
  339:    assert(false);
  340: }
  341: 
  342: struct Tracers {
  343:     double tracer[N_TRACERS];
  344: };
  345: 
  346: 
  347: 
  348: struct Frame {
  349:    double _t[9]; // t stands for tensor.
  350: 
  351:    // Access the tensor in Fortran order
  352:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  353: 
  354:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  355: 
  356:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  357: 
  358:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  359:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  360:       sincos(ar2, &sin_ar2, &cos_ar2);
  361: 
  362:       t(0,0) = -sin_ar1;
  363:       t(1,0) =  cos_ar1;
  364:       t(2,0) =  0.0;
  365:       t(0,1) = -cos_ar1*sin_ar2;
  366:       t(1,1) = -sin_ar1*sin_ar2;
  367: 
  368:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  369: 
  370:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  371:       assert (ar4!=0.0 && "GRID: ar4=0");
  372: 
  373:       const double ar4_inv = 1.0/ar4;
  374:       t(0,1) = t(0,1)*ar4_inv;
  375:       t(1,1) = t(1,1)*ar4_inv;
  376:       t(2,1) = t(2,1)*ar4_inv;
  377: 
  378:       // The third vector is the cross product of the first two
  379:       crossProduct(t(0,0), t(1,0), t(2,0), 
  380:                    t(0,1), t(1,1), t(2,1), 
  381:                    t(0,2), t(1,2), t(2,2));
  382:    }
  383: 
  384: 
  385:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  386:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  387:    // Inputs:
  388:    //        vec0: vel. in this frame;
  389:    //        frameout: Output frame;
  390:    // Output: 
  391:    //        vec1: vel. in new frame  
  392: 
  393:       auto const fo = frameout;
  394:       Vector2 vec1;
  395: 
  396:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  397:       // of t and fo.t are the same.
  398:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  399:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  400: 
  401:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  402:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  403: 
  404:       return vec1;
  405:    }
  406: 
  407:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  408:       // Transform a vector from global to local frame
  409:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  410:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  411:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  412:    }
  413: 
  414:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  415:       // Transform a vector from local to global frame
  416:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  417:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  418:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  419:    }   
  420: 
  421:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  422:    // Tranforms a point from global to local frame     
  423:       G2L(pi - origin0, po);
  424:    }
  425: 
  426:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  427:    // Transforms a point from local to global frame      
  428:       L2G(pi, po);
  429:       po = po + origin0;
  430:    }
  431: 
  432: };
