 2646: 
 2647: // Helper functions to get the 2D local node position for the Celestial walk
 2648: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2649:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2650:    const Node *node = getNodeInOrder(idx2);
 2651: 
 2652:    double z = 0.0;
 2653:    if constexpr(ics == 2) z = node->gz;
 2654:    
 2655:    Point3 p = toPoint3(node->p, z);
 2656: 
 2657:    return toPoint2(origSide->toLocalFrame(p));
 2658: }
 2659: 
 2660: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2661:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2662: }
 2663: 
 2664: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, const Side* origSide,
 2665:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector) const
 2666: // Computes the three per-side predicates needed for the celestial walk
 2667: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2668: //
 2669: // xt is in local frame coordinates for origSide if ics == 2.
 2670: //
 2671: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2672: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2673: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2674: // meaningless on triangles are masked to a safe value (see comments below).
 2675: {
 2676:    // Project all 4 corner positions once into the local 2D frame.
 2677:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2678:    // getLocalNodePosition only transforms/projects if ics == 2.
 2679:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2680:                         getLocalNodePosition(1, origSide), 
 2681:                         getLocalNodePosition(2, origSide), 
 2682:                         getLocalNodePosition(3, origSide)};
 2683: 
 2684:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2685:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2686:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2687:    // But still farther towards the target point from the current point.
 2688:    const Vector2 vt0 = xt - x0;
 2689:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2690:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2691:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2692: 
 2693:    const double fac = max(0.0000001, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2694:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2695: 
 2696:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2697:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2698:    //  here — the orientation is baked into the corners array.)
 2699:    const int i3 = nxq(3);
 2700:    const Vector2 s0 = C[ 1] - C[ 0];
 2701:    const Vector2 s1 = C[ 2] - C[ 1];
 2702:    const Vector2 s2 = C[i3] - C[ 2];
 2703:    const Vector2 s3 = C[ 0] - C[i3];
 2704:    
 2705:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2706:    // The corners array is built from getNode in CCW order, so the orientation
 2707:    // is already correct and no ssign factor is needed in the formulas below.
 2708:    //
 2709:    // i3 = nxq(3): the index of the corner after side 2.
 2710:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2711:    //   Quad:     i3 == 3.
 2712:    //
 2713:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2714:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2715:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2716:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2717:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2718:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2719: 
 2720: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2721: 
 2722:    // For triangles, the corner after side 2 is the closing corner where
 2723:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2724:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2725:    // s0 for triangles, s3 for quads.
 2726:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2727: 
 2728:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2729:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2730:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2731:    //
 2732:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2733:    // result is false naturally. No sentinel needed.
 2734:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2735:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2736:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2737:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2738: 
 2739:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2740:    // on the "exit through side I" half of the corner cone, separated by the
 2741:    // approximate angular bisector of the celestial walk. The bisector is
 2742:    // perpendicular to the chord across the corner; the test is the sign of
 2743:    // (xt - corner_vertex) projected onto that chord.
 2744:    //
 2745:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2746:    // (the validity rule sets valid_3 = false), so its computed value for
 2747:    // triangles doesn't matter. No sentinel needed.
 2748:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2749:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2750:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2751:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2752: 
 2753: }
 2754: 
 2755: 
 2756: __inline__ __device__ double Element::computeSignedArea(void) const {
 2757:    // Compute the area of the element
 2758: 
 2759:    Point2 x0, x1, x2, x3;
 2760:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2761: 
 2762:    double res = signedArea(x0, x1, x2);
 2763: 
 2764:    // In the quad case we need to add the area of the other triangle.
 2765:    if (isQuad()) {
 2766:       x3 = getLocalHorizontalNodePosition(3);
 2767:       double ar1 = signedArea(x0, x2, x3);
 2768:       double ar2 = signedArea(x0, x1, x3);
 2769:       double ar3 = signedArea(x1, x2, x3);
 2770:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2771: 
 2772:       res += ar1 + ar2 + ar3;
 2773:    }
 2774: 
 2775:    return res;
 2776: }
 2777: 
 2778: 
 2779: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2780:                                                                 (nodes[1]->isDry2()) ||
 2781:                                                                 (nodes[2]->isDry2()) ||
 2782:                                                                 (isQuad() && nodes[3]->isDry2());
 2783: }
 2784: 
 2785: __inline__ __device__ double Element::detJ_eta(void) const {
 2786:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2787:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2788: }
 2789: 
 2790: __inline__ __device__ double Element::detJ_xi(void) const {
 2791:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2792:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2793: }
 2794: 
 2795: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2796:    // In boundary sides, the element 1 is nullptr
 2797:    return side->elems[1] == nullptr; 
 2798: }
 2799: 
 2800: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2801:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2802:    // For ics == 2, this function uses local frame coordinates.
 2803: 
 2804:    assert(isQuad());
 2805: 
 2806:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2807:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2808:    // where vxi, veta, vb are vectors and c is the center of the element.
 2809: 
 2810:    Point2 p0, p1, p2, p3;
 2811: 
 2812:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2813: 
 2814:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2815:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2816:    // vectors vxi and veta connect the centers of opposite sides
 2817:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2818:    // vb is zero for parallelogram elements.
 2819:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2820: 
 2821:    //  The bilinear mapping is:
 2822:    //      P(s,t) = C + s*U + t*V + s*t*W
 2823:    //
 2824:    //  where:
 2825:    //    C = centroid (average of four vertices)
 2826:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2827:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2828:    //    W = bilinear correction; measures deviation from parallelogram
 2829:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2830:    //        W = 0 for parallelogram elements.
 2831:    //
 2832:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2833:    //
 2834:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2835:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2836:    //
 2837:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2838:    //
 2839:    //  Geometrically, (L) projects everything onto the direction
 2840:    //  perpendicular to W, where the mapping is purely affine.
 2841:    //
 2842:    //  The dot product with nb retains the nonlinear term:
 2843:    //
 2844:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2845:    //
 2846:    //  Geometrically, (Q) projects onto the W direction, where
 2847:    //  the nonlinearity lives.
 2848:    //
 2849:    //  We solve (L) for whichever variable has the larger coefficient
 2850:    //  (better conditioned back-substitution), substitute into (Q),
 2851:    //  and get a scalar quadratic in the other variable.
 2852:    // ================================================================
 2853: 
 2854:    // ---- Basis vectors ----
 2855:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2856:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2857:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2858:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2859:    // W: nonlinear correction. Difference between quad and parallelogram.
 2860:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2861:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2862: 
 2863:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2864:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2865:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2866:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2867:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2868: 
 2869:    // ---- nb: direction parallel to W, L1-normalized ----
 2870:    // We don't need a unit vector -- just a well-scaled direction parallel
 2871:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2872:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2873:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2874:    //
 2875:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2876:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2877:    // and the quadratic solver takes its linear path (a ~ 0).
 2878:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2879:    const double inv_wlen = 1.0 / wlen1;
 2880:    const Vector2 nb = vb * inv_wlen;
 2881: 
 2882:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2883:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2884:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2885:    // What remains is a pure affine relationship between xi and eta.
 2886:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2887:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2888:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2889: 
 2890:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2891:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2892:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2893:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2894:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2895:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2896:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2897: 
 2898:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2899:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2900:    // minimizing round-off amplification.
 2901:    //
 2902:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2903:    // that uses predicated moves.
 2904:    //
 2905:    // if (fabs(Ls) > fabs(Lt)) {
 2906:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2907:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2908:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2909:    //    const double A = -Qw * Lt;
 2910:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2911:    //    const double C =  Qs * Lp - Qp * Ls;
 2912: 
 2913:    //    double eta1, eta2;
 2914:    //    solveQuadratic(A, B, C, eta1, eta2);
 2915: 
 2916:    //    // Pick root with smaller |eta| (domain centered at 0).
 2917:    //    // Ternary-> predicated move, no branch divergence.
 2918:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2919: 
 2920:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2921:    //    xi = (Lp - Lt * eta) / Ls;
 2922: 
 2923:    // } else {
 2924:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2925:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2926:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2927:    //    const double A = -Qw * Ls;
 2928:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2929:    //    const double C =  Qt * Lp - Qp * Lt;
 2930: 
 2931:    //    double xi1, xi2;
 2932:    //    solveQuadratic(A, B, C, xi1, xi2);
 2933: 
 2934:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2935: 
 2936:    //    eta = (Lp - Ls * xi) / Lt;
 2937:    // }
 2938:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2939:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2940:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2941:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2942:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2943: 
 2944:    // Quadratic:  A*r^2 + B*r + C = 0
 2945:    // (same formula for both cases, just with swapped coefficients)
 2946:    const double A = -Qw * Lb;
 2947:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2948:    const double C =  Qa * Lp - Qp * La;
 2949: 
 2950:    double r1, r2;
 2951:    solveQuadratic(A, B, C, r1, r2);
 2952: 
 2953:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2954:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2955: 
 2956:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2957:    const double other = (Lp - Lb * r) / La;
 2958: 
 2959:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2960:    xi  = solve_s ? r     : other;
 2961:    eta = solve_s ? other : r;
 2962: 
 2963: 
 2964:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2965:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2966:    eta = fmin(1.0, fmax(eta, -1.0));
 2967: 
 2968:    // ---- Shape functions ----
 2969:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2970:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2971:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2972:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2973:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2974:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2975:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2976:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2977: 
 2978:    return true;
 2979: }
 2980: 
 2981: /**
 2982:    Compute the shape coordinates of the point (xt,yt) in the element.
 2983:    @param xt (input): x-coordinate of the point
 2984:    @param shpCoords (output): shape coordinates of the point
 2985:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2986:    @return true if the point is inside the element, false otherwise
 2987: **/
 2988: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2989: 
 2990:    // Compute the shape coordinates of the point xt in the element.
 2991:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2992:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2993:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2994:    // from the local frame, so use additional check.
 2995: 
 2996:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (5)");
 2997: 
 2998:    if (isTri()) { // Triangular element
 2999: 
 3000:       // Horizontal local node coordinates. 
 3001:       Point2 x0 = nodes[0]->p;
 3002:       Point2 x1 = nodes[1]->p;
 3003:       Point2 x2 = nodes[2]->p;
 3004: 
 3005:       // If ics == 2, the node coordinates are transformed to local frame.
 3006:       if constexpr(ics==2) {
 3007:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3008:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3009:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3010: 
 3011: 
 3012:          // Convert the node coordinates to the local frame centered at the element center
 3013:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3014:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3015:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3016:       }
 3017: 
 3018:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3019:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3020:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3021:       shpCoords[3] = 0.0;
 3022: 
 3023: 
 3024:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3025:       const bool res = (tmpmin >= -small);  
 3026:       
 3027:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 3028:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3029: 
 3030: double tmpmax = max3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3031: if (tmpmin < -0.1) printf("XXX element %d, tmpmin = %.17f\n", idx, tmpmin);
 3032: if (tmpmax > 1.1) printf("XXX element %d, tmpmax = %.17f\n", idx, tmpmax);
 3033:       
 3034:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3035:       // then we fix the negative shape coordinates.
 3036:       if ((tmpmin < 0) && fix) {
 3037: 
 3038:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3039:          // keeping the sum of the shape coordinates equal to 1.
 3040:          // I have tested and compared the new algorithm with the old one, and they give
 3041:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3042:          // The new algorithm should be faster since it is branchless.
 3043:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3044:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3045: 
 3046:          shpCoords[0] = (shpCoords[0] + a)*b;
 3047:          shpCoords[1] = (shpCoords[1] + a)*b;
 3048:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3049: 
 3050:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3051:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3052:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3053: 
 3054:          // Update the point coordinates for the new shape coordinates
 3055:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3056:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3057: 
 3058:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3059: 
 3060:       }
 3061: 
 3062:       // Check if the point is inside the element
 3063:       return res;      
 3064:    }
 3065:    else {
 3066:       assert(isQuad() && "computeShapeCoords");
 3067: 
 3068:    //    Point2 p = xt;
 3069: 
 3070:    //    // Reproject p the original side frame for ics=2
 3071:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3072: 
 3073:    //    bool inside = false;
 3074: 
 3075: 
 3076: 
 3077:    //    if(ifl==0) then
 3078:    //      do i=1,4
 3079:    //        in1=nxq(1,i,i34(ie))
 3080:    //        in2=nxq(2,i,i34(ie))
 3081:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3082:    //      enddo !i
 3083:    //      tmp=minval(swild2(1:4))/area(ie)
 3084:    //      if(tmp>-small2) then
 3085:    //        inside=1
 3086:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3087:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3088:    //      endif !inside quad
 3089:    //    else !ifl=1 - already inside
 3090:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3091:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3092:    //      !Update pt
 3093:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3094:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3095:    //    endif !ifl
 3096: 
 3097: 
 3098:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3099: 
 3100:    }
 3101: 
 3102:    assert(false && "computeShapeCoords: should never reach this point");
 3103:    return false;  // Never reached
 3104: 
 3105: }
 3106: 
 3107: 
 3108: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3109: // Convert shape coordinates to cartesian coordinates
 3110: 
 3111:    if (isTri()) {
 3112:       // Triangular element
 3113: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3114:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3115:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3116:    }
 3117:    else {
 3118:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3119:    }
 3120: 
 3121: }
