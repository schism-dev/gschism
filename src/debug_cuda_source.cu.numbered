 4434:    __global__ void computeFlowBcVelocities(double time) {
 4435: 
 4436:       SIDE_BND(sideBnd);
 4437: 
 4438:       const Side *side = sideBnd->side;
 4439:  
 4440:       const bool isDry = side->isDry;
 4441:       const bool isLand = sideBnd->segment->isLand;
 4442: 
 4443:    
 4444:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4445: 
 4446:       if (isDry || isLand) return;
 4447: 
 4448:       // For wet sides in open boundaries...
 4449:       const Vector2 n = side->n;
 4450:       const BoundarySegment *segment = sideBnd->segment;
 4451: 
 4452:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4453: 
 4454:       const int ifltype = segment->ifltype;
 4455: 
 4456:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4457:       const Vector2 r_nuth0 = r_uth0*n;
 4458: 
 4459: 
 4460:       if (ifltype == 1 || ifltype == 2) {
 4461:       
 4462:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4463: 
 4464:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4465:          
 4466:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4467:          
 4468:       } else if (ifltype == -1) { // Flather 1
 4469: 
 4470:          for (int k = 0; k < nvrt; k++) {
 4471: 
 4472:             // uth is the normal vel.; no ramp up
 4473:             const double uth = sideBnd->nuth(k);
 4474:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4475: 
 4476:             sideBnd->ubc[k] += uth*n;
 4477:          }
 4478: 
 4479:       } else if (ifltype == 3 || ifltype == 5) {
 4480:          // vnth0=0 !normal vel.
 4481: 
 4482:          Vector2 r_u1_bar = {0.0, 0.0};
 4483:          // Computes the contribution to the velocity from all tide frequencies
 4484:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4485: 
 4486:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4487:             const Vector2 umo  = sideBnd->umo(jfr); 
 4488: 
 4489:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4490:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4491:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4492:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4493: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4494:          }
 4495: 
 4496: 
 4497:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4498: 
 4499:       } // if (ifltype = 3 || ifltype == 5
 4500: 
 4501: 
 4502: 
 4503:    }
 4504: 
 4505:    __global__ void computeElevationBoundaryConditions(double time) {
 4506:       // Compute elevation essential boundary conditions 
 4507: 
 4508:       NODE_BND(nodeBnd); // Each boundary node.
 4509: 
 4510:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4511: 
 4512:       const Node *node = nodeBnd->node;
 4513:       const BoundarySegment *segment = nodeBnd->segment;
 4514:       const int iettype = segment->iettype;
 4515:       
 4516: 
 4517:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4518:       double eic = 0.0;
 4519:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4520:       else                 eic = 0.0;
 4521: 
 4522:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4523:       const double r_eth = ramp*nodeBnd->eth;
 4524:       double r_eta1_bar = 0.0;
 4525: 
 4526: 
 4527:       // Compute tide elevation
 4528:       if (iettype == 3 || iettype == 5) {   
 4529: 
 4530:          if constexpr(iloadtide==1) { // loading tide
 4531:             assert(false && "Loading tide not implemented");
 4532:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4533:          }
 4534:          
 4535:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4536: 
 4537:             const double efa  = nodeBnd->efa[jfr]; 
 4538:             const double emo  = nodeBnd->emo[jfr]; 
 4539: 
 4540:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4541:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4542:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4543: 
 4544:          } // for jfr
 4545: 
 4546:       } // if iettype
 4547: 
 4548:       switch (iettype) {
 4549:          case 1:
 4550:          case 2:
 4551:          case 4:
 4552:             nodeBnd->elbc = r_eic + r_eth;
 4553:             break;
 4554:          case 3:
 4555:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4556:             break;
 4557:          case 5:
 4558:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4559:             break;
 4560:       } // switch
 4561: 
 4562: 
 4563:       //Add inverse barometric effects
 4564:       if (iettype != 0 && inv_atm_bnd == 1) {
 4565:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4566:       }
 4567: 
 4568:    }
 4569: 
 4570: 
 4571:    __global__ void computeHorizontalViscosity(void) { 
 4572: 
 4573:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4574: 
 4575:       SIDE(side);
 4576: 
 4577:       if (side->isDry) return;
 4578: 
 4579:       for (int k = 0; k < nvrt; k++) {
 4580:          side->nuGradU[k] = {0.0, 0.0};
 4581:       }
 4582: 
 4583:       if constexpr(ihorcon == 1) {
 4584:          for (int k = side->kb; k < nvrt - 1; k++) {
 4585:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4586:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4587:             // By Zhang and Baptista.
 4588: 
 4589:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4590:             // This is a standard discretization of the Laplacian operator.
 4591:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4592:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4593:             // Gamma is hvis_coef0 in the code.
 4594:             // The value of gamma needs to be < 0.5.
 4595: 
 4596:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4597:             // side under consideration in each of the two possible elements that share the side.
 4598:             Vector2 sumU = {0.0, 0.0};
 4599:             for (int l = 0; l < 2; l++) {
 4600:                const Element *elem = side->elems[l];
 4601: 
 4602:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4603: 
 4604:                // Find the local index of the side in the element
 4605:                const int idxSide = elem->sideLocalIdx(side);
 4606:                // Find the two sides that are connected to the side under consideration
 4607:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4608:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4609: 
 4610:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4611: 
 4612:             }
 4613: 
 4614:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4615:    
 4616:          }
 4617:       }
 4618:       else if constexpr(ihorcon == 2) {
 4619:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4620:       }
 4621: 
 4622: 
 4623:    }
 4624: 
 4625: 
 4626:    __global__ void setEssentialBC(void) {
 4627:       // Set essential boundary conditions 
 4628:       NODE(node); // Each boundary node
 4629:       NodeBoundary *nodeBnd = node->nodeBnd;
 4630:       
 4631: // nodeBnd->isEssentialBC = true;      
 4632:       // Check if this node has essential BC
 4633:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4634:          // Verify BC value is valid
 4635:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4636: 
 4637:        
 4638:          // Set diagonal to 1 and zero off-diagonals
 4639:          node->coeffDiag = 1.0;
 4640: 
 4641:          for (int j = 0; j < node->numNodes; j++) {
 4642:                node->coeffMatrix[j] = 0.0;
 4643:          }
 4644:          
 4645:          // Set solution and RHS to BC value
 4646:          node->mX  = nodeBnd->elbc;
 4647:          node->qel = nodeBnd->elbc;
 4648: 
 4649:       } else {
 4650:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4651: 
 4652:          for (int j = 0; j < node->numNodes; j++) {
 4653:                Node* nbNode = node->nodes[j];
 4654:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4655:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4656:                   // Verify neighbor's BC value
 4657:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4658: 
 4659:                   // Subtract contribution to RHS
 4660:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4661:                   node->coeffMatrix[j] = 0.0;  
 4662:                }
 4663:          }
 4664:       }
 4665:    }
 4666: 
 4667: 
 4668:    __global__ void updateElevation(void) {
 4669:       NODE(node);
 4670: 
 4671:       node->eta2 = node->mX;
 4672: 
 4673:       node->updateZCoordData();
 4674:    }
 4675: 
