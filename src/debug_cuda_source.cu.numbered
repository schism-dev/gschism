 4161:    __global__ void scaleGravity(double loadtide_coef) {
 4162: 
 4163: 
 4164:       NODE(node);
 4165: 
 4166:       // SAL option: scale gravity
 4167:       if constexpr(iloadtide==2) {  // simple const
 4168:          node->grav2 = grav*(1.0 - loadtide_coef);
 4169: 
 4170:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4171:         
 4172:           const double depth = max(node->depth, 0.0);
 4173:           const double tmp1 = sqrt(depth);
 4174:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4175:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4176:                              2.6969e-13*depth*depth*depth*tmp1;
 4177:           
 4178:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4179:           
 4180: 
 4181: 
 4182:           node->grav2 = grav*(1.0 - beta_bar);
 4183: 
 4184:       } else {  // iloadtide=0,1
 4185:           node->grav2 = grav;
 4186: 
 4187:       }
 4188: 
 4189:    }
 4190: 
