 2328: 
 2329: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2330: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2331: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2332: // Only when ics == 2, the origin is at the element center.
 2333: 
 2334:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2335: 
 2336:    const Node *node = nodes[idxNode];
 2337: 
 2338:    if constexpr(ics==1) {
 2339:       return node->p;
 2340: 
 2341:    } else {
 2342:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2343: 
 2344:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2345: 
 2346:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2347:    }
 2348: 
 2349: }
 2350: 
 2351: 
 2352: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2353: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2354: 
 2355:    const int id1 = idx;
 2356:    const int id2 = nxq(1 + id1);
 2357:    const int id3 = nxq(2 + id1);
 2358: 
 2359:    if constexpr(ics==1) {
 2360:       x0 = nodes[id1]->p;
 2361:       x1 = nodes[id2]->p;
 2362:       x2 = nodes[id3]->p;
 2363: 
 2364:    } else {
 2365:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2366: 
 2367:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2368:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2369:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2370: 
 2371:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2372:       x1 = toVector2(frame.G2L(p1 - c));
 2373:       x2 = toVector2(frame.G2L(p2 - c));
 2374: 
 2375:    }
 2376: 
 2377: }
 2378: 
 2379: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3, int idx) const {
 2380: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2381: 
 2382:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2383: 
 2384:    const int id1 = idx;
 2385:    const int id2 = (1 + idx) % 4;
 2386:    const int id3 = (2 + idx) % 4;
 2387:    const int id4 = nxq(3 + idx);
 2388: 
 2389:    if constexpr(ics==1) {
 2390:       x0 = nodes[id1]->p;
 2391:       x1 = nodes[id2]->p;
 2392:       x2 = nodes[id3]->p;  
 2393:       x3 = nodes[id4]->p;
 2394: 
 2395:    } else {
 2396:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2397: 
 2398:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2399:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2400:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2401:       const Point3 p3 = toPoint3(nodes[id4]->p, nodes[id4]->gz);
 2402: 
 2403:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2404:       x1 = toVector2(frame.G2L(p1 - c));
 2405:       x2 = toVector2(frame.G2L(p2 - c));
 2406:       x3 = toVector2(frame.G2L(p3 - c));
 2407:    }
 2408: 
 2409: }
 2410: 
 2411: 
 2412: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2413: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2414: // Returns the normal vector and the area of the element at this level
 2415:    
 2416:    double nx, ny, nz;
 2417: 
 2418:    if (isTri()) {
 2419:       // For triangles...
 2420: 
 2421:       // Indices of the nodes at level k, taking care of not going below the bed
 2422:       const int k0 = max(k, nodes[0]->kb);
 2423:       const int k1 = max(k, nodes[1]->kb);
 2424:       const int k2 = max(k, nodes[2]->kb);
 2425: 
 2426:       // Gets the element frame coordinates of the nodes at level k
 2427:       Point3 x0, x1, x2;
 2428:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2429:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2430:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2431:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2432: 
 2433:       } else {  // ics == 2
 2434:          Point2 h0, h1, h2;
 2435: 
 2436:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2437: 
 2438:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2439:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2440:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2441:       }
 2442: 
 2443:       const Vector3 n20 = x2 - x0;
 2444:       const Vector3 n10 = x1 - x0; 
 2445: 
 2446:       // Computes the cross product of vectors n20 and n10. 
 2447:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2448:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2449:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2450: 
 2451:   
 2452:    }
 2453:    else {
 2454:       // For quads...
 2455:       Point2 h0, h1, h2, h3;
 2456: 
 2457:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2458: 
 2459:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2460:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2461:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2462:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2463: 
 2464:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2465:       nx = n20.y*n31.z - n20.z*n31.y;
 2466:       ny = n20.z*n31.x - n20.x*n31.z;
 2467:       nz = n20.x*n31.y - n20.y*n31.x;
 2468: 
 2469:    }
 2470: 
 2471:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2472:    area3D = 0.5*len;
 2473: 
 2474:    const double inv_len = 1.0/len;
 2475: 
 2476:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2477: 
 2478: }
 2479: 
 2480: 
 2481: // Helper functions to get the 2D local node position for the Celestial walk
 2482: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2483:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2484:    const Node *node = getNodeInOrder(idx2);
 2485: 
 2486:    double z = 0.0;
 2487:    if constexpr(ics == 2) z = node->gz;
 2488:    
 2489:    Point3 p = toPoint3(node->p, z);
 2490: 
 2491:    return toPoint2(origSide->toLocalFrame(p));
 2492: }
 2493: 
 2494: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2495:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2496: }
 2497: 
 2498: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2499:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2500: // Computes the three per-side predicates needed for the celestial walk
 2501: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2502: //
 2503: // xt is in local frame coordinates for origSide if ics == 2.
 2504: //
 2505: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2506: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2507: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2508: // meaningless on triangles are masked to a safe value (see comments below).
 2509: {
 2510:    // Project all 4 corner positions once into the local 2D frame.
 2511:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2512:    // getLocalNodePosition only transforms/projects if ics == 2.
 2513:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2514:                         getLocalNodePosition(1, origSide), 
 2515:                         getLocalNodePosition(2, origSide), 
 2516:                         getLocalNodePosition(3, origSide)};
 2517: 
 2518:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2519:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2520:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2521:    // But still farther towards the target point from the current point.
 2522:    const Vector2 vt0 = xt - x0;
 2523:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2524:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2525:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2526: 
 2527:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2528:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2529: 
 2530: 
 2531: // if (origSide->idx == 2860848 && jlev == 46) {
 2532: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2533: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2534: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2535: // }
 2536:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2537:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2538:    //  here the orientation is baked into the corners array.)
 2539:    const int i3 = nxq(3);
 2540:    const Vector2 s0 = C[ 1] - C[ 0];
 2541:    const Vector2 s1 = C[ 2] - C[ 1];
 2542:    const Vector2 s2 = C[i3] - C[ 2];
 2543:    const Vector2 s3 = C[ 0] - C[i3];
 2544:    
 2545:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2546:    // The corners array is built from getNode in CCW order, so the orientation
 2547:    // is already correct and no ssign factor is needed in the formulas below.
 2548:    //
 2549:    // i3 = nxq(3): the index of the corner after side 2.
 2550:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2551:    //   Quad:     i3 == 3.
 2552:    //
 2553:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2554:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2555:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2556:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2557:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2558:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2559: 
 2560: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2561: 
 2562:    // For triangles, the corner after side 2 is the closing corner where
 2563:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2564:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2565:    // s0 for triangles, s3 for quads.
 2566:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2567: 
 2568:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2569:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2570:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2571:    //
 2572:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2573:    // result is false naturally. No sentinel needed.
 2574:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2575:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2576:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2577:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2578: 
 2579:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2580:    // on the "exit through side I" half of the corner cone, separated by the
 2581:    // approximate angular bisector of the celestial walk. The bisector is
 2582:    // perpendicular to the chord across the corner; the test is the sign of
 2583:    // (xt - corner_vertex) projected onto that chord.
 2584:    //
 2585:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2586:    // (the validity rule sets valid_3 = false), so its computed value for
 2587:    // triangles doesn't matter. No sentinel needed.
 2588:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2589:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2590:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2591:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2592: 
 2593: }
 2594: 
 2595: 
 2596: __inline__ __device__ double Element::computeSignedArea(void) const {
 2597:    // Compute the area of the element
 2598: 
 2599:    Point2 x0, x1, x2, x3;
 2600:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2601: 
 2602:    double res = signedArea(x0, x1, x2);
 2603: 
 2604:    // In the quad case we need to add the area of the other triangle.
 2605:    if (isQuad()) {
 2606:       x3 = getLocalHorizontalNodePosition(3);
 2607:       double ar1 = signedArea(x0, x2, x3);
 2608:       double ar2 = signedArea(x0, x1, x3);
 2609:       double ar3 = signedArea(x1, x2, x3);
 2610:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2611: 
 2612:       res += ar1;
 2613: 
 2614:    }
 2615: 
 2616:    return res;
 2617: }
 2618: 
 2619: 
 2620: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2621:                                                                 (nodes[1]->isDry2()) ||
 2622:                                                                 (nodes[2]->isDry2()) ||
 2623:                                                                 (isQuad() && nodes[3]->isDry2());
 2624: }
 2625: 
 2626: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2627:    return (x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y);
 2628: }
 2629: 
 2630: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2631:    return (x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y);
 2632: }
 2633: 
 2634: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2635:    // In boundary sides, the element 1 is nullptr
 2636:    return side->elems[1] == nullptr; 
 2637: }
 2638: 
 2639: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2640:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2641:    // For ics == 2, this function uses local frame coordinates.
 2642: 
 2643:    assert(isQuad());
 2644: 
 2645:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2646:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2647:    // where vxi, veta, vb are vectors and c is the center of the element.
 2648: 
 2649:    Point2 p0, p1, p2, p3;
 2650: 
 2651:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2652: 
 2653:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2654:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2655:    // vectors vxi and veta connect the centers of opposite sides
 2656:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2657:    // vb is zero for parallelogram elements.
 2658:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2659: 
 2660:    //  The bilinear mapping is:
 2661:    //      P(s,t) = C + s*U + t*V + s*t*W
 2662:    //
 2663:    //  where:
 2664:    //    C = centroid (average of four vertices)
 2665:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2666:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2667:    //    W = bilinear correction; measures deviation from parallelogram
 2668:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2669:    //        W = 0 for parallelogram elements.
 2670:    //
 2671:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2672:    //
 2673:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2674:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2675:    //
 2676:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2677:    //
 2678:    //  Geometrically, (L) projects everything onto the direction
 2679:    //  perpendicular to W, where the mapping is purely affine.
 2680:    //
 2681:    //  The dot product with nb retains the nonlinear term:
 2682:    //
 2683:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2684:    //
 2685:    //  Geometrically, (Q) projects onto the W direction, where
 2686:    //  the nonlinearity lives.
 2687:    //
 2688:    //  We solve (L) for whichever variable has the larger coefficient
 2689:    //  (better conditioned back-substitution), substitute into (Q),
 2690:    //  and get a scalar quadratic in the other variable.
 2691:    // ================================================================
 2692: 
 2693:    // ---- Basis vectors ----
 2694:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2695:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2696:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2697:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2698:    // W: nonlinear correction. Difference between quad and parallelogram.
 2699:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2700:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2701: 
 2702:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2703:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2704:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2705:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2706:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2707: 
 2708:    // ---- nb: direction parallel to W, L1-normalized ----
 2709:    // We don't need a unit vector -- just a well-scaled direction parallel
 2710:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2711:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2712:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2713:    //
 2714:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2715:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2716:    // and the quadratic solver takes its linear path (a ~ 0).
 2717:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2718:    const double inv_wlen = 1.0 / wlen1;
 2719:    const Vector2 nb = vb * inv_wlen;
 2720: 
 2721:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2722:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2723:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2724:    // What remains is a pure affine relationship between xi and eta.
 2725:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2726:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2727:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2728: 
 2729:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2730:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2731:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2732:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2733:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2734:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2735:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2736: 
 2737:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2738:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2739:    // minimizing round-off amplification.
 2740:    //
 2741:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2742:    // that uses predicated moves.
 2743:    //
 2744:    // if (fabs(Ls) > fabs(Lt)) {
 2745:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2746:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2747:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2748:    //    const double A = -Qw * Lt;
 2749:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2750:    //    const double C =  Qs * Lp - Qp * Ls;
 2751: 
 2752:    //    double eta1, eta2;
 2753:    //    solveQuadratic(A, B, C, eta1, eta2);
 2754: 
 2755:    //    // Pick root with smaller |eta| (domain centered at 0).
 2756:    //    // Ternary-> predicated move, no branch divergence.
 2757:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2758: 
 2759:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2760:    //    xi = (Lp - Lt * eta) / Ls;
 2761: 
 2762:    // } else {
 2763:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2764:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2765:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2766:    //    const double A = -Qw * Ls;
 2767:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2768:    //    const double C =  Qt * Lp - Qp * Lt;
 2769: 
 2770:    //    double xi1, xi2;
 2771:    //    solveQuadratic(A, B, C, xi1, xi2);
 2772: 
 2773:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2774: 
 2775:    //    eta = (Lp - Ls * xi) / Lt;
 2776:    // }
 2777:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2778:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2779:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2780:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2781:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2782: 
 2783:    // Quadratic:  A*r^2 + B*r + C = 0
 2784:    // (same formula for both cases, just with swapped coefficients)
 2785:    const double A = -Qw * Lb;
 2786:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2787:    const double C =  Qa * Lp - Qp * La;
 2788: 
 2789:    double r1, r2;
 2790:    solveQuadratic(A, B, C, r1, r2);
 2791: 
 2792:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2793:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2794: 
 2795:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2796:    const double other = (Lp - Lb * r) / La;
 2797: 
 2798:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2799:    xi  = solve_s ? r     : other;
 2800:    eta = solve_s ? other : r;
 2801: 
 2802: 
 2803:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2804:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2805:    eta = fmin(1.0, fmax(eta, -1.0));
 2806: 
 2807:    // ---- Shape functions ----
 2808:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2809:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2810:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2811:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2812:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2813:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2814:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2815:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2816: 
 2817:    return true;
 2818: }
 2819: 
 2820: /**
 2821:    Compute the shape coordinates of the point (xt,yt) in the element.
 2822:    @param xt (input): x-coordinate of the point
 2823:    @param shpCoords (output): shape coordinates of the point
 2824:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2825:    @return true if the point is inside the element, false otherwise
 2826: **/
 2827: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2828: 
 2829:    // Compute the shape coordinates of the point xt in the element.
 2830:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2831:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2832:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2833:    // from the local frame, so use additional check.
 2834: 
 2835: 
 2836: 
 2837:    if (isTri()) { // Triangular element
 2838: 
 2839:       // Horizontal local node coordinates. 
 2840:       Point2 x0, x1, x2;
 2841:       getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2842: 
 2843: 
 2844:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2845:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2846:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2847:       shpCoords[3] = 0.0;
 2848: 
 2849: 
 2850:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2851:       const bool res = (tmpmin >= -small);  
 2852:       
 2853:       // When to fix the negative shape coordinates?
 2854:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2855: 
 2856:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2857:       // then we fix the negative shape coordinates.
 2858:       if ((tmpmin < 0) && fix) {
 2859: 
 2860:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2861:          // keeping the sum of the shape coordinates equal to 1.
 2862:          // I have tested and compared the new algorithm with the old one, and they give
 2863:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2864:          // The new algorithm should be faster since it is branchless.
 2865:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2866:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2867: 
 2868:          shpCoords[0] = (shpCoords[0] + a)*b;
 2869:          shpCoords[1] = (shpCoords[1] + a)*b;
 2870:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2871: 
 2872:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2873:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2874:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2875: 
 2876:          // Update the point coordinates for the new shape coordinates
 2877:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2878:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2879: 
 2880:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2881: 
 2882:       }
 2883: 
 2884:       // Return true if the point is inside the element
 2885:       return res;      
 2886:    }
 2887:    else {
 2888:       assert(isQuad() && "computeShapeCoords");
 2889: 
 2890:       // Horizontal local node coordinates. 
 2891:       Point2 x0, x1, x2, x3;
 2892:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 2893: 
 2894:       const double a0 = signedArea(x0, x1, xt);
 2895:       const double a1 = signedArea(x1, x2, xt);
 2896:       const double a2 = signedArea(x2, x3, xt);
 2897:       const double a3 = signedArea(x3, x0, xt);
 2898: 
 2899:       const double minArea = min4(a0, a1, a2, a3);
 2900:       
 2901:       const bool res = (minArea > -small*area);
 2902: 
 2903:       // When to fix the negative shape coordinates?
 2904:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2905: 
 2906:       double xi, eta;      
 2907:       inverseBilinearQuad(xt, xi, eta, shpCoords);
 2908: 
 2909:       if (fix) {
 2910:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2911:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2912:          xt.x = interpolate(shpCoords, xn);
 2913:          xt.y = interpolate(shpCoords, yn);
 2914:       }
 2915: 
 2916:       return res;
 2917:    }
 2918: 
 2919: 
 2920:    assert(false && "computeShapeCoords: should never reach this point");
 2921:    return false;  // Never reached
 2922: 
 2923: }
 2924: 
 2925: 
 2926: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2927: // Convert shape coordinates to cartesian coordinates
 2928: 
 2929:    if (isTri()) {
 2930:       // Triangular element
 2931: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2932:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2933:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2934:    }
 2935:    else {
 2936:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2937:    }
 2938: 
 2939: }
 2940: 
 2941: 
 2942: 
 2943: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 2944:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 2945:    
 2946:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 2947: }
 2948: 
 2949: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 2950:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 2951:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 2952:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 2953:    return area * dot(gradPhi[i], gradPhi[j]);
 2954: }
 2955: 
 2956: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2957:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 2958:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2959:    // The formula for the integral is:
 2960:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2961:    
 2962:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 2963:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 2964:    const double eta_sum  = eta_n(i) + eta_n(j);
 2965:    const double xi_sum   = xi_n(i)  + xi_n(j);
 2966: 
 2967:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // xi derivative of the Jacobian determinant
 2968:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 2969: 
 2970:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_xi*eta_term*xi_sum + detJ_eta*xi_term*eta_sum);
 2971: }
 2972:    
 2973: 
 2974: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2975:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2976:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2977:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2978:    // The formula is also based on the identity:
 2979:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2980:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2981: 
 2982:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 2983: 
 2984: 
 2985: 
 2986:    double res = 0.0;
 2987:    
 2988:    // Quadrature points in xi and eta coordinates
 2989:    #pragma unroll
 2990:    for (int i = 0; i < 4; i++) {
 2991:       // For each quadrature point...
 2992: 
 2993:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 2994:       const double eta = p.x;
 2995:       const double xi  = p.y;
 2996: 
 2997:       // Jacobian entries at the Gauss point p
 2998:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 2999:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3000:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3001:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3002: 
 3003:       const double detJ = jacobianDetQuad(p, x0, x1, x2, x3);
 3004:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3005: 
 3006:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3007:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3008:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3009:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3010:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3011: 
 3012:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3013:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3014:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3015:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3016:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3017: 
 3018:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3019:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3020:    }
 3021: 
 3022:    return res;
 3023: }
 3024: 
 3025: 
 3026: /**  Interpolate velocities at a given point (xt,yt,zt)
 3027: 
 3028:    @param xt, yt, zt: coordinates of the point to interpolate
 3029:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3030: 
 3031:    This is done in four steps:
 3032: 
 3033:    1. Find the shape coordinates for the final position in the element.
 3034:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3035:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3036:       z levels at xt, yt at each step.   
 3037:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3038:       horizontally and vertically.
 3039: **/
 3040: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3041:    // Interpolate the velocities at the point xt. 
 3042:    // This function works the same for triangular and quadrilateral elements.
 3043:    double shpCoord[4];
 3044:    Vector3 u_int;
 3045: 
 3046: 
 3047:    // First step is to compute the shape coordinates of (xt,yt)
 3048: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3049:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3050: 
 3051:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3052: 
 3053:    // Second step is to find the level that contains zt
 3054:    // Uses a binary search to find the level
 3055:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3056:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3057:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3058:    int R = nvrt - 1;
 3059: 
 3060:    // Get the z coordinates at the nodes of the element at the levels L and R
 3061:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3062:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3063:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3064: 
 3065: 
 3066:    double zL = interpolate(shpCoord, zLAtNodes);
 3067:    double zR = interpolate(shpCoord, zRAtNodes);
 3068: 
 3069:    // Interpolates vertically the velocities
 3070:    double wght1, wght2;
 3071:    if (xt.z <= zL) {
 3072:       wght1 = 1.0;
 3073:       wght2 = 0.0;
 3074:       xt.z = zL;
 3075:    }
 3076:    else if (xt.z >= zR) {
 3077:       wght1 = 0.0;
 3078:       wght2 = 1.0;
 3079:       xt.z = zR;
 3080:    }
 3081:    else {
 3082:       // Perform a binary search to find the levels between L and R that contain xt.z
 3083:       while (R - L > 1) {
 3084:          int M = (L + R) / 2.0;
 3085: 
 3086:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3087:          double zM = interpolate(shpCoord, zMAtNodes);
 3088:          if (zM < xt.z) 
 3089:          {
 3090:             L = M;
 3091:             zL = zM;
 3092:          }
 3093:          else 
 3094:          {
 3095:             R = M;
 3096:             zR = zM;
 3097:          }
 3098:       }
 3099:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3100:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3101: 
 3102:       wght2 = (xt.z - zL)/(zR - zL);
 3103:       wght1 = 1.0 - wght2;
 3104: 
 3105:    }
 3106: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3107: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3108:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3109:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3110:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3111:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3112: 
 3113:    // Project the velocity from the local frame to the origSide frame
 3114:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3115:    u_int = {uv.x, uv.y, w};
 3116: 
 3117:    // Neither of the interpolated velocities should be NaN
 3118:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3119: 
 3120:    return u_int;
 3121: 
 3122: }
 3123: 
 3124: 
 3125: 
 3126: 
 3127: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3128: 
 3129:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3130:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3131:    const Node *n1 = side->n1;
 3132:    const Node *n2 = side->n2;
 3133: 
 3134:    bool n1_match = (n1->nodeBnd->segment == segment);
 3135:    bool n2_match = (n2->nodeBnd->segment == segment);
 3136: 
 3137:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3138:    if (n1_match && n2_match) {
 3139:       return 0.5;
 3140:    } else if (n1_match) {
 3141:       return 1.0;
 3142:    } else if (n2_match) {
 3143:       return 0.0;
 3144:    }
 3145: 
 3146:    return 0.0;
 3147: }
 3148: 
 3149: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3150: 
 3151: 
 3152: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3153: 
 3154:    const double w1 = getBoundaryArrayValueWeight();
 3155:    const double w2 = 1.0 - w1;
 3156:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3157:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3158: 
 3159:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3160: }
 3161: 
 3162: 
 3163: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3164:    const double w1 = getBoundaryArrayValueWeight();
 3165:    const double w2 = 1.0 - w1;
 3166:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3167:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3168: 
 3169:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3170: 
 3171: }
 3172: 
 3173: 
 3174: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3175:    // Returns the value of the velocity at the side center
 3176:    const double w1 = getBoundaryArrayValueWeight();
 3177:    const double w2 = 1.0 - w1;
 3178:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3179:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3180: 
 3181:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3182: }
 3183: 
 3184: 
 3185: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3186:    // Returns the value of the normal component of the velocity at the side center
 3187:    const double w1 = getBoundaryArrayValueWeight();
 3188:    const double w2 = 1.0 - w1;
 3189:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3190:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3191: 
 3192:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3193: }
