  855: 
  856: // ----------------------------- Frames -----------------------------
  857: 
  858: // Frames are used to transform vectors between different coordinate systems.
  859: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  860: template<int ICS>
  861: struct Frame {};
  862: 
  863: template<>
  864: struct Frame<1> {
  865:    __forceinline__ __device__ void update(double, double) {}
  866:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  867:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  868:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  869:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  870:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  871:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  872: };
  873: 
  874: template<>
  875: struct Frame<2> {
  876:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  877:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  878:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  879:     double t00, t10;        // col0 (t20=0 implicit)
  880:     double t01, t11, t21;   // col1
  881: 
  882:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  883: 
  884:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  885:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  886: 
  887:       double sin_lon, cos_lon, sin_lat, cos_lat;
  888:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  889:       sincos(lat, &sin_lat, &cos_lat);
  890: 
  891:       t00 = -sin_lon;
  892:       t10 =  cos_lon;
  893:       t01 = -cos_lon*sin_lat;
  894:       t11 = -sin_lon*sin_lat;
  895:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  896: 
  897:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  898:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  899: 
  900:       const double col1_norm_inv = 1.0/col1_norm;
  901:       t01 = t01*col1_norm_inv;
  902:       t11 = t11*col1_norm_inv;
  903:       t21 = t21*col1_norm_inv;
  904: 
  905:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  906: 
  907: 
  908:    }
  909: 
  910:    __forceinline__ __device__ void print(void) const {
  911:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  912:    }
  913: 
  914:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  915:       // cross(col0, col1), with t20=0 implicitly:
  916:       // |  i       j       k   |
  917:       // | t00     t10      0   |
  918:       // | t01     t11     t21  |
  919:       t02 =  t10*t21;
  920:       t12 = -t00*t21;
  921:       t22 =  t00*t11 - t10*t01;
  922:    }
  923: 
  924: 
  925:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  926:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  927:    // Inputs:
  928:    //        vec0: vel. in this frame;
  929:    //        frameout: Output frame;
  930:    // Output: 
  931:    //        vel. in new frame  
  932:    //
  933:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  934:    // discarding the z-component of the result to keep only the local horizontal
  935:    // plane of frame 2.
  936:    //
  937:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  938:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  939:    // are orthogonal. This product is computed as dot products between columns of
  940:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  941:    // columns of F2.// 
  942: 
  943:       auto const fo = frameout; // Just an alias for the output frame.
  944:       Vector2 res;
  945: 
  946:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  947:       // of t and fo.t are the same.
  948:       const double d00 = t00*fo.t00 + t10*fo.t10;
  949:       const double d10 = t01*fo.t00 + t11*fo.t10;
  950: 
  951:       const double d01 = t00*fo.t01 + t10*fo.t11;
  952:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  953: 
  954:       res.x = vec0.x * d00 + vec0.y * d10;
  955:       res.y = vec0.x * d01 + vec0.y * d11;
  956: 
  957:       return res;
  958:    }
  959: 
  960:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  961:       Vector3 vo;
  962:       double t02, t12, t22;
  963: 
  964:       // Compute the 3rd column of the frame tensor
  965:       getCol2(t02, t12, t22);
  966: 
  967:       vo.x = vi.x*t00 + vi.y*t10;
  968:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  969:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  970: 
  971:       return vo;
  972:    
  973:    }
  974: 
  975:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  976:       Vector3 vo;
  977:       double t02, t12, t22;
  978: 
  979:    // Compute the 3rd column of the frame tensor
  980:       getCol2(t02, t12, t22);
  981: 
  982:       // F * vi (non-transposed, so we use rows of F)
  983:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  984:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  985:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  986: 
  987:       return vo;
  988:    }
  989: 
  990:    // Unit vectors that define the local frame
  991:    __forceinline__ __device__ Vector3 nUp(void) const {
  992:       // Column 2 = cross(column0, column1)
  993:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  994:    }
  995: 
  996:    __forceinline__ __device__ Vector3 nZonal(void) const {
  997:       // Column 0
  998:       return { t00, t10, 0.0 };
  999:    }
 1000: 
 1001:    __forceinline__ __device__ Vector3 nMeridional(void) const {
 1002:       // Column 1
 1003:       return { t01, t11, t21 };
 1004:    }
 1005: 
 1006: };
