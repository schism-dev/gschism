 7249: //             !This obtains final values for interface sides
 7250: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7251: //       :    endif !nproc>1
 7252: //           !message passing end
