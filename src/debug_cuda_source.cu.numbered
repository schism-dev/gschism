 8400: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8401:    Element *elems = mesh->localElemData;
 8402: 
 8403:    *addr = elems;
 8404:    *sizeElement = sizeof(Element);
 8405:    switch (varCode) {
 8406:       case (int)VarCode::z:
 8407:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8408:          *sizeType = sizeof(double);
 8409:          break;
 8410:       case (int)VarCode::x:
 8411:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8412:          *sizeType = sizeof(Vector2);
 8413:          break;
 8414:       case (int)VarCode::gradETP:
 8415:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8416:          *sizeType = sizeof(Vector2);
 8417:          break;
 8418:       case (int)VarCode::area:
 8419:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8420:          *sizeType = sizeof(double);
 8421:          break;
 8422:       case (int)VarCode::depth:
 8423:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8424:          *sizeType = sizeof(double);
 8425:          break;
 8426:       case (int)VarCode::radius:
 8427:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8428:          *sizeType = sizeof(double);
 8429:          break;
 8430:       case (int)VarCode::ghat:
 8431:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8432:          *sizeType = sizeof(Vector2);
 8433:          break;
 8434:       case (int)VarCode::kb:
 8435:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8436:          *sizeType = sizeof(int);
 8437:          break;
 8438:       case (int)VarCode::isdry:
 8439:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8440:          *sizeType = sizeof(int);
 8441:          break;            
 8442:       case (int)VarCode::w:
 8443:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8444:          *sizeType = sizeof(double);
 8445:          break;
 8446:       case (int)VarCode::FaceIndices:
 8447:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8448:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8449:          *sizeType = sizeof(Node);
 8450:          break;
 8451:       default:
 8452:          *offset = -1;
 8453:    }
 8454: }
