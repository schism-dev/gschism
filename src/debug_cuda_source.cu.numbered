 6307: //           if(k>=kbe(i)+1) then; if(ze(k,i)-ze(k-1,i)<=0._rkind) then
 6308: //             write(errmsg,*)'Weird element (1):',k,i,ze(k,i),ze(k-1,i)
 6309: //             call parallel_abort(errmsg)
 6310: //           endif; endif
