 5749:    __global__ void resetVelocityOpenBndNodes(void) {
 5750:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5751: 
 5752:       NODE_BND(nodebnd);
 5753: 
 5754:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5755:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5756:       }
 5757: 
 5758:    }
 5759: 
 5760: 
 5761:    __global__ void setVelocityOpenBndNodes(void) {
 5762:    // For open boundary nodes sets their velocity to the imposed values.
 5763: 
 5764:       SIDE_BND(sidebnd);
 5765: 
 5766:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5767:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5768:          // to its segment to the average of the side velocity.
 5769: 
 5770:          for (int k = 0; k < nvrt; k++) {
 5771:             Node *n1 = sidebnd->side->n1;
 5772:             Node *n2 = sidebnd->side->n2;
 5773: 
 5774:             // Cast the u2 vector into a Vector2 
 5775:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5776:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5777: 
 5778:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5779:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5780:          }
 5781:       }
 5782: 
 5783:    }
 5784: 
 5785: 
 5786:    __global__ void computeVerticalVelocity(void) {
 5787:       // Computes the vertical velocity at the (2D) element's centroid.
 5788:       // In this function we will be considering volumetric elements, with side faces and a 
 5789:       // bottom and a top face. We will call them SFs, BF and TF.
 5790:       // It computes the flux coming from BF and the SFs.
 5791:       // If the bed is moving, it takes that into account.
 5792:       // Since water is incompressible, the integral of the velocity times the normal vector
 5793:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5794:       // and the BF is equal to the flux going out from the TF.
 5795:       // TF = - BF - sum(SFs).
 5796:       // It then computes the horizontal velocity at the center of TF.
 5797:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5798:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5799:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5800: 
 5801:       ELEM(elem);
 5802: 
 5803:       if (elem->isDry) return;
 5804: 
 5805:       const int kb = elem->kb;
 5806:       const bool isTri = elem->isTri();
 5807: 
 5808:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5809: 
 5810:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5811:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5812:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5813: 
 5814:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5815: 
 5816:       double area3D;
 5817: 
 5818:       // Bottom face flux
 5819:       double bottomFlux = 0.0;
 5820:       Vector2 u2meanBottom = {0.0, 0.0};
 5821:       const Vector2 gradh = elem->grad2(&Node::depth);
 5822:       if constexpr(imm==2) {
 5823:          Vector3 ubed;
 5824: 
 5825:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5826:          // updateBDEF(ubed);
 5827:      
 5828:          // const double bflux0 = dot(ubed, elem_n1);
 5829: 
 5830:          // elem->w[kb] += ubed.z;
 5831:       }
 5832:       else {
 5833:          Vector2 umean;
 5834:          if constexpr(ics == 1) {
 5835:             u2meanBottom = elem->mean(kb, &Side::u2);
 5836:          }
 5837:          else {
 5838:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5839:          }
 5840: 
 5841:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5842:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5843: 
 5844:          bottomFlux = - dot(gradh, u2meanBottom);
 5845:       } // if imm
 5846: 
 5847:       // Compute w for kb+1 to nvrt-1
 5848:       for (int l = kb; l < nvrt - 1; l++) {
 5849: 
 5850:          // normal vector to the top face of the "volumetric" element (3D)
 5851:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5852: 
 5853:          // Compute the total flux at the sides
 5854:          double sideFlux = 0.0;
 5855:          Vector2 u2top = {0.0, 0.0};
 5856:          for (int j = 0; j < elem->i34; j++) {
 5857:             const Side *side = elem->sides[j];
 5858: 
 5859:             const double sideArea = side->area(l);
 5860:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5861:             const double sign = elem->ssign[j]; 
 5862: 
 5863:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5864: printf("idx = %d, l = %d, sideFlux = %f, u2c = %f,%f, side->len = %f, zc = %f, %f, sideArea = %f\n", side->idx, l, sideFlux, u2c.x, u2c.y, side->len, side->zc[l], side->zc[l + 1], sideArea);            
 5865:          }
 5866:          
 5867:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5868:          //velocities at the centers of the sides
 5869:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5870: 
 5871:          // The flx at the top ace can be computed from the other flows.
 5872:          const double topFlux = - sideFlux - bottomFlux;
 5873:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5874: 
 5875:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5876: printf("idx = %d, l = %d, sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", elem->idx, l, sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5877: 
 5878: 
 5879:          elem_n1 = elem_n2;
 5880: 
 5881:          bottomFlux = - topFlux;
 5882:       }
 5883:    }  
 5884: 
 5885: 
 5886: 
 5887: 
 5888: 
