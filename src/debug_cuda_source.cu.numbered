 1844: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1845:    // Computes the 3D normal vector to the element at level k
 1846:    // Returns the normal vector and the area of the element
 1847: 
 1848:       if (isTri()) {
 1849:          // For triangles...
 1850: 
 1851:          // Gets the normal vector to the element (with a length equal to twice the area)
 1852:          if constexpr(ics==1) {
 1853:             const int kb0 = max(k, nodes[0]->kb);
 1854:             const int kb1 = max(k, nodes[1]->kb);
 1855:             const int kb2 = max(k, nodes[2]->kb);
 1856: 
 1857:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1858:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1859:             
 1860:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1861:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1862:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1863:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1864: 
 1865:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1866:             area3D = 0.5*len;
 1867: 
 1868:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1869: 
 1870:             return {nx/len, ny/len, nz/len};
 1871: 
 1872:            
 1873:          }
 1874:          else {  // lat/lon
 1875:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1876:             return {0.0, 0.0, 0.0};
 1877: 
 1878:          } // if ics
 1879:       }
 1880:       else {
 1881:          // For quads...
 1882: 
 1883:          assert(false && "Element normal vector: quads not yet implemented");
 1884:          return {0.0, 0.0, 0.0};
 1885: 
 1886: 
 1887:       }
 1888:    }
 1889: 
 1890: /**
 1891:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1892:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1893:    If the segment is completely inside the element, then it returns true.
 1894: 
 1895:    This function assumes:
 1896:    - The initial point is on a side of the element. 
 1897:    - Its position is given by parameter t in the range [0,1].
 1898:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1899:       intersects the element (elements are convex).
 1900: 
 1901:    To find the intersection point, this function does the following:
 1902:    - it finds the intersection of the line segment with all the element side lines,
 1903:       except for the one that contains the initial point.
 1904:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1905:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1906:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1907:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1908:       track segment is almost parallel to the element side line.
 1909: 
 1910:    Inputs:
 1911:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1912:    @param x2, y2: other end of the line segment
 1913: 
 1914:    Outputs:
 1915:    @param side:  side that intersects the line segment (input and output)
 1916:    @param nextElement (output): element that contains the intersection point
 1917:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1918:    @param zint (input/output): Vertical coordinate of the intersection point
 1919: 
 1920:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1921:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1922:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1923: 
 1924:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1925:    (Delta) being zero.
 1926: 
 1927:    The intersection2 point happens when:
 1928:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1929:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1930:    
 1931:    Assumption: the 4 points (including those of the side segment) are different.
 1932:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1933:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1934:    If true, (xIntersect,yIntersect) is the intersection.				
 1935:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1936: **/
 1937: 
 1938: 
 1939: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1940:                                               double &t, double& tIntersect) {
 1941:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1942:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1943: 
 1944:    double closest_intersect_t = 1e10;
 1945:    bool found_intersection = false;
 1946: 
 1947:    for (int i = 0; i < i34; i++) {
 1948: 
 1949:       Side *side2 = sides[i];
 1950: 
 1951:       // (x3,y3)-(x4,y4) is the element side line
 1952:       const Point2 x3 = side2->n1->p;
 1953:       const Point2 x4 = side2->n2->p;
 1954: 
 1955:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1956:       const double delta = cross(x2 - x1, x3 - x4);
 1957: 
 1958:       if (abs(delta) > 0) {
 1959: 
 1960:          const double delta1 = cross(x3 - x1, x3 - x4);
 1961:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1962: 
 1963:          // Solves the two linear equations for tt1 and tt2
 1964:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1965:          const double tt2 = delta2/delta;
 1966: 
 1967:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1968:             closest_intersect_t = min(closest_intersect_t, tt1);
 1969:             side = side2;
 1970:             nextElement = side->otherElem(this);
 1971:             t =          clamp(tt2, small, 1.0-small);
 1972:             tIntersect = clamp(tt1, small, 1.0-small);
 1973:             found_intersection = true;
 1974:          }
 1975: 
 1976:       
 1977:       }
 1978:       else {  // parallel segments
 1979: 
 1980:          continue; 
 1981:          assert(false && "Parallel segments should not happen under the new code");
 1982:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1983:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1984: 
 1985:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1986:          const double dist = dot(x1 - x3, side2->n);
 1987:          if (abs(dist) < small*length(x3 - x4)) {
 1988:             const double2 unitarySide = normalize(x4 - x3);
 1989:             const double len = dot(x2 - x1, unitarySide);
 1990:             t = t + len;
 1991:             t = max(0.0, min(t, 1.0));
 1992:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1993: 
 1994: 
 1995:             // tIntersect = max(small, min(tt1, 1.0-small));
 1996:             // t = tt2;
 1997:             found_intersection = true;
 1998:          }
 1999:       }
 2000: 
 2001: 
 2002:    }
 2003: 
 2004: 
 2005:    assert(found_intersection && "No intersection found");
 2006: 
 2007:    // found_intersection should always be true, since we checked all the sides.  
 2008:    return found_intersection;
 2009: }
 2010: 
 2011: 
 2012: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2013:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2014: 
 2015:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2016:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2017:    // curElement.
 2018: 
 2019:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2020:    // And uses this velocity instead to continue the tracking.
 2021: 
 2022:    // computes the intersection point in cartesian coordinates
 2023:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2024: 
 2025:    // Nudges the point to the barycenter of the element. 
 2026:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2027:    // next segment intersects the element sides. 
 2028:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2029: 
 2030: 
 2031:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2032:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2033:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2034:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2035: 
 2036:    // If the side is an open boundary, the tangential velocity is set to zero.
 2037:    if (nextSide->isBnd()) vtan = 0.0;
 2038: 
 2039:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2040:    const double us = vtan*nextSide->t().x;
 2041:    const double vs = vtan*nextSide->t().y;
 2042:    const double ws = nextSide->w2(jlev); 
 2043: 
 2044:    u_int = {us, vs, ws};
 2045: 
 2046:    // The end of this tracking segment is now the intersection point.
 2047:    xt = {intersection.x, intersection.y, zint};
 2048:    
 2049: }
 2050: 
 2051: /**
 2052:  * Tracks a particle through elements and vertical levels in the mesh.
 2053:  * 
 2054:  * @param x0,y0,z0     Starting position coordinates
 2055:  * @param xt,yt,zt     Target position coordinates
 2056:  * @param dtb          Time step for tracking
 2057:  * @param u_int        Initial velocity components
 2058:  * @param nextElem     Starting/resulting element index
 2059:  * 
 2060:  * @return Status code of type trackExitCodes
 2061:  * 
 2062:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2063:  * of the details are different. The idea is that the code requires less branches and is better fit
 2064:  * for GPU execution.
 2065:  * 
 2066:  * The main ideas here are:
 2067:  * - The starting point is expected to be in the starting element.
 2068:  * - since the starting point is inside the element, there are only two cases: 
 2069:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2070:  *     (b) it does not and (xt,yt) is already in the starting element.
 2071:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2072:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2073:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2074:  * - tt1 can be positive or negative. We only consider the positive values.
 2075:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2076:  * - The next intersection will occur at the smallest positive tt1.
 2077:  * - This intersection will be the next (x0,y0) position.
 2078:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2079:  *   of getting stuck in a loop.
 2080:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2081:  *   was found.
 2082:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2083:  */
 2084: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2085:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2086:                                                        const Side *origSide) {
 2087:                                                             
 2088:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2089:    // else to do. This means that the full step occurred within the current element.
 2090:    assert(!isDry && "Starting element is dry");
 2091:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2092: 
 2093:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2094: 
 2095:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2096:       assert(!isDry && "Target point is inside a dry element");
 2097: 
 2098:       interpolateVelocities(xt, u_int);
 2099: 
 2100:       nextElem = this;
 2101: 
 2102: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2103:       return true;
 2104:    }
 2105: 
 2106: 
 2107:    
 2108: 
 2109:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2110:    
 2111:    double t;
 2112:    Side *nextSide = nullptr;
 2113:    double tIntersect = 1e10;
 2114: 
 2115: 
 2116:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2117:    // (x0,y0) is inside the element but the target point is not.
 2118:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2119:    assert(found_intersection && "No intersection found at %d");
 2120: 
 2121:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2122: 
 2123:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2124:    if (nextElem != nullptr && !nextElem->isDry) {
 2125:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2126:       nextElem->nudgeToBarycenter(xtmp);
 2127:    }
 2128: 
 2129:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2130:    xt = {xtmp.x, xtmp.y, zint};
 2131: 
 2132:    // if the tracking segment goes out of water (either dry or edge boundary)
 2133:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2134: 
 2135: 
 2136:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2137: 
 2138:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2139:       // When this happens, the backtracking stops.
 2140:       // dt = time_rm;  LLLLLL KKKK XXXX
 2141:       dt *= tIntersect;
 2142: 
 2143:       // In this case, the next element is again the current element.
 2144:       nextElem = this;
 2145: 
 2146: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2147: 
 2148:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2149:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2150:       return true;    
 2151:    }
 2152: 
 2153: 
 2154:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2155:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2156:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2157: 
 2158:    
 2159:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2160: 
 2161:    nextElem->interpolateVelocities(xt, u_int); 
 2162: 
 2163:    assert(nextElem != this && "Next element is the same as the current element");
 2164: 
 2165:    return true;
 2166: }
 2167: 
 2168: 
 2169: __inline__ __device__ double Element::computeSignedArea(void) const {
 2170:    // Compute the area of the element
 2171: 
 2172:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2173: 
 2174:    // In the quad case we need to add the area of the other triangle.
 2175:    if (isQuad()) {
 2176:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2177:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2178:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2179:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2180: 
 2181:       res += ar1;
 2182:    }
 2183: 
 2184:    return res;
 2185: }
 2186: 
 2187: 
 2188: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2189:                                                                 (nodes[1]->isDry2()) ||
 2190:                                                                 (nodes[2]->isDry2()) ||
 2191:                                                                 (i34==4 && nodes[3]->isDry2());
 2192: }
 2193: 
 2194: __inline__ __device__ double Element::detJ_eta(void) const {
 2195:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2196:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2197: }
 2198: 
 2199: __inline__ __device__ double Element::detJ_xi(void) const {
 2200:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2201:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2202: }
 2203: 
 2204: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2205:    // In boundary sides, the element 1 is nullptr
 2206:    return side->elems[1] == nullptr; 
 2207: }
 2208: 
 2209: 
 2210: 
 2211: /**
 2212:    Compute the shape coordinates of the point (xt,yt) in the element.
 2213:    @param xt (input): x-coordinate of the point
 2214:    @param shpCoords (output): shape coordinates of the point
 2215:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2216:    @return true if the point is inside the element, false otherwise
 2217: **/
 2218: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord) const {
 2219: 
 2220:    // Compute the shape coordinates of the point xt in the element.
 2221:    if (i34==3) {
 2222:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2223:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2224:       // and in this case, the pt will be nudged into the element
 2225:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2226:       // from the local frame, so use additional check.
 2227: 
 2228:       Point2 x0, x1, x2;
 2229: 
 2230:       if constexpr(ics==1) {
 2231:          x0 = nodes[0]->p;
 2232:          x1 = nodes[1]->p;
 2233:          x2 = nodes[2]->p;
 2234:       }
 2235:       else // lat/lon
 2236:       {
 2237:          Error("Not implemented yet");
 2238:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2239:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2240:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2241:       }
 2242: 
 2243:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2244:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2245:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2246:       shpCoords[3] = 0.0;
 2247: 
 2248:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2249:       const bool res = (tmpmin >= -small);  
 2250:       
 2251:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2252:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2253: 
 2254:       
 2255:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2256:       // then we fix the negative shape coordinates.
 2257:       if ((tmpmin < 0) && fix) {
 2258: 
 2259:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2260:          // keeping the sum of the shape coordinates equal to 1.
 2261:          // I have tested and compared the new algorithm with the old one, and they give
 2262:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2263:          // The new algorithm should be faster since it is branchless.
 2264:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2265:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2266:          
 2267:          shpCoords[0] = (shpCoords[0] + a)*b;
 2268:          shpCoords[1] = (shpCoords[1] + a)*b;
 2269:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2270: 
 2271:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2272:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2273:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2274: 
 2275:          // Update the point coordinates for the new shape coordinates
 2276:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2277:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2278:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2279: 
 2280:       }
 2281: 
 2282:       // Check if the point is inside the element
 2283:       return res;      
 2284:    }
 2285:    else {
 2286:       Error("Not implemented yet");
 2287: #ifdef QUADS
 2288:       // Reproject pt in eframe of nel for ics=2
 2289:       if constexpr(ics==1) {
 2290:          xn2 = xt; 
 2291:          yn2 = yt;
 2292:       }
 2293:       else {
 2294:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2295:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2296:       }
 2297: 
 2298:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2299: #endif
 2300:    }
 2301: 
 2302:    assert(false && "computeShapeCoords: should never reach this point");
 2303:    return false;  // Never reached
 2304: 
 2305: }
 2306: 
 2307: 
 2308: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2309: // Convert shape coordinates to cartesian coordinates
 2310: 
 2311:    if (i34 == 3) {
 2312:       // Triangular element
 2313:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2314:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2315:    }
 2316:    else {
 2317:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2318:    }
 2319: 
 2320: }
 2321: 
 2322: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2323:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2324:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2325:    // The formula for the integral is:
 2326:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2327: 
 2328:    printf("intPhiPhi: TEST\n");
 2329: 
 2330:    const Node *n0 = nodes[0];
 2331:    const Node *n1 = nodes[1];
 2332:    const Node *n2 = nodes[2];
 2333:    const Node *n3 = nodes[3];
 2334: 
 2335:    const Vector2 p0 = n0->p;
 2336:    const Vector2 p1 = n1->p;
 2337:    const Vector2 p2 = n2->p;
 2338:    const Vector2 p3 = n3->p;
 2339: 
 2340:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2341:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2342:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2343:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2344: 
 2345:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2346: }
 2347:    
 2348: 
 2349: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2350:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2351:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2352:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2353:    // The formula is also based on the identity:
 2354:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2355:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2356: 
 2357:    printf("intGradPhiGradPhi: TEST\n");   
 2358: 
 2359:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2360: 
 2361:    const double x0 = nodes[0]->p.x;
 2362:    const double y0 = nodes[0]->p.y;
 2363:    const double x1 = nodes[1]->p.x;
 2364:    const double y1 = nodes[1]->p.y;
 2365:    const double x2 = nodes[2]->p.x;
 2366:    const double y2 = nodes[2]->p.y;
 2367:    const double x3 = nodes[3]->p.x;
 2368:    const double y3 = nodes[3]->p.y;
 2369: 
 2370:    double res = 0.0;
 2371:    
 2372:    // Quadrature points in xi and eta coordinates
 2373:    #pragma unroll
 2374:    for (int i = 0; i < 4; i++) {
 2375:       // For each quadrature point...
 2376: 
 2377:       const Point2 p = GaussPoint(i);
 2378:       const double eta = p.x;
 2379:       const double xi  = p.y;
 2380: 
 2381:       // Jacobian entries at the Gauss point p
 2382:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2383:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2384:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2385:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2386: 
 2387:       const double detJ = jacobianDet(p);
 2388:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2389: 
 2390:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2391:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2392:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2393:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2394:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2395: 
 2396:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2397:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2398:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2399:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2400:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2401: 
 2402:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2403:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2404:    }
 2405: 
 2406:    return res;
 2407: }
 2408: 
 2409: 
 2410: /**  Interpolate velocities at a given point (xt,yt,zt)
 2411: 
 2412:    @param xt, yt, zt: coordinates of the point to interpolate
 2413:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2414: 
 2415:    This is done in four steps:
 2416: 
 2417:    1. Find the shape coordinates for the final position in the element.
 2418:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2419:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2420:       z levels at xt, yt at each step.   
 2421:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2422:       horizontally and vertically.
 2423: **/
 2424: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2425:    // Interpolate the velocities at the point xt. 
 2426:    // This function works the same for triangular and quadrilateral elements.
 2427:    double shpCoord[4];
 2428: 
 2429:    // First step is to compute the shape coordinates of (xt,yt)
 2430:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside);
 2431: 
 2432:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2433: 
 2434:    // Second step is to find the level that contains zt
 2435:    // Uses a binary search to find the level
 2436:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2437:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2438:    int R = nvrt - 1;
 2439: 
 2440:    // Get the z coordinates at the nodes of the element at the levels L and R
 2441:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2442:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2443:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2444: 
 2445:    double zL = interpolate(shpCoord, zLAtNodes);
 2446:    double zR = interpolate(shpCoord, zRAtNodes);
 2447:    
 2448:    // Interpolates vertically the velocities
 2449:    double wght1, wght2;
 2450:    if (xt.z<=zL) {
 2451:       wght1 = 1.0;
 2452:       wght2 = 0.0;
 2453:       xt.z = zL;
 2454:    }
 2455:    else if (xt.z>=zR) {
 2456:       wght1 = 0.0;
 2457:       wght2 = 1.0;
 2458:       xt.z = zR;
 2459:    }
 2460:    else {
 2461:       // Perform a binary search to find the levels between L and R that contain xt.z
 2462:       while (R - L > 1) {
 2463:          int M = (L + R) / 2.0;
 2464: 
 2465:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2466:          double zM = interpolate(shpCoord, zMAtNodes);
 2467:          if (zM < xt.z) 
 2468:          {
 2469:             L = M;
 2470:             zL = zM;
 2471:          }
 2472:          else 
 2473:          {
 2474:             R = M;
 2475:             zR = zM;
 2476:          }
 2477:       }
 2478:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2479:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2480: 
 2481:       wght2 = (xt.z - zL)/(zR - zL);
 2482:       wght1 = 1.0 - wght2;
 2483: 
 2484:    }
 2485: 
 2486: 
 2487:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2488:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2489: 
 2490:    // Neither of the interpolated velocities should be NaN
 2491:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2492: 
 2493: }
 2494: 
 2495: 
 2496: 
 2497: 
 2498: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2499: 
 2500:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2501:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2502:    const Node *n1 = side->n1;
 2503:    const Node *n2 = side->n2;
 2504: 
 2505:    bool n1_match = (n1->nodeBnd->segment == segment);
 2506:    bool n2_match = (n2->nodeBnd->segment == segment);
 2507: 
 2508:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2509:    if (n1_match && n2_match) {
 2510:       return 0.5;
 2511:    } else if (n1_match) {
 2512:       return 1.0;
 2513:    } else if (n2_match) {
 2514:       return 0.0;
 2515:    }
 2516: 
 2517:    return 0.0;
 2518: }
 2519: 
 2520: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2521: 
 2522: 
 2523: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2524: 
 2525:    const double w1 = getBoundaryArrayValueWeight();
 2526:    const double w2 = 1.0 - w1;
 2527:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2528:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2529: 
 2530:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2531: }
 2532: 
 2533: 
 2534: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2535:    const double w1 = getBoundaryArrayValueWeight();
 2536:    const double w2 = 1.0 - w1;
 2537:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2538:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2539: 
 2540:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2541: 
 2542: }
 2543: 
 2544: 
 2545: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2546:    // Returns the value of the velocity at the side center
 2547:    const double w1 = getBoundaryArrayValueWeight();
 2548:    const double w2 = 1.0 - w1;
 2549:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2550:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2551: 
 2552:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2553: }
 2554: 
 2555: 
 2556: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2557:    // Returns the value of the normal component of the velocity at the side center
 2558:    const double w1 = getBoundaryArrayValueWeight();
 2559:    const double w2 = 1.0 - w1;
 2560:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2561:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2562: 
 2563:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2564: }
