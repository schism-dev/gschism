 1417:    Side*    localSideData; 
 1418: 
 1419:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1420:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1421:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1422:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1423:    
 1424:    const int npgb;  // Global number of horizontal nodes
 1425:    const int negb;  // Global number of elements
 1426:    const int nsgb;  // Global number of sides
 1427: 
 1428:    const int np;   // Local number of horizontal nodes 
 1429:    const int ne;   // Local number of elements
 1430:    const int ns;   // Local number of sides
 1431: 
 1432:    int nbp;  // Local number of boundary nodes
 1433:    int nbs;  // Local number of boundary sides
 1434: 
 1435:    int nEntries;  // Total number of matrix elements
 1436: 
 1437:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1438:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1439:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1440: 
 1441:   
 1442:    // Additional topology information
 1443:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1444:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1445: 
 1446:    BoundarySegment landBoundarySegment;
 1447:    NodeBoundary landBoundaryNode;
 1448: 
 1449:    // Vertical coordinate system
 1450:    // Sigma levels
 1451:    double h_s; 
 1452:    double h_c; 
 1453: 
 1454:    double theta_b;
 1455:    double theta_f, sinh_theta_f;
 1456:    double *sigma_lcl;
 1457:    double *sigma;
 1458:    double *ztot;
 1459:    double *cs;
 1460:    double *dcs;
 1461: 
 1462:    // // Get's the pointer to the node using the array of global pointers to nodes
 1463:    // __device__ const Node *getGlobalNode(int jn) {
 1464:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1465:    //    return nodes[idx] + idx;
 1466:    // }
 1467: 
 1468:    // // Get's the pointer to the element using the array of global pointers to elements
 1469:    // __device__ const Element *getGlobalElem(int je) {
 1470:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1471:    //    return elems[idx] + idx;
 1472:    // }
 1473: 
 1474:    // // Get's the pointer to the side using the array of global pointers to sides
 1475:    // __device__ const Side *getGlobalSide(int js) {
 1476:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1477:    //    return sides[idx] + idx;
 1478:    // }
 1479: 
 1480:    // // Get's the global index of local node idx
 1481:    // __device__ int getGlobalNodeIndex(int idx) {
 1482:    //    return idx + partNum * max_np;
 1483:    // }
 1484: 
 1485:    // // Get's the global index of local element idx
 1486:    // __device__ int getGlobalElemIndex(int idx) {
 1487:    //    return idx + partNum * max_ne;
 1488:    // }
 1489: 
 1490:    // // Get's the global index of local side idx
 1491:    // __device__ int getGlobalSideIndex(int idx) {
 1492:    //    return idx + partNum * max_ns;
 1493:    // }  
 1494: 
 1495:    __device__ Mesh(int partNum,
 1496:                    int npgb, int negb, int nsgb, 
 1497:                    int np, int ne, int ns,
 1498:                    int max_np, int max_ne, int max_ns, int nseg,
 1499:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1500:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1501:                    Node    **localNodeNeighNodesMem,
 1502:                    Element **localNodeNeighElemsMem,
 1503:                    double *partCoeffMatrixMem,
 1504:                    NodeBoundary *localNodeBoundaryMem,
 1505:                    SideBoundary *localSideBoundaryMem,
 1506:                    BoundarySegment *localSegmentMem,
 1507:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1508:                    double *cs, double *dcs
 1509:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1510:                        np(np), ne(ne), ns(ns),
 1511:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1512:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1513:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1514:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1515:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1516:                        localSegmentMem(localSegmentMem),
 1517:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1518:                        cs(cs), dcs(dcs),
 1519:                        coeffMatrixMem(partCoeffMatrixMem),
 1520:                        landBoundarySegment(true),
 1521:                        landBoundaryNode(true)
 1522:    {
 1523:       printf("Mesh constructor for partition %d\n", partNum);
 1524: 
 1525:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1526:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1527:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1528:  
 1529:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1530:       
 1531:       sinh_theta_f = sinh(theta_f);
 1532: 
 1533:    }
