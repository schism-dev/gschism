 2376:    template<typename T>
 2377:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2378:       T values[4];
 2379:       getNodalValues(level, func, values);
 2380: 
 2381:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2382:       if constexpr (IsVector2<T>::value && ics == 2) {
 2383: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2384:          projectNodeVectorsToElementFrame(values);
 2385: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2386:       }
 2387: 
 2388:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2389:    }
 2390: 
 2391:    template<typename T>
 2392:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2393:       T values[4];
 2394:       getNodalValues(field, values);
 2395: 
 2396:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2397:       if constexpr (IsVector2<T>::value && ics == 2) {
 2398: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2399:          projectNodeVectorsToElementFrame(values);
 2400: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2401:       }
 2402:       
 2403:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2404:    }
