  516: 
  517: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  518:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  519:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  520: }
  521: 
  522: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  523:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  524:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  525: }
  526: 
  527: 
  528: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  529:    x3 = y1*z2 - y2*z1;
  530:    y3 = x2*z1 - x1*z2;
  531:    z3 = x1*y2 - x2*y1;
  532: // XXXXXX IS THIS REPEATED????
  533: }
  534: 
  535: 
  536: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  537: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  538: //
  539: 
  540:    const double radius2 = dot(p, p);
  541:    const double radius = sqrt(radius2);
  542:  
  543:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  544:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  545: 
  546:    rlon = atan2(p.y, p.x); // (-pi,pi]
  547: 
  548:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  549:       rlat = asin(p.z/radius);
  550:    } else {
  551:       rlat = asin(p.z/rearth_pole);
  552:    }
  553:   
  554: }
  555: 
  556: 
  557: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  558: // Compute the 3D Cartesian coordinates from the latitude and longitude
  559: // Inputs:
  560: //        lat: latitude in radians
  561: //        lon: longitude in radians
  562: // Output:
  563: //        x, y, z: 3D Cartesian coordinates
  564: 
  565:    double sin_lat, cos_lat, sin_lon, cos_lon;
  566: 
  567:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  568:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  569: 
  570:    sincos(lat, &sin_lat, &cos_lat);
  571:    sincos(lon, &sin_lon, &cos_lon);
  572: 
  573:    const double x = rearth_eq*cos_lat*cos_lon;
  574:    const double y = rearth_eq*cos_lat*sin_lon;
  575:    const double z = rearth_pole*sin_lat;
  576: 
  577:    return make_double3(x, y, z);
  578: }
  579: 
  580: __inline__ __device__ void Error(const char* msg) {
  581:    printf("Error: %s\n", msg);
  582:    assert(false);
  583: }
