 1524: 
 1525: /**
 1526:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1527:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1528:    If the segment is completely inside the element, then it returns true.
 1529: 
 1530:    This function assumes:
 1531:    - The initial point is on a side of the element. 
 1532:    - Its position is given by parameter t in the range [0,1].
 1533:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1534:       intersects the element (elements are convex).
 1535: 
 1536:    To find the intersection point, this function does the following:
 1537:    - it finds the intersection of the line segment with all the element side lines,
 1538:       except for the one that contains the initial point.
 1539:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1540:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1541:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1542:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1543:       track segment is almost parallel to the element side line.
 1544: 
 1545:    Inputs:
 1546:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1547:    @param x2, y2: other end of the line segment
 1548: 
 1549:    Outputs:
 1550:    @param side:  side that intersects the line segment (input and output)
 1551:    @param nextElement (output): element that contains the intersection point
 1552:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1553:    @param zint (input/output): Vertical coordinate of the intersection point
 1554: 
 1555:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1556:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1557:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1558: 
 1559:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1560:    (Delta) being zero.
 1561: 
 1562:    The intersection2 point happens when:
 1563:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1564:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1565:    
 1566:    Assumption: the 4 points (including those of the side segment) are different.
 1567:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1568:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1569:    If true, (xIntersect,yIntersect) is the intersection.				
 1570:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1571: **/
 1572: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1573:                                               double &t, double& tIntersect) {
 1574: 
 1575:    double closest_intersect_t = 1e10;
 1576:    bool found_intersection = false;
 1577: 
 1578:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1579:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1580:    const Point2 x1 = side->point(t);
 1581:    
 1582: 
 1583:    Side *nextSide = nullptr;
 1584:    for (int i = 0; i < i34; i++) {
 1585: 
 1586:       // Element's i-th side 
 1587:       Side *side2 = sides[i];
 1588: 
 1589:       // Skip the side that contains the initial point
 1590:       if (side2 == side) continue;
 1591: 
 1592:       // (x3,y3)-(x4,y4) is the element side line
 1593:       const Point2 x3 = side2->n1->p2();
 1594:       const Point2 x4 = side2->n2->p2();
 1595: 
 1596:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1597:       const double delta = cross(x2 - x1, x3 - x4);
 1598: 
 1599:       if (delta != 0.0) {
 1600: 
 1601:          const double delta1 = cross(x3 - x1, x3 - x4);
 1602:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1603: 
 1604:          // Solves the two linear equations for tt1 and tt2
 1605:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1606:          const double tt2 = delta2/delta;
 1607: 
 1608:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1609:             closest_intersect_t = min(closest_intersect_t, tt1);
 1610:             nextSide = side2;
 1611: 
 1612:             nextElement = nextSide->otherElem(this);
 1613:             tIntersect = max(small, min(tt1, 1.0-small));
 1614:             t = tt2;
 1615: 
 1616:             found_intersection = true;
 1617:          }
 1618:       
 1619:       }
 1620: 
 1621:    }
 1622:    
 1623: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1624: 
 1625: 
 1626:    // found_intersection should always be true, since we checked all the sides.  
 1627:    side = nextSide;
 1628: // if (found_intersection) {
 1629: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1630: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1631: // }   
 1632:    // if (!found_intersection) {
 1633:    //    // Check if the segment is parallel to the initial side
 1634:    //    printf("XXX segment: side = %p\n", side);
 1635:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1636:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1637:    //       assert(false && "Segment is parallel to the initial side");
 1638:    //       found_intersection = true;
 1639:    //       nextElement = side->otherElem(this);
 1640:    //       tIntersect = t;
 1641:    //       t = 0.0;
 1642:    //       found_intersection = true;
 1643:    //    }
 1644:    // }
 1645:    return found_intersection;
 1646: }
 1647: 
