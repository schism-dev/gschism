 7091: 
 7092:    __global__ void computeVerticalVelocity(void) {
 7093:       // Computes the vertical velocity at the (2D) element's centroid.
 7094:       // In this function we will be considering volumetric elements, with side faces and a 
 7095:       // bottom and a top face. We will call them SFs, BF and TF.
 7096:       // It computes the flux coming from BF and the SFs.
 7097:       // If the bed is moving, it takes that into account.
 7098:       // Since water is incompressible, the integral of the velocity times the normal vector
 7099:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7100:       // and the BF is equal to the flux going out from the TF.
 7101:       // TF = - BF - sum(SFs).
 7102:       // It then computes the horizontal velocity at the center of TF.
 7103:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7104:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7105:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7106: 
 7107:       ELEM(elem);
 7108: 
 7109:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7110: 
 7111:       if (elem->isDry) return;
 7112: 
 7113:       const int kb = elem->kb;
 7114:       const bool isTri = elem->isTri();
 7115: 
 7116:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7117: 
 7118:       // Compute the bottom velocity
 7119:       if constexpr(imm != 0) {
 7120:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7121:       }
 7122: 
 7123: 
 7124:       double bottomArea3D;
 7125:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7126: 
 7127:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7128: 
 7129:       double topArea3D;
 7130: 
 7131:       // Bottom face flux
 7132:       double bottomFlux = 0.0;
 7133:       Vector2 u2meanBottom = {0.0, 0.0};
 7134:       const Vector2 gradh = elem->grad2(&Node::depth);
 7135:       if constexpr(imm==2) {
 7136:          Vector3 ubed;
 7137: 
 7138:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7139:          // updateBDEF(ubed);
 7140:      
 7141:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7142: 
 7143:          // elem->w[kb] += ubed.z;
 7144:       }
 7145:       else {
 7146: 
 7147:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7148:   
 7149:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7150:          // in the direction of motion.
 7151:          const double bottomW = - dot(gradh, u2meanBottom);  
 7152:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7153: 
 7154:          // VElocity associated to the bed deformation
 7155:          double bedVelocity = 0.0;
 7156:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7157: 
 7158:          elem->w[kb] = bedVelocity + bottomW; 
 7159: 
 7160:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7161:          
 7162:       } // if imm
 7163: 
 7164:       // Compute w for kb+1 to nvrt-1
 7165:       for (int l = kb; l < nvrt - 1; l++) {
 7166: 
 7167:          // normal vector to the top face of the "volumetric" element (3D)
 7168:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7169: 
 7170:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7171:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7172: 
 7173:          // Compute the total flux at the sides
 7174:          double sideFlux = 0.0;
 7175: 
 7176:          for (int j = 0; j < elem->i34; j++) {
 7177:             const Side *side = elem->sides[j];
 7178:             const int kbs = side->kb;
 7179:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7180:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7181:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7182: 
 7183:             // The area is "clamped" meaning that it takes kb into account.
 7184:             const double sideArea = side->areaClamped(l);
 7185: 
 7186:             const double sign = elem->ssign[j]; 
 7187: 
 7188:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7189:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7190:          }
 7191:          
 7192:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7193:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7194:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7195: 
 7196:          // The flux at the top ace can be computed from the other flows.
 7197:          // All fluxes are in directions into the prism.
 7198:          const double topFlux = - sideFlux - bottomFlux;
 7199: 
 7200:          // Flux at the top face due to the horizontal velocities only
 7201:          // topFlux = topHorizontalFlux + topVerticalFlux
 7202:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7203: 
 7204:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7205:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7206: 
 7207:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7208: 
 7209:          bottomFlux = -topFlux;
 7210:          
 7211:       }
 7212: 
 7213:    }  
 7214: 
 7215: 
 7216: 
 7217: 
 7218: 
 7219: 
