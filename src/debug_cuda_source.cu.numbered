 9098: #ifdef DONTCOMPILE
 9099: __global__ void checkMassConservation(Tracers* sumtr) {
 9100: 
 9101:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 9102: 
 9103:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 9104: 
 9105:    Element *elem = &(mesh->localElemData[i]);
 9106: 
 9107:    // Skip dry elements
 9108:    if (elem->isDry) return;
 9109: 
 9110:    // Local sum array for this thread
 9111:    double localSum[ntracers] = {0.0};
 9112: 
 9113:    // Sum over vertical levels for this element
 9114:    const int kbe = elem->kbe;
 9115:    const double area = elem->area;
 9116: 
 9117:    for (int k = kbe; k < nvrt; k++) {
 9118:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 9119:       
 9120:       // Accumulate tracer mass
 9121:       for (int tr = 0; tr < ntracers; tr++) {
 9122:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 9123:       }
 9124:    }
 9125: 
 9126:    //  This function returns per element sums. A reduction must be done on the host side.
 9127: }  
