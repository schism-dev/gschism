 1454:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1455:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1456:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1457:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1458:    
 1459:    const int npgb;  // Global number of horizontal nodes
 1460:    const int negb;  // Global number of elements
 1461:    const int nsgb;  // Global number of sides
 1462: 
 1463:    const int np;   // Local number of horizontal nodes 
 1464:    const int ne;   // Local number of elements
 1465:    const int ns;   // Local number of sides
 1466: 
 1467:    int nbp;  // Local number of boundary nodes
 1468:    int nbs;  // Local number of boundary sides
 1469: 
 1470:    int nEntries;  // Total number of matrix elements
 1471: 
 1472:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1473:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1474:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1475: 
 1476:   
 1477:    // Additional topology information
 1478:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1479:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1480: 
 1481:    BoundarySegment landBoundarySegment;
 1482:    NodeBoundary landBoundaryNode;
 1483: 
 1484:    // Vertical coordinate system
 1485:    // Sigma levels
 1486:    double h_s; 
 1487:    double h_c; 
 1488: 
 1489:    double theta_b;
 1490:    double theta_f, sinh_theta_f;
 1491:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1492:    double *ztot;
 1493:    double *cs;
 1494:    double *dcs;
 1495: 
 1496:    // // Get's the pointer to the node using the array of global pointers to nodes
 1497:    // __device__ const Node *getGlobalNode(int jn) {
 1498:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1499:    //    return nodes[idx] + idx;
 1500:    // }
 1501: 
 1502:    // // Get's the pointer to the element using the array of global pointers to elements
 1503:    // __device__ const Element *getGlobalElem(int je) {
 1504:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1505:    //    return elems[idx] + idx;
 1506:    // }
 1507: 
 1508:    // // Get's the pointer to the side using the array of global pointers to sides
 1509:    // __device__ const Side *getGlobalSide(int js) {
 1510:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1511:    //    return sides[idx] + idx;
 1512:    // }
 1513: 
 1514:    // // Get's the global index of local node idx
 1515:    // __device__ int getGlobalNodeIndex(int idx) {
 1516:    //    return idx + partNum * max_np;
 1517:    // }
 1518: 
 1519:    // // Get's the global index of local element idx
 1520:    // __device__ int getGlobalElemIndex(int idx) {
 1521:    //    return idx + partNum * max_ne;
 1522:    // }
 1523: 
 1524:    // // Get's the global index of local side idx
 1525:    // __device__ int getGlobalSideIndex(int idx) {
 1526:    //    return idx + partNum * max_ns;
 1527:    // }  
 1528: 
 1529:    __device__ Mesh(int partNum,
 1530:                    int npgb, int negb, int nsgb, 
 1531:                    int np, int ne, int ns,
 1532:                    int max_np, int max_ne, int max_ns, int nseg,
 1533:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1534:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1535:                    Node    **localNodeNeighNodesMem,
 1536:                    Element **localNodeNeighElemsMem,
 1537:                    double *partCoeffMatrixMem,
 1538:                    NodeBoundary *localNodeBoundaryMem,
 1539:                    SideBoundary *localSideBoundaryMem,
 1540:                    BoundarySegment *localSegmentMem,
 1541:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1542:                    double *cs, double *dcs
 1543:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1544:                        np(np), ne(ne), ns(ns),
 1545:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1546:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1547:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1548:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1549:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1550:                        localSegmentMem(localSegmentMem),
