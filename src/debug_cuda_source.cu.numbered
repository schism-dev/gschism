 8279: __global__ void printMatrix(bool full) {
 8280:    // Debugging: print the FEM matrix row for each local node
 8281: 
 8282:    const int size = mesh->np;
 8283:    double sum = 0.0;
 8284: 
 8285:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8286:       const Node *node = mesh->localNodeData + idx_node;
 8287: 
 8288:       if (full)
 8289:          printf("idx_node = %d [%d] diag=%lf, [",
 8290:                 idx_node, node->numNodes, *(node->coeffDiag));
 8291: 
 8292:       // Full CSR row length = numNodes + 1 (includes diagonal)
 8293:       for (int k = 0; k < node->numNodes + 1; k++)
 8294:          sum += node->coeffRow[k];
 8295: 
 8296:       for (int j = 0; j < node->numNodes; j++) {
 8297:          const Node *nbNode = node->nodes[j];
 8298:          const double aij = node->coeffRow[node->csrSlot[j]];
 8299:          if (full && aij != 0.0)
 8300:             printf("%d:%f,  ", nbNode->idx, aij);
 8301:       }
 8302: 
 8303:       if (full) printf("]\n");
 8304:    }
 8305: 
 8306:    if (!full) printf("sum=%lf\n", sum);
 8307: }
