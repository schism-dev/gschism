  882: 
  883:    __device__ Vector2 grad2(double *a) const
  884:    {
  885:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  886:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  887:       if (isQuad()) {
  888:          gx += a[3]*gradPhi[3].x;
  889:          gy += a[3]*gradPhi[3].y;
  890:       }
  891:       return {gx, gy};
  892:    }
  893: 
  894:    __device__ Vector2 grad2(double Node::* field) const
  895:    {
  896:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  897:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  898:       if (isQuad()) {
  899:          gx += (nodes[3]->*field)*gradPhi[3].x;
  900:          gy += (nodes[3]->*field)*gradPhi[3].y;
  901:       }
  902:       return {gx, gy};
  903:    }
