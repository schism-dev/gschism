 4446:    __global__ void computeFlowBcVelocities(double time) {
 4447: 
 4448:       SIDE_BND(sideBnd);
 4449: 
 4450:       const Side *side = sideBnd->side;
 4451:  
 4452:       const bool isDry = side->isDry;
 4453:       const bool isLand = sideBnd->segment->isLand;
 4454: 
 4455:    
 4456:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4457: 
 4458:       if (isDry || isLand) return;
 4459: 
 4460:       // For wet sides in open boundaries...
 4461:       const Vector2 n = side->n;
 4462:       const BoundarySegment *segment = sideBnd->segment;
 4463: 
 4464:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4465: 
 4466:       const int ifltype = segment->ifltype;
 4467: 
 4468:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4469:       const Vector2 r_nuth0 = r_uth0*n;
 4470: 
 4471: 
 4472:       if (ifltype == 1 || ifltype == 2) {
 4473:       
 4474:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4475: 
 4476:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4477:          
 4478:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4479:          
 4480:       } else if (ifltype == -1) { // Flather 1
 4481: 
 4482:          for (int k = 0; k < nvrt; k++) {
 4483: 
 4484:             // uth is the normal vel.; no ramp up
 4485:             const double uth = sideBnd->nuth(k);
 4486:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4487: 
 4488:             sideBnd->ubc[k] += uth*n;
 4489:          }
 4490: 
 4491:       } else if (ifltype == 3 || ifltype == 5) {
 4492:          // vnth0=0 !normal vel.
 4493: 
 4494:          Vector2 r_u1_bar = {0.0, 0.0};
 4495:          // Computes the contribution to the velocity from all tide frequencies
 4496:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4497: 
 4498:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4499:             const Vector2 umo  = sideBnd->umo(jfr); 
 4500: 
 4501:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4502:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4503:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4504:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4505:          }
 4506: 
 4507: 
 4508:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4509: 
 4510:       } // if (ifltype = 3 || ifltype == 5
 4511: 
 4512: 
 4513: 
 4514:    }
 4515: 
 4516:    __global__ void computeElevationBoundaryConditions(double time) {
 4517:       // Compute elevation essential boundary conditions 
 4518: 
 4519:       NODE_BND(nodeBnd); // Each boundary node.
 4520: 
 4521:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4522: 
 4523:       const Node *node = nodeBnd->node;
 4524:       const BoundarySegment *segment = nodeBnd->segment;
 4525:       const int iettype = segment->iettype;
 4526:       
 4527: 
 4528:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4529:       double eic = 0.0;
 4530:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4531:       else                 eic = 0.0;
 4532: 
 4533:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4534:       const double r_eth = ramp*nodeBnd->eth;
 4535:       double r_eta1_bar = 0.0;
 4536: 
 4537: 
 4538:       // Compute tide elevation
 4539:       if (iettype == 3 || iettype == 5) {   
 4540: 
 4541:          if constexpr(iloadtide==1) { // loading tide
 4542:             assert(false && "Loading tide not implemented");
 4543:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4544:          }
 4545:          
 4546:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4547: 
 4548:             const double efa  = nodeBnd->efa[jfr]; 
 4549:             const double emo  = nodeBnd->emo[jfr]; 
 4550: 
 4551:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4552:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4553:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4554: 
 4555:          } // for jfr
 4556: 
 4557:       } // if iettype
 4558: 
 4559:       switch (iettype) {
 4560:          case 1:
 4561:          case 2:
 4562:          case 4:
 4563:             nodeBnd->elbc = r_eic + r_eth;
 4564:             break;
 4565:          case 3:
 4566:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4567:             break;
 4568:          case 5:
 4569:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4570:             break;
 4571:       } // switch
 4572: 
 4573: 
 4574:       //Add inverse barometric effects
 4575:       if (iettype != 0 && inv_atm_bnd == 1) {
 4576:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4577:       }
 4578: 
 4579:    }
 4580: 
 4581: 
 4582:    __global__ void computeHorizontalViscosity(void) { 
 4583: 
 4584:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4585: 
 4586:       SIDE(side);
 4587: 
 4588:       if (side->isDry) return;
 4589: 
 4590:       for (int k = 0; k < nvrt; k++) {
 4591:          side->nuGradU[k] = {0.0, 0.0};
 4592:       }
 4593: 
 4594:       if constexpr(ihorcon == 1) {
 4595:          for (int k = side->kb; k < nvrt - 1; k++) {
 4596:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4597:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4598:             // By Zhang and Baptista.
 4599: 
 4600:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4601:             // This is a standard discretization of the Laplacian operator.
 4602:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4603:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4604:             // Gamma is hvis_coef0 in the code.
 4605:             // The value of gamma needs to be < 0.5.
 4606: 
 4607:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4608:             // side under consideration in each of the two possible elements that share the side.
 4609:             Vector2 sumU = {0.0, 0.0};
 4610:             for (int l = 0; l < 2; l++) {
 4611:                const Element *elem = side->elems[l];
 4612: 
 4613:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4614: 
 4615:                // Find the local index of the side in the element
 4616:                const int idxSide = elem->sideLocalIdx(side);
 4617:                // Find the two sides that are connected to the side under consideration
 4618:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4619:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4620: 
 4621:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4622: 
 4623:             }
 4624: 
 4625:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4626:    
 4627:          }
 4628:       }
 4629:       else if constexpr(ihorcon == 2) {
 4630:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4631:       }
 4632: 
 4633: 
 4634:    }
 4635: 
 4636: 
 4637:    __global__ void setEssentialBC(void) {
 4638:       // Set essential boundary conditions 
 4639:       NODE(node); // Each boundary node
 4640:       NodeBoundary *nodeBnd = node->nodeBnd;
 4641:       
 4642: // nodeBnd->isEssentialBC = true;      
 4643:       // Check if this node has essential BC
 4644:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4645:          // Verify BC value is valid
 4646:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4647: 
 4648:        
 4649:          // Set diagonal to 1 and zero off-diagonals
 4650:          node->coeffDiag = 1.0;
 4651: 
 4652:          for (int j = 0; j < node->numNodes; j++) {
 4653:                node->coeffMatrix[j] = 0.0;
 4654:          }
 4655:          
 4656:          // Set solution and RHS to BC value
 4657:          node->mX  = nodeBnd->elbc;
 4658:          node->qel = nodeBnd->elbc;
 4659: 
 4660:       } else {
 4661:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4662: 
 4663:          for (int j = 0; j < node->numNodes; j++) {
 4664:                Node* nbNode = node->nodes[j];
 4665:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4666:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4667:                   // Verify neighbor's BC value
 4668:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4669: 
 4670:                   // Subtract contribution to RHS
 4671:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4672:                   node->coeffMatrix[j] = 0.0;  
 4673:                }
 4674:          }
 4675:       }
 4676:    }
 4677: 
 4678: 
 4679:    __global__ void updateElevation(void) {
 4680:       NODE(node);
 4681: 
 4682:       node->eta2 = node->mX;
 4683: 
 4684:       node->updateZCoordData();
 4685:    }
 4686: 
