 2043: 
 2044: __device__ void lock(int *mutex) {
 2045:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2046: }
 2047: 
 2048: __device__ void unlock(int *mutex) {
 2049:     atomicExch(mutex, 0);
 2050: }
 2051: 
 2052: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2053: // return;   
 2054:    // Lock the mutex
 2055:    lock(&debugPlotMutex);
 2056:  
 2057:    bool ok = true;
 2058:    if (debugPlotIdx == nullptr) ok = false;
 2059:    if (*debugPlotIdx >= 1000000) ok = false;
 2060:    if (ok) {
 2061:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2062:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2063:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2064:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2065:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2066:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2067:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2068:       (*debugPlotIdx)++;
 2069:    }
 2070: 
 2071:    __threadfence();               // ensure all above writes are visible
 2072:    // Unlock the mutex
 2073:    unlock(&debugPlotMutex);
 2074: 
 2075: }
