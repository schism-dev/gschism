 1758: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1759:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1760: }
 1761: 
 1762: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1763:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1764: }   
 1765: 
 1766: __device__ __inline__ double min3(double a, double b, double c) {
 1767:    return min(a, min(b, c));
 1768: }
 1769: 
 1770: __device__ __inline__ double max3(double a, double b, double c) {
 1771:    return max(a, max(b, c));
 1772: }
 1773: 
 1774: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1775:    return min(a, min(b, min(c, d)));
 1776: }
 1777: 
