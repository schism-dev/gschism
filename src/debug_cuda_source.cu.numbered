 5020:       const int idx = node->idx;
 5021:       Vector2 wind = {xWind[idx], yWind[idx]};
 5022: 
 5023:       if constexpr(nws != 0 && iwindoff != 0) {
 5024:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5025:       }
 5026: 
 5027:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5028:       node->setWind(wind);
 5029: 
 5030:       node->pr = pressAir[idx];
 5031:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5032: 
 5033:    }
