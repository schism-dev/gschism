 4729: 
 4730: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4731:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4732:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4733:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4734: }
 4735: 
 4736: 
 4737: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4738:    // Brunt-Väisälä frequency at level k.
 4739:    if (k <= node->kb || k >= ivrt) return 0.0;
 4740:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4741: }
 4742: 
 4743: 
 4744: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4745: 
 4746:    
 4747:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4748:    // k is the layer bottom index.
 4749: 
 4750: 
 4751: 
 4752:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4753: 
 4754:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4755:       const double eta2 = node->eta2;
 4756:       const double depth = node->depth;
 4757: 
 4758:       // Distances from the layer midpoint to the surface and bottom
 4759:       const double dist_s = eta2 - z_c;
 4760:       const double dist_b = z_c + depth;
 4761: 
 4762:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4763: 
 4764:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4765: 
 4766: 
 4767:    } else {
 4768:       return 1.0; // Other GLS submodels
 4769: 
 4770:    }
 4771: }
 4772: 
 4773: 
 4774: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4775:    // Minimum mixing length for levels below the surface.
 4776:    // Independent of psimin(); do not invert one to get the other.
 4777:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4778: }
 4779: 
 4780: 
 4781: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4782: 
 4783:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4784: 
 4785:    if constexpr(iveg == 1) {
 4786:       
 4787:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4788:       const double zTopCanopy = node->zTopCanopy();
 4789: 
 4790:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4791: 
 4792:          const double ztop = node->z[k];   // Top of the current layer.
 4793: 
 4794:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4795:          // Where 1 means that the current level is fully within the vegetation layer.
 4796:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4797: 
 4798:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4799:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4800: 
 4801:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4802:          // and at the bottom of the layer.
 4803:          const double vmag_top = length(ub2_top);
 4804:          const double vmag_bot = length(node->u2[k-1]);
 4805: 
 4806:          // Volume-averaged velocity cubed.
 4807:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4808: 
 4809:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4810:          // and at the bottom of the layer.
 4811:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4812:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4813: 
 4814:          // Volume-averaged vegetation alpha cubed.
 4815:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4816: 
 4817:          return veg_alpha3D*vmag3;
 4818:       } 
 4819:       else {
 4820:          // The current level is not within the vegetation layer, so the production is 0.
 4821:          return 0.0;
 4822:       }
 4823:    } else {
 4824: 
 4825:       // If no vegetation, the production is 0.
 4826:       return 0.0;
 4827:    }
 4828: 
 4829: }
 4830: 
 4831: 
 4832: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4833:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4834:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4835: 
 4836:    const int kb = node->kb;
 4837: 
 4838:    for (int k = kb; k < nvrt; k++) {
 4839:       const double tke = this->tke[k];
 4840:       const double mxl = this->mxl[k];
 4841:       const double u = sqrt(tke);  // Characteristic velocity
 4842:       const double lu = mxl*u;     // Characteristic diffusivity 
 4843: 
 4844:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4845:       double drho_dz = 0.0;
 4846:       if (k > kb && k < ivrt) {
 4847:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4848:       }
 4849: 
 4850:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4851: 
 4852:       // Tsinghua group       
 4853:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4854: 
 4855:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4856:       if constexpr (stabilityModel == Galperin) {
 4857:          sh = 0.49393/(1.0-34.676*Gh);
 4858:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4859:          cmiu  = sqrt(2.0)*sm;
 4860:          cmiup = sqrt(2.0)*sh;
 4861:          cmiu1 = sqrt(2.0)*0.2;
 4862:          cmiu2 = sqrt(2.0)*0.2;
 4863: 
 4864:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4865:          // Warner's paper has problem
 4866:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4867:          const double Ghp = Gh;  /// XXXXX needed?
 4868:          sh = 0.4939/(1.0 - 30.19*Ghp);
 4869:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 4870:          cmiu  = sqrt(2.0)*sm;
 4871:          cmiup = sqrt(2.0)*sh;
 4872:          cmiu1 = cmiu/schk();
 4873:          cmiu2 = cmiu/schpsi();
 4874: 
 4875:       } else {
 4876:          assert(false && "Unknown ASM");
 4877: 
 4878:       }
 4879: 
 4880:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 4881:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 4882:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 4883:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 4884:    }
 4885: }
 4886: 
 4887: 
 4888: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 4889: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 4890: 
 4891:    const double z = node->z[k];
 4892:    const double eta2 = node->eta2;
 4893:    const double depth = node->depth;
 4894: 
 4895:    // Distances to the surface and bottom
 4896:    const double dist_s = eta2 - z;
 4897:    const double dist_b = z + depth;
 4898: 
 4899:    // Distance to the closest "wall" (either surface or bottom).  
 4900:    // In the top layer, it is the size of the layer.
 4901:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 4902:    assert(min_dist > 0.0 && "Invalid minimum distance");
 4903: 
 4904:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 4905:    return kappa*min_dist;
 4906: }
 4907: 
 4908: 
 4909: 
 4910: template<TurbulenceModel turbulenceModel>
 4911: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 4912: 
 4913: 
 4914: template<>
 4915: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 4916:    // Constant turbulence model
 4917:    // Does nothing since dfv and dfh are already set  in the initialization.
 4918: }
 4919: 
 4920: template<>
 4921: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 4922:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 4923: 
 4924:    // Solves the following PDEs:
 4925:    //
 4926:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 4927:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 4928:    //
 4929:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 4930:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 4931:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 4932:    //
 4933:    // The equations are solved using a linear *vertical* FEM formulation.
 4934:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 4935:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 4936:    
 4937:    
 4938:    // Get the turbulence model
 4939:    // reinterpret_cast is used to avoid stupid compiler errors.
 4940:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 4941:      
 4942:    const int kb = node->kb;
 4943:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 4944: 
 4945:    double alow_tke[nvrt], alow_phi[nvrt];
 4946:    double bdia_tke[nvrt], bdia_phi[nvrt];
 4947:    double cupp_tke[nvrt], cupp_phi[nvrt];
 4948:    double rhs_tke [nvrt], rhs_phi [nvrt];
 4949:    
 4950:    // Initialize the tridiagonal system
 4951:    for (int kin = 0; kin < nqrows; kin++) {
 4952:       alow_tke[kin]=0.0;
 4953:       bdia_tke[kin]=0.0;
 4954:       cupp_tke[kin]=0.0;
 4955:       rhs_tke [kin]=0.0; 
 4956:       alow_phi[kin]=0.0;
 4957:       bdia_phi[kin]=0.0;
 4958:       cupp_phi[kin]=0.0;
 4959:       rhs_phi [kin]=0.0; 
 4960:    }
 4961: 
 4962: 
 4963: 
 4964:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 4965:    if (node->isDry || node->is2D()) {
 4966: 
 4967:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 4968:       const double diffmin = turb.diffmin;
 4969: 
 4970:       for (int k = 0; k < nvrt; k++) {
 4971:          turb.tke[k]    = turb.tkemin();
 4972:          turb.mxl[k]    = turb.mxlmin(node->depth);
 4973:          node->dfv[k]   = diffmin;
 4974:          node->dfh[k]   = diffmin;
 4975:          turb.nu_tke[k] = diffmin;
 4976:          turb.nu_phi[k] = diffmin;
 4977:       }
 4978: 
 4979:       return;
 4980:    }
 4981: 
 4982:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 4983:    
 4984:    // After here we know that the node is wet and has at least 2 layers.
 4985: 
 4986:    double solution[nvrt], gam[nvrt];
 4987:    
 4988:    const double eta2       = node->eta2;
 4989:    const double depth      = node->depth;
 4990:    const double Cd         = node->Cd; // Drag coefficient
 4991: 
 4992:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 4993:    
 4994:    const double sqU2 = norm2(node->u2[kb + 1]);
 4995:    const double modTau = length(node->tau);
 4996: 
 4997:  
 4998: 
 4999:    const double cpsi1 = turb.cpsi1();
 5000:    const double cpsi2 = turb.cpsi2();
 5001:    // cpsi3 is computed later because it depends on k
 5002: 
 5003: 
 5004:    // Assemble the tridiagonal system
 5005:    // -------------------------------
 5006: 
 5007:    // Loop over each vertical layer (interval between two vertical levels)
 5008:    // Each interval is an element of the vertical FEM formulation.
 5009:    // Two shape functions are defined over each interval. In this function we well call them
 5010:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5011:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5012:    //
 5013:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5014:    // Both systems of equations are assembled in the same loop.
 5015:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5016: 
 5017:       // Indices for the *rows* of the tridiagonal system.
 5018:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5019:       const int k2 = k - kb;     // One at k = kb + 1
 5020: 
 5021:       // Get the properties of the current interval.
 5022:       const double z  = node->z[k]; // bottom level of the interval
 5023:       const double dz = node->Dz(k + 1);
 5024:       
 5025:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5026: 
 5027:       // Turbulence production/dissipation terms (at the center of the interval).
 5028:       
 5029:       const double M2 = norm2(du_dz_c);              // Shear production term
 5030: 
 5031:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5032: 
 5033:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5034: 
 5035:       const double cpsi3 = turb.cpsi3(N2); 
 5036: 
 5037: 
 5038:       // Turbulence quantities at half levels (cell [c]enter)
 5039:       const double tke_1     = turb.tke[k];
 5040:       const double tke_2     = turb.tke[k+1];
 5041:       const double mxl_1     = turb.mxl[k];
 5042:       const double mxl_2     = turb.mxl[k+1];
 5043:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5044:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5045:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5046:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5047:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5048:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5049:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5050: 
 5051:       // Integral of the shape function products:
 5052:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5053:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5054:       const double p1p1 = dz/3.0;
 5055:       const double p1p2 = dz/6.0;
 5056:       const double d1d1 =  1.0/dz;
 5057:       const double d1d2 = -1.0/dz;
 5058: 
 5059:       // Production/dissipation related terms
 5060:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5061:       const double buoy = dfh_c*N2;
 5062:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5063: 
 5064: if (fabs(prod)>0.001) printf("prod: %f, buoy: %f, diss: %f\n", prod, buoy, diss);
 5065: 
 5066:       // Equation for tke
 5067:       // ---------------
 5068: 
 5069:       // First row (of the two rows that the interval contributes to)
 5070:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5071:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5072:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5073: 
 5074: 
 5075:       if(prod + buoy >= 0.0) { // Net production
 5076:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5077:       } else { // Net dissipation
 5078:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5079:          bdia_tke[k1] -= 2.0*tmp;
 5080:          cupp_tke[k1] -= tmp;
 5081:       }      
 5082:       
 5083:       bdia_tke[k1] += 2.0*dt*diss;
 5084:       cupp_tke[k1] += dt*diss;
 5085:       
 5086:   
 5087:       // Second row (of the two rows that the interval contributes to)
 5088:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5089:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5090:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5091: 
 5092:       if (prod + buoy >= 0.0) { // Net production
 5093:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5094:       } else { // Net dissipation
 5095:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5096:          bdia_tke[k2] -= 2.0*tmp;
 5097:          alow_tke[k2] -= tmp;
 5098:       }
 5099:       
 5100:       bdia_tke[k2] += 2.0*dt*diss;
 5101:       alow_tke[k2] += dt*diss;
 5102: 
 5103: 
 5104:       // Equation for xl
 5105:       // ---------------
 5106: 
 5107:       const double rpub = turb.rpub();
 5108:       const double rmub = turb.rmub();
 5109:       const double rnub = turb.rnub();
 5110:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5111:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5112:       const double psi_c = 0.5*(psi_1 + psi_2);
 5113: 
 5114:       // Production/dissipation related terms
 5115:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5116:       const double buoy_phi = cpsi3*dfh_c*N2;
 5117:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5118: 
 5119:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5120:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5121:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5122: 
 5123:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5124:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5125:       } else { // Net dissipation
 5126:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5127:          bdia_phi[k1] -= 2.0*tmp;
 5128:          cupp_phi[k1] -= tmp;
 5129:       }
 5130: 
 5131:       // Production/dissipation terms
 5132:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5133:       cupp_phi[k1] += dt*diss_phi;
 5134:  
 5135: 
 5136:       // row k2 (upper)
 5137:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5138:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5139:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5140: 
 5141:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5142:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5143:       } else { // Net dissipation
 5144:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5145:          bdia_phi[k2] -= 2.0*tmp;
 5146:          alow_phi[k2] -= tmp;
 5147:       }
 5148: 
 5149:       // Production/dissipation terms
 5150:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5151:       alow_phi[k2] += dt*diss_phi;
 5152: 
 5153:    }
 5154: 
 5155:    // BC
 5156:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5157:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5158: 
 5159: 
 5160:    // Solves for tke.
 5161:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5162: 
 5163: 
 5164:    // B.C. (computed using values from previous time except wind)
 5165:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5166:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5167: 
 5168: 
 5169:    // Update TKE.
 5170:    turb.tke[kb]     = tkebot;
 5171:    turb.tke[kb + 1] = tkebot;
 5172:    turb.tke[ivrt]   = tkesrf;
 5173:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5174:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5175:    }
 5176: 
 5177: 
 5178: 
 5179:  
 5180:    // Solves for phi.
 5181:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5182: 
 5183: 
 5184:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5185:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5186:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5187: 
 5188:    turb.mxl[kb+1] = mxlbot;
 5189:    turb.mxl[ivrt] = mxlsrf;
 5190:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5191:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5192: 
 5193:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5194: 
 5195:       // Galperin's clipping
 5196:       if (N2 < 0.0) {
 5197:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5198:          turb.mxl[k] = min(turb.mxl[k], upper);
 5199:       }   
 5200: 
 5201: 
 5202: 
 5203:       // Max. mixing length based on dissipation; mxlmin prevails
 5204:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5205: 
 5206:       // Combined max. mixing length including geometric limit
 5207:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5208: 
 5209:       // Clamp the mixing length between the minimum and maximum values
 5210:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5211: 
 5212:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5213: 
 5214: 
 5215:    } // for k
 5216: 
 5217: 
 5218:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5219:    turb.tke[kb] = turb.tke[kb + 1];
 5220:    turb.mxl[kb] = turb.mxl[kb + 1];
 5221: 
 5222: 
 5223:    // Compute vertical diffusivities at new time
 5224:    turb.computeDiffusivities(node);
 5225: 
 5226:    // make all the variables uniform below the bottom level kb
 5227:    for (int k = 0; k < kb; k++) {
 5228:       node->dfv[k] = node->dfv[kb];
 5229:       node->dfh[k] = node->dfh[kb];
 5230:       turb.tke[k] = turb.tke[kb];
 5231:       turb.mxl[k] = turb.mxl[kb];
 5232:       turb.nu_tke[k] = turb.nu_tke[kb];
 5233:       turb.nu_phi[k] = turb.nu_phi[kb];
 5234:    }
 5235: 
 5236:       
 5237: 
 5238: }
 5239: 
 5240: 
 5241: 
 5242: 
 5243: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5244:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5245:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5246: 
 5247: 
 5248:    NODE(node1);
 5249: 
 5250:    node1->clearMatrixRow();
 5251:    node1->qel = 0.0;
 5252: 
 5253:    // THIS IS FOR STRUCTURES XXX
 5254:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5255: 
 5256:    
 5257:    for (int j=0; j<node1->numElements; j++) {
 5258:       // For each element connected to the node...
 5259: 
 5260:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5261: 
 5262:       Element *elem = node1->elements[j];
 5263: 
 5264:       // Compute the average gravity
 5265:       const double grav3 = elem->mean(&Node::grav2);
 5266: 
 5267:       // Look at the documentation for the description of the terms in the following integrals
 5268: 
 5269:       // Integral I_1 
 5270:       // \bar{\breve{H}} 
 5271:       const double hhatb = elem->mean(&Side::hhat);        
 5272: 
 5273:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5274: 
 5275:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5276:       const double area = elem->area;
 5277: 
 5278:       // Integral I_4
 5279:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5280:       // Where
 5281:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5282: 
 5283:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5284:       // of U over the element.
 5285:       const Vector2 U = elem->mean(&Side::U);
 5286: 
 5287:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5288: 
 5289:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5290:       const double I_4_1 = dot(gradPhi_1, U);
 5291: 
 5292: 
 5293:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5294:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5295: 
 5296:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5297: 
 5298: 
 5299:       // Normal component of the bed velocity
 5300:       double ubedNormalComp = 0.0;
 5301:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5302:          Vector3 ubed = {0.0, 0.0, 0.0};
 5303:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5304:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5305: 
 5306:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5307:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5308:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5309: 
 5310:          // Computes the normal component of the bed velocity
 5311:          ubedNormalComp = dot(ubed, N);
 5312:       } // imm==2
 5313: 
 5314:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5315: 
 5316:       if (elem->isTri()) {
 5317: 
 5318:          // To clarify the notation in this section: 
 5319:          //   In formulas, we use the following notation:
 5320:          //       i stands for the node under consideration (node1)
 5321:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5322:          //   However, in the code, we use the following notation:
 5323:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5324:          const int id2 = elem->nxq(1 + id1);
 5325:          const int id3 = elem->nxq(2 + id1);
 5326:          Node *node2 = elem->nodes[id2];
 5327:          Node *node3 = elem->nodes[id3];
 5328: 
 5329:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5330: 
 5331:          // integral of phi_i*phi_j
 5332:          const double ipp_ii = (1.0/6.0 )*area;
 5333:          const double ipp_ij = (1.0/12.0)*area;
 5334:          const double ipp_ik = (1.0/12.0)*area;
 5335: 
 5336:          // integral of [(grad phi_i) * (grad phi_j)]
 5337:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5338:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5339:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5340: 
 5341:          // Computes the different components of integral I_1 of each node with respect to node i.
 5342:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5343:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5344:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5345: 
 5346:          node1->addToSparseMatrix(node1, I1_ii);
 5347:          node1->addToSparseMatrix(node2, I1_ij); 
 5348:          node1->addToSparseMatrix(node3, I1_ik);
 5349: 
 5350:          #pragma unroll
 5351:          for (int l=0; l<3; l++) {
 5352: 
 5353:             Node *node = elem->nodes[l];
 5354: 
 5355:             // Additional variation in eta due to bed deformation or vertical velocity
 5356:             double extraEta = 0.0;
 5357:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5358:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5359: 
 5360: 
 5361:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5362:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5363: 
 5364:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5365: 
 5366:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5367:            
 5368:          }
 5369: 
 5370: 
 5371:       }
 5372:       else { // Quad
 5373:          // To clarify the notation in this section: 
 5374:          //   In formulas, we use the following notation:
 5375:          //       i stands for the node under consideration (node1)
 5376:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5377:          //   However, in the code, we use the following notation:
 5378:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5379:          const int id2 = elem->nxq(1 + id1);
 5380:          const int id3 = elem->nxq(2 + id1);
 5381:          const int id4 = elem->nxq(3 + id1);
 5382:          Node *node2 = elem->nodes[id2];
 5383:          Node *node3 = elem->nodes[id3];
 5384:          Node *node4 = elem->nodes[id4];   
 5385:          
 5386:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5387: 
 5388:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5389:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5390:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5391:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5392:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5393: 
 5394:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5395:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5396:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5397:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5398:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5399: 
 5400: 
 5401:          // Computes the different components of integral I_1 of each node with respect to node i.
 5402:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5403:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5404:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5405:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5406: 
 5407:          node1->addToSparseMatrix(node1, I1_ii);
 5408:          node1->addToSparseMatrix(node2, I1_ij); 
 5409:          node1->addToSparseMatrix(node3, I1_ik);
 5410:          node1->addToSparseMatrix(node4, I1_il);
 5411:   
 5412:          #pragma unroll
 5413:          for (int l=0; l<4; l++) {
 5414: 
 5415:             const Node *node = elem->nodes[l];
 5416: 
 5417:             // Additional variation in eta due to bed deformation or vertical velocity
 5418:             double extraEta = 0.0;
 5419:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5420:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5421: 
 5422:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5423:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5424:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5425: 
 5426:          }         
 5427:       } 
 5428: 
 5429: 
 5430:      node1->qel += (dt/elem->i34)*elem->vsource;
 5431:       
 5432: 
 5433:    } // for all elements connected to the node
 5434:    
 5435: 
 5436:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5437:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5438:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5439:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5440:    // If it is an open boundary node...
 5441: 
 5442:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5443: 
 5444:       // At least one open bnd side, maybe two
 5445:       for (int l=0; l<2; l++) { 
 5446: 
 5447:          // Gets each of the sides sharing the node. 
 5448:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5449: 
 5450:     
 5451: 
 5452:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5453:          if (sideBnd != nullptr) {
 5454:             // If the side is on a boundary...
 5455: 
 5456:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5457: 
 5458:             // Get the boundary segment
 5459:             const BoundarySegment *sideSegment = sideBnd->segment;
 5460:             const Side *side = sideBnd->side;
 5461: 
 5462:             // Integral I_3
 5463:             if (sideSegment->ifltype != 0) {
 5464:             // Natural or Flather b.c.
 5465: 
 5466:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5467:                // especially for Flather b.c.
 5468:                double ri3 = 0.0;
 5469:                if (!side->isDry) {
 5470:                   // If the side is not dry
 5471:                   
 5472:                   // Computes the side flux of (uth, vth)
 5473:                   double Vn = 0.0;
 5474:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5475:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5476:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5477: 
 5478:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5479:                   }
 5480: 
 5481:                   ri3 = 0.5*side->len*Vn;
 5482:                }
 5483: 
 5484:                if (sideSegment->ifltype == -1) { // Flather 1
 5485: 
 5486:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5487:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5488: 
 5489:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5490:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5491:                   
 5492:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5493:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5494: 
 5495:                } 
 5496:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5497:                   // Reset ri3
 5498:                   ri3 = 0.0;
 5499: 
 5500:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5501:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5502: 
 5503:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5504: 
 5505:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5506:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5507: 
 5508:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5509:                   node1->addToSparseMatrix(node1, con0*2.0);
 5510:                   node1->addToSparseMatrix(node2, con0);
 5511: 
 5512:                } // if Flather or Discharge
 5513: 
 5514:                node1->qel -= thetai*dt*ri3;  
 5515: 
 5516: 
 5517:             } // I_3
 5518:           
 5519: 
 5520:             // Integral I_5
 5521:             if(!side->isDry) {
 5522: 
 5523:                const double Unbar = dot(side->U, side->n);
 5524:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5525: 
 5526:             } // I_5
 5527: 
 5528:          } // if is boundary side
 5529: 
 5530:       } // for l
 5531: 
 5532:    } // if isbnd
 5533: 
 5534: 
 5535: }
 5536: 
 5537: 
 5538: 
 5539: extern "C" {
 5540: 
 5541:    __global__ void gatherBFromMesh(double* b) {
 5542:       // b[local] <- qel  (local = idx_node on this device)
 5543:       NODE(node);
 5544:       b[idx_node] = node->qel;
 5545:    }
 5546: 
 5547:    
 5548:    __global__ void scatterXToMesh(double* x) {
 5549:       // mX <- x[local]
 5550:       NODE(node);
 5551:       node->mX = x[idx_node];
 5552:    }
 5553: 
 5554:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5555:                                  int* indices, int* indptr) {
 5556:       // XXXXXXXXXXXX REMOVE!!!
 5557:       assert(false && "setupCGSolver has beed deprecated");
 5558: 
 5559:       // NODE(node);
 5560:       
 5561:       // const int idx = node->idx;
 5562:       
 5563:       // // Computes the index in the nzz array      
 5564:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5565: 
 5566: 
 5567:       // indptr[idx] = nzzIdx;
 5568:       // indices[nzzIdx] = idx;
 5569: 
 5570:       // data_d[nzzIdx]    = node->coeffDiag;
 5571: 
 5572:       // b_d[idx] = node->qel;
 5573: 
 5574:       // for (int k = 0; k < node->numNodes; ++k) {
 5575:       //    const Node* nb = node->nodes[k];
 5576: 
 5577:       //    const int j = nb->idx;
 5578: 
