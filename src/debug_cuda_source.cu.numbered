 4112:    __global__ void computeFlowBcVelocities(double time) {
 4113: 
 4114:       SIDE_BND(sideBnd);
 4115: 
 4116:       const Side *side = sideBnd->side;
 4117:  
 4118:       const bool isDry = side->isDry;
 4119: 
 4120:    
 4121: 
 4122:       if (isDry) {
 4123:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4124:          return;
 4125:       }
 4126: 
 4127:       // For wet sides in open boundaries...
 4128:       const Vector2 n = side->n;
 4129:       const BoundarySegment *segment = sideBnd->segment;
 4130: 
 4131:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4132: 
 4133:       const int ifltype = segment->ifltype;
 4134: 
 4135:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4136:       const Vector2 r_nuth0 = r_uth0*n;
 4137: 
 4138:       for (int k = 0; k < nvrt; k++) {
 4139:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4140:          Vector2 r_u1_bar = {0.0, 0.0};
 4141:       
 4142:          if (ifltype == 1 || ifltype == 2) {
 4143:          
 4144:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4145: 
 4146:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4147:             
 4148:             r_uth = unth0*n;  // This case has no ramp-up
 4149:             
 4150:          } else if (ifltype == -1) { // Flather 1
 4151: 
 4152:             // uth is the normal vel.; no ramp up
 4153:             const double uth = sideBnd->nuth(k);
 4154:             r_uth = uth*n;
 4155:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4156: 
 4157: 
 4158:          } else if (ifltype == 3 || ifltype == 5) {
 4159:             // vnth0=0 !normal vel.
 4160: 
 4161:             // Computes the contribution to the velocity from all tide frequencies
 4162:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4163: 
 4164:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4165:                const Vector2 umo  = sideBnd->umo(jfr); 
 4166: 
 4167:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4168:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4169:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4170:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4171:             }
 4172: 
 4173:          } // if (ifltype = 3 || ifltype == 5
 4174: 
 4175: 
 4176:          switch (ifltype) {
 4177:             case 1:
 4178:             case 2:
 4179:             case 4:
 4180:                sideBnd->ubc[k] = r_uth;
 4181:                break;
 4182:             case 3:
 4183:                sideBnd->ubc[k] = r_u1_bar;
 4184:                break;
 4185:             case 5:
 4186:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4187:                break;
 4188:          } // switch
 4189: 
 4190:       } // for k
 4191:    }
 4192: 
 4193:    __global__ void computeElevationBoundaryConditions(double time) {
 4194:       // Compute elevation essential boundary conditions 
 4195: 
 4196:       NODE_BND(nodeBnd); // Each boundary node.
 4197: 
 4198:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4199: 
 4200:       const Node *node = nodeBnd->node;
 4201:       const BoundarySegment *segment = nodeBnd->segment;
 4202:       const int iettype = segment->iettype;
 4203:       
 4204: 
 4205:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4206:       double eic = 0.0;
 4207:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4208:       else                 eic = 0.0;
 4209: 
 4210:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4211:       const double r_eth = ramp*nodeBnd->eth;
 4212:       double r_eta1_bar = 0.0;
 4213: 
 4214: 
 4215:       // Compute tide elevation
 4216:       if (iettype == 3 || iettype == 5) {   
 4217: 
 4218:          if constexpr(iloadtide==1) { // loading tide
 4219:             assert(false && "Loading tide not implemented");
 4220:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4221:          }
 4222:          
 4223:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4224: 
 4225:             const double efa  = nodeBnd->efa[jfr]; 
 4226:             const double emo  = nodeBnd->emo[jfr]; 
 4227: 
 4228:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4229:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4230:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4231: 
 4232:          } // for jfr
 4233: 
 4234:       } // if iettype
 4235: 
 4236:       switch (iettype) {
 4237:          case 1:
 4238:          case 2:
 4239:          case 4:
 4240:             nodeBnd->elbc = r_eic + r_eth;
 4241:             break;
 4242:          case 3:
 4243:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4244:             break;
 4245:          case 5:
 4246:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4247:             break;
 4248:       } // switch
 4249: 
 4250: 
 4251:       //Add inverse barometric effects
 4252:       if (iettype != 0 && inv_atm_bnd == 1) {
 4253:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4254:       }
 4255: 
 4256:    }
 4257: 
 4258: 
 4259:    __global__ void computeHorizontalViscosity(void) { 
 4260: 
 4261:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4262: 
 4263:       SIDE(side);
 4264: 
 4265:       if (side->isDry) return;
 4266: 
 4267:       for (int k = 0; k < nvrt; k++) {
 4268:          side->nuGradU[k] = {0.0, 0.0};
 4269:       }
 4270: 
 4271:       if constexpr(ihorcon == 1) {
 4272:          for (int k = side->kb; k < nvrt - 1; k++) {
 4273:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4274:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4275:             // By Zhang and Baptista.
 4276: 
 4277:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4278:             // This is a standard discretization of the Laplacian operator.
 4279:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4280:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4281:             // Gamma is hvis_coef0 in the code.
 4282:             // The value of gamma needs to be < 0.5.
 4283: 
 4284:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4285:             // side under consideration in each of the two possible elements that share the side.
 4286:             Vector2 sumU = {0.0, 0.0};
 4287:             for (int l = 0; l < 2; l++) {
 4288:                const Element *elem = side->elems[l];
 4289: 
 4290:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4291: 
 4292:                // Find the local index of the side in the element
 4293:                const int idxSide = elem->sideLocalIdx(side);
 4294:                // Find the two sides that are connected to the side under consideration
 4295:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4296:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4297: 
 4298:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4299: 
 4300:             }
 4301: 
 4302:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4303:    
 4304:          }
 4305:       }
 4306:       else if constexpr(ihorcon == 2) {
 4307:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4308:       }
 4309: 
 4310: 
 4311:    }
 4312: 
 4313: 
 4314:    __global__ void setEssentialBC(void) {
 4315:       // Set essential boundary conditions 
 4316:       NODE(node); // Each boundary node
 4317:       NodeBoundary *nodeBnd = node->nodeBnd;
 4318:       
 4319: // nodeBnd->isEssentialBC = true;      
 4320:       // Check if this node has essential BC
 4321:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4322:          // Verify BC value is valid
 4323:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4324: 
 4325:        
 4326:          // Set diagonal to 1 and zero off-diagonals
 4327:          node->coeffDiag = 1.0;
 4328: 
 4329:          for (int j = 0; j < node->numNodes; j++) {
 4330:                node->coeffMatrix[j] = 0.0;
 4331:          }
 4332:          
 4333:          // Set solution and RHS to BC value
 4334:          node->mX  = nodeBnd->elbc;
 4335:          node->qel = nodeBnd->elbc;
 4336: 
 4337:       } else {
 4338:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4339: 
 4340:          for (int j = 0; j < node->numNodes; j++) {
 4341:                Node* nbNode = node->nodes[j];
 4342:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4343:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4344:                   // Verify neighbor's BC value
 4345:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4346: 
 4347:                   // Subtract contribution to RHS
 4348:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4349:                   node->coeffMatrix[j] = 0.0;  
 4350:                }
 4351:          }
 4352:       }
 4353:    }
 4354: 
 4355: 
 4356:    __global__ void updateElevation(void) {
 4357:       NODE(node);
 4358: 
 4359:       node->eta2 = node->mX;
 4360: 
 4361:       node->updateZCoordData();
 4362:    }
 4363: 
 4364: 
 4365:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4366: 
 4367:       SIDE(side);
 4368: 
 4369: 
 4370:       side->U = {0.0, 0.0}; 
 4371:          
 4372:       if(side->isDry) return;
 4373: 
 4374:       const Node *node1 = side->n1;
 4375:       const Node *node2 = side->n2;
 4376: 
 4377:       // Vertically integrated velocity U (in ll if ics=2)
 4378:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4379:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4380:       }
 4381: 
 4382:    }
 4383: 
 4384:    __global__ void computeBottomDragVegetation(void) {
 4385:       // UNFINISHED. CHECK THIS:
 4386:       // How many kernels are needed? Why so many for loops?
 4387:       // Is the loop on sides needed?
 4388: 
 4389:       NODE(node);
 4390: 
 4391:             
 4392:       const int    kb      = node->kb;
 4393:       const double htot    = node->htot2(); 
 4394:       const double rough   = node->rough;
 4395: 
 4396: 
 4397:       if (node->isDry) {
 4398:          // Default values for dry nodes
 4399:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4400:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4401: 
 4402:          return;
 4403:        
 4404:       }
 4405: 
 4406: 
 4407:       // Compute bottom drag Cd
 4408:       //--------------------------------
 4409: 
 4410:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4411:       if constexpr(nchi == 1) {
 4412: 
 4413:          bool ltmp = false; // for WBL iteration
 4414: 
 4415:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4416:          // Drag at nodes
 4417:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4418:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4419:         
 4420:          const double rough = node->rough;
 4421:         
 4422:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4423:          if (node->rough == 0.0) {
 4424:             node->Cd = 0.0;
 4425: 
 4426:          } else { //roughness >0 
 4427:           
 4428:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4429:             const double bthick = max(dzb_min, bthick_ori);
 4430: 
 4431:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4432: 
 4433:             double tmp = 1.0/(2.5*log(bthick/rough));
 4434:             node->Cd = tmp*tmp;
 4435: 
 4436:          } // if rough
 4437: 
 4438: 
 4439:          // RECOVER THIS: XXX
 4440:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4441:          // Output warning for WBL if iteration didn't converge
 4442: 
 4443: 
 4444:       } // nchi==1
 4445: 
 4446: 
 4447: 
 4448:       //   Bottom stress in m^2/s^2
 4449:       if (node->rho[kb + 1] >= -98.0)
 4450:       {
 4451:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4452:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4453: 
 4454:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4455:          // !sediment erosion: this part needs more documentation
 4456:       }
 4457: 
 4458:   
 4459:       // Compute vegetation parameters
 4460:       //--------------------------------
 4461: 
 4462:       // SAV constants
 4463:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4464:       constexpr double veg_cfpsi = 0.16;
 4465: 
 4466:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4467:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4468: 
 4469:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4470:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4471:          int kbin = 0; // bin index
 4472:          for (int k = kb; k < nvrt; k++) {
 4473:             // Computes node height above the bottom level
 4474:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4475:             assert(false && "Vertical variation of vegetation not implemented");
 4476: 
 4477:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4478:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4479:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4480:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4481:             // } else {
 4482:             //    // Find the bin at which the current vertical level is
 4483:             //    while (kbin<nbins_veg_vert) {
 4484:             //       const double zn = node->z[kbin];
 4485:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4486:             //          break;
 4487:             //       } // if
 4488:             //       kbin++;
 4489:             //    } // while
 4490:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4491: 
 4492:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4493:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4494:                
 4495:             //    // Linear interpolation of the vegetation parameters
 4496:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4497:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4498:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4499:             // } // if rl10
 4500: 
 4501:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4502: 
 4503:          } // for k
 4504: 
 4505: 
 4506:       } else { // Ganthy (iveg==2)
 4507:       //  Modify canopy height, diameter, and density
 4508: 
 4509:          // Make sure there is vegetation on this node
 4510:          if (node->veg_h_unbent > 0.0) {
 4511:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4512: 
 4513:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4514:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4515:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4516: 
 4517:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4518:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4519:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4520:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4521:          } // if veg_h_unbent
 4522: 
 4523:          for (int k = 0; k < nvrt; k++) {
 4524:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4525:          } // for k
 4526:       
 4527: 
 4528:       } // if iveg
 4529:      
 4530:          
 4531:       // Compute vertical mean of veg_alpha3D
 4532:       if (iveg != 0) {
 4533:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4534:          double sum1=0.0;
 4535:          double sum2=0.0;
 4536:          // Integrate over each level under the canopy...
 4537:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4538:             const double Dz = node->Dz(k);
 4539: 
 4540:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4541:             sum2 += Dz;
 4542: 
 4543:          } // for k
 4544:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4545:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4546: 
 4547:       } // if iveg
 4548: 
 4549:    }
 4550: 
 4551:    __global__ void computeVegetationAndDragParameters(void) {
 4552:       // Computes the vegetation and drag model parameters:
 4553:       // chi, \tilde\chi, beta, \breve{H}
 4554:       
 4555:       SIDE(side);
 4556: 
 4557:       if (side->isDry) return;
 4558: 
 4559:       const double htot = side->htot2();
 4560:       const int    kb   = side->kb;
 4561: 
 4562:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4563: 
 4564:       const double veg_h     = side->veg_h();
 4565:       const double veg_nv    = side->veg_nv();
 4566:       const double veg_c     = side->veg_c();
 4567:       const double veg_beta  = side->veg_beta;
 4568:       const double veg_alpha = side->veg_alpha_vert_mean();
 4569: 
 4570:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4571:       // Velocity magnitude at the bottom level
 4572:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4573:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4574:       side->chi2 = side->Cd()*vmag1;
 4575:       side->chi  = side->chi2;
 4576:       if constexpr(iveg != 0) {
 4577:          const Node *n1 = side->n1;
 4578:          const Node *n2 = side->n2;
 4579:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4580:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4581:       }
 4582: 
 4583:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4584: 
 4585:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4586:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4587:       double magUa = 0.0;
 4588:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4589:          // 3D wet side with veg...
 4590: 
 4591:          double magUa = 0.0;
 4592:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4593:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4594: 
 4595:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4596:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4597:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4598: 
 4599:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4600:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4601: 
 4602:                // Velocity magnitude at the bottom (l) of the level
 4603:                const double ul = length(side->u2[k]);
 4604: 
 4605:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4606:                magUa += Dz*0.5*(uh + ul);
 4607: 
 4608:             } // if HasVegetation
 4609:          } // for k
 4610:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4611: 
 4612:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4613:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4614:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4615:             const double zCpy = side->zTopCanopy();
 4616:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4617:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4618:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4619:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4620:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4621:          } // if isSubmerged
 4622:       } // if iveg   
 4623: 
 4624:       // Computes the friction modified depth, \breve{H} in notes
 4625:       if (side->is2D()) { // 2D
 4626: 
 4627:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4628:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4629: 
 4630:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4631: 
 4632:          side->hhat = htot*htot/fricH; 
 4633: 
 4634:       } else { // 3D
 4635:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4636: 
 4637:          if constexpr(iveg != 0) {
 4638:             
 4639:             if (side->isSubmerged()) { 
 4640:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4641:                side->hhat -= veg_c*Hhat_alpha;
 4642: 
 4643:             } else { // Emergent
 4644:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4645:             }
 4646:          } // if iveg
 4647: 
 4648:          // Enforce positivity for 3D model
 4649:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4650:       } // if 3D
 4651: 
 4652:    }
 4653: 
 4654: 
 4655: 
 4656:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4657:    // Computes the density gradient between two elements, e1 and e2.
 4658:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4659:    // zero in the direction normal to the side. 
 4660:    // 
 4661:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4662:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4663:    //
 4664:    // Input:
 4665:    //    e1: Element
 4666:    //    e2: Neighbor element (or nullptr if boundary)
 4667:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4668:    //    k: Index of the half-level at which the density is interpolated
 4669:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4670:    // 
 4671:    // Output:
 4672:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4673:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4674: 
 4675:       if (e2 == nullptr || e2->isDry) {
 4676:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4677: 
 4678:          Side *side = e1->sides[j];
 4679:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4680:                  
 4681:          if constexpr(ics == 1) {
 4682:             vec = side->n; // Normal vector to the side
 4683:          } else {
 4684:             // IMPLEMENT THIS XXXXXX
 4685:             // !replace with xel, yel?
 4686:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4687:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4688:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4689:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4690:          } //ics
 4691:                    
 4692:          diffRho = 0.0;
 4693: 
 4694:       } else { //internal and wet
 4695:          if constexpr(ics==1) {
 4696:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4697: 
 4698:             // Vector from e1 to e2
 4699:             vec = toVector2(e2->center - e1->center);
 4700: 
 4701:          } else { 
 4702:             // IMPLEMENT THIS XXXXXX
 4703:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4704:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4705:             //                   alow(j)=xctr2
 4706:             //                   bdia(j)=yctr2
 4707:          } // ics
 4708: 
 4709:          diffRho = rho2 - e1->demeanedDensity(k);
 4710:       }
 4711: 
 4712:    }
 4713: 
 4714:    __global__ void computeDensityCubicSplines(void) {
 4715:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4716: 
 4717:       ELEM(elem);
 4718: 
 4719:       if (elem->isDry) return;
 4720: 
 4721:       const int kb = elem->kb;
 4722: 
 4723:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4724:       if (elem->is2D()) {
 4725:          // In the 2D case, the density is constant at the prism level. 
 4726:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4727:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4728:       } else { //3D
 4729: 
 4730:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4731:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4732:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4733:          ///// XXXX CHECK INDICES!!!!!
 4734:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4735:       } // 2D/3D
 4736: 
 4737:    }
 4738: } // extern "C"
 4739: 
 4740: 
 4741: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4742: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4743: 
 4744:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4745: 
 4746:    const int kb  = elem->kb;
 4747:    const int kb2 = elem2->kb;
 4748: 
 4749:    // z-coordinate of prism of elem
 4750:    const double zp = elem->z_prism(k);
 4751: 
 4752:    double rho = 0.0;
 4753: 
 4754:    if (elem2->is2D()) {
 4755:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4756: 
 4757:    } else {  // 3D
 4758: 
 4759:       // eta_min may be < zmax
 4760:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4761:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4762: 
 4763:       // (Extrapolate density below bottom, we will fix it later)
 4764:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4765:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4766:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4767:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4768:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4769:    } // 2D/3D
 4770:      
 4771: 
 4772:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4773:    // Now we need to fix it.
 4774:    if (elem->z[k] < elem2->z[kb2]) {
 4775:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4776: 
 4777:       // There are two methods to adjust the density at the bottom of the element.
 4778:       // iunder_deep=0: 
 4779:       const double depth1 = abs(elem->z[kb]); // larger depth
 4780: 
 4781:       if (iunder_deep==0) {
 4782: 
 4783:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4784: 
 4785:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4786: 
 4787:       } else { // iunder_deep != 0
 4788: 
 4789:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4790: 
 4791:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4792: 
 4793:          //   Demeaned density at the same z coordinate as
 4794:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4795:          }
 4796: 
 4797:       } // if iunder_deep
 4798:    } // if elem->z[kb] < elem2->z[kb]
 4799: 
 4800:    return rho;
 4801: }
 4802: 
 4803: 
 4804: extern "C" {
 4805:    __global__ void computeDensityGradient(void) {
 4806: 
 4807:       if constexpr(ibc != 0) return;
 4808: 
 4809:          // Compute the horizontal density gradient at each element.
 4810:       // It works in two steps:
 4811:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4812:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4813:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4814:       //             gradRho.r1 = rho1 - rho0
 4815:       //             gradRho.r2 = rho2 - rho0
 4816:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4817:       // 
 4818:       //  NOTE: We use de-meaned densities.
 4819: 
 4820:       ELEM(elem);
 4821: 
 4822:       if (elem->isDry) return;
 4823: 
 4824:       const int kb  = elem->kb;
 4825:       const int i34 = elem->i34;
 4826: 
 4827:       for (int k = kb + 1; k < nvrt; k++) {
 4828:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4829:          //             gradRho.r1 = rho1 - rho0
 4830:          //             gradRho.r2 = rho2 - rho0
 4831:          int icount = 0;
 4832:          double sumRx = 0.0;
 4833:          double sumRy = 0.0;
 4834:          for (int j1=0; j1<i34; j1++) { 
 4835: 
 4836:             const int j2 = elem->nxq(j1 + 1);
 4837: 
 4838:             // Pairs of consecutive neighbor elements of elem
 4839:             const Element *e1 = elem->nghbElems[j1];
 4840:             const Element *e2 = elem->nghbElems[j2];
 4841: 
 4842:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4843:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4844:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4845: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 4846: 
 4847:             // Compute the density difference and the vector from elem to e1 and e2
 4848:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4849:             double diffRho1, diffRho2;
 4850:             Vector2 vec1, vec2;
 4851:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4852:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4853: 
 4854:             const double rl1 = length(vec1);
 4855:             const double rl2 = length(vec2);
 4856:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4857: 
 4858:             const double delta = cross(vec1, vec2);
 4859:             const double sintheta = abs(delta)/(rl1*rl2);
 4860: 
 4861:             // To avoid problems, avoid elements with small angle between vectors
 4862:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4863:             const bool validEq = (sintheta > sin_one_deg);
 4864: 
 4865:             if (validEq) {
 4866:                // Solve the system of equations to get the density gradient at elem
 4867:                icount++;
 4868:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4869:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4870:                sumRx += Rx;
 4871:                sumRy += Ry;
 4872:             }
 4873:          } // for j1
 4874: 
 4875:          // Compute the average density gradient at elem
 4876:          if (icount==0) {
 4877:            // Bad mesh quality; bail out with 0 b-cc
 4878:            elem->gradRho[k] = {0.0, 0.0};
 4879:          } else {
 4880:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4881:          }
 4882: 
 4883:       } // for k
 4884: 
 4885:    }
 4886: 
 4887:    __global__ void computeBaroclinicTerm(void) {
 4888:    // Computes the baroclinic term at sides (at half levels).
 4889:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4890:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4891: 
 4892:       if (ibc == 1) return;
 4893: 
 4894:       SIDE(side);
 4895: 
 4896:       if (side->isDry) return;
 4897: 
 4898:       const Element *e1 = side->elems[0];
 4899:       const Element *e2 = side->elems[1];      
 4900:       const int kb = side->kb;
 4901:       
 4902:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 4903: 
 4904:       // interpolates vertically the density gradient of the two elements at the half level/
 4905: 
 4906:       int k1 = max(kb, nvrt / 2);
 4907:       int k2 = max(kb, nvrt / 2);
 4908: 
 4909:       // Starts the integration at the surface and goes down to the bottom
 4910:       side->bcc[nvrt-1] = {0.0, 0.0};
 4911:       for (int k = nvrt - 2; k >= kb; k--) {
 4912:       // For each prism level (from surface to bottom)...
 4913: 
 4914:          // For both elements, interpolate density gradient at the side's half level.
 4915:          // The gradient at the side is the average of the gradients at the elements.
 4916:          // w1, w2 are used to take into account boundary sides, with just one element.
 4917:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4918:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4919:          const double wsum = w1 + w2;
 4920:          w1 = w1/wsum;
 4921:          w2 = w2/wsum;
 4922:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4923: 
 4924:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4925:          Vector2 gradRho = {0.0, 0.0};
 4926:          if (e1 != nullptr && k > kb) {
 4927:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4928:             
 4929:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4930:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4931:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 4932: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 4933:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 4934:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4935:          }      
 4936:          if (e2 != nullptr && k > kb) {
 4937:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4938:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4939:             
 4940:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4941:          }
 4942: 
 4943:          if constexpr(ics==2) {
 4944:             assert(false && "Not implemented: ics == 2");
 4945:             // IMPLEMENT THIS XXXXXX
 4946:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4947:             // swild(1)=tmp1
 4948:             // swild(2)=tmp2
 4949:          }
 4950:          
 4951:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4952:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4953:          // CHECK INDICES!!! XXX
 4954:          const double grav3 = side->grav3();
 4955:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4956: 
 4957:       } // for
 4958: 
 4959:    }
 4960: 
 4961: 
 4962: 
 4963:    __global__ void computeHorGradientAtSide(void) {
 4964: 
 4965:       // Compute the horizontal density gradient at each element.
 4966:       // It works in two steps:
 4967:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4968:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4969:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4970:       //             gradRho.r1 = rho1 - rho0
 4971:       //             gradRho.r2 = rho2 - rho0
 4972:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4973:       // 
 4974:       //  NOTE: We use de-meaned densities.
 4975: 
 4976:       SIDE(side);
 4977: 
 4978: // printf("side->isDry: %d\n", side->isDry);
 4979:       if (side->isDry) return;
 4980: 
 4981:       // Computes the gradient of the variables at the side center.
 4982:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4983:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4984:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4985: 
 4986:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4987:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4988:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4989:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4990: 
 4991: 
 4992:    }
 4993: 
 4994: 
 4995:    __global__ void solveMomentumEquations(double time) {
 4996: 
 4997:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4998:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4999: 
 5000:       SIDE(side);
 5001: 
 5002:       if (side->isDry) 
 5003:       {
 5004:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5005: 
 5006:          return;
 5007:       }
 5008: 
 5009:       const Node *n1 = side->n1;
 5010:       const Node *n2 = side->n2;
 5011: 
 5012:       const int kb = side->kb;
 5013: 
 5014:       const double veg_h = side->veg_h();
 5015:       const double grav3 = side->grav3();
 5016: 
 5017:       if (side->is2D()) {
 5018:          // Warning: Do not use htot2, which is updated.
 5019:          const double htot = side->htot1();
 5020:          const double hhat = side->hhat;
 5021: 
 5022:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5023: 
 5024:          Vector2 tau2 = {0.0, 0.0};
 5025:           
 5026:          if constexpr(ics==1) {
 5027:             tau2 = side->tau();
 5028: 
 5029:          } else {
 5030:             assert(false && "Not implemented: ics == 2");
 5031:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5032:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5033:             // taux2=(vn1+tt1)*0.5d0
 5034:             // tauy2=(vn2+ss1)*0.5d0
 5035:          } // if ics         
 5036: 
 5037:          // hat_gam has units of m/s
 5038: 
 5039:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5040: 
 5041:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5042:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5043: 
 5044:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5045: 
 5046: if (abs(hat_gam.x*hhat/htot) > rmaxvelx) printf("hat_gam.x*hhat/htot = %.16f, hat_gam.x = %.16f, hhat = %.16f, htot = %.16f\n", hat_gam.x*hhat/htot, hat_gam.x, hhat, htot);
 5047:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5048:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5049: 
 5050:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5051: 
 5052: 
 5053:       }
 5054:       else { // 3D
 5055: 
 5056:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5057:          // 
 5058:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5059:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5060:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5061:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5062:          // k+1 and k.
 5063: 
 5064: 
 5065:    
 5066: 
 5067: 
 5068:          const int ndim = nvrt - kb;
 5069:          const double zTopCanopy = side->zTopCanopy();
 5070: 
 5071:          // Initialize the tridiagonal system
 5072:          for (int k = kb + 1; k < nvrt; k++) {
 5073:             
 5074:             const int kin = k - (kb + 1);
 5075: 
 5076:             // Vertical viscosity at the face center
 5077:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5078:            
 5079: 
 5080:             alow[kin] = 0.0;
 5081:             cupp[kin] = 0.0;
 5082:             bdia[kin] = 0.0;
 5083: 
 5084:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5085:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5086: 
 5087:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5088:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5089:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5090: 
 5091:             // First part: layers k, k+1
 5092:             if (k < nvrt - 1) {
 5093:                              
 5094:                if constexpr(iveg != 0) {
 5095: 
 5096:                   // If there is vegetation at this level...
 5097:                   if (zTopCanopy > side->zc[k]) {
 5098:                      // If the canopy is above the k layer...
 5099:                      
 5100:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5101:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5102:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5103:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5104: 
 5105:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5106:                      const double vmag2 = length(ut2);
 5107:                      const double vmag1 = length(side->u2[k]);
 5108:                      const double vmag = 0.5*(vmag1 + vmag2);
 5109:                      
 5110:                      // Computes the vegetation alpha at the face center
 5111:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5112: 
 5113:                      cff1 += veg_alpha_sd*dt*vmag;
 5114: 
 5115:                   } // if (zTopCanopy
 5116:                } // if iveg
 5117: 
 5118:                const double dzz = side->Dz(k + 1);
 5119:                const double tmp = dt*dfz/dzz;
 5120:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5121: 
 5122:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5123:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5124:             }
 5125: 
 5126: 
 5127:             // Second part: layers k-1, k
 5128:             if (k > kb + 1) {
 5129: 
 5130:                double cff1 = 1.0; //init \bar{c^k}
 5131: 
 5132:                if constexpr(iveg != 0) {
 5133:                   // If there is vegetation at this level...
 5134:                   if (zTopCanopy > side->zc[k-1]) {
 5135:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5136:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5137: 
 5138:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5139: 
 5140:                      const double vmag2 = length(ut2);
 5141:                      const double vmag1 = length(side->u2[k-1]);
 5142:                      const double vmag = 0.5*(vmag1 + vmag2);
 5143: 
 5144:                      // Computes the vegetation alpha at the face center
 5145:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5146:                      cff1 += veg_alpha_sd*dt*vmag;
 5147:                   } // if zTopCanopy
 5148: 
 5149:                } // if iveg
 5150: 
 5151:                const double dzz = side->Dz(k);
 5152:                const double tmp = dt*dfz/dzz;
 5153:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5154: 
 5155:                alow[kin] += cff1*dzz/6.0 - tmp;
 5156:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5157: 
 5158:             } else { // Bottom boundary
 5159:                // This occurs at the bottom, where the bottom drag is applied.
 5160: 
 5161:                bdia[kin] += dt*side->chi2; // XXXX
 5162: 
 5163: 
 5164:             } // if (k > kb + 1)
 5165: 
 5166: 
 5167: 
 5168:          } // for (int k
 5169: 
 5170: 
 5171: 
 5172:          // Computes the RHS.
 5173:          // -----------------
 5174: 
 5175:          //	BC to be imposed at the end.
 5176: 
 5177:          const Vector2 gradETP  = side->gradETP;
 5178:          const Vector2 gradPr   = side->gradPr;
 5179:          const Vector2 gradEta1 = side->gradEta1;
 5180:          const Vector2 gradEta2 = side->gradEta2;
 5181: 
 5182:          const Vector2 *btu = side->btu;
 5183:          const Vector2 *u2  = side->u2;
 5184:          const double coriolis = side->coriolis;
 5185:          const Vector2 *nuGradU = side->nuGradU;
 5186: 
 5187: 
 5188:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5189: 
 5190:          for (int k = kb + 1; k < nvrt; k++) {
 5191:             const int kin = k - kb - 1;
 5192: 
 5193:             const double dz_0 = side->Dz(k);
 5194:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5195: 
 5196:             rrhs[kin] = {0.0, 0.0};
 5197:             double dz = 0.0;
 5198: 
 5199:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5200:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5201:             if (k < nvrt  ) dz += dz_1;
 5202:             if (k > kb + 1) dz += dz_0;
 5203: 
 5204:             // Elevation gradient, atmospheric pressure and tidal potential
 5205:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5206: 
 5207:             // Coriolis, advection, wind stress, and horizontal viscosity
 5208:             if (k < nvrt - 1) {
 5209: 
 5210: 
 5211:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5212:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5213:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5214:                                                 
 5215: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5216:                //diff stress tensors 1006
 5217:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5218:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5219:                   assert(false && "Not implemented: itur == 5");
 5220:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5221:                }
 5222: 
 5223:             } else { // k == nvrt - 1 SURFACE
 5224:                Vector2 tau2 = {0.0, 0.0};
 5225:                if constexpr(ics==1) {
 5226:                   tau2 = side->tau();
 5227:       
 5228:                } else {
 5229:                   assert(false && "Not implemented: ics == 2");
 5230:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5231:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5232:                   // taux2=(vn1+tt1)*0.5d0
 5233:                   // tauy2=(vn2+ss1)*0.5d0
 5234:                } // if ics
 5235: 
 5236:                rrhs[kin] += dt*tau2;
 5237: 
 5238:             } // if k<nvrt
 5239: 
 5240:             if (k > kb + 1) {
 5241:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5242:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5243:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5244: 
 5245:                // diff stress tensors 1006
 5246:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5247:                   assert(false && "Not implemented: itur == 5");
 5248:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5249:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5250:                }
 5251: 
 5252:             } // if k>kbs + 1
 5253: 
 5254:             // Baroclinic
 5255:             Vector2 *bcc = side->bcc;
 5256:             if constexpr(ibc == 0) {
 5257:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5258:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5259: 
 5260:             } // if ibc==0
 5261: 
 5262:          } // k=kb + 1,nvrt
 5263: 
 5264: 
 5265: 
 5266:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5267: 
 5268:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5269:             const int kin = k - kb - 1;
 5270: 
 5271:             // Velocity is always clamped to maximum values
 5272:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5273:          } // k
 5274: 
 5275:       } // if side->is2D()
 5276:       
 5277: 
 5278:       // Impose velocity boundary condition at the bottom
 5279:       if constexpr(imm == 2) { // 3D bed deformation model
 5280:          double dep;
 5281:          Vector2 vel;
 5282: 
 5283:          assert(false && "Not implemented: imm == 2");
 5284:          //update_bdef(time, x0, y0, dep, vel);
 5285:          // side->u2[kb] = vel;
 5286: 
 5287:       } else { // imm = 0 or 1
 5288:          if (side->Cd() == 0.0) {
 5289:             side->u2[kb] = side->u2[kb + 1];
 5290: 
 5291:          } else if (side->is3D()) { // 3D no slip bottom   
 5292:             side->u2[kb] = {0.0, 0.0};
 5293:          }
 5294:           
 5295:       } // if imm
 5296: 
 5297:       // The velocities below the bottom level are set to zero
 5298:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5299: 
 5300: 
 5301:    }
 5302: 
 5303: 
 5304:    __global__ void applyMomentumBC(void) {
 5305: 
 5306:       SIDE_BND(sideBnd);
 5307: 
 5308:       Side *side = sideBnd->side;
 5309:       const BoundarySegment *segment = sideBnd->segment;
 5310:       const Node *n1 = side->n1;
 5311:       const Node *n2 = side->n2;
 5312: 
 5313:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5314: 
 5315:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5316:       const bool isLand = segment->isLand;
 5317:       const int ifltype = segment->ifltype;
 5318: 
 5319:       const int kb = side->kb;
 5320: 
 5321:       if (!isLand && ifltype != 0) {
 5322:          const Vector2 *ubc = sideBnd->ubc;
 5323:   
 5324:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5325:             
 5326:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5327:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5328: 
 5329:             if (ifltype == -1) {
 5330:                // Flather 1
 5331: 
 5332:                const double depth = side->depth();
 5333: 
 5334:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5335: 
 5336:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5337: 
 5338:                side->u2[k] = vnorm*side->n;
 5339: 
 5340:             } else if (ifltype == -2) { // Discharge
 5341: 
 5342:                const double eta1 = side->eta1();
 5343:                const double eta2 = side->eta2();
 5344:                const double htot = side->htot2();
 5345: 
 5346:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5347:                assert(false && "Not implemented: Discharge bc");
 5348:                // const double dischrg = discharge(eta1);
 5349:                const double dischrg = 0.0; // XXX REMOVE
 5350:                
 5351: 
 5352:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5353: 
 5354:                const double vnorm = dischrg*eta2/htot;
 5355: 
 5356:                side->u2[k] = vnorm*side->n;
 5357: 
 5358:             }
 5359:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5360:                const double vnorm = dot(side->u2[k], side->n);
 5361: 
 5362:                double rat;
 5363:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5364:                else              rat = segment->vobc2; // outgoing
 5365: 
 5366:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5367: 
 5368:             }
 5369:             else { // not Flather or 3D radiation
 5370:                side->u2[k] = ubc[k];
 5371: 
 5372:             } // if (segment->ifltype...
 5373: 
 5374:          }
 5375: 
 5376:       }
 5377:       else if (isLand) { // if it is land boundary side
 5378: 
 5379:          if constexpr(islip == 0) { // free slip
 5380: 
 5381:             for (int k = kb; k < nvrt; k++) {
 5382: 
 5383:                const Vector2 t = side->t();
 5384:                const Vector2 n = side->n;
 5385: 
 5386:                double vnorm = 0.0; // for most cases
 5387:                const double vtan = dot(side->u2[k], t);
 5388:                
 5389:                side->u2[k] = vtan*t - vnorm*n;
 5390: 
 5391:             }
 5392: 
 5393:          } else { // no slip
 5394:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5395: 
 5396:          }
 5397:       } // if (side segment type...
 5398: 
 5399:    
 5400: 
 5401:    }
 5402: 
 5403: 
 5404:    __global__ void shapiroFilter1(void) {
 5405:       // First step of the Shapiro filter (normally used if indvel<=0)
 5406:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5407: 
 5408:       SIDE(side);
 5409: 
 5410:       // Only internal wet sides are processed
 5411:       if (side->isDry || !(side->isInternal())) return;
 5412: 
 5413:       const int kb = side->kb;
 5414: 
 5415:       for (int mm = 0; mm < niter_shap; mm++) {
 5416: 
 5417:          for (int k = kb + 1; k < nvrt; k++) {
 5418:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5419:             Vector2 suru = {0.0, 0.0};
 5420: 
 5421:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5422: 
 5423:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5424: 
 5425:                int kin = k;
 5426:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5427:                
 5428:                if constexpr(ics==1) {
 5429:                   suru += nSide->u2[kin];
 5430: 
 5431:                } else {
 5432:                   assert(false && "Not implemented: ics == 2");
 5433:                   // Vector2 vn1, vn2;
 5434:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5435:                   // suru=suru+vn1;
 5436:                   // surv=surv+vn2;
 5437:                }
 5438:             }
 5439: 
 5440: 
 5441:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5442: 
 5443:          }
 5444:       }
 5445:    }
 5446: 
 5447:    __global__ void shapiroFilter2(void) {
 5448:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5449: 
 5450:       SIDE(side);
 5451: 
 5452:       if (side->isDry || !(side->isInternal())) return;
 5453: 
 5454:       const int kb = side->kb;
 5455: 
 5456:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5457: 
 5458:       if (side->is2D()) {
 5459:          side->u2[kb + 1] = side->bcc[kb + 1];
 5460:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5461: 
 5462:       } else {
 5463:          // 3D
 5464:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5465:          
 5466:       }
 5467: 
 5468:    }
 5469: 
 5470: 
 5471:    __global__ void ul0UpdateZCoords(void) {
 5472:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5473:       
 5474:       NODE(node);      
 5475: 
 5476: 
 5477:       if (node->isDry2()) { 
 5478: printf("NODE i = %d, depth = %f, h_s = %f, h0 = %f, htot2 = %f\n", node->idx, node->depth, mesh->h_s, h0, node->htot2());      
 5479:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5480: 
 5481:          if constexpr(ivcor != 1) node->kb = 0;
 5482: 
 5483:       } else {
 5484: 
 5485:          node->updateKb();
 5486:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5487: 
 5488:       }
 5489: 
 5490:       // We use the temp.b field to store the previous state of isDry.
 5491:       node->tmp.b = node->isDry;
 5492: 
 5493:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5494:       node->isDry = true;
 5495: 
 5496:    }
 5497: 
 5498:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5499:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5500:    {
 5501:       ELEM(elem);
 5502: 
 5503:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5504: 
 5505:       // All the nodes of a wet element are wet.
 5506:       if (!elem->isDry) {
 5507:          elem->nodes[0]->isDry = false;
 5508:          elem->nodes[1]->isDry = false;
 5509:          elem->nodes[2]->isDry = false;
 5510:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5511: 
 5512:       }
 5513: 
 5514: 
 5515:       elem->kb = 0;
 5516: 
 5517:       if (elem->isDry) return;
 5518: 
 5519:       // Wet
 5520:       const Node *n1 = elem->nodes[0];
 5521:       const Node *n2 = elem->nodes[1];
 5522:       const Node *n3 = elem->nodes[2];  
 5523:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5524: 
 5525:    //    if(elem->isDry2()) {
 5526:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5527:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5528:    //        call parallel_abort(errmsg)
 5529:    //    }
 5530: 
 5531: 
 5532:       // Computes element's kb as the minimum of the nodes' kb.
 5533:       const int kb1 = n1->kb;
 5534:       const int kb2 = n2->kb;
 5535:       const int kb3 = n3->kb;
 5536:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5537: 
 5538: 
 5539:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5540: 
 5541: 
 5542:       // Computes the element z as the mean of the nodes z.
 5543:       for (int k = elem->kb; k < nvrt; k++) {
 5544: 
 5545:          // Compute the element z as the mean of the nodes z.
 5546:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5547:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5548:          elem->z[k] /= elem->i34;
 5549: 
 5550:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5551:       }
 5552:                   
 5553:    }
 5554: 
 5555:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5556:    {
 5557:       NODE(node);
 5558:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5559: 
 5560:       if (it == iths) return;
 5561: 
 5562: 
 5563:       if(!node->isDry && node->tmp.b) { // rewetted
 5564:          for (int k=0; k < nvrt; k++) {
 5565: 
 5566:             Vector3 utmp={0.0, 0.0, 0.0};
 5567: 
 5568:             double ttmp=0.0;
 5569:             double stmp=0.0;
 5570:             int icount=0;
 5571:             for (int j = 0; j < node->numNodes; j++) {
 5572: 
 5573: 
 5574:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5575:                if (!node->isDry) { // all indices extended
 5576:                   icount++;
 5577: 
 5578:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5579:                   utmp += node->u2[k];
 5580:                   
 5581:                   ttmp += node->tracers[k].tracer[0]; 
 5582:                   stmp += node->tracers[k].tracer[1]; 
 5583:                }
 5584:             }
 5585: 
 5586:             if(icount > 0) {
 5587:                const double inv_icount = 1.0/icount;
 5588:                node->u2[k]     = inv_icount*utmp;
 5589:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5590:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5591:             }
 5592:          }
 5593:       }
 5594:    }
 5595: 
 5596: 
 5597:    __global__ void ul0UpdateSides(int it, int iths) {
 5598: 
 5599:       SIDE(side);
 5600: 
 5601:       // A side is wet if and only if at least one of its elements is wet.
 5602:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5603: 
 5604:       const Node *n1 = side->n1;
 5605:       const Node *n2 = side->n2;
 5606:       const int kb1 = n1->kb;
 5607:       const int kb2 = n2->kb;
 5608: 
 5609:       side->kb = 0; // dry
 5610: 
 5611:       if (isWet) {
 5612: 
 5613:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5614: 
 5615:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5616: 
 5617:          side->kb = min(kb1, kb2);
 5618: 
 5619:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5620: 
 5621:          for (int k = side->kb; k < nvrt; k++) {
 5622:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5623: 
 5624:          
 5625:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5626: 
 5627:             // Compute velocity for re-wetted sides 
 5628:             if ((it != iths) && (side->isDry && isWet)) {
 5629:             
 5630:                Vector2 utmp={0.0, 0.0};
 5631: 
 5632:                int icount=0;
 5633: 
 5634:                // For all the sides on the two elements that share this side
 5635:                for (int j=0; j < 2; j++) {
 5636:                   const Element *elem = side->elems[j];
 5637:                   if (elem == nullptr) continue;
 5638: 
 5639:                   for (int jj=0; jj < elem->i34; jj++) {
 5640:                      const Side *nSide = elem->sides[jj];
 5641:                      if (nSide->isDry) continue;
 5642: 
 5643:                      icount++;
 5644:                      utmp += nSide->u2[k];                     
 5645:                   }
 5646:                }
 5647:                   
 5648:                assert(icount > 0 && "No wet sides around this side");
 5649:                if (icount > 0)  side->u2[k] = utmp/icount;
 5650:                   
 5651:             } // if ((it != iths) && (side->isDry && isWet))
 5652: 
 5653:          } // for k
 5654: 
 5655:       } // if isWet
 5656:    
 5657:       side->isDry = !isWet;
 5658: 
 5659:    }
 5660: 
 5661: 
 5662:    __global__ void zeroNodalVelocities(void) {
 5663:       NODE(node);
 5664: 
 5665:       for (int k = 0; k < nvrt; k++) {
 5666:          node->u2[k]   = {0.0, 0.0, 0.0};
 5667:          node->utmp[k] = {0.0, 0.0};
 5668:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5669:       }
 5670:    }
 5671: 
 5672:  
 5673: 
 5674:    __global__ void computeNodalVerticalVelocities1(void) {
 5675:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5676:    // Adds the element's vertical velocity times the element's area.
 5677:       ELEM(elem);
 5678: 
 5679:       for (int j = 0; j < elem->i34; j++) {
 5680:          Node *node = elem->nodes[j];
 5681: 
 5682:          for (int k = node->kb; k < nvrt; k++) {
 5683:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5684:          }
 5685:          atomicAdd(&(node->tmp.d), elem->area);
 5686:       }
 5687:    }
 5688: 
 5689:    __global__ void computeNodalVerticalVelocities2(void) {
 5690:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5691:    // Divides by the total area of the elements sharing the    node.
 5692:       NODE(node);
 5693: 
 5694:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5695:    }
 5696: 
 5697: 
 5698:    __global__ void computeNodalHorizontalVelocities1(void) {
 5699:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5700:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5701: 
 5702:       ELEM(elem);
 5703: 
 5704:       const int kb = elem->kb;
 5705:       const bool isTri = elem->isTri();
 5706: 
 5707:       if constexpr(indvel <= 0) {
 5708:          // Assuming discontinoius hvel.
 5709: 
 5710: 
 5711:          if (isTri) { // For triangles
 5712:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5713:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5714: 
 5715:             for (int j = 0; j < 3; j++) {
 5716:                // For every node of the triangle...
 5717:                Node *node = elem->nodes[j];
 5718: 
 5719:                const Side *s1 = elem->sides[j];
 5720:                const Side *s2 = elem->sides[(j + 1) % 3];
 5721:                const Side *s3 = elem->sides[(j + 2) % 3];
 5722: 
 5723:                const int numElements = node->numElements;
 5724:                const double inv_numElements = 1.0/numElements;
 5725: 
 5726:                for (int k = kb; k < nvrt; k++)  {
 5727:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5728:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5729:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5730:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5731:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5732:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5733: 
 5734:                }
 5735: 
 5736:             }
 5737:          }
 5738:          else { // For quads
 5739:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5740: 
 5741:          }
 5742: 
 5743:       }
 5744:       
 5745:    }
 5746: 
 5747: 
 5748:    __global__ void computeNodalHorizontalVelocities2(void) {
 5749:       NODE(node);
 5750: 
 5751:       for (int k = 0; k < nvrt; k++) {
 5752:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5753:       }
 5754:       
 5755:    }   
 5756: 
 5757:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5758:    // XXXX I'm not sure where I got this function from. 
 5759:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5760:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5761:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5762:    // It uses the utmp array as a temporary array to store the velocities.
 5763: 
 5764:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5765: 
 5766:       SIDE(side);
 5767: 
 5768:       const int kb = side->kb;
 5769: 
 5770:       Node *n1 = side->n1;
 5771:       Node *n2 = side->n2;
 5772: 
 5773:       for (int k = kb; k < nvrt; k++) {
 5774: 
 5775:          // Cast the u2 vector into a Vector2 
 5776:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5777:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5778: 
 5779:          n1_u2 = side->u2[k]/n1->numSides;
 5780:          n2_u2 = side->u2[k]/n2->numSides;
 5781: 
 5782:       }
 5783: 
 5784: 
 5785:    }
 5786: 
 5787:    __global__ void resetVelocityOpenBndNodes(void) {
 5788:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5789: 
 5790:       NODE_BND(nodebnd);
 5791: 
 5792:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5793:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5794:       }
 5795: 
 5796:    }
 5797: 
 5798: 
 5799:    __global__ void setVelocityOpenBndNodes(void) {
 5800:    // For open boundary nodes sets their velocity to the imposed values.
 5801: 
 5802:       SIDE_BND(sidebnd);
 5803: 
 5804:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5805:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5806:          // to its segment to the average of the side velocity.
 5807: 
 5808:          for (int k = 0; k < nvrt; k++) {
 5809:             Node *n1 = sidebnd->side->n1;
 5810:             Node *n2 = sidebnd->side->n2;
 5811: 
 5812:             // Cast the u2 vector into a Vector2 
 5813:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5814:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5815: 
 5816:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5817:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5818:             }
 5819:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5820:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5821:             }
 5822: 
 5823:          }
 5824:       }
 5825: 
 5826:    }
 5827: 
 5828: 
 5829:    __global__ void computeVerticalVelocity(void) {
 5830:       // Computes the vertical velocity at the (2D) element's centroid.
 5831:       // In this function we will be considering volumetric elements, with side faces and a 
 5832:       // bottom and a top face. We will call them SFs, BF and TF.
 5833:       // It computes the flux coming from BF and the SFs.
 5834:       // If the bed is moving, it takes that into account.
 5835:       // Since water is incompressible, the integral of the velocity times the normal vector
 5836:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5837:       // and the BF is equal to the flux going out from the TF.
 5838:       // TF = - BF - sum(SFs).
 5839:       // It then computes the horizontal velocity at the center of TF.
 5840:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5841:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5842:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5843: 
 5844:       ELEM(elem);
 5845: 
 5846:       if (elem->isDry) return;
 5847: 
 5848:       const int kb = elem->kb;
 5849:       const bool isTri = elem->isTri();
 5850: 
 5851:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5852: 
 5853:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5854:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5855:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5856: 
 5857:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5858: 
 5859:       double area3D;
 5860: 
 5861:       // Bottom face flux
 5862:       double bottomFlux = 0.0;
 5863:       Vector2 u2meanBottom = {0.0, 0.0};
 5864:       const Vector2 gradh = elem->grad2(&Node::depth);
 5865:       if constexpr(imm==2) {
 5866:          Vector3 ubed;
 5867: 
 5868:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5869:          // updateBDEF(ubed);
 5870:      
 5871:          // const double bflux0 = dot(ubed, elem_n1);
 5872: 
 5873:          // elem->w[kb] += ubed.z;
 5874:       }
 5875:       else {
 5876:          Vector2 umean;
 5877:          if constexpr(ics == 1) {
 5878:             u2meanBottom = elem->mean(kb, &Side::u2);
 5879:          }
 5880:          else {
 5881:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5882:          }
 5883: 
 5884:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5885:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5886: 
 5887:          bottomFlux = - dot(gradh, u2meanBottom);
 5888:       } // if imm
 5889: 
 5890:       // Compute w for kb+1 to nvrt-1
 5891:       for (int l = kb; l < nvrt - 1; l++) {
 5892: 
 5893:          // normal vector to the top face of the "volumetric" element (3D)
 5894:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 5895: 
 5896:          // Compute the total flux at the sides
 5897:          double sideFlux = 0.0;
 5898:          Vector2 u2top = {0.0, 0.0};
 5899:          for (int j = 0; j < elem->i34; j++) {
 5900:             const Side *side = elem->sides[j];
 5901: 
 5902:             const double sideArea = side->area(l);
 5903:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5904:             const double sign = elem->ssign[j]; 
 5905: 
 5906:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5907:          }
 5908:          
 5909:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5910:          //velocities at the centers of the sides
 5911:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5912: 
 5913:          // The flx at the top ace can be computed from the other flows.
 5914:          const double topFlux = - sideFlux - bottomFlux;
 5915:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5916: 
 5917:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5918: 
 5919:          elem_n1 = elem_n2;
 5920: 
 5921:          bottomFlux = - topFlux;
