 8304: __global__ void printMatrix(bool full) {
 8305:    // Debugging: print the matrix
 8306: 
 8307:    const int size = mesh->np;
 8308:    double sum = 0.0;
 8309:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8310:       const Node *node = mesh->localNodeData + idx_node;
 8311:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8312:       for (int j = 0; j < node->numNodes; j++) {
 8313:          Node* nbNode = node->nodes[j];
 8314:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8315:          sum += node->coeffMatrix[j];
 8316:       }
 8317:       if (full) printf("]\n");
 8318: 
 8319: 
 8320:    }
 8321:    if (!full) printf("sum=%lf\n", sum);
 8322: }
