 7996:                                  
 7997:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7998:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7999:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 8000:                    int *isdel, int *isidenode, int *isbnd,
 8001:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 8002:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8003:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8004:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8005:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8006:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8007:                    double *drag, double *roughness,
 8008:                    double *emo, double *efa, 
 8009:                    double *umo, double *ufa, 
 8010:                    double *vmo, double *vfa) {
 8011: 
 8012:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8013:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8014:                        isdel, isidenode, isbnd,
 8015:                        nond, nlnd, iond, ilnd, 
 8016:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8017:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8018:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8019:                        localNodeIndices, localElemIndices, localSideIndices,
 8020:                        localNodePart, localElemPart, localSidePart,
 8021:                        drag, roughness,
 8022:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8023:   }
