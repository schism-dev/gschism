 4860: extern "C" {
 4861:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4862:                                   int* indices, int* indptr) {
 4863: 
 4864:       NODE(node);
 4865:       
 4866:       const int idx = node->idx;
 4867:       
 4868:       // Computes the index in the nzz array      
 4869:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4870: 
 4871: 
 4872:       indptr[idx] = nzzIdx;
 4873:       indices[nzzIdx] = idx;
 4874: 
 4875:       data_d[nzzIdx]    = node->coeffDiag;
 4876: 
 4877:       b_d[idx] = node->qel;
 4878: 
 4879:       for (int k = 0; k < node->numNodes; ++k) {
 4880:          const Node* nb = node->nodes[k];
 4881: 
 4882:          const int j = nb->idx;
 4883: 
 4884:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4885: 
 4886:          indices[nzzIdx + k + 1] = j;
 4887:       }
 4888: 
 4889:  
 4890:    }
 4891: 
 4892: 
 4893: 
 4894:    __global__ void solverCopyResult(double* x) {
 4895:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4896:       NODE(node);
 4897:       const int idx = node->idx;
 4898: 
 4899:       node->mX = x[idx];
 4900:    }
