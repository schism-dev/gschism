 8168: __global__ void returnB(double *res) {
 8169:    // Debugging: returns the matrix as a CuPy array
 8170: 
 8171:    const int size = mesh->np;
 8172:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8173:       const Node *node = mesh->localNodeData + idx_node;
 8174: 
 8175:       res[idx_node] = node->qel;
 8176: 
 8177:    }
 8178:    
 8179: }
