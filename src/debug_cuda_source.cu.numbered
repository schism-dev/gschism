 8350: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8351:    Node *nodes = mesh->localNodeData;
 8352: 
 8353:    *addr = nodes;
 8354:    *sizeNode = sizeof(Node);
 8355: 
 8356:    switch (varCode) {
 8357:       case (int)VarCode::depth:
 8358:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8359:          *sizeType = sizeof(double);
 8360:          break;
 8361:       case (int)VarCode::eta:
 8362:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8363:          *sizeType = sizeof(double);
 8364:          break;
 8365:       case (int)VarCode::x:
 8366:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8367:          *sizeType = sizeof(Vector2);
 8368:          break;
 8369:       case (int)VarCode::z:
 8370:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8371:          *sizeType = sizeof(double);
 8372:          break;
 8373:       case (int)VarCode::kb:
 8374:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8375:          *sizeType = sizeof(int);
 8376:          break;
 8377:       case (int)VarCode::isdry:
 8378:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8379:          *sizeType = sizeof(int);
 8380:          break;         
 8381:       case (int)VarCode::w:
 8382:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8383:          *sizeType = sizeof(double);
 8384:          break;
 8385:       case (int)VarCode::u:
 8386:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8387:          *sizeType = sizeof(Vector2);
 8388:          break;  
 8389:       case (int)VarCode::u_air:
 8390:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8391:          *sizeType = sizeof(Vector2);
 8392:          break;
 8393:       default:
 8394:          *offset = -1;    
 8395:    }  
 8396:    
 8397: }
