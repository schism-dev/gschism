 3665: __device__ __inline__ void Node::updateZCoordData(void) {
 3666: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3667: 
 3668:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3669:    // if (isDry2()) {
 3670:    //    kb = -1;  // XXXXXXXX KKKKK
 3671:    //    return;
 3672:    // }
 3673: 
 3674: 
 3675:    if constexpr(ivcor == 2) {  // SZ coordinates
 3676:       
 3677:       // Compute bottom level index
 3678:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3679:    } 
 3680:    else {  // if (ivcor == 1) Localized sigma
 3681:       // Do nothing
 3682:    }
 3683: 
 3684: 
 3685: }
