 8069: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8070:    Node *nodes = mesh->localNodeData;
 8071: 
 8072:    *addr = nodes;
 8073:    *sizeNode = sizeof(Node);
 8074: 
 8075:    switch (varCode) {
 8076:       case (int)VarCode::depth:
 8077:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8078:          *sizeType = sizeof(double);
 8079:          break;
 8080:       case (int)VarCode::eta:
 8081:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8082:          *sizeType = sizeof(double);
 8083:          break;
 8084:       case (int)VarCode::x:
 8085:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8086:          *sizeType = sizeof(Vector2);
 8087:          break;
 8088:       case (int)VarCode::z:
 8089:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8090:          *sizeType = sizeof(double);
 8091:          break;
 8092:       case (int)VarCode::kb:
 8093:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8094:          *sizeType = sizeof(int);
 8095:          break;
 8096:       case (int)VarCode::isdry:
 8097:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8098:          *sizeType = sizeof(int);
 8099:          break;         
 8100:       case (int)VarCode::w:
 8101:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8102:          *sizeType = sizeof(double);
 8103:          break;
 8104:       case (int)VarCode::u:
 8105:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8106:          *sizeType = sizeof(Vector2);
 8107:          break;         
 8108:       default:
 8109:          *offset = -1;    
 8110:    }  
 8111:    
 8112: }
