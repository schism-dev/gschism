 7544: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7545:    // Get the value of a variable from an element
 7546:    // varName is the name of the variable to get
 7547:    // var is the array to store the value
 7548:    // k is the vertical level index of the variable to get
 7549: 
 7550:    ELEM(elem);
 7551:    
 7552:    int idx = elem->idx;
 7553:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7554: 
 7555:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7556:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7557:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7558:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7559:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7560:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7561:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7562:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7563:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7564:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7565:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7566:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7567:       
 7568:    
 7569: }
 7570: 
 7571: 
 7572: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7573:    // Get the value of a variable from an node
 7574:    // varName is the name of the variable to get
 7575:    // var is the array to store the value
 7576:    // k is the vertical level index of the variable to get
 7577: 
 7578:    NODE(node);
 7579:    
 7580:    int idx = node->idx;
 7581:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7582: 
 7583:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7584:    
 7585:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7586:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7587:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7588:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7589:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7590:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7591:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7592:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7593:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7594:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7595:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7596:    
 7597:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7598:       
 7599:    
 7600: }
 7601: 
 7602: 
 7603: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7604:    // Get the value of a variable from an side
 7605:    // varName is the name of the variable to get
 7606:    // var is the array to store the value
 7607:    // k is the vertical level index of the variable to get
 7608:    SIDE(side);
 7609:    
 7610:    int idx = side->idx;
 7611:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7612: 
 7613:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7614:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7615:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7616:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7617:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7618:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7619:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7620:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7621:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7622:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7623:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7624:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7625:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7626:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7627:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7628:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7629:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7630:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 7631:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7632:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7633:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7634:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7635:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7636:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7637:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7638:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7639:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7640:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7641:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7642:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7643:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7644:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7645:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7646:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7647:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7648:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7649: }
 7650: 
 7651: 
 7652: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7653:    // Get the value of a variable from an side
 7654:    // varName is the name of the variable to get
 7655:    // var is the array to store the value
 7656:    // k is the vertical level index of the variable to get
 7657:    SIDE_BND(sideBnd);   
 7658: 
 7659:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7660:    if (sideBnd->segment->isLand) idx = -7;
 7661: 
 7662:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7663:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7664: 
 7665: }
