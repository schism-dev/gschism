 9313: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9314:    Element *elems = mesh->localElemData;
 9315: 
 9316:    *addr = elems;
 9317:    *sizeElement = sizeof(Element);
 9318:    switch (varCode) {
 9319:       case (int)VarCode::z:
 9320:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9321:          *sizeType = sizeof(double);
 9322:          break;
 9323:       case (int)VarCode::x:
 9324:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9325:          *sizeType = sizeof(Vector2);
 9326:          break;
 9327:       case (int)VarCode::gradETP:
 9328:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9329:          *sizeType = sizeof(Vector2);
 9330:          break;
 9331:       case (int)VarCode::area:
 9332:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9333:          *sizeType = sizeof(double);
 9334:          break;
 9335:       case (int)VarCode::depth:
 9336:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9337:          *sizeType = sizeof(double);
 9338:          break;
 9339:       case (int)VarCode::radius:
 9340:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9341:          *sizeType = sizeof(double);
 9342:          break;
 9343:       case (int)VarCode::ghat:
 9344:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9345:          *sizeType = sizeof(Vector2);
 9346:          break;
 9347:       case (int)VarCode::kb:
 9348:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9349:          *sizeType = sizeof(int);
 9350:          break;
 9351:       case (int)VarCode::isdry:
 9352:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9353:          *sizeType = sizeof(int);
 9354:          break;            
 9355:       case (int)VarCode::w:
 9356:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9357:          *sizeType = sizeof(double);
 9358:          break;
 9359:       case (int)VarCode::FaceIndices:
 9360:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9361:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9362:          *sizeType = sizeof(Node);
 9363:          break;
 9364:       default:
 9365:          *offset = -1;
 9366:    }
 9367: }
