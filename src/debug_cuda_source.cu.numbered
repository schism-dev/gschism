 3236: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3237:    double *node_coords, double *node_coords_ll, bool use_ll,
 3238:    double *wind_rotate_angle,   
 3239:    int *isdel, int *isidenode, int *isbnd,
 3240:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3241:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3242:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3243:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3244:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3245:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3246:    double *drag, double *roughness) {
 3247: 
 3248:    ELEM(pelem);
 3249:    Element &elem(*pelem);
 3250:    const int i = idx_elem;
 3251: 
 3252:    elem.idx = i;
 3253: 
 3254:    for (int j = 0; j < i34[i]; j++) {
 3255:       const int idxNode = elnode[i*4 + j];  
 3256:       const int idxSide = elside[i*4 + j];
 3257:       
 3258:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3259:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3260: 
 3261: 
 3262:       // Find the neighboring element  
 3263:       if (elem.sides[j]->elems[0] == &elem) {
 3264:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3265:       }
 3266:       else {
 3267:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3268:       }
 3269:       
 3270:    }
 3271: 
 3272:    elem.i34 = i34[i];
 3273: 
 3274:    // Compute the centroid of the element and its depth
 3275:    Vector2 center = {0.0, 0.0};
 3276:    elem.depth = 0.0;
 3277:    for (int j = 0; j < i34[i]; j++) {
 3278: cudaPointerAttributes attr;
 3279: cudaError_t err = cudaPointerGetAttributes(&attr, elem.nodes[j]);      
 3280: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3281: if (err != cudaSuccess) {
 3282:    printf("elem.nodes[%d] points to invalid memory: %s\n", j, cudaGetErrorString(err));
 3283:    return;
 3284: }
 3285: return;     
 3286:       center += elem.nodes[j]->p/i34[i];
 3287:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3288:    }
 3289:    elem.center = center;
 3290: 
 3291:    
 3292:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3293:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3294: 
 3295:    elem.area = elem.computeSignedArea(); 
 3296:    elem.radius = sqrt(elem.area)/pi; 
 3297:    
 3298:    // Determines which way the normal vector to each side is oriented.
 3299:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3300:    for (int j = 0; j < i34[i]; j++)  
 3301:    {
 3302:       if (elem.sides[j]->elems[0] == &elem) {
 3303:          elem.ssign[j] =  1.0;
 3304:       }
 3305:       else {
 3306:          elem.ssign[j] = -1.0;
 3307:       }
 3308: 
 3309:    }
 3310: 
 3311:    // Derivatives of shape functions
 3312:    //  For ics=2, this is done inside element/ll frame XXX
 3313:    //  For quads, the derivative is evaluated at centroid
 3314:    for (int j = 0; j < elem.i34; j++) {
 3315:       const double area = elem.area;
 3316:       const int id2 = elem.nxq(1 + j);
 3317:       const int id3 = elem.nxq(2 + j);
 3318:       const int id4 = elem.nxq(3 + j);
 3319:       if (elem.isTri()) {
 3320:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3321:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3322:          // da1/dx = (y1 - y2)/(2*area)
 3323:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3324:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3325:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3326:       }
 3327:       else  { // Quad; evaluate at centroid
 3328:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3329:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3330:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3331:       } // if Tri
 3332: 
 3333:    } // for j   
 3334:    
 3335:    
 3336: 
 3337: }
