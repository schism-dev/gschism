 3870:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3871: 
 3872:       NODE_BND(nodeBnd);
 3873: 
 3874:       Node *node = nodeBnd->node;
 3875: 
 3876:       node->ETP = 0.0;
 3877: 
 3878:       for (int j=0; j<ntip; j++) {
 3879: 
 3880:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3881:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3882:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3883: 
 3884:          if constexpr(iloadtide==1) { // loading tide
 3885:             assert(false && "Loading tide not implemented");
 3886:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3887:          }
 3888:          
 3889:       }
 3890:       
 3891:    }
