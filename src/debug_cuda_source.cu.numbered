 8545: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8546:    Node *nodes = mesh->localNodeData;
 8547: 
 8548:    *addr = nodes;
 8549:    *sizeNode = sizeof(Node);
 8550: 
 8551:    switch (varCode) {
 8552:       case (int)VarCode::depth:
 8553:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8554:          *sizeType = sizeof(double);
 8555:          break;
 8556:       case (int)VarCode::eta:
 8557:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8558:          *sizeType = sizeof(double);
 8559:          break;
 8560:       case (int)VarCode::x:
 8561:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8562:          *sizeType = sizeof(Vector2);
 8563:          break;
 8564:       case (int)VarCode::z:
 8565:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8566:          *sizeType = sizeof(double);
 8567:          break;
 8568:       case (int)VarCode::kb:
 8569:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8570:          *sizeType = sizeof(int);
 8571:          break;
 8572:       case (int)VarCode::isdry:
 8573:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8574:          *sizeType = sizeof(int);
 8575:          break;         
 8576:       case (int)VarCode::w:
 8577:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8578:          *sizeType = sizeof(double);
 8579:          break;
 8580:       case (int)VarCode::u:
 8581:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8582:          *sizeType = sizeof(Vector2);
 8583:          break;  
 8584:       case (int)VarCode::u_air:
 8585:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8586:          *sizeType = sizeof(Vector2);
 8587:          break;
 8588:       default:
 8589:          *offset = -1;    
 8590:    }  
 8591:    
 8592: }
