 2091:    
 2092:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2093:    // Project the vectors from the node frame to the element frame
 2094: 
 2095:  
 2096:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2097:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2098:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2099:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2100:       else          v[3] = Vector2();
 2101:    }
 2102: 
 2103:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2104:    // Project the vectors from the side frame to the element frame
 2105: 
 2106:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2107:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2108:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2109:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2110:       else          v[3] = Vector2();
 2111:    }
