  956: struct Side {
  957: 
  958:    // Geometry information
  959:    int idx;               // Index of the side
  960:    Node *n1, *n2;
  961:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  962: 
  963:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  964:    Vector2 center;        // Location of side center. 
  965:    double zc[nvrt];       // Side center z-coord at each vertical level
  966: 
  967:    Frame frame;
  968: 
  969:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  970:                           // this is nullptr
  971:    
  972:    int kb;                // Bottom index of the side
  973:    bool isDry;            // True if the side is dry
  974:  
  975:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  976: 
  977:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  978: 
  979:    // Physical information
  980:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  981:    double  w2[nvrt];            // Vertical velocity at each vertical level
  982:    Vector2 btu[nvrt];           // Back-tracked velocity
  983:    Vector2 U;                   // Vertically averaged velocity vector  
  984: 
  985:    Vector2 nuGradU[nvrt];          // nu*grad u
  986: 
  987:    Vector2 bcc[nvrt];           // Baroclinic term
  988:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  989: 
  990:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  991:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  992:    Vector2 gradPr;               // Gradient of pressure
  993:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  994: 
  995: 
  996:    double hhat;                 // \breve{H} in notes
  997: 
  998:    double shapiro;
  999: 
 1000:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1001: 
 1002:    double coriolis;             // Coriolis parameter
 1003: 
 1004:    // Vegetation parameters
 1005:    double veg_c2;
 1006:    double veg_beta;
 1007: 
 1008:    // Bottom drag parameters.
 1009:    double chi;
 1010:    double chi2;
 1011: 
 1012:    __inline__ __device__ double x(double t) const;
 1013:    __inline__ __device__ double y(double t) const;
 1014:    __inline__ __device__ double lon(void) const;
 1015:    __inline__ __device__ double lat(void) const;
 1016:    __inline__ __device__ Point2 p_t(double t) const;
 1017: 
 1018:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1019:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
 1020:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1021:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1022: 
 1023:    __inline__ __device__ Side* neigh(int index) const { 
 1024:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1025:       assert(index >= 0 && index < 4); 
 1026:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1027: 
 1028:       const int ielem = index & 1;           // 0 or 1
 1029:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1030: 
 1031:       const Element* elem = elems[ielem];
 1032: 
 1033:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1034: 
 1035:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1036: 
 1037:    }
 1038: 
 1039:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1040: 
 1041:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1042: 
 1043:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1044:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1045:    __inline__ __device__ int iadv(void) const;
 1046: 
 1047:    __inline__ __device__ double grav3(void) const;
 1048:    
 1049:    __inline__ __device__ double eta2(void) const;
 1050:    __inline__ __device__ double eta1(void) const;
 1051:    __inline__ __device__ double depth(void) const;
 1052:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1053:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1054: 
 1055:    __inline__ __device__ double dfv(int k) const;
 1056: 
 1057:    __inline__ __device__ double veg_h(void)  const;
 1058:    __inline__ __device__ double veg_nv(void) const;
 1059:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1060:    __inline__ __device__ double veg_alpha3D(int k) const;
 1061:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1062: 
 1063:    __inline__ __device__ double Cd(void) const;
 1064: 
 1065:    __inline__ __device__ Vector2 tau(void) const;
 1066: 
 1067:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1068:    
 1069: 
 1070:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1071:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1072:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1073:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1074:    } 
 1075:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1076:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1077:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1078:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1079: 
 1080:    // Get valid starting element (for backtracking)
 1081:    __inline__ __device__ Element* getStartElement() {
 1082:       return elems[0] ? elems[0] : elems[1];
 1083:    }
 1084: 
 1085:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1086:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1087: 
 1088:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1089: 
 1090:       // Dot product of the negative velocity vector with the side normal vector
 1091:       const double dot_prod1 = -dot(u, n);
 1092: 
 1093:       // Vector from side center to element 0 centroid
 1094:       const Vector2 v2 = elems[0]->center - center;
 1095: 
 1096:       // Dot product of the vector with the side normal vector
 1097:       const double dot_prod2 = dot(v2, n);
 1098: 
 1099:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1100:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1101: 
 1102:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1103:       else                           return elems[1];
 1104: 
 1105:  
 1106:    }
 1107: 
 1108:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1109:       // Given an element, returns the other element that shares this side
 1110:       return (elems[0] == elem) ? elems[1] : elems[0];
 1111:    }
 1112: 
 1113:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1114:       // Given a node, returns the other node that shares this side
 1115:       return (n1 == node) ? n2 : n1;
 1116:    }
 1117:  
 1118:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1119: 
 1120: 
 1121: 
 1122: 
 1123: };
 1124: 
