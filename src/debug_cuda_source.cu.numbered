  441: 
  442: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  443: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  444: //
  445: 
  446:    const double radius2 = dot(p, p);
  447:    const double radius = sqrt(radius2);
  448:  
  449:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  450:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  451: 
  452:    rlon = atan2(p.y, p.x); // (-pi,pi]
  453: 
  454:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  455:       rlat = asin(p.z/radius);
  456:    } else {
  457:       rlat = asin(p.z/rearth_pole);
  458:    }
  459:   
  460: }
  461: 
  462: 
  463: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  464: // Compute the 3D Cartesian coordinates from the latitude and longitude
  465: // Inputs:
  466: //        lat: latitude in radians
  467: //        lon: longitude in radians
  468: // Output:
  469: //        x, y, z: 3D Cartesian coordinates
  470: 
  471:    double sin_lat, cos_lat, sin_lon, cos_lon;
  472: 
  473:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  474:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  475: 
  476:    sincos(lat, &sin_lat, &cos_lat);
  477:    sincos(lon, &sin_lon, &cos_lon);
  478: 
  479:    const double x = rearth_eq*cos_lat*cos_lon;
  480:    const double y = rearth_eq*cos_lat*sin_lon;
  481:    const double z = rearth_pole*sin_lat;
  482: 
  483:    return make_double3(x, y, z);
  484: }
