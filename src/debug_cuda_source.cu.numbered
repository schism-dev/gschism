 5144:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5145:       }
 5146: 
 5147:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5148:       node->setWind(wind);
 5149: 
 5150:       node->pr = pressAir[idx];
 5151:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5152: 
 5153:    }
