 5864: 
 5865:    __global__ void backtrackAllNodes(void) {
 5866: 
 5867:       // max/min # of sub-divisions
 5868:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5869:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5870: 
 5871:       SIDE(side);
 5872: 
 5873:       const int kb = side->kb;
 5874: 
 5875: 
 5876:       // Initialize btrack velocities to the actual velocities at the side 
 5877:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5878:   
 5879:       if (side->isDry) return;
 5880:      
 5881: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5882: 
 5883:       // Checks that at least one element is not dry
 5884:       const Element *elem1 = side->elems[0];
 5885:       const Element *elem2 = side->elems[1];
 5886: 
 5887: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5888: 
 5889:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5890:       
 5891:       // XXXXXX
 5892:       // !swild_tmp to store global coord. of the starting side
 5893:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5894:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5895:       // !Use sframe2 
 5896:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5897: 
 5898: 
 5899:       for (int k = kb; k < nvrt; k++) {
 5900:       //  For ics=2, the coordinates are all in the side's local frame
 5901: 
 5902:          const int iadvf = side->iadv();  // Advection flag   
 5903:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5904: 
 5905:          const double vmag2 = norm2(side->u2[k]);
 5906: 
 5907:          if (vmag2 <= velmin_btrack_sq) {  
 5908:             // No activity 
 5909: 
 5910:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5911:             
 5912:          } else {  // do btrack
 5913: 
 5914:             // Compute number of sub-divisions based on local gradients of the velocity field
 5915: 
 5916:             // XXX IS THIS NECESSARY?
 5917:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5918:             double suma = 0.0;
 5919:             int icount = 0;
 5920:             #pragma unroll
 5921:             for (int l=0; l<2; l++) {
 5922:             // For each element sharing the side...
 5923: 
 5924:                const Element *elem = side->elems[l];
 5925:                  
 5926:                if (elem == nullptr) continue;
 5927: 
 5928:                icount++;
 5929: 
 5930:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5931:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5932:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5933: 
 5934:                double utmp[4];
 5935:                double vtmp[4];
 5936:                #pragma unroll
 5937:                for (int j = 0; j < elem->i34; j++) {
 5938: 
 5939:                   const Node *node = elem->nodes[j];
 5940: 
 5941:                   if constexpr(ics==1) {
 5942:                      utmp[j] = node->u2[k].x;
 5943:                      vtmp[j] = node->u2[k].y;  
 5944: 
 5945:                   } else {
 5946:                      // 'Project' the velocity from the node frame to the element frame
 5947:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5948:                      utmp[j] = tmp_u2.x;
 5949:                      vtmp[j] = tmp_u2.y;
 5950: 
 5951:                   }
 5952:                } // for j
 5953: 
 5954:                const Vector2 grad_u = elem->grad2(utmp); 
 5955:                const Vector2 grad_v = elem->grad2(vtmp);
 5956:    
 5957:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5958:             } // for l
 5959: 
 5960:             assert(icount > 0 && "Impossible 77");
 5961: 
 5962:             // '4' is somewhat arbitrary
 5963:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5964: 
 5965:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5966:             Vector3 u_int = {0.0, 0.0, 0.0};
 5967: 
 5968:             side->btrack(k, dt, dtbk, u_int);
 5969: 
 5970: 
 5971:             side->btu[k] = {u_int.x, u_int.y};
 5972:                
 5973:          } // if vmag (do backtrack)
 5974: 
 5975: 
 5976:       } // for k=kb,nvrt-1
 5977: 
 5978:    }
 5979: 
 5980: } // extern "C"
 5981: 
 5982: template<int nc>
 5983: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5984: 
 5985: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5986: //
 5987: // Although this is a general function, it is used only for equations on vertical levels.
 5988: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5989: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5990: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5991: //
 5992: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5993: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5994: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5995: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5996: 
 5997:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5998:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5999: 
 6000:    double bet = b[0];
 6001:    if constexpr (nc == 1) {
 6002:       u[0] = rhs[0]/bet;
 6003:    } else {
 6004:       #pragma unroll
 6005:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 6006:    }
 6007: 
 6008:    for (int j = 1; j < n; j++) {
 6009:       gam[j] = c[j - 1]/bet;
 6010:       bet = b[j] - a[j]*gam[j];
 6011: 
 6012:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 6013: 
 6014:       if constexpr (nc == 1) {
 6015:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 6016:       } else {
 6017:          #pragma unroll
 6018:          for (int l = 0; l < nc; l++) {
 6019:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 6020:          }
 6021:       }
 6022:    }
 6023: 
 6024:    // Back-substitution
 6025:    for (int j = n - 2; j >= 0; j--) {
 6026:       if constexpr (nc == 1) {
 6027:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 6028:       } else {
 6029:          for (int l = 0; l < nc; l++) {
 6030:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 6031:          }
 6032:       }
 6033:    }
 6034: }
 6035: 
 6036: 
 6037: 
 6038: // Helper function that contains the core algorithm
 6039: template<typename XAccessor, typename YAccessor>
 6040: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 6041:                                     double  yp_top, double  yp_bot, 
 6042:                                     CubicSpline &spline) {
 6043:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 6044:    // 
 6045:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 6046:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 6047:    //
 6048:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 6049:    // 
 6050:    // Inputs: 
 6051:    //            n: dimension for x etc; # of data pts (>=2);
 6052:    //            getX, getY: functions to access x,y coordinates
 6053:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 6054:    //     Output: 
 6055:    //            spline (CubicSpline): spline structure with x,y,y',y''
 6056: 
 6057:    const int n = k2 - k1 + 1;
 6058:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 6059: 
 6060:    // Allocate memory for the splines
 6061:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 6062:    spline.x   = new double[n];
 6063:    spline.y   = new double[n];
 6064:    spline.yp  = new double[n];
 6065:    spline.ypp = new double[n];
 6066: 
 6067:    for (int k=k1; k<=k2; k++) {
 6068:       spline.x[k] = getX(k);
 6069:       spline.y[k] = getY(k);
 6070:    }
 6071: 
 6072:    // This is to simplify expressions later
 6073:    double *x = spline.x;
 6074:    double *y = spline.y;
 6075: 
 6076:    double *a = nullptr;
 6077:    double *b = nullptr;
 6078:    double *c = nullptr;
 6079:    double *gam = nullptr;
 6080:    double *rhs = nullptr;
 6081:    
 6082: 
 6083:       a = new double[n];   // Lower diagonal
 6084:       b = new double[n];   // Diagonal
 6085:       c = new double[n];   // Upper diagonal
 6086:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 6087:       rhs = new double[n]; // Right-hand side
 6088: 
 6089:    for (int k=k1; k<=k2; k++) {
 6090:       if (k == k1) {
 6091:          // Bottom level
 6092:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 6093:          b[k] = (x[k+1] - x[k])/3.0;
 6094:          c[k] = b[k]/2.0;
 6095:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 6096:       } else if (k == n - 1) {
 6097:          // Top level (surface)
 6098:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 6099:          b[k] = (x[k] - x[k-1])/3.0;
 6100:          a[k] = b[k]/2.0;
 6101:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 6102:       } else {
 6103:          // Intermediate levels
 6104:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 6105:          b[k] = (x[k+1] - x[k-1])/3.0;
 6106:          a[k] = (x[k  ] - x[k-1])/6.0;
 6107:          c[k] = (x[k+1] - x[k  ])/6.0;
 6108:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 6109:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 6110:       }
 6111:    }
 6112: 
 6113:    // Solve the tridiagonal system
 6114:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 6115:    
 6116:    spline.yp[k1] = yp_bot;
 6117:    spline.yp[k2] = yp_top;
 6118: 
 6119:    // Compute rest of 1st derivatives using the splines
 6120:    for (int k=k1+1; k<k2; k++) {
 6121:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 6122:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 6123:    }
 6124:    
 6125:    delete[] a;
 6126:    delete[] b;
 6127:    delete[] c;
 6128:    delete[] gam;
 6129:    delete[] rhs;
 6130: 
 6131: }
 6132: 
 6133: // Array version
 6134: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 6135:                                 double y_top, double y_bot, 
 6136:                                 CubicSpline &spline) {
 6137:    auto getX = [x] (int k) { return x[k]; };
 6138:    auto getY = [y] (int k) { return y[k]; };
 6139:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6140: }
 6141: 
 6142: // Lambda version - allows custom access patterns
 6143: template<typename XFunc, typename YFunc>
 6144: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 6145:                                 double y_top, double y_bot,
 6146:                                 CubicSpline &spline) {
 6147:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6148: }
 6149: 
 6150: 
 6151: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 6152: {
 6153:    assert("Not implemented");
 6154: 
 6155:    return 0.0;
 6156: }
