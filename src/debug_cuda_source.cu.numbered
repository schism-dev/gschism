 3676: __device__ __inline__ void Node::updateZCoordData(void) {
 3677: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3678: 
 3679:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3680:    // if (isDry2()) {
 3681:    //    kb = -1;  // XXXXXXXX KKKKK
 3682:    //    return;
 3683:    // }
 3684: 
 3685: 
 3686:    if constexpr(ivcor == 2) {  // SZ coordinates
 3687:       
 3688:       // Compute bottom level index
 3689:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3690:    } 
 3691:    else {  // if (ivcor == 1) Localized sigma
 3692:       // Do nothing
 3693:    }
 3694: 
 3695: 
 3696: }
