 2213: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2214: {
 2215:     uintptr_t p = (uintptr_t)address;
 2216:     assert((p & 1) == 0);
 2217: 
 2218:     unsigned int* base = (unsigned int*)(p & ~3);
 2219:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2220:                                   :  (unsigned int)val;
 2221: 
 2222:     atomicAdd(base, addend);
 2223: }
