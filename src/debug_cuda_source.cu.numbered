 2149:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2150:    // Project the vectors from the node frame to the element frame
 2151: 
 2152:  
 2153:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2154:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2155:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2156:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2157:       else          v[3] = Vector2();
 2158:    }
 2159: 
 2160:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2161:    // Project the vectors from the side frame to the element frame
 2162: 
 2163:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2164:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2165:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2166:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2167:       else          v[3] = Vector2();
 2168:    }
