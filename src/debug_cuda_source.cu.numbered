 6607:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6608: 
 6609:       SIDE(side);
 6610: 
 6611:       side->U = {0.0, 0.0}; 
 6612:          
 6613:       if(side->isDry) return;
 6614: 
 6615:       // Vertically integrated velocity U
 6616:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6617:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6618:          side->U += side->Dz(k + 1)*uc;  
 6619:       }
 6620: 
 6621:    }
 6622: 
 6623:    __global__ void computeBottomDragVegetation(void) {
 6624:       // UNFINISHED. CHECK THIS: XXXXX
 6625:       // How many kernels are needed? Why so many for loops?
 6626:       // Is the loop on sides needed?
 6627: 
 6628:       NODE(node);
 6629: 
 6630:       const int    kb      = node->kb;
 6631:       const double htot    = node->htot2(); 
 6632:       
 6633:       if (node->isDry) {
 6634:          // Default values for dry nodes
 6635:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6636:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6637: 
 6638:          return;
 6639:        
 6640:       }
 6641: 
 6642:       // Computes bottom drag Cd based on the selected nchi
 6643:       node->computeBottomDragCd();
 6644:       
 6645: 
 6646: 
 6647:       //   Bottom stress in m^2/s^2
 6648:       if (node->rho[kb + 1] >= -98.0)
 6649:       {
 6650:          const double mag_u = length(node->u2[kb + 1]);
 6651:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6652: 
 6653:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6654:          // !sediment erosion: this part needs more documentation
 6655:       }
 6656:     
 6657: 
 6658: 
 6659:       // Compute vegetation parameters
 6660:       //--------------------------------
 6661: 
 6662: 
 6663:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6664:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6665: 
 6666:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6667:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6668:          int kbin = 0; // bin index
 6669:          for (int k = kb; k < nvrt; k++) {
 6670:             // Computes node height above the bottom level
 6671:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6672:             assert(false && "Vertical variation of vegetation not implemented");
 6673: 
 6674:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6675:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6676:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6677:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6678:             // } else {
 6679:             //    // Find the bin at which the current vertical level is
 6680:             //    while (kbin<nbins_veg_vert) {
 6681:             //       const double zn = node->z[kbin];
 6682:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6683:             //          break;
 6684:             //       } // if
 6685:             //       kbin++;
 6686:             //    } // while
 6687:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6688: 
 6689:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6690:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6691:                
 6692:             //    // Linear interpolation of the vegetation parameters
 6693:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6694:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6695:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6696:             // } // if rl10
 6697: 
 6698:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6699: 
 6700:          } // for k
 6701: 
 6702: 
 6703:       } else { // Ganthy (iveg==2)
 6704:       //  Modify canopy height, diameter, and density
 6705: 
 6706:          // Make sure there is vegetation on this node
 6707:          if (node->veg_h_unbent > 0.0) {
 6708:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6709: 
 6710:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6711:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6712:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6713: 
 6714:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6715:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6716:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6717:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6718:          } // if veg_h_unbent
 6719: 
 6720:          for (int k = 0; k < nvrt; k++) {
 6721:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6722:          } // for k
 6723:       
 6724: 
 6725:       } // if iveg
 6726:      
 6727: 
 6728:       // Compute vertical mean of veg_alpha3D
 6729:       if (iveg != 0) {
 6730:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6731:          double sum1=0.0;
 6732:          double sum2=0.0;
 6733:          // Integrate over each level under the canopy...
 6734:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6735:             const double Dz = node->Dz(k);
 6736: 
 6737:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6738:             sum2 += Dz;
 6739: 
 6740:          } // for k
 6741:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6742:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6743: 
 6744:       } // if iveg
 6745: 
 6746:    }
 6747: 
 6748: 
 6749:    __global__ void computeTurbulence(void) {
 6750: 
 6751:       NODE(node);
 6752: 
 6753:       // Calls the templated function to compute the turbulence model parameters.
 6754:       // turbulenceModel is just a class enum version of itur.
 6755:       computeTurbulenceModel<turbulenceModel>(node);
 6756:       
 6757:    }
 6758: 
 6759: 
 6760:    __global__ void computeVegetationAndDragParameters(void) {
 6761:       // Computes the vegetation and drag model parameters:
 6762:       // chi, \tilde\chi, beta, \breve{H}
 6763:       
 6764:       SIDE(side);
 6765: 
 6766:       side->hhat = 0.0;
 6767:       side->chi2 = 0.0;
 6768:       side->chi = 0.0;
 6769:       side->veg_c2 = 0.0;
 6770:       side->veg_beta = 0.0;
 6771: 
 6772:       if (side->isDry) return;
 6773: 
 6774:       const double htot = side->htot2();
 6775:       const int    kb   = side->kb;
 6776: 
 6777:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6778: 
 6779:       const double veg_h     = side->veg_h();
 6780:       const double veg_nv    = side->veg_nv();
 6781:       const double veg_c     = side->veg_c();
 6782:       const double veg_beta  = side->veg_beta;
 6783:       const double veg_alpha = side->veg_alpha_vert_mean();
 6784: 
 6785:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6786:       // Velocity magnitude at the bottom level
 6787:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6788:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6789:       side->chi2 = side->Cd()*vmag1;
 6790:       side->chi  = side->chi2;
 6791: 
 6792:       if constexpr(iveg != 0) {
 6793:          const Node *n1 = side->n1;
 6794:          const Node *n2 = side->n2;
 6795:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6796:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6797:       }
 6798: 
 6799:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6800: 
 6801:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6802:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6803:       double magUa = 0.0;
 6804:       if constexpr(iveg != 0) {
 6805:          if (side->is3D() && veg_h > 0.0) {
 6806:             // 3D wet side with veg...
 6807: 
 6808:             double magUa = 0.0;
 6809:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6810:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6811: 
 6812:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6813:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6814:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6815: 
 6816:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6817:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6818: 
 6819:                   // Velocity magnitude at the bottom (l) of the level
 6820:                   const double ul = length(side->u2[k]);
 6821: 
 6822:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6823:                   magUa += Dz*0.5*(uh + ul);
 6824: 
 6825:                } // if HasVegetation
 6826:             } // for k
 6827:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6828: 
 6829:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6830:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6831:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6832:                const double zCpy = side->zTopCanopy();
 6833:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6834:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6835:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6836:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6837:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6838:             } // if isSubmerged
 6839:          } // if is3D
 6840:       } // if iveg   
 6841: 
 6842:       // Computes the friction modified depth, \breve{H} in notes
 6843:       if (side->is2D()) { // 2D
 6844: 
 6845:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6846:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6847: 
 6848:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6849: 
 6850:          side->hhat = htot*htot/fricH; 
 6851: 
 6852:       } else { // 3D
 6853:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6854: 
 6855:          if constexpr(iveg != 0) {
 6856:             
 6857:             if (side->isSubmerged()) { 
 6858:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6859:                side->hhat -= veg_c*Hhat_alpha;
 6860: 
 6861:             } else { // Emergent
 6862:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6863:             }
 6864:          } // if iveg
 6865: 
 6866:          // Enforce positivity for 3D model
 6867:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6868:       } // if 3D
 6869: 
 6870:    }
 6871: 
 6872: 
 6873: 
 6874:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6875:    // Computes the density gradient between two elements, e1 and e2.
 6876:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6877:    // zero in the direction normal to the side. 
 6878:    // 
 6879:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6880:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6881:    //
 6882:    // Input:
 6883:    //    e1: Element
 6884:    //    e2: Neighbor element (or nullptr if boundary)
 6885:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6886:    //    k: Index of the half-level at which the density is interpolated
 6887:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6888:    // 
 6889:    // Output:
 6890:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6891:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6892: 
 6893:       if (e2 == nullptr || e2->isDry) {
 6894:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6895: 
 6896:          Side *side = e1->sides[j];
 6897:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6898:                  
 6899:          if constexpr(ics == 1) {
 6900:             vec = side->n; // Normal vector to the side
 6901:          } else {
 6902:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6903:             // IMPLEMENT THIS XXXXXX
 6904:             // !replace with xel, yel?
 6905:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6906:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6907:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6908:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6909:          } //ics
 6910:                    
 6911:          diffRho = 0.0;
 6912: 
 6913:       } else { //internal and wet
 6914:          if constexpr(ics==1) {
 6915:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6916: 
 6917:             // Vector from e1 to e2
 6918:             vec = e2->center - e1->center;
 6919: 
 6920:          } else { 
 6921:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6922:             // Remember that elem->center is in global coordinates
 6923:             // IMPLEMENT THIS XXXXXX
 6924:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6925:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6926:             //                   alow(j)=xctr2
 6927:             //                   bdia(j)=yctr2
 6928:          } // ics
 6929: 
 6930:          diffRho = rho2 - e1->demeanedDensity(k);
 6931:       }
 6932: 
 6933:    }
 6934: 
 6935:    __global__ void computeDensityCubicSplines(void) {
 6936:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6937: 
 6938:       ELEM(elem);
 6939: 
 6940:       if (elem->isDry) return;
 6941: 
 6942:       const int kb = elem->kb;
 6943: 
 6944:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6945:       if (elem->is2D()) {
 6946:          // In the 2D case, the density is constant at the prism level. 
 6947:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6948:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6949:       } else { //3D
 6950: 
 6951:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6952:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6953:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6954:          ///// XXXX CHECK INDICES!!!!!
 6955:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6956:       } // 2D/3D
 6957: 
 6958:    }
 6959: } // extern "C"
 6960: 
 6961: 
 6962: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6963: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6964: 
 6965:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6966: 
 6967:    const int kb  = elem->kb;
 6968:    const int kb2 = elem2->kb;
 6969: 
 6970:    // z-coordinate of prism of elem
 6971:    const double zp = elem->z_prism(k);
 6972: 
 6973:    double rho = 0.0;
 6974: 
 6975:    if (elem2->is2D()) {
 6976:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6977: 
 6978:    } else {  // 3D
 6979: 
 6980:       // eta_min may be < zmax
 6981:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6982:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6983: 
 6984:       // (Extrapolate density below bottom, we will fix it later)
 6985:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6986:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6987:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6988:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6989:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6990:    } // 2D/3D
 6991:      
 6992: 
 6993:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6994:    // Now we need to fix it.
 6995:    if (elem->z[k] < elem2->z[kb2]) {
 6996:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6997: 
 6998:       // There are two methods to adjust the density at the bottom of the element.
 6999:       // iunder_deep=0: 
 7000:       const double depth1 = abs(elem->z[kb]); // larger depth
 7001: 
 7002:       if (iunder_deep==0) {
 7003: 
 7004:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7005: 
 7006:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7007: 
 7008:       } else { // iunder_deep != 0
 7009: 
 7010:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7011: 
 7012:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7013: 
 7014:          //   Demeaned density at the same z coordinate as
 7015:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7016:          }
 7017: 
 7018:       } // if iunder_deep
 7019:    } // if elem->z[kb] < elem2->z[kb]
 7020: 
 7021:    return rho;
 7022: }
 7023: 
 7024: 
 7025: extern "C" {
 7026:    __global__ void computeDensityGradient(void) {
 7027: 
 7028:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7029:       if constexpr(ibc != 0) return;
 7030: 
 7031:          // Compute the horizontal density gradient at each element.
 7032:       // It works in two steps:
 7033:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7034:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7035:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7036:       //             gradRho.r1 = rho1 - rho0
 7037:       //             gradRho.r2 = rho2 - rho0
 7038:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7039:       // 
 7040:       //  NOTE: We use de-meaned densities.
 7041: 
 7042:       ELEM(elem);
 7043: 
 7044:       if (elem->isDry) return;
 7045: 
 7046:       const int kb  = elem->kb;
 7047:       const int i34 = elem->i34;
 7048: 
 7049:       for (int k = kb + 1; k < nvrt; k++) {
 7050:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7051:          //             gradRho.r1 = rho1 - rho0
 7052:          //             gradRho.r2 = rho2 - rho0
 7053:          int icount = 0;
 7054:          double sumRx = 0.0;
 7055:          double sumRy = 0.0;
 7056:          for (int j1=0; j1<i34; j1++) { 
 7057: 
 7058:             const int j2 = elem->nxq(j1 + 1);
 7059: 
 7060:             // Pairs of consecutive neighbor elements of elem
 7061:             const Element *e1 = elem->nghbElems[j1];
 7062:             const Element *e2 = elem->nghbElems[j2];
 7063: 
 7064:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7065:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7066:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7067: 
 7068:             // Compute the density difference and the vector from elem to e1 and e2
 7069:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7070:             double diffRho1, diffRho2;
 7071:             Vector2 vec1, vec2;
 7072:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7073:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7074: 
 7075:             const double rl1 = length(vec1);
 7076:             const double rl2 = length(vec2);
 7077:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7078: 
 7079:             const double delta = cross(vec1, vec2);
 7080:             const double sintheta = abs(delta)/(rl1*rl2);
 7081: 
 7082:             // To avoid problems, avoid elements with small angle between vectors
 7083:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7084:             const bool validEq = (sintheta > sin_one_deg);
 7085: 
 7086:             if (validEq) {
 7087:                // Solve the system of equations to get the density gradient at elem
 7088:                icount++;
 7089:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7090:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7091:                sumRx += Rx;
 7092:                sumRy += Ry;
 7093:             }
 7094:          } // for j1
 7095: 
 7096:          // Compute the average density gradient at elem
 7097:          if (icount==0) {
 7098:            // Bad mesh quality; bail out with 0 b-cc
 7099:            elem->gradRho[k] = {0.0, 0.0};
 7100:          } else {
 7101:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7102:          }
 7103: 
 7104:       } // for k
 7105: 
 7106:    }
 7107: 
 7108:    __global__ void computeBaroclinicTerm(void) {
 7109:    // Computes the baroclinic term at sides (at half levels).
 7110:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7111:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7112: 
 7113:       if (ibc == 1) return;
 7114: 
 7115:       SIDE(side);
 7116: 
 7117:       if (side->isDry) return;
 7118: 
 7119:       const Element *e1 = side->elems[0];
 7120:       const Element *e2 = side->elems[1]; 
 7121:       const int kb = side->kb;
 7122:       
 7123:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7124: 
 7125:       // interpolates vertically the density gradient of the two elements at the half level/
 7126: 
 7127:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7128:       int k2 = max(kb, nvrt / 2);
 7129: 
 7130:       // Starts the integration at the surface and goes down to the bottom
 7131:       side->bcc[nvrt-1] = {0.0, 0.0};
 7132:       for (int k = nvrt - 2; k >= kb; k--) {
 7133:       // For each prism level (from surface to bottom)...
 7134: 
 7135:          // For both elements, interpolate density gradient at the side's half level.
 7136:          // The gradient at the side is the average of the gradients at the elements.
 7137:          // w1, w2 are used to take into account boundary sides, with just one element.
 7138:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7139:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7140:          const double wsum = w1 + w2;
 7141:          w1 = w1/wsum;
 7142:          w2 = w2/wsum;
 7143:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7144: 
 7145:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7146:          Vector2 gradRho = {0.0, 0.0};
 7147:          if (e1 != nullptr && k > kb) {
 7148:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7149:             
 7150:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7151:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7152:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7153: 
 7154:             // Grad(rho) vertically interpolated at the side's half level
 7155:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7156: 
 7157:             // Projects the element density gradient to the side frame if needed.
 7158:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7159: 
 7160:             // Adds the contribution of the density gradient at the side's half level
 7161:             gradRho += gradRho1*w1;
 7162:          }      
 7163:          if (e2 != nullptr && k > kb) {
 7164:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7165:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7166:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7167:             
 7168:             // Grad(rho) vertically interpolated at the side's half level
 7169:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7170: 
 7171:             // Projects the element density gradient to the side frame if needed.
 7172:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7173: 
 7174:             // Adds the contribution of the density gradient at the side's half level
 7175:             gradRho += gradRho2*w2;
 7176:          }
 7177: 
 7178:          
 7179:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7180:          // multiplied by -rampbc*(g/rho0) 
 7181:          const double grav3 = side->grav3();
 7182:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7183: 
 7184:       } // for
 7185: 
 7186:    }
 7187: 
 7188: 
 7189: 
 7190:    __global__ void computeHorGradientAtSide(void) {
 7191: 
 7192:       // Compute the horizontal density gradient at each element.
 7193:       // It works in two steps:
 7194:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7195:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7196:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7197:       //             gradRho.r1 = rho1 - rho0
 7198:       //             gradRho.r2 = rho2 - rho0
 7199:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7200:       // 
 7201:       //  NOTE: We use de-meaned densities.
 7202: 
 7203:       SIDE(side);
 7204: 
 7205: 
 7206:       if (side->isDry) return;
 7207: 
 7208:       // Computes the gradient of the variables at the side center.
 7209:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7210:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7211:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7212: 
 7213:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7214:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7215:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7216:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7217: 
 7218:    }
 7219: 
 7220: 
 7221:    __global__ void solveMomentumEquations(double time) {
 7222: 
 7223:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7224:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7225: 
 7226:       SIDE(side);
 7227: 
 7228:       if (side->isDry) 
 7229:       {
 7230:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7231: 
 7232:          return;
 7233:       }
 7234: 
 7235:       const Node *n1 = side->n1;
 7236:       const Node *n2 = side->n2;
 7237: 
 7238:       const int kb = side->kb;
 7239: 
 7240:       const double veg_h = side->veg_h();
 7241:       const double grav3 = side->grav3();
 7242: 
 7243:       if (side->is2D()) {
 7244:          // Remember: Do not use htot2, which is updated.
 7245:          const double htot = side->htot1();
 7246:          const double hhat = side->hhat;
 7247: 
 7248:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7249: 
 7250:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7251:          const Vector2 tau2 = side->tau();
 7252: 
 7253:          // hat_gam has units of m/s
 7254: 
 7255:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7256:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7257:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7258: 
 7259:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7260: 
 7261: 
 7262:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7263: 
 7264:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7265: 
 7266:       }
 7267:       else { // 3D
 7268: 
 7269:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7270:          // 
 7271:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7272:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7273:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7274:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7275:          // k+1 and k.
 7276: 
 7277: 
 7278:          const int ndim = nvrt - kb;
 7279:          const double zTopCanopy = side->zTopCanopy();
 7280: 
 7281:          // Initialize the tridiagonal system
 7282:          for (int k = kb + 1; k < nvrt; k++) {
 7283:             
 7284:             const int kin = k - (kb + 1);
 7285: 
 7286:  
 7287:             alow[kin] = 0.0;
 7288:             cupp[kin] = 0.0;
 7289:             bdia[kin] = 0.0;
 7290: 
 7291:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7292:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7293: 
 7294:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7295:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7296:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7297: 
 7298:             // First part: layers k, k+1
 7299:             if (k < nvrt - 1) {
 7300:                              
 7301:                if constexpr(iveg != 0) {
 7302: 
 7303:                   // If there is vegetation at this level...
 7304:                   if (zTopCanopy > side->zc[k]) {
 7305:                      // If the canopy is above the k layer...
 7306:                      
 7307:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7308:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7309:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7310:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7311: 
 7312:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7313:                      const double vmag2 = length(ut2);
 7314:                      const double vmag1 = length(side->u2[k]);
 7315:                      const double vmag = 0.5*(vmag1 + vmag2);
 7316:                      
 7317:                      // Computes the vegetation alpha at the face center
 7318:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7319: 
 7320:                      cff1 += veg_alpha_sd*dt*vmag;
 7321: 
 7322:                   } // if (zTopCanopy
 7323:                } // if iveg
 7324: 
 7325:                const double dzz = side->Dz(k + 1);
 7326:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7327:                const double tmp = dt*dfz/dzz;
 7328:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7329: 
 7330:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7331:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7332:             }
 7333: 
 7334: 
 7335:             // Second part: layers k-1, k
 7336:             if (k > kb + 1) {
 7337: 
 7338:                double cff1 = 1.0; //init \bar{c^k}
 7339: 
 7340:                if constexpr(iveg != 0) {
 7341:                   // If there is vegetation at this level...
 7342:                   if (zTopCanopy > side->zc[k-1]) {
 7343:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7344:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7345: 
 7346:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7347: 
 7348:                      const double vmag2 = length(ut2);
 7349:                      const double vmag1 = length(side->u2[k-1]);
 7350:                      const double vmag = 0.5*(vmag1 + vmag2);
 7351: 
 7352:                      // Computes the vegetation alpha at the face center
 7353:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7354:                      cff1 += veg_alpha_sd*dt*vmag;
 7355:                   } // if zTopCanopy
 7356: 
 7357:                } // if iveg
 7358: 
 7359:                const double dzz = side->Dz(k);
 7360:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7361:                const double tmp = dt*dfz/dzz;
 7362:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7363: 
 7364:                alow[kin] += cff1*dzz/6.0 - tmp;
 7365:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7366: 
 7367:             } else { // Bottom boundary
 7368:                // This occurs at the bottom, where the bottom drag is applied.
 7369: 
 7370:                bdia[kin] += dt*side->chi2; // XXXX
 7371: 
 7372:             } // if (k > kb + 1)
 7373: 
 7374: 
 7375:          } // for (int k
 7376: 
 7377: 
 7378: 
 7379:          // Computes the RHS.
 7380:          // -----------------
 7381: 
 7382:          //	BC to be imposed at the end.
 7383: 
 7384:          const Vector2 gradETP  = side->gradETP;
 7385:          const Vector2 gradPr   = side->gradPr;
 7386:          const Vector2 gradEta1 = side->gradEta1;
 7387:          const Vector2 gradEta2 = side->gradEta2;
 7388: 
 7389:          const Vector2 *btu = side->btu;
 7390:          const Vector2 *u2  = side->u2;
 7391:          const double coriolis = side->coriolis;
 7392:          const Vector2 *nuGradU = side->nuGradU;
 7393: 
 7394:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7395:          for (int k = kb + 1; k < nvrt; k++) {
 7396:             const int kin = k - kb - 1;
 7397: 
 7398:             const double dz_0 = side->Dz(k);
 7399:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7400: 
 7401:             rrhs[kin] = {0.0, 0.0};
 7402:             double dz = 0.0;
 7403: 
 7404:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7405:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7406:             if (k < nvrt  ) dz += dz_1;
 7407:             if (k > kb + 1) dz += dz_0;
 7408: 
 7409:             // Elevation gradient, atmospheric pressure and tidal potential
 7410:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7411: 
 7412:             // Coriolis, advection, wind stress, and horizontal viscosity
 7413:             if (k < nvrt - 1) {
 7414: 
 7415: 
 7416:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7417:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7418:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7419:                                                 
 7420: 
 7421:                //diff stress tensors 1006
 7422:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7423:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7424:                   assert(false && "Not implemented: itur == 5");
 7425:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7426:                }
 7427:                // else assert(false && "itur # Not implemented");
 7428: 
 7429:             } else { // k == nvrt - 1 SURFACE
 7430:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7431:                const Vector2 tau2 = side->tau();
 7432: 
 7433:                rrhs[kin] += dt*tau2;          
 7434: 
 7435:             } // if k<nvrt
 7436: 
 7437: 
 7438:             if (k > kb + 1) {
 7439:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7440:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7441:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7442: 
 7443:                // diff stress tensors 1006
 7444:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7445:                   assert(false && "Not implemented: itur == 5");
 7446:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7447:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7448:                }
 7449:                // else assert(false && "itur # Not implemented");
 7450: 
 7451: 
 7452:             } // if k>kbs + 1
 7453: 
 7454:             // Baroclinic
 7455:             Vector2 *bcc = side->bcc;
 7456:             if constexpr(ibc == 0) {
 7457:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7458:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7459: 
 7460:             } // if ibc==0
 7461: 
 7462:          } // k=kb + 1,nvrt
 7463: 
 7464: 
 7465:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7466: 
 7467:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7468:             const int kin = k - kb - 1;
 7469:    
 7470:             // Velocity is always clamped to maximum values
 7471:             side->u2[k] = clampVelocity(soln[kin]);
 7472:          } // k
 7473: 
 7474:       } // if side->is2D()
 7475:       
 7476: 
 7477:       // Impose velocity boundary condition at the bottom
 7478:       if constexpr(imm == 2) { // 3D bed deformation model
 7479:          double dep;
 7480:          Vector2 vel;
 7481: 
 7482:          assert(false && "Not implemented: imm == 2");
 7483:          //update_bdef(time, x0, y0, dep, vel);
 7484:          // side->u2[kb] = vel;
 7485: 
 7486:       } else { // imm = 0 or 1
 7487:          if (side->Cd() == 0.0) {
 7488:             side->u2[kb] = side->u2[kb + 1];
 7489: 
 7490:          } else if (side->is3D()) { // 3D no slip bottom   
 7491:             side->u2[kb] = {0.0, 0.0};
 7492: 
 7493:          }
 7494:           
 7495:       } // if imm
 7496: 
 7497:       // The velocities below the bottom level are set to zero
 7498:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7499: 
 7500: 
 7501:    }
 7502: 
 7503: 
 7504:    __global__ void applyMomentumBC(void) {
 7505: 
 7506:       SIDE_BND(sideBnd);
 7507: 
 7508:       Side *side = sideBnd->side;
 7509:       const BoundarySegment *segment = sideBnd->segment;
 7510:       const Node *n1 = side->n1;
 7511:       const Node *n2 = side->n2;
 7512: 
 7513:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7514: 
 7515:       const bool isLand = segment->isLand;
 7516:       const int ifltype = segment->ifltype;
 7517: 
 7518:       const int kb = side->kb;
 7519: 
 7520: 
 7521:       if (!isLand && ifltype != 0) {
 7522:          const Vector2 *ubc = sideBnd->ubc;
 7523:   
 7524:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7525:             
 7526:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7527:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7528: 
 7529:             if (ifltype == -1) {
 7530:                // Flather 1
 7531: 
 7532:                const double depth = side->depth();
 7533: 
 7534:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7535: 
 7536:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7537: 
 7538:                side->u2[k] = vnorm*side->n;
 7539: 
 7540:             } else if (ifltype == -2) { // Discharge
 7541: 
 7542:                const double eta1 = side->eta1();
 7543:                const double eta2 = side->eta2();
 7544:                const double htot = side->htot2();
 7545: 
 7546:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7547:                assert(false && "Not implemented: Discharge bc");
 7548:                // const double dischrg = discharge(eta1);
 7549:                const double dischrg = 0.0; // XXX REMOVE
 7550:                
 7551: 
 7552:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7553: 
 7554:                const double vnorm = dischrg*eta2/htot;
 7555: 
 7556:                side->u2[k] = vnorm*side->n;
 7557: 
 7558:             }
 7559:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7560:                const double vnorm = dot(side->u2[k], side->n);
 7561: 
 7562:                double rat;
 7563:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7564:                else              rat = segment->vobc2; // outgoing
 7565: 
 7566:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7567: 
 7568:             }
 7569:             else { // not Flather or 3D radiation
 7570: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7571:                side->u2[k] = ubc[k];
 7572: 
 7573:             } // if (segment->ifltype...
 7574: 
 7575:          }
 7576: 
 7577:       }
 7578:       else if (isLand) { // if it is land boundary side
 7579: 
 7580:          if constexpr(islip == 0) { // free slip
 7581: 
 7582:             for (int k = kb; k < nvrt; k++) {
 7583: 
 7584:                const Vector2 t = side->t();
 7585:                const Vector2 n = side->n;
 7586: 
 7587:                double vnorm = 0.0; // for most cases
 7588:                const double vtan = dot(side->u2[k], t);
 7589:                
 7590:                side->u2[k] = vtan*t - vnorm*n;
 7591: 
 7592:             }
 7593: 
 7594:          } else { // no slip
 7595:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7596: 
 7597:          }
 7598:       } // if (side segment type...
 7599: 
 7600:    }
 7601: 
 7602: 
 7603:    __global__ void shapiroFilter1(void) {
 7604:       // First step of the Shapiro filter (normally used if indvel<=0)
 7605:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7606: 
 7607:       SIDE(side);
 7608: 
 7609:       // Only internal wet sides are processed
 7610:       if (side->isDry || !(side->isInternal())) return;
 7611: 
 7612:       const int kb = side->kb;
 7613: 
 7614:       for (int mm = 0; mm < niter_shap; mm++) {
 7615: 
 7616:          for (int k = kb + 1; k < nvrt; k++) {
 7617:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7618:             Vector2 suru = {0.0, 0.0};
 7619: 
 7620:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7621: 
 7622:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7623: 
 7624:                int kin = k;
 7625:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7626:                
 7627:                // Get the velocity at the neighbor's side.
 7628:                Vector2 nSideU2 = nSide->u2[kin];
 7629: 
 7630:                // Projects the velocity to the current side frame if needed.
 7631:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7632: 
 7633:                suru += nSideU2;
 7634:             }
 7635: 
 7636:             // Reusing bcc as a temporary array to store the suru values.
 7637:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7638: 
 7639:          }
 7640:       }
 7641:    }
 7642: 
 7643:    __global__ void shapiroFilter2(void) {
 7644:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7645: 
 7646:       SIDE(side);
 7647: 
 7648: 
 7649:       if (side->isDry || !(side->isInternal())) return;
 7650: 
 7651:       const int kb = side->kb;
 7652: 
 7653:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7654: 
 7655:       if (side->is2D()) {
 7656:          side->u2[kb + 1] = side->bcc[kb + 1];
 7657:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7658: 
 7659:       } else {
 7660:          // 3D
 7661:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7662:          
 7663:       }
 7664: 
 7665:    }
 7666: 
 7667: 
 7668:    __global__ void ul0UpdateZCoords(void) {
 7669:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7670:       
 7671:       NODE(node);      
 7672: 
 7673: 
 7674:       if (false) { //node->isDry) { XXXXXXX
 7675: 
 7676:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7677: 
 7678:          if constexpr(ivcor != 1) node->kb = 0;
 7679: 
 7680:       } else {
 7681: 
 7682:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7683:          node->updateKb();
 7684: 
 7685:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7686: 
 7687:       }
 7688: 
 7689:       // We use the temp.b field to store the previous state of isDry.
 7690:       node->tmp.b = node->isDry;
 7691: 
 7692:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7693:       node->isDry = true;
 7694: 
 7695:    }
 7696: 
 7697:    __global__ void ul0ComputeDryElements(void)
 7698:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7699:    {
 7700:       ELEM(elem);
 7701: 
 7702:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7703: 
 7704:       elem->kb = 0;
 7705: 
 7706:       if (elem->isDry) return;
 7707: 
 7708: 
 7709:    //    if(elem->isDry2()) { // XXXX
 7710:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7711:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7712:    //        call parallel_abort(errmsg)
 7713:    //    }
 7714: 
 7715:       const Node *n1 = elem->nodes[0];
 7716:       const Node *n2 = elem->nodes[1];
 7717:       const Node *n3 = elem->nodes[2];  
 7718:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7719: 
 7720:       // Computes element's kb as the minimum of the nodes' kb.
 7721:       const int kb1 = n1->kb;
 7722:       const int kb2 = n2->kb;
 7723:       const int kb3 = n3->kb;
 7724:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7725: 
 7726: 
 7727:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7728: 
 7729: 
 7730:       // Computes the element z as the mean of the nodes z.
 7731:       for (int k = elem->kb; k < nvrt; k++) {
 7732: 
 7733:          // Compute the element z as the mean of the nodes z.
 7734:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7735:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7736:          elem->z[k] /= elem->i34;
 7737: 
 7738:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7739:       }
 7740:                   
 7741:    }
 7742: 
 7743:    __global__ void ul0ComputeDryNodes(void)
 7744:    // Updates node's isDry based on the elements' isDry. 
 7745:    {
 7746:       NODE(node);
 7747: 
 7748:       node->isDry = true;
 7749: 
 7750:       // A node is wet if at least one of the elements sharing it is wet.
 7751:       for (int j = 0; j < node->numElements; j++) {
 7752:          const Element *elem = node->elements[j];
 7753:          if (!elem->isDry) {
 7754:             node->isDry = false;
 7755:             break;
 7756:          }
 7757:       }
 7758: 
 7759:        
 7760:    }
 7761: 
 7762: 
 7763:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7764:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7765:    // node->tmp.b is true if the node was previously dry.
 7766:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7767:    {
 7768:       NODE(node);
 7769:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7770: 
 7771:       // Avoid this the first time step.
 7772:       if (it == iths) return;  
 7773: 
 7774:       const bool wasDry = node->tmp.b;
 7775: 
 7776: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7777: 
 7778:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7779: 
 7780:          for (int k=0; k < nvrt; k++) {
 7781: 
 7782:             Vector3 utmp={0.0, 0.0, 0.0};
 7783: 
 7784:             double ttmp=0.0;
 7785:             double stmp=0.0;
 7786:             int icount=0;
 7787:             for (int j = 0; j < node->numNodes; j++) {
 7788: 
 7789:                const Node *nbrNode = node->nodes[j];
 7790:                
 7791:                const bool wasNbrDry = nbrNode->tmp.b;
 7792: 
 7793:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7794:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7795: 
 7796:                   icount++;
 7797: 
 7798:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7799:                   utmp += nbrNode->uvw2(k);
 7800:                   
 7801:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7802:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7803:                }
 7804:             }
 7805: 
 7806:             if (icount > 0) {
 7807:                const double inv_icount = 1.0/icount;
 7808:                utmp = inv_icount*utmp;
 7809:                node->u2[k]     = {utmp.x, utmp.y};
 7810:                node->w2[k]     = utmp.z;
 7811:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7812:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7813:             } else {
 7814:                node->u2[k] = {0.0, 0.0};
 7815:                node->w2[k] = 0.0;
 7816:                // Initialize tracers to 0.0??? XXXXX
 7817:             }
 7818:          }
 7819:       }
 7820:    }
 7821: 
 7822:   
 7823:    
 7824: 
 7825: 
 7826:    __global__ void ul0UpdateSides(int it, int iths) {
 7827:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7828:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7829:    // The dryness of the sides is updated in ul0UpdateSides2.
 7830: 
 7831:       SIDE(side);
 7832: 
 7833:       // A side is wet if and only if at least one of its elements is wet.
 7834:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7835:  
 7836:       const Node *n1 = side->n1;
 7837:       const Node *n2 = side->n2;
 7838:      
 7839:       const int kb1 = n1->kb;
 7840:       const int kb2 = n2->kb;
 7841: 
 7842:       side->kb = 0; // default when dry
 7843: 
 7844:       if (isWet) {
 7845: 
 7846:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7847: 
 7848:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7849: 
 7850:          side->kb = min(kb1, kb2);
 7851: 
 7852:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7853: 
 7854:          for (int k = side->kb; k < nvrt; k++) {
 7855:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7856: 
 7857:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7858: 
 7859:             // Compute velocity for re-wetted sides 
 7860:             if ((it != iths) && (side->isDry && isWet)) {
 7861: 
 7862:                Vector2 utmp={0.0, 0.0};
 7863: 
 7864:                int icount=0;
 7865: 
 7866:                // For all the sides on the two elements that share this side
 7867:                for (int j = 0; j < 2; j++) {
 7868:                   const Element *elem = side->elems[j];
 7869:                   if (elem == nullptr) continue;
 7870: 
 7871:                   for (int jj=0; jj < elem->i34; jj++) {
 7872:                      const Side *nSide = elem->sides[jj];
 7873:                      if (nSide->isDry) continue;
 7874: 
 7875:                      icount++;
 7876:                      utmp += nSide->u2[k];  
 7877:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7878:                   }
 7879:                }
 7880:                   
 7881:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7882:                if (icount > 0)  side->u2[k] = utmp/icount;
 7883:                else             side->u2[k] = {0.0, 0.0};
 7884:                   
 7885:             } // if ((it != iths) && (side->isDry && isWet))
 7886: 
 7887:          } // for k
 7888: 
 7889:       } // if isWet 
 7890:       
 7891: 
 7892: 
 7893:    }
 7894: 
 7895:    __global__ void ul0UpdateSides2(void) {
 7896:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7897:    
 7898:          SIDE(side);
 7899:    
 7900:          const Element *e1 = side->elems[0];
 7901:          const Element *e2 = side->elems[1];
 7902: 
 7903:          // A side is wet if and only if at least one of its elements is wet.
 7904:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7905: 
 7906:          // Update the side's dryness
 7907:          side->isDry = !isWet;
 7908: 
 7909:    }
 7910: 
 7911: 
 7912:    __global__ void zeroNodalVelocities(void) {
 7913:       NODE(node);
 7914: 
 7915:       for (int k = 0; k < nvrt; k++) {
 7916:          node->u2[k]   = {0.0, 0.0};
 7917:          node->w2[k]   = 0.0;
 7918:          node->utmp[k] = {0.0, 0.0};         
 7919:       }
 7920:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7921:    }
 7922:  
 7923: 
 7924:    __global__ void computeNodalVerticalVelocities1(void) {
 7925:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7926:    // Adds the element's vertical velocity times the element's area.
 7927:       ELEM(elem);
 7928: 
 7929:       for (int j = 0; j < elem->i34; j++) {
 7930:          Node *node = elem->nodes[j];
 7931: 
 7932:          for (int k = node->kb; k < nvrt; k++) {
 7933:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7934:          }
 7935:          atomicAdd(&(node->tmp.d), elem->area);
 7936:       }
 7937:    }
 7938: 
 7939:    __global__ void computeNodalVerticalVelocities2(void) {
 7940:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7941:    // Divides by the total area of the elements sharing the    node.
 7942:       NODE(node);
 7943: 
 7944: 
 7945:       const double invArea = 1.0 / node->tmp.d;
 7946:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7947: 
 7948:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7949:    }
 7950: 
 7951: 
 7952:    __global__ void computeNodalHorizontalVelocities1(void) {
 7953: 
 7954:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7955: 
 7956:       ELEM(elem);
 7957: 
 7958:       if (elem->isDry) return;
 7959: 
 7960:       const int kb = elem->kb;
 7961:       const bool isTri = elem->isTri();
 7962: 
 7963:       if constexpr(indvel <= 0) {
 7964:          // Assuming discontinous hvel.
 7965: 
 7966:          if (isTri) { // For triangles
 7967:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7968:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7969:             #pragma unroll
 7970:             for (int j = 0; j < 3; j++) {
 7971:                // For every node of the triangle...
 7972:                Node *node = elem->nodes[j];
 7973: 
 7974:                if (node->isDry) continue;
 7975: 
 7976:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7977:                const Side *s2 = elem->sides[(j + 1) % 3];
 7978:                const Side *s3 = elem->sides[(j + 2) % 3];
 7979: 
 7980:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7981: 
 7982:                atomicAdd(&(node->tmp.i), 1);
 7983: 
 7984:                for (int k = kb; k < nvrt; k++)  {
 7985:                   Vector2 s1u2 = s1->u2[k];
 7986:                   Vector2 s2u2 = s2->u2[k];
 7987:                   Vector2 s3u2 = s3->u2[k];
 7988: 
 7989:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7990:                   if constexpr(ics == 2) {
 7991:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7992:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7993:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7994:                   }
 7995: 
 7996:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7997:                   u = clampVelocity(u);
 7998:                   atomicAdd(&(node->utmp[k].x), u.x);
 7999:                   atomicAdd(&(node->utmp[k].y), u.y);
 8000: 
 8001:                }
 8002: 
 8003:             }
 8004:          }
 8005:          else { // For quads
 8006: 
 8007: 
 8008:             // Compute the bilinear coordinates of the center of each diagonal.
 8009:             double xi, eta;
 8010:             double shp13[4], shp24[4];
 8011:             Point2 x0, x1, x2, x3;
 8012:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8013:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8014:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8015: 
 8016:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 8017:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 8018: 
 8019: 
 8020: 
 8021: 
 8022:             for (int k = kb; k < nvrt; k++) {
 8023: 
 8024:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8025:                Vector2 sideU[4];
 8026:                #pragma unroll
 8027:                for (int j = 0; j < 4; j++) {
 8028:                   Vector2 u = elem->sides[j]->u2[k];
 8029:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8030:                   sideU[j] = u;
 8031:                }
 8032: 
 8033:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8034:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8035: 
 8036:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8037:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8038:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8039:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8040:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8041:                #pragma unroll
 8042:                for (int j = 0; j < 4; j++) {
 8043:                   Node *node = elem->nodes[j];
 8044:                   if (node->isDry) continue;
 8045: 
 8046:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8047:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8048:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8049:                }
 8050:             }
 8051: 
 8052:          }
 8053: 
 8054:       }
 8055:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8056:       
 8057:    }
 8058: 
 8059: 
 8060:    __global__ void computeNodalHorizontalVelocities2(void) {
 8061:       NODE(node);
 8062: 
 8063:       const int nodeCount = node->tmp.i;
 8064: 
 8065:       if (nodeCount == 0) 
 8066:       {
 8067:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8068:          return;
 8069:       }
 8070: 
 8071:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8072:       
 8073:       const int kb = node->kb;
 8074: 
 8075:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8076:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8077:       
 8078:       
 8079:    }   
 8080: 
 8081:  
 8082: 
 8083:    __global__ void resetVelocityOpenBndNodes(void) {
 8084:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8085: 
 8086:       NODE_BND(nodebnd);
 8087: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8088:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8089:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8090:       }
 8091: 
 8092:    }
 8093: 
 8094: 
 8095:    __global__ void setVelocityOpenBndNodes(void) {
 8096:    // For open boundary nodes sets their velocity to the imposed values.
 8097: 
 8098:       SIDE_BND(sidebnd);
 8099: 
 8100:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8101:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8102:          // to its segment to the average of the side velocity.
 8103: 
 8104:          for (int k = 0; k < nvrt; k++) {
 8105:             Node *n1 = sidebnd->side->n1;
 8106:             Node *n2 = sidebnd->side->n2;
 8107: 
 8108: 
 8109:             Vector2 &n1_u2 = n1->u2[k];
 8110:             Vector2 &n2_u2 = n2->u2[k];
 8111: 
 8112:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8113:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8114:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8115:             }
 8116:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8117:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8118:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8119:             }
 8120: 
 8121:          }
 8122: 
 8123:       }
 8124: 
 8125:    }
 8126: 
 8127: 
 8128:    __global__ void computeVerticalVelocity(void) {
 8129:       // Computes the vertical velocity at the (2D) element's centroid.
 8130:       // In this function we will be considering volumetric elements, with side faces and a 
 8131:       // bottom and a top face. We will call them SFs, BF and TF.
 8132:       // It computes the flux coming from BF and the SFs.
 8133:       // If the bed is moving, it takes that into account.
 8134:       // Since water is incompressible, the integral of the velocity times the normal vector
 8135:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8136:       // and the BF is equal to the flux going out from the TF.
 8137:       // TF = - BF - sum(SFs).
 8138:       // It then computes the horizontal velocity at the center of TF.
 8139:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8140:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8141:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8142: 
 8143:       ELEM(elem);
 8144: 
 8145:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8146: 
 8147:       if (elem->isDry) return;
 8148: 
 8149:       const int kb = elem->kb;
 8150:       const bool isTri = elem->isTri();
 8151: 
 8152:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8153: 
 8154:       // Compute the bottom velocity
 8155:       if constexpr(imm != 0) {
 8156:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8157:       }
 8158: 
 8159: 
 8160:       double bottomArea3D;
 8161:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8162: 
 8163:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8164: 
 8165:       double topArea3D;
 8166: 
 8167:       // Bottom face flux
 8168:       double bottomFlux = 0.0;
 8169:       Vector2 u2meanBottom = {0.0, 0.0};
 8170:       const Vector2 gradh = elem->grad2(&Node::depth);
 8171:       if constexpr(imm==2) {
 8172:          Vector3 ubed;
 8173: 
 8174:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8175:          // updateBDEF(ubed);
 8176:      
 8177:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8178: 
 8179:          // elem->w[kb] += ubed.z;
 8180:       }
 8181:       else {
 8182: 
 8183:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8184:   
 8185:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8186:          // in the direction of motion.
 8187:          const double bottomW = - dot(gradh, u2meanBottom);  
 8188:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8189: 
 8190:          // VElocity associated to the bed deformation
 8191:          double bedVelocity = 0.0;
 8192:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8193: 
 8194:          elem->w[kb] = bedVelocity + bottomW; 
 8195: 
 8196:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8197:          
 8198:       } // if imm
 8199: 
 8200:       // Compute w for kb+1 to nvrt-1
 8201:       for (int l = kb; l < nvrt - 1; l++) {
 8202: 
 8203:          // normal vector to the top face of the "volumetric" element (3D)
 8204:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8205: 
 8206:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8207:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8208: 
 8209:          // Compute the total flux at the sides
 8210:          double sideFlux = 0.0;
 8211: 
 8212:          for (int j = 0; j < elem->i34; j++) {
 8213:             const Side *side = elem->sides[j];
 8214:             const int kbs = side->kb;
 8215:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8216:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8217:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8218: 
 8219:             // The area is "clamped" meaning that it takes kb into account.
 8220:             const double sideArea = side->areaClamped(l);
 8221: 
 8222:             const double sign = elem->ssign[j]; 
 8223: 
 8224:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8225:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8226:          }
 8227:          
 8228:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8229:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8230:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8231: 
 8232:          // The flux at the top ace can be computed from the other flows.
 8233:          // All fluxes are in directions into the prism.
 8234:          const double topFlux = - sideFlux - bottomFlux;
 8235: 
 8236:          // Flux at the top face due to the horizontal velocities only
 8237:          // topFlux = topHorizontalFlux + topVerticalFlux
 8238:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8239: 
 8240:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8241:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8242: 
 8243:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8244: 
 8245:          bottomFlux = -topFlux;
 8246:          
 8247:       }
 8248: 
 8249:    }  
 8250: 
 8251: 
 8252: 
 8253: 
 8254: 
 8255: 
 8256: 
 8257: // !===============================================================================
 8258: // !===============================================================================
 8259: 
 8260: } // extern "C"
 8261: 
 8262: #ifdef DONTCOMPILE
 8263: __device__ void computeVerticalAdvection(void) {
 8264:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8265: 
 8266:    sdbt(1:2,:,:)=0.d0
 8267: 
 8268:    const Side *side = FROM kernel;
 8269: 
 8270:    if(side->isDry) return;
 8271: 
 8272:    // If side is wet...
 8273: 
 8274: 
 8275:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8276:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8277:    double ws[nvrt] = {} // w @ side
 8278:    int icount = 0;
 8279:    for (int j=0; j<2; j++) {
 8280:       const Element *elem = side->elements[j];
 8281:        
 8282:       if(elem != nullptr) {
 8283:          icount++;
 8284:          for (int k=0; k<nvrt; k++) {
 8285:             ws[k] = ws[k] + elem->w[k];
 8286:          }
 8287:       }
 8288:    }  // for j
 8289: 
 8290:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8291:    ws = ws/icount;
 8292: 
 8293:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8294:    // Splines allow for a smooth transition between vertical levels.
 8295:    // Splines have continuity restrictions at the internal knots, but
 8296:    // we have to provide the 1st derivatives at the endpoints.
 8297:    const int kbs = side->kbs; 
 8298:    
 8299:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8300:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8301:    initCubicSpline(kbs, nvrt, side, ws, up)
 8302: 
 8303:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8304:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8305:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8306: 
 8307:    // Total advection (average onto side)
 8308:    const Node *node1 = side->nodes[0];
 8309:    const Node *node2 = side->nodes[1];
 8310:    for (int k=kbs(i); k<nvrt; k++) {
 8311: 
 8312:       Vector2 bcc1 = node1->bcc[k];
 8313:       Vector2 bcc2 = node2->bcc[k];
 8314:       if constexpr(ics == 2) {
 8315:          // Project the velocities from the node frames to the side frame
 8316:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8317:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8318:       }
 8319: 
 8320:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8321:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8322: 
 8323:    }
 8324: }
 8325: #endif
 8326: 
 8327: 
 8328: extern "C" {
 8329:    __global__ void computeElemAverageGhat(void) {
 8330:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8331: 
 8332:       ELEM(elem);
 8333:       
 8334:       elem->ghat1= {0.0, 0.0};  
 8335: 
 8336:       if constexpr(ihydraulics != 0) {
 8337:          if (nhtblocks > 0 && elem->isblock) return;
 8338:       }
 8339: 
 8340:       
 8341:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8342:       // cff1-3: coefficients for 2D/3D
 8343: 
 8344:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8345:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8346:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8347: 
 8348:       if (elem->isDry) return;
 8349: 
 8350:       // Average of the coefficients
 8351:       double av_cff1 = 0.0;  // av. for cff1
 8352:       double av_cff2 = 0.0;  // av. for cff2
 8353:       double av_cff3 = 0.0;  // av. for cff3
 8354:       double av_df = 0.0;  // av. for H^\alpha / H
 8355:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8356:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8357: 
 8358:       const int i34 = elem->i34;
 8359:       const int kb  = elem->kb;
 8360: 
 8361:       for (int j=0; j<i34; j++) {
 8362:          // For each node and side in the element...
 8363: 
 8364:          const Node *node = elem->nodes[j];
 8365:          const Side *side = elem->sides[j];
 8366: 
 8367:          const double chi      = side->chi;
 8368:          const double veg_c2   = side->veg_c2;
 8369:          const double veg_beta = side->veg_beta;
 8370:          const double veg_h    = side->veg_h();
 8371:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8372: 
 8373:          const Vector2 gradPhi = elem->gradPhi[j];
 8374: 
 8375:          // Node - const in elem
 8376:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8377:          elem->gradPr  += node->pr  *gradPhi;
 8378: 
 8379:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8380: 
 8381:         
 8382:          const double htot  = side->htot2();        // Total depth at the side
 8383:          const double zctr2 = side->zTopCanopy();  
 8384: 
 8385:          double cff1; 
 8386:          double cff2; 
 8387:          double cff3;   
 8388:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8389:          // coefficients applied to 2D/3D case 
 8390:             cff1 = side->hhat/htot;
 8391:             cff2 = 0.0;
 8392:             cff3 = 0.0;
 8393:          } else { //3D
 8394:             //Init for no-veg case
 8395:             cff1 = 1.0;
 8396:             cff2 = 1.0;
 8397:             cff3 = 0.0;
 8398: 
 8399:             if constexpr(iveg != 0) {
 8400:                // Computes coefficients used with vegetation terms G1, G2
 8401:                // cff1, cff3 are used for the first two terms in G1, G2:
 8402:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8403:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8404:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8405:                if(veg_h < 0.99*htot) { // submergent vegetation
 8406:                   cff1 = 1.0;
 8407:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8408:                   cff3 = veg_c;
 8409: 
 8410:                } else { // emergent vegetation
 8411:                   cff1 = 1.0/(1.0 + veg_c2);
 8412:                   cff2 = cff1;
 8413:                   cff3 = 0.0;
 8414: 
 8415:                }
 8416:             } // if iveg
 8417:          } //  2D/3D
 8418: 
 8419:          av_cff1 += cff1/i34;
 8420:          av_cff2 += cff2/i34;
 8421:          av_cff3 += cff3/i34;
 8422:          av_cff2_chi += cff2*chi/i34;
 8423:          av_cff3_chi += cff3*chi/i34;
 8424:          av_df += min(htot, veg_h)/(htot*i34);
 8425: 
 8426: 
 8427:          // btrack values: U^\star, U^{\star\alpha}
 8428:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8429:          Vector2 Ustar       = {0.0, 0.0}; 
 8430:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8431: 
 8432:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8433:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8434:          } else { //3D
 8435:             for (int k = side->kb + 1; k < nvrt; k++) {
 8436:             
 8437:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8438:                Ustar += w2;
 8439: 
 8440:                if constexpr(iveg != 0) {
 8441:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8442:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8443:                        Ustar_alpha += zrat*w2; // XXXX
 8444:                    }
 8445:                }  // if iveg
 8446:             }  // for k
 8447:          }  //2D/3D
 8448: 
 8449:          // If needed, project the side velocities to the element frame
 8450:          if constexpr(ics==2) {
 8451:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8452:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8453:          }
 8454:         
 8455: 
 8456:          // Add btrack & surface stress terms to \breve{G} first
 8457:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8458: 
 8459: 
 8460:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8461:          Vector2 tau    = side->tau();  
 8462:          Vector2 ubstar = side->btu[side->kb + 1];  
 8463: 
 8464:          // If needed, project tau and ubstar to the element frame
 8465:          if constexpr(ics==2) {
 8466:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8467:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8468:          }
 8469: 
 8470:          // Term for surface and bottom stress
 8471:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8472: 
 8473: 
 8474:          // All terms in F,F^\alpha,f_b except baroclinic
 8475:          // F, f_b: all explicit terms excluding vegetation 
 8476:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8477:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8478:          const double coriolis = side->coriolis;
 8479:          Vector2 F  =  coriolis*side->U;  // F_x
 8480:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8481:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8482: 
 8483:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8484:             
 8485:             for (int k = side->kb; k < nvrt; k++) {
 8486:                if (zctr2 > side->zc[k-1]) {
 8487:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8488:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8489:                    Fa +=  coriolis*w2*zrat;
 8490:                } // if zctr2
 8491:             } // k
 8492:          } // iveg
 8493: 
 8494:          // Integrate horizontal viscosity force vertically
 8495:          for (int k=side->kb + 1; k<nvrt; k++) {
 8496:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8497: 
 8498:             F += levelHorVisc;
 8499: 
 8500:             // Vegetation term
 8501:             if constexpr(iveg!=0) {
 8502:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8503:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8504:                   Fa += levelHorVisc*zrat;
 8505:                } 
 8506:             } // if iveg
 8507:          } // for k
 8508: 
 8509:          // Get nu*grad(U) at the side's bottom level
 8510:          Vector2 nuGradU = side->nuGradU[side->kb];
 8511: 
 8512:          fb += nuGradU;
 8513: 
 8514:          // If needed, project vectorsF, fb and Fa to the element frame
 8515:          if constexpr(ics==2) {
 8516:             F    = side->frame.projHorVec(F,    elem->frame);
 8517:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8518:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8519:          } // if ics
 8520: 
 8521:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8522:       } // for j (nodes and sides)
 8523: 
 8524:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8525: 
 8526: 
 8527:       // Finish off terms in F, F^\alpha and f_b
 8528:       const double grav3 = elem->mean(&Node::grav2);
 8529:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8530:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8531:       for (int j=0; j<i34; j++) { 
 8532:          // For each side in the element...
 8533:          const Side *side = elem->sides[j];
 8534:          const double chi = side->chi;
 8535: 
 8536:          const double htot = side->htot2();
 8537:          const double veg_h = side->veg_h();
 8538:          const Vector2 F  = htot*fb;
 8539:          const Vector2 Fa = min(htot, veg_h)*fb;
 8540: 
 8541:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8542:       } // for j
 8543: 
 8544:       // tmp is already in elem frame
 8545:       elem->ghat1 += tmp/i34;
 8546: 
 8547:       // Baroclinic force
 8548:       if constexpr(ibc==0) {
 8549:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8550: 
 8551:          Vector2 Fa = {0.0, 0.0};
 8552:          Vector2 intGradRho = {0.0, 0.0};
 8553:          
 8554:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8555:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8556:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8557: 
 8558:             // \in F [m^2/s/s]
 8559:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8560:          }
 8561: 
 8562:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8563:          const Vector2 F = av_df*Fa; //approx
 8564:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8565: 
 8566:       } // if ibc
 8567: 
 8568: 
 8569: 
 8570:    }
 8571: 
 8572: } // extern "C"
 8573: 
 8574: 
 8575: 
 8576: #ifdef DONTCOMPILE
 8577: __global__ void checkMassConservation(Tracers* sumtr) {
 8578: 
 8579:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8580: 
 8581:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8582: 
 8583:    Element *elem = &(mesh->localElemData[i]);
 8584: 
 8585:    // Skip dry elements
 8586:    if (elem->isDry) return;
 8587: 
 8588:    // Local sum array for this thread
 8589:    double localSum[N_TRACERS] = {0.0};
 8590: 
 8591:    // Sum over vertical levels for this element
 8592:    const int kbe = elem->kbe;
 8593:    const double area = elem->area;
 8594: 
 8595:    for (int k = kbe; k < nvrt; k++) {
 8596:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8597:       
 8598:       // Accumulate tracer mass
 8599:       for (int tr = 0; tr < N_TRACERS; tr++) {
 8600:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8601:       }
 8602:    }
 8603: 
 8604:    //  This function returns per element sums. A reduction must be done on the host side.
 8605: }
 8606: 
 8607: 
 8608: __global__ void transport(void) {
 8609: 
 8610:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8611: 
 8612:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8613: 
 8614:    Element *elem = &(mesh->localElemData[ie]);
 8615: 
 8616:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8617: 
 8618:                for (int m=0; m<ntr; m++) {
 8619:                   for (int k=kbe(ie); k<nvrt; k++) {
 8620:                      // Calculate each polynomial's weight 
 8621:                      wm=0.d0; sum1=0.d0; 
 8622:                      wm1=0.d0; wm2=0.d0; 
 8623:                      for (int i=0; i<elem->nweno2; i++) {
 8624:                   
 8625:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8626:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8627:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8628:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8629:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8630:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8631:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8632:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8633:                      // -----------------Hu and Shu (1999)'s method----------------
 8634:                      b4=b1+b2+b3
 8635: 
 8636: //Error: add PRODUCTION CPP
 8637: #ifdef DEBUG
 8638:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8639:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8640:                     call parallel_abort(errmsg)
 8641:                   }
 8642: #endif
 8643: 
 8644:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8645:                   // !----test-------------- 
 8646:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8647:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8648:                   // !wm(i)=wm1(i)*wm2(i)
 8649:                   // !---------------------- 
 8650:                   sum1=sum1+wm(i)
 8651:                 } // end for i
 8652: 
 8653:                 wm=wm/sum1
 8654: 
 8655:                 for (int j=0; j<elem->i34; j++) {
 8656: 
 8657:                   const Side *side  = elem->sides[j];
 8658:                   const Node *node1 = side->n1;
 8659:                   const Node *node2 = side->n2;
 8660: 
 8661:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8662:                      trsd=0.d0
 8663:                      for (int kk=0; kk<nquad; kk++) {
 8664:                         for (int i=0; i<elem->nweno2; i++) {
 8665:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8666:                         } // end for i   
 8667:                      } // end for kk
 8668:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8669:                   } // outward flux
 8670:                } // end for j=1,i34(ie) ! side
 8671:             }
 8672:          }
 8673:               
 8674: 
 8675: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8676: //             //   calculate each polynomial's weight 
 8677: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8678: //                 wm=0.d0; sum1=0.d0
 8679: //                 do i=1,nweno1(ie) !for each polynomial
 8680: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8681: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8682: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8683: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8684: //                   wm(i)=b2
 8685: //                   sum1=sum1+b2
 8686: //                   !wm(i)=1.d0
 8687: //                   !sum1=sum1+1.d0
 8688: 
 8689: // // Error: PRODUCTION
 8690: // #ifdef DEBUG
 8691: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8692: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8693: //                     call parallel_abort(errmsg)
 8694: //                   endif
 8695: // #endif
 8696: 
 8697: //                 enddo !i
 8698: //                 wm=wm/sum1 !final weight
 8699: 
 8700:                 for (int j=0; j<elem->i34; j++) { // side
 8701:                   const Side *side = elem->sides[j];
 8702:                   const Node *node1 = side->n1;
 8703:                   const Node *node2 = side->n2;
 8704: 
 8705:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8706:                     trsd=0.d0
 8707:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8708:                       for (int i=0; i<elem->nweno1; i++) {
 8709:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8710:                       }
 8711:                     enddo //kk
 8712:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8713:                   } // outward flux
 8714:                 } // end for j=1,i34(ie) ! side
 8715:               } // end for k; ntr 
 8716: 
 8717:             else !simple upwind method
 8718:               do j=1,i34(ie)
 8719:                 jsj=elside(j,ie)
 8720:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8721:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8722:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8723:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8724:                   endif
 8725:                 enddo  !vertical layers
 8726:               enddo !j=1,i34(ie) ! side
 8727:             endif !order of accuracy
 8728: 
 8729:          //  enddo !ie
 8730: // !$OMP     end do
 8731: 
 8732: // !$OMP     master
 8733: //           !message passing
 8734: //           if (nproc>1) then
 8735: //             !make a copy of side concentrations
 8736: //             trsd_tmp0=trsd_tmp 
 8737: 
 8738: //             !this exchange routine swaps interface concentration between two partitions
 8739: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 8740: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 8741: 
 8742: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 8743: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 8744: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
