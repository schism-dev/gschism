 8944: #ifdef DONTCOMPILE
 8945: __global__ void checkMassConservation(Tracers* sumtr) {
 8946: 
 8947:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8948: 
 8949:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8950: 
 8951:    Element *elem = &(mesh->localElemData[i]);
 8952: 
 8953:    // Skip dry elements
 8954:    if (elem->isDry) return;
 8955: 
 8956:    // Local sum array for this thread
 8957:    double localSum[ntracers] = {0.0};
 8958: 
 8959:    // Sum over vertical levels for this element
 8960:    const int kbe = elem->kbe;
 8961:    const double area = elem->area;
 8962: 
 8963:    for (int k = kbe; k < nvrt; k++) {
 8964:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8965:       
 8966:       // Accumulate tracer mass
 8967:       for (int tr = 0; tr < ntracers; tr++) {
 8968:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8969:       }
 8970:    }
 8971: 
 8972:    //  This function returns per element sums. A reduction must be done on the host side.
 8973: }  
 8974: 
 8975: 
 8976: __global__ void transport(void) {
 8977: 
 8978:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8979: 
 8980:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8981: 
 8982:    Element *elem = &(mesh->localElemData[ie]);
 8983: 
 8984:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8985: 
 8986:                for (int m=0; m<ntr; m++) {
 8987:                   for (int k=kbe(ie); k<nvrt; k++) {
 8988:                      // Calculate each polynomial's weight 
 8989:                      wm=0.d0; sum1=0.d0; 
 8990:                      wm1=0.d0; wm2=0.d0; 
 8991:                      for (int i=0; i<elem->nweno2; i++) {
 8992:                   
 8993:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8994:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8995:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8996:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8997:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8998:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8999:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 9000:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 9001:                      // -----------------Hu and Shu (1999)'s method----------------
 9002:                      b4=b1+b2+b3
 9003: 
 9004: //Error: add PRODUCTION CPP
 9005: #ifdef DEBUG
 9006:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 9007:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 9008:                     call parallel_abort(errmsg)
 9009:                   }
 9010: #endif
 9011: 
 9012:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 9013:                   // !----test-------------- 
 9014:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 9015:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 9016:                   // !wm(i)=wm1(i)*wm2(i)
 9017:                   // !---------------------- 
 9018:                   sum1=sum1+wm(i)
 9019:                 } // end for i
 9020: 
 9021:                 wm=wm/sum1
 9022: 
 9023:                 for (int j=0; j<elem->i34; j++) {
 9024: 
 9025:                   const Side *side  = elem->sides[j];
 9026:                   const Node *node1 = side->n1;
 9027:                   const Node *node2 = side->n2;
 9028: 
 9029:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 9030:                      trsd=0.d0
 9031:                      for (int kk=0; kk<nquad; kk++) {
 9032:                         for (int i=0; i<elem->nweno2; i++) {
 9033:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9034:                         } // end for i   
 9035:                      } // end for kk
 9036:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9037:                   } // outward flux
 9038:                } // end for j=1,i34(ie) ! side
 9039:             }
 9040:          }
 9041:               
 9042: 
 9043: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 9044: //             //   calculate each polynomial's weight 
 9045: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 9046: //                 wm=0.d0; sum1=0.d0
 9047: //                 do i=1,nweno1(ie) !for each polynomial
 9048: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9049: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9050: //                   b1=b1*b1+b2*b2 !smoothness indicator
 9051: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 9052: //                   wm(i)=b2
 9053: //                   sum1=sum1+b2
 9054: //                   !wm(i)=1.d0
 9055: //                   !sum1=sum1+1.d0
 9056: 
 9057: // // Error: PRODUCTION
 9058: // #ifdef DEBUG
 9059: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 9060: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 9061: //                     call parallel_abort(errmsg)
 9062: //                   endif
 9063: // #endif
 9064: 
 9065: //                 enddo !i
 9066: //                 wm=wm/sum1 !final weight
 9067: 
 9068:                 for (int j=0; j<elem->i34; j++) { // side
 9069:                   const Side *side = elem->sides[j];
 9070:                   const Node *node1 = side->n1;
 9071:                   const Node *node2 = side->n2;
 9072: 
 9073:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 9074:                     trsd=0.d0
 9075:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 9076:                       for (int i=0; i<elem->nweno1; i++) {
 9077:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 9078:                       }
 9079:                     enddo //kk
 9080:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9081:                   } // outward flux
 9082:                 } // end for j=1,i34(ie) ! side
 9083:               } // end for k; ntr 
 9084: 
 9085:             else !simple upwind method
 9086:               do j=1,i34(ie)
 9087:                 jsj=elside(j,ie)
 9088:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 9089:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 9090:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 9091:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 9092:                   endif
 9093:                 enddo  !vertical layers
 9094:               enddo !j=1,i34(ie) ! side
 9095:             endif !order of accuracy
 9096: 
 9097:          //  enddo !ie
 9098: // !$OMP     end do
 9099: 
 9100: // !$OMP     master
 9101: //           !message passing
 9102: //           if (nproc>1) then
 9103: //             !make a copy of side concentrations
 9104: //             trsd_tmp0=trsd_tmp 
 9105: 
 9106: //             !this exchange routine swaps interface concentration between two partitions
 9107: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 9108: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 9109: 
 9110: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 9111: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 9112: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 9113: 
 9114: 
 9115: //             !This obtains final values for interface sides
 9116: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 9117: //       :    endif !nproc>1
 9118: //           !message passing end
