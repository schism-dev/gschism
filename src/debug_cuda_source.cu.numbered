  750:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  751: 
  752:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo) const;
  753:    
  754:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  755: 
  756:    __device__ double intPhiPhi(int i1, int i2) const;
  757: 
  758:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  759: 
  760:    __device__ Vector2 grad2(double *a) const
  761:    {
  762:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  763:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  764:       if (isQuad()) {
  765:          gx += a[3]*gradPhi[3].x;
  766:          gy += a[3]*gradPhi[3].y;
  767:       }
  768:       return {gx, gy};
  769:    }
  770: 
  771:    __device__ Vector2 grad2(double Node::* field) const
  772:    {
  773:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  774:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  775:       if (isQuad()) {
  776:          gx += (nodes[3]->*field)*gradPhi[3].x;
  777:          gy += (nodes[3]->*field)*gradPhi[3].y;
  778:       }
  779:       return {gx, gy};
  780:    }
