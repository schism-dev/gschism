 1806: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1807:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1808: }
 1809: 
 1810: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1811:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1812: }   
 1813: 
 1814: __device__ __inline__ double min3(double a, double b, double c) {
 1815:    return min(a, min(b, c));
 1816: }
 1817: 
 1818: __device__ __inline__ double max3(double a, double b, double c) {
 1819:    return max(a, max(b, c));
 1820: }
 1821: 
 1822: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1823:    return min(a, min(b, min(c, d)));
 1824: }
