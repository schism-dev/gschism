 8010: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8011:    // Get the value of a variable from an element
 8012:    // varName is the name of the variable to get
 8013:    // var is the array to store the value
 8014:    // k is the vertical level index of the variable to get
 8015: 
 8016:    ELEM(elem);
 8017:    
 8018:    int idx = elem->idx;
 8019:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8020: 
 8021:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8022:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8023:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8024:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8025:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8026:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8027:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8028:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8029:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8030:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8031:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8032:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8033:       
 8034:    
 8035: }
 8036: 
 8037: 
 8038: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8039:    // Get the value of a variable from an node
 8040:    // varName is the name of the variable to get
 8041:    // var is the array to store the value
 8042:    // k is the vertical level index of the variable to get
 8043: 
 8044:    NODE(node);
 8045:    
 8046:    int idx = node->idx;
 8047:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8048: 
 8049:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8050:    
 8051:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8052:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8053:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8054:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8055:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8056:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8057:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8058:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8059:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8060:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8061:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8062:    
 8063:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8064:       
 8065:    
 8066: }
 8067: 
 8068: 
 8069: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8070:    // Get the value of a variable from an side
 8071:    // varName is the name of the variable to get
 8072:    // var is the array to store the value
 8073:    // k is the vertical level index of the variable to get
 8074:    SIDE(side);
 8075:    
 8076:    int idx = side->idx;
 8077:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8078: 
 8079:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8080:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8081:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8082:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8083:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8084:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8085:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8086:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8087:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8088:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8089:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8090:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8091:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8092:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8093:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8094:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8095:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8096:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8097:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8098:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8099:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8100:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8101:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8102:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8103:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8104:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8105:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8106:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8107:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8108:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8109:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8110:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8111:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8112:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8113:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8114:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8115: }
 8116: 
 8117: 
 8118: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8119:    // Get the value of a variable from an side
 8120:    // varName is the name of the variable to get
 8121:    // var is the array to store the value
 8122:    // k is the vertical level index of the variable to get
 8123:    SIDE_BND(sideBnd);   
 8124: 
 8125:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8126:    if (sideBnd->segment->isLand) idx = -7;
 8127: 
 8128:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8129:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8130: 
 8131: }
