 3193: 
 3194: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3195:    if constexpr(ics == 1) {
 3196:       return center;
 3197: 
 3198:    } else {
 3199:       const Point2 p0 = n1->outputCoords();
 3200:       const Point2 p1 = n2->outputCoords();
 3201:       return (1.0/2.0)*(p0 + p1);
 3202: 
 3203:    }
 3204: }
 3205: 
 3206: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3207: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3208: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3209: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3210: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3211: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3212: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3213: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3214: // Computes the gradient of the field at the side center.
 3215:    Vector2 grad = {0.0, 0.0};
 3216:    int count = 0;
 3217: 
 3218:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3219:    // as the average of the gradients at each element.
 3220:    // First element
 3221:    if (elems[0] != nullptr && condition(elems[0])) {
 3222:       Vector2 elemGrad = elems[0]->grad2(field);
 3223: 
 3224:       // For ics=2, projects the element gradient from its frame to the side frame
 3225:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3226: 
 3227:       grad += elemGrad;
 3228: 
 3229:       count++;
 3230:    }
 3231: 
 3232:    // Second element
 3233:    if (elems[1] != nullptr && condition(elems[1])) {
 3234: 
 3235:       Vector2 elemGrad = elems[1]->grad2(field);
 3236: 
 3237:       // For ics=2, projects the element gradient from its frame to the side frame
 3238:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3239: 
 3240:       grad += elemGrad;
 3241: 
 3242:       count++;
 3243:    }
 3244: 
 3245:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3246:    if (count > 0) {
 3247:       grad = grad*(1.0/count);
 3248:    }
 3249:    
 3250:    return grad;
 3251: }
 3252: 
 3253: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3254: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3255: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3256: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3257: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3258: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3259: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3260: 
 3261: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3262: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3263: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3264: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3265: 
 3266: 
 3267: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3268: 
 3269: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3270:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3271:    if constexpr(ics == 1) { 
 3272:       return 0.5*(n1->tau + n2->tau);
 3273: 
 3274:    } else {
 3275:       // Project the tau from the node frames to the side frame
 3276:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3277:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3278: 
 3279:       return 0.5*(stau1 + stau2);
 3280:    }
 3281: }
 3282: 
 3283: /**
 3284:  * This method performs backtracking from the side center until a time -dt back in time 
 3285:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3286:  * intermediate point.
 3287:  *
 3288:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3289:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3290:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3291:  * remaining time.
 3292:  * 
 3293:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3294:  * 
 3295:  * @param uuint, vvint, wwint: Velocities at the final point
 3296:  * @param jlev: Level at which the backtracking is performed
 3297:  * @param dt, dtbk: Tracking timesteps
 3298:   */
 3299: __inline__ __device__ void Side::btrack(
 3300:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3301:       double dt,            // Tracking time
 3302:       double dtbk,          // Tracking timestep
 3303:       Vector3 &u_int        // Velocities at the initial point
 3304: ) const {
 3305: 
 3306:    // Start from side center
 3307:    Point3 x0;
 3308: 
 3309:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3310:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3311: 
 3312:  
 3313:    double time_rm = dt; // Remaining time
 3314:    double time_rm_1 = 1e10;
 3315:    double time_rm_2 = 2e10;
 3316:    double time_rm_3 = 3e10;
 3317: 
 3318: 
 3319:    // Initial velocities
 3320:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3321: 
 3322:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3323:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3324: 
 3325:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3326: 
 3327: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3328: 
 3329: 
 3330:    constexpr int MAX_ITERATIONS = 100; 
 3331:    int iter = 0;
 3332:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3333:    while(true) {
 3334: 
 3335:       // Calculate timestep
 3336:       const double dtb = min(dtbk, time_rm);
 3337: 
 3338: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3339: 
 3340:       // Next point in the backtracking curve
 3341:       xt = x0 - dtb*u_int;
 3342: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3343: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3344: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3345: // if ((jlev==45))
 3346: // {
 3347: // // const Point3 p1 = toLocalFrame(x0);
 3348: // // const Point3 p2 = toLocalFrame(xt);
 3349: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3350: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3351:     
 3352: // }
 3353: 
 3354:       double t, s; // parameters for the line segments p0pt and p1p2
 3355:       Side *lastCrossSide = nullptr;
 3356:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3357: 
 3358: 
 3359: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3360: 
 3361:       if (time_rm_3 <= time_rm) {
 3362:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3363:          xt = x0;
 3364:          break;
 3365:       }
 3366: 
 3367: 
 3368:       if (!found) {
 3369:       // This means that the walk reached a boundary or a dry element.
 3370: 
 3371:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3372: 
 3373:          // Finds the point at the boundary where the line segment x0xt intersects.
 3374:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3375:          // due to floating point errors, it does not exactly intersect.
 3376:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3377:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3378:          // To compute the intersection point we start with the parametric equations.
 3379:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3380:          // We cross-prouct by v1 to cancel the s term:
 3381:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3382:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3383: 
 3384:          // Side coordinates in the origSide frame.
 3385:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3386:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3387: 
 3388:          Point2  p0 = {x0.x, x0.y};
 3389:          Point2  pt = {xt.x, xt.y};
 3390: 
 3391:          const Vector2 v1 = pt - p0;
 3392:          const Vector2 v2 = p2 - p1;
 3393: 
 3394: 
 3395: 
 3396:          // We are assuming intersection, so we clamp t to the range [0,1].
 3397:          const double denom = cross(v2, v1);
 3398:          
 3399: 
 3400: 
 3401: 
 3402:          if (abs(denom) < small) {
 3403:             // small denominators are fairly common. They occur when the line segment x0xt 
 3404:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3405:             // boundary, where the backtracking curve startt sliding along the boundary.
 3406:             // In this case, we simply assume that the two lines are very close to each other
 3407:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3408:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3409:             if (t<0.0000000001) t = 0.0;
 3410:             if (t>0.9999999999) t = 1.0;
 3411: 
 3412:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3413:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3414: 
 3415:          }
 3416:          else {
 3417:             
 3418:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3419:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3420:             if (t>0.9999999999) t = 1.0;
 3421:             // From the originaL equation we can solve for s:
 3422:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3423:             // Computing the dot product by v1, we get:
 3424:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3425:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3426:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3427: 
 3428:          }
 3429: 
 3430:          
 3431:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3432:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3433: 
 3434: 
 3435: 
 3436:          // We update the new target point to be right at the intersection point,
 3437:          // and the remaining time must include the time we haven't "used".
 3438:          time_rm -= s*dtb;
 3439:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3440: 
 3441: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3442: // xct = toLocalFrame(xct);
 3443: // xt = (1-0.00001)*xt + 0.00001*xct;
 3444:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3445:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3446: 
 3447:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3448:          // but extracting only the component along the tangent vector v2.
 3449:          Vector2 tangent = normalize(v2);
 3450:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3451: 
 3452:          const Vector2 u2D = make_double2(u.x, u.y);
 3453:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3454: 
 3455: 
 3456:       } else {
 3457: 
 3458:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3459: 
 3460:          time_rm -= dtb; 
 3461: 
 3462:          u_int = curElem->interpolateVelocities(xt, this);
 3463: 
 3464:       }
 3465: 
 3466:       if (time_rm <= 0.0) break; 
 3467: 
 3468:       // If the velocity is too small, we stop the backtracking
 3469:       const double vmag2 = norm2(toVector2(u_int));
 3470:       if (vmag2 <= velmin_btrack_sq)  {
 3471: 
 3472:          time_rm = 0.0; 
 3473:          return; 
 3474:       }
 3475: 
 3476:       // The current point becomes the next segment's starting point.
 3477:       x0 = xt;
 3478:  
 3479:       iter++;
 3480: 
 3481: 
 3482:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3483: 
 3484:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3485:       time_rm_3 = time_rm_2;
 3486:       time_rm_2 = time_rm_1;
 3487:       time_rm_1 = time_rm;
 3488:    }
 3489: 
 3490:    assert(curElem != nullptr && "Final element is nullptr");
 3491:    assert(!curElem->isDry && "Final element is dry");
 3492:    
 3493: 
 3494: 
 3495:    // Interpolate the velocities at the final point with respect to the current side frame
 3496:    u_int = curElem->interpolateVelocities(xt, this);
 3497: 
 3498: 
 3499: }
 3500: 
 3501: 
 3502: 
 3503: 
 3504: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3505: 
 3506: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3507: 
 3508:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3509:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3510: 
 3511:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3512:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3513: 
 3514:    double fun_lat = 0.0;
 3515:    switch (jspc[idxComp]) {
 3516:       case 0:
 3517:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3518:          break;
 3519:       case 1:
 3520:          fun_lat = sin(2.0*lat);
 3521:          break;
 3522:       case 2:
 3523:          fun_lat = pow<2>(cos(lat));
 3524:          break;
 3525:       default:
 3526:          assert(false && "computeETP: invalid jspc");
 3527:    }
 3528:    
 3529:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3530: 
 3531: }
 3532: 
 3533: 
 3534: __device__ void Node::updateKb(void) {
 3535: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3536: 
 3537:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3538: 
 3539: 
 3540:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3541: 
 3542:    if constexpr(ivcor == 2) {  // SZ coordinates
 3543:       
 3544:       // Compute bottom level index
 3545:       if (depth <= mesh->h_s) {
 3546:          kb = izlev;   
 3547:          
 3548:       } else {
 3549:          kb = -1;
 3550:          int L = 0;
 3551:          int R = nzlev; 
 3552:          
 3553:          while (L <= R) {
 3554:             int M = (R + L) / 2;
 3555: 
 3556: 
 3557:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3558:             
 3559:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3560:                R = M;
 3561:             } else {
 3562:                L = M;
 3563:             }
 3564: 
 3565:             if (R - L == 1) {
 3566:                kb = L;
 3567:                break;
 3568:             }
 3569:          }
 3570: 
 3571:          // Checks that the binary search was successful
 3572:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3573:        
 3574:       }
 3575:    } 
 3576: }
 3577: 
 3578: 
 3579: __device__ __inline__ void Node::updateZCoordData(void) {
 3580: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3581: 
 3582:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3583:    // if (isDry2()) {
 3584:    //    kb = -1;  // XXXXXXXX KKKKK
 3585:    //    return;
 3586:    // }
 3587: 
 3588: 
 3589:    if constexpr(ivcor == 2) {  // SZ coordinates
 3590:       
 3591:       // Compute bottom level index
 3592:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3593:    } 
 3594:    else {  // if (ivcor == 1) Localized sigma
 3595:       // Do nothing
 3596:    }
 3597: 
 3598: 
 3599: }
