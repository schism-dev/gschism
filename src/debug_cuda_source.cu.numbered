 6842: #ifdef DONTCOMPILE
 6843: __device__ void computeVerticalAdvection(void) {
 6844:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6845: 
 6846:    sdbt(1:2,:,:)=0.d0
 6847: 
 6848:    const Side *side = FROM kernel;
 6849: 
 6850:    if(side->isDry) return;
 6851: 
 6852:    // If side is wet...
 6853: 
 6854: 
 6855:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6856:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6857:    double ws[nvrt] = {} // w @ side
 6858:    int icount = 0;
 6859:    for (int j=0; j<2; j++) {
 6860:       const Element *elem = side->elements[j];
 6861:        
 6862:       if(elem != nullptr) {
 6863:          icount++;
 6864:          for (int k=0; k<nvrt; k++) {
 6865:             ws[k] = ws[k] + elem->w[k];
 6866:          }
 6867:       }
 6868:    }  // for j
 6869: 
 6870:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6871:    ws = ws/icount;
 6872: 
 6873:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6874:    // Splines allow for a smooth transition between vertical levels.
 6875:    // Splines have continuity restrictions at the internal knots, but
 6876:    // we have to provide the 1st derivatives at the endpoints.
 6877:    const int kbs = side->kbs; 
 6878:    
 6879:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6880:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6881:    initCubicSpline(kbs, nvrt, side, ws, up)
 6882: 
 6883:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6884:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6885:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6886: 
 6887:    // Total advection (average onto side)
 6888:    const Node *node1 = side->nodes[0];
 6889:    const Node *node2 = side->nodes[1];
 6890:    for (int k=kbs(i); k<nvrt; k++) {
 6891: 
 6892:       if constexpr(ics==1) {
 6893:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6894:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6895:       } else {
 6896:          // XXX IMPLEMENT THIS
 6897:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6898:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6899:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6900:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6901:       }  // if ics
 6902: 
 6903: 
 6904:    }
 6905: }
 6906: #endif
 6907: 
 6908: 
 6909: extern "C" {
 6910:    __global__ void computeElemAverageGhat(void) {
 6911:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6912: 
 6913:       ELEM(elem);
 6914:       
 6915:       elem->ghat1= {0.0, 0.0};  
 6916: 
 6917:       if constexpr(ihydraulics != 0) {
 6918:          if (nhtblocks > 0 && elem->isblock) return;
 6919:       }
 6920: 
 6921:       if (elem->isDry) return;
 6922: 
 6923:       // Wet elements.
 6924:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6925:       // tidal potential, horizontal diffusion, and baroclinic etc
 6926:       // Remember to update both fb and F 
 6927:       // If ics=2, ghat1 are in eframe (ll)
 6928:       // cff1-3: coefficients for 2D/3D
 6929:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6930:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6931:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6932: 
 6933:       double av_cff1 = 0.0;  // av. for cff1
 6934:       double av_cff2 = 0.0;  // av. for cff2
 6935:       double av_cff3 = 0.0;  // av. for cff3
 6936:       double av_df = 0.0;  // av. for H^\alpha / H
 6937:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6938:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6939: 
 6940:       const int i34 = elem->i34;
 6941:       const int kb = elem->kb;
 6942: 
 6943:       for (int j=0; j<i34; j++) {
 6944:          // For each node and side in the element...
 6945: 
 6946:          const Node *node = elem->nodes[j];
 6947:          const Side *side = elem->sides[j];
 6948: 
 6949:          const double chi      = side->chi;
 6950:          const double veg_c2   = side->veg_c2;
 6951:          const double veg_beta = side->veg_beta;
 6952:          const double veg_h    = side->veg_h();
 6953:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6954: 
 6955:          // Node - const in elem
 6956:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6957:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6958: 
 6959:          if (elem->depth >= tip_dp) {
 6960:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6961:          }
 6962: 
 6963:          
 6964:          const double htot  = side->htot2();        // Total depth at the side
 6965:          const double zctr2 = side->zTopCanopy();  
 6966: 
 6967:          double cff1; 
 6968:          double cff2; 
 6969:          double cff3;   
 6970:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6971:          // coefficients applied to 2D/3D case 
 6972:             cff1 = side->hhat/htot;
 6973:             cff2 = 0.0;
 6974:             cff3 = 0.0;
 6975:          } else { //3D
 6976:             //Init for no-veg case
 6977:             cff1 = 1.0;
 6978:             cff2 = 1.0;
 6979:             cff3 = 0.0;
 6980: 
 6981:             if constexpr(iveg != 0) {
 6982:                // Computes coefficients used with vegetation terms G1, G2
 6983:                // cff1, cff3 are used for the first two terms in G1, G2:
 6984:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6985:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6986:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6987:                if(veg_h < 0.99*htot) { // submergent vegetation
 6988:                   cff1=1;
 6989:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6990:                   cff3 = veg_c;
 6991: 
 6992:                } else { // emergent vegetation
 6993:                   cff1 = 1.0/(1.0 + veg_c2);
 6994:                   cff2 = cff1;
 6995:                   cff3 = 0.0;
 6996: 
 6997:                }
 6998:             } // if iveg
 6999:          } //  2D/3D
 7000: 
 7001:          av_cff1 += cff1/i34;
 7002:          av_cff2 += cff2/i34;
 7003:          av_cff3 += cff3/i34;
 7004:          av_cff2_chi += cff2*chi/i34;
 7005:          av_cff3_chi += cff3*chi/i34;
 7006:          av_df += min(htot, veg_h)/(htot*i34);
 7007: 
 7008: 
 7009:          // btrack values: U^\star, U^{\star\alpha}
 7010:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7011:          Vector2 Ustar       = {0.0, 0.0}; 
 7012:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7013: 
 7014:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7015:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7016:          } else { //3D
 7017:             for (int k = side->kb; k < nvrt; k++) {
 7018:             
 7019:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7020:                Ustar += w2;
 7021: 
 7022:                if constexpr(iveg != 0) {
 7023:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7024:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7025:                        Ustar_alpha += zrat*w2; // XXXX
 7026:                    }
 7027:                }  // if iveg
 7028:             }  // for k
 7029:          }  //2D/3D
 7030:          
 7031: 
 7032:          // Add btrack & surface stress terms to \breve{G} first
 7033:          if constexpr(ics==1) {
 7034: 
 7035:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7036: 
 7037:          } else {
 7038:             // XXX IMPLEMENT THIS
 7039:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7040:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7041:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7042:          }  // if ics
 7043: 
 7044:          // Surface and bottom stress terms
 7045:          if constexpr(ics==1) {
 7046:             const Vector2 tau    = side->tau();
 7047:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7048: 
 7049:             // Term for surface and bottom stress
 7050:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7051: 
 7052:          } else {
 7053:             assert(false && "computeElemAverageGhat: Not implemented");
 7054:             // XXX IMPLEMENT THIS
 7055:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7056:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7057:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7058:             // tau_x=(vn1+tt1)/2.d0
 7059:             // tau_y=(vn2+ss1)/2.d0
 7060:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7061:          }  // if ics
 7062: 
 7063:          
 7064: 
 7065:          // All terms in F,F^\alpha,f_b except baroclinic
 7066:          // F, f_b: all explicit terms excluding vegetation 
 7067:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7068:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7069:          const double coriolis = side->coriolis;
 7070:          Vector2 F  =  coriolis*side->U;  // F_x
 7071:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7072:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7073: 
 7074:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7075:             
 7076:             for (int k = side->kb; k < nvrt; k++) {
 7077:                if (zctr2 > side->zc[k-1]) {
 7078:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7079:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7080:                    Fa +=  coriolis*w2*zrat;
 7081:                } // if zctr2
 7082:             } // k
 7083:          } // iveg
 7084: 
 7085:          // Integrate horizontal viscosity force vertically
 7086:          for (int k=side->kb + 1; k<nvrt; k++) {
 7087:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7088: 
 7089:             F += levelHorVisc;
 7090: 
 7091:             // Vegetation term
 7092:             if constexpr(iveg!=0) {
 7093:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7094:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7095:                   Fa += levelHorVisc*zrat;
 7096:                } 
 7097:             } // if iveg
 7098:          } // for k
 7099: 
 7100:          fb += side->nuGradU[side->kb];
 7101: 
 7102:          // Add to ghat1
 7103:          if constexpr(ics==2) {
 7104:             // XXX IMPLEMENT THIS
 7105:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7106:             // bigf1=vn1; bigf2=vn2
 7107:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7108:             // botf1=vn1; botf2=vn2
 7109:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7110:             // bigfa1=vn1; bigfa2=vn2
 7111:          } // if ics
 7112: 
 7113:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7114:       } // for j (nodes and sides)
 7115: 
 7116:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7117:          
 7118:       // Finish off terms in F, F^\alpha and f_b
 7119:       const double grav3 = elem->mean(&Node::grav2);
 7120:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7121: 
 7122: 
 7123:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7124:       for (int j=1; j<i34; j++) { 
 7125:          // For each side in the element...
 7126:          const Side *side = elem->sides[j];
 7127:          const double chi = side->chi;
 7128: 
 7129:          const double htot = side->htot2();
 7130:          const double veg_h = side->veg_h();
 7131:          const Vector2 F  = htot*fb;
 7132:          const Vector2 Fa = min(htot, veg_h)*fb;
 7133: 
 7134:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7135:       } // for j
 7136: 
 7137:       //botf1 etc are already in elem frame
 7138:       elem->ghat1 += tmp/i34;
 7139: 
 7140:       // Baroclinic force
 7141:       if constexpr(ibc==0) {
 7142:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7143: 
 7144:          Vector2 Fa = {0.0, 0.0};
 7145:          Vector2 intGradRho = {0.0, 0.0};
 7146:          
 7147:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7148:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7149:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7150: 
 7151:             // \in F [m^2/s/s]
 7152:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7153:          }
 7154: 
 7155:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7156:          const Vector2 F = av_df*Fa; //approx
 7157:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7158: 
 7159:       } // if ibc
 7160: 
 7161: 
 7162: 
 7163:    }
 7164: 
 7165: } // extern "C"
 7166: 
 7167: 
 7168: 
 7169: #ifdef DONTCOMPILE
 7170: __global__ void checkMassConservation(Tracers* sumtr) {
 7171: 
 7172:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7173: 
 7174:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7175: 
 7176:    Element *elem = &(mesh->localElemData[i]);
 7177: 
 7178:    // Skip dry elements
 7179:    if (elem->isDry) return;
 7180: 
 7181:    // Local sum array for this thread
 7182:    double localSum[N_TRACERS] = {0.0};
 7183: 
 7184:    // Sum over vertical levels for this element
 7185:    const int kbe = elem->kbe;
 7186:    const double area = elem->area;
 7187: 
 7188:    for (int k = kbe; k < nvrt; k++) {
 7189:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7190:       
 7191:       // Accumulate tracer mass
 7192:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7193:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7194:       }
 7195:    }
 7196: 
 7197:    //  This function returns per element sums. A reduction must be done on the host side.
 7198: }
 7199: 
 7200: 
 7201: __global__ void transport(void) {
 7202: 
 7203:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7204: 
 7205:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7206: 
 7207:    Element *elem = &(mesh->localElemData[ie]);
 7208: 
 7209:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7210: 
 7211:                for (int m=0; m<ntr; m++) {
 7212:                   for (int k=kbe(ie); k<nvrt; k++) {
 7213:                      // Calculate each polynomial's weight 
 7214:                      wm=0.d0; sum1=0.d0; 
 7215:                      wm1=0.d0; wm2=0.d0; 
 7216:                      for (int i=0; i<elem->nweno2; i++) {
 7217:                   
 7218:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7219:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7220:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7221:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7222:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7223:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7224:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7225:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7226:                      // -----------------Hu and Shu (1999)'s method----------------
 7227:                      b4=b1+b2+b3
 7228: 
 7229: //Error: add PRODUCTION CPP
 7230: #ifdef DEBUG
 7231:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7232:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7233:                     call parallel_abort(errmsg)
 7234:                   }
 7235: #endif
 7236: 
 7237:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7238:                   // !----test-------------- 
 7239:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7240:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7241:                   // !wm(i)=wm1(i)*wm2(i)
 7242:                   // !---------------------- 
 7243:                   sum1=sum1+wm(i)
 7244:                 } // end for i
 7245: 
 7246:                 wm=wm/sum1
 7247: 
 7248:                 for (int j=0; j<elem->i34; j++) {
 7249: 
 7250:                   const Side *side  = elem->sides[j];
 7251:                   const Node *node1 = side->n1;
 7252:                   const Node *node2 = side->n2;
 7253: 
 7254:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7255:                      trsd=0.d0
 7256:                      for (int kk=0; kk<nquad; kk++) {
 7257:                         for (int i=0; i<elem->nweno2; i++) {
 7258:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7259:                         } // end for i   
 7260:                      } // end for kk
 7261:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7262:                   } // outward flux
 7263:                } // end for j=1,i34(ie) ! side
 7264:             }
 7265:          }
 7266:               
 7267: 
 7268: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7269: //             //   calculate each polynomial's weight 
 7270: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7271: //                 wm=0.d0; sum1=0.d0
 7272: //                 do i=1,nweno1(ie) !for each polynomial
 7273: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7274: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7275: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7276: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7277: //                   wm(i)=b2
 7278: //                   sum1=sum1+b2
 7279: //                   !wm(i)=1.d0
 7280: //                   !sum1=sum1+1.d0
 7281: 
 7282: // // Error: PRODUCTION
 7283: // #ifdef DEBUG
 7284: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7285: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7286: //                     call parallel_abort(errmsg)
 7287: //                   endif
 7288: // #endif
 7289: 
 7290: //                 enddo !i
 7291: //                 wm=wm/sum1 !final weight
 7292: 
 7293:                 for (int j=0; j<elem->i34; j++) { // side
 7294:                   const Side *side = elem->sides[j];
 7295:                   const Node *node1 = side->n1;
 7296:                   const Node *node2 = side->n2;
 7297: 
 7298:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7299:                     trsd=0.d0
 7300:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7301:                       for (int i=0; i<elem->nweno1; i++) {
 7302:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7303:                       }
 7304:                     enddo //kk
 7305:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7306:                   } // outward flux
 7307:                 } // end for j=1,i34(ie) ! side
 7308:               } // end for k; ntr 
 7309: 
 7310:             else !simple upwind method
 7311:               do j=1,i34(ie)
 7312:                 jsj=elside(j,ie)
 7313:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7314:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7315:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7316:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7317:                   endif
 7318:                 enddo  !vertical layers
 7319:               enddo !j=1,i34(ie) ! side
 7320:             endif !order of accuracy
 7321: 
 7322:          //  enddo !ie
 7323: // !$OMP     end do
 7324: 
 7325: // !$OMP     master
 7326: //           !message passing
 7327: //           if (nproc>1) then
 7328: //             !make a copy of side concentrations
 7329: //             trsd_tmp0=trsd_tmp 
 7330: 
 7331: //             !this exchange routine swaps interface concentration between two partitions
 7332: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7333: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7334: 
 7335: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7336: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7337: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7338: 
 7339: 
 7340: //             !This obtains final values for interface sides
 7341: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7342: //       :    endif !nproc>1
 7343: //           !message passing end
 7344: // !$OMP     end master
 7345: // !$OMP     barrier
 7346: 
 7347: 
 7348: // !         Do advection; conc @ dry elem will not be changed
 7349: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7350: // !$OMP     do reduction(+: h_mass_in)
 7351: //           do i=1,ne
 7352: //             if(idry_e(i)==1) cycle
 7353: 
 7354: 
 7355: // !           Wet elements with 3 wet nodes
 7356: //             do k=kbe(i)+1,nvrt
 7357: 
 7358: 
 7359: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7360: //               dtb_by_bigv = dtb/bigv
 7361:     
 7362: // !             Advective flux
 7363: //               if (ntd_weno==1 .or. itd_weno==1) then
 7364: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7365: //               else
 7366: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7367: //               endif
 7368: 
 7369: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7370: //               do j=1,i34(i)
 7371: //                 jsj=elside(j,i) !side
 7372: //                 iweno=.true. !use weno reconstruction as default
 7373: //                 iel=ic3(j,i) !neighboring elem
 7374: 
 7375: //                 if(iel/=0) then
 7376: //                   if(idry_e(iel)==1) cycle
 7377: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7378: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7379: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7380: //                     iweno=.false.
 7381: //                   endif
 7382: //                 else !land or open bnd side
 7383: //                   !skip land bnd and outflowing open bnd, 
