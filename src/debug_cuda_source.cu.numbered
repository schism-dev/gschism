 8159:    // Debugging: returns the matrix as a CuPy array
 8160: 
 8161:    const int size = mesh->np;
 8162:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8163:       const Node *node = mesh->localNodeData + idx_node;
 8164: 
 8165:       res[idx_node] = node->mX;
 8166: 
 8167:    }
 8168:    
 8169: }
