 1186: struct Node {
 1187: 
 1188:    // Geometry information
 1189:    int idx;        // Index of the node
 1190:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1191:    int numNodes;   // Number of nodes neighbors of this node
 1192: 
 1193:    Element **elements; // Array of pointers to the elements that share this node
 1194:    int numElements;    // Number of elements that share this node
 1195: 
 1196:    int numSides;       // Number of sides that are connected to this node
 1197: 
 1198:    Point2 p;
 1199:    Vector2 u2[nvrt];
 1200:    double  w2[nvrt];
 1201:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1202:    double z[nvrt];
 1203:    double lon, lat;
 1204:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1205:    double depth;
 1206: 
 1207:    int kb;       // Bottom index of the node
 1208: 
 1209:    bool isDry;     // True if the node is dry
 1210: 
 1211:    int iadv;     // Advection flag
 1212: 
 1213:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1214:                           // this is nullptr
 1215: 
 1216:    TempVar tmp; // Temporary variable to store different types of variables
 1217: 
 1218:    // Physical information
 1219:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1220:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1221: 
 1222:    double rho[nvrt];     // Density
 1223:    double dfv[nvrt];     // Vertical viscosity
 1224: 
 1225:    double eta1; // Elevation at nodes at previous timestep
 1226:    double eta2; // Elevation at nodes at current timestep
 1227: 
 1228:    double ETP;  // Earth Tidal Potential
 1229: 
 1230:    double pr;    // Air pressure
 1231:    double grav2; // Gravity 
 1232:    
 1233:    Vector2 dav;  // Depth averaged velocity
 1234: 
 1235:    Vector2 tau; // Wind stress vector
 1236: 
 1237:    // Vegetation parameters
 1238:    double veg_h;
 1239:    double veg_nv;
 1240:    double veg_di;
 1241:    double veg_Cd;
 1242:    double veg_h_unbent;
 1243:    double veg_di_unbent;
 1244:    double veg_nv_unbent;
 1245:    double veg_alpha_vert_mean;
 1246:    double veg_alpha0;
 1247:    double veg_alpha3D[nvrt];
 1248: 
 1249:    // Bottom drag parameters
 1250:    double Cd;       // Bottom drag coefficient   
 1251: 
 1252:    // These three are mutually exclusive
 1253:    union {
 1254:       double rmanning; // Bottom Manning's coefficient
 1255:       double rough;    // Bottom roughness length
 1256:       double drag;     // Bottom drag coefficient
 1257:    };
 1258:    Vector2 tau_bot; // Bottom stress vector
 1259: 
 1260:    double bdef1; // Bottom deformation at previous timestep
 1261:    double bdef2; // Bottom deformation at current timestep
 1262: 
 1263:    double qel; // RHS
 1264:    double coeffDiag; // Diagonal coefficient of the matrix
 1265:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1266: 
 1267:    double mP; // Search direction for conjugate gradient method
 1268:    double mR; // Residual for conjugate gradient method
 1269:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1270:    double mX; // Solution for conjugate gradient method
 1271: 
 1272:    // Meteorological forcing
 1273:    Vector2 u_air;
 1274:    double p_air;
 1275:    double t_air;
 1276:    double q_air;
 1277:    double wind_angle;  // Wind rotation angle
 1278: 
 1279:    __device__ void setWind(Vector2 &u) {
 1280:    // Sets the wind vector taking into account the wind rotation angle
 1281:    
 1282:       const double dir = atan2(-u.x,-u.y);
 1283:       const double speed = length(u);
 1284: 
 1285:       // Calculate new u and v components with added rotation angle
 1286:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1287:    }
 1288: 
 1289: 
 1290:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1291: 
 1292:    __device__ double sigmaTransitionDepth(void) const;
 1293: 
 1294:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1295:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1296:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1297:    
 1298:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1299: 
 1300:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1301: 
 1302:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1303:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1304: 
 1305:    __device__ __forceinline__ void clearMatrixRow(void) {
 1306:       // Clear the matrix row for this node
 1307: 
 1308: 
 1309:       coeffDiag = 0.0;
 1310: 
 1311:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1312: 
 1313:    }
 1314: 
 1315:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1316:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1317:       
 1318:       if (node == this) {
 1319:          coeffDiag += value;
 1320:      
 1321:       } else {
 1322:          // Search (linearly)the index of the node in the array of nodes
 1323:          // XXX: This is not efficient, see if we can improve this
 1324:          int i;
 1325:          for (i = 0; i < numNodes; i++) {
 1326:             if (nodes[i] == node) {
 1327:                break;
 1328:             }
 1329:          }
 1330:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1331:          coeffMatrix[i] += value;
 1332:       }
 1333:    }
 1334: 
 1335: 
 1336:    __device__ __inline__ void updateZCoordData(void);
 1337: 
 1338:    __device__ double compZCoord(int k) const;
 1339: 
 1340:    __device__ void updateKb(void);
 1341: 
 1342:    __device__ __forceinline__ void computeBottomDragCd(void);
 1343: 
 1344: 
 1345: 
 1346: };
