 4556:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4557: 
 4558:       SIDE(side);
 4559: 
 4560: 
 4561:       side->U = {0.0, 0.0}; 
 4562:          
 4563:       if(side->isDry) return;
 4564: 
 4565:       const Node *node1 = side->n1;
 4566:       const Node *node2 = side->n2;
 4567: 
 4568:       // Vertically integrated velocity U (in ll if ics=2)
 4569:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4570:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4571:       }
 4572: 
 4573:    }
 4574: 
 4575:    __global__ void computeBottomDragVegetation(void) {
 4576:       // UNFINISHED. CHECK THIS:
 4577:       // How many kernels are needed? Why so many for loops?
 4578:       // Is the loop on sides needed?
 4579: 
 4580:       NODE(node);
 4581: 
 4582: 
 4583:       const int    kb      = node->kb;
 4584:       const double htot    = node->htot2(); 
 4585:       const double rough   = node->rough;
 4586: 
 4587:       
 4588:       if (node->isDry) {
 4589:          // Default values for dry nodes
 4590:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4591:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4592: 
 4593:          return;
 4594:        
 4595:       }
 4596: 
 4597:       // Compute bottom drag Cd
 4598:       //--------------------------------
 4599: 
 4600:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4601:       if constexpr(nchi == 1) {
 4602: 
 4603:          bool ltmp = false; // for WBL iteration
 4604: 
 4605:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4606:          // Drag at nodes
 4607:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4608:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4609:         
 4610:          const double rough = node->rough;
 4611:         
 4612:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4613:          if (node->rough == 0.0) {
 4614:             node->Cd = 0.0;
 4615: 
 4616:          } else { //roughness >0 
 4617:           
 4618:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4619:             const double bthick = max(dzb_min, bthick_ori);
 4620: 
 4621:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4622: 
 4623:             double tmp = 1.0/(2.5*log(bthick/rough));
 4624:             node->Cd = tmp*tmp;
 4625: 
 4626:          } // if rough
 4627: 
 4628: 
 4629:          // RECOVER THIS: XXX
 4630:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4631:          // Output warning for WBL if iteration didn't converge
 4632: 
 4633: 
 4634:       } // nchi==1
 4635: 
 4636: 
 4637:       //   Bottom stress in m^2/s^2
 4638:       if (node->rho[kb + 1] >= -98.0)
 4639:       {
 4640:          const double mag_u = length(node->u2[kb + 1]);
 4641:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4642: 
 4643:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4644:          // !sediment erosion: this part needs more documentation
 4645:       }
 4646:     
 4647: 
 4648: 
 4649:       // Compute vegetation parameters
 4650:       //--------------------------------
 4651: 
 4652:       // SAV constants
 4653:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4654:       constexpr double veg_cfpsi = 0.16;
 4655: 
 4656:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4657:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4658: 
 4659:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4660:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4661:          int kbin = 0; // bin index
 4662:          for (int k = kb; k < nvrt; k++) {
 4663:             // Computes node height above the bottom level
 4664:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4665:             assert(false && "Vertical variation of vegetation not implemented");
 4666: 
 4667:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4668:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4669:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4670:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4671:             // } else {
 4672:             //    // Find the bin at which the current vertical level is
 4673:             //    while (kbin<nbins_veg_vert) {
 4674:             //       const double zn = node->z[kbin];
 4675:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4676:             //          break;
 4677:             //       } // if
 4678:             //       kbin++;
 4679:             //    } // while
 4680:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4681: 
 4682:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4683:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4684:                
 4685:             //    // Linear interpolation of the vegetation parameters
 4686:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4687:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4688:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4689:             // } // if rl10
 4690: 
 4691:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4692: 
 4693:          } // for k
 4694: 
 4695: 
 4696:       } else { // Ganthy (iveg==2)
 4697:       //  Modify canopy height, diameter, and density
 4698: 
 4699:          // Make sure there is vegetation on this node
 4700:          if (node->veg_h_unbent > 0.0) {
 4701:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4702: 
 4703:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4704:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4705:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4706: 
 4707:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4708:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4709:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4710:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4711:          } // if veg_h_unbent
 4712: 
 4713:          for (int k = 0; k < nvrt; k++) {
 4714:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4715:          } // for k
 4716:       
 4717: 
 4718:       } // if iveg
 4719:      
 4720: 
 4721:       // Compute vertical mean of veg_alpha3D
 4722:       if (iveg != 0) {
 4723:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4724:          double sum1=0.0;
 4725:          double sum2=0.0;
 4726:          // Integrate over each level under the canopy...
 4727:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4728:             const double Dz = node->Dz(k);
 4729: 
 4730:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4731:             sum2 += Dz;
 4732: 
 4733:          } // for k
 4734:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4735:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4736: 
 4737:       } // if iveg
 4738: 
 4739:    }
 4740: 
 4741:    __global__ void computeVegetationAndDragParameters(void) {
 4742:       // Computes the vegetation and drag model parameters:
 4743:       // chi, \tilde\chi, beta, \breve{H}
 4744:       
 4745:       SIDE(side);
 4746: 
 4747:       if (side->isDry) return;
 4748: 
 4749:       const double htot = side->htot2();
 4750:       const int    kb   = side->kb;
 4751: 
 4752:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4753: 
 4754:       const double veg_h     = side->veg_h();
 4755:       const double veg_nv    = side->veg_nv();
 4756:       const double veg_c     = side->veg_c();
 4757:       const double veg_beta  = side->veg_beta;
 4758:       const double veg_alpha = side->veg_alpha_vert_mean();
 4759: 
 4760:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4761:       // Velocity magnitude at the bottom level
 4762:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4763:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4764:       side->chi2 = side->Cd()*vmag1;
 4765:       side->chi  = side->chi2;
 4766:       if constexpr(iveg != 0) {
 4767:          const Node *n1 = side->n1;
 4768:          const Node *n2 = side->n2;
 4769:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4770:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4771:       }
 4772: 
 4773:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4774: 
 4775:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4776:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4777:       double magUa = 0.0;
 4778:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4779:          // 3D wet side with veg...
 4780: 
 4781:          double magUa = 0.0;
 4782:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4783:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4784: 
 4785:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4786:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4787:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4788: 
 4789:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4790:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4791: 
 4792:                // Velocity magnitude at the bottom (l) of the level
 4793:                const double ul = length(side->u2[k]);
 4794: 
 4795:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4796:                magUa += Dz*0.5*(uh + ul);
 4797: 
 4798:             } // if HasVegetation
 4799:          } // for k
 4800:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4801: 
 4802:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4803:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4804:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4805:             const double zCpy = side->zTopCanopy();
 4806:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4807:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4808:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4809:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4810:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4811:          } // if isSubmerged
 4812:       } // if iveg   
 4813: 
 4814:       // Computes the friction modified depth, \breve{H} in notes
 4815:       if (side->is2D()) { // 2D
 4816: 
 4817:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4818:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4819: 
 4820:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4821: 
 4822:          side->hhat = htot*htot/fricH; 
 4823: 
 4824:       } else { // 3D
 4825:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4826: 
 4827:          if constexpr(iveg != 0) {
 4828:             
 4829:             if (side->isSubmerged()) { 
 4830:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4831:                side->hhat -= veg_c*Hhat_alpha;
 4832: 
 4833:             } else { // Emergent
 4834:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4835:             }
 4836:          } // if iveg
 4837: 
 4838:          // Enforce positivity for 3D model
 4839:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4840:       } // if 3D
 4841: 
 4842:    }
 4843: 
 4844: 
 4845: 
 4846:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4847:    // Computes the density gradient between two elements, e1 and e2.
 4848:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4849:    // zero in the direction normal to the side. 
 4850:    // 
 4851:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4852:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4853:    //
 4854:    // Input:
 4855:    //    e1: Element
 4856:    //    e2: Neighbor element (or nullptr if boundary)
 4857:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4858:    //    k: Index of the half-level at which the density is interpolated
 4859:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4860:    // 
 4861:    // Output:
 4862:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4863:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4864: 
 4865:       if (e2 == nullptr || e2->isDry) {
 4866:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4867: 
 4868:          Side *side = e1->sides[j];
 4869:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4870:                  
 4871:          if constexpr(ics == 1) {
 4872:             vec = side->n; // Normal vector to the side
 4873:          } else {
 4874:             // IMPLEMENT THIS XXXXXX
 4875:             // !replace with xel, yel?
 4876:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4877:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4878:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4879:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4880:          } //ics
 4881:                    
 4882:          diffRho = 0.0;
 4883: 
 4884:       } else { //internal and wet
 4885:          if constexpr(ics==1) {
 4886:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4887: 
 4888:             // Vector from e1 to e2
 4889:             vec = e2->center - e1->center;
 4890: 
 4891:          } else { 
 4892:             // IMPLEMENT THIS XXXXXX
 4893:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4894:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4895:             //                   alow(j)=xctr2
 4896:             //                   bdia(j)=yctr2
 4897:          } // ics
 4898: 
 4899:          diffRho = rho2 - e1->demeanedDensity(k);
 4900:       }
 4901: 
 4902:    }
 4903: 
 4904:    __global__ void computeDensityCubicSplines(void) {
 4905:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4906: 
 4907:       ELEM(elem);
 4908: 
 4909:       if (elem->isDry) return;
 4910: 
 4911:       const int kb = elem->kb;
 4912: 
 4913:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4914:       if (elem->is2D()) {
 4915:          // In the 2D case, the density is constant at the prism level. 
 4916:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4917:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4918:       } else { //3D
 4919: 
 4920:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4921:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4922:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4923:          ///// XXXX CHECK INDICES!!!!!
 4924:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4925:       } // 2D/3D
 4926: 
 4927:    }
 4928: } // extern "C"
 4929: 
 4930: 
 4931: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4932: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4933: 
 4934:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4935: 
 4936:    const int kb  = elem->kb;
 4937:    const int kb2 = elem2->kb;
 4938: 
 4939:    // z-coordinate of prism of elem
 4940:    const double zp = elem->z_prism(k);
 4941: 
 4942:    double rho = 0.0;
 4943: 
 4944:    if (elem2->is2D()) {
 4945:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4946: 
 4947:    } else {  // 3D
 4948: 
 4949:       // eta_min may be < zmax
 4950:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4951:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4952: 
 4953:       // (Extrapolate density below bottom, we will fix it later)
 4954:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4955:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4956:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4957:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4958:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4959:    } // 2D/3D
 4960:      
 4961: 
 4962:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4963:    // Now we need to fix it.
 4964:    if (elem->z[k] < elem2->z[kb2]) {
 4965:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4966: 
 4967:       // There are two methods to adjust the density at the bottom of the element.
 4968:       // iunder_deep=0: 
 4969:       const double depth1 = abs(elem->z[kb]); // larger depth
 4970: 
 4971:       if (iunder_deep==0) {
 4972: 
 4973:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4974: 
 4975:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4976: 
 4977:       } else { // iunder_deep != 0
 4978: 
 4979:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4980: 
 4981:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4982: 
 4983:          //   Demeaned density at the same z coordinate as
 4984:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4985:          }
 4986: 
 4987:       } // if iunder_deep
 4988:    } // if elem->z[kb] < elem2->z[kb]
 4989: 
 4990:    return rho;
 4991: }
 4992: 
 4993: 
 4994: extern "C" {
 4995:    __global__ void computeDensityGradient(void) {
 4996: 
 4997:       if constexpr(ibc != 0) return;
 4998: 
 4999:          // Compute the horizontal density gradient at each element.
 5000:       // It works in two steps:
 5001:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5002:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5003:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5004:       //             gradRho.r1 = rho1 - rho0
 5005:       //             gradRho.r2 = rho2 - rho0
 5006:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5007:       // 
 5008:       //  NOTE: We use de-meaned densities.
 5009: 
 5010:       ELEM(elem);
 5011: 
 5012:       if (elem->isDry) return;
 5013: 
 5014:       const int kb  = elem->kb;
 5015:       const int i34 = elem->i34;
 5016: 
 5017:       for (int k = kb + 1; k < nvrt; k++) {
 5018:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5019:          //             gradRho.r1 = rho1 - rho0
 5020:          //             gradRho.r2 = rho2 - rho0
 5021:          int icount = 0;
 5022:          double sumRx = 0.0;
 5023:          double sumRy = 0.0;
 5024:          for (int j1=0; j1<i34; j1++) { 
 5025: 
 5026:             const int j2 = elem->nxq(j1 + 1);
 5027: 
 5028:             // Pairs of consecutive neighbor elements of elem
 5029:             const Element *e1 = elem->nghbElems[j1];
 5030:             const Element *e2 = elem->nghbElems[j2];
 5031: 
 5032:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5033:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5034:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5035: 
 5036:             // Compute the density difference and the vector from elem to e1 and e2
 5037:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5038:             double diffRho1, diffRho2;
 5039:             Vector2 vec1, vec2;
 5040:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5041:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5042: 
 5043:             const double rl1 = length(vec1);
 5044:             const double rl2 = length(vec2);
 5045:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5046: 
 5047:             const double delta = cross(vec1, vec2);
 5048:             const double sintheta = abs(delta)/(rl1*rl2);
 5049: 
 5050:             // To avoid problems, avoid elements with small angle between vectors
 5051:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5052:             const bool validEq = (sintheta > sin_one_deg);
 5053: 
 5054:             if (validEq) {
 5055:                // Solve the system of equations to get the density gradient at elem
 5056:                icount++;
 5057:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5058:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5059:                sumRx += Rx;
 5060:                sumRy += Ry;
 5061:             }
 5062:          } // for j1
 5063: 
 5064:          // Compute the average density gradient at elem
 5065:          if (icount==0) {
 5066:            // Bad mesh quality; bail out with 0 b-cc
 5067:            elem->gradRho[k] = {0.0, 0.0};
 5068:          } else {
 5069:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5070:          }
 5071: 
 5072:       } // for k
 5073: 
 5074:    }
 5075: 
 5076:    __global__ void computeBaroclinicTerm(void) {
 5077:    // Computes the baroclinic term at sides (at half levels).
 5078:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5079:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5080: 
 5081:       if (ibc == 1) return;
 5082: 
 5083:       SIDE(side);
 5084: 
 5085:       if (side->isDry) return;
 5086: 
 5087:       const Element *e1 = side->elems[0];
 5088:       const Element *e2 = side->elems[1];      
 5089:       const int kb = side->kb;
 5090:       
 5091:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5092: 
 5093:       // interpolates vertically the density gradient of the two elements at the half level/
 5094: 
 5095:       int k1 = max(kb, nvrt / 2);
 5096:       int k2 = max(kb, nvrt / 2);
 5097: 
 5098:       // Starts the integration at the surface and goes down to the bottom
 5099:       side->bcc[nvrt-1] = {0.0, 0.0};
 5100:       for (int k = nvrt - 2; k >= kb; k--) {
 5101:       // For each prism level (from surface to bottom)...
 5102: 
 5103:          // For both elements, interpolate density gradient at the side's half level.
 5104:          // The gradient at the side is the average of the gradients at the elements.
 5105:          // w1, w2 are used to take into account boundary sides, with just one element.
 5106:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5107:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5108:          const double wsum = w1 + w2;
 5109:          w1 = w1/wsum;
 5110:          w2 = w2/wsum;
 5111:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5112: 
 5113:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5114:          Vector2 gradRho = {0.0, 0.0};
 5115:          if (e1 != nullptr && k > kb) {
 5116:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5117:             
 5118:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5119:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5120:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5121: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5122:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5123:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5124:          }      
 5125:          if (e2 != nullptr && k > kb) {
 5126:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5127:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5128:             
 5129:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5130:          }
 5131: 
 5132:          if constexpr(ics==2) {
 5133:             assert(false && "Not implemented: ics == 2");
 5134:             // IMPLEMENT THIS XXXXXX
 5135:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5136:             // swild(1)=tmp1
 5137:             // swild(2)=tmp2
 5138:          }
 5139:          
 5140:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5141:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5142:          // CHECK INDICES!!! XXX
 5143:          const double grav3 = side->grav3();
 5144:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5145: 
 5146:       } // for
 5147: 
 5148:    }
 5149: 
 5150: 
 5151: 
 5152:    __global__ void computeHorGradientAtSide(void) {
 5153: 
 5154:       // Compute the horizontal density gradient at each element.
 5155:       // It works in two steps:
 5156:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5157:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5158:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5159:       //             gradRho.r1 = rho1 - rho0
 5160:       //             gradRho.r2 = rho2 - rho0
 5161:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5162:       // 
 5163:       //  NOTE: We use de-meaned densities.
 5164: 
 5165:       SIDE(side);
 5166: 
 5167: // printf("side->isDry: %d\n", side->isDry);
 5168:       if (side->isDry) return;
 5169: 
 5170:       // Computes the gradient of the variables at the side center.
 5171:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5172:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5173:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5174: 
 5175:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5176:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5177:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5178:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5179: 
 5180: 
 5181:    }
 5182: 
 5183: 
 5184:    __global__ void solveMomentumEquations(double time) {
 5185: 
 5186:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5187:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5188: 
 5189:       SIDE(side);
 5190: 
 5191:       if (side->isDry) 
 5192:       {
 5193:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5194: 
 5195:          return;
 5196:       }
 5197: 
 5198:       const Node *n1 = side->n1;
 5199:       const Node *n2 = side->n2;
 5200: 
 5201:       const int kb = side->kb;
 5202: 
 5203:       const double veg_h = side->veg_h();
 5204:       const double grav3 = side->grav3();
 5205: 
 5206:       if (side->is2D()) {
 5207:          // Warning: Do not use htot2, which is updated.
 5208:          const double htot = side->htot1();
 5209:          const double hhat = side->hhat;
 5210: 
 5211:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5212: 
 5213:          Vector2 tau2 = {0.0, 0.0};
 5214:           
 5215:          if constexpr(ics==1) {
 5216:             tau2 = side->tau();
 5217: 
 5218:          } else {
 5219:             assert(false && "Not implemented: ics == 2");
 5220:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5221:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5222:             // taux2=(vn1+tt1)*0.5d0
 5223:             // tauy2=(vn2+ss1)*0.5d0
 5224:          } // if ics         
 5225: 
 5226:          // hat_gam has units of m/s
 5227: 
 5228:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5229: 
 5230:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5231:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5232: 
 5233:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5234: 
 5235: 
 5236:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5237:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5238: 
 5239:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5240: 
 5241:       }
 5242:       else { // 3D
 5243: 
 5244:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5245:          // 
 5246:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5247:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5248:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5249:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5250:          // k+1 and k.
 5251: 
 5252: 
 5253:          const int ndim = nvrt - kb;
 5254:          const double zTopCanopy = side->zTopCanopy();
 5255: 
 5256:          // Initialize the tridiagonal system
 5257:          for (int k = kb + 1; k < nvrt; k++) {
 5258:             
 5259:             const int kin = k - (kb + 1);
 5260: 
 5261:             // Vertical viscosity at the face center
 5262:             const double dfz = 1e-2; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5263:  
 5264:             alow[kin] = 0.0;
 5265:             cupp[kin] = 0.0;
 5266:             bdia[kin] = 0.0;
 5267: 
 5268:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5269:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5270: 
 5271:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5272:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5273:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5274: 
 5275:             // First part: layers k, k+1
 5276:             if (k < nvrt - 1) {
 5277:                              
 5278:                if constexpr(iveg != 0) {
 5279: 
 5280:                   // If there is vegetation at this level...
 5281:                   if (zTopCanopy > side->zc[k]) {
 5282:                      // If the canopy is above the k layer...
 5283:                      
 5284:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5285:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5286:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5287:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5288: 
 5289:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5290:                      const double vmag2 = length(ut2);
 5291:                      const double vmag1 = length(side->u2[k]);
 5292:                      const double vmag = 0.5*(vmag1 + vmag2);
 5293:                      
 5294:                      // Computes the vegetation alpha at the face center
 5295:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5296: 
 5297:                      cff1 += veg_alpha_sd*dt*vmag;
 5298: 
 5299:                   } // if (zTopCanopy
 5300:                } // if iveg
 5301: 
 5302:                const double dzz = side->Dz(k + 1);
 5303:                const double tmp = dt*dfz/dzz;
 5304:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5305: 
 5306:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5307:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5308:             }
 5309: 
 5310: 
 5311:             // Second part: layers k-1, k
 5312:             if (k > kb + 1) {
 5313: 
 5314:                double cff1 = 1.0; //init \bar{c^k}
 5315: 
 5316:                if constexpr(iveg != 0) {
 5317:                   // If there is vegetation at this level...
 5318:                   if (zTopCanopy > side->zc[k-1]) {
 5319:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5320:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5321: 
 5322:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5323: 
 5324:                      const double vmag2 = length(ut2);
 5325:                      const double vmag1 = length(side->u2[k-1]);
 5326:                      const double vmag = 0.5*(vmag1 + vmag2);
 5327: 
 5328:                      // Computes the vegetation alpha at the face center
 5329:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5330:                      cff1 += veg_alpha_sd*dt*vmag;
 5331:                   } // if zTopCanopy
 5332: 
 5333:                } // if iveg
 5334: 
 5335:                const double dzz = side->Dz(k);
 5336:                const double tmp = dt*dfz/dzz;
 5337:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5338: 
 5339:                alow[kin] += cff1*dzz/6.0 - tmp;
 5340:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5341: 
 5342:             } else { // Bottom boundary
 5343:                // This occurs at the bottom, where the bottom drag is applied.
 5344: 
 5345:                bdia[kin] += dt*side->chi2; // XXXX
 5346: 
 5347:             } // if (k > kb + 1)
 5348: 
 5349: 
 5350:          } // for (int k
 5351: 
 5352: 
 5353: 
 5354:          // Computes the RHS.
 5355:          // -----------------
 5356: 
 5357:          //	BC to be imposed at the end.
 5358: 
 5359:          const Vector2 gradETP  = side->gradETP;
 5360:          const Vector2 gradPr   = side->gradPr;
 5361:          const Vector2 gradEta1 = side->gradEta1;
 5362:          const Vector2 gradEta2 = side->gradEta2;
 5363: 
 5364:          const Vector2 *btu = side->btu;
 5365:          const Vector2 *u2  = side->u2;
 5366:          const double coriolis = side->coriolis;
 5367:          const Vector2 *nuGradU = side->nuGradU;
 5368: 
 5369: 
 5370:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5371: 
 5372:          for (int k = kb + 1; k < nvrt; k++) {
 5373:             const int kin = k - kb - 1;
 5374: 
 5375:             const double dz_0 = side->Dz(k);
 5376:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5377: 
 5378:             rrhs[kin] = {0.0, 0.0};
 5379:             double dz = 0.0;
 5380: 
 5381:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5382:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5383:             if (k < nvrt  ) dz += dz_1;
 5384:             if (k > kb + 1) dz += dz_0;
 5385: 
 5386:             // Elevation gradient, atmospheric pressure and tidal potential
 5387:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5388: 
 5389:             // Coriolis, advection, wind stress, and horizontal viscosity
 5390:             if (k < nvrt - 1) {
 5391: 
 5392: 
 5393:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5394:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5395:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5396:                                                 
 5397: 
 5398:                //diff stress tensors 1006
 5399:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5400:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5401:                   assert(false && "Not implemented: itur == 5");
 5402:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5403:                }
 5404: 
 5405:             } else { // k == nvrt - 1 SURFACE
 5406:                Vector2 tau2 = {0.0, 0.0};
 5407:                if constexpr(ics==1) {
 5408:                   tau2 = side->tau();
 5409:       
 5410:                } else {
 5411:                   assert(false && "Not implemented: ics == 2");
 5412:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5413:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5414:                   // taux2=(vn1+tt1)*0.5d0
 5415:                   // tauy2=(vn2+ss1)*0.5d0
 5416:                } // if ics
 5417: 
 5418:                rrhs[kin] += dt*tau2;
 5419: 
 5420:             } // if k<nvrt
 5421: 
 5422:             if (k > kb + 1) {
 5423:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5424:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5425:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5426: 
 5427:                // diff stress tensors 1006
 5428:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5429:                   assert(false && "Not implemented: itur == 5");
 5430:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5431:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5432:                }
 5433: 
 5434:             } // if k>kbs + 1
 5435: 
 5436:             // Baroclinic
 5437:             Vector2 *bcc = side->bcc;
 5438:             if constexpr(ibc == 0) {
 5439:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5440:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5441: 
 5442:             } // if ibc==0
 5443: 
 5444:          } // k=kb + 1,nvrt
 5445: 
 5446: 
 5447:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5448: 
 5449:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5450:             const int kin = k - kb - 1;
 5451: 
 5452:             // Velocity is always clamped to maximum values
 5453:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5454:          } // k
 5455: 
 5456:       } // if side->is2D()
 5457:       
 5458: 
 5459:       // Impose velocity boundary condition at the bottom
 5460:       if constexpr(imm == 2) { // 3D bed deformation model
 5461:          double dep;
 5462:          Vector2 vel;
 5463: 
 5464:          assert(false && "Not implemented: imm == 2");
 5465:          //update_bdef(time, x0, y0, dep, vel);
 5466:          // side->u2[kb] = vel;
 5467: 
 5468:       } else { // imm = 0 or 1
 5469:          if (side->Cd() == 0.0) {
 5470:             side->u2[kb] = side->u2[kb + 1];
 5471: 
 5472:          } else if (side->is3D()) { // 3D no slip bottom   
 5473:             side->u2[kb] = {0.0, 0.0};
 5474:          }
 5475:           
 5476:       } // if imm
 5477: 
 5478:       // The velocities below the bottom level are set to zero
 5479:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5480: 
 5481: 
 5482:    }
 5483: 
 5484: 
 5485:    __global__ void applyMomentumBC(void) {
 5486: 
 5487:       SIDE_BND(sideBnd);
 5488: 
 5489:       Side *side = sideBnd->side;
 5490:       const BoundarySegment *segment = sideBnd->segment;
 5491:       const Node *n1 = side->n1;
 5492:       const Node *n2 = side->n2;
 5493: 
 5494:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5495: 
 5496:       const bool isLand = segment->isLand;
 5497:       const int ifltype = segment->ifltype;
 5498: 
 5499:       const int kb = side->kb;
 5500: 
 5501:       if (!isLand && ifltype != 0) {
 5502:          const Vector2 *ubc = sideBnd->ubc;
 5503:   
 5504:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5505:             
 5506:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5507:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5508: 
 5509:             if (ifltype == -1) {
 5510:                // Flather 1
 5511: 
 5512:                const double depth = side->depth();
 5513: 
 5514:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5515: 
 5516:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5517: 
 5518:                side->u2[k] = vnorm*side->n;
 5519: 
 5520:             } else if (ifltype == -2) { // Discharge
 5521: 
 5522:                const double eta1 = side->eta1();
 5523:                const double eta2 = side->eta2();
 5524:                const double htot = side->htot2();
 5525: 
 5526:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5527:                assert(false && "Not implemented: Discharge bc");
 5528:                // const double dischrg = discharge(eta1);
 5529:                const double dischrg = 0.0; // XXX REMOVE
 5530:                
 5531: 
 5532:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5533: 
 5534:                const double vnorm = dischrg*eta2/htot;
 5535: 
 5536:                side->u2[k] = vnorm*side->n;
 5537: 
 5538:             }
 5539:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5540:                const double vnorm = dot(side->u2[k], side->n);
 5541: 
 5542:                double rat;
 5543:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5544:                else              rat = segment->vobc2; // outgoing
 5545: 
 5546:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5547: 
 5548:             }
 5549:             else { // not Flather or 3D radiation
 5550:                side->u2[k] = ubc[k];
 5551: 
 5552:             } // if (segment->ifltype...
 5553: 
 5554:          }
 5555: 
 5556:       }
 5557:       else if (isLand) { // if it is land boundary side
 5558: 
 5559:          if constexpr(islip == 0) { // free slip
 5560: 
 5561:             for (int k = kb; k < nvrt; k++) {
 5562: 
 5563:                const Vector2 t = side->t();
 5564:                const Vector2 n = side->n;
 5565: 
 5566:                double vnorm = 0.0; // for most cases
 5567:                const double vtan = dot(side->u2[k], t);
 5568:                
 5569:                side->u2[k] = vtan*t - vnorm*n;
 5570: 
 5571:             }
 5572: 
 5573:          } else { // no slip
 5574:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5575: 
 5576:          }
 5577:       } // if (side segment type...
 5578: 
 5579:    
 5580: 
 5581:    }
 5582: 
 5583: 
 5584:    __global__ void shapiroFilter1(void) {
 5585:       // First step of the Shapiro filter (normally used if indvel<=0)
 5586:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5587: 
 5588:       SIDE(side);
 5589: 
 5590:       // Only internal wet sides are processed
 5591:       if (side->isDry || !(side->isInternal())) return;
 5592: 
 5593:       const int kb = side->kb;
 5594: 
 5595:       for (int mm = 0; mm < niter_shap; mm++) {
 5596: 
 5597:          for (int k = kb + 1; k < nvrt; k++) {
 5598:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5599:             Vector2 suru = {0.0, 0.0};
 5600: 
 5601:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5602: 
 5603:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5604: 
 5605:                int kin = k;
 5606:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5607:                
 5608:                if constexpr(ics==1) {
 5609:                   suru += nSide->u2[kin];
 5610: 
 5611:                } else {
 5612:                   assert(false && "Not implemented: ics == 2");
 5613:                   // Vector2 vn1, vn2;
 5614:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5615:                   // suru=suru+vn1;
 5616:                   // surv=surv+vn2;
 5617:                }
 5618:             }
 5619: 
 5620: 
 5621:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5622: 
 5623:          }
 5624:       }
 5625:    }
 5626: 
 5627:    __global__ void shapiroFilter2(void) {
 5628:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5629: 
 5630:       SIDE(side);
 5631: 
 5632:       if (side->isDry || !(side->isInternal())) return;
 5633: 
 5634:       const int kb = side->kb;
 5635: 
 5636:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5637: 
 5638:       if (side->is2D()) {
 5639:          side->u2[kb + 1] = side->bcc[kb + 1];
 5640:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5641: 
 5642:       } else {
 5643:          // 3D
 5644:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5645:          
 5646:       }
 5647: 
 5648:    }
 5649: 
 5650: 
 5651:    __global__ void ul0UpdateZCoords(void) {
 5652:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5653:       
 5654:       NODE(node);      
 5655: 
 5656: 
 5657:       if (node->isDry2()) { 
 5658: 
 5659:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5660: 
 5661:          if constexpr(ivcor != 1) node->kb = 0;
 5662: 
 5663:       } else {
 5664: 
 5665:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5666:          node->updateKb();
 5667: 
 5668:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5669: 
 5670:       }
 5671: 
 5672:       // We use the temp.b field to store the previous state of isDry.
 5673:       node->tmp.b = node->isDry;
 5674: 
 5675:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5676:       node->isDry = true;
 5677: 
 5678:    }
 5679: 
 5680:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5681:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5682:    {
 5683:       ELEM(elem);
 5684: 
 5685:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5686: 
 5687:       // All the nodes of a wet element are wet.
 5688:       if (!elem->isDry) {
 5689:          elem->nodes[0]->isDry = false;
 5690:          elem->nodes[1]->isDry = false;
 5691:          elem->nodes[2]->isDry = false;
 5692:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5693: 
 5694:       }
 5695: 
 5696: 
 5697:       elem->kb = 0;
 5698: 
 5699:       if (elem->isDry) return;
 5700: 
 5701:       // Wet
 5702:       const Node *n1 = elem->nodes[0];
 5703:       const Node *n2 = elem->nodes[1];
 5704:       const Node *n3 = elem->nodes[2];  
 5705:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5706: 
 5707:    //    if(elem->isDry2()) { // XXXX
 5708:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5709:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5710:    //        call parallel_abort(errmsg)
 5711:    //    }
 5712: 
 5713: 
 5714:       // Computes element's kb as the minimum of the nodes' kb.
 5715:       const int kb1 = n1->kb;
 5716:       const int kb2 = n2->kb;
 5717:       const int kb3 = n3->kb;
 5718:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5719: 
 5720: 
 5721:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5722: 
 5723: 
 5724:       // Computes the element z as the mean of the nodes z.
 5725:       for (int k = elem->kb; k < nvrt; k++) {
 5726: 
 5727:          // Compute the element z as the mean of the nodes z.
 5728:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5729:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5730:          elem->z[k] /= elem->i34;
 5731: 
 5732:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5733:       }
 5734:                   
 5735:    }
 5736: 
 5737:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5738:    {
 5739:       NODE(node);
 5740:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5741: 
 5742:       if (it == iths) return;
 5743: 
 5744: 
 5745:       if(!node->isDry && node->tmp.b) { // rewetted
 5746:          for (int k=0; k < nvrt; k++) {
 5747: 
 5748:             Vector3 utmp={0.0, 0.0, 0.0};
 5749: 
 5750:             double ttmp=0.0;
 5751:             double stmp=0.0;
 5752:             int icount=0;
 5753:             for (int j = 0; j < node->numNodes; j++) {
 5754: 
 5755: 
 5756:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5757:                if (!node->isDry) { // all indices extended
 5758:                   icount++;
 5759: 
 5760:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5761:                   utmp += node->uvw2(k);
 5762:                   
 5763:                   ttmp += node->tracers[k].tracer[0]; 
 5764:                   stmp += node->tracers[k].tracer[1]; 
 5765:                }
 5766:             }
 5767: 
 5768:             if(icount > 0) {
 5769:                const double inv_icount = 1.0/icount;
 5770:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5771:                node->w2[k]     = inv_icount*utmp.z;
 5772:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5773:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5774:             }
 5775:          }
 5776:       }
 5777:    }
 5778: 
 5779: 
 5780:    __global__ void ul0UpdateSides(int it, int iths) {
 5781: 
 5782:       SIDE(side);
 5783: 
 5784:       // A side is wet if and only if at least one of its elements is wet.
 5785:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5786: 
 5787:       const Node *n1 = side->n1;
 5788:       const Node *n2 = side->n2;
 5789:       const int kb1 = n1->kb;
 5790:       const int kb2 = n2->kb;
 5791: 
 5792:       side->kb = 0; // dry
 5793: 
 5794:       if (isWet) {
 5795: 
 5796:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5797: 
 5798:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5799: 
 5800:          side->kb = min(kb1, kb2);
 5801: 
 5802:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5803: 
 5804:          for (int k = side->kb; k < nvrt; k++) {
 5805:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5806: 
 5807:          
 5808:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5809: 
 5810:             // Compute velocity for re-wetted sides 
 5811:             if ((it != iths) && (side->isDry && isWet)) {
 5812:             
 5813:                Vector2 utmp={0.0, 0.0};
 5814: 
 5815:                int icount=0;
 5816: 
 5817:                // For all the sides on the two elements that share this side
 5818:                for (int j=0; j < 2; j++) {
 5819:                   const Element *elem = side->elems[j];
 5820:                   if (elem == nullptr) continue;
 5821: 
 5822:                   for (int jj=0; jj < elem->i34; jj++) {
 5823:                      const Side *nSide = elem->sides[jj];
 5824:                      if (nSide->isDry) continue;
 5825: 
 5826:                      icount++;
 5827:                      utmp += nSide->u2[k];                     
 5828:                   }
 5829:                }
 5830:                   
 5831:                assert(icount > 0 && "No wet sides around this side");
 5832:                if (icount > 0)  side->u2[k] = utmp/icount;
 5833:                   
 5834:             } // if ((it != iths) && (side->isDry && isWet))
 5835: 
 5836:          } // for k
 5837: 
 5838:       } // if isWet
 5839:    
 5840:       side->isDry = !isWet;
 5841: 
 5842:    }
 5843: 
 5844: 
 5845:    __global__ void zeroNodalVelocities(void) {
 5846:       NODE(node);
 5847: 
 5848:       for (int k = 0; k < nvrt; k++) {
 5849:          node->u2[k]   = {0.0, 0.0};
 5850:          node->w2[k]   = 0.0;
 5851:          node->utmp[k] = {0.0, 0.0};
 5852:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5853:       }
 5854:    }
 5855: 
 5856:  
 5857: 
 5858:    __global__ void computeNodalVerticalVelocities1(void) {
 5859:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5860:    // Adds the element's vertical velocity times the element's area.
 5861:       ELEM(elem);
 5862: 
 5863:       for (int j = 0; j < elem->i34; j++) {
 5864:          Node *node = elem->nodes[j];
 5865: 
 5866:          for (int k = node->kb; k < nvrt; k++) {
 5867:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5868:          }
 5869:          atomicAdd(&(node->tmp.d), elem->area);
 5870:       }
 5871:    }
 5872: 
 5873:    __global__ void computeNodalVerticalVelocities2(void) {
 5874:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5875:    // Divides by the total area of the elements sharing the    node.
 5876:       NODE(node);
 5877: 
 5878:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5879:    }
 5880: 
 5881: 
 5882:    __global__ void computeNodalHorizontalVelocities1(void) {
 5883:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5884:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5885: 
 5886:       ELEM(elem);
 5887: 
 5888:       const int kb = elem->kb;
 5889:       const bool isTri = elem->isTri();
 5890: 
 5891:       if constexpr(indvel <= 0) {
 5892:          // Assuming discontinoius hvel.
 5893: 
 5894: 
 5895:          if (isTri) { // For triangles
 5896:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5897:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5898: 
 5899:             for (int j = 0; j < 3; j++) {
 5900:                // For every node of the triangle...
 5901:                Node *node = elem->nodes[j];
 5902: 
 5903:                const Side *s1 = elem->sides[j];
 5904:                const Side *s2 = elem->sides[(j + 1) % 3];
 5905:                const Side *s3 = elem->sides[(j + 2) % 3];
 5906: 
 5907:                const int numElements = node->numElements;
 5908:                const double inv_numElements = 1.0/numElements;
 5909: 
 5910:                for (int k = kb; k < nvrt; k++)  {
 5911:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5912:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5913:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5914:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5915:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5916:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5917: 
 5918:                }
 5919: 
 5920:             }
 5921:          }
 5922:          else { // For quads
 5923:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5924: 
 5925:          }
 5926: 
 5927:       }
 5928:       
 5929:    }
 5930: 
 5931: 
 5932:    __global__ void computeNodalHorizontalVelocities2(void) {
 5933:       NODE(node);
 5934: 
 5935:       for (int k = 0; k < nvrt; k++) {
 5936:          node->u2[k] = node->utmp[k];
 5937:          node->w2[k] = node->w2[k];
 5938:       }
 5939:       
 5940:    }   
 5941: 
 5942:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5943:    // XXXX I'm not sure where I got this function from. 
 5944:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5945:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5946:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5947:    // It uses the utmp array as a temporary array to store the velocities.
 5948: 
 5949:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5950: 
 5951:       SIDE(side);
 5952: 
 5953:       const int kb = side->kb;
 5954: 
 5955:       Node *n1 = side->n1;
 5956:       Node *n2 = side->n2;
 5957: 
 5958:       for (int k = kb; k < nvrt; k++) {
 5959: 
 5960:          // Cast the u2 vector into a Vector2 
 5961:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5962:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5963: 
 5964:          n1_u2 = side->u2[k]/n1->numSides;
 5965:          n2_u2 = side->u2[k]/n2->numSides;
 5966: 
 5967:       }
 5968: 
 5969: 
 5970:    }
 5971: 
 5972:    __global__ void resetVelocityOpenBndNodes(void) {
 5973:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5974: 
 5975:       NODE_BND(nodebnd);
 5976: 
 5977:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5978:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 5979:       }
 5980: 
 5981:    }
 5982: 
 5983: 
 5984:    __global__ void setVelocityOpenBndNodes(void) {
 5985:    // For open boundary nodes sets their velocity to the imposed values.
 5986: 
 5987:       SIDE_BND(sidebnd);
 5988: 
 5989:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5990:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5991:          // to its segment to the average of the side velocity.
 5992: 
 5993:          for (int k = 0; k < nvrt; k++) {
 5994:             Node *n1 = sidebnd->side->n1;
 5995:             Node *n2 = sidebnd->side->n2;
 5996: 
 5997: 
 5998:             Vector2 n1_u2(n1->u2[k]);
 5999:             Vector2 n2_u2(n2->u2[k]);
 6000: 
 6001:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6002:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6003:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6004:             }
 6005:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6006:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6007:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6008:             }
 6009: 
 6010:          }
 6011: 
 6012:       }
 6013: 
 6014:    }
 6015: 
 6016: 
 6017:    __global__ void computeVerticalVelocity(void) {
 6018:       // Computes the vertical velocity at the (2D) element's centroid.
 6019:       // In this function we will be considering volumetric elements, with side faces and a 
 6020:       // bottom and a top face. We will call them SFs, BF and TF.
 6021:       // It computes the flux coming from BF and the SFs.
 6022:       // If the bed is moving, it takes that into account.
 6023:       // Since water is incompressible, the integral of the velocity times the normal vector
 6024:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6025:       // and the BF is equal to the flux going out from the TF.
 6026:       // TF = - BF - sum(SFs).
 6027:       // It then computes the horizontal velocity at the center of TF.
 6028:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6029:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6030:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6031: 
 6032:       ELEM(elem);
 6033: 
 6034:       if (elem->isDry) return;
 6035: 
 6036:       const int kb = elem->kb;
 6037:       const bool isTri = elem->isTri();
 6038: 
 6039:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6040: 
 6041:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6042:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6043:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6044: 
 6045:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6046: 
 6047:       double area3D;
 6048: 
 6049:       // Bottom face flux
 6050:       double bottomFlux = 0.0;
 6051:       Vector2 u2meanBottom = {0.0, 0.0};
 6052:       const Vector2 gradh = elem->grad2(&Node::depth);
 6053:       if constexpr(imm==2) {
 6054:          Vector3 ubed;
 6055: 
 6056:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6057:          // updateBDEF(ubed);
 6058:      
 6059:          // const double bflux0 = dot(ubed, elem_n1);
 6060: 
 6061:          // elem->w[kb] += ubed.z;
 6062:       }
 6063:       else {
 6064:          Vector2 umean;
 6065:          if constexpr(ics == 1) {
 6066:             u2meanBottom = elem->mean(kb, &Side::u2);
 6067:          }
 6068:          else {
 6069:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6070:          }
 6071: 
 6072:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6073:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6074: 
 6075:          bottomFlux = - dot(gradh, u2meanBottom);
 6076:       } // if imm
 6077: 
 6078:       // Compute w for kb+1 to nvrt-1
 6079:       for (int l = kb; l < nvrt - 1; l++) {
 6080: 
 6081:          // normal vector to the top face of the "volumetric" element (3D)
 6082:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6083: 
 6084:          // Compute the total flux at the sides
 6085:          double sideFlux = 0.0;
 6086:          Vector2 u2top = {0.0, 0.0};
 6087:          for (int j = 0; j < elem->i34; j++) {
 6088:             const Side *side = elem->sides[j];
 6089: 
 6090:             const double sideArea = side->area(l);
 6091:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6092:             const double sign = elem->ssign[j]; 
 6093: 
 6094:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6095:          }
 6096:          
 6097:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6098:          //velocities at the centers of the sides
 6099:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6100: 
 6101:          // The flx at the top ace can be computed from the other flows.
 6102:          const double topFlux = - sideFlux - bottomFlux;
 6103:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6104: 
 6105:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6106: 
 6107:          elem_n1 = elem_n2;
 6108: 
 6109:          bottomFlux = - topFlux;
 6110:       }
 6111:    }  
 6112: 
 6113: 
 6114: 
 6115: 
 6116: 
