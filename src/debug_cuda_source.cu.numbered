  805:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  806:       // Check if the point (xt,yt) is inside the element
  807:       double shpCoords[4];
  808: 
  809:       bool res = computeShapeCoords(xt, shpCoords, fiNo);
  810: 
  811:       return res;
  812:    }
  813: 
  814:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  815:       // Check if the point (xt,yt) is inside the element.
  816:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  817:       double shpCoords[4];
  818: 
  819:       Vector2 tmp_xt = xt;
  820:       const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
  821:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords);
  822: 
  823:       if (fixCoords && res) xt = tmp_xt;
  824: 
  825:       return res;
  826:    }
  827: 
  828:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  829:    {
  830:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  831:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  832:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  833:       
  834:    }
