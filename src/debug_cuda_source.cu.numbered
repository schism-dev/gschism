 4365:    __global__ void computeFlowBcVelocities(double time) {
 4366: 
 4367:       SIDE_BND(sideBnd);
 4368: 
 4369:       const Side *side = sideBnd->side;
 4370:  
 4371:       const bool isDry = side->isDry;
 4372:       const bool isLand = sideBnd->segment->isLand;
 4373: 
 4374:    
 4375:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4376: 
 4377:       if (isDry || isLand) return;
 4378: 
 4379:       // For wet sides in open boundaries...
 4380:       const Vector2 n = side->n;
 4381:       const BoundarySegment *segment = sideBnd->segment;
 4382: 
 4383:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4384: 
 4385:       const int ifltype = segment->ifltype;
 4386: 
 4387:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4388:       const Vector2 r_nuth0 = r_uth0*n;
 4389: 
 4390: 
 4391:       if (ifltype == 1 || ifltype == 2) {
 4392:       
 4393:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4394: 
 4395:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4396:          
 4397:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4398:          
 4399:       } else if (ifltype == -1) { // Flather 1
 4400: 
 4401:          for (int k = 0; k < nvrt; k++) {
 4402: 
 4403:             // uth is the normal vel.; no ramp up
 4404:             const double uth = sideBnd->nuth(k);
 4405:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4406: 
 4407:             sideBnd->ubc[k] += uth*n;
 4408:          }
 4409: 
 4410:       } else if (ifltype == 3 || ifltype == 5) {
 4411:          // vnth0=0 !normal vel.
 4412: 
 4413:          Vector2 r_u1_bar = {0.0, 0.0};
 4414:          // Computes the contribution to the velocity from all tide frequencies
 4415:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4416: 
 4417:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4418:             const Vector2 umo  = sideBnd->umo(jfr); 
 4419: 
 4420:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4421:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4422:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4423:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4424: 
 4425:          }
 4426: 
 4427: 
 4428:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4429: 
 4430:       } // if (ifltype = 3 || ifltype == 5
 4431: 
 4432: 
 4433: 
 4434:    }
 4435: 
 4436:    __global__ void computeElevationBoundaryConditions(double time) {
 4437:       // Compute elevation essential boundary conditions 
 4438: 
 4439:       NODE_BND(nodeBnd); // Each boundary node.
 4440: 
 4441:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4442: 
 4443:       const Node *node = nodeBnd->node;
 4444:       const BoundarySegment *segment = nodeBnd->segment;
 4445:       const int iettype = segment->iettype;
 4446:       
 4447: 
 4448:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4449:       double eic = 0.0;
 4450:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4451:       else                 eic = 0.0;
 4452: 
 4453:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4454:       const double r_eth = ramp*nodeBnd->eth;
 4455:       double r_eta1_bar = 0.0;
 4456: 
 4457: 
 4458:       // Compute tide elevation
 4459:       if (iettype == 3 || iettype == 5) {   
 4460: 
 4461:          if constexpr(iloadtide==1) { // loading tide
 4462:             assert(false && "Loading tide not implemented");
 4463:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4464:          }
 4465:          
 4466:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4467: 
 4468:             const double efa  = nodeBnd->efa[jfr]; 
 4469:             const double emo  = nodeBnd->emo[jfr]; 
 4470: 
 4471:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4472:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4473:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4474: 
 4475:          } // for jfr
 4476: 
 4477:       } // if iettype
 4478: 
 4479:       switch (iettype) {
 4480:          case 1:
 4481:          case 2:
 4482:          case 4:
 4483:             nodeBnd->elbc = r_eic + r_eth;
 4484:             break;
 4485:          case 3:
 4486:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4487:             break;
 4488:          case 5:
 4489:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4490:             break;
 4491:       } // switch
 4492: 
 4493: 
 4494:       //Add inverse barometric effects
 4495:       if (iettype != 0 && inv_atm_bnd == 1) {
 4496:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4497:       }
 4498: 
 4499:    }
 4500: 
 4501: 
 4502:    __global__ void computeHorizontalViscosity(void) { 
 4503: 
 4504:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4505: 
 4506:       SIDE(side);
 4507: 
 4508:       if (side->isDry) return;
 4509: 
 4510:       for (int k = 0; k < nvrt; k++) {
 4511:          side->nuGradU[k] = {0.0, 0.0};
 4512:       }
 4513: 
 4514:       if constexpr(ihorcon == 1) {
 4515:          for (int k = side->kb; k < nvrt - 1; k++) {
 4516:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4517:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4518:             // By Zhang and Baptista.
 4519: 
 4520:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4521:             // This is a standard discretization of the Laplacian operator.
 4522:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4523:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4524:             // Gamma is hvis_coef0 in the code.
 4525:             // The value of gamma needs to be < 0.5.
 4526: 
 4527:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4528:             // side under consideration in each of the two possible elements that share the side.
 4529:             Vector2 sumU = {0.0, 0.0};
 4530:             for (int l = 0; l < 2; l++) {
 4531:                const Element *elem = side->elems[l];
 4532: 
 4533:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4534: 
 4535:                // Find the local index of the side in the element
 4536:                const int idxSide = elem->sideLocalIdx(side);
 4537:                // Find the two sides that are connected to the side under consideration
 4538:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4539:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4540: 
 4541:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4542: 
 4543:             }
 4544: 
 4545:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4546:    
 4547:          }
 4548:       }
 4549:       else if constexpr(ihorcon == 2) {
 4550:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4551:       }
 4552: 
 4553: 
 4554:    }
 4555: 
 4556: 
 4557:    __global__ void setEssentialBC(void) {
 4558:       // Set essential boundary conditions 
 4559:       NODE(node); // Each boundary node
 4560:       NodeBoundary *nodeBnd = node->nodeBnd;
 4561:       
 4562: // nodeBnd->isEssentialBC = true;      
 4563:       // Check if this node has essential BC
 4564:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4565:          // Verify BC value is valid
 4566:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4567: 
 4568:        
 4569:          // Set diagonal to 1 and zero off-diagonals
 4570:          node->coeffDiag = 1.0;
 4571: 
 4572:          for (int j = 0; j < node->numNodes; j++) {
 4573:                node->coeffMatrix[j] = 0.0;
 4574:          }
 4575:          
 4576:          // Set solution and RHS to BC value
 4577:          node->mX  = nodeBnd->elbc;
 4578:          node->qel = nodeBnd->elbc;
 4579: 
 4580:       } else {
 4581:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4582: 
 4583:          for (int j = 0; j < node->numNodes; j++) {
 4584:                Node* nbNode = node->nodes[j];
 4585:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4586:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4587:                   // Verify neighbor's BC value
 4588:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4589: 
 4590:                   // Subtract contribution to RHS
 4591:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4592:                   node->coeffMatrix[j] = 0.0;  
 4593:                }
 4594:          }
 4595:       }
 4596:    }
 4597: 
 4598: 
 4599:    __global__ void updateElevation(void) {
 4600:       NODE(node);
 4601: 
 4602: 
 4603:       node->eta2 = node->mX;
 4604: 
 4605:       node->updateZCoordData();
 4606:    }
