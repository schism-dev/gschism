 8524: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8525:    Element *elems = mesh->localElemData;
 8526: 
 8527:    *addr = elems;
 8528:    *sizeElement = sizeof(Element);
 8529:    switch (varCode) {
 8530:       case (int)VarCode::z:
 8531:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8532:          *sizeType = sizeof(double);
 8533:          break;
 8534:       case (int)VarCode::x:
 8535:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8536:          *sizeType = sizeof(Vector2);
 8537:          break;
 8538:       case (int)VarCode::gradETP:
 8539:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8540:          *sizeType = sizeof(Vector2);
 8541:          break;
 8542:       case (int)VarCode::area:
 8543:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8544:          *sizeType = sizeof(double);
 8545:          break;
 8546:       case (int)VarCode::depth:
 8547:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8548:          *sizeType = sizeof(double);
 8549:          break;
 8550:       case (int)VarCode::radius:
 8551:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8552:          *sizeType = sizeof(double);
 8553:          break;
 8554:       case (int)VarCode::ghat:
 8555:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8556:          *sizeType = sizeof(Vector2);
 8557:          break;
 8558:       case (int)VarCode::kb:
 8559:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8560:          *sizeType = sizeof(int);
 8561:          break;
 8562:       case (int)VarCode::isdry:
 8563:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8564:          *sizeType = sizeof(int);
 8565:          break;            
 8566:       case (int)VarCode::w:
 8567:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8568:          *sizeType = sizeof(double);
 8569:          break;
 8570:       case (int)VarCode::FaceIndices:
 8571:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8572:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8573:          *sizeType = sizeof(Node);
 8574:          break;
 8575:       default:
 8576:          *offset = -1;
 8577:    }
 8578: }
