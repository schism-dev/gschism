 4515:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4516: 
 4517:       NODE_BND(nodeBnd);
 4518: 
 4519:       Node *node = nodeBnd->node;
 4520: 
 4521:       node->ETP = 0.0;
 4522: 
 4523:       for (int j=0; j<ntip; j++) {
 4524: 
 4525:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4526:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4527:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4528: 
 4529:          if constexpr(iloadtide==1) { // loading tide
 4530:             assert(false && "Loading tide not implemented");
 4531:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4532:          }
 4533:          
 4534:       }
 4535:       
 4536:    }
