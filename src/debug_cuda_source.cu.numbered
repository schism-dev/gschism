 1062: 
 1063:    double mP; // Search direction for conjugate gradient method
 1064:    double mR; // Residual for conjugate gradient method
 1065:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1066:    double mX; // Solution for conjugate gradient method
 1067: 
 1068:    // Meteorological forcing
 1069:    Vector2 u_air;
