 4363:    __global__ void computeFlowBcVelocities(double time) {
 4364: 
 4365:       SIDE_BND(sideBnd);
 4366: 
 4367:       const Side *side = sideBnd->side;
 4368:  
 4369:       const bool isDry = side->isDry;
 4370:       const bool isLand = sideBnd->segment->isLand;
 4371: 
 4372:    
 4373:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4374: 
 4375:       if (isDry || isLand) return;
 4376: 
 4377:       // For wet sides in open boundaries...
 4378:       const Vector2 n = side->n;
 4379:       const BoundarySegment *segment = sideBnd->segment;
 4380: 
 4381:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4382: 
 4383:       const int ifltype = segment->ifltype;
 4384: 
 4385:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4386:       const Vector2 r_nuth0 = r_uth0*n;
 4387: 
 4388: 
 4389:       if (ifltype == 1 || ifltype == 2) {
 4390:       
 4391:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4392: 
 4393:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4394:          
 4395:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4396:          
 4397:       } else if (ifltype == -1) { // Flather 1
 4398: 
 4399:          for (int k = 0; k < nvrt; k++) {
 4400: 
 4401:             // uth is the normal vel.; no ramp up
 4402:             const double uth = sideBnd->nuth(k);
 4403:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4404: 
 4405:             sideBnd->ubc[k] += uth*n;
 4406:          }
 4407: 
 4408:       } else if (ifltype == 3 || ifltype == 5) {
 4409:          // vnth0=0 !normal vel.
 4410: 
 4411:          Vector2 r_u1_bar = {0.0, 0.0};
 4412:          // Computes the contribution to the velocity from all tide frequencies
 4413:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4414: 
 4415:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4416:             const Vector2 umo  = sideBnd->umo(jfr); 
 4417: 
 4418:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4419:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4420:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4421:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4422: 
 4423:          }
 4424: 
 4425: 
 4426:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4427: 
 4428:       } // if (ifltype = 3 || ifltype == 5
 4429: 
 4430: 
 4431: 
 4432:    }
 4433: 
 4434:    __global__ void computeElevationBoundaryConditions(double time) {
 4435:       // Compute elevation essential boundary conditions 
 4436: 
 4437:       NODE_BND(nodeBnd); // Each boundary node.
 4438: 
 4439:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4440: 
 4441:       const Node *node = nodeBnd->node;
 4442:       const BoundarySegment *segment = nodeBnd->segment;
 4443:       const int iettype = segment->iettype;
 4444:       
 4445: 
 4446:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4447:       double eic = 0.0;
 4448:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4449:       else                 eic = 0.0;
 4450: 
 4451:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4452:       const double r_eth = ramp*nodeBnd->eth;
 4453:       double r_eta1_bar = 0.0;
 4454: 
 4455: 
 4456:       // Compute tide elevation
 4457:       if (iettype == 3 || iettype == 5) {   
 4458: 
 4459:          if constexpr(iloadtide==1) { // loading tide
 4460:             assert(false && "Loading tide not implemented");
 4461:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4462:          }
 4463:          
 4464:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4465: 
 4466:             const double efa  = nodeBnd->efa[jfr]; 
 4467:             const double emo  = nodeBnd->emo[jfr]; 
 4468: 
 4469:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4470:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4471:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4472: 
 4473:          } // for jfr
 4474: 
 4475:       } // if iettype
 4476: 
 4477:       switch (iettype) {
 4478:          case 1:
 4479:          case 2:
 4480:          case 4:
 4481:             nodeBnd->elbc = r_eic + r_eth;
 4482:             break;
 4483:          case 3:
 4484:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4485:             break;
 4486:          case 5:
 4487:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4488:             break;
 4489:       } // switch
 4490: 
 4491: 
 4492:       //Add inverse barometric effects
 4493:       if (iettype != 0 && inv_atm_bnd == 1) {
 4494:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4495:       }
 4496: 
 4497:    }
 4498: 
 4499: 
 4500:    __global__ void computeHorizontalViscosity(void) { 
 4501: 
 4502:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4503: 
 4504:       SIDE(side);
 4505: 
 4506:       if (side->isDry) return;
 4507: 
 4508:       for (int k = 0; k < nvrt; k++) {
 4509:          side->nuGradU[k] = {0.0, 0.0};
 4510:       }
 4511: 
 4512:       if constexpr(ihorcon == 1) {
 4513:          for (int k = side->kb; k < nvrt - 1; k++) {
 4514:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4515:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4516:             // By Zhang and Baptista.
 4517: 
 4518:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4519:             // This is a standard discretization of the Laplacian operator.
 4520:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4521:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4522:             // Gamma is hvis_coef0 in the code.
 4523:             // The value of gamma needs to be < 0.5.
 4524: 
 4525:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4526:             // side under consideration in each of the two possible elements that share the side.
 4527:             Vector2 sumU = {0.0, 0.0};
 4528:             for (int l = 0; l < 2; l++) {
 4529:                const Element *elem = side->elems[l];
 4530: 
 4531:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4532: 
 4533:                // Find the local index of the side in the element
 4534:                const int idxSide = elem->sideLocalIdx(side);
 4535:                // Find the two sides that are connected to the side under consideration
 4536:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4537:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4538: 
 4539:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4540: 
 4541:             }
 4542: 
 4543:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4544:    
 4545:          }
 4546:       }
 4547:       else if constexpr(ihorcon == 2) {
 4548:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4549:       }
 4550: 
 4551: 
 4552:    }
 4553: 
 4554: 
 4555:    __global__ void setEssentialBC(void) {
 4556:       // Set essential boundary conditions 
 4557:       NODE(node); // Each boundary node
 4558:       NodeBoundary *nodeBnd = node->nodeBnd;
 4559:       
 4560: // nodeBnd->isEssentialBC = true;      
 4561:       // Check if this node has essential BC
 4562:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4563:          // Verify BC value is valid
 4564:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4565: 
 4566:        
 4567:          // Set diagonal to 1 and zero off-diagonals
 4568:          node->coeffDiag = 1.0;
 4569: 
 4570:          for (int j = 0; j < node->numNodes; j++) {
 4571:                node->coeffMatrix[j] = 0.0;
 4572:          }
 4573:          
 4574:          // Set solution and RHS to BC value
 4575:          node->mX  = nodeBnd->elbc;
 4576:          node->qel = nodeBnd->elbc;
 4577: 
 4578:       } else {
 4579:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4580: 
 4581:          for (int j = 0; j < node->numNodes; j++) {
 4582:                Node* nbNode = node->nodes[j];
 4583:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4584:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4585:                   // Verify neighbor's BC value
 4586:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4587: 
 4588:                   // Subtract contribution to RHS
 4589:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4590:                   node->coeffMatrix[j] = 0.0;  
 4591:                }
 4592:          }
 4593:       }
 4594:    }
 4595: 
 4596: 
 4597:    __global__ void updateElevation(void) {
 4598:       NODE(node);
 4599: 
 4600: 
 4601:       node->eta2 = node->mX;
 4602: 
 4603:       node->updateZCoordData();
 4604:    }
