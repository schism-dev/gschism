 6218:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 6219: 
 6220:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 6221:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 6222:    //          enddo !j
 6223:    //        endif
 6224:    //      enddo !k
 6225:    //    endif !nfltype2
 6226:    }
