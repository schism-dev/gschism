  983: struct Node {
  984: 
  985:    // Geometry information
  986:    int idx;        // Index of the node
  987:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  988:    int numNodes;   // Number of nodes neighbors of this node
  989: 
  990:    Element **elements; // Array of pointers to the elements that share this node
  991:    int numElements;   // Number of elements that share this node
  992: 
  993:    Point3 p;
  994:    Vector3 u2[nvrt];
  995:    double znl[nvrt];
  996:    double lon, lat;
  997:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
  998:    double depth;
  999: 
 1000:    int kb;       // Bottom index of the node
 1001: 
 1002:    bool isDry;     // True if the node is dry
 1003: 
 1004:    int iadv;     // Advection flag
 1005: 
 1006:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1007: 
 1008:    TempVar tmp; // Temporary variable to store different types of variables
 1009: 
 1010:    // Physical information
 1011:    Tracers tr_nd0[nvrt]; // Initial tracer conc. at nodes
 1012: 
 1013:    double rho[nvrt];     // Density
 1014:    double dfv[nvrt];     // Vertical viscosity
 1015: 
 1016:    double eta1; // Elevation at nodes at previous timestep
 1017:    double eta2; // Elevation at nodes at current timestep
 1018: 
 1019:    double ETP;  // Earth Tidal Potential
 1020: 
 1021:    double pr;    // Air pressure
 1022:    double grav2; // Gravity 
 1023:    
 1024:    Vector2 dav;  // Depth averaged velocity
 1025: 
 1026:    Vector2 tau; // Wind stress vector
 1027: 
 1028:    // Vegetation parameters
 1029:    double veg_h;
 1030:    double veg_nv;
 1031:    double veg_di;
 1032:    double veg_Cd;
 1033:    double veg_h_unbent;
 1034:    double veg_di_unbent;
 1035:    double veg_nv_unbent;
 1036:    double veg_alpha_vert_mean;
 1037:    double veg_alpha0;
 1038:    double veg_alpha3D[nvrt];
 1039: 
 1040:    // Bottom drag parameters
 1041:    double Cd;       // Bottom drag coefficient
 1042:    double rough;    // Bottom roughness length
 1043:    Vector2 tau_bot; // Bottom stress vector
 1044: 
 1045:    double bdef1; // Bottom deformation at previous timestep
 1046:    double bdef2; // Bottom deformation at current timestep
 1047: 
 1048:    double qel; // RHS
 1049:    double coeffDiag; // Diagonal coefficient of the matrix
 1050:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1051: 
 1052:    double mP; // Search direction for conjugate gradient method
 1053:    double mR; // Residual for conjugate gradient method
 1054:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1055:    double mX; // Solution for conjugate gradient method
 1056: 
 1057:    // Meteorological forcing
 1058:    Vector2 u_air;
 1059:    double p_air;
 1060:    double t_air;
 1061:    double q_air;
 1062:    double wind_angle;  // Wind rotation angle
 1063: 
 1064:    __host__ __device__ void setWind(Vector2 &u) {
 1065:    // Sets the wind vector taking into account the wind rotation angle
 1066:    
 1067:       const double dir = atan2(-u.x,-u.y);
 1068:       const double speed = length(u);
 1069: 
 1070:       // Calculate new u and v components with added rotation angle
 1071:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1072:    }
 1073: 
 1074:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1075: 
 1076:    __host__ __device__ double sigmaTransitionDepth(void) const;
 1077: 
 1078:    __inline__ __device__ double Dz(int k) const { return znl[k] - znl[k-1]; }
 1079:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1080:    __inline__ __device__ double zTopCanopy(void) const { return znl[kb] + veg_h; } 
 1081: 
 1082:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1083: 
 1084:    __device__ void clearMatrixRow(void) {
 1085:       // Clear the matrix row for this node
 1086:       coeffDiag = 0.0;
 1087:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1088: 
 1089:    }
 1090: 
 1091:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1092:       // Add the value to the sparse matrix for this node
 1093:       
 1094:       if (node == this) {
 1095:          coeffDiag += value;
 1096: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1097:       } else {
 1098:          // Search (linearly)the index of the node in the array of nodes
 1099:          // XXX: This is not efficient, see if we can improve this
 1100:          int i;
 1101:          for (i = 0; i < numNodes; i++) {
 1102:             if (nodes[i] == node) {
 1103:                break;
 1104:             }
 1105:          }
 1106:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1107:          coeffMatrix[i] += value;
 1108:       }
 1109:    }
 1110: 
 1111: #ifdef BACKTRACKING
 1112:    __device__ void updateZCoordData() {
 1113:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1114: 
 1115:       // Check if node is wet
 1116:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1117: 
 1118:       if (idry) return;
 1119: 
 1120:       if constexpr(ivcor == 2) {  // SZ coordinates
 1121:          
 1122:          // Compute bottom level index
 1123:          if (depth <= mesh->h_s) {
 1124:                kb = mesh->nzlevels;
 1125:          } else {
 1126:                kb = -1;
 1127:                for (int i = 0; i < mesh->kz-1; i++) {
 1128:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1129:                      kb = i;
 1130:                      break;
 1131:                   }
 1132:                }
 1133:          }
 1134:       } 
 1135:       else if (ivcor == 1) {  // Localized sigma
 1136:          // Do nothing
 1137:       }
 1138: 
 1139:    }
 1140: #endif   
 1141: 
 1142:    __device__ double compZCoord(int k) const;
 1143: 
 1144:    __device__ void updateKb(void);
