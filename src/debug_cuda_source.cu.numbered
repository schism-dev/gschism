 7116:       for (int j = 0; j < node->numNodes; j++) {
 7117:          Node* nbNode = node->nodes[j];
 7118:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7119:       }
 7120: 
 7121:    }
 7122:    
 7123: }
