 1432:    __device__ void test(double x, double y, double z)
 1433:    {
 1434:       printf("Testing mesh for partition %d, x=%f, y=%f\n", partNum, x, y);
 1435:       for (int i = 0; i < ne; i++) {
 1436:          auto isInside = localElemData[i].containsPoint({x, y});
 1437: 
 1438:          if (isInside) {
 1439:             printf("Point %f %f %f is inside element %d\n", x, y, z, i);
 1440:             Element *elem = &localElemData[i];
 1441:             
 1442:             Vector3 u_int;
 1443: 
 1444:             // Choose the first side
 1445:             Side *side = elem->sides[0];
 1446:             int jlev = 5;  
 1447:             // RECORDAR:
 1448:             // - con y=0 no encuentra el triangulo
 1449:             // - jlev = 5, z = 0.1...
 1450:             side->btrack(5, 3000.0, 3.1, u_int);
 1451: 
 1452:          }
 1453:       }
 1454:    } 
 1455: 
 1456: }; // End of Mesh class
 1457: 
 1458: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1459:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1460: }
 1461: 
 1462: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1463:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1464: }   
 1465: 
 1466: __device__ __inline__ double min3(double a, double b, double c) {
 1467:    return min(a, min(b, c));
 1468: }
 1469: 
 1470: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1471:    return min(a, min(b, min(c, d)));
 1472: }
 1473: 
 1474: 
 1475: // Helper functions for computing the local node index at a given offset from another.
 1476: __device__ __inline__ int nxq(int offset, int index, int size) {
 1477:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1478:    // to the index to make it positive
 1479:    assert(index + offset + 16*size >= 0);
 1480:    return (index + offset + 16*size) % size;  
 1481: }
 1482: 
 1483: __device__ __inline__ int nxq(int index, int size) {
 1484:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1485:    // to the index to make it positive
 1486:    assert(index + 16*size >= 0);
 1487:    return (index + 16*size) % size; 
 1488: }
 1489: 
 1490: 
 1491: extern "C" {
 1492:    __global__ void getStructSizes(int* sizes);
 1493: 
 1494:    __global__ void printMatrix(void);
 1495: 
 1496:    __global__ void returnMatrix(double *res);
 1497: 
 1498:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1499:       // Compute the different time ramps used in the code 
 1500:       // This function is performed by just one thread
 1501: 
 1502:       if constexpr(ibc == 0) {
 1503:          if (drampbc > 0.0) {
 1504:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1505:          } else {
 1506:             rampbc = 1.0;
 1507:          }
 1508: 
 1509:          if (nws != 0 && drampwind > 0.0) {
 1510:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1511:          } else {
 1512:             rampwind = 1.0;
 1513:          }
 1514:       }
 1515: 
 1516:       if (drampwafo > 0.0) {
 1517:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1518:       } else {
 1519:          rampwafo = 1.0;
 1520:       }
 1521: 
 1522:       // For source/sinks
 1523:       if (if_source && dramp_ss > 0.0) {
 1524:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1525:       } else {
 1526:          ramp_ss = 1.0;
 1527:       }
 1528: 
 1529:       if (dramp > 0.0) {
 1530:          ramp = tanh(2.0*time/86400.0/dramp);
 1531:       } else {
 1532:          ramp = 1.0;
 1533:       }
 1534: 
 1535:    }
 1536:       
 1537: 
