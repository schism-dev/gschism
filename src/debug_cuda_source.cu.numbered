 7966: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7967:    Node *nodes = mesh->localNodeData;
 7968: 
 7969:    *addr = nodes;
 7970:    *sizeNode = sizeof(Node);
 7971: 
 7972:    switch (varCode) {
 7973:       case (int)VarCode::depth:
 7974:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7975:          *sizeType = sizeof(double);
 7976:          break;
 7977:       case (int)VarCode::eta:
 7978:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7979:          *sizeType = sizeof(double);
 7980:          break;
 7981:       case (int)VarCode::x:
 7982:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7983:          *sizeType = sizeof(Vector2);
 7984:          break;
 7985:       case (int)VarCode::z:
 7986:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7987:          *sizeType = sizeof(double);
 7988:          break;
 7989:       case (int)VarCode::kb:
 7990:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7991:          *sizeType = sizeof(int);
 7992:          break;
 7993:       case (int)VarCode::isdry:
 7994:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7995:          *sizeType = sizeof(int);
 7996:          break;         
 7997:       case (int)VarCode::w:
 7998:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7999:          *sizeType = sizeof(double);
 8000:          break;
 8001:       case (int)VarCode::u:
 8002:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8003:          *sizeType = sizeof(Vector2);
 8004:          break;         
 8005:       default:
 8006:          *offset = -1;    
 8007:    }  
 8008:    
 8009: }
