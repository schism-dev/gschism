 3810: 
 3811: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3812:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3813:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3814: 
 3815: 
 3816:    NODE(node1);
 3817: 
 3818:    node1->clearMatrixRow();
 3819:    node1->qel = 0.0;
 3820: 
 3821:    // THIS IS FOR STRUCTURES XXX
 3822:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3823: 
 3824:    
 3825:    for (int j=0; j<node1->numElements; j++) {
 3826:       // For each element connected to the node...
 3827: 
 3828:       Element *elem = node1->elements[j];
 3829: 
 3830: 
 3831: 
 3832:       // Compute the average gravity
 3833:       const double grav3 = elem->mean(&Node::grav2);
 3834: 
 3835:       // Look at the documentation for the description of the terms in the following integrals
 3836: 
 3837:       // Integral I_1 
 3838:       // \bar{\breve{H}} 
 3839:       const double hhatb = elem->mean(&Side::hhat);        
 3840: 
 3841:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3842: 
 3843:       const int id1 = elem->nodeLocalIdx(node1); 
 3844:       const double area = elem->area;
 3845: 
 3846:       if (elem->isTri()) {
 3847: 
 3848:          // To clarify the notation in this section: 
 3849:          //   i stands for the node under consideration (node1)
 3850:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3851:          const int id2 = elem->nxq(1 + id1);
 3852:          const int id3 = elem->nxq(2 + id1);
 3853:          Node *node2 = elem->nodes[id2];
 3854:          Node *node3 = elem->nodes[id3];
 3855: 
 3856:          const Point2 x1 = node1->p;
 3857:          const Point2 x2 = node2->p;
 3858:          const Point2 x3 = node3->p;
 3859: 
 3860:          // integral of phi_i*phi_j
 3861:          const double ipp_ii = (1.0/6.0 )*area;
 3862:          const double ipp_ij = (1.0/12.0)*area;
 3863:          const double ipp_ik = (1.0/12.0)*area;
 3864: 
 3865:          // integral of [(grad phi_i) * (grad phi_j)]
 3866:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3867:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3868:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3869: 
 3870:          // Computes the different components of integral I_1 of each node with respect to node i.
 3871:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3872:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3873:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3874: 
 3875:          node1->addToSparseMatrix(node1, I1_ii);
 3876:          node1->addToSparseMatrix(node2, I1_ij); 
 3877:          node1->addToSparseMatrix(node3, I1_ik);
 3878: 
 3879:       }
 3880:       else { // Quad
 3881:          // XXX IMPLEMENT THIS
 3882:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3883: 
 3884:          // To clarify the notation in this section: 
 3885:          //   i stands for the node under consideration (node1)
 3886:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3887:          const int id2 = elem->nxq(1 + id1);
 3888:          const int id3 = elem->nxq(2 + id1);
 3889:          const int id4 = elem->nxq(3 + id1);
 3890:          Node *node2 = elem->nodes[id2];
 3891:          Node *node3 = elem->nodes[id3];
 3892:          Node *node4 = elem->nodes[id4];         
 3893: 
 3894:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3895:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3896:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3897:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3898:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3899: 
 3900:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3901:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3902:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3903:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3904:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3905: 
 3906:          // Computes the different components of integral I_1 of each node with respect to node i.
 3907:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3908:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3909:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3910:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3911: 
 3912:          node1->addToSparseMatrix(node1, I1_ii);
 3913:          node1->addToSparseMatrix(node2, I1_ij); 
 3914:          node1->addToSparseMatrix(node3, I1_ik);
 3915:          node1->addToSparseMatrix(node4, I1_il);
 3916:   
 3917:       } 
 3918: 
 3919:  
 3920:       // Integral I_4
 3921:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3922:       // Where
 3923:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3924: 
 3925:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3926:       // of U over the element.
 3927:       Vector2 U = {0.0, 0.0};
 3928:       for (int m=0; m < elem->i34; m++) {      
 3929:          const Side *side = elem->sides[m];
 3930: 
 3931:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3932:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3933:       }
 3934:       U = U/elem->i34;
 3935: 
 3936: 
 3937:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3938: 
 3939: 
 3940:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3941:       const double I_4_1 = dot(gradPhi_1, U);
 3942: 
 3943: 
 3944:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3945:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3946: 
 3947:      
 3948:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3949: 
 3950:       // Additional terms 
 3951:       double vnorm = 0.0;
 3952:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3953:          Vector3 ubed = {0.0, 0.0, 0.0};
 3954:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3955: 
 3956:          Vector3 gradP = {0.0, 0.0, 1.0};
 3957:          for (int m=0; m < elem->i34; m++) {
 3958:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3959:            gradP += toVector3(gradP_2D, 0.0);
 3960:          }   
 3961:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3962:       } // imm==2
 3963: 
 3964:       if (elem->isTri()) {
 3965:          for (int l=0; l<3; l++) {
 3966: 
 3967:             Node *node = elem->nodes[l];
 3968: 
 3969:             double fac = (node == node1) ? 2.0 : 1.0;
 3970:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3971:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3972:            
 3973:          }
 3974: 
 3975: 
 3976:          if (!elem->isDry) {
 3977:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3978: 
 3979:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3980: 
 3981:          }
 3982: 
 3983:       } // isTri
 3984:       else { // isQuad
 3985:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3986:          // for (int l=0; l<4; l++) {
 3987:          //   const Node *node = elem->nodes[l];
 3988: 
 3989:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3990:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3991: 
 3992:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3993:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3994:          // }
 3995: 
 3996:       } // isQuad
 3997: 
 3998: 
 3999:      node1->qel += (dt/elem->i34)*elem->vsource;
 4000:       
 4001: 
 4002:    } // for all elements connected to the node
 4003:    
 4004: 
 4005:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4006:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4007:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4008:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4009:       // If it is an open boundary node...
 4010: 
 4011:       // At least one open bnd side, maybe two
 4012:       for (int l=0; l<2; l++) { 
 4013: 
 4014:          // Gets each of the sides sharing the node. 
 4015:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4016: 
 4017:        
 4018: 
 4019:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4020:          if (sideBnd != nullptr) {
 4021:             // If the side is on a boundary...
 4022: 
 4023:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4024: 
 4025:             // Get the boundary segment
 4026:             const BoundarySegment *sideSegment = sideBnd->segment;
 4027:             const Side *side = sideBnd->side;
 4028: 
 4029:             // Integral I_3
 4030:             if (sideSegment->ifltype != 0) {
 4031:             // Natural or Flather b.c.
 4032: 
 4033:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4034:                // especially for Flather b.c.
 4035:                double ri3 = 0.0;
 4036:                if (!side->isDry) {
 4037:                   // If the side is not dry
 4038:                   
 4039:                   // Computes the side flux of (uth, vth)
 4040:                   double Vn = 0.0;
 4041:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4042:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4043:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4044: 
 4045:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4046:                   }
 4047: 
 4048:                   ri3 = 0.5*side->len*Vn;
 4049:                }
 4050: 
 4051:                if (sideSegment->ifltype == -1) { // Flather 1
 4052: 
 4053:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4054:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4055: 
 4056:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4057:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4058:                   
 4059:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4060:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4061: 
 4062:                } 
 4063:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4064:                   // Reset ri3
 4065:                   ri3 = 0.0;
 4066: 
 4067:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4068: 
 4069:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4070: 
 4071:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4072:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4073: 
 4074:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4075:                   node1->addToSparseMatrix(node1, con0*2.0);
 4076:                   node1->addToSparseMatrix(node2, con0);
 4077: 
 4078:                } // if Flather or Discharge
 4079: 
 4080:                node1->qel -= thetai*dt*ri3;
 4081: 
 4082: 
 4083:             } // I_3
 4084:           
 4085: 
 4086:             // Integral I_5
 4087:             if(!side->isDry) {
 4088: 
 4089:                const double Unbar = dot(side->U, side->n);
 4090:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4091: 
 4092:             } // I_5
 4093: 
 4094:          } // if is boundary side
 4095: 
 4096:       } // for l
 4097: 
 4098:    } // if isbnd
 4099: 
 4100: 
 4101: }
 4102: 
 4103: 
