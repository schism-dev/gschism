 1616:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1617:       // Compute the different time ramps used in the code 
 1618:       // This function is performed by just one thread
 1619: 
 1620:       rampbc = 1.0;
 1621:       if constexpr(ibc == 0) {
 1622:          if (drampbc > 0.0) {
 1623:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1624:          } else {
 1625:             rampbc = 1.0;
 1626:          }
 1627:       }
 1628: 
 1629:       if (nws != 0) {
 1630:          if (drampwind > 0.0) {
 1631:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1632:          } else {
 1633:             rampwind = 1.0;
 1634:          }
 1635:       }
 1636: 
 1637:       if (drampwafo > 0.0) {
 1638:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1639:       } else {
 1640:          rampwafo = 1.0;
 1641:       }
 1642: 
 1643:       // For source/sinks
 1644:       if (if_source && dramp_ss > 0.0) {
 1645:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1646:       } else {
 1647:          ramp_ss = 1.0;
 1648:       }
 1649: 
 1650:       if (dramp > 0.0) {
 1651:          ramp = tanh(2.0*time/86400.0/dramp);
 1652:       } else {
 1653:          ramp = 1.0;
 1654:       }
 1655: 
 1656: 
 1657:    }
