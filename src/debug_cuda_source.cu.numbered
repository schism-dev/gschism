 8624: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8625:    // Get the value of a variable from an side
 8626:    // varName is the name of the variable to get
 8627:    // var is the array to store the value
 8628:    // k is the vertical level index of the variable to get
 8629:    SIDE_BND(sideBnd);   
 8630: 
 8631:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8632:    if (sideBnd->segment->isLand) idx = -7;
 8633: 
 8634:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8635:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8636: 
 8637: }
