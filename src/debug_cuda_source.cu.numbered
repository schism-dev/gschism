 3379: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3380: 
 3381: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3382:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3383:    if constexpr(ics == 1) { 
 3384:       return 0.5*(n1->tau + n2->tau);
 3385: 
 3386:    } else {
 3387:       // Project the tau from the node frames to the side frame
 3388:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3389:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3390: 
 3391:       return 0.5*(stau1 + stau2);
 3392:    }
 3393: }
 3394: 
 3395: /**
 3396:  * This method performs backtracking from the side center until a time -dt back in time 
 3397:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3398:  * intermediate point.
 3399:  *
 3400:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3401:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3402:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3403:  * remaining time.
 3404:  * 
 3405:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3406:  * 
 3407:  * @param uuint, vvint, wwint: Velocities at the final point
 3408:  * @param jlev: Level at which the backtracking is performed
 3409:  * @param dt, dtbk: Tracking timesteps
 3410:  * @return: True if the backtracking was successful, false otherwise
 3411:  */
 3412: __inline__ __device__ bool Side::btrack(
 3413:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3414:       double dt,            // Tracking time
 3415:       double dtbk,          // Tracking timestep
 3416:       Vector3 &u_int        // Velocities at the initial point
 3417: ) const {
 3418: 
 3419:    // Start from side center
 3420:    Point3 x0;
 3421: 
 3422:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3423:    else                   x0 = {0.0, 0.0, zc[jlev]};
 3424: 
 3425:  
 3426:    double time_rm = dt; // Remaining time
 3427: 
 3428: 
 3429:    // Initial velocities
 3430:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3431: 
 3432:    // Find the element that is in the direction opposite to the velocity
 3433:    Element* curElem = findElementTowards(toVector2(u_int));
 3434:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3435: 
 3436:    // // If debugging backtracking, add the starting point to the debug plot and the elements for
 3437:    // // idx == 15876
 3438:    // if (idx == 15876) {
 3439:    //    printf("PPP u_int = (%f, %f, %f)\n", u_int.x, u_int.y, u_int.z);
 3440:    //    const Point3 orig = toPoint3(center, centerZ());
 3441:    //    auto vertexInOriginalFrame = [this, orig, jlev](const Node *node) -> Point3 {
 3442:    //       if constexpr(ics == 1) {
 3443:    //          return toPoint3(node->p, 0.0);
 3444:    //       } else {
 3445:    //          const Point3 p_glob = toPoint3(node->p, node->gz);
 3446:    //          const Vector3 loc = frame.G2L(p_glob - orig);
 3447:    //          return Point3(loc.x, loc.y, 0.0);
 3448:    //       }
 3449:    //    };
 3450:    //    auto elementInOriginalFrame = [this, orig, jlev](const Element *elem) -> Point3 { 
 3451:    //       if constexpr(ics == 1) {
 3452:    //          return toPoint3(elem->center, elem->centerZ());
 3453:    //       } else {
 3454:    //          const Point3 center_glob = toPoint3(elem->center, elem->centerZ());
 3455:    //          const Vector3 loc = frame.G2L(center_glob - orig);
 3456:    //          return Point3(loc.x, loc.y, loc.z);
 3457:    //       }
 3458:    //    };
 3459:    //    auto plotTriangle = [&vertexInOriginalFrame, &elementInOriginalFrame](const Element *elem, unsigned int color) {
 3460:    //       if (elem == nullptr || !elem->isTri()) return;
 3461:    //       const Point3 v0 = vertexInOriginalFrame(elem->nodes[0]);
 3462:    //       const Point3 v1 = vertexInOriginalFrame(elem->nodes[1]);
 3463:    //       const Point3 v2 = vertexInOriginalFrame(elem->nodes[2]);
 3464:    //       const Point3 center = elementInOriginalFrame(elem);
 3465:    //       addDebugPlot(v0, v1, color, 'o', elem->nodes[0]->idx);
 3466:    //       addDebugPlot(v1, v2, color, 'o', elem->nodes[1]->idx);
 3467:    //       addDebugPlot(v2, v0, color, 'o', elem->nodes[2]->idx);
 3468:    //       addDebugPlot(center, center, color, 'o', elem->idx);
 3469:    //    };
 3470:    //    plotTriangle(curElem, 0xFF0000u);  // current element in red
 3471:    //    plotTriangle(curElem->nghbElems[0], 0x00A000u);
 3472:    //    plotTriangle(curElem->nghbElems[1], 0x00A000u);
 3473:    //    plotTriangle(curElem->nghbElems[2], 0x00A000u);
 3474: 
 3475:    //    // Add the initial point (0,0) to the debug plot
 3476:    //    addDebugPlot(Point3(0.0, 0.0, 0.0), Point3(0.0, 0.0, 0.0), 0x0000FFu, '+');
 3477:    // }
 3478: 
 3479:    // Nudges it towards the barycenter
 3480:    curElem->nudgeToBarycenter(toPoint2(x0), this); // XXXX Necessary?
 3481: // if (idx == 15876) addDebugPlot(Point3(0.0, 0.0, 0.0), x0, 0xFF00FFu, 'o');
 3482: 
 3483: 
 3484:    const int MAX_ITERATIONS = 100; 
 3485:    Element* nextElem = nullptr;
 3486:    int iter = 0;
 3487:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3488:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3489:    while(true) {
 3490: 
 3491:       // Calculate timestep
 3492:       double dtb = min(dtbk, time_rm);
 3493: 
 3494: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 3495: 
 3496:       // Next point in the backtracking curve
 3497: // if (iter >= MAX_ITERATIONS - 50)  {
 3498: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 3499: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 3500: // }
 3501:         
 3502:       xt = x0 - dtb*u_int;
 3503: 
 3504:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 3505: // if (idx == 15876) addDebugPlot(x0, xt, 0xFF00FFu, '+');
 3506: if (!found) {if (idx == 15876) printf("1111\n"); return true;}
 3507:       assert(found && "Backtracking failed in btrack");
 3508: 
 3509: 
 3510:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 3511:                       // then time_rm needs to be increased by the unused time.
 3512: 
 3513:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3514: 
 3515:       // If the velocity is too small, we stop the backtracking
 3516:       const double vmag = length(toVector2(u_int));
 3517:       if (vmag <= velmin_btrack) break;
 3518: 
 3519:       // The current point becomes the next segment's starting point.
 3520:       x0 = xt;
 3521:  
 3522:       curElem = nextElem;
 3523: 
 3524:       iter++;
 3525: 
 3526:       if (iter >= MAX_ITERATIONS) break;
 3527: 
 3528:       // if (iter >= MAX_ITERATIONS - 50) {
 3529:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3530:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3531:       //    }
 3532:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3533:    }
 3534: 
 3535:    assert(!curElem->isDry && "Final element is dry");
 3536:    assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the final element"); 
 3537: 
 3538:    // Interpolate the velocities at the final point
 3539:    u_int = curElem->interpolateVelocities(xt, this);
 3540: 
 3541:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3542: 
 3543: 
 3544: }
 3545: 
