  360: // ------------------------------------------------------------------------------------------------
  361: 
  362: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  363:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  364:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  365: }
  366: 
  367: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  368:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  369:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  370: }
  371: 
  372: 
  373: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  374:    x3 = y1*z2 - y2*z1;
  375:    y3 = x2*z1 - x1*z2;
  376:    z3 = x1*y2 - x2*y1;
  377: }
  378: 
  379: 
  380: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  381: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  382: //
  383: 
  384:    const double radius2 = dot(p, p);
  385:    const double radius = sqrt(radius2);
  386:  
  387:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  388:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  389: 
  390:    rlon = atan2(p.y, p.x); // (-pi,pi]
  391: 
  392:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  393:       rlat = asin(p.z/radius);
  394:    } else {
  395:       rlat = asin(p.z/rearth_pole);
  396:    }
  397:   
  398: }
  399: 
  400: 
  401: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  402: // Compute the 3D Cartesian coordinates from the latitude and longitude
  403: // Inputs:
  404: //        lat: latitude in radians
  405: //        lon: longitude in radians
  406: // Output:
  407: //        x, y, z: 3D Cartesian coordinates
  408: 
  409:    double sin_lat, cos_lat, sin_lon, cos_lon;
  410: 
  411:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  412:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  413: 
  414:    sincos(lat, &sin_lat, &cos_lat);
  415:    sincos(lon, &sin_lon, &cos_lon);
  416: 
  417:    const double x = rearth_eq*cos_lat*cos_lon;
  418:    const double y = rearth_eq*cos_lat*sin_lon;
  419:    const double z = rearth_pole*sin_lat;
  420: 
  421:    return make_double3(x, y, z);
  422: }
  423: 
  424: __inline__ __device__ void Error(const char* msg) {
  425:    printf("Error: %s\n", msg);
  426:    assert(false);
  427: }
