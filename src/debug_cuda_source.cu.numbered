 1274: // This struct is used to store the boundary information for a node.
 1275: struct NodeBoundary {   
 1276:    int idx;
 1277:    BoundarySegment *segment;
 1278:    Node *node;
 1279:    
 1280:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1281:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1282: 
 1283:    bool isLand;
 1284: 
 1285:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1286:    double elbc;   // Elevation boundary condition
 1287:    double eth;    // Elevation time history
 1288: 
 1289:    double eta_mean; // Mean elevation at nodes
 1290: 
 1291:    bool isEssentialBC;
 1292: 
 1293:    Vector2 uth[nvrt];  // "Time history" velocity
 1294: 
 1295:    // Arrays for harmonic constituents (if needed)
 1296:    double  emo[nbfr];  // Elevation amplitude
 1297:    double  efa[nbfr];  // Elevation phase
 1298:    Vector2 umo[nbfr];  // velocity amplitude
 1299:    Vector2 ufa[nbfr];  // velocity phase
 1300: 
 1301: 
 1302:    NodeBoundary(void) {
 1303:       isLand = false;
 1304:    }
 1305:    NodeBoundary(bool _isLand) {
 1306:       isLand = _isLand;
 1307:    }
 1308: 
 1309:    
 1310:    __forceinline__ __device__ int numSidesForAverage() const {
 1311:    // Returns the number of sides that are connected to the node and have the same segment.
 1312:    // This is used to compute the average velocity at the node for open boundary nodes.
 1313:       int res = 0;
 1314:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1315:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1316: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1317:       return res;
 1318:    }
 1319: 
 1320: 
 1321:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1322:       assert(index == 0 || index == 1); 
 1323:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1324:    }
 1325: 
 1326: 
 1327: };
 1328: 
 1329: struct Node {
 1330: 
 1331:    // Geometry information
 1332:    int idx;        // Index of the node
 1333:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1334:    int numNodes;   // Number of nodes neighbors of this node
 1335: 
 1336:    Element **elements; // Array of pointers to the elements that share this node
 1337:    int numElements;    // Number of elements that share this node
 1338: 
 1339:    int numSides;       // Number of sides that are connected to this node
 1340: 
 1341:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1342:    double gz;          // Global vertical coordinate at the node.
 1343:    Vector2 u2[nvrt];
 1344:    double  w2[nvrt];
 1345:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1346:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1347:    double lon, lat;
 1348:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1349:    double depth;
 1350: 
 1351:    #ifdef USE_FRAMES
 1352:    Frame frame;
 1353:    #endif
 1354: 
 1355:    #ifdef USE_LOCALIZED_SIGMA   
 1356:    double localSigma[nvrt];
 1357:    #endif
 1358: 
 1359:    int kb;       // Bottom index of the node
 1360: 
 1361:    bool isDry;     // True if the node is dry
 1362: 
 1363:    int iadv;     // Advection flag
 1364: 
 1365:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1366:                           // this is nullptr
 1367: 
 1368:    TempVar tmp; // Temporary variable to store different types of variables
 1369: 
 1370:    // Physical information
 1371:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1372:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1373: 
 1374:    double rho[nvrt];     // Density
 1375:    double dfv[nvrt];     // Vertical viscosity
 1376: 
 1377:    double eta1; // Elevation at nodes at previous timestep
 1378:    double eta2; // Elevation at nodes at current timestep
 1379: 
 1380:    double ETP;  // Earth Tidal Potential
 1381: 
 1382:    double pr;    // Air pressure
 1383:    double grav2; // Gravity 
 1384:    
 1385:    Vector2 dav;  // Depth averaged velocity
 1386: 
 1387:    Vector2 tau; // Wind stress vector
 1388: 
 1389:    // Vegetation parameters
 1390:    double veg_h;
 1391:    double veg_nv;
 1392:    double veg_di;
 1393:    double veg_Cd;
 1394:    double veg_h_unbent;
 1395:    double veg_di_unbent;
 1396:    double veg_nv_unbent;
 1397:    double veg_alpha_vert_mean;
 1398:    double veg_alpha0;
 1399:    double veg_alpha3D[nvrt];
 1400: 
 1401:    // Bottom drag parameters
 1402:    double Cd;       // Bottom drag coefficient   
 1403: 
 1404:    // These three are mutually exclusive
 1405:    union {
 1406:       double rmanning; // Bottom Manning's coefficient
 1407:       double rough;    // Bottom roughness length
 1408:       double drag;     // Bottom drag coefficient
 1409:    };
 1410:    Vector2 tau_bot; // Bottom stress vector
 1411: 
 1412:    // XXXX REMOVE FOR IMM>0???
 1413:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1414:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1415: 
 1416:    double qel; // RHS
 1417:    double coeffDiag; // Diagonal coefficient of the matrix
 1418:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1419: 
 1420:    // This was used by a previous version of the conjugate gradient method
 1421:    // double mP; // Search direction for conjugate gradient method
 1422:    // double mR; // Residual for conjugate gradient method
 1423:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1424: 
 1425:    double mX; // Solution of the FEM system
 1426: 
 1427:    // Meteorological forcing
 1428:    Vector2 u_air;
 1429:    double p_air;  // XXXX is this the same as pr?
 1430:    double t_air;
 1431:    double q_air;
 1432:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1433: 
 1434:    __device__ void setWind(Vector2 &u) {
 1435:    // Sets the wind vector taking into account the mesh angle
 1436:    
 1437:       const double speed = length(u);
 1438: 
 1439:       // Rotate wind vector to the node frame
 1440:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1441: 
 1442:       // Sets the surface stress vector due to wind.
 1443:       if constexpr(nws == 0) {
 1444:          tau = {0.0, 0.0};
 1445: 
 1446:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1447:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1448: 
 1449:       } else {
 1450: 
 1451:          double dragcoef;
 1452: 
 1453:          if constexpr(iwind_form == -1) {
 1454:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1455:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1456: 
 1457:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1458:             tau = cff*u_air;
 1459:  
 1460:          } else if constexpr(iwind_form == 1) {
 1461:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1462:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1463: 
 1464:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1465:             tau = cff*u_air;
 1466: 
 1467:          } else {
 1468:             tau = {0.0, 0.0};
 1469:          }
 1470:       }
 1471:    }
 1472: 
 1473:    #ifdef USE_FRAMES
 1474:    __device__ void setFrame(double lat, double lon) {
 1475: 
 1476:       frame.update(lat, lon);        
 1477:     }
 1478:    #endif
 1479: 
 1480:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1481: 
 1482:    __device__ double sigmaTransitionDepth(void) const;
 1483: 
 1484:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1485: 
 1486:    __inline__ __device__ Point2 outputCoords(void) const {
 1487:       if constexpr(ics == 1)  return p;
 1488:       else                    return {rad2deg*lon, rad2deg*lat};
 1489:    }
 1490: 
 1491:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1492:    // If ics == 2, convert the global point to the local frame
 1493:       
 1494:       if constexpr (ics == 1) {
 1495:          return p;
 1496:       } else {
 1497:          const Point3 c = {p.x, p.y, gz};
 1498:          const Point3 local = frame.G2L(p - c);
 1499:          return local;
 1500:       }
 1501:    }
 1502: 
 1503:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1504:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1505:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1506:    
 1507:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1508: 
 1509:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1510: 
 1511:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1512:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1513: 
 1514:    __device__ __forceinline__ void clearMatrixRow(void) {
 1515:       // Clear the matrix row for this node
 1516: 
 1517: 
 1518:       coeffDiag = 0.0;
 1519: 
 1520:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1521: 
 1522:    }
 1523: 
 1524:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1525:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1526:       
 1527:       if (node == this) {
 1528:          coeffDiag += value;
 1529:      
 1530:       } else {
 1531:          // Search (linearly)the index of the node in the array of nodes
 1532:          // XXX: This is not efficient, see if we can improve this
 1533:          int i;
 1534:          for (i = 0; i < numNodes; i++) {
 1535:             if (nodes[i] == node) {
 1536:                break;
 1537:             }
 1538:          }
 1539:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1540:          coeffMatrix[i] += value;
 1541:       }
 1542:    }
