 4242: extern "C" {
 4243: 
 4244:    __global__ void scaleGravity(double loadtide_coef) {
 4245: 
 4246: 
 4247:       NODE(node);
 4248: 
 4249:       // SAL option: scale gravity
 4250:       if constexpr(iloadtide==2) {  // simple const
 4251:          node->grav2 = grav*(1.0 - loadtide_coef);
 4252: 
 4253:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4254:         
 4255:           const double depth = max(node->depth, 0.0);
 4256:           const double tmp1 = sqrt(depth);
 4257:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4258:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4259:                              2.6969e-13*depth*depth*depth*tmp1;
 4260:           
 4261:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4262:           
 4263: 
 4264: 
 4265:           node->grav2 = grav*(1.0 - beta_bar);
 4266: 
 4267:       } else {  // iloadtide=0,1
 4268:           node->grav2 = grav;
 4269: 
 4270:       }
 4271: 
 4272:    }
 4273: 
 4274: 
 4275:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4276:       NODE(node);
 4277: 
 4278:       const int idx = node->idx;
 4279:       Vector2 wind = {xWind[idx], yWind[idx]};
 4280: 
 4281:       if constexpr(nws != 0 && iwindoff != 0) {
 4282:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4283:       }
 4284: 
 4285:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4286:       node->setWind(wind);
 4287: 
 4288:       node->pr = pressAir[idx];
 4289:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4290: 
 4291:    }
