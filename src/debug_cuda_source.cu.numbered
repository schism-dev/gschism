 7335:    __global__ void resetVelocityOpenBndNodes(void) {
 7336:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7337: 
 7338:       NODE_BND(nodebnd);
 7339: printf("DDDDDDDDDD\n");  // XXXXXXX
 7340:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7341:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7342:       }
 7343: 
 7344:    }
 7345: 
 7346: 
 7347:    __global__ void setVelocityOpenBndNodes(void) {
 7348:    // For open boundary nodes sets their velocity to the imposed values.
 7349: 
 7350:       SIDE_BND(sidebnd);
 7351: 
 7352:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7353:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7354:          // to its segment to the average of the side velocity.
 7355: 
 7356:          for (int k = 0; k < nvrt; k++) {
 7357:             Node *n1 = sidebnd->side->n1;
 7358:             Node *n2 = sidebnd->side->n2;
 7359: 
 7360: 
 7361:             Vector2 n1_u2(n1->u2[k]);
 7362:             Vector2 n2_u2(n2->u2[k]);
 7363: 
 7364:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7365:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7366:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7367:             }
 7368:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7369:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7370:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7371:             }
 7372: 
 7373:          }
 7374: 
 7375:       }
 7376: 
 7377:    }
