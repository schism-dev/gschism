 3877:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3878: 
 3879:       NODE_BND(nodeBnd);
 3880: 
 3881:       Node *node = nodeBnd->node;
 3882: 
 3883:       node->ETP = 0.0;
 3884: 
 3885:       for (int j=0; j<ntip; j++) {
 3886: 
 3887:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3888:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3889:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3890: 
 3891:          if constexpr(iloadtide==1) { // loading tide
 3892:             assert(false && "Loading tide not implemented");
 3893:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3894:          }
 3895:          
 3896:       }
 3897:       
 3898:    }
