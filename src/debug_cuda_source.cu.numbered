 5272: // //                   is used below bottom or above surface.
 5273: // //       ibelow: flag indicating if zt is below za(k1)
 5274: // //
 5275: 
 5276: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 5277: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 5278:    
 5279: //    ibelow = 0;
 5280: 
 5281: //    if (zt < za[k1]) {
 5282: //       // Below bottom
 5283: //       ibelow = 1;
 5284: //       s_out = s_in[k1];
 5285: 
 5286: //    } else if(zt>=za[k2]) {
 5287: //       // Above surface
 5288: //       s_out = s_in[k2];
