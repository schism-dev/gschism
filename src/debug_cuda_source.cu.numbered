 7548: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7549:    Node *nodes = mesh->localNodeData;
 7550: 
 7551:    *addr = nodes;
 7552:    *sizeNode = sizeof(Node);
 7553: 
 7554:    switch (varCode) {
 7555:       case (int)VarCode::depth:
 7556:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7557:          *sizeType = sizeof(double);
 7558:          break;
 7559:       case (int)VarCode::eta:
 7560:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7561:          *sizeType = sizeof(double);
 7562:          break;
 7563:       case (int)VarCode::x:
 7564:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7565:          *sizeType = sizeof(Vector2);
 7566:          break;
 7567:       case (int)VarCode::z:
 7568:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7569:          *sizeType = sizeof(double);
 7570:          break;
 7571:       case (int)VarCode::kb:
 7572:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7573:          *sizeType = sizeof(int);
 7574:          break;
 7575:       case (int)VarCode::isdry:
 7576:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7577:          *sizeType = sizeof(int);
 7578:          break;         
 7579:       case (int)VarCode::w:
 7580:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7581:          *sizeType = sizeof(double);
 7582:          break;
 7583:       case (int)VarCode::u:
 7584:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7585:          *sizeType = sizeof(Vector2);
 7586:          break;         
 7587:       default:
 7588:          *offset = -1;    
 7589:    }  
 7590:    
 7591: }
