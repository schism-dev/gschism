 2329: 
 2330: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2331: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2332: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2333: // Only when ics == 2, the origin is at the element center.
 2334: 
 2335:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2336: 
 2337:    const Node *node = nodes[idxNode];
 2338: 
 2339:    if constexpr(ics==1) {
 2340:       return node->p;
 2341: 
 2342:    } else {
 2343:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2344: 
 2345:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2346: 
 2347:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2348:    }
 2349: 
 2350: }
 2351: 
 2352: 
 2353: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2354: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2355: 
 2356:    const int id1 = idx;
 2357:    const int id2 = nxq(1 + id1);
 2358:    const int id3 = nxq(2 + id1);
 2359: 
 2360:    if constexpr(ics==1) {
 2361:       x0 = nodes[id1]->p;
 2362:       x1 = nodes[id2]->p;
 2363:       x2 = nodes[id3]->p;
 2364: 
 2365:    } else {
 2366:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2367: 
 2368:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2369:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2370:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2371: 
 2372:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2373:       x1 = toVector2(frame.G2L(p1 - c));
 2374:       x2 = toVector2(frame.G2L(p2 - c));
 2375: 
 2376:    }
 2377: 
 2378: }
 2379: 
 2380: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3, int idx) const {
 2381: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2382: 
 2383:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2384: 
 2385:    const int id1 = idx;
 2386:    const int id2 = nxq(1 + id1);
 2387:    const int id3 = nxq(2 + id1);
 2388:    const int id4 = nxq(3 + id1);
 2389: 
 2390:    if constexpr(ics==1) {
 2391:       x0 = nodes[id1]->p;
 2392:       x1 = nodes[id2]->p;
 2393:       x2 = nodes[id3]->p;  
 2394:       x3 = nodes[id4]->p;
 2395: 
 2396:    } else {
 2397:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2398: 
 2399:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2400:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2401:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2402:       const Point3 p3 = toPoint3(nodes[id4]->p, nodes[id4]->gz);
 2403: 
 2404:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2405:       x1 = toVector2(frame.G2L(p1 - c));
 2406:       x2 = toVector2(frame.G2L(p2 - c));
 2407:       x3 = toVector2(frame.G2L(p3 - c));
 2408:    }
 2409: 
 2410: }
 2411: 
 2412: 
 2413: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2414: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2415: // Returns the normal vector and the area of the element at this level
 2416:    
 2417:    double nx, ny, nz;
 2418: 
 2419:    if (isTri()) {
 2420:       // For triangles...
 2421: 
 2422:       // Indices of the nodes at level k, taking care of not going below the bed
 2423:       const int k0 = max(k, nodes[0]->kb);
 2424:       const int k1 = max(k, nodes[1]->kb);
 2425:       const int k2 = max(k, nodes[2]->kb);
 2426: 
 2427:       // Gets the element frame coordinates of the nodes at level k
 2428:       Point3 x0, x1, x2;
 2429:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2430:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2431:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2432:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2433: 
 2434:       } else {  // ics == 2
 2435:          Point2 h0, h1, h2;
 2436: 
 2437:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2438: 
 2439:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2440:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2441:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2442:       }
 2443: 
 2444:       const Vector3 n20 = x2 - x0;
 2445:       const Vector3 n10 = x1 - x0; 
 2446: 
 2447:       // Computes the cross product of vectors n20 and n10. 
 2448:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2449:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2450:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2451: 
 2452:   
 2453:    }
 2454:    else {
 2455:       // For quads...
 2456:       Point2 h0, h1, h2, h3;
 2457: 
 2458:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2459: 
 2460:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2461:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2462:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2463:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2464: 
 2465:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2466:       nx = n20.y*n31.z - n20.z*n31.y;
 2467:       ny = n20.z*n31.x - n20.x*n31.z;
 2468:       nz = n20.x*n31.y - n20.y*n31.x;
 2469: 
 2470:    }
 2471: 
 2472:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2473:    area3D = 0.5*len;
 2474: 
 2475:    const double inv_len = 1.0/len;
 2476: 
 2477:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2478: 
 2479: }
 2480: 
 2481: 
 2482: 
 2483: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2484:    // Check if the point (xt,yt) is inside the element.
 2485:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2486:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2487: 
 2488:    double shpCoords[4];
 2489:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2490: 
 2491:    return res;
 2492: }
 2493: 
 2494: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2495:    // Check if the point (xt,yt) is inside the element.
 2496:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2497:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2498:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2499: 
 2500:    double shpCoords[4];
 2501:    Vector2 tmp_xt = xt;
 2502:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2503: printf("HEREEEEEE\n");
 2504:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2505: 
 2506:    if (fixCoords && res) xt = tmp_xt;
 2507: 
 2508:    return res;
 2509: }
