 1125: 
 1126:    Vector2 ubc[nvrt]; // velocity boundary condition
 1127:    
 1128:    __inline__ __device__ double getBoundaryArrayValueWeight(void) const;
 1129: 
 1130:    __inline__ __device__ double etaMeanBnd(void) const;
 1131: 
 1132:    __inline__ __device__ Vector2 umo (int jfr) const;
 1133:    __inline__ __device__ Vector2 ufa (int jfr) const;  
 1134:    __inline__ __device__ Vector2 uth (int k) const;
