 6854: #ifdef DONTCOMPILE
 6855: __device__ void computeVerticalAdvection(void) {
 6856:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6857: 
 6858:    sdbt(1:2,:,:)=0.d0
 6859: 
 6860:    const Side *side = FROM kernel;
 6861: 
 6862:    if(side->isDry) return;
 6863: 
 6864:    // If side is wet...
 6865: 
 6866: 
 6867:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6868:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6869:    double ws[nvrt] = {} // w @ side
 6870:    int icount = 0;
 6871:    for (int j=0; j<2; j++) {
 6872:       const Element *elem = side->elements[j];
 6873:        
 6874:       if(elem != nullptr) {
 6875:          icount++;
 6876:          for (int k=0; k<nvrt; k++) {
 6877:             ws[k] = ws[k] + elem->w[k];
 6878:          }
 6879:       }
 6880:    }  // for j
 6881: 
 6882:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6883:    ws = ws/icount;
 6884: 
 6885:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6886:    // Splines allow for a smooth transition between vertical levels.
 6887:    // Splines have continuity restrictions at the internal knots, but
 6888:    // we have to provide the 1st derivatives at the endpoints.
 6889:    const int kbs = side->kbs; 
 6890:    
 6891:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6892:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6893:    initCubicSpline(kbs, nvrt, side, ws, up)
 6894: 
 6895:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6896:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6897:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6898: 
 6899:    // Total advection (average onto side)
 6900:    const Node *node1 = side->nodes[0];
 6901:    const Node *node2 = side->nodes[1];
 6902:    for (int k=kbs(i); k<nvrt; k++) {
 6903: 
 6904:       if constexpr(ics==1) {
 6905:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6906:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6907:       } else {
 6908:          // XXX IMPLEMENT THIS
 6909:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6910:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6911:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6912:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6913:       }  // if ics
 6914: 
 6915: 
 6916:    }
 6917: }
 6918: #endif
 6919: 
 6920: 
 6921: extern "C" {
 6922:    __global__ void computeElemAverageGhat(void) {
 6923:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6924: 
 6925:       ELEM(elem);
 6926:       
 6927:       elem->ghat1= {0.0, 0.0};  
 6928: 
 6929:       if constexpr(ihydraulics != 0) {
 6930:          if (nhtblocks > 0 && elem->isblock) return;
 6931:       }
 6932: 
 6933:       if (elem->isDry) return;
 6934: 
 6935:       // Wet elements.
 6936:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6937:       // tidal potential, horizontal diffusion, and baroclinic etc
 6938:       // Remember to update both fb and F 
 6939:       // If ics=2, ghat1 are in eframe (ll)
 6940:       // cff1-3: coefficients for 2D/3D
 6941:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6942:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6943:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6944: 
 6945:       double av_cff1 = 0.0;  // av. for cff1
 6946:       double av_cff2 = 0.0;  // av. for cff2
 6947:       double av_cff3 = 0.0;  // av. for cff3
 6948:       double av_df = 0.0;  // av. for H^\alpha / H
 6949:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6950:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6951: 
 6952:       const int i34 = elem->i34;
 6953:       const int kb = elem->kb;
 6954: 
 6955:       for (int j=0; j<i34; j++) {
 6956:          // For each node and side in the element...
 6957: 
 6958:          const Node *node = elem->nodes[j];
 6959:          const Side *side = elem->sides[j];
 6960: 
 6961:          const double chi      = side->chi;
 6962:          const double veg_c2   = side->veg_c2;
 6963:          const double veg_beta = side->veg_beta;
 6964:          const double veg_h    = side->veg_h();
 6965:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6966: 
 6967:          // Node - const in elem
 6968:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6969:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6970: 
 6971:          if (elem->depth >= tip_dp) {
 6972:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6973:          }
 6974: 
 6975:          
 6976:          const double htot  = side->htot2();        // Total depth at the side
 6977:          const double zctr2 = side->zTopCanopy();  
 6978: 
 6979:          double cff1; 
 6980:          double cff2; 
 6981:          double cff3;   
 6982:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6983:          // coefficients applied to 2D/3D case 
 6984:             cff1 = side->hhat/htot;
 6985:             cff2 = 0.0;
 6986:             cff3 = 0.0;
 6987:          } else { //3D
 6988:             //Init for no-veg case
 6989:             cff1 = 1.0;
 6990:             cff2 = 1.0;
 6991:             cff3 = 0.0;
 6992: 
 6993:             if constexpr(iveg != 0) {
 6994:                // Computes coefficients used with vegetation terms G1, G2
 6995:                // cff1, cff3 are used for the first two terms in G1, G2:
 6996:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6997:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6998:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6999:                if(veg_h < 0.99*htot) { // submergent vegetation
 7000:                   cff1=1;
 7001:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7002:                   cff3 = veg_c;
 7003: 
 7004:                } else { // emergent vegetation
 7005:                   cff1 = 1.0/(1.0 + veg_c2);
 7006:                   cff2 = cff1;
 7007:                   cff3 = 0.0;
 7008: 
 7009:                }
 7010:             } // if iveg
 7011:          } //  2D/3D
 7012: 
 7013:          av_cff1 += cff1/i34;
 7014:          av_cff2 += cff2/i34;
 7015:          av_cff3 += cff3/i34;
 7016:          av_cff2_chi += cff2*chi/i34;
 7017:          av_cff3_chi += cff3*chi/i34;
 7018:          av_df += min(htot, veg_h)/(htot*i34);
 7019: 
 7020: 
 7021:          // btrack values: U^\star, U^{\star\alpha}
 7022:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7023:          Vector2 Ustar       = {0.0, 0.0}; 
 7024:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7025: 
 7026:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7027:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7028:          } else { //3D
 7029:             for (int k = side->kb; k < nvrt; k++) {
 7030:             
 7031:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7032:                Ustar += w2;
 7033: 
 7034:                if constexpr(iveg != 0) {
 7035:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7036:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7037:                        Ustar_alpha += zrat*w2; // XXXX
 7038:                    }
 7039:                }  // if iveg
 7040:             }  // for k
 7041:          }  //2D/3D
 7042:          
 7043: 
 7044:          // Add btrack & surface stress terms to \breve{G} first
 7045:          if constexpr(ics==1) {
 7046: 
 7047:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7048: 
 7049:          } else {
 7050:             // XXX IMPLEMENT THIS
 7051:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7052:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7053:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7054:          }  // if ics
 7055: 
 7056:          // Surface and bottom stress terms
 7057:          if constexpr(ics==1) {
 7058:             const Vector2 tau    = side->tau();
 7059:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7060: 
 7061:             // Term for surface and bottom stress
 7062:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7063: 
 7064:          } else {
 7065:             assert(false && "computeElemAverageGhat: Not implemented");
 7066:             // XXX IMPLEMENT THIS
 7067:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7068:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7069:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7070:             // tau_x=(vn1+tt1)/2.d0
 7071:             // tau_y=(vn2+ss1)/2.d0
 7072:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7073:          }  // if ics
 7074: 
 7075:          
 7076: 
 7077:          // All terms in F,F^\alpha,f_b except baroclinic
 7078:          // F, f_b: all explicit terms excluding vegetation 
 7079:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7080:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7081:          const double coriolis = side->coriolis;
 7082:          Vector2 F  =  coriolis*side->U;  // F_x
 7083:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7084:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7085: 
 7086:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7087:             
 7088:             for (int k = side->kb; k < nvrt; k++) {
 7089:                if (zctr2 > side->zc[k-1]) {
 7090:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7091:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7092:                    Fa +=  coriolis*w2*zrat;
 7093:                } // if zctr2
 7094:             } // k
 7095:          } // iveg
 7096: 
 7097:          // Integrate horizontal viscosity force vertically
 7098:          for (int k=side->kb + 1; k<nvrt; k++) {
 7099:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7100: 
 7101:             F += levelHorVisc;
 7102: 
 7103:             // Vegetation term
 7104:             if constexpr(iveg!=0) {
 7105:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7106:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7107:                   Fa += levelHorVisc*zrat;
 7108:                } 
 7109:             } // if iveg
 7110:          } // for k
 7111: 
 7112:          fb += side->nuGradU[side->kb];
 7113: 
 7114:          // Add to ghat1
 7115:          if constexpr(ics==2) {
 7116:             // XXX IMPLEMENT THIS
 7117:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7118:             // bigf1=vn1; bigf2=vn2
 7119:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7120:             // botf1=vn1; botf2=vn2
 7121:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7122:             // bigfa1=vn1; bigfa2=vn2
 7123:          } // if ics
 7124: 
 7125:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7126:       } // for j (nodes and sides)
 7127: 
 7128:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7129:          
 7130:       // Finish off terms in F, F^\alpha and f_b
 7131:       const double grav3 = elem->mean(&Node::grav2);
 7132:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7133: 
 7134: 
 7135:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7136:       for (int j=1; j<i34; j++) { 
 7137:          // For each side in the element...
 7138:          const Side *side = elem->sides[j];
 7139:          const double chi = side->chi;
 7140: 
 7141:          const double htot = side->htot2();
 7142:          const double veg_h = side->veg_h();
 7143:          const Vector2 F  = htot*fb;
 7144:          const Vector2 Fa = min(htot, veg_h)*fb;
 7145: 
 7146:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7147:       } // for j
 7148: 
 7149:       //botf1 etc are already in elem frame
 7150:       elem->ghat1 += tmp/i34;
 7151: 
 7152:       // Baroclinic force
 7153:       if constexpr(ibc==0) {
 7154:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7155: 
 7156:          Vector2 Fa = {0.0, 0.0};
 7157:          Vector2 intGradRho = {0.0, 0.0};
 7158:          
 7159:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7160:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7161:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7162: 
 7163:             // \in F [m^2/s/s]
 7164:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7165:          }
 7166: 
 7167:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7168:          const Vector2 F = av_df*Fa; //approx
 7169:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7170: 
 7171:       } // if ibc
 7172: 
 7173: 
 7174: 
 7175:    }
 7176: 
 7177: } // extern "C"
 7178: 
 7179: 
 7180: 
 7181: #ifdef DONTCOMPILE
 7182: __global__ void checkMassConservation(Tracers* sumtr) {
 7183: 
 7184:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7185: 
 7186:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7187: 
 7188:    Element *elem = &(mesh->localElemData[i]);
 7189: 
 7190:    // Skip dry elements
 7191:    if (elem->isDry) return;
 7192: 
 7193:    // Local sum array for this thread
 7194:    double localSum[N_TRACERS] = {0.0};
 7195: 
 7196:    // Sum over vertical levels for this element
 7197:    const int kbe = elem->kbe;
 7198:    const double area = elem->area;
 7199: 
 7200:    for (int k = kbe; k < nvrt; k++) {
 7201:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7202:       
 7203:       // Accumulate tracer mass
 7204:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7205:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7206:       }
 7207:    }
 7208: 
 7209:    //  This function returns per element sums. A reduction must be done on the host side.
 7210: }
 7211: 
 7212: 
 7213: __global__ void transport(void) {
 7214: 
 7215:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7216: 
 7217:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7218: 
 7219:    Element *elem = &(mesh->localElemData[ie]);
 7220: 
 7221:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7222: 
 7223:                for (int m=0; m<ntr; m++) {
 7224:                   for (int k=kbe(ie); k<nvrt; k++) {
 7225:                      // Calculate each polynomial's weight 
 7226:                      wm=0.d0; sum1=0.d0; 
 7227:                      wm1=0.d0; wm2=0.d0; 
 7228:                      for (int i=0; i<elem->nweno2; i++) {
 7229:                   
 7230:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7231:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7232:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7233:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7234:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7235:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7236:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7237:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7238:                      // -----------------Hu and Shu (1999)'s method----------------
 7239:                      b4=b1+b2+b3
 7240: 
 7241: //Error: add PRODUCTION CPP
 7242: #ifdef DEBUG
 7243:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7244:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7245:                     call parallel_abort(errmsg)
 7246:                   }
 7247: #endif
 7248: 
 7249:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7250:                   // !----test-------------- 
 7251:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7252:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7253:                   // !wm(i)=wm1(i)*wm2(i)
 7254:                   // !---------------------- 
 7255:                   sum1=sum1+wm(i)
 7256:                 } // end for i
 7257: 
 7258:                 wm=wm/sum1
 7259: 
 7260:                 for (int j=0; j<elem->i34; j++) {
 7261: 
 7262:                   const Side *side  = elem->sides[j];
 7263:                   const Node *node1 = side->n1;
 7264:                   const Node *node2 = side->n2;
 7265: 
 7266:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7267:                      trsd=0.d0
 7268:                      for (int kk=0; kk<nquad; kk++) {
 7269:                         for (int i=0; i<elem->nweno2; i++) {
 7270:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7271:                         } // end for i   
 7272:                      } // end for kk
 7273:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7274:                   } // outward flux
 7275:                } // end for j=1,i34(ie) ! side
 7276:             }
 7277:          }
 7278:               
 7279: 
 7280: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7281: //             //   calculate each polynomial's weight 
 7282: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7283: //                 wm=0.d0; sum1=0.d0
 7284: //                 do i=1,nweno1(ie) !for each polynomial
 7285: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7286: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7287: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7288: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7289: //                   wm(i)=b2
 7290: //                   sum1=sum1+b2
 7291: //                   !wm(i)=1.d0
 7292: //                   !sum1=sum1+1.d0
 7293: 
 7294: // // Error: PRODUCTION
 7295: // #ifdef DEBUG
 7296: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7297: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7298: //                     call parallel_abort(errmsg)
 7299: //                   endif
 7300: // #endif
 7301: 
 7302: //                 enddo !i
 7303: //                 wm=wm/sum1 !final weight
 7304: 
 7305:                 for (int j=0; j<elem->i34; j++) { // side
 7306:                   const Side *side = elem->sides[j];
 7307:                   const Node *node1 = side->n1;
 7308:                   const Node *node2 = side->n2;
 7309: 
 7310:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7311:                     trsd=0.d0
 7312:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7313:                       for (int i=0; i<elem->nweno1; i++) {
 7314:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7315:                       }
 7316:                     enddo //kk
 7317:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7318:                   } // outward flux
 7319:                 } // end for j=1,i34(ie) ! side
 7320:               } // end for k; ntr 
 7321: 
 7322:             else !simple upwind method
 7323:               do j=1,i34(ie)
 7324:                 jsj=elside(j,ie)
 7325:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7326:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7327:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7328:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7329:                   endif
 7330:                 enddo  !vertical layers
 7331:               enddo !j=1,i34(ie) ! side
 7332:             endif !order of accuracy
 7333: 
 7334:          //  enddo !ie
 7335: // !$OMP     end do
 7336: 
 7337: // !$OMP     master
 7338: //           !message passing
 7339: //           if (nproc>1) then
 7340: //             !make a copy of side concentrations
 7341: //             trsd_tmp0=trsd_tmp 
 7342: 
 7343: //             !this exchange routine swaps interface concentration between two partitions
 7344: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7345: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7346: 
 7347: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7348: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7349: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7350: 
 7351: 
 7352: //             !This obtains final values for interface sides
 7353: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7354: //       :    endif !nproc>1
 7355: //           !message passing end
 7356: // !$OMP     end master
 7357: // !$OMP     barrier
 7358: 
 7359: 
 7360: // !         Do advection; conc @ dry elem will not be changed
 7361: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7362: // !$OMP     do reduction(+: h_mass_in)
 7363: //           do i=1,ne
 7364: //             if(idry_e(i)==1) cycle
 7365: 
 7366: 
 7367: // !           Wet elements with 3 wet nodes
 7368: //             do k=kbe(i)+1,nvrt
 7369: 
 7370: 
 7371: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7372: //               dtb_by_bigv = dtb/bigv
 7373:     
 7374: // !             Advective flux
 7375: //               if (ntd_weno==1 .or. itd_weno==1) then
 7376: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7377: //               else
 7378: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7379: //               endif
 7380: 
 7381: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7382: //               do j=1,i34(i)
 7383: //                 jsj=elside(j,i) !side
 7384: //                 iweno=.true. !use weno reconstruction as default
 7385: //                 iel=ic3(j,i) !neighboring elem
 7386: 
 7387: //                 if(iel/=0) then
 7388: //                   if(idry_e(iel)==1) cycle
 7389: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7390: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7391: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7392: //                     iweno=.false.
 7393: //                   endif
 7394: //                 else !land or open bnd side
 7395: //                   !skip land bnd and outflowing open bnd, 
 7396: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7397: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7398: //                     !For outflow open bnd side, estimate mass in (open
 7399: //                     !side cannot be interface side)
 7400: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7401: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7402: //                     endif
 7403: 
 7404: //                     cycle
 7405: //                   endif
 7406: 
