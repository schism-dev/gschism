 4385: 
 4386:    nbs = *sharedIdxSideBoundary + 1;
 4387:    nbp = *sharedIdxNodeBoundary + 1;
 4388: 
 4389:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4390: 
 4391: }
