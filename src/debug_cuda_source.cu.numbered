  494: // Polynomial class
  495: template<int grade>
  496: struct Polynomial {
  497:     // Static assertion to give a clear error message at compile time
  498:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  499: };
  500: 
  501: 
  502: // Explicit specialization for grade 4
  503: template<>
  504: struct Polynomial<4> {
  505:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  506: 
  507:    // Constructor from coefficients
  508:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  509: 
  510:    __device__ __forceinline__ double eval(double x) const {
  511:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  512:    }
  513: };
