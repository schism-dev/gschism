 1466: struct Side {
 1467: 
 1468:    // Geometry information
 1469:    int idx;               // Index of the side
 1470:    Node *n1, *n2;
 1471:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1472: 
 1473:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1474:    Vector2 center;        // Location of side center. 
 1475:    double zc[nvrt];       // Side center z-coord at each vertical level
 1476: 
 1477:    Frame<ics> frame;
 1478:    
 1479:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1480:                           // this is nullptr
 1481:    
 1482:    int16_t kb;            // Bottom index of the side
 1483:    bool isDry;            // True if the side is dry
 1484:  
 1485:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1486: 
 1487:    // Physical information
 1488:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1489:    Vector2 btu[nvrt];           // Back-tracked velocity
 1490:    Vector2 U;                   // Vertically averaged velocity vector  
 1491: 
 1492:    Vector2 nuGradU[nvrt];       // nu*grad u
 1493: 
 1494:    Vector2 bcc[nvrt];           // Baroclinic term
 1495:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1496: 
 1497:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1498:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1499:    Vector2 gradPr;               // Gradient of pressure
 1500:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1501: 
 1502: 
 1503:    double hhat;                 // \breve{H} in notes
 1504: 
 1505:    double shapiro;
 1506: 
 1507:    double coriolis;             // Coriolis parameter
 1508: 
 1509:    // Vegetation parameters
 1510:    double veg_c2;
 1511:    double veg_beta;
 1512: 
 1513:    // Bottom drag parameters.
 1514:    double chi;
 1515:    double chi2;
 1516: 
 1517:    // Transport model
 1518:    TransportSide<transportModel> transport; // Transport model 
 1519: 
 1520:    __inline__ __device__ Point2 outputCoords(void) const;
 1521: 
