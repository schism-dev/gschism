  262: 
  263: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  264:     return make_double3(v.x / s, v.y / s, v.z / s);
  265: }
  266: 
  267: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  268:     return v.x*w.x + v.y*w.y + v.z*w.z;
  269: }
  270: 
  271: __device__ __forceinline__ double norm2(const double3& v) {
  272:     return v.x*v.x + v.y*v.y + v.z*v.z;
