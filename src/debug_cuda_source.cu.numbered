 5101:       node->ETP = 0.0;
 5102: 
 5103:       if constexpr(ntip == 0) return;
 5104: 
 5105:       // For all tidal potential components
 5106:       for (int j=0; j<ntip; j++) {
 5107: 
 5108:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5109: 
 5110:          node->ETP += nodeETP;
 5111: 
 5112:          if constexpr(iloadtide==1) { // loading tide
 5113:             assert(false && "Loading tide not implemented");
 5114:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5115:          }
 5116:          
 5117:       }
 5118: 
 5119:      
 5120:    }
