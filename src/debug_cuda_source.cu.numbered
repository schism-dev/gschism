 8000:    __global__ void setVelocityOpenBndNodes(void) {
 8001:    // For open boundary nodes sets their velocity to the imposed values.
 8002: 
 8003:       SIDE_BND(sidebnd);
 8004: 
 8005:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8006:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8007:          // to its segment to the average of the side velocity.
 8008: 
 8009:          for (int k = 0; k < nvrt; k++) {
 8010:             Node *n1 = sidebnd->side->n1;
 8011:             Node *n2 = sidebnd->side->n2;
 8012: 
 8013: 
 8014:             Vector2 n1_u2(n1->u2[k]);
 8015:             Vector2 n2_u2(n2->u2[k]);
 8016: 
 8017:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8018:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8019:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8020:             }
 8021:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8022:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8023:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8024:             }
 8025: 
 8026:          }
 8027: 
 8028:       }
 8029: 
 8030:    }
