 1638: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1639:    // Computes the 3D normal vector to the element at level k
 1640:    // Returns the normal vector and the area of the element
 1641: 
 1642:       if (isTri()) {
 1643:          // For triangles...
 1644: 
 1645:          // Gets the normal vector to the element (with a length equal to twice the area)
 1646:          if constexpr(ics==1) {
 1647:             const int kb0 = max(k, nodes[0]->kb);
 1648:             const int kb1 = max(k, nodes[1]->kb);
 1649:             const int kb2 = max(k, nodes[2]->kb);
 1650: 
 1651:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1652:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1653:             
 1654:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1655:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1656:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1657:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1658: 
 1659:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1660:             area3D = 0.5*len;
 1661: 
 1662:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1663: 
 1664:             return {nx/len, ny/len, nz/len};
 1665: 
 1666:            
 1667:          }
 1668:          else {  // lat/lon
 1669:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1670: 
 1671:          } // if ics
 1672:       }
 1673:       else {
 1674:          // For quads...
 1675: 
 1676:          assert(false && "Element normal vector: quads not yet implemented");
 1677: 
 1678: 
 1679:       }
 1680:    }
 1681: 
 1682: /**
 1683:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1684:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1685:    If the segment is completely inside the element, then it returns true.
 1686: 
 1687:    This function assumes:
 1688:    - The initial point is on a side of the element. 
 1689:    - Its position is given by parameter t in the range [0,1].
 1690:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1691:       intersects the element (elements are convex).
 1692: 
 1693:    To find the intersection point, this function does the following:
 1694:    - it finds the intersection of the line segment with all the element side lines,
 1695:       except for the one that contains the initial point.
 1696:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1697:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1698:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1699:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1700:       track segment is almost parallel to the element side line.
 1701: 
 1702:    Inputs:
 1703:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1704:    @param x2, y2: other end of the line segment
 1705: 
 1706:    Outputs:
 1707:    @param side:  side that intersects the line segment (input and output)
 1708:    @param nextElement (output): element that contains the intersection point
 1709:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1710:    @param zint (input/output): Vertical coordinate of the intersection point
 1711: 
 1712:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1713:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1714:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1715: 
 1716:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1717:    (Delta) being zero.
 1718: 
 1719:    The intersection2 point happens when:
 1720:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1721:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1722:    
 1723:    Assumption: the 4 points (including those of the side segment) are different.
 1724:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1725:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1726:    If true, (xIntersect,yIntersect) is the intersection.				
 1727:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1728: **/
 1729: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1730:                                               double &t, double& tIntersect) {
 1731: 
 1732:    double closest_intersect_t = 1e10;
 1733:    bool found_intersection = false;
 1734: 
 1735:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1736:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1737:    const Point2 x1 = side->point(t);
 1738:    
 1739: 
 1740:    Side *nextSide = nullptr;
 1741:    for (int i = 0; i < i34; i++) {
 1742: 
 1743:       // Element's i-th side 
 1744:       Side *side2 = sides[i];
 1745: 
 1746:       // Skip the side that contains the initial point
 1747:       if (side2 == side) continue;
 1748: 
 1749:       // (x3,y3)-(x4,y4) is the element side line
 1750:       const Point2 x3 = side2->n1->p2();
 1751:       const Point2 x4 = side2->n2->p2();
 1752: 
 1753:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1754:       const double delta = cross(x2 - x1, x3 - x4);
 1755: 
 1756:       if (delta != 0.0) {
 1757: 
 1758:          const double delta1 = cross(x3 - x1, x3 - x4);
 1759:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1760: 
 1761:          // Solves the two linear equations for tt1 and tt2
 1762:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1763:          const double tt2 = delta2/delta;
 1764: 
 1765:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1766:             closest_intersect_t = min(closest_intersect_t, tt1);
 1767:             nextSide = side2;
 1768: 
 1769:             nextElement = nextSide->otherElem(this);
 1770:             tIntersect = max(small, min(tt1, 1.0-small));
 1771:             t = tt2;
 1772: 
 1773:             found_intersection = true;
 1774:          }
 1775:       
 1776:       }
 1777: 
 1778:    }
 1779: 
 1780:    // found_intersection should always be true, since we checked all the sides.  
 1781:    side = nextSide;
 1782: 
 1783:    return found_intersection;
 1784: }
 1785: 
 1786: 
 1787: 
 1788: 
 1789: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1790:                                               double &t, double& tIntersect) {
 1791: 
 1792:    double closest_intersect_t = 1e10;
 1793:    bool found_intersection = false;
 1794: 
 1795:    for (int i = 0; i < i34; i++) {
 1796: 
 1797:       Side *side2 = sides[i];
 1798: 
 1799:       // (x3,y3)-(x4,y4) is the element side line
 1800:       const Point2 x3 = side2->n1->p2();
 1801:       const Point2 x4 = side2->n2->p2();
 1802: 
 1803:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1804:       const double delta = cross(x2 - x1, x3 - x4);
 1805: 
 1806:       if (abs(delta) > 0) {
 1807: 
 1808:          const double delta1 = cross(x3 - x1, x3 - x4);
 1809:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1810: 
 1811:          // Solves the two linear equations for tt1 and tt2
 1812:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1813:          const double tt2 = delta2/delta;
 1814: 
 1815:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1816:             closest_intersect_t = min(closest_intersect_t, tt1);
 1817:             side = side2;
 1818:             nextElement = side->otherElem(this);
 1819:             t = tt2;
 1820:             tIntersect = max(small, min(tt1, 1.0-small));
 1821:             found_intersection = true;
 1822:          }
 1823:       
 1824:       }
 1825:       else {  // parallel segments
 1826:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1827:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1828: 
 1829:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1830: 
 1831:          // const double dist = dot(x1 - x3, side2->n);
 1832:          // if (abs(dist) < small*length(x3 - x4)) {
 1833:          //    const double2 unitarySide = normalize(x4 - x3);
 1834:          //    const double len = dot(x2 - x1, unitarySide);
 1835:          //    t = t + len;
 1836:          //    t = max(0.0, min(t, 1.0));
 1837:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1838: 
 1839: 
 1840:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1841:          //    // t = tt2;
 1842:          //    found_intersection = true;
 1843:          // }
 1844:       }
 1845: 
 1846: 
 1847:    }
 1848: 
 1849:       
 1850:    assert(found_intersection && "No intersection found");
 1851: 
 1852:    // found_intersection should always be true, since we checked all the sides.  
 1853:    return found_intersection;
 1854: }
 1855: 
 1856: 
 1857: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1858:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1859: 
 1860:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1861: 
 1862:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1863:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1864:    // curElement.
 1865: 
 1866:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1867:    // And uses this velocity instead to continue the tracking.
 1868: 
 1869:    // computes the intersection point in cartesian coordinates
 1870:    Point2 intersection = nextSide->p_t(tt);
 1871: 
 1872:    // Nudges the point to the barycenter of the element. 
 1873:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1874:    // next segment intersects the element sides.  
 1875:    curElem->nudgeToBarycenter(intersection);
 1876: 
 1877:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1878:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1879:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1880:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1881: 
 1882:    // If the side is an open boundary, the tangential velocity is zero.
 1883:    if (nextSide->isBnd()) vtan = 0.0;
 1884: 
 1885:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1886:    const double us = vtan*nextSide->t().x;
 1887:    const double vs = vtan*nextSide->t().y;
 1888:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1889: 
 1890:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1891:    const double len2 = norm2(intersection - toPoint2(xt));
 1892:    const double vel2 = dot(u_int, u_int);        
 1893:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1894:    else            dt = 0.0;
 1895: 
 1896:    // The end of this tracking segment is now the intersection point.
 1897:    xt = {intersection.x, intersection.y, zint};
 1898: 
 1899:    u_int = {us, vs, ws};
 1900:    
 1901: }
 1902: 
 1903: /**
 1904:  * Tracks a particle through elements and vertical levels in the mesh.
 1905:  * 
 1906:  * @param x0,y0,z0     Starting position coordinates
 1907:  * @param xt,yt,zt     Target position coordinates
 1908:  * @param dtb          Time step for tracking
 1909:  * @param uuint,vvint,wwint Initial velocity components
 1910:  * @param nextElem     Starting/resulting element index
 1911:  * 
 1912:  * @return Status code of type trackExitCodes
 1913:  * 
 1914:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1915:  * of the details are different. The idea is that the code requires less branches and is better fit
 1916:  * for GPU execution.
 1917:  * 
 1918:  * The main ideas here are:
 1919:  * - The starting point is expected to be in the starting element.
 1920:  * - The end point is guaranteed to be inside an element.
 1921:  * - since the starting point is inside the element, there are only two cases: 
 1922:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1923:  *     (b) it does not and (xt,yt) is already in the starting element.
 1924:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1925:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1926:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1927:  * - tt1 can be positive or negative. We only consider the positive values.
 1928:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1929:  * - The next intersection will occur at the smallest positive tt1.
 1930:  * - This intersection will be the next (x0,y0) position.
 1931:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1932:  *   of getting stuck in a loop.
 1933:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1934:  *   was found.
 1935:  */
 1936: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1937:                                                        Element *&nextElem, int &jlev, double &dt,
 1938:                                                        const Side *origSide) {
 1939: 
 1940: 
 1941: 
 1942:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1943:    // else to do.
 1944:    // If it is, nudges the point to be inside the element.
 1945:    const Element *curElem = nextElem;
 1946:    if (containsPoint(toPoint2(xt), true)) {
 1947: 
 1948:       curElem->interpolateVelocities(xt, u_int);
 1949: 
 1950: addDebugPlot(x0, xt);
 1951:       return true;
 1952:    }
 1953: 
 1954:    Side *side = nullptr;
 1955: 
 1956:    // 1. Initial checks
 1957:    // Verify starting element is valid (wet)
 1958:    assert(!curElem->isDry && "Starting element is dry");
 1959: 
 1960:    // Checks if track has a zero length.
 1961:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1962:    // assert(len2 > 0.0 && "Zero length track"); 
 1963:    
 1964:    const int MAX_ITERATIONS = 1000;
 1965:    
 1966:    double t;
 1967:    Side *nextSide = nullptr;
 1968:    double tIntersect = 1e10;
 1969:    double zint = x0.z;
 1970: 
 1971:    // Horizontal tracking loop
 1972:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1973:    // (x0,y0) is inside the element but the target point is not.
 1974: 
 1975:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1976: 
 1977:    assert(found_intersection && "No intersection found at %d");
 1978: 
 1979:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1980: 
 1981:    // if the tracking segment goes out of water (either dry or edge boundary)
 1982:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1983: 
 1984: addDebugPlot(x0, xt, 0x00A0FF);
 1985:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1986: addDebugPlot(x0, xt, 0x00A0FF);      
 1987: 
 1988:       nextElem = this;
 1989:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1990:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1991:       return true;    
 1992:    }
 1993: 
 1994: 
 1995:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1996:    int iterations = 0;
 1997:    while (iterations < MAX_ITERATIONS) {
 1998:       iterations++;
 1999:       
 2000:       Element *curElem = nextElem;
 2001: 
 2002:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2003: addDebugPlot(x0, xt);
 2004:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2005: 
 2006:       // If we are already in the target element, we are done.
 2007:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2008:       if (!found_intersection) break;
 2009: 
 2010: 
 2011: 
 2012:       // if the tracking segment goes out of water (either dry or edge boundary).
 2013:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2014: addDebugPlot(x0, xt, 0x00A0FF);
 2015:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2016: addDebugPlot(x0, xt, 0x00A0FF);   
 2017:          nextElem = curElem;
 2018: 
 2019:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2020:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2021:          return true;
 2022:       }
 2023:       
 2024:       // Update position and element for next iteration
 2025:       side = nextSide;
 2026: 
 2027:    }
 2028: 
 2029:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2030: 
 2031:  
 2032:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2033:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2034: addDebugPlot(x0, xt);   
 2035:    nextElem->interpolateVelocities(xt, u_int); 
 2036: 
 2037:    return true;
 2038: }
 2039: 
 2040: 
 2041: __inline__ __device__ double Element::computeSignedArea(void) const {
 2042:    // Compute the area of the element
 2043: 
 2044:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2045: 
 2046:    // In the quad case we need to add the area of the other triangle.
 2047:    if (isQuad()) {
 2048:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2049:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2050:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2051:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2052:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2053:          Error("Negative area found in quad element");
 2054:       }
 2055:       res += ar1;
 2056:    }
 2057: 
 2058:    return res;
 2059: }
 2060: 
 2061: 
 2062: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2063:                                                                 (nodes[1]->isDry2()) ||
 2064:                                                                 (nodes[2]->isDry2()) ||
 2065:                                                                 (i34==4 && nodes[3]->isDry2());
 2066: }
 2067: 
 2068: 
 2069: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2070:    // In boundary sides, the element 1 is nullptr
 2071:    return side->elems[1] == nullptr; 
 2072: }
 2073: 
 2074: 
 2075: 
 2076: /**
 2077:    Compute the shape coordinates of the point (xt,yt) in the element.
 2078:    @param xt (input): x-coordinate of the point
 2079:    @param shpCoords (output): shape coordinates of the point
 2080:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2081:    @return true if the point is inside the element, false otherwise
 2082: **/
 2083: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2084:                                             bool fixNegshpCoord) const {
 2085: 
 2086:    // Compute the shape coordinates of the point xt in the element.
 2087:    if (i34==3) {
 2088:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2089:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2090:       // and in this case, the pt will be nudged into the element
 2091:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2092:       // from the local frame, so use additional check.
 2093: 
 2094:       Point2 x0, x1, x2;
 2095: 
 2096:       if constexpr(ics==1) {
 2097:          x0 = nodes[0]->p2();
 2098:          x1 = nodes[1]->p2();
 2099:          x2 = nodes[2]->p2();
 2100:       }
 2101:       else // lat/lon
 2102:       {
 2103:          Error("Not implemented yet");
 2104: #ifdef ICS2
 2105:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2106:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2107:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2108: #endif
 2109:       }
 2110: 
 2111:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2112:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2113:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2114:       shpCoords[3] = 0.0;
 2115:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2116: 
 2117:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2118:       // then we fix the negative shape coordinates.
 2119:       if (fixNegshpCoord && tmpmin<=0.0) {
 2120: 
 2121:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2122:          // keeping the sum of the shape coordinates equal to 1.
 2123:          // I have tested and compared the new algorithm with the old one, and they give
 2124:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2125:          // The new algorithm should be faster since it is branchless.
 2126:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2127:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2128:          
 2129:          shpCoords[0] = (shpCoords[0] + a)*b;
 2130:          shpCoords[1] = (shpCoords[1] + a)*b;
 2131:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2132: 
 2133:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2134:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2135:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2136:          }
 2137: 
 2138:          // Update the point coordinates for the new shape coordinates
 2139:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2140:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2141:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2142: 
 2143:       }
 2144: 
 2145:       // Check if the point is inside the element
 2146:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2147:    }
 2148:    else {
 2149:       Error("Not implemented yet");
 2150: #ifdef QUADS
 2151:       // Reproject pt in eframe of nel for ics=2
 2152:       if constexpr(ics==1) {
 2153:          xn2 = xt; 
 2154:          yn2 = yt;
 2155:       }
 2156:       else {
 2157:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2158:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2159:       }
 2160: 
 2161:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2162: #endif
 2163:    }
 2164: 
 2165:    return false;  // Never reached
 2166: 
 2167: }
 2168: 
 2169: 
 2170: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2171: // Convert shape coordinates to cartesian coordinates
 2172: 
 2173:    if (i34 == 3) {
 2174:       // Triangular element
 2175:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2176:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2177:    }
 2178:    else {
 2179:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2180:    }
 2181: 
 2182: }
 2183: 
 2184: 
 2185: /**  Interpolate velocities at a given point (xt,yt,zt)
 2186: 
 2187:    @param xt, yt, zt: coordinates of the point to interpolate
 2188:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2189: 
 2190:    This is done in four steps:
 2191: 
 2192:    1. Find the shape coordinates for the final position in the element.
 2193:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2194:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2195:       z levels at xt, yt at each step.   
 2196:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2197:       horizontally and vertically.
 2198: **/
 2199: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2200:    // Interpolate the velocities at the point xt. 
 2201:    // This function works the same for triangular and quadrilateral elements.
 2202:    double shpCoord[4];
 2203: 
 2204:    // First step is to compute the shape coordinates of (xt,yt)
 2205:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2206:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2207: 
 2208:    // Second step is to find the level that contains zt
 2209:    // Uses a binary search to find the level
 2210:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2211:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2212:    int R = nvrt - 1;
 2213: 
 2214:    // Get the z coordinates at the nodes of the element at the levels L and R
 2215:    double zLAtNodes[4], zRAtNodes[4];
 2216:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2217:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2218: 
 2219:    double zL = interpolate(shpCoord, zLAtNodes);
 2220:    double zR = interpolate(shpCoord, zRAtNodes);
 2221:    
 2222:    // Interpolates vertically the velocities
 2223:    double wght1, wght2;
 2224:    if (xt.z<=zL) {
 2225:       wght1 = 1.0;
 2226:       wght2 = 0.0;
 2227:    }
 2228:    else if (xt.z>=zR) {
 2229:       wght1 = 0.0;
 2230:       wght2 = 1.0;
 2231:    }
 2232:    else {
 2233:       // Perform a binary search to find the levels between L and R that contain xt.z
 2234:       while (R - L > 1) {
 2235:          int M = (L + R) / 2;
 2236: 
 2237:          double zMAtNodes[4];
 2238:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2239:          double zM = interpolate(shpCoord, zMAtNodes);
 2240:          if (zM < xt.z) 
 2241:          {
 2242:             L = M;
 2243:             zL = zM;
 2244:          }
 2245:          else 
 2246:          {
 2247:             R = M;
 2248:             zR = zM;
 2249:          }
 2250:       }
 2251:       assert(L == R-1);
 2252:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2253: 
 2254:       wght2 = (xt.z - zL)/(zR - zL);
 2255:       wght1 = 1.0 - wght2;
 2256:    }
 2257: 
 2258:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2259:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2260: 
 2261:    // Neither of the interpolated velocities should be NaN
 2262:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2263: 
 2264: }
