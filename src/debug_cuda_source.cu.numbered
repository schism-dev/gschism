 1025: // This struct is used to store the boundary information for a node.
 1026: struct NodeBoundary {   
 1027:    BoundarySegment *segment;
 1028:    Node *node;
 1029:    
 1030:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1031:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1032: 
 1033:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1034:    double elbc;   // Elevation boundary condition
 1035:    int iettype;   // Type of elevation boundary condition
 1036:    double eth;    // Elevation time history
 1037: 
 1038:    double eta_mean; // Mean elevation at nodes
 1039: 
 1040:    bool isEssentialBC;
 1041: 
 1042:    Vector2 uth[nvrt];           // "Time history" velocity
 1043: 
 1044:    // Arrays for harmonic constituents (if needed)
 1045:    double  emo[nbfr];  // Elevation amplitude
 1046:    double  efa[nbfr];  // Elevation phase
 1047:    Vector2 umo[nbfr];  // velocity amplitude
 1048:    Vector2 ufa[nbfr];  // velocity phase
 1049: 
 1050: 
 1051:    
 1052:    __forceinline__ __device__ int numSidesForAverage() const {
 1053:    // Returns the number of sides that are connected to the node and have the same segment.
 1054:    // This is used to compute the average velocity at the node for open boundary nodes.
 1055:       int res = 0;
 1056:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1057:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1058:       return res;
 1059:    }
 1060: 
 1061: 
 1062:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1063:       assert(index == 0 || index == 1); 
 1064:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1065:    }
 1066: 
 1067: 
 1068: };
