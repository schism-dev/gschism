 7122: 
 7123:    __global__ void computeVerticalVelocity(void) {
 7124:       // Computes the vertical velocity at the (2D) element's centroid.
 7125:       // In this function we will be considering volumetric elements, with side faces and a 
 7126:       // bottom and a top face. We will call them SFs, BF and TF.
 7127:       // It computes the flux coming from BF and the SFs.
 7128:       // If the bed is moving, it takes that into account.
 7129:       // Since water is incompressible, the integral of the velocity times the normal vector
 7130:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7131:       // and the BF is equal to the flux going out from the TF.
 7132:       // TF = - BF - sum(SFs).
 7133:       // It then computes the horizontal velocity at the center of TF.
 7134:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7135:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7136:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7137: 
 7138:       ELEM(elem);
 7139: 
 7140:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7141: 
 7142:       if (elem->isDry) return;
 7143: 
 7144:       const int kb = elem->kb;
 7145:       const bool isTri = elem->isTri();
 7146: 
 7147:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7148: 
 7149:       // Compute the bottom velocity
 7150:       if constexpr(imm != 0) {
 7151:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7152:       }
 7153: 
 7154: 
 7155:       double bottomArea3D;
 7156:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7157: 
 7158:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7159: 
 7160:       double topArea3D;
 7161: 
 7162:       // Bottom face flux
 7163:       double bottomFlux = 0.0;
 7164:       Vector2 u2meanBottom = {0.0, 0.0};
 7165:       const Vector2 gradh = elem->grad2(&Node::depth);
 7166:       if constexpr(imm==2) {
 7167:          Vector3 ubed;
 7168: 
 7169:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7170:          // updateBDEF(ubed);
 7171:      
 7172:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7173: 
 7174:          // elem->w[kb] += ubed.z;
 7175:       }
 7176:       else {
 7177: 
 7178:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7179:   
 7180:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7181:          // in the direction of motion.
 7182:          const double bottomW = - dot(gradh, u2meanBottom);  
 7183:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7184: 
 7185:          // VElocity associated to the bed deformation
 7186:          double bedVelocity = 0.0;
 7187:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7188: 
 7189:          elem->w[kb] = bedVelocity + bottomW; 
 7190: 
 7191:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7192:          
 7193:       } // if imm
 7194: 
 7195:       // Compute w for kb+1 to nvrt-1
 7196:       for (int l = kb; l < nvrt - 1; l++) {
 7197: 
 7198:          // normal vector to the top face of the "volumetric" element (3D)
 7199:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7200: 
 7201:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7202:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7203: 
 7204:          // Compute the total flux at the sides
 7205:          double sideFlux = 0.0;
 7206: 
 7207:          for (int j = 0; j < elem->i34; j++) {
 7208:             const Side *side = elem->sides[j];
 7209:             const int kbs = side->kb;
 7210:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7211:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7212:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7213: 
 7214:             // The area is "clamped" meaning that it takes kb into account.
 7215:             const double sideArea = side->areaClamped(l);
 7216: 
 7217:             const double sign = elem->ssign[j]; 
 7218: 
 7219:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7220:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7221:          }
 7222:          
 7223:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7224:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7225:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7226: 
 7227:          // The flux at the top ace can be computed from the other flows.
 7228:          // All fluxes are in directions into the prism.
 7229:          const double topFlux = - sideFlux - bottomFlux;
 7230: 
 7231:          // Flux at the top face due to the horizontal velocities only
 7232:          // topFlux = topHorizontalFlux + topVerticalFlux
 7233:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7234: 
 7235:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7236:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7237: 
 7238:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7239: 
 7240:          bottomFlux = -topFlux;
 7241:          
 7242:       }
 7243: 
 7244:    }  
 7245: 
 7246: 
 7247: 
 7248: 
 7249: 
 7250: 
 7251: 
