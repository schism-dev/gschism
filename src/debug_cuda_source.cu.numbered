 6796:    __global__ void computeBottomDragVegetation(void) {
 6797:       // UNFINISHED. CHECK THIS: XXXXX
 6798:       // How many kernels are needed? Why so many for loops?
 6799:       // Is the loop on sides needed?
 6800: 
 6801:       NODE(node);
 6802: 
 6803:       const int    kb      = node->kb;
 6804:       const double htot    = node->htot2(); 
 6805:       
 6806:       if (node->isDry) {
 6807:          // Default values for dry nodes
 6808:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6809:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6810: 
 6811:          return;
 6812:        
 6813:       }
 6814: 
 6815:       // Computes bottom drag Cd based on the selected nchi
 6816:       node->computeBottomDragCd();
 6817:       
 6818: 
 6819: 
 6820:       //   Bottom stress in m^2/s^2
 6821:       if (node->rho[kb + 1] >= -98.0)
 6822:       {
 6823:          const double mag_u = length(node->u2[kb + 1]);
 6824:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6825: 
 6826:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6827:          // !sediment erosion: this part needs more documentation
 6828:       }
 6829:     
 6830: 
 6831: 
 6832:       // Compute vegetation parameters
 6833:       //--------------------------------
 6834: 
 6835: 
 6836:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6837:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6838: 
 6839:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6840:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6841:          int kbin = 0; // bin index
 6842:          for (int k = kb; k < nvrt; k++) {
 6843:             // Computes node height above the bottom level
 6844:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6845:             assert(false && "Vertical variation of vegetation not implemented");
 6846: 
 6847:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6848:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6849:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6850:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6851:             // } else {
 6852:             //    // Find the bin at which the current vertical level is
 6853:             //    while (kbin<nbins_veg_vert) {
 6854:             //       const double zn = node->z[kbin];
 6855:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6856:             //          break;
 6857:             //       } // if
 6858:             //       kbin++;
 6859:             //    } // while
 6860:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6861: 
 6862:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6863:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6864:                
 6865:             //    // Linear interpolation of the vegetation parameters
 6866:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6867:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6868:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6869:             // } // if rl10
 6870: 
 6871:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6872: 
 6873:          } // for k
 6874: 
 6875: 
 6876:       } else { // Ganthy (iveg==2)
 6877:       //  Modify canopy height, diameter, and density
 6878: 
 6879:          // Make sure there is vegetation on this node
 6880:          if (node->veg_h_unbent > 0.0) {
 6881:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6882: 
 6883:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6884:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6885:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6886: 
 6887:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6888:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6889:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6890:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6891:          } // if veg_h_unbent
 6892: 
 6893:          for (int k = 0; k < nvrt; k++) {
 6894:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6895:          } // for k
 6896:       
 6897: 
 6898:       } // if iveg
 6899:      
 6900: 
 6901:       // Compute vertical mean of veg_alpha3D
 6902:       if (iveg != 0) {
 6903:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6904:          double sum1=0.0;
 6905:          double sum2=0.0;
 6906:          // Integrate over each level under the canopy...
 6907:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6908:             const double Dz = node->Dz(k);
 6909: 
 6910:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6911:             sum2 += Dz;
 6912: 
 6913:          } // for k
 6914:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6915:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6916: 
 6917:       } // if iveg
 6918: 
 6919:    }
