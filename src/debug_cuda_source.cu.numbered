 2378: 
 2379: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2380:    if constexpr(ics == 1)  {
 2381:       return center;
 2382: 
 2383:    } else {
 2384:       const Point2 p0 = nodes[0]->outputCoords();
 2385:       const Point2 p1 = nodes[1]->outputCoords();
 2386:       const Point2 p2 = nodes[2]->outputCoords();
 2387: 
 2388:       if (isTri()) {
 2389:          return (1.0/3.0)*(p0 + p1 + p2);
 2390: 
 2391:       } else {
 2392:          const Point2 p3 = nodes[3]->outputCoords();
 2393:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2394:       }
 2395: 
 2396:    }
 2397: }
