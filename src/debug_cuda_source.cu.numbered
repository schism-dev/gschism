 1799: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1800:    // Computes the 3D normal vector to the element at level k
 1801:    // Returns the normal vector and the area of the element
 1802: 
 1803:       if (isTri()) {
 1804:          // For triangles...
 1805: 
 1806:          // Gets the normal vector to the element (with a length equal to twice the area)
 1807:          if constexpr(ics==1) {
 1808:             const int kb0 = max(k, nodes[0]->kb);
 1809:             const int kb1 = max(k, nodes[1]->kb);
 1810:             const int kb2 = max(k, nodes[2]->kb);
 1811: 
 1812:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1813:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1814:             
 1815:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1816:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1817:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1818:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1819: 
 1820:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1821:             area3D = 0.5*len;
 1822: 
 1823:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1824: 
 1825:             return {nx/len, ny/len, nz/len};
 1826: 
 1827:            
 1828:          }
 1829:          else {  // lat/lon
 1830:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1831:             return {0.0, 0.0, 0.0};
 1832: 
 1833:          } // if ics
 1834:       }
 1835:       else {
 1836:          // For quads...
 1837: 
 1838:          assert(false && "Element normal vector: quads not yet implemented");
 1839:          return {0.0, 0.0, 0.0};
 1840: 
 1841: 
 1842:       }
 1843:    }
 1844: 
 1845: /**
 1846:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1847:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1848:    If the segment is completely inside the element, then it returns true.
 1849: 
 1850:    This function assumes:
 1851:    - The initial point is on a side of the element. 
 1852:    - Its position is given by parameter t in the range [0,1].
 1853:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1854:       intersects the element (elements are convex).
 1855: 
 1856:    To find the intersection point, this function does the following:
 1857:    - it finds the intersection of the line segment with all the element side lines,
 1858:       except for the one that contains the initial point.
 1859:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1860:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1861:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1862:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1863:       track segment is almost parallel to the element side line.
 1864: 
 1865:    Inputs:
 1866:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1867:    @param x2, y2: other end of the line segment
 1868: 
 1869:    Outputs:
 1870:    @param side:  side that intersects the line segment (input and output)
 1871:    @param nextElement (output): element that contains the intersection point
 1872:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1873:    @param zint (input/output): Vertical coordinate of the intersection point
 1874: 
 1875:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1876:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1877:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1878: 
 1879:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1880:    (Delta) being zero.
 1881: 
 1882:    The intersection2 point happens when:
 1883:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1884:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1885:    
 1886:    Assumption: the 4 points (including those of the side segment) are different.
 1887:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1888:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1889:    If true, (xIntersect,yIntersect) is the intersection.				
 1890:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1891: **/
 1892: 
 1893: 
 1894: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1895:                                               double &t, double& tIntersect) {
 1896:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1897:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1898: 
 1899:    double closest_intersect_t = 1e10;
 1900:    bool found_intersection = false;
 1901: 
 1902:    for (int i = 0; i < i34; i++) {
 1903: 
 1904:       Side *side2 = sides[i];
 1905: 
 1906:       // (x3,y3)-(x4,y4) is the element side line
 1907:       const Point2 x3 = side2->n1->p;
 1908:       const Point2 x4 = side2->n2->p;
 1909: 
 1910:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1911:       const double delta = cross(x2 - x1, x3 - x4);
 1912: 
 1913:       if (abs(delta) > 0) {
 1914: 
 1915:          const double delta1 = cross(x3 - x1, x3 - x4);
 1916:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1917: 
 1918:          // Solves the two linear equations for tt1 and tt2
 1919:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1920:          const double tt2 = delta2/delta;
 1921: 
 1922:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1923:             closest_intersect_t = min(closest_intersect_t, tt1);
 1924:             side = side2;
 1925:             nextElement = side->otherElem(this);
 1926:             t =          clamp(tt2, small, 1.0-small);
 1927:             tIntersect = clamp(tt1, small, 1.0-small);
 1928:             found_intersection = true;
 1929:          }
 1930: 
 1931:       
 1932:       }
 1933:       else {  // parallel segments
 1934: 
 1935:          assert(false && "Parallel segments should not happen under the new code");
 1936:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1937:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1938: 
 1939:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1940:          const double dist = dot(x1 - x3, side2->n);
 1941:          if (abs(dist) < small*length(x3 - x4)) {
 1942:             const double2 unitarySide = normalize(x4 - x3);
 1943:             const double len = dot(x2 - x1, unitarySide);
 1944:             t = t + len;
 1945:             t = max(0.0, min(t, 1.0));
 1946:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1947: 
 1948: 
 1949:             // tIntersect = max(small, min(tt1, 1.0-small));
 1950:             // t = tt2;
 1951:             found_intersection = true;
 1952:          }
 1953:       }
 1954: 
 1955: 
 1956:    }
 1957: 
 1958: 
 1959:    assert(found_intersection && "No intersection found");
 1960: 
 1961:    // found_intersection should always be true, since we checked all the sides.  
 1962:    return found_intersection;
 1963: }
 1964: 
 1965: 
 1966: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1967:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1968: 
 1969:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1970:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1971:    // curElement.
 1972: 
 1973:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1974:    // And uses this velocity instead to continue the tracking.
 1975: 
 1976:    // computes the intersection point in cartesian coordinates
 1977:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1978: 
 1979:    // Nudges the point to the barycenter of the element. 
 1980:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1981:    // next segment intersects the element sides. 
 1982:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1983: 
 1984: 
 1985:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1986:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1987:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1988:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1989: 
 1990:    // If the side is an open boundary, the tangential velocity is set to zero.
 1991:    if (nextSide->isBnd()) vtan = 0.0;
 1992: 
 1993:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1994:    const double us = vtan*nextSide->t().x;
 1995:    const double vs = vtan*nextSide->t().y;
 1996:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 1997: 
 1998:    
 1999:    // The end of this tracking segment is now the intersection point.
 2000:    xt = {intersection.x, intersection.y, zint};
 2001: 
 2002: 
 2003:    u_int = {us, vs, ws};
 2004:    
 2005: }
 2006: 
 2007: /**
 2008:  * Tracks a particle through elements and vertical levels in the mesh.
 2009:  * 
 2010:  * @param x0,y0,z0     Starting position coordinates
 2011:  * @param xt,yt,zt     Target position coordinates
 2012:  * @param dtb          Time step for tracking
 2013:  * @param u_int        Initial velocity components
 2014:  * @param nextElem     Starting/resulting element index
 2015:  * 
 2016:  * @return Status code of type trackExitCodes
 2017:  * 
 2018:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2019:  * of the details are different. The idea is that the code requires less branches and is better fit
 2020:  * for GPU execution.
 2021:  * 
 2022:  * The main ideas here are:
 2023:  * - The starting point is expected to be in the starting element.
 2024:  * - since the starting point is inside the element, there are only two cases: 
 2025:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2026:  *     (b) it does not and (xt,yt) is already in the starting element.
 2027:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2028:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2029:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2030:  * - tt1 can be positive or negative. We only consider the positive values.
 2031:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2032:  * - The next intersection will occur at the smallest positive tt1.
 2033:  * - This intersection will be the next (x0,y0) position.
 2034:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2035:  *   of getting stuck in a loop.
 2036:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2037:  *   was found.
 2038:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2039:  */
 2040: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2041:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2042:                                                        const Side *origSide) {
 2043:                                                             
 2044:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2045:    // else to do. This means that the full step occurred within the current element.
 2046:    assert(!isDry && "Starting element is dry");
 2047:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2048: 
 2049:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2050: 
 2051:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2052:       assert(!isDry && "Target point is inside a dry element");
 2053: 
 2054:       interpolateVelocities(xt, u_int);
 2055: 
 2056:       nextElem = this;
 2057: 
 2058: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2059:       return true;
 2060:    }
 2061: 
 2062: 
 2063:    
 2064: 
 2065:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2066:    
 2067:    double t;
 2068:    Side *nextSide = nullptr;
 2069:    double tIntersect = 1e10;
 2070: 
 2071: 
 2072:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2073:    // (x0,y0) is inside the element but the target point is not.
 2074:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2075:    assert(found_intersection && "No intersection found at %d");
 2076: 
 2077:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2078: 
 2079:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2080: 
 2081:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2082:    if (nextElem != nullptr && !nextElem->isDry) nextElem->nudgeToBarycenter(xtmp);
 2083: 
 2084:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2085:    xt = {xtmp.x, xtmp.y, zint};
 2086: 
 2087:    // if the tracking segment goes out of water (either dry or edge boundary)
 2088:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2089: 
 2090: 
 2091:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2092: 
 2093: 
 2094:       // When this happens, the backtracking stops.
 2095:       dt = time_rm;
 2096: 
 2097:       // In this case, the next element is again the current element.
 2098:       nextElem = this;
 2099: 
 2100:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2101:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2102:       return true;    
 2103:    }
 2104: 
 2105: 
 2106:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2107:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2108:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2109: 
 2110:    nextElem->interpolateVelocities(xt, u_int); 
 2111: 
 2112:    assert(nextElem != this && "Next element is the same as the current element");
 2113: 
 2114:    return true;
 2115: }
 2116: 
 2117: 
 2118: __inline__ __device__ double Element::computeSignedArea(void) const {
 2119:    // Compute the area of the element
 2120: 
 2121:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2122: 
 2123:    // In the quad case we need to add the area of the other triangle.
 2124:    if (isQuad()) {
 2125:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2126:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2127:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2128:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2129: 
 2130:       res += ar1;
 2131:    }
 2132: 
 2133:    return res;
 2134: }
 2135: 
 2136: 
 2137: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2138:                                                                 (nodes[1]->isDry2()) ||
 2139:                                                                 (nodes[2]->isDry2()) ||
 2140:                                                                 (i34==4 && nodes[3]->isDry2());
 2141: }
 2142: 
 2143: __inline__ __device__ double Element::detJ_eta(void) const {
 2144:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2145:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2146: }
 2147: 
 2148: __inline__ __device__ double Element::detJ_xi(void) const {
 2149:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2150:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2151: }
 2152: 
 2153: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2154:    // In boundary sides, the element 1 is nullptr
 2155:    return side->elems[1] == nullptr; 
 2156: }
