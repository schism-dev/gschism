 4206:    __global__ void computeFlowBcVelocities(double time) {
 4207: 
 4208:       SIDE_BND(sideBnd);
 4209: 
 4210:       const Side *side = sideBnd->side;
 4211:  
 4212:       const bool isDry = side->isDry;
 4213: 
 4214:    
 4215: 
 4216:       if (isDry) {
 4217:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4218:          return;
 4219:       }
 4220: 
 4221:       // For wet sides in open boundaries...
 4222:       const Vector2 n = side->n;
 4223:       const BoundarySegment *segment = sideBnd->segment;
 4224: 
 4225:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4226: 
 4227:       const int ifltype = segment->ifltype;
 4228: 
 4229:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4230:       const Vector2 r_nuth0 = r_uth0*n;
 4231: 
 4232:       for (int k = 0; k < nvrt; k++) {
 4233:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4234:          Vector2 r_u1_bar = {0.0, 0.0};
 4235:       
 4236:          if (ifltype == 1 || ifltype == 2) {
 4237:          
 4238:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4239: 
 4240:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4241:             
 4242:             r_uth = unth0*n;  // This case has no ramp-up
 4243:             
 4244:          } else if (ifltype == -1) { // Flather 1
 4245: 
 4246:             // uth is the normal vel.; no ramp up
 4247:             const double uth = sideBnd->nuth(k);
 4248:             r_uth = uth*n;
 4249:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4250: 
 4251: 
 4252:          } else if (ifltype == 3 || ifltype == 5) {
 4253:             // vnth0=0 !normal vel.
 4254: 
 4255:             // Computes the contribution to the velocity from all tide frequencies
 4256:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4257: 
 4258:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4259:                const Vector2 umo  = sideBnd->umo(jfr); 
 4260: 
 4261:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4262:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4263:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4264:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4265:             }
 4266: 
 4267:          } // if (ifltype = 3 || ifltype == 5
 4268: 
 4269: 
 4270:          switch (ifltype) {
 4271:             case 1:
 4272:             case 2:
 4273:             case 4:
 4274:                sideBnd->ubc[k] = r_uth;
 4275:                break;
 4276:             case 3:
 4277:                sideBnd->ubc[k] = r_u1_bar;
 4278:                break;
 4279:             case 5:
 4280:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4281:                break;
 4282:          } // switch
 4283: 
 4284:       } // for k
 4285:    }
 4286: 
 4287:    __global__ void computeElevationBoundaryConditions(double time) {
 4288:       // Compute elevation essential boundary conditions 
 4289: 
 4290:       NODE_BND(nodeBnd); // Each boundary node.
 4291: 
 4292:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4293: 
 4294:       const Node *node = nodeBnd->node;
 4295:       const BoundarySegment *segment = nodeBnd->segment;
 4296:       const int iettype = segment->iettype;
 4297:       
 4298: 
 4299:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4300:       double eic = 0.0;
 4301:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4302:       else                 eic = 0.0;
 4303: 
 4304:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4305:       const double r_eth = ramp*nodeBnd->eth;
 4306:       double r_eta1_bar = 0.0;
 4307: 
 4308: 
 4309:       // Compute tide elevation
 4310:       if (iettype == 3 || iettype == 5) {   
 4311: 
 4312:          if constexpr(iloadtide==1) { // loading tide
 4313:             assert(false && "Loading tide not implemented");
 4314:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4315:          }
 4316:          
 4317:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4318: 
 4319:             const double efa  = nodeBnd->efa[jfr]; 
 4320:             const double emo  = nodeBnd->emo[jfr]; 
 4321: 
 4322:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4323:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4324:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4325: 
 4326:          } // for jfr
 4327: 
 4328:       } // if iettype
 4329: 
 4330:       switch (iettype) {
 4331:          case 1:
 4332:          case 2:
 4333:          case 4:
 4334:             nodeBnd->elbc = r_eic + r_eth;
 4335:             break;
 4336:          case 3:
 4337:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4338:             break;
 4339:          case 5:
 4340:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4341:             break;
 4342:       } // switch
 4343: 
 4344: 
 4345:       //Add inverse barometric effects
 4346:       if (iettype != 0 && inv_atm_bnd == 1) {
 4347:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4348:       }
 4349: 
 4350:    }
 4351: 
 4352: 
 4353:    __global__ void computeHorizontalViscosity(void) { 
 4354: 
 4355:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4356: 
 4357:       SIDE(side);
 4358: 
 4359:       if (side->isDry) return;
 4360: 
 4361:       for (int k = 0; k < nvrt; k++) {
 4362:          side->nuGradU[k] = {0.0, 0.0};
 4363:       }
 4364: 
 4365:       if constexpr(ihorcon == 1) {
 4366:          for (int k = side->kb; k < nvrt - 1; k++) {
 4367:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4368:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4369:             // By Zhang and Baptista.
 4370: 
 4371:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4372:             // This is a standard discretization of the Laplacian operator.
 4373:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4374:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4375:             // Gamma is hvis_coef0 in the code.
 4376:             // The value of gamma needs to be < 0.5.
 4377: 
 4378:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4379:             // side under consideration in each of the two possible elements that share the side.
 4380:             Vector2 sumU = {0.0, 0.0};
 4381:             for (int l = 0; l < 2; l++) {
 4382:                const Element *elem = side->elems[l];
 4383: 
 4384:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4385: 
 4386:                // Find the local index of the side in the element
 4387:                const int idxSide = elem->sideLocalIdx(side);
 4388:                // Find the two sides that are connected to the side under consideration
 4389:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4390:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4391: 
 4392:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4393: 
 4394:             }
 4395: 
 4396:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4397:    
 4398:          }
 4399:       }
 4400:       else if constexpr(ihorcon == 2) {
 4401:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4402:       }
 4403: 
 4404: 
 4405:    }
 4406: 
 4407: 
 4408:    __global__ void setEssentialBC(void) {
 4409:       // Set essential boundary conditions 
 4410:       NODE(node); // Each boundary node
 4411:       NodeBoundary *nodeBnd = node->nodeBnd;
 4412:       
 4413: // nodeBnd->isEssentialBC = true;      
 4414:       // Check if this node has essential BC
 4415:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4416:          // Verify BC value is valid
 4417:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4418: 
 4419:        
 4420:          // Set diagonal to 1 and zero off-diagonals
 4421:          node->coeffDiag = 1.0;
 4422: 
 4423:          for (int j = 0; j < node->numNodes; j++) {
 4424:                node->coeffMatrix[j] = 0.0;
 4425:          }
 4426:          
 4427:          // Set solution and RHS to BC value
 4428:          node->mX  = nodeBnd->elbc;
 4429:          node->qel = nodeBnd->elbc;
 4430: 
 4431:       } else {
 4432:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4433: 
 4434:          for (int j = 0; j < node->numNodes; j++) {
 4435:                Node* nbNode = node->nodes[j];
 4436:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4437:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4438:                   // Verify neighbor's BC value
 4439:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4440: 
 4441:                   // Subtract contribution to RHS
 4442:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4443:                   node->coeffMatrix[j] = 0.0;  
 4444:                }
 4445:          }
 4446:       }
 4447:    }
 4448: 
 4449: 
 4450:    __global__ void updateElevation(void) {
 4451:       NODE(node);
 4452: 
 4453:       node->eta2 = node->mX;
 4454: 
 4455:       node->updateZCoordData();
 4456:    }
 4457: 
 4458: 
 4459:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4460: 
 4461:       SIDE(side);
 4462: 
 4463: 
 4464:       side->U = {0.0, 0.0}; 
 4465:          
 4466:       if(side->isDry) return;
 4467: 
 4468:       const Node *node1 = side->n1;
 4469:       const Node *node2 = side->n2;
 4470: 
 4471:       // Vertically integrated velocity U (in ll if ics=2)
 4472:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4473:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4474:       }
 4475: 
 4476:    }
 4477: 
 4478:    __global__ void computeBottomDragVegetation(void) {
 4479:       // UNFINISHED. CHECK THIS:
 4480:       // How many kernels are needed? Why so many for loops?
 4481:       // Is the loop on sides needed?
 4482: 
 4483:       NODE(node);
 4484: 
 4485:             
 4486:       const int    kb      = node->kb;
 4487:       const double htot    = node->htot2(); 
 4488:       const double rough   = node->rough;
 4489: 
 4490: 
 4491:       if (node->isDry) {
 4492:          // Default values for dry nodes
 4493:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4494:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4495: 
 4496:          return;
 4497:        
 4498:       }
 4499: 
 4500: 
 4501:       // Compute bottom drag Cd
 4502:       //--------------------------------
 4503: 
 4504:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4505:       if constexpr(nchi == 1) {
 4506: 
 4507:          bool ltmp = false; // for WBL iteration
 4508: 
 4509:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4510:          // Drag at nodes
 4511:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4512:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4513:         
 4514:          const double rough = node->rough;
 4515:         
 4516:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4517:          if (node->rough == 0.0) {
 4518:             node->Cd = 0.0;
 4519: 
 4520:          } else { //roughness >0 
 4521:           
 4522:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4523:             const double bthick = max(dzb_min, bthick_ori);
 4524: 
 4525:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4526: 
 4527:             double tmp = 1.0/(2.5*log(bthick/rough));
 4528:             node->Cd = tmp*tmp;
 4529: 
 4530:          } // if rough
 4531: 
 4532: 
 4533:          // RECOVER THIS: XXX
 4534:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4535:          // Output warning for WBL if iteration didn't converge
 4536: 
 4537: 
 4538:       } // nchi==1
 4539: 
 4540: 
 4541: 
 4542:       //   Bottom stress in m^2/s^2
 4543:       if (node->rho[kb + 1] >= -98.0)
 4544:       {
 4545:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4546:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4547: 
 4548:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4549:          // !sediment erosion: this part needs more documentation
 4550:       }
 4551: 
 4552:   
 4553:       // Compute vegetation parameters
 4554:       //--------------------------------
 4555: 
 4556:       // SAV constants
 4557:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4558:       constexpr double veg_cfpsi = 0.16;
 4559: 
 4560:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4561:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4562: 
 4563:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4564:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4565:          int kbin = 0; // bin index
 4566:          for (int k = kb; k < nvrt; k++) {
 4567:             // Computes node height above the bottom level
 4568:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4569:             assert(false && "Vertical variation of vegetation not implemented");
 4570: 
 4571:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4572:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4573:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4574:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4575:             // } else {
 4576:             //    // Find the bin at which the current vertical level is
 4577:             //    while (kbin<nbins_veg_vert) {
 4578:             //       const double zn = node->z[kbin];
 4579:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4580:             //          break;
 4581:             //       } // if
 4582:             //       kbin++;
 4583:             //    } // while
 4584:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4585: 
 4586:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4587:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4588:                
 4589:             //    // Linear interpolation of the vegetation parameters
 4590:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4591:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4592:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4593:             // } // if rl10
 4594: 
 4595:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4596: 
 4597:          } // for k
 4598: 
 4599: 
 4600:       } else { // Ganthy (iveg==2)
 4601:       //  Modify canopy height, diameter, and density
 4602: 
 4603:          // Make sure there is vegetation on this node
 4604:          if (node->veg_h_unbent > 0.0) {
 4605:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4606: 
 4607:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4608:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4609:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4610: 
 4611:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4612:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4613:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4614:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4615:          } // if veg_h_unbent
 4616: 
 4617:          for (int k = 0; k < nvrt; k++) {
 4618:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4619:          } // for k
 4620:       
 4621: 
 4622:       } // if iveg
 4623:      
 4624:          
 4625:       // Compute vertical mean of veg_alpha3D
 4626:       if (iveg != 0) {
 4627:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4628:          double sum1=0.0;
 4629:          double sum2=0.0;
 4630:          // Integrate over each level under the canopy...
 4631:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4632:             const double Dz = node->Dz(k);
 4633: 
 4634:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4635:             sum2 += Dz;
 4636: 
 4637:          } // for k
 4638:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4639:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4640: 
 4641:       } // if iveg
 4642: 
 4643:    }
 4644: 
 4645:    __global__ void computeVegetationAndDragParameters(void) {
 4646:       // Computes the vegetation and drag model parameters:
 4647:       // chi, \tilde\chi, beta, \breve{H}
 4648:       
 4649:       SIDE(side);
 4650: 
 4651:       if (side->isDry) return;
 4652: 
 4653:       const double htot = side->htot2();
 4654:       const int    kb   = side->kb;
 4655: 
 4656:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4657: 
 4658:       const double veg_h     = side->veg_h();
 4659:       const double veg_nv    = side->veg_nv();
 4660:       const double veg_c     = side->veg_c();
 4661:       const double veg_beta  = side->veg_beta;
 4662:       const double veg_alpha = side->veg_alpha_vert_mean();
 4663: 
 4664:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4665:       // Velocity magnitude at the bottom level
 4666:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4667:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4668:       side->chi2 = side->Cd()*vmag1;
 4669:       side->chi  = side->chi2;
 4670:       if constexpr(iveg != 0) {
 4671:          const Node *n1 = side->n1;
 4672:          const Node *n2 = side->n2;
 4673:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4674:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4675:       }
 4676: 
 4677:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4678: 
 4679:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4680:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4681:       double magUa = 0.0;
 4682:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4683:          // 3D wet side with veg...
 4684: 
 4685:          double magUa = 0.0;
 4686:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4687:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4688: 
 4689:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4690:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4691:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4692: 
 4693:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4694:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4695: 
 4696:                // Velocity magnitude at the bottom (l) of the level
 4697:                const double ul = length(side->u2[k]);
 4698: 
 4699:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4700:                magUa += Dz*0.5*(uh + ul);
 4701: 
 4702:             } // if HasVegetation
 4703:          } // for k
 4704:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4705: 
 4706:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4707:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4708:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4709:             const double zCpy = side->zTopCanopy();
 4710:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4711:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4712:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4713:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4714:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4715:          } // if isSubmerged
 4716:       } // if iveg   
 4717: 
 4718:       // Computes the friction modified depth, \breve{H} in notes
 4719:       if (side->is2D()) { // 2D
 4720: 
 4721:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4722:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4723: 
 4724:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4725: 
 4726:          side->hhat = htot*htot/fricH; 
 4727: 
 4728:       } else { // 3D
 4729:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4730: 
 4731:          if constexpr(iveg != 0) {
 4732:             
 4733:             if (side->isSubmerged()) { 
 4734:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4735:                side->hhat -= veg_c*Hhat_alpha;
 4736: 
 4737:             } else { // Emergent
 4738:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4739:             }
 4740:          } // if iveg
 4741: 
 4742:          // Enforce positivity for 3D model
 4743:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4744:       } // if 3D
 4745: 
 4746:    }
 4747: 
 4748: 
 4749: 
 4750:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4751:    // Computes the density gradient between two elements, e1 and e2.
 4752:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4753:    // zero in the direction normal to the side. 
 4754:    // 
 4755:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4756:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4757:    //
 4758:    // Input:
 4759:    //    e1: Element
 4760:    //    e2: Neighbor element (or nullptr if boundary)
 4761:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4762:    //    k: Index of the half-level at which the density is interpolated
 4763:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4764:    // 
 4765:    // Output:
 4766:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4767:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4768: 
 4769:       if (e2 == nullptr || e2->isDry) {
 4770:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4771: 
 4772:          Side *side = e1->sides[j];
 4773:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4774:                  
 4775:          if constexpr(ics == 1) {
 4776:             vec = side->n; // Normal vector to the side
 4777:          } else {
 4778:             // IMPLEMENT THIS XXXXXX
 4779:             // !replace with xel, yel?
 4780:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4781:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4782:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4783:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4784:          } //ics
 4785:                    
 4786:          diffRho = 0.0;
 4787: 
 4788:       } else { //internal and wet
 4789:          if constexpr(ics==1) {
 4790:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4791: 
 4792:             // Vector from e1 to e2
 4793:             vec = toVector2(e2->center - e1->center);
 4794: 
 4795:          } else { 
 4796:             // IMPLEMENT THIS XXXXXX
 4797:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4798:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4799:             //                   alow(j)=xctr2
 4800:             //                   bdia(j)=yctr2
 4801:          } // ics
 4802: 
 4803:          diffRho = rho2 - e1->demeanedDensity(k);
 4804:       }
 4805: 
 4806:    }
 4807: 
 4808:    __global__ void computeDensityCubicSplines(void) {
 4809:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4810: 
 4811:       ELEM(elem);
 4812: 
 4813:       if (elem->isDry) return;
 4814: 
 4815:       const int kb = elem->kb;
 4816: 
 4817:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4818:       if (elem->is2D()) {
 4819:          // In the 2D case, the density is constant at the prism level. 
 4820:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4821:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4822:       } else { //3D
 4823: 
 4824:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4825:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4826:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4827:          ///// XXXX CHECK INDICES!!!!!
 4828:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4829:       } // 2D/3D
 4830: 
 4831:    }
 4832: } // extern "C"
 4833: 
 4834: 
 4835: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4836: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4837: 
 4838:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4839: 
 4840:    const int kb  = elem->kb;
 4841:    const int kb2 = elem2->kb;
 4842: 
 4843:    // z-coordinate of prism of elem
 4844:    const double zp = elem->z_prism(k);
 4845: 
 4846:    double rho = 0.0;
 4847: 
 4848:    if (elem2->is2D()) {
 4849:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4850: 
 4851:    } else {  // 3D
 4852: 
 4853:       // eta_min may be < zmax
 4854:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4855:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4856: 
 4857:       // (Extrapolate density below bottom, we will fix it later)
 4858:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4859:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4860:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4861:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4862:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4863:    } // 2D/3D
 4864:      
 4865: 
 4866:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4867:    // Now we need to fix it.
 4868:    if (elem->z[k] < elem2->z[kb2]) {
 4869:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4870: 
 4871:       // There are two methods to adjust the density at the bottom of the element.
 4872:       // iunder_deep=0: 
 4873:       const double depth1 = abs(elem->z[kb]); // larger depth
 4874: 
 4875:       if (iunder_deep==0) {
 4876: 
 4877:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4878: 
 4879:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4880: 
 4881:       } else { // iunder_deep != 0
 4882: 
 4883:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4884: 
 4885:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4886: 
 4887:          //   Demeaned density at the same z coordinate as
 4888:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4889:          }
 4890: 
 4891:       } // if iunder_deep
 4892:    } // if elem->z[kb] < elem2->z[kb]
 4893: 
 4894:    return rho;
 4895: }
 4896: 
 4897: 
 4898: extern "C" {
 4899:    __global__ void computeDensityGradient(void) {
 4900: 
 4901:       if constexpr(ibc != 0) return;
 4902: 
 4903:          // Compute the horizontal density gradient at each element.
 4904:       // It works in two steps:
 4905:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4906:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4907:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4908:       //             gradRho.r1 = rho1 - rho0
 4909:       //             gradRho.r2 = rho2 - rho0
 4910:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4911:       // 
 4912:       //  NOTE: We use de-meaned densities.
 4913: 
 4914:       ELEM(elem);
 4915: 
 4916:       if (elem->isDry) return;
 4917: 
 4918:       const int kb  = elem->kb;
 4919:       const int i34 = elem->i34;
 4920: 
 4921:       for (int k = kb + 1; k < nvrt; k++) {
 4922:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4923:          //             gradRho.r1 = rho1 - rho0
 4924:          //             gradRho.r2 = rho2 - rho0
 4925:          int icount = 0;
 4926:          double sumRx = 0.0;
 4927:          double sumRy = 0.0;
 4928:          for (int j1=0; j1<i34; j1++) { 
 4929: 
 4930:             const int j2 = elem->nxq(j1 + 1);
 4931: 
 4932:             // Pairs of consecutive neighbor elements of elem
 4933:             const Element *e1 = elem->nghbElems[j1];
 4934:             const Element *e2 = elem->nghbElems[j2];
 4935: 
 4936:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4937:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4938:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4939: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 4940: 
 4941:             // Compute the density difference and the vector from elem to e1 and e2
 4942:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4943:             double diffRho1, diffRho2;
 4944:             Vector2 vec1, vec2;
 4945:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4946:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4947: 
 4948:             const double rl1 = length(vec1);
 4949:             const double rl2 = length(vec2);
 4950:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4951: 
 4952:             const double delta = cross(vec1, vec2);
 4953:             const double sintheta = abs(delta)/(rl1*rl2);
 4954: 
 4955:             // To avoid problems, avoid elements with small angle between vectors
 4956:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4957:             const bool validEq = (sintheta > sin_one_deg);
 4958: 
 4959:             if (validEq) {
 4960:                // Solve the system of equations to get the density gradient at elem
 4961:                icount++;
 4962:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4963:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4964:                sumRx += Rx;
 4965:                sumRy += Ry;
 4966:             }
 4967:          } // for j1
 4968: 
 4969:          // Compute the average density gradient at elem
 4970:          if (icount==0) {
 4971:            // Bad mesh quality; bail out with 0 b-cc
 4972:            elem->gradRho[k] = {0.0, 0.0};
 4973:          } else {
 4974:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4975:          }
 4976: 
 4977:       } // for k
 4978: 
 4979:    }
 4980: 
 4981:    __global__ void computeBaroclinicTerm(void) {
 4982:    // Computes the baroclinic term at sides (at half levels).
 4983:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4984:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4985: 
 4986:       if (ibc == 1) return;
 4987: 
 4988:       SIDE(side);
 4989: 
 4990:       if (side->isDry) return;
 4991: 
 4992:       const Element *e1 = side->elems[0];
 4993:       const Element *e2 = side->elems[1];      
 4994:       const int kb = side->kb;
 4995:       
 4996:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 4997: 
 4998:       // interpolates vertically the density gradient of the two elements at the half level/
 4999: 
 5000:       int k1 = max(kb, nvrt / 2);
 5001:       int k2 = max(kb, nvrt / 2);
 5002: 
 5003:       // Starts the integration at the surface and goes down to the bottom
 5004:       side->bcc[nvrt-1] = {0.0, 0.0};
 5005:       for (int k = nvrt - 2; k >= kb; k--) {
 5006:       // For each prism level (from surface to bottom)...
 5007: 
 5008:          // For both elements, interpolate density gradient at the side's half level.
 5009:          // The gradient at the side is the average of the gradients at the elements.
 5010:          // w1, w2 are used to take into account boundary sides, with just one element.
 5011:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5012:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5013:          const double wsum = w1 + w2;
 5014:          w1 = w1/wsum;
 5015:          w2 = w2/wsum;
 5016:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5017: 
 5018:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5019:          Vector2 gradRho = {0.0, 0.0};
 5020:          if (e1 != nullptr && k > kb) {
 5021:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5022:             
 5023:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5024:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5025:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5026: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5027:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5028:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5029:          }      
 5030:          if (e2 != nullptr && k > kb) {
 5031:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5032:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5033:             
 5034:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5035:          }
 5036: 
 5037:          if constexpr(ics==2) {
 5038:             assert(false && "Not implemented: ics == 2");
 5039:             // IMPLEMENT THIS XXXXXX
 5040:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5041:             // swild(1)=tmp1
 5042:             // swild(2)=tmp2
 5043:          }
 5044:          
 5045:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5046:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5047:          // CHECK INDICES!!! XXX
 5048:          const double grav3 = side->grav3();
 5049:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5050: 
 5051:       } // for
 5052: 
 5053:    }
 5054: 
 5055: 
 5056: 
 5057:    __global__ void computeHorGradientAtSide(void) {
 5058: 
 5059:       // Compute the horizontal density gradient at each element.
 5060:       // It works in two steps:
 5061:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5062:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5063:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5064:       //             gradRho.r1 = rho1 - rho0
 5065:       //             gradRho.r2 = rho2 - rho0
 5066:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5067:       // 
 5068:       //  NOTE: We use de-meaned densities.
 5069: 
 5070:       SIDE(side);
 5071: 
 5072: // printf("side->isDry: %d\n", side->isDry);
 5073:       if (side->isDry) return;
 5074: 
 5075:       // Computes the gradient of the variables at the side center.
 5076:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5077:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5078:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5079: 
 5080:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5081:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5082:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5083:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5084: 
 5085: 
 5086:    }
 5087: 
 5088: 
 5089:    __global__ void solveMomentumEquations(double time) {
 5090: 
 5091:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5092:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5093: 
 5094:       SIDE(side);
 5095: 
 5096:       if (side->isDry) 
 5097:       {
 5098:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5099: 
 5100:          return;
 5101:       }
 5102: 
 5103:       const Node *n1 = side->n1;
 5104:       const Node *n2 = side->n2;
 5105: 
 5106:       const int kb = side->kb;
 5107: 
 5108:       const double veg_h = side->veg_h();
 5109:       const double grav3 = side->grav3();
 5110: 
 5111:       if (side->is2D()) {
 5112:          // Warning: Do not use htot2, which is updated.
 5113:          const double htot = side->htot1();
 5114:          const double hhat = side->hhat;
 5115: 
 5116:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5117: 
 5118:          Vector2 tau2 = {0.0, 0.0};
 5119:           
 5120:          if constexpr(ics==1) {
 5121:             tau2 = side->tau();
 5122: 
 5123:          } else {
 5124:             assert(false && "Not implemented: ics == 2");
 5125:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5126:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5127:             // taux2=(vn1+tt1)*0.5d0
 5128:             // tauy2=(vn2+ss1)*0.5d0
 5129:          } // if ics         
 5130: 
 5131:          // hat_gam has units of m/s
 5132: 
 5133:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5134: 
 5135:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5136:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5137: 
 5138:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5139: 
 5140: if (abs(hat_gam.x*hhat/htot) > rmaxvelx) printf("hat_gam.x*hhat/htot = %.16f, hat_gam.x = %.16f, hhat = %.16f, htot = %.16f\n", hat_gam.x*hhat/htot, hat_gam.x, hhat, htot);
 5141:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5142:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5143: 
 5144:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5145: 
 5146: 
 5147:       }
 5148:       else { // 3D
 5149: 
 5150:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5151:          // 
 5152:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5153:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5154:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5155:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5156:          // k+1 and k.
 5157: 
 5158: 
 5159:    
 5160: 
 5161: 
 5162:          const int ndim = nvrt - kb;
 5163:          const double zTopCanopy = side->zTopCanopy();
 5164: 
 5165:          // Initialize the tridiagonal system
 5166:          for (int k = kb + 1; k < nvrt; k++) {
 5167:             
 5168:             const int kin = k - (kb + 1);
 5169: 
 5170:             // Vertical viscosity at the face center
 5171:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5172:            
 5173: 
 5174:             alow[kin] = 0.0;
 5175:             cupp[kin] = 0.0;
 5176:             bdia[kin] = 0.0;
 5177: 
 5178:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5179:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5180: 
 5181:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5182:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5183:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5184: 
 5185:             // First part: layers k, k+1
 5186:             if (k < nvrt - 1) {
 5187:                              
 5188:                if constexpr(iveg != 0) {
 5189: 
 5190:                   // If there is vegetation at this level...
 5191:                   if (zTopCanopy > side->zc[k]) {
 5192:                      // If the canopy is above the k layer...
 5193:                      
 5194:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5195:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5196:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5197:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5198: 
 5199:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5200:                      const double vmag2 = length(ut2);
 5201:                      const double vmag1 = length(side->u2[k]);
 5202:                      const double vmag = 0.5*(vmag1 + vmag2);
 5203:                      
 5204:                      // Computes the vegetation alpha at the face center
 5205:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5206: 
 5207:                      cff1 += veg_alpha_sd*dt*vmag;
 5208: 
 5209:                   } // if (zTopCanopy
 5210:                } // if iveg
 5211: 
 5212:                const double dzz = side->Dz(k + 1);
 5213:                const double tmp = dt*dfz/dzz;
 5214:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5215: 
 5216:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5217:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5218:             }
 5219: 
 5220: 
 5221:             // Second part: layers k-1, k
 5222:             if (k > kb + 1) {
 5223: 
 5224:                double cff1 = 1.0; //init \bar{c^k}
 5225: 
 5226:                if constexpr(iveg != 0) {
 5227:                   // If there is vegetation at this level...
 5228:                   if (zTopCanopy > side->zc[k-1]) {
 5229:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5230:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5231: 
 5232:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5233: 
 5234:                      const double vmag2 = length(ut2);
 5235:                      const double vmag1 = length(side->u2[k-1]);
 5236:                      const double vmag = 0.5*(vmag1 + vmag2);
 5237: 
 5238:                      // Computes the vegetation alpha at the face center
 5239:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5240:                      cff1 += veg_alpha_sd*dt*vmag;
 5241:                   } // if zTopCanopy
 5242: 
 5243:                } // if iveg
 5244: 
 5245:                const double dzz = side->Dz(k);
 5246:                const double tmp = dt*dfz/dzz;
 5247:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5248: 
 5249:                alow[kin] += cff1*dzz/6.0 - tmp;
 5250:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5251: 
 5252:             } else { // Bottom boundary
 5253:                // This occurs at the bottom, where the bottom drag is applied.
 5254: 
 5255:                bdia[kin] += dt*side->chi2; // XXXX
 5256: 
 5257: 
 5258:             } // if (k > kb + 1)
 5259: 
 5260: 
 5261: 
 5262:          } // for (int k
 5263: 
 5264: 
 5265: 
 5266:          // Computes the RHS.
 5267:          // -----------------
 5268: 
 5269:          //	BC to be imposed at the end.
 5270: 
 5271:          const Vector2 gradETP  = side->gradETP;
 5272:          const Vector2 gradPr   = side->gradPr;
 5273:          const Vector2 gradEta1 = side->gradEta1;
 5274:          const Vector2 gradEta2 = side->gradEta2;
 5275: 
 5276:          const Vector2 *btu = side->btu;
 5277:          const Vector2 *u2  = side->u2;
 5278:          const double coriolis = side->coriolis;
 5279:          const Vector2 *nuGradU = side->nuGradU;
 5280: 
 5281: 
 5282:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5283: 
 5284:          for (int k = kb + 1; k < nvrt; k++) {
 5285:             const int kin = k - kb - 1;
 5286: 
 5287:             const double dz_0 = side->Dz(k);
 5288:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5289: 
 5290:             rrhs[kin] = {0.0, 0.0};
 5291:             double dz = 0.0;
 5292: 
 5293:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5294:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5295:             if (k < nvrt  ) dz += dz_1;
 5296:             if (k > kb + 1) dz += dz_0;
 5297: 
 5298:             // Elevation gradient, atmospheric pressure and tidal potential
 5299:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5300: 
 5301:             // Coriolis, advection, wind stress, and horizontal viscosity
 5302:             if (k < nvrt - 1) {
 5303: 
 5304: 
 5305:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5306:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5307:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5308:                                                 
 5309: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5310:                //diff stress tensors 1006
 5311:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5312:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5313:                   assert(false && "Not implemented: itur == 5");
 5314:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5315:                }
 5316: 
 5317:             } else { // k == nvrt - 1 SURFACE
 5318:                Vector2 tau2 = {0.0, 0.0};
 5319:                if constexpr(ics==1) {
 5320:                   tau2 = side->tau();
 5321:       
 5322:                } else {
 5323:                   assert(false && "Not implemented: ics == 2");
 5324:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5325:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5326:                   // taux2=(vn1+tt1)*0.5d0
 5327:                   // tauy2=(vn2+ss1)*0.5d0
 5328:                } // if ics
 5329: 
 5330:                rrhs[kin] += dt*tau2;
 5331: 
 5332:             } // if k<nvrt
 5333: 
 5334:             if (k > kb + 1) {
 5335:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5336:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5337:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5338: 
 5339:                // diff stress tensors 1006
 5340:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5341:                   assert(false && "Not implemented: itur == 5");
 5342:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5343:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5344:                }
 5345: 
 5346:             } // if k>kbs + 1
 5347: 
 5348:             // Baroclinic
 5349:             Vector2 *bcc = side->bcc;
 5350:             if constexpr(ibc == 0) {
 5351:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5352:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5353: 
 5354:             } // if ibc==0
 5355: 
 5356:          } // k=kb + 1,nvrt
 5357: 
 5358: 
 5359: 
 5360:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5361: 
 5362:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5363:             const int kin = k - kb - 1;
 5364: 
 5365:             // Velocity is always clamped to maximum values
 5366:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5367:          } // k
 5368: 
 5369:       } // if side->is2D()
 5370:       
 5371: 
 5372:       // Impose velocity boundary condition at the bottom
 5373:       if constexpr(imm == 2) { // 3D bed deformation model
 5374:          double dep;
 5375:          Vector2 vel;
 5376: 
 5377:          assert(false && "Not implemented: imm == 2");
 5378:          //update_bdef(time, x0, y0, dep, vel);
 5379:          // side->u2[kb] = vel;
 5380: 
 5381:       } else { // imm = 0 or 1
 5382:          if (side->Cd() == 0.0) {
 5383:             side->u2[kb] = side->u2[kb + 1];
 5384: 
 5385:          } else if (side->is3D()) { // 3D no slip bottom   
 5386:             side->u2[kb] = {0.0, 0.0};
 5387:          }
 5388:           
 5389:       } // if imm
 5390: 
 5391:       // The velocities below the bottom level are set to zero
 5392:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5393: 
 5394: 
 5395:    }
 5396: 
 5397: 
 5398:    __global__ void applyMomentumBC(void) {
 5399: 
 5400:       SIDE_BND(sideBnd);
 5401: 
 5402:       Side *side = sideBnd->side;
 5403:       const BoundarySegment *segment = sideBnd->segment;
 5404:       const Node *n1 = side->n1;
 5405:       const Node *n2 = side->n2;
 5406: 
 5407:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5408: 
 5409:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5410:       const bool isLand = segment->isLand;
 5411:       const int ifltype = segment->ifltype;
 5412: 
 5413:       const int kb = side->kb;
 5414: 
 5415:       if (!isLand && ifltype != 0) {
 5416:          const Vector2 *ubc = sideBnd->ubc;
 5417:   
 5418:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5419:             
 5420:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5421:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5422: 
 5423:             if (ifltype == -1) {
 5424:                // Flather 1
 5425: 
 5426:                const double depth = side->depth();
 5427: 
 5428:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5429: 
 5430:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5431: 
 5432:                side->u2[k] = vnorm*side->n;
 5433: 
 5434:             } else if (ifltype == -2) { // Discharge
 5435: 
 5436:                const double eta1 = side->eta1();
 5437:                const double eta2 = side->eta2();
 5438:                const double htot = side->htot2();
 5439: 
 5440:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5441:                assert(false && "Not implemented: Discharge bc");
 5442:                // const double dischrg = discharge(eta1);
 5443:                const double dischrg = 0.0; // XXX REMOVE
 5444:                
 5445: 
 5446:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5447: 
 5448:                const double vnorm = dischrg*eta2/htot;
 5449: 
 5450:                side->u2[k] = vnorm*side->n;
 5451: 
 5452:             }
 5453:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5454:                const double vnorm = dot(side->u2[k], side->n);
 5455: 
 5456:                double rat;
 5457:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5458:                else              rat = segment->vobc2; // outgoing
 5459: 
 5460:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5461: 
 5462:             }
 5463:             else { // not Flather or 3D radiation
 5464:                side->u2[k] = ubc[k];
 5465: 
 5466:             } // if (segment->ifltype...
 5467: 
 5468:          }
 5469: 
 5470:       }
 5471:       else if (isLand) { // if it is land boundary side
 5472: 
 5473:          if constexpr(islip == 0) { // free slip
 5474: 
 5475:             for (int k = kb; k < nvrt; k++) {
 5476: 
 5477:                const Vector2 t = side->t();
 5478:                const Vector2 n = side->n;
 5479: 
 5480:                double vnorm = 0.0; // for most cases
 5481:                const double vtan = dot(side->u2[k], t);
 5482:                
 5483:                side->u2[k] = vtan*t - vnorm*n;
 5484: 
 5485:             }
 5486: 
 5487:          } else { // no slip
 5488:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5489: 
 5490:          }
 5491:       } // if (side segment type...
 5492: 
 5493:    
 5494: 
 5495:    }
 5496: 
 5497: 
 5498:    __global__ void shapiroFilter1(void) {
 5499:       // First step of the Shapiro filter (normally used if indvel<=0)
 5500:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5501: 
 5502:       SIDE(side);
 5503: 
 5504:       // Only internal wet sides are processed
 5505:       if (side->isDry || !(side->isInternal())) return;
 5506: 
 5507:       const int kb = side->kb;
 5508: 
 5509:       for (int mm = 0; mm < niter_shap; mm++) {
 5510: 
 5511:          for (int k = kb + 1; k < nvrt; k++) {
 5512:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5513:             Vector2 suru = {0.0, 0.0};
 5514: 
 5515:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5516: 
 5517:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5518: 
 5519:                int kin = k;
 5520:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5521:                
 5522:                if constexpr(ics==1) {
 5523:                   suru += nSide->u2[kin];
 5524: 
 5525:                } else {
 5526:                   assert(false && "Not implemented: ics == 2");
 5527:                   // Vector2 vn1, vn2;
 5528:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5529:                   // suru=suru+vn1;
 5530:                   // surv=surv+vn2;
 5531:                }
 5532:             }
 5533: 
 5534: 
 5535:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5536: 
 5537:          }
 5538:       }
 5539:    }
 5540: 
 5541:    __global__ void shapiroFilter2(void) {
 5542:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5543: 
 5544:       SIDE(side);
 5545: 
 5546:       if (side->isDry || !(side->isInternal())) return;
 5547: 
 5548:       const int kb = side->kb;
 5549: 
 5550:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5551: 
 5552:       if (side->is2D()) {
 5553:          side->u2[kb + 1] = side->bcc[kb + 1];
 5554:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5555: 
 5556:       } else {
 5557:          // 3D
 5558:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5559:          
 5560:       }
 5561: 
 5562:    }
 5563: 
 5564: 
 5565:    __global__ void ul0UpdateZCoords(void) {
 5566:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5567:       
 5568:       NODE(node);      
 5569: 
 5570: 
 5571:       if (node->isDry2()) { 
 5572: printf("NODE i = %d, depth = %f, h_s = %f, h0 = %f, htot2 = %f\n", node->idx, node->depth, mesh->h_s, h0, node->htot2());      
 5573:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5574: 
 5575:          if constexpr(ivcor != 1) node->kb = 0;
 5576: 
 5577:       } else {
 5578: 
 5579:          node->updateKb();
 5580:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5581: 
 5582:       }
 5583: 
 5584:       // We use the temp.b field to store the previous state of isDry.
 5585:       node->tmp.b = node->isDry;
 5586: 
 5587:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5588:       node->isDry = true;
 5589: 
 5590:    }
 5591: 
 5592:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5593:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5594:    {
 5595:       ELEM(elem);
 5596: 
 5597:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5598: 
 5599:       // All the nodes of a wet element are wet.
 5600:       if (!elem->isDry) {
 5601:          elem->nodes[0]->isDry = false;
 5602:          elem->nodes[1]->isDry = false;
 5603:          elem->nodes[2]->isDry = false;
 5604:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5605: 
 5606:       }
 5607: 
 5608: 
 5609:       elem->kb = 0;
 5610: 
 5611:       if (elem->isDry) return;
 5612: 
 5613:       // Wet
 5614:       const Node *n1 = elem->nodes[0];
 5615:       const Node *n2 = elem->nodes[1];
 5616:       const Node *n3 = elem->nodes[2];  
 5617:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5618: 
 5619:    //    if(elem->isDry2()) {
 5620:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5621:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5622:    //        call parallel_abort(errmsg)
 5623:    //    }
 5624: 
 5625: 
 5626:       // Computes element's kb as the minimum of the nodes' kb.
 5627:       const int kb1 = n1->kb;
 5628:       const int kb2 = n2->kb;
 5629:       const int kb3 = n3->kb;
 5630:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5631: 
 5632: 
 5633:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5634: 
 5635: 
 5636:       // Computes the element z as the mean of the nodes z.
 5637:       for (int k = elem->kb; k < nvrt; k++) {
 5638: 
 5639:          // Compute the element z as the mean of the nodes z.
 5640:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5641:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5642:          elem->z[k] /= elem->i34;
 5643: 
 5644:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5645:       }
 5646:                   
 5647:    }
 5648: 
 5649:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5650:    {
 5651:       NODE(node);
 5652:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5653: 
 5654:       if (it == iths) return;
 5655: 
 5656: 
 5657:       if(!node->isDry && node->tmp.b) { // rewetted
 5658:          for (int k=0; k < nvrt; k++) {
 5659: 
 5660:             Vector3 utmp={0.0, 0.0, 0.0};
 5661: 
 5662:             double ttmp=0.0;
 5663:             double stmp=0.0;
 5664:             int icount=0;
 5665:             for (int j = 0; j < node->numNodes; j++) {
 5666: 
 5667: 
 5668:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5669:                if (!node->isDry) { // all indices extended
 5670:                   icount++;
 5671: 
 5672:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5673:                   utmp += node->u2[k];
 5674:                   
 5675:                   ttmp += node->tracers[k].tracer[0]; 
 5676:                   stmp += node->tracers[k].tracer[1]; 
 5677:                }
 5678:             }
 5679: 
 5680:             if(icount > 0) {
 5681:                const double inv_icount = 1.0/icount;
 5682:                node->u2[k]     = inv_icount*utmp;
 5683:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5684:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5685:             }
 5686:          }
 5687:       }
 5688:    }
 5689: 
 5690: 
 5691:    __global__ void ul0UpdateSides(int it, int iths) {
 5692: 
 5693:       SIDE(side);
 5694: 
 5695:       // A side is wet if and only if at least one of its elements is wet.
 5696:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5697: 
 5698:       const Node *n1 = side->n1;
 5699:       const Node *n2 = side->n2;
 5700:       const int kb1 = n1->kb;
 5701:       const int kb2 = n2->kb;
 5702: 
 5703:       side->kb = 0; // dry
 5704: 
 5705:       if (isWet) {
 5706: 
 5707:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5708: 
 5709:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5710: 
 5711:          side->kb = min(kb1, kb2);
 5712: 
 5713:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5714: 
 5715:          for (int k = side->kb; k < nvrt; k++) {
 5716:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5717: 
 5718:          
 5719:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5720: 
 5721:             // Compute velocity for re-wetted sides 
 5722:             if ((it != iths) && (side->isDry && isWet)) {
 5723:             
 5724:                Vector2 utmp={0.0, 0.0};
 5725: 
 5726:                int icount=0;
 5727: 
 5728:                // For all the sides on the two elements that share this side
 5729:                for (int j=0; j < 2; j++) {
 5730:                   const Element *elem = side->elems[j];
 5731:                   if (elem == nullptr) continue;
 5732: 
 5733:                   for (int jj=0; jj < elem->i34; jj++) {
 5734:                      const Side *nSide = elem->sides[jj];
 5735:                      if (nSide->isDry) continue;
 5736: 
 5737:                      icount++;
 5738:                      utmp += nSide->u2[k];                     
 5739:                   }
 5740:                }
 5741:                   
 5742:                assert(icount > 0 && "No wet sides around this side");
 5743:                if (icount > 0)  side->u2[k] = utmp/icount;
 5744:                   
 5745:             } // if ((it != iths) && (side->isDry && isWet))
 5746: 
 5747:          } // for k
 5748: 
 5749:       } // if isWet
 5750:    
 5751:       side->isDry = !isWet;
 5752: 
 5753:    }
 5754: 
 5755: 
 5756:    __global__ void zeroNodalVelocities(void) {
 5757:       NODE(node);
 5758: 
 5759:       for (int k = 0; k < nvrt; k++) {
 5760:          node->u2[k]   = {0.0, 0.0, 0.0};
 5761:          node->utmp[k] = {0.0, 0.0};
 5762:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5763:       }
 5764:    }
 5765: 
 5766:  
 5767: 
 5768:    __global__ void computeNodalVerticalVelocities1(void) {
 5769:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5770:    // Adds the element's vertical velocity times the element's area.
 5771:       ELEM(elem);
 5772: 
 5773:       for (int j = 0; j < elem->i34; j++) {
 5774:          Node *node = elem->nodes[j];
 5775: 
 5776:          for (int k = node->kb; k < nvrt; k++) {
 5777:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5778:          }
 5779:          atomicAdd(&(node->tmp.d), elem->area);
 5780:       }
 5781:    }
 5782: 
 5783:    __global__ void computeNodalVerticalVelocities2(void) {
 5784:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5785:    // Divides by the total area of the elements sharing the    node.
 5786:       NODE(node);
 5787: 
 5788:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5789:    }
 5790: 
 5791: 
 5792:    __global__ void computeNodalHorizontalVelocities1(void) {
 5793:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5794:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5795: 
 5796:       ELEM(elem);
 5797: 
 5798:       const int kb = elem->kb;
 5799:       const bool isTri = elem->isTri();
 5800: 
 5801:       if constexpr(indvel <= 0) {
 5802:          // Assuming discontinoius hvel.
 5803: 
 5804: 
 5805:          if (isTri) { // For triangles
 5806:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5807:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5808: 
 5809:             for (int j = 0; j < 3; j++) {
 5810:                // For every node of the triangle...
 5811:                Node *node = elem->nodes[j];
 5812: 
 5813:                const Side *s1 = elem->sides[j];
 5814:                const Side *s2 = elem->sides[(j + 1) % 3];
 5815:                const Side *s3 = elem->sides[(j + 2) % 3];
 5816: 
 5817:                const int numElements = node->numElements;
 5818:                const double inv_numElements = 1.0/numElements;
 5819: 
 5820:                for (int k = kb; k < nvrt; k++)  {
 5821:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 5822:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5823:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5824:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5825:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 5826:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 5827: 
 5828:                }
 5829: 
 5830:             }
 5831:          }
 5832:          else { // For quads
 5833:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 5834: 
 5835:          }
 5836: 
 5837:       }
 5838:       
 5839:    }
 5840: 
 5841: 
 5842:    __global__ void computeNodalHorizontalVelocities2(void) {
 5843:       NODE(node);
 5844: 
 5845:       for (int k = 0; k < nvrt; k++) {
 5846:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5847:       }
 5848:       
 5849:    }   
 5850: 
 5851:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5852:    // XXXX I'm not sure where I got this function from. 
 5853:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5854:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5855:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5856:    // It uses the utmp array as a temporary array to store the velocities.
 5857: 
 5858:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5859: 
 5860:       SIDE(side);
 5861: 
 5862:       const int kb = side->kb;
 5863: 
 5864:       Node *n1 = side->n1;
 5865:       Node *n2 = side->n2;
 5866: 
 5867:       for (int k = kb; k < nvrt; k++) {
 5868: 
 5869:          // Cast the u2 vector into a Vector2 
 5870:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5871:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5872: 
 5873:          n1_u2 = side->u2[k]/n1->numSides;
 5874:          n2_u2 = side->u2[k]/n2->numSides;
 5875: 
 5876:       }
 5877: 
 5878: 
 5879:    }
 5880: 
 5881:    __global__ void resetVelocityOpenBndNodes(void) {
 5882:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5883: 
 5884:       NODE_BND(nodebnd);
 5885: 
 5886:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5887:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5888:       }
 5889: 
 5890:    }
 5891: 
 5892: 
 5893:    __global__ void setVelocityOpenBndNodes(void) {
 5894:    // For open boundary nodes sets their velocity to the imposed values.
 5895: 
 5896:       SIDE_BND(sidebnd);
 5897: 
 5898:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5899:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5900:          // to its segment to the average of the side velocity.
 5901: 
 5902:          for (int k = 0; k < nvrt; k++) {
 5903:             Node *n1 = sidebnd->side->n1;
 5904:             Node *n2 = sidebnd->side->n2;
 5905: 
 5906:             // Cast the u2 vector into a Vector2 
 5907:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5908:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5909: 
 5910:             if (n1->nodeBnd->segment == sidebnd->segment) {
 5911:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 5912:             }
 5913:             if (n2->nodeBnd->segment == sidebnd->segment) {
 5914:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 5915:             }
 5916: 
 5917:          }
 5918:       }
 5919: 
 5920:    }
 5921: 
 5922: 
 5923:    __global__ void computeVerticalVelocity(void) {
 5924:       // Computes the vertical velocity at the (2D) element's centroid.
 5925:       // In this function we will be considering volumetric elements, with side faces and a 
 5926:       // bottom and a top face. We will call them SFs, BF and TF.
 5927:       // It computes the flux coming from BF and the SFs.
 5928:       // If the bed is moving, it takes that into account.
 5929:       // Since water is incompressible, the integral of the velocity times the normal vector
 5930:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5931:       // and the BF is equal to the flux going out from the TF.
 5932:       // TF = - BF - sum(SFs).
 5933:       // It then computes the horizontal velocity at the center of TF.
 5934:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5935:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5936:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5937: 
 5938:       ELEM(elem);
 5939: 
 5940:       if (elem->isDry) return;
 5941: 
 5942:       const int kb = elem->kb;
 5943:       const bool isTri = elem->isTri();
 5944: 
 5945:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5946: 
 5947:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5948:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5949:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5950: 
 5951:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5952: 
 5953:       double area3D;
 5954: 
 5955:       // Bottom face flux
 5956:       double bottomFlux = 0.0;
 5957:       Vector2 u2meanBottom = {0.0, 0.0};
 5958:       const Vector2 gradh = elem->grad2(&Node::depth);
 5959:       if constexpr(imm==2) {
 5960:          Vector3 ubed;
 5961: 
 5962:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5963:          // updateBDEF(ubed);
 5964:      
 5965:          // const double bflux0 = dot(ubed, elem_n1);
 5966: 
 5967:          // elem->w[kb] += ubed.z;
 5968:       }
 5969:       else {
 5970:          Vector2 umean;
 5971:          if constexpr(ics == 1) {
 5972:             u2meanBottom = elem->mean(kb, &Side::u2);
 5973:          }
 5974:          else {
 5975:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5976:          }
 5977: 
 5978:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5979:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5980: 
 5981:          bottomFlux = - dot(gradh, u2meanBottom);
 5982:       } // if imm
 5983: 
 5984:       // Compute w for kb+1 to nvrt-1
 5985:       for (int l = kb; l < nvrt - 1; l++) {
 5986: 
 5987:          // normal vector to the top face of the "volumetric" element (3D)
 5988:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 5989: 
 5990:          // Compute the total flux at the sides
 5991:          double sideFlux = 0.0;
 5992:          Vector2 u2top = {0.0, 0.0};
 5993:          for (int j = 0; j < elem->i34; j++) {
 5994:             const Side *side = elem->sides[j];
 5995: 
 5996:             const double sideArea = side->area(l);
 5997:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5998:             const double sign = elem->ssign[j]; 
 5999: 
 6000:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6001:          }
 6002:          
 6003:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6004:          //velocities at the centers of the sides
 6005:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6006: 
 6007:          // The flx at the top ace can be computed from the other flows.
 6008:          const double topFlux = - sideFlux - bottomFlux;
 6009:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6010: 
 6011:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6012: 
 6013:          elem_n1 = elem_n2;
 6014: 
 6015:          bottomFlux = - topFlux;
 6016:       }
 6017:    }  
 6018: 
 6019: 
