 7396: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
 7397:    Side *sides = mesh->localSideData;
 7398: 
 7399:    *addr = sides;
 7400:    *sizeSide = sizeof(Side);
 7401:    switch (varCode) {
 7402:       case (int)VarCode::z:
 7403:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
 7404:          *sizeType = sizeof(double);
 7405:          break;
 7406:       // case (int)VarCode::depth:
 7407:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7408:       //    *sizeType = sizeof(double);
 7409:       //    break;         
 7410:       case (int)VarCode::x:
 7411:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7412:          *sizeType = sizeof(Vector2);
 7413:          break;
 7414:       case (int)VarCode::len:
 7415:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7416:          *sizeType = sizeof(double);
 7417:          break;
 7418:       case (int)VarCode::kb:
 7419:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7420:          *sizeType = sizeof(int);
 7421:          break;
 7422:       case (int)VarCode::isdry:
 7423:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7424:          *sizeType = sizeof(int);
 7425:          break;            
 7426:       case (int)VarCode::w:
 7427:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7428:          *sizeType = sizeof(double);
 7429:          break;
 7430:       case (int)VarCode::u:
 7431:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7432:          *sizeType = sizeof(Vector2);
 7433:          break;   
 7434:       case (int)VarCode::btu:
 7435:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7436:          *sizeType = sizeof(Vector2);
 7437:          break;          
 7438:       case (int)VarCode::U:
 7439:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7440:          *sizeType = sizeof(Vector2);
 7441:          break;
 7442:       // case (int)VarCode::ghat:
 7443:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7444:       //    *sizeType = sizeof(Vector2);
 7445:       //    break;   
 7446:       case (int)VarCode::hhat:
 7447:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7448:          *sizeType = sizeof(Vector2);
 7449:          break;      
 7450:       case (int)VarCode::chi:
 7451:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7452:          *sizeType = sizeof(double);
 7453:          break;
 7454:       case (int)VarCode::n1:
 7455:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7456:          *sizeType = sizeof(Node);
 7457:          break;
 7458:       case (int)VarCode::n2:
 7459:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7460:          *sizeType = sizeof(Node);
 7461:          break;                   
 7462:       default:
 7463:          *offset = -1;
 7464:    }
 7465: }
