 9085: __global__ void returnMatrix(double *res) {
 9086:    // Debugging: dense local matrix, row-major, size = mesh->np
 9087:    // Assumes single-partition / local indexing (see note below).
 9088: 
 9089:    const int size = mesh->np;
 9090: 
 9091:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9092:       const Node *node = mesh->localNodeData + idx_node;
 9093: 
 9094:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9095: 
 9096:       for (int j = 0; j < node->numNodes; j++) {
 9097:          const Node *nbNode = node->nodes[j];
 9098:          // Only dump neighbors that live on this partition
 9099:          if (nbNode->part != mesh->partNum) continue;
 9100: 
 9101:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9102:          const double aij = node->coeffRow[node->csrSlot[j]];
 9103:          if (aij != 0.0)
 9104:             res[jlocal * size + idx_node] = aij;
 9105:       }
 9106:    }
 9107: }
 9108: 
 9109: 
 9110: __global__ void returnX(double *res) {
 9111:    // Debugging: returns the matrix as a CuPy array
 9112: 
 9113:    const int size = mesh->np;
 9114:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9115:       const Node *node = mesh->localNodeData + idx_node;
 9116: 
 9117:       res[idx_node] = node->mX;
 9118: 
 9119:    }
 9120:    
 9121: }
