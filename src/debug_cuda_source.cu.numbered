 1617:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1618:       // Compute the different time ramps used in the code 
 1619:       // This function is performed by just one thread
 1620: 
 1621:       rampbc = 1.0;
 1622:       if constexpr(ibc == 0) {
 1623:          if (drampbc > 0.0) {
 1624:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1625:          } else {
 1626:             rampbc = 1.0;
 1627:          }
 1628:       }
 1629: 
 1630:       if (nws != 0) {
 1631:          if (drampwind > 0.0) {
 1632:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1633:          } else {
 1634:             rampwind = 1.0;
 1635:          }
 1636:       }
 1637: 
 1638:       if (drampwafo > 0.0) {
 1639:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1640:       } else {
 1641:          rampwafo = 1.0;
 1642:       }
 1643: 
 1644:       // For source/sinks
 1645:       if (if_source && dramp_ss > 0.0) {
 1646:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1647:       } else {
 1648:          ramp_ss = 1.0;
 1649:       }
 1650: 
 1651:       if (dramp > 0.0) {
 1652:          ramp = tanh(2.0*time/86400.0/dramp);
 1653:       } else {
 1654:          ramp = 1.0;
 1655:       }
 1656: 
 1657: 
 1658:    }
