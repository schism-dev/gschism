 7495:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7496:          *sizeType = sizeof(int);
 7497:          break;
 7498:       case (int)VarCode::isdry:
 7499:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7500:          *sizeType = sizeof(int);
 7501:          break;            
 7502:       // case (int)VarCode::w:
 7503:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7504:       //    *sizeType = sizeof(double);
 7505:       //    break;
 7506:       case (int)VarCode::u:
 7507:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7508:          *sizeType = sizeof(Vector2);
 7509:          break;   
 7510:       case (int)VarCode::btu:
 7511:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7512:          *sizeType = sizeof(Vector2);
 7513:          break;          
 7514:       case (int)VarCode::U:
 7515:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7516:          *sizeType = sizeof(Vector2);
 7517:          break;
 7518:       // case (int)VarCode::ghat:
 7519:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7520:       //    *sizeType = sizeof(Vector2);
 7521:       //    break;   
 7522:       case (int)VarCode::hhat:
 7523:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7524:          *sizeType = sizeof(Vector2);
 7525:          break;      
 7526:       case (int)VarCode::chi:
 7527:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7528:          *sizeType = sizeof(double);
 7529:          break;
 7530:       case (int)VarCode::n1:
 7531:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7532:          *sizeType = sizeof(Node);
 7533:          break;
 7534:       case (int)VarCode::n2:
 7535:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7536:          *sizeType = sizeof(Node);
 7537:          break;                   
 7538:       default:
 7539:          *offset = -1;
 7540:    }
 7541: }
