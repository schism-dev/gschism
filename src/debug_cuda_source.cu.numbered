 2380: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2381: // return;   
 2382:    // Lock the mutex
 2383:    lock(&debugPlotMutex);
 2384:  
 2385:    bool ok = true;
 2386:    if (debugPlotIdx == nullptr) ok = false;
 2387:    if (*debugPlotIdx >= 1000000) ok = false;
 2388:    if (ok) {
 2389:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2390:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2391:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2392:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2393:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2394:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2395:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2396:       (*debugPlotIdx)++;
 2397:    }
 2398: 
 2399:    __threadfence();               // ensure all above writes are visible
 2400:    // Unlock the mutex
 2401:    unlock(&debugPlotMutex);
 2402: 
 2403: }
