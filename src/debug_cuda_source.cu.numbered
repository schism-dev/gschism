 2114:    template<typename T>
 2115:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2116:       T values[4];
 2117:       getNodalValues(level, func, values);
 2118: 
 2119:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2120:       if constexpr (IsVector2<T>::value && ics == 2) {
 2121: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2122:          projectNodeVectorsToElementFrame(values);
 2123: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2124:       }
 2125: 
 2126:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2127:    }
 2128: 
 2129:    template<typename T>
 2130:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2131:       T values[4];
 2132:       getNodalValues(field, values);
 2133: 
 2134:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2135:       if constexpr (IsVector2<T>::value && ics == 2) {
 2136: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2137:          projectNodeVectorsToElementFrame(values);
 2138: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2139:       }
 2140:       
 2141:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2142:    }
