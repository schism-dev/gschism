 9142: 
 9143:    ELEM(elem);
 9144: 
 9145:    switch (varCode) {
 9146:       case (int)VarCode::outputCoords:
 9147:          const Point2 coords = elem->outputCoords();
 9148:          res[elem->idx*2    ] = coords.x;
 9149:          res[elem->idx*2 + 1] = coords.y;
 9150:          break;
 9151:    }
 9152: }
