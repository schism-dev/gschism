 3465: extern "C" {
 3466: 
 3467:    __global__ void scaleGravity(double loadtide_coef) {
 3468: 
 3469: 
 3470:       NODE(node);
 3471: 
 3472:       // SAL option: scale gravity
 3473:       if constexpr(iloadtide==2) {  // simple const
 3474:          node->grav2 = grav*(1.0 - loadtide_coef);
 3475: 
 3476:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3477:         
 3478:           const double depth = max(node->depth, 0.0);
 3479:           const double tmp1 = sqrt(depth);
 3480:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3481:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3482:                              2.6969e-13*depth*depth*depth*tmp1;
 3483:           
 3484:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3485:           
 3486: 
 3487: 
 3488:           node->grav2 = grav*(1.0 - beta_bar);
 3489: 
 3490:       } else {  // iloadtide=0,1
 3491:         node->grav2=grav;
 3492: 
 3493:       }
 3494: 
 3495:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3496:    }
