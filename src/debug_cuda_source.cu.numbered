 6424:    __global__ void resetBoundaryAreas(void) {
 6425:       // Reset boundary areas and lengths for each segment.
 6426: 
 6427:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6428:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6429:       SIDE_BND(sideBnd);
 6430: 
 6431:       BoundarySegment *segment = sideBnd->segment;
 6432: 
 6433:       segment->carea = 0.0;
 6434:       segment->clen = 0.0;
 6435:  
 6436:    }
 6437: 
 6438:    __global__ void computeBoundaryAreas(void) {
 6439:    // Calculation of cross-section areas and lengths for flow b.c.
 6440: 
 6441:       SIDE_BND(sideBnd);
 6442: 
 6443:       const Side *side = sideBnd->side;
 6444:       BoundarySegment *segment = sideBnd->segment;
 6445: 
 6446:       if (segment->ifltype != 0) {
 6447: 
 6448:          const Node *n1 = side->n1;
 6449:          const Node *n2 = side->n2;
 6450: 
 6451:          const double htot = side->htot2();
 6452: 
 6453:          if (!side->isDry) {
 6454:             atomicAdd(&segment->carea, htot*side->len);
 6455:             atomicAdd(&segment->clen, side->len);
 6456:          }
 6457:       }
 6458: 
 6459:    }
 6460: 
 6461: 
 6462:    __global__ void computeFlowBcVelocities(double time) {
 6463: 
 6464:       SIDE_BND(sideBnd);
 6465: 
 6466:       const Side *side = sideBnd->side;
 6467:  
 6468:       const bool isDry = side->isDry;
 6469:       const bool isLand = sideBnd->segment->isLand;
 6470: 
 6471:    
 6472:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6473: 
 6474:       if (isDry || isLand) return;
 6475: 
 6476:       // For wet sides in open boundaries...
 6477:       const Vector2 n = side->n;
 6478:       const BoundarySegment *segment = sideBnd->segment;
 6479: 
 6480:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6481: 
 6482:       const int ifltype = segment->ifltype;
 6483: 
 6484:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6485:       const Vector2 r_nuth0 = r_uth0*n;
 6486: 
 6487: 
 6488:       if (ifltype == 1 || ifltype == 2) {
 6489:       
 6490:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6491: 
 6492:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6493: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6494:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6495:          
 6496:       } else if (ifltype == -1) { // Flather 1
 6497: 
 6498:          for (int k = 0; k < nvrt; k++) {
 6499: 
 6500:             // uth is the normal vel.; no ramp up
 6501:             const double uth = sideBnd->nuth(k);
 6502:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6503: 
 6504:             sideBnd->ubc[k] += uth*n;
 6505:          }
 6506: 
 6507:       } else if (ifltype == 3 || ifltype == 5) {
 6508:          // vnth0=0 !normal vel.
 6509: 
 6510:          Vector2 r_u1_bar = {0.0, 0.0};
 6511:          // Computes the contribution to the velocity from all tide frequencies
 6512:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6513: 
 6514:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6515:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6516: 
 6517:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6518:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6519:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6520:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6521: 
 6522:          }
 6523: 
 6524: 
 6525:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6526: 
 6527:       } // if (ifltype = 3 || ifltype == 5
 6528: 
 6529: 
 6530: 
 6531:    }
 6532: 
 6533:    __global__ void computeElevationBoundaryConditions(double time) {
 6534:       // Compute elevation essential boundary conditions 
 6535: 
 6536:       NODE_BND(nodeBnd); // Each boundary node.
 6537: 
 6538:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6539: 
 6540:       const Node *node = nodeBnd->node;
 6541:       const BoundarySegment *segment = nodeBnd->segment;
 6542:       const int iettype = segment->iettype;
 6543:       
 6544: 
 6545:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6546:       double eic = 0.0;
 6547:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6548:       else                 eic = 0.0;
 6549: 
 6550:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6551:       const double r_eth = ramp*nodeBnd->eth;
 6552:       double r_eta1_bar = 0.0;
 6553: 
 6554:       // Compute tide elevation
 6555:       if (iettype == 3 || iettype == 5) {   
 6556: 
 6557:          if constexpr(iloadtide==1) { // loading tide
 6558:             assert(false && "Loading tide not implemented");
 6559:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6560:          }
 6561:          
 6562:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6563: 
 6564:             const double efa  = nodeBnd->efa[jfr]; 
 6565:             const double emo  = nodeBnd->emo[jfr]; 
 6566: 
 6567:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6568:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6569:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6570: 
 6571: 
 6572:          } // for jfr
 6573: 
 6574:       } // if iettype
 6575: 
 6576:       switch (iettype) {
 6577:          case 1:
 6578:          case 2:
 6579:          case 4:
 6580:             nodeBnd->elbc = r_eic + r_eth;
 6581:             break;
 6582:          case 3:
 6583:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6584:             break;
 6585:          case 5:
 6586:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6587:             break;
 6588:       } // switch
 6589: 
 6590: 
 6591:       //Add inverse barometric effects
 6592:       if (iettype != 0 && inv_atm_bnd == 1) {
 6593:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6594:       }
 6595: 
 6596:    }
 6597: 
 6598: 
 6599:    __global__ void computeHorizontalViscosity(void) { 
 6600: 
 6601:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6602: 
 6603:       SIDE(side);
 6604: 
 6605:       if (side->isDry) return;
 6606: 
 6607:       for (int k = 0; k < nvrt; k++) {
 6608:          side->nuGradU[k] = {0.0, 0.0};
 6609:       }
 6610: 
 6611:       if constexpr(ihorcon == 1) {
 6612:          for (int k = side->kb; k < nvrt - 1; k++) {
 6613:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6614:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6615:             // By Zhang and Baptista.
 6616: 
 6617:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6618:             // This is a standard discretization of the Laplacian operator.
 6619:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6620:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6621:             // Gamma is hvis_coef0 in the code.
 6622:             // The value of gamma needs to be < 0.5.
 6623: 
 6624:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6625:             // side under consideration in each of the two possible elements that share the side.
 6626:             Vector2 sumU = {0.0, 0.0};
 6627:             for (int l = 0; l < 2; l++) {
 6628:                const Element *elem = side->elems[l];
 6629: 
 6630:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6631: 
 6632:                // Find the local index of the side in the element
 6633:                const int idxSide = elem->sideLocalIdx(side);
 6634: 
 6635:                // Find the two sides that are connected to the side under consideration
 6636:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6637:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6638: 
 6639:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6640: 
 6641:             }
 6642: 
 6643:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6644: 
 6645:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6646:    
 6647:          }
 6648:       }
 6649:       else if constexpr(ihorcon == 2) {
 6650:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6651:       }
 6652: 
 6653: 
 6654:    }
 6655: 
 6656: 
 6657:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6658: 
 6659:       // Set essential boundary conditions 
 6660:       NODE(node); // Each boundary node
 6661:       NodeBoundary *nodeBnd = node->nodeBnd;
 6662:       
 6663:  
 6664:       // Check if this node has essential BC
 6665:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6666: 
 6667:          // Verify BC value is valid
 6668:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6669: 
 6670:        
 6671:          // Set diagonal to 1 and zero off-diagonals
 6672:          for (int j = 0; j <= node->numNodes; j++) {
 6673:                node->coeffRow[j] = 0.0;
 6674:          }
 6675: 
 6676:          *(node->coeffDiag) = 1.0;
 6677: 
 6678: 
 6679:          // Set solution and RHS to BC value
 6680:          node->mX  = nodeBnd->elbc;
 6681:          node->qel = nodeBnd->elbc;
 6682: 
 6683:       } else {
 6684:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6685: 
 6686:          for (int j = 0; j < node->numNodes; j++) {
 6687:                const Node* nbNode = node->nodes[j];
 6688:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6689: 
 6690:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6691: 
 6692:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6693:                   // Verify neighbor's BC value
 6694:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6695: 
 6696:                   // Subtract contribution to RHS
 6697:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6698:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6699:                }
 6700:          }
 6701: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6702:       }
 6703:    }
 6704: 
 6705: 
 6706:    __global__ void updateElevation(void) {
 6707:       NODE(node);
 6708: 
 6709: 
 6710:       node->eta2 = node->mX;
 6711: 
 6712:       node->updateZCoordData();
 6713:    }
 6714: 
 6715: 
 6716:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6717: 
 6718:       SIDE(side);
 6719: 
 6720:       side->U = {0.0, 0.0}; 
 6721:          
 6722:       if(side->isDry) return;
 6723: 
 6724:       // Vertically integrated velocity U
 6725:       #pragma unroll 1
 6726:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6727: 
 6728:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6729: 
 6730:          side->U += side->Dz(k + 1)*uc;  
 6731: 
 6732:       }
 6733:    }
 6734: 
 6735:    __global__ void computeBottomDragVegetation(void) {
 6736:       // UNFINISHED. CHECK THIS: XXXXX
 6737:       // How many kernels are needed? Why so many for loops?
 6738:       // Is the loop on sides needed?
 6739: 
 6740:       NODE(node);
 6741: 
 6742:       const int    kb      = node->kb;
 6743:       const double htot    = node->htot2(); 
 6744:       
 6745:       if (node->isDry) {
 6746:          // Default values for dry nodes
 6747:          node->veg_alpha_vert_mean = node->veg_alpha0;
 6748:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 6749: 
 6750:          return;
 6751:        
 6752:       }
 6753: 
 6754:       // Computes bottom drag Cd based on the selected nchi
 6755:       node->computeBottomDragCd();
 6756:       
 6757: 
 6758: 
 6759:       //   Bottom stress in m^2/s^2
 6760:       if (node->rho[kb + 1] >= -98.0)
 6761:       {
 6762:          const double mag_u = length(node->u2[kb + 1]);
 6763:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 6764: 
 6765:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 6766:          // !sediment erosion: this part needs more documentation
 6767:       }
 6768:     
 6769: 
 6770: 
 6771:       // Compute vegetation parameters
 6772:       //--------------------------------
 6773: 
 6774: 
 6775:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 6776:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 6777: 
 6778:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 6779:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 6780:          int kbin = 0; // bin index
 6781:          for (int k = kb; k < nvrt; k++) {
 6782:             // Computes node height above the bottom level
 6783:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 6784:             assert(false && "Vertical variation of vegetation not implemented");
 6785: 
 6786:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 6787:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 6788:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 6789:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 6790:             // } else {
 6791:             //    // Find the bin at which the current vertical level is
 6792:             //    while (kbin<nbins_veg_vert) {
 6793:             //       const double zn = node->z[kbin];
 6794:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 6795:             //          break;
 6796:             //       } // if
 6797:             //       kbin++;
 6798:             //    } // while
 6799:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 6800: 
 6801:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 6802:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 6803:                
 6804:             //    // Linear interpolation of the vegetation parameters
 6805:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 6806:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 6807:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 6808:             // } // if rl10
 6809: 
 6810:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 6811: 
 6812:          } // for k
 6813: 
 6814: 
 6815:       } else { // Ganthy (iveg==2)
 6816:       //  Modify canopy height, diameter, and density
 6817: 
 6818:          // Make sure there is vegetation on this node
 6819:          if (node->veg_h_unbent > 0.0) {
 6820:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 6821: 
 6822:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 6823:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 6824:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 6825: 
 6826:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 6827:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 6828:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 6829:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 6830:          } // if veg_h_unbent
 6831: 
 6832:          for (int k = 0; k < nvrt; k++) {
 6833:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 6834:          } // for k
 6835:       
 6836: 
 6837:       } // if iveg
 6838:      
 6839: 
 6840:       // Compute vertical mean of veg_alpha3D
 6841:       if (iveg != 0) {
 6842:          const double ztop = node->zTopCanopy(); // Top of the canopy
 6843:          double sum1=0.0;
 6844:          double sum2=0.0;
 6845:          // Integrate over each level under the canopy...
 6846:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 6847:             const double Dz = node->Dz(k);
 6848: 
 6849:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 6850:             sum2 += Dz;
 6851: 
 6852:          } // for k
 6853:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 6854:          else             node->veg_alpha_vert_mean = sum1/sum2;
 6855: 
 6856:       } // if iveg
 6857: 
 6858:    }
 6859: 
 6860: 
 6861:    __global__ void computeTurbulence(void) {
 6862: 
 6863:       NODE(node);
 6864: 
 6865:       // Calls the templated function to compute the turbulence model parameters.
 6866:       // turbulenceModel is just a class enum version of itur.
 6867:       computeTurbulenceModel<turbulenceModel>(node);
 6868:       
 6869:    }
 6870: 
 6871: 
 6872:    __global__ void computeVegetationAndDragParameters(void) {
 6873:       // Computes the vegetation and drag model parameters:
 6874:       // chi, \tilde\chi, beta, \breve{H}
 6875:       
 6876:       SIDE(side);
 6877: 
 6878:       side->hhat = 0.0;
 6879:       side->chi2 = 0.0;
 6880:       side->chi = 0.0;
 6881:       side->veg_c2 = 0.0;
 6882:       side->veg_beta = 0.0;
 6883: 
 6884:       if (side->isDry) return;
 6885: 
 6886:       const double htot = side->htot2();
 6887:       const int    kb   = side->kb;
 6888: 
 6889:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6890: 
 6891:       const double veg_h     = side->veg_h();
 6892:       const double veg_nv    = side->veg_nv();
 6893:       const double veg_c     = side->veg_c();
 6894:       const double veg_beta  = side->veg_beta;
 6895:       const double veg_alpha = side->veg_alpha_vert_mean();
 6896: 
 6897:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6898:       // Velocity magnitude at the bottom level
 6899:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6900:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6901:       side->chi2 = side->Cd()*vmag1;
 6902:       side->chi  = side->chi2;
 6903: 
 6904:       if constexpr(iveg != 0) {
 6905:          const Node *n1 = side->n1;
 6906:          const Node *n2 = side->n2;
 6907:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6908:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6909:       }
 6910: 
 6911:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6912: 
 6913:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6914:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6915:       double magUa = 0.0;
 6916:       if constexpr(iveg != 0) {
 6917:          if (side->is3D() && veg_h > 0.0) {
 6918:             // 3D wet side with veg...
 6919: 
 6920:             double magUa = 0.0;
 6921:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6922:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6923: 
 6924:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6925:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6926:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6927: 
 6928:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6929:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6930: 
 6931:                   // Velocity magnitude at the bottom (l) of the level
 6932:                   const double ul = length(side->u2[k]);
 6933: 
 6934:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6935:                   magUa += Dz*0.5*(uh + ul);
 6936: 
 6937:                } // if HasVegetation
 6938:             } // for k
 6939:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6940: 
 6941:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6942:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6943:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6944:                const double zCpy = side->zTopCanopy();
 6945:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6946:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6947:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6948:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6949:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6950:             } // if isSubmerged
 6951:          } // if is3D
 6952:       } // if iveg   
 6953: 
 6954:       // Computes the friction modified depth, \breve{H} in notes
 6955:       if (side->is2D()) { // 2D
 6956: 
 6957:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6958:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6959: 
 6960:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6961: 
 6962:          side->hhat = htot*htot/fricH; 
 6963: 
 6964:       } else { // 3D
 6965:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6966: 
 6967:          if constexpr(iveg != 0) {
 6968:             
 6969:             if (side->isSubmerged()) { 
 6970:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6971:                side->hhat -= veg_c*Hhat_alpha;
 6972: 
 6973:             } else { // Emergent
 6974:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6975:             }
 6976:          } // if iveg
 6977: 
 6978:          // Enforce positivity for 3D model
 6979:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6980:       } // if 3D
 6981: 
 6982:    }
 6983: 
 6984: 
 6985: 
 6986:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6987:    // Computes the density gradient between two elements, e1 and e2.
 6988:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6989:    // zero in the direction normal to the side. 
 6990:    // 
 6991:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6992:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6993:    //
 6994:    // Input:
 6995:    //    e1: Element
 6996:    //    e2: Neighbor element (or nullptr if boundary)
 6997:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6998:    //    k: Index of the half-level at which the density is interpolated
 6999:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 7000:    // 
 7001:    // Output:
 7002:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 7003:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 7004: 
 7005:       if (e2 == nullptr || e2->isDry) {
 7006:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 7007: 
 7008:          Side *side = e1->sides[j];
 7009:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 7010:                  
 7011:          if constexpr(ics == 1) {
 7012:             vec = side->n; // Normal vector to the side
 7013:          } else {
 7014:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 7015:             // IMPLEMENT THIS XXXXXX
 7016:             // !replace with xel, yel?
 7017:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 7018:             //      &eframe(:,:,i),xn1,yn1,tmp)
 7019:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 7020:             //      &eframe(:,:,i),xn2,yn2,tmp)
 7021:          } //ics
 7022:                    
 7023:          diffRho = 0.0;
 7024: 
 7025:       } else { //internal and wet
 7026:          if constexpr(ics==1) {
 7027:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 7028: 
 7029:             // Vector from e1 to e2
 7030:             vec = e2->center - e1->center;
 7031: 
 7032:          } else { 
 7033:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 7034:             // Remember that elem->center is in global coordinates
 7035:             // IMPLEMENT THIS XXXXXX
 7036:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 7037:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 7038:             //                   alow(j)=xctr2
 7039:             //                   bdia(j)=yctr2
 7040:          } // ics
 7041: 
 7042:          diffRho = rho2 - e1->demeanedDensity(k);
 7043:       }
 7044: 
 7045:    }
 7046: 
 7047:    __global__ void computeDensityCubicSplines(void) {
 7048:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 7049: 
 7050:       ELEM(elem);
 7051: 
 7052:       if (elem->isDry) return;
 7053: 
 7054:       const int kb = elem->kb;
 7055: 
 7056:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 7057:       if (elem->is2D()) {
 7058:          // In the 2D case, the density is constant at the prism level. 
 7059:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 7060:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 7061:       } else { //3D
 7062: 
 7063:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 7064:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 7065:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 7066:          ///// XXXX CHECK INDICES!!!!!
 7067:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 7068:       } // 2D/3D
 7069: 
 7070:    }
 7071: } // extern "C"
 7072: 
 7073: 
 7074: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 7075: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 7076: 
 7077:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 7078: 
 7079:    const int kb  = elem->kb;
 7080:    const int kb2 = elem2->kb;
 7081: 
 7082:    // z-coordinate of prism of elem
 7083:    const double zp = elem->z_prism(k);
 7084: 
 7085:    double rho = 0.0;
 7086: 
 7087:    if (elem2->is2D()) {
 7088:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 7089: 
 7090:    } else {  // 3D
 7091: 
 7092:       // eta_min may be < zmax
 7093:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 7094:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 7095: 
 7096:       // (Extrapolate density below bottom, we will fix it later)
 7097:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 7098:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 7099:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 7100:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 7101:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 7102:    } // 2D/3D
 7103:      
 7104: 
 7105:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 7106:    // Now we need to fix it.
 7107:    if (elem->z[k] < elem2->z[kb2]) {
 7108:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 7109: 
 7110:       // There are two methods to adjust the density at the bottom of the element.
 7111:       // iunder_deep=0: 
 7112:       const double depth1 = abs(elem->z[kb]); // larger depth
 7113: 
 7114:       if (iunder_deep==0) {
 7115: 
 7116:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 7117: 
 7118:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 7119: 
 7120:       } else { // iunder_deep != 0
 7121: 
 7122:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 7123: 
 7124:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 7125: 
 7126:          //   Demeaned density at the same z coordinate as
 7127:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 7128:          }
 7129: 
 7130:       } // if iunder_deep
 7131:    } // if elem->z[kb] < elem2->z[kb]
 7132: 
 7133:    return rho;
 7134: }
 7135: 
 7136: 
 7137: extern "C" {
 7138:    __global__ void computeDensityGradient(void) {
 7139: 
 7140:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 7141:       if constexpr(ibc != 0) return;
 7142: 
 7143:          // Compute the horizontal density gradient at each element.
 7144:       // It works in two steps:
 7145:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7146:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7147:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7148:       //             gradRho.r1 = rho1 - rho0
 7149:       //             gradRho.r2 = rho2 - rho0
 7150:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7151:       // 
 7152:       //  NOTE: We use de-meaned densities.
 7153: 
 7154:       ELEM(elem);
 7155: 
 7156:       if (elem->isDry) return;
 7157: 
 7158:       const int kb  = elem->kb;
 7159:       const int i34 = elem->i34;
 7160: 
 7161:       for (int k = kb + 1; k < nvrt; k++) {
 7162:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 7163:          //             gradRho.r1 = rho1 - rho0
 7164:          //             gradRho.r2 = rho2 - rho0
 7165:          int icount = 0;
 7166:          double sumRx = 0.0;
 7167:          double sumRy = 0.0;
 7168:          for (int j1=0; j1<i34; j1++) { 
 7169: 
 7170:             const int j2 = elem->nxq(j1 + 1);
 7171: 
 7172:             // Pairs of consecutive neighbor elements of elem
 7173:             const Element *e1 = elem->nghbElems[j1];
 7174:             const Element *e2 = elem->nghbElems[j2];
 7175: 
 7176:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 7177:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 7178:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 7179: 
 7180:             // Compute the density difference and the vector from elem to e1 and e2
 7181:             // getRhoDiffAndVec takes into account boundaries/dry elements
 7182:             double diffRho1, diffRho2;
 7183:             Vector2 vec1, vec2;
 7184:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 7185:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 7186: 
 7187:             const double rl1 = length(vec1);
 7188:             const double rl2 = length(vec2);
 7189:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 7190: 
 7191:             const double delta = cross(vec1, vec2);
 7192:             const double sintheta = abs(delta)/(rl1*rl2);
 7193: 
 7194:             // To avoid problems, avoid elements with small angle between vectors
 7195:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7196:             const bool validEq = (sintheta > sin_one_deg);
 7197: 
 7198:             if (validEq) {
 7199:                // Solve the system of equations to get the density gradient at elem
 7200:                icount++;
 7201:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7202:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7203:                sumRx += Rx;
 7204:                sumRy += Ry;
 7205:             }
 7206:          } // for j1
 7207: 
 7208:          // Compute the average density gradient at elem
 7209:          if (icount==0) {
 7210:            // Bad mesh quality; bail out with 0 b-cc
 7211:            elem->gradRho[k] = {0.0, 0.0};
 7212:          } else {
 7213:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7214:          }
 7215: 
 7216:       } // for k
 7217: 
 7218:    }
 7219: 
 7220:    __global__ void computeBaroclinicTerm(void) {
 7221:    // Computes the baroclinic term at sides (at half levels).
 7222:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7223:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7224: 
 7225:       if (ibc == 1) return;
 7226: 
 7227:       SIDE(side);
 7228: 
 7229:       if (side->isDry) return;
 7230: 
 7231:       const Element *e1 = side->elems[0];
 7232:       const Element *e2 = side->elems[1]; 
 7233:       const int kb = side->kb;
 7234:       
 7235:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7236: 
 7237:       // interpolates vertically the density gradient of the two elements at the half level/
 7238: 
 7239:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7240:       int k2 = max(kb, nvrt / 2);
 7241: 
 7242:       // Starts the integration at the surface and goes down to the bottom
 7243:       side->bcc[nvrt-1] = {0.0, 0.0};
 7244:       for (int k = nvrt - 2; k >= kb; k--) {
 7245:       // For each prism level (from surface to bottom)...
 7246: 
 7247:          // For both elements, interpolate density gradient at the side's half level.
 7248:          // The gradient at the side is the average of the gradients at the elements.
 7249:          // w1, w2 are used to take into account boundary sides, with just one element.
 7250:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7251:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7252:          const double wsum = w1 + w2;
 7253:          w1 = w1/wsum;
 7254:          w2 = w2/wsum;
 7255:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7256: 
 7257:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7258:          Vector2 gradRho = {0.0, 0.0};
 7259:          if (e1 != nullptr && k > kb) {
 7260:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7261:             
 7262:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7263:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7264:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7265: 
 7266:             // Grad(rho) vertically interpolated at the side's half level
 7267:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7268: 
 7269:             // Projects the element density gradient to the side frame if needed.
 7270:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7271: 
 7272:             // Adds the contribution of the density gradient at the side's half level
 7273:             gradRho += gradRho1*w1;
 7274:          }      
 7275:          if (e2 != nullptr && k > kb) {
 7276:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7277:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7278:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7279:             
 7280:             // Grad(rho) vertically interpolated at the side's half level
 7281:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7282: 
 7283:             // Projects the element density gradient to the side frame if needed.
 7284:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7285: 
 7286:             // Adds the contribution of the density gradient at the side's half level
 7287:             gradRho += gradRho2*w2;
 7288:          }
 7289: 
 7290:          
 7291:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7292:          // multiplied by -rampbc*(g/rho0) 
 7293:          const double grav3 = side->grav3();
 7294:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7295: 
 7296:       } // for
 7297: 
 7298:    }
 7299: 
 7300: 
 7301: 
 7302:    __global__ void computeHorGradientAtSide(void) {
 7303: 
 7304:       // Compute the horizontal density gradient at each element.
 7305:       // It works in two steps:
 7306:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7307:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7308:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7309:       //             gradRho.r1 = rho1 - rho0
 7310:       //             gradRho.r2 = rho2 - rho0
 7311:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7312:       // 
 7313:       //  NOTE: We use de-meaned densities.
 7314: 
 7315:       SIDE(side);
 7316: 
 7317: 
 7318:       if (side->isDry) return;
 7319: 
 7320:       // Computes the gradient of the variables at the side center.
 7321:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7322:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7323:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7324: 
 7325:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7326:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7327:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7328:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7329: 
 7330:    }
 7331: 
 7332: 
 7333:    __global__ void solveMomentumEquations(double time) {
 7334: 
 7335:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7336:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7337: 
 7338:       SIDE(side);
 7339: 
 7340:       if (side->isDry) 
 7341:       {
 7342:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7343: 
 7344:          return;
 7345:       }
 7346: 
 7347:       const Node *n1 = side->n1;
 7348:       const Node *n2 = side->n2;
 7349: 
 7350:       const int kb = side->kb;
 7351: 
 7352:       const double veg_h = side->veg_h();
 7353:       const double grav3 = side->grav3();
 7354: 
 7355:       if (side->is2D()) {
 7356:          // Remember: Do not use htot2, which is updated.
 7357:          const double htot = side->htot1();
 7358:          const double hhat = side->hhat;
 7359: 
 7360:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7361: 
 7362:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7363:          const Vector2 tau2 = side->tau();
 7364: 
 7365:          // hat_gam has units of m/s
 7366: 
 7367:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7368:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7369:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7370: 
 7371:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7372: 
 7373: 
 7374:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7375: 
 7376:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7377: 
 7378:       }
 7379:       else { // 3D
 7380: 
 7381:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7382:          // 
 7383:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7384:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7385:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7386:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7387:          // k+1 and k.
 7388: 
 7389:          const double zTopCanopy = side->zTopCanopy();
 7390: 
 7391:          // Initialize the tridiagonal system
 7392:          for (int k = kb + 1; k < nvrt; k++) {
 7393:             
 7394:             const int kin = k - (kb + 1);
 7395: 
 7396:  
 7397:             alow[kin] = 0.0;
 7398:             cupp[kin] = 0.0;
 7399:             bdia[kin] = 0.0;
 7400: 
 7401:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7402:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7403: 
 7404:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7405:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7406:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7407: 
 7408:             // First part: layers k, k+1
 7409:             if (k < nvrt - 1) {
 7410:                              
 7411:                if constexpr(iveg != 0) {
 7412: 
 7413:                   // If there is vegetation at this level...
 7414:                   if (zTopCanopy > side->zc[k]) {
 7415:                      // If the canopy is above the k layer...
 7416:                      
 7417:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7418:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7419:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7420:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7421: 
 7422:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7423:                      const double vmag2 = length(ut2);
 7424:                      const double vmag1 = length(side->u2[k]);
 7425:                      const double vmag = 0.5*(vmag1 + vmag2);
 7426:                      
 7427:                      // Computes the vegetation alpha at the face center
 7428:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7429: 
 7430:                      cff1 += veg_alpha_sd*dt*vmag;
 7431: 
 7432:                   } // if (zTopCanopy
 7433:                } // if iveg
 7434: 
 7435:                const double dzz = side->Dz(k + 1);
 7436:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7437:                const double tmp = dt*dfz/dzz;
 7438:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7439: 
 7440:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7441:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7442:             }
 7443: 
 7444: 
 7445:             // Second part: layers k-1, k
 7446:             if (k > kb + 1) {
 7447: 
 7448:                double cff1 = 1.0; //init \bar{c^k}
 7449: 
 7450:                if constexpr(iveg != 0) {
 7451:                   // If there is vegetation at this level...
 7452:                   if (zTopCanopy > side->zc[k-1]) {
 7453:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7454:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7455: 
 7456:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7457: 
 7458:                      const double vmag2 = length(ut2);
 7459:                      const double vmag1 = length(side->u2[k-1]);
 7460:                      const double vmag = 0.5*(vmag1 + vmag2);
 7461: 
 7462:                      // Computes the vegetation alpha at the face center
 7463:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7464:                      cff1 += veg_alpha_sd*dt*vmag;
 7465:                   } // if zTopCanopy
 7466: 
 7467:                } // if iveg
 7468: 
 7469:                const double dzz = side->Dz(k);
 7470:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7471:                const double tmp = dt*dfz/dzz;
 7472:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7473: 
 7474:                alow[kin] += cff1*dzz/6.0 - tmp;
 7475:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7476: 
 7477:             } else { // Bottom boundary
 7478:                // This occurs at the bottom, where the bottom drag is applied.
 7479: 
 7480:                bdia[kin] += dt*side->chi2; // XXXX
 7481: 
 7482:             } // if (k > kb + 1)
 7483: 
 7484: 
 7485:          } // for (int k
 7486: 
 7487: 
 7488: 
 7489:          // Computes the RHS.
 7490:          // -----------------
 7491: 
 7492:          //	BC to be imposed at the end.
 7493: 
 7494:          const Vector2 gradETP  = side->gradETP;
 7495:          const Vector2 gradPr   = side->gradPr;
 7496:          const Vector2 gradEta1 = side->gradEta1;
 7497:          const Vector2 gradEta2 = side->gradEta2;
 7498: 
 7499:          const Vector2 *btu = side->btu;
 7500:          const Vector2 *u2  = side->u2;
 7501:          const double coriolis = side->coriolis;
 7502:          const Vector2 *nuGradU = side->nuGradU;
 7503: 
 7504:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7505:          for (int k = kb + 1; k < nvrt; k++) {
 7506:             const int kin = k - kb - 1;
 7507: 
 7508:             const double dz_0 = side->Dz(k);
 7509:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7510: 
 7511:             rrhs[kin] = {0.0, 0.0};
 7512:             double dz = 0.0;
 7513: 
 7514:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7515:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7516:             if (k < nvrt  ) dz += dz_1;
 7517:             if (k > kb + 1) dz += dz_0;
 7518: 
 7519:             // Elevation gradient, atmospheric pressure and tidal potential
 7520:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7521: 
 7522:             // Coriolis, advection, wind stress, and horizontal viscosity
 7523:             if (k < nvrt - 1) {
 7524: 
 7525: 
 7526:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7527:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7528:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7529:                                                 
 7530: 
 7531:                //diff stress tensors 1006
 7532:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7533:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7534:                   assert(false && "Not implemented: itur == 5");
 7535:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7536:                }
 7537:                // else assert(false && "itur # Not implemented");
 7538: 
 7539:             } else { // k == nvrt - 1 SURFACE
 7540:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7541:                const Vector2 tau2 = side->tau();
 7542: 
 7543:                rrhs[kin] += dt*tau2;          
 7544: 
 7545:             } // if k<nvrt
 7546: 
 7547: 
 7548:             if (k > kb + 1) {
 7549:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7550:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7551:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7552: 
 7553:                // diff stress tensors 1006
 7554:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7555:                   assert(false && "Not implemented: itur == 5");
 7556:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7557:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7558:                }
 7559:                // else assert(false && "itur # Not implemented");
 7560: 
 7561: 
 7562:             } // if k>kbs + 1
 7563: 
 7564:             // Baroclinic
 7565:             Vector2 *bcc = side->bcc;
 7566:             if constexpr(ibc == 0) {
 7567:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7568:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7569: 
 7570:             } // if ibc==0
 7571: 
 7572:          } // k=kb + 1,nvrt
 7573: 
 7574: 
 7575:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7576: 
 7577:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7578:             const int kin = k - kb - 1;
 7579:    
 7580:             // Velocity is always clamped to maximum values
 7581:             side->u2[k] = clampVelocity(soln[kin]);
 7582:          } // k
 7583: 
 7584:       } // if side->is2D()
 7585:       
 7586: 
 7587:       // Impose velocity boundary condition at the bottom
 7588:       if constexpr(imm == 2) { // 3D bed deformation model
 7589:          double dep;
 7590:          Vector2 vel;
 7591: 
 7592:          assert(false && "Not implemented: imm == 2");
 7593:          //update_bdef(time, x0, y0, dep, vel);
 7594:          // side->u2[kb] = vel;
 7595: 
 7596:       } else { // imm = 0 or 1
 7597:          if (side->Cd() == 0.0) {
 7598:             side->u2[kb] = side->u2[kb + 1];
 7599: 
 7600:          } else if (side->is3D()) { // 3D no slip bottom   
 7601:             side->u2[kb] = {0.0, 0.0};
 7602: 
 7603:          }
 7604:           
 7605:       } // if imm
 7606: 
 7607:       // The velocities below the bottom level are set to zero
 7608:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7609: 
 7610: 
 7611:    }
 7612: 
 7613: 
 7614:    __global__ void applyMomentumBC(void) {
 7615: 
 7616:       SIDE_BND(sideBnd);
 7617: 
 7618:       Side *side = sideBnd->side;
 7619:       const BoundarySegment *segment = sideBnd->segment;
 7620:       const Node *n1 = side->n1;
 7621:       const Node *n2 = side->n2;
 7622: 
 7623:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7624: 
 7625:       const bool isLand = segment->isLand;
 7626:       const int ifltype = segment->ifltype;
 7627: 
 7628:       const int kb = side->kb;
 7629: 
 7630: 
 7631:       if (!isLand && ifltype != 0) {
 7632:          const Vector2 *ubc = sideBnd->ubc;
 7633:   
 7634:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7635:             
 7636:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7637:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7638: 
 7639:             if (ifltype == -1) {
 7640:                // Flather 1
 7641: 
 7642:                const double depth = side->depth();
 7643: 
 7644:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7645: 
 7646:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7647: 
 7648:                side->u2[k] = vnorm*side->n;
 7649: 
 7650:             } else if (ifltype == -2) { // Discharge
 7651: 
 7652:                const double eta1 = side->eta1();
 7653:                const double eta2 = side->eta2();
 7654:                const double htot = side->htot2();
 7655: 
 7656:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7657:                assert(false && "Not implemented: Discharge bc");
 7658:                // const double dischrg = discharge(eta1);
 7659:                const double dischrg = 0.0; // XXX REMOVE
 7660:                
 7661: 
 7662:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7663: 
 7664:                const double vnorm = dischrg*eta2/htot;
 7665: 
 7666:                side->u2[k] = vnorm*side->n;
 7667: 
 7668:             }
 7669:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7670:                const double vnorm = dot(side->u2[k], side->n);
 7671: 
 7672:                double rat;
 7673:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7674:                else              rat = segment->vobc2; // outgoing
 7675: 
 7676:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7677: 
 7678:             }
 7679:             else { // not Flather or 3D radiation
 7680: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7681:                side->u2[k] = ubc[k];
 7682: 
 7683:             } // if (segment->ifltype...
 7684: 
 7685:          }
 7686: 
 7687:       }
 7688:       else if (isLand) { // if it is land boundary side
 7689: 
 7690:          if constexpr(islip == 0) { // free slip
 7691: 
 7692:             for (int k = kb; k < nvrt; k++) {
 7693: 
 7694:                const Vector2 t = side->t();
 7695:                const Vector2 n = side->n;
 7696: 
 7697:                double vnorm = 0.0; // for most cases
 7698:                const double vtan = dot(side->u2[k], t);
 7699:                
 7700:                side->u2[k] = vtan*t - vnorm*n;
 7701: 
 7702:             }
 7703: 
 7704:          } else { // no slip
 7705:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7706: 
 7707:          }
 7708:       } // if (side segment type...
 7709: 
 7710:    }
 7711: 
 7712: 
 7713:    __global__ void shapiroFilter1(void) {
 7714:       // First step of the Shapiro filter (normally used if indvel<=0)
 7715:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7716: 
 7717:       SIDE(side);
 7718: 
 7719:       // Only internal wet sides are processed
 7720:       if (side->isDry || !(side->isInternal())) return;
 7721: 
 7722:       const int kb = side->kb;
 7723: 
 7724:       for (int mm = 0; mm < niter_shap; mm++) {
 7725: 
 7726:          for (int k = kb + 1; k < nvrt; k++) {
 7727:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7728:             Vector2 suru = {0.0, 0.0};
 7729: 
 7730:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7731: 
 7732:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7733: 
 7734:                int kin = k;
 7735:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7736:                
 7737:                // Get the velocity at the neighbor's side.
 7738:                Vector2 nSideU2 = nSide->u2[kin];
 7739: 
 7740:                // Projects the velocity to the current side frame if needed.
 7741:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7742: 
 7743:                suru += nSideU2;
 7744:             }
 7745: 
 7746:             // Reusing bcc as a temporary array to store the suru values.
 7747:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7748: 
 7749:          }
 7750:       }
 7751:    }
 7752: 
 7753:    __global__ void shapiroFilter2(void) {
 7754:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7755: 
 7756:       SIDE(side);
 7757: 
 7758: 
 7759:       if (side->isDry || !(side->isInternal())) return;
 7760: 
 7761:       const int kb = side->kb;
 7762: 
 7763:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7764: 
 7765:       if (side->is2D()) {
 7766:          side->u2[kb + 1] = side->bcc[kb + 1];
 7767:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7768: 
 7769:       } else {
 7770:          // 3D
 7771:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7772:          
 7773:       }
 7774: 
 7775:    }
 7776: 
 7777: 
 7778:    __global__ void ul0UpdateZCoords(void) {
 7779:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7780:       
 7781:       NODE(node);      
 7782: 
 7783: 
 7784:       if (false) { //node->isDry) { XXXXXXX
 7785: 
 7786:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7787: 
 7788:          if constexpr(ivcor != 1) node->kb = 0;
 7789: 
 7790:       } else {
 7791: 
 7792:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7793:          node->updateKb();
 7794: 
 7795:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7796: 
 7797:       }
 7798: 
 7799:       // We use the temp.b field to store the previous state of isDry.
 7800:       node->tmp.b = node->isDry;
 7801: 
 7802:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7803:       node->isDry = true;
 7804: 
 7805:    }
 7806: 
 7807:    __global__ void ul0ComputeDryElements(void)
 7808:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7809:    {
 7810:       ELEM(elem);
 7811: 
 7812:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7813: 
 7814:       elem->kb = 0;
 7815: 
 7816:       if (elem->isDry) return;
 7817: 
 7818: 
 7819:    //    if(elem->isDry2()) { // XXXX
 7820:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7821:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7822:    //        call parallel_abort(errmsg)
 7823:    //    }
 7824: 
 7825:       const Node *n1 = elem->nodes[0];
 7826:       const Node *n2 = elem->nodes[1];
 7827:       const Node *n3 = elem->nodes[2];  
 7828:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7829: 
 7830:       // Computes element's kb as the minimum of the nodes' kb.
 7831:       const int kb1 = n1->kb;
 7832:       const int kb2 = n2->kb;
 7833:       const int kb3 = n3->kb;
 7834:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7835: 
 7836: 
 7837:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7838: 
 7839: 
 7840:       // Computes the element z as the mean of the nodes z.
 7841:       for (int k = elem->kb; k < nvrt; k++) {
 7842: 
 7843:          // Compute the element z as the mean of the nodes z.
 7844:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7845:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7846:          elem->z[k] /= elem->i34;
 7847: 
 7848:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7849:       }
 7850:                   
 7851:    }
 7852: 
 7853:    __global__ void ul0ComputeDryNodes(void)
 7854:    // Updates node's isDry based on the elements' isDry. 
 7855:    {
 7856:       NODE(node);
 7857: 
 7858:       node->isDry = true;
 7859: 
 7860:       // A node is wet if at least one of the elements sharing it is wet.
 7861:       for (int j = 0; j < node->numElements; j++) {
 7862:          const Element *elem = node->elements[j];
 7863:          if (!elem->isDry) {
 7864:             node->isDry = false;
 7865:             break;
 7866:          }
 7867:       }
 7868: 
 7869:        
 7870:    }
 7871: 
 7872: 
 7873:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7874:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7875:    // node->tmp.b is true if the node was previously dry.
 7876:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7877:    {
 7878:       NODE(node);
 7879:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7880: 
 7881:       // Avoid this the first time step.
 7882:       if (it == iths) return;  
 7883: 
 7884:       const bool wasDry = node->tmp.b;
 7885: 
 7886: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7887: 
 7888:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7889: 
 7890:          for (int k=0; k < nvrt; k++) {
 7891: 
 7892:             Vector3 utmp={0.0, 0.0, 0.0};
 7893: 
 7894:             double ttmp=0.0;
 7895:             double stmp=0.0;
 7896:             int icount=0;
 7897:             for (int j = 0; j < node->numNodes; j++) {
 7898: 
 7899:                const Node *nbrNode = node->nodes[j];
 7900:                
 7901:                const bool wasNbrDry = nbrNode->tmp.b;
 7902: 
 7903:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7904:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7905: 
 7906:                   icount++;
 7907: 
 7908:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7909:                   utmp += nbrNode->uvw2(k);
 7910:                   
 7911:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7912:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7913:                }
 7914:             }
 7915: 
 7916:             if (icount > 0) {
 7917:                const double inv_icount = 1.0/icount;
 7918:                utmp = inv_icount*utmp;
 7919:                node->u2[k]     = {utmp.x, utmp.y};
 7920:                node->w2[k]     = utmp.z;
 7921:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7922:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7923:             } else {
 7924:                node->u2[k] = {0.0, 0.0};
 7925:                node->w2[k] = 0.0;
 7926:                // Initialize tracers to 0.0??? XXXXX
 7927:             }
 7928:          }
 7929:       }
 7930:    }
 7931: 
 7932:   
 7933:    
 7934: 
 7935: 
 7936:    __global__ void ul0UpdateSides(int it, int iths) {
 7937:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7938:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7939:    // The dryness of the sides is updated in ul0UpdateSides2.
 7940: 
 7941:       SIDE(side);
 7942: 
 7943:       // A side is wet if and only if at least one of its elements is wet.
 7944:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7945:  
 7946:       const Node *n1 = side->n1;
 7947:       const Node *n2 = side->n2;
 7948:      
 7949:       const int kb1 = n1->kb;
 7950:       const int kb2 = n2->kb;
 7951: 
 7952:       side->kb = 0; // default when dry
 7953: 
 7954:       if (isWet) {
 7955: 
 7956:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7957: 
 7958:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7959: 
 7960:          side->kb = min(kb1, kb2);
 7961: 
 7962:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7963: 
 7964:          for (int k = side->kb; k < nvrt; k++) {
 7965:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7966: 
 7967:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7968: 
 7969:             // Compute velocity for re-wetted sides 
 7970:             if ((it != iths) && (side->isDry && isWet)) {
 7971: 
 7972:                Vector2 utmp={0.0, 0.0};
 7973: 
 7974:                int icount=0;
 7975: 
 7976:                // For all the sides on the two elements that share this side
 7977:                for (int j = 0; j < 2; j++) {
 7978:                   const Element *elem = side->elems[j];
 7979:                   if (elem == nullptr) continue;
 7980: 
 7981:                   for (int jj=0; jj < elem->i34; jj++) {
 7982:                      const Side *nSide = elem->sides[jj];
 7983:                      if (nSide->isDry) continue;
 7984: 
 7985:                      icount++;
 7986:                      utmp += nSide->u2[k];  
 7987:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7988:                   }
 7989:                }
 7990:                   
 7991:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7992:                if (icount > 0)  side->u2[k] = utmp/icount;
 7993:                else             side->u2[k] = {0.0, 0.0};
 7994:                   
 7995:             } // if ((it != iths) && (side->isDry && isWet))
 7996: 
 7997:          } // for k
 7998: 
 7999:       } // if isWet 
 8000:       
 8001: 
 8002: 
 8003:    }
 8004: 
 8005:    __global__ void ul0UpdateSides2(void) {
 8006:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 8007:    
 8008:          SIDE(side);
 8009:    
 8010:          const Element *e1 = side->elems[0];
 8011:          const Element *e2 = side->elems[1];
 8012: 
 8013:          // A side is wet if and only if at least one of its elements is wet.
 8014:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 8015: 
 8016:          // Update the side's dryness
 8017:          side->isDry = !isWet;
 8018: 
 8019:    }
 8020: 
 8021: 
 8022:    __global__ void zeroNodalVelocities(void) {
 8023:       NODE(node);
 8024: 
 8025:       for (int k = 0; k < nvrt; k++) {
 8026:          node->u2[k]   = {0.0, 0.0};
 8027:          node->w2[k]   = 0.0;
 8028:          node->utmp[k] = {0.0, 0.0};         
 8029:       }
 8030:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 8031:    }
 8032:  
 8033: 
 8034:    __global__ void computeNodalVerticalVelocities1(void) {
 8035:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8036:    // Adds the element's vertical velocity times the element's area.
 8037:       ELEM(elem);
 8038: 
 8039:       for (int j = 0; j < elem->i34; j++) {
 8040:          Node *node = elem->nodes[j];
 8041: 
 8042:          for (int k = node->kb; k < nvrt; k++) {
 8043:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 8044:          }
 8045:          atomicAdd(&(node->tmp.d), elem->area);
 8046:       }
 8047:    }
 8048: 
 8049:    __global__ void computeNodalVerticalVelocities2(void) {
 8050:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 8051:    // Divides by the total area of the elements sharing the    node.
 8052:       NODE(node);
 8053: 
 8054: 
 8055:       const double invArea = 1.0 / node->tmp.d;
 8056:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 8057: 
 8058:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 8059:    }
 8060: 
 8061: 
 8062:    __global__ void computeNodalHorizontalVelocities1(void) {
 8063: 
 8064:       assert(indvel <= 0 && "computeNodalHorizontalVelocities1 only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 8065: 
 8066:       ELEM(elem);
 8067: 
 8068:       if (elem->isDry) return;
 8069: 
 8070:       const int kb = elem->kb;
 8071:       const bool isTri = elem->isTri();
 8072: 
 8073:       if constexpr(indvel <= 0) {
 8074:          // Assuming discontinous hvel.
 8075: 
 8076:          if (isTri) { // For triangles
 8077:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 8078:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 8079:             #pragma unroll
 8080:             for (int j = 0; j < 3; j++) {
 8081:                // For every node of the triangle...
 8082:                Node *node = elem->nodes[j];
 8083: 
 8084:                if (node->isDry) continue;
 8085: 
 8086:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 8087:                const Side *s2 = elem->sides[(j + 1) % 3];
 8088:                const Side *s3 = elem->sides[(j + 2) % 3];
 8089: 
 8090:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 8091: 
 8092:                atomicAdd(&(node->tmp.i), 1);
 8093: 
 8094:                for (int k = kb; k < nvrt; k++)  {
 8095:                   Vector2 s1u2 = s1->u2[k];
 8096:                   Vector2 s2u2 = s2->u2[k];
 8097:                   Vector2 s3u2 = s3->u2[k];
 8098: 
 8099:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 8100:                   if constexpr(ics == 2) {
 8101:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 8102:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 8103:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 8104:                   }
 8105: 
 8106:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 8107:                   u = clampVelocity(u);
 8108:                   atomicAdd(&(node->utmp[k].x), u.x);
 8109:                   atomicAdd(&(node->utmp[k].y), u.y);
 8110: 
 8111:                }
 8112: 
 8113:             }
 8114:          }
 8115:          else { // For quads
 8116: 
 8117: 
 8118:             // Compute the bilinear coordinates of the center of each diagonal.
 8119:             // Weights from side-center domain (Fortran shape_c2); eval at node-diagonal midpoints.
 8120:             double xi, eta;
 8121:             double shp13[4], shp24[4];
 8122:             Point2 x0, x1, x2, x3;
 8123:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 8124:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 8125:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 8126: 
 8127:             elem->inverseBilinearQuad(p13, xi, eta, shp13, true);
 8128:             elem->inverseBilinearQuad(p24, xi, eta, shp24, true);
 8129: 
 8130: 
 8131:             for (int k = kb; k < nvrt; k++) {
 8132: 
 8133:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 8134:                Vector2 sideU[4];
 8135:                #pragma unroll
 8136:                for (int j = 0; j < 4; j++) {
 8137:                   Vector2 u = elem->sides[j]->u2[k];
 8138:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 8139:                   sideU[j] = u;
 8140:                }
 8141: 
 8142:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 8143:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 8144: 
 8145:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 8146:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 8147:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 8148:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 8149:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 8150:                #pragma unroll
 8151:                for (int j = 0; j < 4; j++) {
 8152:                   Node *node = elem->nodes[j];
 8153:                   if (node->isDry) continue;
 8154: 
 8155:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 8156:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 8157:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 8158:                }
 8159:             }
 8160: 
 8161:          }
 8162: 
 8163:       }
 8164:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 8165:       
 8166:    }
 8167: 
 8168: 
 8169:    __global__ void computeNodalHorizontalVelocities2(void) {
 8170:       NODE(node);
 8171: 
 8172:       const int nodeCount = node->tmp.i;
 8173: 
 8174:       if (nodeCount == 0) 
 8175:       {
 8176:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 8177:          return;
 8178:       }
 8179: 
 8180:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 8181:       
 8182:       const int kb = node->kb;
 8183: 
 8184:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 8185:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 8186:      }   
 8187: 
 8188:  
 8189: 
 8190:    __global__ void resetVelocityOpenBndNodes(void) {
 8191:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8192: 
 8193:       NODE_BND(nodebnd);
 8194:  
 8195:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8196:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8197:       }
 8198: 
 8199:    }
 8200: 
 8201: 
 8202:    __global__ void setVelocityOpenBndNodes(void) {
 8203:    // For open boundary nodes sets their velocity to the imposed values.
 8204: 
 8205:       SIDE_BND(sidebnd);
 8206: 
 8207:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8208:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8209:          // to its segment to the average of the side velocity.
 8210: 
 8211:          for (int k = 0; k < nvrt; k++) {
 8212:             Node *n1 = sidebnd->side->n1;
 8213:             Node *n2 = sidebnd->side->n2;
 8214: 
 8215: 
 8216:             Vector2 &n1_u2 = n1->u2[k];
 8217:             Vector2 &n2_u2 = n2->u2[k];
 8218: 
 8219:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8220:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8221:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8222:             }
 8223:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8224:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8225:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8226:             }
 8227: 
 8228:          }
 8229: 
 8230:       }
 8231: 
 8232:    }
 8233: 
 8234: 
 8235:    __global__ void computeVerticalVelocity(void) {
 8236:       // Computes the vertical velocity at the (2D) element's centroid.
 8237:       // In this function we will be considering volumetric elements, with side faces and a 
 8238:       // bottom and a top face. We will call them SFs, BF and TF.
 8239:       // It computes the flux coming from BF and the SFs.
 8240:       // If the bed is moving, it takes that into account.
 8241:       // Since water is incompressible, the integral of the velocity times the normal vector
 8242:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8243:       // and the BF is equal to the flux going out from the TF.
 8244:       // TF = - BF - sum(SFs).
 8245:       // It then computes the horizontal velocity at the center of TF.
 8246:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8247:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8248:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8249: 
 8250:       ELEM(elem);
 8251: 
 8252:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8253: 
 8254:       if (elem->isDry) return;
 8255: 
 8256:       const int kb = elem->kb;
 8257:       const bool isTri = elem->isTri();
 8258: 
 8259:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8260: 
 8261:       // Compute the bottom velocity
 8262:       if constexpr(imm != 0) {
 8263:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8264:       }
 8265: 
 8266: 
 8267:       double bottomArea3D;
 8268:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8269: 
 8270:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8271: 
 8272:       double topArea3D;
 8273: 
 8274:       // Bottom face flux
 8275:       double bottomFlux = 0.0;
 8276:       Vector2 u2meanBottom = {0.0, 0.0};
 8277:       const Vector2 gradh = elem->grad2(&Node::depth);
 8278:       if constexpr(imm==2) {
 8279:          Vector3 ubed;
 8280: 
 8281:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8282:          // updateBDEF(ubed);
 8283:      
 8284:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8285: 
 8286:          // elem->w[kb] += ubed.z;
 8287:       }
 8288:       else {
 8289: 
 8290:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8291:   
 8292:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8293:          // in the direction of motion.
 8294:          const double bottomW = - dot(gradh, u2meanBottom);  
 8295:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8296: 
 8297:          // VElocity associated to the bed deformation
 8298:          double bedVelocity = 0.0;
 8299:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8300: 
 8301:          elem->w[kb] = bedVelocity + bottomW; 
 8302: 
 8303:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8304: 
 8305:          elem->transport.setVerticalAdvectionFlux(kb, 0.0);
 8306:          
 8307:       } // if imm
 8308: 
 8309:       // Compute w for kb+1 to nvrt-1
 8310:       for (int l = kb; l < nvrt - 1; l++) {
 8311: 
 8312:          // normal vector to the top face of the "volumetric" element (3D)
 8313:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8314: 
 8315:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8316:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8317: 
 8318:          // Compute the total flux at the sides
 8319:          double sideFlux = 0.0;
 8320: 
 8321:          for (int j = 0; j < elem->i34; j++) {
 8322:             const Side *side = elem->sides[j];
 8323:             const int kbs = side->kb;
 8324:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8325:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8326:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8327: 
 8328:             // The area is "clamped" meaning that it takes kb into account.
 8329:             const double sideArea = side->areaClamped(l + 1);
 8330: 
 8331:             const double sign = elem->ssign[j]; 
 8332: 
 8333:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8334:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8335:          }
 8336:          
 8337:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8338:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8339:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8340: 
 8341:          // The flux at the top ace can be computed from the other flows.
 8342:          // All fluxes are in directions into the prism.
 8343:          const double topFlux = - sideFlux - bottomFlux;
 8344: 
 8345:          elem->transport.setVerticalAdvectionFlux(l + 1, topFlux);
 8346: 
 8347:          // Flux at the top face due to the horizontal velocities only
 8348:          // topFlux = topHorizontalFlux + topVerticalFlux
 8349:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8350: 
 8351:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8352:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8353: 
 8354:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8355: 
 8356:          bottomFlux = -topFlux;
 8357:          
 8358:       }
 8359: 
 8360:    }  
 8361: 
 8362: 
 8363: 
 8364: 
 8365: 
 8366: 
 8367: 
 8368: // !===============================================================================
 8369: // !===============================================================================
 8370: 
 8371: } // extern "C"
 8372: 
 8373: #ifdef DONTCOMPILE
 8374: __device__ void computeVerticalAdvection(void) {
 8375:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8376: 
 8377:    sdbt(1:2,:,:)=0.d0
 8378: 
 8379:    const Side *side = FROM kernel;
 8380: 
 8381:    if(side->isDry) return;
 8382: 
 8383:    // If side is wet...
 8384: 
 8385: 
 8386:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8387:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8388:    double ws[nvrt] = {} // w @ side
 8389:    int icount = 0;
 8390:    for (int j=0; j<2; j++) {
 8391:       const Element *elem = side->elements[j];
 8392:        
 8393:       if(elem != nullptr) {
 8394:          icount++;
 8395:          for (int k=0; k<nvrt; k++) {
 8396:             ws[k] = ws[k] + elem->w[k];
 8397:          }
 8398:       }
 8399:    }  // for j
 8400: 
 8401:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8402:    ws = ws/icount;
 8403: 
 8404:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8405:    // Splines allow for a smooth transition between vertical levels.
 8406:    // Splines have continuity restrictions at the internal knots, but
 8407:    // we have to provide the 1st derivatives at the endpoints.
 8408:    const int kbs = side->kbs; 
 8409:    
 8410:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8411:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8412:    initCubicSpline(kbs, nvrt, side, ws, up)
 8413: 
 8414:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8415:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8416:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8417: 
 8418:    // Total advection (average onto side)
 8419:    const Node *node1 = side->nodes[0];
 8420:    const Node *node2 = side->nodes[1];
 8421:    for (int k=kbs(i); k<nvrt; k++) {
 8422: 
 8423:       Vector2 bcc1 = node1->bcc[k];
 8424:       Vector2 bcc2 = node2->bcc[k];
 8425:       if constexpr(ics == 2) {
 8426:          // Project the velocities from the node frames to the side frame
 8427:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8428:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8429:       }
 8430: 
 8431:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8432:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8433: 
 8434:    }
 8435: }
 8436: #endif
 8437: 
 8438: 
 8439: extern "C" {
 8440:    __global__ void computeElemAverageGhat(void) {
 8441:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8442: 
 8443:       ELEM(elem);
 8444:       
 8445:       elem->ghat1= {0.0, 0.0};  
 8446: 
 8447:       if constexpr(ihydraulics != 0) {
 8448:          if (nhtblocks > 0 && elem->isblock) return;
 8449:       }
 8450: 
 8451:       
 8452:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8453:       // cff1-3: coefficients for 2D/3D
 8454: 
 8455:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8456:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8457:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8458: 
 8459:       if (elem->isDry) return;
 8460: 
 8461:       // Average of the coefficients
 8462:       double av_cff1 = 0.0;  // av. for cff1
 8463:       double av_cff2 = 0.0;  // av. for cff2
 8464:       double av_cff3 = 0.0;  // av. for cff3
 8465:       double av_df = 0.0;  // av. for H^\alpha / H
 8466:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8467:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8468: 
 8469:       const int i34 = elem->i34;
 8470:       const int kb  = elem->kb;
 8471: 
 8472:       for (int j=0; j<i34; j++) {
 8473:          // For each node and side in the element...
 8474: 
 8475:          const Node *node = elem->nodes[j];
 8476:          const Side *side = elem->sides[j];
 8477: 
 8478:          const double chi      = side->chi;
 8479:          const double veg_c2   = side->veg_c2;
 8480:          const double veg_beta = side->veg_beta;
 8481:          const double veg_h    = side->veg_h();
 8482:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8483: 
 8484:          const Vector2 gradPhi = elem->gradPhi[j];
 8485: 
 8486:          // Node - const in elem
 8487:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8488:          elem->gradPr  += node->pr  *gradPhi;
 8489: 
 8490:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8491: 
 8492:         
 8493:          const double htot  = side->htot2();        // Total depth at the side
 8494:          const double zctr2 = side->zTopCanopy();  
 8495: 
 8496:          double cff1; 
 8497:          double cff2; 
 8498:          double cff3;   
 8499:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8500:          // coefficients applied to 2D/3D case 
 8501:             cff1 = side->hhat/htot;
 8502:             cff2 = 0.0;
 8503:             cff3 = 0.0;
 8504:          } else { //3D
 8505:             //Init for no-veg case
 8506:             cff1 = 1.0;
 8507:             cff2 = 1.0;
 8508:             cff3 = 0.0;
 8509: 
 8510:             if constexpr(iveg != 0) {
 8511:                // Computes coefficients used with vegetation terms G1, G2
 8512:                // cff1, cff3 are used for the first two terms in G1, G2:
 8513:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8514:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8515:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8516:                if(veg_h < 0.99*htot) { // submergent vegetation
 8517:                   cff1 = 1.0;
 8518:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8519:                   cff3 = veg_c;
 8520: 
 8521:                } else { // emergent vegetation
 8522:                   cff1 = 1.0/(1.0 + veg_c2);
 8523:                   cff2 = cff1;
 8524:                   cff3 = 0.0;
 8525: 
 8526:                }
 8527:             } // if iveg
 8528:          } //  2D/3D
 8529: 
 8530:          av_cff1 += cff1/i34;
 8531:          av_cff2 += cff2/i34;
 8532:          av_cff3 += cff3/i34;
 8533:          av_cff2_chi += cff2*chi/i34;
 8534:          av_cff3_chi += cff3*chi/i34;
 8535:          av_df += min(htot, veg_h)/(htot*i34);
 8536: 
 8537: 
 8538:          // btrack values: U^\star, U^{\star\alpha}
 8539:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8540:          Vector2 Ustar       = {0.0, 0.0}; 
 8541:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8542: 
 8543:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8544:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8545:          } else { //3D
 8546:             for (int k = side->kb + 1; k < nvrt; k++) {
 8547:             
 8548:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8549:                Ustar += w2;
 8550: 
 8551:                if constexpr(iveg != 0) {
 8552:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8553:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8554:                        Ustar_alpha += zrat*w2; // XXXX
 8555:                    }
 8556:                }  // if iveg
 8557:             }  // for k
 8558:          }  //2D/3D
 8559: 
 8560:          // If needed, project the side velocities to the element frame
 8561:          if constexpr(ics==2) {
 8562:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8563:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8564:          }
 8565:         
 8566: 
 8567:          // Add btrack & surface stress terms to \breve{G} first
 8568:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8569: 
 8570: 
 8571:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8572:          Vector2 tau    = side->tau();  
 8573:          Vector2 ubstar = side->btu[side->kb + 1];  
 8574: 
 8575:          // If needed, project tau and ubstar to the element frame
 8576:          if constexpr(ics==2) {
 8577:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8578:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8579:          }
 8580: 
 8581:          // Term for surface and bottom stress
 8582:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8583: 
 8584: 
 8585:          // All terms in F,F^\alpha,f_b except baroclinic
 8586:          // F, f_b: all explicit terms excluding vegetation 
 8587:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8588:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8589:          const double coriolis = side->coriolis;
 8590:          Vector2 F  =  coriolis*side->U;  // F_x
 8591:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8592:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8593: 
 8594:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8595:             
 8596:             for (int k = side->kb; k < nvrt; k++) {
 8597:                if (zctr2 > side->zc[k-1]) {
 8598:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8599:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8600:                    Fa +=  coriolis*w2*zrat;
 8601:                } // if zctr2
 8602:             } // k
 8603:          } // iveg
 8604: 
 8605:          // Integrate horizontal viscosity force vertically
 8606:          for (int k=side->kb + 1; k<nvrt; k++) {
 8607:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8608: 
 8609:             F += levelHorVisc;
 8610: 
 8611:             // Vegetation term
 8612:             if constexpr(iveg!=0) {
 8613:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8614:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8615:                   Fa += levelHorVisc*zrat;
 8616:                } 
 8617:             } // if iveg
 8618:          } // for k
 8619: 
 8620:          // Get nu*grad(U) at the side's bottom level
 8621:          Vector2 nuGradU = side->nuGradU[side->kb];
 8622: 
 8623:          fb += nuGradU;
 8624: 
 8625:          // If needed, project vectorsF, fb and Fa to the element frame
 8626:          if constexpr(ics==2) {
 8627:             F    = side->frame.projHorVec(F,    elem->frame);
 8628:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8629:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8630:          } // if ics
 8631: 
 8632:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8633:       } // for j (nodes and sides)
 8634: 
 8635:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8636: 
 8637: 
 8638:       // Finish off terms in F, F^\alpha and f_b
 8639:       const double grav3 = elem->mean(&Node::grav2);
 8640:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8641:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8642:       for (int j=0; j<i34; j++) { 
 8643:          // For each side in the element...
 8644:          const Side *side = elem->sides[j];
 8645:          const double chi = side->chi;
 8646: 
 8647:          const double htot = side->htot2();
 8648:          const double veg_h = side->veg_h();
 8649:          const Vector2 F  = htot*fb;
 8650:          const Vector2 Fa = min(htot, veg_h)*fb;
 8651: 
 8652:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8653:       } // for j
 8654: 
 8655:       // tmp is already in elem frame
 8656:       elem->ghat1 += tmp/i34;
 8657: 
 8658:       // Baroclinic force
 8659:       if constexpr(ibc==0) {
 8660:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8661: 
 8662:          Vector2 Fa = {0.0, 0.0};
 8663:          Vector2 intGradRho = {0.0, 0.0};
 8664:          
 8665:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8666:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8667:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8668: 
 8669:             // \in F [m^2/s/s]
 8670:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8671:          }
 8672: 
 8673:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8674:          const Vector2 F = av_df*Fa; //approx
 8675:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8676: 
 8677:       } // if ibc 
 8678: 
 8679: 
 8680: 
 8681:    } 
 8682: 
 8683: 
 8684: 
 8685: 
 8686: 
 8687: // ------------------------------------------------------------
 8688: // Transport
 8689: // ------------------------------------------------------------
 8690: 
 8691: __device__ bool TransportElem<TransportModel::Upwind>::use1stOrderUpwind(const Element *elem) const {
 8692:    if (itvd) {
 8693:       // Marked as such in tvd.prop: always 1st order upwind for this element
 8694:       return true;
 8695:    }
 8696: 
 8697:    // If any node of the element is shallow, use 1st order upwind
 8698:    for (int j = 0; j < elem->i34; j++) {
 8699:       if (elem->nodes[j]->htot2() < h_tvd) return true;
 8700:    }
 8701:    return false;
 8702: }
 8703: 
 8704: __device__ void TransportElem<TransportModel::Upwind>::savePrevTraces(const Element *elem) {
 8705:    for (int k = 0; k < nvrt; k++) prevTraces[k] = elem->tracers[k];
 8706: }
 8707: 
 8708: __device__ double TransportElem<TransportModel::Upwind>::maxPrismDt(const Element *elem, int k) const {
 8709:    if (inflow[k] == 0.0) return huge_double;
 8710:    return elem->volume(k - 1) / inflow[k] * (1.0 - 1.0e-6);
 8711: }
 8712: 
 8713: __device__ void TransportElem<TransportModel::Upwind>::setVerticalAdvectionFlux(int k, double flux)
 8714: {
 8715:    Qv[k] = flux;
 8716: }
 8717: 
 8718: __global__ void computeHorizAdvecFluxes(void) {
 8719: 
 8720: 
 8721:    SIDE(side)
 8722: 
 8723:    auto &transport = side->transport;
 8724: 
 8725:    for (int k = 0; k < nvrt; k++) transport.Qh[k] = -1.0e34; // Sentinel value for dry sides.
 8726: 
 8727:    if (side->isDry) return;
 8728: 
 8729:    const bool isLand = (side->sideBnd!=nullptr && side->sideBnd->segment != nullptr && side->sideBnd->segment->isLand);
 8730:    const int kb = side->kb;
 8731: 
 8732:    for (int k = kb + 1; k < nvrt; k++) {
 8733:       if (isLand) {
 8734:          transport.Qh[k] = 0.0;
 8735: 
 8736:       } else {
 8737:          const Vector2 n = side->n; // normal vector to the side
 8738:          const double area = side->area(k); // Area of the side face.
 8739:          const double vnor1 = dot(n, side->u2[k]);
 8740:          const double vnor2 = dot(n, side->u2[k-1]);
 8741:          const double vnor_c = 0.5*(vnor1 + vnor2); // Normal velocity at the face center.
 8742: 
 8743:          transport.Qh[k] = area*vnor_c; 
 8744:       }
 8745: 
 8746:    }
 8747: 
 8748: }
 8749: 
 8750: __global__ void horizontalAdvectionPrepare(void) {
 8751: 
 8752:    // Horizontal advection kernel.
 8753:    // -------------------------------
 8754: 
 8755:    // In this model, equations are written in such a way that concentration at time t+1 are computed from
 8756:    // *differences* of concentrations at the cell underconsideration and concentrations upwind of it. 
 8757:    // (how upwind is determined depends on the scheme)
 8758:    // 
 8759:    // For the 1st order upwind scheme, "upwind concentration" at outflow faces is the concentration at the cell itself.
 8760:    // So only inflow faces contribute to the concentration change at the cell.
 8761: 
 8762:    // In the implementation, we do 1st order independently and then consider TVD as an additional update term computed as 
 8763:    // as a sum over all faces (inflow and outflow).
 8764: 
 8765: 
 8766:    // Compute total inflow and maximum allowed sub-time step
 8767:    ELEM(elem)
 8768: 
 8769:    const int kb = elem->kb;
 8770:    const int i34 = elem->i34;
 8771:    auto &transport = elem->transport;
 8772: 
 8773:    if (elem->isDry) return;
 8774: 
 8775:    // Snapshot current prism tracers for this substep (Update reads prevTraces).
 8776:    transport.savePrevTraces(elem);
 8777: 
 8778:    elem->transport.maxDt = huge_double;
 8779: 
 8780:    for (int k = 0; k < kb + 1; k++) elem->transport.inflow[k] = 0.0;
 8781: 
 8782:    for (int k = kb + 1; k < nvrt; k++) { // For each wet prism in the element...
 8783: 
 8784:       transport.inflow[k] = 0.0;
 8785: 
 8786:       for (int j = 0; j < i34; j++) { // For each side in the element...
 8787:          const Side *side = elem->sides[j];
 8788:          const auto &sideTransport = side->transport;
 8789:          const double ssign = elem->ssign[j];
 8790:          const int kbs = side->kb;
 8791: 
 8792:          if (k <= kbs) continue;
 8793: 
 8794:          // Get the element at the other end of side j.
 8795:          const Element *neighElem = side->otherElem(elem);
 8796:          if (neighElem == nullptr || neighElem->isDry) continue;
 8797: 
 8798:          const double faceQ = sideTransport.Qh[k];
 8799:          const bool inFlux = (ssign*faceQ) < 0.0; // true if the flux points into the element
 8800: 
 8801:          const BoundarySegment *boundarySegment = (side->sideBnd == nullptr) ? nullptr : side->sideBnd->segment;
 8802:          const bool isLand = (boundarySegment != nullptr && boundarySegment->isLand);
 8803: 
 8804:          // Count this side's flux only when water flows into the element, and the water is coming from somewhere 
 8805:          // real: either a wet neighboring element, or an open boundary.         
 8806:          if (isLand || !inFlux) continue;
 8807: 
 8808:          transport.inflow[k] += fabs(faceQ);  // Sum of all inflow fluxes at level k.
 8809: 
 8810:       }
 8811:       
 8812:       // computes the minimum allowed sub-time step for the prism
 8813:       elem->transport.maxDt = min(elem->transport.maxDt, elem->transport.maxPrismDt(elem, k));
 8814:    }
 8815: 
 8816: }
 8817: 
 8818: __global__ void horizontalAdvectionUpdate(double dtb) {
 8819:    ELEM(elem);
 8820: 
 8821:    if (elem->isDry) return;
 8822: 
 8823:    const int kb = elem->kb;
 8824:    auto &transport = elem->transport;
 8825: 
 8826:    for (int k = kb + 1; k < nvrt; k++) {
 8827:       const double vol = elem->volume(k - 1);
 8828:       const double dtb_by_vol = dtb / vol;
 8829:       Tracers adv = transport.prevTraces[k];  // start from old C
 8830: 
 8831:       for (int j = 0; j < elem->i34; j++) {
 8832: 
 8833:          const Side *side = elem->sides[j];
 8834: 
 8835:          if (k <= side->kb) continue;
 8836: 
 8837:          const double faceQ = side->transport.Qh[k];
 8838:          const double sQ = elem->ssign[j] * faceQ;
 8839:          if (sQ >= 0.0) continue;  // outflow or zero: skip (upwind)
 8840: 
 8841:          // outside concentration
 8842:          Tracers Cout = adv;  // default: no change (e.g. land / same as interior)
 8843:          const Element *neigh = side->otherElem(elem);
 8844:          if (neigh != nullptr && !neigh->isDry) {
 8845:             Cout = neigh->transport.prevTraces[k];
 8846:          } else if (side->sideBnd != nullptr && !side->sideBnd->segment->isLand) {
 8847:             // XXXXXXXXXXXXX
 8848:             // Cout.tracer[0] = 0.1;
 8849:             // Cout.tracer[1] = 0.1;
 8850:          } else {
 8851:             continue;
 8852:          }
 8853: 
 8854:          const double coef = dtb_by_vol * fabs(faceQ);
 8855:          #pragma unroll 
 8856:          for (int itr = 0; itr < ntracers; itr++)
 8857:             adv.tracer[itr] += coef * (Cout.tracer[itr] - transport.prevTraces[k].tracer[itr]);
 8858:       }
 8859: 
 8860:       elem->tracers[k] = adv;
 8861:    }
 8862: 
 8863:    // extend below bottom
 8864:    for (int k = 0; k <= kb; k++)
 8865:       elem->tracers[k] = elem->tracers[kb + 1];
 8866: }
 8867: 
 8868: __global__ void verticalAdvectionUpdate(double dt) {
 8869: 
 8870:    ELEM(elem);
 8871: 
 8872:    if (elem->isDry) return;
 8873: 
 8874:    const int kb = elem->kb;
 8875:    auto &transport = elem->transport;
 8876: 
 8877:    // Fortran workshare: trel_tmp = tr_el
 8878:    transport.savePrevTraces(elem);
 8879: 
 8880:    const bool upwindElem = transport.use1stOrderUpwind(elem);
 8881: 
 8882:    // For TransportModel::Upwind this is always the path below (phi=0).
 8883:    double alow[nvrt], bdia[nvrt], cupp[nvrt], rrhs[nvrt], soln[nvrt], gam[nvrt];
 8884: 
 8885:    // Outer tracer loop as in Fortran (m=1..ntr). Matrix is scalar in m.
 8886:    for (int itr = 0; itr < ntracers; itr++) {
 8887:       // ---- upwind / iter_back: phi=0, flux_mod_v1=1, denom=1 ----
 8888:       // Full SB-TVD iteration (rrat, phi, flux_mod_v1/v2, psi1) omitted here;
 8889:       // that is the TVD branch when !upwindElem. Structure is in Fortran L1224-1488.
 8890:       const int nEq  = nvrt - (kb + 1);
 8891:       for (int kin = 0; kin < nEq ; kin++) {
 8892:          alow[kin] = 0.0;
 8893:          cupp[kin] = 0.0;
 8894:          bdia[kin] = 0.0;
 8895:       }
 8896:       for (int k = kb + 1; k < nvrt; k++) {
 8897:          const int kin = k - (kb + 1);
 8898:          const double dt_by_bigv = dt / elem->volume(k - 1);
 8899:          // upwind: denom = 1
 8900:          bdia[kin] += 1.0;
 8901:          rrhs[kin]  = transport.prevTraces[k].tracer[itr] * 1.0;
 8902:          // Upper face inflow: Qv[k] < 0
 8903:          if (k != nvrt - 1 && transport.Qv[k] < 0.0) {
 8904:             const double tmp = dt_by_bigv * fabs(transport.Qv[k]); // * flux_mod_v1(=1)
 8905:             cupp[kin] -= tmp;
 8906:             bdia[kin] += tmp;
 8907:          }
 8908:          // Lower face inflow: Qv[k-1] > 0
 8909:          if (k - 1 != kb && transport.Qv[k - 1] > 0.0) {
 8910:             const double tmp = dt_by_bigv * fabs(transport.Qv[k - 1]);
 8911:             alow[kin] -= tmp;
 8912:             bdia[kin] += tmp;
 8913:          }
 8914:       }
 8915:       tridag_sch<1>(nEq , alow, bdia, cupp, rrhs, soln, gam);
 8916:       for (int k = kb + 1; k < nvrt; k++)
 8917:          elem->tracers[k].tracer[itr] = soln[k - (kb + 1)];
 8918:    }
 8919:    // Extend below bottom
 8920:    for (int k = 0; k <= kb; k++)
 8921:       elem->tracers[k] = elem->tracers[kb + 1];
 8922: }
 8923: 
 8924: 
 8925: // Fortran transport_TVD_imp step 3: non-advection (vertical diffusion).
 8926: // Call after verticalAdvectionUpdate(dt), before nodalTracerUpdate.
 8927: // Requires dfh set (itur!=0 path, or dfh0>0 when itur==0).
 8928: __global__ void verticalDiffusionUpdate(double dt) {
 8929: 
 8930:    ELEM(elem);
 8931: 
 8932:    if (elem->isDry) return;
 8933: 
 8934:    const int kb = elem->kb;
 8935:    auto &transport = elem->transport;
 8936: 
 8937:    // Fortran: trel_tmp = tr_el
 8938:    transport.savePrevTraces(elem);
 8939: 
 8940:    double alow[nvrt], bdia[nvrt], cupp[nvrt], rrhs[nvrt], soln[nvrt], gam[nvrt];
 8941: 
 8942:    for (int itr = 0; itr < ntracers; itr++) {
 8943:       const int nEq = nvrt - (kb + 1);
 8944: 
 8945:       for (int kin = 0; kin < nEq; kin++) {
 8946:          alow[kin] = 0.0;
 8947:          cupp[kin] = 0.0;
 8948:          bdia[kin] = 1.0;
 8949:          rrhs[kin] = 0.0;
 8950:       }
 8951: 
 8952:       // Prism k = kb+1 .. nvrt-1  (Fortran kbe+1 .. nvrt)
 8953:       for (int k = kb + 1; k < nvrt; k++) {
 8954:          const int kin = k - (kb + 1);
 8955:          const double dt_by_bigv = dt / elem->volume(k - 1);
 8956: 
 8957:          // Diffusion at upper face k (Fortran k < nvrt)
 8958:          if (k < nvrt - 1) {
 8959:             const double av_df = elem->mean(k, &Node::dfh);
 8960:             const double av_dz = 0.5 * (elem->z[k + 1] - elem->z[k - 1]);
 8961:             const double tmp   = elem->area * dt_by_bigv * av_df / av_dz;
 8962:             cupp[kin] -= tmp;
 8963:             bdia[kin] += tmp;
 8964:             // settling @ face k: if wsett<=0 bdia -= area*dt_by_bigv*wsett;
 8965:             //                     else cupp -= area*dt_by_bigv*wsett;
 8966:          }
 8967: 
 8968:          // Diffusion at lower face k-1 (Fortran k > kbe+1)
 8969:          if (k > kb + 1) {
 8970:             const double av_df = elem->mean(k - 1, &Node::dfh);
 8971:             const double av_dz = 0.5 * (elem->z[k] - elem->z[k - 2]);
 8972:             const double tmp   = elem->area * dt_by_bigv * av_df / av_dz;
 8973:             alow[kin] -= tmp;
 8974:             bdia[kin] += tmp;
 8975:             // settling @ face k-1: if wsett<=0 alow += ...; else bdia += ...;
 8976:          }
 8977: 
 8978:          // Bottom settling BC (iwsett==1, k==kbe+1): bdia += area*dt_by_bigv*wsett(kb)
 8979: 
 8980:          rrhs[kin] = transport.prevTraces[k].tracer[itr];
 8981:          // if (k == nvrt - 1) rrhs += area * dt_by_bigv * flx_sf;
 8982:          // if (k == kb + 1)   rrhs -= area * dt_by_bigv * flx_bt;
 8983:          // rrhs += dt * bdy_frc;
 8984:       }
 8985: 
 8986:       tridag_sch<1>(nEq, alow, bdia, cupp, rrhs, soln, gam);
 8987: 
 8988:       for (int k = kb + 1; k < nvrt; k++)
 8989:          elem->tracers[k].tracer[itr] = soln[k - (kb + 1)];
 8990:    }
 8991: 
 8992:    for (int k = 0; k <= kb; k++)
 8993:       elem->tracers[k] = elem->tracers[kb + 1];
 8994: }
 8995: 
 8996: __global__ void nodalTracerUpdate(void) {
 8997:    NODE(node);
 8998:    if (node->isDry) return;
 8999: 
 9000:    for (int k = 0; k < nvrt; k++) {
 9001:       Tracers sum = {};
 9002:       double sumA = 0.0;
 9003: 
 9004:       for (int j = 0; j < node->numElements; j++) {
 9005:          const Element *elem = node->elements[j];
 9006:          if (elem->isDry) continue;
 9007: 
 9008:          // Element value at whole level kin (Fortran swild98): prisms kin and kin+1 are
 9009:          // interpolated linearly in z between their centers; surface takes the top prism,
 9010:          // the bed takes the bottom prism.
 9011:          const int kb  = elem->kb;
 9012:          const int kin = max(k, kb);
 9013:          int kLo = kin, kHi = kin + 1;
 9014:          double zrat = 0.0;  // Weight of prism kLo
 9015: 
 9016:          if      (kin == ivrt) { kLo = ivrt;   kHi = ivrt; }
 9017:          else if (kin == kb)   { kLo = kb + 1; kHi = kb + 1; }
 9018:          else zrat = (elem->z[kin + 1] - elem->z[kin]) / (elem->z[kin + 1] - elem->z[kin - 1]);
 9019: 
 9020:          const double A = elem->area;
 9021:          for (int itr = 0; itr < ntracers; itr++)
 9022:             sum.tracer[itr] += A * ((1.0 - zrat)*elem->tracers[kHi].tracer[itr] + zrat*elem->tracers[kLo].tracer[itr]);
 9023:          sumA += A;
 9024:       }
 9025: 
 9026:       if (sumA == 0.0) continue;
 9027:       const double invsumA = 1.0/sumA;
 9028:       for (int itr = 0; itr < ntracers; itr++)
 9029:          node->tracers[k].tracer[itr] = invsumA * sum.tracer[itr];
 9030:    }
 9031: }
 9032: 
 9033: 
 9034: __device__ __forceinline__ void atomicMinDouble(double *addr, double val) {
 9035:    unsigned long long *p = (unsigned long long *)addr;
 9036:    unsigned long long old = *p, assumed;
 9037:    do {
 9038:       assumed = old;
 9039:       old = atomicCAS(p, assumed,
 9040:          __double_as_longlong(fmin(val, __longlong_as_double(assumed))));
 9041:    } while (assumed != old);
 9042: }
 9043: 
 9044: __device__ __forceinline__ double blockMin(double v) {
 9045:    __shared__ double sh[32];
 9046:    const int lane = threadIdx.x & 31;
 9047:    const int warp = threadIdx.x >> 5;
 9048:    for (int o = 16; o > 0; o >>= 1)
 9049:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9050:    if (lane == 0) sh[warp] = v;
 9051:    __syncthreads();
 9052:    if (warp == 0) {
 9053:       const int nw = blockDim.x >> 5;
 9054:       v = (lane < nw) ? sh[lane] : huge_double;
 9055:       for (int o = 16; o > 0; o >>= 1)
 9056:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9057:    }
 9058:    return v;  // only lane 0 of warp 0 is the block min
 9059: }
 9060: 
 9061: extern "C" __global__ void minTransportDt(double *out) {
 9062:    const int idx = threadIdx.x + blockIdx.x * blockDim.x;
 9063:    double v = huge_double;
 9064:    if (idx < mesh->ne) {
 9065:       Element *elem = &mesh->localElemData[idx];
 9066:       if (!elem->isDry) v = elem->transport.maxDt;
 9067:    }
 9068:    __shared__ double sh[32];
 9069:    const int lane = threadIdx.x & 31;
 9070:    const int warp = threadIdx.x >> 5;
 9071:    for (int o = 16; o > 0; o >>= 1)
 9072:       v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9073:    if (lane == 0) sh[warp] = v;
 9074:    __syncthreads();
 9075:    if (warp == 0) {
 9076:       const int nw = (blockDim.x + 31) >> 5;
 9077:       v = (lane < nw) ? sh[lane] : huge_double;
 9078:       for (int o = 16; o > 0; o >>= 1)
 9079:          v = fmin(v, __shfl_down_sync(0xffffffffu, v, o));
 9080:       if (lane == 0) atomicMinDouble(out, v);
 9081:    }
 9082: }
 9083: 
 9084: 
 9085: 
 9086: 
 9087: 
 9088: 
 9089:    // // Mark prisms (shallow enough or marked as such in tvd.prop) that will be computed using first-order upwind formulation.
 9090:    // elem->computeUse1stOrderUpwind();
 9091: 
 9092: 
 9093: 
 9094:    // // Init horizontal mass influx (m^3*concentration) for conservation 
 9095:    // h_mass_in(1:ntr)=0 !positive in
 9096: 
 9097: 
