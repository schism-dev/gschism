 2630: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2631: 
 2632: /**
 2633:  * This method performs backtracking from the side center until a time -dt back in time 
 2634:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2635:  * intermediate point.
 2636:  *
 2637:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2638:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2639:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2640:  * remaining time.
 2641:  * 
 2642:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2643:  * 
 2644:  * @param uuint, vvint, wwint: Velocities at the final point
 2645:  * @param jlev: Level at which the backtracking is performed
 2646:  * @param dt, dtbk: Tracking timesteps
 2647:  * @return: True if the backtracking was successful, false otherwise
 2648:  */
 2649: __inline__ __device__ bool Side::btrack(
 2650:       int jlev,
 2651:       double dt,            // Tracking time
 2652:       double dtbk,          // Tracking timestep
 2653:       Vector3 &u_int        // Velocities at the initial point
 2654: ) const {
 2655: 
 2656:    // Start from side center
 2657:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2658: 
 2659:  
 2660:    double time_rm = dt; // Remaining time
 2661: 
 2662: 
 2663: 
 2664: 
 2665:    // Initial velocities
 2666:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2667: 
 2668:    // Find the element that is in the direction opposite to the velocity
 2669:    Element* curElem = findElementTowards(toVector2(u_int));
 2670: 
 2671: 
 2672:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2673:    if (curElem == nullptr) {
 2674:       // Make velocity parallel to the side
 2675:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2676:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2677:       curElem = otherElem(curElem);
 2678: 
 2679: 
 2680: if (curElem == nullptr) { u_int = {0.0, 0.0, 0.0}; return true;}
 2681: // assert(curElem!=nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2682: // printf("@@@@@@@YYYY@@@@@@@@@ curElem = %p, isDry = %d\n", curElem, curElem->isDry);
 2683:       
 2684:    }
 2685: 
 2686:    // Nudges it towards the barycenter
 2687:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2688: 
 2689: 
 2690: 
 2691: 
 2692:    const int MAX_ITERATIONS = 1000; 
 2693:    Element* nextElem = curElem;
 2694:    int iter = 0;
 2695:    while(true) {
 2696: 
 2697:       // Calculate timestep
 2698:       double dtb = min(dtbk, time_rm);
 2699: 
 2700:       // Next point in the backtracking curve
 2701:       Point3 xt = x0 - dtb*u_int;
 2702:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2703:       assert(found && "Backtracking failed in btrack");
 2704: 
 2705:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2706: 
 2707:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2708:                       // then time_rm needs to be increased by the unused time.
 2709: 
 2710:       // If the velocity is too small, we stop the backtracking
 2711:       const double vmag = length(toVector2(u_int));
 2712:       if (vmag <= velmin_btrack) break;
 2713: 
 2714:       // The current point becomes the next segment's starting point.
 2715:       x0 = xt;
 2716:  
 2717:       curElem = nextElem;
 2718: 
 2719:       iter++;
 2720: if (iter>100) printf("@@@@@@@@@@@@@@@@ isdry = %d, idx = %d, n1->idx = %d, n2->idx = %d, iter = %d, x0 = %.17g, %.17g, %.17g, xt = %.17g, %.17g, %.17g\n", curElem->isDry, idx, n1->idx, n2->idx, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 2721:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2722:    }
 2723: 
 2724: 
 2725: }
 2726: 
 2727: 
