 6062:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6063: 
 6064:       NODE(node);
 6065: 
 6066:       node->ETP = 0.0;
 6067: 
 6068:       if constexpr(ntip == 0) return;
 6069: 
 6070:       // For all tidal potential components
 6071:       for (int j=0; j<ntip; j++) {
 6072: 
 6073:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6074: 
 6075:          node->ETP += nodeETP;
 6076: 
 6077:          if constexpr(iloadtide==1) { // loading tide
 6078:             assert(false && "Loading tide not implemented");
 6079:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6080:          }
 6081:          
 6082:       }
 6083: 
 6084:      
 6085:    }
