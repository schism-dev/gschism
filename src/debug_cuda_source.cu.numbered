 4273:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4274: 
 4275:       NODE_BND(nodeBnd);
 4276: 
 4277:       Node *node = nodeBnd->node;
 4278: 
 4279:       node->ETP = 0.0;
 4280: 
 4281:       for (int j=0; j<ntip; j++) {
 4282: 
 4283:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4284:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4285: printf("RAAAAMP  ramp = %f, arg = %f\n", ramp, arg);         
 4286:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4287: 
 4288:          if constexpr(iloadtide==1) { // loading tide
 4289:             assert(false && "Loading tide not implemented");
 4290:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4291:          }
 4292:          
 4293:       }
 4294:       
 4295:    }
