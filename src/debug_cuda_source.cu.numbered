  612: struct Element {
  613: 
  614:    // Geometry information
  615:    int idx;                   // Index of the element
  616:    int i34;                   // Number of sides for the element 
  617:    Side *sides[4];            // Sides of the element
  618:    Node *nodes[4];            // Nodes of the element
  619:    Element *nghbElems[4];     // Neighbors of the element
  620: 
  621:    int kb;                    // Bottom index of the element
  622:    double area;               // Area of the element
  623:    double ssign[4];           // Sign associated with each side of an element
  624:    double radius;             // Element equivalent radii
  625: 
  626:    #ifdef USE_FRAMES
  627:    Frame frame;
  628:    #endif
  629: 
  630:    Vector2 gradPhi[4];        // Derivatives of shape functions
  631:    Vector2 gradEta;           // Gradient of free surface elevation
  632:    Vector2 gradPr;            // Gradient of pressure    
  633:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  634: 
  635:    bool isDry;                // True if the element is dry
  636: 
  637:    Point2 center;            // Element center coordinates
  638: 
  639: 
  640:    double depth;              // Depth at element (min of all nodes)
  641:    double z[nvrt];            // z-coord  (local frame - vertical up)
  642: 
  643:    // Physical information
  644:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  645: 
  646:    static const bool isblock = false;              // Always false
  647: 
  648:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  649:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  650: 
  651:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  652:    
  653: 
  654:    double vsource;            // Volumetric source/sink term [m^3/s]
  655: 
  656:    double rho[nvrt];          // Density at each prism center
  657:    double rho_mean[nvrt];     // Mean density at each prism center
  658:    CubicSpline rho_spl;
  659:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  660:    double rho_z[nvrt];        // First derivative of density at each prism center
  661:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  662:    
  663: 
  664:    __inline__ __device__ Point2 outputCoords(void) const;
  665: 
  666:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  667: 
  668:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  669:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  670: 
  671:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  672:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  673: 
  674:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  675:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  676:       // Find the local index of the node in the element (0,1,2,3)
  677:       int res = __ffs((nodes[0] == node) | 
  678:                      ((nodes[1] == node) << 1) | 
  679:                      ((nodes[2] == node) << 2) | 
  680:                      ((nodes[3] == node) << 3)) - 1;
  681:       
  682:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  683:       return res;  
  684:    }
  685: 
  686:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  687:       // Find the local index of the side in the element (0,1,2,3)
  688:       int res = __ffs((sides[0] == side) | 
  689:                      ((sides[1] == side) << 1) | 
  690:                      ((sides[2] == side) << 2) | 
  691:                      ((sides[3] == side) << 3)) - 1;
  692:       
  693:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  694:       return res;
  695:    }
  696: 
  697:    __inline__ __device__ int findLevel(double z1, int k) const {
  698:       // Starting at index k, find sequentially the level that contains z
  699: 
  700:       // For testing purposes, forgets k and performs a full search.
  701:       for (k = kb; k < nvrt - 1; k++) {
  702:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  703:       }
  704:       return nvrt - 2;
  705: 
  706: 
  707:       // if z is already betweeen z[k] and z[k+1], return k
  708:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  709:       else if (z1 <  z[k]) { 
  710:          // Search for increasing levels
  711:          for (int kk = k; kk < nvrt - 1; kk++) {
  712:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  713:          }
  714:          return nvrt - 1;
  715:       }
  716:       else {
  717:          // Search for decreasing levels
  718:          for (int kk = k; kk >= kb; kk--) {
  719:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  720:          }
  721:          return 0;
  722:       }
  723:    }
  724: 
  725:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  726:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  727: 
  728: 
  729:    __device__ __forceinline__ double centerZ(void) const;
  730: 
  731:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  732:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  733:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  734:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  735:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  736: 
  737: 
  738:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  739:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  740:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  741:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  742:        const double eta = (idxNode & 1) ? +g : -g;
  743:        const double xi  = (idxNode & 2) ? +g : -g;
  744:        return {eta, xi};
  745:    }  
  746: 
  747:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  748:    __device__ __forceinline__ double etaSign(int idxNode) const {
  749:       // bit1: 0 -> -1, 1 -> +1
  750:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  751:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  752:    }
  753: 
  754:    __device__ __forceinline__ double xiSign(int idxNode) const {
  755:       // +1 if (bit0 XOR bit1), else -1
  756:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  757:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  758: 
  759:    }
  760: 
  761:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  762:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  763:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  764:    }
  765: 
  766:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  767:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  768:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  769:    }   
  770: 
  771:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  772:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  773:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  774:    }      
  775:    
  776:    __inline__ __device__ double detJ_eta(void) const;
  777: 
  778:    __inline__ __device__ double detJ_xi(void) const;
  779: 
  780:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  781: 
  782:    // Check if the element is dry using the more up-to-date elevation.
  783:    __inline__ __device__ bool isDry2(void) const;
