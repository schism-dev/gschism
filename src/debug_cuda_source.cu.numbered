 2080: 
 2081: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2082: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2083: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2084: // Only when ics == 2, the origin is at the element center.
 2085: 
 2086:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2087: 
 2088:    const Node *node = nodes[idxNode];
 2089: 
 2090:    if constexpr(ics==1) {
 2091:       return node->p;
 2092: 
 2093:    } else {
 2094:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2095: 
 2096:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2097: 
 2098:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2099:    }
 2100: 
 2101: }
 2102: 
 2103: 
 2104: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2105: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2106: 
 2107:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2108: 
 2109:    const int id1 = idx;
 2110:    const int id2 = nxq(1 + id1);
 2111:    const int id3 = nxq(2 + id1);
 2112: 
 2113:    if constexpr(ics==1) {
 2114:       x0 = nodes[id1]->p;
 2115:       x1 = nodes[id2]->p;
 2116:       x2 = nodes[id3]->p;
 2117: 
 2118:    } else {
 2119:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2120: 
 2121:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2122:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2123:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2124: 
 2125:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2126:       x1 = toVector2(frame.G2L(p1 - c));
 2127:       x2 = toVector2(frame.G2L(p2 - c));
 2128: 
 2129:    }
 2130: 
 2131: }
 2132: 
 2133: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2134: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2135: 
 2136:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2137: 
 2138:    if constexpr(ics==1) {
 2139:       x0 = nodes[0]->p;
 2140:       x1 = nodes[1]->p;
 2141:       x2 = nodes[2]->p;  
 2142:       x3 = nodes[3]->p;
 2143: 
 2144:    } else {
 2145:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2146: 
 2147:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2148:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2149:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2150:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2151: 
 2152:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2153:       x1 = toVector2(frame.G2L(p1 - c));
 2154:       x2 = toVector2(frame.G2L(p2 - c));
 2155:       x3 = toVector2(frame.G2L(p3 - c));
 2156:    }
 2157: 
 2158: }
