 2321: 
 2322: /**
 2323:  * Find the element that contains the target point.
 2324:  * 
 2325:  * @param x0,y0,z0     Starting position coordinates
 2326:  * @param xt,yt,zt     Target position coordinates
 2327:  * @param dtb          Time step for tracking
 2328:  * @param u_int        Initial velocity components
 2329:  * @param nextElem     Starting/resulting element index
 2330:  * 
 2331:  * @return Status code of type trackExitCodes
 2332:  * 
 2333:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2334:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2335:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2336:  * as close the the segment AB as possible, the next point at each iteration is computed
 2337:  * along segment AB, but just after the current element.
 2338:  */
 2339: 
 2340: 
 2341: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2342: 
 2343:    constexpr int MAX_ITERATIONS = 40;
 2344: 
 2345:    int iter = 0;
 2346:    double fac = 0.00001;
 2347:    while (iter < MAX_ITERATIONS) {
 2348:       iter++;
 2349: 
 2350:       Bool4 isLeft, isObtuse, isBisector;
 2351:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2352: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2353:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2354: 
 2355: 
 2356:       if (isValid.none()) 
 2357:       // Inside the element if none of the edges is a valid continuation
 2358:       {
 2359:          // Just returns true and the element (curElem) is unchanged).
 2360:          // This means that the algorithm has found the element that contains the target point.
 2361:          return true;
 2362:       }
 2363:       else { // Outside the element
 2364: 
 2365:          // Outside this element. Pick the first valid exit side and cross.
 2366:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2367:          Element *prevElem = curElem;
 2368:          curElem = lastCrossSide->otherElem(curElem);
 2369: 
 2370:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2371:          // along the boundary.
 2372:          if (curElem == nullptr || curElem->isDry) {
 2373:          
 2374:             curElem = prevElem;
 2375:             return false;
 2376:          }
 2377:          
 2378:       }
 2379: 
 2380:    }
 2381: 
 2382:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2383: }
 2384: 
