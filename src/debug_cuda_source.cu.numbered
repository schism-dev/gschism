 4000: 
 4001: __device__ __forceinline__ double Node::compZCoord(int k) const {
 4002:    // Computes the z coordinate at level k.
 4003:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 4004:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 4005:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 4006:    // used 
 4007: 
 4008:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 4009:    
 4010:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 4011: 
 4012:    if (isDry2()) return 0.0;  
 4013: 
 4014:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 4015: 
 4016:    if constexpr(ivcor == 2) {
 4017: 
 4018:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 4019:       const double h_c = mesh->h_c;
 4020:       const double theta_f = mesh->theta_f;
 4021:       const double sinh_theta_f = mesh->sinh_theta_f;
 4022: 
 4023: 
 4024:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 4025:       // The FORTAN code computes it every time this function is called, but it should be done only 
 4026:       // once per time step/node. XXXX
 4027:       // CHECK: updateZCoordData
 4028: 
 4029:       //  To simplify comparisons, I define index versions of count variables.
 4030:       if      (k == ivrt)     return eta2; 
 4031:       else if (k == izlev)    return -hmod2;
 4032:       else if (k == kb)       return -depth;
 4033:       else if (k < izlev)     return mesh->ztot[k];
 4034:       else if (k > izlev) {
 4035:          const int ksig = k - izlev;
 4036: 
 4037:          if (hmod2 <= h_c) {
 4038:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 4039: 
 4040:          } 
 4041:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 4042:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 4043:             assert(false && "compZCoord: invalid h_c\n");
 4044:          } 
 4045:          else {
 4046:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 4047:                    h_c * mesh->sigma[ksig] + 
 4048:                    (hmod2 - h_c) * mesh->cs[ksig];
 4049:          }
 4050:       } else { 
 4051:          assert(false && "compZCoord: invalid level or coordinate system\n");
 4052:       }
 4053: 
 4054:    }
 4055:    else {  // if constexpr(ivcor == 1)
 4056:       if (k <= kb)        return -depth; 
 4057:       else if (k == ivrt) return eta2;
 4058:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 4059: 
 4060:    }
 4061:    
 4062:    assert(false && "compZCoord: invalid level or coordinate system\n");
 4063:    return 0.0;
 4064: }
 4065: 
 4066: 
 4067: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 4068:    // Computes the bottom drag Cd based on the selected nchi
 4069: 
 4070:    if constexpr(nchi == 0) {
 4071:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 4072:       Cd = drag;  // Read from drag file
 4073: 
 4074:    } else if constexpr(nchi == 1) {
 4075:       // 
 4076: 
 4077:       bool ltmp = false; // for WBL iteration
 4078: 
 4079:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4080:       if (isDry || (rough == 0.0)) {
 4081:          Cd = 0.0;
 4082: 
 4083:       } else { //roughness >0 
 4084:          
 4085:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4086: 
 4087:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4088: 
 4089:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4090: 
 4091:       } // if rough
 4092: 
 4093:    } else if constexpr(nchi == -1) {
 4094:    // Manning 
 4095:  
 4096:       const double htot = max(hmin_man, htot2()); 
 4097:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4098: 
 4099:    } else {
 4100:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4101:       
 4102:    } // if nchi
 4103: 
 4104: }
 4105: 
 4106: 
 4107: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4108:    // Checks if a side in on the boundary
 4109:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4110: 
 4111:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4112:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4113: 
 4114:    // Indices of the nodes that form the side
 4115:    //
 4116:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4117:    const int n1 = side.n1->idx;
 4118:    const int n2 = side.n2->idx;
 4119:    isLand = false;
 4120:    
 4121: 
 4122:    // Check if the side is on a land boundary
 4123:    for (int i = 0; i < nland; i++) {
 4124:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4125:          // Consecutive nodes in the land boundary segment
 4126:          const int b1 = ilnd[i + j*nland];
 4127:          const int b2 = ilnd[i + (j + 1)*nland];
 4128: 
 4129:          assert(b1 != -1 && b2 != -1);
 4130: 
 4131:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4132:             
 4133:             isLand = true;
 4134:             return i;
 4135:          }
 4136:       }
 4137:    }
 4138: 
 4139:    // Check if the side is on an open boundary
 4140:    for (int i = 0; i < nope; i++) {
 4141:       for (int j = 0; j < nond[i] - 1; j++) {
 4142:          // Consecutive nodes in the open boundary segment
 4143:          const int b1 = iond[i + j*nope];
 4144:          const int b2 = iond[i + (j + 1)*nope];
 4145: 
 4146:          assert(b1 != -1 && b2 != -1);
 4147: 
 4148:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4149:             isLand = false;
 4150:             return i;
 4151:          }
 4152:       }
 4153:    }
 4154: 
 4155: 
 4156:    return -1;
 4157: }
 4158: 
 4159: 
 4160: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4161:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4162:                                     double *wind_rotate_angle, 
 4163:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4164:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4165:                                     int16_t *nodePermutationSort, double *crs_data,
 4166:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4167:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4168:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4169:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4170:                                     double *drag, double *roughness, double *rmanning, 
 4171:                                     double *diffmin, double *diffmax,
 4172:                                     double *temp, double *salt,
 4173:                                     int *kb, double *localSigma) {
 4174: 
 4175:    NODE(pnode);  
 4176:    const int i = idx_node;
 4177:    const int iglobal = globalNodeIndices[i];
 4178:    Node &node(*pnode);
 4179: 
 4180:    node.idx = iglobal;
 4181:    node.part = localNodePart[iglobal];
 4182: 
 4183:    // It is important to differentiate between the global and local "start" indices because they
 4184:    // play different, but related, roles in this code. The global "start" indices are used
 4185:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4186:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4187:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4188:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4189:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4190:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4191:    node.numNodes = idxNodeEnd - idxNodeStart;
 4192:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4193: 
 4194:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4195:    node.coeffRow = crs_data + rowStart; 
 4196: 
 4197:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4198: 
 4199: 
 4200: 
 4201:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4202:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4203:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4204:    node.numElements = idxElemEnd - idxElemStart;
 4205:    node.elements = nodeNeighElems + idxElemLocalStart;
 4206: 
 4207: 
 4208:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4209:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4210:       const int partNode = localNodePart[idxNodeGlobal]; 
 4211:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4212: 
 4213:       Node *node_ptr = nodes[partNode] + idxNode;
 4214:       
 4215:       nodeNeighNodes[idxLocal] = node_ptr;
 4216:    }
 4217: 
 4218: 
 4219:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4220:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4221:       const int partElem = localElemPart[idxElemGlobal];
 4222:       const int idxElem  = localElemIndices[idxElemGlobal];
 4223: 
 4224:       Element *elem_ptr = elems[partElem] + idxElem;
 4225: 
 4226:       nodeNeighElems[idxLocal] = elem_ptr;
 4227:    }      
 4228: 
 4229:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4230:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4231: 
 4232:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4233: 
 4234:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4235:    if constexpr(ics == 1) {
 4236:       node.p.x   = node_coords[i * 3];
 4237:       node.p.y   = node_coords[i * 3 + 1];
 4238:       node.gz = 0.0;
 4239: 
 4240:       if (use_ll) {                                    // <-- add
 4241:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4242:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4243:       }  
 4244: 
 4245:    } else {
 4246:       const double lon = deg2rad*node_coords[i * 3];
 4247:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4248: 
 4249:       Point3 p = computeXYZfromLatLon(lat, lon);
 4250:       node.p = toVector2(p);
 4251:       node.gz = p.z;
 4252:       node.lon = lon;
 4253:       node.lat = lat;
 4254: 
 4255:       #ifdef USE_FRAMES
 4256:       node.setFrame(lat, lon);
 4257:       #endif
 4258: 
 4259: 
 4260:    }
 4261: 
 4262:    node.depth = node_coords[i * 3 + 2];
 4263: 
 4264:    node.numSides = 0;
 4265: 
 4266:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4267:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4268:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4269:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4270:    else assert(false && "populateNodes: selected nchi not implemented.");
 4271: 
 4272:    // Populate the diffmin and diffmax values read from the files.
 4273:    // (Only used for GLS, GOTM, and SedimentMix.)
 4274:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4275: 
 4276:    // Cold-start T,S: vertically homogeneous nodal I.C. (temp.ic/salt.ic or barotropic constants).
 4277:    // tr0 keeps the initial field (e.g. type-3 open BC); tracers is the working nodal state.
 4278:    {
 4279:       const double t0 = temp[iglobal];
 4280:       const double s0 = salt[iglobal];
 4281:       for (int k = 0; k < nvrt; k++) {
 4282:          node.tr0[k].tracer[0]     = t0;
 4283:          node.tr0[k].tracer[1]     = s0;
 4284:          node.tracers[k].tracer[0] = t0;
 4285:          node.tracers[k].tracer[1] = s0;
 4286:       }
 4287:    }
 4288: 
 4289:    if constexpr(ivcor == 1) 
 4290:    {  
 4291:       node.kb = kb[iglobal];
 4292: 
 4293:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4294:    }
 4295: 
 4296:    for (int k = 0; k < nvrt; k++) {
 4297:       node.rho[k] = rho0;
 4298:       node.z[k] = -1e20;
 4299:    }
 4300: 
 4301:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4302:    node.turb.init(&node);
 4303: 
 4304:    
 4305:    // Links the node to the boundary information
 4306:    if (isbnd[iglobal] >= 0) {
 4307:      
 4308:       // Get the index of the node boundary
 4309:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4310: 
 4311:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4312:       node.nodeBnd->node = &node;
 4313: 
 4314:       node.nodeBnd->sideBnd1 = nullptr;
 4315:       node.nodeBnd->sideBnd2 = nullptr;
 4316: 
 4317:       if (isbnd[iglobal]>=0) {
 4318: 
 4319:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4320:          
 4321:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4322:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4323: 
 4324:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4325:          node.nodeBnd->segment->clen  = nan("1");
 4326:          node.nodeBnd->segment->carea = nan("1");
 4327: 
 4328:       }
 4329:    } else {
 4330: 
 4331:       node.nodeBnd = nullptr; // For internal nodes
 4332: 
 4333:       if (isbnd[iglobal] == landSegment) {
 4334:          node.nodeBnd = landBoundaryNode;
 4335:          node.nodeBnd->segment = landBoundarySegment;
 4336:       }
 4337:       
 4338:    }
 4339:    
 4340:    // XXXX GAUSSIAN HILL VELOCITIES
 4341:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4342:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4343:          constexpr double rot_per = 3000.0;
 4344:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4345:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4346:       // XXXXX
 4347:    #endif
 4348: 
 4349: }
 4350: 
 4351: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4352:    
 4353:    NODE(node);
 4354:    const int localIdx = idx_node;
 4355: 
 4356: 
 4357:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4358:    int16_t *csrSlot = node->csrSlot;  
 4359: 
 4360:    // Simply count the number of nodes with a smaller global index than the current node.
 4361:    // It accounts for the diagonal element.
 4362:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4363:    // local index, but taking into account all the partitions (in order).
 4364:    for (int i = 0; i < node->numNodes; ++i) {
 4365:       const int col = node->nodes[i]->packedIndex();
 4366:       int16_t idx = 0;
 4367: 
 4368:       //Takes care of the diagonal element.
 4369:       if (node->packedIndex() < col) ++idx;          
 4370: 
 4371:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4372:       csrSlot[i] = idx;
 4373:    }
 4374: 
 4375:    // Find the diagonal element in the CRS matrix.
 4376:    int16_t idxDiag = 0;
 4377:    for (int j = 0; j < node->numNodes; ++j)
 4378:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4379: 
 4380:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4381: 
 4382:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4383:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4384: 
 4385:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4386:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4387:    crs_indptr[localIdx] = rowStart;
 4388: 
 4389:    // Fills crs_indices array using the per-partition indexing.
 4390:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4391:    crs_indices[rowStart + d] = node->packedIndex();  
 4392:    for (int j = 0; j < node->numNodes; ++j) {
 4393:       Node *nb = node->nodes[j];
 4394:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4395:    }
 4396: 
 4397: 
 4398: }
 4399: 
 4400: 
 4401: 
 4402: 
 4403: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4404:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4405:                                     double *wind_rotate_angle,   
 4406:                                     int *isdel, int *isidenode, int *isbnd,
 4407:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4408:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4409:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4410:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4411:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4412:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4413:                                     double *drag, double *roughness) {
 4414: 
 4415: 
 4416:    SIDE(pside);
 4417:    Side &side(*pside);
 4418:    const int i = idx_side;
 4419:    const int iglobal = globalSideIndices[i];
 4420:    side.idx = iglobal;  
 4421:    
 4422:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4423:    const double fc   = 2.0*omega_e*sin(sfea0);
 4424:    const double beta = 2.0*omega_e*cos(sfea0);
 4425: 
 4426:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4427: 
 4428:    // finding the pointer to the nodes that form the side
 4429:    const int idx_n1 = isidenode[iglobal*2];
 4430:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4431: 
 4432: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4433: 
 4434:    const int locidx_n1 = localNodeIndices[idx_n1];
 4435:    const int locidx_n2 = localNodeIndices[idx_n2];
 4436:    const int part_n1 =   localNodePart[idx_n1];
 4437:    const int part_n2 =   localNodePart[idx_n2];
 4438: 
 4439: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4440: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4441: 
 4442:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4443:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4444: 
 4445: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4446: 
 4447:    // Counts the number of sides connected to each node
 4448:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4449:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4450: 
 4451:    // Side boundary type
 4452:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4453:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4454: // if (i == 0) printf("populateSides: 2\n");
 4455: 
 4456:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4457:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4458:    {
 4459:       bool isLand = false;
 4460:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4461:       
 4462:       if (isbs > -1) {
 4463:          // assert(isLand || isbs>=0);
 4464:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4465: 
 4466:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4467: 
 4468:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4469:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4470: 
 4471:          assert (isLand == side.sideBnd->segment->isLand);
 4472:          
 4473:          side.sideBnd->side = &side;
 4474: 
 4475:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4476:          n1bnd->linkSideBoundary(side.sideBnd);
 4477:          n2bnd->linkSideBoundary(side.sideBnd);
 4478: 
 4479:       }
 4480:       else {
 4481:          side.sideBnd = nullptr;
 4482:       }
 4483:    }
 4484:    else 
 4485:    {
 4486:       side.sideBnd = nullptr;
 4487:    }
 4488: 
 4489: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4490: 
 4491:    // finding the pointer to the elements that share the side
 4492:    const int idx_e1 = isdel[iglobal*2];
 4493:    const int idx_e2 = isdel[iglobal*2 + 1];
 4494: 
 4495:    if (idx_e1 > -1) {
 4496:       const int locidx_e1 = localElemIndices[idx_e1];
 4497:       const int part_e1 =  localElemPart[idx_e1];
 4498:       side.elems[0] = elems[part_e1] + locidx_e1;
 4499: 
 4500:    }
 4501:    else {
 4502:       side.elems[0] = nullptr;
 4503:    }
 4504: 
 4505: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4506: 
 4507:    if (idx_e2 > -1) {
 4508:       const int locidx_e2 = localElemIndices[idx_e2];
 4509:       const int part_e2 =  localElemPart[idx_e2];
 4510:       side.elems[1] = elems[part_e2] + locidx_e2;
 4511:    }
 4512:    else {
 4513:       side.elems[1] = nullptr;
 4514:    }
 4515: 
 4516: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4517: 
 4518:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4519:       
 4520:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4521:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4522:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4523:          
 4524:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4525:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4526:       // printf("sideBnd: %p\n", side.sideBnd);
 4527:       // assert(false && "Side has no elements and no boundary");
 4528:    }
 4529:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4530: 
 4531:    // Compute the center of the side
 4532:    side.center = 0.5*(side.n1->p + side.n2->p);
 4533: 
 4534:    #ifdef USE_FRAMES
 4535:    side.setFrame();
 4536:    #endif
 4537: 
 4538: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4539: 
 4540:    // Normal, unitary vector to the side
 4541:    if constexpr(ics == 1) {
 4542:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4543:       side.n = normalize(side.n);
 4544:    }
 4545:    else {
 4546:       // Unit side vector in 3D cartesian coordinates
 4547:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4548: 
 4549:       nSide = normalize(nSide);
 4550: 
 4551:       // Its cross product with the unit local z-axis vector (nUp) is the
 4552:       // normal vector we are looking for.
 4553:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4554: 
 4555:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4556:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4557:       side.n = -normalize(n2D); 
 4558: 
 4559:    }
 4560: 
 4561: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4562: 
 4563:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4564:    side.shapiro = shapiro0;
 4565: 
 4566:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4567:    // XXXX
 4568:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4569:    constexpr double rot_per=3000.0;
 4570:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4571:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4572:    // XXXXX      
 4573:    #endif
 4574:    // Compute the z level at the center of the side
 4575:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4576:    
 4577:    // Compute the length of the side
 4578:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4579: 
 4580: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4581: 
 4582:    // Compute the Coriolis coefficient
 4583: 
 4584:    if constexpr(ncor == -1 || ncor == 0) {
 4585:       side.coriolis = coricoef;
 4586:    }
 4587:    else {
 4588:       const double sphi = side.lat();  // Latitude at the center of the side
 4589: 
 4590:       assert(use_ll && "use_ll must be true when ncor > 0");
 4591: 
 4592:       if constexpr(ics == 1) {
 4593:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4594:       }
 4595:       else { // ics == 2
 4596:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4597:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4598:       }
 4599: 
 4600:    }
 4601: 
 4602: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4603: 
 4604: }
 4605: 
 4606: 
 4607: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4608:    double *node_coords, double *node_coords_ll, bool use_ll,
 4609:    double *wind_rotate_angle,   
 4610:    int *isdel, int *isidenode, int *isbnd,
 4611:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4612:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4613:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4614:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4615:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4616:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4617:    double *drag, double *roughness) {
 4618: 
 4619:    ELEM(pelem);
 4620:    Element &elem(*pelem);
 4621:    const int i = idx_elem;
 4622: 
 4623:    elem.idx = i;
 4624: 
 4625:    for (int j = 0; j < i34[i]; j++) {
 4626:       const int idxNode = elnode[i*4 + j];  
 4627:       const int idxSide = elside[i*4 + j];
 4628:       
 4629:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4630:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4631: 
 4632:       // Find the neighboring element  
 4633:       if (elem.sides[j]->elems[0] == &elem) {
 4634:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4635:       }
 4636:       else {
 4637:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4638:       }
 4639:       
 4640:    }
 4641: 
 4642:    elem.i34 = i34[i];
 4643: 
 4644:    // Compute the barycenter of the element and its depth
 4645:    elem.center = {0.0, 0.0};
 4646:    elem.depth = 1e10;
 4647:    for (int j = 0; j < i34[i]; j++) {
 4648: 
 4649:       elem.center += elem.nodes[j]->p/i34[i];
 4650:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4651:    }
 4652: 
 4653:    #ifdef USE_FRAMES
 4654:    elem.setFrame();
 4655:    #endif
 4656: 
 4657:    elem.area = elem.computeSignedArea(); 
 4658:    elem.radius = sqrt(elem.area)/pi; 
 4659:    
 4660:    // Determines which way the normal vector to each side is oriented.
 4661:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4662:    for (int j = 0; j < i34[i]; j++)  
 4663:    {
 4664:       if (elem.sides[j]->elems[0] == &elem) {
 4665:          elem.ssign[j] =  1.0;
 4666:       }
 4667:       else {
 4668:          elem.ssign[j] = -1.0;
 4669:       }
 4670: 
 4671:    }
 4672: 
 4673:   
 4674: 
 4675:    // Derivatives of shape functions
 4676:    //  For ics=2, this is done in the element frame
 4677:    //  For quads, the derivative is evaluated at centroid
 4678:    for (int j = 0; j < elem.i34; j++) {
 4679:       const double area = elem.area;
 4680:       const int id2 = elem.nxq(1 + j);
 4681:       const int id3 = elem.nxq(2 + j);
 4682:       const int id4 = elem.nxq(3 + j);
 4683:       if (elem.isTri()) {
 4684:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4685:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4686:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4687:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4688:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4689:          // And so on for the other shape functions.
 4690: 
 4691:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4692:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4693:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4694: 
 4695:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4696:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4697: 
 4698:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4699: 
 4700:       }
 4701:       else  { // Quad, the derivatives are evaluated at the centroid
 4702: 
 4703:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4704:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4705:          // ...
 4706:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4707: 
 4708:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4709:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4710:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4711: 
 4712:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4713:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4714: 
 4715:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4716: 
 4717:       } // if Tri/Quad
 4718: 
 4719:    } // for j   
 4720: 
 4721:    // Initial element tracers: average surrounding nodal I.C. (levels k and k-1)
 4722:    // For level k: average of node values at k and k-1 over the element nodes.
 4723:    // Level 0 copies level 1 (Fortran tr_el(:,1)=tr_el(:,2)).
 4724:    const double inv = 1.0 / (2.0 * elem.i34);
 4725:    for (int k = 1; k < nvrt; k++) {
 4726:       Tracers sum = {};
 4727:       for (int j = 0; j < elem.i34; j++) {
 4728:          const Node *nd = elem.nodes[j];
 4729:          for (int itr = 0; itr < ntracers; itr++)
 4730:             sum.tracer[itr] += nd->tr0[k].tracer[itr] + nd->tr0[k - 1].tracer[itr];
 4731:       }
 4732:       for (int itr = 0; itr < ntracers; itr++)
 4733:          elem.tracers[k].tracer[itr] = inv * sum.tracer[itr];
 4734:    }
 4735:    elem.tracers[0] = elem.tracers[1];
 4736: 
 4737: }
 4738: 
 4739: 
 4740: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4741:                                             double *emo, double *efa, 
 4742:                                             double *umo, double *ufa, 
 4743:                                             double *vmo, double *vfa,
 4744:                                             int *ifltype, int *iettype, 
 4745:                                             double *qthcon, double *eth) {
 4746: 
 4747:    NODE_BND(nodeBnd);
 4748:    const int idx = idx_node_bnd;    
 4749: 
 4750:    nodeBnd->idx = idx;
 4751: 
 4752:    // Need to find the segment index and the index of the node on the segment
 4753:    int idxNode = -1;
 4754:    int iseg, i;
 4755:    for (iseg = 0; iseg < nope; iseg++) {
 4756:       // for each segment...
 4757:       for (i = 0; i < nond[iseg]; i++) {
 4758:          idxNode = iond[iseg + i*nope];
 4759:          if (idxNode == nodeBnd->node->idx) 
 4760:          {
 4761:             // This is done for every segment that the node is part of, overwriting the previous values.
 4762:             // The result is that the segment with the highest index is the one that is used.
 4763:             nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4764:             nodeBnd->elbc = 0.0;
 4765: 
 4766:             // XXXXXX This may make more sense in populateBoundarySides.
 4767:             nodeBnd->segment->ifltype = ifltype[iseg];
 4768:             nodeBnd->segment->iettype = iettype[iseg];
 4769:             nodeBnd->segment->qthcon  = qthcon[iseg];
 4770:             nodeBnd->segment->eth     = eth[iseg];
 4771:             nodeBnd->eth     = eth[iseg]; // XXXXXXX Is this always needed? ot only for certain ietype?
 4772:             nodeBnd->segment->idx = iseg;
 4773: 
 4774:             for (int jfr = 0; jfr < nbfr; jfr++) {
 4775: 
 4776:                const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4777: 
 4778:                nodeBnd->efa[jfr] = efa[idx2];
 4779:                nodeBnd->emo[jfr] = emo[idx2];
 4780: 
 4781:             }
 4782:          }         
 4783:       }
 4784:    }
 4785: 
 4786: 
 4787:    assert(iseg <= nope && "iseg is out of bounds");
 4788: 
 4789: 
 4790: 
 4791: 
 4792:         
 4793: 
 4794: }
 4795: 
 4796: __device__ void Mesh::populateBoundarySides(int *nond, int *iond,
 4797:                                             double *emo, double *efa, 
 4798:                                             double *umo, double *ufa, 
 4799:                                             double *vmo, double *vfa,
 4800:                                             int *ifltype, int *iettype, double *qthcon) {
 4801: 
 4802:    SIDE_BND(sideBnd);
 4803: 
 4804:    const Side *side = sideBnd->side;
 4805: 
 4806: 
 4807:    // Indices of the nodes on the side 
 4808:    const int n1 = side->n1->idx;
 4809:    const int n2 = side->n2->idx;
 4810: 
 4811:    const int iseg = sideBnd->segment->idx;
 4812: 
 4813:    // Find the index of the side in the segment data array.
 4814:    for (int i = 0; i < nond[iseg] - 1; i++) {
 4815: 
 4816:       // Indices of the nodes at both ends of the side (obtained from the boundary node list)
 4817:       const int b1 = iond[iseg + i*nope];
 4818:       const int b2 = iond[iseg + (i + 1)*nope];
 4819: 
 4820:       // Find the side that connects the two nodes by comparing the indices of the nodes at both ends of the side (computed from 
 4821:       // the boundary node list) with the indices of the nodes at the ends of the side (obtained from the side structure).
 4822:       if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4823: 
 4824:          for (int jfr = 0; jfr < nbfr; jfr++) {
 4825:          // For each tidal component...
 4826: 
 4827:             const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4828: 
 4829:             // velocity magnitude at both ends of the side (1,2)            
 4830:             const double umo1 = umo[idx2];
 4831:             const double vmo1 = vmo[idx2];
 4832:             const double umo2 = umo[idx2 + nope];
 4833:             const double vmo2 = vmo[idx2 + nope];
 4834: 
 4835:             // velocity phases at both ends of the side (1,2)
 4836:             const double ufa1 = ufa[idx2];
 4837:             const double vfa1 = vfa[idx2];
 4838:             const double ufa2 = ufa[idx2 + nope];
 4839:             const double vfa2 = vfa[idx2 + nope];
 4840: 
 4841:             // These expressions compute the amplitude and phase of the velocity components at the center of the side.
 4842:             // The expressions replicate SCHISM by computing equivalent amplitude and phase for the velocity components at the center of the side.
 4843:             // Equivalent to SCHISM: average of the two reconstructed node tides
 4844:             //   0.5 * (a1*cos(theta - phi1) + a2*cos(theta - phi2))
 4845:             // with theta = amig*t + face. Folded here into one (umo, ufa) per
 4846:             // frequency so the step only does ramp*ff*umo*cos(theta - ufa).
 4847:             // Fortran keeps both (a, phi) on the nodes and averages after the
 4848:             // cosines; the result is the same.
 4849:             sideBnd->umo[jfr] = {0.5*sqrt(pow<2>(umo1) + pow<2>(umo2) + 2*umo1*umo2*cos(ufa1 - ufa2)), 0.5*sqrt(pow<2>(vmo1) + pow<2>(vmo2) + 2*vmo1*vmo2*cos(vfa1 - vfa2))};
 4850:             sideBnd->ufa[jfr] = {atan2(umo1*sin(ufa1) + umo2*sin(ufa2), umo1*cos(ufa1) + umo2*cos(ufa2)), atan2(vmo1*sin(vfa1) + vmo2*sin(vfa2), vmo1*cos(vfa1) + vmo2*cos(vfa2))};
 4851: 
 4852:          } // for jfr
 4853: 
 4854:       }
 4855:    }
 4856: 
 4857: 
 4858: }
 4859: 
 4860: __device__ void Mesh::populateBoundarySideLinks(void) {
 4861: 
 4862:    SIDE_BND(sideBnd);
 4863: 
 4864:    const Side *side = sideBnd->side;
 4865: 
 4866:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4867:    // and the rightSide is the side s that has s->n1 == side->n2
 4868:    for (int i = 0; i < mesh->nbs; i++) {
 4869: 
 4870:       Side *s = &mesh->localSideData[i];
 4871: 
 4872:       if (s == side) continue;  // Do not link the side to itself
 4873:    
 4874:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4875:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4876:    }
 4877: 
 4878:   
 4879: }
