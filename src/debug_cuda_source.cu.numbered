 1129: // This struct is used to store the boundary information for a node.
 1130: struct NodeBoundary {   
 1131:    int idx;
 1132:    BoundarySegment *segment;
 1133:    Node *node;
 1134:    
 1135:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1136:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1137: 
 1138:    bool isLand;
 1139: 
 1140:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1141:    double elbc;   // Elevation boundary condition
 1142:    double eth;    // Elevation time history
 1143: 
 1144:    double eta_mean; // Mean elevation at nodes
 1145: 
 1146:    bool isEssentialBC;
 1147: 
 1148:    Vector2 uth[nvrt];  // "Time history" velocity
 1149: 
 1150:    // Arrays for harmonic constituents (if needed)
 1151:    double  emo[nbfr];  // Elevation amplitude
 1152:    double  efa[nbfr];  // Elevation phase
 1153:    Vector2 umo[nbfr];  // velocity amplitude
 1154:    Vector2 ufa[nbfr];  // velocity phase
 1155: 
 1156: 
 1157:    NodeBoundary(void) {
 1158:       isLand = false;
 1159:    }
 1160:    NodeBoundary(bool _isLand) {
 1161:       isLand = _isLand;
 1162:    }
 1163: 
 1164:    
 1165:    __forceinline__ __device__ int numSidesForAverage() const {
 1166:    // Returns the number of sides that are connected to the node and have the same segment.
 1167:    // This is used to compute the average velocity at the node for open boundary nodes.
 1168:       int res = 0;
 1169:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1170:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1171: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1172:       return res;
 1173:    }
 1174: 
 1175: 
 1176:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1177:       assert(index == 0 || index == 1); 
 1178:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1179:    }
 1180: 
 1181: 
 1182: };
