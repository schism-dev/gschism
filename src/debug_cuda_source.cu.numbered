 1664:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1665:       // Compute the different time ramps used in the code 
 1666:       // This function is performed by just one thread
 1667: 
 1668:       rampbc = 1.0;
 1669:       if constexpr(ibc == 0) {
 1670:          if (drampbc > 0.0) {
 1671:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1672:          } else {
 1673:             rampbc = 1.0;
 1674:          }
 1675:       }
 1676: 
 1677:       if (nws != 0) {
 1678:          if (drampwind > 0.0) {
 1679:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1680:          } else {
 1681:             rampwind = 1.0;
 1682:          }
 1683:       }
 1684: 
 1685:       if (drampwafo > 0.0) {
 1686:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1687:       } else {
 1688:          rampwafo = 1.0;
 1689:       }
 1690: 
 1691:       // For source/sinks
 1692:       if (if_source && dramp_ss > 0.0) {
 1693:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1694:       } else {
 1695:          ramp_ss = 1.0;
 1696:       }
 1697: 
 1698:       if (dramp > 0.0) {
 1699:          ramp = tanh(2.0*time/86400.0/dramp);
 1700:       } else {
 1701:          ramp = 1.0;
 1702:       }
 1703: 
 1704: 
 1705:    }
