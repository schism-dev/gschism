 1455: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1456:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1457: }
 1458: 
 1459: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1460:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1461: }   
 1462: 
 1463: __device__ __inline__ double min3(double a, double b, double c) {
 1464:    return min(a, min(b, c));
 1465: }
 1466: 
 1467: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1468:    return min(a, min(b, min(c, d)));
 1469: }
