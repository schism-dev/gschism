  449: struct Element {
  450: 
  451:    // Geometry information
  452:    int idx;               // Index of the element
  453:    int i34;               // Number of sides for the element 
  454:    Side *sides[4];        // Sides of the element
  455:    Node *nodes[4];        // Nodes of the element
  456:    Element *nghbElems[4]; // Neighbors of the element
  457: 
  458:    int kb;                    // Bottom index of the element
  459:    double area;               // Area of the element
  460:    double ssign[4];           // Sign associated with each side of an element
  461:    double radius;             // Element equivalent radii
  462: 
  463:    Frame frame;
  464: 
  465:    Vector2 gradPhi[4];       // Derivatives of shape functions
  466:    Vector2 gradEta;          // Gradient of free surface elevation
  467:    Vector2 gradPr;           // Gradient of pressure    
  468:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  469: 
  470:    bool isDry;                  // True if the element is dry
  471:    int kbe;                   // Bottom index of the element
  472: 
  473:    Vector3 center;            // Element center coordinates
  474:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  475:    double depth;              // Depth at element (min of all nodes)
  476:    double z[nvrt];            // z-coord  (local frame - vertical up)
  477: 
  478:    // Physical information
  479:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  480: 
  481:    static const bool isblock = false;              // Always false
  482: 
  483:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  484:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  485: 
  486:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  487: 
  488:    
  489: 
  490:    double vsource;            // Volumetric source/sink term [m^3/s]
  491: 
  492:    double rho[nvrt];          // Density at each prism center
  493:    double rho_mean[nvrt];     // Mean density at each prism center
  494:    CubicSpline rho_spl;
  495:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  496:    double rho_z[nvrt];        // First derivative of density at each prism center
  497:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  498: 
  499:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  500: 
  501:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  502:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  503: 
  504:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  505:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  506: 
  507:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  508:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  509:       // Find the local index of the node in the element (0,1,2,3)
  510:       int res = __ffs((nodes[0] == node) | 
  511:                      ((nodes[1] == node) << 1) | 
  512:                      ((nodes[2] == node) << 2) | 
  513:                      ((nodes[3] == node) << 3)) - 1;
  514:       
  515:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  516:       return res;
  517:    }
  518: 
  519:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  520:       // Find the local index of the side in the element (0,1,2,3)
  521:       int res = __ffs((sides[0] == side) | 
  522:                      ((sides[1] == side) << 1) | 
  523:                      ((sides[2] == side) << 2) | 
  524:                      ((sides[3] == side) << 3)) - 1;
  525:       
  526:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  527:       return res;
  528:    }
  529: 
  530: 
  531:    __inline__ __device__ int findLevel(double z1, int k) const {
  532:       // Starting at index k, find sequentially the level that contains z
  533: 
  534:       // if z is already betweeen z[k] and z[k+1], return k
  535:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  536:       else if (z1 < z[k]) { 
  537:          // Search for increasing levels
  538:          for (int kk = k; kk < nvrt - 1; kk++) {
  539:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  540:          }
  541:          return nvrt - 1;
  542:       }
  543:       else {
  544:          // Search for decreasing levels
  545:          for (int kk = k; kk > 0; kk--) {
  546:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  547:          }
  548:          return 0;
  549:       }
  550:    }
  551: 
  552:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  553:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  554: 
  555:    // Check if the element is dry using the more up-to-date elevation.
  556:    __inline__ __device__ bool isDry2(void) const;
  557: 
  558:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  559: 
  560:    __inline__ __device__ double computeSignedArea(void) const;
  561: 
  562:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  563:       // Nudges the point (x,y) to the barycenter of the element
  564:       p = (1-eps)*p + eps*toVector2(center);
  565:    }
  566: 
  567:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  568: 
  569:    __device__ Vector2 grad2(double *a) const
  570:    {
  571:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  572:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  573:       if (isQuad()) {
  574:          gx += a[3]*gradPhi[3].x;
  575:          gy += a[3]*gradPhi[3].y;
  576:       }
  577:       return {gx, gy};
  578:    }
  579: 
  580:    __device__ Vector2 grad2(double Node::* field) const
  581:    {
  582:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  583:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  584:       if (isQuad()) {
  585:          gx += (nodes[3]->*field)*gradPhi[3].x;
  586:          gy += (nodes[3]->*field)*gradPhi[3].y;
  587:       }
  588:       return {gx, gy};
  589:    }
  590: 
  591:    __device__ void setFrame(void) {
  592: 
  593:       double ar1, ar2;
  594:       computeLonLat(center, ar1, ar2);
  595: 
  596:       frame.update(ar1, ar2);        
  597:     }
  598: 
  599:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  600:                                         double& tIntersect);
  601:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  602:                                         double& tIntersect);
  603: 
  604:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  605:       // Check if the point (xt,yt) is inside the element
  606:       double shpCoords[4];
  607:       bool res = computeShapeCoords(xt, shpCoords, false);
  608:       return res;
  609:    }
  610: 
  611:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  612:    {
  613:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  614:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  615:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  616:       
  617:    }
  618: 
  619:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  620: 
  621:    // ------------------------------------------------------------------------------------------------
  622:    // These are functions that work on all nodes of the element.
  623:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  624:    //
  625:    // An example of how to use these functions is:
  626:    //   
  627:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  628:    // 
  629:    // Where L is the level at which the field is to be interpolated. The field can be either
  630:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  631:    // There are different versions of getNodalValues for each of these cases.
  632: 
  633:    template<typename T>
  634:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  635:       // Get the values of the field at the nodes of the element
  636:       res[0] = nodes[0]->*field;
  637:       res[1] = nodes[1]->*field;
  638:       res[2] = nodes[2]->*field;
  639:       if (isQuad()) res[3] = nodes[3]->*field;
  640:       else          res[3] = T();
  641:    }
  642: 
  643:    template<typename T>
  644:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  645:       // Get the values of the field at the nodes of the element
  646:       res[0] = (nodes[0]->*field)[level];
  647:       res[1] = (nodes[1]->*field)[level];
  648:       res[2] = (nodes[2]->*field)[level];
  649:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  650:       else          res[3] = T();
  651:    }    
  652: 
  653:    template<typename T>
  654:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  655:       // Get the values of the func at the nodes of the element
  656:       res[0] = (nodes[0]->*func)(level);
  657:       res[1] = (nodes[1]->*func)(level);
  658:       res[2] = (nodes[2]->*func)(level);
  659:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  660:       else          res[3] = T();  // This is 0.0 or a zero vector
  661: 
  662:    }      
  663: 
  664:    template<typename T>
  665:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  666:       // Get the values of the field at the nodes of the element
  667:       res[0] = sides[0]->*field;
  668:       res[1] = sides[1]->*field;
  669:       res[2] = sides[2]->*field;
  670:       if (isQuad()) res[3] = sides[3]->*field;
  671:       else          res[3] = T();
  672:    }
  673: 
  674:    template<typename T>
  675:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  676:       // Get the values of the field at the nodes of the element
  677:       res[0] = (sides[0]->*field)[level];
  678:       res[1] = (sides[1]->*field)[level];
  679:       res[2] = (sides[2]->*field)[level];
  680:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  681:       else          res[3] = T();
  682:    }    
  683: 
  684:    template<typename T>
  685:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  686:       // Get the values of the func at the nodes of the element
  687:       res[0] = (sides[0]->*func)(level);
  688:       res[1] = (sides[1]->*func)(level);
  689:       res[2] = (sides[2]->*func)(level);
  690:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  691:       else          res[3] = T();  // This is 0.0 or a zero vector
  692: 
  693:    }      
  694: 
  695: 
  696:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  697:       double values[4];
  698:       getNodalValues(level, func, values);
  699: 
  700:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  701:    }
  702: 
  703:    template<typename T>
  704:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  705:       T values[4];
  706:       getNodalValues(field, values);
  707:       
  708:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  709:    }
  710: 
  711: 
  712:    template<typename T>
  713:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  714:       T values[4];
  715:       getNodalValues(level, field, values);
  716: 
  717:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  718:    }
  719: 
  720:    template<typename T>
  721:    __device__ T mean(T Node::* field) const {
  722:       T values[4];
  723:       getNodalValues(field, values);
  724: 
  725:       return (values[0] + values[1] + values[2] + values[3])/i34;
  726:    }
  727: 
  728:    template<typename T>
  729:    __device__ T mean(T Side::* field) const {
  730:       T values[4];
  731:       getSideValues(field, values);
  732:       
  733:       return (values[0] + values[1] + values[2] + values[3])/i34;
  734:    }   
  735: 
  736:    // __device__ double mean(double (Node::*func)(int) const) const {
  737:    //    double values[4];
  738:    //    getNodalValues(level, func, values);
  739:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  740:    // }
  741:    // ------------------------------------------------------------------------------------------------
  742: 
  743:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  744:       // Convert global coordinates to local coordinates
  745:       printf("NOT IMPLEMENTED: globalToLocal\n");
  746:       return true;
  747:    }
  748: 
  749:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  750:       // Convert local coordinates to global coordinates
  751:       printf("NOT IMPLEMENTED: localToGlobal\n");
  752:       return true;
  753:    }
  754: 
  755:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  756:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  757:     
  758:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  759:                                                  Element *&nextElem, int &jlev, double &dt);
  760: 
  761: };
