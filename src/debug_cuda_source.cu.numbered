 2791: __device__ void Node::updateKb(void) {
 2792: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2793: 
 2794:    if constexpr(ivcor == 1) return;
 2795: 
 2796: 
 2797:    if (isDry2()) return;
 2798: 
 2799:    if constexpr(ivcor == 2) {  // SZ coordinates
 2800:       
 2801:       // Compute bottom level index
 2802:       if (depth <= mesh->h_s) {
 2803:          kb = izlev;
 2804:          
 2805:       } else {
 2806:          kb = -1;
 2807:          int L = 0;
 2808:          int R = nzlev; 
 2809:          
 2810:          while (L <= R) {
 2811:             int M = (R + L) / 2;
 2812: 
 2813: 
 2814:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2815:             
 2816:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2817:                R = M;
 2818:             } else {
 2819:                L = M;
 2820:             }
 2821: 
 2822:             if (R - L == 1) {
 2823:                kb = L;
 2824:                break;
 2825:             }
 2826:          }
 2827:       }
 2828:    } 
 2829: }
 2830: 
 2831: 
 2832: __device__ __inline__ void Node::updateZCoordData(void) {
 2833: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2834: 
 2835:    if (isDry2()) {
 2836:       kb = -1;
 2837:       return;
 2838:    }
 2839: 
 2840:    if constexpr(ivcor == 2) {  // SZ coordinates
 2841:       
 2842:       // Compute bottom level index
 2843:       if (depth <= mesh->h_s) {
 2844:             kb = izlev;
 2845: 
 2846:       } else {
 2847:          kb = -1;
 2848:          for (int i = 0; i < nzlev - 1; i++) {
 2849:             // XXX Use binary search
 2850:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2851:                kb = i;
 2852:                break;
 2853:             }
 2854:          }
 2855:       }
 2856:    } 
 2857:    else if (ivcor == 1) {  // Localized sigma
 2858:       // Do nothing
 2859:    }
 2860: 
 2861: }
 2862: 
 2863: 
 2864: __device__ double Node::compZCoord(int k) const {
 2865:    // Computes the z coordinate at level k.
 2866:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2867:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2868:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2869:    // used 
 2870:    
 2871:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2872: 
 2873:    if (isDry2()) return 0.0;
 2874: 
 2875:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2876: 
 2877:    if constexpr(ivcor == 2) {
 2878: 
 2879:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2880:       const double h_c = mesh->h_c;
 2881:       const double theta_f = mesh->theta_f;
 2882:       const double sinh_theta_f = mesh->sinh_theta_f;
 2883: 
 2884:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2885:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2886:       // once per time step/node.
 2887:       // CHECK: updateZCoordData
 2888: 
 2889:       //  To simplify comparisons, I define index versions of count variables.
 2890:       if      (k == ivrt)           return eta2; 
 2891:       else if (k == izlev)          return -hmod2;
 2892:       else if (k == kb)             return -depth;
 2893:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2894:       else if (k > izlev) {
 2895:          const int ksig = k - izlev;
 2896: 
 2897:          if (hmod2 <= h_c) {
 2898: 
 2899:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2900:          } 
 2901:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2902:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2903:             assert(false && "ZCOOR: invalid h_c\n");
 2904:          } 
 2905:          else {
 2906:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2907:                          h_c * mesh->sigma[ksig] + 
 2908:                          (hmod2 - h_c) * mesh->cs[ksig];
 2909:          }
 2910:       } else { 
 2911:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2912:       }
 2913: 
 2914:    }
 2915:    else if constexpr(ivcor == 1) {
 2916:       if (k == kb) return -depth;
 2917:       else if (k == nvrt-1) return eta2;
 2918:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2919:    }
 2920:    
 2921:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2922:    return 0.0;
 2923: }
 2924: 
 2925: 
 2926: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2927:    // Computes the bottom drag Cd based on the selected nchi
 2928: 
 2929:    if constexpr(nchi == 0) {
 2930:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2931:       Cd = drag;  // Read from drag file
 2932: 
 2933:    } else if constexpr(nchi == 1) {
 2934:       // 
 2935: 
 2936:       bool ltmp = false; // for WBL iteration
 2937: 
 2938:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2939:       if (isDry || (rough == 0.0)) {
 2940:          Cd = 0.0;
 2941: 
 2942:       } else { //roughness >0 
 2943:          
 2944:          const double bthick_ori = z[kb + 1] - z[kb];  // thickness of bottom bnd layer
 2945:          const double bthick = max(dzb_min, bthick_ori);
 2946: 
 2947:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2948: 
 2949:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2950: 
 2951:       } // if rough
 2952: 
 2953: 
 2954:       // Ask Joseph XXXXX
 2955:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2956:       // Output warning for WBL if iteration didnt converge
 2957: 
 2958: 
 2959:    } else if constexpr(nchi == -1) {
 2960:    // Manning 
 2961:       Cd = 0.0;
 2962: 
 2963:       if (isDry) return;
 2964: 
 2965:       const double htot = max(hmin_man, htot2()); 
 2966:       Cd = grav2*rmanning*rmanning/pow(htot, 0.333);
 2967: 
 2968:    } else {
 2969:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2970:       
 2971:    } // if nchi
 2972: }
 2973: 
 2974: 
 2975: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2976:    // Checks if a side in on the boundary
 2977:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2978: 
 2979:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2980:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2981: 
 2982:    // Indices of the nodes that form the side
 2983:    const int n1 = side.n1->idx;
 2984:    const int n2 = side.n2->idx;
 2985:    isLand = false;
 2986:    
 2987: 
 2988:    // Check if the side is on a land boundary
 2989:    for (int i = 0; i < nland; i++) {
 2990:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2991:          // Consecutive nodes in the land boundary segment
 2992:          const int b1 = ilnd[i + j*nland];
 2993:          const int b2 = ilnd[i + (j + 1)*nland];
 2994: 
 2995:          assert(b1 != -1 && b2 != -1);
 2996: 
 2997:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2998:             
 2999:             isLand = true;
 3000:             return i;
 3001:          }
 3002:       }
 3003:    }
 3004: 
 3005:    // Check if the side is on an open boundary
 3006:    for (int i = 0; i < nope; i++) {
 3007:       for (int j = 0; j < nond[i] - 1; j++) {
 3008:          // Consecutive nodes in the open boundary segment
 3009:          const int b1 = iond[i + j*nope];
 3010:          const int b2 = iond[i + (j + 1)*nope];
 3011: 
 3012:          assert(b1 != -1 && b2 != -1);
 3013: 
 3014:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3015:             isLand = false;
 3016:             return i;
 3017:          }
 3018:       }
 3019:    }
 3020: 
 3021:    return -1;
 3022: }
 3023: 
 3024: 
 3025: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3026:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3027:                                     double *wind_rotate_angle, 
 3028:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3029:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3030:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3031:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3032:                                     double *drag, double *roughness, double *rmanning) {
 3033: 
 3034:    NODE(pnode);  
 3035:    const int i = idx_node;
 3036:    Node &node(*pnode);
 3037: 
 3038:    node.idx = i;
 3039: 
 3040:    const int idxNodeStart = nodeNeighNodesStart[i];
 3041:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3042:    node.numNodes = idxNodeEnd - idxNodeStart;
 3043:    node.nodes = nodeNeighNodes + idxNodeStart;
 3044:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3045: 
 3046: 
 3047: 
 3048:    const int idxElemStart = nodeNeighElemsStart[i];
 3049:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3050:    node.numElements = idxElemEnd - idxElemStart;
 3051:    node.elements = nodeNeighElems + idxElemStart;
 3052: 
 3053: 
 3054:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3055:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3056:       const int partNode = localNodePart[idxNodeGlobal]; 
 3057:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3058: 
 3059:       Node *node_ptr = nodes[partNode] + idxNode;
 3060:       
 3061:       nodeNeighNodes[idx] = node_ptr;
 3062:    }
 3063: 
 3064: 
 3065:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3066:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3067:       const int partElem = localElemPart[idxElemGlobal];
 3068:       const int idxElem  = localElemIndices[idxElemGlobal];
 3069: 
 3070:       Element *elem_ptr = elems[partElem] + idxElem;
 3071: 
 3072:       nodeNeighElems[idx] = elem_ptr;
 3073:    }      
 3074: 
 3075:    node.wind_angle = wind_rotate_angle[i];
 3076: 
 3077: 
 3078:    node.p.x   = node_coords[i * 3];
 3079:    node.p.y   = node_coords[i * 3 + 1];
 3080:    node.depth = node_coords[i * 3 + 2];
 3081: 
 3082:    if (use_ll) {
 3083:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3084:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3085:    }
 3086: 
 3087: 
 3088:    node.numSides = 0;
 3089: 
 3090:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3091:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3092:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3093:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3094:    else assert(false && "populateNodes: selected nchi not implemented.");
 3095:    
 3096:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3097:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3098:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3099: 
 3100:    
 3101:    // Links the node to the boundary information
 3102:    if (isbnd[i] >= 0) {
 3103:      
 3104:       // Get the index of the node boundary
 3105:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3106: 
 3107:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3108:       node.nodeBnd->node = &node;
 3109: 
 3110:       node.nodeBnd->sideBnd1 = nullptr;
 3111:       node.nodeBnd->sideBnd2 = nullptr;
 3112: 
 3113:       if (isbnd[i]>=0) {
 3114: 
 3115:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3116:          
 3117:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; XXXXX KKKKK
 3118:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3119: 
 3120:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3121:          node.nodeBnd->segment->clen  = nan("1");
 3122:          node.nodeBnd->segment->carea = nan("1");
 3123: 
 3124:       }
 3125:    } else {
 3126: 
 3127:       node.nodeBnd = nullptr; // For internal nodes
 3128: 
 3129:       if (isbnd[i] == landSegment) {
 3130:          node.nodeBnd = &landBoundaryNode;
 3131:          node.nodeBnd->segment = &landBoundarySegment;
 3132:       }
 3133:       
 3134:    }
 3135:    
 3136:    // XXXX GAUSSIAN HILL VELOCITIES
 3137: #ifdef GAUSSIAN_HILL_VELOCITIES
 3138:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3139:       constexpr double rot_per = 3000.0;
 3140:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3141:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3142:    // XXXXX
 3143: #endif
 3144: 
 3145: }
 3146: 
 3147: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3148:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3149:                                     double *wind_rotate_angle,   
 3150:                                     int *isdel, int *isidenode, int *isbnd,
 3151:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3152:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3153:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3154:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3155:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3156:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3157:                                     double *drag, double *roughness) {
 3158: 
 3159: 
 3160:    SIDE(pside);
 3161:    Side &side(*pside);
 3162:    const int i = idx_side;
 3163: 
 3164:    side.idx = i;  
 3165:    
 3166:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3167:    const double fc   = 2.0*omega_e*sin(sfea0);
 3168:    const double beta = 2.0*omega_e*cos(sfea0);
 3169: 
 3170:    // finding the pointer to the nodes that form the side
 3171:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3172:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3173: 
 3174:    const int locidx_n1 = localNodeIndices[idx_n1];
 3175:    const int locidx_n2 = localNodeIndices[idx_n2];
 3176:    const int part_n1 =   localNodePart[idx_n1];
 3177:    const int part_n2 =   localNodePart[idx_n2];
 3178: 
 3179:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3180:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3181: 
 3182:    // Counts the number of sides connected to each node
 3183:    side.n1->numSides++;
 3184:    side.n2->numSides++;
 3185: 
 3186:    // Normal, unitary vector to the side
 3187:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3188:    side.n = normalize(side.n);
 3189: 
 3190:    // Side boundary type
 3191:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3192:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3193: 
 3194:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3195:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3196:    {
 3197:       bool isLand = false;
 3198:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3199:       
 3200:       if (isbs > -1) {
 3201:          // assert(isLand || isbs>=0);
 3202:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3203: 
 3204:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3205: 
 3206:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3207:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3208: 
 3209:          assert (isLand == side.sideBnd->segment->isLand);
 3210: 
 3211:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3212:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3213:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3214: 
 3215:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3216:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3217:          
 3218:          side.sideBnd->side = &side;
 3219: 
 3220:       }
 3221:       else {
 3222:          side.sideBnd = nullptr;
 3223:       }
 3224:    }
 3225:    else 
 3226:    {
 3227:       side.sideBnd = nullptr;
 3228:    }
 3229: 
 3230: 
 3231:    // finding the pointer to the elements that share the side
 3232:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3233:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3234: 
 3235:    if (idx_e1 > -1) {
 3236:       const int locidx_e1 = localElemIndices[idx_e1];
 3237:       const int part_e1 =  localElemPart[idx_e1];
 3238:       side.elems[0] = elems[part_e1] + locidx_e1;
 3239: 
 3240:    }
 3241:    else {
 3242:       side.elems[0] = nullptr;
 3243:    }
 3244: 
 3245:    if (idx_e2 > -1) {
 3246:       const int locidx_e2 = localElemIndices[idx_e2];
 3247:       const int part_e2 =  localElemPart[idx_e2];
 3248:       side.elems[1] = elems[part_e2] + locidx_e2;
 3249:    }
 3250:    else {
 3251:       side.elems[1] = nullptr;
 3252:    }
 3253: 
 3254:    // Compute the center of the side
 3255:    side.center = 0.5*(side.n1->p + side.n2->p);
 3256: 
 3257:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3258:    side.shapiro = shapiro0;
 3259: 
 3260: #ifdef GAUSSIAN_HILL_VELOCITIES
 3261: // XXXX
 3262: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3263: constexpr double rot_per=3000.0;
 3264: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3265: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3266: // XXXXX      
 3267: #endif
 3268:    // Compute the z level at the center of the side
 3269:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3270:    
 3271:    // Compute the length of the side
 3272:    const Vector2 vLen = side.n2->p - side.n1->p;
 3273:    side.len = sqrt(dot(vLen, vLen));
 3274: 
 3275: 
 3276:    // Compute the Coriolis coefficient
 3277: 
 3278:    if constexpr(ncor == -1 || ncor == 0) {
 3279:       side.coriolis = coricoef;
 3280:    }
 3281:    else {
 3282:       const double sphi = side.lat();  // Latitude at the center of the side
 3283: 
 3284: // XXXXXX ERROR WHEN use_ll is false??????
 3285:       if constexpr(ics == 1) {
 3286:          // XXXXXXX
 3287:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3288:       }
 3289:       else {
 3290:          side.coriolis = 2.0*omega_e*sin(sphi);
 3291:       }
 3292: 
 3293:    }
 3294: }
 3295: 
 3296: 
 3297: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3298:    double *node_coords, double *node_coords_ll, bool use_ll,
 3299:    double *wind_rotate_angle,   
 3300:    int *isdel, int *isidenode, int *isbnd,
 3301:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3302:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3303:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3304:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3305:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3306:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3307:    double *drag, double *roughness) {
 3308: 
 3309:    ELEM(pelem);
 3310:    Element &elem(*pelem);
 3311:    const int i = idx_elem;
 3312: 
 3313:    elem.idx = i;
 3314: 
 3315:    for (int j = 0; j < i34[i]; j++) {
 3316:       const int idxNode = elnode[i*4 + j];  
 3317:       const int idxSide = elside[i*4 + j];
 3318:       
 3319:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3320:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3321: 
 3322:       // Find the neighboring element  
 3323:       if (elem.sides[j]->elems[0] == &elem) {
 3324:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3325:       }
 3326:       else {
 3327:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3328:       }
 3329:       
 3330:    }
 3331: 
 3332:    elem.i34 = i34[i];
 3333: 
 3334:    // Compute the centroid of the element and its depth
 3335:    Vector2 center = {0.0, 0.0};
 3336:    elem.depth = 0.0;
 3337:    for (int j = 0; j < i34[i]; j++) {
 3338: 
 3339:       center += elem.nodes[j]->p/i34[i];
 3340:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3341:    }
 3342:    elem.center = center;
 3343: 
 3344:    
 3345:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3346:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3347: 
 3348:    elem.area = elem.computeSignedArea(); 
 3349:    elem.radius = sqrt(elem.area)/pi; 
 3350:    
 3351:    // Determines which way the normal vector to each side is oriented.
 3352:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3353:    for (int j = 0; j < i34[i]; j++)  
 3354:    {
 3355:       if (elem.sides[j]->elems[0] == &elem) {
 3356:          elem.ssign[j] =  1.0;
 3357:       }
 3358:       else {
 3359:          elem.ssign[j] = -1.0;
 3360:       }
 3361: 
 3362:    }
 3363: 
 3364:    // Derivatives of shape functions
 3365:    //  For ics=2, this is done inside element/ll frame XXX
 3366:    //  For quads, the derivative is evaluated at centroid
 3367:    for (int j = 0; j < elem.i34; j++) {
 3368:       const double area = elem.area;
 3369:       const int id2 = elem.nxq(1 + j);
 3370:       const int id3 = elem.nxq(2 + j);
 3371:       const int id4 = elem.nxq(3 + j);
 3372:       if (elem.isTri()) {
 3373:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3374:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3375:          // da1/dx = (y1 - y2)/(2*area)
 3376:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3377:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3378:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3379:       }
 3380:       else  { // Quad; evaluate at centroid
 3381:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3382:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3383:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3384:       } // if Tri
 3385: 
 3386:    } // for j   
 3387:    
 3388:    
 3389: 
 3390: }
 3391: 
 3392: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3393:                                             double *emo, double *efa, 
 3394:                                             double *umo, double *ufa, 
 3395:                                             double *vmo, double *vfa) {
 3396: 
 3397: 
 3398:    NODE_BND(nodeBnd);
 3399:    const int idx = idx_node_bnd;    
 3400: 
 3401:    nodeBnd->idx = idx;
 3402: 
 3403:    // Need to find the segment index and the index of the node on the segment
 3404:    int idxNode = -1;
 3405:    int iseg, i;
 3406:    for (iseg = 0; iseg < nope; iseg++) {
 3407:       // for each segment...
 3408:       for (i = 0; i < nond[iseg]; i++) {
 3409:          idxNode = iond[iseg + i*nope];
 3410:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3411:          
 3412:       }
 3413:    }
 3414: 
 3415:    assert(iseg < nope && "iseg is out of bounds");
 3416: 
 3417: found: // Jumped here when the node was found
 3418: 
 3419:    nodeBnd->isEssentialBC = true;
 3420:    nodeBnd->elbc = 0.0;
 3421: 
 3422:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3423: 
 3424:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3425:       nodeBnd->efa[jfr] = efa[idx2];
 3426:       nodeBnd->emo[jfr] = emo[idx2];
 3427:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3428:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3429: 
 3430:    }
 3431:         
 3432: 
 3433: }
 3434: 
 3435: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3436:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3437:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3438:                 int *isdel, int *isidenode, int *isbnd,
 3439:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3440:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3441:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3442:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3443:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3444:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3445:                 double *drag, double *roughness,
 3446:                 double *emo, double *efa, 
 3447:                 double *umo, double *ufa, 
 3448:                 double *vmo, double *vfa) {
 3449: 
 3450:    // printf("Populating mesh for partition %d\n", partNum);
 3451: 
 3452:    // XXXXXX THIS function does almost nothing. 
 3453: 
 3454:    nbs = *sharedIdxSideBoundary + 1;
 3455:    nbp = *sharedIdxNodeBoundary + 1;
 3456: 
 3457:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3458: 
 3459: }
 3460: 
 3461: 
 3462: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3463:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3464:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3465: 
 3466: 
 3467:    NODE(node1);
 3468: 
 3469:    node1->clearMatrixRow();
 3470:    node1->qel = 0.0;
 3471: 
 3472:    // THIS IS FOR STRUCTURES XXX
 3473:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3474: 
 3475:    
 3476:    for (int j=0; j<node1->numElements; j++) {
 3477:       // For each element connected to the node...
 3478: 
 3479:       Element *elem = node1->elements[j];
 3480: 
 3481: 
 3482:       // Compute the average gravity
 3483:       const double grav3 = elem->mean(&Node::grav2);
 3484: 
 3485:       // Look at the documentation for the description of the terms in the following integrals
 3486: 
 3487:       // Integral I_1 
 3488:       // \bar{\breve{H}} 
 3489:       const double hhatb = elem->mean(&Side::hhat);        
 3490: 
 3491:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3492: 
 3493:       const int id1 = elem->nodeLocalIdx(node1); 
 3494:       const double area = elem->area;
 3495: 
 3496:       if (elem->isTri()) {
 3497: 
 3498:          // To clarify the notation in this section: 
 3499:          //   i stands for the node under consideration (node1)
 3500:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3501:          const int id2 = elem->nxq(1 + id1);
 3502:          const int id3 = elem->nxq(2 + id1);
 3503:          Node *node2 = elem->nodes[id2];
 3504:          Node *node3 = elem->nodes[id3];
 3505: 
 3506:          const Point2 x1 = node1->p;
 3507:          const Point2 x2 = node2->p;
 3508:          const Point2 x3 = node3->p;
 3509: 
 3510:          // integral of phi_i*phi_j
 3511:          const double ipp_ii = (1.0/6.0 )*area;
 3512:          const double ipp_ij = (1.0/12.0)*area;
 3513:          const double ipp_ik = (1.0/12.0)*area;
 3514: 
 3515:          // integral of [(grad phi_i) * (grad phi_j)]
 3516:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3517:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3518:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3519: 
 3520:          // Computes the different components of integral I_1 of each node with respect to node i.
 3521:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3522:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3523:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3524: 
 3525:          node1->addToSparseMatrix(node1, I1_ii);
 3526:          node1->addToSparseMatrix(node2, I1_ij); 
 3527:          node1->addToSparseMatrix(node3, I1_ik);
 3528: 
 3529:       }
 3530:       else { // Quad
 3531:          // XXX IMPLEMENT THIS
 3532:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3533: 
 3534:          // To clarify the notation in this section: 
 3535:          //   i stands for the node under consideration (node1)
 3536:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3537:          const int id2 = elem->nxq(1 + id1);
 3538:          const int id3 = elem->nxq(2 + id1);
 3539:          const int id4 = elem->nxq(3 + id1);
 3540:          Node *node2 = elem->nodes[id2];
 3541:          Node *node3 = elem->nodes[id3];
 3542:          Node *node4 = elem->nodes[id4];         
 3543: 
 3544:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3545:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3546:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3547:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3548:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3549: 
 3550:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3551:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3552:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3553:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3554:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3555: 
 3556:          // Computes the different components of integral I_1 of each node with respect to node i.
 3557:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3558:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3559:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3560:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3561: 
 3562:          node1->addToSparseMatrix(node1, I1_ii);
 3563:          node1->addToSparseMatrix(node2, I1_ij); 
 3564:          node1->addToSparseMatrix(node3, I1_ik);
 3565:          node1->addToSparseMatrix(node4, I1_il);
 3566:   
 3567: 
 3568: 
 3569:       
 3570:       } 
 3571: 
 3572:  
 3573:       // Integral I_4
 3574:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3575:       // Where
 3576:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3577: 
 3578:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3579:       // of U over the element.
 3580:       Vector2 Umean = {0.0, 0.0};
 3581:       for (int m=0; m<elem->i34; m++) {      
 3582:          const Side *side = elem->sides[m];
 3583: 
 3584:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3585:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3586:       }
 3587:       Umean = Umean/elem->i34;
 3588: 
 3589:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3590: 
 3591:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3592:       const double I_4_1 = dot(gradPhi_1, Umean);
 3593: 
 3594:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3595:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3596:      
 3597:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3598: 
 3599:       // Additional terms 
 3600:       double vnorm = 0.0;
 3601:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3602:          Vector3 ubed;
 3603:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3604: 
 3605:          Vector3 gradP = {0.0, 0.0, 1.0};
 3606:          for (int m=0; m < elem->i34; m++) {
 3607:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3608:            gradP += toVector3(gradP_2D, 0.0);
 3609:          }   
 3610:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3611:       } // imm==2
 3612: 
 3613:       if (elem->isTri()) {
 3614:          for (int l=0; l<3; l++) {
 3615:             double fac;
 3616: 
 3617:             Node *node = elem->nodes[l];
 3618: 
 3619:             fac = (node == node1) ? 2.0 : 1.0;
 3620:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3621:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3622:            
 3623:          }
 3624: 
 3625: 
 3626:          if (!elem->isDry) {
 3627:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3628: 
 3629:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3630: 
 3631:          }
 3632: 
 3633:       } // isTri
 3634:       else { // isQuad
 3635:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3636:          // for (int l=0; l<4; l++) {
 3637:          //   const Node *node = elem->nodes[l];
 3638: 
 3639:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3640:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3641: 
 3642:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3643:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3644:          // }
 3645: 
 3646:       } // isQuad
 3647: 
 3648: 
 3649:      node1->qel += (dt/elem->i34)*elem->vsource;
 3650:       
 3651: 
 3652:    } // for all elements connected to the node
 3653:    
 3654: 
 3655:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3656:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3657:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3658:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3659:       // If it is an open boundary node...
 3660: 
 3661:       // At least one open bnd side, maybe two
 3662:       for (int l=0; l<2; l++) { 
 3663: 
 3664:          // Gets each of the sides sharing the node. 
 3665:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3666: 
 3667:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3668:          
 3669: 
 3670:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3671:          if (sideBnd != nullptr) {
 3672:             // If the side is on a boundary...
 3673: 
 3674:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3675: 
 3676:             // Get the boundary segment
 3677:             const BoundarySegment *sideSegment = sideBnd->segment;
 3678:             const Side *side = sideBnd->side;
 3679: 
 3680:             // Integral I_3
 3681:             if (sideSegment->ifltype != 0) {
 3682:             // Natural or Flather b.c.
 3683: 
 3684:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3685:                // especially for Flather b.c.
 3686:                double ri3 = 0.0;
 3687:                if (!side->isDry) {
 3688:                   // If the side is not dry
 3689:                   
 3690:                   // Computes the side flux of (uth, vth)
 3691:                   double Vn = 0.0;
 3692:                   for (int k = side->kb; k<nvrt-1; k++) {
 3693:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3694:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3695: 
 3696:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3697:                   }
 3698: 
 3699:                   ri3 = 0.5*side->len*Vn;
 3700:                }
 3701: 
 3702:                if (sideSegment->ifltype == -1) { // Flather 1
 3703: 
 3704:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3705:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3706: 
 3707:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3708:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3709:                   
 3710:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3711:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3712: 
 3713:                } 
 3714:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3715:                   // Reset ri3
 3716:                   ri3 = 0.0;
 3717: 
 3718:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3719: 
 3720:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3721: 
 3722:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3723:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3724: 
 3725:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3726:                   node1->addToSparseMatrix(node1, con0*2.0);
 3727:                   node1->addToSparseMatrix(node2, con0);
 3728: 
 3729:                } // if Flather or Discharge
 3730: 
 3731:                node1->qel -= thetai*dt*ri3;
 3732: 
 3733: 
 3734:             } // I_3
 3735:           
 3736: 
 3737:             // Integral I_5
 3738:             if(!side->isDry) {
 3739: 
 3740:                const double Unbar = dot(side->U, side->n);
 3741:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3742: 
 3743:             } // I_5
 3744: 
 3745:          } // if is boundary side
 3746: 
 3747:       } // for l
 3748: 
 3749:    } // if isbnd
 3750: 
 3751: 
 3752: }
 3753: 
 3754: 
 3755: 
 3756: extern "C" {
 3757:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3758:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3759:                                   int* indices, int* indptr) {
 3760: 
 3761:       NODE(node);
 3762:       
 3763:       const int idx = node->idx;
 3764:       
 3765:       // Computes the index in the nzz array      
 3766:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3767: 
 3768: 
 3769:       indptr[idx] = nzzIdx;
 3770:       indices[nzzIdx] = idx;
 3771: 
 3772:       data_d[nzzIdx]    = node->coeffDiag;
 3773:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3774: 
 3775:       diag_d[idx] = 1.0/node->coeffDiag;
 3776:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3777: 
 3778:       b_d[idx] = node->qel;
 3779:       b_f[idx] = (float)node->qel;
 3780: 
 3781:       for (int k = 0; k < node->numNodes; ++k) {
 3782:          const Node* nb = node->nodes[k];
 3783: 
 3784:          const int j = nb->idx;
 3785: 
 3786:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3787:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3788: 
 3789:          indices[nzzIdx + k + 1] = j;
 3790:       }
 3791: 
 3792: 
 3793:    }
 3794: 
