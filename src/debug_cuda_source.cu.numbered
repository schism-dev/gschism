 7390: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7391: //                         exit
 7392: //                       endif
 7393: //                     enddo !lll
 7394: //                   enddo !ll
 7395: //                   ind1=nwild(1); ind2=nwild(2);
 7396: 
 7397: //                   do jj=1,natrm
 7398: //                     if(ntrs(jj)<=0) cycle
 7399: 
 7400: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7401: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
