 1130: // This struct is used to store the boundary information for a node.
 1131: struct NodeBoundary {   
 1132:    int idx;
 1133:    BoundarySegment *segment;
 1134:    Node *node;
 1135:    
 1136:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1137:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1138: 
 1139:    bool isLand;
 1140: 
 1141:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1142:    double elbc;   // Elevation boundary condition
 1143:    double eth;    // Elevation time history
 1144: 
 1145:    double eta_mean; // Mean elevation at nodes
 1146: 
 1147:    bool isEssentialBC;
 1148: 
 1149:    Vector2 uth[nvrt];  // "Time history" velocity
 1150: 
 1151:    // Arrays for harmonic constituents (if needed)
 1152:    double  emo[nbfr];  // Elevation amplitude
 1153:    double  efa[nbfr];  // Elevation phase
 1154:    Vector2 umo[nbfr];  // velocity amplitude
 1155:    Vector2 ufa[nbfr];  // velocity phase
 1156: 
 1157: 
 1158:    NodeBoundary(void) {
 1159:       isLand = false;
 1160:    }
 1161:    NodeBoundary(bool _isLand) {
 1162:       isLand = _isLand;
 1163:    }
 1164: 
 1165:    
 1166:    __forceinline__ __device__ int numSidesForAverage() const {
 1167:    // Returns the number of sides that are connected to the node and have the same segment.
 1168:    // This is used to compute the average velocity at the node for open boundary nodes.
 1169:       int res = 0;
 1170:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1171:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1172: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1173:       return res;
 1174:    }
 1175: 
 1176: 
 1177:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1178:       assert(index == 0 || index == 1); 
 1179:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1180:    }
 1181: 
 1182: 
 1183: };
