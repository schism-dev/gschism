 1790: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1791: // return;   
 1792:    // Lock the mutex
 1793:    lock(&debugPlotMutex);
 1794:  
 1795:    bool ok = true;
 1796:    if (debugPlotIdx == nullptr) ok = false;
 1797:    if (*debugPlotIdx >= 10000) ok = false;
 1798:    if (ok) {
 1799:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1800:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1801:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1802:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1803:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1804:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1805:       (*debugPlotIdx)++;
 1806:    }
 1807: 
 1808:    __threadfence();               // ensure all above writes are visible
 1809:    // Unlock the mutex
 1810:    unlock(&debugPlotMutex);
 1811: 
 1812: }
