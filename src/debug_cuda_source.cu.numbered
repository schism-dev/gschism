 3192: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3193:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3194:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3195:    // 
 3196:    // This kernel is called for all nodes.
 3197: 
 3198: 
 3199:    NODE(node1);
 3200: 
 3201: 
 3202:    node1->clearMatrixRow();
 3203:    node1->qel = 0.0;
 3204: 
 3205:    // THIS IS FOR STRUCTURES XXX
 3206:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3207: 
 3208:    
 3209:    for (int j=0; j<node1->numElements; j++) {
 3210:       // For each element connected to the node...
 3211: 
 3212:       Element *elem = node1->elements[j];
 3213: 
 3214:       // Compute the average gravity
 3215:       const double grav3 = elem->mean(&Node::grav2);
 3216: 
 3217:       // Look at the documentation for the description of the terms in the following integrals
 3218: 
 3219:       // Integral I_1 
 3220:       // \bar{\breve{H}} 
 3221:       const double hhatb = elem->mean(&Side::hhat);        
 3222: 
 3223:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3224: 
 3225:       const int id1 = elem->nodeLocalIdx(node1); 
 3226:       const double area = elem->area;
 3227: 
 3228:       if (elem->isTri()) {
 3229: 
 3230:          // To clarify the notation in this section: 
 3231:          //   i stands for the node under consideration (node1)
 3232:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3233:          const int id2 = elem->nxq(1 + id1);
 3234:          const int id3 = elem->nxq(2 + id1);
 3235:          Node *node2 = elem->nodes[id2];
 3236:          Node *node3 = elem->nodes[id3];
 3237: 
 3238:          const Point2 x1 = node1->p2();
 3239:          const Point2 x2 = node2->p2();
 3240:          const Point2 x3 = node3->p2();
 3241: 
 3242:          // integral of phi_i*phi_j
 3243:          const double ipp_ii = (1.0/6.0 )*area;
 3244:          const double ipp_ij = (1.0/12.0)*area;
 3245:          const double ipp_ik = (1.0/12.0)*area;
 3246: 
 3247:          // integral of [(grad phi_i) * (grad phi_j)]
 3248:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3249:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3250:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3251: 
 3252:          // Computes the different components of integral I_1 of each node with respect to node i.
 3253:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3254:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3255:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3256: 
 3257:          node1->addToSparseMatrix(node1, I1_ii);
 3258:          node1->addToSparseMatrix(node2, I1_ij); 
 3259:          node1->addToSparseMatrix(node3, I1_ik);
 3260: 
 3261:       }
 3262:       else { // Quad
 3263:          // XXX IMPLEMENT THIS
 3264:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3265: 
 3266:          // To clarify the notation in this section: 
 3267:          //   i stands for the node under consideration (node1)
 3268:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3269:          const int id2 = elem->nxq(1 + id1);
 3270:          const int id3 = elem->nxq(2 + id1);
 3271:          const int id4 = elem->nxq(3 + id1);
 3272:          Node *node2 = elem->nodes[id2];
 3273:          Node *node3 = elem->nodes[id3];
 3274:          Node *node4 = elem->nodes[id4];         
 3275: 
 3276:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3277:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3278:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3279:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3280:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3281: 
 3282:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3283:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3284:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3285:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3286:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3287: 
 3288:          // Computes the different components of integral I_1 of each node with respect to node i.
 3289:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3290:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3291:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3292:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3293: 
 3294:          node1->addToSparseMatrix(node1, I1_ii);
 3295:          node1->addToSparseMatrix(node2, I1_ij); 
 3296:          node1->addToSparseMatrix(node3, I1_ik);
 3297:          node1->addToSparseMatrix(node4, I1_il);
 3298:   
 3299: 
 3300: 
 3301:       
 3302:       } 
 3303: 
 3304:  
 3305:       // Integral I_4
 3306:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3307:       // Where
 3308:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3309: 
 3310:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3311:       // of U over the element.
 3312:       Vector2 Umean = {0.0, 0.0};
 3313:       for (int m=0; m<elem->i34; m++) {      
 3314:          const Side *side = elem->sides[m];
 3315: 
 3316:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3317:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3318:       }
 3319:       Umean = Umean/elem->i34;
 3320: 
 3321:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3322: 
 3323:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3324:       const double I_4_1 = dot(gradPhi_1, Umean);
 3325: 
 3326:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3327:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3328:      
 3329: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3330: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3331:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3332: 
 3333:       // Additional terms 
 3334:       double vnorm = 0.0;
 3335:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3336:          Vector3 ubed;
 3337:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3338: 
 3339:          Vector3 gradP = {0.0, 0.0, 1.0};
 3340:          for (int m=0; m < elem->i34; m++) {
 3341:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3342:            gradP += toVector3(gradP_2D, 0.0);
 3343:          }   
 3344:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3345:       } // imm==2
 3346: 
 3347:       if (elem->isTri()) {
 3348:          for (int l=0; l<3; l++) {
 3349:             double fac;
 3350: 
 3351:             Node *node = elem->nodes[l];
 3352: 
 3353:             fac = (node == node1) ? 2.0 : 1.0;
 3354:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3355:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3356: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3357:            
 3358:          }
 3359: 
 3360: 
 3361:          if (!elem->isDry) {
 3362:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3363: 
 3364:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3365: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3366:          }
 3367: 
 3368:       } // isTri
 3369:       else { // isQuad
 3370:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3371:          // for (int l=0; l<4; l++) {
 3372:          //   const Node *node = elem->nodes[l];
 3373: 
 3374:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3375:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3376: 
 3377:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3378:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3379:          // }
 3380: 
 3381:       } // isQuad
 3382: 
 3383: 
 3384:       node1->qel += (dt/elem->i34)*elem->vsource;
 3385:       
 3386: 
 3387:    } // for all elements connected to the node
 3388:    
 3389: 
 3390: 
 3391:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3392:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3393:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3394:    if (nodeBnd != nullptr)  { 
 3395:       // If it is an open boundary node...
 3396: 
 3397:       // At least one open bnd side, maybe two
 3398:       for (int l=0; l<2; l++) { 
 3399: 
 3400:          // Gets each of the sides sharing the node. 
 3401:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3402: 
 3403:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3404: 
 3405:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3406: 
 3407:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3408:          if (sideBnd != nullptr) {
 3409:             // If the side is on a boundary...
 3410: 
 3411:             // Get the boundary segment
 3412:             const BoundarySegment *sideSegment = sideBnd->segment;
 3413:             const Side *side = sideBnd->side;
 3414: 
 3415:             // Integral I_3
 3416:             if (sideSegment->ifltype != 0) {
 3417:             // Natural or Flather b.c.
 3418: 
 3419:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3420:                // especially for Flather b.c.
 3421:                double ri3 = 0.0;
 3422:                if (!side->isDry) {
 3423:                   // If the side is not dry
 3424:                   
 3425:                   // Computes the side flux of (uth, vth)
 3426:                   double Vn = 0.0;
 3427:                   for (int k = side->kb; k<nvrt-1; k++) {
 3428:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3429:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3430: 
 3431:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3432:                   }
 3433: 
 3434:                   ri3 = 0.5*side->len*Vn;
 3435:                }
 3436: 
 3437:                if (sideSegment->ifltype == -1) { // Flather 1
 3438: 
 3439:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3440:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3441: 
 3442:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3443:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3444:                   
 3445:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3446:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3447: 
 3448:                } 
 3449:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3450:                   // Reset ri3
 3451:                   ri3 = 0.0;
 3452: 
 3453:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3454: 
 3455:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3456: 
 3457:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3458:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3459: 
 3460:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3461:                   node1->addToSparseMatrix(node1, con0*2.0);
 3462:                   node1->addToSparseMatrix(node2, con0);
 3463: 
 3464:                } // if Flather or Discharge
 3465: 
 3466:                node1->qel -= thetai*dt*ri3;
 3467: 
 3468:             } // I_3
 3469:           
 3470: 
 3471:             // Integral I_5
 3472:             if(!side->isDry) {
 3473: 
 3474:                const double Unbar = dot(side->U, side->n);
 3475:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3476: 
 3477:             } // I_5
 3478: 
 3479:          } // if is boundary side
 3480: 
 3481:       } // for l
 3482: 
 3483:    } // if isbnd
 3484: 
 3485: 
 3486: }
 3487: 
 3488: 
 3489: 
 3490: extern "C" {
 3491:    __global__ void rollUpElevation(void) {
 3492: 
 3493:       NODE(node);
 3494: 
 3495:       node->eta1 = node->eta2;
 3496: 
 3497:    }
 3498: 
 3499: 
 3500:    __global__ void backtrackAllNodes(void) {
 3501: 
 3502:       // max/min # of sub-divisions
 3503:       const int ndelt_max = max(1.0, dt/dtb_min);
 3504:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3505: 
 3506:       // Removed all references to swild98 XXX
 3507:       // swild98=0.d0 !init
 3508: 
 3509: 
 3510:       SIDE(side);
 3511: 
 3512:       const int kb = side->kb;
 3513: 
 3514: 
 3515:       // Initialize btrack velocities to the actual velocities at the side 
 3516:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3517: 
 3518:       if (side->isDry) return;
 3519: 
 3520: 
 3521:       // Checks that at least one element is not dry
 3522:       const Element *elem1 = side->elems[0];
 3523:       const Element *elem2 = side->elems[1];
 3524: 
 3525: 
 3526:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3527:       
 3528:       // XXXXXX
 3529:       // !swild_tmp to store global coord. of the starting side
 3530:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3531:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3532:       // !Use sframe2 
 3533:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3534: 
 3535: 
 3536:       for (int k = kb; k < nvrt; k++) {
 3537:       //  Initialize (xt,yt,zt), nnel and vel.
 3538:       //  For ics=2, the coordinates are in local frames
 3539:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3540: 
 3541: 
 3542:          const int iadvf = side->iadv();  // Advection flag
 3543: 
 3544:          Point3 xt;
 3545:          if constexpr(ics==1) {
 3546:             xt = side->center3D(k); 
 3547:          }
 3548:          else // lat/lon; in side lat/lon frame
 3549:          {
 3550:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3551:          // XXX IMPLEMENT THIS
 3552:       //          xt=0.d0
 3553:       //          yt=0.d0
 3554:       //          !centroid coord. for nudging
 3555:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3556:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3557:          }  // ics
 3558: 
 3559: 
 3560: 
 3561:          // If on land or open boundary...
 3562:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3563:          
 3564:          const double vmag = length(side->u2[k]);
 3565: 
 3566:          if (vmag <= velmin_btrack) {
 3567:             // No activity 
 3568: 
 3569:             side->btu[k] = side->u2[k];
 3570:             
 3571:          } else {  // do btrack
 3572: 
 3573:             // Compute number of sub-divisions based on local gradients 
 3574:             // XXX IS THIS NECESSARY?
 3575:             double suma = 0.0;
 3576:             int icount = 0;
 3577:             for (int ii=0; ii<2; ii++) {
 3578: 
 3579:                const Element *elem = side->elems[ii];
 3580:                  
 3581:                if (elem == nullptr) continue;
 3582: 
 3583:                icount++;
 3584: 
 3585:                // Not strictly along z; in ll frame for ics=2
 3586: 
 3587:                double utmp[4];
 3588:                double vtmp[4];
 3589:                for (int jj = 0; jj < elem->i34; jj++) {
 3590: 
 3591:                   const Node *node = elem->nodes[jj];
 3592: 
 3593:                   if constexpr(ics==1) {
 3594:                      utmp[jj] = node->u2[k].x;
 3595:                      vtmp[jj] = node->u2[k].y;  
 3596:                   } else {
 3597:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3598:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3599:                   }
 3600:                } // for jj
 3601: 
 3602:                const Vector2 grad_u = elem->grad2(utmp); 
 3603:                const Vector2 grad_v = elem->grad2(vtmp);
 3604: 
 3605:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3606:             } // for ii
 3607: 
 3608:             assert(icount > 0 && "Impossible 77");
 3609: 
 3610:             // '4' is somewhat arbitrary
 3611:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3612: 
 3613:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3614:          
 3615: 
 3616:             Vector3 u_int = {0.0, 0.0, 0.0};
 3617: 
 3618:             side->btrack(k, dt, dtbk, u_int);
 3619:             side->btu[k] = toVector2(u_int);
 3620:                
 3621:          } // if vmag (do backtrack)
 3622: 
 3623:       } // for k=kb,nvrt-1
 3624: 
 3625:    }
 3626: 
 3627: } // extern "C"
 3628: 
 3629: template<int nc>
 3630: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3631: 
 3632: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3633: //
 3634: // a,b,c,rhs: input vectors and are not modified by this program.
 3635: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3636: // rhs is the r.h.s.
 3637: // n: actual rank of the system.
 3638: // rows in u() and rhs();
 3639: // u: output with nc columns (transposed to rows)
 3640: // gam: a working array.
 3641: //
 3642: // NOTES:
 3643: // This is a template function that allows for different numbers of columns in the rhs vector.
 3644: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3645: 
 3646:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3647:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3648: 
 3649:    double bet = b[0];
 3650:    if constexpr (nc == 1) {
 3651:       u[0] = rhs[0]/bet;
 3652:    } else {
 3653:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3654:    }
 3655: 
 3656:    for (int j = 1; j < n; j++) {
 3657:       gam[j] = c[j - 1]/bet;
 3658:       bet = b[j] - a[j]*gam[j];
 3659: 
 3660:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3661: 
 3662:       if constexpr (nc == 1) {
 3663:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3664:       } else {
 3665:          for (int l = 0; l < nc; l++) {
 3666:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3667:          }
 3668:       }
 3669:    }
 3670: 
 3671:    // Back-substitution
 3672:    for (int j = n - 2; j >= 0; j--) {
 3673:       if constexpr (nc == 1) {
 3674:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3675:       } else {
 3676:          for (int l = 0; l < nc; l++) {
 3677:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3678:          }
 3679:       }
 3680:    }
 3681: }
 3682: 
 3683: 
 3684: 
 3685: // Helper function that contains the core algorithm
 3686: template<typename XAccessor, typename YAccessor>
 3687: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3688:                                     double  yp_top, double  yp_bot, 
 3689:                                     CubicSpline &spline) {
 3690:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3691:    // 
 3692:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3693:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3694:    //
 3695:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3696:    // 
 3697:    // Inputs: 
 3698:    //            n: dimension for x etc; # of data pts (>=2);
 3699:    //            getX, getY: functions to access x,y coordinates
 3700:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3701:    //     Output: 
 3702:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3703: 
 3704:    const int n = k2 - k1 + 1;
 3705:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3706: 
 3707:    // Allocate memory for the splines
 3708:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3709:    spline.x   = new double[n];
 3710:    spline.y   = new double[n];
 3711:    spline.yp  = new double[n];
 3712:    spline.ypp = new double[n];
 3713: 
 3714:    for (int k=k1; k<=k2; k++) {
 3715:       spline.x[k] = getX(k);
 3716:       spline.y[k] = getY(k);
 3717:    }
 3718: 
 3719:    // This is to simplify expressions later
 3720:    double *x = spline.x;
 3721:    double *y = spline.y;
 3722: 
 3723:    double *a = nullptr;
 3724:    double *b = nullptr;
 3725:    double *c = nullptr;
 3726:    double *gam = nullptr;
 3727:    double *rhs = nullptr;
 3728:    
 3729: 
 3730:       a = new double[n];   // Lower diagonal
 3731:       b = new double[n];   // Diagonal
 3732:       c = new double[n];   // Upper diagonal
 3733:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3734:       rhs = new double[n]; // Right-hand side
 3735: 
 3736:    for (int k=k1; k<=k2; k++) {
 3737:       if (k == k1) {
 3738:          // Bottom level
 3739:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3740:          b[k] = (x[k+1] - x[k])/3.0;
 3741:          c[k] = b[k]/2.0;
 3742:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3743:       } else if (k == n - 1) {
 3744:          // Top level (surface)
 3745:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3746:          b[k] = (x[k] - x[k-1])/3.0;
 3747:          a[k] = b[k]/2.0;
 3748:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3749:       } else {
 3750:          // Intermediate levels
 3751:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3752:          b[k] = (x[k+1] - x[k-1])/3.0;
 3753:          a[k] = (x[k  ] - x[k-1])/6.0;
 3754:          c[k] = (x[k+1] - x[k  ])/6.0;
 3755:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3756:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3757:       }
 3758:    }
 3759: 
 3760:    // Solve the tridiagonal system
 3761:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3762:    
 3763:    spline.yp[k1] = yp_bot;
 3764:    spline.yp[k2] = yp_top;
 3765: 
 3766:    // Compute rest of 1st derivatives using the splines
 3767:    for (int k=k1+1; k<k2; k++) {
 3768:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3769:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3770:    }
 3771:    
 3772:    delete[] a;
 3773:    delete[] b;
 3774:    delete[] c;
 3775:    delete[] gam;
 3776:    delete[] rhs;
 3777: 
 3778: }
 3779: 
 3780: // Array version
 3781: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3782:                                 double y_top, double y_bot, 
 3783:                                 CubicSpline &spline) {
 3784:    auto getX = [x] (int k) { return x[k]; };
 3785:    auto getY = [y] (int k) { return y[k]; };
 3786:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3787: }
 3788: 
 3789: // Lambda version - allows custom access patterns
 3790: template<typename XFunc, typename YFunc>
 3791: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3792:                                 double y_top, double y_bot,
 3793:                                 CubicSpline &spline) {
 3794:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3795: }
