 8165: __global__ void printMatrix(bool full) {
 8166:    // Debugging: print the matrix
 8167: 
 8168:    const int size = mesh->np;
 8169:    double sum = 0.0;
 8170:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8171:       const Node *node = mesh->localNodeData + idx_node;
 8172:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8173:       for (int j = 0; j < node->numNodes; j++) {
 8174:          Node* nbNode = node->nodes[j];
 8175:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8176:          sum += node->coeffMatrix[j];
 8177:       }
 8178:       if (full) printf("]\n");
 8179: 
 8180: 
 8181:    }
 8182:    if (!full) printf("sum=%lf\n", sum);
 8183: }
