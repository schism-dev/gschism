 8032: 
 8033:    __global__ void computeVerticalVelocity(void) {
 8034:       // Computes the vertical velocity at the (2D) element's centroid.
 8035:       // In this function we will be considering volumetric elements, with side faces and a 
 8036:       // bottom and a top face. We will call them SFs, BF and TF.
 8037:       // It computes the flux coming from BF and the SFs.
 8038:       // If the bed is moving, it takes that into account.
 8039:       // Since water is incompressible, the integral of the velocity times the normal vector
 8040:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8041:       // and the BF is equal to the flux going out from the TF.
 8042:       // TF = - BF - sum(SFs).
 8043:       // It then computes the horizontal velocity at the center of TF.
 8044:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8045:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8046:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8047: 
 8048:       ELEM(elem);
 8049: 
 8050:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8051: 
 8052:       if (elem->isDry) return;
 8053: 
 8054:       const int kb = elem->kb;
 8055:       const bool isTri = elem->isTri();
 8056: 
 8057:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8058: 
 8059:       // Compute the bottom velocity
 8060:       if constexpr(imm != 0) {
 8061:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8062:       }
 8063: 
 8064: 
 8065:       double bottomArea3D;
 8066:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8067: 
 8068:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8069: 
 8070:       double topArea3D;
 8071: 
 8072:       // Bottom face flux
 8073:       double bottomFlux = 0.0;
 8074:       Vector2 u2meanBottom = {0.0, 0.0};
 8075:       const Vector2 gradh = elem->grad2(&Node::depth);
 8076:       if constexpr(imm==2) {
 8077:          Vector3 ubed;
 8078: 
 8079:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8080:          // updateBDEF(ubed);
 8081:      
 8082:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8083: 
 8084:          // elem->w[kb] += ubed.z;
 8085:       }
 8086:       else {
 8087: 
 8088:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8089:   
 8090:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8091:          // in the direction of motion.
 8092:          const double bottomW = - dot(gradh, u2meanBottom);  
 8093:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8094: 
 8095:          // VElocity associated to the bed deformation
 8096:          double bedVelocity = 0.0;
 8097:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8098: 
 8099:          elem->w[kb] = bedVelocity + bottomW; 
 8100: 
 8101:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8102:          
 8103:       } // if imm
 8104: 
 8105:       // Compute w for kb+1 to nvrt-1
 8106:       for (int l = kb; l < nvrt - 1; l++) {
 8107: 
 8108:          // normal vector to the top face of the "volumetric" element (3D)
 8109:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8110: 
 8111:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8112:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8113: 
 8114:          // Compute the total flux at the sides
 8115:          double sideFlux = 0.0;
 8116: 
 8117:          for (int j = 0; j < elem->i34; j++) {
 8118:             const Side *side = elem->sides[j];
 8119:             const int kbs = side->kb;
 8120:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8121:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8122:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8123: 
 8124:             // The area is "clamped" meaning that it takes kb into account.
 8125:             const double sideArea = side->areaClamped(l);
 8126: 
 8127:             const double sign = elem->ssign[j]; 
 8128: 
 8129:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8130:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8131:          }
 8132:          
 8133:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8134:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8135:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8136: 
 8137:          // The flux at the top ace can be computed from the other flows.
 8138:          // All fluxes are in directions into the prism.
 8139:          const double topFlux = - sideFlux - bottomFlux;
 8140: 
 8141:          // Flux at the top face due to the horizontal velocities only
 8142:          // topFlux = topHorizontalFlux + topVerticalFlux
 8143:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8144: 
 8145:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8146:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8147: 
 8148:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8149: 
 8150:          bottomFlux = -topFlux;
 8151:          
 8152:       }
 8153: 
 8154:    }  
 8155: 
 8156: 
 8157: 
 8158: 
 8159: 
 8160: 
