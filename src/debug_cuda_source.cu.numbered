  287: 
  288: __device__ __forceinline__ double3 operator/(const double3& v, double s) {
  289:     return make_double3(v.x / s, v.y / s, v.z / s);
  290: }
  291: 
  292: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  293:     return v.x*w.x + v.y*w.y + v.z*w.z;
  294: }
  295: 
  296: __device__ __forceinline__ double norm2(const double3& v) {
  297:     return v.x*v.x + v.y*v.y + v.z*v.z;
  298: }
  299: 
  300: __device__ __forceinline__ Vector2 toVector2(const double3& v) {
  301:     return make_double2(v.x, v.y);
