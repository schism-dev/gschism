 9157: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9158:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9159:    NODE(node);
 9160: 
 9161:    switch (varCode) {
 9162:       case (int)VarCode::outputCoords: {
 9163:          const Point2 coords = node->outputCoords();
 9164:          double *out = (double *)((char *)res + idx_node * 16);
 9165:          out[0] = coords.x;
 9166:          out[1] = coords.y;
 9167:          break;
 9168:       }
 9169:       case (int)VarCode::depth:
 9170:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9171:          break;
 9172:       case (int)VarCode::kb:
 9173:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9174:          break;
 9175:       case (int)VarCode::eta:
 9176:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9177:          break;
 9178:       case (int)VarCode::u_air: {
 9179:          double *out = (double *)((char *)res + idx_node * 16);
 9180:          out[0] = node->u_air.x;
 9181:          out[1] = node->u_air.y;
 9182:          break;
 9183:       }
 9184:       case (int)VarCode::isdry:
 9185:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9186:          break;
 9187:       case (int)VarCode::u: {
 9188:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9189:          if (k >= 0) {
 9190:             out[0] = node->u2[k].x;
 9191:             out[1] = node->u2[k].y;
 9192:          } else {
 9193:             for (int lev = 0; lev < nvrt; lev++) {
 9194:                out[lev*2    ] = node->u2[lev].x;
 9195:                out[lev*2 + 1] = node->u2[lev].y;
 9196:             }
 9197:          }
 9198:          break;
 9199:       }
 9200:       case (int)VarCode::z: {
 9201:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9202:          if (k >= 0)
 9203:             out[0] = node->z[k];
 9204:          else
 9205:             for (int lev = 0; lev < nvrt; lev++)
 9206:                out[lev] = node->z[lev];
 9207:          break;
 9208:       }
 9209:       case (int)VarCode::w: {
 9210:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9211:          if (k >= 0)
 9212:             out[0] = node->w2[k];
 9213:          else
 9214:             for (int lev = 0; lev < nvrt; lev++)
 9215:                out[lev] = node->w2[lev];
 9216:          break;
 9217:       }
 9218:       case (int)VarCode::dfh: {
 9219:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9220:          if (k >= 0)
 9221:             out[0] = node->dfh[k];
 9222:          else
 9223:             for (int lev = 0; lev < nvrt; lev++)
 9224:                out[lev] = node->dfh[lev];
 9225:          break;
 9226:       }
 9227:       case (int)VarCode::dfv: {
 9228:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9229:          if (k >= 0)
 9230:             out[0] = node->dfv[k];
 9231:          else
 9232:             for (int lev = 0; lev < nvrt; lev++)
 9233:                out[lev] = node->dfv[lev];
 9234:          break;
 9235:       }
 9236:    }
 9237: }
 9238: 
 9239: 
 9240: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9241:    SIDE(side);
 9242: 
 9243:    switch (varCode) {
 9244:       case (int)VarCode::outputCoords: {
 9245:          const Point2 coords = side->outputCoords();
 9246:          double *out = (double *)((char *)res + idx_side * 16);
 9247:          out[0] = coords.x;
 9248:          out[1] = coords.y;
 9249:          break;
 9250:       }
 9251:       case (int)VarCode::n1:
 9252:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9253:          break;
 9254:       case (int)VarCode::n2:
 9255:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9256:          break;
 9257:       case (int)VarCode::isdry:
 9258:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9259:          break;
 9260:    }
 9261: }
