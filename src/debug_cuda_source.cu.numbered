 3892: __device__ __inline__ void Node::updateZCoordData(void) {
 3893: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3894: 
 3895:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3896:    // if (isDry2()) {
 3897:    //    kb = -1;  // XXXXXXXX KKKKK
 3898:    //    return;
 3899:    // }
 3900: 
 3901: 
 3902:    if constexpr(ivcor == 2) {  // SZ coordinates
 3903:       
 3904:       // Compute bottom level index
 3905:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3906:    } 
 3907:    else {  // if (ivcor == 1) Localized sigma
 3908:       // Do nothing
 3909:    }
 3910: 
 3911: 
 3912: }
