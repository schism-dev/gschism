 7988: __global__ void printMatrix(bool full) {
 7989:    // Debugging: print the matrix
 7990: 
 7991:    const int size = mesh->np;
 7992:    double sum = 0.0;
 7993:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7994:       const Node *node = mesh->localNodeData + idx_node;
 7995:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7996:       for (int j = 0; j < node->numNodes; j++) {
 7997:          Node* nbNode = node->nodes[j];
 7998:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7999:          sum += node->coeffMatrix[j];
 8000:       }
 8001:       if (full) printf("]\n");
 8002: 
 8003: 
 8004:    }
 8005:    if (!full) printf("sum=%lf\n", sum);
 8006: }
