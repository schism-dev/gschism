 9568: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9569:    // Get the value of a variable from an side
 9570:    // varName is the name of the variable to get
 9571:    // var is the array to store the value
 9572:    // k is the vertical level index of the variable to get
 9573:    SIDE_BND(sideBnd);   
 9574: 
 9575:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9576:    if (sideBnd->segment->isLand) idx = -7;
 9577: 
 9578:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9579:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9580: 
 9581: }
