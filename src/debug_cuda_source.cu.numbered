 1720: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1721:    return;
 1722:    // Lock the mutex
 1723:    lock(&debugPlotMutex);
 1724:  
 1725:    bool ok = true;
 1726:    if (debugPlotIdx == nullptr) ok = false;
 1727:    if (*debugPlotIdx >= 10000) ok = false;
 1728:    if (ok) {
 1729:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1730:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1731:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1732:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1733:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1734:       (*debugPlotIdx)++;
 1735:    }
 1736: 
 1737:    __threadfence();               // ensure all above writes are visible
 1738:    // Unlock the mutex
 1739:    unlock(&debugPlotMutex);
 1740: 
 1741: }
