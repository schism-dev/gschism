 4271:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4272: 
 4273:       NODE_BND(nodeBnd);
 4274: 
 4275:       Node *node = nodeBnd->node;
 4276: 
 4277:       node->ETP = 0.0;
 4278: 
 4279:       for (int j=0; j<ntip; j++) {
 4280: 
 4281:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4282:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4283: printf("RAAAAMP  ramp = %f, arg = %f\n", ramp, arg);         
 4284:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4285: 
 4286:          if constexpr(iloadtide==1) { // loading tide
 4287:             assert(false && "Loading tide not implemented");
 4288:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4289:          }
 4290:          
 4291:       }
 4292:       
 4293:    }
