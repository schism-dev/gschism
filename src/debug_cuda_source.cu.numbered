 2260:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2261:    // Project the vectors from the side frame to the element frame
 2262: 
 2263:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2264:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2265:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2266:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2267:       else          v[3] = Vector2();
 2268:    }
