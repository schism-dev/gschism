 5252:    //        call parallel_abort(errmsg)
 5253:    //      endif
 5254:    //      icount=0
 5255:    //      icount2=0
 5256:    //      do k=1,nope_global
 5257:    //        if(iabs(ifltype(k))>=4) then
 5258:    //          icount=icount+1
 5259:    //          if(icount>nfltype2) call parallel_abort('STEP: wrong counting 6')
 5260:    //          do j=1,nond_global(k)
 5261:    //            icount2=icount2+1
 5262:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 5263: 
 5264:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 5265:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 5266:    //          enddo !j
