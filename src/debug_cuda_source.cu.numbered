 8120: __global__ void returnMatrix(double *res) {
 8121:    // Debugging: returns the matrix as a CuPy array
 8122: 
 8123:    const int size = mesh->np;
 8124:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8125:       const Node *node = mesh->localNodeData + idx_node;
 8126:       res[idx_node*size + idx_node] = node->coeffDiag;
 8127:       for (int j = 0; j < node->numNodes; j++) {
 8128:          Node* nbNode = node->nodes[j];
 8129:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8130:       }
 8131: 
 8132:    }
 8133:    
 8134: }
 8135: 
