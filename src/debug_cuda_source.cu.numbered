 5177:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5178:       }
 5179: 
 5180:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5181:       node->setWind(wind);
 5182: 
 5183:       node->pr = pressAir[idx];
 5184:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5185: 
 5186:    }
