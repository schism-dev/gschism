 2570:    template<typename T>
 2571:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2572:       T values[4];
 2573:       getNodalValues(field, values);
 2574: 
 2575:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2576:       if constexpr (IsVector2<T>::value && ics == 2) {
 2577: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2578:          projectNodeVectorsToElementFrame(values);
 2579: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2580:       }
 2581: 
 2582:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2583:    }
