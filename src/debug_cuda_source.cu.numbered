 9712: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9713:    Element *elems = mesh->localElemData;
 9714: 
 9715:    *addr = elems;
 9716:    *sizeElement = sizeof(Element);
 9717:    switch (varCode) {
 9718:       case (int)VarCode::z:
 9719:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9720:          *sizeType = sizeof(double);
 9721:          break;
 9722:       case (int)VarCode::x:
 9723:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9724:          *sizeType = sizeof(Vector2);
 9725:          break;
 9726:       case (int)VarCode::gradETP:
 9727:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9728:          *sizeType = sizeof(Vector2);
 9729:          break;
 9730:       case (int)VarCode::area:
 9731:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9732:          *sizeType = sizeof(double);
 9733:          break;
 9734:       case (int)VarCode::depth:
 9735:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9736:          *sizeType = sizeof(double);
 9737:          break;
 9738:       case (int)VarCode::radius:
 9739:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9740:          *sizeType = sizeof(double);
 9741:          break;
 9742:       case (int)VarCode::ghat:
 9743:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9744:          *sizeType = sizeof(Vector2);
 9745:          break;
 9746:       case (int)VarCode::kb:
 9747:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9748:          *sizeType = sizeof(int);
 9749:          break;
 9750:       case (int)VarCode::isdry:
 9751:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9752:          *sizeType = sizeof(int);
 9753:          break;            
 9754:       case (int)VarCode::w:
 9755:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9756:          *sizeType = sizeof(double);
 9757:          break;
 9758:       case (int)VarCode::FaceIndices:
 9759:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9760:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9761:          *sizeType = sizeof(Node);
 9762:          break;
 9763:       default:
 9764:          *offset = -1;
 9765:    }
 9766: }
