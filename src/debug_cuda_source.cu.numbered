 5259: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 5260: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 5261:    
 5262: //    ibelow = 0;
 5263: 
 5264: //    if (zt < za[k1]) {
