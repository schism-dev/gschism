 1523: // Each device has a global mesh object
 1524: __device__ Mesh* mesh = nullptr; 
 1525: 
 1526: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1527:                    Side *side = &(mesh->localSideData[idx_side]); \
 1528:                    if (idx_side >= mesh->ns) return;
 1529: 
 1530: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1531:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1532:                    if (idx_elem >= mesh->ne) return;
 1533: 
 1534: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1535:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1536:                    if (idx_node >= mesh->np) return;
 1537: 
 1538: 
 1539: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1540:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1541:                            if (idx_node_bnd >= mesh->nbp) return;
 1542: 
 1543: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1544:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1545:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1546: 
 1547: Polynomial<4> *polyDischarge; // XXX read from file
