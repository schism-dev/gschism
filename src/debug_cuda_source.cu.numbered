 1334: // This struct is used to store the boundary information for a node.
 1335: struct NodeBoundary {   
 1336:    int idx;
 1337:    BoundarySegment *segment;
 1338:    Node *node;
 1339:    
 1340:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1341:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1342: 
 1343:    bool isLand;
 1344: 
 1345:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1346:    double elbc;   // Elevation boundary condition
 1347:    double eth;    // Elevation time history
 1348: 
 1349:    double eta_mean; // Mean elevation at nodes
 1350: 
 1351:    bool isEssentialBC;
 1352: 
 1353:    Vector2 uth[nvrt];  // "Time history" velocity
 1354: 
 1355:    // Arrays for harmonic constituents (if needed)
 1356:    double  emo[nbfr];  // Elevation amplitude
 1357:    double  efa[nbfr];  // Elevation phase
 1358:    Vector2 umo[nbfr];  // velocity amplitude
 1359:    Vector2 ufa[nbfr];  // velocity phase
 1360: 
 1361: 
 1362:    NodeBoundary(void) {
 1363:       isLand = false;
 1364:    }
 1365:    NodeBoundary(bool _isLand) {
 1366:       isLand = _isLand;
 1367:    }
 1368: 
 1369:    
 1370:    __forceinline__ __device__ int numSidesForAverage() const {
 1371:    // Returns the number of sides that are connected to the node and have the same segment.
 1372:    // This is used to compute the average velocity at the node for open boundary nodes.
 1373:       int res = 0;
 1374:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1375:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1376: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1377:       return res;
 1378:    }
 1379: 
 1380: 
 1381:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1382:       assert(index == 0 || index == 1); 
 1383:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1384:    }
 1385: 
 1386:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1387:       if (isLand) return;  // land never uses these links
 1388:       SideBoundary *null = nullptr;
 1389:       if (atomicCAS((unsigned long long *)&sideBnd1,
 1390:                   (unsigned long long)null,
 1391:                   (unsigned long long)sb) == (unsigned long long)null)
 1392:          return;
 1393:       if (atomicCAS((unsigned long long *)&sideBnd2,
 1394:                   (unsigned long long)null,
 1395:                   (unsigned long long)sb) == (unsigned long long)null)
 1396:          return;
 1397:       // both slots taken. OK if this side was already linked
 1398:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1399:    }
 1400: 
 1401: 
 1402: };
 1403: 
 1404: struct Node {
 1405: 
 1406:    // Geometry information
 1407:    int idx;        // Index of the node
 1408:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1409:    int numNodes;   // Number of nodes neighbors of this node
 1410: 
 1411:    Element **elements; // Array of pointers to the elements that share this node
 1412:    int numElements;    // Number of elements that share this node
 1413: 
 1414:    int numSides;       // Number of sides that are connected to this node
 1415: 
 1416:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1417:    double gz;          // Global vertical coordinate at the node.
 1418:    Vector2 u2[nvrt];
 1419:    double  w2[nvrt];
 1420:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1421:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1422:    double lon, lat;
 1423:    double depth;
 1424: 
 1425:    Frame<ics> frame;
 1426: 
 1427:    LocalSigma<ivcor> localSigma;  
 1428: 
 1429:    int kb;       // Bottom index of the node
 1430: 
 1431:    bool isDry;     // True if the node is dry
 1432: 
 1433:    int iadv;     // Advection flag
 1434: 
 1435:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1436:                           // this is nullptr
 1437: 
 1438:    TempVar tmp; // Temporary variable to store different types of variables
 1439: 
 1440:    // Physical information
 1441:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1442:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1443: 
 1444:    double rho[nvrt];     // Density
 1445:    double dfv[nvrt];     // Vertical viscosity
 1446: 
 1447:    double eta1; // Elevation at nodes at previous timestep
 1448:    double eta2; // Elevation at nodes at current timestep
 1449: 
 1450:    double ETP;  // Earth Tidal Potential
 1451: 
 1452:    double pr;    // Air pressure
 1453:    double grav2; // Gravity 
 1454:    
 1455:    Vector2 dav;  // Depth averaged velocity
 1456: 
 1457:    Vector2 tau; // Wind stress vector
 1458: 
 1459:    // Vegetation parameters
 1460:    double veg_h;
 1461:    double veg_nv;
 1462:    double veg_di;
 1463:    double veg_Cd;
 1464:    double veg_h_unbent;
 1465:    double veg_di_unbent;
 1466:    double veg_nv_unbent;
 1467:    double veg_alpha_vert_mean;
 1468:    double veg_alpha0;
 1469:    double veg_alpha3D[nvrt];
 1470: 
 1471:    // Bottom drag parameters
 1472:    double Cd;       // Bottom drag coefficient   
 1473: 
 1474:    // These three are mutually exclusive
 1475:    union {
 1476:       double rmanning; // Bottom Manning's coefficient
 1477:       double rough;    // Bottom roughness length
 1478:       double drag;     // Bottom drag coefficient
 1479:    };
 1480:    Vector2 tau_bot; // Bottom stress vector
 1481: 
 1482:    // XXXX REMOVE FOR IMM>0???
 1483:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1484:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1485: 
 1486:    double qel; // RHS
 1487:    double coeffDiag; // Diagonal coefficient of the matrix
 1488:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1489: 
 1490:    // This was used by a previous version of the conjugate gradient method
 1491:    // double mP; // Search direction for conjugate gradient method
 1492:    // double mR; // Residual for conjugate gradient method
 1493:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1494: 
 1495:    double mX; // Solution of the FEM system
 1496: 
 1497:    // Meteorological forcing
 1498:    Vector2 u_air;
 1499:    double p_air;  // XXXX is this the same as pr?
 1500:    double t_air;
 1501:    double q_air;
 1502:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1503: 
 1504:    __device__ void setWind(Vector2 &u) {
 1505:    // Sets the wind vector taking into account the mesh angle
 1506:    
 1507:       const double speed = length(u);
 1508: 
 1509:       // Rotate wind vector to the node frame
 1510:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1511: 
 1512:       // Sets the surface stress vector due to wind.
 1513:       if constexpr(nws == 0) {
 1514:          tau = {0.0, 0.0};
 1515: 
 1516:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1517:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1518: 
 1519:       } else {
 1520: 
 1521:          double dragcoef;
 1522: 
 1523:          if constexpr(iwind_form == -1) {
 1524:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1525:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1526: 
 1527:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1528:             tau = cff*u_air;
 1529:  
 1530:          } else if constexpr(iwind_form == 1) {
 1531:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1532:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1533: 
 1534:             dragcoef = max(dragcoef, 4.0e-4);
 1535:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1536:             tau = cff*u_air;
 1537: 
 1538:          } else {
 1539:             tau = {0.0, 0.0};
 1540:          }
 1541:       }
 1542:    }
 1543: 
 1544: 
 1545:    __device__ void setFrame(double lat, double lon) {
 1546:       if constexpr(ics == 1) return;
 1547: 
 1548:       frame.update(lat, lon);        
 1549:     }
 1550: 
 1551:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1552: 
 1553:    __device__ double sigmaTransitionDepth(void) const;
 1554: 
 1555:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1556: 
 1557:    __inline__ __device__ Point2 outputCoords(void) const {
 1558:       if constexpr(ics == 1)  return p;
 1559:       else                    return {rad2deg*lon, rad2deg*lat};
 1560:    }
 1561: 
 1562:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1563:    // If ics == 2, convert the global point to the local frame
 1564:       
 1565:       if constexpr (ics == 1) {
 1566:          return p;
 1567:       } else {
 1568:          const Point3 c = {p.x, p.y, gz};
 1569:          const Point3 local = frame.G2L(p - c);
 1570:          return local;
 1571:       }
 1572:    }
 1573: 
 1574:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1575:    // If ics == 2, convert the global point to the local frame
 1576:       
 1577:       if constexpr (ics == 1) {
 1578:          return p;
 1579:       } else {
 1580:          const Point3 c = {p.x, p.y, gz};
 1581:          return c + frame.L2G(p);
 1582:       }
 1583:    }
 1584: 
 1585:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1586:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1587:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1588:    
 1589:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1590: 
 1591:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1592: 
 1593:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1594:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1595: 
 1596:    __device__ __forceinline__ void clearMatrixRow(void) {
 1597:       // Clear the matrix row for this node
 1598: 
 1599: 
 1600:       coeffDiag = 0.0;
 1601: 
 1602:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1603: 
 1604:    }
 1605: 
 1606:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1607:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1608:       
 1609:       if (node == this) {
 1610:          coeffDiag += value;
 1611:      
 1612:       } else {
 1613:          // Search (linearly) the index of the node in the array of nodes
 1614:          // XXX: This is not efficient, see if we can improve this
 1615:          int i;
 1616:          for (i = 0; i < numNodes; i++) {
 1617:             if (nodes[i] == node) {
 1618:                break;
 1619:             }
 1620:          }
 1621:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1622:          coeffMatrix[i] += value;
 1623:       }
 1624:    }
 1625: 
 1626: 
 1627:    __device__ __inline__ void updateZCoordData(void);
 1628: 
 1629:    __device__ __forceinline__ double compZCoord(int k) const;
 1630: 
 1631:    __device__ void updateKb(void);
 1632: 
 1633:    __device__ __forceinline__ void computeBottomDragCd(void);
 1634: 
 1635: 
 1636: 
 1637: };
