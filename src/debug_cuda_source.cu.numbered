 2579:    template<typename T>
 2580:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2581:       T values[4];
 2582:       getNodalValues(level, func, values);
 2583: 
 2584:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2585:       if constexpr (IsVector2<T>::value && ics == 2) {
 2586: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2587:          projectNodeVectorsToElementFrame(values);
 2588: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2589:       }
 2590: 
 2591:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2592:    }
 2593: 
 2594:    template<typename T>
 2595:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2596:       T values[4];
 2597:       getNodalValues(field, values);
 2598: 
 2599:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2600:       if constexpr (IsVector2<T>::value && ics == 2) {
 2601: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2602:          projectNodeVectorsToElementFrame(values);
 2603: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2604:       }
 2605:       
 2606:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2607:    }
