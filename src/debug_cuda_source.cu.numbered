10234: 
10235: __global__ void returnMatrix(double *res) {
10236:    // Debugging: dense local matrix, row-major, size = mesh->np
10237:    // Assumes single-partition / local indexing (see note below).
10238: 
10239:    const int size = mesh->np;
10240: 
10241:    for (int idx_node = 0; idx_node < size; idx_node++) {
10242:       const Node *node = mesh->localNodeData + idx_node;
10243: 
10244:       res[idx_node * size + idx_node] = *(node->coeffDiag);
10245: 
10246:       for (int j = 0; j < node->numNodes; j++) {
10247:          const Node *nbNode = node->nodes[j];
10248:          // Only dump neighbors that live on this partition
10249:          if (nbNode->part != mesh->partNum) continue;
10250: 
10251:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
10252:          const double aij = node->coeffRow[node->csrSlot[j]];
10253:          if (aij != 0.0)
10254:             res[jlocal * size + idx_node] = aij;
10255:       }
10256:    }
10257: }
