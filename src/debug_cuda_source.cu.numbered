 8191:    const int size = mesh->np;
 8192:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8193:       const Node *node = mesh->localNodeData + idx_node;
 8194:       res[idx_node*size + idx_node] = node->coeffDiag;
 8195:       for (int j = 0; j < node->numNodes; j++) {
 8196:          Node* nbNode = node->nodes[j];
 8197:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8198:       }
 8199: 
 8200:    }
 8201:    
 8202: }
