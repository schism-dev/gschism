 3693:    __global__ void computeElevationBoundaryConditions(double time) {
 3694:       // Compute elevation essential boundary conditions 
 3695: 
 3696:       NODE_BND(nodeBnd); // Each boundary node.
 3697: 
 3698:       const Node *node = nodeBnd->node;
 3699:       const int iettype = nodeBnd->iettype;
 3700: 
 3701:       double eic = 0.0;
 3702:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3703:       else               eic = 0.0;
 3704: 
 3705:       const double r_eic = (1.0 - ramp)*eic; 
 3706:       const double r_eth = ramp*nodeBnd->eth;
 3707:       double eta1_bar = r_eic;
 3708: 
 3709: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3710:       // Compute tide elevation
 3711:       if (iettype == 3 || iettype == 5) {   
 3712: 
 3713:          if constexpr(iloadtide==1) { // loading tide
 3714:             assert(false && "Loading tide not implemented");
 3715:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3716:          }
 3717:          
 3718:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3719: 
 3720:             const double efa  = nodeBnd->efa[jfr]; 
 3721:             const double emo  = nodeBnd->emo[jfr]; 
 3722: 
 3723:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3724:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3725:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3726: 
 3727:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3728:          } // for jfr
 3729: 
 3730:       } // if iettype
 3731: 
 3732:       switch (iettype) {
 3733:          case 1:
 3734:          case 2:
 3735:             nodeBnd->elbc = r_eth + r_eic;
 3736:             break;
 3737:          case 3:
 3738:             nodeBnd->elbc = eta1_bar + r_eic;
 3739:             break;
 3740:          case 4:
 3741:             nodeBnd->elbc = r_eth + r_eic;
 3742:             break;
 3743:          case 5:
 3744:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3745:             break;
 3746:       } // switch
 3747: 
 3748: 
 3749:       //Add inverse barometric effects
 3750:       if (iettype != 0 && inv_atm_bnd == 1) {
 3751:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3752:       }
 3753: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3754:    }
 3755: 
 3756: 
 3757:    __global__ void setEssentialBC(void) {
 3758:       // Set essential boundary conditions 
 3759:       NODE(node); // Each boundary node
 3760:       NodeBoundary *nodeBnd = node->nodeBnd;
 3761: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3762:       
 3763: // nodeBnd->isEssentialBC = true;      
 3764:       // Check if this node has essential BC
 3765:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3766:          // Verify BC value is valid
 3767:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3768: 
 3769:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3770:          
 3771:          // Set diagonal to 1 and zero off-diagonals
 3772:          node->coeffDiag = 1.0;
 3773:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3774: 
 3775:          for (int j = 0; j < node->numNodes; j++) {
 3776:                node->coeffMatrix[j] = 0.0;
 3777:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3778:          }
 3779:          
 3780:          // Set solution and RHS to BC value
 3781:          node->mX  = nodeBnd->elbc;
 3782:          node->qel = nodeBnd->elbc;
 3783: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3784:       } else {
 3785:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3786: 
 3787:          for (int j = 0; j < node->numNodes; j++) {
 3788:                Node* nbNode = node->nodes[j];
 3789:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3790:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3791:                   // Verify neighbor's BC value
 3792:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3793: 
 3794:                   // Subtract contribution to RHS
 3795:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3796:                   node->coeffMatrix[j] = 0.0;  
 3797:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3798:                }
 3799:          }
 3800:       }
 3801:    }
 3802: 
 3803: 
 3804:    __global__ void updateElevation(void) {
 3805:       NODE(node);
 3806: 
 3807:       node->eta2 = node->mX;
 3808: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3809:    }
