 3450: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3451: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3452: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3453: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3454: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3455: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3456: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3457: 
 3458: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3459: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3460: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3461: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3462: 
 3463: 
 3464: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3465: 
 3466: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3467:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3468:    if constexpr(ics == 1) { 
 3469:       return 0.5*(n1->tau + n2->tau);
 3470: 
 3471:    } else {
 3472:       // Project the tau from the node frames to the side frame
 3473:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3474:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3475: 
 3476:       return 0.5*(stau1 + stau2);
 3477:    }
 3478: }
 3479: 
 3480: /**
 3481:  * This method performs backtracking from the side center until a time -dt back in time 
 3482:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3483:  * intermediate point.
 3484:  *
 3485:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3486:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3487:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3488:  * remaining time.
 3489:  * 
 3490:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3491:  * 
 3492:  * @param uuint, vvint, wwint: Velocities at the final point
 3493:  * @param jlev: Level at which the backtracking is performed
 3494:  * @param dt, dtbk: Tracking timesteps
 3495:   */
 3496: __inline__ __device__ void Side::btrack(
 3497:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3498:       double dt,            // Tracking time
 3499:       double dtbk,          // Tracking timestep
 3500:       Vector3 &u_int        // Velocities at the initial point
 3501: ) const {
 3502: 
 3503:    // Start from side center
 3504:    Point3 x0;
 3505: 
 3506:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3507:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3508: 
 3509:  
 3510:    double time_rm = dt; // Remaining time
 3511:    double time_rm_1 = 1e10;
 3512:    double time_rm_2 = 2e10;
 3513:    double time_rm_3 = 3e10;
 3514: 
 3515: 
 3516:    // Initial velocities
 3517:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3518: 
 3519: 
 3520:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3521:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3522: 
 3523:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3524: 
 3525: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3526: 
 3527: 
 3528:    constexpr int MAX_ITERATIONS = 100; 
 3529:    int iter = 0;
 3530:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3531:    while(true) {
 3532: 
 3533:       // Calculate timestep
 3534:       const double dtb = min(dtbk, time_rm);
 3535: 
 3536: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3537: 
 3538:       // Next point in the backtracking curve
 3539:       xt = x0 - dtb*u_int;
 3540: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3541: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3542: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3543: // if ((jlev==45))
 3544: // {
 3545: // // const Point3 p1 = toLocalFrame(x0);
 3546: // // const Point3 p2 = toLocalFrame(xt);
 3547: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3548: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3549:     
 3550: // }
 3551: 
 3552: 
 3553:       Side *lastCrossSide = nullptr;
 3554:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3555: 
 3556: 
 3557: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3558: 
 3559:       if (time_rm_3 <= time_rm) {
 3560:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3561:          xt = x0;
 3562:          break;
 3563:       }
 3564: 
 3565: 
 3566:       // This means that the walk reached a boundary or a dry element.
 3567:       if (!found) {
 3568: 
 3569: 
 3570:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3571: 
 3572:          // Finds the point at the boundary where the line segment x0xt intersects.
 3573:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3574:          // due to floating point errors, it does not exactly intersect.
 3575:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3576:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3577:          // To compute the intersection point we start with the parametric equations.
 3578:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3579:          // We cross-prouct by v1 to cancel the s term:
 3580:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3581:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3582: 
 3583:          // Side coordinates in the origSide frame.
 3584:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3585:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3586: 
 3587:          const Vector2 v1 = toPoint2(xt) - toPoint2(x0);
 3588:          const Vector2 v2 = p2 - p1;
 3589: 
 3590:          Point2  p0 = {x0.x, x0.y};
 3591:          Point2  pt = {xt.x, xt.y};
 3592: 
 3593:          // We are assuming intersection, so we clamp t to the range [0,1].
 3594:          const double denom = cross(v2, v1);
 3595:          
 3596:          double t, s; // parameters for the line segments p0pt and p1p2
 3597: 
 3598: 
 3599:          if (abs(denom) < small) {
 3600:             // small denominators are fairly common. They occur when the line segment x0xt 
 3601:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3602:             // boundary, where the backtracking curve startt sliding along the boundary.
 3603:             // In this case, we simply assume that the two lines are very close to each other
 3604:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3605:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3606: 
 3607:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3608:             clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3609: 
 3610:          }
 3611:          else {
 3612:             
 3613:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3614: 
 3615:             // From the originaL equation we can solve for s:
 3616:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3617:             // Computing the dot product by v1, we get:
 3618:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3619:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3620:          }
 3621: 
 3622:          
 3623:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3624:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3625: 
 3626: 
 3627: 
 3628:          // We update the new target point to be right at the intersection point,
 3629:          // and the remaining time must include the time we haven't "used".
 3630:          time_rm -= s*dtb;
 3631:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z-x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3632: 
 3633: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3634: // xct = toLocalFrame(xct);
 3635: // xt = (1-0.00001)*xt + 0.00001*xct;
 3636:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3637:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3638: 
 3639:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3640:          // but extracting only the component along the tangent vector v2.
 3641:          Vector2 tangent = normalize(v2);
 3642:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3643: 
 3644:          const Vector2 u2D = make_double2(u.x, u.y);
 3645:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3646: 
 3647: 
 3648:       } else {
 3649: 
 3650:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3651: 
 3652:          time_rm -= dtb; 
 3653: 
 3654:          u_int = curElem->interpolateVelocities(xt, this);
 3655: 
 3656:       }
 3657: 
 3658:       if (time_rm <= 0.0) break; 
 3659: 
 3660:       // If the velocity is too small, we stop the backtracking
 3661:       const double vmag2 = norm2(toVector2(u_int));
 3662:       if (vmag2 <= velmin_btrack_sq)  {
 3663: 
 3664:          time_rm = 0.0; 
 3665:          return; 
 3666:       }
 3667: 
 3668:       // The current point becomes the next segment's starting point.
 3669:       x0 = xt;
 3670:  
 3671:       iter++;
 3672: if (iter>39) break;
 3673:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3674: 
 3675: 
 3676:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3677:       time_rm_3 = time_rm_2;
 3678:       time_rm_2 = time_rm_1;
 3679:       time_rm_1 = time_rm;
 3680:    }
 3681: 
 3682:    assert(curElem != nullptr && "Final element is nullptr");
 3683:    assert(!curElem->isDry && "Final element is dry");
 3684:    
 3685: 
 3686: 
 3687:    // Interpolate the velocities at the final point with respect to the current side frame
 3688:    u_int = curElem->interpolateVelocities(xt, this);
 3689: 
 3690: 
 3691: }
 3692: 
 3693: 
 3694: 
 3695: 
 3696: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3697: 
 3698: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3699: 
 3700:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3701:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3702: 
 3703: 
 3704: 
 3705:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3706:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3707: 
 3708:    double fun_lat = 0.0;
 3709:    switch (jspc[idxComp]) {
 3710:       case 0:
 3711:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3712:          break;
 3713:       case 1:
 3714:          fun_lat = sin(2.0*lat);
 3715:          break;
 3716:       case 2:
 3717:          fun_lat = pow<2>(cos(lat));
 3718:          break;
 3719:       default:
 3720:          assert(false && "computeETP: invalid jspc");
 3721:    }
 3722:    
 3723:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3724: 
 3725: }
 3726: 
 3727: 
 3728: __device__ void Node::updateKb(void) {
 3729: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3730: 
 3731:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3732: 
 3733: 
 3734:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3735: 
 3736:    if constexpr(ivcor == 2) {  // SZ coordinates
 3737:       
 3738:       // Compute bottom level index
 3739:       if (depth <= mesh->h_s) {
 3740:          kb = izlev;   
 3741:          
 3742:       } else {
 3743:          kb = -1;
 3744:          int L = 0;
 3745:          int R = nzlev; 
 3746:          
 3747:          while (L <= R) {
 3748:             int M = (R + L) / 2;
 3749: 
 3750: 
 3751:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3752:             
 3753:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3754:                R = M;
 3755:             } else {
 3756:                L = M;
 3757:             }
 3758: 
 3759:             if (R - L == 1) {
 3760:                kb = L;
 3761:                break;
 3762:             }
 3763:          }
 3764: 
 3765:          // Checks that the binary search was successful
 3766:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3767:        
 3768:       }
 3769:    } 
 3770: }
 3771: 
 3772: 
 3773: __device__ __inline__ void Node::updateZCoordData(void) {
 3774: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3775: 
 3776:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3777:    // if (isDry2()) {
 3778:    //    kb = -1;  // XXXXXXXX KKKKK
 3779:    //    return;
 3780:    // }
 3781: 
 3782: 
 3783:    if constexpr(ivcor == 2) {  // SZ coordinates
 3784:       
 3785:       // Compute bottom level index
 3786:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3787:    } 
 3788:    else {  // if (ivcor == 1) Localized sigma
 3789:       // Do nothing
 3790:    }
 3791: 
 3792: 
 3793: }
 3794: 
 3795: 
 3796: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3797:    // Computes the z coordinate at level k.
 3798:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3799:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3800:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3801:    // used 
 3802: 
 3803:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3804:    
 3805:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3806: 
 3807:    if (isDry2()) return 0.0;  
 3808: 
 3809:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3810: 
 3811:    if constexpr(ivcor == 2) {
 3812: 
 3813:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3814:       const double h_c = mesh->h_c;
 3815:       const double theta_f = mesh->theta_f;
 3816:       const double sinh_theta_f = mesh->sinh_theta_f;
 3817: 
 3818: 
 3819:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3820:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3821:       // once per time step/node. XXXX
 3822:       // CHECK: updateZCoordData
 3823: 
 3824:       //  To simplify comparisons, I define index versions of count variables.
 3825:       if      (k == ivrt)     return eta2; 
 3826:       else if (k == izlev)    return -hmod2;
 3827:       else if (k == kb)       return -depth;
 3828:       else if (k < izlev)     return mesh->ztot[k];
 3829:       else if (k > izlev) {
 3830:          const int ksig = k - izlev;
 3831: 
 3832:          if (hmod2 <= h_c) {
 3833:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3834: 
 3835:          } 
 3836:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3837:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3838:             assert(false && "compZCoord: invalid h_c\n");
 3839:          } 
 3840:          else {
 3841:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3842:                    h_c * mesh->sigma[ksig] + 
 3843:                    (hmod2 - h_c) * mesh->cs[ksig];
 3844:          }
 3845:       } else { 
 3846:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3847:       }
 3848: 
 3849:    }
 3850:    else {  // if constexpr(ivcor == 1)
 3851:       if (k <= kb)        return -depth; 
 3852:       else if (k == ivrt) return eta2;
 3853:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3854: 
 3855:    }
 3856:    
 3857:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3858:    return 0.0;
 3859: }
 3860: 
 3861: 
 3862: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3863:    // Computes the bottom drag Cd based on the selected nchi
 3864: 
 3865:    if constexpr(nchi == 0) {
 3866:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3867:       Cd = drag;  // Read from drag file
 3868: 
 3869:    } else if constexpr(nchi == 1) {
 3870:       // 
 3871: 
 3872:       bool ltmp = false; // for WBL iteration
 3873: 
 3874:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3875:       if (isDry || (rough == 0.0)) {
 3876:          Cd = 0.0;
 3877: 
 3878:       } else { //roughness >0 
 3879:          
 3880:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3881: 
 3882:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3883: 
 3884:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3885: 
 3886:       } // if rough
 3887: 
 3888:    } else if constexpr(nchi == -1) {
 3889:    // Manning 
 3890:  
 3891:       const double htot = max(hmin_man, htot2()); 
 3892:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3893: 
 3894:    } else {
 3895:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3896:       
 3897:    } // if nchi
 3898: 
 3899: }
 3900: 
 3901: 
 3902: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3903:    // Checks if a side in on the boundary
 3904:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3905: 
 3906:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3907:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3908: 
 3909:    // Indices of the nodes that form the side
 3910:    //
 3911:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3912:    const int n1 = side.n1->idx;
 3913:    const int n2 = side.n2->idx;
 3914:    isLand = false;
 3915:    
 3916: 
 3917:    // Check if the side is on a land boundary
 3918:    for (int i = 0; i < nland; i++) {
 3919:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3920:          // Consecutive nodes in the land boundary segment
 3921:          const int b1 = ilnd[i + j*nland];
 3922:          const int b2 = ilnd[i + (j + 1)*nland];
 3923: 
 3924:          assert(b1 != -1 && b2 != -1);
 3925: 
 3926:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3927:             
 3928:             isLand = true;
 3929:             return i;
 3930:          }
 3931:       }
 3932:    }
 3933: 
 3934:    // Check if the side is on an open boundary
 3935:    for (int i = 0; i < nope; i++) {
 3936:       for (int j = 0; j < nond[i] - 1; j++) {
 3937:          // Consecutive nodes in the open boundary segment
 3938:          const int b1 = iond[i + j*nope];
 3939:          const int b2 = iond[i + (j + 1)*nope];
 3940: 
 3941:          assert(b1 != -1 && b2 != -1);
 3942: 
 3943:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3944:             isLand = false;
 3945:             return i;
 3946:          }
 3947:       }
 3948:    }
 3949: 
 3950:    return -1;
 3951: }
 3952: 
 3953: 
 3954: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3955:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3956:                                     double *wind_rotate_angle, 
 3957:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3958:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3959:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3960:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3961:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3962: 
 3963:    NODE(pnode);  
 3964:    const int i = idx_node;
 3965:    Node &node(*pnode);
 3966: 
 3967:    node.idx = i;
 3968: 
 3969:    const int idxNodeStart = nodeNeighNodesStart[i];
 3970:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3971:    node.numNodes = idxNodeEnd - idxNodeStart;
 3972:    node.nodes = nodeNeighNodes + idxNodeStart;
 3973:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3974: 
 3975: 
 3976: 
 3977:    const int idxElemStart = nodeNeighElemsStart[i];
 3978:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3979:    node.numElements = idxElemEnd - idxElemStart;
 3980:    node.elements = nodeNeighElems + idxElemStart;
 3981: 
 3982: 
 3983:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3984:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3985:       const int partNode = localNodePart[idxNodeGlobal]; 
 3986:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3987: 
 3988:       Node *node_ptr = nodes[partNode] + idxNode;
 3989:       
 3990:       nodeNeighNodes[idx] = node_ptr;
 3991:    }
 3992: 
 3993: 
 3994:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3995:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3996:       const int partElem = localElemPart[idxElemGlobal];
 3997:       const int idxElem  = localElemIndices[idxElemGlobal];
 3998: 
 3999:       Element *elem_ptr = elems[partElem] + idxElem;
 4000: 
 4001:       nodeNeighElems[idx] = elem_ptr;
 4002:    }      
 4003: 
 4004:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4005:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4006: 
 4007:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4008: 
 4009:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4010:    if constexpr(ics == 1) {
 4011:       node.p.x   = node_coords[i * 3];
 4012:       node.p.y   = node_coords[i * 3 + 1];
 4013:       node.gz = 0.0;
 4014: 
 4015:    } else {
 4016:       const double lon = deg2rad*node_coords[i * 3];
 4017:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4018: 
 4019:       Point3 p = computeXYZfromLatLon(lat, lon);
 4020:       node.p = toVector2(p);
 4021:       node.gz = p.z;
 4022:       node.lon = lon;
 4023:       node.lat = lat;
 4024: 
 4025:       #ifdef USE_FRAMES
 4026:       node.setFrame(lat, lon);
 4027:       #endif
 4028: 
 4029: 
 4030:    }
 4031: 
 4032:    node.depth = node_coords[i * 3 + 2];
 4033: 
 4034:    node.numSides = 0;
 4035: 
 4036:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4037:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 4038:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 4039:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 4040:    else assert(false && "populateNodes: selected nchi not implemented.");
 4041:    
 4042:    if constexpr(ivcor == 1) 
 4043:    {  
 4044:       node.kb = kb[i];
 4045:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 4046:    }
 4047: 
 4048:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4049:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4050:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4051: 
 4052:    
 4053:    // Links the node to the boundary information
 4054:    if (isbnd[i] >= 0) {
 4055:      
 4056:       // Get the index of the node boundary
 4057:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4058: 
 4059:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4060:       node.nodeBnd->node = &node;
 4061: 
 4062:       node.nodeBnd->sideBnd1 = nullptr;
 4063:       node.nodeBnd->sideBnd2 = nullptr;
 4064: 
 4065:       if (isbnd[i]>=0) {
 4066: 
 4067:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 4068:          
 4069:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4070:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4071: 
 4072:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4073:          node.nodeBnd->segment->clen  = nan("1");
 4074:          node.nodeBnd->segment->carea = nan("1");
 4075: 
 4076:       }
 4077:    } else {
 4078: 
 4079:       node.nodeBnd = nullptr; // For internal nodes
 4080: 
 4081:       if (isbnd[i] == landSegment) {
 4082:          node.nodeBnd = &landBoundaryNode;
 4083:          node.nodeBnd->segment = &landBoundarySegment;
 4084:       }
 4085:       
 4086:    }
 4087:    
 4088:    // XXXX GAUSSIAN HILL VELOCITIES
 4089:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4090:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4091:          constexpr double rot_per = 3000.0;
 4092:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4093:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4094:       // XXXXX
 4095:    #endif
 4096: 
 4097: }
 4098: 
 4099: 
 4100: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4101:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4102:                                     double *wind_rotate_angle,   
 4103:                                     int *isdel, int *isidenode, int *isbnd,
 4104:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4105:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4106:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4107:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4108:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4109:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4110:                                     double *drag, double *roughness) {
 4111: 
 4112: 
 4113:    SIDE(pside);
 4114:    Side &side(*pside);
 4115:    const int i = idx_side;
 4116: 
 4117:    side.idx = i;  
 4118:    
 4119:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4120:    const double fc   = 2.0*omega_e*sin(sfea0);
 4121:    const double beta = 2.0*omega_e*cos(sfea0);
 4122: 
 4123:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4124: 
 4125:    // finding the pointer to the nodes that form the side
 4126:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4127:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4128: 
 4129:    const int locidx_n1 = localNodeIndices[idx_n1];
 4130:    const int locidx_n2 = localNodeIndices[idx_n2];
 4131:    const int part_n1 =   localNodePart[idx_n1];
 4132:    const int part_n2 =   localNodePart[idx_n2];
 4133: 
 4134:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4135:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4136: 
 4137: 
 4138:    // Counts the number of sides connected to each node
 4139:    side.n1->numSides++;
 4140:    side.n2->numSides++;
 4141: 
 4142:    // Side boundary type
 4143:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4144:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4145: 
 4146:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4147:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4148:    {
 4149:       bool isLand = false;
 4150:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4151:       
 4152:       if (isbs > -1) {
 4153:          // assert(isLand || isbs>=0);
 4154:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4155: 
 4156:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4157: 
 4158:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4159:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4160: 
 4161:          assert (isLand == side.sideBnd->segment->isLand);
 4162: 
 4163:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4164:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4165:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4166: 
 4167:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4168:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4169:          
 4170:          side.sideBnd->side = &side;
 4171: 
 4172:       }
 4173:       else {
 4174:          side.sideBnd = nullptr;
 4175:       }
 4176:    }
 4177:    else 
 4178:    {
 4179:       side.sideBnd = nullptr;
 4180:    }
 4181: 
 4182: 
 4183:    // finding the pointer to the elements that share the side
 4184:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4185:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4186: 
 4187:    if (idx_e1 > -1) {
 4188:       const int locidx_e1 = localElemIndices[idx_e1];
 4189:       const int part_e1 =  localElemPart[idx_e1];
 4190:       side.elems[0] = elems[part_e1] + locidx_e1;
 4191: 
 4192:    }
 4193:    else {
 4194:       side.elems[0] = nullptr;
 4195:    }
 4196: 
 4197:    if (idx_e2 > -1) {
 4198:       const int locidx_e2 = localElemIndices[idx_e2];
 4199:       const int part_e2 =  localElemPart[idx_e2];
 4200:       side.elems[1] = elems[part_e2] + locidx_e2;
 4201:    }
 4202:    else {
 4203:       side.elems[1] = nullptr;
 4204:    }
 4205:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4206:       
 4207:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4208:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4209:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4210:          
 4211:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4212:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4213:       // printf("sideBnd: %p\n", side.sideBnd);
 4214:       // assert(false && "Side has no elements and no boundary");
 4215:    }
 4216:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4217: 
 4218:    // Compute the center of the side
 4219:    side.center = 0.5*(side.n1->p + side.n2->p);
 4220: 
 4221:    #ifdef USE_FRAMES
 4222:    side.setFrame();
 4223:    #endif
 4224: 
 4225:    // Normal, unitary vector to the side
 4226:    if constexpr(ics == 1) {
 4227:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4228:       side.n = normalize(side.n);
 4229:    }
 4230:    else {
 4231:       // Unit side vector in 3D cartesian coordinates
 4232:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4233: 
 4234:       nSide = normalize(nSide);
 4235: 
 4236:       // Its cross product with the unit local z-axis vector (nUp) is the
 4237:       // normal vector we are looking for.
 4238:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4239: 
 4240:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4241:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4242:       side.n = -normalize(n2D); 
 4243: 
 4244:    }
 4245: 
 4246:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4247:    side.shapiro = shapiro0;
 4248: 
 4249:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4250:    // XXXX
 4251:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4252:    constexpr double rot_per=3000.0;
 4253:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4254:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4255:    // XXXXX      
 4256:    #endif
 4257:    // Compute the z level at the center of the side
 4258:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4259:    
 4260:    // Compute the length of the side
 4261:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4262: 
 4263: 
 4264:    // Compute the Coriolis coefficient
 4265: 
 4266:    if constexpr(ncor == -1 || ncor == 0) {
 4267:       side.coriolis = coricoef;
 4268:    }
 4269:    else {
 4270:       const double sphi = side.lat();  // Latitude at the center of the side
 4271: 
 4272:       assert(use_ll && "use_ll must be true when ncor > 0");
 4273: 
 4274:       if constexpr(ics == 1) {
 4275:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4276:       }
 4277:       else { // ics == 2
 4278:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4279:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4280:       }
 4281: 
 4282:    }
 4283: 
 4284: }
 4285: 
 4286: 
 4287: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4288:    double *node_coords, double *node_coords_ll, bool use_ll,
 4289:    double *wind_rotate_angle,   
 4290:    int *isdel, int *isidenode, int *isbnd,
 4291:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4292:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4293:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4294:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4295:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4296:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4297:    double *drag, double *roughness) {
 4298: 
 4299:    ELEM(pelem);
 4300:    Element &elem(*pelem);
 4301:    const int i = idx_elem;
 4302: 
 4303:    elem.idx = i;
 4304: 
 4305:    for (int j = 0; j < i34[i]; j++) {
 4306:       const int idxNode = elnode[i*4 + j];  
 4307:       const int idxSide = elside[i*4 + j];
 4308:       
 4309:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4310:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4311: 
 4312:       // Find the neighboring element  
 4313:       if (elem.sides[j]->elems[0] == &elem) {
 4314:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4315:       }
 4316:       else {
 4317:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4318:       }
 4319:       
 4320:    }
 4321: 
 4322:    elem.i34 = i34[i];
 4323: 
 4324:    // Compute the barycenter of the element and its depth
 4325:    elem.center = {0.0, 0.0};
 4326:    elem.depth = 1e10;
 4327:    for (int j = 0; j < i34[i]; j++) {
 4328: 
 4329:       elem.center += elem.nodes[j]->p/i34[i];
 4330:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4331:    }
 4332: 
 4333:    #ifdef USE_FRAMES
 4334:    elem.setFrame();
 4335:    #endif
 4336: 
 4337:    elem.area = elem.computeSignedArea(); 
 4338:    elem.radius = sqrt(elem.area)/pi; 
 4339:    
 4340:    // Determines which way the normal vector to each side is oriented.
 4341:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4342:    for (int j = 0; j < i34[i]; j++)  
 4343:    {
 4344:       if (elem.sides[j]->elems[0] == &elem) {
 4345:          elem.ssign[j] =  1.0;
 4346:       }
 4347:       else {
 4348:          elem.ssign[j] = -1.0;
 4349:       }
 4350: 
 4351:    }
 4352: 
 4353:   
 4354: 
 4355:    // Derivatives of shape functions
 4356:    //  For ics=2, this is done in the element frame
 4357:    //  For quads, the derivative is evaluated at centroid
 4358:    for (int j = 0; j < elem.i34; j++) {
 4359:       const double area = elem.area;
 4360:       const int id2 = elem.nxq(1 + j);
 4361:       const int id3 = elem.nxq(2 + j);
 4362:       const int id4 = elem.nxq(3 + j);
 4363:       if (elem.isTri()) {
 4364:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4365:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4366:          // da1/dx = (y1 - y2)/(2*area)
 4367: 
 4368:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4369:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4370:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4371: 
 4372:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4373:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4374: 
 4375:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4376: 
 4377:       }
 4378:       else  { // Quad; evaluate at centroid
 4379: 
 4380:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4381:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4382:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4383: 
 4384:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4385:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4386: 
 4387:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4388:       } // if Tri
 4389: 
 4390:    } // for j   
 4391:    
 4392:    
 4393: 
 4394: }
 4395: 
 4396: 
 4397: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4398:                                             double *emo, double *efa, 
 4399:                                             double *umo, double *ufa, 
 4400:                                             double *vmo, double *vfa,
 4401:                                             int *ifltype, int *iettype) {
 4402: 
 4403:    NODE_BND(nodeBnd);
 4404:    const int idx = idx_node_bnd;    
 4405: 
 4406:    nodeBnd->idx = idx;
 4407: 
 4408:    // Need to find the segment index and the index of the node on the segment
 4409:    int idxNode = -1;
 4410:    int iseg, i;
 4411:    for (iseg = 0; iseg < nope; iseg++) {
 4412:       // for each segment...
 4413:       for (i = 0; i < nond[iseg]; i++) {
 4414:          idxNode = iond[iseg + i*nope];
 4415:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4416:          
 4417:       }
 4418:    }
 4419: 
 4420:    assert(iseg < nope && "iseg is out of bounds");
 4421: 
 4422: found: // Jumped here when the node was found
 4423: 
 4424:    nodeBnd->isEssentialBC = true;
 4425:    nodeBnd->elbc = 0.0;
 4426: 
 4427:    nodeBnd->segment->ifltype = ifltype[iseg];
 4428:    nodeBnd->segment->iettype = iettype[iseg];
 4429: 
 4430:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4431: 
 4432:       const int idx2 = iseg + i*nope + jfr*nope*mnond; //XXXXX CHECK
 4433: printf("populateBoundaryNodes: nodeBnd->node->idx = %d, mnond = %d, nbfr = %d, nodeBnd->segment = %p, jfr = %d, idx2 = %d, efa = %.17f, emo = %.17f, umo = (%.17f, %.17f), ufa = (%.17f, %.17f)\n", nodeBnd->node->idx, mnond, nbfr, nodeBnd->segment, jfr, idx2, efa[idx2], emo[idx2], umo[idx2], vmo[idx2], ufa[idx2], vfa[idx2]);
 4434:       nodeBnd->efa[jfr] = efa[idx2];
 4435:       nodeBnd->emo[jfr] = emo[idx2];
 4436:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4437:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4438: 
 4439:    }
 4440:         
 4441: 
 4442: }
 4443: 
 4444: __device__ void Mesh::populateBoundarySideLinks(void) {
 4445: 
 4446:    SIDE_BND(sideBnd);
 4447: 
 4448:    const Side *side = sideBnd->side;
 4449: 
 4450:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4451:    // and the rightSide is the side s that has s->n1 == side->n2
 4452:    for (int i = 0; i < mesh->nbs; i++) {
 4453: 
 4454:       Side *s = &mesh->localSideData[i];
 4455: 
 4456:       if (s == side) continue;  // Do not link the side to itself
 4457:    
 4458:       if (s->n1 == side->n2) sideBnd->leftSide = s;
 4459:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4460:    }
 4461:    
 4462: }
