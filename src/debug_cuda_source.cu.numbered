 1199:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1200:    {
 1201:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1202:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1203:       if (isQuad()) {
 1204:          gx += a[3]*gradPhi[3].x;
 1205:          gy += a[3]*gradPhi[3].y;
 1206:       }
 1207:       return {gx, gy};
 1208:    }
 1209: 
 1210:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1211:    {
 1212:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1213:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1214:       if (isQuad()) {
 1215:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1216:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1217:       }
 1218:       return {gx, gy};
 1219:    }
