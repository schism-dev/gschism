 1633: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1634:    // Computes the 3D normal vector to the element at level k
 1635:    // Returns the normal vector and the area of the element
 1636: 
 1637:       if (isTri()) {
 1638:          // For triangles...
 1639: 
 1640:          // Gets the normal vector to the element (with a length equal to twice the area)
 1641:          if constexpr(ics==1) {
 1642:             const int kb0 = max(k, nodes[0]->kb);
 1643:             const int kb1 = max(k, nodes[1]->kb);
 1644:             const int kb2 = max(k, nodes[2]->kb);
 1645: 
 1646:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1647:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1648:             
 1649:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1650:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1651:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1652:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1653: 
 1654:             area3D = sqrt(nx*nx + ny*ny + nz*nz);
 1655: 
 1656:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1657: 
 1658:             return {nx/area3D, ny/area3D, nz/area3D};
 1659: 
 1660:            
 1661:          }
 1662:          else {  // lat/lon
 1663:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1664: 
 1665:          } // if ics
 1666:       }
 1667:       else {
 1668:          // For quads...
 1669: 
 1670:          assert(false && "Element normal vector: quads not yet implemented");
 1671: 
 1672: 
 1673:       }
 1674:    }
 1675: 
 1676: /**
 1677:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1678:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1679:    If the segment is completely inside the element, then it returns true.
 1680: 
 1681:    This function assumes:
 1682:    - The initial point is on a side of the element. 
 1683:    - Its position is given by parameter t in the range [0,1].
 1684:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1685:       intersects the element (elements are convex).
 1686: 
 1687:    To find the intersection point, this function does the following:
 1688:    - it finds the intersection of the line segment with all the element side lines,
 1689:       except for the one that contains the initial point.
 1690:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1691:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1692:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1693:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1694:       track segment is almost parallel to the element side line.
 1695: 
 1696:    Inputs:
 1697:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1698:    @param x2, y2: other end of the line segment
 1699: 
 1700:    Outputs:
 1701:    @param side:  side that intersects the line segment (input and output)
 1702:    @param nextElement (output): element that contains the intersection point
 1703:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1704:    @param zint (input/output): Vertical coordinate of the intersection point
 1705: 
 1706:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1707:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1708:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1709: 
 1710:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1711:    (Delta) being zero.
 1712: 
 1713:    The intersection2 point happens when:
 1714:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1715:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1716:    
 1717:    Assumption: the 4 points (including those of the side segment) are different.
 1718:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1719:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1720:    If true, (xIntersect,yIntersect) is the intersection.				
 1721:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1722: **/
 1723: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1724:                                               double &t, double& tIntersect) {
 1725: 
 1726:    double closest_intersect_t = 1e10;
 1727:    bool found_intersection = false;
 1728: 
 1729:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1730:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1731:    const Point2 x1 = side->point(t);
 1732:    
 1733: 
 1734:    Side *nextSide = nullptr;
 1735:    for (int i = 0; i < i34; i++) {
 1736: 
 1737:       // Element's i-th side 
 1738:       Side *side2 = sides[i];
 1739: 
 1740:       // Skip the side that contains the initial point
 1741:       if (side2 == side) continue;
 1742: 
 1743:       // (x3,y3)-(x4,y4) is the element side line
 1744:       const Point2 x3 = side2->n1->p2();
 1745:       const Point2 x4 = side2->n2->p2();
 1746: 
 1747:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1748:       const double delta = cross(x2 - x1, x3 - x4);
 1749: 
 1750:       if (delta != 0.0) {
 1751: 
 1752:          const double delta1 = cross(x3 - x1, x3 - x4);
 1753:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1754: 
 1755:          // Solves the two linear equations for tt1 and tt2
 1756:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1757:          const double tt2 = delta2/delta;
 1758: 
 1759:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1760:             closest_intersect_t = min(closest_intersect_t, tt1);
 1761:             nextSide = side2;
 1762: 
 1763:             nextElement = nextSide->otherElem(this);
 1764:             tIntersect = max(small, min(tt1, 1.0-small));
 1765:             t = tt2;
 1766: 
 1767:             found_intersection = true;
 1768:          }
 1769:       
 1770:       }
 1771: 
 1772:    }
 1773:    
 1774: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1775: 
 1776: 
 1777:    // found_intersection should always be true, since we checked all the sides.  
 1778:    side = nextSide;
 1779: // if (found_intersection) {
 1780: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1781: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1782: // }   
 1783:    // if (!found_intersection) {
 1784:    //    // Check if the segment is parallel to the initial side
 1785:    //    printf("XXX segment: side = %p\n", side);
 1786:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1787:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1788:    //       assert(false && "Segment is parallel to the initial side");
 1789:    //       found_intersection = true;
 1790:    //       nextElement = side->otherElem(this);
 1791:    //       tIntersect = t;
 1792:    //       t = 0.0;
 1793:    //       found_intersection = true;
 1794:    //    }
 1795:    // }
 1796:    return found_intersection;
 1797: }
