 5328:    __global__ void resetBoundaryAreas(void) {
 5329:       // Reset boundary areas and lengths for each segment.
 5330: 
 5331:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5332:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5333:       SIDE_BND(sideBnd);
 5334: 
 5335:       BoundarySegment *segment = sideBnd->segment;
 5336: 
 5337:       segment->carea = 0.0;
 5338:       segment->clen = 0.0;
 5339:  
 5340:    }
 5341: 
 5342:    __global__ void computeBoundaryAreas(void) {
 5343:    // Calculation of cross-section areas and lengths for flow b.c.
 5344: 
 5345:       SIDE_BND(sideBnd);
 5346: 
 5347:       const Side *side = sideBnd->side;
 5348:       BoundarySegment *segment = sideBnd->segment;
 5349: 
 5350:       if (segment->ifltype != 0) {
 5351: 
 5352:          const Node *n1 = side->n1;
 5353:          const Node *n2 = side->n2;
 5354: 
 5355:          const double htot = side->htot2();
 5356: 
 5357:          if (!side->isDry) {
 5358:             atomicAdd(&segment->carea, htot*side->len);
 5359:             atomicAdd(&segment->clen, side->len);
 5360:          }
 5361:       }
 5362: 
 5363:    }
 5364: 
 5365: 
 5366:    __global__ void computeFlowBcVelocities(double time) {
 5367: 
 5368:       SIDE_BND(sideBnd);
 5369: 
 5370:       const Side *side = sideBnd->side;
 5371:  
 5372:       const bool isDry = side->isDry;
 5373:       const bool isLand = sideBnd->segment->isLand;
 5374: 
 5375:    
 5376:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5377: 
 5378:       if (isDry || isLand) return;
 5379: 
 5380:       // For wet sides in open boundaries...
 5381:       const Vector2 n = side->n;
 5382:       const BoundarySegment *segment = sideBnd->segment;
 5383: 
 5384:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5385: 
 5386:       const int ifltype = segment->ifltype;
 5387: 
 5388:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5389:       const Vector2 r_nuth0 = r_uth0*n;
 5390: 
 5391: 
 5392:       if (ifltype == 1 || ifltype == 2) {
 5393:       
 5394:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5395: 
 5396:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5397:          
 5398:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5399:          
 5400:       } else if (ifltype == -1) { // Flather 1
 5401: 
 5402:          for (int k = 0; k < nvrt; k++) {
 5403: 
 5404:             // uth is the normal vel.; no ramp up
 5405:             const double uth = sideBnd->nuth(k);
 5406:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5407: 
 5408:             sideBnd->ubc[k] += uth*n;
 5409:          }
 5410: 
 5411:       } else if (ifltype == 3 || ifltype == 5) {
 5412:          // vnth0=0 !normal vel.
 5413: 
 5414:          Vector2 r_u1_bar = {0.0, 0.0};
 5415:          // Computes the contribution to the velocity from all tide frequencies
 5416:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5417: 
 5418:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5419:             const Vector2 umo  = sideBnd->umo(jfr); 
 5420: 
 5421:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5422:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5423:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5424:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5425: 
 5426:          }
 5427: 
 5428: 
 5429:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5430: 
 5431:       } // if (ifltype = 3 || ifltype == 5
 5432: 
 5433: 
 5434: 
 5435:    }
 5436: 
 5437:    __global__ void computeElevationBoundaryConditions(double time) {
 5438:       // Compute elevation essential boundary conditions 
 5439: 
 5440:       NODE_BND(nodeBnd); // Each boundary node.
 5441: 
 5442:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5443: 
 5444:       const Node *node = nodeBnd->node;
 5445:       const BoundarySegment *segment = nodeBnd->segment;
 5446:       const int iettype = segment->iettype;
 5447:       
 5448: 
 5449:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5450:       double eic = 0.0;
 5451:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5452:       else                 eic = 0.0;
 5453: 
 5454:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5455:       const double r_eth = ramp*nodeBnd->eth;
 5456:       double r_eta1_bar = 0.0;
 5457: 
 5458:       // Compute tide elevation
 5459:       if (iettype == 3 || iettype == 5) {   
 5460: 
 5461:          if constexpr(iloadtide==1) { // loading tide
 5462:             assert(false && "Loading tide not implemented");
 5463:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5464:          }
 5465:          
 5466:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5467: 
 5468:             const double efa  = nodeBnd->efa[jfr]; 
 5469:             const double emo  = nodeBnd->emo[jfr]; 
 5470: 
 5471:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5472:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5473:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5474: 
 5475: 
 5476:          } // for jfr
 5477: 
 5478:       } // if iettype
 5479: 
 5480:       switch (iettype) {
 5481:          case 1:
 5482:          case 2:
 5483:          case 4:
 5484:             nodeBnd->elbc = r_eic + r_eth;
 5485:             break;
 5486:          case 3:
 5487:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5488:             break;
 5489:          case 5:
 5490:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5491:             break;
 5492:       } // switch
 5493: 
 5494: 
 5495:       //Add inverse barometric effects
 5496:       if (iettype != 0 && inv_atm_bnd == 1) {
 5497:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5498:       }
 5499: 
 5500:    }
 5501: 
 5502: 
 5503:    __global__ void computeHorizontalViscosity(void) { 
 5504: 
 5505:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5506: 
 5507:       SIDE(side);
 5508: 
 5509:       if (side->isDry) return;
 5510: 
 5511:       for (int k = 0; k < nvrt; k++) {
 5512:          side->nuGradU[k] = {0.0, 0.0};
 5513:       }
 5514: 
 5515:       if constexpr(ihorcon == 1) {
 5516:          for (int k = side->kb; k < nvrt - 1; k++) {
 5517:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5518:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5519:             // By Zhang and Baptista.
 5520: 
 5521:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5522:             // This is a standard discretization of the Laplacian operator.
 5523:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5524:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5525:             // Gamma is hvis_coef0 in the code.
 5526:             // The value of gamma needs to be < 0.5.
 5527: 
 5528:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5529:             // side under consideration in each of the two possible elements that share the side.
 5530:             Vector2 sumU = {0.0, 0.0};
 5531:             for (int l = 0; l < 2; l++) {
 5532:                const Element *elem = side->elems[l];
 5533: 
 5534:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5535: 
 5536:                // Find the local index of the side in the element
 5537:                const int idxSide = elem->sideLocalIdx(side);
 5538: 
 5539:                // Find the two sides that are connected to the side under consideration
 5540:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5541:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5542: 
 5543:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5544: 
 5545:             }
 5546: 
 5547:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5548: 
 5549:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5550:    
 5551:          }
 5552:       }
 5553:       else if constexpr(ihorcon == 2) {
 5554:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5555:       }
 5556: 
 5557: 
 5558:    }
 5559: 
 5560: 
 5561:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5562: 
 5563:       // Set essential boundary conditions 
 5564:       NODE(node); // Each boundary node
 5565:       NodeBoundary *nodeBnd = node->nodeBnd;
 5566:       
 5567:  
 5568:       // Check if this node has essential BC
 5569:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5570:          // Verify BC value is valid
 5571:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5572: 
 5573:        
 5574:          // Set diagonal to 1 and zero off-diagonals
 5575:          node->coeffDiag = 1.0;
 5576: 
 5577:          for (int j = 0; j < node->numNodes; j++) {
 5578:                node->coeffMatrix[j] = 0.0;
 5579:          }
 5580:          
 5581:          // Set solution and RHS to BC value
 5582:          node->mX  = nodeBnd->elbc;
 5583:          node->qel = nodeBnd->elbc;
 5584: 
 5585:       } else {
 5586:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5587: 
 5588:          for (int j = 0; j < node->numNodes; j++) {
 5589:                Node* nbNode = node->nodes[j];
 5590:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5591:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5592:                   // Verify neighbor's BC value
 5593:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5594: 
 5595:                   // Subtract contribution to RHS
 5596:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5597:                   node->coeffMatrix[j] = 0.0;  
 5598:                }
 5599:          }
 5600:       }
 5601:    }
 5602: 
 5603: 
 5604:    __global__ void updateElevation(void) {
 5605:       NODE(node);
 5606: 
 5607: 
 5608:       node->eta2 = node->mX;
 5609: 
 5610:       node->updateZCoordData();
 5611:    }
