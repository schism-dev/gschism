 6301: // !===============================================================================
 6302: 
 6303: } // extern "C"
 6304: 
 6305: #ifdef DONTCOMPILE
 6306: __device__ void computeVerticalAdvection(void) {
 6307:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6308: 
 6309:    sdbt(1:2,:,:)=0.d0
 6310: 
 6311:    const Side *side = FROM kernel;
 6312: 
 6313:    if(side->isDry) return;
 6314: 
 6315:    // If side is wet...
 6316: 
 6317: 
 6318:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6319:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6320:    double ws[nvrt] = {} // w @ side
 6321:    int icount = 0;
 6322:    for (int j=0; j<2; j++) {
 6323:       const Element *elem = side->elements[j];
 6324:        
 6325:       if(elem != nullptr) {
 6326:          icount++;
 6327:          for (int k=0; k<nvrt; k++) {
 6328:             ws[k] = ws[k] + elem->w[k];
 6329:          }
 6330:       }
 6331:    }  // for j
 6332: 
 6333:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6334:    ws = ws/icount;
 6335: 
 6336:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6337:    // Splines allow for a smooth transition between vertical levels.
 6338:    // Splines have continuity restrictions at the internal knots, but
 6339:    // we have to provide the 1st derivatives at the endpoints.
 6340:    const int kbs = side->kbs; 
 6341:    
 6342:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6343:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6344:    initCubicSpline(kbs, nvrt, side, ws, up)
 6345: 
 6346:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6347:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6348:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6349: 
 6350:    // Total advection (average onto side)
 6351:    const Node *node1 = side->nodes[0];
 6352:    const Node *node2 = side->nodes[1];
 6353:    for (int k=kbs(i); k<nvrt; k++) {
 6354: 
 6355:       if constexpr(ics==1) {
 6356:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6357:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6358:       } else {
 6359:          // XXX IMPLEMENT THIS
 6360:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6361:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6362:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6363:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6364:       }  // if ics
 6365: 
 6366: 
 6367:    }
 6368: }
 6369: #endif
 6370: 
 6371: 
 6372: extern "C" {
 6373:    __global__ void computeElemAverageGhat(void) {
 6374:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6375: 
 6376:       ELEM(elem);
 6377:       
 6378:       elem->ghat1= {0.0, 0.0};  
 6379: 
 6380:       if constexpr(ihydraulics != 0) {
 6381:          if (nhtblocks > 0 && elem->isblock) return;
 6382:       }
 6383: 
 6384: 
 6385: 
 6386:       
 6387:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6388:       // tidal potential, horizontal diffusion, and baroclinic etc
 6389:       // Remember to update both fb and F 
 6390:       // If ics=2, ghat1 are in eframe (ll)
 6391:       // cff1-3: coefficients for 2D/3D
 6392:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6393:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6394:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6395: 
 6396:       if (elem->isDry) return;
 6397: 
 6398:       double av_cff1 = 0.0;  // av. for cff1
 6399:       double av_cff2 = 0.0;  // av. for cff2
 6400:       double av_cff3 = 0.0;  // av. for cff3
 6401:       double av_df = 0.0;  // av. for H^\alpha / H
 6402:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6403:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6404: 
 6405:       const int i34 = elem->i34;
 6406:       const int kb = elem->kb;
 6407: 
 6408:       for (int j=0; j<i34; j++) {
 6409:          // For each node and side in the element...
 6410: 
 6411:          const Node *node = elem->nodes[j];
 6412:          const Side *side = elem->sides[j];
 6413: 
 6414:          const double chi      = side->chi;
 6415:          const double veg_c2   = side->veg_c2;
 6416:          const double veg_beta = side->veg_beta;
 6417:          const double veg_h    = side->veg_h();
 6418:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6419: 
 6420:          // Node - const in elem
 6421:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6422:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6423: 
 6424:          if (elem->depth >= tip_dp) {
 6425:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6426:          }
 6427: 
 6428:          
 6429:          const double htot  = side->htot2();        // Total depth at the side
 6430:          const double zctr2 = side->zTopCanopy();  
 6431: 
 6432:          double cff1; 
 6433:          double cff2; 
 6434:          double cff3;   
 6435:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6436:          // coefficients applied to 2D/3D case 
 6437:             cff1 = side->hhat/htot;
 6438:             cff2 = 0.0;
 6439:             cff3 = 0.0;
 6440:          } else { //3D
 6441:             //Init for no-veg case
 6442:             cff1 = 1.0;
 6443:             cff2 = 1.0;
 6444:             cff3 = 0.0;
 6445: 
 6446:             if constexpr(iveg != 0) {
 6447:                // Computes coefficients used with vegetation terms G1, G2
 6448:                // cff1, cff3 are used for the first two terms in G1, G2:
 6449:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6450:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6451:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6452:                if(veg_h < 0.99*htot) { // submergent vegetation
 6453:                   cff1=1;
 6454:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6455:                   cff3 = veg_c;
 6456: 
 6457:                } else { // emergent vegetation
 6458:                   cff1 = 1.0/(1.0 + veg_c2);
 6459:                   cff2 = cff1;
 6460:                   cff3 = 0.0;
 6461: 
 6462:                }
 6463:             } // if iveg
 6464:          } //  2D/3D
 6465: 
 6466:          av_cff1 += cff1/i34;
 6467:          av_cff2 += cff2/i34;
 6468:          av_cff3 += cff3/i34;
 6469:          av_cff2_chi += cff2*chi/i34;
 6470:          av_cff3_chi += cff3*chi/i34;
 6471:          av_df += min(htot, veg_h)/(htot*i34);
 6472: 
 6473: 
 6474:          // btrack values: U^\star, U^{\star\alpha}
 6475:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6476:          Vector2 Ustar       = {0.0, 0.0}; 
 6477:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6478: 
 6479:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6480:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6481:          } else { //3D
 6482:             for (int k = side->kb + 1; k < nvrt; k++) {
 6483:             
 6484:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6485:                Ustar += w2;
 6486: 
 6487:                if constexpr(iveg != 0) {
 6488:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6489:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6490:                        Ustar_alpha += zrat*w2; // XXXX
 6491:                    }
 6492:                }  // if iveg
 6493:             }  // for k
 6494:          }  //2D/3D
 6495:          
 6496: 
 6497:          // Add btrack & surface stress terms to \breve{G} first
 6498:          if constexpr(ics==1) {
 6499: 
 6500:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6501: 
 6502:          } else {
 6503:             assert(false && "computeElemAverageGhat: Not implemented");
 6504:             // XXX IMPLEMENT THIS
 6505:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6506:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6507:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6508:          }  // if ics
 6509: 
 6510:          // Surface and bottom stress terms
 6511:          if constexpr(ics==1) {
 6512:             const Vector2 tau    = side->tau();
 6513:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6514: 
 6515:             // Term for surface and bottom stress
 6516:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6517: 
 6518:          } else {
 6519:             assert(false && "computeElemAverageGhat: Not implemented");
 6520:             // XXX IMPLEMENT THIS
 6521:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6522:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6523:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6524:             // tau_x=(vn1+tt1)/2.d0
 6525:             // tau_y=(vn2+ss1)/2.d0
 6526:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6527:          }  // if ics
 6528: 
 6529:          
 6530: 
 6531:          // All terms in F,F^\alpha,f_b except baroclinic
 6532:          // F, f_b: all explicit terms excluding vegetation 
 6533:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6534:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6535:          const double coriolis = side->coriolis;
 6536:          Vector2 F  =  coriolis*side->U;  // F_x
 6537:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6538:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6539: 
 6540:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6541:             
 6542:             for (int k = side->kb; k < nvrt; k++) {
 6543:                if (zctr2 > side->zc[k-1]) {
 6544:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6545:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6546:                    Fa +=  coriolis*w2*zrat;
 6547:                } // if zctr2
 6548:             } // k
 6549:          } // iveg
 6550: 
 6551:          // Integrate horizontal viscosity force vertically
 6552:          for (int k=side->kb + 1; k<nvrt; k++) {
 6553:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6554: 
 6555:             F += levelHorVisc;
 6556: 
 6557:             // Vegetation term
 6558:             if constexpr(iveg!=0) {
 6559:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6560:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6561:                   Fa += levelHorVisc*zrat;
 6562:                } 
 6563:             } // if iveg
 6564:          } // for k
 6565: 
 6566:          fb += side->nuGradU[side->kb];
 6567: 
 6568:          // Add to ghat1
 6569:          if constexpr(ics==2) {
 6570:             assert(false && "computeElemAverageGhat: Not implemented");
 6571:             // XXX IMPLEMENT THIS
 6572:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6573:             // bigf1=vn1; bigf2=vn2
 6574:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6575:             // botf1=vn1; botf2=vn2
 6576:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6577:             // bigfa1=vn1; bigfa2=vn2
 6578:          } // if ics
 6579: 
 6580:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6581:       } // for j (nodes and sides)
 6582: 
 6583:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6584:          
 6585:       // Finish off terms in F, F^\alpha and f_b
 6586:       const double grav3 = elem->mean(&Node::grav2);
 6587:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6588: 
 6589: 
 6590:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6591:       for (int j=1; j<i34; j++) { 
 6592:          // For each side in the element...
 6593:          const Side *side = elem->sides[j];
 6594:          const double chi = side->chi;
 6595: 
 6596:          const double htot = side->htot2();
 6597:          const double veg_h = side->veg_h();
 6598:          const Vector2 F  = htot*fb;
 6599:          const Vector2 Fa = min(htot, veg_h)*fb;
 6600: 
 6601:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6602:       } // for j
 6603: 
 6604:       //botf1 etc are already in elem frame
 6605:       elem->ghat1 += tmp/i34;
 6606: 
 6607:       // Baroclinic force
 6608:       if constexpr(ibc==0) {
 6609:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6610: 
 6611:          Vector2 Fa = {0.0, 0.0};
 6612:          Vector2 intGradRho = {0.0, 0.0};
 6613:          
 6614:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6615:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6616:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6617: 
 6618:             // \in F [m^2/s/s]
 6619:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6620:          }
 6621: 
 6622:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6623:          const Vector2 F = av_df*Fa; //approx
 6624:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6625: 
 6626:       } // if ibc
 6627: 
 6628: 
 6629: 
 6630:    }
 6631: 
 6632: } // extern "C"
 6633: 
 6634: 
 6635: 
 6636: #ifdef DONTCOMPILE
 6637: __global__ void checkMassConservation(Tracers* sumtr) {
 6638: 
 6639:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6640: 
 6641:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6642: 
 6643:    Element *elem = &(mesh->localElemData[i]);
 6644: 
 6645:    // Skip dry elements
 6646:    if (elem->isDry) return;
 6647: 
 6648:    // Local sum array for this thread
 6649:    double localSum[N_TRACERS] = {0.0};
 6650: 
 6651:    // Sum over vertical levels for this element
 6652:    const int kbe = elem->kbe;
 6653:    const double area = elem->area;
 6654: 
 6655:    for (int k = kbe; k < nvrt; k++) {
 6656:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6657:       
 6658:       // Accumulate tracer mass
 6659:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6660:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6661:       }
 6662:    }
 6663: 
 6664:    //  This function returns per element sums. A reduction must be done on the host side.
 6665: }
 6666: 
 6667: 
 6668: __global__ void transport(void) {
 6669: 
 6670:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6671: 
 6672:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6673: 
 6674:    Element *elem = &(mesh->localElemData[ie]);
 6675: 
 6676:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6677: 
 6678:                for (int m=0; m<ntr; m++) {
 6679:                   for (int k=kbe(ie); k<nvrt; k++) {
 6680:                      // Calculate each polynomial's weight 
 6681:                      wm=0.d0; sum1=0.d0; 
 6682:                      wm1=0.d0; wm2=0.d0; 
 6683:                      for (int i=0; i<elem->nweno2; i++) {
 6684:                   
 6685:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6686:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6687:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6688:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6689:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6690:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6691:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6692:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6693:                      // -----------------Hu and Shu (1999)'s method----------------
 6694:                      b4=b1+b2+b3
 6695: 
 6696: //Error: add PRODUCTION CPP
 6697: #ifdef DEBUG
 6698:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6699:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6700:                     call parallel_abort(errmsg)
 6701:                   }
 6702: #endif
 6703: 
 6704:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6705:                   // !----test-------------- 
 6706:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6707:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6708:                   // !wm(i)=wm1(i)*wm2(i)
 6709:                   // !---------------------- 
 6710:                   sum1=sum1+wm(i)
 6711:                 } // end for i
 6712: 
 6713:                 wm=wm/sum1
 6714: 
 6715:                 for (int j=0; j<elem->i34; j++) {
 6716: 
 6717:                   const Side *side  = elem->sides[j];
 6718:                   const Node *node1 = side->n1;
 6719:                   const Node *node2 = side->n2;
 6720: 
 6721:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6722:                      trsd=0.d0
 6723:                      for (int kk=0; kk<nquad; kk++) {
 6724:                         for (int i=0; i<elem->nweno2; i++) {
 6725:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6726:                         } // end for i   
 6727:                      } // end for kk
 6728:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6729:                   } // outward flux
 6730:                } // end for j=1,i34(ie) ! side
 6731:             }
 6732:          }
 6733:               
 6734: 
 6735: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6736: //             //   calculate each polynomial's weight 
 6737: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6738: //                 wm=0.d0; sum1=0.d0
 6739: //                 do i=1,nweno1(ie) !for each polynomial
 6740: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6741: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6742: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6743: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6744: //                   wm(i)=b2
 6745: //                   sum1=sum1+b2
 6746: //                   !wm(i)=1.d0
 6747: //                   !sum1=sum1+1.d0
 6748: 
 6749: // // Error: PRODUCTION
 6750: // #ifdef DEBUG
 6751: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6752: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6753: //                     call parallel_abort(errmsg)
 6754: //                   endif
 6755: // #endif
 6756: 
 6757: //                 enddo !i
 6758: //                 wm=wm/sum1 !final weight
 6759: 
 6760:                 for (int j=0; j<elem->i34; j++) { // side
 6761:                   const Side *side = elem->sides[j];
 6762:                   const Node *node1 = side->n1;
 6763:                   const Node *node2 = side->n2;
 6764: 
 6765:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6766:                     trsd=0.d0
 6767:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6768:                       for (int i=0; i<elem->nweno1; i++) {
 6769:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6770:                       }
 6771:                     enddo //kk
 6772:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6773:                   } // outward flux
 6774:                 } // end for j=1,i34(ie) ! side
 6775:               } // end for k; ntr 
 6776: 
 6777:             else !simple upwind method
 6778:               do j=1,i34(ie)
 6779:                 jsj=elside(j,ie)
 6780:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6781:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6782:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6783:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6784:                   endif
 6785:                 enddo  !vertical layers
 6786:               enddo !j=1,i34(ie) ! side
 6787:             endif !order of accuracy
 6788: 
 6789:          //  enddo !ie
 6790: // !$OMP     end do
 6791: 
 6792: // !$OMP     master
 6793: //           !message passing
 6794: //           if (nproc>1) then
 6795: //             !make a copy of side concentrations
 6796: //             trsd_tmp0=trsd_tmp 
 6797: 
 6798: //             !this exchange routine swaps interface concentration between two partitions
 6799: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6800: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6801: 
 6802: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6803: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6804: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6805: 
 6806: 
 6807: //             !This obtains final values for interface sides
 6808: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6809: //       :    endif !nproc>1
 6810: //           !message passing end
 6811: // !$OMP     end master
 6812: // !$OMP     barrier
 6813: 
 6814: 
 6815: // !         Do advection; conc @ dry elem will not be changed
 6816: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6817: // !$OMP     do reduction(+: h_mass_in)
 6818: //           do i=1,ne
 6819: //             if(idry_e(i)==1) cycle
