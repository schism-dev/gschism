 2136: 
 2137: 
 2138: /**
 2139:    Compute the shape coordinates of the point (xt,yt) in the element.
 2140:    @param xt (input): x-coordinate of the point
 2141:    @param shpCoords (output): shape coordinates of the point
 2142:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2143:    @return true if the point is inside the element, false otherwise
 2144: **/
 2145: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2146:                                             bool fixNegshpCoord) const {
 2147: 
 2148:    // Compute the shape coordinates of the point xt in the element.
 2149:    if (i34==3) {
 2150:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2151:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2152:       // and in this case, the pt will be nudged into the element
 2153:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2154:       // from the local frame, so use additional check.
 2155: 
 2156:       Point2 x0, x1, x2;
 2157: 
 2158:       if constexpr(ics==1) {
 2159:          x0 = nodes[0]->p2();
 2160:          x1 = nodes[1]->p2();
 2161:          x2 = nodes[2]->p2();
 2162:       }
 2163:       else // lat/lon
 2164:       {
 2165:          Error("Not implemented yet");
 2166: #ifdef ICS2
 2167:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2168:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2169:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2170: #endif
 2171:       }
 2172: 
 2173:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2174:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2175:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2176:       shpCoords[3] = 0.0;
 2177:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2178: 
 2179:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2180:       // then we fix the negative shape coordinates.
 2181:       if (fixNegshpCoord && tmpmin<=0.0) {
 2182: 
 2183:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2184:          // keeping the sum of the shape coordinates equal to 1.
 2185:          // I have tested and compared the new algorithm with the old one, and they give
 2186:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2187:          // The new algorithm should be faster since it is branchless.
 2188:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2189:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2190:          
 2191:          shpCoords[0] = (shpCoords[0] + a)*b;
 2192:          shpCoords[1] = (shpCoords[1] + a)*b;
 2193:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2194: 
 2195:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2196:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2197:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2198:          }
 2199: 
 2200:          // Update the point coordinates for the new shape coordinates
 2201:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2202:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2203:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2204: 
 2205:       }
 2206: 
 2207:       // Check if the point is inside the element
 2208:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2209:    }
 2210:    else {
 2211:       Error("Not implemented yet");
 2212: #ifdef QUADS
 2213:       // Reproject pt in eframe of nel for ics=2
 2214:       if constexpr(ics==1) {
 2215:          xn2 = xt; 
 2216:          yn2 = yt;
 2217:       }
 2218:       else {
 2219:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2220:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2221:       }
 2222: 
 2223:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2224: #endif
 2225:    }
 2226: 
 2227:    return false;  // Never reached
 2228: 
 2229: }
 2230: 
 2231: 
 2232: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2233: // Convert shape coordinates to cartesian coordinates
 2234: 
 2235:    if (i34 == 3) {
 2236:       // Triangular element
 2237:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2238:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2239:    }
 2240:    else {
 2241:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2242:    }
 2243: 
 2244: }
 2245: 
 2246: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2247:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2248:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2249:    // The formula for the integral is:
 2250:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2251: 
 2252:    printf("intPhiPhi: TEST\n");
 2253: 
 2254:    const Node *n0 = nodes[0];
 2255:    const Node *n1 = nodes[1];
 2256:    const Node *n2 = nodes[2];
 2257:    const Node *n3 = nodes[3];
 2258: 
 2259:    const Vector2 p0 = n0->p2();
 2260:    const Vector2 p1 = n1->p2();
 2261:    const Vector2 p2 = n2->p2();
 2262:    const Vector2 p3 = n3->p2();
 2263: 
 2264:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2265:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2266:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2267:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2268: 
 2269:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2270: }
 2271:    
 2272: 
 2273: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2274:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2275:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2276:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2277:    // The formula is also based on the identity:
 2278:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2279:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2280: 
 2281:    printf("intGradPhiGradPhi: TEST\n");   
 2282: 
 2283:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2284: 
 2285:    const double x0 = nodes[0]->p.x;
 2286:    const double y0 = nodes[0]->p.y;
 2287:    const double x1 = nodes[1]->p.x;
 2288:    const double y1 = nodes[1]->p.y;
 2289:    const double x2 = nodes[2]->p.x;
 2290:    const double y2 = nodes[2]->p.y;
 2291:    const double x3 = nodes[3]->p.x;
 2292:    const double y3 = nodes[3]->p.y;
 2293: 
 2294:    double res = 0.0;
 2295:    
 2296:    // Quadrature points in xi and eta coordinates
 2297:    #pragma unroll
 2298:    for (int i = 0; i < 4; i++) {
 2299:       // For each quadrature point...
 2300: 
 2301:       const Point2 p = GaussPoint(i);
 2302:       const double eta = p.x;
 2303:       const double xi  = p.y;
 2304: 
 2305:       // Jacobian entries at the Gauss point p
 2306:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2307:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2308:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2309:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2310: 
 2311:       const double detJ = jacobianDet(p);
 2312:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2313: 
 2314:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2315:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2316:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2317:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2318:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2319: 
 2320:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2321:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2322:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2323:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2324:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2325: 
 2326:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2327:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2328:    }
 2329: 
 2330:    return res;
 2331: }
 2332: 
 2333: 
 2334: /**  Interpolate velocities at a given point (xt,yt,zt)
 2335: 
 2336:    @param xt, yt, zt: coordinates of the point to interpolate
 2337:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2338: 
 2339:    This is done in four steps:
 2340: 
 2341:    1. Find the shape coordinates for the final position in the element.
 2342:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2343:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2344:       z levels at xt, yt at each step.   
 2345:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2346:       horizontally and vertically.
 2347: **/
 2348: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2349:    // Interpolate the velocities at the point xt. 
 2350:    // This function works the same for triangular and quadrilateral elements.
 2351:    double shpCoord[4];
 2352: 
 2353:    // First step is to compute the shape coordinates of (xt,yt)
 2354:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2355:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2356: 
 2357:    // Second step is to find the level that contains zt
 2358:    // Uses a binary search to find the level
 2359:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2360:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2361:    int R = nvrt - 1;
 2362: 
 2363:    // Get the z coordinates at the nodes of the element at the levels L and R
 2364:    double zLAtNodes[4], zRAtNodes[4];
 2365:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2366:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2367: 
 2368:    double zL = interpolate(shpCoord, zLAtNodes);
 2369:    double zR = interpolate(shpCoord, zRAtNodes);
 2370:    
 2371:    // Interpolates vertically the velocities
 2372:    double wght1, wght2;
 2373:    if (xt.z<=zL) {
 2374:       wght1 = 1.0;
 2375:       wght2 = 0.0;
 2376:    }
 2377:    else if (xt.z>=zR) {
 2378:       wght1 = 0.0;
 2379:       wght2 = 1.0;
 2380:    }
 2381:    else {
 2382:       // Perform a binary search to find the levels between L and R that contain xt.z
 2383:       while (R - L > 1) {
 2384:          int M = (L + R) / 2;
 2385: 
 2386:          double zMAtNodes[4];
 2387:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2388:          double zM = interpolate(shpCoord, zMAtNodes);
 2389:          if (zM < xt.z) 
 2390:          {
 2391:             L = M;
 2392:             zL = zM;
 2393:          }
 2394:          else 
 2395:          {
 2396:             R = M;
 2397:             zR = zM;
 2398:          }
 2399:       }
 2400:       assert(L == R-1);
 2401:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2402: 
 2403:       wght2 = (xt.z - zL)/(zR - zL);
 2404:       wght1 = 1.0 - wght2;
 2405:    }
 2406: 
 2407:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2408:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2409: 
 2410:    // Neither of the interpolated velocities should be NaN
 2411:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2412: 
 2413: }
 2414: 
 2415: 
 2416: 
 2417: 
 2418: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2419: 
 2420:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2421:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2422:    const Node *n1 = side->n1;
 2423:    const Node *n2 = side->n2;
 2424: 
 2425:    bool n1_match = (n1->nodeBnd->segment == segment);
 2426:    bool n2_match = (n2->nodeBnd->segment == segment);
 2427: 
 2428:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2429:    if (n1_match && n2_match) {
 2430:       return 0.5;
 2431:    } else if (n1_match) {
 2432:       return 1.0;
 2433:    } else if (n2_match) {
 2434:       return 0.0;
 2435:    }
 2436:    return 0.0;
 2437: }
 2438: 
 2439: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2440: 
 2441: 
 2442: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2443: 
 2444:    const double w1 = getBoundaryArrayValueWeight();
 2445:    const double w2 = 1.0 - w1;
 2446:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2447:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2448: 
 2449:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2450: }
 2451: 
 2452: 
 2453: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2454:    const double w1 = getBoundaryArrayValueWeight();
 2455:    const double w2 = 1.0 - w1;
 2456:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2457:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2458: 
 2459:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2460: }
 2461: 
 2462: 
 2463: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2464:    // Returns the value of the velocity at the side center
 2465:    const double w1 = getBoundaryArrayValueWeight();
 2466:    const double w2 = 1.0 - w1;
 2467:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2468:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2469: 
 2470:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2471: }
 2472: 
 2473: 
 2474: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2475:    // Returns the value of the normal component of the velocity at the side center
 2476:    const double w1 = getBoundaryArrayValueWeight();
 2477:    const double w2 = 1.0 - w1;
 2478:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2479:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2480: 
 2481:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2482: }
 2483: 
 2484: 
 2485: 
 2486: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2487: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2488: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2489: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2490: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2491: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2492:    Vector2 grad = {0.0, 0.0};
 2493:    int count = 0;
 2494: 
 2495:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2496: 
 2497:    // First element
 2498:    if (elems[0] != nullptr && condition(elems[0])) {
 2499:       grad += elems[0]->grad2(field);
 2500:       count++;
 2501:    }
 2502: 
 2503:    // Second element
 2504:    if (elems[1] != nullptr && condition(elems[1])) {
 2505:       grad += elems[1]->grad2(field);
 2506:       count++;
 2507:    }
 2508: 
 2509:    if (count > 0) {
 2510:       grad = grad/count;
 2511:    }
 2512:    
 2513:    return grad;
 2514: }
 2515: 
 2516: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2517: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2518: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2519: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2520: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2521: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2522: 
 2523: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2524: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2525: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2526: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
