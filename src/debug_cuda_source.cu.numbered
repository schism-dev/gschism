 7705: __global__ void returnMatrix(double *res) {
 7706:    // Debugging: returns the matrix as a CuPy array
 7707: 
 7708:    const int size = mesh->np;
 7709:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7710:       const Node *node = mesh->localNodeData + idx_node;
 7711:       res[idx_node*size + idx_node] = node->coeffDiag;
 7712:       for (int j = 0; j < node->numNodes; j++) {
 7713:          Node* nbNode = node->nodes[j];
 7714:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7715:       }
 7716: 
 7717:    }
 7718:    
 7719: }
 7720: 
 7721: 
 7722: __global__ void computeMatrixProductAndDotProducts() {
 7723:    // Computes A*p, r'Mr and p'Ap
 7724: 
 7725:    // 1) shared buffer: first half for rMr, second for pAp
 7726:    __shared__ double sdata[2*BLOCK_SIZE];
 7727:    double* s_rMr = sdata;
 7728:    double* s_pAp = sdata + BLOCK_SIZE;
 7729: 
 7730:    const int tid = threadIdx.x;
 7731: 
 7732:    double l_pAp = 0.0;
 7733: 
 7734:    s_rMr[tid] = 0.0;
 7735:    s_pAp[tid] = 0.0;
 7736: 
 7737:    // 2) get your node pointer
 7738:    // NODE(node);   
 7739:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7740:    Node *node = &(mesh->localNodeData[idx_node]); 
 7741:       if (idx_node < mesh->np) {
 7742: 
 7743:       const double diag = node->coeffDiag;
 7744:       const double r    = node->mR;
 7745:       const double p    = node->mP;  
 7746: 
 7747:       // apply preconditioner on the fly:
 7748:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7749: 
 7750:       // 4) compute Ap = A.p
 7751:       double Ap = node->coeffDiag * node->mP;
 7752:       for (int j = 0; j < node->numNodes; ++j) {
 7753:          const Node *nbNode = node->nodes[j];
 7754:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7755: 
 7756:       }
 7757: 
 7758:       node->mAp = Ap;
 7759:       
 7760: 
 7761:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7762:       // const double l_rMr = r*Mr;  // r'Mr
 7763:       l_pAp = p*Ap;  // p'Ap
 7764: 
 7765: 
 7766:    }
 7767: 
 7768:    // 6) write into shared mem
 7769:    // s_rMr[tid] = l_rMr;
 7770:    s_pAp[tid] = l_pAp;
 7771: 
 7772:    __syncthreads();
 7773: 
 7774:    // 7) block-wide tree reduction
 7775:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7776:       if (tid < stride)  {
 7777:          s_pAp[tid] += s_pAp[tid + stride];
 7778:       }
 7779:       __syncthreads();
 7780:    }
 7781: 
 7782:    // 8) thread 0 atomically accumulates into the globals
 7783:    // XXX: This is slower than it needs to be, but it is simple and works
 7784:    if (tid == 0) {
 7785:       atomicAdd(pAp, s_pAp[0]);
 7786:    }
 7787: 
 7788: 
 7789: }
 7790: 
 7791: 
 7792: __global__ void updateSolutionAndDotProducts(void) {
 7793:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7794: 
 7795:    const int tid = threadIdx.x;
 7796: 
 7797:    s_rMr[tid] = 0.0;
 7798: 
 7799:    // get node & bounds-check:
 7800:    NODE(node);
 7801: 
 7802:    
 7803:    // Compute alpha
 7804:    const double alpha = (*rMr_old)/(*pAp); 
 7805: 
 7806: 
 7807:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7808: 
 7809: 
 7810:    // load scalars
 7811:    const double diag = node->coeffDiag;
 7812:    const double p    = node->mP;
 7813:    const double Ap   = node->mAp;
 7814:    const double x    = node->mX;
 7815:    const double r    = node->mR;
 7816:    
 7817:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7818: 
 7819:    // 1) update solution & residual
 7820:    const double x_new = x + alpha*p;
 7821:    const double r_new = r - alpha*Ap;
 7822:    node->mX = x_new;
 7823:    node->mR = r_new;
 7824: 
 7825:    // 2) apply Jacobi preconditioner on the fly
 7826:    const double Mr_new = r_new/diag;
 7827: 
 7828: 
 7829:    // 3) local contributions for the two dot-products
 7830:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7831: 
 7832:    // 4) write into shared-mem
 7833:    s_rMr[tid] = l_rMr;
 7834: 
 7835:    __syncthreads();
 7836: 
 7837: 
 7838:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7839:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7840:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7841:       __syncthreads();
 7842:    }
 7843: 
 7844:    // 6) thread 0 atomically folds into the global accumulators
 7845:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7846: 
 7847: 
 7848: }
 7849: 
 7850: 
 7851: __global__ void updateSearchDirection() {
 7852: 
 7853:     NODE(node);
 7854: 
 7855:     // recompute z on-the-fly
 7856:     const double z = node->mR / node->coeffDiag;
 7857:     const double p = node->mP;
 7858: 
 7859:     const double beta = (*rMr_new)/(*rMr_old);
 7860: 
 7861: 
 7862:     // p =z + beta*p
 7863:     node->mP = z + beta*p;
 7864: 
 7865: }
 7866: 
 7867: __global__ void initializeScalars(double *scalars) {
 7868: 
 7869:    // These point to a cupy array in the host code
 7870:    rMr_old = scalars + 0;
 7871:    rMr_new = scalars + 1;
 7872:    pAp     = scalars + 2;
 7873: }
 7874: 
 7875: __global__ void initializePreconditionedResidual(void) {
 7876: 
 7877:     __shared__ double s_rMr[BLOCK_SIZE];  
 7878: 
 7879:     s_rMr[threadIdx.x] = 0.0;
 7880: 
 7881:     NODE_ALL(node, valid);
 7882:     const int tid = threadIdx.x;
 7883:     // For the first iteration:
 7884:     // 1. Initial solution x = 0 (already set)
 7885:     // 2. Initial residual r = b (stored in qel)
 7886:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7887: 
 7888: // XXX we should use the guess solution here    
 7889: 
 7890:     double l_rMr = 0.0;
 7891:     if (valid) {
 7892:       // Set initial residual r = b (from qel)
 7893:       node->mR = node->qel;
 7894: 
 7895:       // Compute z = M^-1 * r (preconditioned residual)
 7896:       const double z = node->mR / node->coeffDiag;
 7897: 
 7898:       // Set initial search direction p = z
 7899:       node->mP = z;
 7900: 
 7901:       // Initialize other variables needed for CG
 7902:       node->mX = 0.0;  // Initial solution
 7903:       node->mAp = 0.0; // Will be computed in first iteration
 7904: 
 7905: 
 7906:       // Computes the first r'Mr (reduction)
 7907:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7908:     }
 7909:     // 4) write into shared-mem
 7910:     s_rMr[tid] = l_rMr;
 7911: 
 7912:     __syncthreads();
 7913: 
 7914: 
 7915:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7916:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7917:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7918:         __syncthreads();
 7919:     }
 7920: 
 7921:     // 6) thread 0 atomically folds into the global accumulators
 7922:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7923: 
 7924:     *rMr_old = 0.0;
 7925:     *pAp = 0.0;
 7926: }
 7927: 
 7928: 
 7929: 
 7930: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7931:    Element *elems = mesh->localElemData;
 7932: 
 7933:    *addr = elems;
 7934:    *sizeElement = sizeof(Element);
 7935:    switch (varCode) {
 7936:       case (int)VarCode::z:
 7937:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7938:          *sizeType = sizeof(double);
 7939:          break;
 7940:       case (int)VarCode::x:
 7941:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7942:          *sizeType = sizeof(Vector2);
 7943:          break;
 7944:       case (int)VarCode::area:
 7945:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7946:          *sizeType = sizeof(double);
 7947:          break;
 7948:       case (int)VarCode::depth:
 7949:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7950:          *sizeType = sizeof(double);
 7951:          break;
 7952:       case (int)VarCode::radius:
 7953:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7954:          *sizeType = sizeof(double);
 7955:          break;
 7956:       case (int)VarCode::lonlat:
 7957:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7958:          *sizeType = sizeof(double);
 7959:          break;
 7960:       case (int)VarCode::ghat:
 7961:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7962:          *sizeType = sizeof(Vector2);
 7963:          break;
 7964:       case (int)VarCode::kb:
 7965:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7966:          *sizeType = sizeof(int);
 7967:          break;
 7968:       case (int)VarCode::isdry:
 7969:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7970:          *sizeType = sizeof(int);
 7971:          break;            
 7972:       case (int)VarCode::w:
 7973:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7974:          *sizeType = sizeof(double);
 7975:          break;
 7976:       case (int)VarCode::FaceIndices:
 7977:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7978:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7979:          *sizeType = sizeof(Node);
 7980:          break;
 7981:       default:
 7982:          *offset = -1;
 7983:    }
 7984: }
 7985: 
