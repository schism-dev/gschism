 7466: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7467:    Node *nodes = mesh->localNodeData;
 7468: 
 7469:    *addr = nodes;
 7470:    *sizeNode = sizeof(Node);
 7471: 
 7472:    switch (varCode) {
 7473:       case (int)VarCode::depth:
 7474:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7475:          *sizeType = sizeof(double);
 7476:          break;
 7477:       case (int)VarCode::eta:
 7478:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7479:          *sizeType = sizeof(double);
 7480:          break;
 7481:       case (int)VarCode::x:
 7482:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7483:          *sizeType = sizeof(Vector2);
 7484:          break;
 7485:       case (int)VarCode::z:
 7486:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7487:          *sizeType = sizeof(double);
 7488:          break;
 7489:       case (int)VarCode::kb:
 7490:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7491:          *sizeType = sizeof(int);
 7492:          break;
 7493:       case (int)VarCode::isdry:
 7494:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7495:          *sizeType = sizeof(int);
 7496:          break;         
 7497:       case (int)VarCode::w:
 7498:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7499:          *sizeType = sizeof(double);
 7500:          break;
 7501:       case (int)VarCode::u:
 7502:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7503:          *sizeType = sizeof(Vector2);
 7504:          break;         
 7505:       default:
 7506:          *offset = -1;    
 7507:    }  
 7508:    
 7509: }
