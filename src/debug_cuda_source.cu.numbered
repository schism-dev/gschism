 2584: //       const double x4 = nodes[nxq(i+1)]->x;
 2585: //       const double y4 = nodes[nxq(i+1)]->y;
 2586: 
 2587: //       const Side& side = sides[i];
 2588: 
 2589: //       xIntersect=-1.e25;
 2590: //       yIntersect=-1.e25;
 2591: 
 2592: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2593: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2594: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2595: 
 2596: //       if (delta != 0.0) {
 2597: //          // Solves the two linear equations for tt1 and tt2
 2598: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2599: //          const double tt2 = delta2/delta;
 2600: 
 2601: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2602: //          // Similarly, we use tt2 to compute the intersection point.
 2603: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2604: //             xIntersect = x3 + (x4 - x3)*tt2;
 2605: //             yIntersect = y3 + (y4 - y3)*tt2;
 2606: 
 2607: //             intersectingSide = side;
 2608: //             nextElement = nghbElems[i];
 2609: 
 2610: //             return true;
 2611: //          }
 2612:       
 2613: //       }
 2614: //       else {
 2615: //          // The two segments are parallel
 2616: //          return false;
 2617: //       }
 2618: 
