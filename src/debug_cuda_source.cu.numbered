 2724: 
 2725: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2726: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2727: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2728: // Only when ics == 2, the origin is at the element center.
 2729: 
 2730:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2731: 
 2732:    const Node *node = nodes[idxNode];
 2733: 
 2734:    if constexpr(ics==1) {
 2735:       return node->p;
 2736: 
 2737:    } else {
 2738:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2739: 
 2740:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2741: 
 2742:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2743:    }
 2744: 
 2745: }
 2746: 
 2747: 
 2748: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2749:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2750: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2751: 
 2752:    const int id1 = idx;
 2753:    const int id2 = nxq(1 + id1);
 2754:    const int id3 = nxq(2 + id1);
 2755: 
 2756:    if constexpr(ics==1) {
 2757:       x0 = nodes[id1]->p;
 2758:       x1 = nodes[id2]->p;
 2759:       x2 = nodes[id3]->p;
 2760: 
 2761:    } else {
 2762: 
 2763:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2764:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2765:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2766: 
 2767:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2768:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2769:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2770: 
 2771:    }
 2772: 
 2773: }
 2774: 
 2775: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2776:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2777: }
 2778: 
 2779: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2780:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2781:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2782: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2783: 
 2784:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2785: 
 2786: 
 2787: 
 2788:    if constexpr(ics==1) {
 2789:       x0 = nodes[0]->p;
 2790:       x1 = nodes[1]->p;
 2791:       x2 = nodes[2]->p;  
 2792:       x3 = nodes[3]->p;
 2793: 
 2794:    } else {
 2795: 
 2796:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2797:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2798:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2799:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2800: 
 2801:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2802:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2803:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2804:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2805:    }
 2806: 
 2807: }
 2808: 
 2809: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2810:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2811: {
 2812:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2813: }
 2814: 
 2815: 
 2816: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2817: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2818: // Returns the normal vector and the area of the element at this level
 2819:    
 2820:    double nx, ny, nz;
 2821: 
 2822:    if (isTri()) {
 2823:       // For triangles...
 2824: 
 2825:       // Indices of the nodes at level k, taking care of not going below the bed
 2826:       const int k0 = max(k, nodes[0]->kb);
 2827:       const int k1 = max(k, nodes[1]->kb);
 2828:       const int k2 = max(k, nodes[2]->kb);
 2829: 
 2830:       // Gets the element frame coordinates of the nodes at level k
 2831:       Point3 x0, x1, x2;
 2832:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2833:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2834:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2835:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2836: 
 2837:       } else {  // ics == 2
 2838:          Point2 h0, h1, h2;
 2839: 
 2840:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2841: 
 2842:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2843:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2844:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2845:       }
 2846: 
 2847:       const Vector3 n20 = x2 - x0;
 2848:       const Vector3 n10 = x1 - x0; 
 2849: 
 2850:       // Computes the cross product of vectors n20 and n10. 
 2851:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2852:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2853:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2854: 
 2855:   
 2856:    }
 2857:    else {
 2858:       // For quads...
 2859:       Point2 h0, h1, h2, h3;
 2860: 
 2861:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2862: 
 2863:       // Indices of the nodes at level k, taking care of not going below the bed
 2864:       const int k0 = max(k, nodes[0]->kb);
 2865:       const int k1 = max(k, nodes[1]->kb);
 2866:       const int k2 = max(k, nodes[2]->kb);
 2867:       const int k3 = max(k, nodes[3]->kb);
 2868: 
 2869:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2870:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2871:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k2] - nodes[0]->z[k0]);
 2872:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k3] - nodes[1]->z[k1]);
 2873: 
 2874:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2875:       nx = n20.y*n31.z - n20.z*n31.y;
 2876:       ny = n20.z*n31.x - n20.x*n31.z;
 2877:       nz = n20.x*n31.y - n20.y*n31.x;
 2878: 
 2879:    }
 2880: 
 2881:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2882:    area3D = 0.5*len;
 2883: 
 2884:    const double inv_len = 1.0/len;
 2885: 
 2886:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2887: 
 2888: }
 2889: 
 2890: 
 2891: // Helper functions to get the 2D local node position for the Celestial walk
 2892: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2893:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2894:    const Node *node = getNodeInOrder(idx2);
 2895: 
 2896:    double z = 0.0;
 2897:    if constexpr(ics == 2) z = node->gz;
 2898:    
 2899:    Point3 p = toPoint3(node->p, z);
 2900: 
 2901:    return toPoint2(origSide->toLocalFrame(p));
 2902: }
 2903: 
 2904: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2905:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2906: }
 2907: 
 2908: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2909:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2910: // Computes the three per-side predicates needed for the celestial walk
 2911: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2912: //
 2913: // xt is in local frame coordinates for origSide if ics == 2.
 2914: //
 2915: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2916: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2917: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2918: // meaningless on triangles are masked to a safe value (see comments below).
 2919: {
 2920:    // Project all 4 corner positions once into the local 2D frame.
 2921:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2922:    // getLocalNodePosition only transforms/projects if ics == 2.
 2923:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2924:                         getLocalNodePosition(1, origSide), 
 2925:                         getLocalNodePosition(2, origSide), 
 2926:                         getLocalNodePosition(3, origSide)};
 2927: 
 2928:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2929:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2930:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2931:    // But still farther towards the target point from the current point.
 2932:    const Vector2 vt0 = xt - x0;
 2933:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2934:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2935:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2936: 
 2937:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2938:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2939: 
 2940: 
 2941: // if (origSide->idx == 2860848 && jlev == 46) {
 2942: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2943: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2944: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2945: // }
 2946:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2947:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2948:    //  here the orientation is baked into the corners array.)
 2949:    const int i3 = nxq(3);
 2950:    const Vector2 s0 = C[ 1] - C[ 0];
 2951:    const Vector2 s1 = C[ 2] - C[ 1];
 2952:    const Vector2 s2 = C[i3] - C[ 2];
 2953:    const Vector2 s3 = C[ 0] - C[i3];
 2954:    
 2955:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2956:    // The corners array is built from getNode in CCW order, so the orientation
 2957:    // is already correct and no ssign factor is needed in the formulas below.
 2958:    //
 2959:    // i3 = nxq(3): the index of the corner after side 2.
 2960:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2961:    //   Quad:     i3 == 3.
 2962:    //
 2963:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2964:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2965:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2966:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2967:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2968:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2969: 
 2970: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2971: 
 2972:    // For triangles, the corner after side 2 is the closing corner where
 2973:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2974:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2975:    // s0 for triangles, s3 for quads.
 2976:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2977: 
 2978:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2979:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2980:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2981:    //
 2982:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2983:    // result is false naturally. No sentinel needed.
 2984:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2985:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2986:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2987:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2988: 
 2989:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2990:    // on the "exit through side I" half of the corner cone, separated by the
 2991:    // approximate angular bisector of the celestial walk. The bisector is
 2992:    // perpendicular to the chord across the corner; the test is the sign of
 2993:    // (xt - corner_vertex) projected onto that chord.
 2994:    //
 2995:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2996:    // (the validity rule sets valid_3 = false), so its computed value for
 2997:    // triangles doesn't matter. No sentinel needed.
 2998:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2999:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 3000:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 3001:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 3002: 
 3003: }
 3004: 
 3005: 
 3006: __inline__ __device__ double Element::computeSignedArea(void) const {
 3007:    // Compute the area of the element
 3008: 
 3009:    Point2 x0, x1, x2, x3;
 3010:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 3011: 
 3012: 
 3013:    double res = signedArea(x0, x1, x2);
 3014: 
 3015:    // In the quad case we need to add the area of the other triangle.
 3016:    if (isQuad()) {
 3017:       x3 = getLocalHorizontalNodePosition(3);
 3018:       double ar1 = signedArea(x0, x2, x3);
 3019:       double ar2 = signedArea(x0, x1, x3);
 3020:       double ar3 = signedArea(x1, x2, x3);
 3021:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 3022: 
 3023:       res += ar1;
 3024: 
 3025:    }
 3026: 
 3027:    return res;
 3028: }
 3029: 
 3030: 
 3031: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 3032:                                                                 (nodes[1]->isDry2()) ||
 3033:                                                                 (nodes[2]->isDry2()) ||
 3034:                                                                 (isQuad() && nodes[3]->isDry2());
 3035: }
 3036: 
 3037: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3038:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 3039: }
 3040: 
 3041: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3042:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 3043: }
 3044: 
 3045: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 3046:    // In boundary sides, the element 1 is nullptr
 3047:    return side->elems[1] == nullptr; 
 3048: }
 3049: 
 3050: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4],
 3051:                                                              bool useSideCenters) const {
 3052:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 3053:    // For ics == 2, this function uses local frame coordinates.
 3054:    // If useSideCenters, bilinear domain is the side-center quad (side j opposite node j).
 3055: 
 3056:    assert(isQuad());
 3057: 
 3058:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 3059:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 3060:    // where vxi, veta, vb are vectors and c is the center of the element.
 3061: 
 3062:    Point2 p0, p1, p2, p3;
 3063: 
 3064:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 3065: 
 3066:    if (useSideCenters) {
 3067:       const Point2 s0 = 0.5 * (p1 + p2);
 3068:       const Point2 s1 = 0.5 * (p2 + p3);
 3069:       const Point2 s2 = 0.5 * (p3 + p0);
 3070:       const Point2 s3 = 0.5 * (p0 + p1);
 3071:       p0 = s0; p1 = s1; p2 = s2; p3 = s3;
 3072:    }
 3073: 
 3074:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 3075:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 3076:    // vectors vxi and veta connect the centers of opposite sides
 3077:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 3078:    // vb is zero for parallelogram elements.
 3079:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 3080: 
 3081:    //  The bilinear mapping is:
 3082:    //      P(s,t) = C + s*U + t*V + s*t*W
 3083:    //
 3084:    //  where:
 3085:    //    C = centroid (average of four vertices)
 3086:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 3087:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 3088:    //    W = bilinear correction; measures deviation from parallelogram
 3089:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 3090:    //        W = 0 for parallelogram elements.
 3091:    //
 3092:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3093:    //
 3094:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3095:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3096:    //
 3097:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3098:    //
 3099:    //  Geometrically, (L) projects everything onto the direction
 3100:    //  perpendicular to W, where the mapping is purely affine.
 3101:    //
 3102:    //  The dot product with nb retains the nonlinear term:
 3103:    //
 3104:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3105:    //
 3106:    //  Geometrically, (Q) projects onto the W direction, where
 3107:    //  the nonlinearity lives.
 3108:    //
 3109:    //  We solve (L) for whichever variable has the larger coefficient
 3110:    //  (better conditioned back-substitution), substitute into (Q),
 3111:    //  and get a scalar quadratic in the other variable.
 3112:    // ================================================================
 3113: 
 3114:    // ---- Basis vectors ----
 3115:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3116:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3117:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3118:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3119:    // W: nonlinear correction. Difference between quad and parallelogram.
 3120:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3121:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3122: 
 3123:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3124:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3125:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3126:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3127:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3128: 
 3129:    // ---- nb: direction parallel to W, L1-normalized ----
 3130:    // We don't need a unit vector -- just a well-scaled direction parallel
 3131:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3132:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3133:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3134:    //
 3135:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3136:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3137:    // and the quadratic solver takes its linear path (a ~ 0).
 3138:    const double wlen1 = fabs(vb.x) + fabs(vb.y);
 3139:    const Vector2 nb = (wlen1 > 0.0) ? vb*(1.0/wlen1) : Vector2{1.0, 0.0};
 3140: 
 3141:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3142:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3143:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3144:    // What remains is a pure affine relationship between xi and eta.
 3145:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3146:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3147:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3148: 
 3149:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3150:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3151:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3152:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3153:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3154:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3155:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3156: 
 3157:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3158:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3159:    // minimizing round-off amplification.
 3160:    //
 3161:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3162:    // that uses predicated moves.
 3163:    //
 3164:    // if (fabs(Ls) > fabs(Lt)) {
 3165:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3166:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3167:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3168:    //    const double A = -Qw * Lt;
 3169:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3170:    //    const double C =  Qs * Lp - Qp * Ls;
 3171: 
 3172:    //    double eta1, eta2;
 3173:    //    solveQuadratic(A, B, C, eta1, eta2);
 3174: 
 3175:    //    // Pick root with smaller |eta| (domain centered at 0).
 3176:    //    // Ternary-> predicated move, no branch divergence.
 3177:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3178: 
 3179:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3180:    //    xi = (Lp - Lt * eta) / Ls;
 3181: 
 3182:    // } else {
 3183:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3184:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3185:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3186:    //    const double A = -Qw * Ls;
 3187:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3188:    //    const double C =  Qt * Lp - Qp * Lt;
 3189: 
 3190:    //    double xi1, xi2;
 3191:    //    solveQuadratic(A, B, C, xi1, xi2);
 3192: 
 3193:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3194: 
 3195:    //    eta = (Lp - Ls * xi) / Lt;
 3196:    // }
 3197:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3198:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3199:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3200:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3201:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3202: 
 3203:    // Quadratic:  A*r^2 + B*r + C = 0
 3204:    // (same formula for both cases, just with swapped coefficients)
 3205:    const double A = -Qw * Lb;
 3206:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3207:    const double C =  Qa * Lp - Qp * La;
 3208: 
 3209:    double r1, r2;
 3210:    solveQuadratic(A, B, C, r1, r2);
 3211: 
 3212:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3213:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3214: 
 3215:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3216:    const double other = (Lp - Lb * r) / La;
 3217: 
 3218:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3219:    xi  = solve_s ? r     : other;
 3220:    eta = solve_s ? other : r;
 3221: 
 3222: 
 3223:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3224:    xi  = clamp(xi,  -1.0, 1.0);
 3225:    eta = clamp(eta, -1.0, 1.0);
 3226: 
 3227:    // ---- Shape functions ----
 3228:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3229:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3230:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3231:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3232:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3233:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3234:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3235:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3236: 
 3237:    return true;
 3238: }
 3239: 
 3240: /**
 3241:    Compute the shape coordinates of the point (xt,yt) in the element.
 3242:    @param xt (input): x-coordinate of the point
 3243:    @param shpCoords (output): shape coordinates of the point
 3244:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3245:    @return true if the point is inside the element, false otherwise
 3246: **/
 3247: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3248: 
 3249:    // Compute the shape coordinates of the point xt in the element.
 3250:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3251:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3252:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3253:    // from the local frame, so use additional check.
 3254: 
 3255: 
 3256:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3257: 
 3258:    if (isTri()) { // Triangular element
 3259: 
 3260:       // Horizontal local node coordinates. 
 3261:       Point2 x0, x1, x2;
 3262:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3263: 
 3264:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3265:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3266:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3267:       shpCoords[3] = 0.0;
 3268: 
 3269:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3270:       const bool res = (tmpmin >= -small);  
 3271:       
 3272:       // When to fix the negative shape coordinates?
 3273:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3274: 
 3275:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3276:       // then we fix the negative shape coordinates.
 3277:       if ((tmpmin < 0) && fix) {
 3278: 
 3279:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3280:          // keeping the sum of the shape coordinates equal to 1.
 3281:          // I have tested and compared the new algorithm with the old one, and they give
 3282:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3283:          // The new algorithm should be faster since it is branchless.
 3284:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3285:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3286: 
 3287:          shpCoords[0] = (shpCoords[0] + a)*b;
 3288:          shpCoords[1] = (shpCoords[1] + a)*b;
 3289:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3290: 
 3291:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3292:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3293:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3294: 
 3295:          // Update the point coordinates for the new shape coordinates
 3296:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3297:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3298: 
 3299:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3300: 
 3301:       }
 3302: 
 3303:       // Return true if the point is inside the element
 3304:       return res;      
 3305:    }
 3306:    else {
 3307:       assert(isQuad() && "computeShapeCoords");
 3308: 
 3309:       // Horizontal local node coordinates with respect to the original side.
 3310:       Point2 x0, x1, x2, x3;
 3311:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3312: 
 3313:       const double a0 = signedArea(x0, x1, xt);
 3314:       const double a1 = signedArea(x1, x2, xt);
 3315:       const double a2 = signedArea(x2, x3, xt);
 3316:       const double a3 = signedArea(x3, x0, xt);
 3317: 
 3318:       const double minArea = min4(a0, a1, a2, a3);
 3319:       
 3320:       const bool res = (minArea > -small*area);
 3321: 
 3322:       // When to fix the negative shape coordinates?
 3323:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3324: 
 3325:       double xi, eta;    
 3326: 
 3327:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3328:       // Does nothing if ics == 1.
 3329:       assert(origSide != nullptr);
 3330:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3331: 
 3332:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3333: 
 3334:       if (fix) {
 3335:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3336:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3337:          xt.x = interpolate(shpCoords, xn);
 3338:          xt.y = interpolate(shpCoords, yn);
 3339:       }
 3340: 
 3341:       return res;
 3342:    }
 3343: 
 3344: 
 3345:    assert(false && "computeShapeCoords: should never reach this point");
 3346:    return false;  // Never reached
 3347: 
 3348: }
 3349: 
 3350: 
 3351: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3352: // Convert shape coordinates to cartesian coordinates
 3353: 
 3354:    if (isTri()) {
 3355:       // Triangular element
 3356: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3357:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3358:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3359:    }
 3360:    else {
 3361:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3362:    }
 3363: 
 3364: }
 3365: 
 3366: 
 3367: 
 3368: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3369:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3370:    
 3371:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3372: }
 3373: 
 3374: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3375:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3376:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3377:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3378:    return area * dot(gradPhi[i], gradPhi[j]);
 3379: }
 3380: 
 3381: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3382:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3383:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3384:    // The formula for the integral is:
 3385:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3386:    
 3387:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3388:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3389:    const double eta_sum  = eta_n(i) + eta_n(j);
 3390:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3391: 
 3392:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3393:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3394: 
 3395: 
 3396:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3397: }
 3398:    
 3399: 
 3400: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3401:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3402:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3403:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3404:    // The formula is also based on the identity:
 3405:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3406:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3407: 
 3408:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3409: 
 3410: 
 3411: 
 3412:    double res = 0.0;
 3413:    
 3414:    // Quadrature points in xi and eta coordinates
 3415:    #pragma unroll
 3416:    for (int i = 0; i < 4; i++) {
 3417:       // For each quadrature point...
 3418: 
 3419:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3420:       const double eta = p.x;
 3421:       const double xi  = p.y;
 3422: 
 3423:       // Jacobian entries at the Gauss point p
 3424:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3425:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3426:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3427:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3428: 
 3429:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3430:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3431: 
 3432:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3433:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3434:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3435:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3436:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3437: 
 3438:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3439:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3440:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3441:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3442:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3443: 
 3444:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3445:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3446:    }
 3447: 
 3448:    return res;
 3449: }
 3450: 
 3451: 
 3452: /**  Interpolate velocities at a given point (xt,yt,zt)
 3453: 
 3454:    @param xt, yt, zt: coordinates of the point to interpolate
 3455:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3456: 
 3457:    This is done in four steps:
 3458: 
 3459:    1. Find the shape coordinates for the final position in the element.
 3460:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3461:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3462:       z levels at xt, yt at each step.   
 3463:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3464:       horizontally and vertically.
 3465: **/
 3466: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3467:    // Interpolate the velocities at the point xt. 
 3468:    // This function works the same for triangular and quadrilateral elements.
 3469:    double shpCoord[4];
 3470:    Vector3 u_int;
 3471: 
 3472: 
 3473:    // First step is to compute the shape coordinates of (xt,yt)
 3474: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3475:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3476: 
 3477:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3478: 
 3479:    // Second step is to find the level that contains zt
 3480:    // Uses a binary search to find the level
 3481:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3482:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3483:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3484:    int R = nvrt - 1;
 3485: 
 3486:    // Get the z coordinates at the nodes of the element at the levels L and R
 3487:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3488:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3489:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3490: 
 3491: 
 3492:    double zL = interpolate(shpCoord, zLAtNodes);
 3493:    double zR = interpolate(shpCoord, zRAtNodes);
 3494: 
 3495:    // Interpolates vertically the velocities
 3496:    double wght1, wght2;
 3497:    if (xt.z <= zL) {
 3498:       wght1 = 1.0;
 3499:       wght2 = 0.0;
 3500:       xt.z = zL;
 3501:    }
 3502:    else if (xt.z >= zR) {
 3503:       wght1 = 0.0;
 3504:       wght2 = 1.0;
 3505:       xt.z = zR;
 3506:    }
 3507:    else {
 3508:       // Perform a binary search to find the levels between L and R that contain xt.z
 3509:       while (R - L > 1) {
 3510:          int M = (L + R) / 2.0;
 3511: 
 3512:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3513:          double zM = interpolate(shpCoord, zMAtNodes);
 3514:          if (zM < xt.z) 
 3515:          {
 3516:             L = M;
 3517:             zL = zM;
 3518:          }
 3519:          else 
 3520:          {
 3521:             R = M;
 3522:             zR = zM;
 3523:          }
 3524:       }
 3525:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3526:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3527: 
 3528:       wght2 = (xt.z - zL)/(zR - zL);
 3529:       wght1 = 1.0 - wght2;
 3530: 
 3531:    }
 3532: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3533: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3534:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3535:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3536:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3537:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3538: 
 3539:    // Project the velocity from the local frame to the origSide frame
 3540:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3541:    u_int = {uv.x, uv.y, w};
 3542: 
 3543:    // Neither of the interpolated velocities should be NaN
 3544:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3545: 
 3546:    return u_int;
 3547: 
 3548: }
 3549: 
 3550: 
 3551: 
 3552: 
 3553: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3554: 
 3555:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3556:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3557:    const Node *n1 = side->n1;
 3558:    const Node *n2 = side->n2;
 3559: 
 3560:    bool n1_match = (n1->nodeBnd->segment == segment);
 3561:    bool n2_match = (n2->nodeBnd->segment == segment);
 3562: 
 3563:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3564:    if (n1_match && n2_match) {
 3565:       return 0.5;
 3566:    } else if (n1_match) {
 3567:       return 1.0;
 3568:    } else if (n2_match) {
 3569:       return 0.0;
 3570:    }
 3571: 
 3572:    return 0.0;
 3573: }
 3574: 
 3575: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3576: 
 3577: 
 3578: 
 3579: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3580:    // Returns the value of the velocity at the side center
 3581:    const double w1 = getBoundaryArrayValueWeight();
 3582:    const double w2 = 1.0 - w1;
 3583:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3584:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3585: 
 3586:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3587: }
 3588: 
 3589: 
 3590: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3591:    // Returns the value of the normal component of the velocity at the side center
 3592:    const double w1 = getBoundaryArrayValueWeight();
 3593:    const double w2 = 1.0 - w1;
 3594:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3595:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3596: 
 3597:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3598: }
 3599: 
 3600: 
 3601: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3602:    if constexpr(ics == 1) {
 3603:       return center;
 3604: 
 3605:    } else {
 3606:       const Point2 p0 = n1->outputCoords();
 3607:       const Point2 p1 = n2->outputCoords();
 3608:       return (1.0/2.0)*(p0 + p1);
 3609: 
 3610:    }
 3611: }
 3612: 
 3613: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3614: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3615: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3616: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3617: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3618: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3619: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3620: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3621: // Computes the gradient of the field at the side center.
 3622:    Vector2 grad = {0.0, 0.0};
 3623:    int count = 0;
 3624: 
 3625:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3626:    // as the average of the gradients at each element.
 3627:    // First element
 3628:    if (elems[0] != nullptr && condition(elems[0])) {
 3629:       Vector2 elemGrad = elems[0]->grad2(field);
 3630: 
 3631:       // For ics=2, projects the element gradient from its frame to the side frame
 3632:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3633: 
 3634:       grad += elemGrad;
 3635: 
 3636:       count++;
 3637:    }
 3638: 
 3639:    // Second element
 3640:    if (elems[1] != nullptr && condition(elems[1])) {
 3641: 
 3642:       Vector2 elemGrad = elems[1]->grad2(field);
 3643: 
 3644:       // For ics=2, projects the element gradient from its frame to the side frame
 3645:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3646: 
 3647:       grad += elemGrad;
 3648: 
 3649:       count++;
 3650:    }
 3651: 
 3652:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3653:    if (count > 0) {
 3654:       grad = grad*(1.0/count);
 3655:    }
 3656:    
 3657:    return grad;
 3658: }
 3659: 
 3660: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3661: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3662: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3663: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3664: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3665: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3666: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3667: 
 3668: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3669: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3670: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3671: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3672: 
 3673: 
 3674: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3675: 
 3676: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3677:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3678:    if constexpr(ics == 1) { 
 3679:       return 0.5*(n1->tau + n2->tau);
 3680: 
 3681:    } else {
 3682:       // Project the tau from the node frames to the side frame
 3683:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3684:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3685: 
 3686:       return 0.5*(stau1 + stau2);
 3687:    }
 3688: }
 3689: 
 3690: /**
 3691:  * This method performs backtracking from the side center until a time -dt back in time 
 3692:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3693:  * intermediate point.
 3694:  *
 3695:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3696:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3697:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3698:  * remaining time.
 3699:  * 
 3700:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3701:  * 
 3702:  * @param uuint, vvint, wwint: Velocities at the final point
 3703:  * @param jlev: Level at which the backtracking is performed
 3704:  * @param dt, dtbk: Tracking timesteps
 3705:   */
 3706: __inline__ __device__ void Side::btrack(
 3707:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3708:       double dt,            // Tracking time
 3709:       double dtbk,          // Tracking timestep
 3710:       Vector3 &u_int        // Velocities at the initial point
 3711: ) const {
 3712: 
 3713:    // Start from side center
 3714:    Point3 x0;
 3715: 
 3716:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3717:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3718: 
 3719:  
 3720:    double time_rm = dt; // Remaining time
 3721:    double time_rm_1 = 1e10;
 3722:    double time_rm_2 = 2e10;
 3723:    double time_rm_3 = 3e10;
 3724: 
 3725: 
 3726:    // Initial velocities
 3727:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3728: 
 3729:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3730:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3731: 
 3732:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3733: 
 3734: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3735: 
 3736: 
 3737:    constexpr int MAX_ITERATIONS = 100; 
 3738:    int iter = 0;
 3739:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3740:    while(true) {
 3741: 
 3742:       // Calculate timestep
 3743:       const double dtb = min(dtbk, time_rm);
 3744: 
 3745:       // Next point in the backtracking curve
 3746:       xt = x0 - dtb*u_int;
 3747: 
 3748:       double t, s; // parameters for the line segments p0pt and p1p2
 3749:       Side *lastCrossSide = nullptr;
 3750:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3751: 
 3752: 
 3753:       if (time_rm_3 <= time_rm) {
 3754:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3755:          xt = x0;
 3756:          break;
 3757:       }
 3758: 
 3759: 
 3760:       if (!found) {
 3761:       // This means that the walk reached a boundary or a dry element.
 3762: 
 3763:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3764: 
 3765:          // Finds the point at the boundary where the line segment x0xt intersects.
 3766:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3767:          // due to floating point errors, it does not exactly intersect.
 3768:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3769:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3770:          // To compute the intersection point we start with the parametric equations.
 3771:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3772:          // We cross-prouct by v1 to cancel the s term:
 3773:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3774:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3775: 
 3776:          // Side coordinates in the origSide frame.
 3777:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3778:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3779: 
 3780:          Point2  p0 = {x0.x, x0.y};
 3781:          Point2  pt = {xt.x, xt.y};
 3782: 
 3783:          const Vector2 v1 = pt - p0;
 3784:          const Vector2 v2 = p2 - p1;
 3785: 
 3786: 
 3787: 
 3788:          // We are assuming intersection, so we clamp t to the range [0,1].
 3789:          const double denom = cross(v2, v1);
 3790:          
 3791: 
 3792: 
 3793: 
 3794:          if (abs(denom) < small) {
 3795:             // small denominators are fairly common. They occur when the line segment x0xt 
 3796:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3797:             // boundary, where the backtracking curve startt sliding along the boundary.
 3798:             // In this case, we simply assume that the two lines are very close to each other
 3799:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3800:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3801:             if (t<0.0000000001) t = 0.0;
 3802:             if (t>0.9999999999) t = 1.0;
 3803: 
 3804:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3805:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3806: 
 3807:          }
 3808:          else {
 3809:             
 3810:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3811:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3812:             if (t>0.9999999999) t = 1.0;
 3813:             // From the originaL equation we can solve for s:
 3814:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3815:             // Computing the dot product by v1, we get:
 3816:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3817:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3818:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3819: 
 3820:          }
 3821: 
 3822:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3823: 
 3824: 
 3825:          // We update the new target point to be right at the intersection point,
 3826:          // and the remaining time must include the time we haven't "used".
 3827:          time_rm -= s*dtb;
 3828:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3829: 
 3830: 
 3831:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3832:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3833: 
 3834:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3835:          // but extracting only the component along the tangent vector v2.
 3836:          Vector2 tangent = normalize(v2);
 3837:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3838: 
 3839:          const Vector2 u2D = make_double2(u.x, u.y);
 3840:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3841: 
 3842: 
 3843:       } else {
 3844: 
 3845:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3846: 
 3847:          time_rm -= dtb; 
 3848: 
 3849:          u_int = curElem->interpolateVelocities(xt, this);
 3850: 
 3851:       }
 3852: 
 3853:       if (time_rm <= 0.0) break; 
 3854: 
 3855:       // If the velocity is too small, we stop the backtracking
 3856:       const double vmag2 = norm2(toVector2(u_int));
 3857:       if (vmag2 <= velmin_btrack_sq)  {
 3858:          time_rm = 0.0; 
 3859:          return; 
 3860:       }
 3861: 
 3862:       // The current point becomes the next segment's starting point.
 3863:       x0 = xt;
 3864:  
 3865:       iter++;
 3866: 
 3867: // XXXXXXXXXXXXXXXXX
 3868: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3869:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3870: 
 3871:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3872:       time_rm_3 = time_rm_2;
 3873:       time_rm_2 = time_rm_1;
 3874:       time_rm_1 = time_rm;
 3875:    }
 3876: 
 3877:    assert(curElem != nullptr && "Final element is nullptr");
 3878:    assert(!curElem->isDry && "Final element is dry");
 3879:    
 3880: 
 3881: 
 3882:    // Interpolate the velocities at the final point with respect to the current side frame
 3883:    u_int = curElem->interpolateVelocities(xt, this);
 3884: 
 3885: 
 3886: }
 3887: 
 3888: 
