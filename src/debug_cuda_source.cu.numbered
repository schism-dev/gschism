 8478: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8479:    Element *elems = mesh->localElemData;
 8480: 
 8481:    *addr = elems;
 8482:    *sizeElement = sizeof(Element);
 8483:    switch (varCode) {
 8484:       case (int)VarCode::z:
 8485:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8486:          *sizeType = sizeof(double);
 8487:          break;
 8488:       case (int)VarCode::x:
 8489:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8490:          *sizeType = sizeof(Vector2);
 8491:          break;
 8492:       case (int)VarCode::gradETP:
 8493:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8494:          *sizeType = sizeof(Vector2);
 8495:          break;
 8496:       case (int)VarCode::area:
 8497:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8498:          *sizeType = sizeof(double);
 8499:          break;
 8500:       case (int)VarCode::depth:
 8501:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8502:          *sizeType = sizeof(double);
 8503:          break;
 8504:       case (int)VarCode::radius:
 8505:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8506:          *sizeType = sizeof(double);
 8507:          break;
 8508:       case (int)VarCode::ghat:
 8509:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8510:          *sizeType = sizeof(Vector2);
 8511:          break;
 8512:       case (int)VarCode::kb:
 8513:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8514:          *sizeType = sizeof(int);
 8515:          break;
 8516:       case (int)VarCode::isdry:
 8517:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8518:          *sizeType = sizeof(int);
 8519:          break;            
 8520:       case (int)VarCode::w:
 8521:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8522:          *sizeType = sizeof(double);
 8523:          break;
 8524:       case (int)VarCode::FaceIndices:
 8525:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8526:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8527:          *sizeType = sizeof(Node);
 8528:          break;
 8529:       default:
 8530:          *offset = -1;
 8531:    }
 8532: }
