 2280: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2281:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2282:                            if (idx_side_bnd >= mesh->nbs) return;  
