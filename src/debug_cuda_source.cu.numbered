 1757: // Helper functions for computing the local node index at a given offset from another.
 1758: __device__ __inline__ int nxq(int offset, int index, int size) {
 1759:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1760:    // to the index to make it positive
 1761:    assert(index + offset + 16*size >= 0);
 1762:    return (index + offset + 16*size) % size;  
 1763: }
 1764: 
 1765: __device__ __inline__ int nxq(int index, int size) {
 1766:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1767:    // to the index to make it positive
 1768:    assert(index + 16*size >= 0);
 1769:    return (index + 16*size) % size; 
 1770: }
