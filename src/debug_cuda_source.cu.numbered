 3645: 
 3646: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3647:    // Computes the z coordinate at level k.
 3648:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3649:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3650:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3651:    // used 
 3652: 
 3653:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3654:    
 3655:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3656: 
 3657:    if (isDry2()) return 0.0;  
 3658: 
 3659:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3660: 
 3661:    if constexpr(ivcor == 2) {
 3662: 
 3663:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3664:       const double h_c = mesh->h_c;
 3665:       const double theta_f = mesh->theta_f;
 3666:       const double sinh_theta_f = mesh->sinh_theta_f;
 3667: 
 3668: 
 3669:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3670:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3671:       // once per time step/node. XXXX
 3672:       // CHECK: updateZCoordData
 3673: 
 3674:       //  To simplify comparisons, I define index versions of count variables.
 3675:       if      (k == ivrt)     return eta2; 
 3676:       else if (k == izlev)    return -hmod2;
 3677:       else if (k == kb)       return -depth;
 3678:       else if (k < izlev)     return mesh->ztot[k];
 3679:       else if (k > izlev) {
 3680:          const int ksig = k - izlev;
 3681: 
 3682:          if (hmod2 <= h_c) {
 3683:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3684: 
 3685:          } 
 3686:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3687:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3688:             assert(false && "compZCoord: invalid h_c\n");
 3689:          } 
 3690:          else {
 3691:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3692:                    h_c * mesh->sigma[ksig] + 
 3693:                    (hmod2 - h_c) * mesh->cs[ksig];
 3694:          }
 3695:       } else { 
 3696:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3697:       }
 3698: 
 3699:    }
 3700:    else {  // if constexpr(ivcor == 1)
 3701:       if (k <= kb)        return -depth; 
 3702:       else if (k == ivrt) return eta2;
 3703:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3704: 
 3705:    }
 3706:    
 3707:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3708:    return 0.0;
 3709: }
 3710: 
 3711: 
 3712: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3713:    // Computes the bottom drag Cd based on the selected nchi
 3714: 
 3715:    if constexpr(nchi == 0) {
 3716:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3717:       Cd = drag;  // Read from drag file
 3718: 
 3719:    } else if constexpr(nchi == 1) {
 3720:       // 
 3721: 
 3722:       bool ltmp = false; // for WBL iteration
 3723: 
 3724:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3725:       if (isDry || (rough == 0.0)) {
 3726:          Cd = 0.0;
 3727: 
 3728:       } else { //roughness >0 
 3729:          
 3730:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3731: 
 3732:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3733: 
 3734:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3735: 
 3736:       } // if rough
 3737: 
 3738:    } else if constexpr(nchi == -1) {
 3739:    // Manning 
 3740:  
 3741:       const double htot = max(hmin_man, htot2()); 
 3742:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3743: 
 3744:    } else {
 3745:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3746:       
 3747:    } // if nchi
 3748: 
 3749: }
 3750: 
 3751: 
 3752: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3753:    // Checks if a side in on the boundary
 3754:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3755: 
 3756:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3757:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3758: 
 3759:    // Indices of the nodes that form the side
 3760:    //
 3761:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3762:    const int n1 = side.n1->idx;
 3763:    const int n2 = side.n2->idx;
 3764:    isLand = false;
 3765:    
 3766: 
 3767:    // Check if the side is on a land boundary
 3768:    for (int i = 0; i < nland; i++) {
 3769:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3770:          // Consecutive nodes in the land boundary segment
 3771:          const int b1 = ilnd[i + j*nland];
 3772:          const int b2 = ilnd[i + (j + 1)*nland];
 3773: 
 3774:          assert(b1 != -1 && b2 != -1);
 3775: 
 3776:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3777:             
 3778:             isLand = true;
 3779:             return i;
 3780:          }
 3781:       }
 3782:    }
 3783: 
 3784:    // Check if the side is on an open boundary
 3785:    for (int i = 0; i < nope; i++) {
 3786:       for (int j = 0; j < nond[i] - 1; j++) {
 3787:          // Consecutive nodes in the open boundary segment
 3788:          const int b1 = iond[i + j*nope];
 3789:          const int b2 = iond[i + (j + 1)*nope];
 3790: 
 3791:          assert(b1 != -1 && b2 != -1);
 3792: 
 3793:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3794:             isLand = false;
 3795:             return i;
 3796:          }
 3797:       }
 3798:    }
 3799: 
 3800:    return -1;
 3801: }
 3802: 
 3803: 
 3804: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3805:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3806:                                     double *wind_rotate_angle, 
 3807:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3808:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3809:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3810:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3811:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3812: 
 3813:    NODE(pnode);  
 3814:    const int i = idx_node;
 3815:    Node &node(*pnode);
 3816: 
 3817:    node.idx = i;
 3818: 
 3819:    const int idxNodeStart = nodeNeighNodesStart[i];
 3820:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3821:    node.numNodes = idxNodeEnd - idxNodeStart;
 3822:    node.nodes = nodeNeighNodes + idxNodeStart;
 3823:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3824: 
 3825: 
 3826: 
 3827:    const int idxElemStart = nodeNeighElemsStart[i];
 3828:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3829:    node.numElements = idxElemEnd - idxElemStart;
 3830:    node.elements = nodeNeighElems + idxElemStart;
 3831: 
 3832: 
 3833:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3834:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3835:       const int partNode = localNodePart[idxNodeGlobal]; 
 3836:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3837: 
 3838:       Node *node_ptr = nodes[partNode] + idxNode;
 3839:       
 3840:       nodeNeighNodes[idx] = node_ptr;
 3841:    }
 3842: 
 3843: 
 3844:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3845:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3846:       const int partElem = localElemPart[idxElemGlobal];
 3847:       const int idxElem  = localElemIndices[idxElemGlobal];
 3848: 
 3849:       Element *elem_ptr = elems[partElem] + idxElem;
 3850: 
 3851:       nodeNeighElems[idx] = elem_ptr;
 3852:    }      
 3853: 
 3854:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3855:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3856: 
 3857:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3858: 
 3859:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3860:    if constexpr(ics == 1) {
 3861:       node.p.x   = node_coords[i * 3];
 3862:       node.p.y   = node_coords[i * 3 + 1];
 3863:       node.gz = 0.0;
 3864: 
 3865:       if (use_ll) {                                    // <-- add
 3866:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3867:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3868:       }  
 3869: 
 3870:    } else {
 3871:       const double lon = deg2rad*node_coords[i * 3];
 3872:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3873: 
 3874:       Point3 p = computeXYZfromLatLon(lat, lon);
 3875:       node.p = toVector2(p);
 3876:       node.gz = p.z;
 3877:       node.lon = lon;
 3878:       node.lat = lat;
 3879: 
 3880:       #ifdef USE_FRAMES
 3881:       node.setFrame(lat, lon);
 3882:       #endif
 3883: 
 3884: 
 3885:    }
 3886: 
 3887:    node.depth = node_coords[i * 3 + 2];
 3888: 
 3889:    node.numSides = 0;
 3890: 
 3891:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3892:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3893:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3894:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3895:    else assert(false && "populateNodes: selected nchi not implemented.");
 3896: 
 3897:    if constexpr(ivcor == 1) 
 3898:    {  
 3899:       node.kb = kb[i];
 3900: 
 3901:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3902:    }
 3903: 
 3904:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3905:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3906:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3907: 
 3908:    
 3909:    // Links the node to the boundary information
 3910:    if (isbnd[i] >= 0) {
 3911:      
 3912:       // Get the index of the node boundary
 3913:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3914: 
 3915:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3916:       node.nodeBnd->node = &node;
 3917: 
 3918:       node.nodeBnd->sideBnd1 = nullptr;
 3919:       node.nodeBnd->sideBnd2 = nullptr;
 3920: 
 3921:       if (isbnd[i]>=0) {
 3922: 
 3923:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3924:          
 3925:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3926:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3927: 
 3928:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3929:          node.nodeBnd->segment->clen  = nan("1");
 3930:          node.nodeBnd->segment->carea = nan("1");
 3931: 
 3932:       }
 3933:    } else {
 3934: 
 3935:       node.nodeBnd = nullptr; // For internal nodes
 3936: 
 3937:       if (isbnd[i] == landSegment) {
 3938:          node.nodeBnd = &landBoundaryNode;
 3939:          node.nodeBnd->segment = &landBoundarySegment;
 3940:       }
 3941:       
 3942:    }
 3943:    
 3944:    // XXXX GAUSSIAN HILL VELOCITIES
 3945:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3946:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3947:          constexpr double rot_per = 3000.0;
 3948:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3949:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3950:       // XXXXX
 3951:    #endif
 3952: 
 3953: }
 3954: 
 3955: 
 3956: 
 3957: 
 3958: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3959:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3960:                                     double *wind_rotate_angle,   
 3961:                                     int *isdel, int *isidenode, int *isbnd,
 3962:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3963:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3964:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3965:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3966:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3967:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3968:                                     double *drag, double *roughness) {
 3969: 
 3970: 
 3971:    SIDE(pside);
 3972:    Side &side(*pside);
 3973:    const int i = idx_side;
 3974: 
 3975:    side.idx = i;  
 3976:    
 3977:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3978:    const double fc   = 2.0*omega_e*sin(sfea0);
 3979:    const double beta = 2.0*omega_e*cos(sfea0);
 3980: 
 3981:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3982: 
 3983:    // finding the pointer to the nodes that form the side
 3984:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3985:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3986: 
 3987:    const int locidx_n1 = localNodeIndices[idx_n1];
 3988:    const int locidx_n2 = localNodeIndices[idx_n2];
 3989:    const int part_n1 =   localNodePart[idx_n1];
 3990:    const int part_n2 =   localNodePart[idx_n2];
 3991: 
 3992:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3993:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3994: 
 3995: 
 3996:    // Counts the number of sides connected to each node
 3997:    atomicAdd(&side.n1->numSides, 1);
 3998:    atomicAdd(&side.n2->numSides, 1);
 3999: 
 4000:    // Side boundary type
 4001:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4002:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4003: 
 4004:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4005:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4006:    {
 4007:       bool isLand = false;
 4008:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4009:       
 4010:       if (isbs > -1) {
 4011:          // assert(isLand || isbs>=0);
 4012:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4013: 
 4014:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4015: 
 4016:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4017:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4018: 
 4019:          assert (isLand == side.sideBnd->segment->isLand);
 4020: 
 4021: printf("idx_side: %d, side.sideBnd = %p, n1bnd->idx: %d, n2bnd->idx: %d, n1bnd->sideBnd1: %p, n1bnd->sideBnd2: %p, n2bnd->sideBnd1: %p, n2bnd->sideBnd2: %p\n", i, side.sideBnd, n1bnd->idx, n2bnd->idx, n1bnd->sideBnd1, n1bnd->sideBnd2, n2bnd->sideBnd1, n2bnd->sideBnd2);
 4022: 
 4023:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4024:          // if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4025:          // else                            n1bnd->sideBnd2 = side.sideBnd;
 4026: 
 4027:          // if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4028:          // else                            n2bnd->sideBnd2 = side.sideBnd;
 4029:          
 4030:          side.sideBnd->side = &side;
 4031: 
 4032:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4033:          n1bnd->linkSideBoundary(side.sideBnd);
 4034:          n2bnd->linkSideBoundary(side.sideBnd);
 4035: 
 4036:       }
 4037:       else {
 4038:          side.sideBnd = nullptr;
 4039:       }
 4040:    }
 4041:    else 
 4042:    {
 4043:       side.sideBnd = nullptr;
 4044:    }
 4045: 
 4046: 
 4047:    // finding the pointer to the elements that share the side
 4048:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4049:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4050: 
 4051:    if (idx_e1 > -1) {
 4052:       const int locidx_e1 = localElemIndices[idx_e1];
 4053:       const int part_e1 =  localElemPart[idx_e1];
 4054:       side.elems[0] = elems[part_e1] + locidx_e1;
 4055: 
 4056:    }
 4057:    else {
 4058:       side.elems[0] = nullptr;
 4059:    }
 4060: 
 4061:    if (idx_e2 > -1) {
 4062:       const int locidx_e2 = localElemIndices[idx_e2];
 4063:       const int part_e2 =  localElemPart[idx_e2];
 4064:       side.elems[1] = elems[part_e2] + locidx_e2;
 4065:    }
 4066:    else {
 4067:       side.elems[1] = nullptr;
 4068:    }
 4069:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4070:       
 4071:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4072:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4073:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4074:          
 4075:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4076:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4077:       // printf("sideBnd: %p\n", side.sideBnd);
 4078:       // assert(false && "Side has no elements and no boundary");
 4079:    }
 4080:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4081: 
 4082:    // Compute the center of the side
 4083:    side.center = 0.5*(side.n1->p + side.n2->p);
 4084: 
 4085:    #ifdef USE_FRAMES
 4086:    side.setFrame();
 4087:    #endif
 4088: 
 4089:    // Normal, unitary vector to the side
 4090:    if constexpr(ics == 1) {
 4091:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4092:       side.n = normalize(side.n);
 4093:    }
 4094:    else {
 4095:       // Unit side vector in 3D cartesian coordinates
 4096:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4097: 
 4098:       nSide = normalize(nSide);
 4099: 
 4100:       // Its cross product with the unit local z-axis vector (nUp) is the
 4101:       // normal vector we are looking for.
 4102:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4103: 
 4104:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4105:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4106:       side.n = -normalize(n2D); 
 4107: 
 4108:    }
 4109: 
 4110:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4111:    side.shapiro = shapiro0;
 4112: 
 4113:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4114:    // XXXX
 4115:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4116:    constexpr double rot_per=3000.0;
 4117:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4118:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4119:    // XXXXX      
 4120:    #endif
 4121:    // Compute the z level at the center of the side
 4122:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4123:    
 4124:    // Compute the length of the side
 4125:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4126: 
 4127: 
 4128:    // Compute the Coriolis coefficient
 4129: 
 4130:    if constexpr(ncor == -1 || ncor == 0) {
 4131:       side.coriolis = coricoef;
 4132:    }
 4133:    else {
 4134:       const double sphi = side.lat();  // Latitude at the center of the side
 4135: 
 4136:       assert(use_ll && "use_ll must be true when ncor > 0");
 4137: 
 4138:       if constexpr(ics == 1) {
 4139:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4140:       }
 4141:       else { // ics == 2
 4142:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4143:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4144:       }
 4145: 
 4146:    }
 4147: 
 4148: }
 4149: 
 4150: 
 4151: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4152:    double *node_coords, double *node_coords_ll, bool use_ll,
 4153:    double *wind_rotate_angle,   
 4154:    int *isdel, int *isidenode, int *isbnd,
 4155:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4156:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4157:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4158:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4159:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4160:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4161:    double *drag, double *roughness) {
 4162: 
 4163:    ELEM(pelem);
 4164:    Element &elem(*pelem);
 4165:    const int i = idx_elem;
 4166: 
 4167:    elem.idx = i;
 4168: 
 4169:    for (int j = 0; j < i34[i]; j++) {
 4170:       const int idxNode = elnode[i*4 + j];  
 4171:       const int idxSide = elside[i*4 + j];
 4172:       
 4173:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4174:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4175: 
 4176:       // Find the neighboring element  
 4177:       if (elem.sides[j]->elems[0] == &elem) {
 4178:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4179:       }
 4180:       else {
 4181:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4182:       }
 4183:       
 4184:    }
 4185: 
 4186:    elem.i34 = i34[i];
 4187: 
 4188:    // Compute the barycenter of the element and its depth
 4189:    elem.center = {0.0, 0.0};
 4190:    elem.depth = 1e10;
 4191:    for (int j = 0; j < i34[i]; j++) {
 4192: 
 4193:       elem.center += elem.nodes[j]->p/i34[i];
 4194:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4195:    }
 4196: 
 4197:    #ifdef USE_FRAMES
 4198:    elem.setFrame();
 4199:    #endif
 4200: 
 4201:    elem.area = elem.computeSignedArea(); 
 4202:    elem.radius = sqrt(elem.area)/pi; 
 4203:    
 4204:    // Determines which way the normal vector to each side is oriented.
 4205:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4206:    for (int j = 0; j < i34[i]; j++)  
 4207:    {
 4208:       if (elem.sides[j]->elems[0] == &elem) {
 4209:          elem.ssign[j] =  1.0;
 4210:       }
 4211:       else {
 4212:          elem.ssign[j] = -1.0;
 4213:       }
 4214: 
 4215:    }
 4216: 
 4217:   
 4218: 
 4219:    // Derivatives of shape functions
 4220:    //  For ics=2, this is done in the element frame
 4221:    //  For quads, the derivative is evaluated at centroid
 4222:    for (int j = 0; j < elem.i34; j++) {
 4223:       const double area = elem.area;
 4224:       const int id2 = elem.nxq(1 + j);
 4225:       const int id3 = elem.nxq(2 + j);
 4226:       const int id4 = elem.nxq(3 + j);
 4227:       if (elem.isTri()) {
 4228:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4229:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4230:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4231:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4232:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4233:          // And so on for the other shape functions.
 4234: 
 4235:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4236:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4237:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4238: 
 4239:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4240:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4241: 
 4242:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4243: 
 4244:       }
 4245:       else  { // Quad, the derivatives are evaluated at the centroid
 4246: 
 4247:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4248:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4249:          // ...
 4250:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4251: 
 4252:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4253:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4254:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4255: 
 4256:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4257:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4258: 
 4259:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4260: 
 4261:       } // if Tri/Quad
 4262: 
 4263:    } // for j   
 4264:    
 4265:    
 4266: 
 4267: }
 4268: 
 4269: 
 4270: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4271:                                             double *emo, double *efa, 
 4272:                                             double *umo, double *ufa, 
 4273:                                             double *vmo, double *vfa,
 4274:                                             int *ifltype, int *iettype) {
 4275: 
 4276:    NODE_BND(nodeBnd);
 4277:    const int idx = idx_node_bnd;    
 4278: 
 4279:    nodeBnd->idx = idx;
 4280: 
 4281:    // Need to find the segment index and the index of the node on the segment
 4282:    int idxNode = -1;
 4283:    int iseg, i;
 4284:    for (iseg = 0; iseg < nope; iseg++) {
 4285:       // for each segment...
 4286:       for (i = 0; i < nond[iseg]; i++) {
 4287:          idxNode = iond[iseg + i*nope];
 4288:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4289:          
 4290:       }
 4291:    }
 4292: 
 4293:    assert(iseg < nope && "iseg is out of bounds");
 4294: 
 4295: found: // Jumped here when the node was found
 4296: printf("idxNode: %d, iseg: %d, i: %d\n", idxNode, iseg, i);
 4297:    nodeBnd->isEssentialBC = true;
 4298:    nodeBnd->elbc = 0.0;
 4299: 
 4300:    nodeBnd->segment->ifltype = ifltype[iseg];
 4301:    nodeBnd->segment->iettype = iettype[iseg];
 4302: 
 4303:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4304: 
 4305:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4306: 
 4307:       nodeBnd->efa[jfr] = efa[idx2];
 4308:       nodeBnd->emo[jfr] = emo[idx2];
 4309:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4310:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4311: 
 4312:    }
 4313:         
 4314: 
 4315: }
 4316: 
 4317: __device__ void Mesh::populateBoundarySideLinks(void) {
 4318: 
 4319:    SIDE_BND(sideBnd);
 4320: 
 4321:    const Side *side = sideBnd->side;
 4322: 
 4323:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4324:    // and the rightSide is the side s that has s->n1 == side->n2
 4325:    for (int i = 0; i < mesh->nbs; i++) {
 4326: 
 4327:       Side *s = &mesh->localSideData[i];
 4328: 
 4329:       if (s == side) continue;  // Do not link the side to itself
 4330:    
 4331:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4332:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4333:    }
 4334:    
 4335: }
