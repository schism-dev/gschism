 9129: 
 9130: __global__ void transport(void) {
 9131: 
 9132:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 9133: 
 9134:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 9135: 
 9136:    Element *elem = &(mesh->localElemData[ie]);
 9137: 
 9138:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 9139: 
 9140:                for (int m=0; m<ntr; m++) {
 9141:                   for (int k=kbe(ie); k<nvrt; k++) {
 9142:                      // Calculate each polynomial's weight 
 9143:                      wm=0.d0; sum1=0.d0; 
 9144:                      wm1=0.d0; wm2=0.d0; 
 9145:                      for (int i=0; i<elem->nweno2; i++) {
 9146:                   
 9147:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9148:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9149:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9150:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9151:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9152:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 9153:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 9154:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 9155:                      // -----------------Hu and Shu (1999)'s method----------------
 9156:                      b4=b1+b2+b3
 9157: 
 9158: //Error: add PRODUCTION CPP
 9159: #ifdef DEBUG
 9160:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 9161:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 9162:                     call parallel_abort(errmsg)
 9163:                   }
 9164: #endif
 9165: 
 9166:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 9167:                   // !----test-------------- 
 9168:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 9169:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 9170:                   // !wm(i)=wm1(i)*wm2(i)
 9171:                   // !---------------------- 
 9172:                   sum1=sum1+wm(i)
 9173:                 } // end for i
 9174: 
 9175:                 wm=wm/sum1
 9176: 
 9177:                 for (int j=0; j<elem->i34; j++) {
 9178: 
 9179:                   const Side *side  = elem->sides[j];
 9180:                   const Node *node1 = side->n1;
 9181:                   const Node *node2 = side->n2;
 9182: 
 9183:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 9184:                      trsd=0.d0
 9185:                      for (int kk=0; kk<nquad; kk++) {
 9186:                         for (int i=0; i<elem->nweno2; i++) {
 9187:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 9188:                         } // end for i   
 9189:                      } // end for kk
 9190:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 9191:                   } // outward flux
 9192:                } // end for j=1,i34(ie) ! side
 9193:             }
 9194:          }
 9195:               
 9196: 
 9197: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 9198: //             //   calculate each polynomial's weight 
 9199: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 9200: //                 wm=0.d0; sum1=0.d0
 9201: //                 do i=1,nweno1(ie) !for each polynomial
 9202: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9203: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 9204: //                   b1=b1*b1+b2*b2 !smoothness indicator
 9205: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 9206: //                   wm(i)=b2
 9207: //                   sum1=sum1+b2
 9208: //                   !wm(i)=1.d0
