 7152: __global__ void printMatrix(void) {
 7153: 
 7154: 
 7155:    // Let only one thread per block print at a time 
 7156: 
 7157:    if (threadIdx.x == 0) {
 7158:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7159:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7160:          if (idx_node >= mesh->np) return;
 7161:          const Node *node = mesh->localNodeData + idx_node;
 7162:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7163:          for (int j = 0; j < node->numNodes; j++) {
 7164:             Node* nbNode = node->nodes[j];
 7165:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7166:          }
 7167:          printf("]\n");
 7168: 
 7169:       }
 7170:    }
 7171: 
 7172: 
 7173: 
 7174: }
 7175: 
 7176: 
 7177: __global__ void computeMatrixProductAndDotProducts() {
 7178:    // Computes A*p, r'Mr and p'Ap
 7179: 
 7180:    // 1) shared buffer: first half for rMr, second for pAp
 7181:    __shared__ double sdata[2*BLOCK_SIZE];
 7182:    double* s_rMr = sdata;
 7183:    double* s_pAp = sdata + BLOCK_SIZE;
 7184: 
 7185:    s_rMr[threadIdx.x] = 0.0;
 7186:    s_pAp[threadIdx.x] = 0.0;
 7187: 
 7188:    // 2) get your node pointer
 7189:    NODE(node);  
 7190:    const int tid = threadIdx.x;
 7191: 
 7192:    const double diag = node->coeffDiag;
 7193:    const double r    = node->mR;
 7194:    const double p    = node->mP;  
 7195: 
 7196:    // apply preconditioner on the fly:
 7197:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7198: 
 7199:    // 4) compute Ap = A.p
 7200:    double Ap = node->coeffDiag * node->mP;
 7201:    for (int j = 0; j < node->numNodes; ++j) {
 7202:       const Node *nbNode = node->nodes[j];
 7203:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7204: 
 7205:    }
 7206:    node->mAp = Ap;
 7207:     
 7208: 
 7209:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7210:    const double l_rMr = r*Mr;  // r'Mr
 7211:    const double l_pAp = p*Ap;  // p'Ap
 7212: 
 7213:    // 6) write into shared mem
 7214:    s_rMr[tid] = l_rMr;
 7215:    s_pAp[tid] = l_pAp;
 7216: 
 7217:    __syncthreads();
 7218: 
 7219:    // 7) block-wide tree reduction
 7220:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7221:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7222:       __syncthreads();
 7223:    }
 7224: 
 7225:    // 8) thread 0 atomically accumulates into the globals
 7226:    // XXX: This is slower than it needs to be, but it is simple and works
 7227:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7228: 
 7229: 
 7230: }
 7231: 
 7232: 
 7233: __global__ void updateSolutionAndDotProducts(void) {
 7234:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7235: 
 7236:    s_rMr[threadIdx.x] = 0.0;
 7237: 
 7238: 
 7239:    // get node & bounds-check:
 7240:    NODE(node);
 7241:    const int tid = threadIdx.x;
 7242: 
 7243: 
 7244:    // Compute alpha
 7245:    const double alpha = (*rMr_old)/(*pAp);
 7246: 
 7247:    // load scalars
 7248:    const double diag = node->coeffDiag;
 7249:    const double p    = node->mP;
 7250:    const double Ap   = node->mAp;
 7251:    const double x    = node->mX;
 7252:    const double r    = node->mR;
 7253:    
 7254:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7255: 
 7256:    // 1) update solution & residual
 7257:    const double x_new = x + alpha*p;
 7258:    const double r_new = r - alpha*Ap;
 7259:    node->mX = x_new;
 7260:    node->mR = r_new;
 7261: 
 7262:    // 2) apply Jacobi preconditioner on the fly
 7263:    const double Mr_new = r_new/diag;
 7264: 
 7265: 
 7266:    // 3) local contributions for the two dot-products
 7267:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7268: 
 7269:    // 4) write into shared-mem
 7270:    s_rMr[tid] = l_rMr;
 7271: 
 7272:    __syncthreads();
 7273: 
 7274: 
 7275:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7276:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7277:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7278:       __syncthreads();
 7279:    }
 7280: 
 7281:    // 6) thread 0 atomically folds into the global accumulators
 7282:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7283: 
 7284: 
 7285: }
 7286: 
 7287: 
 7288: __global__ void updateSearchDirection() {
 7289:     NODE(node);
 7290: 
 7291:     // recompute z on-the-fly
 7292:     const double z = node->mR / node->coeffDiag;
 7293:     const double p = node->mP;
 7294: 
 7295:     const double beta = (*rMr_new)/(*rMr_old);
 7296: 
 7297: 
 7298:     // p =z + beta*p
 7299:     node->mP = z + beta*p;
 7300: 
 7301: }
 7302: 
 7303: __global__ void initializePreconditionedResidual(double *scalars) {
 7304: 
 7305:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7306: 
 7307:     s_rMr[threadIdx.x] = 0.0;
 7308: 
 7309:     NODE(node);
 7310:     const int tid = threadIdx.x;
 7311:     // For the first iteration:
 7312:     // 1. Initial solution x = 0 (already set)
 7313:     // 2. Initial residual r = b (stored in qel)
 7314:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7315: 
 7316: // XXX we should use the guess solution here    
 7317: 
 7318:     // Set initial residual r = b (from qel)
 7319:     node->mR = node->qel;
 7320: 
 7321:     // Compute z = M^-1 * r (preconditioned residual)
 7322:     const double z = node->mR / node->coeffDiag;
 7323: 
 7324:     // Set initial search direction p = z
 7325:     node->mP = z;
 7326: 
 7327:     // Initialize other variables needed for CG
 7328:     node->mX = 0.0;  // Initial solution
 7329:     node->mAp = 0.0; // Will be computed in first iteration
 7330: 
 7331:     // These point to a cupy array in the host code
 7332:     rMr_old = scalars + 0;
 7333:     rMr_new = scalars + 1;
 7334:     pAp     = scalars + 2;
 7335: 
 7336:     // Computes the first r'Mr (reduction)
 7337:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7338: 
 7339:     // 4) write into shared-mem
 7340:     s_rMr[tid] = l_rMr;
 7341: 
 7342:     __syncthreads();
 7343: 
 7344: 
 7345:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7346:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7347:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7348:         __syncthreads();
 7349:     }
 7350: 
 7351:     // 6) thread 0 atomically folds into the global accumulators
 7352:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7353: 
 7354:     *rMr_old = 0.0;
 7355:     *pAp = 0.0;
 7356: }
 7357: 
 7358: 
 7359: 
 7360: 
 7361: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7362:    // Get the value of a variable from an element
 7363:    // varName is the name of the variable to get
 7364:    // var is the array to store the value
 7365:    // k is the vertical level index of the variable to get
 7366: 
 7367:    ELEM(elem);
 7368:    
 7369:    int idx = elem->idx;
 7370:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7371: 
 7372:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7373:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7374:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7375:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7376:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7377:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7378:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7379:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7380:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7381:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7382:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7383:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7384:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7385:       
 7386:    
 7387: }
 7388: 
 7389: 
 7390: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7391:    // Get the value of a variable from an node
 7392:    // varName is the name of the variable to get
 7393:    // var is the array to store the value
 7394:    // k is the vertical level index of the variable to get
 7395: 
 7396:    NODE(node);
 7397:    
 7398:    int idx = node->idx;
 7399:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7400: 
 7401:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7402:    
 7403:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7404:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7405:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7406:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7407:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7408:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7409:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7410:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7411:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7412:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7413:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7414:    
 7415:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7416:       
 7417:    
 7418: }
 7419: 
 7420: 
 7421: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7422:    // Get the value of a variable from an side
 7423:    // varName is the name of the variable to get
 7424:    // var is the array to store the value
 7425:    // k is the vertical level index of the variable to get
 7426:    SIDE(side);
 7427:    
 7428:    int idx = side->idx;
 7429:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7430: 
 7431:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7432:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7433:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7434:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7435:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7436:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7437:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7438:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7439:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7440:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7441:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7442:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7443:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7444:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7445:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7446:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7447:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7448:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7449:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7450:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7451:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7452:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7453:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7454:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7455: }
