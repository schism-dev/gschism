 1908: __device__ void lock(int *mutex) {
 1909:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1910: }
 1911: 
 1912: __device__ void unlock(int *mutex) {
 1913:     atomicExch(mutex, 0);
 1914: }
