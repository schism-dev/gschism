 3568:          const int part_e1 =  localElemPart[idx_e1];
 3569:          side.elems[0] = elems[part_e1] + locidx_e1;
 3570: 
 3571:       }
 3572:       else {
 3573:          side.elems[0] = nullptr;
 3574:       }
 3575: 
 3576:       if (idx_e2 > -1) {
