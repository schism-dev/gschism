  703:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  704:       // Check if the point (xt,yt) is inside the element
  705:       double shpCoords[4];
  706: 
  707:       bool res = computeShapeCoords(xt, shpCoords, false);
  708: 
  709:       return res;
  710:    }
  711: 
  712:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  713:       // Check if the point (xt,yt) is inside the element
  714:       double shpCoords[4];
  715: 
  716:       Vector2 tmp_xt = xt;
  717:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  718: 
  719:       if (fixCoords && res) xt = tmp_xt;
  720: 
  721:       return res;
  722:    }
  723: 
  724:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  725:    {
  726:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  727:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  728:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  729:       
  730:    }
  731: 
  732:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  733: 
  734:    // ------------------------------------------------------------------------------------------------
  735:    // These are functions that work on all nodes of the element.
  736:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  737:    //
  738:    // An example of how to use these functions is:
  739:    //   
  740:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  741:    // 
  742:    // Where L is the level at which the field is to be interpolated. The field can be either
  743:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  744:    // There are different versions of getNodalValues for each of these cases.
  745: 
  746:    template<typename T>
  747:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  748:       // Get the values of the field at the nodes of the element
  749:       res[0] = nodes[0]->*field;
  750:       res[1] = nodes[1]->*field;
  751:       res[2] = nodes[2]->*field;
  752:       if (isQuad()) res[3] = nodes[3]->*field;
  753:       else          res[3] = T();
  754:    }
  755: 
  756:    template<typename T>
  757:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  758:       // Get the values of the field at the nodes of the element
  759:       res[0] = (nodes[0]->*field)[level];
  760:       res[1] = (nodes[1]->*field)[level];
  761:       res[2] = (nodes[2]->*field)[level];
  762:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  763:       else          res[3] = T();
  764:    }    
  765: 
  766:    template<typename T>
  767:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  768:       // Get the values of the func at the nodes of the element
  769:       res[0] = (nodes[0]->*func)(level);
  770:       res[1] = (nodes[1]->*func)(level);
  771:       res[2] = (nodes[2]->*func)(level);
  772:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  773:       else          res[3] = T();  // This is 0.0 or a zero vector
  774: 
  775:    }      
  776: 
  777:    template<typename T>
  778:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  779:       // Get the values of the field at the nodes of the element
  780:       res[0] = sides[0]->*field;
  781:       res[1] = sides[1]->*field;
  782:       res[2] = sides[2]->*field;
  783:       if (isQuad()) res[3] = sides[3]->*field;
  784:       else          res[3] = T();
  785:    }
  786: 
  787:    template<typename T>
  788:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  789:       // Get the values of the field at the nodes of the element
  790:       res[0] = (sides[0]->*field)[level];
  791:       res[1] = (sides[1]->*field)[level];
  792:       res[2] = (sides[2]->*field)[level];
  793:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  794:       else          res[3] = T();
  795:    }    
  796: 
  797:    template<typename T>
  798:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  799:       // Get the values of the func at the nodes of the element
  800:       res[0] = (sides[0]->*func)(level);
  801:       res[1] = (sides[1]->*func)(level);
  802:       res[2] = (sides[2]->*func)(level);
  803:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  804:       else          res[3] = T();  // This is 0.0 or a zero vector
  805: 
  806:    }      
  807: 
  808:    template<typename T>
  809:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  810:       T values[4];
  811:       getNodalValues(level, func, values);
  812: 
  813:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  814:    }
  815: 
  816:    template<typename T>
  817:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  818:       T values[4];
  819:       getNodalValues(field, values);
  820:       
  821:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  822:    }
  823: 
  824: 
  825:    template<typename T>
  826:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  827:       T values[4];
  828:       getNodalValues(level, field, values);
  829: 
  830:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  831:    }
  832: 
  833:    template<typename T>
  834:    __device__ T mean(T Node::* field) const {
  835:       T values[4];
  836:       getNodalValues(field, values);
  837: 
  838:       return (values[0] + values[1] + values[2] + values[3])/i34;
  839:    }
  840: 
  841:    template<typename T>
  842:    __device__ T mean(T Side::* field) const {
  843:       T values[4];
  844:       getSideValues(field, values);
  845:       
  846:       return (values[0] + values[1] + values[2] + values[3])/i34;
  847:    }   
  848: 
  849:    template<typename T>
  850:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  851:       T values[4];
  852:       getNodalValues(level, field, values);
  853: 
  854:       return (values[0] + values[1] + values[2] + values[3])/i34;
  855:    }
  856: 
  857:    template<typename T>
  858:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  859:       T values[4];
  860:       getSideValues(level, field, values);
  861:       
  862:       return (values[0] + values[1] + values[2] + values[3])/i34;
  863:    }   
  864: 
  865:    // __device__ double mean(double (Node::*func)(int) const) const {
  866:    //    double values[4];
  867:    //    getNodalValues(level, func, values);
  868:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  869:    // }
  870:    // ------------------------------------------------------------------------------------------------
  871: 
  872:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  873:       // Convert global coordinates to local coordinates
