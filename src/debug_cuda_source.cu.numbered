  963: 
  964:    __inline__ __device__ bool containsPoint(Vector2 xt, const Side *origSide) const;
  965: 
  966:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const;
  967: 
  968:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  969:    {
  970:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  971:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  972:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  973:       
  974:    }
  975: 
  976:    __device__ Vector3 interpolateVelocities(Point3 xt, const Side *origSide = nullptr) const;
  977: 
  978:    // ------------------------------------------------------------------------------------------------
  979:    // These are functions that work on all nodes/sides of the element.
  980:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  981:    //
  982:    // An example of how to use these functions is:
  983:    //   
  984:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  985:    // 
  986:    // Where L is the level at which the field is to be interpolated. The field can be either
  987:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  988:    // There are different versions of getNodalValues for each of these cases.
  989: 
  990:    template<typename T>
  991:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
  992: 
  993:    template<typename T>
  994:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
  995:   
  996:    template<typename T>
