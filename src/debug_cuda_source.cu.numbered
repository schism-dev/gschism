 7969: __global__ void printMatrix(bool full) {
 7970:    // Debugging: print the matrix
 7971: 
 7972:    const int size = mesh->np;
 7973:    double sum = 0.0;
 7974:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7975:       const Node *node = mesh->localNodeData + idx_node;
 7976:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7977:       for (int j = 0; j < node->numNodes; j++) {
 7978:          Node* nbNode = node->nodes[j];
 7979:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7980:          sum += node->coeffMatrix[j];
 7981:       }
 7982:       if (full) printf("]\n");
 7983: 
 7984: 
 7985:    }
 7986:    if (!full) printf("sum=%lf\n", sum);
 7987: }
