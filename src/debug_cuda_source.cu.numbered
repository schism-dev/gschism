 1600:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1601:       // Compute the different time ramps used in the code 
 1602:       // This function is performed by just one thread
 1603: 
 1604:       if constexpr(ibc == 0) {
 1605:          if (drampbc > 0.0) {
 1606:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1607:          } else {
 1608:             rampbc = 1.0;
 1609:          }
 1610: 
 1611:          if (nws != 0 && drampwind > 0.0) {
 1612:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1613:          } else {
 1614:             rampwind = 1.0;
 1615:          }
 1616:       }
 1617: 
 1618:       if (drampwafo > 0.0) {
 1619:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1620:       } else {
 1621:          rampwafo = 1.0;
 1622:       }
 1623: 
 1624:       // For source/sinks
 1625:       if (if_source && dramp_ss > 0.0) {
 1626:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1627:       } else {
 1628:          ramp_ss = 1.0;
 1629:       }
 1630: 
 1631:       if (dramp > 0.0) {
 1632:          ramp = tanh(2.0*time/86400.0/dramp);
 1633:       } else {
 1634:          ramp = 1.0;
 1635:       }
 1636: 
 1637:    }
