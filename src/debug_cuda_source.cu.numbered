 9906: template<TurbulenceModel M>
 9907: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
 9908:    if constexpr (M == TurbulenceModel::GLS)
 9909:       return turb.tke[k];
 9910:    else
 9911:       return 0.0;
 9912: }
 9913: template<TurbulenceModel M>
 9914: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
 9915:    if constexpr (M == TurbulenceModel::GLS)
 9916:       return turb.mxl[k];
 9917:    else
 9918:       return 0.0;
 9919: }
 9920: 
 9921: 
 9922: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9923:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9924:    NODE(node);
 9925: 
 9926:    switch (varCode) {
 9927:       case (int)VarCode::outputCoords: {
 9928:          const Point2 coords = node->outputCoords();
 9929:          double *out = (double *)((char *)res + idx_node * 16);
 9930:          out[0] = coords.x;
 9931:          out[1] = coords.y;
 9932:          break;
 9933:       }
 9934:       case (int)VarCode::depth:
 9935:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9936:          break;
 9937:       case (int)VarCode::kb:
 9938:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9939:          break;
 9940:       case (int)VarCode::eta:
 9941:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9942:          break;
 9943:       case (int)VarCode::u_air: {
 9944:          double *out = (double *)((char *)res + idx_node * 16);
 9945:          out[0] = node->u_air.x;
 9946:          out[1] = node->u_air.y;
 9947:          break;
 9948:       }
 9949:       case (int)VarCode::isdry:
 9950:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9951:          break;
 9952:       case (int)VarCode::u: {
 9953:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9954:          if (k >= 0) {
 9955:             out[0] = node->u2[k].x;
 9956:             out[1] = node->u2[k].y;
 9957:          } else {
 9958:             for (int lev = 0; lev < nvrt; lev++) {
 9959:                out[lev*2    ] = node->u2[lev].x;
 9960:                out[lev*2 + 1] = node->u2[lev].y;
 9961:             }
 9962:          }
 9963:          break;
 9964:       }
 9965:       case (int)VarCode::z: {
 9966:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9967:          if (k >= 0)
 9968:             out[0] = node->z[k];
 9969:          else
 9970:             for (int lev = 0; lev < nvrt; lev++)
 9971:                out[lev] = node->z[lev];
 9972:          break;
 9973:       }
 9974:       case (int)VarCode::w: {
 9975:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9976:          if (k >= 0)
 9977:             out[0] = node->w2[k];
 9978:          else
 9979:             for (int lev = 0; lev < nvrt; lev++)
 9980:                out[lev] = node->w2[lev];
 9981:          break;
 9982:       }
 9983:       case (int)VarCode::dfh: {
 9984:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9985:          if (k >= 0)
 9986:             out[0] = node->dfh[k];
 9987:          else
 9988:             for (int lev = 0; lev < nvrt; lev++)
 9989:                out[lev] = node->dfh[lev];
 9990:          break;
 9991:       }
 9992:       case (int)VarCode::dfv: {
 9993:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9994:          if (k >= 0)
 9995:             out[0] = node->dfv[k];
 9996:          else
 9997:             for (int lev = 0; lev < nvrt; lev++)
 9998:                out[lev] = node->dfv[lev];
 9999:          break;
10000:       }
10001:       case (int)VarCode::tke: {
10002:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10003:          if (k >= 0)
10004:             out[0] = getTKE(node->turb, k);
10005:          else
10006:             for (int lev = 0; lev < nvrt; lev++)
10007:                out[lev] = getTKE(node->turb, lev);
10008:          break;
10009:       }
10010:       case (int)VarCode::mxl: {
10011:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10012:          if (k >= 0)
10013:             out[0] = getMXL(node->turb, k);
10014:          else
10015:             for (int lev = 0; lev < nvrt; lev++)
10016:                out[lev] = getMXL(node->turb, lev);
10017:          break;
10018:       }
10019:       case (int)VarCode::temp: {
10020:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10021:          if (k >= 0)
10022:             out[0] = node->tracers[k].tracer[0];
10023:          else
10024:             for (int lev = 0; lev < nvrt; lev++)
10025:                out[lev] = node->tracers[lev].tracer[0];
10026:          break;
10027:       }
10028:       case (int)VarCode::salt: {
10029:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10030:          if (k >= 0)
10031:             out[0] = node->tracers[k].tracer[1];
10032:          else
10033:             for (int lev = 0; lev < nvrt; lev++)
10034:                out[lev] = node->tracers[lev].tracer[1];
10035:          break;
10036:       }
10037:       case (int)VarCode::rho: {
10038:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10039:          if (k >= 0)
10040:             out[0] = node->rho[k];
10041:          else
10042:             for (int lev = 0; lev < nvrt; lev++)
10043:                out[lev] = node->rho[lev];
10044:          break;
10045:       }
10046:    }
10047: }
10048: 
10049: 
10050: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
10051:    SIDE(side);
10052: 
10053:    switch (varCode) {
10054:       case (int)VarCode::outputCoords: {
10055:          const Point2 coords = side->outputCoords();
10056:          double *out = (double *)((char *)res + idx_side * 16);
10057:          out[0] = coords.x;
10058:          out[1] = coords.y;
10059:          break;
10060:       }
10061:       case (int)VarCode::n1:
10062:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
10063:          break;
10064:       case (int)VarCode::n2:
10065:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
10066:          break;
10067:       case (int)VarCode::isdry:
10068:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
10069:          break;
10070:    }
10071: }
10072: 
10073: 
10074: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
10075:    ELEM(elem);
10076: 
10077:    switch (varCode) {
10078:       case (int)VarCode::outputCoords: {
10079:          const Point2 coords = elem->outputCoords();
10080:          double *out = (double *)((char *)res + idx_elem * 16);
10081:          out[0] = coords.x;
10082:          out[1] = coords.y;
10083:          break;
10084:       }
10085:       case (int)VarCode::FaceIndices: {
10086:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
10087:          for (int j = 0; j < 4; j++)
10088:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
10089:          break;
10090:       }
10091:       case (int)VarCode::isdry:
10092:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
10093:          break;
10094:       case (int)VarCode::w: {
10095:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
10096:          if (k >= 0)
10097:             out[0] = elem->w[k];
10098:          else
10099:             for (int lev = 0; lev < nvrt; lev++)
10100:                out[lev] = elem->w[lev];
10101:          break;
10102:       }
10103:    }
10104: }
