 2283:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2284:    // Project the vectors from the side frame to the element frame
 2285: 
 2286:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2287:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2288:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2289:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2290:       else          v[3] = Vector2();
 2291:    }
