 2060: __device__ __forceinline__ double Element::centerZ(void) const { 
 2061: // Z coordinate of the element center in the global cartesian coordinates.
 2062: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2063: 
 2064:    if constexpr(ics==1) { 
 2065:       return 0.0; 
 2066: 
 2067:    } else { 
 2068: 
 2069:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2070:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2071:    } 
 2072: }
