 2524: 
 2525: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2526:    // Returns the value of the normal component of the velocity at the side center
 2527:    const double w1 = getBoundaryArrayValueWeight();
 2528:    const double w2 = 1.0 - w1;
 2529:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2530:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2531: 
 2532:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2533: }
