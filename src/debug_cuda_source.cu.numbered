 2406: 
 2407: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2408: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2409: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2410: // Only when ics == 2, the origin is at the element center.
 2411: 
 2412:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2413: 
 2414:    const Node *node = nodes[idxNode];
 2415: 
 2416:    if constexpr(ics==1) {
 2417:       return node->p;
 2418: 
 2419:    } else {
 2420:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2421: 
 2422:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2423: 
 2424:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2425:    }
 2426: 
 2427: }
 2428: 
 2429: 
 2430: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2431: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2432: 
 2433:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2434: 
 2435:    const int id1 = idx;
 2436:    const int id2 = nxq(1 + id1);
 2437:    const int id3 = nxq(2 + id1);
 2438: 
 2439:    if constexpr(ics==1) {
 2440:       x0 = nodes[id1]->p;
 2441:       x1 = nodes[id2]->p;
 2442:       x2 = nodes[id3]->p;
 2443: 
 2444:    } else {
 2445:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2446: 
 2447:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2448:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2449:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2450: 
 2451:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2452:       x1 = toVector2(frame.G2L(p1 - c));
 2453:       x2 = toVector2(frame.G2L(p2 - c));
 2454: 
 2455:    }
 2456: 
 2457: }
 2458: 
 2459: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2460: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2461: 
 2462:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2463: 
 2464:    if constexpr(ics==1) {
 2465:       x0 = nodes[0]->p;
 2466:       x1 = nodes[1]->p;
 2467:       x2 = nodes[2]->p;  
 2468:       x3 = nodes[3]->p;
 2469: 
 2470:    } else {
 2471:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2472: 
 2473:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2474:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2475:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2476:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2477: 
 2478:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2479:       x1 = toVector2(frame.G2L(p1 - c));
 2480:       x2 = toVector2(frame.G2L(p2 - c));
 2481:       x3 = toVector2(frame.G2L(p3 - c));
 2482:    }
 2483: 
 2484: }
 2485: 
 2486: 
 2487: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2488: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2489: // Returns the normal vector and the area of the element at this level
 2490:    
 2491:    double nx, ny, nz;
 2492: 
 2493:    if (isTri()) {
 2494:       // For triangles...
 2495: 
 2496:       // Indices of the nodes at level k, taking care of not going below the bed
 2497:       const int k0 = max(k, nodes[0]->kb);
 2498:       const int k1 = max(k, nodes[1]->kb);
 2499:       const int k2 = max(k, nodes[2]->kb);
 2500: 
 2501:       // Gets the element frame coordinates of the nodes at level k
 2502:       Point3 x0, x1, x2;
 2503:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2504:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2505:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2506:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2507: 
 2508:       } else {  // ics == 2
 2509:          Point2 h0, h1, h2;
 2510: 
 2511:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2512: 
 2513:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2514:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2515:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2516:       }
 2517: 
 2518:       const Vector3 n20 = x2 - x0;
 2519:       const Vector3 n10 = x1 - x0; 
 2520: 
 2521:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2522:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2523:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2524:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2525:   
 2526:    }
 2527:    else {
 2528:       // For quads...
 2529:       Point2 h0, h1, h2, h3;
 2530: 
 2531:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2532: 
 2533:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2534:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2535:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2536:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2537: 
 2538:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2539:       nx = n20.y*n31.z - n20.z*n31.y;
 2540:       ny = n20.z*n31.x - n20.x*n31.z;
 2541:       nz = n20.x*n31.y - n20.y*n31.x;
 2542: 
 2543:    }
 2544: 
 2545:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2546:    area3D = 0.5*len;
 2547: 
 2548:    const double inv_len = 1.0/len;
 2549: 
 2550:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2551: 
 2552: }
 2553: 
 2554: /**
 2555:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2556:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2557:    If the segment is completely inside the element, then it returns true.
 2558: 
 2559:    This function assumes:
 2560:    - The initial point is on a side of the element. 
 2561:    - Its position is given by parameter t in the range [0,1].
 2562:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2563:       intersects the element (elements are convex).
 2564: 
 2565:    To find the intersection point, this function does the following:
 2566:    - it finds the intersection of the line segment with all the element side lines,
 2567:       except for the one that contains the initial point.
 2568:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2569:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2570:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2571:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2572:       track segment is almost parallel to the element side line.
 2573: 
 2574:    Inputs:
 2575:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2576:    @param x2, y2: other end of the line segment
 2577: 
 2578:    Outputs:
 2579:    @param side:  side that intersects the line segment (input and output)
 2580:    @param nextElement (output): element that contains the intersection point
 2581:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2582:    @param zint (input/output): Vertical coordinate of the intersection point
 2583: 
 2584:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2585:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2586:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2587: 
 2588:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2589:    (Delta) being zero.
 2590: 
 2591:    The intersection2 point happens when:
 2592:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2593:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2594:    
 2595:    Assumption: the 4 points (including those of the side segment) are different.
 2596:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2597:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2598:    If true, (xIntersect,yIntersect) is the intersection.				
 2599:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2600: **/
 2601: 
 2602: 
