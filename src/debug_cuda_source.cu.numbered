 4003:    __global__ void scaleGravity(double loadtide_coef) {
 4004: 
 4005: 
 4006:       NODE(node);
 4007: 
 4008:       // SAL option: scale gravity
 4009:       if constexpr(iloadtide==2) {  // simple const
 4010:          node->grav2 = grav*(1.0 - loadtide_coef);
 4011: 
 4012:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4013:         
 4014:           const double depth = max(node->depth, 0.0);
 4015:           const double tmp1 = sqrt(depth);
 4016:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4017:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4018:                              2.6969e-13*depth*depth*depth*tmp1;
 4019:           
 4020:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4021:           
 4022: 
 4023: 
 4024:           node->grav2 = grav*(1.0 - beta_bar);
 4025: 
 4026:       } else {  // iloadtide=0,1
 4027:         node->grav2=grav;
 4028: 
 4029:       }
 4030: 
 4031:    }
 4032: 
