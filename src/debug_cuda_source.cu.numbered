 2335: 
 2336: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2337: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2338: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2339: // Only when ics == 2, the origin is at the element center.
 2340: 
 2341:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2342: 
 2343:    const Node *node = nodes[idxNode];
 2344: 
 2345:    if constexpr(ics==1) {
 2346:       return node->p;
 2347: 
 2348:    } else {
 2349:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2350: 
 2351:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2352: 
 2353:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2354:    }
 2355: 
 2356: }
 2357: 
 2358: 
 2359: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2360: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2361: 
 2362:    const int id1 = idx;
 2363:    const int id2 = nxq(1 + id1);
 2364:    const int id3 = nxq(2 + id1);
 2365: 
 2366:    if constexpr(ics==1) {
 2367:       x0 = nodes[id1]->p;
 2368:       x1 = nodes[id2]->p;
 2369:       x2 = nodes[id3]->p;
 2370: 
 2371:    } else {
 2372:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2373: 
 2374:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2375:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2376:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2377: 
 2378:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2379:       x1 = toVector2(frame.G2L(p1 - c));
 2380:       x2 = toVector2(frame.G2L(p2 - c));
 2381: 
 2382:    }
 2383: 
 2384: }
 2385: 
 2386: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3, int idx) const {
 2387: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2388: 
 2389:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2390: 
 2391:    const int id1 = idx;
 2392:    const int id2 = nxq(1 + id1);
 2393:    const int id3 = nxq(2 + id1);
 2394:    const int id4 = nxq(3 + id1);
 2395: 
 2396:    if constexpr(ics==1) {
 2397:       x0 = nodes[id1]->p;
 2398:       x1 = nodes[id2]->p;
 2399:       x2 = nodes[id3]->p;  
 2400:       x3 = nodes[id4]->p;
 2401: 
 2402:    } else {
 2403:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2404: 
 2405:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2406:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2407:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2408:       const Point3 p3 = toPoint3(nodes[id4]->p, nodes[id4]->gz);
 2409: 
 2410:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2411:       x1 = toVector2(frame.G2L(p1 - c));
 2412:       x2 = toVector2(frame.G2L(p2 - c));
 2413:       x3 = toVector2(frame.G2L(p3 - c));
 2414:    }
 2415: 
 2416: }
 2417: 
 2418: 
 2419: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2420: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2421: // Returns the normal vector and the area of the element at this level
 2422:    
 2423:    double nx, ny, nz;
 2424: 
 2425:    if (isTri()) {
 2426:       // For triangles...
 2427: 
 2428:       // Indices of the nodes at level k, taking care of not going below the bed
 2429:       const int k0 = max(k, nodes[0]->kb);
 2430:       const int k1 = max(k, nodes[1]->kb);
 2431:       const int k2 = max(k, nodes[2]->kb);
 2432: 
 2433:       // Gets the element frame coordinates of the nodes at level k
 2434:       Point3 x0, x1, x2;
 2435:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2436:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2437:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2438:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2439: 
 2440:       } else {  // ics == 2
 2441:          Point2 h0, h1, h2;
 2442: 
 2443:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2444: 
 2445:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2446:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2447:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2448:       }
 2449: 
 2450:       const Vector3 n20 = x2 - x0;
 2451:       const Vector3 n10 = x1 - x0; 
 2452: 
 2453:       // Computes the cross product of vectors n20 and n10. 
 2454:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2455:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2456:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2457: 
 2458:   
 2459:    }
 2460:    else {
 2461:       // For quads...
 2462:       Point2 h0, h1, h2, h3;
 2463: 
 2464:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2465: 
 2466:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2467:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2468:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2469:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2470: 
 2471:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2472:       nx = n20.y*n31.z - n20.z*n31.y;
 2473:       ny = n20.z*n31.x - n20.x*n31.z;
 2474:       nz = n20.x*n31.y - n20.y*n31.x;
 2475: 
 2476:    }
 2477: 
 2478:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2479:    area3D = 0.5*len;
 2480: 
 2481:    const double inv_len = 1.0/len;
 2482: 
 2483:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2484: 
 2485: }
 2486: 
 2487: 
 2488: 
 2489: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2490:    // Check if the point (xt,yt) is inside the element.
 2491:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2492:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2493: 
 2494:    double shpCoords[4];
 2495:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2496: 
 2497:    return res;
 2498: }
 2499: 
 2500: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2501:    // Check if the point (xt,yt) is inside the element.
 2502:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2503:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2504:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2505: 
 2506:    double shpCoords[4];
 2507:    Vector2 tmp_xt = xt;
 2508:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2509: printf("HEREEEEEE\n");
 2510:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2511: 
 2512:    if (fixCoords && res) xt = tmp_xt;
 2513: 
 2514:    return res;
 2515: }
