 3493:    __global__ void scaleGravity(double loadtide_coef) {
 3494: 
 3495: 
 3496:       NODE(node);
 3497: 
 3498:       // SAL option: scale gravity
 3499:       if constexpr(iloadtide==2) {  // simple const
 3500:          node->grav2 = grav*(1.0 - loadtide_coef);
 3501: 
 3502:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3503:         
 3504:           const double depth = max(node->depth, 0.0);
 3505:           const double tmp1 = sqrt(depth);
 3506:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3507:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3508:                              2.6969e-13*depth*depth*depth*tmp1;
 3509:           
 3510:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3511:           
 3512: 
 3513: 
 3514:           node->grav2 = grav*(1.0 - beta_bar);
 3515: 
 3516:       } else {  // iloadtide=0,1
 3517:         node->grav2=grav;
 3518: 
 3519:       }
 3520: 
 3521:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3522:    }
