 2117: 
 2118: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2119:    if constexpr(ics == 1)  {
 2120:       return center;
 2121: 
 2122:    } else {
 2123:       const Point2 p0 = nodes[0]->outputCoords();
 2124:       const Point2 p1 = nodes[1]->outputCoords();
 2125:       const Point2 p2 = nodes[2]->outputCoords();
 2126: 
 2127:       if (isTri()) {
 2128:          return (1.0/3.0)*(p0 + p1 + p2);
 2129: 
 2130:       } else {
 2131:          const Point2 p3 = nodes[3]->outputCoords();
 2132:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2133:       }
 2134: 
 2135:    }
 2136: }
 2137: 
 2138: 
 2139: __device__ __forceinline__ double Element::centerZ(void) const { 
 2140: // Z coordinate of the element center in the global cartesian coordinates.
 2141: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2142: 
 2143:    if constexpr(ics==1) { 
 2144:       return 0.0; 
 2145: 
 2146:    } else { 
 2147: 
 2148:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2149:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2150:    } 
 2151: }
