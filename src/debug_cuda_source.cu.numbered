 2782: 
 2783: __device__ void Node::updateKb(void) {
 2784: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2785: 
 2786:    if constexpr(ivcor == 1) return;
 2787: 
 2788: 
 2789:    if (isDry2()) return;
 2790: 
 2791:    if constexpr(ivcor == 2) {  // SZ coordinates
 2792:       
 2793:       // Compute bottom level index
 2794:       if (depth <= mesh->h_s) {
 2795:          kb = izlev;
 2796:          
 2797:       } else {
 2798:          kb = -1;
 2799:          int L = 0;
 2800:          int R = nzlev; 
 2801:          
 2802:          while (L <= R) {
 2803:             int M = (R + L) / 2;
 2804: 
 2805: 
 2806:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2807:             
 2808:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2809:                R = M;
 2810:             } else {
 2811:                L = M;
 2812:             }
 2813: 
 2814:             if (R - L == 1) {
 2815:                kb = L;
 2816:                break;
 2817:             }
 2818:          }
 2819:       }
 2820:    } 
 2821: }
 2822: 
 2823: 
 2824: __device__ __inline__ void Node::updateZCoordData(void) {
 2825: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2826: 
 2827:    if (isDry2()) {
 2828:       kb = -1;
 2829:       return;
 2830:    }
 2831: 
 2832:    if constexpr(ivcor == 2) {  // SZ coordinates
 2833:       
 2834:       // Compute bottom level index
 2835:       if (depth <= mesh->h_s) {
 2836:             kb = izlev;
 2837: 
 2838:       } else {
 2839:          kb = -1;
 2840:          for (int i = 0; i < nzlev; i++) {
 2841:             // XXX Use binary search
 2842:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2843:                kb = i;
 2844:                break;
 2845:             }
 2846:          }
 2847:       }
 2848:    } 
 2849:    else if (ivcor == 1) {  // Localized sigma
 2850:       // Do nothing
 2851:    }
 2852: 
 2853: }
 2854: 
 2855: 
 2856: __device__ double Node::compZCoord(int k) const {
 2857:    // Computes the z coordinate at level k.
 2858:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2859:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2860:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2861:    // used 
 2862:    
 2863:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2864: 
 2865:    if (isDry2()) return 0.0;
 2866: 
 2867:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2868: 
 2869:    if constexpr(ivcor == 2) {
 2870: 
 2871:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2872:       const double h_c = mesh->h_c;
 2873:       const double theta_f = mesh->theta_f;
 2874:       const double sinh_theta_f = mesh->sinh_theta_f;
 2875: 
 2876:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2877:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2878:       // once per time step/node.
 2879:       // CHECK: updateZCoordData
 2880: 
 2881:       //  To simplify comparisons, I define index versions of count variables.
 2882:       if      (k == ivrt)           return eta2; 
 2883:       else if (k == izlev)          return -hmod2;
 2884:       else if (k == kb)             return -depth;
 2885:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2886:       else if (k > izlev) {
 2887:          const int ksig = k - izlev;
 2888: 
 2889:          if (hmod2 <= h_c) {
 2890: 
 2891:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2892:          } 
 2893:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2894:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2895:             assert(false && "ZCOOR: invalid h_c\n");
 2896:          } 
 2897:          else {
 2898:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2899:                          h_c * mesh->sigma[ksig] + 
 2900:                          (hmod2 - h_c) * mesh->cs[ksig];
 2901:          }
 2902:       } else { 
 2903:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2904:       }
 2905: 
 2906:    }
 2907:    else if constexpr(ivcor == 1) {
 2908:       if (k == kb) return -depth;
 2909:       else if (k == nvrt-1) return eta2;
 2910:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2911:    }
 2912:    
 2913:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2914:    return 0.0;
 2915: }
 2916: 
 2917: 
 2918: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2919:    // Computes the bottom drag Cd based on the selected nchi
 2920: 
 2921:    if constexpr(nchi == 0) {
 2922:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2923:       Cd = drag;  // Read from drag file
 2924: 
 2925:    } else if constexpr(nchi == 1) {
 2926:       // 
 2927: 
 2928:       bool ltmp = false; // for WBL iteration
 2929: 
 2930:       assert(false && "computeBottomDragVegetation: nchi == 1 not fully implemented. see below");
 2931:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2932:       // Drag at nodes
 2933: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 2934: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2935:            
 2936:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2937:       if (rough == 0.0) {
 2938:          Cd = 0.0;
 2939: 
 2940:       } else { //roughness >0 
 2941:          
 2942:          const double bthick_ori = z[kb + 1] - z[kb];  // thickness of bottom bnd layer
 2943:          const double bthick = max(dzb_min, bthick_ori);
 2944: 
 2945:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2946: 
 2947:          double tmp = 1.0/(2.5*log(bthick/rough));
 2948:          Cd = tmp*tmp;
 2949: 
 2950:       } // if rough
 2951: 
 2952: 
 2953:       // RECOVER THIS: XXX
 2954:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2955:       // Output warning for WBL if iteration didn't converge
 2956: 
 2957: 
 2958:    } else if constexpr(nchi == -1) {
 2959:    // Manning 
 2960:       Cd = 0.0;
 2961: 
 2962:       if (isDry) return;
 2963: 
 2964:       const double htot = max(hmin_man, htot2()); 
 2965:       Cd = grav2*rmanning*rmanning/pow(htot, 0.333);
 2966: 
 2967:    } else {
 2968:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2969:       
 2970:    } // if nchi
 2971: }
 2972: 
 2973: 
 2974: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2975:    // Checks if a side in on the boundary
 2976:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2977: 
 2978:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2979:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2980: 
 2981:    // Indices of the nodes that form the side
 2982:    const int n1 = side.n1->idx;
 2983:    const int n2 = side.n2->idx;
 2984:    isLand = false;
 2985:    
 2986: 
 2987:    // Check if the side is on a land boundary
 2988:    for (int i = 0; i < nland; i++) {
 2989:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2990:          // Consecutive nodes in the land boundary segment
 2991:          const int b1 = ilnd[i + j*nland];
 2992:          const int b2 = ilnd[i + (j + 1)*nland];
 2993: 
 2994:          assert(b1 != -1 && b2 != -1);
 2995: 
 2996:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2997:             
 2998:             isLand = true;
 2999:             return i;
 3000:          }
 3001:       }
 3002:    }
 3003: 
 3004:    // Check if the side is on an open boundary
 3005:    for (int i = 0; i < nope; i++) {
 3006:       for (int j = 0; j < nond[i] - 1; j++) {
 3007:          // Consecutive nodes in the open boundary segment
 3008:          const int b1 = iond[i + j*nope];
 3009:          const int b2 = iond[i + (j + 1)*nope];
 3010: 
 3011:          assert(b1 != -1 && b2 != -1);
 3012: 
 3013:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3014:             isLand = false;
 3015:             return i;
 3016:          }
 3017:       }
 3018:    }
 3019: 
 3020:    return -1;
 3021: }
 3022: 
 3023: 
 3024: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3025:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3026:                                     double *wind_rotate_angle, 
 3027:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3028:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3029:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3030:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3031:                                     double *drag, double *roughness, double *rmanning) {
 3032: 
 3033:    NODE(pnode);  
 3034:    const int i = idx_node;
 3035:    Node &node(*pnode);
 3036: 
 3037:    node.idx = i;
 3038: 
 3039:    const int idxNodeStart = nodeNeighNodesStart[i];
 3040:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3041:    node.numNodes = idxNodeEnd - idxNodeStart;
 3042:    node.nodes = nodeNeighNodes + idxNodeStart;
 3043:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3044: 
 3045: 
 3046: 
 3047:    const int idxElemStart = nodeNeighElemsStart[i];
 3048:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3049:    node.numElements = idxElemEnd - idxElemStart;
 3050:    node.elements = nodeNeighElems + idxElemStart;
 3051: 
 3052: 
 3053:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3054:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3055:       const int partNode = localNodePart[idxNodeGlobal]; 
 3056:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3057: 
 3058:       Node *node_ptr = nodes[partNode] + idxNode;
 3059:       
 3060:       nodeNeighNodes[idx] = node_ptr;
 3061:    }
 3062: 
 3063: 
 3064:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3065:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3066:       const int partElem = localElemPart[idxElemGlobal];
 3067:       const int idxElem  = localElemIndices[idxElemGlobal];
 3068: 
 3069:       Element *elem_ptr = elems[partElem] + idxElem;
 3070: 
 3071:       nodeNeighElems[idx] = elem_ptr;
 3072:    }      
 3073: 
 3074: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3075: 
 3076:    node.wind_angle = wind_rotate_angle[i];
 3077: 
 3078: 
 3079:    node.p.x   = node_coords[i * 3];
 3080:    node.p.y   = node_coords[i * 3 + 1];
 3081:    node.depth = node_coords[i * 3 + 2];
 3082: 
 3083:    if (use_ll) {
 3084:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3085:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3086:    }
 3087: 
 3088: 
 3089:    node.numSides = 0;
 3090: 
 3091:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3092:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3093:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3094:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3095:    else assert(false && "populateNodes: selected nchi not implemented.");
 3096:    
 3097:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3098: 
 3099:    
 3100:    // Links the node to the boundary information
 3101:    if (isbnd[i] >= 0) {
 3102: 
 3103:      
 3104:       // Get the index of the node boundary
 3105:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3106: 
 3107:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3108:       node.nodeBnd->node = &node;
 3109: 
 3110:       node.nodeBnd->sideBnd1 = nullptr;
 3111:       node.nodeBnd->sideBnd2 = nullptr;
 3112: 
 3113:       if (isbnd[i]>=0) {
 3114: 
 3115:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3116:          
 3117:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3118:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3119: 
 3120:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3121:          node.nodeBnd->segment->clen  = nan("1");
 3122:          node.nodeBnd->segment->carea = nan("1");
 3123: 
 3124:       }
 3125: //          else {  XXXXXX
 3126: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3127: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3128: //          }
 3129:       
 3130: 
 3131:    }
 3132:    else {
 3133: 
 3134:       node.nodeBnd = nullptr; // For internal nodes
 3135: 
 3136:       if (isbnd[i] == landSegment) {
 3137:          node.nodeBnd = &landBoundaryNode;
 3138:          node.nodeBnd->segment = &landBoundarySegment;
 3139:       }
 3140:       // node.nodeBnd->node = &node;
 3141:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3142:       // // node.nodeBnd = nullptr;
 3143:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3144:       
 3145:    }
 3146:    
 3147:    // XXXX GAUSSIAN HILL VELOCITIES
 3148: #ifdef GAUSSIAN_HILL_VELOCITIES
 3149:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3150:       constexpr double rot_per = 3000.0;
 3151:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3152:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3153:    // XXXXX
 3154: #endif
 3155: 
 3156: }
 3157: 
 3158: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3159:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3160:                                     double *wind_rotate_angle,   
 3161:                                     int *isdel, int *isidenode, int *isbnd,
 3162:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3163:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3164:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3165:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3166:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3167:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3168:                                     double *drag, double *roughness) {
 3169: 
 3170: 
 3171:    SIDE(pside);
 3172:    Side &side(*pside);
 3173:    const int i = idx_side;
 3174: 
 3175:    side.idx = i;  
 3176:    
 3177:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3178:    const double fc   = 2.0*omega_e*sin(sfea0);
 3179:    const double beta = 2.0*omega_e*cos(sfea0);
 3180: 
 3181:    // finding the pointer to the nodes that form the side
 3182:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3183:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3184: 
 3185:    const int locidx_n1 = localNodeIndices[idx_n1];
 3186:    const int locidx_n2 = localNodeIndices[idx_n2];
 3187:    const int part_n1 =   localNodePart[idx_n1];
 3188:    const int part_n2 =   localNodePart[idx_n2];
 3189: 
 3190:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3191:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3192: 
 3193:    // Counts the number of sides connected to each node
 3194:    side.n1->numSides++;
 3195:    side.n2->numSides++;
 3196: 
 3197:    // Normal, unitary vector to the side
 3198:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3199:    side.n = normalize(side.n);
 3200: 
 3201:    // Side boundary type
 3202:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3203:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3204: 
 3205:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3206:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3207:    {
 3208:       bool isLand = false;
 3209:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3210:       
 3211:       if (isbs > -1) {
 3212:          // assert(isLand || isbs>=0);
 3213:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3214: 
 3215:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3216: 
 3217:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3218:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3219: 
 3220:          assert (isLand == side.sideBnd->segment->isLand);
 3221: 
 3222:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3223:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3224:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3225: 
 3226:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3227:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3228:          
 3229:          side.sideBnd->side = &side;
 3230: 
 3231:       }
 3232:       else {
 3233:          side.sideBnd = nullptr;
 3234:       }
 3235:    }
 3236:    else 
 3237:    {
 3238:       side.sideBnd = nullptr;
 3239:    }
 3240: 
 3241: 
 3242:    // finding the pointer to the elements that share the side
 3243:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3244:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3245: 
 3246:    if (idx_e1 > -1) {
 3247:       const int locidx_e1 = localElemIndices[idx_e1];
 3248:       const int part_e1 =  localElemPart[idx_e1];
 3249:       side.elems[0] = elems[part_e1] + locidx_e1;
 3250: 
 3251:    }
 3252:    else {
 3253:       side.elems[0] = nullptr;
 3254:    }
 3255: 
 3256:    if (idx_e2 > -1) {
 3257:       const int locidx_e2 = localElemIndices[idx_e2];
 3258:       const int part_e2 =  localElemPart[idx_e2];
 3259:       side.elems[1] = elems[part_e2] + locidx_e2;
 3260:    }
 3261:    else {
 3262:       side.elems[1] = nullptr;
 3263:    }
 3264: 
 3265:    // Compute the center of the side
 3266:    side.center = 0.5*(side.n1->p + side.n2->p);
 3267: 
 3268:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3269:    side.shapiro = shapiro0;
 3270: 
 3271: #ifdef GAUSSIAN_HILL_VELOCITIES
 3272: // XXXX
 3273: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3274: constexpr double rot_per=3000.0;
 3275: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3276: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3277: // XXXXX      
 3278: #endif
 3279:    // Compute the z level at the center of the side
 3280:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3281:    
 3282:    // Compute the length of the side
 3283:    const Vector2 vLen = side.n2->p - side.n1->p;
 3284:    side.len = sqrt(dot(vLen, vLen));
 3285: 
 3286: 
 3287:    // Compute the Coriolis coefficient
 3288: 
 3289:    if constexpr(ncor == -1 || ncor == 0) {
 3290:       side.coriolis = coricoef;
 3291:    }
 3292:    else {
 3293:       const double sphi = side.lat();  // Latitude at the center of the side
 3294: 
 3295: // XXXXXX ERROR WHEN use_ll is false??????
 3296:       if constexpr(ics == 1) {
 3297:          // XXXXXXX
 3298:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3299:       }
 3300:       else {
 3301:          side.coriolis = 2.0*omega_e*sin(sphi);
 3302:       }
 3303: 
 3304:    }
 3305: }
 3306: 
 3307: 
 3308: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3309:    double *node_coords, double *node_coords_ll, bool use_ll,
 3310:    double *wind_rotate_angle,   
 3311:    int *isdel, int *isidenode, int *isbnd,
 3312:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3313:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3314:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3315:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3316:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3317:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3318:    double *drag, double *roughness) {
 3319: 
 3320:    ELEM(pelem);
 3321:    Element &elem(*pelem);
 3322:    const int i = idx_elem;
 3323: 
 3324:    elem.idx = i;
 3325: 
 3326:    for (int j = 0; j < i34[i]; j++) {
 3327:       const int idxNode = elnode[i*4 + j];  
 3328:       const int idxSide = elside[i*4 + j];
 3329:       
 3330:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3331:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3332: 
 3333:       // Find the neighboring element  
 3334:       if (elem.sides[j]->elems[0] == &elem) {
 3335:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3336:       }
 3337:       else {
 3338:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3339:       }
 3340:       
 3341:    }
 3342: 
 3343:    elem.i34 = i34[i];
 3344: 
 3345:    // Compute the centroid of the element and its depth
 3346:    Vector2 center = {0.0, 0.0};
 3347:    elem.depth = 0.0;
 3348:    for (int j = 0; j < i34[i]; j++) {
 3349: 
 3350: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3351: 
 3352: 
 3353:       center += elem.nodes[j]->p/i34[i];
 3354:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3355:    }
 3356:    elem.center = center;
 3357: 
 3358:    
 3359:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3360:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3361: 
 3362:    elem.area = elem.computeSignedArea(); 
 3363:    elem.radius = sqrt(elem.area)/pi; 
 3364:    
 3365:    // Determines which way the normal vector to each side is oriented.
 3366:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3367:    for (int j = 0; j < i34[i]; j++)  
 3368:    {
 3369:       if (elem.sides[j]->elems[0] == &elem) {
 3370:          elem.ssign[j] =  1.0;
 3371:       }
 3372:       else {
 3373:          elem.ssign[j] = -1.0;
 3374:       }
 3375: 
 3376:    }
 3377: 
 3378:    // Derivatives of shape functions
 3379:    //  For ics=2, this is done inside element/ll frame XXX
 3380:    //  For quads, the derivative is evaluated at centroid
 3381:    for (int j = 0; j < elem.i34; j++) {
 3382:       const double area = elem.area;
 3383:       const int id2 = elem.nxq(1 + j);
 3384:       const int id3 = elem.nxq(2 + j);
 3385:       const int id4 = elem.nxq(3 + j);
 3386:       if (elem.isTri()) {
 3387:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3388:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3389:          // da1/dx = (y1 - y2)/(2*area)
 3390:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3391:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3392:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3393:       }
 3394:       else  { // Quad; evaluate at centroid
 3395:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3396:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3397:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3398:       } // if Tri
 3399: 
 3400:    } // for j   
 3401:    
 3402:    
 3403: 
 3404: }
 3405: 
 3406: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3407:                                             double *emo, double *efa, 
 3408:                                             double *umo, double *ufa, 
 3409:                                             double *vmo, double *vfa) {
 3410: 
 3411: 
 3412:    NODE_BND(nodeBnd);
 3413:    const int idx = idx_node_bnd;    
 3414: 
 3415:    nodeBnd->idx = idx;
 3416: 
 3417:    // Need to find the segment index and the index of the node on the segment
 3418:    int idxNode = -1;
 3419:    int iseg, i;
 3420:    for (iseg = 0; iseg < nope; iseg++) {
 3421:       // for each segment...
 3422:       for (i = 0; i < nond[iseg]; i++) {
 3423:          idxNode = iond[iseg + i*nope];
 3424:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3425:          
 3426:       }
 3427:    }
 3428: 
 3429:    assert(iseg < nope && "iseg is out of bounds");
 3430: 
 3431: found: // Jumped here when the node was found
 3432: 
 3433:    nodeBnd->isEssentialBC = true;
 3434:    nodeBnd->elbc = 0.0;
 3435: 
 3436:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3437: 
 3438:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3439:       nodeBnd->efa[jfr] = efa[idx2];
 3440:       nodeBnd->emo[jfr] = emo[idx2];
 3441:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3442:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3443: 
 3444:    }
 3445:         
 3446: 
 3447: }
 3448: 
 3449: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3450:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3451:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3452:                 int *isdel, int *isidenode, int *isbnd,
 3453:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3454:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3455:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3456:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3457:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3458:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3459:                 double *drag, double *roughness,
 3460:                 double *emo, double *efa, 
 3461:                 double *umo, double *ufa, 
 3462:                 double *vmo, double *vfa) {
 3463: 
 3464:    // printf("Populating mesh for partition %d\n", partNum);
 3465: 
 3466:    // XXXXXX THIS function does almost nothing. 
 3467: 
 3468:    nbs = *sharedIdxSideBoundary + 1;
 3469:    nbp = *sharedIdxNodeBoundary + 1;
 3470: 
 3471:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3472: 
 3473: }
 3474: 
 3475: 
 3476: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3477:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3478:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3479: 
 3480: 
 3481:    NODE(node1);
 3482: 
 3483:    
 3484:    node1->clearMatrixRow();
 3485:    node1->qel = 0.0;
 3486: 
 3487:    // THIS IS FOR STRUCTURES XXX
 3488:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3489: 
 3490:    
 3491:    for (int j=0; j<node1->numElements; j++) {
 3492:       // For each element connected to the node...
 3493: 
 3494:       Element *elem = node1->elements[j];
 3495: 
 3496: 
 3497:       // Compute the average gravity
 3498:       const double grav3 = elem->mean(&Node::grav2);
 3499: 
 3500:       // Look at the documentation for the description of the terms in the following integrals
 3501: 
 3502:       // Integral I_1 
 3503:       // \bar{\breve{H}} 
 3504:       const double hhatb = elem->mean(&Side::hhat);        
 3505: 
 3506:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3507: 
 3508:       const int id1 = elem->nodeLocalIdx(node1); 
 3509:       const double area = elem->area;
 3510: 
 3511:       if (elem->isTri()) {
 3512: 
 3513:          // To clarify the notation in this section: 
 3514:          //   i stands for the node under consideration (node1)
 3515:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3516:          const int id2 = elem->nxq(1 + id1);
 3517:          const int id3 = elem->nxq(2 + id1);
 3518:          Node *node2 = elem->nodes[id2];
 3519:          Node *node3 = elem->nodes[id3];
 3520: 
 3521:          const Point2 x1 = node1->p;
 3522:          const Point2 x2 = node2->p;
 3523:          const Point2 x3 = node3->p;
 3524: 
 3525:          // integral of phi_i*phi_j
 3526:          const double ipp_ii = (1.0/6.0 )*area;
 3527:          const double ipp_ij = (1.0/12.0)*area;
 3528:          const double ipp_ik = (1.0/12.0)*area;
 3529: 
 3530:          // integral of [(grad phi_i) * (grad phi_j)]
 3531:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3532:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3533:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3534: 
 3535:          // Computes the different components of integral I_1 of each node with respect to node i.
 3536:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3537:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3538:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3539: 
 3540:          node1->addToSparseMatrix(node1, I1_ii);
 3541:          node1->addToSparseMatrix(node2, I1_ij); 
 3542:          node1->addToSparseMatrix(node3, I1_ik);
 3543: 
 3544:       }
 3545:       else { // Quad
 3546:          // XXX IMPLEMENT THIS
 3547:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3548: 
 3549:          // To clarify the notation in this section: 
 3550:          //   i stands for the node under consideration (node1)
 3551:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3552:          const int id2 = elem->nxq(1 + id1);
 3553:          const int id3 = elem->nxq(2 + id1);
 3554:          const int id4 = elem->nxq(3 + id1);
 3555:          Node *node2 = elem->nodes[id2];
 3556:          Node *node3 = elem->nodes[id3];
 3557:          Node *node4 = elem->nodes[id4];         
 3558: 
 3559:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3560:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3561:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3562:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3563:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3564: 
 3565:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3566:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3567:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3568:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3569:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3570: 
 3571:          // Computes the different components of integral I_1 of each node with respect to node i.
 3572:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3573:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3574:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3575:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3576: 
 3577:          node1->addToSparseMatrix(node1, I1_ii);
 3578:          node1->addToSparseMatrix(node2, I1_ij); 
 3579:          node1->addToSparseMatrix(node3, I1_ik);
 3580:          node1->addToSparseMatrix(node4, I1_il);
 3581:   
 3582: 
 3583: 
 3584:       
 3585:       } 
 3586: 
 3587:  
 3588:       // Integral I_4
 3589:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3590:       // Where
 3591:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3592: 
 3593:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3594:       // of U over the element.
 3595:       Vector2 Umean = {0.0, 0.0};
 3596:       for (int m=0; m<elem->i34; m++) {      
 3597:          const Side *side = elem->sides[m];
 3598: 
 3599:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3600:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3601:       }
 3602:       Umean = Umean/elem->i34;
 3603: 
 3604:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3605: 
 3606:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3607:       const double I_4_1 = dot(gradPhi_1, Umean);
 3608: 
 3609:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3610:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3611:      
 3612:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3613: 
 3614:       // Additional terms 
 3615:       double vnorm = 0.0;
 3616:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3617:          Vector3 ubed;
 3618:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3619: 
 3620:          Vector3 gradP = {0.0, 0.0, 1.0};
 3621:          for (int m=0; m < elem->i34; m++) {
 3622:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3623:            gradP += toVector3(gradP_2D, 0.0);
 3624:          }   
 3625:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3626:       } // imm==2
 3627: 
 3628:       if (elem->isTri()) {
 3629:          for (int l=0; l<3; l++) {
 3630:             double fac;
 3631: 
 3632:             Node *node = elem->nodes[l];
 3633: 
 3634:             fac = (node == node1) ? 2.0 : 1.0;
 3635:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3636:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3637:            
 3638:          }
 3639: 
 3640: 
 3641:          if (!elem->isDry) {
 3642:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3643: 
 3644:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3645: 
 3646:          }
 3647: 
 3648:       } // isTri
 3649:       else { // isQuad
 3650:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3651:          // for (int l=0; l<4; l++) {
 3652:          //   const Node *node = elem->nodes[l];
 3653: 
 3654:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3655:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3656: 
 3657:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3658:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3659:          // }
 3660: 
 3661:       } // isQuad
 3662: 
 3663: 
 3664:      node1->qel += (dt/elem->i34)*elem->vsource;
 3665:       
 3666: 
 3667:    } // for all elements connected to the node
 3668:    
 3669: 
 3670:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3671:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3672:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3673:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3674:       // If it is an open boundary node...
 3675: 
 3676:       // At least one open bnd side, maybe two
 3677:       for (int l=0; l<2; l++) { 
 3678: 
 3679:          // Gets each of the sides sharing the node. 
 3680:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3681: 
 3682:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3683:          
 3684: 
 3685:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3686:          if (sideBnd != nullptr) {
 3687:             // If the side is on a boundary...
 3688: 
 3689:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3690: 
 3691:             // Get the boundary segment
 3692:             const BoundarySegment *sideSegment = sideBnd->segment;
 3693:             const Side *side = sideBnd->side;
 3694: 
 3695:             // Integral I_3
 3696:             if (sideSegment->ifltype != 0) {
 3697:             // Natural or Flather b.c.
 3698: 
 3699:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3700:                // especially for Flather b.c.
 3701:                double ri3 = 0.0;
 3702:                if (!side->isDry) {
 3703:                   // If the side is not dry
 3704:                   
 3705:                   // Computes the side flux of (uth, vth)
 3706:                   double Vn = 0.0;
 3707:                   for (int k = side->kb; k<nvrt-1; k++) {
 3708:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3709:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3710: 
 3711:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3712:                   }
 3713: 
 3714:                   ri3 = 0.5*side->len*Vn;
 3715:                }
 3716: 
 3717:                if (sideSegment->ifltype == -1) { // Flather 1
 3718: 
 3719:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3720:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3721: 
 3722:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3723:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3724:                   
 3725:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3726:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3727: 
 3728:                } 
 3729:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3730:                   // Reset ri3
 3731:                   ri3 = 0.0;
 3732: 
 3733:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3734: 
 3735:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3736: 
 3737:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3738:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3739: 
 3740:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3741:                   node1->addToSparseMatrix(node1, con0*2.0);
 3742:                   node1->addToSparseMatrix(node2, con0);
 3743: 
 3744:                } // if Flather or Discharge
 3745: 
 3746: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3747:                node1->qel -= thetai*dt*ri3;
 3748: 
 3749: 
 3750:             } // I_3
 3751:           
 3752: 
 3753:             // Integral I_5
 3754:             if(!side->isDry) {
 3755: 
 3756:                const double Unbar = dot(side->U, side->n);
 3757:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3758: 
 3759:             } // I_5
 3760: 
 3761:          } // if is boundary side
 3762: 
 3763:       } // for l
 3764: 
 3765:    } // if isbnd
 3766: 
 3767: 
 3768: }
 3769: 
 3770: 
 3771: 
 3772: extern "C" {
 3773:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3774:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3775:                                   int* indices, int* indptr) {
 3776: 
 3777:       NODE(node);
 3778:       
 3779:       const int idx = node->idx;
 3780:       
 3781:       // Computes the index in the nzz array      
 3782:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3783: 
 3784: 
 3785:       indptr[idx] = nzzIdx;
 3786:       indices[nzzIdx] = idx;
 3787: 
 3788:       data_d[nzzIdx]    = node->coeffDiag;
 3789:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3790: 
 3791:       diag_d[idx] = 1.0/node->coeffDiag;
 3792:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3793: 
 3794:       b_d[idx] = node->qel;
 3795:       b_f[idx] = (float)node->qel;
 3796: 
 3797:       for (int k = 0; k < node->numNodes; ++k) {
 3798:          const Node* nb = node->nodes[k];
 3799: 
 3800:          const int j = nb->idx;
 3801: 
 3802:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3803:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3804: 
 3805:          indices[nzzIdx + k + 1] = j;
 3806:       }
 3807: 
 3808: 
 3809:    }
 3810: }
