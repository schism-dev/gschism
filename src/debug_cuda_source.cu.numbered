 5452:    __global__ void resetBoundaryAreas(void) {
 5453:       // Reset boundary areas and lengths for each segment.
 5454: 
 5455:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5456:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5457:       SIDE_BND(sideBnd);
 5458: 
 5459:       BoundarySegment *segment = sideBnd->segment;
 5460: 
 5461:       segment->carea = 0.0;
 5462:       segment->clen = 0.0;
 5463:  
 5464:    }
 5465: 
 5466:    __global__ void computeBoundaryAreas(void) {
 5467:    // Calculation of cross-section areas and lengths for flow b.c.
 5468: 
 5469:       SIDE_BND(sideBnd);
 5470: 
 5471:       const Side *side = sideBnd->side;
 5472:       BoundarySegment *segment = sideBnd->segment;
 5473: 
 5474:       if (segment->ifltype != 0) {
 5475: 
 5476:          const Node *n1 = side->n1;
 5477:          const Node *n2 = side->n2;
 5478: 
 5479:          const double htot = side->htot2();
 5480: 
 5481:          if (!side->isDry) {
 5482:             atomicAdd(&segment->carea, htot*side->len);
 5483:             atomicAdd(&segment->clen, side->len);
 5484:          }
 5485:       }
 5486: 
 5487:    }
 5488: 
 5489: 
 5490:    __global__ void computeFlowBcVelocities(double time) {
 5491: 
 5492:       SIDE_BND(sideBnd);
 5493: 
 5494:       const Side *side = sideBnd->side;
 5495:  
 5496:       const bool isDry = side->isDry;
 5497:       const bool isLand = sideBnd->segment->isLand;
 5498: 
 5499:    
 5500:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5501: 
 5502:       if (isDry || isLand) return;
 5503: 
 5504:       // For wet sides in open boundaries...
 5505:       const Vector2 n = side->n;
 5506:       const BoundarySegment *segment = sideBnd->segment;
 5507: 
 5508:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5509: 
 5510:       const int ifltype = segment->ifltype;
 5511: 
 5512:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5513:       const Vector2 r_nuth0 = r_uth0*n;
 5514: 
 5515: 
 5516:       if (ifltype == 1 || ifltype == 2) {
 5517:       
 5518:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5519: 
 5520:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5521:          
 5522:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5523:          
 5524:       } else if (ifltype == -1) { // Flather 1
 5525: 
 5526:          for (int k = 0; k < nvrt; k++) {
 5527: 
 5528:             // uth is the normal vel.; no ramp up
 5529:             const double uth = sideBnd->nuth(k);
 5530:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5531: 
 5532:             sideBnd->ubc[k] += uth*n;
 5533:          }
 5534: 
 5535:       } else if (ifltype == 3 || ifltype == 5) {
 5536:          // vnth0=0 !normal vel.
 5537: 
 5538:          Vector2 r_u1_bar = {0.0, 0.0};
 5539:          // Computes the contribution to the velocity from all tide frequencies
 5540:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5541: 
 5542:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5543:             const Vector2 umo  = sideBnd->umo(jfr); 
 5544: 
 5545:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5546:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5547:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5548:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5549: 
 5550:          }
 5551: 
 5552: 
 5553:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5554: 
 5555:       } // if (ifltype = 3 || ifltype == 5
 5556: 
 5557: 
 5558: 
 5559:    }
 5560: 
 5561:    __global__ void computeElevationBoundaryConditions(double time) {
 5562:       // Compute elevation essential boundary conditions 
 5563: 
 5564:       NODE_BND(nodeBnd); // Each boundary node.
 5565: 
 5566:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5567: 
 5568:       const Node *node = nodeBnd->node;
 5569:       const BoundarySegment *segment = nodeBnd->segment;
 5570:       const int iettype = segment->iettype;
 5571:       
 5572: 
 5573:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5574:       double eic = 0.0;
 5575:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5576:       else                 eic = 0.0;
 5577: 
 5578:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5579:       const double r_eth = ramp*nodeBnd->eth;
 5580:       double r_eta1_bar = 0.0;
 5581: 
 5582: 
 5583:       // Compute tide elevation
 5584:       if (iettype == 3 || iettype == 5) {   
 5585: 
 5586:          if constexpr(iloadtide==1) { // loading tide
 5587:             assert(false && "Loading tide not implemented");
 5588:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5589:          }
 5590:          
 5591:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5592: 
 5593:             const double efa  = nodeBnd->efa[jfr]; 
 5594:             const double emo  = nodeBnd->emo[jfr]; 
 5595: 
 5596:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5597:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5598:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5599: 
 5600:          } // for jfr
 5601: 
 5602:       } // if iettype
 5603: 
 5604:       switch (iettype) {
 5605:          case 1:
 5606:          case 2:
 5607:          case 4:
 5608:             nodeBnd->elbc = r_eic + r_eth;
 5609:             break;
 5610:          case 3:
 5611:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5612:             break;
 5613:          case 5:
 5614:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5615:             break;
 5616:       } // switch
 5617: 
 5618: 
 5619:       //Add inverse barometric effects
 5620:       if (iettype != 0 && inv_atm_bnd == 1) {
 5621:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5622:       }
 5623: 
 5624:    }
 5625: 
 5626: 
 5627:    __global__ void computeHorizontalViscosity(void) { 
 5628: 
 5629:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5630: 
 5631:       SIDE(side);
 5632: 
 5633:       if (side->isDry) return;
 5634: 
 5635:       for (int k = 0; k < nvrt; k++) {
 5636:          side->nuGradU[k] = {0.0, 0.0};
 5637:       }
 5638: 
 5639:       if constexpr(ihorcon == 1) {
 5640:          for (int k = side->kb; k < nvrt - 1; k++) {
 5641:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5642:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5643:             // By Zhang and Baptista.
 5644: 
 5645:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5646:             // This is a standard discretization of the Laplacian operator.
 5647:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5648:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5649:             // Gamma is hvis_coef0 in the code.
 5650:             // The value of gamma needs to be < 0.5.
 5651: 
 5652:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5653:             // side under consideration in each of the two possible elements that share the side.
 5654:             Vector2 sumU = {0.0, 0.0};
 5655:             for (int l = 0; l < 2; l++) {
 5656:                const Element *elem = side->elems[l];
 5657: 
 5658:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5659: 
 5660:                // Find the local index of the side in the element
 5661:                const int idxSide = elem->sideLocalIdx(side);
 5662: 
 5663:                // Find the two sides that are connected to the side under consideration
 5664:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5665:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5666: 
 5667:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5668: 
 5669:             }
 5670: 
 5671:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5672: 
 5673:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5674:    
 5675:          }
 5676:       }
 5677:       else if constexpr(ihorcon == 2) {
 5678:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5679:       }
 5680: 
 5681: 
 5682:    }
 5683: 
 5684: 
 5685:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5686:       // Set essential boundary conditions 
 5687:       NODE(node); // Each boundary node
 5688:       NodeBoundary *nodeBnd = node->nodeBnd;
 5689:       
 5690:  
 5691:       // Check if this node has essential BC
 5692:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5693:          // Verify BC value is valid
 5694:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5695: 
 5696:        
 5697:          // Set diagonal to 1 and zero off-diagonals
 5698:          node->coeffDiag = 1.0;
 5699: 
 5700:          for (int j = 0; j < node->numNodes; j++) {
 5701:                node->coeffMatrix[j] = 0.0;
 5702:          }
 5703:          
 5704:          // Set solution and RHS to BC value
 5705:          node->mX  = nodeBnd->elbc;
 5706:          node->qel = nodeBnd->elbc;
 5707: 
 5708:       } else {
 5709:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5710: 
 5711:          for (int j = 0; j < node->numNodes; j++) {
 5712:                Node* nbNode = node->nodes[j];
 5713:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5714:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5715:                   // Verify neighbor's BC value
 5716:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5717: 
 5718:                   // Subtract contribution to RHS
 5719:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5720:                   node->coeffMatrix[j] = 0.0;  
 5721:                }
 5722:          }
 5723:       }
 5724:    }
 5725: 
 5726: 
 5727:    __global__ void updateElevation(void) {
 5728:       NODE(node);
 5729: 
 5730: 
 5731:       node->eta2 = node->mX;
 5732: 
 5733:       node->updateZCoordData();
 5734:    }
