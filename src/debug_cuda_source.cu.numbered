 5464:    __global__ void resetBoundaryAreas(void) {
 5465:       // Reset boundary areas and lengths for each segment.
 5466: 
 5467:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5468:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5469:       SIDE_BND(sideBnd);
 5470: 
 5471:       BoundarySegment *segment = sideBnd->segment;
 5472: 
 5473:       segment->carea = 0.0;
 5474:       segment->clen = 0.0;
 5475:  
 5476:    }
 5477: 
 5478:    __global__ void computeBoundaryAreas(void) {
 5479:    // Calculation of cross-section areas and lengths for flow b.c.
 5480: 
 5481:       SIDE_BND(sideBnd);
 5482: 
 5483:       const Side *side = sideBnd->side;
 5484:       BoundarySegment *segment = sideBnd->segment;
 5485: 
 5486:       if (segment->ifltype != 0) {
 5487: 
 5488:          const Node *n1 = side->n1;
 5489:          const Node *n2 = side->n2;
 5490: 
 5491:          const double htot = side->htot2();
 5492: 
 5493:          if (!side->isDry) {
 5494:             atomicAdd(&segment->carea, htot*side->len);
 5495:             atomicAdd(&segment->clen, side->len);
 5496:          }
 5497:       }
 5498: 
 5499:    }
 5500: 
 5501: 
 5502:    __global__ void computeFlowBcVelocities(double time) {
 5503: 
 5504:       SIDE_BND(sideBnd);
 5505: 
 5506:       const Side *side = sideBnd->side;
 5507:  
 5508:       const bool isDry = side->isDry;
 5509:       const bool isLand = sideBnd->segment->isLand;
 5510: 
 5511:    
 5512:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5513: 
 5514:       if (isDry || isLand) return;
 5515: 
 5516:       // For wet sides in open boundaries...
 5517:       const Vector2 n = side->n;
 5518:       const BoundarySegment *segment = sideBnd->segment;
 5519: 
 5520:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5521: 
 5522:       const int ifltype = segment->ifltype;
 5523: 
 5524:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5525:       const Vector2 r_nuth0 = r_uth0*n;
 5526: 
 5527: 
 5528:       if (ifltype == 1 || ifltype == 2) {
 5529:       
 5530:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5531: 
 5532:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5533:          
 5534:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5535:          
 5536:       } else if (ifltype == -1) { // Flather 1
 5537: 
 5538:          for (int k = 0; k < nvrt; k++) {
 5539: 
 5540:             // uth is the normal vel.; no ramp up
 5541:             const double uth = sideBnd->nuth(k);
 5542:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5543: 
 5544:             sideBnd->ubc[k] += uth*n;
 5545:          }
 5546: 
 5547:       } else if (ifltype == 3 || ifltype == 5) {
 5548:          // vnth0=0 !normal vel.
 5549: 
 5550:          Vector2 r_u1_bar = {0.0, 0.0};
 5551:          // Computes the contribution to the velocity from all tide frequencies
 5552:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5553: 
 5554:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5555:             const Vector2 umo  = sideBnd->umo(jfr); 
 5556: 
 5557:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5558:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5559:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5560:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5561: 
 5562:          }
 5563: 
 5564: 
 5565:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5566: 
 5567:       } // if (ifltype = 3 || ifltype == 5
 5568: 
 5569: 
 5570: 
 5571:    }
 5572: 
 5573:    __global__ void computeElevationBoundaryConditions(double time) {
 5574:       // Compute elevation essential boundary conditions 
 5575: 
 5576:       NODE_BND(nodeBnd); // Each boundary node.
 5577: 
 5578:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5579: 
 5580:       const Node *node = nodeBnd->node;
 5581:       const BoundarySegment *segment = nodeBnd->segment;
 5582:       const int iettype = segment->iettype;
 5583:       
 5584: 
 5585:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5586:       double eic = 0.0;
 5587:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5588:       else                 eic = 0.0;
 5589: 
 5590:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5591:       const double r_eth = ramp*nodeBnd->eth;
 5592:       double r_eta1_bar = 0.0;
 5593: 
 5594:       // Compute tide elevation
 5595:       if (iettype == 3 || iettype == 5) {   
 5596: 
 5597:          if constexpr(iloadtide==1) { // loading tide
 5598:             assert(false && "Loading tide not implemented");
 5599:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5600:          }
 5601:          
 5602:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5603: 
 5604:             const double efa  = nodeBnd->efa[jfr]; 
 5605:             const double emo  = nodeBnd->emo[jfr]; 
 5606: 
 5607:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5608:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5609:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5610: 
 5611: 
 5612:          } // for jfr
 5613: 
 5614:       } // if iettype
 5615: 
 5616:       switch (iettype) {
 5617:          case 1:
 5618:          case 2:
 5619:          case 4:
 5620:             nodeBnd->elbc = r_eic + r_eth;
 5621:             break;
 5622:          case 3:
 5623:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5624:             break;
 5625:          case 5:
 5626:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5627:             break;
 5628:       } // switch
 5629: 
 5630: 
 5631:       //Add inverse barometric effects
 5632:       if (iettype != 0 && inv_atm_bnd == 1) {
 5633:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5634:       }
 5635: 
 5636:    }
 5637: 
 5638: 
 5639:    __global__ void computeHorizontalViscosity(void) { 
 5640: 
 5641:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5642: 
 5643:       SIDE(side);
 5644: 
 5645:       if (side->isDry) return;
 5646: 
 5647:       for (int k = 0; k < nvrt; k++) {
 5648:          side->nuGradU[k] = {0.0, 0.0};
 5649:       }
 5650: 
 5651:       if constexpr(ihorcon == 1) {
 5652:          for (int k = side->kb; k < nvrt - 1; k++) {
 5653:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5654:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5655:             // By Zhang and Baptista.
 5656: 
 5657:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5658:             // This is a standard discretization of the Laplacian operator.
 5659:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5660:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5661:             // Gamma is hvis_coef0 in the code.
 5662:             // The value of gamma needs to be < 0.5.
 5663: 
 5664:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5665:             // side under consideration in each of the two possible elements that share the side.
 5666:             Vector2 sumU = {0.0, 0.0};
 5667:             for (int l = 0; l < 2; l++) {
 5668:                const Element *elem = side->elems[l];
 5669: 
 5670:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5671: 
 5672:                // Find the local index of the side in the element
 5673:                const int idxSide = elem->sideLocalIdx(side);
 5674: 
 5675:                // Find the two sides that are connected to the side under consideration
 5676:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5677:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5678: 
 5679:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5680: 
 5681:             }
 5682: 
 5683:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5684: 
 5685:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5686:    
 5687:          }
 5688:       }
 5689:       else if constexpr(ihorcon == 2) {
 5690:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5691:       }
 5692: 
 5693: 
 5694:    }
 5695: 
 5696: 
 5697:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5698: 
 5699:       // Set essential boundary conditions 
 5700:       NODE(node); // Each boundary node
 5701:       NodeBoundary *nodeBnd = node->nodeBnd;
 5702:       
 5703:  
 5704:       // Check if this node has essential BC
 5705:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5706: 
 5707:          // Verify BC value is valid
 5708:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5709: 
 5710:        
 5711:          // Set diagonal to 1 and zero off-diagonals
 5712:          for (int j = 0; j <= node->numNodes; j++) {
 5713:                node->coeffRow[j] = 0.0;
 5714:          }
 5715: 
 5716:          *(node->coeffDiag) = 1.0;
 5717: 
 5718: 
 5719:          // Set solution and RHS to BC value
 5720:          node->mX  = nodeBnd->elbc;
 5721:          node->qel = nodeBnd->elbc;
 5722: 
 5723:       } else {
 5724:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5725: 
 5726:          for (int j = 0; j < node->numNodes; j++) {
 5727:                const Node* nbNode = node->nodes[j];
 5728:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 5729: 
 5730:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5731:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 5732: 
 5733:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5734:                   // Verify neighbor's BC value
 5735:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5736: 
 5737:                   // Subtract contribution to RHS
 5738:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 5739:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 5740:                }
 5741:          }
 5742: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 5743:       }
 5744:    }
 5745: 
