 3487:       Side &side = localSideData[i];
 3488:       side.idx = i;
 3489:       // finding the pointer to the nodes that form the side
 3490:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3491:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3492: 
 3493:       const int locidx_n1 = localNodeIndices[idx_n1];
 3494:       const int locidx_n2 = localNodeIndices[idx_n2];
 3495:       const int part_n1 =   localNodePart[idx_n1];
 3496:       const int part_n2 =   localNodePart[idx_n2];
 3497: 
 3498:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3499:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3500: 
 3501:       // Counts the number of sides connected to each node
 3502:       side.n1->numSides++;
 3503:       side.n2->numSides++;
 3504: 
 3505:       // Normal, unitary vector to the side
 3506:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3507:       side.n = normalize(side.n);
 3508: 
 3509:       // Side boundary type
 3510:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 3511:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 3512: 
 3513:       if (n1bnd != nullptr && n2bnd != nullptr) 
 3514:       // If both nodes are on the boundary, then the side may be on the boundary
 3515:       {
 3516:          bool isLand = false;
 3517:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3518: 
 3519:          if (isbs > -1) {
 3520:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3521:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 3522:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 3523: 
 3524:             // Links each node boundary to the side boundary using the first available side boundary pointer
 3525:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3526:             else                            n1bnd->sideBnd2 = side.sideBnd;
 3527: 
 3528:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3529:             else                            n2bnd->sideBnd2 = side.sideBnd;
 3530:           
 3531:             side.sideBnd->side = &side;
 3532:             idxSideBoundary++;
 3533: 
 3534:          }
 3535:          
 3536: 
 3537:       // }
 3538:       // 
 3539: 
 3540: 
 3541: 
 3542: 
 3543: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 3544: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 3545: //       if (n1bnd != nullptr || n2bnd != nullptr) 
