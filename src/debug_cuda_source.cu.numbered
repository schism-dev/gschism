 7452: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7453:    Element *elems = mesh->localElemData;
 7454: 
 7455:    *addr = elems;
 7456:    *sizeElement = sizeof(Element);
 7457:    switch (varCode) {
 7458:       case (int)VarCode::z:
 7459:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7460:          *sizeType = sizeof(double);
 7461:          break;
 7462:       case (int)VarCode::x:
 7463:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7464:          *sizeType = sizeof(Vector2);
 7465:          break;
 7466:       case (int)VarCode::area:
 7467:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7468:          *sizeType = sizeof(double);
 7469:          break;
 7470:       case (int)VarCode::depth:
 7471:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7472:          *sizeType = sizeof(double);
 7473:          break;
 7474:       case (int)VarCode::radius:
 7475:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7476:          *sizeType = sizeof(double);
 7477:          break;
 7478:       case (int)VarCode::lonlat:
 7479:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7480:          *sizeType = sizeof(double);
 7481:          break;
 7482:       case (int)VarCode::ghat:
 7483:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7484:          *sizeType = sizeof(Vector2);
 7485:          break;
 7486:       case (int)VarCode::kb:
 7487:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7488:          *sizeType = sizeof(int);
 7489:          break;
 7490:       case (int)VarCode::isdry:
 7491:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7492:          *sizeType = sizeof(int);
 7493:          break;            
 7494:       case (int)VarCode::w:
 7495:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7496:          *sizeType = sizeof(double);
 7497:          break;
 7498:       case (int)VarCode::FaceIndices:
 7499:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7500:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7501:          *sizeType = sizeof(Node);
 7502:          break;
 7503:       default:
 7504:          *offset = -1;
 7505:    }
 7506: }
