 2032:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2033:    // Project the vectors from the node frame to the element frame
 2034: 
 2035:  
 2036:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2037:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2038:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2039:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2040:       else          v[3] = Vector2();
 2041:    }
 2042: 
 2043:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2044:    // Project the vectors from the side frame to the element frame
 2045: 
 2046:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2047:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2048:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2049:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2050:       else          v[3] = Vector2();
 2051:    }
