 1468: // Helper functions for computing the local node index at a given offset from another.
 1469: __device__ __inline__ int nxq(int offset, int index, int size) {
 1470:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1471:    // to the index to make it positive
 1472:    assert(index + offset + 16*size >= 0);
 1473:    return (index + offset + 16*size) % size;  
 1474: }
 1475: 
 1476: __device__ __inline__ int nxq(int index, int size) {
 1477:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1478:    // to the index to make it positive
 1479:    assert(index + 16*size >= 0);
 1480:    return (index + 16*size) % size; 
 1481: }
