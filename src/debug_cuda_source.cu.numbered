 2819: 
 2820: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2821: 
 2822: 
 2823: __device__ void Node::updateKb(void) {
 2824: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2825: 
 2826:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 2827: 
 2828: 
 2829:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2830: 
 2831:    if constexpr(ivcor == 2) {  // SZ coordinates
 2832:       
 2833:       // Compute bottom level index
 2834:       if (depth <= mesh->h_s) {
 2835:          kb = izlev;   
 2836:          
 2837:       } else {
 2838:          kb = -1;
 2839:          int L = 0;
 2840:          int R = nzlev; 
 2841:          
 2842:          while (L <= R) {
 2843:             int M = (R + L) / 2;
 2844: 
 2845: 
 2846:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2847:             
 2848:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2849:                R = M;
 2850:             } else {
 2851:                L = M;
 2852:             }
 2853: 
 2854:             if (R - L == 1) {
 2855:                kb = L;
 2856:                break;
 2857:             }
 2858:          }
 2859: 
 2860:          // Checks that the binary search was successful
 2861:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2862:        
 2863:       }
 2864:    } 
 2865: }
 2866: 
 2867: 
 2868: __device__ __inline__ void Node::updateZCoordData(void) {
 2869: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2870: 
 2871:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2872:    // if (isDry2()) {
 2873:    //    kb = -1;  // XXXXXXXX KKKKK
 2874:    //    return;
 2875:    // }
 2876: 
 2877: 
 2878:    if constexpr(ivcor == 2) {  // SZ coordinates
 2879:       
 2880:       // Compute bottom level index
 2881:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2882:    } 
 2883:    else if (ivcor == 1) {  // Localized sigma
 2884:       // Do nothing
 2885:    }
 2886: 
 2887: 
 2888: }
 2889: 
 2890: 
 2891: __device__ double Node::compZCoord(int k) const {
 2892:    // Computes the z coordinate at level k.
 2893:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2894:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2895:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2896:    // used 
 2897: 
 2898:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2899:    
 2900:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2901: 
 2902:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2903: 
 2904:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2905: 
 2906:    if constexpr(ivcor == 2) {
 2907: 
 2908:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2909:       const double h_c = mesh->h_c;
 2910:       const double theta_f = mesh->theta_f;
 2911:       const double sinh_theta_f = mesh->sinh_theta_f;
 2912: 
 2913: 
 2914:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2915:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2916:       // once per time step/node.
 2917:       // CHECK: updateZCoordData
 2918: 
 2919:       //  To simplify comparisons, I define index versions of count variables.
 2920:       if      (k == ivrt)     return eta2; 
 2921:       else if (k == izlev)    return -hmod2;
 2922:       else if (k == kb)       return -depth;
 2923:       else if (k < izlev)     return mesh->ztot[k];
 2924:       else if (k > izlev) {
 2925:          const int ksig = k - izlev;
 2926: 
 2927:          if (hmod2 <= h_c) {
 2928:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2929: 
 2930:          } 
 2931:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2932:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2933:             assert(false && "ZCOOR (1): invalid h_c\n");
 2934:          } 
 2935:          else {
 2936:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2937:                    h_c * mesh->sigma[ksig] + 
 2938:                    (hmod2 - h_c) * mesh->cs[ksig];
 2939:          }
 2940:       } else { 
 2941:          assert(false && "ZCOOR (2): invalid level or coordinate system\n");
 2942:       }
 2943: 
 2944:    }
 2945:    else if constexpr(ivcor == 1) {
 2946:       if (k <= kb)        return -depth; 
 2947:       else if (k == ivrt) return eta2;
 2948:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 2949:    }
 2950:    
 2951:    assert(false && "ZCOOR (3): invalid level or coordinate system\n");
 2952:    return 0.0;
 2953: }
 2954: 
 2955: 
 2956: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2957:    // Computes the bottom drag Cd based on the selected nchi
 2958: 
 2959:    if constexpr(nchi == 0) {
 2960:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2961:       Cd = drag;  // Read from drag file
 2962: 
 2963:    } else if constexpr(nchi == 1) {
 2964:       // 
 2965: 
 2966:       bool ltmp = false; // for WBL iteration
 2967: 
 2968:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2969:       if (isDry || (rough == 0.0)) {
 2970:          Cd = 0.0;
 2971: 
 2972:       } else { //roughness >0 
 2973:          
 2974:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2975: 
 2976:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2977: 
 2978:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2979: 
 2980:       } // if rough
 2981: 
 2982:    } else if constexpr(nchi == -1) {
 2983:    // Manning 
 2984:  
 2985:       const double htot = max(hmin_man, htot2()); 
 2986:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2987: 
 2988:    } else {
 2989:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2990:       
 2991:    } // if nchi
 2992: 
 2993: }
 2994: 
 2995: 
 2996: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2997:    // Checks if a side in on the boundary
 2998:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2999: 
 3000:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3001:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3002: 
 3003:    // Indices of the nodes that form the side
 3004:    const int n1 = side.n1->idx;
 3005:    const int n2 = side.n2->idx;
 3006:    isLand = false;
 3007:    
 3008: 
 3009:    // Check if the side is on a land boundary
 3010:    for (int i = 0; i < nland; i++) {
 3011:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3012:          // Consecutive nodes in the land boundary segment
 3013:          const int b1 = ilnd[i + j*nland];
 3014:          const int b2 = ilnd[i + (j + 1)*nland];
 3015: 
 3016:          assert(b1 != -1 && b2 != -1);
 3017: 
 3018:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3019:             
 3020:             isLand = true;
 3021:             return i;
 3022:          }
 3023:       }
 3024:    }
 3025: 
 3026:    // Check if the side is on an open boundary
 3027:    for (int i = 0; i < nope; i++) {
 3028:       for (int j = 0; j < nond[i] - 1; j++) {
 3029:          // Consecutive nodes in the open boundary segment
 3030:          const int b1 = iond[i + j*nope];
 3031:          const int b2 = iond[i + (j + 1)*nope];
 3032: 
 3033:          assert(b1 != -1 && b2 != -1);
 3034: 
 3035:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3036:             isLand = false;
 3037:             return i;
 3038:          }
 3039:       }
 3040:    }
 3041: 
 3042:    return -1;
 3043: }
 3044: 
 3045: 
 3046: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3047:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3048:                                     double *wind_rotate_angle, 
 3049:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3050:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3051:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3052:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3053:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3054: 
 3055:    NODE(pnode);  
 3056:    const int i = idx_node;
 3057:    Node &node(*pnode);
 3058: 
 3059:    node.idx = i;
 3060: 
 3061:    const int idxNodeStart = nodeNeighNodesStart[i];
 3062:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3063:    node.numNodes = idxNodeEnd - idxNodeStart;
 3064:    node.nodes = nodeNeighNodes + idxNodeStart;
 3065:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3066: 
 3067: 
 3068: 
 3069:    const int idxElemStart = nodeNeighElemsStart[i];
 3070:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3071:    node.numElements = idxElemEnd - idxElemStart;
 3072:    node.elements = nodeNeighElems + idxElemStart;
 3073: 
 3074: 
 3075:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3076:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3077:       const int partNode = localNodePart[idxNodeGlobal]; 
 3078:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3079: 
 3080:       Node *node_ptr = nodes[partNode] + idxNode;
 3081:       
 3082:       nodeNeighNodes[idx] = node_ptr;
 3083:    }
 3084: 
 3085: 
 3086:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3087:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3088:       const int partElem = localElemPart[idxElemGlobal];
 3089:       const int idxElem  = localElemIndices[idxElemGlobal];
 3090: 
 3091:       Element *elem_ptr = elems[partElem] + idxElem;
 3092: 
 3093:       nodeNeighElems[idx] = elem_ptr;
 3094:    }      
 3095: 
 3096:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3097:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3098: 
 3099:    node.p.x   = node_coords[i * 3];
 3100:    node.p.y   = node_coords[i * 3 + 1];
 3101:    node.depth = node_coords[i * 3 + 2];
 3102: 
 3103:    if (use_ll) {
 3104:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3105:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3106:    }
 3107: 
 3108: 
 3109:    node.numSides = 0;
 3110: 
 3111:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3112:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3113:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3114:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3115:    else assert(false && "populateNodes: selected nchi not implemented.");
 3116:    
 3117:    if constexpr(ivcor == 1) 
 3118:    {  
 3119:       node.kb = kb[i];
 3120:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3121:    }
 3122: 
 3123:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3124:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3125:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3126: 
 3127:    
 3128:    // Links the node to the boundary information
 3129:    if (isbnd[i] >= 0) {
 3130:      
 3131:       // Get the index of the node boundary
 3132:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3133: 
 3134:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3135:       node.nodeBnd->node = &node;
 3136: 
 3137:       node.nodeBnd->sideBnd1 = nullptr;
 3138:       node.nodeBnd->sideBnd2 = nullptr;
 3139: 
 3140:       if (isbnd[i]>=0) {
 3141: 
 3142:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3143:          
 3144:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3145:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3146: 
 3147:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3148:          node.nodeBnd->segment->clen  = nan("1");
 3149:          node.nodeBnd->segment->carea = nan("1");
 3150: 
 3151:       }
 3152:    } else {
 3153: 
 3154:       node.nodeBnd = nullptr; // For internal nodes
 3155: 
 3156:       if (isbnd[i] == landSegment) {
 3157:          node.nodeBnd = &landBoundaryNode;
 3158:          node.nodeBnd->segment = &landBoundarySegment;
 3159:       }
 3160:       
 3161:    }
 3162:    
 3163:    // XXXX GAUSSIAN HILL VELOCITIES
 3164: #ifdef GAUSSIAN_HILL_VELOCITIES
 3165:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3166:       constexpr double rot_per = 3000.0;
 3167:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3168:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3169:    // XXXXX
 3170: #endif
 3171: 
 3172: }
 3173: 
 3174: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3175:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3176:                                     double *wind_rotate_angle,   
 3177:                                     int *isdel, int *isidenode, int *isbnd,
 3178:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3179:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3180:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3181:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3182:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3183:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3184:                                     double *drag, double *roughness) {
 3185: 
 3186: 
 3187:    SIDE(pside);
 3188:    Side &side(*pside);
 3189:    const int i = idx_side;
 3190: 
 3191:    side.idx = i;  
 3192:    
 3193:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3194:    const double fc   = 2.0*omega_e*sin(sfea0);
 3195:    const double beta = 2.0*omega_e*cos(sfea0);
 3196: 
 3197:    // finding the pointer to the nodes that form the side
 3198:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3199:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3200: 
 3201:    const int locidx_n1 = localNodeIndices[idx_n1];
 3202:    const int locidx_n2 = localNodeIndices[idx_n2];
 3203:    const int part_n1 =   localNodePart[idx_n1];
 3204:    const int part_n2 =   localNodePart[idx_n2];
 3205: 
 3206:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3207:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3208: 
 3209:    // Counts the number of sides connected to each node
 3210:    side.n1->numSides++;
 3211:    side.n2->numSides++;
 3212: 
 3213:    // Normal, unitary vector to the side
 3214:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3215:    side.n = normalize(side.n);
 3216: 
 3217:    // Side boundary type
 3218:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3219:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3220: 
 3221:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3222:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3223:    {
 3224:       bool isLand = false;
 3225:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3226:       
 3227:       if (isbs > -1) {
 3228:          // assert(isLand || isbs>=0);
 3229:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3230: 
 3231:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3232: 
 3233:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3234:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3235: 
 3236:          assert (isLand == side.sideBnd->segment->isLand);
 3237: 
 3238:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3239:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3240:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3241: 
 3242:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3243:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3244:          
 3245:          side.sideBnd->side = &side;
 3246: 
 3247:       }
 3248:       else {
 3249:          side.sideBnd = nullptr;
 3250:       }
 3251:    }
 3252:    else 
 3253:    {
 3254:       side.sideBnd = nullptr;
 3255:    }
 3256: 
 3257: 
 3258:    // finding the pointer to the elements that share the side
 3259:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3260:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3261: 
 3262:    if (idx_e1 > -1) {
 3263:       const int locidx_e1 = localElemIndices[idx_e1];
 3264:       const int part_e1 =  localElemPart[idx_e1];
 3265:       side.elems[0] = elems[part_e1] + locidx_e1;
 3266: 
 3267:    }
 3268:    else {
 3269:       side.elems[0] = nullptr;
 3270:    }
 3271: 
 3272:    if (idx_e2 > -1) {
 3273:       const int locidx_e2 = localElemIndices[idx_e2];
 3274:       const int part_e2 =  localElemPart[idx_e2];
 3275:       side.elems[1] = elems[part_e2] + locidx_e2;
 3276:    }
 3277:    else {
 3278:       side.elems[1] = nullptr;
 3279:    }
 3280: 
 3281:    // Compute the center of the side
 3282:    side.center = 0.5*(side.n1->p + side.n2->p);
 3283: 
 3284:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3285:    side.shapiro = shapiro0;
 3286: 
 3287: #ifdef GAUSSIAN_HILL_VELOCITIES
 3288: // XXXX
 3289: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3290: constexpr double rot_per=3000.0;
 3291: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3292: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3293: // XXXXX      
 3294: #endif
 3295:    // Compute the z level at the center of the side
 3296:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3297:    
 3298:    // Compute the length of the side
 3299:    const Vector2 vLen = side.n2->p - side.n1->p;
 3300:    side.len = sqrt(dot(vLen, vLen));
 3301: 
 3302: 
 3303:    // Compute the Coriolis coefficient
 3304: 
 3305:    if constexpr(ncor == -1 || ncor == 0) {
 3306:       side.coriolis = coricoef;
 3307:    }
 3308:    else {
 3309:       const double sphi = side.lat();  // Latitude at the center of the side
 3310: 
 3311: // XXXXXX ERROR WHEN use_ll is false??????
 3312:       if constexpr(ics == 1) {
 3313:          // XXXXXXX
 3314:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3315:       }
 3316:       else {
 3317:          side.coriolis = 2.0*omega_e*sin(sphi);  // XXX Sin()? Can it be optimized?
 3318:       }
 3319: 
 3320:    }
 3321: 
 3322: }
 3323: 
 3324: 
 3325: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3326:    double *node_coords, double *node_coords_ll, bool use_ll,
 3327:    double *wind_rotate_angle,   
 3328:    int *isdel, int *isidenode, int *isbnd,
 3329:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3330:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3331:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3332:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3333:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3334:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3335:    double *drag, double *roughness) {
 3336: 
 3337:    ELEM(pelem);
 3338:    Element &elem(*pelem);
 3339:    const int i = idx_elem;
 3340: 
 3341:    elem.idx = i;
 3342: 
 3343:    for (int j = 0; j < i34[i]; j++) {
 3344:       const int idxNode = elnode[i*4 + j];  
 3345:       const int idxSide = elside[i*4 + j];
 3346:       
 3347:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3348:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3349: 
 3350:       // Find the neighboring element  
 3351:       if (elem.sides[j]->elems[0] == &elem) {
 3352:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3353:       }
 3354:       else {
 3355:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3356:       }
 3357:       
 3358:    }
 3359: 
 3360:    elem.i34 = i34[i];
 3361: 
 3362:    // Compute the barycenter of the element and its depth
 3363:    elem.center = {0.0, 0.0};
 3364:    elem.depth = 0.0;
 3365:    for (int j = 0; j < i34[i]; j++) {
 3366: 
 3367:       elem.center += elem.nodes[j]->p/i34[i];
 3368:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3369:    }
 3370: 
 3371: 
 3372:    
 3373:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3374:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3375: 
 3376:    elem.area = elem.computeSignedArea(); 
 3377:    elem.radius = sqrt(elem.area)/pi; 
 3378:    
 3379:    // Determines which way the normal vector to each side is oriented.
 3380:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3381:    for (int j = 0; j < i34[i]; j++)  
 3382:    {
 3383:       if (elem.sides[j]->elems[0] == &elem) {
 3384:          elem.ssign[j] =  1.0;
 3385:       }
 3386:       else {
 3387:          elem.ssign[j] = -1.0;
 3388:       }
 3389: 
 3390:    }
 3391: 
 3392:    // Derivatives of shape functions
 3393:    //  For ics=2, this is done inside element/ll frame XXX
 3394:    //  For quads, the derivative is evaluated at centroid
 3395:    for (int j = 0; j < elem.i34; j++) {
 3396:       const double area = elem.area;
 3397:       const int id2 = elem.nxq(1 + j);
 3398:       const int id3 = elem.nxq(2 + j);
 3399:       const int id4 = elem.nxq(3 + j);
 3400:       if (elem.isTri()) {
 3401:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3402:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3403:          // da1/dx = (y1 - y2)/(2*area)
 3404:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3405:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3406:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3407:       }
 3408:       else  { // Quad; evaluate at centroid
 3409:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3410:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3411:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3412:       } // if Tri
 3413: 
 3414:    } // for j   
 3415:    
 3416:    
 3417: 
 3418: }
 3419: 
 3420: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3421:                                             double *emo, double *efa, 
 3422:                                             double *umo, double *ufa, 
 3423:                                             double *vmo, double *vfa) {
 3424: 
 3425: 
 3426:    NODE_BND(nodeBnd);
 3427:    const int idx = idx_node_bnd;    
 3428: 
 3429:    nodeBnd->idx = idx;
 3430: 
 3431:    // Need to find the segment index and the index of the node on the segment
 3432:    int idxNode = -1;
 3433:    int iseg, i;
 3434:    for (iseg = 0; iseg < nope; iseg++) {
 3435:       // for each segment...
 3436:       for (i = 0; i < nond[iseg]; i++) {
 3437:          idxNode = iond[iseg + i*nope];
 3438:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3439:          
 3440:       }
 3441:    }
 3442: 
 3443:    assert(iseg < nope && "iseg is out of bounds");
 3444: 
 3445: found: // Jumped here when the node was found
 3446: 
 3447:    nodeBnd->isEssentialBC = true;
 3448:    nodeBnd->elbc = 0.0;
 3449: 
 3450:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3451: 
 3452:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3453:       nodeBnd->efa[jfr] = efa[idx2];
 3454:       nodeBnd->emo[jfr] = emo[idx2];
 3455:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3456:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3457: 
 3458:    }
 3459:         
 3460: 
 3461: }
 3462: 
 3463: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3464:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3465:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3466:                 int *isdel, int *isidenode, int *isbnd,
 3467:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3468:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3469:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3470:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3471:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3472:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3473:                 double *drag, double *roughness,
 3474:                 double *emo, double *efa, 
 3475:                 double *umo, double *ufa, 
 3476:                 double *vmo, double *vfa) {
 3477: 
 3478:    printf("Populating mesh for partition %d\n", partNum);
 3479: 
 3480:    // XXXXXX THIS function does almost nothing. 
 3481: 
 3482:    nbs = *sharedIdxSideBoundary + 1;
 3483:    nbp = *sharedIdxNodeBoundary + 1;
 3484: 
 3485:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3486: 
 3487: }
 3488: 
 3489: 
 3490: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3491:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3492:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3493: 
 3494: 
 3495:    NODE(node1);
 3496: 
 3497:    node1->clearMatrixRow();
 3498:    node1->qel = 0.0;
 3499: 
 3500:    // THIS IS FOR STRUCTURES XXX
 3501:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3502: 
 3503:    
 3504:    for (int j=0; j<node1->numElements; j++) {
 3505:       // For each element connected to the node...
 3506: 
 3507:       Element *elem = node1->elements[j];
 3508: 
 3509: 
 3510: 
 3511:       // Compute the average gravity
 3512:       const double grav3 = elem->mean(&Node::grav2);
 3513: 
 3514:       // Look at the documentation for the description of the terms in the following integrals
 3515: 
 3516:       // Integral I_1 
 3517:       // \bar{\breve{H}} 
 3518:       const double hhatb = elem->mean(&Side::hhat);        
 3519: 
 3520:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3521: 
 3522:       const int id1 = elem->nodeLocalIdx(node1); 
 3523:       const double area = elem->area;
 3524: 
 3525:       if (elem->isTri()) {
 3526: 
 3527:          // To clarify the notation in this section: 
 3528:          //   i stands for the node under consideration (node1)
 3529:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3530:          const int id2 = elem->nxq(1 + id1);
 3531:          const int id3 = elem->nxq(2 + id1);
 3532:          Node *node2 = elem->nodes[id2];
 3533:          Node *node3 = elem->nodes[id3];
 3534: 
 3535:          const Point2 x1 = node1->p;
 3536:          const Point2 x2 = node2->p;
 3537:          const Point2 x3 = node3->p;
 3538: 
 3539:          // integral of phi_i*phi_j
 3540:          const double ipp_ii = (1.0/6.0 )*area;
 3541:          const double ipp_ij = (1.0/12.0)*area;
 3542:          const double ipp_ik = (1.0/12.0)*area;
 3543: 
 3544:          // integral of [(grad phi_i) * (grad phi_j)]
 3545:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3546:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3547:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3548: 
 3549:          // Computes the different components of integral I_1 of each node with respect to node i.
 3550:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3551:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3552:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3553: 
 3554:          node1->addToSparseMatrix(node1, I1_ii);
 3555:          node1->addToSparseMatrix(node2, I1_ij); 
 3556:          node1->addToSparseMatrix(node3, I1_ik);
 3557: 
 3558:       }
 3559:       else { // Quad
 3560:          // XXX IMPLEMENT THIS
 3561:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3562: 
 3563:          // To clarify the notation in this section: 
 3564:          //   i stands for the node under consideration (node1)
 3565:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3566:          const int id2 = elem->nxq(1 + id1);
 3567:          const int id3 = elem->nxq(2 + id1);
 3568:          const int id4 = elem->nxq(3 + id1);
 3569:          Node *node2 = elem->nodes[id2];
 3570:          Node *node3 = elem->nodes[id3];
 3571:          Node *node4 = elem->nodes[id4];         
 3572: 
 3573:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3574:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3575:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3576:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3577:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3578: 
 3579:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3580:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3581:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3582:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3583:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3584: 
 3585:          // Computes the different components of integral I_1 of each node with respect to node i.
 3586:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3587:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3588:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3589:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3590: 
 3591:          node1->addToSparseMatrix(node1, I1_ii);
 3592:          node1->addToSparseMatrix(node2, I1_ij); 
 3593:          node1->addToSparseMatrix(node3, I1_ik);
 3594:          node1->addToSparseMatrix(node4, I1_il);
 3595:   
 3596:       } 
 3597: 
 3598:  
 3599:       // Integral I_4
 3600:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3601:       // Where
 3602:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3603: 
 3604:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3605:       // of U over the element.
 3606:       Vector2 U = {0.0, 0.0};
 3607:       for (int m=0; m < elem->i34; m++) {      
 3608:          const Side *side = elem->sides[m];
 3609: 
 3610:          if constexpr(ics == 1) U += side->U; 
 3611:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 3612:       }
 3613:       U = U/elem->i34;
 3614: 
 3615: 
 3616:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3617: 
 3618: 
 3619:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3620:       const double I_4_1 = dot(gradPhi_1, U);
 3621: 
 3622: 
 3623:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3624:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3625: 
 3626:      
 3627:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3628: 
 3629:       // Additional terms 
 3630:       double vnorm = 0.0;
 3631:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3632:          Vector3 ubed = {0.0, 0.0, 0.0};
 3633:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3634: 
 3635:          Vector3 gradP = {0.0, 0.0, 1.0};
 3636:          for (int m=0; m < elem->i34; m++) {
 3637:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3638:            gradP += toVector3(gradP_2D, 0.0);
 3639:          }   
 3640:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3641:       } // imm==2
 3642: 
 3643:       if (elem->isTri()) {
 3644:          for (int l=0; l<3; l++) {
 3645: 
 3646:             Node *node = elem->nodes[l];
 3647: 
 3648:             double fac = (node == node1) ? 2.0 : 1.0;
 3649:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3650:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3651:            
 3652:          }
 3653: 
 3654: 
 3655:          if (!elem->isDry) {
 3656:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3657: 
 3658:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3659: 
 3660:          }
 3661: 
 3662:       } // isTri
 3663:       else { // isQuad
 3664:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3665:          // for (int l=0; l<4; l++) {
 3666:          //   const Node *node = elem->nodes[l];
 3667: 
 3668:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3669:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3670: 
 3671:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3672:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3673:          // }
 3674: 
 3675:       } // isQuad
 3676: 
 3677: 
 3678:      node1->qel += (dt/elem->i34)*elem->vsource;
 3679:       
 3680: 
 3681:    } // for all elements connected to the node
 3682:    
 3683: 
 3684:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3685:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3686:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3687:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3688:       // If it is an open boundary node...
 3689: 
 3690:       // At least one open bnd side, maybe two
 3691:       for (int l=0; l<2; l++) { 
 3692: 
 3693:          // Gets each of the sides sharing the node. 
 3694:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3695: 
 3696:        
 3697: 
 3698:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3699:          if (sideBnd != nullptr) {
 3700:             // If the side is on a boundary...
 3701: 
 3702:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3703: 
 3704:             // Get the boundary segment
 3705:             const BoundarySegment *sideSegment = sideBnd->segment;
 3706:             const Side *side = sideBnd->side;
 3707: 
 3708:             // Integral I_3
 3709:             if (sideSegment->ifltype != 0) {
 3710:             // Natural or Flather b.c.
 3711: 
 3712:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3713:                // especially for Flather b.c.
 3714:                double ri3 = 0.0;
 3715:                if (!side->isDry) {
 3716:                   // If the side is not dry
 3717:                   
 3718:                   // Computes the side flux of (uth, vth)
 3719:                   double Vn = 0.0;
 3720:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3721:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3722:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3723: 
 3724:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3725:                   }
 3726: 
 3727:                   ri3 = 0.5*side->len*Vn;
 3728:                }
 3729: 
 3730:                if (sideSegment->ifltype == -1) { // Flather 1
 3731: 
 3732:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3733:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3734: 
 3735:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3736:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3737:                   
 3738:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3739:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3740: 
 3741:                } 
 3742:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3743:                   // Reset ri3
 3744:                   ri3 = 0.0;
 3745: 
 3746:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3747: 
 3748:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3749: 
 3750:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3751:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3752: 
 3753:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3754:                   node1->addToSparseMatrix(node1, con0*2.0);
 3755:                   node1->addToSparseMatrix(node2, con0);
 3756: 
 3757:                } // if Flather or Discharge
 3758: 
 3759:                node1->qel -= thetai*dt*ri3;
 3760: 
 3761: 
 3762:             } // I_3
 3763:           
 3764: 
 3765:             // Integral I_5
 3766:             if(!side->isDry) {
 3767: 
 3768:                const double Unbar = dot(side->U, side->n);
 3769:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3770: 
 3771:             } // I_5
 3772: 
 3773:          } // if is boundary side
 3774: 
 3775:       } // for l
 3776: 
 3777:    } // if isbnd
 3778: 
 3779: 
 3780: }
 3781: 
 3782: 
 3783: 
 3784: extern "C" {
 3785:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3786:                                   int* indices, int* indptr) {
 3787: 
 3788:       NODE(node);
 3789:       
 3790:       const int idx = node->idx;
 3791:       
 3792:       // Computes the index in the nzz array      
 3793:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3794: 
 3795: 
 3796:       indptr[idx] = nzzIdx;
 3797:       indices[nzzIdx] = idx;
 3798: 
 3799:       data_d[nzzIdx]    = node->coeffDiag;
 3800: 
 3801:       b_d[idx] = node->qel;
 3802: 
 3803:       for (int k = 0; k < node->numNodes; ++k) {
 3804:          const Node* nb = node->nodes[k];
 3805: 
 3806:          const int j = nb->idx;
 3807: 
 3808:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3809: 
 3810:          indices[nzzIdx + k + 1] = j;
 3811:       }
 3812: 
 3813:  
 3814:    }
 3815: 
 3816: 
 3817: 
 3818:    __global__ void solverCopyResult(double* x) {
 3819:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3820:       NODE(node);
 3821:       const int idx = node->idx;
 3822: 
 3823:       node->mX = x[idx];
 3824:    }
 3825: 
 3826: 
 3827:    __global__ void rollUpElevation(void) {
 3828: 
 3829:       NODE(node);
 3830: 
 3831:       node->eta1 = node->eta2;
 3832: 
 3833:    }
 3834: 
 3835: 
 3836:    __global__ void backtrackAllNodes(void) {
 3837: 
 3838:       // max/min # of sub-divisions
 3839:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 3840:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 3841: 
 3842: 
 3843:       SIDE(side);
 3844: 
 3845:       const int kb = side->kb;
 3846: 
 3847: 
 3848:       // Initialize btrack velocities to the actual velocities at the side 
 3849:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3850: 
 3851:   
 3852: 
 3853:       if (side->isDry) return;
 3854:       
 3855: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3856: 
 3857:       // Checks that at least one element is not dry
 3858:       const Element *elem1 = side->elems[0];
 3859:       const Element *elem2 = side->elems[1];
 3860: 
 3861: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3862: 
 3863:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3864:       
 3865:       // XXXXXX
 3866:       // !swild_tmp to store global coord. of the starting side
 3867:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3868:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3869:       // !Use sframe2 
 3870:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3871: 
 3872: 
 3873:       for (int k = kb; k < nvrt; k++) {
 3874:       //  Initialize (xt,yt,zt), nnel and vel.
 3875:       //  For ics=2, the coordinates are all in the side's local frame
 3876:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3877: 
 3878: 
 3879:          const int iadvf = side->iadv();  // Advection flag   
 3880:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3881: 
 3882: 
 3883:          // If on land or open boundary...
 3884:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3885:          
 3886:          const double vmag = length(side->u2[k]);
 3887: 
 3888:          if (vmag <= velmin_btrack) {
 3889:             // No activity 
 3890: 
 3891:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3892: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3893: 
 3894: 
 3895:             
 3896:          } else {  // do btrack
 3897: 
 3898:             // Compute number of sub-divisions based on local gradients of the velocity field
 3899: 
 3900:             // XXX IS THIS NECESSARY?
 3901:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 3902:             double suma = 0.0;
 3903:             int icount = 0;
 3904:             for (int l=0; l<2; l++) {
 3905:             // For each element sharing the side...
 3906: 
 3907:                const Element *elem = side->elems[l];
 3908:                  
 3909:                if (elem == nullptr) continue;
 3910: 
 3911:                icount++;
 3912: 
 3913:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 3914:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 3915:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 3916: 
 3917:                double utmp[4];
 3918:                double vtmp[4];
 3919:                for (int j = 0; j < elem->i34; j++) {
 3920: 
 3921:                   const Node *node = elem->nodes[j];
 3922: 
 3923:                   if constexpr(ics==1) {
 3924:                      utmp[j] = node->u2[k].x;
 3925:                      vtmp[j] = node->u2[k].y;  
 3926: 
 3927:                   } else {
 3928:                      // 'Project' the velocity from the node frame to the element frame
 3929:                      const Vector2 tmp_u2 = frame.projHorVec(node->u2[k], elem->frame);
 3930:                      utmp[j] = tmp_u2.x;
 3931:                      vtmp[j] = tmp_u2.y;
 3932: 
 3933:                   }
 3934:                } // for j
 3935: 
 3936:                const Vector2 grad_u = elem->grad2(utmp); 
 3937:                const Vector2 grad_v = elem->grad2(vtmp);
 3938: 
 3939:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3940:             } // for ii
 3941: 
 3942:             assert(icount > 0 && "Impossible 77");
 3943: 
 3944:             // '4' is somewhat arbitrary
 3945:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3946: 
 3947:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3948: 
 3949:             Vector3 u_int = {0.0, 0.0, 0.0};
 3950: 
 3951:             bool res =side->btrack(k, dt, dtbk, u_int);
 3952: 
 3953:             side->btu[k] = toVector2(u_int);
 3954:                
 3955:          } // if vmag (do backtrack)
 3956: 
 3957: 
 3958:       } // for k=kb,nvrt-1
 3959: 
 3960:    }
 3961: 
 3962: } // extern "C"
 3963: 
 3964: template<int nc>
 3965: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3966: 
 3967: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3968: //
 3969: // a,b,c,rhs: input vectors and are not modified by this program.
 3970: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3971: // rhs is the r.h.s.
 3972: // n: actual rank of the system.
 3973: // rows in u() and rhs();
 3974: // u: output with nc columns (transposed to rows)
 3975: // gam: a working array.
 3976: //
 3977: // NOTES:
 3978: // This is a template function that allows for different numbers of columns in the rhs vector.
 3979: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3980: 
 3981:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3982:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3983: 
 3984:    double bet = b[0];
 3985:    if constexpr (nc == 1) {
 3986:       u[0] = rhs[0]/bet;
 3987:    } else {
 3988:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3989:    }
 3990: 
 3991:    for (int j = 1; j < n; j++) {
 3992:       gam[j] = c[j - 1]/bet;
 3993:       bet = b[j] - a[j]*gam[j];
 3994: 
 3995:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3996: 
 3997:       if constexpr (nc == 1) {
 3998:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3999:       } else {
 4000:          for (int l = 0; l < nc; l++) {
 4001:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4002:          }
 4003:       }
 4004:    }
 4005: 
 4006:    // Back-substitution
 4007:    for (int j = n - 2; j >= 0; j--) {
 4008:       if constexpr (nc == 1) {
 4009:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4010:       } else {
 4011:          for (int l = 0; l < nc; l++) {
 4012:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4013:          }
 4014:       }
 4015:    }
 4016: }
 4017: 
 4018: 
 4019: 
 4020: // Helper function that contains the core algorithm
 4021: template<typename XAccessor, typename YAccessor>
 4022: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4023:                                     double  yp_top, double  yp_bot, 
 4024:                                     CubicSpline &spline) {
 4025:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4026:    // 
 4027:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4028:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4029:    //
 4030:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4031:    // 
 4032:    // Inputs: 
 4033:    //            n: dimension for x etc; # of data pts (>=2);
 4034:    //            getX, getY: functions to access x,y coordinates
 4035:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4036:    //     Output: 
 4037:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4038: 
 4039:    const int n = k2 - k1 + 1;
 4040:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4041: 
 4042:    // Allocate memory for the splines
 4043:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4044:    spline.x   = new double[n];
 4045:    spline.y   = new double[n];
 4046:    spline.yp  = new double[n];
 4047:    spline.ypp = new double[n];
 4048: 
 4049:    for (int k=k1; k<=k2; k++) {
 4050:       spline.x[k] = getX(k);
 4051:       spline.y[k] = getY(k);
 4052:    }
 4053: 
 4054:    // This is to simplify expressions later
 4055:    double *x = spline.x;
 4056:    double *y = spline.y;
 4057: 
 4058:    double *a = nullptr;
 4059:    double *b = nullptr;
 4060:    double *c = nullptr;
 4061:    double *gam = nullptr;
 4062:    double *rhs = nullptr;
 4063:    
 4064: 
 4065:       a = new double[n];   // Lower diagonal
 4066:       b = new double[n];   // Diagonal
 4067:       c = new double[n];   // Upper diagonal
 4068:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4069:       rhs = new double[n]; // Right-hand side
 4070: 
 4071:    for (int k=k1; k<=k2; k++) {
 4072:       if (k == k1) {
 4073:          // Bottom level
 4074:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4075:          b[k] = (x[k+1] - x[k])/3.0;
 4076:          c[k] = b[k]/2.0;
 4077:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4078:       } else if (k == n - 1) {
 4079:          // Top level (surface)
 4080:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4081:          b[k] = (x[k] - x[k-1])/3.0;
 4082:          a[k] = b[k]/2.0;
 4083:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4084:       } else {
 4085:          // Intermediate levels
 4086:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4087:          b[k] = (x[k+1] - x[k-1])/3.0;
 4088:          a[k] = (x[k  ] - x[k-1])/6.0;
 4089:          c[k] = (x[k+1] - x[k  ])/6.0;
 4090:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4091:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4092:       }
 4093:    }
 4094: 
 4095:    // Solve the tridiagonal system
 4096:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4097:    
 4098:    spline.yp[k1] = yp_bot;
 4099:    spline.yp[k2] = yp_top;
 4100: 
 4101:    // Compute rest of 1st derivatives using the splines
 4102:    for (int k=k1+1; k<k2; k++) {
 4103:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4104:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4105:    }
 4106:    
 4107:    delete[] a;
 4108:    delete[] b;
 4109:    delete[] c;
 4110:    delete[] gam;
 4111:    delete[] rhs;
 4112: 
 4113: }
 4114: 
 4115: // Array version
 4116: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4117:                                 double y_top, double y_bot, 
 4118:                                 CubicSpline &spline) {
 4119:    auto getX = [x] (int k) { return x[k]; };
 4120:    auto getY = [y] (int k) { return y[k]; };
 4121:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4122: }
 4123: 
 4124: // Lambda version - allows custom access patterns
 4125: template<typename XFunc, typename YFunc>
 4126: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4127:                                 double y_top, double y_bot,
 4128:                                 CubicSpline &spline) {
 4129:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4130: }
 4131: 
 4132: 
 4133: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4134: {
 4135:    assert("Not implemented");
 4136: 
 4137:    return 0.0;
 4138: }
