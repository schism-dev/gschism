 4159:    __global__ void scaleGravity(double loadtide_coef) {
 4160: 
 4161: 
 4162:       NODE(node);
 4163: 
 4164:       // SAL option: scale gravity
 4165:       if constexpr(iloadtide==2) {  // simple const
 4166:          node->grav2 = grav*(1.0 - loadtide_coef);
 4167: 
 4168:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4169:         
 4170:           const double depth = max(node->depth, 0.0);
 4171:           const double tmp1 = sqrt(depth);
 4172:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4173:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4174:                              2.6969e-13*depth*depth*depth*tmp1;
 4175:           
 4176:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4177:           
 4178: 
 4179: 
 4180:           node->grav2 = grav*(1.0 - beta_bar);
 4181: 
 4182:       } else {  // iloadtide=0,1
 4183:         node->grav2=grav;
 4184: 
 4185:       }
 4186: 
 4187:    }
 4188: 
