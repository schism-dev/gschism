 2784: 
 2785: __device__ void Node::updateKb(void) {
 2786: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2787: 
 2788:    if constexpr(ivcor == 1) return;
 2789: 
 2790: 
 2791:    if (isDry2()) return;
 2792: 
 2793:    if constexpr(ivcor == 2) {  // SZ coordinates
 2794:       
 2795:       // Compute bottom level index
 2796:       if (depth <= mesh->h_s) {
 2797:          kb = izlev;
 2798:          
 2799:       } else {
 2800:          kb = -1;
 2801:          int L = 0;
 2802:          int R = nzlev; 
 2803:          
 2804:          while (L <= R) {
 2805:             int M = (R + L) / 2;
 2806: 
 2807: 
 2808:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2809:             
 2810:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2811:                R = M;
 2812:             } else {
 2813:                L = M;
 2814:             }
 2815: 
 2816:             if (R - L == 1) {
 2817:                kb = L;
 2818:                break;
 2819:             }
 2820:          }
 2821:       }
 2822:    } 
 2823: }
 2824: 
 2825: 
 2826: __device__ __inline__ void Node::updateZCoordData(void) {
 2827: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2828: 
 2829:    if (isDry2()) {
 2830:       kb = -1;
 2831:       return;
 2832:    }
 2833: 
 2834:    if constexpr(ivcor == 2) {  // SZ coordinates
 2835:       
 2836:       // Compute bottom level index
 2837:       if (depth <= mesh->h_s) {
 2838:             kb = izlev;
 2839: 
 2840:       } else {
 2841:          kb = -1;
 2842:          for (int i = 0; i < nzlev; i++) {
 2843:             // XXX Use binary search
 2844:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2845:                kb = i;
 2846:                break;
 2847:             }
 2848:          }
 2849:       }
 2850:    } 
 2851:    else if (ivcor == 1) {  // Localized sigma
 2852:       // Do nothing
 2853:    }
 2854: 
 2855: }
 2856: 
 2857: 
 2858: __device__ double Node::compZCoord(int k) const {
 2859:    // Computes the z coordinate at level k.
 2860:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2861:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2862:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2863:    // used 
 2864:    
 2865:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2866: 
 2867:    if (isDry2()) return 0.0;
 2868: 
 2869:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2870: 
 2871:    if constexpr(ivcor == 2) {
 2872: 
 2873:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2874:       const double h_c = mesh->h_c;
 2875:       const double theta_f = mesh->theta_f;
 2876:       const double sinh_theta_f = mesh->sinh_theta_f;
 2877: 
 2878:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2879:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2880:       // once per time step/node.
 2881:       // CHECK: updateZCoordData
 2882: 
 2883:       //  To simplify comparisons, I define index versions of count variables.
 2884:       if      (k == ivrt)           return eta2; 
 2885:       else if (k == izlev)          return -hmod2;
 2886:       else if (k == kb)             return -depth;
 2887:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2888:       else if (k > izlev) {
 2889:          const int ksig = k - izlev;
 2890: 
 2891:          if (hmod2 <= h_c) {
 2892: 
 2893:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2894:          } 
 2895:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2896:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2897:             assert(false && "ZCOOR: invalid h_c\n");
 2898:          } 
 2899:          else {
 2900:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2901:                          h_c * mesh->sigma[ksig] + 
 2902:                          (hmod2 - h_c) * mesh->cs[ksig];
 2903:          }
 2904:       } else { 
 2905:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2906:       }
 2907: 
 2908:    }
 2909:    else if constexpr(ivcor == 1) {
 2910:       if (k == kb) return -depth;
 2911:       else if (k == nvrt-1) return eta2;
 2912:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2913:    }
 2914:    
 2915:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2916:    return 0.0;
 2917: }
 2918: 
 2919: 
 2920: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2921:    // Computes the bottom drag Cd based on the selected nchi
 2922: 
 2923:    if constexpr(nchi == 0) {
 2924:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2925:       Cd = drag;  // Read from drag file
 2926: 
 2927:    } else if constexpr(nchi == 1) {
 2928:       // 
 2929: 
 2930:       bool ltmp = false; // for WBL iteration
 2931: 
 2932:       assert(false && "computeBottomDragVegetation: nchi == 1 not fully implemented. see below");
 2933:       // Cdmax=-1 !max. Cd at node for this process (info only)
 2934:       // Drag at nodes
 2935: /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 2936: // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 2937:            
 2938:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2939:       if (rough == 0.0) {
 2940:          Cd = 0.0;
 2941: 
 2942:       } else { //roughness >0 
 2943:          
 2944:          const double bthick_ori = z[kb + 1] - z[kb];  // thickness of bottom bnd layer
 2945:          const double bthick = max(dzb_min, bthick_ori);
 2946: 
 2947:          assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 2948: 
 2949:          double tmp = 1.0/(2.5*log(bthick/rough));
 2950:          Cd = tmp*tmp;
 2951: 
 2952:       } // if rough
 2953: 
 2954: 
 2955:       // RECOVER THIS: XXX
 2956:       // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 2957:       // Output warning for WBL if iteration didn't converge
 2958: 
 2959: 
 2960:    } else if constexpr(nchi == -1) {
 2961:    // Manning 
 2962:       Cd = 0.0;
 2963: 
 2964:       if (isDry) return;
 2965: 
 2966:       const double htot = max(hmin_man, htot2()); 
 2967:       Cd = grav2*rmanning*rmanning/pow(htot, 0.333);
 2968: 
 2969:    } else {
 2970:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2971:       
 2972:    } // if nchi
 2973: }
 2974: 
 2975: 
 2976: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2977:    // Checks if a side in on the boundary
 2978:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2979: 
 2980:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2981:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2982: 
 2983:    // Indices of the nodes that form the side
 2984:    const int n1 = side.n1->idx;
 2985:    const int n2 = side.n2->idx;
 2986:    isLand = false;
 2987:    
 2988: 
 2989:    // Check if the side is on a land boundary
 2990:    for (int i = 0; i < nland; i++) {
 2991:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2992:          // Consecutive nodes in the land boundary segment
 2993:          const int b1 = ilnd[i + j*nland];
 2994:          const int b2 = ilnd[i + (j + 1)*nland];
 2995: 
 2996:          assert(b1 != -1 && b2 != -1);
 2997: 
 2998:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2999:             
 3000:             isLand = true;
 3001:             return i;
 3002:          }
 3003:       }
 3004:    }
 3005: 
 3006:    // Check if the side is on an open boundary
 3007:    for (int i = 0; i < nope; i++) {
 3008:       for (int j = 0; j < nond[i] - 1; j++) {
 3009:          // Consecutive nodes in the open boundary segment
 3010:          const int b1 = iond[i + j*nope];
 3011:          const int b2 = iond[i + (j + 1)*nope];
 3012: 
 3013:          assert(b1 != -1 && b2 != -1);
 3014: 
 3015:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3016:             isLand = false;
 3017:             return i;
 3018:          }
 3019:       }
 3020:    }
 3021: 
 3022:    return -1;
 3023: }
 3024: 
 3025: 
 3026: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3027:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3028:                                     double *wind_rotate_angle, 
 3029:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3030:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3031:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3032:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3033:                                     double *drag, double *roughness, double *rmanning) {
 3034: 
 3035:    NODE(pnode);  
 3036:    const int i = idx_node;
 3037:    Node &node(*pnode);
 3038: 
 3039:    node.idx = i;
 3040: 
 3041:    const int idxNodeStart = nodeNeighNodesStart[i];
 3042:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3043:    node.numNodes = idxNodeEnd - idxNodeStart;
 3044:    node.nodes = nodeNeighNodes + idxNodeStart;
 3045:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3046: 
 3047: 
 3048: 
 3049:    const int idxElemStart = nodeNeighElemsStart[i];
 3050:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3051:    node.numElements = idxElemEnd - idxElemStart;
 3052:    node.elements = nodeNeighElems + idxElemStart;
 3053: 
 3054: 
 3055:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3056:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3057:       const int partNode = localNodePart[idxNodeGlobal]; 
 3058:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3059: 
 3060:       Node *node_ptr = nodes[partNode] + idxNode;
 3061:       
 3062:       nodeNeighNodes[idx] = node_ptr;
 3063:    }
 3064: 
 3065: 
 3066:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3067:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3068:       const int partElem = localElemPart[idxElemGlobal];
 3069:       const int idxElem  = localElemIndices[idxElemGlobal];
 3070: 
 3071:       Element *elem_ptr = elems[partElem] + idxElem;
 3072: 
 3073:       nodeNeighElems[idx] = elem_ptr;
 3074:    }      
 3075: 
 3076: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3077: 
 3078:    node.wind_angle = wind_rotate_angle[i];
 3079: 
 3080: 
 3081:    node.p.x   = node_coords[i * 3];
 3082:    node.p.y   = node_coords[i * 3 + 1];
 3083:    node.depth = node_coords[i * 3 + 2];
 3084: 
 3085:    if (use_ll) {
 3086:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3087:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3088:    }
 3089: 
 3090: 
 3091:    node.numSides = 0;
 3092: 
 3093:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3094:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3095:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3096:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3097:    else assert(false && "populateNodes: selected nchi not implemented.");
 3098:    
 3099:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3100: 
 3101:    
 3102:    // Links the node to the boundary information
 3103:    if (isbnd[i] >= 0) {
 3104: 
 3105:      
 3106:       // Get the index of the node boundary
 3107:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3108: 
 3109:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3110:       node.nodeBnd->node = &node;
 3111: 
 3112:       node.nodeBnd->sideBnd1 = nullptr;
 3113:       node.nodeBnd->sideBnd2 = nullptr;
 3114: 
 3115:       if (isbnd[i]>=0) {
 3116: 
 3117:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3118:          
 3119:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3120:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3121: 
 3122:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3123:          node.nodeBnd->segment->clen  = nan("1");
 3124:          node.nodeBnd->segment->carea = nan("1");
 3125: 
 3126:       }
 3127: //          else {  XXXXXX
 3128: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3129: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3130: //          }
 3131:       
 3132: 
 3133:    }
 3134:    else {
 3135: 
 3136:       node.nodeBnd = nullptr; // For internal nodes
 3137: 
 3138:       if (isbnd[i] == landSegment) {
 3139:          node.nodeBnd = &landBoundaryNode;
 3140:          node.nodeBnd->segment = &landBoundarySegment;
 3141:       }
 3142:       // node.nodeBnd->node = &node;
 3143:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3144:       // // node.nodeBnd = nullptr;
 3145:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3146:       
 3147:    }
 3148:    
 3149:    // XXXX GAUSSIAN HILL VELOCITIES
 3150: #ifdef GAUSSIAN_HILL_VELOCITIES
 3151:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3152:       constexpr double rot_per = 3000.0;
 3153:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3154:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3155:    // XXXXX
 3156: #endif
 3157: 
 3158: }
 3159: 
 3160: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3161:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3162:                                     double *wind_rotate_angle,   
 3163:                                     int *isdel, int *isidenode, int *isbnd,
 3164:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3165:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3166:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3167:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3168:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3169:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3170:                                     double *drag, double *roughness) {
 3171: 
 3172: 
 3173:    SIDE(pside);
 3174:    Side &side(*pside);
 3175:    const int i = idx_side;
 3176: 
 3177:    side.idx = i;  
 3178:    
 3179:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3180:    const double fc   = 2.0*omega_e*sin(sfea0);
 3181:    const double beta = 2.0*omega_e*cos(sfea0);
 3182: 
 3183:    // finding the pointer to the nodes that form the side
 3184:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3185:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3186: 
 3187:    const int locidx_n1 = localNodeIndices[idx_n1];
 3188:    const int locidx_n2 = localNodeIndices[idx_n2];
 3189:    const int part_n1 =   localNodePart[idx_n1];
 3190:    const int part_n2 =   localNodePart[idx_n2];
 3191: 
 3192:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3193:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3194: 
 3195:    // Counts the number of sides connected to each node
 3196:    side.n1->numSides++;
 3197:    side.n2->numSides++;
 3198: 
 3199:    // Normal, unitary vector to the side
 3200:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3201:    side.n = normalize(side.n);
 3202: 
 3203:    // Side boundary type
 3204:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3205:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3206: 
 3207:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3208:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3209:    {
 3210:       bool isLand = false;
 3211:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3212:       
 3213:       if (isbs > -1) {
 3214:          // assert(isLand || isbs>=0);
 3215:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3216: 
 3217:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3218: 
 3219:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3220:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3221: 
 3222:          assert (isLand == side.sideBnd->segment->isLand);
 3223: 
 3224:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3225:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3226:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3227: 
 3228:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3229:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3230:          
 3231:          side.sideBnd->side = &side;
 3232: 
 3233:       }
 3234:       else {
 3235:          side.sideBnd = nullptr;
 3236:       }
 3237:    }
 3238:    else 
 3239:    {
 3240:       side.sideBnd = nullptr;
 3241:    }
 3242: 
 3243: 
 3244:    // finding the pointer to the elements that share the side
 3245:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3246:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3247: 
 3248:    if (idx_e1 > -1) {
 3249:       const int locidx_e1 = localElemIndices[idx_e1];
 3250:       const int part_e1 =  localElemPart[idx_e1];
 3251:       side.elems[0] = elems[part_e1] + locidx_e1;
 3252: 
 3253:    }
 3254:    else {
 3255:       side.elems[0] = nullptr;
 3256:    }
 3257: 
 3258:    if (idx_e2 > -1) {
 3259:       const int locidx_e2 = localElemIndices[idx_e2];
 3260:       const int part_e2 =  localElemPart[idx_e2];
 3261:       side.elems[1] = elems[part_e2] + locidx_e2;
 3262:    }
 3263:    else {
 3264:       side.elems[1] = nullptr;
 3265:    }
 3266: 
 3267:    // Compute the center of the side
 3268:    side.center = 0.5*(side.n1->p + side.n2->p);
 3269: 
 3270:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3271:    side.shapiro = shapiro0;
 3272: 
 3273: #ifdef GAUSSIAN_HILL_VELOCITIES
 3274: // XXXX
 3275: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3276: constexpr double rot_per=3000.0;
 3277: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3278: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3279: // XXXXX      
 3280: #endif
 3281:    // Compute the z level at the center of the side
 3282:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3283:    
 3284:    // Compute the length of the side
 3285:    const Vector2 vLen = side.n2->p - side.n1->p;
 3286:    side.len = sqrt(dot(vLen, vLen));
 3287: 
 3288: 
 3289:    // Compute the Coriolis coefficient
 3290: 
 3291:    if constexpr(ncor == -1 || ncor == 0) {
 3292:       side.coriolis = coricoef;
 3293:    }
 3294:    else {
 3295:       const double sphi = side.lat();  // Latitude at the center of the side
 3296: 
 3297: // XXXXXX ERROR WHEN use_ll is false??????
 3298:       if constexpr(ics == 1) {
 3299:          // XXXXXXX
 3300:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3301:       }
 3302:       else {
 3303:          side.coriolis = 2.0*omega_e*sin(sphi);
 3304:       }
 3305: 
 3306:    }
 3307: }
 3308: 
 3309: 
 3310: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3311:    double *node_coords, double *node_coords_ll, bool use_ll,
 3312:    double *wind_rotate_angle,   
 3313:    int *isdel, int *isidenode, int *isbnd,
 3314:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3315:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3316:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3317:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3318:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3319:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3320:    double *drag, double *roughness) {
 3321: 
 3322:    ELEM(pelem);
 3323:    Element &elem(*pelem);
 3324:    const int i = idx_elem;
 3325: 
 3326:    elem.idx = i;
 3327: 
 3328:    for (int j = 0; j < i34[i]; j++) {
 3329:       const int idxNode = elnode[i*4 + j];  
 3330:       const int idxSide = elside[i*4 + j];
 3331:       
 3332:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3333:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3334: 
 3335:       // Find the neighboring element  
 3336:       if (elem.sides[j]->elems[0] == &elem) {
 3337:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3338:       }
 3339:       else {
 3340:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3341:       }
 3342:       
 3343:    }
 3344: 
 3345:    elem.i34 = i34[i];
 3346: 
 3347:    // Compute the centroid of the element and its depth
 3348:    Vector2 center = {0.0, 0.0};
 3349:    elem.depth = 0.0;
 3350:    for (int j = 0; j < i34[i]; j++) {
 3351: 
 3352: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3353: 
 3354: 
 3355:       center += elem.nodes[j]->p/i34[i];
 3356:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3357:    }
 3358:    elem.center = center;
 3359: 
 3360:    
 3361:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3362:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3363: 
 3364:    elem.area = elem.computeSignedArea(); 
 3365:    elem.radius = sqrt(elem.area)/pi; 
 3366:    
 3367:    // Determines which way the normal vector to each side is oriented.
 3368:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3369:    for (int j = 0; j < i34[i]; j++)  
 3370:    {
 3371:       if (elem.sides[j]->elems[0] == &elem) {
 3372:          elem.ssign[j] =  1.0;
 3373:       }
 3374:       else {
 3375:          elem.ssign[j] = -1.0;
 3376:       }
 3377: 
 3378:    }
 3379: 
 3380:    // Derivatives of shape functions
 3381:    //  For ics=2, this is done inside element/ll frame XXX
 3382:    //  For quads, the derivative is evaluated at centroid
 3383:    for (int j = 0; j < elem.i34; j++) {
 3384:       const double area = elem.area;
 3385:       const int id2 = elem.nxq(1 + j);
 3386:       const int id3 = elem.nxq(2 + j);
 3387:       const int id4 = elem.nxq(3 + j);
 3388:       if (elem.isTri()) {
 3389:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3390:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3391:          // da1/dx = (y1 - y2)/(2*area)
 3392:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3393:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3394:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3395:       }
 3396:       else  { // Quad; evaluate at centroid
 3397:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3398:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3399:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3400:       } // if Tri
 3401: 
 3402:    } // for j   
 3403:    
 3404:    
 3405: 
 3406: }
 3407: 
 3408: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3409:                                             double *emo, double *efa, 
 3410:                                             double *umo, double *ufa, 
 3411:                                             double *vmo, double *vfa) {
 3412: 
 3413: 
 3414:    NODE_BND(nodeBnd);
 3415:    const int idx = idx_node_bnd;    
 3416: 
 3417:    nodeBnd->idx = idx;
 3418: 
 3419:    // Need to find the segment index and the index of the node on the segment
 3420:    int idxNode = -1;
 3421:    int iseg, i;
 3422:    for (iseg = 0; iseg < nope; iseg++) {
 3423:       // for each segment...
 3424:       for (i = 0; i < nond[iseg]; i++) {
 3425:          idxNode = iond[iseg + i*nope];
 3426:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3427:          
 3428:       }
 3429:    }
 3430: 
 3431:    assert(iseg < nope && "iseg is out of bounds");
 3432: 
 3433: found: // Jumped here when the node was found
 3434: 
 3435:    nodeBnd->isEssentialBC = true;
 3436:    nodeBnd->elbc = 0.0;
 3437: 
 3438:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3439: 
 3440:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3441:       nodeBnd->efa[jfr] = efa[idx2];
 3442:       nodeBnd->emo[jfr] = emo[idx2];
 3443:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3444:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3445: 
 3446:    }
 3447:         
 3448: 
 3449: }
 3450: 
 3451: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3452:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3453:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3454:                 int *isdel, int *isidenode, int *isbnd,
 3455:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3456:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3457:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3458:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3459:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3460:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3461:                 double *drag, double *roughness,
 3462:                 double *emo, double *efa, 
 3463:                 double *umo, double *ufa, 
 3464:                 double *vmo, double *vfa) {
 3465: 
 3466:    // printf("Populating mesh for partition %d\n", partNum);
 3467: 
 3468:    // XXXXXX THIS function does almost nothing. 
 3469: 
 3470:    nbs = *sharedIdxSideBoundary + 1;
 3471:    nbp = *sharedIdxNodeBoundary + 1;
 3472: 
 3473:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3474: 
 3475: }
