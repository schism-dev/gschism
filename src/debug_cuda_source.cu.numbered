 1807: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1808:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1809: }
 1810: 
 1811: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1812:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1813: }   
 1814: 
 1815: __device__ __inline__ double min3(double a, double b, double c) {
 1816:    return min(a, min(b, c));
 1817: }
 1818: 
 1819: __device__ __inline__ double max3(double a, double b, double c) {
 1820:    return max(a, max(b, c));
 1821: }
 1822: 
 1823: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1824:    return min(a, min(b, min(c, d)));
 1825: }
