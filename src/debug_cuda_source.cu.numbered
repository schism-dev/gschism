 4105: extern "C" {
 4106:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4107:                                   int* indices, int* indptr) {
 4108: 
 4109:       NODE(node);
 4110:       
 4111:       const int idx = node->idx;
 4112:       
 4113:       // Computes the index in the nzz array      
 4114:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4115: 
 4116: 
 4117:       indptr[idx] = nzzIdx;
 4118:       indices[nzzIdx] = idx;
 4119: 
 4120:       data_d[nzzIdx]    = node->coeffDiag;
 4121: 
 4122:       b_d[idx] = node->qel;
 4123: 
 4124:       for (int k = 0; k < node->numNodes; ++k) {
 4125:          const Node* nb = node->nodes[k];
 4126: 
 4127:          const int j = nb->idx;
 4128: 
 4129:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4130: 
 4131:          indices[nzzIdx + k + 1] = j;
 4132:       }
 4133: 
 4134:  
 4135:    }
