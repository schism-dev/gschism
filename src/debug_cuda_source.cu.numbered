 1356: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1357:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1358: }
 1359: 
 1360: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1361:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1362: }   
 1363: 
 1364: __device__ __inline__ double min3(double a, double b, double c) {
 1365:    return min(a, min(b, c));
 1366: }
 1367: 
 1368: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1369:    return min(a, min(b, min(c, d)));
 1370: }
