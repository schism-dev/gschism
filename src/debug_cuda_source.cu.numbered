 2581: 
 2582: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2583: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2584: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2585: 
 2586: //       if (delta != 0.0) {
 2587: //          // Solves the two linear equations for tt1 and tt2
 2588: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2589: //          const double tt2 = delta2/delta;
 2590: 
 2591: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2592: //          // Similarly, we use tt2 to compute the intersection point.
