 7148: __global__ void returnMatrix(double *res) {
 7149:    // Debugging: returns the matrix as a CuPy array
 7150: 
 7151:    const int size = mesh->np;
 7152:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7153:       const Node *node = mesh->localNodeData + idx_node;
 7154:       res[idx_node*size + idx_node] = node->coeffDiag;
 7155:       for (int j = 0; j < node->numNodes; j++) {
 7156:          Node* nbNode = node->nodes[j];
 7157:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7158:       }
 7159: 
 7160:    }
 7161:    
 7162: }
