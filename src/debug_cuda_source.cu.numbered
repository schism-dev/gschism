 7620: __global__ void returnMatrix(double *res) {
 7621:    // Debugging: returns the matrix as a CuPy array
 7622: 
 7623:    const int size = mesh->np;
 7624:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7625:       const Node *node = mesh->localNodeData + idx_node;
 7626:       res[idx_node*size + idx_node] = node->coeffDiag;
 7627:       for (int j = 0; j < node->numNodes; j++) {
 7628:          Node* nbNode = node->nodes[j];
 7629:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7630:       }
 7631: 
 7632:    }
 7633:    
 7634: }
