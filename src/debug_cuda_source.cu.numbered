  309: // Polynomial class
  310: template<int grade>
  311: struct Polynomial {
  312:     // Static assertion to give a clear error message at compile time
  313:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  314: };
  315: 
  316: 
  317: // Explicit specialization for grade 4
  318: template<>
  319: struct Polynomial<4> {
  320:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  321: 
  322:    // Constructor from coefficients
  323:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  324: 
  325:    __device__ __forceinline__ double eval(double x) const {
  326:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  327:    }
  328: };
