 2557: /**
 2558:  * This method performs backtracking from the side center until a time -dt back in time 
 2559:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2560:  * intermediate point.
 2561:  *
 2562:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2563:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2564:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2565:  * remaining time.
 2566:  * 
 2567:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2568:  * 
 2569:  * @param uuint, vvint, wwint: Velocities at the final point
 2570:  * @param jlev: Level at which the backtracking is performed
 2571:  * @param dt, dtbk: Tracking timesteps
 2572:  * @return: True if the backtracking was successful, false otherwise
 2573:  */
 2574: __inline__ __device__ bool Side::btrack(
 2575:       int jlev,
 2576:       double dt,            // Tracking time
 2577:       double dtbk,          // Tracking timestep
 2578:       Vector3 &u_int        // Velocities at the initial point
 2579: ) const {
 2580: 
 2581:    // Start from side center
 2582:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2583: double dt0 = dt; // XXXXX
 2584: Point3 x00 = x0;
 2585: const int oriJlev = jlev;
 2586:  
 2587:    double time_rm = dt; // Remaining time
 2588: 
 2589: 
 2590: 
 2591: 
 2592:    // Initial velocities
 2593:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2594: 
 2595:    // Find the element that is in the direction opposite to the velocity
 2596:    Element* curElem = findElementTowards(toVector2(u_int));
 2597:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2598: 
 2599: 
 2600:    // Nudges it towards the barycenter
 2601:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2602: 
 2603: 
 2604:    const int MAX_ITERATIONS = 1000; 
 2605:    Element* nextElem = nullptr;
 2606:    int iter = 0;
 2607:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2608:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2609:    while(true) {
 2610: 
 2611:       // Calculate timestep
 2612:       double dtb = min(dtbk, time_rm);
 2613: 
 2614:       // Next point in the backtracking curve
 2615:       xt = x0 - dtb*u_int;
 2616: 
 2617:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2618:       assert(found && "Backtracking failed in btrack");
 2619: 
 2620: 
 2621:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2622:                       // then time_rm needs to be increased by the unused time.
 2623: 
 2624:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2625: 
 2626:       // If the velocity is too small, we stop the backtracking
 2627:       const double vmag = length(toVector2(u_int));
 2628:       if (vmag <= velmin_btrack) break;
 2629: 
 2630:       // The current point becomes the next segment's starting point.
 2631:       x0 = xt;
 2632:  
 2633:       curElem = nextElem;
 2634: 
 2635:       iter++;
 2636: 
 2637:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2638:    }
 2639: 
 2640:    assert(!curElem->isDry && "Final element is dry");
 2641:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element");
 2642: 
 2643:    // Interpolate the velocities at the final point
 2644:    curElem->interpolateVelocities(xt, u_int);
 2645: 
 2646: 
 2647: }
 2648: 
 2649: 
