 7049:    __global__ void resetVelocityOpenBndNodes(void) {
 7050:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7051: 
 7052:       NODE_BND(nodebnd);
 7053: printf("DDDDDDDDDD\n");
 7054:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7055:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7056:       }
 7057: 
 7058:    }
