 7241:    __global__ void resetVelocityOpenBndNodes(void) {
 7242:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7243: 
 7244:       NODE_BND(nodebnd);
 7245: 
 7246:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7247:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7248:       }
 7249: 
 7250:    }
 7251: 
 7252: 
 7253:    __global__ void setVelocityOpenBndNodes(void) {
 7254:    // For open boundary nodes sets their velocity to the imposed values.
 7255: 
 7256:       SIDE_BND(sidebnd);
 7257: 
 7258:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7259:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7260:          // to its segment to the average of the side velocity.
 7261: 
 7262:          for (int k = 0; k < nvrt; k++) {
 7263:             Node *n1 = sidebnd->side->n1;
 7264:             Node *n2 = sidebnd->side->n2;
 7265: 
 7266: 
 7267:             Vector2 n1_u2(n1->u2[k]);
 7268:             Vector2 n2_u2(n2->u2[k]);
 7269: 
 7270:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7271:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7272:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7273:             }
 7274:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7275:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7276:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7277:             }
 7278: 
 7279:          }
 7280: 
 7281:       }
 7282: 
 7283:    }
 7284: 
 7285: 
 7286:    __global__ void computeVerticalVelocity(void) {
 7287:       // Computes the vertical velocity at the (2D) element's centroid.
 7288:       // In this function we will be considering volumetric elements, with side faces and a 
 7289:       // bottom and a top face. We will call them SFs, BF and TF.
 7290:       // It computes the flux coming from BF and the SFs.
 7291:       // If the bed is moving, it takes that into account.
 7292:       // Since water is incompressible, the integral of the velocity times the normal vector
 7293:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7294:       // and the BF is equal to the flux going out from the TF.
 7295:       // TF = - BF - sum(SFs).
 7296:       // It then computes the horizontal velocity at the center of TF.
 7297:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7298:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7299:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7300: 
 7301:       ELEM(elem);
 7302: 
 7303:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7304: 
 7305:       if (elem->isDry) return;
 7306: 
 7307:       const int kb = elem->kb;
 7308:       const bool isTri = elem->isTri();
 7309: 
 7310:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7311: 
 7312:       // Compute the bottom velocity
 7313:       if constexpr(imm != 0) {
 7314:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7315:       }
 7316: 
 7317: 
 7318:       double bottomArea3D;
 7319:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7320: 
 7321:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7322: 
 7323:       double topArea3D;
 7324: 
 7325:       // Bottom face flux
 7326:       double bottomFlux = 0.0;
 7327:       Vector2 u2meanBottom = {0.0, 0.0};
 7328:       const Vector2 gradh = elem->grad2(&Node::depth);
 7329:       if constexpr(imm==2) {
 7330:          Vector3 ubed;
 7331: 
 7332:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7333:          // updateBDEF(ubed);
 7334:      
 7335:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7336: 
 7337:          // elem->w[kb] += ubed.z;
 7338:       }
 7339:       else {
 7340: 
 7341: 
 7342:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7343:   
 7344:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7345:          // in the direction of motion.
 7346:          const double bottomW = - dot(gradh, u2meanBottom);  
 7347:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7348: 
 7349:          // VElocity associated to the bed deformation
 7350:          double bedVelocity = 0.0;
 7351:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7352: 
 7353:          elem->w[kb] = bedVelocity + bottomW; 
 7354: 
 7355:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7356:          
 7357:       } // if imm
 7358: 
 7359:       // Compute w for kb+1 to nvrt-1
 7360:       for (int l = kb; l < nvrt - 1; l++) {
 7361: 
 7362:          // normal vector to the top face of the "volumetric" element (3D)
 7363:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7364: 
 7365:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7366:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7367: 
 7368:          // Compute the total flux at the sides
 7369:          double sideFlux = 0.0;
 7370: 
 7371:          for (int j = 0; j < elem->i34; j++) {
 7372:             const Side *side = elem->sides[j];
 7373:             const int kbs = side->kb;
 7374:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7375:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7376:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7377: 
 7378:             // The area is "clamped" meaning that it takes kb into account.
 7379:             const double sideArea = side->areaClamped(l);
 7380: 
 7381:             const double sign = elem->ssign[j]; 
 7382: 
 7383:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7384:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7385:          }
 7386:          
 7387:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7388:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7389:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7390: 
 7391:          // The flux at the top ace can be computed from the other flows.
 7392:          // All fluxes are in directions into the prism.
 7393:          const double topFlux = - sideFlux - bottomFlux;
 7394: 
 7395:          // Flux at the top face due to the horizontal velocities only
 7396:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7397: 
 7398:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7399:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7400: 
 7401:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7402: 
 7403:          bottomFlux = -topFlux;
 7404:       }
 7405:    }  
 7406: 
 7407: 
 7408: 
 7409: 
 7410: 
 7411: 
 7412: 
 7413: // !===============================================================================
 7414: // !===============================================================================
 7415: 
 7416: } // extern "C"
 7417: 
 7418: #ifdef DONTCOMPILE
 7419: __device__ void computeVerticalAdvection(void) {
 7420:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7421: 
 7422:    sdbt(1:2,:,:)=0.d0
 7423: 
 7424:    const Side *side = FROM kernel;
 7425: 
 7426:    if(side->isDry) return;
 7427: 
 7428:    // If side is wet...
 7429: 
 7430: 
 7431:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7432:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7433:    double ws[nvrt] = {} // w @ side
 7434:    int icount = 0;
 7435:    for (int j=0; j<2; j++) {
 7436:       const Element *elem = side->elements[j];
 7437:        
 7438:       if(elem != nullptr) {
 7439:          icount++;
 7440:          for (int k=0; k<nvrt; k++) {
 7441:             ws[k] = ws[k] + elem->w[k];
 7442:          }
 7443:       }
 7444:    }  // for j
 7445: 
 7446:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7447:    ws = ws/icount;
 7448: 
 7449:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7450:    // Splines allow for a smooth transition between vertical levels.
 7451:    // Splines have continuity restrictions at the internal knots, but
 7452:    // we have to provide the 1st derivatives at the endpoints.
 7453:    const int kbs = side->kbs; 
 7454:    
 7455:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7456:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7457:    initCubicSpline(kbs, nvrt, side, ws, up)
 7458: 
 7459:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7460:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7461:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7462: 
 7463:    // Total advection (average onto side)
 7464:    const Node *node1 = side->nodes[0];
 7465:    const Node *node2 = side->nodes[1];
 7466:    for (int k=kbs(i); k<nvrt; k++) {
 7467: 
 7468:       Vector2 bcc1 = node1->bcc[k];
 7469:       Vector2 bcc2 = node2->bcc[k];
 7470:       if constexpr(ics == 2) {
 7471:          // Project the velocities from the node frames to the side frame
 7472:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7473:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7474:       }
 7475: 
 7476:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7477:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7478: 
 7479:    }
 7480: }
 7481: #endif
 7482: 
 7483: 
 7484: extern "C" {
 7485:    __global__ void computeElemAverageGhat(void) {
 7486:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7487: 
 7488:       ELEM(elem);
 7489:       
 7490:       elem->ghat1= {0.0, 0.0};  
 7491: 
 7492:       if constexpr(ihydraulics != 0) {
 7493:          if (nhtblocks > 0 && elem->isblock) return;
 7494:       }
 7495: 
 7496:       
 7497:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7498:       // cff1-3: coefficients for 2D/3D
 7499: 
 7500:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7501:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7502:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7503: 
 7504:       if (elem->isDry) return;
 7505: 
 7506:       // Average of the coefficients
 7507:       double av_cff1 = 0.0;  // av. for cff1
 7508:       double av_cff2 = 0.0;  // av. for cff2
 7509:       double av_cff3 = 0.0;  // av. for cff3
 7510:       double av_df = 0.0;  // av. for H^\alpha / H
 7511:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7512:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7513: 
 7514:       const int i34 = elem->i34;
 7515:       const int kb  = elem->kb;
 7516: 
 7517:       for (int j=0; j<i34; j++) {
 7518:          // For each node and side in the element...
 7519: 
 7520:          const Node *node = elem->nodes[j];
 7521:          const Side *side = elem->sides[j];
 7522: 
 7523:          const double chi      = side->chi;
 7524:          const double veg_c2   = side->veg_c2;
 7525:          const double veg_beta = side->veg_beta;
 7526:          const double veg_h    = side->veg_h();
 7527:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7528: 
 7529:          const Vector2 gradPhi = elem->gradPhi[j];
 7530: 
 7531:          // Node - const in elem
 7532:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7533:          elem->gradPr  += node->pr  *gradPhi;
 7534: 
 7535:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7536: 
 7537:         
 7538:          const double htot  = side->htot2();        // Total depth at the side
 7539:          const double zctr2 = side->zTopCanopy();  
 7540: 
 7541:          double cff1; 
 7542:          double cff2; 
 7543:          double cff3;   
 7544:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7545:          // coefficients applied to 2D/3D case 
 7546:             cff1 = side->hhat/htot;
 7547:             cff2 = 0.0;
 7548:             cff3 = 0.0;
 7549:          } else { //3D
 7550:             //Init for no-veg case
 7551:             cff1 = 1.0;
 7552:             cff2 = 1.0;
 7553:             cff3 = 0.0;
 7554: 
 7555:             if constexpr(iveg != 0) {
 7556:                // Computes coefficients used with vegetation terms G1, G2
 7557:                // cff1, cff3 are used for the first two terms in G1, G2:
 7558:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7559:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7560:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7561:                if(veg_h < 0.99*htot) { // submergent vegetation
 7562:                   cff1 = 1.0;
 7563:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7564:                   cff3 = veg_c;
 7565: 
 7566:                } else { // emergent vegetation
 7567:                   cff1 = 1.0/(1.0 + veg_c2);
 7568:                   cff2 = cff1;
 7569:                   cff3 = 0.0;
 7570: 
 7571:                }
 7572:             } // if iveg
 7573:          } //  2D/3D
 7574: 
 7575:          av_cff1 += cff1/i34;
 7576:          av_cff2 += cff2/i34;
 7577:          av_cff3 += cff3/i34;
 7578:          av_cff2_chi += cff2*chi/i34;
 7579:          av_cff3_chi += cff3*chi/i34;
 7580:          av_df += min(htot, veg_h)/(htot*i34);
 7581: 
 7582: 
 7583:          // btrack values: U^\star, U^{\star\alpha}
 7584:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7585:          Vector2 Ustar       = {0.0, 0.0}; 
 7586:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7587: 
 7588:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7589:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7590:          } else { //3D
 7591:             for (int k = side->kb + 1; k < nvrt; k++) {
 7592:             
 7593:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7594:                Ustar += w2;
 7595: 
 7596:                if constexpr(iveg != 0) {
 7597:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7598:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7599:                        Ustar_alpha += zrat*w2; // XXXX
 7600:                    }
 7601:                }  // if iveg
 7602:             }  // for k
 7603:          }  //2D/3D
 7604: 
 7605:          // If needed, project the side velocities to the element frame
 7606:          if constexpr(ics==2) {
 7607:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7608:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7609:          }
 7610:         
 7611: 
 7612:          // Add btrack & surface stress terms to \breve{G} first
 7613:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7614: 
 7615: 
 7616:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7617:          Vector2 tau    = side->tau();  
 7618:          Vector2 ubstar = side->btu[side->kb + 1];  
 7619: 
 7620:          // If needed, project tau and ubstar to the element frame
 7621:          if constexpr(ics==2) {
 7622:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7623:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7624:          }
 7625: 
 7626:          // Term for surface and bottom stress
 7627:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7628: 
 7629: 
 7630:          // All terms in F,F^\alpha,f_b except baroclinic
 7631:          // F, f_b: all explicit terms excluding vegetation 
 7632:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7633:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7634:          const double coriolis = side->coriolis;
 7635:          Vector2 F  =  coriolis*side->U;  // F_x
 7636:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7637:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7638: 
 7639:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7640:             
 7641:             for (int k = side->kb; k < nvrt; k++) {
 7642:                if (zctr2 > side->zc[k-1]) {
 7643:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7644:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7645:                    Fa +=  coriolis*w2*zrat;
 7646:                } // if zctr2
 7647:             } // k
 7648:          } // iveg
 7649: 
 7650:          // Integrate horizontal viscosity force vertically
 7651:          for (int k=side->kb + 1; k<nvrt; k++) {
 7652:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7653: 
 7654:             F += levelHorVisc;
 7655: 
 7656:             // Vegetation term
 7657:             if constexpr(iveg!=0) {
 7658:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7659:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7660:                   Fa += levelHorVisc*zrat;
 7661:                } 
 7662:             } // if iveg
 7663:          } // for k
 7664: 
 7665:          // Get nu*grad(U) at the side's bottom level
 7666:          Vector2 nuGradU = side->nuGradU[side->kb];
 7667: 
 7668:          fb += nuGradU;
 7669: 
 7670:          // If needed, project vectorsF, fb and Fa to the element frame
 7671:          if constexpr(ics==2) {
 7672:             F    = side->frame.projHorVec(F,    elem->frame);
 7673:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7674:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7675:          } // if ics
 7676: 
 7677:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7678:       } // for j (nodes and sides)
 7679: 
 7680:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7681: 
 7682: 
 7683:       // Finish off terms in F, F^\alpha and f_b
 7684:       const double grav3 = elem->mean(&Node::grav2);
 7685:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7686:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7687:       for (int j=0; j<i34; j++) { 
 7688:          // For each side in the element...
 7689:          const Side *side = elem->sides[j];
 7690:          const double chi = side->chi;
 7691: 
 7692:          const double htot = side->htot2();
 7693:          const double veg_h = side->veg_h();
 7694:          const Vector2 F  = htot*fb;
 7695:          const Vector2 Fa = min(htot, veg_h)*fb;
 7696: 
 7697:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7698:       } // for j
 7699: 
 7700:       // tmp is already in elem frame
 7701:       elem->ghat1 += tmp/i34;
 7702: 
 7703:       // Baroclinic force
 7704:       if constexpr(ibc==0) {
 7705:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7706: 
 7707:          Vector2 Fa = {0.0, 0.0};
 7708:          Vector2 intGradRho = {0.0, 0.0};
 7709:          
 7710:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7711:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7712:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7713: 
 7714:             // \in F [m^2/s/s]
 7715:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7716:          }
 7717: 
 7718:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7719:          const Vector2 F = av_df*Fa; //approx
 7720:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7721: 
 7722:       } // if ibc
 7723: 
 7724: 
 7725: 
 7726:    }
 7727: 
 7728: } // extern "C"
 7729: 
 7730: 
 7731: 
 7732: #ifdef DONTCOMPILE
 7733: __global__ void checkMassConservation(Tracers* sumtr) {
 7734: 
 7735:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7736: 
 7737:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7738: 
 7739:    Element *elem = &(mesh->localElemData[i]);
 7740: 
 7741:    // Skip dry elements
 7742:    if (elem->isDry) return;
 7743: 
 7744:    // Local sum array for this thread
 7745:    double localSum[N_TRACERS] = {0.0};
 7746: 
 7747:    // Sum over vertical levels for this element
 7748:    const int kbe = elem->kbe;
 7749:    const double area = elem->area;
 7750: 
 7751:    for (int k = kbe; k < nvrt; k++) {
 7752:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7753:       
 7754:       // Accumulate tracer mass
 7755:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7756:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7757:       }
 7758:    }
 7759: 
 7760:    //  This function returns per element sums. A reduction must be done on the host side.
 7761: }
 7762: 
 7763: 
 7764: __global__ void transport(void) {
 7765: 
 7766:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7767: 
 7768:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7769: 
 7770:    Element *elem = &(mesh->localElemData[ie]);
 7771: 
 7772:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7773: 
 7774:                for (int m=0; m<ntr; m++) {
 7775:                   for (int k=kbe(ie); k<nvrt; k++) {
 7776:                      // Calculate each polynomial's weight 
 7777:                      wm=0.d0; sum1=0.d0; 
 7778:                      wm1=0.d0; wm2=0.d0; 
 7779:                      for (int i=0; i<elem->nweno2; i++) {
 7780:                   
 7781:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7782:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7783:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7784:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7785:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7786:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7787:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7788:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7789:                      // -----------------Hu and Shu (1999)'s method----------------
 7790:                      b4=b1+b2+b3
 7791: 
 7792: //Error: add PRODUCTION CPP
 7793: #ifdef DEBUG
 7794:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7795:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7796:                     call parallel_abort(errmsg)
 7797:                   }
 7798: #endif
 7799: 
 7800:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7801:                   // !----test-------------- 
 7802:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7803:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7804:                   // !wm(i)=wm1(i)*wm2(i)
 7805:                   // !---------------------- 
 7806:                   sum1=sum1+wm(i)
 7807:                 } // end for i
 7808: 
 7809:                 wm=wm/sum1
 7810: 
 7811:                 for (int j=0; j<elem->i34; j++) {
 7812: 
 7813:                   const Side *side  = elem->sides[j];
 7814:                   const Node *node1 = side->n1;
 7815:                   const Node *node2 = side->n2;
 7816: 
 7817:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7818:                      trsd=0.d0
 7819:                      for (int kk=0; kk<nquad; kk++) {
 7820:                         for (int i=0; i<elem->nweno2; i++) {
 7821:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7822:                         } // end for i   
 7823:                      } // end for kk
 7824:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7825:                   } // outward flux
 7826:                } // end for j=1,i34(ie) ! side
 7827:             }
 7828:          }
 7829:               
 7830: 
 7831: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7832: //             //   calculate each polynomial's weight 
 7833: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7834: //                 wm=0.d0; sum1=0.d0
 7835: //                 do i=1,nweno1(ie) !for each polynomial
 7836: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7837: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7838: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7839: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7840: //                   wm(i)=b2
 7841: //                   sum1=sum1+b2
 7842: //                   !wm(i)=1.d0
 7843: //                   !sum1=sum1+1.d0
 7844: 
 7845: // // Error: PRODUCTION
 7846: // #ifdef DEBUG
 7847: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7848: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7849: //                     call parallel_abort(errmsg)
 7850: //                   endif
 7851: // #endif
 7852: 
 7853: //                 enddo !i
 7854: //                 wm=wm/sum1 !final weight
 7855: 
 7856:                 for (int j=0; j<elem->i34; j++) { // side
 7857:                   const Side *side = elem->sides[j];
 7858:                   const Node *node1 = side->n1;
 7859:                   const Node *node2 = side->n2;
 7860: 
 7861:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7862:                     trsd=0.d0
 7863:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7864:                       for (int i=0; i<elem->nweno1; i++) {
 7865:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7866:                       }
 7867:                     enddo //kk
 7868:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7869:                   } // outward flux
 7870:                 } // end for j=1,i34(ie) ! side
 7871:               } // end for k; ntr 
 7872: 
 7873:             else !simple upwind method
 7874:               do j=1,i34(ie)
 7875:                 jsj=elside(j,ie)
 7876:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7877:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7878:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7879:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7880:                   endif
 7881:                 enddo  !vertical layers
 7882:               enddo !j=1,i34(ie) ! side
 7883:             endif !order of accuracy
 7884: 
