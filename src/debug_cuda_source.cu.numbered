 1795:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1796:       // Compute the different time ramps used in the code 
 1797:       // This function is performed by just one thread
 1798: 
 1799:       rampbc = 1.0;
 1800:       if constexpr(ibc == 0) {
 1801:          if (drampbc > 0.0) {
 1802:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1803:          } else {
 1804:             rampbc = 1.0;
 1805:          }
 1806:       }
 1807: 
 1808:       if (nws != 0) {
 1809:          if (drampwind > 0.0) {
 1810:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1811:          } else {
 1812:             rampwind = 1.0;
 1813:          }
 1814:       }
 1815: 
 1816:       if (drampwafo > 0.0) {
 1817:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1818:       } else {
 1819:          rampwafo = 1.0;
 1820:       }
 1821: 
 1822:       // For source/sinks
 1823:       if (if_source && dramp_ss > 0.0) {
 1824:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1825:       } else {
 1826:          ramp_ss = 1.0;
 1827:       }
 1828: 
 1829:       if (dramp > 0.0) {
 1830:          ramp = tanh(2.0*time/86400.0/dramp);
 1831:       } else {
 1832:          ramp = 1.0;
 1833:       }
 1834: 
 1835: 
 1836:    }
