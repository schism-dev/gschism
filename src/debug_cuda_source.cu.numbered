  268: // Simple math functions ---------------------------------------------------------------------------
  269: 
  270: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  271: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  272: // Outputs:
  273: //        x1: first solution
  274: //        x2: second solution
  275: 
  276:        // Use float-specific absolute value for speed on GPU
  277:     const double absA = fabs(A);
  278:     const double absB = fabs(B);
  279: 
  280:     // 1. Near-linear case: a is effectively 0.
  281:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  282:     // This branch is almost never taken, so it won't hurt performance.
  283:     if (absA < 1e-14 * (absB + 1e-30)) {
  284:         const double x = -C / B;
  285:         x1 = x;
  286:         x2 = x;
  287:         return;  // Degenerate case: A = 0.
  288:     }
  289: 
  290:    const double delta = max(0.0, B*B - 4.0*A*C);
  291: 
  292:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  293:    const double s = sqrt(delta);
  294: 
  295:    // Numerically stable quadratic roots:
  296:    // q = -0.5*(B + sign(B)*sqrt(delta))
  297:    const double q = -0.5 * (B + copysign(s, B));
  298: 
  299:    x1 = q/A;
  300:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  301: 
  302: }
