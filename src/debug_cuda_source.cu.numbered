  752: 
  753:    __device__ double interpolate(const ShapeCoords &shapeCoords, const ShapeCoords &zAtNodes) const
  754:    {
  755:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  756:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  757:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  758:       
  759:    }
  760: 
  761:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  762: 
  763:    // ------------------------------------------------------------------------------------------------
  764:    // These are functions that work on all nodes of the element.
  765:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  766:    //
  767:    // An example of how to use these functions is:
  768:    //   
  769:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  770:    // 
  771:    // Where L is the level at which the field is to be interpolated. The field can be either
  772:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  773:    // There are different versions of getNodalValues for each of these cases.
  774: 
  775:    template<typename T>
  776:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  777:       // Get the values of the field at the nodes of the element
  778:       res[0] = nodes[0]->*field;
  779:       res[1] = nodes[1]->*field;
  780:       res[2] = nodes[2]->*field;
  781:       if (isQuad()) res[3] = nodes[3]->*field;
  782:       else          res[3] = T();
  783:    }
  784: 
  785:    template<typename T>
  786:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  787:       // Get the values of the field at the nodes of the element
  788:       res[0] = (nodes[0]->*field)[level];
  789:       res[1] = (nodes[1]->*field)[level];
  790:       res[2] = (nodes[2]->*field)[level];
  791:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  792:       else          res[3] = T();
  793:    }    
  794: 
  795:    template<typename T>
  796:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  797:       // Get the values of the func at the nodes of the element
  798:       res[0] = (nodes[0]->*func)(level);
  799:       res[1] = (nodes[1]->*func)(level);
  800:       res[2] = (nodes[2]->*func)(level);
  801:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  802:       else          res[3] = T();  // This is 0.0 or a zero vector
  803: 
  804:    }      
  805: 
  806:    template<typename T>
  807:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  808:       // Get the values of the field at the nodes of the element
  809:       res[0] = sides[0]->*field;
  810:       res[1] = sides[1]->*field;
  811:       res[2] = sides[2]->*field;
  812:       if (isQuad()) res[3] = sides[3]->*field;
  813:       else          res[3] = T();
  814:    }
  815: 
  816:    template<typename T>
  817:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  818:       // Get the values of the field at the nodes of the element
  819:       res[0] = (sides[0]->*field)[level];
  820:       res[1] = (sides[1]->*field)[level];
  821:       res[2] = (sides[2]->*field)[level];
  822:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  823:       else          res[3] = T();
  824:    }    
  825: 
  826:    template<typename T>
  827:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  828:       // Get the values of the func at the nodes of the element
  829:       res[0] = (sides[0]->*func)(level);
  830:       res[1] = (sides[1]->*func)(level);
  831:       res[2] = (sides[2]->*func)(level);
  832:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  833:       else          res[3] = T();  // This is 0.0 or a zero vector
  834: 
  835:    }      
  836: 
  837:    template<typename T>
  838:    __device__ T interpolate(int level, const ShapeCoords shapeCoords, T (Node::*func)(int) const) const {
  839:       T values[4];
  840:       getNodalValues(level, func, values);
  841: 
  842:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  843:    }
  844: 
  845:    template<typename T>
  846:    __device__ T interpolate(const ShapeCoords shapeCoords, T Node::* field) const {
  847:       T values[4];
  848:       getNodalValues(field, values);
  849:       
  850:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  851:    }
  852: 
  853: 
  854:    template<typename T>
  855:    __device__ T interpolate(int level, const ShapeCoords shapeCoords, T (Node::* field)[nvrt]) const {
  856:       T values[4];
  857:       getNodalValues(level, field, values);
  858: 
  859:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  860:    }
  861: 
  862:    template<typename T>
  863:    __device__ T mean(T Node::* field) const {
  864:       T values[4];
  865:       getNodalValues(field, values);
  866: 
  867:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  868: 
  869:       return (values[0] + values[1] + values[2] + values[3])/i34;
  870:    }
  871: 
  872:    template<typename T>
  873:    __device__ T mean(T Side::* field) const {
  874:       T values[4];
  875:       getSideValues(field, values);
  876:       
  877:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  878: 
  879:       return (values[0] + values[1] + values[2] + values[3])/i34;
  880:    }   
  881: 
  882:    template<typename T>
  883:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  884:       T values[4];
  885:       getNodalValues(level, field, values);
  886: 
  887:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  888: 
  889:       return (values[0] + values[1] + values[2] + values[3])/i34;
  890:    }
  891: 
  892:    template<typename T>
  893:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  894:       T values[4];
  895:       getSideValues(level, field, values);
  896:       
  897:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  898: 
  899:       return (values[0] + values[1] + values[2] + values[3])/i34;
  900:    }   
  901: 
  902:    // __device__ double mean(double (Node::*func)(int) const) const {
  903:    //    double values[4];
  904:    //    getNodalValues(level, func, values);
  905:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  906:    // }
  907:    // ------------------------------------------------------------------------------------------------
  908: 
  909:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  910:       // Convert global coordinates to local coordinates
  911:       printf("NOT IMPLEMENTED: globalToLocal\n");
  912:       return true;
  913:    }
  914: 
  915:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  916:       // Convert local coordinates to global coordinates
  917:       printf("NOT IMPLEMENTED: localToGlobal\n");
  918:       return true;
  919:    }
  920: 
  921:  
  922: };
