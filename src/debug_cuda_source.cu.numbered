 4366: 
 4367: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4368:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4369:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4370: 
 4371: 
 4372:    NODE(node1);
 4373: 
 4374:    node1->clearMatrixRow();
 4375:    node1->qel = 0.0;
 4376: 
 4377:    // THIS IS FOR STRUCTURES XXX
 4378:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4379: 
 4380:    
 4381:    for (int j=0; j<node1->numElements; j++) {
 4382:       // For each element connected to the node...
 4383: 
 4384:       Element *elem = node1->elements[j];
 4385: 
 4386: 
 4387: 
 4388:       // Compute the average gravity
 4389:       const double grav3 = elem->mean(&Node::grav2);
 4390: 
 4391:       // Look at the documentation for the description of the terms in the following integrals
 4392: 
 4393:       // Integral I_1 
 4394:       // \bar{\breve{H}} 
 4395:       const double hhatb = elem->mean(&Side::hhat);        
 4396: 
 4397:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4398: 
 4399:       const int id1 = elem->nodeLocalIdx(node1); 
 4400:       const double area = elem->area;
 4401: 
 4402:       if (elem->isTri()) {
 4403: 
 4404:          // To clarify the notation in this section: 
 4405:          //   i stands for the node under consideration (node1)
 4406:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4407:          const int id2 = elem->nxq(1 + id1);
 4408:          const int id3 = elem->nxq(2 + id1);
 4409:          Node *node2 = elem->nodes[id2];
 4410:          Node *node3 = elem->nodes[id3];
 4411: 
 4412:          Point2 x1, x2, x3;
 4413:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4414: 
 4415: 
 4416:          // integral of phi_i*phi_j
 4417:          const double ipp_ii = (1.0/6.0 )*area;
 4418:          const double ipp_ij = (1.0/12.0)*area;
 4419:          const double ipp_ik = (1.0/12.0)*area;
 4420: 
 4421:          // integral of [(grad phi_i) * (grad phi_j)]
 4422:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4423:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4424:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4425: 
 4426:          // Computes the different components of integral I_1 of each node with respect to node i.
 4427:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4428:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4429:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4430: 
 4431:          node1->addToSparseMatrix(node1, I1_ii);
 4432:          node1->addToSparseMatrix(node2, I1_ij); 
 4433:          node1->addToSparseMatrix(node3, I1_ik);
 4434: 
 4435:       }
 4436:       else { // Quad
 4437:          // XXX IMPLEMENT THIS
 4438:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4439: 
 4440:          // // To clarify the notation in this section: 
 4441:          // //   i stands for the node under consideration (node1)
 4442:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4443:          // const int id2 = elem->nxq(1 + id1);
 4444:          // const int id3 = elem->nxq(2 + id1);
 4445:          // const int id4 = elem->nxq(3 + id1);
 4446:          // Node *node2 = elem->nodes[id2];
 4447:          // Node *node3 = elem->nodes[id3];
 4448:          // Node *node4 = elem->nodes[id4];         
 4449: 
 4450:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4451:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4452:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4453:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4454:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4455: 
 4456:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4457:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4458:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4459:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4460:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4461: 
 4462:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4463:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4464:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4465:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4466:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4467: 
 4468:          // node1->addToSparseMatrix(node1, I1_ii);
 4469:          // node1->addToSparseMatrix(node2, I1_ij); 
 4470:          // node1->addToSparseMatrix(node3, I1_ik);
 4471:          // node1->addToSparseMatrix(node4, I1_il);
 4472:   
 4473:       } 
 4474: 
 4475:  
 4476:       // Integral I_4
 4477:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4478:       // Where
 4479:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4480: 
 4481:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4482:       // of U over the element.
 4483:       Vector2 U = {0.0, 0.0};
 4484:       for (int m=0; m < elem->i34; m++) {      
 4485:          const Side *side = elem->sides[m];
 4486: 
 4487:          if constexpr(ics == 1) U += side->U; 
 4488:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4489: 
 4490:       }
 4491:       U = U/elem->i34;
 4492: 
 4493: 
 4494:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4495: 
 4496: 
 4497:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4498:       const double I_4_1 = dot(gradPhi_1, U);
 4499: 
 4500: 
 4501:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4502:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4503: 
 4504:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4505: 
 4506:       // Additional terms 
 4507:       double vnorm = 0.0;
 4508:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4509:          Vector3 ubed = {0.0, 0.0, 0.0};
 4510:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4511:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4512: 
 4513:          Vector3 gradP = {0.0, 0.0, 1.0};
 4514:          for (int m=0; m < elem->i34; m++) {
 4515:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4516:            gradP += toVector3(gradP_2D, 0.0);
 4517:          }   
 4518:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4519:       } // imm==2
 4520: 
 4521:       if (elem->isTri()) {
 4522:          for (int l=0; l<3; l++) {
 4523: 
 4524:             Node *node = elem->nodes[l];
 4525: 
 4526:             double fac = (node == node1) ? 2.0 : 1.0;
 4527:    
 4528:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4529:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4530:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4531:            
 4532:          }
 4533: 
 4534: 
 4535:          if (!elem->isDry) {
 4536:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4537: 
 4538:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4539: 
 4540:          }
 4541: 
 4542:       } // isTri
 4543:       else { // isQuad
 4544:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4545:          // for (int l=0; l<4; l++) {
 4546:          //   const Node *node = elem->nodes[l];
 4547: 
 4548:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4549:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4550: 
 4551:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4552:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4553:          // }
 4554: 
 4555:       } // isQuad
 4556: 
 4557: 
 4558:      node1->qel += (dt/elem->i34)*elem->vsource;
 4559:       
 4560: 
 4561:    } // for all elements connected to the node
 4562:    
 4563: 
 4564:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4565:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4566:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4567:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4568:       // If it is an open boundary node...
 4569: 
 4570:       // At least one open bnd side, maybe two
 4571:       for (int l=0; l<2; l++) { 
 4572: 
 4573:          // Gets each of the sides sharing the node. 
 4574:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4575: 
 4576:        
 4577: 
 4578:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4579:          if (sideBnd != nullptr) {
 4580:             // If the side is on a boundary...
 4581: 
 4582:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4583: 
 4584:             // Get the boundary segment
 4585:             const BoundarySegment *sideSegment = sideBnd->segment;
 4586:             const Side *side = sideBnd->side;
 4587: 
 4588:             // Integral I_3
 4589:             if (sideSegment->ifltype != 0) {
 4590:             // Natural or Flather b.c.
 4591: 
 4592:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4593:                // especially for Flather b.c.
 4594:                double ri3 = 0.0;
 4595:                if (!side->isDry) {
 4596:                   // If the side is not dry
 4597:                   
 4598:                   // Computes the side flux of (uth, vth)
 4599:                   double Vn = 0.0;
 4600:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4601:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4602:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4603: 
 4604:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4605:                   }
 4606: 
 4607:                   ri3 = 0.5*side->len*Vn;
 4608:                }
 4609: 
 4610:                if (sideSegment->ifltype == -1) { // Flather 1
 4611: 
 4612:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4613:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4614: 
 4615:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4616:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4617:                   
 4618:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4619:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4620: 
 4621:                } 
 4622:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4623:                   // Reset ri3
 4624:                   ri3 = 0.0;
 4625: 
 4626:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4627:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4628: 
 4629:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4630: 
 4631:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4632:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4633: 
 4634:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4635:                   node1->addToSparseMatrix(node1, con0*2.0);
 4636:                   node1->addToSparseMatrix(node2, con0);
 4637: 
 4638:                } // if Flather or Discharge
 4639: 
 4640:                node1->qel -= thetai*dt*ri3;  
 4641: 
 4642: 
 4643:             } // I_3
 4644:           
 4645: 
 4646:             // Integral I_5
 4647:             if(!side->isDry) {
 4648: 
 4649:                const double Unbar = dot(side->U, side->n);
 4650:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4651: 
 4652:             } // I_5
 4653: 
 4654:          } // if is boundary side
 4655: 
 4656:       } // for l
 4657: 
 4658:    } // if isbnd
 4659: 
 4660: 
 4661: }
 4662: 
 4663: 
 4664: 
 4665: extern "C" {
 4666:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4667:                                   int* indices, int* indptr) {
 4668: 
 4669:       NODE(node);
 4670:       
 4671:       const int idx = node->idx;
 4672:       
 4673:       // Computes the index in the nzz array      
 4674:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4675: 
 4676: 
 4677:       indptr[idx] = nzzIdx;
 4678:       indices[nzzIdx] = idx;
 4679: 
 4680:       data_d[nzzIdx]    = node->coeffDiag;
 4681: 
 4682:       b_d[idx] = node->qel;
 4683: 
 4684:       for (int k = 0; k < node->numNodes; ++k) {
 4685:          const Node* nb = node->nodes[k];
 4686: 
 4687:          const int j = nb->idx;
 4688: 
 4689:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4690: 
 4691:          indices[nzzIdx + k + 1] = j;
 4692:       }
 4693: 
 4694:  
 4695:    }
 4696: 
 4697: 
 4698: 
 4699:    __global__ void solverCopyResult(double* x) {
 4700:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4701:       NODE(node);
 4702:       const int idx = node->idx;
 4703: 
 4704:       node->mX = x[idx];
 4705:    }
 4706: 
 4707: 
 4708:    __global__ void rollUpElevation(void) {
 4709: 
 4710:       NODE(node);
 4711: 
 4712:       node->eta1 = node->eta2;
 4713: 
 4714:    }
 4715: 
 4716: 
 4717:    __global__ void backtrackAllNodes(void) {
 4718: 
 4719:       // max/min # of sub-divisions
 4720:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4721:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4722: 
 4723:       SIDE(side);
 4724: 
 4725:       const int kb = side->kb;
 4726: 
 4727: 
 4728:       // Initialize btrack velocities to the actual velocities at the side 
 4729:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4730:   
 4731:       if (side->isDry) return;
 4732:      
 4733: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4734: 
 4735:       // Checks that at least one element is not dry
 4736:       const Element *elem1 = side->elems[0];
 4737:       const Element *elem2 = side->elems[1];
 4738: 
 4739: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4740: 
 4741:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4742:       
 4743:       // XXXXXX
 4744:       // !swild_tmp to store global coord. of the starting side
 4745:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4746:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4747:       // !Use sframe2 
 4748:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4749: 
 4750: 
 4751:       for (int k = kb; k < nvrt; k++) {
 4752:       //  Initialize (xt,yt,zt), nnel and vel.
 4753:       //  For ics=2, the coordinates are all in the side's local frame
 4754:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4755: 
 4756:          const int iadvf = side->iadv();  // Advection flag   
 4757:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4758: 
 4759:          const double vmag2 = norm2(side->u2[k]);
 4760: 
 4761:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4762:             // No activity 
 4763: 
 4764:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4765: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4766: 
 4767:             
 4768:          } else {  // do btrack
 4769: 
 4770:             // Compute number of sub-divisions based on local gradients of the velocity field
 4771: 
 4772:             // XXX IS THIS NECESSARY?
 4773:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4774:             double suma = 0.0;
 4775:             int icount = 0;
 4776:             for (int l=0; l<2; l++) {
 4777:             // For each element sharing the side...
 4778: 
 4779:                const Element *elem = side->elems[l];
 4780:                  
 4781:                if (elem == nullptr) continue;
 4782: 
 4783:                icount++;
 4784: 
 4785:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4786:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4787:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4788: 
 4789:                double utmp[4];
 4790:                double vtmp[4];
 4791:                for (int j = 0; j < elem->i34; j++) {
 4792: 
 4793:                   const Node *node = elem->nodes[j];
 4794: 
 4795:                   if constexpr(ics==1) {
 4796:                      utmp[j] = node->u2[k].x;
 4797:                      vtmp[j] = node->u2[k].y;  
 4798: 
 4799:                   } else {
 4800:                      // 'Project' the velocity from the node frame to the element frame
 4801:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4802:                      utmp[j] = tmp_u2.x;
 4803:                      vtmp[j] = tmp_u2.y;
 4804: 
 4805:                   }
 4806:                } // for j
 4807: 
 4808:                const Vector2 grad_u = elem->grad2(utmp); 
 4809:                const Vector2 grad_v = elem->grad2(vtmp);
 4810:    
 4811:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4812:             } // for ii
 4813: 
 4814:             assert(icount > 0 && "Impossible 77");
 4815: 
 4816:             // '4' is somewhat arbitrary
 4817:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4818: 
 4819:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4820:             Vector3 u_int = {0.0, 0.0, 0.0};
 4821: 
 4822:             side->btrack(k, dt, dtbk, u_int);
 4823: 
 4824: 
 4825:             side->btu[k] = {u_int.x, u_int.y};
 4826:                
 4827:          } // if vmag (do backtrack)
 4828: 
 4829: 
 4830:       } // for k=kb,nvrt-1
 4831: 
 4832:    }
 4833: 
 4834: } // extern "C"
 4835: 
 4836: template<int nc>
 4837: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4838: 
 4839: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4840: //
 4841: // a,b,c,rhs: input vectors and are not modified by this program.
 4842: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4843: // rhs is the r.h.s.
 4844: // n: actual rank of the system.
 4845: // rows in u() and rhs();
 4846: // u: output with nc columns (transposed to rows)
 4847: // gam: a working array.
 4848: //
 4849: // NOTES:
 4850: // This is a template function that allows for different numbers of columns in the rhs vector.
 4851: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4852: 
 4853:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4854:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4855: 
 4856:    double bet = b[0];
 4857:    if constexpr (nc == 1) {
 4858:       u[0] = rhs[0]/bet;
 4859:    } else {
 4860:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4861:    }
 4862: 
 4863:    for (int j = 1; j < n; j++) {
 4864:       gam[j] = c[j - 1]/bet;
 4865:       bet = b[j] - a[j]*gam[j];
 4866: 
 4867:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4868: 
 4869:       if constexpr (nc == 1) {
 4870:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4871:       } else {
 4872:          for (int l = 0; l < nc; l++) {
 4873:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4874:          }
 4875:       }
 4876:    }
 4877: 
 4878:    // Back-substitution
 4879:    for (int j = n - 2; j >= 0; j--) {
 4880:       if constexpr (nc == 1) {
 4881:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4882:       } else {
 4883:          for (int l = 0; l < nc; l++) {
 4884:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4885:          }
 4886:       }
 4887:    }
 4888: }
 4889: 
 4890: 
 4891: 
 4892: // Helper function that contains the core algorithm
 4893: template<typename XAccessor, typename YAccessor>
 4894: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4895:                                     double  yp_top, double  yp_bot, 
 4896:                                     CubicSpline &spline) {
 4897:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4898:    // 
 4899:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4900:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4901:    //
 4902:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4903:    // 
 4904:    // Inputs: 
 4905:    //            n: dimension for x etc; # of data pts (>=2);
 4906:    //            getX, getY: functions to access x,y coordinates
 4907:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4908:    //     Output: 
 4909:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4910: 
 4911:    const int n = k2 - k1 + 1;
 4912:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4913: 
 4914:    // Allocate memory for the splines
 4915:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4916:    spline.x   = new double[n];
 4917:    spline.y   = new double[n];
 4918:    spline.yp  = new double[n];
 4919:    spline.ypp = new double[n];
 4920: 
 4921:    for (int k=k1; k<=k2; k++) {
 4922:       spline.x[k] = getX(k);
 4923:       spline.y[k] = getY(k);
 4924:    }
 4925: 
 4926:    // This is to simplify expressions later
 4927:    double *x = spline.x;
 4928:    double *y = spline.y;
 4929: 
 4930:    double *a = nullptr;
 4931:    double *b = nullptr;
 4932:    double *c = nullptr;
 4933:    double *gam = nullptr;
 4934:    double *rhs = nullptr;
 4935:    
 4936: 
 4937:       a = new double[n];   // Lower diagonal
 4938:       b = new double[n];   // Diagonal
 4939:       c = new double[n];   // Upper diagonal
 4940:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4941:       rhs = new double[n]; // Right-hand side
 4942: 
 4943:    for (int k=k1; k<=k2; k++) {
 4944:       if (k == k1) {
 4945:          // Bottom level
 4946:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4947:          b[k] = (x[k+1] - x[k])/3.0;
 4948:          c[k] = b[k]/2.0;
 4949:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4950:       } else if (k == n - 1) {
 4951:          // Top level (surface)
 4952:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4953:          b[k] = (x[k] - x[k-1])/3.0;
 4954:          a[k] = b[k]/2.0;
 4955:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4956:       } else {
 4957:          // Intermediate levels
 4958:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4959:          b[k] = (x[k+1] - x[k-1])/3.0;
 4960:          a[k] = (x[k  ] - x[k-1])/6.0;
 4961:          c[k] = (x[k+1] - x[k  ])/6.0;
 4962:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4963:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4964:       }
 4965:    }
 4966: 
 4967:    // Solve the tridiagonal system
 4968:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4969:    
 4970:    spline.yp[k1] = yp_bot;
 4971:    spline.yp[k2] = yp_top;
 4972: 
 4973:    // Compute rest of 1st derivatives using the splines
 4974:    for (int k=k1+1; k<k2; k++) {
 4975:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4976:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4977:    }
 4978:    
 4979:    delete[] a;
 4980:    delete[] b;
 4981:    delete[] c;
 4982:    delete[] gam;
 4983:    delete[] rhs;
 4984: 
 4985: }
 4986: 
 4987: // Array version
 4988: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4989:                                 double y_top, double y_bot, 
 4990:                                 CubicSpline &spline) {
 4991:    auto getX = [x] (int k) { return x[k]; };
 4992:    auto getY = [y] (int k) { return y[k]; };
 4993:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4994: }
 4995: 
 4996: // Lambda version - allows custom access patterns
 4997: template<typename XFunc, typename YFunc>
 4998: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4999:                                 double y_top, double y_bot,
 5000:                                 CubicSpline &spline) {
 5001:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5002: }
