 2776: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2777:                 double *node_coords, double *wind_rotate_angle, 
 2778:                 int *isdel, int *isidenode, int *isbnd,
 2779:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2780:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2781:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2782:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2783:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2784:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2785:                 double *emo, double *efa, 
 2786:                 double *umo, double *ufa, 
 2787:                 double *vmo, double *vfa) {
 2788: 
 2789:    printf("Populating mesh for partition %d\n", partNum);
 2790: 
 2791:    // Horizontal grid
 2792:    printf("Processing %d nodes\n", np);    
 2793: 
 2794: 
 2795:    int idxNodeBoundary = 0;  
 2796:    for (int i = 0; i < np; i++)
 2797:    {
 2798:       Node &node = localNodeData[i];
 2799: 
 2800:       node.idx = i;
 2801: 
 2802:       const int idxNodeStart = nodeNeighNodesStart[i];
 2803:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2804:       node.numNodes = idxNodeEnd - idxNodeStart;
 2805:       node.nodes = nodeNeighNodes + idxNodeStart;
 2806:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2807: 
 2808: 
 2809: 
 2810:       const int idxElemStart = nodeNeighElemsStart[i];
 2811:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2812:       node.numElements = idxElemEnd - idxElemStart;
 2813:       node.elements = nodeNeighElems + idxElemStart;
 2814: 
 2815: 
 2816:       
 2817:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2818:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2819:          const int partNode = localNodePart[idxNodeGlobal]; 
 2820:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2821: 
 2822: 
 2823:          Node *node_ptr = nodes[partNode] + idxNode;
 2824:          
 2825:          nodeNeighNodes[idx] = node_ptr;
 2826:       }
 2827: 
 2828:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2829:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2830:          const int partElem = localElemPart[idxElemGlobal];
 2831:          const int idxElem  = localElemIndices[idxElemGlobal];
 2832: 
 2833:          Element *elem_ptr = elems[partElem] + idxElem;
 2834: 
 2835:          nodeNeighElems[idx] = elem_ptr;
 2836:       }      
 2837: 
 2838: 
 2839:       node.wind_angle = wind_rotate_angle[i];
 2840: 
 2841:       // Element **elements; // pointer to the elements connected to this node
 2842:       // int numElements;   // number of elements shared by this node
 2843: 
 2844:       node.p.x   = node_coords[i * 3];
 2845:       node.p.y   = node_coords[i * 3 + 1];
 2846:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2847:       node.depth = node_coords[i * 3 + 2];
 2848: 
 2849:       node.numSides = 0;
 2850: 
 2851: printf("EEEEEE idx = %d, isbnd[i] = %d, node.nodeBnd = %p\n", i, isbnd[i], node.nodeBnd);
 2852:       // Links the node to the boundary information
 2853:       if (isbnd[i] >= 0) {
 2854:        
 2855:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2856:          node.nodeBnd->node = &node;
 2857: 
 2858:          node.nodeBnd->sideBnd1 = nullptr;
 2859:          node.nodeBnd->sideBnd2 = nullptr;
 2860: 
 2861:          if (isbnd[i]>=0) {
 2862: 
 2863:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2864:             
 2865:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2866:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2867: 
 2868:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2869:             node.nodeBnd->segment->clen  = nan("1");
 2870:             node.nodeBnd->segment->carea = nan("1");
 2871: 
 2872:          }
 2873: //          else {
 2874: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2875: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2876: //          }
 2877:          
 2878:          idxNodeBoundary++;
 2879: printf("EEEEEEhhhh idx = %d, isbnd[i] = %d, idxNodeBoundary = %d\n", i, isbnd[i], idxNodeBoundary);         
 2880:       }
 2881:       else {
 2882:          node.nodeBnd = nullptr; // For internal nodes
 2883: printf("EEEEEQQ isbnd[i] = %d, node.nodeBnd = %p\n", isbnd[i], node.nodeBnd); 
 2884:          if (isbnd[i] == landSegment) {
 2885:             node.nodeBnd = &landBoundaryNode;
 2886:             node.nodeBnd->segment = &landBoundarySegment;
 2887:          }
 2888:          // node.nodeBnd->node = &node;
 2889:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2890:          // // node.nodeBnd = nullptr;
 2891:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2892:         
 2893:       }
 2894: 
 2895:       // XXXX GAUSSIAN HILL VELOCITIES
 2896: #ifdef GAUSSIAN_HILL_VELOCITIES
 2897:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2898:          constexpr double rot_per = 3000.0;
 2899:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2900:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2901:       // XXXXX
 2902: #endif
 2903:    }
 2904: 
 2905:    nbp = idxNodeBoundary;
 2906: 
 2907:    printf("Processing %d sides\n", ns);
 2908:    int idxSideBoundary = 0;
 2909:    for (int i = 0; i < ns; i++)
 2910:    {
 2911:       Side &side = localSideData[i];
 2912:       side.idx = i;
 2913:       // finding the pointer to the nodes that form the side
 2914:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2915:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2916: 
 2917:       const int locidx_n1 = localNodeIndices[idx_n1];
 2918:       const int locidx_n2 = localNodeIndices[idx_n2];
 2919:       const int part_n1 =   localNodePart[idx_n1];
 2920:       const int part_n2 =   localNodePart[idx_n2];
 2921: 
 2922:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2923:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2924: 
 2925:       // Counts the number of sides connected to each node
 2926:       side.n1->numSides++;
 2927:       side.n2->numSides++;
 2928: 
 2929:       // Normal, unitary vector to the side
 2930:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2931:       side.n = normalize(side.n);
 2932: 
 2933:       // Side boundary type
 2934:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2935:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2936: 
 2937:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2938:       // If both nodes are on the boundary, then the side may be on the boundary
 2939:       {
 2940:          bool isLand = false;
 2941:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2942: 
 2943:          if (isbs > -1) {
 2944:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2945:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2946:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2947: 
 2948:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2949:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2950:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2951: 
 2952:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2953:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2954:           
 2955:             side.sideBnd->side = &side;
 2956:             idxSideBoundary++;
 2957: 
 2958:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2959:          }
 2960:          
 2961: 
 2962:       // }
 2963:       // 
 2964: 
 2965: 
 2966: 
 2967: 
 2968: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2969: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2970: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2971: //       {
 2972: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2973: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2974: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2975: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2976: // if (side.sideBnd->segment == nullptr) continue;
 2977: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2978: //          else                  side.sideBnd->segment = n2bnd->segment;
 2979: //          side.sideBnd->side = &side;
 2980: //          idxSideBoundary++;
 2981: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2982:       }
 2983:       else side.sideBnd = nullptr;
 2984: 
 2985:       nbs = idxSideBoundary;
 2986: // printf("Here3: %d", i);
 2987:       // finding the pointer to the elements that share the side
 2988:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2989:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2990: 
 2991:       if (idx_e1 > -1) {
 2992:          const int locidx_e1 = localElemIndices[idx_e1];
 2993:          const int part_e1 =  localElemPart[idx_e1];
 2994:          side.elems[0] = elems[part_e1] + locidx_e1;
 2995: 
 2996:       }
 2997:       else {
 2998:          side.elems[0] = nullptr;
 2999:       }
 3000: // printf("Here4: %d", i);
 3001:       if (idx_e2 > -1) {
 3002:          const int locidx_e2 = localElemIndices[idx_e2];
 3003:          const int part_e2 =  localElemPart[idx_e2];
 3004:          side.elems[1] = elems[part_e2] + locidx_e2;
 3005:       }
 3006:       else {
 3007:          side.elems[1] = nullptr;
 3008:       }
 3009: // printf("Here5: %d", i);
 3010: 
 3011: 
 3012:       // Compute the center of the side
 3013:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3014: 
 3015:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3016:       side.shapiro = shapiro0;
 3017: 
 3018: #ifdef GAUSSIAN_HILL_VELOCITIES
 3019: // XXXX
 3020: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3021: constexpr double rot_per=3000.0;
 3022: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3023: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3024: // XXXXX      
 3025: #endif
 3026:       // Compute the z level at the center of the side
 3027:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3028: 
 3029:       // Compute the length of the side
 3030:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3031:       side.len = sqrt(dot(vLen, vLen));
 3032: 
 3033:    }
 3034: 
 3035:    printf("Processing %d elements\n", ne);
 3036:    for (int i = 0; i < ne; i++)
 3037:    {
 3038:       Element &elem = localElemData[i];
 3039:       elem.idx = i;
 3040:       for (int j = 0; j < i34[i]; j++) {
 3041:          const int idxNode = elnode[i*4 + j];  
 3042:          const int idxSide = elside[i*4 + j];
 3043:          
 3044:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3045:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3046: 
 3047: 
 3048: 
 3049:          // Find the neighboring element  
 3050:          if (elem.sides[j]->elems[0] == &elem) {
 3051:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3052:          }
 3053:          else {
 3054:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3055:          }
 3056:          
 3057:       }
 3058: 
 3059:       elem.i34 = i34[i];
 3060: 
 3061: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 3062: 
 3063:       // Compute the centroid of the element and its depth
 3064:       Vector2 center = {0.0, 0.0};
 3065:       elem.depth = 0.0;
 3066:       for (int j = 0; j < i34[i]; j++) {
 3067:          center += elem.nodes[j]->p2()/i34[i];
 3068:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3069:       }
 3070:       elem.center.x = center.x;
 3071:       elem.center.y = center.y;
 3072: 
 3073:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 3074:       
 3075:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3076:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3077: 
 3078:       elem.area = elem.computeSignedArea(); 
 3079:       elem.radius = sqrt(elem.area)/pi; 
 3080:       
 3081:       // Determines which way the normal vector to each side is oriented.
 3082:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3083:       for (int j = 0; j < i34[i]; j++)  
 3084:       {
 3085:          if (elem.sides[j]->elems[0] == &elem) {
 3086:             elem.ssign[j] =  1.0;
 3087:          }
 3088:          else {
 3089:             elem.ssign[j] = -1.0;
 3090:          }
 3091: 
 3092:       }
 3093: 
 3094:       // Derivatives of shape functions
 3095:       //  For ics=2, this is done inside element/ll frame XXX
 3096:       //  For quads, the derivative is evaluated at centroid
 3097:       const int i34 = elem.i34;
 3098:       for (int j = 0; j < i34; j++) {
 3099:          const double area = elem.area;
 3100:          const int id2 = elem.nxq(1 + j);
 3101:          const int id3 = elem.nxq(2 + j);
 3102:          const int id4 = elem.nxq(3 + j);
 3103:          if (elem.isTri()) {
 3104:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3105:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3106:             // da1/dx = (y1 - y2)/(2*area)
 3107:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3108:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3109:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3110:          }
 3111:          else  { // Quad; evaluate at centroid
 3112:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3113:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3114:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3115:          } // if Tri
 3116: 
 3117:       } // for j
 3118: 
 3119:    }
 3120: 
 3121: 
 3122:    // Processing the boundary nodes
 3123:    int idx = 0;
 3124:    for (int iseg = 0; iseg < nope; iseg++) {
 3125:       // for each segment...
 3126:       
 3127:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3128:          // for each node on the segment...
 3129: 
 3130:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3131: 
 3132:          nodeBnd->isEssentialBC = true;
 3133: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3134:          nodeBnd->elbc = 0.0;
 3135: 
 3136:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3137: 
 3138:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3139:             nodeBnd->efa[jfr] = efa[idx];
 3140:             nodeBnd->emo[jfr] = emo[idx];
 3141:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3142:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3143: 
 3144:          }
 3145: 
 3146:          idx++;
 3147:       }
 3148: 
 3149:    }
 3150: 
 3151: }
