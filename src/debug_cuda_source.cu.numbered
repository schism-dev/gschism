 1082: 
 1083:    __host__ __device__ void setWind(Vector2 &u) {
 1084:    // Sets the wind vector taking into account the wind rotation angle
 1085:    
 1086:       const double dir = atan2(-u.x,-u.y);
 1087:       const double speed = length(u);
 1088: 
 1089:       // Calculate new u and v components with added rotation angle
 1090:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1091:    }
 1092: 
 1093:    __host__ __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1094: 
 1095:    __host__ __device__ double sigmaTransitionDepth(void) const;
 1096: 
 1097:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1098:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1099:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1100: 
 1101:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1102: 
 1103:    __device__ void clearMatrixRow(void) {
 1104:       // Clear the matrix row for this node
 1105:       coeffDiag = 0.0;
 1106:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1107: 
 1108:    }
 1109: 
 1110:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1111:       // Add the value to the sparse matrix for this node
 1112:       
 1113:       if (node == this) {
 1114:          coeffDiag += value;
 1115: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1116:       } else {
 1117:          // Search (linearly)the index of the node in the array of nodes
 1118:          // XXX: This is not efficient, see if we can improve this
 1119:          int i;
 1120:          for (i = 0; i < numNodes; i++) {
 1121:             if (nodes[i] == node) {
 1122:                break;
 1123:             }
 1124:          }
 1125:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1126:          coeffMatrix[i] += value;
 1127:       }
 1128:    }
 1129: 
 1130: #ifdef BACKTRACKING
 1131:    __device__ void updateZCoordData() {
 1132:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1133: 
 1134:       // Check if node is wet
 1135:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1136: 
 1137:       if (idry) return;
 1138: 
 1139:       if constexpr(ivcor == 2) {  // SZ coordinates
 1140:          
 1141:          // Compute bottom level index
 1142:          if (depth <= mesh->h_s) {
 1143:                kb = mesh->nzlevels;
 1144:          } else {
 1145:                kb = -1;
 1146:                for (int i = 0; i < mesh->kz-1; i++) {
 1147:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1148:                      kb = i;
 1149:                      break;
 1150:                   }
 1151:                }
 1152:          }
 1153:       } 
 1154:       else if (ivcor == 1) {  // Localized sigma
 1155:          // Do nothing
 1156:       }
 1157: 
 1158:    }
 1159: #endif   
 1160: 
 1161:    __device__ double compZCoord(int k) const;
