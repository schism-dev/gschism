 1448: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1449:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1450: }
 1451: 
 1452: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1453:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1454: }   
 1455: 
 1456: __device__ __inline__ double min3(double a, double b, double c) {
 1457:    return min(a, min(b, c));
 1458: }
 1459: 
 1460: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1461:    return min(a, min(b, min(c, d)));
 1462: }
 1463: 
 1464: 
 1465: // Helper functions for computing the local node index at a given offset from another.
 1466: __device__ __inline__ int nxq(int offset, int index, int size) {
 1467:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1468:    // to the index to make it positive
 1469:    assert(index + offset + 16*size >= 0);
 1470:    return (index + offset + 16*size) % size;  
 1471: }
 1472: 
 1473: __device__ __inline__ int nxq(int index, int size) {
 1474:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1475:    // to the index to make it positive
 1476:    assert(index + 16*size >= 0);
 1477:    return (index + 16*size) % size; 
 1478: }
