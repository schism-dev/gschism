 3738:    __global__ void computeElevationBoundaryConditions(double time) {
 3739:       // Compute elevation essential boundary conditions 
 3740: 
 3741:       NODE_BND(nodeBnd); // Each boundary node.
 3742: 
 3743:       const Node *node = nodeBnd->node;
 3744:       const int iettype = nodeBnd->iettype;
 3745: 
 3746:       double eic = 0.0;
 3747:       if (nramp_elev==1) eic = nodeBnd->etaic;
 3748:       else               eic = 0.0;
 3749: 
 3750:       const double r_eic = (1.0 - ramp)*eic; 
 3751:       const double r_eth = ramp*nodeBnd->eth;
 3752:       double eta1_bar = r_eic;
 3753: 
 3754: printf("++++>> node[%d]->iettype = %d\n", node->idx, iettype);
 3755:       // Compute tide elevation
 3756:       if (iettype == 3 || iettype == 5) {   
 3757: 
 3758:          if constexpr(iloadtide==1) { // loading tide
 3759:             assert(false && "Loading tide not implemented");
 3760:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3761:          }
 3762:          
 3763:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3764: 
 3765:             const double efa  = nodeBnd->efa[jfr]; 
 3766:             const double emo  = nodeBnd->emo[jfr]; 
 3767: 
 3768:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3769:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3770:             eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3771: 
 3772:  printf("++++>> jfr = %d, time = %f, ramp = %f, node->idx = %d, amig = %f, face = %f, ff = %f, efa = %f, emo = %f, arg = %f, eta1_bar = %f\n", jfr, time, ramp, node->idx, amig[jfr], face[jfr], ff[jfr], efa, emo, arg, eta1_bar);            
 3773:          } // for jfr
 3774: 
 3775:       } // if iettype
 3776: 
 3777:       switch (iettype) {
 3778:          case 1:
 3779:          case 2:
 3780:             nodeBnd->elbc = r_eth + r_eic;
 3781:             break;
 3782:          case 3:
 3783:             nodeBnd->elbc = eta1_bar + r_eic;
 3784:             break;
 3785:          case 4:
 3786:             nodeBnd->elbc = r_eth + r_eic;
 3787:             break;
 3788:          case 5:
 3789:             nodeBnd->elbc = r_eth + eta1_bar + r_eic;
 3790:             break;
 3791:       } // switch
 3792: 
 3793: 
 3794:       //Add inverse barometric effects
 3795:       if (iettype != 0 && inv_atm_bnd == 1) {
 3796:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 3797:       }
 3798: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 3799:    }
 3800: 
 3801: 
 3802:    __global__ void setEssentialBC(void) {
 3803:       // Set essential boundary conditions 
 3804:       NODE(node); // Each boundary node
 3805:       NodeBoundary *nodeBnd = node->nodeBnd;
 3806: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 3807:       
 3808: // nodeBnd->isEssentialBC = true;      
 3809:       // Check if this node has essential BC
 3810:       if (nodeBnd && nodeBnd->isEssentialBC) {
 3811:          // Verify BC value is valid
 3812:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3813: 
 3814:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 3815:          
 3816:          // Set diagonal to 1 and zero off-diagonals
 3817:          node->coeffDiag = 1.0;
 3818:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 3819: 
 3820:          for (int j = 0; j < node->numNodes; j++) {
 3821:                node->coeffMatrix[j] = 0.0;
 3822:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3823:          }
 3824:          
 3825:          // Set solution and RHS to BC value
 3826:          node->mX  = nodeBnd->elbc;
 3827:          node->qel = nodeBnd->elbc;
 3828: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 3829:       } else {
 3830:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 3831: 
 3832:          for (int j = 0; j < node->numNodes; j++) {
 3833:                Node* nbNode = node->nodes[j];
 3834:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 3835:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 3836:                   // Verify neighbor's BC value
 3837:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 3838: 
 3839:                   // Subtract contribution to RHS
 3840:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 3841:                   node->coeffMatrix[j] = 0.0;  
 3842:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 3843:                }
 3844:          }
 3845:       }
 3846:    }
 3847: 
 3848: 
 3849:    __global__ void updateElevation(void) {
 3850:       NODE(node);
 3851: 
 3852:       node->eta2 = node->mX;
 3853: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 3854:    }
