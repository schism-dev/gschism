 2486:    
 2487:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2488:    // Project the vectors from the node frame to the element frame
 2489: 
 2490:  
 2491:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2492:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2493:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2494:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2495:       else          v[3] = Vector2();
 2496:    }
 2497: 
 2498:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2499:    // Project the vectors from the side frame to the element frame
 2500: 
 2501:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2502:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2503:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2504:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2505:       else          v[3] = Vector2();
 2506:    }
