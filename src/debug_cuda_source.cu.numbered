 4831: 
 4832:    __global__ void rollUpElevation(void) {
 4833: 
 4834:       NODE(node);
 4835: 
 4836:       node->eta1 = node->eta2;
 4837: 
 4838:    }
 4839: 
 4840: 
 4841:    __global__ void backtrackAllNodes(void) {
 4842: 
 4843:       // max/min # of sub-divisions
 4844:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4845:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4846: 
 4847:       SIDE(side);
 4848: 
 4849:       const int kb = side->kb;
 4850: 
 4851: 
 4852:       // Initialize btrack velocities to the actual velocities at the side 
 4853:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4854:   
 4855:       if (side->isDry) return;
 4856:      
 4857: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4858: 
 4859:       // Checks that at least one element is not dry
 4860:       const Element *elem1 = side->elems[0];
 4861:       const Element *elem2 = side->elems[1];
 4862: 
 4863: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4864: 
 4865:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4866:       
 4867:       // XXXXXX
 4868:       // !swild_tmp to store global coord. of the starting side
 4869:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4870:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4871:       // !Use sframe2 
 4872:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4873: 
 4874: 
 4875:       for (int k = kb; k < nvrt; k++) {
 4876:       //  Initialize (xt,yt,zt), nnel and vel.
 4877:       //  For ics=2, the coordinates are all in the side's local frame
 4878:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4879: 
 4880:          const int iadvf = side->iadv();  // Advection flag   
 4881:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4882: 
 4883:          const double vmag2 = norm2(side->u2[k]);
 4884: 
 4885:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4886:             // No activity 
 4887: 
 4888:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4889: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4890: 
 4891:             
 4892:          } else {  // do btrack
 4893: 
 4894:             // Compute number of sub-divisions based on local gradients of the velocity field
 4895: 
 4896:             // XXX IS THIS NECESSARY?
 4897:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4898:             double suma = 0.0;
 4899:             int icount = 0;
 4900:             for (int l=0; l<2; l++) {
 4901:             // For each element sharing the side...
 4902: 
 4903:                const Element *elem = side->elems[l];
 4904:                  
 4905:                if (elem == nullptr) continue;
 4906: 
 4907:                icount++;
 4908: 
 4909:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4910:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4911:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4912: 
 4913:                double utmp[4];
 4914:                double vtmp[4];
 4915:                for (int j = 0; j < elem->i34; j++) {
 4916: 
 4917:                   const Node *node = elem->nodes[j];
 4918: 
 4919:                   if constexpr(ics==1) {
 4920:                      utmp[j] = node->u2[k].x;
 4921:                      vtmp[j] = node->u2[k].y;  
 4922: 
 4923:                   } else {
 4924:                      // 'Project' the velocity from the node frame to the element frame
 4925:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4926:                      utmp[j] = tmp_u2.x;
 4927:                      vtmp[j] = tmp_u2.y;
 4928: 
 4929:                   }
 4930:                } // for j
 4931: 
 4932:                const Vector2 grad_u = elem->grad2(utmp); 
 4933:                const Vector2 grad_v = elem->grad2(vtmp);
 4934:    
 4935:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4936:             } // for ii
 4937: 
 4938:             assert(icount > 0 && "Impossible 77");
 4939: 
 4940:             // '4' is somewhat arbitrary
 4941:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4942: 
 4943:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4944:             Vector3 u_int = {0.0, 0.0, 0.0};
 4945: 
 4946:             side->btrack(k, dt, dtbk, u_int);
 4947: 
 4948: 
 4949:             side->btu[k] = {u_int.x, u_int.y};
 4950:                
 4951:          } // if vmag (do backtrack)
 4952: 
 4953: 
 4954:       } // for k=kb,nvrt-1
 4955: 
 4956:    }
 4957: 
 4958: } // extern "C"
 4959: 
 4960: template<int nc>
 4961: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4962: 
 4963: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4964: //
 4965: // a,b,c,rhs: input vectors and are not modified by this program.
 4966: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4967: // rhs is the r.h.s.
 4968: // n: actual rank of the system.
 4969: // rows in u() and rhs();
 4970: // u: output with nc columns (transposed to rows)
 4971: // gam: a working array.
 4972: //
 4973: // NOTES:
 4974: // This is a template function that allows for different numbers of columns in the rhs vector.
 4975: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4976: 
 4977:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4978:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4979: 
 4980:    double bet = b[0];
 4981:    if constexpr (nc == 1) {
 4982:       u[0] = rhs[0]/bet;
 4983:    } else {
 4984:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4985:    }
 4986: 
 4987:    for (int j = 1; j < n; j++) {
 4988:       gam[j] = c[j - 1]/bet;
 4989:       bet = b[j] - a[j]*gam[j];
 4990: 
 4991:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4992: 
 4993:       if constexpr (nc == 1) {
 4994:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4995:       } else {
 4996:          for (int l = 0; l < nc; l++) {
 4997:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4998:          }
 4999:       }
 5000:    }
 5001: 
 5002:    // Back-substitution
 5003:    for (int j = n - 2; j >= 0; j--) {
 5004:       if constexpr (nc == 1) {
 5005:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5006:       } else {
 5007:          for (int l = 0; l < nc; l++) {
 5008:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5009:          }
 5010:       }
 5011:    }
 5012: }
 5013: 
 5014: 
 5015: 
 5016: // Helper function that contains the core algorithm
 5017: template<typename XAccessor, typename YAccessor>
 5018: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5019:                                     double  yp_top, double  yp_bot, 
 5020:                                     CubicSpline &spline) {
 5021:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5022:    // 
 5023:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5024:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5025:    //
 5026:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5027:    // 
 5028:    // Inputs: 
 5029:    //            n: dimension for x etc; # of data pts (>=2);
 5030:    //            getX, getY: functions to access x,y coordinates
 5031:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5032:    //     Output: 
 5033:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5034: 
 5035:    const int n = k2 - k1 + 1;
 5036:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5037: 
 5038:    // Allocate memory for the splines
 5039:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5040:    spline.x   = new double[n];
 5041:    spline.y   = new double[n];
 5042:    spline.yp  = new double[n];
 5043:    spline.ypp = new double[n];
 5044: 
 5045:    for (int k=k1; k<=k2; k++) {
 5046:       spline.x[k] = getX(k);
 5047:       spline.y[k] = getY(k);
 5048:    }
 5049: 
 5050:    // This is to simplify expressions later
 5051:    double *x = spline.x;
 5052:    double *y = spline.y;
 5053: 
 5054:    double *a = nullptr;
 5055:    double *b = nullptr;
 5056:    double *c = nullptr;
 5057:    double *gam = nullptr;
 5058:    double *rhs = nullptr;
 5059:    
 5060: 
 5061:       a = new double[n];   // Lower diagonal
 5062:       b = new double[n];   // Diagonal
 5063:       c = new double[n];   // Upper diagonal
 5064:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5065:       rhs = new double[n]; // Right-hand side
 5066: 
 5067:    for (int k=k1; k<=k2; k++) {
 5068:       if (k == k1) {
 5069:          // Bottom level
 5070:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5071:          b[k] = (x[k+1] - x[k])/3.0;
 5072:          c[k] = b[k]/2.0;
 5073:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5074:       } else if (k == n - 1) {
 5075:          // Top level (surface)
 5076:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5077:          b[k] = (x[k] - x[k-1])/3.0;
 5078:          a[k] = b[k]/2.0;
 5079:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5080:       } else {
 5081:          // Intermediate levels
 5082:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5083:          b[k] = (x[k+1] - x[k-1])/3.0;
 5084:          a[k] = (x[k  ] - x[k-1])/6.0;
 5085:          c[k] = (x[k+1] - x[k  ])/6.0;
 5086:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5087:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5088:       }
 5089:    }
 5090: 
 5091:    // Solve the tridiagonal system
 5092:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5093:    
 5094:    spline.yp[k1] = yp_bot;
 5095:    spline.yp[k2] = yp_top;
 5096: 
 5097:    // Compute rest of 1st derivatives using the splines
 5098:    for (int k=k1+1; k<k2; k++) {
 5099:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5100:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5101:    }
 5102:    
 5103:    delete[] a;
 5104:    delete[] b;
 5105:    delete[] c;
 5106:    delete[] gam;
 5107:    delete[] rhs;
 5108: 
 5109: }
 5110: 
 5111: // Array version
 5112: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5113:                                 double y_top, double y_bot, 
 5114:                                 CubicSpline &spline) {
 5115:    auto getX = [x] (int k) { return x[k]; };
 5116:    auto getY = [y] (int k) { return y[k]; };
 5117:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5118: }
 5119: 
 5120: // Lambda version - allows custom access patterns
 5121: template<typename XFunc, typename YFunc>
 5122: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5123:                                 double y_top, double y_bot,
 5124:                                 CubicSpline &spline) {
 5125:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5126: }
 5127: 
 5128: 
 5129: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5130: {
 5131:    assert("Not implemented");
 5132: 
 5133:    return 0.0;
 5134: }
