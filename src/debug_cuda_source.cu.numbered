 9141: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 9142: //                     enddo
 9143: //                   else !upwind
 9144: //                     if(ssign(j,i)*flux_adv_hface(k,jsj)<0) then  !inflow 
 9145: //                       do jj=1,ntr
 9146: //                         adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 9147: //                       enddo
 9148: //                     endif
 9149: //                   endif !weno or upwind
 9150: //                 endif
 9151: 
 9152: //               enddo !j
 9153: 
 9154: //               tr_el(1:ntr,k,i)=adv_tr(1:ntr) 
 9155: //             enddo !k=kbe(i)+1,nvrt
 9156: 
 9157: //             !Overwrite with ELM value if enabled.
 9158: //             if(ielem_elm(i)/=0) then
 9159: //               rat=time_r/dt !time ratio
 9160: //               rat=max(0.d0,min(1.d0,rat))
 9161: //               do k=kbe(i)+1,nvrt
 9162: //                 do jj=1,ntr
 9163: //                   psumtr(jj)=0.d0
 9164: //                   do j=1,i34(i)
 9165: //                     jsj=elside(j,i)
 9166: //                     n1=isidenode(1,jsj); n2=isidenode(2,jsj)
 9167: //                     swild4(1,1)=0.5d0*(tr_nd(jj,k,n1)+tr_nd(jj,k,n2))
 9168: //                     swild4(2,1)=0.5d0*(tr_nd(jj,k-1,n1)+tr_nd(jj,k-1,n2))
 9169:   
 9170: //                     swild4(1,1)=swild4(1,1)*rat+sdbt(2+jj,max(k,kbs(jsj)),jsj)*(1-rat)
 9171: //                     swild4(2,1)=swild4(2,1)*rat+sdbt(2+jj,max(k-1,kbs(jsj)),jsj)*(1-rat)
 9172: //                     psumtr(jj)=psumtr(jj)+0.5d0*(swild4(1,1)+swild4(2,1)) 
 9173: //                   enddo !j
 9174: //                 enddo !jj
 9175: //                 tr_el(1:ntr,k,i)=psumtr(:)/dble(i34(i))
 9176: //               enddo !k
 9177: //             endif !ielem_elm(i)/=0
 9178: 
 9179: 
 9180: // !           Extend
 9181: //             do k=1,kbe(i)
 9182: //               tr_el(1:ntr,k,i)=tr_el(1:ntr,kbe(i)+1,i)
 9183: //             enddo !k
 9184: //           enddo !i=1,ne
 9185: // !$OMP     end do 
