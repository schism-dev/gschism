 7862: //                 !    enddo
 7863: //                 !  endif !inflow or outflow
 7864: //                 !endif !if use weno
 7865: 
 7866: //                 !alternative formulation
 7867: //                 if (k>=kbs(jsj)+1) then
 7868: //                   if (iweno) then !weno
 7869: //                     do jj=1,ntr
 7870: //                       tmp=rk_coef(itd_weno)*dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7871: //                       adv_tr(jj)=adv_tr(jj)+tmp
