 7962:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7963:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7964:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7965:                    int *isdel, int *isidenode, int *isbnd,
 7966:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7967:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7968:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7969:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7970:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7971:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7972:                    double *drag, double *roughness,
 7973:                    double *emo, double *efa, 
 7974:                    double *umo, double *ufa, 
 7975:                    double *vmo, double *vfa) {
 7976: 
 7977:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7978:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7979:                        isdel, isidenode, isbnd,
 7980:                        nond, nlnd, iond, ilnd, 
 7981:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7982:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7983:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7984:                        localNodeIndices, localElemIndices, localSideIndices,
 7985:                        localNodePart, localElemPart, localSidePart,
 7986:                        drag, roughness,
 7987:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7988:   }
