 3909: __device__ __inline__ void Node::updateZCoordData(void) {
 3910: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3911: 
 3912:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3913:    // if (isDry2()) {
 3914:    //    kb = -1;  // XXXXXXXX KKKKK
 3915:    //    return;
 3916:    // }
 3917: 
 3918: 
 3919:    if constexpr(ivcor == 2) {  // SZ coordinates
 3920:       
 3921:       // Compute bottom level index
 3922:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3923:    } 
 3924:    else {  // if (ivcor == 1) Localized sigma
 3925:       // Do nothing
 3926:    }
 3927: 
 3928: 
 3929: }
