 2611:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2612:    // curElement.
 2613: 
 2614:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2615:    // And uses this velocity instead to continue the tracking.
 2616: 
 2617:    // computes the intersection point in local cartesian coordinates
 2618: //    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2619: 
 2620: //    // Nudges the point to the barycenter of the element. 
 2621: //    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2622: //    // next segment intersects the element sides. 
 2623: //    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2624: 
 2625: 
 2626: //    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2627: //    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2628: //    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2629: //    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2630: 
 2631: //    // If the side is an open boundary, the tangential velocity is set to zero.
 2632: //    if (nextSide->isBnd()) vtan = 0.0;
 2633: 
 2634: //    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2635: //    const double us = vtan*nextSide->t().x;
 2636: //    const double vs = vtan*nextSide->t().y;
 2637: //    const double ws = nextSide->w2(jlev); 
 2638: 
 2639: //    u_int = {us, vs, ws};
 2640: 
 2641: //    // The end of this tracking segment is now the intersection point.
