 1833: // Helper functions for computing the local node index at a given offset from another.
 1834: __device__ __inline__ int nxq(int offset, int index, int size) {
 1835:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1836:    // to the index to make it positive
 1837:    assert(index + offset + 16*size >= 0);
 1838:    return (index + offset + 16*size) % size;  
 1839: }
 1840: 
 1841: __device__ __inline__ int nxq(int index, int size) {
 1842:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1843:    // to the index to make it positive
 1844:    assert(index + 16*size >= 0);
 1845:    return (index + 16*size) % size; 
 1846: }
