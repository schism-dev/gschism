  955: struct Side {
  956: 
  957:    // Geometry information
  958:    int idx;               // Index of the side
  959:    Node *n1, *n2;
  960:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  961: 
  962:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  963:    Vector2 center;        // Location of side center. 
  964:    double zc[nvrt];       // Side center z-coord at each vertical level
  965: 
  966:    Frame frame;
  967: 
  968:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  969:                           // this is nullptr
  970:    
  971:    int kb;                // Bottom index of the side
  972:    bool isDry;            // True if the side is dry
  973:  
  974:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  975: 
  976:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  977: 
  978:    // Physical information
  979:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  980:    double  w2[nvrt];            // Vertical velocity at each vertical level
  981:    Vector2 btu[nvrt];           // Back-tracked velocity
  982:    Vector2 U;                   // Vertically averaged velocity vector  
  983: 
  984:    Vector2 nuGradU[nvrt];          // nu*grad u
  985: 
  986:    Vector2 bcc[nvrt];           // Baroclinic term
  987:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  988: 
  989:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  990:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  991:    Vector2 gradPr;               // Gradient of pressure
  992:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  993: 
  994: 
  995:    double hhat;                 // \breve{H} in notes
  996: 
  997:    double shapiro;
  998: 
  999:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1000: 
 1001:    double coriolis;             // Coriolis parameter
 1002: 
 1003:    // Vegetation parameters
 1004:    double veg_c2;
 1005:    double veg_beta;
 1006: 
 1007:    // Bottom drag parameters.
 1008:    double chi;
 1009:    double chi2;
 1010: 
 1011:    __inline__ __device__ double x(double t) const;
 1012:    __inline__ __device__ double y(double t) const;
 1013:    __inline__ __device__ double lon(void) const;
 1014:    __inline__ __device__ double lat(void) const;
 1015:    __inline__ __device__ Point2 p_t(double t) const;
 1016: 
 1017:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1018:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
 1019:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1020:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1021: 
 1022:    __inline__ __device__ Side* neigh(int index) const { 
 1023:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1024:       assert(index >= 0 && index < 4); 
 1025:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1026: 
 1027:       const int ielem = index & 1;           // 0 or 1
 1028:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1029: 
 1030:       const Element* elem = elems[ielem];
 1031: 
 1032:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1033: 
 1034:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1035: 
 1036:    }
 1037: 
 1038:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1039: 
 1040:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1041: 
 1042:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1043:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1044:    __inline__ __device__ int iadv(void) const;
 1045: 
 1046:    __inline__ __device__ double grav3(void) const;
 1047:    
 1048:    __inline__ __device__ double eta2(void) const;
 1049:    __inline__ __device__ double eta1(void) const;
 1050:    __inline__ __device__ double depth(void) const;
 1051:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1052:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1053: 
 1054:    __inline__ __device__ double dfv(int k) const;
 1055: 
 1056:    __inline__ __device__ double veg_h(void)  const;
 1057:    __inline__ __device__ double veg_nv(void) const;
 1058:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1059:    __inline__ __device__ double veg_alpha3D(int k) const;
 1060:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1061: 
 1062:    __inline__ __device__ double Cd(void) const;
 1063: 
 1064:    __inline__ __device__ Vector2 tau(void) const;
 1065: 
 1066:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1067:    
 1068: 
 1069:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1070:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1071:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1072:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1073:    } 
 1074:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1075:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1076:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1077:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1078: 
 1079:    // Get valid starting element (for backtracking)
 1080:    __inline__ __device__ Element* getStartElement() {
 1081:       return elems[0] ? elems[0] : elems[1];
 1082:    }
 1083: 
 1084:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1085:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1086: 
 1087:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1088: 
 1089:       // Dot product of the negative velocity vector with the side normal vector
 1090:       const double dot_prod1 = -dot(u, n);
 1091: 
 1092:       // Vector from side center to element 0 centroid
 1093:       const Vector2 v2 = elems[0]->center - center;
 1094: 
 1095:       // Dot product of the vector with the side normal vector
 1096:       const double dot_prod2 = dot(v2, n);
 1097: 
 1098:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1099:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1100: 
 1101:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1102:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1103:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : nullptr;
 1104:       else                           return !isDry1 ? elems[1] : nullptr;
 1105: 
 1106:  
 1107:    }
 1108: 
 1109:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1110:       // Given an element, returns the other element that shares this side
 1111:       return (elems[0] == elem) ? elems[1] : elems[0];
 1112:    }
 1113: 
 1114:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1115:       // Given a node, returns the other node that shares this side
 1116:       return (n1 == node) ? n2 : n1;
 1117:    }
 1118:  
 1119:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1120: 
 1121: 
 1122: 
 1123: 
 1124: };
