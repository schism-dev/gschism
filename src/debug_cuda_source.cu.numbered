 1439: // This struct is used to store the boundary information for a node.
 1440: struct NodeBoundary {   
 1441:    int idx;
 1442:    BoundarySegment *segment;
 1443:    Node *node;
 1444:    
 1445:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1446:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1447: 
 1448:    bool isLand;
 1449: 
 1450:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1451:    double elbc;   // Elevation boundary condition
 1452:    double eth;    // Elevation time history
 1453: 
 1454:    double eta_mean; // Mean elevation at nodes
 1455: 
 1456:    bool isEssentialBC;
 1457: 
 1458:    Vector2 uth[nvrt];  // "Time history" velocity
 1459: 
 1460:    // Arrays for harmonic constituents (if needed)
 1461:    double  emo[nbfr];  // Elevation amplitude
 1462:    double  efa[nbfr];  // Elevation phase
 1463:    Vector2 umo[nbfr];  // velocity amplitude
 1464:    Vector2 ufa[nbfr];  // velocity phase
 1465: 
 1466: 
 1467:    NodeBoundary(void) {
 1468:       isLand = false;
 1469:    }
 1470:    NodeBoundary(bool _isLand) {
 1471:       isLand = _isLand;
 1472:    }
 1473: 
 1474:    
 1475:    __forceinline__ __device__ int numSidesForAverage() const {
 1476:    // Returns the number of sides that are connected to the node and have the same segment.
 1477:    // This is used to compute the average velocity at the node for open boundary nodes.
 1478:       int res = 0;
 1479:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1480:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1481: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1482:       return res;
 1483:    }
 1484: 
 1485: 
 1486:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1487:       assert(index == 0 || index == 1); 
 1488:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1489:    }
 1490: 
 1491:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1492:       if (isLand) return;  // land never uses these links
 1493: 
 1494:       SideBoundary *nullSideBoundary = nullptr;
 1495:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1496: 
 1497:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1498:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1499: 
 1500:       // both slots taken. OK if this side was already linked
 1501:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1502:    }
 1503: 
 1504: 
 1505: };
