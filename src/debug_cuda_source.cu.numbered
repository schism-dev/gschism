 1877:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1878:       // Compute the different time ramps used in the code 
 1879:       // This function is performed by just one thread
 1880: 
 1881:       rampbc = 1.0;
 1882:       if constexpr(ibc == 0) {
 1883:          if (drampbc > 0.0) {
 1884:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1885:          } else {
 1886:             rampbc = 1.0;
 1887:          }
 1888:       }
 1889: 
 1890:       if (nws != 0) {
 1891:          if (drampwind > 0.0) {
 1892:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1893:          } else {
 1894:             rampwind = 1.0;
 1895:          }
 1896:       }
 1897: 
 1898:       if (drampwafo > 0.0) {
 1899:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1900:       } else {
 1901:          rampwafo = 1.0;
 1902:       }
 1903: 
 1904:       // For source/sinks
 1905:       if (if_source && dramp_ss > 0.0) {
 1906:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1907:       } else {
 1908:          ramp_ss = 1.0;
 1909:       }
 1910: 
 1911:       if (dramp > 0.0) {
 1912:          ramp = tanh(2.0*time/86400.0/dramp);
 1913:       } else {
 1914:          ramp = 1.0;
 1915:       }
 1916: 
 1917: 
 1918:    }
