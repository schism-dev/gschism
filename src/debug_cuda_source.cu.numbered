  908: struct Side {
  909: 
  910:    // Geometry information
  911:    int idx;               // Index of the side
  912:    Node *n1, *n2;
  913:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  914: 
  915:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  916:    Vector2 center;        // Location of side center. 
  917:    double zc[nvrt];       // Side center z-coord at each vertical level
  918: 
  919:    Frame frame;
  920: 
  921:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  922:                           // this is nullptr
  923:    
  924:    int kb;                // Bottom index of the side
  925:    bool isDry;            // True if the side is dry
  926:  
  927:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  928: 
  929:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  930: 
  931:    // Physical information
  932:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  933:    double  w2[nvrt];            // Vertical velocity at each vertical level
  934:    Vector2 btu[nvrt];           // Back-tracked velocity
  935:    Vector2 U;                   // Vertically averaged velocity vector  
  936: 
  937:    Vector2 nuGradU[nvrt];          // nu*grad u
  938: 
  939:    Vector2 bcc[nvrt];           // Baroclinic term
  940:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  941: 
  942:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  943:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  944:    Vector2 gradPr;               // Gradient of pressure
  945:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  946: 
  947: 
  948:    double hhat;                 // \breve{H} in notes
  949: 
  950:    double shapiro;
  951: 
  952:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  953: 
  954:    double coriolis;             // Coriolis parameter
  955: 
  956:    // Vegetation parameters
  957:    double veg_c2;
  958:    double veg_beta;
  959: 
  960:    // Bottom drag parameters.
  961:    double chi;
  962:    double chi2;
  963: 
  964:    __inline__ __device__ double x(double t) const;
  965:    __inline__ __device__ double y(double t) const;
  966:    __inline__ __device__ double lon(void) const;
  967:    __inline__ __device__ double lat(void) const;
  968:    __inline__ __device__ Point2 p_t(double t) const;
  969: 
  970:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
  971:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  972:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
  973:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
  974: 
  975:    __inline__ __device__ Side* neigh(int index) const { 
  976:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  977:       assert(index >= 0 && index < 4); 
  978:       assert(elems[0] != nullptr && elems[1] != nullptr);
  979: 
  980:       const int ielem = index & 1;           // 0 or 1
  981:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  982: 
  983:       const Element* elem = elems[ielem];
  984: 
  985:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  986: 
  987:       return elem->sides[elem->nxq(locSideIdx + iside)];
  988: 
  989:    }
  990: 
  991:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  992: 
  993:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  994: 
  995:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  996:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
  997:    __inline__ __device__ int iadv(void) const;
  998: 
  999:    __inline__ __device__ double grav3(void) const;
 1000:    
 1001:    __inline__ __device__ double eta2(void) const;
 1002:    __inline__ __device__ double eta1(void) const;
 1003:    __inline__ __device__ double depth(void) const;
 1004:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1005:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1006: 
 1007:    __inline__ __device__ double dfv(int k) const;
 1008: 
 1009:    __inline__ __device__ double veg_h(void)  const;
 1010:    __inline__ __device__ double veg_nv(void) const;
 1011:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1012:    __inline__ __device__ double veg_alpha3D(int k) const;
 1013:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1014: 
 1015:    __inline__ __device__ double Cd(void) const;
 1016: 
 1017:    __inline__ __device__ Vector2 tau(void) const;
 1018: 
 1019:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1020:    
 1021: 
 1022:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1023:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1024:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1025:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1026:    } 
 1027:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1028:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1029:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1030:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1031: 
 1032:    // Get valid starting element (for backtracking)
 1033:    __inline__ __device__ Element* getStartElement() {
 1034:       return elems[0] ? elems[0] : elems[1];
 1035:    }
 1036: 
 1037:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1038:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1039: 
 1040:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1041: 
 1042:       // Dot product of the negative velocity vector with the side normal vector
 1043:       const double dot_prod1 = -dot(u, n);
 1044: 
 1045:       // Vector from side center to element 0 centroid
 1046:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1047: 
 1048:       // Dot product of the vector with the side normal vector
 1049:       const double dot_prod2 = dot(v2, n);
 1050: 
 1051:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1052:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1053: 
 1054:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1055:       else                           return elems[1];
 1056: 
 1057:  
 1058:    }
 1059: 
 1060:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1061:       // Given an element, returns the other element that shares this side
 1062:       return (elems[0] == elem) ? elems[1] : elems[0];
 1063:    }
 1064: 
 1065:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1066:       // Given a node, returns the other node that shares this side
 1067:       return (n1 == node) ? n2 : n1;
 1068:    }
 1069:  
 1070:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1071: 
 1072: 
 1073: 
 1074: 
 1075: };
 1076: 
