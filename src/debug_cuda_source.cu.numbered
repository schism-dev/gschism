 4410: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 4411: 
 4412: //    } else if(zt>=za[k2]) {
 4413: //       // Above surface
 4414: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 4415: 
 4416: //    } else {
 4417: //       // Normal case (between bottom and surface)
 4418:       
 4419: //       // Finds the level index using binary search
 4420: //       int l1 = k1;
 4421: //       int l2 = k2;
 4422: //       int k = (l1 + l2)/2;
 4423: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 4424: //           int k = (l1 + l2)/2;
 4425: //           if (zt >= za[k]) l1 = k;
 4426: //           else             l2 = k;
 4427: //       }
 4428: //       // Now l1 and l2 are adjacent levels and zt is between them
 4429: 
 4430: //       assert(za[l2] - za[l1] > 0.0 && "vertLinearInterp: za[l2] - za[l1] <= 0");
 4431: 
 4432: //       const double zrat = (zt - za[l1])/(za[l2] - za[l1]);
 4433: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + l1*nc]*(1.0 - zrat) + s_in[i + l2*nc]*zrat;
