 7687: __global__ void getStructSizes(int* sizes)  {
 7688:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7689:       sizes[0] = (int)sizeof(Node);
 7690:       sizes[1] = (int)sizeof(Element);
 7691:       sizes[2] = (int)sizeof(Side);
 7692:       sizes[3] = (int)sizeof(NodeBoundary);
 7693:       sizes[4] = (int)sizeof(SideBoundary);
 7694:       sizes[5] = (int)sizeof(BoundarySegment);
 7695: }
