 2511:    template<typename T>
 2512:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2513:       T values[4];
 2514:       getNodalValues(level, func, values);
 2515: 
 2516:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2517:       if constexpr (IsVector2<T>::value && ics == 2) {
 2518: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2519:          projectNodeVectorsToElementFrame(values);
 2520: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2521:       }
 2522: 
 2523:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2524:    }
 2525: 
 2526:    template<typename T>
 2527:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2528:       T values[4];
 2529:       getNodalValues(field, values);
 2530: 
 2531:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2532:       if constexpr (IsVector2<T>::value && ics == 2) {
 2533: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2534:          projectNodeVectorsToElementFrame(values);
 2535: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2536:       }
 2537:       
 2538:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2539:    }
 2540: 
 2541: 
 2542:    template<typename T>
 2543:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2544:       T values[4];
 2545:       getNodalValues(level, field, values);
 2546:       
 2547: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2548:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2549:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2550:       if constexpr (IsVector2<T>::value && ics == 2) {
 2551: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2552:          projectNodeVectorsToElementFrame(values);
 2553: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2554:       }
 2555: 
 2556:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2557:    }
 2558: 
 2559:    template<typename T>
 2560:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2561:       T values[4];
 2562:       getNodalValues(field, values);
 2563: 
 2564:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2565:       if constexpr (IsVector2<T>::value && ics == 2) {
 2566: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2567:          projectNodeVectorsToElementFrame(values);
 2568: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2569:       }
 2570: 
 2571:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2572:    }
 2573: 
 2574:    template<typename T>
 2575:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2576:       T values[4];
 2577:       getSideValues(field, values);
 2578:       
 2579:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2580:       if constexpr (IsVector2<T>::value && ics == 2) {
 2581: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2582:          projectSideVectorsToElementFrame(values);
 2583: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2584:       }
 2585: 
 2586:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2587:    }   
 2588: 
 2589:    template<typename T>
 2590:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2591: 
 2592:       T values[4];
 2593: 
 2594: 
 2595:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2596:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2597:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2598:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2599:       else          values[3] = T();
 2600: 
 2601:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2602: 
 2603:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2604:    }
 2605: 
 2606: 
 2607:    template<typename T>
 2608:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2609:       T values[4];
 2610:       getNodalValues(level, field, values);
 2611: 
 2612:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2613:       if constexpr (IsVector2<T>::value && ics == 2) {
 2614: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2615:          projectNodeVectorsToElementFrame(values);
 2616: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2617:       }
 2618: 
 2619:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2620:    }
