10192: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
10193:    // Get the value of a variable from an side
10194:    // varName is the name of the variable to get
10195:    // var is the array to store the value
10196:    // k is the vertical level index of the variable to get
10197:    SIDE_BND(sideBnd);   
10198: 
10199:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
10200:    if (sideBnd->segment->isLand) idx = -7;
10201: 
10202:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
10203:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
10204: 
10205: }
