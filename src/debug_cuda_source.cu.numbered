 5271:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5272:       NODE(node);
 5273: 
 5274:       const int idx = node->idx;
 5275:       Vector2 wind = {xWind[idx], yWind[idx]};
 5276: 
 5277:       if constexpr(nws != 0 && iwindoff != 0) {
 5278:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5279:       }
 5280: 
 5281:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5282:       node->setWind(wind);
 5283: 
 5284:       node->pr = pressAir[idx];
 5285:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5286: 
 5287:    }
