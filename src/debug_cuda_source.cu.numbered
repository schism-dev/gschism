 1893: struct Mesh {
 1894:    public:  
 1895: 
 1896:    int partNum; // Partition number for this mesh.
 1897: 
 1898:    // Pointers to each GPU's local memory (size is the number of partitions).
 1899:    Node**    nodes;  
 1900:    Element** elems;  
 1901:    Side**    sides;  
 1902:    
 1903:    // Local memory
 1904:    Node*    localNodeData; 
 1905:    Element* localElemData;
 1906:    Side*    localSideData; 
 1907: 
 1908:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1909:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1910:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1911:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1912:    
 1913:    const int npgb;  // Global number of horizontal nodes
 1914:    const int negb;  // Global number of elements
 1915:    const int nsgb;  // Global number of sides
 1916: 
 1917:    const int np;   // Local number of horizontal nodes 
 1918:    const int ne;   // Local number of elements
 1919:    const int ns;   // Local number of sides
 1920: 
 1921:    int nbp;  // Local number of boundary nodes
 1922:    int nbs;  // Local number of boundary sides
 1923: 
 1924:    int nEntries;  // Total number of matrix elements
 1925: 
 1926:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1927:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1928:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1929: 
 1930:   
 1931:    // Additional topology information
 1932:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 1933:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 1934:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 1935: 
 1936:    BoundarySegment *landBoundarySegment;
 1937:    NodeBoundary *landBoundaryNode;
 1938: 
 1939:    // Vertical coordinate system
 1940:    // Sigma levels
 1941:    double h_s; 
 1942:    double h_c; 
 1943: 
 1944:    double theta_b;
 1945:    double theta_f, sinh_theta_f;
 1946:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1947:    double *ztot;
 1948:    double *cs;
 1949:    double *dcs;
 1950: 
 1951: 
 1952: 
 1953:    __device__ Mesh(int partNum,
 1954:                    int npgb, int negb, int nsgb, 
 1955:                    int np, int ne, int ns,
 1956:                    int max_np, int max_ne, int max_ns, int nseg,
 1957:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 1958:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1959:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1960:                    Node    **localNodeNeighNodesMem,
 1961:                    Element **localNodeNeighElemsMem,
 1962:                    int16_t *localNodePermutationSortMem,
 1963:                    double *partCoeffMatrixMem,
 1964:                    NodeBoundary *localNodeBoundaryMem,
 1965:                    SideBoundary *localSideBoundaryMem,
 1966:                    BoundarySegment *localSegmentMem,
 1967:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1968:                    double *cs, double *dcs
 1969:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1970:                        np(np), ne(ne), ns(ns),
 1971:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1972:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1973:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1974:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1975:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 1976:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1977:                        localSegmentMem(localSegmentMem),
 1978:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1979:                        cs(cs), dcs(dcs),
 1980:                        landBoundarySegment(plandSegMem),
 1981:                        landBoundaryNode(plandNodeBndMem)
 1982:    {
 1983:       printf("Mesh constructor for partition %d\n", partNum);
 1984: 
 1985:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1986:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1987:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1988:  
 1989:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1990:       
 1991:       sinh_theta_f = sinh(theta_f);
 1992: 
 1993:       *landBoundaryNode    = NodeBoundary(true);
 1994:       *landBoundarySegment = BoundarySegment(true);   
 1995: 
 1996:    }
