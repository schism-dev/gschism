 7123: #ifdef DONTCOMPILE
 7124: __device__ void computeVerticalAdvection(void) {
 7125:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7126: 
 7127:    sdbt(1:2,:,:)=0.d0
 7128: 
 7129:    const Side *side = FROM kernel;
 7130: 
 7131:    if(side->isDry) return;
 7132: 
 7133:    // If side is wet...
 7134: 
 7135: 
 7136:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7137:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7138:    double ws[nvrt] = {} // w @ side
 7139:    int icount = 0;
 7140:    for (int j=0; j<2; j++) {
 7141:       const Element *elem = side->elements[j];
 7142:        
 7143:       if(elem != nullptr) {
 7144:          icount++;
 7145:          for (int k=0; k<nvrt; k++) {
 7146:             ws[k] = ws[k] + elem->w[k];
 7147:          }
 7148:       }
 7149:    }  // for j
 7150: 
 7151:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7152:    ws = ws/icount;
 7153: 
 7154:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7155:    // Splines allow for a smooth transition between vertical levels.
 7156:    // Splines have continuity restrictions at the internal knots, but
 7157:    // we have to provide the 1st derivatives at the endpoints.
 7158:    const int kbs = side->kbs; 
 7159:    
 7160:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7161:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7162:    initCubicSpline(kbs, nvrt, side, ws, up)
 7163: 
 7164:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7165:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7166:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7167: 
 7168:    // Total advection (average onto side)
 7169:    const Node *node1 = side->nodes[0];
 7170:    const Node *node2 = side->nodes[1];
 7171:    for (int k=kbs(i); k<nvrt; k++) {
 7172: 
 7173:       if constexpr(ics==1) {
 7174:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 7175:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 7176:       } else {
 7177:          // XXX IMPLEMENT THIS
 7178:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 7179:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 7180:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 7181:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 7182:       }  // if ics
 7183: 
 7184: 
 7185:    }
 7186: }
 7187: #endif
 7188: 
 7189: 
 7190: extern "C" {
 7191:    __global__ void computeElemAverageGhat(void) {
 7192:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7193: 
 7194:       ELEM(elem);
 7195:       
 7196:       elem->ghat1= {0.0, 0.0};  
 7197: 
 7198:       if constexpr(ihydraulics != 0) {
 7199:          if (nhtblocks > 0 && elem->isblock) return;
 7200:       }
 7201: 
 7202:       if (elem->isDry) return;
 7203: 
 7204:       // Wet elements.
 7205:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7206:       // tidal potential, horizontal diffusion, and baroclinic etc
 7207:       // Remember to update both fb and F 
 7208:       // If ics=2, ghat1 are in eframe (ll)
 7209:       // cff1-3: coefficients for 2D/3D
 7210:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7211:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7212:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7213: 
 7214:       double av_cff1 = 0.0;  // av. for cff1
 7215:       double av_cff2 = 0.0;  // av. for cff2
 7216:       double av_cff3 = 0.0;  // av. for cff3
 7217:       double av_df = 0.0;  // av. for H^\alpha / H
 7218:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7219:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7220: 
 7221:       const int i34 = elem->i34;
 7222:       const int kb = elem->kb;
 7223: 
 7224:       for (int j=0; j<i34; j++) {
 7225:          // For each node and side in the element...
 7226: 
 7227:          const Node *node = elem->nodes[j];
 7228:          const Side *side = elem->sides[j];
 7229: 
 7230:          const double chi      = side->chi;
 7231:          const double veg_c2   = side->veg_c2;
 7232:          const double veg_beta = side->veg_beta;
 7233:          const double veg_h    = side->veg_h();
 7234:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7235: 
 7236:          // Node - const in elem
 7237:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7238:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7239: 
 7240:          if (elem->depth >= tip_dp) {
 7241:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7242:          }
 7243: 
 7244:          
 7245:          const double htot  = side->htot2();        // Total depth at the side
 7246:          const double zctr2 = side->zTopCanopy();  
 7247: 
 7248:          double cff1; 
 7249:          double cff2; 
 7250:          double cff3;   
 7251:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7252:          // coefficients applied to 2D/3D case 
 7253:             cff1 = side->hhat/htot;
 7254:             cff2 = 0.0;
 7255:             cff3 = 0.0;
 7256:          } else { //3D
 7257:             //Init for no-veg case
 7258:             cff1 = 1.0;
 7259:             cff2 = 1.0;
 7260:             cff3 = 0.0;
 7261: 
 7262:             if constexpr(iveg != 0) {
 7263:                // Computes coefficients used with vegetation terms G1, G2
 7264:                // cff1, cff3 are used for the first two terms in G1, G2:
 7265:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7266:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7267:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7268:                if(veg_h < 0.99*htot) { // submergent vegetation
 7269:                   cff1=1;
 7270:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7271:                   cff3 = veg_c;
 7272: 
 7273:                } else { // emergent vegetation
 7274:                   cff1 = 1.0/(1.0 + veg_c2);
 7275:                   cff2 = cff1;
 7276:                   cff3 = 0.0;
 7277: 
 7278:                }
 7279:             } // if iveg
 7280:          } //  2D/3D
 7281: 
 7282:          av_cff1 += cff1/i34;
 7283:          av_cff2 += cff2/i34;
 7284:          av_cff3 += cff3/i34;
 7285:          av_cff2_chi += cff2*chi/i34;
 7286:          av_cff3_chi += cff3*chi/i34;
 7287:          av_df += min(htot, veg_h)/(htot*i34);
 7288: 
 7289: 
 7290:          // btrack values: U^\star, U^{\star\alpha}
 7291:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7292:          Vector2 Ustar       = {0.0, 0.0}; 
 7293:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7294: 
 7295:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7296:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7297:          } else { //3D
 7298:             for (int k = side->kb; k < nvrt; k++) {
 7299:             
 7300:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7301:                Ustar += w2;
 7302: 
 7303:                if constexpr(iveg != 0) {
 7304:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7305:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7306:                        Ustar_alpha += zrat*w2; // XXXX
 7307:                    }
 7308:                }  // if iveg
 7309:             }  // for k
 7310:          }  //2D/3D
 7311:          
 7312: 
 7313:          // Add btrack & surface stress terms to \breve{G} first
 7314:          if constexpr(ics==1) {
 7315: 
 7316:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7317: 
 7318:          } else {
 7319:             // XXX IMPLEMENT THIS
 7320:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7321:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7322:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7323:          }  // if ics
 7324: 
 7325:          // Surface and bottom stress terms
 7326:          if constexpr(ics==1) {
 7327:             const Vector2 tau    = side->tau();
 7328:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7329: 
 7330:             // Term for surface and bottom stress
 7331:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7332: 
 7333:          } else {
 7334:             assert(false && "computeElemAverageGhat: Not implemented");
 7335:             // XXX IMPLEMENT THIS
 7336:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7337:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7338:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7339:             // tau_x=(vn1+tt1)/2.d0
 7340:             // tau_y=(vn2+ss1)/2.d0
 7341:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7342:          }  // if ics
 7343: 
 7344:          
 7345: 
 7346:          // All terms in F,F^\alpha,f_b except baroclinic
 7347:          // F, f_b: all explicit terms excluding vegetation 
 7348:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7349:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7350:          const double coriolis = side->coriolis;
 7351:          Vector2 F  =  coriolis*side->U;  // F_x
 7352:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7353:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7354: 
 7355:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7356:             
 7357:             for (int k = side->kb; k < nvrt; k++) {
 7358:                if (zctr2 > side->zc[k-1]) {
 7359:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7360:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7361:                    Fa +=  coriolis*w2*zrat;
 7362:                } // if zctr2
 7363:             } // k
 7364:          } // iveg
 7365: 
 7366:          // Integrate horizontal viscosity force vertically
 7367:          for (int k=side->kb + 1; k<nvrt; k++) {
 7368:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7369: 
 7370:             F += levelHorVisc;
 7371: 
 7372:             // Vegetation term
 7373:             if constexpr(iveg!=0) {
 7374:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7375:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7376:                   Fa += levelHorVisc*zrat;
 7377:                } 
 7378:             } // if iveg
 7379:          } // for k
 7380: 
 7381:          fb += side->nuGradU[side->kb];
 7382: 
 7383:          // Add to ghat1
 7384:          if constexpr(ics==2) {
 7385:             // XXX IMPLEMENT THIS
 7386:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7387:             // bigf1=vn1; bigf2=vn2
 7388:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7389:             // botf1=vn1; botf2=vn2
 7390:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7391:             // bigfa1=vn1; bigfa2=vn2
 7392:          } // if ics
 7393: 
 7394:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7395:       } // for j (nodes and sides)
 7396: 
 7397:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7398:          
 7399:       // Finish off terms in F, F^\alpha and f_b
 7400:       const double grav3 = elem->mean(&Node::grav2);
 7401:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7402: 
 7403: 
 7404:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7405:       for (int j=1; j<i34; j++) { 
 7406:          // For each side in the element...
 7407:          const Side *side = elem->sides[j];
 7408:          const double chi = side->chi;
 7409: 
 7410:          const double htot = side->htot2();
 7411:          const double veg_h = side->veg_h();
 7412:          const Vector2 F  = htot*fb;
 7413:          const Vector2 Fa = min(htot, veg_h)*fb;
 7414: 
 7415:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7416:       } // for j
 7417: 
 7418:       //botf1 etc are already in elem frame
 7419:       elem->ghat1 += tmp/i34;
 7420: 
 7421:       // Baroclinic force
 7422:       if constexpr(ibc==0) {
 7423:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7424: 
 7425:          Vector2 Fa = {0.0, 0.0};
 7426:          Vector2 intGradRho = {0.0, 0.0};
 7427:          
 7428:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7429:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7430:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7431: 
 7432:             // \in F [m^2/s/s]
 7433:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7434:          }
 7435: 
 7436:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7437:          const Vector2 F = av_df*Fa; //approx
 7438:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7439: 
 7440:       } // if ibc
 7441: 
 7442: 
 7443: 
 7444:    }
 7445: 
 7446: } // extern "C"
 7447: 
 7448: 
 7449: 
 7450: #ifdef DONTCOMPILE
 7451: __global__ void checkMassConservation(Tracers* sumtr) {
 7452: 
 7453:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7454: 
 7455:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7456: 
 7457:    Element *elem = &(mesh->localElemData[i]);
 7458: 
 7459:    // Skip dry elements
 7460:    if (elem->isDry) return;
 7461: 
 7462:    // Local sum array for this thread
 7463:    double localSum[N_TRACERS] = {0.0};
 7464: 
 7465:    // Sum over vertical levels for this element
 7466:    const int kbe = elem->kbe;
 7467:    const double area = elem->area;
 7468: 
 7469:    for (int k = kbe; k < nvrt; k++) {
 7470:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7471:       
 7472:       // Accumulate tracer mass
 7473:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7474:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7475:       }
 7476:    }
 7477: 
 7478:    
 7479: 
 7480:    //  This function returns per element sums. A reduction must be done on the host side.
 7481: }
 7482: 
 7483: 
 7484: __global__ void transport(void) {
 7485: 
 7486:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7487: 
 7488:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7489: 
 7490:    Element *elem = &(mesh->localElemData[ie]);
 7491: 
 7492:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7493: 
 7494:                for (int m=0; m<ntr; m++) {
 7495:                   for (int k=kbe(ie); k<nvrt; k++) {
 7496:                      // Calculate each polynomial's weight 
 7497:                      wm=0.d0; sum1=0.d0; 
 7498:                      wm1=0.d0; wm2=0.d0; 
 7499:                      for (int i=0; i<elem->nweno2; i++) {
 7500:                   
 7501:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7502:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7503:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7504:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7505:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7506:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7507:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7508:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7509:                      // -----------------Hu and Shu (1999)'s method----------------
 7510:                      b4=b1+b2+b3
 7511: 
 7512: //Error: add PRODUCTION CPP
 7513: #ifdef DEBUG
 7514:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7515:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7516:                     call parallel_abort(errmsg)
 7517:                   }
 7518: #endif
 7519: 
 7520:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7521:                   // !----test-------------- 
 7522:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7523:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7524:                   // !wm(i)=wm1(i)*wm2(i)
 7525:                   // !---------------------- 
 7526:                   sum1=sum1+wm(i)
 7527:                 } // end for i
 7528: 
 7529:                 wm=wm/sum1
 7530: 
 7531:                 for (int j=0; j<elem->i34; j++) {
 7532: 
 7533:                   const Side *side  = elem->sides[j];
 7534:                   const Node *node1 = side->n1;
 7535:                   const Node *node2 = side->n2;
 7536: 
 7537:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7538:                      trsd=0.d0
 7539:                      for (int kk=0; kk<nquad; kk++) {
 7540:                         for (int i=0; i<elem->nweno2; i++) {
 7541:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7542:                         } // end for i   
 7543:                      } // end for kk
 7544:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7545:                   } // outward flux
 7546:                } // end for j=1,i34(ie) ! side
 7547:             }
 7548:          }
 7549:               
 7550: 
 7551: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7552: //             //   calculate each polynomial's weight 
 7553: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7554: //                 wm=0.d0; sum1=0.d0
 7555: //                 do i=1,nweno1(ie) !for each polynomial
 7556: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7557: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7558: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7559: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7560: //                   wm(i)=b2
 7561: //                   sum1=sum1+b2
 7562: //                   !wm(i)=1.d0
 7563: //                   !sum1=sum1+1.d0
 7564: 
 7565: // // Error: PRODUCTION
 7566: // #ifdef DEBUG
 7567: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7568: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7569: //                     call parallel_abort(errmsg)
 7570: //                   endif
 7571: // #endif
 7572: 
 7573: //                 enddo !i
 7574: //                 wm=wm/sum1 !final weight
 7575: 
 7576:                 for (int j=0; j<elem->i34; j++) { // side
 7577:                   const Side *side = elem->sides[j];
 7578:                   const Node *node1 = side->n1;
 7579:                   const Node *node2 = side->n2;
 7580: 
 7581:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7582:                     trsd=0.d0
 7583:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7584:                       for (int i=0; i<elem->nweno1; i++) {
 7585:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7586:                       }
 7587:                     enddo //kk
 7588:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7589:                   } // outward flux
 7590:                 } // end for j=1,i34(ie) ! side
 7591:               } // end for k; ntr 
 7592: 
 7593:             else !simple upwind method
 7594:               do j=1,i34(ie)
 7595:                 jsj=elside(j,ie)
 7596:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7597:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7598:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7599:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7600:                   endif
 7601:                 enddo  !vertical layers
 7602:               enddo !j=1,i34(ie) ! side
 7603:             endif !order of accuracy
 7604: 
 7605:          //  enddo !ie
 7606: // !$OMP     end do
 7607: 
