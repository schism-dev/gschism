 6360:    __global__ void resetBoundaryAreas(void) {
 6361:       // Reset boundary areas and lengths for each segment.
 6362: 
 6363:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6364:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6365:       SIDE_BND(sideBnd);
 6366: 
 6367:       BoundarySegment *segment = sideBnd->segment;
 6368: 
 6369:       segment->carea = 0.0;
 6370:       segment->clen = 0.0;
 6371:  
 6372:    }
 6373: 
 6374:    __global__ void computeBoundaryAreas(void) {
 6375:    // Calculation of cross-section areas and lengths for flow b.c.
 6376: 
 6377:       SIDE_BND(sideBnd);
 6378: 
 6379:       const Side *side = sideBnd->side;
 6380:       BoundarySegment *segment = sideBnd->segment;
 6381: 
 6382:       if (segment->ifltype != 0) {
 6383: 
 6384:          const Node *n1 = side->n1;
 6385:          const Node *n2 = side->n2;
 6386: 
 6387:          const double htot = side->htot2();
 6388: 
 6389:          if (!side->isDry) {
 6390:             atomicAdd(&segment->carea, htot*side->len);
 6391:             atomicAdd(&segment->clen, side->len);
 6392:          }
 6393:       }
 6394: 
 6395:    }
 6396: 
 6397: 
 6398:    __global__ void computeFlowBcVelocities(double time) {
 6399: 
 6400:       SIDE_BND(sideBnd);
 6401: 
 6402:       const Side *side = sideBnd->side;
 6403:  
 6404:       const bool isDry = side->isDry;
 6405:       const bool isLand = sideBnd->segment->isLand;
 6406: 
 6407:    
 6408:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6409: 
 6410:       if (isDry || isLand) return;
 6411: 
 6412:       // For wet sides in open boundaries...
 6413:       const Vector2 n = side->n;
 6414:       const BoundarySegment *segment = sideBnd->segment;
 6415: 
 6416:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6417: 
 6418:       const int ifltype = segment->ifltype;
 6419: 
 6420:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6421:       const Vector2 r_nuth0 = r_uth0*n;
 6422: 
 6423: 
 6424:       if (ifltype == 1 || ifltype == 2) {
 6425:       
 6426:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6427: 
 6428:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6429: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6430:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6431:          
 6432:       } else if (ifltype == -1) { // Flather 1
 6433: 
 6434:          for (int k = 0; k < nvrt; k++) {
 6435: 
 6436:             // uth is the normal vel.; no ramp up
 6437:             const double uth = sideBnd->nuth(k);
 6438:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6439: 
 6440:             sideBnd->ubc[k] += uth*n;
 6441:          }
 6442: 
 6443:       } else if (ifltype == 3 || ifltype == 5) {
 6444:          // vnth0=0 !normal vel.
 6445: 
 6446:          Vector2 r_u1_bar = {0.0, 0.0};
 6447:          // Computes the contribution to the velocity from all tide frequencies
 6448:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6449: 
 6450:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6451:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6452: 
 6453:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6454:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6455:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6456:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6457: 
 6458:          }
 6459: 
 6460: 
 6461:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6462: 
 6463:       } // if (ifltype = 3 || ifltype == 5
 6464: 
 6465: 
 6466: 
 6467:    }
 6468: 
 6469:    __global__ void computeElevationBoundaryConditions(double time) {
 6470:       // Compute elevation essential boundary conditions 
 6471: 
 6472:       NODE_BND(nodeBnd); // Each boundary node.
 6473: 
 6474:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6475: 
 6476:       const Node *node = nodeBnd->node;
 6477:       const BoundarySegment *segment = nodeBnd->segment;
 6478:       const int iettype = segment->iettype;
 6479:       
 6480: 
 6481:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6482:       double eic = 0.0;
 6483:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6484:       else                 eic = 0.0;
 6485: 
 6486:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6487:       const double r_eth = ramp*nodeBnd->eth;
 6488:       double r_eta1_bar = 0.0;
 6489: 
 6490:       // Compute tide elevation
 6491:       if (iettype == 3 || iettype == 5) {   
 6492: 
 6493:          if constexpr(iloadtide==1) { // loading tide
 6494:             assert(false && "Loading tide not implemented");
 6495:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6496:          }
 6497:          
 6498:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6499: 
 6500:             const double efa  = nodeBnd->efa[jfr]; 
 6501:             const double emo  = nodeBnd->emo[jfr]; 
 6502: 
 6503:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6504:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6505:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6506: 
 6507: 
 6508:          } // for jfr
 6509: 
 6510:       } // if iettype
 6511: 
 6512:       switch (iettype) {
 6513:          case 1:
 6514:          case 2:
 6515:          case 4:
 6516:             nodeBnd->elbc = r_eic + r_eth;
 6517:             break;
 6518:          case 3:
 6519:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6520:             break;
 6521:          case 5:
 6522:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6523:             break;
 6524:       } // switch
 6525: 
 6526: 
 6527:       //Add inverse barometric effects
 6528:       if (iettype != 0 && inv_atm_bnd == 1) {
 6529:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6530:       }
 6531: 
 6532:    }
 6533: 
 6534: 
 6535:    __global__ void computeHorizontalViscosity(void) { 
 6536: 
 6537:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6538: 
 6539:       SIDE(side);
 6540: 
 6541:       if (side->isDry) return;
 6542: 
 6543:       for (int k = 0; k < nvrt; k++) {
 6544:          side->nuGradU[k] = {0.0, 0.0};
 6545:       }
 6546: 
 6547:       if constexpr(ihorcon == 1) {
 6548:          for (int k = side->kb; k < nvrt - 1; k++) {
 6549:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6550:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6551:             // By Zhang and Baptista.
 6552: 
 6553:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6554:             // This is a standard discretization of the Laplacian operator.
 6555:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6556:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6557:             // Gamma is hvis_coef0 in the code.
 6558:             // The value of gamma needs to be < 0.5.
 6559: 
 6560:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6561:             // side under consideration in each of the two possible elements that share the side.
 6562:             Vector2 sumU = {0.0, 0.0};
 6563:             for (int l = 0; l < 2; l++) {
 6564:                const Element *elem = side->elems[l];
 6565: 
 6566:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6567: 
 6568:                // Find the local index of the side in the element
 6569:                const int idxSide = elem->sideLocalIdx(side);
 6570: 
 6571:                // Find the two sides that are connected to the side under consideration
 6572:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6573:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6574: 
 6575:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6576: 
 6577:             }
 6578: 
 6579:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6580: 
 6581:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6582:    
 6583:          }
 6584:       }
 6585:       else if constexpr(ihorcon == 2) {
 6586:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6587:       }
 6588: 
 6589: 
 6590:    }
 6591: 
 6592: 
 6593:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6594: 
 6595:       // Set essential boundary conditions 
 6596:       NODE(node); // Each boundary node
 6597:       NodeBoundary *nodeBnd = node->nodeBnd;
 6598:       
 6599:  
 6600:       // Check if this node has essential BC
 6601:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6602: 
 6603:          // Verify BC value is valid
 6604:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6605: 
 6606:        
 6607:          // Set diagonal to 1 and zero off-diagonals
 6608:          for (int j = 0; j <= node->numNodes; j++) {
 6609:                node->coeffRow[j] = 0.0;
 6610:          }
 6611: 
 6612:          *(node->coeffDiag) = 1.0;
 6613: 
 6614: 
 6615:          // Set solution and RHS to BC value
 6616:          node->mX  = nodeBnd->elbc;
 6617:          node->qel = nodeBnd->elbc;
 6618: 
 6619:       } else {
 6620:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6621: 
 6622:          for (int j = 0; j < node->numNodes; j++) {
 6623:                const Node* nbNode = node->nodes[j];
 6624:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6625: 
 6626:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6627:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6628: 
 6629:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6630:                   // Verify neighbor's BC value
 6631:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6632: 
 6633:                   // Subtract contribution to RHS
 6634:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6635:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6636:                }
 6637:          }
 6638: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6639:       }
 6640:    }
