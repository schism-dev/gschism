 5291:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5292: 
 5293:       NODE(node);
 5294: 
 5295:       node->ETP = 0.0;
 5296: 
 5297:       if constexpr(ntip == 0) return;
 5298: 
 5299:       // For all tidal potential components
 5300:       for (int j=0; j<ntip; j++) {
 5301: 
 5302:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5303: 
 5304:          node->ETP += nodeETP;
 5305: 
 5306:          if constexpr(iloadtide==1) { // loading tide
 5307:             assert(false && "Loading tide not implemented");
 5308:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5309:          }
 5310:          
 5311:       }
 5312: 
 5313:      
 5314:    }
