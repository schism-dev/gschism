 5261:    __global__ void scaleGravity(double loadtide_coef) {
 5262: 
 5263: 
 5264:       NODE(node);
 5265: 
 5266:       // SAL option: scale gravity
 5267:       if constexpr(iloadtide==2) {  // simple const
 5268:          node->grav2 = grav*(1.0 - loadtide_coef);
 5269: 
 5270:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5271:         
 5272:           const double depth = max(node->depth, 0.0);
 5273:           const double tmp1 = sqrt(depth);
 5274:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5275:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5276:                              2.6969e-13*depth*depth*depth*tmp1;
 5277:           
 5278:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5279:           
 5280: 
 5281: 
 5282:           node->grav2 = grav*(1.0 - beta_bar);
 5283: 
 5284:       } else {  // iloadtide=0,1
 5285:           node->grav2 = grav;
 5286: 
 5287:       }
 5288: 
 5289:    }
