 2078: 
 2079: __device__ __inline__ double max3(double a, double b, double c) {
 2080:    return max(a, max(b, c));
 2081: }
 2082: 
 2083: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2084:    return min(a, min(b, min(c, d)));
 2085: }
