  966: struct Side {
  967: 
  968:    // Geometry information
  969:    int idx;               // Index of the side
  970:    Node *n1, *n2;
  971:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  972: 
  973:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  974:    Vector2 center;        // Location of side center. 
  975:    double zc[nvrt];       // Side center z-coord at each vertical level
  976: 
  977:    #ifdef USE_FRAMES
  978:    Frame frame;
  979:    #endif
  980: 
  981:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  982:                           // this is nullptr
  983:    
  984:    int kb;                // Bottom index of the side
  985:    bool isDry;            // True if the side is dry
  986:  
  987:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  988: 
  989:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  990: 
  991:    // Physical information
  992:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  993:    Vector2 btu[nvrt];           // Back-tracked velocity
  994:    Vector2 U;                   // Vertically averaged velocity vector  
  995: 
  996:    Vector2 nuGradU[nvrt];          // nu*grad u
  997: 
  998:    Vector2 bcc[nvrt];           // Baroclinic term
  999:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1000: 
 1001:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1002:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1003:    Vector2 gradPr;               // Gradient of pressure
 1004:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1005: 
 1006: 
 1007:    double hhat;                 // \breve{H} in notes
 1008: 
 1009:    double shapiro;
 1010: 
 1011:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1012: 
 1013:    double coriolis;             // Coriolis parameter
 1014: 
 1015:    // Vegetation parameters
 1016:    double veg_c2;
 1017:    double veg_beta;
 1018: 
 1019:    // Bottom drag parameters.
 1020:    double chi;
 1021:    double chi2;
 1022: 
 1023:    __inline__ __device__ Point2 outputCoords(void) const;
 1024: 
 1025:    __inline__ __device__ double x(double t) const;
 1026:    __inline__ __device__ double y(double t) const;
 1027:    __inline__ __device__ double z(double t) const;
 1028:    __inline__ __device__ double lon(void) const;
 1029:    __inline__ __device__ double lat(void) const;
 1030:    __inline__ __device__ Point2 p2_t(double t) const;
 1031:    __inline__ __device__ Point3 p3_t(double t) const;
 1032: 
 1033:    #ifdef USE_FRAMES
 1034:    __device__ void setFrame(void) {
 1035:       double lat, lon;
 1036:       const Point3 p = toPoint3(center, centerZ());
 1037: 
 1038:       // Compute the latitude and longitude of the element center
 1039:       computeLatLon(p, lat, lon);
 1040: 
 1041:       frame.update(lat, lon);        
 1042:    }
 1043:    #endif
 1044: 
 1045:    __inline__ __device__ double centerZ(void)   const;
 1046:    __inline__ __device__ Point3 center3D(int k) const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1047:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1048:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1049: 
 1050:    __inline__ __device__ Side* neigh(int index) const { 
 1051:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1052:       assert(index >= 0 && index < 4); 
 1053:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1054: 
 1055:       const int ielem = index & 1;           // 0 or 1
 1056:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1057: 
 1058:       const Element* elem = elems[ielem];
 1059: 
 1060:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1061: 
 1062:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1063: 
 1064:    }
 1065: 
 1066:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1067: 
 1068:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1069: 
 1070:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1071:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1072:    __inline__ __device__ int iadv(void) const;
 1073: 
 1074:    __inline__ __device__ double grav3(void) const;
 1075:    
 1076:    __inline__ __device__ double eta2(void) const;
 1077:    __inline__ __device__ double eta1(void) const;
 1078:    __inline__ __device__ double w2(int k) const;
 1079:    __inline__ __device__ double depth(void) const;
 1080:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1081:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1082: 
 1083:    __inline__ __device__ double dfv(int k) const;
 1084: 
 1085:    __inline__ __device__ double veg_h(void)  const;
 1086:    __inline__ __device__ double veg_nv(void) const;
 1087:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1088:    __inline__ __device__ double veg_alpha3D(int k) const;
 1089:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1090: 
 1091:    __inline__ __device__ double Cd(void) const;
 1092: 
 1093:    __inline__ __device__ Vector2 tau(void) const;
 1094: 
 1095:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1096:    
 1097: 
 1098:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1099:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1100:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1101:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1102:    } 
 1103:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1104:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1105:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1106:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1107: 
 1108:    // Get valid starting element (for backtracking)
 1109:    __inline__ __device__ Element* getStartElement() {
 1110:       return elems[0] ? elems[0] : elems[1];
 1111:    }
 1112: 
 1113:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1114:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1115:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1116: 
 1117:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1118: 
 1119:       // Dot product of the negative velocity vector with the side normal vector
 1120:       const double dot_prod1 = -dot(u, n);
 1121: 
 1122:       // Vector from side center to element 0 centroid
 1123:       const Vector2 v2 = elems[0]->center - center;
 1124: 
 1125:       // Dot product of the vector with the side normal vector
 1126:       const double dot_prod2 = dot(v2, n);
 1127: 
 1128:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1129:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1130: 
 1131:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1132:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1133: 
 1134:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1135: 
 1136:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1137:       else                           return !isDry1 ? elems[1] : elems[0];
 1138: 
 1139:  
 1140:    }
 1141: 
 1142:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1143:       // Given an element, returns the other element that shares this side
 1144:       return (elems[0] == elem) ? elems[1] : elems[0];
 1145:    }
 1146: 
 1147:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1148:       // Given a node, returns the other node that shares this side
 1149:       return (n1 == node) ? n2 : n1;
 1150:    }
 1151:  
 1152:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1153: 
 1154: 
 1155: 
 1156: 
 1157: };
 1158: 
