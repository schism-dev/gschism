 2315: __device__ void lock(int *mutex) {
 2316:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2317: }
 2318: 
 2319: __device__ void unlock(int *mutex) {
 2320:     atomicExch(mutex, 0);
 2321: }
