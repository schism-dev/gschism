  825:    
  826:    // Elevation boundary condition
  827:    int iettype;  // Type of elevation boundary condition
  828:    double eth;   // Elevation time history
  829: 
  830:    // Flow boundary condition
  831:    double qthcon;  // Flow time history constant
  832:    double vobc1;   // Velocity coefficient 1
  833:    double vobc2;   // Velocity coefficient 2
  834: 
  835:    // Tracer boundary conditions
  836:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  837:    // int  itrtype[natrm];    // Tracer boundary condition type
  838: 
  839:    BoundarySegment(bool _isLand) {
  840:       isLand = _isLand;
  841:       clen = 0.0;
  842:       carea = 0.0;
  843:       ifltype = 0;
  844:       iettype = 0;
  845:       eth = 0.0;
  846:    }
  847: 
  848:    BoundarySegment(void) {
  849:       isLand = false;
  850:       clen = 0.0;
  851:       carea = 0.0;
  852:       ifltype = 0;
  853:       iettype = 0;
  854:       eth = 0.0;
  855:    }
  856: 
  857:    
  858: };
