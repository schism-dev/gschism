 2567: 
 2568: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2569: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2570: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2571: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2572: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2573: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2574:    Vector2 grad = {0.0, 0.0};
 2575:    int count = 0;
 2576: 
 2577:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2578: 
 2579:    // First element
 2580:    if (elems[0] != nullptr && condition(elems[0])) {
 2581:       grad += elems[0]->grad2(field);
 2582:       count++;
 2583:    }
 2584: 
 2585:    // Second element
 2586:    if (elems[1] != nullptr && condition(elems[1])) {
 2587:       grad += elems[1]->grad2(field);
 2588:       count++;
 2589:    }
 2590: 
 2591:    if (count > 0) {
 2592:       grad = grad*(1.0/count);
 2593:    }
 2594:    
 2595:    return grad;
 2596: }
