 8792: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8793:    // Get the value of a variable from an side
 8794:    // varName is the name of the variable to get
 8795:    // var is the array to store the value
 8796:    // k is the vertical level index of the variable to get
 8797:    SIDE_BND(sideBnd);   
 8798: 
 8799:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8800:    if (sideBnd->segment->isLand) idx = -7;
 8801: 
 8802:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8803:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8804: 
 8805: }
