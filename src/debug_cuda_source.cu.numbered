 7266: 
 7267: __global__ void computeMatrixProductAndDotProducts() {
 7268:    // Computes A*p, r'Mr and p'Ap
 7269: 
 7270:    // 1) shared buffer: first half for rMr, second for pAp
 7271:    __shared__ double sdata[2*BLOCK_SIZE];
 7272:    double* s_rMr = sdata;
 7273:    double* s_pAp = sdata + BLOCK_SIZE;
 7274: 
 7275:    const int tid = threadIdx.x;
 7276: 
 7277:    double l_pAp = 0.0;
 7278: 
 7279:    s_rMr[tid] = 0.0;
 7280:    s_pAp[tid] = 0.0;
 7281: 
 7282:    // 2) get your node pointer
 7283:    // NODE(node);   
 7284:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7285:    Node *node = &(mesh->localNodeData[idx_node]); 
 7286:    if (idx_node < mesh->np) {
 7287: 
 7288: 
 7289:    const double diag = node->coeffDiag;
 7290:    const double r    = node->mR;
 7291:    const double p    = node->mP;  
 7292: 
 7293:    // apply preconditioner on the fly:
 7294:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7295: 
 7296:    // 4) compute Ap = A.p
 7297:    double Ap = node->coeffDiag * node->mP;
 7298:    for (int j = 0; j < node->numNodes; ++j) {
 7299:       const Node *nbNode = node->nodes[j];
 7300:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7301: 
 7302:    }
 7303: 
 7304:    node->mAp = Ap;
 7305:     
 7306: 
 7307:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7308:    // const double l_rMr = r*Mr;  // r'Mr
 7309:    l_pAp = p*Ap;  // p'Ap
 7310: 
 7311: 
 7312:    }
 7313: 
 7314:    // 6) write into shared mem
 7315:    // s_rMr[tid] = l_rMr;
 7316:    s_pAp[tid] = l_pAp;
 7317: 
 7318:    __syncthreads();
 7319: 
 7320:    // 7) block-wide tree reduction
 7321:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7322:       if (tid < stride)  {
 7323:          s_pAp[tid] += s_pAp[tid + stride];
 7324:       }
 7325:       __syncthreads();
 7326:    }
 7327: 
 7328:    // 8) thread 0 atomically accumulates into the globals
 7329:    // XXX: This is slower than it needs to be, but it is simple and works
 7330:    if (tid == 0) {
 7331:       atomicAdd(pAp, s_pAp[0]);
 7332:    }
 7333: 
 7334: 
 7335: }
 7336: 
 7337: 
 7338: __global__ void updateSolutionAndDotProducts(void) {
 7339:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7340: 
 7341:    const int tid = threadIdx.x;
 7342: 
 7343:    s_rMr[tid] = 0.0;
 7344: 
 7345:    // get node & bounds-check:
 7346:    NODE(node);
 7347: 
 7348:    
 7349:    // Compute alpha
 7350:    const double alpha = (*rMr_old)/(*pAp);
 7351: 
 7352:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7353: 
 7354: 
 7355:    // load scalars
 7356:    const double diag = node->coeffDiag;
 7357:    const double p    = node->mP;
 7358:    const double Ap   = node->mAp;
 7359:    const double x    = node->mX;
 7360:    const double r    = node->mR;
 7361:    
 7362:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7363: 
 7364:    // 1) update solution & residual
 7365:    const double x_new = x + alpha*p;
 7366:    const double r_new = r - alpha*Ap;
 7367:    node->mX = x_new;
 7368:    node->mR = r_new;
 7369: 
 7370:    // 2) apply Jacobi preconditioner on the fly
 7371:    const double Mr_new = r_new/diag;
 7372: 
 7373: 
 7374:    // 3) local contributions for the two dot-products
 7375:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7376: 
 7377:    // 4) write into shared-mem
 7378:    s_rMr[tid] = l_rMr;
 7379: 
 7380:    __syncthreads();
 7381: 
 7382: 
 7383:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7384:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7385:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7386:       __syncthreads();
 7387:    }
 7388: 
 7389:    // 6) thread 0 atomically folds into the global accumulators
 7390:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7391: 
 7392: 
 7393: }
 7394: 
 7395: 
 7396: __global__ void updateSearchDirection() {
 7397: 
 7398:     NODE(node);
 7399: 
 7400:     // recompute z on-the-fly
 7401:     const double z = node->mR / node->coeffDiag;
 7402:     const double p = node->mP;
 7403: 
 7404:     const double beta = (*rMr_new)/(*rMr_old);
 7405: 
 7406: 
 7407:     // p =z + beta*p
 7408:     node->mP = z + beta*p;
 7409: 
 7410: }
 7411: 
 7412: __global__ void initializePreconditionedResidual(double *scalars) {
 7413: 
 7414:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7415: 
 7416:     s_rMr[threadIdx.x] = 0.0;
 7417: 
 7418:     NODE(node);
 7419:     const int tid = threadIdx.x;
 7420:     // For the first iteration:
 7421:     // 1. Initial solution x = 0 (already set)
 7422:     // 2. Initial residual r = b (stored in qel)
 7423:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7424: 
 7425: // XXX we should use the guess solution here    
 7426: 
 7427:     // Set initial residual r = b (from qel)
 7428:     node->mR = node->qel;
 7429: 
 7430:     // Compute z = M^-1 * r (preconditioned residual)
 7431:     const double z = node->mR / node->coeffDiag;
 7432: 
 7433:     // Set initial search direction p = z
 7434:     node->mP = z;
 7435: 
 7436:     // Initialize other variables needed for CG
 7437:     node->mX = 0.0;  // Initial solution
 7438:     node->mAp = 0.0; // Will be computed in first iteration
 7439: 
 7440:     // These point to a cupy array in the host code
 7441:     rMr_old = scalars + 0;
 7442:     rMr_new = scalars + 1;
 7443:     pAp     = scalars + 2;
 7444: 
 7445:     // Computes the first r'Mr (reduction)
 7446:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7447: 
 7448:     // 4) write into shared-mem
 7449:     s_rMr[tid] = l_rMr;
 7450: 
 7451:     __syncthreads();
 7452: 
 7453: 
 7454:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7455:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7456:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7457:         __syncthreads();
 7458:     }
 7459: 
 7460:     // 6) thread 0 atomically folds into the global accumulators
 7461:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7462: 
 7463:     *rMr_old = 0.0;
 7464:     *pAp = 0.0;
 7465: }
 7466: 
 7467: 
 7468: 
 7469: 
 7470: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7471:    // Get the value of a variable from an element
 7472:    // varName is the name of the variable to get
 7473:    // var is the array to store the value
 7474:    // k is the vertical level index of the variable to get
 7475: 
 7476:    ELEM(elem);
 7477:    
 7478:    int idx = elem->idx;
 7479:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7480: 
 7481:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7482:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7483:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7484:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7485:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7486:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7487:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7488:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7489:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7490:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7491:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7492:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7493:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7494:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7495:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7496:       
 7497:    
 7498: }
 7499: 
 7500: 
 7501: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7502:    // Get the value of a variable from an node
 7503:    // varName is the name of the variable to get
 7504:    // var is the array to store the value
 7505:    // k is the vertical level index of the variable to get
 7506: 
 7507:    NODE(node);
 7508:    
 7509:    int idx = node->idx;
 7510:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7511: 
 7512:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7513:    
 7514:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7515:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7516:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7517:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7518:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7519:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7520:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7521:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7522:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7523:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7524:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7525:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7526:    
 7527:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7528:       
 7529:    
 7530: }
 7531: 
 7532: 
 7533: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7534:    // Get the value of a variable from an side
 7535:    // varName is the name of the variable to get
 7536:    // var is the array to store the value
 7537:    // k is the vertical level index of the variable to get
 7538:    SIDE(side);
 7539:    
 7540:    int idx = side->idx;
 7541:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7542: 
 7543:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7544:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7545:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7546:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7547:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7548:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7549:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7550:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7551:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7552:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7553:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7554:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7555:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7556:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7557:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7558:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7559:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7560:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7561:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7562:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7563:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7564:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7565:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7566:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7567:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7568:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7569:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7570:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7571:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7572:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7573:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7574:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7575:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7576:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7577: }
