 4398:    __global__ void computeFlowBcVelocities(double time) {
 4399: 
 4400:       SIDE_BND(sideBnd);
 4401: 
 4402:       const Side *side = sideBnd->side;
 4403:  
 4404:       const bool isDry = side->isDry;
 4405:       const bool isLand = sideBnd->segment->isLand;
 4406: 
 4407:    
 4408:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4409: 
 4410:       if (isDry || isLand) return;
 4411: 
 4412:       // For wet sides in open boundaries...
 4413:       const Vector2 n = side->n;
 4414:       const BoundarySegment *segment = sideBnd->segment;
 4415: 
 4416:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4417: 
 4418:       const int ifltype = segment->ifltype;
 4419: 
 4420:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4421:       const Vector2 r_nuth0 = r_uth0*n;
 4422: 
 4423: 
 4424:       if (ifltype == 1 || ifltype == 2) {
 4425:       
 4426:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4427: 
 4428:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4429:          
 4430:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4431:          
 4432:       } else if (ifltype == -1) { // Flather 1
 4433: 
 4434:          for (int k = 0; k < nvrt; k++) {
 4435: 
 4436:             // uth is the normal vel.; no ramp up
 4437:             const double uth = sideBnd->nuth(k);
 4438:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4439: 
 4440:             sideBnd->ubc[k] += uth*n;
 4441:          }
 4442: 
 4443:       } else if (ifltype == 3 || ifltype == 5) {
 4444:          // vnth0=0 !normal vel.
 4445: 
 4446:          Vector2 r_u1_bar = {0.0, 0.0};
 4447:          // Computes the contribution to the velocity from all tide frequencies
 4448:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4449: 
 4450:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4451:             const Vector2 umo  = sideBnd->umo(jfr); 
 4452: 
 4453:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4454:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4455:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4456:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4457:          }
 4458: 
 4459: 
 4460:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4461: 
 4462:       } // if (ifltype = 3 || ifltype == 5
 4463: 
 4464: 
 4465: 
 4466:    }
 4467: 
 4468:    __global__ void computeElevationBoundaryConditions(double time) {
 4469:       // Compute elevation essential boundary conditions 
 4470: 
 4471:       NODE_BND(nodeBnd); // Each boundary node.
 4472: 
 4473:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4474: 
 4475:       const Node *node = nodeBnd->node;
 4476:       const BoundarySegment *segment = nodeBnd->segment;
 4477:       const int iettype = segment->iettype;
 4478:       
 4479: 
 4480:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4481:       double eic = 0.0;
 4482:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4483:       else                 eic = 0.0;
 4484: 
 4485:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4486:       const double r_eth = ramp*nodeBnd->eth;
 4487:       double r_eta1_bar = 0.0;
 4488: 
 4489: 
 4490:       // Compute tide elevation
 4491:       if (iettype == 3 || iettype == 5) {   
 4492: 
 4493:          if constexpr(iloadtide==1) { // loading tide
 4494:             assert(false && "Loading tide not implemented");
 4495:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4496:          }
 4497:          
 4498:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4499: 
 4500:             const double efa  = nodeBnd->efa[jfr]; 
 4501:             const double emo  = nodeBnd->emo[jfr]; 
 4502: 
 4503:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4504:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4505:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4506: 
 4507:          } // for jfr
 4508: 
 4509:       } // if iettype
 4510: 
 4511:       switch (iettype) {
 4512:          case 1:
 4513:          case 2:
 4514:          case 4:
 4515:             nodeBnd->elbc = r_eic + r_eth;
 4516:             break;
 4517:          case 3:
 4518:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4519:             break;
 4520:          case 5:
 4521:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4522:             break;
 4523:       } // switch
 4524: 
 4525: 
 4526:       //Add inverse barometric effects
 4527:       if (iettype != 0 && inv_atm_bnd == 1) {
 4528:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4529:       }
 4530: 
 4531:    }
 4532: 
 4533: 
 4534:    __global__ void computeHorizontalViscosity(void) { 
 4535: 
 4536:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4537: 
 4538:       SIDE(side);
 4539: 
 4540:       if (side->isDry) return;
 4541: 
 4542:       for (int k = 0; k < nvrt; k++) {
 4543:          side->nuGradU[k] = {0.0, 0.0};
 4544:       }
 4545: 
 4546:       if constexpr(ihorcon == 1) {
 4547:          for (int k = side->kb; k < nvrt - 1; k++) {
 4548:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4549:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4550:             // By Zhang and Baptista.
 4551: 
 4552:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4553:             // This is a standard discretization of the Laplacian operator.
 4554:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4555:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4556:             // Gamma is hvis_coef0 in the code.
 4557:             // The value of gamma needs to be < 0.5.
 4558: 
 4559:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4560:             // side under consideration in each of the two possible elements that share the side.
 4561:             Vector2 sumU = {0.0, 0.0};
 4562:             for (int l = 0; l < 2; l++) {
 4563:                const Element *elem = side->elems[l];
 4564: 
 4565:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4566: 
 4567:                // Find the local index of the side in the element
 4568:                const int idxSide = elem->sideLocalIdx(side);
 4569:                // Find the two sides that are connected to the side under consideration
 4570:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4571:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4572: 
 4573:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4574: 
 4575:             }
 4576: 
 4577:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4578:    
 4579:          }
 4580:       }
 4581:       else if constexpr(ihorcon == 2) {
 4582:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4583:       }
 4584: 
 4585: 
 4586:    }
 4587: 
 4588: 
 4589:    __global__ void setEssentialBC(void) {
 4590:       // Set essential boundary conditions 
 4591:       NODE(node); // Each boundary node
 4592:       NodeBoundary *nodeBnd = node->nodeBnd;
 4593:       
 4594: // nodeBnd->isEssentialBC = true;      
 4595:       // Check if this node has essential BC
 4596:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4597:          // Verify BC value is valid
 4598:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4599: 
 4600:        
 4601:          // Set diagonal to 1 and zero off-diagonals
 4602:          node->coeffDiag = 1.0;
 4603: 
 4604:          for (int j = 0; j < node->numNodes; j++) {
 4605:                node->coeffMatrix[j] = 0.0;
 4606:          }
 4607:          
 4608:          // Set solution and RHS to BC value
 4609:          node->mX  = nodeBnd->elbc;
 4610:          node->qel = nodeBnd->elbc;
 4611: 
 4612:       } else {
 4613:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4614: 
 4615:          for (int j = 0; j < node->numNodes; j++) {
 4616:                Node* nbNode = node->nodes[j];
 4617:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4618:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4619:                   // Verify neighbor's BC value
 4620:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4621: 
 4622:                   // Subtract contribution to RHS
 4623:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4624:                   node->coeffMatrix[j] = 0.0;  
 4625:                }
 4626:          }
 4627:       }
 4628:    }
 4629: 
 4630: 
 4631:    __global__ void updateElevation(void) {
 4632:       NODE(node);
 4633: 
 4634:       node->eta2 = node->mX;
 4635: 
 4636:       node->updateZCoordData();
 4637:    }
