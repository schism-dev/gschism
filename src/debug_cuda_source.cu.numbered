 1916: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1917: // return;   
 1918:    // Lock the mutex
 1919:    lock(&debugPlotMutex);
 1920:  
 1921:    bool ok = true;
 1922:    if (debugPlotIdx == nullptr) ok = false;
 1923:    if (*debugPlotIdx >= 10000) ok = false;
 1924:    if (ok) {
 1925:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1926:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1927:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1928:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1929:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1930:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 1931:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 1932:       (*debugPlotIdx)++;
 1933:    }
 1934: 
 1935:    __threadfence();               // ensure all above writes are visible
 1936:    // Unlock the mutex
 1937:    unlock(&debugPlotMutex);
 1938: 
 1939: }
 1940: 
 1941: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 1942:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 1943: }
