 2186: 
 2187: /**  Interpolate velocities at a given point (xt,yt,zt)
 2188: 
 2189:    @param xt, yt, zt: coordinates of the point to interpolate
 2190:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2191: 
 2192:    This is done in four steps:
 2193: 
 2194:    1. Find the shape coordinates for the final position in the element.
 2195:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2196:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2197:       z levels at xt, yt at each step.   
 2198:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2199:       horizontally and vertically.
 2200: **/
 2201: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2202:    // Interpolate the velocities at the point xt. 
 2203:    // This function works the same for triangular and quadrilateral elements.
 2204:    double shpCoord[4];
 2205: 
 2206:    // First step is to compute the shape coordinates of (xt,yt)
 2207:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2208:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2209: 
 2210:    // Second step is to find the level that contains zt
 2211:    // Uses a binary search to find the level
 2212:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2213:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2214:    int R = nvrt - 1;
 2215: 
 2216:    // Get the z coordinates at the nodes of the element at the levels L and R
 2217:    double zLAtNodes[4], zRAtNodes[4];
 2218:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2219:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2220: 
 2221:    double zL = interpolate(shpCoord, zLAtNodes);
 2222:    double zR = interpolate(shpCoord, zRAtNodes);
 2223:    
 2224:    // Interpolates vertically the velocities
 2225:    double wght1, wght2;
 2226:    if (xt.z<=zL) {
 2227:       wght1 = 1.0;
 2228:       wght2 = 0.0;
 2229:    }
 2230:    else if (xt.z>=zR) {
 2231:       wght1 = 0.0;
 2232:       wght2 = 1.0;
 2233:    }
 2234:    else {
 2235:       // Perform a binary search to find the levels between L and R that contain xt.z
 2236:       while (R - L > 1) {
 2237:          int M = (L + R) / 2;
 2238: 
 2239:          double zMAtNodes[4];
 2240:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2241:          double zM = interpolate(shpCoord, zMAtNodes);
 2242:          if (zM < xt.z) 
 2243:          {
 2244:             L = M;
 2245:             zL = zM;
 2246:          }
 2247:          else 
 2248:          {
 2249:             R = M;
 2250:             zR = zM;
 2251:          }
 2252:       }
 2253:       assert(L == R-1);
 2254:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2255: 
 2256:       wght2 = (xt.z - zL)/(zR - zL);
 2257:       wght1 = 1.0 - wght2;
 2258:    }
 2259: 
 2260:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2261:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2262: 
 2263:    // Neither of the interpolated velocities should be NaN
 2264:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2265: 
 2266: }
 2267: 
