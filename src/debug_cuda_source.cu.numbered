 9060: __global__ void printMatrix(bool full) {
 9061:    // Debugging: print the FEM matrix row for each local node
 9062: 
 9063:    const int size = mesh->np;
 9064:    double sum = 0.0;
 9065: 
 9066:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9067:       const Node *node = mesh->localNodeData + idx_node;
 9068: 
 9069:       if (full)
 9070:          printf("idx_node = %d [%d] diag=%lf, [",
 9071:                 idx_node, node->numNodes, *(node->coeffDiag));
 9072: 
 9073:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9074:       for (int k = 0; k < node->numNodes + 1; k++)
 9075:          sum += node->coeffRow[k];
 9076: 
 9077:       for (int j = 0; j < node->numNodes; j++) {
 9078:          const Node *nbNode = node->nodes[j];
 9079:          const double aij = node->coeffRow[node->csrSlot[j]];
 9080:          if (full && aij != 0.0)
 9081:             printf("%d:%f,  ", nbNode->idx, aij);
 9082:       }
 9083: 
 9084:       if (full) printf("]\n");
 9085:    }
 9086: 
 9087:    if (!full) printf("sum=%lf\n", sum);
 9088: }
 9089: 
