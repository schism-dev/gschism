 2175: // Helper functions for computing the local node index at a given offset from another.
 2176: __device__ __inline__ int nxq(int offset, int index, int size) {
 2177:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2178:    // to the index to make it positive
 2179:    assert(index + offset + 16*size >= 0);
 2180:    return (index + offset + 16*size) % size;  
 2181: }
 2182: 
 2183: __device__ __inline__ int nxq(int index, int size) {
 2184:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2185:    // to the index to make it positive
 2186:    assert(index + 16*size >= 0);
 2187:    return (index + 16*size) % size; 
 2188: }
