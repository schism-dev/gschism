 4189:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4190: 
 4191:       NODE_BND(nodeBnd);
 4192: 
 4193:       Node *node = nodeBnd->node;
 4194: 
 4195:       node->ETP = 0.0;
 4196: 
 4197:       for (int j=0; j<ntip; j++) {
 4198: 
 4199:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4200:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4201:    
 4202:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4203: 
 4204:          if constexpr(iloadtide==1) { // loading tide
 4205:             assert(false && "Loading tide not implemented");
 4206:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4207:          }
 4208:          
 4209:       }
 4210:       
 4211:    }
