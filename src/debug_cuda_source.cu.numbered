 1900: __device__ __forceinline__ double Element::centerZ(void) const { 
 1901:    assert(!isQuad() && "centerZ only works for triangles");
 1902: 
 1903:    if constexpr(ics==1) { 
 1904:       return 0.0; 
 1905:    } else { 
 1906:       return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1907:    } 
 1908: }
