 9550: 
 9551: __global__ void returnMatrix(double *res) {
 9552:    // Debugging: dense local matrix, row-major, size = mesh->np
 9553:    // Assumes single-partition / local indexing (see note below).
 9554: 
 9555:    const int size = mesh->np;
 9556: 
 9557:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9558:       const Node *node = mesh->localNodeData + idx_node;
 9559: 
 9560:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9561: 
 9562:       for (int j = 0; j < node->numNodes; j++) {
 9563:          const Node *nbNode = node->nodes[j];
 9564:          // Only dump neighbors that live on this partition
 9565:          if (nbNode->part != mesh->partNum) continue;
 9566: 
 9567:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9568:          const double aij = node->coeffRow[node->csrSlot[j]];
 9569:          if (aij != 0.0)
 9570:             res[jlocal * size + idx_node] = aij;
 9571:       }
 9572:    }
 9573: }
 9574: 
 9575: 
 9576: __global__ void returnX(double *res) {
 9577:    // Debugging: returns the matrix as a CuPy array
 9578: 
 9579:    const int size = mesh->np;
 9580:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9581:       const Node *node = mesh->localNodeData + idx_node;
 9582: 
 9583:       res[idx_node] = node->mX;
 9584: 
 9585:    }
 9586:    
 9587: }
 9588: 
 9589: 
 9590: __global__ void returnB(double *res) {
