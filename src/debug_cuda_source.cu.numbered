 1182:    __device__ __forceinline__ Vector2 grad2(double *a) const
 1183:    {
 1184:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
 1185:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
 1186:       if (isQuad()) {
 1187:          gx += a[3]*gradPhi[3].x;
 1188:          gy += a[3]*gradPhi[3].y;
 1189:       }
 1190:       return {gx, gy};
 1191:    }
 1192: 
 1193:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
 1194:    {
 1195:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
 1196:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
 1197:       if (isQuad()) {
 1198:          gx += (nodes[3]->*field)*gradPhi[3].x;
 1199:          gy += (nodes[3]->*field)*gradPhi[3].y;
 1200:       }
 1201:       return {gx, gy};
 1202:    }
