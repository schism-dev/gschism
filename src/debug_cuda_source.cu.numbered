 6865: //                 !  do jj=1,ntr
 6866: //                 !    adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 6867: //                 !  enddo
