  480: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  481:    x3 = y1*z2 - y2*z1;
  482:    y3 = x2*z1 - x1*z2;
  483:    z3 = x1*y2 - x2*y1;
  484: // XXXXXX IS THIS REPEATED????
  485: }
