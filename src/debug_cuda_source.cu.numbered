 2239: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2240: {
 2241:     uintptr_t p = (uintptr_t)address;
 2242:     assert((p & 1) == 0);
 2243: 
 2244:     unsigned int* base = (unsigned int*)(p & ~3);
 2245:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2246:                                   :  (unsigned int)val;
 2247: 
 2248:     atomicAdd(base, addend);
 2249: }
