  182: using Vector2 = double2; 
  183: using Vector3 = double3;
  184: using Point2  = double2;
  185: using Point3  = double3;
  186: 
  187: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  188:     return make_double2(a.x + b.x, a.y + b.y);
  189: }
  190: using Vector2 = double2; 
  191: using Vector3 = double3;
  192: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  193:     a.x += b.x;
  194:     a.y += b.y;
  195:     return a;
  196: }
  197: 
  198: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  199:     return make_double2(a.x - b.x, a.y - b.y);
  200: }
  201: 
  202: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  203:     a.x -= b.x;
  204:     a.y -= b.y;
  205:     return a;
  206: }
  207: 
  208: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  209:     return make_double2(v.x * s, v.y * s);
  210: }
  211: 
  212: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  213:     return v * s;  // reuse the previous operator
  214: }
  215: 
  216: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  217:     return make_double2(v.x / s, v.y / s);
  218: }
  219: 
  220: __device__ __forceinline__ double norm2(const double2& v) {
  221:     return v.x*v.x + v.y*v.y;
  222: }
  223: 
  224: __device__ __forceinline__ double length(const double2& v) {
  225:     return sqrt(v.x*v.x + v.y*v.y);
  226: }
  227: 
  228: __device__ __forceinline__ double2 normalize(const double2& v) {
  229:     return v / length(v);
  230: }
  231: 
  232: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  233:     return v.x*w.x + v.y*w.y;
  234: }
  235: 
  236: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  237:     return v.x*w.y - v.y*w.x;
  238: }
  239: 
  240: __device__ __forceinline__ double2 rot90(const double2& a) {
  241:     return make_double2(a.y, -a.x);
  242: }
  243: 
  244: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  245:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  246: }
  247: 
  248: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  249:     a.x += b.x;
  250:     a.y += b.y;
  251:     a.z += b.z;
  252:     return a;
  253: }
  254: 
  255: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  256:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
