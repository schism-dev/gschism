 2354:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2355:    // Project the vectors from the node frame to the element frame
 2356: 
 2357:  
 2358:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2359:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2360:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2361:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2362:       else          v[3] = Vector2();
 2363:    }
