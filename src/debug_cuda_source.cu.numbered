 7273: 
 7274: __global__ void computeMatrixProductAndDotProducts() {
 7275:    // Computes A*p, r'Mr and p'Ap
 7276: 
 7277:    // 1) shared buffer: first half for rMr, second for pAp
 7278:    __shared__ double sdata[2*BLOCK_SIZE];
 7279:    double* s_rMr = sdata;
 7280:    double* s_pAp = sdata + BLOCK_SIZE;
 7281: 
 7282:    const int tid = threadIdx.x;
 7283: 
 7284:    double l_pAp = 0.0;
 7285: 
 7286:    s_rMr[tid] = 0.0;
 7287:    s_pAp[tid] = 0.0;
 7288: 
 7289:    // 2) get your node pointer
 7290:    // NODE(node);   
 7291:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7292:    Node *node = &(mesh->localNodeData[idx_node]); 
 7293:    if (idx_node < mesh->np) {
 7294: 
 7295: 
 7296:    const double diag = node->coeffDiag;
 7297:    const double r    = node->mR;
 7298:    const double p    = node->mP;  
 7299: 
 7300:    // apply preconditioner on the fly:
 7301:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7302: 
 7303:    // 4) compute Ap = A.p
 7304:    double Ap = node->coeffDiag * node->mP;
 7305:    for (int j = 0; j < node->numNodes; ++j) {
 7306:       const Node *nbNode = node->nodes[j];
 7307:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7308: 
 7309:    }
 7310: 
 7311:    node->mAp = Ap;
 7312:     
 7313: 
 7314:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7315:    // const double l_rMr = r*Mr;  // r'Mr
 7316:    l_pAp = p*Ap;  // p'Ap
 7317: 
 7318: 
 7319:    }
 7320: 
 7321:    // 6) write into shared mem
 7322:    // s_rMr[tid] = l_rMr;
 7323:    s_pAp[tid] = l_pAp;
 7324: 
 7325:    __syncthreads();
 7326: 
 7327:    // 7) block-wide tree reduction
 7328:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7329:       if (tid < stride)  {
 7330:          s_pAp[tid] += s_pAp[tid + stride];
 7331:       }
 7332:       __syncthreads();
 7333:    }
 7334: 
 7335:    // 8) thread 0 atomically accumulates into the globals
 7336:    // XXX: This is slower than it needs to be, but it is simple and works
 7337:    if (tid == 0) {
 7338:       atomicAdd(pAp, s_pAp[0]);
 7339:    }
 7340: 
 7341: 
 7342: }
 7343: 
 7344: 
 7345: __global__ void updateSolutionAndDotProducts(void) {
 7346:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7347: 
 7348:    const int tid = threadIdx.x;
 7349: 
 7350:    s_rMr[tid] = 0.0;
 7351: 
 7352:    // get node & bounds-check:
 7353:    NODE(node);
 7354: 
 7355:    
 7356:    // Compute alpha
 7357:    const double alpha = (*rMr_old)/(*pAp);
 7358: 
 7359:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7360: 
 7361: 
 7362:    // load scalars
 7363:    const double diag = node->coeffDiag;
 7364:    const double p    = node->mP;
 7365:    const double Ap   = node->mAp;
 7366:    const double x    = node->mX;
 7367:    const double r    = node->mR;
 7368:    
 7369:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7370: 
 7371:    // 1) update solution & residual
 7372:    const double x_new = x + alpha*p;
 7373:    const double r_new = r - alpha*Ap;
 7374:    node->mX = x_new;
 7375:    node->mR = r_new;
 7376: 
 7377:    // 2) apply Jacobi preconditioner on the fly
 7378:    const double Mr_new = r_new/diag;
 7379: 
 7380: 
 7381:    // 3) local contributions for the two dot-products
 7382:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7383: 
 7384:    // 4) write into shared-mem
 7385:    s_rMr[tid] = l_rMr;
 7386: 
 7387:    __syncthreads();
 7388: 
 7389: 
 7390:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7391:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7392:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7393:       __syncthreads();
 7394:    }
 7395: 
 7396:    // 6) thread 0 atomically folds into the global accumulators
 7397:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7398: 
 7399: 
 7400: }
 7401: 
 7402: 
 7403: __global__ void updateSearchDirection() {
 7404: 
 7405:     NODE(node);
 7406: 
 7407:     // recompute z on-the-fly
 7408:     const double z = node->mR / node->coeffDiag;
 7409:     const double p = node->mP;
 7410: 
 7411:     const double beta = (*rMr_new)/(*rMr_old);
 7412: 
 7413: 
 7414:     // p =z + beta*p
 7415:     node->mP = z + beta*p;
 7416: 
 7417: }
 7418: 
 7419: __global__ void initializePreconditionedResidual(double *scalars) {
 7420: 
 7421:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7422: 
 7423:     s_rMr[threadIdx.x] = 0.0;
 7424: 
 7425:     NODE(node);
 7426:     const int tid = threadIdx.x;
 7427:     // For the first iteration:
 7428:     // 1. Initial solution x = 0 (already set)
 7429:     // 2. Initial residual r = b (stored in qel)
 7430:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7431: 
 7432: // XXX we should use the guess solution here    
 7433: 
 7434:     // Set initial residual r = b (from qel)
 7435:     node->mR = node->qel;
 7436: 
 7437:     // Compute z = M^-1 * r (preconditioned residual)
 7438:     const double z = node->mR / node->coeffDiag;
 7439: 
 7440:     // Set initial search direction p = z
 7441:     node->mP = z;
 7442: 
 7443:     // Initialize other variables needed for CG
 7444:     node->mX = 0.0;  // Initial solution
 7445:     node->mAp = 0.0; // Will be computed in first iteration
 7446: 
 7447:     // These point to a cupy array in the host code
 7448:     rMr_old = scalars + 0;
 7449:     rMr_new = scalars + 1;
 7450:     pAp     = scalars + 2;
 7451: 
 7452:     // Computes the first r'Mr (reduction)
 7453:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7454: 
 7455:     // 4) write into shared-mem
 7456:     s_rMr[tid] = l_rMr;
 7457: 
 7458:     __syncthreads();
 7459: 
 7460: 
 7461:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7462:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7463:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7464:         __syncthreads();
 7465:     }
 7466: 
 7467:     // 6) thread 0 atomically folds into the global accumulators
 7468:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7469: 
 7470:     *rMr_old = 0.0;
 7471:     *pAp = 0.0;
 7472: }
 7473: 
 7474: 
 7475: 
 7476: 
 7477: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7478:    // Get the value of a variable from an element
 7479:    // varName is the name of the variable to get
 7480:    // var is the array to store the value
 7481:    // k is the vertical level index of the variable to get
 7482: 
 7483:    ELEM(elem);
 7484:    
 7485:    int idx = elem->idx;
 7486:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7487: 
 7488:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7489:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7490:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7491:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7492:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7493:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7494:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7495:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7496:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7497:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7498:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7499:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7500:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7501:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7502:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7503:       
 7504:    
 7505: }
 7506: 
 7507: 
 7508: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7509:    // Get the value of a variable from an node
 7510:    // varName is the name of the variable to get
 7511:    // var is the array to store the value
 7512:    // k is the vertical level index of the variable to get
 7513: 
 7514:    NODE(node);
 7515:    
 7516:    int idx = node->idx;
 7517:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7518: 
 7519:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7520:    
 7521:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7522:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7523:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7524:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7525:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7526:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7527:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7528:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7529:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7530:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7531:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7532:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7533:    
 7534:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7535:       
 7536:    
 7537: }
 7538: 
 7539: 
 7540: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7541:    // Get the value of a variable from an side
 7542:    // varName is the name of the variable to get
 7543:    // var is the array to store the value
 7544:    // k is the vertical level index of the variable to get
 7545:    SIDE(side);
 7546:    
 7547:    int idx = side->idx;
 7548:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7549: 
 7550:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7551:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7552:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7553:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7554:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7555:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7556:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7557:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7558:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7559:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7560:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7561:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7562:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7563:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7564:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7565:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7566:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7567:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7568:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7569:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7570:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7571:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7572:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7573:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7574:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7575:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7576:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7577:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7578:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7579:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7580:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7581:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7582:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7583:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7584: }
