 1245: struct Side {
 1246: 
 1247:    // Geometry information
 1248:    int idx;               // Index of the side
 1249:    Node *n1, *n2;
 1250:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1251: 
 1252:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1253:    Vector2 center;        // Location of side center. 
 1254:    double zc[nvrt];       // Side center z-coord at each vertical level
 1255: 
 1256:    Frame<ics> frame;
 1257:    
 1258:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1259:                           // this is nullptr
 1260:    
 1261:    int16_t kb;            // Bottom index of the side
 1262:    bool isDry;            // True if the side is dry
 1263:  
 1264:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1265: 
 1266:    Tracers tracers[nvrt]; // Tracer concentrations at nodes
 1267: 
 1268:    // Physical information
 1269:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1270:    Vector2 btu[nvrt];           // Back-tracked velocity
 1271:    Vector2 U;                   // Vertically averaged velocity vector  
 1272: 
 1273:    Vector2 nuGradU[nvrt];          // nu*grad u
 1274: 
 1275:    Vector2 bcc[nvrt];           // Baroclinic term
 1276:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1277: 
 1278:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1279:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1280:    Vector2 gradPr;               // Gradient of pressure
 1281:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1282: 
 1283: 
 1284:    double hhat;                 // \breve{H} in notes
 1285: 
 1286:    double shapiro;
 1287: 
 1288:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1289: 
 1290:    double coriolis;             // Coriolis parameter
 1291: 
 1292:    // Vegetation parameters
 1293:    double veg_c2;
 1294:    double veg_beta;
 1295: 
 1296:    // Bottom drag parameters.
 1297:    double chi;
 1298:    double chi2;
 1299: 
 1300:    __inline__ __device__ Point2 outputCoords(void) const;
 1301: 
 1302:    __inline__ __device__ double x(double t) const;
 1303:    __inline__ __device__ double y(double t) const;
 1304:    __inline__ __device__ double z(double t) const;
 1305:    __inline__ __device__ double lon(void) const;
 1306:    __inline__ __device__ double lat(void) const;
 1307:    __inline__ __device__ Point2 p2_t(double t) const;
 1308: 
 1309:    __device__ void setFrame(void) {
 1310:       if constexpr(ics == 1) return;
 1311: 
 1312:       double lat, lon;
 1313:       const Point3 p = toPoint3(center, centerZ());
 1314: 
 1315:       // Compute the latitude and longitude of the element center
 1316:       computeLatLon(p, lat, lon);
 1317: 
 1318:       frame.update(lat, lon);        
 1319:    }
 1320:    
 1321: 
 1322:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1323:    // If ics == 2, convert the global point to the local frame of the side
 1324:       
 1325:       if constexpr (ics == 1) {
 1326:          return p;
 1327:       } else {
 1328:          const Point3 c = {center.x, center.y, centerZ()};
 1329:          const Point3 local = frame.G2L(p - c);
 1330:          return local;
 1331:       }
 1332:    }
 1333: 
 1334:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1335:       if constexpr (ics == 1) {
 1336:          return p;
 1337:       } else {
 1338:          const Point3 c = {center.x, center.y, centerZ()};
 1339:          return c + frame.L2G(p);
 1340:       }
 1341:    }
 1342: 
 1343: 
 1344:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1345:       if constexpr(ics == 1) return v;
 1346:       else return v_frame.projHorVec(v, frame);
 1347:    }
 1348: 
 1349:    __inline__ __device__ double centerZ(void)      const;
 1350:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1351:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1352:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1353:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1354: 
 1355:    __inline__ __device__ Side* neigh(int index) const { 
 1356:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1357:       assert(index >= 0 && index < 4); 
 1358:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1359: 
 1360:       const int ielem = index & 1;           // 0 or 1
 1361:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1362: 
 1363:       const Element* elem = elems[ielem];
 1364: 
 1365:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1366: 
 1367:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1368: 
 1369:    }
 1370: 
 1371:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1372: 
 1373:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1374: 
 1375:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1376:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1377:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1378:    __inline__ __device__ int iadv(void) const;
 1379: 
 1380:    __inline__ __device__ double grav3(void) const;
 1381:    
 1382:    __inline__ __device__ double eta2(void) const;
 1383:    __inline__ __device__ double eta1(void) const;
 1384:    __inline__ __device__ double w2(int k) const;
 1385:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1386:    __inline__ __device__ double depth(void) const;
 1387:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1388:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1389: 
 1390:    __inline__ __device__ double dfv(int k) const;
 1391: 
 1392:    __inline__ __device__ double veg_h(void)  const;
 1393:    __inline__ __device__ double veg_nv(void) const;
 1394:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1395:    __inline__ __device__ double veg_alpha3D(int k) const;
 1396:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1397: 
 1398:    __inline__ __device__ double Cd(void) const;
 1399: 
 1400:    __inline__ __device__ Vector2 tau(void) const;
 1401: 
 1402:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1403:    
 1404: 
 1405:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1406:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1407:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1408:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1409:    } 
 1410:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1411:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1412:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1413:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1414: 
 1415:    // Get valid starting element (for backtracking)
 1416:    __inline__ __device__ Element* getStartElement() {
 1417:       return elems[0] ? elems[0] : elems[1];
 1418:    }
 1419: 
 1420:    
 1421:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1422:       // Given an element, returns the other element that shares this side
 1423:       return (elems[0] == elem) ? elems[1] : elems[0];
 1424:    }
 1425: 
 1426:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1427:       // Given a node, returns the other node that shares this side
 1428:       return (n1 == node) ? n2 : n1;
 1429:    }
 1430:  
 1431:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1432: 
 1433: 
 1434: 
 1435: 
 1436: };
