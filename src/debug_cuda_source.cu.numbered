 2292: 
 2293: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2294:    // Returns the value of the velocity at the side center
 2295:    const double w1 = getBoundaryArrayValueWeight();
 2296:    const double w2 = 1.0 - w1;
 2297:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2298:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2299: 
 2300:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2301: }
 2302: 
 2303: 
 2304: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2305:    // Returns the value of the normal component of the velocity at the side center
 2306:    const double w1 = getBoundaryArrayValueWeight();
 2307:    const double w2 = 1.0 - w1;
 2308:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2309:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2310: 
 2311:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2312: }
