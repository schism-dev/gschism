 7226: #ifdef DONTCOMPILE
 7227: __device__ void computeVerticalAdvection(void) {
 7228:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7229: 
 7230:    sdbt(1:2,:,:)=0.d0
 7231: 
 7232:    const Side *side = FROM kernel;
 7233: 
 7234:    if(side->isDry) return;
 7235: 
 7236:    // If side is wet...
 7237: 
 7238: 
 7239:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7240:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7241:    double ws[nvrt] = {} // w @ side
 7242:    int icount = 0;
 7243:    for (int j=0; j<2; j++) {
 7244:       const Element *elem = side->elements[j];
 7245:        
 7246:       if(elem != nullptr) {
 7247:          icount++;
 7248:          for (int k=0; k<nvrt; k++) {
 7249:             ws[k] = ws[k] + elem->w[k];
 7250:          }
 7251:       }
 7252:    }  // for j
 7253: 
 7254:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7255:    ws = ws/icount;
 7256: 
 7257:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7258:    // Splines allow for a smooth transition between vertical levels.
 7259:    // Splines have continuity restrictions at the internal knots, but
 7260:    // we have to provide the 1st derivatives at the endpoints.
 7261:    const int kbs = side->kbs; 
 7262:    
 7263:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7264:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7265:    initCubicSpline(kbs, nvrt, side, ws, up)
 7266: 
 7267:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7268:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7269:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7270: 
 7271:    // Total advection (average onto side)
 7272:    const Node *node1 = side->nodes[0];
 7273:    const Node *node2 = side->nodes[1];
 7274:    for (int k=kbs(i); k<nvrt; k++) {
 7275: 
 7276:       Vector2 bcc1 = node1->bcc[k];
 7277:       Vector2 bcc2 = node2->bcc[k];
 7278:       if constexpr(ics == 2) {
 7279:          // Project the velocities from the node frames to the side frame
 7280:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7281:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7282:       }
 7283: 
 7284:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7285:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7286: 
 7287:    }
 7288: }
 7289: #endif
 7290: 
 7291: 
 7292: extern "C" {
 7293:    __global__ void computeElemAverageGhat(void) {
 7294:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7295: 
 7296:       ELEM(elem);
 7297:       
 7298:       elem->ghat1= {0.0, 0.0};  
 7299: 
 7300:       if constexpr(ihydraulics != 0) {
 7301:          if (nhtblocks > 0 && elem->isblock) return;
 7302:       }
 7303: 
 7304:       
 7305:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7306:       // cff1-3: coefficients for 2D/3D
 7307: 
 7308:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7309:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7310:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7311: 
 7312:       if (elem->isDry) return;
 7313: 
 7314:       // Average of the coefficients
 7315:       double av_cff1 = 0.0;  // av. for cff1
 7316:       double av_cff2 = 0.0;  // av. for cff2
 7317:       double av_cff3 = 0.0;  // av. for cff3
 7318:       double av_df = 0.0;  // av. for H^\alpha / H
 7319:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7320:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7321: 
 7322:       const int i34 = elem->i34;
 7323:       const int kb  = elem->kb;
 7324: 
 7325:       for (int j=0; j<i34; j++) {
 7326:          // For each node and side in the element...
 7327: 
 7328:          const Node *node = elem->nodes[j];
 7329:          const Side *side = elem->sides[j];
 7330: 
 7331:          const double chi      = side->chi;
 7332:          const double veg_c2   = side->veg_c2;
 7333:          const double veg_beta = side->veg_beta;
 7334:          const double veg_h    = side->veg_h();
 7335:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7336: 
 7337:          const Vector2 gradPhi = elem->gradPhi[j];
 7338: 
 7339:          // Node - const in elem
 7340:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7341:          elem->gradPr  += node->pr  *gradPhi;
 7342: 
 7343:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7344: 
 7345:         
 7346:          const double htot  = side->htot2();        // Total depth at the side
 7347:          const double zctr2 = side->zTopCanopy();  
 7348: 
 7349:          double cff1; 
 7350:          double cff2; 
 7351:          double cff3;   
 7352:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7353:          // coefficients applied to 2D/3D case 
 7354:             cff1 = side->hhat/htot;
 7355:             cff2 = 0.0;
 7356:             cff3 = 0.0;
 7357:          } else { //3D
 7358:             //Init for no-veg case
 7359:             cff1 = 1.0;
 7360:             cff2 = 1.0;
 7361:             cff3 = 0.0;
 7362: 
 7363:             if constexpr(iveg != 0) {
 7364:                // Computes coefficients used with vegetation terms G1, G2
 7365:                // cff1, cff3 are used for the first two terms in G1, G2:
 7366:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7367:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7368:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7369:                if(veg_h < 0.99*htot) { // submergent vegetation
 7370:                   cff1 = 1.0;
 7371:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7372:                   cff3 = veg_c;
 7373: 
 7374:                } else { // emergent vegetation
 7375:                   cff1 = 1.0/(1.0 + veg_c2);
 7376:                   cff2 = cff1;
 7377:                   cff3 = 0.0;
 7378: 
 7379:                }
 7380:             } // if iveg
 7381:          } //  2D/3D
 7382: 
 7383:          av_cff1 += cff1/i34;
 7384:          av_cff2 += cff2/i34;
 7385:          av_cff3 += cff3/i34;
 7386:          av_cff2_chi += cff2*chi/i34;
 7387:          av_cff3_chi += cff3*chi/i34;
 7388:          av_df += min(htot, veg_h)/(htot*i34);
 7389: 
 7390: 
 7391:          // btrack values: U^\star, U^{\star\alpha}
 7392:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7393:          Vector2 Ustar       = {0.0, 0.0}; 
 7394:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7395: 
 7396:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7397:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7398:          } else { //3D
 7399:             for (int k = side->kb + 1; k < nvrt; k++) {
 7400:             
 7401:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7402:                Ustar += w2;
 7403: 
 7404:                if constexpr(iveg != 0) {
 7405:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7406:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7407:                        Ustar_alpha += zrat*w2; // XXXX
 7408:                    }
 7409:                }  // if iveg
 7410:             }  // for k
 7411:          }  //2D/3D
 7412: 
 7413:          // If needed, project the side velocities to the element frame
 7414:          if constexpr(ics==2) {
 7415:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7416:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7417:          }
 7418:         
 7419: 
 7420:          // Add btrack & surface stress terms to \breve{G} first
 7421:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7422: 
 7423: 
 7424:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7425:          Vector2 tau    = side->tau();  
 7426:          Vector2 ubstar = side->btu[side->kb + 1];  
 7427: 
 7428:          // If needed, project tau and ubstar to the element frame
 7429:          if constexpr(ics==2) {
 7430:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7431:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7432:          }
 7433: 
 7434:          // Term for surface and bottom stress
 7435:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7436: 
 7437: 
 7438:          // All terms in F,F^\alpha,f_b except baroclinic
 7439:          // F, f_b: all explicit terms excluding vegetation 
 7440:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7441:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7442:          const double coriolis = side->coriolis;
 7443:          Vector2 F  =  coriolis*side->U;  // F_x
 7444:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7445:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7446: 
 7447:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7448:             
 7449:             for (int k = side->kb; k < nvrt; k++) {
 7450:                if (zctr2 > side->zc[k-1]) {
 7451:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7452:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7453:                    Fa +=  coriolis*w2*zrat;
 7454:                } // if zctr2
 7455:             } // k
 7456:          } // iveg
 7457: 
 7458:          // Integrate horizontal viscosity force vertically
 7459:          for (int k=side->kb + 1; k<nvrt; k++) {
 7460:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7461: 
 7462:             F += levelHorVisc;
 7463: 
 7464:             // Vegetation term
 7465:             if constexpr(iveg!=0) {
 7466:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7467:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7468:                   Fa += levelHorVisc*zrat;
 7469:                } 
 7470:             } // if iveg
 7471:          } // for k
 7472: 
 7473:          // Get nu*grad(U) at the side's bottom level
 7474:          Vector2 nuGradU = side->nuGradU[side->kb];
 7475: 
 7476:          fb += nuGradU;
 7477: 
 7478:          // If needed, project vectorsF, fb and Fa to the element frame
 7479:          if constexpr(ics==2) {
 7480:             F    = side->frame.projHorVec(F,    elem->frame);
 7481:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7482:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7483:          } // if ics
 7484: 
 7485:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7486:       } // for j (nodes and sides)
 7487: 
 7488:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7489: 
 7490: 
 7491:       // Finish off terms in F, F^\alpha and f_b
 7492:       const double grav3 = elem->mean(&Node::grav2);
 7493:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7494:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7495:       for (int j=0; j<i34; j++) { 
 7496:          // For each side in the element...
 7497:          const Side *side = elem->sides[j];
 7498:          const double chi = side->chi;
 7499: 
 7500:          const double htot = side->htot2();
 7501:          const double veg_h = side->veg_h();
 7502:          const Vector2 F  = htot*fb;
 7503:          const Vector2 Fa = min(htot, veg_h)*fb;
 7504: 
 7505:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7506:       } // for j
 7507: 
 7508:       // tmp is already in elem frame
 7509:       elem->ghat1 += tmp/i34;
 7510: 
 7511:       // Baroclinic force
 7512:       if constexpr(ibc==0) {
 7513:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7514: 
 7515:          Vector2 Fa = {0.0, 0.0};
 7516:          Vector2 intGradRho = {0.0, 0.0};
 7517:          
 7518:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7519:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7520:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7521: 
 7522:             // \in F [m^2/s/s]
 7523:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7524:          }
 7525: 
 7526:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7527:          const Vector2 F = av_df*Fa; //approx
 7528:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7529: 
 7530:       } // if ibc
 7531: 
 7532: 
 7533: 
 7534:    }
 7535: 
 7536: } // extern "C"
 7537: 
 7538: 
 7539: 
 7540: #ifdef DONTCOMPILE
 7541: __global__ void checkMassConservation(Tracers* sumtr) {
 7542: 
 7543:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7544: 
 7545:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7546: 
 7547:    Element *elem = &(mesh->localElemData[i]);
 7548: 
 7549:    // Skip dry elements
 7550:    if (elem->isDry) return;
 7551: 
 7552:    // Local sum array for this thread
 7553:    double localSum[N_TRACERS] = {0.0};
 7554: 
 7555:    // Sum over vertical levels for this element
 7556:    const int kbe = elem->kbe;
 7557:    const double area = elem->area;
 7558: 
 7559:    for (int k = kbe; k < nvrt; k++) {
 7560:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7561:       
 7562:       // Accumulate tracer mass
 7563:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7564:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7565:       }
 7566:    }
 7567: 
 7568:    //  This function returns per element sums. A reduction must be done on the host side.
 7569: }
 7570: 
 7571: 
 7572: __global__ void transport(void) {
 7573: 
 7574:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7575: 
 7576:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7577: 
 7578:    Element *elem = &(mesh->localElemData[ie]);
 7579: 
 7580:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7581: 
 7582:                for (int m=0; m<ntr; m++) {
 7583:                   for (int k=kbe(ie); k<nvrt; k++) {
 7584:                      // Calculate each polynomial's weight 
 7585:                      wm=0.d0; sum1=0.d0; 
 7586:                      wm1=0.d0; wm2=0.d0; 
 7587:                      for (int i=0; i<elem->nweno2; i++) {
 7588:                   
 7589:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7590:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7591:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7592:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7593:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7594:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7595:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7596:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7597:                      // -----------------Hu and Shu (1999)'s method----------------
 7598:                      b4=b1+b2+b3
 7599: 
 7600: //Error: add PRODUCTION CPP
 7601: #ifdef DEBUG
 7602:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7603:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7604:                     call parallel_abort(errmsg)
 7605:                   }
 7606: #endif
 7607: 
 7608:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7609:                   // !----test-------------- 
 7610:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7611:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7612:                   // !wm(i)=wm1(i)*wm2(i)
 7613:                   // !---------------------- 
 7614:                   sum1=sum1+wm(i)
 7615:                 } // end for i
 7616: 
 7617:                 wm=wm/sum1
 7618: 
 7619:                 for (int j=0; j<elem->i34; j++) {
 7620: 
 7621:                   const Side *side  = elem->sides[j];
 7622:                   const Node *node1 = side->n1;
 7623:                   const Node *node2 = side->n2;
 7624: 
 7625:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7626:                      trsd=0.d0
 7627:                      for (int kk=0; kk<nquad; kk++) {
 7628:                         for (int i=0; i<elem->nweno2; i++) {
 7629:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7630:                         } // end for i   
 7631:                      } // end for kk
 7632:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7633:                   } // outward flux
 7634:                } // end for j=1,i34(ie) ! side
 7635:             }
 7636:          }
 7637:               
 7638: 
 7639: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7640: //             //   calculate each polynomial's weight 
 7641: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7642: //                 wm=0.d0; sum1=0.d0
 7643: //                 do i=1,nweno1(ie) !for each polynomial
 7644: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7645: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7646: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7647: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7648: //                   wm(i)=b2
 7649: //                   sum1=sum1+b2
 7650: //                   !wm(i)=1.d0
 7651: //                   !sum1=sum1+1.d0
 7652: 
 7653: // // Error: PRODUCTION
 7654: // #ifdef DEBUG
 7655: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7656: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7657: //                     call parallel_abort(errmsg)
 7658: //                   endif
 7659: // #endif
 7660: 
 7661: //                 enddo !i
 7662: //                 wm=wm/sum1 !final weight
 7663: 
 7664:                 for (int j=0; j<elem->i34; j++) { // side
 7665:                   const Side *side = elem->sides[j];
 7666:                   const Node *node1 = side->n1;
 7667:                   const Node *node2 = side->n2;
 7668: 
 7669:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7670:                     trsd=0.d0
 7671:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7672:                       for (int i=0; i<elem->nweno1; i++) {
 7673:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7674:                       }
 7675:                     enddo //kk
 7676:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7677:                   } // outward flux
 7678:                 } // end for j=1,i34(ie) ! side
 7679:               } // end for k; ntr 
 7680: 
 7681:             else !simple upwind method
 7682:               do j=1,i34(ie)
 7683:                 jsj=elside(j,ie)
 7684:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7685:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7686:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7687:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7688:                   endif
 7689:                 enddo  !vertical layers
 7690:               enddo !j=1,i34(ie) ! side
 7691:             endif !order of accuracy
 7692: 
 7693:          //  enddo !ie
 7694: // !$OMP     end do
 7695: 
 7696: // !$OMP     master
 7697: //           !message passing
 7698: //           if (nproc>1) then
 7699: //             !make a copy of side concentrations
 7700: //             trsd_tmp0=trsd_tmp 
 7701: 
 7702: //             !this exchange routine swaps interface concentration between two partitions
 7703: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7704: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7705: 
 7706: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7707: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7708: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7709: 
 7710: 
 7711: //             !This obtains final values for interface sides
 7712: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7713: //       :    endif !nproc>1
 7714: //           !message passing end
 7715: // !$OMP     end master
 7716: // !$OMP     barrier
 7717: 
 7718: 
 7719: // !         Do advection; conc @ dry elem will not be changed
 7720: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7721: // !$OMP     do reduction(+: h_mass_in)
 7722: //           do i=1,ne
 7723: //             if(idry_e(i)==1) cycle
 7724: 
 7725: 
 7726: // !           Wet elements with 3 wet nodes
 7727: //             do k=kbe(i)+1,nvrt
 7728: 
 7729: 
 7730: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7731: //               dtb_by_bigv = dtb/bigv
 7732:     
 7733: // !             Advective flux
 7734: //               if (ntd_weno==1 .or. itd_weno==1) then
 7735: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7736: //               else
