 3680: 
 3681:    __global__ void scaleGravity(double loadtide_coef) {
 3682: 
 3683: 
 3684:       NODE(node);
 3685: 
 3686:       // SAL option: scale gravity
 3687:       if constexpr(iloadtide==2) {  // simple const
 3688:          node->grav2 = grav*(1.0 - loadtide_coef);
 3689: 
 3690:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3691:         
 3692:           const double depth = max(node->depth, 0.0);
 3693:           const double tmp1 = sqrt(depth);
 3694:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3695:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3696:                              2.6969e-13*depth*depth*depth*tmp1;
 3697:           
 3698:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3699:           
 3700: 
 3701: 
 3702:           node->grav2 = grav*(1.0 - beta_bar);
 3703: 
 3704:       } else {  // iloadtide=0,1
 3705:         node->grav2=grav;
 3706: 
 3707:       }
 3708: 
 3709:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3710:    }
