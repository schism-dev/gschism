 5574:    __global__ void resetBoundaryAreas(void) {
 5575:       // Reset boundary areas and lengths for each segment.
 5576: 
 5577:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5578:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5579:       SIDE_BND(sideBnd);
 5580: 
 5581:       BoundarySegment *segment = sideBnd->segment;
 5582: 
 5583:       segment->carea = 0.0;
 5584:       segment->clen = 0.0;
 5585:  
 5586:    }
 5587: 
 5588:    __global__ void computeBoundaryAreas(void) {
 5589:    // Calculation of cross-section areas and lengths for flow b.c.
 5590: 
 5591:       SIDE_BND(sideBnd);
 5592: 
 5593:       const Side *side = sideBnd->side;
 5594:       BoundarySegment *segment = sideBnd->segment;
 5595: 
 5596:       if (segment->ifltype != 0) {
 5597: 
 5598:          const Node *n1 = side->n1;
 5599:          const Node *n2 = side->n2;
 5600: 
 5601:          const double htot = side->htot2();
 5602: 
 5603:          if (!side->isDry) {
 5604:             atomicAdd(&segment->carea, htot*side->len);
 5605:             atomicAdd(&segment->clen, side->len);
 5606:          }
 5607:       }
 5608: 
 5609:    }
 5610: 
 5611: 
 5612:    __global__ void computeFlowBcVelocities(double time) {
 5613: 
 5614:       SIDE_BND(sideBnd);
 5615: 
 5616:       const Side *side = sideBnd->side;
 5617:  
 5618:       const bool isDry = side->isDry;
 5619:       const bool isLand = sideBnd->segment->isLand;
 5620: 
 5621:    
 5622:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5623: 
 5624:       if (isDry || isLand) return;
 5625: 
 5626:       // For wet sides in open boundaries...
 5627:       const Vector2 n = side->n;
 5628:       const BoundarySegment *segment = sideBnd->segment;
 5629: 
 5630:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5631: 
 5632:       const int ifltype = segment->ifltype;
 5633: 
 5634:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5635:       const Vector2 r_nuth0 = r_uth0*n;
 5636: 
 5637: 
 5638:       if (ifltype == 1 || ifltype == 2) {
 5639:       
 5640:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5641: 
 5642:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5643:          
 5644:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5645:          
 5646:       } else if (ifltype == -1) { // Flather 1
 5647: 
 5648:          for (int k = 0; k < nvrt; k++) {
 5649: 
 5650:             // uth is the normal vel.; no ramp up
 5651:             const double uth = sideBnd->nuth(k);
 5652:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5653: 
 5654:             sideBnd->ubc[k] += uth*n;
 5655:          }
 5656: 
 5657:       } else if (ifltype == 3 || ifltype == 5) {
 5658:          // vnth0=0 !normal vel.
 5659: 
 5660:          Vector2 r_u1_bar = {0.0, 0.0};
 5661:          // Computes the contribution to the velocity from all tide frequencies
 5662:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5663: 
 5664:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5665:             const Vector2 umo  = sideBnd->umo(jfr); 
 5666: 
 5667:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5668:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5669:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5670:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5671: 
 5672:          }
 5673: 
 5674: 
 5675:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5676: 
 5677:       } // if (ifltype = 3 || ifltype == 5
 5678: 
 5679: 
 5680: 
 5681:    }
 5682: 
 5683:    __global__ void computeElevationBoundaryConditions(double time) {
 5684:       // Compute elevation essential boundary conditions 
 5685: 
 5686:       NODE_BND(nodeBnd); // Each boundary node.
 5687: 
 5688:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5689: 
 5690:       const Node *node = nodeBnd->node;
 5691:       const BoundarySegment *segment = nodeBnd->segment;
 5692:       const int iettype = segment->iettype;
 5693:       
 5694: 
 5695:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5696:       double eic = 0.0;
 5697:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5698:       else                 eic = 0.0;
 5699: 
 5700:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5701:       const double r_eth = ramp*nodeBnd->eth;
 5702:       double r_eta1_bar = 0.0;
 5703: 
 5704:       // Compute tide elevation
 5705:       if (iettype == 3 || iettype == 5) {   
 5706: 
 5707:          if constexpr(iloadtide==1) { // loading tide
 5708:             assert(false && "Loading tide not implemented");
 5709:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5710:          }
 5711:          
 5712:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5713: 
 5714:             const double efa  = nodeBnd->efa[jfr]; 
 5715:             const double emo  = nodeBnd->emo[jfr]; 
 5716: 
 5717:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5718:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5719:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5720: 
 5721: 
 5722:          } // for jfr
 5723: 
 5724:       } // if iettype
 5725: 
 5726:       switch (iettype) {
 5727:          case 1:
 5728:          case 2:
 5729:          case 4:
 5730:             nodeBnd->elbc = r_eic + r_eth;
 5731:             break;
 5732:          case 3:
 5733:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5734:             break;
 5735:          case 5:
 5736:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5737:             break;
 5738:       } // switch
 5739: 
 5740: 
 5741:       //Add inverse barometric effects
 5742:       if (iettype != 0 && inv_atm_bnd == 1) {
 5743:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5744:       }
 5745: 
 5746:    }
 5747: 
 5748: 
 5749:    __global__ void computeHorizontalViscosity(void) { 
 5750: 
 5751:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5752: 
 5753:       SIDE(side);
 5754: 
 5755:       if (side->isDry) return;
 5756: 
 5757:       for (int k = 0; k < nvrt; k++) {
 5758:          side->nuGradU[k] = {0.0, 0.0};
 5759:       }
 5760: 
 5761:       if constexpr(ihorcon == 1) {
 5762:          for (int k = side->kb; k < nvrt - 1; k++) {
 5763:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5764:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5765:             // By Zhang and Baptista.
 5766: 
 5767:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5768:             // This is a standard discretization of the Laplacian operator.
 5769:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5770:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5771:             // Gamma is hvis_coef0 in the code.
 5772:             // The value of gamma needs to be < 0.5.
 5773: 
 5774:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5775:             // side under consideration in each of the two possible elements that share the side.
 5776:             Vector2 sumU = {0.0, 0.0};
 5777:             for (int l = 0; l < 2; l++) {
 5778:                const Element *elem = side->elems[l];
 5779: 
 5780:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5781: 
 5782:                // Find the local index of the side in the element
 5783:                const int idxSide = elem->sideLocalIdx(side);
 5784: 
 5785:                // Find the two sides that are connected to the side under consideration
 5786:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5787:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5788: 
 5789:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5790: 
 5791:             }
 5792: 
 5793:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5794: 
 5795:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5796:    
 5797:          }
 5798:       }
 5799:       else if constexpr(ihorcon == 2) {
 5800:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5801:       }
 5802: 
 5803: 
 5804:    }
 5805: 
 5806: 
 5807:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5808: 
 5809:       // Set essential boundary conditions 
 5810:       NODE(node); // Each boundary node
 5811:       NodeBoundary *nodeBnd = node->nodeBnd;
 5812:       
 5813:  
 5814:       // Check if this node has essential BC
 5815:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5816: 
 5817:          // Verify BC value is valid
 5818:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5819: 
 5820:        
 5821:          // Set diagonal to 1 and zero off-diagonals
 5822:          for (int j = 0; j <= node->numNodes; j++) {
 5823:                node->coeffRow[j] = 0.0;
 5824:          }
 5825: 
 5826:          *(node->coeffDiag) = 1.0;
 5827: 
 5828: 
 5829:          // Set solution and RHS to BC value
 5830:          node->mX  = nodeBnd->elbc;
 5831:          node->qel = nodeBnd->elbc;
 5832: 
 5833:       } else {
 5834:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5835: 
 5836:          for (int j = 0; j < node->numNodes; j++) {
 5837:                const Node* nbNode = node->nodes[j];
 5838:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 5839: 
 5840:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5841:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 5842: 
 5843:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5844:                   // Verify neighbor's BC value
 5845:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5846: 
 5847:                   // Subtract contribution to RHS
 5848:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 5849:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 5850:                }
 5851:          }
 5852: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 5853:       }
 5854:    }
