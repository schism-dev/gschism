 1759: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1760:    // Computes the 3D normal vector to the element at level k
 1761:    // Returns the normal vector and the area of the element
 1762: 
 1763:       if (isTri()) {
 1764:          // For triangles...
 1765: 
 1766:          // Gets the normal vector to the element (with a length equal to twice the area)
 1767:          if constexpr(ics==1) {
 1768:             const int kb0 = max(k, nodes[0]->kb);
 1769:             const int kb1 = max(k, nodes[1]->kb);
 1770:             const int kb2 = max(k, nodes[2]->kb);
 1771: 
 1772:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1773:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1774:             
 1775:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1776:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1777:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1778:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1779: 
 1780:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1781:             area3D = 0.5*len;
 1782: 
 1783:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1784: 
 1785:             return {nx/len, ny/len, nz/len};
 1786: 
 1787:            
 1788:          }
 1789:          else {  // lat/lon
 1790:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1791: 
 1792:          } // if ics
 1793:       }
 1794:       else {
 1795:          // For quads...
 1796: 
 1797:          assert(false && "Element normal vector: quads not yet implemented");
 1798: 
 1799: 
 1800:       }
 1801:    }
 1802: 
 1803: /**
 1804:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1805:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1806:    If the segment is completely inside the element, then it returns true.
 1807: 
 1808:    This function assumes:
 1809:    - The initial point is on a side of the element. 
 1810:    - Its position is given by parameter t in the range [0,1].
 1811:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1812:       intersects the element (elements are convex).
 1813: 
 1814:    To find the intersection point, this function does the following:
 1815:    - it finds the intersection of the line segment with all the element side lines,
 1816:       except for the one that contains the initial point.
 1817:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1818:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1819:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1820:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1821:       track segment is almost parallel to the element side line.
 1822: 
 1823:    Inputs:
 1824:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1825:    @param x2, y2: other end of the line segment
 1826: 
 1827:    Outputs:
 1828:    @param side:  side that intersects the line segment (input and output)
 1829:    @param nextElement (output): element that contains the intersection point
 1830:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1831:    @param zint (input/output): Vertical coordinate of the intersection point
 1832: 
 1833:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1834:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1835:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1836: 
 1837:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1838:    (Delta) being zero.
 1839: 
 1840:    The intersection2 point happens when:
 1841:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1842:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1843:    
 1844:    Assumption: the 4 points (including those of the side segment) are different.
 1845:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1846:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1847:    If true, (xIntersect,yIntersect) is the intersection.				
 1848:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1849: **/
 1850: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1851:                                               double &t, double& tIntersect) {
 1852: 
 1853:    double closest_intersect_t = 1e10;
 1854:    bool found_intersection = false;
 1855: 
 1856:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1857:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1858:    const Point2 x1 = side->point(t);
 1859:    
 1860: 
 1861:    Side *nextSide = nullptr;
 1862:    for (int i = 0; i < i34; i++) {
 1863: 
 1864:       // Element's i-th side 
 1865:       Side *side2 = sides[i];
 1866: 
 1867:       // Skip the side that contains the initial point
 1868:       if (side2 == side) continue;
 1869: 
 1870:       // (x3,y3)-(x4,y4) is the element side line
 1871:       const Point2 x3 = side2->n1->p;
 1872:       const Point2 x4 = side2->n2->p;
 1873: 
 1874:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1875:       const double delta = cross(x2 - x1, x3 - x4);
 1876: 
 1877:       if (delta != 0.0) {
 1878: 
 1879:          const double delta1 = cross(x3 - x1, x3 - x4);
 1880:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1881: 
 1882:          // Solves the two linear equations for tt1 and tt2
 1883:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1884:          const double tt2 = delta2/delta;
 1885: 
 1886:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1887:             closest_intersect_t = min(closest_intersect_t, tt1);
 1888:             nextSide = side2;
 1889: 
 1890:             nextElement = nextSide->otherElem(this);
 1891:             tIntersect = max(small, min(tt1, 1.0-small));
 1892:             t = tt2;
 1893: 
 1894:             found_intersection = true;
 1895:          }
 1896:       
 1897:       }
 1898: 
 1899:    }
 1900: 
 1901:    // found_intersection should always be true, since we checked all the sides.  
 1902:    side = nextSide;
 1903: 
 1904:    return found_intersection;
 1905: }
 1906: 
 1907: 
 1908: 
 1909: 
 1910: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1911:                                               double &t, double& tIntersect) {
 1912: 
 1913:    double closest_intersect_t = 1e10;
 1914:    bool found_intersection = false;
 1915: 
 1916:    for (int i = 0; i < i34; i++) {
 1917: 
 1918:       Side *side2 = sides[i];
 1919: 
 1920:       // (x3,y3)-(x4,y4) is the element side line
 1921:       const Point2 x3 = side2->n1->p;
 1922:       const Point2 x4 = side2->n2->p;
 1923: 
 1924:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1925:       const double delta = cross(x2 - x1, x3 - x4);
 1926: 
 1927:       if (abs(delta) > 0) {
 1928: 
 1929:          const double delta1 = cross(x3 - x1, x3 - x4);
 1930:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1931: 
 1932:          // Solves the two linear equations for tt1 and tt2
 1933:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1934:          const double tt2 = delta2/delta;
 1935: 
 1936:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1937:             closest_intersect_t = min(closest_intersect_t, tt1);
 1938:             side = side2;
 1939:             nextElement = side->otherElem(this);
 1940:             t = tt2;
 1941:             tIntersect = max(small, min(tt1, 1.0-small));
 1942:             found_intersection = true;
 1943:          }
 1944:       
 1945:       }
 1946:       else {  // parallel segments
 1947:          assert(false && "Parallel segments");
 1948:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1949:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1950: 
 1951:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1952: 
 1953:          // const double dist = dot(x1 - x3, side2->n);
 1954:          // if (abs(dist) < small*length(x3 - x4)) {
 1955:          //    const double2 unitarySide = normalize(x4 - x3);
 1956:          //    const double len = dot(x2 - x1, unitarySide);
 1957:          //    t = t + len;
 1958:          //    t = max(0.0, min(t, 1.0));
 1959:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1960: 
 1961: 
 1962:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1963:          //    // t = tt2;
 1964:          //    found_intersection = true;
 1965:          // }
 1966:       }
 1967: 
 1968: 
 1969:    }
 1970: 
 1971:       
 1972:    assert(found_intersection && "No intersection found");
 1973: 
 1974:    // found_intersection should always be true, since we checked all the sides.  
 1975:    return found_intersection;
 1976: }
 1977: 
 1978: 
 1979: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1980:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1981: 
 1982:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1983: 
 1984:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1985:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1986:    // curElement.
 1987: 
 1988:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1989:    // And uses this velocity instead to continue the tracking.
 1990: 
 1991:    // computes the intersection point in cartesian coordinates
 1992:    Point2 intersection = nextSide->p_t(tt);
 1993: 
 1994:    // Nudges the point to the barycenter of the element. 
 1995:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1996:    // next segment intersects the element sides.  
 1997:    curElem->nudgeToBarycenter(intersection);
 1998: 
 1999:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2000:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2001:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2002:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2003: 
 2004:    // If the side is an open boundary, the tangential velocity is zero.
 2005:    if (nextSide->isBnd()) vtan = 0.0;
 2006: 
 2007:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2008:    const double us = vtan*nextSide->t().x;
 2009:    const double vs = vtan*nextSide->t().y;
 2010:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2011: 
 2012:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2013:    const double len2 = norm2(intersection - toPoint2(xt));
 2014:    const double vel2 = dot(u_int, u_int);        
 2015:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2016:    else            dt = 0.0;
 2017: 
 2018:    // The end of this tracking segment is now the intersection point.
 2019:    xt = {intersection.x, intersection.y, zint};
 2020: 
 2021:    u_int = {us, vs, ws};
 2022:    
 2023: }
 2024: 
 2025: /**
 2026:  * Tracks a particle through elements and vertical levels in the mesh.
 2027:  * 
 2028:  * @param x0,y0,z0     Starting position coordinates
 2029:  * @param xt,yt,zt     Target position coordinates
 2030:  * @param dtb          Time step for tracking
 2031:  * @param uuint,vvint,wwint Initial velocity components
 2032:  * @param nextElem     Starting/resulting element index
 2033:  * 
 2034:  * @return Status code of type trackExitCodes
 2035:  * 
 2036:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2037:  * of the details are different. The idea is that the code requires less branches and is better fit
 2038:  * for GPU execution.
 2039:  * 
 2040:  * The main ideas here are:
 2041:  * - The starting point is expected to be in the starting element.
 2042:  * - The end point is guaranteed to be inside an element.
 2043:  * - since the starting point is inside the element, there are only two cases: 
 2044:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2045:  *     (b) it does not and (xt,yt) is already in the starting element.
 2046:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2047:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2048:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2049:  * - tt1 can be positive or negative. We only consider the positive values.
 2050:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2051:  * - The next intersection will occur at the smallest positive tt1.
 2052:  * - This intersection will be the next (x0,y0) position.
 2053:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2054:  *   of getting stuck in a loop.
 2055:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2056:  *   was found.
 2057:  */
 2058: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2059:                                                        Element *&nextElem, int &jlev, double &dt,
 2060:                                                        const Side *origSide) {
 2061: 
 2062: 
 2063: 
 2064:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2065:    // else to do.
 2066:    // If it is, nudges the point to be inside the element.
 2067:    const Element *curElem = nextElem;
 2068:    if (containsPoint(toPoint2(xt), true)) {
 2069: 
 2070:       curElem->interpolateVelocities(xt, u_int);
 2071: 
 2072: addDebugPlot(x0, xt);
 2073:       return true;
 2074:    }
 2075: 
 2076:    Side *side = nullptr;
 2077: 
 2078:    // 1. Initial checks
 2079:    // Verify starting element is valid (wet)
 2080:    assert(!curElem->isDry && "Starting element is dry");
 2081: 
 2082:    // Checks if track has a zero length.
 2083:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2084:    // assert(len2 > 0.0 && "Zero length track"); 
 2085:    
 2086:    const int MAX_ITERATIONS = 1000;
 2087:    
 2088:    double t;
 2089:    Side *nextSide = nullptr;
 2090:    double tIntersect = 1e10;
 2091:    double zint = x0.z;
 2092: 
 2093:    // Horizontal tracking loop
 2094:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2095:    // (x0,y0) is inside the element but the target point is not.
 2096: 
 2097:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2098: 
 2099:    assert(found_intersection && "No intersection found at %d");
 2100: 
 2101:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2102: 
 2103:    // if the tracking segment goes out of water (either dry or edge boundary)
 2104:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2105: 
 2106: addDebugPlot(x0, xt, 0x00A0FF);
 2107:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2108: addDebugPlot(x0, xt, 0x00A0FF);      
 2109: 
 2110:       nextElem = this;
 2111:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2112:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2113:       return true;    
 2114:    }
 2115: 
 2116: 
 2117:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2118:    int iterations = 0;
 2119:    while (iterations < MAX_ITERATIONS) {
 2120:       iterations++;
 2121:       
 2122:       Element *curElem = nextElem;
 2123: 
 2124:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2125: addDebugPlot(x0, xt);
 2126:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2127: 
 2128:       // If we are already in the target element, we are done.
 2129:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2130:       if (!found_intersection) break;
 2131: 
 2132: 
 2133: 
 2134:       // if the tracking segment goes out of water (either dry or edge boundary).
 2135:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2136: addDebugPlot(x0, xt, 0x00A0FF);
 2137:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2138: addDebugPlot(x0, xt, 0x00A0FF);   
 2139:          nextElem = curElem;
 2140: 
 2141:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2142:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2143:          return true;
 2144:       }
 2145:       
 2146:       // Update position and element for next iteration
 2147:       side = nextSide;
 2148: 
 2149:    }
 2150: 
 2151:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2152: 
 2153:  
 2154:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2155:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2156: addDebugPlot(x0, xt);   
 2157:    nextElem->interpolateVelocities(xt, u_int); 
 2158: 
 2159:    return true;
 2160: }
 2161: 
 2162: 
 2163: __inline__ __device__ double Element::computeSignedArea(void) const {
 2164:    // Compute the area of the element
 2165: 
 2166:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2167: 
 2168:    // In the quad case we need to add the area of the other triangle.
 2169:    if (isQuad()) {
 2170:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2171:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2172:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2173:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2174: 
 2175:       res += ar1;
 2176:    }
 2177: 
 2178:    return res;
 2179: }
 2180: 
 2181: 
 2182: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2183:                                                                 (nodes[1]->isDry2()) ||
 2184:                                                                 (nodes[2]->isDry2()) ||
 2185:                                                                 (i34==4 && nodes[3]->isDry2());
 2186: }
 2187: 
 2188: __inline__ __device__ double Element::detJ_eta(void) const {
 2189:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2190:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2191: }
 2192: 
 2193: __inline__ __device__ double Element::detJ_xi(void) const {
 2194:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2195:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2196: }
 2197: 
 2198: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2199:    // In boundary sides, the element 1 is nullptr
 2200:    return side->elems[1] == nullptr; 
 2201: }
 2202: 
 2203: 
 2204: 
 2205: /**
 2206:    Compute the shape coordinates of the point (xt,yt) in the element.
 2207:    @param xt (input): x-coordinate of the point
 2208:    @param shpCoords (output): shape coordinates of the point
 2209:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2210:    @return true if the point is inside the element, false otherwise
 2211: **/
 2212: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2213:                                             bool fixNegshpCoord) const {
 2214: 
 2215:    // Compute the shape coordinates of the point xt in the element.
 2216:    if (i34==3) {
 2217:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2218:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2219:       // and in this case, the pt will be nudged into the element
 2220:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2221:       // from the local frame, so use additional check.
 2222: 
 2223:       Point2 x0, x1, x2;
 2224: 
 2225:       if constexpr(ics==1) {
 2226:          x0 = nodes[0]->p;
 2227:          x1 = nodes[1]->p;
 2228:          x2 = nodes[2]->p;
 2229:       }
 2230:       else // lat/lon
 2231:       {
 2232:          Error("Not implemented yet");
 2233: #ifdef ICS2
 2234:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2235:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2236:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2237: #endif
 2238:       }
 2239: 
 2240:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2241:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2242:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2243:       shpCoords[3] = 0.0;
 2244:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2245: 
 2246:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2247:       // then we fix the negative shape coordinates.
 2248:       if (fixNegshpCoord && tmpmin<=0.0) {
 2249: 
 2250:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2251:          // keeping the sum of the shape coordinates equal to 1.
 2252:          // I have tested and compared the new algorithm with the old one, and they give
 2253:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2254:          // The new algorithm should be faster since it is branchless.
 2255:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2256:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2257:          
 2258:          shpCoords[0] = (shpCoords[0] + a)*b;
 2259:          shpCoords[1] = (shpCoords[1] + a)*b;
 2260:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2261: 
 2262:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2263:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2264:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2265:          }
 2266: 
 2267:          // Update the point coordinates for the new shape coordinates
 2268:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2269:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2270:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2271: 
 2272:       }
 2273: 
 2274:       // Check if the point is inside the element
 2275:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2276:    }
 2277:    else {
 2278:       Error("Not implemented yet");
 2279: #ifdef QUADS
 2280:       // Reproject pt in eframe of nel for ics=2
 2281:       if constexpr(ics==1) {
 2282:          xn2 = xt; 
 2283:          yn2 = yt;
 2284:       }
 2285:       else {
 2286:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2287:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2288:       }
 2289: 
 2290:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2291: #endif
 2292:    }
 2293: 
 2294:    return false;  // Never reached
 2295: 
 2296: }
 2297: 
 2298: 
 2299: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2300: // Convert shape coordinates to cartesian coordinates
 2301: 
 2302:    if (i34 == 3) {
 2303:       // Triangular element
 2304:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2305:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2306:    }
 2307:    else {
 2308:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2309:    }
 2310: 
 2311: }
 2312: 
 2313: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2314:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2315:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2316:    // The formula for the integral is:
 2317:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2318: 
 2319:    printf("intPhiPhi: TEST\n");
 2320: 
 2321:    const Node *n0 = nodes[0];
 2322:    const Node *n1 = nodes[1];
 2323:    const Node *n2 = nodes[2];
 2324:    const Node *n3 = nodes[3];
 2325: 
 2326:    const Vector2 p0 = n0->p;
 2327:    const Vector2 p1 = n1->p;
 2328:    const Vector2 p2 = n2->p;
 2329:    const Vector2 p3 = n3->p;
 2330: 
 2331:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2332:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2333:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2334:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2335: 
 2336:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2337: }
 2338:    
 2339: 
 2340: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2341:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2342:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2343:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2344:    // The formula is also based on the identity:
 2345:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2346:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2347: 
 2348:    printf("intGradPhiGradPhi: TEST\n");   
 2349: 
 2350:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2351: 
 2352:    const double x0 = nodes[0]->p.x;
 2353:    const double y0 = nodes[0]->p.y;
 2354:    const double x1 = nodes[1]->p.x;
 2355:    const double y1 = nodes[1]->p.y;
 2356:    const double x2 = nodes[2]->p.x;
 2357:    const double y2 = nodes[2]->p.y;
 2358:    const double x3 = nodes[3]->p.x;
 2359:    const double y3 = nodes[3]->p.y;
 2360: 
 2361:    double res = 0.0;
 2362:    
 2363:    // Quadrature points in xi and eta coordinates
 2364:    #pragma unroll
 2365:    for (int i = 0; i < 4; i++) {
 2366:       // For each quadrature point...
 2367: 
 2368:       const Point2 p = GaussPoint(i);
 2369:       const double eta = p.x;
 2370:       const double xi  = p.y;
 2371: 
 2372:       // Jacobian entries at the Gauss point p
 2373:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2374:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2375:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2376:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2377: 
 2378:       const double detJ = jacobianDet(p);
 2379:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2380: 
 2381:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2382:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2383:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2384:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2385:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2386: 
 2387:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2388:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2389:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2390:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2391:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2392: 
 2393:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2394:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2395:    }
 2396: 
 2397:    return res;
 2398: }
 2399: 
 2400: 
 2401: /**  Interpolate velocities at a given point (xt,yt,zt)
 2402: 
 2403:    @param xt, yt, zt: coordinates of the point to interpolate
 2404:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2405: 
 2406:    This is done in four steps:
 2407: 
 2408:    1. Find the shape coordinates for the final position in the element.
 2409:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2410:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2411:       z levels at xt, yt at each step.   
 2412:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2413:       horizontally and vertically.
 2414: **/
 2415: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2416:    // Interpolate the velocities at the point xt. 
 2417:    // This function works the same for triangular and quadrilateral elements.
 2418:    double shpCoord[4];
 2419: 
 2420:    // First step is to compute the shape coordinates of (xt,yt)
 2421:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2422:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2423: 
 2424:    // Second step is to find the level that contains zt
 2425:    // Uses a binary search to find the level
 2426:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2427:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2428:    int R = nvrt - 1;
 2429: 
 2430:    // Get the z coordinates at the nodes of the element at the levels L and R
 2431:    double zLAtNodes[4], zRAtNodes[4];
 2432:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2433:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2434: 
 2435:    double zL = interpolate(shpCoord, zLAtNodes);
 2436:    double zR = interpolate(shpCoord, zRAtNodes);
 2437:    
 2438:    // Interpolates vertically the velocities
 2439:    double wght1, wght2;
 2440:    if (xt.z<=zL) {
 2441:       wght1 = 1.0;
 2442:       wght2 = 0.0;
 2443:    }
 2444:    else if (xt.z>=zR) {
 2445:       wght1 = 0.0;
 2446:       wght2 = 1.0;
 2447:    }
 2448:    else {
 2449:       // Perform a binary search to find the levels between L and R that contain xt.z
 2450:       while (R - L > 1) {
 2451:          int M = (L + R) / 2;
 2452: 
 2453:          double zMAtNodes[4];
 2454:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2455:          double zM = interpolate(shpCoord, zMAtNodes);
 2456:          if (zM < xt.z) 
 2457:          {
 2458:             L = M;
 2459:             zL = zM;
 2460:          }
 2461:          else 
 2462:          {
 2463:             R = M;
 2464:             zR = zM;
 2465:          }
 2466:       }
 2467:       assert(L == R-1);
 2468:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2469: 
 2470:       wght2 = (xt.z - zL)/(zR - zL);
 2471:       wght1 = 1.0 - wght2;
 2472:    }
 2473: 
 2474:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2475:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2476: 
 2477:    // Neither of the interpolated velocities should be NaN
 2478:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2479: 
 2480: }
 2481: 
 2482: 
 2483: 
 2484: 
 2485: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2486: 
 2487:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2488:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2489:    const Node *n1 = side->n1;
 2490:    const Node *n2 = side->n2;
 2491: 
 2492:    bool n1_match = (n1->nodeBnd->segment == segment);
 2493:    bool n2_match = (n2->nodeBnd->segment == segment);
 2494: 
 2495:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2496:    if (n1_match && n2_match) {
 2497:       return 0.5;
 2498:    } else if (n1_match) {
 2499:       return 1.0;
 2500:    } else if (n2_match) {
 2501:       return 0.0;
 2502:    }
 2503: 
 2504:    return 0.0;
 2505: }
 2506: 
