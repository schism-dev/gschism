 3238: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3239:    if constexpr(ics == 1) {
 3240:       return center;
 3241: 
 3242:    } else {
 3243:       const Point2 p0 = n1->outputCoords();
 3244:       const Point2 p1 = n2->outputCoords();
 3245:       return (1.0/2.0)*(p0 + p1);
 3246: 
 3247:    }
 3248: }
 3249: 
 3250: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3251: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3252: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3253: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3254: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3255: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3256: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3257: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3258: // Computes the gradient of the field at the side center.
 3259:    Vector2 grad = {0.0, 0.0};
 3260:    int count = 0;
 3261: 
 3262:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3263:    // as the average of the gradients at each element.
 3264:    // First element
 3265:    if (elems[0] != nullptr && condition(elems[0])) {
 3266:       Vector2 elemGrad = elems[0]->grad2(field);
 3267: 
 3268:       // For ics=2, projects the element gradient from its frame to the side frame
 3269:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3270: 
 3271:       grad += elemGrad;
 3272: 
 3273:       count++;
 3274:    }
 3275: 
 3276:    // Second element
 3277:    if (elems[1] != nullptr && condition(elems[1])) {
 3278: 
 3279:       Vector2 elemGrad = elems[1]->grad2(field);
 3280: 
 3281:       // For ics=2, projects the element gradient from its frame to the side frame
 3282:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3283: 
 3284:       grad += elemGrad;
 3285: 
 3286:       count++;
 3287:    }
 3288: 
 3289:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3290:    if (count > 0) {
 3291:       grad = grad*(1.0/count);
 3292:    }
 3293:    
 3294:    return grad;
 3295: }
 3296: 
 3297: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3298: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3299: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3300: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3301: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3302: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3303: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3304: 
 3305: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3306: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3307: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3308: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3309: 
 3310: 
 3311: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3312: 
 3313: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3314:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3315:    if constexpr(ics == 1) { 
 3316:       return 0.5*(n1->tau + n2->tau);
 3317: 
 3318:    } else {
 3319:       // Project the tau from the node frames to the side frame
 3320:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3321:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3322: 
 3323:       return 0.5*(stau1 + stau2);
 3324:    }
 3325: }
 3326: 
 3327: /**
 3328:  * This method performs backtracking from the side center until a time -dt back in time 
 3329:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3330:  * intermediate point.
 3331:  *
 3332:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3333:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3334:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3335:  * remaining time.
 3336:  * 
 3337:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3338:  * 
 3339:  * @param uuint, vvint, wwint: Velocities at the final point
 3340:  * @param jlev: Level at which the backtracking is performed
 3341:  * @param dt, dtbk: Tracking timesteps
 3342:   */
 3343: __inline__ __device__ void Side::btrack(
 3344:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3345:       double dt,            // Tracking time
 3346:       double dtbk,          // Tracking timestep
 3347:       Vector3 &u_int        // Velocities at the initial point
 3348: ) const {
 3349: 
 3350:    // Start from side center
 3351:    Point3 x0;
 3352: 
 3353:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3354:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3355: 
 3356:  
 3357:    double time_rm = dt; // Remaining time
 3358:    double time_rm_1 = 1e10;
 3359:    double time_rm_2 = 2e10;
 3360:    double time_rm_3 = 3e10;
 3361: 
 3362: 
 3363:    // Initial velocities
 3364:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3365: 
 3366:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3367:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3368: 
 3369:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3370: 
 3371: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3372: 
 3373: 
 3374:    constexpr int MAX_ITERATIONS = 100; 
 3375:    int iter = 0;
 3376:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3377:    while(true) {
 3378: 
 3379:       // Calculate timestep
 3380:       const double dtb = min(dtbk, time_rm);
 3381: 
 3382: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3383: 
 3384:       // Next point in the backtracking curve
 3385:       xt = x0 - dtb*u_int;
 3386: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3387: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3388: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3389: // if ((jlev==45))
 3390: // {
 3391: // // const Point3 p1 = toLocalFrame(x0);
 3392: // // const Point3 p2 = toLocalFrame(xt);
 3393: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3394: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3395:     
 3396: // }
 3397: 
 3398:       double t, s; // parameters for the line segments p0pt and p1p2
 3399:       Side *lastCrossSide = nullptr;
 3400:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3401: 
 3402: 
 3403: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3404: 
 3405:       if (time_rm_3 <= time_rm) {
 3406:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3407:          xt = x0;
 3408:          break;
 3409:       }
 3410: 
 3411: 
 3412:       if (!found) {
 3413:       // This means that the walk reached a boundary or a dry element.
 3414: 
 3415:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3416: 
 3417:          // Finds the point at the boundary where the line segment x0xt intersects.
 3418:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3419:          // due to floating point errors, it does not exactly intersect.
 3420:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3421:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3422:          // To compute the intersection point we start with the parametric equations.
 3423:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3424:          // We cross-prouct by v1 to cancel the s term:
 3425:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3426:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3427: 
 3428:          // Side coordinates in the origSide frame.
 3429:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3430:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3431: 
 3432:          Point2  p0 = {x0.x, x0.y};
 3433:          Point2  pt = {xt.x, xt.y};
 3434: 
 3435:          const Vector2 v1 = pt - p0;
 3436:          const Vector2 v2 = p2 - p1;
 3437: 
 3438: 
 3439: 
 3440:          // We are assuming intersection, so we clamp t to the range [0,1].
 3441:          const double denom = cross(v2, v1);
 3442:          
 3443: 
 3444: 
 3445: 
 3446:          if (abs(denom) < small) {
 3447:             // small denominators are fairly common. They occur when the line segment x0xt 
 3448:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3449:             // boundary, where the backtracking curve startt sliding along the boundary.
 3450:             // In this case, we simply assume that the two lines are very close to each other
 3451:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3452:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3453:             if (t<0.0000000001) t = 0.0;
 3454:             if (t>0.9999999999) t = 1.0;
 3455: 
 3456:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3457:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3458: 
 3459:          }
 3460:          else {
 3461:             
 3462:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3463:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3464:             if (t>0.9999999999) t = 1.0;
 3465:             // From the originaL equation we can solve for s:
 3466:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3467:             // Computing the dot product by v1, we get:
 3468:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3469:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3470:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3471: 
 3472:          }
 3473: 
 3474:          
 3475:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3476:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3477: 
 3478: 
 3479: 
 3480:          // We update the new target point to be right at the intersection point,
 3481:          // and the remaining time must include the time we haven't "used".
 3482:          time_rm -= s*dtb;
 3483:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3484: 
 3485: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3486: // xct = toLocalFrame(xct);
 3487: // xt = (1-0.00001)*xt + 0.00001*xct;
 3488:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3489:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3490: 
 3491:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3492:          // but extracting only the component along the tangent vector v2.
 3493:          Vector2 tangent = normalize(v2);
 3494:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3495: 
 3496:          const Vector2 u2D = make_double2(u.x, u.y);
 3497:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3498: 
 3499: 
 3500:       } else {
 3501: 
 3502:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3503: 
 3504:          time_rm -= dtb; 
 3505: 
 3506:          u_int = curElem->interpolateVelocities(xt, this);
 3507: 
 3508:       }
 3509: 
 3510:       if (time_rm <= 0.0) break; 
 3511: 
 3512:       // If the velocity is too small, we stop the backtracking
 3513:       const double vmag2 = norm2(toVector2(u_int));
 3514:       if (vmag2 <= velmin_btrack_sq)  {
 3515: 
 3516:          time_rm = 0.0; 
 3517:          return; 
 3518:       }
 3519: 
 3520:       // The current point becomes the next segment's starting point.
 3521:       x0 = xt;
 3522:  
 3523:       iter++;
 3524: 
 3525: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3526:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3527: 
 3528:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3529:       time_rm_3 = time_rm_2;
 3530:       time_rm_2 = time_rm_1;
 3531:       time_rm_1 = time_rm;
 3532:    }
 3533: 
 3534:    assert(curElem != nullptr && "Final element is nullptr");
 3535:    assert(!curElem->isDry && "Final element is dry");
 3536:    
 3537: 
 3538: 
 3539:    // Interpolate the velocities at the final point with respect to the current side frame
 3540:    u_int = curElem->interpolateVelocities(xt, this);
 3541: 
 3542: 
 3543: }
 3544: 
 3545: 
 3546: 
 3547: 
 3548: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3549: 
 3550: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3551: 
 3552:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3553:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3554: 
 3555:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3556:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3557: 
 3558:    double fun_lat = 0.0;
 3559:    switch (jspc[idxComp]) {
 3560:       case 0:
 3561:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3562:          break;
 3563:       case 1:
 3564:          fun_lat = sin(2.0*lat);
 3565:          break;
 3566:       case 2:
 3567:          fun_lat = pow<2>(cos(lat));
 3568:          break;
 3569:       default:
 3570:          assert(false && "computeETP: invalid jspc");
 3571:    }
 3572:    
 3573:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3574: 
 3575: }
 3576: 
 3577: 
 3578: __device__ void Node::updateKb(void) {
 3579: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3580: 
 3581:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3582: 
 3583: 
 3584:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3585: 
 3586:    if constexpr(ivcor == 2) {  // SZ coordinates
 3587:       
 3588:       // Compute bottom level index
 3589:       if (depth <= mesh->h_s) {
 3590:          kb = izlev;   
 3591:          
 3592:       } else {
 3593:          kb = -1;
 3594:          int L = 0;
 3595:          int R = nzlev; 
 3596:          
 3597:          while (L <= R) {
 3598:             int M = (R + L) / 2;
 3599: 
 3600: 
 3601:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3602:             
 3603:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3604:                R = M;
 3605:             } else {
 3606:                L = M;
 3607:             }
 3608: 
 3609:             if (R - L == 1) {
 3610:                kb = L;
 3611:                break;
 3612:             }
 3613:          }
 3614: 
 3615:          // Checks that the binary search was successful
 3616:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3617:        
 3618:       }
 3619:    } 
 3620: }
 3621: 
