 6777: #ifdef DONTCOMPILE
 6778: __device__ void computeVerticalAdvection(void) {
 6779:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6780: 
 6781:    sdbt(1:2,:,:)=0.d0
 6782: 
 6783:    const Side *side = FROM kernel;
 6784: 
 6785:    if(side->isDry) return;
 6786: 
 6787:    // If side is wet...
 6788: 
 6789: 
 6790:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6791:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6792:    double ws[nvrt] = {} // w @ side
 6793:    int icount = 0;
 6794:    for (int j=0; j<2; j++) {
 6795:       const Element *elem = side->elements[j];
 6796:        
 6797:       if(elem != nullptr) {
 6798:          icount++;
 6799:          for (int k=0; k<nvrt; k++) {
 6800:             ws[k] = ws[k] + elem->w[k];
 6801:          }
 6802:       }
 6803:    }  // for j
 6804: 
 6805:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6806:    ws = ws/icount;
 6807: 
 6808:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6809:    // Splines allow for a smooth transition between vertical levels.
 6810:    // Splines have continuity restrictions at the internal knots, but
 6811:    // we have to provide the 1st derivatives at the endpoints.
 6812:    const int kbs = side->kbs; 
 6813:    
 6814:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6815:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6816:    initCubicSpline(kbs, nvrt, side, ws, up)
 6817: 
 6818:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6819:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6820:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6821: 
 6822:    // Total advection (average onto side)
 6823:    const Node *node1 = side->nodes[0];
 6824:    const Node *node2 = side->nodes[1];
 6825:    for (int k=kbs(i); k<nvrt; k++) {
 6826: 
 6827:       if constexpr(ics==1) {
 6828:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6829:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6830:       } else {
 6831:          // XXX IMPLEMENT THIS
 6832:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6833:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6834:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6835:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6836:       }  // if ics
 6837: 
 6838: 
 6839:    }
 6840: }
 6841: #endif
