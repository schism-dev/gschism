 4600:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4601: 
 4602:       NODE_BND(nodeBnd);
 4603: 
 4604:       Node *node = nodeBnd->node;
 4605: 
 4606:       node->ETP = 0.0;
 4607: 
 4608:       for (int j=0; j<ntip; j++) {
 4609: 
 4610:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4611:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4612:    
 4613:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4614: 
 4615:          if constexpr(iloadtide==1) { // loading tide
 4616:             assert(false && "Loading tide not implemented");
 4617:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4618:          }
 4619:          
 4620:       }
 4621:       
 4622:    }
