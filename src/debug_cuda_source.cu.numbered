 2299: 
 2300: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2301:    // Returns the value of the velocity at the side center
 2302:    const double w1 = getBoundaryArrayValueWeight();
 2303:    const double w2 = 1.0 - w1;
 2304:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2305:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2306: 
 2307:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2308: }
 2309: 
 2310: 
 2311: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2312:    // Returns the value of the normal component of the velocity at the side center
 2313:    const double w1 = getBoundaryArrayValueWeight();
 2314:    const double w2 = 1.0 - w1;
 2315:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2316:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2317: 
 2318:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2319: }
