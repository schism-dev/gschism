 5787: 
 5788:    __global__ void backtrackAllNodes(void) {
 5789: 
 5790:       // max/min # of sub-divisions
 5791:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5792:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5793: 
 5794:       SIDE(side);
 5795: 
 5796:       const int kb = side->kb;
 5797: 
 5798: 
 5799:       // Initialize btrack velocities to the actual velocities at the side 
 5800:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5801:   
 5802:       if (side->isDry) return;
 5803:      
 5804: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5805: 
 5806:       // Checks that at least one element is not dry
 5807:       const Element *elem1 = side->elems[0];
 5808:       const Element *elem2 = side->elems[1];
 5809: 
 5810: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5811: 
 5812:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5813:       
 5814:       // XXXXXX
 5815:       // !swild_tmp to store global coord. of the starting side
 5816:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5817:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5818:       // !Use sframe2 
 5819:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5820: 
 5821: 
 5822:       for (int k = kb; k < nvrt; k++) {
 5823:       //  For ics=2, the coordinates are all in the side's local frame
 5824: 
 5825:          const int iadvf = side->iadv();  // Advection flag   
 5826:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5827: 
 5828:          const double vmag2 = norm2(side->u2[k]);
 5829: 
 5830:          if (vmag2 <= velmin_btrack_sq) {  
 5831:             // No activity 
 5832: 
 5833:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5834:             
 5835:          } else {  // do btrack
 5836: 
 5837:             // Compute number of sub-divisions based on local gradients of the velocity field
 5838: 
 5839:             // XXX IS THIS NECESSARY?
 5840:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5841:             double suma = 0.0;
 5842:             int icount = 0;
 5843:             #pragma unroll
 5844:             for (int l=0; l<2; l++) {
 5845:             // For each element sharing the side...
 5846: 
 5847:                const Element *elem = side->elems[l];
 5848:                  
 5849:                if (elem == nullptr) continue;
 5850: 
 5851:                icount++;
 5852: 
 5853:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5854:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5855:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5856: 
 5857:                double utmp[4];
 5858:                double vtmp[4];
 5859:                #pragma unroll
 5860:                for (int j = 0; j < elem->i34; j++) {
 5861: 
 5862:                   const Node *node = elem->nodes[j];
 5863: 
 5864:                   if constexpr(ics==1) {
 5865:                      utmp[j] = node->u2[k].x;
 5866:                      vtmp[j] = node->u2[k].y;  
 5867: 
 5868:                   } else {
 5869:                      // 'Project' the velocity from the node frame to the element frame
 5870:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5871:                      utmp[j] = tmp_u2.x;
 5872:                      vtmp[j] = tmp_u2.y;
 5873: 
 5874:                   }
 5875:                } // for j
 5876: 
 5877:                const Vector2 grad_u = elem->grad2(utmp); 
 5878:                const Vector2 grad_v = elem->grad2(vtmp);
 5879:    
 5880:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5881:             } // for l
 5882: 
 5883:             assert(icount > 0 && "Impossible 77");
 5884: 
 5885:             // '4' is somewhat arbitrary
 5886:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5887: 
 5888:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5889:             Vector3 u_int = {0.0, 0.0, 0.0};
 5890: 
 5891:             side->btrack(k, dt, dtbk, u_int);
 5892: 
 5893: 
 5894:             side->btu[k] = {u_int.x, u_int.y};
 5895:                
 5896:          } // if vmag (do backtrack)
 5897: 
 5898: 
 5899:       } // for k=kb,nvrt-1
 5900: 
 5901:    }
 5902: 
 5903: } // extern "C"
 5904: 
 5905: template<int nc>
 5906: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5907: 
 5908: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5909: //
 5910: // Although this is a general function, it is used only for equations on vertical levels.
 5911: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5912: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5913: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5914: //
 5915: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5916: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5917: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5918: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5919: 
 5920:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5921:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5922: 
 5923:    double bet = b[0];
 5924:    if constexpr (nc == 1) {
 5925:       u[0] = rhs[0]/bet;
 5926:    } else {
 5927:       #pragma unroll
 5928:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5929:    }
 5930: 
 5931:    for (int j = 1; j < n; j++) {
 5932:       gam[j] = c[j - 1]/bet;
 5933:       bet = b[j] - a[j]*gam[j];
 5934: 
 5935:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5936: 
 5937:       if constexpr (nc == 1) {
 5938:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5939:       } else {
 5940:          #pragma unroll
 5941:          for (int l = 0; l < nc; l++) {
 5942:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5943:          }
 5944:       }
 5945:    }
 5946: 
 5947:    // Back-substitution
 5948:    for (int j = n - 2; j >= 0; j--) {
 5949:       if constexpr (nc == 1) {
 5950:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5951:       } else {
 5952:          for (int l = 0; l < nc; l++) {
 5953:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5954:          }
 5955:       }
 5956:    }
 5957: }
 5958: 
 5959: 
 5960: 
 5961: // Helper function that contains the core algorithm
 5962: template<typename XAccessor, typename YAccessor>
 5963: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5964:                                     double  yp_top, double  yp_bot, 
 5965:                                     CubicSpline &spline) {
 5966:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5967:    // 
 5968:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5969:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5970:    //
 5971:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5972:    // 
 5973:    // Inputs: 
 5974:    //            n: dimension for x etc; # of data pts (>=2);
 5975:    //            getX, getY: functions to access x,y coordinates
 5976:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5977:    //     Output: 
 5978:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5979: 
 5980:    const int n = k2 - k1 + 1;
 5981:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5982: 
 5983:    // Allocate memory for the splines
 5984:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5985:    spline.x   = new double[n];
 5986:    spline.y   = new double[n];
 5987:    spline.yp  = new double[n];
 5988:    spline.ypp = new double[n];
 5989: 
 5990:    for (int k=k1; k<=k2; k++) {
 5991:       spline.x[k] = getX(k);
 5992:       spline.y[k] = getY(k);
 5993:    }
 5994: 
 5995:    // This is to simplify expressions later
 5996:    double *x = spline.x;
 5997:    double *y = spline.y;
 5998: 
 5999:    double *a = nullptr;
 6000:    double *b = nullptr;
 6001:    double *c = nullptr;
 6002:    double *gam = nullptr;
 6003:    double *rhs = nullptr;
 6004:    
 6005: 
 6006:       a = new double[n];   // Lower diagonal
 6007:       b = new double[n];   // Diagonal
 6008:       c = new double[n];   // Upper diagonal
 6009:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 6010:       rhs = new double[n]; // Right-hand side
 6011: 
 6012:    for (int k=k1; k<=k2; k++) {
 6013:       if (k == k1) {
 6014:          // Bottom level
 6015:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 6016:          b[k] = (x[k+1] - x[k])/3.0;
 6017:          c[k] = b[k]/2.0;
 6018:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 6019:       } else if (k == n - 1) {
 6020:          // Top level (surface)
 6021:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 6022:          b[k] = (x[k] - x[k-1])/3.0;
 6023:          a[k] = b[k]/2.0;
 6024:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 6025:       } else {
 6026:          // Intermediate levels
 6027:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 6028:          b[k] = (x[k+1] - x[k-1])/3.0;
 6029:          a[k] = (x[k  ] - x[k-1])/6.0;
 6030:          c[k] = (x[k+1] - x[k  ])/6.0;
 6031:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 6032:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 6033:       }
 6034:    }
 6035: 
 6036:    // Solve the tridiagonal system
 6037:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 6038:    
 6039:    spline.yp[k1] = yp_bot;
 6040:    spline.yp[k2] = yp_top;
 6041: 
 6042:    // Compute rest of 1st derivatives using the splines
 6043:    for (int k=k1+1; k<k2; k++) {
 6044:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 6045:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 6046:    }
 6047:    
 6048:    delete[] a;
 6049:    delete[] b;
 6050:    delete[] c;
 6051:    delete[] gam;
 6052:    delete[] rhs;
 6053: 
 6054: }
 6055: 
 6056: // Array version
 6057: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 6058:                                 double y_top, double y_bot, 
 6059:                                 CubicSpline &spline) {
 6060:    auto getX = [x] (int k) { return x[k]; };
 6061:    auto getY = [y] (int k) { return y[k]; };
 6062:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6063: }
 6064: 
 6065: // Lambda version - allows custom access patterns
 6066: template<typename XFunc, typename YFunc>
 6067: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 6068:                                 double y_top, double y_bot,
 6069:                                 CubicSpline &spline) {
 6070:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6071: }
 6072: 
 6073: 
 6074: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 6075: {
 6076:    assert("Not implemented");
 6077: 
 6078:    return 0.0;
 6079: }
