 3362: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3363:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3364:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3365:                 int *isdel, int *isidenode, int *isbnd,
 3366:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3367:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3368:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3369:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3370:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3371:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3372:                 double *drag, double *roughness,
 3373:                 double *emo, double *efa, 
 3374:                 double *umo, double *ufa, 
 3375:                 double *vmo, double *vfa) {
 3376: 
 3377:    printf("Populating mesh for partition %d\n", partNum);
 3378: 
 3379:    // XXXXXX THIS function does almost nothing. 
 3380: 
 3381:    nbs = *sharedIdxSideBoundary + 1;
 3382:    nbp = *sharedIdxNodeBoundary + 1;
 3383: 
 3384:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3385: 
 3386: }
