 2867: 
 2868: __device__ double Node::compZCoord(int k) const {
 2869:    // Computes the z coordinate at level k.
 2870:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2871:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2872:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2873:    // used 
 2874: 
 2875:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2876:    
 2877:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2878: 
 2879:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2880: 
 2881:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2882: 
 2883:    if constexpr(ivcor == 2) {
 2884: 
 2885:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2886:       const double h_c = mesh->h_c;
 2887:       const double theta_f = mesh->theta_f;
 2888:       const double sinh_theta_f = mesh->sinh_theta_f;
 2889: 
 2890: 
 2891:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2892:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2893:       // once per time step/node.
 2894:       // CHECK: updateZCoordData
 2895: 
 2896:       //  To simplify comparisons, I define index versions of count variables.
 2897:       if      (k == ivrt)     return eta2; 
 2898:       else if (k == izlev)    return -hmod2;
 2899:       else if (k == kb)       return -depth;
 2900:       else if (k < izlev)     return mesh->ztot[k];
 2901:       else if (k > izlev) {
 2902:          const int ksig = k - izlev;
 2903: 
 2904:          if (hmod2 <= h_c) {
 2905:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2906: 
 2907:          } 
 2908:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2909:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2910:             assert(false && "ZCOOR: invalid h_c\n");
 2911:          } 
 2912:          else {
 2913:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2914:                    h_c * mesh->sigma[ksig] + 
 2915:                    (hmod2 - h_c) * mesh->cs[ksig];
 2916:          }
 2917:       } else { 
 2918:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2919:       }
 2920: 
 2921:    }
 2922:    else if constexpr(ivcor == 1) {
 2923:       if (k == kb) return -depth;
 2924:       else if (k == nvrt-1) return eta2;
 2925:       else if (k > kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2926:    }
 2927:    
 2928:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2929:    return 0.0;
 2930: }
 2931: 
 2932: 
 2933: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2934:    // Computes the bottom drag Cd based on the selected nchi
 2935: 
 2936:    if constexpr(nchi == 0) {
 2937:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2938:       Cd = drag;  // Read from drag file
 2939: 
 2940:    } else if constexpr(nchi == 1) {
 2941:       // 
 2942: 
 2943:       bool ltmp = false; // for WBL iteration
 2944: 
 2945:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2946:       if (isDry || (rough == 0.0)) {
 2947:          Cd = 0.0;
 2948: 
 2949:       } else { //roughness >0 
 2950:          
 2951:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2952: 
 2953:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2954: 
 2955:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2956: 
 2957:       } // if rough
 2958: 
 2959:    } else if constexpr(nchi == -1) {
 2960:    // Manning 
 2961:  
 2962:       const double htot = max(hmin_man, htot2()); 
 2963:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2964: 
 2965:    } else {
 2966:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2967:       
 2968:    } // if nchi
 2969: 
 2970: }
 2971: 
 2972: 
 2973: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2974:    // Checks if a side in on the boundary
 2975:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2976: 
 2977:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2978:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2979: 
 2980:    // Indices of the nodes that form the side
 2981:    const int n1 = side.n1->idx;
 2982:    const int n2 = side.n2->idx;
 2983:    isLand = false;
 2984:    
 2985: 
 2986:    // Check if the side is on a land boundary
 2987:    for (int i = 0; i < nland; i++) {
 2988:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2989:          // Consecutive nodes in the land boundary segment
 2990:          const int b1 = ilnd[i + j*nland];
 2991:          const int b2 = ilnd[i + (j + 1)*nland];
 2992: 
 2993:          assert(b1 != -1 && b2 != -1);
 2994: 
 2995:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2996:             
 2997:             isLand = true;
 2998:             return i;
 2999:          }
 3000:       }
 3001:    }
 3002: 
 3003:    // Check if the side is on an open boundary
 3004:    for (int i = 0; i < nope; i++) {
 3005:       for (int j = 0; j < nond[i] - 1; j++) {
 3006:          // Consecutive nodes in the open boundary segment
 3007:          const int b1 = iond[i + j*nope];
 3008:          const int b2 = iond[i + (j + 1)*nope];
 3009: 
 3010:          assert(b1 != -1 && b2 != -1);
 3011: 
 3012:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3013:             isLand = false;
 3014:             return i;
 3015:          }
 3016:       }
 3017:    }
 3018: 
 3019:    return -1;
 3020: }
 3021: 
 3022: 
 3023: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3024:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3025:                                     double *wind_rotate_angle, 
 3026:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3027:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3028:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3029:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3030:                                     double *drag, double *roughness, double *rmanning) {
 3031: 
 3032:    NODE(pnode);  
 3033:    const int i = idx_node;
 3034:    Node &node(*pnode);
 3035: 
 3036:    node.idx = i;
 3037: 
 3038:    const int idxNodeStart = nodeNeighNodesStart[i];
 3039:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3040:    node.numNodes = idxNodeEnd - idxNodeStart;
 3041:    node.nodes = nodeNeighNodes + idxNodeStart;
 3042:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3043: 
 3044: 
 3045: 
 3046:    const int idxElemStart = nodeNeighElemsStart[i];
 3047:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3048:    node.numElements = idxElemEnd - idxElemStart;
 3049:    node.elements = nodeNeighElems + idxElemStart;
 3050: 
 3051: 
 3052:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3053:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3054:       const int partNode = localNodePart[idxNodeGlobal]; 
 3055:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3056: 
 3057:       Node *node_ptr = nodes[partNode] + idxNode;
 3058:       
 3059:       nodeNeighNodes[idx] = node_ptr;
 3060:    }
 3061: 
 3062: 
 3063:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3064:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3065:       const int partElem = localElemPart[idxElemGlobal];
 3066:       const int idxElem  = localElemIndices[idxElemGlobal];
 3067: 
 3068:       Element *elem_ptr = elems[partElem] + idxElem;
 3069: 
 3070:       nodeNeighElems[idx] = elem_ptr;
 3071:    }      
 3072: 
 3073:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3074:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3075: 
 3076:    node.p.x   = node_coords[i * 3];
 3077:    node.p.y   = node_coords[i * 3 + 1];
 3078:    node.depth = node_coords[i * 3 + 2];
 3079: 
 3080:    if (use_ll) {
 3081:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3082:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3083:    }
 3084: 
 3085: 
 3086:    node.numSides = 0;
 3087: 
 3088:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3089:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3090:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3091:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3092:    else assert(false && "populateNodes: selected nchi not implemented.");
 3093:    
 3094:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3095:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3096:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3097: 
 3098:    
 3099:    // Links the node to the boundary information
 3100:    if (isbnd[i] >= 0) {
 3101:      
 3102:       // Get the index of the node boundary
 3103:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3104: 
 3105:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3106:       node.nodeBnd->node = &node;
 3107: 
 3108:       node.nodeBnd->sideBnd1 = nullptr;
 3109:       node.nodeBnd->sideBnd2 = nullptr;
 3110: 
 3111:       if (isbnd[i]>=0) {
 3112: 
 3113:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3114:          
 3115:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3116:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3117: 
 3118:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3119:          node.nodeBnd->segment->clen  = nan("1");
 3120:          node.nodeBnd->segment->carea = nan("1");
 3121: 
 3122:       }
 3123:    } else {
 3124: 
 3125:       node.nodeBnd = nullptr; // For internal nodes
 3126: 
 3127:       if (isbnd[i] == landSegment) {
 3128:          node.nodeBnd = &landBoundaryNode;
 3129:          node.nodeBnd->segment = &landBoundarySegment;
 3130:       }
 3131:       
 3132:    }
 3133:    
 3134:    // XXXX GAUSSIAN HILL VELOCITIES
 3135: #ifdef GAUSSIAN_HILL_VELOCITIES
 3136:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3137:       constexpr double rot_per = 3000.0;
 3138:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3139:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3140:    // XXXXX
 3141: #endif
 3142: 
 3143: }
 3144: 
 3145: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3146:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3147:                                     double *wind_rotate_angle,   
 3148:                                     int *isdel, int *isidenode, int *isbnd,
 3149:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3150:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3151:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3152:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3153:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3154:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3155:                                     double *drag, double *roughness) {
 3156: 
 3157: 
 3158:    SIDE(pside);
 3159:    Side &side(*pside);
 3160:    const int i = idx_side;
 3161: 
 3162:    side.idx = i;  
 3163:    
 3164:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3165:    const double fc   = 2.0*omega_e*sin(sfea0);
 3166:    const double beta = 2.0*omega_e*cos(sfea0);
 3167: 
 3168:    // finding the pointer to the nodes that form the side
 3169:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3170:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3171: 
 3172:    const int locidx_n1 = localNodeIndices[idx_n1];
 3173:    const int locidx_n2 = localNodeIndices[idx_n2];
 3174:    const int part_n1 =   localNodePart[idx_n1];
 3175:    const int part_n2 =   localNodePart[idx_n2];
 3176: 
 3177:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3178:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3179: 
 3180:    // Counts the number of sides connected to each node
 3181:    side.n1->numSides++;
 3182:    side.n2->numSides++;
 3183: 
 3184:    // Normal, unitary vector to the side
 3185:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3186:    side.n = normalize(side.n);
 3187: 
 3188:    // Side boundary type
 3189:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3190:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3191: 
 3192:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3193:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3194:    {
 3195:       bool isLand = false;
 3196:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3197:       
 3198:       if (isbs > -1) {
 3199:          // assert(isLand || isbs>=0);
 3200:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3201: 
 3202:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3203: 
 3204:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3205:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3206: 
 3207:          assert (isLand == side.sideBnd->segment->isLand);
 3208: 
 3209:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3210:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3211:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3212: 
 3213:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3214:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3215:          
 3216:          side.sideBnd->side = &side;
 3217: 
 3218:       }
 3219:       else {
 3220:          side.sideBnd = nullptr;
 3221:       }
 3222:    }
 3223:    else 
 3224:    {
 3225:       side.sideBnd = nullptr;
 3226:    }
 3227: 
 3228: 
 3229:    // finding the pointer to the elements that share the side
 3230:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3231:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3232: 
 3233:    if (idx_e1 > -1) {
 3234:       const int locidx_e1 = localElemIndices[idx_e1];
 3235:       const int part_e1 =  localElemPart[idx_e1];
 3236:       side.elems[0] = elems[part_e1] + locidx_e1;
 3237: 
 3238:    }
 3239:    else {
 3240:       side.elems[0] = nullptr;
 3241:    }
 3242: 
 3243:    if (idx_e2 > -1) {
 3244:       const int locidx_e2 = localElemIndices[idx_e2];
 3245:       const int part_e2 =  localElemPart[idx_e2];
 3246:       side.elems[1] = elems[part_e2] + locidx_e2;
 3247:    }
 3248:    else {
 3249:       side.elems[1] = nullptr;
 3250:    }
 3251: 
 3252:    // Compute the center of the side
 3253:    side.center = 0.5*(side.n1->p + side.n2->p);
 3254: 
 3255:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3256:    side.shapiro = shapiro0;
 3257: 
 3258: #ifdef GAUSSIAN_HILL_VELOCITIES
 3259: // XXXX
 3260: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3261: constexpr double rot_per=3000.0;
 3262: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3263: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3264: // XXXXX      
 3265: #endif
 3266:    // Compute the z level at the center of the side
 3267:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3268:    
 3269:    // Compute the length of the side
 3270:    const Vector2 vLen = side.n2->p - side.n1->p;
 3271:    side.len = sqrt(dot(vLen, vLen));
 3272: 
 3273: 
 3274:    // Compute the Coriolis coefficient
 3275: 
 3276:    if constexpr(ncor == -1 || ncor == 0) {
 3277:       side.coriolis = coricoef;
 3278:    }
 3279:    else {
 3280:       const double sphi = side.lat();  // Latitude at the center of the side
 3281: 
 3282: // XXXXXX ERROR WHEN use_ll is false??????
 3283:       if constexpr(ics == 1) {
 3284:          // XXXXXXX
 3285:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3286:       }
 3287:       else {
 3288:          side.coriolis = 2.0*omega_e*sin(sphi);
 3289:       }
 3290: 
 3291:    }
 3292: }
 3293: 
 3294: 
 3295: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3296:    double *node_coords, double *node_coords_ll, bool use_ll,
 3297:    double *wind_rotate_angle,   
 3298:    int *isdel, int *isidenode, int *isbnd,
 3299:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3300:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3301:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3302:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3303:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3304:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3305:    double *drag, double *roughness) {
 3306: 
 3307:    ELEM(pelem);
 3308:    Element &elem(*pelem);
 3309:    const int i = idx_elem;
 3310: 
 3311:    elem.idx = i;
 3312: 
 3313:    for (int j = 0; j < i34[i]; j++) {
 3314:       const int idxNode = elnode[i*4 + j];  
 3315:       const int idxSide = elside[i*4 + j];
 3316:       
 3317:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3318:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3319: 
 3320:       // Find the neighboring element  
 3321:       if (elem.sides[j]->elems[0] == &elem) {
 3322:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3323:       }
 3324:       else {
 3325:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3326:       }
 3327:       
 3328:    }
 3329: 
 3330:    elem.i34 = i34[i];
 3331: 
 3332:    // Compute the barycenter of the element and its depth
 3333:    elem.center = {0.0, 0.0};
 3334:    elem.depth = 0.0;
 3335:    for (int j = 0; j < i34[i]; j++) {
 3336: 
 3337:       elem.center += elem.nodes[j]->p/i34[i];
 3338:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3339:    }
 3340: 
 3341: 
 3342:    
 3343:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3344:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3345: 
 3346:    elem.area = elem.computeSignedArea(); 
 3347:    elem.radius = sqrt(elem.area)/pi; 
 3348:    
 3349:    // Determines which way the normal vector to each side is oriented.
 3350:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3351:    for (int j = 0; j < i34[i]; j++)  
 3352:    {
 3353:       if (elem.sides[j]->elems[0] == &elem) {
 3354:          elem.ssign[j] =  1.0;
 3355:       }
 3356:       else {
 3357:          elem.ssign[j] = -1.0;
 3358:       }
 3359: 
 3360:    }
 3361: 
 3362:    // Derivatives of shape functions
 3363:    //  For ics=2, this is done inside element/ll frame XXX
 3364:    //  For quads, the derivative is evaluated at centroid
 3365:    for (int j = 0; j < elem.i34; j++) {
 3366:       const double area = elem.area;
 3367:       const int id2 = elem.nxq(1 + j);
 3368:       const int id3 = elem.nxq(2 + j);
 3369:       const int id4 = elem.nxq(3 + j);
 3370:       if (elem.isTri()) {
 3371:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3372:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3373:          // da1/dx = (y1 - y2)/(2*area)
 3374:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3375:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3376:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3377:       }
 3378:       else  { // Quad; evaluate at centroid
 3379:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3380:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3381:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3382:       } // if Tri
 3383: 
 3384:    } // for j   
 3385:    
 3386:    
 3387: 
 3388: }
 3389: 
 3390: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3391:                                             double *emo, double *efa, 
 3392:                                             double *umo, double *ufa, 
 3393:                                             double *vmo, double *vfa) {
 3394: 
 3395: 
 3396:    NODE_BND(nodeBnd);
 3397:    const int idx = idx_node_bnd;    
 3398: 
 3399:    nodeBnd->idx = idx;
 3400: 
 3401:    // Need to find the segment index and the index of the node on the segment
 3402:    int idxNode = -1;
 3403:    int iseg, i;
 3404:    for (iseg = 0; iseg < nope; iseg++) {
 3405:       // for each segment...
 3406:       for (i = 0; i < nond[iseg]; i++) {
 3407:          idxNode = iond[iseg + i*nope];
 3408:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3409:          
 3410:       }
 3411:    }
 3412: 
 3413:    assert(iseg < nope && "iseg is out of bounds");
 3414: 
 3415: found: // Jumped here when the node was found
 3416: 
 3417:    nodeBnd->isEssentialBC = true;
 3418:    nodeBnd->elbc = 0.0;
 3419: 
 3420:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3421: 
 3422:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3423:       nodeBnd->efa[jfr] = efa[idx2];
 3424:       nodeBnd->emo[jfr] = emo[idx2];
 3425:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3426:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3427: 
 3428:    }
 3429:         
 3430: 
 3431: }
