 7131: 
 7132: __global__ void computeMatrixProductAndDotProducts() {
 7133:    // Computes A*p, r'Mr and p'Ap
 7134: 
 7135:    // 1) shared buffer: first half for rMr, second for pAp
 7136:    __shared__ double sdata[2*BLOCK_SIZE];
 7137:    double* s_rMr = sdata;
 7138:    double* s_pAp = sdata + BLOCK_SIZE;
 7139: 
 7140:    const int tid = threadIdx.x;
 7141: 
 7142:    double l_pAp = 0.0;
 7143: 
 7144:    s_rMr[tid] = 0.0;
 7145:    s_pAp[tid] = 0.0;
 7146: 
 7147:    // 2) get your node pointer
 7148:    // NODE(node);   
 7149:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7150:    Node *node = &(mesh->localNodeData[idx_node]); 
 7151:       if (idx_node < mesh->np) {
 7152: 
 7153:       const double diag = node->coeffDiag;
 7154:       const double r    = node->mR;
 7155:       const double p    = node->mP;  
 7156: 
 7157:       // apply preconditioner on the fly:
 7158:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7159: 
 7160:       // 4) compute Ap = A.p
 7161:       double Ap = node->coeffDiag * node->mP;
 7162:       for (int j = 0; j < node->numNodes; ++j) {
 7163:          const Node *nbNode = node->nodes[j];
 7164:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7165: 
 7166:       }
 7167: 
 7168:       node->mAp = Ap;
 7169:       
 7170: 
 7171:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7172:       // const double l_rMr = r*Mr;  // r'Mr
 7173:       l_pAp = p*Ap;  // p'Ap
 7174: 
 7175: 
 7176:    }
 7177: 
 7178:    // 6) write into shared mem
 7179:    // s_rMr[tid] = l_rMr;
 7180:    s_pAp[tid] = l_pAp;
 7181: 
 7182:    __syncthreads();
 7183: 
 7184:    // 7) block-wide tree reduction
 7185:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7186:       if (tid < stride)  {
 7187:          s_pAp[tid] += s_pAp[tid + stride];
 7188:       }
 7189:       __syncthreads();
 7190:    }
 7191: 
 7192:    // 8) thread 0 atomically accumulates into the globals
 7193:    // XXX: This is slower than it needs to be, but it is simple and works
 7194:    if (tid == 0) {
 7195:       atomicAdd(pAp, s_pAp[0]);
 7196:    }
 7197: 
 7198: 
 7199: }
 7200: 
 7201: 
 7202: __global__ void updateSolutionAndDotProducts(void) {
 7203:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7204: 
 7205:    const int tid = threadIdx.x;
 7206: 
 7207:    s_rMr[tid] = 0.0;
 7208: 
 7209:    // get node & bounds-check:
 7210:    NODE(node);
 7211: 
 7212:    
 7213:    // Compute alpha
 7214:    const double alpha = (*rMr_old)/(*pAp); 
 7215: 
 7216: 
 7217:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7218: 
 7219: 
 7220:    // load scalars
 7221:    const double diag = node->coeffDiag;
 7222:    const double p    = node->mP;
 7223:    const double Ap   = node->mAp;
 7224:    const double x    = node->mX;
 7225:    const double r    = node->mR;
 7226:    
 7227:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7228: 
 7229:    // 1) update solution & residual
 7230:    const double x_new = x + alpha*p;
 7231:    const double r_new = r - alpha*Ap;
 7232:    node->mX = x_new;
 7233:    node->mR = r_new;
 7234: 
 7235:    // 2) apply Jacobi preconditioner on the fly
 7236:    const double Mr_new = r_new/diag;
 7237: 
 7238: 
 7239:    // 3) local contributions for the two dot-products
 7240:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7241: 
 7242:    // 4) write into shared-mem
 7243:    s_rMr[tid] = l_rMr;
 7244: 
 7245:    __syncthreads();
 7246: 
 7247: 
 7248:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7249:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7250:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7251:       __syncthreads();
 7252:    }
 7253: 
 7254:    // 6) thread 0 atomically folds into the global accumulators
 7255:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7256: 
 7257: 
 7258: }
 7259: 
 7260: 
 7261: __global__ void updateSearchDirection() {
 7262: 
 7263:     NODE(node);
 7264: 
 7265:     // recompute z on-the-fly
 7266:     const double z = node->mR / node->coeffDiag;
 7267:     const double p = node->mP;
 7268: 
 7269:     const double beta = (*rMr_new)/(*rMr_old);
 7270: 
 7271: 
 7272:     // p =z + beta*p
 7273:     node->mP = z + beta*p;
 7274: 
 7275: }
 7276: 
 7277: __global__ void initializeScalars(double *scalars) {
 7278: 
 7279:    // These point to a cupy array in the host code
 7280:    rMr_old = scalars + 0;
 7281:    rMr_new = scalars + 1;
 7282:    pAp     = scalars + 2;
 7283: }
 7284: 
 7285: __global__ void initializePreconditionedResidual(void) {
 7286: 
 7287:     __shared__ double s_rMr[BLOCK_SIZE];  
 7288: 
 7289:     s_rMr[threadIdx.x] = 0.0;
 7290: 
 7291:     NODE_ALL(node, valid);
 7292:     const int tid = threadIdx.x;
 7293:     // For the first iteration:
 7294:     // 1. Initial solution x = 0 (already set)
 7295:     // 2. Initial residual r = b (stored in qel)
 7296:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7297: 
 7298: // XXX we should use the guess solution here    
 7299: 
 7300:     double l_rMr = 0.0;
 7301:     if (valid) {
 7302:       // Set initial residual r = b (from qel)
 7303:       node->mR = node->qel;
 7304: 
 7305:       // Compute z = M^-1 * r (preconditioned residual)
 7306:       const double z = node->mR / node->coeffDiag;
 7307: 
 7308:       // Set initial search direction p = z
 7309:       node->mP = z;
 7310: 
 7311:       // Initialize other variables needed for CG
 7312:       node->mX = 0.0;  // Initial solution
 7313:       node->mAp = 0.0; // Will be computed in first iteration
 7314: 
 7315: 
 7316:       // Computes the first r'Mr (reduction)
 7317:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7318:     }
 7319:     // 4) write into shared-mem
 7320:     s_rMr[tid] = l_rMr;
 7321: 
 7322:     __syncthreads();
 7323: 
 7324: 
 7325:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7326:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7327:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7328:         __syncthreads();
 7329:     }
 7330: 
 7331:     // 6) thread 0 atomically folds into the global accumulators
 7332:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7333: 
 7334:     *rMr_old = 0.0;
 7335:     *pAp = 0.0;
 7336: }
 7337: 
 7338: 
 7339: 
 7340: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7341:    Element *elems = mesh->localElemData;
 7342: 
 7343:    *addr = elems;
 7344:    *sizeElement = sizeof(Element);
 7345:    switch (varCode) {
 7346:       case (int)VarCode::z:
 7347:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7348:          *sizeType = sizeof(double);
 7349:          break;
 7350:       case (int)VarCode::x:
 7351:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7352:          *sizeType = sizeof(Vector2);
 7353:          break;
 7354:       case (int)VarCode::area:
 7355:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7356:          *sizeType = sizeof(double);
 7357:          break;
 7358:       case (int)VarCode::depth:
 7359:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7360:          *sizeType = sizeof(double);
 7361:          break;
 7362:       case (int)VarCode::radius:
 7363:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7364:          *sizeType = sizeof(double);
 7365:          break;
 7366:       case (int)VarCode::lonlat:
 7367:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7368:          *sizeType = sizeof(double);
 7369:          break;
 7370:       case (int)VarCode::ghat:
 7371:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7372:          *sizeType = sizeof(Vector2);
 7373:          break;
 7374:       case (int)VarCode::kb:
 7375:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7376:          *sizeType = sizeof(int);
 7377:          break;
 7378:       case (int)VarCode::isdry:
 7379:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7380:          *sizeType = sizeof(int);
 7381:          break;            
 7382:       case (int)VarCode::w:
 7383:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7384:          *sizeType = sizeof(double);
 7385:          break;
 7386:       case (int)VarCode::FaceIndices:
 7387:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7388:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7389:          *sizeType = sizeof(Node);
 7390:          break;
 7391:       default:
 7392:          *offset = -1;
 7393:    }
 7394: }
