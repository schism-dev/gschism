 8379:       case (int)VarCode::outputCoords:
 8380:          const Point2 coords = side->outputCoords();
 8381:          res[side->idx*2    ] = coords.x;
 8382:          res[side->idx*2 + 1] = coords.y;
 8383:          break;
 8384:    }
 8385: }
