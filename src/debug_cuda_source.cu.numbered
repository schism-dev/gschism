 1014: struct Side {
 1015: 
 1016:    // Geometry information
 1017:    int idx;               // Index of the side
 1018:    Node *n1, *n2;
 1019:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1020: 
 1021:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1022:    Vector2 center;        // Location of side center. 
 1023:    double zc[nvrt];       // Side center z-coord at each vertical level
 1024: 
 1025:    #ifdef USE_FRAMES
 1026:    Frame frame;
 1027:    #endif
 1028: 
 1029:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1030:                           // this is nullptr
 1031:    
 1032:    int kb;                // Bottom index of the side
 1033:    bool isDry;            // True if the side is dry
 1034:  
 1035:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1036: 
 1037:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1038: 
 1039:    // Physical information
 1040:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1041:    Vector2 btu[nvrt];           // Back-tracked velocity
 1042:    Vector2 U;                   // Vertically averaged velocity vector  
 1043: 
 1044:    Vector2 nuGradU[nvrt];          // nu*grad u
 1045: 
 1046:    Vector2 bcc[nvrt];           // Baroclinic term
 1047:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1048: 
 1049:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1050:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1051:    Vector2 gradPr;               // Gradient of pressure
 1052:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1053: 
 1054: 
 1055:    double hhat;                 // \breve{H} in notes
 1056: 
 1057:    double shapiro;
 1058: 
 1059:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1060: 
 1061:    double coriolis;             // Coriolis parameter
 1062: 
 1063:    // Vegetation parameters
 1064:    double veg_c2;
 1065:    double veg_beta;
 1066: 
 1067:    // Bottom drag parameters.
 1068:    double chi;
 1069:    double chi2;
 1070: 
 1071:    __inline__ __device__ Point2 outputCoords(void) const;
 1072: 
 1073:    __inline__ __device__ double x(double t) const;
 1074:    __inline__ __device__ double y(double t) const;
 1075:    __inline__ __device__ double z(double t) const;
 1076:    __inline__ __device__ double lon(void) const;
 1077:    __inline__ __device__ double lat(void) const;
 1078:    __inline__ __device__ Point2 p2_t(double t) const;
 1079:    __inline__ __device__ Point3 p3_t(double t) const;
 1080: 
 1081:    #ifdef USE_FRAMES
 1082:    __device__ void setFrame(void) {
 1083:       double lat, lon;
 1084:       const Point3 p = toPoint3(center, centerZ());
 1085: 
 1086:       // Compute the latitude and longitude of the element center
 1087:       computeLatLon(p, lat, lon);
 1088: 
 1089:       frame.update(lat, lon);        
 1090:    }
 1091:    #endif
 1092: 
 1093:    __inline__ __device__ double centerZ(void)      const;
 1094:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1095:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1096:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1097:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1098: 
 1099:    __inline__ __device__ Side* neigh(int index) const { 
 1100:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1101:       assert(index >= 0 && index < 4); 
 1102:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1103: 
 1104:       const int ielem = index & 1;           // 0 or 1
 1105:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1106: 
 1107:       const Element* elem = elems[ielem];
 1108: 
 1109:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1110: 
 1111:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1112: 
 1113:    }
 1114: 
 1115:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1116: 
 1117:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1118: 
 1119:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1120:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1121:    __inline__ __device__ int iadv(void) const;
 1122: 
 1123:    __inline__ __device__ double grav3(void) const;
 1124:    
 1125:    __inline__ __device__ double eta2(void) const;
 1126:    __inline__ __device__ double eta1(void) const;
 1127:    __inline__ __device__ double w2(int k) const;
 1128:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1129:    __inline__ __device__ double depth(void) const;
 1130:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1131:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1132: 
 1133:    __inline__ __device__ double dfv(int k) const;
 1134: 
 1135:    __inline__ __device__ double veg_h(void)  const;
 1136:    __inline__ __device__ double veg_nv(void) const;
 1137:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1138:    __inline__ __device__ double veg_alpha3D(int k) const;
 1139:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1140: 
 1141:    __inline__ __device__ double Cd(void) const;
 1142: 
 1143:    __inline__ __device__ Vector2 tau(void) const;
 1144: 
 1145:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1146:    
 1147: 
 1148:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1149:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1150:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1151:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1152:    } 
 1153:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1154:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1155:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1156:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1157: 
 1158:    // Get valid starting element (for backtracking)
 1159:    __inline__ __device__ Element* getStartElement() {
 1160:       return elems[0] ? elems[0] : elems[1];
 1161:    }
 1162: 
 1163:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1164:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1165:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1166: 
 1167:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1168: 
 1169:       // Dot product of the negative velocity vector with the side normal vector
 1170:       const double dot_prod1 = -dot(u, n);
 1171: 
 1172:       // Vector from side center to element 0 centroid
 1173:       const Vector2 v2 = elems[0]->center - center;
 1174: 
 1175:       // Dot product of the vector with the side normal vector
 1176:       const double dot_prod2 = dot(v2, n);
 1177: 
 1178:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1179:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1180: 
 1181:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1182:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1183: 
 1184:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1185: 
 1186:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1187:       else                           return !isDry1 ? elems[1] : elems[0];
 1188: 
 1189:  
 1190:    }
 1191: 
 1192:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1193:       // Given an element, returns the other element that shares this side
 1194:       return (elems[0] == elem) ? elems[1] : elems[0];
 1195:    }
 1196: 
 1197:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1198:       // Given a node, returns the other node that shares this side
 1199:       return (n1 == node) ? n2 : n1;
 1200:    }
 1201:  
 1202:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1203: 
 1204: 
 1205: 
 1206: 
 1207: };
 1208: 
