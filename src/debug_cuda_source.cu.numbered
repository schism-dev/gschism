 2086: 
 2087:       assert(level < nvrt && "Level is out of range");
 2088:       // Get the values of the field at the nodes of the element
 2089:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2090:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2091:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2092:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2093:       else          res[3] = T();
 2094:    }    
