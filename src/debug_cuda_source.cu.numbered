 8362: extern "C" __global__ void getNodeVarFunc(int varCode, double *res) {
 8363: 
 8364:    NODE(node);
 8365: 
 8366:    switch (varCode) {
 8367:       case (int)VarCode::outputCoords:
 8368:          const Point2 coords = node->outputCoords();
 8369:          res[node->idx*2    ] = coords.x;
 8370:          res[node->idx*2 + 1] = coords.y;
 8371:          break;
 8372:    }
