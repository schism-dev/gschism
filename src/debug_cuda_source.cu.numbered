 2814: __device__ __inline__ void Node::updateZCoordData(void) {
 2815: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2816: 
 2817:    if (isDry2()) return;
 2818: 
 2819:    if constexpr(ivcor == 2) {  // SZ coordinates
 2820:       
 2821:       // Compute bottom level index
 2822:       if (depth <= mesh->h_s) {
 2823:             kb = izlev;
 2824: 
 2825:       } else {
 2826:          kb = -1;
 2827:          for (int i = 0; i < nzlev; i++) {
 2828:             // XXX Use binary search
 2829:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2830:                kb = i;
 2831:                break;
 2832:             }
 2833:          }
 2834:       }
 2835:    } 
 2836:    else if (ivcor == 1) {  // Localized sigma
 2837:       // Do nothing
 2838:    }
 2839: 
 2840: }
 2841: 
 2842: __device__ double Node::compZCoord(int k) const {
 2843:    // Computes the z coordinate at level k.
 2844:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2845:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2846:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2847:    // used 
 2848:    
 2849:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2850: 
 2851: // if (htot2() <= h0) printf("idx = %d, htot2() = %f, h0 = %f\n", idx, htot2(), h0); XXX
 2852: if (htot2() <= h0) return 0.0; // XXX
 2853:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2854: 
 2855:    if constexpr(ivcor == 2) {
 2856: 
 2857:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2858:       const double h_c = mesh->h_c;
 2859:       const double theta_f = mesh->theta_f;
 2860:       const double sinh_theta_f = mesh->sinh_theta_f;
 2861: 
 2862:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2863:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2864:       // once per time step/node.
 2865:       // CHECK: updateZCoordData
 2866: 
 2867:       //  To simplify comparisons, I define index versions of count variables.
 2868:       if      (k == ivrt)           return eta2; 
 2869:       else if (k == izlev)          return -hmod2;
 2870:       else if (k == kb)             return -depth;
 2871:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2872:       else if (k > izlev) {
 2873:          const int ksig = k - izlev;
 2874: 
 2875:          if (hmod2 <= h_c) {
 2876: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2877:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2878:          } 
 2879:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2880:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2881:             assert(false && "ZCOOR: invalid h_c\n");
 2882:          } 
 2883:          else {
 2884: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2885:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2886:                          h_c * mesh->sigma[ksig] + 
 2887:                          (hmod2 - h_c) * mesh->cs[ksig];
 2888:          }
 2889:       } else { 
 2890:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2891:       }
 2892: 
 2893:    }
 2894:    else if constexpr(ivcor == 1) {
 2895:       if (k == kb) return -depth;
 2896:       else if (k == nvrt-1) return eta2;
 2897:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2898:    }
 2899:    
 2900:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2901:    return 0.0;
 2902: }
 2903: 
 2904: 
 2905: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2906:    // Checks if a side in on the boundary
 2907:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2908: 
 2909:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2910:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2911: 
 2912:    // Indices of the nodes that form the side
 2913:    const int n1 = side.n1->idx;
 2914:    const int n2 = side.n2->idx;
 2915:    isLand = false;
 2916:    
 2917: if (n1 == 10) printf("nland = %d, nope = %d, ilnd[0] = %d, ilnd[1*nland] = %d, ilnd[2*nland] = %d, ilnd[3*nland] = %d\n", nland, nope, ilnd[0], ilnd[1*nland], ilnd[2*nland], ilnd[3*nland]);
 2918:    // Check if the side is on a land boundary
 2919:    for (int i = 0; i < nland; i++) {
 2920:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2921:          // Consecutive nodes in the land boundary segment
 2922:          const int b1 = ilnd[i + j*nland];
 2923:          const int b2 = ilnd[i + (j + 1)*nland];
 2924: 
 2925:          assert(b1 != -1 && b2 != -1);
 2926: 
 2927:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2928:             
 2929:             isLand = true;
 2930:             return i;
 2931:          }
 2932:       }
 2933:    }
 2934: 
 2935:    // Check if the side is on an open boundary
 2936:    for (int i = 0; i < nope; i++) {
 2937:       for (int j = 0; j < nond[i] - 1; j++) {
 2938:          // Consecutive nodes in the open boundary segment
 2939:          const int b1 = iond[i + j*nope];
 2940:          const int b2 = iond[i + (j + 1)*nope];
 2941: 
 2942:          assert(b1 != -1 && b2 != -1);
 2943: 
 2944:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2945:             isLand = false;
 2946:             return i;
 2947:          }
 2948:       }
 2949:    }
 2950: // printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2951:    return -1;
 2952: }
 2953: 
 2954: 
 2955: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2956:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2957:                                     double *wind_rotate_angle, 
 2958:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2959:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2960:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2961:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2962:                                     double *drag, double *roughness) {
 2963: 
 2964:    NODE(pnode);  
 2965:    const int i = idx_node;
 2966:    Node &node(*pnode);
 2967: 
 2968:    node.idx = i;
 2969: 
 2970:    const int idxNodeStart = nodeNeighNodesStart[i];
 2971:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2972:    node.numNodes = idxNodeEnd - idxNodeStart;
 2973:    node.nodes = nodeNeighNodes + idxNodeStart;
 2974:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2975: 
 2976: 
 2977: 
 2978:    const int idxElemStart = nodeNeighElemsStart[i];
 2979:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2980:    node.numElements = idxElemEnd - idxElemStart;
 2981:    node.elements = nodeNeighElems + idxElemStart;
 2982: 
 2983:    
 2984:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2985:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2986:       const int partNode = localNodePart[idxNodeGlobal]; 
 2987:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2988: 
 2989:       Node *node_ptr = nodes[partNode] + idxNode;
 2990:       
 2991:       nodeNeighNodes[idx] = node_ptr;
 2992:    }
 2993: 
 2994: 
 2995:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2996:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2997:       const int partElem = localElemPart[idxElemGlobal];
 2998:       const int idxElem  = localElemIndices[idxElemGlobal];
 2999: 
 3000:       Element *elem_ptr = elems[partElem] + idxElem;
 3001: 
 3002:       nodeNeighElems[idx] = elem_ptr;
 3003:    }      
 3004: 
 3005: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3006: 
 3007:    node.wind_angle = wind_rotate_angle[i];
 3008: 
 3009: 
 3010:    node.p.x   = node_coords[i * 3];
 3011:    node.p.y   = node_coords[i * 3 + 1];
 3012:    node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 3013:    node.depth = node_coords[i * 3 + 2];
 3014: 
 3015:    node.numSides = 0;
 3016: 
 3017:    node.Cd = drag[i];
 3018:    node.rough = roughness[i];
 3019:    
 3020:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3021: 
 3022:    // Links the node to the boundary information
 3023:    if (isbnd[i] >= 0) {
 3024: 
 3025:      
 3026:       // Get the index of the node boundary
 3027:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3028: 
 3029:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3030:       node.nodeBnd->node = &node;
 3031: 
 3032:       node.nodeBnd->sideBnd1 = nullptr;
 3033:       node.nodeBnd->sideBnd2 = nullptr;
 3034: 
 3035:       if (isbnd[i]>=0) {
 3036: 
 3037:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3038:          
 3039:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3040:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3041: 
 3042:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3043:          node.nodeBnd->segment->clen  = nan("1");
 3044:          node.nodeBnd->segment->carea = nan("1");
 3045: 
 3046:       }
 3047: //          else {  XXXXXX
 3048: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3049: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3050: //          }
 3051:       
 3052: 
 3053:    }
 3054:    else {
 3055: 
 3056:       node.nodeBnd = nullptr; // For internal nodes
 3057: 
 3058:       if (isbnd[i] == landSegment) {
 3059:          node.nodeBnd = &landBoundaryNode;
 3060:          node.nodeBnd->segment = &landBoundarySegment;
 3061:       }
 3062:       // node.nodeBnd->node = &node;
 3063:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3064:       // // node.nodeBnd = nullptr;
 3065:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3066:       
 3067:    }
 3068: 
 3069:    // XXXX GAUSSIAN HILL VELOCITIES
 3070: #ifdef GAUSSIAN_HILL_VELOCITIES
 3071:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3072:       constexpr double rot_per = 3000.0;
 3073:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3074:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3075:    // XXXXX
 3076: #endif
 3077: 
 3078: }
 3079: 
 3080: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3081:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3082:                                     double *wind_rotate_angle,   
 3083:                                     int *isdel, int *isidenode, int *isbnd,
 3084:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3085:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3086:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3087:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3088:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3089:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3090:                                     double *drag, double *roughness) {
 3091: 
 3092: 
 3093:    SIDE(pside);
 3094:    Side &side(*pside);
 3095:    const int i = idx_side;
 3096: 
 3097:    side.idx = i;  
 3098:    
 3099:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3100:    const double fc   = 2.0*omega_e*sin(sfea0);
 3101:    const double beta = 2.0*omega_e*cos(sfea0);
 3102: 
 3103:    // finding the pointer to the nodes that form the side
 3104:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3105:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3106: 
 3107:    const int locidx_n1 = localNodeIndices[idx_n1];
 3108:    const int locidx_n2 = localNodeIndices[idx_n2];
 3109:    const int part_n1 =   localNodePart[idx_n1];
 3110:    const int part_n2 =   localNodePart[idx_n2];
 3111: 
 3112:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3113:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3114: 
 3115:    // Counts the number of sides connected to each node
 3116:    side.n1->numSides++;
 3117:    side.n2->numSides++;
 3118: 
 3119:    // Normal, unitary vector to the side
 3120:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3121:    side.n = normalize(side.n);
 3122: 
 3123:    // Side boundary type
 3124:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3125:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3126: 
 3127:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3128:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3129:    {
 3130:       bool isLand = false;
 3131:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3132:       
 3133:       if (isbs > -1) {
 3134:          // assert(isLand || isbs>=0);
 3135:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3136: 
 3137:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3138:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3139:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3140: 
 3141:          assert (isLand == side.sideBnd->segment->isLand);
 3142: 
 3143:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3144:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3145:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3146: 
 3147:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3148:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3149:          
 3150:          side.sideBnd->side = &side;
 3151: 
 3152:       }
 3153:       else {
 3154:          side.sideBnd = nullptr;
 3155:       }
 3156:    }
 3157:    else 
 3158:    {
 3159:       side.sideBnd = nullptr;
 3160:    }
 3161: 
 3162: 
 3163:    // finding the pointer to the elements that share the side
 3164:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3165:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3166: 
 3167:    if (idx_e1 > -1) {
 3168:       const int locidx_e1 = localElemIndices[idx_e1];
 3169:       const int part_e1 =  localElemPart[idx_e1];
 3170:       side.elems[0] = elems[part_e1] + locidx_e1;
 3171: 
 3172:    }
 3173:    else {
 3174:       side.elems[0] = nullptr;
 3175:    }
 3176: 
 3177:    if (idx_e2 > -1) {
 3178:       const int locidx_e2 = localElemIndices[idx_e2];
 3179:       const int part_e2 =  localElemPart[idx_e2];
 3180:       side.elems[1] = elems[part_e2] + locidx_e2;
 3181:    }
 3182:    else {
 3183:       side.elems[1] = nullptr;
 3184:    }
 3185: 
 3186:    // Compute the center of the side
 3187:    side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3188: 
 3189:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3190:    side.shapiro = shapiro0;
 3191: 
 3192: #ifdef GAUSSIAN_HILL_VELOCITIES
 3193: // XXXX
 3194: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3195: constexpr double rot_per=3000.0;
 3196: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3197: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3198: // XXXXX      
 3199: #endif
 3200:    // Compute the z level at the center of the side
 3201:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3202: 
 3203:    // Compute the length of the side
 3204:    const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3205:    side.len = sqrt(dot(vLen, vLen));
 3206: 
 3207: 
 3208:    // Compute the Coriolis coefficient
 3209: 
 3210:    if constexpr(ncor == -1 || ncor == 0) {
 3211:       side.coriolis = coricoef;
 3212:    }
 3213:    else {
 3214:       const double sphi = side.lat();  // Latitude at the center of the side
 3215: 
 3216:       if constexpr(ics == 1) {
 3217:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3218:       }
 3219:       else {
 3220:          side.coriolis = 2.0*omega_e*sin(sphi);
 3221:       }
 3222:    }
 3223: }
 3224: 
 3225: 
 3226: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3227:    double *node_coords, double *node_coords_ll, bool use_ll,
 3228:    double *wind_rotate_angle,   
 3229:    int *isdel, int *isidenode, int *isbnd,
 3230:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3231:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3232:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3233:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3234:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3235:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3236:    double *drag, double *roughness) {
 3237: 
 3238:    ELEM(pelem);
 3239:    Element &elem(*pelem);
 3240:    const int i = idx_elem;
 3241:    
 3242:    elem.idx = i;
 3243: 
 3244:    for (int j = 0; j < i34[i]; j++) {
 3245:       const int idxNode = elnode[i*4 + j];  
 3246:       const int idxSide = elside[i*4 + j];
 3247:       
 3248:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3249:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3250: 
 3251: 
 3252:       // Find the neighboring element  
 3253:       if (elem.sides[j]->elems[0] == &elem) {
 3254:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3255:       }
 3256:       else {
 3257:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3258:       }
 3259:       
 3260:    }
 3261: 
 3262:    elem.i34 = i34[i];
 3263: 
 3264:    // Compute the centroid of the element and its depth
 3265:    Vector2 center = {0.0, 0.0};
 3266:    elem.depth = 0.0;
 3267:    for (int j = 0; j < i34[i]; j++) {
 3268:       center += elem.nodes[j]->p2()/i34[i];
 3269:       elem.depth  += elem.nodes[j]->p.z/i34[i];
 3270:    }
 3271:    elem.center = center;
 3272: 
 3273:    
 3274:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3275:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3276: 
 3277:    elem.area = elem.computeSignedArea(); 
 3278:    elem.radius = sqrt(elem.area)/pi; 
 3279:    
 3280:    // Determines which way the normal vector to each side is oriented.
 3281:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3282:    for (int j = 0; j < i34[i]; j++)  
 3283:    {
 3284:       if (elem.sides[j]->elems[0] == &elem) {
 3285:          elem.ssign[j] =  1.0;
 3286:       }
 3287:       else {
 3288:          elem.ssign[j] = -1.0;
 3289:       }
 3290: 
 3291:    }
 3292: 
 3293:    // Derivatives of shape functions
 3294:    //  For ics=2, this is done inside element/ll frame XXX
 3295:    //  For quads, the derivative is evaluated at centroid
 3296:    for (int j = 0; j < elem.i34; j++) {
 3297:       const double area = elem.area;
 3298:       const int id2 = elem.nxq(1 + j);
 3299:       const int id3 = elem.nxq(2 + j);
 3300:       const int id4 = elem.nxq(3 + j);
 3301:       if (elem.isTri()) {
 3302:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3303:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3304:          // da1/dx = (y1 - y2)/(2*area)
 3305:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3306:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3307:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3308:       }
 3309:       else  { // Quad; evaluate at centroid
 3310:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3311:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3312:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3313:       } // if Tri
 3314: 
 3315:    } // for j   
 3316:    
 3317:    
 3318: 
 3319: }
 3320: 
 3321: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3322:                                             double *emo, double *efa, 
 3323:                                             double *umo, double *ufa, 
 3324:                                             double *vmo, double *vfa) {
 3325: 
 3326: 
 3327:    NODE_BND(nodeBnd);
 3328:    const int idx = idx_node_bnd;    
 3329: 
 3330:    nodeBnd->idx = idx;
 3331: 
 3332:    // Need to find the segment index and the index of the node on the segment
 3333:    int idxNode = -1;
 3334:    int iseg, i;
 3335:    for (iseg = 0; iseg < nope; iseg++) {
 3336:       // for each segment...
 3337:       for (i = 0; i < nond[iseg]; i++) {
 3338:          idxNode = iond[iseg + i*nope];
 3339:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3340:          
 3341:       }
 3342:    }
 3343: 
 3344:    assert(iseg < nope && "iseg is out of bounds");
 3345: 
 3346: found: // Jump here if the node is found
 3347: 
 3348: 
 3349:    nodeBnd->isEssentialBC = true;
 3350:    nodeBnd->elbc = 0.0;
 3351: 
 3352:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3353: 
 3354:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3355:       nodeBnd->efa[jfr] = efa[idx2];
 3356:       nodeBnd->emo[jfr] = emo[idx2];
 3357:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3358:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3359: 
 3360:    }
 3361:         
 3362: 
 3363: }
 3364: 
 3365: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3366:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3367:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3368:                 int *isdel, int *isidenode, int *isbnd,
 3369:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3370:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3371:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3372:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3373:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3374:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
