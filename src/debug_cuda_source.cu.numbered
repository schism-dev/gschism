  431: // Polynomial class
  432: template<int grade>
  433: struct Polynomial {
  434:     // Static assertion to give a clear error message at compile time
  435:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  436: };
  437: 
  438: 
  439: // Explicit specialization for grade 4
  440: template<>
  441: struct Polynomial<4> {
  442:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  443: 
  444:    // Constructor from coefficients
  445:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  446: 
  447:    __device__ __forceinline__ double eval(double x) const {
  448:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  449:    }
  450: };
