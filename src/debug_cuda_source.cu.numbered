 6167: extern "C" {
 6168: 
 6169:    __global__ void scaleGravity(double loadtide_coef) {
 6170: 
 6171: 
 6172:       NODE(node);
 6173: 
 6174:       // SAL option: scale gravity
 6175:       if constexpr(iloadtide==2) {  // simple const
 6176:          node->grav2 = grav*(1.0 - loadtide_coef);
 6177: 
 6178:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 6179:         
 6180:           const double depth = max(node->depth, 0.0);
 6181:           const double tmp1 = sqrt(depth);
 6182:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 6183:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 6184:                              2.6969e-13*depth*depth*depth*tmp1;
 6185:           
 6186:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 6187:           
 6188: 
 6189: 
 6190:           node->grav2 = grav*(1.0 - beta_bar);
 6191: 
 6192:       } else {  // iloadtide=0,1
 6193:           node->grav2 = grav;
 6194: 
 6195:       }
 6196: 
 6197:    }
 6198: 
 6199: 
 6200:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 6201:       NODE(node);
 6202: 
 6203:       const int idx = node->idx;
 6204:       Vector2 wind = {xWind[idx], yWind[idx]};
 6205: 
 6206:       if constexpr(nws != 0 && iwindoff != 0) {
 6207:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6208:       }
 6209: 
 6210:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6211:       node->setWind(wind);
 6212: 
 6213:       node->pr = pressAir[idx];
 6214:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6215: 
 6216:    }
 6217: 
 6218:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6219: 
 6220:       NODE(node);
 6221: 
 6222:       node->ETP = 0.0;
 6223: 
 6224:       if constexpr(ntip == 0) return;
 6225: 
 6226:       // For all tidal potential components
 6227:       for (int j=0; j<ntip; j++) {
 6228: 
 6229:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6230: 
 6231:          node->ETP += nodeETP;
 6232: 
 6233:          if constexpr(iloadtide==1) { // loading tide
 6234:             assert(false && "Loading tide not implemented");
 6235:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6236:          }
 6237:          
 6238:       }
 6239: 
 6240:      
 6241:    }
 6242: 
 6243:    __global__ void getBoundaryConditions(double time) {
 6244:       // Get boundary conditions
 6245:       // XXX IMPLEMENT THIS
 6246:       // assert(true && "getBoundaryConditions not implemented");
 6247: 
 6248: 
