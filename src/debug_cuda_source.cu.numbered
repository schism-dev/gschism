 1445:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1446:       // Compute the different time ramps used in the code 
 1447:       // This function is performed by just one thread
 1448: 
 1449:       if constexpr(ibc == 0) {
 1450:          if (drampbc > 0.0) {
 1451:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1452:          } else {
 1453:             rampbc = 1.0;
 1454:          }
 1455: 
 1456:          if (nws != 0 && drampwind > 0.0) {
 1457:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1458:          } else {
 1459:             rampwind = 1.0;
 1460:          }
 1461:       }
 1462: 
 1463:       if (drampwafo > 0.0) {
 1464:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1465:       } else {
 1466:          rampwafo = 1.0;
 1467:       }
 1468: 
 1469:       // For source/sinks
 1470:       if (if_source && dramp_ss > 0.0) {
 1471:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1472:       } else {
 1473:          ramp_ss = 1.0;
 1474:       }
 1475: 
 1476:       if (dramp > 0.0) {
 1477:          ramp = tanh(2.0*time/86400.0/dramp);
 1478:       } else {
 1479:          ramp = 1.0;
 1480:       }
 1481: 
 1482:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1483:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1484:    }
 1485:       
 1486: 
 1487:    __global__ void computeBedDeformation(void) {
 1488:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1489: 
 1490:    }
