 5995:    __global__ void zeroNodalVelocities(void) {
 5996:       NODE(node);
 5997: 
 5998:       for (int k = 0; k < nvrt; k++) {
 5999:          node->u2[k]   = {0.0, 0.0};
 6000:          node->w2[k]   = 0.0;
 6001:          node->utmp[k] = {0.0, 0.0};
 6002:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6003:       }
 6004:    }
 6005: 
 6006:  
 6007: 
 6008:    __global__ void computeNodalVerticalVelocities1(void) {
 6009:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6010:    // Adds the element's vertical velocity times the element's area.
 6011:       ELEM(elem);
 6012: 
 6013:       for (int j = 0; j < elem->i34; j++) {
 6014:          Node *node = elem->nodes[j];
 6015: 
 6016:          for (int k = node->kb; k < nvrt; k++) {
 6017:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6018:          }
 6019:          atomicAdd(&(node->tmp.d), elem->area);
 6020:       }
 6021:    }
 6022: 
 6023:    __global__ void computeNodalVerticalVelocities2(void) {
 6024:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6025:    // Divides by the total area of the elements sharing the    node.
 6026:       NODE(node);
 6027: 
 6028:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6029: 
 6030:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6031:    }
 6032: 
 6033: 
 6034:    __global__ void computeNodalHorizontalVelocities1(void) {
 6035: 
 6036:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6037:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6038: 
 6039:       ELEM(elem);
 6040: 
 6041:       if (elem->isDry) return;
 6042: 
 6043:       const int kb = elem->kb;
 6044:       const bool isTri = elem->isTri();
 6045: 
 6046:       if constexpr(indvel <= 0) {
 6047:          // Assuming discontinous hvel.
 6048: 
 6049:          if (isTri) { // For triangles
 6050:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6051:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6052: 
 6053:             for (int j = 0; j < 3; j++) {
 6054:                // For every node of the triangle...
 6055:                Node *node = elem->nodes[j];
 6056: 
 6057:                if (node->isDry) continue;
 6058: 
 6059:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6060:                const Side *s2 = elem->sides[(j + 1) % 3];
 6061:                const Side *s3 = elem->sides[(j + 2) % 3];
 6062: 
 6063: 
 6064:                atomicAdd(&(node->tmp.i), 1);
 6065: 
 6066:                for (int k = kb; k < nvrt; k++)  {
 6067:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6068:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6069:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6070:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6071:                   atomicAdd(&(node->utmp[k].x), u.x);
 6072:                   atomicAdd(&(node->utmp[k].y), u.y);
 6073: 
 6074:                }
 6075: 
 6076:             }
 6077:          }
 6078:          else { // For quads
 6079:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6080: 
 6081:          }
 6082: 
 6083:       }
 6084:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6085:       
 6086:    }
 6087: 
 6088: 
 6089:    __global__ void computeNodalHorizontalVelocities2(void) {
 6090:       NODE(node);
 6091: 
 6092:       const int nodeCount = node->tmp.i;
 6093: 
 6094:       if (nodeCount == 0) 
 6095:       {
 6096:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6097:          return;
 6098:       }
 6099: 
 6100:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6101:       
 6102:       const int kb = node->kb;
 6103: 
 6104:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6105:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6106:       
 6107:       
 6108:    }   
