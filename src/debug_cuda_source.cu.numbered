 3074: //    Assumption: the 4 points (including those of the side segment) are different.
 3075: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 3076: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 3077: //    If true, (xIntersect,yIntersect) is the intersection.				
 3078: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 3079: // **/
 3080: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 3081: //                                                          Side& intersectingSide, Element& nextElement,
 3082: //                                                          double& xIntersect, double& yIntersect) {
 3083: //    for (int i = 0; i < i34; i++) {
