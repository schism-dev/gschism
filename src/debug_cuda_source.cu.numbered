 5339:    __global__ void resetBoundaryAreas(void) {
 5340:       // Reset boundary areas and lengths for each segment.
 5341: 
 5342:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5343:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5344:       SIDE_BND(sideBnd);
 5345: 
 5346:       BoundarySegment *segment = sideBnd->segment;
 5347: 
 5348:       segment->carea = 0.0;
 5349:       segment->clen = 0.0;
 5350:  
 5351:    }
 5352: 
 5353:    __global__ void computeBoundaryAreas(void) {
 5354:    // Calculation of cross-section areas and lengths for flow b.c.
 5355: 
 5356:       SIDE_BND(sideBnd);
 5357: 
 5358:       const Side *side = sideBnd->side;
 5359:       BoundarySegment *segment = sideBnd->segment;
 5360: 
 5361:       if (segment->ifltype != 0) {
 5362: 
 5363:          const Node *n1 = side->n1;
 5364:          const Node *n2 = side->n2;
 5365: 
 5366:          const double htot = side->htot2();
 5367: 
 5368:          if (!side->isDry) {
 5369:             atomicAdd(&segment->carea, htot*side->len);
 5370:             atomicAdd(&segment->clen, side->len);
 5371:          }
 5372:       }
 5373: 
 5374:    }
 5375: 
 5376: 
 5377:    __global__ void computeFlowBcVelocities(double time) {
 5378: 
 5379:       SIDE_BND(sideBnd);
 5380: 
 5381:       const Side *side = sideBnd->side;
 5382:  
 5383:       const bool isDry = side->isDry;
 5384:       const bool isLand = sideBnd->segment->isLand;
 5385: 
 5386:    
 5387:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5388: 
 5389:       if (isDry || isLand) return;
 5390: 
 5391:       // For wet sides in open boundaries...
 5392:       const Vector2 n = side->n;
 5393:       const BoundarySegment *segment = sideBnd->segment;
 5394: 
 5395:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5396: 
 5397:       const int ifltype = segment->ifltype;
 5398: 
 5399:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5400:       const Vector2 r_nuth0 = r_uth0*n;
 5401: 
 5402: 
 5403:       if (ifltype == 1 || ifltype == 2) {
 5404:       
 5405:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5406: 
 5407:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5408:          
 5409:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5410:          
 5411:       } else if (ifltype == -1) { // Flather 1
 5412: 
 5413:          for (int k = 0; k < nvrt; k++) {
 5414: 
 5415:             // uth is the normal vel.; no ramp up
 5416:             const double uth = sideBnd->nuth(k);
 5417:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5418: 
 5419:             sideBnd->ubc[k] += uth*n;
 5420:          }
 5421: 
 5422:       } else if (ifltype == 3 || ifltype == 5) {
 5423:          // vnth0=0 !normal vel.
 5424: 
 5425:          Vector2 r_u1_bar = {0.0, 0.0};
 5426:          // Computes the contribution to the velocity from all tide frequencies
 5427:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5428: 
 5429:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5430:             const Vector2 umo  = sideBnd->umo(jfr); 
 5431: 
 5432:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5433:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5434:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5435:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5436: 
 5437:          }
 5438: 
 5439: 
 5440:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5441: 
 5442:       } // if (ifltype = 3 || ifltype == 5
 5443: 
 5444: 
 5445: 
 5446:    }
 5447: 
 5448:    __global__ void computeElevationBoundaryConditions(double time) {
 5449:       // Compute elevation essential boundary conditions 
 5450: 
 5451:       NODE_BND(nodeBnd); // Each boundary node.
 5452: 
 5453:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5454: 
 5455:       const Node *node = nodeBnd->node;
 5456:       const BoundarySegment *segment = nodeBnd->segment;
 5457:       const int iettype = segment->iettype;
 5458:       
 5459: 
 5460:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5461:       double eic = 0.0;
 5462:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5463:       else                 eic = 0.0;
 5464: 
 5465:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5466:       const double r_eth = ramp*nodeBnd->eth;
 5467:       double r_eta1_bar = 0.0;
 5468: 
 5469:       // Compute tide elevation
 5470:       if (iettype == 3 || iettype == 5) {   
 5471: 
 5472:          if constexpr(iloadtide==1) { // loading tide
 5473:             assert(false && "Loading tide not implemented");
 5474:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5475:          }
 5476:          
 5477:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5478: 
 5479:             const double efa  = nodeBnd->efa[jfr]; 
 5480:             const double emo  = nodeBnd->emo[jfr]; 
 5481: 
 5482:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5483:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5484:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5485: 
 5486: 
 5487:          } // for jfr
 5488: 
 5489:       } // if iettype
 5490: 
 5491:       switch (iettype) {
 5492:          case 1:
 5493:          case 2:
 5494:          case 4:
 5495:             nodeBnd->elbc = r_eic + r_eth;
 5496:             break;
 5497:          case 3:
 5498:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5499:             break;
 5500:          case 5:
 5501:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5502:             break;
 5503:       } // switch
 5504: 
 5505: 
 5506:       //Add inverse barometric effects
 5507:       if (iettype != 0 && inv_atm_bnd == 1) {
 5508:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5509:       }
 5510: 
 5511:    }
 5512: 
 5513: 
 5514:    __global__ void computeHorizontalViscosity(void) { 
 5515: 
 5516:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5517: 
 5518:       SIDE(side);
 5519: 
 5520:       if (side->isDry) return;
 5521: 
 5522:       for (int k = 0; k < nvrt; k++) {
 5523:          side->nuGradU[k] = {0.0, 0.0};
 5524:       }
 5525: 
 5526:       if constexpr(ihorcon == 1) {
 5527:          for (int k = side->kb; k < nvrt - 1; k++) {
 5528:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5529:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5530:             // By Zhang and Baptista.
 5531: 
 5532:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5533:             // This is a standard discretization of the Laplacian operator.
 5534:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5535:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5536:             // Gamma is hvis_coef0 in the code.
 5537:             // The value of gamma needs to be < 0.5.
 5538: 
 5539:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5540:             // side under consideration in each of the two possible elements that share the side.
 5541:             Vector2 sumU = {0.0, 0.0};
 5542:             for (int l = 0; l < 2; l++) {
 5543:                const Element *elem = side->elems[l];
 5544: 
 5545:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5546: 
 5547:                // Find the local index of the side in the element
 5548:                const int idxSide = elem->sideLocalIdx(side);
 5549: 
 5550:                // Find the two sides that are connected to the side under consideration
 5551:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5552:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5553: 
 5554:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5555: 
 5556:             }
 5557: 
 5558:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5559: 
 5560:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5561:    
 5562:          }
 5563:       }
 5564:       else if constexpr(ihorcon == 2) {
 5565:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5566:       }
 5567: 
 5568: 
 5569:    }
 5570: 
 5571: 
 5572:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5573: 
 5574:       // Set essential boundary conditions 
 5575:       NODE(node); // Each boundary node
 5576:       NodeBoundary *nodeBnd = node->nodeBnd;
 5577:       
 5578:  
 5579:       // Check if this node has essential BC
 5580:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5581: printf("setEssentialBC: nodeBnd->isEssentialBC = true");
 5582:          // Verify BC value is valid
 5583:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5584: 
 5585:        
 5586:          // Set diagonal to 1 and zero off-diagonals
 5587:          node->coeffDiag = 1.0;
 5588: 
 5589:          for (int j = 0; j < node->numNodes; j++) {
 5590:                node->coeffMatrix[j] = 0.0;
 5591:          }
 5592: printf("setEssentialBC: node->coeffMatrix = 0.0\n");         
 5593:          // Set solution and RHS to BC value
 5594:          node->mX  = nodeBnd->elbc;
 5595:          node->qel = nodeBnd->elbc;
 5596: printf("setEssentialBC: node->qel = nodeBnd->elbc\n");
 5597:       } else {
 5598:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5599: printf("setEssentialBC: nodeBnd->isEssentialBC = false ****, node = %p\n", node);
 5600:          for (int j = 0; j < node->numNodes; j++) {
 5601:                const Node* nbNode = node->nodes[j];
 5602:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 5603: 
 5604:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5605:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 5606: 
 5607:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5608:                   // Verify neighbor's BC value
 5609:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5610: printf("setEssentialBC: node = %p\n", node);
 5611:                   // Subtract contribution to RHS
 5612:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5613:                   node->coeffMatrix[j] = 0.0;  
 5614:                }
 5615:          }
 5616: printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 5617:       }
 5618:    }
 5619: 
