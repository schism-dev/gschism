 2802: 
 2803: __device__ double Node::compZCoord(int k) const {
 2804:    // Computes the z coordinate at level k.
 2805:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2806:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2807:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2808:    // used 
 2809:    
 2810:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2811: 
 2812:    if (isDry2()) return -depth;  // XXXX I used to return 0.0
 2813: 
 2814:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2815: 
 2816:    if constexpr(ivcor == 2) {
 2817: 
 2818:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2819:       const double h_c = mesh->h_c;
 2820:       const double theta_f = mesh->theta_f;
 2821:       const double sinh_theta_f = mesh->sinh_theta_f;
 2822: 
 2823:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2824:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2825:       // once per time step/node.
 2826:       // CHECK: updateZCoordData
 2827: 
 2828:       //  To simplify comparisons, I define index versions of count variables.
 2829:       if      (k == ivrt)           return eta2; 
 2830:       else if (k == izlev)          return -hmod2;
 2831:       else if (k == kb)             return -depth;
 2832:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2833:       else if (k > izlev) {
 2834:          const int ksig = k - izlev;
 2835: 
 2836:          if (hmod2 <= h_c) {
 2837:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2838: 
 2839:          } 
 2840:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2841:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2842:             assert(false && "ZCOOR: invalid h_c\n");
 2843:          } 
 2844:          else {
 2845:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2846:                          h_c * mesh->sigma[ksig] + 
 2847:                          (hmod2 - h_c) * mesh->cs[ksig];
 2848:          }
 2849:       } else { 
 2850:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2851:       }
 2852: 
 2853:    }
 2854:    else if constexpr(ivcor == 1) {
 2855:       if (k == kb) return -depth;
 2856:       else if (k == nvrt-1) return eta2;
 2857:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2858:    }
 2859:    
 2860:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2861:    return 0.0;
 2862: }
 2863: 
 2864: 
 2865: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2866:    // Computes the bottom drag Cd based on the selected nchi
 2867: 
 2868:    if constexpr(nchi == 0) {
 2869:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2870:       Cd = drag;  // Read from drag file
 2871: 
 2872:    } else if constexpr(nchi == 1) {
 2873:       // 
 2874: 
 2875:       bool ltmp = false; // for WBL iteration
 2876: 
 2877:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2878:       if (isDry || (rough == 0.0)) {
 2879:          Cd = 0.0;
 2880: 
 2881:       } else { //roughness >0 
 2882:          
 2883:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2884: 
 2885:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2886: 
 2887:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2888: 
 2889:       } // if rough
 2890: 
 2891:    } else if constexpr(nchi == -1) {
 2892:    // Manning 
 2893:  
 2894:       const double htot = max(hmin_man, htot2()); 
 2895:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2896: 
 2897:    } else {
 2898:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2899:       
 2900:    } // if nchi
 2901: }
 2902: 
 2903: 
 2904: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2905:    // Checks if a side in on the boundary
 2906:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2907: 
 2908:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2909:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2910: 
 2911:    // Indices of the nodes that form the side
 2912:    const int n1 = side.n1->idx;
 2913:    const int n2 = side.n2->idx;
 2914:    isLand = false;
 2915:    
 2916: 
 2917:    // Check if the side is on a land boundary
 2918:    for (int i = 0; i < nland; i++) {
 2919:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2920:          // Consecutive nodes in the land boundary segment
 2921:          const int b1 = ilnd[i + j*nland];
 2922:          const int b2 = ilnd[i + (j + 1)*nland];
 2923: 
 2924:          assert(b1 != -1 && b2 != -1);
 2925: 
 2926:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2927:             
 2928:             isLand = true;
 2929:             return i;
 2930:          }
 2931:       }
 2932:    }
 2933: 
 2934:    // Check if the side is on an open boundary
 2935:    for (int i = 0; i < nope; i++) {
 2936:       for (int j = 0; j < nond[i] - 1; j++) {
 2937:          // Consecutive nodes in the open boundary segment
 2938:          const int b1 = iond[i + j*nope];
 2939:          const int b2 = iond[i + (j + 1)*nope];
 2940: 
 2941:          assert(b1 != -1 && b2 != -1);
 2942: 
 2943:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2944:             isLand = false;
 2945:             return i;
 2946:          }
 2947:       }
 2948:    }
 2949: 
 2950:    return -1;
 2951: }
 2952: 
 2953: 
 2954: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2955:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2956:                                     double *wind_rotate_angle, 
 2957:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2958:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2959:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2960:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2961:                                     double *drag, double *roughness, double *rmanning) {
 2962: 
 2963:    NODE(pnode);  
 2964:    const int i = idx_node;
 2965:    Node &node(*pnode);
 2966: 
 2967:    node.idx = i;
 2968: 
 2969:    const int idxNodeStart = nodeNeighNodesStart[i];
 2970:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2971:    node.numNodes = idxNodeEnd - idxNodeStart;
 2972:    node.nodes = nodeNeighNodes + idxNodeStart;
 2973:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2974: 
 2975: 
 2976: 
 2977:    const int idxElemStart = nodeNeighElemsStart[i];
 2978:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2979:    node.numElements = idxElemEnd - idxElemStart;
 2980:    node.elements = nodeNeighElems + idxElemStart;
 2981: 
 2982: 
 2983:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2984:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2985:       const int partNode = localNodePart[idxNodeGlobal]; 
 2986:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2987: 
 2988:       Node *node_ptr = nodes[partNode] + idxNode;
 2989:       
 2990:       nodeNeighNodes[idx] = node_ptr;
 2991:    }
 2992: 
 2993: 
 2994:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2995:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2996:       const int partElem = localElemPart[idxElemGlobal];
 2997:       const int idxElem  = localElemIndices[idxElemGlobal];
 2998: 
 2999:       Element *elem_ptr = elems[partElem] + idxElem;
 3000: 
 3001:       nodeNeighElems[idx] = elem_ptr;
 3002:    }      
 3003: 
 3004:    node.wind_angle = wind_rotate_angle[i];
 3005: 
 3006: 
 3007:    node.p.x   = node_coords[i * 3];
 3008:    node.p.y   = node_coords[i * 3 + 1];
 3009:    node.depth = node_coords[i * 3 + 2];
 3010: 
 3011:    if (use_ll) {
 3012:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3013:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3014:    }
 3015: 
 3016: 
 3017:    node.numSides = 0;
 3018: 
 3019:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3020:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3021:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3022:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3023:    else assert(false && "populateNodes: selected nchi not implemented.");
 3024:    
 3025:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3026:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3027:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3028: 
 3029:    
 3030:    // Links the node to the boundary information
 3031:    if (isbnd[i] >= 0) {
 3032:      
 3033:       // Get the index of the node boundary
 3034:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3035: 
 3036:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3037:       node.nodeBnd->node = &node;
 3038: 
 3039:       node.nodeBnd->sideBnd1 = nullptr;
 3040:       node.nodeBnd->sideBnd2 = nullptr;
 3041: 
 3042:       if (isbnd[i]>=0) {
 3043: 
 3044:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3045:          
 3046:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3047:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3048: 
 3049:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3050:          node.nodeBnd->segment->clen  = nan("1");
 3051:          node.nodeBnd->segment->carea = nan("1");
 3052: 
 3053:       }
 3054:    } else {
 3055: 
 3056:       node.nodeBnd = nullptr; // For internal nodes
 3057: 
 3058:       if (isbnd[i] == landSegment) {
 3059:          node.nodeBnd = &landBoundaryNode;
 3060:          node.nodeBnd->segment = &landBoundarySegment;
 3061:       }
 3062:       
 3063:    }
 3064:    
 3065:    // XXXX GAUSSIAN HILL VELOCITIES
 3066: #ifdef GAUSSIAN_HILL_VELOCITIES
 3067:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3068:       constexpr double rot_per = 3000.0;
 3069:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3070:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3071:    // XXXXX
 3072: #endif
 3073: 
 3074: }
 3075: 
 3076: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3077:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3078:                                     double *wind_rotate_angle,   
 3079:                                     int *isdel, int *isidenode, int *isbnd,
 3080:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3081:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3082:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3083:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3084:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3085:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3086:                                     double *drag, double *roughness) {
 3087: 
 3088: 
 3089:    SIDE(pside);
 3090:    Side &side(*pside);
 3091:    const int i = idx_side;
 3092: 
 3093:    side.idx = i;  
 3094:    
 3095:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3096:    const double fc   = 2.0*omega_e*sin(sfea0);
 3097:    const double beta = 2.0*omega_e*cos(sfea0);
 3098: 
 3099:    // finding the pointer to the nodes that form the side
 3100:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3101:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3102: 
 3103:    const int locidx_n1 = localNodeIndices[idx_n1];
 3104:    const int locidx_n2 = localNodeIndices[idx_n2];
 3105:    const int part_n1 =   localNodePart[idx_n1];
 3106:    const int part_n2 =   localNodePart[idx_n2];
 3107: 
 3108:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3109:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3110: 
 3111:    // Counts the number of sides connected to each node
 3112:    side.n1->numSides++;
 3113:    side.n2->numSides++;
 3114: 
 3115:    // Normal, unitary vector to the side
 3116:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3117:    side.n = normalize(side.n);
 3118: 
 3119:    // Side boundary type
 3120:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3121:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3122: 
 3123:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3124:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3125:    {
 3126:       bool isLand = false;
 3127:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3128:       
 3129:       if (isbs > -1) {
 3130:          // assert(isLand || isbs>=0);
 3131:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3132: 
 3133:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3134: 
 3135:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3136:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3137: 
 3138:          assert (isLand == side.sideBnd->segment->isLand);
 3139: 
 3140:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3141:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3142:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3143: 
 3144:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3145:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3146:          
 3147:          side.sideBnd->side = &side;
 3148: 
 3149:       }
 3150:       else {
 3151:          side.sideBnd = nullptr;
 3152:       }
 3153:    }
 3154:    else 
 3155:    {
 3156:       side.sideBnd = nullptr;
 3157:    }
 3158: 
 3159: 
 3160:    // finding the pointer to the elements that share the side
 3161:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3162:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3163: 
 3164:    if (idx_e1 > -1) {
 3165:       const int locidx_e1 = localElemIndices[idx_e1];
 3166:       const int part_e1 =  localElemPart[idx_e1];
 3167:       side.elems[0] = elems[part_e1] + locidx_e1;
 3168: 
 3169:    }
 3170:    else {
 3171:       side.elems[0] = nullptr;
 3172:    }
 3173: 
 3174:    if (idx_e2 > -1) {
 3175:       const int locidx_e2 = localElemIndices[idx_e2];
 3176:       const int part_e2 =  localElemPart[idx_e2];
 3177:       side.elems[1] = elems[part_e2] + locidx_e2;
 3178:    }
 3179:    else {
 3180:       side.elems[1] = nullptr;
 3181:    }
 3182: 
 3183:    // Compute the center of the side
 3184:    side.center = 0.5*(side.n1->p + side.n2->p);
 3185: 
 3186:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3187:    side.shapiro = shapiro0;
 3188: 
 3189: #ifdef GAUSSIAN_HILL_VELOCITIES
 3190: // XXXX
 3191: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3192: constexpr double rot_per=3000.0;
 3193: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3194: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3195: // XXXXX      
 3196: #endif
 3197:    // Compute the z level at the center of the side
 3198:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3199:    
 3200:    // Compute the length of the side
 3201:    const Vector2 vLen = side.n2->p - side.n1->p;
 3202:    side.len = sqrt(dot(vLen, vLen));
 3203: 
 3204: 
 3205:    // Compute the Coriolis coefficient
 3206: 
 3207:    if constexpr(ncor == -1 || ncor == 0) {
 3208:       side.coriolis = coricoef;
 3209:    }
 3210:    else {
 3211:       const double sphi = side.lat();  // Latitude at the center of the side
 3212: 
 3213: // XXXXXX ERROR WHEN use_ll is false??????
 3214:       if constexpr(ics == 1) {
 3215:          // XXXXXXX
 3216:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3217:       }
 3218:       else {
 3219:          side.coriolis = 2.0*omega_e*sin(sphi);
 3220:       }
 3221: 
 3222:    }
 3223: }
 3224: 
 3225: 
 3226: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3227:    double *node_coords, double *node_coords_ll, bool use_ll,
 3228:    double *wind_rotate_angle,   
 3229:    int *isdel, int *isidenode, int *isbnd,
 3230:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3231:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3232:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3233:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3234:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3235:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3236:    double *drag, double *roughness) {
 3237: 
 3238:    ELEM(pelem);
 3239:    Element &elem(*pelem);
 3240:    const int i = idx_elem;
 3241: 
 3242:    elem.idx = i;
 3243: 
 3244:    for (int j = 0; j < i34[i]; j++) {
 3245:       const int idxNode = elnode[i*4 + j];  
 3246:       const int idxSide = elside[i*4 + j];
 3247:       
 3248:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3249:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3250: 
 3251:       // Find the neighboring element  
 3252:       if (elem.sides[j]->elems[0] == &elem) {
 3253:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3254:       }
 3255:       else {
 3256:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3257:       }
 3258:       
 3259:    }
 3260: 
 3261:    elem.i34 = i34[i];
 3262: 
 3263:    // Compute the barycenter of the element and its depth
 3264:    elem.center = {0.0, 0.0};
 3265:    elem.depth = 0.0;
 3266:    for (int j = 0; j < i34[i]; j++) {
 3267: 
 3268:       elem.center += elem.nodes[j]->p/i34[i];
 3269:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3270:    }
 3271: 
 3272: 
 3273:    
 3274:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3275:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3276: 
 3277:    elem.area = elem.computeSignedArea(); 
 3278:    elem.radius = sqrt(elem.area)/pi; 
 3279:    
 3280:    // Determines which way the normal vector to each side is oriented.
 3281:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3282:    for (int j = 0; j < i34[i]; j++)  
 3283:    {
 3284:       if (elem.sides[j]->elems[0] == &elem) {
 3285:          elem.ssign[j] =  1.0;
 3286:       }
 3287:       else {
 3288:          elem.ssign[j] = -1.0;
 3289:       }
 3290: 
 3291:    }
 3292: 
 3293:    // Derivatives of shape functions
 3294:    //  For ics=2, this is done inside element/ll frame XXX
 3295:    //  For quads, the derivative is evaluated at centroid
 3296:    for (int j = 0; j < elem.i34; j++) {
 3297:       const double area = elem.area;
 3298:       const int id2 = elem.nxq(1 + j);
 3299:       const int id3 = elem.nxq(2 + j);
 3300:       const int id4 = elem.nxq(3 + j);
 3301:       if (elem.isTri()) {
 3302:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3303:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3304:          // da1/dx = (y1 - y2)/(2*area)
 3305:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3306:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3307:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3308:       }
 3309:       else  { // Quad; evaluate at centroid
 3310:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3311:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3312:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3313:       } // if Tri
 3314: 
 3315:    } // for j   
 3316:    
 3317:    
 3318: 
 3319: }
 3320: 
 3321: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3322:                                             double *emo, double *efa, 
 3323:                                             double *umo, double *ufa, 
 3324:                                             double *vmo, double *vfa) {
 3325: 
 3326: 
 3327:    NODE_BND(nodeBnd);
 3328:    const int idx = idx_node_bnd;    
 3329: 
 3330:    nodeBnd->idx = idx;
 3331: 
 3332:    // Need to find the segment index and the index of the node on the segment
 3333:    int idxNode = -1;
 3334:    int iseg, i;
 3335:    for (iseg = 0; iseg < nope; iseg++) {
 3336:       // for each segment...
 3337:       for (i = 0; i < nond[iseg]; i++) {
 3338:          idxNode = iond[iseg + i*nope];
 3339:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3340:          
 3341:       }
 3342:    }
 3343: 
 3344:    assert(iseg < nope && "iseg is out of bounds");
 3345: 
 3346: found: // Jumped here when the node was found
 3347: 
 3348:    nodeBnd->isEssentialBC = true;
 3349:    nodeBnd->elbc = 0.0;
 3350: 
 3351:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3352: 
 3353:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3354:       nodeBnd->efa[jfr] = efa[idx2];
 3355:       nodeBnd->emo[jfr] = emo[idx2];
 3356:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3357:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3358: 
 3359:    }
 3360:         
 3361: 
 3362: }
