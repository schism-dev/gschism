 7110: 
 7111:    __global__ void setVelocityOpenBndNodes(void) {
 7112:    // For open boundary nodes sets their velocity to the imposed values.
 7113: 
 7114:       SIDE_BND(sidebnd);
 7115: 
 7116:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7117:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7118:          // to its segment to the average of the side velocity.
 7119: 
 7120:          for (int k = 0; k < nvrt; k++) {
 7121:             Node *n1 = sidebnd->side->n1;
 7122:             Node *n2 = sidebnd->side->n2;
 7123: 
 7124: 
 7125:             Vector2 n1_u2(n1->u2[k]);
 7126:             Vector2 n2_u2(n2->u2[k]);
 7127: 
 7128:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7129:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7130:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7131:             }
 7132:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7133:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7134:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7135:             }
 7136: 
 7137:          }
 7138: 
 7139:       }
 7140: 
 7141:    }
 7142: 
 7143: 
 7144:    __global__ void computeVerticalVelocity(void) {
 7145:       // Computes the vertical velocity at the (2D) element's centroid.
 7146:       // In this function we will be considering volumetric elements, with side faces and a 
 7147:       // bottom and a top face. We will call them SFs, BF and TF.
 7148:       // It computes the flux coming from BF and the SFs.
 7149:       // If the bed is moving, it takes that into account.
 7150:       // Since water is incompressible, the integral of the velocity times the normal vector
 7151:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7152:       // and the BF is equal to the flux going out from the TF.
 7153:       // TF = - BF - sum(SFs).
 7154:       // It then computes the horizontal velocity at the center of TF.
 7155:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7156:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7157:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7158: 
 7159:       ELEM(elem);
 7160: 
 7161:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7162: 
 7163:       if (elem->isDry) return;
 7164: 
 7165:       const int kb = elem->kb;
 7166:       const bool isTri = elem->isTri();
 7167: 
 7168:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7169: 
 7170:       // Compute the bottom velocity
 7171:       if constexpr(imm != 0) {
 7172:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7173:       }
 7174: 
 7175: 
 7176:       double bottomArea3D;
 7177:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7178: 
 7179:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7180: 
 7181:       double topArea3D;
 7182: 
 7183:       // Bottom face flux
 7184:       double bottomFlux = 0.0;
 7185:       Vector2 u2meanBottom = {0.0, 0.0};
 7186:       const Vector2 gradh = elem->grad2(&Node::depth);
 7187:       if constexpr(imm==2) {
 7188:          Vector3 ubed;
 7189: 
 7190:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7191:          // updateBDEF(ubed);
 7192:      
 7193:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7194: 
 7195:          // elem->w[kb] += ubed.z;
 7196:       }
 7197:       else {
 7198: 
 7199:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7200:   
 7201:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7202:          // in the direction of motion.
 7203:          const double bottomW = - dot(gradh, u2meanBottom);  
 7204:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7205: 
 7206:          // VElocity associated to the bed deformation
 7207:          double bedVelocity = 0.0;
 7208:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7209: 
 7210:          elem->w[kb] = bedVelocity + bottomW; 
 7211: 
 7212:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7213:          
 7214:       } // if imm
 7215: 
 7216:       // Compute w for kb+1 to nvrt-1
 7217:       for (int l = kb; l < nvrt - 1; l++) {
 7218: 
 7219:          // normal vector to the top face of the "volumetric" element (3D)
 7220:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7221: 
 7222:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7223:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7224: 
 7225:          // Compute the total flux at the sides
 7226:          double sideFlux = 0.0;
 7227: 
 7228:          for (int j = 0; j < elem->i34; j++) {
 7229:             const Side *side = elem->sides[j];
 7230:             const int kbs = side->kb;
 7231:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7232:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7233:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7234: 
 7235:             // The area is "clamped" meaning that it takes kb into account.
 7236:             const double sideArea = side->areaClamped(l);
 7237: 
 7238:             const double sign = elem->ssign[j]; 
 7239: 
 7240:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7241:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7242:          }
 7243:          
 7244:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7245:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7246:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7247: 
 7248:          // The flux at the top ace can be computed from the other flows.
 7249:          // All fluxes are in directions into the prism.
 7250:          const double topFlux = - sideFlux - bottomFlux;
 7251: 
 7252:          // Flux at the top face due to the horizontal velocities only
 7253:          // topFlux = topHorizontalFlux + topVerticalFlux
 7254:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7255: 
 7256:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7257:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7258: 
 7259:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7260: 
 7261:          bottomFlux = -topFlux;
 7262:          
 7263:       }
 7264: 
 7265:    }  
 7266: 
 7267: 
 7268: 
 7269: 
 7270: 
 7271: 
 7272: 
 7273: // !===============================================================================
 7274: // !===============================================================================
 7275: 
 7276: } // extern "C"
 7277: 
 7278: #ifdef DONTCOMPILE
 7279: __device__ void computeVerticalAdvection(void) {
 7280:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7281: 
 7282:    sdbt(1:2,:,:)=0.d0
 7283: 
 7284:    const Side *side = FROM kernel;
 7285: 
 7286:    if(side->isDry) return;
 7287: 
 7288:    // If side is wet...
 7289: 
 7290: 
 7291:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7292:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7293:    double ws[nvrt] = {} // w @ side
 7294:    int icount = 0;
 7295:    for (int j=0; j<2; j++) {
 7296:       const Element *elem = side->elements[j];
 7297:        
 7298:       if(elem != nullptr) {
 7299:          icount++;
 7300:          for (int k=0; k<nvrt; k++) {
 7301:             ws[k] = ws[k] + elem->w[k];
 7302:          }
 7303:       }
 7304:    }  // for j
 7305: 
 7306:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7307:    ws = ws/icount;
 7308: 
 7309:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7310:    // Splines allow for a smooth transition between vertical levels.
 7311:    // Splines have continuity restrictions at the internal knots, but
 7312:    // we have to provide the 1st derivatives at the endpoints.
 7313:    const int kbs = side->kbs; 
 7314:    
 7315:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7316:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7317:    initCubicSpline(kbs, nvrt, side, ws, up)
 7318: 
 7319:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7320:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7321:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7322: 
 7323:    // Total advection (average onto side)
 7324:    const Node *node1 = side->nodes[0];
 7325:    const Node *node2 = side->nodes[1];
 7326:    for (int k=kbs(i); k<nvrt; k++) {
 7327: 
 7328:       Vector2 bcc1 = node1->bcc[k];
 7329:       Vector2 bcc2 = node2->bcc[k];
 7330:       if constexpr(ics == 2) {
 7331:          // Project the velocities from the node frames to the side frame
 7332:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7333:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7334:       }
 7335: 
 7336:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7337:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7338: 
 7339:    }
 7340: }
 7341: #endif
 7342: 
 7343: 
 7344: extern "C" {
 7345:    __global__ void computeElemAverageGhat(void) {
 7346:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7347: 
 7348:       ELEM(elem);
 7349:       
 7350:       elem->ghat1= {0.0, 0.0};  
 7351: 
 7352:       if constexpr(ihydraulics != 0) {
 7353:          if (nhtblocks > 0 && elem->isblock) return;
 7354:       }
 7355: 
 7356:       
 7357:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7358:       // cff1-3: coefficients for 2D/3D
 7359: 
 7360:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7361:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7362:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7363: 
 7364:       if (elem->isDry) return;
 7365: 
 7366:       // Average of the coefficients
 7367:       double av_cff1 = 0.0;  // av. for cff1
 7368:       double av_cff2 = 0.0;  // av. for cff2
 7369:       double av_cff3 = 0.0;  // av. for cff3
 7370:       double av_df = 0.0;  // av. for H^\alpha / H
 7371:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7372:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7373: 
 7374:       const int i34 = elem->i34;
 7375:       const int kb  = elem->kb;
 7376: 
 7377:       for (int j=0; j<i34; j++) {
 7378:          // For each node and side in the element...
 7379: 
 7380:          const Node *node = elem->nodes[j];
 7381:          const Side *side = elem->sides[j];
 7382: 
 7383:          const double chi      = side->chi;
 7384:          const double veg_c2   = side->veg_c2;
 7385:          const double veg_beta = side->veg_beta;
 7386:          const double veg_h    = side->veg_h();
 7387:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7388: 
 7389:          const Vector2 gradPhi = elem->gradPhi[j];
 7390: 
 7391:          // Node - const in elem
 7392:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7393:          elem->gradPr  += node->pr  *gradPhi;
 7394: 
 7395:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7396: 
 7397:         
 7398:          const double htot  = side->htot2();        // Total depth at the side
 7399:          const double zctr2 = side->zTopCanopy();  
 7400: 
 7401:          double cff1; 
 7402:          double cff2; 
 7403:          double cff3;   
 7404:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7405:          // coefficients applied to 2D/3D case 
 7406:             cff1 = side->hhat/htot;
 7407:             cff2 = 0.0;
 7408:             cff3 = 0.0;
 7409:          } else { //3D
 7410:             //Init for no-veg case
 7411:             cff1 = 1.0;
 7412:             cff2 = 1.0;
 7413:             cff3 = 0.0;
 7414: 
 7415:             if constexpr(iveg != 0) {
 7416:                // Computes coefficients used with vegetation terms G1, G2
 7417:                // cff1, cff3 are used for the first two terms in G1, G2:
 7418:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7419:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7420:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7421:                if(veg_h < 0.99*htot) { // submergent vegetation
 7422:                   cff1 = 1.0;
 7423:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7424:                   cff3 = veg_c;
 7425: 
 7426:                } else { // emergent vegetation
 7427:                   cff1 = 1.0/(1.0 + veg_c2);
 7428:                   cff2 = cff1;
 7429:                   cff3 = 0.0;
 7430: 
 7431:                }
 7432:             } // if iveg
 7433:          } //  2D/3D
 7434: 
 7435:          av_cff1 += cff1/i34;
 7436:          av_cff2 += cff2/i34;
 7437:          av_cff3 += cff3/i34;
 7438:          av_cff2_chi += cff2*chi/i34;
 7439:          av_cff3_chi += cff3*chi/i34;
 7440:          av_df += min(htot, veg_h)/(htot*i34);
 7441: 
 7442: 
 7443:          // btrack values: U^\star, U^{\star\alpha}
 7444:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7445:          Vector2 Ustar       = {0.0, 0.0}; 
 7446:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7447: 
 7448:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7449:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7450:          } else { //3D
 7451:             for (int k = side->kb + 1; k < nvrt; k++) {
 7452:             
 7453:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7454:                Ustar += w2;
 7455: 
 7456:                if constexpr(iveg != 0) {
 7457:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7458:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7459:                        Ustar_alpha += zrat*w2; // XXXX
 7460:                    }
 7461:                }  // if iveg
 7462:             }  // for k
 7463:          }  //2D/3D
 7464: 
 7465:          // If needed, project the side velocities to the element frame
 7466:          if constexpr(ics==2) {
 7467:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7468:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7469:          }
 7470:         
 7471: 
 7472:          // Add btrack & surface stress terms to \breve{G} first
 7473:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7474: 
 7475: 
 7476:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7477:          Vector2 tau    = side->tau();  
 7478:          Vector2 ubstar = side->btu[side->kb + 1];  
 7479: 
 7480:          // If needed, project tau and ubstar to the element frame
 7481:          if constexpr(ics==2) {
 7482:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7483:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7484:          }
 7485: 
 7486:          // Term for surface and bottom stress
 7487:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7488: 
 7489: 
 7490:          // All terms in F,F^\alpha,f_b except baroclinic
 7491:          // F, f_b: all explicit terms excluding vegetation 
 7492:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7493:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7494:          const double coriolis = side->coriolis;
 7495:          Vector2 F  =  coriolis*side->U;  // F_x
 7496:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7497:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7498: 
 7499:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7500:             
 7501:             for (int k = side->kb; k < nvrt; k++) {
 7502:                if (zctr2 > side->zc[k-1]) {
 7503:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7504:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7505:                    Fa +=  coriolis*w2*zrat;
 7506:                } // if zctr2
 7507:             } // k
 7508:          } // iveg
 7509: 
 7510:          // Integrate horizontal viscosity force vertically
 7511:          for (int k=side->kb + 1; k<nvrt; k++) {
 7512:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7513: 
 7514:             F += levelHorVisc;
 7515: 
 7516:             // Vegetation term
 7517:             if constexpr(iveg!=0) {
 7518:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7519:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7520:                   Fa += levelHorVisc*zrat;
 7521:                } 
 7522:             } // if iveg
 7523:          } // for k
 7524: 
 7525:          // Get nu*grad(U) at the side's bottom level
 7526:          Vector2 nuGradU = side->nuGradU[side->kb];
 7527: 
 7528:          fb += nuGradU;
 7529: 
 7530:          // If needed, project vectorsF, fb and Fa to the element frame
 7531:          if constexpr(ics==2) {
 7532:             F    = side->frame.projHorVec(F,    elem->frame);
 7533:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7534:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7535:          } // if ics
 7536: 
 7537:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7538:       } // for j (nodes and sides)
 7539: 
 7540:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7541: 
 7542: 
 7543:       // Finish off terms in F, F^\alpha and f_b
 7544:       const double grav3 = elem->mean(&Node::grav2);
 7545:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7546:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7547:       for (int j=0; j<i34; j++) { 
 7548:          // For each side in the element...
 7549:          const Side *side = elem->sides[j];
 7550:          const double chi = side->chi;
 7551: 
 7552:          const double htot = side->htot2();
 7553:          const double veg_h = side->veg_h();
 7554:          const Vector2 F  = htot*fb;
 7555:          const Vector2 Fa = min(htot, veg_h)*fb;
 7556: 
 7557:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7558:       } // for j
 7559: 
 7560:       // tmp is already in elem frame
 7561:       elem->ghat1 += tmp/i34;
 7562: 
 7563:       // Baroclinic force
 7564:       if constexpr(ibc==0) {
 7565:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7566: 
 7567:          Vector2 Fa = {0.0, 0.0};
 7568:          Vector2 intGradRho = {0.0, 0.0};
 7569:          
 7570:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7571:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7572:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7573: 
 7574:             // \in F [m^2/s/s]
 7575:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7576:          }
 7577: 
 7578:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7579:          const Vector2 F = av_df*Fa; //approx
 7580:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7581: 
 7582:       } // if ibc
 7583: 
 7584: 
 7585: 
 7586:    }
 7587: 
 7588: } // extern "C"
 7589: 
 7590: 
 7591: 
 7592: #ifdef DONTCOMPILE
 7593: __global__ void checkMassConservation(Tracers* sumtr) {
 7594: 
 7595:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7596: 
 7597:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7598: 
 7599:    Element *elem = &(mesh->localElemData[i]);
 7600: 
 7601:    // Skip dry elements
 7602:    if (elem->isDry) return;
 7603: 
 7604:    // Local sum array for this thread
 7605:    double localSum[N_TRACERS] = {0.0};
 7606: 
 7607:    // Sum over vertical levels for this element
 7608:    const int kbe = elem->kbe;
 7609:    const double area = elem->area;
 7610: 
 7611:    for (int k = kbe; k < nvrt; k++) {
 7612:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7613:       
 7614:       // Accumulate tracer mass
 7615:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7616:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7617:       }
 7618:    }
 7619: 
 7620:    //  This function returns per element sums. A reduction must be done on the host side.
 7621: }
 7622: 
 7623: 
 7624: __global__ void transport(void) {
 7625: 
 7626:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7627: 
 7628:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7629: 
 7630:    Element *elem = &(mesh->localElemData[ie]);
 7631: 
 7632:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7633: 
 7634:                for (int m=0; m<ntr; m++) {
 7635:                   for (int k=kbe(ie); k<nvrt; k++) {
 7636:                      // Calculate each polynomial's weight 
 7637:                      wm=0.d0; sum1=0.d0; 
 7638:                      wm1=0.d0; wm2=0.d0; 
 7639:                      for (int i=0; i<elem->nweno2; i++) {
 7640:                   
 7641:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7642:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7643:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7644:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7645:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7646:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7647:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7648:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7649:                      // -----------------Hu and Shu (1999)'s method----------------
 7650:                      b4=b1+b2+b3
 7651: 
 7652: //Error: add PRODUCTION CPP
 7653: #ifdef DEBUG
 7654:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7655:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7656:                     call parallel_abort(errmsg)
 7657:                   }
 7658: #endif
 7659: 
 7660:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7661:                   // !----test-------------- 
 7662:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7663:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7664:                   // !wm(i)=wm1(i)*wm2(i)
 7665:                   // !---------------------- 
 7666:                   sum1=sum1+wm(i)
 7667:                 } // end for i
 7668: 
 7669:                 wm=wm/sum1
 7670: 
 7671:                 for (int j=0; j<elem->i34; j++) {
 7672: 
 7673:                   const Side *side  = elem->sides[j];
 7674:                   const Node *node1 = side->n1;
 7675:                   const Node *node2 = side->n2;
 7676: 
 7677:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7678:                      trsd=0.d0
 7679:                      for (int kk=0; kk<nquad; kk++) {
 7680:                         for (int i=0; i<elem->nweno2; i++) {
 7681:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7682:                         } // end for i   
 7683:                      } // end for kk
 7684:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7685:                   } // outward flux
 7686:                } // end for j=1,i34(ie) ! side
 7687:             }
 7688:          }
 7689:               
 7690: 
 7691: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7692: //             //   calculate each polynomial's weight 
 7693: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7694: //                 wm=0.d0; sum1=0.d0
 7695: //                 do i=1,nweno1(ie) !for each polynomial
 7696: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7697: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7698: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7699: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7700: //                   wm(i)=b2
 7701: //                   sum1=sum1+b2
 7702: //                   !wm(i)=1.d0
 7703: //                   !sum1=sum1+1.d0
 7704: 
 7705: // // Error: PRODUCTION
 7706: // #ifdef DEBUG
 7707: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7708: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7709: //                     call parallel_abort(errmsg)
 7710: //                   endif
 7711: // #endif
 7712: 
 7713: //                 enddo !i
 7714: //                 wm=wm/sum1 !final weight
 7715: 
 7716:                 for (int j=0; j<elem->i34; j++) { // side
 7717:                   const Side *side = elem->sides[j];
 7718:                   const Node *node1 = side->n1;
 7719:                   const Node *node2 = side->n2;
 7720: 
 7721:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7722:                     trsd=0.d0
 7723:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7724:                       for (int i=0; i<elem->nweno1; i++) {
 7725:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7726:                       }
 7727:                     enddo //kk
 7728:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7729:                   } // outward flux
 7730:                 } // end for j=1,i34(ie) ! side
 7731:               } // end for k; ntr 
 7732: 
 7733:             else !simple upwind method
 7734:               do j=1,i34(ie)
 7735:                 jsj=elside(j,ie)
 7736:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7737:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7738:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7739:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7740:                   endif
 7741:                 enddo  !vertical layers
 7742:               enddo !j=1,i34(ie) ! side
 7743:             endif !order of accuracy
 7744: 
 7745:          //  enddo !ie
 7746: // !$OMP     end do
 7747: 
 7748: // !$OMP     master
 7749: //           !message passing
 7750: //           if (nproc>1) then
 7751: //             !make a copy of side concentrations
 7752: //             trsd_tmp0=trsd_tmp 
 7753: 
 7754: //             !this exchange routine swaps interface concentration between two partitions
 7755: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7756: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7757: 
 7758: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7759: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7760: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7761: 
 7762: 
 7763: //             !This obtains final values for interface sides
 7764: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7765: //       :    endif !nproc>1
 7766: //           !message passing end
 7767: // !$OMP     end master
 7768: // !$OMP     barrier
 7769: 
 7770: 
 7771: // !         Do advection; conc @ dry elem will not be changed
 7772: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7773: // !$OMP     do reduction(+: h_mass_in)
 7774: //           do i=1,ne
 7775: //             if(idry_e(i)==1) cycle
 7776: 
 7777: 
 7778: // !           Wet elements with 3 wet nodes
 7779: //             do k=kbe(i)+1,nvrt
 7780: 
 7781: 
 7782: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7783: //               dtb_by_bigv = dtb/bigv
 7784:     
 7785: // !             Advective flux
 7786: //               if (ntd_weno==1 .or. itd_weno==1) then
 7787: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7788: //               else
 7789: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7790: //               endif
 7791: 
 7792: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7793: //               do j=1,i34(i)
 7794: //                 jsj=elside(j,i) !side
 7795: //                 iweno=.true. !use weno reconstruction as default
 7796: //                 iel=ic3(j,i) !neighboring elem
 7797: 
 7798: //                 if(iel/=0) then
 7799: //                   if(idry_e(iel)==1) cycle
 7800: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7801: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7802: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7803: //                     iweno=.false.
 7804: //                   endif
 7805: //                 else !land or open bnd side
 7806: //                   !skip land bnd and outflowing open bnd, 
 7807: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7808: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7809: //                     !For outflow open bnd side, estimate mass in (open
 7810: //                     !side cannot be interface side)
 7811: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7812: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7813: //                     endif
 7814: 
 7815: //                     cycle
 7816: //                   endif
 7817: 
 7818: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7819: //                   iweno=.false.  !reset to upwind
 7820: //                   ibnd=isbs(jsj) !global bnd #
 7821: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7822: //                   nwild(1:2)=0
 7823: //                   do ll=1,2 !nodes
 7824: //                     ndo=isidenode(ll,jsj)
 7825: //                     do lll=1,2 !2 possible bnds
 7826: //                       if(isbnd(lll,ndo)==ibnd) then
 7827: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7828: //                         exit
 7829: //                       endif
 7830: //                     enddo !lll
 7831: //                   enddo !ll
 7832: //                   ind1=nwild(1); ind2=nwild(2);
 7833: 
 7834: //                   do jj=1,natrm
 7835: //                     if(ntrs(jj)<=0) cycle
 7836: 
 7837: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7838: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7839: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7840: //                       enddo !ll
 7841: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7842: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7843: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7844: //                       enddo !ll
 7845: //                     else if(itrtype(jj,ibnd)==3) then
 7846: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7847: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7848: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7849: //                       enddo !ll
 7850: //                     else if(itrtype(jj,ibnd)==4) then
 7851: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7852: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7853: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7854: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7855: //                       enddo !ll
 7856: //                     else
 7857: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7858: //   !'
