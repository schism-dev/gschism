 3363: 
 3364: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3365: 
 3366: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3367:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3368:    if constexpr(ics == 1) { 
 3369:       return 0.5*(n1->tau + n2->tau);
 3370: 
 3371:    } else {
 3372:       // Project the tau from the node frames to the side frame
 3373:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3374:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3375: 
 3376:       return 0.5*(stau1 + stau2);
 3377:    }
 3378: }
 3379: 
 3380: /**
 3381:  * This method performs backtracking from the side center until a time -dt back in time 
 3382:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3383:  * intermediate point.
 3384:  *
 3385:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3386:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3387:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3388:  * remaining time.
 3389:  * 
 3390:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3391:  * 
 3392:  * @param uuint, vvint, wwint: Velocities at the final point
 3393:  * @param jlev: Level at which the backtracking is performed
 3394:  * @param dt, dtbk: Tracking timesteps
 3395:   */
 3396: __inline__ __device__ void Side::btrack(
 3397:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3398:       double dt,            // Tracking time
 3399:       double dtbk,          // Tracking timestep
 3400:       Vector3 &u_int        // Velocities at the initial point
 3401: ) const {
 3402: 
 3403:    // Start from side center
 3404:    Point3 x0;
 3405: 
 3406:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3407:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3408: 
 3409:  
 3410:    double time_rm = dt; // Remaining time
 3411:    double time_rm_1 = 1e10;
 3412:    double time_rm_2 = 2e10;
 3413:    double time_rm_3 = 3e10;
 3414: 
 3415: 
 3416:    // Initial velocities
 3417:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3418: 
 3419:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3420:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3421: 
 3422:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3423: 
 3424: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3425: 
 3426: 
 3427:    constexpr int MAX_ITERATIONS = 100; 
 3428:    int iter = 0;
 3429:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3430:    while(true) {
 3431: 
 3432:       // Calculate timestep
 3433:       const double dtb = min(dtbk, time_rm);
 3434: 
 3435: // if (iter >= 38) printf("AAAAA iter = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, curElem->idx, x0.x, x0.y, x0.z, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3436: 
 3437:       // Next point in the backtracking curve
 3438:       xt = x0 - dtb*u_int;
 3439: // if (jlev == 48 && idx == 1603507)   showPoints(x0, xt, jlev, this, 0xFFFF00u, 'x', 1, 0, 0);
 3440: // // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3441: // // if ((jlev==45)) printf("jlev = %d, iter = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", jlev, iter, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 3442: // if ((jlev==45))
 3443: // {
 3444: // // const Point3 p1 = toLocalFrame(x0);
 3445: // // const Point3 p2 = toLocalFrame(xt);
 3446: // // printf("jlev = %d, iter = %d, p1 = (%.17f, %.17f, %.17f), p2 = (%.17f, %.17f, %.17f)\n", jlev, iter, p1.x, p1.y, p1.z, p2.x, p2.y, p2.z);
 3447: // showPoints(x0, xt, jlev, this, 0x0000FFu, 'o', 1, 0, 0); 
 3448:     
 3449: // }
 3450: 
 3451:       double t, s; // parameters for the line segments p0pt and p1p2
 3452:       Side *lastCrossSide = nullptr;
 3453:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3454: 
 3455: 
 3456: // if (iter >= 38) printf("BBBBB idx = %d, jlev = %d, lastCrossSide->idx = %d, x0 = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f), iter = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", idx, jlev, lastCrossSide->idx, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, iter, curElem->idx, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3457: 
 3458:       if (time_rm_3 <= time_rm) {
 3459:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3460:          xt = x0;
 3461:          break;
 3462:       }
 3463: 
 3464: 
 3465:       if (!found) {
 3466:       // This means that the walk reached a boundary or a dry element.
 3467: 
 3468:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3469: 
 3470:          // Finds the point at the boundary where the line segment x0xt intersects.
 3471:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3472:          // due to floating point errors, it does not exactly intersect.
 3473:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3474:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3475:          // To compute the intersection point we start with the parametric equations.
 3476:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3477:          // We cross-prouct by v1 to cancel the s term:
 3478:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3479:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3480: 
 3481:          // Side coordinates in the origSide frame.
 3482:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3483:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3484: 
 3485:          Point2  p0 = {x0.x, x0.y};
 3486:          Point2  pt = {xt.x, xt.y};
 3487: 
 3488:          const Vector2 v1 = pt - p0;
 3489:          const Vector2 v2 = p2 - p1;
 3490: 
 3491: 
 3492: 
 3493:          // We are assuming intersection, so we clamp t to the range [0,1].
 3494:          const double denom = cross(v2, v1);
 3495:          
 3496: 
 3497: 
 3498: 
 3499:          if (abs(denom) < small) {
 3500:             // small denominators are fairly common. They occur when the line segment x0xt 
 3501:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3502:             // boundary, where the backtracking curve startt sliding along the boundary.
 3503:             // In this case, we simply assume that the two lines are very close to each other
 3504:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3505:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3506:             if (t<0.0000000001) t = 0.0;
 3507:             if (t>0.9999999999) t = 1.0;
 3508: 
 3509:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3510:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3511: 
 3512:          }
 3513:          else {
 3514:             
 3515:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3516:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3517:             if (t>0.9999999999) t = 1.0;
 3518:             // From the originaL equation we can solve for s:
 3519:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3520:             // Computing the dot product by v1, we get:
 3521:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3522:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3523:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3524: 
 3525:          }
 3526: 
 3527:          
 3528:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3529:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3530: 
 3531: 
 3532: 
 3533:          // We update the new target point to be right at the intersection point,
 3534:          // and the remaining time must include the time we haven't "used".
 3535:          time_rm -= s*dtb;
 3536:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3537: 
 3538: // Point3 xct = {curElem->center.x, curElem->center.y, curElem->centerZ()};
 3539: // xct = toLocalFrame(xct);
 3540: // xt = (1-0.00001)*xt + 0.00001*xct;
 3541:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3542:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3543: 
 3544:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3545:          // but extracting only the component along the tangent vector v2.
 3546:          Vector2 tangent = normalize(v2);
 3547:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3548: 
 3549:          const Vector2 u2D = make_double2(u.x, u.y);
 3550:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3551: 
 3552: 
 3553:       } else {
 3554: 
 3555:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3556: 
 3557:          time_rm -= dtb; 
 3558: 
 3559:          u_int = curElem->interpolateVelocities(xt, this);
 3560: 
 3561:       }
 3562: 
 3563:       if (time_rm <= 0.0) break; 
 3564: 
 3565:       // If the velocity is too small, we stop the backtracking
 3566:       const double vmag2 = norm2(toVector2(u_int));
 3567:       if (vmag2 <= velmin_btrack_sq)  {
 3568: 
 3569:          time_rm = 0.0; 
 3570:          return; 
 3571:       }
 3572: 
 3573:       // The current point becomes the next segment's starting point.
 3574:       x0 = xt;
 3575:  
 3576:       iter++;
 3577: 
 3578: 
 3579:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3580: 
 3581:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3582:       time_rm_3 = time_rm_2;
 3583:       time_rm_2 = time_rm_1;
 3584:       time_rm_1 = time_rm;
 3585:    }
 3586: 
 3587:    assert(curElem != nullptr && "Final element is nullptr");
 3588:    assert(!curElem->isDry && "Final element is dry");
 3589:    
 3590: 
 3591: 
 3592:    // Interpolate the velocities at the final point with respect to the current side frame
 3593:    u_int = curElem->interpolateVelocities(xt, this);
 3594: 
 3595: 
 3596: }
 3597: 
 3598: 
