 2397: 
 2398: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2399: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2400: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2401: // Only when ics == 2, the origin is at the element center.
 2402: 
 2403:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2404: 
 2405:    const Node *node = nodes[idxNode];
 2406: 
 2407:    if constexpr(ics==1) {
 2408:       return node->p;
 2409: 
 2410:    } else {
 2411:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2412: 
 2413:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2414: 
 2415:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2416:    }
 2417: 
 2418: }
 2419: 
 2420: 
 2421: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2422:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2423: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2424: 
 2425:    const int id1 = idx;
 2426:    const int id2 = nxq(1 + id1);
 2427:    const int id3 = nxq(2 + id1);
 2428: 
 2429:    if constexpr(ics==1) {
 2430:       x0 = nodes[id1]->p;
 2431:       x1 = nodes[id2]->p;
 2432:       x2 = nodes[id3]->p;
 2433: 
 2434:    } else {
 2435: 
 2436:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2437:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2438:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2439: 
 2440:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2441:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2442:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2443: 
 2444:    }
 2445: 
 2446: }
 2447: 
 2448: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2449:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2450: }
 2451: 
 2452: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2453:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2454:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2455: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2456: 
 2457:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2458: 
 2459: 
 2460: 
 2461:    if constexpr(ics==1) {
 2462:       x0 = nodes[0]->p;
 2463:       x1 = nodes[1]->p;
 2464:       x2 = nodes[2]->p;  
 2465:       x3 = nodes[3]->p;
 2466: 
 2467:    } else {
 2468: 
 2469:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2470:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2471:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2472:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2473: 
 2474:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2475:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2476:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2477:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2478:    }
 2479: 
 2480: }
 2481: 
 2482: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2483:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2484: {
 2485:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2486: }
 2487: 
 2488: 
 2489: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2490: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2491: // Returns the normal vector and the area of the element at this level
 2492:    
 2493:    double nx, ny, nz;
 2494: 
 2495:    if (isTri()) {
 2496:       // For triangles...
 2497: 
 2498:       // Indices of the nodes at level k, taking care of not going below the bed
 2499:       const int k0 = max(k, nodes[0]->kb);
 2500:       const int k1 = max(k, nodes[1]->kb);
 2501:       const int k2 = max(k, nodes[2]->kb);
 2502: 
 2503:       // Gets the element frame coordinates of the nodes at level k
 2504:       Point3 x0, x1, x2;
 2505:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2506:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2507:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2508:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2509: 
 2510:       } else {  // ics == 2
 2511:          Point2 h0, h1, h2;
 2512: 
 2513:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2514: 
 2515:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2516:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2517:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2518:       }
 2519: 
 2520:       const Vector3 n20 = x2 - x0;
 2521:       const Vector3 n10 = x1 - x0; 
 2522: 
 2523:       // Computes the cross product of vectors n20 and n10. 
 2524:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2525:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2526:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2527: 
 2528:   
 2529:    }
 2530:    else {
 2531:       // For quads...
 2532:       Point2 h0, h1, h2, h3;
 2533: 
 2534:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2535: 
 2536:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2537:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2538:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2539:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2540: 
 2541:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2542:       nx = n20.y*n31.z - n20.z*n31.y;
 2543:       ny = n20.z*n31.x - n20.x*n31.z;
 2544:       nz = n20.x*n31.y - n20.y*n31.x;
 2545: 
 2546:    }
 2547: 
 2548:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2549:    area3D = 0.5*len;
 2550: 
 2551:    const double inv_len = 1.0/len;
 2552: 
 2553:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2554: 
 2555: }
 2556: 
 2557: 
 2558: // Helper functions to get the 2D local node position for the Celestial walk
 2559: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2560:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2561:    const Node *node = getNodeInOrder(idx2);
 2562: 
 2563:    double z = 0.0;
 2564:    if constexpr(ics == 2) z = node->gz;
 2565:    
 2566:    Point3 p = toPoint3(node->p, z);
 2567: 
 2568:    return toPoint2(origSide->toLocalFrame(p));
 2569: }
 2570: 
 2571: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2572:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2573: }
 2574: 
 2575: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2576:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2577: // Computes the three per-side predicates needed for the celestial walk
 2578: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2579: //
 2580: // xt is in local frame coordinates for origSide if ics == 2.
 2581: //
 2582: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2583: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2584: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2585: // meaningless on triangles are masked to a safe value (see comments below).
 2586: {
 2587:    // Project all 4 corner positions once into the local 2D frame.
 2588:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2589:    // getLocalNodePosition only transforms/projects if ics == 2.
 2590:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2591:                         getLocalNodePosition(1, origSide), 
 2592:                         getLocalNodePosition(2, origSide), 
 2593:                         getLocalNodePosition(3, origSide)};
 2594: 
 2595:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2596:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2597:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2598:    // But still farther towards the target point from the current point.
 2599:    const Vector2 vt0 = xt - x0;
 2600:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2601:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2602:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2603: 
 2604:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2605:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2606: 
 2607: 
 2608: // if (origSide->idx == 2860848 && jlev == 46) {
 2609: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2610: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2611: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2612: // }
 2613:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2614:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2615:    //  here the orientation is baked into the corners array.)
 2616:    const int i3 = nxq(3);
 2617:    const Vector2 s0 = C[ 1] - C[ 0];
 2618:    const Vector2 s1 = C[ 2] - C[ 1];
 2619:    const Vector2 s2 = C[i3] - C[ 2];
 2620:    const Vector2 s3 = C[ 0] - C[i3];
 2621:    
 2622:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2623:    // The corners array is built from getNode in CCW order, so the orientation
 2624:    // is already correct and no ssign factor is needed in the formulas below.
 2625:    //
 2626:    // i3 = nxq(3): the index of the corner after side 2.
 2627:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2628:    //   Quad:     i3 == 3.
 2629:    //
 2630:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2631:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2632:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2633:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2634:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2635:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2636: 
 2637: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2638: 
 2639:    // For triangles, the corner after side 2 is the closing corner where
 2640:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2641:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2642:    // s0 for triangles, s3 for quads.
 2643:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2644: 
 2645:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2646:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2647:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2648:    //
 2649:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2650:    // result is false naturally. No sentinel needed.
 2651:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2652:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2653:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2654:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2655: 
 2656:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2657:    // on the "exit through side I" half of the corner cone, separated by the
 2658:    // approximate angular bisector of the celestial walk. The bisector is
 2659:    // perpendicular to the chord across the corner; the test is the sign of
 2660:    // (xt - corner_vertex) projected onto that chord.
 2661:    //
 2662:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2663:    // (the validity rule sets valid_3 = false), so its computed value for
 2664:    // triangles doesn't matter. No sentinel needed.
 2665:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2666:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2667:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2668:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2669: 
 2670: }
 2671: 
 2672: 
 2673: __inline__ __device__ double Element::computeSignedArea(void) const {
 2674:    // Compute the area of the element
 2675: 
 2676:    Point2 x0, x1, x2, x3;
 2677:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2678: 
 2679: 
 2680:    double res = signedArea(x0, x1, x2);
 2681: 
 2682:    // In the quad case we need to add the area of the other triangle.
 2683:    if (isQuad()) {
 2684:       x3 = getLocalHorizontalNodePosition(3);
 2685:       double ar1 = signedArea(x0, x2, x3);
 2686:       double ar2 = signedArea(x0, x1, x3);
 2687:       double ar3 = signedArea(x1, x2, x3);
 2688:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2689: 
 2690:       res += ar1;
 2691: 
 2692:    }
 2693: 
 2694:    return res;
 2695: }
 2696: 
 2697: 
 2698: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2699:                                                                 (nodes[1]->isDry2()) ||
 2700:                                                                 (nodes[2]->isDry2()) ||
 2701:                                                                 (isQuad() && nodes[3]->isDry2());
 2702: }
 2703: 
 2704: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2705:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2706: }
 2707: 
 2708: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2709:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2710: }
 2711: 
 2712: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2713:    // In boundary sides, the element 1 is nullptr
 2714:    return side->elems[1] == nullptr; 
 2715: }
 2716: 
 2717: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2718:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2719:    // For ics == 2, this function uses local frame coordinates.
 2720: 
 2721:    assert(isQuad());
 2722: 
 2723:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2724:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2725:    // where vxi, veta, vb are vectors and c is the center of the element.
 2726: 
 2727:    Point2 p0, p1, p2, p3;
 2728: 
 2729:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2730: 
 2731:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2732:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2733:    // vectors vxi and veta connect the centers of opposite sides
 2734:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2735:    // vb is zero for parallelogram elements.
 2736:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2737: 
 2738:    //  The bilinear mapping is:
 2739:    //      P(s,t) = C + s*U + t*V + s*t*W
 2740:    //
 2741:    //  where:
 2742:    //    C = centroid (average of four vertices)
 2743:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2744:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2745:    //    W = bilinear correction; measures deviation from parallelogram
 2746:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2747:    //        W = 0 for parallelogram elements.
 2748:    //
 2749:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2750:    //
 2751:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2752:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2753:    //
 2754:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2755:    //
 2756:    //  Geometrically, (L) projects everything onto the direction
 2757:    //  perpendicular to W, where the mapping is purely affine.
 2758:    //
 2759:    //  The dot product with nb retains the nonlinear term:
 2760:    //
 2761:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2762:    //
 2763:    //  Geometrically, (Q) projects onto the W direction, where
 2764:    //  the nonlinearity lives.
 2765:    //
 2766:    //  We solve (L) for whichever variable has the larger coefficient
 2767:    //  (better conditioned back-substitution), substitute into (Q),
 2768:    //  and get a scalar quadratic in the other variable.
 2769:    // ================================================================
 2770: 
 2771:    // ---- Basis vectors ----
 2772:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2773:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2774:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2775:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2776:    // W: nonlinear correction. Difference between quad and parallelogram.
 2777:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2778:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2779: 
 2780:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2781:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2782:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2783:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2784:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2785: 
 2786:    // ---- nb: direction parallel to W, L1-normalized ----
 2787:    // We don't need a unit vector -- just a well-scaled direction parallel
 2788:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2789:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2790:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2791:    //
 2792:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2793:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2794:    // and the quadratic solver takes its linear path (a ~ 0).
 2795:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2796:    const double inv_wlen = 1.0 / wlen1;
 2797:    const Vector2 nb = vb * inv_wlen;
 2798: 
 2799:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2800:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2801:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2802:    // What remains is a pure affine relationship between xi and eta.
 2803:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2804:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2805:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2806: 
 2807:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2808:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2809:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2810:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2811:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2812:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2813:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2814: 
 2815:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2816:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2817:    // minimizing round-off amplification.
 2818:    //
 2819:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2820:    // that uses predicated moves.
 2821:    //
 2822:    // if (fabs(Ls) > fabs(Lt)) {
 2823:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2824:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2825:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2826:    //    const double A = -Qw * Lt;
 2827:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2828:    //    const double C =  Qs * Lp - Qp * Ls;
 2829: 
 2830:    //    double eta1, eta2;
 2831:    //    solveQuadratic(A, B, C, eta1, eta2);
 2832: 
 2833:    //    // Pick root with smaller |eta| (domain centered at 0).
 2834:    //    // Ternary-> predicated move, no branch divergence.
 2835:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2836: 
 2837:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2838:    //    xi = (Lp - Lt * eta) / Ls;
 2839: 
 2840:    // } else {
 2841:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2842:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2843:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2844:    //    const double A = -Qw * Ls;
 2845:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2846:    //    const double C =  Qt * Lp - Qp * Lt;
 2847: 
 2848:    //    double xi1, xi2;
 2849:    //    solveQuadratic(A, B, C, xi1, xi2);
 2850: 
 2851:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2852: 
 2853:    //    eta = (Lp - Ls * xi) / Lt;
 2854:    // }
 2855:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2856:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2857:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2858:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2859:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2860: 
 2861:    // Quadratic:  A*r^2 + B*r + C = 0
 2862:    // (same formula for both cases, just with swapped coefficients)
 2863:    const double A = -Qw * Lb;
 2864:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2865:    const double C =  Qa * Lp - Qp * La;
 2866: 
 2867:    double r1, r2;
 2868:    solveQuadratic(A, B, C, r1, r2);
 2869: 
 2870:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2871:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2872: 
 2873:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2874:    const double other = (Lp - Lb * r) / La;
 2875: 
 2876:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2877:    xi  = solve_s ? r     : other;
 2878:    eta = solve_s ? other : r;
 2879: 
 2880: 
 2881:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2882:    xi  = clamp(xi,  -1.0, 1.0);
 2883:    eta = clamp(eta, -1.0, 1.0);
 2884: 
 2885:    // ---- Shape functions ----
 2886:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2887:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2888:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2889:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2890:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2891:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2892:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2893:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2894: 
 2895:    return true;
 2896: }
 2897: 
 2898: /**
 2899:    Compute the shape coordinates of the point (xt,yt) in the element.
 2900:    @param xt (input): x-coordinate of the point
 2901:    @param shpCoords (output): shape coordinates of the point
 2902:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2903:    @return true if the point is inside the element, false otherwise
 2904: **/
 2905: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2906: 
 2907:    // Compute the shape coordinates of the point xt in the element.
 2908:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2909:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2910:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2911:    // from the local frame, so use additional check.
 2912: 
 2913: 
 2914:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2915: 
 2916:    if (isTri()) { // Triangular element
 2917: 
 2918:       // Horizontal local node coordinates. 
 2919:       Point2 x0, x1, x2;
 2920:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2921: 
 2922:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2923:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2924:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2925:       shpCoords[3] = 0.0;
 2926: 
 2927:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2928:       const bool res = (tmpmin >= -small);  
 2929:       
 2930:       // When to fix the negative shape coordinates?
 2931:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2932: 
 2933:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2934:       // then we fix the negative shape coordinates.
 2935:       if ((tmpmin < 0) && fix) {
 2936: 
 2937:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2938:          // keeping the sum of the shape coordinates equal to 1.
 2939:          // I have tested and compared the new algorithm with the old one, and they give
 2940:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2941:          // The new algorithm should be faster since it is branchless.
 2942:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2943:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2944: 
 2945:          shpCoords[0] = (shpCoords[0] + a)*b;
 2946:          shpCoords[1] = (shpCoords[1] + a)*b;
 2947:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2948: 
 2949:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2950:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2951:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2952: 
 2953:          // Update the point coordinates for the new shape coordinates
 2954:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2955:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2956: 
 2957:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2958: 
 2959:       }
 2960: 
 2961:       // Return true if the point is inside the element
 2962:       return res;      
 2963:    }
 2964:    else {
 2965:       assert(isQuad() && "computeShapeCoords");
 2966: 
 2967:       // Horizontal local node coordinates with respect to the original side.
 2968:       Point2 x0, x1, x2, x3;
 2969:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2970: 
 2971:       const double a0 = signedArea(x0, x1, xt);
 2972:       const double a1 = signedArea(x1, x2, xt);
 2973:       const double a2 = signedArea(x2, x3, xt);
 2974:       const double a3 = signedArea(x3, x0, xt);
 2975: 
 2976:       const double minArea = min4(a0, a1, a2, a3);
 2977:       
 2978:       const bool res = (minArea > -small*area);
 2979: 
 2980:       // When to fix the negative shape coordinates?
 2981:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2982: 
 2983:       double xi, eta;    
 2984: 
 2985:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2986:       // Does nothing if ics == 1.
 2987:       assert(origSide != nullptr);
 2988:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 2989: 
 2990:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2991: 
 2992:       if (fix) {
 2993:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2994:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2995:          xt.x = interpolate(shpCoords, xn);
 2996:          xt.y = interpolate(shpCoords, yn);
 2997:       }
 2998: 
 2999:       return res;
 3000:    }
 3001: 
 3002: 
 3003:    assert(false && "computeShapeCoords: should never reach this point");
 3004:    return false;  // Never reached
 3005: 
 3006: }
 3007: 
 3008: 
 3009: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3010: // Convert shape coordinates to cartesian coordinates
 3011: 
 3012:    if (isTri()) {
 3013:       // Triangular element
 3014: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3015:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3016:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3017:    }
 3018:    else {
 3019:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3020:    }
 3021: 
 3022: }
 3023: 
 3024: 
 3025: 
 3026: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3027:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3028:    
 3029:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3030: }
 3031: 
 3032: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3033:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3034:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3035:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3036:    return area * dot(gradPhi[i], gradPhi[j]);
 3037: }
 3038: 
 3039: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3040:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3041:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3042:    // The formula for the integral is:
 3043:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3044:    
 3045:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3046:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3047:    const double eta_sum  = eta_n(i) + eta_n(j);
 3048:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3049: 
 3050:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3051:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3052: 
 3053: 
 3054:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3055: }
 3056:    
 3057: 
 3058: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3059:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3060:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3061:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3062:    // The formula is also based on the identity:
 3063:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3064:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3065: 
 3066:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3067: 
 3068: 
 3069: 
 3070:    double res = 0.0;
 3071:    
 3072:    // Quadrature points in xi and eta coordinates
 3073:    #pragma unroll
 3074:    for (int i = 0; i < 4; i++) {
 3075:       // For each quadrature point...
 3076: 
 3077:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3078:       const double eta = p.x;
 3079:       const double xi  = p.y;
 3080: 
 3081:       // Jacobian entries at the Gauss point p
 3082:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3083:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3084:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3085:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3086: 
 3087:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3088:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3089: 
 3090:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3091:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3092:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3093:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3094:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3095: 
 3096:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3097:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3098:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3099:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3100:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3101: 
 3102:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3103:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3104:    }
 3105: 
 3106:    return res;
 3107: }
 3108: 
 3109: 
 3110: /**  Interpolate velocities at a given point (xt,yt,zt)
 3111: 
 3112:    @param xt, yt, zt: coordinates of the point to interpolate
 3113:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3114: 
 3115:    This is done in four steps:
 3116: 
 3117:    1. Find the shape coordinates for the final position in the element.
 3118:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3119:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3120:       z levels at xt, yt at each step.   
 3121:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3122:       horizontally and vertically.
 3123: **/
 3124: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3125:    // Interpolate the velocities at the point xt. 
 3126:    // This function works the same for triangular and quadrilateral elements.
 3127:    double shpCoord[4];
 3128:    Vector3 u_int;
 3129: 
 3130: 
 3131:    // First step is to compute the shape coordinates of (xt,yt)
 3132: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3133:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3134: 
 3135:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3136: 
 3137:    // Second step is to find the level that contains zt
 3138:    // Uses a binary search to find the level
 3139:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3140:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3141:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3142:    int R = nvrt - 1;
 3143: 
 3144:    // Get the z coordinates at the nodes of the element at the levels L and R
 3145:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3146:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3147:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3148: 
 3149: 
 3150:    double zL = interpolate(shpCoord, zLAtNodes);
 3151:    double zR = interpolate(shpCoord, zRAtNodes);
 3152: 
 3153:    // Interpolates vertically the velocities
 3154:    double wght1, wght2;
 3155:    if (xt.z <= zL) {
 3156:       wght1 = 1.0;
 3157:       wght2 = 0.0;
 3158:       xt.z = zL;
 3159:    }
 3160:    else if (xt.z >= zR) {
 3161:       wght1 = 0.0;
 3162:       wght2 = 1.0;
 3163:       xt.z = zR;
 3164:    }
 3165:    else {
 3166:       // Perform a binary search to find the levels between L and R that contain xt.z
 3167:       while (R - L > 1) {
 3168:          int M = (L + R) / 2.0;
 3169: 
 3170:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3171:          double zM = interpolate(shpCoord, zMAtNodes);
 3172:          if (zM < xt.z) 
 3173:          {
 3174:             L = M;
 3175:             zL = zM;
 3176:          }
 3177:          else 
 3178:          {
 3179:             R = M;
 3180:             zR = zM;
 3181:          }
 3182:       }
 3183:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3184:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3185: 
 3186:       wght2 = (xt.z - zL)/(zR - zL);
 3187:       wght1 = 1.0 - wght2;
 3188: 
 3189:    }
 3190: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3191: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3192:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3193:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3194:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3195:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3196: 
 3197:    // Project the velocity from the local frame to the origSide frame
 3198:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3199:    u_int = {uv.x, uv.y, w};
 3200: 
 3201:    // Neither of the interpolated velocities should be NaN
 3202:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3203: 
 3204:    return u_int;
 3205: 
 3206: }
 3207: 
 3208: 
 3209: 
 3210: 
 3211: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3212: 
 3213:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3214:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3215:    const Node *n1 = side->n1;
 3216:    const Node *n2 = side->n2;
 3217: 
 3218:    bool n1_match = (n1->nodeBnd->segment == segment);
 3219:    bool n2_match = (n2->nodeBnd->segment == segment);
 3220: 
 3221:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3222:    if (n1_match && n2_match) {
 3223:       return 0.5;
 3224:    } else if (n1_match) {
 3225:       return 1.0;
 3226:    } else if (n2_match) {
 3227:       return 0.0;
 3228:    }
 3229: 
 3230:    return 0.0;
 3231: }
 3232: 
 3233: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3234: 
 3235: 
 3236: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3237: 
 3238:    const double w1 = getBoundaryArrayValueWeight();
 3239:    const double w2 = 1.0 - w1;
 3240:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3241:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3242: 
 3243:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3244: }
 3245: 
 3246: 
 3247: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3248:    const double w1 = getBoundaryArrayValueWeight();
 3249:    const double w2 = 1.0 - w1;
 3250:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3251:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3252: 
 3253:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3254: 
 3255: }
 3256: 
 3257: 
 3258: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3259:    // Returns the value of the velocity at the side center
 3260:    const double w1 = getBoundaryArrayValueWeight();
 3261:    const double w2 = 1.0 - w1;
 3262:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3263:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3264: 
 3265:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3266: }
 3267: 
 3268: 
 3269: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3270:    // Returns the value of the normal component of the velocity at the side center
 3271:    const double w1 = getBoundaryArrayValueWeight();
 3272:    const double w2 = 1.0 - w1;
 3273:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3274:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3275: 
 3276:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3277: }
 3278: 
 3279: 
 3280: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3281:    if constexpr(ics == 1) {
 3282:       return center;
 3283: 
 3284:    } else {
 3285:       const Point2 p0 = n1->outputCoords();
 3286:       const Point2 p1 = n2->outputCoords();
 3287:       return (1.0/2.0)*(p0 + p1);
 3288: 
 3289:    }
 3290: }
 3291: 
 3292: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3293: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3294: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3295: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3296: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3297: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3298: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3299: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3300: // Computes the gradient of the field at the side center.
 3301:    Vector2 grad = {0.0, 0.0};
 3302:    int count = 0;
 3303: 
 3304:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3305:    // as the average of the gradients at each element.
 3306:    // First element
 3307:    if (elems[0] != nullptr && condition(elems[0])) {
 3308:       Vector2 elemGrad = elems[0]->grad2(field);
 3309: 
 3310:       // For ics=2, projects the element gradient from its frame to the side frame
 3311:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3312: 
 3313:       grad += elemGrad;
 3314: 
 3315:       count++;
 3316:    }
 3317: 
 3318:    // Second element
 3319:    if (elems[1] != nullptr && condition(elems[1])) {
 3320: 
 3321:       Vector2 elemGrad = elems[1]->grad2(field);
 3322: 
 3323:       // For ics=2, projects the element gradient from its frame to the side frame
 3324:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3325: 
 3326:       grad += elemGrad;
 3327: 
 3328:       count++;
 3329:    }
 3330: 
 3331:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3332:    if (count > 0) {
 3333:       grad = grad*(1.0/count);
 3334:    }
 3335:    
 3336:    return grad;
 3337: }
 3338: 
 3339: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3340: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3341: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3342: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3343: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3344: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3345: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
