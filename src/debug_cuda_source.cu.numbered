 9323: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9324:    Element *elems = mesh->localElemData;
 9325: 
 9326:    *addr = elems;
 9327:    *sizeElement = sizeof(Element);
 9328:    switch (varCode) {
 9329:       case (int)VarCode::z:
 9330:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9331:          *sizeType = sizeof(double);
 9332:          break;
 9333:       case (int)VarCode::x:
 9334:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9335:          *sizeType = sizeof(Vector2);
 9336:          break;
 9337:       case (int)VarCode::gradETP:
 9338:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9339:          *sizeType = sizeof(Vector2);
 9340:          break;
 9341:       case (int)VarCode::area:
 9342:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9343:          *sizeType = sizeof(double);
 9344:          break;
 9345:       case (int)VarCode::depth:
 9346:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9347:          *sizeType = sizeof(double);
 9348:          break;
 9349:       case (int)VarCode::radius:
 9350:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9351:          *sizeType = sizeof(double);
 9352:          break;
 9353:       case (int)VarCode::ghat:
 9354:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9355:          *sizeType = sizeof(Vector2);
 9356:          break;
 9357:       case (int)VarCode::kb:
 9358:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9359:          *sizeType = sizeof(int);
 9360:          break;
 9361:       case (int)VarCode::isdry:
 9362:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9363:          *sizeType = sizeof(int);
 9364:          break;            
 9365:       case (int)VarCode::w:
 9366:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9367:          *sizeType = sizeof(double);
 9368:          break;
 9369:       case (int)VarCode::FaceIndices:
 9370:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9371:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9372:          *sizeType = sizeof(Node);
 9373:          break;
 9374:       default:
 9375:          *offset = -1;
 9376:    }
 9377: }
