 7993:                                  
 7994:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7995:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7996:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7997:                    int *isdel, int *isidenode, int *isbnd,
 7998:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7999:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8000:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8001:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8002:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8003:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8004:                    double *drag, double *roughness,
 8005:                    double *emo, double *efa, 
 8006:                    double *umo, double *ufa, 
 8007:                    double *vmo, double *vfa) {
 8008: 
 8009:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8010:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8011:                        isdel, isidenode, isbnd,
 8012:                        nond, nlnd, iond, ilnd, 
 8013:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8014:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8015:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8016:                        localNodeIndices, localElemIndices, localSideIndices,
 8017:                        localNodePart, localElemPart, localSidePart,
 8018:                        drag, roughness,
 8019:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8020:   }
