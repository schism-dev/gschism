 1494:    //    return sides[idx] + idx;
 1495:    // }
 1496: 
 1497:    // // Get's the global index of local node idx
 1498:    // __device__ int getGlobalNodeIndex(int idx) {
 1499:    //    return idx + partNum * max_np;
 1500:    // }
 1501: 
 1502:    // // Get's the global index of local element idx
 1503:    // __device__ int getGlobalElemIndex(int idx) {
 1504:    //    return idx + partNum * max_ne;
 1505:    // }
 1506: 
 1507:    // // Get's the global index of local side idx
 1508:    // __device__ int getGlobalSideIndex(int idx) {
 1509:    //    return idx + partNum * max_ns;
 1510:    // }  
 1511: 
 1512:    __device__ Mesh(int partNum,
 1513:                    int npgb, int negb, int nsgb, 
 1514:                    int np, int ne, int ns,
 1515:                    int max_np, int max_ne, int max_ns, int nseg,
 1516:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1517:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1518:                    Node    **localNodeNeighNodesMem,
 1519:                    Element **localNodeNeighElemsMem,
 1520:                    double *partCoeffMatrixMem,
 1521:                    NodeBoundary *localNodeBoundaryMem,
 1522:                    SideBoundary *localSideBoundaryMem,
 1523:                    BoundarySegment *localSegmentMem,
 1524:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1525:                    double *cs, double *dcs
 1526:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1527:                        np(np), ne(ne), ns(ns),
 1528:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1529:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1530:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1531:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1532:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1533:                        localSegmentMem(localSegmentMem),
 1534:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma_lcl(sigma_lcl), sigma(sigma), ztot(ztot),
 1535:                        cs(cs), dcs(dcs),
 1536:                        coeffMatrixMem(partCoeffMatrixMem),
 1537:                        landBoundarySegment(true),
 1538:                        landBoundaryNode(true)
 1539:    {
 1540:       printf("Mesh constructor for partition %d\n", partNum);
 1541: 
 1542:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1543:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1544:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1545:  
 1546:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1547:       
 1548:       sinh_theta_f = sinh(theta_f);
 1549: 
