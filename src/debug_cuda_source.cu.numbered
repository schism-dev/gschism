 3369: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3370:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3371:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3372:                 int *isdel, int *isidenode, int *isbnd,
 3373:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3374:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3375:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3376:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3377:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3378:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3379:                 double *drag, double *roughness,
 3380:                 double *emo, double *efa, 
 3381:                 double *umo, double *ufa, 
 3382:                 double *vmo, double *vfa) {
 3383: 
 3384:    // printf("Populating mesh for partition %d\n", partNum);
 3385: 
 3386:    // XXXXXX THIS function does almost nothing. 
 3387: 
 3388:    nbs = *sharedIdxSideBoundary;
 3389:    nbp = *sharedIdxNodeBoundary;
 3390: 
 3391: 
 3392: }
