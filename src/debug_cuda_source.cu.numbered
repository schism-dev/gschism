 1726: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1727:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1728: }
 1729: 
 1730: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1731:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1732: }   
 1733: 
 1734: __device__ __inline__ double min3(double a, double b, double c) {
 1735:    return min(a, min(b, c));
 1736: }
 1737: 
 1738: __device__ __inline__ double max3(double a, double b, double c) {
 1739:    return max(a, max(b, c));
 1740: }
 1741: 
 1742: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1743:    return min(a, min(b, min(c, d)));
 1744: }
