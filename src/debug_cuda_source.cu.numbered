 3492: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 3493: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 3494: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 3495: 
 3496: //       if (delta != 0.0) {
 3497: //          // Solves the two linear equations for tt1 and tt2
 3498: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3499: //          const double tt2 = delta2/delta;
 3500: 
 3501: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3502: //          // Similarly, we use tt2 to compute the intersection point.
 3503: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3504: //             xIntersect = x3 + (x4 - x3)*tt2;
