 7749: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7750:    Element *elems = mesh->localElemData;
 7751: 
 7752:    *addr = elems;
 7753:    *sizeElement = sizeof(Element);
 7754:    switch (varCode) {
 7755:       case (int)VarCode::z:
 7756:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7757:          *sizeType = sizeof(double);
 7758:          break;
 7759:       case (int)VarCode::x:
 7760:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7761:          *sizeType = sizeof(Vector2);
 7762:          break;
 7763:       case (int)VarCode::area:
 7764:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7765:          *sizeType = sizeof(double);
 7766:          break;
 7767:       case (int)VarCode::depth:
 7768:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7769:          *sizeType = sizeof(double);
 7770:          break;
 7771:       case (int)VarCode::radius:
 7772:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7773:          *sizeType = sizeof(double);
 7774:          break;
 7775:       case (int)VarCode::lonlat:
 7776:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7777:          *sizeType = sizeof(double);
 7778:          break;
 7779:       case (int)VarCode::ghat:
 7780:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7781:          *sizeType = sizeof(Vector2);
 7782:          break;
 7783:       case (int)VarCode::kb:
 7784:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7785:          *sizeType = sizeof(int);
 7786:          break;
 7787:       case (int)VarCode::isdry:
 7788:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7789:          *sizeType = sizeof(int);
 7790:          break;            
 7791:       case (int)VarCode::w:
 7792:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7793:          *sizeType = sizeof(double);
 7794:          break;
 7795:       case (int)VarCode::FaceIndices:
 7796:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7797:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7798:          *sizeType = sizeof(Node);
 7799:          break;
 7800:       default:
 7801:          *offset = -1;
 7802:    }
 7803: }
