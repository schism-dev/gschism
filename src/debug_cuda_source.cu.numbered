 2219: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2220: {
 2221:     uintptr_t p = (uintptr_t)address;
 2222:     assert((p & 1) == 0);
 2223: 
 2224:     unsigned int* base = (unsigned int*)(p & ~3);
 2225:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2226:                                   :  (unsigned int)val;
 2227: 
 2228:     atomicAdd(base, addend);
 2229: }
