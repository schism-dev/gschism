 1395: struct BoundarySegment {
 1396: 
 1397:    bool isLand;
 1398: 
 1399:    int idx; // Index of the boundary segment in the input files.
 1400: 
 1401:    double clen;  // Length of the boundary segment
 1402:    double carea; // Area of the boundary segment
 1403: 
 1404:    int ifltype;  // Type of flow boundary condition
 1405:    
 1406:    // Elevation boundary condition
 1407:    int iettype;  // Type of elevation boundary condition
 1408:    double eth;   // Elevation time history
 1409: 
 1410:    // Flow boundary condition
 1411:    double qthcon;  // Flow time history constant
 1412:    double vobc1;   // Velocity coefficient 1
 1413:    double vobc2;   // Velocity coefficient 2
 1414: 
 1415:    // Tracer boundary conditions
 1416:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1417:    // int  itrtype[natrm];    // Tracer boundary condition type
 1418: 
 1419:    BoundarySegment(bool _isLand) {
 1420:       isLand = _isLand;
 1421:       clen = 0.0;
 1422:       carea = 0.0;
 1423:       ifltype = 0;
 1424:       iettype = 0;
 1425:       eth = 0.0;
 1426:    }
 1427: 
 1428:    BoundarySegment(void) {
 1429:       isLand = false;
 1430:       clen = 0.0; 
 1431:       carea = 0.0;
 1432:       ifltype = 0;
 1433:       iettype = 0;
 1434:       eth = 0.0;
 1435:    }
 1436: 
 1437:    
 1438: };
