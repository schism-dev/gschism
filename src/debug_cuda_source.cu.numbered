 1479: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 1480:    // For imm=2, user needs to update bottom depth and velocity
 1481: 
 1482:    dep = min(1.0, 7.0 - (x0 + time));
 1483:    vel = { -1.0, 0.0, 0.0 };
