 1808: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1809:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1810: }
 1811: 
 1812: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1813:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1814: }   
 1815: 
 1816: __device__ __inline__ double min3(double a, double b, double c) {
 1817:    return min(a, min(b, c));
 1818: }
 1819: 
 1820: __device__ __inline__ double max3(double a, double b, double c) {
 1821:    return max(a, max(b, c));
 1822: }
 1823: 
 1824: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1825:    return min(a, min(b, min(c, d)));
 1826: }
