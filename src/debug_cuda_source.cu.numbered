 2608: 
 2609: __device__ void Element::trackGoesOutOfWater(const Side *nextSide, const Side *origSide, Element *curElem, double tt, int jlev,
 2610:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2611: 
 2612:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2613:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2614:    // curElement.
 2615: 
 2616:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2617:    // And uses this velocity instead to continue the tracking.
 2618: 
 2619:    // computes the intersection point in local cartesian coordinates
 2620:    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2621: 
 2622:    // Nudges the point to the barycenter of the element. 
 2623:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2624:    // next segment intersects the element sides. 
 2625:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2626: 
 2627: 
 2628:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2629:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2630:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2631:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2632: 
 2633:    // If the side is an open boundary, the tangential velocity is set to zero.
 2634:    if (nextSide->isBnd()) vtan = 0.0;
 2635: 
 2636:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2637:    const double us = vtan*nextSide->t().x;
 2638:    const double vs = vtan*nextSide->t().y;
 2639:    const double ws = nextSide->w2(jlev); 
 2640: 
 2641:    u_int = {us, vs, ws};
 2642: 
 2643:    // The end of this tracking segment is now the intersection point.
 2644:    xt = {intersection.x, intersection.y, zint};
 2645: // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
 2646:    
 2647: }
 2648: 
 2649: // Helper functions to get the 2D local node position for the Celestial walk
 2650: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2651:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2652:    const Node *node = getNodeInOrder(idx2);
 2653: 
 2654:    double z = 0.0;
 2655:    if constexpr(ics == 2) z = node->gz;
 2656:    
 2657:    Point3 p = toPoint3(node->p, z);
 2658: 
 2659:    return toPoint2(origSide->toLocalFrame(p));
 2660: }
 2661: 
 2662: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2663:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2664: }
 2665: 
 2666: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, const Side* origSide,
 2667:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector) const
 2668: // Computes the three per-side predicates needed for the celestial walk
 2669: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2670: //
 2671: // xt is in local frame coordinates for origSide if ics == 2.
 2672: //
 2673: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2674: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2675: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2676: // meaningless on triangles are masked to a safe value (see comments below).
 2677: {
 2678:    // Project all 4 corner positions once into the local 2D frame.
 2679:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2680:    // getLocalNodePosition only transforms/projects if ics == 2.
 2681:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2682:                         getLocalNodePosition(1, origSide), 
 2683:                         getLocalNodePosition(2, origSide), 
 2684:                         getLocalNodePosition(3, origSide)};
 2685: 
 2686:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2687:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2688:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2689:    // But still farther towards the target point from the current point.
 2690:    const Vector2 vt0 = xt - x0;
 2691:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2692:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2693:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2694: 
 2695:    const double fac = sqrt(max(0.0000001, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001)));
 2696:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2697: 
 2698:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2699:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2700:    //  here — the orientation is baked into the corners array.)
 2701:    const int i3 = nxq(3);
 2702:    const Vector2 s0 = C[ 1] - C[ 0];
 2703:    const Vector2 s1 = C[ 2] - C[ 1];
 2704:    const Vector2 s2 = C[i3] - C[ 2];
 2705:    const Vector2 s3 = C[ 0] - C[i3];
 2706:    
 2707:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2708:    // The corners array is built from getNode in CCW order, so the orientation
 2709:    // is already correct and no ssign factor is needed in the formulas below.
 2710:    //
 2711:    // i3 = nxq(3): the index of the corner after side 2.
 2712:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2713:    //   Quad:     i3 == 3.
 2714:    //
 2715:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2716:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2717:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2718:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2719:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2720:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2721: 
 2722: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2723: 
 2724:    // For triangles, the corner after side 2 is the closing corner where
 2725:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2726:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2727:    // s0 for triangles, s3 for quads.
 2728:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2729: 
 2730:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2731:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2732:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2733:    //
 2734:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2735:    // result is false naturally. No sentinel needed.
 2736:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2737:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2738:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2739:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2740: 
 2741:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2742:    // on the "exit through side I" half of the corner cone, separated by the
 2743:    // approximate angular bisector of the celestial walk. The bisector is
 2744:    // perpendicular to the chord across the corner; the test is the sign of
 2745:    // (xt - corner_vertex) projected onto that chord.
 2746:    //
 2747:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2748:    // (the validity rule sets valid_3 = false), so its computed value for
 2749:    // triangles doesn't matter. No sentinel needed.
 2750:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2751:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2752:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2753:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2754: 
 2755: }
 2756: 
 2757: 
 2758: __inline__ __device__ double Element::computeSignedArea(void) const {
 2759:    // Compute the area of the element
 2760: 
 2761:    Point2 x0, x1, x2, x3;
 2762:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2763: 
 2764:    double res = signedArea(x0, x1, x2);
 2765: 
 2766:    // In the quad case we need to add the area of the other triangle.
 2767:    if (isQuad()) {
 2768:       x3 = getLocalHorizontalNodePosition(3);
 2769:       double ar1 = signedArea(x0, x2, x3);
 2770:       double ar2 = signedArea(x0, x1, x3);
 2771:       double ar3 = signedArea(x1, x2, x3);
 2772:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2773: 
 2774:       res += ar1 + ar2 + ar3;
 2775:    }
 2776: 
 2777:    return res;
 2778: }
 2779: 
 2780: 
 2781: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2782:                                                                 (nodes[1]->isDry2()) ||
 2783:                                                                 (nodes[2]->isDry2()) ||
 2784:                                                                 (isQuad() && nodes[3]->isDry2());
 2785: }
 2786: 
 2787: __inline__ __device__ double Element::detJ_eta(void) const {
 2788:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2789:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2790: }
 2791: 
 2792: __inline__ __device__ double Element::detJ_xi(void) const {
 2793:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2794:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2795: }
 2796: 
 2797: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2798:    // In boundary sides, the element 1 is nullptr
 2799:    return side->elems[1] == nullptr; 
 2800: }
 2801: 
 2802: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2803:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2804:    // For ics == 2, this function uses local frame coordinates.
 2805: 
 2806:    assert(isQuad());
 2807: 
 2808:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2809:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2810:    // where vxi, veta, vb are vectors and c is the center of the element.
 2811: 
 2812:    Point2 p0, p1, p2, p3;
 2813: 
 2814:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2815: 
 2816:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2817:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2818:    // vectors vxi and veta connect the centers of opposite sides
 2819:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2820:    // vb is zero for parallelogram elements.
 2821:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2822: 
 2823:    //  The bilinear mapping is:
 2824:    //      P(s,t) = C + s*U + t*V + s*t*W
 2825:    //
 2826:    //  where:
 2827:    //    C = centroid (average of four vertices)
 2828:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2829:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2830:    //    W = bilinear correction; measures deviation from parallelogram
 2831:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2832:    //        W = 0 for parallelogram elements.
 2833:    //
 2834:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2835:    //
 2836:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2837:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2838:    //
 2839:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2840:    //
 2841:    //  Geometrically, (L) projects everything onto the direction
 2842:    //  perpendicular to W, where the mapping is purely affine.
 2843:    //
 2844:    //  The dot product with nb retains the nonlinear term:
 2845:    //
 2846:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2847:    //
 2848:    //  Geometrically, (Q) projects onto the W direction, where
 2849:    //  the nonlinearity lives.
 2850:    //
 2851:    //  We solve (L) for whichever variable has the larger coefficient
 2852:    //  (better conditioned back-substitution), substitute into (Q),
 2853:    //  and get a scalar quadratic in the other variable.
 2854:    // ================================================================
 2855: 
 2856:    // ---- Basis vectors ----
 2857:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2858:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2859:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2860:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2861:    // W: nonlinear correction. Difference between quad and parallelogram.
 2862:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2863:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2864: 
 2865:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2866:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2867:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2868:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2869:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2870: 
 2871:    // ---- nb: direction parallel to W, L1-normalized ----
 2872:    // We don't need a unit vector -- just a well-scaled direction parallel
 2873:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2874:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2875:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2876:    //
 2877:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2878:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2879:    // and the quadratic solver takes its linear path (a ~ 0).
 2880:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2881:    const double inv_wlen = 1.0 / wlen1;
 2882:    const Vector2 nb = vb * inv_wlen;
 2883: 
 2884:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2885:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2886:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2887:    // What remains is a pure affine relationship between xi and eta.
 2888:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2889:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2890:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2891: 
 2892:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2893:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2894:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2895:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2896:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2897:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2898:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2899: 
 2900:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2901:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2902:    // minimizing round-off amplification.
 2903:    //
 2904:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2905:    // that uses predicated moves.
 2906:    //
 2907:    // if (fabs(Ls) > fabs(Lt)) {
 2908:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2909:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2910:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2911:    //    const double A = -Qw * Lt;
 2912:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2913:    //    const double C =  Qs * Lp - Qp * Ls;
 2914: 
 2915:    //    double eta1, eta2;
 2916:    //    solveQuadratic(A, B, C, eta1, eta2);
 2917: 
 2918:    //    // Pick root with smaller |eta| (domain centered at 0).
 2919:    //    // Ternary-> predicated move, no branch divergence.
 2920:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2921: 
 2922:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2923:    //    xi = (Lp - Lt * eta) / Ls;
 2924: 
 2925:    // } else {
 2926:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2927:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2928:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2929:    //    const double A = -Qw * Ls;
 2930:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2931:    //    const double C =  Qt * Lp - Qp * Lt;
 2932: 
 2933:    //    double xi1, xi2;
 2934:    //    solveQuadratic(A, B, C, xi1, xi2);
 2935: 
 2936:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2937: 
 2938:    //    eta = (Lp - Ls * xi) / Lt;
 2939:    // }
 2940:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2941:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2942:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2943:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2944:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2945: 
 2946:    // Quadratic:  A*r^2 + B*r + C = 0
 2947:    // (same formula for both cases, just with swapped coefficients)
 2948:    const double A = -Qw * Lb;
 2949:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2950:    const double C =  Qa * Lp - Qp * La;
 2951: 
 2952:    double r1, r2;
 2953:    solveQuadratic(A, B, C, r1, r2);
 2954: 
 2955:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2956:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2957: 
 2958:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2959:    const double other = (Lp - Lb * r) / La;
 2960: 
 2961:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2962:    xi  = solve_s ? r     : other;
 2963:    eta = solve_s ? other : r;
 2964: 
 2965: 
 2966:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2967:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2968:    eta = fmin(1.0, fmax(eta, -1.0));
 2969: 
 2970:    // ---- Shape functions ----
 2971:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2972:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2973:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2974:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2975:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2976:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2977:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2978:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2979: 
 2980:    return true;
 2981: }
 2982: 
 2983: /**
 2984:    Compute the shape coordinates of the point (xt,yt) in the element.
 2985:    @param xt (input): x-coordinate of the point
 2986:    @param shpCoords (output): shape coordinates of the point
 2987:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2988:    @return true if the point is inside the element, false otherwise
 2989: **/
 2990: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2991: 
 2992:    // Compute the shape coordinates of the point xt in the element.
 2993:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2994:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2995:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2996:    // from the local frame, so use additional check.
 2997: 
 2998:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (5)");
 2999: 
 3000:    if (isTri()) { // Triangular element
 3001: 
 3002:       // Horizontal local node coordinates. 
 3003:       Point2 x0 = nodes[0]->p;
 3004:       Point2 x1 = nodes[1]->p;
 3005:       Point2 x2 = nodes[2]->p;
 3006: 
 3007:       // If ics == 2, the node coordinates are transformed to local frame.
 3008:       if constexpr(ics==2) {
 3009:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3010:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3011:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3012: 
 3013: 
 3014:          // Convert the node coordinates to the local frame centered at the element center
 3015:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3016:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3017:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3018:       }
 3019: 
 3020:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3021:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3022:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3023:       shpCoords[3] = 0.0;
 3024: 
 3025: 
 3026:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3027:       const bool res = (tmpmin >= -small);  
 3028:       
 3029:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 3030:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3031: 
 3032: double tmpmax = max3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3033: if (tmpmin < -0.1) printf("XXX element %d, tmpmin = %.17f\n", idx, tmpmin);
 3034: if (tmpmax > 1.1) printf("XXX element %d, tmpmax = %.17f\n", idx, tmpmax);
 3035:       
 3036:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3037:       // then we fix the negative shape coordinates.
 3038:       if ((tmpmin < 0) && fix) {
 3039: 
 3040:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3041:          // keeping the sum of the shape coordinates equal to 1.
 3042:          // I have tested and compared the new algorithm with the old one, and they give
 3043:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3044:          // The new algorithm should be faster since it is branchless.
 3045:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3046:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3047:          
 3048:          shpCoords[0] = (shpCoords[0] + a)*b;
 3049:          shpCoords[1] = (shpCoords[1] + a)*b;
 3050:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3051: 
 3052:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3053:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3054:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3055: 
 3056:          // Update the point coordinates for the new shape coordinates
 3057:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3058:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3059:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3060: 
 3061:       }
 3062: 
 3063:       // Check if the point is inside the element
 3064:       return res;      
 3065:    }
 3066:    else {
 3067:       assert(isQuad() && "computeShapeCoords");
 3068: 
 3069:    //    Point2 p = xt;
 3070: 
 3071:    //    // Reproject p the original side frame for ics=2
 3072:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3073: 
 3074:    //    bool inside = false;
 3075: 
 3076: 
 3077: 
 3078:    //    if(ifl==0) then
 3079:    //      do i=1,4
 3080:    //        in1=nxq(1,i,i34(ie))
 3081:    //        in2=nxq(2,i,i34(ie))
 3082:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3083:    //      enddo !i
 3084:    //      tmp=minval(swild2(1:4))/area(ie)
 3085:    //      if(tmp>-small2) then
 3086:    //        inside=1
 3087:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3088:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3089:    //      endif !inside quad
 3090:    //    else !ifl=1 - already inside
 3091:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3092:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3093:    //      !Update pt
 3094:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3095:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3096:    //    endif !ifl
 3097: 
 3098: 
 3099:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3100: 
 3101:    }
 3102: 
 3103:    assert(false && "computeShapeCoords: should never reach this point");
 3104:    return false;  // Never reached
 3105: 
 3106: }
 3107: 
 3108: 
 3109: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3110: // Convert shape coordinates to cartesian coordinates
 3111: 
 3112:    if (isTri()) {
 3113:       // Triangular element
 3114: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3115:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3116:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3117:    }
 3118:    else {
 3119:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3120:    }
 3121: 
 3122: }
