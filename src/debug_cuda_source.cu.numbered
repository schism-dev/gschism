 3199: 
 3200: __device__ double Node::compZCoord(int k) const {
 3201:    // Computes the z coordinate at level k.
 3202:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3203:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3204:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3205:    // used 
 3206: 
 3207:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 3208:    
 3209:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3210: 
 3211:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 3212: 
 3213:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 3214: 
 3215:    if constexpr(ivcor == 2) {
 3216: 
 3217:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3218:       const double h_c = mesh->h_c;
 3219:       const double theta_f = mesh->theta_f;
 3220:       const double sinh_theta_f = mesh->sinh_theta_f;
 3221: 
 3222: 
 3223:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3224:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3225:       // once per time step/node.
 3226:       // CHECK: updateZCoordData
 3227: 
 3228:       //  To simplify comparisons, I define index versions of count variables.
 3229:       if      (k == ivrt)     return eta2; 
 3230:       else if (k == izlev)    return -hmod2;
 3231:       else if (k == kb)       return -depth;
 3232:       else if (k < izlev)     return mesh->ztot[k];
 3233:       else if (k > izlev) {
 3234:          const int ksig = k - izlev;
 3235: 
 3236:          if (hmod2 <= h_c) {
 3237:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3238: 
 3239:          } 
 3240:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3241:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3242:             assert(false && "ZCOOR (1): invalid h_c\n");
 3243:          } 
 3244:          else {
 3245:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3246:                    h_c * mesh->sigma[ksig] + 
 3247:                    (hmod2 - h_c) * mesh->cs[ksig];
 3248:          }
 3249:       } else { 
 3250:          assert(false && "ZCOOR (2): invalid level or coordinate system\n");
 3251:       }
 3252: 
 3253:    }
 3254:    else if constexpr(ivcor == 1) {
 3255:       if (k <= kb)        return -depth; 
 3256:       else if (k == ivrt) return eta2;
 3257:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3258:    }
 3259:    
 3260:    assert(false && "ZCOOR (3): invalid level or coordinate system\n");
 3261:    return 0.0;
 3262: }
 3263: 
 3264: 
 3265: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3266:    // Computes the bottom drag Cd based on the selected nchi
 3267: 
 3268:    if constexpr(nchi == 0) {
 3269:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3270:       Cd = drag;  // Read from drag file
 3271: 
 3272:    } else if constexpr(nchi == 1) {
 3273:       // 
 3274: 
 3275:       bool ltmp = false; // for WBL iteration
 3276: 
 3277:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3278:       if (isDry || (rough == 0.0)) {
 3279:          Cd = 0.0;
 3280: 
 3281:       } else { //roughness >0 
 3282:          
 3283:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3284: 
 3285:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3286: 
 3287:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3288: 
 3289:       } // if rough
 3290: 
 3291:    } else if constexpr(nchi == -1) {
 3292:    // Manning 
 3293:  
 3294:       const double htot = max(hmin_man, htot2()); 
 3295:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3296: 
 3297:    } else {
 3298:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3299:       
 3300:    } // if nchi
 3301: 
 3302: }
 3303: 
 3304: 
 3305: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3306:    // Checks if a side in on the boundary
 3307:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3308: 
 3309:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3310:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3311: 
 3312:    // Indices of the nodes that form the side
 3313:    const int n1 = side.n1->idx;
 3314:    const int n2 = side.n2->idx;
 3315:    isLand = false;
 3316:    
 3317: 
 3318:    // Check if the side is on a land boundary
 3319:    for (int i = 0; i < nland; i++) {
 3320:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3321:          // Consecutive nodes in the land boundary segment
 3322:          const int b1 = ilnd[i + j*nland];
 3323:          const int b2 = ilnd[i + (j + 1)*nland];
 3324: 
 3325:          assert(b1 != -1 && b2 != -1);
 3326: 
 3327:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3328:             
 3329:             isLand = true;
 3330:             return i;
 3331:          }
 3332:       }
 3333:    }
 3334: 
 3335:    // Check if the side is on an open boundary
 3336:    for (int i = 0; i < nope; i++) {
 3337:       for (int j = 0; j < nond[i] - 1; j++) {
 3338:          // Consecutive nodes in the open boundary segment
 3339:          const int b1 = iond[i + j*nope];
 3340:          const int b2 = iond[i + (j + 1)*nope];
 3341: 
 3342:          assert(b1 != -1 && b2 != -1);
 3343: 
 3344:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3345:             isLand = false;
 3346:             return i;
 3347:          }
 3348:       }
 3349:    }
 3350: 
 3351:    return -1;
 3352: }
 3353: 
 3354: 
 3355: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3356:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3357:                                     double *wind_rotate_angle, 
 3358:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3359:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3360:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3361:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3362:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3363: 
 3364:    NODE(pnode);  
 3365:    const int i = idx_node;
 3366:    Node &node(*pnode);
 3367: 
 3368:    node.idx = i;
 3369: 
 3370:    const int idxNodeStart = nodeNeighNodesStart[i];
 3371:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3372:    node.numNodes = idxNodeEnd - idxNodeStart;
 3373:    node.nodes = nodeNeighNodes + idxNodeStart;
 3374:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3375: 
 3376: 
 3377: 
 3378:    const int idxElemStart = nodeNeighElemsStart[i];
 3379:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3380:    node.numElements = idxElemEnd - idxElemStart;
 3381:    node.elements = nodeNeighElems + idxElemStart;
 3382: 
 3383: 
 3384:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3385:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3386:       const int partNode = localNodePart[idxNodeGlobal]; 
 3387:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3388: 
 3389:       Node *node_ptr = nodes[partNode] + idxNode;
 3390:       
 3391:       nodeNeighNodes[idx] = node_ptr;
 3392:    }
 3393: 
 3394: 
 3395:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3396:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3397:       const int partElem = localElemPart[idxElemGlobal];
 3398:       const int idxElem  = localElemIndices[idxElemGlobal];
 3399: 
 3400:       Element *elem_ptr = elems[partElem] + idxElem;
 3401: 
 3402:       nodeNeighElems[idx] = elem_ptr;
 3403:    }      
 3404: 
 3405:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3406:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3407: 
 3408:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3409:    if constexpr(ics == 1) {
 3410:       node.p.x   = node_coords[i * 3];
 3411:       node.p.y   = node_coords[i * 3 + 1];
 3412:       node.gz = 0.0;
 3413: 
 3414:    } else {
 3415:       const double lat = deg2rad*node_coords[i * 3];
 3416:       const double lon = deg2rad*node_coords[i * 3 + 1];
 3417: // printf("lat = %f, lon = %f, x = %f, y = %f\n", lat, lon, node.lat, node.lon);
 3418:       Point3 p = computeXYZfromLatLon(lat, lon);
 3419:       node.p = toVector2(p);
 3420:       node.gz = p.z;
 3421: 
 3422:       #ifdef USE_FRAMES
 3423:       node.setFrame(lat, lon);
 3424:       #endif
 3425: 
 3426: 
 3427:    }
 3428: 
 3429:    node.depth = node_coords[i * 3 + 2];
 3430: 
 3431:    node.numSides = 0;
 3432: 
 3433:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3434:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3435:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3436:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3437:    else assert(false && "populateNodes: selected nchi not implemented.");
 3438:    
 3439:    if constexpr(ivcor == 1) 
 3440:    {  
 3441:       node.kb = kb[i];
 3442:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3443:    }
 3444: 
 3445:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3446:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3447:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3448: 
 3449:    
 3450:    // Links the node to the boundary information
 3451:    if (isbnd[i] >= 0) {
 3452:      
 3453:       // Get the index of the node boundary
 3454:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3455: 
 3456:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3457:       node.nodeBnd->node = &node;
 3458: 
 3459:       node.nodeBnd->sideBnd1 = nullptr;
 3460:       node.nodeBnd->sideBnd2 = nullptr;
 3461: 
 3462:       if (isbnd[i]>=0) {
 3463: 
 3464:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3465:          
 3466:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3467:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3468: 
 3469:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3470:          node.nodeBnd->segment->clen  = nan("1");
 3471:          node.nodeBnd->segment->carea = nan("1");
 3472: 
 3473:       }
 3474:    } else {
 3475: 
 3476:       node.nodeBnd = nullptr; // For internal nodes
 3477: 
 3478:       if (isbnd[i] == landSegment) {
 3479:          node.nodeBnd = &landBoundaryNode;
 3480:          node.nodeBnd->segment = &landBoundarySegment;
 3481:       }
 3482:       
 3483:    }
 3484:    
 3485:    // XXXX GAUSSIAN HILL VELOCITIES
 3486: #ifdef GAUSSIAN_HILL_VELOCITIES
 3487:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3488:       constexpr double rot_per = 3000.0;
 3489:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3490:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3491:    // XXXXX
 3492: #endif
 3493: 
 3494: }
 3495: 
 3496: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3497:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3498:                                     double *wind_rotate_angle,   
 3499:                                     int *isdel, int *isidenode, int *isbnd,
 3500:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3501:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3502:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3503:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3504:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3505:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3506:                                     double *drag, double *roughness) {
 3507: 
 3508: 
 3509:    SIDE(pside);
 3510:    Side &side(*pside);
 3511:    const int i = idx_side;
 3512: 
 3513:    side.idx = i;  
 3514:    
 3515:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3516:    const double fc   = 2.0*omega_e*sin(sfea0);
 3517:    const double beta = 2.0*omega_e*cos(sfea0);
 3518: 
 3519:    // finding the pointer to the nodes that form the side
 3520:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3521:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3522: 
 3523:    const int locidx_n1 = localNodeIndices[idx_n1];
 3524:    const int locidx_n2 = localNodeIndices[idx_n2];
 3525:    const int part_n1 =   localNodePart[idx_n1];
 3526:    const int part_n2 =   localNodePart[idx_n2];
 3527: 
 3528:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3529:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3530: 
 3531:    #ifdef USE_FRAMES
 3532:    side.setFrame();
 3533:    #endif
 3534: 
 3535:    // Counts the number of sides connected to each node
 3536:    side.n1->numSides++;
 3537:    side.n2->numSides++;
 3538: 
 3539:    // Normal, unitary vector to the side
 3540:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3541:    side.n = normalize(side.n);
 3542: 
 3543:    // Side boundary type
 3544:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3545:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3546: 
 3547:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3548:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3549:    {
 3550:       bool isLand = false;
 3551:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3552:       
 3553:       if (isbs > -1) {
 3554:          // assert(isLand || isbs>=0);
 3555:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3556: 
 3557:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3558: 
 3559:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3560:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3561: 
 3562:          assert (isLand == side.sideBnd->segment->isLand);
 3563: 
 3564:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3565:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3566:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3567: 
 3568:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3569:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3570:          
 3571:          side.sideBnd->side = &side;
 3572: 
 3573:       }
 3574:       else {
 3575:          side.sideBnd = nullptr;
 3576:       }
 3577:    }
 3578:    else 
 3579:    {
 3580:       side.sideBnd = nullptr;
 3581:    }
 3582: 
 3583: 
 3584:    // finding the pointer to the elements that share the side
 3585:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3586:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3587: 
 3588:    if (idx_e1 > -1) {
 3589:       const int locidx_e1 = localElemIndices[idx_e1];
 3590:       const int part_e1 =  localElemPart[idx_e1];
 3591:       side.elems[0] = elems[part_e1] + locidx_e1;
 3592: 
 3593:    }
 3594:    else {
 3595:       side.elems[0] = nullptr;
 3596:    }
 3597: 
 3598:    if (idx_e2 > -1) {
 3599:       const int locidx_e2 = localElemIndices[idx_e2];
 3600:       const int part_e2 =  localElemPart[idx_e2];
 3601:       side.elems[1] = elems[part_e2] + locidx_e2;
 3602:    }
 3603:    else {
 3604:       side.elems[1] = nullptr;
 3605:    }
 3606: 
 3607:    // Compute the center of the side
 3608:    side.center = 0.5*(side.n1->p + side.n2->p);
 3609: 
 3610:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3611:    side.shapiro = shapiro0;
 3612: 
 3613: #ifdef GAUSSIAN_HILL_VELOCITIES
 3614: // XXXX
 3615: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3616: constexpr double rot_per=3000.0;
 3617: constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 3618: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3619: // XXXXX      
 3620: #endif
 3621:    // Compute the z level at the center of the side
 3622:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 3623:    
 3624:    // Compute the length of the side
 3625:    const Vector2 vLen = side.n2->p - side.n1->p;
 3626:    side.len = sqrt(dot(vLen, vLen));
 3627: 
 3628: 
 3629:    // Compute the Coriolis coefficient
 3630: 
 3631:    if constexpr(ncor == -1 || ncor == 0) {
 3632:       side.coriolis = coricoef;
 3633:    }
 3634:    else {
 3635:       const double sphi = side.lat();  // Latitude at the center of the side
 3636: 
 3637:       assert(use_ll && "use_ll must be true when ncor > 0");
 3638: 
 3639:       if constexpr(ics == 1) {
 3640:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3641:       }
 3642:       else { // ics == 2
 3643:          side.coriolis = 2.0*omega_e*sin(sphi);  
 3644:       }
 3645: 
 3646:    }
 3647: 
 3648: }
 3649: 
 3650: 
 3651: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3652:    double *node_coords, double *node_coords_ll, bool use_ll,
 3653:    double *wind_rotate_angle,   
 3654:    int *isdel, int *isidenode, int *isbnd,
 3655:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3656:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3657:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3658:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3659:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3660:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3661:    double *drag, double *roughness) {
 3662: 
 3663:    ELEM(pelem);
 3664:    Element &elem(*pelem);
 3665:    const int i = idx_elem;
 3666: 
 3667:    elem.idx = i;
 3668: 
 3669:    for (int j = 0; j < i34[i]; j++) {
 3670:       const int idxNode = elnode[i*4 + j];  
 3671:       const int idxSide = elside[i*4 + j];
 3672:       
 3673:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3674:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3675: 
 3676:       // Find the neighboring element  
 3677:       if (elem.sides[j]->elems[0] == &elem) {
 3678:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3679:       }
 3680:       else {
 3681:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3682:       }
 3683:       
 3684:    }
 3685: 
 3686:    elem.i34 = i34[i];
 3687: 
 3688:    // Compute the barycenter of the element and its depth
 3689:    elem.center = {0.0, 0.0};
 3690:    elem.depth = 1e10;
 3691:    for (int j = 0; j < i34[i]; j++) {
 3692: 
 3693:       elem.center += elem.nodes[j]->p/i34[i];
 3694:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 3695:    }
 3696: 
 3697:    elem.area = elem.computeSignedArea(); 
 3698:    elem.radius = sqrt(elem.area)/pi; 
 3699:    
 3700:    // Determines which way the normal vector to each side is oriented.
 3701:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3702:    for (int j = 0; j < i34[i]; j++)  
 3703:    {
 3704:       if (elem.sides[j]->elems[0] == &elem) {
 3705:          elem.ssign[j] =  1.0;
 3706:       }
 3707:       else {
 3708:          elem.ssign[j] = -1.0;
 3709:       }
 3710: 
 3711:    }
 3712: 
 3713:    // Derivatives of shape functions
 3714:    //  For ics=2, this is done in the element frame
 3715:    //  For quads, the derivative is evaluated at centroid
 3716:    for (int j = 0; j < elem.i34; j++) {
 3717:       const double area = elem.area;
 3718:       const int id2 = elem.nxq(1 + j);
 3719:       const int id3 = elem.nxq(2 + j);
 3720:       const int id4 = elem.nxq(3 + j);
 3721:       if (elem.isTri()) {
 3722:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3723:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3724:          // da1/dx = (y1 - y2)/(2*area)
 3725: 
 3726:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 3727:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3728:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 3729: 
 3730:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 3731:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 3732: 
 3733:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3734:       }
 3735:       else  { // Quad; evaluate at centroid
 3736: 
 3737:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 3738:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 3739:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 3740: 
 3741:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 3742:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 3743: 
 3744:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3745:       } // if Tri
 3746: 
 3747:    } // for j   
 3748:    
 3749:    
 3750: 
 3751: }
 3752: 
 3753: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3754:                                             double *emo, double *efa, 
 3755:                                             double *umo, double *ufa, 
 3756:                                             double *vmo, double *vfa) {
 3757: 
 3758:    NODE_BND(nodeBnd);
 3759:    const int idx = idx_node_bnd;    
 3760: 
 3761:    nodeBnd->idx = idx;
 3762: 
 3763:    // Need to find the segment index and the index of the node on the segment
 3764:    int idxNode = -1;
 3765:    int iseg, i;
 3766:    for (iseg = 0; iseg < nope; iseg++) {
 3767:       // for each segment...
 3768:       for (i = 0; i < nond[iseg]; i++) {
 3769:          idxNode = iond[iseg + i*nope];
 3770:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3771:          
 3772:       }
 3773:    }
 3774: 
 3775:    assert(iseg < nope && "iseg is out of bounds");
 3776: 
 3777: found: // Jumped here when the node was found
 3778: 
 3779:    nodeBnd->isEssentialBC = true;
 3780:    nodeBnd->elbc = 0.0;
 3781: 
 3782:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3783: 
 3784:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3785:       nodeBnd->efa[jfr] = efa[idx2];
 3786:       nodeBnd->emo[jfr] = emo[idx2];
 3787:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3788:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3789: 
 3790:    }
 3791:         
 3792: 
 3793: }
