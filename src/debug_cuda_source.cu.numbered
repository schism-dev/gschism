 8129: __global__ void getStructSizes(int* sizes)  {
 8130:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8131:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 8132:       sizes[0] = (int)sizeof(Node);
 8133:       sizes[1] = (int)sizeof(Element);
 8134:       sizes[2] = (int)sizeof(Side);
 8135:       sizes[3] = (int)sizeof(NodeBoundary);
 8136:       sizes[4] = (int)sizeof(SideBoundary);
 8137:       sizes[5] = (int)sizeof(BoundarySegment);
 8138: }
