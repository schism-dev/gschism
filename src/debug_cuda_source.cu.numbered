 1448: struct Side {
 1449: 
 1450:    // Geometry information
 1451:    int idx;               // Index of the side
 1452:    Node *n1, *n2;
 1453:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1454: 
 1455:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1456:    Vector2 center;        // Location of side center. 
 1457:    double zc[nvrt];       // Side center z-coord at each vertical level
 1458: 
 1459:    Frame<ics> frame;
 1460:    
 1461:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1462:                           // this is nullptr
 1463:    
 1464:    int16_t kb;            // Bottom index of the side
 1465:    bool isDry;            // True if the side is dry
 1466:  
 1467:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1468: 
 1469:    // Physical information
 1470:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1471:    Vector2 btu[nvrt];           // Back-tracked velocity
 1472:    Vector2 U;                   // Vertically averaged velocity vector  
 1473: 
 1474:    Vector2 nuGradU[nvrt];       // nu*grad u
 1475: 
 1476:    Vector2 bcc[nvrt];           // Baroclinic term
 1477:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1478: 
 1479:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1480:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1481:    Vector2 gradPr;               // Gradient of pressure
 1482:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1483: 
 1484: 
 1485:    double hhat;                 // \breve{H} in notes
 1486: 
 1487:    double shapiro;
 1488: 
 1489:    double coriolis;             // Coriolis parameter
 1490: 
 1491:    // Vegetation parameters
 1492:    double veg_c2;
 1493:    double veg_beta;
 1494: 
 1495:    // Bottom drag parameters.
 1496:    double chi;
 1497:    double chi2;
 1498: 
 1499:    // Transport model
 1500:    TransportSide<transportModel> transport; // Transport model 
 1501: 
 1502:    __inline__ __device__ Point2 outputCoords(void) const;
 1503: 
 1504:    __inline__ __device__ double x(double t) const;
 1505:    __inline__ __device__ double y(double t) const;
