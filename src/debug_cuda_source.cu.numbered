 2659: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2660: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2661: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2662: // Only when ics == 2, the origin is at the element center.
 2663: 
 2664:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2665: 
 2666:    const Node *node = nodes[idxNode];
 2667: 
 2668:    if constexpr(ics==1) {
 2669:       return node->p;
 2670: 
 2671:    } else {
 2672:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2673: 
 2674:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2675: 
 2676:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2677:    }
 2678: 
 2679: }
 2680: 
 2681: 
 2682: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2683:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2684: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2685: 
 2686:    const int id1 = idx;
 2687:    const int id2 = nxq(1 + id1);
 2688:    const int id3 = nxq(2 + id1);
 2689: 
 2690:    if constexpr(ics==1) {
 2691:       x0 = nodes[id1]->p;
 2692:       x1 = nodes[id2]->p;
 2693:       x2 = nodes[id3]->p;
 2694: 
 2695:    } else {
 2696: 
 2697:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2698:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2699:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2700: 
 2701:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2702:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2703:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2704: 
 2705:    }
 2706: 
 2707: }
 2708: 
 2709: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2710:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2711: }
 2712: 
 2713: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2714:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2715:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2716: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2717: 
 2718:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2719: 
 2720: 
 2721: 
 2722:    if constexpr(ics==1) {
 2723:       x0 = nodes[0]->p;
 2724:       x1 = nodes[1]->p;
 2725:       x2 = nodes[2]->p;  
 2726:       x3 = nodes[3]->p;
 2727: 
 2728:    } else {
 2729: 
 2730:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2731:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2732:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2733:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2734: 
 2735:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2736:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2737:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2738:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2739:    }
 2740: 
 2741: }
 2742: 
 2743: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2744:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2745: {
 2746:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2747: }
