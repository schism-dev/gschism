 2061:    template<typename T>
 2062:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2063:       // Get the values of the field at the nodes of the element
 2064:       res[0] = nodes[0]->*field;
 2065:       res[1] = nodes[1]->*field;
 2066:       res[2] = nodes[2]->*field;
 2067:       if (isQuad()) res[3] = nodes[3]->*field;
 2068:       else          res[3] = T();
 2069:    }
 2070: 
 2071:    template<typename T>
 2072:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2073: 
 2074:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2075:       // Get the values of the field at the nodes of the element
 2076:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2077:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2078:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2079:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2080:       else          res[3] = T();
 2081:    }    
