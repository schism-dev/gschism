 7221: __global__ void getStructSizes(int* sizes)  {
 7222:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7223:       sizes[0] = (int)sizeof(Node);
 7224:       sizes[1] = (int)sizeof(Element);
 7225:       sizes[2] = (int)sizeof(Side);
 7226:       sizes[3] = (int)sizeof(NodeBoundary);
 7227:       sizes[4] = (int)sizeof(SideBoundary);
 7228:       sizes[5] = (int)sizeof(BoundarySegment);
 7229: }
