 1542:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1543:       // Compute the different time ramps used in the code 
 1544:       // This function is performed by just one thread
 1545: 
 1546:       if constexpr(ibc == 0) {
 1547:          if (drampbc > 0.0) {
 1548:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1549:          } else {
 1550:             rampbc = 1.0;
 1551:          }
 1552: 
 1553:          if (nws != 0 && drampwind > 0.0) {
 1554:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1555:          } else {
 1556:             rampwind = 1.0;
 1557:          }
 1558:       }
 1559: 
 1560:       if (drampwafo > 0.0) {
 1561:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1562:       } else {
 1563:          rampwafo = 1.0;
 1564:       }
 1565: 
 1566:       // For source/sinks
 1567:       if (if_source && dramp_ss > 0.0) {
 1568:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1569:       } else {
 1570:          ramp_ss = 1.0;
 1571:       }
 1572: 
 1573:       if (dramp > 0.0) {
 1574:          ramp = tanh(2.0*time/86400.0/dramp);
 1575:       } else {
 1576:          ramp = 1.0;
 1577:       }
 1578: 
 1579:    }
