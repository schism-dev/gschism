 3636:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3637: 
 3638:       NODE_BND(nodeBnd);
 3639: 
 3640:       Node *node = nodeBnd->node;
 3641: 
 3642:       node->ETP = 0.0;
 3643: 
 3644:       for (int j=0; j<ntip; j++) {
 3645: 
 3646:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3647:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3648:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3649: 
 3650:          if constexpr(iloadtide==1) { // loading tide
 3651:             assert(false && "Loading tide not implemented");
 3652:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3653:          }
 3654:          
 3655:       }
 3656:       
 3657:    }
