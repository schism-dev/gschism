 2384: /**
 2385:  * Find the element that contains the target point.
 2386:  * 
 2387:  * @param x0,y0,z0     Starting position coordinates
 2388:  * @param xt,yt,zt     Target position coordinates
 2389:  * @param dtb          Time step for tracking
 2390:  * @param u_int        Initial velocity components
 2391:  * @param nextElem     Starting/resulting element index
 2392:  * 
 2393:  * @return Status code of type trackExitCodes
 2394:  * 
 2395:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2396:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2397:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2398:  * as close the the segment AB as possible, the next point at each iteration is computed
 2399:  * along segment AB, but just after the current element.
 2400:  */
 2401: 
 2402: 
 2403: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2404: 
 2405:    constexpr int MAX_ITERATIONS = 40;
 2406: 
 2407:    int iter = 0;
 2408:    double fac = 0.00001;
 2409:    while (iter < MAX_ITERATIONS) {
 2410:       iter++;
 2411: 
 2412:       Bool4 isLeft, isObtuse, isBisector;
 2413:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2414: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2415:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2416: 
 2417: 
 2418:       if (isValid.none()) 
 2419:       // Inside the element if none of the edges is a valid continuation
 2420:       {
 2421:          // Just returns true and the element (curElem) is unchanged).
 2422:          // This means that the algorithm has found the element that contains the target point.
 2423:          return true;
 2424:       }
 2425:       else { // Outside the element
 2426: 
 2427:          // Outside this element. Pick the first valid exit side and cross.
 2428:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2429:          Element *prevElem = curElem;
 2430:          curElem = lastCrossSide->otherElem(curElem);
 2431: 
 2432:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2433:          // along the boundary.
 2434:          if (curElem == nullptr || curElem->isDry) {
 2435:          
 2436:             curElem = prevElem;
 2437:             return false;
 2438:          }
 2439:          
 2440:       }
 2441: 
 2442:    }
 2443: 
 2444:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2445: }
 2446: 
 2447: 
