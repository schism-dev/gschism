 4634:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4635: 
 4636:       SIDE(side);
 4637: 
 4638:       side->U = {0.0, 0.0}; 
 4639:          
 4640:       if(side->isDry) return;
 4641: 
 4642:       // Vertically integrated velocity U (in ll if ics=2)
 4643:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4644:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4645:          side->U += side->Dz(k + 1)*uc;  
 4646:       }
 4647: 
 4648:    }
 4649: 
 4650:    __global__ void computeBottomDragVegetation(void) {
 4651:       // UNFINISHED. CHECK THIS:
 4652:       // How many kernels are needed? Why so many for loops?
 4653:       // Is the loop on sides needed?
 4654: 
 4655:       NODE(node);
 4656: 
 4657: 
 4658:       const int    kb      = node->kb;
 4659:       const double htot    = node->htot2(); 
 4660:       
 4661:       if (node->isDry) {
 4662:          // Default values for dry nodes
 4663:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4664:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4665: 
 4666:          return;
 4667:        
 4668:       }
 4669: 
 4670:       // Computes bottom drag Cd based on the selected nchi
 4671:       node->computeBottomDragCd();
 4672:       
 4673: 
 4674: 
 4675:       //   Bottom stress in m^2/s^2
 4676:       if (node->rho[kb + 1] >= -98.0)
 4677:       {
 4678:          const double mag_u = length(node->u2[kb + 1]);
 4679:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4680: 
 4681:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4682:          // !sediment erosion: this part needs more documentation
 4683:       }
 4684:     
 4685: 
 4686: 
 4687:       // Compute vegetation parameters
 4688:       //--------------------------------
 4689: 
 4690:       // SAV constants
 4691:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4692:       constexpr double veg_cfpsi = 0.16;
 4693: 
 4694:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4695:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4696: 
 4697:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4698:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4699:          int kbin = 0; // bin index
 4700:          for (int k = kb; k < nvrt; k++) {
 4701:             // Computes node height above the bottom level
 4702:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4703:             assert(false && "Vertical variation of vegetation not implemented");
 4704: 
 4705:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4706:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4707:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4708:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4709:             // } else {
 4710:             //    // Find the bin at which the current vertical level is
 4711:             //    while (kbin<nbins_veg_vert) {
 4712:             //       const double zn = node->z[kbin];
 4713:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4714:             //          break;
 4715:             //       } // if
 4716:             //       kbin++;
 4717:             //    } // while
 4718:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4719: 
 4720:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4721:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4722:                
 4723:             //    // Linear interpolation of the vegetation parameters
 4724:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4725:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4726:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4727:             // } // if rl10
 4728: 
 4729:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4730: 
 4731:          } // for k
 4732: 
 4733: 
 4734:       } else { // Ganthy (iveg==2)
 4735:       //  Modify canopy height, diameter, and density
 4736: 
 4737:          // Make sure there is vegetation on this node
 4738:          if (node->veg_h_unbent > 0.0) {
 4739:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4740: 
 4741:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4742:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4743:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4744: 
 4745:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4746:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4747:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4748:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4749:          } // if veg_h_unbent
 4750: 
 4751:          for (int k = 0; k < nvrt; k++) {
 4752:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4753:          } // for k
 4754:       
 4755: 
 4756:       } // if iveg
 4757:      
 4758: 
 4759:       // Compute vertical mean of veg_alpha3D
 4760:       if (iveg != 0) {
 4761:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4762:          double sum1=0.0;
 4763:          double sum2=0.0;
 4764:          // Integrate over each level under the canopy...
 4765:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4766:             const double Dz = node->Dz(k);
 4767: 
 4768:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4769:             sum2 += Dz;
 4770: 
 4771:          } // for k
 4772:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4773:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4774: 
 4775:       } // if iveg
 4776: 
 4777:    }
 4778: 
 4779:    __global__ void computeVegetationAndDragParameters(void) {
 4780:       // Computes the vegetation and drag model parameters:
 4781:       // chi, \tilde\chi, beta, \breve{H}
 4782:       
 4783:       SIDE(side);
 4784: 
 4785:       side->hhat = 0.0;
 4786:       side->chi2 = 0.0;
 4787:       side->chi = 0.0;
 4788:       side->veg_c2 = 0.0;
 4789:       side->veg_beta = 0.0;
 4790: 
 4791:       if (side->isDry) return;
 4792: 
 4793:       const double htot = side->htot2();
 4794:       const int    kb   = side->kb;
 4795: 
 4796:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4797: 
 4798:       const double veg_h     = side->veg_h();
 4799:       const double veg_nv    = side->veg_nv();
 4800:       const double veg_c     = side->veg_c();
 4801:       const double veg_beta  = side->veg_beta;
 4802:       const double veg_alpha = side->veg_alpha_vert_mean();
 4803: 
 4804:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4805:       // Velocity magnitude at the bottom level
 4806:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4807:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4808:       side->chi2 = side->Cd()*vmag1;
 4809:       side->chi  = side->chi2;
 4810:       if constexpr(iveg != 0) {
 4811:          const Node *n1 = side->n1;
 4812:          const Node *n2 = side->n2;
 4813:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4814:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4815:       }
 4816: 
 4817:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4818: 
 4819:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4820:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4821:       double magUa = 0.0;
 4822:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4823:          // 3D wet side with veg...
 4824: 
 4825:          double magUa = 0.0;
 4826:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4827:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4828: 
 4829:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4830:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4831:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4832: 
 4833:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4834:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4835: 
 4836:                // Velocity magnitude at the bottom (l) of the level
 4837:                const double ul = length(side->u2[k]);
 4838: 
 4839:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4840:                magUa += Dz*0.5*(uh + ul);
 4841: 
 4842:             } // if HasVegetation
 4843:          } // for k
 4844:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4845: 
 4846:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4847:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4848:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4849:             const double zCpy = side->zTopCanopy();
 4850:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4851:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4852:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4853:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4854:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4855:          } // if isSubmerged
 4856:       } // if iveg   
 4857: 
 4858:       // Computes the friction modified depth, \breve{H} in notes
 4859:       if (side->is2D()) { // 2D
 4860: 
 4861:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4862:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4863: 
 4864:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4865: 
 4866:          side->hhat = htot*htot/fricH; 
 4867: 
 4868:       } else { // 3D
 4869:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4870: 
 4871:          if constexpr(iveg != 0) {
 4872:             
 4873:             if (side->isSubmerged()) { 
 4874:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4875:                side->hhat -= veg_c*Hhat_alpha;
 4876: 
 4877:             } else { // Emergent
 4878:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4879:             }
 4880:          } // if iveg
 4881: 
 4882:          // Enforce positivity for 3D model
 4883:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4884:       } // if 3D
 4885: 
 4886:    }
 4887: 
 4888: 
 4889: 
 4890:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4891:    // Computes the density gradient between two elements, e1 and e2.
 4892:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4893:    // zero in the direction normal to the side. 
 4894:    // 
 4895:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4896:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4897:    //
 4898:    // Input:
 4899:    //    e1: Element
 4900:    //    e2: Neighbor element (or nullptr if boundary)
 4901:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4902:    //    k: Index of the half-level at which the density is interpolated
 4903:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4904:    // 
 4905:    // Output:
 4906:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4907:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4908: 
 4909:       if (e2 == nullptr || e2->isDry) {
 4910:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4911: 
 4912:          Side *side = e1->sides[j];
 4913:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4914:                  
 4915:          if constexpr(ics == 1) {
 4916:             vec = side->n; // Normal vector to the side
 4917:          } else {
 4918:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4919:             // IMPLEMENT THIS XXXXXX
 4920:             // !replace with xel, yel?
 4921:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4922:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4923:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4924:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4925:          } //ics
 4926:                    
 4927:          diffRho = 0.0;
 4928: 
 4929:       } else { //internal and wet
 4930:          if constexpr(ics==1) {
 4931:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4932: 
 4933:             // Vector from e1 to e2
 4934:             vec = e2->center - e1->center;
 4935: 
 4936:          } else { 
 4937:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4938:             // IMPLEMENT THIS XXXXXX
 4939:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4940:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4941:             //                   alow(j)=xctr2
 4942:             //                   bdia(j)=yctr2
 4943:          } // ics
 4944: 
 4945:          diffRho = rho2 - e1->demeanedDensity(k);
 4946:       }
 4947: 
 4948:    }
 4949: 
 4950:    __global__ void computeDensityCubicSplines(void) {
 4951:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4952: 
 4953:       ELEM(elem);
 4954: 
 4955:       if (elem->isDry) return;
 4956: 
 4957:       const int kb = elem->kb;
 4958: 
 4959:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4960:       if (elem->is2D()) {
 4961:          // In the 2D case, the density is constant at the prism level. 
 4962:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4963:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4964:       } else { //3D
 4965: 
 4966:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4967:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4968:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4969:          ///// XXXX CHECK INDICES!!!!!
 4970:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4971:       } // 2D/3D
 4972: 
 4973:    }
 4974: } // extern "C"
 4975: 
 4976: 
 4977: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4978: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4979: 
 4980:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4981: 
 4982:    const int kb  = elem->kb;
 4983:    const int kb2 = elem2->kb;
 4984: 
 4985:    // z-coordinate of prism of elem
 4986:    const double zp = elem->z_prism(k);
 4987: 
 4988:    double rho = 0.0;
 4989: 
 4990:    if (elem2->is2D()) {
 4991:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4992: 
 4993:    } else {  // 3D
 4994: 
 4995:       // eta_min may be < zmax
 4996:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4997:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4998: 
 4999:       // (Extrapolate density below bottom, we will fix it later)
 5000:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5001:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5002:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5003:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5004:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5005:    } // 2D/3D
 5006:      
 5007: 
 5008:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5009:    // Now we need to fix it.
 5010:    if (elem->z[k] < elem2->z[kb2]) {
 5011:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5012: 
 5013:       // There are two methods to adjust the density at the bottom of the element.
 5014:       // iunder_deep=0: 
 5015:       const double depth1 = abs(elem->z[kb]); // larger depth
 5016: 
 5017:       if (iunder_deep==0) {
 5018: 
 5019:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5020: 
 5021:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5022: 
 5023:       } else { // iunder_deep != 0
 5024: 
 5025:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5026: 
 5027:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5028: 
 5029:          //   Demeaned density at the same z coordinate as
 5030:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5031:          }
 5032: 
 5033:       } // if iunder_deep
 5034:    } // if elem->z[kb] < elem2->z[kb]
 5035: 
 5036:    return rho;
 5037: }
 5038: 
 5039: 
 5040: extern "C" {
 5041:    __global__ void computeDensityGradient(void) {
 5042: 
 5043:       if constexpr(ibc != 0) return;
 5044: 
 5045:          // Compute the horizontal density gradient at each element.
 5046:       // It works in two steps:
 5047:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5048:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5049:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5050:       //             gradRho.r1 = rho1 - rho0
 5051:       //             gradRho.r2 = rho2 - rho0
 5052:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5053:       // 
 5054:       //  NOTE: We use de-meaned densities.
 5055: 
 5056:       ELEM(elem);
 5057: 
 5058:       if (elem->isDry) return;
 5059: 
 5060:       const int kb  = elem->kb;
 5061:       const int i34 = elem->i34;
 5062: 
 5063:       for (int k = kb + 1; k < nvrt; k++) {
 5064:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5065:          //             gradRho.r1 = rho1 - rho0
 5066:          //             gradRho.r2 = rho2 - rho0
 5067:          int icount = 0;
 5068:          double sumRx = 0.0;
 5069:          double sumRy = 0.0;
 5070:          for (int j1=0; j1<i34; j1++) { 
 5071: 
 5072:             const int j2 = elem->nxq(j1 + 1);
 5073: 
 5074:             // Pairs of consecutive neighbor elements of elem
 5075:             const Element *e1 = elem->nghbElems[j1];
 5076:             const Element *e2 = elem->nghbElems[j2];
 5077: 
 5078:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5079:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5080:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5081: 
 5082:             // Compute the density difference and the vector from elem to e1 and e2
 5083:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5084:             double diffRho1, diffRho2;
 5085:             Vector2 vec1, vec2;
 5086:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5087:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5088: 
 5089:             const double rl1 = length(vec1);
 5090:             const double rl2 = length(vec2);
 5091:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5092: 
 5093:             const double delta = cross(vec1, vec2);
 5094:             const double sintheta = abs(delta)/(rl1*rl2);
 5095: 
 5096:             // To avoid problems, avoid elements with small angle between vectors
 5097:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5098:             const bool validEq = (sintheta > sin_one_deg);
 5099: 
 5100:             if (validEq) {
 5101:                // Solve the system of equations to get the density gradient at elem
 5102:                icount++;
 5103:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5104:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5105:                sumRx += Rx;
 5106:                sumRy += Ry;
 5107:             }
 5108:          } // for j1
 5109: 
 5110:          // Compute the average density gradient at elem
 5111:          if (icount==0) {
 5112:            // Bad mesh quality; bail out with 0 b-cc
 5113:            elem->gradRho[k] = {0.0, 0.0};
 5114:          } else {
 5115:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5116:          }
 5117: 
 5118:       } // for k
 5119: 
 5120:    }
 5121: 
 5122:    __global__ void computeBaroclinicTerm(void) {
 5123:    // Computes the baroclinic term at sides (at half levels).
 5124:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5125:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5126: 
 5127:       if (ibc == 1) return;
 5128: 
 5129:       SIDE(side);
 5130: 
 5131:       if (side->isDry) return;
 5132: 
 5133:       const Element *e1 = side->elems[0];
 5134:       const Element *e2 = side->elems[1];      
 5135:       const int kb = side->kb;
 5136:       
 5137:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5138: 
 5139:       // interpolates vertically the density gradient of the two elements at the half level/
 5140: 
 5141:       int k1 = max(kb, nvrt / 2);
 5142:       int k2 = max(kb, nvrt / 2);
 5143: 
 5144:       // Starts the integration at the surface and goes down to the bottom
 5145:       side->bcc[nvrt-1] = {0.0, 0.0};
 5146:       for (int k = nvrt - 2; k >= kb; k--) {
 5147:       // For each prism level (from surface to bottom)...
 5148: 
 5149:          // For both elements, interpolate density gradient at the side's half level.
 5150:          // The gradient at the side is the average of the gradients at the elements.
 5151:          // w1, w2 are used to take into account boundary sides, with just one element.
 5152:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5153:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5154:          const double wsum = w1 + w2;
 5155:          w1 = w1/wsum;
 5156:          w2 = w2/wsum;
 5157:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5158: 
 5159:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5160:          Vector2 gradRho = {0.0, 0.0};
 5161:          if (e1 != nullptr && k > kb) {
 5162:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5163:             
 5164:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5165:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5166:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5167: 
 5168:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5169:          }      
 5170:          if (e2 != nullptr && k > kb) {
 5171:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5172:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5173:             
 5174:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5175:          }
 5176: 
 5177:          if constexpr(ics==2) {
 5178:             assert(false && "Not implemented: ics == 2");
 5179:             // IMPLEMENT THIS XXXXXX
 5180:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5181:             // swild(1)=tmp1
 5182:             // swild(2)=tmp2
 5183:          }
 5184:          
 5185:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5186:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5187:          // CHECK INDICES!!! XXX
 5188:          const double grav3 = side->grav3();
 5189:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5190: 
 5191:       } // for
 5192: 
 5193:    }
 5194: 
 5195: 
 5196: 
 5197:    __global__ void computeHorGradientAtSide(void) {
 5198: 
 5199:       // Compute the horizontal density gradient at each element.
 5200:       // It works in two steps:
 5201:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5202:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5203:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5204:       //             gradRho.r1 = rho1 - rho0
 5205:       //             gradRho.r2 = rho2 - rho0
 5206:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5207:       // 
 5208:       //  NOTE: We use de-meaned densities.
 5209: 
 5210:       SIDE(side);
 5211: 
 5212: 
 5213:       if (side->isDry) return;
 5214: 
 5215:       // Computes the gradient of the variables at the side center.
 5216:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5217:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5218:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5219: 
 5220:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5221:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5222:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5223:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5224: 
 5225:    }
 5226: 
 5227: 
 5228:    __global__ void solveMomentumEquations(double time) {
 5229: 
 5230:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5231:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5232: 
 5233:       SIDE(side);
 5234: 
 5235:       if (side->isDry) 
 5236:       {
 5237:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5238: 
 5239:          return;
 5240:       }
 5241: 
 5242:       const Node *n1 = side->n1;
 5243:       const Node *n2 = side->n2;
 5244: 
 5245:       const int kb = side->kb;
 5246: 
 5247:       const double veg_h = side->veg_h();
 5248:       const double grav3 = side->grav3();
 5249: 
 5250:       if (side->is2D()) {
 5251:          // Remember: Do not use htot2, which is updated.
 5252:          const double htot = side->htot1();
 5253:          const double hhat = side->hhat;
 5254: 
 5255:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5256: 
 5257:          Vector2 tau2 = {0.0, 0.0};
 5258:           
 5259:          if constexpr(ics==1) {
 5260:             tau2 = side->tau();
 5261: 
 5262:          } else {
 5263:             assert(false && "Not implemented: ics == 2");
 5264:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5265:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5266:             // taux2=(vn1+tt1)*0.5d0
 5267:             // tauy2=(vn2+ss1)*0.5d0
 5268:          } // if ics         
 5269: 
 5270:          // hat_gam has units of m/s
 5271: 
 5272:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5273:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5274:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5275: 
 5276:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5277: 
 5278: 
 5279:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5280: 
 5281:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5282: 
 5283:       }
 5284:       else { // 3D
 5285: 
 5286:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5287:          // 
 5288:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5289:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5290:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5291:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5292:          // k+1 and k.
 5293: 
 5294: 
 5295:          const int ndim = nvrt - kb;
 5296:          const double zTopCanopy = side->zTopCanopy();
 5297: 
 5298:          // Initialize the tridiagonal system
 5299:          for (int k = kb + 1; k < nvrt; k++) {
 5300:             
 5301:             const int kin = k - (kb + 1);
 5302: 
 5303:             // Vertical viscosity at the face center
 5304:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5305: 
 5306:  
 5307:             alow[kin] = 0.0;
 5308:             cupp[kin] = 0.0;
 5309:             bdia[kin] = 0.0;
 5310: 
 5311:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5312:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5313: 
 5314:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5315:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5316:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5317: 
 5318:             // First part: layers k, k+1
 5319:             if (k < nvrt - 1) {
 5320:                              
 5321:                if constexpr(iveg != 0) {
 5322: 
 5323:                   // If there is vegetation at this level...
 5324:                   if (zTopCanopy > side->zc[k]) {
 5325:                      // If the canopy is above the k layer...
 5326:                      
 5327:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5328:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5329:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5330:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5331: 
 5332:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5333:                      const double vmag2 = length(ut2);
 5334:                      const double vmag1 = length(side->u2[k]);
 5335:                      const double vmag = 0.5*(vmag1 + vmag2);
 5336:                      
 5337:                      // Computes the vegetation alpha at the face center
 5338:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5339: 
 5340:                      cff1 += veg_alpha_sd*dt*vmag;
 5341: 
 5342:                   } // if (zTopCanopy
 5343:                } // if iveg
 5344: 
 5345:                const double dzz = side->Dz(k + 1);
 5346:                const double tmp = dt*dfz/dzz;
 5347:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5348: 
 5349:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5350:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5351:             }
 5352: 
 5353: 
 5354:             // Second part: layers k-1, k
 5355:             if (k > kb + 1) {
 5356: 
 5357:                double cff1 = 1.0; //init \bar{c^k}
 5358: 
 5359:                if constexpr(iveg != 0) {
 5360:                   // If there is vegetation at this level...
 5361:                   if (zTopCanopy > side->zc[k-1]) {
 5362:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5363:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5364: 
 5365:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5366: 
 5367:                      const double vmag2 = length(ut2);
 5368:                      const double vmag1 = length(side->u2[k-1]);
 5369:                      const double vmag = 0.5*(vmag1 + vmag2);
 5370: 
 5371:                      // Computes the vegetation alpha at the face center
 5372:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5373:                      cff1 += veg_alpha_sd*dt*vmag;
 5374:                   } // if zTopCanopy
 5375: 
 5376:                } // if iveg
 5377: 
 5378:                const double dzz = side->Dz(k);
 5379:                const double tmp = dt*dfz/dzz;
 5380:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5381: 
 5382:                alow[kin] += cff1*dzz/6.0 - tmp;
 5383:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5384: 
 5385:             } else { // Bottom boundary
 5386:                // This occurs at the bottom, where the bottom drag is applied.
 5387: 
 5388:                bdia[kin] += dt*side->chi2; // XXXX
 5389: 
 5390:             } // if (k > kb + 1)
 5391: 
 5392: 
 5393:          } // for (int k
 5394: 
 5395: 
 5396: 
 5397:          // Computes the RHS.
 5398:          // -----------------
 5399: 
 5400:          //	BC to be imposed at the end.
 5401: 
 5402:          const Vector2 gradETP  = side->gradETP;
 5403:          const Vector2 gradPr   = side->gradPr;
 5404:          const Vector2 gradEta1 = side->gradEta1;
 5405:          const Vector2 gradEta2 = side->gradEta2;
 5406: 
 5407:          const Vector2 *btu = side->btu;
 5408:          const Vector2 *u2  = side->u2;
 5409:          const double coriolis = side->coriolis;
 5410:          const Vector2 *nuGradU = side->nuGradU;
 5411: 
 5412: 
 5413:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5414:          for (int k = kb + 1; k < nvrt; k++) {
 5415:             const int kin = k - kb - 1;
 5416: 
 5417:             const double dz_0 = side->Dz(k);
 5418:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5419: 
 5420:             rrhs[kin] = {0.0, 0.0};
 5421:             double dz = 0.0;
 5422: 
 5423:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5424:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5425:             if (k < nvrt  ) dz += dz_1;
 5426:             if (k > kb + 1) dz += dz_0;
 5427: 
 5428:             // Elevation gradient, atmospheric pressure and tidal potential
 5429:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5430: 
 5431:             // Coriolis, advection, wind stress, and horizontal viscosity
 5432:             if (k < nvrt - 1) {
 5433: 
 5434: 
 5435:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5436:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5437:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5438:                                                 
 5439: 
 5440:                //diff stress tensors 1006
 5441:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5442:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5443:                   assert(false && "Not implemented: itur == 5");
 5444:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5445:                }
 5446:                // else assert(false && "itur # Not implemented");
 5447: 
 5448:             } else { // k == nvrt - 1 SURFACE
 5449:                Vector2 tau2 = {0.0, 0.0};
 5450:                if constexpr(ics==1) {
 5451:                   tau2 = side->tau();
 5452:       
 5453:                } else {
 5454:                   assert(false && "Not implemented: ics == 2");
 5455:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5456:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5457:                   // taux2=(vn1+tt1)*0.5d0
 5458:                   // tauy2=(vn2+ss1)*0.5d0
 5459:                } // if ics
 5460: 
 5461:                rrhs[kin] += dt*tau2;
 5462:           
 5463: 
 5464:             } // if k<nvrt
 5465: 
 5466: 
 5467:             if (k > kb + 1) {
 5468:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5469:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5470:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5471: 
 5472:                // diff stress tensors 1006
 5473:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5474:                   assert(false && "Not implemented: itur == 5");
 5475:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5476:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5477:                }
 5478:                // else assert(false && "itur # Not implemented");
 5479: 
 5480: 
 5481:             } // if k>kbs + 1
 5482: 
 5483:             // Baroclinic
 5484:             Vector2 *bcc = side->bcc;
 5485:             if constexpr(ibc == 0) {
 5486:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5487:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5488: 
 5489:             } // if ibc==0
 5490: 
 5491:          } // k=kb + 1,nvrt
 5492: 
 5493: 
 5494:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5495: 
 5496:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5497:             const int kin = k - kb - 1;
 5498:    
 5499:             // Velocity is always clamped to maximum values
 5500:             side->u2[k] = clampVelocity(soln[kin]);
 5501:          } // k
 5502: 
 5503:       } // if side->is2D()
 5504:       
 5505: 
 5506:       // Impose velocity boundary condition at the bottom
 5507:       if constexpr(imm == 2) { // 3D bed deformation model
 5508:          double dep;
 5509:          Vector2 vel;
 5510: 
 5511:          assert(false && "Not implemented: imm == 2");
 5512:          //update_bdef(time, x0, y0, dep, vel);
 5513:          // side->u2[kb] = vel;
 5514: 
 5515:       } else { // imm = 0 or 1
 5516:          if (side->Cd() == 0.0) {
 5517:             side->u2[kb] = side->u2[kb + 1];
 5518: 
 5519:          } else if (side->is3D()) { // 3D no slip bottom   
 5520:             side->u2[kb] = {0.0, 0.0};
 5521: 
 5522:          }
 5523:           
 5524:       } // if imm
 5525: 
 5526:       // The velocities below the bottom level are set to zero
 5527:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5528: 
 5529: 
 5530:    }
 5531: 
 5532: 
 5533:    __global__ void applyMomentumBC(void) {
 5534: 
 5535:       SIDE_BND(sideBnd);
 5536: 
 5537:       Side *side = sideBnd->side;
 5538:       const BoundarySegment *segment = sideBnd->segment;
 5539:       const Node *n1 = side->n1;
 5540:       const Node *n2 = side->n2;
 5541: 
 5542:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5543: 
 5544:       const bool isLand = segment->isLand;
 5545:       const int ifltype = segment->ifltype;
 5546: 
 5547:       const int kb = side->kb;
 5548: 
 5549: 
 5550:       if (!isLand && ifltype != 0) {
 5551:          const Vector2 *ubc = sideBnd->ubc;
 5552:   
 5553:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5554:             
 5555:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5556:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5557: 
 5558:             if (ifltype == -1) {
 5559:                // Flather 1
 5560: 
 5561:                const double depth = side->depth();
 5562: 
 5563:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5564: 
 5565:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5566: 
 5567:                side->u2[k] = vnorm*side->n;
 5568: 
 5569:             } else if (ifltype == -2) { // Discharge
 5570: 
 5571:                const double eta1 = side->eta1();
 5572:                const double eta2 = side->eta2();
 5573:                const double htot = side->htot2();
 5574: 
 5575:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5576:                assert(false && "Not implemented: Discharge bc");
 5577:                // const double dischrg = discharge(eta1);
 5578:                const double dischrg = 0.0; // XXX REMOVE
 5579:                
 5580: 
 5581:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5582: 
 5583:                const double vnorm = dischrg*eta2/htot;
 5584: 
 5585:                side->u2[k] = vnorm*side->n;
 5586: 
 5587:             }
 5588:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5589:                const double vnorm = dot(side->u2[k], side->n);
 5590: 
 5591:                double rat;
 5592:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5593:                else              rat = segment->vobc2; // outgoing
 5594: 
 5595:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5596: 
 5597:             }
 5598:             else { // not Flather or 3D radiation
 5599:                side->u2[k] = ubc[k];
 5600: 
 5601:             } // if (segment->ifltype...
 5602: 
 5603:          }
 5604: 
 5605:       }
 5606:       else if (isLand) { // if it is land boundary side
 5607: 
 5608:          if constexpr(islip == 0) { // free slip
 5609: 
 5610:             for (int k = kb; k < nvrt; k++) {
 5611: 
 5612:                const Vector2 t = side->t();
 5613:                const Vector2 n = side->n;
 5614: 
 5615:                double vnorm = 0.0; // for most cases
 5616:                const double vtan = dot(side->u2[k], t);
 5617:                
 5618:                side->u2[k] = vtan*t - vnorm*n;
 5619: 
 5620:             }
 5621: 
 5622:          } else { // no slip
 5623:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5624: 
 5625:          }
 5626:       } // if (side segment type...
 5627: 
 5628:    
 5629: 
 5630:    }
 5631: 
 5632: 
 5633:    __global__ void shapiroFilter1(void) {
 5634:       // First step of the Shapiro filter (normally used if indvel<=0)
 5635:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5636: 
 5637:       SIDE(side);
 5638: 
 5639:       // Only internal wet sides are processed
 5640:       if (side->isDry || !(side->isInternal())) return;
 5641: 
 5642:       const int kb = side->kb;
 5643: 
 5644:       for (int mm = 0; mm < niter_shap; mm++) {
 5645: 
 5646:          for (int k = kb + 1; k < nvrt; k++) {
 5647:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5648:             Vector2 suru = {0.0, 0.0};
 5649: 
 5650:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5651: 
 5652:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5653: 
 5654:                int kin = k;
 5655:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5656:                
 5657:                if constexpr(ics==1) {
 5658:                   suru += nSide->u2[kin];
 5659: 
 5660:                } else {
 5661:                   assert(false && "Not implemented: ics == 2");
 5662:                   // Vector2 vn1, vn2;
 5663:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5664:                   // suru=suru+vn1;
 5665:                   // surv=surv+vn2;
 5666:                }
 5667:             }
 5668: 
 5669:             // Reusing bcc as a temporary array to store the suru values.
 5670:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5671: 
 5672:          }
 5673:       }
 5674:    }
 5675: 
 5676:    __global__ void shapiroFilter2(void) {
 5677:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5678: 
 5679:       SIDE(side);
 5680: 
 5681: 
 5682:       if (side->isDry || !(side->isInternal())) return;
 5683: 
 5684:       const int kb = side->kb;
 5685: 
 5686:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5687: 
 5688:       if (side->is2D()) {
 5689:          side->u2[kb + 1] = side->bcc[kb + 1];
 5690:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5691: 
 5692:       } else {
 5693:          // 3D
 5694:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5695:          
 5696:       }
 5697: 
 5698:    }
 5699: 
 5700: 
 5701:    __global__ void ul0UpdateZCoords(void) {
 5702:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5703:       
 5704:       NODE(node);      
 5705: 
 5706: 
 5707:       if (false) { //node->isDry) { XXXXXXX
 5708: 
 5709:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5710: 
 5711:          if constexpr(ivcor != 1) node->kb = 0;
 5712: 
 5713:       } else {
 5714: 
 5715:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5716:          node->updateKb();
 5717: 
 5718:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5719: 
 5720:       }
 5721: 
 5722:       // We use the temp.b field to store the previous state of isDry.
 5723:       node->tmp.b = node->isDry;
 5724: 
 5725:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5726:       node->isDry = true;
 5727: 
 5728:    }
 5729: 
 5730:    __global__ void ul0ComputeDryElements(void)
 5731:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5732:    {
 5733:       ELEM(elem);
 5734: 
 5735:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5736: 
 5737:       elem->kb = 0;
 5738: 
 5739:       if (elem->isDry) return;
 5740: 
 5741: 
 5742:    //    if(elem->isDry2()) { // XXXX
 5743:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5744:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5745:    //        call parallel_abort(errmsg)
 5746:    //    }
 5747: 
 5748:       const Node *n1 = elem->nodes[0];
 5749:       const Node *n2 = elem->nodes[1];
 5750:       const Node *n3 = elem->nodes[2];  
 5751:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5752: 
 5753:       // Computes element's kb as the minimum of the nodes' kb.
 5754:       const int kb1 = n1->kb;
 5755:       const int kb2 = n2->kb;
 5756:       const int kb3 = n3->kb;
 5757:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5758: 
 5759: 
 5760:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5761: 
 5762: 
 5763:       // Computes the element z as the mean of the nodes z.
 5764:       for (int k = elem->kb; k < nvrt; k++) {
 5765: 
 5766:          // Compute the element z as the mean of the nodes z.
 5767:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5768:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5769:          elem->z[k] /= elem->i34;
 5770: 
 5771:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5772:       }
 5773:                   
 5774:    }
 5775: 
 5776:    __global__ void ul0ComputeDryNodes(void)
 5777:    // Updates node's isDry based on the elements' isDry. 
 5778:    {
 5779:       NODE(node);
 5780: 
 5781:       node->isDry = true;
 5782: 
 5783:       // A node is wet if at least one of the elements sharing it is wet.
 5784:       for (int j = 0; j < node->numElements; j++) {
 5785:          const Element *elem = node->elements[j];
 5786:          if (!elem->isDry) {
 5787:             node->isDry = false;
 5788:             break;
 5789:          }
 5790:       }
 5791: 
 5792:        
 5793:    }
 5794: 
 5795: 
 5796:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5797:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5798:    // node->tmp.b is true if the node was previously dry.
 5799:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5800:    {
 5801:       NODE(node);
 5802:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5803: 
 5804:       // Avoid this the first time step.
 5805:       if (it == iths) return;  
 5806: 
 5807:       const bool wasDry = node->tmp.b;
 5808: 
 5809: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5810: 
 5811:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5812: 
 5813:          for (int k=0; k < nvrt; k++) {
 5814: 
 5815:             Vector3 utmp={0.0, 0.0, 0.0};
 5816: 
 5817:             double ttmp=0.0;
 5818:             double stmp=0.0;
 5819:             int icount=0;
 5820:             for (int j = 0; j < node->numNodes; j++) {
 5821: 
 5822:                const Node *nbrNode = node->nodes[j];
 5823:                
 5824:                const bool wasNbrDry = nbrNode->tmp.b;
 5825: 
 5826:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5827:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5828: 
 5829:                   icount++;
 5830: 
 5831:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5832:                   utmp += nbrNode->uvw2(k);
 5833:                   
 5834:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5835:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5836:                }
 5837:             }
 5838: 
 5839:             if (icount > 0) {
 5840:                const double inv_icount = 1.0/icount;
 5841:                utmp = inv_icount*utmp;
 5842:                node->u2[k]     = toVector2(utmp);
 5843:                node->w2[k]     = utmp.z;
 5844:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5845:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5846:             } else {
 5847:                node->u2[k] = {0.0, 0.0};
 5848:                node->w2[k] = 0.0;
 5849:                // Initialize tracers to 0.0??? XXXXX
 5850:             }
 5851:          }
 5852:       }
 5853:    }
 5854: 
 5855:   
 5856:    
 5857: 
 5858: 
 5859:    __global__ void ul0UpdateSides(int it, int iths) {
 5860:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5861:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5862:    // The dryness of the sides is updated in ul0UpdateSides2.
 5863: 
 5864:       SIDE(side);
 5865: 
 5866:       // A side is wet if and only if at least one of its elements is wet.
 5867:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5868:  
 5869:       const Node *n1 = side->n1;
 5870:       const Node *n2 = side->n2;
 5871:      
 5872:       const int kb1 = n1->kb;
 5873:       const int kb2 = n2->kb;
 5874: 
 5875:       side->kb = 0; // default when dry
 5876: 
 5877:       if (isWet) {
 5878: 
 5879:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5880: 
 5881:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5882: 
 5883:          side->kb = min(kb1, kb2);
 5884: 
 5885:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5886: 
 5887:          for (int k = side->kb; k < nvrt; k++) {
 5888:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5889: 
 5890:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5891: 
 5892:             // Compute velocity for re-wetted sides 
 5893:             if ((it != iths) && (side->isDry && isWet)) {
 5894: 
 5895:                Vector2 utmp={0.0, 0.0};
 5896: 
 5897:                int icount=0;
 5898: 
 5899:                // For all the sides on the two elements that share this side
 5900:                for (int j = 0; j < 2; j++) {
 5901:                   const Element *elem = side->elems[j];
 5902:                   if (elem == nullptr) continue;
 5903: 
 5904:                   for (int jj=0; jj < elem->i34; jj++) {
 5905:                      const Side *nSide = elem->sides[jj];
 5906:                      if (nSide->isDry) continue;
 5907: 
 5908:                      icount++;
 5909:                      utmp += nSide->u2[k];  
 5910:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5911:                   }
 5912:                }
 5913:                   
 5914:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5915:                if (icount > 0)  side->u2[k] = utmp/icount;
 5916:                else             side->u2[k] = {0.0, 0.0};
 5917:                   
 5918:             } // if ((it != iths) && (side->isDry && isWet))
 5919: 
 5920:          } // for k
 5921: 
 5922:       } // if isWet 
 5923:       
 5924: 
 5925: 
 5926:    }
 5927: 
 5928:    __global__ void ul0UpdateSides2(void) {
 5929:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5930:    
 5931:          SIDE(side);
 5932:    
 5933:          const Element *e1 = side->elems[0];
 5934:          const Element *e2 = side->elems[1];
 5935: 
 5936:          // A side is wet if and only if at least one of its elements is wet.
 5937:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5938: 
 5939:          // Update the side's dryness
 5940:          side->isDry = !isWet;
 5941: 
 5942:    }
 5943: 
 5944: 
 5945:    __global__ void zeroNodalVelocities(void) {
 5946:       NODE(node);
 5947: 
 5948:       for (int k = 0; k < nvrt; k++) {
 5949:          node->u2[k]   = {0.0, 0.0};
 5950:          node->w2[k]   = 0.0;
 5951:          node->utmp[k] = {0.0, 0.0};
 5952:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5953:       }
 5954:    }
 5955:  
 5956: 
 5957:    __global__ void computeNodalVerticalVelocities1(void) {
 5958:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5959:    // Adds the element's vertical velocity times the element's area.
 5960:       ELEM(elem);
 5961: 
 5962:       for (int j = 0; j < elem->i34; j++) {
 5963:          Node *node = elem->nodes[j];
 5964: 
 5965:          for (int k = node->kb; k < nvrt; k++) {
 5966:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5967:          }
 5968:          atomicAdd(&(node->tmp.d), elem->area);
 5969:       }
 5970:    }
 5971: 
 5972:    __global__ void computeNodalVerticalVelocities2(void) {
 5973:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5974:    // Divides by the total area of the elements sharing the    node.
 5975:       NODE(node);
 5976: 
 5977:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5978: 
 5979:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5980:    }
 5981: 
 5982: 
 5983:    __global__ void computeNodalHorizontalVelocities1(void) {
 5984: 
 5985:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5986:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5987: 
 5988:       ELEM(elem);
 5989: 
 5990:       if (elem->isDry) return;
 5991: 
 5992:       const int kb = elem->kb;
 5993:       const bool isTri = elem->isTri();
 5994: 
 5995:       if constexpr(indvel <= 0) {
 5996:          // Assuming discontinous hvel.
 5997: 
 5998:          if (isTri) { // For triangles
 5999:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6000:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6001: 
 6002:             for (int j = 0; j < 3; j++) {
 6003:                // For every node of the triangle...
 6004:                Node *node = elem->nodes[j];
 6005: 
 6006:                if (node->isDry) continue;
 6007: 
 6008:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6009:                const Side *s2 = elem->sides[(j + 1) % 3];
 6010:                const Side *s3 = elem->sides[(j + 2) % 3];
 6011: 
 6012:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6013: 
 6014:                atomicAdd(&(node->tmp.i), 1);
 6015: 
 6016:                for (int k = kb; k < nvrt; k++)  {
 6017:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6018:                   u = clampVelocity(u);
 6019:                   atomicAdd(&(node->utmp[k].x), u.x);
 6020:                   atomicAdd(&(node->utmp[k].y), u.y);
 6021: 
 6022:                }
 6023: 
 6024:             }
 6025:          }
 6026:          else { // For quads
 6027:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6028: 
 6029:          }
 6030: 
 6031:       }
 6032:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6033:       
 6034:    }
 6035: 
 6036: 
 6037:    __global__ void computeNodalHorizontalVelocities2(void) {
 6038:       NODE(node);
 6039: 
 6040:       const int nodeCount = node->tmp.i;
 6041: 
 6042:       if (nodeCount == 0) 
 6043:       {
 6044:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6045:          return;
 6046:       }
 6047: 
 6048:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6049:       
 6050:       const int kb = node->kb;
 6051: 
 6052:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6053:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6054:       
 6055:       
 6056:    }   
 6057: 
 6058:  
 6059: 
 6060:    __global__ void resetVelocityOpenBndNodes(void) {
 6061:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6062: 
 6063:       NODE_BND(nodebnd);
 6064: 
 6065:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6066:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6067:       }
 6068: 
 6069:    }
 6070: 
 6071: 
 6072:    __global__ void setVelocityOpenBndNodes(void) {
 6073:    // For open boundary nodes sets their velocity to the imposed values.
 6074: 
 6075:       SIDE_BND(sidebnd);
 6076: 
 6077:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6078:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6079:          // to its segment to the average of the side velocity.
 6080: 
 6081:          for (int k = 0; k < nvrt; k++) {
 6082:             Node *n1 = sidebnd->side->n1;
 6083:             Node *n2 = sidebnd->side->n2;
 6084: 
 6085: 
 6086:             Vector2 n1_u2(n1->u2[k]);
 6087:             Vector2 n2_u2(n2->u2[k]);
 6088: 
 6089:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6090:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6091:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6092:             }
 6093:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6094:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6095:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6096:             }
 6097: 
 6098:          }
 6099: 
 6100:       }
 6101: 
 6102:    }
 6103: 
 6104: 
 6105:    __global__ void computeVerticalVelocity(void) {
 6106:       // Computes the vertical velocity at the (2D) element's centroid.
 6107:       // In this function we will be considering volumetric elements, with side faces and a 
 6108:       // bottom and a top face. We will call them SFs, BF and TF.
 6109:       // It computes the flux coming from BF and the SFs.
 6110:       // If the bed is moving, it takes that into account.
 6111:       // Since water is incompressible, the integral of the velocity times the normal vector
 6112:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6113:       // and the BF is equal to the flux going out from the TF.
 6114:       // TF = - BF - sum(SFs).
 6115:       // It then computes the horizontal velocity at the center of TF.
 6116:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6117:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6118:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6119: 
 6120:       ELEM(elem);
 6121: 
 6122:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6123: 
 6124:       if (elem->isDry) return;
 6125: 
 6126:       const int kb = elem->kb;
 6127:       const bool isTri = elem->isTri();
 6128: 
 6129:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6130: 
 6131:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6132:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6133:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6134: 
 6135:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6136: 
 6137:       double area3D;
 6138: 
 6139:       // Bottom face flux
 6140:       double bottomFlux = 0.0;
 6141:       Vector2 u2meanBottom = {0.0, 0.0};
 6142:       const Vector2 gradh = elem->grad2(&Node::depth);
 6143:       if constexpr(imm==2) {
 6144:          Vector3 ubed;
 6145: 
 6146:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6147:          // updateBDEF(ubed);
 6148:      
 6149:          // const double bflux0 = dot(ubed, elem_n1);
 6150: 
 6151:          // elem->w[kb] += ubed.z;
 6152:       }
 6153:       else {
 6154:          Vector2 umean;
 6155:          if constexpr(ics == 1) {
 6156:             u2meanBottom = elem->mean(kb, &Side::u2);
 6157:          }
 6158:          else {
 6159:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6160:          }
 6161: 
 6162:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6163:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6164: 
 6165:          bottomFlux = - dot(gradh, u2meanBottom);
 6166:       } // if imm
 6167: 
 6168:       // Compute w for kb+1 to nvrt-1
 6169:       for (int l = kb; l < nvrt - 1; l++) {
 6170: 
 6171:          // normal vector to the top face of the "volumetric" element (3D)
 6172:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6173: 
 6174:          // Compute the total flux at the sides
 6175:          double sideFlux = 0.0;
 6176: 
 6177:          for (int j = 0; j < elem->i34; j++) {
 6178:             const Side *side = elem->sides[j];
 6179: 
 6180:             const double sideArea = side->area(l);
 6181:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6182:             const double sign = elem->ssign[j]; 
 6183: 
 6184:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6185:          }
 6186:          
 6187:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6188:          //velocities at the centers of the sides
 6189:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6190: 
 6191:          // The flx at the top ace can be computed from the other flows.
 6192:          const double topFlux = - sideFlux - bottomFlux;
 6193:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6194: 
 6195:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6196: 
 6197:          elem_n1 = elem_n2;
 6198: 
 6199:          bottomFlux = - topFlux;
 6200:       }
 6201:    }  
 6202: 
 6203: 
 6204: 
 6205: 
 6206: 
 6207: 
 6208: 
 6209: // !===============================================================================
 6210: // !===============================================================================
 6211: 
 6212: } // extern "C"
 6213: 
 6214: #ifdef DONTCOMPILE
 6215: __device__ void computeVerticalAdvection(void) {
 6216:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6217: 
 6218:    sdbt(1:2,:,:)=0.d0
 6219: 
 6220:    const Side *side = FROM kernel;
 6221: 
 6222:    if(side->isDry) return;
 6223: 
 6224:    // If side is wet...
 6225: 
 6226: 
 6227:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6228:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6229:    double ws[nvrt] = {} // w @ side
 6230:    int icount = 0;
 6231:    for (int j=0; j<2; j++) {
 6232:       const Element *elem = side->elements[j];
 6233:        
 6234:       if(elem != nullptr) {
 6235:          icount++;
 6236:          for (int k=0; k<nvrt; k++) {
 6237:             ws[k] = ws[k] + elem->w[k];
 6238:          }
 6239:       }
 6240:    }  // for j
 6241: 
 6242:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6243:    ws = ws/icount;
 6244: 
 6245:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6246:    // Splines allow for a smooth transition between vertical levels.
 6247:    // Splines have continuity restrictions at the internal knots, but
 6248:    // we have to provide the 1st derivatives at the endpoints.
 6249:    const int kbs = side->kbs; 
 6250:    
 6251:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6252:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6253:    initCubicSpline(kbs, nvrt, side, ws, up)
 6254: 
 6255:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6256:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6257:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6258: 
 6259:    // Total advection (average onto side)
 6260:    const Node *node1 = side->nodes[0];
 6261:    const Node *node2 = side->nodes[1];
 6262:    for (int k=kbs(i); k<nvrt; k++) {
 6263: 
 6264:       if constexpr(ics==1) {
 6265:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6266:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6267:       } else {
 6268:          // XXX IMPLEMENT THIS
 6269:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6270:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6271:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6272:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6273:       }  // if ics
 6274: 
 6275: 
 6276:    }
 6277: }
 6278: #endif
 6279: 
 6280: 
 6281: extern "C" {
 6282:    __global__ void computeElemAverageGhat(void) {
 6283:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6284: 
 6285:       ELEM(elem);
 6286:       
 6287:       elem->ghat1= {0.0, 0.0};  
 6288: 
 6289:       if constexpr(ihydraulics != 0) {
 6290:          if (nhtblocks > 0 && elem->isblock) return;
 6291:       }
 6292: 
 6293: 
 6294: 
 6295:       
 6296:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6297:       // tidal potential, horizontal diffusion, and baroclinic etc
 6298:       // Remember to update both fb and F 
 6299:       // If ics=2, ghat1 are in eframe (ll)
 6300:       // cff1-3: coefficients for 2D/3D
 6301:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6302:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6303:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6304: 
 6305:       if (elem->isDry) return;
 6306: 
 6307:       double av_cff1 = 0.0;  // av. for cff1
 6308:       double av_cff2 = 0.0;  // av. for cff2
 6309:       double av_cff3 = 0.0;  // av. for cff3
 6310:       double av_df = 0.0;  // av. for H^\alpha / H
 6311:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6312:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6313: 
 6314:       const int i34 = elem->i34;
 6315:       const int kb = elem->kb;
 6316: 
 6317:       for (int j=0; j<i34; j++) {
 6318:          // For each node and side in the element...
 6319: 
 6320:          const Node *node = elem->nodes[j];
 6321:          const Side *side = elem->sides[j];
 6322: 
 6323:          const double chi      = side->chi;
 6324:          const double veg_c2   = side->veg_c2;
 6325:          const double veg_beta = side->veg_beta;
 6326:          const double veg_h    = side->veg_h();
 6327:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6328: 
 6329:          // Node - const in elem
 6330:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6331:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6332: 
 6333:          if (elem->depth >= tip_dp) {
 6334:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6335:          }
 6336: 
 6337:          
 6338:          const double htot  = side->htot2();        // Total depth at the side
 6339:          const double zctr2 = side->zTopCanopy();  
 6340: 
 6341:          double cff1; 
 6342:          double cff2; 
 6343:          double cff3;   
 6344:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6345:          // coefficients applied to 2D/3D case 
 6346:             cff1 = side->hhat/htot;
 6347:             cff2 = 0.0;
 6348:             cff3 = 0.0;
 6349:          } else { //3D
 6350:             //Init for no-veg case
 6351:             cff1 = 1.0;
 6352:             cff2 = 1.0;
 6353:             cff3 = 0.0;
 6354: 
 6355:             if constexpr(iveg != 0) {
 6356:                // Computes coefficients used with vegetation terms G1, G2
 6357:                // cff1, cff3 are used for the first two terms in G1, G2:
 6358:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6359:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6360:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6361:                if(veg_h < 0.99*htot) { // submergent vegetation
 6362:                   cff1=1;
 6363:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6364:                   cff3 = veg_c;
 6365: 
 6366:                } else { // emergent vegetation
 6367:                   cff1 = 1.0/(1.0 + veg_c2);
 6368:                   cff2 = cff1;
 6369:                   cff3 = 0.0;
 6370: 
 6371:                }
 6372:             } // if iveg
 6373:          } //  2D/3D
 6374: 
 6375:          av_cff1 += cff1/i34;
 6376:          av_cff2 += cff2/i34;
 6377:          av_cff3 += cff3/i34;
 6378:          av_cff2_chi += cff2*chi/i34;
 6379:          av_cff3_chi += cff3*chi/i34;
 6380:          av_df += min(htot, veg_h)/(htot*i34);
 6381: 
 6382: 
 6383:          // btrack values: U^\star, U^{\star\alpha}
 6384:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6385:          Vector2 Ustar       = {0.0, 0.0}; 
 6386:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6387: 
 6388:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6389:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6390:          } else { //3D
 6391:             for (int k = side->kb + 1; k < nvrt; k++) {
 6392:             
 6393:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6394:                Ustar += w2;
 6395: 
 6396:                if constexpr(iveg != 0) {
 6397:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6398:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6399:                        Ustar_alpha += zrat*w2; // XXXX
 6400:                    }
 6401:                }  // if iveg
 6402:             }  // for k
 6403:          }  //2D/3D
 6404:          
 6405: 
 6406:          // Add btrack & surface stress terms to \breve{G} first
 6407:          if constexpr(ics==1) {
 6408: 
 6409:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6410: 
 6411:          } else {
 6412:             assert(false && "computeElemAverageGhat: Not implemented");
 6413:             // XXX IMPLEMENT THIS
 6414:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6415:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6416:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6417:          }  // if ics
 6418: 
 6419:          // Surface and bottom stress terms
 6420:          if constexpr(ics==1) {
 6421:             const Vector2 tau    = side->tau();
 6422:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6423: 
 6424:             // Term for surface and bottom stress
 6425:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6426: 
 6427:          } else {
 6428:             assert(false && "computeElemAverageGhat: Not implemented");
 6429:             // XXX IMPLEMENT THIS
 6430:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6431:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6432:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6433:             // tau_x=(vn1+tt1)/2.d0
 6434:             // tau_y=(vn2+ss1)/2.d0
 6435:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6436:          }  // if ics
 6437: 
 6438:          
 6439: 
 6440:          // All terms in F,F^\alpha,f_b except baroclinic
 6441:          // F, f_b: all explicit terms excluding vegetation 
 6442:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6443:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6444:          const double coriolis = side->coriolis;
 6445:          Vector2 F  =  coriolis*side->U;  // F_x
 6446:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6447:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6448: 
 6449:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6450:             
 6451:             for (int k = side->kb; k < nvrt; k++) {
 6452:                if (zctr2 > side->zc[k-1]) {
 6453:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6454:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6455:                    Fa +=  coriolis*w2*zrat;
 6456:                } // if zctr2
 6457:             } // k
 6458:          } // iveg
 6459: 
 6460:          // Integrate horizontal viscosity force vertically
 6461:          for (int k=side->kb + 1; k<nvrt; k++) {
 6462:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6463: 
 6464:             F += levelHorVisc;
 6465: 
 6466:             // Vegetation term
 6467:             if constexpr(iveg!=0) {
 6468:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6469:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6470:                   Fa += levelHorVisc*zrat;
 6471:                } 
 6472:             } // if iveg
 6473:          } // for k
 6474: 
 6475:          fb += side->nuGradU[side->kb];
 6476: 
 6477:          // Add to ghat1
 6478:          if constexpr(ics==2) {
 6479:             assert(false && "computeElemAverageGhat: Not implemented");
 6480:             // XXX IMPLEMENT THIS
 6481:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6482:             // bigf1=vn1; bigf2=vn2
 6483:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6484:             // botf1=vn1; botf2=vn2
 6485:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6486:             // bigfa1=vn1; bigfa2=vn2
 6487:          } // if ics
 6488: 
 6489:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6490:       } // for j (nodes and sides)
 6491: 
 6492:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6493:          
 6494:       // Finish off terms in F, F^\alpha and f_b
 6495:       const double grav3 = elem->mean(&Node::grav2);
 6496:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6497: 
 6498: 
 6499:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6500:       for (int j=1; j<i34; j++) { 
 6501:          // For each side in the element...
 6502:          const Side *side = elem->sides[j];
 6503:          const double chi = side->chi;
 6504: 
 6505:          const double htot = side->htot2();
 6506:          const double veg_h = side->veg_h();
 6507:          const Vector2 F  = htot*fb;
 6508:          const Vector2 Fa = min(htot, veg_h)*fb;
 6509: 
 6510:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6511:       } // for j
 6512: 
 6513:       //botf1 etc are already in elem frame
 6514:       elem->ghat1 += tmp/i34;
 6515: 
 6516:       // Baroclinic force
 6517:       if constexpr(ibc==0) {
 6518:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6519: 
 6520:          Vector2 Fa = {0.0, 0.0};
 6521:          Vector2 intGradRho = {0.0, 0.0};
 6522:          
 6523:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6524:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6525:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6526: 
 6527:             // \in F [m^2/s/s]
 6528:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6529:          }
 6530: 
 6531:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6532:          const Vector2 F = av_df*Fa; //approx
 6533:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6534: 
 6535:       } // if ibc
 6536: 
 6537: 
 6538: 
 6539:    }
 6540: 
 6541: } // extern "C"
 6542: 
 6543: 
 6544: 
 6545: #ifdef DONTCOMPILE
 6546: __global__ void checkMassConservation(Tracers* sumtr) {
 6547: 
 6548:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6549: 
 6550:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6551: 
 6552:    Element *elem = &(mesh->localElemData[i]);
 6553: 
 6554:    // Skip dry elements
 6555:    if (elem->isDry) return;
 6556: 
 6557:    // Local sum array for this thread
 6558:    double localSum[N_TRACERS] = {0.0};
 6559: 
 6560:    // Sum over vertical levels for this element
 6561:    const int kbe = elem->kbe;
 6562:    const double area = elem->area;
 6563: 
 6564:    for (int k = kbe; k < nvrt; k++) {
 6565:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6566:       
 6567:       // Accumulate tracer mass
 6568:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6569:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6570:       }
 6571:    }
 6572: 
 6573:    //  This function returns per element sums. A reduction must be done on the host side.
 6574: }
 6575: 
 6576: 
 6577: __global__ void transport(void) {
 6578: 
 6579:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6580: 
 6581:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6582: 
 6583:    Element *elem = &(mesh->localElemData[ie]);
 6584: 
 6585:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6586: 
 6587:                for (int m=0; m<ntr; m++) {
 6588:                   for (int k=kbe(ie); k<nvrt; k++) {
 6589:                      // Calculate each polynomial's weight 
 6590:                      wm=0.d0; sum1=0.d0; 
 6591:                      wm1=0.d0; wm2=0.d0; 
 6592:                      for (int i=0; i<elem->nweno2; i++) {
 6593:                   
 6594:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6595:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6596:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6597:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6598:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6599:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6600:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6601:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6602:                      // -----------------Hu and Shu (1999)'s method----------------
 6603:                      b4=b1+b2+b3
 6604: 
 6605: //Error: add PRODUCTION CPP
 6606: #ifdef DEBUG
 6607:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6608:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6609:                     call parallel_abort(errmsg)
 6610:                   }
 6611: #endif
 6612: 
 6613:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6614:                   // !----test-------------- 
 6615:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6616:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6617:                   // !wm(i)=wm1(i)*wm2(i)
 6618:                   // !---------------------- 
 6619:                   sum1=sum1+wm(i)
 6620:                 } // end for i
 6621: 
 6622:                 wm=wm/sum1
 6623: 
 6624:                 for (int j=0; j<elem->i34; j++) {
 6625: 
 6626:                   const Side *side  = elem->sides[j];
 6627:                   const Node *node1 = side->n1;
 6628:                   const Node *node2 = side->n2;
 6629: 
 6630:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6631:                      trsd=0.d0
 6632:                      for (int kk=0; kk<nquad; kk++) {
 6633:                         for (int i=0; i<elem->nweno2; i++) {
 6634:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6635:                         } // end for i   
 6636:                      } // end for kk
 6637:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6638:                   } // outward flux
 6639:                } // end for j=1,i34(ie) ! side
 6640:             }
 6641:          }
 6642:               
 6643: 
 6644: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6645: //             //   calculate each polynomial's weight 
 6646: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6647: //                 wm=0.d0; sum1=0.d0
 6648: //                 do i=1,nweno1(ie) !for each polynomial
 6649: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6650: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6651: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6652: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6653: //                   wm(i)=b2
 6654: //                   sum1=sum1+b2
 6655: //                   !wm(i)=1.d0
 6656: //                   !sum1=sum1+1.d0
 6657: 
 6658: // // Error: PRODUCTION
 6659: // #ifdef DEBUG
 6660: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6661: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6662: //                     call parallel_abort(errmsg)
 6663: //                   endif
 6664: // #endif
 6665: 
 6666: //                 enddo !i
 6667: //                 wm=wm/sum1 !final weight
 6668: 
 6669:                 for (int j=0; j<elem->i34; j++) { // side
 6670:                   const Side *side = elem->sides[j];
 6671:                   const Node *node1 = side->n1;
 6672:                   const Node *node2 = side->n2;
 6673: 
 6674:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6675:                     trsd=0.d0
 6676:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6677:                       for (int i=0; i<elem->nweno1; i++) {
 6678:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6679:                       }
 6680:                     enddo //kk
 6681:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6682:                   } // outward flux
 6683:                 } // end for j=1,i34(ie) ! side
 6684:               } // end for k; ntr 
 6685: 
 6686:             else !simple upwind method
 6687:               do j=1,i34(ie)
 6688:                 jsj=elside(j,ie)
 6689:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6690:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6691:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6692:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6693:                   endif
 6694:                 enddo  !vertical layers
 6695:               enddo !j=1,i34(ie) ! side
 6696:             endif !order of accuracy
 6697: 
 6698:          //  enddo !ie
 6699: // !$OMP     end do
 6700: 
