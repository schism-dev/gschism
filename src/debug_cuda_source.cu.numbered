 2120:    template<typename T>
 2121:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2122:       // Get the values of the field at the nodes of the element
 2123:       res[0] = nodes[0]->*field;
 2124:       res[1] = nodes[1]->*field;
 2125:       res[2] = nodes[2]->*field;
 2126:       if (isQuad()) res[3] = nodes[3]->*field;
 2127:       else          res[3] = T();
 2128:    }
 2129: 
 2130:    template<typename T>
 2131:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2132: 
 2133:       assert(level < nvrt && "Level is out of range");
 2134:       // Get the values of the field at the nodes of the element
 2135:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2136:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2137:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2138:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2139:       else          res[3] = T();
 2140:    }    
 2141: 
 2142:    template<typename T>
 2143:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2144: 
 2145:       assert(level < nvrt && "Level is out of range");
 2146: 
 2147:       // Get the values of the func at the nodes of the element
 2148:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2149:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2150:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2151:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2152:       else          res[3] = T();  // This is 0.0 or a zero vector
 2153: 
 2154:    }      
