 2304: __device__ void lock(int *mutex) {
 2305:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2306: }
 2307: 
 2308: __device__ void unlock(int *mutex) {
 2309:     atomicExch(mutex, 0);
 2310: }
