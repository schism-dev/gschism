 7158: __global__ void returnMatrix(double *res) {
 7159:    // Debugging: returns the matrix as a CuPy array
 7160: 
 7161:    const int size = mesh->np;
 7162:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7163:       const Node *node = mesh->localNodeData + idx_node;
 7164:       res[idx_node*size + idx_node] = node->coeffDiag;
 7165:       for (int j = 0; j < node->numNodes; j++) {
 7166:          Node* nbNode = node->nodes[j];
 7167:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7168:       }
 7169: 
 7170:    }
 7171:    
 7172: }
