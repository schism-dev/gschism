10333: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
10334:    // Packed local order into res. Caller allocates sizePart * nbytes.
10335:    NODE(node);
10336: 
10337:    switch (varCode) {
10338:       case (int)VarCode::outputCoords: {
10339:          const Point2 coords = node->outputCoords();
10340:          double *out = (double *)((char *)res + idx_node * 16);
10341:          out[0] = coords.x;
10342:          out[1] = coords.y;
10343:          break;
10344:       }
10345:       case (int)VarCode::depth:
10346:          *(double *)((char *)res + idx_node * 8) = node->depth;
10347:          break;
10348:       case (int)VarCode::kb:
10349:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
10350:          break;
10351:       case (int)VarCode::eta:
10352:          *(double *)((char *)res + idx_node * 8) = node->eta2;
10353:          break;
10354:       case (int)VarCode::u_air: {
10355:          double *out = (double *)((char *)res + idx_node * 16);
10356:          out[0] = node->u_air.x;
10357:          out[1] = node->u_air.y;
10358:          break;
10359:       }
10360:       case (int)VarCode::isdry:
10361:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
10362:          break;
10363:       case (int)VarCode::u: {
10364:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
10365:          if (k >= 0) {
10366:             out[0] = node->u2[k].x;
10367:             out[1] = node->u2[k].y;
10368:          } else {
10369:             for (int lev = 0; lev < nvrt; lev++) {
10370:                out[lev*2    ] = node->u2[lev].x;
10371:                out[lev*2 + 1] = node->u2[lev].y;
10372:             }
10373:          }
10374:          break;
10375:       }
10376:       case (int)VarCode::z: {
10377:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10378:          if (k >= 0)
10379:             out[0] = node->z[k];
10380:          else
10381:             for (int lev = 0; lev < nvrt; lev++)
10382:                out[lev] = node->z[lev];
10383:          break;
10384:       }
10385:       case (int)VarCode::w: {
10386:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10387:          if (k >= 0)
10388:             out[0] = node->w2[k];
10389:          else
10390:             for (int lev = 0; lev < nvrt; lev++)
10391:                out[lev] = node->w2[lev];
10392:          break;
10393:       }
10394:       case (int)VarCode::dfh: {
10395:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10396:          if (k >= 0)
10397:             out[0] = node->dfh[k];
10398:          else
10399:             for (int lev = 0; lev < nvrt; lev++)
10400:                out[lev] = node->dfh[lev];
10401:          break;
10402:       }
10403:       case (int)VarCode::dfv: {
10404:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10405:          if (k >= 0)
10406:             out[0] = node->dfv[k];
10407:          else
10408:             for (int lev = 0; lev < nvrt; lev++)
10409:                out[lev] = node->dfv[lev];
10410:          break;
10411:       }
10412:       case (int)VarCode::tke: {
10413:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10414:          if (k >= 0)
10415:             out[0] = getTKE(node->turb, k);
10416:          else
10417:             for (int lev = 0; lev < nvrt; lev++)
10418:                out[lev] = getTKE(node->turb, lev);
10419:          break;
10420:       }
10421:       case (int)VarCode::mxl: {
10422:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
10423:          if (k >= 0)
10424:             out[0] = getMXL(node->turb, k);
10425:          else
10426:             for (int lev = 0; lev < nvrt; lev++)
10427:                out[lev] = getMXL(node->turb, lev);
10428:          break;
10429:       }
10430:    }
10431: }
10432: 
