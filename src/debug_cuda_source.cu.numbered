 5202:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5203: 
 5204:       NODE(node);
 5205: 
 5206:       node->ETP = 0.0;
 5207: 
 5208:       if constexpr(ntip == 0) return;
 5209: 
 5210:       // For all tidal potential components
 5211:       for (int j=0; j<ntip; j++) {
 5212: 
 5213:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5214: 
 5215:          node->ETP += nodeETP;
 5216: 
 5217:          if constexpr(iloadtide==1) { // loading tide
 5218:             assert(false && "Loading tide not implemented");
 5219:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5220:          }
 5221:          
 5222:       }
 5223: 
 5224:      
 5225:    }
