 6813: 
 6814: extern "C" {
 6815:    __global__ void computeElemAverageGhat(void) {
 6816:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6817: 
 6818:       ELEM(elem);
 6819:       
 6820:       elem->ghat1= {0.0, 0.0};  
 6821: 
 6822:       if constexpr(ihydraulics != 0) {
 6823:          if (nhtblocks > 0 && elem->isblock) return;
 6824:       }
 6825: 
 6826: 
 6827: 
 6828:       
 6829:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6830:       // tidal potential, horizontal diffusion, and baroclinic etc
 6831:       // Remember to update both fb and F 
 6832:       // If ics=2, ghat1 are in eframe (ll)
 6833:       // cff1-3: coefficients for 2D/3D
 6834:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6835:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6836:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6837: 
 6838:       if (elem->isDry) return;
 6839: 
 6840:       double av_cff1 = 0.0;  // av. for cff1
 6841:       double av_cff2 = 0.0;  // av. for cff2
 6842:       double av_cff3 = 0.0;  // av. for cff3
 6843:       double av_df = 0.0;  // av. for H^\alpha / H
 6844:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6845:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6846: 
 6847:       const int i34 = elem->i34;
 6848:       const int kb = elem->kb;
 6849: 
 6850:       for (int j=0; j<i34; j++) {
 6851:          // For each node and side in the element...
 6852: 
 6853:          const Node *node = elem->nodes[j];
 6854:          const Side *side = elem->sides[j];
 6855: 
 6856:          const double chi      = side->chi;
 6857:          const double veg_c2   = side->veg_c2;
 6858:          const double veg_beta = side->veg_beta;
 6859:          const double veg_h    = side->veg_h();
 6860:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6861: 
 6862:          // Node - const in elem
 6863:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6864:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6865: 
 6866:          if (elem->depth >= tip_dp) {
 6867:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6868:          }
 6869: 
 6870:          
 6871:          const double htot  = side->htot2();        // Total depth at the side
 6872:          const double zctr2 = side->zTopCanopy();  
 6873: 
 6874:          double cff1; 
 6875:          double cff2; 
 6876:          double cff3;   
 6877:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6878:          // coefficients applied to 2D/3D case 
 6879:             cff1 = side->hhat/htot;
 6880:             cff2 = 0.0;
 6881:             cff3 = 0.0;
 6882:          } else { //3D
 6883:             //Init for no-veg case
 6884:             cff1 = 1.0;
 6885:             cff2 = 1.0;
 6886:             cff3 = 0.0;
 6887: 
 6888:             if constexpr(iveg != 0) {
 6889:                // Computes coefficients used with vegetation terms G1, G2
 6890:                // cff1, cff3 are used for the first two terms in G1, G2:
 6891:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6892:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6893:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6894:                if(veg_h < 0.99*htot) { // submergent vegetation
 6895:                   cff1=1;
 6896:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6897:                   cff3 = veg_c;
 6898: 
 6899:                } else { // emergent vegetation
 6900:                   cff1 = 1.0/(1.0 + veg_c2);
 6901:                   cff2 = cff1;
 6902:                   cff3 = 0.0;
 6903: 
 6904:                }
 6905:             } // if iveg
 6906:          } //  2D/3D
 6907: 
 6908:          av_cff1 += cff1/i34;
 6909:          av_cff2 += cff2/i34;
 6910:          av_cff3 += cff3/i34;
 6911:          av_cff2_chi += cff2*chi/i34;
 6912:          av_cff3_chi += cff3*chi/i34;
 6913:          av_df += min(htot, veg_h)/(htot*i34);
 6914: 
 6915: 
 6916:          // btrack values: U^\star, U^{\star\alpha}
 6917:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6918:          Vector2 Ustar       = {0.0, 0.0}; 
 6919:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6920: 
 6921:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6922:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6923:          } else { //3D
 6924:             for (int k = side->kb + 1; k < nvrt; k++) {
 6925:             
 6926:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6927:                Ustar += w2;
 6928: 
 6929:                if constexpr(iveg != 0) {
 6930:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6931:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6932:                        Ustar_alpha += zrat*w2; // XXXX
 6933:                    }
 6934:                }  // if iveg
 6935:             }  // for k
 6936:          }  //2D/3D
 6937:          
 6938: 
 6939:          // Add btrack & surface stress terms to \breve{G} first
 6940:          if constexpr(ics==1) {
 6941: 
 6942:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6943: 
 6944:          } else {
 6945:             assert(false && "computeElemAverageGhat: Not implemented");
 6946:             // XXX IMPLEMENT THIS
 6947:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6948:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6949:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6950:          }  // if ics
 6951: 
 6952:          // Surface and bottom stress terms
 6953:          if constexpr(ics==1) {
 6954:             const Vector2 tau    = side->tau();
 6955:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6956: 
 6957:             // Term for surface and bottom stress
 6958:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6959: 
 6960:          } else {
 6961:             assert(false && "computeElemAverageGhat: Not implemented");
 6962:             // XXX IMPLEMENT THIS
 6963:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6964:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6965:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6966:             // tau_x=(vn1+tt1)/2.d0
 6967:             // tau_y=(vn2+ss1)/2.d0
 6968:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6969:          }  // if ics
 6970: 
 6971:          
 6972: 
 6973:          // All terms in F,F^\alpha,f_b except baroclinic
 6974:          // F, f_b: all explicit terms excluding vegetation 
 6975:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6976:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6977:          const double coriolis = side->coriolis;
 6978:          Vector2 F  =  coriolis*side->U;  // F_x
 6979:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6980:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6981: 
 6982:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6983:             
 6984:             for (int k = side->kb; k < nvrt; k++) {
 6985:                if (zctr2 > side->zc[k-1]) {
 6986:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6987:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6988:                    Fa +=  coriolis*w2*zrat;
 6989:                } // if zctr2
 6990:             } // k
 6991:          } // iveg
 6992: 
 6993:          // Integrate horizontal viscosity force vertically
 6994:          for (int k=side->kb + 1; k<nvrt; k++) {
 6995:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6996: 
 6997:             F += levelHorVisc;
 6998: 
 6999:             // Vegetation term
 7000:             if constexpr(iveg!=0) {
 7001:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7002:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7003:                   Fa += levelHorVisc*zrat;
 7004:                } 
 7005:             } // if iveg
 7006:          } // for k
 7007: 
 7008:          fb += side->nuGradU[side->kb];
 7009: 
 7010:          // Add to ghat1
 7011:          if constexpr(ics==2) {
 7012:             assert(false && "computeElemAverageGhat: Not implemented");
 7013:             // XXX IMPLEMENT THIS
 7014:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7015:             // bigf1=vn1; bigf2=vn2
 7016:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7017:             // botf1=vn1; botf2=vn2
 7018:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7019:             // bigfa1=vn1; bigfa2=vn2
 7020:          } // if ics
 7021: 
 7022:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7023:       } // for j (nodes and sides)
 7024: 
 7025:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7026:          
 7027:       // Finish off terms in F, F^\alpha and f_b
 7028:       const double grav3 = elem->mean(&Node::grav2);
 7029:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7030: 
 7031: 
 7032:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7033:       for (int j=1; j<i34; j++) { 
 7034:          // For each side in the element...
 7035:          const Side *side = elem->sides[j];
 7036:          const double chi = side->chi;
 7037: 
 7038:          const double htot = side->htot2();
 7039:          const double veg_h = side->veg_h();
 7040:          const Vector2 F  = htot*fb;
 7041:          const Vector2 Fa = min(htot, veg_h)*fb;
 7042: 
 7043:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7044:       } // for j
 7045: 
 7046:       //botf1 etc are already in elem frame
 7047:       elem->ghat1 += tmp/i34;
 7048: 
 7049:       // Baroclinic force
 7050:       if constexpr(ibc==0) {
 7051:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7052: 
 7053:          Vector2 Fa = {0.0, 0.0};
 7054:          Vector2 intGradRho = {0.0, 0.0};
 7055:          
 7056:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7057:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7058:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7059: 
 7060:             // \in F [m^2/s/s]
 7061:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7062:          }
 7063: 
 7064:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7065:          const Vector2 F = av_df*Fa; //approx
 7066:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7067: 
 7068:       } // if ibc
 7069: 
 7070: 
 7071: 
 7072:    }
 7073: 
 7074: } // extern "C"
 7075: 
 7076: 
 7077: 
 7078: #ifdef DONTCOMPILE
 7079: __global__ void checkMassConservation(Tracers* sumtr) {
 7080: 
 7081:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7082: 
 7083:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7084: 
 7085:    Element *elem = &(mesh->localElemData[i]);
 7086: 
 7087:    // Skip dry elements
 7088:    if (elem->isDry) return;
 7089: 
 7090:    // Local sum array for this thread
 7091:    double localSum[N_TRACERS] = {0.0};
 7092: 
 7093:    // Sum over vertical levels for this element
 7094:    const int kbe = elem->kbe;
 7095:    const double area = elem->area;
 7096: 
 7097:    for (int k = kbe; k < nvrt; k++) {
 7098:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7099:       
 7100:       // Accumulate tracer mass
 7101:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7102:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7103:       }
 7104:    }
 7105: 
 7106:    //  This function returns per element sums. A reduction must be done on the host side.
 7107: }
 7108: 
 7109: 
 7110: __global__ void transport(void) {
 7111: 
 7112:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7113: 
 7114:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7115: 
 7116:    Element *elem = &(mesh->localElemData[ie]);
 7117: 
 7118:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7119: 
 7120:                for (int m=0; m<ntr; m++) {
 7121:                   for (int k=kbe(ie); k<nvrt; k++) {
 7122:                      // Calculate each polynomial's weight 
 7123:                      wm=0.d0; sum1=0.d0; 
 7124:                      wm1=0.d0; wm2=0.d0; 
 7125:                      for (int i=0; i<elem->nweno2; i++) {
 7126:                   
 7127:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7128:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7129:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7130:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7131:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7132:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7133:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7134:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7135:                      // -----------------Hu and Shu (1999)'s method----------------
 7136:                      b4=b1+b2+b3
 7137: 
 7138: //Error: add PRODUCTION CPP
 7139: #ifdef DEBUG
 7140:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7141:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7142:                     call parallel_abort(errmsg)
 7143:                   }
 7144: #endif
 7145: 
 7146:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7147:                   // !----test-------------- 
 7148:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7149:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7150:                   // !wm(i)=wm1(i)*wm2(i)
 7151:                   // !---------------------- 
 7152:                   sum1=sum1+wm(i)
 7153:                 } // end for i
 7154: 
 7155:                 wm=wm/sum1
 7156: 
 7157:                 for (int j=0; j<elem->i34; j++) {
 7158: 
 7159:                   const Side *side  = elem->sides[j];
 7160:                   const Node *node1 = side->n1;
 7161:                   const Node *node2 = side->n2;
 7162: 
 7163:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7164:                      trsd=0.d0
 7165:                      for (int kk=0; kk<nquad; kk++) {
 7166:                         for (int i=0; i<elem->nweno2; i++) {
 7167:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7168:                         } // end for i   
 7169:                      } // end for kk
 7170:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7171:                   } // outward flux
 7172:                } // end for j=1,i34(ie) ! side
 7173:             }
 7174:          }
 7175:               
 7176: 
 7177: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7178: //             //   calculate each polynomial's weight 
 7179: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7180: //                 wm=0.d0; sum1=0.d0
 7181: //                 do i=1,nweno1(ie) !for each polynomial
 7182: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7183: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7184: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7185: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7186: //                   wm(i)=b2
 7187: //                   sum1=sum1+b2
 7188: //                   !wm(i)=1.d0
 7189: //                   !sum1=sum1+1.d0
 7190: 
 7191: // // Error: PRODUCTION
 7192: // #ifdef DEBUG
 7193: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7194: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7195: //                     call parallel_abort(errmsg)
 7196: //                   endif
 7197: // #endif
 7198: 
 7199: //                 enddo !i
 7200: //                 wm=wm/sum1 !final weight
 7201: 
 7202:                 for (int j=0; j<elem->i34; j++) { // side
 7203:                   const Side *side = elem->sides[j];
 7204:                   const Node *node1 = side->n1;
 7205:                   const Node *node2 = side->n2;
 7206: 
 7207:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7208:                     trsd=0.d0
 7209:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7210:                       for (int i=0; i<elem->nweno1; i++) {
 7211:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7212:                       }
 7213:                     enddo //kk
 7214:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7215:                   } // outward flux
 7216:                 } // end for j=1,i34(ie) ! side
 7217:               } // end for k; ntr 
 7218: 
 7219:             else !simple upwind method
 7220:               do j=1,i34(ie)
 7221:                 jsj=elside(j,ie)
 7222:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7223:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7224:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7225:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7226:                   endif
 7227:                 enddo  !vertical layers
 7228:               enddo !j=1,i34(ie) ! side
 7229:             endif !order of accuracy
 7230: 
 7231:          //  enddo !ie
 7232: // !$OMP     end do
 7233: 
 7234: // !$OMP     master
 7235: //           !message passing
 7236: //           if (nproc>1) then
 7237: //             !make a copy of side concentrations
 7238: //             trsd_tmp0=trsd_tmp 
 7239: 
 7240: //             !this exchange routine swaps interface concentration between two partitions
 7241: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7242: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7243: 
 7244: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7245: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7246: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7247: 
