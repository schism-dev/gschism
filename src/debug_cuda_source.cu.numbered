 1692: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1693:    // Computes the 3D normal vector to the element at level k
 1694:    // Returns the normal vector and the area of the element
 1695: 
 1696:       if (isTri()) {
 1697:          // For triangles...
 1698: 
 1699:          // Gets the normal vector to the element (with a length equal to twice the area)
 1700:          if constexpr(ics==1) {
 1701:             const int kb0 = max(k, nodes[0]->kb);
 1702:             const int kb1 = max(k, nodes[1]->kb);
 1703:             const int kb2 = max(k, nodes[2]->kb);
 1704: 
 1705:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1706:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1707:             
 1708:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1709:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1710:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1711:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1712: 
 1713:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1714:             area3D = 0.5*len;
 1715: 
 1716:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1717: 
 1718:             return {nx/len, ny/len, nz/len};
 1719: 
 1720:            
 1721:          }
 1722:          else {  // lat/lon
 1723:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1724: 
 1725:          } // if ics
 1726:       }
 1727:       else {
 1728:          // For quads...
 1729: 
 1730:          assert(false && "Element normal vector: quads not yet implemented");
 1731: 
 1732: 
 1733:       }
 1734:    }
 1735: 
 1736: /**
 1737:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1738:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1739:    If the segment is completely inside the element, then it returns true.
 1740: 
 1741:    This function assumes:
 1742:    - The initial point is on a side of the element. 
 1743:    - Its position is given by parameter t in the range [0,1].
 1744:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1745:       intersects the element (elements are convex).
 1746: 
 1747:    To find the intersection point, this function does the following:
 1748:    - it finds the intersection of the line segment with all the element side lines,
 1749:       except for the one that contains the initial point.
 1750:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1751:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1752:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1753:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1754:       track segment is almost parallel to the element side line.
 1755: 
 1756:    Inputs:
 1757:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1758:    @param x2, y2: other end of the line segment
 1759: 
 1760:    Outputs:
 1761:    @param side:  side that intersects the line segment (input and output)
 1762:    @param nextElement (output): element that contains the intersection point
 1763:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1764:    @param zint (input/output): Vertical coordinate of the intersection point
 1765: 
 1766:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1767:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1768:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1769: 
 1770:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1771:    (Delta) being zero.
 1772: 
 1773:    The intersection2 point happens when:
 1774:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1775:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1776:    
 1777:    Assumption: the 4 points (including those of the side segment) are different.
 1778:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1779:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1780:    If true, (xIntersect,yIntersect) is the intersection.				
 1781:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1782: **/
 1783: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1784:                                               double &t, double& tIntersect) {
 1785: 
 1786:    double closest_intersect_t = 1e10;
 1787:    bool found_intersection = false;
 1788: 
 1789:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1790:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1791:    const Point2 x1 = side->point(t);
 1792:    
 1793: 
 1794:    Side *nextSide = nullptr;
 1795:    for (int i = 0; i < i34; i++) {
 1796: 
 1797:       // Element's i-th side 
 1798:       Side *side2 = sides[i];
 1799: 
 1800:       // Skip the side that contains the initial point
 1801:       if (side2 == side) continue;
 1802: 
 1803:       // (x3,y3)-(x4,y4) is the element side line
 1804:       const Point2 x3 = side2->n1->p2();
 1805:       const Point2 x4 = side2->n2->p2();
 1806: 
 1807:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1808:       const double delta = cross(x2 - x1, x3 - x4);
 1809: 
 1810:       if (delta != 0.0) {
 1811: 
 1812:          const double delta1 = cross(x3 - x1, x3 - x4);
 1813:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1814: 
 1815:          // Solves the two linear equations for tt1 and tt2
 1816:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1817:          const double tt2 = delta2/delta;
 1818: 
 1819:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1820:             closest_intersect_t = min(closest_intersect_t, tt1);
 1821:             nextSide = side2;
 1822: 
 1823:             nextElement = nextSide->otherElem(this);
 1824:             tIntersect = max(small, min(tt1, 1.0-small));
 1825:             t = tt2;
 1826: 
 1827:             found_intersection = true;
 1828:          }
 1829:       
 1830:       }
 1831: 
 1832:    }
 1833: 
 1834:    // found_intersection should always be true, since we checked all the sides.  
 1835:    side = nextSide;
 1836: 
 1837:    return found_intersection;
 1838: }
 1839: 
 1840: 
 1841: 
 1842: 
 1843: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1844:                                               double &t, double& tIntersect) {
 1845: 
 1846:    double closest_intersect_t = 1e10;
 1847:    bool found_intersection = false;
 1848: 
 1849:    for (int i = 0; i < i34; i++) {
 1850: 
 1851:       Side *side2 = sides[i];
 1852: 
 1853:       // (x3,y3)-(x4,y4) is the element side line
 1854:       const Point2 x3 = side2->n1->p2();
 1855:       const Point2 x4 = side2->n2->p2();
 1856: 
 1857:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1858:       const double delta = cross(x2 - x1, x3 - x4);
 1859: 
 1860:       if (abs(delta) > 0) {
 1861: 
 1862:          const double delta1 = cross(x3 - x1, x3 - x4);
 1863:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1864: 
 1865:          // Solves the two linear equations for tt1 and tt2
 1866:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1867:          const double tt2 = delta2/delta;
 1868: 
 1869:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1870:             closest_intersect_t = min(closest_intersect_t, tt1);
 1871:             side = side2;
 1872:             nextElement = side->otherElem(this);
 1873:             t = tt2;
 1874:             tIntersect = max(small, min(tt1, 1.0-small));
 1875:             found_intersection = true;
 1876:          }
 1877:       
 1878:       }
 1879:       else {  // parallel segments
 1880:          assert(false && "Parallel segments");
 1881:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1882:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1883: 
 1884:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1885: 
 1886:          // const double dist = dot(x1 - x3, side2->n);
 1887:          // if (abs(dist) < small*length(x3 - x4)) {
 1888:          //    const double2 unitarySide = normalize(x4 - x3);
 1889:          //    const double len = dot(x2 - x1, unitarySide);
 1890:          //    t = t + len;
 1891:          //    t = max(0.0, min(t, 1.0));
 1892:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1893: 
 1894: 
 1895:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1896:          //    // t = tt2;
 1897:          //    found_intersection = true;
 1898:          // }
 1899:       }
 1900: 
 1901: 
 1902:    }
 1903: 
 1904:       
 1905:    assert(found_intersection && "No intersection found");
 1906: 
 1907:    // found_intersection should always be true, since we checked all the sides.  
 1908:    return found_intersection;
 1909: }
 1910: 
 1911: 
 1912: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1913:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1914: 
 1915:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1916: 
 1917:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1918:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1919:    // curElement.
 1920: 
 1921:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1922:    // And uses this velocity instead to continue the tracking.
 1923: 
 1924:    // computes the intersection point in cartesian coordinates
 1925:    Point2 intersection = nextSide->p_t(tt);
 1926: 
 1927:    // Nudges the point to the barycenter of the element. 
 1928:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1929:    // next segment intersects the element sides.  
 1930:    curElem->nudgeToBarycenter(intersection);
 1931: 
 1932:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1933:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1934:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1935:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1936: 
 1937:    // If the side is an open boundary, the tangential velocity is zero.
 1938:    if (nextSide->isBnd()) vtan = 0.0;
 1939: 
 1940:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1941:    const double us = vtan*nextSide->t().x;
 1942:    const double vs = vtan*nextSide->t().y;
 1943:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1944: 
 1945:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1946:    const double len2 = norm2(intersection - toPoint2(xt));
 1947:    const double vel2 = dot(u_int, u_int);        
 1948:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1949:    else            dt = 0.0;
 1950: 
 1951:    // The end of this tracking segment is now the intersection point.
 1952:    xt = {intersection.x, intersection.y, zint};
 1953: 
 1954:    u_int = {us, vs, ws};
 1955:    
 1956: }
 1957: 
 1958: /**
 1959:  * Tracks a particle through elements and vertical levels in the mesh.
 1960:  * 
 1961:  * @param x0,y0,z0     Starting position coordinates
 1962:  * @param xt,yt,zt     Target position coordinates
 1963:  * @param dtb          Time step for tracking
 1964:  * @param uuint,vvint,wwint Initial velocity components
 1965:  * @param nextElem     Starting/resulting element index
 1966:  * 
 1967:  * @return Status code of type trackExitCodes
 1968:  * 
 1969:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1970:  * of the details are different. The idea is that the code requires less branches and is better fit
 1971:  * for GPU execution.
 1972:  * 
 1973:  * The main ideas here are:
 1974:  * - The starting point is expected to be in the starting element.
 1975:  * - The end point is guaranteed to be inside an element.
 1976:  * - since the starting point is inside the element, there are only two cases: 
 1977:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1978:  *     (b) it does not and (xt,yt) is already in the starting element.
 1979:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1980:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1981:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1982:  * - tt1 can be positive or negative. We only consider the positive values.
 1983:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1984:  * - The next intersection will occur at the smallest positive tt1.
 1985:  * - This intersection will be the next (x0,y0) position.
 1986:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1987:  *   of getting stuck in a loop.
 1988:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1989:  *   was found.
 1990:  */
 1991: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1992:                                                        Element *&nextElem, int &jlev, double &dt,
 1993:                                                        const Side *origSide) {
 1994: 
 1995: 
 1996: 
 1997:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1998:    // else to do.
 1999:    // If it is, nudges the point to be inside the element.
 2000:    const Element *curElem = nextElem;
 2001:    if (containsPoint(toPoint2(xt), true)) {
 2002: 
 2003:       curElem->interpolateVelocities(xt, u_int);
 2004: 
 2005: addDebugPlot(x0, xt);
 2006:       return true;
 2007:    }
 2008: 
 2009:    Side *side = nullptr;
 2010: 
 2011:    // 1. Initial checks
 2012:    // Verify starting element is valid (wet)
 2013:    assert(!curElem->isDry && "Starting element is dry");
 2014: 
 2015:    // Checks if track has a zero length.
 2016:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2017:    // assert(len2 > 0.0 && "Zero length track"); 
 2018:    
 2019:    const int MAX_ITERATIONS = 1000;
 2020:    
 2021:    double t;
 2022:    Side *nextSide = nullptr;
 2023:    double tIntersect = 1e10;
 2024:    double zint = x0.z;
 2025: 
 2026:    // Horizontal tracking loop
 2027:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2028:    // (x0,y0) is inside the element but the target point is not.
 2029: 
 2030:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2031: 
 2032:    assert(found_intersection && "No intersection found at %d");
 2033: 
 2034:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2035: 
 2036:    // if the tracking segment goes out of water (either dry or edge boundary)
 2037:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2038: 
 2039: addDebugPlot(x0, xt, 0x00A0FF);
 2040:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2041: addDebugPlot(x0, xt, 0x00A0FF);      
 2042: 
 2043:       nextElem = this;
 2044:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2045:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2046:       return true;    
 2047:    }
 2048: 
 2049: 
 2050:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2051:    int iterations = 0;
 2052:    while (iterations < MAX_ITERATIONS) {
 2053:       iterations++;
 2054:       
 2055:       Element *curElem = nextElem;
 2056: 
 2057:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2058: addDebugPlot(x0, xt);
 2059:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2060: 
 2061:       // If we are already in the target element, we are done.
 2062:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2063:       if (!found_intersection) break;
 2064: 
 2065: 
 2066: 
 2067:       // if the tracking segment goes out of water (either dry or edge boundary).
 2068:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2069: addDebugPlot(x0, xt, 0x00A0FF);
 2070:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2071: addDebugPlot(x0, xt, 0x00A0FF);   
 2072:          nextElem = curElem;
 2073: 
 2074:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2075:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2076:          return true;
 2077:       }
 2078:       
 2079:       // Update position and element for next iteration
 2080:       side = nextSide;
 2081: 
 2082:    }
 2083: 
 2084:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2085: 
 2086:  
 2087:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2088:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2089: addDebugPlot(x0, xt);   
 2090:    nextElem->interpolateVelocities(xt, u_int); 
 2091: 
 2092:    return true;
 2093: }
 2094: 
 2095: 
 2096: __inline__ __device__ double Element::computeSignedArea(void) const {
 2097:    // Compute the area of the element
 2098: 
 2099:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2100: 
 2101:    // In the quad case we need to add the area of the other triangle.
 2102:    if (isQuad()) {
 2103:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2104:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2105:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2106:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2107: 
 2108:       res += ar1;
 2109:    }
 2110: 
 2111:    return res;
 2112: }
 2113: 
 2114: 
 2115: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2116:                                                                 (nodes[1]->isDry2()) ||
 2117:                                                                 (nodes[2]->isDry2()) ||
 2118:                                                                 (i34==4 && nodes[3]->isDry2());
 2119: }
 2120: 
 2121: __inline__ __device__ double Element::detJ_eta(void) const {
 2122:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2123:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2124: }
 2125: 
 2126: __inline__ __device__ double Element::detJ_xi(void) const {
 2127:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2128:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2129: }
 2130: 
 2131: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2132:    // In boundary sides, the element 1 is nullptr
 2133:    return side->elems[1] == nullptr; 
 2134: }
