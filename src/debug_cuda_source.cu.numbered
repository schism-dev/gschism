 1604:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1605:       // Compute the different time ramps used in the code 
 1606:       // This function is performed by just one thread
 1607: 
 1608:       rampbc = 1.0;
 1609:       if constexpr(ibc == 0) {
 1610:          if (drampbc > 0.0) {
 1611:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1612:          } else {
 1613:             rampbc = 1.0;
 1614:          }
 1615:       }
 1616: 
 1617:       if (nws != 0) {
 1618:          if (drampwind > 0.0) {
 1619:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1620:          } else {
 1621:             rampwind = 1.0;
 1622:          }
 1623:       }
 1624: 
 1625:       if (drampwafo > 0.0) {
 1626:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1627:       } else {
 1628:          rampwafo = 1.0;
 1629:       }
 1630: 
 1631:       // For source/sinks
 1632:       if (if_source && dramp_ss > 0.0) {
 1633:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1634:       } else {
 1635:          ramp_ss = 1.0;
 1636:       }
 1637: 
 1638:       if (dramp > 0.0) {
 1639:          ramp = tanh(2.0*time/86400.0/dramp);
 1640:       } else {
 1641:          ramp = 1.0;
 1642:       }
 1643: 
 1644: 
 1645:    }
