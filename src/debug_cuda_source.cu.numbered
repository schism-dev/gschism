 1119: struct SideBoundary {
 1120:    Side *side; // Pointer to the side that this boundary segment belongs to
 1121:    BoundarySegment *segment; // Pointer to the boundary segment
 1122: 
 1123:    Side *leftSide, *rightSide; // Pointers to the left and right sides of the boundary segment
 1124: 
 1125:    Vector2 ubc[nvrt]; // velocity boundary condition
 1126:    
 1127:    __inline__ __device__ double getBoundaryArrayValueWeight(void) const;
 1128: 
 1129:    __inline__ __device__ double etaMeanBnd(void) const;
 1130: 
 1131:    __inline__ __device__ Vector2 umo (int jfr) const;
 1132:    __inline__ __device__ Vector2 ufa (int jfr) const;  
 1133:    __inline__ __device__ Vector2 uth (int k) const;
 1134:    __inline__ __device__ double  nuth(int k) const;
 1135:    __inline__ __device__ double  eth (int k) const;
 1136: };
