 2770: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2771:                 double *node_coords, double *wind_rotate_angle, 
 2772:                 int *isdel, int *isidenode, int *isbnd,
 2773:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2774:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2775:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2776:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2777:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2778:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2779:                 double *emo, double *efa, 
 2780:                 double *umo, double *ufa, 
 2781:                 double *vmo, double *vfa) {
 2782: 
 2783:    printf("Populating mesh for partition %d\n", partNum);
 2784: 
 2785:    // Horizontal grid
 2786:    printf("Processing %d nodes\n", np);    
 2787: 
 2788: 
 2789:    int idxNodeBoundary = 0;  
 2790:    for (int i = 0; i < np; i++)
 2791:    {
 2792:       Node &node = localNodeData[i];
 2793: 
 2794:       node.idx = i;
 2795: 
 2796:       const int idxNodeStart = nodeNeighNodesStart[i];
 2797:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2798:       node.numNodes = idxNodeEnd - idxNodeStart;
 2799:       node.nodes = nodeNeighNodes + idxNodeStart;
 2800:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2801: 
 2802: 
 2803: 
 2804:       const int idxElemStart = nodeNeighElemsStart[i];
 2805:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2806:       node.numElements = idxElemEnd - idxElemStart;
 2807:       node.elements = nodeNeighElems + idxElemStart;
 2808: 
 2809: 
 2810:       
 2811:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2812:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2813:          const int partNode = localNodePart[idxNodeGlobal]; 
 2814:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2815: 
 2816: 
 2817:          Node *node_ptr = nodes[partNode] + idxNode;
 2818:          
 2819:          nodeNeighNodes[idx] = node_ptr;
 2820:       }
 2821: 
 2822:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2823:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2824:          const int partElem = localElemPart[idxElemGlobal];
 2825:          const int idxElem  = localElemIndices[idxElemGlobal];
 2826: 
 2827:          Element *elem_ptr = elems[partElem] + idxElem;
 2828: 
 2829:          nodeNeighElems[idx] = elem_ptr;
 2830:       }      
 2831: 
 2832: 
 2833:       node.wind_angle = wind_rotate_angle[i];
 2834: 
 2835:       // Element **elements; // pointer to the elements connected to this node
 2836:       // int numElements;   // number of elements shared by this node
 2837: 
 2838:       node.p.x   = node_coords[i * 3];
 2839:       node.p.y   = node_coords[i * 3 + 1];
 2840:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2841:       node.depth = node_coords[i * 3 + 2];
 2842: 
 2843:       node.numSides = 0;
 2844: 
 2845: printf("EEEEEE idx = %d, isbnd[i] = %d, node.nodeBnd = %p\n", i, isbnd[i], node.nodeBnd);
 2846:       // Links the node to the boundary information
 2847:       if (isbnd[i] >= 0) {
 2848:        
 2849:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2850:          node.nodeBnd->node = &node;
 2851: 
 2852:          node.nodeBnd->sideBnd1 = nullptr;
 2853:          node.nodeBnd->sideBnd2 = nullptr;
 2854: 
 2855:          if (isbnd[i]>=0) {
 2856: 
 2857:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2858:             
 2859:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2860:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2861: 
 2862:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2863:             node.nodeBnd->segment->clen  = nan("1");
 2864:             node.nodeBnd->segment->carea = nan("1");
 2865: 
 2866:          }
 2867: //          else {
 2868: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2869: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2870: //          }
 2871:          
 2872:          idxNodeBoundary++;
 2873: printf("EEEEEEhhhh idx = %d, isbnd[i] = %d, idxNodeBoundary = %d\n", i, isbnd[i], idxNodeBoundary);         
 2874:       }
 2875:       else {
 2876:          node.nodeBnd = nullptr; // For internal nodes
 2877: printf("EEEEEQQ isbnd[i] = %d, node.nodeBnd = %p\n", isbnd[i], node.nodeBnd); 
 2878:          if (isbnd[i] == landSegment) {
 2879:             node.nodeBnd = &landBoundaryNode;
 2880:             node.nodeBnd->segment = &landBoundarySegment;
 2881:          }
 2882:          // node.nodeBnd->node = &node;
 2883:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2884:          // // node.nodeBnd = nullptr;
 2885:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2886:         
 2887:       }
 2888: 
 2889:       // XXXX GAUSSIAN HILL VELOCITIES
 2890: #ifdef GAUSSIAN_HILL_VELOCITIES
 2891:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2892:          constexpr double rot_per = 3000.0;
 2893:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2894:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2895:       // XXXXX
 2896: #endif
 2897:    }
 2898: 
 2899:    nbp = idxNodeBoundary;
 2900: 
 2901:    printf("Processing %d sides\n", ns);
 2902:    int idxSideBoundary = 0;
 2903:    for (int i = 0; i < ns; i++)
 2904:    {
 2905:       Side &side = localSideData[i];
 2906:       side.idx = i;
 2907:       // finding the pointer to the nodes that form the side
 2908:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2909:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2910: 
 2911:       const int locidx_n1 = localNodeIndices[idx_n1];
 2912:       const int locidx_n2 = localNodeIndices[idx_n2];
 2913:       const int part_n1 =   localNodePart[idx_n1];
 2914:       const int part_n2 =   localNodePart[idx_n2];
 2915: 
 2916:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2917:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2918: 
 2919:       // Counts the number of sides connected to each node
 2920:       side.n1->numSides++;
 2921:       side.n2->numSides++;
 2922: 
 2923:       // Normal, unitary vector to the side
 2924:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2925:       side.n = normalize(side.n);
 2926: 
 2927:       // Side boundary type
 2928:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2929:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2930: 
 2931:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2932:       // If both nodes are on the boundary, then the side may be on the boundary
 2933:       {
 2934:          bool isLand = false;
 2935:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2936: 
 2937:          if (isbs > -1) {
 2938:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2939:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2940:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2941: 
 2942:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2943:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2944:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2945: 
 2946:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2947:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2948:           
 2949:             side.sideBnd->side = &side;
 2950:             idxSideBoundary++;
 2951: 
 2952:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2953:          }
 2954:          
 2955: 
 2956:       // }
 2957:       // 
 2958: 
 2959: 
 2960: 
 2961: 
 2962: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2963: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2964: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2965: //       {
 2966: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2967: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2968: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2969: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2970: // if (side.sideBnd->segment == nullptr) continue;
 2971: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2972: //          else                  side.sideBnd->segment = n2bnd->segment;
 2973: //          side.sideBnd->side = &side;
 2974: //          idxSideBoundary++;
 2975: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2976:       }
 2977:       else side.sideBnd = nullptr;
 2978: 
 2979:       nbs = idxSideBoundary;
 2980: // printf("Here3: %d", i);
 2981:       // finding the pointer to the elements that share the side
 2982:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2983:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2984: 
 2985:       if (idx_e1 > -1) {
 2986:          const int locidx_e1 = localElemIndices[idx_e1];
 2987:          const int part_e1 =  localElemPart[idx_e1];
 2988:          side.elems[0] = elems[part_e1] + locidx_e1;
 2989: 
 2990:       }
 2991:       else {
 2992:          side.elems[0] = nullptr;
 2993:       }
 2994: // printf("Here4: %d", i);
 2995:       if (idx_e2 > -1) {
 2996:          const int locidx_e2 = localElemIndices[idx_e2];
 2997:          const int part_e2 =  localElemPart[idx_e2];
 2998:          side.elems[1] = elems[part_e2] + locidx_e2;
 2999:       }
 3000:       else {
 3001:          side.elems[1] = nullptr;
 3002:       }
 3003: // printf("Here5: %d", i);
 3004: 
 3005: 
 3006:       // Compute the center of the side
 3007:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3008: 
 3009:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3010:       side.shapiro = shapiro0;
 3011: 
 3012: #ifdef GAUSSIAN_HILL_VELOCITIES
 3013: // XXXX
 3014: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3015: constexpr double rot_per=3000.0;
 3016: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3017: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3018: // XXXXX      
 3019: #endif
 3020:       // Compute the z level at the center of the side
 3021:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3022: 
 3023:       // Compute the length of the side
 3024:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3025:       side.len = sqrt(dot(vLen, vLen));
 3026: 
 3027:    }
 3028: 
 3029:    printf("Processing %d elements\n", ne);
 3030:    for (int i = 0; i < ne; i++)
 3031:    {
 3032:       Element &elem = localElemData[i];
 3033:       elem.idx = i;
 3034:       for (int j = 0; j < i34[i]; j++) {
 3035:          const int idxNode = elnode[i*4 + j];  
 3036:          const int idxSide = elside[i*4 + j];
 3037:          
 3038:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3039:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3040: 
 3041: 
 3042: 
 3043:          // Find the neighboring element  
 3044:          if (elem.sides[j]->elems[0] == &elem) {
 3045:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3046:          }
 3047:          else {
 3048:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3049:          }
 3050:          
 3051:       }
 3052: 
 3053:       elem.i34 = i34[i];
 3054: 
 3055: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 3056: 
 3057:       // Compute the centroid of the element and its depth
 3058:       Vector2 center = {0.0, 0.0};
 3059:       elem.depth = 0.0;
 3060:       for (int j = 0; j < i34[i]; j++) {
 3061:          center += elem.nodes[j]->p2()/i34[i];
 3062:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3063:       }
 3064:       elem.center.x = center.x;
 3065:       elem.center.y = center.y;
 3066: 
 3067:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 3068:       
 3069:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3070:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3071: 
 3072:       elem.area = elem.computeSignedArea(); 
 3073:       elem.radius = sqrt(elem.area)/pi; 
 3074:       
 3075:       // Determines which way the normal vector to each side is oriented.
 3076:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3077:       for (int j = 0; j < i34[i]; j++)  
 3078:       {
 3079:          if (elem.sides[j]->elems[0] == &elem) {
 3080:             elem.ssign[j] =  1.0;
 3081:          }
 3082:          else {
 3083:             elem.ssign[j] = -1.0;
 3084:          }
 3085: 
 3086:       }
 3087: 
 3088:       // Derivatives of shape functions
 3089:       //  For ics=2, this is done inside element/ll frame XXX
 3090:       //  For quads, the derivative is evaluated at centroid
 3091:       const int i34 = elem.i34;
 3092:       for (int j = 0; j < i34; j++) {
 3093:          const double area = elem.area;
 3094:          const int id2 = elem.nxq(1 + j);
 3095:          const int id3 = elem.nxq(2 + j);
 3096:          const int id4 = elem.nxq(3 + j);
 3097:          if (elem.isTri()) {
 3098:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3099:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3100:             // da1/dx = (y1 - y2)/(2*area)
 3101:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3102:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3103:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3104:          }
 3105:          else  { // Quad; evaluate at centroid
 3106:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3107:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3108:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3109:          } // if Tri
 3110: 
 3111:       } // for j
 3112: 
 3113:    }
 3114: 
 3115: 
 3116:    // Processing the boundary nodes
 3117:    int idx = 0;
 3118:    for (int iseg = 0; iseg < nope; iseg++) {
 3119:       // for each segment...
 3120:       
 3121:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3122:          // for each node on the segment...
 3123: 
 3124:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3125: 
 3126:          nodeBnd->isEssentialBC = true;
 3127: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3128:          nodeBnd->elbc = 0.0;
 3129: 
 3130:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3131: 
 3132:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3133:             nodeBnd->efa[jfr] = efa[idx];
 3134:             nodeBnd->emo[jfr] = emo[idx];
 3135:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3136:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3137: 
 3138:          }
 3139: 
 3140:          idx++;
 3141:       }
 3142: 
 3143:    }
 3144: 
 3145: }
