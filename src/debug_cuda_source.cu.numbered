 1636: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1637:    // Computes the 3D normal vector to the element at level k
 1638:    // Returns the normal vector and the area of the element
 1639: 
 1640:       if (isTri()) {
 1641:          // For triangles...
 1642: 
 1643:          // Gets the normal vector to the element (with a length equal to twice the area)
 1644:          if constexpr(ics==1) {
 1645:             const int kb0 = max(k, nodes[0]->kb);
 1646:             const int kb1 = max(k, nodes[1]->kb);
 1647:             const int kb2 = max(k, nodes[2]->kb);
 1648: 
 1649:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1650:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1651:             
 1652:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1653:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1654:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1655:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1656: 
 1657:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1658:             area3D = 0.5*len;
 1659: 
 1660:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1661: 
 1662:             return {nx/len, ny/len, nz/len};
 1663: 
 1664:            
 1665:          }
 1666:          else {  // lat/lon
 1667:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1668: 
 1669:          } // if ics
 1670:       }
 1671:       else {
 1672:          // For quads...
 1673: 
 1674:          assert(false && "Element normal vector: quads not yet implemented");
 1675: 
 1676: 
 1677:       }
 1678:    }
 1679: 
 1680: /**
 1681:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1682:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1683:    If the segment is completely inside the element, then it returns true.
 1684: 
 1685:    This function assumes:
 1686:    - The initial point is on a side of the element. 
 1687:    - Its position is given by parameter t in the range [0,1].
 1688:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1689:       intersects the element (elements are convex).
 1690: 
 1691:    To find the intersection point, this function does the following:
 1692:    - it finds the intersection of the line segment with all the element side lines,
 1693:       except for the one that contains the initial point.
 1694:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1695:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1696:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1697:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1698:       track segment is almost parallel to the element side line.
 1699: 
 1700:    Inputs:
 1701:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1702:    @param x2, y2: other end of the line segment
 1703: 
 1704:    Outputs:
 1705:    @param side:  side that intersects the line segment (input and output)
 1706:    @param nextElement (output): element that contains the intersection point
 1707:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1708:    @param zint (input/output): Vertical coordinate of the intersection point
 1709: 
 1710:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1711:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1712:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1713: 
 1714:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1715:    (Delta) being zero.
 1716: 
 1717:    The intersection2 point happens when:
 1718:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1719:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1720:    
 1721:    Assumption: the 4 points (including those of the side segment) are different.
 1722:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1723:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1724:    If true, (xIntersect,yIntersect) is the intersection.				
 1725:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1726: **/
 1727: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1728:                                               double &t, double& tIntersect) {
 1729: 
 1730:    double closest_intersect_t = 1e10;
 1731:    bool found_intersection = false;
 1732: 
 1733:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1734:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1735:    const Point2 x1 = side->point(t);
 1736:    
 1737: 
 1738:    Side *nextSide = nullptr;
 1739:    for (int i = 0; i < i34; i++) {
 1740: 
 1741:       // Element's i-th side 
 1742:       Side *side2 = sides[i];
 1743: 
 1744:       // Skip the side that contains the initial point
 1745:       if (side2 == side) continue;
 1746: 
 1747:       // (x3,y3)-(x4,y4) is the element side line
 1748:       const Point2 x3 = side2->n1->p2();
 1749:       const Point2 x4 = side2->n2->p2();
 1750: 
 1751:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1752:       const double delta = cross(x2 - x1, x3 - x4);
 1753: 
 1754:       if (delta != 0.0) {
 1755: 
 1756:          const double delta1 = cross(x3 - x1, x3 - x4);
 1757:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1758: 
 1759:          // Solves the two linear equations for tt1 and tt2
 1760:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1761:          const double tt2 = delta2/delta;
 1762: 
 1763:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1764:             closest_intersect_t = min(closest_intersect_t, tt1);
 1765:             nextSide = side2;
 1766: 
 1767:             nextElement = nextSide->otherElem(this);
 1768:             tIntersect = max(small, min(tt1, 1.0-small));
 1769:             t = tt2;
 1770: 
 1771:             found_intersection = true;
 1772:          }
 1773:       
 1774:       }
 1775: 
 1776:    }
 1777:    
 1778: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1779: 
 1780: 
 1781:    // found_intersection should always be true, since we checked all the sides.  
 1782:    side = nextSide;
 1783: // if (found_intersection) {
 1784: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1785: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1786: // }   
 1787:    // if (!found_intersection) {
 1788:    //    // Check if the segment is parallel to the initial side
 1789:    //    printf("XXX segment: side = %p\n", side);
 1790:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1791:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1792:    //       assert(false && "Segment is parallel to the initial side");
 1793:    //       found_intersection = true;
 1794:    //       nextElement = side->otherElem(this);
 1795:    //       tIntersect = t;
 1796:    //       t = 0.0;
 1797:    //       found_intersection = true;
 1798:    //    }
 1799:    // }
 1800:    return found_intersection;
 1801: }
