  279: // Polynomial class
  280: template<int grade>
  281: struct Polynomial {
  282:     // Static assertion to give a clear error message at compile time
  283:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  284: };
  285: 
  286: 
  287: // Explicit specialization for grade 4
  288: template<>
  289: struct Polynomial<4> {
  290:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  291: 
  292:    // Constructor from coefficients
  293:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  294: 
  295:    __device__ __forceinline__ double eval(double x) const {
  296:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  297:    }
  298: };
