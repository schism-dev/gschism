 4425:    __global__ void computeFlowBcVelocities(double time) {
 4426: 
 4427:       SIDE_BND(sideBnd);
 4428: 
 4429:       const Side *side = sideBnd->side;
 4430:  
 4431:       const bool isDry = side->isDry;
 4432:       const bool isLand = sideBnd->segment->isLand;
 4433: 
 4434:    
 4435:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4436: 
 4437:       if (isDry || isLand) return;
 4438: 
 4439:       // For wet sides in open boundaries...
 4440:       const Vector2 n = side->n;
 4441:       const BoundarySegment *segment = sideBnd->segment;
 4442: 
 4443:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4444: 
 4445:       const int ifltype = segment->ifltype;
 4446: 
 4447:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4448:       const Vector2 r_nuth0 = r_uth0*n;
 4449: 
 4450: 
 4451:       if (ifltype == 1 || ifltype == 2) {
 4452:       
 4453:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4454: 
 4455:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4456:          
 4457:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4458:          
 4459:       } else if (ifltype == -1) { // Flather 1
 4460: 
 4461:          for (int k = 0; k < nvrt; k++) {
 4462: 
 4463:             // uth is the normal vel.; no ramp up
 4464:             const double uth = sideBnd->nuth(k);
 4465:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4466: 
 4467:             sideBnd->ubc[k] += uth*n;
 4468:          }
 4469: 
 4470:       } else if (ifltype == 3 || ifltype == 5) {
 4471:          // vnth0=0 !normal vel.
 4472: 
 4473:          Vector2 r_u1_bar = {0.0, 0.0};
 4474:          // Computes the contribution to the velocity from all tide frequencies
 4475:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4476: 
 4477:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4478:             const Vector2 umo  = sideBnd->umo(jfr); 
 4479: 
 4480:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4481:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4482:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4483:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4484: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4485:          }
 4486: 
 4487: 
 4488:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4489: 
 4490:       } // if (ifltype = 3 || ifltype == 5
 4491: 
 4492: 
 4493: 
 4494:    }
 4495: 
 4496:    __global__ void computeElevationBoundaryConditions(double time) {
 4497:       // Compute elevation essential boundary conditions 
 4498: 
 4499:       NODE_BND(nodeBnd); // Each boundary node.
 4500: 
 4501:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4502: 
 4503:       const Node *node = nodeBnd->node;
 4504:       const BoundarySegment *segment = nodeBnd->segment;
 4505:       const int iettype = segment->iettype;
 4506:       
 4507: 
 4508:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4509:       double eic = 0.0;
 4510:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4511:       else                 eic = 0.0;
 4512: 
 4513:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4514:       const double r_eth = ramp*nodeBnd->eth;
 4515:       double r_eta1_bar = 0.0;
 4516: 
 4517: 
 4518:       // Compute tide elevation
 4519:       if (iettype == 3 || iettype == 5) {   
 4520: 
 4521:          if constexpr(iloadtide==1) { // loading tide
 4522:             assert(false && "Loading tide not implemented");
 4523:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4524:          }
 4525:          
 4526:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4527: 
 4528:             const double efa  = nodeBnd->efa[jfr]; 
 4529:             const double emo  = nodeBnd->emo[jfr]; 
 4530: 
 4531:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4532:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4533:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4534: 
 4535:          } // for jfr
 4536: 
 4537:       } // if iettype
 4538: 
 4539:       switch (iettype) {
 4540:          case 1:
 4541:          case 2:
 4542:          case 4:
 4543:             nodeBnd->elbc = r_eic + r_eth;
 4544:             break;
 4545:          case 3:
 4546:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4547:             break;
 4548:          case 5:
 4549:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4550:             break;
 4551:       } // switch
 4552: 
 4553: 
 4554:       //Add inverse barometric effects
 4555:       if (iettype != 0 && inv_atm_bnd == 1) {
 4556:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4557:       }
 4558: 
 4559:    }
 4560: 
 4561: 
 4562:    __global__ void computeHorizontalViscosity(void) { 
 4563: 
 4564:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4565: 
 4566:       SIDE(side);
 4567: 
 4568:       if (side->isDry) return;
 4569: 
 4570:       for (int k = 0; k < nvrt; k++) {
 4571:          side->nuGradU[k] = {0.0, 0.0};
 4572:       }
 4573: 
 4574:       if constexpr(ihorcon == 1) {
 4575:          for (int k = side->kb; k < nvrt - 1; k++) {
 4576:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4577:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4578:             // By Zhang and Baptista.
 4579: 
 4580:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4581:             // This is a standard discretization of the Laplacian operator.
 4582:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4583:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4584:             // Gamma is hvis_coef0 in the code.
 4585:             // The value of gamma needs to be < 0.5.
 4586: 
 4587:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4588:             // side under consideration in each of the two possible elements that share the side.
 4589:             Vector2 sumU = {0.0, 0.0};
 4590:             for (int l = 0; l < 2; l++) {
 4591:                const Element *elem = side->elems[l];
 4592: 
 4593:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4594: 
 4595:                // Find the local index of the side in the element
 4596:                const int idxSide = elem->sideLocalIdx(side);
 4597:                // Find the two sides that are connected to the side under consideration
 4598:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4599:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4600: 
 4601:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4602: 
 4603:             }
 4604: 
 4605:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4606:    
 4607:          }
 4608:       }
 4609:       else if constexpr(ihorcon == 2) {
 4610:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4611:       }
 4612: 
 4613: 
 4614:    }
 4615: 
 4616: 
 4617:    __global__ void setEssentialBC(void) {
 4618:       // Set essential boundary conditions 
 4619:       NODE(node); // Each boundary node
 4620:       NodeBoundary *nodeBnd = node->nodeBnd;
 4621:       
 4622: // nodeBnd->isEssentialBC = true;      
 4623:       // Check if this node has essential BC
 4624:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4625:          // Verify BC value is valid
 4626:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4627: 
 4628:        
 4629:          // Set diagonal to 1 and zero off-diagonals
 4630:          node->coeffDiag = 1.0;
 4631: 
 4632:          for (int j = 0; j < node->numNodes; j++) {
 4633:                node->coeffMatrix[j] = 0.0;
 4634:          }
 4635:          
 4636:          // Set solution and RHS to BC value
 4637:          node->mX  = nodeBnd->elbc;
 4638:          node->qel = nodeBnd->elbc;
 4639: 
 4640:       } else {
 4641:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4642: 
 4643:          for (int j = 0; j < node->numNodes; j++) {
 4644:                Node* nbNode = node->nodes[j];
 4645:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4646:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4647:                   // Verify neighbor's BC value
 4648:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4649: 
 4650:                   // Subtract contribution to RHS
 4651:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4652:                   node->coeffMatrix[j] = 0.0;  
 4653:                }
 4654:          }
 4655:       }
 4656:    }
 4657: 
 4658: 
 4659:    __global__ void updateElevation(void) {
 4660:       NODE(node);
 4661: 
 4662:       node->eta2 = node->mX;
 4663: 
 4664:       node->updateZCoordData();
 4665:    }
