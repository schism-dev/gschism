 1342: 
 1343:    int ifltype;  // Type of flow boundary condition
 1344:    
 1345:    // Elevation boundary condition
 1346:    int iettype;  // Type of elevation boundary condition
 1347:    double eth;   // Elevation time history
 1348: 
 1349:    // Flow boundary condition
 1350:    double qthcon;  // Flow time history constant
 1351:    double vobc1;   // Velocity coefficient 1
 1352:    double vobc2;   // Velocity coefficient 2
 1353: 
 1354:    // Tracer boundary conditions
 1355:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1356:    // int  itrtype[natrm];    // Tracer boundary condition type
 1357: 
 1358:    BoundarySegment(bool _isLand) {
 1359:       isLand = _isLand;
 1360:       clen = 0.0;
 1361:       carea = 0.0;
 1362:       ifltype = 0;
 1363:       iettype = 0;
 1364:       eth = 0.0;
 1365:    }
 1366: 
 1367:    BoundarySegment(void) {
 1368:       isLand = false;
 1369:       clen = 0.0; 
 1370:       carea = 0.0;
 1371:       ifltype = 0;
 1372:       iettype = 0;
