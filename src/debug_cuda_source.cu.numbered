  307: // Polynomial class
  308: template<int grade>
  309: struct Polynomial {
  310:     // Static assertion to give a clear error message at compile time
  311:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  312: };
  313: 
  314: 
  315: // Explicit specialization for grade 4
  316: template<>
  317: struct Polynomial<4> {
  318:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  319: 
  320:    // Constructor from coefficients
  321:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  322: 
  323:    __device__ __forceinline__ double eval(double x) const {
  324:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  325:    }
  326: };
