 5138: extern "C" {
 5139: 
 5140:    __global__ void scaleGravity(double loadtide_coef) {
 5141: 
 5142: 
 5143:       NODE(node);
 5144: 
 5145:       // SAL option: scale gravity
 5146:       if constexpr(iloadtide==2) {  // simple const
 5147:          node->grav2 = grav*(1.0 - loadtide_coef);
 5148: 
 5149:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5150:         
 5151:           const double depth = max(node->depth, 0.0);
 5152:           const double tmp1 = sqrt(depth);
 5153:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5154:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5155:                              2.6969e-13*depth*depth*depth*tmp1;
 5156:           
 5157:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5158:           
 5159: 
 5160: 
 5161:           node->grav2 = grav*(1.0 - beta_bar);
 5162: 
 5163:       } else {  // iloadtide=0,1
 5164:           node->grav2 = grav;
 5165: 
 5166:       }
 5167: 
 5168:    }
 5169: 
