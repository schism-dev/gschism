 1854: __device__ __forceinline__ double Element::centerZ(void) const { 
 1855: // Z coordinate of the element center in the global cartesian coordinates
 1856:    assert(!isQuad() && "centerZ only works for triangles");
 1857: 
 1858:    if constexpr(ics==1) { 
 1859:       return 0.0; 
 1860:    } else { 
 1861:       return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1862:    } 
 1863: }
