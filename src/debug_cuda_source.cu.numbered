 2250:    template<typename T>
 2251:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2252:       T values[4];
 2253:       getNodalValues(field, values);
 2254: 
 2255:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2256:       if constexpr (IsVector2<T>::value && ics == 2) {
 2257: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2258:          projectNodeVectorsToElementFrame(values);
 2259: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2260:       }
 2261: 
 2262:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2263:    }
 2264: 
 2265:    template<typename T>
 2266:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2267:       T values[4];
 2268:       getSideValues(field, values);
 2269:       
 2270:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2271:       if constexpr (IsVector2<T>::value && ics == 2) {
 2272: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2273:          projectSideVectorsToElementFrame(values);
 2274: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2275:       }
 2276: 
 2277:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2278:    }   
