 3366: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3367:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3368:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3369:                 int *isdel, int *isidenode, int *isbnd,
 3370:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3371:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3372:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3373:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3374:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3375:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3376:                 double *drag, double *roughness,
 3377:                 double *emo, double *efa, 
 3378:                 double *umo, double *ufa, 
 3379:                 double *vmo, double *vfa) {
 3380: 
 3381:    printf("Populating mesh for partition %d\n", partNum);
 3382: 
 3383:    // XXXXXX THIS function does almost nothing. 
 3384: 
 3385:    nbs = *sharedIdxSideBoundary + 1;
 3386:    nbp = *sharedIdxNodeBoundary + 1;
 3387: 
 3388:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3389: 
 3390: }
