 2226: __global__ void setupMatrices(
 2227:    double** data_ptrs,
 2228:    int**    indices_ptrs,
 2229:    int**    indptr_ptrs,
 2230:    int*     nrows,
 2231:    int*     ncols,
 2232:    double** x_ptrs,
 2233:    double** b_ptrs) {
 2234:       
 2235:    CsrBlockMatrix blocks[nPartitions];
 2236:    for (int q = 0; q < nPartitions; ++q)
 2237:       blocks[q] = CsrBlockMatrix(data_ptrs[q], indices_ptrs[q], indptr_ptrs[q], nrows[q], ncols[q]);
 2238:    mesh->A = new RowBlockMatrix(blocks);
 2239:    mesh->x = new FullVector(x_ptrs);
 2240:    mesh->b = new FullVector(b_ptrs);
 2241: }
