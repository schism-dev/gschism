 3839:    __global__ void setupCGSolver3(float* diag, float* data, int* indices, int* indptr, float* b) {
 3840:       NODE(node);
 3841:       const int idx = node->idx;
 3842:       // Computes the index in the nzz array
 3843: 
 3844:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3845: 
 3846:       indptr[idx] = nzzIdx;
 3847:       data[nzzIdx]    = (float)node->coeffDiag;
 3848:       indices[nzzIdx] = idx;
 3849: 
 3850:       for (int k = 0; k < node->numNodes; ++k) {
 3851:          const Node* nb = node->nodes[k];
 3852: 
 3853:          int j = nb->idx;
 3854:          // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else ...)
 3855:          data[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3856:          indices[nzzIdx + k + 1] = j;
 3857:       }
 3858: 
 3859:       diag[idx] = (float)(1.0/node->coeffDiag);
 3860:       b[idx] = (float)node->qel;
 3861:    }
 3862: }
