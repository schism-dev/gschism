  748: struct Element {
  749: 
  750:    // Geometry information
  751:    int idx;                   // Index of the element
  752:    int16_t i34;               // Number of sides for the element 
  753:    Side *sides[4];            // Sides of the element
  754:    Node *nodes[4];            // Nodes of the element
  755:    Element *nghbElems[4];     // Neighbors of the element
  756: 
  757:    int16_t kb;                // Bottom index of the element
  758:    double area;               // Area of the element
  759:    double ssign[4];           // Sign associated with each side of an element
  760:    double radius;             // Element equivalent radii
  761: 
  762:    Frame<ics> frame;
  763: 
  764:    Vector2 gradPhi[4];        // Derivatives of shape functions
  765:    Vector2 gradEta;           // Gradient of free surface elevation
  766:    Vector2 gradPr;            // Gradient of pressure    
  767:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  768: 
  769:    bool isDry;                // True if the element is dry
  770: 
  771:    Point2 center;            // Element center coordinates (global coordinates)
  772: 
  773:    double depth;              // Depth at element (min of all nodes)
  774:    double z[nvrt];            // z-coord  (local frame - vertical up)
  775: 
  776:    // Physical information
  777:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  778: 
  779:    static const bool isblock = false;              // Always false
  780: 
  781:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  782:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  783: 
  784:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  785:    
  786: 
  787:    double vsource;            // Volumetric source/sink term [m^3/s]
  788: 
  789:    double rho[nvrt];          // Density at each prism center
  790:    double rho_mean[nvrt];     // Mean density at each prism center
  791:    CubicSpline rho_spl;
  792:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  793:    double rho_z[nvrt];        // First derivative of density at each prism center
  794:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  795:    
  796: 
  797:    __inline__ __device__ Point2 outputCoords(void) const;
  798: 
  799:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  800: 
  801:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  802:    // If ics == 2, convert the global point to the local frame of the element
  803:       
  804:       if constexpr (ics == 1) {
  805:          return p;
  806:       } else {
  807:          const Point3 c = {center.x, center.y, centerZ()};
  808:          return frame.G2L(p - c);
  809:       }
  810:    }
  811: 
  812:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
  813:    // If ics == 2, convert the local point to a global point
  814:       
  815:       if constexpr (ics == 1) {
  816:          return p;
  817:       } else {
  818:          const Point3 c = {center.x, center.y, centerZ()};
  819:          return c + frame.L2G(p);
  820:       }
  821:    }
  822: 
  823:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  824:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  825: 
  826:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  827:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  828: 
  829:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  830:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  831:       // Find the local index of the node in the element (0,1,2,3)
  832:       int res = __ffs((nodes[0] == node) | 
  833:                      ((nodes[1] == node) << 1) | 
  834:                      ((nodes[2] == node) << 2) | 
  835:                      ((nodes[3] == node) << 3)) - 1;
  836:       
  837:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  838:       return res;  
  839:    }
  840: 
  841:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  842:       // Find the local index of the side in the element (0,1,2,3)
  843:       int res = __ffs((sides[0] == side) | 
  844:                      ((sides[1] == side) << 1) | 
  845:                      ((sides[2] == side) << 2) | 
  846:                      ((sides[3] == side) << 3)) - 1;
  847:       
  848:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  849:       return res;
  850:    }
  851: 
  852:    __inline__ __device__ int findLevel(double z1, int k) const {
  853:       // Starting at index k, find sequentially the level that contains z
  854: 
  855:       // For testing purposes, forgets k and performs a full search.
  856:       for (k = kb; k < nvrt - 1; k++) {
  857:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  858:       }
  859:       return nvrt - 2;
  860: 
  861: 
  862:       // if z is already betweeen z[k] and z[k+1], return k
  863:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  864:       else if (z1 <  z[k]) { 
  865:          // Search for increasing levels
  866:          for (int kk = k; kk < nvrt - 1; kk++) {
  867:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  868:          }
  869:          return nvrt - 1;
  870:       }
  871:       else {
  872:          // Search for decreasing levels
  873:          for (int kk = k; kk >= kb; kk--) {
  874:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  875:          }
  876:          return 0;
  877:       }
  878:    }
  879: 
  880:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  881:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  882: 
  883: 
  884:    __device__ __forceinline__ double centerZ(void) const;
  885: 
  886:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  887:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  888:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  889:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, 
  890:                                                                        const Vector3& c, const Frame<ics>& dstFrame,int idx = 0) const;
  891:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  892:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
  893:                                                                        const Vector3& c, const Frame<ics>& dstFrame) const;
  894:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  895: 
  896: 
  897:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  898:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  899:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  900:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  901:        const double eta = (idxNode & 1) ? +g : -g;
  902:        const double xi  = (idxNode & 2) ? +g : -g;
  903:        return {eta, xi};
  904:    }  
  905: 
  906: 
  907: 
  908:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  909:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
  910:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
  911:    }
  912: 
  913:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  914:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
  915:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
  916:    }   
  917: 
  918:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  919:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
  920:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
  921:    }      
  922:    
  923:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  924: 
  925:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  926: 
  927:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
  928:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
  929: 
  930:    // Check if the element is dry using the more up-to-date elevation.
  931:    __inline__ __device__ bool isDry2(void) const;
  932: 
  933:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  934: 
  935:    __forceinline__ __device__ bool inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const;
  936: 
  937:    __inline__ __device__ double computeSignedArea(void) const;
  938: 
  939: 
  940:    enum EFixIf { fiNo, fiOnlyInside, fiAnywhere };
  941: 
  942:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegShapeCoords = fiNo, const Side *origSide = nullptr) const;
  943:    
  944:    __device__ __forceinline__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  945: 
  946: 
  947:    __device__ __forceinline__ double intPhiPhiTri(int i, int j) const;
  948: 
  949:    __device__ __forceinline__ double intGradPhiGradPhiTri(int i, int j) const;
  950: 
  951:    __device__ __forceinline__ double intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  952: 
  953:    __device__ __forceinline__ double intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
  954: 
  955:    __device__ __forceinline__ Vector2 grad2(double *a) const
  956:    {
  957:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  958:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  959:       if (isQuad()) {
  960:          gx += a[3]*gradPhi[3].x;
  961:          gy += a[3]*gradPhi[3].y;
  962:       }
  963:       return {gx, gy};
  964:    }
  965: 
  966:    __device__ __forceinline__ Vector2 grad2(double Node::* field) const
  967:    {
  968:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  969:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  970:       if (isQuad()) {
  971:          gx += (nodes[3]->*field)*gradPhi[3].x;
  972:          gy += (nodes[3]->*field)*gradPhi[3].y;
  973:       }
  974:       return {gx, gy};
  975:    }
  976: 
  977:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  978:    __device__ __forceinline__ Vector3 n(int k) const {
  979:       double area3D;
  980:       return n(k, area3D);
  981:     }
  982: 
  983: 
  984: 
  985:    __device__ void setFrame(void) {
  986:       if constexpr(ics == 1) return;
  987: 
  988:       double lat, lon;
  989:       const Point3 p = toPoint3(center, centerZ());
  990: 
  991:       // Compute the latitude and longitude of the element center
  992:       computeLatLon(p, lat, lon);
  993: 
  994:       frame.update(lat, lon);        
  995:    }
  996: 
  997: 
  998:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  999:    {
 1000:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
 1001:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
 1002:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
 1003:       
 1004:    }
 1005: 
 1006:    __device__ Vector3 interpolateVelocities(Point3 xt, const Side *origSide = nullptr) const;
 1007: 
 1008:    // ------------------------------------------------------------------------------------------------
 1009:    // These are functions that work on all nodes/sides of the element.
 1010:    // They use a standard, but not well known, way of accessing the fields of the nodes.
 1011:    //
 1012:    // An example of how to use these functions is:
 1013:    //   
 1014:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 1015:    // 
 1016:    // Where L is the level at which the field is to be interpolated. The field can be either
 1017:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
 1018:    // There are different versions of getNodalValues for each of these cases.
 1019: 
 1020:    template<typename T>
 1021:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
 1022: 
 1023:    template<typename T>
 1024:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
 1025:   
 1026:    template<typename T>
 1027:    __device__ __forceinline__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const;
 1028: 
 1029:    template<typename T>
 1030:    __device__ __forceinline__ void getSideValues(T Side::* field, T res[4]) const;
 1031: 
 1032:    template<typename T>
 1033:    __device__ __forceinline__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const;
 1034: 
 1035:    template<typename T>
 1036:    __device__ __forceinline__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const;
 1037: 
 1038:    
 1039:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
 1040:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
 1041: 
 1042: 
 1043:    template<typename T>
 1044:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
 1045: 
 1046:    template<typename T>
 1047:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
 1048: 
 1049:    template<typename T>
 1050:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
 1051: 
