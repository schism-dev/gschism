 1733: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1734:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1735: }
 1736: 
 1737: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1738:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1739: }   
 1740: 
 1741: __device__ __inline__ double min3(double a, double b, double c) {
 1742:    return min(a, min(b, c));
 1743: }
 1744: 
 1745: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1746:    return min(a, min(b, min(c, d)));
 1747: }
