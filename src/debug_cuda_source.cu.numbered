 8370: #ifdef OLD_PCG_SOLVER
 8371: __global__ void computeMatrixProductAndDotProducts() {
 8372:    // Computes A*p, r'Mr and p'Ap
 8373: 
 8374:    // 1) shared buffer: first half for rMr, second for pAp
 8375:    __shared__ double sdata[2*BLOCK_SIZE];
 8376:    double* s_rMr = sdata;
 8377:    double* s_pAp = sdata + BLOCK_SIZE;
 8378: 
 8379:    const int tid = threadIdx.x;
 8380: 
 8381:    double l_pAp = 0.0;
 8382: 
 8383:    s_rMr[tid] = 0.0;
 8384:    s_pAp[tid] = 0.0;
 8385: 
 8386:    // 2) get your node pointer
 8387:    // NODE(node);   
 8388:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8389:    Node *node = &(mesh->localNodeData[idx_node]); 
 8390:       if (idx_node < mesh->np) {
 8391: 
 8392:       const double diag = node->coeffDiag;
 8393:       const double r    = node->mR;
 8394:       const double p    = node->mP;  
 8395: 
 8396:       // apply preconditioner on the fly:
 8397:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8398: 
 8399:       // 4) compute Ap = A.p
 8400:       double Ap = node->coeffDiag * node->mP;
 8401:       for (int j = 0; j < node->numNodes; ++j) {
 8402:          const Node *nbNode = node->nodes[j];
 8403:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8404: 
 8405:       }
 8406: 
 8407:       node->mAp = Ap;
 8408:       
 8409: 
 8410:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8411:       // const double l_rMr = r*Mr;  // r'Mr
 8412:       l_pAp = p*Ap;  // p'Ap
 8413: 
 8414: 
 8415:    }
 8416: 
 8417:    // 6) write into shared mem
 8418:    // s_rMr[tid] = l_rMr;
 8419:    s_pAp[tid] = l_pAp;
 8420: 
 8421:    __syncthreads();
 8422: 
 8423:    // 7) block-wide tree reduction
 8424:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8425:       if (tid < stride)  {
 8426:          s_pAp[tid] += s_pAp[tid + stride];
 8427:       }
 8428:       __syncthreads();
 8429:    }
 8430: 
 8431:    // 8) thread 0 atomically accumulates into the globals
 8432:    // XXX: This is slower than it needs to be, but it is simple and works
 8433:    if (tid == 0) {
 8434:       atomicAdd(pAp, s_pAp[0]);
 8435:    }
 8436: 
 8437: 
 8438: }
 8439: 
 8440: 
 8441: __global__ void updateSolutionAndDotProducts(void) {
 8442:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8443: 
 8444:    const int tid = threadIdx.x;
 8445: 
 8446:    s_rMr[tid] = 0.0;
 8447: 
 8448:    // get node & bounds-check:
 8449:    NODE(node);
 8450: 
 8451:    
 8452:    // Compute alpha
 8453:    const double alpha = (*rMr_old)/(*pAp); 
 8454: 
 8455: 
 8456:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8457: 
 8458: 
 8459:    // load scalars
 8460:    const double diag = node->coeffDiag;
 8461:    const double p    = node->mP;
 8462:    const double Ap   = node->mAp;
 8463:    const double x    = node->mX;
 8464:    const double r    = node->mR;
 8465:    
 8466:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8467: 
 8468:    // 1) update solution & residual
 8469:    const double x_new = x + alpha*p;
 8470:    const double r_new = r - alpha*Ap;
 8471:    node->mX = x_new;
 8472:    node->mR = r_new;
 8473: 
 8474:    // 2) apply Jacobi preconditioner on the fly
 8475:    const double Mr_new = r_new/diag;
 8476: 
 8477: 
 8478:    // 3) local contributions for the two dot-products
 8479:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8480: 
 8481:    // 4) write into shared-mem
 8482:    s_rMr[tid] = l_rMr;
 8483: 
 8484:    __syncthreads();
 8485: 
 8486: 
 8487:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8488:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8489:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8490:       __syncthreads();
 8491:    }
 8492: 
 8493:    // 6) thread 0 atomically folds into the global accumulators
 8494:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8495: 
 8496: 
 8497: }
 8498: 
 8499: 
 8500: __global__ void updateSearchDirection() {
 8501: 
 8502:     NODE(node);
 8503: 
 8504:     // recompute z on-the-fly
 8505:     const double z = node->mR / node->coeffDiag;
 8506:     const double p = node->mP;
 8507: 
 8508:     const double beta = (*rMr_new)/(*rMr_old);
 8509: 
 8510: 
 8511:     // p =z + beta*p
 8512:     node->mP = z + beta*p;
 8513: 
 8514: }
 8515: 
 8516: __global__ void initializeScalars(double *scalars) {
 8517: 
 8518:    // These point to a cupy array in the host code
 8519:    rMr_old = scalars + 0;
 8520:    rMr_new = scalars + 1;
 8521:    pAp     = scalars + 2;
 8522: }
 8523: 
 8524: __global__ void initializePreconditionedResidual(void) {
 8525: 
 8526:     __shared__ double s_rMr[BLOCK_SIZE];  
 8527: 
 8528:     s_rMr[threadIdx.x] = 0.0;
 8529: 
 8530:     NODE_ALL(node, valid);
 8531:     const int tid = threadIdx.x;
 8532:     // For the first iteration:
 8533:     // 1. Initial solution x = 0 (already set)
 8534:     // 2. Initial residual r = b (stored in qel)
 8535:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8536: 
 8537: // XXX we should use the guess solution here    
 8538: 
 8539:     double l_rMr = 0.0;
 8540:     if (valid) {
 8541:       // Set initial residual r = b (from qel)
 8542:       node->mR = node->qel;
 8543: 
 8544:       // Compute z = M^-1 * r (preconditioned residual)
 8545:       const double z = node->mR / node->coeffDiag;
 8546: 
 8547:       // Set initial search direction p = z
 8548:       node->mP = z;
 8549: 
 8550:       // Initialize other variables needed for CG
 8551:       node->mX = 0.0;  // Initial solution
 8552:       node->mAp = 0.0; // Will be computed in first iteration
 8553: 
 8554: 
 8555:       // Computes the first r'Mr (reduction)
 8556:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8557:     }
 8558:     // 4) write into shared-mem
 8559:     s_rMr[tid] = l_rMr;
 8560: 
 8561:     __syncthreads();
 8562: 
 8563: 
 8564:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8565:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8566:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8567:         __syncthreads();
 8568:     }
 8569: 
 8570:     // 6) thread 0 atomically folds into the global accumulators
 8571:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8572: 
 8573:     *rMr_old = 0.0;
 8574:     *pAp = 0.0;
 8575: }
 8576: #endif
 8577: 
 8578: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
