 3551: 
 3552: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3553: 
 3554: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3555: 
 3556:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3557:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3558: 
 3559:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3560:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3561: 
 3562:    double fun_lat = 0.0;
 3563:    switch (jspc[idxComp]) {
 3564:       case 0:
 3565:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3566:          break;
 3567:       case 1:
 3568:          fun_lat = sin(2.0*lat);
 3569:          break;
 3570:       case 2:
 3571:          fun_lat = pow<2>(cos(lat));
 3572:          break;
 3573:       default:
 3574:          assert(false && "computeETP: invalid jspc");
 3575:    }
 3576:    
 3577:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3578: 
 3579: }
 3580: 
 3581: 
 3582: __device__ void Node::updateKb(void) {
 3583: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3584: 
 3585:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3586: 
 3587: 
 3588:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3589: 
 3590:    if constexpr(ivcor == 2) {  // SZ coordinates
 3591:       
 3592:       // Compute bottom level index
 3593:       if (depth <= mesh->h_s) {
 3594:          kb = izlev;   
 3595:          
 3596:       } else {
 3597:          kb = -1;
 3598:          int L = 0;
 3599:          int R = nzlev; 
 3600:          
 3601:          while (L <= R) {
 3602:             int M = (R + L) / 2;
 3603: 
 3604: 
 3605:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3606:             
 3607:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3608:                R = M;
 3609:             } else {
 3610:                L = M;
 3611:             }
 3612: 
 3613:             if (R - L == 1) {
 3614:                kb = L;
 3615:                break;
 3616:             }
 3617:          }
 3618: 
 3619:          // Checks that the binary search was successful
 3620:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3621:        
 3622:       }
 3623:    } 
 3624: }
 3625: 
