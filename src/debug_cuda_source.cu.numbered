 3647: 
 3648: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3649:    // Computes the z coordinate at level k.
 3650:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3651:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3652:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3653:    // used 
 3654: 
 3655:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3656:    
 3657:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3658: 
 3659:    if (isDry2()) return 0.0;  
 3660: 
 3661:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3662: 
 3663:    if constexpr(ivcor == 2) {
 3664: 
 3665:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3666:       const double h_c = mesh->h_c;
 3667:       const double theta_f = mesh->theta_f;
 3668:       const double sinh_theta_f = mesh->sinh_theta_f;
 3669: 
 3670: 
 3671:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3672:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3673:       // once per time step/node. XXXX
 3674:       // CHECK: updateZCoordData
 3675: 
 3676:       //  To simplify comparisons, I define index versions of count variables.
 3677:       if      (k == ivrt)     return eta2; 
 3678:       else if (k == izlev)    return -hmod2;
 3679:       else if (k == kb)       return -depth;
 3680:       else if (k < izlev)     return mesh->ztot[k];
 3681:       else if (k > izlev) {
 3682:          const int ksig = k - izlev;
 3683: 
 3684:          if (hmod2 <= h_c) {
 3685:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3686: 
 3687:          } 
 3688:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3689:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3690:             assert(false && "compZCoord: invalid h_c\n");
 3691:          } 
 3692:          else {
 3693:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3694:                    h_c * mesh->sigma[ksig] + 
 3695:                    (hmod2 - h_c) * mesh->cs[ksig];
 3696:          }
 3697:       } else { 
 3698:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3699:       }
 3700: 
 3701:    }
 3702:    else {  // if constexpr(ivcor == 1)
 3703:       if (k <= kb)        return -depth; 
 3704:       else if (k == ivrt) return eta2;
 3705:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3706: 
 3707:    }
 3708:    
 3709:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3710:    return 0.0;
 3711: }
 3712: 
 3713: 
 3714: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3715:    // Computes the bottom drag Cd based on the selected nchi
 3716: 
 3717:    if constexpr(nchi == 0) {
 3718:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3719:       Cd = drag;  // Read from drag file
 3720: 
 3721:    } else if constexpr(nchi == 1) {
 3722:       // 
 3723: 
 3724:       bool ltmp = false; // for WBL iteration
 3725: 
 3726:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3727:       if (isDry || (rough == 0.0)) {
 3728:          Cd = 0.0;
 3729: 
 3730:       } else { //roughness >0 
 3731:          
 3732:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3733: 
 3734:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3735: 
 3736:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3737: 
 3738:       } // if rough
 3739: 
 3740:    } else if constexpr(nchi == -1) {
 3741:    // Manning 
 3742:  
 3743:       const double htot = max(hmin_man, htot2()); 
 3744:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3745: 
 3746:    } else {
 3747:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3748:       
 3749:    } // if nchi
 3750: 
 3751: }
 3752: 
 3753: 
 3754: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3755:    // Checks if a side in on the boundary
 3756:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3757: 
 3758:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3759:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3760: 
 3761:    // Indices of the nodes that form the side
 3762:    //
 3763:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3764:    const int n1 = side.n1->idx;
 3765:    const int n2 = side.n2->idx;
 3766:    isLand = false;
 3767:    
 3768: 
 3769:    // Check if the side is on a land boundary
 3770:    for (int i = 0; i < nland; i++) {
 3771:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3772:          // Consecutive nodes in the land boundary segment
 3773:          const int b1 = ilnd[i + j*nland];
 3774:          const int b2 = ilnd[i + (j + 1)*nland];
 3775: 
 3776:          assert(b1 != -1 && b2 != -1);
 3777: 
 3778:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3779:             
 3780:             isLand = true;
 3781:             return i;
 3782:          }
 3783:       }
 3784:    }
 3785: 
 3786:    // Check if the side is on an open boundary
 3787:    for (int i = 0; i < nope; i++) {
 3788:       for (int j = 0; j < nond[i] - 1; j++) {
 3789:          // Consecutive nodes in the open boundary segment
 3790:          const int b1 = iond[i + j*nope];
 3791:          const int b2 = iond[i + (j + 1)*nope];
 3792: 
 3793:          assert(b1 != -1 && b2 != -1);
 3794: 
 3795:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3796:             isLand = false;
 3797:             return i;
 3798:          }
 3799:       }
 3800:    }
 3801: 
 3802:    return -1;
 3803: }
 3804: 
 3805: 
 3806: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3807:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3808:                                     double *wind_rotate_angle, 
 3809:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3810:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3811:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3812:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3813:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3814: 
 3815:    NODE(pnode);  
 3816:    const int i = idx_node;
 3817:    Node &node(*pnode);
 3818: 
 3819:    node.idx = i;
 3820: 
 3821:    const int idxNodeStart = nodeNeighNodesStart[i];
 3822:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3823:    node.numNodes = idxNodeEnd - idxNodeStart;
 3824:    node.nodes = nodeNeighNodes + idxNodeStart;
 3825:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3826: 
 3827: 
 3828: 
 3829:    const int idxElemStart = nodeNeighElemsStart[i];
 3830:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3831:    node.numElements = idxElemEnd - idxElemStart;
 3832:    node.elements = nodeNeighElems + idxElemStart;
 3833: 
 3834: 
 3835:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3836:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3837:       const int partNode = localNodePart[idxNodeGlobal]; 
 3838:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3839: 
 3840:       Node *node_ptr = nodes[partNode] + idxNode;
 3841:       
 3842:       nodeNeighNodes[idx] = node_ptr;
 3843:    }
 3844: 
 3845: 
 3846:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3847:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3848:       const int partElem = localElemPart[idxElemGlobal];
 3849:       const int idxElem  = localElemIndices[idxElemGlobal];
 3850: 
 3851:       Element *elem_ptr = elems[partElem] + idxElem;
 3852: 
 3853:       nodeNeighElems[idx] = elem_ptr;
 3854:    }      
 3855: 
 3856:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3857:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3858: 
 3859:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3860: 
 3861:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3862:    if constexpr(ics == 1) {
 3863:       node.p.x   = node_coords[i * 3];
 3864:       node.p.y   = node_coords[i * 3 + 1];
 3865:       node.gz = 0.0;
 3866: 
 3867:       if (use_ll) {                                    // <-- add
 3868:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3869:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3870:       }  
 3871: 
 3872:    } else {
 3873:       const double lon = deg2rad*node_coords[i * 3];
 3874:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3875: 
 3876:       Point3 p = computeXYZfromLatLon(lat, lon);
 3877:       node.p = toVector2(p);
 3878:       node.gz = p.z;
 3879:       node.lon = lon;
 3880:       node.lat = lat;
 3881: 
 3882:       #ifdef USE_FRAMES
 3883:       node.setFrame(lat, lon);
 3884:       #endif
 3885: 
 3886: 
 3887:    }
 3888: 
 3889:    node.depth = node_coords[i * 3 + 2];
 3890: 
 3891:    node.numSides = 0;
 3892: 
 3893:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3894:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3895:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3896:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3897:    else assert(false && "populateNodes: selected nchi not implemented.");
 3898: 
 3899:    if constexpr(ivcor == 1) 
 3900:    {  
 3901:       node.kb = kb[i];
 3902: 
 3903:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3904:    }
 3905: 
 3906:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3907:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3908:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3909: 
 3910:    
 3911:    // Links the node to the boundary information
 3912:    if (isbnd[i] >= 0) {
 3913:      
 3914:       // Get the index of the node boundary
 3915:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3916: 
 3917:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3918:       node.nodeBnd->node = &node;
 3919: 
 3920:       node.nodeBnd->sideBnd1 = nullptr;
 3921:       node.nodeBnd->sideBnd2 = nullptr;
 3922: 
 3923:       if (isbnd[i]>=0) {
 3924: 
 3925:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3926:          
 3927:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3928:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3929: 
 3930:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3931:          node.nodeBnd->segment->clen  = nan("1");
 3932:          node.nodeBnd->segment->carea = nan("1");
 3933: 
 3934:       }
 3935:    } else {
 3936: 
 3937:       node.nodeBnd = nullptr; // For internal nodes
 3938: 
 3939:       if (isbnd[i] == landSegment) {
 3940:          node.nodeBnd = &landBoundaryNode;
 3941:          node.nodeBnd->segment = &landBoundarySegment;
 3942:       }
 3943:       
 3944:    }
 3945:    
 3946:    // XXXX GAUSSIAN HILL VELOCITIES
 3947:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3948:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3949:          constexpr double rot_per = 3000.0;
 3950:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3951:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3952:       // XXXXX
 3953:    #endif
 3954: 
 3955: }
 3956: 
 3957: 
 3958: 
 3959: 
 3960: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3961:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3962:                                     double *wind_rotate_angle,   
 3963:                                     int *isdel, int *isidenode, int *isbnd,
 3964:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3965:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3966:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3967:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3968:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3969:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3970:                                     double *drag, double *roughness) {
 3971: 
 3972: 
 3973:    SIDE(pside);
 3974:    Side &side(*pside);
 3975:    const int i = idx_side;
 3976: 
 3977:    side.idx = i;  
 3978:    
 3979:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3980:    const double fc   = 2.0*omega_e*sin(sfea0);
 3981:    const double beta = 2.0*omega_e*cos(sfea0);
 3982: 
 3983:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3984: 
 3985:    // finding the pointer to the nodes that form the side
 3986:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3987:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3988: 
 3989:    const int locidx_n1 = localNodeIndices[idx_n1];
 3990:    const int locidx_n2 = localNodeIndices[idx_n2];
 3991:    const int part_n1 =   localNodePart[idx_n1];
 3992:    const int part_n2 =   localNodePart[idx_n2];
 3993: 
 3994:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3995:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3996: 
 3997: 
 3998:    // Counts the number of sides connected to each node
 3999:    atomicAdd(&side.n1->numSides, 1);
 4000:    atomicAdd(&side.n2->numSides, 1);
 4001: 
 4002:    // Side boundary type
 4003:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4004:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4005: 
 4006:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4007:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4008:    {
 4009:       bool isLand = false;
 4010:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4011:       
 4012:       if (isbs > -1) {
 4013:          // assert(isLand || isbs>=0);
 4014:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4015: 
 4016:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4017: 
 4018:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4019:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4020: 
 4021:          assert (isLand == side.sideBnd->segment->isLand);
 4022:          
 4023:          side.sideBnd->side = &side;
 4024: 
 4025:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4026:          n1bnd->linkSideBoundary(side.sideBnd);
 4027:          n2bnd->linkSideBoundary(side.sideBnd);
 4028: 
 4029:       }
 4030:       else {
 4031:          side.sideBnd = nullptr;
 4032:       }
 4033:    }
 4034:    else 
 4035:    {
 4036:       side.sideBnd = nullptr;
 4037:    }
 4038: 
 4039: 
 4040:    // finding the pointer to the elements that share the side
 4041:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4042:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4043: 
 4044:    if (idx_e1 > -1) {
 4045:       const int locidx_e1 = localElemIndices[idx_e1];
 4046:       const int part_e1 =  localElemPart[idx_e1];
 4047:       side.elems[0] = elems[part_e1] + locidx_e1;
 4048: 
 4049:    }
 4050:    else {
 4051:       side.elems[0] = nullptr;
 4052:    }
 4053: 
 4054:    if (idx_e2 > -1) {
 4055:       const int locidx_e2 = localElemIndices[idx_e2];
 4056:       const int part_e2 =  localElemPart[idx_e2];
 4057:       side.elems[1] = elems[part_e2] + locidx_e2;
 4058:    }
 4059:    else {
 4060:       side.elems[1] = nullptr;
 4061:    }
 4062:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4063:       
 4064:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4065:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4066:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4067:          
 4068:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4069:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4070:       // printf("sideBnd: %p\n", side.sideBnd);
 4071:       // assert(false && "Side has no elements and no boundary");
 4072:    }
 4073:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4074: 
 4075:    // Compute the center of the side
 4076:    side.center = 0.5*(side.n1->p + side.n2->p);
 4077: 
 4078:    #ifdef USE_FRAMES
 4079:    side.setFrame();
 4080:    #endif
 4081: 
 4082:    // Normal, unitary vector to the side
 4083:    if constexpr(ics == 1) {
 4084:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4085:       side.n = normalize(side.n);
 4086:    }
 4087:    else {
 4088:       // Unit side vector in 3D cartesian coordinates
 4089:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4090: 
 4091:       nSide = normalize(nSide);
 4092: 
 4093:       // Its cross product with the unit local z-axis vector (nUp) is the
 4094:       // normal vector we are looking for.
 4095:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4096: 
 4097:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4098:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4099:       side.n = -normalize(n2D); 
 4100: 
 4101:    }
 4102: 
 4103:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4104:    side.shapiro = shapiro0;
 4105: 
 4106:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4107:    // XXXX
 4108:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4109:    constexpr double rot_per=3000.0;
 4110:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4111:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4112:    // XXXXX      
 4113:    #endif
 4114:    // Compute the z level at the center of the side
 4115:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4116:    
 4117:    // Compute the length of the side
 4118:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4119: 
 4120: 
 4121:    // Compute the Coriolis coefficient
 4122: 
 4123:    if constexpr(ncor == -1 || ncor == 0) {
 4124:       side.coriolis = coricoef;
 4125:    }
 4126:    else {
 4127:       const double sphi = side.lat();  // Latitude at the center of the side
 4128: 
 4129:       assert(use_ll && "use_ll must be true when ncor > 0");
 4130: 
 4131:       if constexpr(ics == 1) {
 4132:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4133:       }
 4134:       else { // ics == 2
 4135:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4136:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4137:       }
 4138: 
 4139:    }
 4140: 
 4141: }
 4142: 
 4143: 
 4144: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4145:    double *node_coords, double *node_coords_ll, bool use_ll,
 4146:    double *wind_rotate_angle,   
 4147:    int *isdel, int *isidenode, int *isbnd,
 4148:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4149:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4150:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4151:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4152:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4153:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4154:    double *drag, double *roughness) {
 4155: 
 4156:    ELEM(pelem);
 4157:    Element &elem(*pelem);
 4158:    const int i = idx_elem;
 4159: 
 4160:    elem.idx = i;
 4161: 
 4162:    for (int j = 0; j < i34[i]; j++) {
 4163:       const int idxNode = elnode[i*4 + j];  
 4164:       const int idxSide = elside[i*4 + j];
 4165:       
 4166:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4167:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4168: 
 4169:       // Find the neighboring element  
 4170:       if (elem.sides[j]->elems[0] == &elem) {
 4171:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4172:       }
 4173:       else {
 4174:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4175:       }
 4176:       
 4177:    }
 4178: 
 4179:    elem.i34 = i34[i];
 4180: 
 4181:    // Compute the barycenter of the element and its depth
 4182:    elem.center = {0.0, 0.0};
 4183:    elem.depth = 1e10;
 4184:    for (int j = 0; j < i34[i]; j++) {
 4185: 
 4186:       elem.center += elem.nodes[j]->p/i34[i];
 4187:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4188:    }
 4189: 
 4190:    #ifdef USE_FRAMES
 4191:    elem.setFrame();
 4192:    #endif
 4193: 
 4194:    elem.area = elem.computeSignedArea(); 
 4195:    elem.radius = sqrt(elem.area)/pi; 
 4196:    
 4197:    // Determines which way the normal vector to each side is oriented.
 4198:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4199:    for (int j = 0; j < i34[i]; j++)  
 4200:    {
 4201:       if (elem.sides[j]->elems[0] == &elem) {
 4202:          elem.ssign[j] =  1.0;
 4203:       }
 4204:       else {
 4205:          elem.ssign[j] = -1.0;
 4206:       }
 4207: 
 4208:    }
 4209: 
 4210:   
 4211: 
 4212:    // Derivatives of shape functions
 4213:    //  For ics=2, this is done in the element frame
 4214:    //  For quads, the derivative is evaluated at centroid
 4215:    for (int j = 0; j < elem.i34; j++) {
 4216:       const double area = elem.area;
 4217:       const int id2 = elem.nxq(1 + j);
 4218:       const int id3 = elem.nxq(2 + j);
 4219:       const int id4 = elem.nxq(3 + j);
 4220:       if (elem.isTri()) {
 4221:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4222:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4223:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4224:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4225:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4226:          // And so on for the other shape functions.
 4227: 
 4228:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4229:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4230:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4231: 
 4232:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4233:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4234: 
 4235:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4236: 
 4237:       }
 4238:       else  { // Quad, the derivatives are evaluated at the centroid
 4239: 
 4240:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4241:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4242:          // ...
 4243:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4244: 
 4245:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4246:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4247:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4248: 
 4249:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4250:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4251: 
 4252:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4253: 
 4254:       } // if Tri/Quad
 4255: 
 4256:    } // for j   
 4257:    
 4258:    
 4259: 
 4260: }
 4261: 
 4262: 
 4263: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4264:                                             double *emo, double *efa, 
 4265:                                             double *umo, double *ufa, 
 4266:                                             double *vmo, double *vfa,
 4267:                                             int *ifltype, int *iettype) {
 4268: 
 4269:    NODE_BND(nodeBnd);
 4270:    const int idx = idx_node_bnd;    
 4271: 
 4272:    nodeBnd->idx = idx;
 4273: 
 4274:    // Need to find the segment index and the index of the node on the segment
 4275:    int idxNode = -1;
 4276:    int iseg, i;
 4277:    for (iseg = 0; iseg < nope; iseg++) {
 4278:       // for each segment...
 4279:       for (i = 0; i < nond[iseg]; i++) {
 4280:          idxNode = iond[iseg + i*nope];
 4281:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4282:          
 4283:       }
 4284:    }
 4285: 
 4286:    assert(iseg < nope && "iseg is out of bounds");
 4287: 
 4288: found: // Jumped here when the node was found
 4289: 
 4290:    nodeBnd->isEssentialBC = true;
 4291:    nodeBnd->elbc = 0.0;
 4292: 
 4293:    nodeBnd->segment->ifltype = ifltype[iseg];
 4294:    nodeBnd->segment->iettype = iettype[iseg];
 4295: 
 4296:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4297: 
 4298:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4299: 
 4300:       nodeBnd->efa[jfr] = efa[idx2];
 4301:       nodeBnd->emo[jfr] = emo[idx2];
 4302:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4303:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4304: 
 4305:    }
 4306:         
 4307: 
 4308: }
 4309: 
 4310: __device__ void Mesh::populateBoundarySideLinks(void) {
 4311: 
 4312:    SIDE_BND(sideBnd);
 4313: 
 4314:    const Side *side = sideBnd->side;
 4315: 
 4316:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4317:    // and the rightSide is the side s that has s->n1 == side->n2
 4318:    for (int i = 0; i < mesh->nbs; i++) {
 4319: 
 4320:       Side *s = &mesh->localSideData[i];
 4321: 
 4322:       if (s == side) continue;  // Do not link the side to itself
 4323:    
 4324:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4325:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4326:    }
 4327:    
 4328: }
