 8402: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8403:    // Get the value of a variable from an side
 8404:    // varName is the name of the variable to get
 8405:    // var is the array to store the value
 8406:    // k is the vertical level index of the variable to get
 8407:    SIDE_BND(sideBnd);   
 8408: 
 8409:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8410:    if (sideBnd->segment->isLand) idx = -7;
 8411: 
 8412:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8413:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8414: 
 8415: }
