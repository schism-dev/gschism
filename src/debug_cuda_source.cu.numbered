 2463: 
 2464:       assert(level < nvrt && "Level is out of range");
 2465: 
 2466:       // Get the values of the field at the nodes of the element
 2467:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2468:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2469:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2470:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2471:       else          res[3] = T();
