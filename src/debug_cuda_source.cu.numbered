 5189:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5190: 
 5191:       NODE(node);
 5192: 
 5193:       node->ETP = 0.0;
 5194: 
 5195:       if constexpr(ntip == 0) return;
 5196: 
 5197:       // For all tidal potential components
 5198:       for (int j=0; j<ntip; j++) {
 5199: 
 5200:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5201: 
 5202:          node->ETP += nodeETP;
 5203: 
 5204:          if constexpr(iloadtide==1) { // loading tide
 5205:             assert(false && "Loading tide not implemented");
 5206:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5207:          }
 5208:          
 5209:       }
 5210: 
 5211:      
 5212:    }
