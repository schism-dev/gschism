 2280:    template<typename T>
 2281:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2282: 
 2283:       T values[4];
 2284: 
 2285: 
 2286:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2287:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2288:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2289:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2290:       else          values[3] = T();
 2291: 
 2292:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2293: 
 2294:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2295:    }
