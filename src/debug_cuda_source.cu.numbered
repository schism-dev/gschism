 9649: 
 9650: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 9651:    // Get the value of a variable from an side
 9652:    // varName is the name of the variable to get
 9653:    // var is the array to store the value
 9654:    // k is the vertical level index of the variable to get
 9655:    SIDE_BND(sideBnd);   
 9656: 
 9657:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 9658:    if (sideBnd->segment->isLand) idx = -7;
 9659: 
 9660:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 9661:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 9662: 
 9663: }
