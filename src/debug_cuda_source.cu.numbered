 7990: __global__ void returnMatrix(double *res) {
 7991:    // Debugging: returns the matrix as a CuPy array
 7992: 
 7993:    const int size = mesh->np;
 7994:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7995:       const Node *node = mesh->localNodeData + idx_node;
 7996:       res[idx_node*size + idx_node] = node->coeffDiag;
 7997:       for (int j = 0; j < node->numNodes; j++) {
 7998:          Node* nbNode = node->nodes[j];
 7999:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8000:       }
 8001: 
 8002:    }
 8003:    
 8004: }
