 7753:                     enddo //kk
 7754:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7755:                   } // outward flux
 7756:                 } // end for j=1,i34(ie) ! side
 7757:               } // end for k; ntr 
