 4363: 
 4364: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4365:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4366:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4367: 
 4368: 
 4369:    NODE(node1);
 4370: 
 4371:    node1->clearMatrixRow();
 4372:    node1->qel = 0.0;
 4373: 
 4374:    // THIS IS FOR STRUCTURES XXX
 4375:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4376: 
 4377:    
 4378:    for (int j=0; j<node1->numElements; j++) {
 4379:       // For each element connected to the node...
 4380: 
 4381:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4382: 
 4383:       Element *elem = node1->elements[j];
 4384: 
 4385:       // Compute the average gravity
 4386:       const double grav3 = elem->mean(&Node::grav2);
 4387: 
 4388:       // Look at the documentation for the description of the terms in the following integrals
 4389: 
 4390:       // Integral I_1 
 4391:       // \bar{\breve{H}} 
 4392:       const double hhatb = elem->mean(&Side::hhat);        
 4393: 
 4394:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4395: 
 4396:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4397:       const double area = elem->area;
 4398: 
 4399:       // Integral I_4
 4400:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4401:       // Where
 4402:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4403: 
 4404:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4405:       // of U over the element.
 4406:       const Vector2 U = elem->mean(&Side::U);
 4407: 
 4408:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4409: 
 4410:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4411:       const double I_4_1 = dot(gradPhi_1, U);
 4412: 
 4413: 
 4414:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4415:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4416: 
 4417:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4418: 
 4419: 
 4420:       // Normal component of the bed velocity
 4421:       double ubedNormalComp = 0.0;
 4422:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4423:          Vector3 ubed = {0.0, 0.0, 0.0};
 4424:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4425:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4426: 
 4427:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4428:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4429:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4430: 
 4431:          // Computes the normal component of the bed velocity
 4432:          ubedNormalComp = dot(ubed, N);
 4433:       } // imm==2
 4434: 
 4435:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4436: 
 4437:       if (elem->isTri()) {
 4438: 
 4439:          // To clarify the notation in this section: 
 4440:          //   In formulas, we use the following notation:
 4441:          //       i stands for the node under consideration (node1)
 4442:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4443:          //   However, in the code, we use the following notation:
 4444:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4445:          const int id2 = elem->nxq(1 + id1);
 4446:          const int id3 = elem->nxq(2 + id1);
 4447:          Node *node2 = elem->nodes[id2];
 4448:          Node *node3 = elem->nodes[id3];
 4449: 
 4450:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4451: 
 4452:          // integral of phi_i*phi_j
 4453:          const double ipp_ii = (1.0/6.0 )*area;
 4454:          const double ipp_ij = (1.0/12.0)*area;
 4455:          const double ipp_ik = (1.0/12.0)*area;
 4456: 
 4457:          // integral of [(grad phi_i) * (grad phi_j)]
 4458:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4459:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4460:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4461: 
 4462:          // Computes the different components of integral I_1 of each node with respect to node i.
 4463:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4464:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4465:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4466: 
 4467:          node1->addToSparseMatrix(node1, I1_ii);
 4468:          node1->addToSparseMatrix(node2, I1_ij); 
 4469:          node1->addToSparseMatrix(node3, I1_ik);
 4470: 
 4471:          #pragma unroll
 4472:          for (int l=0; l<3; l++) {
 4473: 
 4474:             Node *node = elem->nodes[l];
 4475: 
 4476:             // Additional variation in eta due to bed deformation or vertical velocity
 4477:             double extraEta = 0.0;
 4478:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4479:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4480: 
 4481: 
 4482:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4483:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4484: 
 4485:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4486: 
 4487:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4488:            
 4489:          }
 4490: 
 4491: 
 4492:       }
 4493:       else { // Quad
 4494:          // To clarify the notation in this section: 
 4495:          //   In formulas, we use the following notation:
 4496:          //       i stands for the node under consideration (node1)
 4497:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4498:          //   However, in the code, we use the following notation:
 4499:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4500:          const int id2 = elem->nxq(1 + id1);
 4501:          const int id3 = elem->nxq(2 + id1);
 4502:          const int id4 = elem->nxq(3 + id1);
 4503:          Node *node2 = elem->nodes[id2];
 4504:          Node *node3 = elem->nodes[id3];
 4505:          Node *node4 = elem->nodes[id4];   
 4506:          
 4507:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4508: 
 4509:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4510:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4511:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4512:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4513:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4514: 
 4515:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4516:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4517:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4518:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4519:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4520: 
 4521: 
 4522:          // Computes the different components of integral I_1 of each node with respect to node i.
 4523:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4524:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4525:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4526:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4527: 
 4528:          node1->addToSparseMatrix(node1, I1_ii);
 4529:          node1->addToSparseMatrix(node2, I1_ij); 
 4530:          node1->addToSparseMatrix(node3, I1_ik);
 4531:          node1->addToSparseMatrix(node4, I1_il);
 4532:   
 4533:          #pragma unroll
 4534:          for (int l=0; l<4; l++) {
 4535: 
 4536:             const Node *node = elem->nodes[l];
 4537: 
 4538:             // Additional variation in eta due to bed deformation or vertical velocity
 4539:             double extraEta = 0.0;
 4540:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4541:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4542: 
 4543:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4544:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4545:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4546: 
 4547:          }         
 4548:       } 
 4549: 
 4550: 
 4551:      node1->qel += (dt/elem->i34)*elem->vsource;
 4552:       
 4553: 
 4554:    } // for all elements connected to the node
 4555:    
 4556: 
 4557:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4558:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4559:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4560:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4561:    // If it is an open boundary node...
 4562: 
 4563:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4564: 
 4565:       // At least one open bnd side, maybe two
 4566:       for (int l=0; l<2; l++) { 
 4567: 
 4568:          // Gets each of the sides sharing the node. 
 4569:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4570: 
 4571:     
 4572: 
 4573:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4574:          if (sideBnd != nullptr) {
 4575:             // If the side is on a boundary...
 4576: 
 4577:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4578: 
 4579:             // Get the boundary segment
 4580:             const BoundarySegment *sideSegment = sideBnd->segment;
 4581:             const Side *side = sideBnd->side;
 4582: 
 4583:             // Integral I_3
 4584:             if (sideSegment->ifltype != 0) {
 4585:             // Natural or Flather b.c.
 4586: 
 4587:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4588:                // especially for Flather b.c.
 4589:                double ri3 = 0.0;
 4590:                if (!side->isDry) {
 4591:                   // If the side is not dry
 4592:                   
 4593:                   // Computes the side flux of (uth, vth)
 4594:                   double Vn = 0.0;
 4595:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4596:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4597:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4598: 
 4599:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4600:                   }
 4601: 
 4602:                   ri3 = 0.5*side->len*Vn;
 4603:                }
 4604: 
 4605:                if (sideSegment->ifltype == -1) { // Flather 1
 4606: 
 4607:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4608:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4609: 
 4610:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4611:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4612:                   
 4613:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4614:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4615: 
 4616:                } 
 4617:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4618:                   // Reset ri3
 4619:                   ri3 = 0.0;
 4620: 
 4621:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4622:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4623: 
 4624:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4625: 
 4626:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4627:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4628: 
 4629:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4630:                   node1->addToSparseMatrix(node1, con0*2.0);
 4631:                   node1->addToSparseMatrix(node2, con0);
 4632: 
 4633:                } // if Flather or Discharge
 4634: 
 4635:                node1->qel -= thetai*dt*ri3;  
 4636: 
 4637: 
 4638:             } // I_3
 4639:           
 4640: 
 4641:             // Integral I_5
 4642:             if(!side->isDry) {
 4643: 
 4644:                const double Unbar = dot(side->U, side->n);
 4645:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4646: 
 4647:             } // I_5
 4648: 
 4649:          } // if is boundary side
 4650: 
 4651:       } // for l
 4652: 
 4653:    } // if isbnd
 4654: 
 4655: 
 4656: }
 4657: 
 4658: 
 4659: 
 4660: extern "C" {
 4661:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4662:                                   int* indices, int* indptr) {
 4663: 
 4664:       NODE(node);
 4665:       
 4666:       const int idx = node->idx;
 4667:       
 4668:       // Computes the index in the nzz array      
 4669:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4670: 
 4671: 
 4672:       indptr[idx] = nzzIdx;
 4673:       indices[nzzIdx] = idx;
 4674: 
 4675:       data_d[nzzIdx]    = node->coeffDiag;
 4676: 
 4677:       b_d[idx] = node->qel;
 4678: 
 4679:       for (int k = 0; k < node->numNodes; ++k) {
 4680:          const Node* nb = node->nodes[k];
 4681: 
 4682:          const int j = nb->idx;
 4683: 
 4684:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4685: 
 4686:          indices[nzzIdx + k + 1] = j;
 4687:       }
 4688: 
 4689:  
 4690:    }
 4691: 
 4692: 
 4693: 
 4694:    __global__ void solverCopyResult(double* x) {
 4695:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4696:       NODE(node);
 4697:       const int idx = node->idx;
 4698: 
 4699:       node->mX = x[idx];
 4700:    }
 4701: 
 4702: 
 4703:    __global__ void rollUpElevation(void) {
 4704: 
 4705:       NODE(node);
 4706: 
 4707:       node->eta1 = node->eta2;
 4708: 
 4709:    }
 4710: 
 4711: 
 4712:    __global__ void backtrackAllNodes(void) {
 4713: 
 4714:       // max/min # of sub-divisions
 4715:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4716:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4717: 
 4718:       SIDE(side);
 4719: 
 4720:       const int kb = side->kb;
 4721: 
 4722: 
 4723:       // Initialize btrack velocities to the actual velocities at the side 
 4724:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4725:   
 4726:       if (side->isDry) return;
 4727:      
 4728: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4729: 
 4730:       // Checks that at least one element is not dry
 4731:       const Element *elem1 = side->elems[0];
 4732:       const Element *elem2 = side->elems[1];
 4733: 
 4734: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4735: 
 4736:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4737:       
 4738:       // XXXXXX
 4739:       // !swild_tmp to store global coord. of the starting side
 4740:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4741:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4742:       // !Use sframe2 
 4743:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4744: 
 4745: 
 4746:       for (int k = kb; k < nvrt; k++) {
 4747:       //  Initialize (xt,yt,zt), nnel and vel.
 4748:       //  For ics=2, the coordinates are all in the side's local frame
 4749:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4750: 
 4751:          const int iadvf = side->iadv();  // Advection flag   
 4752:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4753: 
 4754:          const double vmag2 = norm2(side->u2[k]);
 4755: 
 4756:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4757:             // No activity 
 4758: 
 4759:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4760: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4761: 
 4762:             
 4763:          } else {  // do btrack
 4764: 
 4765:             // Compute number of sub-divisions based on local gradients of the velocity field
 4766: 
 4767:             // XXX IS THIS NECESSARY?
 4768:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4769:             double suma = 0.0;
 4770:             int icount = 0;
 4771:             for (int l=0; l<2; l++) {
 4772:             // For each element sharing the side...
 4773: 
 4774:                const Element *elem = side->elems[l];
 4775:                  
 4776:                if (elem == nullptr) continue;
 4777: 
 4778:                icount++;
 4779: 
 4780:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4781:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4782:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4783: 
 4784:                double utmp[4];
 4785:                double vtmp[4];
 4786:                for (int j = 0; j < elem->i34; j++) {
 4787: 
 4788:                   const Node *node = elem->nodes[j];
 4789: 
 4790:                   if constexpr(ics==1) {
 4791:                      utmp[j] = node->u2[k].x;
 4792:                      vtmp[j] = node->u2[k].y;  
 4793: 
 4794:                   } else {
 4795:                      // 'Project' the velocity from the node frame to the element frame
 4796:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4797:                      utmp[j] = tmp_u2.x;
 4798:                      vtmp[j] = tmp_u2.y;
 4799: 
 4800:                   }
 4801:                } // for j
 4802: 
 4803:                const Vector2 grad_u = elem->grad2(utmp); 
 4804:                const Vector2 grad_v = elem->grad2(vtmp);
 4805:    
 4806:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4807:             } // for ii
 4808: 
 4809:             assert(icount > 0 && "Impossible 77");
 4810: 
 4811:             // '4' is somewhat arbitrary
 4812:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4813: 
 4814:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4815:             Vector3 u_int = {0.0, 0.0, 0.0};
 4816: 
 4817:             side->btrack(k, dt, dtbk, u_int);
 4818: 
 4819: 
 4820:             side->btu[k] = {u_int.x, u_int.y};
 4821:                
 4822:          } // if vmag (do backtrack)
 4823: 
 4824: 
 4825:       } // for k=kb,nvrt-1
 4826: 
 4827:    }
 4828: 
 4829: } // extern "C"
 4830: 
 4831: template<int nc>
 4832: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4833: 
 4834: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4835: //
 4836: // a,b,c,rhs: input vectors and are not modified by this program.
 4837: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4838: // rhs is the r.h.s.
 4839: // n: actual rank of the system.
 4840: // rows in u() and rhs();
 4841: // u: output with nc columns (transposed to rows)
 4842: // gam: a working array.
 4843: //
 4844: // NOTES:
 4845: // This is a template function that allows for different numbers of columns in the rhs vector.
 4846: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4847: 
 4848:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4849:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4850: 
 4851:    double bet = b[0];
 4852:    if constexpr (nc == 1) {
 4853:       u[0] = rhs[0]/bet;
 4854:    } else {
 4855:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4856:    }
 4857: 
 4858:    for (int j = 1; j < n; j++) {
 4859:       gam[j] = c[j - 1]/bet;
 4860:       bet = b[j] - a[j]*gam[j];
 4861: 
 4862:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4863: 
 4864:       if constexpr (nc == 1) {
 4865:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4866:       } else {
 4867:          for (int l = 0; l < nc; l++) {
 4868:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4869:          }
 4870:       }
 4871:    }
 4872: 
 4873:    // Back-substitution
 4874:    for (int j = n - 2; j >= 0; j--) {
 4875:       if constexpr (nc == 1) {
 4876:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4877:       } else {
 4878:          for (int l = 0; l < nc; l++) {
 4879:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4880:          }
 4881:       }
 4882:    }
 4883: }
 4884: 
 4885: 
 4886: 
 4887: // Helper function that contains the core algorithm
 4888: template<typename XAccessor, typename YAccessor>
 4889: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4890:                                     double  yp_top, double  yp_bot, 
 4891:                                     CubicSpline &spline) {
 4892:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4893:    // 
 4894:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4895:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4896:    //
 4897:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4898:    // 
 4899:    // Inputs: 
 4900:    //            n: dimension for x etc; # of data pts (>=2);
 4901:    //            getX, getY: functions to access x,y coordinates
 4902:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4903:    //     Output: 
 4904:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4905: 
 4906:    const int n = k2 - k1 + 1;
 4907:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4908: 
 4909:    // Allocate memory for the splines
 4910:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4911:    spline.x   = new double[n];
 4912:    spline.y   = new double[n];
 4913:    spline.yp  = new double[n];
 4914:    spline.ypp = new double[n];
 4915: 
 4916:    for (int k=k1; k<=k2; k++) {
 4917:       spline.x[k] = getX(k);
 4918:       spline.y[k] = getY(k);
 4919:    }
 4920: 
 4921:    // This is to simplify expressions later
 4922:    double *x = spline.x;
 4923:    double *y = spline.y;
 4924: 
 4925:    double *a = nullptr;
 4926:    double *b = nullptr;
 4927:    double *c = nullptr;
 4928:    double *gam = nullptr;
 4929:    double *rhs = nullptr;
 4930:    
 4931: 
 4932:       a = new double[n];   // Lower diagonal
 4933:       b = new double[n];   // Diagonal
 4934:       c = new double[n];   // Upper diagonal
 4935:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4936:       rhs = new double[n]; // Right-hand side
 4937: 
 4938:    for (int k=k1; k<=k2; k++) {
 4939:       if (k == k1) {
 4940:          // Bottom level
 4941:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4942:          b[k] = (x[k+1] - x[k])/3.0;
 4943:          c[k] = b[k]/2.0;
 4944:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4945:       } else if (k == n - 1) {
 4946:          // Top level (surface)
 4947:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4948:          b[k] = (x[k] - x[k-1])/3.0;
 4949:          a[k] = b[k]/2.0;
 4950:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4951:       } else {
 4952:          // Intermediate levels
 4953:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4954:          b[k] = (x[k+1] - x[k-1])/3.0;
 4955:          a[k] = (x[k  ] - x[k-1])/6.0;
 4956:          c[k] = (x[k+1] - x[k  ])/6.0;
 4957:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4958:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4959:       }
 4960:    }
 4961: 
 4962:    // Solve the tridiagonal system
 4963:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4964:    
 4965:    spline.yp[k1] = yp_bot;
 4966:    spline.yp[k2] = yp_top;
 4967: 
 4968:    // Compute rest of 1st derivatives using the splines
 4969:    for (int k=k1+1; k<k2; k++) {
 4970:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4971:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4972:    }
 4973:    
 4974:    delete[] a;
 4975:    delete[] b;
 4976:    delete[] c;
 4977:    delete[] gam;
 4978:    delete[] rhs;
 4979: 
 4980: }
 4981: 
 4982: // Array version
 4983: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4984:                                 double y_top, double y_bot, 
 4985:                                 CubicSpline &spline) {
 4986:    auto getX = [x] (int k) { return x[k]; };
 4987:    auto getY = [y] (int k) { return y[k]; };
 4988:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4989: }
 4990: 
 4991: // Lambda version - allows custom access patterns
 4992: template<typename XFunc, typename YFunc>
 4993: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4994:                                 double y_top, double y_bot,
 4995:                                 CubicSpline &spline) {
 4996:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4997: }
