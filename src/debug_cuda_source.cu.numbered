 4103:    __global__ void scaleGravity(double loadtide_coef) {
 4104: 
 4105: 
 4106:       NODE(node);
 4107: 
 4108:       // SAL option: scale gravity
 4109:       if constexpr(iloadtide==2) {  // simple const
 4110:          node->grav2 = grav*(1.0 - loadtide_coef);
 4111: 
 4112:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4113:         
 4114:           const double depth = max(node->depth, 0.0);
 4115:           const double tmp1 = sqrt(depth);
 4116:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4117:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4118:                              2.6969e-13*depth*depth*depth*tmp1;
 4119:           
 4120:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4121:           
 4122: 
 4123: 
 4124:           node->grav2 = grav*(1.0 - beta_bar);
 4125: 
 4126:       } else {  // iloadtide=0,1
 4127:         node->grav2=grav;
 4128: 
 4129:       }
 4130: 
 4131:    }
 4132: 
