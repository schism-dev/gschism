 5115: extern "C" {
 5116: 
 5117:    __global__ void scaleGravity(double loadtide_coef) {
 5118: 
 5119: 
 5120:       NODE(node);
 5121: 
 5122:       // SAL option: scale gravity
 5123:       if constexpr(iloadtide==2) {  // simple const
 5124:          node->grav2 = grav*(1.0 - loadtide_coef);
 5125: 
 5126:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5127:         
 5128:           const double depth = max(node->depth, 0.0);
 5129:           const double tmp1 = sqrt(depth);
 5130:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5131:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5132:                              2.6969e-13*depth*depth*depth*tmp1;
 5133:           
 5134:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5135:           
 5136: 
 5137: 
 5138:           node->grav2 = grav*(1.0 - beta_bar);
 5139: 
 5140:       } else {  // iloadtide=0,1
 5141:           node->grav2 = grav;
 5142: 
 5143:       }
 5144: 
 5145:    }
