 7950: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 7951: 
 7952:    ELEM(elem);
 7953: 
 7954:    switch (varCode) {
 7955:       case (int)VarCode::outputCoords:
 7956:          const Point2 coords = elem->outputCoords();
 7957:          res[elem->idx*2    ] = coords.x;
 7958:          res[elem->idx*2 + 1] = coords.y;
 7959:          break;
 7960:    }
 7961: }
