 3525:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3526: 
 3527:       NODE_BND(nodeBnd);
 3528: 
 3529:       Node *node = nodeBnd->node;
 3530: 
 3531:       node->ETP = 0.0;
 3532: 
 3533:       for (int j=0; j<ntip; j++) {
 3534: 
 3535:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3536:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3537:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3538: 
 3539:          if constexpr(iloadtide==1) { // loading tide
 3540:             assert(false && "Loading tide not implemented");
 3541:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3542:          }
 3543:          
 3544:       }
 3545:       
 3546:    }
