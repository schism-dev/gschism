 2216:    template<typename T>
 2217:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2218:       T values[4];
 2219:       getNodalValues(level, func, values);
 2220: 
 2221:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2222:       if constexpr (IsVector2<T>::value && ics == 2) {
 2223: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2224:          projectNodeVectorsToElementFrame(values);
 2225: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2226:       }
 2227: 
 2228:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2229:    }
 2230: 
 2231:    template<typename T>
 2232:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2233:       T values[4];
 2234:       getNodalValues(field, values);
 2235: 
 2236:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2237:       if constexpr (IsVector2<T>::value && ics == 2) {
 2238: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2239:          projectNodeVectorsToElementFrame(values);
 2240: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2241:       }
 2242:       
 2243:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2244:    }
 2245: 
 2246: 
 2247:    template<typename T>
 2248:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2249:       T values[4];
 2250:       getNodalValues(level, field, values);
 2251:       
 2252: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2253:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2254:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2255:       if constexpr (IsVector2<T>::value && ics == 2) {
 2256: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2257:          projectNodeVectorsToElementFrame(values);
 2258: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2259:       }
 2260: 
 2261:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2262:    }
