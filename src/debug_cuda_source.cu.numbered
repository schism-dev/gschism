 2554: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2555: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2556: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2557: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2558: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2559: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2560:    Vector2 grad = {0.0, 0.0};
 2561:    int count = 0;
 2562: 
 2563:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2564: 
 2565:    // First element
 2566:    if (elems[0] != nullptr && condition(elems[0])) {
 2567:       grad += elems[0]->grad2(field);
 2568:       count++;
 2569:    }
 2570: 
 2571:    // Second element
 2572:    if (elems[1] != nullptr && condition(elems[1])) {
 2573:       grad += elems[1]->grad2(field);
 2574:       count++;
 2575:    }
 2576: 
 2577:    if (count > 0) {
 2578:       grad = grad/count;
 2579:    }
 2580:    
 2581:    return grad;
 2582: }
