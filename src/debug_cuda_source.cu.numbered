 4229: 
 4230:    __global__ void scaleGravity(double loadtide_coef) {
 4231: 
 4232: 
 4233:       NODE(node);
 4234: 
 4235:       // SAL option: scale gravity
 4236:       if constexpr(iloadtide==2) {  // simple const
 4237:          node->grav2 = grav*(1.0 - loadtide_coef);
 4238: 
 4239:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4240:         
 4241:           const double depth = max(node->depth, 0.0);
 4242:           const double tmp1 = sqrt(depth);
 4243:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4244:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4245:                              2.6969e-13*depth*depth*depth*tmp1;
 4246:           
 4247:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4248:           
 4249: 
 4250: 
 4251:           node->grav2 = grav*(1.0 - beta_bar);
 4252: 
 4253:       } else {  // iloadtide=0,1
 4254:         node->grav2=grav;
 4255: 
 4256:       }
 4257: 
 4258:    }
 4259: 
