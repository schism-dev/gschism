 1299: struct Node {
 1300: 
 1301:    // Geometry information
 1302:    int idx;        // Index of the node
 1303:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1304:    int numNodes;   // Number of nodes neighbors of this node
 1305: 
 1306:    Element **elements; // Array of pointers to the elements that share this node
 1307:    int numElements;    // Number of elements that share this node
 1308: 
 1309:    int numSides;       // Number of sides that are connected to this node
 1310: 
 1311:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1312:    double gz;          // Global vertical coordinate at the node.
 1313:    Vector2 u2[nvrt];
 1314:    double  w2[nvrt];
 1315:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1316:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1317:    double lon, lat;
 1318:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1319:    double depth;
 1320: 
 1321:    #ifdef USE_FRAMES
 1322:    Frame frame;
 1323:    #endif
 1324: 
 1325:    #ifdef USE_LOCALIZED_SIGMA   
 1326:    double localSigma[nvrt];
 1327:    #endif
 1328: 
 1329:    int kb;       // Bottom index of the node
 1330: 
 1331:    bool isDry;     // True if the node is dry
 1332: 
 1333:    int iadv;     // Advection flag
 1334: 
 1335:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1336:                           // this is nullptr
 1337: 
 1338:    TempVar tmp; // Temporary variable to store different types of variables
 1339: 
 1340:    // Physical information
 1341:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1342:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1343: 
 1344:    double rho[nvrt];     // Density
 1345:    double dfv[nvrt];     // Vertical viscosity
 1346: 
 1347:    double eta1; // Elevation at nodes at previous timestep
 1348:    double eta2; // Elevation at nodes at current timestep
 1349: 
 1350:    double ETP;  // Earth Tidal Potential
 1351: 
 1352:    double pr;    // Air pressure
 1353:    double grav2; // Gravity 
 1354:    
 1355:    Vector2 dav;  // Depth averaged velocity
 1356: 
 1357:    Vector2 tau; // Wind stress vector
 1358: 
 1359:    // Vegetation parameters
 1360:    double veg_h;
 1361:    double veg_nv;
 1362:    double veg_di;
 1363:    double veg_Cd;
 1364:    double veg_h_unbent;
 1365:    double veg_di_unbent;
 1366:    double veg_nv_unbent;
 1367:    double veg_alpha_vert_mean;
 1368:    double veg_alpha0;
 1369:    double veg_alpha3D[nvrt];
 1370: 
 1371:    // Bottom drag parameters
 1372:    double Cd;       // Bottom drag coefficient   
 1373: 
 1374:    // These three are mutually exclusive
 1375:    union {
 1376:       double rmanning; // Bottom Manning's coefficient
 1377:       double rough;    // Bottom roughness length
 1378:       double drag;     // Bottom drag coefficient
 1379:    };
 1380:    Vector2 tau_bot; // Bottom stress vector
 1381: 
 1382:    // XXXX REMOVE FOR IMM>0???
 1383:    double bdef1; // Bottom deformation at previous timestep
 1384:    double bdef2; // Bottom deformation at current timestep
 1385: 
 1386:    double qel; // RHS
 1387:    double coeffDiag; // Diagonal coefficient of the matrix
 1388:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1389: 
 1390:    double mP; // Search direction for conjugate gradient method
 1391:    double mR; // Residual for conjugate gradient method
 1392:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1393:    double mX; // Solution for conjugate gradient method
 1394: 
 1395:    // Meteorological forcing
 1396:    Vector2 u_air;
 1397:    double p_air;  // XXXX is this the same as pr?
 1398:    double t_air;
 1399:    double q_air;
 1400:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1401: 
 1402:    __device__ void setWind(Vector2 &u) {
 1403:    // Sets the wind vector taking into account the mesh angle
 1404:    
 1405:       const double speed = length(u);
 1406: 
 1407:       // Rotate wind vector to the node frame
 1408:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1409: 
 1410:       // Sets the surface stress vector due to wind.
 1411:       if constexpr(nws == 0) {
 1412:          tau = {0.0, 0.0};
 1413: 
 1414:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1415:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1416: 
 1417:       } else {
 1418: 
 1419:          double dragcoef;
 1420: 
 1421:          if constexpr(iwind_form == -1) {
 1422:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1423:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1424: 
 1425:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1426:             tau = cff*u_air;
 1427:  
 1428:          } else if constexpr(iwind_form == 1) {
 1429:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1430:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1431: 
 1432:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1433:             tau = cff*u_air;
 1434: 
 1435:          } else {
 1436:             tau = {0.0, 0.0};
 1437:          }
 1438:       }
 1439:    }
 1440: 
 1441:    #ifdef USE_FRAMES
 1442:    __device__ void setFrame(double lat, double lon) {
 1443: 
 1444:       frame.update(lat, lon);        
 1445:     }
 1446:    #endif
 1447: 
 1448:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1449: 
 1450:    __device__ double sigmaTransitionDepth(void) const;
 1451: 
 1452:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1453: 
 1454:    __inline__ __device__ Point2 outputCoords(void) const {
 1455:       if constexpr(ics == 1)  return p;
 1456:       else                    return {rad2deg*lon, rad2deg*lat};
 1457:    }
 1458: 
 1459:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1460:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1461:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1462:    
 1463:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1464: 
 1465:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1466: 
 1467:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1468:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1469: 
 1470:    __device__ __forceinline__ void clearMatrixRow(void) {
 1471:       // Clear the matrix row for this node
 1472: 
 1473: 
 1474:       coeffDiag = 0.0;
 1475: 
 1476:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1477: 
 1478:    }
 1479: 
 1480:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1481:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1482:       
 1483:       if (node == this) {
 1484:          coeffDiag += value;
 1485:      
 1486:       } else {
 1487:          // Search (linearly)the index of the node in the array of nodes
 1488:          // XXX: This is not efficient, see if we can improve this
 1489:          int i;
 1490:          for (i = 0; i < numNodes; i++) {
 1491:             if (nodes[i] == node) {
 1492:                break;
 1493:             }
 1494:          }
 1495:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1496:          coeffMatrix[i] += value;
 1497:       }
 1498:    }
 1499: 
 1500: 
 1501:    __device__ __inline__ void updateZCoordData(void);
 1502: 
 1503:    __device__ __forceinline__ double compZCoord(int k) const;
 1504: 
 1505:    __device__ void updateKb(void);
 1506: 
 1507:    __device__ __forceinline__ void computeBottomDragCd(void);
 1508: 
 1509: 
 1510: 
 1511: };
