 2794: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2795: 
 2796: 
 2797: __device__ void Node::updateKb(void) {
 2798: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2799: 
 2800:    if constexpr(ivcor == 1) return;
 2801: 
 2802: 
 2803:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2804: 
 2805:    if constexpr(ivcor == 2) {  // SZ coordinates
 2806:       
 2807:       // Compute bottom level index
 2808:       if (depth <= mesh->h_s) {
 2809:          kb = izlev;   
 2810:          
 2811:       } else {
 2812:          kb = -1;
 2813:          int L = 0;
 2814:          int R = nzlev; 
 2815:          
 2816:          while (L <= R) {
 2817:             int M = (R + L) / 2;
 2818: 
 2819: 
 2820:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2821:             
 2822:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2823:                R = M;
 2824:             } else {
 2825:                L = M;
 2826:             }
 2827: 
 2828:             if (R - L == 1) {
 2829:                kb = L;
 2830:                break;
 2831:             }
 2832:          }
 2833: 
 2834:          // Checks that the binary search was successful
 2835:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2836:        
 2837:       }
 2838:    } 
 2839: }
 2840: 
