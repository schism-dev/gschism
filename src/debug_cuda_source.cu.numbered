 4149:    __global__ void solverCopyResult(double* x) {
 4150:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4151:       NODE(node);
 4152:       const int idx = node->idx;
 4153: 
 4154:       node->mX = x[idx];
 4155:    }
