 6205: 
 6206:    __global__ void computeVerticalVelocity(void) {
 6207:       // Computes the vertical velocity at the (2D) element's centroid.
 6208:       // In this function we will be considering volumetric elements, with side faces and a 
 6209:       // bottom and a top face. We will call them SFs, BF and TF.
 6210:       // It computes the flux coming from BF and the SFs.
 6211:       // If the bed is moving, it takes that into account.
 6212:       // Since water is incompressible, the integral of the velocity times the normal vector
 6213:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6214:       // and the BF is equal to the flux going out from the TF.
 6215:       // TF = - BF - sum(SFs).
 6216:       // It then computes the horizontal velocity at the center of TF.
 6217:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6218:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6219:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6220: 
 6221:       ELEM(elem);
 6222: 
 6223:       if (elem->isDry) return;
 6224: 
 6225:       const int kb = elem->kb;
 6226:       const bool isTri = elem->isTri();
 6227: 
 6228:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6229: 
 6230:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6231:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6232:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6233: 
 6234:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6235: 
 6236:       double area3D;
 6237: 
 6238:       // Bottom face flux
 6239:       double bottomFlux = 0.0;
 6240:       Vector2 u2meanBottom = {0.0, 0.0};
 6241:       const Vector2 gradh = elem->grad2(&Node::depth);
 6242:       if constexpr(imm==2) {
 6243:          Vector3 ubed;
 6244: 
 6245:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6246:          // updateBDEF(ubed);
 6247:      
 6248:          // const double bflux0 = dot(ubed, elem_n1);
 6249: 
 6250:          // elem->w[kb] += ubed.z;
 6251:       }
 6252:       else {
 6253:          Vector2 umean;
 6254:          if constexpr(ics == 1) {
 6255:             u2meanBottom = elem->mean(kb, &Side::u2);
 6256:          }
 6257:          else {
 6258:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6259:          }
 6260: 
 6261:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6262:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6263: 
 6264:          bottomFlux = - dot(gradh, u2meanBottom);
 6265:       } // if imm
 6266: 
 6267:       // Compute w for kb+1 to nvrt-1
 6268:       for (int l = kb; l < nvrt - 1; l++) {
 6269: 
 6270:          // normal vector to the top face of the "volumetric" element (3D)
 6271:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6272: 
 6273:          // Compute the total flux at the sides
 6274:          double sideFlux = 0.0;
 6275:          Vector2 u2top = {0.0, 0.0};
 6276:          for (int j = 0; j < elem->i34; j++) {
 6277:             const Side *side = elem->sides[j];
 6278: 
 6279:             const double sideArea = side->area(l);
 6280:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6281:             const double sign = elem->ssign[j]; 
 6282: 
 6283:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6284:          }
 6285:          
 6286:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6287:          //velocities at the centers of the sides
 6288:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6289: 
 6290:          // The flx at the top ace can be computed from the other flows.
 6291:          const double topFlux = - sideFlux - bottomFlux;
 6292:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6293: 
 6294:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6295: 
 6296:          elem_n1 = elem_n2;
 6297: 
 6298:          bottomFlux = - topFlux;
 6299:       }
 6300:    }  
 6301: 
 6302: 
 6303: 
