  217: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  218:     return make_double2(a.x + b.x, a.y + b.y);
  219: }
  220: 
  221: 
  222: 
  223: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  224:     a.x += b.x;
  225:     a.y += b.y;
  226:     return a;
  227: }
  228: 
  229: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  230:     return make_double2(a.x - b.x, a.y - b.y);
  231: }
  232: 
  233: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  234:     a.x -= b.x;
  235:     a.y -= b.y;
  236:     return a;
  237: }
