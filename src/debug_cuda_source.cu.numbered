 2635:    
 2636:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2637:    // Project the vectors from the node frame to the element frame
 2638: 
 2639:  
 2640:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2641:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2642:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2643:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2644:       else          v[3] = Vector2();
 2645:    }
 2646: 
 2647:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2648:    // Project the vectors from the side frame to the element frame
 2649: 
 2650:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2651:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2652:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2653:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2654:       else          v[3] = Vector2();
 2655:    }
