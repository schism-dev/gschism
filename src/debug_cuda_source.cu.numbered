  488: 
  489: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  490: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  491: //
  492: 
  493:    const double radius2 = dot(p, p);
  494:    const double radius = sqrt(radius2);
  495:  
  496:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  497:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  498: 
  499:    rlon = atan2(p.y, p.x); // (-pi,pi]
  500: 
  501:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  502:       rlat = asin(p.z/radius);
  503:    } else {
  504:       rlat = asin(p.z/rearth_pole);
  505:    }
  506:   
  507: }
  508: 
  509: 
  510: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  511: // Compute the 3D Cartesian coordinates from the latitude and longitude
  512: // Inputs:
  513: //        lat: latitude in radians
  514: //        lon: longitude in radians
  515: // Output:
  516: //        x, y, z: 3D Cartesian coordinates
  517: 
  518:    double sin_lat, cos_lat, sin_lon, cos_lon;
  519: 
  520:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  521:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  522: 
  523:    sincos(lat, &sin_lat, &cos_lat);
  524:    sincos(lon, &sin_lon, &cos_lon);
  525: 
  526:    const double x = rearth_eq*cos_lat*cos_lon;
  527:    const double y = rearth_eq*cos_lat*sin_lon;
  528:    const double z = rearth_pole*sin_lat;
  529: 
  530:    return make_double3(x, y, z);
  531: }
  532: 
  533: __inline__ __device__ void Error(const char* msg) {
  534:    printf("Error: %s\n", msg);
  535:    assert(false);
  536: }
