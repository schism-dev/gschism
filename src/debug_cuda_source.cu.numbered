 1698: 
 1699: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1700:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1701: 
 1702:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1703: 
 1704:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1705:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1706:    // curElement.
 1707: 
 1708:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1709:    // And uses this velocity instead to continue the tracking.
 1710: 
 1711:    // computes the intersection point in cartesian coordinates
 1712:    Point2 intersection = nextSide->p_t(tt);
 1713: 
 1714:    // Nudges the point to the barycenter of the element. 
 1715:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1716:    // next segment intersects the element sides.  
 1717:    curElem->nudgeToBarycenter(intersection);
 1718: 
 1719:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1720:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1721:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1722:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1723: 
 1724:    // If the side is an open boundary, the tangential velocity is zero.
 1725:    if (nextSide->isBnd()) vtan = 0.0;
 1726: 
 1727:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1728:    const double us = vtan*nextSide->t().x;
 1729:    const double vs = vtan*nextSide->t().y;
 1730:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1731: 
 1732:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1733:    const double len2 = length(intersection - toPoint2(xt));
 1734:    const double vel2 = u_int.x*u_int.x + u_int.y*u_int.y;        
 1735:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1736:    else            dt = 0.0;
 1737: 
 1738:    // The end of this tracking segment is now the intersection point.
 1739:    xt = {intersection.x, intersection.y, zint};
 1740: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1741:    u_int = {us, vs, ws};
 1742:    
 1743: }
 1744: 
 1745: /**
 1746:  * Tracks a particle through elements and vertical levels in the mesh.
 1747:  * 
 1748:  * @param x0,y0,z0     Starting position coordinates
 1749:  * @param xt,yt,zt     Target position coordinates
 1750:  * @param dtb          Time step for tracking
 1751:  * @param uuint,vvint,wwint Initial velocity components
 1752:  * @param nextElem     Starting/resulting element index
 1753:  * 
 1754:  * @return Status code of type trackExitCodes
 1755:  * 
 1756:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1757:  * of the details are different. The idea is that the code requires less branches and is better fit
 1758:  * for GPU execution.
 1759:  * 
 1760:  * The main ideas here are:
 1761:  * - The starting point is expected to be in the starting element.
 1762:  * - The end point is guaranteed to be inside an element.
 1763:  * - since the starting point is inside the element, there are only two cases: 
 1764:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1765:  *     (b) it does not and (xt,yt) is already in the starting element.
 1766:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1767:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1768:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1769:  * - tt1 can be positive or negative. We only consider the positive values.
 1770:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1771:  * - The next intersection will occur at the smallest positive tt1.
 1772:  * - This intersection will be the next (x0,y0) position.
 1773:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1774:  *   of getting stuck in a loop.
 1775:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1776:  *   was found.
 1777:  */
 1778: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1779:                                                        Element *&nextElem, int &jlev, double &dt) {
 1780: 
 1781:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1782:    // else to do.
 1783: 
 1784:    const Element *curElem = nextElem;
 1785:    if (containsPoint(toPoint2(xt))) {
 1786:       curElem->interpolateVelocities(xt, u_int);
 1787:       return true;
 1788:    }
 1789: 
 1790:    Side *side = nullptr;
 1791: 
 1792:    // 1. Initial checks
 1793:    // Verify starting element is valid (wet)
 1794:    assert(!curElem->isDry && "Starting element is dry");
 1795: 
 1796:    // Checks if track has a zero length.
 1797:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1798:    // assert(len2 > 0.0 && "Zero length track"); 
 1799:    
 1800:    const int MAX_ITERATIONS = 1000;
 1801:    
 1802:    double t;
 1803:    Side *nextSide = nullptr;
 1804:    double tIntersect = 1e10;
 1805:    double zint = x0.z;
 1806: 
 1807:    // Horizontal tracking loop
 1808:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1809:    // (x0,y0) is inside the element but the target point is not.
 1810: 
 1811:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1812: 
 1813:    if (!found_intersection) {
 1814: double shpCoords_0[4];
 1815: double shpCoords_t[4];
 1816: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1817: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1818:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1819:            "Elements %d, %d\n"
 1820:            "Side %d\n"
 1821:            "segment: (%f, %f),(%f, %f)\n"
 1822:            "triangle node indices: %d, %d, %d\n"
 1823:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1824:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1825:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1826:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1827:            IDX(curElem), IDX(nextElem),
 1828:            IDX(nextSide),
 1829:            x0.x, x0.y,
 1830:            xt.x, xt.y,
 1831:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1832:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1833:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1834:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1835:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1836:    }
 1837:    assert(found_intersection && "No intersection found at %d");
 1838: 
 1839:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1840: 
 1841:    // if the tracking segment goes out of water (either dry or edge boundary)
 1842:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1843: 
 1844: 
 1845:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1846:       nextElem = this;
 1847:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1848:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1849:       return true;    
 1850:    }
 1851: 
 1852: 
 1853:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1854:    int iterations = 0;
 1855:    while (iterations < MAX_ITERATIONS) {
 1856:       iterations++;
 1857:       
 1858:       Element *curElem = nextElem;
 1859: 
 1860:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1861: 
 1862:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1863: 
 1864:       // If we are already in the target element, we are done.
 1865:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1866:       if (!found_intersection) break;
 1867: 
 1868: 
 1869: 
 1870:       // if the tracking segment goes out of water (either dry or edge boundary).
 1871:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1872: 
 1873:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1874: 
 1875:          nextElem = curElem;
 1876: 
 1877: 
 1878:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1879:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1880:          return true;
 1881:       }
 1882:       
 1883:       // Update position and element for next iteration
 1884:       side = nextSide;
 1885: 
 1886:    }
 1887: 
 1888:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1889: 
 1890:  
 1891:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1892:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1893:    nextElem->interpolateVelocities(xt, u_int);
 1894: 
 1895: 
 1896:    return true;
 1897: }
 1898: 
 1899: 
 1900: __inline__ __device__ double Element::computeSignedArea(void) const {
 1901:    // Compute the area of the element
 1902: 
 1903:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1904: 
 1905:    // In the quad case we need to add the area of the other triangle.
 1906:    if (isQuad()) {
 1907:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1908:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1909:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1910:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1911:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1912:          Error("Negative area found in quad element");
 1913:       }
 1914:       res += ar1;
 1915:    }
 1916: 
 1917:    return res;
 1918: }
 1919: 
 1920: 
 1921: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 1922:                                                                 (nodes[1]->isDry2()) ||
 1923:                                                                 (nodes[2]->isDry2()) ||
 1924:                                                                 (i34==4 && nodes[3]->isDry2());
 1925: }
 1926: 
 1927: 
 1928: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1929:    // In boundary sides, the element 1 is nullptr
 1930:    return side->elems[1] == nullptr; 
 1931: }
 1932: 
 1933: 
 1934: 
 1935: /**
 1936:    Compute the shape coordinates of the point (xt,yt) in the element.
 1937:    @param xt (input): x-coordinate of the point
 1938:    @param shpCoords (output): shape coordinates of the point
 1939:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1940:    @return true if the point is inside the element, false otherwise
 1941: **/
 1942: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1943:                                             bool fixNegshpCoord) const {
 1944: 
 1945:    // Compute the shape coordinates of the point xt in the element.
 1946:    if (i34==3) {
 1947:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1948:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1949:       // and in this case, the pt will be nudged into the element
 1950:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1951:       // from the local frame, so use additional check.
 1952: 
 1953:       Point2 x0, x1, x2;
 1954: 
 1955:       if constexpr(ics==1) {
 1956:          x0 = nodes[0]->p2();
 1957:          x1 = nodes[1]->p2();
 1958:          x2 = nodes[2]->p2();
 1959:       }
 1960:       else // lat/lon
 1961:       {
 1962:          Error("Not implemented yet");
 1963: #ifdef ICS2
 1964:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1965:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1966:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1967: #endif
 1968:       }
 1969: 
 1970:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1971:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1972:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1973:       shpCoords[3] = 0.0;
 1974:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1975: 
 1976:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1977:       // then we fix the negative shape coordinates.
 1978:       if (fixNegshpCoord && tmpmin<=0.0) {
 1979: 
 1980:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 1981:          // keeping the sum of the shape coordinates equal to 1.
 1982:          // I have tested and compared the new algorithm with the old one, and they give
 1983:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 1984:          // The new algorithm should be faster since it is branchless.
 1985:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 1986:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 1987:          
 1988:          shpCoords[0] = (shpCoords[0] + a)*b;
 1989:          shpCoords[1] = (shpCoords[1] + a)*b;
 1990:          shpCoords[2] = (shpCoords[2] + a)*b;          
 1991: 
 1992:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 1993:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 1994:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 1995:          }
 1996: 
 1997:          // Update the point coordinates for the new shape coordinates
 1998:          double xcoords[3] = {x0.x, x1.x, x2.x};
 1999:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2000:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2001: 
 2002:       }
 2003: 
 2004:       // Check if the point is inside the element
 2005:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2006:    }
 2007:    else {
 2008:       Error("Not implemented yet");
 2009: #ifdef QUADS
 2010:       // Reproject pt in eframe of nel for ics=2
 2011:       if constexpr(ics==1) {
 2012:          xn2 = xt; 
 2013:          yn2 = yt;
 2014:       }
 2015:       else {
 2016:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2017:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2018:       }
 2019: 
 2020:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2021: #endif
 2022:    }
 2023: 
 2024:    return false;  // Never reached
 2025: 
 2026: }
 2027: 
 2028: 
 2029: /**  Interpolate velocities at a given point (xt,yt,zt)
 2030: 
 2031:    @param xt, yt, zt: coordinates of the point to interpolate
 2032:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2033: 
 2034:    This is done in four steps:
 2035: 
 2036:    1. Find the shape coordinates for the final position in the element.
 2037:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2038:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2039:       z levels at xt, yt at each step.   
 2040:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2041:       horizontally and vertically.
 2042: **/
 2043: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2044:    // Interpolate the velocities at the point xt. 
 2045:    // This function works the same for triangular and quadrilateral elements.
 2046:    double shpCoord[4];
 2047: 
 2048: 
 2049:    // First step is to compute the shape coordinates of (xt,yt)
 2050:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2051:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2052: 
 2053:    // Second step is to find the level that contains zt
 2054:    // Uses a binary search to find the level
 2055:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2056:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2057:    int R = nvrt - 1;
 2058: 
 2059:    // Get the z coordinates at the nodes of the element at the levels L and R
 2060:    double zLAtNodes[4], zRAtNodes[4];
 2061:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2062:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2063: 
 2064:    double zL = interpolate(shpCoord, zLAtNodes);
 2065:    double zR = interpolate(shpCoord, zRAtNodes);
 2066:    
 2067:    // Interpolates vertically the velocities
 2068:    double wght1, wght2;
 2069:    if (xt.z<=zL) {
 2070:       wght1 = 1.0;
 2071:       wght2 = 0.0;
 2072:    }
 2073:    else if (xt.z>=zR) {
 2074:       wght1 = 0.0;
 2075:       wght2 = 1.0;
 2076:    }
 2077:    else {
 2078:       // Perform a binary search to find the levels between L and R that contain xt.z
 2079:       while (R - L > 1) {
 2080:          int M = (L + R) / 2;
 2081: 
 2082:          double zMAtNodes[4];
 2083:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2084:          double zM = interpolate(shpCoord, zMAtNodes);
 2085:          if (zM < xt.z) 
 2086:          {
 2087:             L = M;
 2088:             zL = zM;
 2089:          }
 2090:          else 
 2091:          {
 2092:             R = M;
 2093:             zR = zM;
 2094:          }
 2095:       }
 2096:       assert(L == R-1);
 2097:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2098: 
 2099:       wght2 = (xt.z - zL)/(zR - zL);
 2100:       wght1 = 1.0 - wght2;
 2101:    }
 2102: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, zt, zL, zR);
 2103: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2104:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2105:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2106: 
 2107:    // Neither of the interpolated velocities should be NaN
 2108:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2109: 
 2110: }
 2111: 
 2112: 
