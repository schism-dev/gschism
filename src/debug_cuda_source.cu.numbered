 1604: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1605:    // Lock the mutex
 1606:    lock(&debugPlotMutex);
 1607:  
 1608:    if (debugPlotIdx == nullptr) return;
 1609:    if (*debugPlotIdx >= 10000) return;
 1610: 
 1611:    debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1612:    debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1613:    debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1614:    debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1615:    debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1616:    (*debugPlotIdx)++;
 1617:    // Unlock the mutex
 1618:    unlock(&debugPlotMutex);
 1619: 
 1620: }
 1621: 
 1622: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1623:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1624: }
