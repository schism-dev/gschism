 7612: __global__ void printMatrix(bool full) {
 7613:    // Debugging: print the matrix
 7614: 
 7615:    const int size = mesh->np;
 7616:    double sum = 0.0;
 7617:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7618:       const Node *node = mesh->localNodeData + idx_node;
 7619:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7620:       for (int j = 0; j < node->numNodes; j++) {
 7621:          Node* nbNode = node->nodes[j];
 7622:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7623:          sum += node->coeffMatrix[j];
 7624:       }
 7625:       if (full) printf("]\n");
 7626: 
 7627: 
 7628:    }
 7629:    if (!full) printf("sum=%lf\n", sum);
 7630: }
