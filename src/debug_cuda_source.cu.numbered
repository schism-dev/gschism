 3374: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3375:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3376:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3377:                 int *isdel, int *isidenode, int *isbnd,
 3378:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3379:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3380:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3381:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3382:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3383:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3384:                 double *drag, double *roughness,
 3385:                 double *emo, double *efa, 
 3386:                 double *umo, double *ufa, 
 3387:                 double *vmo, double *vfa) {
 3388: 
 3389:    printf("Populating mesh for partition %d\n", partNum);
 3390: 
