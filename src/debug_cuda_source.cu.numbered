 2312: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2313: // return;   
 2314:    // Lock the mutex
 2315:    lock(&debugPlotMutex);
 2316:  
 2317:    bool ok = true;
 2318:    if (debugPlotIdx == nullptr) ok = false;
 2319:    if (*debugPlotIdx >= 1000000) ok = false;
 2320:    if (ok) {
 2321:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2322:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2323:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2324:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2325:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2326:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2327:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2328:       (*debugPlotIdx)++;
 2329:    }
 2330: 
 2331:    __threadfence();               // ensure all above writes are visible
 2332:    // Unlock the mutex
 2333:    unlock(&debugPlotMutex);
 2334: 
 2335: }
