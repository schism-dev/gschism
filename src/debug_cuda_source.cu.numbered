 5176: 
 5177:       if constexpr(nws != 0 && iwindoff != 0) {
 5178:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5179:       }
 5180: 
 5181:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5182:       node->setWind(wind);
 5183: 
 5184:       node->pr = pressAir[idx];
 5185:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5186: 
 5187:    }
