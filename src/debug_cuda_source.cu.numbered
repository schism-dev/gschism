 2451: __device__ void lock(int *mutex) {
 2452:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2453: }
 2454: 
 2455: __device__ void unlock(int *mutex) {
 2456:     atomicExch(mutex, 0);
 2457: }
