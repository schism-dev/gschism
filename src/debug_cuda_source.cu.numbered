 3881: __device__ __forceinline__ int Node::packedIndex() const {
 3882:    // Returns the packed index of the node
 3883:    // Packed index is the index of the partition-block matrices and vectors.
 3884:    return nodeOffsetPerPartition[part] + localIndex();
 3885: }
