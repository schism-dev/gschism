 1567: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1568:                    Side *side = &(mesh->localSideData[idx_side]); \
 1569:                    if (idx_side >= mesh->ns) return;
 1570: 
 1571: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1572:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1573:                    if (idx_elem >= mesh->ne) return;
 1574: 
 1575: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1576:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1577:                    if (idx_node >= mesh->np) return;
 1578: 
 1579: 
 1580: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1581:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1582:                            if (idx_node_bnd >= mesh->nbp) return;
 1583: 
 1584: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1585:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1586:                            if (idx_side_bnd >= mesh->nbs) return;                           
 1587: 
 1588: Polynomial<4> *polyDischarge; // XXX read from file
