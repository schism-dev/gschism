 7178: __global__ void printMatrix(void) {
 7179:    // Debugging: print the matrix
 7180: 
 7181:    const int size = mesh->np;
 7182:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7183:       const Node *node = mesh->localNodeData + idx_node;
 7184:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7185:       for (int j = 0; j < node->numNodes; j++) {
 7186:          Node* nbNode = node->nodes[j];
 7187:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7188:       }
 7189:       printf("]\n");
 7190: 
 7191:    }
 7192: 
 7193: }
