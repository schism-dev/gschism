 8113: __global__ void getStructSizes(int* sizes)  {
 8114:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8115:       sizes[0] = (int)sizeof(Node);
 8116:       sizes[1] = (int)sizeof(Element);
 8117:       sizes[2] = (int)sizeof(Side);
 8118:       sizes[3] = (int)sizeof(NodeBoundary);
 8119:       sizes[4] = (int)sizeof(SideBoundary);
 8120:       sizes[5] = (int)sizeof(BoundarySegment);
 8121: }
