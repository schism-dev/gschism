 1738: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1739: // return;   
 1740:    // Lock the mutex
 1741:    lock(&debugPlotMutex);
 1742:  
 1743:    bool ok = true;
 1744:    if (debugPlotIdx == nullptr) ok = false;
 1745:    if (*debugPlotIdx >= 10000) ok = false;
 1746:    if (ok) {
 1747:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1748:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1749:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1750:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1751:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1752:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1753:       (*debugPlotIdx)++;
 1754:    }
 1755: 
 1756:    __threadfence();               // ensure all above writes are visible
 1757:    // Unlock the mutex
 1758:    unlock(&debugPlotMutex);
 1759: 
 1760: }
