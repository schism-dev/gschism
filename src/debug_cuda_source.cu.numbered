 4373: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4374:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4375:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4376:                 int *isdel, int *isidenode, int *isbnd,
 4377:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4378:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4379:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4380:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4381:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4382:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4383:                 double *drag, double *roughness,
 4384:                 double *emo, double *efa, 
 4385:                 double *umo, double *ufa, 
 4386:                 double *vmo, double *vfa) {
 4387: 
 4388:    printf("Populating mesh for partition %d\n", partNum);
 4389: 
 4390:    // XXXXXX THIS function does almost nothing. 
 4391: 
 4392:    nbs = *sharedIdxSideBoundary + 1;
 4393:    nbp = *sharedIdxNodeBoundary + 1;
 4394: 
 4395:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4396: 
 4397: }
