 9263: template<TurbulenceModel M>
 9264: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
 9265:    if constexpr (M == TurbulenceModel::GLS)
 9266:       return turb.tke[k];
 9267:    else
 9268:       return 0.0;
 9269: }
 9270: template<TurbulenceModel M>
 9271: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
 9272:    if constexpr (M == TurbulenceModel::GLS)
 9273:       return turb.mxl[k];
 9274:    else
 9275:       return 0.0;
 9276: }
