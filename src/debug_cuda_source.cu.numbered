 2107:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2108:       T values[4];
 2109:       getNodalValues(field, values);
 2110: 
 2111:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2112:       if constexpr (IsVector2<T>::value && ics == 2) {
 2113: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2114:          projectNodeVectorsToElementFrame(values);
 2115: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2116:       }
 2117:       
 2118:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2119:    }
