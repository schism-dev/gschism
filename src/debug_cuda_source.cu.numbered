 7715: __global__ void printMatrix(bool full) {
 7716:    // Debugging: print the matrix
 7717: 
 7718:    const int size = mesh->np;
 7719:    double sum = 0.0;
 7720:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7721:       const Node *node = mesh->localNodeData + idx_node;
 7722:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7723:       for (int j = 0; j < node->numNodes; j++) {
 7724:          Node* nbNode = node->nodes[j];
 7725:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7726:          sum += node->coeffMatrix[j];
 7727:       }
 7728:       if (full) printf("]\n");
 7729: 
 7730: 
 7731:    }
 7732:    if (!full) printf("sum=%lf\n", sum);
 7733: }
