 7853: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7854:    Node *nodes = mesh->localNodeData;
 7855: 
 7856:    *addr = nodes;
 7857:    *sizeNode = sizeof(Node);
 7858: 
 7859:    switch (varCode) {
 7860:       case (int)VarCode::depth:
 7861:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7862:          *sizeType = sizeof(double);
 7863:          break;
 7864:       case (int)VarCode::eta:
 7865:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7866:          *sizeType = sizeof(double);
 7867:          break;
 7868:       case (int)VarCode::x:
 7869:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7870:          *sizeType = sizeof(Vector2);
 7871:          break;
 7872:       case (int)VarCode::z:
 7873:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7874:          *sizeType = sizeof(double);
 7875:          break;
 7876:       case (int)VarCode::kb:
 7877:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7878:          *sizeType = sizeof(int);
 7879:          break;
 7880:       case (int)VarCode::isdry:
 7881:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7882:          *sizeType = sizeof(int);
 7883:          break;         
 7884:       case (int)VarCode::w:
 7885:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7886:          *sizeType = sizeof(double);
 7887:          break;
 7888:       case (int)VarCode::u:
 7889:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7890:          *sizeType = sizeof(Vector2);
 7891:          break;         
 7892:       default:
 7893:          *offset = -1;    
 7894:    }  
 7895:    
 7896: }
 7897: 
 7898: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7899:    // Get the value of a variable from an element
 7900:    // varName is the name of the variable to get
 7901:    // var is the array to store the value
 7902:    // k is the vertical level index of the variable to get
 7903: 
 7904:    ELEM(elem);
 7905:    
 7906:    int idx = elem->idx;
 7907:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7908: 
 7909:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7910:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7911:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7912:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7913:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7914:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7915:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7916:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7917:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7918:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7919:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7920:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7921:       
 7922:    
 7923: }
 7924: 
 7925: 
 7926: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7927:    // Get the value of a variable from an node
 7928:    // varName is the name of the variable to get
 7929:    // var is the array to store the value
 7930:    // k is the vertical level index of the variable to get
 7931: 
 7932:    NODE(node);
 7933:    
 7934:    int idx = node->idx;
 7935:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7936: 
 7937:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7938:    
 7939:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7940:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7941:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7942:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7943:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7944:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7945:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7946:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7947:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7948:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7949:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7950:    
 7951:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7952:       
 7953:    
 7954: }
 7955: 
 7956: 
 7957: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7958:    // Get the value of a variable from an side
 7959:    // varName is the name of the variable to get
 7960:    // var is the array to store the value
 7961:    // k is the vertical level index of the variable to get
 7962:    SIDE(side);
 7963:    
 7964:    int idx = side->idx;
 7965:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7966: 
 7967:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7968:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7969:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7970:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7971:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7972:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7973:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7974:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7975:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7976:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7977:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7978:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7979:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7980:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7981:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7982:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7983:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7984:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7985:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7986:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7987:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7988:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7989:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7990:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7991:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7992:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7993:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7994:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7995:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7996:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7997:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7998:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7999:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8000:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8001:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8002:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8003:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8004: }
 8005: 
 8006: 
 8007: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8008:    // Get the value of a variable from an side
 8009:    // varName is the name of the variable to get
 8010:    // var is the array to store the value
 8011:    // k is the vertical level index of the variable to get
 8012:    SIDE_BND(sideBnd);   
 8013: 
 8014:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8015:    if (sideBnd->segment->isLand) idx = -7;
 8016: 
 8017:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8018:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8019: 
 8020: }
