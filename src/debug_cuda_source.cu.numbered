 8575: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8576:    // Get the value of a variable from an side
 8577:    // varName is the name of the variable to get
 8578:    // var is the array to store the value
 8579:    // k is the vertical level index of the variable to get
 8580:    SIDE_BND(sideBnd);   
 8581: 
 8582:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8583:    if (sideBnd->segment->isLand) idx = -7;
 8584: 
 8585:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8586:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8587: 
 8588: }
