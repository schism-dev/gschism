  657: struct Element {
  658: 
  659:    // Geometry information
  660:    int idx;                   // Index of the element
  661:    int i34;                   // Number of sides for the element 
  662:    Side *sides[4];            // Sides of the element
  663:    Node *nodes[4];            // Nodes of the element
  664:    Element *nghbElems[4];     // Neighbors of the element
  665: 
  666:    int kb;                    // Bottom index of the element
  667:    double area;               // Area of the element
  668:    double ssign[4];           // Sign associated with each side of an element
  669:    double radius;             // Element equivalent radii
  670: 
  671:    #ifdef USE_FRAMES
  672:    Frame frame;
  673:    #endif
  674: 
  675:    Vector2 gradPhi[4];        // Derivatives of shape functions
  676:    Vector2 gradEta;           // Gradient of free surface elevation
  677:    Vector2 gradPr;            // Gradient of pressure    
  678:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  679: 
  680:    bool isDry;                // True if the element is dry
  681: 
  682:    Point2 center;            // Element center coordinates (global coordinates)
  683: 
  684:    double depth;              // Depth at element (min of all nodes)
  685:    double z[nvrt];            // z-coord  (local frame - vertical up)
  686: 
  687:    // Physical information
  688:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  689: 
  690:    static const bool isblock = false;              // Always false
  691: 
  692:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  693:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  694: 
  695:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  696:    
  697: 
  698:    double vsource;            // Volumetric source/sink term [m^3/s]
  699: 
  700:    double rho[nvrt];          // Density at each prism center
  701:    double rho_mean[nvrt];     // Mean density at each prism center
  702:    CubicSpline rho_spl;
  703:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  704:    double rho_z[nvrt];        // First derivative of density at each prism center
  705:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  706:    
  707: 
  708:    __inline__ __device__ Point2 outputCoords(void) const;
  709: 
  710:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  711: 
  712:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  713:    // If ics == 2, convert the global point to the local frame of the element
  714:       
  715:       if constexpr (ics == 1) {
  716:          return p;
  717:       } else {
  718:          const Point3 c = {center.x, center.y, centerZ()};
  719:          const Point3 local = frame.G2L(p - c);
  720:          return local;
  721:       }
  722:    }
  723: 
  724:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  725:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  726: 
  727:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  728:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  729: 
  730:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  731:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  732:       // Find the local index of the node in the element (0,1,2,3)
  733:       int res = __ffs((nodes[0] == node) | 
  734:                      ((nodes[1] == node) << 1) | 
  735:                      ((nodes[2] == node) << 2) | 
  736:                      ((nodes[3] == node) << 3)) - 1;
  737:       
  738:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  739:       return res;  
  740:    }
  741: 
  742:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  743:       // Find the local index of the side in the element (0,1,2,3)
  744:       int res = __ffs((sides[0] == side) | 
  745:                      ((sides[1] == side) << 1) | 
  746:                      ((sides[2] == side) << 2) | 
  747:                      ((sides[3] == side) << 3)) - 1;
  748:       
  749:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  750:       return res;
  751:    }
  752: 
  753:    __inline__ __device__ int findLevel(double z1, int k) const {
  754:       // Starting at index k, find sequentially the level that contains z
  755: 
  756:       // For testing purposes, forgets k and performs a full search.
  757:       for (k = kb; k < nvrt - 1; k++) {
  758:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  759:       }
  760:       return nvrt - 2;
  761: 
  762: 
  763:       // if z is already betweeen z[k] and z[k+1], return k
  764:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  765:       else if (z1 <  z[k]) { 
  766:          // Search for increasing levels
  767:          for (int kk = k; kk < nvrt - 1; kk++) {
  768:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  769:          }
  770:          return nvrt - 1;
  771:       }
  772:       else {
  773:          // Search for decreasing levels
  774:          for (int kk = k; kk >= kb; kk--) {
  775:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  776:          }
  777:          return 0;
  778:       }
  779:    }
  780: 
  781:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  782:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  783: 
  784: 
  785:    __device__ __forceinline__ double centerZ(void) const;
  786: 
  787:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  788:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  789:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  790:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  791:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  792: 
  793: 
  794:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  795:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  796:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  797:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  798:        const double eta = (idxNode & 1) ? +g : -g;
  799:        const double xi  = (idxNode & 2) ? +g : -g;
  800:        return {eta, xi};
  801:    }  
  802: 
  803:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  804:    __device__ __forceinline__ double etaSign(int idxNode) const {
  805:       // bit1: 0 -> -1, 1 -> +1
  806:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  807:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  808:    }
  809: 
  810:    __device__ __forceinline__ double xiSign(int idxNode) const {
  811:       // +1 if (bit0 XOR bit1), else -1
  812:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  813:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  814: 
  815:    }
  816: 
  817:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  818:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  819:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  820:    }
  821: 
  822:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  823:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  824:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  825:    }   
  826: 
  827:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  828:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  829:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  830:    }      
  831:    
  832:    __inline__ __device__ double detJ_eta(void) const;
  833: 
  834:    __inline__ __device__ double detJ_xi(void) const;
  835: 
  836:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
