 7674: 
 7675: __global__ void printMatrix(bool full) {
 7676:    // Debugging: print the matrix
 7677: 
 7678:    const int size = mesh->np;
 7679:    double sum = 0.0;
 7680:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7681:       const Node *node = mesh->localNodeData + idx_node;
 7682:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7683:       for (int j = 0; j < node->numNodes; j++) {
 7684:          Node* nbNode = node->nodes[j];
 7685:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7686:          sum += node->coeffMatrix[j];
 7687:       }
 7688:       if (full) printf("]\n");
 7689: 
 7690: 
 7691:    }
 7692:    if (!full) printf("sum=%lf\n", sum);
 7693: }
