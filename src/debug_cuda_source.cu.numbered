 8096: __global__ void printMatrix(bool full) {
 8097:    // Debugging: print the matrix
 8098: 
 8099:    const int size = mesh->np;
 8100:    double sum = 0.0;
 8101:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8102:       const Node *node = mesh->localNodeData + idx_node;
 8103:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8104:       for (int j = 0; j < node->numNodes; j++) {
 8105:          Node* nbNode = node->nodes[j];
 8106:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8107:          sum += node->coeffMatrix[j];
 8108:       }
 8109:       if (full) printf("]\n");
 8110: 
 8111: 
 8112:    }
 8113:    if (!full) printf("sum=%lf\n", sum);
 8114: }
