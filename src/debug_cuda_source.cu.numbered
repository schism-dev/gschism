 2346:    template<typename T>
 2347:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2348:       T values[4];
 2349:       getNodalValues(level, field, values);
 2350: 
 2351:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2352:       if constexpr (IsVector2<T>::value && ics == 2) {
 2353: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2354:          projectNodeVectorsToElementFrame(values);
 2355: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2356:       }
 2357: 
 2358:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2359:    }
