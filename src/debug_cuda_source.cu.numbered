 1850: // Helper functions for computing the local node index at a given offset from another.
 1851: __device__ __inline__ int nxq(int offset, int index, int size) {
 1852:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1853:    // to the index to make it positive
 1854:    assert(index + offset + 16*size >= 0);
 1855:    return (index + offset + 16*size) % size;  
 1856: }
 1857: 
 1858: __device__ __inline__ int nxq(int index, int size) {
 1859:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1860:    // to the index to make it positive
 1861:    assert(index + 16*size >= 0);
 1862:    return (index + 16*size) % size; 
 1863: }
