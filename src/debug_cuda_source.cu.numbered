10317: template<TurbulenceModel M>
10318: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
10319:    if constexpr (M == TurbulenceModel::GLS)
10320:       return turb.tke[k];
10321:    else
10322:       return 0.0;
10323: }
10324: template<TurbulenceModel M>
10325: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
10326:    if constexpr (M == TurbulenceModel::GLS)
10327:       return turb.mxl[k];
10328:    else
10329:       return 0.0;
10330: }
