 2497:       }
 2498: 
 2499:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2500:    }   
 2501: 
 2502: 
 2503: 
 2504: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2505: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2506: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2507: // Only when ics == 2, the origin is at the element center.
 2508: 
 2509:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2510: 
 2511:    const Node *node = nodes[idxNode];
 2512: 
 2513:    if constexpr(ics==1) {
 2514:       return node->p;
 2515: 
 2516:    } else {
 2517:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2518: 
 2519:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2520: 
 2521:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2522:    }
 2523: 
 2524: }
 2525: 
 2526: 
 2527: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2528:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2529: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2530: 
 2531:    const int id1 = idx;
 2532:    const int id2 = nxq(1 + id1);
 2533:    const int id3 = nxq(2 + id1);
 2534: 
 2535:    if constexpr(ics==1) {
 2536:       x0 = nodes[id1]->p;
 2537:       x1 = nodes[id2]->p;
 2538:       x2 = nodes[id3]->p;
 2539: 
 2540:    } else {
 2541: 
 2542:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2543:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2544:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2545: 
 2546:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2547:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2548:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2549: 
 2550:    }
 2551: 
 2552: }
 2553: 
 2554: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2555:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2556: }
 2557: 
 2558: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2559:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2560:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2561: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2562: 
 2563:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2564: 
 2565: 
 2566: 
 2567:    if constexpr(ics==1) {
 2568:       x0 = nodes[0]->p;
 2569:       x1 = nodes[1]->p;
 2570:       x2 = nodes[2]->p;  
 2571:       x3 = nodes[3]->p;
 2572: 
 2573:    } else {
 2574: 
 2575:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2576:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2577:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2578:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2579: 
 2580:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2581:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2582:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2583:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2584:    }
 2585: 
 2586: }
 2587: 
 2588: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2589:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2590: {
 2591:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2592: }
 2593: 
 2594: 
 2595: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2596: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2597: // Returns the normal vector and the area of the element at this level
 2598:    
 2599:    double nx, ny, nz;
 2600: 
 2601:    if (isTri()) {
 2602:       // For triangles...
 2603: 
 2604:       // Indices of the nodes at level k, taking care of not going below the bed
 2605:       const int k0 = max(k, nodes[0]->kb);
 2606:       const int k1 = max(k, nodes[1]->kb);
 2607:       const int k2 = max(k, nodes[2]->kb);
 2608: 
 2609:       // Gets the element frame coordinates of the nodes at level k
 2610:       Point3 x0, x1, x2;
 2611:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2612:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2613:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2614:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2615: 
 2616:       } else {  // ics == 2
 2617:          Point2 h0, h1, h2;
 2618: 
 2619:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2620: 
 2621:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2622:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2623:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2624:       }
 2625: 
 2626:       const Vector3 n20 = x2 - x0;
 2627:       const Vector3 n10 = x1 - x0; 
 2628: 
 2629:       // Computes the cross product of vectors n20 and n10. 
 2630:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2631:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2632:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2633: 
 2634:   
 2635:    }
 2636:    else {
 2637:       // For quads...
 2638:       Point2 h0, h1, h2, h3;
 2639: 
 2640:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2641: 
 2642:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2643:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2644:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2645:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2646: 
 2647:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2648:       nx = n20.y*n31.z - n20.z*n31.y;
 2649:       ny = n20.z*n31.x - n20.x*n31.z;
 2650:       nz = n20.x*n31.y - n20.y*n31.x;
 2651: 
 2652:    }
 2653: 
 2654:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2655:    area3D = 0.5*len;
 2656: 
 2657:    const double inv_len = 1.0/len;
 2658: 
 2659:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2660: 
 2661: }
 2662: 
 2663: 
 2664: // Helper functions to get the 2D local node position for the Celestial walk
 2665: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2666:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2667:    const Node *node = getNodeInOrder(idx2);
 2668: 
 2669:    double z = 0.0;
 2670:    if constexpr(ics == 2) z = node->gz;
 2671:    
 2672:    Point3 p = toPoint3(node->p, z);
 2673: 
 2674:    return toPoint2(origSide->toLocalFrame(p));
 2675: }
 2676: 
 2677: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2678:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2679: }
 2680: 
 2681: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2682:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2683: // Computes the three per-side predicates needed for the celestial walk
 2684: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2685: //
 2686: // xt is in local frame coordinates for origSide if ics == 2.
 2687: //
 2688: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2689: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2690: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2691: // meaningless on triangles are masked to a safe value (see comments below).
 2692: {
 2693:    // Project all 4 corner positions once into the local 2D frame.
 2694:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2695:    // getLocalNodePosition only transforms/projects if ics == 2.
 2696:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2697:                         getLocalNodePosition(1, origSide), 
 2698:                         getLocalNodePosition(2, origSide), 
 2699:                         getLocalNodePosition(3, origSide)};
 2700: 
 2701:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2702:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2703:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2704:    // But still farther towards the target point from the current point.
 2705:    const Vector2 vt0 = xt - x0;
 2706:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2707:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2708:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2709: 
 2710:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2711:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2712: 
 2713: 
 2714: // if (origSide->idx == 2860848 && jlev == 46) {
 2715: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2716: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2717: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2718: // }
 2719:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2720:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2721:    //  here the orientation is baked into the corners array.)
 2722:    const int i3 = nxq(3);
 2723:    const Vector2 s0 = C[ 1] - C[ 0];
 2724:    const Vector2 s1 = C[ 2] - C[ 1];
 2725:    const Vector2 s2 = C[i3] - C[ 2];
 2726:    const Vector2 s3 = C[ 0] - C[i3];
 2727:    
 2728:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2729:    // The corners array is built from getNode in CCW order, so the orientation
 2730:    // is already correct and no ssign factor is needed in the formulas below.
 2731:    //
 2732:    // i3 = nxq(3): the index of the corner after side 2.
 2733:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2734:    //   Quad:     i3 == 3.
 2735:    //
 2736:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2737:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2738:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2739:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2740:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2741:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2742: 
 2743: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2744: 
 2745:    // For triangles, the corner after side 2 is the closing corner where
 2746:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2747:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2748:    // s0 for triangles, s3 for quads.
 2749:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2750: 
 2751:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2752:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2753:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2754:    //
 2755:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2756:    // result is false naturally. No sentinel needed.
 2757:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2758:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2759:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2760:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2761: 
 2762:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2763:    // on the "exit through side I" half of the corner cone, separated by the
 2764:    // approximate angular bisector of the celestial walk. The bisector is
 2765:    // perpendicular to the chord across the corner; the test is the sign of
 2766:    // (xt - corner_vertex) projected onto that chord.
 2767:    //
 2768:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2769:    // (the validity rule sets valid_3 = false), so its computed value for
 2770:    // triangles doesn't matter. No sentinel needed.
 2771:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2772:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2773:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2774:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2775: 
 2776: }
 2777: 
 2778: 
 2779: __inline__ __device__ double Element::computeSignedArea(void) const {
 2780:    // Compute the area of the element
 2781: 
 2782:    Point2 x0, x1, x2, x3;
 2783:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2784: 
 2785: 
 2786:    double res = signedArea(x0, x1, x2);
 2787: 
 2788:    // In the quad case we need to add the area of the other triangle.
 2789:    if (isQuad()) {
 2790:       x3 = getLocalHorizontalNodePosition(3);
 2791:       double ar1 = signedArea(x0, x2, x3);
 2792:       double ar2 = signedArea(x0, x1, x3);
 2793:       double ar3 = signedArea(x1, x2, x3);
 2794:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2795: 
 2796:       res += ar1;
 2797: 
 2798:    }
 2799: 
 2800:    return res;
 2801: }
 2802: 
 2803: 
 2804: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2805:                                                                 (nodes[1]->isDry2()) ||
 2806:                                                                 (nodes[2]->isDry2()) ||
 2807:                                                                 (isQuad() && nodes[3]->isDry2());
 2808: }
 2809: 
 2810: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2811:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2812: }
 2813: 
 2814: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2815:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2816: }
 2817: 
 2818: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2819:    // In boundary sides, the element 1 is nullptr
 2820:    return side->elems[1] == nullptr; 
 2821: }
 2822: 
 2823: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2824:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2825:    // For ics == 2, this function uses local frame coordinates.
 2826: 
 2827:    assert(isQuad());
 2828: 
 2829:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2830:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2831:    // where vxi, veta, vb are vectors and c is the center of the element.
 2832: 
 2833:    Point2 p0, p1, p2, p3;
 2834: 
 2835:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2836: 
 2837:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2838:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2839:    // vectors vxi and veta connect the centers of opposite sides
 2840:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2841:    // vb is zero for parallelogram elements.
 2842:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2843: 
 2844:    //  The bilinear mapping is:
 2845:    //      P(s,t) = C + s*U + t*V + s*t*W
 2846:    //
 2847:    //  where:
 2848:    //    C = centroid (average of four vertices)
 2849:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2850:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2851:    //    W = bilinear correction; measures deviation from parallelogram
 2852:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2853:    //        W = 0 for parallelogram elements.
 2854:    //
 2855:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2856:    //
 2857:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2858:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2859:    //
 2860:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2861:    //
 2862:    //  Geometrically, (L) projects everything onto the direction
 2863:    //  perpendicular to W, where the mapping is purely affine.
 2864:    //
 2865:    //  The dot product with nb retains the nonlinear term:
 2866:    //
 2867:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2868:    //
 2869:    //  Geometrically, (Q) projects onto the W direction, where
 2870:    //  the nonlinearity lives.
 2871:    //
 2872:    //  We solve (L) for whichever variable has the larger coefficient
 2873:    //  (better conditioned back-substitution), substitute into (Q),
 2874:    //  and get a scalar quadratic in the other variable.
 2875:    // ================================================================
 2876: 
 2877:    // ---- Basis vectors ----
 2878:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2879:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2880:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2881:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2882:    // W: nonlinear correction. Difference between quad and parallelogram.
 2883:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2884:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2885: 
 2886:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2887:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2888:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2889:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2890:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2891: 
 2892:    // ---- nb: direction parallel to W, L1-normalized ----
 2893:    // We don't need a unit vector -- just a well-scaled direction parallel
 2894:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2895:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2896:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2897:    //
 2898:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2899:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2900:    // and the quadratic solver takes its linear path (a ~ 0).
 2901:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2902:    const double inv_wlen = 1.0 / wlen1;
 2903:    const Vector2 nb = vb * inv_wlen;
 2904: 
 2905:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2906:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2907:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2908:    // What remains is a pure affine relationship between xi and eta.
 2909:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2910:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2911:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2912: 
 2913:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2914:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2915:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2916:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2917:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2918:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2919:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2920: 
 2921:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2922:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2923:    // minimizing round-off amplification.
 2924:    //
 2925:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2926:    // that uses predicated moves.
 2927:    //
 2928:    // if (fabs(Ls) > fabs(Lt)) {
 2929:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2930:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2931:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2932:    //    const double A = -Qw * Lt;
 2933:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2934:    //    const double C =  Qs * Lp - Qp * Ls;
 2935: 
 2936:    //    double eta1, eta2;
 2937:    //    solveQuadratic(A, B, C, eta1, eta2);
 2938: 
 2939:    //    // Pick root with smaller |eta| (domain centered at 0).
 2940:    //    // Ternary-> predicated move, no branch divergence.
 2941:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2942: 
 2943:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2944:    //    xi = (Lp - Lt * eta) / Ls;
 2945: 
 2946:    // } else {
 2947:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2948:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2949:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2950:    //    const double A = -Qw * Ls;
 2951:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2952:    //    const double C =  Qt * Lp - Qp * Lt;
 2953: 
 2954:    //    double xi1, xi2;
 2955:    //    solveQuadratic(A, B, C, xi1, xi2);
 2956: 
 2957:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2958: 
 2959:    //    eta = (Lp - Ls * xi) / Lt;
 2960:    // }
 2961:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2962:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2963:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2964:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2965:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2966: 
 2967:    // Quadratic:  A*r^2 + B*r + C = 0
 2968:    // (same formula for both cases, just with swapped coefficients)
 2969:    const double A = -Qw * Lb;
 2970:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2971:    const double C =  Qa * Lp - Qp * La;
 2972: 
 2973:    double r1, r2;
 2974:    solveQuadratic(A, B, C, r1, r2);
 2975: 
 2976:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2977:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2978: 
 2979:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2980:    const double other = (Lp - Lb * r) / La;
 2981: 
 2982:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2983:    xi  = solve_s ? r     : other;
 2984:    eta = solve_s ? other : r;
 2985: 
 2986: 
 2987:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2988:    xi  = clamp(xi,  -1.0, 1.0);
 2989:    eta = clamp(eta, -1.0, 1.0);
 2990: 
 2991:    // ---- Shape functions ----
 2992:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2993:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2994:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2995:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2996:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2997:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2998:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2999:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3000: 
 3001:    return true;
 3002: }
 3003: 
 3004: /**
 3005:    Compute the shape coordinates of the point (xt,yt) in the element.
 3006:    @param xt (input): x-coordinate of the point
 3007:    @param shpCoords (output): shape coordinates of the point
 3008:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3009:    @return true if the point is inside the element, false otherwise
 3010: **/
 3011: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3012: 
 3013:    // Compute the shape coordinates of the point xt in the element.
 3014:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3015:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3016:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3017:    // from the local frame, so use additional check.
 3018: 
 3019: 
 3020:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3021: 
 3022:    if (isTri()) { // Triangular element
 3023: 
 3024:       // Horizontal local node coordinates. 
 3025:       Point2 x0, x1, x2;
 3026:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3027: 
 3028:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3029:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3030:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3031:       shpCoords[3] = 0.0;
 3032: 
 3033:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3034:       const bool res = (tmpmin >= -small);  
 3035:       
 3036:       // When to fix the negative shape coordinates?
 3037:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3038: 
 3039:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3040:       // then we fix the negative shape coordinates.
 3041:       if ((tmpmin < 0) && fix) {
 3042: 
 3043:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3044:          // keeping the sum of the shape coordinates equal to 1.
 3045:          // I have tested and compared the new algorithm with the old one, and they give
 3046:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3047:          // The new algorithm should be faster since it is branchless.
 3048:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3049:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3050: 
 3051:          shpCoords[0] = (shpCoords[0] + a)*b;
 3052:          shpCoords[1] = (shpCoords[1] + a)*b;
 3053:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3054: 
 3055:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3056:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3057:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3058: 
 3059:          // Update the point coordinates for the new shape coordinates
 3060:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3061:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3062: 
 3063:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3064: 
 3065:       }
 3066: 
 3067:       // Return true if the point is inside the element
 3068:       return res;      
 3069:    }
 3070:    else {
 3071:       assert(isQuad() && "computeShapeCoords");
 3072: 
 3073:       // Horizontal local node coordinates with respect to the original side.
 3074:       Point2 x0, x1, x2, x3;
 3075:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3076: 
 3077:       const double a0 = signedArea(x0, x1, xt);
 3078:       const double a1 = signedArea(x1, x2, xt);
 3079:       const double a2 = signedArea(x2, x3, xt);
 3080:       const double a3 = signedArea(x3, x0, xt);
 3081: 
 3082:       const double minArea = min4(a0, a1, a2, a3);
 3083:       
 3084:       const bool res = (minArea > -small*area);
 3085: 
 3086:       // When to fix the negative shape coordinates?
 3087:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3088: 
 3089:       double xi, eta;    
 3090: 
 3091:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3092:       // Does nothing if ics == 1.
 3093:       assert(origSide != nullptr);
 3094:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3095: 
 3096:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3097: 
 3098:       if (fix) {
 3099:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3100:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3101:          xt.x = interpolate(shpCoords, xn);
 3102:          xt.y = interpolate(shpCoords, yn);
 3103:       }
 3104: 
 3105:       return res;
 3106:    }
 3107: 
 3108: 
 3109:    assert(false && "computeShapeCoords: should never reach this point");
 3110:    return false;  // Never reached
 3111: 
 3112: }
 3113: 
 3114: 
 3115: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3116: // Convert shape coordinates to cartesian coordinates
 3117: 
 3118:    if (isTri()) {
 3119:       // Triangular element
 3120: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3121:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3122:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3123:    }
 3124:    else {
 3125:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3126:    }
 3127: 
 3128: }
 3129: 
 3130: 
 3131: 
 3132: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3133:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3134:    
 3135:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3136: }
 3137: 
 3138: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3139:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3140:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3141:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3142:    return area * dot(gradPhi[i], gradPhi[j]);
 3143: }
 3144: 
 3145: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3146:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3147:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3148:    // The formula for the integral is:
 3149:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3150:    
 3151:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3152:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3153:    const double eta_sum  = eta_n(i) + eta_n(j);
 3154:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3155: 
 3156:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3157:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3158: 
 3159: 
 3160:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3161: }
 3162:    
 3163: 
 3164: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3165:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3166:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3167:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3168:    // The formula is also based on the identity:
 3169:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3170:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3171: 
 3172:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3173: 
 3174: 
 3175: 
 3176:    double res = 0.0;
 3177:    
 3178:    // Quadrature points in xi and eta coordinates
 3179:    #pragma unroll
 3180:    for (int i = 0; i < 4; i++) {
 3181:       // For each quadrature point...
 3182: 
 3183:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3184:       const double eta = p.x;
 3185:       const double xi  = p.y;
 3186: 
 3187:       // Jacobian entries at the Gauss point p
 3188:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3189:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3190:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3191:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3192: 
 3193:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3194:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3195: 
 3196:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3197:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3198:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3199:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3200:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3201: 
 3202:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3203:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3204:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3205:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3206:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3207: 
 3208:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3209:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3210:    }
 3211: 
 3212:    return res;
 3213: }
 3214: 
 3215: 
 3216: /**  Interpolate velocities at a given point (xt,yt,zt)
 3217: 
 3218:    @param xt, yt, zt: coordinates of the point to interpolate
 3219:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3220: 
 3221:    This is done in four steps:
 3222: 
 3223:    1. Find the shape coordinates for the final position in the element.
 3224:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3225:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3226:       z levels at xt, yt at each step.   
 3227:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3228:       horizontally and vertically.
 3229: **/
 3230: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3231:    // Interpolate the velocities at the point xt. 
 3232:    // This function works the same for triangular and quadrilateral elements.
 3233:    double shpCoord[4];
 3234:    Vector3 u_int;
 3235: 
 3236: 
 3237:    // First step is to compute the shape coordinates of (xt,yt)
 3238: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3239:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3240: 
 3241:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3242: 
 3243:    // Second step is to find the level that contains zt
 3244:    // Uses a binary search to find the level
 3245:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3246:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3247:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3248:    int R = nvrt - 1;
 3249: 
 3250:    // Get the z coordinates at the nodes of the element at the levels L and R
 3251:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3252:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3253:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3254: 
 3255: 
 3256:    double zL = interpolate(shpCoord, zLAtNodes);
 3257:    double zR = interpolate(shpCoord, zRAtNodes);
 3258: 
 3259:    // Interpolates vertically the velocities
 3260:    double wght1, wght2;
 3261:    if (xt.z <= zL) {
 3262:       wght1 = 1.0;
 3263:       wght2 = 0.0;
 3264:       xt.z = zL;
 3265:    }
 3266:    else if (xt.z >= zR) {
 3267:       wght1 = 0.0;
 3268:       wght2 = 1.0;
 3269:       xt.z = zR;
 3270:    }
 3271:    else {
 3272:       // Perform a binary search to find the levels between L and R that contain xt.z
 3273:       while (R - L > 1) {
 3274:          int M = (L + R) / 2.0;
 3275: 
 3276:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3277:          double zM = interpolate(shpCoord, zMAtNodes);
 3278:          if (zM < xt.z) 
 3279:          {
 3280:             L = M;
 3281:             zL = zM;
 3282:          }
 3283:          else 
 3284:          {
 3285:             R = M;
 3286:             zR = zM;
 3287:          }
 3288:       }
 3289:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3290:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3291: 
 3292:       wght2 = (xt.z - zL)/(zR - zL);
 3293:       wght1 = 1.0 - wght2;
 3294: 
 3295:    }
 3296: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3297: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3298:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3299:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3300:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3301:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3302: 
 3303:    // Project the velocity from the local frame to the origSide frame
 3304:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3305:    u_int = {uv.x, uv.y, w};
 3306: 
 3307:    // Neither of the interpolated velocities should be NaN
 3308:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3309: 
 3310:    return u_int;
 3311: 
 3312: }
 3313: 
 3314: 
 3315: 
 3316: 
 3317: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3318: 
 3319:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3320:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3321:    const Node *n1 = side->n1;
 3322:    const Node *n2 = side->n2;
 3323: 
 3324:    bool n1_match = (n1->nodeBnd->segment == segment);
 3325:    bool n2_match = (n2->nodeBnd->segment == segment);
 3326: 
 3327:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3328:    if (n1_match && n2_match) {
 3329:       return 0.5;
 3330:    } else if (n1_match) {
 3331:       return 1.0;
 3332:    } else if (n2_match) {
 3333:       return 0.0;
 3334:    }
 3335: 
 3336:    return 0.0;
 3337: }
 3338: 
 3339: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3340: 
 3341: 
 3342: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3343: 
 3344:    const double w1 = getBoundaryArrayValueWeight();
 3345:    const double w2 = 1.0 - w1;
 3346:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3347:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3348: 
 3349:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3350: }
 3351: 
