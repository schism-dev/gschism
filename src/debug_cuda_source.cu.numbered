 3116: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3117:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3118:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3119:    // The formula for the integral is:
 3120:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3121: 
 3122:    printf("intPhiPhi: TEST\n");
 3123: 
 3124:    const Node *n0 = nodes[0];
 3125:    const Node *n1 = nodes[1];
 3126:    const Node *n2 = nodes[2];
 3127:    const Node *n3 = nodes[3];
 3128: 
 3129:    const Vector2 p0 = n0->p;
 3130:    const Vector2 p1 = n1->p;
 3131:    const Vector2 p2 = n2->p;
 3132:    const Vector2 p3 = n3->p;
 3133: assert(false && "intPhiPhiQuad:CHECK?");
 3134: 
 3135:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3136:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3137:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3138:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3139: 
 3140:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3141: }
 3142:    
 3143: 
 3144: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3145:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3146:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3147:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3148:    // The formula is also based on the identity:
 3149:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3150:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3151: 
 3152:    printf("intGradPhiGradPhi: TEST\n");   
 3153: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3154:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3155: 
 3156:    const double x0 = nodes[0]->p.x;
 3157:    const double y0 = nodes[0]->p.y;
 3158:    const double x1 = nodes[1]->p.x;
 3159:    const double y1 = nodes[1]->p.y;
 3160:    const double x2 = nodes[2]->p.x;
 3161:    const double y2 = nodes[2]->p.y;
 3162:    const double x3 = nodes[3]->p.x;
 3163:    const double y3 = nodes[3]->p.y;
 3164: 
 3165:    double res = 0.0;
 3166:    
 3167:    // Quadrature points in xi and eta coordinates
 3168:    #pragma unroll
 3169:    for (int i = 0; i < 4; i++) {
 3170:       // For each quadrature point...
 3171: 
 3172:       const Point2 p = GaussPoint(i);
 3173:       const double eta = p.x;
 3174:       const double xi  = p.y;
 3175: 
 3176:       // Jacobian entries at the Gauss point p
 3177:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3178:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3179:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3180:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3181: 
 3182:       const double detJ = jacobianDet(p);
 3183:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3184: 
 3185:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3186:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3187:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3188:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3189:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3190: 
 3191:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3192:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3193:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3194:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3195:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3196: 
 3197:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3198:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3199:    }
 3200: 
 3201:    return res;
 3202: }
 3203: 
 3204: 
 3205: /**  Interpolate velocities at a given point (xt,yt,zt)
 3206: 
 3207:    @param xt, yt, zt: coordinates of the point to interpolate
 3208:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3209: 
 3210:    This is done in four steps:
 3211: 
 3212:    1. Find the shape coordinates for the final position in the element.
 3213:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3214:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3215:       z levels at xt, yt at each step.   
 3216:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3217:       horizontally and vertically.
 3218: **/
 3219: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3220:    // Interpolate the velocities at the point xt. 
 3221:    // This function works the same for triangular and quadrilateral elements.
 3222:    double shpCoord[4];
 3223:    Vector3 u_int;
 3224: 
 3225:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 3226: 
 3227:    // First step is to compute the shape coordinates of (xt,yt)
 3228: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3229:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 3230: 
 3231:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3232: 
 3233:    // Second step is to find the level that contains zt
 3234:    // Uses a binary search to find the level
 3235:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3236:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3237:    int R = nvrt - 1;
 3238: 
 3239:    // Get the z coordinates at the nodes of the element at the levels L and R
 3240:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3241:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3242:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3243: 
 3244:    double zL = interpolate(shpCoord, zLAtNodes);
 3245:    double zR = interpolate(shpCoord, zRAtNodes);
 3246:    
 3247:    // Interpolates vertically the velocities
 3248:    double wght1, wght2;
 3249:    if (xt.z<=zL) {
 3250:       wght1 = 1.0;
 3251:       wght2 = 0.0;
 3252:       xt.z = zL;
 3253:    }
 3254:    else if (xt.z>=zR) {
 3255:       wght1 = 0.0;
 3256:       wght2 = 1.0;
 3257:       xt.z = zR;
 3258:    }
 3259:    else {
 3260:       // Perform a binary search to find the levels between L and R that contain xt.z
 3261:       while (R - L > 1) {
 3262:          int M = (L + R) / 2.0;
 3263: 
 3264:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3265:          double zM = interpolate(shpCoord, zMAtNodes);
 3266:          if (zM < xt.z) 
 3267:          {
 3268:             L = M;
 3269:             zL = zM;
 3270:          }
 3271:          else 
 3272:          {
 3273:             R = M;
 3274:             zR = zM;
 3275:          }
 3276:       }
 3277:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3278:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3279: 
 3280:       wght2 = (xt.z - zL)/(zR - zL);
 3281:       wght1 = 1.0 - wght2;
 3282: 
 3283:    }
 3284: 
 3285: if (R< 0 || R>49) printf("KKKK R = %d, L = %d, wght1 = %.17f, wght2 = %.17f\n", R, L, wght1, wght2);
 3286:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3287:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3288:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3289:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3290: 
 3291:    // Neither of the interpolated velocities should be NaN
 3292:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3293: 
 3294:    return u_int;
 3295: 
 3296: }
 3297: 
