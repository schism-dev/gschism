 2728: 
 2729: __device__ void Node::updateKb(void) {
 2730: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2731: 
 2732:    if constexpr(ivcor == 1) return;
 2733: 
 2734: 
 2735:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2736: 
 2737:    if constexpr(ivcor == 2) {  // SZ coordinates
 2738:       
 2739:       // Compute bottom level index
 2740:       if (depth <= mesh->h_s) {
 2741:          kb = izlev;   
 2742:          
 2743:       } else {
 2744:          kb = -1;
 2745:          int L = 0;
 2746:          int R = nzlev; 
 2747:          
 2748:          while (L <= R) {
 2749:             int M = (R + L) / 2;
 2750: 
 2751: 
 2752:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2753:             
 2754:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2755:                R = M;
 2756:             } else {
 2757:                L = M;
 2758:             }
 2759: 
 2760:             if (R - L == 1) {
 2761:                kb = L;
 2762:                break;
 2763:             }
 2764:          }
 2765: 
 2766:          // Checks that the binary search was successful
 2767:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2768:        
 2769:       }
 2770:    } 
 2771: }
 2772: 
