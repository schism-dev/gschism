 4293:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4294: 
 4295:       NODE_BND(nodeBnd);
 4296: 
 4297:       Node *node = nodeBnd->node;
 4298: 
 4299:       node->ETP = 0.0;
 4300: 
 4301:       for (int j=0; j<ntip; j++) {
 4302: 
 4303:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4304:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4305:    
 4306:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4307: 
 4308:          if constexpr(iloadtide==1) { // loading tide
 4309:             assert(false && "Loading tide not implemented");
 4310:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4311:          }
 4312:          
 4313:       }
 4314:       
 4315:    }
