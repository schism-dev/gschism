 3956:    __global__ void computeFlowBcVelocities(double time) {
 3957: 
 3958:       SIDE_BND(sideBnd);
 3959: 
 3960:       const Side *side = sideBnd->side;
 3961:  
 3962:       const bool isDry = side->isDry;
 3963: 
 3964:       if (isDry) {
 3965:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 3966:          return;
 3967:       }
 3968: 
 3969:       // For wet sides in open boundaries...
 3970:       const Vector2 n = side->n;
 3971:       const BoundarySegment *segment = sideBnd->segment;
 3972: 
 3973:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 3974: 
 3975:       const int ifltype = segment->ifltype;
 3976:       const int iettype = segment->iettype;
 3977: 
 3978:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 3979:       const Vector2 r_nuth0 = r_uth0*n;
 3980: 
 3981:       for (int k = 0; k < nvrt; k++) {
 3982:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 3983:          Vector2 r_u1_bar = {0.0, 0.0};
 3984:       
 3985:          if (ifltype == 1 || ifltype == 2) {
 3986:          
 3987:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 3988: 
 3989:             const double unth0 = segment->qthcon*ramp/segment->carea;
 3990:             
 3991:             r_uth = unth0*n;  // This case has no ramp-up
 3992:             
 3993:          } else if (ifltype == -1) { // Flather 1
 3994: 
 3995:             // uth is the normal vel.; no ramp up
 3996:             const double uth = sideBnd->nuth(k);
 3997:             r_uth = uth*n;
 3998:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 3999: 
 4000: 
 4001:          } else if (ifltype == 3 || ifltype == 5) {
 4002:             // vnth0=0 !normal vel.
 4003: 
 4004:             // Computes the contribution to the velocity from all tide frequencies
 4005:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4006: 
 4007:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4008:                const Vector2 umo  = sideBnd->umo(jfr); 
 4009: 
 4010:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4011:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4012:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4013:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4014:             }
 4015: 
 4016:          } // if (ifltype = 3 || ifltype == 5
 4017: 
 4018: 
 4019:          switch (iettype) {
 4020:             case 1:
 4021:             case 2:
 4022:             case 4:
 4023:                sideBnd->ubc[k] = r_uth;
 4024:                break;
 4025:             case 3:
 4026:                sideBnd->ubc[k] = r_u1_bar;
 4027:                break;
 4028:             case 5:
 4029:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4030:                break;
 4031:          } // switch
 4032: 
 4033:       } // for k
 4034:    }
 4035: 
 4036:    __global__ void computeElevationBoundaryConditions(double time) {
 4037:       // Compute elevation essential boundary conditions 
 4038: 
 4039:       NODE_BND(nodeBnd); // Each boundary node.
 4040: 
 4041:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4042: 
 4043:       const Node *node = nodeBnd->node;
 4044:       const BoundarySegment *segment = nodeBnd->segment;
 4045:       const int iettype = segment->iettype;
 4046:       
 4047: 
 4048:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4049:       double eic = 0.0;
 4050:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4051:       else                 eic = 0.0;
 4052: 
 4053:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4054:       const double r_eth = ramp*nodeBnd->eth;
 4055:       double r_eta1_bar = 0.0;
 4056: 
 4057: 
 4058:       // Compute tide elevation
 4059:       if (iettype == 3 || iettype == 5) {   
 4060: 
 4061:          if constexpr(iloadtide==1) { // loading tide
 4062:             assert(false && "Loading tide not implemented");
 4063:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4064:          }
 4065:          
 4066:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4067: 
 4068:             const double efa  = nodeBnd->efa[jfr]; 
 4069:             const double emo  = nodeBnd->emo[jfr]; 
 4070: 
 4071:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4072:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4073:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4074: 
 4075:          } // for jfr
 4076: 
 4077:       } // if iettype
 4078: 
 4079:       switch (iettype) {
 4080:          case 1:
 4081:          case 2:
 4082:          case 4:
 4083:             nodeBnd->elbc = r_eic + r_eth;
 4084:             break;
 4085:          case 3:
 4086:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4087:             break;
 4088:          case 5:
 4089:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4090:             break;
 4091:       } // switch
 4092: 
 4093: 
 4094:       //Add inverse barometric effects
 4095:       if (iettype != 0 && inv_atm_bnd == 1) {
 4096:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4097:       }
 4098: 
 4099:    }
 4100: 
 4101: 
 4102:    __global__ void computeHorizontalViscosity(void) { 
 4103: 
 4104:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4105: 
 4106:       SIDE(side);
 4107: 
 4108:       if (side->isDry) return;
 4109: 
 4110:       for (int k = 0; k < nvrt; k++) {
 4111:          side->nuGradU[k] = {0.0, 0.0};
 4112:       }
 4113: 
 4114:       if constexpr(ihorcon == 1) {
 4115:          for (int k = side->kb; k < nvrt - 1; k++) {
 4116:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4117:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4118:             // By Zhang and Baptista.
 4119: 
 4120:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4121:             // This is a standard discretization of the Laplacian operator.
 4122:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4123:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4124:             // Gamma is hvis_coef0 in the code.
 4125:             // The value of gamma needs to be < 0.5.
 4126: 
 4127:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4128:             // side under consideration in each of the two possible elements that share the side.
 4129:             Vector2 sumU = {0.0, 0.0};
 4130:             for (int l = 0; l < 2; l++) {
 4131:                const Element *elem = side->elems[l];
 4132: 
 4133:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4134: 
 4135:                // Find the local index of the side in the element
 4136:                const int idxSide = elem->sideLocalIdx(side);
 4137:                // Find the two sides that are connected to the side under consideration
 4138:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4139:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4140: 
 4141:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4142: 
 4143:             }
 4144: 
 4145:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4146:    
 4147:          }
 4148:       }
 4149:       else if constexpr(ihorcon == 2) {
 4150:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4151:       }
 4152: 
 4153: 
 4154:    }
 4155: 
 4156: 
 4157:    __global__ void setEssentialBC(void) {
 4158:       // Set essential boundary conditions 
 4159:       NODE(node); // Each boundary node
 4160:       NodeBoundary *nodeBnd = node->nodeBnd;
 4161:       
 4162: // nodeBnd->isEssentialBC = true;      
 4163:       // Check if this node has essential BC
 4164:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4165:          // Verify BC value is valid
 4166:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4167: 
 4168:        
 4169:          // Set diagonal to 1 and zero off-diagonals
 4170:          node->coeffDiag = 1.0;
 4171: 
 4172:          for (int j = 0; j < node->numNodes; j++) {
 4173:                node->coeffMatrix[j] = 0.0;
 4174:          }
 4175:          
 4176:          // Set solution and RHS to BC value
 4177:          node->mX  = nodeBnd->elbc;
 4178:          node->qel = nodeBnd->elbc;
 4179: 
 4180:       } else {
 4181:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4182: 
 4183:          for (int j = 0; j < node->numNodes; j++) {
 4184:                Node* nbNode = node->nodes[j];
 4185:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4186:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4187:                   // Verify neighbor's BC value
 4188:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4189: 
 4190:                   // Subtract contribution to RHS
 4191:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4192:                   node->coeffMatrix[j] = 0.0;  
 4193:                }
 4194:          }
 4195:       }
 4196:    }
 4197: 
 4198: 
 4199:    __global__ void updateElevation(void) {
 4200:       NODE(node);
 4201: 
 4202:       node->eta2 = node->mX;
 4203: 
 4204:       node->updateZCoordData();
 4205:    }
