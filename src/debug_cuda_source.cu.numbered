 2687: 
 2688: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2689:    // Check if the point (xt,yt) is inside the element.
 2690:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2691:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2692: 
 2693:    double shpCoords[4];
 2694:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2695: 
 2696:    return res;
 2697: }
 2698: 
 2699: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2700:    // Check if the point (xt,yt) is inside the element.
 2701:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2702:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2703:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2704: 
 2705:    double shpCoords[4];
 2706:    Vector2 tmp_xt = xt;
 2707:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2708:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2709: 
 2710:    if (fixCoords && res) xt = tmp_xt;
 2711: 
 2712:    return res;
 2713: }
 2714: 
 2715: 
 2716: __device__ void Element::trackGoesOutOfWater(const Side *nextSide, const Side *origSide, Element *curElem, double tt, int jlev,
 2717:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2718: 
 2719:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2720:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2721:    // curElement.
 2722: 
 2723:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2724:    // And uses this velocity instead to continue the tracking.
 2725: 
 2726:    // computes the intersection point in local cartesian coordinates
 2727:    Point3 intersection = origSide->toLocalFrame(nextSide->p3_t(tt));  // XXXX I don't think this is necessary. The intersection is already computed in findNextIntersection.
 2728: 
 2729:    // Nudges the point to the barycenter of the element. 
 2730:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2731:    // next segment intersects the element sides. 
 2732:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2733: 
 2734: 
 2735:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2736:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2737:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2738:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2739: 
 2740:    // If the side is an open boundary, the tangential velocity is set to zero.
 2741:    if (nextSide->isBnd()) vtan = 0.0;
 2742: 
 2743:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2744:    const double us = vtan*nextSide->t().x;
 2745:    const double vs = vtan*nextSide->t().y;
 2746:    const double ws = nextSide->w2(jlev); 
 2747: 
 2748:    u_int = {us, vs, ws};
 2749: 
 2750:    // The end of this tracking segment is now the intersection point.
 2751:    xt = {intersection.x, intersection.y, zint};
 2752: // printf("trackGoesOutOfWater: intersection = (%.17f, %.17f, %.17f), zint = %.17f, u_int = (%.17f, %.17f, %.17f)\n", intersection.x, intersection.y, zint, u_int.x, u_int.y, u_int.z);
 2753:    
 2754: }
 2755: 
 2756: // Helper functions to get the 2D local node position for the Celestial walk
 2757: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2758:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2759:    const Node *node = getNodeInOrder(idx2);
 2760: 
 2761:    double z = 0.0;
 2762:    if constexpr(ics == 2) z = node->gz;
 2763:    
 2764:    Point3 p = toPoint3(node->p, z);
 2765: 
 2766:    return toPoint2(origSide->toLocalFrame(p));
 2767: }
 2768: 
 2769: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2770:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2771: }
 2772: 
 2773: __device__ __forceinline__ void Element::computePredicates(const Point2& xt, const Side* origSide,
 2774:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector) const
 2775: // Computes the three per-side predicates needed for the celestial walk
 2776: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2777: //
 2778: // xt is in local frame coordinates for origSide if ics == 2.
 2779: //
 2780: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2781: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2782: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2783: // meaningless on triangles are masked to a safe value (see comments below).
 2784: {
 2785:    // Project all 4 corner positions once into the local 2D frame.
 2786:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2787:    // getLocalNodePosition only transforms/projects if ics == 2.
 2788:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2789:                         getLocalNodePosition(1, origSide), 
 2790:                         getLocalNodePosition(2, origSide), 
 2791:                         getLocalNodePosition(3, origSide)};
 2792: 
 2793:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2794:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2795:    //  here — the orientation is baked into the corners array.)
 2796:    const int i3 = nxq(3);
 2797:    const Vector2 s0 = C[ 1] - C[ 0];
 2798:    const Vector2 s1 = C[ 2] - C[ 1];
 2799:    const Vector2 s2 = C[i3] - C[ 2];
 2800:    const Vector2 s3 = C[ 0] - C[i3];
 2801:    
 2802:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2803:    // The corners array is built from getNode in CCW order, so the orientation
 2804:    // is already correct and no ssign factor is needed in the formulas below.
 2805:    //
 2806:    // i3 = nxq(3): the index of the corner after side 2.
 2807:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2808:    //   Quad:     i3 == 3.
 2809:    //
 2810:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2811:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2812:    isLeft.set(0,  cross(s0, xt - C[ 0]) > -small);
 2813:    isLeft.set(1,  cross(s1, xt - C[ 1]) > -small);
 2814:    isLeft.set(2,  cross(s2, xt - C[ 2]) > -small);
 2815:    isLeft.set(3, (cross(s3, xt - C[i3]) > -small) || isTri());  
 2816: 
 2817: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2818: 
 2819:    // For triangles, the corner after side 2 is the closing corner where
 2820:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2821:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2822:    // s0 for triangles, s3 for quads.
 2823:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2824: 
 2825:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2826:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2827:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2828:    //
 2829:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2830:    // result is false naturally. No sentinel needed.
 2831:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2832:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2833:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2834:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2835: 
 2836:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2837:    // on the "exit through side I" half of the corner cone, separated by the
 2838:    // approximate angular bisector of the celestial walk. The bisector is
 2839:    // perpendicular to the chord across the corner; the test is the sign of
 2840:    // (xt - corner_vertex) projected onto that chord.
 2841:    //
 2842:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2843:    // (the validity rule sets valid_3 = false), so its computed value for
 2844:    // triangles doesn't matter. No sentinel needed.
 2845:    isBisector.set(0, dot(xt - C[ 1], s0 + s1) < 0.0);
 2846:    isBisector.set(1, dot(xt - C[ 2], s1 + s2) < 0.0);
 2847:    isBisector.set(2, dot(xt - C[i3], s2 + s3_tri) < 0.0);
 2848:    isBisector.set(3, dot(xt - C[ 0], s3 + s0) < 0.0);   
 2849: 
 2850: }
 2851: 
 2852: 
 2853: __inline__ __device__ double Element::computeSignedArea(void) const {
 2854:    // Compute the area of the element
 2855: 
 2856:    Point2 x0, x1, x2, x3;
 2857:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2858: 
 2859:    double res = signedArea(x0, x1, x2);
 2860: 
 2861:    // In the quad case we need to add the area of the other triangle.
 2862:    if (isQuad()) {
 2863:       x3 = getLocalHorizontalNodePosition(3);
 2864:       double ar1 = signedArea(x0, x2, x3);
 2865:       double ar2 = signedArea(x0, x1, x3);
 2866:       double ar3 = signedArea(x1, x2, x3);
 2867:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2868: 
 2869:       res += ar1 + ar2 + ar3;
 2870:    }
 2871: 
 2872:    return res;
 2873: }
 2874: 
 2875: 
 2876: __inline__ __device__ void Element::nudgeToBarycenter(Point2 &p, const Side *origSide) const {
 2877: // Nudges the local-frame point, p, to the barycenter of the element. 
 2878: 
 2879:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (4)");
 2880: 
 2881:    Point3 c = origSide->toLocalFrame(toPoint3(center, centerZ())); // In local frame coordinates if ics == 2
 2882: 
 2883:    p = (1.0 - btrack_nudge)*p + btrack_nudge*toPoint2(c);
 2884: }
 2885: 
 2886: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2887:                                                                 (nodes[1]->isDry2()) ||
 2888:                                                                 (nodes[2]->isDry2()) ||
 2889:                                                                 (isQuad() && nodes[3]->isDry2());
 2890: }
 2891: 
 2892: __inline__ __device__ double Element::detJ_eta(void) const {
 2893:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2894:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2895: }
 2896: 
 2897: __inline__ __device__ double Element::detJ_xi(void) const {
 2898:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2899:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2900: }
 2901: 
 2902: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2903:    // In boundary sides, the element 1 is nullptr
 2904:    return side->elems[1] == nullptr; 
 2905: }
 2906: 
 2907: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2908:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2909:    // For ics == 2, this function uses local frame coordinates.
 2910: 
 2911:    assert(isQuad());
 2912: 
 2913:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2914:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2915:    // where vxi, veta, vb are vectors and c is the center of the element.
 2916: 
 2917:    Point2 p0, p1, p2, p3;
 2918: 
 2919:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2920: 
 2921:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2922:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2923:    // vectors vxi and veta connect the centers of opposite sides
 2924:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2925:    // vb is zero for parallelogram elements.
 2926:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2927: 
 2928:    //  The bilinear mapping is:
 2929:    //      P(s,t) = C + s*U + t*V + s*t*W
 2930:    //
 2931:    //  where:
 2932:    //    C = centroid (average of four vertices)
 2933:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2934:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2935:    //    W = bilinear correction; measures deviation from parallelogram
 2936:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2937:    //        W = 0 for parallelogram elements.
 2938:    //
 2939:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2940:    //
 2941:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2942:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2943:    //
 2944:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2945:    //
 2946:    //  Geometrically, (L) projects everything onto the direction
 2947:    //  perpendicular to W, where the mapping is purely affine.
 2948:    //
 2949:    //  The dot product with nb retains the nonlinear term:
 2950:    //
 2951:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2952:    //
 2953:    //  Geometrically, (Q) projects onto the W direction, where
 2954:    //  the nonlinearity lives.
 2955:    //
 2956:    //  We solve (L) for whichever variable has the larger coefficient
 2957:    //  (better conditioned back-substitution), substitute into (Q),
 2958:    //  and get a scalar quadratic in the other variable.
 2959:    // ================================================================
 2960: 
 2961:    // ---- Basis vectors ----
 2962:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2963:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2964:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2965:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2966:    // W: nonlinear correction. Difference between quad and parallelogram.
 2967:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2968:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2969: 
 2970:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2971:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2972:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2973:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2974:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2975: 
 2976:    // ---- nb: direction parallel to W, L1-normalized ----
 2977:    // We don't need a unit vector -- just a well-scaled direction parallel
 2978:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2979:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2980:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2981:    //
 2982:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2983:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2984:    // and the quadratic solver takes its linear path (a ~ 0).
 2985:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2986:    const double inv_wlen = 1.0 / wlen1;
 2987:    const Vector2 nb = vb * inv_wlen;
 2988: 
 2989:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2990:    // cross(nb, ·) projects onto the direction PERPENDICULAR to W.
 2991:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2992:    // What remains is a pure affine relationship between xi and eta.
 2993:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2994:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2995:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2996: 
 2997:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2998:    // dot(nb, ·) projects onto the W direction, where the nonlinearity lives.
 2999:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3000:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3001:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3002:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3003:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3004: 
 3005:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3006:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3007:    // minimizing round-off amplification.
 3008:    //
 3009:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3010:    // that uses predicated moves.
 3011:    //
 3012:    // if (fabs(Ls) > fabs(Lt)) {
 3013:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3014:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3015:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3016:    //    const double A = -Qw * Lt;
 3017:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3018:    //    const double C =  Qs * Lp - Qp * Ls;
 3019: 
 3020:    //    double eta1, eta2;
 3021:    //    solveQuadratic(A, B, C, eta1, eta2);
 3022: 
 3023:    //    // Pick root with smaller |eta| (domain centered at 0).
 3024:    //    // Ternary-> predicated move, no branch divergence.
 3025:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3026: 
 3027:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3028:    //    xi = (Lp - Lt * eta) / Ls;
 3029: 
 3030:    // } else {
 3031:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3032:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3033:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3034:    //    const double A = -Qw * Ls;
 3035:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3036:    //    const double C =  Qt * Lp - Qp * Lt;
 3037: 
 3038:    //    double xi1, xi2;
 3039:    //    solveQuadratic(A, B, C, xi1, xi2);
 3040: 
 3041:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3042: 
 3043:    //    eta = (Lp - Ls * xi) / Lt;
 3044:    // }
 3045:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3046:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3047:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3048:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3049:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3050: 
 3051:    // Quadratic:  A*r^2 + B*r + C = 0
 3052:    // (same formula for both cases, just with swapped coefficients)
 3053:    const double A = -Qw * Lb;
 3054:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3055:    const double C =  Qa * Lp - Qp * La;
 3056: 
 3057:    double r1, r2;
 3058:    solveQuadratic(A, B, C, r1, r2);
 3059: 
 3060:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3061:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3062: 
 3063:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3064:    const double other = (Lp - Lb * r) / La;
 3065: 
 3066:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3067:    xi  = solve_s ? r     : other;
 3068:    eta = solve_s ? other : r;
 3069: 
 3070: 
 3071:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3072:    xi  = fmin(1.0, fmax(xi,  -1.0));
 3073:    eta = fmin(1.0, fmax(eta, -1.0));
 3074: 
 3075:    // ---- Shape functions ----
 3076:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3077:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3078:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3079:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3080:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3081:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3082:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3083:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3084: 
 3085:    return true;
 3086: }
 3087: 
 3088: /**
 3089:    Compute the shape coordinates of the point (xt,yt) in the element.
 3090:    @param xt (input): x-coordinate of the point
 3091:    @param shpCoords (output): shape coordinates of the point
 3092:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3093:    @return true if the point is inside the element, false otherwise
 3094: **/
 3095: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3096: 
 3097:    // Compute the shape coordinates of the point xt in the element.
 3098:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3099:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3100:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3101:    // from the local frame, so use additional check.
 3102: 
 3103:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (5)");
 3104: 
 3105:    if (isTri()) { // Triangular element
 3106: 
 3107:       // Horizontal local node coordinates. 
 3108:       Point2 x0 = nodes[0]->p;
 3109:       Point2 x1 = nodes[1]->p;
 3110:       Point2 x2 = nodes[2]->p;
 3111: 
 3112:       // If ics == 2, the node coordinates are transformed to local frame.
 3113:       if constexpr(ics==2) {
 3114:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 3115:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 3116:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 3117: 
 3118: 
 3119:          // Convert the node coordinates to the local frame centered at the element center
 3120:          x0 = toPoint2(origSide->toLocalFrame(p0));
 3121:          x1 = toPoint2(origSide->toLocalFrame(p1));
 3122:          x2 = toPoint2(origSide->toLocalFrame(p2));
 3123:       }
 3124: 
 3125:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3126:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3127:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3128:       shpCoords[3] = 0.0;
 3129: 
 3130: 
 3131:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3132:       const bool res = (tmpmin >= -small);  
 3133:       
 3134:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 3135:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3136: 
 3137:       
 3138:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3139:       // then we fix the negative shape coordinates.
 3140:       if ((tmpmin < 0) && fix) {
 3141: 
 3142:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3143:          // keeping the sum of the shape coordinates equal to 1.
 3144:          // I have tested and compared the new algorithm with the old one, and they give
 3145:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3146:          // The new algorithm should be faster since it is branchless.
 3147:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3148:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3149:          
 3150:          shpCoords[0] = (shpCoords[0] + a)*b;
 3151:          shpCoords[1] = (shpCoords[1] + a)*b;
 3152:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3153: 
 3154:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3155:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3156:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3157: 
 3158:          // Update the point coordinates for the new shape coordinates
 3159:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3160:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3161:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3162: 
 3163:       }
 3164: 
 3165:       // Check if the point is inside the element
 3166:       return res;      
 3167:    }
 3168:    else {
 3169:       assert(isQuad() && "computeShapeCoords");
 3170: 
 3171:    //    Point2 p = xt;
 3172: 
 3173:    //    // Reproject p the original side frame for ics=2
 3174:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 3175: 
 3176:    //    bool inside = false;
 3177: 
 3178: 
 3179: 
 3180:    //    if(ifl==0) then
 3181:    //      do i=1,4
 3182:    //        in1=nxq(1,i,i34(ie))
 3183:    //        in2=nxq(2,i,i34(ie))
 3184:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 3185:    //      enddo !i
 3186:    //      tmp=minval(swild2(1:4))/area(ie)
 3187:    //      if(tmp>-small2) then
 3188:    //        inside=1
 3189:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3190:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3191:    //      endif !inside quad
 3192:    //    else !ifl=1 - already inside
 3193:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3194:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3195:    //      !Update pt
 3196:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3197:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3198:    //    endif !ifl
 3199: 
 3200: 
 3201:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3202: 
 3203:    }
 3204: 
 3205:    assert(false && "computeShapeCoords: should never reach this point");
 3206:    return false;  // Never reached
 3207: 
 3208: }
 3209: 
 3210: 
 3211: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3212: // Convert shape coordinates to cartesian coordinates
 3213: 
 3214:    if (isTri()) {
 3215:       // Triangular element
 3216: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3217:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3218:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3219:    }
 3220:    else {
 3221:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3222:    }
 3223: 
 3224: }
 3225: 
 3226: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3227:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3228:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3229:    // The formula for the integral is:
 3230:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3231: 
 3232:    printf("intPhiPhi: TEST\n");
 3233: 
 3234:    const Node *n0 = nodes[0];
 3235:    const Node *n1 = nodes[1];
 3236:    const Node *n2 = nodes[2];
 3237:    const Node *n3 = nodes[3];
 3238: 
 3239:    const Vector2 p0 = n0->p;
 3240:    const Vector2 p1 = n1->p;
 3241:    const Vector2 p2 = n2->p;
 3242:    const Vector2 p3 = n3->p;
 3243: assert(false && "intPhiPhiQuad:CHECK?");
 3244: 
 3245:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3246:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3247:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3248:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3249: 
 3250:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3251: }
 3252:    
 3253: 
 3254: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3255:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3256:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3257:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3258:    // The formula is also based on the identity:
 3259:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3260:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3261: 
 3262:    printf("intGradPhiGradPhi: TEST\n");   
 3263: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3264:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3265: 
 3266:    const double x0 = nodes[0]->p.x;
 3267:    const double y0 = nodes[0]->p.y;
 3268:    const double x1 = nodes[1]->p.x;
 3269:    const double y1 = nodes[1]->p.y;
 3270:    const double x2 = nodes[2]->p.x;
 3271:    const double y2 = nodes[2]->p.y;
 3272:    const double x3 = nodes[3]->p.x;
 3273:    const double y3 = nodes[3]->p.y;
 3274: 
 3275:    double res = 0.0;
 3276:    
 3277:    // Quadrature points in xi and eta coordinates
 3278:    #pragma unroll
 3279:    for (int i = 0; i < 4; i++) {
 3280:       // For each quadrature point...
 3281: 
 3282:       const Point2 p = GaussPoint(i);
 3283:       const double eta = p.x;
 3284:       const double xi  = p.y;
 3285: 
 3286:       // Jacobian entries at the Gauss point p
 3287:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3288:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3289:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3290:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3291: 
 3292:       const double detJ = jacobianDet(p);
 3293:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3294: 
 3295:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3296:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3297:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3298:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3299:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3300: 
 3301:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3302:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3303:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3304:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3305:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3306: 
 3307:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3308:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3309:    }
 3310: 
 3311:    return res;
 3312: }
 3313: 
 3314: 
 3315: /**  Interpolate velocities at a given point (xt,yt,zt)
 3316: 
 3317:    @param xt, yt, zt: coordinates of the point to interpolate
 3318:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3319: 
 3320:    This is done in four steps:
 3321: 
 3322:    1. Find the shape coordinates for the final position in the element.
 3323:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3324:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3325:       z levels at xt, yt at each step.   
 3326:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3327:       horizontally and vertically.
 3328: **/
 3329: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3330:    // Interpolate the velocities at the point xt. 
 3331:    // This function works the same for triangular and quadrilateral elements.
 3332:    double shpCoord[4];
 3333:    Vector3 u_int;
 3334: 
 3335:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa (6)");
 3336: 
 3337:    // First step is to compute the shape coordinates of (xt,yt)
 3338: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3339:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 3340: 
 3341: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small)) printf("idx = %d, shpCoord = (%.16f, %.16f, %.16f, %.16f)\n", idx, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3342:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -1e-4) && "Invalid shape coordinates");
 3343: 
 3344:    // Second step is to find the level that contains zt
 3345:    // Uses a binary search to find the level
 3346:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3347:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3348:    int R = nvrt - 1;
 3349: 
 3350:    // Get the z coordinates at the nodes of the element at the levels L and R
 3351:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3352:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3353:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3354: 
 3355:    double zL = interpolate(shpCoord, zLAtNodes);
 3356:    double zR = interpolate(shpCoord, zRAtNodes);
 3357:    
 3358:    // Interpolates vertically the velocities
 3359:    double wght1, wght2;
 3360:    if (xt.z<=zL) {
 3361:       wght1 = 1.0;
 3362:       wght2 = 0.0;
 3363:       xt.z = zL;
 3364:    }
 3365:    else if (xt.z>=zR) {
 3366:       wght1 = 0.0;
 3367:       wght2 = 1.0;
 3368:       xt.z = zR;
 3369:    }
 3370:    else {
 3371:       // Perform a binary search to find the levels between L and R that contain xt.z
 3372:       while (R - L > 1) {
 3373:          int M = (L + R) / 2.0;
 3374: 
 3375:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3376:          double zM = interpolate(shpCoord, zMAtNodes);
 3377:          if (zM < xt.z) 
 3378:          {
 3379:             L = M;
 3380:             zL = zM;
 3381:          }
 3382:          else 
 3383:          {
 3384:             R = M;
 3385:             zR = zM;
 3386:          }
 3387:       }
 3388:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3389:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3390: 
 3391:       wght2 = (xt.z - zL)/(zR - zL);
 3392:       wght1 = 1.0 - wght2;
 3393: 
 3394:    }
 3395: 
 3396: if (R< 0 || R>49) printf("KKKK R = %d, L = %d, wght1 = %.17f, wght2 = %.17f\n", R, L, wght1, wght2);
 3397:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3398:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3399:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3400:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3401: 
 3402:    // Neither of the interpolated velocities should be NaN
 3403:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3404: 
 3405:    return u_int;
 3406: 
 3407: }
 3408: 
 3409: 
 3410: 
 3411: 
 3412: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3413: 
 3414:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3415:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3416:    const Node *n1 = side->n1;
 3417:    const Node *n2 = side->n2;
 3418: 
 3419:    bool n1_match = (n1->nodeBnd->segment == segment);
 3420:    bool n2_match = (n2->nodeBnd->segment == segment);
 3421: 
 3422:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3423:    if (n1_match && n2_match) {
 3424:       return 0.5;
 3425:    } else if (n1_match) {
 3426:       return 1.0;
 3427:    } else if (n2_match) {
 3428:       return 0.0;
 3429:    }
 3430: 
 3431:    return 0.0;
 3432: }
 3433: 
 3434: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3435: 
 3436: 
 3437: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3438: 
 3439:    const double w1 = getBoundaryArrayValueWeight();
 3440:    const double w2 = 1.0 - w1;
 3441:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3442:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3443: 
 3444:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3445: }
 3446: 
 3447: 
 3448: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3449:    const double w1 = getBoundaryArrayValueWeight();
 3450:    const double w2 = 1.0 - w1;
 3451:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3452:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3453: 
 3454:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3455: 
 3456: }
 3457: 
 3458: 
 3459: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3460:    // Returns the value of the velocity at the side center
 3461:    const double w1 = getBoundaryArrayValueWeight();
 3462:    const double w2 = 1.0 - w1;
 3463:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3464:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3465: 
 3466:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3467: }
 3468: 
 3469: 
 3470: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3471:    // Returns the value of the normal component of the velocity at the side center
 3472:    const double w1 = getBoundaryArrayValueWeight();
 3473:    const double w2 = 1.0 - w1;
 3474:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3475:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3476: 
 3477:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3478: }
