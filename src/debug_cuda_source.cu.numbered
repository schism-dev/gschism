 7481: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7482:    Node *nodes = mesh->localNodeData;
 7483: 
 7484:    *addr = nodes;
 7485:    *sizeNode = sizeof(Node);
 7486: 
 7487:    switch (varCode) {
 7488:       case (int)VarCode::depth:
 7489:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7490:          *sizeType = sizeof(double);
 7491:          break;
 7492:       case (int)VarCode::eta:
 7493:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7494:          *sizeType = sizeof(double);
 7495:          break;
 7496:       case (int)VarCode::x:
 7497:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7498:          *sizeType = sizeof(Vector2);
 7499:          break;
 7500:       case (int)VarCode::z:
 7501:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7502:          *sizeType = sizeof(double);
 7503:          break;
 7504:       case (int)VarCode::kb:
 7505:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7506:          *sizeType = sizeof(int);
 7507:          break;
 7508:       case (int)VarCode::isdry:
 7509:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7510:          *sizeType = sizeof(int);
 7511:          break;         
 7512:       case (int)VarCode::w:
 7513:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7514:          *sizeType = sizeof(double);
 7515:          break;
 7516:       case (int)VarCode::u:
 7517:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7518:          *sizeType = sizeof(Vector2);
 7519:          break;         
 7520:       default:
 7521:          *offset = -1;    
 7522:    }  
 7523:    
 7524: }
