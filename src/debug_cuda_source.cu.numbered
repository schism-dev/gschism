 5711:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5712:    // XXXX I'm not sure where I got this function from. 
 5713:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5714:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5715:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5716:    // It uses the utmp array as a temporary array to store the velocities.
 5717: 
 5718:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5719: 
 5720:       SIDE(side);
 5721: 
 5722:       const int kb = side->kb;
 5723: 
 5724:       Node *n1 = side->n1;
 5725:       Node *n2 = side->n2;
 5726: 
 5727:       for (int k = kb; k < nvrt; k++) {
 5728: 
 5729:          // Cast the u2 vector into a Vector2 
 5730:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5731:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5732: // printf("1 &n1_u2 = %p, &n2_u2 = %p, side idx = %d, n1->idx = %d, n2->idx = %d, side->u2[k] = %e,%e, n1->numSides = %d, n2->numSides = %d, n1_u2 = %e,%e, n2_u2 = %e,%e\n", &n1_u2, &n2_u2, side->idx, n1->idx, n2->idx, side->u2[k].x, side->u2[k].y, n1->numSides, n2->numSides, n1_u2.x, n1_u2.y, n2_u2.x, n2_u2.y);         
 5733:          n1_u2 = side->u2[k]/n1->numSides;
 5734: // printf("2 &n1_u2 = %p, &n2_u2 = %p, side idx = %d, n1->idx = %d, n2->idx = %d, side->u2[k] = %e,%e, n1->numSides = %d, n2->numSides = %d, n1_u2 = %e,%e, n2_u2 = %e,%e\n", &n1_u2, &n2_u2, side->idx, n1->idx, n2->idx, side->u2[k].x, side->u2[k].y, n1->numSides, n2->numSides, n1_u2.x, n1_u2.y, n2_u2.x, n2_u2.y);                  
 5735:          n2_u2 = side->u2[k]/n2->numSides;
 5736: printf("k = %d, side idx = %d, n1->idx = %d, n2->idx = %d, side->u2[k] = %e,%e, n1->numSides = %d, n2->numSides = %d, n1_u2 = %e,%e, n2_u2 = %e,%e\n", k, side->idx, n1->idx, n2->idx, side->u2[k].x, side->u2[k].y, n1->numSides, n2->numSides, n1_u2.x, n1_u2.y, n2_u2.x, n2_u2.y);         
 5737: 
 5738:       }
 5739: 
 5740: 
 5741:    }
