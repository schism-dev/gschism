 2760: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2761:                 double *node_coords, double *wind_rotate_angle, 
 2762:                 int *isdel, int *isidenode, int *isbnd,
 2763:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2764:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2765:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2766:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2767:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2768:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2769:                 double *emo, double *efa, 
 2770:                 double *umo, double *ufa, 
 2771:                 double *vmo, double *vfa) {
 2772: 
 2773:    printf("Populating mesh for partition %d\n", partNum);
 2774: 
 2775:    // Horizontal grid
 2776:    printf("Processing %d nodes\n", np);    
 2777: 
 2778: 
 2779:    int idxNodeBoundary = 0;  
 2780:    for (int i = 0; i < np; i++)
 2781:    {
 2782:       Node &node = localNodeData[i];
 2783: 
 2784:       node.idx = i;
 2785: 
 2786:       const int idxNodeStart = nodeNeighNodesStart[i];
 2787:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2788:       node.numNodes = idxNodeEnd - idxNodeStart;
 2789:       node.nodes = nodeNeighNodes + idxNodeStart;
 2790:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2791: 
 2792: 
 2793: 
 2794:       const int idxElemStart = nodeNeighElemsStart[i];
 2795:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2796:       node.numElements = idxElemEnd - idxElemStart;
 2797:       node.elements = nodeNeighElems + idxElemStart;
 2798: 
 2799: 
 2800:       
 2801:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2802:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2803:          const int partNode = localNodePart[idxNodeGlobal]; 
 2804:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2805: 
 2806: 
 2807:          Node *node_ptr = nodes[partNode] + idxNode;
 2808:          
 2809:          nodeNeighNodes[idx] = node_ptr;
 2810:       }
 2811: 
 2812:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2813:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2814:          const int partElem = localElemPart[idxElemGlobal];
 2815:          const int idxElem  = localElemIndices[idxElemGlobal];
 2816: 
 2817:          Element *elem_ptr = elems[partElem] + idxElem;
 2818: 
 2819:          nodeNeighElems[idx] = elem_ptr;
 2820:       }      
 2821: 
 2822: 
 2823:       node.wind_angle = wind_rotate_angle[i];
 2824: 
 2825:       // Element **elements; // pointer to the elements connected to this node
 2826:       // int numElements;   // number of elements shared by this node
 2827: 
 2828:       node.p.x   = node_coords[i * 3];
 2829:       node.p.y   = node_coords[i * 3 + 1];
 2830:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2831:       node.depth = node_coords[i * 3 + 2];
 2832: 
 2833:       node.numSides = 0;
 2834: 
 2835: printf("EEEEEE idx = %d, isbnd[i] = %d, node.nodeBnd = %p\n", i, isbnd[i], node.nodeBnd);
 2836:       // Links the node to the boundary information
 2837:       if (isbnd[i] >= 0) {
 2838:        
 2839:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2840:          node.nodeBnd->node = &node;
 2841: 
 2842:          if (isbnd[i]>=0) {
 2843: 
 2844:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2845:             
 2846:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2847:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2848: 
 2849:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2850:             node.nodeBnd->segment->clen  = nan("1");
 2851:             node.nodeBnd->segment->carea = nan("1");
 2852: 
 2853:          }
 2854: //          else {
 2855: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2856: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2857: //          }
 2858:          
 2859:          idxNodeBoundary++;
 2860: printf("EEEEEEhhhh idx = %d, isbnd[i] = %d, idxNodeBoundary = %d\n", i, isbnd[i], idxNodeBoundary);         
 2861:       }
 2862:       else {
 2863:          node.nodeBnd = nullptr; // For internal nodes
 2864: printf("EEEEEQQ isbnd[i] = %d, node.nodeBnd = %p\n", isbnd[i], node.nodeBnd); 
 2865:          if (isbnd[i] == landSegment) {
 2866:             node.nodeBnd = &landBoundaryNode;
 2867:             node.nodeBnd->segment = &landBoundarySegment;
 2868:          }
 2869:          // node.nodeBnd->node = &node;
 2870:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2871:          // // node.nodeBnd = nullptr;
 2872:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2873:         
 2874:       }
 2875: 
 2876:       // XXXX GAUSSIAN HILL VELOCITIES
 2877: #ifdef GAUSSIAN_HILL_VELOCITIES
 2878:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2879:          constexpr double rot_per = 3000.0;
 2880:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2881:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2882:       // XXXXX
 2883: #endif
 2884:    }
 2885: 
 2886:    nbp = idxNodeBoundary;
 2887: 
 2888:    printf("Processing %d sides\n", ns);
 2889:    int idxSideBoundary = 0;
 2890:    for (int i = 0; i < ns; i++)
 2891:    {
 2892:       Side &side = localSideData[i];
 2893:       side.idx = i;
 2894:       // finding the pointer to the nodes that form the side
 2895:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2896:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2897: 
 2898:       const int locidx_n1 = localNodeIndices[idx_n1];
 2899:       const int locidx_n2 = localNodeIndices[idx_n2];
 2900:       const int part_n1 =   localNodePart[idx_n1];
 2901:       const int part_n2 =   localNodePart[idx_n2];
 2902: 
 2903:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2904:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2905: 
 2906:       // Counts the number of sides connected to each node
 2907:       side.n1->numSides++;
 2908:       side.n2->numSides++;
 2909: 
 2910:       // Normal, unitary vector to the side
 2911:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2912:       side.n = normalize(side.n);
 2913: 
 2914:       // Side boundary type
 2915:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2916:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2917: 
 2918:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2919:       // If both nodes are on the boundary, then the side may be on the boundary
 2920:       {
 2921:          bool isLand = false;
 2922:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2923: 
 2924:          if (isbs > -1) {
 2925:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2926:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2927:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2928:           
 2929:             side.sideBnd->side = &side;
 2930:             idxSideBoundary++;
 2931: 
 2932:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2933:          }
 2934:          
 2935: 
 2936:       // }
 2937:       // 
 2938: 
 2939: 
 2940: 
 2941: 
 2942: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2943: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2944: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2945: //       {
 2946: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2947: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2948: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2949: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2950: // if (side.sideBnd->segment == nullptr) continue;
 2951: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2952: //          else                  side.sideBnd->segment = n2bnd->segment;
 2953: //          side.sideBnd->side = &side;
 2954: //          idxSideBoundary++;
 2955: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2956:       }
 2957:       else side.sideBnd = nullptr;
 2958: 
 2959:       nbs = idxSideBoundary;
 2960: // printf("Here3: %d", i);
 2961:       // finding the pointer to the elements that share the side
 2962:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2963:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2964: 
 2965:       if (idx_e1 > -1) {
 2966:          const int locidx_e1 = localElemIndices[idx_e1];
 2967:          const int part_e1 =  localElemPart[idx_e1];
 2968:          side.elems[0] = elems[part_e1] + locidx_e1;
 2969: 
 2970:       }
 2971:       else {
 2972:          side.elems[0] = nullptr;
 2973:       }
 2974: // printf("Here4: %d", i);
 2975:       if (idx_e2 > -1) {
 2976:          const int locidx_e2 = localElemIndices[idx_e2];
 2977:          const int part_e2 =  localElemPart[idx_e2];
 2978:          side.elems[1] = elems[part_e2] + locidx_e2;
 2979:       }
 2980:       else {
 2981:          side.elems[1] = nullptr;
 2982:       }
 2983: // printf("Here5: %d", i);
 2984: 
 2985: 
 2986:       // Compute the center of the side
 2987:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2988: 
 2989: #ifdef GAUSSIAN_HILL_VELOCITIES
 2990: // XXXX
 2991: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2992: constexpr double rot_per=3000.0;
 2993: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2994: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2995: // XXXXX      
 2996: #endif
 2997:       // Compute the z level at the center of the side
 2998:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2999: 
 3000:       // Compute the length of the side
 3001:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3002:       side.len = sqrt(dot(vLen, vLen));
 3003: 
 3004:    }
 3005: 
 3006:    printf("Processing %d elements\n", ne);
 3007:    for (int i = 0; i < ne; i++)
 3008:    {
 3009:       Element &elem = localElemData[i];
 3010:       elem.idx = i;
 3011:       for (int j = 0; j < i34[i]; j++) {
 3012:          const int idxNode = elnode[i*4 + j];  
 3013:          const int idxSide = elside[i*4 + j];
 3014:          
 3015:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3016:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3017: 
 3018: 
 3019: 
 3020:          // Find the neighboring element  
 3021:          if (elem.sides[j]->elems[0] == &elem) {
 3022:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3023:          }
 3024:          else {
 3025:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3026:          }
 3027:          
 3028:       }
 3029: 
 3030:       elem.i34 = i34[i];
 3031: 
 3032: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 3033: 
 3034:       // Compute the centroid of the element and its depth
 3035:       Vector2 center = {0.0, 0.0};
 3036:       elem.depth = 0.0;
 3037:       for (int j = 0; j < i34[i]; j++) {
 3038:          center += elem.nodes[j]->p2()/i34[i];
 3039:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3040:       }
 3041:       elem.center.x = center.x;
 3042:       elem.center.y = center.y;
 3043: 
 3044:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 3045:       
 3046:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3047:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3048: 
 3049:       elem.area = elem.computeSignedArea(); 
 3050:       elem.radius = sqrt(elem.area)/pi; 
 3051:       
 3052:       // Determines which way the normal vector to each side is oriented.
 3053:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3054:       for (int j = 0; j < i34[i]; j++)  
 3055:       {
 3056:          if (elem.sides[j]->elems[0] == &elem) {
 3057:             elem.ssign[j] =  1.0;
 3058:          }
 3059:          else {
 3060:             elem.ssign[j] = -1.0;
 3061:          }
 3062: 
 3063:       }
 3064: 
 3065:       // Derivatives of shape functions
 3066:       //  For ics=2, this is done inside element/ll frame XXX
 3067:       //  For quads, the derivative is evaluated at centroid
 3068:       const int i34 = elem.i34;
 3069:       for (int j = 0; j < i34; j++) {
 3070:          const double area = elem.area;
 3071:          const int id2 = elem.nxq(1 + j);
 3072:          const int id3 = elem.nxq(2 + j);
 3073:          const int id4 = elem.nxq(3 + j);
 3074:          if (elem.isTri()) {
 3075:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3076:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3077:             // da1/dx = (y1 - y2)/(2*area)
 3078:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3079:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3080:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3081:          }
 3082:          else  { // Quad; evaluate at centroid
 3083:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3084:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3085:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3086:          } // if Tri
 3087: 
 3088:       } // for j
 3089: 
 3090:    }
 3091: 
 3092: 
 3093:    // Processing the boundary nodes
 3094:    int idx = 0;
 3095:    for (int iseg = 0; iseg < nope; iseg++) {
 3096:       
 3097:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 3098: 
 3099:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3100: 
 3101:          nodeBnd->isEssentialBC = true;
 3102: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3103:          nodeBnd->elbc = 0.0;
 3104: 
 3105:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3106:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 3107:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 3108:             nodeBnd->umo[jfr] = {umo[jfr + iseg*nbfr], vmo[jfr + iseg*nbfr]};
 3109:             nodeBnd->ufa[jfr] = {ufa[jfr + iseg*nbfr], vfa[jfr + iseg*nbfr]};
 3110: 
 3111:          }
 3112: 
 3113:          idx++;
 3114:       }
 3115: 
 3116:    }
 3117: 
 3118: }
 3119: 
 3120: 
 3121: 
 3122: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3123:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3124:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3125:    // 
 3126:    // This kernel is called for all nodes.
 3127: 
 3128: 
 3129:    NODE(node1);
 3130: 
 3131: 
 3132:    node1->clearMatrixRow();
 3133:    node1->qel = 0.0;
 3134: 
 3135:    // THIS IS FOR STRUCTURES XXX
 3136:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3137: 
 3138:    
 3139:    for (int j=0; j<node1->numElements; j++) {
 3140:       // For each element connected to the node...
 3141: 
 3142:       Element *elem = node1->elements[j];
 3143: 
 3144:       // Compute the average gravity
 3145:       const double grav3 = elem->mean(&Node::grav2);
 3146: 
 3147:       // Look at the documentation for the description of the terms in the following integrals
 3148: 
 3149:       // Integral I_1 
 3150:       // \bar{\breve{H}} 
 3151:       const double hhatb = elem->mean(&Side::hhat);        
 3152: 
 3153: 
 3154:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3155: 
 3156:       const int id1 = elem->nodeLocalIdx(node1); 
 3157:       const double area = elem->area;
 3158: 
 3159:       if (elem->isTri()) {
 3160: 
 3161:          // To clarify the notation in this section: 
 3162:          //   i stands for the node under consideration (node1)
 3163:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3164:          const int id2 = elem->nxq(1 + id1);
 3165:          const int id3 = elem->nxq(2 + id1);
 3166:          Node *node2 = elem->nodes[id2];
 3167:          Node *node3 = elem->nodes[id3];
 3168: 
 3169:          const Point2 x1 = node1->p2();
 3170:          const Point2 x2 = node2->p2();
 3171:          const Point2 x3 = node3->p2();
 3172: 
 3173:          // integral of phi_i*phi_j
 3174:          const double ipp_ii = (1.0/6.0 )*area;
 3175:          const double ipp_ij = (1.0/12.0)*area;
 3176:          const double ipp_ik = (1.0/12.0)*area;
 3177: 
 3178:          // integral of [(grad phi_i) * (grad phi_j)]
 3179:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3180:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3181:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3182: 
 3183:          // Computes the different components of integral I_1 of each node with respect to node i.
 3184:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3185:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3186:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3187: 
 3188: if (j==node1->numElements-1) {
 3189: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3190: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3191: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3192: }
 3193: 
 3194:          node1->addToSparseMatrix(node1, I1_ii);
 3195:          node1->addToSparseMatrix(node2, I1_ij); 
 3196:          node1->addToSparseMatrix(node3, I1_ik);
 3197: 
 3198: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3199:      
 3200:       }
 3201:       else { // Quad
 3202:          // XXX IMPLEMENT THIS
 3203:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3204:       } 
 3205: 
 3206:  
 3207:       // Integral I_4
 3208:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3209:       // Where
 3210:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3211: 
 3212:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3213:       // of U over the element.
 3214:       Vector2 Umean = {0.0, 0.0};
 3215:       for (int m=0; m<elem->i34; m++) {      
 3216:          const Side *side = elem->sides[m];
 3217: 
 3218:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3219:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3220:       }
 3221:       Umean = Umean/elem->i34;
 3222: 
 3223:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3224: 
 3225:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3226:       const double I_4_1 = dot(gradPhi_1, Umean);
 3227: 
 3228:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3229:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3230:      
 3231:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3232: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3233: 
 3234:       // Additional terms 
 3235:       double vnorm = 0.0;
 3236:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3237:          Vector3 ubed;
 3238:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3239: 
 3240:          Vector3 gradP = {0.0, 0.0, 1.0};
 3241:          for (int m=0; m < elem->i34; m++) {
 3242:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3243:            gradP += toVector3(gradP_2D, 0.0);
 3244:          }   
 3245:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3246:       } // imm==2
 3247: 
 3248:       if (elem->isTri()) {
 3249:          for (int l=0; l<3; l++) {
 3250:            double fac;
 3251: 
 3252:            Node *node = elem->nodes[l];
 3253: 
 3254:            (node == node1)? fac=2.0 : fac=1.0;
 3255: 
 3256:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3257:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3258:            
 3259:          }
 3260: 
 3261: 
 3262:          if (!elem->isDry) {
 3263:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3264: 
 3265:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3266:          }
 3267: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3268: 
 3269:       } // isTri
 3270:       else { // isQuad
 3271:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3272:          // for (int l=0; l<4; l++) {
 3273:          //   const Node *node = elem->nodes[l];
 3274: 
 3275:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3276:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3277: 
 3278:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3279:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3280:          // }
 3281: 
 3282:       } // isQuad
 3283: 
 3284: 
 3285:       node1->qel += (dt/elem->i34)*elem->vsource;
 3286:       
 3287: 
 3288:    } // for all elements connected to the node
 3289:    
 3290: 
 3291: 
 3292:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3293:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3294:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3295:    if (nodeBnd != nullptr)  { 
 3296:       // If it is an open boundary node...
 3297: 
 3298:       // At least one open bnd side, maybe two
 3299:       for (int l=0; l<2; l++) { 
 3300: 
 3301:          // Gets each of the sides sharing the node. 
 3302:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3303: 
 3304:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3305: 
 3306:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3307: 
 3308:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3309:          if (sideBnd != nullptr) {
 3310:             // If the side is on a boundary...
 3311: 
 3312:             // Get the boundary segment
 3313:             const BoundarySegment *sideSegment = sideBnd->segment;
 3314:             const Side *side = sideBnd->side;
 3315: 
 3316:             // Integral I_3
 3317:             if (sideSegment->ifltype != 0) {
 3318:             // Natural or Flather b.c.
 3319: 
 3320:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3321:                // especially for Flather b.c.
 3322:                double ri3 = 0.0;
 3323:                if (!side->isDry) {
 3324:                   // If the side is not dry
 3325:                   
 3326:                   // Computes the side flux of (uth, vth)
 3327:                   double Vn = 0.0;
 3328:                   for (int k = side->kb; k<nvrt-1; k++) {
 3329:                      // uth, vth in lat/lon frame if ics=2
 3330:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3331:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3332:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3333: 
 3334:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3335:                   }
 3336: 
 3337:                   ri3 = 0.5*side->len*Vn;
 3338:                }
 3339: 
 3340:                if (sideSegment->ifltype == -1) { // Flather 1
 3341: 
 3342:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3343:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3344: 
 3345:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3346:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3347:                   
 3348:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3349:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3350: 
 3351:                } 
 3352:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3353:                   // Reset ri3
 3354:                   ri3 = 0.0;
 3355: 
 3356:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3357: 
 3358:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3359: 
 3360:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3361:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3362: 
 3363:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3364:                   node1->addToSparseMatrix(node1, con0*2.0);
 3365:                   node1->addToSparseMatrix(node2, con0);
 3366: 
 3367:                } // if Flather or Discharge
 3368: 
 3369:                node1->qel -= thetai*dt*ri3;
 3370: 
 3371:             } // I_3
 3372:           
 3373: 
 3374:             // Integral I_5
 3375:             if(!side->isDry) {
 3376: 
 3377:                const double Unbar = dot(side->U, side->n);
 3378: 
 3379:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3380:                
 3381:             } // I_5
 3382: 
 3383:          } // if is boundary side
 3384: 
 3385:       } // for l
 3386: 
 3387:    } // if isbnd
 3388: 
 3389: 
 3390:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3391: 
 3392: }
 3393: 
 3394: 
 3395: 
 3396: extern "C" {
 3397:    __global__ void rollUpElevation(void) {
 3398: 
 3399:       NODE(node);
 3400: 
 3401:       node->eta2 += node->eta1;
 3402: 
 3403:    }
 3404: 
 3405: 
 3406:    __global__ void backtrackAllNodes(void) {
 3407: 
 3408:       // max/min # of sub-divisions
 3409:       const int ndelt_max = max(1.0, dt/dtb_min);
 3410:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3411: 
 3412:       // Removed all references to swild98 XXX
 3413:       // swild98=0.d0 !init
 3414: 
 3415: 
 3416:       SIDE(side);
 3417: 
 3418:       const int kb = side->kb;
 3419: 
 3420: 
 3421: 
 3422:       // Initialize btrack velocities to the actual velocities at the side 
 3423:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3424: 
 3425: 
 3426:       if (side->isDry) return;
 3427: 
 3428: 
 3429:       // Checks that at least one element is not dry
 3430:       const Element *elem1 = side->elems[0];
 3431:       const Element *elem2 = side->elems[1];
 3432: 
 3433: 
 3434:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3435:       
 3436:       // XXXXXX
 3437:       // !swild_tmp to store global coord. of the starting side
 3438:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3439:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3440:       // !Use sframe2 
 3441:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3442: 
 3443: 
 3444:       for (int k = kb; k < nvrt; k++) {
 3445:       //  Initialize (xt,yt,zt), nnel and vel.
 3446:       //  For ics=2, the coordinates are in local frames
 3447:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3448: 
 3449: 
 3450:          const int iadvf = side->iadv();  // Advection flag
 3451: 
 3452:          Point3 xt;
 3453:          if constexpr(ics==1) {
 3454:             xt = side->center3D(k); 
 3455:          }
 3456:          else // lat/lon; in side lat/lon frame
 3457:          {
 3458:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3459:          // XXX IMPLEMENT THIS
 3460:       //          xt=0.d0
 3461:       //          yt=0.d0
 3462:       //          !centroid coord. for nudging
 3463:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3464:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3465:          }  // ics
 3466: 
 3467: 
 3468:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3469:          // XXX IS THIS NECESSARY?
 3470:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3471: 
 3472:          // If on land or open boundary...
 3473:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3474:          
 3475:          const double vmag = length(toVector2(u_int));
 3476: 
 3477:          if (vmag <= velmin_btrack) {
 3478:             // No activity 
 3479: addDebugPlot(side->center, side->center, 'red');
 3480:             side->btu[k] = side->u2[k];
 3481:             
 3482:          } else {  // do btrack
 3483: 
 3484:             // Compute number of sub-divisions based on local gradients 
 3485:             // XXX IS THIS NECESSARY?
 3486:             double suma = 0.0;
 3487:             int icount = 0;
 3488:             for (int ii=0; ii<2; ii++) {
 3489: 
 3490:                const Element *elem = side->elems[ii];
 3491:                  
 3492:                if (elem == nullptr) continue;
 3493: 
 3494:                icount++;
 3495: 
 3496:                // Not strictly along z; in ll frame for ics=2
 3497: 
 3498:                double utmp[4];
 3499:                double vtmp[4];
 3500:                for (int jj = 0; jj < elem->i34; jj++) {
 3501: 
 3502:                   const Node *node = elem->nodes[jj];
 3503: 
 3504:                   if constexpr(ics==1) {
 3505:                      utmp[jj] = node->u2[k].x;
 3506:                      vtmp[jj] = node->u2[k].y;  
 3507:                   } else {
 3508:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3509:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3510:                   }
 3511:                } // for jj
 3512: 
 3513:                const Vector2 grad_u = elem->grad2(utmp); 
 3514:                const Vector2 grad_v = elem->grad2(vtmp);
 3515: 
 3516:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3517:             } // for ii
 3518: 
 3519:             assert(icount > 0 && "Impossible 77");
 3520: 
 3521:             // '4' is somewhat arbitrary
 3522:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3523: 
 3524:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3525:          
 3526: 
 3527:             Vector3 u_int = {0.0, 0.0, 0.0};
 3528: 
 3529:             side->btrack(k, dt, dtbk, u_int);
 3530:                
 3531:          } // if vmag (do backtrack)
 3532: 
 3533:       } // for j=jmin,nvrt-1
 3534: 
 3535:    }
 3536: } // extern "C"
 3537: 
 3538: template<int nc>
 3539: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3540: 
 3541: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3542: //
 3543: // a,b,c,rhs: input vectors and are not modified by this program.
 3544: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3545: // rhs is the r.h.s.
 3546: // n: actual rank of the system.
 3547: // rows in u() and rhs();
 3548: // u: output with nc columns (transposed to rows)
 3549: // gam: a working array.
 3550: //
 3551: // NOTES:
 3552: // This is a template function that allows for different numbers of columns in the rhs vector.
 3553: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3554: 
 3555:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3556:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3557: 
 3558:    double bet = b[0];
 3559:    if constexpr (nc == 1) {
 3560:       u[0] = rhs[0]/bet;
 3561:    } else {
 3562:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3563:    }
 3564: 
 3565:    for (int j = 1; j < n; j++) {
 3566:       gam[j] = c[j-1]/bet;
 3567:       bet = b[j] - a[j]*gam[j];
 3568: 
 3569:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3570: 
 3571:       if constexpr (nc == 1) {
 3572:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3573:       } else {
 3574:          for (int k = 0; k < nc; k++) {
 3575:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3576:          }
 3577:       }
 3578:    }
 3579: 
 3580:    // Back-substitution
 3581:    for (int j=n-1; j>=1; j--) {
 3582:       if constexpr (nc == 1) {
 3583:          u[j] = u[j] - gam[j+1]*u[j-1];
 3584:       } else {
 3585:          for (int k = 0; k < nc; k++) {
 3586:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3587:          }
 3588:       }
 3589:    }
 3590: }
 3591: 
 3592: 
 3593: 
 3594: // Helper function that contains the core algorithm
 3595: template<typename XAccessor, typename YAccessor>
 3596: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3597:                                     double  yp_top, double  yp_bot, 
 3598:                                     CubicSpline &spline) {
 3599:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3600:    // 
 3601:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3602:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3603:    //
 3604:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3605:    // 
 3606:    // Inputs: 
 3607:    //            n: dimension for x etc; # of data pts (>=2);
 3608:    //            getX, getY: functions to access x,y coordinates
 3609:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3610:    //     Output: 
 3611:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3612: 
 3613:    const int n = k2 - k1 + 1;
 3614:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3615: 
 3616:    // Allocate memory for the splines
 3617:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3618:    spline.x   = new double[n];
 3619:    spline.y   = new double[n];
 3620:    spline.yp  = new double[n];
 3621:    spline.ypp = new double[n];
 3622: 
 3623:    for (int k=k1; k<=k2; k++) {
 3624:       spline.x[k] = getX(k);
 3625:       spline.y[k] = getY(k);
 3626:    }
 3627: 
 3628:    // This is to simplify expressions later
 3629:    double *x = spline.x;
 3630:    double *y = spline.y;
 3631: 
 3632:    double *a = nullptr;
 3633:    double *b = nullptr;
 3634:    double *c = nullptr;
 3635:    double *gam = nullptr;
 3636:    double *rhs = nullptr;
 3637:    
 3638: 
 3639:       a = new double[n];   // Lower diagonal
 3640:       b = new double[n];   // Diagonal
 3641:       c = new double[n];   // Upper diagonal
 3642:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3643:       rhs = new double[n]; // Right-hand side
 3644: 
 3645:    for (int k=k1; k<=k2; k++) {
 3646:       if (k == k1) {
 3647:          // Bottom level
 3648:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3649:          b[k] = (x[k+1] - x[k])/3.0;
 3650:          c[k] = b[k]/2.0;
 3651:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3652:       } else if (k == n - 1) {
 3653:          // Top level (surface)
 3654:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3655:          b[k] = (x[k] - x[k-1])/3.0;
 3656:          a[k] = b[k]/2.0;
 3657:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3658:       } else {
 3659:          // Intermediate levels
 3660:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3661:          b[k] = (x[k+1] - x[k-1])/3.0;
 3662:          a[k] = (x[k  ] - x[k-1])/6.0;
 3663:          c[k] = (x[k+1] - x[k  ])/6.0;
 3664:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3665:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3666:       }
 3667:    }
 3668: 
 3669:    // Solve the tridiagonal system
 3670:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3671:    
 3672:    spline.yp[k1] = yp_bot;
 3673:    spline.yp[k2] = yp_top;
 3674: 
 3675:    // Compute rest of 1st derivatives using the splines
 3676:    for (int k=k1+1; k<k2; k++) {
 3677:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3678:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3679:    }
 3680:    
 3681:    delete[] a;
 3682:    delete[] b;
 3683:    delete[] c;
 3684:    delete[] gam;
 3685:    delete[] rhs;
 3686: 
 3687: }
 3688: 
 3689: // Array version
 3690: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3691:                                 double y_top, double y_bot, 
 3692:                                 CubicSpline &spline) {
 3693:    auto getX = [x] (int k) { return x[k]; };
 3694:    auto getY = [y] (int k) { return y[k]; };
 3695:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3696: }
 3697: 
 3698: // Lambda version - allows custom access patterns
 3699: template<typename XFunc, typename YFunc>
 3700: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3701:                                 double y_top, double y_bot,
 3702:                                 CubicSpline &spline) {
 3703:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3704: }
 3705: 
 3706: 
 3707: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3708: {
 3709:    assert("Not implemented");
 3710: 
 3711:    return 0.0;
 3712: }
