 8595: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8596:    Element *elems = mesh->localElemData;
 8597: 
 8598:    *addr = elems;
 8599:    *sizeElement = sizeof(Element);
 8600:    switch (varCode) {
 8601:       case (int)VarCode::z:
 8602:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8603:          *sizeType = sizeof(double);
 8604:          break;
 8605:       case (int)VarCode::x:
 8606:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8607:          *sizeType = sizeof(Vector2);
 8608:          break;
 8609:       case (int)VarCode::gradETP:
 8610:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8611:          *sizeType = sizeof(Vector2);
 8612:          break;
 8613:       case (int)VarCode::area:
 8614:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8615:          *sizeType = sizeof(double);
 8616:          break;
 8617:       case (int)VarCode::depth:
 8618:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8619:          *sizeType = sizeof(double);
 8620:          break;
 8621:       case (int)VarCode::radius:
 8622:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8623:          *sizeType = sizeof(double);
 8624:          break;
 8625:       case (int)VarCode::ghat:
 8626:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8627:          *sizeType = sizeof(Vector2);
 8628:          break;
 8629:       case (int)VarCode::kb:
 8630:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8631:          *sizeType = sizeof(int);
 8632:          break;
 8633:       case (int)VarCode::isdry:
 8634:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8635:          *sizeType = sizeof(int);
 8636:          break;            
 8637:       case (int)VarCode::w:
 8638:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8639:          *sizeType = sizeof(double);
 8640:          break;
 8641:       case (int)VarCode::FaceIndices:
 8642:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8643:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8644:          *sizeType = sizeof(Node);
 8645:          break;
 8646:       default:
 8647:          *offset = -1;
 8648:    }
 8649: }
