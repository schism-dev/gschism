  935:    __device__ double interpolate(const ShapeCoords &shapeCoords, const double zAtNodes[4]) const
  936:    {
  937:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  938:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  939:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  940:       
  941:    }
