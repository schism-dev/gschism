 2298: __device__ void lock(int *mutex) {
 2299:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2300: }
 2301: 
 2302: __device__ void unlock(int *mutex) {
 2303:     atomicExch(mutex, 0);
 2304: }
