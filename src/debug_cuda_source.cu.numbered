 2006:    template<typename T>
 2007:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2008:       // Get the values of the field at the nodes of the element
 2009:       res[0] = nodes[0]->*field;
 2010:       res[1] = nodes[1]->*field;
 2011:       res[2] = nodes[2]->*field;
 2012:       if (isQuad()) res[3] = nodes[3]->*field;
 2013:       else          res[3] = T();
 2014:    }
 2015: 
 2016:    template<typename T>
 2017:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2018:       // Get the values of the field at the nodes of the element
 2019:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2020:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2021:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2022:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2023:       else          res[3] = T();
 2024:    }    
 2025: 
 2026:    template<typename T>
 2027:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2028:       // Get the values of the func at the nodes of the element
 2029:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2030:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2031:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2032:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2033:       else          res[3] = T();  // This is 0.0 or a zero vector
 2034: 
 2035:    }      
 2036: 
 2037:    template<typename T>
 2038:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2039:       // Get the values of the field at the nodes of the element
 2040:       res[0] = sides[0]->*field;
 2041:       res[1] = sides[1]->*field;
 2042:       res[2] = sides[2]->*field;
 2043:       if (isQuad()) res[3] = sides[3]->*field;
 2044:       else          res[3] = T();
 2045:    }
 2046: 
 2047:    template<typename T>
 2048:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2049:       // Get the values of the field at the nodes of the element
 2050:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2051:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2052:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2053:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2054:       else          res[3] = T();
 2055:    }    
 2056: 
 2057:    template<typename T>
 2058:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2059:       // Get the values of the func at the nodes of the element
 2060:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2061:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2062:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2063:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2064:       else          res[3] = T();  // This is 0.0 or a zero vector
 2065: 
 2066:    }      
 2067: 
 2068:    
 2069:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2070:    // Project the vectors from the node frame to the element frame
 2071: 
 2072:  
 2073:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2074:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2075:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2076:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2077:       else          v[3] = Vector2();
 2078:    }
 2079: 
 2080:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2081:    // Project the vectors from the side frame to the element frame
 2082: 
 2083:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2084:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2085:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2086:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2087:       else          v[3] = Vector2();
 2088:    }
