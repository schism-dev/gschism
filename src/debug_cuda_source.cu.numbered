 2802: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2803: 
 2804: 
 2805: __device__ void Node::updateKb(void) {
 2806: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2807: 
 2808:    if constexpr(ivcor == 1) return;
 2809: 
 2810: 
 2811:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2812: 
 2813:    if constexpr(ivcor == 2) {  // SZ coordinates
 2814:       
 2815:       // Compute bottom level index
 2816:       if (depth <= mesh->h_s) {
 2817:          kb = izlev;   
 2818:          
 2819:       } else {
 2820:          kb = -1;
 2821:          int L = 0;
 2822:          int R = nzlev; 
 2823:          
 2824:          while (L <= R) {
 2825:             int M = (R + L) / 2;
 2826: 
 2827: 
 2828:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2829:             
 2830:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2831:                R = M;
 2832:             } else {
 2833:                L = M;
 2834:             }
 2835: 
 2836:             if (R - L == 1) {
 2837:                kb = L;
 2838:                break;
 2839:             }
 2840:          }
 2841: 
 2842:          // Checks that the binary search was successful
 2843:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2844:        
 2845:       }
 2846:    } 
 2847: }
 2848: 
 2849: 
 2850: __device__ __inline__ void Node::updateZCoordData(void) {
 2851: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2852: 
 2853:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2854:    // if (isDry2()) {
 2855:    //    kb = -1;  // XXXXXXXX KKKKK
 2856:    //    return;
 2857:    // }
 2858: 
 2859: 
 2860:    if constexpr(ivcor == 2) {  // SZ coordinates
 2861:       
 2862:       // Compute bottom level index
 2863:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2864:    } 
 2865:    else if (ivcor == 1) {  // Localized sigma
 2866:       // Do nothing
 2867:    }
 2868: 
 2869: 
 2870: }
 2871: 
 2872: 
 2873: __device__ double Node::compZCoord(int k) const {
 2874:    // Computes the z coordinate at level k.
 2875:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2876:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2877:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2878:    // used 
 2879: 
 2880:    assert(k >= 0 && k < nvrt && "ZCOOR: invalid level\n");
 2881:    
 2882:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2883: 
 2884:    if (isDry2()) return 0.0;  // XXXX I used to return 0.0
 2885: 
 2886:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2887: 
 2888:    if constexpr(ivcor == 2) {
 2889: 
 2890:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2891:       const double h_c = mesh->h_c;
 2892:       const double theta_f = mesh->theta_f;
 2893:       const double sinh_theta_f = mesh->sinh_theta_f;
 2894: 
 2895: 
 2896:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2897:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2898:       // once per time step/node.
 2899:       // CHECK: updateZCoordData
 2900: 
 2901:       //  To simplify comparisons, I define index versions of count variables.
 2902:       if      (k == ivrt)     return eta2; 
 2903:       else if (k == izlev)    return -hmod2;
 2904:       else if (k == kb)       return -depth;
 2905:       else if (k < izlev)     return mesh->ztot[k];
 2906:       else if (k > izlev) {
 2907:          const int ksig = k - izlev;
 2908: 
 2909:          if (hmod2 <= h_c) {
 2910:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2911: 
 2912:          } 
 2913:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 2914:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2915:             assert(false && "ZCOOR: invalid h_c\n");
 2916:          } 
 2917:          else {
 2918:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2919:                    h_c * mesh->sigma[ksig] + 
 2920:                    (hmod2 - h_c) * mesh->cs[ksig];
 2921:          }
 2922:       } else { 
 2923:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2924:       }
 2925: 
 2926:    }
 2927:    else if constexpr(ivcor == 1) {
 2928:       if (k == kb) return -depth;
 2929:       else if (k == nvrt-1) return eta2;
 2930:       else if (k > kb) return (eta2 + depth)*localSigma[k] + eta2;
 2931:    }
 2932:    
 2933:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2934:    return 0.0;
 2935: }
 2936: 
 2937: 
 2938: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2939:    // Computes the bottom drag Cd based on the selected nchi
 2940: 
 2941:    if constexpr(nchi == 0) {
 2942:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2943:       Cd = drag;  // Read from drag file
 2944: 
 2945:    } else if constexpr(nchi == 1) {
 2946:       // 
 2947: 
 2948:       bool ltmp = false; // for WBL iteration
 2949: 
 2950:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2951:       if (isDry || (rough == 0.0)) {
 2952:          Cd = 0.0;
 2953: 
 2954:       } else { //roughness >0 
 2955:          
 2956:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2957: 
 2958:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2959: 
 2960:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2961: 
 2962:       } // if rough
 2963: 
 2964:    } else if constexpr(nchi == -1) {
 2965:    // Manning 
 2966:  
 2967:       const double htot = max(hmin_man, htot2()); 
 2968:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2969: 
 2970:    } else {
 2971:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2972:       
 2973:    } // if nchi
 2974: 
 2975: }
 2976: 
 2977: 
 2978: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2979:    // Checks if a side in on the boundary
 2980:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2981: 
 2982:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2983:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2984: 
 2985:    // Indices of the nodes that form the side
 2986:    const int n1 = side.n1->idx;
 2987:    const int n2 = side.n2->idx;
 2988:    isLand = false;
 2989:    
 2990: 
 2991:    // Check if the side is on a land boundary
 2992:    for (int i = 0; i < nland; i++) {
 2993:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2994:          // Consecutive nodes in the land boundary segment
 2995:          const int b1 = ilnd[i + j*nland];
 2996:          const int b2 = ilnd[i + (j + 1)*nland];
 2997: 
 2998:          assert(b1 != -1 && b2 != -1);
 2999: 
 3000:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3001:             
 3002:             isLand = true;
 3003:             return i;
 3004:          }
 3005:       }
 3006:    }
 3007: 
 3008:    // Check if the side is on an open boundary
 3009:    for (int i = 0; i < nope; i++) {
 3010:       for (int j = 0; j < nond[i] - 1; j++) {
 3011:          // Consecutive nodes in the open boundary segment
 3012:          const int b1 = iond[i + j*nope];
 3013:          const int b2 = iond[i + (j + 1)*nope];
 3014: 
 3015:          assert(b1 != -1 && b2 != -1);
 3016: 
 3017:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3018:             isLand = false;
 3019:             return i;
 3020:          }
 3021:       }
 3022:    }
 3023: 
 3024:    return -1;
 3025: }
 3026: 
 3027: 
 3028: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3029:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3030:                                     double *wind_rotate_angle, 
 3031:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3032:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3033:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3034:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3035:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3036: 
 3037:    NODE(pnode);  
 3038:    const int i = idx_node;
 3039:    Node &node(*pnode);
 3040: 
 3041:    node.idx = i;
 3042: 
 3043:    const int idxNodeStart = nodeNeighNodesStart[i];
 3044:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3045:    node.numNodes = idxNodeEnd - idxNodeStart;
 3046:    node.nodes = nodeNeighNodes + idxNodeStart;
 3047:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3048: 
 3049: 
 3050: 
 3051:    const int idxElemStart = nodeNeighElemsStart[i];
 3052:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3053:    node.numElements = idxElemEnd - idxElemStart;
 3054:    node.elements = nodeNeighElems + idxElemStart;
 3055: 
 3056: 
 3057:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3058:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3059:       const int partNode = localNodePart[idxNodeGlobal]; 
 3060:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3061: 
 3062:       Node *node_ptr = nodes[partNode] + idxNode;
 3063:       
 3064:       nodeNeighNodes[idx] = node_ptr;
 3065:    }
 3066: 
 3067: 
 3068:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3069:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3070:       const int partElem = localElemPart[idxElemGlobal];
 3071:       const int idxElem  = localElemIndices[idxElemGlobal];
 3072: 
 3073:       Element *elem_ptr = elems[partElem] + idxElem;
 3074: 
 3075:       nodeNeighElems[idx] = elem_ptr;
 3076:    }      
 3077: 
 3078:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3079:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3080: 
 3081:    node.p.x   = node_coords[i * 3];
 3082:    node.p.y   = node_coords[i * 3 + 1];
 3083:    node.depth = node_coords[i * 3 + 2];
 3084: 
 3085:    if (use_ll) {
 3086:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3087:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3088:    }
 3089: 
 3090: 
 3091:    node.numSides = 0;
 3092: 
 3093:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3094:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3095:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3096:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3097:    else assert(false && "populateNodes: selected nchi not implemented.");
 3098:    
 3099:    if constexpr(ivcor == 1) node.kb = kb[i];
 3100: 
 3101:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3102:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3103:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3104: 
 3105:    
 3106:    // Links the node to the boundary information
 3107:    if (isbnd[i] >= 0) {
 3108:      
 3109:       // Get the index of the node boundary
 3110:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3111: 
 3112:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3113:       node.nodeBnd->node = &node;
 3114: 
 3115:       node.nodeBnd->sideBnd1 = nullptr;
 3116:       node.nodeBnd->sideBnd2 = nullptr;
 3117: 
 3118:       if (isbnd[i]>=0) {
 3119: 
 3120:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3121:          
 3122:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3123:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3124: 
 3125:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3126:          node.nodeBnd->segment->clen  = nan("1");
 3127:          node.nodeBnd->segment->carea = nan("1");
 3128: 
 3129:       }
 3130:    } else {
 3131: 
 3132:       node.nodeBnd = nullptr; // For internal nodes
 3133: 
 3134:       if (isbnd[i] == landSegment) {
 3135:          node.nodeBnd = &landBoundaryNode;
 3136:          node.nodeBnd->segment = &landBoundarySegment;
 3137:       }
 3138:       
 3139:    }
 3140:    
 3141:    // XXXX GAUSSIAN HILL VELOCITIES
 3142: #ifdef GAUSSIAN_HILL_VELOCITIES
 3143:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3144:       constexpr double rot_per = 3000.0;
 3145:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3146:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3147:    // XXXXX
 3148: #endif
 3149: 
 3150: }
 3151: 
 3152: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3153:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3154:                                     double *wind_rotate_angle,   
 3155:                                     int *isdel, int *isidenode, int *isbnd,
 3156:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3157:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3158:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3159:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3160:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3161:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3162:                                     double *drag, double *roughness) {
 3163: 
 3164: 
 3165:    SIDE(pside);
 3166:    Side &side(*pside);
 3167:    const int i = idx_side;
 3168: 
 3169:    side.idx = i;  
 3170:    
 3171:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3172:    const double fc   = 2.0*omega_e*sin(sfea0);
 3173:    const double beta = 2.0*omega_e*cos(sfea0);
 3174: 
 3175:    // finding the pointer to the nodes that form the side
 3176:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3177:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3178: 
 3179:    const int locidx_n1 = localNodeIndices[idx_n1];
 3180:    const int locidx_n2 = localNodeIndices[idx_n2];
 3181:    const int part_n1 =   localNodePart[idx_n1];
 3182:    const int part_n2 =   localNodePart[idx_n2];
 3183: 
 3184:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3185:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3186: 
 3187:    // Counts the number of sides connected to each node
 3188:    side.n1->numSides++;
 3189:    side.n2->numSides++;
 3190: 
 3191:    // Normal, unitary vector to the side
 3192:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3193:    side.n = normalize(side.n);
 3194: 
 3195:    // Side boundary type
 3196:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3197:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3198: 
 3199:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3200:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3201:    {
 3202:       bool isLand = false;
 3203:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3204:       
 3205:       if (isbs > -1) {
 3206:          // assert(isLand || isbs>=0);
 3207:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3208: 
 3209:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3210: 
 3211:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3212:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3213: 
 3214:          assert (isLand == side.sideBnd->segment->isLand);
 3215: 
 3216:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3217:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3218:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3219: 
 3220:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3221:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3222:          
 3223:          side.sideBnd->side = &side;
 3224: 
 3225:       }
 3226:       else {
 3227:          side.sideBnd = nullptr;
 3228:       }
 3229:    }
 3230:    else 
 3231:    {
 3232:       side.sideBnd = nullptr;
 3233:    }
 3234: 
 3235: 
 3236:    // finding the pointer to the elements that share the side
 3237:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3238:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3239: 
 3240:    if (idx_e1 > -1) {
 3241:       const int locidx_e1 = localElemIndices[idx_e1];
 3242:       const int part_e1 =  localElemPart[idx_e1];
 3243:       side.elems[0] = elems[part_e1] + locidx_e1;
 3244: 
 3245:    }
 3246:    else {
 3247:       side.elems[0] = nullptr;
 3248:    }
 3249: 
 3250:    if (idx_e2 > -1) {
 3251:       const int locidx_e2 = localElemIndices[idx_e2];
 3252:       const int part_e2 =  localElemPart[idx_e2];
 3253:       side.elems[1] = elems[part_e2] + locidx_e2;
 3254:    }
 3255:    else {
 3256:       side.elems[1] = nullptr;
 3257:    }
 3258: 
 3259:    // Compute the center of the side
 3260:    side.center = 0.5*(side.n1->p + side.n2->p);
 3261: 
 3262:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3263:    side.shapiro = shapiro0;
 3264: 
 3265: #ifdef GAUSSIAN_HILL_VELOCITIES
 3266: // XXXX
 3267: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3268: constexpr double rot_per=3000.0;
 3269: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3270: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3271: // XXXXX      
 3272: #endif
 3273:    // Compute the z level at the center of the side
 3274:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3275:    
 3276:    // Compute the length of the side
 3277:    const Vector2 vLen = side.n2->p - side.n1->p;
 3278:    side.len = sqrt(dot(vLen, vLen));
 3279: 
 3280: 
 3281:    // Compute the Coriolis coefficient
 3282: 
 3283:    if constexpr(ncor == -1 || ncor == 0) {
 3284:       side.coriolis = coricoef;
 3285:    }
 3286:    else {
 3287:       const double sphi = side.lat();  // Latitude at the center of the side
 3288: 
 3289: // XXXXXX ERROR WHEN use_ll is false??????
 3290:       if constexpr(ics == 1) {
 3291:          // XXXXXXX
 3292:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3293:       }
 3294:       else {
 3295:          side.coriolis = 2.0*omega_e*sin(sphi);
 3296:       }
 3297: 
 3298:    }
 3299: }
 3300: 
 3301: 
 3302: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3303:    double *node_coords, double *node_coords_ll, bool use_ll,
 3304:    double *wind_rotate_angle,   
 3305:    int *isdel, int *isidenode, int *isbnd,
 3306:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3307:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3308:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3309:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3310:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3311:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3312:    double *drag, double *roughness) {
 3313: 
 3314:    ELEM(pelem);
 3315:    Element &elem(*pelem);
 3316:    const int i = idx_elem;
 3317: 
 3318:    elem.idx = i;
 3319: 
 3320:    for (int j = 0; j < i34[i]; j++) {
 3321:       const int idxNode = elnode[i*4 + j];  
 3322:       const int idxSide = elside[i*4 + j];
 3323:       
 3324:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3325:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3326: 
 3327:       // Find the neighboring element  
 3328:       if (elem.sides[j]->elems[0] == &elem) {
 3329:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3330:       }
 3331:       else {
 3332:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3333:       }
 3334:       
 3335:    }
 3336: 
 3337:    elem.i34 = i34[i];
 3338: 
 3339:    // Compute the barycenter of the element and its depth
 3340:    elem.center = {0.0, 0.0};
 3341:    elem.depth = 0.0;
 3342:    for (int j = 0; j < i34[i]; j++) {
 3343: 
 3344:       elem.center += elem.nodes[j]->p/i34[i];
 3345:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3346:    }
 3347: 
 3348: 
 3349:    
 3350:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3351:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3352: 
 3353:    elem.area = elem.computeSignedArea(); 
 3354:    elem.radius = sqrt(elem.area)/pi; 
 3355:    
 3356:    // Determines which way the normal vector to each side is oriented.
 3357:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3358:    for (int j = 0; j < i34[i]; j++)  
 3359:    {
 3360:       if (elem.sides[j]->elems[0] == &elem) {
 3361:          elem.ssign[j] =  1.0;
 3362:       }
 3363:       else {
 3364:          elem.ssign[j] = -1.0;
 3365:       }
 3366: 
 3367:    }
 3368: 
 3369:    // Derivatives of shape functions
 3370:    //  For ics=2, this is done inside element/ll frame XXX
 3371:    //  For quads, the derivative is evaluated at centroid
 3372:    for (int j = 0; j < elem.i34; j++) {
 3373:       const double area = elem.area;
 3374:       const int id2 = elem.nxq(1 + j);
 3375:       const int id3 = elem.nxq(2 + j);
 3376:       const int id4 = elem.nxq(3 + j);
 3377:       if (elem.isTri()) {
 3378:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3379:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3380:          // da1/dx = (y1 - y2)/(2*area)
 3381:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3382:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3383:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3384:       }
 3385:       else  { // Quad; evaluate at centroid
 3386:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3387:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3388:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3389:       } // if Tri
 3390: 
 3391:    } // for j   
 3392:    
 3393:    
 3394: 
 3395: }
 3396: 
 3397: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3398:                                             double *emo, double *efa, 
 3399:                                             double *umo, double *ufa, 
 3400:                                             double *vmo, double *vfa) {
 3401: 
 3402: 
 3403:    NODE_BND(nodeBnd);
 3404:    const int idx = idx_node_bnd;    
 3405: 
 3406:    nodeBnd->idx = idx;
 3407: 
 3408:    // Need to find the segment index and the index of the node on the segment
 3409:    int idxNode = -1;
 3410:    int iseg, i;
 3411:    for (iseg = 0; iseg < nope; iseg++) {
 3412:       // for each segment...
 3413:       for (i = 0; i < nond[iseg]; i++) {
 3414:          idxNode = iond[iseg + i*nope];
 3415:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3416:          
 3417:       }
 3418:    }
 3419: 
 3420:    assert(iseg < nope && "iseg is out of bounds");
 3421: 
 3422: found: // Jumped here when the node was found
 3423: 
 3424:    nodeBnd->isEssentialBC = true;
 3425:    nodeBnd->elbc = 0.0;
 3426: 
 3427:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3428: 
 3429:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3430:       nodeBnd->efa[jfr] = efa[idx2];
 3431:       nodeBnd->emo[jfr] = emo[idx2];
 3432:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3433:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3434: 
 3435:    }
 3436:         
 3437: 
 3438: }
