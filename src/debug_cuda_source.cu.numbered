 1565: // Helper functions for computing the local node index at a given offset from another.
 1566: __device__ __inline__ int nxq(int offset, int index, int size) {
 1567:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1568:    // to the index to make it positive
 1569:    assert(index + offset + 16*size >= 0);
 1570:    return (index + offset + 16*size) % size;  
 1571: }
 1572: 
 1573: __device__ __inline__ int nxq(int index, int size) {
 1574:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1575:    // to the index to make it positive
 1576:    assert(index + 16*size >= 0);
 1577:    return (index + 16*size) % size; 
 1578: }
