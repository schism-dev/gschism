 3600: 
 3601: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3602: 
 3603: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3604: 
 3605:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3606:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3607: 
 3608:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3609:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3610: 
 3611:    double fun_lat = 0.0;
 3612:    switch (jspc[idxComp]) {
 3613:       case 0:
 3614:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3615:          break;
 3616:       case 1:
 3617:          fun_lat = sin(2.0*lat);
 3618:          break;
 3619:       case 2:
 3620:          fun_lat = pow<2>(cos(lat));
 3621:          break;
 3622:       default:
 3623:          assert(false && "computeETP: invalid jspc");
 3624:    }
 3625:    
 3626:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3627: 
 3628: }
 3629: 
 3630: 
 3631: __device__ void Node::updateKb(void) {
 3632: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3633: 
 3634:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3635: 
 3636: 
 3637:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3638: 
 3639:    if constexpr(ivcor == 2) {  // SZ coordinates
 3640:       
 3641:       // Compute bottom level index
 3642:       if (depth <= mesh->h_s) {
 3643:          kb = izlev;   
 3644:          
 3645:       } else {
 3646:          kb = -1;
 3647:          int L = 0;
 3648:          int R = nzlev; 
 3649:          
 3650:          while (L <= R) {
 3651:             int M = (R + L) / 2;
 3652: 
 3653: 
 3654:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3655:             
 3656:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3657:                R = M;
 3658:             } else {
 3659:                L = M;
 3660:             }
 3661: 
 3662:             if (R - L == 1) {
 3663:                kb = L;
 3664:                break;
 3665:             }
 3666:          }
 3667: 
 3668:          // Checks that the binary search was successful
 3669:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3670:        
 3671:       }
 3672:    } 
 3673: }
 3674: 
