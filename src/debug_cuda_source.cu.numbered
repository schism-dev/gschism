 2256:    template<typename T>
 2257:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2258:       T values[4];
 2259:       getNodalValues(level, func, values);
 2260: 
 2261:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2262:       if constexpr (IsVector2<T>::value && ics == 2) {
 2263: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2264:          projectNodeVectorsToElementFrame(values);
 2265: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2266:       }
 2267: 
 2268:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2269:    }
 2270: 
 2271:    template<typename T>
 2272:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2273:       T values[4];
 2274:       getNodalValues(field, values);
 2275: 
 2276:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2277:       if constexpr (IsVector2<T>::value && ics == 2) {
 2278: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2279:          projectNodeVectorsToElementFrame(values);
 2280: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2281:       }
 2282:       
 2283:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2284:    }
 2285: 
 2286: 
 2287:    template<typename T>
 2288:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2289:       T values[4];
 2290:       getNodalValues(level, field, values);
 2291:       
 2292: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2293:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2294:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2295:       if constexpr (IsVector2<T>::value && ics == 2) {
 2296: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2297:          projectNodeVectorsToElementFrame(values);
 2298: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2299:       }
 2300: 
 2301:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2302:    }
 2303: 
 2304:    template<typename T>
 2305:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2306:       T values[4];
 2307:       getNodalValues(field, values);
 2308: 
 2309:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2310:       if constexpr (IsVector2<T>::value && ics == 2) {
 2311: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2312:          projectNodeVectorsToElementFrame(values);
 2313: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2314:       }
 2315: 
 2316:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2317:    }
 2318: 
 2319:    template<typename T>
 2320:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2321:       T values[4];
 2322:       getSideValues(field, values);
 2323:       
 2324:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2325:       if constexpr (IsVector2<T>::value && ics == 2) {
 2326: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2327:          projectSideVectorsToElementFrame(values);
 2328: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2329:       }
 2330: 
 2331:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2332:    }   
 2333: 
 2334:    template<typename T>
 2335:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2336: 
 2337:       T values[4];
 2338: 
 2339: 
 2340:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2341:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2342:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2343:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2344:       else          values[3] = T();
 2345: 
 2346:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2347: 
 2348:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2349:    }
