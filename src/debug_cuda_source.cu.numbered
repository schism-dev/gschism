 1566: __device__ __inline__ double min3(double a, double b, double c) {
 1567:    return min(a, min(b, c));
 1568: }
 1569: 
 1570: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1571:    return min(a, min(b, min(c, d)));
 1572: }
