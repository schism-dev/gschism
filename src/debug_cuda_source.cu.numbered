 4521:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4522: 
 4523:       NODE_BND(nodeBnd);
 4524: 
 4525:       Node *node = nodeBnd->node;
 4526: 
 4527:       node->ETP = 0.0;
 4528: 
 4529:       for (int j=0; j<ntip; j++) {
 4530: 
 4531:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4532:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4533:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4534: 
 4535:          if constexpr(iloadtide==1) { // loading tide
 4536:             assert(false && "Loading tide not implemented");
 4537:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4538:          }
 4539:          
 4540:       }
 4541:       
 4542:    }
