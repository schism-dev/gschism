  969: 
  970:    __inline__ __device__ bool containsPoint(Vector2 xt, const Side *origSide) const;
  971: 
  972:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const;
  973: 
  974:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  975:    {
  976:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  977:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  978:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  979:       
  980:    }
  981: 
  982:    __device__ Vector3 interpolateVelocities(Point3 xt, const Side *origSide = nullptr) const;
  983: 
  984:    // ------------------------------------------------------------------------------------------------
  985:    // These are functions that work on all nodes/sides of the element.
  986:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  987:    //
  988:    // An example of how to use these functions is:
  989:    //   
  990:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  991:    // 
  992:    // Where L is the level at which the field is to be interpolated. The field can be either
  993:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  994:    // There are different versions of getNodalValues for each of these cases.
  995: 
