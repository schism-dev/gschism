 1556: __device__ __inline__ double min3(double a, double b, double c) {
 1557:    return min(a, min(b, c));
 1558: }
 1559: 
 1560: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1561:    return min(a, min(b, min(c, d)));
 1562: }
