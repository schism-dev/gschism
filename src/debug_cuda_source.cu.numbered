 4870: 
 4871:    __global__ void backtrackAllNodes(void) {
 4872: 
 4873:       // max/min # of sub-divisions
 4874:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4875:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4876: 
 4877:       SIDE(side);
 4878: 
 4879:       const int kb = side->kb;
 4880: 
 4881: 
 4882:       // Initialize btrack velocities to the actual velocities at the side 
 4883:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4884:   
 4885:       if (side->isDry) return;
 4886:      
 4887: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4888: 
 4889:       // Checks that at least one element is not dry
 4890:       const Element *elem1 = side->elems[0];
 4891:       const Element *elem2 = side->elems[1];
 4892: 
 4893: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4894: 
 4895:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4896:       
 4897:       // XXXXXX
 4898:       // !swild_tmp to store global coord. of the starting side
 4899:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4900:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4901:       // !Use sframe2 
 4902:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4903: 
 4904: 
 4905:       for (int k = kb; k < nvrt; k++) {
 4906:       //  For ics=2, the coordinates are all in the side's local frame
 4907: 
 4908:          const int iadvf = side->iadv();  // Advection flag   
 4909:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4910: 
 4911:          const double vmag2 = norm2(side->u2[k]);
 4912: 
 4913:          if (vmag2 <= velmin_btrack_sq) {  
 4914:             // No activity 
 4915: 
 4916:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4917:             
 4918:          } else {  // do btrack
 4919: 
 4920:             // Compute number of sub-divisions based on local gradients of the velocity field
 4921: 
 4922:             // XXX IS THIS NECESSARY?
 4923:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4924:             double suma = 0.0;
 4925:             int icount = 0;
 4926:             #pragma unroll
 4927:             for (int l=0; l<2; l++) {
 4928:             // For each element sharing the side...
 4929: 
 4930:                const Element *elem = side->elems[l];
 4931:                  
 4932:                if (elem == nullptr) continue;
 4933: 
 4934:                icount++;
 4935: 
 4936:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4937:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4938:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4939: 
 4940:                double utmp[4];
 4941:                double vtmp[4];
 4942:                #pragma unroll
 4943:                for (int j = 0; j < elem->i34; j++) {
 4944: 
 4945:                   const Node *node = elem->nodes[j];
 4946: 
 4947:                   if constexpr(ics==1) {
 4948:                      utmp[j] = node->u2[k].x;
 4949:                      vtmp[j] = node->u2[k].y;  
 4950: 
 4951:                   } else {
 4952:                      // 'Project' the velocity from the node frame to the element frame
 4953:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4954:                      utmp[j] = tmp_u2.x;
 4955:                      vtmp[j] = tmp_u2.y;
 4956: 
 4957:                   }
 4958:                } // for j
 4959: 
 4960:                const Vector2 grad_u = elem->grad2(utmp); 
 4961:                const Vector2 grad_v = elem->grad2(vtmp);
 4962:    
 4963:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4964:             } // for l
 4965: 
 4966:             assert(icount > 0 && "Impossible 77");
 4967: 
 4968:             // '4' is somewhat arbitrary
 4969:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4970: 
 4971:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4972:             Vector3 u_int = {0.0, 0.0, 0.0};
 4973: 
 4974:             side->btrack(k, dt, dtbk, u_int);
 4975: 
 4976: 
 4977:             side->btu[k] = {u_int.x, u_int.y};
 4978:                
 4979:          } // if vmag (do backtrack)
 4980: 
 4981: 
 4982:       } // for k=kb,nvrt-1
 4983: 
 4984:    }
 4985: 
 4986: } // extern "C"
 4987: 
 4988: template<int nc>
 4989: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4990: 
 4991: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4992: //
 4993: // a,b,c,rhs: input vectors and are not modified by this program.
 4994: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4995: // rhs is the r.h.s.
 4996: // n: actual rank of the system.
 4997: // rows in u() and rhs();
 4998: // u: output with nc columns (transposed to rows)
 4999: // gam: a working array.
 5000: //
 5001: // NOTES:
 5002: // This is a template function that allows for different numbers of columns in the rhs vector.
 5003: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 5004: 
 5005:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5006:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5007: 
 5008:    double bet = b[0];
 5009:    if constexpr (nc == 1) {
 5010:       u[0] = rhs[0]/bet;
 5011:    } else {
 5012:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5013:    }
 5014: 
 5015:    for (int j = 1; j < n; j++) {
 5016:       gam[j] = c[j - 1]/bet;
 5017:       bet = b[j] - a[j]*gam[j];
 5018: 
 5019:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5020: 
 5021:       if constexpr (nc == 1) {
 5022:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5023:       } else {
 5024:          for (int l = 0; l < nc; l++) {
 5025:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5026:          }
 5027:       }
 5028:    }
 5029: 
 5030:    // Back-substitution
 5031:    for (int j = n - 2; j >= 0; j--) {
 5032:       if constexpr (nc == 1) {
 5033:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5034:       } else {
 5035:          for (int l = 0; l < nc; l++) {
 5036:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5037:          }
 5038:       }
 5039:    }
 5040: }
 5041: 
 5042: 
 5043: 
 5044: // Helper function that contains the core algorithm
 5045: template<typename XAccessor, typename YAccessor>
 5046: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5047:                                     double  yp_top, double  yp_bot, 
 5048:                                     CubicSpline &spline) {
 5049:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5050:    // 
 5051:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5052:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5053:    //
 5054:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5055:    // 
 5056:    // Inputs: 
 5057:    //            n: dimension for x etc; # of data pts (>=2);
 5058:    //            getX, getY: functions to access x,y coordinates
 5059:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5060:    //     Output: 
 5061:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5062: 
 5063:    const int n = k2 - k1 + 1;
 5064:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5065: 
 5066:    // Allocate memory for the splines
 5067:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5068:    spline.x   = new double[n];
 5069:    spline.y   = new double[n];
 5070:    spline.yp  = new double[n];
 5071:    spline.ypp = new double[n];
 5072: 
 5073:    for (int k=k1; k<=k2; k++) {
 5074:       spline.x[k] = getX(k);
 5075:       spline.y[k] = getY(k);
 5076:    }
 5077: 
 5078:    // This is to simplify expressions later
 5079:    double *x = spline.x;
 5080:    double *y = spline.y;
 5081: 
 5082:    double *a = nullptr;
 5083:    double *b = nullptr;
 5084:    double *c = nullptr;
 5085:    double *gam = nullptr;
 5086:    double *rhs = nullptr;
 5087:    
 5088: 
 5089:       a = new double[n];   // Lower diagonal
 5090:       b = new double[n];   // Diagonal
 5091:       c = new double[n];   // Upper diagonal
 5092:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5093:       rhs = new double[n]; // Right-hand side
 5094: 
 5095:    for (int k=k1; k<=k2; k++) {
 5096:       if (k == k1) {
 5097:          // Bottom level
 5098:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5099:          b[k] = (x[k+1] - x[k])/3.0;
 5100:          c[k] = b[k]/2.0;
 5101:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5102:       } else if (k == n - 1) {
 5103:          // Top level (surface)
 5104:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5105:          b[k] = (x[k] - x[k-1])/3.0;
 5106:          a[k] = b[k]/2.0;
 5107:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5108:       } else {
 5109:          // Intermediate levels
 5110:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5111:          b[k] = (x[k+1] - x[k-1])/3.0;
 5112:          a[k] = (x[k  ] - x[k-1])/6.0;
 5113:          c[k] = (x[k+1] - x[k  ])/6.0;
 5114:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5115:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5116:       }
 5117:    }
 5118: 
 5119:    // Solve the tridiagonal system
 5120:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5121:    
 5122:    spline.yp[k1] = yp_bot;
 5123:    spline.yp[k2] = yp_top;
 5124: 
 5125:    // Compute rest of 1st derivatives using the splines
 5126:    for (int k=k1+1; k<k2; k++) {
 5127:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5128:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5129:    }
 5130:    
 5131:    delete[] a;
 5132:    delete[] b;
 5133:    delete[] c;
 5134:    delete[] gam;
 5135:    delete[] rhs;
 5136: 
 5137: }
 5138: 
 5139: // Array version
 5140: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5141:                                 double y_top, double y_bot, 
 5142:                                 CubicSpline &spline) {
 5143:    auto getX = [x] (int k) { return x[k]; };
 5144:    auto getY = [y] (int k) { return y[k]; };
 5145:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5146: }
 5147: 
 5148: // Lambda version - allows custom access patterns
 5149: template<typename XFunc, typename YFunc>
 5150: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5151:                                 double y_top, double y_bot,
 5152:                                 CubicSpline &spline) {
 5153:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5154: }
