 4345: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4346:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4347:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4348:                 int *isdel, int *isidenode, int *isbnd,
 4349:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4350:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4351:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4352:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4353:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4354:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4355:                 double *drag, double *roughness,
 4356:                 double *emo, double *efa, 
 4357:                 double *umo, double *ufa, 
 4358:                 double *vmo, double *vfa) {
 4359: 
 4360:    printf("Populating mesh for partition %d\n", partNum);
 4361: 
 4362:    // XXXXXX THIS function does almost nothing. 
 4363: 
 4364:    nbs = *sharedIdxSideBoundary + 1;
 4365:    nbp = *sharedIdxNodeBoundary + 1;
 4366: 
 4367:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4368: 
 4369: }
