 1172: // This struct is used to store the boundary information for a node.
 1173: struct NodeBoundary {   
 1174:    int idx;
 1175:    BoundarySegment *segment;
 1176:    Node *node;
 1177:    
 1178:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1179:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1180: 
 1181:    bool isLand;
 1182: 
 1183:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1184:    double elbc;   // Elevation boundary condition
 1185:    double eth;    // Elevation time history
 1186: 
 1187:    double eta_mean; // Mean elevation at nodes
 1188: 
 1189:    bool isEssentialBC;
 1190: 
 1191:    Vector2 uth[nvrt];  // "Time history" velocity
 1192: 
 1193:    // Arrays for harmonic constituents (if needed)
 1194:    double  emo[nbfr];  // Elevation amplitude
 1195:    double  efa[nbfr];  // Elevation phase
 1196:    Vector2 umo[nbfr];  // velocity amplitude
 1197:    Vector2 ufa[nbfr];  // velocity phase
 1198: 
 1199: 
 1200:    NodeBoundary(void) {
 1201:       isLand = false;
 1202:    }
 1203:    NodeBoundary(bool _isLand) {
 1204:       isLand = _isLand;
 1205:    }
 1206: 
 1207:    
 1208:    __forceinline__ __device__ int numSidesForAverage() const {
 1209:    // Returns the number of sides that are connected to the node and have the same segment.
 1210:    // This is used to compute the average velocity at the node for open boundary nodes.
 1211:       int res = 0;
 1212:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1213:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1214: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1215:       return res;
 1216:    }
 1217: 
 1218: 
 1219:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1220:       assert(index == 0 || index == 1); 
 1221:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1222:    }
 1223: 
 1224: 
 1225: };
