 2579:    template<typename T>
 2580:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2581:       T values[4];
 2582:       getNodalValues(field, values);
 2583: 
 2584:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2585:       if constexpr (IsVector2<T>::value && ics == 2) {
 2586: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2587:          projectNodeVectorsToElementFrame(values);
 2588: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2589:       }
 2590: 
 2591:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2592:    }
