 8086: __global__ void printMatrix(bool full) {
 8087:    // Debugging: print the matrix
 8088: 
 8089:    const int size = mesh->np;
 8090:    double sum = 0.0;
 8091:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8092:       const Node *node = mesh->localNodeData + idx_node;
 8093:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8094:       for (int j = 0; j < node->numNodes; j++) {
 8095:          Node* nbNode = node->nodes[j];
 8096:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8097:          sum += node->coeffMatrix[j];
 8098:       }
 8099:       if (full) printf("]\n");
 8100: 
 8101: 
 8102:    }
 8103:    if (!full) printf("sum=%lf\n", sum);
 8104: }
