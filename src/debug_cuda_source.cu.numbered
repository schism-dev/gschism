 8311: 
 8312: __global__ void returnMatrix(double *res) {
 8313:    // Debugging: dense local matrix, row-major, size = mesh->np
 8314:    // Assumes single-partition / local indexing (see note below).
 8315: 
 8316:    const int size = mesh->np;
 8317: 
 8318:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8319:       const Node *node = mesh->localNodeData + idx_node;
 8320: 
 8321:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 8322: 
 8323:       for (int j = 0; j < node->numNodes; j++) {
 8324:          const Node *nbNode = node->nodes[j];
 8325:          // Only dump neighbors that live on this partition
 8326:          if (nbNode->part != mesh->partNum) continue;
 8327: 
 8328:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 8329:          const double aij = node->coeffRow[node->csrSlot[j]];
 8330:          if (aij != 0.0)
 8331:             res[jlocal * size + idx_node] = aij;
 8332:       }
 8333:    }
 8334: }
 8335: 
 8336: 
 8337: __global__ void returnX(double *res) {
 8338:    // Debugging: returns the matrix as a CuPy array
 8339: 
 8340:    const int size = mesh->np;
 8341:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8342:       const Node *node = mesh->localNodeData + idx_node;
 8343: 
 8344:       res[idx_node] = node->mX;
 8345: 
 8346:    }
 8347:    
 8348: }
