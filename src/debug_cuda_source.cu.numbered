 4229: extern "C" {
 4230: 
 4231:    __global__ void scaleGravity(double loadtide_coef) {
 4232: 
 4233: 
 4234:       NODE(node);
 4235: 
 4236:       // SAL option: scale gravity
 4237:       if constexpr(iloadtide==2) {  // simple const
 4238:          node->grav2 = grav*(1.0 - loadtide_coef);
 4239: 
 4240:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4241:         
 4242:           const double depth = max(node->depth, 0.0);
 4243:           const double tmp1 = sqrt(depth);
 4244:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4245:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4246:                              2.6969e-13*depth*depth*depth*tmp1;
 4247:           
 4248:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4249:           
 4250: 
 4251: 
 4252:           node->grav2 = grav*(1.0 - beta_bar);
 4253: 
 4254:       } else {  // iloadtide=0,1
 4255:           node->grav2 = grav;
 4256: 
 4257:       }
 4258: 
 4259:    }
 4260: 
 4261: 
 4262:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4263:       NODE(node);
 4264: 
 4265:       const int idx = node->idx;
 4266:       Vector2 wind = {xWind[idx], yWind[idx]};
 4267: 
 4268:       if constexpr(nws != 0 && iwindoff != 0) {
 4269:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4270:       }
 4271: 
 4272:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4273:       node->setWind(wind);
 4274: 
 4275:       node->pr = pressAir[idx];
 4276:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4277: 
 4278:    }
