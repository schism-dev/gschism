 1579: // Helper functions for computing the local node index at a given offset from another.
 1580: __device__ __inline__ int nxq(int offset, int index, int size) {
 1581:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1582:    // to the index to make it positive
 1583:    assert(index + offset + 16*size >= 0);
 1584:    return (index + offset + 16*size) % size;  
 1585: }
 1586: 
 1587: __device__ __inline__ int nxq(int index, int size) {
 1588:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1589:    // to the index to make it positive
 1590:    assert(index + 16*size >= 0);
 1591:    return (index + 16*size) % size; 
 1592: }
