 1581: // Helper functions for computing the local node index at a given offset from another.
 1582: __device__ __inline__ int nxq(int offset, int index, int size) {
 1583:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1584:    // to the index to make it positive
 1585:    assert(index + offset + 16*size >= 0);
 1586:    return (index + offset + 16*size) % size;  
 1587: }
 1588: 
 1589: __device__ __inline__ int nxq(int index, int size) {
 1590:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1591:    // to the index to make it positive
 1592:    assert(index + 16*size >= 0);
 1593:    return (index + 16*size) % size; 
 1594: }
