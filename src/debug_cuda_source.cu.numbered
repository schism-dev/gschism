 7446: #ifdef DONTCOMPILE
 7447: __global__ void checkMassConservation(Tracers* sumtr) {
 7448: 
 7449:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7450: 
 7451:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7452: 
 7453:    Element *elem = &(mesh->localElemData[i]);
 7454: 
 7455:    // Skip dry elements
 7456:    if (elem->isDry) return;
 7457: 
 7458:    // Local sum array for this thread
 7459:    double localSum[N_TRACERS] = {0.0};
 7460: 
 7461:    // Sum over vertical levels for this element
 7462:    const int kbe = elem->kbe;
 7463:    const double area = elem->area;
 7464: 
 7465:    for (int k = kbe; k < nvrt; k++) {
 7466:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7467:       
 7468:       // Accumulate tracer mass
 7469:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7470:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7471:       }
 7472:    }
 7473: 
 7474:    
 7475: 
 7476:    //  This function returns per element sums. A reduction must be done on the host side.
 7477: }
 7478: 
 7479: 
 7480: __global__ void transport(void) {
 7481: 
 7482:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7483: 
 7484:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7485: 
 7486:    Element *elem = &(mesh->localElemData[ie]);
 7487: 
 7488:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7489: 
 7490:                for (int m=0; m<ntr; m++) {
 7491:                   for (int k=kbe(ie); k<nvrt; k++) {
 7492:                      // Calculate each polynomial's weight 
 7493:                      wm=0.d0; sum1=0.d0; 
 7494:                      wm1=0.d0; wm2=0.d0; 
 7495:                      for (int i=0; i<elem->nweno2; i++) {
 7496:                   
 7497:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7498:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7499:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7500:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7501:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7502:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7503:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7504:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7505:                      // -----------------Hu and Shu (1999)'s method----------------
 7506:                      b4=b1+b2+b3
 7507: 
 7508: //Error: add PRODUCTION CPP
 7509: #ifdef DEBUG
 7510:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7511:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7512:                     call parallel_abort(errmsg)
 7513:                   }
 7514: #endif
 7515: 
 7516:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7517:                   // !----test-------------- 
 7518:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7519:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7520:                   // !wm(i)=wm1(i)*wm2(i)
 7521:                   // !---------------------- 
 7522:                   sum1=sum1+wm(i)
 7523:                 } // end for i
 7524: 
 7525:                 wm=wm/sum1
 7526: 
 7527:                 for (int j=0; j<elem->i34; j++) {
 7528: 
 7529:                   const Side *side  = elem->sides[j];
 7530:                   const Node *node1 = side->n1;
 7531:                   const Node *node2 = side->n2;
 7532: 
 7533:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7534:                      trsd=0.d0
 7535:                      for (int kk=0; kk<nquad; kk++) {
 7536:                         for (int i=0; i<elem->nweno2; i++) {
 7537:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7538:                         } // end for i   
 7539:                      } // end for kk
 7540:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7541:                   } // outward flux
 7542:                } // end for j=1,i34(ie) ! side
 7543:             }
 7544:          }
 7545:               
 7546: 
 7547: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7548: //             //   calculate each polynomial's weight 
 7549: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7550: //                 wm=0.d0; sum1=0.d0
 7551: //                 do i=1,nweno1(ie) !for each polynomial
 7552: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7553: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7554: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7555: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7556: //                   wm(i)=b2
 7557: //                   sum1=sum1+b2
 7558: //                   !wm(i)=1.d0
 7559: //                   !sum1=sum1+1.d0
 7560: 
 7561: // // Error: PRODUCTION
 7562: // #ifdef DEBUG
 7563: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7564: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7565: //                     call parallel_abort(errmsg)
 7566: //                   endif
 7567: // #endif
 7568: 
 7569: //                 enddo !i
 7570: //                 wm=wm/sum1 !final weight
 7571: 
 7572:                 for (int j=0; j<elem->i34; j++) { // side
 7573:                   const Side *side = elem->sides[j];
 7574:                   const Node *node1 = side->n1;
 7575:                   const Node *node2 = side->n2;
 7576: 
 7577:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7578:                     trsd=0.d0
 7579:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7580:                       for (int i=0; i<elem->nweno1; i++) {
 7581:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7582:                       }
 7583:                     enddo //kk
 7584:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7585:                   } // outward flux
 7586:                 } // end for j=1,i34(ie) ! side
 7587:               } // end for k; ntr 
 7588: 
 7589:             else !simple upwind method
 7590:               do j=1,i34(ie)
 7591:                 jsj=elside(j,ie)
 7592:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7593:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7594:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7595:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7596:                   endif
 7597:                 enddo  !vertical layers
 7598:               enddo !j=1,i34(ie) ! side
 7599:             endif !order of accuracy
 7600: 
 7601:          //  enddo !ie
 7602: // !$OMP     end do
