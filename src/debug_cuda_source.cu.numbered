 1741: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1742:    // Computes the 3D normal vector to the element at level k
 1743:    // Returns the normal vector and the area of the element
 1744: 
 1745:       if (isTri()) {
 1746:          // For triangles...
 1747: 
 1748:          // Gets the normal vector to the element (with a length equal to twice the area)
 1749:          if constexpr(ics==1) {
 1750:             const int kb0 = max(k, nodes[0]->kb);
 1751:             const int kb1 = max(k, nodes[1]->kb);
 1752:             const int kb2 = max(k, nodes[2]->kb);
 1753: 
 1754:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1755:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1756:             
 1757:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1758:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1759:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1760:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1761: 
 1762:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1763:             area3D = 0.5*len;
 1764: 
 1765:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1766: 
 1767:             return {nx/len, ny/len, nz/len};
 1768: 
 1769:            
 1770:          }
 1771:          else {  // lat/lon
 1772:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1773: 
 1774:          } // if ics
 1775:       }
 1776:       else {
 1777:          // For quads...
 1778: 
 1779:          assert(false && "Element normal vector: quads not yet implemented");
 1780: 
 1781: 
 1782:       }
 1783:    }
 1784: 
 1785: /**
 1786:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1787:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1788:    If the segment is completely inside the element, then it returns true.
 1789: 
 1790:    This function assumes:
 1791:    - The initial point is on a side of the element. 
 1792:    - Its position is given by parameter t in the range [0,1].
 1793:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1794:       intersects the element (elements are convex).
 1795: 
 1796:    To find the intersection point, this function does the following:
 1797:    - it finds the intersection of the line segment with all the element side lines,
 1798:       except for the one that contains the initial point.
 1799:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1800:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1801:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1802:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1803:       track segment is almost parallel to the element side line.
 1804: 
 1805:    Inputs:
 1806:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1807:    @param x2, y2: other end of the line segment
 1808: 
 1809:    Outputs:
 1810:    @param side:  side that intersects the line segment (input and output)
 1811:    @param nextElement (output): element that contains the intersection point
 1812:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1813:    @param zint (input/output): Vertical coordinate of the intersection point
 1814: 
 1815:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1816:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1817:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1818: 
 1819:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1820:    (Delta) being zero.
 1821: 
 1822:    The intersection2 point happens when:
 1823:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1824:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1825:    
 1826:    Assumption: the 4 points (including those of the side segment) are different.
 1827:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1828:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1829:    If true, (xIntersect,yIntersect) is the intersection.				
 1830:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1831: **/
 1832: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1833:                                               double &t, double& tIntersect) {
 1834: 
 1835:    double closest_intersect_t = 1e10;
 1836:    bool found_intersection = false;
 1837: 
 1838:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1839:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1840:    const Point2 x1 = side->point(t);
 1841:    
 1842: 
 1843:    Side *nextSide = nullptr;
 1844:    for (int i = 0; i < i34; i++) {
 1845: 
 1846:       // Element's i-th side 
 1847:       Side *side2 = sides[i];
 1848: 
 1849:       // Skip the side that contains the initial point
 1850:       if (side2 == side) continue;
 1851: 
 1852:       // (x3,y3)-(x4,y4) is the element side line
 1853:       const Point2 x3 = side2->n1->p2();
 1854:       const Point2 x4 = side2->n2->p2();
 1855: 
 1856:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1857:       const double delta = cross(x2 - x1, x3 - x4);
 1858: 
 1859:       if (delta != 0.0) {
 1860: 
 1861:          const double delta1 = cross(x3 - x1, x3 - x4);
 1862:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1863: 
 1864:          // Solves the two linear equations for tt1 and tt2
 1865:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1866:          const double tt2 = delta2/delta;
 1867: 
 1868:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1869:             closest_intersect_t = min(closest_intersect_t, tt1);
 1870:             nextSide = side2;
 1871: 
 1872:             nextElement = nextSide->otherElem(this);
 1873:             tIntersect = max(small, min(tt1, 1.0-small));
 1874:             t = tt2;
 1875: 
 1876:             found_intersection = true;
 1877:          }
 1878:       
 1879:       }
 1880: 
 1881:    }
 1882: 
 1883:    // found_intersection should always be true, since we checked all the sides.  
 1884:    side = nextSide;
 1885: 
 1886:    return found_intersection;
 1887: }
 1888: 
 1889: 
 1890: 
 1891: 
 1892: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1893:                                               double &t, double& tIntersect) {
 1894: 
 1895:    double closest_intersect_t = 1e10;
 1896:    bool found_intersection = false;
 1897: 
 1898:    for (int i = 0; i < i34; i++) {
 1899: 
 1900:       Side *side2 = sides[i];
 1901: 
 1902:       // (x3,y3)-(x4,y4) is the element side line
 1903:       const Point2 x3 = side2->n1->p2();
 1904:       const Point2 x4 = side2->n2->p2();
 1905: 
 1906:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1907:       const double delta = cross(x2 - x1, x3 - x4);
 1908: 
 1909:       if (abs(delta) > 0) {
 1910: 
 1911:          const double delta1 = cross(x3 - x1, x3 - x4);
 1912:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1913: 
 1914:          // Solves the two linear equations for tt1 and tt2
 1915:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1916:          const double tt2 = delta2/delta;
 1917: 
 1918:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1919:             closest_intersect_t = min(closest_intersect_t, tt1);
 1920:             side = side2;
 1921:             nextElement = side->otherElem(this);
 1922:             t = tt2;
 1923:             tIntersect = max(small, min(tt1, 1.0-small));
 1924:             found_intersection = true;
 1925:          }
 1926:       
 1927:       }
 1928:       else {  // parallel segments
 1929:          assert(false && "Parallel segments");
 1930:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1931:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1932: 
 1933:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1934: 
 1935:          // const double dist = dot(x1 - x3, side2->n);
 1936:          // if (abs(dist) < small*length(x3 - x4)) {
 1937:          //    const double2 unitarySide = normalize(x4 - x3);
 1938:          //    const double len = dot(x2 - x1, unitarySide);
 1939:          //    t = t + len;
 1940:          //    t = max(0.0, min(t, 1.0));
 1941:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1942: 
 1943: 
 1944:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1945:          //    // t = tt2;
 1946:          //    found_intersection = true;
 1947:          // }
 1948:       }
 1949: 
 1950: 
 1951:    }
 1952: 
 1953:       
 1954:    assert(found_intersection && "No intersection found");
 1955: 
 1956:    // found_intersection should always be true, since we checked all the sides.  
 1957:    return found_intersection;
 1958: }
 1959: 
 1960: 
 1961: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1962:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1963: 
 1964:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1965: 
 1966:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1967:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1968:    // curElement.
 1969: 
 1970:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1971:    // And uses this velocity instead to continue the tracking.
 1972: 
 1973:    // computes the intersection point in cartesian coordinates
 1974:    Point2 intersection = nextSide->p_t(tt);
 1975: 
 1976:    // Nudges the point to the barycenter of the element. 
 1977:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1978:    // next segment intersects the element sides.  
 1979:    curElem->nudgeToBarycenter(intersection);
 1980: 
 1981:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1982:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1983:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1984:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1985: 
 1986:    // If the side is an open boundary, the tangential velocity is zero.
 1987:    if (nextSide->isBnd()) vtan = 0.0;
 1988: 
 1989:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1990:    const double us = vtan*nextSide->t().x;
 1991:    const double vs = vtan*nextSide->t().y;
 1992:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 1993: 
 1994:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1995:    const double len2 = norm2(intersection - toPoint2(xt));
 1996:    const double vel2 = dot(u_int, u_int);        
 1997:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1998:    else            dt = 0.0;
 1999: 
 2000:    // The end of this tracking segment is now the intersection point.
 2001:    xt = {intersection.x, intersection.y, zint};
 2002: 
 2003:    u_int = {us, vs, ws};
 2004:    
 2005: }
 2006: 
 2007: /**
 2008:  * Tracks a particle through elements and vertical levels in the mesh.
 2009:  * 
 2010:  * @param x0,y0,z0     Starting position coordinates
 2011:  * @param xt,yt,zt     Target position coordinates
 2012:  * @param dtb          Time step for tracking
 2013:  * @param uuint,vvint,wwint Initial velocity components
 2014:  * @param nextElem     Starting/resulting element index
 2015:  * 
 2016:  * @return Status code of type trackExitCodes
 2017:  * 
 2018:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2019:  * of the details are different. The idea is that the code requires less branches and is better fit
 2020:  * for GPU execution.
 2021:  * 
 2022:  * The main ideas here are:
 2023:  * - The starting point is expected to be in the starting element.
 2024:  * - The end point is guaranteed to be inside an element.
 2025:  * - since the starting point is inside the element, there are only two cases: 
 2026:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2027:  *     (b) it does not and (xt,yt) is already in the starting element.
 2028:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2029:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2030:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2031:  * - tt1 can be positive or negative. We only consider the positive values.
 2032:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2033:  * - The next intersection will occur at the smallest positive tt1.
 2034:  * - This intersection will be the next (x0,y0) position.
 2035:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2036:  *   of getting stuck in a loop.
 2037:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2038:  *   was found.
 2039:  */
 2040: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2041:                                                        Element *&nextElem, int &jlev, double &dt,
 2042:                                                        const Side *origSide) {
 2043: 
 2044: 
 2045: 
 2046:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2047:    // else to do.
 2048:    // If it is, nudges the point to be inside the element.
 2049:    const Element *curElem = nextElem;
 2050:    if (containsPoint(toPoint2(xt), true)) {
 2051: 
 2052:       curElem->interpolateVelocities(xt, u_int);
 2053: 
 2054: addDebugPlot(x0, xt);
 2055:       return true;
 2056:    }
 2057: 
 2058:    Side *side = nullptr;
 2059: 
 2060:    // 1. Initial checks
 2061:    // Verify starting element is valid (wet)
 2062:    assert(!curElem->isDry && "Starting element is dry");
 2063: 
 2064:    // Checks if track has a zero length.
 2065:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2066:    // assert(len2 > 0.0 && "Zero length track"); 
 2067:    
 2068:    const int MAX_ITERATIONS = 1000;
 2069:    
 2070:    double t;
 2071:    Side *nextSide = nullptr;
 2072:    double tIntersect = 1e10;
 2073:    double zint = x0.z;
 2074: 
 2075:    // Horizontal tracking loop
 2076:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2077:    // (x0,y0) is inside the element but the target point is not.
 2078: 
 2079:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2080: 
 2081:    assert(found_intersection && "No intersection found at %d");
 2082: 
 2083:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2084: 
 2085:    // if the tracking segment goes out of water (either dry or edge boundary)
 2086:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2087: 
 2088: addDebugPlot(x0, xt, 0x00A0FF);
 2089:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2090: addDebugPlot(x0, xt, 0x00A0FF);      
 2091: 
 2092:       nextElem = this;
 2093:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2094:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2095:       return true;    
 2096:    }
 2097: 
 2098: 
 2099:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2100:    int iterations = 0;
 2101:    while (iterations < MAX_ITERATIONS) {
 2102:       iterations++;
 2103:       
 2104:       Element *curElem = nextElem;
 2105: 
 2106:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2107: addDebugPlot(x0, xt);
 2108:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2109: 
 2110:       // If we are already in the target element, we are done.
 2111:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2112:       if (!found_intersection) break;
 2113: 
 2114: 
 2115: 
 2116:       // if the tracking segment goes out of water (either dry or edge boundary).
 2117:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2118: addDebugPlot(x0, xt, 0x00A0FF);
 2119:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2120: addDebugPlot(x0, xt, 0x00A0FF);   
 2121:          nextElem = curElem;
 2122: 
 2123:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2124:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2125:          return true;
 2126:       }
 2127:       
 2128:       // Update position and element for next iteration
 2129:       side = nextSide;
 2130: 
 2131:    }
 2132: 
 2133:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2134: 
 2135:  
 2136:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2137:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2138: addDebugPlot(x0, xt);   
 2139:    nextElem->interpolateVelocities(xt, u_int); 
 2140: 
 2141:    return true;
 2142: }
 2143: 
 2144: 
 2145: __inline__ __device__ double Element::computeSignedArea(void) const {
 2146:    // Compute the area of the element
 2147: 
 2148:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2149: 
 2150:    // In the quad case we need to add the area of the other triangle.
 2151:    if (isQuad()) {
 2152:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2153:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2154:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2155:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2156: 
 2157:       res += ar1;
 2158:    }
 2159: 
 2160:    return res;
 2161: }
 2162: 
 2163: 
 2164: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2165:                                                                 (nodes[1]->isDry2()) ||
 2166:                                                                 (nodes[2]->isDry2()) ||
 2167:                                                                 (i34==4 && nodes[3]->isDry2());
 2168: }
 2169: 
 2170: __inline__ __device__ double Element::detJ_eta(void) const {
 2171:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2172:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2173: }
 2174: 
 2175: __inline__ __device__ double Element::detJ_xi(void) const {
 2176:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2177:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2178: }
 2179: 
 2180: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2181:    // In boundary sides, the element 1 is nullptr
 2182:    return side->elems[1] == nullptr; 
 2183: }
 2184: 
 2185: 
 2186: 
 2187: /**
 2188:    Compute the shape coordinates of the point (xt,yt) in the element.
 2189:    @param xt (input): x-coordinate of the point
 2190:    @param shpCoords (output): shape coordinates of the point
 2191:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2192:    @return true if the point is inside the element, false otherwise
 2193: **/
 2194: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2195:                                             bool fixNegshpCoord) const {
 2196: 
 2197:    // Compute the shape coordinates of the point xt in the element.
 2198:    if (i34==3) {
 2199:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2200:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2201:       // and in this case, the pt will be nudged into the element
 2202:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2203:       // from the local frame, so use additional check.
 2204: 
 2205:       Point2 x0, x1, x2;
 2206: 
 2207:       if constexpr(ics==1) {
 2208:          x0 = nodes[0]->p2();
 2209:          x1 = nodes[1]->p2();
 2210:          x2 = nodes[2]->p2();
 2211:       }
 2212:       else // lat/lon
 2213:       {
 2214:          Error("Not implemented yet");
 2215: #ifdef ICS2
 2216:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2217:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2218:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2219: #endif
 2220:       }
 2221: 
 2222:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2223:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2224:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2225:       shpCoords[3] = 0.0;
 2226:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2227: 
 2228:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2229:       // then we fix the negative shape coordinates.
 2230:       if (fixNegshpCoord && tmpmin<=0.0) {
 2231: 
 2232:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2233:          // keeping the sum of the shape coordinates equal to 1.
 2234:          // I have tested and compared the new algorithm with the old one, and they give
 2235:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2236:          // The new algorithm should be faster since it is branchless.
 2237:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2238:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2239:          
 2240:          shpCoords[0] = (shpCoords[0] + a)*b;
 2241:          shpCoords[1] = (shpCoords[1] + a)*b;
 2242:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2243: 
 2244:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2245:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2246:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2247:          }
 2248: 
 2249:          // Update the point coordinates for the new shape coordinates
 2250:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2251:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2252:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2253: 
 2254:       }
 2255: 
 2256:       // Check if the point is inside the element
 2257:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2258:    }
 2259:    else {
 2260:       Error("Not implemented yet");
 2261: #ifdef QUADS
 2262:       // Reproject pt in eframe of nel for ics=2
 2263:       if constexpr(ics==1) {
 2264:          xn2 = xt; 
 2265:          yn2 = yt;
 2266:       }
 2267:       else {
 2268:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2269:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2270:       }
 2271: 
 2272:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2273: #endif
 2274:    }
 2275: 
 2276:    return false;  // Never reached
 2277: 
 2278: }
 2279: 
 2280: 
 2281: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2282: // Convert shape coordinates to cartesian coordinates
 2283: 
 2284:    if (i34 == 3) {
 2285:       // Triangular element
 2286:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2287:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2288:    }
 2289:    else {
 2290:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2291:    }
 2292: 
 2293: }
 2294: 
 2295: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2296:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2297:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2298:    // The formula for the integral is:
 2299:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2300: 
 2301:    printf("intPhiPhi: TEST\n");
 2302: 
 2303:    const Node *n0 = nodes[0];
 2304:    const Node *n1 = nodes[1];
 2305:    const Node *n2 = nodes[2];
 2306:    const Node *n3 = nodes[3];
 2307: 
 2308:    const Vector2 p0 = n0->p2();
 2309:    const Vector2 p1 = n1->p2();
 2310:    const Vector2 p2 = n2->p2();
 2311:    const Vector2 p3 = n3->p2();
 2312: 
 2313:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2314:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2315:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2316:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2317: 
 2318:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2319: }
 2320:    
 2321: 
 2322: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2323:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2324:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2325:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2326:    // The formula is also based on the identity:
 2327:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2328:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2329: 
 2330:    printf("intGradPhiGradPhi: TEST\n");   
 2331: 
 2332:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2333: 
 2334:    const double x0 = nodes[0]->p.x;
 2335:    const double y0 = nodes[0]->p.y;
 2336:    const double x1 = nodes[1]->p.x;
 2337:    const double y1 = nodes[1]->p.y;
 2338:    const double x2 = nodes[2]->p.x;
 2339:    const double y2 = nodes[2]->p.y;
 2340:    const double x3 = nodes[3]->p.x;
 2341:    const double y3 = nodes[3]->p.y;
 2342: 
 2343:    double res = 0.0;
 2344:    
 2345:    // Quadrature points in xi and eta coordinates
 2346:    #pragma unroll
 2347:    for (int i = 0; i < 4; i++) {
 2348:       // For each quadrature point...
 2349: 
 2350:       const Point2 p = GaussPoint(i);
 2351:       const double eta = p.x;
 2352:       const double xi  = p.y;
 2353: 
 2354:       // Jacobian entries at the Gauss point p
 2355:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2356:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2357:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2358:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2359: 
 2360:       const double detJ = jacobianDet(p);
 2361:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2362: 
 2363:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2364:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2365:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2366:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2367:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2368: 
 2369:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2370:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2371:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2372:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2373:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2374: 
 2375:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2376:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2377:    }
 2378: 
 2379:    return res;
 2380: }
 2381: 
 2382: 
 2383: /**  Interpolate velocities at a given point (xt,yt,zt)
 2384: 
 2385:    @param xt, yt, zt: coordinates of the point to interpolate
 2386:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2387: 
 2388:    This is done in four steps:
 2389: 
 2390:    1. Find the shape coordinates for the final position in the element.
 2391:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2392:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2393:       z levels at xt, yt at each step.   
 2394:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2395:       horizontally and vertically.
 2396: **/
 2397: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2398:    // Interpolate the velocities at the point xt. 
 2399:    // This function works the same for triangular and quadrilateral elements.
 2400:    double shpCoord[4];
 2401: 
 2402:    // First step is to compute the shape coordinates of (xt,yt)
 2403:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2404:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2405: 
 2406:    // Second step is to find the level that contains zt
 2407:    // Uses a binary search to find the level
 2408:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2409:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2410:    int R = nvrt - 1;
 2411: 
 2412:    // Get the z coordinates at the nodes of the element at the levels L and R
 2413:    double zLAtNodes[4], zRAtNodes[4];
 2414:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2415:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2416: 
 2417:    double zL = interpolate(shpCoord, zLAtNodes);
 2418:    double zR = interpolate(shpCoord, zRAtNodes);
 2419:    
 2420:    // Interpolates vertically the velocities
 2421:    double wght1, wght2;
 2422:    if (xt.z<=zL) {
 2423:       wght1 = 1.0;
 2424:       wght2 = 0.0;
 2425:    }
 2426:    else if (xt.z>=zR) {
 2427:       wght1 = 0.0;
 2428:       wght2 = 1.0;
 2429:    }
 2430:    else {
 2431:       // Perform a binary search to find the levels between L and R that contain xt.z
 2432:       while (R - L > 1) {
 2433:          int M = (L + R) / 2;
 2434: 
 2435:          double zMAtNodes[4];
 2436:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2437:          double zM = interpolate(shpCoord, zMAtNodes);
 2438:          if (zM < xt.z) 
 2439:          {
 2440:             L = M;
 2441:             zL = zM;
 2442:          }
 2443:          else 
 2444:          {
 2445:             R = M;
 2446:             zR = zM;
 2447:          }
 2448:       }
 2449:       assert(L == R-1);
 2450:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2451: 
 2452:       wght2 = (xt.z - zL)/(zR - zL);
 2453:       wght1 = 1.0 - wght2;
 2454:    }
 2455: 
 2456:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2457:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2458: 
 2459:    // Neither of the interpolated velocities should be NaN
 2460:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2461: 
 2462: }
 2463: 
 2464: 
 2465: 
 2466: 
 2467: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2468: 
 2469:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2470:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2471:    const Node *n1 = side->n1;
 2472:    const Node *n2 = side->n2;
 2473: 
 2474:    bool n1_match = (n1->nodeBnd->segment == segment);
 2475:    bool n2_match = (n2->nodeBnd->segment == segment);
 2476: 
 2477:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2478:    if (n1_match && n2_match) {
 2479:       return 0.5;
 2480:    } else if (n1_match) {
 2481:       return 1.0;
 2482:    } else if (n2_match) {
 2483:       return 0.0;
 2484:    }
 2485:    return 0.0;
 2486: }
