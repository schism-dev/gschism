 8029: 
 8030: __global__ void computeMatrixProductAndDotProducts() {
 8031:    // Computes A*p, r'Mr and p'Ap
 8032: 
 8033:    // 1) shared buffer: first half for rMr, second for pAp
 8034:    __shared__ double sdata[2*BLOCK_SIZE];
 8035:    double* s_rMr = sdata;
 8036:    double* s_pAp = sdata + BLOCK_SIZE;
 8037: 
 8038:    const int tid = threadIdx.x;
 8039: 
 8040:    double l_pAp = 0.0;
 8041: 
 8042:    s_rMr[tid] = 0.0;
 8043:    s_pAp[tid] = 0.0;
 8044: 
 8045:    // 2) get your node pointer
 8046:    // NODE(node);   
 8047:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8048:    Node *node = &(mesh->localNodeData[idx_node]); 
 8049:    if (idx_node < mesh->np) {
 8050: 
 8051: 
 8052:    const double diag = node->coeffDiag;
 8053:    const double r    = node->mR;
 8054:    const double p    = node->mP;  
 8055: 
 8056:    // apply preconditioner on the fly:
 8057:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8058: 
 8059:    // 4) compute Ap = A.p
 8060:    double Ap = node->coeffDiag * node->mP;
 8061:    for (int j = 0; j < node->numNodes; ++j) {
 8062:       const Node *nbNode = node->nodes[j];
 8063:       Ap += node->coeffMatrix[j] * nbNode->mP;
 8064: 
 8065:    }
 8066: 
 8067:    node->mAp = Ap;
 8068:     
 8069: 
 8070:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 8071:    // const double l_rMr = r*Mr;  // r'Mr
 8072:    l_pAp = p*Ap;  // p'Ap
 8073: 
 8074: 
 8075:    }
 8076: 
 8077:    // 6) write into shared mem
 8078:    // s_rMr[tid] = l_rMr;
 8079:    s_pAp[tid] = l_pAp;
 8080: 
 8081:    __syncthreads();
 8082: 
 8083:    // 7) block-wide tree reduction
 8084:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8085:       if (tid < stride)  {
 8086:          s_pAp[tid] += s_pAp[tid + stride];
 8087:       }
 8088:       __syncthreads();
 8089:    }
 8090: 
 8091:    // 8) thread 0 atomically accumulates into the globals
 8092:    // XXX: This is slower than it needs to be, but it is simple and works
 8093:    if (tid == 0) {
 8094:       atomicAdd(pAp, s_pAp[0]);
 8095:    }
 8096: 
 8097: 
 8098: }
 8099: 
 8100: 
 8101: __global__ void updateSolutionAndDotProducts(void) {
 8102:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8103: 
 8104:    const int tid = threadIdx.x;
 8105: 
 8106:    s_rMr[tid] = 0.0;
 8107: 
 8108:    // get node & bounds-check:
 8109:    NODE(node);
 8110: 
 8111:    
 8112:    // Compute alpha
 8113:    const double alpha = (*rMr_old)/(*pAp);
 8114: 
 8115:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8116: 
 8117: 
 8118:    // load scalars
 8119:    const double diag = node->coeffDiag;
 8120:    const double p    = node->mP;
 8121:    const double Ap   = node->mAp;
 8122:    const double x    = node->mX;
 8123:    const double r    = node->mR;
 8124:    
 8125:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8126: 
 8127:    // 1) update solution & residual
 8128:    const double x_new = x + alpha*p;
 8129:    const double r_new = r - alpha*Ap;
 8130:    node->mX = x_new;
 8131:    node->mR = r_new;
 8132: 
 8133:    // 2) apply Jacobi preconditioner on the fly
 8134:    const double Mr_new = r_new/diag;
 8135: 
 8136: 
 8137:    // 3) local contributions for the two dot-products
 8138:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8139: 
 8140:    // 4) write into shared-mem
 8141:    s_rMr[tid] = l_rMr;
 8142: 
 8143:    __syncthreads();
 8144: 
 8145: 
 8146:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8147:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8148:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8149:       __syncthreads();
 8150:    }
 8151: 
 8152:    // 6) thread 0 atomically folds into the global accumulators
 8153:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8154: 
 8155: 
 8156: }
 8157: 
 8158: 
 8159: __global__ void updateSearchDirection() {
 8160: 
 8161:     NODE(node);
 8162: 
 8163:     // recompute z on-the-fly
 8164:     const double z = node->mR / node->coeffDiag;
 8165:     const double p = node->mP;
 8166: 
 8167:     const double beta = (*rMr_new)/(*rMr_old);
 8168: 
 8169: 
 8170:     // p =z + beta*p
 8171:     node->mP = z + beta*p;
 8172: 
 8173: }
 8174: 
 8175: __global__ void initializeScalars(double *scalars) {
 8176: 
 8177:    // These point to a cupy array in the host code
 8178:    rMr_old = scalars + 0;
 8179:    rMr_new = scalars + 1;
 8180:    pAp     = scalars + 2;
 8181: }
 8182: 
 8183: __global__ void initializePreconditionedResidual(void) {
 8184: 
 8185:     __shared__ double s_rMr[BLOCK_SIZE];  
 8186: 
 8187:     s_rMr[threadIdx.x] = 0.0;
 8188: 
 8189:     NODE_ALL(node, valid);
 8190:     const int tid = threadIdx.x;
 8191:     // For the first iteration:
 8192:     // 1. Initial solution x = 0 (already set)
 8193:     // 2. Initial residual r = b (stored in qel)
 8194:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8195: 
 8196: // XXX we should use the guess solution here    
 8197: 
 8198:     double l_rMr = 0.0;
 8199:     if (valid) {
 8200:       // Set initial residual r = b (from qel)
 8201:       node->mR = node->qel;
 8202: 
 8203:       // Compute z = M^-1 * r (preconditioned residual)
 8204:       const double z = node->mR / node->coeffDiag;
 8205: 
 8206:       // Set initial search direction p = z
 8207:       node->mP = z;
 8208: 
 8209:       // Initialize other variables needed for CG
 8210:       node->mX = 0.0;  // Initial solution
 8211:       node->mAp = 0.0; // Will be computed in first iteration
 8212: 
 8213: 
 8214:       // Computes the first r'Mr (reduction)
 8215:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8216:     }
 8217:     // 4) write into shared-mem
 8218:     s_rMr[tid] = l_rMr;
 8219: 
 8220:     __syncthreads();
 8221: 
 8222: 
 8223:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8224:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8225:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8226:         __syncthreads();
 8227:     }
 8228: 
 8229:     // 6) thread 0 atomically folds into the global accumulators
 8230:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8231: 
 8232:     *rMr_old = 0.0;
 8233:     *pAp = 0.0;
 8234: }
 8235: 
 8236: 
 8237: 
 8238: 
 8239: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 8240:    // Get the value of a variable from an element
 8241:    // varName is the name of the variable to get
 8242:    // var is the array to store the value
 8243:    // k is the vertical level index of the variable to get
 8244: 
 8245:    ELEM(elem);
 8246:    
 8247:    int idx = elem->idx;
 8248:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8249: 
 8250:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8251:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 8252:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 8253:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 8254:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 8255:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 8256:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 8257:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 8258:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 8259:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 8260:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 8261:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 8262:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 8263:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 8264:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8265:       
 8266:    
 8267: }
 8268: 
 8269: 
 8270: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8271:    // Get the value of a variable from an node
 8272:    // varName is the name of the variable to get
 8273:    // var is the array to store the value
 8274:    // k is the vertical level index of the variable to get
 8275: 
 8276:    NODE(node);
 8277:    
 8278:    int idx = node->idx;
 8279:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8280: 
 8281:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8282:    
 8283:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8284:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8285:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 8286:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8287:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8288:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8289:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8290:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 8291:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8292:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8293:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 8294:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8295:    
 8296:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8297:       
 8298:    
 8299: }
 8300: 
 8301: 
 8302: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8303:    // Get the value of a variable from an side
 8304:    // varName is the name of the variable to get
 8305:    // var is the array to store the value
 8306:    // k is the vertical level index of the variable to get
 8307:    SIDE(side);
 8308:    
 8309:    int idx = side->idx;
 8310:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8311: 
 8312:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8313:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8314:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8315:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8316:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8317:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8318:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8319:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8320:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8321:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8322:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8323:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8324:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8325:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8326:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8327:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8328:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 8329:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8330:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8331:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8332:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8333:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8334:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8335:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8336:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8337:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8338:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8339:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8340:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8341:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8342:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8343:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8344:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8345:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8346:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8347: }
 8348: 
 8349: 
 8350: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8351:    // Get the value of a variable from an side
 8352:    // varName is the name of the variable to get
 8353:    // var is the array to store the value
 8354:    // k is the vertical level index of the variable to get
 8355:    SIDE_BND(sideBnd);   
 8356: 
 8357:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8358:    if (sideBnd->segment->isLand) idx = -7;
 8359: 
 8360:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8361:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8362: 
 8363: }
