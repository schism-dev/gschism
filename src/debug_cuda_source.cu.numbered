 3569: 
 3570: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3571: 
 3572: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3573: 
 3574:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3575:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3576: 
 3577:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3578:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3579: 
 3580:    double fun_lat = 0.0;
 3581:    switch (jspc[idxComp]) {
 3582:       case 0:
 3583:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3584:          break;
 3585:       case 1:
 3586:          fun_lat = sin(2.0*lat);
 3587:          break;
 3588:       case 2:
 3589:          fun_lat = pow<2>(cos(lat));
 3590:          break;
 3591:       default:
 3592:          assert(false && "computeETP: invalid jspc");
 3593:    }
 3594:    
 3595:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3596: 
 3597: }
 3598: 
 3599: __device__ void Node::updateKb(void) {
 3600: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3601: 
 3602:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3603: 
 3604: 
 3605:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3606: 
 3607:    if constexpr(ivcor == 2) {  // SZ coordinates
 3608:       
 3609:       // Compute bottom level index
 3610:       if (depth <= mesh->h_s) {
 3611:          kb = izlev;   
 3612:          
 3613:       } else {
 3614:          kb = -1;
 3615:          int L = 0;
 3616:          int R = nzlev; 
 3617:          
 3618:          while (L <= R) {
 3619:             int M = (R + L) / 2;
 3620: 
 3621: 
 3622:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3623:             
 3624:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3625:                R = M;
 3626:             } else {
 3627:                L = M;
 3628:             }
 3629: 
 3630:             if (R - L == 1) {
 3631:                kb = L;
 3632:                break;
 3633:             }
 3634:          }
 3635: 
 3636:          // Checks that the binary search was successful
 3637:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3638:        
 3639:       }
 3640:    } 
 3641: }
 3642: 
