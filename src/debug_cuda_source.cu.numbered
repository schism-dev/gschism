 2522:    template<typename T>
 2523:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2524:       T values[4];
 2525:       getNodalValues(level, func, values);
 2526: 
 2527:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2528:       if constexpr (IsVector2<T>::value && ics == 2) {
 2529: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2530:          projectNodeVectorsToElementFrame(values);
 2531: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2532:       }
 2533: 
 2534:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2535:    }
 2536: 
 2537:    template<typename T>
 2538:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2539:       T values[4];
 2540:       getNodalValues(field, values);
 2541: 
 2542:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2543:       if constexpr (IsVector2<T>::value && ics == 2) {
 2544: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2545:          projectNodeVectorsToElementFrame(values);
 2546: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2547:       }
 2548:       
 2549:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2550:    }
 2551: 
 2552: 
 2553:    template<typename T>
 2554:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2555:       T values[4];
 2556:       getNodalValues(level, field, values);
 2557:       
 2558: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2559:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2560:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2561:       if constexpr (IsVector2<T>::value && ics == 2) {
 2562: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2563:          projectNodeVectorsToElementFrame(values);
 2564: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2565:       }
 2566: 
 2567:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2568:    }
