  490:    int kb;                    // Bottom index of the element
  491:    double area;               // Area of the element
  492:    double ssign[4];           // Sign associated with each side of an element
  493:    double radius;             // Element equivalent radii
  494: 
  495:    Frame frame;
  496: 
  497:    Vector2 gradPhi[4];       // Derivatives of shape functions
  498:    Vector2 gradEta;          // Gradient of free surface elevation
  499:    Vector2 gradPr;           // Gradient of pressure    
  500:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  501: 
  502:    bool isDry;                // True if the element is dry
  503: 
  504:    Vector2 center;         // Element center coordinates
  505:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  506:    double depth;              // Depth at element (min of all nodes)
  507:    double z[nvrt];            // z-coord  (local frame - vertical up)
  508: 
  509:    // Physical information
  510:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  511: 
  512:    static const bool isblock = false;              // Always false
  513: 
  514:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  515:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  516: 
  517:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  518: 
  519:    
  520: 
  521:    double vsource;            // Volumetric source/sink term [m^3/s]
  522: 
  523:    double rho[nvrt];          // Density at each prism center
  524:    double rho_mean[nvrt];     // Mean density at each prism center
  525:    CubicSpline rho_spl;
  526:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  527:    double rho_z[nvrt];        // First derivative of density at each prism center
  528:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  529: 
  530:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  531: 
  532:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  533:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  534: 
  535:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  536:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  537: 
  538:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  539:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  540:       // Find the local index of the node in the element (0,1,2,3)
  541:       int res = __ffs((nodes[0] == node) | 
  542:                      ((nodes[1] == node) << 1) | 
  543:                      ((nodes[2] == node) << 2) | 
  544:                      ((nodes[3] == node) << 3)) - 1;
  545:       
  546:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  547:       return res;  
  548:    }
  549: 
  550:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  551:       // Find the local index of the side in the element (0,1,2,3)
  552:       int res = __ffs((sides[0] == side) | 
  553:                      ((sides[1] == side) << 1) | 
  554:                      ((sides[2] == side) << 2) | 
  555:                      ((sides[3] == side) << 3)) - 1;
  556:       
  557:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  558:       return res;
  559:    }
  560: 
  561: 
  562:    __inline__ __device__ int findLevel(double z1, int k) const {
  563:       // Starting at index k, find sequentially the level that contains z
  564: 
  565:       // For testing purposes, forgets k and performs a full search.
  566:       for (k = kb; k < nvrt - 1; k++) {
  567:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  568:       }
  569:       return nvrt - 2;
  570: 
  571: 
  572:       // if z is already betweeen z[k] and z[k+1], return k
  573:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  574:       else if (z1 <  z[k]) { 
  575:          // Search for increasing levels
  576:          for (int kk = k; kk < nvrt - 1; kk++) {
  577:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  578:          }
  579:          return nvrt - 1;
  580:       }
  581:       else {
  582:          // Search for decreasing levels
  583:          for (int kk = k; kk >= kb; kk--) {
  584:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  585:          }
  586:          return 0;
  587:       }
  588:    }
  589: 
  590:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  591:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  592: 
  593:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  594:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  595:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  596:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  597:        const double eta = (idx & 1) ? +g : -g;
  598:        const double xi  = (idx & 2) ? +g : -g;
  599:        return {eta, xi};
  600:    }  
  601: 
  602:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  603:    __device__ __forceinline__ double etaSign(int idx) const {
  604:       // bit1: 0 -> -1, 1 -> +1
  605:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  606:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  607:    }
  608: 
  609:    __device__ __forceinline__ double xiSign(int idx) const {
  610:       // +1 if (bit0 XOR bit1), else -1
  611:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  612:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  613: 
  614:    }
  615: 
  616:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  617:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  618:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  619:    }
  620: 
  621:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  622:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  623:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  624:    }   
  625: 
  626:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  627:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  628:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  629:    }      
  630:    
  631:    __inline__ __device__ double detJ_eta(void) const;
  632: 
  633:    __inline__ __device__ double detJ_xi(void) const;
  634: 
  635:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  636: 
  637:    // Check if the element is dry using the more up-to-date elevation.
  638:    __inline__ __device__ bool isDry2(void) const;
  639: 
  640:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  641: 
  642:    __inline__ __device__ double computeSignedArea(void) const;
  643: 
  644:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  645:       // Nudges the point (x,y) to the barycenter of the element
  646:       p = (1-eps)*p + eps*center;
  647:    }
  648: 
  649:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  650:    
  651:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  652: 
  653:    __device__ double intPhiPhi(int i1, int i2) const;
  654: 
  655:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  656: 
  657:    __device__ Vector2 grad2(double *a) const
  658:    {
  659:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  660:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  661:       if (isQuad()) {
  662:          gx += a[3]*gradPhi[3].x;
  663:          gy += a[3]*gradPhi[3].y;
  664:       }
  665:       return {gx, gy};
  666:    }
  667: 
  668:    __device__ Vector2 grad2(double Node::* field) const
  669:    {
  670:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  671:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  672:       if (isQuad()) {
  673:          gx += (nodes[3]->*field)*gradPhi[3].x;
  674:          gy += (nodes[3]->*field)*gradPhi[3].y;
  675:       }
  676:       return {gx, gy};
  677:    }
  678: 
  679:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  680:    __device__ __forceinline__ Vector3 n(int k) const {
  681:       double area3D;
  682:       return n(k, area3D);
  683:     }
