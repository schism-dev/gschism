 2170:    template<typename T>
 2171:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2172:       T values[4];
 2173:       getNodalValues(level, func, values);
 2174: 
 2175:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2176:       if constexpr (IsVector2<T>::value && ics == 2) {
 2177: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2178:          projectNodeVectorsToElementFrame(values);
 2179: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2180:       }
 2181: 
 2182:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2183:    }
 2184: 
