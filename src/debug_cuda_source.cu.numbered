 2464: 
 2465: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2466:    if constexpr(ics == 1)  {
 2467:       return center;
 2468: 
 2469:    } else {
 2470:       const Point2 p0 = nodes[0]->outputCoords();
 2471:       const Point2 p1 = nodes[1]->outputCoords();
 2472:       const Point2 p2 = nodes[2]->outputCoords();
 2473: 
 2474:       if (isTri()) {
 2475:          return (1.0/3.0)*(p0 + p1 + p2);
 2476: 
 2477:       } else {
 2478:          const Point2 p3 = nodes[3]->outputCoords();
 2479:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2480:       }
 2481: 
 2482:    }
 2483: }
 2484: 
 2485: 
 2486: __device__ __forceinline__ double Element::centerZ(void) const { 
 2487: // Z coordinate of the element center in the global cartesian coordinates.
 2488: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2489: 
 2490:    if constexpr(ics==1) { 
 2491:       return 0.0; 
 2492: 
 2493:    } else { 
 2494: 
 2495:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2496:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2497:    } 
 2498: }
