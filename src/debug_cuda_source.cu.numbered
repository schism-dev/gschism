 5081:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5082:       NODE(node);
 5083: 
 5084:       const int idx = node->idx;
 5085:       Vector2 wind = {xWind[idx], yWind[idx]};
 5086: 
 5087:       if constexpr(nws != 0 && iwindoff != 0) {
 5088:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5089:       }
 5090: 
 5091:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5092:       node->setWind(wind);
 5093: 
 5094:       node->pr = pressAir[idx];
 5095:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5096: 
 5097:    }
