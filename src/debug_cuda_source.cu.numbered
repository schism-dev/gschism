 2446: 
 2447: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2448:    if constexpr(ics == 1)  {
 2449:       return center;
 2450: 
 2451:    } else {
 2452:       const Point2 p0 = nodes[0]->outputCoords();
 2453:       const Point2 p1 = nodes[1]->outputCoords();
 2454:       const Point2 p2 = nodes[2]->outputCoords();
 2455: 
 2456:       if (isTri()) {
 2457:          return (1.0/3.0)*(p0 + p1 + p2);
 2458: 
 2459:       } else {
 2460:          const Point2 p3 = nodes[3]->outputCoords();
 2461:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2462:       }
 2463: 
 2464:    }
 2465: }
 2466: 
 2467: 
 2468: __device__ __forceinline__ double Element::centerZ(void) const { 
 2469: // Z coordinate of the element center in the global cartesian coordinates.
 2470: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2471: 
 2472:    if constexpr(ics==1) { 
 2473:       return 0.0; 
 2474: 
 2475:    } else { 
 2476: 
 2477:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2478:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2479:    } 
 2480: }
