 2194:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2195:    // Project the vectors from the node frame to the element frame
 2196: 
 2197:  
 2198:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2199:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2200:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2201:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2202:       else          v[3] = Vector2();
 2203:    }
 2204: 
 2205:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2206:    // Project the vectors from the side frame to the element frame
 2207: 
 2208:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2209:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2210:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2211:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2212:       else          v[3] = Vector2();
 2213:    }
