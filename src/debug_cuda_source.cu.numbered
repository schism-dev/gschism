 2561: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2562: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2563: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2564: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2565: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2566: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2567:    Vector2 grad = {0.0, 0.0};
 2568:    int count = 0;
 2569: 
 2570:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2571: 
 2572:    // First element
 2573:    if (elems[0] != nullptr && condition(elems[0])) {
 2574:       grad += elems[0]->grad2(field);
 2575:       count++;
 2576:    }
 2577: 
 2578:    // Second element
 2579:    if (elems[1] != nullptr && condition(elems[1])) {
 2580:       grad += elems[1]->grad2(field);
 2581:       count++;
 2582:    }
 2583: 
 2584:    if (count > 0) {
 2585:       grad = grad/count;
 2586:    }
 2587:    
 2588:    return grad;
 2589: }
