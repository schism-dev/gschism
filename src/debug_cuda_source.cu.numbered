 3149: 
 3150: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3151:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3152:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3153:    // 
 3154:    // This kernel is called for all nodes.
 3155: 
 3156: 
 3157:    NODE(node1);
 3158: 
 3159: 
 3160:    node1->clearMatrixRow();
 3161:    node1->qel = 0.0;
 3162: 
 3163:    // THIS IS FOR STRUCTURES XXX
 3164:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3165: 
 3166:    
 3167:    for (int j=0; j<node1->numElements; j++) {
 3168:       // For each element connected to the node...
 3169: 
 3170:       Element *elem = node1->elements[j];
 3171: 
 3172:       // Compute the average gravity
 3173:       const double grav3 = elem->mean(&Node::grav2);
 3174: 
 3175:       // Look at the documentation for the description of the terms in the following integrals
 3176: 
 3177:       // Integral I_1 
 3178:       // \bar{\breve{H}} 
 3179:       const double hhatb = elem->mean(&Side::hhat);        
 3180: 
 3181: 
 3182:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3183: 
 3184:       const int id1 = elem->nodeLocalIdx(node1); 
 3185:       const double area = elem->area;
 3186: 
 3187:       if (elem->isTri()) {
 3188: 
 3189:          // To clarify the notation in this section: 
 3190:          //   i stands for the node under consideration (node1)
 3191:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3192:          const int id2 = elem->nxq(1 + id1);
 3193:          const int id3 = elem->nxq(2 + id1);
 3194:          Node *node2 = elem->nodes[id2];
 3195:          Node *node3 = elem->nodes[id3];
 3196: 
 3197:          const Point2 x1 = node1->p2();
 3198:          const Point2 x2 = node2->p2();
 3199:          const Point2 x3 = node3->p2();
 3200: 
 3201:          // integral of phi_i*phi_j
 3202:          const double ipp_ii = (1.0/6.0 )*area;
 3203:          const double ipp_ij = (1.0/12.0)*area;
 3204:          const double ipp_ik = (1.0/12.0)*area;
 3205: 
 3206:          // integral of [(grad phi_i) * (grad phi_j)]
 3207:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3208:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3209:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3210: 
 3211:          // Computes the different components of integral I_1 of each node with respect to node i.
 3212:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3213:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3214:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3215: 
 3216: if (j==node1->numElements-1) {
 3217: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3218: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3219: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3220: }
 3221: 
 3222:          node1->addToSparseMatrix(node1, I1_ii);
 3223:          node1->addToSparseMatrix(node2, I1_ij); 
 3224:          node1->addToSparseMatrix(node3, I1_ik);
 3225: 
 3226: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3227:      
 3228:       }
 3229:       else { // Quad
 3230:          // XXX IMPLEMENT THIS
 3231:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3232:       } 
 3233: 
 3234:  
 3235:       // Integral I_4
 3236:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3237:       // Where
 3238:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3239: 
 3240:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3241:       // of U over the element.
 3242:       Vector2 Umean = {0.0, 0.0};
 3243:       for (int m=0; m<elem->i34; m++) {      
 3244:          const Side *side = elem->sides[m];
 3245: 
 3246:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3247:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3248:       }
 3249:       Umean = Umean/elem->i34;
 3250: 
 3251:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3252: 
 3253:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3254:       const double I_4_1 = dot(gradPhi_1, Umean);
 3255: 
 3256:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3257:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3258:      
 3259:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3260: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3261: 
 3262:       // Additional terms 
 3263:       double vnorm = 0.0;
 3264:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3265:          Vector3 ubed;
 3266:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3267: 
 3268:          Vector3 gradP = {0.0, 0.0, 1.0};
 3269:          for (int m=0; m < elem->i34; m++) {
 3270:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3271:            gradP += toVector3(gradP_2D, 0.0);
 3272:          }   
 3273:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3274:       } // imm==2
 3275: 
 3276:       if (elem->isTri()) {
 3277:          for (int l=0; l<3; l++) {
 3278:            double fac;
 3279: 
 3280:            Node *node = elem->nodes[l];
 3281: 
 3282:            (node == node1)? fac=2.0 : fac=1.0;
 3283: 
 3284:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3285:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3286:            
 3287:          }
 3288: 
 3289: 
 3290:          if (!elem->isDry) {
 3291:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3292: 
 3293:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3294:          }
 3295: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3296: 
 3297:       } // isTri
 3298:       else { // isQuad
 3299:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3300:          // for (int l=0; l<4; l++) {
 3301:          //   const Node *node = elem->nodes[l];
 3302: 
 3303:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3304:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3305: 
 3306:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3307:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3308:          // }
 3309: 
 3310:       } // isQuad
 3311: 
 3312: 
 3313:       node1->qel += (dt/elem->i34)*elem->vsource;
 3314:       
 3315: 
 3316:    } // for all elements connected to the node
 3317:    
 3318: 
 3319: 
 3320:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3321:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3322:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3323:    if (nodeBnd != nullptr)  { 
 3324:       // If it is an open boundary node...
 3325: 
 3326:       // At least one open bnd side, maybe two
 3327:       for (int l=0; l<2; l++) { 
 3328: 
 3329:          // Gets each of the sides sharing the node. 
 3330:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3331: 
 3332:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3333: 
 3334:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3335: 
 3336:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3337:          if (sideBnd != nullptr) {
 3338:             // If the side is on a boundary...
 3339: 
 3340:             // Get the boundary segment
 3341:             const BoundarySegment *sideSegment = sideBnd->segment;
 3342:             const Side *side = sideBnd->side;
 3343: 
 3344:             // Integral I_3
 3345:             if (sideSegment->ifltype != 0) {
 3346:             // Natural or Flather b.c.
 3347: 
 3348:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3349:                // especially for Flather b.c.
 3350:                double ri3 = 0.0;
 3351:                if (!side->isDry) {
 3352:                   // If the side is not dry
 3353:                   
 3354:                   // Computes the side flux of (uth, vth)
 3355:                   double Vn = 0.0;
 3356:                   for (int k = side->kb; k<nvrt-1; k++) {
 3357:                      // uth, vth in lat/lon frame if ics=2
 3358:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3359:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3360:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3361: 
 3362:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3363:                   }
 3364: 
 3365:                   ri3 = 0.5*side->len*Vn;
 3366:                }
 3367: 
 3368:                if (sideSegment->ifltype == -1) { // Flather 1
 3369: 
 3370:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3371:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3372: 
 3373:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3374:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3375:                   
 3376:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3377:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3378: 
 3379:                } 
 3380:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3381:                   // Reset ri3
 3382:                   ri3 = 0.0;
 3383: 
 3384:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3385: 
 3386:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3387: 
 3388:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3389:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3390: 
 3391:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3392:                   node1->addToSparseMatrix(node1, con0*2.0);
 3393:                   node1->addToSparseMatrix(node2, con0);
 3394: 
 3395:                } // if Flather or Discharge
 3396: 
 3397:                node1->qel -= thetai*dt*ri3;
 3398: 
 3399:             } // I_3
 3400:           
 3401: 
 3402:             // Integral I_5
 3403:             if(!side->isDry) {
 3404: 
 3405:                const double Unbar = dot(side->U, side->n);
 3406: 
 3407:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3408:                
 3409:             } // I_5
 3410: 
 3411:          } // if is boundary side
 3412: 
 3413:       } // for l
 3414: 
 3415:    } // if isbnd
 3416: 
 3417: 
 3418:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3419: 
 3420: }
 3421: 
 3422: 
 3423: 
 3424: extern "C" {
 3425:    __global__ void rollUpElevation(void) {
 3426: 
 3427:       NODE(node);
 3428: 
 3429:       node->eta2 += node->eta1;
 3430: 
 3431:    }
 3432: 
 3433: 
 3434:    __global__ void backtrackAllNodes(void) {
 3435: 
 3436:       // max/min # of sub-divisions
 3437:       const int ndelt_max = max(1.0, dt/dtb_min);
 3438:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3439: 
 3440:       // Removed all references to swild98 XXX
 3441:       // swild98=0.d0 !init
 3442: 
 3443: 
 3444:       SIDE(side);
 3445: 
 3446:       const int kb = side->kb;
 3447: 
 3448: 
 3449: 
 3450:       // Initialize btrack velocities to the actual velocities at the side 
 3451:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3452: 
 3453: 
 3454:       if (side->isDry) return;
 3455: 
 3456: 
 3457:       // Checks that at least one element is not dry
 3458:       const Element *elem1 = side->elems[0];
 3459:       const Element *elem2 = side->elems[1];
 3460: 
 3461: 
 3462:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3463:       
 3464:       // XXXXXX
 3465:       // !swild_tmp to store global coord. of the starting side
 3466:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3467:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3468:       // !Use sframe2 
 3469:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3470: 
 3471: 
 3472:       for (int k = kb; k < nvrt; k++) {
 3473:       //  Initialize (xt,yt,zt), nnel and vel.
 3474:       //  For ics=2, the coordinates are in local frames
 3475:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3476: 
 3477: 
 3478:          const int iadvf = side->iadv();  // Advection flag
 3479: 
 3480:          Point3 xt;
 3481:          if constexpr(ics==1) {
 3482:             xt = side->center3D(k); 
 3483:          }
 3484:          else // lat/lon; in side lat/lon frame
 3485:          {
 3486:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3487:          // XXX IMPLEMENT THIS
 3488:       //          xt=0.d0
 3489:       //          yt=0.d0
 3490:       //          !centroid coord. for nudging
 3491:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3492:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3493:          }  // ics
 3494: 
 3495: 
 3496:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3497:          // XXX IS THIS NECESSARY?
 3498:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3499: 
 3500:          // If on land or open boundary...
 3501:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3502:          
 3503:          const double vmag = length(toVector2(u_int));
 3504: 
 3505:          if (vmag <= velmin_btrack) {
 3506:             // No activity 
 3507: addDebugPlot(side->center, side->center, 0x00FF00);
 3508:             side->btu[k] = side->u2[k];
 3509:             
 3510:          } else {  // do btrack
 3511: 
 3512:             // Compute number of sub-divisions based on local gradients 
 3513:             // XXX IS THIS NECESSARY?
 3514:             double suma = 0.0;
 3515:             int icount = 0;
 3516:             for (int ii=0; ii<2; ii++) {
 3517: 
 3518:                const Element *elem = side->elems[ii];
 3519:                  
 3520:                if (elem == nullptr) continue;
 3521: 
 3522:                icount++;
 3523: 
 3524:                // Not strictly along z; in ll frame for ics=2
 3525: 
 3526:                double utmp[4];
 3527:                double vtmp[4];
 3528:                for (int jj = 0; jj < elem->i34; jj++) {
 3529: 
 3530:                   const Node *node = elem->nodes[jj];
 3531: 
 3532:                   if constexpr(ics==1) {
 3533:                      utmp[jj] = node->u2[k].x;
 3534:                      vtmp[jj] = node->u2[k].y;  
 3535:                   } else {
 3536:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3537:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3538:                   }
 3539:                } // for jj
 3540: 
 3541:                const Vector2 grad_u = elem->grad2(utmp); 
 3542:                const Vector2 grad_v = elem->grad2(vtmp);
 3543: 
 3544:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3545:             } // for ii
 3546: 
 3547:             assert(icount > 0 && "Impossible 77");
 3548: 
 3549:             // '4' is somewhat arbitrary
 3550:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3551: 
 3552:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3553:          
 3554: 
 3555:             Vector3 u_int = {0.0, 0.0, 0.0};
 3556: 
 3557:             side->btrack(k, dt, dtbk, u_int);
 3558:                
 3559:          } // if vmag (do backtrack)
 3560: 
 3561:       } // for j=jmin,nvrt-1
 3562: 
 3563:    }
 3564: } // extern "C"
 3565: 
 3566: template<int nc>
 3567: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3568: 
 3569: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3570: //
 3571: // a,b,c,rhs: input vectors and are not modified by this program.
 3572: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3573: // rhs is the r.h.s.
 3574: // n: actual rank of the system.
 3575: // rows in u() and rhs();
 3576: // u: output with nc columns (transposed to rows)
 3577: // gam: a working array.
 3578: //
 3579: // NOTES:
 3580: // This is a template function that allows for different numbers of columns in the rhs vector.
 3581: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3582: 
 3583:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3584:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3585: 
 3586:    double bet = b[0];
 3587:    if constexpr (nc == 1) {
 3588:       u[0] = rhs[0]/bet;
 3589:    } else {
 3590:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3591:    }
 3592: 
 3593:    for (int j = 1; j < n; j++) {
 3594:       gam[j] = c[j-1]/bet;
 3595:       bet = b[j] - a[j]*gam[j];
 3596: 
 3597:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3598: 
 3599:       if constexpr (nc == 1) {
 3600:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3601:       } else {
 3602:          for (int k = 0; k < nc; k++) {
 3603:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3604:          }
 3605:       }
 3606:    }
 3607: 
 3608:    // Back-substitution
 3609:    for (int j=n-1; j>=1; j--) {
 3610:       if constexpr (nc == 1) {
 3611:          u[j] = u[j] - gam[j+1]*u[j-1];
 3612:       } else {
 3613:          for (int k = 0; k < nc; k++) {
 3614:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3615:          }
 3616:       }
 3617:    }
 3618: }
 3619: 
 3620: 
 3621: 
 3622: // Helper function that contains the core algorithm
 3623: template<typename XAccessor, typename YAccessor>
 3624: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3625:                                     double  yp_top, double  yp_bot, 
 3626:                                     CubicSpline &spline) {
 3627:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3628:    // 
 3629:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3630:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3631:    //
 3632:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3633:    // 
 3634:    // Inputs: 
 3635:    //            n: dimension for x etc; # of data pts (>=2);
 3636:    //            getX, getY: functions to access x,y coordinates
 3637:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3638:    //     Output: 
 3639:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3640: 
 3641:    const int n = k2 - k1 + 1;
 3642:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3643: 
 3644:    // Allocate memory for the splines
 3645:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3646:    spline.x   = new double[n];
 3647:    spline.y   = new double[n];
 3648:    spline.yp  = new double[n];
 3649:    spline.ypp = new double[n];
 3650: 
 3651:    for (int k=k1; k<=k2; k++) {
 3652:       spline.x[k] = getX(k);
 3653:       spline.y[k] = getY(k);
 3654:    }
 3655: 
 3656:    // This is to simplify expressions later
 3657:    double *x = spline.x;
 3658:    double *y = spline.y;
 3659: 
 3660:    double *a = nullptr;
 3661:    double *b = nullptr;
 3662:    double *c = nullptr;
 3663:    double *gam = nullptr;
 3664:    double *rhs = nullptr;
 3665:    
 3666: 
 3667:       a = new double[n];   // Lower diagonal
 3668:       b = new double[n];   // Diagonal
 3669:       c = new double[n];   // Upper diagonal
 3670:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3671:       rhs = new double[n]; // Right-hand side
 3672: 
 3673:    for (int k=k1; k<=k2; k++) {
 3674:       if (k == k1) {
 3675:          // Bottom level
 3676:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3677:          b[k] = (x[k+1] - x[k])/3.0;
 3678:          c[k] = b[k]/2.0;
 3679:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3680:       } else if (k == n - 1) {
 3681:          // Top level (surface)
 3682:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3683:          b[k] = (x[k] - x[k-1])/3.0;
 3684:          a[k] = b[k]/2.0;
 3685:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3686:       } else {
 3687:          // Intermediate levels
 3688:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3689:          b[k] = (x[k+1] - x[k-1])/3.0;
 3690:          a[k] = (x[k  ] - x[k-1])/6.0;
 3691:          c[k] = (x[k+1] - x[k  ])/6.0;
 3692:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3693:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3694:       }
 3695:    }
 3696: 
 3697:    // Solve the tridiagonal system
 3698:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3699:    
 3700:    spline.yp[k1] = yp_bot;
 3701:    spline.yp[k2] = yp_top;
 3702: 
 3703:    // Compute rest of 1st derivatives using the splines
 3704:    for (int k=k1+1; k<k2; k++) {
 3705:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3706:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3707:    }
 3708:    
 3709:    delete[] a;
 3710:    delete[] b;
 3711:    delete[] c;
 3712:    delete[] gam;
 3713:    delete[] rhs;
 3714: 
 3715: }
 3716: 
 3717: // Array version
 3718: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3719:                                 double y_top, double y_bot, 
 3720:                                 CubicSpline &spline) {
 3721:    auto getX = [x] (int k) { return x[k]; };
 3722:    auto getY = [y] (int k) { return y[k]; };
 3723:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3724: }
 3725: 
 3726: // Lambda version - allows custom access patterns
 3727: template<typename XFunc, typename YFunc>
 3728: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3729:                                 double y_top, double y_bot,
 3730:                                 CubicSpline &spline) {
 3731:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3732: }
 3733: 
 3734: 
 3735: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3736: {
 3737:    assert("Not implemented");
 3738: 
 3739:    return 0.0;
 3740: }
