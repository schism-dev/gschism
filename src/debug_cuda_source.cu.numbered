 1886: __inline__ __device__ void Element::getSidesContainingNode(const Node *node, int &idx1, int &idx2) const {
 1887: // Finds the indices of the two sides that share the node in the element. Assumes that the node is part of the element.
 1888: 
 1889:    idx1 = -1;
 1890:    idx2 = -1;
 1891:    
 1892:    // Check all sides systematically
 1893:    if (sides[0]->n1 == node || sides[0]->n2 == node) {
 1894:       idx1 = 0;
 1895:    }
 1896: 
 1897:    if (sides[1]->n1 == node || sides[1]->n2 == node) {
 1898:       if (idx1 == -1) idx1 = 1;
 1899:       else { idx2 = 1; return; }
 1900:    }
 1901: 
 1902:    if (sides[2]->n1 == node || sides[2]->n2 == node) {
 1903:       if (idx1 == -1) idx1 = 2;
 1904:       else { idx2 = 2; return; }
 1905:    }
 1906: 
 1907:    if (isQuad() && (sides[3]->n1 == node || sides[3]->n2 == node)) {
 1908:       idx2 = 3;
 1909:    }
 1910:    
 1911:    assert(idx1 >= 0 && idx2 >= 0 && "Element should have exactly two sides containing the node");
 1912: }
 1913: 
 1914: 
 1915: __inline__ __device__ bool Element::containsSegment(const Node *node, const Point2 &xt) const {
 1916: // If we call x0 = node->p, this function returns true if the segment x0xt is contained in the element (in the sense that the wedge formed by the node and its
 1917: // adjacent sides (in the element) include the segment x0xt). 
 1918: // This is in a 'closed' sense, meaning that it covers the cases where x0xt is actually along one of these sides.
 1919: 
 1920:    // Find the two sides containing the node
 1921:    int idxSide1, idxSide2;
 1922:    getSidesContainingNode(node, idxSide1, idxSide2);
 1923: 
 1924:    const Vector2 x0 = node->p;
 1925:     
 1926:    // Obtain the normal vector to the two sides containing the node in the direction inward the element
 1927:    // ssign is positive when side->n points outward, so -ssign gives inward direction
 1928:    const Vector2 n1 = -ssign[idxSide1] * sides[idxSide1]->n;
 1929:    const Vector2 n2 = -ssign[idxSide2] * sides[idxSide2]->n;
 1930: 
 1931:    const Vector2 seg = (xt - x0);
 1932:    return (dot(n1, seg) >= -geometricEpsilon && dot(n2, seg) >= -geometricEpsilon);
 1933: 
 1934: }
 1935: 
 1936: 
 1937: 
 1938: 
 1939: /**
 1940:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1941:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1942:    If the segment is completely inside the element, then it returns true.
 1943: 
 1944:    This function assumes:
 1945:    - The initial point is on a side of the element. 
 1946:    - Its position is given by parameter t in the range [0,1].
 1947:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1948:       intersects the element (elements are convex).
 1949: 
 1950:    To find the intersection point, this function does the following:
 1951:    - it finds the intersection of the line segment with all the element side lines,
 1952:       except for the one that contains the initial point.
 1953:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1954:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1955:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1956:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1957:       track segment is almost parallel to the element side line.
 1958: 
 1959:    Inputs:
 1960:    @param x1: starting point of the line segment
 1961:    @param x2: other end of the line segment
 1962: 
 1963:    Outputs:
 1964:    @param side:  side that intersects the line segment 
 1965:    @param nextElement (output):  element at that shares the intersection point with this element
 1966:    @param t (output): Parametric value of the intersection point on the side (0 <= t <= 1)
 1967:    @param tIntersect (output): Parametric value of the intersection point on the track segment x1x2 (0 <= tIntersect <= 1)
 1968: 
 1969:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1970:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1971:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1972: 
 1973:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1974:    (Delta) being zero.
 1975: 
 1976:    The intersection2 point happens when:
 1977:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1978:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1979:    
 1980:    Assumption: the 4 points (including those of the side segment) are different.
 1981:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1982:    
 1983: **/
 1984: __device__ void Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1985:                                               double &t, double &tIntersect) {
 1986:    assert( containsPoint2(x1) && "Starting point is not inside the element");                                    
 1987:    assert(!containsPoint2(x2) && "Ending point is not outside the element");
 1988: 
 1989:    double closest_intersect_t = 1e10;
 1990:    bool found_intersection = false;
 1991: 
 1992:    for (int i = 0; i < i34; i++) {
 1993: 
 1994:       Side *side2 = sides[i];
 1995: 
 1996:       // (x3,y3)-(x4,y4) is the element side line
 1997:       const Point2 x3 = side2->n1->p;
 1998:       const Point2 x4 = side2->n2->p;
 1999: 
 2000:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2001:       const double delta = cross(x2 - x1, x3 - x4);
 2002: 
 2003:       if (abs(delta) > 0) {
 2004: 
 2005:          const double delta1 = cross(x3 - x1, x3 - x4);
 2006:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2007: 
 2008:          // Solves the two linear equations for tt1 and tt2
 2009:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2010:          const double tt2 = delta2/delta;
 2011: 
 2012:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2013:             closest_intersect_t = min(closest_intersect_t, tt1);
 2014:             side = side2;
 2015:             nextElement = side->otherElem(this);
 2016:             t =          clamp(tt2, 0, 1.0);
 2017:             tIntersect = clamp(tt1, 0, 1.0);
 2018:             found_intersection = true;
 2019:          }
 2020: 
 2021:       
 2022:       }
 2023:       
 2024:    } // for
 2025: 
 2026:    assert(found_intersection && "No intersection found");
 2027: 
 2028: }
 2029: 
 2030: 
 2031: __forceinline__ __device__ bool Element::containsPoint2(Point2 x) const {
 2032:    // Check if the point (x,y) is inside the element. It does it by computing all the distances from the point to the sides (positive if inside, negative if outside)
 2033:    // And then checking if the minimum relative distance is larger than epsilon
 2034:    
 2035:    // ssign is positive if side->n is pointing outwards the element, negative if it is pointing inwards.
 2036:    double maxDist = max3(ssign[0]*sides[0]->relativeSignedDistanceToPoint(x),
 2037:                          ssign[1]*sides[1]->relativeSignedDistanceToPoint(x),
 2038:                          ssign[2]*sides[2]->relativeSignedDistanceToPoint(x));
 2039:    if (isQuad()) maxDist = max(maxDist, ssign[3]*sides[3]->relativeSignedDistanceToPoint(x));
 2040: 
 2041: printf("containsPoint2: maxDist = %.17f, x = %f, %f, n1->p = %f, %f, n2->p = %f, %f, n3->p = %f, %f, n4->p = %f, %f\n", maxDist, x.x, x.y, nodes[0]->p.x, nodes[0]->p.y, nodes[1]->p.x, nodes[1]->p.y, nodes[2]->p.x, nodes[2]->p.y);   
 2042: 
 2043:    return maxDist > geometricEpsilon;
 2044: }
 2045: 
 2046: 
 2047: 
 2048: 
 2049: __inline__ __device__ double Element::computeSignedArea(void) const {
 2050:    // Compute the area of the element
 2051: 
 2052:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2053: 
 2054:    // In the quad case we need to add the area of the other triangle.
 2055:    if (isQuad()) {
 2056:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2057:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2058:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2059:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2060: 
 2061:       res += ar1;
 2062:    }
 2063: 
 2064:    return res;
 2065: }
 2066: 
 2067: 
 2068: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2069:                                                                 (nodes[1]->isDry2()) ||
 2070:                                                                 (nodes[2]->isDry2()) ||
 2071:                                                                 (i34==4 && nodes[3]->isDry2());
 2072: }
 2073: 
 2074: __inline__ __device__ double Element::detJ_eta(void) const {
 2075:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2076:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2077: }
 2078: 
 2079: __inline__ __device__ double Element::detJ_xi(void) const {
 2080:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2081:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2082: }
