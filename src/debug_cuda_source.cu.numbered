 3962: __device__ __inline__ void Node::updateZCoordData(void) {
 3963: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3964: 
 3965:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3966:    // if (isDry2()) {
 3967:    //    kb = -1;  // XXXXXXXX KKKKK
 3968:    //    return;
 3969:    // }
 3970: 
 3971: 
 3972:    if constexpr(ivcor == 2) {  // SZ coordinates
 3973:       
 3974:       // Compute bottom level index
 3975:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3976:    } 
 3977:    else {  // if (ivcor == 1) Localized sigma
 3978:       // Do nothing
 3979:    }
 3980: 
 3981: 
 3982: }
