 8139: __global__ void returnMatrix(double *res) {
 8140:    // Debugging: returns the matrix as a CuPy array
 8141: 
 8142:    const int size = mesh->np;
 8143:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8144:       const Node *node = mesh->localNodeData + idx_node;
 8145:       res[idx_node*size + idx_node] = node->coeffDiag;
 8146:       for (int j = 0; j < node->numNodes; j++) {
 8147:          Node* nbNode = node->nodes[j];
 8148:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8149:       }
 8150: 
 8151:    }
 8152:    
 8153: }
 8154: 
 8155: __global__ void returnX(double *res) {
 8156:    // Debugging: returns the matrix as a CuPy array
 8157: 
 8158:    const int size = mesh->np;
 8159:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8160:       const Node *node = mesh->localNodeData + idx_node;
 8161: 
 8162:       res[idx_node] = node->mX;
 8163: 
 8164:    }
 8165:    
 8166: }
