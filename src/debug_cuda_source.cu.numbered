 1616: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1617:    // Computes the 3D normal vector to the element at level k
 1618:    // Returns the normal vector and the area of the element
 1619: 
 1620:       if (isTri()) {
 1621:          // For triangles...
 1622: 
 1623:          // Gets the normal vector to the element (with a length equal to twice the area)
 1624:          if constexpr(ics==1) {
 1625:             const int kb0 = max(k, nodes[0]->kb);
 1626:             const int kb1 = max(k, nodes[1]->kb);
 1627:             const int kb2 = max(k, nodes[2]->kb);
 1628: 
 1629:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1630:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1631:             
 1632:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1633:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1634:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1635:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1636: 
 1637:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1638:             area3D = 0.5*len;
 1639: 
 1640:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1641: 
 1642:             return {nx/len, ny/len, nz/len};
 1643: 
 1644:            
 1645:          }
 1646:          else {  // lat/lon
 1647:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1648: 
 1649:          } // if ics
 1650:       }
 1651:       else {
 1652:          // For quads...
 1653: 
 1654:          assert(false && "Element normal vector: quads not yet implemented");
 1655: 
 1656: 
 1657:       }
 1658:    }
 1659: 
 1660: /**
 1661:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1662:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1663:    If the segment is completely inside the element, then it returns true.
 1664: 
 1665:    This function assumes:
 1666:    - The initial point is on a side of the element. 
 1667:    - Its position is given by parameter t in the range [0,1].
 1668:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1669:       intersects the element (elements are convex).
 1670: 
 1671:    To find the intersection point, this function does the following:
 1672:    - it finds the intersection of the line segment with all the element side lines,
 1673:       except for the one that contains the initial point.
 1674:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1675:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1676:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1677:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1678:       track segment is almost parallel to the element side line.
 1679: 
 1680:    Inputs:
 1681:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1682:    @param x2, y2: other end of the line segment
 1683: 
 1684:    Outputs:
 1685:    @param side:  side that intersects the line segment (input and output)
 1686:    @param nextElement (output): element that contains the intersection point
 1687:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1688:    @param zint (input/output): Vertical coordinate of the intersection point
 1689: 
 1690:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1691:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1692:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1693: 
 1694:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1695:    (Delta) being zero.
 1696: 
 1697:    The intersection2 point happens when:
 1698:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1699:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1700:    
 1701:    Assumption: the 4 points (including those of the side segment) are different.
 1702:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1703:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1704:    If true, (xIntersect,yIntersect) is the intersection.				
 1705:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1706: **/
 1707: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1708:                                               double &t, double& tIntersect) {
 1709: 
 1710:    double closest_intersect_t = 1e10;
 1711:    bool found_intersection = false;
 1712: 
 1713:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1714:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1715:    const Point2 x1 = side->point(t);
 1716:    
 1717: 
 1718:    Side *nextSide = nullptr;
 1719:    for (int i = 0; i < i34; i++) {
 1720: 
 1721:       // Element's i-th side 
 1722:       Side *side2 = sides[i];
 1723: 
 1724:       // Skip the side that contains the initial point
 1725:       if (side2 == side) continue;
 1726: 
 1727:       // (x3,y3)-(x4,y4) is the element side line
 1728:       const Point2 x3 = side2->n1->p2();
 1729:       const Point2 x4 = side2->n2->p2();
 1730: 
 1731:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1732:       const double delta = cross(x2 - x1, x3 - x4);
 1733: 
 1734:       if (delta != 0.0) {
 1735: 
 1736:          const double delta1 = cross(x3 - x1, x3 - x4);
 1737:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1738: 
 1739:          // Solves the two linear equations for tt1 and tt2
 1740:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1741:          const double tt2 = delta2/delta;
 1742: 
 1743:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1744:             closest_intersect_t = min(closest_intersect_t, tt1);
 1745:             nextSide = side2;
 1746: 
 1747:             nextElement = nextSide->otherElem(this);
 1748:             tIntersect = max(small, min(tt1, 1.0-small));
 1749:             t = tt2;
 1750: 
 1751:             found_intersection = true;
 1752:          }
 1753:       
 1754:       }
 1755: 
 1756:    }
 1757: 
 1758:    // found_intersection should always be true, since we checked all the sides.  
 1759:    side = nextSide;
 1760: 
 1761:    return found_intersection;
 1762: }
 1763: 
 1764: 
 1765: 
 1766: 
 1767: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1768:                                               double &t, double& tIntersect) {
 1769: 
 1770:    double closest_intersect_t = 1e10;
 1771:    bool found_intersection = false;
 1772: 
 1773:    for (int i = 0; i < i34; i++) {
 1774: 
 1775:       Side *side2 = sides[i];
 1776: 
 1777:       // (x3,y3)-(x4,y4) is the element side line
 1778:       const Point2 x3 = side2->n1->p2();
 1779:       const Point2 x4 = side2->n2->p2();
 1780: 
 1781:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1782:       const double delta = cross(x2 - x1, x3 - x4);
 1783: 
 1784:       if (abs(delta) > 0) {
 1785: 
 1786:          const double delta1 = cross(x3 - x1, x3 - x4);
 1787:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1788: 
 1789:          // Solves the two linear equations for tt1 and tt2
 1790:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1791:          const double tt2 = delta2/delta;
 1792: 
 1793:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1794:             closest_intersect_t = min(closest_intersect_t, tt1);
 1795:             side = side2;
 1796:             nextElement = side->otherElem(this);
 1797:             t = tt2;
 1798:             tIntersect = max(small, min(tt1, 1.0-small));
 1799:             found_intersection = true;
 1800:          }
 1801:       
 1802:       }
 1803:       else {  // parallel segments
 1804:          assert(false && "Parallel segments");
 1805:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1806:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1807: 
 1808:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1809: 
 1810:          // const double dist = dot(x1 - x3, side2->n);
 1811:          // if (abs(dist) < small*length(x3 - x4)) {
 1812:          //    const double2 unitarySide = normalize(x4 - x3);
 1813:          //    const double len = dot(x2 - x1, unitarySide);
 1814:          //    t = t + len;
 1815:          //    t = max(0.0, min(t, 1.0));
 1816:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1817: 
 1818: 
 1819:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1820:          //    // t = tt2;
 1821:          //    found_intersection = true;
 1822:          // }
 1823:       }
 1824: 
 1825: 
 1826:    }
 1827: 
 1828:       
 1829:    assert(found_intersection && "No intersection found");
 1830: 
 1831:    // found_intersection should always be true, since we checked all the sides.  
 1832:    return found_intersection;
 1833: }
 1834: 
 1835: 
 1836: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1837:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1838: 
 1839:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1840: 
 1841:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1842:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1843:    // curElement.
 1844: 
 1845:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1846:    // And uses this velocity instead to continue the tracking.
 1847: 
 1848:    // computes the intersection point in cartesian coordinates
 1849:    Point2 intersection = nextSide->p_t(tt);
 1850: 
 1851:    // Nudges the point to the barycenter of the element. 
 1852:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1853:    // next segment intersects the element sides.  
 1854:    curElem->nudgeToBarycenter(intersection);
 1855: 
 1856:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1857:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1858:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1859:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1860: 
 1861:    // If the side is an open boundary, the tangential velocity is zero.
 1862:    if (nextSide->isBnd()) vtan = 0.0;
 1863: 
 1864:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1865:    const double us = vtan*nextSide->t().x;
 1866:    const double vs = vtan*nextSide->t().y;
 1867:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1868: 
 1869:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1870:    const double len2 = norm2(intersection - toPoint2(xt));
 1871:    const double vel2 = dot(u_int, u_int);        
 1872:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1873:    else            dt = 0.0;
 1874: 
 1875:    // The end of this tracking segment is now the intersection point.
 1876:    xt = {intersection.x, intersection.y, zint};
 1877: 
 1878:    u_int = {us, vs, ws};
 1879:    
 1880: }
 1881: 
 1882: /**
 1883:  * Tracks a particle through elements and vertical levels in the mesh.
 1884:  * 
 1885:  * @param x0,y0,z0     Starting position coordinates
 1886:  * @param xt,yt,zt     Target position coordinates
 1887:  * @param dtb          Time step for tracking
 1888:  * @param uuint,vvint,wwint Initial velocity components
 1889:  * @param nextElem     Starting/resulting element index
 1890:  * 
 1891:  * @return Status code of type trackExitCodes
 1892:  * 
 1893:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1894:  * of the details are different. The idea is that the code requires less branches and is better fit
 1895:  * for GPU execution.
 1896:  * 
 1897:  * The main ideas here are:
 1898:  * - The starting point is expected to be in the starting element.
 1899:  * - The end point is guaranteed to be inside an element.
 1900:  * - since the starting point is inside the element, there are only two cases: 
 1901:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1902:  *     (b) it does not and (xt,yt) is already in the starting element.
 1903:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1904:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1905:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1906:  * - tt1 can be positive or negative. We only consider the positive values.
 1907:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1908:  * - The next intersection will occur at the smallest positive tt1.
 1909:  * - This intersection will be the next (x0,y0) position.
 1910:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1911:  *   of getting stuck in a loop.
 1912:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1913:  *   was found.
 1914:  */
 1915: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1916:                                                        Element *&nextElem, int &jlev, double &dt,
 1917:                                                        const Side *origSide) {
 1918: 
 1919: 
 1920: 
 1921:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1922:    // else to do.
 1923:    // If it is, nudges the point to be inside the element.
 1924:    const Element *curElem = nextElem;
 1925:    if (containsPoint(toPoint2(xt), true)) {
 1926: 
 1927:       curElem->interpolateVelocities(xt, u_int);
 1928: 
 1929: addDebugPlot(x0, xt);
 1930:       return true;
 1931:    }
 1932: 
 1933:    Side *side = nullptr;
 1934: 
 1935:    // 1. Initial checks
 1936:    // Verify starting element is valid (wet)
 1937:    assert(!curElem->isDry && "Starting element is dry");
 1938: 
 1939:    // Checks if track has a zero length.
 1940:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1941:    // assert(len2 > 0.0 && "Zero length track"); 
 1942:    
 1943:    const int MAX_ITERATIONS = 1000;
 1944:    
 1945:    double t;
 1946:    Side *nextSide = nullptr;
 1947:    double tIntersect = 1e10;
 1948:    double zint = x0.z;
 1949: 
 1950:    // Horizontal tracking loop
 1951:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1952:    // (x0,y0) is inside the element but the target point is not.
 1953: 
 1954:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1955: 
 1956:    assert(found_intersection && "No intersection found at %d");
 1957: 
 1958:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1959: 
 1960:    // if the tracking segment goes out of water (either dry or edge boundary)
 1961:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1962: 
 1963: addDebugPlot(x0, xt, 0x00A0FF);
 1964:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1965: addDebugPlot(x0, xt, 0x00A0FF);      
 1966: 
 1967:       nextElem = this;
 1968:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1969:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1970:       return true;    
 1971:    }
 1972: 
 1973: 
 1974:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1975:    int iterations = 0;
 1976:    while (iterations < MAX_ITERATIONS) {
 1977:       iterations++;
 1978:       
 1979:       Element *curElem = nextElem;
 1980: 
 1981:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1982: addDebugPlot(x0, xt);
 1983:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1984: 
 1985:       // If we are already in the target element, we are done.
 1986:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1987:       if (!found_intersection) break;
 1988: 
 1989: 
 1990: 
 1991:       // if the tracking segment goes out of water (either dry or edge boundary).
 1992:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1993: addDebugPlot(x0, xt, 0x00A0FF);
 1994:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1995: addDebugPlot(x0, xt, 0x00A0FF);   
 1996:          nextElem = curElem;
 1997: 
 1998:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1999:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2000:          return true;
 2001:       }
 2002:       
 2003:       // Update position and element for next iteration
 2004:       side = nextSide;
 2005: 
 2006:    }
 2007: 
 2008:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2009: 
 2010:  
 2011:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2012:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2013: addDebugPlot(x0, xt);   
 2014:    nextElem->interpolateVelocities(xt, u_int); 
 2015: 
 2016:    return true;
 2017: }
 2018: 
 2019: 
 2020: __inline__ __device__ double Element::computeSignedArea(void) const {
 2021:    // Compute the area of the element
 2022: 
 2023:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2024: 
 2025:    // In the quad case we need to add the area of the other triangle.
 2026:    if (isQuad()) {
 2027:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2028:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2029:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2030:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2031:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2032:          Error("Negative area found in quad element");
 2033:       }
 2034:       res += ar1;
 2035:    }
 2036: 
 2037:    return res;
 2038: }
 2039: 
 2040: 
 2041: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2042:                                                                 (nodes[1]->isDry2()) ||
 2043:                                                                 (nodes[2]->isDry2()) ||
 2044:                                                                 (i34==4 && nodes[3]->isDry2());
 2045: }
 2046: 
 2047: 
 2048: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2049:    // In boundary sides, the element 1 is nullptr
 2050:    return side->elems[1] == nullptr; 
 2051: }
 2052: 
 2053: 
 2054: 
 2055: /**
 2056:    Compute the shape coordinates of the point (xt,yt) in the element.
 2057:    @param xt (input): x-coordinate of the point
 2058:    @param shpCoords (output): shape coordinates of the point
 2059:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2060:    @return true if the point is inside the element, false otherwise
 2061: **/
 2062: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2063:                                             bool fixNegshpCoord) const {
 2064: 
 2065:    // Compute the shape coordinates of the point xt in the element.
 2066:    if (i34==3) {
 2067:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2068:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2069:       // and in this case, the pt will be nudged into the element
 2070:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2071:       // from the local frame, so use additional check.
 2072: 
 2073:       Point2 x0, x1, x2;
 2074: 
 2075:       if constexpr(ics==1) {
 2076:          x0 = nodes[0]->p2();
 2077:          x1 = nodes[1]->p2();
 2078:          x2 = nodes[2]->p2();
 2079:       }
 2080:       else // lat/lon
 2081:       {
 2082:          Error("Not implemented yet");
 2083: #ifdef ICS2
 2084:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2085:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2086:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2087: #endif
 2088:       }
 2089: 
 2090:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2091:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2092:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2093:       shpCoords[3] = 0.0;
 2094:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2095: 
 2096:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2097:       // then we fix the negative shape coordinates.
 2098:       if (fixNegshpCoord && tmpmin<=0.0) {
 2099: 
 2100:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2101:          // keeping the sum of the shape coordinates equal to 1.
 2102:          // I have tested and compared the new algorithm with the old one, and they give
 2103:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2104:          // The new algorithm should be faster since it is branchless.
 2105:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2106:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2107:          
 2108:          shpCoords[0] = (shpCoords[0] + a)*b;
 2109:          shpCoords[1] = (shpCoords[1] + a)*b;
 2110:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2111: 
 2112:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2113:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2114:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2115:          }
 2116: 
 2117:          // Update the point coordinates for the new shape coordinates
 2118:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2119:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2120:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2121: 
 2122:       }
 2123: 
 2124:       // Check if the point is inside the element
 2125:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2126:    }
 2127:    else {
 2128:       Error("Not implemented yet");
 2129: #ifdef QUADS
 2130:       // Reproject pt in eframe of nel for ics=2
 2131:       if constexpr(ics==1) {
 2132:          xn2 = xt; 
 2133:          yn2 = yt;
 2134:       }
 2135:       else {
 2136:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2137:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2138:       }
 2139: 
 2140:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2141: #endif
 2142:    }
 2143: 
 2144:    return false;  // Never reached
 2145: 
 2146: }
 2147: 
 2148: 
 2149: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2150: // Convert shape coordinates to cartesian coordinates
 2151: 
 2152:    if (i34 == 3) {
 2153:       // Triangular element
 2154:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2155:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2156:    }
 2157:    else {
 2158:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2159:    }
 2160: 
 2161: }
 2162: 
 2163: 
 2164: /**  Interpolate velocities at a given point (xt,yt,zt)
 2165: 
 2166:    @param xt, yt, zt: coordinates of the point to interpolate
 2167:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2168: 
 2169:    This is done in four steps:
 2170: 
 2171:    1. Find the shape coordinates for the final position in the element.
 2172:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2173:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2174:       z levels at xt, yt at each step.   
 2175:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2176:       horizontally and vertically.
 2177: **/
 2178: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2179:    // Interpolate the velocities at the point xt. 
 2180:    // This function works the same for triangular and quadrilateral elements.
 2181:    double shpCoord[4];
 2182: 
 2183:    // First step is to compute the shape coordinates of (xt,yt)
 2184:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2185:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2186: 
 2187:    // Second step is to find the level that contains zt
 2188:    // Uses a binary search to find the level
 2189:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2190:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2191:    int R = nvrt - 1;
 2192: 
 2193:    // Get the z coordinates at the nodes of the element at the levels L and R
 2194:    double zLAtNodes[4], zRAtNodes[4];
 2195:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2196:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2197: 
 2198:    double zL = interpolate(shpCoord, zLAtNodes);
 2199:    double zR = interpolate(shpCoord, zRAtNodes);
 2200:    
 2201:    // Interpolates vertically the velocities
 2202:    double wght1, wght2;
 2203:    if (xt.z<=zL) {
 2204:       wght1 = 1.0;
 2205:       wght2 = 0.0;
 2206:    }
 2207:    else if (xt.z>=zR) {
 2208:       wght1 = 0.0;
 2209:       wght2 = 1.0;
 2210:    }
 2211:    else {
 2212:       // Perform a binary search to find the levels between L and R that contain xt.z
 2213:       while (R - L > 1) {
 2214:          int M = (L + R) / 2;
 2215: 
 2216:          double zMAtNodes[4];
 2217:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2218:          double zM = interpolate(shpCoord, zMAtNodes);
 2219:          if (zM < xt.z) 
 2220:          {
 2221:             L = M;
 2222:             zL = zM;
 2223:          }
 2224:          else 
 2225:          {
 2226:             R = M;
 2227:             zR = zM;
 2228:          }
 2229:       }
 2230:       assert(L == R-1);
 2231:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2232: 
 2233:       wght2 = (xt.z - zL)/(zR - zL);
 2234:       wght1 = 1.0 - wght2;
 2235:    }
 2236: 
 2237:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2238:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2239: 
 2240:    // Neither of the interpolated velocities should be NaN
 2241:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2242: 
 2243: }
