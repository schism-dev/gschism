 7382: //                     !For outflow open bnd side, estimate mass in (open
 7383: //                     !side cannot be interface side)
 7384: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7385: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7386: //                     endif
 7387: 
 7388: //                     cycle
 7389: //                   endif
 7390: 
 7391: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7392: //                   iweno=.false.  !reset to upwind
 7393: //                   ibnd=isbs(jsj) !global bnd #
 7394: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7395: //                   nwild(1:2)=0
 7396: //                   do ll=1,2 !nodes
 7397: //                     ndo=isidenode(ll,jsj)
 7398: //                     do lll=1,2 !2 possible bnds
 7399: //                       if(isbnd(lll,ndo)==ibnd) then
 7400: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7401: //                         exit
 7402: //                       endif
 7403: //                     enddo !lll
 7404: //                   enddo !ll
 7405: //                   ind1=nwild(1); ind2=nwild(2);
 7406: 
 7407: //                   do jj=1,natrm
 7408: //                     if(ntrs(jj)<=0) cycle
 7409: 
