 6835: #ifdef DONTCOMPILE
 6836: __device__ void computeVerticalAdvection(void) {
 6837:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6838: 
 6839:    sdbt(1:2,:,:)=0.d0
 6840: 
 6841:    const Side *side = FROM kernel;
 6842: 
 6843:    if(side->isDry) return;
 6844: 
 6845:    // If side is wet...
 6846: 
 6847: 
 6848:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6849:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6850:    double ws[nvrt] = {} // w @ side
 6851:    int icount = 0;
 6852:    for (int j=0; j<2; j++) {
 6853:       const Element *elem = side->elements[j];
 6854:        
 6855:       if(elem != nullptr) {
 6856:          icount++;
 6857:          for (int k=0; k<nvrt; k++) {
 6858:             ws[k] = ws[k] + elem->w[k];
 6859:          }
 6860:       }
 6861:    }  // for j
 6862: 
 6863:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6864:    ws = ws/icount;
 6865: 
 6866:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6867:    // Splines allow for a smooth transition between vertical levels.
 6868:    // Splines have continuity restrictions at the internal knots, but
 6869:    // we have to provide the 1st derivatives at the endpoints.
 6870:    const int kbs = side->kbs; 
 6871:    
 6872:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6873:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6874:    initCubicSpline(kbs, nvrt, side, ws, up)
 6875: 
 6876:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6877:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6878:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6879: 
 6880:    // Total advection (average onto side)
 6881:    const Node *node1 = side->nodes[0];
 6882:    const Node *node2 = side->nodes[1];
 6883:    for (int k=kbs(i); k<nvrt; k++) {
 6884: 
 6885:       if constexpr(ics==1) {
 6886:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6887:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6888:       } else {
 6889:          // XXX IMPLEMENT THIS
 6890:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6891:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6892:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6893:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6894:       }  // if ics
 6895: 
 6896: 
 6897:    }
 6898: }
 6899: #endif
 6900: 
 6901: 
 6902: extern "C" {
 6903:    __global__ void computeElemAverageGhat(void) {
 6904:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6905: 
 6906:       ELEM(elem);
 6907:       
 6908:       elem->ghat1= {0.0, 0.0};  
 6909: 
 6910:       if constexpr(ihydraulics != 0) {
 6911:          if (nhtblocks > 0 && elem->isblock) return;
 6912:       }
 6913: 
 6914:       if (elem->isDry) return;
 6915: 
 6916:       // Wet elements.
 6917:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6918:       // tidal potential, horizontal diffusion, and baroclinic etc
 6919:       // Remember to update both fb and F 
 6920:       // If ics=2, ghat1 are in eframe (ll)
 6921:       // cff1-3: coefficients for 2D/3D
 6922:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6923:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6924:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6925: 
 6926:       double av_cff1 = 0.0;  // av. for cff1
 6927:       double av_cff2 = 0.0;  // av. for cff2
 6928:       double av_cff3 = 0.0;  // av. for cff3
 6929:       double av_df = 0.0;  // av. for H^\alpha / H
 6930:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6931:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6932: 
 6933:       const int i34 = elem->i34;
 6934:       const int kb = elem->kb;
 6935: 
 6936:       for (int j=0; j<i34; j++) {
 6937:          // For each node and side in the element...
 6938: 
 6939:          const Node *node = elem->nodes[j];
 6940:          const Side *side = elem->sides[j];
 6941: 
 6942:          const double chi      = side->chi;
 6943:          const double veg_c2   = side->veg_c2;
 6944:          const double veg_beta = side->veg_beta;
 6945:          const double veg_h    = side->veg_h();
 6946:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6947: 
 6948:          // Node - const in elem
 6949:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6950:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6951: 
 6952:          if (elem->depth >= tip_dp) {
 6953:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6954:          }
 6955: 
 6956:          
 6957:          const double htot  = side->htot2();        // Total depth at the side
 6958:          const double zctr2 = side->zTopCanopy();  
 6959: 
 6960:          double cff1; 
 6961:          double cff2; 
 6962:          double cff3;   
 6963:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6964:          // coefficients applied to 2D/3D case 
 6965:             cff1 = side->hhat/htot;
 6966:             cff2 = 0.0;
 6967:             cff3 = 0.0;
 6968:          } else { //3D
 6969:             //Init for no-veg case
 6970:             cff1 = 1.0;
 6971:             cff2 = 1.0;
 6972:             cff3 = 0.0;
 6973: 
 6974:             if constexpr(iveg != 0) {
 6975:                // Computes coefficients used with vegetation terms G1, G2
 6976:                // cff1, cff3 are used for the first two terms in G1, G2:
 6977:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6978:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6979:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6980:                if(veg_h < 0.99*htot) { // submergent vegetation
 6981:                   cff1=1;
 6982:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6983:                   cff3 = veg_c;
 6984: 
 6985:                } else { // emergent vegetation
 6986:                   cff1 = 1.0/(1.0 + veg_c2);
 6987:                   cff2 = cff1;
 6988:                   cff3 = 0.0;
 6989: 
 6990:                }
 6991:             } // if iveg
 6992:          } //  2D/3D
 6993: 
 6994:          av_cff1 += cff1/i34;
 6995:          av_cff2 += cff2/i34;
 6996:          av_cff3 += cff3/i34;
 6997:          av_cff2_chi += cff2*chi/i34;
 6998:          av_cff3_chi += cff3*chi/i34;
 6999:          av_df += min(htot, veg_h)/(htot*i34);
 7000: 
 7001: 
 7002:          // btrack values: U^\star, U^{\star\alpha}
 7003:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7004:          Vector2 Ustar       = {0.0, 0.0}; 
 7005:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7006: 
 7007:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7008:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7009:          } else { //3D
 7010:             for (int k = side->kb; k < nvrt; k++) {
 7011:             
 7012:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7013:                Ustar += w2;
 7014: 
 7015:                if constexpr(iveg != 0) {
 7016:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7017:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7018:                        Ustar_alpha += zrat*w2; // XXXX
 7019:                    }
 7020:                }  // if iveg
 7021:             }  // for k
 7022:          }  //2D/3D
 7023:          
 7024: 
 7025:          // Add btrack & surface stress terms to \breve{G} first
 7026:          if constexpr(ics==1) {
 7027: 
 7028:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7029: 
 7030:          } else {
 7031:             // XXX IMPLEMENT THIS
 7032:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7033:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7034:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7035:          }  // if ics
 7036: 
 7037:          // Surface and bottom stress terms
 7038:          if constexpr(ics==1) {
 7039:             const Vector2 tau    = side->tau();
 7040:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7041: 
 7042:             // Term for surface and bottom stress
 7043:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7044: 
 7045:          } else {
 7046:             assert(false && "computeElemAverageGhat: Not implemented");
 7047:             // XXX IMPLEMENT THIS
 7048:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7049:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7050:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7051:             // tau_x=(vn1+tt1)/2.d0
 7052:             // tau_y=(vn2+ss1)/2.d0
 7053:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7054:          }  // if ics
 7055: 
 7056:          
 7057: 
 7058:          // All terms in F,F^\alpha,f_b except baroclinic
 7059:          // F, f_b: all explicit terms excluding vegetation 
 7060:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7061:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7062:          const double coriolis = side->coriolis;
 7063:          Vector2 F  =  coriolis*side->U;  // F_x
 7064:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7065:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7066: 
 7067:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7068:             
 7069:             for (int k = side->kb; k < nvrt; k++) {
 7070:                if (zctr2 > side->zc[k-1]) {
 7071:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7072:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7073:                    Fa +=  coriolis*w2*zrat;
 7074:                } // if zctr2
 7075:             } // k
 7076:          } // iveg
 7077: 
 7078:          // Integrate horizontal viscosity force vertically
 7079:          for (int k=side->kb + 1; k<nvrt; k++) {
 7080:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7081: 
 7082:             F += levelHorVisc;
 7083: 
 7084:             // Vegetation term
 7085:             if constexpr(iveg!=0) {
 7086:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7087:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7088:                   Fa += levelHorVisc*zrat;
 7089:                } 
 7090:             } // if iveg
 7091:          } // for k
 7092: 
 7093:          fb += side->nuGradU[side->kb];
 7094: 
 7095:          // Add to ghat1
 7096:          if constexpr(ics==2) {
 7097:             // XXX IMPLEMENT THIS
 7098:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7099:             // bigf1=vn1; bigf2=vn2
 7100:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7101:             // botf1=vn1; botf2=vn2
 7102:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7103:             // bigfa1=vn1; bigfa2=vn2
 7104:          } // if ics
 7105: 
 7106:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7107:       } // for j (nodes and sides)
 7108: 
 7109:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7110:          
 7111:       // Finish off terms in F, F^\alpha and f_b
 7112:       const double grav3 = elem->mean(&Node::grav2);
 7113:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7114: 
 7115: 
 7116:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7117:       for (int j=1; j<i34; j++) { 
 7118:          // For each side in the element...
 7119:          const Side *side = elem->sides[j];
 7120:          const double chi = side->chi;
 7121: 
 7122:          const double htot = side->htot2();
 7123:          const double veg_h = side->veg_h();
 7124:          const Vector2 F  = htot*fb;
 7125:          const Vector2 Fa = min(htot, veg_h)*fb;
 7126: 
 7127:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7128:       } // for j
 7129: 
 7130:       //botf1 etc are already in elem frame
 7131:       elem->ghat1 += tmp/i34;
 7132: 
 7133:       // Baroclinic force
 7134:       if constexpr(ibc==0) {
 7135:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7136: 
 7137:          Vector2 Fa = {0.0, 0.0};
 7138:          Vector2 intGradRho = {0.0, 0.0};
 7139:          
 7140:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7141:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7142:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7143: 
 7144:             // \in F [m^2/s/s]
 7145:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7146:          }
 7147: 
 7148:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7149:          const Vector2 F = av_df*Fa; //approx
 7150:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7151: 
 7152:       } // if ibc
 7153: 
 7154: 
 7155: 
 7156:    }
 7157: 
 7158: } // extern "C"
 7159: 
 7160: 
 7161: 
 7162: #ifdef DONTCOMPILE
 7163: __global__ void checkMassConservation(Tracers* sumtr) {
 7164: 
 7165:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7166: 
 7167:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7168: 
 7169:    Element *elem = &(mesh->localElemData[i]);
 7170: 
 7171:    // Skip dry elements
 7172:    if (elem->isDry) return;
 7173: 
 7174:    // Local sum array for this thread
 7175:    double localSum[N_TRACERS] = {0.0};
 7176: 
 7177:    // Sum over vertical levels for this element
 7178:    const int kbe = elem->kbe;
 7179:    const double area = elem->area;
 7180: 
 7181:    for (int k = kbe; k < nvrt; k++) {
 7182:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7183:       
 7184:       // Accumulate tracer mass
 7185:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7186:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7187:       }
 7188:    }
 7189: 
 7190:    //  This function returns per element sums. A reduction must be done on the host side.
 7191: }
 7192: 
 7193: 
 7194: __global__ void transport(void) {
 7195: 
 7196:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7197: 
 7198:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7199: 
 7200:    Element *elem = &(mesh->localElemData[ie]);
 7201: 
 7202:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7203: 
 7204:                for (int m=0; m<ntr; m++) {
 7205:                   for (int k=kbe(ie); k<nvrt; k++) {
 7206:                      // Calculate each polynomial's weight 
 7207:                      wm=0.d0; sum1=0.d0; 
 7208:                      wm1=0.d0; wm2=0.d0; 
 7209:                      for (int i=0; i<elem->nweno2; i++) {
 7210:                   
 7211:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7212:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7213:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7214:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7215:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7216:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7217:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7218:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7219:                      // -----------------Hu and Shu (1999)'s method----------------
 7220:                      b4=b1+b2+b3
 7221: 
 7222: //Error: add PRODUCTION CPP
 7223: #ifdef DEBUG
 7224:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7225:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7226:                     call parallel_abort(errmsg)
 7227:                   }
 7228: #endif
 7229: 
 7230:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7231:                   // !----test-------------- 
 7232:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7233:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7234:                   // !wm(i)=wm1(i)*wm2(i)
 7235:                   // !---------------------- 
 7236:                   sum1=sum1+wm(i)
 7237:                 } // end for i
 7238: 
 7239:                 wm=wm/sum1
 7240: 
 7241:                 for (int j=0; j<elem->i34; j++) {
 7242: 
 7243:                   const Side *side  = elem->sides[j];
 7244:                   const Node *node1 = side->n1;
 7245:                   const Node *node2 = side->n2;
 7246: 
 7247:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7248:                      trsd=0.d0
 7249:                      for (int kk=0; kk<nquad; kk++) {
 7250:                         for (int i=0; i<elem->nweno2; i++) {
 7251:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7252:                         } // end for i   
 7253:                      } // end for kk
 7254:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7255:                   } // outward flux
 7256:                } // end for j=1,i34(ie) ! side
 7257:             }
 7258:          }
 7259:               
 7260: 
 7261: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7262: //             //   calculate each polynomial's weight 
 7263: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7264: //                 wm=0.d0; sum1=0.d0
 7265: //                 do i=1,nweno1(ie) !for each polynomial
 7266: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7267: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7268: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7269: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7270: //                   wm(i)=b2
 7271: //                   sum1=sum1+b2
 7272: //                   !wm(i)=1.d0
 7273: //                   !sum1=sum1+1.d0
 7274: 
 7275: // // Error: PRODUCTION
 7276: // #ifdef DEBUG
 7277: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7278: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7279: //                     call parallel_abort(errmsg)
 7280: //                   endif
 7281: // #endif
 7282: 
 7283: //                 enddo !i
 7284: //                 wm=wm/sum1 !final weight
 7285: 
 7286:                 for (int j=0; j<elem->i34; j++) { // side
 7287:                   const Side *side = elem->sides[j];
 7288:                   const Node *node1 = side->n1;
 7289:                   const Node *node2 = side->n2;
 7290: 
 7291:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7292:                     trsd=0.d0
 7293:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7294:                       for (int i=0; i<elem->nweno1; i++) {
 7295:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7296:                       }
 7297:                     enddo //kk
 7298:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7299:                   } // outward flux
 7300:                 } // end for j=1,i34(ie) ! side
 7301:               } // end for k; ntr 
 7302: 
 7303:             else !simple upwind method
 7304:               do j=1,i34(ie)
 7305:                 jsj=elside(j,ie)
 7306:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7307:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7308:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7309:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7310:                   endif
 7311:                 enddo  !vertical layers
 7312:               enddo !j=1,i34(ie) ! side
 7313:             endif !order of accuracy
 7314: 
 7315:          //  enddo !ie
 7316: // !$OMP     end do
 7317: 
 7318: // !$OMP     master
 7319: //           !message passing
 7320: //           if (nproc>1) then
 7321: //             !make a copy of side concentrations
 7322: //             trsd_tmp0=trsd_tmp 
 7323: 
 7324: //             !this exchange routine swaps interface concentration between two partitions
 7325: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7326: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7327: 
 7328: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7329: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7330: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7331: 
 7332: 
 7333: //             !This obtains final values for interface sides
 7334: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7335: //       :    endif !nproc>1
 7336: //           !message passing end
