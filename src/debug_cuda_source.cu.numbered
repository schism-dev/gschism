  665: struct Element {
  666: 
  667:    // Geometry information
  668:    int idx;                   // Index of the element
  669:    int i34;                   // Number of sides for the element 
  670:    Side *sides[4];            // Sides of the element
  671:    Node *nodes[4];            // Nodes of the element
  672:    Element *nghbElems[4];     // Neighbors of the element
  673: 
  674:    int kb;                    // Bottom index of the element
  675:    double area;               // Area of the element
  676:    double ssign[4];           // Sign associated with each side of an element
  677:    double radius;             // Element equivalent radii
  678: 
  679:    #ifdef USE_FRAMES
  680:    Frame frame;
  681:    #endif
  682: 
  683:    Vector2 gradPhi[4];        // Derivatives of shape functions
  684:    Vector2 gradEta;           // Gradient of free surface elevation
  685:    Vector2 gradPr;            // Gradient of pressure    
  686:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  687: 
  688:    bool isDry;                // True if the element is dry
  689: 
  690:    Point2 center;            // Element center coordinates (global coordinates)
  691: 
  692:    double depth;              // Depth at element (min of all nodes)
  693:    double z[nvrt];            // z-coord  (local frame - vertical up)
  694: 
  695:    // Physical information
  696:    // Tracers tracers[nvrt];     // Tracer values at each vertical level  
  697: 
  698:    static const bool isblock = false;              // Always false
  699: 
  700:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  701:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  702: 
  703:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  704:    
  705: 
  706:    double vsource;            // Volumetric source/sink term [m^3/s]
  707: 
  708:    double rho[nvrt];          // Density at each prism center
  709:    double rho_mean[nvrt];     // Mean density at each prism center
  710:    CubicSpline rho_spl;
  711:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  712:    double rho_z[nvrt];        // First derivative of density at each prism center
  713:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  714:    
  715: 
  716:    __inline__ __device__ Point2 outputCoords(void) const;
  717: 
  718:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
  719: 
  720:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
  721:    // If ics == 2, convert the global point to the local frame of the element
  722:       
  723:       if constexpr (ics == 1) {
  724:          return p;
  725:       } else {
  726: #ifdef USE_FRAMES
  727:          const Point3 c = {center.x, center.y, centerZ()};
  728:          const Point3 local = frame.G2L(p - c);
  729:          return local;
  730: #else
  731:          return p;
  732: #endif
  733:       }
  734:    }
  735: 
  736:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  737:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  738: 
  739:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  740:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  741: 
  742:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  743:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  744:       // Find the local index of the node in the element (0,1,2,3)
  745:       int res = __ffs((nodes[0] == node) | 
  746:                      ((nodes[1] == node) << 1) | 
  747:                      ((nodes[2] == node) << 2) | 
  748:                      ((nodes[3] == node) << 3)) - 1;
  749:       
  750:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  751:       return res;  
  752:    }
  753: 
  754:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  755:       // Find the local index of the side in the element (0,1,2,3)
  756:       int res = __ffs((sides[0] == side) | 
  757:                      ((sides[1] == side) << 1) | 
  758:                      ((sides[2] == side) << 2) | 
  759:                      ((sides[3] == side) << 3)) - 1;
  760:       
  761:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  762:       return res;
  763:    }
  764: 
  765:    __inline__ __device__ int findLevel(double z1, int k) const {
  766:       // Starting at index k, find sequentially the level that contains z
  767: 
  768:       // For testing purposes, forgets k and performs a full search.
  769:       for (k = kb; k < nvrt - 1; k++) {
  770:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  771:       }
  772:       return nvrt - 2;
  773: 
  774: 
  775:       // if z is already betweeen z[k] and z[k+1], return k
  776:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  777:       else if (z1 <  z[k]) { 
  778:          // Search for increasing levels
  779:          for (int kk = k; kk < nvrt - 1; kk++) {
  780:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  781:          }
  782:          return nvrt - 1;
  783:       }
  784:       else {
  785:          // Search for decreasing levels
  786:          for (int kk = k; kk >= kb; kk--) {
  787:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  788:          }
  789:          return 0;
  790:       }
  791:    }
  792: 
  793:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  794:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  795: 
  796: 
  797:    __device__ __forceinline__ double centerZ(void) const;
  798: 
  799:    // "Local" horizontal coordinates at the nodes. They are computed from the 3D global node coordinates. For ics == 1 and 2
  800:    // Local is in quotes because for ics == 1, the coordinates are unchanged. It just means that in these coordinates, the element is horizontal.
  801:    __device__ __forceinline__ Point2 getLocalHorizontalNodePosition(int idxNode) const;
  802:    __device__ __forceinline__ void getLocalHorizontalNodePositionsTri (Point2 &x0, Point2 &x1, Point2 &x2, int idx = 0) const;
  803:    __device__ __forceinline__ void getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const;
  804: 
  805: 
  806:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
  807:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
  808:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  809:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
  810:        const double eta = (idxNode & 1) ? +g : -g;
  811:        const double xi  = (idxNode & 2) ? +g : -g;
  812:        return {eta, xi};
  813:    }  
  814: 
  815:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  816:    __device__ __forceinline__ double etaSign(int idxNode) const {
  817:       // bit1: 0 -> -1, 1 -> +1
  818:       assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  819:       return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  820:    }
  821: 
  822:    __device__ __forceinline__ double xiSign(int idxNode) const {
  823:       // +1 if (bit0 XOR bit1), else -1
  824:       assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  825:       return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  826: 
  827:    }
  828: 
  829:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
  830:    __device__ __forceinline__ double Phi(int idxNode, Point2 p) const {
  831:       return 0.25*(1.0 + p.x*etaSign(idxNode))*(1.0 + p.y*xiSign(idxNode));
  832:    }
  833: 
  834:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
  835:    __device__ __forceinline__ double dPhi_dxi(int idxNode, Point2 p) const {
  836:       return 0.25*xiSign(idxNode)*(1.0 + p.x*etaSign(idxNode));
  837:    }   
  838: 
  839:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  840:    __device__ __forceinline__ double dPhi_deta(int idxNode, Point2 p) const {
  841:       return 0.25*(1.0 + p.y*xiSign(idxNode))*etaSign(idxNode);
  842:    }      
  843:    
  844:    __inline__ __device__ double detJ_eta(void) const;
  845: 
  846:    __inline__ __device__ double detJ_xi(void) const;
  847: 
  848:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
