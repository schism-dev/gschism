 1569: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1570:                    Side *side = &(mesh->localSideData[idx_side]); \
 1571:                    if (idx_side >= mesh->ns) return;
 1572: 
 1573: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1574:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1575:                    if (idx_elem >= mesh->ne) return;
 1576: 
 1577: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1578:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1579:                    if (idx_node >= mesh->np) return;
 1580: 
 1581: 
 1582: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1583:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1584:                            if (idx_node_bnd >= mesh->nbp) return;
 1585: 
 1586: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1587:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1588:                            if (idx_side_bnd >= mesh->nbs) return;                           
