 2514: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2515:    // Returns the value of the velocity at the side center
 2516:    const double w1 = getBoundaryArrayValueWeight();
 2517:    const double w2 = 1.0 - w1;
 2518:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2519:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2520: 
 2521:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2522: }
