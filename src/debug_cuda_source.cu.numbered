 4505: extern "C" {
 4506: 
 4507:    __global__ void scaleGravity(double loadtide_coef) {
 4508: 
 4509: 
 4510:       NODE(node);
 4511: 
 4512:       // SAL option: scale gravity
 4513:       if constexpr(iloadtide==2) {  // simple const
 4514:          node->grav2 = grav*(1.0 - loadtide_coef);
 4515: 
 4516:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4517:         
 4518:           const double depth = max(node->depth, 0.0);
 4519:           const double tmp1 = sqrt(depth);
 4520:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4521:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4522:                              2.6969e-13*depth*depth*depth*tmp1;
 4523:           
 4524:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4525:           
 4526: 
 4527: 
 4528:           node->grav2 = grav*(1.0 - beta_bar);
 4529: 
 4530:       } else {  // iloadtide=0,1
 4531:           node->grav2 = grav;
 4532: 
 4533:       }
 4534: 
 4535:    }
 4536: 
