 3804: extern "C" {
 3805: 
 3806:    __global__ void scaleGravity(double loadtide_coef) {
 3807: 
 3808: 
 3809:       NODE(node);
 3810: 
 3811:       // SAL option: scale gravity
 3812:       if constexpr(iloadtide==2) {  // simple const
 3813:          node->grav2 = grav*(1.0 - loadtide_coef);
 3814: 
 3815:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3816:         
 3817:           const double depth = max(node->depth, 0.0);
 3818:           const double tmp1 = sqrt(depth);
 3819:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3820:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3821:                              2.6969e-13*depth*depth*depth*tmp1;
 3822:           
 3823:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3824:           
 3825: 
 3826: 
 3827:           node->grav2 = grav*(1.0 - beta_bar);
 3828: 
 3829:       } else {  // iloadtide=0,1
 3830:         node->grav2=grav;
 3831: 
 3832:       }
 3833: 
 3834:    }
 3835: 
