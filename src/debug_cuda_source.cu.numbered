 4986:    __global__ void scaleGravity(double loadtide_coef) {
 4987: 
 4988: 
 4989:       NODE(node);
 4990: 
 4991:       // SAL option: scale gravity
 4992:       if constexpr(iloadtide==2) {  // simple const
 4993:          node->grav2 = grav*(1.0 - loadtide_coef);
 4994: 
 4995:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4996:         
 4997:           const double depth = max(node->depth, 0.0);
 4998:           const double tmp1 = sqrt(depth);
 4999:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5000:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5001:                              2.6969e-13*depth*depth*depth*tmp1;
 5002:           
 5003:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5004:           
 5005: 
 5006: 
 5007:           node->grav2 = grav*(1.0 - beta_bar);
 5008: 
 5009:       } else {  // iloadtide=0,1
 5010:           node->grav2 = grav;
 5011: 
 5012:       }
 5013: 
 5014:    }
