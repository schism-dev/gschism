 8590:          break;
 8591:       // case (int)VarCode::depth:
 8592:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 8593:       //    *sizeType = sizeof(double);
 8594:       //    break;         
 8595:       case (int)VarCode::x:
 8596:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 8597:          *sizeType = sizeof(Vector2);
 8598:          break;
 8599:       case (int)VarCode::len:
 8600:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8601:          *sizeType = sizeof(double);
 8602:          break;
 8603:       case (int)VarCode::kb:
 8604:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8605:          *sizeType = sizeof(int);
 8606:          break;
 8607:       case (int)VarCode::isdry:
 8608:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8609:          *sizeType = sizeof(int);
 8610:          break;            
 8611:       // case (int)VarCode::w:
 8612:       //    *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8613:       //    *sizeType = sizeof(double);
 8614:       //    break;
 8615:       case (int)VarCode::u:
 8616:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8617:          *sizeType = sizeof(Vector2);
 8618:          break;   
 8619:       case (int)VarCode::btu:
 8620:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 8621:          *sizeType = sizeof(Vector2);
 8622:          break;          
 8623:       case (int)VarCode::U:
 8624:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 8625:          *sizeType = sizeof(Vector2);
 8626:          break;
 8627:       case (int)VarCode::gradETP:
 8628:          *offset = (int)((char*)&sides[0].gradETP.x - (char*)sides);
 8629:          *sizeType = sizeof(Vector2);
 8630:          break;
 8631:       case (int)VarCode::gradPr:
 8632:          *offset = (int)((char*)&sides[0].gradPr.x - (char*)sides);
 8633:          *sizeType = sizeof(Vector2);
 8634:          break;
 8635:       case (int)VarCode::gradEta1:
 8636:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
 8637:          *sizeType = sizeof(Vector2);
 8638:          break;
 8639:       case (int)VarCode::gradEta2:
 8640:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 8641:          *sizeType = sizeof(Vector2);
 8642:          break;
 8643:       // case (int)VarCode::ghat:
 8644:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8645:       //    *sizeType = sizeof(Vector2);
 8646:       //    break;   
 8647:       case (int)VarCode::hhat:
 8648:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8649:          *sizeType = sizeof(Vector2);
 8650:          break;      
 8651:       case (int)VarCode::chi:
 8652:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8653:          *sizeType = sizeof(double);
 8654:          break;
 8655:       case (int)VarCode::n1:
 8656:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8657:          *sizeType = sizeof(Node);
 8658:          break;
 8659:       case (int)VarCode::n2:
 8660:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8661:          *sizeType = sizeof(Node);
 8662:          break;                   
 8663:       default:
 8664:          *offset = -1;
 8665:    }
 8666: }
 8667: 
 8668: 
 8669: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8670:    Node *nodes = mesh->localNodeData;
 8671: 
 8672:    *addr = nodes;
 8673:    *sizeNode = sizeof(Node);
 8674: 
 8675:    switch (varCode) {
 8676:       case (int)VarCode::depth:
 8677:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8678:          *sizeType = sizeof(double);
 8679:          break;
 8680:       case (int)VarCode::eta:
 8681:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8682:          *sizeType = sizeof(double);
 8683:          break;
 8684:       case (int)VarCode::x:
 8685:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8686:          *sizeType = sizeof(Vector2);
 8687:          break;
 8688:       case (int)VarCode::z:
 8689:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8690:          *sizeType = sizeof(double);
 8691:          break;
 8692:       case (int)VarCode::kb:
 8693:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8694:          *sizeType = sizeof(int);
 8695:          break;
 8696:       case (int)VarCode::isdry:
 8697:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8698:          *sizeType = sizeof(int);
 8699:          break;         
 8700:       case (int)VarCode::w:
 8701:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8702:          *sizeType = sizeof(double);
 8703:          break;
 8704:       case (int)VarCode::u:
 8705:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8706:          *sizeType = sizeof(Vector2);
 8707:          break;  
 8708:       case (int)VarCode::u_air:
 8709:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8710:          *sizeType = sizeof(Vector2);
 8711:          break;
 8712:       default:
 8713:          *offset = -1;    
 8714:    }  
 8715:    
 8716: }
