 8056: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8057:    Node *nodes = mesh->localNodeData;
 8058: 
 8059:    *addr = nodes;
 8060:    *sizeNode = sizeof(Node);
 8061: 
 8062:    switch (varCode) {
 8063:       case (int)VarCode::depth:
 8064:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8065:          *sizeType = sizeof(double);
 8066:          break;
 8067:       case (int)VarCode::eta:
 8068:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8069:          *sizeType = sizeof(double);
 8070:          break;
 8071:       case (int)VarCode::x:
 8072:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8073:          *sizeType = sizeof(Vector2);
 8074:          break;
 8075:       case (int)VarCode::z:
 8076:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8077:          *sizeType = sizeof(double);
 8078:          break;
 8079:       case (int)VarCode::kb:
 8080:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8081:          *sizeType = sizeof(int);
 8082:          break;
 8083:       case (int)VarCode::isdry:
 8084:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8085:          *sizeType = sizeof(int);
 8086:          break;         
 8087:       case (int)VarCode::w:
 8088:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8089:          *sizeType = sizeof(double);
 8090:          break;
 8091:       case (int)VarCode::u:
 8092:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8093:          *sizeType = sizeof(Vector2);
 8094:          break;         
 8095:       default:
 8096:          *offset = -1;    
 8097:    }  
 8098:    
 8099: }
