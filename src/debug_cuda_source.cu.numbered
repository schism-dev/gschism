 2008: __device__ void lock(int *mutex) {
 2009:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2010: }
 2011: 
 2012: __device__ void unlock(int *mutex) {
 2013:     atomicExch(mutex, 0);
 2014: }
