 8169: __global__ void returnB(double *res) {
 8170:    // Debugging: returns the matrix as a CuPy array
 8171: 
 8172:    const int size = mesh->np;
 8173:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8174:       const Node *node = mesh->localNodeData + idx_node;
 8175: 
 8176:       res[idx_node] = node->qel;
 8177: 
 8178:    }
 8179:    
 8180: }
