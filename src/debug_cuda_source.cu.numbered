 6257:    __global__ void resetBoundaryAreas(void) {
 6258:       // Reset boundary areas and lengths for each segment.
 6259: 
 6260:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6261:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6262:       SIDE_BND(sideBnd);
 6263: 
 6264:       BoundarySegment *segment = sideBnd->segment;
 6265: 
 6266:       segment->carea = 0.0;
 6267:       segment->clen = 0.0;
 6268:  
 6269:    }
 6270: 
 6271:    __global__ void computeBoundaryAreas(void) {
 6272:    // Calculation of cross-section areas and lengths for flow b.c.
 6273: 
 6274:       SIDE_BND(sideBnd);
 6275: 
 6276:       const Side *side = sideBnd->side;
 6277:       BoundarySegment *segment = sideBnd->segment;
 6278: 
 6279:       if (segment->ifltype != 0) {
 6280: 
 6281:          const Node *n1 = side->n1;
 6282:          const Node *n2 = side->n2;
 6283: 
 6284:          const double htot = side->htot2();
 6285: 
 6286:          if (!side->isDry) {
 6287:             atomicAdd(&segment->carea, htot*side->len);
 6288:             atomicAdd(&segment->clen, side->len);
 6289:          }
 6290:       }
 6291: 
 6292:    }
 6293: 
 6294: 
 6295:    __global__ void computeFlowBcVelocities(double time) {
 6296: 
 6297:       SIDE_BND(sideBnd);
 6298: 
 6299:       const Side *side = sideBnd->side;
 6300:  
 6301:       const bool isDry = side->isDry;
 6302:       const bool isLand = sideBnd->segment->isLand;
 6303: 
 6304:    
 6305:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6306: 
 6307:       if (isDry || isLand) return;
 6308: 
 6309:       // For wet sides in open boundaries...
 6310:       const Vector2 n = side->n;
 6311:       const BoundarySegment *segment = sideBnd->segment;
 6312: 
 6313:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6314: 
 6315:       const int ifltype = segment->ifltype;
 6316: 
 6317:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6318:       const Vector2 r_nuth0 = r_uth0*n;
 6319: 
 6320: 
 6321:       if (ifltype == 1 || ifltype == 2) {
 6322:       
 6323:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6324: 
 6325:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6326: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6327:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6328:          
 6329:       } else if (ifltype == -1) { // Flather 1
 6330: 
 6331:          for (int k = 0; k < nvrt; k++) {
 6332: 
 6333:             // uth is the normal vel.; no ramp up
 6334:             const double uth = sideBnd->nuth(k);
 6335:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6336: 
 6337:             sideBnd->ubc[k] += uth*n;
 6338:          }
 6339: 
 6340:       } else if (ifltype == 3 || ifltype == 5) {
 6341:          // vnth0=0 !normal vel.
 6342: 
 6343:          Vector2 r_u1_bar = {0.0, 0.0};
 6344:          // Computes the contribution to the velocity from all tide frequencies
 6345:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6346: 
 6347:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 6348:             const Vector2 umo  = sideBnd->umo(jfr); 
 6349: 
 6350:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6351:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6352:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6353:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6354: 
 6355:          }
 6356: 
 6357: 
 6358:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6359: 
 6360:       } // if (ifltype = 3 || ifltype == 5
 6361: 
 6362: 
 6363: 
 6364:    }
 6365: 
 6366:    __global__ void computeElevationBoundaryConditions(double time) {
 6367:       // Compute elevation essential boundary conditions 
 6368: 
 6369:       NODE_BND(nodeBnd); // Each boundary node.
 6370: 
 6371:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6372: 
 6373:       const Node *node = nodeBnd->node;
 6374:       const BoundarySegment *segment = nodeBnd->segment;
 6375:       const int iettype = segment->iettype;
 6376:       
 6377: 
 6378:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6379:       double eic = 0.0;
 6380:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6381:       else                 eic = 0.0;
 6382: 
 6383:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6384:       const double r_eth = ramp*nodeBnd->eth;
 6385:       double r_eta1_bar = 0.0;
 6386: 
 6387:       // Compute tide elevation
 6388:       if (iettype == 3 || iettype == 5) {   
 6389: 
 6390:          if constexpr(iloadtide==1) { // loading tide
 6391:             assert(false && "Loading tide not implemented");
 6392:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6393:          }
 6394:          
 6395:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6396: 
 6397:             const double efa  = nodeBnd->efa[jfr]; 
 6398:             const double emo  = nodeBnd->emo[jfr]; 
 6399: 
 6400:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6401:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6402:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6403: 
 6404: 
 6405:          } // for jfr
 6406: 
 6407:       } // if iettype
 6408: 
 6409:       switch (iettype) {
 6410:          case 1:
 6411:          case 2:
 6412:          case 4:
 6413:             nodeBnd->elbc = r_eic + r_eth;
 6414:             break;
 6415:          case 3:
 6416:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6417:             break;
 6418:          case 5:
 6419:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6420:             break;
 6421:       } // switch
 6422: 
 6423: 
 6424:       //Add inverse barometric effects
 6425:       if (iettype != 0 && inv_atm_bnd == 1) {
 6426:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6427:       }
 6428: 
 6429:    }
 6430: 
 6431: 
 6432:    __global__ void computeHorizontalViscosity(void) { 
 6433: 
 6434:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6435: 
 6436:       SIDE(side);
 6437: 
 6438:       if (side->isDry) return;
 6439: 
 6440:       for (int k = 0; k < nvrt; k++) {
 6441:          side->nuGradU[k] = {0.0, 0.0};
 6442:       }
 6443: 
 6444:       if constexpr(ihorcon == 1) {
 6445:          for (int k = side->kb; k < nvrt - 1; k++) {
 6446:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6447:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6448:             // By Zhang and Baptista.
 6449: 
 6450:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6451:             // This is a standard discretization of the Laplacian operator.
 6452:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6453:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6454:             // Gamma is hvis_coef0 in the code.
 6455:             // The value of gamma needs to be < 0.5.
 6456: 
 6457:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6458:             // side under consideration in each of the two possible elements that share the side.
 6459:             Vector2 sumU = {0.0, 0.0};
 6460:             for (int l = 0; l < 2; l++) {
 6461:                const Element *elem = side->elems[l];
 6462: 
 6463:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6464: 
 6465:                // Find the local index of the side in the element
 6466:                const int idxSide = elem->sideLocalIdx(side);
 6467: 
 6468:                // Find the two sides that are connected to the side under consideration
 6469:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6470:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6471: 
 6472:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6473: 
 6474:             }
 6475: 
 6476:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6477: 
 6478:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6479:    
 6480:          }
 6481:       }
 6482:       else if constexpr(ihorcon == 2) {
 6483:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6484:       }
 6485: 
 6486: 
 6487:    }
 6488: 
 6489: 
 6490:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6491: 
 6492:       // Set essential boundary conditions 
 6493:       NODE(node); // Each boundary node
 6494:       NodeBoundary *nodeBnd = node->nodeBnd;
 6495:       
 6496:  
 6497:       // Check if this node has essential BC
 6498:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6499: 
 6500:          // Verify BC value is valid
 6501:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6502: 
 6503:        
 6504:          // Set diagonal to 1 and zero off-diagonals
 6505:          for (int j = 0; j <= node->numNodes; j++) {
 6506:                node->coeffRow[j] = 0.0;
 6507:          }
 6508: 
 6509:          *(node->coeffDiag) = 1.0;
 6510: 
 6511: 
 6512:          // Set solution and RHS to BC value
 6513:          node->mX  = nodeBnd->elbc;
 6514:          node->qel = nodeBnd->elbc;
 6515: 
 6516:       } else {
 6517:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6518: 
 6519:          for (int j = 0; j < node->numNodes; j++) {
 6520:                const Node* nbNode = node->nodes[j];
 6521:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6522: 
 6523:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6524:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6525: 
 6526:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6527:                   // Verify neighbor's BC value
 6528:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6529: 
 6530:                   // Subtract contribution to RHS
 6531:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6532:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6533:                }
 6534:          }
 6535: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6536:       }
 6537:    }
 6538: 
