 3668: __device__ __inline__ void Node::updateZCoordData(void) {
 3669: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3670: 
 3671:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3672:    // if (isDry2()) {
 3673:    //    kb = -1;  // XXXXXXXX KKKKK
 3674:    //    return;
 3675:    // }
 3676: 
 3677: 
 3678:    if constexpr(ivcor == 2) {  // SZ coordinates
 3679:       
 3680:       // Compute bottom level index
 3681:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3682:    } 
 3683:    else {  // if (ivcor == 1) Localized sigma
 3684:       // Do nothing
 3685:    }
 3686: 
 3687: 
 3688: }
