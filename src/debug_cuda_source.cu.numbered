 8026: 
 8027: __global__ void computeMatrixProductAndDotProducts() {
 8028:    // Computes A*p, r'Mr and p'Ap
 8029: 
 8030:    // 1) shared buffer: first half for rMr, second for pAp
 8031:    __shared__ double sdata[2*BLOCK_SIZE];
 8032:    double* s_rMr = sdata;
 8033:    double* s_pAp = sdata + BLOCK_SIZE;
 8034: 
 8035:    const int tid = threadIdx.x;
 8036: 
 8037:    double l_pAp = 0.0;
 8038: 
 8039:    s_rMr[tid] = 0.0;
 8040:    s_pAp[tid] = 0.0;
 8041: 
 8042:    // 2) get your node pointer
 8043:    // NODE(node);   
 8044:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8045:    Node *node = &(mesh->localNodeData[idx_node]); 
 8046:       if (idx_node < mesh->np) {
 8047: 
 8048:       const double diag = node->coeffDiag;
 8049:       const double r    = node->mR;
 8050:       const double p    = node->mP;  
 8051: 
 8052:       // apply preconditioner on the fly:
 8053:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8054: 
 8055:       // 4) compute Ap = A.p
 8056:       double Ap = node->coeffDiag * node->mP;
 8057:       for (int j = 0; j < node->numNodes; ++j) {
 8058:          const Node *nbNode = node->nodes[j];
 8059:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8060: 
 8061:       }
 8062: 
 8063:       node->mAp = Ap;
 8064:       
 8065: 
 8066:       // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 8067:       // const double l_rMr = r*Mr;  // r'Mr
 8068:       l_pAp = p*Ap;  // p'Ap
 8069: 
 8070: 
 8071:    }
 8072: 
 8073:    // 6) write into shared mem
 8074:    // s_rMr[tid] = l_rMr;
 8075:    s_pAp[tid] = l_pAp;
 8076: 
 8077:    __syncthreads();
 8078: 
 8079:    // 7) block-wide tree reduction
 8080:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8081:       if (tid < stride)  {
 8082:          s_pAp[tid] += s_pAp[tid + stride];
 8083:       }
 8084:       __syncthreads();
 8085:    }
 8086: 
 8087:    // 8) thread 0 atomically accumulates into the globals
 8088:    // XXX: This is slower than it needs to be, but it is simple and works
 8089:    if (tid == 0) {
 8090:       atomicAdd(pAp, s_pAp[0]);
 8091:    }
 8092: 
 8093: 
 8094: }
 8095: 
 8096: 
 8097: __global__ void updateSolutionAndDotProducts(void) {
 8098:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8099: 
 8100:    const int tid = threadIdx.x;
 8101: 
 8102:    s_rMr[tid] = 0.0;
 8103: 
 8104:    // get node & bounds-check:
 8105:    NODE(node);
 8106: 
 8107:    
 8108:    // Compute alpha
 8109:    const double alpha = (*rMr_old)/(*pAp);
 8110: 
 8111:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8112: 
 8113: 
 8114:    // load scalars
 8115:    const double diag = node->coeffDiag;
 8116:    const double p    = node->mP;
 8117:    const double Ap   = node->mAp;
 8118:    const double x    = node->mX;
 8119:    const double r    = node->mR;
 8120:    
 8121:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8122: 
 8123:    // 1) update solution & residual
 8124:    const double x_new = x + alpha*p;
 8125:    const double r_new = r - alpha*Ap;
 8126:    node->mX = x_new;
 8127:    node->mR = r_new;
 8128: 
 8129:    // 2) apply Jacobi preconditioner on the fly
 8130:    const double Mr_new = r_new/diag;
 8131: 
 8132: 
 8133:    // 3) local contributions for the two dot-products
 8134:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8135: 
 8136:    // 4) write into shared-mem
 8137:    s_rMr[tid] = l_rMr;
 8138: 
 8139:    __syncthreads();
 8140: 
 8141: 
 8142:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8143:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8144:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8145:       __syncthreads();
 8146:    }
 8147: 
 8148:    // 6) thread 0 atomically folds into the global accumulators
 8149:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8150: 
 8151: 
 8152: }
 8153: 
 8154: 
 8155: __global__ void updateSearchDirection() {
 8156: 
 8157:     NODE(node);
 8158: 
 8159:     // recompute z on-the-fly
 8160:     const double z = node->mR / node->coeffDiag;
 8161:     const double p = node->mP;
 8162: 
 8163:     const double beta = (*rMr_new)/(*rMr_old);
 8164: 
 8165: 
 8166:     // p =z + beta*p
 8167:     node->mP = z + beta*p;
 8168: 
 8169: }
 8170: 
 8171: __global__ void initializeScalars(double *scalars) {
 8172: 
 8173:    // These point to a cupy array in the host code
 8174:    rMr_old = scalars + 0;
 8175:    rMr_new = scalars + 1;
 8176:    pAp     = scalars + 2;
 8177: }
 8178: 
 8179: __global__ void initializePreconditionedResidual(void) {
 8180: 
 8181:     __shared__ double s_rMr[BLOCK_SIZE];  
 8182: 
 8183:     s_rMr[threadIdx.x] = 0.0;
 8184: 
 8185:     NODE_ALL(node, valid);
 8186:     const int tid = threadIdx.x;
 8187:     // For the first iteration:
 8188:     // 1. Initial solution x = 0 (already set)
 8189:     // 2. Initial residual r = b (stored in qel)
 8190:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8191: 
 8192: // XXX we should use the guess solution here    
 8193: 
 8194:     double l_rMr = 0.0;
 8195:     if (valid) {
 8196:       // Set initial residual r = b (from qel)
 8197:       node->mR = node->qel;
 8198: 
 8199:       // Compute z = M^-1 * r (preconditioned residual)
 8200:       const double z = node->mR / node->coeffDiag;
 8201: 
 8202:       // Set initial search direction p = z
 8203:       node->mP = z;
 8204: 
 8205:       // Initialize other variables needed for CG
 8206:       node->mX = 0.0;  // Initial solution
 8207:       node->mAp = 0.0; // Will be computed in first iteration
 8208: 
 8209: 
 8210:       // Computes the first r'Mr (reduction)
 8211:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8212:     }
 8213:     // 4) write into shared-mem
 8214:     s_rMr[tid] = l_rMr;
 8215: 
 8216:     __syncthreads();
 8217: 
 8218: 
 8219:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8220:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8221:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8222:         __syncthreads();
 8223:     }
 8224: 
 8225:     // 6) thread 0 atomically folds into the global accumulators
 8226:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8227: 
 8228:     *rMr_old = 0.0;
 8229:     *pAp = 0.0;
 8230: }
 8231: 
 8232: 
 8233: 
 8234: 
 8235: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 8236:    // Get the value of a variable from an element
 8237:    // varName is the name of the variable to get
 8238:    // var is the array to store the value
 8239:    // k is the vertical level index of the variable to get
 8240: 
 8241:    ELEM(elem);
 8242:    
 8243:    int idx = elem->idx;
 8244:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8245: 
 8246:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8247:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 8248:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 8249:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 8250:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 8251:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 8252:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 8253:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 8254:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 8255:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 8256:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 8257:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 8258:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 8259:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 8260:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8261:       
 8262:    
 8263: }
 8264: 
 8265: 
 8266: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8267:    // Get the value of a variable from an node
 8268:    // varName is the name of the variable to get
 8269:    // var is the array to store the value
 8270:    // k is the vertical level index of the variable to get
 8271: 
 8272:    NODE(node);
 8273:    
 8274:    int idx = node->idx;
 8275:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8276: 
 8277:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8278:    
 8279:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8280:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8281:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 8282:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8283:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8284:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8285:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8286:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8287:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8288:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8289:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8290:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 8291:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8292:    
 8293:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8294:       
 8295:    
 8296: }
 8297: 
 8298: 
 8299: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8300:    // Get the value of a variable from an side
 8301:    // varName is the name of the variable to get
 8302:    // var is the array to store the value
 8303:    // k is the vertical level index of the variable to get
 8304:    SIDE(side);
 8305:    
 8306:    int idx = side->idx;
 8307:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8308: 
 8309:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8310:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8311:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8312:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8313:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8314:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8315:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8316:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8317:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8318:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8319:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8320:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8321:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8322:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8323:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8324:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8325:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8326:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 8327:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8328:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8329:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8330:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8331:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8332:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8333:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8334:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8335:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8336:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8337:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8338:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8339:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8340:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8341:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8342:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8343:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8344:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8345: }
