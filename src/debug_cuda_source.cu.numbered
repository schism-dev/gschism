 4251:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4252: 
 4253:       NODE_BND(nodeBnd);
 4254: 
 4255:       Node *node = nodeBnd->node;
 4256: 
 4257:       node->ETP = 0.0;
 4258: 
 4259:       for (int j=0; j<ntip; j++) {
 4260: 
 4261:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4262:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4263:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4264: 
 4265:          if constexpr(iloadtide==1) { // loading tide
 4266:             assert(false && "Loading tide not implemented");
 4267:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4268:          }
 4269:          
 4270:       }
 4271:       
 4272:    }
