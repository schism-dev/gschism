 7392: //                     !For outflow open bnd side, estimate mass in (open
 7393: //                     !side cannot be interface side)
 7394: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7395: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7396: //                     endif
 7397: 
 7398: //                     cycle
 7399: //                   endif
 7400: 
 7401: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7402: //                   iweno=.false.  !reset to upwind
 7403: //                   ibnd=isbs(jsj) !global bnd #
 7404: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7405: //                   nwild(1:2)=0
 7406: //                   do ll=1,2 !nodes
 7407: //                     ndo=isidenode(ll,jsj)
 7408: //                     do lll=1,2 !2 possible bnds
 7409: //                       if(isbnd(lll,ndo)==ibnd) then
 7410: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7411: //                         exit
 7412: //                       endif
 7413: //                     enddo !lll
 7414: //                   enddo !ll
