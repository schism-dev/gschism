 7705: __global__ void printMatrix(bool full) {
 7706:    // Debugging: print the matrix
 7707: 
 7708:    const int size = mesh->np;
 7709:    double sum = 0.0;
 7710:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7711:       const Node *node = mesh->localNodeData + idx_node;
 7712:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7713:       for (int j = 0; j < node->numNodes; j++) {
 7714:          Node* nbNode = node->nodes[j];
 7715:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7716:          sum += node->coeffMatrix[j];
 7717:       }
 7718:       if (full) printf("]\n");
 7719: 
 7720: 
 7721:    }
 7722:    if (!full) printf("sum=%lf\n", sum);
 7723: }
