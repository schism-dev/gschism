 3386: 
 3387: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3388:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3389:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3390:    // 
 3391:    // This kernel is called for all nodes.
 3392: 
 3393: 
 3394:    NODE(node1);
 3395: 
 3396: 
 3397:    node1->clearMatrixRow();
 3398:    node1->qel = 0.0;
 3399: 
 3400:    // THIS IS FOR STRUCTURES XXX
 3401:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3402: 
 3403:    
 3404:    for (int j=0; j<node1->numElements; j++) {
 3405:       // For each element connected to the node...
 3406: 
 3407:       Element *elem = node1->elements[j];
 3408: 
 3409:       // Compute the average gravity
 3410:       const double grav3 = elem->mean(&Node::grav2);
 3411: 
 3412:       // Look at the documentation for the description of the terms in the following integrals
 3413: 
 3414:       // Integral I_1 
 3415:       // \bar{\breve{H}} 
 3416:       const double hhatb = elem->mean(&Side::hhat);        
 3417: 
 3418:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3419: 
 3420:       const int id1 = elem->nodeLocalIdx(node1); 
 3421:       const double area = elem->area;
 3422: 
 3423:       if (elem->isTri()) {
 3424: 
 3425:          // To clarify the notation in this section: 
 3426:          //   i stands for the node under consideration (node1)
 3427:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3428:          const int id2 = elem->nxq(1 + id1);
 3429:          const int id3 = elem->nxq(2 + id1);
 3430:          Node *node2 = elem->nodes[id2];
 3431:          Node *node3 = elem->nodes[id3];
 3432: 
 3433:          const Point2 x1 = node1->p;
 3434:          const Point2 x2 = node2->p;
 3435:          const Point2 x3 = node3->p;
 3436: 
 3437:          // integral of phi_i*phi_j
 3438:          const double ipp_ii = (1.0/6.0 )*area;
 3439:          const double ipp_ij = (1.0/12.0)*area;
 3440:          const double ipp_ik = (1.0/12.0)*area;
 3441: 
 3442:          // integral of [(grad phi_i) * (grad phi_j)]
 3443:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3444:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3445:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3446: 
 3447:          // Computes the different components of integral I_1 of each node with respect to node i.
 3448:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3449:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3450:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3451: 
 3452:          node1->addToSparseMatrix(node1, I1_ii);
 3453:          node1->addToSparseMatrix(node2, I1_ij); 
 3454:          node1->addToSparseMatrix(node3, I1_ik);
 3455: 
 3456:       }
 3457:       else { // Quad
 3458:          // XXX IMPLEMENT THIS
 3459:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3460: 
 3461:          // To clarify the notation in this section: 
 3462:          //   i stands for the node under consideration (node1)
 3463:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3464:          const int id2 = elem->nxq(1 + id1);
 3465:          const int id3 = elem->nxq(2 + id1);
 3466:          const int id4 = elem->nxq(3 + id1);
 3467:          Node *node2 = elem->nodes[id2];
 3468:          Node *node3 = elem->nodes[id3];
 3469:          Node *node4 = elem->nodes[id4];         
 3470: 
 3471:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3472:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3473:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3474:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3475:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3476: 
 3477:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3478:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3479:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3480:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3481:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3482: 
 3483:          // Computes the different components of integral I_1 of each node with respect to node i.
 3484:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3485:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3486:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3487:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3488: 
 3489:          node1->addToSparseMatrix(node1, I1_ii);
 3490:          node1->addToSparseMatrix(node2, I1_ij); 
 3491:          node1->addToSparseMatrix(node3, I1_ik);
 3492:          node1->addToSparseMatrix(node4, I1_il);
 3493:   
 3494: 
 3495: 
 3496:       
 3497:       } 
 3498: 
 3499:  
 3500:       // Integral I_4
 3501:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3502:       // Where
 3503:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3504: 
 3505:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3506:       // of U over the element.
 3507:       Vector2 Umean = {0.0, 0.0};
 3508:       for (int m=0; m<elem->i34; m++) {      
 3509:          const Side *side = elem->sides[m];
 3510: 
 3511:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3512:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3513:       }
 3514:       Umean = Umean/elem->i34;
 3515: 
 3516:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3517: 
 3518:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3519:       const double I_4_1 = dot(gradPhi_1, Umean);
 3520: 
 3521:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3522:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3523:      
 3524:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3525: 
 3526:       // Additional terms 
 3527:       double vnorm = 0.0;
 3528:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3529:          Vector3 ubed;
 3530:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3531: 
 3532:          Vector3 gradP = {0.0, 0.0, 1.0};
 3533:          for (int m=0; m < elem->i34; m++) {
 3534:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3535:            gradP += toVector3(gradP_2D, 0.0);
 3536:          }   
 3537:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3538:       } // imm==2
 3539: 
 3540:       if (elem->isTri()) {
 3541:          for (int l=0; l<3; l++) {
 3542:             double fac;
 3543: 
 3544:             Node *node = elem->nodes[l];
 3545: 
 3546:             fac = (node == node1) ? 2.0 : 1.0;
 3547:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3548:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3549:            
 3550:          }
 3551: 
 3552: 
 3553:          if (!elem->isDry) {
 3554:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3555: 
 3556:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3557: 
 3558:          }
 3559: 
 3560:       } // isTri
 3561:       else { // isQuad
 3562:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3563:          // for (int l=0; l<4; l++) {
 3564:          //   const Node *node = elem->nodes[l];
 3565: 
 3566:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3567:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3568: 
 3569:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3570:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3571:          // }
 3572: 
 3573:       } // isQuad
 3574: 
 3575: 
 3576:      node1->qel += (dt/elem->i34)*elem->vsource;
 3577:       
 3578: 
 3579:    } // for all elements connected to the node
 3580:    
 3581: 
 3582:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3583:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3584:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3585:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3586:       // If it is an open boundary node...
 3587: 
 3588:       // At least one open bnd side, maybe two
 3589:       for (int l=0; l<2; l++) { 
 3590: 
 3591:          // Gets each of the sides sharing the node. 
 3592:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3593: 
 3594:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3595:          
 3596: 
 3597:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3598:          if (sideBnd != nullptr) {
 3599:             // If the side is on a boundary...
 3600: 
 3601:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3602: 
 3603:             // Get the boundary segment
 3604:             const BoundarySegment *sideSegment = sideBnd->segment;
 3605:             const Side *side = sideBnd->side;
 3606: 
 3607:             // Integral I_3
 3608:             if (sideSegment->ifltype != 0) {
 3609:             // Natural or Flather b.c.
 3610: 
 3611:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3612:                // especially for Flather b.c.
 3613:                double ri3 = 0.0;
 3614:                if (!side->isDry) {
 3615:                   // If the side is not dry
 3616:                   
 3617:                   // Computes the side flux of (uth, vth)
 3618:                   double Vn = 0.0;
 3619:                   for (int k = side->kb; k<nvrt-1; k++) {
 3620:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3621:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3622: 
 3623:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3624:                   }
 3625: 
 3626:                   ri3 = 0.5*side->len*Vn;
 3627:                }
 3628: 
 3629:                if (sideSegment->ifltype == -1) { // Flather 1
 3630: 
 3631:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3632:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3633: 
 3634:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3635:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3636:                   
 3637:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3638:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3639: 
 3640:                } 
 3641:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3642:                   // Reset ri3
 3643:                   ri3 = 0.0;
 3644: 
 3645:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3646: 
 3647:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3648: 
 3649:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3650:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3651: 
 3652:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3653:                   node1->addToSparseMatrix(node1, con0*2.0);
 3654:                   node1->addToSparseMatrix(node2, con0);
 3655: 
 3656:                } // if Flather or Discharge
 3657: 
 3658: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3659:                node1->qel -= thetai*dt*ri3;
 3660: 
 3661: 
 3662:             } // I_3
 3663:           
 3664: 
 3665:             // Integral I_5
 3666:             if(!side->isDry) {
 3667: 
 3668:                const double Unbar = dot(side->U, side->n);
 3669:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3670: 
 3671:             } // I_5
 3672: 
 3673:          } // if is boundary side
 3674: 
 3675:       } // for l
 3676: 
 3677:    } // if isbnd
 3678: 
 3679: 
 3680: }
 3681: 
 3682: 
 3683: 
 3684: extern "C" {
 3685:    __global__ void rollUpElevation(void) {
 3686: 
 3687:       NODE(node);
 3688: 
 3689:       node->eta1 = node->eta2;
 3690: 
 3691:    }
 3692: 
 3693: 
 3694:    __global__ void backtrackAllNodes(void) {
 3695: 
 3696:       // max/min # of sub-divisions
 3697:       const int ndelt_max = max(1.0, dt/dtb_min);
 3698:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3699: 
 3700:       // Removed all references to swild98 XXX
 3701:       // swild98=0.d0 !init
 3702: 
 3703: 
 3704:       SIDE(side);
 3705: 
 3706:       const int kb = side->kb;
 3707: 
 3708: 
 3709:       // Initialize btrack velocities to the actual velocities at the side 
 3710:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3711: 
 3712:       if (side->isDry) return;
 3713: 
 3714: 
 3715:       // Checks that at least one element is not dry
 3716:       const Element *elem1 = side->elems[0];
 3717:       const Element *elem2 = side->elems[1];
 3718: 
 3719: 
 3720:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3721:       
 3722:       // XXXXXX
 3723:       // !swild_tmp to store global coord. of the starting side
 3724:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3725:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3726:       // !Use sframe2 
 3727:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3728: 
 3729: 
 3730:       for (int k = kb; k < nvrt; k++) {
 3731:       //  Initialize (xt,yt,zt), nnel and vel.
 3732:       //  For ics=2, the coordinates are in local frames
 3733:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3734: 
 3735: 
 3736:          const int iadvf = side->iadv();  // Advection flag
 3737: 
 3738:          Point3 xt;
 3739:          if constexpr(ics==1) {
 3740:             xt = side->center3D(k); 
 3741:          }
 3742:          else // lat/lon; in side lat/lon frame
 3743:          {
 3744:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3745:          // XXX IMPLEMENT THIS
 3746:       //          xt=0.d0
 3747:       //          yt=0.d0
 3748:       //          !centroid coord. for nudging
 3749:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3750:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3751:          }  // ics
 3752: 
 3753: 
 3754: 
 3755:          // If on land or open boundary...
 3756:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3757:          
 3758:          const double vmag = length(side->u2[k]);
 3759: 
 3760:          if (vmag <= velmin_btrack) {
 3761:             // No activity 
 3762: 
 3763:             side->btu[k] = side->u2[k];
 3764:             
 3765:          } else {  // do btrack
 3766: 
 3767:             // Compute number of sub-divisions based on local gradients 
 3768:             // XXX IS THIS NECESSARY?
 3769:             double suma = 0.0;
 3770:             int icount = 0;
 3771:             for (int ii=0; ii<2; ii++) {
 3772: 
 3773:                const Element *elem = side->elems[ii];
 3774:                  
 3775:                if (elem == nullptr) continue;
 3776: 
 3777:                icount++;
 3778: 
 3779:                // Not strictly along z; in ll frame for ics=2
 3780: 
 3781:                double utmp[4];
 3782:                double vtmp[4];
 3783:                for (int jj = 0; jj < elem->i34; jj++) {
 3784: 
 3785:                   const Node *node = elem->nodes[jj];
 3786: 
 3787:                   if constexpr(ics==1) {
 3788:                      utmp[jj] = node->u2[k].x;
 3789:                      vtmp[jj] = node->u2[k].y;  
 3790:                   } else {
 3791:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3792:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3793:                   }
 3794:                } // for jj
 3795: 
 3796:                const Vector2 grad_u = elem->grad2(utmp); 
 3797:                const Vector2 grad_v = elem->grad2(vtmp);
 3798: 
 3799:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3800:             } // for ii
 3801: 
 3802:             assert(icount > 0 && "Impossible 77");
 3803: 
 3804:             // '4' is somewhat arbitrary
 3805:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3806: 
 3807:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3808:          
 3809: 
 3810:             Vector3 u_int = {0.0, 0.0, 0.0};
 3811: 
 3812:             side->btrack(k, dt, dtbk, u_int);
 3813:             side->btu[k] = toVector2(u_int);
 3814:                
 3815:          } // if vmag (do backtrack)
 3816: 
 3817:       } // for k=kb,nvrt-1
 3818: 
 3819:    }
 3820: 
 3821: } // extern "C"
 3822: 
 3823: template<int nc>
 3824: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3825: 
 3826: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3827: //
 3828: // a,b,c,rhs: input vectors and are not modified by this program.
 3829: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3830: // rhs is the r.h.s.
 3831: // n: actual rank of the system.
 3832: // rows in u() and rhs();
 3833: // u: output with nc columns (transposed to rows)
 3834: // gam: a working array.
 3835: //
 3836: // NOTES:
 3837: // This is a template function that allows for different numbers of columns in the rhs vector.
 3838: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3839: 
 3840:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3841:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3842: 
 3843:    double bet = b[0];
 3844:    if constexpr (nc == 1) {
 3845:       u[0] = rhs[0]/bet;
 3846:    } else {
 3847:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3848:    }
 3849: 
 3850:    for (int j = 1; j < n; j++) {
 3851:       gam[j] = c[j - 1]/bet;
 3852:       bet = b[j] - a[j]*gam[j];
 3853: 
 3854:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3855: 
 3856:       if constexpr (nc == 1) {
 3857:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3858:       } else {
 3859:          for (int l = 0; l < nc; l++) {
 3860:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3861:          }
 3862:       }
 3863:    }
 3864: 
 3865:    // Back-substitution
 3866:    for (int j = n - 2; j >= 0; j--) {
 3867:       if constexpr (nc == 1) {
 3868:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3869:       } else {
 3870:          for (int l = 0; l < nc; l++) {
 3871:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3872:          }
 3873:       }
 3874:    }
 3875: }
 3876: 
 3877: 
 3878: 
 3879: // Helper function that contains the core algorithm
 3880: template<typename XAccessor, typename YAccessor>
 3881: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3882:                                     double  yp_top, double  yp_bot, 
 3883:                                     CubicSpline &spline) {
 3884:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3885:    // 
 3886:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3887:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3888:    //
 3889:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3890:    // 
 3891:    // Inputs: 
 3892:    //            n: dimension for x etc; # of data pts (>=2);
 3893:    //            getX, getY: functions to access x,y coordinates
 3894:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3895:    //     Output: 
 3896:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3897: 
 3898:    const int n = k2 - k1 + 1;
 3899:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3900: 
 3901:    // Allocate memory for the splines
 3902:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3903:    spline.x   = new double[n];
 3904:    spline.y   = new double[n];
 3905:    spline.yp  = new double[n];
 3906:    spline.ypp = new double[n];
 3907: 
 3908:    for (int k=k1; k<=k2; k++) {
 3909:       spline.x[k] = getX(k);
 3910:       spline.y[k] = getY(k);
 3911:    }
 3912: 
 3913:    // This is to simplify expressions later
 3914:    double *x = spline.x;
 3915:    double *y = spline.y;
 3916: 
 3917:    double *a = nullptr;
 3918:    double *b = nullptr;
 3919:    double *c = nullptr;
 3920:    double *gam = nullptr;
 3921:    double *rhs = nullptr;
 3922:    
 3923: 
 3924:       a = new double[n];   // Lower diagonal
 3925:       b = new double[n];   // Diagonal
 3926:       c = new double[n];   // Upper diagonal
 3927:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3928:       rhs = new double[n]; // Right-hand side
 3929: 
 3930:    for (int k=k1; k<=k2; k++) {
 3931:       if (k == k1) {
 3932:          // Bottom level
 3933:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3934:          b[k] = (x[k+1] - x[k])/3.0;
 3935:          c[k] = b[k]/2.0;
 3936:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3937:       } else if (k == n - 1) {
 3938:          // Top level (surface)
 3939:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3940:          b[k] = (x[k] - x[k-1])/3.0;
 3941:          a[k] = b[k]/2.0;
 3942:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3943:       } else {
 3944:          // Intermediate levels
 3945:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3946:          b[k] = (x[k+1] - x[k-1])/3.0;
 3947:          a[k] = (x[k  ] - x[k-1])/6.0;
 3948:          c[k] = (x[k+1] - x[k  ])/6.0;
 3949:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3950:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3951:       }
 3952:    }
 3953: 
 3954:    // Solve the tridiagonal system
 3955:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3956:    
 3957:    spline.yp[k1] = yp_bot;
 3958:    spline.yp[k2] = yp_top;
 3959: 
 3960:    // Compute rest of 1st derivatives using the splines
 3961:    for (int k=k1+1; k<k2; k++) {
 3962:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3963:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3964:    }
 3965:    
 3966:    delete[] a;
 3967:    delete[] b;
 3968:    delete[] c;
 3969:    delete[] gam;
 3970:    delete[] rhs;
 3971: 
 3972: }
 3973: 
 3974: // Array version
 3975: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3976:                                 double y_top, double y_bot, 
 3977:                                 CubicSpline &spline) {
 3978:    auto getX = [x] (int k) { return x[k]; };
 3979:    auto getY = [y] (int k) { return y[k]; };
 3980:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3981: }
 3982: 
 3983: // Lambda version - allows custom access patterns
 3984: template<typename XFunc, typename YFunc>
 3985: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3986:                                 double y_top, double y_bot,
 3987:                                 CubicSpline &spline) {
 3988:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3989: }
