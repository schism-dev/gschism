 1139: 
 1140: 
 1141:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idxNode = 0,1,2,3)
 1142:    __device__ __forceinline__ Point2 GaussPoint(int idxNode) const {
 1143:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
 1144:        assert(idxNode >= 0 && idxNode < 4 && "GaussPoint: idxNode out of range");
 1145:        const double eta = (idxNode & 1) ? +g : -g;
 1146:        const double xi  = (idxNode & 2) ? +g : -g;
 1147:        return {eta, xi};
 1148:    }  
 1149: 
 1150: 
 1151: 
 1152:    // Shape function Phi at a given point p = (eta,xi), idxNode = node index 0,1,2,3
 1153:    __device__ __forceinline__ double Phi_quad(int idxNode, Point2 p) const {
 1154:       return 0.25*(1.0 + p.x*eta_n(idxNode))*(1.0 + p.y*xi_n(idxNode));
 1155:    }
 1156: 
 1157:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi)
 1158:    __device__ __forceinline__ double dPhi_dxi_quad(int idxNode, Point2 p) const {
 1159:       return 0.25*xi_n(idxNode)*(1.0 + p.x*eta_n(idxNode));
 1160:    }   
 1161: 
 1162:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
 1163:    __device__ __forceinline__ double dPhi_deta_quad(int idxNode, Point2 p) const {
 1164:       return 0.25*(1.0 + p.y*xi_n(idxNode))*eta_n(idxNode);
 1165:    }      
 1166:    
 1167:    __inline__ __device__ double detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1168: 
 1169:    __inline__ __device__ double detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const;
 1170: 
 1171:    __inline__ __device__ double detJ_quad(Point2 p, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const 
 1172:          { return (1.0/4.0)*area + detJ_eta_quad(x0, x1, x2, x3)*p.x+ detJ_xi_quad(x0, x1, x2, x3)*p.y; }
