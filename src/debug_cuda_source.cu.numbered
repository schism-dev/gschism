 1785: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1786:    // Computes the 3D normal vector to the element at level k
 1787:    // Returns the normal vector and the area of the element
 1788: 
 1789:       if (isTri()) {
 1790:          // For triangles...
 1791: 
 1792:          // Gets the normal vector to the element (with a length equal to twice the area)
 1793:          if constexpr(ics==1) {
 1794:             const int kb0 = max(k, nodes[0]->kb);
 1795:             const int kb1 = max(k, nodes[1]->kb);
 1796:             const int kb2 = max(k, nodes[2]->kb);
 1797: 
 1798:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1799:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1800:             
 1801:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1802:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1803:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1804:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1805: 
 1806:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1807:             area3D = 0.5*len;
 1808: 
 1809:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1810: 
 1811:             return {nx/len, ny/len, nz/len};
 1812: 
 1813:            
 1814:          }
 1815:          else {  // lat/lon
 1816:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1817:             return {0.0, 0.0, 0.0};
 1818: 
 1819:          } // if ics
 1820:       }
 1821:       else {
 1822:          // For quads...
 1823: 
 1824:          assert(false && "Element normal vector: quads not yet implemented");
 1825:          return {0.0, 0.0, 0.0};
 1826: 
 1827: 
 1828:       }
 1829:    }
 1830: 
 1831: /**
 1832:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1833:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1834:    If the segment is completely inside the element, then it returns true.
 1835: 
 1836:    This function assumes:
 1837:    - The initial point is on a side of the element. 
 1838:    - Its position is given by parameter t in the range [0,1].
 1839:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1840:       intersects the element (elements are convex).
 1841: 
 1842:    To find the intersection point, this function does the following:
 1843:    - it finds the intersection of the line segment with all the element side lines,
 1844:       except for the one that contains the initial point.
 1845:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1846:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1847:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1848:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1849:       track segment is almost parallel to the element side line.
 1850: 
 1851:    Inputs:
 1852:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1853:    @param x2, y2: other end of the line segment
 1854: 
 1855:    Outputs:
 1856:    @param side:  side that intersects the line segment (input and output)
 1857:    @param nextElement (output): element that contains the intersection point
 1858:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1859:    @param zint (input/output): Vertical coordinate of the intersection point
 1860: 
 1861:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1862:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1863:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1864: 
 1865:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1866:    (Delta) being zero.
 1867: 
 1868:    The intersection2 point happens when:
 1869:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1870:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1871:    
 1872:    Assumption: the 4 points (including those of the side segment) are different.
 1873:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1874:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1875:    If true, (xIntersect,yIntersect) is the intersection.				
 1876:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1877: **/
 1878: 
 1879: 
 1880: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1881:                                               double &t, double& tIntersect) {
 1882:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1883:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1884: 
 1885:    double closest_intersect_t = 1e10;
 1886:    bool found_intersection = false;
 1887: 
 1888:    for (int i = 0; i < i34; i++) {
 1889: 
 1890:       Side *side2 = sides[i];
 1891: 
 1892:       // (x3,y3)-(x4,y4) is the element side line
 1893:       const Point2 x3 = side2->n1->p;
 1894:       const Point2 x4 = side2->n2->p;
 1895: 
 1896:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1897:       const double delta = cross(x2 - x1, x3 - x4);
 1898: 
 1899:       if (abs(delta) > 0) {
 1900: 
 1901:          const double delta1 = cross(x3 - x1, x3 - x4);
 1902:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1903: 
 1904:          // Solves the two linear equations for tt1 and tt2
 1905:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1906:          const double tt2 = delta2/delta;
 1907: 
 1908:          if (tt1 >= -small2 && tt2 >= -small2 && tt2 <= 1.0 + small2 && tt1 <= 1.0 + small2) {
 1909:             closest_intersect_t = min(closest_intersect_t, tt1);
 1910:             side = side2;
 1911:             nextElement = side->otherElem(this);
 1912:             t = clamp(tt2, 0.0, 1.0);
 1913:             tIntersect = clamp(tt1, small, 1.0-small);
 1914:             found_intersection = true;
 1915:          }
 1916: 
 1917:          assert(false && "Parallel segments should not happen under the new code");
 1918:       
 1919:       }
 1920:       else {  // parallel segments
 1921: 
 1922:          assert(false && "Parallel segments should not happen under the new code");
 1923:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1924:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1925: 
 1926:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1927:          const double dist = dot(x1 - x3, side2->n);
 1928:          if (abs(dist) < small*length(x3 - x4)) {
 1929:             const double2 unitarySide = normalize(x4 - x3);
 1930:             const double len = dot(x2 - x1, unitarySide);
 1931:             t = t + len;
 1932:             t = max(0.0, min(t, 1.0));
 1933:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1934: 
 1935: 
 1936:             // tIntersect = max(small, min(tt1, 1.0-small));
 1937:             // t = tt2;
 1938:             found_intersection = true;
 1939:          }
 1940:       }
 1941: 
 1942: 
 1943:    }
 1944: 
 1945: 
 1946:    assert(found_intersection && "No intersection found");
 1947: 
 1948:    // found_intersection should always be true, since we checked all the sides.  
 1949:    return found_intersection;
 1950: }
 1951: 
 1952: 
 1953: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1954:                                              Point3 &xt, double zint, Vector3 &u_int) {
 1955: 
 1956:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1957:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 1958:    // curElement.
 1959: 
 1960:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1961:    // And uses this velocity instead to continue the tracking.
 1962: 
 1963:    // computes the intersection point in cartesian coordinates
 1964:    if (tt<0.0 || tt>1.0) printf("XXXXXXX tt = %.17g\n", tt);
 1965:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 1966: 
 1967:    // Nudges the point to the barycenter of the element. 
 1968:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1969:    // next segment intersects the element sides. 
 1970:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 1971: 
 1972: 
 1973:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1974:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1975:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1976:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1977: 
 1978:    // If the side is an open boundary, the tangential velocity is set to zero.
 1979:    if (nextSide->isBnd()) vtan = 0.0;
 1980: 
 1981:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1982:    const double us = vtan*nextSide->t().x;
 1983:    const double vs = vtan*nextSide->t().y;
 1984:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);  //  XXXX Why not use the side's velocity?
 1985: 
 1986:    
 1987:    // The end of this tracking segment is now the intersection point.
 1988:    xt = {intersection.x, intersection.y, zint};
 1989: 
 1990: 
 1991:    u_int = {us, vs, ws};
 1992:    
 1993: }
 1994: 
 1995: /**
 1996:  * Tracks a particle through elements and vertical levels in the mesh.
 1997:  * 
 1998:  * @param x0,y0,z0     Starting position coordinates
 1999:  * @param xt,yt,zt     Target position coordinates
 2000:  * @param dtb          Time step for tracking
 2001:  * @param u_int        Initial velocity components
 2002:  * @param nextElem     Starting/resulting element index
 2003:  * 
 2004:  * @return Status code of type trackExitCodes
 2005:  * 
 2006:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2007:  * of the details are different. The idea is that the code requires less branches and is better fit
 2008:  * for GPU execution.
 2009:  * 
 2010:  * The main ideas here are:
 2011:  * - The starting point is expected to be in the starting element.
 2012:  * - since the starting point is inside the element, there are only two cases: 
 2013:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2014:  *     (b) it does not and (xt,yt) is already in the starting element.
 2015:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2016:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2017:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2018:  * - tt1 can be positive or negative. We only consider the positive values.
 2019:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2020:  * - The next intersection will occur at the smallest positive tt1.
 2021:  * - This intersection will be the next (x0,y0) position.
 2022:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2023:  *   of getting stuck in a loop.
 2024:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2025:  *   was found.
 2026:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2027:  */
 2028: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2029:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2030:                                                        const Side *origSide) {
 2031:                                                             
 2032:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2033:    // else to do. This means that the full step occurred within the current element.
 2034:    assert(!isDry && "Starting element is dry");
 2035:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2036: 
 2037:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2038:       assert(!isDry && "Target point is inside a dry element");
 2039: 
 2040:       interpolateVelocities(xt, u_int);
 2041: 
 2042:       nextElem = this;
 2043: 
 2044: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2045:       return true;
 2046:    }
 2047: 
 2048: 
 2049:    assert(containsPoint(toPoint2(x0)) && "XXXX Starting point is not inside the element");
 2050: 
 2051:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2052:    
 2053:    // const int MAX_ITERATIONS = 1000;
 2054:    
 2055:    double t;
 2056:    Side *nextSide = nullptr;
 2057:    double tIntersect = 1e10;
 2058: 
 2059: 
 2060:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2061:    // (x0,y0) is inside the element but the target point is not.
 2062:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2063:    assert(found_intersection && "No intersection found at %d");
 2064: 
 2065:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2066:    if (t<0.0 || t>1.0) printf("XXXXXXX t = %.17g\n", t);
 2067:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2068: 
 2069:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2070:    if (nextElem != nullptr && !nextElem->isDry) nextElem->nudgeToBarycenter(xtmp);
 2071:    
 2072: 
 2073:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2074:    xt = {xtmp.x, xtmp.y, zint};
 2075: 
 2076:    // if the tracking segment goes out of water (either dry or edge boundary)
 2077:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2078: 
 2079: 
 2080:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2081: 
 2082: 
 2083:       // When this happens, the backtracking stops.
 2084:       dt = time_rm;
 2085: 
 2086:       // In this cases, the next element is again the current element.
 2087:       nextElem = this;
 2088:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2089:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2090:       return true;    
 2091:    }
 2092: 
 2093: 
 2094:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2095:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2096:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2097: 
 2098:    nextElem->interpolateVelocities(xt, u_int); 
 2099: 
 2100:    assert(nextElem != this && "Next element is the same as the current element");
 2101: 
 2102:    return true;
 2103: }
 2104: 
 2105: 
 2106: __inline__ __device__ double Element::computeSignedArea(void) const {
 2107:    // Compute the area of the element
 2108: 
 2109:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2110: 
 2111:    // In the quad case we need to add the area of the other triangle.
 2112:    if (isQuad()) {
 2113:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2114:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2115:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2116:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2117: 
 2118:       res += ar1;
 2119:    }
 2120: 
 2121:    return res;
 2122: }
 2123: 
 2124: 
 2125: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2126:                                                                 (nodes[1]->isDry2()) ||
 2127:                                                                 (nodes[2]->isDry2()) ||
 2128:                                                                 (i34==4 && nodes[3]->isDry2());
 2129: }
 2130: 
 2131: __inline__ __device__ double Element::detJ_eta(void) const {
 2132:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2133:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2134: }
 2135: 
 2136: __inline__ __device__ double Element::detJ_xi(void) const {
 2137:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2138:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2139: }
 2140: 
 2141: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2142:    // In boundary sides, the element 1 is nullptr
 2143:    return side->elems[1] == nullptr; 
 2144: }
 2145: 
 2146: 
 2147: 
 2148: /**
 2149:    Compute the shape coordinates of the point (xt,yt) in the element.
 2150:    @param xt (input): x-coordinate of the point
 2151:    @param shpCoords (output): shape coordinates of the point
 2152:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2153:    @return true if the point is inside the element, false otherwise
 2154: **/
 2155: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2156:                                             bool fixNegshpCoord) const {
 2157: 
 2158:    // Compute the shape coordinates of the point xt in the element.
 2159:    if (i34==3) {
 2160:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2161:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2162:       // and in this case, the pt will be nudged into the element
 2163:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2164:       // from the local frame, so use additional check.
 2165: 
 2166:       Point2 x0, x1, x2;
 2167: 
 2168:       if constexpr(ics==1) {
 2169:          x0 = nodes[0]->p;
 2170:          x1 = nodes[1]->p;
 2171:          x2 = nodes[2]->p;
 2172:       }
 2173:       else // lat/lon
 2174:       {
 2175:          Error("Not implemented yet");
 2176:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2177:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2178:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2179:       }
 2180: 
 2181:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2182:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2183:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2184:       shpCoords[3] = 0.0;
 2185: 
 2186:       const double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2187:       const bool res = (tmpmin >= -small);     
 2188: 
 2189:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2190:       // then we fix the negative shape coordinates.
 2191:       if ((tmpmin < 1.0e-4) && fixNegshpCoord) {
 2192: 
 2193:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2194:          // keeping the sum of the shape coordinates equal to 1.
 2195:          // I have tested and compared the new algorithm with the old one, and they give
 2196:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2197:          // The new algorithm should be faster since it is branchless.
 2198:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2199:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2200:          
 2201:          shpCoords[0] = (shpCoords[0] + a)*b;
 2202:          shpCoords[1] = (shpCoords[1] + a)*b;
 2203:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2204: 
 2205:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2206:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2207:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2208:          }
 2209: 
 2210:          // Update the point coordinates for the new shape coordinates
 2211:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2212:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2213:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2214: 
 2215:       }
 2216: 
 2217:       // Check if the point is inside the element
 2218:       return res;      
 2219:    }
 2220:    else {
 2221:       Error("Not implemented yet");
 2222: #ifdef QUADS
 2223:       // Reproject pt in eframe of nel for ics=2
 2224:       if constexpr(ics==1) {
 2225:          xn2 = xt; 
 2226:          yn2 = yt;
 2227:       }
 2228:       else {
 2229:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2230:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2231:       }
 2232: 
 2233:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2234: #endif
 2235:    }
 2236: 
 2237:    assert(false && "computeShapeCoords: should never reach this point");
 2238:    return false;  // Never reached
 2239: 
 2240: }
 2241: 
 2242: 
 2243: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2244: // Convert shape coordinates to cartesian coordinates
 2245: 
 2246:    if (i34 == 3) {
 2247:       // Triangular element
 2248:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2249:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2250:    }
 2251:    else {
 2252:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2253:    }
 2254: 
 2255: }
 2256: 
 2257: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2258:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2259:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2260:    // The formula for the integral is:
 2261:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2262: 
 2263:    printf("intPhiPhi: TEST\n");
 2264: 
 2265:    const Node *n0 = nodes[0];
 2266:    const Node *n1 = nodes[1];
 2267:    const Node *n2 = nodes[2];
 2268:    const Node *n3 = nodes[3];
 2269: 
 2270:    const Vector2 p0 = n0->p;
 2271:    const Vector2 p1 = n1->p;
 2272:    const Vector2 p2 = n2->p;
 2273:    const Vector2 p3 = n3->p;
 2274: 
 2275:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2276:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2277:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2278:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2279: 
 2280:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2281: }
 2282:    
 2283: 
 2284: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2285:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2286:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2287:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2288:    // The formula is also based on the identity:
 2289:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2290:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2291: 
 2292:    printf("intGradPhiGradPhi: TEST\n");   
 2293: 
 2294:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2295: 
 2296:    const double x0 = nodes[0]->p.x;
 2297:    const double y0 = nodes[0]->p.y;
 2298:    const double x1 = nodes[1]->p.x;
 2299:    const double y1 = nodes[1]->p.y;
 2300:    const double x2 = nodes[2]->p.x;
 2301:    const double y2 = nodes[2]->p.y;
 2302:    const double x3 = nodes[3]->p.x;
 2303:    const double y3 = nodes[3]->p.y;
 2304: 
 2305:    double res = 0.0;
 2306:    
 2307:    // Quadrature points in xi and eta coordinates
 2308:    #pragma unroll
 2309:    for (int i = 0; i < 4; i++) {
 2310:       // For each quadrature point...
 2311: 
 2312:       const Point2 p = GaussPoint(i);
 2313:       const double eta = p.x;
 2314:       const double xi  = p.y;
 2315: 
 2316:       // Jacobian entries at the Gauss point p
 2317:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2318:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2319:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2320:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2321: 
 2322:       const double detJ = jacobianDet(p);
 2323:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2324: 
 2325:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2326:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2327:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2328:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2329:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2330: 
 2331:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2332:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2333:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2334:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2335:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2336: 
 2337:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2338:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2339:    }
 2340: 
 2341:    return res;
 2342: }
 2343: 
 2344: 
 2345: /**  Interpolate velocities at a given point (xt,yt,zt)
 2346: 
 2347:    @param xt, yt, zt: coordinates of the point to interpolate
 2348:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2349: 
 2350:    This is done in four steps:
 2351: 
 2352:    1. Find the shape coordinates for the final position in the element.
 2353:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2354:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2355:       z levels at xt, yt at each step.   
 2356:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2357:       horizontally and vertically.
 2358: **/
 2359: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2360:    // Interpolate the velocities at the point xt. 
 2361:    // This function works the same for triangular and quadrilateral elements.
 2362:    double shpCoord[4];
 2363: 
 2364:    // First step is to compute the shape coordinates of (xt,yt)
 2365:    computeShapeCoords(toVector2(xt), shpCoord, true);
 2366: 
 2367:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2368: 
 2369:    // Second step is to find the level that contains zt
 2370:    // Uses a binary search to find the level
 2371:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2372:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2373:    int R = nvrt - 1;
 2374: 
 2375:    // Get the z coordinates at the nodes of the element at the levels L and R
 2376:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2377:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2378:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2379: 
 2380:    double zL = interpolate(shpCoord, zLAtNodes);
 2381:    double zR = interpolate(shpCoord, zRAtNodes);
 2382:    
 2383:    // Interpolates vertically the velocities
 2384:    double wght1, wght2;
 2385:    if (xt.z<=zL) {
 2386:       wght1 = 1.0;
 2387:       wght2 = 0.0;
 2388:       xt.z = zL;
 2389:    }
 2390:    else if (xt.z>=zR) {
 2391:       wght1 = 0.0;
 2392:       wght2 = 1.0;
 2393:       xt.z = zR;
 2394:    }
 2395:    else {
 2396:       // Perform a binary search to find the levels between L and R that contain xt.z
 2397:       while (R - L > 1) {
 2398:          int M = (L + R) / 2.0;
 2399: 
 2400:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2401:          double zM = interpolate(shpCoord, zMAtNodes);
 2402:          if (zM < xt.z) 
 2403:          {
 2404:             L = M;
 2405:             zL = zM;
 2406:          }
 2407:          else 
 2408:          {
 2409:             R = M;
 2410:             zR = zM;
 2411:          }
 2412:       }
 2413:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2414:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2415: 
 2416:       wght2 = (xt.z - zL)/(zR - zL);
 2417:       wght1 = 1.0 - wght2;
 2418: 
 2419:    }
 2420: 
 2421: 
 2422:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2423:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2424: 
 2425:    // Neither of the interpolated velocities should be NaN
 2426:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2427: 
 2428: }
 2429: 
 2430: 
 2431: 
 2432: 
 2433: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2434: 
 2435:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2436:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2437:    const Node *n1 = side->n1;
 2438:    const Node *n2 = side->n2;
 2439: 
 2440:    bool n1_match = (n1->nodeBnd->segment == segment);
 2441:    bool n2_match = (n2->nodeBnd->segment == segment);
 2442: 
 2443:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2444:    if (n1_match && n2_match) {
 2445:       return 0.5;
 2446:    } else if (n1_match) {
 2447:       return 1.0;
 2448:    } else if (n2_match) {
 2449:       return 0.0;
 2450:    }
 2451: 
 2452:    return 0.0;
 2453: }
 2454: 
 2455: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2456: 
 2457: 
 2458: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2459: 
 2460:    const double w1 = getBoundaryArrayValueWeight();
 2461:    const double w2 = 1.0 - w1;
 2462:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2463:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2464: 
 2465:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2466: }
 2467: 
 2468: 
 2469: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2470:    const double w1 = getBoundaryArrayValueWeight();
 2471:    const double w2 = 1.0 - w1;
 2472:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2473:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2474: 
 2475:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2476: 
 2477: }
 2478: 
 2479: 
 2480: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2481:    // Returns the value of the velocity at the side center
 2482:    const double w1 = getBoundaryArrayValueWeight();
 2483:    const double w2 = 1.0 - w1;
 2484:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2485:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2486: 
 2487:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2488: }
 2489: 
 2490: 
 2491: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2492:    // Returns the value of the normal component of the velocity at the side center
 2493:    const double w1 = getBoundaryArrayValueWeight();
 2494:    const double w2 = 1.0 - w1;
 2495:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2496:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2497: 
 2498:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2499: }
 2500: 
 2501: 
 2502: 
 2503: __inline__ __device__ double  Side::x(double t)   const { if (t<0.0 || t>1.0) printf("XX t = %.7g\n", t); assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2504: __inline__ __device__ double  Side::y(double t)   const { if (t<0.0 || t>1.0) printf("YY t = %.7g\n", t); assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2505: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2506: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2507: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2508: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2509:    Vector2 grad = {0.0, 0.0};
 2510:    int count = 0;
 2511: 
 2512:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2513: 
 2514:    // First element
 2515:    if (elems[0] != nullptr && condition(elems[0])) {
 2516:       grad += elems[0]->grad2(field);
 2517:       count++;
 2518:    }
 2519: 
 2520:    // Second element
 2521:    if (elems[1] != nullptr && condition(elems[1])) {
 2522:       grad += elems[1]->grad2(field);
 2523:       count++;
 2524:    }
 2525: 
 2526:    if (count > 0) {
 2527:       grad = grad/count;
 2528:    }
 2529:    
 2530:    return grad;
 2531: }
