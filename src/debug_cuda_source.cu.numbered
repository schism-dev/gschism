  477: 
  478:    int kb;                    // Bottom index of the element
  479:    double area;               // Area of the element
  480:    double ssign[4];           // Sign associated with each side of an element
  481:    double radius;             // Element equivalent radii
  482: 
  483:    Frame frame;
  484: 
  485:    Vector2 gradPhi[4];       // Derivatives of shape functions
  486:    Vector2 gradEta;          // Gradient of free surface elevation
  487:    Vector2 gradPr;           // Gradient of pressure    
  488:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  489: 
  490:    bool isDry;                // True if the element is dry
  491: 
  492:    Vector3 center;            // Element center coordinates
  493:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  494:    double depth;              // Depth at element (min of all nodes)
  495:    double z[nvrt];            // z-coord  (local frame - vertical up)
  496: 
  497:    // Physical information
  498:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  499: 
  500:    static const bool isblock = false;              // Always false
  501: 
  502:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  503:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  504: 
  505:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  506: 
  507:    
  508: 
  509:    double vsource;            // Volumetric source/sink term [m^3/s]
  510: 
  511:    double rho[nvrt];          // Density at each prism center
  512:    double rho_mean[nvrt];     // Mean density at each prism center
  513:    CubicSpline rho_spl;
  514:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  515:    double rho_z[nvrt];        // First derivative of density at each prism center
  516:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  517: 
  518:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  519: 
  520:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  521:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  522: 
  523:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  524:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  525: 
  526:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  527:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  528:       // Find the local index of the node in the element (0,1,2,3)
  529:       int res = __ffs((nodes[0] == node) | 
  530:                      ((nodes[1] == node) << 1) | 
  531:                      ((nodes[2] == node) << 2) | 
  532:                      ((nodes[3] == node) << 3)) - 1;
  533:       
  534:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  535:       return res;
  536:    }
  537: 
  538:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  539:       // Find the local index of the side in the element (0,1,2,3)
  540:       int res = __ffs((sides[0] == side) | 
  541:                      ((sides[1] == side) << 1) | 
  542:                      ((sides[2] == side) << 2) | 
  543:                      ((sides[3] == side) << 3)) - 1;
  544:       
  545:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  546:       return res;
  547:    }
  548: 
  549: 
  550:    __inline__ __device__ int findLevel(double z1, int k) const {
  551:       // Starting at index k, find sequentially the level that contains z
  552: 
  553:       // if z is already betweeen z[k] and z[k+1], return k
  554:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  555:       else if (z1 < z[k]) { 
  556:          // Search for increasing levels
  557:          for (int kk = k; kk < nvrt - 1; kk++) {
  558:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  559:          }
  560:          return nvrt - 1;
  561:       }
  562:       else {
  563:          // Search for decreasing levels
  564:          for (int kk = k; kk > 0; kk--) {
  565:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  566:          }
  567:          return 0;
  568:       }
  569:    }
  570: 
  571:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  572:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  573: 
  574:    // Check if the element is dry using the more up-to-date elevation.
  575:    __inline__ __device__ bool isDry2(void) const;
  576: 
  577:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  578: 
  579:    __inline__ __device__ double computeSignedArea(void) const;
