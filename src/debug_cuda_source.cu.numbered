 5363:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5364: 
 5365:       NODE_BND(nodeBnd);
 5366: 
 5367:       Node *node = nodeBnd->node;
 5368: 
 5369:       node->ETP = 0.0;
 5370: 
 5371:       // For all tidal potential components
 5372:       for (int j=0; j<ntip; j++) {
 5373: 
 5374:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5375: 
 5376:          node->ETP += nodeETP;
 5377: 
 5378:          if constexpr(iloadtide==1) { // loading tide
 5379:             assert(false && "Loading tide not implemented");
 5380:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5381:          }
 5382:          
 5383:       }
 5384: 
 5385:      
 5386:    }
