  748:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  749: 
  750:    // ------------------------------------------------------------------------------------------------
  751:    // These are functions that work on all nodes of the element.
  752:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  753:    //
  754:    // An example of how to use these functions is:
  755:    //   
  756:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  757:    // 
  758:    // Where L is the level at which the field is to be interpolated. The field can be either
  759:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  760:    // There are different versions of getNodalValues for each of these cases.
  761: 
  762:    template<typename T>
  763:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  764:       // Get the values of the field at the nodes of the element
  765:       res[0] = nodes[0]->*field;
  766:       res[1] = nodes[1]->*field;
  767:       res[2] = nodes[2]->*field;
  768:       if (isQuad()) res[3] = nodes[3]->*field;
  769:       else          res[3] = T();
  770:    }
  771: 
  772:    template<typename T>
  773:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  774:       // Get the values of the field at the nodes of the element
  775:       res[0] = (nodes[0]->*field)[level];
  776:       res[1] = (nodes[1]->*field)[level];
  777:       res[2] = (nodes[2]->*field)[level];
  778:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  779:       else          res[3] = T();
  780:    }    
  781: 
  782:    template<typename T>
  783:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  784:       // Get the values of the func at the nodes of the element
  785:       res[0] = (nodes[0]->*func)(level);
  786:       res[1] = (nodes[1]->*func)(level);
  787:       res[2] = (nodes[2]->*func)(level);
  788:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  789:       else          res[3] = T();  // This is 0.0 or a zero vector
  790: 
  791:    }      
  792: 
  793:    template<typename T>
  794:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  795:       // Get the values of the field at the nodes of the element
  796:       res[0] = sides[0]->*field;
  797:       res[1] = sides[1]->*field;
  798:       res[2] = sides[2]->*field;
  799:       if (isQuad()) res[3] = sides[3]->*field;
  800:       else          res[3] = T();
  801:    }
  802: 
  803:    template<typename T>
  804:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  805:       // Get the values of the field at the nodes of the element
  806:       res[0] = (sides[0]->*field)[level];
  807:       res[1] = (sides[1]->*field)[level];
  808:       res[2] = (sides[2]->*field)[level];
  809:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  810:       else          res[3] = T();
  811:    }    
  812: 
  813:    template<typename T>
  814:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  815:       // Get the values of the func at the nodes of the element
  816:       res[0] = (sides[0]->*func)(level);
  817:       res[1] = (sides[1]->*func)(level);
  818:       res[2] = (sides[2]->*func)(level);
  819:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  820:       else          res[3] = T();  // This is 0.0 or a zero vector
  821: 
  822:    }      
  823: 
  824:    template<typename T>
  825:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  826:       T values[4];
  827:       getNodalValues(level, func, values);
  828: 
  829:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  830:    }
  831: 
  832:    template<typename T>
  833:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  834:       T values[4];
  835:       getNodalValues(field, values);
  836:       
  837:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  838:    }
  839: 
  840: 
  841:    template<typename T>
  842:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  843:       T values[4];
  844:       getNodalValues(level, field, values);
  845: 
  846:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  847:    }
  848: 
  849:    template<typename T>
  850:    __device__ T mean(T Node::* field) const {
  851:       T values[4];
  852:       getNodalValues(field, values);
  853: 
  854:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  855: 
  856:       return (values[0] + values[1] + values[2] + values[3])/i34;
  857:    }
  858: 
  859:    template<typename T>
  860:    __device__ T mean(T Side::* field) const {
  861:       T values[4];
  862:       getSideValues(field, values);
  863:       
  864:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  865: 
  866:       return (values[0] + values[1] + values[2] + values[3])/i34;
  867:    }   
  868: 
  869:    template<typename T>
  870:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  871:       T values[4];
  872:       getNodalValues(level, field, values);
  873: 
  874:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  875: 
  876:       return (values[0] + values[1] + values[2] + values[3])/i34;
  877:    }
  878: 
  879:    template<typename T>
  880:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  881:       T values[4];
  882:       getSideValues(level, field, values);
  883:       
  884:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  885: 
  886:       return (values[0] + values[1] + values[2] + values[3])/i34;
  887:    }   
  888: 
  889:    // __device__ double mean(double (Node::*func)(int) const) const {
  890:    //    double values[4];
  891:    //    getNodalValues(level, func, values);
  892:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  893:    // }
  894:    // ------------------------------------------------------------------------------------------------
  895: 
