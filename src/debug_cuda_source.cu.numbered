 7565: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7566:    Element *elems = mesh->localElemData;
 7567: 
 7568:    *addr = elems;
 7569:    *sizeElement = sizeof(Element);
 7570:    switch (varCode) {
 7571:       case (int)VarCode::z:
 7572:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7573:          *sizeType = sizeof(double);
 7574:          break;
 7575:       case (int)VarCode::x:
 7576:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7577:          *sizeType = sizeof(Vector2);
 7578:          break;
 7579:       case (int)VarCode::area:
 7580:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7581:          *sizeType = sizeof(double);
 7582:          break;
 7583:       case (int)VarCode::depth:
 7584:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7585:          *sizeType = sizeof(double);
 7586:          break;
 7587:       case (int)VarCode::radius:
 7588:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7589:          *sizeType = sizeof(double);
 7590:          break;
 7591:       case (int)VarCode::lonlat:
 7592:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7593:          *sizeType = sizeof(double);
 7594:          break;
 7595:       case (int)VarCode::ghat:
 7596:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7597:          *sizeType = sizeof(Vector2);
 7598:          break;
 7599:       case (int)VarCode::kb:
 7600:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7601:          *sizeType = sizeof(int);
 7602:          break;
 7603:       case (int)VarCode::isdry:
 7604:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7605:          *sizeType = sizeof(int);
 7606:          break;            
 7607:       case (int)VarCode::w:
 7608:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7609:          *sizeType = sizeof(double);
 7610:          break;
 7611:       case (int)VarCode::FaceIndices:
 7612:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7613:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7614:          *sizeType = sizeof(Node);
 7615:          break;
 7616:       default:
 7617:          *offset = -1;
 7618:    }
 7619: }
