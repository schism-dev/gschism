 1425:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1426:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1427:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1428:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1429:    
 1430:    const int npgb;  // Global number of horizontal nodes
 1431:    const int negb;  // Global number of elements
 1432:    const int nsgb;  // Global number of sides
 1433: 
 1434:    const int np;   // Local number of horizontal nodes 
 1435:    const int ne;   // Local number of elements
 1436:    const int ns;   // Local number of sides
 1437: 
 1438:    int nbp;  // Local number of boundary nodes
 1439:    int nbs;  // Local number of boundary sides
 1440: 
 1441:    int nEntries;  // Total number of matrix elements
 1442: 
 1443:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1444:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1445:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1446: 
 1447:   
 1448:    // Additional topology information
 1449:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1450:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1451: 
 1452:    BoundarySegment landBoundarySegment;
 1453:    NodeBoundary landBoundaryNode;
