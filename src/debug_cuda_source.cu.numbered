 4280:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4281: 
 4282:       NODE_BND(nodeBnd);
 4283: 
 4284:       Node *node = nodeBnd->node;
 4285: 
 4286:       node->ETP = 0.0;
 4287: 
 4288:       for (int j=0; j<ntip; j++) {
 4289: 
 4290:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4291:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4292:    
 4293:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4294: 
 4295:          if constexpr(iloadtide==1) { // loading tide
 4296:             assert(false && "Loading tide not implemented");
 4297:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4298:          }
 4299:          
 4300:       }
 4301:       
 4302:    }
