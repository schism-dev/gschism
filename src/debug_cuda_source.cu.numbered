 1103: struct Node {
 1104: 
 1105:    // Geometry information
 1106:    int idx;        // Index of the node
 1107:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1108:    int numNodes;   // Number of nodes neighbors of this node
 1109: 
 1110:    Element **elements; // Array of pointers to the elements that share this node
 1111:    int numElements;    // Number of elements that share this node
 1112: 
 1113:    int numSides;       // Number of sides that are connected to this node
 1114: 
 1115:    Point3 p;
 1116:    Vector3 u2[nvrt];
 1117:    double z[nvrt];
 1118:    double lon, lat;
 1119:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1120:    double depth;
 1121: 
 1122:    int kb;       // Bottom index of the node
 1123: 
 1124:    bool isDry;     // True if the node is dry
 1125: 
 1126:    int iadv;     // Advection flag
 1127: 
 1128:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1129:                           // this is nullptr
 1130: 
 1131:    TempVar tmp; // Temporary variable to store different types of variables
 1132: 
 1133:    // Physical information
 1134:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1135:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1136: 
 1137:    double rho[nvrt];     // Density
 1138:    double dfv[nvrt];     // Vertical viscosity
 1139: 
 1140:    double eta1; // Elevation at nodes at previous timestep
 1141:    double eta2; // Elevation at nodes at current timestep
 1142: 
 1143:    double ETP;  // Earth Tidal Potential
 1144: 
 1145:    double pr;    // Air pressure
 1146:    double grav2; // Gravity 
 1147:    
 1148:    Vector2 dav;  // Depth averaged velocity
 1149: 
 1150:    Vector2 tau; // Wind stress vector
 1151: 
 1152:    // Vegetation parameters
 1153:    double veg_h;
 1154:    double veg_nv;
 1155:    double veg_di;
 1156:    double veg_Cd;
 1157:    double veg_h_unbent;
 1158:    double veg_di_unbent;
 1159:    double veg_nv_unbent;
 1160:    double veg_alpha_vert_mean;
 1161:    double veg_alpha0;
 1162:    double veg_alpha3D[nvrt];
 1163: 
 1164:    // Bottom drag parameters
 1165:    double Cd;       // Bottom drag coefficient
 1166:    double rough;    // Bottom roughness length
 1167:    Vector2 tau_bot; // Bottom stress vector
 1168: 
 1169:    double bdef1; // Bottom deformation at previous timestep
 1170:    double bdef2; // Bottom deformation at current timestep
 1171: 
 1172:    double qel; // RHS
 1173:    double coeffDiag; // Diagonal coefficient of the matrix
 1174:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1175: 
 1176:    double mP; // Search direction for conjugate gradient method
 1177:    double mR; // Residual for conjugate gradient method
 1178:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1179:    double mX; // Solution for conjugate gradient method
 1180: 
 1181:    // Meteorological forcing
 1182:    Vector2 u_air;
 1183:    double p_air;
 1184:    double t_air;
 1185:    double q_air;
 1186:    double wind_angle;  // Wind rotation angle
 1187: 
 1188:    __device__ void setWind(Vector2 &u) {
 1189:    // Sets the wind vector taking into account the wind rotation angle
 1190:    
 1191:       const double dir = atan2(-u.x,-u.y);
 1192:       const double speed = length(u);
 1193: 
 1194:       // Calculate new u and v components with added rotation angle
 1195:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1196:    }
 1197: 
 1198:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1199:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1200: 
 1201:    __device__ double sigmaTransitionDepth(void) const;
 1202: 
 1203:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1204:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1205:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1206: 
 1207:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1208: 
 1209:    __device__ void clearMatrixRow(void) {
 1210:       // Clear the matrix row for this node
 1211:       coeffDiag = 0.0;
 1212:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1213: 
 1214:    }
 1215: 
 1216:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1217:       // Add the value to the sparse matrix for this node
 1218:       
 1219:       if (node == this) {
 1220:          coeffDiag += value;
 1221: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1222:       } else {
 1223:          // Search (linearly)the index of the node in the array of nodes
 1224:          // XXX: This is not efficient, see if we can improve this
 1225:          int i;
 1226:          for (i = 0; i < numNodes; i++) {
 1227:             if (nodes[i] == node) {
 1228:                break;
 1229:             }
 1230:          }
 1231:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1232:          coeffMatrix[i] += value;
 1233:       }
 1234:    }
 1235: 
 1236: #ifdef BACKTRACKING
 1237:    __device__ void updateZCoordData() {
 1238:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1239: 
 1240:       // Check if node is wet
 1241:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1242: 
 1243:       if (idry) return;
 1244: 
 1245:       if constexpr(ivcor == 2) {  // SZ coordinates
 1246:          
 1247:          // Compute bottom level index
 1248:          if (depth <= mesh->h_s) {
 1249:                kb = mesh->nzlevels;
 1250:          } else {
 1251:                kb = -1;
 1252:                for (int i = 0; i < mesh->kz-1; i++) {
 1253:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1254:                      kb = i;
 1255:                      break;
 1256:                   }
 1257:                }
 1258:          }
 1259:       } 
 1260:       else if (ivcor == 1) {  // Localized sigma
 1261:          // Do nothing
 1262:       }
 1263: 
 1264:    }
 1265: #endif   
 1266: 
 1267:    __device__ double compZCoord(int k) const;
 1268: 
 1269:    __device__ void updateKb(void);
 1270: 
 1271: 
 1272: 
 1273: };
