 6653:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6654: 
 6655:       SIDE(side);
 6656: 
 6657:       side->U = {0.0, 0.0}; 
 6658:          
 6659:       if(side->isDry) return;
 6660: 
 6661:       // Vertically integrated velocity U
 6662:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6663:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6664:          side->U += side->Dz(k + 1)*uc;  
 6665:       }
 6666: 
 6667:    }
