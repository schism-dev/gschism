 8304: // !===============================================================================
 8305: 
 8306: } // extern "C"
 8307: 
 8308: #ifdef DONTCOMPILE
 8309: __device__ void computeVerticalAdvection(void) {
 8310:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8311: 
 8312:    sdbt(1:2,:,:)=0.d0
 8313: 
 8314:    const Side *side = FROM kernel;
 8315: 
 8316:    if(side->isDry) return;
 8317: 
 8318:    // If side is wet...
 8319: 
 8320: 
 8321:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8322:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8323:    double ws[nvrt] = {} // w @ side
 8324:    int icount = 0;
 8325:    for (int j=0; j<2; j++) {
 8326:       const Element *elem = side->elements[j];
 8327:        
 8328:       if(elem != nullptr) {
 8329:          icount++;
 8330:          for (int k=0; k<nvrt; k++) {
 8331:             ws[k] = ws[k] + elem->w[k];
 8332:          }
 8333:       }
 8334:    }  // for j
 8335: 
 8336:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8337:    ws = ws/icount;
 8338: 
 8339:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8340:    // Splines allow for a smooth transition between vertical levels.
 8341:    // Splines have continuity restrictions at the internal knots, but
 8342:    // we have to provide the 1st derivatives at the endpoints.
 8343:    const int kbs = side->kbs; 
 8344:    
 8345:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8346:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8347:    initCubicSpline(kbs, nvrt, side, ws, up)
 8348: 
 8349:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8350:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8351:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8352: 
 8353:    // Total advection (average onto side)
 8354:    const Node *node1 = side->nodes[0];
 8355:    const Node *node2 = side->nodes[1];
 8356:    for (int k=kbs(i); k<nvrt; k++) {
 8357: 
 8358:       Vector2 bcc1 = node1->bcc[k];
 8359:       Vector2 bcc2 = node2->bcc[k];
 8360:       if constexpr(ics == 2) {
 8361:          // Project the velocities from the node frames to the side frame
 8362:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8363:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8364:       }
 8365: 
 8366:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8367:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8368: 
 8369:    }
 8370: }
 8371: #endif
 8372: 
 8373: 
 8374: extern "C" {
 8375:    __global__ void computeElemAverageGhat(void) {
 8376:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8377: 
 8378:       ELEM(elem);
 8379:       
 8380:       elem->ghat1= {0.0, 0.0};  
 8381: 
 8382:       if constexpr(ihydraulics != 0) {
 8383:          if (nhtblocks > 0 && elem->isblock) return;
 8384:       }
 8385: 
 8386:       
 8387:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8388:       // cff1-3: coefficients for 2D/3D
 8389: 
 8390:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8391:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8392:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8393: 
 8394:       if (elem->isDry) return;
 8395: 
 8396:       // Average of the coefficients
 8397:       double av_cff1 = 0.0;  // av. for cff1
 8398:       double av_cff2 = 0.0;  // av. for cff2
 8399:       double av_cff3 = 0.0;  // av. for cff3
 8400:       double av_df = 0.0;  // av. for H^\alpha / H
 8401:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8402:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8403: 
 8404:       const int i34 = elem->i34;
 8405:       const int kb  = elem->kb;
 8406: 
 8407:       for (int j=0; j<i34; j++) {
 8408:          // For each node and side in the element...
 8409: 
 8410:          const Node *node = elem->nodes[j];
 8411:          const Side *side = elem->sides[j];
 8412: 
 8413:          const double chi      = side->chi;
 8414:          const double veg_c2   = side->veg_c2;
 8415:          const double veg_beta = side->veg_beta;
 8416:          const double veg_h    = side->veg_h();
 8417:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8418: 
 8419:          const Vector2 gradPhi = elem->gradPhi[j];
 8420: 
 8421:          // Node - const in elem
 8422:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8423:          elem->gradPr  += node->pr  *gradPhi;
 8424: 
 8425:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8426: 
 8427:         
 8428:          const double htot  = side->htot2();        // Total depth at the side
 8429:          const double zctr2 = side->zTopCanopy();  
 8430: 
 8431:          double cff1; 
 8432:          double cff2; 
 8433:          double cff3;   
 8434:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8435:          // coefficients applied to 2D/3D case 
 8436:             cff1 = side->hhat/htot;
 8437:             cff2 = 0.0;
 8438:             cff3 = 0.0;
 8439:          } else { //3D
 8440:             //Init for no-veg case
 8441:             cff1 = 1.0;
 8442:             cff2 = 1.0;
 8443:             cff3 = 0.0;
 8444: 
 8445:             if constexpr(iveg != 0) {
 8446:                // Computes coefficients used with vegetation terms G1, G2
 8447:                // cff1, cff3 are used for the first two terms in G1, G2:
 8448:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8449:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8450:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8451:                if(veg_h < 0.99*htot) { // submergent vegetation
 8452:                   cff1 = 1.0;
 8453:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8454:                   cff3 = veg_c;
 8455: 
 8456:                } else { // emergent vegetation
 8457:                   cff1 = 1.0/(1.0 + veg_c2);
 8458:                   cff2 = cff1;
 8459:                   cff3 = 0.0;
 8460: 
 8461:                }
 8462:             } // if iveg
 8463:          } //  2D/3D
 8464: 
 8465:          av_cff1 += cff1/i34;
 8466:          av_cff2 += cff2/i34;
 8467:          av_cff3 += cff3/i34;
 8468:          av_cff2_chi += cff2*chi/i34;
 8469:          av_cff3_chi += cff3*chi/i34;
 8470:          av_df += min(htot, veg_h)/(htot*i34);
 8471: 
 8472: 
 8473:          // btrack values: U^\star, U^{\star\alpha}
 8474:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8475:          Vector2 Ustar       = {0.0, 0.0}; 
 8476:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8477: 
 8478:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8479:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8480:          } else { //3D
 8481:             for (int k = side->kb + 1; k < nvrt; k++) {
 8482:             
 8483:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8484:                Ustar += w2;
 8485: 
 8486:                if constexpr(iveg != 0) {
 8487:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8488:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8489:                        Ustar_alpha += zrat*w2; // XXXX
 8490:                    }
 8491:                }  // if iveg
 8492:             }  // for k
 8493:          }  //2D/3D
 8494: 
 8495:          // If needed, project the side velocities to the element frame
 8496:          if constexpr(ics==2) {
 8497:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8498:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8499:          }
 8500:         
 8501: 
 8502:          // Add btrack & surface stress terms to \breve{G} first
 8503:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8504: 
 8505: 
 8506:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8507:          Vector2 tau    = side->tau();  
 8508:          Vector2 ubstar = side->btu[side->kb + 1];  
 8509: 
 8510:          // If needed, project tau and ubstar to the element frame
 8511:          if constexpr(ics==2) {
 8512:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8513:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8514:          }
 8515: 
 8516:          // Term for surface and bottom stress
 8517:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8518: 
 8519: 
 8520:          // All terms in F,F^\alpha,f_b except baroclinic
 8521:          // F, f_b: all explicit terms excluding vegetation 
 8522:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8523:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8524:          const double coriolis = side->coriolis;
 8525:          Vector2 F  =  coriolis*side->U;  // F_x
 8526:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8527:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8528: 
 8529:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8530:             
 8531:             for (int k = side->kb; k < nvrt; k++) {
 8532:                if (zctr2 > side->zc[k-1]) {
 8533:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8534:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8535:                    Fa +=  coriolis*w2*zrat;
 8536:                } // if zctr2
 8537:             } // k
 8538:          } // iveg
 8539: 
 8540:          // Integrate horizontal viscosity force vertically
 8541:          for (int k=side->kb + 1; k<nvrt; k++) {
 8542:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8543: 
 8544:             F += levelHorVisc;
 8545: 
 8546:             // Vegetation term
 8547:             if constexpr(iveg!=0) {
 8548:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8549:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8550:                   Fa += levelHorVisc*zrat;
 8551:                } 
 8552:             } // if iveg
 8553:          } // for k
 8554: 
 8555:          // Get nu*grad(U) at the side's bottom level
 8556:          Vector2 nuGradU = side->nuGradU[side->kb];
 8557: 
 8558:          fb += nuGradU;
 8559: 
 8560:          // If needed, project vectorsF, fb and Fa to the element frame
 8561:          if constexpr(ics==2) {
 8562:             F    = side->frame.projHorVec(F,    elem->frame);
 8563:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8564:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8565:          } // if ics
 8566: 
 8567:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8568:       } // for j (nodes and sides)
 8569: 
 8570:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8571: 
 8572: 
 8573:       // Finish off terms in F, F^\alpha and f_b
 8574:       const double grav3 = elem->mean(&Node::grav2);
 8575:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8576:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8577:       for (int j=0; j<i34; j++) { 
 8578:          // For each side in the element...
 8579:          const Side *side = elem->sides[j];
 8580:          const double chi = side->chi;
 8581: 
 8582:          const double htot = side->htot2();
 8583:          const double veg_h = side->veg_h();
 8584:          const Vector2 F  = htot*fb;
 8585:          const Vector2 Fa = min(htot, veg_h)*fb;
 8586: 
 8587:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8588:       } // for j
 8589: 
 8590:       // tmp is already in elem frame
 8591:       elem->ghat1 += tmp/i34;
 8592: 
 8593:       // Baroclinic force
 8594:       if constexpr(ibc==0) {
 8595:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8596: 
 8597:          Vector2 Fa = {0.0, 0.0};
 8598:          Vector2 intGradRho = {0.0, 0.0};
 8599:          
 8600:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8601:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8602:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8603: 
 8604:             // \in F [m^2/s/s]
 8605:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8606:          }
 8607: 
 8608:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8609:          const Vector2 F = av_df*Fa; //approx
 8610:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8611: 
 8612:       } // if ibc 
 8613: 
 8614: 
 8615: 
 8616:    } 
 8617: 
 8618: } // extern "C"
 8619: 
 8620: 
 8621: 
 8622: // ------------------------------------------------------------
 8623: // Transport
 8624: // ------------------------------------------------------------
 8625: 
 8626: // GSCHISM transport models using implicit TVD in the vertical, explicit TVD
 8627: 
 8628: void doTransportTVD(double &difnum_max_l) {
 8629: 
 8630: // XXXX USE_DVD not implemented
 8631: 
 8632: // Do upwind and TVD transport
 8633: //
 8634: //   difnum_max_l: max. horizontal diffusion number reached by this process (check stability)
 8635: 
 8636: 
 8637: //       integer, parameter :: iter_back=50 !maximum iterations in implicit part (upwind is used after that)
 8638: 
 8639: // !     Working temporary arrays in this routine
 8640: //       real(rkind), allocatable :: trel_tmp(:,:,:) !tracer @ elements and half levels
 8641: //       real(rkind), allocatable :: flux_adv_hface(:,:) ! original horizontal flux (the local x-driection) 
 8642: //       real(rkind), allocatable :: flux_mod_hface(:,:,:) !limited advective fluxes on horizontal faces
 8643: //       !weno>
 8644: //       real(rkind), allocatable :: trel_tmp0(:,:,:) !tracer @ elements and half levels
 8645: //       real(rkind), allocatable :: trsd_tmp(:,:,:) !tmp concentration on horizontal faces
 8646: //       real(rkind), allocatable :: trsd_tmp0(:,:,:) !tmp concentration on horizontal faces, only used for message-passing
 8647: //       !<weno
 8648: //       real(rkind), allocatable :: up_rat_hface(:,:,:) !upwind ratios for horizontal faces
 8649: 
 8650: 
 8651: //       integer :: iupwind_e(nea) !to mark upwind prisms when TVD is used
 8652: //       real(rkind) :: dtb_min3(ne),buf(2,1),buf2(2,1)
 8653: //       real(rkind) :: flux_mod_v1(nvrt) !coefficient of limited advective fluxes on vertical faces (space)
 8654: //       real(rkind) :: flux_mod_v2(nvrt) !coefficient of limited advective fluxes on vertical faces (time)
 8655: //       real(rkind) :: rrat(nvrt) !upwind ratios for vertical faces (spatial limiter)
 8656: //       real(rkind) :: srat(nvrt) !s-ratio for vertical faces (temporal limiter)
 8657: //       real(rkind) :: phi(nvrt) !spatial limiter 
 8658: //       real(rkind) :: bigv_m(nvrt) !prism volume
 8659: //       real(rkind) :: psi1(nvrt) !time limiter 
 8660: 
 8661: //       real(rkind) :: r_s(nvrt),r_s0(nvrt) !local Courant number
 8662: 
 8663: //       real(rkind) :: psumtr(ntr),delta_tr(ntr),adv_tr(ntr),tmass(ntr),h_mass_in(ntr), &
 8664: //      &alow(nvrt),bdia(nvrt),cupp(nvrt),rrhs(1,nvrt),soln(1,nvrt),gam(nvrt), &
 8665: //      &swild(max(3,nvrt)),swild4(3,2),trel_tmp_outside(ntr),swild5(3)
 8666: //       integer :: nwild(2),ielem_elm(nea),ind_elm(npa)
 8667: 
 8668: //       integer :: istat,i,j,k,kk,l,m,khh2,ie,n1,n2,n3,n4,isd,isd0,isd1,isd2,isd3,j0,je, &
 8669: //                  &nd,it_sub,ntot_v,ntot_vgb,kup,kdo,jsj,jsj0,kb, &
 8670: //                  &kb1,iup,ido,ie01,lev01,in_st,ie02,lev02,in_st2,jj,ll,lll,ndim,kin,iel,ibnd, &
 8671: //                  &ndo,ind1,ind2,nd1,nd2,ibio,iterK,iele_max,iterK_MAX,it_sum1,it_sum2
 8672: //       real(rkind) :: vnor1,vnor2,xcon,ycon,zcon,dot1,sum1,tmp,cwtmp,toth, &
 8673: //                      &time_r,psum,rat,dtbl,dtbl2,dtb,vj,av_df,av_dz,hdif_tmp, &
 8674: //                      &av_h,difnum,cwtmp2,bigv,dt_by_bigv,dtb_by_bigv, &
 8675: //                      &term1,term2,term6,strat1,strat2,denom, &
 8676: //                      &b1,b2,b3,b4,b5,vol
 8677: 
 8678: //       real(rkind) :: ref_flux
 8679: //       logical     :: same_sign, is_land
 8680: // !      logical, save :: first_call
 8681: //       !weno>
 8682: //       real(rkind) :: trsd(2),rctr,ang1,ui,vi,t_out,rk_coef(3) 
 8683: //       real(rkind),allocatable :: wm1(:),wm2(:),wm(:) !weight
 8684: //       real(rkind),allocatable :: tr_min_max(:,:) 
 8685: //       logical :: iweno
 8686: //       integer :: itd_weno       
 8687: 
 8688: //       !character(72) :: ftest  ! Name of debugging file
 8689: //       !integer :: lftest       ! Length of debugging file name
 8690: //       !integer :: iorder !temporary identifier for order of accuracy
 8691: 
 8692:       // Compute total mass of each tracer (for conservation)
 8693:       // if(max_iadjust_mass_consv>0) then
 8694:       //   psumtr=0
 8695:       //   do i=1,ne
 8696:       //     if(idry_e(i)==1) cycle
 8697: 
 8698:       //     do k=kbe(i)+1,nvrt
 8699:       //       vol=(ze(k,i)-ze(k-1,i))*area(i)
 8700:       //       psumtr(1:ntr)=psumtr(1:ntr)+vol*tr_el(1:ntr,k,i)
 8701:       //     enddo !k
 8702:       //   enddo !i=1,ne
 8703:       //   call mpi_allreduce(psumtr,tmass,ntr,rtype,MPI_SUM,comm,ierr)
 8704: 
 8705:       // endif !max_iadjust_mass_consv
 8706: 
 8707: 
 8708: 
 8709: //       allocate(trel_tmp(ntr,nvrt,0:nea),flux_adv_hface(nvrt,nsa),tr_min_max(2,ntr), &
 8710: //               &flux_mod_hface(ntr,nvrt,ns),up_rat_hface(ntr,nvrt,nsa),stat=istat) 
 8711: //       trel_tmp=0.d0
 8712: // !      allocate(psum2(ntr,nvrt,ne))
 8713: //       if(istat/=0) call parallel_abort('Transport: fail to allocate')
 8714: 
 8715: //     For TVD, prepare some arrays for 2-tier ghosts
 8716: 
 8717:       idry_e_2t(1:ne)=idry_e(1:ne)
 8718: 
 8719: 
 8720: 
 8721: !    Modify here 3D velocity for transport (for whatever reason) - make sure volume conservation is not violated
 8722: !     For rewetted elements, tr_el takes the value from last wet step
 8723: 
 8724: 
 8725: !     Compute (pre-limited) horizontal fluxes at all faces (vertical
 8726: !     fluxes done in schism_step)
 8727: 
 8728:       flux_adv_hface=-1.d34 !flags
 8729: 
 8730: 
 8731:       
 8732: 
 8733: 
 8734:    // Horizontal fluxes
 8735:    SIDE(side)
 8736: 
 8737:    const bool isDry = side->isDry();
 8738: 
 8739:    if (isDry) continue;
 8740: 
 8741:    const bool isLand = (side->sideBnd!=nullptr && side->sideBnd->isLand);
 8742:    const int kb = side->kb;
 8743: 
 8744:    for (int k = kb + 1; k < nvrt; k++) {
 8745:    if (isLand) {
 8746:       fluxAdvHFace = 0.0;
 8747:    } else {
 8748:       const Vector2 n = side->n; // normal vector to the side
 8749:       const double area = side->area(k); // Area of the side face.
 8750:       const double vnor1 = dot(n, side->u2[k]);
 8751:       const double vnor2 = dot(n, side->u2[k-1]);
 8752:       const double vnor_c = 0.5*(vnor1 + vnor2);
 8753: 
 8754: 
 8755:       side->fluxAdvHFace = area*vnor_c; 
 8756:    }
 8757: 
 8758:    //   >>do j=1,ns !resident side
 8759:    //      if (idry_s(j)==1) cycle
 8760:    //      is_land=(isdel(2,j)==0.and.isbs(j)<=0)
 8761: 
 8762:    //      do k=kbs(j)+1,nvrt
 8763:    //        if(is_land) then !land
 8764:    //          flux_adv_hface(k,j)=0.d0
 8765:    //        else            
 8766:    //          vnor1=su2(k,j)*snx(j)+sv2(k,j)*sny(j)
 8767:    //          vnor2=su2(k-1,j)*snx(j)+sv2(k-1,j)*sny(j)
 8768:    //          flux_adv_hface(k,j)=(zs(k,j)-zs(k-1,j))*distj(j)*(vnor1+vnor2)/2 !normal * area = flux (in local x-direction)
 8769: 
 8770: 
 8771:    //        endif !is_land
 8772:    //      enddo !k=kbs(i)+1,nvrt
 8773:    //   << enddo !j=1,ns
 8774: 
 8775: 
 8776: 
 8777: 
 8778:    // Mark prisms shallow enough that they will be computed using first-order upwind formulation.
 8779:    elem->computeUse1stOrderUpwind();
 8780: 
 8781: 
 8782: 
 8783: 
 8784: 
 8785:    // Init horizontal mass influx (m^3*concentration) for conservation 
 8786:       h_mass_in(1:ntr)=0 !positive in
 8787: 
 8788: 
 8789: //!-------------------------------------------------------------------------------------
 8790: //       else if(itr_met==3) then !TVD in horizontal
 8791: // !-------------------------------------------------------------------------------------
 8792: 
 8793:       do i=1,ntr
 8794:         flux_mod_hface(i,1:nvrt,1:ns)=flux_adv_hface(1:nvrt,1:ns)
 8795:       enddo !i
 8796: 
 8797:       it_sub=0
 8798:       time_r=dt !time remaining
 8799: 
 8800:       loop11: do
 8801:         it_sub=it_sub+1
 8802: 
 8803: 
 8804: !       Compute flux limiters and modify fluxes
 8805:         !Use h_tvd as a flag to bypass this and other parts for efficiency
 8806:         if(h_tvd<1.d5) then
 8807:           up_rat_hface=-1.d34 !flags
 8808: 
 8809: 
 8810: !         Horizontal limiters
 8811: 
 8812:           do i=1,ns !residents
 8813:             if(idry_s(i)==1) cycle
 8814: 
 8815: !           At least one element is wet
 8816:             up_rat_hface(:,:,i)=0.d0 !-1.d0 !initialize (for below bottom and abnormal cases)
 8817:             if(isdel(2,i)==0.or.(isdel(2,i)/=0.and.idry_e(max(1,isdel(2,i)))==1).or.idry_e(isdel(1,i))==1) cycle
 8818: 
 8819: !           Both elem r wet
 8820:             !Bypass sides with at least 1 'upwind' elem
 8821:             if(iupwind_e(isdel(1,i))/=0.or.iupwind_e(isdel(2,i))/=0) cycle
 8822: 
 8823: !           Leave k=kbs unchanged
 8824:             do k=kbs(i)+1,nvrt !faces
 8825:               if(flux_adv_hface(k,i)<-1.d33) then
 8826:                 write(errmsg,*)'Left out horizontal flux (3):',i,k
 8827:                 call parallel_abort(errmsg)
 8828:               endif
 8829:               if(flux_adv_hface(k,i)>0.d0) then
 8830:                 iup=isdel(1,i); ido=isdel(2,i) !up/downwind prisms
 8831:               else
 8832:                 iup=isdel(2,i); ido=isdel(1,i)
 8833:               endif
 8834: 
 8835:               psum=0.d0 !!sum of original fluxes
 8836:               psumtr(1:ntr)=0.d0 !sum of products (|Q|*(T-T))
 8837:               do j=1,i34(iup)
 8838:                 jsj=elside(j,iup)
 8839:                 ie=ic3(j,iup)
 8840: 
 8841:                 if(ie<0) then !outside 1-tier aug. domain
 8842:                   ie=iabs(ie) !global elem.
 8843: 
 8844: 
 8845: 
 8846:                   ind1=iegl2(2,ie) !local elem. index in 2-tier aug. domain
 8847: 
 8848: 
 8849: 
 8850:                   ie=ind1
 8851:                 endif !ie<0
 8852: 
 8853:                 !idry_e_2t, tr_el are valid up to 2-tier aug.
 8854:                 if(ie/=0) then; if(idry_e_2t(ie)==0.and.k>=kbs(jsj)+1.and.ssign(j,iup)*flux_adv_hface(k,jsj)<0.d0) then
 8855:  
 8856:                   psum=psum+abs(flux_adv_hface(k,jsj))
 8857:                   psumtr(1:ntr)=psumtr(1:ntr)+abs(flux_adv_hface(k,jsj))*(tr_el(1:ntr,k,ie)-tr_el(1:ntr,k,iup))
 8858:                 endif; endif
 8859:               enddo !j
 8860: 
 8861:               do j=1,ntr
 8862:                 tmp=(tr_el(j,k,iup)-tr_el(j,k,ido))*abs(flux_adv_hface(k,i))
 8863:                 if(abs(tmp)>1.d-20) up_rat_hface(j,k,i)=psumtr(j)/tmp
 8864:               enddo !j
 8865: 
 8866: 
 8867:             enddo !k=kbs(i)+1,nvrt
 8868:           enddo !i=1,ns
 8869: 
 8870: // !         Exchange up_rat
 8871: //           call exchange_s3d_tr2(up_rat_hface)
 8872:  
 8873: 
 8874: !         Modified horizontal fluxes
 8875: 
 8876:           do i=1,ns
 8877:             if(idry_s(i)==1.or.isdel(2,i)==0.or.idry_e(isdel(1,i))==1) cycle
 8878:             if(idry_e(isdel(2,i))==1) cycle
 8879:             !Bypass if both elem r upwind (then up_rat_hface=0 on all sides)
 8880:             if(iupwind_e(isdel(1,i))/=0.and.iupwind_e(isdel(2,i))/=0) cycle
 8881: 
 8882: !           Both elements are wet
 8883:             do k=kbs(i)+1,nvrt
 8884:               if(flux_adv_hface(k,i)>0) then
 8885:                 iup=isdel(1,i)
 8886:               else
 8887:                 iup=isdel(2,i)
 8888:               endif
 8889:  
 8890:               delta_tr(1:ntr)=0.d0
 8891:               do j=1,i34(iup)
 8892:                 jsj=elside(j,iup) !inside aug. domain
 8893: !                ie=ic3(j,iup) !not really used
 8894:                 if(k>=kbs(jsj)+1.and.ssign(j,iup)*flux_adv_hface(k,jsj)>0.d0) then !outflow
 8895:                   do jj=1,ntr
 8896:                     rat=up_rat_hface(jj,k,jsj)
 8897: 
 8898:                     if(abs(rat)>1.d-5) then
 8899:                       tmp=flux_lim(rat)/(rat*2.d0)
 8900: 
 8901:                       delta_tr(jj)=delta_tr(jj)+tmp
 8902:                     endif
 8903:                   enddo !jj=1,ntr
 8904:                 endif !outflow
 8905:               enddo !j
 8906: 
 8907:               do j=1,ntr
 8908:                 flux_mod_hface(j,k,i)=flux_adv_hface(k,i)*(1.d0- &
 8909:      &flux_lim(up_rat_hface(j,k,i))/2.d0+ delta_tr(j)) 
 8910:               enddo !j
 8911:             enddo !k=kbs(i)+1,nvrt
 8912:           enddo !i=1,ns
 8913: 
 8914:         endif !flux limiter; h_tvd
 8915: 
 8916: !       Compute sub time step
 8917: !       Strike out \hat{S}^- (including all horizontal and vertical bnds, and where ic3(j,i) is dry)
 8918: !       Caution: \hat{S}^- conditions must be consistent later in the advective flux part!!!!!!
 8919: !       Implicit vertical flux for upwind; explicit for TVD
 8920: 
 8921: !        if(ltvd.or.it_sub==1) then !for upwind, only compute dtb for the first step
 8922:         if(h_tvd<1.d5.or.it_sub==1) then !for upwind in entire domain, only compute dtb for the first step
 8923:           dtbl=time_r !init
 8924:           ie01=0 !element # where the exteme is attained (local)
 8925:           lev01=0 !level #
 8926:           in_st=0 !tracer #
 8927: 
 8928:           dtb_min3(:)=time_r !init
 8929: 
 8930:           ielem_elm=0
 8931: 
 8932:           do i=1,ne
 8933:             if(idry_e(i)==1) cycle
 8934: 
 8935:             dtbl2=huge(1.d0) !init local
 8936:             ie02=0 !element # where the exteme is attained (local)
 8937:             lev02=0 !level #
 8938:             in_st2=0
 8939:             do k=kbe(i)+1,nvrt !prism
 8940:               psumtr(1:ntr)=0.d0 !sum of modified fluxes for all inflow bnds
 8941:      
 8942:               do j=1,i34(i)
 8943:                 jsj=elside(j,i) !resident side
 8944:                 ie=ic3(j,i)
 8945:   
 8946:                 if(k>=kbs(jsj)+1) then
 8947:                   ref_flux = flux_mod_hface(1,k,jsj)
 8948:                   same_sign = (ssign(j,i)*ref_flux)<0.d0
 8949: !!DIR$ IVDEP 
 8950:                   if((ie/=0.and.idry_e(max(1,ie))==0.or.ie==0.and.isbs(jsj)>0).and.same_sign) then !flux_mod(:) same sign as flux_adv
 8951:                     do jj=1,ntr
 8952: 
 8953: 
 8954:                       psumtr(jj)=psumtr(jj)+abs(flux_mod_hface(jj,k,jsj))
 8955:                     enddo !jj
 8956: 
 8957:                   endif !ie
 8958:                 endif !k>=kbs
 8959:               enddo !j
 8960: 
 8961: 
 8962:               vj=area(i)*(ze(k,i)-ze(k-1,i))
 8963: 
 8964:               if(it==46.and.it_sub==1.and.i==58422) write(99,*)k,nplus,vj
 8965: 
 8966:               do jj=1,ntr
 8967:                 if(psumtr(jj)/=0.d0) then
 8968:                   tmp=vj/psumtr(jj)*(1.d0-1.d-6) !safety factor included
 8969: 
 8970: 
 8971:                   if(tmp<dtbl2) then
 8972:                     dtbl2=tmp
 8973:                     ie02=i; lev02=k; in_st2=jj
 8974: 
 8975: 
 8976:                   endif
 8977:                 endif !psumtr
 8978:               enddo !jj
 8979: 
 8980:             enddo !k=kbe(i)+1,nvrt
 8981: 
 8982:             if(ielm_transport/=0) then
 8983:               if(dtbl2<dtb_min_transport) then
 8984:                 ielem_elm(i)=1
 8985:                 dtbl2=dt !unlimited
 8986:               endif
 8987:             endif
 8988:             dtb_min3(i)=dtbl2
 8989: 
 8990: 
 8991: 
 8992: 
 8993:           enddo !i=1,ne
 8994: 
 8995:           dtbl=minval(dtb_min3)
 8996: 
 8997:           buf(1,1)=dtbl; buf(2,1)=real(myrank,rkind)
 8998:           call mpi_allreduce(buf,buf2,1,MPI_2DOUBLE_PRECISION,MPI_MINLOC,comm,ierr)
 8999:           dtb=buf2(1,1)
 9000: 
 9001:         endif !h_tvd.or.it_sub==1; compute dtb
 9002: 
 9003:         dtb=min(dtb,time_r) !for upwind
 9004:         time_r=time_r-dtb
 9005: 
 9006: !       Store last iteration''s S,T
 9007:         trel_tmp(1:ntr,:,1:nea)=tr_el(1:ntr,:,1:nea)
 9008: 
 9009: 
 9010: !$OMP   do reduction(+: h_mass_in)
 9011:         do i=1,ne
 9012:           if(idry_e(i)==1) cycle
 9013: 
 9014: !         Wet elements with wet nodes
 9015:           do k=kbe(i)+1,nvrt
 9016:             bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 9017:             dtb_by_bigv = dtb/bigv
 9018:   
 9019: !           Advective flux
 9020: !           Strike out \hat{S}^- (see above)
 9021:             psumtr(1:ntr)=0.d0 !sum of modified fluxes at all inflow bnds 
 9022: !           Alternative mass conservative form for the advection part (Eq. C32); contribute to rrhs
 9023:             adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 9024: 
 9025: !           Horizontal faces
 9026:             do j=1,i34(i)
 9027:               jsj=elside(j,i) !resident side
 9028:               iel=ic3(j,i)
 9029: 
 9030:               if(iel/=0) then
 9031:                 if(idry_e(iel)==1) cycle
 9032:                 trel_tmp_outside(:)=trel_tmp(:,k,iel)
 9033:               else !bnd side
 9034: 
 9035:                 if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_mod_hface(1,k,jsj)>=0.d0) then
 9036:                   !For outflow open bnd side, estimate mass in (open
 9037:                   !side cannot be interface side)
 9038:                   if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 9039:                     h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 9040:                   endif
 9041: 
 9042:                   cycle
 9043:                 endif
 9044:        
 9045:                 !Open bnd side with _inflow_ or k<kbs(jsj)+1; compute trel_tmp from outside and save it as trel_tmp_outside(1:ntr)
 9046:                 ibnd=isbs(jsj) !global bnd #
 9047:                 !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 9048:                 nwild(1:2)=0
 9049:                 do ll=1,2 !nodes
 9050:                   ndo=isidenode(ll,jsj)
 9051:                   do lll=1,2 !2 possible bnds
 9052:                     if(isbnd(lll,ndo)==ibnd) then
 9053:                       nwild(ll)=isbnd(-lll,ndo) !global index
 9054:                       exit
 9055:                     endif
 9056:                   enddo !lll
 9057:                 enddo !ll
 9058:                 ind1=nwild(1); ind2=nwild(2);
 9059: 
 9060:                 do jj=1,natrm
 9061:                   if(ntrs(jj)<=0) cycle
 9062: 
 9063:                   if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 9064:                     do ll=irange_tr(1,jj),irange_tr(2,jj)
 9065:                       trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 9066:                     enddo !ll
 9067:                   else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 9068:                     do ll=irange_tr(1,jj),irange_tr(2,jj)
 9069:                       trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 9070:                     enddo
 9071:                   else if(itrtype(jj,ibnd)==3) then
 9072:                     do ll=irange_tr(1,jj),irange_tr(2,jj)
 9073:                       tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 9074:                       trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 9075:                     enddo
 9076:                   else if(itrtype(jj,ibnd)==4) then
 9077:                     do ll=irange_tr(1,jj),irange_tr(2,jj)
 9078:                       trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 9079:      &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 9080:      &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 9081:                     enddo
 9082:                   else
 9083:                     write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:'',jj,ibnd
 9084: !'
 9085:                     call parallel_abort(errmsg)
 9086:                   endif !itrtype
 9087:                 enddo !jj
 9088: 
 9089:                 !Tally horizontal mass in fro inflow case
 9090:                 if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 9091:               endif !iel
 9092: 
 9093:               if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_mod_hface(1,k,jsj)<0.d0) then !inflow
 9094:                 do jj=1,ntr
 9095: 
 9096:                   psumtr(jj)=psumtr(jj)+abs(flux_mod_hface(jj,k,jsj))
 9097:                   adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 9098:                 enddo !jj
 9099: 
 9100:               endif !inflow
 9101: 
 9102:               if(h_tvd<1.d5.and.k>=kbs(jsj)+1) then
 9103:                 do jj=1,ntr
 9104:                   adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trel_tmp_outside(jj))* &
 9105:      &flux_lim( up_rat_hface(jj,k,jsj))/2.d0
 9106:                 enddo !jj
 9107:               endif
 9108:             enddo !j=1,i34(i)
 9109: 
 9110: 
 9111:             enddo !jj
 9112: 
 9113:             tr_el(1:ntr,k,i)=adv_tr(1:ntr) 
 9114:           enddo !k=kbe(i)+1,nvrt
 9115: 
 9116: 
 9117:           !Overwrite with ELM value if enabled. The previous sections
 9118:           !are necessary for diagnostics like DVD etc
 9119:           if(ielem_elm(i)/=0) then
 9120:             rat=time_r/dt !time ratio
 9121:             rat=max(0.d0,min(1.d0,rat))
 9122:             do k=kbe(i)+1,nvrt
 9123:               do jj=1,ntr
 9124:                 psumtr(jj)=0.d0
 9125:                 do j=1,i34(i)
 9126:                   jsj=elside(j,i)
 9127:                   n1=isidenode(1,jsj); n2=isidenode(2,jsj)
 9128:                   swild4(1,1)=0.5d0*(tr_nd(jj,k,n1)+tr_nd(jj,k,n2))
 9129:                   swild4(2,1)=0.5d0*(tr_nd(jj,k-1,n1)+tr_nd(jj,k-1,n2))
 9130: 
 9131:                   swild4(1,1)=swild4(1,1)*rat+sdbt(2+jj,max(k,kbs(jsj)),jsj)*(1-rat)
 9132:                   swild4(2,1)=swild4(2,1)*rat+sdbt(2+jj,max(k-1,kbs(jsj)),jsj)*(1-rat)
 9133:                   psumtr(jj)=psumtr(jj)+0.5d0*(swild4(1,1)+swild4(2,1)) 
 9134:                 enddo !j
 9135:               enddo !jj
 9136:               tr_el(1:ntr,k,i)=psumtr(:)/dble(i34(i))
 9137:             enddo !k
 9138:           endif !ielem_elm(i)/=0
 9139: 
 9140: !         Extend
 9141:           do k=1,kbe(i)
 9142:             tr_el(1:ntr,k,i)=tr_el(1:ntr,kbe(i)+1,i)
 9143:           enddo !k
 9144:         enddo !i=1,ne
 9145: 
 9146:       //  Update ghosts
 9147:       //   call exchange_e3d_2t_tr(tr_el)
 9148: 
 9149:         if(time_r<1.d-8) exit loop11
 9150: 
 9151:       end do loop11
 9152: 
 9153: 
 9154:       if(myrank==0) then
 9155:         write(17,*)it,it_sub
 9156:         flush(17)
 9157:       endif
 9158: !-------------------------------------------------------------------------------------
 9159:       endif !itr_met=3,4
 9160:       
 9161: !      write(12,*)'done 1st transport step...'
 9162: 
 9163: 
 9164:       trel_tmp(1:ntr,:,1:nea)=tr_el(1:ntr,:,1:nea)
 9165: 
 9166: !...  2nd step, vertical advection: Fei''s addition
 9167: 
 9168: !      adv_tr(:)=0
 9169:       do i=1,nea 
 9170:         if(idry_e(i)==1) cycle
 9171: 
 9172: !       Wet elements
 9173: 
 9174: !--------------------Parameters that do not change through iterations------------------
 9175: 
 9176:         do k=kbe(i)+1,nvrt !prism
 9177:           bigv_m(k)=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 9178:         enddo !k
 9179: 
 9180: 
 9181:         !--------------------End: parameters that do not change through iterations------------------ 
 9182: 
 9183:         do m=1,ntr !cycle through tracers.
 9184:           !time limiter set to 0 before the first iteration, which will be updated after each iteration
 9185:           iterK=0
 9186:           do !iterations
 9187:             iterK=iterK+1
 9188: 
 9189:             !space limiter
 9190:             rrat(:)=0.d0 !init for F.S., bottom etc
 9191:             phi(:)=0.d0 !init for F.S., bottom etc (also 2D prism)
 9192:             do k=kbe(i)+1,nvrt-1 !intermediate levels (excelude bnds)
 9193:               if(flux_adv_vface(k,m,i)>=0.d0) then
 9194:                 kup=k; kdo=k+1
 9195:               else !if(flux_adv_vface(k,m,i)<0) then
 9196:                 kup=k+1; kdo=k
 9197:               endif
 9198:       
 9199:               psumtr(m)=0.d0 !sum of products (|Q|*(T-T))
 9200: 
 9201:               if(flux_adv_vface(kup,m,i)<0.d0.and.kup/=nvrt) then !inflow at upper face (for up-upwind)
 9202:                 psumtr(m)=psumtr(m)+abs(flux_adv_vface(kup,m,i))*(tr_el(m,kup+1,i)-tr_el(m,kup,i))
 9203:               endif
 9204:               if(flux_adv_vface(kup-1,m,i)>0.d0.and.kup/=kbe(i)+1) then !inflow at lower face
 9205:                 psumtr(m)=psumtr(m)+abs(flux_adv_vface(kup-1,m,i))*(tr_el(m,kup-1,i)-tr_el(m,kup,i))
 9206:               endif
 9207:      
 9208:               tmp=(tr_el(m,kup,i)-tr_el(m,kdo,i))*abs(flux_adv_vface(k,m,i))
 9209:               if(abs(tmp)>1.d-20) rrat(k)=psumtr(m)/tmp !otherwise it remains at 0
 9210: 
 9211:               !phi(k)=max(0.d0,min(1.d0,rrat(k))) !MM
 9212:               phi(k)=max(0.d0,min(1.d0,2.0d0*rrat(k)),min(2.d0,rrat(k))) !SB
 9213:               !phi(k)=(rrat(k)+abs(rrat(k)))/(1.0d0+abs(rrat(k))) !VL
 9214:               !phi(k)=0 !upwind
 9215:             enddo !k
 9216: 
 9217:             !reset to upwind for upwind elem. abnormal cases
 9218:             if(iupwind_e(i)==1.or.iterK==iter_back) phi(:)=0.d0
 9219: 
 9220:             !The _coefficient_ of modified flux (space) at intermediate levels
 9221:             flux_mod_v1(:)=1.d0 !init
 9222:             do k=kbe(i)+1,nvrt-1 !intermediate levels (exclude bnds); k='j' in notes
 9223:               !Find downwind prism 'i'
 9224:               if(flux_adv_vface(k,m,i)<=0.d0) then
 9225:                 kdo=k
 9226:               else !if(flux_adv_vface(k,m,i)>0) then
 9227:                 kdo=k+1
 9228:               endif
 9229:       
 9230:               psum=0.d0
 9231:               do l=0,1 !two vertical faces of downwind prism
 9232:                 if(flux_adv_vface(kdo-l,m,i)*real(1-2*l,rkind)>0.d0) then !outflow
 9233:                   if(abs(rrat(kdo-l))>1.d-6) psum=psum+phi(kdo-l)/rrat(kdo-l)
 9234:                 endif !outflow
 9235:               enddo !l
 9236: 
 9237:               tmp=1.d0+0.5d0*(psum-phi(k))
 9238:               if(tmp<0.d0) then
 9239:                 write(errmsg,*)'TRANS_IMP: mod. flux<0:',ielg(i),k,tmp
 9240:                 call parallel_abort(errmsg)
 9241:               endif !tmp
 9242:               flux_mod_v1(k)=tmp
 9243:             enddo !k
 9244: 
 9245:             
 9246: 
 9247:             !TVD temporal modification
 9248:             !s-ratios, defined at all levels
 9249:             srat=0.d0 !init for bottom & F.S.
 9250:             psi1=0.d0 !init for all first
 9251:             do k=kbe(i)+1,nvrt-1 !intermediate levels (excelude bnds)
 9252:               if(flux_adv_vface(k,m,i)>=0) then
 9253:                 kup=k; kdo=k+1 !prisms
 9254:               else !if(flux_adv_vface(k,m,i)<0) then
 9255:                 kup=k+1; kdo=k
 9256:               endif
 9257: 
 9258:               psum=0.d0 !sum of |Q|*(T-T)
 9259:               if(flux_adv_vface(kdo,m,i)>0.d0) then !outflow at upper face 
 9260:                 psum=psum+abs(flux_adv_vface(kdo,m,i))
 9261:               endif
 9262:               if(flux_adv_vface(kdo-1,m,i)<0.d0.and.kdo/=kbe(i)+1) then !outflow at lower face
 9263:                 psum=psum+abs(flux_adv_vface(kdo-1,m,i))
 9264:               endif
 9265:               psum=psum*(tr_el(m,kdo,i)-trel_tmp(m,kdo,i))
 9266: 
 9267:               tmp=(tr_el(m,kup,i)-trel_tmp(m,kup,i))*abs(flux_adv_vface(k,m,i))
 9268:               if(abs(tmp)>1.d-20) srat(k)=psum/tmp !otherwise it remains at 0
 9269:           
 9270:               !Prep undetermined faces
 9271:               psi1(k)=max(0.d0,min(1.d0,srat(k))) !MM
 9272:               !psi1(k)=max(0.d0,min(1.d0,2.0d0*srat(k)),min(2.d0,srat(k))) !SB
 9273:             enddo !k
 9274: 
 9275:             !For all levels that have a uni-directional upwind prism and (s_rat>0 or bnd), redo psi1
 9276:             do k=kbe(i),nvrt !including bnd now
 9277:               kup=0 !init
 9278:               if(flux_adv_vface(k,m,i)>=0.d0.and.k/=kbe(i)) then
 9279:                 kup=k !prism
 9280:               else if(flux_adv_vface(k,m,i)<0.d0.and.k/=nvrt) then
 9281:                 kup=k+1
 9282:               endif
 9283: 
 9284:               if(kup/=0) then; if(flux_adv_vface(kup,m,i)*flux_adv_vface(kup-1,m,i)>0.d0.and. &
 9285:      &(srat(k)>0.d0.or.k==nvrt.or.k==kbe(i))) then
 9286:                 !flux_adv_vface(k,m,i)/=0 as k is one of kup | kup-1
 9287:                 tmp=2.d0*(1.d0-1.d-4)*bigv_m(kup)/dt/abs(flux_adv_vface(k,m,i)) !>0
 9288:                 if(tmp<=0.d0) call parallel_abort('TRANS_IMP: tmp<=0(1)')
 9289:                 psi1(k)=min(1.d0,tmp) !>0
 9290:               endif; endif !uni-directional
 9291:             enddo !k
 9292:             
 9293:             !Modified flux (time) - at all levels that have a
 9294:             !uni-directional upwind prism
 9295:             flux_mod_v2(:)=-1.d20 !init as flag
 9296:             do k=kbe(i),nvrt !include bnds
 9297:               kup=0 !init
 9298:               if(flux_adv_vface(k,m,i)>=0.d0.and.k/=kbe(i)) then
 9299:                 kup=k
 9300:               else if(flux_adv_vface(k,m,i)<0.d0.and.k/=nvrt) then
 9301:                 kup=k+1
 9302:               endif
 9303: 
 9304:               if(kup/=0) then; if(flux_adv_vface(kup,m,i)*flux_adv_vface(kup-1,m,i)>0.d0) then !uni-directional
 9305:                 !There is exactly 1 inflow face - k is outflow face
 9306:                 kin=2*kup-1-k !inflow face
 9307:                 if(abs(srat(kin))>1.d-10) then
 9308:                   psum=psi1(kin)/srat(kin) !should be >=0
 9309:                 else
 9310:                   psum=0.d0
 9311:                 endif
 9312:                 flux_mod_v2(k)=0.5d0*(psum-psi1(k))*abs(flux_adv_vface(k,m,i))
 9313:               endif; endif !uni-directional
 9314:             enddo !k=kbe(i)+1,nvrt-1
 9315: 
 9316:             !Matrix
 9317:             ndim=nvrt-kbe(i) !# of eqs/unknowns
 9318:             alow=0.d0; bdia=0.d0; cupp=0.d0
 9319:             do k=kbe(i)+1,nvrt !prism
 9320:               kin=k-kbe(i) !eq. #
 9321:               dt_by_bigv = dt/bigv_m(k)
 9322: 
 9323:               !Diffusivity
 9324: 
 9325:               !Advection part
 9326:               denom=1.d0 !denom. of Eq. (5)
 9327:               if(flux_adv_vface(k,m,i)*flux_adv_vface(k-1,m,i)>0.d0) then !uni-directional
 9328:                 if(flux_adv_vface(k,m,i)>0.d0) then !outflow at upper face (including rising F.S.)
 9329:                   if(flux_mod_v2(k)<-1.d10) then !check if flux_mod_v2 has valid values
 9330:                     write(errmsg,*)'TRANS_IMP, flux_mod_v2(1):',it,iterK,m,ielg(i)
 9331:                     call parallel_abort(errmsg)
 9332:                   endif
 9333: 
 9334:                   denom=denom+dt_by_bigv*flux_mod_v2(k)
 9335:                 endif !outflow at upper face
 9336:                 !if(k-1/=kbe(i).and.flux_adv_vface(k-1,m,i)<0) then !outflow at lower
 9337:                 if(flux_adv_vface(k-1,m,i)<0.d0) then !outflow at lower (including sinking bottom)
 9338:                   if(flux_mod_v2(k-1)<-1.d10) then
 9339:                     write(errmsg,*)'TRANS_IMP, flux_mod_v2(2):',it,iterK,m,ielg(i)
 9340:                     call parallel_abort(errmsg)
 9341:                   endif
 9342:                   denom=denom+dt_by_bigv*flux_mod_v2(k-1)
 9343:                 endif !outflow at lower
 9344:               endif !uni-directional
 9345: 
 9346:               if(denom<=0.d0) then
 9347:                 write(errmsg,*)'TRANS_IMP, mod.  flux<=0:',it,iterK,m,ielg(i),k,denom
 9348:                 call parallel_abort(errmsg)
 9349:               endif !denom
 9350: 
 9351:               !Reset to upwind for upwind elem. or abnormal case
 9352:               if(iupwind_e(i)==1.or.iterK==iter_back) then
 9353:                 denom=1.d0
 9354:                 psi1(:)=0.d0 !reset for conservation check
 9355:               endif
 9356: 
 9357:               !DEBUG 
 9358:               !denom=1.d0
 9359: 
 9360:               bdia(kin)=bdia(kin)+denom
 9361:               rrhs(1,kin)=trel_tmp(m,k,i)*denom !# of columns=1 because tracer loop is outer
 9362: 
 9363:               if(k/=nvrt.and.flux_adv_vface(k,m,i)<0.d0) then !inflow at upper face
 9364:                 tmp=dt_by_bigv*abs(flux_adv_vface(k,m,i)*flux_mod_v1(k)) !flux_mod_v1>=0
 9365:                 cupp(kin)=cupp(kin)-tmp
 9366:                 bdia(kin)=bdia(kin)+tmp
 9367:               endif !inflow at upper face
 9368: 
 9369:               if(k-1/=kbe(i).and.flux_adv_vface(k-1,m,i)>0.d0) then !inflow at lower
 9370:                 tmp=dt_by_bigv*abs(flux_adv_vface(k-1,m,i)*flux_mod_v1(k-1))
 9371:                 alow(kin)=alow(kin)-tmp
 9372:                 bdia(kin)=bdia(kin)+tmp
 9373:               endif !inflow at lower
 9374: 
 9375:             enddo !k=kbe(i)+1,nvrt
 9376: 
 9377:             !Other RHS
 9378: 
 9379: 
 9380:             call tridag_sch(nvrt,1,ndim,1,alow,bdia,cupp,rrhs,soln,gam)
 9381: 
 9382:             !check convergence, based on increment
 9383:             term1=sqrt(sum((soln(1,1:ndim)-tr_el(m,kbe(i)+1:nvrt,i))**2.d0))
 9384:             term6=sqrt(sum(tr_el(m,kbe(i)+1:nvrt,i)**2.d0))
 9385:             !update concentration
 9386:             tr_el(m,kbe(i)+1:nvrt,i)=soln(1,1:ndim)
 9387: 1_tvd_imp*term6+eps2_tvd_imp,term6
 9388: 
 9389:             !Calculate strat in prep for exit
 9390:             if(iterK==iter_back-1) strat1=maxval(soln(1,1:ndim))-minval(soln(1,1:ndim))
 9391: 
 9392:             !Done upwind for abnormal cases and exit
 9393:             if(iterK==iter_back.or.term1<=eps1_tvd_imp*term6+eps2_tvd_imp) then
 9394:               !strat2=maxval(soln(1,1:ndim))-minval(soln(1,1:ndim))
 9395:               !DEBUG
 9396:               !write(12,*)'TRANS_IMP, strat loss:',real(strat1),real(strat2),real(strat2-strat1),ielg(i),m,it
 9397: 
 9398: 
 9399:               exit
 9400:             endif !iterK
 9401: 
 9402: 
 9403:           enddo !nonlinear iteration
 9404: 
 9405: 
 9406:         enddo !m: tracers
 9407: 
 9408: !       Extend
 9409:         do k=1,kbe(i)
 9410:           tr_el(:,k,i)=tr_el(:,kbe(i)+1,i)
 9411:         enddo !k
 9412: 
 9413:       enddo !i=1,nea
 9414: 
 9415: !     Finalize DVD
 9416: 
 9417: 
 9418: !     conservation
 9419:       if(max_iadjust_mass_consv>0) then
 9420:         psumtr=0.d0 
 9421:         do i=1,ne
 9422:           if(idry_e(i)==1) cycle
 9423: 
 9424:           do k=kbe(i)+1,nvrt
 9425:             vol=(ze(k,i)-ze(k-1,i))*area(i)
 9426:             psumtr(1:ntr)=psumtr(1:ntr)+vol*tr_el(1:ntr,k,i)
 9427:           enddo !k
 9428:         enddo !i=1,ne
 9429:         call mpi_allreduce(psumtr,adv_tr,ntr,rtype,MPI_SUM,comm,ierr)
 9430:         !Mass 'error' after advection step
 9431:         total_mass_error=adv_tr-tmass-h_mass_in 
 9432: !        if(myrank==0) write(25,*)'mass after 2 steps with correction:',real(time_stamp/86400),adv_tr(1:ntr)+total_mass_error(1:ntr)
 9433:       endif
 9434: 
 9435: !      write(12,*)'done 2nd transport step...'
 9436: 
 9437: !     3rd step: non-advection terms 
 9438: !     Save the final array from previous step as trel_tmp
 9439:       trel_tmp(1:ntr,:,1:nea)=tr_el(1:ntr,:,1:nea)
 9440: 
 9441: 
 9442:       difnum_max_l=0.d0 !max. diffusion number reached by this process (check stability)
 9443: 
 9444:       do i=1,ne
 9445:         if(idry_e(i)==1) cycle
 9446: 
 9447: !       Wet elements with 3 wet nodes
 9448:         ndim=nvrt-kbe(i) !# of eqs/unknowns
 9449:         do m=1,ntr !cycle through tracers
 9450:           ! Vertical movement of POM (by Richard Hofmeister)
 9451:           ! for vertically varying velocities of vertical movement.
 9452:           ! If iwsett=0 (default), set wsett(nvrt|kbe)=0 (actually bypassed below with if) and use wsett(kbe(i)+1:nvrt-1) for
 9453:           ! vertical velocities at whole levels
 9454:           ! Limit wsett to avoid char line out of boundary 
 9455:           do k=kbe(i),nvrt 
 9456:             tmp=0.9*(ze(nvrt,i)-ze(kbe(i),i))/dt !>0; safety factor added
 9457: !Error: to assert
 9458:             if(tmp<=0) call parallel_abort('Transport:tmp<=0')
 9459:             swild(k)=max(-tmp,min(tmp,wsett(m,k,i)))
 9460:           enddo !k
 9461: 
 9462:           !Matrix
 9463:           alow=0.d0; bdia=1.d0; cupp=0.d0
 9464:           do k=kbe(i)+1,nvrt !prism
 9465:             kin=k-kbe(i) !eq. #
 9466:             bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 9467:             dt_by_bigv = dt/bigv
 9468:   
 9469:             if(k<nvrt) then !diffusion & settling terms @ k
 9470:               if(itur==5.and.m>=irange_tr(1,5).and.m<=irange_tr(1,5)) then !1018:itur==5
 9471:                 av_df=sum(dfhm(k,m-irange_tr(1,5)+1,elnode(1:i34(i),i)))/real(i34(i),rkind) !1007
 9472:               else
 9473:                 av_df=sum(dfh(k,elnode(1:i34(i),i)))/real(i34(i),rkind) !diffusivity
 9474:               endif              
 9475:               av_dz=(ze(k+1,i)-ze(k-1,i))/2.d0
 9476:               tmp=area(i)*dt_by_bigv*av_df/av_dz
 9477:               cupp(kin)=cupp(kin)-tmp
 9478:               bdia(kin)=bdia(kin)+tmp
 9479: 
 9480:               if(swild(k)<=0.0d0) then !upwinding for conc
 9481:                 bdia(kin) = bdia(kin) - area(i)*dt_by_bigv*swild(k) !wsett(m,k,i)
 9482:               else
 9483:                 cupp(kin) = cupp(kin) - area(i)*dt_by_bigv*swild(k) !wsett(m,k,i)
 9484:               endif
 9485:             endif !k<nvrt
 9486: 
 9487:             if(k>kbe(i)+1) then !diffusion & settling terms @ k-1
 9488:               if(itur==5.and.m>=irange_tr(1,5).and.m<=irange_tr(1,5)) then !1018:itur==5
 9489:                 av_df=sum(dfhm(k-1,m-irange_tr(1,5)+1,elnode(1:i34(i),i)))/real(i34(i),rkind) !1007
 9490:               else
 9491:                 av_df=sum(dfh(k-1,elnode(1:i34(i),i)))/real(i34(i),rkind)
 9492:               endif
 9493:               av_dz=(ze(k,i)-ze(k-2,i))/2.d0
 9494:               tmp=area(i)*dt_by_bigv*av_df/av_dz
 9495:               alow(kin)=alow(kin)-tmp
 9496:               bdia(kin)=bdia(kin)+tmp
 9497: 
 9498:               if(swild(k-1)<=0.0d0) then
 9499:                 alow(kin) = alow(kin) + area(i)*dt_by_bigv*swild(k-1) !wsett(m,k-1,i)
 9500:               else
 9501:                 bdia(kin) = bdia(kin) + area(i)*dt_by_bigv*swild(k-1) !wsett(m,k-1,i)
 9502:               endif
 9503:             endif !k>kbe(i)+1
 9504: 
 9505:             !Extra terms for sediment at bottom b.c.: \kapp*dT/dz+w_s*T=w_s*T-E
 9506:             if(iwsett(m)==1.and.k==kbe(i)+1) then
 9507:               if(swild(k-1)<0.0d0) then
 9508:                 write(errmsg,*)'TRAN_IMP: wsett<0,',m,k,ielg(i),swild(k-1) !wsett(m,k-1,i)
 9509:                 call parallel_abort(errmsg)   
 9510:               endif
 9511:               bdia(kin)=bdia(kin)+area(i)*dt_by_bigv*swild(k-1) !wsett(m,k-1,i)
 9512:             endif !k==kbe(i)+1
 9513:          
 9514:             !# of column=1 as tracer loop is outside
 9515:             rrhs(1,kin)=trel_tmp(m,k,i)
 9516:             !b.c.
 9517:             if(k==nvrt) then
 9518:               rrhs(1,kin)=rrhs(1,kin)+area(i)*dt_by_bigv*flx_sf(m,i)
 9519:             endif !k==nvrt
 9520: 
 9521:             if(k==kbe(i)+1) then
 9522:               !NOTE: with settling vel., flx_bt=D-E-w_s*T_{kbe+1}, since
 9523:               !in well-formulated b.c., D \approx w_s*T_{kbe+1}. D&E are
 9524:               !deposi. & erosional fluxes respectively
 9525:               rrhs(1,kin)=rrhs(1,kin)-area(i)*dt_by_bigv*flx_bt(m,i)
 9526:             endif !k==kbe(i)+1
 9527: 
 9528:             !Body source
 9529:             rrhs(1,kin)=rrhs(1,kin)+dt*bdy_frc(m,k,i)
 9530: 
 9531: 
 9532:           enddo !k=kbe(i)+1,nvrt
 9533: 
 9534:           call tridag_sch(nvrt,1,ndim,1,alow,bdia,cupp,rrhs,soln,gam)
 9535: 
 9536:           do k=kbe(i)+1,nvrt
 9537:             kin=k-kbe(i)
 9538:             tr_el(m,k,i)=soln(1,kin)
 9539:           enddo !k
 9540: 
 9541: 
 9542:         enddo !m: tracers
 9543: 
 9544:         !Post-proc
 9545:         do k=kbe(i)+1,nvrt
 9546:           if(ihconsv/=0) tr_el(1,k,i)=max(tempmin,min(tempmax,tr_el(1,k,i)))
 9547:           if(isconsv/=0) tr_el(2,k,i)=max(saltmin,min(saltmax,tr_el(2,k,i)))
 9548: 
 9549: 
 9550:         enddo !k
 9551: 
 9552: !       Extend
 9553:         do k=1,kbe(i)
 9554:           tr_el(:,k,i)=tr_el(:,kbe(i)+1,i)
 9555:         enddo !k
 9556: 
 9557:       enddo !i=1,ne
 9558: 
 9559: // !     Update ghosts
 9560: //       call exchange_e3d_2t_tr(tr_el)
 9561: 
 9562: 
 9563: !     Horizontal diffusion as filter
 9564: !     Save the final array from previous step as trel_tmp
 9565:       if(ihdif/=0) then
 9566:         do kk=1,niter_hdif
 9567: !$OMP     parallel default(shared) !private(i,j,k,m,sum1,jsj,iel,nd1,nd2,hdif_tmp)
 9568:           trel_tmp(1:ntr,:,1:nea)=tr_el(1:ntr,:,1:nea)
 9569: 
 9570: 
 9571:           do i=1,ne
 9572:             if(idry_e(i)==1) cycle
 9573:   
 9574:             !Wet elements with wet nodes
 9575:             do m=1,ntr !cycle through tracers
 9576:               do k=kbe(i),nvrt
 9577:                 sum1=0.d0
 9578:                 do j=1,i34(i) !sides
 9579:                   jsj=elside(j,i) !residents
 9580:                   iel=ic3(j,i)
 9581:                   if(iel==0.or.idry_e(max(1,iel))==1) cycle
 9582: 
 9583:                   nd1=isidenode(1,jsj)
 9584:                   nd2=isidenode(2,jsj)
 9585:                   hdif_tmp=(hdif(nd1)+hdif(nd2))/2.d0
 9586:                   if(k>=kbs(jsj)+1) then
 9587:                     sum1=sum1+hdif_tmp*(trel_tmp(m,k,iel)-trel_tmp(m,k,i))
 9588:                   endif !k>=
 9589:                 enddo !j
 9590:             
 9591:                 tr_el(m,k,i)=trel_tmp(m,k,i)+sum1
 9592:               enddo !k
 9593: 
 9594:               !Extend
 9595: !              do k=1,kbe(i)
 9596: !                tr_el(m,k,i)=tr_el(m,kbe(i)+1,i)
 9597: !              enddo !k
 9598:             enddo !m: tracers
 9599:           enddo !i=1,ne
 9600: 
 9601: // !         Update ghosts
 9602: //           call exchange_e3d_2t_tr(tr_el)
 9603: 
 9604:         enddo !kk=1,niter_hdif
 9605:       endif !ihdif/=0
 9606: 
 9607: 
 9608:    }
