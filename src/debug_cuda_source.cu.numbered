 1844: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1845:    // Computes the 3D normal vector to the element at level k
 1846:    // Returns the normal vector and the area of the element
 1847: 
 1848:    if (isTri()) {
 1849:       // For triangles...
 1850: 
 1851:       // Gets the normal vector to the element (with a length equal to twice the area)
 1852:       if constexpr(ics==1) {
 1853:          const int kb0 = max(k, nodes[0]->kb);
 1854:          const int kb1 = max(k, nodes[1]->kb);
 1855:          const int kb2 = max(k, nodes[2]->kb);
 1856: 
 1857:          const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1858:          const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1859:          
 1860:          // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1861:          const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1862:          const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1863:          const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1864: 
 1865:          const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1866:          area3D = 0.5*len;
 1867: 
 1868:          assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1869: 
 1870:          return {nx/len, ny/len, nz/len};
 1871: 
 1872:          
 1873:       }
 1874:       else {  // lat/lon
 1875:          assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1876:          return {0.0, 0.0, 0.0};
 1877: 
 1878:       } // if ics
 1879:    }
 1880:    else {
 1881:       // For quads...
 1882: 
 1883:       assert(false && "Element normal vector: quads not yet implemented");
 1884:       return {0.0, 0.0, 0.0};
 1885: 
 1886: 
 1887:    }
 1888: }
