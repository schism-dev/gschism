 5618: 
 5619:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5620: 
 5621:       SIDE(side);
 5622: 
 5623:       side->U = {0.0, 0.0}; 
 5624:          
 5625:       if(side->isDry) return;
 5626: 
 5627:       // Vertically integrated velocity U
 5628:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5629:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5630:          side->U += side->Dz(k + 1)*uc;  
 5631:       }
 5632: 
 5633:    }
 5634: 
 5635:    __global__ void computeBottomDragVegetation(void) {
 5636:       // UNFINISHED. CHECK THIS:
 5637:       // How many kernels are needed? Why so many for loops?
 5638:       // Is the loop on sides needed?
 5639: 
 5640:       NODE(node);
 5641: 
 5642: 
 5643:       const int    kb      = node->kb;
 5644:       const double htot    = node->htot2(); 
 5645:       
 5646:       if (node->isDry) {
 5647:          // Default values for dry nodes
 5648:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5649:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5650: 
 5651:          return;
 5652:        
 5653:       }
 5654: 
 5655:       // Computes bottom drag Cd based on the selected nchi
 5656:       node->computeBottomDragCd();
 5657:       
 5658: 
 5659: 
 5660:       //   Bottom stress in m^2/s^2
 5661:       if (node->rho[kb + 1] >= -98.0)
 5662:       {
 5663:          const double mag_u = length(node->u2[kb + 1]);
 5664:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5665: 
 5666:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5667:          // !sediment erosion: this part needs more documentation
 5668:       }
 5669:     
 5670: 
 5671: 
 5672:       // Compute vegetation parameters
 5673:       //--------------------------------
 5674: 
 5675:       // SAV constants
 5676:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5677:       constexpr double veg_cfpsi = 0.16;
 5678: 
 5679:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5680:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5681: 
 5682:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5683:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5684:          int kbin = 0; // bin index
 5685:          for (int k = kb; k < nvrt; k++) {
 5686:             // Computes node height above the bottom level
 5687:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5688:             assert(false && "Vertical variation of vegetation not implemented");
 5689: 
 5690:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5691:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5692:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5693:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5694:             // } else {
 5695:             //    // Find the bin at which the current vertical level is
 5696:             //    while (kbin<nbins_veg_vert) {
 5697:             //       const double zn = node->z[kbin];
 5698:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5699:             //          break;
 5700:             //       } // if
 5701:             //       kbin++;
 5702:             //    } // while
 5703:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5704: 
 5705:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5706:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5707:                
 5708:             //    // Linear interpolation of the vegetation parameters
 5709:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5710:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5711:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5712:             // } // if rl10
 5713: 
 5714:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5715: 
 5716:          } // for k
 5717: 
 5718: 
 5719:       } else { // Ganthy (iveg==2)
 5720:       //  Modify canopy height, diameter, and density
 5721: 
 5722:          // Make sure there is vegetation on this node
 5723:          if (node->veg_h_unbent > 0.0) {
 5724:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5725: 
 5726:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5727:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5728:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5729: 
 5730:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5731:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5732:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5733:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5734:          } // if veg_h_unbent
 5735: 
 5736:          for (int k = 0; k < nvrt; k++) {
 5737:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5738:          } // for k
 5739:       
 5740: 
 5741:       } // if iveg
 5742:      
 5743: 
 5744:       // Compute vertical mean of veg_alpha3D
 5745:       if (iveg != 0) {
 5746:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5747:          double sum1=0.0;
 5748:          double sum2=0.0;
 5749:          // Integrate over each level under the canopy...
 5750:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5751:             const double Dz = node->Dz(k);
 5752: 
 5753:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5754:             sum2 += Dz;
 5755: 
 5756:          } // for k
 5757:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5758:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5759: 
 5760:       } // if iveg
 5761: 
 5762:    }
 5763: 
 5764:    __global__ void computeVegetationAndDragParameters(void) {
 5765:       // Computes the vegetation and drag model parameters:
 5766:       // chi, \tilde\chi, beta, \breve{H}
 5767:       
 5768:       SIDE(side);
 5769: 
 5770:       side->hhat = 0.0;
 5771:       side->chi2 = 0.0;
 5772:       side->chi = 0.0;
 5773:       side->veg_c2 = 0.0;
 5774:       side->veg_beta = 0.0;
 5775: 
 5776:       if (side->isDry) return;
 5777: 
 5778:       const double htot = side->htot2();
 5779:       const int    kb   = side->kb;
 5780: 
 5781:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5782: 
 5783:       const double veg_h     = side->veg_h();
 5784:       const double veg_nv    = side->veg_nv();
 5785:       const double veg_c     = side->veg_c();
 5786:       const double veg_beta  = side->veg_beta;
 5787:       const double veg_alpha = side->veg_alpha_vert_mean();
 5788: 
 5789:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5790:       // Velocity magnitude at the bottom level
 5791:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5792:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5793:       side->chi2 = side->Cd()*vmag1;
 5794:       side->chi  = side->chi2;
 5795: 
 5796:       if constexpr(iveg != 0) {
 5797:          const Node *n1 = side->n1;
 5798:          const Node *n2 = side->n2;
 5799:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5800:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5801:       }
 5802: 
 5803:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5804: 
 5805:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5806:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5807:       double magUa = 0.0;
 5808:       if constexpr(iveg != 0) {
 5809:          if (side->is3D() && veg_h > 0.0) {
 5810:             // 3D wet side with veg...
 5811: 
 5812:             double magUa = 0.0;
 5813:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5814:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5815: 
 5816:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5817:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5818:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5819: 
 5820:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5821:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5822: 
 5823:                   // Velocity magnitude at the bottom (l) of the level
 5824:                   const double ul = length(side->u2[k]);
 5825: 
 5826:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5827:                   magUa += Dz*0.5*(uh + ul);
 5828: 
 5829:                } // if HasVegetation
 5830:             } // for k
 5831:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5832: 
 5833:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5834:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5835:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5836:                const double zCpy = side->zTopCanopy();
 5837:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5838:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5839:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5840:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5841:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5842:             } // if isSubmerged
 5843:          } // if is3D
 5844:       } // if iveg   
 5845: 
 5846:       // Computes the friction modified depth, \breve{H} in notes
 5847:       if (side->is2D()) { // 2D
 5848: 
 5849:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5850:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5851: 
 5852:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5853: 
 5854:          side->hhat = htot*htot/fricH; 
 5855: 
 5856:       } else { // 3D
 5857:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5858: 
 5859:          if constexpr(iveg != 0) {
 5860:             
 5861:             if (side->isSubmerged()) { 
 5862:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5863:                side->hhat -= veg_c*Hhat_alpha;
 5864: 
 5865:             } else { // Emergent
 5866:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5867:             }
 5868:          } // if iveg
 5869: 
 5870:          // Enforce positivity for 3D model
 5871:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5872:       } // if 3D
 5873: 
 5874:    }
 5875: 
 5876: 
 5877: 
 5878:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5879:    // Computes the density gradient between two elements, e1 and e2.
 5880:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5881:    // zero in the direction normal to the side. 
 5882:    // 
 5883:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5884:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5885:    //
 5886:    // Input:
 5887:    //    e1: Element
 5888:    //    e2: Neighbor element (or nullptr if boundary)
 5889:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5890:    //    k: Index of the half-level at which the density is interpolated
 5891:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5892:    // 
 5893:    // Output:
 5894:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5895:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5896: 
 5897:       if (e2 == nullptr || e2->isDry) {
 5898:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5899: 
 5900:          Side *side = e1->sides[j];
 5901:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5902:                  
 5903:          if constexpr(ics == 1) {
 5904:             vec = side->n; // Normal vector to the side
 5905:          } else {
 5906:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5907:             // IMPLEMENT THIS XXXXXX
 5908:             // !replace with xel, yel?
 5909:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5910:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5911:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5912:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5913:          } //ics
 5914:                    
 5915:          diffRho = 0.0;
 5916: 
 5917:       } else { //internal and wet
 5918:          if constexpr(ics==1) {
 5919:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5920: 
 5921:             // Vector from e1 to e2
 5922:             vec = e2->center - e1->center;
 5923: 
 5924:          } else { 
 5925:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5926:             // Remember that elem->center is in global coordinates
 5927:             // IMPLEMENT THIS XXXXXX
 5928:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5929:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5930:             //                   alow(j)=xctr2
 5931:             //                   bdia(j)=yctr2
 5932:          } // ics
 5933: 
 5934:          diffRho = rho2 - e1->demeanedDensity(k);
 5935:       }
 5936: 
 5937:    }
 5938: 
 5939:    __global__ void computeDensityCubicSplines(void) {
 5940:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5941: 
 5942:       ELEM(elem);
 5943: 
 5944:       if (elem->isDry) return;
 5945: 
 5946:       const int kb = elem->kb;
 5947: 
 5948:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5949:       if (elem->is2D()) {
 5950:          // In the 2D case, the density is constant at the prism level. 
 5951:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5952:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5953:       } else { //3D
 5954: 
 5955:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5956:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5957:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5958:          ///// XXXX CHECK INDICES!!!!!
 5959:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5960:       } // 2D/3D
 5961: 
 5962:    }
 5963: } // extern "C"
 5964: 
 5965: 
 5966: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5967: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5968: 
 5969:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5970: 
 5971:    const int kb  = elem->kb;
 5972:    const int kb2 = elem2->kb;
 5973: 
 5974:    // z-coordinate of prism of elem
 5975:    const double zp = elem->z_prism(k);
 5976: 
 5977:    double rho = 0.0;
 5978: 
 5979:    if (elem2->is2D()) {
 5980:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5981: 
 5982:    } else {  // 3D
 5983: 
 5984:       // eta_min may be < zmax
 5985:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5986:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5987: 
 5988:       // (Extrapolate density below bottom, we will fix it later)
 5989:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5990:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5991:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5992:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5993:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5994:    } // 2D/3D
 5995:      
 5996: 
 5997:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5998:    // Now we need to fix it.
 5999:    if (elem->z[k] < elem2->z[kb2]) {
 6000:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6001: 
 6002:       // There are two methods to adjust the density at the bottom of the element.
 6003:       // iunder_deep=0: 
 6004:       const double depth1 = abs(elem->z[kb]); // larger depth
 6005: 
 6006:       if (iunder_deep==0) {
 6007: 
 6008:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6009: 
 6010:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6011: 
 6012:       } else { // iunder_deep != 0
 6013: 
 6014:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6015: 
 6016:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6017: 
 6018:          //   Demeaned density at the same z coordinate as
 6019:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6020:          }
 6021: 
 6022:       } // if iunder_deep
 6023:    } // if elem->z[kb] < elem2->z[kb]
 6024: 
 6025:    return rho;
 6026: }
 6027: 
 6028: 
 6029: extern "C" {
 6030:    __global__ void computeDensityGradient(void) {
 6031: 
 6032:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6033:       if constexpr(ibc != 0) return;
 6034: 
 6035:          // Compute the horizontal density gradient at each element.
 6036:       // It works in two steps:
 6037:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6038:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6039:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6040:       //             gradRho.r1 = rho1 - rho0
 6041:       //             gradRho.r2 = rho2 - rho0
 6042:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6043:       // 
 6044:       //  NOTE: We use de-meaned densities.
 6045: 
 6046:       ELEM(elem);
 6047: 
 6048:       if (elem->isDry) return;
 6049: 
 6050:       const int kb  = elem->kb;
 6051:       const int i34 = elem->i34;
 6052: 
 6053:       for (int k = kb + 1; k < nvrt; k++) {
 6054:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6055:          //             gradRho.r1 = rho1 - rho0
 6056:          //             gradRho.r2 = rho2 - rho0
 6057:          int icount = 0;
 6058:          double sumRx = 0.0;
 6059:          double sumRy = 0.0;
 6060:          for (int j1=0; j1<i34; j1++) { 
 6061: 
 6062:             const int j2 = elem->nxq(j1 + 1);
 6063: 
 6064:             // Pairs of consecutive neighbor elements of elem
 6065:             const Element *e1 = elem->nghbElems[j1];
 6066:             const Element *e2 = elem->nghbElems[j2];
 6067: 
 6068:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6069:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6070:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6071: 
 6072:             // Compute the density difference and the vector from elem to e1 and e2
 6073:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6074:             double diffRho1, diffRho2;
 6075:             Vector2 vec1, vec2;
 6076:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6077:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6078: 
 6079:             const double rl1 = length(vec1);
 6080:             const double rl2 = length(vec2);
 6081:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6082: 
 6083:             const double delta = cross(vec1, vec2);
 6084:             const double sintheta = abs(delta)/(rl1*rl2);
 6085: 
 6086:             // To avoid problems, avoid elements with small angle between vectors
 6087:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6088:             const bool validEq = (sintheta > sin_one_deg);
 6089: 
 6090:             if (validEq) {
 6091:                // Solve the system of equations to get the density gradient at elem
 6092:                icount++;
 6093:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6094:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6095:                sumRx += Rx;
 6096:                sumRy += Ry;
 6097:             }
 6098:          } // for j1
 6099: 
 6100:          // Compute the average density gradient at elem
 6101:          if (icount==0) {
 6102:            // Bad mesh quality; bail out with 0 b-cc
 6103:            elem->gradRho[k] = {0.0, 0.0};
 6104:          } else {
 6105:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6106:          }
 6107: 
 6108:       } // for k
 6109: 
 6110:    }
 6111: 
 6112:    __global__ void computeBaroclinicTerm(void) {
 6113:    // Computes the baroclinic term at sides (at half levels).
 6114:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6115:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6116: 
 6117:       if (ibc == 1) return;
 6118: 
 6119:       SIDE(side);
 6120: 
 6121:       if (side->isDry) return;
 6122: 
 6123:       const Element *e1 = side->elems[0];
 6124:       const Element *e2 = side->elems[1]; 
 6125:       const int kb = side->kb;
 6126:       
 6127:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6128: 
 6129:       // interpolates vertically the density gradient of the two elements at the half level/
 6130: 
 6131:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6132:       int k2 = max(kb, nvrt / 2);
 6133: 
 6134:       // Starts the integration at the surface and goes down to the bottom
 6135:       side->bcc[nvrt-1] = {0.0, 0.0};
 6136:       for (int k = nvrt - 2; k >= kb; k--) {
 6137:       // For each prism level (from surface to bottom)...
 6138: 
 6139:          // For both elements, interpolate density gradient at the side's half level.
 6140:          // The gradient at the side is the average of the gradients at the elements.
 6141:          // w1, w2 are used to take into account boundary sides, with just one element.
 6142:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6143:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6144:          const double wsum = w1 + w2;
 6145:          w1 = w1/wsum;
 6146:          w2 = w2/wsum;
 6147:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6148: 
 6149:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6150:          Vector2 gradRho = {0.0, 0.0};
 6151:          if (e1 != nullptr && k > kb) {
 6152:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6153:             
 6154:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6155:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6156:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6157: 
 6158:             // Grad(rho) vertically interpolated at the side's half level
 6159:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6160: 
 6161:             // Projects the element density gradient to the side frame if needed.
 6162:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6163: 
 6164:             // Adds the contribution of the density gradient at the side's half level
 6165:             gradRho += gradRho1*w1;
 6166:          }      
 6167:          if (e2 != nullptr && k > kb) {
 6168:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6169:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6170:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6171:             
 6172:             // Grad(rho) vertically interpolated at the side's half level
 6173:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6174: 
 6175:             // Projects the element density gradient to the side frame if needed.
 6176:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6177: 
 6178:             // Adds the contribution of the density gradient at the side's half level
 6179:             gradRho += gradRho2*w2;
 6180:          }
 6181: 
 6182:          
 6183:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6184:          // multiplied by -rampbc*(g/rho0) 
 6185:          const double grav3 = side->grav3();
 6186:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6187: 
 6188:       } // for
 6189: 
 6190:    }
 6191: 
 6192: 
 6193: 
 6194:    __global__ void computeHorGradientAtSide(void) {
 6195: 
 6196:       // Compute the horizontal density gradient at each element.
 6197:       // It works in two steps:
 6198:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6199:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6200:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6201:       //             gradRho.r1 = rho1 - rho0
 6202:       //             gradRho.r2 = rho2 - rho0
 6203:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6204:       // 
 6205:       //  NOTE: We use de-meaned densities.
 6206: 
 6207:       SIDE(side);
 6208: 
 6209: 
 6210:       if (side->isDry) return;
 6211: 
 6212:       // Computes the gradient of the variables at the side center.
 6213:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6214:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6215:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6216: 
 6217:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6218:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6219:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6220:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6221: 
 6222:    }
 6223: 
 6224: 
 6225:    __global__ void solveMomentumEquations(double time) {
 6226: 
 6227:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6228:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6229: 
 6230:       SIDE(side);
 6231: 
 6232:       if (side->isDry) 
 6233:       {
 6234:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6235: 
 6236:          return;
 6237:       }
 6238: 
 6239:       const Node *n1 = side->n1;
 6240:       const Node *n2 = side->n2;
 6241: 
 6242:       const int kb = side->kb;
 6243: 
 6244:       const double veg_h = side->veg_h();
 6245:       const double grav3 = side->grav3();
 6246: 
 6247:       if (side->is2D()) {
 6248:          // Remember: Do not use htot2, which is updated.
 6249:          const double htot = side->htot1();
 6250:          const double hhat = side->hhat;
 6251: 
 6252:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6253: 
 6254:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6255:          const Vector2 tau2 = side->tau();
 6256: 
 6257:          // hat_gam has units of m/s
 6258: 
 6259:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6260:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6261:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6262: 
 6263:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6264: 
 6265: 
 6266:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6267: 
 6268:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6269: 
 6270:       }
 6271:       else { // 3D
 6272: 
 6273:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6274:          // 
 6275:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6276:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6277:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6278:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6279:          // k+1 and k.
 6280: 
 6281: 
 6282:          const int ndim = nvrt - kb;
 6283:          const double zTopCanopy = side->zTopCanopy();
 6284: 
 6285:          // Initialize the tridiagonal system
 6286:          for (int k = kb + 1; k < nvrt; k++) {
 6287:             
 6288:             const int kin = k - (kb + 1);
 6289: 
 6290:             // Vertical viscosity at the face center
 6291:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6292: 
 6293:  
 6294:             alow[kin] = 0.0;
 6295:             cupp[kin] = 0.0;
 6296:             bdia[kin] = 0.0;
 6297: 
 6298:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6299:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6300: 
 6301:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6302:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6303:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6304: 
 6305:             // First part: layers k, k+1
 6306:             if (k < nvrt - 1) {
 6307:                              
 6308:                if constexpr(iveg != 0) {
 6309: 
 6310:                   // If there is vegetation at this level...
 6311:                   if (zTopCanopy > side->zc[k]) {
 6312:                      // If the canopy is above the k layer...
 6313:                      
 6314:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6315:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6316:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6317:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6318: 
 6319:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6320:                      const double vmag2 = length(ut2);
 6321:                      const double vmag1 = length(side->u2[k]);
 6322:                      const double vmag = 0.5*(vmag1 + vmag2);
 6323:                      
 6324:                      // Computes the vegetation alpha at the face center
 6325:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6326: 
 6327:                      cff1 += veg_alpha_sd*dt*vmag;
 6328: 
 6329:                   } // if (zTopCanopy
 6330:                } // if iveg
 6331: 
 6332:                const double dzz = side->Dz(k + 1);
 6333:                const double tmp = dt*dfz/dzz;
 6334:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6335: 
 6336:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6337:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6338:             }
 6339: 
 6340: 
 6341:             // Second part: layers k-1, k
 6342:             if (k > kb + 1) {
 6343: 
 6344:                double cff1 = 1.0; //init \bar{c^k}
 6345: 
 6346:                if constexpr(iveg != 0) {
 6347:                   // If there is vegetation at this level...
 6348:                   if (zTopCanopy > side->zc[k-1]) {
 6349:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6350:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6351: 
 6352:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6353: 
 6354:                      const double vmag2 = length(ut2);
 6355:                      const double vmag1 = length(side->u2[k-1]);
 6356:                      const double vmag = 0.5*(vmag1 + vmag2);
 6357: 
 6358:                      // Computes the vegetation alpha at the face center
 6359:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6360:                      cff1 += veg_alpha_sd*dt*vmag;
 6361:                   } // if zTopCanopy
 6362: 
 6363:                } // if iveg
 6364: 
 6365:                const double dzz = side->Dz(k);
 6366:                const double tmp = dt*dfz/dzz;
 6367:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6368: 
 6369:                alow[kin] += cff1*dzz/6.0 - tmp;
 6370:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6371: 
 6372:             } else { // Bottom boundary
 6373:                // This occurs at the bottom, where the bottom drag is applied.
 6374: 
 6375:                bdia[kin] += dt*side->chi2; // XXXX
 6376: 
 6377:             } // if (k > kb + 1)
 6378: 
 6379: 
 6380:          } // for (int k
 6381: 
 6382: 
 6383: 
 6384:          // Computes the RHS.
 6385:          // -----------------
 6386: 
 6387:          //	BC to be imposed at the end.
 6388: 
 6389:          const Vector2 gradETP  = side->gradETP;
 6390:          const Vector2 gradPr   = side->gradPr;
 6391:          const Vector2 gradEta1 = side->gradEta1;
 6392:          const Vector2 gradEta2 = side->gradEta2;
 6393: 
 6394:          const Vector2 *btu = side->btu;
 6395:          const Vector2 *u2  = side->u2;
 6396:          const double coriolis = side->coriolis;
 6397:          const Vector2 *nuGradU = side->nuGradU;
 6398: 
 6399:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6400:          for (int k = kb + 1; k < nvrt; k++) {
 6401:             const int kin = k - kb - 1;
 6402: 
 6403:             const double dz_0 = side->Dz(k);
 6404:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6405: 
 6406:             rrhs[kin] = {0.0, 0.0};
 6407:             double dz = 0.0;
 6408: 
 6409:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6410:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6411:             if (k < nvrt  ) dz += dz_1;
 6412:             if (k > kb + 1) dz += dz_0;
 6413: 
 6414:             // Elevation gradient, atmospheric pressure and tidal potential
 6415:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6416: 
 6417:             // Coriolis, advection, wind stress, and horizontal viscosity
 6418:             if (k < nvrt - 1) {
 6419: 
 6420: 
 6421:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6422:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6423:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6424:                                                 
 6425: 
 6426:                //diff stress tensors 1006
 6427:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6428:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6429:                   assert(false && "Not implemented: itur == 5");
 6430:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6431:                }
 6432:                // else assert(false && "itur # Not implemented");
 6433: 
 6434:             } else { // k == nvrt - 1 SURFACE
 6435:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6436:                const Vector2 tau2 = side->tau();
 6437: 
 6438:                rrhs[kin] += dt*tau2;          
 6439: 
 6440:             } // if k<nvrt
 6441: 
 6442: 
 6443:             if (k > kb + 1) {
 6444:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6445:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6446:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6447: 
 6448:                // diff stress tensors 1006
 6449:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6450:                   assert(false && "Not implemented: itur == 5");
 6451:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6452:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6453:                }
 6454:                // else assert(false && "itur # Not implemented");
 6455: 
 6456: 
 6457:             } // if k>kbs + 1
 6458: 
 6459:             // Baroclinic
 6460:             Vector2 *bcc = side->bcc;
 6461:             if constexpr(ibc == 0) {
 6462:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6463:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6464: 
 6465:             } // if ibc==0
 6466: 
 6467:          } // k=kb + 1,nvrt
 6468: 
 6469: 
 6470:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6471: 
 6472:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6473:             const int kin = k - kb - 1;
 6474:    
 6475:             // Velocity is always clamped to maximum values
 6476:             side->u2[k] = clampVelocity(soln[kin]);
 6477:          } // k
 6478: 
 6479:       } // if side->is2D()
 6480:       
 6481: 
 6482:       // Impose velocity boundary condition at the bottom
 6483:       if constexpr(imm == 2) { // 3D bed deformation model
 6484:          double dep;
 6485:          Vector2 vel;
 6486: 
 6487:          assert(false && "Not implemented: imm == 2");
 6488:          //update_bdef(time, x0, y0, dep, vel);
 6489:          // side->u2[kb] = vel;
 6490: 
 6491:       } else { // imm = 0 or 1
 6492:          if (side->Cd() == 0.0) {
 6493:             side->u2[kb] = side->u2[kb + 1];
 6494: 
 6495:          } else if (side->is3D()) { // 3D no slip bottom   
 6496:             side->u2[kb] = {0.0, 0.0};
 6497: 
 6498:          }
 6499:           
 6500:       } // if imm
 6501: 
 6502:       // The velocities below the bottom level are set to zero
 6503:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6504: 
 6505: 
 6506:    }
 6507: 
 6508: 
 6509:    __global__ void applyMomentumBC(void) {
 6510: 
 6511:       SIDE_BND(sideBnd);
 6512: 
 6513:       Side *side = sideBnd->side;
 6514:       const BoundarySegment *segment = sideBnd->segment;
 6515:       const Node *n1 = side->n1;
 6516:       const Node *n2 = side->n2;
 6517: 
 6518:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6519: 
 6520:       const bool isLand = segment->isLand;
 6521:       const int ifltype = segment->ifltype;
 6522: 
 6523:       const int kb = side->kb;
 6524: 
 6525: 
 6526:       if (!isLand && ifltype != 0) {
 6527:          const Vector2 *ubc = sideBnd->ubc;
 6528:   
 6529:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6530:             
 6531:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6532:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6533: 
 6534:             if (ifltype == -1) {
 6535:                // Flather 1
 6536: 
 6537:                const double depth = side->depth();
 6538: 
 6539:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6540: 
 6541:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6542: 
 6543:                side->u2[k] = vnorm*side->n;
 6544: 
 6545:             } else if (ifltype == -2) { // Discharge
 6546: 
 6547:                const double eta1 = side->eta1();
 6548:                const double eta2 = side->eta2();
 6549:                const double htot = side->htot2();
 6550: 
 6551:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6552:                assert(false && "Not implemented: Discharge bc");
 6553:                // const double dischrg = discharge(eta1);
 6554:                const double dischrg = 0.0; // XXX REMOVE
 6555:                
 6556: 
 6557:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6558: 
 6559:                const double vnorm = dischrg*eta2/htot;
 6560: 
 6561:                side->u2[k] = vnorm*side->n;
 6562: 
 6563:             }
 6564:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6565:                const double vnorm = dot(side->u2[k], side->n);
 6566: 
 6567:                double rat;
 6568:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6569:                else              rat = segment->vobc2; // outgoing
 6570: 
 6571:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6572: 
 6573:             }
 6574:             else { // not Flather or 3D radiation
 6575:                side->u2[k] = ubc[k];
 6576: 
 6577:             } // if (segment->ifltype...
 6578: 
 6579:          }
 6580: 
 6581:       }
 6582:       else if (isLand) { // if it is land boundary side
 6583: 
 6584:          if constexpr(islip == 0) { // free slip
 6585: 
 6586:             for (int k = kb; k < nvrt; k++) {
 6587: 
 6588:                const Vector2 t = side->t();
 6589:                const Vector2 n = side->n;
 6590: 
 6591:                double vnorm = 0.0; // for most cases
 6592:                const double vtan = dot(side->u2[k], t);
 6593:                
 6594:                side->u2[k] = vtan*t - vnorm*n;
 6595: 
 6596:             }
 6597: 
 6598:          } else { // no slip
 6599:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6600: 
 6601:          }
 6602:       } // if (side segment type...
 6603: 
 6604:    }
 6605: 
 6606: 
 6607:    __global__ void shapiroFilter1(void) {
 6608:       // First step of the Shapiro filter (normally used if indvel<=0)
 6609:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6610: 
 6611:       SIDE(side);
 6612: 
 6613:       // Only internal wet sides are processed
 6614:       if (side->isDry || !(side->isInternal())) return;
 6615: 
 6616:       const int kb = side->kb;
 6617: 
 6618:       for (int mm = 0; mm < niter_shap; mm++) {
 6619: 
 6620:          for (int k = kb + 1; k < nvrt; k++) {
 6621:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6622:             Vector2 suru = {0.0, 0.0};
 6623: 
 6624:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6625: 
 6626:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6627: 
 6628:                int kin = k;
 6629:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6630:                
 6631:                // Get the velocity at the neighbor's side.
 6632:                Vector2 nSideU2 = nSide->u2[kin];
 6633: 
 6634:                // Projects the velocity to the current side frame if needed.
 6635:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6636: 
 6637:                suru += nSideU2;
 6638:             }
 6639: 
 6640:             // Reusing bcc as a temporary array to store the suru values.
 6641:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6642: 
 6643:          }
 6644:       }
 6645:    }
 6646: 
 6647:    __global__ void shapiroFilter2(void) {
 6648:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6649: 
 6650:       SIDE(side);
 6651: 
 6652: 
 6653:       if (side->isDry || !(side->isInternal())) return;
 6654: 
 6655:       const int kb = side->kb;
 6656: 
 6657:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6658: 
 6659:       if (side->is2D()) {
 6660:          side->u2[kb + 1] = side->bcc[kb + 1];
 6661:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6662: 
 6663:       } else {
 6664:          // 3D
 6665:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6666:          
 6667:       }
 6668: 
 6669:    }
 6670: 
 6671: 
 6672:    __global__ void ul0UpdateZCoords(void) {
 6673:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6674:       
 6675:       NODE(node);      
 6676: 
 6677: 
 6678:       if (false) { //node->isDry) { XXXXXXX
 6679: 
 6680:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6681: 
 6682:          if constexpr(ivcor != 1) node->kb = 0;
 6683: 
 6684:       } else {
 6685: 
 6686:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6687:          node->updateKb();
 6688: 
 6689:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6690: 
 6691:       }
 6692: 
 6693:       // We use the temp.b field to store the previous state of isDry.
 6694:       node->tmp.b = node->isDry;
 6695: 
 6696:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6697:       node->isDry = true;
 6698: 
 6699:    }
 6700: 
 6701:    __global__ void ul0ComputeDryElements(void)
 6702:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6703:    {
 6704:       ELEM(elem);
 6705: 
 6706:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6707: 
 6708:       elem->kb = 0;
 6709: 
 6710:       if (elem->isDry) return;
 6711: 
 6712: 
 6713:    //    if(elem->isDry2()) { // XXXX
 6714:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6715:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6716:    //        call parallel_abort(errmsg)
 6717:    //    }
 6718: 
 6719:       const Node *n1 = elem->nodes[0];
 6720:       const Node *n2 = elem->nodes[1];
 6721:       const Node *n3 = elem->nodes[2];  
 6722:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6723: 
 6724:       // Computes element's kb as the minimum of the nodes' kb.
 6725:       const int kb1 = n1->kb;
 6726:       const int kb2 = n2->kb;
 6727:       const int kb3 = n3->kb;
 6728:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6729: 
 6730: 
 6731:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6732: 
 6733: 
 6734:       // Computes the element z as the mean of the nodes z.
 6735:       for (int k = elem->kb; k < nvrt; k++) {
 6736: 
 6737:          // Compute the element z as the mean of the nodes z.
 6738:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6739:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6740:          elem->z[k] /= elem->i34;
 6741: 
 6742:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6743:       }
 6744:                   
 6745:    }
 6746: 
 6747:    __global__ void ul0ComputeDryNodes(void)
 6748:    // Updates node's isDry based on the elements' isDry. 
 6749:    {
 6750:       NODE(node);
 6751: 
 6752:       node->isDry = true;
 6753: 
 6754:       // A node is wet if at least one of the elements sharing it is wet.
 6755:       for (int j = 0; j < node->numElements; j++) {
 6756:          const Element *elem = node->elements[j];
 6757:          if (!elem->isDry) {
 6758:             node->isDry = false;
 6759:             break;
 6760:          }
 6761:       }
 6762: 
 6763:        
 6764:    }
 6765: 
 6766: 
 6767:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6768:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6769:    // node->tmp.b is true if the node was previously dry.
 6770:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6771:    {
 6772:       NODE(node);
 6773:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6774: 
 6775:       // Avoid this the first time step.
 6776:       if (it == iths) return;  
 6777: 
 6778:       const bool wasDry = node->tmp.b;
 6779: 
 6780: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6781: 
 6782:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6783: 
 6784:          for (int k=0; k < nvrt; k++) {
 6785: 
 6786:             Vector3 utmp={0.0, 0.0, 0.0};
 6787: 
 6788:             double ttmp=0.0;
 6789:             double stmp=0.0;
 6790:             int icount=0;
 6791:             for (int j = 0; j < node->numNodes; j++) {
 6792: 
 6793:                const Node *nbrNode = node->nodes[j];
 6794:                
 6795:                const bool wasNbrDry = nbrNode->tmp.b;
 6796: 
 6797:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6798:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6799: 
 6800:                   icount++;
 6801: 
 6802:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6803:                   utmp += nbrNode->uvw2(k);
 6804:                   
 6805:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6806:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6807:                }
 6808:             }
 6809: 
 6810:             if (icount > 0) {
 6811:                const double inv_icount = 1.0/icount;
 6812:                utmp = inv_icount*utmp;
 6813:                node->u2[k]     = {utmp.x, utmp.y};
 6814:                node->w2[k]     = utmp.z;
 6815:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6816:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6817:             } else {
 6818:                node->u2[k] = {0.0, 0.0};
 6819:                node->w2[k] = 0.0;
 6820:                // Initialize tracers to 0.0??? XXXXX
 6821:             }
 6822:          }
 6823:       }
 6824:    }
 6825: 
 6826:   
 6827:    
 6828: 
 6829: 
 6830:    __global__ void ul0UpdateSides(int it, int iths) {
 6831:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6832:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6833:    // The dryness of the sides is updated in ul0UpdateSides2.
 6834: 
 6835:       SIDE(side);
 6836: 
 6837:       // A side is wet if and only if at least one of its elements is wet.
 6838:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6839:  
 6840:       const Node *n1 = side->n1;
 6841:       const Node *n2 = side->n2;
 6842:      
 6843:       const int kb1 = n1->kb;
 6844:       const int kb2 = n2->kb;
 6845: 
 6846:       side->kb = 0; // default when dry
 6847: 
 6848:       if (isWet) {
 6849: 
 6850:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6851: 
 6852:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6853: 
 6854:          side->kb = min(kb1, kb2);
 6855: 
 6856:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6857: 
 6858:          for (int k = side->kb; k < nvrt; k++) {
 6859:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6860: 
 6861:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6862: 
 6863:             // Compute velocity for re-wetted sides 
 6864:             if ((it != iths) && (side->isDry && isWet)) {
 6865: 
 6866:                Vector2 utmp={0.0, 0.0};
 6867: 
 6868:                int icount=0;
 6869: 
 6870:                // For all the sides on the two elements that share this side
 6871:                for (int j = 0; j < 2; j++) {
 6872:                   const Element *elem = side->elems[j];
 6873:                   if (elem == nullptr) continue;
 6874: 
 6875:                   for (int jj=0; jj < elem->i34; jj++) {
 6876:                      const Side *nSide = elem->sides[jj];
 6877:                      if (nSide->isDry) continue;
 6878: 
 6879:                      icount++;
 6880:                      utmp += nSide->u2[k];  
 6881:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6882:                   }
 6883:                }
 6884:                   
 6885:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6886:                if (icount > 0)  side->u2[k] = utmp/icount;
 6887:                else             side->u2[k] = {0.0, 0.0};
 6888:                   
 6889:             } // if ((it != iths) && (side->isDry && isWet))
 6890: 
 6891:          } // for k
 6892: 
 6893:       } // if isWet 
 6894:       
 6895: 
 6896: 
 6897:    }
 6898: 
 6899:    __global__ void ul0UpdateSides2(void) {
 6900:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6901:    
 6902:          SIDE(side);
 6903:    
 6904:          const Element *e1 = side->elems[0];
 6905:          const Element *e2 = side->elems[1];
 6906: 
 6907:          // A side is wet if and only if at least one of its elements is wet.
 6908:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6909: 
 6910:          // Update the side's dryness
 6911:          side->isDry = !isWet;
 6912: 
 6913:    }
 6914: 
 6915: 
 6916:    __global__ void zeroNodalVelocities(void) {
 6917:       NODE(node);
 6918: 
 6919:       for (int k = 0; k < nvrt; k++) {
 6920:          node->u2[k]   = {0.0, 0.0};
 6921:          node->w2[k]   = 0.0;
 6922:          node->utmp[k] = {0.0, 0.0};         
 6923:       }
 6924:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6925:    }
 6926:  
 6927: 
 6928:    __global__ void computeNodalVerticalVelocities1(void) {
 6929:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6930:    // Adds the element's vertical velocity times the element's area.
 6931:       ELEM(elem);
 6932: 
 6933:       for (int j = 0; j < elem->i34; j++) {
 6934:          Node *node = elem->nodes[j];
 6935: 
 6936:          for (int k = node->kb; k < nvrt; k++) {
 6937:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6938:          }
 6939:          atomicAdd(&(node->tmp.d), elem->area);
 6940:       }
 6941:    }
 6942: 
 6943:    __global__ void computeNodalVerticalVelocities2(void) {
 6944:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6945:    // Divides by the total area of the elements sharing the    node.
 6946:       NODE(node);
 6947: 
 6948: 
 6949:       const double invArea = 1.0 / node->tmp.d;
 6950:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6951: 
 6952:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6953:    }
 6954: 
 6955: 
 6956:    __global__ void computeNodalHorizontalVelocities1(void) {
 6957: 
 6958:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6959: 
 6960:       ELEM(elem);
 6961: 
 6962:       if (elem->isDry) return;
 6963: 
 6964:       const int kb = elem->kb;
 6965:       const bool isTri = elem->isTri();
 6966: 
 6967:       if constexpr(indvel <= 0) {
 6968:          // Assuming discontinous hvel.
 6969: 
 6970:          if (isTri) { // For triangles
 6971:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6972:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6973:             #pragma unroll
 6974:             for (int j = 0; j < 3; j++) {
 6975:                // For every node of the triangle...
 6976:                Node *node = elem->nodes[j];
 6977: 
 6978:                if (node->isDry) continue;
 6979: 
 6980:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6981:                const Side *s2 = elem->sides[(j + 1) % 3];
 6982:                const Side *s3 = elem->sides[(j + 2) % 3];
 6983: 
 6984:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6985: 
 6986:                atomicAdd(&(node->tmp.i), 1);
 6987: 
 6988:                for (int k = kb; k < nvrt; k++)  {
 6989:                   Vector2 s1u2 = s1->u2[k];
 6990:                   Vector2 s2u2 = s2->u2[k];
 6991:                   Vector2 s3u2 = s3->u2[k];
 6992: 
 6993:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6994:                   if constexpr(ics == 2) {
 6995:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6996:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6997:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6998:                   }
 6999: 
 7000:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7001:                   u = clampVelocity(u);
 7002:                   atomicAdd(&(node->utmp[k].x), u.x);
 7003:                   atomicAdd(&(node->utmp[k].y), u.y);
 7004: 
 7005:                }
 7006: 
 7007:             }
 7008:          }
 7009:          else { // For quads
 7010: 
 7011: 
 7012:             // Compute the bilinear coordinates of the center of each diagonal.
 7013:             double xi, eta;
 7014:             double shp13[4], shp24[4];
 7015:             Point2 x0, x1, x2, x3;
 7016:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7017:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7018:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7019: 
 7020:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7021:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7022: 
 7023: 
 7024: 
 7025: 
 7026:             for (int k = kb; k < nvrt; k++) {
 7027: 
 7028:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7029:                Vector2 sideU[4];
 7030:                #pragma unroll
 7031:                for (int j = 0; j < 4; j++) {
 7032:                   Vector2 u = elem->sides[j]->u2[k];
 7033:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7034:                   sideU[j] = u;
 7035:                }
 7036: 
 7037:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7038:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7039: 
 7040:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7041:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7042:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7043:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7044:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7045:                #pragma unroll
 7046:                for (int j = 0; j < 4; j++) {
 7047:                   Node *node = elem->nodes[j];
 7048:                   if (node->isDry) continue;
 7049: 
 7050:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7051:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7052:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7053:                }
 7054:             }
 7055: 
 7056:          }
 7057: 
 7058:       }
 7059:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7060:       
 7061:    }
 7062: 
 7063: 
 7064:    __global__ void computeNodalHorizontalVelocities2(void) {
 7065:       NODE(node);
 7066: 
 7067:       const int nodeCount = node->tmp.i;
 7068: 
 7069:       if (nodeCount == 0) 
 7070:       {
 7071:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7072:          return;
 7073:       }
 7074: 
 7075:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7076:       
 7077:       const int kb = node->kb;
 7078: 
 7079:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7080:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7081:       
 7082:       
 7083:    }   
 7084: 
 7085:  
 7086: 
 7087:    __global__ void resetVelocityOpenBndNodes(void) {
 7088:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7089: 
 7090:       NODE_BND(nodebnd);
 7091: printf("DDDDDDDDDD\n");
 7092:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7093:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7094:       }
 7095: 
 7096:    }
 7097: 
 7098: 
 7099:    __global__ void setVelocityOpenBndNodes(void) {
 7100:    // For open boundary nodes sets their velocity to the imposed values.
 7101: 
 7102:       SIDE_BND(sidebnd);
 7103: 
 7104:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7105:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7106:          // to its segment to the average of the side velocity.
 7107: 
 7108:          for (int k = 0; k < nvrt; k++) {
 7109:             Node *n1 = sidebnd->side->n1;
 7110:             Node *n2 = sidebnd->side->n2;
 7111: 
 7112: 
 7113:             Vector2 n1_u2(n1->u2[k]);
 7114:             Vector2 n2_u2(n2->u2[k]);
 7115: 
 7116:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7117:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7118:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7119:             }
 7120:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7121:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7122:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7123:             }
 7124: 
 7125:          }
 7126: 
 7127:       }
 7128: 
 7129:    }
 7130: 
 7131: 
 7132:    __global__ void computeVerticalVelocity(void) {
 7133:       // Computes the vertical velocity at the (2D) element's centroid.
 7134:       // In this function we will be considering volumetric elements, with side faces and a 
 7135:       // bottom and a top face. We will call them SFs, BF and TF.
 7136:       // It computes the flux coming from BF and the SFs.
 7137:       // If the bed is moving, it takes that into account.
 7138:       // Since water is incompressible, the integral of the velocity times the normal vector
 7139:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7140:       // and the BF is equal to the flux going out from the TF.
 7141:       // TF = - BF - sum(SFs).
 7142:       // It then computes the horizontal velocity at the center of TF.
 7143:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7144:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7145:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7146: 
 7147:       ELEM(elem);
 7148: 
 7149:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7150: 
 7151:       if (elem->isDry) return;
 7152: 
 7153:       const int kb = elem->kb;
 7154:       const bool isTri = elem->isTri();
 7155: 
 7156:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7157: 
 7158:       // Compute the bottom velocity
 7159:       if constexpr(imm != 0) {
 7160:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7161:       }
 7162: 
 7163: 
 7164:       double bottomArea3D;
 7165:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7166: 
 7167:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7168: 
 7169:       double topArea3D;
 7170: 
 7171:       // Bottom face flux
 7172:       double bottomFlux = 0.0;
 7173:       Vector2 u2meanBottom = {0.0, 0.0};
 7174:       const Vector2 gradh = elem->grad2(&Node::depth);
 7175:       if constexpr(imm==2) {
 7176:          Vector3 ubed;
 7177: 
 7178:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7179:          // updateBDEF(ubed);
 7180:      
 7181:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7182: 
 7183:          // elem->w[kb] += ubed.z;
 7184:       }
 7185:       else {
 7186: 
 7187:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7188:   
 7189:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7190:          // in the direction of motion.
 7191:          const double bottomW = - dot(gradh, u2meanBottom);  
 7192:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7193: 
 7194:          // VElocity associated to the bed deformation
 7195:          double bedVelocity = 0.0;
 7196:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7197: 
 7198:          elem->w[kb] = bedVelocity + bottomW; 
 7199: 
 7200:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7201:          
 7202:       } // if imm
 7203: 
 7204:       // Compute w for kb+1 to nvrt-1
 7205:       for (int l = kb; l < nvrt - 1; l++) {
 7206: 
 7207:          // normal vector to the top face of the "volumetric" element (3D)
 7208:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7209: 
 7210:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7211:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7212: 
 7213:          // Compute the total flux at the sides
 7214:          double sideFlux = 0.0;
 7215: 
 7216:          for (int j = 0; j < elem->i34; j++) {
 7217:             const Side *side = elem->sides[j];
 7218:             const int kbs = side->kb;
 7219:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7220:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7221:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7222: 
 7223:             // The area is "clamped" meaning that it takes kb into account.
 7224:             const double sideArea = side->areaClamped(l);
 7225: 
 7226:             const double sign = elem->ssign[j]; 
 7227: 
 7228:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7229:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7230:          }
 7231:          
 7232:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7233:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7234:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7235: 
 7236:          // The flux at the top ace can be computed from the other flows.
 7237:          // All fluxes are in directions into the prism.
 7238:          const double topFlux = - sideFlux - bottomFlux;
 7239: 
 7240:          // Flux at the top face due to the horizontal velocities only
 7241:          // topFlux = topHorizontalFlux + topVerticalFlux
 7242:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7243: 
 7244:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7245:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7246: 
 7247:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7248: 
 7249:          bottomFlux = -topFlux;
 7250:          
 7251:       }
 7252: 
 7253:    }  
 7254: 
