  579:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  580:    
  581:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  582: 
  583:    __device__ Vector2 grad2(double *a) const
  584:    {
  585:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  586:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  587:       if (isQuad()) {
  588:          gx += a[3]*gradPhi[3].x;
  589:          gy += a[3]*gradPhi[3].y;
  590:       }
  591:       return {gx, gy};
  592:    }
  593: 
  594:    __device__ Vector2 grad2(double Node::* field) const
  595:    {
  596:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  597:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  598:       if (isQuad()) {
  599:          gx += (nodes[3]->*field)*gradPhi[3].x;
  600:          gy += (nodes[3]->*field)*gradPhi[3].y;
  601:       }
  602:       return {gx, gy};
  603:    }
