 2610: /**
 2611:  * This method performs backtracking from the side center until a time -dt back in time 
 2612:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2613:  * intermediate point.
 2614:  *
 2615:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2616:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2617:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2618:  * remaining time.
 2619:  * 
 2620:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2621:  * 
 2622:  * @param uuint, vvint, wwint: Velocities at the final point
 2623:  * @param jlev: Level at which the backtracking is performed
 2624:  * @param dt, dtbk: Tracking timesteps
 2625:  * @return: True if the backtracking was successful, false otherwise
 2626:  */
 2627: __inline__ __device__ bool Side::btrack(
 2628:       int jlev,
 2629:       double dt,            // Tracking time
 2630:       double dtbk,          // Tracking timestep
 2631:       Vector3 &u_int        // Velocities at the initial point
 2632: ) const {
 2633: 
 2634:    // Start from side center
 2635:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2636: 
 2637:  
 2638:    double time_rm = dt; // Remaining time
 2639: 
 2640: 
 2641:    // // Initialize outputs XXX
 2642:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2643:    //    sclr[i] = 0.0;
 2644:    // }
 2645: 
 2646: 
 2647:    // Initial velocities
 2648:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2649: 
 2650:    // Find the element that is in the direction opposite to the velocity
 2651:    Element* curElem = findElementTowards(toVector2(u_int));
 2652: 
 2653: 
 2654:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2655:    if (curElem == nullptr) {
 2656:       // Make velocity parallel to the side
 2657:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2658:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2659:       curElem = otherElem(curElem);
 2660:       
 2661:    }
 2662: 
 2663: // Nudges it towards the circumcenter
 2664: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2665: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2666:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2667: const double eps = 9.013e-3;                 
 2668: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2669: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2670: 
 2671: 
 2672: 
 2673:    const int MAX_ITERATIONS = 1000; 
 2674:    Element* nextElem = curElem;
 2675:    int iter = 0;
 2676:    while(true) {
 2677: 
 2678:       // Calculate timestep
 2679:       double dtb = min(dtbk, time_rm);
 2680: 
 2681:       // Next point in the backtracking curve
 2682:       Point3 xt = x0 - dtb*u_int;
 2683:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2684:       assert(found && "Backtracking failed in btrack");
 2685: 
 2686:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2687: 
 2688:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2689:                       // then time_rm needs to be increased by the unused time.
 2690: 
 2691:       // If the velocity is too small, we stop the backtracking
 2692:       const double vmag = length(toVector2(u_int));
 2693:       if (vmag <= velmin_btrack) break;
 2694: 
 2695:       // The current point becomes the next segment's starting point.
 2696:       x0 = xt;
 2697:  
 2698:       curElem = nextElem;
 2699: 
 2700:       iter++;
 2701:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2702:    }
 2703: 
 2704: 
 2705: }
 2706: 
 2707: 
