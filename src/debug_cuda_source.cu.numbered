 1430:    {
 1431:       printf("Testing mesh for partition %d, x=%f, y=%f\n", partNum, x, y);
 1432:       for (int i = 0; i < ne; i++) {
 1433:          auto isInside = localElemData[i].containsPoint({x, y});
 1434: 
 1435:          if (isInside) {
 1436:             printf("Point %f %f %f is inside element %d\n", x, y, z, i);
 1437:             Element *elem = &localElemData[i];
 1438:             
 1439:             Vector3 u_int;
 1440: 
 1441:             // Choose the first side
 1442:             Side *side = elem->sides[0];
 1443:             int jlev = 5;  
 1444:             // RECORDAR:
 1445:             // - con y=0 no encuentra el triangulo
 1446:             // - jlev = 5, z = 0.1...
 1447:             side->btrack(5, 3000.0, 3.1, u_int);
 1448: 
 1449:          }
 1450:       }
 1451:    } 
 1452: 
 1453: }; // End of Mesh class
