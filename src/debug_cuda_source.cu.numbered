 1941: 
 1942: 
 1943: 
 1944: /**
 1945:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1946:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1947:    If the segment is completely inside the element, then it returns true.
 1948: 
 1949:    This function assumes:
 1950:    - The initial point is on a side of the element. 
 1951:    - Its position is given by parameter t in the range [0,1].
 1952:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1953:       intersects the element (elements are convex).
 1954: 
 1955:    To find the intersection point, this function does the following:
 1956:    - it finds the intersection of the line segment with all the element side lines,
 1957:       except for the one that contains the initial point.
 1958:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1959:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1960:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1961:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1962:       track segment is almost parallel to the element side line.
 1963: 
 1964:    Inputs:
 1965:    @param x1: starting point of the line segment
 1966:    @param x2: other end of the line segment
 1967: 
 1968:    Outputs:
 1969:    @param side:  side that intersects the line segment 
 1970:    @param nextElement (output):  element at that shares the intersection point with this element
 1971:    @param t (output): Parametric value of the intersection point on the side (0 <= t <= 1)
 1972:    @param tIntersect (output): Parametric value of the intersection point on the track segment x1x2 (0 <= tIntersect <= 1)
 1973: 
 1974:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1975:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1976:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1977: 
 1978:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1979:    (Delta) being zero.
 1980: 
 1981:    The intersection2 point happens when:
 1982:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1983:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1984:    
 1985:    Assumption: the 4 points (including those of the side segment) are different.
 1986:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1987:    
 1988: **/
 1989: __device__ void Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1990:                                               double &t, double &tIntersect) {
 1991:    assert( containsPoint2(x1) && "Starting point is not inside the element");                                    
 1992:    assert(!containsPoint2(x2) && "Ending point is not outside the element");
 1993: 
 1994:    double closest_intersect_t = 1e10;
 1995:    bool found_intersection = false;
 1996: 
 1997:    for (int i = 0; i < i34; i++) {
 1998: 
 1999:       Side *side2 = sides[i];
 2000: 
 2001:       // (x3,y3)-(x4,y4) is the element side line
 2002:       const Point2 x3 = side2->n1->p;
 2003:       const Point2 x4 = side2->n2->p;
 2004: 
 2005:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2006:       const double delta = cross(x2 - x1, x3 - x4);
 2007: 
 2008:       if (abs(delta) > 0) {
 2009: 
 2010:          const double delta1 = cross(x3 - x1, x3 - x4);
 2011:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2012: 
 2013:          // Solves the two linear equations for tt1 and tt2
 2014:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2015:          const double tt2 = delta2/delta;
 2016: 
 2017:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2018:             closest_intersect_t = min(closest_intersect_t, tt1);
 2019:             side = side2;
 2020:             nextElement = side->otherElem(this);
 2021:             t =          clamp(tt2, 0, 1.0);
 2022:             tIntersect = clamp(tt1, 0, 1.0);
 2023:             found_intersection = true;
 2024:          }
 2025: 
 2026:       
 2027:       }
 2028:       
 2029:    } // for
 2030: 
 2031:    assert(found_intersection && "No intersection found");
 2032: 
 2033: }
 2034: 
 2035: 
 2036: __forceinline__ __device__ bool Element::containsPoint2(Point2 x) const {
 2037:    // Check if the point (x,y) is inside the element. It does it by computing all the distances from the point to the sides (positive if inside, negative if outside)
 2038:    // And then checking if the minimum relative distance is larger than epsilon
 2039:    
 2040:    // ssign is positive if side->n is pointing outwards the element, negative if it is pointing inwards.
 2041:    double minDist = min3(-ssign[0]*sides[0]->relativeSignedDistanceToPoint(x),
 2042:                          -ssign[1]*sides[1]->relativeSignedDistanceToPoint(x),
 2043:                          -ssign[2]*sides[2]->relativeSignedDistanceToPoint(x));
 2044:    if (isQuad()) minDist = min(minDist, -ssign[3]*sides[3]->relativeSignedDistanceToPoint(x));
 2045: 
 2046:    return minDist > geometricEpsilon;
 2047: }
 2048: 
 2049: 
 2050: 
 2051: 
 2052: __inline__ __device__ double Element::computeSignedArea(void) const {
 2053:    // Compute the area of the element
 2054: 
 2055:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2056: 
 2057:    // In the quad case we need to add the area of the other triangle.
 2058:    if (isQuad()) {
 2059:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2060:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2061:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2062:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2063: 
 2064:       res += ar1;
 2065:    }
 2066: 
 2067:    return res;
 2068: }
 2069: 
 2070: 
 2071: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2072:                                                                 (nodes[1]->isDry2()) ||
 2073:                                                                 (nodes[2]->isDry2()) ||
 2074:                                                                 (i34==4 && nodes[3]->isDry2());
 2075: }
 2076: 
 2077: __inline__ __device__ double Element::detJ_eta(void) const {
 2078:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2079:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2080: }
 2081: 
 2082: __inline__ __device__ double Element::detJ_xi(void) const {
 2083:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2084:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2085: }
