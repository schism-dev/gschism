 4227: template<int nc>
 4228: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4229: 
 4230: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4231: //
 4232: // a,b,c,rhs: input vectors and are not modified by this program.
 4233: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4234: // rhs is the r.h.s.
 4235: // n: actual rank of the system.
 4236: // rows in u() and rhs();
 4237: // u: output with nc columns (transposed to rows)
 4238: // gam: a working array.
 4239: //
 4240: // NOTES:
 4241: // This is a template function that allows for different numbers of columns in the rhs vector.
 4242: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4243: 
 4244:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4245:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4246: 
 4247:    double bet = b[0];
 4248:    if constexpr (nc == 1) {
 4249:       u[0] = rhs[0]/bet;
 4250:    } else {
 4251:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4252:    }
 4253: 
 4254:    for (int j = 1; j < n; j++) {
 4255:       gam[j] = c[j - 1]/bet;
 4256:       bet = b[j] - a[j]*gam[j];
 4257: 
 4258:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4259: 
 4260:       if constexpr (nc == 1) {
 4261:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4262:       } else {
 4263:          for (int l = 0; l < nc; l++) {
 4264:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4265:          }
 4266:       }
 4267:    }
 4268: 
 4269:    // Back-substitution
 4270:    for (int j = n - 2; j >= 0; j--) {
 4271:       if constexpr (nc == 1) {
 4272:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4273:       } else {
 4274:          for (int l = 0; l < nc; l++) {
 4275:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4276:          }
 4277:       }
 4278:    }
 4279: }
 4280: 
 4281: 
 4282: 
 4283: // Helper function that contains the core algorithm
 4284: template<typename XAccessor, typename YAccessor>
 4285: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4286:                                     double  yp_top, double  yp_bot, 
 4287:                                     CubicSpline &spline) {
 4288:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4289:    // 
 4290:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4291:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4292:    //
 4293:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4294:    // 
 4295:    // Inputs: 
 4296:    //            n: dimension for x etc; # of data pts (>=2);
 4297:    //            getX, getY: functions to access x,y coordinates
 4298:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4299:    //     Output: 
 4300:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4301: 
 4302:    const int n = k2 - k1 + 1;
 4303:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4304: 
 4305:    // Allocate memory for the splines
 4306:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4307:    spline.x   = new double[n];
 4308:    spline.y   = new double[n];
 4309:    spline.yp  = new double[n];
 4310:    spline.ypp = new double[n];
 4311: 
 4312:    for (int k=k1; k<=k2; k++) {
 4313:       spline.x[k] = getX(k);
 4314:       spline.y[k] = getY(k);
 4315:    }
 4316: 
 4317:    // This is to simplify expressions later
 4318:    double *x = spline.x;
 4319:    double *y = spline.y;
 4320: 
 4321:    double *a = nullptr;
 4322:    double *b = nullptr;
 4323:    double *c = nullptr;
 4324:    double *gam = nullptr;
 4325:    double *rhs = nullptr;
 4326:    
 4327: 
 4328:       a = new double[n];   // Lower diagonal
 4329:       b = new double[n];   // Diagonal
 4330:       c = new double[n];   // Upper diagonal
 4331:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4332:       rhs = new double[n]; // Right-hand side
 4333: 
 4334:    for (int k=k1; k<=k2; k++) {
 4335:       if (k == k1) {
 4336:          // Bottom level
 4337:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4338:          b[k] = (x[k+1] - x[k])/3.0;
 4339:          c[k] = b[k]/2.0;
 4340:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4341:       } else if (k == n - 1) {
 4342:          // Top level (surface)
 4343:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4344:          b[k] = (x[k] - x[k-1])/3.0;
 4345:          a[k] = b[k]/2.0;
 4346:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4347:       } else {
 4348:          // Intermediate levels
 4349:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4350:          b[k] = (x[k+1] - x[k-1])/3.0;
 4351:          a[k] = (x[k  ] - x[k-1])/6.0;
 4352:          c[k] = (x[k+1] - x[k  ])/6.0;
 4353:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4354:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4355:       }
 4356:    }
 4357: 
 4358:    // Solve the tridiagonal system
 4359:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4360:    
 4361:    spline.yp[k1] = yp_bot;
 4362:    spline.yp[k2] = yp_top;
 4363: 
 4364:    // Compute rest of 1st derivatives using the splines
 4365:    for (int k=k1+1; k<k2; k++) {
 4366:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4367:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4368:    }
 4369:    
 4370:    delete[] a;
 4371:    delete[] b;
 4372:    delete[] c;
 4373:    delete[] gam;
 4374:    delete[] rhs;
 4375: 
 4376: }
 4377: 
 4378: // Array version
 4379: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4380:                                 double y_top, double y_bot, 
 4381:                                 CubicSpline &spline) {
 4382:    auto getX = [x] (int k) { return x[k]; };
 4383:    auto getY = [y] (int k) { return y[k]; };
 4384:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4385: }
 4386: 
 4387: // Lambda version - allows custom access patterns
 4388: template<typename XFunc, typename YFunc>
 4389: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4390:                                 double y_top, double y_bot,
 4391:                                 CubicSpline &spline) {
 4392:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4393: }
 4394: 
 4395: 
 4396: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4397: {
 4398:    assert("Not implemented");
 4399: 
 4400:    return 0.0;
 4401: }
