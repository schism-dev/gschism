 9598: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9599:    Node *nodes = mesh->localNodeData;
 9600: 
 9601:    *addr = nodes;
 9602:    *sizeNode = sizeof(Node);
 9603: 
 9604:    switch (varCode) {
 9605:       case (int)VarCode::depth:
 9606:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9607:          *sizeType = sizeof(double);
 9608:          break;
 9609:       case (int)VarCode::eta:
 9610:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9611:          *sizeType = sizeof(double);
 9612:          break;
 9613:       case (int)VarCode::x:
 9614:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9615:          *sizeType = sizeof(Vector2);
 9616:          break;
 9617:       case (int)VarCode::z:
 9618:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9619:          *sizeType = sizeof(double);
 9620:          break;
 9621:       case (int)VarCode::kb:
 9622:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9623:          *sizeType = sizeof(int);
 9624:          break;
 9625:       case (int)VarCode::isdry:
 9626:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9627:          *sizeType = sizeof(int);
 9628:          break;         
 9629:       case (int)VarCode::w:
 9630:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9631:          *sizeType = sizeof(double);
 9632:          break;
 9633:       case (int)VarCode::u:
 9634:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9635:          *sizeType = sizeof(Vector2);
 9636:          break;  
 9637:       case (int)VarCode::u_air:
 9638:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 9639:          *sizeType = sizeof(Vector2);
 9640:          break;
 9641:       default:
 9642:          *offset = -1;    
 9643:    }  
 9644:    
 9645: }
