 7873: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 7874: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 7875: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7876: //                         endif
 7877: //                       endif
 7878: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7879: //                     enddo
 7880: //                   else !upwind
 7881: //                     if(ssign(j,i)*flux_adv_hface(k,jsj)<0) then  !inflow 
 7882: //                       do jj=1,ntr
 7883: //                         adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7884: //                       enddo
 7885: //                     endif
 7886: //                   endif !weno or upwind
 7887: //                 endif
 7888: 
 7889: //               enddo !j
 7890: 
 7891: //               tr_el(1:ntr,k,i)=adv_tr(1:ntr) 
 7892: //             enddo !k=kbe(i)+1,nvrt
