 3978: __device__ __inline__ void Node::updateZCoordData(void) {
 3979: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3980: 
 3981:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3982:    // if (isDry2()) {
 3983:    //    kb = -1;  // XXXXXXXX KKKKK
 3984:    //    return;
 3985:    // }
 3986: 
 3987: 
 3988:    if constexpr(ivcor == 2) {  // SZ coordinates
 3989:       
 3990:       // Compute bottom level index
 3991:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3992:    } 
 3993:    else {  // if (ivcor == 1) Localized sigma
 3994:       // Do nothing
 3995:    }
 3996: 
 3997: 
 3998: }
