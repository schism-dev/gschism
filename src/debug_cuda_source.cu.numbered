 1454:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1455:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1456:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1457:  
 1458:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1459:       
 1460:       sinh_theta_f = sinh(theta_f);
 1461: 
 1462:    }
