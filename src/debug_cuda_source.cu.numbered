  380: // Polynomial class
  381: template<int grade>
  382: struct Polynomial {
  383:     // Static assertion to give a clear error message at compile time
  384:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  385: };
  386: 
  387: 
  388: // Explicit specialization for grade 4
  389: template<>
  390: struct Polynomial<4> {
  391:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  392: 
  393:    // Constructor from coefficients
  394:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  395: 
  396:    __device__ __forceinline__ double eval(double x) const {
  397:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  398:    }
  399: };
