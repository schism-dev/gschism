 1451: struct Side {
 1452: 
 1453:    // Geometry information
 1454:    int idx;               // Index of the side
 1455:    Node *n1, *n2;
 1456:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1457: 
 1458:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1459:    Vector2 center;        // Location of side center. 
 1460:    double zc[nvrt];       // Side center z-coord at each vertical level
 1461: 
 1462:    Frame<ics> frame;
 1463:    
 1464:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1465:                           // this is nullptr
 1466:    
 1467:    int16_t kb;            // Bottom index of the side
 1468:    bool isDry;            // True if the side is dry
 1469:  
 1470:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1471: 
 1472:    // Physical information
 1473:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1474:    Vector2 btu[nvrt];           // Back-tracked velocity
 1475:    Vector2 U;                   // Vertically averaged velocity vector  
 1476: 
 1477:    Vector2 nuGradU[nvrt];          // nu*grad u
 1478: 
 1479:    Vector2 bcc[nvrt];           // Baroclinic term
 1480:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1481: 
 1482:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1483:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1484:    Vector2 gradPr;               // Gradient of pressure
 1485:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1486: 
 1487: 
 1488:    double hhat;                 // \breve{H} in notes
 1489: 
 1490:    double shapiro;
 1491: 
 1492:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1493: 
 1494:    double coriolis;             // Coriolis parameter
 1495: 
 1496:    // Vegetation parameters
 1497:    double veg_c2;
 1498:    double veg_beta;
 1499: 
 1500:    // Bottom drag parameters.
 1501:    double chi;
 1502:    double chi2;
 1503: 
 1504:    __inline__ __device__ Point2 outputCoords(void) const;
 1505: 
 1506:    __inline__ __device__ double x(double t) const;
 1507:    __inline__ __device__ double y(double t) const;
 1508:    __inline__ __device__ double z(double t) const;
 1509:    __inline__ __device__ double lon(void) const;
 1510:    __inline__ __device__ double lat(void) const;
 1511:    __inline__ __device__ Point2 p2_t(double t) const;
 1512: 
 1513:    __device__ void setFrame(void) {
 1514:       if constexpr(ics == 1) return;
 1515: 
 1516:       double lat, lon;
 1517:       const Point3 p = toPoint3(center, centerZ());
 1518: 
 1519:       // Compute the latitude and longitude of the element center
 1520:       computeLatLon(p, lat, lon);
 1521: 
 1522:       frame.update(lat, lon);        
 1523:    }
 1524:    
 1525: 
 1526:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1527:    // If ics == 2, convert the global point to the local frame of the side
 1528:       
 1529:       if constexpr (ics == 1) {
 1530:          return p;
 1531:       } else {
 1532:          const Point3 c = {center.x, center.y, centerZ()};
 1533:          const Point3 local = frame.G2L(p - c);
 1534:          return local;
 1535:       }
 1536:    }
 1537: 
 1538:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1539:       if constexpr (ics == 1) {
 1540:          return p;
 1541:       } else {
 1542:          const Point3 c = {center.x, center.y, centerZ()};
 1543:          return c + frame.L2G(p);
 1544:       }
 1545:    }
 1546: 
 1547: 
 1548:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1549:       if constexpr(ics == 1) return v;
 1550:       else return v_frame.projHorVec(v, frame);
 1551:    }
 1552: 
 1553:    __inline__ __device__ double centerZ(void)      const;
 1554:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1555:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt && k > 0); return zc[k] - zc[k - 1]; }
 1556:    __inline__ __device__ double area(int k)        const { assert(k < nvrt && k > 0); return len*Dz(k + 1); }
 1557:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt && k > 0); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1558: 
 1559:    __inline__ __device__ Side* neigh(int index) const { 
 1560:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1561:       assert(index >= 0 && index < 4); 
 1562:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1563: 
 1564:       const int ielem = index & 1;           // 0 or 1
 1565:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1566: 
 1567:       const Element* elem = elems[ielem];
 1568: 
 1569:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1570: 
 1571:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1572: 
 1573:    }
 1574: 
 1575:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1576: 
 1577:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1578: 
 1579:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1580:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1581:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1582:    __inline__ __device__ int iadv(void) const;
 1583: 
 1584:    __inline__ __device__ double grav3(void) const;
 1585:    
 1586:    __inline__ __device__ double eta2(void) const;
 1587:    __inline__ __device__ double eta1(void) const;
 1588:    __inline__ __device__ double w2(int k) const;
 1589:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1590:    __inline__ __device__ double depth(void) const;
 1591:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1592:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1593: 
 1594:    __inline__ __device__ double dfv(int k) const;
 1595: 
 1596:    __inline__ __device__ double veg_h(void)  const;
 1597:    __inline__ __device__ double veg_nv(void) const;
 1598:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1599:    __inline__ __device__ double veg_alpha3D(int k) const;
 1600:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1601: 
 1602:    __inline__ __device__ double Cd(void) const;
 1603: 
 1604:    __inline__ __device__ Vector2 tau(void) const;
 1605: 
 1606:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1607:    
 1608: 
 1609:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1610:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1611:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1612:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1613:    } 
 1614:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1615:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1616:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1617:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1618: 
 1619:    // Get valid starting element (for backtracking)
 1620:    __inline__ __device__ Element* getStartElement() {
 1621:       return elems[0] ? elems[0] : elems[1];
 1622:    }
 1623: 
 1624:    
 1625:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1626:       // Given an element, returns the other element that shares this side
 1627:       return (elems[0] == elem) ? elems[1] : elems[0];
 1628:    }
 1629: 
 1630:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1631:       // Given a node, returns the other node that shares this side
 1632:       return (n1 == node) ? n2 : n1;
 1633:    }
 1634:  
 1635:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1636: 
 1637: 
 1638: 
 1639: 
 1640: };
 1641: 
 1642: 
 1643: // This struct is used to store the boundary information for a node.
 1644: struct NodeBoundary {   
 1645:    int idx;
 1646:    BoundarySegment *segment;
 1647:    Node *node;
 1648:    
 1649:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1650:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1651: 
 1652:    bool isLand;
 1653: 
 1654:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1655:    double elbc;   // Elevation boundary condition
 1656:    double eth;    // Elevation time history
 1657: 
 1658:    double eta_mean; // Mean elevation at nodes
 1659: 
 1660:    bool isEssentialBC;
 1661: 
 1662:    Vector2 uth[nvrt];  // "Time history" velocity
 1663: 
 1664:    // Arrays for harmonic constituents (if needed)
 1665:    double  emo[nbfr];  // Elevation amplitude
 1666:    double  efa[nbfr];  // Elevation phase
 1667: 
 1668: 
 1669:    NodeBoundary(void) {
 1670:       isLand = false;
 1671:    }
 1672:    NodeBoundary(bool _isLand) {
 1673:       isLand = _isLand;
 1674:    }
 1675: 
 1676:    
 1677:    __forceinline__ __device__ int numSidesForAverage() const {
 1678:    // Returns the number of sides that are connected to the node and have the same segment.
 1679:    // This is used to compute the average velocity at the node for open boundary nodes.
 1680:       int res = 0;
 1681:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1682:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1683: 
 1684:       return res;
 1685:    }
 1686: 
 1687: 
 1688:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1689:       assert(index == 0 || index == 1); 
 1690:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1691:    }
 1692: 
 1693:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1694:       if (isLand) return;  // land never uses these links
 1695: 
 1696:       SideBoundary *nullSideBoundary = nullptr;
 1697:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1698: 
 1699:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1700:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1701: 
 1702:       // both slots taken. OK if this side was already linked
 1703:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1704:    }
 1705: 
 1706: 
 1707: };
 1708: 
 1709: struct Node {
 1710: 
 1711:    // Geometry information
 1712:    int idx;            // Global index of the node
 1713:    int16_t part;       // Partition of the node
 1714: 
 1715:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1716:    int16_t numNodes;   // Number of nodes neighbors of this node
 1717: 
 1718:    Element **elements; // Array of pointers to the elements that share this node
 1719:    int16_t numElements;// Number of elements that share this node
 1720: 
 1721:    int16_t numSides;   // Number of sides that are connected to this node
 1722: 
 1723: 
 1724:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1725:    double gz;          // Global vertical coordinate at the node.
 1726:    Vector2 u2[nvrt];
 1727:    double  w2[nvrt];
 1728:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1729:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1730:    double lon, lat;
 1731:    double depth;
 1732: 
 1733:    Frame<ics> frame;
 1734: 
 1735:    LocalSigma<ivcor> localSigma;  
 1736: 
 1737:    int16_t kb;     // Bottom index of the node
 1738: 
 1739:    bool isDry;     // True if the node is dry
 1740: 
 1741:    int16_t iadv;   // Advection flag
 1742: 
 1743:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1744:                           // this is nullptr
 1745: 
 1746:    TempVar tmp; // Temporary variable to store different types of variables
 1747: 
 1748:    // Physical information
 1749:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1750:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1751: 
 1752:    double rho[nvrt];     // Density
 1753:    double dfv[nvrt];     // Vertical viscosity
 1754:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1755: 
 1756:    Turbulence<turbulenceModel> turb;
 1757: 
 1758:    double eta1; // Elevation at nodes at previous timestep
 1759:    double eta2; // Elevation at nodes at current timestep
 1760: 
 1761:    double ETP;  // Earth Tidal Potential
 1762: 
 1763:    double pr;    // Air pressure
 1764:    double grav2; // Gravity 
 1765:    
 1766:    Vector2 dav;  // Depth averaged velocity
 1767: 
 1768:    Vector2 tau; // Wind stress vector
 1769: 
 1770:    // Vegetation parameters
 1771:    double veg_h;
 1772:    double veg_nv;
 1773:    double veg_di;
 1774:    double veg_Cd;
 1775:    double veg_h_unbent;
 1776:    double veg_di_unbent;
 1777:    double veg_nv_unbent;
 1778:    double veg_alpha_vert_mean;
 1779:    double veg_alpha0;
 1780:    double veg_alpha3D[nvrt];
 1781: 
 1782:    // Bottom drag parameters
 1783:    double Cd;       // Bottom drag coefficient   
 1784: 
 1785:    // These three are mutually exclusive
 1786:    union {
 1787:       double rmanning; // Bottom Manning's coefficient
 1788:       double rough;    // Bottom roughness length
 1789:       double drag;     // Bottom drag coefficient
 1790:    };
 1791:    Vector2 tau_bot; // Bottom stress vector
 1792: 
 1793:    // XXXX REMOVE FOR IMM>0???
 1794:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1795:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1796: 
 1797:    
 1798:    double qel; // RHS
 1799:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1800:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1801:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1802:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1803: 
 1804:    double mX; // Solution of the FEM system
 1805: 
 1806:    // Meteorological forcing
 1807:    Vector2 u_air;
 1808:    double p_air;  // XXXX is this the same as pr?
 1809:    double t_air;
 1810:    double q_air;
 1811:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1812: 
 1813: 
 1814: 
 1815:    __device__ __forceinline__ int localIndex() const;
 1816:    __device__ __forceinline__ int packedIndex() const;
 1817: 
 1818: 
 1819:    __device__ void setWind(Vector2 &u) {
 1820:    // Sets the wind vector taking into account the mesh angle
 1821:    
 1822:       const double speed = length(u);
 1823: 
 1824:       // Rotate wind vector to the node frame
 1825:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1826: 
 1827:       // Sets the surface stress vector due to wind.
 1828:       if constexpr(nws == 0) {
 1829:          tau = {0.0, 0.0};
 1830: 
 1831:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1832:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1833: 
 1834:       } else {
 1835: 
 1836:          double dragcoef;
 1837: 
 1838:          if constexpr(iwind_form == -1) {
 1839:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1840:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1841: 
 1842:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1843:             tau = cff*u_air;
 1844:  
 1845:          } else if constexpr(iwind_form == 1) {
 1846:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1847:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1848: 
 1849:             dragcoef = max(dragcoef, 4.0e-4);
 1850:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1851:             tau = cff*u_air;
 1852: 
 1853:          } else {
 1854:             tau = {0.0, 0.0};
 1855:          }
 1856:       }
 1857:    }
 1858: 
 1859: 
 1860:    __device__ void setFrame(double lat, double lon) {
 1861:       if constexpr(ics == 1) return;
 1862: 
 1863:       frame.update(lat, lon);        
 1864:     }
 1865: 
 1866:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1867: 
 1868:    __device__ double sigmaTransitionDepth(void) const;
 1869: 
 1870:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1871: 
 1872:    __inline__ __device__ Point2 outputCoords(void) const {
 1873:       if constexpr(ics == 1)  return p;
 1874:       else                    return {rad2deg*lon, rad2deg*lat};
 1875:    }
 1876: 
 1877:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1878:    // If ics == 2, convert the global point to the local frame
 1879:       
 1880:       if constexpr (ics == 1) {
 1881:          return p;
 1882:       } else {
 1883:          const Point3 c = {p.x, p.y, gz};
 1884:          const Point3 local = frame.G2L(p - c);
 1885:          return local;
 1886:       }
 1887:    }
 1888: 
 1889:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1890:    // If ics == 2, convert the global point to the local frame
 1891:       
 1892:       if constexpr (ics == 1) {
 1893:          return p;
 1894:       } else {
 1895:          const Point3 c = {p.x, p.y, gz};
 1896:          return c + frame.L2G(p);
 1897:       }
 1898:    }
 1899: 
 1900:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1901:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1902:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1903:    
 1904:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1905: 
 1906:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1907:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1908:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1909: 
 1910:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1911:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1912: 
 1913:    __device__ __forceinline__ void clearMatrixRow(void) {
 1914:       // Clear the matrix row for this node
 1915: 
 1916:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1917: 
 1918:    }
 1919: 
 1920:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1921:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1922:       
 1923:       if (node == this) {
 1924:          *coeffDiag += value;
 1925:          return;
 1926:       }
 1927: 
 1928:       int i;
 1929:       for (i = 0; i < numNodes; i++) {
 1930:          if (nodes[i] == node) break;
 1931:       }
 1932: 
 1933:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1934:       coeffRow[csrSlot[i]] += value;
 1935:    }
 1936: 
 1937: 
 1938:    __device__ __inline__ void updateZCoordData(void);
 1939: 
 1940:    __device__ __forceinline__ double compZCoord(int k) const;
 1941: 
 1942:    __device__ void updateKb(void);
 1943: 
 1944:    __device__ __forceinline__ void computeBottomDragCd(void);
 1945: 
 1946: 
 1947: 
 1948: };
