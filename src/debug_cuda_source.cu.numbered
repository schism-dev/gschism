 8504:          *sizeType = sizeof(Vector2);
 8505:          break;
 8506:       case (int)VarCode::gradEta2:
 8507:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 8508:          *sizeType = sizeof(Vector2);
 8509:          break;
 8510:       // case (int)VarCode::ghat:
 8511:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8512:       //    *sizeType = sizeof(Vector2);
 8513:       //    break;   
