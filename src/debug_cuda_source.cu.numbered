 2147:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2148:    // Project the vectors from the node frame to the element frame
 2149: 
 2150:  
 2151:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2152:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2153:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2154:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2155:       else          v[3] = Vector2();
 2156:    }
 2157: 
 2158:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2159:    // Project the vectors from the side frame to the element frame
 2160: 
 2161:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2162:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2163:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2164:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2165:       else          v[3] = Vector2();
 2166:    }
