 5770: 
 5771:    __global__ void backtrackAllNodes(void) {
 5772: 
 5773:       // max/min # of sub-divisions
 5774:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5775:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5776: 
 5777:       SIDE(side);
 5778: 
 5779:       const int kb = side->kb;
 5780: 
 5781: 
 5782:       // Initialize btrack velocities to the actual velocities at the side 
 5783:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5784:   
 5785:       if (side->isDry) return;
 5786:      
 5787: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5788: 
 5789:       // Checks that at least one element is not dry
 5790:       const Element *elem1 = side->elems[0];
 5791:       const Element *elem2 = side->elems[1];
 5792: 
 5793: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5794: 
 5795:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5796:       
 5797:       // XXXXXX
 5798:       // !swild_tmp to store global coord. of the starting side
 5799:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5800:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5801:       // !Use sframe2 
 5802:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5803: 
 5804: 
 5805:       for (int k = kb; k < nvrt; k++) {
 5806:       //  For ics=2, the coordinates are all in the side's local frame
 5807: 
 5808:          const int iadvf = side->iadv();  // Advection flag   
 5809:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5810: 
 5811:          const double vmag2 = norm2(side->u2[k]);
 5812: 
 5813:          if (vmag2 <= velmin_btrack_sq) {  
 5814:             // No activity 
 5815: 
 5816:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5817:             
 5818:          } else {  // do btrack
 5819: 
 5820:             // Compute number of sub-divisions based on local gradients of the velocity field
 5821: 
 5822:             // XXX IS THIS NECESSARY?
 5823:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5824:             double suma = 0.0;
 5825:             int icount = 0;
 5826:             #pragma unroll
 5827:             for (int l=0; l<2; l++) {
 5828:             // For each element sharing the side...
 5829: 
 5830:                const Element *elem = side->elems[l];
 5831:                  
 5832:                if (elem == nullptr) continue;
 5833: 
 5834:                icount++;
 5835: 
 5836:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5837:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5838:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5839: 
 5840:                double utmp[4];
 5841:                double vtmp[4];
 5842:                #pragma unroll
 5843:                for (int j = 0; j < elem->i34; j++) {
 5844: 
 5845:                   const Node *node = elem->nodes[j];
 5846: 
 5847:                   if constexpr(ics==1) {
 5848:                      utmp[j] = node->u2[k].x;
 5849:                      vtmp[j] = node->u2[k].y;  
 5850: 
 5851:                   } else {
 5852:                      // 'Project' the velocity from the node frame to the element frame
 5853:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5854:                      utmp[j] = tmp_u2.x;
 5855:                      vtmp[j] = tmp_u2.y;
 5856: 
 5857:                   }
 5858:                } // for j
 5859: 
 5860:                const Vector2 grad_u = elem->grad2(utmp); 
 5861:                const Vector2 grad_v = elem->grad2(vtmp);
 5862:    
 5863:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5864:             } // for l
 5865: 
 5866:             assert(icount > 0 && "Impossible 77");
 5867: 
 5868:             // '4' is somewhat arbitrary
 5869:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5870: 
 5871:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5872:             Vector3 u_int = {0.0, 0.0, 0.0};
 5873: 
 5874:             side->btrack(k, dt, dtbk, u_int);
 5875: 
 5876: 
 5877:             side->btu[k] = {u_int.x, u_int.y};
 5878:                
 5879:          } // if vmag (do backtrack)
 5880: 
 5881: 
 5882:       } // for k=kb,nvrt-1
 5883: 
 5884:    }
 5885: 
 5886: } // extern "C"
 5887: 
 5888: template<int nc>
 5889: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5890: 
 5891: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5892: //
 5893: // Although this is a general function, it is used only for equations on vertical levels.
 5894: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5895: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5896: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5897: //
 5898: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5899: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5900: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5901: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5902: 
 5903:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5904:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5905: 
 5906:    double bet = b[0];
 5907:    if constexpr (nc == 1) {
 5908:       u[0] = rhs[0]/bet;
 5909:    } else {
 5910:       #pragma unroll
 5911:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5912:    }
 5913: 
 5914:    for (int j = 1; j < n; j++) {
 5915:       gam[j] = c[j - 1]/bet;
 5916:       bet = b[j] - a[j]*gam[j];
 5917: 
 5918:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5919: 
 5920:       if constexpr (nc == 1) {
 5921:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5922:       } else {
 5923:          #pragma unroll
 5924:          for (int l = 0; l < nc; l++) {
 5925:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5926:          }
 5927:       }
 5928:    }
 5929: 
 5930:    // Back-substitution
 5931:    for (int j = n - 2; j >= 0; j--) {
 5932:       if constexpr (nc == 1) {
 5933:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5934:       } else {
 5935:          for (int l = 0; l < nc; l++) {
 5936:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5937:          }
 5938:       }
 5939:    }
 5940: }
 5941: 
 5942: 
 5943: 
 5944: // Helper function that contains the core algorithm
 5945: template<typename XAccessor, typename YAccessor>
 5946: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5947:                                     double  yp_top, double  yp_bot, 
 5948:                                     CubicSpline &spline) {
 5949:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5950:    // 
 5951:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5952:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5953:    //
 5954:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5955:    // 
 5956:    // Inputs: 
 5957:    //            n: dimension for x etc; # of data pts (>=2);
 5958:    //            getX, getY: functions to access x,y coordinates
 5959:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5960:    //     Output: 
 5961:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5962: 
 5963:    const int n = k2 - k1 + 1;
 5964:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5965: 
 5966:    // Allocate memory for the splines
 5967:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5968:    spline.x   = new double[n];
 5969:    spline.y   = new double[n];
 5970:    spline.yp  = new double[n];
 5971:    spline.ypp = new double[n];
 5972: 
 5973:    for (int k=k1; k<=k2; k++) {
 5974:       spline.x[k] = getX(k);
 5975:       spline.y[k] = getY(k);
 5976:    }
 5977: 
 5978:    // This is to simplify expressions later
 5979:    double *x = spline.x;
 5980:    double *y = spline.y;
 5981: 
 5982:    double *a = nullptr;
 5983:    double *b = nullptr;
 5984:    double *c = nullptr;
 5985:    double *gam = nullptr;
 5986:    double *rhs = nullptr;
 5987:    
 5988: 
 5989:       a = new double[n];   // Lower diagonal
 5990:       b = new double[n];   // Diagonal
 5991:       c = new double[n];   // Upper diagonal
 5992:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5993:       rhs = new double[n]; // Right-hand side
 5994: 
 5995:    for (int k=k1; k<=k2; k++) {
 5996:       if (k == k1) {
 5997:          // Bottom level
 5998:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5999:          b[k] = (x[k+1] - x[k])/3.0;
 6000:          c[k] = b[k]/2.0;
 6001:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 6002:       } else if (k == n - 1) {
 6003:          // Top level (surface)
 6004:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 6005:          b[k] = (x[k] - x[k-1])/3.0;
 6006:          a[k] = b[k]/2.0;
 6007:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 6008:       } else {
 6009:          // Intermediate levels
 6010:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 6011:          b[k] = (x[k+1] - x[k-1])/3.0;
 6012:          a[k] = (x[k  ] - x[k-1])/6.0;
 6013:          c[k] = (x[k+1] - x[k  ])/6.0;
 6014:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 6015:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 6016:       }
 6017:    }
 6018: 
 6019:    // Solve the tridiagonal system
 6020:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 6021:    
 6022:    spline.yp[k1] = yp_bot;
 6023:    spline.yp[k2] = yp_top;
 6024: 
 6025:    // Compute rest of 1st derivatives using the splines
 6026:    for (int k=k1+1; k<k2; k++) {
 6027:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 6028:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 6029:    }
 6030:    
 6031:    delete[] a;
 6032:    delete[] b;
 6033:    delete[] c;
 6034:    delete[] gam;
 6035:    delete[] rhs;
 6036: 
 6037: }
 6038: 
 6039: // Array version
 6040: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 6041:                                 double y_top, double y_bot, 
 6042:                                 CubicSpline &spline) {
 6043:    auto getX = [x] (int k) { return x[k]; };
 6044:    auto getY = [y] (int k) { return y[k]; };
 6045:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6046: }
 6047: 
 6048: // Lambda version - allows custom access patterns
 6049: template<typename XFunc, typename YFunc>
 6050: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 6051:                                 double y_top, double y_bot,
 6052:                                 CubicSpline &spline) {
 6053:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 6054: }
 6055: 
 6056: 
 6057: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 6058: {
 6059:    assert("Not implemented");
 6060: 
 6061:    return 0.0;
 6062: }
