 5606: 
 5607: 
 5608:    __global__ void backtrackAllNodes(void) {
 5609: 
 5610:       // max/min # of sub-divisions
 5611:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 5612:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 5613: 
 5614:       SIDE(side);
 5615: 
 5616:       const int kb = side->kb;
 5617: 
 5618: 
 5619:       // Initialize btrack velocities to the actual velocities at the side 
 5620:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 5621:   
 5622:       if (side->isDry) return;
 5623:      
 5624: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 5625: 
 5626:       // Checks that at least one element is not dry
 5627:       const Element *elem1 = side->elems[0];
 5628:       const Element *elem2 = side->elems[1];
 5629: 
 5630: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 5631: 
 5632:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 5633:       
 5634:       // XXXXXX
 5635:       // !swild_tmp to store global coord. of the starting side
 5636:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 5637:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 5638:       // !Use sframe2 
 5639:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 5640: 
 5641: 
 5642:       for (int k = kb; k < nvrt; k++) {
 5643:       //  For ics=2, the coordinates are all in the side's local frame
 5644: 
 5645:          const int iadvf = side->iadv();  // Advection flag   
 5646:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 5647: 
 5648:          const double vmag2 = norm2(side->u2[k]);
 5649: 
 5650:          if (vmag2 <= velmin_btrack_sq) {  
 5651:             // No activity 
 5652: 
 5653:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 5654:             
 5655:          } else {  // do btrack
 5656: 
 5657:             // Compute number of sub-divisions based on local gradients of the velocity field
 5658: 
 5659:             // XXX IS THIS NECESSARY?
 5660:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 5661:             double suma = 0.0;
 5662:             int icount = 0;
 5663:             #pragma unroll
 5664:             for (int l=0; l<2; l++) {
 5665:             // For each element sharing the side...
 5666: 
 5667:                const Element *elem = side->elems[l];
 5668:                  
 5669:                if (elem == nullptr) continue;
 5670: 
 5671:                icount++;
 5672: 
 5673:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 5674:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 5675:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 5676: 
 5677:                double utmp[4];
 5678:                double vtmp[4];
 5679:                #pragma unroll
 5680:                for (int j = 0; j < elem->i34; j++) {
 5681: 
 5682:                   const Node *node = elem->nodes[j];
 5683: 
 5684:                   if constexpr(ics==1) {
 5685:                      utmp[j] = node->u2[k].x;
 5686:                      vtmp[j] = node->u2[k].y;  
 5687: 
 5688:                   } else {
 5689:                      // 'Project' the velocity from the node frame to the element frame
 5690:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 5691:                      utmp[j] = tmp_u2.x;
 5692:                      vtmp[j] = tmp_u2.y;
 5693: 
 5694:                   }
 5695:                } // for j
 5696: 
 5697:                const Vector2 grad_u = elem->grad2(utmp); 
 5698:                const Vector2 grad_v = elem->grad2(vtmp);
 5699:    
 5700:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 5701:             } // for l
 5702: 
 5703:             assert(icount > 0 && "Impossible 77");
 5704: 
 5705:             // '4' is somewhat arbitrary
 5706:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 5707: 
 5708:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 5709:             Vector3 u_int = {0.0, 0.0, 0.0};
 5710: 
 5711:             side->btrack(k, dt, dtbk, u_int);
 5712: 
 5713: 
 5714:             side->btu[k] = {u_int.x, u_int.y};
 5715:                
 5716:          } // if vmag (do backtrack)
 5717: 
 5718: 
 5719:       } // for k=kb,nvrt-1
 5720: 
 5721:    }
 5722: 
 5723: } // extern "C"
 5724: 
 5725: template<int nc>
 5726: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5727: 
 5728: // Solves a tridiagonal system. Adapted from Numerical Recipes in FORTRAN (pp.43).
 5729: //
 5730: // Although this is a general function, it is used only for equations on vertical levels.
 5731: // nc is the number of components in each unknown: 1 for a scalar, 2 for Vector2.
 5732: // It is not really for nc independent RHS vectors. We only use it for scalar and Vector2.
 5733: // Vector2 is stored as adjacent (x, y), so index of level j, component l is j*nc + l.
 5734: //
 5735: // a, b, c, rhs: inputs, not modified. gam: work array of length n.
 5736: // a, b, c are the three diagonals (b = main). a[0] and c[n-1] are unused.
 5737: // n: rank of the system (number of vertical levels in the 3D momentum solve).
 5738: // rhs, u: length n*nc, packed C order (n levels, nc components per level).
 5739: 
 5740:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 5741:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5742: 
 5743:    double bet = b[0];
 5744:    if constexpr (nc == 1) {
 5745:       u[0] = rhs[0]/bet;
 5746:    } else {
 5747:       #pragma unroll
 5748:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5749:    }
 5750: 
 5751:    for (int j = 1; j < n; j++) {
 5752:       gam[j] = c[j - 1]/bet;
 5753:       bet = b[j] - a[j]*gam[j];
 5754: 
 5755:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5756: 
 5757:       if constexpr (nc == 1) {
 5758:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5759:       } else {
 5760:          #pragma unroll
 5761:          for (int l = 0; l < nc; l++) {
 5762:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5763:          }
 5764:       }
 5765:    }
 5766: 
 5767:    // Back-substitution
 5768:    for (int j = n - 2; j >= 0; j--) {
 5769:       if constexpr (nc == 1) {
 5770:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5771:       } else {
 5772:          for (int l = 0; l < nc; l++) {
 5773:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5774:          }
 5775:       }
 5776:    }
 5777: }
 5778: 
 5779: 
 5780: 
 5781: // Helper function that contains the core algorithm
 5782: template<typename XAccessor, typename YAccessor>
 5783: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5784:                                     double  yp_top, double  yp_bot, 
 5785:                                     CubicSpline &spline) {
 5786:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5787:    // 
 5788:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5789:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5790:    //
 5791:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5792:    // 
 5793:    // Inputs: 
 5794:    //            n: dimension for x etc; # of data pts (>=2);
 5795:    //            getX, getY: functions to access x,y coordinates
 5796:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5797:    //     Output: 
 5798:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5799: 
 5800:    const int n = k2 - k1 + 1;
 5801:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5802: 
 5803:    // Allocate memory for the splines
 5804:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5805:    spline.x   = new double[n];
 5806:    spline.y   = new double[n];
 5807:    spline.yp  = new double[n];
 5808:    spline.ypp = new double[n];
 5809: 
 5810:    for (int k=k1; k<=k2; k++) {
 5811:       spline.x[k] = getX(k);
 5812:       spline.y[k] = getY(k);
 5813:    }
 5814: 
 5815:    // This is to simplify expressions later
 5816:    double *x = spline.x;
 5817:    double *y = spline.y;
 5818: 
 5819:    double *a = nullptr;
 5820:    double *b = nullptr;
 5821:    double *c = nullptr;
 5822:    double *gam = nullptr;
 5823:    double *rhs = nullptr;
 5824:    
 5825: 
 5826:       a = new double[n];   // Lower diagonal
 5827:       b = new double[n];   // Diagonal
 5828:       c = new double[n];   // Upper diagonal
 5829:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5830:       rhs = new double[n]; // Right-hand side
 5831: 
 5832:    for (int k=k1; k<=k2; k++) {
 5833:       if (k == k1) {
 5834:          // Bottom level
 5835:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5836:          b[k] = (x[k+1] - x[k])/3.0;
 5837:          c[k] = b[k]/2.0;
 5838:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5839:       } else if (k == n - 1) {
 5840:          // Top level (surface)
 5841:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5842:          b[k] = (x[k] - x[k-1])/3.0;
 5843:          a[k] = b[k]/2.0;
 5844:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5845:       } else {
 5846:          // Intermediate levels
 5847:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5848:          b[k] = (x[k+1] - x[k-1])/3.0;
 5849:          a[k] = (x[k  ] - x[k-1])/6.0;
 5850:          c[k] = (x[k+1] - x[k  ])/6.0;
 5851:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5852:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5853:       }
 5854:    }
 5855: 
 5856:    // Solve the tridiagonal system
 5857:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5858:    
 5859:    spline.yp[k1] = yp_bot;
 5860:    spline.yp[k2] = yp_top;
 5861: 
 5862:    // Compute rest of 1st derivatives using the splines
 5863:    for (int k=k1+1; k<k2; k++) {
 5864:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5865:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5866:    }
 5867:    
 5868:    delete[] a;
 5869:    delete[] b;
 5870:    delete[] c;
 5871:    delete[] gam;
 5872:    delete[] rhs;
 5873: 
 5874: }
 5875: 
 5876: // Array version
 5877: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5878:                                 double y_top, double y_bot, 
 5879:                                 CubicSpline &spline) {
 5880:    auto getX = [x] (int k) { return x[k]; };
 5881:    auto getY = [y] (int k) { return y[k]; };
 5882:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5883: }
 5884: 
 5885: // Lambda version - allows custom access patterns
 5886: template<typename XFunc, typename YFunc>
 5887: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5888:                                 double y_top, double y_bot,
 5889:                                 CubicSpline &spline) {
 5890:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5891: }
 5892: 
 5893: 
 5894: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5895: {
 5896:    assert("Not implemented");
 5897: 
 5898:    return 0.0;
 5899: }
