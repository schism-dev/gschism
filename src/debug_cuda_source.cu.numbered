 4479:    __global__ void computeFlowBcVelocities(double time) {
 4480: 
 4481:       SIDE_BND(sideBnd);
 4482: 
 4483:       const Side *side = sideBnd->side;
 4484:  
 4485:       const bool isDry = side->isDry;
 4486:       const bool isLand = sideBnd->segment->isLand;
 4487: 
 4488:    
 4489:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4490: 
 4491:       if (isDry || isLand) return;
 4492: 
 4493:       // For wet sides in open boundaries...
 4494:       const Vector2 n = side->n;
 4495:       const BoundarySegment *segment = sideBnd->segment;
 4496: 
 4497:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4498: 
 4499:       const int ifltype = segment->ifltype;
 4500: 
 4501:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4502:       const Vector2 r_nuth0 = r_uth0*n;
 4503: 
 4504: 
 4505:       if (ifltype == 1 || ifltype == 2) {
 4506:       
 4507:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4508: 
 4509:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4510:          
 4511:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4512:          
 4513:       } else if (ifltype == -1) { // Flather 1
 4514: 
 4515:          for (int k = 0; k < nvrt; k++) {
 4516: 
 4517:             // uth is the normal vel.; no ramp up
 4518:             const double uth = sideBnd->nuth(k);
 4519:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4520: 
 4521:             sideBnd->ubc[k] += uth*n;
 4522:          }
 4523: 
 4524:       } else if (ifltype == 3 || ifltype == 5) {
 4525:          // vnth0=0 !normal vel.
 4526: 
 4527:          Vector2 r_u1_bar = {0.0, 0.0};
 4528:          // Computes the contribution to the velocity from all tide frequencies
 4529:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4530: 
 4531:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4532:             const Vector2 umo  = sideBnd->umo(jfr); 
 4533: 
 4534:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4535:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4536:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4537:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4538: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4539:          }
 4540: 
 4541: 
 4542:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4543: 
 4544:       } // if (ifltype = 3 || ifltype == 5
 4545: 
 4546: 
 4547: 
 4548:    }
 4549: 
 4550:    __global__ void computeElevationBoundaryConditions(double time) {
 4551:       // Compute elevation essential boundary conditions 
 4552: 
 4553:       NODE_BND(nodeBnd); // Each boundary node.
 4554: 
 4555:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4556: 
 4557:       const Node *node = nodeBnd->node;
 4558:       const BoundarySegment *segment = nodeBnd->segment;
 4559:       const int iettype = segment->iettype;
 4560:       
 4561: 
 4562:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4563:       double eic = 0.0;
 4564:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4565:       else                 eic = 0.0;
 4566: 
 4567:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4568:       const double r_eth = ramp*nodeBnd->eth;
 4569:       double r_eta1_bar = 0.0;
 4570: 
 4571: 
 4572:       // Compute tide elevation
 4573:       if (iettype == 3 || iettype == 5) {   
 4574: 
 4575:          if constexpr(iloadtide==1) { // loading tide
 4576:             assert(false && "Loading tide not implemented");
 4577:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4578:          }
 4579:          
 4580:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4581: 
 4582:             const double efa  = nodeBnd->efa[jfr]; 
 4583:             const double emo  = nodeBnd->emo[jfr]; 
 4584: 
 4585:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4586:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4587:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4588: 
 4589:          } // for jfr
 4590: 
 4591:       } // if iettype
 4592: 
 4593:       switch (iettype) {
 4594:          case 1:
 4595:          case 2:
 4596:          case 4:
 4597:             nodeBnd->elbc = r_eic + r_eth;
 4598:             break;
 4599:          case 3:
 4600:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4601:             break;
 4602:          case 5:
 4603:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4604:             break;
 4605:       } // switch
 4606: 
 4607: 
 4608:       //Add inverse barometric effects
 4609:       if (iettype != 0 && inv_atm_bnd == 1) {
 4610:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4611:       }
 4612: 
 4613:    }
 4614: 
 4615: 
 4616:    __global__ void computeHorizontalViscosity(void) { 
 4617: 
 4618:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4619: 
 4620:       SIDE(side);
 4621: 
 4622:       if (side->isDry) return;
 4623: 
 4624:       for (int k = 0; k < nvrt; k++) {
 4625:          side->nuGradU[k] = {0.0, 0.0};
 4626:       }
 4627: 
 4628:       if constexpr(ihorcon == 1) {
 4629:          for (int k = side->kb; k < nvrt - 1; k++) {
 4630:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4631:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4632:             // By Zhang and Baptista.
 4633: 
 4634:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4635:             // This is a standard discretization of the Laplacian operator.
 4636:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4637:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4638:             // Gamma is hvis_coef0 in the code.
 4639:             // The value of gamma needs to be < 0.5.
 4640: 
 4641:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4642:             // side under consideration in each of the two possible elements that share the side.
 4643:             Vector2 sumU = {0.0, 0.0};
 4644:             for (int l = 0; l < 2; l++) {
 4645:                const Element *elem = side->elems[l];
 4646: 
 4647:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4648: 
 4649:                // Find the local index of the side in the element
 4650:                const int idxSide = elem->sideLocalIdx(side);
 4651:                // Find the two sides that are connected to the side under consideration
 4652:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4653:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4654: 
 4655:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4656: 
 4657:             }
 4658: 
 4659:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4660:    
 4661:          }
 4662:       }
 4663:       else if constexpr(ihorcon == 2) {
 4664:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4665:       }
 4666: 
 4667: 
 4668:    }
 4669: 
 4670: 
 4671:    __global__ void setEssentialBC(void) {
 4672:       // Set essential boundary conditions 
 4673:       NODE(node); // Each boundary node
 4674:       NodeBoundary *nodeBnd = node->nodeBnd;
 4675:       
 4676: // nodeBnd->isEssentialBC = true;      
 4677:       // Check if this node has essential BC
 4678:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4679:          // Verify BC value is valid
 4680:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4681: 
 4682:        
 4683:          // Set diagonal to 1 and zero off-diagonals
 4684:          node->coeffDiag = 1.0;
 4685: 
 4686:          for (int j = 0; j < node->numNodes; j++) {
 4687:                node->coeffMatrix[j] = 0.0;
 4688:          }
 4689:          
 4690:          // Set solution and RHS to BC value
 4691:          node->mX  = nodeBnd->elbc;
 4692:          node->qel = nodeBnd->elbc;
 4693: 
 4694:       } else {
 4695:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4696: 
 4697:          for (int j = 0; j < node->numNodes; j++) {
 4698:                Node* nbNode = node->nodes[j];
 4699:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4700:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4701:                   // Verify neighbor's BC value
 4702:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4703: 
 4704:                   // Subtract contribution to RHS
 4705:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4706:                   node->coeffMatrix[j] = 0.0;  
 4707:                }
 4708:          }
 4709:       }
 4710:    }
 4711: 
 4712: 
 4713:    __global__ void updateElevation(void) {
 4714:       NODE(node);
 4715: 
 4716: 
 4717:       node->eta2 = node->mX;
 4718: 
 4719:       node->updateZCoordData();
 4720:    }
