 3505: 
 3506:    __global__ void scaleGravity(double loadtide_coef) {
 3507: 
 3508: 
 3509:       NODE(node);
 3510: 
 3511:       // SAL option: scale gravity
 3512:       if constexpr(iloadtide==2) {  // simple const
 3513:          node->grav2 = grav*(1.0 - loadtide_coef);
 3514: 
 3515:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3516:         
 3517:           const double depth = max(node->depth, 0.0);
 3518:           const double tmp1 = sqrt(depth);
 3519:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3520:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3521:                              2.6969e-13*depth*depth*depth*tmp1;
 3522:           
 3523:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3524:           
 3525: 
 3526: 
 3527:           node->grav2 = grav*(1.0 - beta_bar);
 3528: 
 3529:       } else {  // iloadtide=0,1
 3530:         node->grav2=grav;
 3531: 
 3532:       }
 3533: 
 3534:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3535:    }
