 4708:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4709: 
 4710:       SIDE(side);
 4711: 
 4712: 
 4713:       side->U = {0.0, 0.0}; 
 4714:          
 4715:       if(side->isDry) return;
 4716: 
 4717:       const Node *node1 = side->n1;
 4718:       const Node *node2 = side->n2;
 4719: 
 4720:       // Vertically integrated velocity U (in ll if ics=2)
 4721:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4722:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4723:       }
 4724: 
 4725:    }
 4726: 
 4727:    __global__ void computeBottomDragVegetation(void) {
 4728:       // UNFINISHED. CHECK THIS:
 4729:       // How many kernels are needed? Why so many for loops?
 4730:       // Is the loop on sides needed?
 4731: 
 4732:       NODE(node);
 4733: 
 4734: 
 4735:       const int    kb      = node->kb;
 4736:       const double htot    = node->htot2(); 
 4737:       
 4738:       if (node->isDry) {
 4739:          // Default values for dry nodes
 4740:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4741:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4742: 
 4743:          return;
 4744:        
 4745:       }
 4746: 
 4747:       // Computes bottom drag Cd based on the selected nchi
 4748:       node->computeBottomDragCd();
 4749:       
 4750: 
 4751: 
 4752:       //   Bottom stress in m^2/s^2
 4753:       if (node->rho[kb + 1] >= -98.0)
 4754:       {
 4755:          const double mag_u = length(node->u2[kb + 1]);
 4756:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4757: 
 4758:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4759:          // !sediment erosion: this part needs more documentation
 4760:       }
 4761:     
 4762: 
 4763: 
 4764:       // Compute vegetation parameters
 4765:       //--------------------------------
 4766: 
 4767:       // SAV constants
 4768:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4769:       constexpr double veg_cfpsi = 0.16;
 4770: 
 4771:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4772:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4773: 
 4774:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4775:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4776:          int kbin = 0; // bin index
 4777:          for (int k = kb; k < nvrt; k++) {
 4778:             // Computes node height above the bottom level
 4779:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4780:             assert(false && "Vertical variation of vegetation not implemented");
 4781: 
 4782:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4783:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4784:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4785:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4786:             // } else {
 4787:             //    // Find the bin at which the current vertical level is
 4788:             //    while (kbin<nbins_veg_vert) {
 4789:             //       const double zn = node->z[kbin];
 4790:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4791:             //          break;
 4792:             //       } // if
 4793:             //       kbin++;
 4794:             //    } // while
 4795:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4796: 
 4797:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4798:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4799:                
 4800:             //    // Linear interpolation of the vegetation parameters
 4801:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4802:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4803:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4804:             // } // if rl10
 4805: 
 4806:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4807: 
 4808:          } // for k
 4809: 
 4810: 
 4811:       } else { // Ganthy (iveg==2)
 4812:       //  Modify canopy height, diameter, and density
 4813: 
 4814:          // Make sure there is vegetation on this node
 4815:          if (node->veg_h_unbent > 0.0) {
 4816:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4817: 
 4818:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4819:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4820:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4821: 
 4822:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4823:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4824:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4825:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4826:          } // if veg_h_unbent
 4827: 
 4828:          for (int k = 0; k < nvrt; k++) {
 4829:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4830:          } // for k
 4831:       
 4832: 
 4833:       } // if iveg
 4834:      
 4835: 
 4836:       // Compute vertical mean of veg_alpha3D
 4837:       if (iveg != 0) {
 4838:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4839:          double sum1=0.0;
 4840:          double sum2=0.0;
 4841:          // Integrate over each level under the canopy...
 4842:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4843:             const double Dz = node->Dz(k);
 4844: 
 4845:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4846:             sum2 += Dz;
 4847: 
 4848:          } // for k
 4849:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4850:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4851: 
 4852:       } // if iveg
 4853: 
 4854:    }
 4855: 
 4856:    __global__ void computeVegetationAndDragParameters(void) {
 4857:       // Computes the vegetation and drag model parameters:
 4858:       // chi, \tilde\chi, beta, \breve{H}
 4859:       
 4860:       SIDE(side);
 4861: 
 4862:       if (side->isDry) return;
 4863: 
 4864:       const double htot = side->htot2();
 4865:       const int    kb   = side->kb;
 4866: 
 4867:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4868: 
 4869:       const double veg_h     = side->veg_h();
 4870:       const double veg_nv    = side->veg_nv();
 4871:       const double veg_c     = side->veg_c();
 4872:       const double veg_beta  = side->veg_beta;
 4873:       const double veg_alpha = side->veg_alpha_vert_mean();
 4874: 
 4875:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4876:       // Velocity magnitude at the bottom level
 4877:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4878:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4879:       side->chi2 = side->Cd()*vmag1;
 4880:       side->chi  = side->chi2;
 4881:       if constexpr(iveg != 0) {
 4882:          const Node *n1 = side->n1;
 4883:          const Node *n2 = side->n2;
 4884:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4885:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4886:       }
 4887: 
 4888:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4889: 
 4890:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4891:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4892:       double magUa = 0.0;
 4893:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4894:          // 3D wet side with veg...
 4895: 
 4896:          double magUa = 0.0;
 4897:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4898:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4899: 
 4900:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4901:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4902:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4903: 
 4904:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4905:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4906: 
 4907:                // Velocity magnitude at the bottom (l) of the level
 4908:                const double ul = length(side->u2[k]);
 4909: 
 4910:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4911:                magUa += Dz*0.5*(uh + ul);
 4912: 
 4913:             } // if HasVegetation
 4914:          } // for k
 4915:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4916: 
 4917:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4918:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4919:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4920:             const double zCpy = side->zTopCanopy();
 4921:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4922:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4923:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4924:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4925:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4926:          } // if isSubmerged
 4927:       } // if iveg   
 4928: 
 4929:       // Computes the friction modified depth, \breve{H} in notes
 4930:       if (side->is2D()) { // 2D
 4931: 
 4932:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4933:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4934: 
 4935:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4936: 
 4937:          side->hhat = htot*htot/fricH; 
 4938: 
 4939:       } else { // 3D
 4940:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4941: 
 4942:          if constexpr(iveg != 0) {
 4943:             
 4944:             if (side->isSubmerged()) { 
 4945:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4946:                side->hhat -= veg_c*Hhat_alpha;
 4947: 
 4948:             } else { // Emergent
 4949:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4950:             }
 4951:          } // if iveg
 4952: 
 4953:          // Enforce positivity for 3D model
 4954:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4955:       } // if 3D
 4956: 
 4957:    }
 4958: 
 4959: 
 4960: 
 4961:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4962:    // Computes the density gradient between two elements, e1 and e2.
 4963:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4964:    // zero in the direction normal to the side. 
 4965:    // 
 4966:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4967:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4968:    //
 4969:    // Input:
 4970:    //    e1: Element
 4971:    //    e2: Neighbor element (or nullptr if boundary)
 4972:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4973:    //    k: Index of the half-level at which the density is interpolated
 4974:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4975:    // 
 4976:    // Output:
 4977:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4978:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4979: 
 4980:       if (e2 == nullptr || e2->isDry) {
 4981:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4982: 
 4983:          Side *side = e1->sides[j];
 4984:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4985:                  
 4986:          if constexpr(ics == 1) {
 4987:             vec = side->n; // Normal vector to the side
 4988:          } else {
 4989:             // IMPLEMENT THIS XXXXXX
 4990:             // !replace with xel, yel?
 4991:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4992:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4993:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4994:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4995:          } //ics
 4996:                    
 4997:          diffRho = 0.0;
 4998: 
 4999:       } else { //internal and wet
 5000:          if constexpr(ics==1) {
 5001:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5002: 
 5003:             // Vector from e1 to e2
 5004:             vec = e2->center - e1->center;
 5005: 
 5006:          } else { 
 5007:             // IMPLEMENT THIS XXXXXX
 5008:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5009:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5010:             //                   alow(j)=xctr2
 5011:             //                   bdia(j)=yctr2
 5012:          } // ics
 5013: 
 5014:          diffRho = rho2 - e1->demeanedDensity(k);
 5015:       }
 5016: 
 5017:    }
 5018: 
 5019:    __global__ void computeDensityCubicSplines(void) {
 5020:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5021: 
 5022:       ELEM(elem);
 5023: 
 5024:       if (elem->isDry) return;
 5025: 
 5026:       const int kb = elem->kb;
 5027: 
 5028:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5029:       if (elem->is2D()) {
 5030:          // In the 2D case, the density is constant at the prism level. 
 5031:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5032:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5033:       } else { //3D
 5034: 
 5035:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5036:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5037:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5038:          ///// XXXX CHECK INDICES!!!!!
 5039:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5040:       } // 2D/3D
 5041: 
 5042:    }
 5043: } // extern "C"
 5044: 
 5045: 
 5046: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5047: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5048: 
 5049:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5050: 
 5051:    const int kb  = elem->kb;
 5052:    const int kb2 = elem2->kb;
 5053: 
 5054:    // z-coordinate of prism of elem
 5055:    const double zp = elem->z_prism(k);
 5056: 
 5057:    double rho = 0.0;
 5058: 
 5059:    if (elem2->is2D()) {
 5060:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5061: 
 5062:    } else {  // 3D
 5063: 
 5064:       // eta_min may be < zmax
 5065:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5066:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5067: 
 5068:       // (Extrapolate density below bottom, we will fix it later)
 5069:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5070:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5071:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5072:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5073:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5074:    } // 2D/3D
 5075:      
 5076: 
 5077:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5078:    // Now we need to fix it.
 5079:    if (elem->z[k] < elem2->z[kb2]) {
 5080:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5081: 
 5082:       // There are two methods to adjust the density at the bottom of the element.
 5083:       // iunder_deep=0: 
 5084:       const double depth1 = abs(elem->z[kb]); // larger depth
 5085: 
 5086:       if (iunder_deep==0) {
 5087: 
 5088:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5089: 
 5090:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5091: 
 5092:       } else { // iunder_deep != 0
 5093: 
 5094:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5095: 
 5096:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5097: 
 5098:          //   Demeaned density at the same z coordinate as
 5099:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5100:          }
 5101: 
 5102:       } // if iunder_deep
 5103:    } // if elem->z[kb] < elem2->z[kb]
 5104: 
 5105:    return rho;
 5106: }
 5107: 
 5108: 
 5109: extern "C" {
 5110:    __global__ void computeDensityGradient(void) {
 5111: 
 5112:       if constexpr(ibc != 0) return;
 5113: 
 5114:          // Compute the horizontal density gradient at each element.
 5115:       // It works in two steps:
 5116:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5117:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5118:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5119:       //             gradRho.r1 = rho1 - rho0
 5120:       //             gradRho.r2 = rho2 - rho0
 5121:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5122:       // 
 5123:       //  NOTE: We use de-meaned densities.
 5124: 
 5125:       ELEM(elem);
 5126: 
 5127:       if (elem->isDry) return;
 5128: 
 5129:       const int kb  = elem->kb;
 5130:       const int i34 = elem->i34;
 5131: 
 5132:       for (int k = kb + 1; k < nvrt; k++) {
 5133:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5134:          //             gradRho.r1 = rho1 - rho0
 5135:          //             gradRho.r2 = rho2 - rho0
 5136:          int icount = 0;
 5137:          double sumRx = 0.0;
 5138:          double sumRy = 0.0;
 5139:          for (int j1=0; j1<i34; j1++) { 
 5140: 
 5141:             const int j2 = elem->nxq(j1 + 1);
 5142: 
 5143:             // Pairs of consecutive neighbor elements of elem
 5144:             const Element *e1 = elem->nghbElems[j1];
 5145:             const Element *e2 = elem->nghbElems[j2];
 5146: 
 5147:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5148:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5149:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5150: 
 5151:             // Compute the density difference and the vector from elem to e1 and e2
 5152:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5153:             double diffRho1, diffRho2;
 5154:             Vector2 vec1, vec2;
 5155:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5156:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5157: 
 5158:             const double rl1 = length(vec1);
 5159:             const double rl2 = length(vec2);
 5160:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5161: 
 5162:             const double delta = cross(vec1, vec2);
 5163:             const double sintheta = abs(delta)/(rl1*rl2);
 5164: 
 5165:             // To avoid problems, avoid elements with small angle between vectors
 5166:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5167:             const bool validEq = (sintheta > sin_one_deg);
 5168: 
 5169:             if (validEq) {
 5170:                // Solve the system of equations to get the density gradient at elem
 5171:                icount++;
 5172:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5173:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5174:                sumRx += Rx;
 5175:                sumRy += Ry;
 5176:             }
 5177:          } // for j1
 5178: 
 5179:          // Compute the average density gradient at elem
 5180:          if (icount==0) {
 5181:            // Bad mesh quality; bail out with 0 b-cc
 5182:            elem->gradRho[k] = {0.0, 0.0};
 5183:          } else {
 5184:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5185:          }
 5186: 
 5187:       } // for k
 5188: 
 5189:    }
 5190: 
 5191:    __global__ void computeBaroclinicTerm(void) {
 5192:    // Computes the baroclinic term at sides (at half levels).
 5193:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5194:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5195: 
 5196:       if (ibc == 1) return;
 5197: 
 5198:       SIDE(side);
 5199: 
 5200:       if (side->isDry) return;
 5201: 
 5202:       const Element *e1 = side->elems[0];
 5203:       const Element *e2 = side->elems[1];      
 5204:       const int kb = side->kb;
 5205:       
 5206:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5207: 
 5208:       // interpolates vertically the density gradient of the two elements at the half level/
 5209: 
 5210:       int k1 = max(kb, nvrt / 2);
 5211:       int k2 = max(kb, nvrt / 2);
 5212: 
 5213:       // Starts the integration at the surface and goes down to the bottom
 5214:       side->bcc[nvrt-1] = {0.0, 0.0};
 5215:       for (int k = nvrt - 2; k >= kb; k--) {
 5216:       // For each prism level (from surface to bottom)...
 5217: 
 5218:          // For both elements, interpolate density gradient at the side's half level.
 5219:          // The gradient at the side is the average of the gradients at the elements.
 5220:          // w1, w2 are used to take into account boundary sides, with just one element.
 5221:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5222:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5223:          const double wsum = w1 + w2;
 5224:          w1 = w1/wsum;
 5225:          w2 = w2/wsum;
 5226:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5227: 
 5228:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5229:          Vector2 gradRho = {0.0, 0.0};
 5230:          if (e1 != nullptr && k > kb) {
 5231:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5232:             
 5233:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5234:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5235:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5236: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5237:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5238:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5239:          }      
 5240:          if (e2 != nullptr && k > kb) {
 5241:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5242:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5243:             
 5244:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5245:          }
 5246: 
 5247:          if constexpr(ics==2) {
 5248:             assert(false && "Not implemented: ics == 2");
 5249:             // IMPLEMENT THIS XXXXXX
 5250:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5251:             // swild(1)=tmp1
 5252:             // swild(2)=tmp2
 5253:          }
 5254:          
 5255:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5256:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5257:          // CHECK INDICES!!! XXX
 5258:          const double grav3 = side->grav3();
 5259:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5260: 
 5261:       } // for
 5262: 
 5263:    }
 5264: 
 5265: 
 5266: 
 5267:    __global__ void computeHorGradientAtSide(void) {
 5268: 
 5269:       // Compute the horizontal density gradient at each element.
 5270:       // It works in two steps:
 5271:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5272:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5273:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5274:       //             gradRho.r1 = rho1 - rho0
 5275:       //             gradRho.r2 = rho2 - rho0
 5276:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5277:       // 
 5278:       //  NOTE: We use de-meaned densities.
 5279: 
 5280:       SIDE(side);
 5281: 
 5282: // printf("side->isDry: %d\n", side->isDry);
 5283:       if (side->isDry) return;
 5284: 
 5285:       // Computes the gradient of the variables at the side center.
 5286:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5287:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5288:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5289: 
 5290:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5291:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5292:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5293:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5294: 
 5295: 
 5296:    }
 5297: 
 5298: 
 5299:    __global__ void solveMomentumEquations(double time) {
 5300: 
 5301:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5302:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5303: 
 5304:       SIDE(side);
 5305: 
 5306:       if (side->isDry) 
 5307:       {
 5308:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5309: 
 5310:          return;
 5311:       }
 5312: 
 5313:       const Node *n1 = side->n1;
 5314:       const Node *n2 = side->n2;
 5315: 
 5316:       const int kb = side->kb;
 5317: 
 5318:       const double veg_h = side->veg_h();
 5319:       const double grav3 = side->grav3();
 5320: 
 5321:       if (side->is2D()) {
 5322:          // Warning: Do not use htot2, which is updated.
 5323:          const double htot = side->htot1();
 5324:          const double hhat = side->hhat;
 5325: 
 5326:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5327: 
 5328:          Vector2 tau2 = {0.0, 0.0};
 5329:           
 5330:          if constexpr(ics==1) {
 5331:             tau2 = side->tau();
 5332: 
 5333:          } else {
 5334:             assert(false && "Not implemented: ics == 2");
 5335:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5336:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5337:             // taux2=(vn1+tt1)*0.5d0
 5338:             // tauy2=(vn2+ss1)*0.5d0
 5339:          } // if ics         
 5340: 
 5341:          // hat_gam has units of m/s
 5342: 
 5343:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5344: 
 5345:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5346:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5347: 
 5348:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5349: 
 5350: 
 5351:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5352:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5353: 
 5354:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5355: 
 5356:       }
 5357:       else { // 3D
 5358: 
 5359:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5360:          // 
 5361:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5362:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5363:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5364:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5365:          // k+1 and k.
 5366: 
 5367: 
 5368:          const int ndim = nvrt - kb;
 5369:          const double zTopCanopy = side->zTopCanopy();
 5370: 
 5371:          // Initialize the tridiagonal system
 5372:          for (int k = kb + 1; k < nvrt; k++) {
 5373:             
 5374:             const int kin = k - (kb + 1);
 5375: 
 5376:             // Vertical viscosity at the face center
 5377:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5378:  
 5379:             alow[kin] = 0.0;
 5380:             cupp[kin] = 0.0;
 5381:             bdia[kin] = 0.0;
 5382: 
 5383:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5384:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5385: 
 5386:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5387:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5388:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5389: 
 5390:             // First part: layers k, k+1
 5391:             if (k < nvrt - 1) {
 5392:                              
 5393:                if constexpr(iveg != 0) {
 5394: 
 5395:                   // If there is vegetation at this level...
 5396:                   if (zTopCanopy > side->zc[k]) {
 5397:                      // If the canopy is above the k layer...
 5398:                      
 5399:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5400:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5401:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5402:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5403: 
 5404:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5405:                      const double vmag2 = length(ut2);
 5406:                      const double vmag1 = length(side->u2[k]);
 5407:                      const double vmag = 0.5*(vmag1 + vmag2);
 5408:                      
 5409:                      // Computes the vegetation alpha at the face center
 5410:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5411: 
 5412:                      cff1 += veg_alpha_sd*dt*vmag;
 5413: 
 5414:                   } // if (zTopCanopy
 5415:                } // if iveg
 5416: 
 5417:                const double dzz = side->Dz(k + 1);
 5418:                const double tmp = dt*dfz/dzz;
 5419:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5420: 
 5421:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5422:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5423:             }
 5424: 
 5425: 
 5426:             // Second part: layers k-1, k
 5427:             if (k > kb + 1) {
 5428: 
 5429:                double cff1 = 1.0; //init \bar{c^k}
 5430: 
 5431:                if constexpr(iveg != 0) {
 5432:                   // If there is vegetation at this level...
 5433:                   if (zTopCanopy > side->zc[k-1]) {
 5434:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5435:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5436: 
 5437:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5438: 
 5439:                      const double vmag2 = length(ut2);
 5440:                      const double vmag1 = length(side->u2[k-1]);
 5441:                      const double vmag = 0.5*(vmag1 + vmag2);
 5442: 
 5443:                      // Computes the vegetation alpha at the face center
 5444:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5445:                      cff1 += veg_alpha_sd*dt*vmag;
 5446:                   } // if zTopCanopy
 5447: 
 5448:                } // if iveg
 5449: 
 5450:                const double dzz = side->Dz(k);
 5451:                const double tmp = dt*dfz/dzz;
 5452:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5453: 
 5454:                alow[kin] += cff1*dzz/6.0 - tmp;
 5455:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5456: 
 5457:             } else { // Bottom boundary
 5458:                // This occurs at the bottom, where the bottom drag is applied.
 5459: 
 5460:                bdia[kin] += dt*side->chi2; // XXXX
 5461: 
 5462:             } // if (k > kb + 1)
 5463: 
 5464: 
 5465:          } // for (int k
 5466: 
 5467: 
 5468: 
 5469:          // Computes the RHS.
 5470:          // -----------------
 5471: 
 5472:          //	BC to be imposed at the end.
 5473: 
 5474:          const Vector2 gradETP  = side->gradETP;
 5475:          const Vector2 gradPr   = side->gradPr;
 5476:          const Vector2 gradEta1 = side->gradEta1;
 5477:          const Vector2 gradEta2 = side->gradEta2;
 5478: 
 5479:          const Vector2 *btu = side->btu;
 5480:          const Vector2 *u2  = side->u2;
 5481:          const double coriolis = side->coriolis;
 5482:          const Vector2 *nuGradU = side->nuGradU;
 5483: 
 5484: 
 5485:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5486: 
 5487:          for (int k = kb + 1; k < nvrt; k++) {
 5488:             const int kin = k - kb - 1;
 5489: 
 5490:             const double dz_0 = side->Dz(k);
 5491:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5492: 
 5493:             rrhs[kin] = {0.0, 0.0};
 5494:             double dz = 0.0;
 5495: 
 5496:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5497:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5498:             if (k < nvrt  ) dz += dz_1;
 5499:             if (k > kb + 1) dz += dz_0;
 5500: 
 5501:             // Elevation gradient, atmospheric pressure and tidal potential
 5502:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5503: 
 5504:             // Coriolis, advection, wind stress, and horizontal viscosity
 5505:             if (k < nvrt - 1) {
 5506: 
 5507: 
 5508:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5509:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5510:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5511:                                                 
 5512: 
 5513:                //diff stress tensors 1006
 5514:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5515:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5516:                   assert(false && "Not implemented: itur == 5");
 5517:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5518:                }
 5519: 
 5520:             } else { // k == nvrt - 1 SURFACE
 5521:                Vector2 tau2 = {0.0, 0.0};
 5522:                if constexpr(ics==1) {
 5523:                   tau2 = side->tau();
 5524:       
 5525:                } else {
 5526:                   assert(false && "Not implemented: ics == 2");
 5527:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5528:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5529:                   // taux2=(vn1+tt1)*0.5d0
 5530:                   // tauy2=(vn2+ss1)*0.5d0
 5531:                } // if ics
 5532: 
 5533:                rrhs[kin] += dt*tau2;
 5534: 
 5535:             } // if k<nvrt
 5536: 
 5537:             if (k > kb + 1) {
 5538:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5539:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5540:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5541: 
 5542:                // diff stress tensors 1006
 5543:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5544:                   assert(false && "Not implemented: itur == 5");
 5545:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5546:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5547:                }
 5548: 
 5549:             } // if k>kbs + 1
 5550: 
 5551:             // Baroclinic
 5552:             Vector2 *bcc = side->bcc;
 5553:             if constexpr(ibc == 0) {
 5554:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5555:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5556: 
 5557:             } // if ibc==0
 5558: 
 5559:          } // k=kb + 1,nvrt
 5560: 
 5561: 
 5562:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5563: 
 5564:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5565:             const int kin = k - kb - 1;
 5566: 
 5567:             // Velocity is always clamped to maximum values
 5568:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5569:          } // k
 5570: 
 5571:       } // if side->is2D()
 5572:       
 5573: 
 5574:       // Impose velocity boundary condition at the bottom
 5575:       if constexpr(imm == 2) { // 3D bed deformation model
 5576:          double dep;
 5577:          Vector2 vel;
 5578: 
 5579:          assert(false && "Not implemented: imm == 2");
 5580:          //update_bdef(time, x0, y0, dep, vel);
 5581:          // side->u2[kb] = vel;
 5582: 
 5583:       } else { // imm = 0 or 1
 5584:          if (side->Cd() == 0.0) {
 5585:             side->u2[kb] = side->u2[kb + 1];
 5586: 
 5587:          } else if (side->is3D()) { // 3D no slip bottom   
 5588:             side->u2[kb] = {0.0, 0.0};
 5589:          }
 5590:           
 5591:       } // if imm
 5592: 
 5593:       // The velocities below the bottom level are set to zero
 5594:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5595: 
 5596: 
 5597:    }
 5598: 
 5599: 
 5600:    __global__ void applyMomentumBC(void) {
 5601: 
 5602:       SIDE_BND(sideBnd);
 5603: 
 5604:       Side *side = sideBnd->side;
 5605:       const BoundarySegment *segment = sideBnd->segment;
 5606:       const Node *n1 = side->n1;
 5607:       const Node *n2 = side->n2;
 5608: 
 5609:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5610: 
 5611:       const bool isLand = segment->isLand;
 5612:       const int ifltype = segment->ifltype;
 5613: 
 5614:       const int kb = side->kb;
 5615: 
 5616:       if (!isLand && ifltype != 0) {
 5617:          const Vector2 *ubc = sideBnd->ubc;
 5618:   
 5619:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5620:             
 5621:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5622:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5623: 
 5624:             if (ifltype == -1) {
 5625:                // Flather 1
 5626: 
 5627:                const double depth = side->depth();
 5628: 
 5629:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5630: 
 5631:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5632: 
 5633:                side->u2[k] = vnorm*side->n;
 5634: 
 5635:             } else if (ifltype == -2) { // Discharge
 5636: 
 5637:                const double eta1 = side->eta1();
 5638:                const double eta2 = side->eta2();
 5639:                const double htot = side->htot2();
 5640: 
 5641:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5642:                assert(false && "Not implemented: Discharge bc");
 5643:                // const double dischrg = discharge(eta1);
 5644:                const double dischrg = 0.0; // XXX REMOVE
 5645:                
 5646: 
 5647:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5648: 
 5649:                const double vnorm = dischrg*eta2/htot;
 5650: 
 5651:                side->u2[k] = vnorm*side->n;
 5652: 
 5653:             }
 5654:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5655:                const double vnorm = dot(side->u2[k], side->n);
 5656: 
 5657:                double rat;
 5658:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5659:                else              rat = segment->vobc2; // outgoing
 5660: 
 5661:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5662: 
 5663:             }
 5664:             else { // not Flather or 3D radiation
 5665:                side->u2[k] = ubc[k];
 5666: 
 5667:             } // if (segment->ifltype...
 5668: 
 5669:          }
 5670: 
 5671:       }
 5672:       else if (isLand) { // if it is land boundary side
 5673: 
 5674:          if constexpr(islip == 0) { // free slip
 5675: 
 5676:             for (int k = kb; k < nvrt; k++) {
 5677: 
 5678:                const Vector2 t = side->t();
 5679:                const Vector2 n = side->n;
 5680: 
 5681:                double vnorm = 0.0; // for most cases
 5682:                const double vtan = dot(side->u2[k], t);
 5683:                
 5684:                side->u2[k] = vtan*t - vnorm*n;
 5685: 
 5686:             }
 5687: 
 5688:          } else { // no slip
 5689:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5690: 
 5691:          }
 5692:       } // if (side segment type...
 5693: 
 5694:    
 5695: 
 5696:    }
 5697: 
 5698: 
 5699:    __global__ void shapiroFilter1(void) {
 5700:       // First step of the Shapiro filter (normally used if indvel<=0)
 5701:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5702: 
 5703:       SIDE(side);
 5704: 
 5705:       // Only internal wet sides are processed
 5706:       if (side->isDry || !(side->isInternal())) return;
 5707: 
 5708:       const int kb = side->kb;
 5709: 
 5710:       for (int mm = 0; mm < niter_shap; mm++) {
 5711: 
 5712:          for (int k = kb + 1; k < nvrt; k++) {
 5713:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5714:             Vector2 suru = {0.0, 0.0};
 5715: 
 5716:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5717: 
 5718:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5719: 
 5720:                int kin = k;
 5721:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5722:                
 5723:                if constexpr(ics==1) {
 5724:                   suru += nSide->u2[kin];
 5725: 
 5726:                } else {
 5727:                   assert(false && "Not implemented: ics == 2");
 5728:                   // Vector2 vn1, vn2;
 5729:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5730:                   // suru=suru+vn1;
 5731:                   // surv=surv+vn2;
 5732:                }
 5733:             }
 5734: 
 5735: 
 5736:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5737: 
 5738:          }
 5739:       }
 5740:    }
 5741: 
 5742:    __global__ void shapiroFilter2(void) {
 5743:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5744: 
 5745:       SIDE(side);
 5746: 
 5747:       if (side->isDry || !(side->isInternal())) return;
 5748: 
 5749:       const int kb = side->kb;
 5750: 
 5751:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5752: 
 5753:       if (side->is2D()) {
 5754:          side->u2[kb + 1] = side->bcc[kb + 1];
 5755:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5756: 
 5757:       } else {
 5758:          // 3D
 5759:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5760:          
 5761:       }
 5762: 
 5763:    }
 5764: 
 5765: 
 5766:    __global__ void ul0UpdateZCoords(void) {
 5767:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5768:       
 5769:       NODE(node);      
 5770: 
 5771: 
 5772:       if (node->isDry2()) { 
 5773: 
 5774:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5775: 
 5776:          if constexpr(ivcor != 1) node->kb = 0;
 5777: 
 5778:       } else {
 5779: 
 5780:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5781:          node->updateKb();
 5782: 
 5783:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5784: 
 5785:       }
 5786: 
 5787:       // We use the temp.b field to store the previous state of isDry.
 5788:       node->tmp.b = node->isDry;
 5789: 
 5790:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5791:       node->isDry = true;
 5792: 
 5793:    }
 5794: 
 5795:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5796:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5797:    {
 5798:       ELEM(elem);
 5799: 
 5800:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5801: 
 5802:       // All the nodes of a wet element are wet.
 5803:       if (!elem->isDry) {
 5804:          elem->nodes[0]->isDry = false;
 5805:          elem->nodes[1]->isDry = false;
 5806:          elem->nodes[2]->isDry = false;
 5807:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5808: 
 5809:       }
 5810: 
 5811: 
 5812:       elem->kb = 0;
 5813: 
 5814:       if (elem->isDry) return;
 5815: 
 5816:       // Wet
 5817:       const Node *n1 = elem->nodes[0];
 5818:       const Node *n2 = elem->nodes[1];
 5819:       const Node *n3 = elem->nodes[2];  
 5820:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5821: 
 5822:    //    if(elem->isDry2()) { // XXXX
 5823:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5824:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5825:    //        call parallel_abort(errmsg)
 5826:    //    }
 5827: 
 5828: 
 5829:       // Computes element's kb as the minimum of the nodes' kb.
 5830:       const int kb1 = n1->kb;
 5831:       const int kb2 = n2->kb;
 5832:       const int kb3 = n3->kb;
 5833:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5834: 
 5835: 
 5836:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5837: 
 5838: 
 5839:       // Computes the element z as the mean of the nodes z.
 5840:       for (int k = elem->kb; k < nvrt; k++) {
 5841: 
 5842:          // Compute the element z as the mean of the nodes z.
 5843:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5844:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5845:          elem->z[k] /= elem->i34;
 5846: 
 5847:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5848:       }
 5849:                   
 5850:    }
 5851: 
 5852:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5853:    {
 5854:       NODE(node);
 5855:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5856: 
 5857:       if (it == iths) return;
 5858: 
 5859: 
 5860:       if(!node->isDry && node->tmp.b) { // rewetted
 5861:          for (int k=0; k < nvrt; k++) {
 5862: 
 5863:             Vector3 utmp={0.0, 0.0, 0.0};
 5864: 
 5865:             double ttmp=0.0;
 5866:             double stmp=0.0;
 5867:             int icount=0;
 5868:             for (int j = 0; j < node->numNodes; j++) {
 5869: 
 5870: 
 5871:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5872:                if (!node->isDry) { // all indices extended
 5873:                   icount++;
 5874: 
 5875:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5876:                   utmp += node->uvw2(k);
 5877:                   
 5878:                   ttmp += node->tracers[k].tracer[0]; 
 5879:                   stmp += node->tracers[k].tracer[1]; 
 5880:                }
 5881:             }
 5882: 
 5883:             if(icount > 0) {
 5884:                const double inv_icount = 1.0/icount;
 5885:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5886:                node->w2[k]     = inv_icount*utmp.z;
 5887:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5888:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5889:             }
 5890:          }
 5891:       }
 5892:    }
 5893: 
 5894: 
 5895:    __global__ void ul0UpdateSides(int it, int iths) {
 5896: 
 5897:       SIDE(side);
 5898: 
 5899:       // A side is wet if and only if at least one of its elements is wet.
 5900:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5901:  
 5902:       const Node *n1 = side->n1;
 5903:       const Node *n2 = side->n2;
 5904:      
 5905:       const int kb1 = n1->kb;
 5906:       const int kb2 = n2->kb;
 5907: 
 5908:       side->kb = 0; // dry
 5909: 
 5910:       if (isWet) {
 5911: 
 5912:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5913: 
 5914:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5915: 
 5916:          side->kb = min(kb1, kb2);
 5917: 
 5918:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5919: 
 5920:          for (int k = side->kb; k < nvrt; k++) {
 5921:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5922: 
 5923:          
 5924:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5925: 
 5926:             // Compute velocity for re-wetted sides 
 5927:             if ((it != iths) && (side->isDry && isWet)) {
 5928:             
 5929:                Vector2 utmp={0.0, 0.0};
 5930: 
 5931:                int icount=0;
 5932: 
 5933:                // For all the sides on the two elements that share this side
 5934:                for (int j=0; j < 2; j++) {
 5935:                   const Element *elem = side->elems[j];
 5936:                   if (elem == nullptr) continue;
 5937: 
 5938:                   for (int jj=0; jj < elem->i34; jj++) {
 5939:                      const Side *nSide = elem->sides[jj];
 5940:                      if (nSide->isDry) continue;
 5941: 
 5942:                      icount++;
 5943:                      utmp += nSide->u2[k];                     
 5944:                   }
 5945:                }
 5946:                   
 5947:                assert(icount > 0 && "No wet sides around this side");
 5948:                if (icount > 0)  side->u2[k] = utmp/icount;
 5949:                   
 5950:             } // if ((it != iths) && (side->isDry && isWet))
 5951: 
 5952:          } // for k
 5953: 
 5954:       } // if isWet
 5955:    
 5956:       side->isDry = !isWet;
 5957: 
 5958:    }
 5959: 
 5960: 
 5961:    __global__ void zeroNodalVelocities(void) {
 5962:       NODE(node);
 5963: 
 5964:       for (int k = 0; k < nvrt; k++) {
 5965:          node->u2[k]   = {0.0, 0.0};
 5966:          node->w2[k]   = 0.0;
 5967:          node->utmp[k] = {0.0, 0.0};
 5968:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5969:       }
 5970:    }
 5971: 
 5972:  
 5973: 
 5974:    __global__ void computeNodalVerticalVelocities1(void) {
 5975:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5976:    // Adds the element's vertical velocity times the element's area.
 5977:       ELEM(elem);
 5978: 
 5979:       for (int j = 0; j < elem->i34; j++) {
 5980:          Node *node = elem->nodes[j];
 5981: 
 5982:          for (int k = node->kb; k < nvrt; k++) {
 5983:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5984:          }
 5985:          atomicAdd(&(node->tmp.d), elem->area);
 5986:       }
 5987:    }
 5988: 
 5989:    __global__ void computeNodalVerticalVelocities2(void) {
 5990:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5991:    // Divides by the total area of the elements sharing the    node.
 5992:       NODE(node);
 5993: 
 5994:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5995:    }
 5996: 
 5997: 
 5998:    __global__ void computeNodalHorizontalVelocities1(void) {
 5999:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6000:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6001: 
 6002:       ELEM(elem);
 6003: 
 6004:       const int kb = elem->kb;
 6005:       const bool isTri = elem->isTri();
 6006: 
 6007:       if constexpr(indvel <= 0) {
 6008:          // Assuming discontinoius hvel.
 6009: 
 6010: 
 6011:          if (isTri) { // For triangles
 6012:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6013:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6014: 
 6015:             for (int j = 0; j < 3; j++) {
 6016:                // For every node of the triangle...
 6017:                Node *node = elem->nodes[j];
 6018: 
 6019:                const Side *s1 = elem->sides[j];
 6020:                const Side *s2 = elem->sides[(j + 1) % 3];
 6021:                const Side *s3 = elem->sides[(j + 2) % 3];
 6022: 
 6023:                const int numElements = node->numElements;
 6024:                const double inv_numElements = 1.0/numElements;
 6025: 
 6026:                for (int k = kb; k < nvrt; k++)  {
 6027:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6028:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6029:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6030:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6031:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6032:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6033: 
 6034:                }
 6035: 
 6036:             }
 6037:          }
 6038:          else { // For quads
 6039:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6040: 
 6041:          }
 6042: 
 6043:       }
 6044:       
 6045:    }
 6046: 
 6047: 
 6048:    __global__ void computeNodalHorizontalVelocities2(void) {
 6049:       NODE(node);
 6050: 
 6051:       for (int k = 0; k < nvrt; k++) {
 6052:          node->u2[k] = node->utmp[k];
 6053:          node->w2[k] = node->w2[k];
 6054:       }
 6055:       
 6056:    }   
 6057: 
 6058:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6059:    // XXXX I'm not sure where I got this function from. 
 6060:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6061:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6062:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6063:    // It uses the utmp array as a temporary array to store the velocities.
 6064: 
 6065:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6066: 
 6067:       SIDE(side);
 6068: 
 6069:       const int kb = side->kb;
 6070: 
 6071:       Node *n1 = side->n1;
 6072:       Node *n2 = side->n2;
 6073: 
 6074:       for (int k = kb; k < nvrt; k++) {
 6075: 
 6076:          // Cast the u2 vector into a Vector2 
 6077:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6078:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6079: 
 6080:          n1_u2 = side->u2[k]/n1->numSides;
 6081:          n2_u2 = side->u2[k]/n2->numSides;
 6082: 
 6083:       }
 6084: 
 6085: 
 6086:    }
 6087: 
 6088:    __global__ void resetVelocityOpenBndNodes(void) {
 6089:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6090: 
 6091:       NODE_BND(nodebnd);
 6092: 
 6093:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6094:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6095:       }
 6096: 
 6097:    }
 6098: 
 6099: 
 6100:    __global__ void setVelocityOpenBndNodes(void) {
 6101:    // For open boundary nodes sets their velocity to the imposed values.
 6102: 
 6103:       SIDE_BND(sidebnd);
 6104: 
 6105:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6106:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6107:          // to its segment to the average of the side velocity.
 6108: 
 6109:          for (int k = 0; k < nvrt; k++) {
 6110:             Node *n1 = sidebnd->side->n1;
 6111:             Node *n2 = sidebnd->side->n2;
 6112: 
 6113: 
 6114:             Vector2 n1_u2(n1->u2[k]);
 6115:             Vector2 n2_u2(n2->u2[k]);
 6116: 
 6117:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6118:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6119:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6120:             }
 6121:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6122:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6123:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6124:             }
 6125: 
 6126:          }
 6127: 
 6128:       }
 6129: 
 6130:    }
 6131: 
 6132: 
 6133:    __global__ void computeVerticalVelocity(void) {
 6134:       // Computes the vertical velocity at the (2D) element's centroid.
 6135:       // In this function we will be considering volumetric elements, with side faces and a 
 6136:       // bottom and a top face. We will call them SFs, BF and TF.
 6137:       // It computes the flux coming from BF and the SFs.
 6138:       // If the bed is moving, it takes that into account.
 6139:       // Since water is incompressible, the integral of the velocity times the normal vector
 6140:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6141:       // and the BF is equal to the flux going out from the TF.
 6142:       // TF = - BF - sum(SFs).
 6143:       // It then computes the horizontal velocity at the center of TF.
 6144:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6145:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6146:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6147: 
 6148:       ELEM(elem);
 6149: 
 6150:       if (elem->isDry) return;
 6151: 
 6152:       const int kb = elem->kb;
 6153:       const bool isTri = elem->isTri();
 6154: 
 6155:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6156: 
 6157:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6158:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6159:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6160: 
 6161:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6162: 
 6163:       double area3D;
 6164: 
 6165:       // Bottom face flux
 6166:       double bottomFlux = 0.0;
 6167:       Vector2 u2meanBottom = {0.0, 0.0};
 6168:       const Vector2 gradh = elem->grad2(&Node::depth);
 6169:       if constexpr(imm==2) {
 6170:          Vector3 ubed;
 6171: 
 6172:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6173:          // updateBDEF(ubed);
 6174:      
 6175:          // const double bflux0 = dot(ubed, elem_n1);
 6176: 
 6177:          // elem->w[kb] += ubed.z;
 6178:       }
 6179:       else {
 6180:          Vector2 umean;
 6181:          if constexpr(ics == 1) {
 6182:             u2meanBottom = elem->mean(kb, &Side::u2);
 6183:          }
 6184:          else {
 6185:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6186:          }
 6187: 
 6188:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6189:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6190: 
 6191:          bottomFlux = - dot(gradh, u2meanBottom);
 6192:       } // if imm
 6193: 
 6194:       // Compute w for kb+1 to nvrt-1
 6195:       for (int l = kb; l < nvrt - 1; l++) {
 6196: 
 6197:          // normal vector to the top face of the "volumetric" element (3D)
 6198:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6199: 
 6200:          // Compute the total flux at the sides
 6201:          double sideFlux = 0.0;
 6202:          Vector2 u2top = {0.0, 0.0};
 6203:          for (int j = 0; j < elem->i34; j++) {
 6204:             const Side *side = elem->sides[j];
 6205: 
 6206:             const double sideArea = side->area(l);
 6207:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6208:             const double sign = elem->ssign[j]; 
 6209: 
 6210:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6211:          }
 6212:          
 6213:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6214:          //velocities at the centers of the sides
 6215:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6216: 
 6217:          // The flx at the top ace can be computed from the other flows.
 6218:          const double topFlux = - sideFlux - bottomFlux;
 6219:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6220: 
 6221:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6222: 
 6223:          elem_n1 = elem_n2;
 6224: 
 6225:          bottomFlux = - topFlux;
 6226:       }
 6227:    }  
 6228: 
 6229: 
 6230: 
 6231: 
 6232: 
