 4402: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4403: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4404:    
 4405: //    ibelow = 0;
 4406: 
 4407: //    if (zt < za[k1]) {
