  379: 
  380: struct Frame {
  381:    double _t[9]; // t stands for tensor.
  382: 
  383:    // Access the tensor in Fortran order
  384:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  385: 
  386:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  387: 
  388:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  389: 
  390:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  391:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  392:       sincos(ar2, &sin_ar2, &cos_ar2);
  393: 
  394:       t(0,0) = -sin_ar1;
  395:       t(1,0) =  cos_ar1;
  396:       t(2,0) =  0.0;
  397:       t(0,1) = -cos_ar1*sin_ar2;
  398:       t(1,1) = -sin_ar1*sin_ar2;
  399: 
  400:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  401: 
  402:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  403:       assert (ar4!=0.0 && "GRID: ar4=0");
  404: 
  405:       const double ar4_inv = 1.0/ar4;
  406:       t(0,1) = t(0,1)*ar4_inv;
  407:       t(1,1) = t(1,1)*ar4_inv;
  408:       t(2,1) = t(2,1)*ar4_inv;
  409: 
  410:       // The third vector is the cross product of the first two
  411:       crossProduct(t(0,0), t(1,0), t(2,0), 
  412:                    t(0,1), t(1,1), t(2,1), 
  413:                    t(0,2), t(1,2), t(2,2));
  414:    }
  415: 
  416: 
  417:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  418:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  419:    // Inputs:
  420:    //        vec0: vel. in this frame;
  421:    //        frameout: Output frame;
  422:    // Output: 
  423:    //        vec1: vel. in new frame  
  424: 
  425:       auto const fo = frameout;
  426:       Vector2 vec1;
  427: 
  428:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  429:       // of t and fo.t are the same.
  430:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  431:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  432: 
  433:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  434:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  435: 
  436:       return vec1;
  437:    }
  438: 
  439:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  440:       // Transform a vector from global to local frame
  441:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  442:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  443:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  444:    }
  445: 
  446:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  447:       // Transform a vector from local to global frame
  448:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  449:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  450:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  451:    }   
  452: 
  453:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  454:    // Tranforms a point from global to local frame     
  455:       G2L(pi - origin0, po);
  456:    }
  457: 
  458:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  459:    // Transforms a point from local to global frame      
  460:       L2G(pi, po);
  461:       po = po + origin0;
  462:    }
  463: 
  464: };
