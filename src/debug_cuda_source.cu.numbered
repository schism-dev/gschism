 2175: /**
 2176:  * This method performs backtracking from the side center until a time -dt back in time 
 2177:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2178:  * intermediate point.
 2179:  *
 2180:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2181:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2182:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2183:  * remaining time.
 2184:  * 
 2185:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2186:  * 
 2187:  * @param uuint, vvint, wwint: Velocities at the final point
 2188:  * @param jlev: Level at which the backtracking is performed
 2189:  * @param dt, dtbk: Tracking timesteps
 2190:  * @return: True if the backtracking was successful, false otherwise
 2191:  */
 2192: __inline__ __device__ bool Side::btrack(
 2193:       int jlev,
 2194:       double dt,            // Tracking time
 2195:       double dtbk,          // Tracking timestep
 2196:       Vector3 &u_int
 2197: ) const {
 2198: 
 2199:    // Start from side center
 2200:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2201:  
 2202: 
 2203:    double time_rm = dt; // Remaining time
 2204: 
 2205: 
 2206:    // // Initialize outputs XXX
 2207:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2208:    //    sclr[i] = 0.0;
 2209:    // }
 2210: 
 2211: 
 2212:    // Initial velocities
 2213:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2214: 
 2215: // printf("YY 1, u_int = %f,%f\n", u_int.x, u_int.y);
 2216: 
 2217:    // Find the element that is in the direction opposite to the velocity
 2218:    Element* curElem = findElementTowards({u_int.x, u_int.y});
 2219: // printf("YY 2, curElem = %p\n", curElem);
 2220:    const int MAX_ITERATIONS = 1000; 
 2221:    Element* nextElem = curElem;
 2222:    int iter = 0;
 2223:    while(true) {
 2224:       // Calculate timestep
 2225:       double dtb = min(dtbk, time_rm);
 2226: 
 2227:       // Next point in the backtracking curve
 2228:       Point3 xt = x0 - dtb*u_int;
 2229: // printf("YY 3, dtb = %f, curElem = %p, u_int = %f,%f,%f\n", dtb, curElem, u_int.x, u_int.y, u_int.z);
 2230:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2231: // printf("YY 4, found = %d\n", found);
 2232:       assert(found && "Backtracking failed in btrack");
 2233: // printf("<>T = %f, %f %f %f\n", time_rm - dtb, xt, yt, zt);
 2234:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2235:                       // then time_rm needs to be increased by the unused time.
 2236:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2237: 
 2238:       // The current point becomes the next segment's starting point.
 2239:       x0 = xt;
 2240:  
 2241:       curElem = nextElem;
 2242: 
 2243:       iter++;
 2244:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2245:    }
 2246: 
 2247: 
 2248: }
 2249: 
