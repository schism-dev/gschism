 7257: #ifdef DONTCOMPILE
 7258: __device__ void computeVerticalAdvection(void) {
 7259:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7260: 
 7261:    sdbt(1:2,:,:)=0.d0
 7262: 
 7263:    const Side *side = FROM kernel;
 7264: 
 7265:    if(side->isDry) return;
 7266: 
 7267:    // If side is wet...
 7268: 
 7269: 
 7270:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7271:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7272:    double ws[nvrt] = {} // w @ side
 7273:    int icount = 0;
 7274:    for (int j=0; j<2; j++) {
 7275:       const Element *elem = side->elements[j];
 7276:        
 7277:       if(elem != nullptr) {
 7278:          icount++;
 7279:          for (int k=0; k<nvrt; k++) {
 7280:             ws[k] = ws[k] + elem->w[k];
 7281:          }
 7282:       }
 7283:    }  // for j
 7284: 
 7285:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7286:    ws = ws/icount;
 7287: 
 7288:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7289:    // Splines allow for a smooth transition between vertical levels.
 7290:    // Splines have continuity restrictions at the internal knots, but
 7291:    // we have to provide the 1st derivatives at the endpoints.
 7292:    const int kbs = side->kbs; 
 7293:    
 7294:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7295:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7296:    initCubicSpline(kbs, nvrt, side, ws, up)
 7297: 
 7298:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7299:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7300:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7301: 
 7302:    // Total advection (average onto side)
 7303:    const Node *node1 = side->nodes[0];
 7304:    const Node *node2 = side->nodes[1];
 7305:    for (int k=kbs(i); k<nvrt; k++) {
 7306: 
 7307:       Vector2 bcc1 = node1->bcc[k];
 7308:       Vector2 bcc2 = node2->bcc[k];
 7309:       if constexpr(ics == 2) {
 7310:          // Project the velocities from the node frames to the side frame
 7311:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7312:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7313:       }
 7314: 
 7315:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7316:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7317: 
 7318:    }
 7319: }
 7320: #endif
 7321: 
 7322: 
 7323: extern "C" {
 7324:    __global__ void computeElemAverageGhat(void) {
 7325:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7326: 
 7327:       ELEM(elem);
 7328:       
 7329:       elem->ghat1= {0.0, 0.0};  
 7330: 
 7331:       if constexpr(ihydraulics != 0) {
 7332:          if (nhtblocks > 0 && elem->isblock) return;
 7333:       }
 7334: 
 7335:       
 7336:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7337:       // cff1-3: coefficients for 2D/3D
 7338: 
 7339:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7340:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7341:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7342: 
 7343:       if (elem->isDry) return;
 7344: 
 7345:       // Average of the coefficients
 7346:       double av_cff1 = 0.0;  // av. for cff1
 7347:       double av_cff2 = 0.0;  // av. for cff2
 7348:       double av_cff3 = 0.0;  // av. for cff3
 7349:       double av_df = 0.0;  // av. for H^\alpha / H
 7350:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7351:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7352: 
 7353:       const int i34 = elem->i34;
 7354:       const int kb  = elem->kb;
 7355: 
 7356:       for (int j=0; j<i34; j++) {
 7357:          // For each node and side in the element...
 7358: 
 7359:          const Node *node = elem->nodes[j];
 7360:          const Side *side = elem->sides[j];
 7361: 
 7362:          const double chi      = side->chi;
 7363:          const double veg_c2   = side->veg_c2;
 7364:          const double veg_beta = side->veg_beta;
 7365:          const double veg_h    = side->veg_h();
 7366:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7367: 
 7368:          const Vector2 gradPhi = elem->gradPhi[j];
 7369: 
 7370:          // Node - const in elem
 7371:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7372:          elem->gradPr  += node->pr  *gradPhi;
 7373: 
 7374:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7375: 
 7376:         
 7377:          const double htot  = side->htot2();        // Total depth at the side
 7378:          const double zctr2 = side->zTopCanopy();  
 7379: 
 7380:          double cff1; 
 7381:          double cff2; 
 7382:          double cff3;   
 7383:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7384:          // coefficients applied to 2D/3D case 
 7385:             cff1 = side->hhat/htot;
 7386:             cff2 = 0.0;
 7387:             cff3 = 0.0;
 7388:          } else { //3D
 7389:             //Init for no-veg case
 7390:             cff1 = 1.0;
 7391:             cff2 = 1.0;
 7392:             cff3 = 0.0;
 7393: 
 7394:             if constexpr(iveg != 0) {
 7395:                // Computes coefficients used with vegetation terms G1, G2
 7396:                // cff1, cff3 are used for the first two terms in G1, G2:
 7397:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7398:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7399:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7400:                if(veg_h < 0.99*htot) { // submergent vegetation
 7401:                   cff1 = 1.0;
 7402:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7403:                   cff3 = veg_c;
 7404: 
 7405:                } else { // emergent vegetation
 7406:                   cff1 = 1.0/(1.0 + veg_c2);
 7407:                   cff2 = cff1;
 7408:                   cff3 = 0.0;
 7409: 
 7410:                }
 7411:             } // if iveg
 7412:          } //  2D/3D
 7413: 
 7414:          av_cff1 += cff1/i34;
 7415:          av_cff2 += cff2/i34;
 7416:          av_cff3 += cff3/i34;
 7417:          av_cff2_chi += cff2*chi/i34;
 7418:          av_cff3_chi += cff3*chi/i34;
 7419:          av_df += min(htot, veg_h)/(htot*i34);
 7420: 
 7421: 
 7422:          // btrack values: U^\star, U^{\star\alpha}
 7423:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7424:          Vector2 Ustar       = {0.0, 0.0}; 
 7425:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7426: 
 7427:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7428:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7429:          } else { //3D
 7430:             for (int k = side->kb + 1; k < nvrt; k++) {
 7431:             
 7432:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7433:                Ustar += w2;
 7434: 
 7435:                if constexpr(iveg != 0) {
 7436:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7437:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7438:                        Ustar_alpha += zrat*w2; // XXXX
 7439:                    }
 7440:                }  // if iveg
 7441:             }  // for k
 7442:          }  //2D/3D
 7443: 
 7444:          // If needed, project the side velocities to the element frame
 7445:          if constexpr(ics==2) {
 7446:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7447:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7448:          }
 7449:         
 7450: 
 7451:          // Add btrack & surface stress terms to \breve{G} first
 7452:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7453: 
 7454: 
 7455:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7456:          Vector2 tau    = side->tau();  
 7457:          Vector2 ubstar = side->btu[side->kb + 1];  
 7458: 
 7459:          // If needed, project tau and ubstar to the element frame
 7460:          if constexpr(ics==2) {
 7461:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7462:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7463:          }
 7464: 
 7465:          // Term for surface and bottom stress
 7466:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7467: 
 7468: 
 7469:          // All terms in F,F^\alpha,f_b except baroclinic
 7470:          // F, f_b: all explicit terms excluding vegetation 
 7471:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7472:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7473:          const double coriolis = side->coriolis;
 7474:          Vector2 F  =  coriolis*side->U;  // F_x
 7475:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7476:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7477: 
 7478:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7479:             
 7480:             for (int k = side->kb; k < nvrt; k++) {
 7481:                if (zctr2 > side->zc[k-1]) {
 7482:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7483:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7484:                    Fa +=  coriolis*w2*zrat;
 7485:                } // if zctr2
 7486:             } // k
 7487:          } // iveg
 7488: 
 7489:          // Integrate horizontal viscosity force vertically
 7490:          for (int k=side->kb + 1; k<nvrt; k++) {
 7491:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7492: 
 7493:             F += levelHorVisc;
 7494: 
 7495:             // Vegetation term
 7496:             if constexpr(iveg!=0) {
 7497:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7498:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7499:                   Fa += levelHorVisc*zrat;
 7500:                } 
 7501:             } // if iveg
 7502:          } // for k
 7503: 
 7504:          // Get nu*grad(U) at the side's bottom level
 7505:          Vector2 nuGradU = side->nuGradU[side->kb];
 7506: 
 7507:          fb += nuGradU;
 7508: 
 7509:          // If needed, project vectorsF, fb and Fa to the element frame
 7510:          if constexpr(ics==2) {
 7511:             F    = side->frame.projHorVec(F,    elem->frame);
 7512:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7513:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7514:          } // if ics
 7515: 
 7516:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7517:       } // for j (nodes and sides)
 7518: 
 7519:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7520: 
 7521: 
 7522:       // Finish off terms in F, F^\alpha and f_b
 7523:       const double grav3 = elem->mean(&Node::grav2);
 7524:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7525:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7526:       for (int j=0; j<i34; j++) { 
 7527:          // For each side in the element...
 7528:          const Side *side = elem->sides[j];
 7529:          const double chi = side->chi;
 7530: 
 7531:          const double htot = side->htot2();
 7532:          const double veg_h = side->veg_h();
 7533:          const Vector2 F  = htot*fb;
 7534:          const Vector2 Fa = min(htot, veg_h)*fb;
 7535: 
 7536:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7537:       } // for j
 7538: 
 7539:       // tmp is already in elem frame
 7540:       elem->ghat1 += tmp/i34;
 7541: 
 7542:       // Baroclinic force
 7543:       if constexpr(ibc==0) {
 7544:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7545: 
 7546:          Vector2 Fa = {0.0, 0.0};
 7547:          Vector2 intGradRho = {0.0, 0.0};
 7548:          
 7549:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7550:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7551:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7552: 
 7553:             // \in F [m^2/s/s]
 7554:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7555:          }
 7556: 
 7557:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7558:          const Vector2 F = av_df*Fa; //approx
 7559:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7560: 
 7561:       } // if ibc
 7562: 
 7563: 
 7564: 
 7565:    }
 7566: 
 7567: } // extern "C"
 7568: 
 7569: 
 7570: 
 7571: #ifdef DONTCOMPILE
 7572: __global__ void checkMassConservation(Tracers* sumtr) {
 7573: 
 7574:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7575: 
 7576:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7577: 
 7578:    Element *elem = &(mesh->localElemData[i]);
 7579: 
 7580:    // Skip dry elements
 7581:    if (elem->isDry) return;
 7582: 
 7583:    // Local sum array for this thread
 7584:    double localSum[N_TRACERS] = {0.0};
 7585: 
 7586:    // Sum over vertical levels for this element
 7587:    const int kbe = elem->kbe;
 7588:    const double area = elem->area;
 7589: 
 7590:    for (int k = kbe; k < nvrt; k++) {
 7591:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7592:       
 7593:       // Accumulate tracer mass
 7594:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7595:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7596:       }
 7597:    }
 7598: 
 7599:    //  This function returns per element sums. A reduction must be done on the host side.
 7600: }
 7601: 
 7602: 
 7603: __global__ void transport(void) {
 7604: 
 7605:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7606: 
 7607:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7608: 
 7609:    Element *elem = &(mesh->localElemData[ie]);
 7610: 
 7611:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7612: 
 7613:                for (int m=0; m<ntr; m++) {
 7614:                   for (int k=kbe(ie); k<nvrt; k++) {
 7615:                      // Calculate each polynomial's weight 
 7616:                      wm=0.d0; sum1=0.d0; 
 7617:                      wm1=0.d0; wm2=0.d0; 
 7618:                      for (int i=0; i<elem->nweno2; i++) {
 7619:                   
 7620:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7621:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7622:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7623:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7624:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7625:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7626:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7627:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7628:                      // -----------------Hu and Shu (1999)'s method----------------
 7629:                      b4=b1+b2+b3
 7630: 
 7631: //Error: add PRODUCTION CPP
 7632: #ifdef DEBUG
 7633:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7634:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7635:                     call parallel_abort(errmsg)
 7636:                   }
 7637: #endif
 7638: 
 7639:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7640:                   // !----test-------------- 
 7641:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7642:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7643:                   // !wm(i)=wm1(i)*wm2(i)
 7644:                   // !---------------------- 
 7645:                   sum1=sum1+wm(i)
 7646:                 } // end for i
 7647: 
 7648:                 wm=wm/sum1
 7649: 
 7650:                 for (int j=0; j<elem->i34; j++) {
 7651: 
 7652:                   const Side *side  = elem->sides[j];
 7653:                   const Node *node1 = side->n1;
 7654:                   const Node *node2 = side->n2;
 7655: 
 7656:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7657:                      trsd=0.d0
 7658:                      for (int kk=0; kk<nquad; kk++) {
 7659:                         for (int i=0; i<elem->nweno2; i++) {
 7660:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7661:                         } // end for i   
 7662:                      } // end for kk
 7663:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7664:                   } // outward flux
 7665:                } // end for j=1,i34(ie) ! side
 7666:             }
 7667:          }
 7668:               
 7669: 
 7670: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7671: //             //   calculate each polynomial's weight 
 7672: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7673: //                 wm=0.d0; sum1=0.d0
 7674: //                 do i=1,nweno1(ie) !for each polynomial
 7675: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7676: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7677: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7678: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7679: //                   wm(i)=b2
 7680: //                   sum1=sum1+b2
 7681: //                   !wm(i)=1.d0
 7682: //                   !sum1=sum1+1.d0
 7683: 
 7684: // // Error: PRODUCTION
 7685: // #ifdef DEBUG
 7686: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7687: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7688: //                     call parallel_abort(errmsg)
 7689: //                   endif
 7690: // #endif
 7691: 
 7692: //                 enddo !i
 7693: //                 wm=wm/sum1 !final weight
 7694: 
 7695:                 for (int j=0; j<elem->i34; j++) { // side
 7696:                   const Side *side = elem->sides[j];
 7697:                   const Node *node1 = side->n1;
 7698:                   const Node *node2 = side->n2;
 7699: 
 7700:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7701:                     trsd=0.d0
 7702:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7703:                       for (int i=0; i<elem->nweno1; i++) {
 7704:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7705:                       }
 7706:                     enddo //kk
 7707:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7708:                   } // outward flux
 7709:                 } // end for j=1,i34(ie) ! side
 7710:               } // end for k; ntr 
 7711: 
 7712:             else !simple upwind method
 7713:               do j=1,i34(ie)
 7714:                 jsj=elside(j,ie)
 7715:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7716:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7717:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7718:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7719:                   endif
 7720:                 enddo  !vertical layers
 7721:               enddo !j=1,i34(ie) ! side
 7722:             endif !order of accuracy
 7723: 
 7724:          //  enddo !ie
 7725: // !$OMP     end do
 7726: 
 7727: // !$OMP     master
 7728: //           !message passing
 7729: //           if (nproc>1) then
 7730: //             !make a copy of side concentrations
 7731: //             trsd_tmp0=trsd_tmp 
 7732: 
 7733: //             !this exchange routine swaps interface concentration between two partitions
 7734: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7735: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7736: 
 7737: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7738: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7739: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7740: 
 7741: 
 7742: //             !This obtains final values for interface sides
 7743: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7744: //       :    endif !nproc>1
 7745: //           !message passing end
 7746: // !$OMP     end master
 7747: // !$OMP     barrier
 7748: 
 7749: 
 7750: // !         Do advection; conc @ dry elem will not be changed
 7751: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7752: // !$OMP     do reduction(+: h_mass_in)
 7753: //           do i=1,ne
 7754: //             if(idry_e(i)==1) cycle
 7755: 
 7756: 
 7757: // !           Wet elements with 3 wet nodes
 7758: //             do k=kbe(i)+1,nvrt
 7759: 
 7760: 
 7761: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7762: //               dtb_by_bigv = dtb/bigv
 7763:     
 7764: // !             Advective flux
 7765: //               if (ntd_weno==1 .or. itd_weno==1) then
 7766: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7767: //               else
 7768: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7769: //               endif
 7770: 
 7771: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7772: //               do j=1,i34(i)
 7773: //                 jsj=elside(j,i) !side
 7774: //                 iweno=.true. !use weno reconstruction as default
 7775: //                 iel=ic3(j,i) !neighboring elem
 7776: 
 7777: //                 if(iel/=0) then
 7778: //                   if(idry_e(iel)==1) cycle
 7779: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7780: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7781: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7782: //                     iweno=.false.
 7783: //                   endif
 7784: //                 else !land or open bnd side
 7785: //                   !skip land bnd and outflowing open bnd, 
 7786: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7787: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7788: //                     !For outflow open bnd side, estimate mass in (open
 7789: //                     !side cannot be interface side)
 7790: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7791: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7792: //                     endif
 7793: 
 7794: //                     cycle
 7795: //                   endif
 7796: 
 7797: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7798: //                   iweno=.false.  !reset to upwind
 7799: //                   ibnd=isbs(jsj) !global bnd #
 7800: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7801: //                   nwild(1:2)=0
 7802: //                   do ll=1,2 !nodes
 7803: //                     ndo=isidenode(ll,jsj)
 7804: //                     do lll=1,2 !2 possible bnds
 7805: //                       if(isbnd(lll,ndo)==ibnd) then
 7806: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7807: //                         exit
 7808: //                       endif
 7809: //                     enddo !lll
 7810: //                   enddo !ll
 7811: //                   ind1=nwild(1); ind2=nwild(2);
 7812: 
 7813: //                   do jj=1,natrm
 7814: //                     if(ntrs(jj)<=0) cycle
 7815: 
 7816: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7817: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7818: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7819: //                       enddo !ll
 7820: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7821: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7822: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7823: //                       enddo !ll
 7824: //                     else if(itrtype(jj,ibnd)==3) then
 7825: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7826: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7827: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7828: //                       enddo !ll
 7829: //                     else if(itrtype(jj,ibnd)==4) then
 7830: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7831: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7832: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7833: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7834: //                       enddo !ll
 7835: //                     else
 7836: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7837: //   !'
