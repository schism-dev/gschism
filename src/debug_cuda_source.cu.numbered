 9584: extern "C" __global__ void populateSides(int *i34, int *sharedIdxSideBoundary,
 9585:                                          double *node_coords, double *node_coords_ll, bool use_ll,
 9586:                                          double *wind_rotate_angle,   
 9587:                                          int *isdel, int *isidenode, int *isbnd,
 9588:                                          int *nond, int *nlnd, int *iond, int *ilnd,                                  
 9589:                                          int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 9590:                                          int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 9591:                                          int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 9592:                                          int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 9593:                                          int *localNodePart,     int *localElemPart,     int *localSidePart,
