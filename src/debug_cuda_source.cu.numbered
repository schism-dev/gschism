  980: struct Side {
  981: 
  982:    // Geometry information
  983:    int idx;               // Index of the side
  984:    Node *n1, *n2;
  985:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  986: 
  987:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  988:    Vector2 center;        // Location of side center. 
  989:    double zc[nvrt];       // Side center z-coord at each vertical level
  990: 
  991:    Frame frame;
  992: 
  993:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  994:                           // this is nullptr
  995:    
  996:    int kb;                // Bottom index of the side
  997:    bool isDry;            // True if the side is dry
  998:  
  999:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1000: 
 1001:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1002: 
 1003:    // Physical information
 1004:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1005:    Vector2 btu[nvrt];           // Back-tracked velocity
 1006:    Vector2 U;                   // Vertically averaged velocity vector  
 1007: 
 1008:    Vector2 nuGradU[nvrt];          // nu*grad u
 1009: 
 1010:    Vector2 bcc[nvrt];           // Baroclinic term
 1011:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1012: 
 1013:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1014:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1015:    Vector2 gradPr;               // Gradient of pressure
 1016:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1017: 
 1018: 
 1019:    double hhat;                 // \breve{H} in notes
 1020: 
 1021:    double shapiro;
 1022: 
 1023:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1024: 
 1025:    double coriolis;             // Coriolis parameter
 1026: 
 1027:    // Vegetation parameters
 1028:    double veg_c2;
 1029:    double veg_beta;
 1030: 
 1031:    // Bottom drag parameters.
 1032:    double chi;
 1033:    double chi2;
 1034: 
 1035:    __inline__ __device__ double x(double t) const;
 1036:    __inline__ __device__ double y(double t) const;
 1037:    __inline__ __device__ double lon(void) const;
 1038:    __inline__ __device__ double lat(void) const;
 1039:    __inline__ __device__ Point2 p_t(double t) const;
 1040: 
 1041:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1042:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1043:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1044: 
 1045:    __inline__ __device__ Side* neigh(int index) const { 
 1046:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1047:       assert(index >= 0 && index < 4); 
 1048:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1049: 
 1050:       const int ielem = index & 1;           // 0 or 1
 1051:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1052: 
 1053:       const Element* elem = elems[ielem];
 1054: 
 1055:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1056: 
 1057:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1058: 
 1059:    }
 1060: 
 1061:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1062: 
 1063:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1064: 
 1065:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1066:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1067:    __inline__ __device__ int iadv(void) const;
 1068: 
 1069:    __inline__ __device__ double grav3(void) const;
 1070:    
 1071:    __inline__ __device__ double eta2(void) const;
 1072:    __inline__ __device__ double eta1(void) const;
 1073:    __inline__ __device__ double w2(int k) const;
 1074:    __inline__ __device__ double depth(void) const;
 1075:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1076:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1077: 
 1078:    __inline__ __device__ double dfv(int k) const;
 1079: 
 1080:    __inline__ __device__ double veg_h(void)  const;
 1081:    __inline__ __device__ double veg_nv(void) const;
 1082:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1083:    __inline__ __device__ double veg_alpha3D(int k) const;
 1084:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1085: 
 1086:    __inline__ __device__ double Cd(void) const;
 1087: 
 1088:    __inline__ __device__ Vector2 tau(void) const;
 1089: 
 1090:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1091:    
 1092: 
 1093:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1094:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1095:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1096:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1097:    } 
 1098:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1099:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1100:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1101:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1102: 
 1103:    // Get valid starting element (for backtracking)
 1104:    __inline__ __device__ Element* getStartElement() {
 1105:       return elems[0] ? elems[0] : elems[1];
 1106:    }
 1107: 
 1108:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1109:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1110:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1111: 
 1112:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1113: 
 1114:       // Dot product of the negative velocity vector with the side normal vector
 1115:       const double dot_prod1 = -dot(u, n);
 1116: 
 1117:       // Vector from side center to element 0 centroid
 1118:       const Vector2 v2 = elems[0]->center - center;
 1119: 
 1120:       // Dot product of the vector with the side normal vector
 1121:       const double dot_prod2 = dot(v2, n);
 1122: 
 1123:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1124:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1125: 
 1126:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1127:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1128: 
 1129:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1130: 
 1131:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1132:       else                           return !isDry1 ? elems[1] : elems[0];
 1133: 
 1134:  
 1135:    }
 1136: 
 1137:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1138:       // Given an element, returns the other element that shares this side
 1139:       return (elems[0] == elem) ? elems[1] : elems[0];
 1140:    }
 1141: 
 1142:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1143:       // Given a node, returns the other node that shares this side
 1144:       return (n1 == node) ? n2 : n1;
 1145:    }
 1146:  
 1147:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1148: 
 1149: 
 1150: 
 1151: 
 1152: };
 1153: 
 1154: 
 1155: // This struct is used to store the boundary information for a node.
 1156: struct NodeBoundary {   
 1157:    int idx;
 1158:    BoundarySegment *segment;
 1159:    Node *node;
 1160:    
 1161:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1162:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1163: 
 1164:    bool isLand;
 1165: 
 1166:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1167:    double elbc;   // Elevation boundary condition
 1168:    double eth;    // Elevation time history
 1169: 
 1170:    double eta_mean; // Mean elevation at nodes
 1171: 
 1172:    bool isEssentialBC;
 1173: 
 1174:    Vector2 uth[nvrt];  // "Time history" velocity
 1175: 
 1176:    // Arrays for harmonic constituents (if needed)
 1177:    double  emo[nbfr];  // Elevation amplitude
 1178:    double  efa[nbfr];  // Elevation phase
 1179:    Vector2 umo[nbfr];  // velocity amplitude
 1180:    Vector2 ufa[nbfr];  // velocity phase
 1181: 
 1182: 
 1183:    NodeBoundary(void) {
 1184:       isLand = false;
 1185:    }
 1186:    NodeBoundary(bool _isLand) {
 1187:       isLand = _isLand;
 1188:    }
 1189: 
 1190:    
 1191:    __forceinline__ __device__ int numSidesForAverage() const {
 1192:    // Returns the number of sides that are connected to the node and have the same segment.
 1193:    // This is used to compute the average velocity at the node for open boundary nodes.
 1194:       int res = 0;
 1195:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1196:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1197: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1198:       return res;
 1199:    }
 1200: 
 1201: 
 1202:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1203:       assert(index == 0 || index == 1); 
 1204:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1205:    }
 1206: 
 1207: 
 1208: };
