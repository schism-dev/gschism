 6731: #ifdef DONTCOMPILE
 6732: __device__ void computeVerticalAdvection(void) {
 6733:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6734: 
 6735:    sdbt(1:2,:,:)=0.d0
 6736: 
 6737:    const Side *side = FROM kernel;
 6738: 
 6739:    if(side->isDry) return;
 6740: 
 6741:    // If side is wet...
 6742: 
 6743: 
 6744:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6745:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6746:    double ws[nvrt] = {} // w @ side
 6747:    int icount = 0;
 6748:    for (int j=0; j<2; j++) {
 6749:       const Element *elem = side->elements[j];
 6750:        
 6751:       if(elem != nullptr) {
 6752:          icount++;
 6753:          for (int k=0; k<nvrt; k++) {
 6754:             ws[k] = ws[k] + elem->w[k];
 6755:          }
 6756:       }
 6757:    }  // for j
 6758: 
 6759:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6760:    ws = ws/icount;
 6761: 
 6762:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6763:    // Splines allow for a smooth transition between vertical levels.
 6764:    // Splines have continuity restrictions at the internal knots, but
 6765:    // we have to provide the 1st derivatives at the endpoints.
 6766:    const int kbs = side->kbs; 
 6767:    
 6768:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6769:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6770:    initCubicSpline(kbs, nvrt, side, ws, up)
 6771: 
 6772:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6773:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6774:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6775: 
 6776:    // Total advection (average onto side)
 6777:    const Node *node1 = side->nodes[0];
 6778:    const Node *node2 = side->nodes[1];
 6779:    for (int k=kbs(i); k<nvrt; k++) {
 6780: 
 6781:       if constexpr(ics==1) {
 6782:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6783:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6784:       } else {
 6785:          // XXX IMPLEMENT THIS
 6786:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6787:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6788:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6789:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6790:       }  // if ics
 6791: 
 6792: 
 6793:    }
 6794: }
 6795: #endif
 6796: 
 6797: 
 6798: extern "C" {
 6799:    __global__ void computeElemAverageGhat(void) {
 6800:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6801: 
 6802:       ELEM(elem);
 6803:       
 6804:       elem->ghat1= {0.0, 0.0};  
 6805: 
 6806:       if constexpr(ihydraulics != 0) {
 6807:          if (nhtblocks > 0 && elem->isblock) return;
 6808:       }
 6809: 
 6810:       if (elem->isDry) return;
 6811: 
 6812:       // Wet elements.
 6813:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6814:       // tidal potential, horizontal diffusion, and baroclinic etc
 6815:       // Remember to update both fb and F 
 6816:       // If ics=2, ghat1 are in eframe (ll)
 6817:       // cff1-3: coefficients for 2D/3D
 6818:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6819:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6820:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6821: 
 6822:       double av_cff1 = 0.0;  // av. for cff1
 6823:       double av_cff2 = 0.0;  // av. for cff2
 6824:       double av_cff3 = 0.0;  // av. for cff3
 6825:       double av_df = 0.0;  // av. for H^\alpha / H
 6826:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6827:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6828: 
 6829:       const int i34 = elem->i34;
 6830:       const int kb = elem->kb;
 6831: 
 6832:       for (int j=0; j<i34; j++) {
 6833:          // For each node and side in the element...
 6834: 
 6835:          const Node *node = elem->nodes[j];
 6836:          const Side *side = elem->sides[j];
 6837: 
 6838:          const double chi      = side->chi;
 6839:          const double veg_c2   = side->veg_c2;
 6840:          const double veg_beta = side->veg_beta;
 6841:          const double veg_h    = side->veg_h();
 6842:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6843: 
 6844:          // Node - const in elem
 6845:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6846:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6847: 
 6848:          if (elem->depth >= tip_dp) {
 6849:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6850:          }
 6851: 
 6852:          
 6853:          const double htot  = side->htot2();        // Total depth at the side
 6854:          const double zctr2 = side->zTopCanopy();  
 6855: 
 6856:          double cff1; 
 6857:          double cff2; 
 6858:          double cff3;   
 6859:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6860:          // coefficients applied to 2D/3D case 
 6861:             cff1 = side->hhat/htot;
 6862:             cff2 = 0.0;
 6863:             cff3 = 0.0;
 6864:          } else { //3D
 6865:             //Init for no-veg case
 6866:             cff1 = 1.0;
 6867:             cff2 = 1.0;
 6868:             cff3 = 0.0;
 6869: 
 6870:             if constexpr(iveg != 0) {
 6871:                // Computes coefficients used with vegetation terms G1, G2
 6872:                // cff1, cff3 are used for the first two terms in G1, G2:
 6873:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6874:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6875:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6876:                if(veg_h < 0.99*htot) { // submergent vegetation
 6877:                   cff1=1;
 6878:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6879:                   cff3 = veg_c;
 6880: 
 6881:                } else { // emergent vegetation
 6882:                   cff1 = 1.0/(1.0 + veg_c2);
 6883:                   cff2 = cff1;
 6884:                   cff3 = 0.0;
 6885: 
 6886:                }
 6887:             } // if iveg
 6888:          } //  2D/3D
 6889: 
 6890:          av_cff1 += cff1/i34;
 6891:          av_cff2 += cff2/i34;
 6892:          av_cff3 += cff3/i34;
 6893:          av_cff2_chi += cff2*chi/i34;
 6894:          av_cff3_chi += cff3*chi/i34;
 6895:          av_df += min(htot, veg_h)/(htot*i34);
 6896: 
 6897: 
 6898:          // btrack values: U^\star, U^{\star\alpha}
 6899:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6900:          Vector2 Ustar       = {0.0, 0.0}; 
 6901:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6902: 
 6903:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6904:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6905:          } else { //3D
 6906:             for (int k = side->kb; k < nvrt; k++) {
 6907:             
 6908:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6909:                Ustar += w2;
 6910: 
 6911:                if constexpr(iveg != 0) {
 6912:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6913:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6914:                        Ustar_alpha += zrat*w2; // XXXX
 6915:                    }
 6916:                }  // if iveg
 6917:             }  // for k
 6918:          }  //2D/3D
 6919:          
 6920: 
 6921:          // Add btrack & surface stress terms to \breve{G} first
 6922:          if constexpr(ics==1) {
 6923: 
 6924:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6925: 
 6926:          } else {
 6927:             // XXX IMPLEMENT THIS
 6928:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6929:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6930:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6931:          }  // if ics
 6932: 
 6933:          // Surface and bottom stress terms
 6934:          if constexpr(ics==1) {
 6935:             const Vector2 tau    = side->tau();
 6936:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6937: 
 6938:             // Term for surface and bottom stress
 6939:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6940: 
 6941:          } else {
 6942:             assert(false && "computeElemAverageGhat: Not implemented");
 6943:             // XXX IMPLEMENT THIS
 6944:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6945:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6946:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6947:             // tau_x=(vn1+tt1)/2.d0
 6948:             // tau_y=(vn2+ss1)/2.d0
 6949:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6950:          }  // if ics
 6951: 
 6952:          
 6953: 
 6954:          // All terms in F,F^\alpha,f_b except baroclinic
 6955:          // F, f_b: all explicit terms excluding vegetation 
 6956:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6957:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6958:          const double coriolis = side->coriolis;
 6959:          Vector2 F  =  coriolis*side->U;  // F_x
 6960:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6961:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6962: 
 6963:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6964:             
 6965:             for (int k = side->kb; k < nvrt; k++) {
 6966:                if (zctr2 > side->zc[k-1]) {
 6967:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6968:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6969:                    Fa +=  coriolis*w2*zrat;
 6970:                } // if zctr2
 6971:             } // k
 6972:          } // iveg
 6973: 
 6974:          // Integrate horizontal viscosity force vertically
 6975:          for (int k=side->kb + 1; k<nvrt; k++) {
 6976:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6977: 
 6978:             F += levelHorVisc;
 6979: 
 6980:             // Vegetation term
 6981:             if constexpr(iveg!=0) {
 6982:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6983:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6984:                   Fa += levelHorVisc*zrat;
 6985:                } 
 6986:             } // if iveg
 6987:          } // for k
 6988: 
 6989:          fb += side->nuGradU[side->kb];
 6990: 
 6991:          // Add to ghat1
 6992:          if constexpr(ics==2) {
 6993:             // XXX IMPLEMENT THIS
 6994:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6995:             // bigf1=vn1; bigf2=vn2
 6996:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6997:             // botf1=vn1; botf2=vn2
 6998:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6999:             // bigfa1=vn1; bigfa2=vn2
 7000:          } // if ics
 7001: 
 7002:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7003:       } // for j (nodes and sides)
 7004: 
 7005:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7006:          
 7007:       // Finish off terms in F, F^\alpha and f_b
 7008:       const double grav3 = elem->mean(&Node::grav2);
 7009:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7010: 
 7011: 
 7012:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7013:       for (int j=1; j<i34; j++) { 
 7014:          // For each side in the element...
 7015:          const Side *side = elem->sides[j];
 7016:          const double chi = side->chi;
 7017: 
 7018:          const double htot = side->htot2();
 7019:          const double veg_h = side->veg_h();
 7020:          const Vector2 F  = htot*fb;
 7021:          const Vector2 Fa = min(htot, veg_h)*fb;
 7022: 
 7023:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7024:       } // for j
 7025: 
 7026:       //botf1 etc are already in elem frame
 7027:       elem->ghat1 += tmp/i34;
 7028: 
 7029:       // Baroclinic force
 7030:       if constexpr(ibc==0) {
 7031:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7032: 
 7033:          Vector2 Fa = {0.0, 0.0};
 7034:          Vector2 intGradRho = {0.0, 0.0};
 7035:          
 7036:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7037:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7038:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7039: 
 7040:             // \in F [m^2/s/s]
 7041:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7042:          }
 7043: 
 7044:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7045:          const Vector2 F = av_df*Fa; //approx
 7046:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7047: 
 7048:       } // if ibc
 7049: 
 7050: 
 7051: 
 7052:    }
 7053: 
 7054: } // extern "C"
 7055: 
 7056: 
 7057: 
 7058: #ifdef DONTCOMPILE
 7059: __global__ void checkMassConservation(Tracers* sumtr) {
 7060: 
 7061:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7062: 
 7063:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7064: 
 7065:    Element *elem = &(mesh->localElemData[i]);
 7066: 
 7067:    // Skip dry elements
 7068:    if (elem->isDry) return;
 7069: 
 7070:    // Local sum array for this thread
 7071:    double localSum[N_TRACERS] = {0.0};
 7072: 
 7073:    // Sum over vertical levels for this element
 7074:    const int kbe = elem->kbe;
 7075:    const double area = elem->area;
 7076: 
 7077:    for (int k = kbe; k < nvrt; k++) {
 7078:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7079:       
 7080:       // Accumulate tracer mass
 7081:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7082:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7083:       }
 7084:    }
 7085: 
 7086:    
 7087: 
 7088:    //  This function returns per element sums. A reduction must be done on the host side.
 7089: }
 7090: 
 7091: 
 7092: __global__ void transport(void) {
 7093: 
 7094:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7095: 
 7096:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7097: 
 7098:    Element *elem = &(mesh->localElemData[ie]);
 7099: 
 7100:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7101: 
 7102:                for (int m=0; m<ntr; m++) {
 7103:                   for (int k=kbe(ie); k<nvrt; k++) {
 7104:                      // Calculate each polynomial's weight 
 7105:                      wm=0.d0; sum1=0.d0; 
 7106:                      wm1=0.d0; wm2=0.d0; 
 7107:                      for (int i=0; i<elem->nweno2; i++) {
 7108:                   
 7109:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7110:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7111:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7112:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7113:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7114:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7115:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7116:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7117:                      // -----------------Hu and Shu (1999)'s method----------------
 7118:                      b4=b1+b2+b3
 7119: 
 7120: //Error: add PRODUCTION CPP
 7121: #ifdef DEBUG
 7122:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7123:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7124:                     call parallel_abort(errmsg)
 7125:                   }
 7126: #endif
 7127: 
 7128:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7129:                   // !----test-------------- 
 7130:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7131:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7132:                   // !wm(i)=wm1(i)*wm2(i)
 7133:                   // !---------------------- 
 7134:                   sum1=sum1+wm(i)
 7135:                 } // end for i
 7136: 
 7137:                 wm=wm/sum1
 7138: 
 7139:                 for (int j=0; j<elem->i34; j++) {
 7140: 
 7141:                   const Side *side  = elem->sides[j];
 7142:                   const Node *node1 = side->n1;
 7143:                   const Node *node2 = side->n2;
 7144: 
 7145:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7146:                      trsd=0.d0
 7147:                      for (int kk=0; kk<nquad; kk++) {
 7148:                         for (int i=0; i<elem->nweno2; i++) {
 7149:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7150:                         } // end for i   
 7151:                      } // end for kk
 7152:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7153:                   } // outward flux
 7154:                } // end for j=1,i34(ie) ! side
 7155:             }
 7156:          }
 7157:               
 7158: 
 7159: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7160: //             //   calculate each polynomial's weight 
 7161: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7162: //                 wm=0.d0; sum1=0.d0
 7163: //                 do i=1,nweno1(ie) !for each polynomial
 7164: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7165: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7166: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7167: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7168: //                   wm(i)=b2
 7169: //                   sum1=sum1+b2
 7170: //                   !wm(i)=1.d0
 7171: //                   !sum1=sum1+1.d0
 7172: 
 7173: // // Error: PRODUCTION
 7174: // #ifdef DEBUG
 7175: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7176: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7177: //                     call parallel_abort(errmsg)
 7178: //                   endif
 7179: // #endif
 7180: 
 7181: //                 enddo !i
 7182: //                 wm=wm/sum1 !final weight
 7183: 
 7184:                 for (int j=0; j<elem->i34; j++) { // side
 7185:                   const Side *side = elem->sides[j];
 7186:                   const Node *node1 = side->n1;
 7187:                   const Node *node2 = side->n2;
 7188: 
 7189:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7190:                     trsd=0.d0
 7191:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7192:                       for (int i=0; i<elem->nweno1; i++) {
 7193:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7194:                       }
 7195:                     enddo //kk
 7196:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7197:                   } // outward flux
 7198:                 } // end for j=1,i34(ie) ! side
 7199:               } // end for k; ntr 
 7200: 
 7201:             else !simple upwind method
 7202:               do j=1,i34(ie)
 7203:                 jsj=elside(j,ie)
 7204:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7205:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7206:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7207:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7208:                   endif
 7209:                 enddo  !vertical layers
 7210:               enddo !j=1,i34(ie) ! side
 7211:             endif !order of accuracy
 7212: 
 7213:          //  enddo !ie
 7214: // !$OMP     end do
 7215: 
