 2132: 
 2133: 
 2134: /**
 2135:    Compute the shape coordinates of the point (xt,yt) in the element.
 2136:    @param xt (input): x-coordinate of the point
 2137:    @param shpCoords (output): shape coordinates of the point
 2138:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2139:    @return true if the point is inside the element, false otherwise
 2140: **/
 2141: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2142:                                             bool fixNegshpCoord) const {
 2143: 
 2144:    // Compute the shape coordinates of the point xt in the element.
 2145:    if (i34==3) {
 2146:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2147:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2148:       // and in this case, the pt will be nudged into the element
 2149:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2150:       // from the local frame, so use additional check.
 2151: 
 2152:       Point2 x0, x1, x2;
 2153: 
 2154:       if constexpr(ics==1) {
 2155:          x0 = nodes[0]->p2();
 2156:          x1 = nodes[1]->p2();
 2157:          x2 = nodes[2]->p2();
 2158:       }
 2159:       else // lat/lon
 2160:       {
 2161:          Error("Not implemented yet");
 2162: #ifdef ICS2
 2163:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2164:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2165:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2166: #endif
 2167:       }
 2168: 
 2169:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2170:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2171:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2172:       shpCoords[3] = 0.0;
 2173:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2174: 
 2175:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2176:       // then we fix the negative shape coordinates.
 2177:       if (fixNegshpCoord && tmpmin<=0.0) {
 2178: 
 2179:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2180:          // keeping the sum of the shape coordinates equal to 1.
 2181:          // I have tested and compared the new algorithm with the old one, and they give
 2182:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2183:          // The new algorithm should be faster since it is branchless.
 2184:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2185:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2186:          
 2187:          shpCoords[0] = (shpCoords[0] + a)*b;
 2188:          shpCoords[1] = (shpCoords[1] + a)*b;
 2189:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2190: 
 2191:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2192:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2193:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2194:          }
 2195: 
 2196:          // Update the point coordinates for the new shape coordinates
 2197:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2198:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2199:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2200: 
 2201:       }
 2202: 
 2203:       // Check if the point is inside the element
 2204:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2205:    }
 2206:    else {
 2207:       Error("Not implemented yet");
 2208: #ifdef QUADS
 2209:       // Reproject pt in eframe of nel for ics=2
 2210:       if constexpr(ics==1) {
 2211:          xn2 = xt; 
 2212:          yn2 = yt;
 2213:       }
 2214:       else {
 2215:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2216:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2217:       }
 2218: 
 2219:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2220: #endif
 2221:    }
 2222: 
 2223:    return false;  // Never reached
 2224: 
 2225: }
 2226: 
 2227: 
 2228: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2229: // Convert shape coordinates to cartesian coordinates
 2230: 
 2231:    if (i34 == 3) {
 2232:       // Triangular element
 2233:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2234:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2235:    }
 2236:    else {
 2237:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2238:    }
 2239: 
 2240: }
 2241: 
 2242: 
 2243: /**  Interpolate velocities at a given point (xt,yt,zt)
 2244: 
 2245:    @param xt, yt, zt: coordinates of the point to interpolate
 2246:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2247: 
 2248:    This is done in four steps:
 2249: 
 2250:    1. Find the shape coordinates for the final position in the element.
 2251:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2252:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2253:       z levels at xt, yt at each step.   
 2254:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2255:       horizontally and vertically.
 2256: **/
 2257: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2258:    // Interpolate the velocities at the point xt. 
 2259:    // This function works the same for triangular and quadrilateral elements.
 2260:    double shpCoord[4];
 2261: 
 2262: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2263:    // First step is to compute the shape coordinates of (xt,yt)
 2264:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2265:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2266: 
 2267:    // Second step is to find the level that contains zt
 2268:    // Uses a binary search to find the level
 2269:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2270:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2271:    int R = nvrt - 1;
 2272: 
 2273:    // Get the z coordinates at the nodes of the element at the levels L and R
 2274:    double zLAtNodes[4], zRAtNodes[4];
 2275:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2276:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2277: 
 2278:    double zL = interpolate(shpCoord, zLAtNodes);
 2279:    double zR = interpolate(shpCoord, zRAtNodes);
 2280:    
 2281:    // Interpolates vertically the velocities
 2282:    double wght1, wght2;
 2283:    if (xt.z<=zL) {
 2284:       wght1 = 1.0;
 2285:       wght2 = 0.0;
 2286:    }
 2287:    else if (xt.z>=zR) {
 2288:       wght1 = 0.0;
 2289:       wght2 = 1.0;
 2290:    }
 2291:    else {
 2292:       // Perform a binary search to find the levels between L and R that contain xt.z
 2293:       while (R - L > 1) {
 2294:          int M = (L + R) / 2;
 2295: 
 2296:          double zMAtNodes[4];
 2297:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2298:          double zM = interpolate(shpCoord, zMAtNodes);
 2299:          if (zM < xt.z) 
 2300:          {
 2301:             L = M;
 2302:             zL = zM;
 2303:          }
 2304:          else 
 2305:          {
 2306:             R = M;
 2307:             zR = zM;
 2308:          }
 2309:       }
 2310:       assert(L == R-1);
 2311:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2312: 
 2313:       wght2 = (xt.z - zL)/(zR - zL);
 2314:       wght1 = 1.0 - wght2;
 2315:    }
 2316: 
 2317:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2318:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2319: 
 2320: if (idx==2) {
 2321: Vector3 u1 = wght1*interpolate(L, shpCoord, &Node::u2);
 2322: Vector3 u2 = wght2*interpolate(R, shpCoord, &Node::u2);
 2323: printf("L = %d, R = %d, Element = %d\n", L, R, idx);
 2324: printf("shpCoord = %.17g,%.17g,%.17g,%.17g\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2325: // printf("node1 (%.17g,%.17g), node2 (%.17g,%.17g,%), node3 (%.17g,%.17g)\n", nodes[0]->p2().x, nodes[0]->p2().y, nodes[1]->p2().x, nodes[1]->p2().y, nodes[2]->p2().x, nodes[2]->p2().y);
 2326: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[L].x, nodes[0]->u2[L].y, nodes[0]->u2[L].z);
 2327: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[L].x, nodes[1]->u2[L].y, nodes[1]->u2[L].z);
 2328: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[L].x, nodes[2]->u2[L].y, nodes[2]->u2[L].z);
 2329: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[R].x, nodes[0]->u2[R].y, nodes[0]->u2[R].z);
 2330: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[R].x, nodes[1]->u2[R].y, nodes[1]->u2[R].z);
 2331: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[R].x, nodes[2]->u2[R].y, nodes[2]->u2[R].z);
 2332: printf("element = %d, idx = %d, u_int = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z);   
 2333: printf("u1 = %.17g,%.17g,%.17g\n", u1.x, u1.y, u1.z);   
 2334: printf("u2 = %.17g,%.17g,%.17g\n", u2.x, u2.y, u2.z);   
 2335: if(!(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z))) {u_int = {0.0, 0.0, 0.0}; return;}
 2336: }
 2337: 
 2338:    // Neither of the interpolated velocities should be NaN
 2339:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2340: 
 2341: }
 2342: 
 2343: 
 2344: 
 2345: 
 2346: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2347: 
 2348:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2349:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2350:    const Node *n1 = side->n1;
 2351:    const Node *n2 = side->n2;
 2352: 
 2353:    bool n1_match = (n1->nodeBnd->segment == segment);
 2354:    bool n2_match = (n2->nodeBnd->segment == segment);
 2355: 
 2356:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2357:    if (n1_match && n2_match) {
 2358:       return 0.5;
 2359:    } else if (n1_match) {
 2360:       return 1.0;
 2361:    } else if (n2_match) {
 2362:       return 0.0;
 2363:    }
 2364:    return 0.0;
 2365: }
 2366: 
 2367: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2368: 
 2369: 
 2370: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2371: 
 2372:    const double w1 = getBoundaryArrayValueWeight();
 2373:    const double w2 = 1.0 - w1;
 2374:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2375:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2376: 
 2377:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2378: }
 2379: 
 2380: 
 2381: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2382:    const double w1 = getBoundaryArrayValueWeight();
 2383:    const double w2 = 1.0 - w1;
 2384:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2385:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2386: 
 2387:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2388: }
 2389: 
 2390: 
 2391: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2392:    // Returns the value of the velocity at the side center
 2393:    const double w1 = getBoundaryArrayValueWeight();
 2394:    const double w2 = 1.0 - w1;
 2395:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2396:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2397: 
 2398:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2399: }
 2400: 
 2401: 
 2402: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2403:    // Returns the value of the normal component of the velocity at the side center
 2404:    const double w1 = getBoundaryArrayValueWeight();
 2405:    const double w2 = 1.0 - w1;
 2406:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2407:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2408: 
 2409:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2410: }
