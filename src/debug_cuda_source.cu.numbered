 4387:    __global__ void computeFlowBcVelocities(double time) {
 4388: 
 4389:       SIDE_BND(sideBnd);
 4390: 
 4391:       const Side *side = sideBnd->side;
 4392:  
 4393:       const bool isDry = side->isDry;
 4394:       const bool isLand = sideBnd->segment->isLand;
 4395: 
 4396:    
 4397:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4398: 
 4399:       if (isDry || isLand) return;
 4400: 
 4401:       // For wet sides in open boundaries...
 4402:       const Vector2 n = side->n;
 4403:       const BoundarySegment *segment = sideBnd->segment;
 4404: 
 4405:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4406: 
 4407:       const int ifltype = segment->ifltype;
 4408: 
 4409:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4410:       const Vector2 r_nuth0 = r_uth0*n;
 4411: 
 4412: 
 4413:       if (ifltype == 1 || ifltype == 2) {
 4414:       
 4415:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4416: 
 4417:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4418:          
 4419:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4420:          
 4421:       } else if (ifltype == -1) { // Flather 1
 4422: 
 4423:          for (int k = 0; k < nvrt; k++) {
 4424: 
 4425:             // uth is the normal vel.; no ramp up
 4426:             const double uth = sideBnd->nuth(k);
 4427:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4428: 
 4429:             sideBnd->ubc[k] += uth*n;
 4430:          }
 4431: 
 4432:       } else if (ifltype == 3 || ifltype == 5) {
 4433:          // vnth0=0 !normal vel.
 4434: 
 4435:          Vector2 r_u1_bar = {0.0, 0.0};
 4436:          // Computes the contribution to the velocity from all tide frequencies
 4437:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4438: 
 4439:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4440:             const Vector2 umo  = sideBnd->umo(jfr); 
 4441: 
 4442:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4443:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4444:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4445:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4446: 
 4447:          }
 4448: 
 4449: 
 4450:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4451: 
 4452:       } // if (ifltype = 3 || ifltype == 5
 4453: 
 4454: 
 4455: 
 4456:    }
 4457: 
 4458:    __global__ void computeElevationBoundaryConditions(double time) {
 4459:       // Compute elevation essential boundary conditions 
 4460: 
 4461:       NODE_BND(nodeBnd); // Each boundary node.
 4462: 
 4463:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4464: 
 4465:       const Node *node = nodeBnd->node;
 4466:       const BoundarySegment *segment = nodeBnd->segment;
 4467:       const int iettype = segment->iettype;
 4468:       
 4469: 
 4470:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4471:       double eic = 0.0;
 4472:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4473:       else                 eic = 0.0;
 4474: 
 4475:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4476:       const double r_eth = ramp*nodeBnd->eth;
 4477:       double r_eta1_bar = 0.0;
 4478: 
 4479: 
 4480:       // Compute tide elevation
 4481:       if (iettype == 3 || iettype == 5) {   
 4482: 
 4483:          if constexpr(iloadtide==1) { // loading tide
 4484:             assert(false && "Loading tide not implemented");
 4485:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4486:          }
 4487:          
 4488:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4489: 
 4490:             const double efa  = nodeBnd->efa[jfr]; 
 4491:             const double emo  = nodeBnd->emo[jfr]; 
 4492: 
 4493:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4494:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4495:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4496: 
 4497:          } // for jfr
 4498: 
 4499:       } // if iettype
 4500: 
 4501:       switch (iettype) {
 4502:          case 1:
 4503:          case 2:
 4504:          case 4:
 4505:             nodeBnd->elbc = r_eic + r_eth;
 4506:             break;
 4507:          case 3:
 4508:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4509:             break;
 4510:          case 5:
 4511:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4512:             break;
 4513:       } // switch
 4514: 
 4515: 
 4516:       //Add inverse barometric effects
 4517:       if (iettype != 0 && inv_atm_bnd == 1) {
 4518:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4519:       }
 4520: 
 4521:    }
 4522: 
 4523: 
 4524:    __global__ void computeHorizontalViscosity(void) { 
 4525: 
 4526:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4527: 
 4528:       SIDE(side);
 4529: 
 4530:       if (side->isDry) return;
 4531: 
 4532:       for (int k = 0; k < nvrt; k++) {
 4533:          side->nuGradU[k] = {0.0, 0.0};
 4534:       }
 4535: 
 4536:       if constexpr(ihorcon == 1) {
 4537:          for (int k = side->kb; k < nvrt - 1; k++) {
 4538:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4539:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4540:             // By Zhang and Baptista.
 4541: 
 4542:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4543:             // This is a standard discretization of the Laplacian operator.
 4544:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4545:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4546:             // Gamma is hvis_coef0 in the code.
 4547:             // The value of gamma needs to be < 0.5.
 4548: 
 4549:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4550:             // side under consideration in each of the two possible elements that share the side.
 4551:             Vector2 sumU = {0.0, 0.0};
 4552:             for (int l = 0; l < 2; l++) {
 4553:                const Element *elem = side->elems[l];
 4554: 
 4555:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4556: 
 4557:                // Find the local index of the side in the element
 4558:                const int idxSide = elem->sideLocalIdx(side);
 4559: 
 4560:                // Find the two sides that are connected to the side under consideration
 4561:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4562:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4563: 
 4564:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4565: 
 4566:             }
 4567: 
 4568:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4569: 
 4570:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4571:    
 4572:          }
 4573:       }
 4574:       else if constexpr(ihorcon == 2) {
 4575:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4576:       }
 4577: 
 4578: 
 4579:    }
 4580: 
 4581: 
 4582:    __global__ void setEssentialBC(void) {
 4583:       // Set essential boundary conditions 
 4584:       NODE(node); // Each boundary node
 4585:       NodeBoundary *nodeBnd = node->nodeBnd;
 4586:       
 4587:  
 4588:       // Check if this node has essential BC
 4589:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4590:          // Verify BC value is valid
 4591:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4592: 
 4593:        
 4594:          // Set diagonal to 1 and zero off-diagonals
 4595:          node->coeffDiag = 1.0;
 4596: 
 4597:          for (int j = 0; j < node->numNodes; j++) {
 4598:                node->coeffMatrix[j] = 0.0;
 4599:          }
 4600:          
 4601:          // Set solution and RHS to BC value
 4602:          node->mX  = nodeBnd->elbc;
 4603:          node->qel = nodeBnd->elbc;
 4604: 
 4605:       } else {
 4606:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4607: 
 4608:          for (int j = 0; j < node->numNodes; j++) {
 4609:                Node* nbNode = node->nodes[j];
 4610:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4611:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4612:                   // Verify neighbor's BC value
 4613:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4614: 
 4615:                   // Subtract contribution to RHS
 4616:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4617:                   node->coeffMatrix[j] = 0.0;  
 4618:                }
 4619:          }
 4620:       }
 4621:    }
 4622: 
 4623: 
 4624:    __global__ void updateElevation(void) {
 4625:       NODE(node);
 4626: 
 4627: 
 4628:       node->eta2 = node->mX;
 4629: 
 4630:       node->updateZCoordData();
 4631:    }
