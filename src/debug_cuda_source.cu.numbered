 4422:    //      do k=1,nope_global
 4423:    //        if(iabs(ifltype(k))>=4) then
 4424:    //          icount=icount+1
 4425:    //          if(icount>nfltype2) call parallel_abort('STEP: wrong counting 6')
 4426:    //          do j=1,nond_global(k)
 4427:    //            icount2=icount2+1
 4428:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4429: 
 4430:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4431:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4432:    //          enddo !j
 4433:    //        endif
 4434:    //      enddo !k
 4435:    //    endif !nfltype2
 4436:    }
