 2157:    template<typename T>
 2158:    __device__ __forceinline__ T Element::interpolate(int level, const ShapeCoords &shapeCoords, T (Node::*func)(int) const) const {
 2159:       T values[4];
 2160:       getNodalValues(level, func, values);
 2161: 
 2162:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2163:       if constexpr (IsVector2<T>::value && ics == 2) {
 2164: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2165:          projectNodeVectorsToElementFrame(values);
 2166: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2167:       }
 2168: 
 2169:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2170:    }
 2171: 
 2172:    template<typename T>
 2173:    __device__ __forceinline__ T Element::interpolate(const ShapeCoords &shapeCoords, T Node::* field) const {
 2174:       T values[4];
 2175:       getNodalValues(field, values);
 2176: 
 2177:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2178:       if constexpr (IsVector2<T>::value && ics == 2) {
 2179: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2180:          projectNodeVectorsToElementFrame(values);
 2181: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2182:       }
 2183:       
 2184:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2185:    }
