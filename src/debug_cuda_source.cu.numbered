 7143: 
 7144: __global__ void getStructSizes(int* sizes)  {
 7145:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7146:       sizes[0] = (int)sizeof(Node);
 7147:       sizes[1] = (int)sizeof(Element);
 7148:       sizes[2] = (int)sizeof(Side);
 7149:       sizes[3] = (int)sizeof(NodeBoundary);
 7150:       sizes[4] = (int)sizeof(SideBoundary);
 7151:       sizes[5] = (int)sizeof(BoundarySegment);
 7152: }
 7153: 
 7154: __global__ void printMatrix(void) {
 7155: 
 7156: 
 7157:    // Let only one thread per block print at a time 
 7158: 
 7159:    if (threadIdx.x == 0) {
 7160:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7161:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7162:          if (idx_node >= mesh->np) return;
 7163:          const Node *node = mesh->localNodeData + idx_node;
 7164:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7165:          for (int j = 0; j < node->numNodes; j++) {
 7166:             Node* nbNode = node->nodes[j];
 7167:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7168:          }
 7169:          printf("]\n");
 7170: 
 7171:       }
 7172:    }
 7173: 
 7174: 
 7175: 
 7176: }
 7177: 
 7178: 
 7179: __global__ void computeMatrixProductAndDotProducts() {
 7180:    // Computes A*p, r'Mr and p'Ap
 7181: 
 7182:    // 1) shared buffer: first half for rMr, second for pAp
 7183:    __shared__ double sdata[2*BLOCK_SIZE];
 7184:    double* s_rMr = sdata;
 7185:    double* s_pAp = sdata + BLOCK_SIZE;
 7186: 
 7187:    s_rMr[threadIdx.x] = 0.0;
 7188:    s_pAp[threadIdx.x] = 0.0;
 7189: 
 7190:    // 2) get your node pointer
 7191:    NODE(node);  
 7192:    const int tid = threadIdx.x;
 7193: 
 7194:    const double diag = node->coeffDiag;
 7195:    const double r    = node->mR;
 7196:    const double p    = node->mP;  
 7197: 
 7198:    // apply preconditioner on the fly:
 7199:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7200: 
 7201:    // 4) compute Ap = A.p
 7202:    double Ap = node->coeffDiag * node->mP;
 7203:    for (int j = 0; j < node->numNodes; ++j) {
 7204:       const Node *nbNode = node->nodes[j];
 7205:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7206: 
 7207:    }
 7208:    node->mAp = Ap;
 7209:     
 7210: 
 7211:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7212:    const double l_rMr = r*Mr;  // r'Mr
 7213:    const double l_pAp = p*Ap;  // p'Ap
 7214: 
 7215:    // 6) write into shared mem
 7216:    s_rMr[tid] = l_rMr;
 7217:    s_pAp[tid] = l_pAp;
 7218: 
 7219:    __syncthreads();
 7220: 
 7221:    // 7) block-wide tree reduction
 7222:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7223:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7224:       __syncthreads();
 7225:    }
 7226: 
 7227:    // 8) thread 0 atomically accumulates into the globals
 7228:    // XXX: This is slower than it needs to be, but it is simple and works
 7229:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7230: 
 7231: 
 7232: }
 7233: 
 7234: 
 7235: __global__ void updateSolutionAndDotProducts(void) {
 7236:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7237: 
 7238:    s_rMr[threadIdx.x] = 0.0;
 7239: 
 7240: 
 7241:    // get node & bounds-check:
 7242:    NODE(node);
 7243:    const int tid = threadIdx.x;
 7244: 
 7245: 
 7246:    // Compute alpha
 7247:    const double alpha = (*rMr_old)/(*pAp);
 7248: 
 7249:    // load scalars
 7250:    const double diag = node->coeffDiag;
 7251:    const double p    = node->mP;
 7252:    const double Ap   = node->mAp;
 7253:    const double x    = node->mX;
 7254:    const double r    = node->mR;
 7255:    
 7256:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7257: 
 7258:    // 1) update solution & residual
 7259:    const double x_new = x + alpha*p;
 7260:    const double r_new = r - alpha*Ap;
 7261:    node->mX = x_new;
 7262:    node->mR = r_new;
 7263: 
 7264:    // 2) apply Jacobi preconditioner on the fly
 7265:    const double Mr_new = r_new/diag;
 7266: 
 7267: 
 7268:    // 3) local contributions for the two dot-products
 7269:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7270: 
 7271:    // 4) write into shared-mem
 7272:    s_rMr[tid] = l_rMr;
 7273: 
 7274:    __syncthreads();
 7275: 
 7276: 
 7277:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7278:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7279:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7280:       __syncthreads();
 7281:    }
 7282: 
 7283:    // 6) thread 0 atomically folds into the global accumulators
 7284:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7285: 
 7286: 
 7287: }
 7288: 
 7289: 
 7290: __global__ void updateSearchDirection() {
 7291:     NODE(node);
 7292: 
 7293:     // recompute z on-the-fly
 7294:     const double z = node->mR / node->coeffDiag;
 7295:     const double p = node->mP;
 7296: 
 7297:     const double beta = (*rMr_new)/(*rMr_old);
 7298: 
 7299: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7300: 
 7301:     // p =z + beta*p
 7302:     node->mP = z + beta*p;
 7303: 
 7304: }
 7305: 
 7306: __global__ void initializePreconditionedResidual(double *scalars) {
 7307: 
 7308:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7309: 
 7310:     s_rMr[threadIdx.x] = 0.0;
 7311: 
 7312:     NODE(node);
 7313:     const int tid = threadIdx.x;
 7314:     // For the first iteration:
 7315:     // 1. Initial solution x = 0 (already set)
 7316:     // 2. Initial residual r = b (stored in qel)
 7317:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7318: 
 7319: // XXX we should use the guess solution here    
 7320: 
 7321:     // Set initial residual r = b (from qel)
 7322:     node->mR = node->qel;
 7323: 
 7324:     // Compute z = M^-1 * r (preconditioned residual)
 7325:     const double z = node->mR / node->coeffDiag;
 7326: 
 7327:     // Set initial search direction p = z
 7328:     node->mP = z;
 7329: 
 7330:     // Initialize other variables needed for CG
 7331:     node->mX = 0.0;  // Initial solution
 7332:     node->mAp = 0.0; // Will be computed in first iteration
 7333: 
 7334:     // These point to a cupy array in the host code
 7335:     rMr_old = scalars + 0;
 7336:     rMr_new = scalars + 1;
 7337:     pAp     = scalars + 2;
 7338: 
 7339:     // Computes the first r'Mr (reduction)
 7340:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7341: 
 7342:     // 4) write into shared-mem
 7343:     s_rMr[tid] = l_rMr;
 7344: 
 7345:     __syncthreads();
 7346: 
 7347: 
 7348:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7349:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7350:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7351:         __syncthreads();
 7352:     }
 7353: 
 7354:     // 6) thread 0 atomically folds into the global accumulators
 7355:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7356: 
 7357:     *rMr_old = 0.0;
 7358:     *pAp = 0.0;
 7359: }
 7360: 
 7361: 
 7362: 
