 1175: // This struct is used to store the boundary information for a node.
 1176: struct NodeBoundary {   
 1177:    int idx;
 1178:    BoundarySegment *segment;
 1179:    Node *node;
 1180:    
 1181:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1182:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1183: 
 1184:    bool isLand;
 1185: 
 1186:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1187:    double elbc;   // Elevation boundary condition
 1188:    double eth;    // Elevation time history
 1189: 
 1190:    double eta_mean; // Mean elevation at nodes
 1191: 
 1192:    bool isEssentialBC;
 1193: 
 1194:    Vector2 uth[nvrt];  // "Time history" velocity
 1195: 
 1196:    // Arrays for harmonic constituents (if needed)
 1197:    double  emo[nbfr];  // Elevation amplitude
 1198:    double  efa[nbfr];  // Elevation phase
 1199:    Vector2 umo[nbfr];  // velocity amplitude
 1200:    Vector2 ufa[nbfr];  // velocity phase
 1201: 
 1202: 
 1203:    NodeBoundary(void) {
 1204:       isLand = false;
 1205:    }
 1206:    NodeBoundary(bool _isLand) {
 1207:       isLand = _isLand;
 1208:    }
 1209: 
 1210:    
 1211:    __forceinline__ __device__ int numSidesForAverage() const {
 1212:    // Returns the number of sides that are connected to the node and have the same segment.
 1213:    // This is used to compute the average velocity at the node for open boundary nodes.
 1214:       int res = 0;
 1215:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1216:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1217: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1218:       return res;
 1219:    }
 1220: 
 1221: 
 1222:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1223:       assert(index == 0 || index == 1); 
 1224:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1225:    }
 1226: 
 1227: 
 1228: };
