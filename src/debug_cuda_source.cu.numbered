10212: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
10213:    // Get the value of a variable from an side
10214:    // varName is the name of the variable to get
10215:    // var is the array to store the value
10216:    // k is the vertical level index of the variable to get
10217:    SIDE_BND(sideBnd);   
10218: 
10219:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
10220:    if (sideBnd->segment->isLand) idx = -7;
10221: 
10222:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
10223:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
10224: 
10225: }
