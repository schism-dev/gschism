 2110: 
 2111: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2112: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2113: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2114: // Only when ics == 2, the origin is at the element center.
 2115: 
 2116:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2117: 
 2118:    const Node *node = nodes[idxNode];
 2119: 
 2120:    if constexpr(ics==1) {
 2121:       return node->p;
 2122: 
 2123:    } else {
 2124:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2125: 
 2126:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2127: 
 2128:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2129:    }
 2130: 
 2131: }
 2132: 
 2133: 
 2134: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2135: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2136: 
 2137:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2138: 
 2139:    const int id1 = idx;
 2140:    const int id2 = nxq(1 + id1);
 2141:    const int id3 = nxq(2 + id1);
 2142: 
 2143:    if constexpr(ics==1) {
 2144:       x0 = nodes[id1]->p;
 2145:       x1 = nodes[id2]->p;
 2146:       x2 = nodes[id3]->p;
 2147: 
 2148:    } else {
 2149:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2150: 
 2151:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2152:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2153:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2154: 
 2155:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2156:       x1 = toVector2(frame.G2L(p1 - c));
 2157:       x2 = toVector2(frame.G2L(p2 - c));
 2158: 
 2159:    }
 2160: 
 2161: }
 2162: 
 2163: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2164: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2165: 
 2166:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2167: 
 2168:    if constexpr(ics==1) {
 2169:       x0 = nodes[0]->p;
 2170:       x1 = nodes[1]->p;
 2171:       x2 = nodes[2]->p;  
 2172:       x3 = nodes[3]->p;
 2173: 
 2174:    } else {
 2175:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2176: 
 2177:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2178:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2179:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2180:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2181: 
 2182:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2183:       x1 = toVector2(frame.G2L(p1 - c));
 2184:       x2 = toVector2(frame.G2L(p2 - c));
 2185:       x3 = toVector2(frame.G2L(p3 - c));
 2186:    }
 2187: 
 2188: }
