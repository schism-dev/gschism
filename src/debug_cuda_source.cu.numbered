 2768: 
 2769: __device__ void Node::updateKb(void) {
 2770: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2771: 
 2772:    if constexpr(ivcor == 1) return;
 2773: 
 2774: 
 2775:    if (isDry2()) return;
 2776: 
 2777:    if constexpr(ivcor == 2) {  // SZ coordinates
 2778:       
 2779:       // Compute bottom level index
 2780:       if (depth <= mesh->h_s) {
 2781:          kb = izlev;
 2782:          
 2783:       } else {
 2784:          kb = -1;
 2785:          int L = 0;
 2786:          int R = nzlev; 
 2787:          
 2788:          while (L <= R) {
 2789:             int M = (R + L) / 2;
 2790: 
 2791: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2792:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2793:             
 2794:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2795:                R = M;
 2796:             } else {
 2797:                L = M;
 2798:             }
 2799: 
 2800:             if (R - L == 1) {
 2801:                kb = L;
 2802:                break;
 2803:             }
 2804:          }
 2805:       }
 2806:    } 
 2807: }
 2808: 
 2809: 
 2810: __device__ __inline__ void Node::updateZCoordData(void) {
 2811: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2812: 
 2813:    if (isDry2()) {
 2814:       kb = -1;
 2815:       return;
 2816:    }
 2817: 
 2818:    if constexpr(ivcor == 2) {  // SZ coordinates
 2819:       
 2820:       // Compute bottom level index
 2821:       if (depth <= mesh->h_s) {
 2822:             kb = izlev;
 2823: 
 2824:       } else {
 2825:          kb = -1;
 2826:          for (int i = 0; i < nzlev; i++) {
 2827:             // XXX Use binary search
 2828:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2829:                kb = i;
 2830:                break;
 2831:             }
 2832:          }
 2833:       }
 2834:    } 
 2835:    else if (ivcor == 1) {  // Localized sigma
 2836:       // Do nothing
 2837:    }
 2838: 
 2839: }
 2840: 
 2841: __device__ double Node::compZCoord(int k) const {
 2842:    // Computes the z coordinate at level k.
 2843:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2844:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2845:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2846:    // used 
 2847:    
 2848:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2849: 
 2850:    if (isDry2()) return 0.0;
 2851: // if (htot2() <= h0) printf("idx = %d, htot2() = %f, h0 = %f\n", idx, htot2(), h0); XXX
 2852: // if (htot2() <= h0) return 0.0; // XXX
 2853:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2854: 
 2855:    if constexpr(ivcor == 2) {
 2856: 
 2857:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2858:       const double h_c = mesh->h_c;
 2859:       const double theta_f = mesh->theta_f;
 2860:       const double sinh_theta_f = mesh->sinh_theta_f;
 2861: 
 2862:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2863:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2864:       // once per time step/node.
 2865:       // CHECK: updateZCoordData
 2866: 
 2867:       //  To simplify comparisons, I define index versions of count variables.
 2868:       if      (k == ivrt)           return eta2; 
 2869:       else if (k == izlev)          return -hmod2;
 2870:       else if (k == kb)             return -depth;
 2871:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2872:       else if (k > izlev) {
 2873:          const int ksig = k - izlev;
 2874: 
 2875:          if (hmod2 <= h_c) {
 2876: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2877:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2878:          } 
 2879:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2880:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2881:             assert(false && "ZCOOR: invalid h_c\n");
 2882:          } 
 2883:          else {
 2884: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2885:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2886:                          h_c * mesh->sigma[ksig] + 
 2887:                          (hmod2 - h_c) * mesh->cs[ksig];
 2888:          }
 2889:       } else { 
 2890:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2891:       }
 2892: 
 2893:    }
 2894:    else if constexpr(ivcor == 1) {
 2895:       if (k == kb) return -depth;
 2896:       else if (k == nvrt-1) return eta2;
 2897:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2898:    }
 2899:    
 2900:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2901:    return 0.0;
 2902: }
 2903: 
 2904: 
 2905: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2906:    // Checks if a side in on the boundary
 2907:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2908: 
 2909:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2910:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2911: 
 2912:    // Indices of the nodes that form the side
 2913:    const int n1 = side.n1->idx;
 2914:    const int n2 = side.n2->idx;
 2915:    isLand = false;
 2916:    
 2917: if (n1 == 10) printf("nland = %d, nope = %d, ilnd[0] = %d, ilnd[1*nland] = %d, ilnd[2*nland] = %d, ilnd[3*nland] = %d\n", nland, nope, ilnd[0], ilnd[1*nland], ilnd[2*nland], ilnd[3*nland]);
 2918:    // Check if the side is on a land boundary
 2919:    for (int i = 0; i < nland; i++) {
 2920:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2921:          // Consecutive nodes in the land boundary segment
 2922:          const int b1 = ilnd[i + j*nland];
 2923:          const int b2 = ilnd[i + (j + 1)*nland];
 2924: 
 2925:          assert(b1 != -1 && b2 != -1);
 2926: 
 2927:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2928:             
 2929:             isLand = true;
 2930:             return i;
 2931:          }
 2932:       }
 2933:    }
 2934: 
 2935:    // Check if the side is on an open boundary
 2936:    for (int i = 0; i < nope; i++) {
 2937:       for (int j = 0; j < nond[i] - 1; j++) {
 2938:          // Consecutive nodes in the open boundary segment
 2939:          const int b1 = iond[i + j*nope];
 2940:          const int b2 = iond[i + (j + 1)*nope];
 2941: 
 2942:          assert(b1 != -1 && b2 != -1);
 2943: 
 2944:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2945:             isLand = false;
 2946:             return i;
 2947:          }
 2948:       }
 2949:    }
 2950: // printf("side.idx = %d, n1 = %d, n2 = %d\n", side.idx, n1, n2);             
 2951:    return -1;
 2952: }
 2953: 
 2954: 
 2955: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2956:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2957:                                     double *wind_rotate_angle, 
 2958:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2959:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2960:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2961:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2962:                                     double *drag, double *roughness) {
 2963: 
 2964:    NODE(pnode);  
 2965:    const int i = idx_node;
 2966:    Node &node(*pnode);
 2967: 
 2968:    printf("i = %d, isbnd[i] = %d\n", i, isbnd[i]);
 2969:    node.idx = i;
 2970: 
 2971:    const int idxNodeStart = nodeNeighNodesStart[i];
 2972:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2973:    node.numNodes = idxNodeEnd - idxNodeStart;
 2974:    node.nodes = nodeNeighNodes + idxNodeStart;
 2975:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2976: 
 2977: 
 2978: 
 2979:    const int idxElemStart = nodeNeighElemsStart[i];
 2980:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2981:    node.numElements = idxElemEnd - idxElemStart;
 2982:    node.elements = nodeNeighElems + idxElemStart;
 2983: 
 2984: 
 2985:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2986:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2987:       const int partNode = localNodePart[idxNodeGlobal]; 
 2988:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2989: 
 2990:       Node *node_ptr = nodes[partNode] + idxNode;
 2991:       
 2992:       nodeNeighNodes[idx] = node_ptr;
 2993:    }
 2994: 
 2995: 
 2996:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2997:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2998:       const int partElem = localElemPart[idxElemGlobal];
 2999:       const int idxElem  = localElemIndices[idxElemGlobal];
 3000: 
 3001:       Element *elem_ptr = elems[partElem] + idxElem;
 3002: 
 3003:       nodeNeighElems[idx] = elem_ptr;
 3004:    }      
 3005: 
 3006: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 3007: 
 3008:    node.wind_angle = wind_rotate_angle[i];
 3009: 
 3010: 
 3011:    node.p.x   = node_coords[i * 3];
 3012:    node.p.y   = node_coords[i * 3 + 1];
 3013:    node.depth = node_coords[i * 3 + 2];
 3014: 
 3015:    if (use_ll) {
 3016:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3017:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3018:    }
 3019: 
 3020: 
 3021:    node.numSides = 0;
 3022: 
 3023:    node.Cd = drag[i];
 3024:    node.rough = roughness[i];
 3025:    
 3026:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3027: 
 3028:    
 3029:    // Links the node to the boundary information
 3030:    if (isbnd[i] >= 0) {
 3031: 
 3032:      
 3033:       // Get the index of the node boundary
 3034:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3035: 
 3036:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3037:       node.nodeBnd->node = &node;
 3038: 
 3039:       node.nodeBnd->sideBnd1 = nullptr;
 3040:       node.nodeBnd->sideBnd2 = nullptr;
 3041: 
 3042:       if (isbnd[i]>=0) {
 3043: 
 3044:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3045:          
 3046:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3047:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3048: 
 3049:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3050:          node.nodeBnd->segment->clen  = nan("1");
 3051:          node.nodeBnd->segment->carea = nan("1");
 3052: 
 3053:       }
 3054: //          else {  XXXXXX
 3055: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3056: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3057: //          }
 3058:       
 3059: 
 3060:    }
 3061:    else {
 3062: 
 3063:       node.nodeBnd = nullptr; // For internal nodes
 3064: 
 3065:       if (isbnd[i] == landSegment) {
 3066:          node.nodeBnd = &landBoundaryNode;
 3067:          node.nodeBnd->segment = &landBoundarySegment;
 3068:       }
 3069:       // node.nodeBnd->node = &node;
 3070:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3071:       // // node.nodeBnd = nullptr;
 3072:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3073:       
 3074:    }
 3075:    
 3076:    // XXXX GAUSSIAN HILL VELOCITIES
 3077: #ifdef GAUSSIAN_HILL_VELOCITIES
 3078:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3079:       constexpr double rot_per = 3000.0;
 3080:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3081:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3082:    // XXXXX
 3083: #endif
 3084: 
 3085: }
 3086: 
 3087: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3088:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3089:                                     double *wind_rotate_angle,   
 3090:                                     int *isdel, int *isidenode, int *isbnd,
 3091:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3092:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3093:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3094:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3095:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3096:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3097:                                     double *drag, double *roughness) {
 3098: 
 3099: 
 3100:    SIDE(pside);
 3101:    Side &side(*pside);
 3102:    const int i = idx_side;
 3103: 
 3104:    side.idx = i;  
 3105:    
 3106:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3107:    const double fc   = 2.0*omega_e*sin(sfea0);
 3108:    const double beta = 2.0*omega_e*cos(sfea0);
 3109: 
 3110:    // finding the pointer to the nodes that form the side
 3111:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3112:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3113: 
 3114:    const int locidx_n1 = localNodeIndices[idx_n1];
 3115:    const int locidx_n2 = localNodeIndices[idx_n2];
 3116:    const int part_n1 =   localNodePart[idx_n1];
 3117:    const int part_n2 =   localNodePart[idx_n2];
 3118: 
 3119:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3120:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3121: 
 3122:    // Counts the number of sides connected to each node
 3123:    side.n1->numSides++;
 3124:    side.n2->numSides++;
 3125: 
 3126:    // Normal, unitary vector to the side
 3127:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3128:    side.n = normalize(side.n);
 3129: 
 3130:    // Side boundary type
 3131:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3132:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3133: 
 3134:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3135:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3136:    {
 3137:       bool isLand = false;
 3138:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3139:       
 3140:       if (isbs > -1) {
 3141:          // assert(isLand || isbs>=0);
 3142:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3143: 
 3144:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3145: printf("i = %d, isbs = %d, idxSideBoundary = %d, side.sideBnd = %p\n", i, isbs, idxSideBoundary, side.sideBnd);               
 3146:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3147:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3148: 
 3149:          assert (isLand == side.sideBnd->segment->isLand);
 3150: 
 3151:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3152:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3153:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3154: 
 3155:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3156:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3157:          
 3158:          side.sideBnd->side = &side;
 3159: 
 3160:       }
 3161:       else {
 3162:          side.sideBnd = nullptr;
 3163:       }
 3164:    }
 3165:    else 
 3166:    {
 3167:       side.sideBnd = nullptr;
 3168:    }
 3169: 
 3170: 
 3171:    // finding the pointer to the elements that share the side
 3172:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3173:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3174: 
 3175:    if (idx_e1 > -1) {
 3176:       const int locidx_e1 = localElemIndices[idx_e1];
 3177:       const int part_e1 =  localElemPart[idx_e1];
 3178:       side.elems[0] = elems[part_e1] + locidx_e1;
 3179: 
 3180:    }
 3181:    else {
 3182:       side.elems[0] = nullptr;
 3183:    }
 3184: 
 3185:    if (idx_e2 > -1) {
 3186:       const int locidx_e2 = localElemIndices[idx_e2];
 3187:       const int part_e2 =  localElemPart[idx_e2];
 3188:       side.elems[1] = elems[part_e2] + locidx_e2;
 3189:    }
 3190:    else {
 3191:       side.elems[1] = nullptr;
 3192:    }
 3193: 
 3194:    // Compute the center of the side
 3195:    side.center = 0.5*(side.n1->p + side.n2->p);
 3196: 
 3197:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3198:    side.shapiro = shapiro0;
 3199: 
 3200: #ifdef GAUSSIAN_HILL_VELOCITIES
 3201: // XXXX
 3202: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3203: constexpr double rot_per=3000.0;
 3204: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3205: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3206: // XXXXX      
 3207: #endif
 3208:    // Compute the z level at the center of the side
 3209:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3210:    
 3211:    // Compute the length of the side
 3212:    const Vector2 vLen = side.n2->p - side.n1->p;
 3213:    side.len = sqrt(dot(vLen, vLen));
 3214: 
 3215: 
 3216:    // Compute the Coriolis coefficient
 3217: 
 3218:    if constexpr(ncor == -1 || ncor == 0) {
 3219:       side.coriolis = coricoef;
 3220:    }
 3221:    else {
 3222:       const double sphi = side.lat();  // Latitude at the center of the side
 3223: 
 3224: // XXXXXX ERROR WHEN use_ll is false??????
 3225:       if constexpr(ics == 1) {
 3226:          // XXXXXXX
 3227:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3228:       }
 3229:       else {
 3230:          side.coriolis = 2.0*omega_e*sin(sphi);
 3231:       }
 3232: 
 3233:    }
 3234: }
 3235: 
 3236: 
 3237: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3238:    double *node_coords, double *node_coords_ll, bool use_ll,
 3239:    double *wind_rotate_angle,   
 3240:    int *isdel, int *isidenode, int *isbnd,
 3241:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3242:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3243:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3244:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3245:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3246:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3247:    double *drag, double *roughness) {
 3248: 
 3249:    ELEM(pelem);
 3250:    Element &elem(*pelem);
 3251:    const int i = idx_elem;
 3252: 
 3253:    elem.idx = i;
 3254: 
 3255:    for (int j = 0; j < i34[i]; j++) {
 3256:       const int idxNode = elnode[i*4 + j];  
 3257:       const int idxSide = elside[i*4 + j];
 3258:       
 3259:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3260:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3261: printf("WWW i = %d, j = %d, node = %p, side = %p\n", i, j, elem.nodes[j], elem.sides[j]);      
 3262: 
 3263: 
 3264:       // Find the neighboring element  
 3265:       if (elem.sides[j]->elems[0] == &elem) {
 3266:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3267:       }
 3268:       else {
 3269:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3270:       }
 3271:       
 3272:    }
 3273: 
 3274:    elem.i34 = i34[i];
 3275: 
 3276:    // Compute the centroid of the element and its depth
 3277:    Vector2 center = {0.0, 0.0};
 3278:    elem.depth = 0.0;
 3279:    for (int j = 0; j < i34[i]; j++) {
 3280: 
 3281: // printf("WWW i = %d, node = %p, elem.i34 = %d\n", i, elem.nodes[j], elem.i34);    
 3282: 
 3283: 
 3284:       center += elem.nodes[j]->p/i34[i];
 3285:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3286:    }
 3287:    elem.center = center;
 3288: 
 3289:    
 3290:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3291:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3292: 
 3293:    elem.area = elem.computeSignedArea(); 
 3294:    elem.radius = sqrt(elem.area)/pi; 
 3295:    
 3296:    // Determines which way the normal vector to each side is oriented.
 3297:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3298:    for (int j = 0; j < i34[i]; j++)  
 3299:    {
 3300:       if (elem.sides[j]->elems[0] == &elem) {
 3301:          elem.ssign[j] =  1.0;
 3302:       }
 3303:       else {
 3304:          elem.ssign[j] = -1.0;
 3305:       }
 3306: 
 3307:    }
 3308: 
 3309:    // Derivatives of shape functions
 3310:    //  For ics=2, this is done inside element/ll frame XXX
 3311:    //  For quads, the derivative is evaluated at centroid
 3312:    for (int j = 0; j < elem.i34; j++) {
 3313:       const double area = elem.area;
 3314:       const int id2 = elem.nxq(1 + j);
 3315:       const int id3 = elem.nxq(2 + j);
 3316:       const int id4 = elem.nxq(3 + j);
 3317:       if (elem.isTri()) {
 3318:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3319:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3320:          // da1/dx = (y1 - y2)/(2*area)
 3321:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3322:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3323:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3324:       }
 3325:       else  { // Quad; evaluate at centroid
 3326:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3327:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3328:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3329:       } // if Tri
 3330: 
 3331:    } // for j   
 3332:    
 3333:    
 3334: 
 3335: }
 3336: 
 3337: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3338:                                             double *emo, double *efa, 
 3339:                                             double *umo, double *ufa, 
 3340:                                             double *vmo, double *vfa) {
 3341: 
 3342: 
 3343:    NODE_BND(nodeBnd);
 3344:    const int idx = idx_node_bnd;    
 3345: 
 3346:    nodeBnd->idx = idx;
 3347: 
 3348:    // Need to find the segment index and the index of the node on the segment
 3349:    int idxNode = -1;
 3350:    int iseg, i;
 3351:    for (iseg = 0; iseg < nope; iseg++) {
 3352:       // for each segment...
 3353:       for (i = 0; i < nond[iseg]; i++) {
 3354:          idxNode = iond[iseg + i*nope];
 3355:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3356:          
 3357:       }
 3358:    }
 3359: 
 3360:    assert(iseg < nope && "iseg is out of bounds");
 3361: 
 3362: found: // Jumped here when the node was found
 3363: 
 3364:    nodeBnd->isEssentialBC = true;
 3365:    nodeBnd->elbc = 0.0;
 3366: 
 3367:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3368: 
 3369:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX
 3370:       nodeBnd->efa[jfr] = efa[idx2];
 3371:       nodeBnd->emo[jfr] = emo[idx2];
 3372:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3373:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3374: 
 3375:    }
 3376:         
 3377: 
 3378: }
