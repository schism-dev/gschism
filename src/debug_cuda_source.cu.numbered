 2248: /**
 2249:  * Find the element that contains the target point.
 2250:  * 
 2251:  * @param x0,y0,z0     Starting position coordinates
 2252:  * @param xt,yt,zt     Target position coordinates
 2253:  * @param dtb          Time step for tracking
 2254:  * @param u_int        Initial velocity components
 2255:  * @param nextElem     Starting/resulting element index
 2256:  * 
 2257:  * @return Status code of type trackExitCodes
 2258:  * 
 2259:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2260:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2261:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2262:  * as close the the segment AB as possible, the next point at each iteration is computed
 2263:  * along segment AB, but just after the current element.
 2264:  */
 2265: 
 2266: 
 2267: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2268: 
 2269:    constexpr int MAX_ITERATIONS = 40;
 2270: 
 2271:    int iter = 0;
 2272:    double fac = 0.00001;
 2273:    while (iter < MAX_ITERATIONS) {
 2274:       iter++;
 2275: 
 2276:       Bool4 isLeft, isObtuse, isBisector;
 2277:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2278: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2279:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2280: 
 2281: 
 2282:       if (isValid.none()) 
 2283:       // Inside the element if none of the edges is a valid continuation
 2284:       {
 2285:          // Just returns true and the element (curElem) is unchanged).
 2286:          // This means that the algorithm has found the element that contains the target point.
 2287:          return true;
 2288:       }
 2289:       else { // Outside the element
 2290: 
 2291:          // Outside this element. Pick the first valid exit side and cross.
 2292:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2293:          Element *prevElem = curElem;
 2294:          curElem = lastCrossSide->otherElem(curElem);
 2295: 
 2296:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2297:          // along the boundary.
 2298:          if (curElem == nullptr || curElem->isDry) {
 2299:          
 2300:             curElem = prevElem;
 2301:             return false;
 2302:          }
 2303:          
 2304:       }
 2305: 
 2306:    }
 2307: 
 2308:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2309: }
 2310: 
