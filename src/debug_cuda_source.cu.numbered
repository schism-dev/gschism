 7600: __global__ void getStructSizes(int* sizes)  {
 7601:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7602:       sizes[0] = (int)sizeof(Node);
 7603:       sizes[1] = (int)sizeof(Element);
 7604:       sizes[2] = (int)sizeof(Side);
 7605:       sizes[3] = (int)sizeof(NodeBoundary);
 7606:       sizes[4] = (int)sizeof(SideBoundary);
 7607:       sizes[5] = (int)sizeof(BoundarySegment);
 7608: }
