 7992: __global__ void printMatrix(bool full) {
 7993:    // Debugging: print the matrix
 7994: 
 7995:    const int size = mesh->np;
 7996:    double sum = 0.0;
 7997:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7998:       const Node *node = mesh->localNodeData + idx_node;
 7999:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8000:       for (int j = 0; j < node->numNodes; j++) {
 8001:          Node* nbNode = node->nodes[j];
 8002:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8003:          sum += node->coeffMatrix[j];
 8004:       }
 8005:       if (full) printf("]\n");
 8006: 
 8007: 
 8008:    }
 8009:    if (!full) printf("sum=%lf\n", sum);
 8010: }
