 9275: 
 9276: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9277:    ELEM(elem);
 9278: 
 9279:    switch (varCode) {
 9280:       case (int)VarCode::outputCoords: {
 9281:          const Point2 coords = elem->outputCoords();
 9282:          double *out = (double *)((char *)res + idx_elem * 16);
 9283:          out[0] = coords.x;
 9284:          out[1] = coords.y;
 9285:          break;
 9286:       }
 9287:       case (int)VarCode::FaceIndices: {
 9288:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9289:          for (int j = 0; j < 4; j++)
 9290:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9291:          break;
 9292:       }
 9293:       case (int)VarCode::isdry:
 9294:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9295:          break;
 9296:       case (int)VarCode::w: {
 9297:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9298:          if (k >= 0)
 9299:             out[0] = elem->w[k];
 9300:          else
 9301:             for (int lev = 0; lev < nvrt; lev++)
 9302:                out[lev] = elem->w[lev];
 9303:          break;
 9304:       }
 9305:    }
 9306: }
