 2115:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2116:       // Compute the different time ramps used in the code 
 2117:       // This function is performed by just one thread
 2118: 
 2119:       rampbc = 1.0;
 2120:       if constexpr(ibc == 0) {
 2121:          if (drampbc > 0.0) {
 2122:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2123:          } else {
 2124:             rampbc = 1.0;
 2125:          }
 2126:       }
 2127: 
 2128:       if (nws != 0) {
 2129:          if (drampwind > 0.0) {
 2130:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2131:          } else {
 2132:             rampwind = 1.0;
 2133:          }
 2134:       }
 2135: 
 2136:       if (drampwafo > 0.0) {
 2137:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2138:       } else {
 2139:          rampwafo = 1.0;
 2140:       }
 2141: 
 2142:       // For source/sinks
 2143:       if (if_source && dramp_ss > 0.0) {
 2144:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2145:       } else {
 2146:          ramp_ss = 1.0;
 2147:       }
 2148: 
 2149:       if (dramp > 0.0) {
 2150:          ramp = tanh(2.0*time/86400.0/dramp);
 2151:       } else {
 2152:          ramp = 1.0;
 2153:       }
 2154: 
 2155: 
 2156:    }
