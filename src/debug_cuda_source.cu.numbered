 2084: // Helper functions for computing the local node index at a given offset from another.
 2085: __device__ __inline__ int nxq(int offset, int index, int size) {
 2086:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2087:    // to the index to make it positive
 2088:    assert(index + offset + 16*size >= 0);
 2089:    return (index + offset + 16*size) % size;  
 2090: }
 2091: 
 2092: __device__ __inline__ int nxq(int index, int size) {
 2093:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2094:    // to the index to make it positive
 2095:    assert(index + 16*size >= 0);
 2096:    return (index + 16*size) % size; 
 2097: }
