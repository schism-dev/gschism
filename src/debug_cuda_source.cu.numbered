 7091:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 7092:    double *drag, double *roughness, double *rmanning) {
 7093: 
 7094:    mesh->populateNodes(i34, isbnd, sharedIdxNodeBoundary, 
 7095:                        node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7096:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7097:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7098:                        localNodeIndices, localElemIndices, localSideIndices,
 7099:                        localNodePart, localElemPart, localSidePart,
 7100:                        drag, roughness, rmanning);
