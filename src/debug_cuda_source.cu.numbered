 4844: 
 4845: 
 4846:    __global__ void backtrackAllNodes(void) {
 4847: 
 4848:       // max/min # of sub-divisions
 4849:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4850:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4851: 
 4852:       SIDE(side);
 4853: 
 4854:       const int kb = side->kb;
 4855: 
 4856: 
 4857:       // Initialize btrack velocities to the actual velocities at the side 
 4858:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4859:   
 4860: 
 4861:       if (side->isDry) return;
 4862:      
 4863: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4864: 
 4865:       // Checks that at least one element is not dry
 4866:       const Element *elem1 = side->elems[0];
 4867:       const Element *elem2 = side->elems[1];
 4868: 
 4869: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4870: 
 4871:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4872:       
 4873:       // XXXXXX
 4874:       // !swild_tmp to store global coord. of the starting side
 4875:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4876:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4877:       // !Use sframe2 
 4878:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4879: 
 4880: 
 4881:       for (int k = kb; k < nvrt; k++) {
 4882:       //  Initialize (xt,yt,zt), nnel and vel.
 4883:       //  For ics=2, the coordinates are all in the side's local frame
 4884:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4885: 
 4886:          const int iadvf = side->iadv();  // Advection flag   
 4887:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4888: 
 4889:          const double vmag2 = norm2(side->u2[k]);
 4890: 
 4891:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4892:             // No activity 
 4893: 
 4894:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4895: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4896: 
 4897:             
 4898:          } else {  // do btrack
 4899: 
 4900:             // Compute number of sub-divisions based on local gradients of the velocity field
 4901: 
 4902:             // XXX IS THIS NECESSARY?
 4903:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4904:             double suma = 0.0;
 4905:             int icount = 0;
 4906:             for (int l=0; l<2; l++) {
 4907:             // For each element sharing the side...
 4908: 
 4909:                const Element *elem = side->elems[l];
 4910:                  
 4911:                if (elem == nullptr) continue;
 4912: 
 4913:                icount++;
 4914: 
 4915:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4916:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4917:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4918: 
 4919:                double utmp[4];
 4920:                double vtmp[4];
 4921:                for (int j = 0; j < elem->i34; j++) {
 4922: 
 4923:                   const Node *node = elem->nodes[j];
 4924: 
 4925:                   if constexpr(ics==1) {
 4926:                      utmp[j] = node->u2[k].x;
 4927:                      vtmp[j] = node->u2[k].y;  
 4928: 
 4929:                   } else {
 4930:                      // 'Project' the velocity from the node frame to the element frame
 4931:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4932:                      utmp[j] = tmp_u2.x;
 4933:                      vtmp[j] = tmp_u2.y;
 4934: 
 4935:                   }
 4936:                } // for j
 4937: 
 4938:                const Vector2 grad_u = elem->grad2(utmp); 
 4939:                const Vector2 grad_v = elem->grad2(vtmp);
 4940:    
 4941:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4942:             } // for ii
 4943: 
 4944:             assert(icount > 0 && "Impossible 77");
 4945: 
 4946:             // '4' is somewhat arbitrary
 4947:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4948: 
 4949:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4950:             Vector3 u_int = {0.0, 0.0, 0.0};
 4951: 
 4952:             side->btrack(k, dt, dtbk, u_int);
 4953: 
 4954: 
 4955:             side->btu[k] = {u_int.x, u_int.y};
 4956:                
 4957:          } // if vmag (do backtrack)
 4958: 
 4959: 
 4960:       } // for k=kb,nvrt-1
 4961: 
 4962:    }
 4963: 
 4964: } // extern "C"
 4965: 
 4966: template<int nc>
 4967: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4968: 
 4969: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4970: //
 4971: // a,b,c,rhs: input vectors and are not modified by this program.
 4972: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4973: // rhs is the r.h.s.
 4974: // n: actual rank of the system.
 4975: // rows in u() and rhs();
 4976: // u: output with nc columns (transposed to rows)
 4977: // gam: a working array.
 4978: //
 4979: // NOTES:
 4980: // This is a template function that allows for different numbers of columns in the rhs vector.
 4981: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4982: 
 4983:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4984:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4985: 
 4986:    double bet = b[0];
 4987:    if constexpr (nc == 1) {
 4988:       u[0] = rhs[0]/bet;
 4989:    } else {
 4990:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4991:    }
 4992: 
 4993:    for (int j = 1; j < n; j++) {
 4994:       gam[j] = c[j - 1]/bet;
 4995:       bet = b[j] - a[j]*gam[j];
 4996: 
 4997:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4998: 
 4999:       if constexpr (nc == 1) {
 5000:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5001:       } else {
 5002:          for (int l = 0; l < nc; l++) {
 5003:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5004:          }
 5005:       }
 5006:    }
 5007: 
 5008:    // Back-substitution
 5009:    for (int j = n - 2; j >= 0; j--) {
 5010:       if constexpr (nc == 1) {
 5011:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5012:       } else {
 5013:          for (int l = 0; l < nc; l++) {
 5014:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5015:          }
 5016:       }
 5017:    }
 5018: }
 5019: 
 5020: 
 5021: 
 5022: // Helper function that contains the core algorithm
 5023: template<typename XAccessor, typename YAccessor>
 5024: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5025:                                     double  yp_top, double  yp_bot, 
 5026:                                     CubicSpline &spline) {
 5027:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5028:    // 
 5029:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5030:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5031:    //
 5032:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5033:    // 
 5034:    // Inputs: 
 5035:    //            n: dimension for x etc; # of data pts (>=2);
 5036:    //            getX, getY: functions to access x,y coordinates
 5037:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5038:    //     Output: 
 5039:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5040: 
 5041:    const int n = k2 - k1 + 1;
 5042:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5043: 
 5044:    // Allocate memory for the splines
 5045:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5046:    spline.x   = new double[n];
 5047:    spline.y   = new double[n];
 5048:    spline.yp  = new double[n];
 5049:    spline.ypp = new double[n];
 5050: 
 5051:    for (int k=k1; k<=k2; k++) {
 5052:       spline.x[k] = getX(k);
 5053:       spline.y[k] = getY(k);
 5054:    }
 5055: 
 5056:    // This is to simplify expressions later
 5057:    double *x = spline.x;
 5058:    double *y = spline.y;
 5059: 
 5060:    double *a = nullptr;
 5061:    double *b = nullptr;
 5062:    double *c = nullptr;
 5063:    double *gam = nullptr;
 5064:    double *rhs = nullptr;
 5065:    
 5066: 
 5067:       a = new double[n];   // Lower diagonal
 5068:       b = new double[n];   // Diagonal
 5069:       c = new double[n];   // Upper diagonal
 5070:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5071:       rhs = new double[n]; // Right-hand side
 5072: 
 5073:    for (int k=k1; k<=k2; k++) {
 5074:       if (k == k1) {
 5075:          // Bottom level
 5076:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5077:          b[k] = (x[k+1] - x[k])/3.0;
 5078:          c[k] = b[k]/2.0;
 5079:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5080:       } else if (k == n - 1) {
 5081:          // Top level (surface)
 5082:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5083:          b[k] = (x[k] - x[k-1])/3.0;
 5084:          a[k] = b[k]/2.0;
 5085:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5086:       } else {
 5087:          // Intermediate levels
 5088:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5089:          b[k] = (x[k+1] - x[k-1])/3.0;
 5090:          a[k] = (x[k  ] - x[k-1])/6.0;
 5091:          c[k] = (x[k+1] - x[k  ])/6.0;
 5092:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5093:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5094:       }
 5095:    }
 5096: 
 5097:    // Solve the tridiagonal system
 5098:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5099:    
 5100:    spline.yp[k1] = yp_bot;
 5101:    spline.yp[k2] = yp_top;
 5102: 
 5103:    // Compute rest of 1st derivatives using the splines
 5104:    for (int k=k1+1; k<k2; k++) {
 5105:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5106:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5107:    }
 5108:    
 5109:    delete[] a;
 5110:    delete[] b;
 5111:    delete[] c;
 5112:    delete[] gam;
 5113:    delete[] rhs;
 5114: 
 5115: }
 5116: 
 5117: // Array version
 5118: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5119:                                 double y_top, double y_bot, 
 5120:                                 CubicSpline &spline) {
 5121:    auto getX = [x] (int k) { return x[k]; };
 5122:    auto getY = [y] (int k) { return y[k]; };
 5123:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5124: }
 5125: 
 5126: // Lambda version - allows custom access patterns
 5127: template<typename XFunc, typename YFunc>
 5128: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5129:                                 double y_top, double y_bot,
 5130:                                 CubicSpline &spline) {
 5131:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5132: }
 5133: 
 5134: 
 5135: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5136: {
 5137:    assert("Not implemented");
 5138: 
 5139:    return 0.0;
 5140: }
