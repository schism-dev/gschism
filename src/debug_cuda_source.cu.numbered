 3405: 
 3406: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3407:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3408:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3409:    // 
 3410:    // This kernel is called for all nodes.
 3411: 
 3412: 
 3413:    NODE(node1);
 3414: 
 3415: 
 3416:    node1->clearMatrixRow();
 3417:    node1->qel = 0.0;
 3418: 
 3419:    // THIS IS FOR STRUCTURES XXX
 3420:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3421: 
 3422:    
 3423:    for (int j=0; j<node1->numElements; j++) {
 3424:       // For each element connected to the node...
 3425: 
 3426:       Element *elem = node1->elements[j];
 3427: 
 3428:       // Compute the average gravity
 3429:       const double grav3 = elem->mean(&Node::grav2);
 3430: 
 3431:       // Look at the documentation for the description of the terms in the following integrals
 3432: 
 3433:       // Integral I_1 
 3434:       // \bar{\breve{H}} 
 3435:       const double hhatb = elem->mean(&Side::hhat);        
 3436: 
 3437:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3438: 
 3439:       const int id1 = elem->nodeLocalIdx(node1); 
 3440:       const double area = elem->area;
 3441: 
 3442:       if (elem->isTri()) {
 3443: 
 3444:          // To clarify the notation in this section: 
 3445:          //   i stands for the node under consideration (node1)
 3446:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3447:          const int id2 = elem->nxq(1 + id1);
 3448:          const int id3 = elem->nxq(2 + id1);
 3449:          Node *node2 = elem->nodes[id2];
 3450:          Node *node3 = elem->nodes[id3];
 3451: 
 3452:          const Point2 x1 = node1->p;
 3453:          const Point2 x2 = node2->p;
 3454:          const Point2 x3 = node3->p;
 3455: 
 3456:          // integral of phi_i*phi_j
 3457:          const double ipp_ii = (1.0/6.0 )*area;
 3458:          const double ipp_ij = (1.0/12.0)*area;
 3459:          const double ipp_ik = (1.0/12.0)*area;
 3460: 
 3461:          // integral of [(grad phi_i) * (grad phi_j)]
 3462:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3463:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3464:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3465: 
 3466:          // Computes the different components of integral I_1 of each node with respect to node i.
 3467:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3468:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3469:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3470: 
 3471:          node1->addToSparseMatrix(node1, I1_ii);
 3472:          node1->addToSparseMatrix(node2, I1_ij); 
 3473:          node1->addToSparseMatrix(node3, I1_ik);
 3474: 
 3475:       }
 3476:       else { // Quad
 3477:          // XXX IMPLEMENT THIS
 3478:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3479: 
 3480:          // To clarify the notation in this section: 
 3481:          //   i stands for the node under consideration (node1)
 3482:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3483:          const int id2 = elem->nxq(1 + id1);
 3484:          const int id3 = elem->nxq(2 + id1);
 3485:          const int id4 = elem->nxq(3 + id1);
 3486:          Node *node2 = elem->nodes[id2];
 3487:          Node *node3 = elem->nodes[id3];
 3488:          Node *node4 = elem->nodes[id4];         
 3489: 
 3490:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3491:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3492:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3493:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3494:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3495: 
 3496:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3497:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3498:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3499:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3500:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3501: 
 3502:          // Computes the different components of integral I_1 of each node with respect to node i.
 3503:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3504:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3505:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3506:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3507: 
 3508:          node1->addToSparseMatrix(node1, I1_ii);
 3509:          node1->addToSparseMatrix(node2, I1_ij); 
 3510:          node1->addToSparseMatrix(node3, I1_ik);
 3511:          node1->addToSparseMatrix(node4, I1_il);
 3512:   
 3513: 
 3514: 
 3515:       
 3516:       } 
 3517: 
 3518:  
 3519:       // Integral I_4
 3520:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3521:       // Where
 3522:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3523: 
 3524:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3525:       // of U over the element.
 3526:       Vector2 Umean = {0.0, 0.0};
 3527:       for (int m=0; m<elem->i34; m++) {      
 3528:          const Side *side = elem->sides[m];
 3529: 
 3530:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3531:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3532:       }
 3533:       Umean = Umean/elem->i34;
 3534: 
 3535:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3536: 
 3537:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3538:       const double I_4_1 = dot(gradPhi_1, Umean);
 3539: 
 3540:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3541:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3542:      
 3543:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3544: 
 3545:       // Additional terms 
 3546:       double vnorm = 0.0;
 3547:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3548:          Vector3 ubed;
 3549:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3550: 
 3551:          Vector3 gradP = {0.0, 0.0, 1.0};
 3552:          for (int m=0; m < elem->i34; m++) {
 3553:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3554:            gradP += toVector3(gradP_2D, 0.0);
 3555:          }   
 3556:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3557:       } // imm==2
 3558: 
 3559:       if (elem->isTri()) {
 3560:          for (int l=0; l<3; l++) {
 3561:             double fac;
 3562: 
 3563:             Node *node = elem->nodes[l];
 3564: 
 3565:             fac = (node == node1) ? 2.0 : 1.0;
 3566:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3567:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3568:            
 3569:          }
 3570: 
 3571: 
 3572:          if (!elem->isDry) {
 3573:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3574: 
 3575:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3576: 
 3577:          }
 3578: 
 3579:       } // isTri
 3580:       else { // isQuad
 3581:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3582:          // for (int l=0; l<4; l++) {
 3583:          //   const Node *node = elem->nodes[l];
 3584: 
 3585:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3586:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3587: 
 3588:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3589:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3590:          // }
 3591: 
 3592:       } // isQuad
 3593: 
 3594: 
 3595:      node1->qel += (dt/elem->i34)*elem->vsource;
 3596:       
 3597: 
 3598:    } // for all elements connected to the node
 3599:    
 3600: 
 3601:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3602:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3603:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3604:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3605:       // If it is an open boundary node...
 3606: 
 3607:       // At least one open bnd side, maybe two
 3608:       for (int l=0; l<2; l++) { 
 3609: 
 3610:          // Gets each of the sides sharing the node. 
 3611:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3612: 
 3613:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3614:          
 3615: 
 3616:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3617:          if (sideBnd != nullptr) {
 3618:             // If the side is on a boundary...
 3619: 
 3620:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3621: 
 3622:             // Get the boundary segment
 3623:             const BoundarySegment *sideSegment = sideBnd->segment;
 3624:             const Side *side = sideBnd->side;
 3625: 
 3626:             // Integral I_3
 3627:             if (sideSegment->ifltype != 0) {
 3628:             // Natural or Flather b.c.
 3629: 
 3630:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3631:                // especially for Flather b.c.
 3632:                double ri3 = 0.0;
 3633:                if (!side->isDry) {
 3634:                   // If the side is not dry
 3635:                   
 3636:                   // Computes the side flux of (uth, vth)
 3637:                   double Vn = 0.0;
 3638:                   for (int k = side->kb; k<nvrt-1; k++) {
 3639:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3640:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3641: 
 3642:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3643:                   }
 3644: 
 3645:                   ri3 = 0.5*side->len*Vn;
 3646:                }
 3647: 
 3648:                if (sideSegment->ifltype == -1) { // Flather 1
 3649: 
 3650:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3651:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3652: 
 3653:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3654:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3655:                   
 3656:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3657:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3658: 
 3659:                } 
 3660:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3661:                   // Reset ri3
 3662:                   ri3 = 0.0;
 3663: 
 3664:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3665: 
 3666:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3667: 
 3668:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3669:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3670: 
 3671:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3672:                   node1->addToSparseMatrix(node1, con0*2.0);
 3673:                   node1->addToSparseMatrix(node2, con0);
 3674: 
 3675:                } // if Flather or Discharge
 3676: 
 3677: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3678:                node1->qel -= thetai*dt*ri3;
 3679: 
 3680: 
 3681:             } // I_3
 3682:           
 3683: 
 3684:             // Integral I_5
 3685:             if(!side->isDry) {
 3686: 
 3687:                const double Unbar = dot(side->U, side->n);
 3688:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3689: 
 3690:             } // I_5
 3691: 
 3692:          } // if is boundary side
 3693: 
 3694:       } // for l
 3695: 
 3696:    } // if isbnd
 3697: 
 3698: 
 3699: }
 3700: 
 3701: 
 3702: 
 3703: extern "C" {
 3704:    __global__ void rollUpElevation(void) {
 3705: 
 3706:       NODE(node);
 3707: 
 3708:       node->eta1 = node->eta2;
 3709: 
 3710:    }
 3711: 
 3712: 
 3713:    __global__ void backtrackAllNodes(void) {
 3714: 
 3715:       // max/min # of sub-divisions
 3716:       const int ndelt_max = max(1.0, dt/dtb_min);
 3717:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3718: 
 3719:       // Removed all references to swild98 XXX
 3720:       // swild98=0.d0 !init
 3721: 
 3722: 
 3723:       SIDE(side);
 3724: 
 3725:       const int kb = side->kb;
 3726: 
 3727: 
 3728:       // Initialize btrack velocities to the actual velocities at the side 
 3729:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3730: 
 3731:       if (side->isDry) return;
 3732: 
 3733: 
 3734:       // Checks that at least one element is not dry
 3735:       const Element *elem1 = side->elems[0];
 3736:       const Element *elem2 = side->elems[1];
 3737: 
 3738: 
 3739:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3740:       
 3741:       // XXXXXX
 3742:       // !swild_tmp to store global coord. of the starting side
 3743:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3744:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3745:       // !Use sframe2 
 3746:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3747: 
 3748: 
 3749:       for (int k = kb; k < nvrt; k++) {
 3750:       //  Initialize (xt,yt,zt), nnel and vel.
 3751:       //  For ics=2, the coordinates are in local frames
 3752:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3753: 
 3754: 
 3755:          const int iadvf = side->iadv();  // Advection flag
 3756: 
 3757:          Point3 xt;
 3758:          if constexpr(ics==1) {
 3759:             xt = side->center3D(k); 
 3760:          }
 3761:          else // lat/lon; in side lat/lon frame
 3762:          {
 3763:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3764:          // XXX IMPLEMENT THIS
 3765:       //          xt=0.d0
 3766:       //          yt=0.d0
 3767:       //          !centroid coord. for nudging
 3768:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3769:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3770:          }  // ics
 3771: 
 3772: 
 3773: 
 3774:          // If on land or open boundary...
 3775:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3776:          
 3777:          const double vmag = length(side->u2[k]);
 3778: 
 3779:          if (vmag <= velmin_btrack) {
 3780:             // No activity 
 3781: 
 3782:             side->btu[k] = side->u2[k];
 3783:             
 3784:          } else {  // do btrack
 3785: 
 3786:             // Compute number of sub-divisions based on local gradients 
 3787:             // XXX IS THIS NECESSARY?
 3788:             double suma = 0.0;
 3789:             int icount = 0;
 3790:             for (int ii=0; ii<2; ii++) {
 3791: 
 3792:                const Element *elem = side->elems[ii];
 3793:                  
 3794:                if (elem == nullptr) continue;
 3795: 
 3796:                icount++;
 3797: 
 3798:                // Not strictly along z; in ll frame for ics=2
 3799: 
 3800:                double utmp[4];
 3801:                double vtmp[4];
 3802:                for (int jj = 0; jj < elem->i34; jj++) {
 3803: 
 3804:                   const Node *node = elem->nodes[jj];
 3805: 
 3806:                   if constexpr(ics==1) {
 3807:                      utmp[jj] = node->u2[k].x;
 3808:                      vtmp[jj] = node->u2[k].y;  
 3809:                   } else {
 3810:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3811:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3812:                   }
 3813:                } // for jj
 3814: 
 3815:                const Vector2 grad_u = elem->grad2(utmp); 
 3816:                const Vector2 grad_v = elem->grad2(vtmp);
 3817: 
 3818:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3819:             } // for ii
 3820: 
 3821:             assert(icount > 0 && "Impossible 77");
 3822: 
 3823:             // '4' is somewhat arbitrary
 3824:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3825: 
 3826:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3827:          
 3828: 
 3829:             Vector3 u_int = {0.0, 0.0, 0.0};
 3830: 
 3831:             side->btrack(k, dt, dtbk, u_int);
 3832:             side->btu[k] = toVector2(u_int);
 3833:                
 3834:          } // if vmag (do backtrack)
 3835: 
 3836:       } // for k=kb,nvrt-1
 3837: 
 3838:    }
 3839: 
 3840: } // extern "C"
 3841: 
 3842: template<int nc>
 3843: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3844: 
 3845: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3846: //
 3847: // a,b,c,rhs: input vectors and are not modified by this program.
 3848: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3849: // rhs is the r.h.s.
 3850: // n: actual rank of the system.
 3851: // rows in u() and rhs();
 3852: // u: output with nc columns (transposed to rows)
 3853: // gam: a working array.
 3854: //
 3855: // NOTES:
 3856: // This is a template function that allows for different numbers of columns in the rhs vector.
 3857: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3858: 
 3859:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3860:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3861: 
 3862:    double bet = b[0];
 3863:    if constexpr (nc == 1) {
 3864:       u[0] = rhs[0]/bet;
 3865:    } else {
 3866:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3867:    }
 3868: 
 3869:    for (int j = 1; j < n; j++) {
 3870:       gam[j] = c[j - 1]/bet;
 3871:       bet = b[j] - a[j]*gam[j];
 3872: 
 3873:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3874: 
 3875:       if constexpr (nc == 1) {
 3876:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3877:       } else {
 3878:          for (int l = 0; l < nc; l++) {
 3879:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3880:          }
 3881:       }
 3882:    }
 3883: 
 3884:    // Back-substitution
 3885:    for (int j = n - 2; j >= 0; j--) {
 3886:       if constexpr (nc == 1) {
 3887:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3888:       } else {
 3889:          for (int l = 0; l < nc; l++) {
 3890:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3891:          }
 3892:       }
 3893:    }
 3894: }
 3895: 
 3896: 
 3897: 
 3898: // Helper function that contains the core algorithm
 3899: template<typename XAccessor, typename YAccessor>
 3900: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3901:                                     double  yp_top, double  yp_bot, 
 3902:                                     CubicSpline &spline) {
 3903:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3904:    // 
 3905:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3906:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3907:    //
 3908:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3909:    // 
 3910:    // Inputs: 
 3911:    //            n: dimension for x etc; # of data pts (>=2);
 3912:    //            getX, getY: functions to access x,y coordinates
 3913:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3914:    //     Output: 
 3915:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3916: 
 3917:    const int n = k2 - k1 + 1;
 3918:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3919: 
 3920:    // Allocate memory for the splines
 3921:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3922:    spline.x   = new double[n];
 3923:    spline.y   = new double[n];
 3924:    spline.yp  = new double[n];
 3925:    spline.ypp = new double[n];
 3926: 
 3927:    for (int k=k1; k<=k2; k++) {
 3928:       spline.x[k] = getX(k);
 3929:       spline.y[k] = getY(k);
 3930:    }
 3931: 
 3932:    // This is to simplify expressions later
 3933:    double *x = spline.x;
 3934:    double *y = spline.y;
 3935: 
 3936:    double *a = nullptr;
 3937:    double *b = nullptr;
 3938:    double *c = nullptr;
 3939:    double *gam = nullptr;
 3940:    double *rhs = nullptr;
 3941:    
 3942: 
 3943:       a = new double[n];   // Lower diagonal
 3944:       b = new double[n];   // Diagonal
 3945:       c = new double[n];   // Upper diagonal
 3946:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3947:       rhs = new double[n]; // Right-hand side
 3948: 
 3949:    for (int k=k1; k<=k2; k++) {
 3950:       if (k == k1) {
 3951:          // Bottom level
 3952:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3953:          b[k] = (x[k+1] - x[k])/3.0;
 3954:          c[k] = b[k]/2.0;
 3955:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3956:       } else if (k == n - 1) {
 3957:          // Top level (surface)
 3958:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3959:          b[k] = (x[k] - x[k-1])/3.0;
 3960:          a[k] = b[k]/2.0;
 3961:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3962:       } else {
 3963:          // Intermediate levels
 3964:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3965:          b[k] = (x[k+1] - x[k-1])/3.0;
 3966:          a[k] = (x[k  ] - x[k-1])/6.0;
 3967:          c[k] = (x[k+1] - x[k  ])/6.0;
 3968:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3969:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3970:       }
 3971:    }
 3972: 
 3973:    // Solve the tridiagonal system
 3974:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3975:    
 3976:    spline.yp[k1] = yp_bot;
 3977:    spline.yp[k2] = yp_top;
 3978: 
 3979:    // Compute rest of 1st derivatives using the splines
 3980:    for (int k=k1+1; k<k2; k++) {
 3981:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3982:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3983:    }
 3984:    
 3985:    delete[] a;
 3986:    delete[] b;
 3987:    delete[] c;
 3988:    delete[] gam;
 3989:    delete[] rhs;
 3990: 
 3991: }
 3992: 
 3993: // Array version
 3994: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3995:                                 double y_top, double y_bot, 
 3996:                                 CubicSpline &spline) {
 3997:    auto getX = [x] (int k) { return x[k]; };
 3998:    auto getY = [y] (int k) { return y[k]; };
 3999:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4000: }
 4001: 
 4002: // Lambda version - allows custom access patterns
 4003: template<typename XFunc, typename YFunc>
 4004: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4005:                                 double y_top, double y_bot,
 4006:                                 CubicSpline &spline) {
 4007:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4008: }
 4009: 
 4010: 
 4011: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4012: {
 4013:    assert("Not implemented");
 4014: 
 4015:    return 0.0;
 4016: }
