 2271:    template<typename T>
 2272:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2273:       T values[4];
 2274:       getNodalValues(level, func, values);
 2275: 
 2276:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2277:       if constexpr (IsVector2<T>::value && ics == 2) {
 2278: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2279:          projectNodeVectorsToElementFrame(values);
 2280: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2281:       }
 2282: 
 2283:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2284:    }
 2285: 
 2286:    template<typename T>
 2287:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2288:       T values[4];
 2289:       getNodalValues(field, values);
 2290: 
 2291:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2292:       if constexpr (IsVector2<T>::value && ics == 2) {
 2293: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2294:          projectNodeVectorsToElementFrame(values);
 2295: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2296:       }
 2297:       
 2298:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2299:    }
 2300: 
 2301: 
 2302:    template<typename T>
 2303:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2304:       T values[4];
 2305:       getNodalValues(level, field, values);
 2306:       
 2307: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2308:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2309:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2310:       if constexpr (IsVector2<T>::value && ics == 2) {
 2311: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2312:          projectNodeVectorsToElementFrame(values);
 2313: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2314:       }
 2315: 
 2316:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2317:    }
