 1728: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1729:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1730: }
 1731: 
 1732: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1733:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1734: }   
 1735: 
 1736: __device__ __inline__ double min3(double a, double b, double c) {
 1737:    return min(a, min(b, c));
 1738: }
 1739: 
 1740: __device__ __inline__ double max3(double a, double b, double c) {
 1741:    return max(a, max(b, c));
 1742: }
 1743: 
 1744: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1745:    return min(a, min(b, min(c, d)));
 1746: }
