 2202:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2203:       // Compute the different time ramps used in the code 
 2204:       // This function is performed by just one thread
 2205: 
 2206:       rampbc = 1.0;
 2207:       if constexpr(ibc == 0) {
 2208:          if (drampbc > 0.0) {
 2209:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2210:          } else {
 2211:             rampbc = 1.0;
 2212:          }
 2213:       }
 2214: 
 2215:       if (nws != 0) {
 2216:          if (drampwind > 0.0) {
 2217:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2218:          } else {
 2219:             rampwind = 1.0;
 2220:          }
 2221:       }
 2222: 
 2223:       if (drampwafo > 0.0) {
 2224:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2225:       } else {
 2226:          rampwafo = 1.0;
 2227:       }
 2228: 
 2229:       // For source/sinks
 2230:       if (if_source && dramp_ss > 0.0) {
 2231:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2232:       } else {
 2233:          ramp_ss = 1.0;
 2234:       }
 2235: 
 2236:       if (dramp > 0.0) {
 2237:          ramp = tanh(2.0*time/86400.0/dramp);
 2238:       } else {
 2239:          ramp = 1.0;
 2240:       }
 2241: 
 2242: 
 2243:    }
