 1966:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1967:       // Compute the different time ramps used in the code 
 1968:       // This function is performed by just one thread
 1969: 
 1970:       rampbc = 1.0;
 1971:       if constexpr(ibc == 0) {
 1972:          if (drampbc > 0.0) {
 1973:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1974:          } else {
 1975:             rampbc = 1.0;
 1976:          }
 1977:       }
 1978: 
 1979:       if (nws != 0) {
 1980:          if (drampwind > 0.0) {
 1981:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1982:          } else {
 1983:             rampwind = 1.0;
 1984:          }
 1985:       }
 1986: 
 1987:       if (drampwafo > 0.0) {
 1988:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1989:       } else {
 1990:          rampwafo = 1.0;
 1991:       }
 1992: 
 1993:       // For source/sinks
 1994:       if (if_source && dramp_ss > 0.0) {
 1995:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1996:       } else {
 1997:          ramp_ss = 1.0;
 1998:       }
 1999: 
 2000:       if (dramp > 0.0) {
 2001:          ramp = tanh(2.0*time/86400.0/dramp);
 2002:       } else {
 2003:          ramp = 1.0;
 2004:       }
 2005: 
 2006: 
 2007:    }
