 1375:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1376:       // Compute the different time ramps used in the code 
 1377:       // This function is performed by just one thread
 1378: 
 1379:       if constexpr(ibc == 0) {
 1380:          if (drampbc > 0.0) {
 1381:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1382:          } else {
 1383:             rampbc = 1.0;
 1384:          }
 1385: 
 1386:          if (nws != 0 && drampwind > 0.0) {
 1387:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1388:          } else {
 1389:             rampwind = 1.0;
 1390:          }
 1391:       }
 1392: 
 1393:       if (drampwafo > 0.0) {
 1394:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1395:       } else {
 1396:          rampwafo = 1.0;
 1397:       }
 1398: 
 1399:       // For source/sinks
 1400:       if (if_source && dramp_ss > 0.0) {
 1401:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1402:       } else {
 1403:          ramp_ss = 1.0;
 1404:       }
 1405: 
 1406:       if (dramp > 0.0) {
 1407:          ramp = tanh(2.0*time/86400.0/dramp);
 1408:       } else {
 1409:          ramp = 1.0;
 1410:       }
 1411: 
 1412:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1413:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1414:    }
 1415:       
