 4489: extern "C" {
 4490: 
 4491:    __global__ void scaleGravity(double loadtide_coef) {
 4492: 
 4493: 
 4494:       NODE(node);
 4495: 
 4496:       // SAL option: scale gravity
 4497:       if constexpr(iloadtide==2) {  // simple const
 4498:          node->grav2 = grav*(1.0 - loadtide_coef);
 4499: 
 4500:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4501:         
 4502:           const double depth = max(node->depth, 0.0);
 4503:           const double tmp1 = sqrt(depth);
 4504:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4505:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4506:                              2.6969e-13*depth*depth*depth*tmp1;
 4507:           
 4508:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4509:           
 4510: 
 4511: 
 4512:           node->grav2 = grav*(1.0 - beta_bar);
 4513: 
 4514:       } else {  // iloadtide=0,1
 4515:         node->grav2=grav;
 4516: 
 4517:       }
 4518: 
 4519:    }
 4520: 
