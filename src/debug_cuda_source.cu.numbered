 3747: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3748:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3749:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3750:    // 
 3751:    // This kernel is called for all nodes.
 3752: 
 3753: 
 3754:    NODE(node1);
 3755: 
 3756: 
 3757:    node1->clearMatrixRow();
 3758:    node1->qel = 0.0;
 3759: 
 3760:    // THIS IS FOR STRUCTURES XXX
 3761:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3762: 
 3763:    
 3764:    for (int j=0; j<node1->numElements; j++) {
 3765:       // For each element connected to the node...
 3766: 
 3767:       Element *elem = node1->elements[j];
 3768: 
 3769:       // Compute the average gravity
 3770:       const double grav3 = elem->mean(&Node::grav2);
 3771: 
 3772:       // Look at the documentation for the description of the terms in the following integrals
 3773: 
 3774:       // Integral I_1 
 3775:       // \bar{\breve{H}} 
 3776:       const double hhatb = elem->mean(&Side::hhat);        
 3777: 
 3778:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3779: 
 3780:       const int id1 = elem->nodeLocalIdx(node1); 
 3781:       const double area = elem->area;
 3782: 
 3783:       if (elem->isTri()) {
 3784: 
 3785:          // To clarify the notation in this section: 
 3786:          //   i stands for the node under consideration (node1)
 3787:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3788:          const int id2 = elem->nxq(1 + id1);
 3789:          const int id3 = elem->nxq(2 + id1);
 3790:          Node *node2 = elem->nodes[id2];
 3791:          Node *node3 = elem->nodes[id3];
 3792: 
 3793:          const Point2 x1 = node1->p2();
 3794:          const Point2 x2 = node2->p2();
 3795:          const Point2 x3 = node3->p2();
 3796: 
 3797:          // integral of phi_i*phi_j
 3798:          const double ipp_ii = (1.0/6.0 )*area;
 3799:          const double ipp_ij = (1.0/12.0)*area;
 3800:          const double ipp_ik = (1.0/12.0)*area;
 3801: 
 3802:          // integral of [(grad phi_i) * (grad phi_j)]
 3803:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3804:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3805:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3806: 
 3807:          // Computes the different components of integral I_1 of each node with respect to node i.
 3808:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3809:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3810:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3811: 
 3812:          node1->addToSparseMatrix(node1, I1_ii);
 3813:          node1->addToSparseMatrix(node2, I1_ij); 
 3814:          node1->addToSparseMatrix(node3, I1_ik);
 3815: 
 3816:       }
 3817:       else { // Quad
 3818:          // XXX IMPLEMENT THIS
 3819:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3820: 
 3821:          // To clarify the notation in this section: 
 3822:          //   i stands for the node under consideration (node1)
 3823:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3824:          const int id2 = elem->nxq(1 + id1);
 3825:          const int id3 = elem->nxq(2 + id1);
 3826:          const int id4 = elem->nxq(3 + id1);
 3827:          Node *node2 = elem->nodes[id2];
 3828:          Node *node3 = elem->nodes[id3];
 3829:          Node *node4 = elem->nodes[id4];         
 3830: 
 3831:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3832:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3833:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3834:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3835:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3836: 
 3837:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3838:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3839:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3840:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3841:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3842: 
 3843:          // Computes the different components of integral I_1 of each node with respect to node i.
 3844:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3845:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3846:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3847:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3848: 
 3849:          node1->addToSparseMatrix(node1, I1_ii);
 3850:          node1->addToSparseMatrix(node2, I1_ij); 
 3851:          node1->addToSparseMatrix(node3, I1_ik);
 3852:          node1->addToSparseMatrix(node4, I1_il);
 3853:   
 3854: 
 3855: 
 3856:       
 3857:       } 
 3858: 
 3859:  
 3860:       // Integral I_4
 3861:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3862:       // Where
 3863:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3864: 
 3865:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3866:       // of U over the element.
 3867:       Vector2 Umean = {0.0, 0.0};
 3868:       for (int m=0; m<elem->i34; m++) {      
 3869:          const Side *side = elem->sides[m];
 3870: 
 3871:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3872:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3873:       }
 3874:       Umean = Umean/elem->i34;
 3875: 
 3876:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3877: 
 3878:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3879:       const double I_4_1 = dot(gradPhi_1, Umean);
 3880: 
 3881:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3882:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3883:      
 3884:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3885: 
 3886:       // Additional terms 
 3887:       double vnorm = 0.0;
 3888:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3889:          Vector3 ubed;
 3890:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3891: 
 3892:          Vector3 gradP = {0.0, 0.0, 1.0};
 3893:          for (int m=0; m < elem->i34; m++) {
 3894:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3895:            gradP += toVector3(gradP_2D, 0.0);
 3896:          }   
 3897:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3898:       } // imm==2
 3899: 
 3900:       if (elem->isTri()) {
 3901:          for (int l=0; l<3; l++) {
 3902:             double fac;
 3903: 
 3904:             Node *node = elem->nodes[l];
 3905: 
 3906:             fac = (node == node1) ? 2.0 : 1.0;
 3907:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3908:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3909: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3910:            
 3911:          }
 3912: 
 3913: 
 3914:          if (!elem->isDry) {
 3915:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3916: 
 3917:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3918: 
 3919:          }
 3920: 
 3921:       } // isTri
 3922:       else { // isQuad
 3923:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3924:          // for (int l=0; l<4; l++) {
 3925:          //   const Node *node = elem->nodes[l];
 3926: 
 3927:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3928:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3929: 
 3930:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3931:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3932:          // }
 3933: 
 3934:       } // isQuad
 3935: 
 3936: 
 3937:      node1->qel += (dt/elem->i34)*elem->vsource;
 3938:       
 3939: 
 3940:    } // for all elements connected to the node
 3941:    
 3942: 
 3943:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3944:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3945:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3946:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3947:       // If it is an open boundary node...
 3948: 
 3949:       // At least one open bnd side, maybe two
 3950:       for (int l=0; l<2; l++) { 
 3951: 
 3952:          // Gets each of the sides sharing the node. 
 3953:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3954: 
 3955:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3956: 
 3957:          
 3958: 
 3959:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3960:          if (sideBnd != nullptr) {
 3961:             // If the side is on a boundary...
 3962: 
 3963:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3964: 
 3965:             // Get the boundary segment
 3966:             const BoundarySegment *sideSegment = sideBnd->segment;
 3967:             const Side *side = sideBnd->side;
 3968: 
 3969:             // Integral I_3
 3970:             if (sideSegment->ifltype != 0) {
 3971:             // Natural or Flather b.c.
 3972: 
 3973:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3974:                // especially for Flather b.c.
 3975:                double ri3 = 0.0;
 3976:                if (!side->isDry) {
 3977:                   // If the side is not dry
 3978:                   
 3979:                   // Computes the side flux of (uth, vth)
 3980:                   double Vn = 0.0;
 3981:                   for (int k = side->kb; k<nvrt-1; k++) {
 3982:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3983:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3984: 
 3985:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3986:                   }
 3987: printf("side->idx = %d, side->len = %f, Vn = %f\n",  side->idx, side->len, Vn);
 3988:                   ri3 = 0.5*side->len*Vn;
 3989:                }
 3990: 
 3991:                if (sideSegment->ifltype == -1) { // Flather 1
 3992: 
 3993:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3994:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3995: 
 3996:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3997:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3998:                   
 3999:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4000:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4001: 
 4002:                } 
 4003:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4004:                   // Reset ri3
 4005:                   ri3 = 0.0;
 4006: 
 4007:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4008: 
 4009:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4010: 
 4011:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4012:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4013: 
 4014:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4015:                   node1->addToSparseMatrix(node1, con0*2.0);
 4016:                   node1->addToSparseMatrix(node2, con0);
 4017: 
 4018:                } // if Flather or Discharge
 4019: 
 4020: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 4021:                node1->qel -= thetai*dt*ri3;
 4022: 
 4023: 
 4024:             } // I_3
 4025:           
 4026: 
 4027:             // Integral I_5
 4028:             if(!side->isDry) {
 4029: 
 4030:                const double Unbar = dot(side->U, side->n);
 4031:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4032: 
 4033:             } // I_5
 4034: 
 4035:          } // if is boundary side
 4036: 
 4037:       } // for l
 4038: 
 4039:    } // if isbnd
 4040: 
 4041: 
 4042: }
 4043: 
 4044: 
 4045: 
 4046: extern "C" {
 4047:    __global__ void rollUpElevation(void) {
 4048: 
 4049:       NODE(node);
 4050: 
 4051:       node->eta1 = node->eta2;
 4052: 
 4053:    }
 4054: 
 4055: 
 4056:    __global__ void backtrackAllNodes(void) {
 4057: 
 4058:       // max/min # of sub-divisions
 4059:       const int ndelt_max = max(1.0, dt/dtb_min);
 4060:       const int ndelt_min = max(1.0, dt/dtb_max); 
 4061: 
 4062:       // Removed all references to swild98 XXX
 4063:       // swild98=0.d0 !init
 4064: 
 4065: 
 4066:       SIDE(side);
 4067: 
 4068:       const int kb = side->kb;
 4069: 
 4070: 
 4071:       // Initialize btrack velocities to the actual velocities at the side 
 4072:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4073: 
 4074:       if (side->isDry) return;
 4075: 
 4076: 
 4077:       // Checks that at least one element is not dry
 4078:       const Element *elem1 = side->elems[0];
 4079:       const Element *elem2 = side->elems[1];
 4080: 
 4081: 
 4082:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4083:       
 4084:       // XXXXXX
 4085:       // !swild_tmp to store global coord. of the starting side
 4086:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4087:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4088:       // !Use sframe2 
 4089:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4090: 
 4091: 
 4092:       for (int k = kb; k < nvrt; k++) {
 4093:       //  Initialize (xt,yt,zt), nnel and vel.
 4094:       //  For ics=2, the coordinates are in local frames
 4095:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4096: 
 4097: 
 4098:          const int iadvf = side->iadv();  // Advection flag
 4099: 
 4100:          Point3 xt;
 4101:          if constexpr(ics==1) {
 4102:             xt = side->center3D(k); 
 4103:          }
 4104:          else // lat/lon; in side lat/lon frame
 4105:          {
 4106:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4107:          // XXX IMPLEMENT THIS
 4108:       //          xt=0.d0
 4109:       //          yt=0.d0
 4110:       //          !centroid coord. for nudging
 4111:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4112:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4113:          }  // ics
 4114: 
 4115: 
 4116: 
 4117:          // If on land or open boundary...
 4118:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4119:          
 4120:          const double vmag = length(side->u2[k]);
 4121: 
 4122:          if (vmag <= velmin_btrack) {
 4123:             // No activity 
 4124: 
 4125:             side->btu[k] = side->u2[k];
 4126:             
 4127:          } else {  // do btrack
 4128: 
 4129:             // Compute number of sub-divisions based on local gradients 
 4130:             // XXX IS THIS NECESSARY?
 4131:             double suma = 0.0;
 4132:             int icount = 0;
 4133:             for (int ii=0; ii<2; ii++) {
 4134: 
 4135:                const Element *elem = side->elems[ii];
 4136:                  
 4137:                if (elem == nullptr) continue;
 4138: 
 4139:                icount++;
 4140: 
 4141:                // Not strictly along z; in ll frame for ics=2
 4142: 
 4143:                double utmp[4];
 4144:                double vtmp[4];
 4145:                for (int jj = 0; jj < elem->i34; jj++) {
 4146: 
 4147:                   const Node *node = elem->nodes[jj];
 4148: 
 4149:                   if constexpr(ics==1) {
 4150:                      utmp[jj] = node->u2[k].x;
 4151:                      vtmp[jj] = node->u2[k].y;  
 4152:                   } else {
 4153:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4154:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4155:                   }
 4156:                } // for jj
 4157: 
 4158:                const Vector2 grad_u = elem->grad2(utmp); 
 4159:                const Vector2 grad_v = elem->grad2(vtmp);
 4160: 
 4161:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4162:             } // for ii
 4163: 
 4164:             assert(icount > 0 && "Impossible 77");
 4165: 
 4166:             // '4' is somewhat arbitrary
 4167:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4168: 
 4169:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4170:          
 4171: 
 4172:             Vector3 u_int = {0.0, 0.0, 0.0};
 4173: 
 4174:             side->btrack(k, dt, dtbk, u_int);
 4175:             side->btu[k] = toVector2(u_int);
 4176:                
 4177:          } // if vmag (do backtrack)
 4178: 
 4179:       } // for k=kb,nvrt-1
 4180: 
 4181:    }
 4182: 
 4183: } // extern "C"
 4184: 
 4185: template<int nc>
 4186: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4187: 
 4188: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4189: //
 4190: // a,b,c,rhs: input vectors and are not modified by this program.
 4191: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4192: // rhs is the r.h.s.
 4193: // n: actual rank of the system.
 4194: // rows in u() and rhs();
 4195: // u: output with nc columns (transposed to rows)
 4196: // gam: a working array.
 4197: //
 4198: // NOTES:
 4199: // This is a template function that allows for different numbers of columns in the rhs vector.
 4200: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4201: 
 4202:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4203:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4204: 
 4205:    double bet = b[0];
 4206:    if constexpr (nc == 1) {
 4207:       u[0] = rhs[0]/bet;
 4208:    } else {
 4209:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4210:    }
 4211: 
 4212:    for (int j = 1; j < n; j++) {
 4213:       gam[j] = c[j - 1]/bet;
 4214:       bet = b[j] - a[j]*gam[j];
 4215: 
 4216:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4217: 
 4218:       if constexpr (nc == 1) {
 4219:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4220:       } else {
 4221:          for (int l = 0; l < nc; l++) {
 4222:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4223:          }
 4224:       }
 4225:    }
 4226: 
 4227:    // Back-substitution
 4228:    for (int j = n - 2; j >= 0; j--) {
 4229:       if constexpr (nc == 1) {
 4230:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4231:       } else {
 4232:          for (int l = 0; l < nc; l++) {
 4233:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4234:          }
 4235:       }
 4236:    }
 4237: }
 4238: 
 4239: 
 4240: 
 4241: // Helper function that contains the core algorithm
 4242: template<typename XAccessor, typename YAccessor>
 4243: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4244:                                     double  yp_top, double  yp_bot, 
 4245:                                     CubicSpline &spline) {
 4246:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4247:    // 
 4248:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4249:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4250:    //
 4251:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4252:    // 
 4253:    // Inputs: 
 4254:    //            n: dimension for x etc; # of data pts (>=2);
 4255:    //            getX, getY: functions to access x,y coordinates
 4256:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4257:    //     Output: 
 4258:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4259: 
 4260:    const int n = k2 - k1 + 1;
 4261:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4262: 
 4263:    // Allocate memory for the splines
 4264:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4265:    spline.x   = new double[n];
 4266:    spline.y   = new double[n];
 4267:    spline.yp  = new double[n];
 4268:    spline.ypp = new double[n];
 4269: 
 4270:    for (int k=k1; k<=k2; k++) {
 4271:       spline.x[k] = getX(k);
 4272:       spline.y[k] = getY(k);
 4273:    }
 4274: 
 4275:    // This is to simplify expressions later
 4276:    double *x = spline.x;
 4277:    double *y = spline.y;
 4278: 
 4279:    double *a = nullptr;
 4280:    double *b = nullptr;
 4281:    double *c = nullptr;
 4282:    double *gam = nullptr;
 4283:    double *rhs = nullptr;
 4284:    
 4285: 
 4286:       a = new double[n];   // Lower diagonal
 4287:       b = new double[n];   // Diagonal
 4288:       c = new double[n];   // Upper diagonal
 4289:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4290:       rhs = new double[n]; // Right-hand side
 4291: 
 4292:    for (int k=k1; k<=k2; k++) {
 4293:       if (k == k1) {
 4294:          // Bottom level
 4295:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4296:          b[k] = (x[k+1] - x[k])/3.0;
 4297:          c[k] = b[k]/2.0;
 4298:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4299:       } else if (k == n - 1) {
 4300:          // Top level (surface)
 4301:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4302:          b[k] = (x[k] - x[k-1])/3.0;
 4303:          a[k] = b[k]/2.0;
 4304:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4305:       } else {
 4306:          // Intermediate levels
 4307:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4308:          b[k] = (x[k+1] - x[k-1])/3.0;
 4309:          a[k] = (x[k  ] - x[k-1])/6.0;
 4310:          c[k] = (x[k+1] - x[k  ])/6.0;
 4311:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4312:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4313:       }
 4314:    }
 4315: 
 4316:    // Solve the tridiagonal system
 4317:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4318:    
 4319:    spline.yp[k1] = yp_bot;
 4320:    spline.yp[k2] = yp_top;
 4321: 
 4322:    // Compute rest of 1st derivatives using the splines
 4323:    for (int k=k1+1; k<k2; k++) {
 4324:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4325:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4326:    }
 4327:    
 4328:    delete[] a;
 4329:    delete[] b;
 4330:    delete[] c;
 4331:    delete[] gam;
 4332:    delete[] rhs;
 4333: 
 4334: }
 4335: 
 4336: // Array version
 4337: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4338:                                 double y_top, double y_bot, 
 4339:                                 CubicSpline &spline) {
 4340:    auto getX = [x] (int k) { return x[k]; };
 4341:    auto getY = [y] (int k) { return y[k]; };
 4342:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4343: }
 4344: 
 4345: // Lambda version - allows custom access patterns
 4346: template<typename XFunc, typename YFunc>
 4347: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4348:                                 double y_top, double y_bot,
 4349:                                 CubicSpline &spline) {
 4350:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4351: }
 4352: 
 4353: 
 4354: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4355: {
 4356:    assert("Not implemented");
 4357: 
 4358:    return 0.0;
 4359: }
