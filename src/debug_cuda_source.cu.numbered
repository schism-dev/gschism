  380: 
  381: 
  382: struct Frame {
  383:    double _t[9]; // t stands for tensor.
  384: 
  385:    // Access the tensor in Fortran order
  386:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  387: 
  388:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  389: 
  390:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  391: 
  392:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  393:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  394:       sincos(ar2, &sin_ar2, &cos_ar2);
  395: 
  396:       t(0,0) = -sin_ar1;
  397:       t(1,0) =  cos_ar1;
  398:       t(2,0) =  0.0;
  399:       t(0,1) = -cos_ar1*sin_ar2;
  400:       t(1,1) = -sin_ar1*sin_ar2;
  401: 
  402:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  403: 
  404:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  405:       assert (ar4!=0.0 && "GRID: ar4=0");
  406: 
  407:       const double ar4_inv = 1.0/ar4;
  408:       t(0,1) = t(0,1)*ar4_inv;
  409:       t(1,1) = t(1,1)*ar4_inv;
  410:       t(2,1) = t(2,1)*ar4_inv;
  411: 
  412:       // The third vector is the cross product of the first two
  413:       crossProduct(t(0,0), t(1,0), t(2,0), 
  414:                    t(0,1), t(1,1), t(2,1), 
  415:                    t(0,2), t(1,2), t(2,2));
  416:    }
  417: 
  418: 
  419:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  420:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  421:    // Inputs:
  422:    //        vec0: vel. in this frame;
  423:    //        frameout: Output frame;
  424:    // Output: 
  425:    //        vec1: vel. in new frame  
  426: 
  427:       auto const fo = frameout;
  428:       Vector2 vec1;
  429: 
  430:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  431:       // of t and fo.t are the same.
  432:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  433:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  434: 
  435:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  436:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  437: 
  438:       return vec1;
  439:    }
  440: 
  441:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  442:       // Transform a vector from global to local frame
  443:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  444:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  445:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  446:    }
  447: 
  448:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  449:       // Transform a vector from local to global frame
  450:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  451:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  452:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  453:    }   
  454: 
  455:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  456:    // Tranforms a point from global to local frame     
  457:       G2L(pi - origin0, po);
  458:    }
  459: 
  460:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  461:    // Transforms a point from local to global frame      
  462:       L2G(pi, po);
  463:       po = po + origin0;
  464:    }
  465: 
  466: };
