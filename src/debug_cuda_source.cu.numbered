 4377:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4378: 
 4379:       NODE_BND(nodeBnd);
 4380: 
 4381:       Node *node = nodeBnd->node;
 4382: 
 4383:       node->ETP = 0.0;
 4384: 
 4385:       for (int j=0; j<ntip; j++) {
 4386: 
 4387:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4388:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4389:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4390: 
 4391:          if constexpr(iloadtide==1) { // loading tide
 4392:             assert(false && "Loading tide not implemented");
 4393:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4394:          }
 4395:          
 4396:       }
 4397:       
 4398:    }
