 2374: 
 2375: __device__ void Node::updateKb(void) {
 2376: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2377: 
 2378:    if constexpr(ivcor == 1) return;
 2379: 
 2380: 
 2381:    // Check if node is wet
 2382:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2383: 
 2384:    if (isDry) return;
 2385: 
 2386:    if constexpr(ivcor == 2) {  // SZ coordinates
 2387:       
 2388:       // Compute bottom level index
 2389:       if (depth <= mesh->h_s) {
 2390:          kb = mesh->kz - 1;
 2391:       } else {
 2392:          kb = -1;
 2393:          int L = 0;
 2394:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2395:          
 2396:          while (L <= R) {
 2397:             int M = (R + L) / 2;
 2398: 
 2399:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2400:             
 2401:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2402:                R = M;
 2403:             } else {
 2404:                L = M;
 2405:             }
 2406: 
 2407:             if (R - L == 1) {
 2408:                kb = L;
 2409:                break;
 2410:             }
 2411:          }
 2412:       }
 2413:    } 
 2414: }
 2415: 
 2416: 
 2417: __device__ double Node::compZCoord(int k) const {
 2418:    // Computes the z coordinate at level k.
 2419:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2420:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2421:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2422:    // used 
 2423:    
 2424:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2425:       
 2426:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2427: 
 2428:    if constexpr(ivcor == 2) {
 2429: 
 2430:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2431:       const int kz = mesh->kz;
 2432:       const double h_c = mesh->h_c;
 2433:       const double theta_f = mesh->theta_f;
 2434:       const double sinh_theta_f = mesh->sinh_theta_f;
 2435: 
 2436:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2437:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2438:       // once per time step/node.
 2439:       // CHECK: updateZCoordData
 2440: 
 2441: printf("$$$$$ (k == nvrt-1) =k = %d, kz = %d, nvrt = %d, kb = %d, hc = %f, hmod2 = %f, eta2 = %f, depth = %f\n", k, kz, nvrt, kb, h_c, hmod2, eta2, depth);
 2442:       if      (k == nvrt-1)      {printf("$$$$$ (k == nvrt-1) = %f\n", eta2); return eta2; }
 2443:       else if (k == kz)          return -hmod2;
 2444:       else if (k == kb)          return -depth;
 2445:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2446:       else if (k > kz) {
 2447:          const int ksig = k - kz + 1;
 2448: 
 2449:          if (hmod2 <= h_c) {
 2450:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2451:          } 
 2452:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2453:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2454:             assert(false && "ZCOOR: invalid h_c\n");
 2455:          } 
 2456:          else {
 2457:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2458:                          h_c * mesh->sigma[ksig] + 
 2459:                          (hmod2 - h_c) * mesh->cs[ksig];
 2460:          }
 2461:       } else { 
 2462:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2463:       }
 2464: 
 2465:    }
 2466:    else if constexpr(ivcor == 1) {
 2467:       if (k == kb) return -depth;
 2468:       else if (k == nvrt-1) return eta2;
 2469:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2470:    }
 2471:    
 2472:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2473:    return 0.0;
 2474: }
 2475: 
 2476: 
 2477: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2478:                 double *node_coords, double *wind_rotate_angle, 
 2479:                 int *isdel, int *isidenode, int *isbnd,
 2480:                 int *nond, int *nlnd, int *iond, int *ilnd,
 2481:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2482:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2483:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2484:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2485:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2486:                 double *emo, double *efa, 
 2487:                 double *umo, double *ufa, 
 2488:                 double *vmo, double *vfa) {
 2489: 
 2490:    printf("Populating mesh for partition %d\n", partNum);
 2491: 
 2492:    // Horizontal grid
 2493:    printf("Processing %d nodes\n", np);    
 2494: 
 2495: 
 2496:    int idxNodeBoundary = 0;  
 2497:    for (int i = 0; i < np; i++)
 2498:    {
 2499:       Node &node = localNodeData[i];
 2500: 
 2501:       node.idx = i;
 2502: 
 2503:       const int idxNodeStart = nodeNeighNodesStart[i];
 2504:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2505:       node.numNodes = idxNodeEnd - idxNodeStart;
 2506:       node.nodes = nodeNeighNodes + idxNodeStart;
 2507:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2508: 
 2509: 
 2510: 
 2511:       const int idxElemStart = nodeNeighElemsStart[i];
 2512:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2513:       node.numElements = idxElemEnd - idxElemStart;
 2514:       node.elements = nodeNeighElems + idxElemStart;
 2515: 
 2516: 
 2517:       
 2518:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2519:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2520:          const int partNode = localNodePart[idxNodeGlobal]; 
 2521:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2522: 
 2523: 
 2524:          Node *node_ptr = nodes[partNode] + idxNode;
 2525:          
 2526:          nodeNeighNodes[idx] = node_ptr;
 2527:       }
 2528: 
 2529:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2530:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2531:          const int partElem = localElemPart[idxElemGlobal];
 2532:          const int idxElem  = localElemIndices[idxElemGlobal];
 2533: 
 2534:          Element *elem_ptr = elems[partElem] + idxElem;
 2535: 
 2536:          nodeNeighElems[idx] = elem_ptr;
 2537:       }      
 2538: 
 2539: 
 2540:       node.wind_angle = wind_rotate_angle[i];
 2541: 
 2542:       // Element **elements; // pointer to the elements connected to this node
 2543:       // int numElements;   // number of elements shared by this node
 2544: 
 2545:       node.p.x   = node_coords[i * 3];
 2546:       node.p.y   = node_coords[i * 3 + 1];
 2547:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2548:       node.depth = node_coords[i * 3 + 2];
 2549: 
 2550: 
 2551: 
 2552:       // Links the node to the boundary information
 2553:       if (isbnd[i] >= 0) {
 2554:        
 2555:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2556:          node.nodeBnd->node = &node;
 2557: 
 2558:          if (isbnd[i]>0) {
 2559: 
 2560:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2561:             node.nodeBnd->segment->ifltype = isbnd[i];
 2562: 
 2563:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2564:             node.nodeBnd->segment->clen  = nan("1");
 2565:             node.nodeBnd->segment->carea = nan("1");
 2566: 
 2567:          }
 2568:          else {
 2569:             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2570:          }
 2571:          
 2572:          idxNodeBoundary++;
 2573:       }
 2574:       else {
 2575:          node.nodeBnd = nullptr;
 2576:       }
 2577: 
 2578: // XXXX
 2579: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2580: constexpr double rot_per = 3000.0;
 2581: constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2582: for (int k = 0; k < nvrt; k++) {node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0};}
 2583: // XXXXX
 2584:    }
 2585: 
 2586:    nbp = idxNodeBoundary;
 2587: 
 2588:    printf("Processing %d sides\n", ns);
 2589:    int idxSideBoundary = 0;
 2590:    for (int i = 0; i < ns; i++)
 2591:    {
 2592:       Side &side = localSideData[i];
 2593:       side.idx = i;
 2594:       // finding the pointer to the nodes that form the side
 2595:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2596:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2597: 
 2598:       const int locidx_n1 = localNodeIndices[idx_n1];
 2599:       const int locidx_n2 = localNodeIndices[idx_n2];
 2600:       const int part_n1 =   localNodePart[idx_n1];
 2601:       const int part_n2 =   localNodePart[idx_n2];
 2602: 
 2603:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2604:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2605: 
 2606:       // Normal vector to the side
 2607:       side.n = {- (side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2608:       const double norm = sqrt(dot(side.n, side.n));
 2609:       side.n = side.n/norm;
 2610: 
 2611:       // Side boundary type
 2612:       const NodeBoundary *n1bnd = side.n1->nodeBnd;
 2613:       const NodeBoundary *n2bnd = side.n2->nodeBnd;
 2614:       // XXXX NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2615:       
 2616:       if (n1bnd != nullptr || n2bnd != nullptr) 
 2617:       {
 2618:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2619:          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2620:          else                  side.sideBnd->segment = n2bnd->segment;
 2621:          side.sideBnd->side = &side;
 2622:          idxSideBoundary++;
 2623:       }
 2624:       else side.sideBnd = nullptr;
 2625: 
 2626:       nbs = idxSideBoundary;
 2627: 
 2628:       // finding the pointer to the elements that share the side
 2629:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2630:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2631: 
 2632:       if (idx_e1 > -1) {
 2633:          const int locidx_e1 = localElemIndices[idx_e1];
 2634:          const int part_e1 =  localElemPart[idx_e1];
 2635:          side.elems[0] = elems[part_e1] + locidx_e1;
 2636:          // printf("s@@ part_e1 = %d, locidx_e1 = %d, elems[part_e1] = %p\n", part_e1, locidx_e1, elems[part_e1]);
 2637:          // // printf("s-- side.elems[0] = %p idx = %d i34 = %d (x,y,z) = (%f,%f,%f) size = %d\n", side.elems[0], side.elems[0]->idx, side.elems[0]->i34, side.elems[0]->center.x, side.elems[0]->center.y, side.elems[0]->center.z, sizeof(Element));
 2638:          // printf("o-- elems = %p, *elems = %p, localElemData = %p, *localElemData = %p\n", elems, *elems, localElemData, *localElemData);
 2639:       }
 2640:       else {
 2641:          side.elems[0] = nullptr;
 2642:       }
 2643: 
 2644:       if (idx_e2 > -1) {
 2645:          const int locidx_e2 = localElemIndices[idx_e2];
 2646:          const int part_e2 =  localElemPart[idx_e2];
 2647:          side.elems[1] = elems[part_e2] + locidx_e2;
 2648:       }
 2649:       else {
 2650:          side.elems[1] = nullptr;
 2651:       }
 2652: 
 2653: 
 2654: 
 2655:       // Compute the center of the side
 2656:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2657: 
 2658: // XXXX
 2659: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2660: constexpr double rot_per=3000.0;
 2661: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2662: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2663: // XXXXX      
 2664: 
 2665:       // Compute the z level at the center of the side
 2666:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2667: 
 2668:       // Compute the length of the side
 2669:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2670:       side.length = sqrt(dot(vLen, vLen));
 2671: 
 2672:    }
 2673: 
 2674:    printf("Processing %d elements\n", ne);
 2675:    for (int i = 0; i < ne; i++)
 2676:    {
 2677:       Element &elem = localElemData[i];
 2678:       elem.idx = i;
 2679:       for (int j = 0; j < i34[i]; j++) {
 2680:          const int idxNode = elnode[i*4 + j];  
 2681:          const int idxSide = elside[i*4 + j];
 2682:          
 2683:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2684:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2685: 
 2686: 
 2687: 
 2688:          // Find the neighboring element  
 2689:          if (elem.sides[j]->elems[0] == &elem) {
 2690:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2691:          }
 2692:          else {
 2693:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2694:          }
 2695:          
 2696:       }
 2697: 
 2698:       elem.i34 = i34[i];
 2699: 
 2700: // printf("elem = %p, elem.i34 = %d\n", &elem, elem.i34);
 2701: 
 2702:       // Compute the centroid of the element and its depth
 2703:       Vector2 center = {0.0, 0.0};
 2704:       elem.depth = 0.0;
 2705:       for (int j = 0; j < i34[i]; j++) {
 2706:          center += elem.nodes[j]->p2()/i34[i];
 2707:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2708:       }
 2709:       elem.center.x = center.x;
 2710:       elem.center.y = center.y;
 2711: 
 2712:       // printf("elem = %p, i34 = %d, center = (%f,%f,%f)\n", &elem, elem.i34, elem.center.x, elem.center.y, elem.depth);
 2713:       
 2714:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2715:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2716: 
 2717:       elem.area = elem.computeSignedArea(); 
 2718:       elem.radius = sqrt(elem.area)/pi; 
 2719:       
 2720:       // Determines which way the normal vector to each side is oriented.
 2721:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 2722:       for (int j = 0; j < i34[i]; j++)  
 2723:       {
 2724:          if (elem.sides[j]->elems[0] == &elem) {
 2725:             elem.ssign[j] =  1.0;
 2726:          }
 2727:          else {
 2728:             elem.ssign[j] = -1.0;
 2729:          }
 2730: 
 2731:       }
 2732: 
 2733:       // Derivatives of shape functions
 2734:       //  For ics=2, this is done inside element/ll frame XXX
 2735:       //  For quads, the derivative is evaluated at centroid
 2736:       const int i34 = elem.i34;
 2737:       for (int j = 0; j < i34; j++) {
 2738:          const double area = elem.area;
 2739:          const int id2 = elem.nxq(1 + j);
 2740:          const int id3 = elem.nxq(2 + j);
 2741:          const int id4 = elem.nxq(3 + j);
 2742:          if (elem.isTri()) {
 2743:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 2744:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 2745:             // da1/dx = (y1 - y2)/(2*area)
 2746:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 2747:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2748:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2749:          }
 2750:          else  { // Quad; evaluate at centroid
 2751:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 2752:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 2753:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 2754:          } // if Tri
 2755: 
 2756:       } // for j
 2757: 
 2758:    }
 2759: 
 2760: 
 2761:    // Processing the boundary nodes
 2762:    int idx = 0;
 2763:    for (int iseg = 0; iseg < nope; iseg++) {
 2764:       for (int ilnd = 0; ilnd < nlnd[iseg]; ilnd++) {
 2765: 
 2766:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 2767: 
 2768:          nodeBnd->isEssentialBC = true;
 2769: nodeBnd->iettype = 3;
 2770:          nodeBnd->elbc = 0.0;
 2771: 
 2772:          for (int jfr = 0; jfr < nbfr; jfr++) {
 2773:             nodeBnd->efa[jfr] = efa[jfr + iseg*nbfr];
 2774:             nodeBnd->emo[jfr] = emo[jfr + iseg*nbfr];
 2775:             nodeBnd->umo[jfr] = umo[jfr + iseg*nbfr];
 2776:             nodeBnd->ufa[jfr] = ufa[jfr + iseg*nbfr];
 2777:             nodeBnd->vmo[jfr] = vmo[jfr + iseg*nbfr];
 2778:             nodeBnd->vfa[jfr] = vfa[jfr + iseg*nbfr];
 2779: printf("nodeBnd->efa[%d] = %f, nodeBnd->emo[%d] = %f, nodeBnd->umo[%d] = %f, nodeBnd->ufa[%d] = %f, nodeBnd->vmo[%d] = %f, nodeBnd->vfa[%d] = %f\n", jfr, nodeBnd->efa[jfr], jfr, nodeBnd->emo[jfr], jfr, nodeBnd->umo[jfr], jfr, nodeBnd->ufa[jfr], jfr, nodeBnd->vmo[jfr], jfr, nodeBnd->vfa[jfr]);
 2780:          }
 2781: 
 2782:          idx++;
 2783:       }
 2784: 
 2785:    }
 2786: 
 2787: }
 2788: 
