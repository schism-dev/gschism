 6831: #ifdef DONTCOMPILE
 6832: __device__ void computeVerticalAdvection(void) {
 6833:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6834: 
 6835:    sdbt(1:2,:,:)=0.d0
 6836: 
 6837:    const Side *side = FROM kernel;
 6838: 
 6839:    if(side->isDry) return;
 6840: 
 6841:    // If side is wet...
 6842: 
 6843: 
 6844:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6845:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6846:    double ws[nvrt] = {} // w @ side
 6847:    int icount = 0;
 6848:    for (int j=0; j<2; j++) {
 6849:       const Element *elem = side->elements[j];
 6850:        
 6851:       if(elem != nullptr) {
 6852:          icount++;
 6853:          for (int k=0; k<nvrt; k++) {
 6854:             ws[k] = ws[k] + elem->w[k];
 6855:          }
 6856:       }
 6857:    }  // for j
 6858: 
 6859:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6860:    ws = ws/icount;
 6861: 
 6862:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6863:    // Splines allow for a smooth transition between vertical levels.
 6864:    // Splines have continuity restrictions at the internal knots, but
 6865:    // we have to provide the 1st derivatives at the endpoints.
 6866:    const int kbs = side->kbs; 
 6867:    
 6868:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6869:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6870:    initCubicSpline(kbs, nvrt, side, ws, up)
 6871: 
 6872:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6873:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6874:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6875: 
 6876:    // Total advection (average onto side)
 6877:    const Node *node1 = side->nodes[0];
 6878:    const Node *node2 = side->nodes[1];
 6879:    for (int k=kbs(i); k<nvrt; k++) {
 6880: 
 6881:       if constexpr(ics==1) {
 6882:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6883:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6884:       } else {
 6885:          // XXX IMPLEMENT THIS
 6886:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6887:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6888:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6889:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6890:       }  // if ics
 6891: 
 6892: 
 6893:    }
 6894: }
 6895: #endif
 6896: 
 6897: 
 6898: extern "C" {
 6899:    __global__ void computeElemAverageGhat(void) {
 6900:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6901: 
 6902:       ELEM(elem);
 6903:       
 6904:       elem->ghat1= {0.0, 0.0};  
 6905: 
 6906:       if constexpr(ihydraulics != 0) {
 6907:          if (nhtblocks > 0 && elem->isblock) return;
 6908:       }
 6909: 
 6910:       if (elem->isDry) return;
 6911: 
 6912:       // Wet elements.
 6913:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6914:       // tidal potential, horizontal diffusion, and baroclinic etc
 6915:       // Remember to update both fb and F 
 6916:       // If ics=2, ghat1 are in eframe (ll)
 6917:       // cff1-3: coefficients for 2D/3D
 6918:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6919:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6920:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6921: 
 6922:       double av_cff1 = 0.0;  // av. for cff1
 6923:       double av_cff2 = 0.0;  // av. for cff2
 6924:       double av_cff3 = 0.0;  // av. for cff3
 6925:       double av_df = 0.0;  // av. for H^\alpha / H
 6926:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6927:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6928: 
 6929:       const int i34 = elem->i34;
 6930:       const int kb = elem->kb;
 6931: 
 6932:       for (int j=0; j<i34; j++) {
 6933:          // For each node and side in the element...
 6934: 
 6935:          const Node *node = elem->nodes[j];
 6936:          const Side *side = elem->sides[j];
 6937: 
 6938:          const double chi      = side->chi;
 6939:          const double veg_c2   = side->veg_c2;
 6940:          const double veg_beta = side->veg_beta;
 6941:          const double veg_h    = side->veg_h();
 6942:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6943: 
 6944:          // Node - const in elem
 6945:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6946:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6947: 
 6948:          if (elem->depth >= tip_dp) {
 6949:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6950:          }
 6951: 
 6952:          
 6953:          const double htot  = side->htot2();        // Total depth at the side
 6954:          const double zctr2 = side->zTopCanopy();  
 6955: 
 6956:          double cff1; 
 6957:          double cff2; 
 6958:          double cff3;   
 6959:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6960:          // coefficients applied to 2D/3D case 
 6961:             cff1 = side->hhat/htot;
 6962:             cff2 = 0.0;
 6963:             cff3 = 0.0;
 6964:          } else { //3D
 6965:             //Init for no-veg case
 6966:             cff1 = 1.0;
 6967:             cff2 = 1.0;
 6968:             cff3 = 0.0;
 6969: 
 6970:             if constexpr(iveg != 0) {
 6971:                // Computes coefficients used with vegetation terms G1, G2
 6972:                // cff1, cff3 are used for the first two terms in G1, G2:
 6973:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6974:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6975:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6976:                if(veg_h < 0.99*htot) { // submergent vegetation
 6977:                   cff1=1;
 6978:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6979:                   cff3 = veg_c;
 6980: 
 6981:                } else { // emergent vegetation
 6982:                   cff1 = 1.0/(1.0 + veg_c2);
 6983:                   cff2 = cff1;
 6984:                   cff3 = 0.0;
 6985: 
 6986:                }
 6987:             } // if iveg
 6988:          } //  2D/3D
 6989: 
 6990:          av_cff1 += cff1/i34;
 6991:          av_cff2 += cff2/i34;
 6992:          av_cff3 += cff3/i34;
 6993:          av_cff2_chi += cff2*chi/i34;
 6994:          av_cff3_chi += cff3*chi/i34;
 6995:          av_df += min(htot, veg_h)/(htot*i34);
 6996: 
 6997: 
 6998:          // btrack values: U^\star, U^{\star\alpha}
 6999:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7000:          Vector2 Ustar       = {0.0, 0.0}; 
 7001:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7002: 
 7003:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7004:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7005:          } else { //3D
 7006:             for (int k = side->kb; k < nvrt; k++) {
 7007:             
 7008:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7009:                Ustar += w2;
 7010: 
 7011:                if constexpr(iveg != 0) {
 7012:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7013:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7014:                        Ustar_alpha += zrat*w2; // XXXX
 7015:                    }
 7016:                }  // if iveg
 7017:             }  // for k
 7018:          }  //2D/3D
 7019:          
 7020: 
 7021:          // Add btrack & surface stress terms to \breve{G} first
 7022:          if constexpr(ics==1) {
 7023: 
 7024:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7025: 
 7026:          } else {
 7027:             // XXX IMPLEMENT THIS
 7028:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7029:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7030:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7031:          }  // if ics
 7032: 
 7033:          // Surface and bottom stress terms
 7034:          if constexpr(ics==1) {
 7035:             const Vector2 tau    = side->tau();
 7036:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7037: 
 7038:             // Term for surface and bottom stress
 7039:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7040: 
 7041:          } else {
 7042:             assert(false && "computeElemAverageGhat: Not implemented");
 7043:             // XXX IMPLEMENT THIS
 7044:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7045:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7046:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7047:             // tau_x=(vn1+tt1)/2.d0
 7048:             // tau_y=(vn2+ss1)/2.d0
 7049:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7050:          }  // if ics
 7051: 
 7052:          
 7053: 
 7054:          // All terms in F,F^\alpha,f_b except baroclinic
 7055:          // F, f_b: all explicit terms excluding vegetation 
 7056:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7057:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7058:          const double coriolis = side->coriolis;
 7059:          Vector2 F  =  coriolis*side->U;  // F_x
 7060:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7061:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7062: 
 7063:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7064:             
 7065:             for (int k = side->kb; k < nvrt; k++) {
 7066:                if (zctr2 > side->zc[k-1]) {
 7067:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7068:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7069:                    Fa +=  coriolis*w2*zrat;
 7070:                } // if zctr2
 7071:             } // k
 7072:          } // iveg
 7073: 
 7074:          // Integrate horizontal viscosity force vertically
 7075:          for (int k=side->kb + 1; k<nvrt; k++) {
 7076:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7077: 
 7078:             F += levelHorVisc;
 7079: 
 7080:             // Vegetation term
 7081:             if constexpr(iveg!=0) {
 7082:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7083:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7084:                   Fa += levelHorVisc*zrat;
 7085:                } 
 7086:             } // if iveg
 7087:          } // for k
 7088: 
 7089:          fb += side->nuGradU[side->kb];
 7090: 
 7091:          // Add to ghat1
 7092:          if constexpr(ics==2) {
 7093:             // XXX IMPLEMENT THIS
 7094:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7095:             // bigf1=vn1; bigf2=vn2
 7096:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7097:             // botf1=vn1; botf2=vn2
 7098:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7099:             // bigfa1=vn1; bigfa2=vn2
 7100:          } // if ics
 7101: 
 7102:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7103:       } // for j (nodes and sides)
 7104: 
 7105:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7106:          
 7107:       // Finish off terms in F, F^\alpha and f_b
 7108:       const double grav3 = elem->mean(&Node::grav2);
 7109:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7110: 
 7111: 
 7112:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7113:       for (int j=1; j<i34; j++) { 
 7114:          // For each side in the element...
 7115:          const Side *side = elem->sides[j];
 7116:          const double chi = side->chi;
 7117: 
 7118:          const double htot = side->htot2();
 7119:          const double veg_h = side->veg_h();
 7120:          const Vector2 F  = htot*fb;
 7121:          const Vector2 Fa = min(htot, veg_h)*fb;
 7122: 
 7123:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7124:       } // for j
 7125: 
 7126:       //botf1 etc are already in elem frame
 7127:       elem->ghat1 += tmp/i34;
 7128: 
 7129:       // Baroclinic force
 7130:       if constexpr(ibc==0) {
 7131:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7132: 
 7133:          Vector2 Fa = {0.0, 0.0};
 7134:          Vector2 intGradRho = {0.0, 0.0};
 7135:          
 7136:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7137:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7138:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7139: 
 7140:             // \in F [m^2/s/s]
 7141:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7142:          }
 7143: 
 7144:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7145:          const Vector2 F = av_df*Fa; //approx
 7146:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7147: 
 7148:       } // if ibc
 7149: 
 7150: 
 7151: 
 7152:    }
 7153: 
 7154: } // extern "C"
 7155: 
 7156: 
 7157: 
 7158: #ifdef DONTCOMPILE
 7159: __global__ void checkMassConservation(Tracers* sumtr) {
 7160: 
 7161:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7162: 
 7163:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7164: 
 7165:    Element *elem = &(mesh->localElemData[i]);
 7166: 
 7167:    // Skip dry elements
 7168:    if (elem->isDry) return;
 7169: 
 7170:    // Local sum array for this thread
 7171:    double localSum[N_TRACERS] = {0.0};
 7172: 
 7173:    // Sum over vertical levels for this element
 7174:    const int kbe = elem->kbe;
 7175:    const double area = elem->area;
 7176: 
 7177:    for (int k = kbe; k < nvrt; k++) {
 7178:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7179:       
 7180:       // Accumulate tracer mass
 7181:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7182:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7183:       }
 7184:    }
 7185: 
 7186:    //  This function returns per element sums. A reduction must be done on the host side.
 7187: }
 7188: 
 7189: 
 7190: __global__ void transport(void) {
 7191: 
 7192:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7193: 
 7194:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7195: 
 7196:    Element *elem = &(mesh->localElemData[ie]);
 7197: 
 7198:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7199: 
 7200:                for (int m=0; m<ntr; m++) {
 7201:                   for (int k=kbe(ie); k<nvrt; k++) {
 7202:                      // Calculate each polynomial's weight 
 7203:                      wm=0.d0; sum1=0.d0; 
 7204:                      wm1=0.d0; wm2=0.d0; 
 7205:                      for (int i=0; i<elem->nweno2; i++) {
 7206:                   
 7207:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7208:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7209:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7210:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7211:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7212:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7213:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7214:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7215:                      // -----------------Hu and Shu (1999)'s method----------------
 7216:                      b4=b1+b2+b3
 7217: 
 7218: //Error: add PRODUCTION CPP
 7219: #ifdef DEBUG
 7220:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7221:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7222:                     call parallel_abort(errmsg)
 7223:                   }
 7224: #endif
 7225: 
 7226:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7227:                   // !----test-------------- 
 7228:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7229:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7230:                   // !wm(i)=wm1(i)*wm2(i)
 7231:                   // !---------------------- 
 7232:                   sum1=sum1+wm(i)
 7233:                 } // end for i
 7234: 
 7235:                 wm=wm/sum1
 7236: 
 7237:                 for (int j=0; j<elem->i34; j++) {
 7238: 
 7239:                   const Side *side  = elem->sides[j];
 7240:                   const Node *node1 = side->n1;
 7241:                   const Node *node2 = side->n2;
 7242: 
 7243:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7244:                      trsd=0.d0
 7245:                      for (int kk=0; kk<nquad; kk++) {
 7246:                         for (int i=0; i<elem->nweno2; i++) {
 7247:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7248:                         } // end for i   
 7249:                      } // end for kk
 7250:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7251:                   } // outward flux
 7252:                } // end for j=1,i34(ie) ! side
 7253:             }
 7254:          }
 7255:               
 7256: 
 7257: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7258: //             //   calculate each polynomial's weight 
 7259: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7260: //                 wm=0.d0; sum1=0.d0
 7261: //                 do i=1,nweno1(ie) !for each polynomial
 7262: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7263: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7264: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7265: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7266: //                   wm(i)=b2
 7267: //                   sum1=sum1+b2
 7268: //                   !wm(i)=1.d0
 7269: //                   !sum1=sum1+1.d0
 7270: 
 7271: // // Error: PRODUCTION
 7272: // #ifdef DEBUG
 7273: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7274: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7275: //                     call parallel_abort(errmsg)
 7276: //                   endif
 7277: // #endif
 7278: 
 7279: //                 enddo !i
 7280: //                 wm=wm/sum1 !final weight
 7281: 
 7282:                 for (int j=0; j<elem->i34; j++) { // side
 7283:                   const Side *side = elem->sides[j];
 7284:                   const Node *node1 = side->n1;
 7285:                   const Node *node2 = side->n2;
 7286: 
 7287:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7288:                     trsd=0.d0
 7289:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7290:                       for (int i=0; i<elem->nweno1; i++) {
 7291:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7292:                       }
 7293:                     enddo //kk
 7294:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7295:                   } // outward flux
 7296:                 } // end for j=1,i34(ie) ! side
 7297:               } // end for k; ntr 
 7298: 
 7299:             else !simple upwind method
 7300:               do j=1,i34(ie)
 7301:                 jsj=elside(j,ie)
 7302:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7303:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7304:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7305:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7306:                   endif
 7307:                 enddo  !vertical layers
 7308:               enddo !j=1,i34(ie) ! side
 7309:             endif !order of accuracy
 7310: 
 7311:          //  enddo !ie
 7312: // !$OMP     end do
 7313: 
 7314: // !$OMP     master
 7315: //           !message passing
 7316: //           if (nproc>1) then
 7317: //             !make a copy of side concentrations
 7318: //             trsd_tmp0=trsd_tmp 
 7319: 
 7320: //             !this exchange routine swaps interface concentration between two partitions
 7321: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
