 1610:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1611:       // Compute the different time ramps used in the code 
 1612:       // This function is performed by just one thread
 1613: 
 1614:       rampbc = 1.0;
 1615:       if constexpr(ibc == 0) {
 1616:          if (drampbc > 0.0) {
 1617:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1618:          } else {
 1619:             rampbc = 1.0;
 1620:          }
 1621:       }
 1622: 
 1623:       if (nws != 0) {
 1624:          if (drampwind > 0.0) {
 1625:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1626:          } else {
 1627:             rampwind = 1.0;
 1628:          }
 1629:       }
 1630: 
 1631:       if (drampwafo > 0.0) {
 1632:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1633:       } else {
 1634:          rampwafo = 1.0;
 1635:       }
 1636: 
 1637:       // For source/sinks
 1638:       if (if_source && dramp_ss > 0.0) {
 1639:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1640:       } else {
 1641:          ramp_ss = 1.0;
 1642:       }
 1643: 
 1644:       if (dramp > 0.0) {
 1645:          ramp = tanh(2.0*time/86400.0/dramp);
 1646:       } else {
 1647:          ramp = 1.0;
 1648:       }
 1649: 
 1650: 
 1651:    }
