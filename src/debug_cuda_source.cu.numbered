 7758: 
 7759: __global__ void computeMatrixProductAndDotProducts() {
 7760:    // Computes A*p, r'Mr and p'Ap
 7761: 
 7762:    // 1) shared buffer: first half for rMr, second for pAp
 7763:    __shared__ double sdata[2*BLOCK_SIZE];
 7764:    double* s_rMr = sdata;
 7765:    double* s_pAp = sdata + BLOCK_SIZE;
 7766: 
 7767:    const int tid = threadIdx.x;
 7768: 
 7769:    double l_pAp = 0.0;
 7770: 
 7771:    s_rMr[tid] = 0.0;
 7772:    s_pAp[tid] = 0.0;
 7773: 
 7774:    // 2) get your node pointer
 7775:    // NODE(node);   
 7776:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7777:    Node *node = &(mesh->localNodeData[idx_node]); 
 7778:       if (idx_node < mesh->np) {
 7779: 
 7780:       const double diag = node->coeffDiag;
 7781:       const double r    = node->mR;
 7782:       const double p    = node->mP;  
 7783: 
 7784:       // apply preconditioner on the fly:
 7785:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7786: 
 7787:       // 4) compute Ap = A.p
 7788:       double Ap = node->coeffDiag * node->mP;
 7789:       for (int j = 0; j < node->numNodes; ++j) {
 7790:          const Node *nbNode = node->nodes[j];
 7791:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7792: 
 7793:       }
 7794: 
 7795:       node->mAp = Ap;
 7796:       
 7797: 
 7798:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7799:       // const double l_rMr = r*Mr;  // r'Mr
 7800:       l_pAp = p*Ap;  // p'Ap
 7801: 
 7802: 
 7803:    }
 7804: 
 7805:    // 6) write into shared mem
 7806:    // s_rMr[tid] = l_rMr;
 7807:    s_pAp[tid] = l_pAp;
 7808: 
 7809:    __syncthreads();
 7810: 
 7811:    // 7) block-wide tree reduction
 7812:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7813:       if (tid < stride)  {
 7814:          s_pAp[tid] += s_pAp[tid + stride];
 7815:       }
 7816:       __syncthreads();
 7817:    }
 7818: 
 7819:    // 8) thread 0 atomically accumulates into the globals
 7820:    // XXX: This is slower than it needs to be, but it is simple and works
 7821:    if (tid == 0) {
 7822:       atomicAdd(pAp, s_pAp[0]);
 7823:    }
 7824: 
 7825: 
 7826: }
 7827: 
 7828: 
 7829: __global__ void updateSolutionAndDotProducts(void) {
 7830:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7831: 
 7832:    const int tid = threadIdx.x;
 7833: 
 7834:    s_rMr[tid] = 0.0;
 7835: 
 7836:    // get node & bounds-check:
 7837:    NODE(node);
 7838: 
 7839:    
 7840:    // Compute alpha
 7841:    const double alpha = (*rMr_old)/(*pAp); 
 7842: 
 7843: 
 7844:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7845: 
 7846: 
 7847:    // load scalars
 7848:    const double diag = node->coeffDiag;
 7849:    const double p    = node->mP;
 7850:    const double Ap   = node->mAp;
 7851:    const double x    = node->mX;
 7852:    const double r    = node->mR;
 7853:    
 7854:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7855: 
 7856:    // 1) update solution & residual
 7857:    const double x_new = x + alpha*p;
 7858:    const double r_new = r - alpha*Ap;
 7859:    node->mX = x_new;
 7860:    node->mR = r_new;
 7861: 
 7862:    // 2) apply Jacobi preconditioner on the fly
 7863:    const double Mr_new = r_new/diag;
 7864: 
 7865: 
 7866:    // 3) local contributions for the two dot-products
 7867:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7868: 
 7869:    // 4) write into shared-mem
 7870:    s_rMr[tid] = l_rMr;
 7871: 
 7872:    __syncthreads();
 7873: 
 7874: 
 7875:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7876:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7877:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7878:       __syncthreads();
 7879:    }
 7880: 
 7881:    // 6) thread 0 atomically folds into the global accumulators
 7882:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7883: 
 7884: 
 7885: }
 7886: 
 7887: 
 7888: __global__ void updateSearchDirection() {
 7889: 
 7890:     NODE(node);
 7891: 
 7892:     // recompute z on-the-fly
 7893:     const double z = node->mR / node->coeffDiag;
 7894:     const double p = node->mP;
 7895: 
 7896:     const double beta = (*rMr_new)/(*rMr_old);
 7897: 
 7898: 
 7899:     // p =z + beta*p
 7900:     node->mP = z + beta*p;
 7901: 
 7902: }
 7903: 
 7904: __global__ void initializeScalars(double *scalars) {
 7905: 
 7906:    // These point to a cupy array in the host code
 7907:    rMr_old = scalars + 0;
 7908:    rMr_new = scalars + 1;
 7909:    pAp     = scalars + 2;
 7910: }
 7911: 
 7912: __global__ void initializePreconditionedResidual(void) {
 7913: 
 7914:     __shared__ double s_rMr[BLOCK_SIZE];  
 7915: 
 7916:     s_rMr[threadIdx.x] = 0.0;
 7917: 
 7918:     NODE_ALL(node, valid);
 7919:     const int tid = threadIdx.x;
 7920:     // For the first iteration:
 7921:     // 1. Initial solution x = 0 (already set)
 7922:     // 2. Initial residual r = b (stored in qel)
 7923:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7924: 
 7925: // XXX we should use the guess solution here    
 7926: 
 7927:     double l_rMr = 0.0;
 7928:     if (valid) {
 7929:       // Set initial residual r = b (from qel)
 7930:       node->mR = node->qel;
 7931: 
 7932:       // Compute z = M^-1 * r (preconditioned residual)
 7933:       const double z = node->mR / node->coeffDiag;
 7934: 
 7935:       // Set initial search direction p = z
 7936:       node->mP = z;
 7937: 
 7938:       // Initialize other variables needed for CG
 7939:       node->mX = 0.0;  // Initial solution
 7940:       node->mAp = 0.0; // Will be computed in first iteration
 7941: 
 7942: 
 7943:       // Computes the first r'Mr (reduction)
 7944:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7945:     }
 7946:     // 4) write into shared-mem
 7947:     s_rMr[tid] = l_rMr;
 7948: 
 7949:     __syncthreads();
 7950: 
 7951: 
 7952:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7953:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7954:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7955:         __syncthreads();
 7956:     }
 7957: 
 7958:     // 6) thread 0 atomically folds into the global accumulators
 7959:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7960: 
 7961:     *rMr_old = 0.0;
 7962:     *pAp = 0.0;
 7963: }
 7964: 
 7965: 
 7966: 
 7967: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7968:    Element *elems = mesh->localElemData;
 7969: 
 7970:    *addr = elems;
 7971:    *sizeElement = sizeof(Element);
 7972:    switch (varCode) {
 7973:       case (int)VarCode::z:
 7974:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7975:          *sizeType = sizeof(double);
 7976:          break;
 7977:       case (int)VarCode::x:
 7978:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7979:          *sizeType = sizeof(Vector2);
 7980:          break;
 7981:       case (int)VarCode::area:
 7982:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7983:          *sizeType = sizeof(double);
 7984:          break;
 7985:       case (int)VarCode::depth:
 7986:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7987:          *sizeType = sizeof(double);
 7988:          break;
 7989:       case (int)VarCode::radius:
 7990:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7991:          *sizeType = sizeof(double);
 7992:          break;
 7993:       case (int)VarCode::lonlat:
 7994:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7995:          *sizeType = sizeof(double);
 7996:          break;
 7997:       case (int)VarCode::ghat:
 7998:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7999:          *sizeType = sizeof(Vector2);
 8000:          break;
 8001:       case (int)VarCode::kb:
 8002:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8003:          *sizeType = sizeof(int);
 8004:          break;
 8005:       case (int)VarCode::isdry:
 8006:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8007:          *sizeType = sizeof(int);
 8008:          break;            
 8009:       case (int)VarCode::w:
 8010:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8011:          *sizeType = sizeof(double);
 8012:          break;
 8013:       case (int)VarCode::FaceIndices:
 8014:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8015:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8016:          *sizeType = sizeof(Node);
 8017:          break;
 8018:       default:
 8019:          *offset = -1;
 8020:    }
 8021: }
 8022: 
