 8040:          *sizeType = sizeof(Vector2);
 8041:          break;
 8042:       case (int)VarCode::len:
 8043:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 8044:          *sizeType = sizeof(double);
 8045:          break;
 8046:       case (int)VarCode::kb:
 8047:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 8048:          *sizeType = sizeof(int);
 8049:          break;
 8050:       case (int)VarCode::isdry:
 8051:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 8052:          *sizeType = sizeof(int);
 8053:          break;            
 8054:       case (int)VarCode::w:
 8055:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 8056:          *sizeType = sizeof(double);
 8057:          break;
 8058:       case (int)VarCode::u:
 8059:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 8060:          *sizeType = sizeof(Vector2);
 8061:          break;   
 8062:       case (int)VarCode::n1:
 8063:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8064:          *sizeType = sizeof(Node);
 8065:          break;
 8066:       case (int)VarCode::n2:
 8067:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8068:          *sizeType = sizeof(Node);
 8069:          break;                   
 8070:       default:
 8071:          *offset = -1;
 8072:    }
