 1479:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1480:       // Compute the different time ramps used in the code 
 1481:       // This function is performed by just one thread
 1482: 
 1483:       if constexpr(ibc == 0) {
 1484:          if (drampbc > 0.0) {
 1485:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1486:          } else {
 1487:             rampbc = 1.0;
 1488:          }
 1489: 
 1490:          if (nws != 0 && drampwind > 0.0) {
 1491:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1492:          } else {
 1493:             rampwind = 1.0;
 1494:          }
 1495:       }
 1496: 
 1497:       if (drampwafo > 0.0) {
 1498:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1499:       } else {
 1500:          rampwafo = 1.0;
 1501:       }
 1502: 
 1503:       // For source/sinks
 1504:       if (if_source && dramp_ss > 0.0) {
 1505:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1506:       } else {
 1507:          ramp_ss = 1.0;
 1508:       }
 1509: 
 1510:       if (dramp > 0.0) {
 1511:          ramp = tanh(2.0*time/86400.0/dramp);
 1512:       } else {
 1513:          ramp = 1.0;
 1514:       }
 1515: 
 1516:    }
