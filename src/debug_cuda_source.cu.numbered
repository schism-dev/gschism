 1956:    template<typename T>
 1957:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 1958:       T values[4];
 1959:       getNodalValues(level, func, values);
 1960: 
 1961:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1962:       if constexpr (IsVector2<T>::value && ics == 2) {
 1963:          projectNodeVectorsToElementFrame(values);
 1964:       }
 1965: 
 1966:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1967:    }
 1968: 
 1969:    template<typename T>
 1970:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 1971:       T values[4];
 1972:       getNodalValues(field, values);
 1973: 
 1974:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1975:       if constexpr (IsVector2<T>::value && ics == 2) {
 1976:          projectNodeVectorsToElementFrame(values);
 1977:       }
 1978:       
 1979:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1980:    }
 1981: 
 1982: 
 1983:    template<typename T>
 1984:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 1985:       T values[4];
 1986:       getNodalValues(level, field, values);
 1987:       
 1988:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1989:       if constexpr (IsVector2<T>::value && ics == 2) {
 1990:          projectNodeVectorsToElementFrame(values);
 1991:       }
 1992: 
 1993:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1994:    }
 1995: 
 1996:    template<typename T>
 1997:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 1998:       T values[4];
 1999:       getNodalValues(field, values);
 2000: 
 2001:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2002:       if constexpr (IsVector2<T>::value && ics == 2) {
 2003:          projectNodeVectorsToElementFrame(values);
 2004:       }
 2005: 
 2006:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2007:    }
 2008: 
 2009:    template<typename T>
 2010:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2011:       T values[4];
 2012:       getSideValues(field, values);
 2013:       
 2014:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2015:       if constexpr (IsVector2<T>::value && ics == 2) {
 2016:          projectSideVectorsToElementFrame(values);
 2017:       }
 2018: 
 2019:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2020:    }   
 2021: 
 2022:    template<typename T>
 2023:    __device__ __forceinline__ T Element::mean(int level, T (Node::* field)[nvrt]) const {
 2024:       T values[4];
 2025:       getNodalValues(level, field, values);
 2026: 
 2027:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2028:       if constexpr (IsVector2<T>::value && ics == 2) {
 2029:          projectNodeVectorsToElementFrame(values);
 2030:       }
 2031: 
 2032:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2033:    }
 2034: 
 2035:    template<typename T>
 2036:    __device__ __forceinline__ T Element::mean(int level, T (Side::* field)[nvrt]) const {
 2037:       T values[4];
 2038:       getSideValues(level, field, values);
 2039: 
 2040:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2041:       if constexpr (IsVector2<T>::value && ics == 2) {
 2042:          projectSideVectorsToElementFrame(values);
 2043:       }
 2044: 
 2045:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2046:    }   
