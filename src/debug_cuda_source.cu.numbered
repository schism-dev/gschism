 2508: 
 2509: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2510: 
 2511:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2512:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2513:    const Node *n1 = side->n1;
 2514:    const Node *n2 = side->n2;
 2515: 
 2516:    bool n1_match = (n1->nodeBnd->segment == segment);
 2517:    bool n2_match = (n2->nodeBnd->segment == segment);
 2518: 
 2519:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2520:    if (n1_match && n2_match) {
 2521:       return 0.5;
 2522:    } else if (n1_match) {
 2523:       return 1.0;
 2524:    } else if (n2_match) {
 2525:       return 0.0;
 2526:    }
 2527: 
 2528:    return 0.0;
 2529: }
 2530: 
 2531: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2532: 
 2533: 
 2534: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2535: 
 2536:    const double w1 = getBoundaryArrayValueWeight();
 2537:    const double w2 = 1.0 - w1;
 2538:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2539:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2540: 
 2541:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2542: }
 2543: 
 2544: 
 2545: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2546:    const double w1 = getBoundaryArrayValueWeight();
 2547:    const double w2 = 1.0 - w1;
 2548:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2549:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2550: 
 2551:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2552: 
 2553: }
 2554: 
 2555: 
 2556: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2557:    // Returns the value of the velocity at the side center
 2558:    const double w1 = getBoundaryArrayValueWeight();
 2559:    const double w2 = 1.0 - w1;
 2560:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2561:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2562: 
 2563:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2564: }
 2565: 
 2566: 
 2567: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2568:    // Returns the value of the normal component of the velocity at the side center
 2569:    const double w1 = getBoundaryArrayValueWeight();
 2570:    const double w2 = 1.0 - w1;
 2571:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2572:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2573: 
 2574:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2575: }
 2576: 
 2577: 
 2578: 
 2579: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2580: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2581: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2582: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2583: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2584: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2585:    Vector2 grad = {0.0, 0.0};
 2586:    int count = 0;
 2587: 
 2588:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2589: 
 2590:    // First element
 2591:    if (elems[0] != nullptr && condition(elems[0])) {
 2592:       grad += elems[0]->grad2(field);
 2593:       count++;
 2594:    }
 2595: 
 2596:    // Second element
 2597:    if (elems[1] != nullptr && condition(elems[1])) {
 2598:       grad += elems[1]->grad2(field);
 2599:       count++;
 2600:    }
 2601: 
 2602:    if (count > 0) {
 2603:       grad = grad/count;
 2604:    }
 2605:    
 2606:    return grad;
 2607: }
 2608: 
 2609: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2610: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv,     n2->iadv); }   
 2611: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2612: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2613: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2614: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2615: 
 2616: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2617: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2618: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2619: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2620: 
 2621: 
 2622: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2623: 
 2624: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
