  512: 
  513:    Frame frame;
  514: 
  515:    Vector2 gradPhi[4];        // Derivatives of shape functions
  516:    Vector2 gradEta;           // Gradient of free surface elevation
  517:    Vector2 gradPr;            // Gradient of pressure    
  518:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
  519: 
  520:    bool isDry;                // True if the element is dry
  521: 
  522:    Vector2 center;         // Element center coordinates
  523:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  524:    double depth;              // Depth at element (min of all nodes)
  525:    double z[nvrt];            // z-coord  (local frame - vertical up)
  526: 
  527:    // Physical information
  528:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  529: 
  530:    static const bool isblock = false;              // Always false
  531: 
  532:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  533:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  534: 
  535:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  536:    
  537: 
  538:    double vsource;            // Volumetric source/sink term [m^3/s]
  539: 
  540:    double rho[nvrt];          // Density at each prism center
  541:    double rho_mean[nvrt];     // Mean density at each prism center
  542:    CubicSpline rho_spl;
  543:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  544:    double rho_z[nvrt];        // First derivative of density at each prism center
  545:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  546:    
  547: 
  548:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  549: 
  550:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  551:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  552: 
  553:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  554:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  555: 
  556:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  557:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  558:       // Find the local index of the node in the element (0,1,2,3)
  559:       int res = __ffs((nodes[0] == node) | 
  560:                      ((nodes[1] == node) << 1) | 
  561:                      ((nodes[2] == node) << 2) | 
  562:                      ((nodes[3] == node) << 3)) - 1;
  563:       
  564:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  565:       return res;  
  566:    }
  567: 
  568:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  569:       // Find the local index of the side in the element (0,1,2,3)
  570:       int res = __ffs((sides[0] == side) | 
  571:                      ((sides[1] == side) << 1) | 
  572:                      ((sides[2] == side) << 2) | 
  573:                      ((sides[3] == side) << 3)) - 1;
  574:       
  575:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  576:       return res;
  577:    }
  578: 
  579:    __inline__ __device__ int nodeLocalIdx(const Node *node) const {
  580:       // Find the local index of the node in the element (0,1,2,3)
  581:       int res = __ffs((nodes[0] == node) | 
  582:                      ((nodes[1] == node) << 1) | 
  583:                      ((nodes[2] == node) << 2) | 
  584:                      ((nodes[3] == node) << 3)) - 1;
  585:       
  586:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  587:       return res;
  588:    }
  589: 
  590: 
  591:    __inline__ __device__ bool containsSide(const Side *side) const {
  592:       return sides[0] == side || sides[1] == side || sides[2] == side || (isQuad() && sides[3] == side);
  593:    }
  594: 
  595:    __inline__ __device__ void getSidesContainingNode(const Node *node, int &idxSide1, int &idxSide2) const;
  596: 
  597: 
  598:    __inline__ __device__ bool containsSegment(const Node *node, const Point2 &xt) const;    
  599:     
  600:     
  601:    __inline__ __device__ int findLevel(double z1, int k) const {
  602:       // Starting at index k, find sequentially the level that contains z
  603: 
  604:       assert(false && "findLevel: Not implemented"); // XXXXXXXXX
  605:       // For testing purposes, forgets k and performs a full search.
  606:       for (k = kb; k < nvrt - 1; k++) {
  607:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  608:       }
  609:       return nvrt - 2;
  610: 
  611: 
  612:       // if z is already betweeen z[k] and z[k+1], return k
  613:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  614:       else if (z1 <  z[k]) { 
  615:          // Search for increasing levels
  616:          for (int kk = k; kk < nvrt - 1; kk++) {
  617:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  618:          }
  619:          return nvrt - 1;
  620:       }
  621:       else {
  622:          // Search for decreasing levels
  623:          for (int kk = k; kk >= kb; kk--) {
  624:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  625:          }
  626:          return 0;
  627:       }
  628:    }
  629: 
  630: 
  631: 
  632:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  633:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  634: 
  635:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  636:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  637:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  638:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  639:        const double eta = (idx & 1) ? +g : -g;
  640:        const double xi  = (idx & 2) ? +g : -g;
  641:        return {eta, xi};
  642:    }  
  643: 
  644:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  645:    __device__ __forceinline__ double etaSign(int idx) const {
  646:       // bit1: 0 -> -1, 1 -> +1
  647:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  648:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  649:    }
  650: 
  651:    __device__ __forceinline__ double xiSign(int idx) const {
  652:       // +1 if (bit0 XOR bit1), else -1
  653:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  654:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  655: 
  656:    }
  657: 
  658:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  659:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  660:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  661:    }
  662: 
  663:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  664:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  665:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  666:    }   
  667: 
  668:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  669:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  670:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  671:    }      
  672:    
  673:    __inline__ __device__ double detJ_eta(void) const;
  674: 
  675:    __inline__ __device__ double detJ_xi(void) const;
  676: 
  677:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  678: 
  679:    // Check if the element is dry using the more up-to-date elevation.
  680:    __inline__ __device__ bool isDry2(void) const;
  681: 
  682:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  683: 
  684:    __inline__ __device__ double computeSignedArea(void) const;
  685: 
  686:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  687:       // Nudges the point (x,y) to the barycenter of the element
  688: 
  689:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  690:    }
  691: 
  692:    __device__ void computeShapeCoords(Point2 &xt, ShapeCoords &shpCoords) const;
  693:    
  694:    __device__ void shapeCoordsToXY(ShapeCoords const &shpCoords, Vector2 &xt) const;
  695: 
  696:    __device__ double intPhiPhi(int i1, int i2) const;
  697: 
  698:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  699: 
  700:    __device__ Vector2 grad2(double *a) const
  701:    {
  702:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  703:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  704:       if (isQuad()) {
  705:          gx += a[3]*gradPhi[3].x;
  706:          gy += a[3]*gradPhi[3].y;
  707:       }
  708:       return {gx, gy};
  709:    }
  710: 
  711:    __device__ Vector2 grad2(double Node::* field) const
  712:    {
  713:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  714:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  715:       if (isQuad()) {
  716:          gx += (nodes[3]->*field)*gradPhi[3].x;
  717:          gy += (nodes[3]->*field)*gradPhi[3].y;
  718:       }
  719:       return {gx, gy};
  720:    }
  721: 
  722:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  723:    __device__ __forceinline__ Vector3 n(int k) const {
  724:       double area3D;
  725:       return n(k, area3D);
  726:     }
