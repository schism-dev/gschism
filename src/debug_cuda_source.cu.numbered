 8599: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8600:    // Get the value of a variable from an side
 8601:    // varName is the name of the variable to get
 8602:    // var is the array to store the value
 8603:    // k is the vertical level index of the variable to get
 8604:    SIDE_BND(sideBnd);   
 8605: 
 8606:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8607:    if (sideBnd->segment->isLand) idx = -7;
 8608: 
 8609:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8610:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8611: 
 8612: }
