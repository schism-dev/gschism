 2049: 
 2050: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2051: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2052: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2053: // Only when ics == 2, the origin is at the element center.
 2054: 
 2055:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2056: 
 2057:    if constexpr(ics==1) {
 2058:       return nodes[idxNode]->p;
 2059: 
 2060:    } else {
 2061:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2062: 
 2063:       const Point3 p = toPoint3(nodes[idxNode]->p, nodes[idxNode]->gz); // XXXXX use p3D or similar?
 2064: 
 2065:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2066:    }
 2067: 
 2068: }
