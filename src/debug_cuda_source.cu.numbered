 1548: // Convenience macros for accessing the objects in kernels.
 1549: 
 1550: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1551:                    Side *side = &(mesh->localSideData[idx_side]); \
 1552:                    if (idx_side >= mesh->ns) return;
 1553: 
 1554: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1555:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1556:                    if (idx_elem >= mesh->ne) return;
 1557: 
 1558: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1559:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1560:                    if (idx_node >= mesh->np) return;
