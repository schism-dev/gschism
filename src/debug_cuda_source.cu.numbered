 4200:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4201: 
 4202:       SIDE(side);
 4203: 
 4204: 
 4205:       side->U = {0.0, 0.0}; 
 4206:          
 4207:       if(side->isDry) return;
 4208: 
 4209:       const Node *node1 = side->n1;
 4210:       const Node *node2 = side->n2;
 4211: 
 4212:       // Vertically integrated velocity U (in ll if ics=2)
 4213:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4214:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4215:       }
 4216: 
 4217:    }
 4218: 
 4219:    __global__ void computeBottomDragVegetation(void) {
 4220:       // UNFINISHED. CHECK THIS:
 4221:       // How many kernels are needed? Why so many for loops?
 4222:       // Is the loop on sides needed?
 4223: 
 4224:       NODE(node);
 4225: 
 4226:       const int    kb      = node->kb;
 4227:       const double htot    = node->htot2();
 4228:       const double rough   = node->rough;
 4229: 
 4230: 
 4231:       if (node->isDry) {
 4232:          // Default values for dry nodes
 4233:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4234:          /// XXX CHECK INDICES
 4235:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4236:       }
 4237: 
 4238:       // Compute bottom drag Cd
 4239:       //--------------------------------
 4240: 
 4241:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4242:       if (nchi==1) {
 4243: 
 4244:          bool ltmp = false; // for WBL iteration
 4245: 
 4246:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4247:          // Drag at nodes
 4248:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4249:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4250:         
 4251:          const double rough = node->rough;
 4252:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4253:          if (node->rough == 0.0) {
 4254:             node->Cd = 0.0;
 4255: 
 4256:          } else { //roughness >0 
 4257:             
 4258:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4259:             const double bthick = max(dzb_min, bthick_ori);
 4260: 
 4261:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4262: 
 4263:             double tmp = 1.0/(2.5*log(bthick/rough));
 4264:             node->Cd = tmp*tmp;
 4265: 
 4266:          } // if rough
 4267: 
 4268: 
 4269:          // RECOVER THIS: XXX
 4270:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4271:          // Output warning for WBL if iteration didn't converge
 4272: 
 4273: 
 4274:       } // nchi==1
 4275: 
 4276:       //   Bottom stress in m^2/s^2
 4277:       if (node->rho[kb + 1] >= -98.0)
 4278:       {
 4279:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4280:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4281:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4282:          // !sediment erosion: this part needs more documentation
 4283:       }
 4284: 
 4285:     
 4286:       // Compute vegetation parameters
 4287:       //--------------------------------
 4288: 
 4289:       // SAV constants
 4290:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4291:       constexpr double veg_cfpsi = 0.16;
 4292: 
 4293:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4294:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4295: 
 4296:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4297:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4298:          int kbin = 0; // bin index
 4299:          for (int k = kb; k < nvrt; k++) {
 4300:             // Computes node height above the bottom level
 4301:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4302:             assert(false && "Vertical variation of vegetation not implemented");
 4303: 
 4304:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4305:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4306:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4307:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4308:             // } else {
 4309:             //    // Find the bin at which the current vertical level is
 4310:             //    while (kbin<nbins_veg_vert) {
 4311:             //       const double zn = node->z[kbin];
 4312:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4313:             //          break;
 4314:             //       } // if
 4315:             //       kbin++;
 4316:             //    } // while
 4317:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4318: 
 4319:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4320:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4321:                
 4322:             //    // Linear interpolation of the vegetation parameters
 4323:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4324:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4325:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4326:             // } // if rl10
 4327: 
 4328:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4329: 
 4330:          } // for k
 4331: 
 4332: 
 4333:       } else { // Ganthy (iveg=2)
 4334:       //  Modify canopy height, diameter, and density
 4335: 
 4336:          // Make sure there is vegetation on this node
 4337:          if (node->veg_h_unbent > 0.0) {
 4338:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4339: 
 4340:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4341:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4342:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4343: 
 4344:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4345:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4346:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4347:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4348:          } // if veg_h_unbent
 4349: 
 4350:          for (int k = 0; k < nvrt; k++) {
 4351:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4352:          } // for k
 4353:       
 4354: 
 4355:       } // if iveg
 4356:      
 4357:          
 4358: 
 4359:       // Compute vertical mean of veg_alpha3D
 4360:       if (iveg != 0) {
 4361:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4362:          double sum1=0.0;
 4363:          double sum2=0.0;
 4364:          // Integrate over each level under the canopy...
 4365:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4366:             const double Dz = node->Dz(k);
 4367: 
 4368:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4369:             sum2 += Dz;
 4370: 
 4371:          } // for k
 4372: 
 4373:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4374:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4375: 
 4376:       } // if iveg
 4377: 
 4378:    }
 4379: 
 4380:    __global__ void computeVegetationAndDragParameters(void) {
 4381:       // Computes the vegetation and drag model parameters:
 4382:       // chi, \tilde\chi, beta, \breve{H}
 4383:       
 4384:       SIDE(side);
 4385: 
 4386:       const double htot = side->htot2();
 4387:       const int    kb   = side->kb;
 4388: 
 4389:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4390: 
 4391:       const double veg_h     = side->veg_h();
 4392:       const double veg_nv    = side->veg_nv();
 4393:       const double veg_c     = side->veg_c();
 4394:       const double veg_beta  = side->veg_beta;
 4395:       const double veg_alpha = side->veg_alpha_vert_mean();
 4396: 
 4397:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4398:       // Velocity magnitude at the bottom level
 4399:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4400:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4401:       side->chi2 = side->Cd()*vmag1;
 4402:       side->chi  = side->chi2;
 4403:       if constexpr(iveg != 0) {
 4404:          const Node *n1 = side->n1;
 4405:          const Node *n2 = side->n2;
 4406:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4407:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4408:       }
 4409: 
 4410:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4411: 
 4412:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4413:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4414:       double magUa = 0.0;
 4415:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4416:          // 3D wet side with veg...
 4417: 
 4418:          double magUa = 0.0;
 4419:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4420:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4421: 
 4422:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4423:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4424:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4425: 
 4426:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4427:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4428: 
 4429:                // Velocity magnitude at the bottom (l) of the level
 4430:                const double ul = length(side->u2[k]);
 4431: 
 4432:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4433:                magUa += Dz*0.5*(uh + ul);
 4434: 
 4435:             } // if HasVegetation
 4436:          } // for k
 4437:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4438: 
 4439:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4440:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4441:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4442:             const double zCpy = side->zTopCanopy();
 4443:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4444:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4445:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4446:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4447:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4448:          } // if isSubmerged
 4449:       } // if iveg   
 4450: 
 4451:       // Computes the friction modified depth, \breve{H} in notes
 4452:       if (side->is2D()) { // 2D
 4453: 
 4454:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4455:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4456: 
 4457:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4458: 
 4459:          side->hhat = htot*htot/fricH; 
 4460: 
 4461:       } else { // 3D
 4462:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4463: 
 4464:          if constexpr(iveg != 0) {
 4465:             
 4466:             if (side->isSubmerged()) { 
 4467:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4468:                side->hhat -= veg_c*Hhat_alpha;
 4469: 
 4470:             } else { // Emergent
 4471:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4472:             }
 4473:          } // if iveg
 4474: 
 4475:          // Enforce positivity for 3D model
 4476:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4477:       } // if 3D
 4478: 
 4479:    }
 4480: 
 4481: 
 4482: 
 4483:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4484:    // Computes the density gradient between two elements, e1 and e2.
 4485:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4486:    // zero in the direction normal to the side. 
 4487:    // 
 4488:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4489:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4490:    //
 4491:    // Input:
 4492:    //    e1: Element
 4493:    //    e2: Neighbor element (or nullptr if boundary)
 4494:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4495:    //    k: Index of the half-level at which the density is interpolated
 4496:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4497:    // 
 4498:    // Output:
 4499:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4500:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4501: 
 4502:       if (e2 == nullptr || e2->isDry) {
 4503:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4504: 
 4505:          Side *side = e1->sides[j];
 4506:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4507:                  
 4508:          if constexpr(ics == 1) {
 4509:             vec = side->n; // Normal vector to the side
 4510:          } else {
 4511:             // IMPLEMENT THIS XXXXXX
 4512:             // !replace with xel, yel?
 4513:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4514:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4515:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4516:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4517:          } //ics
 4518:                    
 4519:          diffRho = 0.0;
 4520: 
 4521:       } else { //internal and wet
 4522:          if constexpr(ics==1) {
 4523:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4524: 
 4525:             // Vector from e1 to e2
 4526:             vec = toVector2(e2->center - e1->center);
 4527: 
 4528:          } else { 
 4529:             // IMPLEMENT THIS XXXXXX
 4530:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4531:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4532:             //                   alow(j)=xctr2
 4533:             //                   bdia(j)=yctr2
 4534:          } // ics
 4535: 
 4536:          diffRho = rho2 - e1->demeanedDensity(k);
 4537:       }
 4538: 
 4539:    }
 4540: 
 4541:    __global__ void computeDensityCubicSplines(void) {
 4542:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4543: 
 4544:       ELEM(elem);
 4545: 
 4546:       if (elem->isDry) return;
 4547: 
 4548:       const int kb = elem->kb;
 4549: 
 4550:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4551:       if (elem->is2D()) {
 4552:          // In the 2D case, the density is constant at the prism level. 
 4553:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4554:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4555:       } else { //3D
 4556: 
 4557:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4558:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4559:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4560:          ///// XXXX CHECK INDICES!!!!!
 4561:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4562:       } // 2D/3D
 4563: 
 4564:    }
 4565: } // extern "C"
 4566: 
 4567: 
 4568: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4569: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4570: 
 4571:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4572: 
 4573:    const int kb  = elem->kb;
 4574:    const int kb2 = elem2->kb;
 4575: 
 4576:    // z-coordinate of prism of elem
 4577:    const double zp = elem->z_prism(k);
 4578: 
 4579:    double rho = 0.0;
 4580: 
 4581:    if (elem2->is2D()) {
 4582:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4583: 
 4584:    } else {  // 3D
 4585: 
 4586:       // eta_min may be < zmax
 4587:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4588:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4589: 
 4590:       // (Extrapolate density below bottom, we will fix it later)
 4591:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4592:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4593:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4594:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4595:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4596:    } // 2D/3D
 4597:      
 4598: 
 4599:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4600:    // Now we need to fix it.
 4601:    if (elem->z[k] < elem2->z[kb2]) {
 4602:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4603: 
 4604:       // There are two methods to adjust the density at the bottom of the element.
 4605:       // iunder_deep=0: 
 4606:       const double depth1 = abs(elem->z[kb]); // larger depth
 4607: 
 4608:       if (iunder_deep==0) {
 4609: 
 4610:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4611: 
 4612:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4613: 
 4614:       } else { // iunder_deep != 0
 4615: 
 4616:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4617: 
 4618:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4619: 
 4620:          //   Demeaned density at the same z coordinate as
 4621:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4622:          }
 4623: 
 4624:       } // if iunder_deep
 4625:    } // if elem->z[kb] < elem2->z[kb]
 4626: 
 4627:    return rho;
 4628: }
 4629: 
 4630: 
 4631: extern "C" {
 4632:    __global__ void computeDensityGradient(void) {
 4633: 
 4634:          // Compute the horizontal density gradient at each element.
 4635:       // It works in two steps:
 4636:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4637:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4638:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4639:       //             gradRho.r1 = rho1 - rho0
 4640:       //             gradRho.r2 = rho2 - rho0
 4641:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4642:       // 
 4643:       //  NOTE: We use de-meaned densities.
 4644: 
 4645:       ELEM(elem);
 4646: 
 4647:       if (elem->isDry) return;
 4648: 
 4649:       const int kb  = elem->kb;
 4650:       const int i34 = elem->i34;
 4651: 
 4652:       for (int k = kb + 1; k < nvrt; k++) {
 4653:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4654:          //             gradRho.r1 = rho1 - rho0
 4655:          //             gradRho.r2 = rho2 - rho0
 4656:          int icount = 0;
 4657:          double sumRx = 0.0;
 4658:          double sumRy = 0.0;
 4659:          for (int j1=0; j1<i34; j1++) { 
 4660: 
 4661:             const int j2 = elem->nxq(j1 + 1);
 4662: 
 4663:             // Pairs of consecutive neighbor elements of elem
 4664:             const Element *e1 = elem->nghbElems[j1];
 4665:             const Element *e2 = elem->nghbElems[j2];
 4666: 
 4667:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4668:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4669:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4670: 
 4671:             // Compute the density difference and the vector from elem to e1 and e2
 4672:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4673:             double diffRho1, diffRho2;
 4674:             Vector2 vec1, vec2;
 4675:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4676:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4677: 
 4678:             const double rl1 = length(vec1);
 4679:             const double rl2 = length(vec2);
 4680:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4681: 
 4682:             const double delta = cross(vec1, vec2);
 4683:             const double sintheta = abs(delta)/(rl1*rl2);
 4684: 
 4685:             // To avoid problems, avoid elements with small angle between vectors
 4686:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4687:             const bool validEq = (sintheta > sin_one_deg);
 4688: 
 4689:             if (validEq) {
 4690:                // Solve the system of equations to get the density gradient at elem
 4691:                icount++;
 4692:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4693:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4694:                sumRx += Rx;
 4695:                sumRy += Ry;
 4696:             }
 4697:          } // for j1
 4698: 
 4699:          // Compute the average density gradient at elem
 4700:          if (icount==0) {
 4701:            // Bad mesh quality; bail out with 0 b-cc
 4702:            elem->gradRho[k] = {0.0, 0.0};
 4703:          } else {
 4704:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4705:          }
 4706: 
 4707:       } // for k
 4708: 
 4709:    }
 4710: 
 4711:    __global__ void computeBaroclinicTerm(void) {
 4712:    // Computes the baroclinic term at sides (at half levels).
 4713:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4714:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4715: 
 4716:       SIDE(side);
 4717: 
 4718:       if (side->isDry) return;
 4719: 
 4720:       const Element *e1 = side->elems[0];
 4721:       const Element *e2 = side->elems[1];      
 4722:       const int kb = side->kb;
 4723:       
 4724:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4725: 
 4726:       // interpolates vertically the density gradient of the two elements at the half level/
 4727: 
 4728:       // Starts the integration at the surface and goes down to the bottom
 4729:       int k1 = nvrt - 1;
 4730:       int k2 = nvrt - 1;
 4731: 
 4732:       side->bcc[nvrt-1] = {0.0, 0.0};
 4733:       for (int k = nvrt-2; k >= kb; k--) {
 4734:       // For each prism level (from surface to bottom)...
 4735: 
 4736:          // For both elements, interpolate density gradient at the side's half level.
 4737:          // The gradient at the side is the average of the gradients at the elements.
 4738:          // w1, w2 are used to take into account boundary sides, with just one element.
 4739:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4740:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4741:          const double wsum = w1 + w2;
 4742:          w1 = w1/wsum;
 4743:          w2 = w2/wsum;
 4744:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4745: 
 4746:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4747:          Vector2 gradRho = {0.0, 0.0};
 4748:          if (e1 != nullptr && k > kb) {
 4749:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4750:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4751:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4752:             
 4753:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4754:          }      
 4755:          if (e2 != nullptr && k > kb) {
 4756:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4757:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4758:             
 4759:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4760:          }
 4761: 
 4762:          if constexpr(ics==2) {
 4763:             // IMPLEMENT THIS XXXXXX
 4764:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4765:             // swild(1)=tmp1
 4766:             // swild(2)=tmp2
 4767:          }
 4768:          
 4769:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4770:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4771:          // CHECK INDICES!!! XXX
 4772:          const double grav3 = side->grav3();
 4773:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4774: 
 4775:       } // for
 4776: 
 4777:    }
 4778: 
 4779: 
 4780: 
 4781:    __global__ void computeHorGradientAtSide(void) {
 4782: 
 4783:       // Compute the horizontal density gradient at each element.
 4784:       // It works in two steps:
 4785:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4786:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4787:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4788:       //             gradRho.r1 = rho1 - rho0
 4789:       //             gradRho.r2 = rho2 - rho0
 4790:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4791:       // 
 4792:       //  NOTE: We use de-meaned densities.
 4793: 
 4794:       SIDE(side);
 4795: 
 4796:       if (side->isDry) return;
 4797: 
 4798:       // Computes the gradient of the variables at the side center.
 4799:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4800:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4801:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4802: 
 4803:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4804:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4805:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4806:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4807: 
 4808: 
 4809:    }
 4810: 
 4811: 
 4812:    __global__ void solveMomentumEquations(double time) {
 4813: 
 4814:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4815:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4816: 
 4817:       SIDE(side);
 4818: 
 4819:       if (side->isDry) 
 4820:       {
 4821:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4822: 
 4823:          return;
 4824:       }
 4825: 
 4826:       const Node *n1 = side->n1;
 4827:       const Node *n2 = side->n2;
 4828: 
 4829:       const int kb = side->kb;
 4830: 
 4831:       const double veg_h = side->veg_h();
 4832:       const double grav3 = side->grav3();
 4833: 
 4834:       if (side->is2D()) {
 4835:          // Warning: Do not use htot2, which is updated.
 4836:          const double htot = side->htot1();
 4837:          const double hhat = side->hhat;
 4838: 
 4839:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4840: 
 4841:          Vector2 tau2 = {0.0, 0.0};
 4842:           
 4843:          if constexpr(ics==1) {
 4844:             tau2 = side->tau();
 4845: 
 4846:          } else {
 4847:             assert(false && "Not implemented: ics == 2");
 4848:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4849:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4850:             // taux2=(vn1+tt1)*0.5d0
 4851:             // tauy2=(vn2+ss1)*0.5d0
 4852:          } // if ics         
 4853: 
 4854:          // hat_gam has units of m/s
 4855: 
 4856:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4857: 
 4858:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4859:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4860: 
 4861:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4862: 
 4863:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4864:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4865: 
 4866:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4867: 
 4868:       }
 4869:       else { // 3D
 4870: 
 4871:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4872:          // 
 4873:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4874:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4875:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4876:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4877:          // k+1 and k.
 4878: 
 4879: 
 4880:          // // Define layer thickness & viscosity
 4881:          // for (int k=kb + 1; k<nvrt; k++) {
 4882:          //    const double dzz = side->Dz(k - 1);
 4883: 
 4884:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4885: 
 4886:          //    // Vertical viscosity at the face center
 4887:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4888:         
 4889:          // }
 4890: 
 4891: 
 4892:          const int ndim = nvrt - kb;
 4893:          const double zTopCanopy = side->zTopCanopy();
 4894: 
 4895:          // Initialize the tridiagonal system
 4896:          for (int k = kb + 1; k<nvrt; k++) {
 4897:             
 4898:             const int kin = k - kb;
 4899: 
 4900:             // Vertical viscosity at the face center
 4901:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4902:             const double dzz = side->Dz(k);
 4903: 
 4904:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4905: 
 4906:             alow[kin] = 0.0;
 4907:             cupp[kin] = 0.0;
 4908:             bdia[kin] = 0.0;
 4909: 
 4910:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4911:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4912: 
 4913:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4914:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4915:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4916: 
 4917:             // First part: layers k, k+1
 4918:             if (k < nvrt - 1) {
 4919:                              
 4920:                if constexpr(iveg != 0) {
 4921: 
 4922:                   // If there is vegetation at this level...
 4923:                   if (zTopCanopy > side->zc[k]) {
 4924:                      // If the canopy is above the k layer...
 4925:                      
 4926:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4927:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4928:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4929:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4930: 
 4931:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4932:                      const double vmag2 = length(ut2);
 4933:                      const double vmag1 = length(side->u2[k]);
 4934:                      const double vmag = 0.5*(vmag1 + vmag2);
 4935:                      
 4936:                      // Computes the vegetation alpha at the face center
 4937:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4938: 
 4939:                      cff1 += veg_alpha_sd*dt*vmag;
 4940: 
 4941:                   } // if (zTopCanopy
 4942:                } // if iveg
 4943: 
 4944:                const double tmp = dt*dfz/dzz;
 4945:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4946:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4947:             }
 4948: 
 4949: 
 4950:             // Second part: layers k-1, k
 4951:             if (k > kb + 1) {
 4952: 
 4953:                double cff1 = 1.0; //init \bar{c^k}
 4954: 
 4955:                if constexpr(iveg != 0) {
 4956:                   // If there is vegetation at this level...
 4957:                   if (zTopCanopy > side->zc[k-1]) {
 4958:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4959:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4960: 
 4961:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4962: 
 4963:                      const double vmag2 = length(ut2);
 4964:                      const double vmag1 = length(side->u2[k-1]);
 4965:                      const double vmag = 0.5*(vmag1 + vmag2);
 4966: 
 4967:                      // Computes the vegetation alpha at the face center
 4968:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4969:                      cff1 += veg_alpha_sd*dt*vmag;
 4970:                   } // if zTopCanopy
 4971: 
 4972:                } // if iveg
 4973: 
 4974:                const double tmp = dt*dfz/dzz;
 4975:                alow[kin] += cff1*dzz/6.0 - tmp;
 4976:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4977: 
 4978:             } else { // Bottom boundary
 4979:                // This occurs at the bottom, where the bottom drag is applied.
 4980: 
 4981:                bdia[kin] += dt*side->chi2;
 4982: 
 4983:             } // if (k > kb + 1)
 4984: 
 4985: 
 4986: 
 4987:          } // for (int k
 4988: 
 4989: 
 4990: 
 4991:          // Computes the RHS.
 4992:          // -----------------
 4993: 
 4994:          //	BC to be imposed at the end.
 4995: 
 4996:          const Vector2 gradETP  = side->gradETP;
 4997:          const Vector2 gradPr   = side->gradPr;
 4998:          const Vector2 gradEta1 = side->gradEta1;
 4999:          const Vector2 gradEta2 = side->gradEta2;
 5000: 
 5001:          const Vector2 *btu = side->btu;
 5002:          const Vector2 *u2  = side->u2;
 5003:          const double coriolis = side->coriolis;
 5004:          const Vector2 *nuGradU = side->nuGradU;
 5005: 
 5006: 
 5007:          for (int k = kb + 1; k<nvrt; k++) {
 5008:             const int kin = k - kb;
 5009: 
 5010:             const double dz_0 = side->Dz(k);
 5011:             const double dz_1 = side->Dz(k+1);  
 5012: 
 5013:             rrhs[kin] = {0.0, 0.0};
 5014:             double dz = 0.0;
 5015: 
 5016:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5017:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5018:             if (k < nvrt  ) dz += 0.5*dz_1;
 5019:             if (k > kb + 1) dz += 0.5*dz_0;
 5020: 
 5021:             // Elevation gradient, atmospheric pressure and tidal potential
 5022:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5023: 
 5024:             // Coriolis, advection, wind stress, and horizontal viscosity
 5025:             if (k < nvrt - 1) {
 5026: 
 5027: 
 5028:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5029:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5030:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5031: 
 5032:                //diff stress tensors 1006
 5033:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5034:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5035:                   assert(false && "Not implemented: itur == 5");
 5036:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5037:                }
 5038: 
 5039:             } else { // k=nvrt
 5040:                Vector2 tau2 = {0.0, 0.0};
 5041:                if constexpr(ics==1) {
 5042:                   tau2 = side->tau();
 5043:                } else {
 5044:                   assert(false && "Not implemented: ics == 2");
 5045:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5046:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5047:                   // taux2=(vn1+tt1)*0.5d0
 5048:                   // tauy2=(vn2+ss1)*0.5d0
 5049:                } // if ics
 5050: 
 5051:                rrhs[kin] += dt*tau2;
 5052: 
 5053:             } // if k<nvrt
 5054: 
 5055:             if (k > kb + 1) {
 5056:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5057:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5058:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5059: 
 5060: 
 5061:                // diff stress tensors 1006
 5062:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5063:                   assert(false && "Not implemented: itur == 5");
 5064:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5065:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5066:                }
 5067: 
 5068:             } // if k>kbs + 1
 5069: 
 5070:             // Baroclinic
 5071:             Vector2 *bcc = side->bcc;
 5072:             if constexpr(ibc == 0) {
 5073:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5074:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5075: 
 5076:             } // if ibc==0
 5077: 
 5078: 
 5079:          } // k=kb + 1,nvrt
 5080: 
 5081:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5082:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5083: 
 5084: 
 5085:          for (int k=kb + 1; k<nvrt; k++) {
 5086:             const int kin = k - kb;
 5087: 
 5088:             // Velocity is always clamped to maximum values
 5089:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5090:          } // k
 5091: 
 5092:       } // if side->is2D()
 5093:       
 5094: 
 5095:       // Impose velocity boundary condition at the bottom
 5096:       if constexpr(imm == 2) { // 3D bed deformation model
 5097:          double dep;
 5098:          Vector2 vel;
 5099: 
 5100:          assert(false && "Not implemented: imm == 2");
 5101:          //update_bdef(time, x0, y0, dep, vel);
 5102:          // side->u2[kb] = vel;
 5103: 
 5104:       } else { // imm = 0 or 1
 5105:          if (side->Cd() == 0.0) {
 5106:             side->u2[kb] = side->u2[kb + 1];
 5107:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5108:             side->u2[kb] = {0.0, 0.0};
 5109:          }
 5110:           
 5111:       } // if imm
 5112: 
 5113:       // The velocities below the bottom level are set to zero
 5114:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5115: 
 5116: 
 5117:    }
 5118: 
 5119: 
 5120:    __global__ void applyMomentumBC(void) {
 5121: 
 5122:       SIDE_BND(sideBnd);
 5123: 
 5124:       Side *side = sideBnd->side;
 5125:       const BoundarySegment *segment = sideBnd->segment;
 5126:       const Node *n1 = side->n1;
 5127:       const Node *n2 = side->n2;
 5128: 
 5129:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5130: 
 5131:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5132:       const bool isLand = segment->isLand;
 5133:       const int ifltype = segment->ifltype;
 5134: 
 5135:       const int kb = side->kb;
 5136: 
 5137:       if (!isLand && ifltype != 0) {
 5138:          const Vector2 *ubc = sideBnd->ubc;
 5139:   
 5140:          for (int k=kb; k < nvrt; k++) {
 5141:             
 5142:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5143:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5144: 
 5145:             if (ifltype == -1) {
 5146:                // Flather 1
 5147: 
 5148:                const double depth = side->depth();
 5149: 
 5150:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5151: 
 5152:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5153: 
 5154:                side->u2[k] = vnorm*side->n;
 5155: 
 5156:             } else if (ifltype == -2) { // Discharge
 5157: 
 5158:                const double eta1 = side->eta1();
 5159:                const double eta2 = side->eta2();
 5160:                const double htot = side->htot2();
 5161: 
 5162:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5163:                assert(false && "Not implemented: Discharge bc");
 5164:                // const double dischrg = discharge(eta1);
 5165:                const double dischrg = 0.0; // XXX REMOVE
 5166:                
 5167: 
 5168:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5169: 
 5170:                const double vnorm = dischrg*eta2/htot;
 5171: 
 5172:                side->u2[k] = vnorm*side->n;
 5173: 
 5174: 
 5175:             }
 5176:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5177:                const double vnorm = dot(side->u2[k], side->n);
 5178: 
 5179:                double rat;
 5180:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5181:                else              rat = segment->vobc2; // outgoing
 5182: 
 5183:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5184:             }
 5185:             else { // not Flather or 3D radiation
 5186:                side->u2[k] = ubc[k];
 5187: 
 5188:             } // if (segment->ifltype...
 5189: 
 5190:          }
 5191: 
 5192:       }
 5193:       else if (isLand) { // if it is land boundary side
 5194: 
 5195:          if constexpr(islip == 0) { // free slip
 5196:             for (int k=kb; k < nvrt; k++) {
 5197: 
 5198:                const Vector2 t = side->t();
 5199:                const Vector2 n = side->n;
 5200: 
 5201:                double vnorm = 0.0; // for most cases
 5202:                const double vtan = dot(side->u2[k], t);
 5203:                
 5204:                side->u2[k] = vtan*t - vnorm*n;
 5205: 
 5206:             }
 5207: 
 5208:          } else { // no slip
 5209:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5210: 
 5211:          }
 5212:       } // if (side segment type...
 5213: 
 5214:    
 5215: 
 5216:    }
 5217: 
 5218: 
 5219:    __global__ void shapiroFilter1(void) {
 5220:       // First step of the Shapiro filter (normally used if indvel<=0)
 5221:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5222: 
 5223:       SIDE(side);
 5224: 
 5225:       // Only internal wet sides are processed
 5226:       if (side->isDry || !(side->isInternal())) return;
 5227: 
 5228:       const int kb = side->kb;
 5229: 
 5230:       for (int mm = 1; mm <= niter_shap; mm++) {
 5231: 
 5232:          for (int k = kb + 1; k < nvrt; k++) {
 5233:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5234:             side->bcc[k] = {0.0, 0.0};
 5235:             Vector2 suru = {0.0, 0.0};
 5236: 
 5237:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5238: 
 5239:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5240: 
 5241:                int kin = k;
 5242:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5243:                
 5244:                if constexpr(ics==1) {
 5245:                   suru += nSide->u2[kin];
 5246: 
 5247:                } else {
 5248:                   assert(false && "Not implemented: ics == 2");
 5249:                   // Vector2 vn1, vn2;
 5250:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5251:                   // suru=suru+vn1;
 5252:                   // surv=surv+vn2;
 5253:                }
 5254:             }
 5255: 
 5256: 
 5257:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5258: 
 5259:          }
 5260:       }
 5261:    }
 5262: 
 5263:    __global__ void shapiroFilter2(void) {
 5264:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5265: 
 5266:       SIDE(side);
 5267: 
 5268:       if (side->isDry || !(side->isInternal())) return;
 5269: 
 5270:       const int kb = side->kb;
 5271: 
 5272:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5273: 
 5274:       if (side->is2D()) {
 5275:          // side->u2[kb] = side->u2[nvrt - 1];
 5276:          side->u2[kb + 1] = side->bcc[kb + 1];
 5277:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5278: 
 5279:       } else {
 5280:          // 3D
 5281:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5282:          
 5283:       }
 5284: 
 5285:    }
 5286: 
 5287: 
 5288:    __global__ void ul0UpdateZCoords(void) {
 5289:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5290:       
 5291:       NODE(node);      
 5292: 
 5293:       if (node->isDry2()) { 
 5294: 
 5295:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5296: 
 5297:          if constexpr(ivcor != 1) node->kb = 0;
 5298: 
 5299:       } else {
 5300: 
 5301:          node->updateKb();
 5302:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5303: 
 5304:       }
 5305: 
 5306:       // We use the temp.b field to store the previous state of isDry.
 5307:       node->tmp.b = node->isDry;
 5308: 
 5309:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5310:       node->isDry = true;
 5311: 
 5312:    }
 5313: 
 5314:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5315:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5316:    {
 5317:       ELEM(elem);
 5318: 
 5319:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5320: 
 5321:       // All the nodes of a wet element are wet.
 5322:       if (!elem->isDry) {
 5323:          elem->nodes[0]->isDry = false;
 5324:          elem->nodes[1]->isDry = false;
 5325:          elem->nodes[2]->isDry = false;
 5326:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5327: 
 5328:       }
 5329: 
 5330: 
 5331:       elem->kb = 0;
 5332: 
 5333:       if (elem->isDry) return;
 5334: 
 5335:       // Wet
 5336:       const Node *n1 = elem->nodes[0];
 5337:       const Node *n2 = elem->nodes[1];
 5338:       const Node *n3 = elem->nodes[2];  
 5339:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5340: 
 5341:    //    if(elem->isDry2()) {
 5342:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5343:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5344:    //        call parallel_abort(errmsg)
 5345:    //    }
 5346: 
 5347: 
 5348:       // Computes element's kb as the minimum of the nodes' kb.
 5349:       const int kb1 = n1->kb;
 5350:       const int kb2 = n2->kb;
 5351:       const int kb3 = n3->kb;
 5352:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5353: 
 5354: 
 5355:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5356: 
 5357: 
 5358:       // Computes the element z as the mean of the nodes z.
 5359:       for (int k = elem->kb; k < nvrt; k++) {
 5360: 
 5361:          // Compute the element z as the mean of the nodes z.
 5362:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5363:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5364:          elem->z[k] /= elem->i34;
 5365: 
 5366:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5367:       }
 5368:                   
 5369:    }
 5370: 
 5371:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5372:    {
 5373:       NODE(node);
 5374:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5375: 
 5376:       if (it == iths) return;
 5377: 
 5378: 
 5379:       if(!node->isDry && node->tmp.b) { // rewetted
 5380:          for (int k=0; k < nvrt; k++) {
 5381: 
 5382:             Vector3 utmp={0.0, 0.0, 0.0};
 5383: 
 5384:             double ttmp=0.0;
 5385:             double stmp=0.0;
 5386:             int icount=0;
 5387:             for (int j = 0; j < node->numNodes; j++) {
 5388: 
 5389: 
 5390:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5391:                if (!node->isDry) { // all indices extended
 5392:                   icount++;
 5393: 
 5394:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5395:                   utmp += node->u2[k];
 5396:                   
 5397:                   ttmp += node->tracers[k].tracer[0]; 
 5398:                   stmp += node->tracers[k].tracer[1]; 
 5399:                }
 5400:             }
 5401: 
 5402:             if(icount > 0) {
 5403:                const double inv_icount = 1.0/icount;
 5404:                node->u2[k]     = inv_icount*utmp;
 5405:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5406:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5407:             }
 5408:          }
 5409:       }
 5410:    }
 5411: 
 5412: 
 5413:    __global__ void ul0UpdateSides(int it, int iths) {
 5414: 
 5415:       SIDE(side);
 5416: 
 5417:       // A side is wet if and only if at least one of its elements is wet.
 5418:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5419: 
 5420:       const Node *n1 = side->n1;
 5421:       const Node *n2 = side->n2;
 5422:       const int kb1 = n1->kb;
 5423:       const int kb2 = n2->kb;
 5424: 
 5425:       side->kb = 0; // dry
 5426: 
 5427:       if (isWet) {
 5428: 
 5429:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5430: 
 5431:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5432: 
 5433:          side->kb = min(kb1, kb2);
 5434: 
 5435:          for (int k = side->kb; k < nvrt; k++) {
 5436:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5437: 
 5438:          
 5439:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5440: 
 5441:             // Compute velocity for re-wetted sides 
 5442:             if ((it != iths) && (side->isDry && isWet)) {
 5443:             
 5444:                Vector2 utmp={0.0, 0.0};
 5445: 
 5446:                int icount=0;
 5447: 
 5448:                // For all the sides on the two elements that share this side
 5449:                for (int j=0; j < 2; j++) {
 5450:                   const Element *elem = side->elems[j];
 5451:                   if (elem == nullptr) continue;
 5452: 
 5453:                   for (int jj=0; jj < elem->i34; jj++) {
 5454:                      const Side *nSide = elem->sides[jj];
 5455:                      if (nSide->isDry) continue;
 5456: 
 5457:                      icount++;
 5458:                      utmp += nSide->u2[k];                     
 5459:                   }
 5460:                }
 5461:                   
 5462:                assert(icount > 0 && "No wet sides around this side");
 5463:                if (icount > 0)  side->u2[k] = utmp/icount;
 5464:                   
 5465:             } // if ((it != iths) && (side->isDry && isWet))
 5466: 
 5467:          } // for k
 5468: 
 5469:       } // if isWet
 5470:    
 5471:       side->isDry = !isWet;
 5472: 
 5473:    }
 5474: 
 5475: 
 5476:    __global__ void zeroNodalVelocities(void) {
 5477:       NODE(node);
 5478: 
 5479:       for (int k = 0; k < nvrt; k++) {
 5480:          node->u2[k]   = {0.0, 0.0, 0.0};
 5481:          node->utmp[k] = {0.0, 0.0};
 5482:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5483:       }
 5484:    }
 5485: 
 5486:    __global__ void computeNodalVerticalVelocities1(void) {
 5487:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5488:    // Adds the element's vertical velocity times the element's area.
 5489:       ELEM(elem);
 5490: 
 5491:       for (int j = 0; j < elem->i34; j++) {
 5492:          Node *node = elem->nodes[j];
 5493: 
 5494:          for (int k = node->kb; k < nvrt; k++) {
 5495:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5496:          }
 5497:          atomicAdd(&(node->tmp.d), elem->area);
 5498:       }
 5499:    }
 5500: 
 5501:    __global__ void computeNodalVerticalVelocities2(void) {
 5502:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5503:    // Divides by the total area of the elements sharing the    node.
 5504:       NODE(node);
 5505: 
 5506:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5507:    }
 5508: 
 5509: 
 5510:    __global__ void computeNodalHorizontalVelocities1(void) {
 5511:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5512:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5513: 
 5514:       ELEM(elem);
 5515: 
 5516:       const int kb = elem->kb;
 5517:       const bool isTri = elem->isTri();
 5518: 
 5519:       if constexpr(indvel <= 0) {
 5520:          // Assuming discontinoius hvel.
 5521: 
 5522: 
 5523:          if (isTri) { // For triangles
 5524:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5525:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5526: 
 5527:             for (int j = 0; j < 3; j++) {
 5528:                // For every node of the triangle...
 5529:                Node *node = elem->nodes[j];
 5530: 
 5531:                const Side *s1 = elem->sides[j];
 5532:                const Side *s2 = elem->sides[(j + 1) % 3];
 5533:                const Side *s3 = elem->sides[(j + 2) % 3];
 5534: 
 5535:                const int numElements = node->numElements;
 5536: 
 5537:                for (int k = kb; k < nvrt; k++)  {
 5538:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5539:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5540:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5541:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5542:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5543:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5544: 
 5545:                }
 5546: 
 5547:             }
 5548:          }
 5549:          else { // For quads
 5550: 
 5551:          }
 5552: 
 5553:       }
 5554:       
 5555:    }
 5556: 
 5557: 
 5558:    __global__ void computeNodalHorizontalVelocities2(void) {
 5559:       NODE(node);
 5560: 
 5561:       for (int k = 0; k < nvrt; k++) {
 5562:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5563:       }
 5564:       
 5565:    }   
 5566: 
 5567:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5568:    // XXXX I'm not sure where I got this function from. 
 5569:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5570:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5571:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5572:    // It uses the utmp array as a temporary array to store the velocities.
 5573: 
 5574:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5575: 
 5576:       SIDE(side);
 5577: 
 5578:       const int kb = side->kb;
 5579: 
 5580:       Node *n1 = side->n1;
 5581:       Node *n2 = side->n2;
 5582: 
 5583:       for (int k = kb; k < nvrt; k++) {
 5584: 
 5585:          // Cast the u2 vector into a Vector2 
 5586:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5587:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5588: 
 5589:          n1_u2 = side->u2[k]/n1->numSides;
 5590:          n2_u2 = side->u2[k]/n2->numSides;
 5591: 
 5592:       }
 5593: 
 5594: 
 5595:    }
 5596: 
 5597:    __global__ void resetVelocityOpenBndNodes(void) {
 5598:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5599: 
 5600:       NODE_BND(nodebnd);
 5601: 
 5602:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5603:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5604:       }
 5605: 
 5606:    }
 5607: 
 5608: 
 5609:    __global__ void setVelocityOpenBndNodes(void) {
 5610:    // For open boundary nodes sets their velocity to the imposed values.
 5611: 
 5612:       SIDE_BND(sidebnd);
 5613: 
 5614:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5615:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5616:          // to its segment to the average of the side velocity.
 5617: 
 5618:          for (int k = 0; k < nvrt; k++) {
 5619:             Node *n1 = sidebnd->side->n1;
 5620:             Node *n2 = sidebnd->side->n2;
 5621: 
 5622:             // Cast the u2 vector into a Vector2 
 5623:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5624:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5625: 
 5626:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5627:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5628:          }
 5629:       }
 5630: 
 5631:    }
 5632: 
 5633: 
 5634:    __global__ void computeVerticalVelocity(void) {
 5635:       // Computes the vertical velocity at the (2D) element's centroid.
 5636:       // In this function we will be considering volumetric elements, with side faces and a 
 5637:       // bottom and a top face. We will call them SFs, BF and TF.
 5638:       // It computes the flux coming from BF and the SFs.
 5639:       // If the bed is moving, it takes that into account.
 5640:       // Since water is incompressible, the integral of the velocity times the normal vector
 5641:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5642:       // and the BF is equal to the flux going out from the TF.
 5643:       // TF = - BF - sum(SFs).
 5644:       // It then computes the horizontal velocity at the center of TF.
 5645:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5646:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5647:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5648: 
 5649:       ELEM(elem);
 5650: 
 5651:       if (elem->isDry) return;
 5652: 
 5653:       const int kb = elem->kb;
 5654:       const bool isTri = elem->isTri();
 5655: 
 5656:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5657: 
 5658:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5659:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5660:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5661: 
 5662:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5663: 
 5664:       double area3D;
 5665: 
 5666:       // Bottom face flux
 5667:       double bottomFlux = 0.0;
 5668:       Vector2 u2meanBottom = {0.0, 0.0};
 5669:       const Vector2 gradh = elem->grad2(&Node::depth);
 5670:       if constexpr(imm==2) {
 5671:          Vector3 ubed;
 5672: 
 5673:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5674:          // updateBDEF(ubed);
 5675:      
 5676:          // const double bflux0 = dot(ubed, elem_n1);
 5677: 
 5678:          // elem->w[kb] += ubed.z;
 5679:       }
 5680:       else {
 5681:          Vector2 umean;
 5682:          if constexpr(ics == 1) {
 5683:             u2meanBottom = elem->mean(kb, &Side::u2);
 5684:          }
 5685:          else {
 5686:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5687:          }
 5688: 
 5689:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5690:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5691: 
 5692:          bottomFlux = - dot(gradh, u2meanBottom);
 5693:       } // if imm
 5694: 
 5695:       // Compute w for kb+1 to nvrt-1
 5696:       for (int l = kb; l < nvrt - 1; l++) {
 5697: 
 5698:          // normal vector to the top face of the "volumetric" element (3D)
 5699:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5700: 
 5701:          // Compute the total flux at the sides
 5702:          double sideFlux = 0.0;
 5703:          Vector2 u2top = {0.0, 0.0};
 5704:          for (int j = 0; j < elem->i34; j++) {
 5705:             const Side *side = elem->sides[j];
 5706: 
 5707:             const double sideArea = side->area(l);
 5708:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5709:             const double sign = elem->ssign[j]; 
 5710: 
 5711:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5712:          }
 5713:          
 5714:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5715:          //velocities at the centers of the sides
 5716:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5717: 
 5718:          // The flx at the top ace can be computed from the other flows.
 5719:          const double topFlux = - sideFlux - bottomFlux;
 5720:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5721: 
 5722:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5723: 
 5724:          elem_n1 = elem_n2;
 5725: 
 5726:          bottomFlux = - topFlux;
 5727:       }
 5728:    }  
 5729: 
 5730: 
 5731: 
 5732: 
 5733: 
