 7193: 
 7194: __global__ void computeMatrixProductAndDotProducts() {
 7195:    // Computes A*p, r'Mr and p'Ap
 7196: 
 7197:    // 1) shared buffer: first half for rMr, second for pAp
 7198:    __shared__ double sdata[2*BLOCK_SIZE];
 7199:    double* s_rMr = sdata;
 7200:    double* s_pAp = sdata + BLOCK_SIZE;
 7201: 
 7202:    const int tid = threadIdx.x;
 7203: 
 7204:    double l_pAp = 0.0;
 7205: 
 7206:    s_rMr[tid] = 0.0;
 7207:    s_pAp[tid] = 0.0;
 7208: 
 7209:    // 2) get your node pointer
 7210:    // NODE(node);   
 7211:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7212:    Node *node = &(mesh->localNodeData[idx_node]); 
 7213:       if (idx_node < mesh->np) {
 7214: 
 7215:       const double diag = node->coeffDiag;
 7216:       const double r    = node->mR;
 7217:       const double p    = node->mP;  
 7218: 
 7219:       // apply preconditioner on the fly:
 7220:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7221: 
 7222:       // 4) compute Ap = A.p
 7223:       double Ap = node->coeffDiag * node->mP;
 7224:       for (int j = 0; j < node->numNodes; ++j) {
 7225:          const Node *nbNode = node->nodes[j];
 7226:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7227: 
 7228:       }
 7229: 
 7230:       node->mAp = Ap;
 7231:       
 7232: 
 7233:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7234:       // const double l_rMr = r*Mr;  // r'Mr
 7235:       l_pAp = p*Ap;  // p'Ap
 7236: 
 7237: 
 7238:    }
 7239: 
 7240:    // 6) write into shared mem
 7241:    // s_rMr[tid] = l_rMr;
 7242:    s_pAp[tid] = l_pAp;
 7243: 
 7244:    __syncthreads();
 7245: 
 7246:    // 7) block-wide tree reduction
 7247:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7248:       if (tid < stride)  {
 7249:          s_pAp[tid] += s_pAp[tid + stride];
 7250:       }
 7251:       __syncthreads();
 7252:    }
 7253: 
 7254:    // 8) thread 0 atomically accumulates into the globals
 7255:    // XXX: This is slower than it needs to be, but it is simple and works
 7256:    if (tid == 0) {
 7257:       atomicAdd(pAp, s_pAp[0]);
 7258:    }
 7259: 
 7260: 
 7261: }
 7262: 
 7263: 
 7264: __global__ void updateSolutionAndDotProducts(void) {
 7265:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7266: 
 7267:    const int tid = threadIdx.x;
 7268: 
 7269:    s_rMr[tid] = 0.0;
 7270: 
 7271:    // get node & bounds-check:
 7272:    NODE(node);
 7273: 
 7274:    
 7275:    // Compute alpha
 7276:    const double alpha = (*rMr_old)/(*pAp); 
 7277: 
 7278: 
 7279:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7280: 
 7281: 
 7282:    // load scalars
 7283:    const double diag = node->coeffDiag;
 7284:    const double p    = node->mP;
 7285:    const double Ap   = node->mAp;
 7286:    const double x    = node->mX;
 7287:    const double r    = node->mR;
 7288:    
 7289:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7290: 
 7291:    // 1) update solution & residual
 7292:    const double x_new = x + alpha*p;
 7293:    const double r_new = r - alpha*Ap;
 7294:    node->mX = x_new;
 7295:    node->mR = r_new;
 7296: 
 7297:    // 2) apply Jacobi preconditioner on the fly
 7298:    const double Mr_new = r_new/diag;
 7299: 
 7300: 
 7301:    // 3) local contributions for the two dot-products
 7302:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7303: 
 7304:    // 4) write into shared-mem
 7305:    s_rMr[tid] = l_rMr;
 7306: 
 7307:    __syncthreads();
 7308: 
 7309: 
 7310:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7311:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7312:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7313:       __syncthreads();
 7314:    }
 7315: 
 7316:    // 6) thread 0 atomically folds into the global accumulators
 7317:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7318: 
 7319: 
 7320: }
 7321: 
 7322: 
 7323: __global__ void updateSearchDirection() {
 7324: 
 7325:     NODE(node);
 7326: 
 7327:     // recompute z on-the-fly
 7328:     const double z = node->mR / node->coeffDiag;
 7329:     const double p = node->mP;
 7330: 
 7331:     const double beta = (*rMr_new)/(*rMr_old);
 7332: 
 7333: 
 7334:     // p =z + beta*p
 7335:     node->mP = z + beta*p;
 7336: 
 7337: }
 7338: 
 7339: __global__ void initializeScalars(double *scalars) {
 7340: 
 7341:    // These point to a cupy array in the host code
 7342:    rMr_old = scalars + 0;
 7343:    rMr_new = scalars + 1;
 7344:    pAp     = scalars + 2;
 7345: }
 7346: 
 7347: __global__ void initializePreconditionedResidual(void) {
 7348: 
 7349:     __shared__ double s_rMr[BLOCK_SIZE];  
 7350: 
 7351:     s_rMr[threadIdx.x] = 0.0;
 7352: 
 7353:     NODE_ALL(node, valid);
 7354:     const int tid = threadIdx.x;
 7355:     // For the first iteration:
 7356:     // 1. Initial solution x = 0 (already set)
 7357:     // 2. Initial residual r = b (stored in qel)
 7358:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7359: 
 7360: // XXX we should use the guess solution here    
 7361: 
 7362:     double l_rMr = 0.0;
 7363:     if (valid) {
 7364:       // Set initial residual r = b (from qel)
 7365:       node->mR = node->qel;
 7366: 
 7367:       // Compute z = M^-1 * r (preconditioned residual)
 7368:       const double z = node->mR / node->coeffDiag;
 7369: 
 7370:       // Set initial search direction p = z
 7371:       node->mP = z;
 7372: 
 7373:       // Initialize other variables needed for CG
 7374:       node->mX = 0.0;  // Initial solution
 7375:       node->mAp = 0.0; // Will be computed in first iteration
 7376: 
 7377: 
 7378:       // Computes the first r'Mr (reduction)
 7379:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7380:     }
 7381:     // 4) write into shared-mem
 7382:     s_rMr[tid] = l_rMr;
 7383: 
 7384:     __syncthreads();
 7385: 
 7386: 
 7387:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7388:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7389:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7390:         __syncthreads();
 7391:     }
 7392: 
 7393:     // 6) thread 0 atomically folds into the global accumulators
 7394:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7395: 
 7396:     *rMr_old = 0.0;
 7397:     *pAp = 0.0;
 7398: }
 7399: 
 7400: 
