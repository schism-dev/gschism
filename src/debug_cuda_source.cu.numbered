 7238: 
 7239: __global__ void computeMatrixProductAndDotProducts() {
 7240:    // Computes A*p, r'Mr and p'Ap
 7241: 
 7242:    // 1) shared buffer: first half for rMr, second for pAp
 7243:    __shared__ double sdata[2*BLOCK_SIZE];
 7244:    double* s_rMr = sdata;
 7245:    double* s_pAp = sdata + BLOCK_SIZE;
 7246: 
 7247:    s_rMr[threadIdx.x] = 0.0;
 7248:    s_pAp[threadIdx.x] = 0.0;
 7249: 
 7250:    // 2) get your node pointer
 7251:    NODE(node);  
 7252:    const int tid = threadIdx.x;
 7253: 
 7254:    const double diag = node->coeffDiag;
 7255:    const double r    = node->mR;
 7256:    const double p    = node->mP;  
 7257: 
 7258:    // apply preconditioner on the fly:
 7259:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7260: 
 7261:    // 4) compute Ap = A.p
 7262:    double Ap = node->coeffDiag * node->mP;
 7263:    for (int j = 0; j < node->numNodes; ++j) {
 7264:       const Node *nbNode = node->nodes[j];
 7265:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7266: 
 7267:    }
 7268:    node->mAp = Ap;
 7269:     
 7270: 
 7271:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7272:    const double l_rMr = r*Mr;  // r'Mr
 7273:    const double l_pAp = p*Ap;  // p'Ap
 7274: 
 7275:    // 6) write into shared mem
 7276:    s_rMr[tid] = l_rMr;
 7277:    s_pAp[tid] = l_pAp;
 7278: 
 7279:    __syncthreads();
 7280: 
 7281:    // 7) block-wide tree reduction
 7282:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7283:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7284:       __syncthreads();
 7285:    }
 7286: 
 7287:    // 8) thread 0 atomically accumulates into the globals
 7288:    // XXX: This is slower than it needs to be, but it is simple and works
 7289:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7290: 
 7291: 
 7292: }
 7293: 
 7294: 
 7295: __global__ void updateSolutionAndDotProducts(void) {
 7296:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7297: 
 7298:    s_rMr[threadIdx.x] = 0.0;
 7299: 
 7300: 
 7301:    // get node & bounds-check:
 7302:    NODE(node);
 7303:    const int tid = threadIdx.x;
 7304: 
 7305: 
 7306:    // Compute alpha
 7307:    const double alpha = (*rMr_old)/(*pAp);
 7308: 
 7309:    // load scalars
 7310:    const double diag = node->coeffDiag;
 7311:    const double p    = node->mP;
 7312:    const double Ap   = node->mAp;
 7313:    const double x    = node->mX;
 7314:    const double r    = node->mR;
 7315:    
 7316:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7317: 
 7318:    // 1) update solution & residual
 7319:    const double x_new = x + alpha*p;
 7320:    const double r_new = r - alpha*Ap;
 7321:    node->mX = x_new;
 7322:    node->mR = r_new;
 7323: 
 7324:    // 2) apply Jacobi preconditioner on the fly
 7325:    const double Mr_new = r_new/diag;
 7326: 
 7327: 
 7328:    // 3) local contributions for the two dot-products
 7329:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7330: 
 7331:    // 4) write into shared-mem
 7332:    s_rMr[tid] = l_rMr;
 7333: 
 7334:    __syncthreads();
 7335: 
 7336: 
 7337:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7338:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7339:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7340:       __syncthreads();
 7341:    }
 7342: 
 7343:    // 6) thread 0 atomically folds into the global accumulators
 7344:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7345: 
 7346: 
 7347: }
 7348: 
 7349: 
 7350: __global__ void updateSearchDirection() {
 7351:     NODE(node);
 7352: 
 7353:     // recompute z on-the-fly
 7354:     const double z = node->mR / node->coeffDiag;
 7355:     const double p = node->mP;
 7356: 
 7357:     const double beta = (*rMr_new)/(*rMr_old);
 7358: 
 7359: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7360: 
 7361:     // p =z + beta*p
 7362:     node->mP = z + beta*p;
 7363: 
 7364: }
 7365: 
 7366: __global__ void initializePreconditionedResidual(double *scalars) {
 7367: 
 7368:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7369: 
 7370:     s_rMr[threadIdx.x] = 0.0;
 7371: 
 7372:     NODE(node);
 7373:     const int tid = threadIdx.x;
 7374:     // For the first iteration:
 7375:     // 1. Initial solution x = 0 (already set)
 7376:     // 2. Initial residual r = b (stored in qel)
 7377:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7378: 
 7379: // XXX we should use the guess solution here    
 7380: 
 7381:     // Set initial residual r = b (from qel)
 7382:     node->mR = node->qel;
 7383: 
 7384:     // Compute z = M^-1 * r (preconditioned residual)
 7385:     const double z = node->mR / node->coeffDiag;
 7386: 
 7387:     // Set initial search direction p = z
 7388:     node->mP = z;
 7389: 
 7390:     // Initialize other variables needed for CG
 7391:     node->mX = 0.0;  // Initial solution
 7392:     node->mAp = 0.0; // Will be computed in first iteration
 7393: 
 7394:     // These point to a cupy array in the host code
 7395:     rMr_old = scalars + 0;
 7396:     rMr_new = scalars + 1;
 7397:     pAp     = scalars + 2;
 7398: 
 7399:     // Computes the first r'Mr (reduction)
 7400:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7401: 
 7402:     // 4) write into shared-mem
 7403:     s_rMr[tid] = l_rMr;
 7404: 
 7405:     __syncthreads();
 7406: 
 7407: 
 7408:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7409:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7410:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7411:         __syncthreads();
 7412:     }
 7413: 
 7414:     // 6) thread 0 atomically folds into the global accumulators
 7415:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7416: 
 7417:     *rMr_old = 0.0;
 7418:     *pAp = 0.0;
 7419: }
