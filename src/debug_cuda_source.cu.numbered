  162: // VECTOR/POINT operations ---------------------------------------------------------------------------
  163: 
  164: using Vector2 = double2; 
  165: using Vector3 = double3;
  166: using Point2  = double2;
  167: using Point3  = double3;
  168: 
  169: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  170:     return make_double2(a.x + b.x, a.y + b.y);
  171: }
  172: 
  173: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  174:     a.x += b.x;
  175:     a.y += b.y;
  176:     return a;
  177: }
  178: 
  179: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  180:     return make_double2(a.x - b.x, a.y - b.y);
  181: }
  182: 
  183: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  184:     a.x -= b.x;
  185:     a.y -= b.y;
  186:     return a;
  187: }
  188: 
  189: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  190:     return make_double2(v.x * s, v.y * s);
  191: }
  192: 
  193: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  194:     return v * s;  // reuse the previous operator
  195: }
  196: 
  197: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  198:     return make_double2(v.x / s, v.y / s);
  199: }
  200: 
  201: __device__ __host__ __forceinline__ double norm2(const double2& v) {
  202:     return v.x*v.x + v.y*v.y;
  203: }
  204: 
  205: __device__ __host__ __forceinline__ double length(const double2& v) {
  206:     return sqrt(v.x*v.x + v.y*v.y);
  207: }
  208: 
  209: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  210:     return v / length(v);
  211: }
  212: 
  213: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  214:     return v.x*w.x + v.y*w.y;
  215: }
  216: 
  217: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  218:     return v.x*w.y - v.y*w.x;
  219: }
  220: 
  221: __device__ __host__ __forceinline__ double2 rot90(const double2& a) {
  222:     return make_double2(a.y, -a.x);
  223: }
  224: 
  225: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  226:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  227: }
  228: 
  229: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  230:     a.x += b.x;
  231:     a.y += b.y;
  232:     a.z += b.z;
  233:     return a;
  234: }
  235: 
  236: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  237:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  238: }
  239: 
  240: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  241:     return make_double3(v.x * s, v.y * s, v.z * s);
  242: }
  243: 
  244: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  245:     return v * s;
  246: }
  247: 
  248: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  249:     return make_double3(v.x / s, v.y / s, v.z / s);
  250: }
  251: 
  252: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  253:     return v.x*w.x + v.y*w.y + v.z*w.z;
  254: }
  255: 
  256: __device__ __host__ __forceinline__ double norm2(const double3& v) {
  257:     return v.x*v.x + v.y*v.y + v.z*v.z;
  258: }
  259: 
  260: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  261:     return make_double2(v.x, v.y);
  262: }
  263: 
  264: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  265:     return make_double3(v.x, v.y, w);
  266: }
  267: 
  268: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  269:     return make_double2(p.x, p.y);
  270: }
  271: 
  272: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  273:     return make_double3(p.x, p.y, z);
