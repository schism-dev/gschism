  793: struct Side {
  794: 
  795:    // Geometry information
  796:    int idx;               // Index of the side
  797:    Node *n1, *n2;
  798:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  799: 
  800:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  801:    Vector2 center;        // Location of side center. 
  802:    double zc[nvrt];       // Side center z-coord at each vertical level
  803: 
  804:    Frame frame;
  805: 
  806:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  807:                           // this is nullptr
  808:    
  809:    int kb;                // Bottom index of the side
  810:    bool isDry;             // True if the side is dry
  811:  
  812:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  813: 
  814:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  815: 
  816:    // Physical information
  817:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  818:    double  w2[nvrt];            // Vertical velocity at each vertical level
  819:    Vector2 btu[nvrt];           // Back-tracked velocity
  820:    Vector2 uth[nvrt];           // "Time history" velocity
  821:    Vector2 U;                   // Vertically averaged velocity vector  
  822: 
  823:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  824: 
  825:    Vector2 bcc[nvrt];           // Baroclinic term
  826:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  827: 
  828:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  829:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  830:    Vector2 gradPr;               // Gradient of pressure
  831:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  832: 
  833: 
  834:    double hhat;                 // \breve{H} in notes
  835: 
  836:    double shapiro;
  837: 
  838:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  839: 
  840:    double coriolis;             // Coriolis parameter
  841: 
  842:    // Vegetation parameters
  843:    double veg_c2;
  844:    double veg_beta;
  845: 
  846:    // Bottom drag parameters.
  847:    double chi;
  848:    double chi2;
  849: 
  850:    __inline__ __device__ double x(double t) const;
  851:    __inline__ __device__ double y(double t) const;
  852:    __inline__ __device__ Point2 p_t(double t) const;
  853: 
  854:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  855:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  856:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  857: 
  858:    __inline__ __device__ Side* neigh(int index) const { 
  859:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  860:       assert(index >= 0 && index < 4); 
  861:       assert(elems[0] != nullptr && elems[1] != nullptr);
  862: 
  863:       const int ielem = index & 1;           // 0 or 1
  864:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  865: 
  866:       const Element* elem = elems[ielem];
  867: 
  868:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  869: 
  870:       return elem->sides[elem->nxq(locSideIdx + iside)];
  871: 
  872:    }
  873: 
  874:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  875: 
  876:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  877: 
  878:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  879:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  880:    __inline__ __device__ int iadv(void) const;
  881: 
  882:    __inline__ __device__ double grav3(void) const;
  883:    
  884:    __inline__ __device__ double eta2(void) const;
  885:    __inline__ __device__ double eta1(void) const;
  886:    __inline__ __device__ double depth(void) const;
  887:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  888:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  889: 
  890:    __inline__ __device__ double dfv(int k) const;
  891: 
  892:    __inline__ __device__ double veg_h(void)  const;
  893:    __inline__ __device__ double veg_nv(void) const;
  894:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  895:    __inline__ __device__ double veg_alpha3D(int k) const;
  896:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  897: 
  898:    __inline__ __device__ double etaMeanBnd(void) const;
  899: 
  900:    __inline__ __device__ double Cd(void) const;
  901: 
  902:    __inline__ __device__ Vector2 tau(void) const;
  903: 
  904:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  905:    
  906: 
  907:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  908:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  909:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  910:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  911:    } 
  912:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  913:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  914:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  915:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  916: 
  917:    // Get valid starting element (for backtracking)
  918:    __inline__ __device__ Element* getStartElement() {
  919:       return elems[0] ? elems[0] : elems[1];
  920:    }
  921: 
  922:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  923:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  924: 
  925:       // If one of the elements is null, return the other one
  926:       if      (elems[0] == nullptr) return elems[1];
  927:       else if (elems[1] == nullptr) return elems[0];
  928: 
  929: 
  930:       // Dot product of the negative velocity vector with the side normal vector
  931:       const double dot_prod1 = -dot(u, n);
  932:       
  933:       // Vector from side center to element 0 centroid
  934:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  935: 
  936:       // Dot product of the vector with the side normal vector
  937:       const double dot_prod2 = dot(v2, n);
  938: 
  939:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  940:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  941: 
  942:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  943:       else                           return elems[1];
  944: 
  945:  
  946:    }
  947: 
  948:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  949:       // Given an element, returns the other element that shares this side
  950:       return (elems[0] == elem) ? elems[1] : elems[0];
  951:    }
  952: 
  953:    __forceinline__ __device__ Node* otherNode(Node* node) {
  954:       // Given a node, returns the other node that shares this side
  955:       return (n1 == node) ? n2 : n1;
  956:    }
  957:  
  958:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  959: 
  960: 
  961: 
  962: 
  963: };
  964: 
  965: 
  966: // This struct is used to store the boundary information for a node.
  967: struct NodeBoundary {   
  968:    BoundarySegment *segment;
  969:    Node *node;
  970:    
  971:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  972:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  973: 
  974:    double etaic;  // Elevation at nodes used for essential boundary conditions
  975:    double elbc;   // Elevation boundary condition
  976:    int iettype;   // Type of elevation boundary condition
  977:    double eth;    // Elevation time history
  978: 
  979:    double eta_mean; // Mean elevation at nodes
  980: 
  981:    bool isEssentialBC;
  982: 
  983: 
  984:    // Arrays for harmonic constituents (if needed)
  985:    double emo[nbfr];  // Elevation amplitude
  986:    double efa[nbfr];  // Elevation phase
  987:    double umo[nbfr];  // U-velocity amplitude
  988:    double ufa[nbfr];  // U-velocity phase
  989:    double vmo[nbfr];  // V-velocity amplitude
  990:    double vfa[nbfr];  // V-velocity phase 
  991: 
  992:    
  993:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  994:       assert(index == 0 || index == 1); 
  995:       return (index == 0) ? sideBnd1 : sideBnd2; 
  996:    }
  997: 
  998: 
  999: };
