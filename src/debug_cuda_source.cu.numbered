 2241: 
 2242: 
 2243: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2244: 
 2245:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2246:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2247:    const Node *n1 = side->n1;
 2248:    const Node *n2 = side->n2;
 2249: 
 2250:    bool n1_match = (n1->nodeBnd->segment == segment);
 2251:    bool n2_match = (n2->nodeBnd->segment == segment);
 2252: 
 2253:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2254:    if (n1_match && n2_match) {
 2255:       return 0.5;
 2256:    } else if (n1_match) {
 2257:       return 1.0;
 2258:    } else if (n2_match) {
 2259:       return 0.0;
 2260:    }
 2261:    return 0.0;
 2262: }
 2263: 
 2264: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2265: 
 2266: 
 2267: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2268: 
 2269:    const double w1 = getBoundaryArrayValueWeight();
 2270:    const double w2 = 1.0 - w1;
 2271:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2272:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2273: 
 2274:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2275: }
 2276: 
 2277: 
 2278: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2279:    const double w1 = getBoundaryArrayValueWeight();
 2280:    const double w2 = 1.0 - w1;
 2281:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2282:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2283: 
 2284:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2285: }
