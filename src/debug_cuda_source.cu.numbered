  487: 
  488: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  489: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  490: //
  491: 
  492:    const double radius2 = dot(p, p);
  493:    const double radius = sqrt(radius2);
  494:  
  495:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  496:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  497: 
  498:    rlon = atan2(p.y, p.x); // (-pi,pi]
  499: 
  500:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  501:       rlat = asin(p.z/radius);
  502:    } else {
  503:       rlat = asin(p.z/rearth_pole);
  504:    }
  505:   
  506: }
  507: 
  508: 
  509: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  510: // Compute the 3D Cartesian coordinates from the latitude and longitude
  511: // Inputs:
  512: //        lat: latitude in radians
  513: //        lon: longitude in radians
  514: // Output:
  515: //        x, y, z: 3D Cartesian coordinates
  516: 
  517:    double sin_lat, cos_lat, sin_lon, cos_lon;
  518: 
  519:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  520:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  521: 
  522:    sincos(lat, &sin_lat, &cos_lat);
  523:    sincos(lon, &sin_lon, &cos_lon);
  524: 
  525:    const double x = rearth_eq*cos_lat*cos_lon;
  526:    const double y = rearth_eq*cos_lat*sin_lon;
  527:    const double z = rearth_pole*sin_lat;
  528: 
  529:    return make_double3(x, y, z);
  530: }
  531: 
  532: __inline__ __device__ void Error(const char* msg) {
  533:    printf("Error: %s\n", msg);
  534:    assert(false);
  535: }
