  374: 
  375: 
  376: struct Frame {
  377:    double _t[9]; // t stands for tensor.
  378: 
  379:    // Access the tensor in Fortran order
  380:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  381: 
  382:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  383: 
  384:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  385: 
  386:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  387:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  388:       sincos(ar2, &sin_ar2, &cos_ar2);
  389: 
  390:       t(0,0) = -sin_ar1;
  391:       t(1,0) =  cos_ar1;
  392:       t(2,0) =  0.0;
  393:       t(0,1) = -cos_ar1*sin_ar2;
  394:       t(1,1) = -sin_ar1*sin_ar2;
  395: 
  396:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  397: 
  398:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  399:       assert (ar4!=0.0 && "GRID: ar4=0");
  400: 
  401:       const double ar4_inv = 1.0/ar4;
  402:       t(0,1) = t(0,1)*ar4_inv;
  403:       t(1,1) = t(1,1)*ar4_inv;
  404:       t(2,1) = t(2,1)*ar4_inv;
  405: 
  406:       // The third vector is the cross product of the first two
  407:       crossProduct(t(0,0), t(1,0), t(2,0), 
  408:                    t(0,1), t(1,1), t(2,1), 
  409:                    t(0,2), t(1,2), t(2,2));
  410:    }
  411: 
  412: 
  413:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  414:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  415:    // Inputs:
  416:    //        vec0: vel. in this frame;
  417:    //        frameout: Output frame;
  418:    // Output: 
  419:    //        vec1: vel. in new frame  
  420: 
  421:       auto const fo = frameout;
  422:       Vector2 vec1;
  423: 
  424:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  425:       // of t and fo.t are the same.
  426:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  427:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  428: 
  429:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  430:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  431: 
  432:       return vec1;
  433:    }
  434: 
  435:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  436:       // Transform a vector from global to local frame
  437:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  438:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  439:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  440:    }
  441: 
  442:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  443:       // Transform a vector from local to global frame
  444:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  445:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  446:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  447:    }   
  448: 
  449:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  450:    // Tranforms a point from global to local frame     
  451:       G2L(pi - origin0, po);
  452:    }
  453: 
  454:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  455:    // Transforms a point from local to global frame      
  456:       L2G(pi, po);
  457:       po = po + origin0;
  458:    }
  459: 
  460: };
