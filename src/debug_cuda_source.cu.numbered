 9986: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9987:    Node *nodes = mesh->localNodeData;
 9988: 
 9989:    *addr = nodes;
 9990:    *sizeNode = sizeof(Node);
 9991: 
 9992:    switch (varCode) {
 9993:       case (int)VarCode::depth:
 9994:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9995:          *sizeType = sizeof(double);
 9996:          break;
 9997:       case (int)VarCode::eta:
 9998:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9999:          *sizeType = sizeof(double);
10000:          break;
10001:       case (int)VarCode::x:
10002:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
10003:          *sizeType = sizeof(Vector2);
10004:          break;
10005:       case (int)VarCode::z:
10006:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
10007:          *sizeType = sizeof(double);
10008:          break;
10009:       case (int)VarCode::kb:
10010:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
10011:          *sizeType = sizeof(int);
10012:          break;
10013:       case (int)VarCode::isdry:
10014:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
10015:          *sizeType = sizeof(int);
10016:          break;         
10017:       case (int)VarCode::w:
10018:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
10019:          *sizeType = sizeof(double);
10020:          break;
10021:       case (int)VarCode::u:
10022:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
10023:          *sizeType = sizeof(Vector2);
10024:          break;  
10025:       case (int)VarCode::u_air:
10026:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
10027:          *sizeType = sizeof(Vector2);
10028:          break;
10029:       default:
10030:          *offset = -1;    
10031:    }  
10032:    
10033: }
