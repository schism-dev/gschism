 5743:    __global__ void resetVelocityOpenBndNodes(void) {
 5744:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5745: 
 5746:       NODE_BND(nodebnd);
 5747: 
 5748:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5749:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5750:       }
 5751: 
 5752:    }
 5753: 
 5754: 
 5755:    __global__ void setVelocityOpenBndNodes(void) {
 5756:    // For open boundary nodes sets their velocity to the imposed values.
 5757: 
 5758:       SIDE_BND(sidebnd);
 5759: 
 5760:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5761:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5762:          // to its segment to the average of the side velocity.
 5763: 
 5764:          for (int k = 0; k < nvrt; k++) {
 5765:             Node *n1 = sidebnd->side->n1;
 5766:             Node *n2 = sidebnd->side->n2;
 5767: 
 5768:             // Cast the u2 vector into a Vector2 
 5769:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5770:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5771: 
 5772:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5773:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5774:          }
 5775:       }
 5776: 
 5777:    }
 5778: 
 5779: 
 5780:    __global__ void computeVerticalVelocity(void) {
 5781:       // Computes the vertical velocity at the (2D) element's centroid.
 5782:       // In this function we will be considering volumetric elements, with side faces and a 
 5783:       // bottom and a top face. We will call them SFs, BF and TF.
 5784:       // It computes the flux coming from BF and the SFs.
 5785:       // If the bed is moving, it takes that into account.
 5786:       // Since water is incompressible, the integral of the velocity times the normal vector
 5787:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5788:       // and the BF is equal to the flux going out from the TF.
 5789:       // TF = - BF - sum(SFs).
 5790:       // It then computes the horizontal velocity at the center of TF.
 5791:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5792:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5793:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5794: 
 5795:       ELEM(elem);
 5796: 
 5797:       if (elem->isDry) return;
 5798: 
 5799:       const int kb = elem->kb;
 5800:       const bool isTri = elem->isTri();
 5801: 
 5802:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5803: 
 5804:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5805:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5806:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5807: 
 5808:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5809: 
 5810:       double area3D;
 5811: 
 5812:       // Bottom face flux
 5813:       double bottomFlux = 0.0;
 5814:       Vector2 u2meanBottom = {0.0, 0.0};
 5815:       const Vector2 gradh = elem->grad2(&Node::depth);
 5816:       if constexpr(imm==2) {
 5817:          Vector3 ubed;
 5818: 
 5819:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5820:          // updateBDEF(ubed);
 5821:      
 5822:          // const double bflux0 = dot(ubed, elem_n1);
 5823: 
 5824:          // elem->w[kb] += ubed.z;
 5825:       }
 5826:       else {
 5827:          Vector2 umean;
 5828:          if constexpr(ics == 1) {
 5829:             u2meanBottom = elem->mean(kb, &Side::u2);
 5830:          }
 5831:          else {
 5832:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5833:          }
 5834: 
 5835:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5836:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5837: 
 5838:          bottomFlux = - dot(gradh, u2meanBottom);
 5839:       } // if imm
 5840: 
 5841:       // Compute w for kb+1 to nvrt-1
 5842:       for (int l = kb; l < nvrt - 1; l++) {
 5843: 
 5844:          // normal vector to the top face of the "volumetric" element (3D)
 5845:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5846: 
 5847:          // Compute the total flux at the sides
 5848:          double sideFlux = 0.0;
 5849:          Vector2 u2top = {0.0, 0.0};
 5850:          for (int j = 0; j < elem->i34; j++) {
 5851:             const Side *side = elem->sides[j];
 5852: 
 5853:             const double sideArea = side->area(l);
 5854:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5855:             const double sign = elem->ssign[j]; 
 5856: 
 5857:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5858: printf("idx = %d, l = %d, sideFlux = %f, u2c = %f,%f, side->len = %f, zc = %f, %f, sideArea = %f\n", side->idx, l, sideFlux, u2c.x, u2c.y, side->len, side->zc[l], side->zc[l + 1], sideArea);            
 5859:          }
 5860:          
 5861:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5862:          //velocities at the centers of the sides
 5863:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5864: 
 5865:          // The flx at the top ace can be computed from the other flows.
 5866:          const double topFlux = - sideFlux - bottomFlux;
 5867:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5868: 
 5869:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5870: printf("idx = %d, l = %d, sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", elem->idx, l, sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5871: 
 5872: 
 5873:          elem_n1 = elem_n2;
 5874: 
 5875:          bottomFlux = - topFlux;
 5876:       }
 5877:    }  
 5878: 
 5879: 
 5880: 
 5881: 
 5882: 
