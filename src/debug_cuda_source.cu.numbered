  703:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  704:                                         double& tIntersect);
  705: 
  706:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  707:       // Check if the point (xt,yt) is inside the element
  708:       double shpCoords[4];
  709: 
  710:       bool res = computeShapeCoords(xt, shpCoords, false);
  711: 
  712:       return res;
  713:    }
  714: 
  715:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  716:       // Check if the point (xt,yt) is inside the element.
  717:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  718:       double shpCoords[4];
  719: 
  720:       Vector2 tmp_xt = xt;
  721:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  722: 
  723:       if (fixCoords && res) xt = tmp_xt;
  724: 
  725:       return res;
  726:    }
  727: 
  728:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  729:    {
  730:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  731:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  732:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  733:       
  734:    }
  735: 
  736:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  737: 
  738:    // ------------------------------------------------------------------------------------------------
  739:    // These are functions that work on all nodes of the element.
  740:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  741:    //
  742:    // An example of how to use these functions is:
  743:    //   
  744:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  745:    // 
  746:    // Where L is the level at which the field is to be interpolated. The field can be either
  747:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  748:    // There are different versions of getNodalValues for each of these cases.
  749: 
  750:    template<typename T>
  751:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  752:       // Get the values of the field at the nodes of the element
  753:       res[0] = nodes[0]->*field;
  754:       res[1] = nodes[1]->*field;
  755:       res[2] = nodes[2]->*field;
  756:       if (isQuad()) res[3] = nodes[3]->*field;
  757:       else          res[3] = T();
  758:    }
  759: 
  760:    template<typename T>
  761:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  762:       // Get the values of the field at the nodes of the element
  763:       res[0] = (nodes[0]->*field)[level];
  764:       res[1] = (nodes[1]->*field)[level];
  765:       res[2] = (nodes[2]->*field)[level];
  766:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  767:       else          res[3] = T();
  768:    }    
  769: 
  770:    template<typename T>
  771:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  772:       // Get the values of the func at the nodes of the element
  773:       res[0] = (nodes[0]->*func)(level);
  774:       res[1] = (nodes[1]->*func)(level);
  775:       res[2] = (nodes[2]->*func)(level);
  776:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  777:       else          res[3] = T();  // This is 0.0 or a zero vector
  778: 
  779:    }      
  780: 
  781:    template<typename T>
  782:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  783:       // Get the values of the field at the nodes of the element
  784:       res[0] = sides[0]->*field;
  785:       res[1] = sides[1]->*field;
  786:       res[2] = sides[2]->*field;
  787:       if (isQuad()) res[3] = sides[3]->*field;
  788:       else          res[3] = T();
  789:    }
  790: 
  791:    template<typename T>
  792:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  793:       // Get the values of the field at the nodes of the element
  794:       res[0] = (sides[0]->*field)[level];
  795:       res[1] = (sides[1]->*field)[level];
  796:       res[2] = (sides[2]->*field)[level];
  797:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  798:       else          res[3] = T();
  799:    }    
  800: 
  801:    template<typename T>
  802:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  803:       // Get the values of the func at the nodes of the element
  804:       res[0] = (sides[0]->*func)(level);
  805:       res[1] = (sides[1]->*func)(level);
  806:       res[2] = (sides[2]->*func)(level);
  807:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  808:       else          res[3] = T();  // This is 0.0 or a zero vector
  809: 
  810:    }      
  811: 
  812:    template<typename T>
  813:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  814:       T values[4];
  815:       getNodalValues(level, func, values);
  816: 
  817:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  818:    }
  819: 
  820:    template<typename T>
  821:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  822:       T values[4];
  823:       getNodalValues(field, values);
  824:       
  825:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  826:    }
  827: 
  828: 
  829:    template<typename T>
  830:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  831:       T values[4];
  832:       getNodalValues(level, field, values);
  833: 
  834:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  835:    }
  836: 
  837:    template<typename T>
  838:    __device__ T mean(T Node::* field) const {
  839:       T values[4];
  840:       getNodalValues(field, values);
  841: 
  842:       return (values[0] + values[1] + values[2] + values[3])/i34;
  843:    }
  844: 
  845:    template<typename T>
  846:    __device__ T mean(T Side::* field) const {
  847:       T values[4];
  848:       getSideValues(field, values);
  849:       
  850:       return (values[0] + values[1] + values[2] + values[3])/i34;
  851:    }   
  852: 
  853:    template<typename T>
  854:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  855:       T values[4];
  856:       getNodalValues(level, field, values);
  857: 
  858:       return (values[0] + values[1] + values[2] + values[3])/i34;
  859:    }
  860: 
  861:    template<typename T>
  862:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  863:       T values[4];
  864:       getSideValues(level, field, values);
  865:       
  866:       return (values[0] + values[1] + values[2] + values[3])/i34;
  867:    }   
  868: 
  869:    // __device__ double mean(double (Node::*func)(int) const) const {
  870:    //    double values[4];
  871:    //    getNodalValues(level, func, values);
  872:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  873:    // }
  874:    // ------------------------------------------------------------------------------------------------
  875: 
  876:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
