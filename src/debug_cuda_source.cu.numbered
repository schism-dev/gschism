 1814: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1815: return;   
 1816:    // Lock the mutex
 1817:    lock(&debugPlotMutex);
 1818:  
 1819:    bool ok = true;
 1820:    if (debugPlotIdx == nullptr) ok = false;
 1821:    if (*debugPlotIdx >= 10000) ok = false;
 1822:    if (ok) {
 1823:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1824:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1825:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1826:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1827:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1828:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1829:       (*debugPlotIdx)++;
 1830:    }
 1831: 
 1832:    __threadfence();               // ensure all above writes are visible
 1833:    // Unlock the mutex
 1834:    unlock(&debugPlotMutex);
 1835: 
 1836: }
