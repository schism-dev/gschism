 3570: __device__ __forceinline__ int Node::localIndex() const {
 3571:    // Returns the local index of the node in the partition
 3572:    // Local index is just the offset from the start of the partition's node memory
 3573:    return int(this - mesh->nodes[part]);
 3574: }
 3575: 
 3576: 
 3577: __device__ __forceinline__ int Node::packedIndex() const {
 3578:    // Returns the packed index of the node
 3579:    // Packed index is the index of the partition-block matrices and vectors.
 3580:    return nodeOffsetPerPartition[part] + localIndex();
 3581: }
