 3718: 
 3719: 
 3720: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3721: 
 3722: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3723: 
 3724:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3725:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3726: 
 3727: 
 3728: 
 3729:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3730:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3731: 
 3732:    double fun_lat = 0.0;
 3733:    switch (jspc[idxComp]) {
 3734:       case 0:
 3735:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3736:          break;
 3737:       case 1:
 3738:          fun_lat = sin(2.0*lat);
 3739:          break;
 3740:       case 2:
 3741:          fun_lat = pow<2>(cos(lat));
 3742:          break;
 3743:       default:
 3744:          assert(false && "computeETP: invalid jspc");
 3745:    }
 3746:    
 3747:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3748: 
 3749: }
 3750: 
 3751: 
 3752: __device__ void Node::updateKb(void) {
 3753: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3754: 
 3755:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3756: 
 3757: 
 3758:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3759: 
 3760:    if constexpr(ivcor == 2) {  // SZ coordinates
 3761:       
 3762:       // Compute bottom level index
 3763:       if (depth <= mesh->h_s) {
 3764:          kb = izlev;   
 3765:          
 3766:       } else {
 3767:          kb = -1;
 3768:          int L = 0;
 3769:          int R = nzlev; 
 3770:          
 3771:          while (L <= R) {
 3772:             int M = (R + L) / 2;
 3773: 
 3774: 
 3775:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3776:             
 3777:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3778:                R = M;
 3779:             } else {
 3780:                L = M;
 3781:             }
 3782: 
 3783:             if (R - L == 1) {
 3784:                kb = L;
 3785:                break;
 3786:             }
 3787:          }
 3788: 
 3789:          // Checks that the binary search was successful
 3790:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3791:        
 3792:       }
 3793:    } 
 3794: }
