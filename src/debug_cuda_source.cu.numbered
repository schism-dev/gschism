  310: // ------------------------------------------------------------------------------------------------
  311: 
  312: 
  313: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  314:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  315:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  316: }
  317: 
  318: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  319:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  320:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  321: }
  322: 
  323: 
  324: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  325:    x3 = y1*z2 - y2*z1;
  326:    y3 = x2*z1 - x1*z2;
  327:    z3 = x1*y2 - x2*y1;
  328: }
  329: 
  330: 
  331: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  332: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  333: 
  334:    const double radius2 = dot(p, p);
  335:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  336:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  337: 
  338:    rlon = atan2(p.y, p.x); // (-pi,pi]
  339: 
  340:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  341:       rlat = asin(p.z/sqrt(radius2));
  342:    } else {
  343:       rlat = asin(p.z/rearth_pole);
  344:    }
  345:   
  346: }
  347: 
  348: __inline__ __device__ void Error(const char* msg) {
  349:    printf("Error: %s\n", msg);
  350:    assert(false);
  351: }
  352: 
  353: struct Tracers {
  354:     double tracer[N_TRACERS];
  355: };
  356: 
  357: 
  358: 
  359: struct Frame {
  360:    double _t[9]; // t stands for tensor.
  361: 
  362:    // Access the tensor in Fortran order
  363:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  364: 
  365:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  366: 
  367:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  368: 
  369:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  370:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  371:       sincos(ar2, &sin_ar2, &cos_ar2);
  372: 
  373:       t(0,0) = -sin_ar1;
  374:       t(1,0) =  cos_ar1;
  375:       t(2,0) =  0.0;
  376:       t(0,1) = -cos_ar1*sin_ar2;
  377:       t(1,1) = -sin_ar1*sin_ar2;
  378: 
  379:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  380: 
  381:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  382:       assert (ar4!=0.0 && "GRID: ar4=0");
  383: 
  384:       const double ar4_inv = 1.0/ar4;
  385:       t(0,1) = t(0,1)*ar4_inv;
  386:       t(1,1) = t(1,1)*ar4_inv;
  387:       t(2,1) = t(2,1)*ar4_inv;
  388: 
  389:       // The third vector is the cross product of the first two
  390:       crossProduct(t(0,0), t(1,0), t(2,0), 
  391:                    t(0,1), t(1,1), t(2,1), 
  392:                    t(0,2), t(1,2), t(2,2));
  393:    }
  394: 
  395: 
  396:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  397:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  398:    // Inputs:
  399:    //        vec0: vel. in this frame;
  400:    //        frameout: Output frame;
  401:    // Output: 
  402:    //        vec1: vel. in new frame  
  403: 
  404:       auto const fo = frameout;
  405:       Vector2 vec1;
  406: 
  407:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  408:       // of t and fo.t are the same.
  409:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  410:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  411: 
  412:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  413:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  414: 
  415:       return vec1;
  416:    }
  417: 
  418:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  419:       // Transform a vector from global to local frame
  420:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  421:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  422:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  423:    }
  424: 
  425:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  426:       // Transform a vector from local to global frame
  427:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  428:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  429:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  430:    }   
  431: 
  432:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  433:    // Tranforms a point from global to local frame     
  434:       G2L(pi - origin0, po);
  435:    }
  436: 
  437:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  438:    // Transforms a point from local to global frame      
  439:       L2G(pi, po);
  440:       po = po + origin0;
  441:    }
  442: 
  443: };
