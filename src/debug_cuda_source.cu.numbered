 1597:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1598:       // Compute the different time ramps used in the code 
 1599:       // This function is performed by just one thread
 1600: 
 1601:       if constexpr(ibc == 0) {
 1602:          if (drampbc > 0.0) {
 1603:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1604:          } else {
 1605:             rampbc = 1.0;
 1606:          }
 1607: 
 1608:          if (nws != 0 && drampwind > 0.0) {
 1609:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1610:          } else {
 1611:             rampwind = 1.0;
 1612:          }
 1613:       }
 1614: 
 1615:       if (drampwafo > 0.0) {
 1616:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1617:       } else {
 1618:          rampwafo = 1.0;
 1619:       }
 1620: 
 1621:       // For source/sinks
 1622:       if (if_source && dramp_ss > 0.0) {
 1623:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1624:       } else {
 1625:          ramp_ss = 1.0;
 1626:       }
 1627: 
 1628:       if (dramp > 0.0) {
 1629:          ramp = tanh(2.0*time/86400.0/dramp);
 1630:       } else {
 1631:          ramp = 1.0;
 1632:       }
 1633: 
 1634:    }
