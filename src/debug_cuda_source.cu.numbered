 1767: 
 1768: // Helper functions for computing the local node index at a given offset from another.
 1769: __device__ __inline__ int nxq(int offset, int index, int size) {
 1770:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1771:    // to the index to make it positive
 1772:    assert(index + offset + 16*size >= 0);
 1773:    return (index + offset + 16*size) % size;  
 1774: }
 1775: 
 1776: __device__ __inline__ int nxq(int index, int size) {
 1777:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1778:    // to the index to make it positive
 1779:    assert(index + 16*size >= 0);
 1780:    return (index + 16*size) % size; 
 1781: }
