 3532: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3533:    if constexpr(ics == 1) {
 3534:       return center;
 3535: 
 3536:    } else {
 3537:       const Point2 p0 = n1->outputCoords();
 3538:       const Point2 p1 = n2->outputCoords();
 3539:       return (1.0/2.0)*(p0 + p1);
 3540: 
 3541:    }
 3542: }
 3543: 
 3544: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3545: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3546: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3547: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3548: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3549: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3550: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3551: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3552: // Computes the gradient of the field at the side center.
 3553:    Vector2 grad = {0.0, 0.0};
 3554:    int count = 0;
 3555: 
 3556:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3557:    // as the average of the gradients at each element.
 3558:    // First element
 3559:    if (elems[0] != nullptr && condition(elems[0])) {
 3560:       Vector2 elemGrad = elems[0]->grad2(field);
 3561: 
 3562:       // For ics=2, projects the element gradient from its frame to the side frame
 3563:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3564: 
 3565:       grad += elemGrad;
 3566: 
 3567:       count++;
 3568:    }
 3569: 
 3570:    // Second element
 3571:    if (elems[1] != nullptr && condition(elems[1])) {
 3572: 
 3573:       Vector2 elemGrad = elems[1]->grad2(field);
 3574: 
 3575:       // For ics=2, projects the element gradient from its frame to the side frame
 3576:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3577: 
 3578:       grad += elemGrad;
 3579: 
 3580:       count++;
 3581:    }
 3582: 
 3583:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3584:    if (count > 0) {
 3585:       grad = grad*(1.0/count);
 3586:    }
 3587:    
 3588:    return grad;
 3589: }
 3590: 
 3591: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3592: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3593: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3594: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3595: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3596: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3597: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3598: 
 3599: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3600: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3601: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3602: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3603: 
 3604: 
 3605: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3606: 
 3607: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3608:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3609:    if constexpr(ics == 1) { 
 3610:       return 0.5*(n1->tau + n2->tau);
 3611: 
 3612:    } else {
 3613:       // Project the tau from the node frames to the side frame
 3614:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3615:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3616: 
 3617:       return 0.5*(stau1 + stau2);
 3618:    }
 3619: }
 3620: 
 3621: /**
 3622:  * This method performs backtracking from the side center until a time -dt back in time 
 3623:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3624:  * intermediate point.
 3625:  *
 3626:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3627:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3628:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3629:  * remaining time.
 3630:  * 
 3631:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3632:  * 
 3633:  * @param uuint, vvint, wwint: Velocities at the final point
 3634:  * @param jlev: Level at which the backtracking is performed
 3635:  * @param dt, dtbk: Tracking timesteps
 3636:   */
 3637: __inline__ __device__ void Side::btrack(
 3638:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3639:       double dt,            // Tracking time
 3640:       double dtbk,          // Tracking timestep
 3641:       Vector3 &u_int        // Velocities at the initial point
 3642: ) const {
 3643: 
 3644:    // Start from side center
 3645:    Point3 x0;
 3646: 
 3647:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3648:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3649: 
 3650:  
 3651:    double time_rm = dt; // Remaining time
 3652:    double time_rm_1 = 1e10;
 3653:    double time_rm_2 = 2e10;
 3654:    double time_rm_3 = 3e10;
 3655: 
 3656: 
 3657:    // Initial velocities
 3658:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3659: 
 3660:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3661:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3662: 
 3663:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3664: 
 3665: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3666: 
 3667: 
 3668:    constexpr int MAX_ITERATIONS = 100; 
 3669:    int iter = 0;
 3670:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3671:    while(true) {
 3672: 
 3673:       // Calculate timestep
 3674:       const double dtb = min(dtbk, time_rm);
 3675: 
 3676:       // Next point in the backtracking curve
 3677:       xt = x0 - dtb*u_int;
 3678: 
 3679:       double t, s; // parameters for the line segments p0pt and p1p2
 3680:       Side *lastCrossSide = nullptr;
 3681:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3682: 
 3683: 
 3684:       if (time_rm_3 <= time_rm) {
 3685:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3686:          xt = x0;
 3687:          break;
 3688:       }
 3689: 
 3690: 
 3691:       if (!found) {
 3692:       // This means that the walk reached a boundary or a dry element.
 3693: 
 3694:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3695: 
 3696:          // Finds the point at the boundary where the line segment x0xt intersects.
 3697:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3698:          // due to floating point errors, it does not exactly intersect.
 3699:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3700:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3701:          // To compute the intersection point we start with the parametric equations.
 3702:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3703:          // We cross-prouct by v1 to cancel the s term:
 3704:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3705:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3706: 
 3707:          // Side coordinates in the origSide frame.
 3708:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3709:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3710: 
 3711:          Point2  p0 = {x0.x, x0.y};
 3712:          Point2  pt = {xt.x, xt.y};
 3713: 
 3714:          const Vector2 v1 = pt - p0;
 3715:          const Vector2 v2 = p2 - p1;
 3716: 
 3717: 
 3718: 
 3719:          // We are assuming intersection, so we clamp t to the range [0,1].
 3720:          const double denom = cross(v2, v1);
 3721:          
 3722: 
 3723: 
 3724: 
 3725:          if (abs(denom) < small) {
 3726:             // small denominators are fairly common. They occur when the line segment x0xt 
 3727:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3728:             // boundary, where the backtracking curve startt sliding along the boundary.
 3729:             // In this case, we simply assume that the two lines are very close to each other
 3730:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3731:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3732:             if (t<0.0000000001) t = 0.0;
 3733:             if (t>0.9999999999) t = 1.0;
 3734: 
 3735:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3736:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3737: 
 3738:          }
 3739:          else {
 3740:             
 3741:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3742:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3743:             if (t>0.9999999999) t = 1.0;
 3744:             // From the originaL equation we can solve for s:
 3745:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3746:             // Computing the dot product by v1, we get:
 3747:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3748:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3749:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3750: 
 3751:          }
 3752: 
 3753:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3754: 
 3755: 
 3756:          // We update the new target point to be right at the intersection point,
 3757:          // and the remaining time must include the time we haven't "used".
 3758:          time_rm -= s*dtb;
 3759:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3760: 
 3761: 
 3762:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3763:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3764: 
 3765:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3766:          // but extracting only the component along the tangent vector v2.
 3767:          Vector2 tangent = normalize(v2);
 3768:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3769: 
 3770:          const Vector2 u2D = make_double2(u.x, u.y);
 3771:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3772: 
 3773: 
 3774:       } else {
 3775: 
 3776:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3777: 
 3778:          time_rm -= dtb; 
 3779: 
 3780:          u_int = curElem->interpolateVelocities(xt, this);
 3781: 
 3782:       }
 3783: 
 3784:       if (time_rm <= 0.0) break; 
 3785: 
 3786:       // If the velocity is too small, we stop the backtracking
 3787:       const double vmag2 = norm2(toVector2(u_int));
 3788:       if (vmag2 <= velmin_btrack_sq)  {
 3789:          time_rm = 0.0; 
 3790:          return; 
 3791:       }
 3792: 
 3793:       // The current point becomes the next segment's starting point.
 3794:       x0 = xt;
 3795:  
 3796:       iter++;
 3797: 
 3798: // XXXXXXXXXXXXXXXXX
 3799: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3800:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3801: 
 3802:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3803:       time_rm_3 = time_rm_2;
 3804:       time_rm_2 = time_rm_1;
 3805:       time_rm_1 = time_rm;
 3806:    }
 3807: 
 3808:    assert(curElem != nullptr && "Final element is nullptr");
 3809:    assert(!curElem->isDry && "Final element is dry");
 3810:    
 3811: 
 3812: 
 3813:    // Interpolate the velocities at the final point with respect to the current side frame
 3814:    u_int = curElem->interpolateVelocities(xt, this);
 3815: 
 3816: 
 3817: }
 3818: 
 3819: 
