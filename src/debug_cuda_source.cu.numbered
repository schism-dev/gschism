 7877: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7878:    Node *nodes = mesh->localNodeData;
 7879: 
 7880:    *addr = nodes;
 7881:    *sizeNode = sizeof(Node);
 7882: 
 7883:    switch (varCode) {
 7884:       case (int)VarCode::depth:
 7885:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7886:          *sizeType = sizeof(double);
 7887:          break;
 7888:       case (int)VarCode::eta:
 7889:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7890:          *sizeType = sizeof(double);
 7891:          break;
 7892:       case (int)VarCode::x:
 7893:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7894:          *sizeType = sizeof(Vector2);
 7895:          break;
 7896:       case (int)VarCode::z:
 7897:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7898:          *sizeType = sizeof(double);
 7899:          break;
 7900:       case (int)VarCode::kb:
 7901:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7902:          *sizeType = sizeof(int);
 7903:          break;
 7904:       case (int)VarCode::isdry:
 7905:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7906:          *sizeType = sizeof(int);
 7907:          break;         
 7908:       case (int)VarCode::w:
 7909:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7910:          *sizeType = sizeof(double);
 7911:          break;
 7912:       case (int)VarCode::u:
 7913:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7914:          *sizeType = sizeof(Vector2);
 7915:          break;         
 7916:       default:
 7917:          *offset = -1;    
 7918:    }  
 7919:    
 7920: }
 7921: 
 7922: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7923:    // Get the value of a variable from an element
 7924:    // varName is the name of the variable to get
 7925:    // var is the array to store the value
 7926:    // k is the vertical level index of the variable to get
 7927: 
 7928:    ELEM(elem);
 7929:    
 7930:    int idx = elem->idx;
 7931:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7932: 
 7933:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7934:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7935:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7936:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7937:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7938:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7939:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7940:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7941:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7942:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7943:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7944:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7945:       
 7946:    
 7947: }
 7948: 
 7949: 
 7950: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7951:    // Get the value of a variable from an node
 7952:    // varName is the name of the variable to get
 7953:    // var is the array to store the value
 7954:    // k is the vertical level index of the variable to get
 7955: 
 7956:    NODE(node);
 7957:    
 7958:    int idx = node->idx;
 7959:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7960: 
 7961:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7962:    
 7963:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7964:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7965:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7966:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7967:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7968:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7969:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7970:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7971:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7972:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7973:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7974:    
 7975:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7976:       
 7977:    
 7978: }
 7979: 
 7980: 
 7981: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7982:    // Get the value of a variable from an side
 7983:    // varName is the name of the variable to get
 7984:    // var is the array to store the value
 7985:    // k is the vertical level index of the variable to get
 7986:    SIDE(side);
 7987:    
 7988:    int idx = side->idx;
 7989:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7990: 
 7991:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7992:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7993:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7994:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7995:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7996:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7997:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7998:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7999:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8000:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8001:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8002:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8003:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8004:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8005:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8006:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8007:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8008:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 8009:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8010:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8011:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8012:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8013:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8014:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8015:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8016:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8017:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8018:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 8019:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8020:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8021:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8022:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8023:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8024:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8025:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8026:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8027:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8028: }
 8029: 
 8030: 
 8031: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8032:    // Get the value of a variable from an side
 8033:    // varName is the name of the variable to get
 8034:    // var is the array to store the value
 8035:    // k is the vertical level index of the variable to get
 8036:    SIDE_BND(sideBnd);   
 8037: 
 8038:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8039:    if (sideBnd->segment->isLand) idx = -7;
 8040: 
 8041:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8042:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8043: 
 8044: }
