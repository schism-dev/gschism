 2508:    
 2509:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2510:    // Project the vectors from the node frame to the element frame
 2511: 
 2512:  
 2513:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2514:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2515:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2516:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2517:       else          v[3] = Vector2();
 2518:    }
 2519: 
 2520:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2521:    // Project the vectors from the side frame to the element frame
 2522: 
 2523:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2524:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2525:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2526:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2527:       else          v[3] = Vector2();
 2528:    }
