 2231: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2232: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2233: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2234: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2235:    Vector2 grad = {0.0, 0.0};
 2236:    int count = 0;
 2237: 
 2238:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2239: 
 2240:    // First element
 2241:    if (elems[0] != nullptr && condition(elems[0])) {
 2242:       grad += elems[0]->grad2(field);
 2243:       count++;
 2244:    }
 2245: 
 2246:    // Second element
 2247:    if (elems[1] != nullptr && condition(elems[1])) {
 2248:       grad += elems[1]->grad2(field);
 2249:       count++;
 2250:    }
 2251: 
 2252:    if (count > 0) {
 2253:       grad = grad/count;
 2254:    }
 2255:    
 2256:    return grad;
 2257: }
