  332: 
  333: 
  334: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  335:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  336:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  337: }
  338: 
  339: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  340:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  341:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  342: }
  343: 
  344: 
  345: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  346:    x3 = y1*z2 - y2*z1;
  347:    y3 = x2*z1 - x1*z2;
  348:    z3 = x1*y2 - x2*y1;
  349: }
  350: 
  351: 
  352: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  353: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  354: 
  355:    const double radius2 = dot(p, p);
  356:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  357:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  358: 
  359:    rlon = atan2(p.y, p.x); // (-pi,pi]
  360: 
  361:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  362:       rlat = asin(p.z/sqrt(radius2));
  363:    } else {
  364:       rlat = asin(p.z/rearth_pole);
  365:    }
  366:   
  367: }
  368: 
  369: __inline__ __device__ void Error(const char* msg) {
  370:    printf("Error: %s\n", msg);
  371:    assert(false);
  372: }
