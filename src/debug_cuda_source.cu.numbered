 4551:    __global__ void scaleGravity(double loadtide_coef) {
 4552: 
 4553: 
 4554:       NODE(node);
 4555: 
 4556:       // SAL option: scale gravity
 4557:       if constexpr(iloadtide==2) {  // simple const
 4558:          node->grav2 = grav*(1.0 - loadtide_coef);
 4559: 
 4560:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4561:         
 4562:           const double depth = max(node->depth, 0.0);
 4563:           const double tmp1 = sqrt(depth);
 4564:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4565:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4566:                              2.6969e-13*depth*depth*depth*tmp1;
 4567:           
 4568:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4569:           
 4570: 
 4571: 
 4572:           node->grav2 = grav*(1.0 - beta_bar);
 4573: 
 4574:       } else {  // iloadtide=0,1
 4575:           node->grav2 = grav;
 4576: 
 4577:       }
 4578: 
 4579:    }
