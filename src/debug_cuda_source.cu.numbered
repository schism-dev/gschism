 6838: #ifdef DONTCOMPILE
 6839: __device__ void computeVerticalAdvection(void) {
 6840:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6841: 
 6842:    sdbt(1:2,:,:)=0.d0
 6843: 
 6844:    const Side *side = FROM kernel;
 6845: 
 6846:    if(side->isDry) return;
 6847: 
 6848:    // If side is wet...
 6849: 
 6850: 
 6851:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6852:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6853:    double ws[nvrt] = {} // w @ side
 6854:    int icount = 0;
 6855:    for (int j=0; j<2; j++) {
 6856:       const Element *elem = side->elements[j];
 6857:        
 6858:       if(elem != nullptr) {
 6859:          icount++;
 6860:          for (int k=0; k<nvrt; k++) {
 6861:             ws[k] = ws[k] + elem->w[k];
 6862:          }
 6863:       }
 6864:    }  // for j
 6865: 
 6866:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6867:    ws = ws/icount;
 6868: 
 6869:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6870:    // Splines allow for a smooth transition between vertical levels.
 6871:    // Splines have continuity restrictions at the internal knots, but
 6872:    // we have to provide the 1st derivatives at the endpoints.
 6873:    const int kbs = side->kbs; 
 6874:    
 6875:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6876:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6877:    initCubicSpline(kbs, nvrt, side, ws, up)
 6878: 
 6879:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6880:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6881:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6882: 
 6883:    // Total advection (average onto side)
 6884:    const Node *node1 = side->nodes[0];
 6885:    const Node *node2 = side->nodes[1];
 6886:    for (int k=kbs(i); k<nvrt; k++) {
 6887: 
 6888:       if constexpr(ics==1) {
 6889:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6890:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6891:       } else {
 6892:          // XXX IMPLEMENT THIS
 6893:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6894:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6895:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6896:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6897:       }  // if ics
 6898: 
 6899: 
 6900:    }
 6901: }
 6902: #endif
 6903: 
 6904: 
 6905: extern "C" {
 6906:    __global__ void computeElemAverageGhat(void) {
 6907:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6908: 
 6909:       ELEM(elem);
 6910:       
 6911:       elem->ghat1= {0.0, 0.0};  
 6912: 
 6913:       if constexpr(ihydraulics != 0) {
 6914:          if (nhtblocks > 0 && elem->isblock) return;
 6915:       }
 6916: 
 6917:       if (elem->isDry) return;
 6918: 
 6919:       // Wet elements.
 6920:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6921:       // tidal potential, horizontal diffusion, and baroclinic etc
 6922:       // Remember to update both fb and F 
 6923:       // If ics=2, ghat1 are in eframe (ll)
 6924:       // cff1-3: coefficients for 2D/3D
 6925:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6926:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6927:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6928: 
 6929:       double av_cff1 = 0.0;  // av. for cff1
 6930:       double av_cff2 = 0.0;  // av. for cff2
 6931:       double av_cff3 = 0.0;  // av. for cff3
 6932:       double av_df = 0.0;  // av. for H^\alpha / H
 6933:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6934:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6935: 
 6936:       const int i34 = elem->i34;
 6937:       const int kb = elem->kb;
 6938: 
 6939:       for (int j=0; j<i34; j++) {
 6940:          // For each node and side in the element...
 6941: 
 6942:          const Node *node = elem->nodes[j];
 6943:          const Side *side = elem->sides[j];
 6944: 
 6945:          const double chi      = side->chi;
 6946:          const double veg_c2   = side->veg_c2;
 6947:          const double veg_beta = side->veg_beta;
 6948:          const double veg_h    = side->veg_h();
 6949:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6950: 
 6951:          // Node - const in elem
 6952:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6953:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6954: 
 6955:          if (elem->depth >= tip_dp) {
 6956:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6957:          }
 6958: 
 6959:          
 6960:          const double htot  = side->htot2();        // Total depth at the side
 6961:          const double zctr2 = side->zTopCanopy();  
 6962: 
 6963:          double cff1; 
 6964:          double cff2; 
 6965:          double cff3;   
 6966:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6967:          // coefficients applied to 2D/3D case 
 6968:             cff1 = side->hhat/htot;
 6969:             cff2 = 0.0;
 6970:             cff3 = 0.0;
 6971:          } else { //3D
 6972:             //Init for no-veg case
 6973:             cff1 = 1.0;
 6974:             cff2 = 1.0;
 6975:             cff3 = 0.0;
 6976: 
 6977:             if constexpr(iveg != 0) {
 6978:                // Computes coefficients used with vegetation terms G1, G2
 6979:                // cff1, cff3 are used for the first two terms in G1, G2:
 6980:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6981:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6982:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6983:                if(veg_h < 0.99*htot) { // submergent vegetation
 6984:                   cff1=1;
 6985:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6986:                   cff3 = veg_c;
 6987: 
 6988:                } else { // emergent vegetation
 6989:                   cff1 = 1.0/(1.0 + veg_c2);
 6990:                   cff2 = cff1;
 6991:                   cff3 = 0.0;
 6992: 
 6993:                }
 6994:             } // if iveg
 6995:          } //  2D/3D
 6996: 
 6997:          av_cff1 += cff1/i34;
 6998:          av_cff2 += cff2/i34;
 6999:          av_cff3 += cff3/i34;
 7000:          av_cff2_chi += cff2*chi/i34;
 7001:          av_cff3_chi += cff3*chi/i34;
 7002:          av_df += min(htot, veg_h)/(htot*i34);
 7003: 
 7004: 
 7005:          // btrack values: U^\star, U^{\star\alpha}
 7006:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7007:          Vector2 Ustar       = {0.0, 0.0}; 
 7008:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7009: 
 7010:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7011:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7012:          } else { //3D
 7013:             for (int k = side->kb; k < nvrt; k++) {
 7014:             
 7015:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7016:                Ustar += w2;
 7017: 
 7018:                if constexpr(iveg != 0) {
 7019:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7020:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7021:                        Ustar_alpha += zrat*w2; // XXXX
 7022:                    }
 7023:                }  // if iveg
 7024:             }  // for k
 7025:          }  //2D/3D
 7026:          
 7027: 
 7028:          // Add btrack & surface stress terms to \breve{G} first
 7029:          if constexpr(ics==1) {
 7030: 
 7031:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7032: 
 7033:          } else {
 7034:             // XXX IMPLEMENT THIS
 7035:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7036:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7037:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7038:          }  // if ics
 7039: 
 7040:          // Surface and bottom stress terms
 7041:          if constexpr(ics==1) {
 7042:             const Vector2 tau    = side->tau();
 7043:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7044: 
 7045:             // Term for surface and bottom stress
 7046:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7047: 
 7048:          } else {
 7049:             assert(false && "computeElemAverageGhat: Not implemented");
 7050:             // XXX IMPLEMENT THIS
 7051:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7052:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7053:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7054:             // tau_x=(vn1+tt1)/2.d0
 7055:             // tau_y=(vn2+ss1)/2.d0
 7056:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7057:          }  // if ics
 7058: 
 7059:          
 7060: 
 7061:          // All terms in F,F^\alpha,f_b except baroclinic
 7062:          // F, f_b: all explicit terms excluding vegetation 
 7063:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7064:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7065:          const double coriolis = side->coriolis;
 7066:          Vector2 F  =  coriolis*side->U;  // F_x
 7067:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7068:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7069: 
 7070:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7071:             
 7072:             for (int k = side->kb; k < nvrt; k++) {
 7073:                if (zctr2 > side->zc[k-1]) {
 7074:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7075:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7076:                    Fa +=  coriolis*w2*zrat;
 7077:                } // if zctr2
 7078:             } // k
 7079:          } // iveg
 7080: 
 7081:          // Integrate horizontal viscosity force vertically
 7082:          for (int k=side->kb + 1; k<nvrt; k++) {
 7083:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7084: 
 7085:             F += levelHorVisc;
 7086: 
 7087:             // Vegetation term
 7088:             if constexpr(iveg!=0) {
 7089:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7090:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7091:                   Fa += levelHorVisc*zrat;
 7092:                } 
 7093:             } // if iveg
 7094:          } // for k
 7095: 
 7096:          fb += side->nuGradU[side->kb];
 7097: 
 7098:          // Add to ghat1
 7099:          if constexpr(ics==2) {
 7100:             // XXX IMPLEMENT THIS
 7101:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7102:             // bigf1=vn1; bigf2=vn2
 7103:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7104:             // botf1=vn1; botf2=vn2
 7105:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7106:             // bigfa1=vn1; bigfa2=vn2
 7107:          } // if ics
 7108: 
 7109:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7110:       } // for j (nodes and sides)
 7111: 
 7112:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7113:          
 7114:       // Finish off terms in F, F^\alpha and f_b
 7115:       const double grav3 = elem->mean(&Node::grav2);
 7116:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7117: 
 7118: 
 7119:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7120:       for (int j=1; j<i34; j++) { 
 7121:          // For each side in the element...
 7122:          const Side *side = elem->sides[j];
 7123:          const double chi = side->chi;
 7124: 
 7125:          const double htot = side->htot2();
 7126:          const double veg_h = side->veg_h();
 7127:          const Vector2 F  = htot*fb;
 7128:          const Vector2 Fa = min(htot, veg_h)*fb;
 7129: 
 7130:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7131:       } // for j
 7132: 
 7133:       //botf1 etc are already in elem frame
 7134:       elem->ghat1 += tmp/i34;
 7135: 
 7136:       // Baroclinic force
 7137:       if constexpr(ibc==0) {
 7138:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7139: 
 7140:          Vector2 Fa = {0.0, 0.0};
 7141:          Vector2 intGradRho = {0.0, 0.0};
 7142:          
 7143:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7144:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7145:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7146: 
 7147:             // \in F [m^2/s/s]
 7148:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7149:          }
 7150: 
 7151:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7152:          const Vector2 F = av_df*Fa; //approx
 7153:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7154: 
 7155:       } // if ibc
 7156: 
 7157: 
 7158: 
 7159:    }
 7160: 
 7161: } // extern "C"
 7162: 
 7163: 
 7164: 
 7165: #ifdef DONTCOMPILE
 7166: __global__ void checkMassConservation(Tracers* sumtr) {
 7167: 
 7168:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7169: 
 7170:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7171: 
 7172:    Element *elem = &(mesh->localElemData[i]);
 7173: 
 7174:    // Skip dry elements
 7175:    if (elem->isDry) return;
 7176: 
 7177:    // Local sum array for this thread
 7178:    double localSum[N_TRACERS] = {0.0};
 7179: 
 7180:    // Sum over vertical levels for this element
 7181:    const int kbe = elem->kbe;
 7182:    const double area = elem->area;
 7183: 
 7184:    for (int k = kbe; k < nvrt; k++) {
 7185:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7186:       
 7187:       // Accumulate tracer mass
 7188:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7189:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7190:       }
 7191:    }
 7192: 
 7193:    //  This function returns per element sums. A reduction must be done on the host side.
 7194: }
 7195: 
 7196: 
 7197: __global__ void transport(void) {
 7198: 
 7199:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7200: 
 7201:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7202: 
 7203:    Element *elem = &(mesh->localElemData[ie]);
 7204: 
 7205:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7206: 
 7207:                for (int m=0; m<ntr; m++) {
 7208:                   for (int k=kbe(ie); k<nvrt; k++) {
 7209:                      // Calculate each polynomial's weight 
 7210:                      wm=0.d0; sum1=0.d0; 
 7211:                      wm1=0.d0; wm2=0.d0; 
 7212:                      for (int i=0; i<elem->nweno2; i++) {
 7213:                   
 7214:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7215:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7216:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7217:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7218:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7219:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7220:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7221:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7222:                      // -----------------Hu and Shu (1999)'s method----------------
 7223:                      b4=b1+b2+b3
 7224: 
 7225: //Error: add PRODUCTION CPP
 7226: #ifdef DEBUG
 7227:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7228:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7229:                     call parallel_abort(errmsg)
 7230:                   }
 7231: #endif
 7232: 
 7233:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7234:                   // !----test-------------- 
 7235:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7236:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7237:                   // !wm(i)=wm1(i)*wm2(i)
 7238:                   // !---------------------- 
 7239:                   sum1=sum1+wm(i)
 7240:                 } // end for i
 7241: 
 7242:                 wm=wm/sum1
 7243: 
 7244:                 for (int j=0; j<elem->i34; j++) {
 7245: 
 7246:                   const Side *side  = elem->sides[j];
 7247:                   const Node *node1 = side->n1;
 7248:                   const Node *node2 = side->n2;
 7249: 
 7250:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7251:                      trsd=0.d0
 7252:                      for (int kk=0; kk<nquad; kk++) {
 7253:                         for (int i=0; i<elem->nweno2; i++) {
 7254:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7255:                         } // end for i   
 7256:                      } // end for kk
 7257:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7258:                   } // outward flux
 7259:                } // end for j=1,i34(ie) ! side
 7260:             }
 7261:          }
 7262:               
 7263: 
 7264: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7265: //             //   calculate each polynomial's weight 
 7266: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7267: //                 wm=0.d0; sum1=0.d0
 7268: //                 do i=1,nweno1(ie) !for each polynomial
 7269: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7270: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7271: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7272: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7273: //                   wm(i)=b2
 7274: //                   sum1=sum1+b2
 7275: //                   !wm(i)=1.d0
 7276: //                   !sum1=sum1+1.d0
 7277: 
 7278: // // Error: PRODUCTION
 7279: // #ifdef DEBUG
 7280: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7281: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7282: //                     call parallel_abort(errmsg)
 7283: //                   endif
 7284: // #endif
 7285: 
 7286: //                 enddo !i
 7287: //                 wm=wm/sum1 !final weight
 7288: 
 7289:                 for (int j=0; j<elem->i34; j++) { // side
 7290:                   const Side *side = elem->sides[j];
 7291:                   const Node *node1 = side->n1;
 7292:                   const Node *node2 = side->n2;
 7293: 
 7294:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7295:                     trsd=0.d0
 7296:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7297:                       for (int i=0; i<elem->nweno1; i++) {
 7298:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7299:                       }
 7300:                     enddo //kk
 7301:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7302:                   } // outward flux
 7303:                 } // end for j=1,i34(ie) ! side
 7304:               } // end for k; ntr 
 7305: 
 7306:             else !simple upwind method
 7307:               do j=1,i34(ie)
 7308:                 jsj=elside(j,ie)
 7309:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7310:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7311:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7312:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7313:                   endif
 7314:                 enddo  !vertical layers
 7315:               enddo !j=1,i34(ie) ! side
 7316:             endif !order of accuracy
 7317: 
 7318:          //  enddo !ie
 7319: // !$OMP     end do
 7320: 
 7321: // !$OMP     master
 7322: //           !message passing
 7323: //           if (nproc>1) then
 7324: //             !make a copy of side concentrations
 7325: //             trsd_tmp0=trsd_tmp 
 7326: 
 7327: //             !this exchange routine swaps interface concentration between two partitions
 7328: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7329: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7330: 
 7331: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7332: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7333: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7334: 
 7335: 
 7336: //             !This obtains final values for interface sides
 7337: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7338: //       :    endif !nproc>1
 7339: //           !message passing end
 7340: // !$OMP     end master
