 1244: // This struct is used to store the boundary information for a node.
 1245: struct NodeBoundary {   
 1246:    int idx;
 1247:    BoundarySegment *segment;
 1248:    Node *node;
 1249:    
 1250:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1251:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1252: 
 1253:    bool isLand;
 1254: 
 1255:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1256:    double elbc;   // Elevation boundary condition
 1257:    double eth;    // Elevation time history
 1258: 
 1259:    double eta_mean; // Mean elevation at nodes
 1260: 
 1261:    bool isEssentialBC;
 1262: 
 1263:    Vector2 uth[nvrt];  // "Time history" velocity
 1264: 
 1265:    // Arrays for harmonic constituents (if needed)
 1266:    double  emo[nbfr];  // Elevation amplitude
 1267:    double  efa[nbfr];  // Elevation phase
 1268:    Vector2 umo[nbfr];  // velocity amplitude
 1269:    Vector2 ufa[nbfr];  // velocity phase
 1270: 
 1271: 
 1272:    NodeBoundary(void) {
 1273:       isLand = false;
 1274:    }
 1275:    NodeBoundary(bool _isLand) {
 1276:       isLand = _isLand;
 1277:    }
 1278: 
 1279:    
 1280:    __forceinline__ __device__ int numSidesForAverage() const {
 1281:    // Returns the number of sides that are connected to the node and have the same segment.
 1282:    // This is used to compute the average velocity at the node for open boundary nodes.
 1283:       int res = 0;
 1284:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1285:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1286: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1287:       return res;
 1288:    }
 1289: 
 1290: 
 1291:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1292:       assert(index == 0 || index == 1); 
 1293:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1294:    }
 1295: 
 1296: 
 1297: };
