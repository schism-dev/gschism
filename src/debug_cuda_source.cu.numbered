 1291:    __device__ void setFrame(void) {
 1292:       if constexpr(ics == 1) return;
 1293: 
 1294:       double lat, lon;
 1295:       const Point3 p = toPoint3(center, centerZ());
 1296: 
 1297:       // Compute the latitude and longitude of the element center
 1298:       computeLatLon(p, lat, lon);
 1299: 
 1300:       frame.update(lat, lon);        
 1301:    }
