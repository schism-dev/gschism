 2090: // Helper functions for computing the local node index at a given offset from another.
 2091: __device__ __inline__ int nxq(int offset, int index, int size) {
 2092:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2093:    // to the index to make it positive
 2094:    assert(index + offset + 16*size >= 0);
 2095:    return (index + offset + 16*size) % size;  
 2096: }
 2097: 
 2098: __device__ __inline__ int nxq(int index, int size) {
 2099:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2100:    // to the index to make it positive
 2101:    assert(index + 16*size >= 0);
 2102:    return (index + 16*size) % size; 
 2103: }
