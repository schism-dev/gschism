 1896: __device__ void lock(int *mutex) {
 1897:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1898: }
 1899: 
 1900: __device__ void unlock(int *mutex) {
 1901:     atomicExch(mutex, 0);
 1902: }
