 4440: 
 4441:    __global__ void computeFlowBcVelocities(double time) {
 4442: 
 4443:       SIDE_BND(sideBnd);
 4444: 
 4445:       const Side *side = sideBnd->side;
 4446:  
 4447:       const bool isDry = side->isDry;
 4448:       const bool isLand = sideBnd->segment->isLand;
 4449: 
 4450:    
 4451:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4452: 
 4453:       if (isDry || isLand) return;
 4454: 
 4455:       // For wet sides in open boundaries...
 4456:       const Vector2 n = side->n;
 4457:       const BoundarySegment *segment = sideBnd->segment;
 4458: 
 4459:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4460: 
 4461:       const int ifltype = segment->ifltype;
 4462: 
 4463:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4464:       const Vector2 r_nuth0 = r_uth0*n;
 4465: 
 4466: 
 4467:       if (ifltype == 1 || ifltype == 2) {
 4468:       
 4469:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4470: 
 4471:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4472:          
 4473:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4474:          
 4475:       } else if (ifltype == -1) { // Flather 1
 4476: 
 4477:          for (int k = 0; k < nvrt; k++) {
 4478: 
 4479:             // uth is the normal vel.; no ramp up
 4480:             const double uth = sideBnd->nuth(k);
 4481:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4482: 
 4483:             sideBnd->ubc[k] += uth*n;
 4484:          }
 4485: 
 4486:       } else if (ifltype == 3 || ifltype == 5) {
 4487:          // vnth0=0 !normal vel.
 4488: 
 4489:          Vector2 r_u1_bar = {0.0, 0.0};
 4490:          // Computes the contribution to the velocity from all tide frequencies
 4491:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4492: 
 4493:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4494:             const Vector2 umo  = sideBnd->umo(jfr); 
 4495: 
 4496:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4497:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4498:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4499:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4500: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4501:          }
 4502: 
 4503: 
 4504:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4505: 
 4506:       } // if (ifltype = 3 || ifltype == 5
 4507: 
 4508: 
 4509: 
 4510:    }
 4511: 
 4512:    __global__ void computeElevationBoundaryConditions(double time) {
 4513:       // Compute elevation essential boundary conditions 
 4514: 
 4515:       NODE_BND(nodeBnd); // Each boundary node.
 4516: 
 4517:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4518: 
 4519:       const Node *node = nodeBnd->node;
 4520:       const BoundarySegment *segment = nodeBnd->segment;
 4521:       const int iettype = segment->iettype;
 4522:       
 4523: 
 4524:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4525:       double eic = 0.0;
 4526:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4527:       else                 eic = 0.0;
 4528: 
 4529:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4530:       const double r_eth = ramp*nodeBnd->eth;
 4531:       double r_eta1_bar = 0.0;
 4532: 
 4533: 
 4534:       // Compute tide elevation
 4535:       if (iettype == 3 || iettype == 5) {   
 4536: 
 4537:          if constexpr(iloadtide==1) { // loading tide
 4538:             assert(false && "Loading tide not implemented");
 4539:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4540:          }
 4541:          
 4542:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4543: 
 4544:             const double efa  = nodeBnd->efa[jfr]; 
 4545:             const double emo  = nodeBnd->emo[jfr]; 
 4546: 
 4547:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4548:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4549:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4550: 
 4551:          } // for jfr
 4552: 
 4553:       } // if iettype
 4554: 
 4555:       switch (iettype) {
 4556:          case 1:
 4557:          case 2:
 4558:          case 4:
 4559:             nodeBnd->elbc = r_eic + r_eth;
 4560:             break;
 4561:          case 3:
 4562:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4563:             break;
 4564:          case 5:
 4565:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4566:             break;
 4567:       } // switch
 4568: 
 4569: 
 4570:       //Add inverse barometric effects
 4571:       if (iettype != 0 && inv_atm_bnd == 1) {
 4572:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4573:       }
 4574: 
 4575:    }
 4576: 
 4577: 
 4578:    __global__ void computeHorizontalViscosity(void) { 
 4579: 
 4580:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4581: 
 4582:       SIDE(side);
 4583: 
 4584:       if (side->isDry) return;
 4585: 
 4586:       for (int k = 0; k < nvrt; k++) {
 4587:          side->nuGradU[k] = {0.0, 0.0};
 4588:       }
 4589: 
 4590:       if constexpr(ihorcon == 1) {
 4591:          for (int k = side->kb; k < nvrt - 1; k++) {
 4592:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4593:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4594:             // By Zhang and Baptista.
 4595: 
 4596:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4597:             // This is a standard discretization of the Laplacian operator.
 4598:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4599:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4600:             // Gamma is hvis_coef0 in the code.
 4601:             // The value of gamma needs to be < 0.5.
 4602: 
 4603:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4604:             // side under consideration in each of the two possible elements that share the side.
 4605:             Vector2 sumU = {0.0, 0.0};
 4606:             for (int l = 0; l < 2; l++) {
 4607:                const Element *elem = side->elems[l];
 4608: 
 4609:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4610: 
 4611:                // Find the local index of the side in the element
 4612:                const int idxSide = elem->sideLocalIdx(side);
 4613:                // Find the two sides that are connected to the side under consideration
 4614:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4615:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4616: 
 4617:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4618: 
 4619:             }
 4620: 
 4621:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4622:    
 4623:          }
 4624:       }
 4625:       else if constexpr(ihorcon == 2) {
 4626:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4627:       }
 4628: 
 4629: 
 4630:    }
 4631: 
 4632: 
 4633:    __global__ void setEssentialBC(void) {
 4634:       // Set essential boundary conditions 
 4635:       NODE(node); // Each boundary node
 4636:       NodeBoundary *nodeBnd = node->nodeBnd;
 4637:       
 4638: // nodeBnd->isEssentialBC = true;      
 4639:       // Check if this node has essential BC
 4640:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4641:          // Verify BC value is valid
 4642:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4643: 
 4644:        
 4645:          // Set diagonal to 1 and zero off-diagonals
 4646:          node->coeffDiag = 1.0;
 4647: 
 4648:          for (int j = 0; j < node->numNodes; j++) {
 4649:                node->coeffMatrix[j] = 0.0;
 4650:          }
 4651:          
 4652:          // Set solution and RHS to BC value
 4653:          node->mX  = nodeBnd->elbc;
 4654:          node->qel = nodeBnd->elbc;
 4655: 
 4656:       } else {
 4657:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4658: 
 4659:          for (int j = 0; j < node->numNodes; j++) {
 4660:                Node* nbNode = node->nodes[j];
 4661:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4662:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4663:                   // Verify neighbor's BC value
 4664:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4665: 
 4666:                   // Subtract contribution to RHS
 4667:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4668:                   node->coeffMatrix[j] = 0.0;  
 4669:                }
 4670:          }
 4671:       }
 4672:    }
 4673: 
 4674: 
 4675:    __global__ void updateElevation(void) {
 4676:       NODE(node);
 4677: 
 4678: 
 4679:       node->eta2 = node->mX;
 4680: 
 4681:       node->updateZCoordData();
 4682:    }
