 7684: __global__ void printMatrix(bool full) {
 7685:    // Debugging: print the matrix
 7686: 
 7687:    const int size = mesh->np;
 7688:    double sum = 0.0;
 7689:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7690:       const Node *node = mesh->localNodeData + idx_node;
 7691:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7692:       for (int j = 0; j < node->numNodes; j++) {
 7693:          Node* nbNode = node->nodes[j];
 7694:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7695:          sum += node->coeffMatrix[j];
 7696:       }
 7697:       if (full) printf("]\n");
 7698: 
 7699: 
 7700:    }
 7701:    if (!full) printf("sum=%lf\n", sum);
 7702: }
