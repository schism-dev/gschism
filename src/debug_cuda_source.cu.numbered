 8059: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8060:    Node *nodes = mesh->localNodeData;
 8061: 
 8062:    *addr = nodes;
 8063:    *sizeNode = sizeof(Node);
 8064: 
 8065:    switch (varCode) {
 8066:       case (int)VarCode::depth:
 8067:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8068:          *sizeType = sizeof(double);
 8069:          break;
 8070:       case (int)VarCode::eta:
 8071:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8072:          *sizeType = sizeof(double);
 8073:          break;
 8074:       case (int)VarCode::x:
 8075:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8076:          *sizeType = sizeof(Vector2);
 8077:          break;
 8078:       case (int)VarCode::z:
 8079:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8080:          *sizeType = sizeof(double);
 8081:          break;
 8082:       case (int)VarCode::kb:
 8083:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8084:          *sizeType = sizeof(int);
 8085:          break;
 8086:       case (int)VarCode::isdry:
 8087:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8088:          *sizeType = sizeof(int);
 8089:          break;         
 8090:       case (int)VarCode::w:
 8091:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8092:          *sizeType = sizeof(double);
 8093:          break;
 8094:       case (int)VarCode::u:
 8095:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8096:          *sizeType = sizeof(Vector2);
 8097:          break;         
 8098:       default:
 8099:          *offset = -1;    
 8100:    }  
 8101:    
 8102: }
