 4694:    __global__ void computeFlowBcVelocities(double time) {
 4695: 
 4696:       SIDE_BND(sideBnd);
 4697: 
 4698:       const Side *side = sideBnd->side;
 4699:  
 4700:       const bool isDry = side->isDry;
 4701:       const bool isLand = sideBnd->segment->isLand;
 4702: 
 4703:    
 4704:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4705: 
 4706:       if (isDry || isLand) return;
 4707: 
 4708:       // For wet sides in open boundaries...
 4709:       const Vector2 n = side->n;
 4710:       const BoundarySegment *segment = sideBnd->segment;
 4711: 
 4712:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4713: 
 4714:       const int ifltype = segment->ifltype;
 4715: 
 4716:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4717:       const Vector2 r_nuth0 = r_uth0*n;
 4718: 
 4719: 
 4720:       if (ifltype == 1 || ifltype == 2) {
 4721:       
 4722:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4723: 
 4724:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4725:          
 4726:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4727:          
 4728:       } else if (ifltype == -1) { // Flather 1
 4729: 
 4730:          for (int k = 0; k < nvrt; k++) {
 4731: 
 4732:             // uth is the normal vel.; no ramp up
 4733:             const double uth = sideBnd->nuth(k);
 4734:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4735: 
 4736:             sideBnd->ubc[k] += uth*n;
 4737:          }
 4738: 
 4739:       } else if (ifltype == 3 || ifltype == 5) {
 4740:          // vnth0=0 !normal vel.
 4741: 
 4742:          Vector2 r_u1_bar = {0.0, 0.0};
 4743:          // Computes the contribution to the velocity from all tide frequencies
 4744:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4745: 
 4746:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4747:             const Vector2 umo  = sideBnd->umo(jfr); 
 4748: 
 4749:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4750:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4751:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4752:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4753:          }
 4754: 
 4755: 
 4756:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4757: 
 4758:       } // if (ifltype = 3 || ifltype == 5
 4759: 
 4760: 
 4761: 
 4762:    }
 4763: 
 4764:    __global__ void computeElevationBoundaryConditions(double time) {
 4765:       // Compute elevation essential boundary conditions 
 4766: 
 4767:       NODE_BND(nodeBnd); // Each boundary node.
 4768: 
 4769:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4770: 
 4771:       const Node *node = nodeBnd->node;
 4772:       const BoundarySegment *segment = nodeBnd->segment;
 4773:       const int iettype = segment->iettype;
 4774:       
 4775: 
 4776:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4777:       double eic = 0.0;
 4778:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4779:       else                 eic = 0.0;
 4780: 
 4781:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4782:       const double r_eth = ramp*nodeBnd->eth;
 4783:       double r_eta1_bar = 0.0;
 4784: 
 4785: 
 4786:       // Compute tide elevation
 4787:       if (iettype == 3 || iettype == 5) {   
 4788: 
 4789:          if constexpr(iloadtide==1) { // loading tide
 4790:             assert(false && "Loading tide not implemented");
 4791:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4792:          }
 4793:          
 4794:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4795: 
 4796:             const double efa  = nodeBnd->efa[jfr]; 
 4797:             const double emo  = nodeBnd->emo[jfr]; 
 4798: 
 4799:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4800:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4801:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4802: 
 4803:          } // for jfr
 4804: 
 4805:       } // if iettype
 4806: 
 4807:       switch (iettype) {
 4808:          case 1:
 4809:          case 2:
 4810:          case 4:
 4811:             nodeBnd->elbc = r_eic + r_eth;
 4812:             break;
 4813:          case 3:
 4814:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4815:             break;
 4816:          case 5:
 4817:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4818:             break;
 4819:       } // switch
 4820: 
 4821: 
 4822:       //Add inverse barometric effects
 4823:       if (iettype != 0 && inv_atm_bnd == 1) {
 4824:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4825:       }
 4826: 
 4827:    }
 4828: 
 4829: 
 4830:    __global__ void computeHorizontalViscosity(void) { 
 4831: 
 4832:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4833: 
 4834:       SIDE(side);
 4835: 
 4836:       if (side->isDry) return;
 4837: 
 4838:       for (int k = 0; k < nvrt; k++) {
 4839:          side->nuGradU[k] = {0.0, 0.0};
 4840:       }
 4841: 
 4842:       if constexpr(ihorcon == 1) {
 4843:          for (int k = side->kb; k < nvrt - 1; k++) {
 4844:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4845:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4846:             // By Zhang and Baptista.
 4847: 
 4848:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4849:             // This is a standard discretization of the Laplacian operator.
 4850:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4851:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4852:             // Gamma is hvis_coef0 in the code.
 4853:             // The value of gamma needs to be < 0.5.
 4854: 
 4855:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4856:             // side under consideration in each of the two possible elements that share the side.
 4857:             Vector2 sumU = {0.0, 0.0};
 4858:             for (int l = 0; l < 2; l++) {
 4859:                const Element *elem = side->elems[l];
 4860: 
 4861:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4862: 
 4863:                // Find the local index of the side in the element
 4864:                const int idxSide = elem->sideLocalIdx(side);
 4865:                // Find the two sides that are connected to the side under consideration
 4866:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4867:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4868: 
 4869:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4870: 
 4871:             }
 4872: 
 4873:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4874:    
 4875:          }
 4876:       }
 4877:       else if constexpr(ihorcon == 2) {
 4878:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4879:       }
 4880: 
 4881: 
 4882:    }
 4883: 
 4884: 
 4885:    __global__ void setEssentialBC(void) {
 4886:       // Set essential boundary conditions 
 4887:       NODE(node); // Each boundary node
 4888:       NodeBoundary *nodeBnd = node->nodeBnd;
 4889:       
 4890: // nodeBnd->isEssentialBC = true;      
 4891:       // Check if this node has essential BC
 4892:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4893:          // Verify BC value is valid
 4894:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4895: 
 4896:        
 4897:          // Set diagonal to 1 and zero off-diagonals
 4898:          node->coeffDiag = 1.0;
 4899: 
 4900:          for (int j = 0; j < node->numNodes; j++) {
 4901:                node->coeffMatrix[j] = 0.0;
 4902:          }
 4903:          
 4904:          // Set solution and RHS to BC value
 4905:          node->mX  = nodeBnd->elbc;
 4906:          node->qel = nodeBnd->elbc;
 4907: // printf("bbbbb\n");
 4908:       } else {
 4909:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4910: // printf("aaaaaa\n");
 4911:          for (int j = 0; j < node->numNodes; j++) {
 4912:                Node* nbNode = node->nodes[j];
 4913:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4914:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4915:                   // Verify neighbor's BC value
 4916:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4917: 
 4918:                   // Subtract contribution to RHS
 4919:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4920:                   node->coeffMatrix[j] = 0.0;  
 4921:                }
 4922:          }
 4923:       }
 4924:    }
 4925: 
 4926: 
 4927:    __global__ void updateElevation(void) {
 4928:       NODE(node);
 4929: 
 4930:       node->eta2 = node->mX;
 4931: 
 4932:       node->updateZCoordData();
 4933:    }
