 7976:                                  
 7977:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7978:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7979:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7980:                    int *isdel, int *isidenode, int *isbnd,
 7981:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7982:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7983:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7984:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7985:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7986:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7987:                    double *drag, double *roughness,
 7988:                    double *emo, double *efa, 
 7989:                    double *umo, double *ufa, 
 7990:                    double *vmo, double *vfa) {
 7991: 
 7992:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7993:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7994:                        isdel, isidenode, isbnd,
 7995:                        nond, nlnd, iond, ilnd, 
 7996:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7997:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7998:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7999:                        localNodeIndices, localElemIndices, localSideIndices,
 8000:                        localNodePart, localElemPart, localSidePart,
 8001:                        drag, roughness,
 8002:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8003:   }
