 1490:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1491:       // Compute the different time ramps used in the code 
 1492:       // This function is performed by just one thread
 1493: 
 1494:       if constexpr(ibc == 0) {
 1495:          if (drampbc > 0.0) {
 1496:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1497:          } else {
 1498:             rampbc = 1.0;
 1499:          }
 1500: 
 1501:          if (nws != 0 && drampwind > 0.0) {
 1502:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1503:          } else {
 1504:             rampwind = 1.0;
 1505:          }
 1506:       }
 1507: 
 1508:       if (drampwafo > 0.0) {
 1509:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1510:       } else {
 1511:          rampwafo = 1.0;
 1512:       }
 1513: 
 1514:       // For source/sinks
 1515:       if (if_source && dramp_ss > 0.0) {
 1516:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1517:       } else {
 1518:          ramp_ss = 1.0;
 1519:       }
 1520: 
 1521:       if (dramp > 0.0) {
 1522:          ramp = tanh(2.0*time/86400.0/dramp);
 1523:       } else {
 1524:          ramp = 1.0;
 1525:       }
 1526: 
 1527:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1528:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1529:    }
 1530:       
 1531: 
 1532:    __global__ void computeBedDeformation(void) {
 1533:       printf("NOT IMPLEMENTED: computeBedDeformation\n");
 1534: 
 1535:    }
