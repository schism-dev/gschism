 1931: 
 1932: __inline__ __device__ Point2 Element::outputCoords(void) const {
 1933:    if constexpr(ics == 1)  {
 1934:       return center;
 1935: 
 1936:    } else {
 1937:       const Point2 p0 = nodes[0]->outputCoords();
 1938:       const Point2 p1 = nodes[1]->outputCoords();
 1939:       const Point2 p2 = nodes[2]->outputCoords();
 1940: 
 1941:       if (isTri()) {
 1942:          return (1.0/3.0)*(p0 + p1 + p2);
 1943: 
 1944:       } else {
 1945:          const Point2 p3 = nodes[3]->outputCoords();
 1946:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 1947:       }
 1948: 
 1949:    }
 1950: }
 1951: 
 1952: __device__ __forceinline__ double Element::centerZ(void) const { 
 1953: // Z coordinate of the element center in the global cartesian coordinates.
 1954: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 1955: 
 1956:    if constexpr(ics==1) { 
 1957:       return 0.0; 
 1958:    } else { 
 1959:       if (isTri()) {
 1960:          return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz); 
 1961:       } else {
 1962:          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz); 
 1963:       }
 1964: 
 1965:    } 
 1966: }
