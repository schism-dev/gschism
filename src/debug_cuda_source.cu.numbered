 2091:    template<typename T>
 2092:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2093:       T values[4];
 2094:       getNodalValues(level, func, values);
 2095: 
 2096:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2097:       if constexpr (IsVector2<T>::value && ics == 2) {
 2098: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2099:          projectNodeVectorsToElementFrame(values);
 2100: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2101:       }
 2102: 
 2103:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2104:    }
 2105: 
