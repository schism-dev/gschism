 1420: struct Mesh {
 1421:    public:  
 1422: 
 1423:    int partNum; // Partition number for this mesh.
 1424: 
 1425:    // Pointers to each GPU's local memory (size is the number of partitions).
 1426:    Node**    nodes;  
 1427:    Element** elems;  
 1428:    Side**    sides;  
 1429:    
 1430:    // Local memory
 1431:    Node*    localNodeData; 
 1432:    Element* localElemData;
 1433:    Side*    localSideData; 
 1434: 
 1435:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1436:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1437:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1438:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1439:    
 1440:    const int npgb;  // Global number of horizontal nodes
 1441:    const int negb;  // Global number of elements
 1442:    const int nsgb;  // Global number of sides
 1443: 
 1444:    const int np;   // Local number of horizontal nodes 
 1445:    const int ne;   // Local number of elements
 1446:    const int ns;   // Local number of sides
 1447: 
 1448:    int nbp;  // Local number of boundary nodes
 1449:    int nbs;  // Local number of boundary sides
 1450: 
 1451:    int nEntries;  // Total number of matrix elements
 1452: 
 1453:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1454:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1455:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1456: 
 1457:   
 1458:    // Additional topology information
 1459:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1460:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1461: 
 1462:    BoundarySegment landBoundarySegment;
 1463:    NodeBoundary landBoundaryNode;
 1464: 
 1465:    // Vertical coordinate system
 1466:    // Sigma levels
 1467:    double h_s; 
 1468:    double h_c; 
 1469: 
 1470:    double theta_b;
 1471:    double theta_f, sinh_theta_f;
 1472:    double *sigma_lcl;
 1473:    double *sigma;
 1474:    double *ztot;
 1475:    double *cs;
 1476:    double *dcs;
 1477: 
 1478:    // // Get's the pointer to the node using the array of global pointers to nodes
 1479:    // __device__ const Node *getGlobalNode(int jn) {
 1480:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1481:    //    return nodes[idx] + idx;
 1482:    // }
 1483: 
 1484:    // // Get's the pointer to the element using the array of global pointers to elements
 1485:    // __device__ const Element *getGlobalElem(int je) {
 1486:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1487:    //    return elems[idx] + idx;
 1488:    // }
 1489: 
 1490:    // // Get's the pointer to the side using the array of global pointers to sides
 1491:    // __device__ const Side *getGlobalSide(int js) {
 1492:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1493:    //    return sides[idx] + idx;
 1494:    // }
 1495: 
 1496:    // // Get's the global index of local node idx
 1497:    // __device__ int getGlobalNodeIndex(int idx) {
 1498:    //    return idx + partNum * max_np;
 1499:    // }
 1500: 
 1501:    // // Get's the global index of local element idx
 1502:    // __device__ int getGlobalElemIndex(int idx) {
 1503:    //    return idx + partNum * max_ne;
 1504:    // }
 1505: 
 1506:    // // Get's the global index of local side idx
 1507:    // __device__ int getGlobalSideIndex(int idx) {
 1508:    //    return idx + partNum * max_ns;
 1509:    // }  
 1510: 
 1511:    __device__ Mesh(int partNum,
 1512:                    int npgb, int negb, int nsgb, 
 1513:                    int np, int ne, int ns,
 1514:                    int max_np, int max_ne, int max_ns, int nseg,
 1515:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1516:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1517:                    Node    **localNodeNeighNodesMem,
 1518:                    Element **localNodeNeighElemsMem,
 1519:                    double *partCoeffMatrixMem,
 1520:                    NodeBoundary *localNodeBoundaryMem,
 1521:                    SideBoundary *localSideBoundaryMem,
 1522:                    BoundarySegment *localSegmentMem,
 1523:                    double h_c, double h_s, double theta_b, double theta_f, double *sigma_lcl, double *sigma, double *ztot,
 1524:                    double *cs, double *dcs
 1525:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1526:                        np(np), ne(ne), ns(ns),
 1527:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1528:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1529:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1530:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
