  656:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  657:       // Check if the point (xt,yt) is inside the element
  658:       double shpCoords[4];
  659: 
  660:       bool res = computeShapeCoords(xt, shpCoords, false);
  661: 
  662:       return res;
  663:    }
  664: 
  665:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  666:       // Check if the point (xt,yt) is inside the element
  667:       double shpCoords[4];
  668: 
  669:       Vector2 tmp_xt = xt;
  670:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  671: 
  672:       if (fixCoords && res) xt = tmp_xt;
  673: 
  674:       return res;
  675:    }
  676: 
  677:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  678:    {
  679:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  680:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  681:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  682:       
  683:    }
