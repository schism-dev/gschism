  859:    __device__ Vector2 grad2(double *a) const
  860:    {
  861:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  862:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  863:       if (isQuad()) {
  864:          gx += a[3]*gradPhi[3].x;
  865:          gy += a[3]*gradPhi[3].y;
  866:       }
  867:       return {gx, gy};
  868:    }
  869: 
  870:    __device__ Vector2 grad2(double Node::* field) const
  871:    {
  872:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  873:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  874:       if (isQuad()) {
  875:          gx += (nodes[3]->*field)*gradPhi[3].x;
  876:          gy += (nodes[3]->*field)*gradPhi[3].y;
  877:       }
  878:       return {gx, gy};
  879:    }
