 7502: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7503:    // Get the value of a variable from an element
 7504:    // varName is the name of the variable to get
 7505:    // var is the array to store the value
 7506:    // k is the vertical level index of the variable to get
 7507: 
 7508:    ELEM(elem);
 7509:    
 7510:    int idx = elem->idx;
 7511:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7512: 
 7513:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7514:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7515:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7516:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7517:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7518:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7519:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7520:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7521:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7522:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7523:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7524:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7525:       
 7526:    
 7527: }
 7528: 
 7529: 
 7530: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7531:    // Get the value of a variable from an node
 7532:    // varName is the name of the variable to get
 7533:    // var is the array to store the value
 7534:    // k is the vertical level index of the variable to get
 7535: 
 7536:    NODE(node);
 7537:    
 7538:    int idx = node->idx;
 7539:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7540: 
 7541:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7542:    
 7543:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7544:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7545:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7546:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7547:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7548:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7549:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7550:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7551:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7552:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7553:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7554:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7555:       
 7556:    
 7557: }
 7558: 
 7559: 
 7560: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7561:    // Get the value of a variable from an side
 7562:    // varName is the name of the variable to get
 7563:    // var is the array to store the value
 7564:    // k is the vertical level index of the variable to get
 7565:    SIDE(side);
 7566:    
 7567:    int idx = side->idx;
 7568:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7569: 
 7570:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7571:    
 7572:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7573:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7574:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7575:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7576:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7577:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7578:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7579:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7580:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7581:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7582:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7583:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7584:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7585:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7586:    else if (varCode == (int)VarCode::ubc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7587:    else if (varCode == (int)VarCode::vbc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7588:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7589:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7590:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7591: }
