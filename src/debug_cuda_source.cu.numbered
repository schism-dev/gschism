 2182: // Helper functions for computing the local node index at a given offset from another.
 2183: __device__ __inline__ int nxq(int offset, int index, int size) {
 2184:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2185:    // to the index to make it positive
 2186:    assert(index + offset + 16*size >= 0);
 2187:    return (index + offset + 16*size) % size;  
 2188: }
 2189: 
 2190: __device__ __inline__ int nxq(int index, int size) {
 2191:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2192:    // to the index to make it positive
 2193:    assert(index + 16*size >= 0);
 2194:    return (index + 16*size) % size; 
 2195: }
