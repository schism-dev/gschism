 2343: 
 2344: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2345: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2346: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2347: // Only when ics == 2, the origin is at the element center.
 2348: 
 2349:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2350: 
 2351:    const Node *node = nodes[idxNode];
 2352: 
 2353:    if constexpr(ics==1) {
 2354:       return node->p;
 2355: 
 2356:    } else {
 2357:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2358: 
 2359:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2360: 
 2361:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2362:    }
 2363: 
 2364: }
 2365: 
 2366: 
 2367: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2368: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2369: 
 2370:    const int id1 = idx;
 2371:    const int id2 = nxq(1 + id1);
 2372:    const int id3 = nxq(2 + id1);
 2373: 
 2374:    if constexpr(ics==1) {
 2375:       x0 = nodes[id1]->p;
 2376:       x1 = nodes[id2]->p;
 2377:       x2 = nodes[id3]->p;
 2378: 
 2379:    } else {
 2380:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2381: 
 2382:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2383:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2384:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2385: 
 2386:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2387:       x1 = toVector2(frame.G2L(p1 - c));
 2388:       x2 = toVector2(frame.G2L(p2 - c));
 2389: 
 2390:    }
 2391: 
 2392: }
 2393: 
 2394: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2395: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2396: 
 2397:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2398: 
 2399: 
 2400: 
 2401:    if constexpr(ics==1) {
 2402:       x0 = nodes[0]->p;
 2403:       x1 = nodes[1]->p;
 2404:       x2 = nodes[2]->p;  
 2405:       x3 = nodes[3]->p;
 2406: 
 2407:    } else {
 2408:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2409: 
 2410:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2411:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2412:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2413:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2414: 
 2415:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2416:       x1 = toVector2(frame.G2L(p1 - c));
 2417:       x2 = toVector2(frame.G2L(p2 - c));
 2418:       x3 = toVector2(frame.G2L(p3 - c));
 2419:    }
 2420: 
 2421: }
 2422: 
 2423: 
 2424: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2425: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2426: // Returns the normal vector and the area of the element at this level
 2427:    
 2428:    double nx, ny, nz;
 2429: 
 2430:    if (isTri()) {
 2431:       // For triangles...
 2432: 
 2433:       // Indices of the nodes at level k, taking care of not going below the bed
 2434:       const int k0 = max(k, nodes[0]->kb);
 2435:       const int k1 = max(k, nodes[1]->kb);
 2436:       const int k2 = max(k, nodes[2]->kb);
 2437: 
 2438:       // Gets the element frame coordinates of the nodes at level k
 2439:       Point3 x0, x1, x2;
 2440:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2441:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2442:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2443:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2444: 
 2445:       } else {  // ics == 2
 2446:          Point2 h0, h1, h2;
 2447: 
 2448:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2449: 
 2450:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2451:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2452:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2453:       }
 2454: 
 2455:       const Vector3 n20 = x2 - x0;
 2456:       const Vector3 n10 = x1 - x0; 
 2457: 
 2458:       // Computes the cross product of vectors n20 and n10. 
 2459:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2460:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2461:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2462: 
 2463:   
 2464:    }
 2465:    else {
 2466:       // For quads...
 2467:       Point2 h0, h1, h2, h3;
 2468: 
 2469:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2470: 
 2471:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2472:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2473:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2474:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2475: 
 2476:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2477:       nx = n20.y*n31.z - n20.z*n31.y;
 2478:       ny = n20.z*n31.x - n20.x*n31.z;
 2479:       nz = n20.x*n31.y - n20.y*n31.x;
 2480: 
 2481:    }
 2482: 
 2483:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2484:    area3D = 0.5*len;
 2485: 
 2486:    const double inv_len = 1.0/len;
 2487: 
 2488:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2489: 
 2490: }
 2491: 
 2492: 
 2493: // Helper functions to get the 2D local node position for the Celestial walk
 2494: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2495:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2496:    const Node *node = getNodeInOrder(idx2);
 2497: 
 2498:    double z = 0.0;
 2499:    if constexpr(ics == 2) z = node->gz;
 2500:    
 2501:    Point3 p = toPoint3(node->p, z);
 2502: 
 2503:    return toPoint2(origSide->toLocalFrame(p));
 2504: }
 2505: 
 2506: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2507:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2508: }
 2509: 
 2510: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2511:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2512: // Computes the three per-side predicates needed for the celestial walk
 2513: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2514: //
 2515: // xt is in local frame coordinates for origSide if ics == 2.
 2516: //
 2517: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2518: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2519: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2520: // meaningless on triangles are masked to a safe value (see comments below).
 2521: {
 2522:    // Project all 4 corner positions once into the local 2D frame.
 2523:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2524:    // getLocalNodePosition only transforms/projects if ics == 2.
 2525:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2526:                         getLocalNodePosition(1, origSide), 
 2527:                         getLocalNodePosition(2, origSide), 
 2528:                         getLocalNodePosition(3, origSide)};
 2529: 
 2530:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2531:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2532:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2533:    // But still farther towards the target point from the current point.
 2534:    const Vector2 vt0 = xt - x0;
 2535:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2536:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2537:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2538: 
 2539:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2540:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2541: 
 2542: 
 2543: // if (origSide->idx == 2860848 && jlev == 46) {
 2544: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2545: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2546: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2547: // }
 2548:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2549:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2550:    //  here the orientation is baked into the corners array.)
 2551:    const int i3 = nxq(3);
 2552:    const Vector2 s0 = C[ 1] - C[ 0];
 2553:    const Vector2 s1 = C[ 2] - C[ 1];
 2554:    const Vector2 s2 = C[i3] - C[ 2];
 2555:    const Vector2 s3 = C[ 0] - C[i3];
 2556:    
 2557:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2558:    // The corners array is built from getNode in CCW order, so the orientation
 2559:    // is already correct and no ssign factor is needed in the formulas below.
 2560:    //
 2561:    // i3 = nxq(3): the index of the corner after side 2.
 2562:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2563:    //   Quad:     i3 == 3.
 2564:    //
 2565:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2566:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2567:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2568:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2569:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2570:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2571: 
 2572: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2573: 
 2574:    // For triangles, the corner after side 2 is the closing corner where
 2575:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2576:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2577:    // s0 for triangles, s3 for quads.
 2578:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2579: 
 2580:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2581:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2582:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2583:    //
 2584:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2585:    // result is false naturally. No sentinel needed.
 2586:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2587:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2588:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2589:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2590: 
 2591:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2592:    // on the "exit through side I" half of the corner cone, separated by the
 2593:    // approximate angular bisector of the celestial walk. The bisector is
 2594:    // perpendicular to the chord across the corner; the test is the sign of
 2595:    // (xt - corner_vertex) projected onto that chord.
 2596:    //
 2597:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2598:    // (the validity rule sets valid_3 = false), so its computed value for
 2599:    // triangles doesn't matter. No sentinel needed.
 2600:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2601:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2602:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2603:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2604: 
 2605: }
 2606: 
 2607: 
 2608: __inline__ __device__ double Element::computeSignedArea(void) const {
 2609:    // Compute the area of the element
 2610: 
 2611:    Point2 x0, x1, x2, x3;
 2612:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2613: 
 2614: 
 2615:    double res = signedArea(x0, x1, x2);
 2616: 
 2617:    // In the quad case we need to add the area of the other triangle.
 2618:    if (isQuad()) {
 2619:       x3 = getLocalHorizontalNodePosition(3);
 2620:       double ar1 = signedArea(x0, x2, x3);
 2621:       double ar2 = signedArea(x0, x1, x3);
 2622:       double ar3 = signedArea(x1, x2, x3);
 2623:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2624: 
 2625:       res += ar1;
 2626: 
 2627:    }
 2628: 
 2629:    return res;
 2630: }
 2631: 
 2632: 
 2633: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2634:                                                                 (nodes[1]->isDry2()) ||
 2635:                                                                 (nodes[2]->isDry2()) ||
 2636:                                                                 (isQuad() && nodes[3]->isDry2());
 2637: }
 2638: 
 2639: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2640:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2641: }
 2642: 
 2643: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2644:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2645: }
 2646: 
 2647: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2648:    // In boundary sides, the element 1 is nullptr
 2649:    return side->elems[1] == nullptr; 
 2650: }
 2651: 
 2652: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2653:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2654:    // For ics == 2, this function uses local frame coordinates.
 2655: 
 2656:    assert(isQuad());
 2657: 
 2658:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2659:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2660:    // where vxi, veta, vb are vectors and c is the center of the element.
 2661: 
 2662:    Point2 p0, p1, p2, p3;
 2663: 
 2664:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2665: 
 2666:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2667:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2668:    // vectors vxi and veta connect the centers of opposite sides
 2669:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2670:    // vb is zero for parallelogram elements.
 2671:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2672: 
 2673:    //  The bilinear mapping is:
 2674:    //      P(s,t) = C + s*U + t*V + s*t*W
 2675:    //
 2676:    //  where:
 2677:    //    C = centroid (average of four vertices)
 2678:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2679:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2680:    //    W = bilinear correction; measures deviation from parallelogram
 2681:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2682:    //        W = 0 for parallelogram elements.
 2683:    //
 2684:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2685:    //
 2686:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2687:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2688:    //
 2689:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2690:    //
 2691:    //  Geometrically, (L) projects everything onto the direction
 2692:    //  perpendicular to W, where the mapping is purely affine.
 2693:    //
 2694:    //  The dot product with nb retains the nonlinear term:
 2695:    //
 2696:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2697:    //
 2698:    //  Geometrically, (Q) projects onto the W direction, where
 2699:    //  the nonlinearity lives.
 2700:    //
 2701:    //  We solve (L) for whichever variable has the larger coefficient
 2702:    //  (better conditioned back-substitution), substitute into (Q),
 2703:    //  and get a scalar quadratic in the other variable.
 2704:    // ================================================================
 2705: 
 2706:    // ---- Basis vectors ----
 2707:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2708:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2709:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2710:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2711:    // W: nonlinear correction. Difference between quad and parallelogram.
 2712:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2713:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2714: 
 2715:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2716:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2717:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2718:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2719:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2720: 
 2721:    // ---- nb: direction parallel to W, L1-normalized ----
 2722:    // We don't need a unit vector -- just a well-scaled direction parallel
 2723:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2724:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2725:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2726:    //
 2727:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2728:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2729:    // and the quadratic solver takes its linear path (a ~ 0).
 2730:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2731:    const double inv_wlen = 1.0 / wlen1;
 2732:    const Vector2 nb = vb * inv_wlen;
 2733: 
 2734:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2735:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2736:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2737:    // What remains is a pure affine relationship between xi and eta.
 2738:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2739:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2740:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2741: 
 2742:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2743:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2744:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2745:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2746:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2747:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2748:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2749: 
 2750:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2751:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2752:    // minimizing round-off amplification.
 2753:    //
 2754:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2755:    // that uses predicated moves.
 2756:    //
 2757:    // if (fabs(Ls) > fabs(Lt)) {
 2758:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2759:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2760:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2761:    //    const double A = -Qw * Lt;
 2762:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2763:    //    const double C =  Qs * Lp - Qp * Ls;
 2764: 
 2765:    //    double eta1, eta2;
 2766:    //    solveQuadratic(A, B, C, eta1, eta2);
 2767: 
 2768:    //    // Pick root with smaller |eta| (domain centered at 0).
 2769:    //    // Ternary-> predicated move, no branch divergence.
 2770:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2771: 
 2772:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2773:    //    xi = (Lp - Lt * eta) / Ls;
 2774: 
 2775:    // } else {
 2776:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2777:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2778:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2779:    //    const double A = -Qw * Ls;
 2780:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2781:    //    const double C =  Qt * Lp - Qp * Lt;
 2782: 
 2783:    //    double xi1, xi2;
 2784:    //    solveQuadratic(A, B, C, xi1, xi2);
 2785: 
 2786:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2787: 
 2788:    //    eta = (Lp - Ls * xi) / Lt;
 2789:    // }
 2790:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2791:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2792:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2793:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2794:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2795: 
 2796:    // Quadratic:  A*r^2 + B*r + C = 0
 2797:    // (same formula for both cases, just with swapped coefficients)
 2798:    const double A = -Qw * Lb;
 2799:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2800:    const double C =  Qa * Lp - Qp * La;
 2801: 
 2802:    double r1, r2;
 2803:    solveQuadratic(A, B, C, r1, r2);
 2804: 
 2805:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2806:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2807: 
 2808:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2809:    const double other = (Lp - Lb * r) / La;
 2810: 
 2811:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2812:    xi  = solve_s ? r     : other;
 2813:    eta = solve_s ? other : r;
 2814: 
 2815: 
 2816:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2817:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2818:    eta = fmin(1.0, fmax(eta, -1.0));
 2819: 
 2820:    // ---- Shape functions ----
 2821:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2822:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2823:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2824:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2825:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2826:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2827:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2828:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2829: 
 2830:    return true;
 2831: }
 2832: 
 2833: /**
 2834:    Compute the shape coordinates of the point (xt,yt) in the element.
 2835:    @param xt (input): x-coordinate of the point
 2836:    @param shpCoords (output): shape coordinates of the point
 2837:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2838:    @return true if the point is inside the element, false otherwise
 2839: **/
 2840: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2841: 
 2842:    // Compute the shape coordinates of the point xt in the element.
 2843:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2844:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2845:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2846:    // from the local frame, so use additional check.
 2847: 
 2848: 
 2849: 
 2850:    if (isTri()) { // Triangular element
 2851: 
 2852:       // Horizontal local node coordinates. 
 2853:       // Point2 x0, x1, x2;
 2854:       // getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2855: 
 2856: Point2 x0 = nodes[0]->p;
 2857: Point2 x1 = nodes[1]->p;
 2858: Point2 x2 = nodes[2]->p;
 2859: 
 2860: if constexpr(ics == 2) {
 2861: const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2862: const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2863: const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2864: x0 = toPoint2(origSide->toLocalFrame(p0));
 2865: x1 = toPoint2(origSide->toLocalFrame(p1));
 2866: x2 = toPoint2(origSide->toLocalFrame(p2));
 2867: }
 2868: 
 2869:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2870:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2871:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2872:       shpCoords[3] = 0.0;
 2873: 
 2874: 
 2875:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2876:       const bool res = (tmpmin >= -small);  
 2877:       
 2878:       // When to fix the negative shape coordinates?
 2879:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2880: 
 2881:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2882:       // then we fix the negative shape coordinates.
 2883:       if ((tmpmin < 0) && fix) {
 2884: 
 2885:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2886:          // keeping the sum of the shape coordinates equal to 1.
 2887:          // I have tested and compared the new algorithm with the old one, and they give
 2888:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2889:          // The new algorithm should be faster since it is branchless.
 2890:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2891:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2892: 
 2893:          shpCoords[0] = (shpCoords[0] + a)*b;
 2894:          shpCoords[1] = (shpCoords[1] + a)*b;
 2895:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2896: 
 2897:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2898:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2899:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2900: 
 2901:          // Update the point coordinates for the new shape coordinates
 2902:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2903:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2904: 
 2905:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2906: 
 2907:       }
 2908: 
 2909:       // Return true if the point is inside the element
 2910:       return res;      
 2911:    }
 2912:    else {
 2913:       assert(isQuad() && "computeShapeCoords");
 2914: 
 2915:       // Horizontal local node coordinates. 
 2916:       // Point2 x0, x1, x2, x3;
 2917:       // getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 2918: Point2 x0 = nodes[0]->p;
 2919: Point2 x1 = nodes[1]->p;
 2920: Point2 x2 = nodes[2]->p;
 2921: Point2 x3 = nodes[3]->p;
 2922: 
 2923: if constexpr(ics == 2) {
 2924: const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2925: const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2926: const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2927: const Point3 p3 = toPoint3(x3, nodes[3]->gz);
 2928: x0 = toPoint2(origSide->toLocalFrame(p0));
 2929: x1 = toPoint2(origSide->toLocalFrame(p1));
 2930: x2 = toPoint2(origSide->toLocalFrame(p2));
 2931: x3 = toPoint2(origSide->toLocalFrame(p3));
 2932: }
 2933: 
 2934: 
 2935:       const double a0 = signedArea(x0, x1, xt);
 2936:       const double a1 = signedArea(x1, x2, xt);
 2937:       const double a2 = signedArea(x2, x3, xt);
 2938:       const double a3 = signedArea(x3, x0, xt);
 2939: 
 2940:       const double minArea = min4(a0, a1, a2, a3);
 2941:       
 2942:       const bool res = (minArea > -small*area);
 2943: 
 2944:       // When to fix the negative shape coordinates?
 2945:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2946: 
 2947:       double xi, eta;      
 2948:       inverseBilinearQuad(xt, xi, eta, shpCoords);
 2949: 
 2950:       if (fix) {
 2951:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2952:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2953:          xt.x = interpolate(shpCoords, xn);
 2954:          xt.y = interpolate(shpCoords, yn);
 2955:       }
 2956: 
 2957:       return res;
 2958:    }
 2959: 
 2960: 
 2961:    assert(false && "computeShapeCoords: should never reach this point");
 2962:    return false;  // Never reached
 2963: 
 2964: }
 2965: 
 2966: 
 2967: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2968: // Convert shape coordinates to cartesian coordinates
 2969: 
 2970:    if (isTri()) {
 2971:       // Triangular element
 2972: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2973:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2974:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2975:    }
 2976:    else {
 2977:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2978:    }
 2979: 
 2980: }
 2981: 
 2982: 
 2983: 
 2984: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 2985:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 2986:    
 2987:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 2988: }
 2989: 
 2990: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 2991:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 2992:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 2993:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 2994:    return area * dot(gradPhi[i], gradPhi[j]);
 2995: }
 2996: 
 2997: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2998:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 2999:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3000:    // The formula for the integral is:
 3001:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3002:    
 3003:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3004:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3005:    const double eta_sum  = eta_n(i) + eta_n(j);
 3006:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3007: 
 3008:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3009:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3010: 
 3011: 
 3012:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3013: }
 3014:    
 3015: 
 3016: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3017:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3018:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3019:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3020:    // The formula is also based on the identity:
 3021:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3022:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3023: 
 3024:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3025: 
 3026: 
 3027: 
 3028:    double res = 0.0;
 3029:    
 3030:    // Quadrature points in xi and eta coordinates
 3031:    #pragma unroll
 3032:    for (int i = 0; i < 4; i++) {
 3033:       // For each quadrature point...
 3034: 
 3035:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3036:       const double eta = p.x;
 3037:       const double xi  = p.y;
 3038: 
 3039:       // Jacobian entries at the Gauss point p
 3040:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3041:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3042:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3043:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3044: 
 3045:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3046:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3047: 
 3048:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3049:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3050:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3051:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3052:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3053: 
 3054:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3055:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3056:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3057:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3058:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3059: 
 3060:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3061:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3062:    }
 3063: 
 3064:    return res;
 3065: }
 3066: 
 3067: 
 3068: /**  Interpolate velocities at a given point (xt,yt,zt)
 3069: 
 3070:    @param xt, yt, zt: coordinates of the point to interpolate
 3071:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3072: 
 3073:    This is done in four steps:
 3074: 
 3075:    1. Find the shape coordinates for the final position in the element.
 3076:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3077:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3078:       z levels at xt, yt at each step.   
 3079:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3080:       horizontally and vertically.
 3081: **/
 3082: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3083:    // Interpolate the velocities at the point xt. 
 3084:    // This function works the same for triangular and quadrilateral elements.
 3085:    double shpCoord[4];
 3086:    Vector3 u_int;
 3087: 
 3088: 
 3089:    // First step is to compute the shape coordinates of (xt,yt)
 3090: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3091:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3092: 
 3093:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3094: 
 3095:    // Second step is to find the level that contains zt
 3096:    // Uses a binary search to find the level
 3097:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3098:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3099:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3100:    int R = nvrt - 1;
 3101: 
 3102:    // Get the z coordinates at the nodes of the element at the levels L and R
 3103:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3104:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3105:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3106: 
 3107: 
 3108:    double zL = interpolate(shpCoord, zLAtNodes);
 3109:    double zR = interpolate(shpCoord, zRAtNodes);
 3110: 
 3111:    // Interpolates vertically the velocities
 3112:    double wght1, wght2;
 3113:    if (xt.z <= zL) {
 3114:       wght1 = 1.0;
 3115:       wght2 = 0.0;
 3116:       xt.z = zL;
 3117:    }
 3118:    else if (xt.z >= zR) {
 3119:       wght1 = 0.0;
 3120:       wght2 = 1.0;
 3121:       xt.z = zR;
 3122:    }
 3123:    else {
 3124:       // Perform a binary search to find the levels between L and R that contain xt.z
 3125:       while (R - L > 1) {
 3126:          int M = (L + R) / 2.0;
 3127: 
 3128:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3129:          double zM = interpolate(shpCoord, zMAtNodes);
 3130:          if (zM < xt.z) 
 3131:          {
 3132:             L = M;
 3133:             zL = zM;
 3134:          }
 3135:          else 
 3136:          {
 3137:             R = M;
 3138:             zR = zM;
 3139:          }
 3140:       }
 3141:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3142:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3143: 
 3144:       wght2 = (xt.z - zL)/(zR - zL);
 3145:       wght1 = 1.0 - wght2;
 3146: 
 3147:    }
 3148: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3149: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3150:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3151:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3152:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3153:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3154: 
 3155:    // Project the velocity from the local frame to the origSide frame
 3156:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3157:    u_int = {uv.x, uv.y, w};
 3158: 
 3159:    // Neither of the interpolated velocities should be NaN
 3160:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3161: 
 3162:    return u_int;
 3163: 
 3164: }
 3165: 
 3166: 
 3167: 
 3168: 
 3169: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3170: 
 3171:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3172:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3173:    const Node *n1 = side->n1;
 3174:    const Node *n2 = side->n2;
 3175: 
 3176:    bool n1_match = (n1->nodeBnd->segment == segment);
 3177:    bool n2_match = (n2->nodeBnd->segment == segment);
 3178: 
 3179:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3180:    if (n1_match && n2_match) {
 3181:       return 0.5;
 3182:    } else if (n1_match) {
 3183:       return 1.0;
 3184:    } else if (n2_match) {
 3185:       return 0.0;
 3186:    }
 3187: 
 3188:    return 0.0;
 3189: }
 3190: 
 3191: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3192: 
 3193: 
 3194: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3195: 
 3196:    const double w1 = getBoundaryArrayValueWeight();
 3197:    const double w2 = 1.0 - w1;
 3198:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3199:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3200: 
 3201:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3202: }
 3203: 
 3204: 
 3205: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3206:    const double w1 = getBoundaryArrayValueWeight();
 3207:    const double w2 = 1.0 - w1;
 3208:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3209:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3210: 
 3211:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3212: 
 3213: }
 3214: 
 3215: 
 3216: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3217:    // Returns the value of the velocity at the side center
 3218:    const double w1 = getBoundaryArrayValueWeight();
 3219:    const double w2 = 1.0 - w1;
 3220:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3221:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3222: 
 3223:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3224: }
 3225: 
 3226: 
 3227: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3228:    // Returns the value of the normal component of the velocity at the side center
 3229:    const double w1 = getBoundaryArrayValueWeight();
 3230:    const double w2 = 1.0 - w1;
 3231:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3232:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3233: 
 3234:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3235: }
