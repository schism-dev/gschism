 2018:    template<typename T>
 2019:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2020:       // Get the values of the field at the nodes of the element
 2021:       res[0] = nodes[0]->*field;
 2022:       res[1] = nodes[1]->*field;
 2023:       res[2] = nodes[2]->*field;
 2024:       if (isQuad()) res[3] = nodes[3]->*field;
 2025:       else          res[3] = T();
 2026:    }
 2027: 
 2028:    template<typename T>
 2029:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2030: 
 2031:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2032:       // Get the values of the field at the nodes of the element
 2033:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2034:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2035:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2036:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2037:       else          res[3] = T();
 2038:    }    
 2039: 
 2040:    template<typename T>
 2041:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2042: 
 2043:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2044: 
 2045:       // Get the values of the func at the nodes of the element
 2046:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2047:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2048:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2049:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2050:       else          res[3] = T();  // This is 0.0 or a zero vector
 2051: 
 2052:    }      
 2053: 
 2054:    template<typename T>
 2055:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2056:       // Get the values of the field at the nodes of the element
 2057:       res[0] = sides[0]->*field;
 2058:       res[1] = sides[1]->*field;
 2059:       res[2] = sides[2]->*field;
 2060:       if (isQuad()) res[3] = sides[3]->*field;
 2061:       else          res[3] = T();
 2062:    }
 2063: 
 2064:    template<typename T>
 2065:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2066: 
 2067:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2068: 
 2069:       // Get the values of the field at the nodes of the element
 2070:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2071:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2072:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2073:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2074:       else          res[3] = T();
 2075:    }    
 2076: 
 2077:    template<typename T>
 2078:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2079: 
 2080:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2081: 
 2082:       // Get the values of the func at the nodes of the element
 2083:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2084:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2085:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2086:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2087:       else          res[3] = T();  // This is 0.0 or a zero vector
 2088: 
 2089:    }      
