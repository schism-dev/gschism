 3920: 
 3921: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3922:    // Computes the z coordinate at level k.
 3923:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3924:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3925:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3926:    // used 
 3927: 
 3928:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3929:    
 3930:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3931: 
 3932:    if (isDry2()) return 0.0;  
 3933: 
 3934:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3935: 
 3936:    if constexpr(ivcor == 2) {
 3937: 
 3938:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3939:       const double h_c = mesh->h_c;
 3940:       const double theta_f = mesh->theta_f;
 3941:       const double sinh_theta_f = mesh->sinh_theta_f;
 3942: 
 3943: 
 3944:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3945:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3946:       // once per time step/node. XXXX
 3947:       // CHECK: updateZCoordData
 3948: 
 3949:       //  To simplify comparisons, I define index versions of count variables.
 3950:       if      (k == ivrt)     return eta2; 
 3951:       else if (k == izlev)    return -hmod2;
 3952:       else if (k == kb)       return -depth;
 3953:       else if (k < izlev)     return mesh->ztot[k];
 3954:       else if (k > izlev) {
 3955:          const int ksig = k - izlev;
 3956: 
 3957:          if (hmod2 <= h_c) {
 3958:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3959: 
 3960:          } 
 3961:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3962:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3963:             assert(false && "compZCoord: invalid h_c\n");
 3964:          } 
 3965:          else {
 3966:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3967:                    h_c * mesh->sigma[ksig] + 
 3968:                    (hmod2 - h_c) * mesh->cs[ksig];
 3969:          }
 3970:       } else { 
 3971:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3972:       }
 3973: 
 3974:    }
 3975:    else {  // if constexpr(ivcor == 1)
 3976:       if (k <= kb)        return -depth; 
 3977:       else if (k == ivrt) return eta2;
 3978:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3979: 
 3980:    }
 3981:    
 3982:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3983:    return 0.0;
 3984: }
 3985: 
 3986: 
 3987: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3988:    // Computes the bottom drag Cd based on the selected nchi
 3989: 
 3990:    if constexpr(nchi == 0) {
 3991:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3992:       Cd = drag;  // Read from drag file
 3993: 
 3994:    } else if constexpr(nchi == 1) {
 3995:       // 
 3996: 
 3997:       bool ltmp = false; // for WBL iteration
 3998: 
 3999:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4000:       if (isDry || (rough == 0.0)) {
 4001:          Cd = 0.0;
 4002: 
 4003:       } else { //roughness >0 
 4004:          
 4005:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4006: 
 4007:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4008: 
 4009:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4010: 
 4011:       } // if rough
 4012: 
 4013:    } else if constexpr(nchi == -1) {
 4014:    // Manning 
 4015:  
 4016:       const double htot = max(hmin_man, htot2()); 
 4017:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4018: 
 4019:    } else {
 4020:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4021:       
 4022:    } // if nchi
 4023: 
 4024: }
 4025: 
 4026: 
 4027: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4028:    // Checks if a side in on the boundary
 4029:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4030: 
 4031:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4032:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4033: 
 4034:    // Indices of the nodes that form the side
 4035:    //
 4036:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4037:    const int n1 = side.n1->idx;
 4038:    const int n2 = side.n2->idx;
 4039:    isLand = false;
 4040:    
 4041: 
 4042:    // Check if the side is on a land boundary
 4043:    for (int i = 0; i < nland; i++) {
 4044:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4045:          // Consecutive nodes in the land boundary segment
 4046:          const int b1 = ilnd[i + j*nland];
 4047:          const int b2 = ilnd[i + (j + 1)*nland];
 4048: 
 4049:          assert(b1 != -1 && b2 != -1);
 4050: 
 4051:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4052:             
 4053:             isLand = true;
 4054:             return i;
 4055:          }
 4056:       }
 4057:    }
 4058: 
 4059:    // Check if the side is on an open boundary
 4060:    for (int i = 0; i < nope; i++) {
 4061:       for (int j = 0; j < nond[i] - 1; j++) {
 4062:          // Consecutive nodes in the open boundary segment
 4063:          const int b1 = iond[i + j*nope];
 4064:          const int b2 = iond[i + (j + 1)*nope];
 4065: 
 4066:          assert(b1 != -1 && b2 != -1);
 4067: 
 4068:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4069:             isLand = false;
 4070:             return i;
 4071:          }
 4072:       }
 4073:    }
 4074: 
 4075:    // Check that the nodes are not both on the boundary
 4076:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 4077:         && "side not in ilnd/iond but both nodes are boundary" );
 4078: 
 4079:    return -1;
 4080: }
 4081: 
 4082: 
 4083: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4084:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4085:                                     double *wind_rotate_angle, 
 4086:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4087:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4088:                                     int16_t *nodePermutationSort, double *crs_data,
 4089:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4090:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4091:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4092:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4093:                                     double *drag, double *roughness, double *rmanning, 
 4094:                                     double *diffmin, double *diffmax,
 4095:                                     int *kb, double *localSigma) {
 4096: 
 4097:    NODE(pnode);  
 4098:    const int i = idx_node;
 4099:    const int iglobal = globalNodeIndices[i];
 4100:    Node &node(*pnode);
 4101: 
 4102:    node.idx = iglobal;
 4103:    node.part = localNodePart[iglobal];
 4104: 
 4105:    // It is important to differentiate between the global and local "start" indices because they
 4106:    // play different, but related, roles in this code. The global "start" indices are used
 4107:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4108:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4109:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4110:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4111:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4112:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4113:    node.numNodes = idxNodeEnd - idxNodeStart;
 4114:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4115: 
 4116:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4117:    node.coeffRow = crs_data + rowStart; 
 4118: 
 4119:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4120: 
 4121: 
 4122: 
 4123:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4124:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4125:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4126:    node.numElements = idxElemEnd - idxElemStart;
 4127:    node.elements = nodeNeighElems + idxElemLocalStart;
 4128: 
 4129: 
 4130:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4131:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4132:       const int partNode = localNodePart[idxNodeGlobal]; 
 4133:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4134: 
 4135:       Node *node_ptr = nodes[partNode] + idxNode;
 4136:       
 4137:       nodeNeighNodes[idxLocal] = node_ptr;
 4138:    }
 4139: 
 4140: 
 4141:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4142:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4143:       const int partElem = localElemPart[idxElemGlobal];
 4144:       const int idxElem  = localElemIndices[idxElemGlobal];
 4145: 
 4146:       Element *elem_ptr = elems[partElem] + idxElem;
 4147: 
 4148:       nodeNeighElems[idxLocal] = elem_ptr;
 4149:    }      
 4150: 
 4151:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4152:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4153: 
 4154:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4155: 
 4156:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4157:    if constexpr(ics == 1) {
 4158:       node.p.x   = node_coords[i * 3];
 4159:       node.p.y   = node_coords[i * 3 + 1];
 4160:       node.gz = 0.0;
 4161: 
 4162:       if (use_ll) {                                    // <-- add
 4163:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4164:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4165:       }  
 4166: 
 4167:    } else {
 4168:       const double lon = deg2rad*node_coords[i * 3];
 4169:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4170: 
 4171:       Point3 p = computeXYZfromLatLon(lat, lon);
 4172:       node.p = toVector2(p);
 4173:       node.gz = p.z;
 4174:       node.lon = lon;
 4175:       node.lat = lat;
 4176: 
 4177:       #ifdef USE_FRAMES
 4178:       node.setFrame(lat, lon);
 4179:       #endif
 4180: 
 4181: 
 4182:    }
 4183: 
 4184:    node.depth = node_coords[i * 3 + 2];
 4185: 
 4186:    node.numSides = 0;
 4187: 
 4188:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4189:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4190:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4191:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4192:    else assert(false && "populateNodes: selected nchi not implemented.");
 4193: 
 4194:    // Populate the diffmin and diffmax values read from the files.
 4195:    // (Only used for GLS, GOTM, and SedimentMix.)
 4196:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4197: 
 4198:    if constexpr(ivcor == 1) 
 4199:    {  
 4200:       node.kb = kb[iglobal];
 4201: 
 4202:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4203:    }
 4204: 
 4205:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4206:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4207:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4208:    for (int k = 0; k < nvrt; k++) node.dfh[k] = dfh0;   // XXXX (does it need to exist when transport is not enabled?)
 4209:    for (int k = 0; k < nvrt; k++) {
 4210:       node.turb.tke[k]    = node.turb.tkemin();
 4211:       node.turb.mxl[k]    = node.turb.mxlmin(node.depth);
 4212:       node.turb.nu_tke[k] = node.turb.diffmin;
 4213:       node.turb.nu_phi[k] = node.turb.diffmin;
 4214:    }
 4215: 
 4216:    
 4217:    // Links the node to the boundary information
 4218:    if (isbnd[iglobal] >= 0) {
 4219:      
 4220:       // Get the index of the node boundary
 4221:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4222: 
 4223:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4224:       node.nodeBnd->node = &node;
 4225: 
 4226:       node.nodeBnd->sideBnd1 = nullptr;
 4227:       node.nodeBnd->sideBnd2 = nullptr;
 4228: 
 4229:       if (isbnd[iglobal]>=0) {
 4230: 
 4231:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4232:          
 4233:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4234:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4235: 
 4236:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4237:          node.nodeBnd->segment->clen  = nan("1");
 4238:          node.nodeBnd->segment->carea = nan("1");
 4239: 
 4240:       }
 4241:    } else {
 4242: 
 4243:       node.nodeBnd = nullptr; // For internal nodes
 4244: 
 4245:       if (isbnd[iglobal] == landSegment) {
 4246:          node.nodeBnd = landBoundaryNode;
 4247:          node.nodeBnd->segment = landBoundarySegment;
 4248:       }
 4249:       
 4250:    }
 4251:    
 4252:    // XXXX GAUSSIAN HILL VELOCITIES
 4253:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4254:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4255:          constexpr double rot_per = 3000.0;
 4256:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4257:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4258:       // XXXXX
 4259:    #endif
 4260: 
 4261: }
 4262: 
 4263: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4264:    
 4265:    NODE(node);
 4266:    const int localIdx = idx_node;
 4267: 
 4268: 
 4269:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4270:    int16_t *csrSlot = node->csrSlot;  
 4271: 
 4272:    // Simply count the number of nodes with a smaller global index than the current node.
 4273:    // It accounts for the diagonal element.
 4274:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4275:    // local index, but taking into account all the partitions (in order).
 4276:    for (int i = 0; i < node->numNodes; ++i) {
 4277:       const int col = node->nodes[i]->packedIndex();
 4278:       int16_t idx = 0;
 4279: 
 4280:       //Takes care of the diagonal element.
 4281:       if (node->packedIndex() < col) ++idx;          
 4282: 
 4283:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4284:       csrSlot[i] = idx;
 4285:    }
 4286: 
 4287:    // Find the diagonal element in the CRS matrix.
 4288:    int16_t idxDiag = 0;
 4289:    for (int j = 0; j < node->numNodes; ++j)
 4290:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4291: 
 4292:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4293: 
 4294:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4295:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4296: 
 4297:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4298:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4299:    crs_indptr[localIdx] = rowStart;
 4300: 
 4301:    // Fills crs_indices array using the per-partition indexing.
 4302:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4303:    crs_indices[rowStart + d] = node->packedIndex();  
 4304:    for (int j = 0; j < node->numNodes; ++j) {
 4305:       Node *nb = node->nodes[j];
 4306:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4307:    }
 4308: 
 4309: 
 4310: }
 4311: 
 4312: 
 4313: 
 4314: 
 4315: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4316:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4317:                                     double *wind_rotate_angle,   
 4318:                                     int *isdel, int *isidenode, int *isbnd,
 4319:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4320:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4321:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4322:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4323:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4324:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4325:                                     double *drag, double *roughness) {
 4326: 
 4327: 
 4328:    SIDE(pside);
 4329:    Side &side(*pside);
 4330:    const int i = idx_side;
 4331:    const int iglobal = globalSideIndices[i];
 4332:    side.idx = iglobal;  
 4333:    
 4334:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4335:    const double fc   = 2.0*omega_e*sin(sfea0);
 4336:    const double beta = 2.0*omega_e*cos(sfea0);
 4337: 
 4338:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4339: 
 4340:    // finding the pointer to the nodes that form the side
 4341:    const int idx_n1 = isidenode[iglobal*2];
 4342:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4343: 
 4344: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4345: 
 4346:    const int locidx_n1 = localNodeIndices[idx_n1];
 4347:    const int locidx_n2 = localNodeIndices[idx_n2];
 4348:    const int part_n1 =   localNodePart[idx_n1];
 4349:    const int part_n2 =   localNodePart[idx_n2];
 4350: 
 4351: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4352: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4353: 
 4354:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4355:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4356: 
 4357: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4358: 
 4359:    // Counts the number of sides connected to each node
 4360:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4361:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4362: 
 4363:    // Side boundary type
 4364:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4365:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4366: // if (i == 0) printf("populateSides: 2\n");
 4367: 
 4368:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4369:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4370:    {
 4371:       bool isLand = false;
 4372:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4373:       
 4374:       if (isbs > -1) {
 4375:          // assert(isLand || isbs>=0);
 4376:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4377: 
 4378:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4379: 
 4380:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4381:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4382: 
 4383:          assert (isLand == side.sideBnd->segment->isLand);
 4384:          
 4385:          side.sideBnd->side = &side;
 4386: 
 4387:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4388:          n1bnd->linkSideBoundary(side.sideBnd);
 4389:          n2bnd->linkSideBoundary(side.sideBnd);
 4390: 
 4391:       }
 4392:       else {
 4393:          side.sideBnd = nullptr;
 4394:       }
 4395:    }
 4396:    else 
 4397:    {
 4398:       side.sideBnd = nullptr;
 4399:    }
 4400: 
 4401: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4402: 
 4403:    // finding the pointer to the elements that share the side
 4404:    const int idx_e1 = isdel[iglobal*2];
 4405:    const int idx_e2 = isdel[iglobal*2 + 1];
 4406: 
 4407:    if (idx_e1 > -1) {
 4408:       const int locidx_e1 = localElemIndices[idx_e1];
 4409:       const int part_e1 =  localElemPart[idx_e1];
 4410:       side.elems[0] = elems[part_e1] + locidx_e1;
 4411: 
 4412:    }
 4413:    else {
 4414:       side.elems[0] = nullptr;
 4415:    }
 4416: 
 4417: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4418: 
 4419:    if (idx_e2 > -1) {
 4420:       const int locidx_e2 = localElemIndices[idx_e2];
 4421:       const int part_e2 =  localElemPart[idx_e2];
 4422:       side.elems[1] = elems[part_e2] + locidx_e2;
 4423:    }
 4424:    else {
 4425:       side.elems[1] = nullptr;
 4426:    }
 4427: 
 4428: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4429: 
 4430:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4431:       
 4432:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4433:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4434:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4435:          
 4436:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4437:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4438:       // printf("sideBnd: %p\n", side.sideBnd);
 4439:       // assert(false && "Side has no elements and no boundary");
 4440:    }
 4441:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4442: 
 4443:    // Compute the center of the side
 4444:    side.center = 0.5*(side.n1->p + side.n2->p);
 4445: 
 4446:    #ifdef USE_FRAMES
 4447:    side.setFrame();
 4448:    #endif
 4449: 
 4450: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4451: 
 4452:    // Normal, unitary vector to the side
 4453:    if constexpr(ics == 1) {
 4454:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4455:       side.n = normalize(side.n);
 4456:    }
 4457:    else {
 4458:       // Unit side vector in 3D cartesian coordinates
 4459:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4460: 
 4461:       nSide = normalize(nSide);
 4462: 
 4463:       // Its cross product with the unit local z-axis vector (nUp) is the
 4464:       // normal vector we are looking for.
 4465:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4466: 
 4467:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4468:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4469:       side.n = -normalize(n2D); 
 4470: 
 4471:    }
 4472: 
 4473: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4474: 
 4475:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4476:    side.shapiro = shapiro0;
 4477: 
 4478:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4479:    // XXXX
 4480:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4481:    constexpr double rot_per=3000.0;
 4482:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4483:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4484:    // XXXXX      
 4485:    #endif
 4486:    // Compute the z level at the center of the side
 4487:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4488:    
 4489:    // Compute the length of the side
 4490:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4491: 
 4492: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4493: 
 4494:    // Compute the Coriolis coefficient
 4495: 
 4496:    if constexpr(ncor == -1 || ncor == 0) {
 4497:       side.coriolis = coricoef;
 4498:    }
 4499:    else {
 4500:       const double sphi = side.lat();  // Latitude at the center of the side
 4501: 
 4502:       assert(use_ll && "use_ll must be true when ncor > 0");
 4503: 
 4504:       if constexpr(ics == 1) {
 4505:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4506:       }
 4507:       else { // ics == 2
 4508:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4509:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4510:       }
 4511: 
 4512:    }
 4513: 
 4514: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4515: 
 4516: }
 4517: 
 4518: 
 4519: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4520:    double *node_coords, double *node_coords_ll, bool use_ll,
 4521:    double *wind_rotate_angle,   
 4522:    int *isdel, int *isidenode, int *isbnd,
 4523:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4524:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4525:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4526:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4527:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4528:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4529:    double *drag, double *roughness) {
 4530: 
 4531:    ELEM(pelem);
 4532:    Element &elem(*pelem);
 4533:    const int i = idx_elem;
 4534: 
 4535:    elem.idx = i;
 4536: 
 4537:    for (int j = 0; j < i34[i]; j++) {
 4538:       const int idxNode = elnode[i*4 + j];  
 4539:       const int idxSide = elside[i*4 + j];
 4540:       
 4541:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4542:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4543: 
 4544:       // Find the neighboring element  
 4545:       if (elem.sides[j]->elems[0] == &elem) {
 4546:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4547:       }
 4548:       else {
 4549:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4550:       }
 4551:       
 4552:    }
 4553: 
 4554:    elem.i34 = i34[i];
 4555: 
 4556:    // Compute the barycenter of the element and its depth
 4557:    elem.center = {0.0, 0.0};
 4558:    elem.depth = 1e10;
 4559:    for (int j = 0; j < i34[i]; j++) {
 4560: 
 4561:       elem.center += elem.nodes[j]->p/i34[i];
 4562:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4563:    }
 4564: 
 4565:    #ifdef USE_FRAMES
 4566:    elem.setFrame();
 4567:    #endif
 4568: 
 4569:    elem.area = elem.computeSignedArea(); 
 4570:    elem.radius = sqrt(elem.area)/pi; 
 4571:    
 4572:    // Determines which way the normal vector to each side is oriented.
 4573:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4574:    for (int j = 0; j < i34[i]; j++)  
 4575:    {
 4576:       if (elem.sides[j]->elems[0] == &elem) {
 4577:          elem.ssign[j] =  1.0;
 4578:       }
 4579:       else {
 4580:          elem.ssign[j] = -1.0;
 4581:       }
 4582: 
 4583:    }
 4584: 
 4585:   
 4586: 
 4587:    // Derivatives of shape functions
 4588:    //  For ics=2, this is done in the element frame
 4589:    //  For quads, the derivative is evaluated at centroid
 4590:    for (int j = 0; j < elem.i34; j++) {
 4591:       const double area = elem.area;
 4592:       const int id2 = elem.nxq(1 + j);
 4593:       const int id3 = elem.nxq(2 + j);
 4594:       const int id4 = elem.nxq(3 + j);
 4595:       if (elem.isTri()) {
 4596:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4597:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4598:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4599:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4600:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4601:          // And so on for the other shape functions.
 4602: 
 4603:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4604:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4605:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4606: 
 4607:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4608:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4609: 
 4610:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4611: 
 4612:       }
 4613:       else  { // Quad, the derivatives are evaluated at the centroid
 4614: 
 4615:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4616:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4617:          // ...
 4618:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4619: 
 4620:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4621:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4622:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4623: 
 4624:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4625:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4626: 
 4627:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4628: 
 4629:       } // if Tri/Quad
 4630: 
 4631:    } // for j   
 4632:    
 4633:    
 4634: 
 4635: }
 4636: 
 4637: 
 4638: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4639:                                             double *emo, double *efa, 
 4640:                                             double *umo, double *ufa, 
 4641:                                             double *vmo, double *vfa,
 4642:                                             int *ifltype, int *iettype, double *qthcon) {
 4643: 
 4644:    NODE_BND(nodeBnd);
 4645:    const int idx = idx_node_bnd;    
 4646: 
 4647:    nodeBnd->idx = idx;
 4648: 
 4649:    // Need to find the segment index and the index of the node on the segment
 4650:    int idxNode = -1;
 4651:    int iseg, i;
 4652:    for (iseg = 0; iseg < nope; iseg++) {
 4653:       // for each segment...
 4654:       for (i = 0; i < nond[iseg]; i++) {
 4655:          idxNode = iond[iseg + i*nope];
 4656:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4657:          
 4658:       }
 4659:    }
 4660: 
 4661:    assert(iseg < nope && "iseg is out of bounds");
 4662: 
 4663: found: // Jumped here when the node was found
 4664: 
 4665:    nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4666:    nodeBnd->elbc = 0.0;
 4667: 
 4668:    nodeBnd->segment->ifltype = ifltype[iseg];
 4669:    nodeBnd->segment->iettype = iettype[iseg];
 4670:    nodeBnd->segment->qthcon  = qthcon[iseg];
 4671: 
 4672:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4673: 
 4674:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4675: 
 4676:       nodeBnd->efa[jfr] = efa[idx2];
 4677:       nodeBnd->emo[jfr] = emo[idx2];
 4678:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4679:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4680: 
 4681:    }
 4682:         
 4683: 
 4684: }
 4685: 
 4686: __device__ void Mesh::populateBoundarySideLinks(void) {
 4687: 
 4688:    SIDE_BND(sideBnd);
 4689: 
 4690:    const Side *side = sideBnd->side;
 4691: 
 4692:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4693:    // and the rightSide is the side s that has s->n1 == side->n2
 4694:    for (int i = 0; i < mesh->nbs; i++) {
 4695: 
 4696:       Side *s = &mesh->localSideData[i];
 4697: 
 4698:       if (s == side) continue;  // Do not link the side to itself
 4699:    
 4700:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4701:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4702:    }
 4703:    
 4704: }
 4705: 
 4706: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4707:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4708:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4709:                 int *isdel, int *isidenode, int *isbnd,
 4710:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4711:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4712:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4713:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4714:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4715:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4716:                 double *drag, double *roughness,
 4717:                 double *emo, double *efa, 
 4718:                 double *umo, double *ufa, 
 4719:                 double *vmo, double *vfa) {
 4720: 
 4721:    printf("Populating mesh for partition %d\n", partNum);
 4722: 
 4723:    // XXXXXX THIS function does almost nothing. 
 4724: 
 4725:    nbs = *sharedIdxSideBoundary + 1;
 4726:    nbp = *sharedIdxNodeBoundary + 1;
 4727: 
 4728:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4729: 
 4730: }
