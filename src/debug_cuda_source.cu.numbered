 7689: __global__ void computeMatrixProductAndDotProducts() {
 7690:    // Computes A*p, r'Mr and p'Ap
 7691: 
 7692:    // 1) shared buffer: first half for rMr, second for pAp
 7693:    __shared__ double sdata[2*BLOCK_SIZE];
 7694:    double* s_rMr = sdata;
 7695:    double* s_pAp = sdata + BLOCK_SIZE;
 7696: 
 7697:    const int tid = threadIdx.x;
 7698: 
 7699:    double l_pAp = 0.0;
 7700: 
 7701:    s_rMr[tid] = 0.0;
 7702:    s_pAp[tid] = 0.0;
 7703: 
 7704:    // 2) get your node pointer
 7705:    // NODE(node);   
 7706:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7707:    Node *node = &(mesh->localNodeData[idx_node]); 
 7708:       if (idx_node < mesh->np) {
 7709: 
 7710:       const double diag = node->coeffDiag;
 7711:       const double r    = node->mR;
 7712:       const double p    = node->mP;  
 7713: 
 7714:       // apply preconditioner on the fly:
 7715:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7716: 
 7717:       // 4) compute Ap = A.p
 7718:       double Ap = node->coeffDiag * node->mP;
 7719:       for (int j = 0; j < node->numNodes; ++j) {
 7720:          const Node *nbNode = node->nodes[j];
 7721:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7722: 
 7723:       }
 7724: 
 7725:       node->mAp = Ap;
 7726:       
 7727: 
 7728:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7729:       // const double l_rMr = r*Mr;  // r'Mr
 7730:       l_pAp = p*Ap;  // p'Ap
 7731: 
 7732: 
 7733:    }
 7734: 
 7735:    // 6) write into shared mem
 7736:    // s_rMr[tid] = l_rMr;
 7737:    s_pAp[tid] = l_pAp;
 7738: 
 7739:    __syncthreads();
 7740: 
 7741:    // 7) block-wide tree reduction
 7742:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7743:       if (tid < stride)  {
 7744:          s_pAp[tid] += s_pAp[tid + stride];
 7745:       }
 7746:       __syncthreads();
 7747:    }
 7748: 
 7749:    // 8) thread 0 atomically accumulates into the globals
 7750:    // XXX: This is slower than it needs to be, but it is simple and works
 7751:    if (tid == 0) {
 7752:       atomicAdd(pAp, s_pAp[0]);
 7753:    }
 7754: 
 7755: 
 7756: }
 7757: 
 7758: 
 7759: __global__ void updateSolutionAndDotProducts(void) {
 7760:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7761: 
 7762:    const int tid = threadIdx.x;
 7763: 
 7764:    s_rMr[tid] = 0.0;
 7765: 
 7766:    // get node & bounds-check:
 7767:    NODE(node);
 7768: 
 7769:    
 7770:    // Compute alpha
 7771:    const double alpha = (*rMr_old)/(*pAp); 
 7772: 
 7773: 
 7774:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7775: 
 7776: 
 7777:    // load scalars
 7778:    const double diag = node->coeffDiag;
 7779:    const double p    = node->mP;
 7780:    const double Ap   = node->mAp;
 7781:    const double x    = node->mX;
 7782:    const double r    = node->mR;
 7783:    
 7784:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7785: 
 7786:    // 1) update solution & residual
 7787:    const double x_new = x + alpha*p;
 7788:    const double r_new = r - alpha*Ap;
 7789:    node->mX = x_new;
 7790:    node->mR = r_new;
 7791: 
 7792:    // 2) apply Jacobi preconditioner on the fly
 7793:    const double Mr_new = r_new/diag;
 7794: 
 7795: 
 7796:    // 3) local contributions for the two dot-products
 7797:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7798: 
 7799:    // 4) write into shared-mem
 7800:    s_rMr[tid] = l_rMr;
 7801: 
 7802:    __syncthreads();
 7803: 
 7804: 
 7805:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7806:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7807:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7808:       __syncthreads();
 7809:    }
 7810: 
 7811:    // 6) thread 0 atomically folds into the global accumulators
 7812:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7813: 
 7814: 
 7815: }
 7816: 
 7817: 
 7818: __global__ void updateSearchDirection() {
 7819: 
 7820:     NODE(node);
 7821: 
 7822:     // recompute z on-the-fly
 7823:     const double z = node->mR / node->coeffDiag;
 7824:     const double p = node->mP;
 7825: 
 7826:     const double beta = (*rMr_new)/(*rMr_old);
 7827: 
 7828: 
 7829:     // p =z + beta*p
 7830:     node->mP = z + beta*p;
 7831: 
 7832: }
 7833: 
 7834: __global__ void initializeScalars(double *scalars) {
 7835: 
 7836:    // These point to a cupy array in the host code
 7837:    rMr_old = scalars + 0;
 7838:    rMr_new = scalars + 1;
 7839:    pAp     = scalars + 2;
 7840: }
 7841: 
 7842: __global__ void initializePreconditionedResidual(void) {
 7843: 
 7844:     __shared__ double s_rMr[BLOCK_SIZE];  
 7845: 
 7846:     s_rMr[threadIdx.x] = 0.0;
 7847: 
 7848:     NODE_ALL(node, valid);
 7849:     const int tid = threadIdx.x;
 7850:     // For the first iteration:
 7851:     // 1. Initial solution x = 0 (already set)
 7852:     // 2. Initial residual r = b (stored in qel)
 7853:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7854: 
 7855: // XXX we should use the guess solution here    
 7856: 
 7857:     double l_rMr = 0.0;
 7858:     if (valid) {
 7859:       // Set initial residual r = b (from qel)
 7860:       node->mR = node->qel;
 7861: 
 7862:       // Compute z = M^-1 * r (preconditioned residual)
 7863:       const double z = node->mR / node->coeffDiag;
 7864: 
 7865:       // Set initial search direction p = z
 7866:       node->mP = z;
 7867: 
 7868:       // Initialize other variables needed for CG
 7869:       node->mX = 0.0;  // Initial solution
 7870:       node->mAp = 0.0; // Will be computed in first iteration
 7871: 
 7872: 
 7873:       // Computes the first r'Mr (reduction)
 7874:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7875:     }
 7876:     // 4) write into shared-mem
 7877:     s_rMr[tid] = l_rMr;
 7878: 
 7879:     __syncthreads();
 7880: 
 7881: 
 7882:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7883:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7884:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7885:         __syncthreads();
 7886:     }
 7887: 
 7888:     // 6) thread 0 atomically folds into the global accumulators
 7889:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7890: 
 7891:     *rMr_old = 0.0;
 7892:     *pAp = 0.0;
 7893: }
 7894: 
 7895: 
