 6519:    __global__ void computeVerticallyIntegratedVelocity(void) {
 6520: 
 6521:       SIDE(side);
 6522: 
 6523:       side->U = {0.0, 0.0}; 
 6524:          
 6525:       if(side->isDry) return;
 6526: 
 6527:       // Vertically integrated velocity U
 6528:       for (int k = side->kb; k < nvrt - 1; k++) { 
 6529:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 6530:          side->U += side->Dz(k + 1)*uc;  
 6531:       }
 6532: 
 6533:    }
