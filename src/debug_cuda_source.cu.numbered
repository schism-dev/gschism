 7122: __global__ void getStructSizes(int* sizes)  {
 7123:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7124:       sizes[0] = (int)sizeof(Node);
 7125:       sizes[1] = (int)sizeof(Element);
 7126:       sizes[2] = (int)sizeof(Side);
 7127:       sizes[3] = (int)sizeof(NodeBoundary);
 7128:       sizes[4] = (int)sizeof(SideBoundary);
 7129:       sizes[5] = (int)sizeof(BoundarySegment);
 7130: }
