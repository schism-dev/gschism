 8632: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8633:    // Get the value of a variable from an side
 8634:    // varName is the name of the variable to get
 8635:    // var is the array to store the value
 8636:    // k is the vertical level index of the variable to get
 8637:    SIDE_BND(sideBnd);   
 8638: 
 8639:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8640:    if (sideBnd->segment->isLand) idx = -7;
 8641: 
 8642:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8643:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8644: 
 8645: }
