 6299: 
 6300:       if constexpr(nws != 0 && iwindoff != 0) {
 6301:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 6302:       }
 6303: 
 6304:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 6305:       node->setWind(wind);
 6306: 
 6307:       node->pr = pressAir[idx];
 6308:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 6309: 
 6310:    }
