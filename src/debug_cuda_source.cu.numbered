 2435:    template<typename T>
 2436:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2437:       // Get the values of the field at the nodes of the element
 2438:       res[0] = nodes[0]->*field;
 2439:       res[1] = nodes[1]->*field;
 2440:       res[2] = nodes[2]->*field;
 2441:       if (isQuad()) res[3] = nodes[3]->*field;
 2442:       else          res[3] = T();
 2443:    }
 2444: 
 2445:    template<typename T>
 2446:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2447: 
 2448:       assert(level < nvrt && "Level is out of range");
 2449:       // Get the values of the field at the nodes of the element
 2450:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2451:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2452:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2453:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2454:       else          res[3] = T();
 2455:    }    
 2456: 
 2457:    template<typename T>
 2458:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2459: 
 2460:       assert(level < nvrt && "Level is out of range");
 2461: 
 2462:       // Get the values of the func at the nodes of the element
 2463:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2464:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2465:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2466:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2467:       else          res[3] = T();  // This is 0.0 or a zero vector
 2468: 
 2469:    }      
 2470: 
 2471:    template<typename T>
 2472:    __device__ __forceinline__ void Element::getSideValues(T Side::* field, T res[4]) const {
 2473:       // Get the values of the field at the nodes of the element
 2474:       res[0] = sides[0]->*field;
 2475:       res[1] = sides[1]->*field;
 2476:       res[2] = sides[2]->*field;
 2477:       if (isQuad()) res[3] = sides[3]->*field;
 2478:       else          res[3] = T();
 2479:    }
 2480: 
 2481:    template<typename T>
 2482:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
 2483: 
 2484:       assert(level < nvrt && "Level is out of range");
 2485: 
 2486:       // Get the values of the field at the nodes of the element
 2487:       res[0] = (sides[0]->*field)[max(level, sides[0]->kb)];
 2488:       res[1] = (sides[1]->*field)[max(level, sides[1]->kb)];
 2489:       res[2] = (sides[2]->*field)[max(level, sides[2]->kb)];
 2490:       if (isQuad()) res[3] = (sides[3]->*field)[max(level, sides[3]->kb)];
 2491:       else          res[3] = T();
 2492:    }    
 2493: 
 2494:    template<typename T>
 2495:    __device__ __forceinline__ void Element::getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
 2496: 
 2497:       assert(level < nvrt && "Level is out of range");
 2498: 
 2499:       // Get the values of the func at the nodes of the element
 2500:       res[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2501:       res[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2502:       res[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2503:       if (isQuad()) res[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2504:       else          res[3] = T();  // This is 0.0 or a zero vector
 2505: 
 2506:    }      
