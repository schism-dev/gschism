 9371: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9372:    Element *elems = mesh->localElemData;
 9373: 
 9374:    *addr = elems;
 9375:    *sizeElement = sizeof(Element);
 9376:    switch (varCode) {
 9377:       case (int)VarCode::z:
 9378:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9379:          *sizeType = sizeof(double);
 9380:          break;
 9381:       case (int)VarCode::x:
 9382:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9383:          *sizeType = sizeof(Vector2);
 9384:          break;
 9385:       case (int)VarCode::gradETP:
 9386:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9387:          *sizeType = sizeof(Vector2);
 9388:          break;
 9389:       case (int)VarCode::area:
 9390:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9391:          *sizeType = sizeof(double);
 9392:          break;
 9393:       case (int)VarCode::depth:
 9394:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9395:          *sizeType = sizeof(double);
 9396:          break;
 9397:       case (int)VarCode::radius:
 9398:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9399:          *sizeType = sizeof(double);
 9400:          break;
 9401:       case (int)VarCode::ghat:
 9402:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9403:          *sizeType = sizeof(Vector2);
 9404:          break;
 9405:       case (int)VarCode::kb:
 9406:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9407:          *sizeType = sizeof(int);
 9408:          break;
 9409:       case (int)VarCode::isdry:
 9410:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9411:          *sizeType = sizeof(int);
 9412:          break;            
 9413:       case (int)VarCode::w:
 9414:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9415:          *sizeType = sizeof(double);
 9416:          break;
 9417:       case (int)VarCode::FaceIndices:
 9418:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9419:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9420:          *sizeType = sizeof(Node);
 9421:          break;
 9422:       default:
 9423:          *offset = -1;
 9424:    }
 9425: }
