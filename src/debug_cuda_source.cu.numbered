 2193: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2194:                    Side *side = &(mesh->localSideData[idx_side]); \
 2195:                    if (idx_side >= mesh->ns) return;
 2196: 
 2197: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2198:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2199:                    if (idx_elem >= mesh->ne) return;
 2200: 
 2201: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2202:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2203:                    if (idx_node >= mesh->np) return;
 2204: 
 2205: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2206:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2207:                               const bool valid = (idx_node < mesh->np);                   
 2208: 
 2209: 
 2210: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2211:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2212:                            if (idx_node_bnd >= mesh->nbp) return;
 2213: 
 2214: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2215:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2216:                            if (idx_side_bnd >= mesh->nbs) return;  
