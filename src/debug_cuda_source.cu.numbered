 7673: __global__ void getStructSizes(int* sizes)  {
 7674:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7675:       sizes[0] = (int)sizeof(Node);
 7676:       sizes[1] = (int)sizeof(Element);
 7677:       sizes[2] = (int)sizeof(Side);
 7678:       sizes[3] = (int)sizeof(NodeBoundary);
 7679:       sizes[4] = (int)sizeof(SideBoundary);
 7680:       sizes[5] = (int)sizeof(BoundarySegment);
 7681: }
