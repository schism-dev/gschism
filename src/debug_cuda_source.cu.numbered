 2552: // Helper functions to get the 2D local node position for the Celestial walk
 2553: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2554:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2555:    const Node *node = getNodeInOrder(idx2);
 2556: 
 2557:    double z = 0.0;
 2558:    if constexpr(ics == 2) z = node->gz;
 2559:    
 2560:    Point3 p = toPoint3(node->p, z);
 2561: 
 2562:    return toPoint2(origSide->toLocalFrame(p));
 2563: }
 2564: 
 2565: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2566:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2567: }
 2568: 
 2569: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2570:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2571: // Computes the three per-side predicates needed for the celestial walk
 2572: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2573: //
 2574: // xt is in local frame coordinates for origSide if ics == 2.
 2575: //
 2576: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2577: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2578: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2579: // meaningless on triangles are masked to a safe value (see comments below).
 2580: {
 2581:    // Project all 4 corner positions once into the local 2D frame.
 2582:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2583:    // getLocalNodePosition only transforms/projects if ics == 2.
 2584:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2585:                         getLocalNodePosition(1, origSide), 
 2586:                         getLocalNodePosition(2, origSide), 
 2587:                         getLocalNodePosition(3, origSide)};
 2588: 
 2589:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2590:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2591:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2592:    // But still farther towards the target point from the current point.
 2593:    const Vector2 vt0 = xt - x0;
 2594:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2595:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2596:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2597: 
 2598:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2599:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2600: 
 2601: 
 2602: // if (origSide->idx == 2860848 && jlev == 46) {
 2603: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2604: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2605: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2606: // }
 2607:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2608:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2609:    //  here the orientation is baked into the corners array.)
 2610:    const int i3 = nxq(3);
 2611:    const Vector2 s0 = C[ 1] - C[ 0];
 2612:    const Vector2 s1 = C[ 2] - C[ 1];
 2613:    const Vector2 s2 = C[i3] - C[ 2];
 2614:    const Vector2 s3 = C[ 0] - C[i3];
 2615:    
 2616:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2617:    // The corners array is built from getNode in CCW order, so the orientation
 2618:    // is already correct and no ssign factor is needed in the formulas below.
 2619:    //
 2620:    // i3 = nxq(3): the index of the corner after side 2.
 2621:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2622:    //   Quad:     i3 == 3.
 2623:    //
 2624:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2625:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2626:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2627:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2628:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2629:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2630: 
 2631: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2632: 
 2633:    // For triangles, the corner after side 2 is the closing corner where
 2634:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2635:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2636:    // s0 for triangles, s3 for quads.
 2637:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2638: 
 2639:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2640:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2641:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2642:    //
 2643:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2644:    // result is false naturally. No sentinel needed.
 2645:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2646:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2647:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2648:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2649: 
 2650:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2651:    // on the "exit through side I" half of the corner cone, separated by the
 2652:    // approximate angular bisector of the celestial walk. The bisector is
 2653:    // perpendicular to the chord across the corner; the test is the sign of
 2654:    // (xt - corner_vertex) projected onto that chord.
 2655:    //
 2656:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2657:    // (the validity rule sets valid_3 = false), so its computed value for
 2658:    // triangles doesn't matter. No sentinel needed.
 2659:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2660:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2661:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2662:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2663: 
 2664: }
 2665: 
 2666: 
 2667: __inline__ __device__ double Element::computeSignedArea(void) const {
 2668:    // Compute the area of the element
 2669: 
 2670:    Point2 x0, x1, x2, x3;
 2671:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2672: 
 2673:    double res = signedArea(x0, x1, x2);
 2674: 
 2675:    // In the quad case we need to add the area of the other triangle.
 2676:    if (isQuad()) {
 2677:       x3 = getLocalHorizontalNodePosition(3);
 2678:       double ar1 = signedArea(x0, x2, x3);
 2679:       double ar2 = signedArea(x0, x1, x3);
 2680:       double ar3 = signedArea(x1, x2, x3);
 2681:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2682: 
 2683:       res += ar1 + ar2 + ar3;
 2684: 
 2685:    }
 2686: 
 2687:    return res;
 2688: }
 2689: 
 2690: 
 2691: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2692:                                                                 (nodes[1]->isDry2()) ||
 2693:                                                                 (nodes[2]->isDry2()) ||
 2694:                                                                 (isQuad() && nodes[3]->isDry2());
 2695: }
 2696: 
 2697: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2698:    return (x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y);
 2699: }
 2700: 
 2701: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2702:    return (x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y);
 2703: }
 2704: 
 2705: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2706:    // In boundary sides, the element 1 is nullptr
 2707:    return side->elems[1] == nullptr; 
 2708: }
 2709: 
 2710: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2711:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2712:    // For ics == 2, this function uses local frame coordinates.
 2713: 
 2714:    assert(isQuad());
 2715: 
 2716:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2717:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2718:    // where vxi, veta, vb are vectors and c is the center of the element.
 2719: 
 2720:    Point2 p0, p1, p2, p3;
 2721: 
 2722:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2723: 
 2724:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2725:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2726:    // vectors vxi and veta connect the centers of opposite sides
 2727:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2728:    // vb is zero for parallelogram elements.
 2729:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2730: 
 2731:    //  The bilinear mapping is:
 2732:    //      P(s,t) = C + s*U + t*V + s*t*W
 2733:    //
 2734:    //  where:
 2735:    //    C = centroid (average of four vertices)
 2736:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2737:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2738:    //    W = bilinear correction; measures deviation from parallelogram
 2739:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2740:    //        W = 0 for parallelogram elements.
 2741:    //
 2742:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2743:    //
 2744:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2745:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2746:    //
 2747:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2748:    //
 2749:    //  Geometrically, (L) projects everything onto the direction
 2750:    //  perpendicular to W, where the mapping is purely affine.
 2751:    //
 2752:    //  The dot product with nb retains the nonlinear term:
 2753:    //
 2754:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2755:    //
 2756:    //  Geometrically, (Q) projects onto the W direction, where
 2757:    //  the nonlinearity lives.
 2758:    //
 2759:    //  We solve (L) for whichever variable has the larger coefficient
 2760:    //  (better conditioned back-substitution), substitute into (Q),
 2761:    //  and get a scalar quadratic in the other variable.
 2762:    // ================================================================
 2763: 
 2764:    // ---- Basis vectors ----
 2765:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2766:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2767:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2768:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2769:    // W: nonlinear correction. Difference between quad and parallelogram.
 2770:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2771:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2772: 
 2773:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2774:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2775:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2776:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2777:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2778: 
 2779:    // ---- nb: direction parallel to W, L1-normalized ----
 2780:    // We don't need a unit vector -- just a well-scaled direction parallel
 2781:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2782:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2783:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2784:    //
 2785:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2786:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2787:    // and the quadratic solver takes its linear path (a ~ 0).
 2788:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2789:    const double inv_wlen = 1.0 / wlen1;
 2790:    const Vector2 nb = vb * inv_wlen;
 2791: 
 2792:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2793:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2794:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2795:    // What remains is a pure affine relationship between xi and eta.
 2796:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2797:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2798:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2799: 
 2800:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2801:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2802:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2803:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2804:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2805:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2806:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2807: 
 2808:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2809:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2810:    // minimizing round-off amplification.
 2811:    //
 2812:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2813:    // that uses predicated moves.
 2814:    //
 2815:    // if (fabs(Ls) > fabs(Lt)) {
 2816:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2817:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2818:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2819:    //    const double A = -Qw * Lt;
 2820:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2821:    //    const double C =  Qs * Lp - Qp * Ls;
 2822: 
 2823:    //    double eta1, eta2;
 2824:    //    solveQuadratic(A, B, C, eta1, eta2);
 2825: 
 2826:    //    // Pick root with smaller |eta| (domain centered at 0).
 2827:    //    // Ternary-> predicated move, no branch divergence.
 2828:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2829: 
 2830:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2831:    //    xi = (Lp - Lt * eta) / Ls;
 2832: 
 2833:    // } else {
 2834:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2835:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2836:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2837:    //    const double A = -Qw * Ls;
 2838:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2839:    //    const double C =  Qt * Lp - Qp * Lt;
 2840: 
 2841:    //    double xi1, xi2;
 2842:    //    solveQuadratic(A, B, C, xi1, xi2);
 2843: 
 2844:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2845: 
 2846:    //    eta = (Lp - Ls * xi) / Lt;
 2847:    // }
 2848:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2849:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2850:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2851:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2852:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2853: 
 2854:    // Quadratic:  A*r^2 + B*r + C = 0
 2855:    // (same formula for both cases, just with swapped coefficients)
 2856:    const double A = -Qw * Lb;
 2857:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2858:    const double C =  Qa * Lp - Qp * La;
 2859: 
 2860:    double r1, r2;
 2861:    solveQuadratic(A, B, C, r1, r2);
 2862: 
 2863:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2864:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2865: 
 2866:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2867:    const double other = (Lp - Lb * r) / La;
 2868: 
 2869:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2870:    xi  = solve_s ? r     : other;
 2871:    eta = solve_s ? other : r;
 2872: 
 2873: 
 2874:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2875:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2876:    eta = fmin(1.0, fmax(eta, -1.0));
 2877: 
 2878:    // ---- Shape functions ----
 2879:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2880:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2881:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2882:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2883:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2884:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2885:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2886:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2887: 
 2888:    return true;
 2889: }
 2890: 
 2891: /**
 2892:    Compute the shape coordinates of the point (xt,yt) in the element.
 2893:    @param xt (input): x-coordinate of the point
 2894:    @param shpCoords (output): shape coordinates of the point
 2895:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2896:    @return true if the point is inside the element, false otherwise
 2897: **/
 2898: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2899: 
 2900:    // Compute the shape coordinates of the point xt in the element.
 2901:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2902:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2903:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2904:    // from the local frame, so use additional check.
 2905: 
 2906: 
 2907:    if (isTri()) { // Triangular element
 2908: 
 2909:       // Horizontal local node coordinates. 
 2910:       Point2 x0 = nodes[0]->p;
 2911:       Point2 x1 = nodes[1]->p;
 2912:       Point2 x2 = nodes[2]->p;
 2913: 
 2914:       // If ics == 2, the node coordinates are transformed to local frame.
 2915:       if constexpr(ics==2) {
 2916:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2917:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2918:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2919: 
 2920: 
 2921:          // Convert the node coordinates to the local frame centered at the element center
 2922:          x0 = toPoint2(origSide->toLocalFrame(p0));
 2923:          x1 = toPoint2(origSide->toLocalFrame(p1));
 2924:          x2 = toPoint2(origSide->toLocalFrame(p2));
 2925:       }
 2926: 
 2927:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2928:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2929:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2930:       shpCoords[3] = 0.0;
 2931: 
 2932: 
 2933:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2934:       const bool res = (tmpmin >= -small);  
 2935:       
 2936:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2937:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2938: 
 2939: double tmpmax = max3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2940: if (tmpmin < -0.01) printf("XXX element %d, tmpmin = %.17f\n", idx, tmpmin);
 2941: if (tmpmax > 1.01) printf("XXX element %d, tmpmax = %.17f\n", idx, tmpmax);
 2942:       
 2943:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2944:       // then we fix the negative shape coordinates.
 2945:       if ((tmpmin < 0) && fix) {
 2946: 
 2947:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2948:          // keeping the sum of the shape coordinates equal to 1.
 2949:          // I have tested and compared the new algorithm with the old one, and they give
 2950:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2951:          // The new algorithm should be faster since it is branchless.
 2952:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2953:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2954: 
 2955:          shpCoords[0] = (shpCoords[0] + a)*b;
 2956:          shpCoords[1] = (shpCoords[1] + a)*b;
 2957:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2958: 
 2959:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2960:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2961:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2962: 
 2963:          // Update the point coordinates for the new shape coordinates
 2964:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2965:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2966: 
 2967:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2968: 
 2969:       }
 2970: 
 2971:       // Check if the point is inside the element
 2972:       return res;      
 2973:    }
 2974:    else {
 2975:       assert(isQuad() && "computeShapeCoords");
 2976: 
 2977:    //    Point2 p = xt;
 2978: 
 2979:    //    // Reproject p the original side frame for ics=2
 2980:    //    if constexpr(ics == 2) p = origSide->frame.G2L(toPoint3(xt, 0.0));
 2981: 
 2982:    //    bool inside = false;
 2983: 
 2984: 
 2985: 
 2986:    //    if(ifl==0) then
 2987:    //      do i=1,4
 2988:    //        in1=nxq(1,i,i34(ie))
 2989:    //        in2=nxq(2,i,i34(ie))
 2990:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 2991:    //      enddo !i
 2992:    //      tmp=minval(swild2(1:4))/area(ie)
 2993:    //      if(tmp>-small2) then
 2994:    //        inside=1
 2995:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 2996:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 2997:    //      endif !inside quad
 2998:    //    else !ifl=1 - already inside
 2999:    //      call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3000:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3001:    //      !Update pt
 3002:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3003:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3004:    //    endif !ifl
 3005: 
 3006: 
 3007:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3008: 
 3009:    }
 3010: 
 3011:    assert(false && "computeShapeCoords: should never reach this point");
 3012:    return false;  // Never reached
 3013: 
 3014: }
 3015: 
 3016: 
 3017: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3018: // Convert shape coordinates to cartesian coordinates
 3019: 
 3020:    if (isTri()) {
 3021:       // Triangular element
 3022: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3023:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3024:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3025:    }
 3026:    else {
 3027:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3028:    }
 3029: 
 3030: }
