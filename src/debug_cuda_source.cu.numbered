 6859: //                     swild4(1,1)=swild4(1,1)*rat+sdbt(2+jj,max(k,kbs(jsj)),jsj)*(1-rat)
 6860: //                     swild4(2,1)=swild4(2,1)*rat+sdbt(2+jj,max(k-1,kbs(jsj)),jsj)*(1-rat)
 6861: //                     psumtr(jj)=psumtr(jj)+0.5d0*(swild4(1,1)+swild4(2,1)) 
 6862: //                   enddo !j
 6863: //                 enddo !jj
 6864: //                 tr_el(1:ntr,k,i)=psumtr(:)/dble(i34(i))
 6865: //               enddo !k
 6866: //             endif !ielem_elm(i)/=0
 6867: 
 6868: 
 6869: // !           Extend
 6870: //             do k=1,kbe(i)
 6871: //               tr_el(1:ntr,k,i)=tr_el(1:ntr,kbe(i)+1,i)
 6872: //             enddo !k
 6873: //           enddo !i=1,ne
 6874: // !$OMP     end do 
 6875: 
 6876: // !$OMP     master
 6877: // !         Update ghosts
 6878: // #ifdef INCLUDE_TIMING
 6879: //           cwtmp=mpi_wtime()
 6880: //           timer_ns(1)=timer_ns(1)+cwtmp-cwtmp2
 6881: // #endif
 6882: //           call exchange_e3d_2t_tr(tr_el)
 6883: 
 6884: // #ifdef INCLUDE_TIMING
 6885: //           cwtmp2=mpi_wtime()
 6886: //           wtimer(9,2)=wtimer(9,2)+cwtmp2-cwtmp
 6887: // #endif
 6888: 
 6889: #endif
