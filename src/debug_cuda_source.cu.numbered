 1805: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1806:                                               double &t, double& tIntersect) {
 1807: 
 1808:    double closest_intersect_t = 1e10;
 1809:    bool found_intersection = false;
 1810: 
 1811: double minDelta = 1e10; 
 1812: double btt1 = 1e10, btt2;
 1813:    for (int i = 0; i < i34; i++) {
 1814: 
 1815:       Side *side2 = sides[i];
 1816: 
 1817:       // (x3,y3)-(x4,y4) is the element side line
 1818:       const Point2 x3 = side2->n1->p2();
 1819:       const Point2 x4 = side2->n2->p2();
 1820: 
 1821:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1822:       const double delta = cross(x2 - x1, x3 - x4);
 1823: 
 1824:       if (abs(delta) > 0) {
 1825: 
 1826:          const double delta1 = cross(x3 - x1, x3 - x4);
 1827:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1828: 
 1829:          // Solves the two linear equations for tt1 and tt2
 1830:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1831:          const double tt2 = delta2/delta;
 1832: 
 1833: if (abs(tt1) < abs(btt1)) {
 1834:    minDelta = abs(delta);
 1835:    btt1 = tt1;
 1836:    btt2 = tt2;
 1837: }
 1838: 
 1839: if (idx == 0) printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1840:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1841:             closest_intersect_t = min(closest_intersect_t, tt1);
 1842:             side = side2;
 1843:             nextElement = side->otherElem(this);
 1844:             t = tt2;
 1845:             tIntersect = max(small, min(tt1, 1.0-small));
 1846:             found_intersection = true;
 1847:          }
 1848:       
 1849:       }
 1850:       else {  // parallel segments
 1851:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1852:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1853: 
 1854:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1855: 
 1856:          // const double dist = dot(x1 - x3, side2->n);
 1857:          // if (abs(dist) < small*length(x3 - x4)) {
 1858:          //    const double2 unitarySide = normalize(x4 - x3);
 1859:          //    const double len = dot(x2 - x1, unitarySide);
 1860:          //    t = t + len;
 1861:          //    t = max(0.0, min(t, 1.0));
 1862:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1863: 
 1864: 
 1865:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1866:          //    // t = tt2;
 1867:          //    found_intersection = true;
 1868:          // }
 1869:       }
 1870: 
 1871: 
 1872:    }
 1873: 
 1874:    if (!found_intersection) {
 1875:       
 1876: if (idx == 0) printf("ZZ No intersection found:\n"
 1877:            "Element %d\n"
 1878:            "in = %d\n"
 1879:            "minDelta = %e\n"
 1880:            "tt1 = %e, tt2 = %e\n"
 1881:            "segment: (%f, %f)-(%f, %f)\n"
 1882:            "Vertices:\n"
 1883:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1884:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1885:            IDX(nextElement),
 1886:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1887:            minDelta,
 1888:            btt1, btt2,
 1889:            x1.x, x1.y,
 1890:            x2.x, x2.y,
 1891:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1892:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1893:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1894:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1895:            nodes[0]->p.x, nodes[0]->p.y,
 1896:            nodes[1]->p.x, nodes[1]->p.y,
 1897:            nodes[2]->p.x, nodes[2]->p.y,
 1898:            nodes[0]->p.x, nodes[0]->p.y);
 1899: 
 1900:    }
 1901: 
 1902:    // assert(found_intersection && "No intersection found");
 1903: 
 1904:    // found_intersection should always be true, since we checked all the sides.  
 1905:    return found_intersection;
 1906: }
