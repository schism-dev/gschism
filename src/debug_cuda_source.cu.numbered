  836:    
  837:    // Elevation boundary condition
  838:    int iettype;  // Type of elevation boundary condition
  839:    double eth;   // Elevation time history
  840: 
  841:    // Flow boundary condition
  842:    double qthcon;  // Flow time history constant
  843:    double vobc1;   // Velocity coefficient 1
  844:    double vobc2;   // Velocity coefficient 2
  845: 
  846:    // Tracer boundary conditions
  847:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  848:    // int  itrtype[natrm];    // Tracer boundary condition type
  849: 
  850:    BoundarySegment(bool _isLand) {
  851:       isLand = _isLand;
  852:       clen = 0.0;
  853:       carea = 0.0;
  854:       ifltype = 0;
  855:       iettype = 0;
  856:       eth = 0.0;
  857:    }
  858: 
  859:    BoundarySegment(void) {
  860:       isLand = false;
  861:       clen = 0.0;
  862:       carea = 0.0;
  863:       ifltype = 0;
  864:       iettype = 0;
  865:       eth = 0.0;
  866:    }
  867: 
  868:    
  869: };
