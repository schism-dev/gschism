 1144: // This struct is used to store the boundary information for a node.
 1145: struct NodeBoundary {   
 1146:    int idx;
 1147:    BoundarySegment *segment;
 1148:    Node *node;
 1149:    
 1150:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1151:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1152: 
 1153:    bool isLand;
 1154: 
 1155:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1156:    double elbc;   // Elevation boundary condition
 1157:    double eth;    // Elevation time history
 1158: 
 1159:    double eta_mean; // Mean elevation at nodes
 1160: 
 1161:    bool isEssentialBC;
 1162: 
 1163:    Vector2 uth[nvrt];  // "Time history" velocity
 1164: 
 1165:    // Arrays for harmonic constituents (if needed)
 1166:    double  emo[nbfr];  // Elevation amplitude
 1167:    double  efa[nbfr];  // Elevation phase
 1168:    Vector2 umo[nbfr];  // velocity amplitude
 1169:    Vector2 ufa[nbfr];  // velocity phase
 1170: 
 1171: 
 1172:    NodeBoundary(void) {
 1173:       isLand = false;
 1174:    }
 1175:    NodeBoundary(bool _isLand) {
 1176:       isLand = _isLand;
 1177:    }
 1178: 
 1179:    
 1180:    __forceinline__ __device__ int numSidesForAverage() const {
 1181:    // Returns the number of sides that are connected to the node and have the same segment.
 1182:    // This is used to compute the average velocity at the node for open boundary nodes.
 1183:       int res = 0;
 1184:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1185:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1186: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1187:       return res;
 1188:    }
 1189: 
 1190: 
 1191:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1192:       assert(index == 0 || index == 1); 
 1193:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1194:    }
 1195: 
 1196: 
 1197: };
