 1424: struct Mesh {
 1425:    public:  
 1426: 
 1427:    int partNum; // Partition number for this mesh.
 1428: 
 1429:    // Pointers to each GPU's local memory (size is the number of partitions).
 1430:    Node**    nodes;  
 1431:    Element** elems;  
 1432:    Side**    sides;  
 1433:    
 1434:    // Local memory
 1435:    Node*    localNodeData; 
 1436:    Element* localElemData;
 1437:    Side*    localSideData; 
 1438: 
 1439:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1440:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1441:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1442:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1443:    
 1444:    const int npgb;  // Global number of horizontal nodes
 1445:    const int negb;  // Global number of elements
 1446:    const int nsgb;  // Global number of sides
 1447: 
 1448:    const int np;   // Local number of horizontal nodes 
 1449:    const int ne;   // Local number of elements
 1450:    const int ns;   // Local number of sides
 1451: 
 1452:    int nbp;  // Local number of boundary nodes
 1453:    int nbs;  // Local number of boundary sides
 1454: 
 1455:    int nEntries;  // Total number of matrix elements
 1456: 
 1457:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1458:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1459:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1460: 
 1461:   
 1462:    // Additional topology information
 1463:    Node    **nodeNeighNodes; // Array of pointers to the nodes neighbors of each node
 1464:    Element **nodeNeighElems; // Array of pointers to the elements neighbors of each node
 1465: 
 1466:    BoundarySegment landBoundarySegment;
 1467:    NodeBoundary landBoundaryNode;
 1468: 
 1469:    // Vertical coordinate system
 1470:    // Sigma levels
 1471:    double h_s; 
 1472:    double h_c; 
 1473: 
 1474:    double theta_b;
 1475:    double theta_f, sinh_theta_f;
 1476:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1477:    double *ztot;
 1478:    double *cs;
 1479:    double *dcs;
 1480: 
 1481:    // // Get's the pointer to the node using the array of global pointers to nodes
 1482:    // __device__ const Node *getGlobalNode(int jn) {
 1483:    //    const int idx = jn / max_np; // Get the index of the partition that contains the node
 1484:    //    return nodes[idx] + idx;
 1485:    // }
 1486: 
 1487:    // // Get's the pointer to the element using the array of global pointers to elements
 1488:    // __device__ const Element *getGlobalElem(int je) {
 1489:    //    const int idx = je / max_ne; // Get the index of the partition that contains the element
 1490:    //    return elems[idx] + idx;
 1491:    // }
 1492: 
 1493:    // // Get's the pointer to the side using the array of global pointers to sides
 1494:    // __device__ const Side *getGlobalSide(int js) {
 1495:    //    const int idx = js / max_ns; // Get the index of the partition that contains the side
 1496:    //    return sides[idx] + idx;
 1497:    // }
 1498: 
 1499:    // // Get's the global index of local node idx
 1500:    // __device__ int getGlobalNodeIndex(int idx) {
 1501:    //    return idx + partNum * max_np;
 1502:    // }
 1503: 
 1504:    // // Get's the global index of local element idx
 1505:    // __device__ int getGlobalElemIndex(int idx) {
 1506:    //    return idx + partNum * max_ne;
 1507:    // }
 1508: 
 1509:    // // Get's the global index of local side idx
 1510:    // __device__ int getGlobalSideIndex(int idx) {
 1511:    //    return idx + partNum * max_ns;
 1512:    // }  
 1513: 
 1514:    __device__ Mesh(int partNum,
 1515:                    int npgb, int negb, int nsgb, 
 1516:                    int np, int ne, int ns,
 1517:                    int max_np, int max_ne, int max_ns, int nseg,
 1518:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1519:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1520:                    Node    **localNodeNeighNodesMem,
 1521:                    Element **localNodeNeighElemsMem,
 1522:                    double *partCoeffMatrixMem,
 1523:                    NodeBoundary *localNodeBoundaryMem,
 1524:                    SideBoundary *localSideBoundaryMem,
 1525:                    BoundarySegment *localSegmentMem,
 1526:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1527:                    double *cs, double *dcs
 1528:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1529:                        np(np), ne(ne), ns(ns),
 1530:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1531:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1532:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1533:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1534:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1535:                        localSegmentMem(localSegmentMem),
 1536:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1537:                        cs(cs), dcs(dcs),
 1538:                        coeffMatrixMem(partCoeffMatrixMem),
 1539:                        landBoundarySegment(true),
 1540:                        landBoundaryNode(true)
