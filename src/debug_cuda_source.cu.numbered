 2239: 
 2240: /**  Interpolate velocities at a given point (xt,yt,zt)
 2241: 
 2242:    @param xt, yt, zt: coordinates of the point to interpolate
 2243:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2244: 
 2245:    This is done in four steps:
 2246: 
 2247:    1. Find the shape coordinates for the final position in the element.
 2248:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2249:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2250:       z levels at xt, yt at each step.   
 2251:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2252:       horizontally and vertically.
 2253: **/
 2254: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2255:    // Interpolate the velocities at the point xt. 
 2256:    // This function works the same for triangular and quadrilateral elements.
 2257:    double shpCoord[4];
 2258: 
 2259:    // First step is to compute the shape coordinates of (xt,yt)
 2260:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2261:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2262: 
 2263:    // Second step is to find the level that contains zt
 2264:    // Uses a binary search to find the level
 2265:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2266:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2267:    int R = nvrt - 1;
 2268: 
 2269:    // Get the z coordinates at the nodes of the element at the levels L and R
 2270:    double zLAtNodes[4], zRAtNodes[4];
 2271:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2272:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2273: 
 2274:    double zL = interpolate(shpCoord, zLAtNodes);
 2275:    double zR = interpolate(shpCoord, zRAtNodes);
 2276:    
 2277:    // Interpolates vertically the velocities
 2278:    double wght1, wght2;
 2279:    if (xt.z<=zL) {
 2280:       wght1 = 1.0;
 2281:       wght2 = 0.0;
 2282:    }
 2283:    else if (xt.z>=zR) {
 2284:       wght1 = 0.0;
 2285:       wght2 = 1.0;
 2286:    }
 2287:    else {
 2288:       // Perform a binary search to find the levels between L and R that contain xt.z
 2289:       while (R - L > 1) {
 2290:          int M = (L + R) / 2;
 2291: 
 2292:          double zMAtNodes[4];
 2293:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2294:          double zM = interpolate(shpCoord, zMAtNodes);
 2295:          if (zM < xt.z) 
 2296:          {
 2297:             L = M;
 2298:             zL = zM;
 2299:          }
 2300:          else 
 2301:          {
 2302:             R = M;
 2303:             zR = zM;
 2304:          }
 2305:       }
 2306:       assert(L == R-1);
 2307:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2308: 
 2309:       wght2 = (xt.z - zL)/(zR - zL);
 2310:       wght1 = 1.0 - wght2;
 2311:    }
 2312: 
 2313:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2314:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2315: 
 2316:    // Neither of the interpolated velocities should be NaN
 2317:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2318: 
 2319: }
 2320: 
 2321: 
 2322: 
 2323: 
 2324: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2325: 
 2326:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2327:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2328:    const Node *n1 = side->n1;
 2329:    const Node *n2 = side->n2;
 2330: 
 2331:    bool n1_match = (n1->nodeBnd->segment == segment);
 2332:    bool n2_match = (n2->nodeBnd->segment == segment);
 2333: 
 2334:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2335:    if (n1_match && n2_match) {
 2336:       return 0.5;
 2337:    } else if (n1_match) {
 2338:       return 1.0;
 2339:    } else if (n2_match) {
 2340:       return 0.0;
 2341:    }
 2342:    return 0.0;
 2343: }
 2344: 
 2345: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2346: 
 2347: 
 2348: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2349: 
 2350:    const double w1 = getBoundaryArrayValueWeight();
 2351:    const double w2 = 1.0 - w1;
 2352:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2353:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2354: 
 2355:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2356: }
 2357: 
 2358: 
 2359: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2360:    const double w1 = getBoundaryArrayValueWeight();
 2361:    const double w2 = 1.0 - w1;
 2362:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2363:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2364: 
 2365:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2366: }
 2367: 
 2368: 
 2369: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2370:    // Returns the value of the velocity at the side center
 2371:    const double w1 = getBoundaryArrayValueWeight();
 2372:    const double w2 = 1.0 - w1;
 2373:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2374:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2375: 
 2376:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2377: }
 2378: 
 2379: 
 2380: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2381:    // Returns the value of the normal component of the velocity at the side center
 2382:    const double w1 = getBoundaryArrayValueWeight();
 2383:    const double w2 = 1.0 - w1;
 2384:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2385:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2386: 
 2387:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2388: }
