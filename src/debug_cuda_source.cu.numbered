 1758: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1759:    // Computes the 3D normal vector to the element at level k
 1760:    // Returns the normal vector and the area of the element
 1761: 
 1762:       if (isTri()) {
 1763:          // For triangles...
 1764: 
 1765:          // Gets the normal vector to the element (with a length equal to twice the area)
 1766:          if constexpr(ics==1) {
 1767:             const int kb0 = max(k, nodes[0]->kb);
 1768:             const int kb1 = max(k, nodes[1]->kb);
 1769:             const int kb2 = max(k, nodes[2]->kb);
 1770: 
 1771:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1772:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1773:             
 1774:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1775:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1776:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1777:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1778: 
 1779:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1780:             area3D = 0.5*len;
 1781: 
 1782:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1783: 
 1784:             return {nx/len, ny/len, nz/len};
 1785: 
 1786:            
 1787:          }
 1788:          else {  // lat/lon
 1789:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1790: 
 1791:          } // if ics
 1792:       }
 1793:       else {
 1794:          // For quads...
 1795: 
 1796:          assert(false && "Element normal vector: quads not yet implemented");
 1797: 
 1798: 
 1799:       }
 1800:    }
 1801: 
 1802: /**
 1803:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1804:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1805:    If the segment is completely inside the element, then it returns true.
 1806: 
 1807:    This function assumes:
 1808:    - The initial point is on a side of the element. 
 1809:    - Its position is given by parameter t in the range [0,1].
 1810:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1811:       intersects the element (elements are convex).
 1812: 
 1813:    To find the intersection point, this function does the following:
 1814:    - it finds the intersection of the line segment with all the element side lines,
 1815:       except for the one that contains the initial point.
 1816:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1817:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1818:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1819:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1820:       track segment is almost parallel to the element side line.
 1821: 
 1822:    Inputs:
 1823:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1824:    @param x2, y2: other end of the line segment
 1825: 
 1826:    Outputs:
 1827:    @param side:  side that intersects the line segment (input and output)
 1828:    @param nextElement (output): element that contains the intersection point
 1829:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1830:    @param zint (input/output): Vertical coordinate of the intersection point
 1831: 
 1832:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1833:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1834:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1835: 
 1836:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1837:    (Delta) being zero.
 1838: 
 1839:    The intersection2 point happens when:
 1840:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1841:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1842:    
 1843:    Assumption: the 4 points (including those of the side segment) are different.
 1844:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1845:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1846:    If true, (xIntersect,yIntersect) is the intersection.				
 1847:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1848: **/
 1849: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1850:                                               double &t, double& tIntersect) {
 1851: 
 1852:    double closest_intersect_t = 1e10;
 1853:    bool found_intersection = false;
 1854: 
 1855:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1856:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1857:    const Point2 x1 = side->point(t);
 1858:    
 1859: 
 1860:    Side *nextSide = nullptr;
 1861:    for (int i = 0; i < i34; i++) {
 1862: 
 1863:       // Element's i-th side 
 1864:       Side *side2 = sides[i];
 1865: 
 1866:       // Skip the side that contains the initial point
 1867:       if (side2 == side) continue;
 1868: 
 1869:       // (x3,y3)-(x4,y4) is the element side line
 1870:       const Point2 x3 = side2->n1->p;
 1871:       const Point2 x4 = side2->n2->p;
 1872: 
 1873:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1874:       const double delta = cross(x2 - x1, x3 - x4);
 1875: 
 1876:       if (delta != 0.0) {
 1877: 
 1878:          const double delta1 = cross(x3 - x1, x3 - x4);
 1879:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1880: 
 1881:          // Solves the two linear equations for tt1 and tt2
 1882:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1883:          const double tt2 = delta2/delta;
 1884: 
 1885:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1886:             closest_intersect_t = min(closest_intersect_t, tt1);
 1887:             nextSide = side2;
 1888: 
 1889:             nextElement = nextSide->otherElem(this);
 1890:             tIntersect = max(small, min(tt1, 1.0-small));
 1891:             t = tt2;
 1892: 
 1893:             found_intersection = true;
 1894:          }
 1895:       
 1896:       }
 1897: 
 1898:    }
 1899: 
 1900:    // found_intersection should always be true, since we checked all the sides.  
 1901:    side = nextSide;
 1902: 
 1903:    return found_intersection;
 1904: }
 1905: 
 1906: 
 1907: 
 1908: 
 1909: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1910:                                               double &t, double& tIntersect) {
 1911: 
 1912:    double closest_intersect_t = 1e10;
 1913:    bool found_intersection = false;
 1914: 
 1915:    for (int i = 0; i < i34; i++) {
 1916: 
 1917:       Side *side2 = sides[i];
 1918: 
 1919:       // (x3,y3)-(x4,y4) is the element side line
 1920:       const Point2 x3 = side2->n1->p;
 1921:       const Point2 x4 = side2->n2->p;
 1922: 
 1923:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1924:       const double delta = cross(x2 - x1, x3 - x4);
 1925: 
 1926:       if (abs(delta) > 0) {
 1927: 
 1928:          const double delta1 = cross(x3 - x1, x3 - x4);
 1929:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1930: 
 1931:          // Solves the two linear equations for tt1 and tt2
 1932:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1933:          const double tt2 = delta2/delta;
 1934: 
 1935:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1936:             closest_intersect_t = min(closest_intersect_t, tt1);
 1937:             side = side2;
 1938:             nextElement = side->otherElem(this);
 1939:             t = tt2;
 1940:             tIntersect = max(small, min(tt1, 1.0-small));
 1941:             found_intersection = true;
 1942:          }
 1943:       
 1944:       }
 1945:       else {  // parallel segments
 1946:          assert(false && "Parallel segments");
 1947:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1948:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1949: 
 1950:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1951: 
 1952:          // const double dist = dot(x1 - x3, side2->n);
 1953:          // if (abs(dist) < small*length(x3 - x4)) {
 1954:          //    const double2 unitarySide = normalize(x4 - x3);
 1955:          //    const double len = dot(x2 - x1, unitarySide);
 1956:          //    t = t + len;
 1957:          //    t = max(0.0, min(t, 1.0));
 1958:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1959: 
 1960: 
 1961:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1962:          //    // t = tt2;
 1963:          //    found_intersection = true;
 1964:          // }
 1965:       }
 1966: 
 1967: 
 1968:    }
 1969: 
 1970:       
 1971:    assert(found_intersection && "No intersection found");
 1972: 
 1973:    // found_intersection should always be true, since we checked all the sides.  
 1974:    return found_intersection;
 1975: }
 1976: 
 1977: 
 1978: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1979:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1980: 
 1981:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1982: 
 1983:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1984:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1985:    // curElement.
 1986: 
 1987:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1988:    // And uses this velocity instead to continue the tracking.
 1989: 
 1990:    // computes the intersection point in cartesian coordinates
 1991:    Point2 intersection = nextSide->p_t(tt);
 1992: 
 1993:    // Nudges the point to the barycenter of the element. 
 1994:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1995:    // next segment intersects the element sides.  
 1996:    curElem->nudgeToBarycenter(intersection);
 1997: 
 1998:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1999:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2000:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2001:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2002: 
 2003:    // If the side is an open boundary, the tangential velocity is zero.
 2004:    if (nextSide->isBnd()) vtan = 0.0;
 2005: 
 2006:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2007:    const double us = vtan*nextSide->t().x;
 2008:    const double vs = vtan*nextSide->t().y;
 2009:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2010: 
 2011:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2012:    const double len2 = norm2(intersection - toPoint2(xt));
 2013:    const double vel2 = dot(u_int, u_int);        
 2014:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2015:    else            dt = 0.0;
 2016: 
 2017:    // The end of this tracking segment is now the intersection point.
 2018:    xt = {intersection.x, intersection.y, zint};
 2019: 
 2020:    u_int = {us, vs, ws};
 2021:    
 2022: }
 2023: 
 2024: /**
 2025:  * Tracks a particle through elements and vertical levels in the mesh.
 2026:  * 
 2027:  * @param x0,y0,z0     Starting position coordinates
 2028:  * @param xt,yt,zt     Target position coordinates
 2029:  * @param dtb          Time step for tracking
 2030:  * @param uuint,vvint,wwint Initial velocity components
 2031:  * @param nextElem     Starting/resulting element index
 2032:  * 
 2033:  * @return Status code of type trackExitCodes
 2034:  * 
 2035:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2036:  * of the details are different. The idea is that the code requires less branches and is better fit
 2037:  * for GPU execution.
 2038:  * 
 2039:  * The main ideas here are:
 2040:  * - The starting point is expected to be in the starting element.
 2041:  * - The end point is guaranteed to be inside an element.
 2042:  * - since the starting point is inside the element, there are only two cases: 
 2043:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2044:  *     (b) it does not and (xt,yt) is already in the starting element.
 2045:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2046:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2047:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2048:  * - tt1 can be positive or negative. We only consider the positive values.
 2049:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2050:  * - The next intersection will occur at the smallest positive tt1.
 2051:  * - This intersection will be the next (x0,y0) position.
 2052:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2053:  *   of getting stuck in a loop.
 2054:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2055:  *   was found.
 2056:  */
 2057: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2058:                                                        Element *&nextElem, int &jlev, double &dt,
 2059:                                                        const Side *origSide) {
 2060: 
 2061: 
 2062: 
 2063:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2064:    // else to do.
 2065:    // If it is, nudges the point to be inside the element.
 2066:    const Element *curElem = nextElem;
 2067:    if (containsPoint(toPoint2(xt), true)) {
 2068: 
 2069:       curElem->interpolateVelocities(xt, u_int);
 2070: 
 2071: addDebugPlot(x0, xt);
 2072:       return true;
 2073:    }
 2074: 
 2075:    Side *side = nullptr;
 2076: 
 2077:    // 1. Initial checks
 2078:    // Verify starting element is valid (wet)
 2079:    assert(!curElem->isDry && "Starting element is dry");
 2080: 
 2081:    // Checks if track has a zero length.
 2082:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2083:    // assert(len2 > 0.0 && "Zero length track"); 
 2084:    
 2085:    const int MAX_ITERATIONS = 1000;
 2086:    
 2087:    double t;
 2088:    Side *nextSide = nullptr;
 2089:    double tIntersect = 1e10;
 2090:    double zint = x0.z;
 2091: 
 2092:    // Horizontal tracking loop
 2093:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2094:    // (x0,y0) is inside the element but the target point is not.
 2095: 
 2096:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2097: 
 2098:    assert(found_intersection && "No intersection found at %d");
 2099: 
 2100:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2101: 
 2102:    // if the tracking segment goes out of water (either dry or edge boundary)
 2103:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2104: 
 2105: addDebugPlot(x0, xt, 0x00A0FF);
 2106:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2107: addDebugPlot(x0, xt, 0x00A0FF);      
 2108: 
 2109:       nextElem = this;
 2110:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2111:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2112:       return true;    
 2113:    }
 2114: 
 2115: 
 2116:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2117:    int iterations = 0;
 2118:    while (iterations < MAX_ITERATIONS) {
 2119:       iterations++;
 2120:       
 2121:       Element *curElem = nextElem;
 2122: 
 2123:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2124: addDebugPlot(x0, xt);
 2125:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2126: 
 2127:       // If we are already in the target element, we are done.
 2128:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2129:       if (!found_intersection) break;
 2130: 
 2131: 
 2132: 
 2133:       // if the tracking segment goes out of water (either dry or edge boundary).
 2134:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2135: addDebugPlot(x0, xt, 0x00A0FF);
 2136:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2137: addDebugPlot(x0, xt, 0x00A0FF);   
 2138:          nextElem = curElem;
 2139: 
 2140:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2141:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2142:          return true;
 2143:       }
 2144:       
 2145:       // Update position and element for next iteration
 2146:       side = nextSide;
 2147: 
 2148:    }
 2149: 
 2150:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2151: 
 2152:  
 2153:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2154:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2155: addDebugPlot(x0, xt);   
 2156:    nextElem->interpolateVelocities(xt, u_int); 
 2157: 
 2158:    return true;
 2159: }
 2160: 
 2161: 
 2162: __inline__ __device__ double Element::computeSignedArea(void) const {
 2163:    // Compute the area of the element
 2164: 
 2165:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2166: 
 2167:    // In the quad case we need to add the area of the other triangle.
 2168:    if (isQuad()) {
 2169:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2170:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2171:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2172:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2173: 
 2174:       res += ar1;
 2175:    }
 2176: 
 2177:    return res;
 2178: }
 2179: 
 2180: 
 2181: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2182:                                                                 (nodes[1]->isDry2()) ||
 2183:                                                                 (nodes[2]->isDry2()) ||
 2184:                                                                 (i34==4 && nodes[3]->isDry2());
 2185: }
 2186: 
 2187: __inline__ __device__ double Element::detJ_eta(void) const {
 2188:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2189:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2190: }
 2191: 
 2192: __inline__ __device__ double Element::detJ_xi(void) const {
 2193:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2194:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2195: }
 2196: 
 2197: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2198:    // In boundary sides, the element 1 is nullptr
 2199:    return side->elems[1] == nullptr; 
 2200: }
 2201: 
 2202: 
 2203: 
 2204: /**
 2205:    Compute the shape coordinates of the point (xt,yt) in the element.
 2206:    @param xt (input): x-coordinate of the point
 2207:    @param shpCoords (output): shape coordinates of the point
 2208:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2209:    @return true if the point is inside the element, false otherwise
 2210: **/
 2211: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2212:                                             bool fixNegshpCoord) const {
 2213: 
 2214:    // Compute the shape coordinates of the point xt in the element.
 2215:    if (i34==3) {
 2216:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2217:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2218:       // and in this case, the pt will be nudged into the element
 2219:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2220:       // from the local frame, so use additional check.
 2221: 
 2222:       Point2 x0, x1, x2;
 2223: 
 2224:       if constexpr(ics==1) {
 2225:          x0 = nodes[0]->p;
 2226:          x1 = nodes[1]->p;
 2227:          x2 = nodes[2]->p;
 2228:       }
 2229:       else // lat/lon
 2230:       {
 2231:          Error("Not implemented yet");
 2232: #ifdef ICS2
 2233:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2234:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2235:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2236: #endif
 2237:       }
 2238: 
 2239:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2240:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2241:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2242:       shpCoords[3] = 0.0;
 2243:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2244: 
 2245:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2246:       // then we fix the negative shape coordinates.
 2247:       if (fixNegshpCoord && tmpmin<=0.0) {
 2248: 
 2249:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2250:          // keeping the sum of the shape coordinates equal to 1.
 2251:          // I have tested and compared the new algorithm with the old one, and they give
 2252:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2253:          // The new algorithm should be faster since it is branchless.
 2254:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2255:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2256:          
 2257:          shpCoords[0] = (shpCoords[0] + a)*b;
 2258:          shpCoords[1] = (shpCoords[1] + a)*b;
 2259:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2260: 
 2261:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2262:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2263:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2264:          }
 2265: 
 2266:          // Update the point coordinates for the new shape coordinates
 2267:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2268:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2269:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2270: 
 2271:       }
 2272: 
 2273:       // Check if the point is inside the element
 2274:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2275:    }
 2276:    else {
 2277:       Error("Not implemented yet");
 2278: #ifdef QUADS
 2279:       // Reproject pt in eframe of nel for ics=2
 2280:       if constexpr(ics==1) {
 2281:          xn2 = xt; 
 2282:          yn2 = yt;
 2283:       }
 2284:       else {
 2285:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2286:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2287:       }
 2288: 
 2289:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2290: #endif
 2291:    }
 2292: 
 2293:    return false;  // Never reached
 2294: 
 2295: }
 2296: 
 2297: 
 2298: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2299: // Convert shape coordinates to cartesian coordinates
 2300: 
 2301:    if (i34 == 3) {
 2302:       // Triangular element
 2303:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2304:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2305:    }
 2306:    else {
 2307:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2308:    }
 2309: 
 2310: }
 2311: 
 2312: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2313:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2314:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2315:    // The formula for the integral is:
 2316:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2317: 
 2318:    printf("intPhiPhi: TEST\n");
 2319: 
 2320:    const Node *n0 = nodes[0];
 2321:    const Node *n1 = nodes[1];
 2322:    const Node *n2 = nodes[2];
 2323:    const Node *n3 = nodes[3];
 2324: 
 2325:    const Vector2 p0 = n0->p;
 2326:    const Vector2 p1 = n1->p;
 2327:    const Vector2 p2 = n2->p;
 2328:    const Vector2 p3 = n3->p;
 2329: 
 2330:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2331:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2332:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2333:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2334: 
 2335:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2336: }
 2337:    
 2338: 
 2339: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2340:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2341:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2342:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2343:    // The formula is also based on the identity:
 2344:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2345:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2346: 
 2347:    printf("intGradPhiGradPhi: TEST\n");   
 2348: 
 2349:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2350: 
 2351:    const double x0 = nodes[0]->p.x;
 2352:    const double y0 = nodes[0]->p.y;
 2353:    const double x1 = nodes[1]->p.x;
 2354:    const double y1 = nodes[1]->p.y;
 2355:    const double x2 = nodes[2]->p.x;
 2356:    const double y2 = nodes[2]->p.y;
 2357:    const double x3 = nodes[3]->p.x;
 2358:    const double y3 = nodes[3]->p.y;
 2359: 
 2360:    double res = 0.0;
 2361:    
 2362:    // Quadrature points in xi and eta coordinates
 2363:    #pragma unroll
 2364:    for (int i = 0; i < 4; i++) {
 2365:       // For each quadrature point...
 2366: 
 2367:       const Point2 p = GaussPoint(i);
 2368:       const double eta = p.x;
 2369:       const double xi  = p.y;
 2370: 
 2371:       // Jacobian entries at the Gauss point p
 2372:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2373:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2374:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2375:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2376: 
 2377:       const double detJ = jacobianDet(p);
 2378:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2379: 
 2380:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2381:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2382:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2383:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2384:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2385: 
 2386:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2387:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2388:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2389:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2390:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2391: 
 2392:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2393:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2394:    }
 2395: 
 2396:    return res;
 2397: }
 2398: 
 2399: 
 2400: /**  Interpolate velocities at a given point (xt,yt,zt)
 2401: 
 2402:    @param xt, yt, zt: coordinates of the point to interpolate
 2403:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2404: 
 2405:    This is done in four steps:
 2406: 
 2407:    1. Find the shape coordinates for the final position in the element.
 2408:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2409:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2410:       z levels at xt, yt at each step.   
 2411:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2412:       horizontally and vertically.
 2413: **/
 2414: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2415:    // Interpolate the velocities at the point xt. 
 2416:    // This function works the same for triangular and quadrilateral elements.
 2417:    double shpCoord[4];
 2418: 
 2419:    // First step is to compute the shape coordinates of (xt,yt)
 2420:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2421:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2422: 
 2423:    // Second step is to find the level that contains zt
 2424:    // Uses a binary search to find the level
 2425:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2426:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2427:    int R = nvrt - 1;
 2428: 
 2429:    // Get the z coordinates at the nodes of the element at the levels L and R
 2430:    double zLAtNodes[4], zRAtNodes[4];
 2431:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2432:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2433: 
 2434:    double zL = interpolate(shpCoord, zLAtNodes);
 2435:    double zR = interpolate(shpCoord, zRAtNodes);
 2436:    
 2437:    // Interpolates vertically the velocities
 2438:    double wght1, wght2;
 2439:    if (xt.z<=zL) {
 2440:       wght1 = 1.0;
 2441:       wght2 = 0.0;
 2442:    }
 2443:    else if (xt.z>=zR) {
 2444:       wght1 = 0.0;
 2445:       wght2 = 1.0;
 2446:    }
 2447:    else {
 2448:       // Perform a binary search to find the levels between L and R that contain xt.z
 2449:       while (R - L > 1) {
 2450:          int M = (L + R) / 2;
 2451: 
 2452:          double zMAtNodes[4];
 2453:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2454:          double zM = interpolate(shpCoord, zMAtNodes);
 2455:          if (zM < xt.z) 
 2456:          {
 2457:             L = M;
 2458:             zL = zM;
 2459:          }
 2460:          else 
 2461:          {
 2462:             R = M;
 2463:             zR = zM;
 2464:          }
 2465:       }
 2466:       assert(L == R-1);
 2467:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2468: 
 2469:       wght2 = (xt.z - zL)/(zR - zL);
 2470:       wght1 = 1.0 - wght2;
 2471:    }
 2472: 
 2473:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2474:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2475: 
 2476:    // Neither of the interpolated velocities should be NaN
 2477:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2478: 
 2479: }
 2480: 
 2481: 
 2482: 
 2483: 
 2484: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2485: 
 2486:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2487:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2488:    const Node *n1 = side->n1;
 2489:    const Node *n2 = side->n2;
 2490: 
 2491:    bool n1_match = (n1->nodeBnd->segment == segment);
 2492:    bool n2_match = (n2->nodeBnd->segment == segment);
 2493: 
 2494:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2495:    if (n1_match && n2_match) {
 2496:       return 0.5;
 2497:    } else if (n1_match) {
 2498:       return 1.0;
 2499:    } else if (n2_match) {
 2500:       return 0.0;
 2501:    }
 2502: 
 2503:    return 0.0;
 2504: }
 2505: 
 2506: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
