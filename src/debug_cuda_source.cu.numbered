 8063: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8064:    Node *nodes = mesh->localNodeData;
 8065: 
 8066:    *addr = nodes;
 8067:    *sizeNode = sizeof(Node);
 8068: 
 8069:    switch (varCode) {
 8070:       case (int)VarCode::depth:
 8071:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8072:          *sizeType = sizeof(double);
 8073:          break;
 8074:       case (int)VarCode::eta:
 8075:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8076:          *sizeType = sizeof(double);
 8077:          break;
 8078:       case (int)VarCode::x:
 8079:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8080:          *sizeType = sizeof(Vector2);
 8081:          break;
 8082:       case (int)VarCode::z:
 8083:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8084:          *sizeType = sizeof(double);
 8085:          break;
 8086:       case (int)VarCode::kb:
 8087:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8088:          *sizeType = sizeof(int);
 8089:          break;
 8090:       case (int)VarCode::isdry:
 8091:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8092:          *sizeType = sizeof(int);
 8093:          break;         
 8094:       case (int)VarCode::w:
 8095:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8096:          *sizeType = sizeof(double);
 8097:          break;
 8098:       case (int)VarCode::u:
 8099:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8100:          *sizeType = sizeof(Vector2);
 8101:          break;         
 8102:       default:
 8103:          *offset = -1;    
 8104:    }  
 8105:    
 8106: }
