 9494: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 9495: 
 9496:    ELEM(elem);
 9497: 
 9498:    switch (varCode) {
 9499:       case (int)VarCode::outputCoords:
 9500:          const Point2 coords = elem->outputCoords();
 9501:          res[elem->idx*2    ] = coords.x;
 9502:          res[elem->idx*2 + 1] = coords.y;
 9503:          break;
 9504:    }
 9505: }
 9506: 
 9507: 
 9508: extern "C" __global__ void getSideVarFunc(int varCode, double *res) {
 9509: 
 9510:    SIDE(side);
 9511: 
 9512:    switch (varCode) {
 9513:       case (int)VarCode::outputCoords:
 9514:          const Point2 coords = side->outputCoords();
 9515:          res[side->idx*2    ] = coords.x;
 9516:          res[side->idx*2 + 1] = coords.y;
 9517:          break;
 9518:    }
 9519: }
 9520: 
 9521: 
 9522: template<TurbulenceModel M>
 9523: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
 9524:    if constexpr (M == TurbulenceModel::GLS)
 9525:       return turb.tke[k];
 9526:    else
 9527:       return 0.0;
 9528: }
 9529: template<TurbulenceModel M>
 9530: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
 9531:    if constexpr (M == TurbulenceModel::GLS)
 9532:       return turb.mxl[k];
 9533:    else
 9534:       return 0.0;
 9535: }
 9536: 
 9537: 
 9538: extern "C" __global__ void getNodeVar(int varCode, void *res, int k) {
 9539:    // Packed local order into res. Caller allocates sizePart * nbytes.
 9540:    NODE(node);
 9541: 
 9542:    switch (varCode) {
 9543:       case (int)VarCode::outputCoords: {
 9544:          const Point2 coords = node->outputCoords();
 9545:          double *out = (double *)((char *)res + idx_node * 16);
 9546:          out[0] = coords.x;
 9547:          out[1] = coords.y;
 9548:          break;
 9549:       }
 9550:       case (int)VarCode::depth:
 9551:          *(double *)((char *)res + idx_node * 8) = node->depth;
 9552:          break;
 9553:       case (int)VarCode::kb:
 9554:          *(int *)((char *)res + idx_node * 4) = (int)node->kb;
 9555:          break;
 9556:       case (int)VarCode::eta:
 9557:          *(double *)((char *)res + idx_node * 8) = node->eta2;
 9558:          break;
 9559:       case (int)VarCode::u_air: {
 9560:          double *out = (double *)((char *)res + idx_node * 16);
 9561:          out[0] = node->u_air.x;
 9562:          out[1] = node->u_air.y;
 9563:          break;
 9564:       }
 9565:       case (int)VarCode::isdry:
 9566:          *(int *)((char *)res + idx_node * 4) = (int)node->isDry;
 9567:          break;
 9568:       case (int)VarCode::u: {
 9569:          double *out = (double *)((char *)res + idx_node * nvrt * 16);
 9570:          if (k >= 0) {
 9571:             out[0] = node->u2[k].x;
 9572:             out[1] = node->u2[k].y;
 9573:          } else {
 9574:             for (int lev = 0; lev < nvrt; lev++) {
 9575:                out[lev*2    ] = node->u2[lev].x;
 9576:                out[lev*2 + 1] = node->u2[lev].y;
 9577:             }
 9578:          }
 9579:          break;
 9580:       }
 9581:       case (int)VarCode::z: {
 9582:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9583:          if (k >= 0)
 9584:             out[0] = node->z[k];
 9585:          else
 9586:             for (int lev = 0; lev < nvrt; lev++)
 9587:                out[lev] = node->z[lev];
 9588:          break;
 9589:       }
 9590:       case (int)VarCode::w: {
 9591:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9592:          if (k >= 0)
 9593:             out[0] = node->w2[k];
 9594:          else
 9595:             for (int lev = 0; lev < nvrt; lev++)
 9596:                out[lev] = node->w2[lev];
 9597:          break;
 9598:       }
 9599:       case (int)VarCode::dfh: {
 9600:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9601:          if (k >= 0)
 9602:             out[0] = node->dfh[k];
 9603:          else
 9604:             for (int lev = 0; lev < nvrt; lev++)
 9605:                out[lev] = node->dfh[lev];
 9606:          break;
 9607:       }
 9608:       case (int)VarCode::dfv: {
 9609:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9610:          if (k >= 0)
 9611:             out[0] = node->dfv[k];
 9612:          else
 9613:             for (int lev = 0; lev < nvrt; lev++)
 9614:                out[lev] = node->dfv[lev];
 9615:          break;
 9616:       }
 9617:       case (int)VarCode::tke: {
 9618:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9619:          if (k >= 0)
 9620:             out[0] = getTKE(node->turb, k);
 9621:          else
 9622:             for (int lev = 0; lev < nvrt; lev++)
 9623:                out[lev] = getTKE(node->turb, lev);
 9624:          break;
 9625:       }
 9626:       case (int)VarCode::mxl: {
 9627:          double *out = (double *)((char *)res + idx_node * nvrt * 8);
 9628:          if (k >= 0)
 9629:             out[0] = getMXL(node->turb, k);
 9630:          else
 9631:             for (int lev = 0; lev < nvrt; lev++)
 9632:                out[lev] = getMXL(node->turb, lev);
 9633:          break;
 9634:       }
 9635:    }
 9636: }
 9637: 
 9638: 
 9639: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9640:    SIDE(side);
 9641: 
 9642:    switch (varCode) {
 9643:       case (int)VarCode::outputCoords: {
 9644:          const Point2 coords = side->outputCoords();
 9645:          double *out = (double *)((char *)res + idx_side * 16);
 9646:          out[0] = coords.x;
 9647:          out[1] = coords.y;
 9648:          break;
 9649:       }
 9650:       case (int)VarCode::n1:
 9651:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9652:          break;
 9653:       case (int)VarCode::n2:
 9654:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9655:          break;
 9656:       case (int)VarCode::isdry:
 9657:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9658:          break;
 9659:    }
 9660: }
 9661: 
 9662: 
 9663: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9664:    ELEM(elem);
 9665: 
 9666:    switch (varCode) {
 9667:       case (int)VarCode::outputCoords: {
 9668:          const Point2 coords = elem->outputCoords();
 9669:          double *out = (double *)((char *)res + idx_elem * 16);
 9670:          out[0] = coords.x;
 9671:          out[1] = coords.y;
 9672:          break;
 9673:       }
 9674:       case (int)VarCode::FaceIndices: {
 9675:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9676:          for (int j = 0; j < 4; j++)
 9677:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9678:          break;
 9679:       }
 9680:       case (int)VarCode::isdry:
 9681:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9682:          break;
 9683:       case (int)VarCode::w: {
 9684:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9685:          if (k >= 0)
 9686:             out[0] = elem->w[k];
 9687:          else
 9688:             for (int lev = 0; lev < nvrt; lev++)
 9689:                out[lev] = elem->w[lev];
 9690:          break;
 9691:       }
 9692:    }
 9693: }
 9694: 
 9695: 
 9696: 
 9697: 
 9698: extern "C" __global__ void getNodeVarFunc(int varCode, double *res) {
 9699: 
 9700:    NODE(node);
 9701: 
 9702:    switch (varCode) {
 9703:       case (int)VarCode::outputCoords:
 9704:          const Point2 coords = node->outputCoords();
 9705:          res[node->idx*2    ] = coords.x;
 9706:          res[node->idx*2 + 1] = coords.y;
 9707:          break;
 9708:    }
 9709: }
