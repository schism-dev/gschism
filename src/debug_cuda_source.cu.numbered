  429: // Polynomial class
  430: template<int grade>
  431: struct Polynomial {
  432:     // Static assertion to give a clear error message at compile time
  433:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  434: };
  435: 
  436: 
  437: // Explicit specialization for grade 4
  438: template<>
  439: struct Polynomial<4> {
  440:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  441: 
  442:    // Constructor from coefficients
  443:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  444: 
  445:    __device__ __forceinline__ double eval(double x) const {
  446:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  447:    }
  448: };
