 2608: /**
 2609:  * This method performs backtracking from the side center until a time -dt back in time 
 2610:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2611:  * intermediate point.
 2612:  *
 2613:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2614:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2615:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2616:  * remaining time.
 2617:  * 
 2618:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2619:  * 
 2620:  * @param uuint, vvint, wwint: Velocities at the final point
 2621:  * @param jlev: Level at which the backtracking is performed
 2622:  * @param dt, dtbk: Tracking timesteps
 2623:  * @return: True if the backtracking was successful, false otherwise
 2624:  */
 2625: __inline__ __device__ bool Side::btrack(
 2626:       int jlev,
 2627:       double dt,            // Tracking time
 2628:       double dtbk,          // Tracking timestep
 2629:       Vector3 &u_int        // Velocities at the initial point
 2630: ) const {
 2631: 
 2632:    // Start from side center
 2633:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2634: 
 2635:  
 2636:    double time_rm = dt; // Remaining time
 2637: 
 2638: 
 2639:    // // Initialize outputs XXX
 2640:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2641:    //    sclr[i] = 0.0;
 2642:    // }
 2643: 
 2644: 
 2645:    // Initial velocities
 2646:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2647: 
 2648:    // Find the element that is in the direction opposite to the velocity
 2649:    Element* curElem = findElementTowards(toVector2(u_int));
 2650: 
 2651: 
 2652:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2653:    if (curElem == nullptr) {
 2654:       // Make velocity parallel to the side
 2655:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2656:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2657:       curElem = otherElem(curElem);
 2658:       
 2659:    }
 2660: 
 2661: // Nudges it towards the circumcenter
 2662: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2663: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2664:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2665: const double eps = 9.013e-3;                 
 2666: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2667: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2668: 
 2669: 
 2670: 
 2671:    const int MAX_ITERATIONS = 1000; 
 2672:    Element* nextElem = curElem;
 2673:    int iter = 0;
 2674:    while(true) {
 2675: 
 2676:       // Calculate timestep
 2677:       double dtb = min(dtbk, time_rm);
 2678: 
 2679:       // Next point in the backtracking curve
 2680:       Point3 xt = x0 - dtb*u_int;
 2681:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2682:       assert(found && "Backtracking failed in btrack");
 2683: 
 2684:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2685: 
 2686:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2687:                       // then time_rm needs to be increased by the unused time.
 2688: 
 2689:       // If the velocity is too small, we stop the backtracking
 2690:       const double vmag = length(toVector2(u_int));
 2691:       if (vmag <= velmin_btrack) break;
 2692: 
 2693:       // The current point becomes the next segment's starting point.
 2694:       x0 = xt;
 2695:  
 2696:       curElem = nextElem;
 2697: 
 2698:       iter++;
 2699:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2700:    }
 2701: 
 2702: 
 2703: }
 2704: 
 2705: 
