 1353: // Helper functions for computing the local node index at a given offset from another.
 1354: __device__ __inline__ int nxq(int offset, int index, int size) {
 1355:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1356:    // to the index to make it positive
 1357:    assert(index + offset + 16*size >= 0);
 1358:    return (index + offset + 16*size) % size;  
 1359: }
 1360: 
 1361: __device__ __inline__ int nxq(int index, int size) {
 1362:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1363:    // to the index to make it positive
 1364:    assert(index + 16*size >= 0);
 1365:    return (index + 16*size) % size; 
 1366: }
