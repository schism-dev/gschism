 5483:    __global__ void resetBoundaryAreas(void) {
 5484:       // Reset boundary areas and lengths for each segment.
 5485: 
 5486:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5487:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5488:       SIDE_BND(sideBnd);
 5489: 
 5490:       BoundarySegment *segment = sideBnd->segment;
 5491: 
 5492:       segment->carea = 0.0;
 5493:       segment->clen = 0.0;
 5494:  
 5495:    }
 5496: 
 5497:    __global__ void computeBoundaryAreas(void) {
 5498:    // Calculation of cross-section areas and lengths for flow b.c.
 5499: 
 5500:       SIDE_BND(sideBnd);
 5501: 
 5502:       const Side *side = sideBnd->side;
 5503:       BoundarySegment *segment = sideBnd->segment;
 5504: 
 5505:       if (segment->ifltype != 0) {
 5506: 
 5507:          const Node *n1 = side->n1;
 5508:          const Node *n2 = side->n2;
 5509: 
 5510:          const double htot = side->htot2();
 5511: 
 5512:          if (!side->isDry) {
 5513:             atomicAdd(&segment->carea, htot*side->len);
 5514:             atomicAdd(&segment->clen, side->len);
 5515:          }
 5516:       }
 5517: 
 5518:    }
 5519: 
 5520: 
 5521:    __global__ void computeFlowBcVelocities(double time) {
 5522: 
 5523:       SIDE_BND(sideBnd);
 5524: 
 5525:       const Side *side = sideBnd->side;
 5526:  
 5527:       const bool isDry = side->isDry;
 5528:       const bool isLand = sideBnd->segment->isLand;
 5529: 
 5530:    
 5531:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5532: 
 5533:       if (isDry || isLand) return;
 5534: 
 5535:       // For wet sides in open boundaries...
 5536:       const Vector2 n = side->n;
 5537:       const BoundarySegment *segment = sideBnd->segment;
 5538: 
 5539:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5540: 
 5541:       const int ifltype = segment->ifltype;
 5542: 
 5543:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5544:       const Vector2 r_nuth0 = r_uth0*n;
 5545: 
 5546: 
 5547:       if (ifltype == 1 || ifltype == 2) {
 5548:       
 5549:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5550: 
 5551:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5552:          
 5553:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5554:          
 5555:       } else if (ifltype == -1) { // Flather 1
 5556: 
 5557:          for (int k = 0; k < nvrt; k++) {
 5558: 
 5559:             // uth is the normal vel.; no ramp up
 5560:             const double uth = sideBnd->nuth(k);
 5561:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5562: 
 5563:             sideBnd->ubc[k] += uth*n;
 5564:          }
 5565: 
 5566:       } else if (ifltype == 3 || ifltype == 5) {
 5567:          // vnth0=0 !normal vel.
 5568: 
 5569:          Vector2 r_u1_bar = {0.0, 0.0};
 5570:          // Computes the contribution to the velocity from all tide frequencies
 5571:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5572: 
 5573:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5574:             const Vector2 umo  = sideBnd->umo(jfr); 
 5575: 
 5576:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5577:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5578:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5579:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5580: 
 5581:          }
 5582: 
 5583: 
 5584:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5585: 
 5586:       } // if (ifltype = 3 || ifltype == 5
 5587: 
 5588: 
 5589: 
 5590:    }
 5591: 
 5592:    __global__ void computeElevationBoundaryConditions(double time) {
 5593:       // Compute elevation essential boundary conditions 
 5594: 
 5595:       NODE_BND(nodeBnd); // Each boundary node.
 5596: 
 5597:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5598: 
 5599:       const Node *node = nodeBnd->node;
 5600:       const BoundarySegment *segment = nodeBnd->segment;
 5601:       const int iettype = segment->iettype;
 5602:       
 5603: 
 5604:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5605:       double eic = 0.0;
 5606:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5607:       else                 eic = 0.0;
 5608: 
 5609:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5610:       const double r_eth = ramp*nodeBnd->eth;
 5611:       double r_eta1_bar = 0.0;
 5612: 
 5613: 
 5614:       // Compute tide elevation
 5615:       if (iettype == 3 || iettype == 5) {   
 5616: 
 5617:          if constexpr(iloadtide==1) { // loading tide
 5618:             assert(false && "Loading tide not implemented");
 5619:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5620:          }
 5621:          
 5622:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5623: 
 5624:             const double efa  = nodeBnd->efa[jfr]; 
 5625:             const double emo  = nodeBnd->emo[jfr]; 
 5626: 
 5627:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5628:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5629:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5630: 
 5631:          } // for jfr
 5632: 
 5633:       } // if iettype
 5634: 
 5635:       switch (iettype) {
 5636:          case 1:
 5637:          case 2:
 5638:          case 4:
 5639:             nodeBnd->elbc = r_eic + r_eth;
 5640:             break;
 5641:          case 3:
 5642:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5643:             break;
 5644:          case 5:
 5645:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5646:             break;
 5647:       } // switch
 5648: 
 5649: 
 5650:       //Add inverse barometric effects
 5651:       if (iettype != 0 && inv_atm_bnd == 1) {
 5652:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5653:       }
 5654: 
 5655:    }
 5656: 
 5657: 
 5658:    __global__ void computeHorizontalViscosity(void) { 
 5659: 
 5660:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5661: 
 5662:       SIDE(side);
 5663: 
 5664:       if (side->isDry) return;
 5665: 
 5666:       for (int k = 0; k < nvrt; k++) {
 5667:          side->nuGradU[k] = {0.0, 0.0};
 5668:       }
 5669: 
 5670:       if constexpr(ihorcon == 1) {
 5671:          for (int k = side->kb; k < nvrt - 1; k++) {
 5672:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5673:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5674:             // By Zhang and Baptista.
 5675: 
 5676:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5677:             // This is a standard discretization of the Laplacian operator.
 5678:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5679:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5680:             // Gamma is hvis_coef0 in the code.
 5681:             // The value of gamma needs to be < 0.5.
 5682: 
 5683:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5684:             // side under consideration in each of the two possible elements that share the side.
 5685:             Vector2 sumU = {0.0, 0.0};
 5686:             for (int l = 0; l < 2; l++) {
 5687:                const Element *elem = side->elems[l];
 5688: 
 5689:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5690: 
 5691:                // Find the local index of the side in the element
 5692:                const int idxSide = elem->sideLocalIdx(side);
 5693: 
 5694:                // Find the two sides that are connected to the side under consideration
 5695:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5696:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5697: 
 5698:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5699: 
 5700:             }
 5701: 
 5702:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5703: 
 5704:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5705:    
 5706:          }
 5707:       }
 5708:       else if constexpr(ihorcon == 2) {
 5709:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5710:       }
 5711: 
 5712: 
 5713:    }
 5714: 
 5715: 
 5716:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5717:       // Set essential boundary conditions 
 5718:       NODE(node); // Each boundary node
 5719:       NodeBoundary *nodeBnd = node->nodeBnd;
 5720:       
 5721:  
 5722:       // Check if this node has essential BC
 5723:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5724:          // Verify BC value is valid
 5725:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5726: 
 5727:        
 5728:          // Set diagonal to 1 and zero off-diagonals
 5729:          node->coeffDiag = 1.0;
 5730: 
 5731:          for (int j = 0; j < node->numNodes; j++) {
 5732:                node->coeffMatrix[j] = 0.0;
 5733:          }
 5734:          
 5735:          // Set solution and RHS to BC value
 5736:          node->mX  = nodeBnd->elbc;
 5737:          node->qel = nodeBnd->elbc;
 5738: 
 5739:       } else {
 5740:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5741: 
 5742:          for (int j = 0; j < node->numNodes; j++) {
 5743:                Node* nbNode = node->nodes[j];
 5744:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5745:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5746:                   // Verify neighbor's BC value
 5747:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5748: 
 5749:                   // Subtract contribution to RHS
 5750:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5751:                   node->coeffMatrix[j] = 0.0;  
 5752:                }
 5753:          }
 5754:       }
 5755:    }
 5756: 
 5757: 
 5758:    __global__ void updateElevation(void) {
 5759:       NODE(node);
 5760: 
 5761: 
 5762:       node->eta2 = node->mX;
 5763: 
 5764:       node->updateZCoordData();
 5765:    }
 5766: 
 5767: 
 5768:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5769: 
 5770:       SIDE(side);
 5771: 
 5772:       side->U = {0.0, 0.0}; 
 5773:          
 5774:       if(side->isDry) return;
 5775: 
 5776:       // Vertically integrated velocity U
 5777:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5778:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5779:          side->U += side->Dz(k + 1)*uc;  
 5780:       }
 5781: 
 5782:    }
 5783: 
 5784:    __global__ void computeBottomDragVegetation(void) {
 5785:       // UNFINISHED. CHECK THIS:
 5786:       // How many kernels are needed? Why so many for loops?
 5787:       // Is the loop on sides needed?
 5788: 
 5789:       NODE(node);
 5790: 
 5791: 
 5792:       const int    kb      = node->kb;
 5793:       const double htot    = node->htot2(); 
 5794:       
 5795:       if (node->isDry) {
 5796:          // Default values for dry nodes
 5797:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5798:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5799: 
 5800:          return;
 5801:        
 5802:       }
 5803: 
 5804:       // Computes bottom drag Cd based on the selected nchi
 5805:       node->computeBottomDragCd();
 5806:       
 5807: 
 5808: 
 5809:       //   Bottom stress in m^2/s^2
 5810:       if (node->rho[kb + 1] >= -98.0)
 5811:       {
 5812:          const double mag_u = length(node->u2[kb + 1]);
 5813:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5814: 
 5815:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5816:          // !sediment erosion: this part needs more documentation
 5817:       }
 5818:     
 5819: 
 5820: 
 5821:       // Compute vegetation parameters
 5822:       //--------------------------------
 5823: 
 5824:       // SAV constants
 5825:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5826:       constexpr double veg_cfpsi = 0.16;
 5827: 
 5828:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5829:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5830: 
 5831:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5832:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5833:          int kbin = 0; // bin index
 5834:          for (int k = kb; k < nvrt; k++) {
 5835:             // Computes node height above the bottom level
 5836:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5837:             assert(false && "Vertical variation of vegetation not implemented");
 5838: 
 5839:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5840:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5841:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5842:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5843:             // } else {
 5844:             //    // Find the bin at which the current vertical level is
 5845:             //    while (kbin<nbins_veg_vert) {
 5846:             //       const double zn = node->z[kbin];
 5847:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5848:             //          break;
 5849:             //       } // if
 5850:             //       kbin++;
 5851:             //    } // while
 5852:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5853: 
 5854:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5855:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5856:                
 5857:             //    // Linear interpolation of the vegetation parameters
 5858:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5859:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5860:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5861:             // } // if rl10
 5862: 
 5863:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5864: 
 5865:          } // for k
 5866: 
 5867: 
 5868:       } else { // Ganthy (iveg==2)
 5869:       //  Modify canopy height, diameter, and density
 5870: 
 5871:          // Make sure there is vegetation on this node
 5872:          if (node->veg_h_unbent > 0.0) {
 5873:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5874: 
 5875:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5876:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5877:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5878: 
 5879:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5880:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5881:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5882:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5883:          } // if veg_h_unbent
 5884: 
 5885:          for (int k = 0; k < nvrt; k++) {
 5886:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5887:          } // for k
 5888:       
 5889: 
 5890:       } // if iveg
 5891:      
 5892: 
 5893:       // Compute vertical mean of veg_alpha3D
 5894:       if (iveg != 0) {
 5895:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5896:          double sum1=0.0;
 5897:          double sum2=0.0;
 5898:          // Integrate over each level under the canopy...
 5899:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5900:             const double Dz = node->Dz(k);
 5901: 
 5902:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5903:             sum2 += Dz;
 5904: 
 5905:          } // for k
 5906:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5907:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5908: 
 5909:       } // if iveg
 5910: 
 5911:    }
 5912: 
 5913:    __global__ void computeVegetationAndDragParameters(void) {
 5914:       // Computes the vegetation and drag model parameters:
 5915:       // chi, \tilde\chi, beta, \breve{H}
 5916:       
 5917:       SIDE(side);
 5918: 
 5919:       side->hhat = 0.0;
 5920:       side->chi2 = 0.0;
 5921:       side->chi = 0.0;
 5922:       side->veg_c2 = 0.0;
 5923:       side->veg_beta = 0.0;
 5924: 
 5925:       if (side->isDry) return;
 5926: 
 5927:       const double htot = side->htot2();
 5928:       const int    kb   = side->kb;
 5929: 
 5930:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5931: 
 5932:       const double veg_h     = side->veg_h();
 5933:       const double veg_nv    = side->veg_nv();
 5934:       const double veg_c     = side->veg_c();
 5935:       const double veg_beta  = side->veg_beta;
 5936:       const double veg_alpha = side->veg_alpha_vert_mean();
 5937: 
 5938:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5939:       // Velocity magnitude at the bottom level
 5940:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5941:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5942:       side->chi2 = side->Cd()*vmag1;
 5943:       side->chi  = side->chi2;
 5944:       if constexpr(iveg != 0) {
 5945:          const Node *n1 = side->n1;
 5946:          const Node *n2 = side->n2;
 5947:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5948:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5949:       }
 5950: 
 5951:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5952: 
 5953:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5954:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5955:       double magUa = 0.0;
 5956:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5957:          // 3D wet side with veg...
 5958: 
 5959:          double magUa = 0.0;
 5960:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5961:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5962: 
 5963:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5964:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5965:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5966: 
 5967:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5968:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5969: 
 5970:                // Velocity magnitude at the bottom (l) of the level
 5971:                const double ul = length(side->u2[k]);
 5972: 
 5973:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5974:                magUa += Dz*0.5*(uh + ul);
 5975: 
 5976:             } // if HasVegetation
 5977:          } // for k
 5978:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5979: 
 5980:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5981:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5982:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5983:             const double zCpy = side->zTopCanopy();
 5984:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5985:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5986:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5987:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5988:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5989:          } // if isSubmerged
 5990:       } // if iveg   
 5991: 
 5992:       // Computes the friction modified depth, \breve{H} in notes
 5993:       if (side->is2D()) { // 2D
 5994: 
 5995:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5996:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5997: 
 5998:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5999: 
 6000:          side->hhat = htot*htot/fricH; 
 6001: 
 6002:       } else { // 3D
 6003:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6004: 
 6005:          if constexpr(iveg != 0) {
 6006:             
 6007:             if (side->isSubmerged()) { 
 6008:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6009:                side->hhat -= veg_c*Hhat_alpha;
 6010: 
 6011:             } else { // Emergent
 6012:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6013:             }
 6014:          } // if iveg
 6015: 
 6016:          // Enforce positivity for 3D model
 6017:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6018:       } // if 3D
 6019: 
 6020:    }
 6021: 
 6022: 
 6023: 
 6024:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6025:    // Computes the density gradient between two elements, e1 and e2.
 6026:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6027:    // zero in the direction normal to the side. 
 6028:    // 
 6029:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6030:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6031:    //
 6032:    // Input:
 6033:    //    e1: Element
 6034:    //    e2: Neighbor element (or nullptr if boundary)
 6035:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6036:    //    k: Index of the half-level at which the density is interpolated
 6037:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6038:    // 
 6039:    // Output:
 6040:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6041:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6042: 
 6043:       if (e2 == nullptr || e2->isDry) {
 6044:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6045: 
 6046:          Side *side = e1->sides[j];
 6047:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6048:                  
 6049:          if constexpr(ics == 1) {
 6050:             vec = side->n; // Normal vector to the side
 6051:          } else {
 6052:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6053:             // IMPLEMENT THIS XXXXXX
 6054:             // !replace with xel, yel?
 6055:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6056:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6057:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6058:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6059:          } //ics
 6060:                    
 6061:          diffRho = 0.0;
 6062: 
 6063:       } else { //internal and wet
 6064:          if constexpr(ics==1) {
 6065:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6066: 
 6067:             // Vector from e1 to e2
 6068:             vec = e2->center - e1->center;
 6069: 
 6070:          } else { 
 6071:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6072:             // Remember that elem->center is in global coordinates
 6073:             // IMPLEMENT THIS XXXXXX
 6074:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6075:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6076:             //                   alow(j)=xctr2
 6077:             //                   bdia(j)=yctr2
 6078:          } // ics
 6079: 
 6080:          diffRho = rho2 - e1->demeanedDensity(k);
 6081:       }
 6082: 
 6083:    }
 6084: 
 6085:    __global__ void computeDensityCubicSplines(void) {
 6086:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6087: 
 6088:       ELEM(elem);
 6089: 
 6090:       if (elem->isDry) return;
 6091: 
 6092:       const int kb = elem->kb;
 6093: 
 6094:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6095:       if (elem->is2D()) {
 6096:          // In the 2D case, the density is constant at the prism level. 
 6097:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6098:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6099:       } else { //3D
 6100: 
 6101:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6102:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6103:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6104:          ///// XXXX CHECK INDICES!!!!!
 6105:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6106:       } // 2D/3D
 6107: 
 6108:    }
 6109: } // extern "C"
 6110: 
 6111: 
 6112: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6113: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6114: 
 6115:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6116: 
 6117:    const int kb  = elem->kb;
 6118:    const int kb2 = elem2->kb;
 6119: 
 6120:    // z-coordinate of prism of elem
 6121:    const double zp = elem->z_prism(k);
 6122: 
 6123:    double rho = 0.0;
 6124: 
 6125:    if (elem2->is2D()) {
 6126:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6127: 
 6128:    } else {  // 3D
 6129: 
 6130:       // eta_min may be < zmax
 6131:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6132:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6133: 
 6134:       // (Extrapolate density below bottom, we will fix it later)
 6135:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6136:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6137:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6138:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6139:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6140:    } // 2D/3D
 6141:      
 6142: 
 6143:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6144:    // Now we need to fix it.
 6145:    if (elem->z[k] < elem2->z[kb2]) {
 6146:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6147: 
 6148:       // There are two methods to adjust the density at the bottom of the element.
 6149:       // iunder_deep=0: 
 6150:       const double depth1 = abs(elem->z[kb]); // larger depth
 6151: 
 6152:       if (iunder_deep==0) {
 6153: 
 6154:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6155: 
 6156:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6157: 
 6158:       } else { // iunder_deep != 0
 6159: 
 6160:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6161: 
 6162:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6163: 
 6164:          //   Demeaned density at the same z coordinate as
 6165:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6166:          }
 6167: 
 6168:       } // if iunder_deep
 6169:    } // if elem->z[kb] < elem2->z[kb]
 6170: 
 6171:    return rho;
 6172: }
 6173: 
 6174: 
 6175: extern "C" {
 6176:    __global__ void computeDensityGradient(void) {
 6177: 
 6178:       if constexpr(ibc != 0) return;
 6179: 
 6180:          // Compute the horizontal density gradient at each element.
 6181:       // It works in two steps:
 6182:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6183:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6184:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6185:       //             gradRho.r1 = rho1 - rho0
 6186:       //             gradRho.r2 = rho2 - rho0
 6187:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6188:       // 
 6189:       //  NOTE: We use de-meaned densities.
 6190: 
 6191:       ELEM(elem);
 6192: 
 6193:       if (elem->isDry) return;
 6194: 
 6195:       const int kb  = elem->kb;
 6196:       const int i34 = elem->i34;
 6197: 
 6198:       for (int k = kb + 1; k < nvrt; k++) {
 6199:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6200:          //             gradRho.r1 = rho1 - rho0
 6201:          //             gradRho.r2 = rho2 - rho0
 6202:          int icount = 0;
 6203:          double sumRx = 0.0;
 6204:          double sumRy = 0.0;
 6205:          for (int j1=0; j1<i34; j1++) { 
 6206: 
 6207:             const int j2 = elem->nxq(j1 + 1);
 6208: 
 6209:             // Pairs of consecutive neighbor elements of elem
 6210:             const Element *e1 = elem->nghbElems[j1];
 6211:             const Element *e2 = elem->nghbElems[j2];
 6212: 
 6213:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6214:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6215:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6216: 
 6217:             // Compute the density difference and the vector from elem to e1 and e2
 6218:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6219:             double diffRho1, diffRho2;
 6220:             Vector2 vec1, vec2;
 6221:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6222:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6223: 
 6224:             const double rl1 = length(vec1);
 6225:             const double rl2 = length(vec2);
 6226:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6227: 
 6228:             const double delta = cross(vec1, vec2);
 6229:             const double sintheta = abs(delta)/(rl1*rl2);
 6230: 
 6231:             // To avoid problems, avoid elements with small angle between vectors
 6232:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6233:             const bool validEq = (sintheta > sin_one_deg);
 6234: 
 6235:             if (validEq) {
 6236:                // Solve the system of equations to get the density gradient at elem
 6237:                icount++;
 6238:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6239:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6240:                sumRx += Rx;
 6241:                sumRy += Ry;
 6242:             }
 6243:          } // for j1
 6244: 
 6245:          // Compute the average density gradient at elem
 6246:          if (icount==0) {
 6247:            // Bad mesh quality; bail out with 0 b-cc
 6248:            elem->gradRho[k] = {0.0, 0.0};
 6249:          } else {
 6250:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6251:          }
 6252: 
 6253:       } // for k
 6254: 
 6255:    }
 6256: 
 6257:    __global__ void computeBaroclinicTerm(void) {
 6258:    // Computes the baroclinic term at sides (at half levels).
 6259:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6260:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6261: 
 6262:       if (ibc == 1) return;
 6263: 
 6264:       SIDE(side);
 6265: 
 6266:       if (side->isDry) return;
 6267: 
 6268:       const Element *e1 = side->elems[0];
 6269:       const Element *e2 = side->elems[1]; 
 6270:       const int kb = side->kb;
 6271:       
 6272:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6273: 
 6274:       // interpolates vertically the density gradient of the two elements at the half level/
 6275: 
 6276:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6277:       int k2 = max(kb, nvrt / 2);
 6278: 
 6279:       // Starts the integration at the surface and goes down to the bottom
 6280:       side->bcc[nvrt-1] = {0.0, 0.0};
 6281:       for (int k = nvrt - 2; k >= kb; k--) {
 6282:       // For each prism level (from surface to bottom)...
 6283: 
 6284:          // For both elements, interpolate density gradient at the side's half level.
 6285:          // The gradient at the side is the average of the gradients at the elements.
 6286:          // w1, w2 are used to take into account boundary sides, with just one element.
 6287:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6288:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6289:          const double wsum = w1 + w2;
 6290:          w1 = w1/wsum;
 6291:          w2 = w2/wsum;
 6292:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6293: 
 6294:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6295:          Vector2 gradRho = {0.0, 0.0};
 6296:          if (e1 != nullptr && k > kb) {
 6297:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6298:             
 6299:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6300:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6301:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6302: 
 6303:             // Grad(rho) vertically interpolated at the side's half level
 6304:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6305: 
 6306:             // Projects the element density gradient to the side frame if needed.
 6307:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6308: 
 6309:             // Adds the contribution of the density gradient at the side's half level
 6310:             gradRho += gradRho1*w1;
 6311:          }      
 6312:          if (e2 != nullptr && k > kb) {
 6313:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6314:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6315:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6316:             
 6317:             // Grad(rho) vertically interpolated at the side's half level
 6318:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6319: 
 6320:             // Projects the element density gradient to the side frame if needed.
 6321:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6322: 
 6323:             // Adds the contribution of the density gradient at the side's half level
 6324:             gradRho += gradRho2*w2;
 6325:          }
 6326: 
 6327:          
 6328:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6329:          // multiplied by -rampbc*(g/rho0) 
 6330:          const double grav3 = side->grav3();
 6331:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6332: 
 6333:       } // for
 6334: 
 6335:    }
 6336: 
 6337: 
 6338: 
 6339:    __global__ void computeHorGradientAtSide(void) {
 6340: 
 6341:       // Compute the horizontal density gradient at each element.
 6342:       // It works in two steps:
 6343:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6344:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6345:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6346:       //             gradRho.r1 = rho1 - rho0
 6347:       //             gradRho.r2 = rho2 - rho0
 6348:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6349:       // 
 6350:       //  NOTE: We use de-meaned densities.
 6351: 
 6352:       SIDE(side);
 6353: 
 6354: 
 6355:       if (side->isDry) return;
 6356: 
 6357:       // Computes the gradient of the variables at the side center.
 6358:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6359:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6360:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6361: 
 6362:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6363:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6364:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6365:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6366: 
 6367:    }
 6368: 
 6369: 
 6370:    __global__ void solveMomentumEquations(double time) {
 6371: 
 6372:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6373:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6374: 
 6375:       SIDE(side);
 6376: 
 6377:       if (side->isDry) 
 6378:       {
 6379:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6380: 
 6381:          return;
 6382:       }
 6383: 
 6384:       const Node *n1 = side->n1;
 6385:       const Node *n2 = side->n2;
 6386: 
 6387:       const int kb = side->kb;
 6388: 
 6389:       const double veg_h = side->veg_h();
 6390:       const double grav3 = side->grav3();
 6391: 
 6392:       if (side->is2D()) {
 6393:          // Remember: Do not use htot2, which is updated.
 6394:          const double htot = side->htot1();
 6395:          const double hhat = side->hhat;
 6396: 
 6397:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6398: 
 6399:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6400:          const Vector2 tau2 = side->tau();
 6401: 
 6402:          // hat_gam has units of m/s
 6403: 
 6404:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6405:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6406:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6407: 
 6408:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6409: 
 6410: 
 6411:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6412: 
 6413:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6414: 
 6415:       }
 6416:       else { // 3D
 6417: 
 6418:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6419:          // 
 6420:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6421:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6422:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6423:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6424:          // k+1 and k.
 6425: 
 6426: 
 6427:          const int ndim = nvrt - kb;
 6428:          const double zTopCanopy = side->zTopCanopy();
 6429: 
 6430:          // Initialize the tridiagonal system
 6431:          for (int k = kb + 1; k < nvrt; k++) {
 6432:             
 6433:             const int kin = k - (kb + 1);
 6434: 
 6435:             // Vertical viscosity at the face center
 6436:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6437: 
 6438:  
 6439:             alow[kin] = 0.0;
 6440:             cupp[kin] = 0.0;
 6441:             bdia[kin] = 0.0;
 6442: 
 6443:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6444:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6445: 
 6446:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6447:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6448:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6449: 
 6450:             // First part: layers k, k+1
 6451:             if (k < nvrt - 1) {
 6452:                              
 6453:                if constexpr(iveg != 0) {
 6454: 
 6455:                   // If there is vegetation at this level...
 6456:                   if (zTopCanopy > side->zc[k]) {
 6457:                      // If the canopy is above the k layer...
 6458:                      
 6459:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6460:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6461:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6462:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6463: 
 6464:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6465:                      const double vmag2 = length(ut2);
 6466:                      const double vmag1 = length(side->u2[k]);
 6467:                      const double vmag = 0.5*(vmag1 + vmag2);
 6468:                      
 6469:                      // Computes the vegetation alpha at the face center
 6470:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6471: 
 6472:                      cff1 += veg_alpha_sd*dt*vmag;
 6473: 
 6474:                   } // if (zTopCanopy
 6475:                } // if iveg
 6476: 
 6477:                const double dzz = side->Dz(k + 1);
 6478:                const double tmp = dt*dfz/dzz;
 6479:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6480: 
 6481:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6482:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6483:             }
 6484: 
 6485: 
 6486:             // Second part: layers k-1, k
 6487:             if (k > kb + 1) {
 6488: 
 6489:                double cff1 = 1.0; //init \bar{c^k}
 6490: 
 6491:                if constexpr(iveg != 0) {
 6492:                   // If there is vegetation at this level...
 6493:                   if (zTopCanopy > side->zc[k-1]) {
 6494:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6495:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6496: 
 6497:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6498: 
 6499:                      const double vmag2 = length(ut2);
 6500:                      const double vmag1 = length(side->u2[k-1]);
 6501:                      const double vmag = 0.5*(vmag1 + vmag2);
 6502: 
 6503:                      // Computes the vegetation alpha at the face center
 6504:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6505:                      cff1 += veg_alpha_sd*dt*vmag;
 6506:                   } // if zTopCanopy
 6507: 
 6508:                } // if iveg
 6509: 
 6510:                const double dzz = side->Dz(k);
 6511:                const double tmp = dt*dfz/dzz;
 6512:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6513: 
 6514:                alow[kin] += cff1*dzz/6.0 - tmp;
 6515:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6516: 
 6517:             } else { // Bottom boundary
 6518:                // This occurs at the bottom, where the bottom drag is applied.
 6519: 
 6520:                bdia[kin] += dt*side->chi2; // XXXX
 6521: 
 6522:             } // if (k > kb + 1)
 6523: 
 6524: 
 6525:          } // for (int k
 6526: 
 6527: 
 6528: 
 6529:          // Computes the RHS.
 6530:          // -----------------
 6531: 
 6532:          //	BC to be imposed at the end.
 6533: 
 6534:          const Vector2 gradETP  = side->gradETP;
 6535:          const Vector2 gradPr   = side->gradPr;
 6536:          const Vector2 gradEta1 = side->gradEta1;
 6537:          const Vector2 gradEta2 = side->gradEta2;
 6538: 
 6539:          const Vector2 *btu = side->btu;
 6540:          const Vector2 *u2  = side->u2;
 6541:          const double coriolis = side->coriolis;
 6542:          const Vector2 *nuGradU = side->nuGradU;
 6543: 
 6544:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6545:          for (int k = kb + 1; k < nvrt; k++) {
 6546:             const int kin = k - kb - 1;
 6547: 
 6548:             const double dz_0 = side->Dz(k);
 6549:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6550: 
 6551:             rrhs[kin] = {0.0, 0.0};
 6552:             double dz = 0.0;
 6553: 
 6554:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6555:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6556:             if (k < nvrt  ) dz += dz_1;
 6557:             if (k > kb + 1) dz += dz_0;
 6558: 
 6559:             // Elevation gradient, atmospheric pressure and tidal potential
 6560:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6561: 
 6562:             // Coriolis, advection, wind stress, and horizontal viscosity
 6563:             if (k < nvrt - 1) {
 6564: 
 6565: 
 6566:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6567:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6568:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6569:                                                 
 6570: 
 6571:                //diff stress tensors 1006
 6572:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6573:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6574:                   assert(false && "Not implemented: itur == 5");
 6575:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6576:                }
 6577:                // else assert(false && "itur # Not implemented");
 6578: 
 6579:             } else { // k == nvrt - 1 SURFACE
 6580:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6581:                const Vector2 tau2 = side->tau();
 6582: 
 6583:                rrhs[kin] += dt*tau2;          
 6584: 
 6585:             } // if k<nvrt
 6586: 
 6587: 
 6588:             if (k > kb + 1) {
 6589:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6590:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6591:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6592: 
 6593:                // diff stress tensors 1006
 6594:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6595:                   assert(false && "Not implemented: itur == 5");
 6596:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6597:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6598:                }
 6599:                // else assert(false && "itur # Not implemented");
 6600: 
 6601: 
 6602:             } // if k>kbs + 1
 6603: 
 6604:             // Baroclinic
 6605:             Vector2 *bcc = side->bcc;
 6606:             if constexpr(ibc == 0) {
 6607:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6608:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6609: 
 6610:             } // if ibc==0
 6611: 
 6612:          } // k=kb + 1,nvrt
 6613: 
 6614: 
 6615:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6616: 
 6617:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6618:             const int kin = k - kb - 1;
 6619:    
 6620:             // Velocity is always clamped to maximum values
 6621:             side->u2[k] = clampVelocity(soln[kin]);
 6622:          } // k
 6623: 
 6624:       } // if side->is2D()
 6625:       
 6626: 
 6627:       // Impose velocity boundary condition at the bottom
 6628:       if constexpr(imm == 2) { // 3D bed deformation model
 6629:          double dep;
 6630:          Vector2 vel;
 6631: 
 6632:          assert(false && "Not implemented: imm == 2");
 6633:          //update_bdef(time, x0, y0, dep, vel);
 6634:          // side->u2[kb] = vel;
 6635: 
 6636:       } else { // imm = 0 or 1
 6637:          if (side->Cd() == 0.0) {
 6638:             side->u2[kb] = side->u2[kb + 1];
 6639: 
 6640:          } else if (side->is3D()) { // 3D no slip bottom   
 6641:             side->u2[kb] = {0.0, 0.0};
 6642: 
 6643:          }
 6644:           
 6645:       } // if imm
 6646: 
 6647:       // The velocities below the bottom level are set to zero
 6648:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6649: 
 6650: 
 6651:    }
 6652: 
 6653: 
 6654:    __global__ void applyMomentumBC(void) {
 6655: 
 6656:       SIDE_BND(sideBnd);
 6657: 
 6658:       Side *side = sideBnd->side;
 6659:       const BoundarySegment *segment = sideBnd->segment;
 6660:       const Node *n1 = side->n1;
 6661:       const Node *n2 = side->n2;
 6662: 
 6663:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6664: 
 6665:       const bool isLand = segment->isLand;
 6666:       const int ifltype = segment->ifltype;
 6667: 
 6668:       const int kb = side->kb;
 6669: 
 6670: 
 6671:       if (!isLand && ifltype != 0) {
 6672:          const Vector2 *ubc = sideBnd->ubc;
 6673:   
 6674:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6675:             
 6676:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6677:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6678: 
 6679:             if (ifltype == -1) {
 6680:                // Flather 1
 6681: 
 6682:                const double depth = side->depth();
 6683: 
 6684:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6685: 
 6686:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6687: 
 6688:                side->u2[k] = vnorm*side->n;
 6689: 
 6690:             } else if (ifltype == -2) { // Discharge
 6691: 
 6692:                const double eta1 = side->eta1();
 6693:                const double eta2 = side->eta2();
 6694:                const double htot = side->htot2();
 6695: 
 6696:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6697:                assert(false && "Not implemented: Discharge bc");
 6698:                // const double dischrg = discharge(eta1);
 6699:                const double dischrg = 0.0; // XXX REMOVE
 6700:                
 6701: 
 6702:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6703: 
 6704:                const double vnorm = dischrg*eta2/htot;
 6705: 
 6706:                side->u2[k] = vnorm*side->n;
 6707: 
 6708:             }
 6709:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6710:                const double vnorm = dot(side->u2[k], side->n);
 6711: 
 6712:                double rat;
 6713:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6714:                else              rat = segment->vobc2; // outgoing
 6715: 
 6716:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6717: 
 6718:             }
 6719:             else { // not Flather or 3D radiation
 6720:                side->u2[k] = ubc[k];
 6721: 
 6722:             } // if (segment->ifltype...
 6723: 
 6724:          }
 6725: 
 6726:       }
 6727:       else if (isLand) { // if it is land boundary side
 6728: 
 6729:          if constexpr(islip == 0) { // free slip
 6730: 
 6731:             for (int k = kb; k < nvrt; k++) {
 6732: 
 6733:                const Vector2 t = side->t();
 6734:                const Vector2 n = side->n;
 6735: 
 6736:                double vnorm = 0.0; // for most cases
 6737:                const double vtan = dot(side->u2[k], t);
 6738:                
 6739:                side->u2[k] = vtan*t - vnorm*n;
 6740: 
 6741:             }
 6742: 
 6743:          } else { // no slip
 6744:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6745: 
 6746:          }
 6747:       } // if (side segment type...
 6748: 
 6749:    
 6750: // EEEEEEE
 6751: for (int k = kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6752:    }
 6753: 
 6754: 
 6755:    __global__ void shapiroFilter1(void) {
 6756:       // First step of the Shapiro filter (normally used if indvel<=0)
 6757:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6758: 
 6759:       SIDE(side);
 6760: 
 6761:       // Only internal wet sides are processed
 6762:       if (side->isDry || !(side->isInternal())) return;
 6763: 
 6764:       const int kb = side->kb;
 6765: 
 6766:       for (int mm = 0; mm < niter_shap; mm++) {
 6767: 
 6768:          for (int k = kb + 1; k < nvrt; k++) {
 6769:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6770:             Vector2 suru = {0.0, 0.0};
 6771: 
 6772:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6773: 
 6774:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6775: 
 6776:                int kin = k;
 6777:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6778:                
 6779:                // Get the velocity at the neighbor's side.
 6780:                Vector2 nSideU2 = nSide->u2[kin];
 6781: 
 6782:                // Projects the velocity to the current side frame if needed.
 6783:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6784: 
 6785:                suru += nSideU2;
 6786:             }
 6787: 
 6788:             // Reusing bcc as a temporary array to store the suru values.
 6789:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6790: 
 6791:          }
 6792:       }
 6793:    }
 6794: 
 6795:    __global__ void shapiroFilter2(void) {
 6796:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6797: 
 6798:       SIDE(side);
 6799: 
 6800: 
 6801:       if (side->isDry || !(side->isInternal())) return;
 6802: 
 6803:       const int kb = side->kb;
 6804: 
 6805:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6806: 
 6807:       if (side->is2D()) {
 6808:          side->u2[kb + 1] = side->bcc[kb + 1];
 6809:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6810: 
 6811:       } else {
 6812:          // 3D
 6813:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6814:          
 6815:       }
 6816: 
 6817:    }
 6818: 
 6819: 
 6820:    __global__ void ul0UpdateZCoords(void) {
 6821:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6822:       
 6823:       NODE(node);      
 6824: 
 6825: 
 6826:       if (false) { //node->isDry) { XXXXXXX
 6827: 
 6828:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6829: 
 6830:          if constexpr(ivcor != 1) node->kb = 0;
 6831: 
 6832:       } else {
 6833: 
 6834:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6835:          node->updateKb();
 6836: 
 6837:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6838: 
 6839:       }
 6840: 
 6841:       // We use the temp.b field to store the previous state of isDry.
 6842:       node->tmp.b = node->isDry;
 6843: 
 6844:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6845:       node->isDry = true;
 6846: 
 6847:    }
 6848: 
 6849:    __global__ void ul0ComputeDryElements(void)
 6850:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6851:    {
 6852:       ELEM(elem);
 6853: 
 6854:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6855: 
 6856:       elem->kb = 0;
 6857: 
 6858:       if (elem->isDry) return;
 6859: 
 6860: 
 6861:    //    if(elem->isDry2()) { // XXXX
 6862:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6863:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6864:    //        call parallel_abort(errmsg)
 6865:    //    }
 6866: 
 6867:       const Node *n1 = elem->nodes[0];
 6868:       const Node *n2 = elem->nodes[1];
 6869:       const Node *n3 = elem->nodes[2];  
 6870:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6871: 
 6872:       // Computes element's kb as the minimum of the nodes' kb.
 6873:       const int kb1 = n1->kb;
 6874:       const int kb2 = n2->kb;
 6875:       const int kb3 = n3->kb;
 6876:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6877: 
 6878: 
 6879:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6880: 
 6881: 
 6882:       // Computes the element z as the mean of the nodes z.
 6883:       for (int k = elem->kb; k < nvrt; k++) {
 6884: 
 6885:          // Compute the element z as the mean of the nodes z.
 6886:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6887:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6888:          elem->z[k] /= elem->i34;
 6889: 
 6890:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6891:       }
 6892:                   
 6893:    }
 6894: 
 6895:    __global__ void ul0ComputeDryNodes(void)
 6896:    // Updates node's isDry based on the elements' isDry. 
 6897:    {
 6898:       NODE(node);
 6899: 
 6900:       node->isDry = true;
 6901: 
 6902:       // A node is wet if at least one of the elements sharing it is wet.
 6903:       for (int j = 0; j < node->numElements; j++) {
 6904:          const Element *elem = node->elements[j];
 6905:          if (!elem->isDry) {
 6906:             node->isDry = false;
 6907:             break;
 6908:          }
 6909:       }
 6910: 
 6911:        
 6912:    }
 6913: 
 6914: 
 6915:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6916:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6917:    // node->tmp.b is true if the node was previously dry.
 6918:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6919:    {
 6920:       NODE(node);
 6921:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6922: 
 6923:       // Avoid this the first time step.
 6924:       if (it == iths) return;  
 6925: 
 6926:       const bool wasDry = node->tmp.b;
 6927: 
 6928: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6929: 
 6930:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6931: 
 6932:          for (int k=0; k < nvrt; k++) {
 6933: 
 6934:             Vector3 utmp={0.0, 0.0, 0.0};
 6935: 
 6936:             double ttmp=0.0;
 6937:             double stmp=0.0;
 6938:             int icount=0;
 6939:             for (int j = 0; j < node->numNodes; j++) {
 6940: 
 6941:                const Node *nbrNode = node->nodes[j];
 6942:                
 6943:                const bool wasNbrDry = nbrNode->tmp.b;
 6944: 
 6945:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6946:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6947: 
 6948:                   icount++;
 6949: 
 6950:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6951:                   utmp += nbrNode->uvw2(k);
 6952:                   
 6953:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6954:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6955:                }
 6956:             }
 6957: 
 6958:             if (icount > 0) {
 6959:                const double inv_icount = 1.0/icount;
 6960:                utmp = inv_icount*utmp;
 6961:                node->u2[k]     = {utmp.x, utmp.y};
 6962:                node->w2[k]     = utmp.z;
 6963:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6964:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6965:             } else {
 6966:                node->u2[k] = {0.0, 0.0};
 6967:                node->w2[k] = 0.0;
 6968:                // Initialize tracers to 0.0??? XXXXX
 6969:             }
 6970:          }
 6971:       }
 6972:    }
 6973: 
 6974:   
 6975:    
 6976: 
 6977: 
 6978:    __global__ void ul0UpdateSides(int it, int iths) {
 6979:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6980:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6981:    // The dryness of the sides is updated in ul0UpdateSides2.
 6982: 
 6983:       SIDE(side);
 6984: 
 6985:       // A side is wet if and only if at least one of its elements is wet.
 6986:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6987:  
 6988:       const Node *n1 = side->n1;
 6989:       const Node *n2 = side->n2;
 6990:      
 6991:       const int kb1 = n1->kb;
 6992:       const int kb2 = n2->kb;
 6993: 
 6994:       side->kb = 0; // default when dry
 6995: 
 6996:       if (isWet) {
 6997: 
 6998:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6999: 
 7000:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7001: 
 7002:          side->kb = min(kb1, kb2);
 7003: 
 7004:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7005: 
 7006:          for (int k = side->kb; k < nvrt; k++) {
 7007:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7008: 
 7009:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7010: 
 7011:             // Compute velocity for re-wetted sides 
 7012:             if ((it != iths) && (side->isDry && isWet)) {
 7013: 
 7014:                Vector2 utmp={0.0, 0.0};
 7015: 
 7016:                int icount=0;
 7017: 
 7018:                // For all the sides on the two elements that share this side
 7019:                for (int j = 0; j < 2; j++) {
 7020:                   const Element *elem = side->elems[j];
 7021:                   if (elem == nullptr) continue;
 7022: 
 7023:                   for (int jj=0; jj < elem->i34; jj++) {
 7024:                      const Side *nSide = elem->sides[jj];
 7025:                      if (nSide->isDry) continue;
 7026: 
 7027:                      icount++;
 7028:                      utmp += nSide->u2[k];  
 7029:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7030:                   }
 7031:                }
 7032:                   
 7033:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7034:                if (icount > 0)  side->u2[k] = utmp/icount;
 7035:                else             side->u2[k] = {0.0, 0.0};
 7036:                   
 7037:             } // if ((it != iths) && (side->isDry && isWet))
 7038: 
 7039:          } // for k
 7040: 
 7041:       } // if isWet 
 7042:       
 7043: 
 7044: 
 7045:    }
 7046: 
 7047:    __global__ void ul0UpdateSides2(void) {
 7048:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7049:    
 7050:          SIDE(side);
 7051:    
 7052:          const Element *e1 = side->elems[0];
 7053:          const Element *e2 = side->elems[1];
 7054: 
 7055:          // A side is wet if and only if at least one of its elements is wet.
 7056:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7057: 
 7058:          // Update the side's dryness
 7059:          side->isDry = !isWet;
 7060: 
 7061:    }
 7062: 
 7063: 
 7064:    __global__ void zeroNodalVelocities(void) {
 7065:       NODE(node);
 7066: 
 7067:       for (int k = 0; k < nvrt; k++) {
 7068:          node->u2[k]   = {0.0, 0.0};
 7069:          node->w2[k]   = 0.0;
 7070:          node->utmp[k] = {0.0, 0.0};         
 7071:       }
 7072:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7073:    }
 7074:  
 7075: 
 7076:    __global__ void computeNodalVerticalVelocities1(void) {
 7077:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7078:    // Adds the element's vertical velocity times the element's area.
 7079:       ELEM(elem);
 7080: 
 7081:       for (int j = 0; j < elem->i34; j++) {
 7082:          Node *node = elem->nodes[j];
 7083: 
 7084:          for (int k = node->kb; k < nvrt; k++) {
 7085:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7086:          }
 7087:          atomicAdd(&(node->tmp.d), elem->area);
 7088:       }
 7089:    }
 7090: 
 7091:    __global__ void computeNodalVerticalVelocities2(void) {
 7092:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7093:    // Divides by the total area of the elements sharing the    node.
 7094:       NODE(node);
 7095: 
 7096:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 7097: 
 7098:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7099:    }
 7100: 
 7101: 
 7102:    __global__ void computeNodalHorizontalVelocities1(void) {
 7103: 
 7104:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7105: 
 7106:       ELEM(elem);
 7107: 
 7108:       if (elem->isDry) return;
 7109: 
 7110:       const int kb = elem->kb;
 7111:       const bool isTri = elem->isTri();
 7112: 
 7113:       if constexpr(indvel <= 0) {
 7114:          // Assuming discontinous hvel.
 7115: 
 7116:          if (isTri) { // For triangles
 7117:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7118:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7119: 
 7120:             for (int j = 0; j < 3; j++) {
 7121:                // For every node of the triangle...
 7122:                Node *node = elem->nodes[j];
 7123: 
 7124:                if (node->isDry) continue;
 7125: 
 7126:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7127:                const Side *s2 = elem->sides[(j + 1) % 3];
 7128:                const Side *s3 = elem->sides[(j + 2) % 3];
 7129: 
 7130:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7131: 
 7132:                atomicAdd(&(node->tmp.i), 1);
 7133: 
 7134:                for (int k = kb; k < nvrt; k++)  {
 7135:                   Vector2 s1u2 = s1->u2[k];
 7136:                   Vector2 s2u2 = s2->u2[k];
 7137:                   Vector2 s3u2 = s3->u2[k];
 7138: 
 7139:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7140:                   if constexpr(ics == 2) {
 7141:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7142:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7143:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7144:                   }
 7145: 
 7146:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7147:                   u = clampVelocity(u);
 7148:                   atomicAdd(&(node->utmp[k].x), u.x);
 7149:                   atomicAdd(&(node->utmp[k].y), u.y);
 7150: 
 7151:                }
 7152: 
 7153:             }
 7154:          }
 7155:          else { // For quads
 7156:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7157: 
 7158:          }
 7159: 
 7160:       }
 7161:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7162:       
 7163:    }
 7164: 
 7165: 
 7166:    __global__ void computeNodalHorizontalVelocities2(void) {
 7167:       NODE(node);
 7168: 
 7169:       const int nodeCount = node->tmp.i;
 7170: 
 7171:       if (nodeCount == 0) 
 7172:       {
 7173:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7174:          return;
 7175:       }
 7176: 
 7177:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7178:       
 7179:       const int kb = node->kb;
 7180: 
 7181:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7182:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7183:       
 7184:       
 7185:    }   
 7186: 
 7187:  
 7188: 
 7189:    __global__ void resetVelocityOpenBndNodes(void) {
 7190:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7191: 
 7192:       NODE_BND(nodebnd);
 7193: 
 7194:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7195:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7196:       }
 7197: 
 7198:    }
 7199: 
 7200: 
 7201:    __global__ void setVelocityOpenBndNodes(void) {
 7202:    // For open boundary nodes sets their velocity to the imposed values.
 7203: 
 7204:       SIDE_BND(sidebnd);
 7205: 
 7206:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7207:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7208:          // to its segment to the average of the side velocity.
 7209: 
 7210:          for (int k = 0; k < nvrt; k++) {
 7211:             Node *n1 = sidebnd->side->n1;
 7212:             Node *n2 = sidebnd->side->n2;
 7213: 
 7214: 
 7215:             Vector2 n1_u2(n1->u2[k]);
 7216:             Vector2 n2_u2(n2->u2[k]);
 7217: 
 7218:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7219:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7220:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7221:             }
 7222:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7223:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7224:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7225:             }
 7226: 
 7227:          }
 7228: 
 7229:       }
 7230: 
 7231:    }
 7232: 
 7233: 
 7234:    __global__ void computeVerticalVelocity(void) {
 7235:       // Computes the vertical velocity at the (2D) element's centroid.
 7236:       // In this function we will be considering volumetric elements, with side faces and a 
 7237:       // bottom and a top face. We will call them SFs, BF and TF.
 7238:       // It computes the flux coming from BF and the SFs.
 7239:       // If the bed is moving, it takes that into account.
 7240:       // Since water is incompressible, the integral of the velocity times the normal vector
 7241:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7242:       // and the BF is equal to the flux going out from the TF.
 7243:       // TF = - BF - sum(SFs).
 7244:       // It then computes the horizontal velocity at the center of TF.
 7245:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7246:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7247:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7248: 
 7249:       ELEM(elem);
 7250: 
 7251:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7252: 
 7253:       if (elem->isDry) return;
 7254: 
 7255:       const int kb = elem->kb;
 7256:       const bool isTri = elem->isTri();
 7257: 
 7258:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7259: 
 7260:       // Compute the bottom velocity
 7261:       if constexpr(imm != 0) {
 7262:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7263:       }
 7264: 
 7265: 
 7266:       double bottomArea3D;
 7267:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7268: 
 7269:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7270: 
 7271:       double topArea3D;
 7272: 
 7273:       // Bottom face flux
 7274:       double bottomFlux = 0.0;
 7275:       Vector2 u2meanBottom = {0.0, 0.0};
 7276:       const Vector2 gradh = elem->grad2(&Node::depth);
 7277:       if constexpr(imm==2) {
 7278:          Vector3 ubed;
 7279: 
 7280:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7281:          // updateBDEF(ubed);
 7282:      
 7283:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7284: 
 7285:          // elem->w[kb] += ubed.z;
 7286:       }
 7287:       else {
 7288: 
 7289: 
 7290:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7291:   
 7292:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7293:          // in the direction of motion.
 7294:          const double bottomW = - dot(gradh, u2meanBottom);  
 7295:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7296: 
 7297:          // VElocity associated to the bed deformation
 7298:          double bedVelocity = 0.0;
 7299:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7300: 
 7301:          elem->w[kb] = bedVelocity + bottomW; 
 7302: 
 7303:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7304:          
 7305:       } // if imm
 7306: 
 7307:       // Compute w for kb+1 to nvrt-1
 7308:       for (int l = kb; l < nvrt - 1; l++) {
 7309: 
 7310:          // normal vector to the top face of the "volumetric" element (3D)
 7311:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7312: 
 7313:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7314:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7315: 
 7316:          // Compute the total flux at the sides
 7317:          double sideFlux = 0.0;
 7318: 
 7319:          for (int j = 0; j < elem->i34; j++) {
 7320:             const Side *side = elem->sides[j];
 7321:             const int kbs = side->kb;
 7322:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7323:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7324:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7325: 
 7326:             // The area is "clamped" meaning that it takes kb into account.
 7327:             const double sideArea = side->areaClamped(l);
 7328: 
 7329:             const double sign = elem->ssign[j]; 
 7330: 
 7331:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7332:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7333:          }
 7334:          
 7335:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7336:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7337:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7338: 
 7339:          // The flux at the top ace can be computed from the other flows.
 7340:          // All fluxes are in directions into the prism.
 7341:          const double topFlux = - sideFlux - bottomFlux;
 7342: 
 7343:          // Flux at the top face due to the horizontal velocities only
 7344:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7345: 
 7346:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7347:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7348: 
 7349:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7350: 
 7351:          bottomFlux = -topFlux;
 7352:       }
 7353: // EEEEEEEEEEEEEEEE
 7354: for (int l = kb; l < nvrt; l++)  elem->w[l] = 0.0;
 7355:    }  
 7356: 
 7357: 
 7358: 
 7359: 
 7360: 
 7361: 
 7362: 
 7363: // !===============================================================================
 7364: // !===============================================================================
 7365: 
 7366: } // extern "C"
 7367: 
 7368: #ifdef DONTCOMPILE
 7369: __device__ void computeVerticalAdvection(void) {
 7370:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7371: 
 7372:    sdbt(1:2,:,:)=0.d0
 7373: 
 7374:    const Side *side = FROM kernel;
 7375: 
 7376:    if(side->isDry) return;
 7377: 
 7378:    // If side is wet...
 7379: 
 7380: 
 7381:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7382:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7383:    double ws[nvrt] = {} // w @ side
 7384:    int icount = 0;
 7385:    for (int j=0; j<2; j++) {
 7386:       const Element *elem = side->elements[j];
 7387:        
 7388:       if(elem != nullptr) {
 7389:          icount++;
 7390:          for (int k=0; k<nvrt; k++) {
 7391:             ws[k] = ws[k] + elem->w[k];
 7392:          }
 7393:       }
 7394:    }  // for j
 7395: 
 7396:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7397:    ws = ws/icount;
 7398: 
 7399:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7400:    // Splines allow for a smooth transition between vertical levels.
 7401:    // Splines have continuity restrictions at the internal knots, but
 7402:    // we have to provide the 1st derivatives at the endpoints.
 7403:    const int kbs = side->kbs; 
 7404:    
 7405:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7406:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7407:    initCubicSpline(kbs, nvrt, side, ws, up)
 7408: 
 7409:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7410:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7411:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7412: 
 7413:    // Total advection (average onto side)
 7414:    const Node *node1 = side->nodes[0];
 7415:    const Node *node2 = side->nodes[1];
 7416:    for (int k=kbs(i); k<nvrt; k++) {
 7417: 
 7418:       Vector2 bcc1 = node1->bcc[k];
 7419:       Vector2 bcc2 = node2->bcc[k];
 7420:       if constexpr(ics == 2) {
 7421:          // Project the velocities from the node frames to the side frame
 7422:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7423:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7424:       }
 7425: 
 7426:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7427:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7428: 
 7429:    }
 7430: }
 7431: #endif
 7432: 
 7433: 
 7434: extern "C" {
 7435:    __global__ void computeElemAverageGhat(void) {
 7436:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7437: 
 7438:       ELEM(elem);
 7439:       
 7440:       elem->ghat1= {0.0, 0.0};  
 7441: 
 7442:       if constexpr(ihydraulics != 0) {
 7443:          if (nhtblocks > 0 && elem->isblock) return;
 7444:       }
 7445: 
 7446:       
 7447:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7448:       // cff1-3: coefficients for 2D/3D
 7449: 
 7450:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7451:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7452:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7453: 
 7454:       if (elem->isDry) return;
 7455: 
 7456:       // Average of the coefficients
 7457:       double av_cff1 = 0.0;  // av. for cff1
 7458:       double av_cff2 = 0.0;  // av. for cff2
 7459:       double av_cff3 = 0.0;  // av. for cff3
 7460:       double av_df = 0.0;  // av. for H^\alpha / H
 7461:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7462:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7463: 
 7464:       const int i34 = elem->i34;
 7465:       const int kb  = elem->kb;
 7466: 
 7467:       for (int j=0; j<i34; j++) {
 7468:          // For each node and side in the element...
 7469: 
 7470:          const Node *node = elem->nodes[j];
 7471:          const Side *side = elem->sides[j];
 7472: 
 7473:          const double chi      = side->chi;
 7474:          const double veg_c2   = side->veg_c2;
 7475:          const double veg_beta = side->veg_beta;
 7476:          const double veg_h    = side->veg_h();
 7477:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7478: 
 7479:          const Vector2 gradPhi = elem->gradPhi[j];
 7480: 
 7481:          // Node - const in elem
 7482:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7483:          elem->gradPr  += node->pr  *gradPhi;
 7484: 
 7485:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7486: 
 7487:         
 7488:          const double htot  = side->htot2();        // Total depth at the side
 7489:          const double zctr2 = side->zTopCanopy();  
 7490: 
 7491:          double cff1; 
 7492:          double cff2; 
 7493:          double cff3;   
 7494:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7495:          // coefficients applied to 2D/3D case 
 7496:             cff1 = side->hhat/htot;
 7497:             cff2 = 0.0;
 7498:             cff3 = 0.0;
 7499:          } else { //3D
 7500:             //Init for no-veg case
 7501:             cff1 = 1.0;
 7502:             cff2 = 1.0;
 7503:             cff3 = 0.0;
 7504: 
 7505:             if constexpr(iveg != 0) {
 7506:                // Computes coefficients used with vegetation terms G1, G2
 7507:                // cff1, cff3 are used for the first two terms in G1, G2:
 7508:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7509:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7510:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7511:                if(veg_h < 0.99*htot) { // submergent vegetation
 7512:                   cff1 = 1.0;
 7513:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7514:                   cff3 = veg_c;
 7515: 
 7516:                } else { // emergent vegetation
 7517:                   cff1 = 1.0/(1.0 + veg_c2);
 7518:                   cff2 = cff1;
 7519:                   cff3 = 0.0;
 7520: 
 7521:                }
 7522:             } // if iveg
 7523:          } //  2D/3D
 7524: 
 7525:          av_cff1 += cff1/i34;
 7526:          av_cff2 += cff2/i34;
 7527:          av_cff3 += cff3/i34;
 7528:          av_cff2_chi += cff2*chi/i34;
 7529:          av_cff3_chi += cff3*chi/i34;
 7530:          av_df += min(htot, veg_h)/(htot*i34);
 7531: 
 7532: 
 7533:          // btrack values: U^\star, U^{\star\alpha}
 7534:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7535:          Vector2 Ustar       = {0.0, 0.0}; 
 7536:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7537: 
 7538:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7539:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7540:          } else { //3D
 7541:             for (int k = side->kb + 1; k < nvrt; k++) {
 7542:             
 7543:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7544:                Ustar += w2;
 7545: 
 7546:                if constexpr(iveg != 0) {
 7547:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7548:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7549:                        Ustar_alpha += zrat*w2; // XXXX
 7550:                    }
 7551:                }  // if iveg
 7552:             }  // for k
 7553:          }  //2D/3D
 7554: 
 7555:          // If needed, project the side velocities to the element frame
 7556:          if constexpr(ics==2) {
 7557:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7558:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7559:          }
 7560:         
 7561: 
 7562:          // Add btrack & surface stress terms to \breve{G} first
 7563:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7564: 
 7565: 
 7566:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7567:          Vector2 tau    = side->tau();  
 7568:          Vector2 ubstar = side->btu[side->kb + 1];  
 7569: 
 7570:          // If needed, project tau and ubstar to the element frame
 7571:          if constexpr(ics==2) {
 7572:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7573:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7574:          }
 7575: 
 7576:          // Term for surface and bottom stress
 7577:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7578: 
 7579: 
 7580:          // All terms in F,F^\alpha,f_b except baroclinic
 7581:          // F, f_b: all explicit terms excluding vegetation 
 7582:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7583:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7584:          const double coriolis = side->coriolis;
 7585:          Vector2 F  =  coriolis*side->U;  // F_x
 7586:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7587:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7588: 
 7589:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7590:             
 7591:             for (int k = side->kb; k < nvrt; k++) {
 7592:                if (zctr2 > side->zc[k-1]) {
 7593:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7594:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7595:                    Fa +=  coriolis*w2*zrat;
 7596:                } // if zctr2
 7597:             } // k
 7598:          } // iveg
 7599: 
 7600:          // Integrate horizontal viscosity force vertically
 7601:          for (int k=side->kb + 1; k<nvrt; k++) {
 7602:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7603: 
 7604:             F += levelHorVisc;
 7605: 
 7606:             // Vegetation term
 7607:             if constexpr(iveg!=0) {
 7608:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7609:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7610:                   Fa += levelHorVisc*zrat;
 7611:                } 
 7612:             } // if iveg
 7613:          } // for k
 7614: 
 7615:          // Get nu*grad(U) at the side's bottom level
 7616:          Vector2 nuGradU = side->nuGradU[side->kb];
 7617: 
 7618:          fb += nuGradU;
 7619: 
 7620:          // If needed, project vectorsF, fb and Fa to the element frame
 7621:          if constexpr(ics==2) {
 7622:             F    = side->frame.projHorVec(F,    elem->frame);
 7623:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7624:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7625:          } // if ics
 7626: 
 7627:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7628:       } // for j (nodes and sides)
 7629: 
 7630:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7631: 
 7632: 
 7633:       // Finish off terms in F, F^\alpha and f_b
 7634:       const double grav3 = elem->mean(&Node::grav2);
 7635:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7636:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7637:       for (int j=0; j<i34; j++) { 
 7638:          // For each side in the element...
 7639:          const Side *side = elem->sides[j];
 7640:          const double chi = side->chi;
 7641: 
 7642:          const double htot = side->htot2();
 7643:          const double veg_h = side->veg_h();
 7644:          const Vector2 F  = htot*fb;
 7645:          const Vector2 Fa = min(htot, veg_h)*fb;
 7646: 
 7647:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7648:       } // for j
 7649: 
 7650:       // tmp is already in elem frame
 7651:       elem->ghat1 += tmp/i34;
 7652: 
 7653:       // Baroclinic force
 7654:       if constexpr(ibc==0) {
 7655:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7656: 
 7657:          Vector2 Fa = {0.0, 0.0};
 7658:          Vector2 intGradRho = {0.0, 0.0};
 7659:          
 7660:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7661:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7662:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7663: 
 7664:             // \in F [m^2/s/s]
 7665:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7666:          }
 7667: 
 7668:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7669:          const Vector2 F = av_df*Fa; //approx
 7670:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7671: 
 7672:       } // if ibc
 7673: 
 7674: 
 7675: 
 7676:    }
 7677: 
 7678: } // extern "C"
 7679: 
 7680: 
 7681: 
 7682: #ifdef DONTCOMPILE
 7683: __global__ void checkMassConservation(Tracers* sumtr) {
 7684: 
 7685:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7686: 
 7687:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7688: 
 7689:    Element *elem = &(mesh->localElemData[i]);
 7690: 
 7691:    // Skip dry elements
 7692:    if (elem->isDry) return;
 7693: 
 7694:    // Local sum array for this thread
 7695:    double localSum[N_TRACERS] = {0.0};
 7696: 
 7697:    // Sum over vertical levels for this element
 7698:    const int kbe = elem->kbe;
 7699:    const double area = elem->area;
 7700: 
 7701:    for (int k = kbe; k < nvrt; k++) {
 7702:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7703:       
 7704:       // Accumulate tracer mass
 7705:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7706:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7707:       }
 7708:    }
 7709: 
 7710:    //  This function returns per element sums. A reduction must be done on the host side.
 7711: }
 7712: 
 7713: 
 7714: __global__ void transport(void) {
 7715: 
 7716:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7717: 
 7718:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7719: 
 7720:    Element *elem = &(mesh->localElemData[ie]);
 7721: 
 7722:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7723: 
 7724:                for (int m=0; m<ntr; m++) {
 7725:                   for (int k=kbe(ie); k<nvrt; k++) {
 7726:                      // Calculate each polynomial's weight 
 7727:                      wm=0.d0; sum1=0.d0; 
 7728:                      wm1=0.d0; wm2=0.d0; 
 7729:                      for (int i=0; i<elem->nweno2; i++) {
 7730:                   
 7731:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7732:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7733:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7734:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7735:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7736:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7737:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7738:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7739:                      // -----------------Hu and Shu (1999)'s method----------------
 7740:                      b4=b1+b2+b3
 7741: 
 7742: //Error: add PRODUCTION CPP
 7743: #ifdef DEBUG
 7744:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7745:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7746:                     call parallel_abort(errmsg)
 7747:                   }
 7748: #endif
 7749: 
 7750:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7751:                   // !----test-------------- 
 7752:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7753:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7754:                   // !wm(i)=wm1(i)*wm2(i)
 7755:                   // !---------------------- 
 7756:                   sum1=sum1+wm(i)
 7757:                 } // end for i
 7758: 
 7759:                 wm=wm/sum1
 7760: 
 7761:                 for (int j=0; j<elem->i34; j++) {
 7762: 
 7763:                   const Side *side  = elem->sides[j];
 7764:                   const Node *node1 = side->n1;
 7765:                   const Node *node2 = side->n2;
 7766: 
 7767:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7768:                      trsd=0.d0
 7769:                      for (int kk=0; kk<nquad; kk++) {
 7770:                         for (int i=0; i<elem->nweno2; i++) {
 7771:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7772:                         } // end for i   
 7773:                      } // end for kk
 7774:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7775:                   } // outward flux
 7776:                } // end for j=1,i34(ie) ! side
 7777:             }
 7778:          }
 7779:               
 7780: 
 7781: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7782: //             //   calculate each polynomial's weight 
 7783: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7784: //                 wm=0.d0; sum1=0.d0
 7785: //                 do i=1,nweno1(ie) !for each polynomial
 7786: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7787: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7788: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7789: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7790: //                   wm(i)=b2
 7791: //                   sum1=sum1+b2
 7792: //                   !wm(i)=1.d0
 7793: //                   !sum1=sum1+1.d0
 7794: 
 7795: // // Error: PRODUCTION
 7796: // #ifdef DEBUG
 7797: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7798: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7799: //                     call parallel_abort(errmsg)
 7800: //                   endif
 7801: // #endif
 7802: 
 7803: //                 enddo !i
 7804: //                 wm=wm/sum1 !final weight
 7805: 
 7806:                 for (int j=0; j<elem->i34; j++) { // side
 7807:                   const Side *side = elem->sides[j];
 7808:                   const Node *node1 = side->n1;
 7809:                   const Node *node2 = side->n2;
 7810: 
 7811:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7812:                     trsd=0.d0
 7813:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7814:                       for (int i=0; i<elem->nweno1; i++) {
 7815:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7816:                       }
 7817:                     enddo //kk
 7818:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7819:                   } // outward flux
 7820:                 } // end for j=1,i34(ie) ! side
 7821:               } // end for k; ntr 
 7822: 
 7823:             else !simple upwind method
 7824:               do j=1,i34(ie)
 7825:                 jsj=elside(j,ie)
 7826:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7827:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7828:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7829:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7830:                   endif
 7831:                 enddo  !vertical layers
 7832:               enddo !j=1,i34(ie) ! side
 7833:             endif !order of accuracy
