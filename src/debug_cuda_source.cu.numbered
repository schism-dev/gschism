 7599: __global__ void printMatrix(bool full) {
 7600:    // Debugging: print the matrix
 7601: 
 7602:    const int size = mesh->np;
 7603:    double sum = 0.0;
 7604:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7605:       const Node *node = mesh->localNodeData + idx_node;
 7606:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7607:       for (int j = 0; j < node->numNodes; j++) {
 7608:          Node* nbNode = node->nodes[j];
 7609:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7610:          sum += node->coeffMatrix[j];
 7611:       }
 7612:       if (full) printf("]\n");
 7613: 
 7614: 
 7615:    }
 7616:    if (!full) printf("sum=%lf\n", sum);
 7617: }
