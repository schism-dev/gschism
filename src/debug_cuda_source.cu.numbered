 3722:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3723:       NODE(node);
 3724:       const int idx = node->idx;
 3725: 
 3726:       node->mX = x[idx];
 3727:    }
