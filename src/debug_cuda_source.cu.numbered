 4327:    __global__ void computeFlowBcVelocities(double time) {
 4328: 
 4329:       SIDE_BND(sideBnd);
 4330: 
 4331:       const Side *side = sideBnd->side;
 4332:  
 4333:       const bool isDry = side->isDry;
 4334:       const bool isLand = sideBnd->segment->isLand;
 4335: 
 4336:    
 4337:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4338: 
 4339:       if (isDry || isLand) return;
 4340: 
 4341:       // For wet sides in open boundaries...
 4342:       const Vector2 n = side->n;
 4343:       const BoundarySegment *segment = sideBnd->segment;
 4344: 
 4345:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4346: 
 4347:       const int ifltype = segment->ifltype;
 4348: 
 4349:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4350:       const Vector2 r_nuth0 = r_uth0*n;
 4351: 
 4352: 
 4353:       if (ifltype == 1 || ifltype == 2) {
 4354:       
 4355:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4356: 
 4357:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4358:          
 4359:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4360:          
 4361:       } else if (ifltype == -1) { // Flather 1
 4362: 
 4363:          for (int k = 0; k < nvrt; k++) {
 4364: 
 4365:             // uth is the normal vel.; no ramp up
 4366:             const double uth = sideBnd->nuth(k);
 4367:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4368: 
 4369:             sideBnd->ubc[k] += uth*n;
 4370:          }
 4371: 
 4372:       } else if (ifltype == 3 || ifltype == 5) {
 4373:          // vnth0=0 !normal vel.
 4374: 
 4375:          Vector2 r_u1_bar = {0.0, 0.0};
 4376:          // Computes the contribution to the velocity from all tide frequencies
 4377:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4378: 
 4379:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4380:             const Vector2 umo  = sideBnd->umo(jfr); 
 4381: 
 4382:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4383:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4384:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4385:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4386:          }
 4387: 
 4388: 
 4389:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4390: 
 4391:       } // if (ifltype = 3 || ifltype == 5
 4392: 
 4393: 
 4394: 
 4395:    }
 4396: 
 4397:    __global__ void computeElevationBoundaryConditions(double time) {
 4398:       // Compute elevation essential boundary conditions 
 4399: 
 4400:       NODE_BND(nodeBnd); // Each boundary node.
 4401: 
 4402:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4403: 
 4404:       const Node *node = nodeBnd->node;
 4405:       const BoundarySegment *segment = nodeBnd->segment;
 4406:       const int iettype = segment->iettype;
 4407:       
 4408: 
 4409:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4410:       double eic = 0.0;
 4411:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4412:       else                 eic = 0.0;
 4413: 
 4414:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4415:       const double r_eth = ramp*nodeBnd->eth;
 4416:       double r_eta1_bar = 0.0;
 4417: 
 4418: 
 4419:       // Compute tide elevation
 4420:       if (iettype == 3 || iettype == 5) {   
 4421: 
 4422:          if constexpr(iloadtide==1) { // loading tide
 4423:             assert(false && "Loading tide not implemented");
 4424:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4425:          }
 4426:          
 4427:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4428: 
 4429:             const double efa  = nodeBnd->efa[jfr]; 
 4430:             const double emo  = nodeBnd->emo[jfr]; 
 4431: 
 4432:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4433:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4434:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4435: 
 4436:          } // for jfr
 4437: 
 4438:       } // if iettype
 4439: 
 4440:       switch (iettype) {
 4441:          case 1:
 4442:          case 2:
 4443:          case 4:
 4444:             nodeBnd->elbc = r_eic + r_eth;
 4445:             break;
 4446:          case 3:
 4447:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4448:             break;
 4449:          case 5:
 4450:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4451:             break;
 4452:       } // switch
 4453: 
 4454: 
 4455:       //Add inverse barometric effects
 4456:       if (iettype != 0 && inv_atm_bnd == 1) {
 4457:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4458:       }
 4459: 
 4460:    }
 4461: 
 4462: 
 4463:    __global__ void computeHorizontalViscosity(void) { 
 4464: 
 4465:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4466: 
 4467:       SIDE(side);
 4468: 
 4469:       if (side->isDry) return;
 4470: 
 4471:       for (int k = 0; k < nvrt; k++) {
 4472:          side->nuGradU[k] = {0.0, 0.0};
 4473:       }
 4474: 
 4475:       if constexpr(ihorcon == 1) {
 4476:          for (int k = side->kb; k < nvrt - 1; k++) {
 4477:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4478:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4479:             // By Zhang and Baptista.
 4480: 
 4481:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4482:             // This is a standard discretization of the Laplacian operator.
 4483:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4484:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4485:             // Gamma is hvis_coef0 in the code.
 4486:             // The value of gamma needs to be < 0.5.
 4487: 
 4488:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4489:             // side under consideration in each of the two possible elements that share the side.
 4490:             Vector2 sumU = {0.0, 0.0};
 4491:             for (int l = 0; l < 2; l++) {
 4492:                const Element *elem = side->elems[l];
 4493: 
 4494:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4495: 
 4496:                // Find the local index of the side in the element
 4497:                const int idxSide = elem->sideLocalIdx(side);
 4498:                // Find the two sides that are connected to the side under consideration
 4499:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4500:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4501: 
 4502:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4503: 
 4504:             }
 4505: 
 4506:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4507:    
 4508:          }
 4509:       }
 4510:       else if constexpr(ihorcon == 2) {
 4511:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4512:       }
 4513: 
 4514: 
 4515:    }
 4516: 
 4517: 
 4518:    __global__ void setEssentialBC(void) {
 4519:       // Set essential boundary conditions 
 4520:       NODE(node); // Each boundary node
 4521:       NodeBoundary *nodeBnd = node->nodeBnd;
 4522:       
 4523: // nodeBnd->isEssentialBC = true;      
 4524:       // Check if this node has essential BC
 4525:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4526:          // Verify BC value is valid
 4527:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4528: 
 4529:        
 4530:          // Set diagonal to 1 and zero off-diagonals
 4531:          node->coeffDiag = 1.0;
 4532: 
 4533:          for (int j = 0; j < node->numNodes; j++) {
 4534:                node->coeffMatrix[j] = 0.0;
 4535:          }
 4536:          
 4537:          // Set solution and RHS to BC value
 4538:          node->mX  = nodeBnd->elbc;
 4539:          node->qel = nodeBnd->elbc;
 4540: 
 4541:       } else {
 4542:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4543: 
 4544:          for (int j = 0; j < node->numNodes; j++) {
 4545:                Node* nbNode = node->nodes[j];
 4546:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4547:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4548:                   // Verify neighbor's BC value
 4549:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4550: 
 4551:                   // Subtract contribution to RHS
 4552:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4553:                   node->coeffMatrix[j] = 0.0;  
 4554:                }
 4555:          }
 4556:       }
 4557:    }
 4558: 
 4559: 
 4560:    __global__ void updateElevation(void) {
 4561:       NODE(node);
 4562: 
 4563:       node->eta2 = node->mX;
 4564: 
 4565:       node->updateZCoordData();
 4566:    }
