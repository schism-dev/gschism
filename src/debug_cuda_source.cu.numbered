 4226:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4227: 
 4228:       NODE_BND(nodeBnd);
 4229: 
 4230:       Node *node = nodeBnd->node;
 4231: 
 4232:       node->ETP = 0.0;
 4233: 
 4234:       for (int j=0; j<ntip; j++) {
 4235: 
 4236:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4237:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4238:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4239: 
 4240:          if constexpr(iloadtide==1) { // loading tide
 4241:             assert(false && "Loading tide not implemented");
 4242:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4243:          }
 4244:          
 4245:       }
 4246:       
 4247:    }
