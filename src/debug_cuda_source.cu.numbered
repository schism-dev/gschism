 1827: // Helper functions for computing the local node index at a given offset from another.
 1828: __device__ __inline__ int nxq(int offset, int index, int size) {
 1829:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1830:    // to the index to make it positive
 1831:    assert(index + offset + 16*size >= 0);
 1832:    return (index + offset + 16*size) % size;  
 1833: }
 1834: 
 1835: __device__ __inline__ int nxq(int index, int size) {
 1836:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1837:    // to the index to make it positive
 1838:    assert(index + 16*size >= 0);
 1839:    return (index + 16*size) % size; 
 1840: }
