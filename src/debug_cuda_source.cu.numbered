 2279: /**
 2280:  * This method performs backtracking from the side center until a time -dt back in time 
 2281:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2282:  * intermediate point.
 2283:  *
 2284:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2285:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2286:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2287:  * remaining time.
 2288:  * 
 2289:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2290:  * 
 2291:  * @param uuint, vvint, wwint: Velocities at the final point
 2292:  * @param jlev: Level at which the backtracking is performed
 2293:  * @param dt, dtbk: Tracking timesteps
 2294:  * @return: True if the backtracking was successful, false otherwise
 2295:  */
 2296: __inline__ __device__ bool Side::btrack(
 2297:       int jlev,
 2298:       double dt,            // Tracking time
 2299:       double dtbk,          // Tracking timestep
 2300:       Vector3 &u_int        // Velocities at the initial point
 2301: ) const {
 2302: 
 2303:    // Start from side center
 2304:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2305:  
 2306: 
 2307:    double time_rm = dt; // Remaining time
 2308: 
 2309: 
 2310:    // // Initialize outputs XXX
 2311:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2312:    //    sclr[i] = 0.0;
 2313:    // }
 2314: 
 2315: 
 2316:    // Initial velocities
 2317:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2318: 
 2319:    // Find the element that is in the direction opposite to the velocity
 2320:    Element* curElem = findElementTowards(toVector2(u_int));
 2321: 
 2322:    // If it starts at a boundary side, we should start with a velocity parallel to the side.
 2323:    if (curElem == nullptr) {
 2324:       // Make velocity parallel to the side
 2325:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2326:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2327:       curElem = otherElem(curElem);
 2328:       
 2329:    }
 2330: 
 2331: 
 2332: 
 2333:    const int MAX_ITERATIONS = 1000; 
 2334:    Element* nextElem = curElem;
 2335:    int iter = 0;
 2336:    while(true) {
 2337: 
 2338:       // Calculate timestep
 2339:       double dtb = min(dtbk, time_rm);
 2340: 
 2341:       // Next point in the backtracking curve
 2342:       Point3 xt = x0 - dtb*u_int;
 2343: 
 2344: 
 2345:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2346:       assert(found && "Backtracking failed in btrack");
 2347: 
 2348:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2349:                       // then time_rm needs to be increased by the unused time.
 2350:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2351: 
 2352:       // The current point becomes the next segment's starting point.
 2353:       x0 = xt;
 2354:  
 2355:       curElem = nextElem;
 2356: 
 2357:       iter++;
 2358:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2359:    }
 2360: 
 2361: 
 2362: }
 2363: 
 2364: 
 2365: 
 2366: // /**
 2367: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2368: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2369: 
 2370: //    Inputs:
 2371: //    @param x1, y1: point inside the element
 2372: //    @param x2, y2: other end of the line segment
 2373: 
 2374: //    Outputs:
 2375: //    @param intersectingSide:  side that intersects the line segment
 2376: //    @param nextElement: element that contains the intersection point
 2377: //    @param xIntersect, yIntersect: intersection point  
 2378: 
 2379: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2380: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2381: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
