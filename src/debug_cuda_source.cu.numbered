 2323: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2324: // return;   
 2325:    // Lock the mutex
 2326:    lock(&debugPlotMutex);
 2327:  
 2328:    bool ok = true;
 2329:    if (debugPlotIdx == nullptr) ok = false;
 2330:    if (*debugPlotIdx >= 1000000) ok = false;
 2331:    if (ok) {
 2332:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2333:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2334:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2335:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2336:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2337:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2338:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2339:       (*debugPlotIdx)++;
 2340:    }
 2341: 
 2342:    __threadfence();               // ensure all above writes are visible
 2343:    // Unlock the mutex
 2344:    unlock(&debugPlotMutex);
 2345: 
 2346: }
