 1913: 
 1914: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1915:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1916: 
 1917:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1918: 
 1919:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1920:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1921:    // curElement.
 1922: 
 1923:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1924:    // And uses this velocity instead to continue the tracking.
 1925: 
 1926:    // computes the intersection point in cartesian coordinates
 1927:    Point2 intersection = nextSide->p_t(tt);
 1928: 
 1929:    // Nudges the point to the barycenter of the element. 
 1930:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1931:    // next segment intersects the element sides.  
 1932:    curElem->nudgeToBarycenter(intersection);
 1933: 
 1934:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1935:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1936:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1937:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1938: 
 1939:    // If the side is an open boundary, the tangential velocity is zero.
 1940:    if (nextSide->isBnd()) vtan = 0.0;
 1941: 
 1942:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1943:    const double us = vtan*nextSide->t().x;
 1944:    const double vs = vtan*nextSide->t().y;
 1945:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1946: 
 1947:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1948:    const double len2 = norm2(intersection - toPoint2(xt));
 1949:    const double vel2 = dot(u_int, u_int);        
 1950:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1951:    else            dt = 0.0;
 1952: 
 1953:    // The end of this tracking segment is now the intersection point.
 1954:    xt = {intersection.x, intersection.y, zint};
 1955: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1956:    u_int = {us, vs, ws};
 1957:    
 1958: }
 1959: 
 1960: /**
 1961:  * Tracks a particle through elements and vertical levels in the mesh.
 1962:  * 
 1963:  * @param x0,y0,z0     Starting position coordinates
 1964:  * @param xt,yt,zt     Target position coordinates
 1965:  * @param dtb          Time step for tracking
 1966:  * @param uuint,vvint,wwint Initial velocity components
 1967:  * @param nextElem     Starting/resulting element index
 1968:  * 
 1969:  * @return Status code of type trackExitCodes
 1970:  * 
 1971:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1972:  * of the details are different. The idea is that the code requires less branches and is better fit
 1973:  * for GPU execution.
 1974:  * 
 1975:  * The main ideas here are:
 1976:  * - The starting point is expected to be in the starting element.
 1977:  * - The end point is guaranteed to be inside an element.
 1978:  * - since the starting point is inside the element, there are only two cases: 
 1979:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1980:  *     (b) it does not and (xt,yt) is already in the starting element.
 1981:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1982:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1983:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1984:  * - tt1 can be positive or negative. We only consider the positive values.
 1985:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1986:  * - The next intersection will occur at the smallest positive tt1.
 1987:  * - This intersection will be the next (x0,y0) position.
 1988:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1989:  *   of getting stuck in a loop.
 1990:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1991:  *   was found.
 1992:  */
 1993: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1994:                                                        Element *&nextElem, int &jlev, double &dt,
 1995:                                                        const Side *origSide) {
 1996: 
 1997: 
 1998: if (origSide->idx == 8) {
 1999:    printf("AAAA&&&& u_int = %e,%e,%e, x0 = %f,%f,%f, xt = %f,%f,%f, dt = %e\n", u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, dt);
 2000: }
 2001:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2002:    // else to do.
 2003:    // If it is, nudges the point to be inside the element.
 2004:    const Element *curElem = nextElem;
 2005:    if (containsPoint(toPoint2(xt), true)) {
 2006: 
 2007:       curElem->interpolateVelocities(xt, u_int);
 2008: if (origSide->idx == 8) printf("BBB&&&& u_int = %e,%e,%e, x0 = %f,%f,%f, xt = %f,%f,%f, dt = %e\n", u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z, dt);      
 2009: addDebugPlot(x0, xt);
 2010:       return true;
 2011:    }
 2012: 
 2013:    Side *side = nullptr;
 2014: 
 2015:    // 1. Initial checks
 2016:    // Verify starting element is valid (wet)
 2017:    assert(!curElem->isDry && "Starting element is dry");
 2018: 
 2019:    // Checks if track has a zero length.
 2020:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2021:    // assert(len2 > 0.0 && "Zero length track"); 
 2022:    
 2023:    const int MAX_ITERATIONS = 1000;
 2024:    
 2025:    double t;
 2026:    Side *nextSide = nullptr;
 2027:    double tIntersect = 1e10;
 2028:    double zint = x0.z;
 2029: 
 2030:    // Horizontal tracking loop
 2031:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2032:    // (x0,y0) is inside the element but the target point is not.
 2033: 
 2034:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2035: 
 2036:    assert(found_intersection && "No intersection found at %d");
 2037: 
 2038:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2039: 
 2040:    // if the tracking segment goes out of water (either dry or edge boundary)
 2041:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2042: 
 2043: addDebugPlot(x0, xt, 0x00A0FF);
 2044: printf("BBBXXXX going out of water\n");
 2045:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2046: addDebugPlot(x0, xt, 0x00A0FF);      
 2047: 
 2048:       nextElem = this;
 2049:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2050:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2051:       return true;    
 2052:    }
 2053: 
 2054: 
 2055:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2056:    int iterations = 0;
 2057:    while (iterations < MAX_ITERATIONS) {
 2058:       iterations++;
 2059: printf("BBBXXXX iterations = %d\n", iterations);      
 2060:       
 2061:       Element *curElem = nextElem;
 2062: 
 2063:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2064: addDebugPlot(x0, xt);
 2065:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2066: 
 2067:       // If we are already in the target element, we are done.
 2068:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2069:       if (!found_intersection) break;
 2070: 
 2071: 
 2072: 
 2073:       // if the tracking segment goes out of water (either dry or edge boundary).
 2074:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2075: addDebugPlot(x0, xt, 0x00A0FF);
 2076: printf("BBBXXXX going out of water\n");
 2077:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2078: addDebugPlot(x0, xt, 0x00A0FF);   
 2079:          nextElem = curElem;
 2080: 
 2081:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2082:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2083:          return true;
 2084:       }
 2085:       
 2086:       // Update position and element for next iteration
 2087:       side = nextSide;
 2088: 
 2089:    }
 2090: 
 2091:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2092: 
 2093:  
 2094:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2095:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2096: addDebugPlot(x0, xt);   
 2097: printf("MMMMMM nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2098:    nextElem->interpolateVelocities(xt, u_int); 
 2099: printf("MMMMMM2 nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2100: 
 2101:    return true;
 2102: }
 2103: 
 2104: 
 2105: __inline__ __device__ double Element::computeSignedArea(void) const {
 2106:    // Compute the area of the element
 2107: 
 2108:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2109: 
 2110:    // In the quad case we need to add the area of the other triangle.
 2111:    if (isQuad()) {
 2112:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2113:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2114:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2115:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2116:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2117:          Error("Negative area found in quad element");
 2118:       }
 2119:       res += ar1;
 2120:    }
 2121: 
 2122:    return res;
 2123: }
 2124: 
 2125: 
 2126: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2127:                                                                 (nodes[1]->isDry2()) ||
 2128:                                                                 (nodes[2]->isDry2()) ||
 2129:                                                                 (i34==4 && nodes[3]->isDry2());
 2130: }
 2131: 
 2132: 
 2133: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2134:    // In boundary sides, the element 1 is nullptr
 2135:    return side->elems[1] == nullptr; 
 2136: }
