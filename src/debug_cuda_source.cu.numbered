 7449: __global__ void printMatrix(bool full) {
 7450:    // Debugging: print the matrix
 7451: 
 7452:    const int size = mesh->np;
 7453:    double sum = 0.0;
 7454:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7455:       const Node *node = mesh->localNodeData + idx_node;
 7456:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7457:       for (int j = 0; j < node->numNodes; j++) {
 7458:          Node* nbNode = node->nodes[j];
 7459:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7460:          sum += node->coeffMatrix[j];
 7461:       }
 7462:       if (full) printf("]\n");
 7463: 
 7464: 
 7465:    }
 7466:    if (!full) printf("sum=%lf\n", sum);
 7467: }
