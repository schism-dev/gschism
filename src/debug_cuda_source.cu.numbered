 3666: 
 3667: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3668:    // Computes the z coordinate at level k.
 3669:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3670:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3671:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3672:    // used 
 3673: 
 3674:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3675:    
 3676:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3677: 
 3678:    if (isDry2()) return 0.0;  
 3679: 
 3680:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3681: 
 3682:    if constexpr(ivcor == 2) {
 3683: 
 3684:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3685:       const double h_c = mesh->h_c;
 3686:       const double theta_f = mesh->theta_f;
 3687:       const double sinh_theta_f = mesh->sinh_theta_f;
 3688: 
 3689: 
 3690:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3691:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3692:       // once per time step/node. XXXX
 3693:       // CHECK: updateZCoordData
 3694: 
 3695:       //  To simplify comparisons, I define index versions of count variables.
 3696:       if      (k == ivrt)     return eta2; 
 3697:       else if (k == izlev)    return -hmod2;
 3698:       else if (k == kb)       return -depth;
 3699:       else if (k < izlev)     return mesh->ztot[k];
 3700:       else if (k > izlev) {
 3701:          const int ksig = k - izlev;
 3702: 
 3703:          if (hmod2 <= h_c) {
 3704:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3705: 
 3706:          } 
 3707:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3708:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3709:             assert(false && "compZCoord: invalid h_c\n");
 3710:          } 
 3711:          else {
 3712:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3713:                    h_c * mesh->sigma[ksig] + 
 3714:                    (hmod2 - h_c) * mesh->cs[ksig];
 3715:          }
 3716:       } else { 
 3717:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3718:       }
 3719: 
 3720:    }
 3721:    else {  // if constexpr(ivcor == 1)
 3722:       if (k <= kb)        return -depth; 
 3723:       else if (k == ivrt) return eta2;
 3724:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3725: 
 3726:    }
 3727:    
 3728:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3729:    return 0.0;
 3730: }
 3731: 
 3732: 
 3733: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3734:    // Computes the bottom drag Cd based on the selected nchi
 3735: 
 3736:    if constexpr(nchi == 0) {
 3737:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3738:       Cd = drag;  // Read from drag file
 3739: 
 3740:    } else if constexpr(nchi == 1) {
 3741:       // 
 3742: 
 3743:       bool ltmp = false; // for WBL iteration
 3744: 
 3745:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3746:       if (isDry || (rough == 0.0)) {
 3747:          Cd = 0.0;
 3748: 
 3749:       } else { //roughness >0 
 3750:          
 3751:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3752: 
 3753:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3754: 
 3755:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3756: 
 3757:       } // if rough
 3758: 
 3759:    } else if constexpr(nchi == -1) {
 3760:    // Manning 
 3761:  
 3762:       const double htot = max(hmin_man, htot2()); 
 3763:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3764: 
 3765:    } else {
 3766:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3767:       
 3768:    } // if nchi
 3769: 
 3770: }
 3771: 
 3772: 
 3773: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3774:    // Checks if a side in on the boundary
 3775:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3776: 
 3777:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3778:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3779: 
 3780:    // Indices of the nodes that form the side
 3781:    //
 3782:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3783:    const int n1 = side.n1->idx;
 3784:    const int n2 = side.n2->idx;
 3785:    isLand = false;
 3786:    
 3787: 
 3788:    // Check if the side is on a land boundary
 3789:    for (int i = 0; i < nland; i++) {
 3790:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3791:          // Consecutive nodes in the land boundary segment
 3792:          const int b1 = ilnd[i + j*nland];
 3793:          const int b2 = ilnd[i + (j + 1)*nland];
 3794: 
 3795:          assert(b1 != -1 && b2 != -1);
 3796: 
 3797:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3798:             
 3799:             isLand = true;
 3800:             return i;
 3801:          }
 3802:       }
 3803:    }
 3804: 
 3805:    // Check if the side is on an open boundary
 3806:    for (int i = 0; i < nope; i++) {
 3807:       for (int j = 0; j < nond[i] - 1; j++) {
 3808:          // Consecutive nodes in the open boundary segment
 3809:          const int b1 = iond[i + j*nope];
 3810:          const int b2 = iond[i + (j + 1)*nope];
 3811: 
 3812:          assert(b1 != -1 && b2 != -1);
 3813: 
 3814:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3815:             isLand = false;
 3816:             return i;
 3817:          }
 3818:       }
 3819:    }
 3820: 
 3821:    // Check that the nodes are not both on the boundary
 3822:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 3823:         && "side not in ilnd/iond but both nodes are boundary" );
 3824: 
 3825:    return -1;
 3826: }
 3827: 
 3828: 
 3829: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3830:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3831:                                     double *wind_rotate_angle, 
 3832:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3833:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3834:                                     int16_t *nodePermutationSort, 
 3835:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 3836:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3837:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3838:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3839:                                     double *crs_data, 
 3840:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3841: 
 3842:    NODE(pnode);  
 3843:    const int i = idx_node;
 3844:    const int iglobal = globalNodeIndices[i];
 3845:    Node &node(*pnode);
 3846: 
 3847:    node.idx = iglobal;
 3848:    node.part = localNodePart[iglobal];
 3849: 
 3850:    // It is important to differentiate between the global and local "start" indices because they
 3851:    // play different, but related, roles in this code. The global "start" indices are used
 3852:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 3853:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 3854:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 3855:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 3856:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 3857:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 3858:    node.numNodes = idxNodeEnd - idxNodeStart;
 3859:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 3860: 
 3861:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 3862:    node.coeffRow = crs_data + rowStart; 
 3863: 
 3864: 
 3865: 
 3866:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 3867:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 3868:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 3869:    node.numElements = idxElemEnd - idxElemStart;
 3870:    node.elements = nodeNeighElems + idxElemLocalStart;
 3871: 
 3872: 
 3873:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 3874:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3875:       const int partNode = localNodePart[idxNodeGlobal]; 
 3876:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3877: 
 3878:       Node *node_ptr = nodes[partNode] + idxNode;
 3879:       
 3880:       nodeNeighNodes[idxLocal] = node_ptr;
 3881:    }
 3882: 
 3883: 
 3884:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 3885:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3886:       const int partElem = localElemPart[idxElemGlobal];
 3887:       const int idxElem  = localElemIndices[idxElemGlobal];
 3888: 
 3889:       Element *elem_ptr = elems[partElem] + idxElem;
 3890: 
 3891:       nodeNeighElems[idxLocal] = elem_ptr;
 3892:    }      
 3893: 
 3894:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3895:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3896: 
 3897:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3898: 
 3899:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3900:    if constexpr(ics == 1) {
 3901:       node.p.x   = node_coords[i * 3];
 3902:       node.p.y   = node_coords[i * 3 + 1];
 3903:       node.gz = 0.0;
 3904: 
 3905:       if (use_ll) {                                    // <-- add
 3906:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3907:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3908:       }  
 3909: 
 3910:    } else {
 3911:       const double lon = deg2rad*node_coords[i * 3];
 3912:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3913: 
 3914:       Point3 p = computeXYZfromLatLon(lat, lon);
 3915:       node.p = toVector2(p);
 3916:       node.gz = p.z;
 3917:       node.lon = lon;
 3918:       node.lat = lat;
 3919: 
 3920:       #ifdef USE_FRAMES
 3921:       node.setFrame(lat, lon);
 3922:       #endif
 3923: 
 3924: 
 3925:    }
 3926: 
 3927:    node.depth = node_coords[i * 3 + 2];
 3928: 
 3929:    node.numSides = 0;
 3930: 
 3931:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3932:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 3933:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 3934:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 3935:    else assert(false && "populateNodes: selected nchi not implemented.");
 3936: 
 3937:    if constexpr(ivcor == 1) 
 3938:    {  
 3939:       node.kb = kb[iglobal];
 3940: 
 3941:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 3942:    }
 3943: 
 3944:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3945:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3946:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3947: 
 3948:    
 3949:    // Links the node to the boundary information
 3950:    if (isbnd[iglobal] >= 0) {
 3951:      
 3952:       // Get the index of the node boundary
 3953:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3954: 
 3955:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3956:       node.nodeBnd->node = &node;
 3957: 
 3958:       node.nodeBnd->sideBnd1 = nullptr;
 3959:       node.nodeBnd->sideBnd2 = nullptr;
 3960: 
 3961:       if (isbnd[iglobal]>=0) {
 3962: 
 3963:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 3964:          
 3965:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3966:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3967: 
 3968:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3969:          node.nodeBnd->segment->clen  = nan("1");
 3970:          node.nodeBnd->segment->carea = nan("1");
 3971: 
 3972:       }
 3973:    } else {
 3974: 
 3975:       node.nodeBnd = nullptr; // For internal nodes
 3976: 
 3977:       if (isbnd[iglobal] == landSegment) {
 3978:          node.nodeBnd = landBoundaryNode;
 3979:          node.nodeBnd->segment = landBoundarySegment;
 3980:       }
 3981:       
 3982:    }
 3983:    
 3984:    // XXXX GAUSSIAN HILL VELOCITIES
 3985:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3986:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3987:          constexpr double rot_per = 3000.0;
 3988:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3989:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3990:       // XXXXX
 3991:    #endif
 3992: 
 3993: }
 3994: 
 3995: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 3996:    
 3997:    NODE(node);
 3998:    const int localIdx = idx_node;
 3999: 
 4000: 
 4001:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4002:    int16_t *csrSlot = node->csrSlot;  
 4003: 
 4004:    // Simply count the number of nodes with a smaller global index than the current node.
 4005:    // It accounts for the diagonal element.
 4006:    for (int i = 0; i < node->numNodes; ++i) {
 4007:       const int col = node->nodes[i]->idx;
 4008:       int16_t idx = 0;
 4009: 
 4010:       //Takes care of the diagonal element.
 4011:       if (node->idx < col) ++idx;          
 4012: 
 4013:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->idx < col) ++idx;
 4014:       csrSlot[i] = idx;
 4015:    }
 4016: 
 4017:    // Find the diagonal element in the CRS matrix.
 4018:    int16_t idxDiag = 0;
 4019:    for (int j = 0; j < node->numNodes; ++j)
 4020:       if (node->nodes[j]->idx < node->idx) ++idxDiag;
 4021: 
 4022:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4023: 
 4024:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4025:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4026: 
 4027:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4028:    const int rowNNZ = node.numNodes + 1;        // +1 is to account for the diagonal element.
 4029:    crs_indptr[localIdx] = rowStart;
 4030: 
 4031:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4032:    crs_indices[rowStart + d] = node->idx;  
 4033:    for (int j = 0; j < node->numNodes; ++j) crs_indices[rowStart + node->csrSlot[j]] = node->nodes[j]->idx;
 4034: 
 4035: 
 4036: }
 4037: 
 4038: 
 4039: 
 4040: 
 4041: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4042:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4043:                                     double *wind_rotate_angle,   
 4044:                                     int *isdel, int *isidenode, int *isbnd,
 4045:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4046:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4047:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4048:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4049:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4050:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4051:                                     double *drag, double *roughness) {
 4052: 
 4053: 
 4054:    SIDE(pside);
 4055:    Side &side(*pside);
 4056:    const int i = idx_side;
 4057:    const int iglobal = globalSideIndices[i];
 4058:    side.idx = iglobal;  
 4059:    
 4060:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4061:    const double fc   = 2.0*omega_e*sin(sfea0);
 4062:    const double beta = 2.0*omega_e*cos(sfea0);
 4063: 
 4064:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4065: 
 4066:    // finding the pointer to the nodes that form the side
 4067:    const int idx_n1 = isidenode[iglobal*2];
 4068:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4069: 
 4070: if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4071: 
 4072:    const int locidx_n1 = localNodeIndices[idx_n1];
 4073:    const int locidx_n2 = localNodeIndices[idx_n2];
 4074:    const int part_n1 =   localNodePart[idx_n1];
 4075:    const int part_n2 =   localNodePart[idx_n2];
 4076: 
 4077: if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4078: if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4079: 
 4080:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4081:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4082: 
 4083: if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4084: 
 4085:    // Counts the number of sides connected to each node
 4086:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4087:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4088: 
 4089:    // Side boundary type
 4090:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4091:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4092: if (i == 0) printf("populateSides: 2\n");
 4093: 
 4094:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4095:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4096:    {
 4097:       bool isLand = false;
 4098:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4099:       
 4100:       if (isbs > -1) {
 4101:          // assert(isLand || isbs>=0);
 4102:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4103: 
 4104:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4105: 
 4106:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4107:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4108: 
 4109:          assert (isLand == side.sideBnd->segment->isLand);
 4110:          
 4111:          side.sideBnd->side = &side;
 4112: 
 4113:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4114:          n1bnd->linkSideBoundary(side.sideBnd);
 4115:          n2bnd->linkSideBoundary(side.sideBnd);
 4116: 
 4117:       }
 4118:       else {
 4119:          side.sideBnd = nullptr;
 4120:       }
 4121:    }
 4122:    else 
 4123:    {
 4124:       side.sideBnd = nullptr;
 4125:    }
 4126: 
 4127: if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4128: 
 4129:    // finding the pointer to the elements that share the side
 4130:    const int idx_e1 = isdel[iglobal*2];
 4131:    const int idx_e2 = isdel[iglobal*2 + 1];
 4132: 
 4133:    if (idx_e1 > -1) {
 4134:       const int locidx_e1 = localElemIndices[idx_e1];
 4135:       const int part_e1 =  localElemPart[idx_e1];
 4136:       side.elems[0] = elems[part_e1] + locidx_e1;
 4137: 
 4138:    }
 4139:    else {
 4140:       side.elems[0] = nullptr;
 4141:    }
 4142: 
 4143: if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4144: 
 4145:    if (idx_e2 > -1) {
 4146:       const int locidx_e2 = localElemIndices[idx_e2];
 4147:       const int part_e2 =  localElemPart[idx_e2];
 4148:       side.elems[1] = elems[part_e2] + locidx_e2;
 4149:    }
 4150:    else {
 4151:       side.elems[1] = nullptr;
 4152:    }
 4153: 
 4154: if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4155: 
 4156:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4157:       
 4158:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4159:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4160:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4161:          
 4162:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4163:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4164:       // printf("sideBnd: %p\n", side.sideBnd);
 4165:       // assert(false && "Side has no elements and no boundary");
 4166:    }
 4167:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4168: 
 4169:    // Compute the center of the side
 4170:    side.center = 0.5*(side.n1->p + side.n2->p);
 4171: 
 4172:    #ifdef USE_FRAMES
 4173:    side.setFrame();
 4174:    #endif
 4175: 
 4176: if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4177: 
 4178:    // Normal, unitary vector to the side
 4179:    if constexpr(ics == 1) {
 4180:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4181:       side.n = normalize(side.n);
 4182:    }
 4183:    else {
 4184:       // Unit side vector in 3D cartesian coordinates
 4185:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4186: 
 4187:       nSide = normalize(nSide);
 4188: 
 4189:       // Its cross product with the unit local z-axis vector (nUp) is the
 4190:       // normal vector we are looking for.
 4191:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4192: 
 4193:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4194:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4195:       side.n = -normalize(n2D); 
 4196: 
 4197:    }
 4198: 
 4199: if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4200: 
 4201:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4202:    side.shapiro = shapiro0;
 4203: 
 4204:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4205:    // XXXX
 4206:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4207:    constexpr double rot_per=3000.0;
 4208:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4209:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4210:    // XXXXX      
 4211:    #endif
 4212:    // Compute the z level at the center of the side
 4213:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4214:    
 4215:    // Compute the length of the side
 4216:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4217: 
 4218: if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4219: 
 4220:    // Compute the Coriolis coefficient
 4221: 
 4222:    if constexpr(ncor == -1 || ncor == 0) {
 4223:       side.coriolis = coricoef;
 4224:    }
 4225:    else {
 4226:       const double sphi = side.lat();  // Latitude at the center of the side
 4227: 
 4228:       assert(use_ll && "use_ll must be true when ncor > 0");
 4229: 
 4230:       if constexpr(ics == 1) {
 4231:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4232:       }
 4233:       else { // ics == 2
 4234:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4235:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4236:       }
 4237: 
 4238:    }
 4239: 
 4240: if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4241: 
 4242: }
 4243: 
 4244: 
 4245: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4246:    double *node_coords, double *node_coords_ll, bool use_ll,
 4247:    double *wind_rotate_angle,   
 4248:    int *isdel, int *isidenode, int *isbnd,
 4249:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4250:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4251:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4252:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4253:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4254:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4255:    double *drag, double *roughness) {
 4256: 
 4257:    ELEM(pelem);
 4258:    Element &elem(*pelem);
 4259:    const int i = idx_elem;
 4260: 
 4261:    elem.idx = i;
 4262: 
 4263:    for (int j = 0; j < i34[i]; j++) {
 4264:       const int idxNode = elnode[i*4 + j];  
 4265:       const int idxSide = elside[i*4 + j];
 4266:       
 4267:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4268:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4269: 
 4270:       // Find the neighboring element  
 4271:       if (elem.sides[j]->elems[0] == &elem) {
 4272:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4273:       }
 4274:       else {
 4275:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4276:       }
 4277:       
 4278:    }
 4279: 
 4280:    elem.i34 = i34[i];
 4281: 
 4282:    // Compute the barycenter of the element and its depth
 4283:    elem.center = {0.0, 0.0};
 4284:    elem.depth = 1e10;
 4285:    for (int j = 0; j < i34[i]; j++) {
 4286: 
 4287:       elem.center += elem.nodes[j]->p/i34[i];
 4288:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4289:    }
 4290: 
 4291:    #ifdef USE_FRAMES
 4292:    elem.setFrame();
 4293:    #endif
 4294: 
 4295:    elem.area = elem.computeSignedArea(); 
 4296:    elem.radius = sqrt(elem.area)/pi; 
 4297:    
 4298:    // Determines which way the normal vector to each side is oriented.
 4299:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4300:    for (int j = 0; j < i34[i]; j++)  
 4301:    {
 4302:       if (elem.sides[j]->elems[0] == &elem) {
 4303:          elem.ssign[j] =  1.0;
 4304:       }
 4305:       else {
 4306:          elem.ssign[j] = -1.0;
 4307:       }
 4308: 
 4309:    }
 4310: 
 4311:   
 4312: 
 4313:    // Derivatives of shape functions
 4314:    //  For ics=2, this is done in the element frame
 4315:    //  For quads, the derivative is evaluated at centroid
 4316:    for (int j = 0; j < elem.i34; j++) {
 4317:       const double area = elem.area;
 4318:       const int id2 = elem.nxq(1 + j);
 4319:       const int id3 = elem.nxq(2 + j);
 4320:       const int id4 = elem.nxq(3 + j);
 4321:       if (elem.isTri()) {
 4322:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4323:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4324:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4325:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4326:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4327:          // And so on for the other shape functions.
 4328: 
 4329:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4330:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4331:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4332: 
 4333:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4334:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4335: 
 4336:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4337: 
 4338:       }
 4339:       else  { // Quad, the derivatives are evaluated at the centroid
 4340: 
 4341:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4342:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4343:          // ...
 4344:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4345: 
 4346:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4347:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4348:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4349: 
 4350:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4351:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4352: 
 4353:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4354: 
 4355:       } // if Tri/Quad
 4356: 
 4357:    } // for j   
 4358:    
 4359:    
 4360: 
 4361: }
 4362: 
 4363: 
 4364: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4365:                                             double *emo, double *efa, 
 4366:                                             double *umo, double *ufa, 
 4367:                                             double *vmo, double *vfa,
 4368:                                             int *ifltype, int *iettype) {
 4369: 
 4370:    NODE_BND(nodeBnd);
 4371:    const int idx = idx_node_bnd;    
 4372: 
 4373:    nodeBnd->idx = idx;
 4374: 
 4375:    // Need to find the segment index and the index of the node on the segment
 4376:    int idxNode = -1;
 4377:    int iseg, i;
 4378:    for (iseg = 0; iseg < nope; iseg++) {
 4379:       // for each segment...
 4380:       for (i = 0; i < nond[iseg]; i++) {
 4381:          idxNode = iond[iseg + i*nope];
 4382:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4383:          
 4384:       }
 4385:    }
 4386: 
 4387:    assert(iseg < nope && "iseg is out of bounds");
 4388: 
 4389: found: // Jumped here when the node was found
 4390: 
 4391:    nodeBnd->isEssentialBC = true;
 4392:    nodeBnd->elbc = 0.0;
 4393: 
 4394:    nodeBnd->segment->ifltype = ifltype[iseg];
 4395:    nodeBnd->segment->iettype = iettype[iseg];
 4396: 
 4397:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4398: 
 4399:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4400: 
 4401:       nodeBnd->efa[jfr] = efa[idx2];
 4402:       nodeBnd->emo[jfr] = emo[idx2];
 4403:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4404:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4405: 
 4406:    }
 4407:         
 4408: 
 4409: }
 4410: 
 4411: __device__ void Mesh::populateBoundarySideLinks(void) {
 4412: 
 4413:    SIDE_BND(sideBnd);
 4414: 
 4415:    const Side *side = sideBnd->side;
 4416: 
 4417:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4418:    // and the rightSide is the side s that has s->n1 == side->n2
 4419:    for (int i = 0; i < mesh->nbs; i++) {
 4420: 
 4421:       Side *s = &mesh->localSideData[i];
 4422: 
 4423:       if (s == side) continue;  // Do not link the side to itself
 4424:    
 4425:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4426:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4427:    }
 4428:    
 4429: }
