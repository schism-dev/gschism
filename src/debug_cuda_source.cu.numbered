 8049: __global__ void getStructSizes(int* sizes)  {
 8050:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8051:       sizes[0] = (int)sizeof(Node);
 8052:       sizes[1] = (int)sizeof(Element);
 8053:       sizes[2] = (int)sizeof(Side);
 8054:       sizes[3] = (int)sizeof(NodeBoundary);
 8055:       sizes[4] = (int)sizeof(SideBoundary);
 8056:       sizes[5] = (int)sizeof(BoundarySegment);
 8057: }
