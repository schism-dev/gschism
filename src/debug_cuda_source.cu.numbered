 7648: __global__ void getStructSizes(int* sizes)  {
 7649:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7650:       sizes[0] = (int)sizeof(Node);
 7651:       sizes[1] = (int)sizeof(Element);
 7652:       sizes[2] = (int)sizeof(Side);
 7653:       sizes[3] = (int)sizeof(NodeBoundary);
 7654:       sizes[4] = (int)sizeof(SideBoundary);
 7655:       sizes[5] = (int)sizeof(BoundarySegment);
 7656: }
