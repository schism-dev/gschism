 5709: #ifdef DONTCOMPILE
 5710: __device__ void computeVerticalAdvection(void) {
 5711:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 5712: 
 5713:    sdbt(1:2,:,:)=0.d0
 5714: 
 5715:    const Side *side = FROM kernel;
 5716: 
 5717:    if(side->isDry) return;
 5718: 
 5719:    // If side is wet...
 5720: 
 5721: 
 5722:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 5723:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 5724:    double ws[nvrt] = {} // w @ side
 5725:    int icount = 0;
 5726:    for (int j=0; j<2; j++) {
 5727:       const Element *elem = side->elements[j];
 5728:        
 5729:       if(elem != nullptr) {
 5730:          icount++;
 5731:          for (int k=0; k<nvrt; k++) {
 5732:             ws[k] = ws[k] + elem->w[k];
 5733:          }
 5734:       }
 5735:    }  // for j
 5736: 
 5737:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 5738:    ws = ws/icount;
 5739: 
 5740:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 5741:    // Splines allow for a smooth transition between vertical levels.
 5742:    // Splines have continuity restrictions at the internal knots, but
 5743:    // we have to provide the 1st derivatives at the endpoints.
 5744:    const int kbs = side->kbs; 
 5745:    
 5746:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5747:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5748:    initCubicSpline(kbs, nvrt, side, ws, up)
 5749: 
 5750:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5751:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5752:    initCubicSpline(kbs, nvrt, side, ws, vp)
 5753: 
 5754:    // Total advection (average onto side)
 5755:    const Node *node1 = side->nodes[0];
 5756:    const Node *node2 = side->nodes[1];
 5757:    for (int k=kbs(i); k<nvrt; k++) {
 5758: 
 5759:       if constexpr(ics==1) {
 5760:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 5761:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 5762:       } else {
 5763:          // XXX IMPLEMENT THIS
 5764:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 5765:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 5766:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 5767:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 5768:       }  // if ics
 5769: 
 5770: 
 5771:    }
 5772: }
 5773: #endif
 5774: 
 5775: 
 5776: extern "C" {
 5777:    __global__ void computeElemAverageGhat(void) {
 5778:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 5779: 
 5780:       ELEM(elem);
 5781:       
 5782:       elem->ghat1= {0.0, 0.0};  
 5783: 
 5784:       if constexpr(ihydraulics != 0) {
 5785:          if (nhtblocks > 0 && elem->isblock) return;
 5786:       }
 5787: 
 5788:       if (elem->isDry) return;
 5789: 
 5790:       // Wet elements.
 5791:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 5792:       // tidal potential, horizontal diffusion, and baroclinic etc
 5793:       // Remember to update both fb and F 
 5794:       // If ics=2, ghat1 are in eframe (ll)
 5795:       // cff1-3: coefficients for 2D/3D
 5796:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 5797:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 5798:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 5799: 
 5800:       double av_cff1 = 0.0;  // av. for cff1
 5801:       double av_cff2 = 0.0;  // av. for cff2
 5802:       double av_cff3 = 0.0;  // av. for cff3
 5803:       double av_df = 0.0;  // av. for H^\alpha / H
 5804:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 5805:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 5806: 
 5807:       const int i34 = elem->i34;
 5808:       const int kb = elem->kb;
 5809: 
 5810:       for (int j=1; j<i34; j++) {
 5811:          // For each node and side in the element...
 5812: 
 5813:          const Node *node = elem->nodes[j];
 5814:          const Side *side = elem->sides[j];
 5815: 
 5816:          const double chi      = side->chi;
 5817:          const double veg_c2   = side->veg_c2;
 5818:          const double veg_beta = side->veg_beta;
 5819:          const double veg_h    = side->veg_h();
 5820:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 5821: 
 5822:          // Node - const in elem
 5823:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 5824:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 5825: 
 5826:          if (elem->depth >= tip_dp) {
 5827:            elem->gradETP += node->ETP*elem->gradPhi[j];
 5828:          }
 5829: 
 5830:          
 5831:          const double htot  = side->htot2();        // Total depth at the side
 5832:          const double zctr2 = side->zTopCanopy();  
 5833: 
 5834:          double cff1; 
 5835:          double cff2; 
 5836:          double cff3;   
 5837:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 5838:          // coefficients applied to 2D/3D case 
 5839:             cff1 = side->hhat/htot;
 5840:             cff2 = 0.0;
 5841:             cff3 = 0.0;
 5842:          } else { //3D
 5843:             //Init for no-veg case
 5844:             cff1 = 1.0;
 5845:             cff2 = 1.0;
 5846:             cff3 = 0.0;
 5847: 
 5848:             if constexpr(iveg != 0) {
 5849:                // Computes coefficients used with vegetation terms G1, G2
 5850:                // cff1, cff3 are used for the first two terms in G1, G2:
 5851:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 5852:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 5853:                // In general, cff1*Ustar - cff3*Ustar_alpha
 5854:                if(veg_h < 0.99*htot) { // submergent vegetation
 5855:                   cff1=1;
 5856:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 5857:                   cff3 = veg_c;
 5858: 
 5859:                } else { // emergent vegetation
 5860:                   cff1 = 1.0/(1.0 + veg_c2);
 5861:                   cff2 = cff1;
 5862:                   cff3 = 0.0;
 5863: 
 5864:                }
 5865:             } // if iveg
 5866:          } //  2D/3D
 5867: 
 5868:          av_cff1 += cff1/i34;
 5869:          av_cff2 += cff2/i34;
 5870:          av_cff3 += cff3/i34;
 5871:          av_cff2_chi += cff2*chi/i34;
 5872:          av_cff3_chi += cff3*chi/i34;
 5873:          av_df += min(htot, veg_h)/(htot*i34);
 5874: 
 5875: 
 5876:          // btrack values: U^\star, U^{\star\alpha}
 5877:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 5878:          Vector2 Ustar       = {0.0, 0.0}; 
 5879:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 5880: 
 5881:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 5882:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 5883:          } else { //3D
 5884:             for (int k = side->kb; k < nvrt; k++) {
 5885:             
 5886:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 5887:                Ustar += w2;
 5888: 
 5889:                if constexpr(iveg != 0) {
 5890:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 5891:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 5892:                        Ustar_alpha += zrat*w2; // XXXX
 5893:                    }
 5894:                }  // if iveg
 5895:             }  // for k
 5896:          }  //2D/3D
 5897:          
 5898: 
 5899:          // Add btrack & surface stress terms to \breve{G} first
 5900:          if constexpr(ics==1) {
 5901:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 5902:          } else {
 5903:             // XXX IMPLEMENT THIS
 5904:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 5905:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 5906:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 5907:          }  // if ics
 5908: 
 5909:          // Surface and bottom stress terms
 5910:          if constexpr(ics==1) {
 5911:             const Vector2 tau    = side->tau();
 5912:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 5913: 
 5914:             // Term for surface and bottom stress
 5915:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 5916:          } else {
 5917:             // XXX IMPLEMENT THIS
 5918:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 5919:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 5920:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 5921:             // tau_x=(vn1+tt1)/2.d0
 5922:             // tau_y=(vn2+ss1)/2.d0
 5923:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 5924:          }  // if ics
 5925: 
 5926:          
 5927: 
 5928:          // All terms in F,F^\alpha,f_b except baroclinic
 5929:          // F, f_b: all explicit terms excluding vegetation 
 5930:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 5931:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 5932:          const double coriolis = side->coriolis;
 5933:          Vector2 F  =  coriolis*side->U;  // F_x
 5934:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 5935:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 5936: 
 5937:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 5938:             
 5939:             for (int k = side->kb; k < nvrt; k++) {
 5940:                if (zctr2 > side->zc[k-1]) {
 5941:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 5942:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5943:                    Fa +=  coriolis*w2*zrat;
 5944:                } // if zctr2
 5945:             } // k
 5946:          } // iveg
 5947: 
 5948:          // Integrate horizontal viscosity force vertically
 5949:          for (int k=side->kb + 1; k<nvrt; k++) {
 5950:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 5951: 
 5952:             F += levelHorVisc;
 5953: 
 5954:             // Vegetation term
 5955:             if constexpr(iveg!=0) {
 5956:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 5957:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 5958:                   Fa += levelHorVisc*zrat;
 5959:                } 
 5960:             } // if iveg
 5961:          } // for k
 5962: 
 5963:          fb += side->d2uv[side->kb];
 5964: 
 5965: 
 5966:          // Add to ghat1
 5967:          if constexpr(ics==2) {
 5968:             // XXX IMPLEMENT THIS
 5969:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5970:             // bigf1=vn1; bigf2=vn2
 5971:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5972:             // botf1=vn1; botf2=vn2
 5973:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 5974:             // bigfa1=vn1; bigfa2=vn2
 5975:          } // if ics
 5976: 
 5977:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 5978:       } // for j (nodes and sides)
 5979: 
 5980:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 5981:          
 5982:       // Finish off terms in F, F^\alpha and f_b
 5983:       const double grav3 = elem->mean(&Node::grav2);
 5984:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 5985: 
 5986: 
 5987:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 5988:       for (int j=1; j<i34; j++) { 
 5989:          // For each side in the element...
 5990:          const Side *side = elem->sides[j];
 5991:          const double chi = side->chi;
 5992: 
 5993:          const double htot = side->htot2();
 5994:          const double veg_h = side->veg_h();
 5995:          const Vector2 F  = htot*fb;
 5996:          const Vector2 Fa = min(htot, veg_h)*fb;
 5997: 
 5998:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 5999:       } // for j
 6000: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6001:       //botf1 etc are already in elem frame
 6002:       elem->ghat1 += tmp/i34;
 6003: 
 6004:       // Baroclinic force
 6005:       if constexpr(ibc==0) {
 6006:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6007: 
 6008:          Vector2 Fa = {0.0, 0.0};
 6009:          Vector2 intGradRho = {0.0, 0.0};
 6010:          
 6011:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6012:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6013:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6014: 
 6015:             // \in F [m^2/s/s]
 6016:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6017:          }
 6018: 
 6019:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6020:          const Vector2 F = av_df*Fa; //approx
 6021:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6022: 
 6023:       } // if ibc
 6024: 
 6025: 
 6026: 
 6027:    }
 6028: 
 6029: } // extern "C"
 6030: 
 6031: 
 6032: 
 6033: #ifdef DONTCOMPILE
 6034: __global__ void checkMassConservation(Tracers* sumtr) {
 6035: 
 6036:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6037: 
 6038:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6039: 
 6040:    Element *elem = &(mesh->localElemData[i]);
 6041: 
 6042:    // Skip dry elements
 6043:    if (elem->isDry) return;
 6044: 
 6045:    // Local sum array for this thread
 6046:    double localSum[N_TRACERS] = {0.0};
 6047: 
 6048:    // Sum over vertical levels for this element
 6049:    const int kbe = elem->kbe;
 6050:    const double area = elem->area;
 6051: 
 6052:    for (int k = kbe; k < nvrt; k++) {
 6053:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6054:       
 6055:       // Accumulate tracer mass
 6056:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6057:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6058:       }
 6059:    }
 6060: 
 6061:    
 6062: 
 6063:    //  This function returns per element sums. A reduction must be done on the host side.
 6064: }
 6065: 
 6066: 
 6067: __global__ void transport(void) {
 6068: 
 6069:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6070: 
 6071:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6072: 
 6073:    Element *elem = &(mesh->localElemData[ie]);
 6074: 
 6075:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6076: 
 6077:                for (int m=0; m<ntr; m++) {
 6078:                   for (int k=kbe(ie); k<nvrt; k++) {
 6079:                      // Calculate each polynomial's weight 
 6080:                      wm=0.d0; sum1=0.d0; 
 6081:                      wm1=0.d0; wm2=0.d0; 
 6082:                      for (int i=0; i<elem->nweno2; i++) {
 6083:                   
 6084:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6085:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6086:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6087:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6088:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6089:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6090:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6091:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6092:                      // -----------------Hu and Shu (1999)'s method----------------
 6093:                      b4=b1+b2+b3
 6094: 
 6095: //Error: add PRODUCTION CPP
 6096: #ifdef DEBUG
 6097:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6098:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6099:                     call parallel_abort(errmsg)
 6100:                   }
 6101: #endif
 6102: 
 6103:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6104:                   // !----test-------------- 
 6105:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6106:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6107:                   // !wm(i)=wm1(i)*wm2(i)
 6108:                   // !---------------------- 
 6109:                   sum1=sum1+wm(i)
 6110:                 } // end for i
 6111: 
 6112:                 wm=wm/sum1
 6113: 
 6114:                 for (int j=0; j<elem->i34; j++) {
 6115: 
 6116:                   const Side *side  = elem->sides[j];
 6117:                   const Node *node1 = side->n1;
 6118:                   const Node *node2 = side->n2;
 6119: 
 6120:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6121:                      trsd=0.d0
 6122:                      for (int kk=0; kk<nquad; kk++) {
 6123:                         for (int i=0; i<elem->nweno2; i++) {
 6124:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6125:                         } // end for i   
 6126:                      } // end for kk
 6127:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6128:                   } // outward flux
 6129:                } // end for j=1,i34(ie) ! side
 6130:             }
 6131:          }
 6132:               
 6133: 
 6134: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6135: //             //   calculate each polynomial's weight 
 6136: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6137: //                 wm=0.d0; sum1=0.d0
 6138: //                 do i=1,nweno1(ie) !for each polynomial
 6139: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6140: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6141: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6142: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6143: //                   wm(i)=b2
 6144: //                   sum1=sum1+b2
 6145: //                   !wm(i)=1.d0
 6146: //                   !sum1=sum1+1.d0
 6147: 
 6148: // // Error: PRODUCTION
 6149: // #ifdef DEBUG
 6150: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6151: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6152: //                     call parallel_abort(errmsg)
 6153: //                   endif
 6154: // #endif
 6155: 
 6156: //                 enddo !i
 6157: //                 wm=wm/sum1 !final weight
 6158: 
 6159:                 for (int j=0; j<elem->i34; j++) { // side
 6160:                   const Side *side = elem->sides[j];
 6161:                   const Node *node1 = side->n1;
 6162:                   const Node *node2 = side->n2;
 6163: 
 6164:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6165:                     trsd=0.d0
 6166:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6167:                       for (int i=0; i<elem->nweno1; i++) {
 6168:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6169:                       }
 6170:                     enddo //kk
 6171:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6172:                   } // outward flux
 6173:                 } // end for j=1,i34(ie) ! side
 6174:               } // end for k; ntr 
 6175: 
 6176:             else !simple upwind method
 6177:               do j=1,i34(ie)
 6178:                 jsj=elside(j,ie)
 6179:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6180:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6181:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6182:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6183:                   endif
 6184:                 enddo  !vertical layers
 6185:               enddo !j=1,i34(ie) ! side
 6186:             endif !order of accuracy
 6187: 
 6188:          //  enddo !ie
 6189: // !$OMP     end do
 6190: 
 6191: // !$OMP     master
 6192: //           !message passing
 6193: //           if (nproc>1) then
 6194: //             !make a copy of side concentrations
 6195: //             trsd_tmp0=trsd_tmp 
 6196: 
 6197: //             !this exchange routine swaps interface concentration between two partitions
 6198: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
