 8908:                    double *node_coords, double *node_coords_ll, bool use_ll,
 8909:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 8910:                    int *isdel, int *isidenode, int *isbnd,
 8911:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 8912:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8913:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8914:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8915:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8916:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8917:                    double *drag, double *roughness,
 8918:                    double *emo, double *efa, 
 8919:                    double *umo, double *ufa, 
 8920:                    double *vmo, double *vfa) {
 8921: 
 8922:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8923:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8924:                        isdel, isidenode, isbnd,
 8925:                        nond, nlnd, iond, ilnd, 
 8926:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8927:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8928:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8929:                        localNodeIndices, localElemIndices, localSideIndices,
 8930:                        localNodePart, localElemPart, localSidePart,
 8931:                        drag, roughness,
 8932:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8933:   }
