 2241:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2242:    // Project the vectors from the side frame to the element frame
 2243: 
 2244:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2245:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2246:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2247:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2248:       else          v[3] = Vector2();
 2249:    }
