 7908: __global__ void printMatrix(bool full) {
 7909:    // Debugging: print the matrix
 7910: 
 7911:    const int size = mesh->np;
 7912:    double sum = 0.0;
 7913:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7914:       const Node *node = mesh->localNodeData + idx_node;
 7915:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7916:       for (int j = 0; j < node->numNodes; j++) {
 7917:          Node* nbNode = node->nodes[j];
 7918:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7919:          sum += node->coeffMatrix[j];
 7920:       }
 7921:       if (full) printf("]\n");
 7922: 
 7923: 
 7924:    }
 7925:    if (!full) printf("sum=%lf\n", sum);
 7926: }
