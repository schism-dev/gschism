  169: struct Bool4 {
  170:    unsigned int m; // bit i = lane i
  171: 
  172:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  173:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  174: 
  175:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  176:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  177:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  178:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  179: 
  180: };
  181: 
  182: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  183: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  184: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
