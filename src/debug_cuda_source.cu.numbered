  319: // ------------------------------------------------------------------------------------------------
  320: 
  321: 
  322: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  323:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  324:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  325: }
  326: 
  327: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  328:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  329:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  330: }
  331: 
  332: 
  333: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  334:    x3 = y1*z2 - y2*z1;
  335:    y3 = x2*z1 - x1*z2;
  336:    z3 = x1*y2 - x2*y1;
  337: }
  338: 
  339: 
  340: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  341: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  342: 
  343:    const double radius2 = dot(p, p);
  344:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  345:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  346: 
  347:    rlon = atan2(p.y, p.x); // (-pi,pi]
  348: 
  349:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  350:       rlat = asin(p.z/sqrt(radius2));
  351:    } else {
  352:       rlat = asin(p.z/rearth_pole);
  353:    }
  354:   
  355: }
