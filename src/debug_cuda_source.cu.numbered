 2083:    template<typename T>
 2084:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2085: 
 2086:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2087: 
 2088:       // Get the values of the func at the nodes of the element
 2089:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2090:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2091:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2092:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2093:       else          res[3] = T();  // This is 0.0 or a zero vector
 2094: 
 2095:    }      
