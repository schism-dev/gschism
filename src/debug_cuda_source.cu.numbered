 4001:    //          do j=1,nond_global(k)
 4002:    //            icount2=icount2+1
 4003:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4004: 
 4005:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4006:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4007:    //          enddo !j
 4008:    //        endif
 4009:    //      enddo !k
 4010:    //    endif !nfltype2
 4011:    }
 4012: 
 4013: 
 4014:    __global__ void computeFlowBcVelocities(double time) {
 4015: 
 4016:       SIDE_BND(sideBnd);
 4017: 
 4018:       const Side *side = sideBnd->side;
 4019:  
 4020:       const bool isDry = side->isDry;
 4021: 
 4022:       if (isDry) {
 4023:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4024:          return;
 4025:       }
 4026: 
 4027:       // For wet sides in open boundaries...
 4028:       const Vector2 n = side->n;
 4029:       const BoundarySegment *segment = sideBnd->segment;
 4030: 
 4031:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4032: 
 4033:       const int ifltype = segment->ifltype;
 4034:       const int iettype = segment->iettype;
 4035: 
 4036:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4037:       const Vector2 r_nuth0 = r_uth0*n;
 4038: 
 4039:       for (int k = 0; k < nvrt; k++) {
 4040:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4041:          Vector2 r_u1_bar = {0.0, 0.0};
 4042:       
 4043:          if (ifltype == 1 || ifltype == 2) {
 4044:          
 4045:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4046: 
 4047:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4048:             
 4049:             r_uth = unth0*n;  // This case has no ramp-up
 4050:             
 4051:          } else if (ifltype == -1) { // Flather 1
 4052: 
 4053:             // uth is the normal vel.; no ramp up
 4054:             const double uth = sideBnd->nuth(k);
 4055:             r_uth = uth*n;
 4056:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4057: 
 4058: 
 4059:          } else if (ifltype == 3 || ifltype == 5) {
 4060:             // vnth0=0 !normal vel.
 4061: 
 4062:             // Computes the contribution to the velocity from all tide frequencies
 4063:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4064: 
 4065:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4066:                const Vector2 umo  = sideBnd->umo(jfr); 
 4067: 
 4068:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4069:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4070:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4071:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4072:             }
 4073: 
 4074:          } // if (ifltype = 3 || ifltype == 5
 4075: 
 4076: 
 4077:          switch (iettype) {
 4078:             case 1:
 4079:             case 2:
 4080:             case 4:
 4081:                sideBnd->ubc[k] = r_uth;
 4082:                break;
 4083:             case 3:
 4084:                sideBnd->ubc[k] = r_u1_bar;
 4085:                break;
 4086:             case 5:
 4087:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4088:                break;
 4089:          } // switch
 4090: 
 4091:       } // for k
 4092:    }
 4093: 
 4094:    __global__ void computeElevationBoundaryConditions(double time) {
 4095:       // Compute elevation essential boundary conditions 
 4096: 
 4097:       NODE_BND(nodeBnd); // Each boundary node.
 4098: 
 4099:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4100: 
 4101:       const Node *node = nodeBnd->node;
 4102:       const BoundarySegment *segment = nodeBnd->segment;
 4103:       const int iettype = segment->iettype;
 4104:       
 4105: 
 4106:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4107:       double eic = 0.0;
 4108:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4109:       else                 eic = 0.0;
 4110: 
 4111:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4112:       const double r_eth = ramp*nodeBnd->eth;
 4113:       double r_eta1_bar = 0.0;
 4114: 
 4115: 
 4116:       // Compute tide elevation
 4117:       if (iettype == 3 || iettype == 5) {   
 4118: 
 4119:          if constexpr(iloadtide==1) { // loading tide
 4120:             assert(false && "Loading tide not implemented");
 4121:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4122:          }
 4123:          
 4124:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4125: 
 4126:             const double efa  = nodeBnd->efa[jfr]; 
 4127:             const double emo  = nodeBnd->emo[jfr]; 
 4128: 
 4129:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4130:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4131:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4132: 
 4133:          } // for jfr
 4134: 
 4135:       } // if iettype
 4136: 
 4137:       switch (iettype) {
 4138:          case 1:
 4139:          case 2:
 4140:          case 4:
 4141:             nodeBnd->elbc = r_eic + r_eth;
 4142:             break;
 4143:          case 3:
 4144:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4145:             break;
 4146:          case 5:
 4147:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4148:             break;
 4149:       } // switch
 4150: 
 4151: 
 4152:       //Add inverse barometric effects
 4153:       if (iettype != 0 && inv_atm_bnd == 1) {
 4154:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4155:       }
 4156: 
 4157:    }
 4158: 
 4159: 
 4160:    __global__ void computeHorizontalViscosity(void) { 
 4161: 
 4162:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4163: 
 4164:       SIDE(side);
 4165: 
 4166:       if (side->isDry) return;
 4167: 
 4168:       for (int k = 0; k < nvrt; k++) {
 4169:          side->nuGradU[k] = {0.0, 0.0};
 4170:       }
 4171: 
 4172:       if constexpr(ihorcon == 1) {
 4173:          for (int k = side->kb; k < nvrt - 1; k++) {
 4174:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4175:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4176:             // By Zhang and Baptista.
 4177: 
 4178:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4179:             // This is a standard discretization of the Laplacian operator.
 4180:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4181:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4182:             // Gamma is hvis_coef0 in the code.
 4183:             // The value of gamma needs to be < 0.5.
 4184: 
 4185:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4186:             // side under consideration in each of the two possible elements that share the side.
 4187:             Vector2 sumU = {0.0, 0.0};
 4188:             for (int l = 0; l < 2; l++) {
 4189:                const Element *elem = side->elems[l];
 4190: 
 4191:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4192: 
 4193:                // Find the local index of the side in the element
 4194:                const int idxSide = elem->sideLocalIdx(side);
 4195:                // Find the two sides that are connected to the side under consideration
 4196:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4197:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4198: 
 4199:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4200: 
 4201:             }
 4202: 
 4203:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4204:    
 4205:          }
 4206:       }
 4207:       else if constexpr(ihorcon == 2) {
 4208:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4209:       }
 4210: 
 4211: 
 4212:    }
 4213: 
 4214: 
 4215:    __global__ void setEssentialBC(void) {
 4216:       // Set essential boundary conditions 
 4217:       NODE(node); // Each boundary node
 4218:       NodeBoundary *nodeBnd = node->nodeBnd;
 4219:       
 4220: // nodeBnd->isEssentialBC = true;      
 4221:       // Check if this node has essential BC
 4222:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4223:          // Verify BC value is valid
 4224:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4225: 
 4226:        
 4227:          // Set diagonal to 1 and zero off-diagonals
 4228:          node->coeffDiag = 1.0;
 4229: 
 4230:          for (int j = 0; j < node->numNodes; j++) {
 4231:                node->coeffMatrix[j] = 0.0;
 4232:          }
 4233:          
 4234:          // Set solution and RHS to BC value
 4235:          node->mX  = nodeBnd->elbc;
 4236:          node->qel = nodeBnd->elbc;
 4237: 
 4238:       } else {
 4239:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4240: 
 4241:          for (int j = 0; j < node->numNodes; j++) {
 4242:                Node* nbNode = node->nodes[j];
 4243:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4244:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4245:                   // Verify neighbor's BC value
 4246:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4247: 
 4248:                   // Subtract contribution to RHS
 4249:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4250:                   node->coeffMatrix[j] = 0.0;  
 4251:                }
 4252:          }
 4253:       }
 4254:    }
 4255: 
 4256: 
 4257:    __global__ void updateElevation(void) {
 4258:       NODE(node);
 4259: 
 4260:       node->eta2 = node->mX;
 4261: 
 4262:       node->updateZCoordData();
 4263:    }
 4264: 
