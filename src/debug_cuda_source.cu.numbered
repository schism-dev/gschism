 3897: __device__ __forceinline__ int Node::packedIndex() const {
 3898:    // Returns the packed index of the node
 3899:    // Packed index is the index of the partition-block matrices and vectors.
 3900:    return nodeOffsetPerPartition[part] + localIndex();
 3901: }
