  310: // Polynomial class
  311: template<int grade>
  312: struct Polynomial {
  313:     // Static assertion to give a clear error message at compile time
  314:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  315: };
  316: 
  317: 
  318: // Explicit specialization for grade 4
  319: template<>
  320: struct Polynomial<4> {
  321:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  322: 
  323:    // Constructor from coefficients
  324:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  325: 
  326:    __device__ __forceinline__ double eval(double x) const {
  327:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  328:    }
  329: };
