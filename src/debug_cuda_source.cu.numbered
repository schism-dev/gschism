 3974:    __global__ void computeFlowBcVelocities(double time) {
 3975: 
 3976:       SIDE_BND(sideBnd);
 3977: 
 3978:       const Side *side = sideBnd->side;
 3979:  
 3980:       const bool isDry = side->isDry;
 3981: 
 3982:       if (isDry) {
 3983:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 3984:          return;
 3985:       }
 3986: 
 3987:       // For wet sides in open boundaries...
 3988:       const Vector2 n = side->n;
 3989:       const BoundarySegment *segment = sideBnd->segment;
 3990: 
 3991:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 3992: 
 3993:       const int ifltype = segment->ifltype;
 3994:       const int iettype = segment->iettype;
 3995: 
 3996:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 3997:       const Vector2 r_nuth0 = r_uth0*n;
 3998: 
 3999:       for (int k = 0; k < nvrt; k++) {
 4000:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4001:          Vector2 r_u1_bar = {0.0, 0.0};
 4002:       
 4003:          if (ifltype == 1 || ifltype == 2) {
 4004:          
 4005:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4006: 
 4007:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4008:             
 4009:             r_uth = unth0*n;  // This case has no ramp-up
 4010:             
 4011:          } else if (ifltype == -1) { // Flather 1
 4012: 
 4013:             // uth is the normal vel.; no ramp up
 4014:             const double uth = sideBnd->nuth(k);
 4015:             r_uth = uth*n;
 4016:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4017: 
 4018: 
 4019:          } else if (ifltype == 3 || ifltype == 5) {
 4020:             // vnth0=0 !normal vel.
 4021: 
 4022:             // Computes the contribution to the velocity from all tide frequencies
 4023:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4024: 
 4025:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4026:                const Vector2 umo  = sideBnd->umo(jfr); 
 4027: 
 4028:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4029:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4030:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4031:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4032:             }
 4033: 
 4034:          } // if (ifltype = 3 || ifltype == 5
 4035: 
 4036: 
 4037:          switch (iettype) {
 4038:             case 1:
 4039:             case 2:
 4040:             case 4:
 4041:                sideBnd->ubc[k] = r_uth;
 4042:                break;
 4043:             case 3:
 4044:                sideBnd->ubc[k] = r_u1_bar;
 4045:                break;
 4046:             case 5:
 4047:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4048:                break;
 4049:          } // switch
 4050: 
 4051:       } // for k
 4052:    }
 4053: 
 4054:    __global__ void computeElevationBoundaryConditions(double time) {
 4055:       // Compute elevation essential boundary conditions 
 4056: 
 4057:       NODE_BND(nodeBnd); // Each boundary node.
 4058: 
 4059:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4060: 
 4061:       const Node *node = nodeBnd->node;
 4062:       const BoundarySegment *segment = nodeBnd->segment;
 4063:       const int iettype = segment->iettype;
 4064:       
 4065: 
 4066:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4067:       double eic = 0.0;
 4068:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4069:       else                 eic = 0.0;
 4070: 
 4071:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4072:       const double r_eth = ramp*nodeBnd->eth;
 4073:       double r_eta1_bar = 0.0;
 4074: 
 4075: 
 4076:       // Compute tide elevation
 4077:       if (iettype == 3 || iettype == 5) {   
 4078: 
 4079:          if constexpr(iloadtide==1) { // loading tide
 4080:             assert(false && "Loading tide not implemented");
 4081:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4082:          }
 4083:          
 4084:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4085: 
 4086:             const double efa  = nodeBnd->efa[jfr]; 
 4087:             const double emo  = nodeBnd->emo[jfr]; 
 4088: 
 4089:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4090:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4091:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4092: 
 4093:          } // for jfr
 4094: 
 4095:       } // if iettype
 4096: 
 4097:       switch (iettype) {
 4098:          case 1:
 4099:          case 2:
 4100:          case 4:
 4101:             nodeBnd->elbc = r_eic + r_eth;
 4102:             break;
 4103:          case 3:
 4104:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4105:             break;
 4106:          case 5:
 4107:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4108:             break;
 4109:       } // switch
 4110: 
 4111: 
 4112:       //Add inverse barometric effects
 4113:       if (iettype != 0 && inv_atm_bnd == 1) {
 4114:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4115:       }
 4116: 
 4117:    }
 4118: 
 4119: 
 4120:    __global__ void computeHorizontalViscosity(void) { 
 4121: 
 4122:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4123: 
 4124:       SIDE(side);
 4125: 
 4126:       if (side->isDry) return;
 4127: 
 4128:       for (int k = 0; k < nvrt; k++) {
 4129:          side->nuGradU[k] = {0.0, 0.0};
 4130:       }
 4131: 
 4132:       if constexpr(ihorcon == 1) {
 4133:          for (int k = side->kb; k < nvrt - 1; k++) {
 4134:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4135:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4136:             // By Zhang and Baptista.
 4137: 
 4138:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4139:             // This is a standard discretization of the Laplacian operator.
 4140:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4141:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4142:             // Gamma is hvis_coef0 in the code.
 4143:             // The value of gamma needs to be < 0.5.
 4144: 
 4145:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4146:             // side under consideration in each of the two possible elements that share the side.
 4147:             Vector2 sumU = {0.0, 0.0};
 4148:             for (int l = 0; l < 2; l++) {
 4149:                const Element *elem = side->elems[l];
 4150: 
 4151:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4152: 
 4153:                // Find the local index of the side in the element
 4154:                const int idxSide = elem->sideLocalIdx(side);
 4155:                // Find the two sides that are connected to the side under consideration
 4156:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4157:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4158: 
 4159:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4160: 
 4161:             }
 4162: 
 4163:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4164:    
 4165:          }
 4166:       }
 4167:       else if constexpr(ihorcon == 2) {
 4168:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4169:       }
 4170: 
 4171: 
 4172:    }
 4173: 
 4174: 
 4175:    __global__ void setEssentialBC(void) {
 4176:       // Set essential boundary conditions 
 4177:       NODE(node); // Each boundary node
 4178:       NodeBoundary *nodeBnd = node->nodeBnd;
 4179:       
 4180: // nodeBnd->isEssentialBC = true;      
 4181:       // Check if this node has essential BC
 4182:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4183:          // Verify BC value is valid
 4184:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4185: 
 4186:        
 4187:          // Set diagonal to 1 and zero off-diagonals
 4188:          node->coeffDiag = 1.0;
 4189: 
 4190:          for (int j = 0; j < node->numNodes; j++) {
 4191:                node->coeffMatrix[j] = 0.0;
 4192:          }
 4193:          
 4194:          // Set solution and RHS to BC value
 4195:          node->mX  = nodeBnd->elbc;
 4196:          node->qel = nodeBnd->elbc;
 4197: 
 4198:       } else {
 4199:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4200: 
 4201:          for (int j = 0; j < node->numNodes; j++) {
 4202:                Node* nbNode = node->nodes[j];
 4203:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4204:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4205:                   // Verify neighbor's BC value
 4206:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4207: 
 4208:                   // Subtract contribution to RHS
 4209:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4210:                   node->coeffMatrix[j] = 0.0;  
 4211:                }
 4212:          }
 4213:       }
 4214:    }
 4215: 
 4216: 
 4217:    __global__ void updateElevation(void) {
 4218:       NODE(node);
 4219: 
 4220:       node->eta2 = node->mX;
 4221: 
 4222:       node->updateZCoordData();
 4223:    }
 4224: 
