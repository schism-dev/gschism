 5835: //           swild(2,:,1:npa)=vv2(:,:)
 5836: //           swild(3,:,1:npa)=tr_nd(1,:,:) !tnd(:,:)
 5837: //           swild(4,:,1:npa)=tr_nd(2,:,:) !snd(:,:)
 5838: 
 5839:  
 5840: //           uu2(:,:)=swild(1,:,1:npa)
 5841: //           vv2(:,:)=swild(2,:,1:npa)
 5842: //           tr_nd(1,:,:)=swild(3,:,1:npa)
 5843: //           tr_nd(2,:,:)=swild(4,:,1:npa)
 5844: 
 5845: //         endif !prwt_xchng_gb
 5846: //       endif !nproc>1
 5847: 
 5848: //       close(10)
 5849: 
 5850: //       // Update wet/dry flags
 5851: //       idry=idry2
 5852: //       idry_s=idry_s2
 5853: //       idry_e=idry_e2
 5854: 
 5855: 
 5856: 
 5857: // !===============================================================================
 5858: // !===============================================================================
 5859: 
 5860: } // extern "C"
 5861: 
 5862: #ifdef DONTCOMPILE
 5863: __device__ void computeVerticalAdvection(void) {
 5864:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 5865: 
 5866:    sdbt(1:2,:,:)=0.d0
 5867: 
 5868:    const Side *side = FROM kernel;
 5869: 
 5870:    if(side->isDry) return;
 5871: 
 5872:    // If side is wet...
 5873: 
 5874: 
 5875:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 5876:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 5877:    double ws[nvrt] = {} // w @ side
 5878:    int icount = 0;
 5879:    for (int j=0; j<2; j++) {
 5880:       const Element *elem = side->elements[j];
 5881:        
 5882:       if(elem != nullptr) {
 5883:          icount++;
 5884:          for (int k=0; k<nvrt; k++) {
 5885:             ws[k] = ws[k] + elem->w[k];
 5886:          }
 5887:       }
 5888:    }  // for j
 5889: 
 5890:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 5891:    ws = ws/icount;
 5892: 
 5893:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 5894:    // Splines allow for a smooth transition between vertical levels.
 5895:    // Splines have continuity restrictions at the internal knots, but
 5896:    // we have to provide the 1st derivatives at the endpoints.
 5897:    const int kbs = side->kbs; 
 5898:    
 5899:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5900:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5901:    initCubicSpline(kbs, nvrt, side, ws, up)
 5902: 
 5903:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 5904:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 5905:    initCubicSpline(kbs, nvrt, side, ws, vp)
 5906: 
 5907:    // Total advection (average onto side)
 5908:    const Node *node1 = side->nodes[0];
 5909:    const Node *node2 = side->nodes[1];
 5910:    for (int k=kbs(i); k<nvrt; k++) {
 5911: 
 5912:       if constexpr(ics==1) {
 5913:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 5914:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 5915:       } else {
 5916:          // XXX IMPLEMENT THIS
 5917:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 5918:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 5919:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 5920:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 5921:       }  // if ics
 5922: 
 5923: 
 5924:    }
 5925: }
 5926: #endif
 5927: 
 5928: 
 5929: extern "C" {
 5930:    __global__ void computeElemAverageGhat(void) {
 5931:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 5932: 
 5933:       ELEM(elem);
 5934:       
 5935:       elem->ghat1= {0.0, 0.0};  
 5936: 
 5937:       if constexpr(ihydraulics != 0) {
 5938:          if (nhtblocks > 0 && elem->isblock) return;
 5939:       }
 5940: 
 5941:       if (elem->isDry) return;
 5942: 
 5943:       // Wet elements.
 5944:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 5945:       // tidal potential, horizontal diffusion, and baroclinic etc
 5946:       // Remember to update both fb and F 
 5947:       // If ics=2, ghat1 are in eframe (ll)
 5948:       // cff1-3: coefficients for 2D/3D
 5949:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 5950:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 5951:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 5952: 
 5953:       double av_cff1 = 0.0;  // av. for cff1
 5954:       double av_cff2 = 0.0;  // av. for cff2
 5955:       double av_cff3 = 0.0;  // av. for cff3
 5956:       double av_df = 0.0;  // av. for H^\alpha / H
 5957:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 5958:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 5959: 
 5960:       const int i34 = elem->i34;
 5961:       const int kb = elem->kb;
 5962: 
 5963:       for (int j=1; j<i34; j++) {
 5964:          // For each node and side in the element...
 5965: 
 5966:          const Node *node = elem->nodes[j];
 5967:          const Side *side = elem->sides[j];
 5968: 
 5969:          const double chi      = side->chi;
 5970:          const double veg_c2   = side->veg_c2;
 5971:          const double veg_beta = side->veg_beta;
 5972:          const double veg_h    = side->veg_h();
 5973:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 5974: 
 5975:          // Node - const in elem
 5976:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 5977:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 5978: 
 5979:          if (elem->depth >= tip_dp) {
 5980:            elem->gradETP += node->ETP*elem->gradPhi[j];
 5981:          }
 5982: 
 5983:          
 5984:          const double htot  = side->htot2();        // Total depth at the side
 5985:          const double zctr2 = side->zTopCanopy();  
 5986: 
 5987:          double cff1; 
 5988:          double cff2; 
 5989:          double cff3;   
 5990:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 5991:          // coefficients applied to 2D/3D case 
 5992:             cff1 = side->hhat/htot;
 5993:             cff2 = 0.0;
 5994:             cff3 = 0.0;
 5995:          } else { //3D
 5996:             //Init for no-veg case
 5997:             cff1 = 1.0;
 5998:             cff2 = 1.0;
 5999:             cff3 = 0.0;
 6000: 
 6001:             if constexpr(iveg != 0) {
 6002:                // Computes coefficients used with vegetation terms G1, G2
 6003:                // cff1, cff3 are used for the first two terms in G1, G2:
 6004:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6005:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6006:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6007:                if(veg_h < 0.99*htot) { // submergent vegetation
 6008:                   cff1=1;
 6009:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6010:                   cff3 = veg_c;
 6011: 
 6012:                } else { // emergent vegetation
 6013:                   cff1 = 1.0/(1.0 + veg_c2);
 6014:                   cff2 = cff1;
 6015:                   cff3 = 0.0;
 6016: 
 6017:                }
 6018:             } // if iveg
 6019:          } //  2D/3D
 6020: 
 6021:          av_cff1 += cff1/i34;
 6022:          av_cff2 += cff2/i34;
 6023:          av_cff3 += cff3/i34;
 6024:          av_cff2_chi += cff2*chi/i34;
 6025:          av_cff3_chi += cff3*chi/i34;
 6026:          av_df += min(htot, veg_h)/(htot*i34);
 6027: 
 6028: 
 6029:          // btrack values: U^\star, U^{\star\alpha}
 6030:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6031:          Vector2 Ustar       = {0.0, 0.0}; 
 6032:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6033: 
 6034:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6035:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6036:          } else { //3D
 6037:             for (int k = side->kb; k < nvrt; k++) {
 6038:             
 6039:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6040:                Ustar += w2;
 6041: 
 6042:                if constexpr(iveg != 0) {
 6043:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6044:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6045:                        Ustar_alpha += zrat*w2; // XXXX
 6046:                    }
 6047:                }  // if iveg
 6048:             }  // for k
 6049:          }  //2D/3D
 6050:          
 6051: 
 6052:          // Add btrack & surface stress terms to \breve{G} first
 6053:          if constexpr(ics==1) {
 6054:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6055:          } else {
 6056:             // XXX IMPLEMENT THIS
 6057:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6058:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6059:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6060:          }  // if ics
 6061: 
 6062:          // Surface and bottom stress terms
 6063:          if constexpr(ics==1) {
 6064:             const Vector2 tau    = side->tau();
 6065:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6066: 
 6067:             // Term for surface and bottom stress
 6068:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6069:          } else {
 6070:             // XXX IMPLEMENT THIS
 6071:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6072:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6073:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6074:             // tau_x=(vn1+tt1)/2.d0
 6075:             // tau_y=(vn2+ss1)/2.d0
 6076:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6077:          }  // if ics
 6078: 
 6079:          
 6080: 
 6081:          // All terms in F,F^\alpha,f_b except baroclinic
 6082:          // F, f_b: all explicit terms excluding vegetation 
 6083:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6084:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6085:          const double coriolis = side->coriolis;
 6086:          Vector2 F  =  coriolis*side->U;  // F_x
 6087:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6088:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6089: 
 6090:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6091:             
 6092:             for (int k = side->kb; k < nvrt; k++) {
 6093:                if (zctr2 > side->zc[k-1]) {
 6094:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6095:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6096:                    Fa +=  coriolis*w2*zrat;
 6097:                } // if zctr2
 6098:             } // k
 6099:          } // iveg
 6100: 
 6101:          // Integrate horizontal viscosity force vertically
 6102:          for (int k=side->kb + 1; k<nvrt; k++) {
 6103:             const Vector2 levelHorVisc = side->Dz(k)*(side->d2uv[k] + side->d2uv[k-1])/2.0; 
 6104: 
 6105:             F += levelHorVisc;
 6106: 
 6107:             // Vegetation term
 6108:             if constexpr(iveg!=0) {
 6109:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6110:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6111:                   Fa += levelHorVisc*zrat;
 6112:                } 
 6113:             } // if iveg
 6114:          } // for k
 6115: 
 6116:          fb += side->d2uv[side->kb];
 6117: 
 6118: 
 6119:          // Add to ghat1
 6120:          if constexpr(ics==2) {
 6121:             // XXX IMPLEMENT THIS
 6122:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6123:             // bigf1=vn1; bigf2=vn2
 6124:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6125:             // botf1=vn1; botf2=vn2
 6126:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6127:             // bigfa1=vn1; bigfa2=vn2
 6128:          } // if ics
 6129: 
 6130:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6131:       } // for j (nodes and sides)
 6132: 
 6133:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6134:          
 6135:       // Finish off terms in F, F^\alpha and f_b
 6136:       const double grav3 = elem->mean(&Node::grav2);
 6137:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6138: 
 6139: 
 6140:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6141:       for (int j=1; j<i34; j++) { 
 6142:          // For each side in the element...
 6143:          const Side *side = elem->sides[j];
 6144:          const double chi = side->chi;
 6145: 
 6146:          const double htot = side->htot2();
 6147:          const double veg_h = side->veg_h();
 6148:          const Vector2 F  = htot*fb;
 6149:          const Vector2 Fa = min(htot, veg_h)*fb;
 6150: 
 6151:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6152:       } // for j
 6153: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6154:       //botf1 etc are already in elem frame
 6155:       elem->ghat1 += tmp/i34;
 6156: 
 6157:       // Baroclinic force
 6158:       if constexpr(ibc==0) {
 6159:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6160: 
 6161:          Vector2 Fa = {0.0, 0.0};
 6162:          Vector2 intGradRho = {0.0, 0.0};
 6163:          
 6164:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6165:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6166:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6167: 
 6168:             // \in F [m^2/s/s]
 6169:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6170:          }
 6171: 
 6172:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6173:          const Vector2 F = av_df*Fa; //approx
 6174:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6175: 
 6176:       } // if ibc
 6177: 
 6178: 
 6179: 
 6180:    }
 6181: 
 6182: } // extern "C"
 6183: 
 6184: 
 6185: 
 6186: #ifdef DONTCOMPILE
 6187: __global__ void checkMassConservation(Tracers* sumtr) {
 6188: 
 6189:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6190: 
 6191:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6192: 
 6193:    Element *elem = &(mesh->localElemData[i]);
 6194: 
 6195:    // Skip dry elements
 6196:    if (elem->isDry) return;
 6197: 
 6198:    // Local sum array for this thread
 6199:    double localSum[N_TRACERS] = {0.0};
 6200: 
 6201:    // Sum over vertical levels for this element
 6202:    const int kbe = elem->kbe;
 6203:    const double area = elem->area;
 6204: 
 6205:    for (int k = kbe; k < nvrt; k++) {
 6206:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6207:       
 6208:       // Accumulate tracer mass
 6209:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6210:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6211:       }
 6212:    }
 6213: 
 6214:    
 6215: 
 6216:    //  This function returns per element sums. A reduction must be done on the host side.
 6217: }
 6218: 
 6219: 
 6220: __global__ void transport(void) {
 6221: 
 6222:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6223: 
 6224:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6225: 
 6226:    Element *elem = &(mesh->localElemData[ie]);
 6227: 
 6228:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6229: 
 6230:                for (int m=0; m<ntr; m++) {
 6231:                   for (int k=kbe(ie); k<nvrt; k++) {
 6232:                      // Calculate each polynomial's weight 
 6233:                      wm=0.d0; sum1=0.d0; 
 6234:                      wm1=0.d0; wm2=0.d0; 
 6235:                      for (int i=0; i<elem->nweno2; i++) {
 6236:                   
 6237:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6238:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6239:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6240:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6241:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6242:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6243:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6244:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6245:                      // -----------------Hu and Shu (1999)'s method----------------
 6246:                      b4=b1+b2+b3
 6247: 
 6248: //Error: add PRODUCTION CPP
 6249: #ifdef DEBUG
 6250:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6251:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6252:                     call parallel_abort(errmsg)
 6253:                   }
 6254: #endif
 6255: 
 6256:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6257:                   // !----test-------------- 
 6258:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6259:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6260:                   // !wm(i)=wm1(i)*wm2(i)
 6261:                   // !---------------------- 
 6262:                   sum1=sum1+wm(i)
 6263:                 } // end for i
 6264: 
 6265:                 wm=wm/sum1
 6266: 
 6267:                 for (int j=0; j<elem->i34; j++) {
 6268: 
 6269:                   const Side *side  = elem->sides[j];
 6270:                   const Node *node1 = side->n1;
 6271:                   const Node *node2 = side->n2;
 6272: 
 6273:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6274:                      trsd=0.d0
 6275:                      for (int kk=0; kk<nquad; kk++) {
 6276:                         for (int i=0; i<elem->nweno2; i++) {
 6277:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6278:                         } // end for i   
 6279:                      } // end for kk
 6280:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6281:                   } // outward flux
 6282:                } // end for j=1,i34(ie) ! side
 6283:             }
 6284:          }
