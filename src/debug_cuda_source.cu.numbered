 1977: struct Mesh {
 1978:    public:  
 1979: 
 1980:    int partNum; // Partition number for this mesh.
 1981: 
 1982:    // Pointers to each GPU's local memory (size is the number of partitions).
 1983:    Node**    nodes;  
 1984:    Element** elems;  
 1985:    Side**    sides;  
 1986:    
 1987:    // Local memory
 1988:    Node*    localNodeData; 
 1989:    Element* localElemData;
 1990:    Side*    localSideData; 
 1991: 
 1992:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1993:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1994:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1995:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1996:    
 1997:    const int npgb;  // Global number of horizontal nodes
 1998:    const int negb;  // Global number of elements
 1999:    const int nsgb;  // Global number of sides
 2000: 
 2001:    const int np;   // Local number of horizontal nodes 
 2002:    const int ne;   // Local number of elements
 2003:    const int ns;   // Local number of sides
 2004: 
 2005:    int nbp;  // Local number of boundary nodes
 2006:    int nbs;  // Local number of boundary sides
 2007: 
 2008:    int nEntries;  // Total number of matrix elements
 2009: 
 2010:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 2011:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 2012:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 2013: 
 2014:   
 2015:    // Additional topology information
 2016:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 2017:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 2018:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 2019: 
 2020:    BoundarySegment *landBoundarySegment;
 2021:    NodeBoundary *landBoundaryNode;
 2022: 
 2023:    // Vertical coordinate system
 2024:    // Sigma levels
 2025:    double h_s; 
 2026:    double h_c; 
 2027: 
 2028:    double theta_b;
 2029:    double theta_f, sinh_theta_f;
 2030:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 2031:    double *ztot;
 2032:    double *cs;
 2033:    double *dcs;
 2034: 
 2035: 
 2036: 
 2037:    __device__ Mesh(int partNum,
 2038:                    int npgb, int negb, int nsgb, 
 2039:                    int np, int ne, int ns,
 2040:                    int max_np, int max_ne, int max_ns, int nseg,
 2041:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 2042:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 2043:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 2044:                    Node    **localNodeNeighNodesMem,
 2045:                    Element **localNodeNeighElemsMem,
 2046:                    int16_t *localNodePermutationSortMem,
 2047:                    double *partCoeffMatrixMem,
 2048:                    NodeBoundary *localNodeBoundaryMem,
 2049:                    SideBoundary *localSideBoundaryMem,
 2050:                    BoundarySegment *localSegmentMem,
 2051:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 2052:                    double *cs, double *dcs
 2053:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 2054:                        np(np), ne(ne), ns(ns),
 2055:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 2056:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 2057:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 2058:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 2059:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 2060:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 2061:                        localSegmentMem(localSegmentMem),
 2062:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 2063:                        cs(cs), dcs(dcs),
 2064:                        landBoundarySegment(plandSegMem),
 2065:                        landBoundaryNode(plandNodeBndMem)
 2066:    {
 2067:       printf("Mesh constructor for partition %d\n", partNum);
 2068: 
 2069:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 2070:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 2071:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 2072:  
 2073:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2074:       
 2075:       sinh_theta_f = sinh(theta_f);
 2076: 
 2077:       *landBoundaryNode    = NodeBoundary(true);
 2078:       *landBoundarySegment = BoundarySegment(true);   
