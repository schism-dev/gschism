 6266: #ifdef DONTCOMPILE
 6267: __device__ void computeVerticalAdvection(void) {
 6268:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6269: 
 6270:    sdbt(1:2,:,:)=0.d0
 6271: 
 6272:    const Side *side = FROM kernel;
 6273: 
 6274:    if(side->isDry) return;
 6275: 
 6276:    // If side is wet...
 6277: 
 6278: 
 6279:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6280:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6281:    double ws[nvrt] = {} // w @ side
 6282:    int icount = 0;
 6283:    for (int j=0; j<2; j++) {
 6284:       const Element *elem = side->elements[j];
 6285:        
 6286:       if(elem != nullptr) {
 6287:          icount++;
 6288:          for (int k=0; k<nvrt; k++) {
 6289:             ws[k] = ws[k] + elem->w[k];
 6290:          }
 6291:       }
 6292:    }  // for j
 6293: 
 6294:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6295:    ws = ws/icount;
 6296: 
 6297:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6298:    // Splines allow for a smooth transition between vertical levels.
 6299:    // Splines have continuity restrictions at the internal knots, but
 6300:    // we have to provide the 1st derivatives at the endpoints.
 6301:    const int kbs = side->kbs; 
 6302:    
 6303:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6304:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6305:    initCubicSpline(kbs, nvrt, side, ws, up)
 6306: 
 6307:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6308:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6309:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6310: 
 6311:    // Total advection (average onto side)
 6312:    const Node *node1 = side->nodes[0];
 6313:    const Node *node2 = side->nodes[1];
 6314:    for (int k=kbs(i); k<nvrt; k++) {
 6315: 
 6316:       if constexpr(ics==1) {
 6317:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6318:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6319:       } else {
 6320:          // XXX IMPLEMENT THIS
 6321:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6322:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6323:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6324:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6325:       }  // if ics
 6326: 
 6327: 
 6328:    }
 6329: }
 6330: #endif
