 2555: __device__ void Node::updateKb(void) {
 2556: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2557: 
 2558:    if constexpr(ivcor == 1) return;
 2559: 
 2560: 
 2561:    // Check if node is wet
 2562:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2563: 
 2564:    if (isDry) return;
 2565: 
 2566:    if constexpr(ivcor == 2) {  // SZ coordinates
 2567:       
 2568:       // Compute bottom level index
 2569:       if (depth <= mesh->h_s) {
 2570:          kb = mesh->kz - 1;
 2571:       } else {
 2572:          kb = -1;
 2573:          int L = 0;
 2574:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2575:          
 2576:          while (L <= R) {
 2577:             int M = (R + L) / 2;
 2578: 
 2579:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2580:             
 2581:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2582:                R = M;
 2583:             } else {
 2584:                L = M;
 2585:             }
 2586: 
 2587:             if (R - L == 1) {
 2588:                kb = L;
 2589:                break;
 2590:             }
 2591:          }
 2592:       }
 2593:    } 
 2594: }
 2595: 
 2596: 
 2597: __device__ double Node::compZCoord(int k) const {
 2598:    // Computes the z coordinate at level k.
 2599:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2600:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2601:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2602:    // used 
 2603:    
 2604:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2605:       
 2606: printf("htot2() = %e\n",htot2());      
 2607:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2608: 
 2609:    if constexpr(ivcor == 2) {
 2610: 
 2611:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2612:       const int kz = mesh->kz;
 2613:       const double h_c = mesh->h_c;
 2614:       const double theta_f = mesh->theta_f;
 2615:       const double sinh_theta_f = mesh->sinh_theta_f;
 2616: 
 2617:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2618:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2619:       // once per time step/node.
 2620:       // CHECK: updateZCoordData
 2621: 
 2622:       if      (k == nvrt-1)      { return eta2; }
 2623:       else if (k == kz)          return -hmod2;
 2624:       else if (k == kb)          return -depth;
 2625:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2626:       else if (k > kz) {
 2627:          const int ksig = k - kz + 1;
 2628: 
 2629:          if (hmod2 <= h_c) {
 2630:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2631:          } 
 2632:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2633:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2634:             assert(false && "ZCOOR: invalid h_c\n");
 2635:          } 
 2636:          else {
 2637:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2638:                          h_c * mesh->sigma[ksig] + 
 2639:                          (hmod2 - h_c) * mesh->cs[ksig];
 2640:          }
 2641:       } else { 
 2642:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2643:       }
 2644: 
 2645:    }
 2646:    else if constexpr(ivcor == 1) {
 2647:       if (k == kb) return -depth;
 2648:       else if (k == nvrt-1) return eta2;
 2649:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2650:    }
 2651:    
 2652:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2653:    return 0.0;
 2654: }
 2655: 
 2656: 
 2657: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2658:    // Checks if a side in on the boundary
 2659:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2660: 
 2661:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2662:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2663: 
 2664:    // Indices of the nodes that form the side
 2665:    const int n1 = side.n1->idx;
 2666:    const int n2 = side.n2->idx;
 2667: 
 2668:    // Check if the side is on a land boundary
 2669:    for (int i = 0; i < nland; i++) {
 2670:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2671:          // Consecutive nodes in the land boundary segment
 2672:          const int b1 = ilnd[i*mnlnd + j];
 2673:          const int b2 = ilnd[i*mnlnd + j + 1];
 2674: 
 2675:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2676:             isLand = true;
 2677:             return i;
 2678:          }
 2679:       }
 2680:    }
 2681: 
 2682:    // Check if the side is on an open boundary
 2683:    for (int i = 0; i < nope; i++) {
 2684:       for (int j = 0; j < nond[i] - 1; j++) {
 2685:          // Consecutive nodes in the open boundary segment
 2686:          const int b1 = iond[i*mnond + j];
 2687:          const int b2 = iond[i*mnond + j + 1];
 2688: 
 2689:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2690:             isLand = false;
 2691:             return i;
 2692:          }
 2693:       }
 2694:    }
 2695:    return -1;
 2696: }
 2697: 
 2698: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2699:                 double *node_coords, double *wind_rotate_angle, 
 2700:                 int *isdel, int *isidenode, int *isbnd,
 2701:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2702:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2703:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2704:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2705:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2706:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2707:                 double *emo, double *efa, 
 2708:                 double *umo, double *ufa, 
 2709:                 double *vmo, double *vfa) {
 2710: 
 2711:    printf("Populating mesh for partition %d\n", partNum);
 2712: 
 2713:    // Horizontal grid
 2714:    printf("Processing %d nodes\n", np);    
 2715: 
 2716: 
 2717:    int idxNodeBoundary = 0;  
 2718:    for (int i = 0; i < np; i++)
 2719:    {
 2720:       Node &node = localNodeData[i];
 2721: 
 2722:       node.idx = i;
 2723: 
 2724:       const int idxNodeStart = nodeNeighNodesStart[i];
 2725:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2726:       node.numNodes = idxNodeEnd - idxNodeStart;
 2727:       node.nodes = nodeNeighNodes + idxNodeStart;
 2728:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2729: 
 2730: 
 2731: 
 2732:       const int idxElemStart = nodeNeighElemsStart[i];
 2733:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2734:       node.numElements = idxElemEnd - idxElemStart;
 2735:       node.elements = nodeNeighElems + idxElemStart;
 2736: 
 2737: 
 2738:       
 2739:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2740:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2741:          const int partNode = localNodePart[idxNodeGlobal]; 
 2742:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2743: 
 2744: 
 2745:          Node *node_ptr = nodes[partNode] + idxNode;
 2746:          
 2747:          nodeNeighNodes[idx] = node_ptr;
 2748:       }
 2749: 
 2750:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2751:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2752:          const int partElem = localElemPart[idxElemGlobal];
 2753:          const int idxElem  = localElemIndices[idxElemGlobal];
 2754: 
 2755:          Element *elem_ptr = elems[partElem] + idxElem;
 2756: 
 2757:          nodeNeighElems[idx] = elem_ptr;
 2758:       }      
 2759: 
 2760: 
 2761:       node.wind_angle = wind_rotate_angle[i];
 2762: 
 2763:       // Element **elements; // pointer to the elements connected to this node
 2764:       // int numElements;   // number of elements shared by this node
 2765: 
 2766:       node.p.x   = node_coords[i * 3];
 2767:       node.p.y   = node_coords[i * 3 + 1];
 2768:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2769:       node.depth = node_coords[i * 3 + 2];
 2770: 
 2771:       node.numSides = 0;
 2772: 
 2773: 
 2774:       // Links the node to the boundary information
 2775:       if (isbnd[i] >= 0) {
 2776:        
 2777:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2778:          node.nodeBnd->node = &node;
 2779: 
 2780:          node.nodeBnd->sideBnd1 = nullptr;
 2781:          node.nodeBnd->sideBnd2 = nullptr;
 2782: 
 2783:          if (isbnd[i]>=0) {
 2784: 
 2785:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2786:             
 2787:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2788:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2789: 
 2790:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2791:             node.nodeBnd->segment->clen  = nan("1");
 2792:             node.nodeBnd->segment->carea = nan("1");
 2793: 
 2794:          }
 2795: //          else {
 2796: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2797: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2798: //          }
 2799:          
 2800:          idxNodeBoundary++;
 2801:       }
 2802:       else {
 2803:          node.nodeBnd = nullptr; // For internal nodes
 2804: 
 2805:          if (isbnd[i] == landSegment) {
 2806:             node.nodeBnd = &landBoundaryNode;
 2807:             node.nodeBnd->segment = &landBoundarySegment;
 2808:          }
 2809:          // node.nodeBnd->node = &node;
 2810:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2811:          // // node.nodeBnd = nullptr;
 2812:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2813:         
 2814:       }
 2815: 
 2816:       // XXXX GAUSSIAN HILL VELOCITIES
 2817: #ifdef GAUSSIAN_HILL_VELOCITIES
 2818:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2819:          constexpr double rot_per = 3000.0;
 2820:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2821:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2822:       // XXXXX
 2823: #endif
 2824:    }
 2825: 
 2826:    nbp = idxNodeBoundary;
 2827: 
 2828:    printf("Processing %d sides\n", ns);
 2829:    int idxSideBoundary = 0;
 2830:    for (int i = 0; i < ns; i++)
 2831:    {
 2832:       Side &side = localSideData[i];
 2833:       side.idx = i;
 2834:       // finding the pointer to the nodes that form the side
 2835:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2836:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2837: 
 2838:       const int locidx_n1 = localNodeIndices[idx_n1];
 2839:       const int locidx_n2 = localNodeIndices[idx_n2];
 2840:       const int part_n1 =   localNodePart[idx_n1];
 2841:       const int part_n2 =   localNodePart[idx_n2];
 2842: 
 2843:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2844:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2845: 
 2846:       // Counts the number of sides connected to each node
 2847:       side.n1->numSides++;
 2848:       side.n2->numSides++;
 2849: 
 2850:       // Normal, unitary vector to the side
 2851:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2852:       side.n = normalize(side.n);
 2853: 
 2854:       // Side boundary type
 2855:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2856:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2857: 
 2858:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2859:       // If both nodes are on the boundary, then the side may be on the boundary
 2860:       {
 2861:          bool isLand = false;
 2862:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2863: 
 2864:          if (isbs > -1) {
 2865:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2866:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2867:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2868: 
 2869:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2870:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2871:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2872: 
 2873:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2874:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2875:           
 2876:             side.sideBnd->side = &side;
 2877:             idxSideBoundary++;
 2878: 
 2879:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2880:          }
 2881:          
 2882: 
 2883:       // }
 2884:       // 
 2885: 
 2886: 
 2887: 
 2888: 
 2889: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2890: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2891: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2892: //       {
 2893: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2894: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2895: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2896: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2897: // if (side.sideBnd->segment == nullptr) continue;
 2898: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2899: //          else                  side.sideBnd->segment = n2bnd->segment;
 2900: //          side.sideBnd->side = &side;
 2901: //          idxSideBoundary++;
 2902: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2903:       }
 2904:       else side.sideBnd = nullptr;
 2905: 
 2906:       nbs = idxSideBoundary;
 2907: 
 2908:       // finding the pointer to the elements that share the side
 2909:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2910:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2911: 
 2912:       if (idx_e1 > -1) {
 2913:          const int locidx_e1 = localElemIndices[idx_e1];
 2914:          const int part_e1 =  localElemPart[idx_e1];
 2915:          side.elems[0] = elems[part_e1] + locidx_e1;
 2916: 
 2917:       }
 2918:       else {
 2919:          side.elems[0] = nullptr;
 2920:       }
 2921: 
 2922:       if (idx_e2 > -1) {
 2923:          const int locidx_e2 = localElemIndices[idx_e2];
 2924:          const int part_e2 =  localElemPart[idx_e2];
 2925:          side.elems[1] = elems[part_e2] + locidx_e2;
 2926:       }
 2927:       else {
 2928:          side.elems[1] = nullptr;
 2929:       }
 2930: 
 2931:       // Compute the center of the side
 2932:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2933: 
 2934:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2935:       side.shapiro = shapiro0;
 2936: 
 2937: #ifdef GAUSSIAN_HILL_VELOCITIES
 2938: // XXXX
 2939: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2940: constexpr double rot_per=3000.0;
 2941: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2942: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2943: // XXXXX      
 2944: #endif
 2945:       // Compute the z level at the center of the side
 2946:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2947: 
 2948:       // Compute the length of the side
 2949:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2950:       side.len = sqrt(dot(vLen, vLen));
 2951: 
 2952:    }
 2953: 
 2954:    printf("Processing %d elements\n", ne);
 2955:    for (int i = 0; i < ne; i++)
 2956:    {
 2957:       Element &elem = localElemData[i];
 2958:       elem.idx = i;
 2959:       for (int j = 0; j < i34[i]; j++) {
 2960:          const int idxNode = elnode[i*4 + j];  
 2961:          const int idxSide = elside[i*4 + j];
 2962:          
 2963:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2964:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2965: 
 2966: 
 2967: 
 2968:          // Find the neighboring element  
 2969:          if (elem.sides[j]->elems[0] == &elem) {
 2970:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2971:          }
 2972:          else {
 2973:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2974:          }
 2975:          
 2976:       }
 2977: 
 2978:       elem.i34 = i34[i];
 2979: 
 2980:       // Compute the centroid of the element and its depth
 2981:       Vector2 center = {0.0, 0.0};
 2982:       elem.depth = 0.0;
 2983:       for (int j = 0; j < i34[i]; j++) {
 2984:          center += elem.nodes[j]->p2()/i34[i];
 2985:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 2986:       }
 2987:       elem.center.x = center.x;
 2988:       elem.center.y = center.y;
 2989: 
 2990: 
 2991:       
 2992:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 2993:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 2994: 
 2995:       elem.area = elem.computeSignedArea(); 
 2996:       elem.radius = sqrt(elem.area)/pi; 
 2997:       
 2998:       // Determines which way the normal vector to each side is oriented.
 2999:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3000:       for (int j = 0; j < i34[i]; j++)  
 3001:       {
 3002:          if (elem.sides[j]->elems[0] == &elem) {
 3003:             elem.ssign[j] =  1.0;
 3004:          }
 3005:          else {
 3006:             elem.ssign[j] = -1.0;
 3007:          }
 3008: 
 3009:       }
 3010: 
 3011:       // Derivatives of shape functions
 3012:       //  For ics=2, this is done inside element/ll frame XXX
 3013:       //  For quads, the derivative is evaluated at centroid
 3014:       const int i34 = elem.i34;
 3015:       for (int j = 0; j < i34; j++) {
 3016:          const double area = elem.area;
 3017:          const int id2 = elem.nxq(1 + j);
 3018:          const int id3 = elem.nxq(2 + j);
 3019:          const int id4 = elem.nxq(3 + j);
 3020:          if (elem.isTri()) {
 3021:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3022:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3023:             // da1/dx = (y1 - y2)/(2*area)
 3024:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3025:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3026:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3027:          }
 3028:          else  { // Quad; evaluate at centroid
 3029:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3030:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3031:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3032:          } // if Tri
 3033: 
 3034:       } // for j
 3035: 
 3036:    }
 3037: 
 3038: 
 3039:    // Processing the boundary nodes
 3040:    int idx = 0;
 3041:    for (int iseg = 0; iseg < nope; iseg++) {
 3042:       // for each segment...
 3043:       
 3044:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3045:          // for each node on the segment...
 3046: 
 3047:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3048: 
 3049:          nodeBnd->isEssentialBC = true;
 3050: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3051:          nodeBnd->elbc = 0.0;
 3052: 
 3053:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3054: 
 3055:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3056:             nodeBnd->efa[jfr] = efa[idx];
 3057:             nodeBnd->emo[jfr] = emo[idx];
 3058:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3059:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3060: 
 3061:          }
 3062: 
 3063:          idx++;
 3064:       }
 3065: 
 3066:    }
 3067: 
 3068: }
 3069: 
 3070: 
 3071: 
 3072: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3073:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3074:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3075:    // 
 3076:    // This kernel is called for all nodes.
 3077: 
 3078: 
 3079:    NODE(node1);
 3080: 
 3081: 
 3082:    node1->clearMatrixRow();
 3083:    node1->qel = 0.0;
 3084: 
 3085:    // THIS IS FOR STRUCTURES XXX
 3086:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3087: 
 3088:    
 3089:    for (int j=0; j<node1->numElements; j++) {
 3090:       // For each element connected to the node...
 3091: 
 3092:       Element *elem = node1->elements[j];
 3093: 
 3094:       // Compute the average gravity
 3095:       const double grav3 = elem->mean(&Node::grav2);
 3096: 
 3097:       // Look at the documentation for the description of the terms in the following integrals
 3098: 
 3099:       // Integral I_1 
 3100:       // \bar{\breve{H}} 
 3101:       const double hhatb = elem->mean(&Side::hhat);        
 3102: 
 3103: 
 3104:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3105: 
 3106:       const int id1 = elem->nodeLocalIdx(node1); 
 3107:       const double area = elem->area;
 3108: 
 3109:       if (elem->isTri()) {
 3110: 
 3111:          // To clarify the notation in this section: 
 3112:          //   i stands for the node under consideration (node1)
 3113:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3114:          const int id2 = elem->nxq(1 + id1);
 3115:          const int id3 = elem->nxq(2 + id1);
 3116:          Node *node2 = elem->nodes[id2];
 3117:          Node *node3 = elem->nodes[id3];
 3118: 
 3119:          const Point2 x1 = node1->p2();
 3120:          const Point2 x2 = node2->p2();
 3121:          const Point2 x3 = node3->p2();
 3122: 
 3123:          // integral of phi_i*phi_j
 3124:          const double ipp_ii = (1.0/6.0 )*area;
 3125:          const double ipp_ij = (1.0/12.0)*area;
 3126:          const double ipp_ik = (1.0/12.0)*area;
 3127: 
 3128:          // integral of [(grad phi_i) * (grad phi_j)]
 3129:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3130:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3131:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3132: 
 3133:          // Computes the different components of integral I_1 of each node with respect to node i.
 3134:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3135:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3136:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3137: 
 3138:          node1->addToSparseMatrix(node1, I1_ii);
 3139:          node1->addToSparseMatrix(node2, I1_ij); 
 3140:          node1->addToSparseMatrix(node3, I1_ik);
 3141: 
 3142:       }
 3143:       else { // Quad
 3144:          // XXX IMPLEMENT THIS
 3145:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3146:       } 
 3147: 
 3148:  
 3149:       // Integral I_4
 3150:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3151:       // Where
 3152:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3153: 
 3154:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3155:       // of U over the element.
 3156:       Vector2 Umean = {0.0, 0.0};
 3157:       for (int m=0; m<elem->i34; m++) {      
 3158:          const Side *side = elem->sides[m];
 3159: 
 3160:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3161:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3162:       }
 3163:       Umean = Umean/elem->i34;
 3164: 
 3165:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3166: 
 3167:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3168:       const double I_4_1 = dot(gradPhi_1, Umean);
 3169: 
 3170:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3171:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3172:      
 3173:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3174: 
 3175:       // Additional terms 
 3176:       double vnorm = 0.0;
 3177:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3178:          Vector3 ubed;
 3179:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3180: 
 3181:          Vector3 gradP = {0.0, 0.0, 1.0};
 3182:          for (int m=0; m < elem->i34; m++) {
 3183:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3184:            gradP += toVector3(gradP_2D, 0.0);
 3185:          }   
 3186:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3187:       } // imm==2
 3188: 
 3189:       if (elem->isTri()) {
 3190:          for (int l=0; l<3; l++) {
 3191:             double fac;
 3192: 
 3193:             Node *node = elem->nodes[l];
 3194: 
 3195:             fac = (node == node1) ? 2.0 : 1.0;
 3196:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3197:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3198:            
 3199:          }
 3200: 
 3201: 
 3202:          if (!elem->isDry) {
 3203:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3204: 
 3205:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3206:          }
 3207: 
 3208:       } // isTri
 3209:       else { // isQuad
 3210:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3211:          // for (int l=0; l<4; l++) {
 3212:          //   const Node *node = elem->nodes[l];
 3213: 
 3214:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3215:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3216: 
 3217:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3218:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3219:          // }
 3220: 
 3221:       } // isQuad
 3222: 
 3223: 
 3224:       node1->qel += (dt/elem->i34)*elem->vsource;
 3225:       
 3226: 
 3227:    } // for all elements connected to the node
 3228:    
 3229: 
 3230: 
 3231:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3232:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3233:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3234:    if (nodeBnd != nullptr)  { 
 3235:       // If it is an open boundary node...
 3236: 
 3237:       // At least one open bnd side, maybe two
 3238:       for (int l=0; l<2; l++) { 
 3239: 
 3240:          // Gets each of the sides sharing the node. 
 3241:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3242: 
 3243:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3244: 
 3245:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3246: 
 3247:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3248:          if (sideBnd != nullptr) {
 3249:             // If the side is on a boundary...
 3250: 
 3251:             // Get the boundary segment
 3252:             const BoundarySegment *sideSegment = sideBnd->segment;
 3253:             const Side *side = sideBnd->side;
 3254: 
 3255:             // Integral I_3
 3256:             if (sideSegment->ifltype != 0) {
 3257:             // Natural or Flather b.c.
 3258: 
 3259:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3260:                // especially for Flather b.c.
 3261:                double ri3 = 0.0;
 3262:                if (!side->isDry) {
 3263:                   // If the side is not dry
 3264:                   
 3265:                   // Computes the side flux of (uth, vth)
 3266:                   double Vn = 0.0;
 3267:                   for (int k = side->kb; k<nvrt-1; k++) {
 3268:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3269:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3270: 
 3271:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3272:                   }
 3273: 
 3274:                   ri3 = 0.5*side->len*Vn;
 3275:                }
 3276: 
 3277:                if (sideSegment->ifltype == -1) { // Flather 1
 3278: 
 3279:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3280:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3281: 
 3282:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3283:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3284:                   
 3285:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3286:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3287: 
 3288:                } 
 3289:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3290:                   // Reset ri3
 3291:                   ri3 = 0.0;
 3292: 
 3293:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3294: 
 3295:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3296: 
 3297:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3298:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3299: 
 3300:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3301:                   node1->addToSparseMatrix(node1, con0*2.0);
 3302:                   node1->addToSparseMatrix(node2, con0);
 3303: 
 3304:                } // if Flather or Discharge
 3305: 
 3306:                node1->qel -= thetai*dt*ri3;
 3307: 
 3308:             } // I_3
 3309:           
 3310: 
 3311:             // Integral I_5
 3312:             if(!side->isDry) {
 3313: 
 3314:                const double Unbar = dot(side->U, side->n);
 3315:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3316: 
 3317:             } // I_5
 3318: 
 3319:          } // if is boundary side
 3320: 
 3321:       } // for l
 3322: 
 3323:    } // if isbnd
 3324: 
 3325: 
 3326: }
 3327: 
 3328: 
 3329: 
 3330: extern "C" {
 3331:    __global__ void rollUpElevation(void) {
 3332: 
 3333:       NODE(node);
 3334: 
 3335:       node->eta2 += node->eta1;
 3336: 
 3337:    }
 3338: 
 3339: 
 3340:    __global__ void backtrackAllNodes(void) {
 3341: 
 3342:       // max/min # of sub-divisions
 3343:       const int ndelt_max = max(1.0, dt/dtb_min);
 3344:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3345: 
 3346:       // Removed all references to swild98 XXX
 3347:       // swild98=0.d0 !init
 3348: 
 3349: 
 3350:       SIDE(side);
 3351: 
 3352:       const int kb = side->kb;
 3353: 
 3354: 
 3355: 
 3356:       // Initialize btrack velocities to the actual velocities at the side 
 3357:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3358: 
 3359:       if (side->isDry) return;
 3360: 
 3361: 
 3362:       // Checks that at least one element is not dry
 3363:       const Element *elem1 = side->elems[0];
 3364:       const Element *elem2 = side->elems[1];
 3365: 
 3366: 
 3367:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3368:       
 3369:       // XXXXXX
 3370:       // !swild_tmp to store global coord. of the starting side
 3371:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3372:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3373:       // !Use sframe2 
 3374:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3375: 
 3376: 
 3377:       for (int k = kb; k < nvrt; k++) {
 3378:       //  Initialize (xt,yt,zt), nnel and vel.
 3379:       //  For ics=2, the coordinates are in local frames
 3380:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3381: 
 3382: 
 3383:          const int iadvf = side->iadv();  // Advection flag
 3384: 
 3385:          Point3 xt;
 3386:          if constexpr(ics==1) {
 3387:             xt = side->center3D(k); 
 3388:          }
 3389:          else // lat/lon; in side lat/lon frame
 3390:          {
 3391:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3392:          // XXX IMPLEMENT THIS
 3393:       //          xt=0.d0
 3394:       //          yt=0.d0
 3395:       //          !centroid coord. for nudging
 3396:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3397:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3398:          }  // ics
 3399: 
 3400: 
 3401: 
 3402:          // If on land or open boundary...
 3403:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3404:          
 3405:          const double vmag = length(side->u2[k]);
 3406: 
 3407:          if (vmag <= velmin_btrack) {
 3408:             // No activity 
 3409: addDebugPlot(side->center, side->center, 0x00FF00);
 3410: const double w2 = side->w2[k];
 3411: if (side->idx == 0) printf("$$$$ u_int = %e,%e\n", side->u2[k].x, side->u2[k].y); 
 3412: 
 3413:             side->btu[k] = side->u2[k];
 3414:             
 3415:          } else {  // do btrack
 3416: 
 3417:             // Compute number of sub-divisions based on local gradients 
 3418:             // XXX IS THIS NECESSARY?
 3419:             double suma = 0.0;
 3420:             int icount = 0;
 3421:             for (int ii=0; ii<2; ii++) {
 3422: 
 3423:                const Element *elem = side->elems[ii];
 3424:                  
 3425:                if (elem == nullptr) continue;
 3426: 
 3427:                icount++;
 3428: 
 3429:                // Not strictly along z; in ll frame for ics=2
 3430: 
 3431:                double utmp[4];
 3432:                double vtmp[4];
 3433:                for (int jj = 0; jj < elem->i34; jj++) {
 3434: 
 3435:                   const Node *node = elem->nodes[jj];
 3436: 
 3437:                   if constexpr(ics==1) {
 3438:                      utmp[jj] = node->u2[k].x;
 3439:                      vtmp[jj] = node->u2[k].y;  
 3440:                   } else {
 3441:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3442:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3443:                   }
 3444:                } // for jj
 3445: 
 3446:                const Vector2 grad_u = elem->grad2(utmp); 
 3447:                const Vector2 grad_v = elem->grad2(vtmp);
 3448: 
 3449:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3450:             } // for ii
 3451: 
 3452:             assert(icount > 0 && "Impossible 77");
 3453: 
 3454:             // '4' is somewhat arbitrary
 3455:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3456: 
 3457:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3458:          
 3459: 
 3460:             Vector3 u_int = {0.0, 0.0, 0.0};
 3461: 
 3462:             side->btrack(k, dt, dtbk, u_int);
 3463:             side->btu[k] = toVector2(u_int);
 3464:                
 3465:          } // if vmag (do backtrack)
 3466: 
 3467:       } // for j=jmin,nvrt-1
 3468: 
 3469:    }
 3470: } // extern "C"
 3471: 
 3472: template<int nc>
 3473: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3474: 
 3475: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3476: //
 3477: // a,b,c,rhs: input vectors and are not modified by this program.
 3478: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3479: // rhs is the r.h.s.
 3480: // n: actual rank of the system.
 3481: // rows in u() and rhs();
 3482: // u: output with nc columns (transposed to rows)
 3483: // gam: a working array.
 3484: //
 3485: // NOTES:
 3486: // This is a template function that allows for different numbers of columns in the rhs vector.
 3487: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3488: 
 3489:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3490:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3491: 
 3492:    double bet = b[0];
 3493:    if constexpr (nc == 1) {
 3494:       u[0] = rhs[0]/bet;
 3495:    } else {
 3496:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3497:    }
 3498: 
 3499:    for (int j = 1; j < n; j++) {
 3500:       gam[j] = c[j-1]/bet;
 3501:       bet = b[j] - a[j]*gam[j];
 3502: 
 3503:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3504: 
 3505:       if constexpr (nc == 1) {
 3506:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3507:       } else {
 3508:          for (int k = 0; k < nc; k++) {
 3509:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3510:          }
 3511:       }
 3512:    }
 3513: 
 3514:    // Back-substitution
 3515:    for (int j=n-1; j>=1; j--) {
 3516:       if constexpr (nc == 1) {
 3517:          u[j] = u[j] - gam[j+1]*u[j-1];
 3518:       } else {
 3519:          for (int k = 0; k < nc; k++) {
 3520:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3521:          }
 3522:       }
 3523:    }
 3524: }
 3525: 
 3526: 
 3527: 
 3528: // Helper function that contains the core algorithm
 3529: template<typename XAccessor, typename YAccessor>
 3530: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3531:                                     double  yp_top, double  yp_bot, 
 3532:                                     CubicSpline &spline) {
 3533:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3534:    // 
 3535:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3536:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3537:    //
 3538:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3539:    // 
 3540:    // Inputs: 
 3541:    //            n: dimension for x etc; # of data pts (>=2);
 3542:    //            getX, getY: functions to access x,y coordinates
 3543:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3544:    //     Output: 
 3545:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3546: 
 3547:    const int n = k2 - k1 + 1;
 3548:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3549: 
 3550:    // Allocate memory for the splines
 3551:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3552:    spline.x   = new double[n];
 3553:    spline.y   = new double[n];
 3554:    spline.yp  = new double[n];
 3555:    spline.ypp = new double[n];
 3556: 
 3557:    for (int k=k1; k<=k2; k++) {
 3558:       spline.x[k] = getX(k);
 3559:       spline.y[k] = getY(k);
 3560:    }
 3561: 
 3562:    // This is to simplify expressions later
 3563:    double *x = spline.x;
 3564:    double *y = spline.y;
 3565: 
 3566:    double *a = nullptr;
 3567:    double *b = nullptr;
 3568:    double *c = nullptr;
 3569:    double *gam = nullptr;
 3570:    double *rhs = nullptr;
 3571:    
 3572: 
 3573:       a = new double[n];   // Lower diagonal
 3574:       b = new double[n];   // Diagonal
 3575:       c = new double[n];   // Upper diagonal
 3576:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3577:       rhs = new double[n]; // Right-hand side
 3578: 
 3579:    for (int k=k1; k<=k2; k++) {
 3580:       if (k == k1) {
 3581:          // Bottom level
 3582:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3583:          b[k] = (x[k+1] - x[k])/3.0;
 3584:          c[k] = b[k]/2.0;
 3585:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3586:       } else if (k == n - 1) {
 3587:          // Top level (surface)
 3588:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3589:          b[k] = (x[k] - x[k-1])/3.0;
 3590:          a[k] = b[k]/2.0;
 3591:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3592:       } else {
 3593:          // Intermediate levels
 3594:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3595:          b[k] = (x[k+1] - x[k-1])/3.0;
 3596:          a[k] = (x[k  ] - x[k-1])/6.0;
 3597:          c[k] = (x[k+1] - x[k  ])/6.0;
 3598:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3599:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3600:       }
 3601:    }
 3602: 
 3603:    // Solve the tridiagonal system
 3604:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3605:    
 3606:    spline.yp[k1] = yp_bot;
 3607:    spline.yp[k2] = yp_top;
 3608: 
 3609:    // Compute rest of 1st derivatives using the splines
 3610:    for (int k=k1+1; k<k2; k++) {
 3611:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3612:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3613:    }
 3614:    
 3615:    delete[] a;
 3616:    delete[] b;
 3617:    delete[] c;
 3618:    delete[] gam;
 3619:    delete[] rhs;
 3620: 
 3621: }
 3622: 
 3623: // Array version
 3624: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3625:                                 double y_top, double y_bot, 
 3626:                                 CubicSpline &spline) {
 3627:    auto getX = [x] (int k) { return x[k]; };
 3628:    auto getY = [y] (int k) { return y[k]; };
 3629:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3630: }
 3631: 
 3632: // Lambda version - allows custom access patterns
 3633: template<typename XFunc, typename YFunc>
 3634: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3635:                                 double y_top, double y_bot,
 3636:                                 CubicSpline &spline) {
 3637:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3638: }
 3639: 
 3640: 
 3641: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3642: {
 3643:    assert("Not implemented");
 3644: 
 3645:    return 0.0;
 3646: }
