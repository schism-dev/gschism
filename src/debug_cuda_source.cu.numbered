 7083: extern "C"
 7084:                                  
 7085:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7086:                    double *node_coords, double *wind_rotate_angle, 
 7087:                    int *isdel, int *isidenode, int *isbnd,
 7088:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7089:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7090:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7091:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7092:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7093:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7094:                    double *emo, double *efa, 
 7095:                    double *umo, double *ufa, 
 7096:                    double *vmo, double *vfa) {
 7097: 
 7098:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 7099:                        isdel, isidenode, isbnd,
 7100:                        nond, nlnd, iond, ilnd, 
 7101:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7102:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7103:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7104:                        localNodeIndices, localElemIndices, localSideIndices,
 7105:                        localNodePart, localElemPart, localSidePart,
 7106:                        emo, efa, umo, ufa, vmo, vfa);
 7107:   }
