 7437: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7438:    // Get the value of a variable from an element
 7439:    // varName is the name of the variable to get
 7440:    // var is the array to store the value
 7441:    // k is the vertical level index of the variable to get
 7442: 
 7443:    ELEM(elem);
 7444:    
 7445:    int idx = elem->idx;
 7446:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7447: 
 7448:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7449:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7450:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7451:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7452:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7453:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7454:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7455:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7456:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7457:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7458:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7459:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7460:       
 7461:    
 7462: }
 7463: 
 7464: 
 7465: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7466:    // Get the value of a variable from an node
 7467:    // varName is the name of the variable to get
 7468:    // var is the array to store the value
 7469:    // k is the vertical level index of the variable to get
 7470: 
 7471:    NODE(node);
 7472:    
 7473:    int idx = node->idx;
 7474:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7475: 
 7476:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7477:    
 7478:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7479:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7480:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7481:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7482:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7483:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7484:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7485:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7486:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7487:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7488:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7489:       
 7490:    
 7491: }
 7492: 
 7493: 
 7494: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7495:    // Get the value of a variable from an side
 7496:    // varName is the name of the variable to get
 7497:    // var is the array to store the value
 7498:    // k is the vertical level index of the variable to get
 7499:    SIDE(side);
 7500:    
 7501:    int idx = side->idx;
 7502:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7503: 
 7504:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7505:    
 7506:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7507:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7508:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7509:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7510:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7511:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7512:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7513:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7514:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7515:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7516:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7517:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7518:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7519:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7520:    else if (varCode == (int)VarCode::ubc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7521:    else if (varCode == (int)VarCode::vbc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7522:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7523:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7524:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7525: }
