 2658:    template<typename T>
 2659:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2660:       T values[4];
 2661:       getNodalValues(level, func, values);
 2662: 
 2663:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2664:       if constexpr (IsVector2<T>::value && ics == 2) {
 2665: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2666:          projectNodeVectorsToElementFrame(values);
 2667: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2668:       }
 2669: 
 2670:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2671:    }
 2672: 
 2673:    template<typename T>
 2674:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2675:       T values[4];
 2676:       getNodalValues(field, values);
 2677: 
 2678:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2679:       if constexpr (IsVector2<T>::value && ics == 2) {
 2680: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2681:          projectNodeVectorsToElementFrame(values);
 2682: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2683:       }
 2684:       
 2685:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2686:    }
 2687: 
 2688: 
 2689:    template<typename T>
 2690:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2691:       T values[4];
 2692:       getNodalValues(level, field, values);
 2693:       
 2694: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2695:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2696:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2697:       if constexpr (IsVector2<T>::value && ics == 2) {
 2698: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2699:          projectNodeVectorsToElementFrame(values);
 2700: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2701:       }
 2702: 
 2703:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2704:    }
 2705: 
 2706:    template<typename T>
 2707:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2708:       T values[4];
 2709:       getNodalValues(field, values);
 2710: 
 2711:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2712:       if constexpr (IsVector2<T>::value && ics == 2) {
 2713: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2714:          projectNodeVectorsToElementFrame(values);
 2715: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2716:       }
 2717: 
 2718:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2719:    }
 2720: 
 2721:    template<typename T>
 2722:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2723:       T values[4];
 2724:       getSideValues(field, values);
 2725:       
 2726:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2727:       if constexpr (IsVector2<T>::value && ics == 2) {
 2728: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2729:          projectSideVectorsToElementFrame(values);
 2730: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2731:       }
 2732: 
 2733:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2734:    }   
 2735: 
 2736:    template<typename T>
 2737:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2738: 
 2739:       T values[4];
 2740: 
 2741: 
 2742:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2743:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2744:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2745:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2746:       else          values[3] = T();
 2747: 
 2748:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2749: 
 2750:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2751:    }
