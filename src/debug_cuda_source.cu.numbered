 2800: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2801: 
 2802: 
 2803: __device__ void Node::updateKb(void) {
 2804: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2805: 
 2806:    if constexpr(ivcor == 1) return;
 2807: 
 2808: 
 2809:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 2810: 
 2811:    if constexpr(ivcor == 2) {  // SZ coordinates
 2812:       
 2813:       // Compute bottom level index
 2814:       if (depth <= mesh->h_s) {
 2815:          kb = izlev;   
 2816:          
 2817:       } else {
 2818:          kb = -1;
 2819:          int L = 0;
 2820:          int R = nzlev; 
 2821:          
 2822:          while (L <= R) {
 2823:             int M = (R + L) / 2;
 2824: 
 2825: 
 2826:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2827:             
 2828:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2829:                R = M;
 2830:             } else {
 2831:                L = M;
 2832:             }
 2833: 
 2834:             if (R - L == 1) {
 2835:                kb = L;
 2836:                break;
 2837:             }
 2838:          }
 2839: 
 2840:          // Checks that the binary search was successful
 2841:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 2842:        
 2843:       }
 2844:    } 
 2845: }
 2846: 
 2847: 
 2848: __device__ __inline__ void Node::updateZCoordData(void) {
 2849: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2850: 
 2851:    // assert(!isDry2() && "updateZCoordData: node is dry");
 2852:    // if (isDry2()) {
 2853:    //    kb = -1;  // XXXXXXXX KKKKK
 2854:    //    return;
 2855:    // }
 2856: 
 2857: 
 2858:    if constexpr(ivcor == 2) {  // SZ coordinates
 2859:       
 2860:       // Compute bottom level index
 2861:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 2862:    } 
 2863:    else if (ivcor == 1) {  // Localized sigma
 2864:       // Do nothing
 2865:    }
 2866: 
 2867: 
 2868: }
 2869: 
 2870: 
 2871: __device__ double Node::compZCoord(int k) const {
 2872:    // Computes the z coordinate at level k.
 2873:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2874:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2875:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2876:    // used 
 2877:    
 2878:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2879: 
 2880:    if (isDry2()) return -depth;  // XXXX I used to return 0.0
 2881: 
 2882:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2883: 
 2884:    if constexpr(ivcor == 2) {
 2885: 
 2886:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2887:       const double h_c = mesh->h_c;
 2888:       const double theta_f = mesh->theta_f;
 2889:       const double sinh_theta_f = mesh->sinh_theta_f;
 2890: 
 2891:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2892:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2893:       // once per time step/node.
 2894:       // CHECK: updateZCoordData
 2895: 
 2896:       //  To simplify comparisons, I define index versions of count variables.
 2897:       if      (k == ivrt)           return eta2; 
 2898:       else if (k == izlev)          return -hmod2;
 2899:       else if (k == kb)             return -depth;
 2900:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2901:       else if (k > izlev) {
 2902:          const int ksig = k - izlev;
 2903: 
 2904:          if (hmod2 <= h_c) {
 2905: 
 2906:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2907:          } 
 2908:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2909:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2910:             assert(false && "ZCOOR: invalid h_c\n");
 2911:          } 
 2912:          else {
 2913:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2914:                          h_c * mesh->sigma[ksig] + 
 2915:                          (hmod2 - h_c) * mesh->cs[ksig];
 2916:          }
 2917:       } else { 
 2918:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2919:       }
 2920: 
 2921:    }
 2922:    else if constexpr(ivcor == 1) {
 2923:       if (k == kb) return -depth;
 2924:       else if (k == nvrt-1) return eta2;
 2925:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2926:    }
 2927:    
 2928:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2929:    return 0.0;
 2930: }
 2931: 
 2932: 
 2933: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 2934:    // Computes the bottom drag Cd based on the selected nchi
 2935: 
 2936:    if constexpr(nchi == 0) {
 2937:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 2938:       Cd = drag;  // Read from drag file
 2939: 
 2940:    } else if constexpr(nchi == 1) {
 2941:       // 
 2942: 
 2943:       bool ltmp = false; // for WBL iteration
 2944: 
 2945:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 2946:       if (isDry || (rough == 0.0)) {
 2947:          Cd = 0.0;
 2948: 
 2949:       } else { //roughness >0 
 2950:          
 2951:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 2952: 
 2953:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 2954: 
 2955:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 2956: 
 2957:       } // if rough
 2958: 
 2959:    } else if constexpr(nchi == -1) {
 2960:    // Manning 
 2961:  
 2962:       const double htot = max(hmin_man, htot2()); 
 2963:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 2964: 
 2965:    } else {
 2966:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 2967:       
 2968:    } // if nchi
 2969: }
 2970: 
 2971: 
 2972: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2973:    // Checks if a side in on the boundary
 2974:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2975: 
 2976:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2977:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2978: 
 2979:    // Indices of the nodes that form the side
 2980:    const int n1 = side.n1->idx;
 2981:    const int n2 = side.n2->idx;
 2982:    isLand = false;
 2983:    
 2984: 
 2985:    // Check if the side is on a land boundary
 2986:    for (int i = 0; i < nland; i++) {
 2987:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2988:          // Consecutive nodes in the land boundary segment
 2989:          const int b1 = ilnd[i + j*nland];
 2990:          const int b2 = ilnd[i + (j + 1)*nland];
 2991: 
 2992:          assert(b1 != -1 && b2 != -1);
 2993: 
 2994:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2995:             
 2996:             isLand = true;
 2997:             return i;
 2998:          }
 2999:       }
 3000:    }
 3001: 
 3002:    // Check if the side is on an open boundary
 3003:    for (int i = 0; i < nope; i++) {
 3004:       for (int j = 0; j < nond[i] - 1; j++) {
 3005:          // Consecutive nodes in the open boundary segment
 3006:          const int b1 = iond[i + j*nope];
 3007:          const int b2 = iond[i + (j + 1)*nope];
 3008: 
 3009:          assert(b1 != -1 && b2 != -1);
 3010: 
 3011:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3012:             isLand = false;
 3013:             return i;
 3014:          }
 3015:       }
 3016:    }
 3017: 
 3018:    return -1;
 3019: }
 3020: 
 3021: 
 3022: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3023:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3024:                                     double *wind_rotate_angle, 
 3025:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3026:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3027:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3028:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3029:                                     double *drag, double *roughness, double *rmanning) {
 3030: 
 3031:    NODE(pnode);  
 3032:    const int i = idx_node;
 3033:    Node &node(*pnode);
 3034: 
 3035:    node.idx = i;
 3036: 
 3037:    const int idxNodeStart = nodeNeighNodesStart[i];
 3038:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3039:    node.numNodes = idxNodeEnd - idxNodeStart;
 3040:    node.nodes = nodeNeighNodes + idxNodeStart;
 3041:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3042: 
 3043: 
 3044: 
 3045:    const int idxElemStart = nodeNeighElemsStart[i];
 3046:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3047:    node.numElements = idxElemEnd - idxElemStart;
 3048:    node.elements = nodeNeighElems + idxElemStart;
 3049: 
 3050: 
 3051:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3052:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3053:       const int partNode = localNodePart[idxNodeGlobal]; 
 3054:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3055: 
 3056:       Node *node_ptr = nodes[partNode] + idxNode;
 3057:       
 3058:       nodeNeighNodes[idx] = node_ptr;
 3059:    }
 3060: 
 3061: 
 3062:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3063:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3064:       const int partElem = localElemPart[idxElemGlobal];
 3065:       const int idxElem  = localElemIndices[idxElemGlobal];
 3066: 
 3067:       Element *elem_ptr = elems[partElem] + idxElem;
 3068: 
 3069:       nodeNeighElems[idx] = elem_ptr;
 3070:    }      
 3071: 
 3072:    node.wind_angle = wind_rotate_angle[i];
 3073: 
 3074: 
 3075:    node.p.x   = node_coords[i * 3];
 3076:    node.p.y   = node_coords[i * 3 + 1];
 3077:    node.depth = node_coords[i * 3 + 2];
 3078: 
 3079:    if (use_ll) {
 3080:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3081:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3082:    }
 3083: 
 3084: 
 3085:    node.numSides = 0;
 3086: 
 3087:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3088:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3089:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3090:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3091:    else assert(false && "populateNodes: selected nchi not implemented.");
 3092:    
 3093:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3094:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3095:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3096: 
 3097:    
 3098:    // Links the node to the boundary information
 3099:    if (isbnd[i] >= 0) {
 3100:      
 3101:       // Get the index of the node boundary
 3102:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3103: 
 3104:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3105:       node.nodeBnd->node = &node;
 3106: 
 3107:       node.nodeBnd->sideBnd1 = nullptr;
 3108:       node.nodeBnd->sideBnd2 = nullptr;
 3109: 
 3110:       if (isbnd[i]>=0) {
 3111: 
 3112:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3113:          
 3114:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3115: // printf("(isbnd[i]==0)?3:0 = %d\n", (isbnd[i]==0)?3:0);         
 3116:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3117: 
 3118:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3119:          node.nodeBnd->segment->clen  = nan("1");
 3120:          node.nodeBnd->segment->carea = nan("1");
 3121: 
 3122:       }
 3123:    } else {
 3124: 
 3125:       node.nodeBnd = nullptr; // For internal nodes
 3126: 
 3127:       if (isbnd[i] == landSegment) {
 3128:          node.nodeBnd = &landBoundaryNode;
 3129:          node.nodeBnd->segment = &landBoundarySegment;
 3130:       }
 3131:       
 3132:    }
 3133:    
 3134:    // XXXX GAUSSIAN HILL VELOCITIES
 3135: #ifdef GAUSSIAN_HILL_VELOCITIES
 3136:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3137:       constexpr double rot_per = 3000.0;
 3138:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3139:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3140:    // XXXXX
 3141: #endif
 3142: 
 3143: }
 3144: 
 3145: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3146:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3147:                                     double *wind_rotate_angle,   
 3148:                                     int *isdel, int *isidenode, int *isbnd,
 3149:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3150:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3151:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3152:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3153:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3154:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3155:                                     double *drag, double *roughness) {
 3156: 
 3157: 
 3158:    SIDE(pside);
 3159:    Side &side(*pside);
 3160:    const int i = idx_side;
 3161: 
 3162:    side.idx = i;  
 3163:    
 3164:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3165:    const double fc   = 2.0*omega_e*sin(sfea0);
 3166:    const double beta = 2.0*omega_e*cos(sfea0);
 3167: 
 3168:    // finding the pointer to the nodes that form the side
 3169:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3170:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3171: 
 3172:    const int locidx_n1 = localNodeIndices[idx_n1];
 3173:    const int locidx_n2 = localNodeIndices[idx_n2];
 3174:    const int part_n1 =   localNodePart[idx_n1];
 3175:    const int part_n2 =   localNodePart[idx_n2];
 3176: 
 3177:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3178:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3179: 
 3180:    // Counts the number of sides connected to each node
 3181:    side.n1->numSides++;
 3182:    side.n2->numSides++;
 3183: 
 3184:    // Normal, unitary vector to the side
 3185:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3186:    side.n = normalize(side.n);
 3187: 
 3188:    // Side boundary type
 3189:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3190:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3191: 
 3192:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3193:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3194:    {
 3195:       bool isLand = false;
 3196:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3197:       
 3198:       if (isbs > -1) {
 3199:          // assert(isLand || isbs>=0);
 3200:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3201: 
 3202:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3203: 
 3204:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3205:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3206: 
 3207:          assert (isLand == side.sideBnd->segment->isLand);
 3208: 
 3209:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3210:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3211:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3212: 
 3213:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3214:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3215:          
 3216:          side.sideBnd->side = &side;
 3217: 
 3218:       }
 3219:       else {
 3220:          side.sideBnd = nullptr;
 3221:       }
 3222:    }
 3223:    else 
 3224:    {
 3225:       side.sideBnd = nullptr;
 3226:    }
 3227: 
 3228: 
 3229:    // finding the pointer to the elements that share the side
 3230:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3231:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3232: 
 3233:    if (idx_e1 > -1) {
 3234:       const int locidx_e1 = localElemIndices[idx_e1];
 3235:       const int part_e1 =  localElemPart[idx_e1];
 3236:       side.elems[0] = elems[part_e1] + locidx_e1;
 3237: 
 3238:    }
 3239:    else {
 3240:       side.elems[0] = nullptr;
 3241:    }
 3242: 
 3243:    if (idx_e2 > -1) {
 3244:       const int locidx_e2 = localElemIndices[idx_e2];
 3245:       const int part_e2 =  localElemPart[idx_e2];
 3246:       side.elems[1] = elems[part_e2] + locidx_e2;
 3247:    }
 3248:    else {
 3249:       side.elems[1] = nullptr;
 3250:    }
 3251: 
 3252:    // Compute the center of the side
 3253:    side.center = 0.5*(side.n1->p + side.n2->p);
 3254: 
 3255:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3256:    side.shapiro = shapiro0;
 3257: 
 3258: #ifdef GAUSSIAN_HILL_VELOCITIES
 3259: // XXXX
 3260: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3261: constexpr double rot_per=3000.0;
 3262: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3263: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3264: // XXXXX      
 3265: #endif
 3266:    // Compute the z level at the center of the side
 3267:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3268:    
 3269:    // Compute the length of the side
 3270:    const Vector2 vLen = side.n2->p - side.n1->p;
 3271:    side.len = sqrt(dot(vLen, vLen));
 3272: 
 3273: 
 3274:    // Compute the Coriolis coefficient
 3275: 
 3276:    if constexpr(ncor == -1 || ncor == 0) {
 3277:       side.coriolis = coricoef;
 3278:    }
 3279:    else {
 3280:       const double sphi = side.lat();  // Latitude at the center of the side
 3281: 
 3282: // XXXXXX ERROR WHEN use_ll is false??????
 3283:       if constexpr(ics == 1) {
 3284:          // XXXXXXX
 3285:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3286:       }
 3287:       else {
 3288:          side.coriolis = 2.0*omega_e*sin(sphi);
 3289:       }
 3290: 
 3291:    }
 3292: }
 3293: 
 3294: 
 3295: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3296:    double *node_coords, double *node_coords_ll, bool use_ll,
 3297:    double *wind_rotate_angle,   
 3298:    int *isdel, int *isidenode, int *isbnd,
 3299:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3300:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3301:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3302:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3303:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3304:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3305:    double *drag, double *roughness) {
 3306: 
 3307:    ELEM(pelem);
 3308:    Element &elem(*pelem);
 3309:    const int i = idx_elem;
 3310: 
 3311:    elem.idx = i;
 3312: 
 3313:    for (int j = 0; j < i34[i]; j++) {
 3314:       const int idxNode = elnode[i*4 + j];  
 3315:       const int idxSide = elside[i*4 + j];
 3316:       
 3317:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3318:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3319: 
 3320:       // Find the neighboring element  
 3321:       if (elem.sides[j]->elems[0] == &elem) {
 3322:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3323:       }
 3324:       else {
 3325:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3326:       }
 3327:       
 3328:    }
 3329: 
 3330:    elem.i34 = i34[i];
 3331: 
 3332:    // Compute the barycenter of the element and its depth
 3333:    elem.center = {0.0, 0.0};
 3334:    elem.depth = 0.0;
 3335:    for (int j = 0; j < i34[i]; j++) {
 3336: 
 3337:       elem.center += elem.nodes[j]->p/i34[i];
 3338:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3339:    }
 3340: 
 3341: 
 3342:    
 3343:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3344:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3345: 
 3346:    elem.area = elem.computeSignedArea(); 
 3347:    elem.radius = sqrt(elem.area)/pi; 
 3348:    
 3349:    // Determines which way the normal vector to each side is oriented.
 3350:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3351:    for (int j = 0; j < i34[i]; j++)  
 3352:    {
 3353:       if (elem.sides[j]->elems[0] == &elem) {
 3354:          elem.ssign[j] =  1.0;
 3355:       }
 3356:       else {
 3357:          elem.ssign[j] = -1.0;
 3358:       }
 3359: 
 3360:    }
 3361: 
 3362:    // Derivatives of shape functions
 3363:    //  For ics=2, this is done inside element/ll frame XXX
 3364:    //  For quads, the derivative is evaluated at centroid
 3365:    for (int j = 0; j < elem.i34; j++) {
 3366:       const double area = elem.area;
 3367:       const int id2 = elem.nxq(1 + j);
 3368:       const int id3 = elem.nxq(2 + j);
 3369:       const int id4 = elem.nxq(3 + j);
 3370:       if (elem.isTri()) {
 3371:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3372:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3373:          // da1/dx = (y1 - y2)/(2*area)
 3374:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3375:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3376:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3377:       }
 3378:       else  { // Quad; evaluate at centroid
 3379:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3380:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3381:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3382:       } // if Tri
 3383: 
 3384:    } // for j   
 3385:    
 3386:    
 3387: 
 3388: }
 3389: 
 3390: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3391:                                             double *emo, double *efa, 
 3392:                                             double *umo, double *ufa, 
 3393:                                             double *vmo, double *vfa) {
 3394: 
 3395: 
 3396:    NODE_BND(nodeBnd);
 3397:    const int idx = idx_node_bnd;    
 3398: 
 3399:    nodeBnd->idx = idx;
 3400: 
 3401:    // Need to find the segment index and the index of the node on the segment
 3402:    int idxNode = -1;
 3403:    int iseg, i;
 3404:    for (iseg = 0; iseg < nope; iseg++) {
 3405:       // for each segment...
 3406:       for (i = 0; i < nond[iseg]; i++) {
 3407:          idxNode = iond[iseg + i*nope];
 3408:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3409:          
 3410:       }
 3411:    }
 3412: 
 3413:    assert(iseg < nope && "iseg is out of bounds");
 3414: 
 3415: found: // Jumped here when the node was found
 3416: 
 3417:    nodeBnd->isEssentialBC = true;
 3418:    nodeBnd->elbc = 0.0;
 3419: 
 3420:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3421: 
 3422:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3423:       nodeBnd->efa[jfr] = efa[idx2];
 3424:       nodeBnd->emo[jfr] = emo[idx2];
 3425:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3426:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3427: 
 3428:    }
 3429:         
 3430: 
 3431: }
 3432: 
 3433: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3434:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3435:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3436:                 int *isdel, int *isidenode, int *isbnd,
 3437:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3438:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3439:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3440:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3441:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3442:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3443:                 double *drag, double *roughness,
 3444:                 double *emo, double *efa, 
 3445:                 double *umo, double *ufa, 
 3446:                 double *vmo, double *vfa) {
 3447: 
 3448:    // printf("Populating mesh for partition %d\n", partNum);
 3449: 
 3450:    // XXXXXX THIS function does almost nothing. 
 3451: 
 3452:    nbs = *sharedIdxSideBoundary + 1;
 3453:    nbp = *sharedIdxNodeBoundary + 1;
 3454: 
 3455:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3456: 
 3457: }
 3458: 
 3459: 
 3460: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3461:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3462:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3463: 
 3464: 
 3465:    NODE(node1);
 3466: 
 3467:    node1->clearMatrixRow();
 3468:    node1->qel = 0.0;
 3469: 
 3470:    // THIS IS FOR STRUCTURES XXX
 3471:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3472: 
 3473:    
 3474:    for (int j=0; j<node1->numElements; j++) {
 3475:       // For each element connected to the node...
 3476: 
 3477:       Element *elem = node1->elements[j];
 3478: 
 3479: // if (elem->isDry) continue;  /// XXXX KKKKKK NOT IN THE ORIGINAL CODE
 3480: 
 3481: 
 3482:       // Compute the average gravity
 3483:       const double grav3 = elem->mean(&Node::grav2);
 3484: 
 3485:       // Look at the documentation for the description of the terms in the following integrals
 3486: 
 3487:       // Integral I_1 
 3488:       // \bar{\breve{H}} 
 3489:       const double hhatb = elem->mean(&Side::hhat);        
 3490: 
 3491:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3492: 
 3493:       const int id1 = elem->nodeLocalIdx(node1); 
 3494:       const double area = elem->area;
 3495: 
 3496:       if (elem->isTri()) {
 3497: 
 3498:          // To clarify the notation in this section: 
 3499:          //   i stands for the node under consideration (node1)
 3500:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3501:          const int id2 = elem->nxq(1 + id1);
 3502:          const int id3 = elem->nxq(2 + id1);
 3503:          Node *node2 = elem->nodes[id2];
 3504:          Node *node3 = elem->nodes[id3];
 3505: 
 3506:          const Point2 x1 = node1->p;
 3507:          const Point2 x2 = node2->p;
 3508:          const Point2 x3 = node3->p;
 3509: 
 3510:          // integral of phi_i*phi_j
 3511:          const double ipp_ii = (1.0/6.0 )*area;
 3512:          const double ipp_ij = (1.0/12.0)*area;
 3513:          const double ipp_ik = (1.0/12.0)*area;
 3514: 
 3515:          // integral of [(grad phi_i) * (grad phi_j)]
 3516:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3517:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3518:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3519: 
 3520:          // Computes the different components of integral I_1 of each node with respect to node i.
 3521:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3522:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3523:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3524: 
 3525:          node1->addToSparseMatrix(node1, I1_ii);
 3526:          node1->addToSparseMatrix(node2, I1_ij); 
 3527:          node1->addToSparseMatrix(node3, I1_ik);
 3528: 
 3529:       }
 3530:       else { // Quad
 3531:          // XXX IMPLEMENT THIS
 3532:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3533: 
 3534:          // To clarify the notation in this section: 
 3535:          //   i stands for the node under consideration (node1)
 3536:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3537:          const int id2 = elem->nxq(1 + id1);
 3538:          const int id3 = elem->nxq(2 + id1);
 3539:          const int id4 = elem->nxq(3 + id1);
 3540:          Node *node2 = elem->nodes[id2];
 3541:          Node *node3 = elem->nodes[id3];
 3542:          Node *node4 = elem->nodes[id4];         
 3543: 
 3544:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3545:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3546:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3547:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3548:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3549: 
 3550:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3551:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3552:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3553:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3554:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3555: 
 3556:          // Computes the different components of integral I_1 of each node with respect to node i.
 3557:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3558:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3559:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3560:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3561: 
 3562:          node1->addToSparseMatrix(node1, I1_ii);
 3563:          node1->addToSparseMatrix(node2, I1_ij); 
 3564:          node1->addToSparseMatrix(node3, I1_ik);
 3565:          node1->addToSparseMatrix(node4, I1_il);
 3566:   
 3567: 
 3568: 
 3569:       
 3570:       } 
 3571: 
 3572:  
 3573:       // Integral I_4
 3574:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3575:       // Where
 3576:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3577: 
 3578:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3579:       // of U over the element.
 3580:       Vector2 U = {0.0, 0.0};
 3581:       for (int m=0; m < elem->i34; m++) {      
 3582:          const Side *side = elem->sides[m];
 3583: 
 3584:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3585:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3586:       }
 3587:       U = U/elem->i34;
 3588: 
 3589: 
 3590:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3591: 
 3592: 
 3593:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3594:       const double I_4_1 = dot(gradPhi_1, U);
 3595: 
 3596: 
 3597:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3598:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3599:      
 3600:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3601: 
 3602:       // Additional terms 
 3603:       double vnorm = 0.0;
 3604:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3605:          Vector3 ubed = {0.0, 0.0, 0.0};
 3606:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3607: 
 3608:          Vector3 gradP = {0.0, 0.0, 1.0};
 3609:          for (int m=0; m < elem->i34; m++) {
 3610:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3611:            gradP += toVector3(gradP_2D, 0.0);
 3612:          }   
 3613:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3614:       } // imm==2
 3615: 
 3616:       if (elem->isTri()) {
 3617:          for (int l=0; l<3; l++) {
 3618: 
 3619:             Node *node = elem->nodes[l];
 3620: 
 3621:             double fac = (node == node1) ? 2.0 : 1.0;
 3622:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3623:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3624:            
 3625:          }
 3626: 
 3627: 
 3628:          if (!elem->isDry) {
 3629:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3630: 
 3631:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3632: 
 3633:          }
 3634: 
 3635:       } // isTri
 3636:       else { // isQuad
 3637:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3638:          // for (int l=0; l<4; l++) {
 3639:          //   const Node *node = elem->nodes[l];
 3640: 
 3641:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3642:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3643: 
 3644:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3645:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3646:          // }
 3647: 
 3648:       } // isQuad
 3649: 
 3650: 
 3651:      node1->qel += (dt/elem->i34)*elem->vsource;
 3652:       
 3653: 
 3654:    } // for all elements connected to the node
 3655:    
 3656: 
 3657:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3658:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3659:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3660:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3661:       // If it is an open boundary node...
 3662: 
 3663:       // At least one open bnd side, maybe two
 3664:       for (int l=0; l<2; l++) { 
 3665: 
 3666:          // Gets each of the sides sharing the node. 
 3667:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3668: 
 3669:        
 3670: 
 3671:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3672:          if (sideBnd != nullptr) {
 3673:             // If the side is on a boundary...
 3674: 
 3675:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3676: 
 3677:             // Get the boundary segment
 3678:             const BoundarySegment *sideSegment = sideBnd->segment;
 3679:             const Side *side = sideBnd->side;
 3680: 
 3681:             // Integral I_3
 3682:             if (sideSegment->ifltype != 0) {
 3683:             // Natural or Flather b.c.
 3684: 
 3685:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3686:                // especially for Flather b.c.
 3687:                double ri3 = 0.0;
 3688:                if (!side->isDry) {
 3689:                   // If the side is not dry
 3690:                   
 3691:                   // Computes the side flux of (uth, vth)
 3692:                   double Vn = 0.0;
 3693:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3694:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3695:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3696: 
 3697:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3698:                   }
 3699: 
 3700:                   ri3 = 0.5*side->len*Vn;
 3701:                }
 3702: 
 3703:                if (sideSegment->ifltype == -1) { // Flather 1
 3704: 
 3705:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3706:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3707: 
 3708:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3709:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3710:                   
 3711:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3712:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3713: 
 3714:                } 
 3715:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3716:                   // Reset ri3
 3717:                   ri3 = 0.0;
 3718: 
 3719:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3720: 
 3721:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3722: 
 3723:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3724:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3725: 
 3726:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3727:                   node1->addToSparseMatrix(node1, con0*2.0);
 3728:                   node1->addToSparseMatrix(node2, con0);
 3729: 
 3730:                } // if Flather or Discharge
 3731: 
 3732:                node1->qel -= thetai*dt*ri3;
 3733: 
 3734: 
 3735:             } // I_3
 3736:           
 3737: 
 3738:             // Integral I_5
 3739:             if(!side->isDry) {
 3740: 
 3741:                const double Unbar = dot(side->U, side->n);
 3742:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3743: 
 3744:             } // I_5
 3745: 
 3746:          } // if is boundary side
 3747: 
 3748:       } // for l
 3749: 
 3750:    } // if isbnd
 3751: 
 3752: 
 3753: }
 3754: 
 3755: 
 3756: 
 3757: extern "C" {
 3758:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3759:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3760:                                   int* indices, int* indptr) {
 3761: 
 3762:       NODE(node);
 3763:       
 3764:       const int idx = node->idx;
 3765:       
 3766:       // Computes the index in the nzz array      
 3767:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3768: 
 3769: 
 3770:       indptr[idx] = nzzIdx;
 3771:       indices[nzzIdx] = idx;
 3772: 
 3773:       data_d[nzzIdx]    = node->coeffDiag;
 3774:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3775: 
 3776:       diag_d[idx] = 1.0/node->coeffDiag;
 3777:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3778: 
 3779:       b_d[idx] = node->qel;
 3780:       b_f[idx] = (float)node->qel;
 3781: 
 3782:       for (int k = 0; k < node->numNodes; ++k) {
 3783:          const Node* nb = node->nodes[k];
 3784: 
 3785:          const int j = nb->idx;
 3786: 
 3787:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3788:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3789: 
 3790:          indices[nzzIdx + k + 1] = j;
 3791:       }
 3792: 
 3793: 
 3794:    }
 3795: 
 3796: 
 3797: 
 3798:    __global__ void solverCopyResult(double* x) {
 3799:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3800:       NODE(node);
 3801:       const int idx = node->idx;
 3802: 
 3803:       node->mX = x[idx];
 3804:    }
 3805: 
 3806: 
 3807:    __global__ void rollUpElevation(void) {
 3808: 
 3809:       NODE(node);
 3810: 
 3811:       node->eta1 = node->eta2;
 3812: 
 3813:    }
 3814: 
 3815: 
 3816:    __global__ void backtrackAllNodes(void) {
 3817: 
 3818:       // max/min # of sub-divisions
 3819:       const int ndelt_max = max(1.0, dt/dtb_min);
 3820:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3821: 
 3822:       // Removed all references to swild98 XXX
 3823:       // swild98=0.d0 !init
 3824: 
 3825: 
 3826:       SIDE(side);
 3827: 
 3828:       const int kb = side->kb;
 3829: 
 3830: 
 3831:       // Initialize btrack velocities to the actual velocities at the side 
 3832:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3833: 
 3834:   
 3835: 
 3836:       // if (side->isDry) return;
 3837:       
 3838: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3839: 
 3840:       // Checks that at least one element is not dry
 3841:       const Element *elem1 = side->elems[0];
 3842:       const Element *elem2 = side->elems[1];
 3843: 
 3844: if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3845: 
 3846:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3847:       
 3848:       // XXXXXX
 3849:       // !swild_tmp to store global coord. of the starting side
 3850:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3851:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3852:       // !Use sframe2 
 3853:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3854: 
 3855: 
 3856:       for (int k = kb; k < nvrt; k++) {
 3857:       //  Initialize (xt,yt,zt), nnel and vel.
 3858:       //  For ics=2, the coordinates are in local frames
 3859:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3860: 
 3861: 
 3862:          const int iadvf = side->iadv();  // Advection flag
 3863: 
 3864:          Point3 xt;
 3865:          if constexpr(ics==1) {
 3866:             xt = side->center3D(k); 
 3867:          }
 3868:          else // lat/lon; in side lat/lon frame
 3869:          {
 3870:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3871:          // XXX IMPLEMENT THIS
 3872:       //          xt=0.d0
 3873:       //          yt=0.d0
 3874:       //          !centroid coord. for nudging
 3875:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3876:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3877:          }  // ics
 3878: 
 3879: 
 3880: 
 3881:          // If on land or open boundary...
 3882:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3883:          
 3884:          const double vmag = length(side->u2[k]);
 3885: 
 3886:          if (vmag <= velmin_btrack) {
 3887:             // No activity 
 3888: 
 3889:             side->btu[k] = side->u2[k];
 3890: // addDebugPlot(side->center, side->center, 0x00000F, '+');            
 3891:             
 3892:          } else {  // do btrack
 3893: 
 3894:             // Compute number of sub-divisions based on local gradients 
 3895:             // XXX IS THIS NECESSARY?
 3896:             double suma = 0.0;
 3897:             int icount = 0;
 3898:             for (int ii=0; ii<2; ii++) {
 3899: 
 3900:                const Element *elem = side->elems[ii];
 3901:                  
 3902:                if (elem == nullptr) continue;
 3903: 
 3904:                icount++;
 3905: 
 3906:                // Not strictly along z; in ll frame for ics=2
 3907: 
 3908:                double utmp[4];
 3909:                double vtmp[4];
 3910:                for (int jj = 0; jj < elem->i34; jj++) {
 3911: 
 3912:                   const Node *node = elem->nodes[jj];
 3913: 
 3914:                   if constexpr(ics==1) {
 3915:                      utmp[jj] = node->u2[k].x;
 3916:                      vtmp[jj] = node->u2[k].y;  
 3917:                   } else {
 3918:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3919:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3920:                   }
 3921:                } // for jj
 3922: 
 3923:                const Vector2 grad_u = elem->grad2(utmp); 
 3924:                const Vector2 grad_v = elem->grad2(vtmp);
 3925: 
 3926:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3927:             } // for ii
 3928: 
 3929:             assert(icount > 0 && "Impossible 77");
 3930: 
 3931:             // '4' is somewhat arbitrary
 3932:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3933: 
 3934:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3935: 
 3936:             if (dtbk < 1e-5 || dt < 1e-5) {
 3937:                printf("^^^^^^^dtbk = %.17f, dt = %.17f, ndelt = %i\n", dtbk, dt, ndelt);
 3938: 
 3939:             }
 3940:          
 3941: 
 3942:             Vector3 u_int = {0.0, 0.0, 0.0};
 3943: 
 3944:             side->btrack(k, dt, dtbk, u_int);
 3945:             side->btu[k] = toVector2(u_int);
 3946:                
 3947:          } // if vmag (do backtrack)
 3948: 
 3949:       } // for k=kb,nvrt-1
 3950: 
 3951:    }
 3952: 
 3953: } // extern "C"
 3954: 
 3955: template<int nc>
 3956: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3957: 
 3958: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3959: //
 3960: // a,b,c,rhs: input vectors and are not modified by this program.
 3961: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3962: // rhs is the r.h.s.
 3963: // n: actual rank of the system.
 3964: // rows in u() and rhs();
 3965: // u: output with nc columns (transposed to rows)
 3966: // gam: a working array.
 3967: //
 3968: // NOTES:
 3969: // This is a template function that allows for different numbers of columns in the rhs vector.
 3970: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3971: 
 3972:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3973:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3974: 
 3975:    double bet = b[0];
 3976:    if constexpr (nc == 1) {
 3977:       u[0] = rhs[0]/bet;
 3978:    } else {
 3979:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3980:    }
 3981: 
 3982:    for (int j = 1; j < n; j++) {
 3983:       gam[j] = c[j - 1]/bet;
 3984:       bet = b[j] - a[j]*gam[j];
 3985: 
 3986:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3987: 
 3988:       if constexpr (nc == 1) {
 3989:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3990:       } else {
 3991:          for (int l = 0; l < nc; l++) {
 3992:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3993:          }
 3994:       }
 3995:    }
 3996: 
 3997:    // Back-substitution
 3998:    for (int j = n - 2; j >= 0; j--) {
 3999:       if constexpr (nc == 1) {
 4000:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4001:       } else {
 4002:          for (int l = 0; l < nc; l++) {
 4003:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4004:          }
 4005:       }
 4006:    }
 4007: }
 4008: 
 4009: 
 4010: 
 4011: // Helper function that contains the core algorithm
 4012: template<typename XAccessor, typename YAccessor>
 4013: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4014:                                     double  yp_top, double  yp_bot, 
 4015:                                     CubicSpline &spline) {
 4016:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4017:    // 
 4018:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4019:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4020:    //
 4021:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4022:    // 
 4023:    // Inputs: 
 4024:    //            n: dimension for x etc; # of data pts (>=2);
 4025:    //            getX, getY: functions to access x,y coordinates
 4026:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4027:    //     Output: 
 4028:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4029: 
 4030:    const int n = k2 - k1 + 1;
 4031:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4032: 
 4033:    // Allocate memory for the splines
 4034:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4035:    spline.x   = new double[n];
 4036:    spline.y   = new double[n];
 4037:    spline.yp  = new double[n];
 4038:    spline.ypp = new double[n];
 4039: 
 4040:    for (int k=k1; k<=k2; k++) {
 4041:       spline.x[k] = getX(k);
 4042:       spline.y[k] = getY(k);
 4043:    }
 4044: 
 4045:    // This is to simplify expressions later
 4046:    double *x = spline.x;
 4047:    double *y = spline.y;
 4048: 
 4049:    double *a = nullptr;
 4050:    double *b = nullptr;
 4051:    double *c = nullptr;
 4052:    double *gam = nullptr;
 4053:    double *rhs = nullptr;
 4054:    
 4055: 
 4056:       a = new double[n];   // Lower diagonal
 4057:       b = new double[n];   // Diagonal
 4058:       c = new double[n];   // Upper diagonal
 4059:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4060:       rhs = new double[n]; // Right-hand side
 4061: 
 4062:    for (int k=k1; k<=k2; k++) {
 4063:       if (k == k1) {
 4064:          // Bottom level
 4065:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4066:          b[k] = (x[k+1] - x[k])/3.0;
 4067:          c[k] = b[k]/2.0;
 4068:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4069:       } else if (k == n - 1) {
 4070:          // Top level (surface)
 4071:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4072:          b[k] = (x[k] - x[k-1])/3.0;
 4073:          a[k] = b[k]/2.0;
 4074:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4075:       } else {
 4076:          // Intermediate levels
 4077:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4078:          b[k] = (x[k+1] - x[k-1])/3.0;
 4079:          a[k] = (x[k  ] - x[k-1])/6.0;
 4080:          c[k] = (x[k+1] - x[k  ])/6.0;
 4081:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4082:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4083:       }
 4084:    }
 4085: 
 4086:    // Solve the tridiagonal system
 4087:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4088:    
 4089:    spline.yp[k1] = yp_bot;
 4090:    spline.yp[k2] = yp_top;
 4091: 
 4092:    // Compute rest of 1st derivatives using the splines
 4093:    for (int k=k1+1; k<k2; k++) {
 4094:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4095:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4096:    }
 4097:    
 4098:    delete[] a;
 4099:    delete[] b;
 4100:    delete[] c;
 4101:    delete[] gam;
 4102:    delete[] rhs;
 4103: 
 4104: }
 4105: 
 4106: // Array version
 4107: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4108:                                 double y_top, double y_bot, 
 4109:                                 CubicSpline &spline) {
 4110:    auto getX = [x] (int k) { return x[k]; };
 4111:    auto getY = [y] (int k) { return y[k]; };
 4112:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4113: }
 4114: 
 4115: // Lambda version - allows custom access patterns
 4116: template<typename XFunc, typename YFunc>
 4117: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4118:                                 double y_top, double y_bot,
 4119:                                 CubicSpline &spline) {
 4120:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4121: }
