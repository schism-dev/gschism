 1733: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1734: // return;   
 1735:    // Lock the mutex
 1736:    lock(&debugPlotMutex);
 1737:  
 1738:    bool ok = true;
 1739:    if (debugPlotIdx == nullptr) ok = false;
 1740:    if (*debugPlotIdx >= 10000) ok = false;
 1741:    if (ok) {
 1742:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1743:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1744:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1745:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1746:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1747:       (*debugPlotIdx)++;
 1748:    }
 1749: 
 1750:    __threadfence();               // ensure all above writes are visible
 1751:    // Unlock the mutex
 1752:    unlock(&debugPlotMutex);
 1753: 
 1754: }
