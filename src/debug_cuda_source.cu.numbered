 3364: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3365:    // Returns the value of the velocity at the side center
 3366:    const double w1 = getBoundaryArrayValueWeight();
 3367:    const double w2 = 1.0 - w1;
 3368:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3369:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3370: 
 3371:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3372: }
