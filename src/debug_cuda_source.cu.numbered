 1917: // Convenience macros for accessing the objects in kernels.
 1918: 
 1919: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1920:                    Side *side = &(mesh->localSideData[idx_side]); \
 1921:                    if (idx_side >= mesh->ns) return;
 1922: 
 1923: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1924:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1925:                    if (idx_elem >= mesh->ne) return;
 1926: 
 1927: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1928:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1929:                    if (idx_node >= mesh->np) return;
 1930: 
 1931: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1932:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1933:                               const bool valid = (idx_node < mesh->np);                   
 1934: 
 1935: 
 1936: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1937:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1938:                            if (idx_node_bnd >= mesh->nbp) return;
 1939: 
 1940: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1941:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1942:                            if (idx_side_bnd >= mesh->nbs) return;                           
