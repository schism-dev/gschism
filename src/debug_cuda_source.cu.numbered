 4446:    __global__ void computeFlowBcVelocities(double time) {
 4447: 
 4448:       SIDE_BND(sideBnd);
 4449: 
 4450:       const Side *side = sideBnd->side;
 4451:  
 4452:       const bool isDry = side->isDry;
 4453:       const bool isLand = sideBnd->segment->isLand;
 4454: 
 4455:    
 4456:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4457: 
 4458:       if (isDry || isLand) return;
 4459: 
 4460:       // For wet sides in open boundaries...
 4461:       const Vector2 n = side->n;
 4462:       const BoundarySegment *segment = sideBnd->segment;
 4463: 
 4464:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4465: 
 4466:       const int ifltype = segment->ifltype;
 4467: 
 4468:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4469:       const Vector2 r_nuth0 = r_uth0*n;
 4470: 
 4471: 
 4472:       if (ifltype == 1 || ifltype == 2) {
 4473:       
 4474:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4475: 
 4476:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4477:          
 4478:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4479:          
 4480:       } else if (ifltype == -1) { // Flather 1
 4481: 
 4482:          for (int k = 0; k < nvrt; k++) {
 4483: 
 4484:             // uth is the normal vel.; no ramp up
 4485:             const double uth = sideBnd->nuth(k);
 4486:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4487: 
 4488:             sideBnd->ubc[k] += uth*n;
 4489:          }
 4490: 
 4491:       } else if (ifltype == 3 || ifltype == 5) {
 4492:          // vnth0=0 !normal vel.
 4493: 
 4494:          Vector2 r_u1_bar = {0.0, 0.0};
 4495:          // Computes the contribution to the velocity from all tide frequencies
 4496:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4497: 
 4498:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4499:             const Vector2 umo  = sideBnd->umo(jfr); 
 4500: 
 4501:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4502:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4503:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4504:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4505: 
 4506:          }
 4507: 
 4508: 
 4509:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4510: 
 4511:       } // if (ifltype = 3 || ifltype == 5
 4512: 
 4513: 
 4514: 
 4515:    }
 4516: 
 4517:    __global__ void computeElevationBoundaryConditions(double time) {
 4518:       // Compute elevation essential boundary conditions 
 4519: 
 4520:       NODE_BND(nodeBnd); // Each boundary node.
 4521: 
 4522:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4523: 
 4524:       const Node *node = nodeBnd->node;
 4525:       const BoundarySegment *segment = nodeBnd->segment;
 4526:       const int iettype = segment->iettype;
 4527:       
 4528: 
 4529:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4530:       double eic = 0.0;
 4531:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4532:       else                 eic = 0.0;
 4533: 
 4534:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4535:       const double r_eth = ramp*nodeBnd->eth;
 4536:       double r_eta1_bar = 0.0;
 4537: 
 4538: 
 4539:       // Compute tide elevation
 4540:       if (iettype == 3 || iettype == 5) {   
 4541: 
 4542:          if constexpr(iloadtide==1) { // loading tide
 4543:             assert(false && "Loading tide not implemented");
 4544:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4545:          }
 4546:          
 4547:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4548: 
 4549:             const double efa  = nodeBnd->efa[jfr]; 
 4550:             const double emo  = nodeBnd->emo[jfr]; 
 4551: 
 4552:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4553:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4554:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4555: 
 4556:          } // for jfr
 4557: 
 4558:       } // if iettype
 4559: 
 4560:       switch (iettype) {
 4561:          case 1:
 4562:          case 2:
 4563:          case 4:
 4564:             nodeBnd->elbc = r_eic + r_eth;
 4565:             break;
 4566:          case 3:
 4567:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4568:             break;
 4569:          case 5:
 4570:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4571:             break;
 4572:       } // switch
 4573: 
 4574: 
 4575:       //Add inverse barometric effects
 4576:       if (iettype != 0 && inv_atm_bnd == 1) {
 4577:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4578:       }
 4579: 
 4580:    }
 4581: 
 4582: 
 4583:    __global__ void computeHorizontalViscosity(void) { 
 4584: 
 4585:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4586: 
 4587:       SIDE(side);
 4588: 
 4589:       if (side->isDry) return;
 4590: 
 4591:       for (int k = 0; k < nvrt; k++) {
 4592:          side->nuGradU[k] = {0.0, 0.0};
 4593:       }
 4594: 
 4595:       if constexpr(ihorcon == 1) {
 4596:          for (int k = side->kb; k < nvrt - 1; k++) {
 4597:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4598:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4599:             // By Zhang and Baptista.
 4600: 
 4601:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4602:             // This is a standard discretization of the Laplacian operator.
 4603:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4604:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4605:             // Gamma is hvis_coef0 in the code.
 4606:             // The value of gamma needs to be < 0.5.
 4607: 
 4608:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4609:             // side under consideration in each of the two possible elements that share the side.
 4610:             Vector2 sumU = {0.0, 0.0};
 4611:             for (int l = 0; l < 2; l++) {
 4612:                const Element *elem = side->elems[l];
 4613: 
 4614:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4615: 
 4616:                // Find the local index of the side in the element
 4617:                const int idxSide = elem->sideLocalIdx(side);
 4618: 
 4619:                // Find the two sides that are connected to the side under consideration
 4620:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4621:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4622: 
 4623:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4624: 
 4625:             }
 4626: 
 4627:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4628: 
 4629:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4630:    
 4631:          }
 4632:       }
 4633:       else if constexpr(ihorcon == 2) {
 4634:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4635:       }
 4636: 
 4637: 
 4638:    }
 4639: 
 4640: 
 4641:    __global__ void setEssentialBC(void) {
 4642:       // Set essential boundary conditions 
 4643:       NODE(node); // Each boundary node
 4644:       NodeBoundary *nodeBnd = node->nodeBnd;
 4645:       
 4646:  
 4647:       // Check if this node has essential BC
 4648:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4649:          // Verify BC value is valid
 4650:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4651: 
 4652:        
 4653:          // Set diagonal to 1 and zero off-diagonals
 4654:          node->coeffDiag = 1.0;
 4655: 
 4656:          for (int j = 0; j < node->numNodes; j++) {
 4657:                node->coeffMatrix[j] = 0.0;
 4658:          }
 4659:          
 4660:          // Set solution and RHS to BC value
 4661:          node->mX  = nodeBnd->elbc;
 4662:          node->qel = nodeBnd->elbc;
 4663: 
 4664:       } else {
 4665:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4666: 
 4667:          for (int j = 0; j < node->numNodes; j++) {
 4668:                Node* nbNode = node->nodes[j];
 4669:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4670:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4671:                   // Verify neighbor's BC value
 4672:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4673: 
 4674:                   // Subtract contribution to RHS
 4675:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4676:                   node->coeffMatrix[j] = 0.0;  
 4677:                }
 4678:          }
 4679:       }
 4680:    }
 4681: 
 4682: 
 4683:    __global__ void updateElevation(void) {
 4684:       NODE(node);
 4685: 
 4686: 
 4687:       node->eta2 = node->mX;
 4688: 
 4689:       node->updateZCoordData();
 4690:    }
 4691: 
 4692: 
 4693:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4694: 
 4695:       SIDE(side);
 4696: 
 4697:       side->U = {0.0, 0.0}; 
 4698:          
 4699:       if(side->isDry) return;
 4700: 
 4701:       // Vertically integrated velocity U (in ll if ics=2)
 4702:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4703:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4704:          side->U += side->Dz(k + 1)*uc;  
 4705:       }
 4706: 
 4707:    }
 4708: 
 4709:    __global__ void computeBottomDragVegetation(void) {
 4710:       // UNFINISHED. CHECK THIS:
 4711:       // How many kernels are needed? Why so many for loops?
 4712:       // Is the loop on sides needed?
 4713: 
 4714:       NODE(node);
 4715: 
 4716: 
 4717:       const int    kb      = node->kb;
 4718:       const double htot    = node->htot2(); 
 4719:       
 4720:       if (node->isDry) {
 4721:          // Default values for dry nodes
 4722:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4723:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4724: 
 4725:          return;
 4726:        
 4727:       }
 4728: 
 4729:       // Computes bottom drag Cd based on the selected nchi
 4730:       node->computeBottomDragCd();
 4731:       
 4732: 
 4733: 
 4734:       //   Bottom stress in m^2/s^2
 4735:       if (node->rho[kb + 1] >= -98.0)
 4736:       {
 4737:          const double mag_u = length(node->u2[kb + 1]);
 4738:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4739: 
 4740:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4741:          // !sediment erosion: this part needs more documentation
 4742:       }
 4743:     
 4744: 
 4745: 
 4746:       // Compute vegetation parameters
 4747:       //--------------------------------
 4748: 
 4749:       // SAV constants
 4750:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4751:       constexpr double veg_cfpsi = 0.16;
 4752: 
 4753:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4754:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4755: 
 4756:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4757:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4758:          int kbin = 0; // bin index
 4759:          for (int k = kb; k < nvrt; k++) {
 4760:             // Computes node height above the bottom level
 4761:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4762:             assert(false && "Vertical variation of vegetation not implemented");
 4763: 
 4764:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4765:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4766:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4767:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4768:             // } else {
 4769:             //    // Find the bin at which the current vertical level is
 4770:             //    while (kbin<nbins_veg_vert) {
 4771:             //       const double zn = node->z[kbin];
 4772:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4773:             //          break;
 4774:             //       } // if
 4775:             //       kbin++;
 4776:             //    } // while
 4777:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4778: 
 4779:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4780:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4781:                
 4782:             //    // Linear interpolation of the vegetation parameters
 4783:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4784:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4785:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4786:             // } // if rl10
 4787: 
 4788:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4789: 
 4790:          } // for k
 4791: 
 4792: 
 4793:       } else { // Ganthy (iveg==2)
 4794:       //  Modify canopy height, diameter, and density
 4795: 
 4796:          // Make sure there is vegetation on this node
 4797:          if (node->veg_h_unbent > 0.0) {
 4798:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4799: 
 4800:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4801:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4802:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4803: 
 4804:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4805:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4806:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4807:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4808:          } // if veg_h_unbent
 4809: 
 4810:          for (int k = 0; k < nvrt; k++) {
 4811:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4812:          } // for k
 4813:       
 4814: 
 4815:       } // if iveg
 4816:      
 4817: 
 4818:       // Compute vertical mean of veg_alpha3D
 4819:       if (iveg != 0) {
 4820:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4821:          double sum1=0.0;
 4822:          double sum2=0.0;
 4823:          // Integrate over each level under the canopy...
 4824:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4825:             const double Dz = node->Dz(k);
 4826: 
 4827:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4828:             sum2 += Dz;
 4829: 
 4830:          } // for k
 4831:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4832:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4833: 
 4834:       } // if iveg
 4835: 
 4836:    }
 4837: 
 4838:    __global__ void computeVegetationAndDragParameters(void) {
 4839:       // Computes the vegetation and drag model parameters:
 4840:       // chi, \tilde\chi, beta, \breve{H}
 4841:       
 4842:       SIDE(side);
 4843: 
 4844:       side->hhat = 0.0;
 4845:       side->chi2 = 0.0;
 4846:       side->chi = 0.0;
 4847:       side->veg_c2 = 0.0;
 4848:       side->veg_beta = 0.0;
 4849: 
 4850:       if (side->isDry) return;
 4851: 
 4852:       const double htot = side->htot2();
 4853:       const int    kb   = side->kb;
 4854: 
 4855:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4856: 
 4857:       const double veg_h     = side->veg_h();
 4858:       const double veg_nv    = side->veg_nv();
 4859:       const double veg_c     = side->veg_c();
 4860:       const double veg_beta  = side->veg_beta;
 4861:       const double veg_alpha = side->veg_alpha_vert_mean();
 4862: 
 4863:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4864:       // Velocity magnitude at the bottom level
 4865:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4866:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4867:       side->chi2 = side->Cd()*vmag1;
 4868:       side->chi  = side->chi2;
 4869:       if constexpr(iveg != 0) {
 4870:          const Node *n1 = side->n1;
 4871:          const Node *n2 = side->n2;
 4872:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4873:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4874:       }
 4875: 
 4876:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4877: 
 4878:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4879:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4880:       double magUa = 0.0;
 4881:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4882:          // 3D wet side with veg...
 4883: 
 4884:          double magUa = 0.0;
 4885:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4886:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4887: 
 4888:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4889:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4890:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4891: 
 4892:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4893:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4894: 
 4895:                // Velocity magnitude at the bottom (l) of the level
 4896:                const double ul = length(side->u2[k]);
 4897: 
 4898:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4899:                magUa += Dz*0.5*(uh + ul);
 4900: 
 4901:             } // if HasVegetation
 4902:          } // for k
 4903:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4904: 
 4905:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4906:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4907:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4908:             const double zCpy = side->zTopCanopy();
 4909:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4910:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4911:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4912:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4913:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4914:          } // if isSubmerged
 4915:       } // if iveg   
 4916: 
 4917:       // Computes the friction modified depth, \breve{H} in notes
 4918:       if (side->is2D()) { // 2D
 4919: 
 4920:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4921:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4922: 
 4923:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4924: 
 4925:          side->hhat = htot*htot/fricH; 
 4926: 
 4927:       } else { // 3D
 4928:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4929: 
 4930:          if constexpr(iveg != 0) {
 4931:             
 4932:             if (side->isSubmerged()) { 
 4933:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4934:                side->hhat -= veg_c*Hhat_alpha;
 4935: 
 4936:             } else { // Emergent
 4937:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4938:             }
 4939:          } // if iveg
 4940: 
 4941:          // Enforce positivity for 3D model
 4942:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4943:       } // if 3D
 4944: 
 4945:    }
 4946: 
 4947: 
 4948: 
 4949:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4950:    // Computes the density gradient between two elements, e1 and e2.
 4951:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4952:    // zero in the direction normal to the side. 
 4953:    // 
 4954:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4955:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4956:    //
 4957:    // Input:
 4958:    //    e1: Element
 4959:    //    e2: Neighbor element (or nullptr if boundary)
 4960:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4961:    //    k: Index of the half-level at which the density is interpolated
 4962:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4963:    // 
 4964:    // Output:
 4965:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4966:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4967: 
 4968:       if (e2 == nullptr || e2->isDry) {
 4969:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4970: 
 4971:          Side *side = e1->sides[j];
 4972:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4973:                  
 4974:          if constexpr(ics == 1) {
 4975:             vec = side->n; // Normal vector to the side
 4976:          } else {
 4977:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4978:             // IMPLEMENT THIS XXXXXX
 4979:             // !replace with xel, yel?
 4980:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4981:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4982:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4983:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4984:          } //ics
 4985:                    
 4986:          diffRho = 0.0;
 4987: 
 4988:       } else { //internal and wet
 4989:          if constexpr(ics==1) {
 4990:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4991: 
 4992:             // Vector from e1 to e2
 4993:             vec = e2->center - e1->center;
 4994: 
 4995:          } else { 
 4996:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4997:             // IMPLEMENT THIS XXXXXX
 4998:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4999:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5000:             //                   alow(j)=xctr2
 5001:             //                   bdia(j)=yctr2
 5002:          } // ics
 5003: 
 5004:          diffRho = rho2 - e1->demeanedDensity(k);
 5005:       }
 5006: 
 5007:    }
 5008: 
 5009:    __global__ void computeDensityCubicSplines(void) {
 5010:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5011: 
 5012:       ELEM(elem);
 5013: 
 5014:       if (elem->isDry) return;
 5015: 
 5016:       const int kb = elem->kb;
 5017: 
 5018:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5019:       if (elem->is2D()) {
 5020:          // In the 2D case, the density is constant at the prism level. 
 5021:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5022:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5023:       } else { //3D
 5024: 
 5025:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5026:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5027:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5028:          ///// XXXX CHECK INDICES!!!!!
 5029:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5030:       } // 2D/3D
 5031: 
 5032:    }
 5033: } // extern "C"
 5034: 
 5035: 
 5036: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5037: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5038: 
 5039:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5040: 
 5041:    const int kb  = elem->kb;
 5042:    const int kb2 = elem2->kb;
 5043: 
 5044:    // z-coordinate of prism of elem
 5045:    const double zp = elem->z_prism(k);
 5046: 
 5047:    double rho = 0.0;
 5048: 
 5049:    if (elem2->is2D()) {
 5050:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5051: 
 5052:    } else {  // 3D
 5053: 
 5054:       // eta_min may be < zmax
 5055:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5056:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5057: 
 5058:       // (Extrapolate density below bottom, we will fix it later)
 5059:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5060:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5061:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5062:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5063:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5064:    } // 2D/3D
 5065:      
 5066: 
 5067:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5068:    // Now we need to fix it.
 5069:    if (elem->z[k] < elem2->z[kb2]) {
 5070:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5071: 
 5072:       // There are two methods to adjust the density at the bottom of the element.
 5073:       // iunder_deep=0: 
 5074:       const double depth1 = abs(elem->z[kb]); // larger depth
 5075: 
 5076:       if (iunder_deep==0) {
 5077: 
 5078:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5079: 
 5080:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5081: 
 5082:       } else { // iunder_deep != 0
 5083: 
 5084:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5085: 
 5086:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5087: 
 5088:          //   Demeaned density at the same z coordinate as
 5089:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5090:          }
 5091: 
 5092:       } // if iunder_deep
 5093:    } // if elem->z[kb] < elem2->z[kb]
 5094: 
 5095:    return rho;
 5096: }
 5097: 
 5098: 
 5099: extern "C" {
 5100:    __global__ void computeDensityGradient(void) {
 5101: 
 5102:       if constexpr(ibc != 0) return;
 5103: 
 5104:          // Compute the horizontal density gradient at each element.
 5105:       // It works in two steps:
 5106:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5107:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5108:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5109:       //             gradRho.r1 = rho1 - rho0
 5110:       //             gradRho.r2 = rho2 - rho0
 5111:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5112:       // 
 5113:       //  NOTE: We use de-meaned densities.
 5114: 
 5115:       ELEM(elem);
 5116: 
 5117:       if (elem->isDry) return;
 5118: 
 5119:       const int kb  = elem->kb;
 5120:       const int i34 = elem->i34;
 5121: 
 5122:       for (int k = kb + 1; k < nvrt; k++) {
 5123:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5124:          //             gradRho.r1 = rho1 - rho0
 5125:          //             gradRho.r2 = rho2 - rho0
 5126:          int icount = 0;
 5127:          double sumRx = 0.0;
 5128:          double sumRy = 0.0;
 5129:          for (int j1=0; j1<i34; j1++) { 
 5130: 
 5131:             const int j2 = elem->nxq(j1 + 1);
 5132: 
 5133:             // Pairs of consecutive neighbor elements of elem
 5134:             const Element *e1 = elem->nghbElems[j1];
 5135:             const Element *e2 = elem->nghbElems[j2];
 5136: 
 5137:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5138:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5139:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5140: 
 5141:             // Compute the density difference and the vector from elem to e1 and e2
 5142:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5143:             double diffRho1, diffRho2;
 5144:             Vector2 vec1, vec2;
 5145:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5146:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5147: 
 5148:             const double rl1 = length(vec1);
 5149:             const double rl2 = length(vec2);
 5150:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5151: 
 5152:             const double delta = cross(vec1, vec2);
 5153:             const double sintheta = abs(delta)/(rl1*rl2);
 5154: 
 5155:             // To avoid problems, avoid elements with small angle between vectors
 5156:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5157:             const bool validEq = (sintheta > sin_one_deg);
 5158: 
 5159:             if (validEq) {
 5160:                // Solve the system of equations to get the density gradient at elem
 5161:                icount++;
 5162:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5163:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5164:                sumRx += Rx;
 5165:                sumRy += Ry;
 5166:             }
 5167:          } // for j1
 5168: 
 5169:          // Compute the average density gradient at elem
 5170:          if (icount==0) {
 5171:            // Bad mesh quality; bail out with 0 b-cc
 5172:            elem->gradRho[k] = {0.0, 0.0};
 5173:          } else {
 5174:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5175:          }
 5176: 
 5177:       } // for k
 5178: 
 5179:    }
 5180: 
 5181:    __global__ void computeBaroclinicTerm(void) {
 5182:    // Computes the baroclinic term at sides (at half levels).
 5183:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5184:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5185: 
 5186:       if (ibc == 1) return;
 5187: 
 5188:       SIDE(side);
 5189: 
 5190:       if (side->isDry) return;
 5191: 
 5192:       const Element *e1 = side->elems[0];
 5193:       const Element *e2 = side->elems[1];      
 5194:       const int kb = side->kb;
 5195:       
 5196:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5197: 
 5198:       // interpolates vertically the density gradient of the two elements at the half level/
 5199: 
 5200:       int k1 = max(kb, nvrt / 2);
 5201:       int k2 = max(kb, nvrt / 2);
 5202: 
 5203:       // Starts the integration at the surface and goes down to the bottom
 5204:       side->bcc[nvrt-1] = {0.0, 0.0};
 5205:       for (int k = nvrt - 2; k >= kb; k--) {
 5206:       // For each prism level (from surface to bottom)...
 5207: 
 5208:          // For both elements, interpolate density gradient at the side's half level.
 5209:          // The gradient at the side is the average of the gradients at the elements.
 5210:          // w1, w2 are used to take into account boundary sides, with just one element.
 5211:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5212:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5213:          const double wsum = w1 + w2;
 5214:          w1 = w1/wsum;
 5215:          w2 = w2/wsum;
 5216:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5217: 
 5218:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5219:          Vector2 gradRho = {0.0, 0.0};
 5220:          if (e1 != nullptr && k > kb) {
 5221:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5222:             
 5223:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5224:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5225:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5226: 
 5227:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5228:          }      
 5229:          if (e2 != nullptr && k > kb) {
 5230:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5231:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5232:             
 5233:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5234:          }
 5235: 
 5236:          if constexpr(ics==2) {
 5237:             assert(false && "Not implemented: ics == 2");
 5238:             // IMPLEMENT THIS XXXXXX
 5239:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5240:             // swild(1)=tmp1
 5241:             // swild(2)=tmp2
 5242:          }
 5243:          
 5244:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5245:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5246:          // CHECK INDICES!!! XXX
 5247:          const double grav3 = side->grav3();
 5248:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5249: 
 5250:       } // for
 5251: 
 5252:    }
 5253: 
 5254: 
 5255: 
 5256:    __global__ void computeHorGradientAtSide(void) {
 5257: 
 5258:       // Compute the horizontal density gradient at each element.
 5259:       // It works in two steps:
 5260:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5261:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5262:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5263:       //             gradRho.r1 = rho1 - rho0
 5264:       //             gradRho.r2 = rho2 - rho0
 5265:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5266:       // 
 5267:       //  NOTE: We use de-meaned densities.
 5268: 
 5269:       SIDE(side);
 5270: 
 5271: 
 5272:       if (side->isDry) return;
 5273: 
 5274:       // Computes the gradient of the variables at the side center.
 5275:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5276:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5277:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5278: 
 5279:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5280:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5281:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5282:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5283: 
 5284:    }
 5285: 
 5286: 
 5287:    __global__ void solveMomentumEquations(double time) {
 5288: 
 5289:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5290:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5291: 
 5292:       SIDE(side);
 5293: 
 5294:       if (side->isDry) 
 5295:       {
 5296:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5297: 
 5298:          return;
 5299:       }
 5300: 
 5301:       const Node *n1 = side->n1;
 5302:       const Node *n2 = side->n2;
 5303: 
 5304:       const int kb = side->kb;
 5305: 
 5306:       const double veg_h = side->veg_h();
 5307:       const double grav3 = side->grav3();
 5308: 
 5309:       if (side->is2D()) {
 5310:          // Remember: Do not use htot2, which is updated.
 5311:          const double htot = side->htot1();
 5312:          const double hhat = side->hhat;
 5313: 
 5314:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5315: 
 5316:          Vector2 tau2 = {0.0, 0.0};
 5317:           
 5318:          if constexpr(ics==1) {
 5319:             tau2 = side->tau();
 5320: 
 5321:          } else {
 5322:             assert(false && "Not implemented: ics == 2");
 5323:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5324:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5325:             // taux2=(vn1+tt1)*0.5d0
 5326:             // tauy2=(vn2+ss1)*0.5d0
 5327:          } // if ics         
 5328: 
 5329:          // hat_gam has units of m/s
 5330: 
 5331:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5332:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5333:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5334: 
 5335:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5336: 
 5337: 
 5338:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5339: 
 5340:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5341: 
 5342:       }
 5343:       else { // 3D
 5344: 
 5345:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5346:          // 
 5347:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5348:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5349:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5350:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5351:          // k+1 and k.
 5352: 
 5353: 
 5354:          const int ndim = nvrt - kb;
 5355:          const double zTopCanopy = side->zTopCanopy();
 5356: 
 5357:          // Initialize the tridiagonal system
 5358:          for (int k = kb + 1; k < nvrt; k++) {
 5359:             
 5360:             const int kin = k - (kb + 1);
 5361: 
 5362:             // Vertical viscosity at the face center
 5363:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5364: 
 5365:  
 5366:             alow[kin] = 0.0;
 5367:             cupp[kin] = 0.0;
 5368:             bdia[kin] = 0.0;
 5369: 
 5370:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5371:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5372: 
 5373:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5374:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5375:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5376: 
 5377:             // First part: layers k, k+1
 5378:             if (k < nvrt - 1) {
 5379:                              
 5380:                if constexpr(iveg != 0) {
 5381: 
 5382:                   // If there is vegetation at this level...
 5383:                   if (zTopCanopy > side->zc[k]) {
 5384:                      // If the canopy is above the k layer...
 5385:                      
 5386:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5387:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5388:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5389:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5390: 
 5391:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5392:                      const double vmag2 = length(ut2);
 5393:                      const double vmag1 = length(side->u2[k]);
 5394:                      const double vmag = 0.5*(vmag1 + vmag2);
 5395:                      
 5396:                      // Computes the vegetation alpha at the face center
 5397:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5398: 
 5399:                      cff1 += veg_alpha_sd*dt*vmag;
 5400: 
 5401:                   } // if (zTopCanopy
 5402:                } // if iveg
 5403: 
 5404:                const double dzz = side->Dz(k + 1);
 5405:                const double tmp = dt*dfz/dzz;
 5406:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5407: 
 5408:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5409:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5410:             }
 5411: 
 5412: 
 5413:             // Second part: layers k-1, k
 5414:             if (k > kb + 1) {
 5415: 
 5416:                double cff1 = 1.0; //init \bar{c^k}
 5417: 
 5418:                if constexpr(iveg != 0) {
 5419:                   // If there is vegetation at this level...
 5420:                   if (zTopCanopy > side->zc[k-1]) {
 5421:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5422:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5423: 
 5424:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5425: 
 5426:                      const double vmag2 = length(ut2);
 5427:                      const double vmag1 = length(side->u2[k-1]);
 5428:                      const double vmag = 0.5*(vmag1 + vmag2);
 5429: 
 5430:                      // Computes the vegetation alpha at the face center
 5431:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5432:                      cff1 += veg_alpha_sd*dt*vmag;
 5433:                   } // if zTopCanopy
 5434: 
 5435:                } // if iveg
 5436: 
 5437:                const double dzz = side->Dz(k);
 5438:                const double tmp = dt*dfz/dzz;
 5439:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5440: 
 5441:                alow[kin] += cff1*dzz/6.0 - tmp;
 5442:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5443: 
 5444:             } else { // Bottom boundary
 5445:                // This occurs at the bottom, where the bottom drag is applied.
 5446: 
 5447:                bdia[kin] += dt*side->chi2; // XXXX
 5448: 
 5449:             } // if (k > kb + 1)
 5450: 
 5451: 
 5452:          } // for (int k
 5453: 
 5454: 
 5455: 
 5456:          // Computes the RHS.
 5457:          // -----------------
 5458: 
 5459:          //	BC to be imposed at the end.
 5460: 
 5461:          const Vector2 gradETP  = side->gradETP;
 5462:          const Vector2 gradPr   = side->gradPr;
 5463:          const Vector2 gradEta1 = side->gradEta1;
 5464:          const Vector2 gradEta2 = side->gradEta2;
 5465: 
 5466:          const Vector2 *btu = side->btu;
 5467:          const Vector2 *u2  = side->u2;
 5468:          const double coriolis = side->coriolis;
 5469:          const Vector2 *nuGradU = side->nuGradU;
 5470: 
 5471: 
 5472:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5473:          for (int k = kb + 1; k < nvrt; k++) {
 5474:             const int kin = k - kb - 1;
 5475: 
 5476:             const double dz_0 = side->Dz(k);
 5477:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5478: 
 5479:             rrhs[kin] = {0.0, 0.0};
 5480:             double dz = 0.0;
 5481: 
 5482:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5483:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5484:             if (k < nvrt  ) dz += dz_1;
 5485:             if (k > kb + 1) dz += dz_0;
 5486: 
 5487:             // Elevation gradient, atmospheric pressure and tidal potential
 5488:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5489: 
 5490:             // Coriolis, advection, wind stress, and horizontal viscosity
 5491:             if (k < nvrt - 1) {
 5492: 
 5493: 
 5494:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5495:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5496:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5497:                                                 
 5498: 
 5499:                //diff stress tensors 1006
 5500:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5501:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5502:                   assert(false && "Not implemented: itur == 5");
 5503:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5504:                }
 5505:                // else assert(false && "itur # Not implemented");
 5506: 
 5507:             } else { // k == nvrt - 1 SURFACE
 5508:                Vector2 tau2 = {0.0, 0.0};
 5509:                if constexpr(ics==1) {
 5510:                   tau2 = side->tau();
 5511:       
 5512:                } else {
 5513:                   assert(false && "Not implemented: ics == 2");
 5514:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5515:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5516:                   // taux2=(vn1+tt1)*0.5d0
 5517:                   // tauy2=(vn2+ss1)*0.5d0
 5518:                } // if ics
 5519: 
 5520:                rrhs[kin] += dt*tau2;
 5521:           
 5522: 
 5523:             } // if k<nvrt
 5524: 
 5525: 
 5526:             if (k > kb + 1) {
 5527:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5528:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5529:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5530: 
 5531:                // diff stress tensors 1006
 5532:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5533:                   assert(false && "Not implemented: itur == 5");
 5534:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5535:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5536:                }
 5537:                // else assert(false && "itur # Not implemented");
 5538: 
 5539: 
 5540:             } // if k>kbs + 1
 5541: 
 5542:             // Baroclinic
 5543:             Vector2 *bcc = side->bcc;
 5544:             if constexpr(ibc == 0) {
 5545:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5546:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5547: 
 5548:             } // if ibc==0
 5549: 
 5550:          } // k=kb + 1,nvrt
 5551: 
 5552: 
 5553:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5554: 
 5555:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5556:             const int kin = k - kb - 1;
 5557:    
 5558:             // Velocity is always clamped to maximum values
 5559:             side->u2[k] = clampVelocity(soln[kin]);
 5560:          } // k
 5561: 
 5562:       } // if side->is2D()
 5563:       
 5564: 
 5565:       // Impose velocity boundary condition at the bottom
 5566:       if constexpr(imm == 2) { // 3D bed deformation model
 5567:          double dep;
 5568:          Vector2 vel;
 5569: 
 5570:          assert(false && "Not implemented: imm == 2");
 5571:          //update_bdef(time, x0, y0, dep, vel);
 5572:          // side->u2[kb] = vel;
 5573: 
 5574:       } else { // imm = 0 or 1
 5575:          if (side->Cd() == 0.0) {
 5576:             side->u2[kb] = side->u2[kb + 1];
 5577: 
 5578:          } else if (side->is3D()) { // 3D no slip bottom   
 5579:             side->u2[kb] = {0.0, 0.0};
 5580: 
 5581:          }
 5582:           
 5583:       } // if imm
 5584: 
 5585:       // The velocities below the bottom level are set to zero
 5586:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5587: 
 5588: 
 5589:    }
 5590: 
 5591: 
 5592:    __global__ void applyMomentumBC(void) {
 5593: 
 5594:       SIDE_BND(sideBnd);
 5595: 
 5596:       Side *side = sideBnd->side;
 5597:       const BoundarySegment *segment = sideBnd->segment;
 5598:       const Node *n1 = side->n1;
 5599:       const Node *n2 = side->n2;
 5600: 
 5601:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5602: 
 5603:       const bool isLand = segment->isLand;
 5604:       const int ifltype = segment->ifltype;
 5605: 
 5606:       const int kb = side->kb;
 5607: 
 5608: 
 5609:       if (!isLand && ifltype != 0) {
 5610:          const Vector2 *ubc = sideBnd->ubc;
 5611:   
 5612:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5613:             
 5614:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5615:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5616: 
 5617:             if (ifltype == -1) {
 5618:                // Flather 1
 5619: 
 5620:                const double depth = side->depth();
 5621: 
 5622:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5623: 
 5624:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5625: 
 5626:                side->u2[k] = vnorm*side->n;
 5627: 
 5628:             } else if (ifltype == -2) { // Discharge
 5629: 
 5630:                const double eta1 = side->eta1();
 5631:                const double eta2 = side->eta2();
 5632:                const double htot = side->htot2();
 5633: 
 5634:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5635:                assert(false && "Not implemented: Discharge bc");
 5636:                // const double dischrg = discharge(eta1);
 5637:                const double dischrg = 0.0; // XXX REMOVE
 5638:                
 5639: 
 5640:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5641: 
 5642:                const double vnorm = dischrg*eta2/htot;
 5643: 
 5644:                side->u2[k] = vnorm*side->n;
 5645: 
 5646:             }
 5647:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5648:                const double vnorm = dot(side->u2[k], side->n);
 5649: 
 5650:                double rat;
 5651:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5652:                else              rat = segment->vobc2; // outgoing
 5653: 
 5654:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5655: 
 5656:             }
 5657:             else { // not Flather or 3D radiation
 5658:                side->u2[k] = ubc[k];
 5659: 
 5660:             } // if (segment->ifltype...
 5661: 
 5662:          }
 5663: 
 5664:       }
 5665:       else if (isLand) { // if it is land boundary side
 5666: 
 5667:          if constexpr(islip == 0) { // free slip
 5668: 
 5669:             for (int k = kb; k < nvrt; k++) {
 5670: 
 5671:                const Vector2 t = side->t();
 5672:                const Vector2 n = side->n;
 5673: 
 5674:                double vnorm = 0.0; // for most cases
 5675:                const double vtan = dot(side->u2[k], t);
 5676:                
 5677:                side->u2[k] = vtan*t - vnorm*n;
 5678: 
 5679:             }
 5680: 
 5681:          } else { // no slip
 5682:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5683: 
 5684:          }
 5685:       } // if (side segment type...
 5686: 
 5687:    
 5688: 
 5689:    }
 5690: 
 5691: 
 5692:    __global__ void shapiroFilter1(void) {
 5693:       // First step of the Shapiro filter (normally used if indvel<=0)
 5694:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5695: 
 5696:       SIDE(side);
 5697: 
 5698:       // Only internal wet sides are processed
 5699:       if (side->isDry || !(side->isInternal())) return;
 5700: 
 5701:       const int kb = side->kb;
 5702: 
 5703:       for (int mm = 0; mm < niter_shap; mm++) {
 5704: 
 5705:          for (int k = kb + 1; k < nvrt; k++) {
 5706:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5707:             Vector2 suru = {0.0, 0.0};
 5708: 
 5709:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5710: 
 5711:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5712: 
 5713:                int kin = k;
 5714:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5715:                
 5716:                if constexpr(ics==1) {
 5717:                   suru += nSide->u2[kin];
 5718: 
 5719:                } else {
 5720:                   assert(false && "Not implemented: ics == 2");
 5721:                   // Vector2 vn1, vn2;
 5722:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5723:                   // suru=suru+vn1;
 5724:                   // surv=surv+vn2;
 5725:                }
 5726:             }
 5727: 
 5728:             // Reusing bcc as a temporary array to store the suru values.
 5729:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5730: 
 5731:          }
 5732:       }
 5733:    }
 5734: 
 5735:    __global__ void shapiroFilter2(void) {
 5736:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5737: 
 5738:       SIDE(side);
 5739: 
 5740: 
 5741:       if (side->isDry || !(side->isInternal())) return;
 5742: 
 5743:       const int kb = side->kb;
 5744: 
 5745:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5746: 
 5747:       if (side->is2D()) {
 5748:          side->u2[kb + 1] = side->bcc[kb + 1];
 5749:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5750: 
 5751:       } else {
 5752:          // 3D
 5753:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5754:          
 5755:       }
 5756: 
 5757:    }
 5758: 
 5759: 
 5760:    __global__ void ul0UpdateZCoords(void) {
 5761:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5762:       
 5763:       NODE(node);      
 5764: 
 5765: 
 5766:       if (false) { //node->isDry) { XXXXXXX
 5767: 
 5768:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5769: 
 5770:          if constexpr(ivcor != 1) node->kb = 0;
 5771: 
 5772:       } else {
 5773: 
 5774:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5775:          node->updateKb();
 5776: 
 5777:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5778: 
 5779:       }
 5780: 
 5781:       // We use the temp.b field to store the previous state of isDry.
 5782:       node->tmp.b = node->isDry;
 5783: 
 5784:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5785:       node->isDry = true;
 5786: 
 5787:    }
 5788: 
 5789:    __global__ void ul0ComputeDryElements(void)
 5790:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5791:    {
 5792:       ELEM(elem);
 5793: 
 5794:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5795: 
 5796:       elem->kb = 0;
 5797: 
 5798:       if (elem->isDry) return;
 5799: 
 5800: 
 5801:    //    if(elem->isDry2()) { // XXXX
 5802:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5803:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5804:    //        call parallel_abort(errmsg)
 5805:    //    }
 5806: 
 5807:       const Node *n1 = elem->nodes[0];
 5808:       const Node *n2 = elem->nodes[1];
 5809:       const Node *n3 = elem->nodes[2];  
 5810:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5811: 
 5812:       // Computes element's kb as the minimum of the nodes' kb.
 5813:       const int kb1 = n1->kb;
 5814:       const int kb2 = n2->kb;
 5815:       const int kb3 = n3->kb;
 5816:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5817: 
 5818: 
 5819:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5820: 
 5821: 
 5822:       // Computes the element z as the mean of the nodes z.
 5823:       for (int k = elem->kb; k < nvrt; k++) {
 5824: 
 5825:          // Compute the element z as the mean of the nodes z.
 5826:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5827:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5828:          elem->z[k] /= elem->i34;
 5829: 
 5830:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5831:       }
 5832:                   
 5833:    }
 5834: 
 5835:    __global__ void ul0ComputeDryNodes(void)
 5836:    // Updates node's isDry based on the elements' isDry. 
 5837:    {
 5838:       NODE(node);
 5839: 
 5840:       node->isDry = true;
 5841: 
 5842:       // A node is wet if at least one of the elements sharing it is wet.
 5843:       for (int j = 0; j < node->numElements; j++) {
 5844:          const Element *elem = node->elements[j];
 5845:          if (!elem->isDry) {
 5846:             node->isDry = false;
 5847:             break;
 5848:          }
 5849:       }
 5850: 
 5851:        
 5852:    }
 5853: 
 5854: 
 5855:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5856:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5857:    // node->tmp.b is true if the node was previously dry.
 5858:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5859:    {
 5860:       NODE(node);
 5861:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5862: 
 5863:       // Avoid this the first time step.
 5864:       if (it == iths) return;  
 5865: 
 5866:       const bool wasDry = node->tmp.b;
 5867: 
 5868: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5869: 
 5870:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5871: 
 5872:          for (int k=0; k < nvrt; k++) {
 5873: 
 5874:             Vector3 utmp={0.0, 0.0, 0.0};
 5875: 
 5876:             double ttmp=0.0;
 5877:             double stmp=0.0;
 5878:             int icount=0;
 5879:             for (int j = 0; j < node->numNodes; j++) {
 5880: 
 5881:                const Node *nbrNode = node->nodes[j];
 5882:                
 5883:                const bool wasNbrDry = nbrNode->tmp.b;
 5884: 
 5885:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5886:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5887: 
 5888:                   icount++;
 5889: 
 5890:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5891:                   utmp += nbrNode->uvw2(k);
 5892:                   
 5893:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5894:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5895:                }
 5896:             }
 5897: 
 5898:             if (icount > 0) {
 5899:                const double inv_icount = 1.0/icount;
 5900:                utmp = inv_icount*utmp;
 5901:                node->u2[k]     = toVector2(utmp);
 5902:                node->w2[k]     = utmp.z;
 5903:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5904:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5905:             } else {
 5906:                node->u2[k] = {0.0, 0.0};
 5907:                node->w2[k] = 0.0;
 5908:                // Initialize tracers to 0.0??? XXXXX
 5909:             }
 5910:          }
 5911:       }
 5912:    }
 5913: 
 5914:   
 5915:    
 5916: 
 5917: 
 5918:    __global__ void ul0UpdateSides(int it, int iths) {
 5919:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5920:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5921:    // The dryness of the sides is updated in ul0UpdateSides2.
 5922: 
 5923:       SIDE(side);
 5924: 
 5925:       // A side is wet if and only if at least one of its elements is wet.
 5926:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5927:  
 5928:       const Node *n1 = side->n1;
 5929:       const Node *n2 = side->n2;
 5930:      
 5931:       const int kb1 = n1->kb;
 5932:       const int kb2 = n2->kb;
 5933: 
 5934:       side->kb = 0; // default when dry
 5935: 
 5936:       if (isWet) {
 5937: 
 5938:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5939: 
 5940:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5941: 
 5942:          side->kb = min(kb1, kb2);
 5943: 
 5944:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5945: 
 5946:          for (int k = side->kb; k < nvrt; k++) {
 5947:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5948: 
 5949:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5950: 
 5951:             // Compute velocity for re-wetted sides 
 5952:             if ((it != iths) && (side->isDry && isWet)) {
 5953: 
 5954:                Vector2 utmp={0.0, 0.0};
 5955: 
 5956:                int icount=0;
 5957: 
 5958:                // For all the sides on the two elements that share this side
 5959:                for (int j = 0; j < 2; j++) {
 5960:                   const Element *elem = side->elems[j];
 5961:                   if (elem == nullptr) continue;
 5962: 
 5963:                   for (int jj=0; jj < elem->i34; jj++) {
 5964:                      const Side *nSide = elem->sides[jj];
 5965:                      if (nSide->isDry) continue;
 5966: 
 5967:                      icount++;
 5968:                      utmp += nSide->u2[k];  
 5969:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5970:                   }
 5971:                }
 5972:                   
 5973:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 5974:                if (icount > 0)  side->u2[k] = utmp/icount;
 5975:                else             side->u2[k] = {0.0, 0.0};
 5976:                   
 5977:             } // if ((it != iths) && (side->isDry && isWet))
 5978: 
 5979:          } // for k
 5980: 
 5981:       } // if isWet 
 5982:       
 5983: 
 5984: 
 5985:    }
 5986: 
 5987:    __global__ void ul0UpdateSides2(void) {
 5988:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5989:    
 5990:          SIDE(side);
 5991:    
 5992:          const Element *e1 = side->elems[0];
 5993:          const Element *e2 = side->elems[1];
 5994: 
 5995:          // A side is wet if and only if at least one of its elements is wet.
 5996:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5997: 
 5998:          // Update the side's dryness
 5999:          side->isDry = !isWet;
 6000: 
 6001:    }
 6002: 
 6003: 
 6004:    __global__ void zeroNodalVelocities(void) {
 6005:       NODE(node);
 6006: 
 6007:       for (int k = 0; k < nvrt; k++) {
 6008:          node->u2[k]   = {0.0, 0.0};
 6009:          node->w2[k]   = 0.0;
 6010:          node->utmp[k] = {0.0, 0.0};
 6011:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6012:       }
 6013:    }
 6014:  
 6015: 
 6016:    __global__ void computeNodalVerticalVelocities1(void) {
 6017:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6018:    // Adds the element's vertical velocity times the element's area.
 6019:       ELEM(elem);
 6020: 
 6021:       for (int j = 0; j < elem->i34; j++) {
 6022:          Node *node = elem->nodes[j];
 6023: 
 6024:          for (int k = node->kb; k < nvrt; k++) {
 6025:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6026:          }
 6027:          atomicAdd(&(node->tmp.d), elem->area);
 6028:       }
 6029:    }
 6030: 
 6031:    __global__ void computeNodalVerticalVelocities2(void) {
 6032:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6033:    // Divides by the total area of the elements sharing the    node.
 6034:       NODE(node);
 6035: 
 6036:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6037: 
 6038:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6039:    }
 6040: 
 6041: 
 6042:    __global__ void computeNodalHorizontalVelocities1(void) {
 6043: 
 6044:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6045:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6046: 
 6047:       ELEM(elem);
 6048: 
 6049:       if (elem->isDry) return;
 6050: 
 6051:       const int kb = elem->kb;
 6052:       const bool isTri = elem->isTri();
 6053: 
 6054:       if constexpr(indvel <= 0) {
 6055:          // Assuming discontinous hvel.
 6056: 
 6057:          if (isTri) { // For triangles
 6058:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6059:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6060: 
 6061:             for (int j = 0; j < 3; j++) {
 6062:                // For every node of the triangle...
 6063:                Node *node = elem->nodes[j];
 6064: 
 6065:                if (node->isDry) continue;
 6066: 
 6067:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6068:                const Side *s2 = elem->sides[(j + 1) % 3];
 6069:                const Side *s3 = elem->sides[(j + 2) % 3];
 6070: 
 6071:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6072: 
 6073:                atomicAdd(&(node->tmp.i), 1);
 6074: 
 6075:                for (int k = kb; k < nvrt; k++)  {
 6076:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6077:                   u = clampVelocity(u);
 6078:                   atomicAdd(&(node->utmp[k].x), u.x);
 6079:                   atomicAdd(&(node->utmp[k].y), u.y);
 6080: 
 6081:                }
 6082: 
 6083:             }
 6084:          }
 6085:          else { // For quads
 6086:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6087: 
 6088:          }
 6089: 
 6090:       }
 6091:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6092:       
 6093:    }
 6094: 
 6095: 
 6096:    __global__ void computeNodalHorizontalVelocities2(void) {
 6097:       NODE(node);
 6098: 
 6099:       const int nodeCount = node->tmp.i;
 6100: 
 6101:       if (nodeCount == 0) 
 6102:       {
 6103:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6104:          return;
 6105:       }
 6106: 
 6107:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6108:       
 6109:       const int kb = node->kb;
 6110: 
 6111:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6112:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6113:       
 6114:       
 6115:    }   
 6116: 
 6117:  
 6118: 
 6119:    __global__ void resetVelocityOpenBndNodes(void) {
 6120:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6121: 
 6122:       NODE_BND(nodebnd);
 6123: 
 6124:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6125:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6126:       }
 6127: 
 6128:    }
 6129: 
 6130: 
 6131:    __global__ void setVelocityOpenBndNodes(void) {
 6132:    // For open boundary nodes sets their velocity to the imposed values.
 6133: 
 6134:       SIDE_BND(sidebnd);
 6135: 
 6136:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6137:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6138:          // to its segment to the average of the side velocity.
 6139: 
 6140:          for (int k = 0; k < nvrt; k++) {
 6141:             Node *n1 = sidebnd->side->n1;
 6142:             Node *n2 = sidebnd->side->n2;
 6143: 
 6144: 
 6145:             Vector2 n1_u2(n1->u2[k]);
 6146:             Vector2 n2_u2(n2->u2[k]);
 6147: 
 6148:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6149:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6150:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6151:             }
 6152:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6153:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6154:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6155:             }
 6156: 
 6157:          }
 6158: 
 6159:       }
 6160: 
 6161:    }
 6162: 
 6163: 
 6164:    __global__ void computeVerticalVelocity(void) {
 6165:       // Computes the vertical velocity at the (2D) element's centroid.
 6166:       // In this function we will be considering volumetric elements, with side faces and a 
 6167:       // bottom and a top face. We will call them SFs, BF and TF.
 6168:       // It computes the flux coming from BF and the SFs.
 6169:       // If the bed is moving, it takes that into account.
 6170:       // Since water is incompressible, the integral of the velocity times the normal vector
 6171:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6172:       // and the BF is equal to the flux going out from the TF.
 6173:       // TF = - BF - sum(SFs).
 6174:       // It then computes the horizontal velocity at the center of TF.
 6175:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6176:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6177:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6178: 
 6179:       ELEM(elem);
 6180: 
 6181:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6182: 
 6183:       if (elem->isDry) return;
 6184: 
 6185:       const int kb = elem->kb;
 6186:       const bool isTri = elem->isTri();
 6187: 
 6188:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6189: 
 6190:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6191:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6192:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6193: 
 6194:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6195: 
 6196:       double area3D;
 6197: 
 6198:       // Bottom face flux
 6199:       double bottomFlux = 0.0;
 6200:       Vector2 u2meanBottom = {0.0, 0.0};
 6201:       const Vector2 gradh = elem->grad2(&Node::depth);
 6202:       if constexpr(imm==2) {
 6203:          Vector3 ubed;
 6204: 
 6205:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6206:          // updateBDEF(ubed);
 6207:      
 6208:          // const double bflux0 = dot(ubed, elem_n1);
 6209: 
 6210:          // elem->w[kb] += ubed.z;
 6211:       }
 6212:       else {
 6213:          Vector2 umean;
 6214:          if constexpr(ics == 1) {
 6215:             u2meanBottom = elem->mean(kb, &Side::u2);
 6216:          }
 6217:          else {
 6218:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6219:          }
 6220: 
 6221:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6222:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6223: 
 6224:          bottomFlux = - dot(gradh, u2meanBottom);
 6225:       } // if imm
 6226: 
 6227:       // Compute w for kb+1 to nvrt-1
 6228:       for (int l = kb; l < nvrt - 1; l++) {
 6229: 
 6230:          // normal vector to the top face of the "volumetric" element (3D)
 6231:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6232: 
 6233:          // Compute the total flux at the sides
 6234:          double sideFlux = 0.0;
 6235: 
 6236:          for (int j = 0; j < elem->i34; j++) {
 6237:             const Side *side = elem->sides[j];
 6238: 
 6239:             const double sideArea = side->area(l);
 6240:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6241:             const double sign = elem->ssign[j]; 
 6242: 
 6243:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6244:          }
 6245:          
 6246:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6247:          //velocities at the centers of the sides
 6248:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6249: 
 6250:          // The flx at the top ace can be computed from the other flows.
 6251:          const double topFlux = - sideFlux - bottomFlux;
 6252:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6253: 
 6254:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6255: 
 6256:          elem_n1 = elem_n2;
 6257: 
 6258:          bottomFlux = - topFlux;
 6259:       }
 6260:    }  
 6261: 
 6262: 
 6263: 
 6264: 
 6265: 
 6266: 
 6267: 
 6268: // !===============================================================================
 6269: // !===============================================================================
 6270: 
 6271: } // extern "C"
 6272: 
 6273: #ifdef DONTCOMPILE
 6274: __device__ void computeVerticalAdvection(void) {
 6275:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6276: 
 6277:    sdbt(1:2,:,:)=0.d0
 6278: 
 6279:    const Side *side = FROM kernel;
 6280: 
 6281:    if(side->isDry) return;
 6282: 
 6283:    // If side is wet...
 6284: 
 6285: 
 6286:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6287:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6288:    double ws[nvrt] = {} // w @ side
 6289:    int icount = 0;
 6290:    for (int j=0; j<2; j++) {
 6291:       const Element *elem = side->elements[j];
 6292:        
 6293:       if(elem != nullptr) {
 6294:          icount++;
 6295:          for (int k=0; k<nvrt; k++) {
 6296:             ws[k] = ws[k] + elem->w[k];
 6297:          }
 6298:       }
 6299:    }  // for j
 6300: 
 6301:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6302:    ws = ws/icount;
 6303: 
 6304:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6305:    // Splines allow for a smooth transition between vertical levels.
 6306:    // Splines have continuity restrictions at the internal knots, but
 6307:    // we have to provide the 1st derivatives at the endpoints.
 6308:    const int kbs = side->kbs; 
 6309:    
 6310:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6311:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6312:    initCubicSpline(kbs, nvrt, side, ws, up)
 6313: 
 6314:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6315:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6316:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6317: 
 6318:    // Total advection (average onto side)
 6319:    const Node *node1 = side->nodes[0];
 6320:    const Node *node2 = side->nodes[1];
 6321:    for (int k=kbs(i); k<nvrt; k++) {
 6322: 
 6323:       if constexpr(ics==1) {
 6324:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6325:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6326:       } else {
 6327:          // XXX IMPLEMENT THIS
 6328:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6329:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6330:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6331:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6332:       }  // if ics
 6333: 
 6334: 
 6335:    }
 6336: }
 6337: #endif
 6338: 
 6339: 
 6340: extern "C" {
 6341:    __global__ void computeElemAverageGhat(void) {
 6342:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6343: 
 6344:       ELEM(elem);
 6345:       
 6346:       elem->ghat1= {0.0, 0.0};  
 6347: 
 6348:       if constexpr(ihydraulics != 0) {
 6349:          if (nhtblocks > 0 && elem->isblock) return;
 6350:       }
 6351: 
 6352: 
 6353: 
 6354:       
 6355:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6356:       // tidal potential, horizontal diffusion, and baroclinic etc
 6357:       // Remember to update both fb and F 
 6358:       // If ics=2, ghat1 are in eframe (ll)
 6359:       // cff1-3: coefficients for 2D/3D
 6360:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6361:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6362:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6363: 
 6364:       if (elem->isDry) return;
 6365: 
 6366:       double av_cff1 = 0.0;  // av. for cff1
 6367:       double av_cff2 = 0.0;  // av. for cff2
 6368:       double av_cff3 = 0.0;  // av. for cff3
 6369:       double av_df = 0.0;  // av. for H^\alpha / H
 6370:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6371:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6372: 
 6373:       const int i34 = elem->i34;
 6374:       const int kb = elem->kb;
 6375: 
 6376:       for (int j=0; j<i34; j++) {
 6377:          // For each node and side in the element...
 6378: 
 6379:          const Node *node = elem->nodes[j];
 6380:          const Side *side = elem->sides[j];
 6381: 
 6382:          const double chi      = side->chi;
 6383:          const double veg_c2   = side->veg_c2;
 6384:          const double veg_beta = side->veg_beta;
 6385:          const double veg_h    = side->veg_h();
 6386:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6387: 
 6388:          // Node - const in elem
 6389:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6390:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6391: 
 6392:          if (elem->depth >= tip_dp) {
 6393:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6394:          }
 6395: 
 6396:          
 6397:          const double htot  = side->htot2();        // Total depth at the side
 6398:          const double zctr2 = side->zTopCanopy();  
 6399: 
 6400:          double cff1; 
 6401:          double cff2; 
 6402:          double cff3;   
 6403:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6404:          // coefficients applied to 2D/3D case 
 6405:             cff1 = side->hhat/htot;
 6406:             cff2 = 0.0;
 6407:             cff3 = 0.0;
 6408:          } else { //3D
 6409:             //Init for no-veg case
 6410:             cff1 = 1.0;
 6411:             cff2 = 1.0;
 6412:             cff3 = 0.0;
 6413: 
 6414:             if constexpr(iveg != 0) {
 6415:                // Computes coefficients used with vegetation terms G1, G2
 6416:                // cff1, cff3 are used for the first two terms in G1, G2:
 6417:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6418:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6419:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6420:                if(veg_h < 0.99*htot) { // submergent vegetation
 6421:                   cff1=1;
 6422:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6423:                   cff3 = veg_c;
 6424: 
 6425:                } else { // emergent vegetation
 6426:                   cff1 = 1.0/(1.0 + veg_c2);
 6427:                   cff2 = cff1;
 6428:                   cff3 = 0.0;
 6429: 
 6430:                }
 6431:             } // if iveg
 6432:          } //  2D/3D
 6433: 
 6434:          av_cff1 += cff1/i34;
 6435:          av_cff2 += cff2/i34;
 6436:          av_cff3 += cff3/i34;
 6437:          av_cff2_chi += cff2*chi/i34;
 6438:          av_cff3_chi += cff3*chi/i34;
 6439:          av_df += min(htot, veg_h)/(htot*i34);
 6440: 
 6441: 
 6442:          // btrack values: U^\star, U^{\star\alpha}
 6443:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6444:          Vector2 Ustar       = {0.0, 0.0}; 
 6445:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6446: 
 6447:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6448:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6449:          } else { //3D
 6450:             for (int k = side->kb + 1; k < nvrt; k++) {
 6451:             
 6452:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6453:                Ustar += w2;
 6454: 
 6455:                if constexpr(iveg != 0) {
 6456:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6457:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6458:                        Ustar_alpha += zrat*w2; // XXXX
 6459:                    }
 6460:                }  // if iveg
 6461:             }  // for k
 6462:          }  //2D/3D
 6463:          
 6464: 
 6465:          // Add btrack & surface stress terms to \breve{G} first
 6466:          if constexpr(ics==1) {
 6467: 
 6468:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6469: 
 6470:          } else {
 6471:             assert(false && "computeElemAverageGhat: Not implemented");
 6472:             // XXX IMPLEMENT THIS
 6473:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6474:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6475:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6476:          }  // if ics
 6477: 
 6478:          // Surface and bottom stress terms
 6479:          if constexpr(ics==1) {
 6480:             const Vector2 tau    = side->tau();
 6481:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6482: 
 6483:             // Term for surface and bottom stress
 6484:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6485: 
 6486:          } else {
 6487:             assert(false && "computeElemAverageGhat: Not implemented");
 6488:             // XXX IMPLEMENT THIS
 6489:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6490:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6491:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6492:             // tau_x=(vn1+tt1)/2.d0
 6493:             // tau_y=(vn2+ss1)/2.d0
 6494:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6495:          }  // if ics
 6496: 
 6497:          
 6498: 
 6499:          // All terms in F,F^\alpha,f_b except baroclinic
 6500:          // F, f_b: all explicit terms excluding vegetation 
 6501:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6502:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6503:          const double coriolis = side->coriolis;
 6504:          Vector2 F  =  coriolis*side->U;  // F_x
 6505:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6506:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6507: 
 6508:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6509:             
 6510:             for (int k = side->kb; k < nvrt; k++) {
 6511:                if (zctr2 > side->zc[k-1]) {
 6512:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6513:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6514:                    Fa +=  coriolis*w2*zrat;
 6515:                } // if zctr2
 6516:             } // k
 6517:          } // iveg
 6518: 
 6519:          // Integrate horizontal viscosity force vertically
 6520:          for (int k=side->kb + 1; k<nvrt; k++) {
 6521:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6522: 
 6523:             F += levelHorVisc;
 6524: 
 6525:             // Vegetation term
 6526:             if constexpr(iveg!=0) {
 6527:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6528:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6529:                   Fa += levelHorVisc*zrat;
 6530:                } 
 6531:             } // if iveg
 6532:          } // for k
 6533: 
 6534:          fb += side->nuGradU[side->kb];
 6535: 
 6536:          // Add to ghat1
 6537:          if constexpr(ics==2) {
 6538:             assert(false && "computeElemAverageGhat: Not implemented");
 6539:             // XXX IMPLEMENT THIS
 6540:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6541:             // bigf1=vn1; bigf2=vn2
 6542:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6543:             // botf1=vn1; botf2=vn2
 6544:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6545:             // bigfa1=vn1; bigfa2=vn2
 6546:          } // if ics
 6547: 
 6548:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6549:       } // for j (nodes and sides)
 6550: 
 6551:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6552:          
 6553:       // Finish off terms in F, F^\alpha and f_b
 6554:       const double grav3 = elem->mean(&Node::grav2);
 6555:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6556: 
 6557: 
 6558:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6559:       for (int j=1; j<i34; j++) { 
 6560:          // For each side in the element...
 6561:          const Side *side = elem->sides[j];
 6562:          const double chi = side->chi;
 6563: 
 6564:          const double htot = side->htot2();
 6565:          const double veg_h = side->veg_h();
 6566:          const Vector2 F  = htot*fb;
 6567:          const Vector2 Fa = min(htot, veg_h)*fb;
 6568: 
 6569:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6570:       } // for j
 6571: 
 6572:       //botf1 etc are already in elem frame
 6573:       elem->ghat1 += tmp/i34;
 6574: 
 6575:       // Baroclinic force
 6576:       if constexpr(ibc==0) {
 6577:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6578: 
 6579:          Vector2 Fa = {0.0, 0.0};
 6580:          Vector2 intGradRho = {0.0, 0.0};
 6581:          
 6582:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6583:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6584:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6585: 
 6586:             // \in F [m^2/s/s]
 6587:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6588:          }
 6589: 
 6590:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6591:          const Vector2 F = av_df*Fa; //approx
 6592:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6593: 
 6594:       } // if ibc
 6595: 
 6596: 
 6597: 
 6598:    }
 6599: 
 6600: } // extern "C"
 6601: 
 6602: 
 6603: 
 6604: #ifdef DONTCOMPILE
 6605: __global__ void checkMassConservation(Tracers* sumtr) {
 6606: 
 6607:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6608: 
 6609:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6610: 
 6611:    Element *elem = &(mesh->localElemData[i]);
 6612: 
 6613:    // Skip dry elements
 6614:    if (elem->isDry) return;
 6615: 
 6616:    // Local sum array for this thread
 6617:    double localSum[N_TRACERS] = {0.0};
 6618: 
 6619:    // Sum over vertical levels for this element
 6620:    const int kbe = elem->kbe;
 6621:    const double area = elem->area;
 6622: 
 6623:    for (int k = kbe; k < nvrt; k++) {
 6624:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6625:       
 6626:       // Accumulate tracer mass
 6627:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6628:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6629:       }
 6630:    }
 6631: 
 6632:    //  This function returns per element sums. A reduction must be done on the host side.
 6633: }
 6634: 
 6635: 
 6636: __global__ void transport(void) {
 6637: 
 6638:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6639: 
 6640:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6641: 
 6642:    Element *elem = &(mesh->localElemData[ie]);
 6643: 
 6644:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6645: 
 6646:                for (int m=0; m<ntr; m++) {
 6647:                   for (int k=kbe(ie); k<nvrt; k++) {
 6648:                      // Calculate each polynomial's weight 
 6649:                      wm=0.d0; sum1=0.d0; 
 6650:                      wm1=0.d0; wm2=0.d0; 
 6651:                      for (int i=0; i<elem->nweno2; i++) {
 6652:                   
 6653:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6654:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6655:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6656:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6657:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6658:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6659:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6660:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6661:                      // -----------------Hu and Shu (1999)'s method----------------
 6662:                      b4=b1+b2+b3
 6663: 
 6664: //Error: add PRODUCTION CPP
 6665: #ifdef DEBUG
 6666:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6667:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6668:                     call parallel_abort(errmsg)
 6669:                   }
 6670: #endif
 6671: 
 6672:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6673:                   // !----test-------------- 
 6674:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6675:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6676:                   // !wm(i)=wm1(i)*wm2(i)
 6677:                   // !---------------------- 
 6678:                   sum1=sum1+wm(i)
 6679:                 } // end for i
 6680: 
 6681:                 wm=wm/sum1
 6682: 
 6683:                 for (int j=0; j<elem->i34; j++) {
 6684: 
 6685:                   const Side *side  = elem->sides[j];
 6686:                   const Node *node1 = side->n1;
 6687:                   const Node *node2 = side->n2;
 6688: 
 6689:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6690:                      trsd=0.d0
 6691:                      for (int kk=0; kk<nquad; kk++) {
 6692:                         for (int i=0; i<elem->nweno2; i++) {
 6693:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6694:                         } // end for i   
 6695:                      } // end for kk
 6696:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6697:                   } // outward flux
 6698:                } // end for j=1,i34(ie) ! side
 6699:             }
 6700:          }
 6701:               
 6702: 
 6703: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6704: //             //   calculate each polynomial's weight 
 6705: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6706: //                 wm=0.d0; sum1=0.d0
 6707: //                 do i=1,nweno1(ie) !for each polynomial
 6708: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6709: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6710: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6711: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6712: //                   wm(i)=b2
 6713: //                   sum1=sum1+b2
 6714: //                   !wm(i)=1.d0
 6715: //                   !sum1=sum1+1.d0
 6716: 
 6717: // // Error: PRODUCTION
 6718: // #ifdef DEBUG
 6719: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6720: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6721: //                     call parallel_abort(errmsg)
 6722: //                   endif
 6723: // #endif
 6724: 
 6725: //                 enddo !i
 6726: //                 wm=wm/sum1 !final weight
 6727: 
 6728:                 for (int j=0; j<elem->i34; j++) { // side
 6729:                   const Side *side = elem->sides[j];
 6730:                   const Node *node1 = side->n1;
 6731:                   const Node *node2 = side->n2;
 6732: 
 6733:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6734:                     trsd=0.d0
 6735:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6736:                       for (int i=0; i<elem->nweno1; i++) {
 6737:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6738:                       }
 6739:                     enddo //kk
 6740:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6741:                   } // outward flux
 6742:                 } // end for j=1,i34(ie) ! side
 6743:               } // end for k; ntr 
 6744: 
 6745:             else !simple upwind method
 6746:               do j=1,i34(ie)
 6747:                 jsj=elside(j,ie)
 6748:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6749:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6750:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6751:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6752:                   endif
 6753:                 enddo  !vertical layers
 6754:               enddo !j=1,i34(ie) ! side
 6755:             endif !order of accuracy
 6756: 
 6757:          //  enddo !ie
 6758: // !$OMP     end do
 6759: 
 6760: // !$OMP     master
 6761: //           !message passing
 6762: //           if (nproc>1) then
 6763: //             !make a copy of side concentrations
 6764: //             trsd_tmp0=trsd_tmp 
 6765: 
 6766: //             !this exchange routine swaps interface concentration between two partitions
 6767: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
