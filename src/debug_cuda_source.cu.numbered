 1587:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1588:       // Compute the different time ramps used in the code 
 1589:       // This function is performed by just one thread
 1590: 
 1591:       if constexpr(ibc == 0) {
 1592:          if (drampbc > 0.0) {
 1593:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1594:          } else {
 1595:             rampbc = 1.0;
 1596:          }
 1597: 
 1598:          if (nws != 0 && drampwind > 0.0) {
 1599:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1600:          } else {
 1601:             rampwind = 1.0;
 1602:          }
 1603:       }
 1604: 
 1605:       if (drampwafo > 0.0) {
 1606:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1607:       } else {
 1608:          rampwafo = 1.0;
 1609:       }
 1610: 
 1611:       // For source/sinks
 1612:       if (if_source && dramp_ss > 0.0) {
 1613:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1614:       } else {
 1615:          ramp_ss = 1.0;
 1616:       }
 1617: 
 1618:       if (dramp > 0.0) {
 1619:          ramp = tanh(2.0*time/86400.0/dramp);
 1620:       } else {
 1621:          ramp = 1.0;
 1622:       }
 1623: 
 1624:    }
