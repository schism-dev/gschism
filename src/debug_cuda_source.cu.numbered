 2296: 
 2297: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2298: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2299: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2300: // Only when ics == 2, the origin is at the element center.
 2301: 
 2302:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2303: 
 2304:    const Node *node = nodes[idxNode];
 2305: 
 2306:    if constexpr(ics==1) {
 2307:       return node->p;
 2308: 
 2309:    } else {
 2310:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2311: 
 2312:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2313: 
 2314:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2315:    }
 2316: 
 2317: }
 2318: 
 2319: 
 2320: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2321: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2322: 
 2323:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2324: 
 2325:    const int id1 = idx;
 2326:    const int id2 = nxq(1 + id1);
 2327:    const int id3 = nxq(2 + id1);
 2328: 
 2329:    if constexpr(ics==1) {
 2330:       x0 = nodes[id1]->p;
 2331:       x1 = nodes[id2]->p;
 2332:       x2 = nodes[id3]->p;
 2333: 
 2334:    } else {
 2335:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2336: 
 2337:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2338:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2339:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2340: 
 2341:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2342:       x1 = toVector2(frame.G2L(p1 - c));
 2343:       x2 = toVector2(frame.G2L(p2 - c));
 2344: 
 2345:    }
 2346: 
 2347: }
 2348: 
 2349: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2350: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2351: 
 2352:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2353: 
 2354:    if constexpr(ics==1) {
 2355:       x0 = nodes[0]->p;
 2356:       x1 = nodes[1]->p;
 2357:       x2 = nodes[2]->p;  
 2358:       x3 = nodes[3]->p;
 2359: 
 2360:    } else {
 2361:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2362: 
 2363:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2364:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2365:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2366:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2367: 
 2368:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2369:       x1 = toVector2(frame.G2L(p1 - c));
 2370:       x2 = toVector2(frame.G2L(p2 - c));
 2371:       x3 = toVector2(frame.G2L(p3 - c));
 2372:    }
 2373: 
 2374: }
 2375: 
 2376: 
 2377: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2378: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2379: // Returns the normal vector and the area of the element at this level
 2380:    
 2381:    double nx, ny, nz;
 2382: 
 2383:    if (isTri()) {
 2384:       // For triangles...
 2385: 
 2386:       // Indices of the nodes at level k, taking care of not going below the bed
 2387:       const int k0 = max(k, nodes[0]->kb);
 2388:       const int k1 = max(k, nodes[1]->kb);
 2389:       const int k2 = max(k, nodes[2]->kb);
 2390: 
 2391:       // Gets the element frame coordinates of the nodes at level k
 2392:       Point3 x0, x1, x2;
 2393:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2394:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2395:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2396:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2397: 
 2398:       } else {  // ics == 2
 2399:          Point2 h0, h1, h2;
 2400: 
 2401:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2402: 
 2403:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2404:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2405:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2406:       }
 2407: 
 2408:       const Vector3 n20 = x2 - x0;
 2409:       const Vector3 n10 = x1 - x0; 
 2410: 
 2411:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2412:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2413:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2414:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2415:   
 2416:    }
 2417:    else {
 2418:       // For quads...
 2419:       Point2 h0, h1, h2, h3;
 2420: 
 2421:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2422: 
 2423:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2424:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2425:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2426:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2427: 
 2428:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2429:       nx = n20.y*n31.z - n20.z*n31.y;
 2430:       ny = n20.z*n31.x - n20.x*n31.z;
 2431:       nz = n20.x*n31.y - n20.y*n31.x;
 2432: 
 2433:    }
 2434: 
 2435:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2436:    area3D = 0.5*len;
 2437: 
 2438:    const double inv_len = 1.0/len;
 2439: 
 2440:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2441: 
 2442: }
 2443: 
 2444: /**
 2445:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2446:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2447:    If the segment is completely inside the element, then it returns true.
 2448: 
 2449:    This function assumes:
 2450:    - The initial point is on a side of the element. 
 2451:    - Its position is given by parameter t in the range [0,1].
 2452:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2453:       intersects the element (elements are convex).
 2454: 
 2455:    To find the intersection point, this function does the following:
 2456:    - it finds the intersection of the line segment with all the element side lines,
 2457:       except for the one that contains the initial point.
 2458:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2459:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2460:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2461:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2462:       track segment is almost parallel to the element side line.
 2463: 
 2464:    Inputs:
 2465:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2466:    @param x2, y2: other end of the line segment
 2467: 
 2468:    Outputs:
 2469:    @param side:  side that intersects the line segment (input and output)
 2470:    @param nextElement (output): element that contains the intersection point
 2471:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2472:    @param zint (input/output): Vertical coordinate of the intersection point
 2473: 
 2474:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2475:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2476:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2477: 
 2478:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2479:    (Delta) being zero.
 2480: 
 2481:    The intersection2 point happens when:
 2482:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2483:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2484:    
 2485:    Assumption: the 4 points (including those of the side segment) are different.
 2486:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2487:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2488:    If true, (xIntersect,yIntersect) is the intersection.				
 2489:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2490: **/
 2491: 
