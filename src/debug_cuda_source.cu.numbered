  326: // Polynomial class
  327: template<int grade>
  328: struct Polynomial {
  329:     // Static assertion to give a clear error message at compile time
  330:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  331: };
  332: 
  333: 
  334: // Explicit specialization for grade 4
  335: template<>
  336: struct Polynomial<4> {
  337:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  338: 
  339:    // Constructor from coefficients
  340:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  341: 
  342:    __device__ __forceinline__ double eval(double x) const {
  343:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  344:    }
  345: };
  346: 
  347: // ------------------------------------------------------------------------------------------------
  348: 
  349: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  350:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  351:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  352: }
  353: 
  354: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  355:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  356:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  357: }
  358: 
  359: 
  360: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  361:    x3 = y1*z2 - y2*z1;
  362:    y3 = x2*z1 - x1*z2;
  363:    z3 = x1*y2 - x2*y1;
  364: }
  365: 
  366: 
  367: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  368: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  369: 
  370:    const double radius2 = dot(p, p);
  371:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  372:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  373: 
  374:    rlon = atan2(p.y, p.x); // (-pi,pi]
  375: 
  376:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  377:       rlat = asin(p.z/sqrt(radius2));
  378:    } else {
  379:       rlat = asin(p.z/rearth_pole);
  380:    }
  381:   
  382: }
  383: 
  384: __inline__ __device__ void Error(const char* msg) {
  385:    printf("Error: %s\n", msg);
  386:    assert(false);
  387: }
