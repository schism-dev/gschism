 8179: // !===============================================================================
 8180: 
 8181: } // extern "C"
 8182: 
 8183: #ifdef DONTCOMPILE
 8184: __device__ void computeVerticalAdvection(void) {
 8185:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8186: 
 8187:    sdbt(1:2,:,:)=0.d0
 8188: 
 8189:    const Side *side = FROM kernel;
 8190: 
 8191:    if(side->isDry) return;
 8192: 
 8193:    // If side is wet...
 8194: 
 8195: 
 8196:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8197:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8198:    double ws[nvrt] = {} // w @ side
 8199:    int icount = 0;
 8200:    for (int j=0; j<2; j++) {
 8201:       const Element *elem = side->elements[j];
 8202:        
 8203:       if(elem != nullptr) {
 8204:          icount++;
 8205:          for (int k=0; k<nvrt; k++) {
 8206:             ws[k] = ws[k] + elem->w[k];
 8207:          }
 8208:       }
 8209:    }  // for j
 8210: 
 8211:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8212:    ws = ws/icount;
 8213: 
 8214:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8215:    // Splines allow for a smooth transition between vertical levels.
 8216:    // Splines have continuity restrictions at the internal knots, but
 8217:    // we have to provide the 1st derivatives at the endpoints.
 8218:    const int kbs = side->kbs; 
 8219:    
 8220:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8221:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8222:    initCubicSpline(kbs, nvrt, side, ws, up)
 8223: 
 8224:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8225:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8226:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8227: 
 8228:    // Total advection (average onto side)
 8229:    const Node *node1 = side->nodes[0];
 8230:    const Node *node2 = side->nodes[1];
 8231:    for (int k=kbs(i); k<nvrt; k++) {
 8232: 
 8233:       Vector2 bcc1 = node1->bcc[k];
 8234:       Vector2 bcc2 = node2->bcc[k];
 8235:       if constexpr(ics == 2) {
 8236:          // Project the velocities from the node frames to the side frame
 8237:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8238:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8239:       }
 8240: 
 8241:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8242:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8243: 
 8244:    }
 8245: }
 8246: #endif
 8247: 
 8248: 
 8249: extern "C" {
 8250:    __global__ void computeElemAverageGhat(void) {
 8251:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8252: 
 8253:       ELEM(elem);
 8254:       
 8255:       elem->ghat1= {0.0, 0.0};  
 8256: 
 8257:       if constexpr(ihydraulics != 0) {
 8258:          if (nhtblocks > 0 && elem->isblock) return;
 8259:       }
 8260: 
 8261:       
 8262:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8263:       // cff1-3: coefficients for 2D/3D
 8264: 
 8265:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8266:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8267:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8268: 
 8269:       if (elem->isDry) return;
 8270: 
 8271:       // Average of the coefficients
 8272:       double av_cff1 = 0.0;  // av. for cff1
 8273:       double av_cff2 = 0.0;  // av. for cff2
 8274:       double av_cff3 = 0.0;  // av. for cff3
 8275:       double av_df = 0.0;  // av. for H^\alpha / H
 8276:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8277:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8278: 
 8279:       const int i34 = elem->i34;
 8280:       const int kb  = elem->kb;
 8281: 
 8282:       for (int j=0; j<i34; j++) {
 8283:          // For each node and side in the element...
 8284: 
 8285:          const Node *node = elem->nodes[j];
 8286:          const Side *side = elem->sides[j];
 8287: 
 8288:          const double chi      = side->chi;
 8289:          const double veg_c2   = side->veg_c2;
 8290:          const double veg_beta = side->veg_beta;
 8291:          const double veg_h    = side->veg_h();
 8292:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8293: 
 8294:          const Vector2 gradPhi = elem->gradPhi[j];
 8295: 
 8296:          // Node - const in elem
 8297:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8298:          elem->gradPr  += node->pr  *gradPhi;
 8299: 
 8300:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8301: 
 8302:         
 8303:          const double htot  = side->htot2();        // Total depth at the side
 8304:          const double zctr2 = side->zTopCanopy();  
 8305: 
 8306:          double cff1; 
 8307:          double cff2; 
 8308:          double cff3;   
 8309:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8310:          // coefficients applied to 2D/3D case 
 8311:             cff1 = side->hhat/htot;
 8312:             cff2 = 0.0;
 8313:             cff3 = 0.0;
 8314:          } else { //3D
 8315:             //Init for no-veg case
 8316:             cff1 = 1.0;
 8317:             cff2 = 1.0;
 8318:             cff3 = 0.0;
 8319: 
 8320:             if constexpr(iveg != 0) {
 8321:                // Computes coefficients used with vegetation terms G1, G2
 8322:                // cff1, cff3 are used for the first two terms in G1, G2:
 8323:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8324:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8325:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8326:                if(veg_h < 0.99*htot) { // submergent vegetation
 8327:                   cff1 = 1.0;
 8328:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8329:                   cff3 = veg_c;
 8330: 
 8331:                } else { // emergent vegetation
 8332:                   cff1 = 1.0/(1.0 + veg_c2);
 8333:                   cff2 = cff1;
 8334:                   cff3 = 0.0;
 8335: 
 8336:                }
 8337:             } // if iveg
 8338:          } //  2D/3D
 8339: 
 8340:          av_cff1 += cff1/i34;
 8341:          av_cff2 += cff2/i34;
 8342:          av_cff3 += cff3/i34;
 8343:          av_cff2_chi += cff2*chi/i34;
 8344:          av_cff3_chi += cff3*chi/i34;
 8345:          av_df += min(htot, veg_h)/(htot*i34);
 8346: 
 8347: 
 8348:          // btrack values: U^\star, U^{\star\alpha}
 8349:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8350:          Vector2 Ustar       = {0.0, 0.0}; 
 8351:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8352: 
 8353:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8354:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8355:          } else { //3D
 8356:             for (int k = side->kb + 1; k < nvrt; k++) {
 8357:             
 8358:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8359:                Ustar += w2;
 8360: 
 8361:                if constexpr(iveg != 0) {
 8362:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8363:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8364:                        Ustar_alpha += zrat*w2; // XXXX
 8365:                    }
 8366:                }  // if iveg
 8367:             }  // for k
 8368:          }  //2D/3D
 8369: 
 8370:          // If needed, project the side velocities to the element frame
 8371:          if constexpr(ics==2) {
 8372:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8373:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8374:          }
 8375:         
 8376: 
 8377:          // Add btrack & surface stress terms to \breve{G} first
 8378:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8379: 
 8380: 
 8381:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8382:          Vector2 tau    = side->tau();  
 8383:          Vector2 ubstar = side->btu[side->kb + 1];  
 8384: 
 8385:          // If needed, project tau and ubstar to the element frame
 8386:          if constexpr(ics==2) {
 8387:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8388:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8389:          }
 8390: 
 8391:          // Term for surface and bottom stress
 8392:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8393: 
 8394: 
 8395:          // All terms in F,F^\alpha,f_b except baroclinic
 8396:          // F, f_b: all explicit terms excluding vegetation 
 8397:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8398:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8399:          const double coriolis = side->coriolis;
 8400:          Vector2 F  =  coriolis*side->U;  // F_x
 8401:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8402:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8403: 
 8404:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8405:             
 8406:             for (int k = side->kb; k < nvrt; k++) {
 8407:                if (zctr2 > side->zc[k-1]) {
 8408:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8409:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8410:                    Fa +=  coriolis*w2*zrat;
 8411:                } // if zctr2
 8412:             } // k
 8413:          } // iveg
 8414: 
 8415:          // Integrate horizontal viscosity force vertically
 8416:          for (int k=side->kb + 1; k<nvrt; k++) {
 8417:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8418: 
 8419:             F += levelHorVisc;
 8420: 
 8421:             // Vegetation term
 8422:             if constexpr(iveg!=0) {
 8423:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8424:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8425:                   Fa += levelHorVisc*zrat;
 8426:                } 
 8427:             } // if iveg
 8428:          } // for k
 8429: 
 8430:          // Get nu*grad(U) at the side's bottom level
 8431:          Vector2 nuGradU = side->nuGradU[side->kb];
 8432: 
 8433:          fb += nuGradU;
 8434: 
 8435:          // If needed, project vectorsF, fb and Fa to the element frame
 8436:          if constexpr(ics==2) {
 8437:             F    = side->frame.projHorVec(F,    elem->frame);
 8438:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8439:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8440:          } // if ics
 8441: 
 8442:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8443:       } // for j (nodes and sides)
 8444: 
 8445:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8446: 
 8447: 
 8448:       // Finish off terms in F, F^\alpha and f_b
 8449:       const double grav3 = elem->mean(&Node::grav2);
 8450:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8451:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8452:       for (int j=0; j<i34; j++) { 
 8453:          // For each side in the element...
 8454:          const Side *side = elem->sides[j];
 8455:          const double chi = side->chi;
 8456: 
 8457:          const double htot = side->htot2();
 8458:          const double veg_h = side->veg_h();
 8459:          const Vector2 F  = htot*fb;
 8460:          const Vector2 Fa = min(htot, veg_h)*fb;
 8461: 
 8462:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8463:       } // for j
 8464: 
 8465:       // tmp is already in elem frame
 8466:       elem->ghat1 += tmp/i34;
 8467: 
 8468:       // Baroclinic force
 8469:       if constexpr(ibc==0) {
 8470:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8471: 
 8472:          Vector2 Fa = {0.0, 0.0};
 8473:          Vector2 intGradRho = {0.0, 0.0};
 8474:          
 8475:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8476:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8477:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8478: 
 8479:             // \in F [m^2/s/s]
 8480:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8481:          }
 8482: 
 8483:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8484:          const Vector2 F = av_df*Fa; //approx
 8485:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8486: 
 8487:       } // if ibc
 8488: 
 8489: 
 8490: 
 8491:    }
 8492: 
 8493: } // extern "C"
 8494: 
 8495: 
 8496: 
 8497: #ifdef DONTCOMPILE
 8498: __global__ void checkMassConservation(Tracers* sumtr) {
 8499: 
 8500:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8501: 
 8502:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8503: 
 8504:    Element *elem = &(mesh->localElemData[i]);
 8505: 
 8506:    // Skip dry elements
 8507:    if (elem->isDry) return;
 8508: 
 8509:    // Local sum array for this thread
 8510:    double localSum[N_TRACERS] = {0.0};
 8511: 
 8512:    // Sum over vertical levels for this element
 8513:    const int kbe = elem->kbe;
 8514:    const double area = elem->area;
 8515: 
 8516:    for (int k = kbe; k < nvrt; k++) {
 8517:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8518:       
 8519:       // Accumulate tracer mass
 8520:       for (int tr = 0; tr < N_TRACERS; tr++) {
 8521:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8522:       }
 8523:    }
 8524: 
 8525:    //  This function returns per element sums. A reduction must be done on the host side.
 8526: }
 8527: 
 8528: 
 8529: __global__ void transport(void) {
 8530: 
 8531:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8532: 
 8533:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8534: 
 8535:    Element *elem = &(mesh->localElemData[ie]);
 8536: 
 8537:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8538: 
 8539:                for (int m=0; m<ntr; m++) {
 8540:                   for (int k=kbe(ie); k<nvrt; k++) {
 8541:                      // Calculate each polynomial's weight 
 8542:                      wm=0.d0; sum1=0.d0; 
 8543:                      wm1=0.d0; wm2=0.d0; 
 8544:                      for (int i=0; i<elem->nweno2; i++) {
 8545:                   
 8546:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8547:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8548:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8549:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8550:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8551:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8552:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8553:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8554:                      // -----------------Hu and Shu (1999)'s method----------------
 8555:                      b4=b1+b2+b3
 8556: 
 8557: //Error: add PRODUCTION CPP
 8558: #ifdef DEBUG
 8559:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8560:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8561:                     call parallel_abort(errmsg)
 8562:                   }
 8563: #endif
 8564: 
 8565:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8566:                   // !----test-------------- 
 8567:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8568:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8569:                   // !wm(i)=wm1(i)*wm2(i)
 8570:                   // !---------------------- 
 8571:                   sum1=sum1+wm(i)
 8572:                 } // end for i
 8573: 
 8574:                 wm=wm/sum1
 8575: 
 8576:                 for (int j=0; j<elem->i34; j++) {
 8577: 
 8578:                   const Side *side  = elem->sides[j];
 8579:                   const Node *node1 = side->n1;
 8580:                   const Node *node2 = side->n2;
 8581: 
 8582:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8583:                      trsd=0.d0
 8584:                      for (int kk=0; kk<nquad; kk++) {
 8585:                         for (int i=0; i<elem->nweno2; i++) {
 8586:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8587:                         } // end for i   
 8588:                      } // end for kk
 8589:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8590:                   } // outward flux
 8591:                } // end for j=1,i34(ie) ! side
 8592:             }
 8593:          }
 8594:               
 8595: 
 8596: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8597: //             //   calculate each polynomial's weight 
 8598: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8599: //                 wm=0.d0; sum1=0.d0
 8600: //                 do i=1,nweno1(ie) !for each polynomial
 8601: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8602: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8603: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8604: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8605: //                   wm(i)=b2
 8606: //                   sum1=sum1+b2
 8607: //                   !wm(i)=1.d0
 8608: //                   !sum1=sum1+1.d0
 8609: 
 8610: // // Error: PRODUCTION
 8611: // #ifdef DEBUG
 8612: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8613: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8614: //                     call parallel_abort(errmsg)
 8615: //                   endif
 8616: // #endif
 8617: 
 8618: //                 enddo !i
 8619: //                 wm=wm/sum1 !final weight
 8620: 
 8621:                 for (int j=0; j<elem->i34; j++) { // side
 8622:                   const Side *side = elem->sides[j];
 8623:                   const Node *node1 = side->n1;
 8624:                   const Node *node2 = side->n2;
 8625: 
 8626:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8627:                     trsd=0.d0
 8628:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8629:                       for (int i=0; i<elem->nweno1; i++) {
 8630:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8631:                       }
 8632:                     enddo //kk
 8633:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8634:                   } // outward flux
 8635:                 } // end for j=1,i34(ie) ! side
 8636:               } // end for k; ntr 
 8637: 
 8638:             else !simple upwind method
 8639:               do j=1,i34(ie)
 8640:                 jsj=elside(j,ie)
 8641:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8642:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8643:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8644:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8645:                   endif
 8646:                 enddo  !vertical layers
 8647:               enddo !j=1,i34(ie) ! side
 8648:             endif !order of accuracy
 8649: 
 8650:          //  enddo !ie
 8651: // !$OMP     end do
 8652: 
 8653: // !$OMP     master
 8654: //           !message passing
 8655: //           if (nproc>1) then
 8656: //             !make a copy of side concentrations
 8657: //             trsd_tmp0=trsd_tmp 
 8658: 
 8659: //             !this exchange routine swaps interface concentration between two partitions
 8660: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 8661: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 8662: 
 8663: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 8664: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 8665: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 8666: 
 8667: 
 8668: //             !This obtains final values for interface sides
 8669: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 8670: //       :    endif !nproc>1
 8671: //           !message passing end
 8672: // !$OMP     end master
 8673: // !$OMP     barrier
 8674: 
 8675: 
 8676: // !         Do advection; conc @ dry elem will not be changed
 8677: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 8678: // !$OMP     do reduction(+: h_mass_in)
 8679: //           do i=1,ne
 8680: //             if(idry_e(i)==1) cycle
 8681: 
 8682: 
 8683: // !           Wet elements with 3 wet nodes
 8684: //             do k=kbe(i)+1,nvrt
 8685: 
 8686: 
 8687: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 8688: //               dtb_by_bigv = dtb/bigv
 8689:     
 8690: // !             Advective flux
 8691: //               if (ntd_weno==1 .or. itd_weno==1) then
 8692: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 8693: //               else
 8694: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 8695: //               endif
 8696: 
 8697: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 8698: //               do j=1,i34(i)
 8699: //                 jsj=elside(j,i) !side
 8700: //                 iweno=.true. !use weno reconstruction as default
 8701: //                 iel=ic3(j,i) !neighboring elem
 8702: 
 8703: //                 if(iel/=0) then
 8704: //                   if(idry_e(iel)==1) cycle
 8705: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 8706: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 8707: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 8708: //                     iweno=.false.
 8709: //                   endif
 8710: //                 else !land or open bnd side
 8711: //                   !skip land bnd and outflowing open bnd, 
 8712: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 8713: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 8714: //                     !For outflow open bnd side, estimate mass in (open
 8715: //                     !side cannot be interface side)
 8716: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 8717: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 8718: //                     endif
 8719: 
 8720: //                     cycle
 8721: //                   endif
 8722: 
 8723: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 8724: //                   iweno=.false.  !reset to upwind
 8725: //                   ibnd=isbs(jsj) !global bnd #
 8726: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 8727: //                   nwild(1:2)=0
 8728: //                   do ll=1,2 !nodes
 8729: //                     ndo=isidenode(ll,jsj)
 8730: //                     do lll=1,2 !2 possible bnds
 8731: //                       if(isbnd(lll,ndo)==ibnd) then
 8732: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 8733: //                         exit
 8734: //                       endif
 8735: //                     enddo !lll
 8736: //                   enddo !ll
 8737: //                   ind1=nwild(1); ind2=nwild(2);
 8738: 
 8739: //                   do jj=1,natrm
 8740: //                     if(ntrs(jj)<=0) cycle
 8741: 
 8742: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 8743: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 8744: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 8745: //                       enddo !ll
 8746: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 8747: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 8748: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 8749: //                       enddo !ll
 8750: //                     else if(itrtype(jj,ibnd)==3) then
 8751: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 8752: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 8753: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 8754: //                       enddo !ll
 8755: //                     else if(itrtype(jj,ibnd)==4) then
 8756: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 8757: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 8758: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 8759: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 8760: //                       enddo !ll
 8761: //                     else
 8762: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 8763: //   !'
 8764: //                       call parallel_abort(errmsg)
 8765: //                     endif !itrtype
 8766: 
 8767: //                   enddo !jj
 8768: 
 8769: //                   !Tally horizontal mass in for inflow case
 8770: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 8771: //                 endif !iel
