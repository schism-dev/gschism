 4306:    __global__ void computeFlowBcVelocities(double time) {
 4307: 
 4308:       SIDE_BND(sideBnd);
 4309: 
 4310:       const Side *side = sideBnd->side;
 4311:  
 4312:       const bool isDry = side->isDry;
 4313:       const bool isLand = sideBnd->segment->isLand;
 4314: 
 4315:    
 4316:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4317: 
 4318:       if (isDry || isLand) return;
 4319: 
 4320:       // For wet sides in open boundaries...
 4321:       const Vector2 n = side->n;
 4322:       const BoundarySegment *segment = sideBnd->segment;
 4323: 
 4324:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4325: 
 4326:       const int ifltype = segment->ifltype;
 4327: 
 4328:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4329:       const Vector2 r_nuth0 = r_uth0*n;
 4330: 
 4331: 
 4332:       if (ifltype == 1 || ifltype == 2) {
 4333:       
 4334:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4335: 
 4336:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4337:          
 4338:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4339:          
 4340:       } else if (ifltype == -1) { // Flather 1
 4341: 
 4342:          for (int k = 0; k < nvrt; k++) {
 4343: 
 4344:             // uth is the normal vel.; no ramp up
 4345:             const double uth = sideBnd->nuth(k);
 4346:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4347: 
 4348:             sideBnd->ubc[k] += uth*n;
 4349:          }
 4350: 
 4351:       } else if (ifltype == 3 || ifltype == 5) {
 4352:          // vnth0=0 !normal vel.
 4353: 
 4354:          Vector2 r_u1_bar = {0.0, 0.0};
 4355:          // Computes the contribution to the velocity from all tide frequencies
 4356:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4357: 
 4358:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4359:             const Vector2 umo  = sideBnd->umo(jfr); 
 4360: 
 4361:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4362:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4363:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4364:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4365:          }
 4366: 
 4367: 
 4368:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4369: 
 4370:       } // if (ifltype = 3 || ifltype == 5
 4371: 
 4372: 
 4373: 
 4374:    }
 4375: 
 4376:    __global__ void computeElevationBoundaryConditions(double time) {
 4377:       // Compute elevation essential boundary conditions 
 4378: 
 4379:       NODE_BND(nodeBnd); // Each boundary node.
 4380: 
 4381:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4382: 
 4383:       const Node *node = nodeBnd->node;
 4384:       const BoundarySegment *segment = nodeBnd->segment;
 4385:       const int iettype = segment->iettype;
 4386:       
 4387: 
 4388:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4389:       double eic = 0.0;
 4390:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4391:       else                 eic = 0.0;
 4392: 
 4393:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4394:       const double r_eth = ramp*nodeBnd->eth;
 4395:       double r_eta1_bar = 0.0;
 4396: 
 4397: 
 4398:       // Compute tide elevation
 4399:       if (iettype == 3 || iettype == 5) {   
 4400: 
 4401:          if constexpr(iloadtide==1) { // loading tide
 4402:             assert(false && "Loading tide not implemented");
 4403:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4404:          }
 4405:          
 4406:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4407: 
 4408:             const double efa  = nodeBnd->efa[jfr]; 
 4409:             const double emo  = nodeBnd->emo[jfr]; 
 4410: 
 4411:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4412:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4413:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4414: 
 4415:          } // for jfr
 4416: 
 4417:       } // if iettype
 4418: 
 4419:       switch (iettype) {
 4420:          case 1:
 4421:          case 2:
 4422:          case 4:
 4423:             nodeBnd->elbc = r_eic + r_eth;
 4424:             break;
 4425:          case 3:
 4426:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4427:             break;
 4428:          case 5:
 4429:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4430:             break;
 4431:       } // switch
 4432: 
 4433: 
 4434:       //Add inverse barometric effects
 4435:       if (iettype != 0 && inv_atm_bnd == 1) {
 4436:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4437:       }
 4438: 
 4439:    }
 4440: 
 4441: 
 4442:    __global__ void computeHorizontalViscosity(void) { 
 4443: 
 4444:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4445: 
 4446:       SIDE(side);
 4447: 
 4448:       if (side->isDry) return;
 4449: 
 4450:       for (int k = 0; k < nvrt; k++) {
 4451:          side->nuGradU[k] = {0.0, 0.0};
 4452:       }
 4453: 
 4454:       if constexpr(ihorcon == 1) {
 4455:          for (int k = side->kb; k < nvrt - 1; k++) {
 4456:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4457:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4458:             // By Zhang and Baptista.
 4459: 
 4460:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4461:             // This is a standard discretization of the Laplacian operator.
 4462:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4463:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4464:             // Gamma is hvis_coef0 in the code.
 4465:             // The value of gamma needs to be < 0.5.
 4466: 
 4467:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4468:             // side under consideration in each of the two possible elements that share the side.
 4469:             Vector2 sumU = {0.0, 0.0};
 4470:             for (int l = 0; l < 2; l++) {
 4471:                const Element *elem = side->elems[l];
 4472: 
 4473:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4474: 
 4475:                // Find the local index of the side in the element
 4476:                const int idxSide = elem->sideLocalIdx(side);
 4477:                // Find the two sides that are connected to the side under consideration
 4478:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4479:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4480: 
 4481:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4482: 
 4483:             }
 4484: 
 4485:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4486:    
 4487:          }
 4488:       }
 4489:       else if constexpr(ihorcon == 2) {
 4490:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4491:       }
 4492: 
 4493: 
 4494:    }
 4495: 
 4496: 
 4497:    __global__ void setEssentialBC(void) {
 4498:       // Set essential boundary conditions 
 4499:       NODE(node); // Each boundary node
 4500:       NodeBoundary *nodeBnd = node->nodeBnd;
 4501:       
 4502: // nodeBnd->isEssentialBC = true;      
 4503:       // Check if this node has essential BC
 4504:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4505:          // Verify BC value is valid
 4506:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4507: 
 4508:        
 4509:          // Set diagonal to 1 and zero off-diagonals
 4510:          node->coeffDiag = 1.0;
 4511: 
 4512:          for (int j = 0; j < node->numNodes; j++) {
 4513:                node->coeffMatrix[j] = 0.0;
 4514:          }
 4515:          
 4516:          // Set solution and RHS to BC value
 4517:          node->mX  = nodeBnd->elbc;
 4518:          node->qel = nodeBnd->elbc;
 4519: 
 4520:       } else {
 4521:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4522: 
 4523:          for (int j = 0; j < node->numNodes; j++) {
 4524:                Node* nbNode = node->nodes[j];
 4525:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4526:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4527:                   // Verify neighbor's BC value
 4528:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4529: 
 4530:                   // Subtract contribution to RHS
 4531:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4532:                   node->coeffMatrix[j] = 0.0;  
 4533:                }
 4534:          }
 4535:       }
 4536:    }
 4537: 
 4538: 
 4539:    __global__ void updateElevation(void) {
 4540:       NODE(node);
 4541: 
 4542:       node->eta2 = node->mX;
 4543: 
 4544:       node->updateZCoordData();
 4545:    }
 4546: 
