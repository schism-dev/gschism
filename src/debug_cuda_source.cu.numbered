 1212: struct Node {
 1213: 
 1214:    // Geometry information
 1215:    int idx;        // Index of the node
 1216:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1217:    int numNodes;   // Number of nodes neighbors of this node
 1218: 
 1219:    Element **elements; // Array of pointers to the elements that share this node
 1220:    int numElements;    // Number of elements that share this node
 1221: 
 1222:    int numSides;       // Number of sides that are connected to this node
 1223: 
 1224:    Point2 p;
 1225:    Vector2 u2[nvrt];
 1226:    double  w2[nvrt];
 1227:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1228:    double z[nvrt];
 1229:    double lon, lat;
 1230:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1231:    double depth;
 1232: 
 1233: #ifdef USE_LOCALIZED_SIGMA   
 1234:    double localSigma[nvrt];
 1235: #endif
 1236: 
 1237:    int kb;       // Bottom index of the node
 1238: 
 1239:    bool isDry;     // True if the node is dry
 1240: 
 1241:    int iadv;     // Advection flag
 1242: 
 1243:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1244:                           // this is nullptr
 1245: 
 1246:    TempVar tmp; // Temporary variable to store different types of variables
 1247: 
 1248:    // Physical information
 1249:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1250:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1251: 
 1252:    double rho[nvrt];     // Density
 1253:    double dfv[nvrt];     // Vertical viscosity
 1254: 
 1255:    double eta1; // Elevation at nodes at previous timestep
 1256:    double eta2; // Elevation at nodes at current timestep
 1257: 
 1258:    double ETP;  // Earth Tidal Potential
 1259: 
 1260:    double pr;    // Air pressure
 1261:    double grav2; // Gravity 
 1262:    
 1263:    Vector2 dav;  // Depth averaged velocity
 1264: 
 1265:    Vector2 tau; // Wind stress vector
 1266: 
 1267:    // Vegetation parameters
 1268:    double veg_h;
 1269:    double veg_nv;
 1270:    double veg_di;
 1271:    double veg_Cd;
 1272:    double veg_h_unbent;
 1273:    double veg_di_unbent;
 1274:    double veg_nv_unbent;
 1275:    double veg_alpha_vert_mean;
 1276:    double veg_alpha0;
 1277:    double veg_alpha3D[nvrt];
 1278: 
 1279:    // Bottom drag parameters
 1280:    double Cd;       // Bottom drag coefficient   
 1281: 
 1282:    // These three are mutually exclusive
 1283:    union {
 1284:       double rmanning; // Bottom Manning's coefficient
 1285:       double rough;    // Bottom roughness length
 1286:       double drag;     // Bottom drag coefficient
 1287:    };
 1288:    Vector2 tau_bot; // Bottom stress vector
 1289: 
 1290:    double bdef1; // Bottom deformation at previous timestep
 1291:    double bdef2; // Bottom deformation at current timestep
 1292: 
 1293:    double qel; // RHS
 1294:    double coeffDiag; // Diagonal coefficient of the matrix
 1295:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1296: 
 1297:    double mP; // Search direction for conjugate gradient method
 1298:    double mR; // Residual for conjugate gradient method
 1299:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1300:    double mX; // Solution for conjugate gradient method
 1301: 
 1302:    // Meteorological forcing
 1303:    Vector2 u_air;
 1304:    double p_air;  // XXXX is this the same as pr?
 1305:    double t_air;
 1306:    double q_air;
 1307:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1308: 
 1309:    __device__ void setWind(Vector2 &u) {
 1310:    // Sets the wind vector taking into account the mesh angle
 1311:    
 1312:       const double speed = length(u);
 1313: 
 1314:       // Rotate wind vector to the node frame
 1315:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1316: 
 1317:       // Sets the surface stress vector due to wind.
 1318:       if constexpr(nws == 0) {
 1319:          tau = {0.0, 0.0};
 1320: 
 1321:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1322:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1323: 
 1324:       } else {
 1325: 
 1326:          double dragcoef;
 1327: 
 1328:          if constexpr(iwind_form == -1) {
 1329:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1330:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1331: 
 1332:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1333:             tau = cff*u_air;
 1334:  
 1335:          } else if constexpr(iwind_form == 1) {
 1336:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1337:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1338: 
 1339:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1340:             tau = cff*u_air;
 1341: 
 1342:          } else {
 1343:             tau = {0.0, 0.0};
 1344:          }
 1345:       }
 1346:    }
 1347: 
 1348: 
 1349:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1350: 
 1351:    __device__ double sigmaTransitionDepth(void) const;
 1352: 
 1353:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1354:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1355:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1356:    
 1357:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1358: 
 1359:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1360: 
 1361:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1362:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1363: 
 1364:    __device__ __forceinline__ void clearMatrixRow(void) {
 1365:       // Clear the matrix row for this node
 1366: 
 1367: 
 1368:       coeffDiag = 0.0;
 1369: 
 1370:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1371: 
 1372:    }
 1373: 
 1374:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1375:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1376:       
 1377:       if (node == this) {
 1378:          coeffDiag += value;
 1379:      
 1380:       } else {
 1381:          // Search (linearly)the index of the node in the array of nodes
 1382:          // XXX: This is not efficient, see if we can improve this
 1383:          int i;
 1384:          for (i = 0; i < numNodes; i++) {
 1385:             if (nodes[i] == node) {
 1386:                break;
 1387:             }
 1388:          }
 1389:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1390:          coeffMatrix[i] += value;
 1391:       }
 1392:    }
 1393: 
 1394: 
 1395:    __device__ __inline__ void updateZCoordData(void);
 1396: 
 1397:    __device__ double compZCoord(int k) const;
 1398: 
 1399:    __device__ void updateKb(void);
 1400: 
 1401:    __device__ __forceinline__ void computeBottomDragCd(void);
 1402: 
 1403: 
 1404: 
 1405: };
