 1592: // This struct is used to store the boundary information for a node.
 1593: struct NodeBoundary {   
 1594:    int idx;
 1595:    BoundarySegment *segment;
 1596:    Node *node;
 1597:    
 1598:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1599:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1600: 
 1601:    bool isLand;
 1602: 
 1603:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1604:    double elbc;   // Elevation boundary condition
 1605:    double eth;    // Elevation time history
 1606: 
 1607:    double eta_mean; // Mean elevation at nodes
 1608: 
 1609:    bool isEssentialBC;
 1610: 
 1611:    Vector2 uth[nvrt];  // "Time history" velocity
 1612: 
 1613:    // Arrays for harmonic constituents (if needed)
 1614:    double  emo[nbfr];  // Elevation amplitude
 1615:    double  efa[nbfr];  // Elevation phase
 1616:    Vector2 umo[nbfr];  // velocity amplitude
 1617:    Vector2 ufa[nbfr];  // velocity phase
 1618: 
 1619: 
 1620:    NodeBoundary(void) {
 1621:       isLand = false;
 1622:    }
 1623:    NodeBoundary(bool _isLand) {
 1624:       isLand = _isLand;
 1625:    }
 1626: 
 1627:    
 1628:    __forceinline__ __device__ int numSidesForAverage() const {
 1629:    // Returns the number of sides that are connected to the node and have the same segment.
 1630:    // This is used to compute the average velocity at the node for open boundary nodes.
 1631:       int res = 0;
 1632:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1633:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1634: // printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1635:       return res;
 1636:    }
 1637: 
 1638: 
 1639:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1640:       assert(index == 0 || index == 1); 
 1641:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1642:    }
 1643: 
 1644:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1645:       if (isLand) return;  // land never uses these links
 1646: 
 1647:       SideBoundary *nullSideBoundary = nullptr;
 1648:       uintptr_t null = (uintptr_t)nullSideBoundary;
 1649: 
 1650:       if (atomicCAS((uintptr_t *)&sideBnd1, null, (uintptr_t)sb) == null) return;
 1651:       if (atomicCAS((uintptr_t *)&sideBnd2, null, (uintptr_t)sb) == null) return;
 1652: 
 1653:       // both slots taken. OK if this side was already linked
 1654:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1655:    }
 1656: 
 1657: 
 1658: };
 1659: 
 1660: struct Node {
 1661: 
 1662:    // Geometry information
 1663:    int idx;            // Global index of the node
 1664:    int16_t part;       // Partition of the node
 1665: 
 1666:    Node **nodes;       // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1667:    int16_t numNodes;   // Number of nodes neighbors of this node
 1668: 
 1669:    Element **elements; // Array of pointers to the elements that share this node
 1670:    int16_t numElements;// Number of elements that share this node
 1671: 
 1672:    int16_t numSides;   // Number of sides that are connected to this node
 1673: 
 1674: 
 1675:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1676:    double gz;          // Global vertical coordinate at the node.
 1677:    Vector2 u2[nvrt];
 1678:    double  w2[nvrt];
 1679:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1680:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1681:    double lon, lat;
 1682:    double depth;
 1683: 
 1684:    Frame<ics> frame;
 1685: 
 1686:    LocalSigma<ivcor> localSigma;  
 1687: 
 1688:    int16_t kb;     // Bottom index of the node
 1689: 
 1690:    bool isDry;     // True if the node is dry
 1691: 
 1692:    int16_t iadv;   // Advection flag
 1693: 
 1694:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1695:                           // this is nullptr
 1696: 
 1697:    TempVar tmp; // Temporary variable to store different types of variables
 1698: 
 1699:    // Physical information
 1700:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1701:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1702: 
 1703:    double rho[nvrt];     // Density
 1704:    double dfv[nvrt];     // Vertical viscosity
 1705:    double dfh[nvrt];     // Horizontal viscosity  XXXX (does it need to exist when transport is not enabled?)
 1706: 
 1707:    Turbulence<turbulenceModel> turb;
 1708: 
 1709:    double eta1; // Elevation at nodes at previous timestep
 1710:    double eta2; // Elevation at nodes at current timestep
 1711: 
 1712:    double ETP;  // Earth Tidal Potential
 1713: 
 1714:    double pr;    // Air pressure
 1715:    double grav2; // Gravity 
 1716:    
 1717:    Vector2 dav;  // Depth averaged velocity
 1718: 
 1719:    Vector2 tau; // Wind stress vector
 1720: 
 1721:    // Vegetation parameters
 1722:    double veg_h;
 1723:    double veg_nv;
 1724:    double veg_di;
 1725:    double veg_Cd;
 1726:    double veg_h_unbent;
 1727:    double veg_di_unbent;
 1728:    double veg_nv_unbent;
 1729:    double veg_alpha_vert_mean;
 1730:    double veg_alpha0;
 1731:    double veg_alpha3D[nvrt];
 1732: 
 1733:    // Bottom drag parameters
 1734:    double Cd;       // Bottom drag coefficient   
 1735: 
 1736:    // These three are mutually exclusive
 1737:    union {
 1738:       double rmanning; // Bottom Manning's coefficient
 1739:       double rough;    // Bottom roughness length
 1740:       double drag;     // Bottom drag coefficient
 1741:    };
 1742:    Vector2 tau_bot; // Bottom stress vector
 1743: 
 1744:    // XXXX REMOVE FOR IMM>0???
 1745:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1746:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1747: 
 1748:    
 1749:    double qel; // RHS
 1750:    double *coeffDiag;    // Pointer to the diagonal coefficient of the matrix
 1751:    double *coeffRow;     // Pointer to the coefficients of the row of the CRS matrix for this node.
 1752:    int16_t *csrSlot;     // csrSlot[i], is the slot/index of nodes[i] entry the CRS matrix row for this node.
 1753:                          // The index of the diagonal element is coeffDiag - coeffRow.   
 1754: 
 1755:    double mX; // Solution of the FEM system
 1756: 
 1757:    // Meteorological forcing
 1758:    Vector2 u_air;
 1759:    double p_air;  // XXXX is this the same as pr?
 1760:    double t_air;
 1761:    double q_air;
 1762:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1763: 
 1764: 
 1765: 
 1766:    __device__ __forceinline__ int localIndex() const;
 1767:    __device__ __forceinline__ int packedIndex() const;
 1768: 
 1769: 
 1770:    __device__ void setWind(Vector2 &u) {
 1771:    // Sets the wind vector taking into account the mesh angle
 1772:    
 1773:       const double speed = length(u);
 1774: 
 1775:       // Rotate wind vector to the node frame
 1776:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1777: 
 1778:       // Sets the surface stress vector due to wind.
 1779:       if constexpr(nws == 0) {
 1780:          tau = {0.0, 0.0};
 1781: 
 1782:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1783:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1784: 
 1785:       } else {
 1786: 
 1787:          double dragcoef;
 1788: 
 1789:          if constexpr(iwind_form == -1) {
 1790:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1791:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1792: 
 1793:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1794:             tau = cff*u_air;
 1795:  
 1796:          } else if constexpr(iwind_form == 1) {
 1797:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1798:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1799: 
 1800:             dragcoef = max(dragcoef, 4.0e-4);
 1801:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1802:             tau = cff*u_air;
 1803: 
 1804:          } else {
 1805:             tau = {0.0, 0.0};
 1806:          }
 1807:       }
 1808:    }
 1809: 
 1810: 
 1811:    __device__ void setFrame(double lat, double lon) {
 1812:       if constexpr(ics == 1) return;
 1813: 
 1814:       frame.update(lat, lon);        
 1815:     }
 1816: 
 1817:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1818: 
 1819:    __device__ double sigmaTransitionDepth(void) const;
 1820: 
 1821:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1822: 
 1823:    __inline__ __device__ Point2 outputCoords(void) const {
 1824:       if constexpr(ics == 1)  return p;
 1825:       else                    return {rad2deg*lon, rad2deg*lat};
 1826:    }
 1827: 
 1828:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1829:    // If ics == 2, convert the global point to the local frame
 1830:       
 1831:       if constexpr (ics == 1) {
 1832:          return p;
 1833:       } else {
 1834:          const Point3 c = {p.x, p.y, gz};
 1835:          const Point3 local = frame.G2L(p - c);
 1836:          return local;
 1837:       }
 1838:    }
 1839: 
 1840:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1841:    // If ics == 2, convert the global point to the local frame
 1842:       
 1843:       if constexpr (ics == 1) {
 1844:          return p;
 1845:       } else {
 1846:          const Point3 c = {p.x, p.y, gz};
 1847:          return c + frame.L2G(p);
 1848:       }
 1849:    }
 1850: 
 1851:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1852:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1853:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1854:    
 1855:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1856: 
 1857:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1858:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1859:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }   
 1860: 
 1861:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1862:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1863: 
 1864:    __device__ __forceinline__ void clearMatrixRow(void) {
 1865:       // Clear the matrix row for this node
 1866: 
 1867:       for (int i = 0; i <= numNodes; i++) coeffRow[i] = 0.0;
 1868: 
 1869:    }
 1870: 
 1871:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1872:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1873:       
 1874:       if (node == this) {
 1875:          *coeffDiag += value;
 1876:          return;
 1877:       }
 1878: 
 1879:       int i;
 1880:       for (i = 0; i < numNodes; i++) {
 1881:          if (nodes[i] == node) break;
 1882:       }
 1883: 
 1884:       assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1885:       coeffRow[csrSlot[i]] += value;
 1886:    }
 1887: 
 1888: 
 1889:    __device__ __inline__ void updateZCoordData(void);
 1890: 
 1891:    __device__ __forceinline__ double compZCoord(int k) const;
 1892: 
 1893:    __device__ void updateKb(void);
 1894: 
 1895:    __device__ __forceinline__ void computeBottomDragCd(void);
 1896: 
 1897: 
 1898: 
 1899: };
