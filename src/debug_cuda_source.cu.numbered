 2598: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2599: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2600: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2601: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2602: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2603: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2604: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2605: 
 2606: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2607: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2608: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2609: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2610: 
 2611: 
 2612: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2613: 
 2614: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2615: 
 2616: /**
 2617:  * This method performs backtracking from the side center until a time -dt back in time 
 2618:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2619:  * intermediate point.
 2620:  *
 2621:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2622:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2623:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2624:  * remaining time.
 2625:  * 
 2626:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2627:  * 
 2628:  * @param uuint, vvint, wwint: Velocities at the final point
 2629:  * @param jlev: Level at which the backtracking is performed
 2630:  * @param dt, dtbk: Tracking timesteps
 2631:  * @return: True if the backtracking was successful, false otherwise
 2632:  */
 2633: __inline__ __device__ bool Side::btrack(
 2634:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2635:       double dt,            // Tracking time
 2636:       double dtbk,          // Tracking timestep
 2637:       Vector3 &u_int        // Velocities at the initial point
 2638: ) const {
 2639: 
 2640:    // Start from side center
 2641:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2642: 
 2643:  
 2644:    double time_rm = dt; // Remaining time
 2645: 
 2646: 
 2647:    // Initial velocities
 2648:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2649: 
 2650:    // Find the element that is in the direction opposite to the velocity
 2651:    Element* curElem = findElementTowards(toVector2(u_int));
 2652:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2653: 
 2654: 
 2655:    // Nudges it towards the barycenter
 2656:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2657: 
 2658: 
 2659:    const int MAX_ITERATIONS = 100; 
 2660:    Element* nextElem = nullptr;
 2661:    int iter = 0;
 2662:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2663:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2664:    while(true) {
 2665: 
 2666:       // Calculate timestep
 2667:       double dtb = min(dtbk, time_rm);
 2668: 
 2669: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2670: 
 2671:       // Next point in the backtracking curve
 2672: // if (iter >= MAX_ITERATIONS - 50)  {
 2673: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2674: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2675: // }
 2676:         
 2677:       xt = x0 - dtb*u_int;
 2678: 
 2679:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2680:       assert(found && "Backtracking failed in btrack");
 2681: 
 2682: 
 2683:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2684:                       // then time_rm needs to be increased by the unused time.
 2685: 
 2686:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2687: 
 2688:       // If the velocity is too small, we stop the backtracking
 2689:       const double vmag = length(toVector2(u_int));
 2690:       if (vmag <= velmin_btrack) break;
 2691: 
 2692:       // The current point becomes the next segment's starting point.
 2693:       x0 = xt;
 2694:  
 2695:       curElem = nextElem;
 2696: 
 2697:       iter++;
 2698: 
 2699:       if (iter >= MAX_ITERATIONS) break;
 2700: 
 2701:       // if (iter >= MAX_ITERATIONS - 50) {
 2702:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 2703:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 2704:       //    }
 2705:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2706:    }
 2707: 
 2708:    assert(!curElem->isDry && "Final element is dry");
 2709: double shpDummyCoords[4];
 2710: if (!(curElem->containsPoint(toPoint2(xt)))) curElem->computeShapeCoords(toPoint2(xt), shpDummyCoords, Element::fiAnywhere);
 2711:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element"); 
 2712: 
 2713:    // Interpolate the velocities at the final point
 2714:    curElem->interpolateVelocities(xt, u_int);
 2715: 
 2716:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 2717: 
 2718: 
 2719: }
 2720: 
 2721: 
