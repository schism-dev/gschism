  428: struct Tracers {
  429:     double tracer[N_TRACERS];
  430: };
  431: 
  432: 
  433: 
  434: struct Frame {
  435:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  436:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  437:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  438:     double t00, t10;        // col0 (t20=0 implicit)
  439:     double t01, t11, t21;   // col1
  440: 
  441:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  442: 
  443:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  444:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  445: 
  446:       double sin_lon, cos_lon, sin_lat, cos_lat;
  447:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  448:       sincos(lat, &sin_lat, &cos_lat);
  449: 
  450:       t00 = -sin_lon;
  451:       t10 =  cos_lon;
  452:       t01 = -cos_lon*sin_lat;
  453:       t11 = -sin_lon*sin_lat;
  454:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  455: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  456: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  457: 
  458:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  459:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  460: 
  461:       const double col1_norm_inv = 1.0/col1_norm;
  462:       t01 = t01*col1_norm_inv;
  463:       t11 = t11*col1_norm_inv;
  464:       t21 = t21*col1_norm_inv;
  465: 
  466:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  467: 
  468:    }
  469: 
  470:    __forceinline__ __device__ void print(void) const {
  471:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  472:    }
  473: 
  474:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  475:       // cross(col0, col1), with t20=0 implicitly:
  476:       // |  i       j       k   |
  477:       // | t00     t10      0   |
  478:       // | t01     t11     t21  |
  479:       t02 =  t10*t21;
  480:       t12 = -t00*t21;
  481:       t22 =  t00*t11 - t10*t01;
  482:    }
  483: 
  484: 
  485:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  486:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  487:    // Inputs:
  488:    //        vec0: vel. in this frame;
  489:    //        frameout: Output frame;
  490:    // Output: 
  491:    //        vel. in new frame  
  492:    //
  493:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  494:    // discarding the z-component of the result to keep only the local horizontal
  495:    // plane of frame 2.
  496:    //
  497:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  498:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  499:    // are orthogonal. This product is computed as dot products between columns of
  500:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  501:    // columns of F2.// 
  502: 
  503:       auto const fo = frameout; // Just an alias for the output frame.
  504:       Vector2 res;
  505: 
  506:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  507:       // of t and fo.t are the same.
  508:       const double d00 = t00*fo.t00 + t10*fo.t10;
  509:       const double d10 = t01*fo.t00 + t11*fo.t10;
  510: 
  511:       const double d01 = t00*fo.t01 + t10*fo.t11;
  512:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  513: 
  514:       res.x = vec0.x * d00 + vec0.y * d10;
  515:       res.y = vec0.x * d01 + vec0.y * d11;
  516: 
  517:       return res;
  518:    }
  519: 
  520:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  521:       Vector3 vo;
  522:       double t02, t12, t22;
  523: 
  524:       // Compute the 3rd column of the frame tensor
  525:       getCol2(t02, t12, t22);
  526: 
  527:       vo.x = vi.x*t00 + vi.y*t10;
  528:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  529:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  530: 
  531:       return vo;
  532:    
  533:    }
  534: 
  535:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  536:       Vector3 vo;
  537:       double t02, t12, t22;
  538: 
  539:    // Compute the 3rd column of the frame tensor
  540:       getCol2(t02, t12, t22);
  541: 
  542:       // F * vi (non-transposed, so we use rows of F)
  543:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  544:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  545:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  546: 
  547:       return vo;
  548:    }
  549: 
  550: 
  551: 
  552: };
