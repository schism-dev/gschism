 4156: 
 4157:    __global__ void backtrackAllNodes(void) {
 4158: 
 4159:       // max/min # of sub-divisions
 4160:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4161:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4162: 
 4163: 
 4164:       SIDE(side);
 4165: 
 4166:       const int kb = side->kb;
 4167: 
 4168: 
 4169:       // Initialize btrack velocities to the actual velocities at the side 
 4170:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4171: 
 4172:   
 4173: 
 4174:       if (side->isDry) return;
 4175:       
 4176: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4177: 
 4178:       // Checks that at least one element is not dry
 4179:       const Element *elem1 = side->elems[0];
 4180:       const Element *elem2 = side->elems[1];
 4181: 
 4182: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4183: 
 4184:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4185:       
 4186:       // XXXXXX
 4187:       // !swild_tmp to store global coord. of the starting side
 4188:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4189:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4190:       // !Use sframe2 
 4191:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4192: 
 4193: 
 4194:       for (int k = kb; k < nvrt; k++) {
 4195:       //  Initialize (xt,yt,zt), nnel and vel.
 4196:       //  For ics=2, the coordinates are in local frames
 4197:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4198: 
 4199: 
 4200:          const int iadvf = side->iadv();  // Advection flag   
 4201:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4202: 
 4203:          Point3 xt;
 4204:          if constexpr(ics==1) {
 4205:             xt = side->center3D(k); 
 4206:          }
 4207:          else // lat/lon; in side lat/lon frame
 4208:          {
 4209:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4210:          // XXX IMPLEMENT THIS
 4211:       //          xt=0.d0
 4212:       //          yt=0.d0
 4213:       //          !centroid coord. for nudging
 4214:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4215:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4216:          }  // ics
 4217: 
 4218: 
 4219: 
 4220:          // If on land or open boundary...
 4221:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4222:          
 4223:          const double vmag = length(side->u2[k]);
 4224: 
 4225:          if (vmag <= velmin_btrack) {
 4226:             // No activity 
 4227: 
 4228:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4229: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4230: 
 4231: 
 4232:             
 4233:          } else {  // do btrack
 4234: 
 4235:             // Compute number of sub-divisions based on local gradients of the velocity field
 4236: 
 4237:             // XXX IS THIS NECESSARY?
 4238:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4239:             double suma = 0.0;
 4240:             int icount = 0;
 4241:             for (int l=0; l<2; l++) {
 4242:             // For each element sharing the side...
 4243: 
 4244:                const Element *elem = side->elems[l];
 4245:                  
 4246:                if (elem == nullptr) continue;
 4247: 
 4248:                icount++;
 4249: 
 4250:                // Not strictly along z; in ll frame for ics=2
 4251: 
 4252:                ShapeCoords utmp, vtmp;
 4253:                for (int j = 0; j < elem->i34; j++) {
 4254: 
 4255:                   const Node *node = elem->nodes[j];
 4256: 
 4257:                   if constexpr(ics==1) {
 4258:                      utmp[j] = node->u2[k].x;
 4259:                      vtmp[j] = node->u2[k].y;  
 4260:                   } else {
 4261:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4262:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 4263:                   }
 4264:                } // for j
 4265: 
 4266:                const Vector2 grad_u = elem->grad2(utmp); 
 4267:                const Vector2 grad_v = elem->grad2(vtmp);
 4268: 
 4269:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4270:             } // for ii
 4271: 
 4272:             assert(icount > 0 && "Impossible 77");
 4273: 
 4274:             // '4' is somewhat arbitrary
 4275:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4276: 
 4277:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4278: 
 4279:             Vector3 u_int = {0.0, 0.0, 0.0};
 4280: 
 4281:             
 4282:             side->btu[k] = side->btrack(k, dt, dtbk);
 4283: 
 4284:                
 4285:          } // if vmag (do backtrack)
 4286: 
 4287: 
 4288:       } // for k=kb,nvrt-1
 4289: 
 4290:    }
 4291: 
 4292: } // extern "C"
