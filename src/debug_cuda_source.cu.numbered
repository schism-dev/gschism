 5658:    __global__ void computeNodalHorizontalVelocities1(void) {
 5659:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5660:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5661: 
 5662:       ELEM(elem);
 5663: 
 5664:       const int kb = elem->kb;
 5665:       const bool isTri = elem->isTri();
 5666: 
 5667:       if constexpr(indvel <= 0) {
 5668:          // Assuming discontinoius hvel.
 5669: 
 5670: 
 5671:          if (isTri) { // For triangles
 5672:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5673:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5674: 
 5675:             for (int j = 0; j < 3; j++) {
 5676:                // For every node of the triangle...
 5677:                Node *node = elem->nodes[j];
 5678: 
 5679:                const Side *s1 = elem->sides[j];
 5680:                const Side *s2 = elem->sides[(j + 1) % 3];
 5681:                const Side *s3 = elem->sides[(j + 2) % 3];
 5682: 
 5683:                const int numElements = node->numElements;
 5684: 
 5685:                for (int k = kb; k < nvrt; k++)  {
 5686:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5687:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5688:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5689:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5690:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5691:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5692: 
 5693: auto uu = (1.0/numElements) * u;                  
 5694: if (k==0 && node->idx == 1) printf("elem->idx = %d, node->idx = %d, utmp = %e,%e, node->numElements = %d, node->numSides = %d, u = %e,%e\n", elem->idx, node->idx, node->utmp[k].x, node->utmp[k].y, node->numElements, node->numSides, uu.x, uu.y);                  
 5695:                }
 5696: 
 5697:             }
 5698:          }
 5699:          else { // For quads
 5700: 
 5701:          }
 5702: 
 5703:       }
 5704:       
 5705:    }
 5706: 
 5707: 
 5708:    __global__ void computeNodalHorizontalVelocities2(void) {
 5709:       NODE(node);
 5710: 
 5711:       for (int k = 0; k < nvrt; k++) {
 5712:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5713:       }
 5714:       
 5715:    }   
