  461: struct Element {
  462: 
  463:    // Geometry information
  464:    int idx;               // Index of the element
  465:    int i34;               // Number of sides for the element 
  466:    Side *sides[4];        // Sides of the element
  467:    Node *nodes[4];        // Nodes of the element
  468:    Element *nghbElems[4]; // Neighbors of the element
  469: 
  470:    int kb;                    // Bottom index of the element
  471:    double area;               // Area of the element
  472:    double ssign[4];           // Sign associated with each side of an element
  473:    double radius;             // Element equivalent radii
  474: 
  475:    Frame frame;
  476: 
  477:    Vector2 gradPhi[4];       // Derivatives of shape functions
  478:    Vector2 gradEta;          // Gradient of free surface elevation
  479:    Vector2 gradPr;           // Gradient of pressure    
  480:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  481: 
  482:    bool isDry;                // True if the element is dry
  483: 
  484:    Vector3 center;            // Element center coordinates
  485:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  486:    double depth;              // Depth at element (min of all nodes)
  487:    double z[nvrt];            // z-coord  (local frame - vertical up)
  488: 
  489:    // Physical information
  490:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  491: 
  492:    static const bool isblock = false;              // Always false
  493: 
  494:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  495:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  496: 
  497:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  498: 
  499:    
  500: 
  501:    double vsource;            // Volumetric source/sink term [m^3/s]
  502: 
  503:    double rho[nvrt];          // Density at each prism center
  504:    double rho_mean[nvrt];     // Mean density at each prism center
  505:    CubicSpline rho_spl;
  506:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  507:    double rho_z[nvrt];        // First derivative of density at each prism center
  508:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  509: 
  510:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  511: 
  512:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  513:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  514: 
  515:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  516:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  517: 
  518:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  519:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  520:       // Find the local index of the node in the element (0,1,2,3)
  521:       int res = __ffs((nodes[0] == node) | 
  522:                      ((nodes[1] == node) << 1) | 
  523:                      ((nodes[2] == node) << 2) | 
  524:                      ((nodes[3] == node) << 3)) - 1;
  525:       
  526:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  527:       return res;
  528:    }
  529: 
  530:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  531:       // Find the local index of the side in the element (0,1,2,3)
  532:       int res = __ffs((sides[0] == side) | 
  533:                      ((sides[1] == side) << 1) | 
  534:                      ((sides[2] == side) << 2) | 
  535:                      ((sides[3] == side) << 3)) - 1;
  536:       
  537:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  538:       return res;
  539:    }
  540: 
  541: 
  542:    __inline__ __device__ int findLevel(double z1, int k) const {
  543:       // Starting at index k, find sequentially the level that contains z
  544: 
  545:       // if z is already betweeen z[k] and z[k+1], return k
  546:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  547:       else if (z1 < z[k]) { 
  548:          // Search for increasing levels
  549:          for (int kk = k; kk < nvrt - 1; kk++) {
  550:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  551:          }
  552:          return nvrt - 1;
  553:       }
  554:       else {
  555:          // Search for decreasing levels
  556:          for (int kk = k; kk > 0; kk--) {
  557:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  558:          }
  559:          return 0;
  560:       }
  561:    }
  562: 
  563:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  564:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  565: 
  566:    // Check if the element is dry using the more up-to-date elevation.
  567:    __inline__ __device__ bool isDry2(void) const;
