 9051: 
 9052: __global__ void printMatrix(bool full) {
 9053:    // Debugging: print the FEM matrix row for each local node
 9054: 
 9055:    const int size = mesh->np;
 9056:    double sum = 0.0;
 9057: 
 9058:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9059:       const Node *node = mesh->localNodeData + idx_node;
 9060: 
 9061:       if (full)
 9062:          printf("idx_node = %d [%d] diag=%lf, [",
 9063:                 idx_node, node->numNodes, *(node->coeffDiag));
 9064: 
 9065:       // Full CSR row length = numNodes + 1 (includes diagonal)
 9066:       for (int k = 0; k < node->numNodes + 1; k++)
 9067:          sum += node->coeffRow[k];
 9068: 
 9069:       for (int j = 0; j < node->numNodes; j++) {
 9070:          const Node *nbNode = node->nodes[j];
 9071:          const double aij = node->coeffRow[node->csrSlot[j]];
 9072:          if (full && aij != 0.0)
 9073:             printf("%d:%f,  ", nbNode->idx, aij);
 9074:       }
 9075: 
 9076:       if (full) printf("]\n");
 9077:    }
 9078: 
 9079:    if (!full) printf("sum=%lf\n", sum);
 9080: }
