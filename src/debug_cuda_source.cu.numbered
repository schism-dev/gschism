 4039: __device__ __inline__ void Node::updateZCoordData(void) {
 4040: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 4041: 
 4042:    // assert(!isDry2() && "updateZCoordData: node is dry");
 4043:    // if (isDry2()) {
 4044:    //    kb = -1;  // XXXXXXXX KKKKK
 4045:    //    return;
 4046:    // }
 4047: 
 4048: 
 4049:    if constexpr(ivcor == 2) {  // SZ coordinates
 4050:       
 4051:       // Compute bottom level index
 4052:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 4053:    } 
 4054:    else {  // if (ivcor == 1) Localized sigma
 4055:       // Do nothing
 4056:    }
 4057: 
 4058: 
 4059: }
