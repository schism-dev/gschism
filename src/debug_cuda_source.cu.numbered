 1178: struct Node {
 1179: 
 1180:    // Geometry information
 1181:    int idx;        // Index of the node
 1182:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1183:    int numNodes;   // Number of nodes neighbors of this node
 1184: 
 1185:    Element **elements; // Array of pointers to the elements that share this node
 1186:    int numElements;    // Number of elements that share this node
 1187: 
 1188:    int numSides;       // Number of sides that are connected to this node
 1189: 
 1190:    Point3 p;
 1191:    Vector2 u2[nvrt];
 1192:    double  w2[nvrt];
 1193:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1194:    double z[nvrt];
 1195:    double lon, lat;
 1196:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1197:    double depth;
 1198: 
 1199:    int kb;       // Bottom index of the node
 1200: 
 1201:    bool isDry;     // True if the node is dry
 1202: 
 1203:    int iadv;     // Advection flag
 1204: 
 1205:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1206:                           // this is nullptr
 1207: 
 1208:    TempVar tmp; // Temporary variable to store different types of variables
 1209: 
 1210:    // Physical information
 1211:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1212:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1213: 
 1214:    double rho[nvrt];     // Density
 1215:    double dfv[nvrt];     // Vertical viscosity
 1216: 
 1217:    double eta1; // Elevation at nodes at previous timestep
 1218:    double eta2; // Elevation at nodes at current timestep
 1219: 
 1220:    double ETP;  // Earth Tidal Potential
 1221: 
 1222:    double pr;    // Air pressure
 1223:    double grav2; // Gravity 
 1224:    
 1225:    Vector2 dav;  // Depth averaged velocity
 1226: 
 1227:    Vector2 tau; // Wind stress vector
 1228: 
 1229:    // Vegetation parameters
 1230:    double veg_h;
 1231:    double veg_nv;
 1232:    double veg_di;
 1233:    double veg_Cd;
 1234:    double veg_h_unbent;
 1235:    double veg_di_unbent;
 1236:    double veg_nv_unbent;
 1237:    double veg_alpha_vert_mean;
 1238:    double veg_alpha0;
 1239:    double veg_alpha3D[nvrt];
 1240: 
 1241:    // Bottom drag parameters
 1242:    double Cd;       // Bottom drag coefficient
 1243:    double rough;    // Bottom roughness length
 1244:    Vector2 tau_bot; // Bottom stress vector
 1245: 
 1246:    double bdef1; // Bottom deformation at previous timestep
 1247:    double bdef2; // Bottom deformation at current timestep
 1248: 
 1249:    double qel; // RHS
 1250:    double coeffDiag; // Diagonal coefficient of the matrix
 1251:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1252: 
 1253:    double mP; // Search direction for conjugate gradient method
 1254:    double mR; // Residual for conjugate gradient method
 1255:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1256:    double mX; // Solution for conjugate gradient method
 1257: 
 1258:    // Meteorological forcing
 1259:    Vector2 u_air;
 1260:    double p_air;
 1261:    double t_air;
 1262:    double q_air;
 1263:    double wind_angle;  // Wind rotation angle
 1264: 
 1265:    __device__ void setWind(Vector2 &u) {
 1266:    // Sets the wind vector taking into account the wind rotation angle
 1267:    
 1268:       const double dir = atan2(-u.x,-u.y);
 1269:       const double speed = length(u);
 1270: 
 1271:       // Calculate new u and v components with added rotation angle
 1272:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1273:    }
 1274: 
 1275:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1276:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1277: 
 1278:    __device__ double sigmaTransitionDepth(void) const;
 1279: 
 1280:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1281:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1282:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1283:    
 1284:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1285: 
 1286:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1287: 
 1288:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1289:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1290: 
 1291:    __device__ void clearMatrixRow(void) {
 1292:       // Clear the matrix row for this node
 1293:       coeffDiag = 0.0;
 1294:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1295: 
 1296:    }
 1297: 
 1298:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1299:       // Add the value to the sparse matrix for this node
 1300:       
 1301:       if (node == this) {
 1302:          coeffDiag += value;
 1303:      
 1304:       } else {
 1305:          // Search (linearly)the index of the node in the array of nodes
 1306:          // XXX: This is not efficient, see if we can improve this
 1307:          int i;
 1308:          for (i = 0; i < numNodes; i++) {
 1309:             if (nodes[i] == node) {
 1310:                break;
 1311:             }
 1312:          }
 1313:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1314:          coeffMatrix[i] += value;
 1315:       }
 1316:    }
 1317: 
 1318: 
 1319:    __device__ __inline__ void updateZCoordData(void);
 1320: 
 1321:    __device__ double compZCoord(int k) const;
 1322: 
 1323:    __device__ void updateKb(void);
 1324: 
 1325: 
 1326: 
 1327: };
