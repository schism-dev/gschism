 3269: __device__ void Element::shapeCoordsToXY(const ShapeCoords &shpCoords, Vector2 &xt) const {
 3270: // Convert shape coordinates to cartesian coordinates
 3271: 
 3272:    if (isTri()) {
 3273:       // Triangular element
 3274: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3275:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3276:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3277:    }
 3278:    else {
 3279:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3280:    }
 3281: 
 3282: }
 3283: 
 3284: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 3285:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3286:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3287:    // The formula for the integral is:
 3288:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3289: 
 3290:    printf("intPhiPhi: TEST\n");
 3291: 
 3292:    const Node *n0 = nodes[0];
 3293:    const Node *n1 = nodes[1];
 3294:    const Node *n2 = nodes[2];
 3295:    const Node *n3 = nodes[3];
 3296: 
 3297:    const Vector2 p0 = n0->p;
 3298:    const Vector2 p1 = n1->p;
 3299:    const Vector2 p2 = n2->p;
 3300:    const Vector2 p3 = n3->p;
 3301: assert(false && "intPhiPhiQuad:CHECK?");
 3302: 
 3303:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 3304:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 3305:    double eta_sum  = iet_n[i1] + iet_n[i2];
 3306:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 3307: 
 3308:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 3309: }
 3310:    
 3311: 
 3312: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 3313:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3314:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3315:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3316:    // The formula is also based on the identity:
 3317:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3318:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3319: 
 3320:    printf("intGradPhiGradPhi: TEST\n");   
 3321: assert(false && "intGradPhiGradPhi:Do ICS==2");
 3322:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 3323: 
 3324:    const double x0 = nodes[0]->p.x;
 3325:    const double y0 = nodes[0]->p.y;
 3326:    const double x1 = nodes[1]->p.x;
 3327:    const double y1 = nodes[1]->p.y;
 3328:    const double x2 = nodes[2]->p.x;
 3329:    const double y2 = nodes[2]->p.y;
 3330:    const double x3 = nodes[3]->p.x;
 3331:    const double y3 = nodes[3]->p.y;
 3332: 
 3333:    double res = 0.0;
 3334:    
 3335:    // Quadrature points in xi and eta coordinates
 3336:    #pragma unroll
 3337:    for (int i = 0; i < 4; i++) {
 3338:       // For each quadrature point...
 3339: 
 3340:       const Point2 p = GaussPoint(i);
 3341:       const double eta = p.x;
 3342:       const double xi  = p.y;
 3343: 
 3344:       // Jacobian entries at the Gauss point p
 3345:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3346:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3347:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3348:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3349: 
 3350:       const double detJ = jacobianDet(p);
 3351:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3352: 
 3353:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3354:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3355:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3356:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3357:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3358: 
 3359:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3360:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3361:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3362:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3363:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3364: 
 3365:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3366:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3367:    }
 3368: 
 3369:    return res;
 3370: }
 3371: 
 3372: 
 3373: /**  Interpolate velocities at a given point (xt,yt,zt)
 3374: 
 3375:    @param xt, yt, zt: coordinates of the point to interpolate
 3376:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3377: 
 3378:    This is done in four steps:
 3379: 
 3380:    1. Find the shape coordinates for the final position in the element.
 3381:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3382:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3383:       z levels at xt, yt at each step.   
 3384:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3385:       horizontally and vertically.
 3386: **/
 3387: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3388:    // Interpolate the velocities at the point xt. 
 3389:    // This function works the same for triangular and quadrilateral elements.
 3390:    ShapeCoords shpCoord;
 3391: 
 3392:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 3393: 
 3394:    // First step is to compute the shape coordinates of (xt,yt)
 3395: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3396:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 3397: 
 3398:    return interpolateVelocities(shpCoord, xt.z);
 3399: 
 3400: }
 3401: 
 3402: __device__ Vector3 Element::interpolateVelocities(const ShapeCoords &shpCoord, double z) const {
 3403: 
 3404:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3405: 
 3406:       Vector3 u_int;
 3407: 
 3408:    // Find the level that contains zt
 3409:    // Uses a binary search to find the level
 3410:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3411:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3412:    int R = nvrt - 1;
 3413: 
 3414:    // Get the z coordinates at the nodes of the element at the levels L and R
 3415:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3416:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3417:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3418: 
 3419:    double zL = interpolate(shpCoord, zLAtNodes);
 3420:    double zR = interpolate(shpCoord, zRAtNodes);
 3421:    
 3422:    // Interpolates vertically the velocities
 3423:    double wght1, wght2;
 3424:    if (z<=zL) {
 3425:       wght1 = 1.0;
 3426:       wght2 = 0.0;
 3427:       z = zL;
 3428:    }
 3429:    else if (z>=zR) {
 3430:       wght1 = 0.0;
 3431:       wght2 = 1.0;
 3432:       z = zR;
 3433:    }
 3434:    else {
 3435:       // Perform a binary search to find the levels between L and R that contain xt.z
 3436:       while (R - L > 1) {
 3437:          int M = (L + R) / 2.0;
 3438: 
 3439:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3440:          double zM = interpolate(shpCoord, zMAtNodes);
 3441:          if (zM < z) 
 3442:          {
 3443:             L = M;
 3444:             zL = zM;
 3445:          }
 3446:          else 
 3447:          {
 3448:             R = M;
 3449:             zR = zM;
 3450:          }
 3451:       }
 3452:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3453:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3454: 
 3455:       wght2 = (z - zL)/(zR - zL);
 3456:       wght1 = 1.0 - wght2;
 3457: 
 3458:    }
 3459: 
 3460: 
 3461:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3462:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3463:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3464:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3465: 
 3466:    // Neither of the interpolated velocities should be NaN
 3467:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3468: 
 3469:    return u_int;
 3470: 
 3471: }
 3472: 
 3473: 
 3474: 
 3475: 
 3476: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3477: 
 3478:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3479:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3480:    const Node *n1 = side->n1;
 3481:    const Node *n2 = side->n2;
 3482: 
 3483:    bool n1_match = (n1->nodeBnd->segment == segment);
 3484:    bool n2_match = (n2->nodeBnd->segment == segment);
 3485: 
 3486:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3487:    if (n1_match && n2_match) {
 3488:       return 0.5;
 3489:    } else if (n1_match) {
 3490:       return 1.0;
 3491:    } else if (n2_match) {
 3492:       return 0.0;
 3493:    }
 3494: 
 3495:    return 0.0;
 3496: }
 3497: 
 3498: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3499: 
 3500: 
 3501: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3502: 
 3503:    const double w1 = getBoundaryArrayValueWeight();
 3504:    const double w2 = 1.0 - w1;
 3505:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3506:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3507: 
 3508:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3509: }
 3510: 
 3511: 
 3512: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3513:    const double w1 = getBoundaryArrayValueWeight();
 3514:    const double w2 = 1.0 - w1;
 3515:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3516:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3517: 
 3518:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3519: 
 3520: }
 3521: 
 3522: 
 3523: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3524:    // Returns the value of the velocity at the side center
 3525:    const double w1 = getBoundaryArrayValueWeight();
 3526:    const double w2 = 1.0 - w1;
 3527:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3528:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3529: 
 3530:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3531: }
 3532: 
 3533: 
 3534: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3535:    // Returns the value of the normal component of the velocity at the side center
 3536:    const double w1 = getBoundaryArrayValueWeight();
 3537:    const double w2 = 1.0 - w1;
 3538:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3539:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3540: 
 3541:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3542: }
