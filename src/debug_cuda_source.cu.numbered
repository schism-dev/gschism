 7777: __global__ void getStructSizes(int* sizes)  {
 7778:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7779:       sizes[0] = (int)sizeof(Node);
 7780:       sizes[1] = (int)sizeof(Element);
 7781:       sizes[2] = (int)sizeof(Side);
 7782:       sizes[3] = (int)sizeof(NodeBoundary);
 7783:       sizes[4] = (int)sizeof(SideBoundary);
 7784:       sizes[5] = (int)sizeof(BoundarySegment);
 7785: }
