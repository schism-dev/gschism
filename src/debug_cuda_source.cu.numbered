 1208: // This struct is used to store the boundary information for a node.
 1209: struct NodeBoundary {   
 1210:    int idx;
 1211:    BoundarySegment *segment;
 1212:    Node *node;
 1213:    
 1214:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1215:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1216: 
 1217:    bool isLand;
 1218: 
 1219:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1220:    double elbc;   // Elevation boundary condition
 1221:    double eth;    // Elevation time history
 1222: 
 1223:    double eta_mean; // Mean elevation at nodes
 1224: 
 1225:    bool isEssentialBC;
 1226: 
 1227:    Vector2 uth[nvrt];  // "Time history" velocity
 1228: 
 1229:    // Arrays for harmonic constituents (if needed)
 1230:    double  emo[nbfr];  // Elevation amplitude
 1231:    double  efa[nbfr];  // Elevation phase
 1232:    Vector2 umo[nbfr];  // velocity amplitude
 1233:    Vector2 ufa[nbfr];  // velocity phase
 1234: 
 1235: 
 1236:    NodeBoundary(void) {
 1237:       isLand = false;
 1238:    }
 1239:    NodeBoundary(bool _isLand) {
 1240:       isLand = _isLand;
 1241:    }
 1242: 
 1243:    
 1244:    __forceinline__ __device__ int numSidesForAverage() const {
 1245:    // Returns the number of sides that are connected to the node and have the same segment.
 1246:    // This is used to compute the average velocity at the node for open boundary nodes.
 1247:       int res = 0;
 1248:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1249:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1250: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1251:       return res;
 1252:    }
 1253: 
 1254: 
 1255:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1256:       assert(index == 0 || index == 1); 
 1257:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1258:    }
 1259: 
 1260: 
 1261: };
