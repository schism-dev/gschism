 2008: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2009: // return;   
 2010:    // Lock the mutex
 2011:    lock(&debugPlotMutex);
 2012:  
 2013:    bool ok = true;
 2014:    if (debugPlotIdx == nullptr) ok = false;
 2015:    if (*debugPlotIdx >= 1000000) ok = false;
 2016:    if (ok) {
 2017:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2018:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2019:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2020:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2021:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2022:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2023:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2024:       (*debugPlotIdx)++;
 2025:    }
 2026: 
 2027:    __threadfence();               // ensure all above writes are visible
 2028:    // Unlock the mutex
 2029:    unlock(&debugPlotMutex);
 2030: 
 2031: }
