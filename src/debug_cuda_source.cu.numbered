 2227:    
 2228:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2229:    // Project the vectors from the node frame to the element frame
 2230: 
 2231:  
 2232:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2233:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2234:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2235:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2236:       else          v[3] = Vector2();
 2237:    }
 2238: 
 2239:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2240:    // Project the vectors from the side frame to the element frame
 2241: 
 2242:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2243:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2244:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2245:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2246:       else          v[3] = Vector2();
 2247:    }
