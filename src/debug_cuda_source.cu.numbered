 2745: 
 2746: //       const Side& side = sides[i];
 2747: 
 2748: //       xIntersect=-1.e25;
 2749: //       yIntersect=-1.e25;
 2750: 
 2751: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2752: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2753: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2754: 
 2755: //       if (delta != 0.0) {
 2756: //          // Solves the two linear equations for tt1 and tt2
 2757: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2758: //          const double tt2 = delta2/delta;
 2759: 
 2760: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2761: //          // Similarly, we use tt2 to compute the intersection point.
 2762: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2763: //             xIntersect = x3 + (x4 - x3)*tt2;
 2764: //             yIntersect = y3 + (y4 - y3)*tt2;
