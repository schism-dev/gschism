 1113: struct Node {
 1114: 
 1115:    // Geometry information
 1116:    int idx;        // Index of the node
 1117:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1118:    int numNodes;   // Number of nodes neighbors of this node
 1119: 
 1120:    Element **elements; // Array of pointers to the elements that share this node
 1121:    int numElements;    // Number of elements that share this node
 1122: 
 1123:    int numSides;       // Number of sides that are connected to this node
 1124: 
 1125:    Point3 p;
 1126:    Vector3 u2[nvrt];
 1127:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1128:    double z[nvrt];
 1129:    double lon, lat;
 1130:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1131:    double depth;
 1132: 
 1133:    int kb;       // Bottom index of the node
 1134: 
 1135:    bool isDry;     // True if the node is dry
 1136: 
 1137:    int iadv;     // Advection flag
 1138: 
 1139:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1140:                           // this is nullptr
 1141: 
 1142:    TempVar tmp; // Temporary variable to store different types of variables
 1143: 
 1144:    // Physical information
 1145:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1146:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1147: 
 1148:    double rho[nvrt];     // Density
 1149:    double dfv[nvrt];     // Vertical viscosity
 1150: 
 1151:    double eta1; // Elevation at nodes at previous timestep
 1152:    double eta2; // Elevation at nodes at current timestep
 1153: 
 1154:    double ETP;  // Earth Tidal Potential
 1155: 
 1156:    double pr;    // Air pressure
 1157:    double grav2; // Gravity 
 1158:    
 1159:    Vector2 dav;  // Depth averaged velocity
 1160: 
 1161:    Vector2 tau; // Wind stress vector
 1162: 
 1163:    // Vegetation parameters
 1164:    double veg_h;
 1165:    double veg_nv;
 1166:    double veg_di;
 1167:    double veg_Cd;
 1168:    double veg_h_unbent;
 1169:    double veg_di_unbent;
 1170:    double veg_nv_unbent;
 1171:    double veg_alpha_vert_mean;
 1172:    double veg_alpha0;
 1173:    double veg_alpha3D[nvrt];
 1174: 
 1175:    // Bottom drag parameters
 1176:    double Cd;       // Bottom drag coefficient
 1177:    double rough;    // Bottom roughness length
 1178:    Vector2 tau_bot; // Bottom stress vector
 1179: 
 1180:    double bdef1; // Bottom deformation at previous timestep
 1181:    double bdef2; // Bottom deformation at current timestep
 1182: 
 1183:    double qel; // RHS
 1184:    double coeffDiag; // Diagonal coefficient of the matrix
 1185:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1186: 
 1187:    double mP; // Search direction for conjugate gradient method
 1188:    double mR; // Residual for conjugate gradient method
 1189:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1190:    double mX; // Solution for conjugate gradient method
 1191: 
 1192:    // Meteorological forcing
 1193:    Vector2 u_air;
 1194:    double p_air;
 1195:    double t_air;
 1196:    double q_air;
 1197:    double wind_angle;  // Wind rotation angle
 1198: 
 1199:    __device__ void setWind(Vector2 &u) {
 1200:    // Sets the wind vector taking into account the wind rotation angle
 1201:    
 1202:       const double dir = atan2(-u.x,-u.y);
 1203:       const double speed = length(u);
 1204: 
 1205:       // Calculate new u and v components with added rotation angle
 1206:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1207:    }
 1208: 
 1209:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1210:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1211: 
 1212:    __device__ double sigmaTransitionDepth(void) const;
 1213: 
 1214:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1215:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1216:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1217: 
 1218:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1219: 
 1220:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1221:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1222: 
 1223:    __device__ void clearMatrixRow(void) {
 1224:       // Clear the matrix row for this node
 1225:       coeffDiag = 0.0;
 1226:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1227: 
 1228:    }
 1229: 
 1230:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1231:       // Add the value to the sparse matrix for this node
 1232:       
 1233:       if (node == this) {
 1234:          coeffDiag += value;
 1235:      
 1236:       } else {
 1237:          // Search (linearly)the index of the node in the array of nodes
 1238:          // XXX: This is not efficient, see if we can improve this
 1239:          int i;
 1240:          for (i = 0; i < numNodes; i++) {
 1241:             if (nodes[i] == node) {
 1242:                break;
 1243:             }
 1244:          }
 1245:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1246:          coeffMatrix[i] += value;
 1247:       }
 1248:    }
 1249: 
 1250: 
 1251:    __device__ __inline__ void updateZCoordData(void);
 1252: 
 1253:    __device__ double compZCoord(int k) const;
 1254: 
 1255:    __device__ void updateKb(void);
 1256: 
 1257: 
 1258: 
 1259: };
