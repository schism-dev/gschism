  508:    static const bool isblock = false;              // Always false
  509: 
  510:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  511:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  512: 
  513:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  514: 
  515:    
  516: 
  517:    double vsource;            // Volumetric source/sink term [m^3/s]
  518: 
  519:    double rho[nvrt];          // Density at each prism center
  520:    double rho_mean[nvrt];     // Mean density at each prism center
  521:    CubicSpline rho_spl;
  522:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  523:    double rho_z[nvrt];        // First derivative of density at each prism center
  524:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  525: 
  526:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  527: 
  528:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  529:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  530: 
  531:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  532:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  533: 
  534:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  535:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  536:       // Find the local index of the node in the element (0,1,2,3)
  537:       int res = __ffs((nodes[0] == node) | 
  538:                      ((nodes[1] == node) << 1) | 
  539:                      ((nodes[2] == node) << 2) | 
  540:                      ((nodes[3] == node) << 3)) - 1;
  541:       
  542:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  543:       return res;  
  544:    }
  545: 
  546:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  547:       // Find the local index of the side in the element (0,1,2,3)
  548:       int res = __ffs((sides[0] == side) | 
  549:                      ((sides[1] == side) << 1) | 
  550:                      ((sides[2] == side) << 2) | 
  551:                      ((sides[3] == side) << 3)) - 1;
  552:       
  553:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  554:       return res;
  555:    }
  556: 
  557: 
  558:    __inline__ __device__ int findLevel(double z1, int k) const {
  559:       // Starting at index k, find sequentially the level that contains z
  560: 
  561:       // For testing purposes, forgets k and performs a full search.
  562:       for (k = kb; k < nvrt - 1; k++) {
  563:          if (idx==46) printf("((()))))) kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", k, k, z[k], k + 1, z[k + 1]);            
  564:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  565:       }
  566:       return nvrt - 2;
  567: 
  568: 
  569:       // if z is already betweeen z[k] and z[k+1], return k
  570:       if (idx==46) for (int kkk=0; kkk<nvrt; kkk++) printf("##>>>>  z[%d] = %.16f\n", kkk, z[kkk]);             
  571: if (idx==46) printf("##>>>>#### kk = %d, z1 = %.16f, z[%d] = %.16f, z[%d] = %.16f\n", k, z1, k, z[k], k + 1, z[k + 1]);       
  572:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  573:       else if (z1 <  z[k]) { 
  574:          // Search for increasing levels
  575:          for (int kk = k; kk < nvrt - 1; kk++) {
  576: if (idx==46) printf("##>>#### kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", kk, kk, z[kk], kk + 1, z[kk + 1]);            
  577:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  578:          }
  579:          return nvrt - 1;
  580:       }
  581:       else {
  582:          // Search for decreasing levels
  583:          for (int kk = k; kk >= kb; kk--) {
  584: if (idx==46) printf("###>>### kk = %d, z[%d] = %.16f, z[%d] = %.16f\n", kk, kk, z[kk], kk + 1, z[kk + 1]);             
  585:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  586:          }
  587:          return 0;
  588:       }
  589:    }
  590: 
  591:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  592:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  593: 
  594:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  595:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  596:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  597:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  598:        const double eta = (idx & 1) ? +g : -g;
  599:        const double xi  = (idx & 2) ? +g : -g;
  600:        return {eta, xi};
  601:    }  
  602: 
  603:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  604:    __device__ __forceinline__ double etaSign(int idx) const {
  605:       // bit1: 0 -> -1, 1 -> +1
  606:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  607:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  608:    }
  609: 
  610:    __device__ __forceinline__ double xiSign(int idx) const {
  611:       // +1 if (bit0 XOR bit1), else -1
  612:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  613:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  614: 
  615:    }
  616: 
  617:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  618:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  619:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  620:    }
  621: 
  622:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  623:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  624:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  625:    }   
  626: 
  627:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  628:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  629:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  630:    }      
  631:    
  632:    __inline__ __device__ double detJ_eta(void) const;
  633: 
  634:    __inline__ __device__ double detJ_xi(void) const;
  635: 
  636:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  637: 
  638:    // Check if the element is dry using the more up-to-date elevation.
  639:    __inline__ __device__ bool isDry2(void) const;
  640: 
  641:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  642: 
  643:    __inline__ __device__ double computeSignedArea(void) const;
  644: 
  645:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  646:       // Nudges the point (x,y) to the barycenter of the element
  647:       p = (1-eps)*p + eps*toVector2(center);
  648:    }
  649: 
  650:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  651:    
  652:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  653: 
  654:    __device__ double intPhiPhi(int i1, int i2) const;
  655: 
  656:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  657: 
  658:    __device__ Vector2 grad2(double *a) const
  659:    {
  660:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  661:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  662:       if (isQuad()) {
  663:          gx += a[3]*gradPhi[3].x;
  664:          gy += a[3]*gradPhi[3].y;
  665:       }
  666:       return {gx, gy};
  667:    }
  668: 
  669:    __device__ Vector2 grad2(double Node::* field) const
  670:    {
  671:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  672:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  673:       if (isQuad()) {
  674:          gx += (nodes[3]->*field)*gradPhi[3].x;
  675:          gy += (nodes[3]->*field)*gradPhi[3].y;
  676:       }
  677:       return {gx, gy};
  678:    }
  679: 
  680:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  681:    __device__ __forceinline__ Vector3 n(int k) const {
  682:       double area3D;
  683:       return n(k, area3D);
  684:     }
