 2247:    template<typename T>
 2248:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2249: 
 2250:       T values[4];
 2251: 
 2252: 
 2253:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2254:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2255:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2256:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2257:       else          values[3] = T();
