 3431: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3432:                                             double *emo, double *efa, 
 3433:                                             double *umo, double *ufa, 
 3434:                                             double *vmo, double *vfa) {
 3435: 
 3436: 
 3437:    NODE_BND(nodeBnd);
 3438:    const int idx = idx_node_bnd;    
 3439: 
 3440:    nodeBnd->idx = idx;
 3441: 
 3442:    // Need to find the segment index and the index of the node on the segment
 3443:    int idxNode = -1;
 3444:    int iseg, i;
 3445:    for (iseg = 0; iseg < nope; iseg++) {
 3446:       // for each segment...
 3447:       for (i = 0; i < nond[iseg]; i++) {
 3448:          idxNode = iond[iseg + i*nope];
 3449:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3450:          
 3451:       }
 3452:    }
 3453: 
 3454:    assert(iseg < nope && "iseg is out of bounds");
 3455: 
 3456: found: // Jumped here when the node was found
 3457: 
 3458:    nodeBnd->isEssentialBC = true;
 3459:    nodeBnd->elbc = 0.0;
 3460: 
 3461:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3462: 
 3463:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3464:       nodeBnd->efa[jfr] = efa[idx2];
 3465:       nodeBnd->emo[jfr] = emo[idx2];
 3466:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3467:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3468: 
 3469:    }
 3470:         
 3471: 
 3472: }
