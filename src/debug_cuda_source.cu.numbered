  446: // Polynomial class
  447: template<int grade>
  448: struct Polynomial {
  449:     // Static assertion to give a clear error message at compile time
  450:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  451: };
  452: 
  453: 
  454: // Explicit specialization for grade 4
  455: template<>
  456: struct Polynomial<4> {
  457:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  458: 
  459:    // Constructor from coefficients
  460:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  461: 
  462:    __device__ __forceinline__ double eval(double x) const {
  463:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  464:    }
  465: };
