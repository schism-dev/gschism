 8085: __global__ void returnMatrix(double *res) {
 8086:    // Debugging: returns the matrix as a CuPy array
 8087: 
 8088:    const int size = mesh->np;
 8089:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8090:       const Node *node = mesh->localNodeData + idx_node;
 8091:       res[idx_node*size + idx_node] = node->coeffDiag;
 8092:       for (int j = 0; j < node->numNodes; j++) {
 8093:          Node* nbNode = node->nodes[j];
 8094:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 8095:       }
 8096: 
 8097:    }
 8098:    
 8099: }
 8100: 
 8101: __global__ void returnX(double *res) {
 8102:    // Debugging: returns the matrix as a CuPy array
 8103: 
