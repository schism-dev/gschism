 8255: #ifdef OLD_PCG_SOLVER
 8256: __global__ void computeMatrixProductAndDotProducts() {
 8257:    // Computes A*p, r'Mr and p'Ap
 8258: 
 8259:    // 1) shared buffer: first half for rMr, second for pAp
 8260:    __shared__ double sdata[2*BLOCK_SIZE];
 8261:    double* s_rMr = sdata;
 8262:    double* s_pAp = sdata + BLOCK_SIZE;
 8263: 
 8264:    const int tid = threadIdx.x;
 8265: 
 8266:    double l_pAp = 0.0;
 8267: 
 8268:    s_rMr[tid] = 0.0;
 8269:    s_pAp[tid] = 0.0;
 8270: 
 8271:    // 2) get your node pointer
 8272:    // NODE(node);   
 8273:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8274:    Node *node = &(mesh->localNodeData[idx_node]); 
 8275:       if (idx_node < mesh->np) {
 8276: 
 8277:       const double diag = node->coeffDiag;
 8278:       const double r    = node->mR;
 8279:       const double p    = node->mP;  
 8280: 
 8281:       // apply preconditioner on the fly:
 8282:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8283: 
 8284:       // 4) compute Ap = A.p
 8285:       double Ap = node->coeffDiag * node->mP;
 8286:       for (int j = 0; j < node->numNodes; ++j) {
 8287:          const Node *nbNode = node->nodes[j];
 8288:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8289: 
 8290:       }
 8291: 
 8292:       node->mAp = Ap;
 8293:       
 8294: 
 8295:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8296:       // const double l_rMr = r*Mr;  // r'Mr
 8297:       l_pAp = p*Ap;  // p'Ap
 8298: 
 8299: 
 8300:    }
 8301: 
 8302:    // 6) write into shared mem
 8303:    // s_rMr[tid] = l_rMr;
 8304:    s_pAp[tid] = l_pAp;
 8305: 
 8306:    __syncthreads();
 8307: 
 8308:    // 7) block-wide tree reduction
 8309:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8310:       if (tid < stride)  {
 8311:          s_pAp[tid] += s_pAp[tid + stride];
 8312:       }
 8313:       __syncthreads();
 8314:    }
 8315: 
 8316:    // 8) thread 0 atomically accumulates into the globals
 8317:    // XXX: This is slower than it needs to be, but it is simple and works
 8318:    if (tid == 0) {
 8319:       atomicAdd(pAp, s_pAp[0]);
 8320:    }
 8321: 
 8322: 
 8323: }
 8324: 
 8325: 
 8326: __global__ void updateSolutionAndDotProducts(void) {
 8327:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8328: 
 8329:    const int tid = threadIdx.x;
 8330: 
 8331:    s_rMr[tid] = 0.0;
 8332: 
 8333:    // get node & bounds-check:
 8334:    NODE(node);
 8335: 
 8336:    
 8337:    // Compute alpha
 8338:    const double alpha = (*rMr_old)/(*pAp); 
 8339: 
 8340: 
 8341:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8342: 
 8343: 
 8344:    // load scalars
 8345:    const double diag = node->coeffDiag;
 8346:    const double p    = node->mP;
 8347:    const double Ap   = node->mAp;
 8348:    const double x    = node->mX;
 8349:    const double r    = node->mR;
 8350:    
 8351:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8352: 
 8353:    // 1) update solution & residual
 8354:    const double x_new = x + alpha*p;
 8355:    const double r_new = r - alpha*Ap;
 8356:    node->mX = x_new;
 8357:    node->mR = r_new;
 8358: 
 8359:    // 2) apply Jacobi preconditioner on the fly
 8360:    const double Mr_new = r_new/diag;
 8361: 
 8362: 
 8363:    // 3) local contributions for the two dot-products
 8364:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8365: 
 8366:    // 4) write into shared-mem
 8367:    s_rMr[tid] = l_rMr;
 8368: 
 8369:    __syncthreads();
 8370: 
 8371: 
 8372:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8373:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8374:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8375:       __syncthreads();
 8376:    }
 8377: 
 8378:    // 6) thread 0 atomically folds into the global accumulators
 8379:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8380: 
 8381: 
 8382: }
 8383: 
 8384: 
 8385: __global__ void updateSearchDirection() {
 8386: 
 8387:     NODE(node);
 8388: 
 8389:     // recompute z on-the-fly
 8390:     const double z = node->mR / node->coeffDiag;
 8391:     const double p = node->mP;
 8392: 
 8393:     const double beta = (*rMr_new)/(*rMr_old);
 8394: 
 8395: 
 8396:     // p =z + beta*p
 8397:     node->mP = z + beta*p;
 8398: 
 8399: }
 8400: 
 8401: __global__ void initializeScalars(double *scalars) {
 8402: 
 8403:    // These point to a cupy array in the host code
 8404:    rMr_old = scalars + 0;
 8405:    rMr_new = scalars + 1;
 8406:    pAp     = scalars + 2;
 8407: }
 8408: 
 8409: __global__ void initializePreconditionedResidual(void) {
 8410: 
 8411:     __shared__ double s_rMr[BLOCK_SIZE];  
 8412: 
 8413:     s_rMr[threadIdx.x] = 0.0;
 8414: 
 8415:     NODE_ALL(node, valid);
 8416:     const int tid = threadIdx.x;
 8417:     // For the first iteration:
 8418:     // 1. Initial solution x = 0 (already set)
 8419:     // 2. Initial residual r = b (stored in qel)
 8420:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8421: 
 8422: // XXX we should use the guess solution here    
 8423: 
 8424:     double l_rMr = 0.0;
 8425:     if (valid) {
 8426:       // Set initial residual r = b (from qel)
 8427:       node->mR = node->qel;
 8428: 
 8429:       // Compute z = M^-1 * r (preconditioned residual)
 8430:       const double z = node->mR / node->coeffDiag;
 8431: 
 8432:       // Set initial search direction p = z
 8433:       node->mP = z;
 8434: 
 8435:       // Initialize other variables needed for CG
 8436:       node->mX = 0.0;  // Initial solution
 8437:       node->mAp = 0.0; // Will be computed in first iteration
 8438: 
 8439: 
 8440:       // Computes the first r'Mr (reduction)
 8441:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8442:     }
 8443:     // 4) write into shared-mem
 8444:     s_rMr[tid] = l_rMr;
 8445: 
 8446:     __syncthreads();
 8447: 
 8448: 
 8449:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8450:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8451:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8452:         __syncthreads();
 8453:     }
 8454: 
 8455:     // 6) thread 0 atomically folds into the global accumulators
 8456:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8457: 
 8458:     *rMr_old = 0.0;
 8459:     *pAp = 0.0;
 8460: }
 8461: #endif
 8462: 
