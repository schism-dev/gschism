 7718: 
 7719: __global__ void returnMatrix(double *res) {
 7720:    // Debugging: returns the matrix as a CuPy array
 7721: 
 7722:    const int size = mesh->np;
 7723:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7724:       const Node *node = mesh->localNodeData + idx_node;
 7725:       res[idx_node*size + idx_node] = node->coeffDiag;
 7726:       for (int j = 0; j < node->numNodes; j++) {
 7727:          Node* nbNode = node->nodes[j];
 7728:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7729:       }
 7730: 
 7731:    }
 7732:    
 7733: }
 7734: 
 7735: 
 7736: __global__ void computeMatrixProductAndDotProducts() {
 7737:    // Computes A*p, r'Mr and p'Ap
 7738: 
 7739:    // 1) shared buffer: first half for rMr, second for pAp
 7740:    __shared__ double sdata[2*BLOCK_SIZE];
 7741:    double* s_rMr = sdata;
 7742:    double* s_pAp = sdata + BLOCK_SIZE;
 7743: 
 7744:    const int tid = threadIdx.x;
 7745: 
 7746:    double l_pAp = 0.0;
 7747: 
 7748:    s_rMr[tid] = 0.0;
 7749:    s_pAp[tid] = 0.0;
 7750: 
 7751:    // 2) get your node pointer
 7752:    // NODE(node);   
 7753:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7754:    Node *node = &(mesh->localNodeData[idx_node]); 
 7755:       if (idx_node < mesh->np) {
 7756: 
 7757:       const double diag = node->coeffDiag;
 7758:       const double r    = node->mR;
 7759:       const double p    = node->mP;  
 7760: 
 7761:       // apply preconditioner on the fly:
 7762:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7763: 
 7764:       // 4) compute Ap = A.p
 7765:       double Ap = node->coeffDiag * node->mP;
 7766:       for (int j = 0; j < node->numNodes; ++j) {
 7767:          const Node *nbNode = node->nodes[j];
 7768:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7769: 
 7770:       }
 7771: 
 7772:       node->mAp = Ap;
 7773:       
 7774: 
 7775:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7776:       // const double l_rMr = r*Mr;  // r'Mr
 7777:       l_pAp = p*Ap;  // p'Ap
 7778: 
 7779: 
 7780:    }
 7781: 
 7782:    // 6) write into shared mem
 7783:    // s_rMr[tid] = l_rMr;
 7784:    s_pAp[tid] = l_pAp;
 7785: 
 7786:    __syncthreads();
 7787: 
 7788:    // 7) block-wide tree reduction
 7789:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7790:       if (tid < stride)  {
 7791:          s_pAp[tid] += s_pAp[tid + stride];
 7792:       }
 7793:       __syncthreads();
 7794:    }
 7795: 
 7796:    // 8) thread 0 atomically accumulates into the globals
 7797:    // XXX: This is slower than it needs to be, but it is simple and works
 7798:    if (tid == 0) {
 7799:       atomicAdd(pAp, s_pAp[0]);
 7800:    }
 7801: 
 7802: 
 7803: }
 7804: 
 7805: 
 7806: __global__ void updateSolutionAndDotProducts(void) {
 7807:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7808: 
 7809:    const int tid = threadIdx.x;
 7810: 
 7811:    s_rMr[tid] = 0.0;
 7812: 
 7813:    // get node & bounds-check:
 7814:    NODE(node);
 7815: 
 7816:    
 7817:    // Compute alpha
 7818:    const double alpha = (*rMr_old)/(*pAp); 
 7819: 
 7820: 
 7821:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7822: 
 7823: 
 7824:    // load scalars
 7825:    const double diag = node->coeffDiag;
 7826:    const double p    = node->mP;
 7827:    const double Ap   = node->mAp;
 7828:    const double x    = node->mX;
 7829:    const double r    = node->mR;
 7830:    
 7831:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7832: 
 7833:    // 1) update solution & residual
 7834:    const double x_new = x + alpha*p;
 7835:    const double r_new = r - alpha*Ap;
 7836:    node->mX = x_new;
 7837:    node->mR = r_new;
 7838: 
 7839:    // 2) apply Jacobi preconditioner on the fly
 7840:    const double Mr_new = r_new/diag;
 7841: 
 7842: 
 7843:    // 3) local contributions for the two dot-products
 7844:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7845: 
 7846:    // 4) write into shared-mem
 7847:    s_rMr[tid] = l_rMr;
 7848: 
 7849:    __syncthreads();
 7850: 
 7851: 
 7852:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7853:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7854:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7855:       __syncthreads();
 7856:    }
 7857: 
 7858:    // 6) thread 0 atomically folds into the global accumulators
 7859:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7860: 
 7861: 
 7862: }
 7863: 
 7864: 
 7865: __global__ void updateSearchDirection() {
 7866: 
 7867:     NODE(node);
 7868: 
 7869:     // recompute z on-the-fly
 7870:     const double z = node->mR / node->coeffDiag;
 7871:     const double p = node->mP;
 7872: 
 7873:     const double beta = (*rMr_new)/(*rMr_old);
 7874: 
 7875: 
 7876:     // p =z + beta*p
 7877:     node->mP = z + beta*p;
 7878: 
 7879: }
 7880: 
 7881: __global__ void initializeScalars(double *scalars) {
 7882: 
 7883:    // These point to a cupy array in the host code
 7884:    rMr_old = scalars + 0;
 7885:    rMr_new = scalars + 1;
 7886:    pAp     = scalars + 2;
 7887: }
 7888: 
 7889: __global__ void initializePreconditionedResidual(void) {
 7890: 
 7891:     __shared__ double s_rMr[BLOCK_SIZE];  
 7892: 
 7893:     s_rMr[threadIdx.x] = 0.0;
 7894: 
 7895:     NODE_ALL(node, valid);
 7896:     const int tid = threadIdx.x;
 7897:     // For the first iteration:
 7898:     // 1. Initial solution x = 0 (already set)
 7899:     // 2. Initial residual r = b (stored in qel)
 7900:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7901: 
 7902: // XXX we should use the guess solution here    
 7903: 
 7904:     double l_rMr = 0.0;
 7905:     if (valid) {
 7906:       // Set initial residual r = b (from qel)
 7907:       node->mR = node->qel;
 7908: 
 7909:       // Compute z = M^-1 * r (preconditioned residual)
 7910:       const double z = node->mR / node->coeffDiag;
 7911: 
 7912:       // Set initial search direction p = z
 7913:       node->mP = z;
 7914: 
 7915:       // Initialize other variables needed for CG
 7916:       node->mX = 0.0;  // Initial solution
 7917:       node->mAp = 0.0; // Will be computed in first iteration
 7918: 
 7919: 
 7920:       // Computes the first r'Mr (reduction)
 7921:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7922:     }
 7923:     // 4) write into shared-mem
 7924:     s_rMr[tid] = l_rMr;
 7925: 
 7926:     __syncthreads();
 7927: 
 7928: 
 7929:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7930:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7931:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7932:         __syncthreads();
 7933:     }
 7934: 
 7935:     // 6) thread 0 atomically folds into the global accumulators
 7936:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7937: 
 7938:     *rMr_old = 0.0;
 7939:     *pAp = 0.0;
 7940: }
 7941: 
 7942: 
 7943: 
 7944: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7945:    Element *elems = mesh->localElemData;
 7946: 
 7947:    *addr = elems;
 7948:    *sizeElement = sizeof(Element);
 7949:    switch (varCode) {
 7950:       case (int)VarCode::z:
 7951:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7952:          *sizeType = sizeof(double);
 7953:          break;
 7954:       case (int)VarCode::x:
 7955:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7956:          *sizeType = sizeof(Vector2);
 7957:          break;
 7958:       case (int)VarCode::area:
 7959:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7960:          *sizeType = sizeof(double);
 7961:          break;
 7962:       case (int)VarCode::depth:
 7963:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7964:          *sizeType = sizeof(double);
 7965:          break;
 7966:       case (int)VarCode::radius:
 7967:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7968:          *sizeType = sizeof(double);
 7969:          break;
 7970:       case (int)VarCode::lonlat:
 7971:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7972:          *sizeType = sizeof(double);
 7973:          break;
 7974:       case (int)VarCode::ghat:
 7975:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7976:          *sizeType = sizeof(Vector2);
 7977:          break;
 7978:       case (int)VarCode::kb:
 7979:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7980:          *sizeType = sizeof(int);
 7981:          break;
 7982:       case (int)VarCode::isdry:
 7983:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7984:          *sizeType = sizeof(int);
 7985:          break;            
 7986:       case (int)VarCode::w:
 7987:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7988:          *sizeType = sizeof(double);
 7989:          break;
 7990:       case (int)VarCode::FaceIndices:
 7991:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7992:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7993:          *sizeType = sizeof(Node);
 7994:          break;
 7995:       default:
 7996:          *offset = -1;
 7997:    }
 7998: }
 7999: 
