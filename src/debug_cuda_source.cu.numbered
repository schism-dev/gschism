 2148: 
 2149: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2150:    if constexpr(ics == 1)  {
 2151:       return center;
 2152: 
 2153:    } else {
 2154:       const Point2 p0 = nodes[0]->outputCoords();
 2155:       const Point2 p1 = nodes[1]->outputCoords();
 2156:       const Point2 p2 = nodes[2]->outputCoords();
 2157: 
 2158:       if (isTri()) {
 2159:          return (1.0/3.0)*(p0 + p1 + p2);
 2160: 
 2161:       } else {
 2162:          const Point2 p3 = nodes[3]->outputCoords();
 2163:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2164:       }
 2165: 
 2166:    }
 2167: }
 2168: 
 2169: 
 2170: __device__ __forceinline__ double Element::centerZ(void) const { 
 2171: // Z coordinate of the element center in the global cartesian coordinates.
 2172: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2173: 
 2174:    if constexpr(ics==1) { 
 2175:       return 0.0; 
 2176: 
 2177:    } else { 
 2178: 
 2179:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2180:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2181:    } 
 2182: }
