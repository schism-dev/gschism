 8182: #ifdef OLD_PCG_SOLVER
 8183: __global__ void computeMatrixProductAndDotProducts() {
 8184:    // Computes A*p, r'Mr and p'Ap
 8185: 
 8186:    // 1) shared buffer: first half for rMr, second for pAp
 8187:    __shared__ double sdata[2*BLOCK_SIZE];
 8188:    double* s_rMr = sdata;
 8189:    double* s_pAp = sdata + BLOCK_SIZE;
 8190: 
 8191:    const int tid = threadIdx.x;
 8192: 
 8193:    double l_pAp = 0.0;
 8194: 
 8195:    s_rMr[tid] = 0.0;
 8196:    s_pAp[tid] = 0.0;
 8197: 
 8198:    // 2) get your node pointer
 8199:    // NODE(node);   
 8200:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8201:    Node *node = &(mesh->localNodeData[idx_node]); 
 8202:       if (idx_node < mesh->np) {
 8203: 
 8204:       const double diag = node->coeffDiag;
 8205:       const double r    = node->mR;
 8206:       const double p    = node->mP;  
 8207: 
 8208:       // apply preconditioner on the fly:
 8209:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8210: 
 8211:       // 4) compute Ap = A.p
 8212:       double Ap = node->coeffDiag * node->mP;
 8213:       for (int j = 0; j < node->numNodes; ++j) {
 8214:          const Node *nbNode = node->nodes[j];
 8215:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8216: 
 8217:       }
 8218: 
 8219:       node->mAp = Ap;
 8220:       
 8221: 
 8222:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8223:       // const double l_rMr = r*Mr;  // r'Mr
 8224:       l_pAp = p*Ap;  // p'Ap
 8225: 
 8226: 
 8227:    }
 8228: 
 8229:    // 6) write into shared mem
 8230:    // s_rMr[tid] = l_rMr;
 8231:    s_pAp[tid] = l_pAp;
 8232: 
 8233:    __syncthreads();
 8234: 
 8235:    // 7) block-wide tree reduction
 8236:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8237:       if (tid < stride)  {
 8238:          s_pAp[tid] += s_pAp[tid + stride];
 8239:       }
 8240:       __syncthreads();
 8241:    }
 8242: 
 8243:    // 8) thread 0 atomically accumulates into the globals
 8244:    // XXX: This is slower than it needs to be, but it is simple and works
 8245:    if (tid == 0) {
 8246:       atomicAdd(pAp, s_pAp[0]);
 8247:    }
 8248: 
 8249: 
 8250: }
 8251: 
 8252: 
 8253: __global__ void updateSolutionAndDotProducts(void) {
 8254:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8255: 
 8256:    const int tid = threadIdx.x;
 8257: 
 8258:    s_rMr[tid] = 0.0;
 8259: 
 8260:    // get node & bounds-check:
 8261:    NODE(node);
 8262: 
 8263:    
 8264:    // Compute alpha
 8265:    const double alpha = (*rMr_old)/(*pAp); 
 8266: 
 8267: 
 8268:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8269: 
 8270: 
 8271:    // load scalars
 8272:    const double diag = node->coeffDiag;
 8273:    const double p    = node->mP;
 8274:    const double Ap   = node->mAp;
 8275:    const double x    = node->mX;
 8276:    const double r    = node->mR;
 8277:    
 8278:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8279: 
 8280:    // 1) update solution & residual
 8281:    const double x_new = x + alpha*p;
 8282:    const double r_new = r - alpha*Ap;
 8283:    node->mX = x_new;
 8284:    node->mR = r_new;
 8285: 
 8286:    // 2) apply Jacobi preconditioner on the fly
 8287:    const double Mr_new = r_new/diag;
 8288: 
 8289: 
 8290:    // 3) local contributions for the two dot-products
 8291:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8292: 
 8293:    // 4) write into shared-mem
 8294:    s_rMr[tid] = l_rMr;
 8295: 
 8296:    __syncthreads();
 8297: 
 8298: 
 8299:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8300:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8301:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8302:       __syncthreads();
 8303:    }
 8304: 
 8305:    // 6) thread 0 atomically folds into the global accumulators
 8306:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8307: 
 8308: 
 8309: }
 8310: 
 8311: 
 8312: __global__ void updateSearchDirection() {
 8313: 
 8314:     NODE(node);
 8315: 
 8316:     // recompute z on-the-fly
 8317:     const double z = node->mR / node->coeffDiag;
 8318:     const double p = node->mP;
 8319: 
 8320:     const double beta = (*rMr_new)/(*rMr_old);
 8321: 
 8322: 
 8323:     // p =z + beta*p
 8324:     node->mP = z + beta*p;
 8325: 
 8326: }
 8327: 
 8328: __global__ void initializeScalars(double *scalars) {
 8329: 
 8330:    // These point to a cupy array in the host code
 8331:    rMr_old = scalars + 0;
 8332:    rMr_new = scalars + 1;
 8333:    pAp     = scalars + 2;
 8334: }
 8335: 
 8336: __global__ void initializePreconditionedResidual(void) {
 8337: 
 8338:     __shared__ double s_rMr[BLOCK_SIZE];  
 8339: 
 8340:     s_rMr[threadIdx.x] = 0.0;
 8341: 
 8342:     NODE_ALL(node, valid);
 8343:     const int tid = threadIdx.x;
 8344:     // For the first iteration:
 8345:     // 1. Initial solution x = 0 (already set)
 8346:     // 2. Initial residual r = b (stored in qel)
 8347:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8348: 
 8349: // XXX we should use the guess solution here    
 8350: 
 8351:     double l_rMr = 0.0;
 8352:     if (valid) {
 8353:       // Set initial residual r = b (from qel)
 8354:       node->mR = node->qel;
 8355: 
 8356:       // Compute z = M^-1 * r (preconditioned residual)
 8357:       const double z = node->mR / node->coeffDiag;
 8358: 
 8359:       // Set initial search direction p = z
 8360:       node->mP = z;
 8361: 
 8362:       // Initialize other variables needed for CG
 8363:       node->mX = 0.0;  // Initial solution
 8364:       node->mAp = 0.0; // Will be computed in first iteration
 8365: 
 8366: 
 8367:       // Computes the first r'Mr (reduction)
 8368:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8369:     }
 8370:     // 4) write into shared-mem
 8371:     s_rMr[tid] = l_rMr;
 8372: 
 8373:     __syncthreads();
 8374: 
 8375: 
 8376:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8377:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8378:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8379:         __syncthreads();
 8380:     }
 8381: 
 8382:     // 6) thread 0 atomically folds into the global accumulators
 8383:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8384: 
 8385:     *rMr_old = 0.0;
 8386:     *pAp = 0.0;
 8387: }
 8388: #endif
 8389: 
 8390: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8391: 
 8392:    ELEM(elem);
 8393: 
 8394:    switch (varCode) {
 8395:       case (int)VarCode::outputCoords:
 8396:          const Point2 coords = elem->outputCoords();
 8397:          res[elem->idx*2    ] = coords.x;
 8398:          res[elem->idx*2 + 1] = coords.y;
 8399:          break;
 8400:    }
 8401: }
