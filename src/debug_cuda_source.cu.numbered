  878: struct Side {
  879: 
  880:    // Geometry information
  881:    int idx;               // Index of the side
  882:    Node *n1, *n2;
  883:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  884: 
  885:    double len;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  886:    Vector2 center;        // Location of side center. 
  887:    double zc[nvrt];       // Side center z-coord at each vertical level
  888: 
  889:    Frame frame;
  890: 
  891:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  892:                           // this is nullptr
  893:    
  894:    int kb;                // Bottom index of the side
  895:    bool isDry;             // True if the side is dry
  896:  
  897:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  898: 
  899:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  900: 
  901:    // Physical information
  902:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  903:    double  w2[nvrt];            // Vertical velocity at each vertical level
  904:    Vector2 btu[nvrt];           // Back-tracked velocity
  905:    Vector2 U;                   // Vertically averaged velocity vector  
  906: 
  907:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) 
  908: 
  909:    Vector2 bcc[nvrt];           // Baroclinic term
  910:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  911: 
  912:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  913:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  914:    Vector2 gradPr;               // Gradient of pressure
  915:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  916: 
  917: 
  918:    double hhat;                 // \breve{H} in notes
  919: 
  920:    double shapiro;
  921: 
  922:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  923: 
  924:    double coriolis;             // Coriolis parameter
  925: 
  926:    // Vegetation parameters
  927:    double veg_c2;
  928:    double veg_beta;
  929: 
  930:    // Bottom drag parameters.
  931:    double chi;
  932:    double chi2;
  933: 
  934:    __inline__ __device__ double x(double t) const;
  935:    __inline__ __device__ double y(double t) const;
  936:    __inline__ __device__ Point2 p_t(double t) const;
  937: 
  938:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  939:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  940:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  941:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  942: 
  943:    __inline__ __device__ Side* neigh(int index) const { 
  944:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  945:       assert(index >= 0 && index < 4); 
  946:       assert(elems[0] != nullptr && elems[1] != nullptr);
  947: 
  948:       const int ielem = index & 1;           // 0 or 1
  949:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  950: 
  951:       const Element* elem = elems[ielem];
  952: 
  953:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  954: 
  955:       return elem->sides[elem->nxq(locSideIdx + iside)];
  956: 
  957:    }
  958: 
  959:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  960: 
  961:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  962: 
  963:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  964:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  965:    __inline__ __device__ int iadv(void) const;
  966: 
  967:    __inline__ __device__ double grav3(void) const;
  968:    
  969:    __inline__ __device__ double eta2(void) const;
  970:    __inline__ __device__ double eta1(void) const;
  971:    __inline__ __device__ double depth(void) const;
  972:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  973:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  974: 
  975:    __inline__ __device__ double dfv(int k) const;
  976: 
  977:    __inline__ __device__ double veg_h(void)  const;
  978:    __inline__ __device__ double veg_nv(void) const;
  979:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  980:    __inline__ __device__ double veg_alpha3D(int k) const;
  981:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  982: 
  983:    __inline__ __device__ double etaMeanBnd(void) const;
  984: 
  985:    __inline__ __device__ double Cd(void) const;
  986: 
  987:    __inline__ __device__ Vector2 tau(void) const;
  988: 
  989:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  990:    
  991: 
  992:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  993:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  994:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  995:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  996:    } 
  997:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  998:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  999:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1000:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1001: 
 1002:    // Get valid starting element (for backtracking)
 1003:    __inline__ __device__ Element* getStartElement() {
 1004:       return elems[0] ? elems[0] : elems[1];
 1005:    }
 1006: 
 1007:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1008:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1009: 
 1010:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1011: 
 1012:       // Dot product of the negative velocity vector with the side normal vector
 1013:       const double dot_prod1 = -dot(u, n);
 1014: 
 1015:       // Vector from side center to element 0 centroid
 1016:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1017: 
 1018:       // Dot product of the vector with the side normal vector
 1019:       const double dot_prod2 = dot(v2, n);
 1020: 
 1021:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1022:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1023: 
 1024:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1025:       else                           return elems[1];
 1026: 
 1027:  
 1028:    }
 1029: 
 1030:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1031:       // Given an element, returns the other element that shares this side
 1032:       return (elems[0] == elem) ? elems[1] : elems[0];
 1033:    }
 1034: 
 1035:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1036:       // Given a node, returns the other node that shares this side
 1037:       return (n1 == node) ? n2 : n1;
 1038:    }
 1039:  
 1040:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1041: 
 1042: 
 1043: 
 1044: 
 1045: };
 1046: 
 1047: 
 1048: // This struct is used to store the boundary information for a node.
 1049: struct NodeBoundary {   
 1050:    BoundarySegment *segment;
 1051:    Node *node;
 1052:    
 1053:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1054:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1055: 
 1056:    bool isLand;
 1057: 
 1058:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1059:    double elbc;   // Elevation boundary condition
 1060:    double eth;    // Elevation time history
 1061: 
 1062:    double eta_mean; // Mean elevation at nodes
 1063: 
 1064:    bool isEssentialBC;
 1065: 
 1066:    Vector2 uth[nvrt];           // "Time history" velocity
 1067: 
 1068:    // Arrays for harmonic constituents (if needed)
 1069:    double  emo[nbfr];  // Elevation amplitude
 1070:    double  efa[nbfr];  // Elevation phase
 1071:    Vector2 umo[nbfr];  // velocity amplitude
 1072:    Vector2 ufa[nbfr];  // velocity phase
 1073: 
 1074: 
 1075:    NodeBoundary(void) {
 1076:       isLand = false;
 1077:    }
 1078:    NodeBoundary(bool _isLand) {
 1079:       isLand = _isLand;
 1080:    }
 1081: 
 1082:    
 1083:    __forceinline__ __device__ int numSidesForAverage() const {
 1084:    // Returns the number of sides that are connected to the node and have the same segment.
 1085:    // This is used to compute the average velocity at the node for open boundary nodes.
 1086:       int res = 0;
 1087:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1088:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1089: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1090:       return res;
 1091:    }
 1092: 
 1093: 
 1094:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1095:       assert(index == 0 || index == 1); 
 1096:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1097:    }
 1098: 
 1099: 
 1100: };
