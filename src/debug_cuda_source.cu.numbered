 1127: // This struct is used to store the boundary information for a node.
 1128: struct NodeBoundary {   
 1129:    int idx;
 1130:    BoundarySegment *segment;
 1131:    Node *node;
 1132:    
 1133:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1134:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1135: 
 1136:    bool isLand;
 1137: 
 1138:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1139:    double elbc;   // Elevation boundary condition
 1140:    double eth;    // Elevation time history
 1141: 
 1142:    double eta_mean; // Mean elevation at nodes
 1143: 
 1144:    bool isEssentialBC;
 1145: 
 1146:    Vector2 uth[nvrt];  // "Time history" velocity
 1147: 
 1148:    // Arrays for harmonic constituents (if needed)
 1149:    double  emo[nbfr];  // Elevation amplitude
 1150:    double  efa[nbfr];  // Elevation phase
 1151:    Vector2 umo[nbfr];  // velocity amplitude
 1152:    Vector2 ufa[nbfr];  // velocity phase
 1153: 
 1154: 
 1155:    NodeBoundary(void) {
 1156:       isLand = false;
 1157:    }
 1158:    NodeBoundary(bool _isLand) {
 1159:       isLand = _isLand;
 1160:    }
 1161: 
 1162:    
 1163:    __forceinline__ __device__ int numSidesForAverage() const {
 1164:    // Returns the number of sides that are connected to the node and have the same segment.
 1165:    // This is used to compute the average velocity at the node for open boundary nodes.
 1166:       int res = 0;
 1167:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1168:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1169: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1170:       return res;
 1171:    }
 1172: 
 1173: 
 1174:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1175:       assert(index == 0 || index == 1); 
 1176:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1177:    }
 1178: 
 1179: 
 1180: };
 1181: 
 1182: struct Node {
 1183: 
 1184:    // Geometry information
 1185:    int idx;        // Index of the node
 1186:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1187:    int numNodes;   // Number of nodes neighbors of this node
 1188: 
 1189:    Element **elements; // Array of pointers to the elements that share this node
 1190:    int numElements;    // Number of elements that share this node
 1191: 
 1192:    int numSides;       // Number of sides that are connected to this node
 1193: 
 1194:    Point2 p;
 1195:    Vector2 u2[nvrt];
 1196:    double  w2[nvrt];
 1197:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1198:    double z[nvrt];
 1199:    double lon, lat;
 1200:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1201:    double depth;
 1202: 
 1203:    int kb;       // Bottom index of the node
 1204: 
 1205:    bool isDry;     // True if the node is dry
 1206: 
 1207:    int iadv;     // Advection flag
 1208: 
 1209:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1210:                           // this is nullptr
 1211: 
 1212:    TempVar tmp; // Temporary variable to store different types of variables
 1213: 
 1214:    // Physical information
 1215:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1216:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1217: 
 1218:    double rho[nvrt];     // Density
 1219:    double dfv[nvrt];     // Vertical viscosity
 1220: 
 1221:    double eta1; // Elevation at nodes at previous timestep
 1222:    double eta2; // Elevation at nodes at current timestep
 1223: 
 1224:    double ETP;  // Earth Tidal Potential
 1225: 
 1226:    double pr;    // Air pressure
 1227:    double grav2; // Gravity 
 1228:    
 1229:    Vector2 dav;  // Depth averaged velocity
 1230: 
 1231:    Vector2 tau; // Wind stress vector
 1232: 
 1233:    // Vegetation parameters
 1234:    double veg_h;
 1235:    double veg_nv;
 1236:    double veg_di;
 1237:    double veg_Cd;
 1238:    double veg_h_unbent;
 1239:    double veg_di_unbent;
 1240:    double veg_nv_unbent;
 1241:    double veg_alpha_vert_mean;
 1242:    double veg_alpha0;
 1243:    double veg_alpha3D[nvrt];
 1244: 
 1245:    // Bottom drag parameters
 1246:    double Cd;       // Bottom drag coefficient   
 1247: 
 1248:    // These three are mutually exclusive
 1249:    union {
 1250:       double rmanning; // Bottom Manning's coefficient
 1251:       double rough;    // Bottom roughness length
 1252:       double drag;     // Bottom drag coefficient
 1253:    };
 1254:    Vector2 tau_bot; // Bottom stress vector
 1255: 
 1256:    double bdef1; // Bottom deformation at previous timestep
 1257:    double bdef2; // Bottom deformation at current timestep
 1258: 
 1259:    double qel; // RHS
 1260:    double coeffDiag; // Diagonal coefficient of the matrix
 1261:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1262: 
 1263:    double mP; // Search direction for conjugate gradient method
 1264:    double mR; // Residual for conjugate gradient method
 1265:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1266:    double mX; // Solution for conjugate gradient method
 1267: 
 1268:    // Meteorological forcing
 1269:    Vector2 u_air;
 1270:    double p_air;
 1271:    double t_air;
 1272:    double q_air;
 1273:    double wind_angle;  // Wind rotation angle
 1274: 
 1275:    __device__ void setWind(Vector2 &u) {
 1276:    // Sets the wind vector taking into account the wind rotation angle
 1277:    
 1278:       const double dir = atan2(-u.x,-u.y);
 1279:       const double speed = length(u);
 1280: 
 1281:       // Calculate new u and v components with added rotation angle
 1282:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1283:    }
 1284: 
 1285: 
 1286:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1287: 
 1288:    __device__ double sigmaTransitionDepth(void) const;
 1289: 
 1290:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1291:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1292:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1293:    
 1294:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1295: 
 1296:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1297: 
 1298:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1299:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1300: 
 1301:    __device__ __forceinline__ void clearMatrixRow(void) {
 1302:       // Clear the matrix row for this node
 1303: 
 1304: 
 1305:       coeffDiag = 0.0;
 1306: 
 1307:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1308: 
 1309:    }
 1310: 
 1311:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1312:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1313:       
 1314:       if (node == this) {
 1315:          coeffDiag += value;
 1316:      
 1317:       } else {
 1318:          // Search (linearly)the index of the node in the array of nodes
 1319:          // XXX: This is not efficient, see if we can improve this
 1320:          int i;
 1321:          for (i = 0; i < numNodes; i++) {
 1322:             if (nodes[i] == node) {
 1323:                break;
 1324:             }
 1325:          }
 1326:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1327:          coeffMatrix[i] += value;
 1328:       }
 1329:    }
 1330: 
 1331: 
 1332:    __device__ __inline__ void updateZCoordData(void);
 1333: 
 1334:    __device__ double compZCoord(int k) const;
 1335: 
 1336:    __device__ void updateKb(void);
 1337: 
 1338:    __device__ __forceinline__ void computeBottomDragCd(void);
 1339: 
 1340: 
 1341: 
 1342: };
