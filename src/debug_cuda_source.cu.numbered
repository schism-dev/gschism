 6449: extern "C"
 6450:                                  
 6451:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 6452:                    double *node_coords, double *wind_rotate_angle, 
 6453:                    int *isdel, int *isidenode, int *isbnd,
 6454:                    int *nond, int *nlnd, int *iond, int *ilnd,
 6455:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 6456:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 6457:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 6458:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 6459:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 6460:                    double *emo, double *efa, 
 6461:                    double *umo, double *ufa, 
 6462:                    double *vmo, double *vfa) {
 6463: 
 6464:     mesh->populateMesh(i34, elnode, elside, node_coords, wind_rotate_angle, 
 6465:                        isdel, isidenode, isbnd,
 6466:                        nond, nlnd, iond, ilnd,
 6467:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 6468:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 6469:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 6470:                        localNodeIndices, localElemIndices, localSideIndices,
 6471:                        localNodePart, localElemPart, localSidePart,
 6472:                        emo, efa, umo, ufa, vmo, vfa);
 6473:   }
