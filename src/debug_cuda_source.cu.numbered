 9468: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9469:    Node *nodes = mesh->localNodeData;
 9470: 
 9471:    *addr = nodes;
 9472:    *sizeNode = sizeof(Node);
 9473: 
 9474:    switch (varCode) {
 9475:       case (int)VarCode::depth:
 9476:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9477:          *sizeType = sizeof(double);
 9478:          break;
 9479:       case (int)VarCode::eta:
 9480:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9481:          *sizeType = sizeof(double);
 9482:          break;
 9483:       case (int)VarCode::x:
 9484:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9485:          *sizeType = sizeof(Vector2);
 9486:          break;
 9487:       case (int)VarCode::z:
 9488:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9489:          *sizeType = sizeof(double);
 9490:          break;
 9491:       case (int)VarCode::kb:
 9492:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9493:          *sizeType = sizeof(int);
 9494:          break;
 9495:       case (int)VarCode::isdry:
 9496:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9497:          *sizeType = sizeof(int);
 9498:          break;         
 9499:       case (int)VarCode::w:
 9500:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9501:          *sizeType = sizeof(double);
 9502:          break;
 9503:       case (int)VarCode::u:
 9504:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9505:          *sizeType = sizeof(Vector2);
 9506:          break;  
 9507:       case (int)VarCode::u_air:
 9508:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 9509:          *sizeType = sizeof(Vector2);
 9510:          break;
 9511:       default:
 9512:          *offset = -1;    
 9513:    }  
 9514:    
 9515: }
