 2548: 
 2549: __inline__ __device__ void backtrackFromPoint(BTPoint &bkPoint, double dt, double dtbk);
 2550: 
 2551: 
 2552: /**
 2553:  * This method performs backtracking from the side center until a time -dt back in time 
 2554:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2555:  * intermediate point.
 2556:  *
 2557:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2558:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2559:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2560:  * remaining time.
 2561:  * 
 2562:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2563:  * 
 2564:  * @param uuint, vvint, wwint: Velocities at the final point
 2565:  * @param jlev: Level at which the backtracking is performed
 2566:  * @param dt, dtbk: Tracking timesteps
 2567:  * @return: backtracked velocity at the final point
 2568:  */
 2569: __inline__ __device__ Vector2 Side::btrack(
 2570:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2571:       double dt,            // Tracking time
 2572:       double dtbk           // Tracking timestep
 2573: ) const {
 2574: 
 2575:    // Start from side center
 2576:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2577: 
 2578:  
 2579:    double time_rm = dt; // Remaining time
 2580: 
 2581:    BTPoint btPoint(x0, BTPoint::BTPointType::btSide, this->elems[0], const_cast<Side*>(this));
 2582: 
 2583:    btPoint.u = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2584: 
 2585: if (btPoint.elem->idx == 56898) printf("6222 btPoint.elem = %p, btPoint.type = %d\n", btPoint.elem, btPoint.type);
 2586:    backtrackFromPoint(btPoint, dt, dtbk);
 2587: if (btPoint.elem->idx == 56898) printf("6333 btPoint.elem = %p, btPoint.type = %d\n", btPoint.elem, btPoint.type);
 2588: 
 2589:    return toVector2(btPoint.u);
 2590: 
 2591: }
