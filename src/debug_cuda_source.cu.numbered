  704:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  705:       // Check if the point (xt,yt) is inside the element
  706:       double shpCoords[4];
  707: 
  708:       bool res = computeShapeCoords(xt, shpCoords, false);
  709: 
  710:       return res;
  711:    }
  712: 
  713:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  714:       // Check if the point (xt,yt) is inside the element.
  715:       // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
  716:       double shpCoords[4];
  717: 
  718:       Vector2 tmp_xt = xt;
  719:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  720: 
  721:       if (fixCoords && res) xt = tmp_xt;
  722: 
  723:       return res;
  724:    }
  725: 
  726:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  727:    {
  728:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  729:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  730:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  731:       
  732:    }
  733: 
  734:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  735: 
  736:    // ------------------------------------------------------------------------------------------------
  737:    // These are functions that work on all nodes of the element.
  738:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  739:    //
  740:    // An example of how to use these functions is:
  741:    //   
  742:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  743:    // 
  744:    // Where L is the level at which the field is to be interpolated. The field can be either
  745:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  746:    // There are different versions of getNodalValues for each of these cases.
  747: 
  748:    template<typename T>
  749:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  750:       // Get the values of the field at the nodes of the element
  751:       res[0] = nodes[0]->*field;
  752:       res[1] = nodes[1]->*field;
  753:       res[2] = nodes[2]->*field;
  754:       if (isQuad()) res[3] = nodes[3]->*field;
  755:       else          res[3] = T();
  756:    }
  757: 
  758:    template<typename T>
  759:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  760:       // Get the values of the field at the nodes of the element
  761:       res[0] = (nodes[0]->*field)[level];
  762:       res[1] = (nodes[1]->*field)[level];
  763:       res[2] = (nodes[2]->*field)[level];
  764:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  765:       else          res[3] = T();
  766:    }    
  767: 
  768:    template<typename T>
  769:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  770:       // Get the values of the func at the nodes of the element
  771:       res[0] = (nodes[0]->*func)(level);
  772:       res[1] = (nodes[1]->*func)(level);
  773:       res[2] = (nodes[2]->*func)(level);
  774:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  775:       else          res[3] = T();  // This is 0.0 or a zero vector
  776: 
  777:    }      
  778: 
  779:    template<typename T>
  780:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  781:       // Get the values of the field at the nodes of the element
  782:       res[0] = sides[0]->*field;
  783:       res[1] = sides[1]->*field;
  784:       res[2] = sides[2]->*field;
  785:       if (isQuad()) res[3] = sides[3]->*field;
  786:       else          res[3] = T();
  787:    }
  788: 
  789:    template<typename T>
  790:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  791:       // Get the values of the field at the nodes of the element
  792:       res[0] = (sides[0]->*field)[level];
  793:       res[1] = (sides[1]->*field)[level];
  794:       res[2] = (sides[2]->*field)[level];
  795:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  796:       else          res[3] = T();
  797:    }    
  798: 
  799:    template<typename T>
  800:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  801:       // Get the values of the func at the nodes of the element
  802:       res[0] = (sides[0]->*func)(level);
  803:       res[1] = (sides[1]->*func)(level);
  804:       res[2] = (sides[2]->*func)(level);
  805:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  806:       else          res[3] = T();  // This is 0.0 or a zero vector
  807: 
  808:    }      
  809: 
  810:    template<typename T>
  811:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  812:       T values[4];
  813:       getNodalValues(level, func, values);
  814: 
  815:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  816:    }
  817: 
  818:    template<typename T>
  819:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  820:       T values[4];
  821:       getNodalValues(field, values);
  822:       
  823:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  824:    }
  825: 
  826: 
  827:    template<typename T>
  828:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  829:       T values[4];
  830:       getNodalValues(level, field, values);
  831: 
  832:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  833:    }
  834: 
  835:    template<typename T>
  836:    __device__ T mean(T Node::* field) const {
  837:       T values[4];
  838:       getNodalValues(field, values);
  839: 
  840:       return (values[0] + values[1] + values[2] + values[3])/i34;
  841:    }
  842: 
  843:    template<typename T>
  844:    __device__ T mean(T Side::* field) const {
  845:       T values[4];
  846:       getSideValues(field, values);
  847:       
  848:       return (values[0] + values[1] + values[2] + values[3])/i34;
  849:    }   
  850: 
  851:    template<typename T>
  852:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  853:       T values[4];
  854:       getNodalValues(level, field, values);
  855: 
  856:       return (values[0] + values[1] + values[2] + values[3])/i34;
  857:    }
  858: 
  859:    template<typename T>
  860:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  861:       T values[4];
  862:       getSideValues(level, field, values);
  863:       
  864:       return (values[0] + values[1] + values[2] + values[3])/i34;
  865:    }   
  866: 
  867:    // __device__ double mean(double (Node::*func)(int) const) const {
  868:    //    double values[4];
  869:    //    getNodalValues(level, func, values);
  870:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  871:    // }
  872:    // ------------------------------------------------------------------------------------------------
  873: 
