 2949: __device__ double Element::intPhiPhiQuad(int i1, int i2) const {
 2950:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2951:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2952:    // The formula for the integral is:
 2953:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2954: 
 2955:    printf("intPhiPhi: TEST\n");
 2956: 
 2957:    const Node *n0 = nodes[0];
 2958:    const Node *n1 = nodes[1];
 2959:    const Node *n2 = nodes[2];
 2960:    const Node *n3 = nodes[3];
 2961: 
 2962:    const Vector2 p0 = n0->p;
 2963:    const Vector2 p1 = n1->p;
 2964:    const Vector2 p2 = n2->p;
 2965:    const Vector2 p3 = n3->p;
 2966: assert(false && "intPhiPhiQuad:CHECK?");
 2967: 
 2968:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2969:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2970:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2971:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2972: 
 2973:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2974: }
 2975:    
 2976: 
 2977: __device__ double Element::intGradPhiGradPhiQuad(int i1, int i2) const {
 2978:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2979:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2980:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2981:    // The formula is also based on the identity:
 2982:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2983:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2984: 
 2985:    printf("intGradPhiGradPhi: TEST\n");   
 2986: assert(false && "intGradPhiGradPhi:Do ICS==2");
 2987:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2988: 
 2989:    const double x0 = nodes[0]->p.x;
 2990:    const double y0 = nodes[0]->p.y;
 2991:    const double x1 = nodes[1]->p.x;
 2992:    const double y1 = nodes[1]->p.y;
 2993:    const double x2 = nodes[2]->p.x;
 2994:    const double y2 = nodes[2]->p.y;
 2995:    const double x3 = nodes[3]->p.x;
 2996:    const double y3 = nodes[3]->p.y;
 2997: 
 2998:    double res = 0.0;
 2999:    
 3000:    // Quadrature points in xi and eta coordinates
 3001:    #pragma unroll
 3002:    for (int i = 0; i < 4; i++) {
 3003:       // For each quadrature point...
 3004: 
 3005:       const Point2 p = GaussPoint(i);
 3006:       const double eta = p.x;
 3007:       const double xi  = p.y;
 3008: 
 3009:       // Jacobian entries at the Gauss point p
 3010:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 3011:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 3012:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 3013:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 3014: 
 3015:       const double detJ = jacobianDet(p);
 3016:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3017: 
 3018:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3019:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 3020:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 3021:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 3022:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 3023: 
 3024:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3025:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3026:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3027:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3028:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3029: 
 3030:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3031:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3032:    }
 3033: 
 3034:    return res;
 3035: }
 3036: 
 3037: 
 3038: /**  Interpolate velocities at a given point (xt,yt,zt)
 3039: 
 3040:    @param xt, yt, zt: coordinates of the point to interpolate
 3041:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3042: 
 3043:    This is done in four steps:
 3044: 
 3045:    1. Find the shape coordinates for the final position in the element.
 3046:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3047:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3048:       z levels at xt, yt at each step.   
 3049:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3050:       horizontally and vertically.
 3051: **/
 3052: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3053:    // Interpolate the velocities at the point xt. 
 3054:    // This function works the same for triangular and quadrilateral elements.
 3055:    double shpCoord[4];
 3056:    Vector3 u_int;
 3057: 
 3058:    assert((origSide == nullptr || ics == 2) && "origSide must be nullptr if ics == 1 and vice versa");
 3059: 
 3060:    // First step is to compute the shape coordinates of (xt,yt)
 3061: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3062:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside, origSide);
 3063: 
 3064:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3065: 
 3066:    // Second step is to find the level that contains zt
 3067:    // Uses a binary search to find the level
 3068:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3069:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3070:    int R = nvrt - 1;
 3071: 
 3072:    // Get the z coordinates at the nodes of the element at the levels L and R
 3073:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3074:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3075:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3076: 
 3077:    double zL = interpolate(shpCoord, zLAtNodes);
 3078:    double zR = interpolate(shpCoord, zRAtNodes);
 3079:    
 3080:    // Interpolates vertically the velocities
 3081:    double wght1, wght2;
 3082:    if (xt.z<=zL) {
 3083:       wght1 = 1.0;
 3084:       wght2 = 0.0;
 3085:       xt.z = zL;
 3086:    }
 3087:    else if (xt.z>=zR) {
 3088:       wght1 = 0.0;
 3089:       wght2 = 1.0;
 3090:       xt.z = zR;
 3091:    }
 3092:    else {
 3093:       // Perform a binary search to find the levels between L and R that contain xt.z
 3094:       while (R - L > 1) {
 3095:          int M = (L + R) / 2.0;
 3096: 
 3097:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3098:          double zM = interpolate(shpCoord, zMAtNodes);
 3099:          if (zM < xt.z) 
 3100:          {
 3101:             L = M;
 3102:             zL = zM;
 3103:          }
 3104:          else 
 3105:          {
 3106:             R = M;
 3107:             zR = zM;
 3108:          }
 3109:       }
 3110:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3111:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3112: 
 3113:       wght2 = (xt.z - zL)/(zR - zL);
 3114:       wght1 = 1.0 - wght2;
 3115: 
 3116:    }
 3117: 
 3118: 
 3119:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3120:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3121:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3122:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3123: 
 3124:    // Neither of the interpolated velocities should be NaN
 3125:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3126: 
 3127:    return u_int;
 3128: 
 3129: }
 3130: 
 3131: 
 3132: 
 3133: 
 3134: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3135: 
 3136:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3137:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3138:    const Node *n1 = side->n1;
 3139:    const Node *n2 = side->n2;
 3140: 
 3141:    bool n1_match = (n1->nodeBnd->segment == segment);
 3142:    bool n2_match = (n2->nodeBnd->segment == segment);
 3143: 
 3144:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3145:    if (n1_match && n2_match) {
 3146:       return 0.5;
 3147:    } else if (n1_match) {
 3148:       return 1.0;
 3149:    } else if (n2_match) {
 3150:       return 0.0;
 3151:    }
 3152: 
 3153:    return 0.0;
 3154: }
 3155: 
 3156: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3157: 
 3158: 
 3159: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3160: 
 3161:    const double w1 = getBoundaryArrayValueWeight();
 3162:    const double w2 = 1.0 - w1;
 3163:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3164:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3165: 
 3166:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3167: }
 3168: 
 3169: 
 3170: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3171:    const double w1 = getBoundaryArrayValueWeight();
 3172:    const double w2 = 1.0 - w1;
 3173:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3174:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3175: 
 3176:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3177: 
 3178: }
 3179: 
 3180: 
 3181: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3182:    // Returns the value of the velocity at the side center
 3183:    const double w1 = getBoundaryArrayValueWeight();
 3184:    const double w2 = 1.0 - w1;
 3185:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3186:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3187: 
 3188:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3189: }
 3190: 
 3191: 
 3192: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3193:    // Returns the value of the normal component of the velocity at the side center
 3194:    const double w1 = getBoundaryArrayValueWeight();
 3195:    const double w2 = 1.0 - w1;
 3196:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3197:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3198: 
 3199:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3200: }
