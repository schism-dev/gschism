 6279: #ifdef DONTCOMPILE
 6280: __device__ void computeVerticalAdvection(void) {
 6281:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6282: 
 6283:    sdbt(1:2,:,:)=0.d0
 6284: 
 6285:    const Side *side = FROM kernel;
 6286: 
 6287:    if(side->isDry) return;
 6288: 
 6289:    // If side is wet...
 6290: 
 6291: 
 6292:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6293:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6294:    double ws[nvrt] = {} // w @ side
 6295:    int icount = 0;
 6296:    for (int j=0; j<2; j++) {
 6297:       const Element *elem = side->elements[j];
 6298:        
 6299:       if(elem != nullptr) {
 6300:          icount++;
 6301:          for (int k=0; k<nvrt; k++) {
 6302:             ws[k] = ws[k] + elem->w[k];
 6303:          }
 6304:       }
 6305:    }  // for j
 6306: 
 6307:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6308:    ws = ws/icount;
 6309: 
 6310:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6311:    // Splines allow for a smooth transition between vertical levels.
 6312:    // Splines have continuity restrictions at the internal knots, but
 6313:    // we have to provide the 1st derivatives at the endpoints.
 6314:    const int kbs = side->kbs; 
 6315:    
 6316:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6317:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6318:    initCubicSpline(kbs, nvrt, side, ws, up)
 6319: 
 6320:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6321:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6322:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6323: 
 6324:    // Total advection (average onto side)
 6325:    const Node *node1 = side->nodes[0];
 6326:    const Node *node2 = side->nodes[1];
 6327:    for (int k=kbs(i); k<nvrt; k++) {
 6328: 
 6329:       if constexpr(ics==1) {
 6330:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6331:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6332:       } else {
 6333:          // XXX IMPLEMENT THIS
 6334:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6335:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6336:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6337:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6338:       }  // if ics
 6339: 
 6340: 
 6341:    }
 6342: }
 6343: #endif
 6344: 
 6345: 
 6346: extern "C" {
 6347:    __global__ void computeElemAverageGhat(void) {
 6348:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6349: 
 6350:       ELEM(elem);
 6351:       
 6352:       elem->ghat1= {0.0, 0.0};  
 6353: 
 6354:       if constexpr(ihydraulics != 0) {
 6355:          if (nhtblocks > 0 && elem->isblock) return;
 6356:       }
 6357: 
 6358: 
 6359: 
 6360:       
 6361:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6362:       // tidal potential, horizontal diffusion, and baroclinic etc
 6363:       // Remember to update both fb and F 
 6364:       // If ics=2, ghat1 are in eframe (ll)
 6365:       // cff1-3: coefficients for 2D/3D
 6366:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6367:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6368:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6369: 
 6370:       if (elem->isDry) return;
 6371: 
 6372:       double av_cff1 = 0.0;  // av. for cff1
 6373:       double av_cff2 = 0.0;  // av. for cff2
 6374:       double av_cff3 = 0.0;  // av. for cff3
 6375:       double av_df = 0.0;  // av. for H^\alpha / H
 6376:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6377:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6378: 
 6379:       const int i34 = elem->i34;
 6380:       const int kb = elem->kb;
 6381: 
 6382:       for (int j=0; j<i34; j++) {
 6383:          // For each node and side in the element...
 6384: 
 6385:          const Node *node = elem->nodes[j];
 6386:          const Side *side = elem->sides[j];
 6387: 
 6388:          const double chi      = side->chi;
 6389:          const double veg_c2   = side->veg_c2;
 6390:          const double veg_beta = side->veg_beta;
 6391:          const double veg_h    = side->veg_h();
 6392:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6393: 
 6394:          // Node - const in elem
 6395:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6396:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6397: 
 6398:          if (elem->depth >= tip_dp) {
 6399:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6400:          }
 6401: 
 6402:          
 6403:          const double htot  = side->htot2();        // Total depth at the side
 6404:          const double zctr2 = side->zTopCanopy();  
 6405: 
 6406:          double cff1; 
 6407:          double cff2; 
 6408:          double cff3;   
 6409:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6410:          // coefficients applied to 2D/3D case 
 6411:             cff1 = side->hhat/htot;
 6412:             cff2 = 0.0;
 6413:             cff3 = 0.0;
 6414:          } else { //3D
 6415:             //Init for no-veg case
 6416:             cff1 = 1.0;
 6417:             cff2 = 1.0;
 6418:             cff3 = 0.0;
 6419: 
 6420:             if constexpr(iveg != 0) {
 6421:                // Computes coefficients used with vegetation terms G1, G2
 6422:                // cff1, cff3 are used for the first two terms in G1, G2:
 6423:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6424:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6425:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6426:                if(veg_h < 0.99*htot) { // submergent vegetation
 6427:                   cff1=1;
 6428:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6429:                   cff3 = veg_c;
 6430: 
 6431:                } else { // emergent vegetation
 6432:                   cff1 = 1.0/(1.0 + veg_c2);
 6433:                   cff2 = cff1;
 6434:                   cff3 = 0.0;
 6435: 
 6436:                }
 6437:             } // if iveg
 6438:          } //  2D/3D
 6439: 
 6440:          av_cff1 += cff1/i34;
 6441:          av_cff2 += cff2/i34;
 6442:          av_cff3 += cff3/i34;
 6443:          av_cff2_chi += cff2*chi/i34;
 6444:          av_cff3_chi += cff3*chi/i34;
 6445:          av_df += min(htot, veg_h)/(htot*i34);
 6446: 
 6447: 
 6448:          // btrack values: U^\star, U^{\star\alpha}
 6449:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6450:          Vector2 Ustar       = {0.0, 0.0}; 
 6451:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6452: 
 6453:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6454:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6455:          } else { //3D
 6456:             for (int k = side->kb + 1; k < nvrt; k++) {
 6457:             
 6458:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6459:                Ustar += w2;
 6460: 
 6461:                if constexpr(iveg != 0) {
 6462:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6463:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6464:                        Ustar_alpha += zrat*w2; // XXXX
 6465:                    }
 6466:                }  // if iveg
 6467:             }  // for k
 6468:          }  //2D/3D
 6469: 
 6470:          // If needed, project the side velocities to the element frame
 6471:          if constexpr(ics==2) {
 6472:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 6473:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 6474:          }
 6475:          
 6476: 
 6477:          // Add btrack & surface stress terms to \breve{G} first
 6478:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6479: 
 6480: 
 6481: 
 6482:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 6483:          Vector2 tau    = side->tau();  
 6484:          Vector2 ubstar = side->btu[side->kb + 1];  
 6485: 
 6486:          // If needed, project tau and ubstar to the element frame
 6487:          if constexpr(ics==2) {
 6488:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 6489:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 6490:          }
 6491: 
 6492:          // Term for surface and bottom stress
 6493:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6494: 
 6495: 
 6496:          // All terms in F,F^\alpha,f_b except baroclinic
 6497:          // F, f_b: all explicit terms excluding vegetation 
 6498:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6499:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6500:          const double coriolis = side->coriolis;
 6501:          Vector2 F  =  coriolis*side->U;  // F_x
 6502:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6503:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6504: 
 6505:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6506:             
 6507:             for (int k = side->kb; k < nvrt; k++) {
 6508:                if (zctr2 > side->zc[k-1]) {
 6509:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6510:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6511:                    Fa +=  coriolis*w2*zrat;
 6512:                } // if zctr2
 6513:             } // k
 6514:          } // iveg
 6515: 
 6516:          // Integrate horizontal viscosity force vertically
 6517:          for (int k=side->kb + 1; k<nvrt; k++) {
 6518:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6519: 
 6520:             F += levelHorVisc;
 6521: 
 6522:             // Vegetation term
 6523:             if constexpr(iveg!=0) {
 6524:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6525:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6526:                   Fa += levelHorVisc*zrat;
 6527:                } 
 6528:             } // if iveg
 6529:          } // for k
 6530: 
 6531:          // Get nu*grad(U) at the side's bottom level
 6532:          Vector2 nuGradU = side->nuGradU[side->kb];
 6533: 
 6534:          fb += nuGradU;
 6535: 
 6536:          // If needed, project vectorsF, fb and Fa to the element frame
 6537:          if constexpr(ics==2) {
 6538:             F    = side->frame.projHorVec(F,    elem->frame);
 6539:             fb   = side->frame.projHorVec(fb,   elem->frame);
 6540:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 6541:          } // if ics
 6542: 
 6543:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6544:       } // for j (nodes and sides)
 6545: 
 6546:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6547:          
 6548:       // Finish off terms in F, F^\alpha and f_b
 6549:       const double grav3 = elem->mean(&Node::grav2);
 6550:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6551: 
 6552: 
 6553:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6554:       for (int j=1; j<i34; j++) { 
 6555:          // For each side in the element...
 6556:          const Side *side = elem->sides[j];
 6557:          const double chi = side->chi;
 6558: 
 6559:          const double htot = side->htot2();
 6560:          const double veg_h = side->veg_h();
 6561:          const Vector2 F  = htot*fb;
 6562:          const Vector2 Fa = min(htot, veg_h)*fb;
 6563: 
 6564:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6565:       } // for j
 6566: 
 6567:       //botf1 etc are already in elem frame
 6568:       elem->ghat1 += tmp/i34;
 6569: 
 6570:       // Baroclinic force
 6571:       if constexpr(ibc==0) {
 6572:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6573: 
 6574:          Vector2 Fa = {0.0, 0.0};
 6575:          Vector2 intGradRho = {0.0, 0.0};
 6576:          
 6577:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6578:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6579:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6580: 
 6581:             // \in F [m^2/s/s]
 6582:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6583:          }
 6584: 
 6585:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6586:          const Vector2 F = av_df*Fa; //approx
 6587:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6588: 
 6589:       } // if ibc
 6590: 
 6591: 
 6592: 
 6593:    }
 6594: 
 6595: } // extern "C"
 6596: 
 6597: 
 6598: 
 6599: #ifdef DONTCOMPILE
 6600: __global__ void checkMassConservation(Tracers* sumtr) {
 6601: 
 6602:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6603: 
 6604:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6605: 
 6606:    Element *elem = &(mesh->localElemData[i]);
 6607: 
 6608:    // Skip dry elements
 6609:    if (elem->isDry) return;
 6610: 
 6611:    // Local sum array for this thread
 6612:    double localSum[N_TRACERS] = {0.0};
 6613: 
 6614:    // Sum over vertical levels for this element
 6615:    const int kbe = elem->kbe;
 6616:    const double area = elem->area;
 6617: 
 6618:    for (int k = kbe; k < nvrt; k++) {
 6619:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6620:       
 6621:       // Accumulate tracer mass
 6622:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6623:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6624:       }
 6625:    }
 6626: 
 6627:    //  This function returns per element sums. A reduction must be done on the host side.
 6628: }
 6629: 
 6630: 
 6631: __global__ void transport(void) {
 6632: 
 6633:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6634: 
 6635:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6636: 
 6637:    Element *elem = &(mesh->localElemData[ie]);
 6638: 
 6639:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6640: 
 6641:                for (int m=0; m<ntr; m++) {
 6642:                   for (int k=kbe(ie); k<nvrt; k++) {
 6643:                      // Calculate each polynomial's weight 
 6644:                      wm=0.d0; sum1=0.d0; 
 6645:                      wm1=0.d0; wm2=0.d0; 
 6646:                      for (int i=0; i<elem->nweno2; i++) {
 6647:                   
 6648:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6649:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6650:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6651:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6652:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6653:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6654:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6655:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6656:                      // -----------------Hu and Shu (1999)'s method----------------
 6657:                      b4=b1+b2+b3
 6658: 
 6659: //Error: add PRODUCTION CPP
 6660: #ifdef DEBUG
 6661:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6662:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6663:                     call parallel_abort(errmsg)
 6664:                   }
 6665: #endif
 6666: 
 6667:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6668:                   // !----test-------------- 
 6669:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6670:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6671:                   // !wm(i)=wm1(i)*wm2(i)
 6672:                   // !---------------------- 
 6673:                   sum1=sum1+wm(i)
 6674:                 } // end for i
 6675: 
 6676:                 wm=wm/sum1
 6677: 
 6678:                 for (int j=0; j<elem->i34; j++) {
 6679: 
 6680:                   const Side *side  = elem->sides[j];
 6681:                   const Node *node1 = side->n1;
 6682:                   const Node *node2 = side->n2;
 6683: 
 6684:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6685:                      trsd=0.d0
 6686:                      for (int kk=0; kk<nquad; kk++) {
 6687:                         for (int i=0; i<elem->nweno2; i++) {
 6688:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6689:                         } // end for i   
 6690:                      } // end for kk
 6691:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6692:                   } // outward flux
 6693:                } // end for j=1,i34(ie) ! side
 6694:             }
 6695:          }
 6696:               
 6697: 
 6698: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6699: //             //   calculate each polynomial's weight 
 6700: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6701: //                 wm=0.d0; sum1=0.d0
 6702: //                 do i=1,nweno1(ie) !for each polynomial
 6703: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6704: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6705: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6706: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6707: //                   wm(i)=b2
 6708: //                   sum1=sum1+b2
 6709: //                   !wm(i)=1.d0
 6710: //                   !sum1=sum1+1.d0
 6711: 
 6712: // // Error: PRODUCTION
 6713: // #ifdef DEBUG
 6714: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6715: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6716: //                     call parallel_abort(errmsg)
 6717: //                   endif
 6718: // #endif
 6719: 
 6720: //                 enddo !i
 6721: //                 wm=wm/sum1 !final weight
 6722: 
 6723:                 for (int j=0; j<elem->i34; j++) { // side
 6724:                   const Side *side = elem->sides[j];
 6725:                   const Node *node1 = side->n1;
 6726:                   const Node *node2 = side->n2;
 6727: 
 6728:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6729:                     trsd=0.d0
 6730:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6731:                       for (int i=0; i<elem->nweno1; i++) {
 6732:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6733:                       }
 6734:                     enddo //kk
 6735:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6736:                   } // outward flux
 6737:                 } // end for j=1,i34(ie) ! side
 6738:               } // end for k; ntr 
 6739: 
 6740:             else !simple upwind method
 6741:               do j=1,i34(ie)
 6742:                 jsj=elside(j,ie)
 6743:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6744:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6745:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6746:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6747:                   endif
 6748:                 enddo  !vertical layers
 6749:               enddo !j=1,i34(ie) ! side
 6750:             endif !order of accuracy
 6751: 
 6752:          //  enddo !ie
 6753: // !$OMP     end do
 6754: 
