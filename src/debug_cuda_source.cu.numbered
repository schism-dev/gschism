 4182: 
 4183:    __global__ void scaleGravity(double loadtide_coef) {
 4184: 
 4185: 
 4186:       NODE(node);
 4187: 
 4188:       // SAL option: scale gravity
 4189:       if constexpr(iloadtide==2) {  // simple const
 4190:          node->grav2 = grav*(1.0 - loadtide_coef);
 4191: 
 4192:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4193:         
 4194:           const double depth = max(node->depth, 0.0);
 4195:           const double tmp1 = sqrt(depth);
 4196:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4197:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4198:                              2.6969e-13*depth*depth*depth*tmp1;
 4199:           
 4200:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4201:           
 4202: 
 4203: 
 4204:           node->grav2 = grav*(1.0 - beta_bar);
 4205: 
 4206:       } else {  // iloadtide=0,1
 4207:           node->grav2 = grav;
 4208: 
 4209:       }
 4210: 
 4211:    }
 4212: 
