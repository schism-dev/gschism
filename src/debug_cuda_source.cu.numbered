 3477: 
 3478: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3479:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3480:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3481:    // 
 3482:    // This kernel is called for all nodes.
 3483: 
 3484: 
 3485:    NODE(node1);
 3486: 
 3487: // if (node1->numElements > 8) printf("111 idx = %d, node1->numElements = %d\n", node1->idx, node1->numElements);
 3488: 
 3489:    node1->clearMatrixRow();
 3490:    node1->qel = 0.0;
 3491: 
 3492:    // THIS IS FOR STRUCTURES XXX
 3493:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3494: 
 3495:    
 3496:    for (int j=0; j<node1->numElements; j++) {
 3497:       // For each element connected to the node...
 3498: 
 3499:       Element *elem = node1->elements[j];
 3500: 
 3501: 
 3502:       // Compute the average gravity
 3503:       const double grav3 = elem->mean(&Node::grav2);
 3504: 
 3505:       // Look at the documentation for the description of the terms in the following integrals
 3506: 
 3507:       // Integral I_1 
 3508:       // \bar{\breve{H}} 
 3509:       const double hhatb = elem->mean(&Side::hhat);        
 3510: 
 3511:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3512: 
 3513:       const int id1 = elem->nodeLocalIdx(node1); 
 3514:       const double area = elem->area;
 3515: 
 3516:       if (elem->isTri()) {
 3517: 
 3518:          // To clarify the notation in this section: 
 3519:          //   i stands for the node under consideration (node1)
 3520:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3521:          const int id2 = elem->nxq(1 + id1);
 3522:          const int id3 = elem->nxq(2 + id1);
 3523:          Node *node2 = elem->nodes[id2];
 3524:          Node *node3 = elem->nodes[id3];
 3525: 
 3526:          const Point2 x1 = node1->p;
 3527:          const Point2 x2 = node2->p;
 3528:          const Point2 x3 = node3->p;
 3529: 
 3530:          // integral of phi_i*phi_j
 3531:          const double ipp_ii = (1.0/6.0 )*area;
 3532:          const double ipp_ij = (1.0/12.0)*area;
 3533:          const double ipp_ik = (1.0/12.0)*area;
 3534: 
 3535:          // integral of [(grad phi_i) * (grad phi_j)]
 3536:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3537:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3538:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3539: 
 3540:          // Computes the different components of integral I_1 of each node with respect to node i.
 3541:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3542:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3543:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3544: 
 3545:          node1->addToSparseMatrix(node1, I1_ii);
 3546:          node1->addToSparseMatrix(node2, I1_ij); 
 3547:          node1->addToSparseMatrix(node3, I1_ik);
 3548: 
 3549:       }
 3550:       else { // Quad
 3551:          // XXX IMPLEMENT THIS
 3552:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3553: 
 3554:          // To clarify the notation in this section: 
 3555:          //   i stands for the node under consideration (node1)
 3556:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3557:          const int id2 = elem->nxq(1 + id1);
 3558:          const int id3 = elem->nxq(2 + id1);
 3559:          const int id4 = elem->nxq(3 + id1);
 3560:          Node *node2 = elem->nodes[id2];
 3561:          Node *node3 = elem->nodes[id3];
 3562:          Node *node4 = elem->nodes[id4];         
 3563: 
 3564:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3565:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3566:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3567:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3568:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3569: 
 3570:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3571:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3572:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3573:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3574:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3575: 
 3576:          // Computes the different components of integral I_1 of each node with respect to node i.
 3577:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3578:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3579:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3580:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3581: 
 3582:          node1->addToSparseMatrix(node1, I1_ii);
 3583:          node1->addToSparseMatrix(node2, I1_ij); 
 3584:          node1->addToSparseMatrix(node3, I1_ik);
 3585:          node1->addToSparseMatrix(node4, I1_il);
 3586:   
 3587: 
 3588: 
 3589:       
 3590:       } 
 3591: 
 3592:  
 3593:       // Integral I_4
 3594:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3595:       // Where
 3596:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3597: 
 3598:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3599:       // of U over the element.
 3600:       Vector2 Umean = {0.0, 0.0};
 3601:       for (int m=0; m<elem->i34; m++) {      
 3602:          const Side *side = elem->sides[m];
 3603: 
 3604:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3605:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3606:       }
 3607:       Umean = Umean/elem->i34;
 3608: 
 3609:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3610: 
 3611:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3612:       const double I_4_1 = dot(gradPhi_1, Umean);
 3613: 
 3614:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3615:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3616:      
 3617:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3618: 
 3619:       // Additional terms 
 3620:       double vnorm = 0.0;
 3621:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3622:          Vector3 ubed;
 3623:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3624: 
 3625:          Vector3 gradP = {0.0, 0.0, 1.0};
 3626:          for (int m=0; m < elem->i34; m++) {
 3627:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3628:            gradP += toVector3(gradP_2D, 0.0);
 3629:          }   
 3630:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3631:       } // imm==2
 3632: 
 3633:       if (elem->isTri()) {
 3634:          for (int l=0; l<3; l++) {
 3635:             double fac;
 3636: 
 3637:             Node *node = elem->nodes[l];
 3638: 
 3639:             fac = (node == node1) ? 2.0 : 1.0;
 3640:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3641:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3642:            
 3643:          }
 3644: 
 3645: 
 3646:          if (!elem->isDry) {
 3647:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3648: 
 3649:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3650: 
 3651:          }
 3652: 
 3653:       } // isTri
 3654:       else { // isQuad
 3655:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3656:          // for (int l=0; l<4; l++) {
 3657:          //   const Node *node = elem->nodes[l];
 3658: 
 3659:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3660:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3661: 
 3662:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3663:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3664:          // }
 3665: 
 3666:       } // isQuad
 3667: 
 3668: 
 3669:      node1->qel += (dt/elem->i34)*elem->vsource;
 3670:       
 3671: 
 3672:    } // for all elements connected to the node
 3673:    
 3674: 
 3675:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3676:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3677:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3678:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3679:       // If it is an open boundary node...
 3680: 
 3681:       // At least one open bnd side, maybe two
 3682:       for (int l=0; l<2; l++) { 
 3683: 
 3684:          // Gets each of the sides sharing the node. 
 3685:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3686: 
 3687:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3688:          
 3689: 
 3690:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3691:          if (sideBnd != nullptr) {
 3692:             // If the side is on a boundary...
 3693: 
 3694:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3695: 
 3696:             // Get the boundary segment
 3697:             const BoundarySegment *sideSegment = sideBnd->segment;
 3698:             const Side *side = sideBnd->side;
 3699: 
 3700:             // Integral I_3
 3701:             if (sideSegment->ifltype != 0) {
 3702:             // Natural or Flather b.c.
 3703: 
 3704:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3705:                // especially for Flather b.c.
 3706:                double ri3 = 0.0;
 3707:                if (!side->isDry) {
 3708:                   // If the side is not dry
 3709:                   
 3710:                   // Computes the side flux of (uth, vth)
 3711:                   double Vn = 0.0;
 3712:                   for (int k = side->kb; k<nvrt-1; k++) {
 3713:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3714:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3715: 
 3716:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3717:                   }
 3718: 
 3719:                   ri3 = 0.5*side->len*Vn;
 3720:                }
 3721: 
 3722:                if (sideSegment->ifltype == -1) { // Flather 1
 3723: 
 3724:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3725:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3726: 
 3727:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3728:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3729:                   
 3730:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3731:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3732: 
 3733:                } 
 3734:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3735:                   // Reset ri3
 3736:                   ri3 = 0.0;
 3737: 
 3738:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3739: 
 3740:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3741: 
 3742:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3743:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3744: 
 3745:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3746:                   node1->addToSparseMatrix(node1, con0*2.0);
 3747:                   node1->addToSparseMatrix(node2, con0);
 3748: 
 3749:                } // if Flather or Discharge
 3750: 
 3751: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3752:                node1->qel -= thetai*dt*ri3;
 3753: 
 3754: 
 3755:             } // I_3
 3756:           
 3757: 
 3758:             // Integral I_5
 3759:             if(!side->isDry) {
 3760: 
 3761:                const double Unbar = dot(side->U, side->n);
 3762:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3763: 
 3764:             } // I_5
 3765: 
 3766:          } // if is boundary side
 3767: 
 3768:       } // for l
 3769: 
 3770:    } // if isbnd
 3771: 
 3772: 
 3773: }
 3774: 
 3775: 
 3776: extern "C" {
 3777:    __global__ void setupCGSolver(double* data, int* indices, int* indptr, double* b) {
 3778:       int off = 0;
 3779:       for (int i = 0; i < mesh->np; i++) {
 3780: 
 3781:          const Node *node = mesh->localNodeData + i;
 3782:          indptr[i] = off;
 3783: 
 3784:          // Diagonal first
 3785:          data[off]    = node->coeffDiag;
 3786:          indices[off] = i;
 3787:          ++off;
 3788:          // printf("i = %d, off = %d, node->nodes[i] = %p\n", i, off, node->nodes[i]);
 3789:          // Off-diagonals
 3790:          for (int k = 0; k < node->numNodes; ++k) {
 3791:             const Node* nb = node->nodes[k];
 3792:             // printf("i = %d, k = %d, nb = %p\n", i, k, nb);
 3793:             // Map pointer -> column index by pointer arithmetic
 3794:             int j = nb->idx;
 3795:             // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else ...)
 3796:             data[off]    = node->coeffMatrix[k];
 3797:             indices[off] = j;
 3798:             ++off;
 3799:             // printf("i = %d, j = %d, off = %d, data[off] = %f\n", i, j, off, data[off]);
 3800:          }
 3801: 
 3802:          // RHS
 3803:          b[i] = node->qel;
 3804:       }
 3805: 
 3806:       indptr[mesh->np] = off;
 3807:    }
 3808:    
 3809: }
 3810: 
 3811: extern "C" {
 3812:    __global__ void setupCGSolver2(double* diag, double* data, int* indices, int* indptr, double* b) {
 3813:       NODE(node);
 3814:       const int idx = node->idx;
 3815:       // Computes the index in the nzz array
 3816: 
 3817:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3818: 
 3819:       indptr[idx] = nzzIdx;
 3820:       data[nzzIdx]    = node->coeffDiag;
 3821:       indices[nzzIdx] = idx;
 3822: 
 3823:       for (int k = 0; k < node->numNodes; ++k) {
 3824:          const Node* nb = node->nodes[k];
 3825: 
 3826:          int j = nb->idx;
 3827:          // (optionally: if (j == i) data[diag_off] += nd.coeffMatrix[k]; else ...)
 3828:          data[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3829:          indices[nzzIdx + k + 1] = j;
 3830:       }
 3831: 
 3832:       diag[idx] = 1.0/node->coeffDiag;
 3833:       b[idx] = node->qel;
 3834:    }
 3835: }
