 3380: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3381:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3382:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3383:                 int *isdel, int *isidenode, int *isbnd,
 3384:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3385:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3386:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3387:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3388:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3389:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3390:                 double *drag, double *roughness,
 3391:                 double *emo, double *efa, 
 3392:                 double *umo, double *ufa, 
 3393:                 double *vmo, double *vfa) {
 3394: 
 3395:    // printf("Populating mesh for partition %d\n", partNum);
 3396: 
 3397:    // XXXXXX THIS function does almost nothing. 
 3398: 
 3399:    nbs = *sharedIdxSideBoundary + 1;
 3400:    nbp = *sharedIdxNodeBoundary + 1;
 3401: 
 3402: 
 3403: }
