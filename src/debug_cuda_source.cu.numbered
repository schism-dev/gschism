 2336: 
 2337: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2338: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2339: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2340: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2341:    Vector2 grad = {0.0, 0.0};
 2342:    int count = 0;
 2343: 
 2344:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2345: 
 2346:    // First element
 2347:    if (elems[0] != nullptr && condition(elems[0])) {
 2348:       grad += elems[0]->grad2(field);
 2349:       count++;
 2350:    }
 2351: 
 2352:    // Second element
 2353:    if (elems[1] != nullptr && condition(elems[1])) {
 2354:       grad += elems[1]->grad2(field);
 2355:       count++;
 2356:    }
 2357: 
 2358:    if (count > 0) {
 2359:       grad = grad/count;
 2360:    }
 2361:    
 2362:    return grad;
 2363: }
