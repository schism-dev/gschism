 5166: 
 5167:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5168: 
 5169:       SIDE(side);
 5170: 
 5171:       side->U = {0.0, 0.0}; 
 5172:          
 5173:       if(side->isDry) return;
 5174: 
 5175:       // Vertically integrated velocity U (in ll if ics=2)
 5176:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5177:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5178:          side->U += side->Dz(k + 1)*uc;  
 5179:       }
 5180: 
 5181:    }
 5182: 
 5183:    __global__ void computeBottomDragVegetation(void) {
 5184:       // UNFINISHED. CHECK THIS:
 5185:       // How many kernels are needed? Why so many for loops?
 5186:       // Is the loop on sides needed?
 5187: 
 5188:       NODE(node);
 5189: 
 5190: 
 5191:       const int    kb      = node->kb;
 5192:       const double htot    = node->htot2(); 
 5193:       
 5194:       if (node->isDry) {
 5195:          // Default values for dry nodes
 5196:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5197:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5198: 
 5199:          return;
 5200:        
 5201:       }
 5202: 
 5203:       // Computes bottom drag Cd based on the selected nchi
 5204:       node->computeBottomDragCd();
 5205:       
 5206: 
 5207: 
 5208:       //   Bottom stress in m^2/s^2
 5209:       if (node->rho[kb + 1] >= -98.0)
 5210:       {
 5211:          const double mag_u = length(node->u2[kb + 1]);
 5212:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5213: 
 5214:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5215:          // !sediment erosion: this part needs more documentation
 5216:       }
 5217:     
 5218: 
 5219: 
 5220:       // Compute vegetation parameters
 5221:       //--------------------------------
 5222: 
 5223:       // SAV constants
 5224:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5225:       constexpr double veg_cfpsi = 0.16;
 5226: 
 5227:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5228:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5229: 
 5230:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5231:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5232:          int kbin = 0; // bin index
 5233:          for (int k = kb; k < nvrt; k++) {
 5234:             // Computes node height above the bottom level
 5235:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5236:             assert(false && "Vertical variation of vegetation not implemented");
 5237: 
 5238:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5239:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5240:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5241:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5242:             // } else {
 5243:             //    // Find the bin at which the current vertical level is
 5244:             //    while (kbin<nbins_veg_vert) {
 5245:             //       const double zn = node->z[kbin];
 5246:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5247:             //          break;
 5248:             //       } // if
 5249:             //       kbin++;
 5250:             //    } // while
 5251:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5252: 
 5253:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5254:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5255:                
 5256:             //    // Linear interpolation of the vegetation parameters
 5257:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5258:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5259:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5260:             // } // if rl10
 5261: 
 5262:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5263: 
 5264:          } // for k
 5265: 
 5266: 
 5267:       } else { // Ganthy (iveg==2)
 5268:       //  Modify canopy height, diameter, and density
 5269: 
 5270:          // Make sure there is vegetation on this node
 5271:          if (node->veg_h_unbent > 0.0) {
 5272:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5273: 
 5274:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5275:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5276:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5277: 
 5278:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5279:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5280:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5281:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5282:          } // if veg_h_unbent
 5283: 
 5284:          for (int k = 0; k < nvrt; k++) {
 5285:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5286:          } // for k
 5287:       
 5288: 
 5289:       } // if iveg
 5290:      
 5291: 
 5292:       // Compute vertical mean of veg_alpha3D
 5293:       if (iveg != 0) {
 5294:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5295:          double sum1=0.0;
 5296:          double sum2=0.0;
 5297:          // Integrate over each level under the canopy...
 5298:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5299:             const double Dz = node->Dz(k);
 5300: 
 5301:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5302:             sum2 += Dz;
 5303: 
 5304:          } // for k
 5305:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5306:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5307: 
 5308:       } // if iveg
 5309: 
 5310:    }
 5311: 
 5312:    __global__ void computeVegetationAndDragParameters(void) {
 5313:       // Computes the vegetation and drag model parameters:
 5314:       // chi, \tilde\chi, beta, \breve{H}
 5315:       
 5316:       SIDE(side);
 5317: 
 5318:       side->hhat = 0.0;
 5319:       side->chi2 = 0.0;
 5320:       side->chi = 0.0;
 5321:       side->veg_c2 = 0.0;
 5322:       side->veg_beta = 0.0;
 5323: 
 5324:       if (side->isDry) return;
 5325: 
 5326:       const double htot = side->htot2();
 5327:       const int    kb   = side->kb;
 5328: 
 5329:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5330: 
 5331:       const double veg_h     = side->veg_h();
 5332:       const double veg_nv    = side->veg_nv();
 5333:       const double veg_c     = side->veg_c();
 5334:       const double veg_beta  = side->veg_beta;
 5335:       const double veg_alpha = side->veg_alpha_vert_mean();
 5336: 
 5337:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5338:       // Velocity magnitude at the bottom level
 5339:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5340:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5341:       side->chi2 = side->Cd()*vmag1;
 5342:       side->chi  = side->chi2;
 5343:       if constexpr(iveg != 0) {
 5344:          const Node *n1 = side->n1;
 5345:          const Node *n2 = side->n2;
 5346:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5347:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5348:       }
 5349: 
 5350:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5351: 
 5352:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5353:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5354:       double magUa = 0.0;
 5355:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5356:          // 3D wet side with veg...
 5357: 
 5358:          double magUa = 0.0;
 5359:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5360:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5361: 
 5362:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5363:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5364:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5365: 
 5366:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5367:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5368: 
 5369:                // Velocity magnitude at the bottom (l) of the level
 5370:                const double ul = length(side->u2[k]);
 5371: 
 5372:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5373:                magUa += Dz*0.5*(uh + ul);
 5374: 
 5375:             } // if HasVegetation
 5376:          } // for k
 5377:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5378: 
 5379:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5380:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5381:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5382:             const double zCpy = side->zTopCanopy();
 5383:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5384:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5385:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5386:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5387:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5388:          } // if isSubmerged
 5389:       } // if iveg   
 5390: 
 5391:       // Computes the friction modified depth, \breve{H} in notes
 5392:       if (side->is2D()) { // 2D
 5393: 
 5394:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5395:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5396: 
 5397:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5398: 
 5399:          side->hhat = htot*htot/fricH; 
 5400: 
 5401:       } else { // 3D
 5402:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5403: 
 5404:          if constexpr(iveg != 0) {
 5405:             
 5406:             if (side->isSubmerged()) { 
 5407:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5408:                side->hhat -= veg_c*Hhat_alpha;
 5409: 
 5410:             } else { // Emergent
 5411:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5412:             }
 5413:          } // if iveg
 5414: 
 5415:          // Enforce positivity for 3D model
 5416:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5417:       } // if 3D
 5418: 
 5419:    }
 5420: 
 5421: 
 5422: 
 5423:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5424:    // Computes the density gradient between two elements, e1 and e2.
 5425:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5426:    // zero in the direction normal to the side. 
 5427:    // 
 5428:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5429:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5430:    //
 5431:    // Input:
 5432:    //    e1: Element
 5433:    //    e2: Neighbor element (or nullptr if boundary)
 5434:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5435:    //    k: Index of the half-level at which the density is interpolated
 5436:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5437:    // 
 5438:    // Output:
 5439:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5440:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5441: 
 5442:       if (e2 == nullptr || e2->isDry) {
 5443:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5444: 
 5445:          Side *side = e1->sides[j];
 5446:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5447:                  
 5448:          if constexpr(ics == 1) {
 5449:             vec = side->n; // Normal vector to the side
 5450:          } else {
 5451:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5452:             // IMPLEMENT THIS XXXXXX
 5453:             // !replace with xel, yel?
 5454:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5455:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5456:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5457:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5458:          } //ics
 5459:                    
 5460:          diffRho = 0.0;
 5461: 
 5462:       } else { //internal and wet
 5463:          if constexpr(ics==1) {
 5464:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5465: 
 5466:             // Vector from e1 to e2
 5467:             vec = e2->center - e1->center;
 5468: 
 5469:          } else { 
 5470:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5471:             // IMPLEMENT THIS XXXXXX
 5472:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5473:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5474:             //                   alow(j)=xctr2
 5475:             //                   bdia(j)=yctr2
 5476:          } // ics
 5477: 
 5478:          diffRho = rho2 - e1->demeanedDensity(k);
 5479:       }
 5480: 
 5481:    }
 5482: 
 5483:    __global__ void computeDensityCubicSplines(void) {
 5484:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5485: 
 5486:       ELEM(elem);
 5487: 
 5488:       if (elem->isDry) return;
 5489: 
 5490:       const int kb = elem->kb;
 5491: 
 5492:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5493:       if (elem->is2D()) {
 5494:          // In the 2D case, the density is constant at the prism level. 
 5495:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5496:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5497:       } else { //3D
 5498: 
 5499:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5500:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5501:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5502:          ///// XXXX CHECK INDICES!!!!!
 5503:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5504:       } // 2D/3D
 5505: 
 5506:    }
 5507: } // extern "C"
 5508: 
 5509: 
 5510: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5511: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5512: 
 5513:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5514: 
 5515:    const int kb  = elem->kb;
 5516:    const int kb2 = elem2->kb;
 5517: 
 5518:    // z-coordinate of prism of elem
 5519:    const double zp = elem->z_prism(k);
 5520: 
 5521:    double rho = 0.0;
 5522: 
 5523:    if (elem2->is2D()) {
 5524:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5525: 
 5526:    } else {  // 3D
 5527: 
 5528:       // eta_min may be < zmax
 5529:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5530:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5531: 
 5532:       // (Extrapolate density below bottom, we will fix it later)
 5533:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5534:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5535:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5536:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5537:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5538:    } // 2D/3D
 5539:      
 5540: 
 5541:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5542:    // Now we need to fix it.
 5543:    if (elem->z[k] < elem2->z[kb2]) {
 5544:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5545: 
 5546:       // There are two methods to adjust the density at the bottom of the element.
 5547:       // iunder_deep=0: 
 5548:       const double depth1 = abs(elem->z[kb]); // larger depth
 5549: 
 5550:       if (iunder_deep==0) {
 5551: 
 5552:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5553: 
 5554:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5555: 
 5556:       } else { // iunder_deep != 0
 5557: 
 5558:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5559: 
 5560:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5561: 
 5562:          //   Demeaned density at the same z coordinate as
 5563:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5564:          }
 5565: 
 5566:       } // if iunder_deep
 5567:    } // if elem->z[kb] < elem2->z[kb]
 5568: 
 5569:    return rho;
 5570: }
 5571: 
 5572: 
 5573: extern "C" {
 5574:    __global__ void computeDensityGradient(void) {
 5575: 
 5576:       if constexpr(ibc != 0) return;
 5577: 
 5578:          // Compute the horizontal density gradient at each element.
 5579:       // It works in two steps:
 5580:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5581:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5582:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5583:       //             gradRho.r1 = rho1 - rho0
 5584:       //             gradRho.r2 = rho2 - rho0
 5585:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5586:       // 
 5587:       //  NOTE: We use de-meaned densities.
 5588: 
 5589:       ELEM(elem);
 5590: 
 5591:       if (elem->isDry) return;
 5592: 
 5593:       const int kb  = elem->kb;
 5594:       const int i34 = elem->i34;
 5595: 
 5596:       for (int k = kb + 1; k < nvrt; k++) {
 5597:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5598:          //             gradRho.r1 = rho1 - rho0
 5599:          //             gradRho.r2 = rho2 - rho0
 5600:          int icount = 0;
 5601:          double sumRx = 0.0;
 5602:          double sumRy = 0.0;
 5603:          for (int j1=0; j1<i34; j1++) { 
 5604: 
 5605:             const int j2 = elem->nxq(j1 + 1);
 5606: 
 5607:             // Pairs of consecutive neighbor elements of elem
 5608:             const Element *e1 = elem->nghbElems[j1];
 5609:             const Element *e2 = elem->nghbElems[j2];
 5610: 
 5611:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5612:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5613:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5614: 
 5615:             // Compute the density difference and the vector from elem to e1 and e2
 5616:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5617:             double diffRho1, diffRho2;
 5618:             Vector2 vec1, vec2;
 5619:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5620:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5621: 
 5622:             const double rl1 = length(vec1);
 5623:             const double rl2 = length(vec2);
 5624:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5625: 
 5626:             const double delta = cross(vec1, vec2);
 5627:             const double sintheta = abs(delta)/(rl1*rl2);
 5628: 
 5629:             // To avoid problems, avoid elements with small angle between vectors
 5630:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5631:             const bool validEq = (sintheta > sin_one_deg);
 5632: 
 5633:             if (validEq) {
 5634:                // Solve the system of equations to get the density gradient at elem
 5635:                icount++;
 5636:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5637:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5638:                sumRx += Rx;
 5639:                sumRy += Ry;
 5640:             }
 5641:          } // for j1
 5642: 
 5643:          // Compute the average density gradient at elem
 5644:          if (icount==0) {
 5645:            // Bad mesh quality; bail out with 0 b-cc
 5646:            elem->gradRho[k] = {0.0, 0.0};
 5647:          } else {
 5648:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5649:          }
 5650: 
 5651:       } // for k
 5652: 
 5653:    }
 5654: 
 5655:    __global__ void computeBaroclinicTerm(void) {
 5656:    // Computes the baroclinic term at sides (at half levels).
 5657:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5658:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5659: 
 5660:       if (ibc == 1) return;
 5661: 
 5662:       SIDE(side);
 5663: 
 5664:       if (side->isDry) return;
 5665: 
 5666:       const Element *e1 = side->elems[0];
 5667:       const Element *e2 = side->elems[1];      
 5668:       const int kb = side->kb;
 5669:       
 5670:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5671: 
 5672:       // interpolates vertically the density gradient of the two elements at the half level/
 5673: 
 5674:       int k1 = max(kb, nvrt / 2);
 5675:       int k2 = max(kb, nvrt / 2);
 5676: 
 5677:       // Starts the integration at the surface and goes down to the bottom
 5678:       side->bcc[nvrt-1] = {0.0, 0.0};
 5679:       for (int k = nvrt - 2; k >= kb; k--) {
 5680:       // For each prism level (from surface to bottom)...
 5681: 
 5682:          // For both elements, interpolate density gradient at the side's half level.
 5683:          // The gradient at the side is the average of the gradients at the elements.
 5684:          // w1, w2 are used to take into account boundary sides, with just one element.
 5685:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5686:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5687:          const double wsum = w1 + w2;
 5688:          w1 = w1/wsum;
 5689:          w2 = w2/wsum;
 5690:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5691: 
 5692:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5693:          Vector2 gradRho = {0.0, 0.0};
 5694:          if (e1 != nullptr && k > kb) {
 5695:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5696:             
 5697:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5698:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5699:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5700: 
 5701:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5702:          }      
 5703:          if (e2 != nullptr && k > kb) {
 5704:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5705:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5706:             
 5707:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5708:          }
 5709: 
 5710:          if constexpr(ics==2) {
 5711:             assert(false && "Not implemented: ics == 2");
 5712:             // IMPLEMENT THIS XXXXXX
 5713:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5714:             // swild(1)=tmp1
 5715:             // swild(2)=tmp2
 5716:          }
 5717:          
 5718:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5719:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5720:          // CHECK INDICES!!! XXX
 5721:          const double grav3 = side->grav3();
 5722:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5723: 
 5724:       } // for
 5725: 
 5726:    }
 5727: 
 5728: 
 5729: 
 5730:    __global__ void computeHorGradientAtSide(void) {
 5731: 
 5732:       // Compute the horizontal density gradient at each element.
 5733:       // It works in two steps:
 5734:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5735:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5736:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5737:       //             gradRho.r1 = rho1 - rho0
 5738:       //             gradRho.r2 = rho2 - rho0
 5739:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5740:       // 
 5741:       //  NOTE: We use de-meaned densities.
 5742: 
 5743:       SIDE(side);
 5744: 
 5745: 
 5746:       if (side->isDry) return;
 5747: 
 5748:       // Computes the gradient of the variables at the side center.
 5749:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5750:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5751:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5752: 
 5753:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5754:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5755:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5756:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5757: 
 5758:    }
 5759: 
 5760: 
 5761:    __global__ void solveMomentumEquations(double time) {
 5762: 
 5763:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5764:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5765: 
 5766:       SIDE(side);
 5767: 
 5768:       if (side->isDry) 
 5769:       {
 5770:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5771: 
 5772:          return;
 5773:       }
 5774: 
 5775:       const Node *n1 = side->n1;
 5776:       const Node *n2 = side->n2;
 5777: 
 5778:       const int kb = side->kb;
 5779: 
 5780:       const double veg_h = side->veg_h();
 5781:       const double grav3 = side->grav3();
 5782: 
 5783:       if (side->is2D()) {
 5784:          // Remember: Do not use htot2, which is updated.
 5785:          const double htot = side->htot1();
 5786:          const double hhat = side->hhat;
 5787: 
 5788:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5789: 
 5790:          Vector2 tau2 = {0.0, 0.0};
 5791:           
 5792:          if constexpr(ics==1) {
 5793:             tau2 = side->tau();
 5794: 
 5795:          } else {
 5796:             assert(false && "Not implemented: ics == 2");
 5797:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5798:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5799:             // taux2=(vn1+tt1)*0.5d0
 5800:             // tauy2=(vn2+ss1)*0.5d0
 5801:          } // if ics         
 5802: 
 5803:          // hat_gam has units of m/s
 5804: 
 5805:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5806:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5807:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5808: 
 5809:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5810: 
 5811: 
 5812:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5813: 
 5814:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5815: 
 5816:       }
 5817:       else { // 3D
 5818: 
 5819:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5820:          // 
 5821:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5822:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5823:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5824:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5825:          // k+1 and k.
 5826: 
 5827: 
 5828:          const int ndim = nvrt - kb;
 5829:          const double zTopCanopy = side->zTopCanopy();
 5830: 
 5831:          // Initialize the tridiagonal system
 5832:          for (int k = kb + 1; k < nvrt; k++) {
 5833:             
 5834:             const int kin = k - (kb + 1);
 5835: 
 5836:             // Vertical viscosity at the face center
 5837:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5838: 
 5839:  
 5840:             alow[kin] = 0.0;
 5841:             cupp[kin] = 0.0;
 5842:             bdia[kin] = 0.0;
 5843: 
 5844:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5845:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5846: 
 5847:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5848:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5849:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5850: 
 5851:             // First part: layers k, k+1
 5852:             if (k < nvrt - 1) {
 5853:                              
 5854:                if constexpr(iveg != 0) {
 5855: 
 5856:                   // If there is vegetation at this level...
 5857:                   if (zTopCanopy > side->zc[k]) {
 5858:                      // If the canopy is above the k layer...
 5859:                      
 5860:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5861:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5862:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5863:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5864: 
 5865:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5866:                      const double vmag2 = length(ut2);
 5867:                      const double vmag1 = length(side->u2[k]);
 5868:                      const double vmag = 0.5*(vmag1 + vmag2);
 5869:                      
 5870:                      // Computes the vegetation alpha at the face center
 5871:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5872: 
 5873:                      cff1 += veg_alpha_sd*dt*vmag;
 5874: 
 5875:                   } // if (zTopCanopy
 5876:                } // if iveg
 5877: 
 5878:                const double dzz = side->Dz(k + 1);
 5879:                const double tmp = dt*dfz/dzz;
 5880:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5881: 
 5882:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5883:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5884:             }
 5885: 
 5886: 
 5887:             // Second part: layers k-1, k
 5888:             if (k > kb + 1) {
 5889: 
 5890:                double cff1 = 1.0; //init \bar{c^k}
 5891: 
 5892:                if constexpr(iveg != 0) {
 5893:                   // If there is vegetation at this level...
 5894:                   if (zTopCanopy > side->zc[k-1]) {
 5895:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5896:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5897: 
 5898:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5899: 
 5900:                      const double vmag2 = length(ut2);
 5901:                      const double vmag1 = length(side->u2[k-1]);
 5902:                      const double vmag = 0.5*(vmag1 + vmag2);
 5903: 
 5904:                      // Computes the vegetation alpha at the face center
 5905:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5906:                      cff1 += veg_alpha_sd*dt*vmag;
 5907:                   } // if zTopCanopy
 5908: 
 5909:                } // if iveg
 5910: 
 5911:                const double dzz = side->Dz(k);
 5912:                const double tmp = dt*dfz/dzz;
 5913:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5914: 
 5915:                alow[kin] += cff1*dzz/6.0 - tmp;
 5916:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5917: 
 5918:             } else { // Bottom boundary
 5919:                // This occurs at the bottom, where the bottom drag is applied.
 5920: 
 5921:                bdia[kin] += dt*side->chi2; // XXXX
 5922: 
 5923:             } // if (k > kb + 1)
 5924: 
 5925: 
 5926:          } // for (int k
 5927: 
 5928: 
 5929: 
 5930:          // Computes the RHS.
 5931:          // -----------------
 5932: 
 5933:          //	BC to be imposed at the end.
 5934: 
 5935:          const Vector2 gradETP  = side->gradETP;
 5936:          const Vector2 gradPr   = side->gradPr;
 5937:          const Vector2 gradEta1 = side->gradEta1;
 5938:          const Vector2 gradEta2 = side->gradEta2;
 5939: 
 5940:          const Vector2 *btu = side->btu;
 5941:          const Vector2 *u2  = side->u2;
 5942:          const double coriolis = side->coriolis;
 5943:          const Vector2 *nuGradU = side->nuGradU;
 5944: 
 5945: 
 5946:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5947:          for (int k = kb + 1; k < nvrt; k++) {
 5948:             const int kin = k - kb - 1;
 5949: 
 5950:             const double dz_0 = side->Dz(k);
 5951:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5952: 
 5953:             rrhs[kin] = {0.0, 0.0};
 5954:             double dz = 0.0;
 5955: 
 5956:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5957:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5958:             if (k < nvrt  ) dz += dz_1;
 5959:             if (k > kb + 1) dz += dz_0;
 5960: 
 5961:             // Elevation gradient, atmospheric pressure and tidal potential
 5962:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5963: 
 5964:             // Coriolis, advection, wind stress, and horizontal viscosity
 5965:             if (k < nvrt - 1) {
 5966: 
 5967: 
 5968:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5969:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5970:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5971:                                                 
 5972: 
 5973:                //diff stress tensors 1006
 5974:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5975:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5976:                   assert(false && "Not implemented: itur == 5");
 5977:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5978:                }
 5979:                // else assert(false && "itur # Not implemented");
 5980: 
 5981:             } else { // k == nvrt - 1 SURFACE
 5982:                Vector2 tau2 = {0.0, 0.0};
 5983:                if constexpr(ics==1) {
 5984:                   tau2 = side->tau();
 5985:       
 5986:                } else {
 5987:                   assert(false && "Not implemented: ics == 2");
 5988:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5989:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5990:                   // taux2=(vn1+tt1)*0.5d0
 5991:                   // tauy2=(vn2+ss1)*0.5d0
 5992:                } // if ics
 5993: 
 5994:                rrhs[kin] += dt*tau2;
 5995:           
 5996: 
 5997:             } // if k<nvrt
 5998: 
 5999: 
 6000:             if (k > kb + 1) {
 6001:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6002:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6003:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6004: 
 6005:                // diff stress tensors 1006
 6006:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6007:                   assert(false && "Not implemented: itur == 5");
 6008:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6009:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6010:                }
 6011:                // else assert(false && "itur # Not implemented");
 6012: 
 6013: 
 6014:             } // if k>kbs + 1
 6015: 
 6016:             // Baroclinic
 6017:             Vector2 *bcc = side->bcc;
 6018:             if constexpr(ibc == 0) {
 6019:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6020:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6021: 
 6022:             } // if ibc==0
 6023: 
 6024:          } // k=kb + 1,nvrt
 6025: 
 6026: 
 6027:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6028: 
 6029:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6030:             const int kin = k - kb - 1;
 6031:    
 6032:             // Velocity is always clamped to maximum values
 6033:             side->u2[k] = clampVelocity(soln[kin]);
 6034:          } // k
 6035: 
 6036:       } // if side->is2D()
 6037:       
 6038: 
 6039:       // Impose velocity boundary condition at the bottom
 6040:       if constexpr(imm == 2) { // 3D bed deformation model
 6041:          double dep;
 6042:          Vector2 vel;
 6043: 
 6044:          assert(false && "Not implemented: imm == 2");
 6045:          //update_bdef(time, x0, y0, dep, vel);
 6046:          // side->u2[kb] = vel;
 6047: 
 6048:       } else { // imm = 0 or 1
 6049:          if (side->Cd() == 0.0) {
 6050:             side->u2[kb] = side->u2[kb + 1];
 6051: 
 6052:          } else if (side->is3D()) { // 3D no slip bottom   
 6053:             side->u2[kb] = {0.0, 0.0};
 6054: 
 6055:          }
 6056:           
 6057:       } // if imm
 6058: 
 6059:       // The velocities below the bottom level are set to zero
 6060:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6061: 
 6062: 
 6063:    }
 6064: 
 6065: 
 6066:    __global__ void applyMomentumBC(void) {
 6067: 
 6068:       SIDE_BND(sideBnd);
 6069: 
 6070:       Side *side = sideBnd->side;
 6071:       const BoundarySegment *segment = sideBnd->segment;
 6072:       const Node *n1 = side->n1;
 6073:       const Node *n2 = side->n2;
 6074: 
 6075:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6076: 
 6077:       const bool isLand = segment->isLand;
 6078:       const int ifltype = segment->ifltype;
 6079: 
 6080:       const int kb = side->kb;
 6081: 
 6082: 
 6083:       if (!isLand && ifltype != 0) {
 6084:          const Vector2 *ubc = sideBnd->ubc;
 6085:   
 6086:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 6087:             
 6088:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6089:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6090: 
 6091:             if (ifltype == -1) {
 6092:                // Flather 1
 6093: 
 6094:                const double depth = side->depth();
 6095: 
 6096:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6097: 
 6098:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6099: 
 6100:                side->u2[k] = vnorm*side->n;
 6101: 
 6102:             } else if (ifltype == -2) { // Discharge
 6103: 
 6104:                const double eta1 = side->eta1();
 6105:                const double eta2 = side->eta2();
 6106:                const double htot = side->htot2();
 6107: 
 6108:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6109:                assert(false && "Not implemented: Discharge bc");
 6110:                // const double dischrg = discharge(eta1);
 6111:                const double dischrg = 0.0; // XXX REMOVE
 6112:                
 6113: 
 6114:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6115: 
 6116:                const double vnorm = dischrg*eta2/htot;
 6117: 
 6118:                side->u2[k] = vnorm*side->n;
 6119: 
 6120:             }
 6121:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6122:                const double vnorm = dot(side->u2[k], side->n);
 6123: 
 6124:                double rat;
 6125:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6126:                else              rat = segment->vobc2; // outgoing
 6127: 
 6128:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6129: 
 6130:             }
 6131:             else { // not Flather or 3D radiation
 6132:                side->u2[k] = ubc[k];
 6133: 
 6134:             } // if (segment->ifltype...
 6135: 
 6136:          }
 6137: 
 6138:       }
 6139:       else if (isLand) { // if it is land boundary side
 6140: 
 6141:          if constexpr(islip == 0) { // free slip
 6142: 
 6143:             for (int k = kb; k < nvrt; k++) {
 6144: 
 6145:                const Vector2 t = side->t();
 6146:                const Vector2 n = side->n;
 6147: 
 6148:                double vnorm = 0.0; // for most cases
 6149:                const double vtan = dot(side->u2[k], t);
 6150:                
 6151:                side->u2[k] = vtan*t - vnorm*n;
 6152: 
 6153:             }
 6154: 
 6155:          } else { // no slip
 6156:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6157: 
 6158:          }
 6159:       } // if (side segment type...
 6160: 
 6161:    
 6162: 
 6163:    }
 6164: 
 6165: 
 6166:    __global__ void shapiroFilter1(void) {
 6167:       // First step of the Shapiro filter (normally used if indvel<=0)
 6168:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6169: 
 6170:       SIDE(side);
 6171: 
 6172:       // Only internal wet sides are processed
 6173:       if (side->isDry || !(side->isInternal())) return;
 6174: 
 6175:       const int kb = side->kb;
 6176: 
 6177:       for (int mm = 0; mm < niter_shap; mm++) {
 6178: 
 6179:          for (int k = kb + 1; k < nvrt; k++) {
 6180:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6181:             Vector2 suru = {0.0, 0.0};
 6182: 
 6183:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6184: 
 6185:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6186: 
 6187:                int kin = k;
 6188:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6189:                
 6190:                if constexpr(ics==1) {
 6191:                   suru += nSide->u2[kin];
 6192: 
 6193:                } else {
 6194:                   assert(false && "Not implemented: ics == 2");
 6195:                   // Vector2 vn1, vn2;
 6196:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 6197:                   // suru=suru+vn1;
 6198:                   // surv=surv+vn2;
 6199:                }
 6200:             }
 6201: 
 6202:             // Reusing bcc as a temporary array to store the suru values.
 6203:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6204: 
 6205:          }
 6206:       }
 6207:    }
 6208: 
 6209:    __global__ void shapiroFilter2(void) {
 6210:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6211: 
 6212:       SIDE(side);
 6213: 
 6214: 
 6215:       if (side->isDry || !(side->isInternal())) return;
 6216: 
 6217:       const int kb = side->kb;
 6218: 
 6219:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6220: 
 6221:       if (side->is2D()) {
 6222:          side->u2[kb + 1] = side->bcc[kb + 1];
 6223:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6224: 
 6225:       } else {
 6226:          // 3D
 6227:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6228:          
 6229:       }
 6230: 
 6231:    }
 6232: 
 6233: 
 6234:    __global__ void ul0UpdateZCoords(void) {
 6235:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6236:       
 6237:       NODE(node);      
 6238: 
 6239: 
 6240:       if (false) { //node->isDry) { XXXXXXX
 6241: 
 6242:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6243: 
 6244:          if constexpr(ivcor != 1) node->kb = 0;
 6245: 
 6246:       } else {
 6247: 
 6248:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6249:          node->updateKb();
 6250: 
 6251:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6252: 
 6253:       }
 6254: 
 6255:       // We use the temp.b field to store the previous state of isDry.
 6256:       node->tmp.b = node->isDry;
 6257: 
 6258:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6259:       node->isDry = true;
 6260: 
 6261:    }
 6262: 
 6263:    __global__ void ul0ComputeDryElements(void)
 6264:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6265:    {
 6266:       ELEM(elem);
 6267: 
 6268:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6269: 
 6270:       elem->kb = 0;
 6271: 
 6272:       if (elem->isDry) return;
 6273: 
 6274: 
 6275:    //    if(elem->isDry2()) { // XXXX
 6276:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6277:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6278:    //        call parallel_abort(errmsg)
 6279:    //    }
 6280: 
 6281:       const Node *n1 = elem->nodes[0];
 6282:       const Node *n2 = elem->nodes[1];
 6283:       const Node *n3 = elem->nodes[2];  
 6284:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6285: 
 6286:       // Computes element's kb as the minimum of the nodes' kb.
 6287:       const int kb1 = n1->kb;
 6288:       const int kb2 = n2->kb;
 6289:       const int kb3 = n3->kb;
 6290:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6291: 
 6292: 
 6293:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6294: 
 6295: 
 6296:       // Computes the element z as the mean of the nodes z.
 6297:       for (int k = elem->kb; k < nvrt; k++) {
 6298: 
 6299:          // Compute the element z as the mean of the nodes z.
 6300:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6301:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6302:          elem->z[k] /= elem->i34;
 6303: 
 6304:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6305:       }
 6306:                   
 6307:    }
 6308: 
 6309:    __global__ void ul0ComputeDryNodes(void)
 6310:    // Updates node's isDry based on the elements' isDry. 
 6311:    {
 6312:       NODE(node);
 6313: 
 6314:       node->isDry = true;
 6315: 
 6316:       // A node is wet if at least one of the elements sharing it is wet.
 6317:       for (int j = 0; j < node->numElements; j++) {
 6318:          const Element *elem = node->elements[j];
 6319:          if (!elem->isDry) {
 6320:             node->isDry = false;
 6321:             break;
 6322:          }
 6323:       }
 6324: 
 6325:        
 6326:    }
 6327: 
 6328: 
 6329:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6330:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6331:    // node->tmp.b is true if the node was previously dry.
 6332:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6333:    {
 6334:       NODE(node);
 6335:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6336: 
 6337:       // Avoid this the first time step.
 6338:       if (it == iths) return;  
 6339: 
 6340:       const bool wasDry = node->tmp.b;
 6341: 
 6342: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6343: 
 6344:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6345: 
 6346:          for (int k=0; k < nvrt; k++) {
 6347: 
 6348:             Vector3 utmp={0.0, 0.0, 0.0};
 6349: 
 6350:             double ttmp=0.0;
 6351:             double stmp=0.0;
 6352:             int icount=0;
 6353:             for (int j = 0; j < node->numNodes; j++) {
 6354: 
 6355:                const Node *nbrNode = node->nodes[j];
 6356:                
 6357:                const bool wasNbrDry = nbrNode->tmp.b;
 6358: 
 6359:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6360:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6361: 
 6362:                   icount++;
 6363: 
 6364:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6365:                   utmp += nbrNode->uvw2(k);
 6366:                   
 6367:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6368:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6369:                }
 6370:             }
 6371: 
 6372:             if (icount > 0) {
 6373:                const double inv_icount = 1.0/icount;
 6374:                utmp = inv_icount*utmp;
 6375:                node->u2[k]     = toVector2(utmp);
 6376:                node->w2[k]     = utmp.z;
 6377:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6378:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6379:             } else {
 6380:                node->u2[k] = {0.0, 0.0};
 6381:                node->w2[k] = 0.0;
 6382:                // Initialize tracers to 0.0??? XXXXX
 6383:             }
 6384:          }
 6385:       }
 6386:    }
 6387: 
 6388:   
 6389:    
 6390: 
 6391: 
 6392:    __global__ void ul0UpdateSides(int it, int iths) {
 6393:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6394:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6395:    // The dryness of the sides is updated in ul0UpdateSides2.
 6396: 
 6397:       SIDE(side);
 6398: 
 6399:       // A side is wet if and only if at least one of its elements is wet.
 6400:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6401:  
 6402:       const Node *n1 = side->n1;
 6403:       const Node *n2 = side->n2;
 6404:      
 6405:       const int kb1 = n1->kb;
 6406:       const int kb2 = n2->kb;
 6407: 
 6408:       side->kb = 0; // default when dry
 6409: 
 6410:       if (isWet) {
 6411: 
 6412:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6413: 
 6414:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6415: 
 6416:          side->kb = min(kb1, kb2);
 6417: 
 6418:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6419: 
 6420:          for (int k = side->kb; k < nvrt; k++) {
 6421:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6422: 
 6423:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6424: 
 6425:             // Compute velocity for re-wetted sides 
 6426:             if ((it != iths) && (side->isDry && isWet)) {
 6427: 
 6428:                Vector2 utmp={0.0, 0.0};
 6429: 
 6430:                int icount=0;
 6431: 
 6432:                // For all the sides on the two elements that share this side
 6433:                for (int j = 0; j < 2; j++) {
 6434:                   const Element *elem = side->elems[j];
 6435:                   if (elem == nullptr) continue;
 6436: 
 6437:                   for (int jj=0; jj < elem->i34; jj++) {
 6438:                      const Side *nSide = elem->sides[jj];
 6439:                      if (nSide->isDry) continue;
 6440: 
 6441:                      icount++;
 6442:                      utmp += nSide->u2[k];  
 6443:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6444:                   }
 6445:                }
 6446:                   
 6447:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6448:                if (icount > 0)  side->u2[k] = utmp/icount;
 6449:                else             side->u2[k] = {0.0, 0.0};
 6450:                   
 6451:             } // if ((it != iths) && (side->isDry && isWet))
 6452: 
 6453:          } // for k
 6454: 
 6455:       } // if isWet 
 6456:       
 6457: 
 6458: 
 6459:    }
 6460: 
 6461:    __global__ void ul0UpdateSides2(void) {
 6462:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6463:    
 6464:          SIDE(side);
 6465:    
 6466:          const Element *e1 = side->elems[0];
 6467:          const Element *e2 = side->elems[1];
 6468: 
 6469:          // A side is wet if and only if at least one of its elements is wet.
 6470:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6471: 
 6472:          // Update the side's dryness
 6473:          side->isDry = !isWet;
 6474: 
 6475:    }
