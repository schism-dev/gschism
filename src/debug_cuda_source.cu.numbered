 2551: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2552:    // Returns the value of the normal component of the velocity at the side center
 2553:    const double w1 = getBoundaryArrayValueWeight();
 2554:    const double w2 = 1.0 - w1;
 2555:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2556:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2557: 
 2558:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
