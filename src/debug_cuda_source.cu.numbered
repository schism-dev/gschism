  182: struct Bool4 {
  183:    unsigned int m; // bit i = lane i
  184: 
  185:    __device__ __forceinline__ bool get(int i) const { return (m >> i) & 1u; }
  186:    __device__ __forceinline__ void set(int i, bool v) {m = (m & ~(1u << i)) | ((unsigned int)(v) << i); }
  187: 
  188:    __device__ __forceinline__ bool all(void) const { return m == 0x0F; }
  189:    __device__ __forceinline__ bool any(void) const { return m != 0; }
  190:    __device__ __forceinline__ bool none(void) const { return m == 0; }
  191:    __device__ __forceinline__ int firstOne(void) const { return __ffs(m) - 1; }
  192: 
  193: };
  194: 
  195: __device__ __forceinline__ Bool4 operator!(Bool4 x) { x.m = (~x.m) & 0x0F; return x; }
  196: __device__ __forceinline__ Bool4 operator&(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m & b.m)}; }
  197: __device__ __forceinline__ Bool4 operator|(Bool4 a, Bool4 b) { return Bool4{(unsigned int)(a.m | b.m)}; }
