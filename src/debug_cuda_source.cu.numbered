 2243: 
 2244: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2245:    if constexpr(ics == 1)  {
 2246:       return center;
 2247: 
 2248:    } else {
 2249:       const Point2 p0 = nodes[0]->outputCoords();
 2250:       const Point2 p1 = nodes[1]->outputCoords();
 2251:       const Point2 p2 = nodes[2]->outputCoords();
 2252: 
 2253:       if (isTri()) {
 2254:          return (1.0/3.0)*(p0 + p1 + p2);
 2255: 
 2256:       } else {
 2257:          const Point2 p3 = nodes[3]->outputCoords();
 2258:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2259:       }
 2260: 
 2261:    }
 2262: }
 2263: 
 2264: 
 2265: __device__ __forceinline__ double Element::centerZ(void) const { 
 2266: // Z coordinate of the element center in the global cartesian coordinates.
 2267: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2268: 
 2269:    if constexpr(ics==1) { 
 2270:       return 0.0; 
 2271: 
 2272:    } else { 
 2273: 
 2274:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2275:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2276:    } 
 2277: }
