 1398: struct BTPoint {
 1399:    Point3 x;
 1400:    // double pad1;
 1401:    Vector3 u;  // Velocity interpolated at the current point. It is not necessarily the one used to compute the next point (because sliding along a side is allowed)
 1402:    // double pad2;
 1403:    double dt;
 1404:    double  t; // Parametric value of the point on the side when type is btSide. This is not a time!!!
 1405: 
 1406:    Element *elem;
 1407:    Side    *side;
 1408:    Node    *node;
 1409: 
 1410:    enum class BTPointType {btElement, btSide, btNode};
 1411:    BTPointType type;
 1412: 
