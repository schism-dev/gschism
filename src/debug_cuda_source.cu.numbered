 7563: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7564:    // Get the value of a variable from an element
 7565:    // varName is the name of the variable to get
 7566:    // var is the array to store the value
 7567:    // k is the vertical level index of the variable to get
 7568: 
 7569:    ELEM(elem);
 7570:    
 7571:    int idx = elem->idx;
 7572:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7573: 
 7574:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7575:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7576:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7577:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7578:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7579:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7580:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7581:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7582:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7583:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7584:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7585:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7586:       
 7587:    
 7588: }
 7589: 
 7590: 
 7591: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7592:    // Get the value of a variable from an node
 7593:    // varName is the name of the variable to get
 7594:    // var is the array to store the value
 7595:    // k is the vertical level index of the variable to get
 7596: 
 7597:    NODE(node);
 7598:    
 7599:    int idx = node->idx;
 7600:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7601: 
 7602:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7603:    
 7604:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7605:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7606:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7607:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7608:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7609:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7610:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7611:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7612:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7613:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7614:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7615:    
 7616:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7617:       
 7618:    
 7619: }
 7620: 
 7621: 
 7622: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7623:    // Get the value of a variable from an side
 7624:    // varName is the name of the variable to get
 7625:    // var is the array to store the value
 7626:    // k is the vertical level index of the variable to get
 7627:    SIDE(side);
 7628:    
 7629:    int idx = side->idx;
 7630:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7631: 
 7632:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7633:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7634:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7635:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7636:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7637:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7638:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7639:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7640:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7641:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7642:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7643:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7644:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7645:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7646:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7647:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7648:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7649:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 7650:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7651:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7652:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7653:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7654:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7655:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7656:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7657:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7658:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7659:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7660:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7661:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7662:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7663:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7664:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7665:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7666:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7667:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7668: }
 7669: 
 7670: 
 7671: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7672:    // Get the value of a variable from an side
 7673:    // varName is the name of the variable to get
 7674:    // var is the array to store the value
 7675:    // k is the vertical level index of the variable to get
 7676:    SIDE_BND(sideBnd);   
 7677: 
 7678:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7679:    if (sideBnd->segment->isLand) idx = -7;
 7680: 
 7681:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7682:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7683: 
 7684: }
