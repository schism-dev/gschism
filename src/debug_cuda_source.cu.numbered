 4197:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4198: 
 4199:       NODE_BND(nodeBnd);
 4200: 
 4201:       Node *node = nodeBnd->node;
 4202: 
 4203:       node->ETP = 0.0;
 4204: 
 4205:       for (int j=0; j<ntip; j++) {
 4206: 
 4207:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4208:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4209:    
 4210:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4211: 
 4212:          if constexpr(iloadtide==1) { // loading tide
 4213:             assert(false && "Loading tide not implemented");
 4214:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4215:          }
 4216:          
 4217:       }
 4218:       
 4219:    }
