 4224:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4225: 
 4226:       SIDE(side);
 4227: 
 4228: 
 4229:       side->U = {0.0, 0.0}; 
 4230:          
 4231:       if(side->isDry) return;
 4232: 
 4233:       const Node *node1 = side->n1;
 4234:       const Node *node2 = side->n2;
 4235: 
 4236:       // Vertically integrated velocity U (in ll if ics=2)
 4237:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4238:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4239:       }
 4240: 
 4241:    }
 4242: 
 4243:    __global__ void computeBottomDragVegetation(void) {
 4244:       // UNFINISHED. CHECK THIS:
 4245:       // How many kernels are needed? Why so many for loops?
 4246:       // Is the loop on sides needed?
 4247: 
 4248:       NODE(node);
 4249: 
 4250:       const int    kb      = node->kb;
 4251:       const double htot    = node->htot2();
 4252:       const double rough   = node->rough;
 4253: 
 4254: 
 4255:       if (node->isDry) {
 4256:          // Default values for dry nodes
 4257:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4258:          /// XXX CHECK INDICES
 4259:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4260:       }
 4261: 
 4262:       // Compute bottom drag Cd
 4263:       //--------------------------------
 4264: 
 4265:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4266:       if (nchi==1) {
 4267: 
 4268:          bool ltmp = false; // for WBL iteration
 4269: 
 4270:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4271:          // Drag at nodes
 4272:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4273:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4274:         
 4275:          const double rough = node->rough;
 4276:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4277:          if (node->rough == 0.0) {
 4278:             node->Cd = 0.0;
 4279: 
 4280:          } else { //roughness >0 
 4281:             
 4282:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4283:             const double bthick = max(dzb_min, bthick_ori);
 4284: 
 4285:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4286: 
 4287:             double tmp = 1.0/(2.5*log(bthick/rough));
 4288:             node->Cd = tmp*tmp;
 4289: 
 4290:          } // if rough
 4291: 
 4292: 
 4293:          // RECOVER THIS: XXX
 4294:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4295:          // Output warning for WBL if iteration didn't converge
 4296: 
 4297: 
 4298:       } // nchi==1
 4299: 
 4300:       //   Bottom stress in m^2/s^2
 4301:       if (node->rho[kb + 1] >= -98.0)
 4302:       {
 4303:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4304:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4305:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4306:          // !sediment erosion: this part needs more documentation
 4307:       }
 4308: 
 4309:     
 4310:       // Compute vegetation parameters
 4311:       //--------------------------------
 4312: 
 4313:       // SAV constants
 4314:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4315:       constexpr double veg_cfpsi = 0.16;
 4316: 
 4317:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4318:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4319: 
 4320:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4321:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4322:          int kbin = 0; // bin index
 4323:          for (int k = kb; k < nvrt; k++) {
 4324:             // Computes node height above the bottom level
 4325:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4326:             assert(false && "Vertical variation of vegetation not implemented");
 4327: 
 4328:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4329:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4330:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4331:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4332:             // } else {
 4333:             //    // Find the bin at which the current vertical level is
 4334:             //    while (kbin<nbins_veg_vert) {
 4335:             //       const double zn = node->z[kbin];
 4336:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4337:             //          break;
 4338:             //       } // if
 4339:             //       kbin++;
 4340:             //    } // while
 4341:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4342: 
 4343:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4344:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4345:                
 4346:             //    // Linear interpolation of the vegetation parameters
 4347:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4348:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4349:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4350:             // } // if rl10
 4351: 
 4352:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4353: 
 4354:          } // for k
 4355: 
 4356: 
 4357:       } else { // Ganthy (iveg=2)
 4358:       //  Modify canopy height, diameter, and density
 4359: 
 4360:          // Make sure there is vegetation on this node
 4361:          if (node->veg_h_unbent > 0.0) {
 4362:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4363: 
 4364:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4365:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4366:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4367: 
 4368:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4369:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4370:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4371:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4372:          } // if veg_h_unbent
 4373: 
 4374:          for (int k = 0; k < nvrt; k++) {
 4375:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4376:          } // for k
 4377:       
 4378: 
 4379:       } // if iveg
 4380:      
 4381:          
 4382: 
 4383:       // Compute vertical mean of veg_alpha3D
 4384:       if (iveg != 0) {
 4385:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4386:          double sum1=0.0;
 4387:          double sum2=0.0;
 4388:          // Integrate over each level under the canopy...
 4389:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4390:             const double Dz = node->Dz(k);
 4391: 
 4392:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4393:             sum2 += Dz;
 4394: 
 4395:          } // for k
 4396: 
 4397:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4398:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4399: 
 4400:       } // if iveg
 4401: 
 4402:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4403: 
 4404:    }
 4405: 
 4406:    __global__ void computeVegetationAndDragParameters(void) {
 4407:       // Computes the vegetation and drag model parameters:
 4408:       // chi, \tilde\chi, beta, \breve{H}
 4409:       
 4410:       SIDE(side);
 4411: 
 4412:       const double htot = side->htot2();
 4413:       const int    kb   = side->kb;
 4414: 
 4415:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4416: 
 4417:       const double veg_h     = side->veg_h();
 4418:       const double veg_nv    = side->veg_nv();
 4419:       const double veg_c     = side->veg_c();
 4420:       const double veg_beta  = side->veg_beta;
 4421:       const double veg_alpha = side->veg_alpha_vert_mean();
 4422: 
 4423:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4424:       // Velocity magnitude at the bottom level
 4425:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4426:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4427:       side->chi2 = side->Cd()*vmag1;
 4428:       side->chi  = side->chi2;
 4429:       if constexpr(iveg != 0) {
 4430:          const Node *n1 = side->n1;
 4431:          const Node *n2 = side->n2;
 4432:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4433:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4434:       }
 4435: 
 4436:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4437: 
 4438:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4439:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4440:       double magUa = 0.0;
 4441:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4442:          // 3D wet side with veg...
 4443: 
 4444:          double magUa = 0.0;
 4445:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4446:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4447: 
 4448:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4449:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4450:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4451: 
 4452:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4453:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4454: 
 4455:                // Velocity magnitude at the bottom (l) of the level
 4456:                const double ul = length(side->u2[k]);
 4457: 
 4458:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4459:                magUa += Dz*0.5*(uh + ul);
 4460: 
 4461:             } // if HasVegetation
 4462:          } // for k
 4463:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4464: 
 4465:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4466:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4467:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4468:             const double zCpy = side->zTopCanopy();
 4469:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4470:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4471:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4472:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4473:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4474:          } // if isSubmerged
 4475:       } // if iveg   
 4476: 
 4477:       // Computes the friction modified depth, \breve{H} in notes
 4478:       if (side->is2D()) { // 2D
 4479: 
 4480:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4481:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4482: 
 4483:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4484: 
 4485:          side->hhat = htot*htot/fricH; 
 4486: 
 4487:       } else { // 3D
 4488:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4489: 
 4490:          if constexpr(iveg != 0) {
 4491:             
 4492:             if (side->isSubmerged()) { 
 4493:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4494:                side->hhat -= veg_c*Hhat_alpha;
 4495: 
 4496:             } else { // Emergent
 4497:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4498:             }
 4499:          } // if iveg
 4500: 
 4501:          // Enforce positivity for 3D model
 4502:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4503:       } // if 3D
 4504: 
 4505:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4506: 
 4507:         
 4508:    }
 4509: 
 4510: 
 4511: 
 4512:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4513:    // Computes the density gradient between two elements, e1 and e2.
 4514:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4515:    // zero in the direction normal to the side. 
 4516:    // 
 4517:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4518:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4519:    //
 4520:    // Input:
 4521:    //    e1: Element
 4522:    //    e2: Neighbor element (or nullptr if boundary)
 4523:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4524:    //    k: Index of the half-level at which the density is interpolated
 4525:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4526:    // 
 4527:    // Output:
 4528:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4529:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4530: 
 4531:       if (e2 == nullptr || e2->isDry) {
 4532:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4533: 
 4534:          Side *side = e1->sides[j];
 4535:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4536:                  
 4537:          if constexpr(ics == 1) {
 4538:             vec = side->n; // Normal vector to the side
 4539:          } else {
 4540:             // IMPLEMENT THIS XXXXXX
 4541:             // !replace with xel, yel?
 4542:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4543:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4544:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4545:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4546:          } //ics
 4547:                    
 4548:          diffRho = 0.0;
 4549: 
 4550:       } else { //internal and wet
 4551:          if constexpr(ics==1) {
 4552:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4553: 
 4554:             // Vector from e1 to e2
 4555:             vec = toVector2(e2->center - e1->center);
 4556: 
 4557:          } else { 
 4558:             // IMPLEMENT THIS XXXXXX
 4559:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4560:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4561:             //                   alow(j)=xctr2
 4562:             //                   bdia(j)=yctr2
 4563:          } // ics
 4564: 
 4565:          diffRho = rho2 - e1->demeanedDensity(k);
 4566:       }
 4567: 
 4568:    }
 4569: 
 4570:    __global__ void computeDensityCubicSplines(void) {
 4571:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4572: 
 4573:       ELEM(elem);
 4574: 
 4575:       if (elem->isDry) return;
 4576: 
 4577:       const int kb = elem->kb;
 4578: 
 4579:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4580:       if (elem->is2D()) {
 4581:          // In the 2D case, the density is constant at the prism level. 
 4582:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4583:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4584:       } else { //3D
 4585: 
 4586:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4587:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4588:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4589:          ///// XXXX CHECK INDICES!!!!!
 4590:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4591:       } // 2D/3D
 4592: 
 4593:    }
 4594: } // extern "C"
 4595: 
 4596: 
 4597: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4598: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4599: 
 4600:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4601: 
 4602:    const int kb  = elem->kb;
 4603:    const int kb2 = elem2->kb;
 4604: 
 4605:    // z-coordinate of prism of elem
 4606:    const double zp = elem->z_prism(k);
 4607: 
 4608:    double rho = 0.0;
 4609: 
 4610:    if (elem2->is2D()) {
 4611:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4612: 
 4613:    } else {  // 3D
 4614: 
 4615:       // eta_min may be < zmax
 4616:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4617:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4618: 
 4619:       // (Extrapolate density below bottom, we will fix it later)
 4620:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4621:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4622:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4623:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4624:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4625:    } // 2D/3D
 4626:      
 4627: 
 4628:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4629:    // Now we need to fix it.
 4630:    if (elem->z[k] < elem2->z[kb2]) {
 4631:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4632: 
 4633:       // There are two methods to adjust the density at the bottom of the element.
 4634:       // iunder_deep=0: 
 4635:       const double depth1 = abs(elem->z[kb]); // larger depth
 4636: 
 4637:       if (iunder_deep==0) {
 4638: 
 4639:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4640: 
 4641:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4642: 
 4643:       } else { // iunder_deep != 0
 4644: 
 4645:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4646: 
 4647:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4648: 
 4649:          //   Demeaned density at the same z coordinate as
 4650:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4651:          }
 4652: 
 4653:       } // if iunder_deep
 4654:    } // if elem->z[kb] < elem2->z[kb]
 4655: 
 4656:    return rho;
 4657: }
 4658: 
 4659: 
 4660: extern "C" {
 4661:    __global__ void computeDensityGradient(void) {
 4662: 
 4663:          // Compute the horizontal density gradient at each element.
 4664:       // It works in two steps:
 4665:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4666:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4667:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4668:       //             gradRho.r1 = rho1 - rho0
 4669:       //             gradRho.r2 = rho2 - rho0
 4670:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4671:       // 
 4672:       //  NOTE: We use de-meaned densities.
 4673: 
 4674:       ELEM(elem);
 4675: 
 4676:       if (elem->isDry) return;
 4677: 
 4678:       const int kb  = elem->kb;
 4679:       const int i34 = elem->i34;
 4680: 
 4681:       for (int k = kb + 1; k < nvrt; k++) {
 4682:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4683:          //             gradRho.r1 = rho1 - rho0
 4684:          //             gradRho.r2 = rho2 - rho0
 4685:          int icount = 0;
 4686:          double sumRx = 0.0;
 4687:          double sumRy = 0.0;
 4688:          for (int j1=0; j1<i34; j1++) { 
 4689: 
 4690:             const int j2 = elem->nxq(j1 + 1);
 4691: 
 4692:             // Pairs of consecutive neighbor elements of elem
 4693:             const Element *e1 = elem->nghbElems[j1];
 4694:             const Element *e2 = elem->nghbElems[j2];
 4695: 
 4696:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4697:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4698:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4699: 
 4700:             // Compute the density difference and the vector from elem to e1 and e2
 4701:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4702:             double diffRho1, diffRho2;
 4703:             Vector2 vec1, vec2;
 4704:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4705:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4706: 
 4707:             const double rl1 = length(vec1);
 4708:             const double rl2 = length(vec2);
 4709:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4710: 
 4711:             const double delta = cross(vec1, vec2);
 4712:             const double sintheta = abs(delta)/(rl1*rl2);
 4713: 
 4714:             // To avoid problems, avoid elements with small angle between vectors
 4715:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4716:             const bool validEq = (sintheta > sin_one_deg);
 4717: 
 4718:             if (validEq) {
 4719:                // Solve the system of equations to get the density gradient at elem
 4720:                icount++;
 4721:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4722:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4723:                sumRx += Rx;
 4724:                sumRy += Ry;
 4725:             }
 4726:          } // for j1
 4727: 
 4728:          // Compute the average density gradient at elem
 4729:          if (icount==0) {
 4730:            // Bad mesh quality; bail out with 0 b-cc
 4731:            elem->gradRho[k] = {0.0, 0.0};
 4732:          } else {
 4733:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4734:          }
 4735: 
 4736:       } // for k
 4737: 
 4738:    }
 4739: 
 4740:    __global__ void computeBaroclinicTerm(void) {
 4741:    // Computes the baroclinic term at sides (at half levels).
 4742:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4743:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4744: 
 4745:       SIDE(side);
 4746: 
 4747:       if (side->isDry) return;
 4748: 
 4749:       const Element *e1 = side->elems[0];
 4750:       const Element *e2 = side->elems[1];      
 4751:       const int kb = side->kb;
 4752:       
 4753:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4754: 
 4755:       // interpolates vertically the density gradient of the two elements at the half level/
 4756: 
 4757:       // Starts the integration at the surface and goes down to the bottom
 4758:       int k1 = nvrt - 1;
 4759:       int k2 = nvrt - 1;
 4760: 
 4761:       side->bcc[nvrt-1] = {0.0, 0.0};
 4762:       for (int k = nvrt-2; k >= kb; k--) {
 4763:       // For each prism level (from surface to bottom)...
 4764: 
 4765:          // For both elements, interpolate density gradient at the side's half level.
 4766:          // The gradient at the side is the average of the gradients at the elements.
 4767:          // w1, w2 are used to take into account boundary sides, with just one element.
 4768:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4769:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4770:          const double wsum = w1 + w2;
 4771:          w1 = w1/wsum;
 4772:          w2 = w2/wsum;
 4773:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4774: 
 4775:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4776:          Vector2 gradRho = {0.0, 0.0};
 4777:          if (e1 != nullptr && k > kb) {
 4778:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4779:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4780:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4781:             
 4782:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4783:          }      
 4784:          if (e2 != nullptr && k > kb) {
 4785:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4786:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4787:             
 4788:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4789:          }
 4790: 
 4791:          if constexpr(ics==2) {
 4792:             // IMPLEMENT THIS XXXXXX
 4793:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4794:             // swild(1)=tmp1
 4795:             // swild(2)=tmp2
 4796:          }
 4797:          
 4798:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4799:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4800:          // CHECK INDICES!!! XXX
 4801:          const double grav3 = side->grav3();
 4802:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4803: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4804: 
 4805:       } // for
 4806: 
 4807:    }
 4808: 
 4809: 
 4810: 
 4811:    __global__ void computeHorGradientAtSide(void) {
 4812: 
 4813:       // Compute the horizontal density gradient at each element.
 4814:       // It works in two steps:
 4815:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4816:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4817:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4818:       //             gradRho.r1 = rho1 - rho0
 4819:       //             gradRho.r2 = rho2 - rho0
 4820:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4821:       // 
 4822:       //  NOTE: We use de-meaned densities.
 4823: 
 4824:       SIDE(side);
 4825: 
 4826:       if (side->isDry) return;
 4827: 
 4828:       // Computes the gradient of the variables at the side center.
 4829:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4830:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4831:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4832: 
 4833:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4834:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4835:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4836:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4837: 
 4838: 
 4839:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4840:          side->gradEta1.x, side->gradEta1.y, 
 4841:          side->gradEta2.x, side->gradEta2.y, 
 4842:          side->gradETP.x, side->gradETP.y, 
 4843:          side->gradPr.x, side->gradPr.y);
 4844: 
 4845: 
 4846:    }
 4847: 
 4848: 
 4849:    __global__ void solveMomentumEquations(double time) {
 4850: 
 4851:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4852:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4853: 
 4854:       SIDE(side);
 4855: 
 4856:       if (side->isDry) 
 4857:       {
 4858:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4859: 
 4860:          return;
 4861:       }
 4862: 
 4863:       const Node *n1 = side->n1;
 4864:       const Node *n2 = side->n2;
 4865: 
 4866:       const int kb = side->kb;
 4867: 
 4868:       const double veg_h = side->veg_h();
 4869:       const double grav3 = side->grav3();
 4870: 
 4871: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4872:       if (side->is2D()) {
 4873:          // Warning: Do not use htot2, which is updated.
 4874:          const double htot = side->htot1();
 4875:          const double hhat = side->hhat;
 4876: 
 4877:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4878: 
 4879:          Vector2 tau2 = {0.0, 0.0};
 4880:           
 4881:          if constexpr(ics==1) {
 4882:             tau2 = side->tau();
 4883: 
 4884:          } else {
 4885:             assert(false && "Not implemented: ics == 2");
 4886:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4887:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4888:             // taux2=(vn1+tt1)*0.5d0
 4889:             // tauy2=(vn2+ss1)*0.5d0
 4890:          } // if ics         
 4891: 
 4892:          // hat_gam has units of m/s
 4893: 
 4894:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4895: 
 4896:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4897:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 - thetai*side->gradEta2));
 4898: 
 4899:          hat_gam += dt*side->d2uv[nvrt-1];  // XXXX compute d2uv
 4900: 
 4901:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvel1, rmaxvel1);
 4902:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvel2, rmaxvel2);
 4903: 
 4904:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4905: 
 4906: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y);
 4907: 
 4908:       }
 4909:       else { // 3D
 4910: 
 4911:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4912:          // 
 4913:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4914:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4915:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4916:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4917:          // k+1 and k.
 4918: 
 4919: 
 4920:          // // Define layer thickness & viscosity
 4921:          // for (int k=kb + 1; k<nvrt; k++) {
 4922:          //    const double dzz = side->Dz(k - 1);
 4923: 
 4924:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4925: 
 4926:          //    // Vertical viscosity at the face center
 4927:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4928:         
 4929:          // }
 4930: 
 4931: 
 4932:          const int ndim = nvrt - kb;
 4933:          const double zTopCanopy = side->zTopCanopy();
 4934: 
 4935:          // Initialize the tridiagonal system
 4936:          for (int k = kb + 1; k<nvrt; k++) {
 4937:             
 4938:             const int kin = k - kb;
 4939: 
 4940:             // Vertical viscosity at the face center
 4941:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4942:             const double dzz = side->Dz(k);
 4943: 
 4944:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 4945:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 4946:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4947: 
 4948:             alow[kin] = 0.0;
 4949:             cupp[kin] = 0.0;
 4950:             bdia[kin] = 0.0;
 4951: 
 4952:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4953:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4954: 
 4955:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4956:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4957:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4958: 
 4959:             // First part: layers k, k+1
 4960:             if (k < nvrt - 1) {
 4961:                              
 4962:                if constexpr(iveg != 0) {
 4963: 
 4964:                   // If there is vegetation at this level...
 4965:                   if (zTopCanopy > side->zc[k]) {
 4966:                      // If the canopy is above the k layer...
 4967:                      
 4968:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4969:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4970:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4971:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4972: 
 4973:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4974:                      const double vmag2 = length(ut2);
 4975:                      const double vmag1 = length(side->u2[k]);
 4976:                      const double vmag = 0.5*(vmag1 + vmag2);
 4977:                      
 4978:                      // Computes the vegetation alpha at the face center
 4979:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4980: 
 4981:                      cff1 += veg_alpha_sd*dt*vmag;
 4982: 
 4983:                   } // if (zTopCanopy
 4984:                } // if iveg
 4985: 
 4986:                const double tmp = dt*dfz/dzz;
 4987:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4988:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4989: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 4990:             }
 4991: 
 4992: 
 4993:             // Second part: layers k-1, k
 4994:             if (k > kb + 1) {
 4995: 
 4996:                double cff1 = 1.0; //init \bar{c^k}
 4997: 
 4998:                if constexpr(iveg != 0) {
 4999:                   // If there is vegetation at this level...
 5000:                   if (zTopCanopy > side->zc[k-1]) {
 5001:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5002:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5003: 
 5004:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5005: 
 5006:                      const double vmag2 = length(ut2);
 5007:                      const double vmag1 = length(side->u2[k-1]);
 5008:                      const double vmag = 0.5*(vmag1 + vmag2);
 5009: 
 5010:                      // Computes the vegetation alpha at the face center
 5011:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5012:                      cff1 += veg_alpha_sd*dt*vmag;
 5013:                   } // if zTopCanopy
 5014: 
 5015:                } // if iveg
 5016: 
 5017:                const double tmp = dt*dfz/dzz;
 5018:                alow[kin] += cff1*dzz/6.0 - tmp;
 5019:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5020: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5021:             } else { // Bottom boundary
 5022:                // This occurs at the bottom, where the bottom drag is applied.
 5023: 
 5024:                bdia[kin] += dt*side->chi2;
 5025: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5026:             } // if (k > kb + 1)
 5027: 
 5028: 
 5029: 
 5030:          } // for (int k
 5031: 
 5032: 
 5033: 
 5034:          // Computes the RHS.
 5035:          // -----------------
 5036: 
 5037:          //	BC to be imposed at the end.
 5038: 
 5039:          const Vector2 gradETP  = side->gradETP;
 5040:          const Vector2 gradPr   = side->gradPr;
 5041:          const Vector2 gradEta1 = side->gradEta1;
 5042:          const Vector2 gradEta2 = side->gradEta2;
 5043: 
 5044:          const Vector2 *btu = side->btu;
 5045:          const Vector2 *u2  = side->u2;
 5046:          const double coriolis = side->coriolis;
 5047:          const Vector2 *d2uv = side->d2uv;
 5048: 
 5049: 
 5050:          for (int k = kb + 1; k<nvrt; k++) {
 5051:             const int kin = k - kb;
 5052: 
 5053:             const double dz_0 = side->Dz(k);
 5054:             const double dz_1 = side->Dz(k+1);  
 5055: 
 5056:             rrhs[kin] = {0.0, 0.0};
 5057:             double dz = 0.0;
 5058: 
 5059:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5060:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5061:             if (k < nvrt  ) dz += 0.5*dz_1;
 5062:             if (k > kb + 1) dz += 0.5*dz_0;
 5063: 
 5064:             // Elevation gradient, atmospheric pressure and tidal potential
 5065:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5066: 
 5067:             // Coriolis, advection, wind stress, and horizontal viscosity
 5068:             if (k < nvrt - 1) {
 5069: 
 5070: 
 5071:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5072:                                           (dt*coriolis)*rot90(2.0*u2[k] + u2[k + 1]) + 
 5073:                                           dt*(2.0*d2uv[k] + d2uv[k + 1]));
 5074: 
 5075:                //diff stress tensors 1006
 5076:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5077:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5078:                   assert(false && "Not implemented: itur == 5");
 5079:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5080:                }
 5081: 
 5082:             } else { // k=nvrt
 5083:                Vector2 tau2 = {0.0, 0.0};
 5084:                if constexpr(ics==1) {
 5085:                   tau2 = side->tau();
 5086:                } else {
 5087:                   assert(false && "Not implemented: ics == 2");
 5088:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5089:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5090:                   // taux2=(vn1+tt1)*0.5d0
 5091:                   // tauy2=(vn2+ss1)*0.5d0
 5092:                } // if ics
 5093: 
 5094:                rrhs[kin] += dt*tau2;
 5095: 
 5096:             } // if k<nvrt
 5097: 
 5098:             if (k > kb + 1) {
 5099:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5100:                                        (dt*coriolis)*rot90(2.0*u2[k] + u2[k - 1]) + 
 5101:                                        dt*(2.0*d2uv[k] + d2uv[k - 1]));
 5102: 
 5103: 
 5104:                // diff stress tensors 1006
 5105:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5106:                   assert(false && "Not implemented: itur == 5");
 5107:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5108:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5109:                }
 5110: 
 5111:             } // if k>kbs + 1
 5112: 
 5113:             // Baroclinic
 5114:             Vector2 *bcc = side->bcc;
 5115:             if constexpr(ibc == 0) {
 5116:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5117:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5118: 
 5119:             } // if ibc==0
 5120: 
 5121: 
 5122:          } // k=kb + 1,nvrt
 5123: 
 5124:    printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5125:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5126:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5127: 
 5128:          for (int k=kb + 1; k<nvrt; k++) {
 5129:             const int kin = k - kb;
 5130: 
 5131:             // Velocity is always clamped to maximum values
 5132:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvel1, rmaxvel1), clamp(soln[kin].y, -rmaxvel2, rmaxvel2));
 5133:          } // k
 5134: 
 5135:       } // if side->is2D()
 5136:       
 5137: 
 5138:       // Impose velocity boundary conditions at the bottom
 5139:       if constexpr(imm == 2) { // 3D bed deformation model
 5140:          double dep;
 5141:          Vector2 vel;
 5142: 
 5143:          assert(false && "Not implemented: imm == 2");
 5144:          //update_bdef(time, x0, y0, dep, vel);
 5145:          // side->u2[kb] = vel;
 5146: 
 5147:       } else { // imm = 0 or 1
 5148:          if (side->Cd() == 0.0) {
 5149:             side->u2[kb] = side->u2[kb + 1];
 5150:          } else if (nvrt > kb + 1) { // 3D no slip bottom
 5151:             side->u2[kb] = {0.0, 0.0};
 5152:          }
 5153:           
 5154:       } // if imm
 5155: 
 5156:       // XXX aren't we undoing what was done here: for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 5157:       for (int k=0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5158:       
 5159: 
 5160:    }
 5161: 
 5162: 
 5163:    __device__ void applyMomentumBC(void) {
 5164: 
 5165:       SIDE_BND(sideBnd);
 5166: 
 5167:       Side *side = sideBnd->side;
 5168:       const BoundarySegment *segment = sideBnd->segment;
 5169:       const Node *n1 = side->n1;
 5170:       const Node *n2 = side->n2;
 5171: 
 5172:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5173:       const bool isLand     = (segment == (BoundarySegment *)landSegment);
 5174:       const bool isInternal = (segment == (BoundarySegment *)internalSegment);
 5175: 
 5176:       assert(!isInternal && "applyMomentumBC: Shouldn't be an internal side");
 5177:       const int kb = side->kb;
 5178: 
 5179:       if (!isLand && segment->ifltype != 0) {
 5180:          const Vector2 *ubc = sideBnd->ubc;
 5181: 
 5182:          for (int k=kb; k < nvrt; k++) {
 5183:             
 5184:             assert(segment->ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5185:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5186: 
 5187:             if (segment->ifltype == -1) {
 5188:                // Flather 1
 5189: 
 5190:                const double depth = side->depth();
 5191: 
 5192:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5193: 
 5194:                const double vnorm = sqrt(grav/depth)*(side->eta2() - side->etaMeanBnd()) + dot(ubc[k], side->n);
 5195: 
 5196:                side->u2[k] = vnorm*side->n;
 5197: 
 5198:             } else if (segment->ifltype == -2) { // Discharge
 5199: 
 5200: 
 5201:                const double eta1 = side->eta1();
 5202:                const double eta2 = side->eta2();
 5203:                const double htot = side->htot2();
 5204: 
 5205:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5206:                assert(false && "Not implemented: Discharge bc");
 5207:                // const double dischrg = discharge(eta1);
 5208:                const double dischrg = 0.0; // XXX REMOVE
 5209:                
 5210: 
 5211:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5212: 
 5213:                const double vnorm = dischrg*eta2/htot;
 5214: 
 5215:                side->u2[k] = vnorm*side->n;
 5216: 
 5217: 
 5218:             }
 5219:             else if (segment->ifltype == -4 || segment->ifltype == -5) { // 3D radiation
 5220:                const double vnorm = dot(side->u2[k], side->n);
 5221: 
 5222:                double rat;
 5223:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5224:                else              rat = segment->vobc2; // outgoing
 5225: 
 5226:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5227:             }
 5228:             else { // not Flather or 3D radiation
 5229:                side->u2[k] = ubc[k];
 5230: 
 5231:             } // if (segment->ifltype...
 5232: 
 5233:          }
 5234: 
 5235:       }
 5236:       else if (isLand) { // land bnd
 5237:          if constexpr(islip == 0) { // free slip
 5238:             for (int k=kb; k < nvrt; k++) {
 5239:                double vnorm = 0.0; // for most cases
 5240:                const double vtan = dot(side->u2[k], side->t());
 5241:                side->u2[k] = vtan*side->t() - vnorm*side->n;
 5242:             }
 5243: 
 5244:          } else { // no slip
 5245:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5246: 
 5247:          }
 5248:       } // if (side segment type...
 5249: 
 5250:       
 5251: 
 5252: 
 5253: 
 5254:    }
 5255: 
 5256: 
 5257:    __device__ void shapiroFilter1(void) {
 5258:       // First step of the Shapiro filter (normally used if indvel<=0)
 5259:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5260: 
 5261:       if constexpr(ishapiro == 0) return;
 5262: 
 5263:       SIDE(side);
 5264: 
 5265:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5266: 
 5267:       if (side->isDry || isInternal ) return;
 5268: 
 5269:       const int kb = side->kb;
 5270: 
 5271:       for (int mm = 1; mm <= niter_shap; mm++) {
 5272: 
 5273: 
 5274:          // Internal wet sides
 5275:          for (int k = kb + 1; k < nvrt; k++) {
 5276:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5277:             side->bcc[k] = {0.0, 0.0};
 5278:             Vector2 suru = {0.0, 0.0};
 5279: 
 5280:             for (int j=0; j<4; j++) {
 5281: 
 5282:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5283:                
 5284:                int kin = k;
 5285:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5286:                
 5287:                if constexpr(ics==1) {
 5288:                   suru += side->u2[kin];
 5289:                } else {
 5290:                   assert(false && "Not implemented: ics == 2");
 5291:                   // Vector2 vn1, vn2;
 5292:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5293:                   // suru=suru+vn1;
 5294:                   // surv=surv+vn2;
 5295:                }
 5296:             }
 5297: 
 5298:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5299: 
 5300:          }
 5301:       }
 5302:    }
 5303: 
 5304:    __device__ void shapiroFilter2(void) {
 5305:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5306: 
 5307:       if constexpr(ishapiro == 0) return;
 5308: 
 5309:       SIDE(side);
 5310: 
 5311:       const bool isInternal = (side->sideBnd->segment == (BoundarySegment *)internalSegment);
 5312: 
 5313:       if (side->isDry || isInternal ) return;
 5314: 
 5315:       const int kb = side->kb;
 5316: 
 5317:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5318: 
 5319:       if (side->is2D()) {
 5320:          side->u2[kb] = side->u2[nvrt - 1];
 5321:          
 5322:       } else {
 5323:          // 3D
 5324:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5325:          
 5326:       }
 5327: 
 5328:    }
 5329: 
 5330: 
 5331:    __global__ void ul0UpdateZCoords(void) {
 5332:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5333:       
 5334:       NODE(node);      
 5335: 
 5336:       if (node->isDry2()) { 
 5337: 
 5338:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5339: 
 5340:          if constexpr(ivcor != 1) node->kb = 0;
 5341: 
 5342:       } else {
 5343: 
 5344:          node->updateKb();
 5345:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5346: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5347: 
 5348:       } // if wet or dry
 5349: 
 5350:       // We use the temp.b field to store the previous state of isDry.
 5351:       node->tmp.b = node->isDry;
 5352: 
 5353:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5354:       node->isDry = true;
 5355: 
 5356:    }
 5357: 
 5358:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5359:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5360:    {
 5361:       ELEM(elem);
 5362: 
 5363:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5364: 
 5365:       // All the nodes of a wet element are wet.
 5366:       if (!elem->isDry) {
 5367:          elem->nodes[0]->isDry = false;
 5368:          elem->nodes[1]->isDry = false;
 5369:          elem->nodes[2]->isDry = false;
 5370:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5371: 
 5372:       }
 5373: 
 5374: 
 5375:       elem->kb = 0;
 5376: 
 5377:       if (elem->isDry) return;
 5378: 
 5379:       // Wet
 5380:       const Node *n1 = elem->nodes[0];
 5381:       const Node *n2 = elem->nodes[1];
 5382:       const Node *n3 = elem->nodes[2];  
 5383:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5384: 
 5385:    //    if(elem->isDry2()) {
 5386:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5387:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5388:    //        call parallel_abort(errmsg)
 5389:    //    }
 5390: 
 5391: 
 5392:       // Computes element's kb as the minimum of the nodes' kb.
 5393:       const int kb1 = n1->kb;
 5394:       const int kb2 = n2->kb;
 5395:       const int kb3 = n3->kb;
 5396:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5397: 
 5398: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5399: 
 5400:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5401: 
 5402: 
 5403:       // Computes the element z as the mean of the nodes z.
 5404:       for (int k = elem->kb; k < nvrt; k++) {
 5405: 
 5406:          // Compute the element z as the mean of the nodes z.
 5407:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5408:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5409:          elem->z[k] /= elem->i34;
 5410: 
 5411:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5412:       }
 5413:                   
 5414:    }
 5415: 
 5416:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5417:    {
 5418:       NODE(node);
 5419:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5420: 
 5421:       if (it == iths) return;
 5422: 
 5423: 
 5424:       if(!node->isDry && node->tmp.b) { // rewetted
 5425:          for (int k=0; k < nvrt; k++) {
 5426: 
 5427:             Vector3 utmp={0.0, 0.0, 0.0};
 5428: 
 5429:             double ttmp=0.0;
 5430:             double stmp=0.0;
 5431:             int icount=0;
 5432:             for (int j = 0; j < node->numNodes; j++) {
 5433: 
 5434: 
 5435:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5436:                if (!node->isDry) { // all indices extended
 5437:                   icount++;
 5438: 
 5439:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5440:                   utmp += node->u2[k];
 5441:                   
 5442:                   ttmp += node->tracers[k].tracer[0]; 
 5443:                   stmp += node->tracers[k].tracer[1]; 
 5444:                }
 5445:             }
 5446: 
 5447:             if(icount > 0) {
 5448:                const double inv_icount = 1.0/icount;
 5449:                node->u2[k]     = inv_icount*utmp;
 5450:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5451:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5452:             }
 5453:          }
 5454:       }
 5455:    }
 5456: 
 5457: 
 5458:    __global__ void ul0UpdateSides(int it, int iths) {
 5459: 
 5460:       SIDE(side);
 5461: 
 5462:       // A side is wet if and only if at least one of its elements is wet.
 5463:       const bool isWet = !side->elems[0]->isDry || (!side->isBnd2() && !side->elems[1]->isDry);
 5464: 
 5465:       const Node *n1 = side->n1;
 5466:       const Node *n2 = side->n2;
 5467:       const int kb1 = n1->kb;
 5468:       const int kb2 = n2->kb;
 5469: 
 5470:       side->kb = 0; // dry
 5471: 
 5472:       if (isWet) {
 5473: 
 5474:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5475: 
 5476:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5477: 
 5478:          side->kb = min(kb1, kb2);
 5479: 
 5480:          for (int k = side->kb; k < nvrt; k++) {
 5481:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5482: 
 5483:          
 5484:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5485: 
 5486:             // Compute velocity for re-wetted sides 
 5487:             if ((it != iths) && (side->isDry && isWet)) {
 5488:             
 5489:                Vector2 utmp={0.0, 0.0};
 5490: 
 5491:                int icount=0;
 5492: 
 5493:                // For all the sides on the two elements that share this side
 5494:                for (int j=0; j < 2; j++) {
 5495:                   const Element *elem = side->elems[j];
 5496:                   if (elem == nullptr) continue;
 5497: 
 5498:                   for (int jj=0; jj < elem->i34; jj++) {
 5499:                      const Side *nSide = elem->sides[jj];
 5500:                      if (nSide->isDry) continue;
 5501: 
 5502:                      icount++;
 5503:                      utmp += nSide->u2[k];                     
 5504:                   }
 5505:                }
 5506:                   
 5507:                assert(icount > 0 && "No wet sides around this side");
 5508:                if (icount > 0)  side->u2[k] = utmp/icount;
 5509:                   
 5510:             } // if ((it != iths) && (side->isDry && isWet))
 5511: 
 5512:          } // for k
 5513: 
 5514:       } // if isWet
 5515:    
 5516:       side->isDry = !isWet;
 5517: 
 5518:    }
 5519: 
 5520: 
 5521:    __global__ void zeroNodalVelocities(void) {
 5522:       NODE(node);
 5523: 
 5524:       for (int k = 0; k < nvrt; k++) {
 5525:          node->u2[k] = {0.0, 0.0, 0.0};
 5526:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5527:       }
 5528:    }
 5529: 
 5530:    __global__ void computeNodalVerticalVelocities1(void) {
 5531:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5532:    // Adds the element's vertical velocity times the element's area.
 5533:       ELEM(elem);
 5534: 
 5535:       for (int j = 0; j < elem->i34; j++) {
 5536:          Node *node = elem->nodes[j];
 5537: 
 5538:          for (int k = node->kb; k < nvrt; k++) {
 5539:             node->u2[k].z += elem->w[k]*elem->area;
 5540:             node->tmp.d += elem->area;
 5541:          }
 5542:       }
 5543:    }
 5544: 
 5545:    __global__ void computeNodalVerticalVelocities2(void) {
 5546:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5547:    // Divides by the total area of the elements sharing the    node.
 5548:       ELEM(elem);
 5549: 
 5550:       for (int j = 0; j < elem->i34; j++) {
 5551:          Node *node = elem->nodes[j];
 5552: 
 5553:          for (int k = node->kb; k < nvrt; k++) node->u2[k].z /= node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5554:       }
 5555:    }
 5556: 
 5557:    __global__ void computeNodalHorizontalVelocities(void) {
 5558:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5559:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5560:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5561: 
 5562:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5563: 
 5564:       SIDE(side);
 5565: 
 5566:       const int kb = side->kb;
 5567: 
 5568:       Node *n1 = side->n1;
 5569:       Node *n2 = side->n2;
 5570: 
 5571:       for (int k = kb; k < nvrt; k++) {
 5572: 
 5573:          // Cast the u2 vector into a Vector2 
 5574:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5575:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5576: 
 5577:          n1_u2 += side->u2[k]/n1->numSides;
 5578:          n2_u2 += side->u2[k]/n2->numSides;
 5579: 
 5580:       }
 5581: 
 5582: 
 5583:    }
 5584: 
 5585:    __global__ void resetVelocityOpenBndNodes(void) {
 5586:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5587: 
 5588:       NODE_BND(nodebnd);
 5589: 
 5590:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5591:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5592:       }
 5593: 
 5594:    }
 5595: 
 5596: 
 5597:    __global__ void setVelocityOpenBndNodes(void) {
 5598:    // For open boundary nodes sets their velocity to the imposed values.
 5599: 
 5600:       SIDE_BND(sidebnd);
 5601: 
 5602:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5603:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5604:          // to its segment to the average of the side velocity.
 5605: 
 5606:          for (int k = 0; k < nvrt; k++) {
 5607:             Node *n1 = sidebnd->side->n1;
 5608:             Node *n2 = sidebnd->side->n2;
 5609: 
 5610:             // Cast the u2 vector into a Vector2 
 5611:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5612:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5613: 
 5614:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5615:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5616:          }
 5617:       }
 5618: 
 5619:    }
 5620: 
 5621: 
 5622:    __global__ void computeVerticalVelocity(void) {
 5623:       // Computes the vertical velocity at the (2D) element's centroid.
 5624:       // In this function we will be considering volumetric elements, with side faces and a 
 5625:       // bottom and a top face. We will call them SFs, BF and TF.
 5626:       // It computes the flux coming from BF and the SFs.
 5627:       // If the bed is moving, it takes that into account.
 5628:       // Since water is incompressible, the integral of the velocity times the normal vector
 5629:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 5630:       // and the BF is equal to the flux going out from the TF.
 5631:       // TF = - BF - sum(SFs).
 5632:       // It then computes the horizontal velocity at the center of TF.
 5633:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 5634:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 5635:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 5636: 
 5637:       ELEM(elem);
 5638: 
 5639:       if (elem->isDry) return;
 5640: 
 5641:       const int kb = elem->kb;
 5642:       const bool isTri = elem->isTri();
 5643: 
 5644:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 5645: 
 5646:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 5647:       const double av_bdef1 = elem->mean(&Node::bdef1);
 5648:       const double av_bdef2 = elem->mean(&Node::bdef2);
 5649: 
 5650:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 5651: 
 5652:       double area3D;
 5653: 
 5654:       // Bottom face flux
 5655:       double bottomFlux = 0.0;
 5656:       Vector2 u2meanBottom = {0.0, 0.0};
 5657:       const Vector2 gradh = elem->grad2(&Node::depth);
 5658:       if constexpr(imm==2) {
 5659:          Vector3 ubed;
 5660: 
 5661:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5662:          // updateBDEF(ubed);
 5663:      
 5664:          // const double bflux0 = dot(ubed, elem_n1);
 5665: 
 5666:          // elem->w[kb] += ubed.z;
 5667:       }
 5668:       else {
 5669:          Vector2 umean;
 5670:          if constexpr(ics == 1) {
 5671:             u2meanBottom = elem->mean(kb, &Side::u2);
 5672:          }
 5673:          else {
 5674:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 5675:          }
 5676: 
 5677:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 5678:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 5679: 
 5680:          bottomFlux = - dot(gradh, u2meanBottom);
 5681:       } // if imm
 5682: 
 5683:       // Compute w for kb+1 to nvrt-1
 5684:       for (int l = kb; l < nvrt - 1; l++) {
 5685: 
 5686:          // normal vector to the top face of the "volumetric" element (3D)
 5687:          Vector3 elem_n2 = elem->n(l + 1, area3D); 
 5688: 
 5689:          // Compute the total flux at the sides
 5690:          double sideFlux = 0.0;
 5691:          Vector2 u2top = {0.0, 0.0};
 5692:          for (int j = 0; j < elem->i34; j++) {
 5693:             const Side *side = elem->sides[j];
 5694: 
 5695:             const double sideArea = side->area(l + 1);
 5696:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 5697:             const double sign = elem->ssign[j]; 
 5698: 
 5699:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 5700:          }
 5701:          
 5702:          // Compute the horizontal velocity at the center of the top face as an average of the 
 5703:          //velocities at the centers of the sides
 5704:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 5705: 
 5706:          // The flx at the top ace can be computed from the other flows.
 5707:          const double topFlux = - sideFlux - bottomFlux;
 5708:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 5709: 
 5710:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 5711: printf("sideFlux = %f, topHorizontalFlux = %f, bottomFlux = %f, area3D = %f, elem->w[%d] = %.16f, elem_n2.z = %f\n", sideFlux, topHorizontalFlux, bottomFlux, area3D, l + 1, elem->w[l + 1], elem_n2.z);
 5712:          elem_n1 = elem_n2;
 5713: 
 5714:          bottomFlux = - topFlux;
 5715:       }
 5716:    }  
 5717: 
 5718: 
 5719: 
 5720: 
 5721: 
