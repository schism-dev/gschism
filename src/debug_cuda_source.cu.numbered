 8012: 
 8013: __global__ void computeMatrixProductAndDotProducts() {
 8014:    // Computes A*p, r'Mr and p'Ap
 8015: 
 8016:    // 1) shared buffer: first half for rMr, second for pAp
 8017:    __shared__ double sdata[2*BLOCK_SIZE];
 8018:    double* s_rMr = sdata;
 8019:    double* s_pAp = sdata + BLOCK_SIZE;
 8020: 
 8021:    const int tid = threadIdx.x;
 8022: 
 8023:    double l_pAp = 0.0;
 8024: 
 8025:    s_rMr[tid] = 0.0;
 8026:    s_pAp[tid] = 0.0;
 8027: 
 8028:    // 2) get your node pointer
 8029:    // NODE(node);   
 8030:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8031:    Node *node = &(mesh->localNodeData[idx_node]); 
 8032:    if (idx_node < mesh->np) {
 8033: 
 8034: 
 8035:    const double diag = node->coeffDiag;
 8036:    const double r    = node->mR;
 8037:    const double p    = node->mP;  
 8038: 
 8039:    // apply preconditioner on the fly:
 8040:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8041: 
 8042:    // 4) compute Ap = A.p
 8043:    double Ap = node->coeffDiag * node->mP;
 8044:    for (int j = 0; j < node->numNodes; ++j) {
 8045:       const Node *nbNode = node->nodes[j];
 8046:       Ap += node->coeffMatrix[j] * nbNode->mP;
 8047: 
 8048:    }
 8049: 
 8050:    node->mAp = Ap;
 8051:     
 8052: 
 8053:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 8054:    // const double l_rMr = r*Mr;  // r'Mr
 8055:    l_pAp = p*Ap;  // p'Ap
 8056: 
 8057: 
 8058:    }
 8059: 
 8060:    // 6) write into shared mem
 8061:    // s_rMr[tid] = l_rMr;
 8062:    s_pAp[tid] = l_pAp;
 8063: 
 8064:    __syncthreads();
 8065: 
 8066:    // 7) block-wide tree reduction
 8067:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8068:       if (tid < stride)  {
 8069:          s_pAp[tid] += s_pAp[tid + stride];
 8070:       }
 8071:       __syncthreads();
 8072:    }
 8073: 
 8074:    // 8) thread 0 atomically accumulates into the globals
 8075:    // XXX: This is slower than it needs to be, but it is simple and works
 8076:    if (tid == 0) {
 8077:       atomicAdd(pAp, s_pAp[0]);
 8078:    }
 8079: 
 8080: 
 8081: }
 8082: 
 8083: 
 8084: __global__ void updateSolutionAndDotProducts(void) {
 8085:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8086: 
 8087:    const int tid = threadIdx.x;
 8088: 
 8089:    s_rMr[tid] = 0.0;
 8090: 
 8091:    // get node & bounds-check:
 8092:    NODE(node);
 8093: 
 8094:    
 8095:    // Compute alpha
 8096:    const double alpha = (*rMr_old)/(*pAp);
 8097: 
 8098:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8099: 
 8100: 
 8101:    // load scalars
 8102:    const double diag = node->coeffDiag;
 8103:    const double p    = node->mP;
 8104:    const double Ap   = node->mAp;
 8105:    const double x    = node->mX;
 8106:    const double r    = node->mR;
 8107:    
 8108:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8109: 
 8110:    // 1) update solution & residual
 8111:    const double x_new = x + alpha*p;
 8112:    const double r_new = r - alpha*Ap;
 8113:    node->mX = x_new;
 8114:    node->mR = r_new;
 8115: 
 8116:    // 2) apply Jacobi preconditioner on the fly
 8117:    const double Mr_new = r_new/diag;
 8118: 
 8119: 
 8120:    // 3) local contributions for the two dot-products
 8121:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8122: 
 8123:    // 4) write into shared-mem
 8124:    s_rMr[tid] = l_rMr;
 8125: 
 8126:    __syncthreads();
 8127: 
 8128: 
 8129:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8130:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8131:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8132:       __syncthreads();
 8133:    }
 8134: 
 8135:    // 6) thread 0 atomically folds into the global accumulators
 8136:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8137: 
 8138: 
 8139: }
 8140: 
 8141: 
 8142: __global__ void updateSearchDirection() {
 8143: 
 8144:     NODE(node);
 8145: 
 8146:     // recompute z on-the-fly
 8147:     const double z = node->mR / node->coeffDiag;
 8148:     const double p = node->mP;
 8149: 
 8150:     const double beta = (*rMr_new)/(*rMr_old);
 8151: 
 8152: 
 8153:     // p =z + beta*p
 8154:     node->mP = z + beta*p;
 8155: 
 8156: }
 8157: 
 8158: __global__ void initializeScalars(double *scalars) {
 8159: 
 8160:    // These point to a cupy array in the host code
 8161:    rMr_old = scalars + 0;
 8162:    rMr_new = scalars + 1;
 8163:    pAp     = scalars + 2;
 8164: }
 8165: 
 8166: __global__ void initializePreconditionedResidual(void) {
 8167: 
 8168:     __shared__ double s_rMr[BLOCK_SIZE];  
 8169: 
 8170:     s_rMr[threadIdx.x] = 0.0;
 8171: 
 8172:     NODE_ALL(node, valid);
 8173:     const int tid = threadIdx.x;
 8174:     // For the first iteration:
 8175:     // 1. Initial solution x = 0 (already set)
 8176:     // 2. Initial residual r = b (stored in qel)
 8177:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8178: 
 8179: // XXX we should use the guess solution here    
 8180: 
 8181:     double l_rMr = 0.0;
 8182:     if (valid) {
 8183:       // Set initial residual r = b (from qel)
 8184:       node->mR = node->qel;
 8185: 
 8186:       // Compute z = M^-1 * r (preconditioned residual)
 8187:       const double z = node->mR / node->coeffDiag;
 8188: 
 8189:       // Set initial search direction p = z
 8190:       node->mP = z;
 8191: 
 8192:       // Initialize other variables needed for CG
 8193:       node->mX = 0.0;  // Initial solution
 8194:       node->mAp = 0.0; // Will be computed in first iteration
 8195: 
 8196: 
 8197:       // Computes the first r'Mr (reduction)
 8198:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8199:     }
 8200:     // 4) write into shared-mem
 8201:     s_rMr[tid] = l_rMr;
 8202: 
 8203:     __syncthreads();
 8204: 
 8205: 
 8206:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8207:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8208:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8209:         __syncthreads();
 8210:     }
 8211: 
 8212:     // 6) thread 0 atomically folds into the global accumulators
 8213:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8214: 
 8215:     *rMr_old = 0.0;
 8216:     *pAp = 0.0;
 8217: }
 8218: 
 8219: 
 8220: 
 8221: 
 8222: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 8223:    // Get the value of a variable from an element
 8224:    // varName is the name of the variable to get
 8225:    // var is the array to store the value
 8226:    // k is the vertical level index of the variable to get
 8227: 
 8228:    ELEM(elem);
 8229:    
 8230:    int idx = elem->idx;
 8231:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8232: 
 8233:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8234:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 8235:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 8236:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 8237:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 8238:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 8239:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 8240:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 8241:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 8242:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 8243:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 8244:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 8245:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 8246:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 8247:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8248:       
 8249:    
 8250: }
 8251: 
 8252: 
 8253: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8254:    // Get the value of a variable from an node
 8255:    // varName is the name of the variable to get
 8256:    // var is the array to store the value
 8257:    // k is the vertical level index of the variable to get
 8258: 
 8259:    NODE(node);
 8260:    
 8261:    int idx = node->idx;
 8262:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8263: 
 8264:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8265:    
 8266:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8267:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8268:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 8269:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8270:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8271:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8272:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8273:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 8274:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8275:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8276:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 8277:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8278:    
 8279:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8280:       
 8281:    
 8282: }
 8283: 
 8284: 
 8285: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8286:    // Get the value of a variable from an side
 8287:    // varName is the name of the variable to get
 8288:    // var is the array to store the value
 8289:    // k is the vertical level index of the variable to get
 8290:    SIDE(side);
 8291:    
 8292:    int idx = side->idx;
 8293:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8294: 
 8295:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8296:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8297:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8298:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8299:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8300:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8301:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8302:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8303:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8304:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8305:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8306:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8307:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8308:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8309:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8310:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8311:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 8312:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8313:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8314:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8315:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8316:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8317:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8318:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 8319:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8320:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8321:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8322:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8323:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8324:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8325:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8326:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8327:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8328:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8329: }
