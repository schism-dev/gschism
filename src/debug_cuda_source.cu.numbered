 7060: __global__ void printMatrix(bool full) {
 7061:    // Debugging: print the matrix
 7062: 
 7063:    const int size = mesh->np;
 7064:    double sum = 0.0;
 7065:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7066:       const Node *node = mesh->localNodeData + idx_node;
 7067:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7068:       for (int j = 0; j < node->numNodes; j++) {
 7069:          Node* nbNode = node->nodes[j];
 7070:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7071:          sum += node->coeffMatrix[j];
 7072:       }
 7073:       if (full) printf("]\n");
 7074: 
 7075: 
 7076:    }
 7077:    if (!full) printf("sum=%lf\n", sum);
 7078: }
