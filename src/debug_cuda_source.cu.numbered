 4205:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4206: 
 4207:       SIDE(side);
 4208: 
 4209: 
 4210:       side->U = {0.0, 0.0}; 
 4211:          
 4212:       if(side->isDry) return;
 4213: 
 4214:       const Node *node1 = side->n1;
 4215:       const Node *node2 = side->n2;
 4216: 
 4217:       // Vertically integrated velocity U (in ll if ics=2)
 4218:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4219:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4220:       }
 4221: 
 4222:    }
 4223: 
 4224:    __global__ void computeBottomDragVegetation(void) {
 4225:       // UNFINISHED. CHECK THIS:
 4226:       // How many kernels are needed? Why so many for loops?
 4227:       // Is the loop on sides needed?
 4228: 
 4229:       NODE(node);
 4230: 
 4231:       const int    kb      = node->kb;
 4232:       const double htot    = node->htot2();
 4233:       const double rough   = node->rough;
 4234: 
 4235: 
 4236:       if (node->isDry) {
 4237:          // Default values for dry nodes
 4238:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4239:          /// XXX CHECK INDICES
 4240:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4241:       }
 4242: 
 4243:       // Compute bottom drag Cd
 4244:       //--------------------------------
 4245: 
 4246:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4247:       if (nchi==1) {
 4248: 
 4249:          bool ltmp = false; // for WBL iteration
 4250: 
 4251:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4252:          // Drag at nodes
 4253:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4254:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4255:         
 4256:          const double rough = node->rough;
 4257:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4258:          if (node->rough == 0.0) {
 4259:             node->Cd = 0.0;
 4260: 
 4261:          } else { //roughness >0 
 4262:             
 4263:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4264:             const double bthick = max(dzb_min, bthick_ori);
 4265: 
 4266:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4267: 
 4268:             double tmp = 1.0/(2.5*log(bthick/rough));
 4269:             node->Cd = tmp*tmp;
 4270: 
 4271:          } // if rough
 4272: 
 4273: 
 4274:          // RECOVER THIS: XXX
 4275:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4276:          // Output warning for WBL if iteration didn't converge
 4277: 
 4278: 
 4279:       } // nchi==1
 4280: 
 4281:       //   Bottom stress in m^2/s^2
 4282:       if (node->rho[kb + 1] >= -98.0)
 4283:       {
 4284:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4285:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4286:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4287:          // !sediment erosion: this part needs more documentation
 4288:       }
 4289: 
 4290:     
 4291:       // Compute vegetation parameters
 4292:       //--------------------------------
 4293: 
 4294:       // SAV constants
 4295:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4296:       constexpr double veg_cfpsi = 0.16;
 4297: 
 4298:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4299:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4300: 
 4301:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4302:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4303:          int kbin = 0; // bin index
 4304:          for (int k = kb; k < nvrt; k++) {
 4305:             // Computes node height above the bottom level
 4306:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4307:             assert(false && "Vertical variation of vegetation not implemented");
 4308: 
 4309:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4310:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4311:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4312:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4313:             // } else {
 4314:             //    // Find the bin at which the current vertical level is
 4315:             //    while (kbin<nbins_veg_vert) {
 4316:             //       const double zn = node->z[kbin];
 4317:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4318:             //          break;
 4319:             //       } // if
 4320:             //       kbin++;
 4321:             //    } // while
 4322:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4323: 
 4324:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4325:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4326:                
 4327:             //    // Linear interpolation of the vegetation parameters
 4328:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4329:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4330:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4331:             // } // if rl10
 4332: 
 4333:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4334: 
 4335:          } // for k
 4336: 
 4337: 
 4338:       } else { // Ganthy (iveg=2)
 4339:       //  Modify canopy height, diameter, and density
 4340: 
 4341:          // Make sure there is vegetation on this node
 4342:          if (node->veg_h_unbent > 0.0) {
 4343:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4344: 
 4345:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4346:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4347:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4348: 
 4349:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4350:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4351:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4352:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4353:          } // if veg_h_unbent
 4354: 
 4355:          for (int k = 0; k < nvrt; k++) {
 4356:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4357:          } // for k
 4358:       
 4359: 
 4360:       } // if iveg
 4361:      
 4362:          
 4363: 
 4364:       // Compute vertical mean of veg_alpha3D
 4365:       if (iveg != 0) {
 4366:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4367:          double sum1=0.0;
 4368:          double sum2=0.0;
 4369:          // Integrate over each level under the canopy...
 4370:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4371:             const double Dz = node->Dz(k);
 4372: 
 4373:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4374:             sum2 += Dz;
 4375: 
 4376:          } // for k
 4377: 
 4378:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4379:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4380: 
 4381:       } // if iveg
 4382: 
 4383:    }
 4384: 
 4385:    __global__ void computeVegetationAndDragParameters(void) {
 4386:       // Computes the vegetation and drag model parameters:
 4387:       // chi, \tilde\chi, beta, \breve{H}
 4388:       
 4389:       SIDE(side);
 4390: 
 4391:       const double htot = side->htot2();
 4392:       const int    kb   = side->kb;
 4393: 
 4394:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4395: 
 4396:       const double veg_h     = side->veg_h();
 4397:       const double veg_nv    = side->veg_nv();
 4398:       const double veg_c     = side->veg_c();
 4399:       const double veg_beta  = side->veg_beta;
 4400:       const double veg_alpha = side->veg_alpha_vert_mean();
 4401: 
 4402:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4403:       // Velocity magnitude at the bottom level
 4404:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4405:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4406:       side->chi2 = side->Cd()*vmag1;
 4407:       side->chi  = side->chi2;
 4408:       if constexpr(iveg != 0) {
 4409:          const Node *n1 = side->n1;
 4410:          const Node *n2 = side->n2;
 4411:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4412:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4413:       }
 4414: 
 4415:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4416: 
 4417:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4418:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4419:       double magUa = 0.0;
 4420:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4421:          // 3D wet side with veg...
 4422: 
 4423:          double magUa = 0.0;
 4424:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4425:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4426: 
 4427:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4428:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4429:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4430: 
 4431:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4432:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4433: 
 4434:                // Velocity magnitude at the bottom (l) of the level
 4435:                const double ul = length(side->u2[k]);
 4436: 
 4437:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4438:                magUa += Dz*0.5*(uh + ul);
 4439: 
 4440:             } // if HasVegetation
 4441:          } // for k
 4442:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4443: 
 4444:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4445:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4446:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4447:             const double zCpy = side->zTopCanopy();
 4448:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4449:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4450:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4451:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4452:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4453:          } // if isSubmerged
 4454:       } // if iveg   
 4455: 
 4456:       // Computes the friction modified depth, \breve{H} in notes
 4457:       if (side->is2D()) { // 2D
 4458: 
 4459:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4460:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4461: 
 4462:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4463: 
 4464:          side->hhat = htot*htot/fricH; 
 4465: 
 4466:       } else { // 3D
 4467:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4468: 
 4469:          if constexpr(iveg != 0) {
 4470:             
 4471:             if (side->isSubmerged()) { 
 4472:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4473:                side->hhat -= veg_c*Hhat_alpha;
 4474: 
 4475:             } else { // Emergent
 4476:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4477:             }
 4478:          } // if iveg
 4479: 
 4480:          // Enforce positivity for 3D model
 4481:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4482:       } // if 3D
 4483: 
 4484:    }
 4485: 
 4486: 
 4487: 
 4488:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4489:    // Computes the density gradient between two elements, e1 and e2.
 4490:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4491:    // zero in the direction normal to the side. 
 4492:    // 
 4493:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4494:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4495:    //
 4496:    // Input:
 4497:    //    e1: Element
 4498:    //    e2: Neighbor element (or nullptr if boundary)
 4499:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4500:    //    k: Index of the half-level at which the density is interpolated
 4501:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4502:    // 
 4503:    // Output:
 4504:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4505:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4506: 
 4507:       if (e2 == nullptr || e2->isDry) {
 4508:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4509: 
 4510:          Side *side = e1->sides[j];
 4511:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4512:                  
 4513:          if constexpr(ics == 1) {
 4514:             vec = side->n; // Normal vector to the side
 4515:          } else {
 4516:             // IMPLEMENT THIS XXXXXX
 4517:             // !replace with xel, yel?
 4518:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4519:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4520:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4521:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4522:          } //ics
 4523:                    
 4524:          diffRho = 0.0;
 4525: 
 4526:       } else { //internal and wet
 4527:          if constexpr(ics==1) {
 4528:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4529: 
 4530:             // Vector from e1 to e2
 4531:             vec = toVector2(e2->center - e1->center);
 4532: 
 4533:          } else { 
 4534:             // IMPLEMENT THIS XXXXXX
 4535:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4536:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4537:             //                   alow(j)=xctr2
 4538:             //                   bdia(j)=yctr2
 4539:          } // ics
 4540: 
 4541:          diffRho = rho2 - e1->demeanedDensity(k);
 4542:       }
 4543: 
 4544:    }
 4545: 
 4546:    __global__ void computeDensityCubicSplines(void) {
 4547:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4548: 
 4549:       ELEM(elem);
 4550: 
 4551:       if (elem->isDry) return;
 4552: 
 4553:       const int kb = elem->kb;
 4554: 
 4555:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4556:       if (elem->is2D()) {
 4557:          // In the 2D case, the density is constant at the prism level. 
 4558:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4559:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4560:       } else { //3D
 4561: 
 4562:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4563:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4564:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4565:          ///// XXXX CHECK INDICES!!!!!
 4566:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4567:       } // 2D/3D
 4568: 
 4569:    }
 4570: } // extern "C"
 4571: 
 4572: 
 4573: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4574: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4575: 
 4576:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4577: 
 4578:    const int kb  = elem->kb;
 4579:    const int kb2 = elem2->kb;
 4580: 
 4581:    // z-coordinate of prism of elem
 4582:    const double zp = elem->z_prism(k);
 4583: 
 4584:    double rho = 0.0;
 4585: 
 4586:    if (elem2->is2D()) {
 4587:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4588: 
 4589:    } else {  // 3D
 4590: 
 4591:       // eta_min may be < zmax
 4592:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4593:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4594: 
 4595:       // (Extrapolate density below bottom, we will fix it later)
 4596:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4597:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4598:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4599:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4600:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4601:    } // 2D/3D
 4602:      
 4603: 
 4604:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4605:    // Now we need to fix it.
 4606:    if (elem->z[k] < elem2->z[kb2]) {
 4607:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4608: 
 4609:       // There are two methods to adjust the density at the bottom of the element.
 4610:       // iunder_deep=0: 
 4611:       const double depth1 = abs(elem->z[kb]); // larger depth
 4612: 
 4613:       if (iunder_deep==0) {
 4614: 
 4615:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4616: 
 4617:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4618: 
 4619:       } else { // iunder_deep != 0
 4620: 
 4621:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4622: 
 4623:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4624: 
 4625:          //   Demeaned density at the same z coordinate as
 4626:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4627:          }
 4628: 
 4629:       } // if iunder_deep
 4630:    } // if elem->z[kb] < elem2->z[kb]
 4631: 
 4632:    return rho;
 4633: }
 4634: 
 4635: 
 4636: extern "C" {
 4637:    __global__ void computeDensityGradient(void) {
 4638: 
 4639:          // Compute the horizontal density gradient at each element.
 4640:       // It works in two steps:
 4641:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4642:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4643:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4644:       //             gradRho.r1 = rho1 - rho0
 4645:       //             gradRho.r2 = rho2 - rho0
 4646:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4647:       // 
 4648:       //  NOTE: We use de-meaned densities.
 4649: 
 4650:       ELEM(elem);
 4651: 
 4652:       if (elem->isDry) return;
 4653: 
 4654:       const int kb  = elem->kb;
 4655:       const int i34 = elem->i34;
 4656: 
 4657:       for (int k = kb + 1; k < nvrt; k++) {
 4658:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4659:          //             gradRho.r1 = rho1 - rho0
 4660:          //             gradRho.r2 = rho2 - rho0
 4661:          int icount = 0;
 4662:          double sumRx = 0.0;
 4663:          double sumRy = 0.0;
 4664:          for (int j1=0; j1<i34; j1++) { 
 4665: 
 4666:             const int j2 = elem->nxq(j1 + 1);
 4667: 
 4668:             // Pairs of consecutive neighbor elements of elem
 4669:             const Element *e1 = elem->nghbElems[j1];
 4670:             const Element *e2 = elem->nghbElems[j2];
 4671: 
 4672:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4673:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4674:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4675: 
 4676:             // Compute the density difference and the vector from elem to e1 and e2
 4677:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4678:             double diffRho1, diffRho2;
 4679:             Vector2 vec1, vec2;
 4680:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4681:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4682: 
 4683:             const double rl1 = length(vec1);
 4684:             const double rl2 = length(vec2);
 4685:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4686: 
 4687:             const double delta = cross(vec1, vec2);
 4688:             const double sintheta = abs(delta)/(rl1*rl2);
 4689: 
 4690:             // To avoid problems, avoid elements with small angle between vectors
 4691:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4692:             const bool validEq = (sintheta > sin_one_deg);
 4693: 
 4694:             if (validEq) {
 4695:                // Solve the system of equations to get the density gradient at elem
 4696:                icount++;
 4697:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4698:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4699:                sumRx += Rx;
 4700:                sumRy += Ry;
 4701:             }
 4702:          } // for j1
 4703: 
 4704:          // Compute the average density gradient at elem
 4705:          if (icount==0) {
 4706:            // Bad mesh quality; bail out with 0 b-cc
 4707:            elem->gradRho[k] = {0.0, 0.0};
 4708:          } else {
 4709:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4710:          }
 4711: 
 4712:       } // for k
 4713: 
 4714:    }
 4715: 
 4716:    __global__ void computeBaroclinicTerm(void) {
 4717:    // Computes the baroclinic term at sides (at half levels).
 4718:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4719:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4720: 
 4721:       SIDE(side);
 4722: 
 4723:       if (side->isDry) return;
 4724: 
 4725:       const Element *e1 = side->elems[0];
 4726:       const Element *e2 = side->elems[1];      
 4727:       const int kb = side->kb;
 4728:       
 4729:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4730: 
 4731:       // interpolates vertically the density gradient of the two elements at the half level/
 4732: 
 4733:       // Starts the integration at the surface and goes down to the bottom
 4734:       int k1 = nvrt - 1;
 4735:       int k2 = nvrt - 1;
 4736: 
 4737:       side->bcc[nvrt-1] = {0.0, 0.0};
 4738:       for (int k = nvrt-2; k >= kb; k--) {
 4739:       // For each prism level (from surface to bottom)...
 4740: 
 4741:          // For both elements, interpolate density gradient at the side's half level.
 4742:          // The gradient at the side is the average of the gradients at the elements.
 4743:          // w1, w2 are used to take into account boundary sides, with just one element.
 4744:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4745:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4746:          const double wsum = w1 + w2;
 4747:          w1 = w1/wsum;
 4748:          w2 = w2/wsum;
 4749:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4750: 
 4751:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4752:          Vector2 gradRho = {0.0, 0.0};
 4753:          if (e1 != nullptr && k > kb) {
 4754:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4755:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4756:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4757:             
 4758:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4759:          }      
 4760:          if (e2 != nullptr && k > kb) {
 4761:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4762:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4763:             
 4764:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4765:          }
 4766: 
 4767:          if constexpr(ics==2) {
 4768:             // IMPLEMENT THIS XXXXXX
 4769:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4770:             // swild(1)=tmp1
 4771:             // swild(2)=tmp2
 4772:          }
 4773:          
 4774:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4775:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4776:          // CHECK INDICES!!! XXX
 4777:          const double grav3 = side->grav3();
 4778:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4779: 
 4780:       } // for
 4781: 
 4782:    }
 4783: 
 4784: 
 4785: 
 4786:    __global__ void computeHorGradientAtSide(void) {
 4787: 
 4788:       // Compute the horizontal density gradient at each element.
 4789:       // It works in two steps:
 4790:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4791:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4792:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4793:       //             gradRho.r1 = rho1 - rho0
 4794:       //             gradRho.r2 = rho2 - rho0
 4795:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4796:       // 
 4797:       //  NOTE: We use de-meaned densities.
 4798: 
 4799:       SIDE(side);
 4800: 
 4801:       if (side->isDry) return;
 4802: 
 4803:       // Computes the gradient of the variables at the side center.
 4804:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4805:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4806:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4807: 
 4808:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4809:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4810:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4811:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4812: 
 4813: 
 4814:    }
 4815: 
 4816: 
 4817:    __global__ void solveMomentumEquations(double time) {
 4818: 
 4819:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4820:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4821: 
 4822:       SIDE(side);
 4823: 
 4824:       if (side->isDry) 
 4825:       {
 4826:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4827: 
 4828:          return;
 4829:       }
 4830: 
 4831:       const Node *n1 = side->n1;
 4832:       const Node *n2 = side->n2;
 4833: 
 4834:       const int kb = side->kb;
 4835: 
 4836:       const double veg_h = side->veg_h();
 4837:       const double grav3 = side->grav3();
 4838: 
 4839:       if (side->is2D()) {
 4840:          // Warning: Do not use htot2, which is updated.
 4841:          const double htot = side->htot1();
 4842:          const double hhat = side->hhat;
 4843: 
 4844:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4845: 
 4846:          Vector2 tau2 = {0.0, 0.0};
 4847:           
 4848:          if constexpr(ics==1) {
 4849:             tau2 = side->tau();
 4850: 
 4851:          } else {
 4852:             assert(false && "Not implemented: ics == 2");
 4853:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4854:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4855:             // taux2=(vn1+tt1)*0.5d0
 4856:             // tauy2=(vn2+ss1)*0.5d0
 4857:          } // if ics         
 4858: 
 4859:          // hat_gam has units of m/s
 4860: 
 4861:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4862: 
 4863:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4864:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4865: 
 4866:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4867: 
 4868:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 4869:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 4870: 
 4871:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 4872: 
 4873:       }
 4874:       else { // 3D
 4875: 
 4876:          // For 3D it is necessary to solve an implicit tridiagonal system.
 4877:          // 
 4878:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 4879:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 4880:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 4881:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 4882:          // k+1 and k.
 4883: 
 4884: 
 4885:          // // Define layer thickness & viscosity
 4886:          // for (int k=kb + 1; k<nvrt; k++) {
 4887:          //    const double dzz = side->Dz(k - 1);
 4888: 
 4889:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4890: 
 4891:          //    // Vertical viscosity at the face center
 4892:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 4893:         
 4894:          // }
 4895: 
 4896: 
 4897:          const int ndim = nvrt - kb;
 4898:          const double zTopCanopy = side->zTopCanopy();
 4899: 
 4900:          // Initialize the tridiagonal system
 4901:          for (int k = kb + 1; k<nvrt; k++) {
 4902:             
 4903:             const int kin = k - kb;
 4904: 
 4905:             // Vertical viscosity at the face center
 4906:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 4907:             const double dzz = side->Dz(k);
 4908: 
 4909:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 4910: 
 4911:             alow[kin] = 0.0;
 4912:             cupp[kin] = 0.0;
 4913:             bdia[kin] = 0.0;
 4914: 
 4915:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 4916:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 4917: 
 4918:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 4919:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 4920:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 4921: 
 4922:             // First part: layers k, k+1
 4923:             if (k < nvrt - 1) {
 4924:                              
 4925:                if constexpr(iveg != 0) {
 4926: 
 4927:                   // If there is vegetation at this level...
 4928:                   if (zTopCanopy > side->zc[k]) {
 4929:                      // If the canopy is above the k layer...
 4930:                      
 4931:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 4932:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 4933:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 4934:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 4935: 
 4936:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 4937:                      const double vmag2 = length(ut2);
 4938:                      const double vmag1 = length(side->u2[k]);
 4939:                      const double vmag = 0.5*(vmag1 + vmag2);
 4940:                      
 4941:                      // Computes the vegetation alpha at the face center
 4942:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 4943: 
 4944:                      cff1 += veg_alpha_sd*dt*vmag;
 4945: 
 4946:                   } // if (zTopCanopy
 4947:                } // if iveg
 4948: 
 4949:                const double tmp = dt*dfz/dzz;
 4950:                cupp[kin] += cff1*dzz/6.0 - tmp;
 4951:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4952:             }
 4953: 
 4954: 
 4955:             // Second part: layers k-1, k
 4956:             if (k > kb + 1) {
 4957: 
 4958:                double cff1 = 1.0; //init \bar{c^k}
 4959: 
 4960:                if constexpr(iveg != 0) {
 4961:                   // If there is vegetation at this level...
 4962:                   if (zTopCanopy > side->zc[k-1]) {
 4963:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 4964:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 4965: 
 4966:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 4967: 
 4968:                      const double vmag2 = length(ut2);
 4969:                      const double vmag1 = length(side->u2[k-1]);
 4970:                      const double vmag = 0.5*(vmag1 + vmag2);
 4971: 
 4972:                      // Computes the vegetation alpha at the face center
 4973:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 4974:                      cff1 += veg_alpha_sd*dt*vmag;
 4975:                   } // if zTopCanopy
 4976: 
 4977:                } // if iveg
 4978: 
 4979:                const double tmp = dt*dfz/dzz;
 4980:                alow[kin] += cff1*dzz/6.0 - tmp;
 4981:                bdia[kin] += cff1*dzz/3.0 + tmp;
 4982: 
 4983:             } else { // Bottom boundary
 4984:                // This occurs at the bottom, where the bottom drag is applied.
 4985: 
 4986:                bdia[kin] += dt*side->chi2;
 4987: 
 4988:             } // if (k > kb + 1)
 4989: 
 4990: 
 4991: 
 4992:          } // for (int k
 4993: 
 4994: 
 4995: 
 4996:          // Computes the RHS.
 4997:          // -----------------
 4998: 
 4999:          //	BC to be imposed at the end.
 5000: 
 5001:          const Vector2 gradETP  = side->gradETP;
 5002:          const Vector2 gradPr   = side->gradPr;
 5003:          const Vector2 gradEta1 = side->gradEta1;
 5004:          const Vector2 gradEta2 = side->gradEta2;
 5005: 
 5006:          const Vector2 *btu = side->btu;
 5007:          const Vector2 *u2  = side->u2;
 5008:          const double coriolis = side->coriolis;
 5009:          const Vector2 *nuGradU = side->nuGradU;
 5010: 
 5011: 
 5012:          for (int k = kb + 1; k<nvrt; k++) {
 5013:             const int kin = k - kb;
 5014: 
 5015:             const double dz_0 = side->Dz(k);
 5016:             const double dz_1 = side->Dz(k+1);  
 5017: 
 5018:             rrhs[kin] = {0.0, 0.0};
 5019:             double dz = 0.0;
 5020: 
 5021:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5022:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5023:             if (k < nvrt  ) dz += 0.5*dz_1;
 5024:             if (k > kb + 1) dz += 0.5*dz_0;
 5025: 
 5026:             // Elevation gradient, atmospheric pressure and tidal potential
 5027:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5028: 
 5029:             // Coriolis, advection, wind stress, and horizontal viscosity
 5030:             if (k < nvrt - 1) {
 5031: 
 5032: 
 5033:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5034:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5035:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5036: 
 5037:                //diff stress tensors 1006
 5038:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5039:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5040:                   assert(false && "Not implemented: itur == 5");
 5041:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5042:                }
 5043: 
 5044:             } else { // k=nvrt
 5045:                Vector2 tau2 = {0.0, 0.0};
 5046:                if constexpr(ics==1) {
 5047:                   tau2 = side->tau();
 5048:                } else {
 5049:                   assert(false && "Not implemented: ics == 2");
 5050:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5051:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5052:                   // taux2=(vn1+tt1)*0.5d0
 5053:                   // tauy2=(vn2+ss1)*0.5d0
 5054:                } // if ics
 5055: 
 5056:                rrhs[kin] += dt*tau2;
 5057: 
 5058:             } // if k<nvrt
 5059: 
 5060:             if (k > kb + 1) {
 5061:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5062:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5063:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5064: 
 5065: 
 5066:                // diff stress tensors 1006
 5067:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5068:                   assert(false && "Not implemented: itur == 5");
 5069:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5070:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5071:                }
 5072: 
 5073:             } // if k>kbs + 1
 5074: 
 5075:             // Baroclinic
 5076:             Vector2 *bcc = side->bcc;
 5077:             if constexpr(ibc == 0) {
 5078:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5079:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5080: 
 5081:             } // if ibc==0
 5082: 
 5083: 
 5084:          } // k=kb + 1,nvrt
 5085: 
 5086:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5087:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5088: 
 5089: 
 5090:          for (int k=kb + 1; k<nvrt; k++) {
 5091:             const int kin = k - kb;
 5092: 
 5093:             // Velocity is always clamped to maximum values
 5094:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5095:          } // k
 5096: 
 5097:       } // if side->is2D()
 5098:       
 5099: 
 5100:       // Impose velocity boundary condition at the bottom
 5101:       if constexpr(imm == 2) { // 3D bed deformation model
 5102:          double dep;
 5103:          Vector2 vel;
 5104: 
 5105:          assert(false && "Not implemented: imm == 2");
 5106:          //update_bdef(time, x0, y0, dep, vel);
 5107:          // side->u2[kb] = vel;
 5108: 
 5109:       } else { // imm = 0 or 1
 5110:          if (side->Cd() == 0.0) {
 5111:             side->u2[kb] = side->u2[kb + 1];
 5112:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5113:             side->u2[kb] = {0.0, 0.0};
 5114:          }
 5115:           
 5116:       } // if imm
 5117: 
 5118:       // The velocities below the bottom level are set to zero
 5119:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5120: 
 5121: 
 5122:    }
 5123: 
 5124: 
 5125:    __global__ void applyMomentumBC(void) {
 5126: 
 5127:       SIDE_BND(sideBnd);
 5128: 
 5129:       Side *side = sideBnd->side;
 5130:       const BoundarySegment *segment = sideBnd->segment;
 5131:       const Node *n1 = side->n1;
 5132:       const Node *n2 = side->n2;
 5133: 
 5134:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5135: 
 5136:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5137:       const bool isLand = segment->isLand;
 5138:       const int ifltype = segment->ifltype;
 5139: 
 5140:       const int kb = side->kb;
 5141: 
 5142:       if (!isLand && ifltype != 0) {
 5143:          const Vector2 *ubc = sideBnd->ubc;
 5144:   
 5145:          for (int k=kb; k < nvrt; k++) {
 5146:             
 5147:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5148:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5149: 
 5150:             if (ifltype == -1) {
 5151:                // Flather 1
 5152: 
 5153:                const double depth = side->depth();
 5154: 
 5155:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5156: 
 5157:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5158: 
 5159:                side->u2[k] = vnorm*side->n;
 5160: 
 5161:             } else if (ifltype == -2) { // Discharge
 5162: 
 5163:                const double eta1 = side->eta1();
 5164:                const double eta2 = side->eta2();
 5165:                const double htot = side->htot2();
 5166: 
 5167:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5168:                assert(false && "Not implemented: Discharge bc");
 5169:                // const double dischrg = discharge(eta1);
 5170:                const double dischrg = 0.0; // XXX REMOVE
 5171:                
 5172: 
 5173:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5174: 
 5175:                const double vnorm = dischrg*eta2/htot;
 5176: 
 5177:                side->u2[k] = vnorm*side->n;
 5178: 
 5179: 
 5180:             }
 5181:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5182:                const double vnorm = dot(side->u2[k], side->n);
 5183: 
 5184:                double rat;
 5185:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5186:                else              rat = segment->vobc2; // outgoing
 5187: 
 5188:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5189:             }
 5190:             else { // not Flather or 3D radiation
 5191:                side->u2[k] = ubc[k];
 5192: 
 5193:             } // if (segment->ifltype...
 5194: 
 5195:          }
 5196: 
 5197:       }
 5198:       else if (isLand) { // if it is land boundary side
 5199: 
 5200:          if constexpr(islip == 0) { // free slip
 5201:             for (int k=kb; k < nvrt; k++) {
 5202: 
 5203:                const Vector2 t = side->t();
 5204:                const Vector2 n = side->n;
 5205: 
 5206:                double vnorm = 0.0; // for most cases
 5207:                const double vtan = dot(side->u2[k], t);
 5208:                
 5209:                side->u2[k] = vtan*t - vnorm*n;
 5210: 
 5211:             }
 5212: 
 5213:          } else { // no slip
 5214:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5215: 
 5216:          }
 5217:       } // if (side segment type...
 5218: 
 5219:    
 5220: 
 5221:    }
 5222: 
 5223: 
 5224:    __global__ void shapiroFilter1(void) {
 5225:       // First step of the Shapiro filter (normally used if indvel<=0)
 5226:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5227: 
 5228:       SIDE(side);
 5229: 
 5230:       // Only internal wet sides are processed
 5231:       if (side->isDry || !(side->isInternal())) return;
 5232: 
 5233:       const int kb = side->kb;
 5234: 
 5235:       for (int mm = 1; mm <= niter_shap; mm++) {
 5236: 
 5237:          for (int k = kb + 1; k < nvrt; k++) {
 5238:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5239:             side->bcc[k] = {0.0, 0.0};
 5240:             Vector2 suru = {0.0, 0.0};
 5241: 
 5242:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5243: 
 5244:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5245: 
 5246:                int kin = k;
 5247:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5248:                
 5249:                if constexpr(ics==1) {
 5250:                   suru += nSide->u2[kin];
 5251: 
 5252:                } else {
 5253:                   assert(false && "Not implemented: ics == 2");
 5254:                   // Vector2 vn1, vn2;
 5255:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5256:                   // suru=suru+vn1;
 5257:                   // surv=surv+vn2;
 5258:                }
 5259:             }
 5260: 
 5261: 
 5262:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5263: 
 5264:          }
 5265:       }
 5266:    }
 5267: 
 5268:    __global__ void shapiroFilter2(void) {
 5269:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5270: 
 5271:       SIDE(side);
 5272: 
 5273:       if (side->isDry || !(side->isInternal())) return;
 5274: 
 5275:       const int kb = side->kb;
 5276: 
 5277:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5278: 
 5279:       if (side->is2D()) {
 5280:          // side->u2[kb] = side->u2[nvrt - 1];
 5281:          side->u2[kb + 1] = side->bcc[kb + 1];
 5282:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5283: 
 5284:       } else {
 5285:          // 3D
 5286:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5287:          
 5288:       }
 5289: 
 5290:    }
 5291: 
 5292: 
 5293:    __global__ void ul0UpdateZCoords(void) {
 5294:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5295:       
 5296:       NODE(node);      
 5297: 
 5298:       if (node->isDry2()) { 
 5299: 
 5300:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5301: 
 5302:          if constexpr(ivcor != 1) node->kb = 0;
 5303: 
 5304:       } else {
 5305: 
 5306:          node->updateKb();
 5307:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5308: 
 5309:       }
 5310: 
 5311:       // We use the temp.b field to store the previous state of isDry.
 5312:       node->tmp.b = node->isDry;
 5313: 
 5314:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5315:       node->isDry = true;
 5316: 
 5317:    }
 5318: 
 5319:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5320:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5321:    {
 5322:       ELEM(elem);
 5323: 
 5324:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5325: 
 5326:       // All the nodes of a wet element are wet.
 5327:       if (!elem->isDry) {
 5328:          elem->nodes[0]->isDry = false;
 5329:          elem->nodes[1]->isDry = false;
 5330:          elem->nodes[2]->isDry = false;
 5331:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5332: 
 5333:       }
 5334: 
 5335: 
 5336:       elem->kb = 0;
 5337: 
 5338:       if (elem->isDry) return;
 5339: 
 5340:       // Wet
 5341:       const Node *n1 = elem->nodes[0];
 5342:       const Node *n2 = elem->nodes[1];
 5343:       const Node *n3 = elem->nodes[2];  
 5344:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5345: 
 5346:    //    if(elem->isDry2()) {
 5347:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5348:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5349:    //        call parallel_abort(errmsg)
 5350:    //    }
 5351: 
 5352: 
 5353:       // Computes element's kb as the minimum of the nodes' kb.
 5354:       const int kb1 = n1->kb;
 5355:       const int kb2 = n2->kb;
 5356:       const int kb3 = n3->kb;
 5357:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5358: 
 5359: 
 5360:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5361: 
 5362: 
 5363:       // Computes the element z as the mean of the nodes z.
 5364:       for (int k = elem->kb; k < nvrt; k++) {
 5365: 
 5366:          // Compute the element z as the mean of the nodes z.
 5367:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5368:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5369:          elem->z[k] /= elem->i34;
 5370: 
 5371:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5372:       }
 5373:                   
 5374:    }
 5375: 
 5376:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5377:    {
 5378:       NODE(node);
 5379:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5380: 
 5381:       if (it == iths) return;
 5382: 
 5383: 
 5384:       if(!node->isDry && node->tmp.b) { // rewetted
 5385:          for (int k=0; k < nvrt; k++) {
 5386: 
 5387:             Vector3 utmp={0.0, 0.0, 0.0};
 5388: 
 5389:             double ttmp=0.0;
 5390:             double stmp=0.0;
 5391:             int icount=0;
 5392:             for (int j = 0; j < node->numNodes; j++) {
 5393: 
 5394: 
 5395:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5396:                if (!node->isDry) { // all indices extended
 5397:                   icount++;
 5398: 
 5399:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5400:                   utmp += node->u2[k];
 5401:                   
 5402:                   ttmp += node->tracers[k].tracer[0]; 
 5403:                   stmp += node->tracers[k].tracer[1]; 
 5404:                }
 5405:             }
 5406: 
 5407:             if(icount > 0) {
 5408:                const double inv_icount = 1.0/icount;
 5409:                node->u2[k]     = inv_icount*utmp;
 5410:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5411:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5412:             }
 5413:          }
 5414:       }
 5415:    }
 5416: 
 5417: 
 5418:    __global__ void ul0UpdateSides(int it, int iths) {
 5419: 
 5420:       SIDE(side);
 5421: 
 5422:       // A side is wet if and only if at least one of its elements is wet.
 5423:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5424: 
 5425:       const Node *n1 = side->n1;
 5426:       const Node *n2 = side->n2;
 5427:       const int kb1 = n1->kb;
 5428:       const int kb2 = n2->kb;
 5429: 
 5430:       side->kb = 0; // dry
 5431: 
 5432:       if (isWet) {
 5433: 
 5434:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5435: 
 5436:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5437: 
 5438:          side->kb = min(kb1, kb2);
 5439: 
 5440:          for (int k = side->kb; k < nvrt; k++) {
 5441:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5442: 
 5443:          
 5444:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5445: 
 5446:             // Compute velocity for re-wetted sides 
 5447:             if ((it != iths) && (side->isDry && isWet)) {
 5448:             
 5449:                Vector2 utmp={0.0, 0.0};
 5450: 
 5451:                int icount=0;
 5452: 
 5453:                // For all the sides on the two elements that share this side
 5454:                for (int j=0; j < 2; j++) {
 5455:                   const Element *elem = side->elems[j];
 5456:                   if (elem == nullptr) continue;
 5457: 
 5458:                   for (int jj=0; jj < elem->i34; jj++) {
 5459:                      const Side *nSide = elem->sides[jj];
 5460:                      if (nSide->isDry) continue;
 5461: 
 5462:                      icount++;
 5463:                      utmp += nSide->u2[k];                     
 5464:                   }
 5465:                }
 5466:                   
 5467:                assert(icount > 0 && "No wet sides around this side");
 5468:                if (icount > 0)  side->u2[k] = utmp/icount;
 5469:                   
 5470:             } // if ((it != iths) && (side->isDry && isWet))
 5471: 
 5472:          } // for k
 5473: 
 5474:       } // if isWet
 5475:    
 5476:       side->isDry = !isWet;
 5477: 
 5478:    }
 5479: 
 5480: 
 5481:    __global__ void zeroNodalVelocities(void) {
 5482:       NODE(node);
 5483: 
 5484:       for (int k = 0; k < nvrt; k++) {
 5485:          node->u2[k]   = {0.0, 0.0, 0.0};
 5486:          node->utmp[k] = {0.0, 0.0};
 5487:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5488:       }
 5489:    }
 5490: 
 5491:    __global__ void computeNodalVerticalVelocities1(void) {
 5492:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5493:    // Adds the element's vertical velocity times the element's area.
 5494:       ELEM(elem);
 5495: 
 5496:       for (int j = 0; j < elem->i34; j++) {
 5497:          Node *node = elem->nodes[j];
 5498: 
 5499:          for (int k = node->kb; k < nvrt; k++) {
 5500:             atomicAdd(&(node->u2[k].z), elem->w[k]*elem->area);
 5501:          }
 5502:          atomicAdd(&(node->tmp.d), elem->area);
 5503:       }
 5504:    }
 5505: 
 5506:    __global__ void computeNodalVerticalVelocities2(void) {
 5507:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5508:    // Divides by the total area of the elements sharing the    node.
 5509:       NODE(node);
 5510: 
 5511:       for (int k = node->kb; k < nvrt; k++) node->u2[k].z = node->u2[k].z / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5512:    }
 5513: 
 5514: 
 5515:    __global__ void computeNodalHorizontalVelocities1(void) {
 5516:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5517:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5518: 
 5519:       ELEM(elem);
 5520: 
 5521:       const int kb = elem->kb;
 5522:       const bool isTri = elem->isTri();
 5523: 
 5524:       if constexpr(indvel <= 0) {
 5525:          // Assuming discontinoius hvel.
 5526: 
 5527: 
 5528:          if (isTri) { // For triangles
 5529:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated at one node can be
 5530:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5531: 
 5532:             for (int j = 0; j < 3; j++) {
 5533:                // For every node of the triangle...
 5534:                Node *node = elem->nodes[j];
 5535: 
 5536:                const Side *s1 = elem->sides[j];
 5537:                const Side *s2 = elem->sides[(j + 1) % 3];
 5538:                const Side *s3 = elem->sides[(j + 2) % 3];
 5539: 
 5540:                const int numElements = node->numElements;
 5541: 
 5542:                for (int k = kb; k < nvrt; k++)  {
 5543:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k];
 5544:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 5545:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 5546:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 5547:                   atomicAdd(&(node->utmp[k].x), (1.0/numElements) * u.x);
 5548:                   atomicAdd(&(node->utmp[k].y), (1.0/numElements) * u.y);
 5549: 
 5550:                }
 5551: 
 5552:             }
 5553:          }
 5554:          else { // For quads
 5555: 
 5556:          }
 5557: 
 5558:       }
 5559:       
 5560:    }
 5561: 
 5562: 
 5563:    __global__ void computeNodalHorizontalVelocities2(void) {
 5564:       NODE(node);
 5565: 
 5566:       for (int k = 0; k < nvrt; k++) {
 5567:          node->u2[k] = toVector3(node->utmp[k], node->u2[k].z);
 5568:       }
 5569:       
 5570:    }   
 5571: 
 5572:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 5573:    // XXXX I'm not sure where I got this function from. 
 5574:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 5575:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 5576:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 5577:    // It uses the utmp array as a temporary array to store the velocities.
 5578: 
 5579:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 5580: 
 5581:       SIDE(side);
 5582: 
 5583:       const int kb = side->kb;
 5584: 
 5585:       Node *n1 = side->n1;
 5586:       Node *n2 = side->n2;
 5587: 
 5588:       for (int k = kb; k < nvrt; k++) {
 5589: 
 5590:          // Cast the u2 vector into a Vector2 
 5591:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 5592:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 5593: 
 5594:          n1_u2 = side->u2[k]/n1->numSides;
 5595:          n2_u2 = side->u2[k]/n2->numSides;
 5596: 
 5597:       }
 5598: 
 5599: 
 5600:    }
 5601: 
 5602:    __global__ void resetVelocityOpenBndNodes(void) {
 5603:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 5604: 
 5605:       NODE_BND(nodebnd);
 5606: 
 5607:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 5608:          for (int k = 0; k < nvrt; k++) nodebnd->node->u2[k] = {0.0, 0.0, 0.0};
 5609:       }
 5610: 
 5611:    }
 5612: 
 5613: 
 5614:    __global__ void setVelocityOpenBndNodes(void) {
 5615:    // For open boundary nodes sets their velocity to the imposed values.
 5616: 
 5617:       SIDE_BND(sidebnd);
 5618: 
 5619:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 5620:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 5621:          // to its segment to the average of the side velocity.
 5622: 
 5623:          for (int k = 0; k < nvrt; k++) {
 5624:             Node *n1 = sidebnd->side->n1;
 5625:             Node *n2 = sidebnd->side->n2;
 5626: 
 5627:             // Cast the u2 vector into a Vector2 
 5628:             Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&n1->u2[k]);
 5629:             Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&n2->u2[k]);
 5630: 
 5631:             if (n1->nodeBnd->segment == sidebnd->segment) n1_u2 += sidebnd->side->u2[k]/n1->nodeBnd->numSidesForAverage();
 5632:             if (n2->nodeBnd->segment == sidebnd->segment) n2_u2 += sidebnd->side->u2[k]/n2->nodeBnd->numSidesForAverage();
 5633:          }
 5634:       }
 5635: 
 5636:    }
