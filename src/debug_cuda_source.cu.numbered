 2760: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2761: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2762: 
 2763: //       if (delta != 0.0) {
 2764: //          // Solves the two linear equations for tt1 and tt2
