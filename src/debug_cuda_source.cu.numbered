 3400: 
 3401: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3402:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3403:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3404: 
 3405: 
 3406:    NODE(node1);
 3407: 
 3408:    node1->clearMatrixRow();
 3409:    node1->qel = 0.0;
 3410: 
 3411:    // THIS IS FOR STRUCTURES XXX
 3412:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3413: 
 3414:    
 3415:    for (int j=0; j<node1->numElements; j++) {
 3416:       // For each element connected to the node...
 3417: 
 3418:       Element *elem = node1->elements[j];
 3419: 
 3420: 
 3421: 
 3422:       // Compute the average gravity
 3423:       const double grav3 = elem->mean(&Node::grav2);
 3424: 
 3425:       // Look at the documentation for the description of the terms in the following integrals
 3426: 
 3427:       // Integral I_1 
 3428:       // \bar{\breve{H}} 
 3429:       const double hhatb = elem->mean(&Side::hhat);        
 3430: 
 3431:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3432: 
 3433:       const int id1 = elem->nodeLocalIdx(node1); 
 3434:       const double area = elem->area;
 3435: 
 3436:       if (elem->isTri()) {
 3437: 
 3438:          // To clarify the notation in this section: 
 3439:          //   i stands for the node under consideration (node1)
 3440:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3441:          const int id2 = elem->nxq(1 + id1);
 3442:          const int id3 = elem->nxq(2 + id1);
 3443:          Node *node2 = elem->nodes[id2];
 3444:          Node *node3 = elem->nodes[id3];
 3445: 
 3446:          const Point2 x1 = node1->p;
 3447:          const Point2 x2 = node2->p;
 3448:          const Point2 x3 = node3->p;
 3449: 
 3450:          // integral of phi_i*phi_j
 3451:          const double ipp_ii = (1.0/6.0 )*area;
 3452:          const double ipp_ij = (1.0/12.0)*area;
 3453:          const double ipp_ik = (1.0/12.0)*area;
 3454: 
 3455:          // integral of [(grad phi_i) * (grad phi_j)]
 3456:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3457:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3458:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3459: 
 3460:          // Computes the different components of integral I_1 of each node with respect to node i.
 3461:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3462:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3463:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3464: 
 3465:          node1->addToSparseMatrix(node1, I1_ii);
 3466:          node1->addToSparseMatrix(node2, I1_ij); 
 3467:          node1->addToSparseMatrix(node3, I1_ik);
 3468: 
 3469:       }
 3470:       else { // Quad
 3471:          // XXX IMPLEMENT THIS
 3472:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3473: 
 3474:          // To clarify the notation in this section: 
 3475:          //   i stands for the node under consideration (node1)
 3476:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3477:          const int id2 = elem->nxq(1 + id1);
 3478:          const int id3 = elem->nxq(2 + id1);
 3479:          const int id4 = elem->nxq(3 + id1);
 3480:          Node *node2 = elem->nodes[id2];
 3481:          Node *node3 = elem->nodes[id3];
 3482:          Node *node4 = elem->nodes[id4];         
 3483: 
 3484:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3485:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3486:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3487:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3488:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3489: 
 3490:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3491:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3492:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3493:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3494:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3495: 
 3496:          // Computes the different components of integral I_1 of each node with respect to node i.
 3497:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3498:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3499:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3500:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3501: 
 3502:          node1->addToSparseMatrix(node1, I1_ii);
 3503:          node1->addToSparseMatrix(node2, I1_ij); 
 3504:          node1->addToSparseMatrix(node3, I1_ik);
 3505:          node1->addToSparseMatrix(node4, I1_il);
 3506:   
 3507:       } 
 3508: 
 3509:  
 3510:       // Integral I_4
 3511:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3512:       // Where
 3513:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3514: 
 3515:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3516:       // of U over the element.
 3517:       Vector2 U = {0.0, 0.0};
 3518:       for (int m=0; m < elem->i34; m++) {      
 3519:          const Side *side = elem->sides[m];
 3520: 
 3521:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3522:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3523:       }
 3524:       U = U/elem->i34;
 3525: 
 3526: 
 3527:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3528: 
 3529: 
 3530:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3531:       const double I_4_1 = dot(gradPhi_1, U);
 3532: 
 3533: 
 3534:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3535:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3536: 
 3537:      
 3538:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3539: 
 3540:       // Additional terms 
 3541:       double vnorm = 0.0;
 3542:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3543:          Vector3 ubed = {0.0, 0.0, 0.0};
 3544:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3545: 
 3546:          Vector3 gradP = {0.0, 0.0, 1.0};
 3547:          for (int m=0; m < elem->i34; m++) {
 3548:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3549:            gradP += toVector3(gradP_2D, 0.0);
 3550:          }   
 3551:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3552:       } // imm==2
 3553: 
 3554:       if (elem->isTri()) {
 3555:          for (int l=0; l<3; l++) {
 3556: 
 3557:             Node *node = elem->nodes[l];
 3558: 
 3559:             double fac = (node == node1) ? 2.0 : 1.0;
 3560:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3561:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3562:            
 3563:          }
 3564: 
 3565: 
 3566:          if (!elem->isDry) {
 3567:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3568: 
 3569:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3570: 
 3571:          }
 3572: 
 3573:       } // isTri
 3574:       else { // isQuad
 3575:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3576:          // for (int l=0; l<4; l++) {
 3577:          //   const Node *node = elem->nodes[l];
 3578: 
 3579:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3580:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3581: 
 3582:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3583:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3584:          // }
 3585: 
 3586:       } // isQuad
 3587: 
 3588: 
 3589:      node1->qel += (dt/elem->i34)*elem->vsource;
 3590:       
 3591: 
 3592:    } // for all elements connected to the node
 3593:    
 3594: 
 3595:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3596:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3597:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3598:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3599:       // If it is an open boundary node...
 3600: 
 3601:       // At least one open bnd side, maybe two
 3602:       for (int l=0; l<2; l++) { 
 3603: 
 3604:          // Gets each of the sides sharing the node. 
 3605:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3606: 
 3607:        
 3608: 
 3609:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3610:          if (sideBnd != nullptr) {
 3611:             // If the side is on a boundary...
 3612: 
 3613:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3614: 
 3615:             // Get the boundary segment
 3616:             const BoundarySegment *sideSegment = sideBnd->segment;
 3617:             const Side *side = sideBnd->side;
 3618: 
 3619:             // Integral I_3
 3620:             if (sideSegment->ifltype != 0) {
 3621:             // Natural or Flather b.c.
 3622: 
 3623:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3624:                // especially for Flather b.c.
 3625:                double ri3 = 0.0;
 3626:                if (!side->isDry) {
 3627:                   // If the side is not dry
 3628:                   
 3629:                   // Computes the side flux of (uth, vth)
 3630:                   double Vn = 0.0;
 3631:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3632:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3633:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3634: 
 3635:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3636:                   }
 3637: 
 3638:                   ri3 = 0.5*side->len*Vn;
 3639:                }
 3640: 
 3641:                if (sideSegment->ifltype == -1) { // Flather 1
 3642: 
 3643:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3644:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3645: 
 3646:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3647:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3648:                   
 3649:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3650:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3651: 
 3652:                } 
 3653:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3654:                   // Reset ri3
 3655:                   ri3 = 0.0;
 3656: 
 3657:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3658: 
 3659:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3660: 
 3661:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3662:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3663: 
 3664:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3665:                   node1->addToSparseMatrix(node1, con0*2.0);
 3666:                   node1->addToSparseMatrix(node2, con0);
 3667: 
 3668:                } // if Flather or Discharge
 3669: 
 3670:                node1->qel -= thetai*dt*ri3;
 3671: 
 3672: 
 3673:             } // I_3
 3674:           
 3675: 
 3676:             // Integral I_5
 3677:             if(!side->isDry) {
 3678: 
 3679:                const double Unbar = dot(side->U, side->n);
 3680:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3681: 
 3682:             } // I_5
 3683: 
 3684:          } // if is boundary side
 3685: 
 3686:       } // for l
 3687: 
 3688:    } // if isbnd
 3689: 
 3690: 
 3691: }
 3692: 
