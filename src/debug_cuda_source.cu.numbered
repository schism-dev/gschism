 1311: // This struct is used to store the boundary information for a node.
 1312: struct NodeBoundary {   
 1313:    int idx;
 1314:    BoundarySegment *segment;
 1315:    Node *node;
 1316:    
 1317:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1318:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1319: 
 1320:    bool isLand;
 1321: 
 1322:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1323:    double elbc;   // Elevation boundary condition
 1324:    double eth;    // Elevation time history
 1325: 
 1326:    double eta_mean; // Mean elevation at nodes
 1327: 
 1328:    bool isEssentialBC;
 1329: 
 1330:    Vector2 uth[nvrt];  // "Time history" velocity
 1331: 
 1332:    // Arrays for harmonic constituents (if needed)
 1333:    double  emo[nbfr];  // Elevation amplitude
 1334:    double  efa[nbfr];  // Elevation phase
 1335:    Vector2 umo[nbfr];  // velocity amplitude
 1336:    Vector2 ufa[nbfr];  // velocity phase
 1337: 
 1338: 
 1339:    NodeBoundary(void) {
 1340:       isLand = false;
 1341:    }
 1342:    NodeBoundary(bool _isLand) {
 1343:       isLand = _isLand;
 1344:    }
 1345: 
 1346:    
 1347:    __forceinline__ __device__ int numSidesForAverage() const {
 1348:    // Returns the number of sides that are connected to the node and have the same segment.
 1349:    // This is used to compute the average velocity at the node for open boundary nodes.
 1350:       int res = 0;
 1351:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1352:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1353: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1354:       return res;
 1355:    }
 1356: 
 1357: 
 1358:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1359:       assert(index == 0 || index == 1); 
 1360:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1361:    }
 1362: 
 1363: 
 1364: };
 1365: 
 1366: struct Node {
 1367: 
 1368:    // Geometry information
 1369:    int idx;        // Index of the node
 1370:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1371:    int numNodes;   // Number of nodes neighbors of this node
 1372: 
 1373:    Element **elements; // Array of pointers to the elements that share this node
 1374:    int numElements;    // Number of elements that share this node
 1375: 
 1376:    int numSides;       // Number of sides that are connected to this node
 1377: 
 1378:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1379:    double gz;          // Global vertical coordinate at the node.
 1380:    Vector2 u2[nvrt];
 1381:    double  w2[nvrt];
 1382:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1383:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1384:    double lon, lat;
 1385:    double depth;
 1386: 
 1387:    Frame<ics> frame;
 1388: 
 1389:    LocalSigma<ivcor> localSigma;  
 1390: 
 1391:    int kb;       // Bottom index of the node
 1392: 
 1393:    bool isDry;     // True if the node is dry
 1394: 
 1395:    int iadv;     // Advection flag
 1396: 
 1397:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1398:                           // this is nullptr
 1399: 
 1400:    TempVar tmp; // Temporary variable to store different types of variables
 1401: 
 1402:    // Physical information
 1403:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1404:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1405: 
 1406:    double rho[nvrt];     // Density
 1407:    double dfv[nvrt];     // Vertical viscosity
 1408: 
 1409:    double eta1; // Elevation at nodes at previous timestep
 1410:    double eta2; // Elevation at nodes at current timestep
 1411: 
 1412:    double ETP;  // Earth Tidal Potential
 1413: 
 1414:    double pr;    // Air pressure
 1415:    double grav2; // Gravity 
 1416:    
 1417:    Vector2 dav;  // Depth averaged velocity
 1418: 
 1419:    Vector2 tau; // Wind stress vector
 1420: 
 1421:    // Vegetation parameters
 1422:    double veg_h;
 1423:    double veg_nv;
 1424:    double veg_di;
 1425:    double veg_Cd;
 1426:    double veg_h_unbent;
 1427:    double veg_di_unbent;
 1428:    double veg_nv_unbent;
 1429:    double veg_alpha_vert_mean;
 1430:    double veg_alpha0;
 1431:    double veg_alpha3D[nvrt];
 1432: 
 1433:    // Bottom drag parameters
 1434:    double Cd;       // Bottom drag coefficient   
 1435: 
 1436:    // These three are mutually exclusive
 1437:    union {
 1438:       double rmanning; // Bottom Manning's coefficient
 1439:       double rough;    // Bottom roughness length
 1440:       double drag;     // Bottom drag coefficient
 1441:    };
 1442:    Vector2 tau_bot; // Bottom stress vector
 1443: 
 1444:    // XXXX REMOVE FOR IMM>0???
 1445:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1446:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1447: 
 1448:    double qel; // RHS
 1449:    double coeffDiag; // Diagonal coefficient of the matrix
 1450:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1451: 
 1452:    // This was used by a previous version of the conjugate gradient method
 1453:    // double mP; // Search direction for conjugate gradient method
 1454:    // double mR; // Residual for conjugate gradient method
 1455:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1456: 
 1457:    double mX; // Solution of the FEM system
 1458: 
 1459:    // Meteorological forcing
 1460:    Vector2 u_air;
 1461:    double p_air;  // XXXX is this the same as pr?
 1462:    double t_air;
 1463:    double q_air;
 1464:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1465: 
 1466:    __device__ void setWind(Vector2 &u) {
 1467:    // Sets the wind vector taking into account the mesh angle
 1468:    
 1469:       const double speed = length(u);
 1470: 
 1471:       // Rotate wind vector to the node frame
 1472:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1473: 
 1474:       // Sets the surface stress vector due to wind.
 1475:       if constexpr(nws == 0) {
 1476:          tau = {0.0, 0.0};
 1477: 
 1478:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1479:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1480: 
 1481:       } else {
 1482: 
 1483:          double dragcoef;
 1484: 
 1485:          if constexpr(iwind_form == -1) {
 1486:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1487:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1488: 
 1489:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1490:             tau = cff*u_air;
 1491:  
 1492:          } else if constexpr(iwind_form == 1) {
 1493:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1494:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1495: 
 1496:             dragcoef = max(dragcoef, 4.0e-4);
 1497:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1498:             tau = cff*u_air;
 1499: 
 1500:          } else {
 1501:             tau = {0.0, 0.0};
 1502:          }
 1503:       }
 1504:    }
 1505: 
 1506: 
 1507:    __device__ void setFrame(double lat, double lon) {
 1508:       if constexpr(ics == 1) return;
 1509: 
 1510:       frame.update(lat, lon);        
 1511:     }
 1512: 
 1513:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1514: 
 1515:    __device__ double sigmaTransitionDepth(void) const;
 1516: 
 1517:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1518: 
 1519:    __inline__ __device__ Point2 outputCoords(void) const {
 1520:       if constexpr(ics == 1)  return p;
 1521:       else                    return {rad2deg*lon, rad2deg*lat};
 1522:    }
 1523: 
 1524:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1525:    // If ics == 2, convert the global point to the local frame
 1526:       
 1527:       if constexpr (ics == 1) {
 1528:          return p;
 1529:       } else {
 1530:          const Point3 c = {p.x, p.y, gz};
 1531:          const Point3 local = frame.G2L(p - c);
 1532:          return local;
 1533:       }
 1534:    }
 1535: 
 1536:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1537:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1538:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1539:    
 1540:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1541: 
 1542:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1543: 
 1544:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1545:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1546: 
 1547:    __device__ __forceinline__ void clearMatrixRow(void) {
 1548:       // Clear the matrix row for this node
 1549: 
 1550: 
 1551:       coeffDiag = 0.0;
 1552: 
 1553:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1554: 
 1555:    }
 1556: 
 1557:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1558:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1559:       
 1560:       if (node == this) {
 1561:          coeffDiag += value;
 1562:      
 1563:       } else {
 1564:          // Search (linearly)the index of the node in the array of nodes
 1565:          // XXX: This is not efficient, see if we can improve this
 1566:          int i;
 1567:          for (i = 0; i < numNodes; i++) {
 1568:             if (nodes[i] == node) {
 1569:                break;
 1570:             }
 1571:          }
 1572:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1573:          coeffMatrix[i] += value;
 1574:       }
 1575:    }
 1576: 
 1577: 
 1578:    __device__ __inline__ void updateZCoordData(void);
 1579: 
 1580:    __device__ __forceinline__ double compZCoord(int k) const;
 1581: 
 1582:    __device__ void updateKb(void);
 1583: 
 1584:    __device__ __forceinline__ void computeBottomDragCd(void);
 1585: 
 1586: 
 1587: 
 1588: };
