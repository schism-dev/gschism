 1648: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1649:    // Computes the 3D normal vector to the element at level k
 1650:    // Returns the normal vector and the area of the element
 1651: 
 1652:       if (isTri()) {
 1653:          // For triangles...
 1654: 
 1655:          // Gets the normal vector to the element (with a length equal to twice the area)
 1656:          if constexpr(ics==1) {
 1657:             const int kb0 = max(k, nodes[0]->kb);
 1658:             const int kb1 = max(k, nodes[1]->kb);
 1659:             const int kb2 = max(k, nodes[2]->kb);
 1660: 
 1661:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1662:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1663:             
 1664:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1665:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1666:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1667:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1668: 
 1669:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1670:             area3D = 0.5*len;
 1671: 
 1672:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1673: 
 1674:             return {nx/len, ny/len, nz/len};
 1675: 
 1676:            
 1677:          }
 1678:          else {  // lat/lon
 1679:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1680: 
 1681:          } // if ics
 1682:       }
 1683:       else {
 1684:          // For quads...
 1685: 
 1686:          assert(false && "Element normal vector: quads not yet implemented");
 1687: 
 1688: 
 1689:       }
 1690:    }
 1691: 
 1692: /**
 1693:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1694:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1695:    If the segment is completely inside the element, then it returns true.
 1696: 
 1697:    This function assumes:
 1698:    - The initial point is on a side of the element. 
 1699:    - Its position is given by parameter t in the range [0,1].
 1700:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1701:       intersects the element (elements are convex).
 1702: 
 1703:    To find the intersection point, this function does the following:
 1704:    - it finds the intersection of the line segment with all the element side lines,
 1705:       except for the one that contains the initial point.
 1706:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1707:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1708:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1709:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1710:       track segment is almost parallel to the element side line.
 1711: 
 1712:    Inputs:
 1713:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1714:    @param x2, y2: other end of the line segment
 1715: 
 1716:    Outputs:
 1717:    @param side:  side that intersects the line segment (input and output)
 1718:    @param nextElement (output): element that contains the intersection point
 1719:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1720:    @param zint (input/output): Vertical coordinate of the intersection point
 1721: 
 1722:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1723:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1724:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1725: 
 1726:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1727:    (Delta) being zero.
 1728: 
 1729:    The intersection2 point happens when:
 1730:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1731:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1732:    
 1733:    Assumption: the 4 points (including those of the side segment) are different.
 1734:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1735:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1736:    If true, (xIntersect,yIntersect) is the intersection.				
 1737:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1738: **/
 1739: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1740:                                               double &t, double& tIntersect) {
 1741: 
 1742:    double closest_intersect_t = 1e10;
 1743:    bool found_intersection = false;
 1744: 
 1745:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1746:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1747:    const Point2 x1 = side->point(t);
 1748:    
 1749: 
 1750:    Side *nextSide = nullptr;
 1751:    for (int i = 0; i < i34; i++) {
 1752: 
 1753:       // Element's i-th side 
 1754:       Side *side2 = sides[i];
 1755: 
 1756:       // Skip the side that contains the initial point
 1757:       if (side2 == side) continue;
 1758: 
 1759:       // (x3,y3)-(x4,y4) is the element side line
 1760:       const Point2 x3 = side2->n1->p2();
 1761:       const Point2 x4 = side2->n2->p2();
 1762: 
 1763:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1764:       const double delta = cross(x2 - x1, x3 - x4);
 1765: 
 1766:       if (delta != 0.0) {
 1767: 
 1768:          const double delta1 = cross(x3 - x1, x3 - x4);
 1769:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1770: 
 1771:          // Solves the two linear equations for tt1 and tt2
 1772:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1773:          const double tt2 = delta2/delta;
 1774: 
 1775:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1776:             closest_intersect_t = min(closest_intersect_t, tt1);
 1777:             nextSide = side2;
 1778: 
 1779:             nextElement = nextSide->otherElem(this);
 1780:             tIntersect = max(small, min(tt1, 1.0-small));
 1781:             t = tt2;
 1782: 
 1783:             found_intersection = true;
 1784:          }
 1785:       
 1786:       }
 1787: 
 1788:    }
 1789: 
 1790:    // found_intersection should always be true, since we checked all the sides.  
 1791:    side = nextSide;
 1792: 
 1793:    return found_intersection;
 1794: }
 1795: 
 1796: 
 1797: 
 1798: 
 1799: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1800:                                               double &t, double& tIntersect) {
 1801: 
 1802:    double closest_intersect_t = 1e10;
 1803:    bool found_intersection = false;
 1804: 
 1805:    for (int i = 0; i < i34; i++) {
 1806: 
 1807:       Side *side2 = sides[i];
 1808: 
 1809:       // (x3,y3)-(x4,y4) is the element side line
 1810:       const Point2 x3 = side2->n1->p2();
 1811:       const Point2 x4 = side2->n2->p2();
 1812: 
 1813:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1814:       const double delta = cross(x2 - x1, x3 - x4);
 1815: 
 1816:       if (abs(delta) > 0) {
 1817: 
 1818:          const double delta1 = cross(x3 - x1, x3 - x4);
 1819:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1820: 
 1821:          // Solves the two linear equations for tt1 and tt2
 1822:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1823:          const double tt2 = delta2/delta;
 1824: 
 1825:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1826:             closest_intersect_t = min(closest_intersect_t, tt1);
 1827:             side = side2;
 1828:             nextElement = side->otherElem(this);
 1829:             t = tt2;
 1830:             tIntersect = max(small, min(tt1, 1.0-small));
 1831:             found_intersection = true;
 1832:          }
 1833:       
 1834:       }
 1835:       else {  // parallel segments
 1836:          assert(false && "Parallel segments");
 1837:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1838:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1839: 
 1840:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1841: 
 1842:          // const double dist = dot(x1 - x3, side2->n);
 1843:          // if (abs(dist) < small*length(x3 - x4)) {
 1844:          //    const double2 unitarySide = normalize(x4 - x3);
 1845:          //    const double len = dot(x2 - x1, unitarySide);
 1846:          //    t = t + len;
 1847:          //    t = max(0.0, min(t, 1.0));
 1848:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1849: 
 1850: 
 1851:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1852:          //    // t = tt2;
 1853:          //    found_intersection = true;
 1854:          // }
 1855:       }
 1856: 
 1857: 
 1858:    }
 1859: 
 1860:       
 1861:    assert(found_intersection && "No intersection found");
 1862: 
 1863:    // found_intersection should always be true, since we checked all the sides.  
 1864:    return found_intersection;
 1865: }
 1866: 
 1867: 
 1868: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1869:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1870: 
 1871:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1872: 
 1873:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1874:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1875:    // curElement.
 1876: 
 1877:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1878:    // And uses this velocity instead to continue the tracking.
 1879: 
 1880:    // computes the intersection point in cartesian coordinates
 1881:    Point2 intersection = nextSide->p_t(tt);
 1882: 
 1883:    // Nudges the point to the barycenter of the element. 
 1884:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1885:    // next segment intersects the element sides.  
 1886:    curElem->nudgeToBarycenter(intersection);
 1887: 
 1888:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1889:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1890:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1891:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1892: 
 1893:    // If the side is an open boundary, the tangential velocity is zero.
 1894:    if (nextSide->isBnd()) vtan = 0.0;
 1895: 
 1896:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1897:    const double us = vtan*nextSide->t().x;
 1898:    const double vs = vtan*nextSide->t().y;
 1899:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1900: 
 1901:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1902:    const double len2 = norm2(intersection - toPoint2(xt));
 1903:    const double vel2 = dot(u_int, u_int);        
 1904:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1905:    else            dt = 0.0;
 1906: 
 1907:    // The end of this tracking segment is now the intersection point.
 1908:    xt = {intersection.x, intersection.y, zint};
 1909: 
 1910:    u_int = {us, vs, ws};
 1911:    
 1912: }
 1913: 
 1914: /**
 1915:  * Tracks a particle through elements and vertical levels in the mesh.
 1916:  * 
 1917:  * @param x0,y0,z0     Starting position coordinates
 1918:  * @param xt,yt,zt     Target position coordinates
 1919:  * @param dtb          Time step for tracking
 1920:  * @param uuint,vvint,wwint Initial velocity components
 1921:  * @param nextElem     Starting/resulting element index
 1922:  * 
 1923:  * @return Status code of type trackExitCodes
 1924:  * 
 1925:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1926:  * of the details are different. The idea is that the code requires less branches and is better fit
 1927:  * for GPU execution.
 1928:  * 
 1929:  * The main ideas here are:
 1930:  * - The starting point is expected to be in the starting element.
 1931:  * - The end point is guaranteed to be inside an element.
 1932:  * - since the starting point is inside the element, there are only two cases: 
 1933:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1934:  *     (b) it does not and (xt,yt) is already in the starting element.
 1935:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1936:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1937:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1938:  * - tt1 can be positive or negative. We only consider the positive values.
 1939:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1940:  * - The next intersection will occur at the smallest positive tt1.
 1941:  * - This intersection will be the next (x0,y0) position.
 1942:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1943:  *   of getting stuck in a loop.
 1944:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1945:  *   was found.
 1946:  */
 1947: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1948:                                                        Element *&nextElem, int &jlev, double &dt,
 1949:                                                        const Side *origSide) {
 1950: 
 1951: 
 1952: 
 1953:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1954:    // else to do.
 1955:    // If it is, nudges the point to be inside the element.
 1956:    const Element *curElem = nextElem;
 1957:    if (containsPoint(toPoint2(xt), true)) {
 1958: 
 1959:       curElem->interpolateVelocities(xt, u_int);
 1960: 
 1961: addDebugPlot(x0, xt);
 1962:       return true;
 1963:    }
 1964: 
 1965:    Side *side = nullptr;
 1966: 
 1967:    // 1. Initial checks
 1968:    // Verify starting element is valid (wet)
 1969:    assert(!curElem->isDry && "Starting element is dry");
 1970: 
 1971:    // Checks if track has a zero length.
 1972:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1973:    // assert(len2 > 0.0 && "Zero length track"); 
 1974:    
 1975:    const int MAX_ITERATIONS = 1000;
 1976:    
 1977:    double t;
 1978:    Side *nextSide = nullptr;
 1979:    double tIntersect = 1e10;
 1980:    double zint = x0.z;
 1981: 
 1982:    // Horizontal tracking loop
 1983:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1984:    // (x0,y0) is inside the element but the target point is not.
 1985: 
 1986:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1987: 
 1988:    assert(found_intersection && "No intersection found at %d");
 1989: 
 1990:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1991: 
 1992:    // if the tracking segment goes out of water (either dry or edge boundary)
 1993:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1994: 
 1995: addDebugPlot(x0, xt, 0x00A0FF);
 1996:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1997: addDebugPlot(x0, xt, 0x00A0FF);      
 1998: 
 1999:       nextElem = this;
 2000:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2001:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2002:       return true;    
 2003:    }
 2004: 
 2005: 
 2006:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2007:    int iterations = 0;
 2008:    while (iterations < MAX_ITERATIONS) {
 2009:       iterations++;
 2010:       
 2011:       Element *curElem = nextElem;
 2012: 
 2013:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2014: addDebugPlot(x0, xt);
 2015:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2016: 
 2017:       // If we are already in the target element, we are done.
 2018:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2019:       if (!found_intersection) break;
 2020: 
 2021: 
 2022: 
 2023:       // if the tracking segment goes out of water (either dry or edge boundary).
 2024:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2025: addDebugPlot(x0, xt, 0x00A0FF);
 2026:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2027: addDebugPlot(x0, xt, 0x00A0FF);   
 2028:          nextElem = curElem;
 2029: 
 2030:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2031:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2032:          return true;
 2033:       }
 2034:       
 2035:       // Update position and element for next iteration
 2036:       side = nextSide;
 2037: 
 2038:    }
 2039: 
 2040:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2041: 
 2042:  
 2043:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2044:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2045: addDebugPlot(x0, xt);   
 2046:    nextElem->interpolateVelocities(xt, u_int); 
 2047: 
 2048:    return true;
 2049: }
 2050: 
 2051: 
 2052: __inline__ __device__ double Element::computeSignedArea(void) const {
 2053:    // Compute the area of the element
 2054: 
 2055:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2056: 
 2057:    // In the quad case we need to add the area of the other triangle.
 2058:    if (isQuad()) {
 2059:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2060:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2061:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2062:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2063:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2064:          Error("Negative area found in quad element");
 2065:       }
 2066:       res += ar1;
 2067:    }
 2068: 
 2069:    return res;
 2070: }
 2071: 
 2072: 
 2073: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2074:                                                                 (nodes[1]->isDry2()) ||
 2075:                                                                 (nodes[2]->isDry2()) ||
 2076:                                                                 (i34==4 && nodes[3]->isDry2());
 2077: }
