 5338:    __global__ void resetBoundaryAreas(void) {
 5339:       // Reset boundary areas and lengths for each segment.
 5340: 
 5341:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5342:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5343:       SIDE_BND(sideBnd);
 5344: 
 5345:       BoundarySegment *segment = sideBnd->segment;
 5346: 
 5347:       segment->carea = 0.0;
 5348:       segment->clen = 0.0;
 5349:  
 5350:    }
 5351: 
 5352:    __global__ void computeBoundaryAreas(void) {
 5353:    // Calculation of cross-section areas and lengths for flow b.c.
 5354: 
 5355:       SIDE_BND(sideBnd);
 5356: 
 5357:       const Side *side = sideBnd->side;
 5358:       BoundarySegment *segment = sideBnd->segment;
 5359: 
 5360:       if (segment->ifltype != 0) {
 5361: 
 5362:          const Node *n1 = side->n1;
 5363:          const Node *n2 = side->n2;
 5364: 
 5365:          const double htot = side->htot2();
 5366: 
 5367:          if (!side->isDry) {
 5368:             atomicAdd(&segment->carea, htot*side->len);
 5369:             atomicAdd(&segment->clen, side->len);
 5370:          }
 5371:       }
 5372: 
 5373:    }
 5374: 
 5375: 
 5376:    __global__ void computeFlowBcVelocities(double time) {
 5377: 
 5378:       SIDE_BND(sideBnd);
 5379: 
 5380:       const Side *side = sideBnd->side;
 5381:  
 5382:       const bool isDry = side->isDry;
 5383:       const bool isLand = sideBnd->segment->isLand;
 5384: 
 5385:    
 5386:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5387: 
 5388:       if (isDry || isLand) return;
 5389: 
 5390:       // For wet sides in open boundaries...
 5391:       const Vector2 n = side->n;
 5392:       const BoundarySegment *segment = sideBnd->segment;
 5393: 
 5394:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5395: 
 5396:       const int ifltype = segment->ifltype;
 5397: 
 5398:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5399:       const Vector2 r_nuth0 = r_uth0*n;
 5400: 
 5401: 
 5402:       if (ifltype == 1 || ifltype == 2) {
 5403:       
 5404:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5405: 
 5406:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5407:          
 5408:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5409:          
 5410:       } else if (ifltype == -1) { // Flather 1
 5411: 
 5412:          for (int k = 0; k < nvrt; k++) {
 5413: 
 5414:             // uth is the normal vel.; no ramp up
 5415:             const double uth = sideBnd->nuth(k);
 5416:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5417: 
 5418:             sideBnd->ubc[k] += uth*n;
 5419:          }
 5420: 
 5421:       } else if (ifltype == 3 || ifltype == 5) {
 5422:          // vnth0=0 !normal vel.
 5423: 
 5424:          Vector2 r_u1_bar = {0.0, 0.0};
 5425:          // Computes the contribution to the velocity from all tide frequencies
 5426:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5427: 
 5428:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5429:             const Vector2 umo  = sideBnd->umo(jfr); 
 5430: 
 5431:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5432:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5433:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5434:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5435: 
 5436:          }
 5437: 
 5438: 
 5439:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5440: 
 5441:       } // if (ifltype = 3 || ifltype == 5
 5442: 
 5443: 
 5444: 
 5445:    }
 5446: 
 5447:    __global__ void computeElevationBoundaryConditions(double time) {
 5448:       // Compute elevation essential boundary conditions 
 5449: 
 5450:       NODE_BND(nodeBnd); // Each boundary node.
 5451: 
 5452:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5453: 
 5454:       const Node *node = nodeBnd->node;
 5455:       const BoundarySegment *segment = nodeBnd->segment;
 5456:       const int iettype = segment->iettype;
 5457:       
 5458: 
 5459:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5460:       double eic = 0.0;
 5461:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5462:       else                 eic = 0.0;
 5463: 
 5464:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5465:       const double r_eth = ramp*nodeBnd->eth;
 5466:       double r_eta1_bar = 0.0;
 5467: 
 5468:       // Compute tide elevation
 5469:       if (iettype == 3 || iettype == 5) {   
 5470: 
 5471:          if constexpr(iloadtide==1) { // loading tide
 5472:             assert(false && "Loading tide not implemented");
 5473:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5474:          }
 5475:          
 5476:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5477: 
 5478:             const double efa  = nodeBnd->efa[jfr]; 
 5479:             const double emo  = nodeBnd->emo[jfr]; 
 5480: 
 5481:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5482:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5483:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5484: 
 5485: 
 5486:          } // for jfr
 5487: 
 5488:       } // if iettype
 5489: 
 5490:       switch (iettype) {
 5491:          case 1:
 5492:          case 2:
 5493:          case 4:
 5494:             nodeBnd->elbc = r_eic + r_eth;
 5495:             break;
 5496:          case 3:
 5497:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5498:             break;
 5499:          case 5:
 5500:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5501:             break;
 5502:       } // switch
 5503: 
 5504: 
 5505:       //Add inverse barometric effects
 5506:       if (iettype != 0 && inv_atm_bnd == 1) {
 5507:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5508:       }
 5509: 
 5510:    }
 5511: 
 5512: 
 5513:    __global__ void computeHorizontalViscosity(void) { 
 5514: 
 5515:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5516: 
 5517:       SIDE(side);
 5518: 
 5519:       if (side->isDry) return;
 5520: 
 5521:       for (int k = 0; k < nvrt; k++) {
 5522:          side->nuGradU[k] = {0.0, 0.0};
 5523:       }
 5524: 
 5525:       if constexpr(ihorcon == 1) {
 5526:          for (int k = side->kb; k < nvrt - 1; k++) {
 5527:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5528:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5529:             // By Zhang and Baptista.
 5530: 
 5531:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5532:             // This is a standard discretization of the Laplacian operator.
 5533:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5534:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5535:             // Gamma is hvis_coef0 in the code.
 5536:             // The value of gamma needs to be < 0.5.
 5537: 
 5538:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5539:             // side under consideration in each of the two possible elements that share the side.
 5540:             Vector2 sumU = {0.0, 0.0};
 5541:             for (int l = 0; l < 2; l++) {
 5542:                const Element *elem = side->elems[l];
 5543: 
 5544:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5545: 
 5546:                // Find the local index of the side in the element
 5547:                const int idxSide = elem->sideLocalIdx(side);
 5548: 
 5549:                // Find the two sides that are connected to the side under consideration
 5550:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5551:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5552: 
 5553:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5554: 
 5555:             }
 5556: 
 5557:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5558: 
 5559:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5560:    
 5561:          }
 5562:       }
 5563:       else if constexpr(ihorcon == 2) {
 5564:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5565:       }
 5566: 
 5567: 
 5568:    }
 5569: 
 5570: 
 5571:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5572: 
 5573:       // Set essential boundary conditions 
 5574:       NODE(node); // Each boundary node
 5575:       NodeBoundary *nodeBnd = node->nodeBnd;
 5576:       
 5577:  
 5578:       // Check if this node has essential BC
 5579:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5580:          // Verify BC value is valid
 5581:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5582: 
 5583:        
 5584:          // Set diagonal to 1 and zero off-diagonals
 5585:          node->coeffDiag = 1.0;
 5586: 
 5587:          for (int j = 0; j < node->numNodes; j++) {
 5588:                node->coeffMatrix[j] = 0.0;
 5589:          }
 5590:          
 5591:          // Set solution and RHS to BC value
 5592:          node->mX  = nodeBnd->elbc;
 5593:          node->qel = nodeBnd->elbc;
 5594: 
 5595:       } else {
 5596:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5597: 
 5598:          for (int j = 0; j < node->numNodes; j++) {
 5599:                Node* nbNode = node->nodes[j];
 5600:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5601:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5602:                   // Verify neighbor's BC value
 5603:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5604: 
 5605:                   // Subtract contribution to RHS
 5606:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5607:                   node->coeffMatrix[j] = 0.0;  
 5608:                }
 5609:          }
 5610:       }
 5611:    }
 5612: 
 5613: 
 5614:    __global__ void updateElevation(void) {
 5615:       NODE(node);
 5616: 
 5617: 
 5618:       node->eta2 = node->mX;
 5619: 
 5620:       node->updateZCoordData();
 5621:    }
