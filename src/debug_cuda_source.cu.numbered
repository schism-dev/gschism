  861: 
  862:    
  863:    __forceinline__ __device__ void projectNodeVectorsToElementFrame(Vector2 *v) const;
  864:    __forceinline__ __device__ void projectSideVectorsToElementFrame(Vector2 *v) const;
  865: 
  866: 
  867:    template<typename T>
  868:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const;
  869: 
  870:    template<typename T>
  871:    __device__ __forceinline__ T interpolate(const double shapeCoords[4], T Node::* field) const;
  872: 
  873:    template<typename T>
  874:    __device__ __forceinline__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const;
  875: 
  876:    template<typename T>
