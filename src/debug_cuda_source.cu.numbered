 2042: __device__ void lock(int *mutex) {
 2043:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2044: }
 2045: 
 2046: __device__ void unlock(int *mutex) {
 2047:     atomicExch(mutex, 0);
 2048: }
 2049: 
 2050: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2051: // return;   
 2052:    // Lock the mutex
 2053:    lock(&debugPlotMutex);
 2054:  
 2055:    bool ok = true;
 2056:    if (debugPlotIdx == nullptr) ok = false;
 2057:    if (*debugPlotIdx >= 1000000) ok = false;
 2058:    if (ok) {
 2059:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2060:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2061:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2062:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2063:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2064:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2065:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2066:       (*debugPlotIdx)++;
 2067:    }
 2068: 
 2069:    __threadfence();               // ensure all above writes are visible
 2070:    // Unlock the mutex
 2071:    unlock(&debugPlotMutex);
 2072: 
 2073: }
