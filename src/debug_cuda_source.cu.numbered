 1909: 
 1910: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1911:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1912: 
 1913:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1914: 
 1915:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1916:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1917:    // curElement.
 1918: 
 1919:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1920:    // And uses this velocity instead to continue the tracking.
 1921: 
 1922:    // computes the intersection point in cartesian coordinates
 1923:    Point2 intersection = nextSide->p_t(tt);
 1924: 
 1925:    // Nudges the point to the barycenter of the element. 
 1926:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1927:    // next segment intersects the element sides.  
 1928:    curElem->nudgeToBarycenter(intersection);
 1929: 
 1930:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1931:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1932:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1933:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1934: 
 1935:    // If the side is an open boundary, the tangential velocity is zero.
 1936:    if (nextSide->isBnd()) vtan = 0.0;
 1937: 
 1938:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1939:    const double us = vtan*nextSide->t().x;
 1940:    const double vs = vtan*nextSide->t().y;
 1941:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1942: 
 1943:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1944:    const double len2 = norm2(intersection - toPoint2(xt));
 1945:    const double vel2 = dot(u_int, u_int);        
 1946:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1947:    else            dt = 0.0;
 1948: 
 1949:    // The end of this tracking segment is now the intersection point.
 1950:    xt = {intersection.x, intersection.y, zint};
 1951: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1952:    u_int = {us, vs, ws};
 1953:    
 1954: }
 1955: 
 1956: /**
 1957:  * Tracks a particle through elements and vertical levels in the mesh.
 1958:  * 
 1959:  * @param x0,y0,z0     Starting position coordinates
 1960:  * @param xt,yt,zt     Target position coordinates
 1961:  * @param dtb          Time step for tracking
 1962:  * @param uuint,vvint,wwint Initial velocity components
 1963:  * @param nextElem     Starting/resulting element index
 1964:  * 
 1965:  * @return Status code of type trackExitCodes
 1966:  * 
 1967:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1968:  * of the details are different. The idea is that the code requires less branches and is better fit
 1969:  * for GPU execution.
 1970:  * 
 1971:  * The main ideas here are:
 1972:  * - The starting point is expected to be in the starting element.
 1973:  * - The end point is guaranteed to be inside an element.
 1974:  * - since the starting point is inside the element, there are only two cases: 
 1975:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1976:  *     (b) it does not and (xt,yt) is already in the starting element.
 1977:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1978:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1979:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1980:  * - tt1 can be positive or negative. We only consider the positive values.
 1981:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1982:  * - The next intersection will occur at the smallest positive tt1.
 1983:  * - This intersection will be the next (x0,y0) position.
 1984:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1985:  *   of getting stuck in a loop.
 1986:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1987:  *   was found.
 1988:  */
 1989: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1990:                                                        Element *&nextElem, int &jlev, double &dt,
 1991:                                                        const Side *origSide) {
 1992: 
 1993: 
 1994:    if (origSide->idx == 7) {
 1995:       printf("AAAA&&&& origSide->idx = %d, u_int = %f,%f,%f, x0 = %f,%f,%f, xt = %f,%f,%f\n", origSide->idx, u_int.x, u_int.y, u_int.z, x0.x, x0.y, x0.z, xt.x, xt.y, xt.z);
 1996:    }
 1997:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1998:    // else to do.
 1999:    // If it is, nudges the point to be inside the element.
 2000:    const Element *curElem = nextElem;
 2001:    if (containsPoint(toPoint2(xt), true)) {
 2002: 
 2003:       curElem->interpolateVelocities(xt, u_int);
 2004: addDebugPlot(x0, xt);
 2005:       return true;
 2006:    }
 2007: 
 2008:    Side *side = nullptr;
 2009: 
 2010:    // 1. Initial checks
 2011:    // Verify starting element is valid (wet)
 2012:    assert(!curElem->isDry && "Starting element is dry");
 2013: 
 2014:    // Checks if track has a zero length.
 2015:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2016:    // assert(len2 > 0.0 && "Zero length track"); 
 2017:    
 2018:    const int MAX_ITERATIONS = 1000;
 2019:    
 2020:    double t;
 2021:    Side *nextSide = nullptr;
 2022:    double tIntersect = 1e10;
 2023:    double zint = x0.z;
 2024: 
 2025:    // Horizontal tracking loop
 2026:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2027:    // (x0,y0) is inside the element but the target point is not.
 2028: 
 2029:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2030: 
 2031:    assert(found_intersection && "No intersection found at %d");
 2032: 
 2033:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2034: 
 2035:    // if the tracking segment goes out of water (either dry or edge boundary)
 2036:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2037: 
 2038: addDebugPlot(x0, xt, 0x00A0FF);
 2039: printf("BBBXXXX going out of water\n");
 2040:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2041: addDebugPlot(x0, xt, 0x00A0FF);      
 2042: 
 2043:       nextElem = this;
 2044:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2045:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2046:       return true;    
 2047:    }
 2048: 
 2049: 
 2050:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2051:    int iterations = 0;
 2052:    while (iterations < MAX_ITERATIONS) {
 2053:       iterations++;
 2054: printf("BBBXXXX iterations = %d\n", iterations);      
 2055:       
 2056:       Element *curElem = nextElem;
 2057: 
 2058:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2059: addDebugPlot(x0, xt);
 2060:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2061: 
 2062:       // If we are already in the target element, we are done.
 2063:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2064:       if (!found_intersection) break;
 2065: 
 2066: 
 2067: 
 2068:       // if the tracking segment goes out of water (either dry or edge boundary).
 2069:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2070: addDebugPlot(x0, xt, 0x00A0FF);
 2071: printf("BBBXXXX going out of water\n");
 2072:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2073: addDebugPlot(x0, xt, 0x00A0FF);   
 2074:          nextElem = curElem;
 2075: 
 2076:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2077:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2078:          return true;
 2079:       }
 2080:       
 2081:       // Update position and element for next iteration
 2082:       side = nextSide;
 2083: 
 2084:    }
 2085: 
 2086:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2087: 
 2088:  
 2089:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2090:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2091: addDebugPlot(x0, xt);   
 2092: printf("MMMMMM nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2093:    nextElem->interpolateVelocities(xt, u_int); 
 2094: printf("MMMMMM2 nextElem->idx = %d, u_int = %f,%f,%f\n", nextElem->idx, u_int.x, u_int.y, u_int.z);
 2095: 
 2096:    return true;
 2097: }
 2098: 
 2099: 
 2100: __inline__ __device__ double Element::computeSignedArea(void) const {
 2101:    // Compute the area of the element
 2102: 
 2103:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2104: 
 2105:    // In the quad case we need to add the area of the other triangle.
 2106:    if (isQuad()) {
 2107:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2108:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2109:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2110:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2111:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2112:          Error("Negative area found in quad element");
 2113:       }
 2114:       res += ar1;
 2115:    }
 2116: 
 2117:    return res;
 2118: }
 2119: 
 2120: 
 2121: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2122:                                                                 (nodes[1]->isDry2()) ||
 2123:                                                                 (nodes[2]->isDry2()) ||
 2124:                                                                 (i34==4 && nodes[3]->isDry2());
 2125: }
