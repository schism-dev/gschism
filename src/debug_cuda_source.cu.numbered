 1619: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 1620:    // For imm=2, user needs to update bottom depth and velocity
 1621: 
 1622:    dep = min(1.0, 7.0 - (x0 + time));
 1623:    vel = { -1.0, 0.0, 0.0 };
