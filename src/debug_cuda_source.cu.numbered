  985: struct Side {
  986: 
  987:    // Geometry information
  988:    int idx;               // Index of the side
  989:    Node *n1, *n2;
  990:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  991: 
  992:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  993:    Vector2 center;        // Location of side center. 
  994:    double zc[nvrt];       // Side center z-coord at each vertical level
  995: 
  996: #ifdef USE_FRAMES
  997:    Frame frame;
  998: #endif
  999: 
 1000:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1001:                           // this is nullptr
 1002:    
 1003:    int kb;                // Bottom index of the side
 1004:    bool isDry;            // True if the side is dry
 1005:  
 1006:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1007: 
 1008:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1009: 
 1010:    // Physical information
 1011:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1012:    Vector2 btu[nvrt];           // Back-tracked velocity
 1013:    Vector2 U;                   // Vertically averaged velocity vector  
 1014: 
 1015:    Vector2 nuGradU[nvrt];          // nu*grad u
 1016: 
 1017:    Vector2 bcc[nvrt];           // Baroclinic term
 1018:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1019: 
 1020:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1021:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1022:    Vector2 gradPr;               // Gradient of pressure
 1023:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1024: 
 1025: 
 1026:    double hhat;                 // \breve{H} in notes
 1027: 
 1028:    double shapiro;
 1029: 
 1030:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1031: 
 1032:    double coriolis;             // Coriolis parameter
 1033: 
 1034:    // Vegetation parameters
 1035:    double veg_c2;
 1036:    double veg_beta;
 1037: 
 1038:    // Bottom drag parameters.
 1039:    double chi;
 1040:    double chi2;
 1041: 
 1042:    __inline__ __device__ double x(double t) const;
 1043:    __inline__ __device__ double y(double t) const;
 1044:    __inline__ __device__ double lon(void) const;
 1045:    __inline__ __device__ double lat(void) const;
 1046:    __inline__ __device__ Point2 p_t(double t) const;
 1047: 
 1048:    #ifdef USE_FRAMES
 1049:    __device__ void setFrame(void) {
 1050:       double lat, lon;
 1051:       const Point3 p = toPoint3(center, centerZ());
 1052: 
 1053:       // Compute the latitude and longitude of the element center
 1054:       computeLatLon(p, lat, lon);
 1055: 
 1056:       frame.update(lat, lon);        
 1057:    }
 1058:    #endif
 1059: 
 1060:    __inline__ __device__ double centerZ(void)   const;
 1061:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1062:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1063:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1064: 
 1065:    __inline__ __device__ Side* neigh(int index) const { 
 1066:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1067:       assert(index >= 0 && index < 4); 
 1068:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1069: 
 1070:       const int ielem = index & 1;           // 0 or 1
 1071:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1072: 
 1073:       const Element* elem = elems[ielem];
 1074: 
 1075:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1076: 
 1077:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1078: 
 1079:    }
 1080: 
 1081:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1082: 
 1083:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1084: 
 1085:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1086:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1087:    __inline__ __device__ int iadv(void) const;
 1088: 
 1089:    __inline__ __device__ double grav3(void) const;
 1090:    
 1091:    __inline__ __device__ double eta2(void) const;
 1092:    __inline__ __device__ double eta1(void) const;
 1093:    __inline__ __device__ double w2(int k) const;
 1094:    __inline__ __device__ double depth(void) const;
 1095:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1096:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1097: 
 1098:    __inline__ __device__ double dfv(int k) const;
 1099: 
 1100:    __inline__ __device__ double veg_h(void)  const;
 1101:    __inline__ __device__ double veg_nv(void) const;
 1102:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1103:    __inline__ __device__ double veg_alpha3D(int k) const;
 1104:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1105: 
 1106:    __inline__ __device__ double Cd(void) const;
 1107: 
 1108:    __inline__ __device__ Vector2 tau(void) const;
 1109: 
 1110:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1111:    
 1112: 
 1113:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1114:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1115:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1116:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1117:    } 
 1118:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1119:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1120:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1121:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1122: 
 1123:    // Get valid starting element (for backtracking)
 1124:    __inline__ __device__ Element* getStartElement() {
 1125:       return elems[0] ? elems[0] : elems[1];
 1126:    }
 1127: 
 1128:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1129:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1130:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1131: 
 1132:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1133: 
 1134:       // Dot product of the negative velocity vector with the side normal vector
 1135:       const double dot_prod1 = -dot(u, n);
 1136: 
 1137:       // Vector from side center to element 0 centroid
 1138:       const Vector2 v2 = elems[0]->center - center;
 1139: 
 1140:       // Dot product of the vector with the side normal vector
 1141:       const double dot_prod2 = dot(v2, n);
 1142: 
 1143:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1144:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1145: 
 1146:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1147:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1148: 
 1149:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1150: 
 1151:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1152:       else                           return !isDry1 ? elems[1] : elems[0];
 1153: 
 1154:  
 1155:    }
 1156: 
 1157:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1158:       // Given an element, returns the other element that shares this side
 1159:       return (elems[0] == elem) ? elems[1] : elems[0];
 1160:    }
 1161: 
 1162:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1163:       // Given a node, returns the other node that shares this side
 1164:       return (n1 == node) ? n2 : n1;
 1165:    }
 1166:  
 1167:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1168: 
 1169: 
 1170: 
 1171: 
 1172: };
 1173: 
