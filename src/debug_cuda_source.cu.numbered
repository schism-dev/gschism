 2594: /**
 2595:  * This method performs backtracking from the side center until a time -dt back in time 
 2596:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2597:  * intermediate point.
 2598:  *
 2599:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2600:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2601:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2602:  * remaining time.
 2603:  * 
 2604:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2605:  * 
 2606:  * @param uuint, vvint, wwint: Velocities at the final point
 2607:  * @param jlev: Level at which the backtracking is performed
 2608:  * @param dt, dtbk: Tracking timesteps
 2609:  * @return: True if the backtracking was successful, false otherwise
 2610:  */
 2611: __inline__ __device__ bool Side::btrack(
 2612:       int jlev,
 2613:       double dt,            // Tracking time
 2614:       double dtbk,          // Tracking timestep
 2615:       Vector3 &u_int        // Velocities at the initial point
 2616: ) const {
 2617: 
 2618:    // Start from side center
 2619:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2620: 
 2621:  
 2622:    double time_rm = dt; // Remaining time
 2623: 
 2624: 
 2625:    // // Initialize outputs XXX
 2626:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2627:    //    sclr[i] = 0.0;
 2628:    // }
 2629: 
 2630: 
 2631:    // Initial velocities
 2632:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2633: 
 2634:    // Find the element that is in the direction opposite to the velocity
 2635:    Element* curElem = findElementTowards(toVector2(u_int));
 2636: 
 2637: 
 2638:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2639:    if (curElem == nullptr) {
 2640:       // Make velocity parallel to the side
 2641:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2642:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2643:       curElem = otherElem(curElem);
 2644:       
 2645:    }
 2646: 
 2647: // Nudges it towards the circumcenter
 2648: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2649: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2650:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2651: const double eps = 9.013e-3;                 
 2652: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2653: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2654: 
 2655: 
 2656: 
 2657:    const int MAX_ITERATIONS = 1000; 
 2658:    Element* nextElem = curElem;
 2659:    int iter = 0;
 2660:    while(true) {
 2661: 
 2662:       // Calculate timestep
 2663:       double dtb = min(dtbk, time_rm);
 2664: 
 2665:       // Next point in the backtracking curve
 2666:       Point3 xt = x0 - dtb*u_int;
 2667:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2668:       assert(found && "Backtracking failed in btrack");
 2669: 
 2670:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2671: 
 2672:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2673:                       // then time_rm needs to be increased by the unused time.
 2674: 
 2675:       // If the velocity is too small, we stop the backtracking
 2676:       const double vmag = length(toVector2(u_int));
 2677:       if (vmag <= velmin_btrack) break;
 2678: 
 2679:       // The current point becomes the next segment's starting point.
 2680:       x0 = xt;
 2681:  
 2682:       curElem = nextElem;
 2683: 
 2684:       iter++;
 2685:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2686:    }
 2687: 
 2688: 
 2689: }
 2690: 
 2691: 
