 1750: // Helper functions for computing the local node index at a given offset from another.
 1751: __device__ __inline__ int nxq(int offset, int index, int size) {
 1752:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1753:    // to the index to make it positive
 1754:    assert(index + offset + 16*size >= 0);
 1755:    return (index + offset + 16*size) % size;  
 1756: }
 1757: 
 1758: __device__ __inline__ int nxq(int index, int size) {
 1759:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1760:    // to the index to make it positive
 1761:    assert(index + 16*size >= 0);
 1762:    return (index + 16*size) % size; 
 1763: }
