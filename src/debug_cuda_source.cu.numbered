 1456:    __device__ void populateMesh(int *i34, int *elnode, int *elside,
 1457:                    double *node_coords, double *node_coords_ll, bool use_ll,
 1458:                    double *wind_rotate_angle, 
 1459:                    int *isdel, int *isidenode, int *isbnd,
 1460:                    int *nond, int *nlnd, int *iond, int *ilnd,
 1461:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 1462:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 1463:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 1464:                    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 1465:                    int *localNodePart,     int *localElemPart,     int *localSidePart,
 1466:                    double *drag, double *roughness,
 1467:                    double *emo, double *efa, 
 1468:                    double *umo, double *ufa, 
 1469:                    double *vmo, double *vfa);
 1470: 
 1471: 
 1472:    __device__ ~Mesh(void)
 1473:    {
 1474:    }
 1475: 
 1476:    __device__ void test(double x, double y, double z)
 1477:    {
 1478:       printf("Testing mesh for partition %d, x=%f, y=%f\n", partNum, x, y);
 1479:       for (int i = 0; i < ne; i++) {
 1480:          auto isInside = localElemData[i].containsPoint({x, y});
 1481: 
 1482:          if (isInside) {
 1483:             printf("Point %f %f %f is inside element %d\n", x, y, z, i);
 1484:             Element *elem = &localElemData[i];
 1485:             
 1486:             Vector3 u_int;
 1487: 
 1488:             // Choose the first side
 1489:             Side *side = elem->sides[0];
 1490:             int jlev = 5;  
 1491:             // RECORDAR:
 1492:             // - con y=0 no encuentra el triangulo
 1493:             // - jlev = 5, z = 0.1...
 1494:             side->btrack(5, 3000.0, 3.1, u_int);
 1495: 
 1496:          }
 1497:       }
 1498:    } 
 1499: 
 1500: }; // End of Mesh class
 1501: 
 1502: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1503:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1504: }
 1505: 
 1506: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1507:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1508: }   
 1509: 
 1510: __device__ __inline__ double min3(double a, double b, double c) {
 1511:    return min(a, min(b, c));
 1512: }
 1513: 
 1514: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1515:    return min(a, min(b, min(c, d)));
 1516: }
