 1211: struct Node {
 1212: 
 1213:    // Geometry information
 1214:    int idx;        // Index of the node
 1215:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1216:    int numNodes;   // Number of nodes neighbors of this node
 1217: 
 1218:    Element **elements; // Array of pointers to the elements that share this node
 1219:    int numElements;    // Number of elements that share this node
 1220: 
 1221:    int numSides;       // Number of sides that are connected to this node
 1222: 
 1223:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1224:    double gz;          // Global vertical coordinate at the node.
 1225:    Vector2 u2[nvrt];
 1226:    double  w2[nvrt];
 1227:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1228:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1229:    double lon, lat;
 1230:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1231:    double depth;
 1232: 
 1233: #ifdef USE_FRAMES
 1234:    Frame frame;
 1235: #endif
 1236: 
 1237: #ifdef USE_LOCALIZED_SIGMA   
 1238:    double localSigma[nvrt];
 1239: #endif
 1240: 
 1241:    int kb;       // Bottom index of the node
 1242: 
 1243:    bool isDry;     // True if the node is dry
 1244: 
 1245:    int iadv;     // Advection flag
 1246: 
 1247:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1248:                           // this is nullptr
 1249: 
 1250:    TempVar tmp; // Temporary variable to store different types of variables
 1251: 
 1252:    // Physical information
 1253:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1254:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1255: 
 1256:    double rho[nvrt];     // Density
 1257:    double dfv[nvrt];     // Vertical viscosity
 1258: 
 1259:    double eta1; // Elevation at nodes at previous timestep
 1260:    double eta2; // Elevation at nodes at current timestep
 1261: 
 1262:    double ETP;  // Earth Tidal Potential
 1263: 
 1264:    double pr;    // Air pressure
 1265:    double grav2; // Gravity 
 1266:    
 1267:    Vector2 dav;  // Depth averaged velocity
 1268: 
 1269:    Vector2 tau; // Wind stress vector
 1270: 
 1271:    // Vegetation parameters
 1272:    double veg_h;
 1273:    double veg_nv;
 1274:    double veg_di;
 1275:    double veg_Cd;
 1276:    double veg_h_unbent;
 1277:    double veg_di_unbent;
 1278:    double veg_nv_unbent;
 1279:    double veg_alpha_vert_mean;
 1280:    double veg_alpha0;
 1281:    double veg_alpha3D[nvrt];
 1282: 
 1283:    // Bottom drag parameters
 1284:    double Cd;       // Bottom drag coefficient   
 1285: 
 1286:    // These three are mutually exclusive
 1287:    union {
 1288:       double rmanning; // Bottom Manning's coefficient
 1289:       double rough;    // Bottom roughness length
 1290:       double drag;     // Bottom drag coefficient
 1291:    };
 1292:    Vector2 tau_bot; // Bottom stress vector
 1293: 
 1294:    double bdef1; // Bottom deformation at previous timestep
 1295:    double bdef2; // Bottom deformation at current timestep
 1296: 
 1297:    double qel; // RHS
 1298:    double coeffDiag; // Diagonal coefficient of the matrix
 1299:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1300: 
 1301:    double mP; // Search direction for conjugate gradient method
 1302:    double mR; // Residual for conjugate gradient method
 1303:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1304:    double mX; // Solution for conjugate gradient method
 1305: 
 1306:    // Meteorological forcing
 1307:    Vector2 u_air;
 1308:    double p_air;  // XXXX is this the same as pr?
 1309:    double t_air;
 1310:    double q_air;
 1311:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1312: 
 1313:    __device__ void setWind(Vector2 &u) {
 1314:    // Sets the wind vector taking into account the mesh angle
 1315:    
 1316:       const double speed = length(u);
 1317: 
 1318:       // Rotate wind vector to the node frame
 1319:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1320: 
 1321:       // Sets the surface stress vector due to wind.
 1322:       if constexpr(nws == 0) {
 1323:          tau = {0.0, 0.0};
 1324: 
 1325:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1326:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1327: 
 1328:       } else {
 1329: 
 1330:          double dragcoef;
 1331: 
 1332:          if constexpr(iwind_form == -1) {
 1333:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1334:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1335: 
 1336:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1337:             tau = cff*u_air;
 1338:  
 1339:          } else if constexpr(iwind_form == 1) {
 1340:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1341:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1342: 
 1343:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1344:             tau = cff*u_air;
 1345: 
 1346:          } else {
 1347:             tau = {0.0, 0.0};
 1348:          }
 1349:       }
 1350:    }
 1351: 
 1352:    #ifdef USE_FRAMES
 1353:    __device__ void setFrame(double lat, double lon) {
 1354: 
 1355:       frame.update(lat, lon);        
 1356:     }
 1357:    #endif
 1358: 
 1359:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1360: 
 1361:    __device__ double sigmaTransitionDepth(void) const;
 1362: 
 1363:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1364:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1365:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1366:    
 1367:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1368: 
 1369:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1370: 
 1371:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1372:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1373: 
 1374:    __device__ __forceinline__ void clearMatrixRow(void) {
 1375:       // Clear the matrix row for this node
 1376: 
 1377: 
 1378:       coeffDiag = 0.0;
 1379: 
 1380:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1381: 
 1382:    }
 1383: 
 1384:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1385:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1386:       
 1387:       if (node == this) {
 1388:          coeffDiag += value;
 1389:      
 1390:       } else {
 1391:          // Search (linearly)the index of the node in the array of nodes
 1392:          // XXX: This is not efficient, see if we can improve this
 1393:          int i;
 1394:          for (i = 0; i < numNodes; i++) {
 1395:             if (nodes[i] == node) {
 1396:                break;
 1397:             }
 1398:          }
 1399:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1400:          coeffMatrix[i] += value;
 1401:       }
 1402:    }
 1403: 
 1404: 
 1405:    __device__ __inline__ void updateZCoordData(void);
 1406: 
 1407:    __device__ double compZCoord(int k) const;
 1408: 
 1409:    __device__ void updateKb(void);
 1410: 
 1411:    __device__ __forceinline__ void computeBottomDragCd(void);
 1412: 
 1413: 
 1414: 
 1415: };
