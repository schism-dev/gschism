  359: // ------------------------------------------------------------------------------------------------
  360: 
  361: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  362:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  363:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  364: }
  365: 
  366: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  367:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  368:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  369: }
  370: 
  371: 
  372: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  373:    x3 = y1*z2 - y2*z1;
  374:    y3 = x2*z1 - x1*z2;
  375:    z3 = x1*y2 - x2*y1;
  376: }
  377: 
  378: 
  379: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  380: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  381: //
  382: 
  383:    const double radius2 = dot(p, p);
  384:    const double radius = sqrt(radius2);
  385:  
  386:    assert(radius != 0.0      && "computeLonLat: radius = 0");
  387:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  388: 
  389:    rlon = atan2(p.y, p.x); // (-pi,pi]
  390: 
  391:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  392:       rlat = asin(p.z/radius);
  393:    } else {
  394:       rlat = asin(p.z/rearth_pole);
  395:    }
  396:   
  397: }
  398: 
  399: 
  400: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  401: // Compute the 3D Cartesian coordinates from the latitude and longitude
  402: // Inputs:
  403: //        lat: latitude in radians
  404: //        lon: longitude in radians
  405: // Output:
  406: //        x, y, z: 3D Cartesian coordinates
  407: 
  408:    double sin_lat, cos_lat, sin_lon, cos_lon;
  409: 
  410:    sincos(lat, &sin_lat, &cos_lat);
  411:    sincos(lon, &sin_lon, &cos_lon);
  412: 
  413:    const double x = rearth_eq*cos_lat*cos_lon;
  414:    const double y = rearth_eq*cos_lat*sin_lon;
  415:    const double z = rearth_pole*sin_lat;
  416: 
  417:    return make_double3(x, y, z);
  418: }
  419: 
  420: __inline__ __device__ void Error(const char* msg) {
  421:    printf("Error: %s\n", msg);
  422:    assert(false);
  423: }
