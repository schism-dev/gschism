 5737:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5738: 
 5739:       SIDE(side);
 5740: 
 5741:       side->U = {0.0, 0.0}; 
 5742:          
 5743:       if(side->isDry) return;
 5744: 
 5745:       // Vertically integrated velocity U
 5746:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5747:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5748:          side->U += side->Dz(k + 1)*uc;  
 5749:       }
 5750: 
 5751:    }
 5752: 
 5753:    __global__ void computeBottomDragVegetation(void) {
 5754:       // UNFINISHED. CHECK THIS:
 5755:       // How many kernels are needed? Why so many for loops?
 5756:       // Is the loop on sides needed?
 5757: 
 5758:       NODE(node);
 5759: 
 5760: 
 5761:       const int    kb      = node->kb;
 5762:       const double htot    = node->htot2(); 
 5763:       
 5764:       if (node->isDry) {
 5765:          // Default values for dry nodes
 5766:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5767:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5768: 
 5769:          return;
 5770:        
 5771:       }
 5772: 
 5773:       // Computes bottom drag Cd based on the selected nchi
 5774:       node->computeBottomDragCd();
 5775:       
 5776: 
 5777: 
 5778:       //   Bottom stress in m^2/s^2
 5779:       if (node->rho[kb + 1] >= -98.0)
 5780:       {
 5781:          const double mag_u = length(node->u2[kb + 1]);
 5782:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5783: 
 5784:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5785:          // !sediment erosion: this part needs more documentation
 5786:       }
 5787:     
 5788: 
 5789: 
 5790:       // Compute vegetation parameters
 5791:       //--------------------------------
 5792: 
 5793:       // SAV constants
 5794:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5795:       constexpr double veg_cfpsi = 0.16;
 5796: 
 5797:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5798:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5799: 
 5800:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5801:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5802:          int kbin = 0; // bin index
 5803:          for (int k = kb; k < nvrt; k++) {
 5804:             // Computes node height above the bottom level
 5805:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5806:             assert(false && "Vertical variation of vegetation not implemented");
 5807: 
 5808:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5809:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5810:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5811:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5812:             // } else {
 5813:             //    // Find the bin at which the current vertical level is
 5814:             //    while (kbin<nbins_veg_vert) {
 5815:             //       const double zn = node->z[kbin];
 5816:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5817:             //          break;
 5818:             //       } // if
 5819:             //       kbin++;
 5820:             //    } // while
 5821:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5822: 
 5823:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5824:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5825:                
 5826:             //    // Linear interpolation of the vegetation parameters
 5827:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5828:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5829:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5830:             // } // if rl10
 5831: 
 5832:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5833: 
 5834:          } // for k
 5835: 
 5836: 
 5837:       } else { // Ganthy (iveg==2)
 5838:       //  Modify canopy height, diameter, and density
 5839: 
 5840:          // Make sure there is vegetation on this node
 5841:          if (node->veg_h_unbent > 0.0) {
 5842:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5843: 
 5844:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5845:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5846:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5847: 
 5848:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5849:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5850:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5851:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5852:          } // if veg_h_unbent
 5853: 
 5854:          for (int k = 0; k < nvrt; k++) {
 5855:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5856:          } // for k
 5857:       
 5858: 
 5859:       } // if iveg
 5860:      
 5861: 
 5862:       // Compute vertical mean of veg_alpha3D
 5863:       if (iveg != 0) {
 5864:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5865:          double sum1=0.0;
 5866:          double sum2=0.0;
 5867:          // Integrate over each level under the canopy...
 5868:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5869:             const double Dz = node->Dz(k);
 5870: 
 5871:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5872:             sum2 += Dz;
 5873: 
 5874:          } // for k
 5875:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5876:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5877: 
 5878:       } // if iveg
 5879: 
 5880:    }
 5881: 
 5882:    __global__ void computeVegetationAndDragParameters(void) {
 5883:       // Computes the vegetation and drag model parameters:
 5884:       // chi, \tilde\chi, beta, \breve{H}
 5885:       
 5886:       SIDE(side);
 5887: 
 5888:       side->hhat = 0.0;
 5889:       side->chi2 = 0.0;
 5890:       side->chi = 0.0;
 5891:       side->veg_c2 = 0.0;
 5892:       side->veg_beta = 0.0;
 5893: 
 5894:       if (side->isDry) return;
 5895: 
 5896:       const double htot = side->htot2();
 5897:       const int    kb   = side->kb;
 5898: 
 5899:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5900: 
 5901:       const double veg_h     = side->veg_h();
 5902:       const double veg_nv    = side->veg_nv();
 5903:       const double veg_c     = side->veg_c();
 5904:       const double veg_beta  = side->veg_beta;
 5905:       const double veg_alpha = side->veg_alpha_vert_mean();
 5906: 
 5907:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5908:       // Velocity magnitude at the bottom level
 5909:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5910:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5911:       side->chi2 = side->Cd()*vmag1;
 5912:       side->chi  = side->chi2;
 5913:       if constexpr(iveg != 0) {
 5914:          const Node *n1 = side->n1;
 5915:          const Node *n2 = side->n2;
 5916:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5917:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5918:       }
 5919: 
 5920:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5921: 
 5922:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5923:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5924:       double magUa = 0.0;
 5925:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5926:          // 3D wet side with veg...
 5927: 
 5928:          double magUa = 0.0;
 5929:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5930:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5931: 
 5932:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5933:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5934:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5935: 
 5936:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5937:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5938: 
 5939:                // Velocity magnitude at the bottom (l) of the level
 5940:                const double ul = length(side->u2[k]);
 5941: 
 5942:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5943:                magUa += Dz*0.5*(uh + ul);
 5944: 
 5945:             } // if HasVegetation
 5946:          } // for k
 5947:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5948: 
 5949:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5950:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5951:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5952:             const double zCpy = side->zTopCanopy();
 5953:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5954:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5955:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5956:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5957:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5958:          } // if isSubmerged
 5959:       } // if iveg   
 5960: 
 5961:       // Computes the friction modified depth, \breve{H} in notes
 5962:       if (side->is2D()) { // 2D
 5963: 
 5964:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5965:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5966: 
 5967:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5968: 
 5969:          side->hhat = htot*htot/fricH; 
 5970: 
 5971:       } else { // 3D
 5972:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5973: 
 5974:          if constexpr(iveg != 0) {
 5975:             
 5976:             if (side->isSubmerged()) { 
 5977:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5978:                side->hhat -= veg_c*Hhat_alpha;
 5979: 
 5980:             } else { // Emergent
 5981:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5982:             }
 5983:          } // if iveg
 5984: 
 5985:          // Enforce positivity for 3D model
 5986:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5987:       } // if 3D
 5988: 
 5989:    }
 5990: 
 5991: 
 5992: 
 5993:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5994:    // Computes the density gradient between two elements, e1 and e2.
 5995:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5996:    // zero in the direction normal to the side. 
 5997:    // 
 5998:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5999:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6000:    //
 6001:    // Input:
 6002:    //    e1: Element
 6003:    //    e2: Neighbor element (or nullptr if boundary)
 6004:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6005:    //    k: Index of the half-level at which the density is interpolated
 6006:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6007:    // 
 6008:    // Output:
 6009:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6010:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6011: 
 6012:       if (e2 == nullptr || e2->isDry) {
 6013:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6014: 
 6015:          Side *side = e1->sides[j];
 6016:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6017:                  
 6018:          if constexpr(ics == 1) {
 6019:             vec = side->n; // Normal vector to the side
 6020:          } else {
 6021:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6022:             // IMPLEMENT THIS XXXXXX
 6023:             // !replace with xel, yel?
 6024:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6025:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6026:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6027:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6028:          } //ics
 6029:                    
 6030:          diffRho = 0.0;
 6031: 
 6032:       } else { //internal and wet
 6033:          if constexpr(ics==1) {
 6034:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6035: 
 6036:             // Vector from e1 to e2
 6037:             vec = e2->center - e1->center;
 6038: 
 6039:          } else { 
 6040:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6041:             // Remember that elem->center is in global coordinates
 6042:             // IMPLEMENT THIS XXXXXX
 6043:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6044:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6045:             //                   alow(j)=xctr2
 6046:             //                   bdia(j)=yctr2
 6047:          } // ics
 6048: 
 6049:          diffRho = rho2 - e1->demeanedDensity(k);
 6050:       }
 6051: 
 6052:    }
 6053: 
 6054:    __global__ void computeDensityCubicSplines(void) {
 6055:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6056: 
 6057:       ELEM(elem);
 6058: 
 6059:       if (elem->isDry) return;
 6060: 
 6061:       const int kb = elem->kb;
 6062: 
 6063:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6064:       if (elem->is2D()) {
 6065:          // In the 2D case, the density is constant at the prism level. 
 6066:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6067:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6068:       } else { //3D
 6069: 
 6070:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6071:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6072:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6073:          ///// XXXX CHECK INDICES!!!!!
 6074:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6075:       } // 2D/3D
 6076: 
 6077:    }
 6078: } // extern "C"
 6079: 
 6080: 
 6081: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6082: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6083: 
 6084:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6085: 
 6086:    const int kb  = elem->kb;
 6087:    const int kb2 = elem2->kb;
 6088: 
 6089:    // z-coordinate of prism of elem
 6090:    const double zp = elem->z_prism(k);
 6091: 
 6092:    double rho = 0.0;
 6093: 
 6094:    if (elem2->is2D()) {
 6095:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6096: 
 6097:    } else {  // 3D
 6098: 
 6099:       // eta_min may be < zmax
 6100:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6101:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6102: 
 6103:       // (Extrapolate density below bottom, we will fix it later)
 6104:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6105:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6106:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6107:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6108:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6109:    } // 2D/3D
 6110:      
 6111: 
 6112:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6113:    // Now we need to fix it.
 6114:    if (elem->z[k] < elem2->z[kb2]) {
 6115:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6116: 
 6117:       // There are two methods to adjust the density at the bottom of the element.
 6118:       // iunder_deep=0: 
 6119:       const double depth1 = abs(elem->z[kb]); // larger depth
 6120: 
 6121:       if (iunder_deep==0) {
 6122: 
 6123:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6124: 
 6125:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6126: 
 6127:       } else { // iunder_deep != 0
 6128: 
 6129:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6130: 
 6131:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6132: 
 6133:          //   Demeaned density at the same z coordinate as
 6134:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6135:          }
 6136: 
 6137:       } // if iunder_deep
 6138:    } // if elem->z[kb] < elem2->z[kb]
 6139: 
 6140:    return rho;
 6141: }
 6142: 
 6143: 
 6144: extern "C" {
 6145:    __global__ void computeDensityGradient(void) {
 6146: 
 6147:       if constexpr(ibc != 0) return;
 6148: 
 6149:          // Compute the horizontal density gradient at each element.
 6150:       // It works in two steps:
 6151:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6152:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6153:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6154:       //             gradRho.r1 = rho1 - rho0
 6155:       //             gradRho.r2 = rho2 - rho0
 6156:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6157:       // 
 6158:       //  NOTE: We use de-meaned densities.
 6159: 
 6160:       ELEM(elem);
 6161: 
 6162:       if (elem->isDry) return;
 6163: 
 6164:       const int kb  = elem->kb;
 6165:       const int i34 = elem->i34;
 6166: 
 6167:       for (int k = kb + 1; k < nvrt; k++) {
 6168:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6169:          //             gradRho.r1 = rho1 - rho0
 6170:          //             gradRho.r2 = rho2 - rho0
 6171:          int icount = 0;
 6172:          double sumRx = 0.0;
 6173:          double sumRy = 0.0;
 6174:          for (int j1=0; j1<i34; j1++) { 
 6175: 
 6176:             const int j2 = elem->nxq(j1 + 1);
 6177: 
 6178:             // Pairs of consecutive neighbor elements of elem
 6179:             const Element *e1 = elem->nghbElems[j1];
 6180:             const Element *e2 = elem->nghbElems[j2];
 6181: 
 6182:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6183:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6184:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6185: 
 6186:             // Compute the density difference and the vector from elem to e1 and e2
 6187:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6188:             double diffRho1, diffRho2;
 6189:             Vector2 vec1, vec2;
 6190:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6191:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6192: 
 6193:             const double rl1 = length(vec1);
 6194:             const double rl2 = length(vec2);
 6195:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6196: 
 6197:             const double delta = cross(vec1, vec2);
 6198:             const double sintheta = abs(delta)/(rl1*rl2);
 6199: 
 6200:             // To avoid problems, avoid elements with small angle between vectors
 6201:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6202:             const bool validEq = (sintheta > sin_one_deg);
 6203: 
 6204:             if (validEq) {
 6205:                // Solve the system of equations to get the density gradient at elem
 6206:                icount++;
 6207:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6208:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6209:                sumRx += Rx;
 6210:                sumRy += Ry;
 6211:             }
 6212:          } // for j1
 6213: 
 6214:          // Compute the average density gradient at elem
 6215:          if (icount==0) {
 6216:            // Bad mesh quality; bail out with 0 b-cc
 6217:            elem->gradRho[k] = {0.0, 0.0};
 6218:          } else {
 6219:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6220:          }
 6221: 
 6222:       } // for k
 6223: 
 6224:    }
 6225: 
 6226:    __global__ void computeBaroclinicTerm(void) {
 6227:    // Computes the baroclinic term at sides (at half levels).
 6228:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6229:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6230: 
 6231:       if (ibc == 1) return;
 6232: 
 6233:       SIDE(side);
 6234: 
 6235:       if (side->isDry) return;
 6236: 
 6237:       const Element *e1 = side->elems[0];
 6238:       const Element *e2 = side->elems[1]; 
 6239:       const int kb = side->kb;
 6240:       
 6241:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6242: 
 6243:       // interpolates vertically the density gradient of the two elements at the half level/
 6244: 
 6245:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6246:       int k2 = max(kb, nvrt / 2);
 6247: 
 6248:       // Starts the integration at the surface and goes down to the bottom
 6249:       side->bcc[nvrt-1] = {0.0, 0.0};
 6250:       for (int k = nvrt - 2; k >= kb; k--) {
 6251:       // For each prism level (from surface to bottom)...
 6252: 
 6253:          // For both elements, interpolate density gradient at the side's half level.
 6254:          // The gradient at the side is the average of the gradients at the elements.
 6255:          // w1, w2 are used to take into account boundary sides, with just one element.
 6256:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6257:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6258:          const double wsum = w1 + w2;
 6259:          w1 = w1/wsum;
 6260:          w2 = w2/wsum;
 6261:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6262: 
 6263:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6264:          Vector2 gradRho = {0.0, 0.0};
 6265:          if (e1 != nullptr && k > kb) {
 6266:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6267:             
 6268:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6269:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6270:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6271: 
 6272:             // Grad(rho) vertically interpolated at the side's half level
 6273:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6274: 
 6275:             // Projects the element density gradient to the side frame if needed.
 6276:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6277: 
 6278:             // Adds the contribution of the density gradient at the side's half level
 6279:             gradRho += gradRho1*w1;
 6280:          }      
 6281:          if (e2 != nullptr && k > kb) {
 6282:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6283:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6284:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6285:             
 6286:             // Grad(rho) vertically interpolated at the side's half level
 6287:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6288: 
 6289:             // Projects the element density gradient to the side frame if needed.
 6290:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6291: 
 6292:             // Adds the contribution of the density gradient at the side's half level
 6293:             gradRho += gradRho2*w2;
 6294:          }
 6295: 
 6296:          
 6297:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6298:          // multiplied by -rampbc*(g/rho0) 
 6299:          const double grav3 = side->grav3();
 6300:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6301: 
 6302:       } // for
 6303: 
 6304:    }
 6305: 
 6306: 
 6307: 
 6308:    __global__ void computeHorGradientAtSide(void) {
 6309: 
 6310:       // Compute the horizontal density gradient at each element.
 6311:       // It works in two steps:
 6312:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6313:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6314:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6315:       //             gradRho.r1 = rho1 - rho0
 6316:       //             gradRho.r2 = rho2 - rho0
 6317:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6318:       // 
 6319:       //  NOTE: We use de-meaned densities.
 6320: 
 6321:       SIDE(side);
 6322: 
 6323: 
 6324:       if (side->isDry) return;
 6325: 
 6326:       // Computes the gradient of the variables at the side center.
 6327:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6328:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6329:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6330: 
 6331:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6332:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6333:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6334:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6335: 
 6336:    }
 6337: 
 6338: 
 6339:    __global__ void solveMomentumEquations(double time) {
 6340: 
 6341:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6342:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6343: 
 6344:       SIDE(side);
 6345: 
 6346:       if (side->isDry) 
 6347:       {
 6348:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6349: 
 6350:          return;
 6351:       }
 6352: 
 6353:       const Node *n1 = side->n1;
 6354:       const Node *n2 = side->n2;
 6355: 
 6356:       const int kb = side->kb;
 6357: 
 6358:       const double veg_h = side->veg_h();
 6359:       const double grav3 = side->grav3();
 6360: 
 6361:       if (side->is2D()) {
 6362:          // Remember: Do not use htot2, which is updated.
 6363:          const double htot = side->htot1();
 6364:          const double hhat = side->hhat;
 6365: 
 6366:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6367: 
 6368:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6369:          const Vector2 tau2 = side->tau();
 6370: 
 6371:          // hat_gam has units of m/s
 6372: 
 6373:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6374:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6375:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6376: 
 6377:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6378: 
 6379: 
 6380:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6381: 
 6382:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6383: 
 6384:       }
 6385:       else { // 3D
 6386: 
 6387:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6388:          // 
 6389:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6390:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6391:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6392:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6393:          // k+1 and k.
 6394: 
 6395: 
 6396:          const int ndim = nvrt - kb;
 6397:          const double zTopCanopy = side->zTopCanopy();
 6398: 
 6399:          // Initialize the tridiagonal system
 6400:          for (int k = kb + 1; k < nvrt; k++) {
 6401:             
 6402:             const int kin = k - (kb + 1);
 6403: 
 6404:             // Vertical viscosity at the face center
 6405:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6406: 
 6407:  
 6408:             alow[kin] = 0.0;
 6409:             cupp[kin] = 0.0;
 6410:             bdia[kin] = 0.0;
 6411: 
 6412:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6413:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6414: 
 6415:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6416:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6417:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6418: 
 6419:             // First part: layers k, k+1
 6420:             if (k < nvrt - 1) {
 6421:                              
 6422:                if constexpr(iveg != 0) {
 6423: 
 6424:                   // If there is vegetation at this level...
 6425:                   if (zTopCanopy > side->zc[k]) {
 6426:                      // If the canopy is above the k layer...
 6427:                      
 6428:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6429:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6430:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6431:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6432: 
 6433:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6434:                      const double vmag2 = length(ut2);
 6435:                      const double vmag1 = length(side->u2[k]);
 6436:                      const double vmag = 0.5*(vmag1 + vmag2);
 6437:                      
 6438:                      // Computes the vegetation alpha at the face center
 6439:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6440: 
 6441:                      cff1 += veg_alpha_sd*dt*vmag;
 6442: 
 6443:                   } // if (zTopCanopy
 6444:                } // if iveg
 6445: 
 6446:                const double dzz = side->Dz(k + 1);
 6447:                const double tmp = dt*dfz/dzz;
 6448:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6449: 
 6450:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6451:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6452:             }
 6453: 
 6454: 
 6455:             // Second part: layers k-1, k
 6456:             if (k > kb + 1) {
 6457: 
 6458:                double cff1 = 1.0; //init \bar{c^k}
 6459: 
 6460:                if constexpr(iveg != 0) {
 6461:                   // If there is vegetation at this level...
 6462:                   if (zTopCanopy > side->zc[k-1]) {
 6463:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6464:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6465: 
 6466:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6467: 
 6468:                      const double vmag2 = length(ut2);
 6469:                      const double vmag1 = length(side->u2[k-1]);
 6470:                      const double vmag = 0.5*(vmag1 + vmag2);
 6471: 
 6472:                      // Computes the vegetation alpha at the face center
 6473:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6474:                      cff1 += veg_alpha_sd*dt*vmag;
 6475:                   } // if zTopCanopy
 6476: 
 6477:                } // if iveg
 6478: 
 6479:                const double dzz = side->Dz(k);
 6480:                const double tmp = dt*dfz/dzz;
 6481:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6482: 
 6483:                alow[kin] += cff1*dzz/6.0 - tmp;
 6484:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6485: 
 6486:             } else { // Bottom boundary
 6487:                // This occurs at the bottom, where the bottom drag is applied.
 6488: 
 6489:                bdia[kin] += dt*side->chi2; // XXXX
 6490: 
 6491:             } // if (k > kb + 1)
 6492: 
 6493: 
 6494:          } // for (int k
 6495: 
 6496: 
 6497: 
 6498:          // Computes the RHS.
 6499:          // -----------------
 6500: 
 6501:          //	BC to be imposed at the end.
 6502: 
 6503:          const Vector2 gradETP  = side->gradETP;
 6504:          const Vector2 gradPr   = side->gradPr;
 6505:          const Vector2 gradEta1 = side->gradEta1;
 6506:          const Vector2 gradEta2 = side->gradEta2;
 6507: 
 6508:          const Vector2 *btu = side->btu;
 6509:          const Vector2 *u2  = side->u2;
 6510:          const double coriolis = side->coriolis;
 6511:          const Vector2 *nuGradU = side->nuGradU;
 6512: 
 6513:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6514:          for (int k = kb + 1; k < nvrt; k++) {
 6515:             const int kin = k - kb - 1;
 6516: 
 6517:             const double dz_0 = side->Dz(k);
 6518:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6519: 
 6520:             rrhs[kin] = {0.0, 0.0};
 6521:             double dz = 0.0;
 6522: 
 6523:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6524:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6525:             if (k < nvrt  ) dz += dz_1;
 6526:             if (k > kb + 1) dz += dz_0;
 6527: 
 6528:             // Elevation gradient, atmospheric pressure and tidal potential
 6529:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6530: 
 6531:             // Coriolis, advection, wind stress, and horizontal viscosity
 6532:             if (k < nvrt - 1) {
 6533: 
 6534: 
 6535:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6536:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6537:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6538:                                                 
 6539: 
 6540:                //diff stress tensors 1006
 6541:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6542:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6543:                   assert(false && "Not implemented: itur == 5");
 6544:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6545:                }
 6546:                // else assert(false && "itur # Not implemented");
 6547: 
 6548:             } else { // k == nvrt - 1 SURFACE
 6549:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6550:                const Vector2 tau2 = side->tau();
 6551: 
 6552:                rrhs[kin] += dt*tau2;          
 6553: 
 6554:             } // if k<nvrt
 6555: 
 6556: 
 6557:             if (k > kb + 1) {
 6558:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6559:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6560:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6561: 
 6562:                // diff stress tensors 1006
 6563:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6564:                   assert(false && "Not implemented: itur == 5");
 6565:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6566:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6567:                }
 6568:                // else assert(false && "itur # Not implemented");
 6569: 
 6570: 
 6571:             } // if k>kbs + 1
 6572: 
 6573:             // Baroclinic
 6574:             Vector2 *bcc = side->bcc;
 6575:             if constexpr(ibc == 0) {
 6576:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6577:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6578: 
 6579:             } // if ibc==0
 6580: 
 6581:          } // k=kb + 1,nvrt
 6582: 
 6583: 
 6584:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6585: 
 6586:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6587:             const int kin = k - kb - 1;
 6588:    
 6589:             // Velocity is always clamped to maximum values
 6590:             side->u2[k] = clampVelocity(soln[kin]);
 6591:          } // k
 6592: 
 6593:       } // if side->is2D()
 6594:       
 6595: 
 6596:       // Impose velocity boundary condition at the bottom
 6597:       if constexpr(imm == 2) { // 3D bed deformation model
 6598:          double dep;
 6599:          Vector2 vel;
 6600: 
 6601:          assert(false && "Not implemented: imm == 2");
 6602:          //update_bdef(time, x0, y0, dep, vel);
 6603:          // side->u2[kb] = vel;
 6604: 
 6605:       } else { // imm = 0 or 1
 6606:          if (side->Cd() == 0.0) {
 6607:             side->u2[kb] = side->u2[kb + 1];
 6608: 
 6609:          } else if (side->is3D()) { // 3D no slip bottom   
 6610:             side->u2[kb] = {0.0, 0.0};
 6611: 
 6612:          }
 6613:           
 6614:       } // if imm
 6615: 
 6616:       // The velocities below the bottom level are set to zero
 6617:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6618: 
 6619: 
 6620:    }
 6621: 
 6622: 
 6623:    __global__ void applyMomentumBC(void) {
 6624: 
 6625:       SIDE_BND(sideBnd);
 6626: 
 6627:       Side *side = sideBnd->side;
 6628:       const BoundarySegment *segment = sideBnd->segment;
 6629:       const Node *n1 = side->n1;
 6630:       const Node *n2 = side->n2;
 6631: 
 6632:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6633: 
 6634:       const bool isLand = segment->isLand;
 6635:       const int ifltype = segment->ifltype;
 6636: 
 6637:       const int kb = side->kb;
 6638: 
 6639: 
 6640:       if (!isLand && ifltype != 0) {
 6641:          const Vector2 *ubc = sideBnd->ubc;
 6642:   
 6643:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6644:             
 6645:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6646:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6647: 
 6648:             if (ifltype == -1) {
 6649:                // Flather 1
 6650: 
 6651:                const double depth = side->depth();
 6652: 
 6653:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6654: 
 6655:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6656: 
 6657:                side->u2[k] = vnorm*side->n;
 6658: 
 6659:             } else if (ifltype == -2) { // Discharge
 6660: 
 6661:                const double eta1 = side->eta1();
 6662:                const double eta2 = side->eta2();
 6663:                const double htot = side->htot2();
 6664: 
 6665:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6666:                assert(false && "Not implemented: Discharge bc");
 6667:                // const double dischrg = discharge(eta1);
 6668:                const double dischrg = 0.0; // XXX REMOVE
 6669:                
 6670: 
 6671:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6672: 
 6673:                const double vnorm = dischrg*eta2/htot;
 6674: 
 6675:                side->u2[k] = vnorm*side->n;
 6676: 
 6677:             }
 6678:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6679:                const double vnorm = dot(side->u2[k], side->n);
 6680: 
 6681:                double rat;
 6682:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6683:                else              rat = segment->vobc2; // outgoing
 6684: 
 6685:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6686: 
 6687:             }
 6688:             else { // not Flather or 3D radiation
 6689:                side->u2[k] = ubc[k];
 6690: 
 6691:             } // if (segment->ifltype...
 6692: 
 6693:          }
 6694: 
 6695:       }
 6696:       else if (isLand) { // if it is land boundary side
 6697: 
 6698:          if constexpr(islip == 0) { // free slip
 6699: 
 6700:             for (int k = kb; k < nvrt; k++) {
 6701: 
 6702:                const Vector2 t = side->t();
 6703:                const Vector2 n = side->n;
 6704: 
 6705:                double vnorm = 0.0; // for most cases
 6706:                const double vtan = dot(side->u2[k], t);
 6707:                
 6708:                side->u2[k] = vtan*t - vnorm*n;
 6709: 
 6710:             }
 6711: 
 6712:          } else { // no slip
 6713:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6714: 
 6715:          }
 6716:       } // if (side segment type...
 6717: 
 6718:    
 6719: 
 6720:    }
 6721: 
 6722: 
 6723:    __global__ void shapiroFilter1(void) {
 6724:       // First step of the Shapiro filter (normally used if indvel<=0)
 6725:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6726: 
 6727:       SIDE(side);
 6728: 
 6729:       // Only internal wet sides are processed
 6730:       if (side->isDry || !(side->isInternal())) return;
 6731: 
 6732:       const int kb = side->kb;
 6733: 
 6734:       for (int mm = 0; mm < niter_shap; mm++) {
 6735: 
 6736:          for (int k = kb + 1; k < nvrt; k++) {
 6737:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6738:             Vector2 suru = {0.0, 0.0};
 6739: 
 6740:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6741: 
 6742:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6743: 
 6744:                int kin = k;
 6745:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6746:                
 6747:                // Get the velocity at the neighbor's side.
 6748:                Vector2 nSideU2 = nSide->u2[kin];
 6749: 
 6750:                // Projects the velocity to the current side frame if needed.
 6751:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6752: 
 6753:                suru += nSideU2;
 6754:             }
 6755: 
 6756:             // Reusing bcc as a temporary array to store the suru values.
 6757:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6758: 
 6759:          }
 6760:       }
 6761:    }
 6762: 
 6763:    __global__ void shapiroFilter2(void) {
 6764:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6765: 
 6766:       SIDE(side);
 6767: 
 6768: 
 6769:       if (side->isDry || !(side->isInternal())) return;
 6770: 
 6771:       const int kb = side->kb;
 6772: 
 6773:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6774: 
 6775:       if (side->is2D()) {
 6776:          side->u2[kb + 1] = side->bcc[kb + 1];
 6777:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6778: 
 6779:       } else {
 6780:          // 3D
 6781:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6782:          
 6783:       }
 6784: 
 6785:    }
 6786: 
 6787: 
 6788:    __global__ void ul0UpdateZCoords(void) {
 6789:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6790:       
 6791:       NODE(node);      
 6792: 
 6793: 
 6794:       if (false) { //node->isDry) { XXXXXXX
 6795: 
 6796:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6797: 
 6798:          if constexpr(ivcor != 1) node->kb = 0;
 6799: 
 6800:       } else {
 6801: 
 6802:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6803:          node->updateKb();
 6804: 
 6805:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6806: 
 6807:       }
 6808: 
 6809:       // We use the temp.b field to store the previous state of isDry.
 6810:       node->tmp.b = node->isDry;
 6811: 
 6812:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6813:       node->isDry = true;
 6814: 
 6815:    }
 6816: 
 6817:    __global__ void ul0ComputeDryElements(void)
 6818:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6819:    {
 6820:       ELEM(elem);
 6821: 
 6822:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6823: 
 6824:       elem->kb = 0;
 6825: 
 6826:       if (elem->isDry) return;
 6827: 
 6828: 
 6829:    //    if(elem->isDry2()) { // XXXX
 6830:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6831:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6832:    //        call parallel_abort(errmsg)
 6833:    //    }
 6834: 
 6835:       const Node *n1 = elem->nodes[0];
 6836:       const Node *n2 = elem->nodes[1];
 6837:       const Node *n3 = elem->nodes[2];  
 6838:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6839: 
 6840:       // Computes element's kb as the minimum of the nodes' kb.
 6841:       const int kb1 = n1->kb;
 6842:       const int kb2 = n2->kb;
 6843:       const int kb3 = n3->kb;
 6844:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6845: 
 6846: 
 6847:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6848: 
 6849: 
 6850:       // Computes the element z as the mean of the nodes z.
 6851:       for (int k = elem->kb; k < nvrt; k++) {
 6852: 
 6853:          // Compute the element z as the mean of the nodes z.
 6854:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6855:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6856:          elem->z[k] /= elem->i34;
 6857: 
 6858:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6859:       }
 6860:                   
 6861:    }
 6862: 
 6863:    __global__ void ul0ComputeDryNodes(void)
 6864:    // Updates node's isDry based on the elements' isDry. 
 6865:    {
 6866:       NODE(node);
 6867: 
 6868:       node->isDry = true;
 6869: 
 6870:       // A node is wet if at least one of the elements sharing it is wet.
 6871:       for (int j = 0; j < node->numElements; j++) {
 6872:          const Element *elem = node->elements[j];
 6873:          if (!elem->isDry) {
 6874:             node->isDry = false;
 6875:             break;
 6876:          }
 6877:       }
 6878: 
 6879:        
 6880:    }
 6881: 
 6882: 
 6883:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6884:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6885:    // node->tmp.b is true if the node was previously dry.
 6886:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6887:    {
 6888:       NODE(node);
 6889:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6890: 
 6891:       // Avoid this the first time step.
 6892:       if (it == iths) return;  
 6893: 
 6894:       const bool wasDry = node->tmp.b;
 6895: 
 6896: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6897: 
 6898:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6899: 
 6900:          for (int k=0; k < nvrt; k++) {
 6901: 
 6902:             Vector3 utmp={0.0, 0.0, 0.0};
 6903: 
 6904:             double ttmp=0.0;
 6905:             double stmp=0.0;
 6906:             int icount=0;
 6907:             for (int j = 0; j < node->numNodes; j++) {
 6908: 
 6909:                const Node *nbrNode = node->nodes[j];
 6910:                
 6911:                const bool wasNbrDry = nbrNode->tmp.b;
 6912: 
 6913:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6914:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6915: 
 6916:                   icount++;
 6917: 
 6918:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6919:                   utmp += nbrNode->uvw2(k);
 6920:                   
 6921:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6922:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6923:                }
 6924:             }
 6925: 
 6926:             if (icount > 0) {
 6927:                const double inv_icount = 1.0/icount;
 6928:                utmp = inv_icount*utmp;
 6929:                node->u2[k]     = toVector2(utmp);
 6930:                node->w2[k]     = utmp.z;
 6931:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6932:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6933:             } else {
 6934:                node->u2[k] = {0.0, 0.0};
 6935:                node->w2[k] = 0.0;
 6936:                // Initialize tracers to 0.0??? XXXXX
 6937:             }
 6938:          }
 6939:       }
 6940:    }
 6941: 
 6942:   
 6943:    
 6944: 
 6945: 
 6946:    __global__ void ul0UpdateSides(int it, int iths) {
 6947:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6948:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6949:    // The dryness of the sides is updated in ul0UpdateSides2.
 6950: 
 6951:       SIDE(side);
 6952: 
 6953:       // A side is wet if and only if at least one of its elements is wet.
 6954:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6955:  
 6956:       const Node *n1 = side->n1;
 6957:       const Node *n2 = side->n2;
 6958:      
 6959:       const int kb1 = n1->kb;
 6960:       const int kb2 = n2->kb;
 6961: 
 6962:       side->kb = 0; // default when dry
 6963: 
 6964:       if (isWet) {
 6965: 
 6966:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6967: 
 6968:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6969: 
 6970:          side->kb = min(kb1, kb2);
 6971: 
 6972:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6973: 
 6974:          for (int k = side->kb; k < nvrt; k++) {
 6975:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6976: 
 6977:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6978: 
 6979:             // Compute velocity for re-wetted sides 
 6980:             if ((it != iths) && (side->isDry && isWet)) {
 6981: 
 6982:                Vector2 utmp={0.0, 0.0};
 6983: 
 6984:                int icount=0;
 6985: 
 6986:                // For all the sides on the two elements that share this side
 6987:                for (int j = 0; j < 2; j++) {
 6988:                   const Element *elem = side->elems[j];
 6989:                   if (elem == nullptr) continue;
 6990: 
 6991:                   for (int jj=0; jj < elem->i34; jj++) {
 6992:                      const Side *nSide = elem->sides[jj];
 6993:                      if (nSide->isDry) continue;
 6994: 
 6995:                      icount++;
 6996:                      utmp += nSide->u2[k];  
 6997:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6998:                   }
 6999:                }
 7000:                   
 7001:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7002:                if (icount > 0)  side->u2[k] = utmp/icount;
 7003:                else             side->u2[k] = {0.0, 0.0};
 7004:                   
 7005:             } // if ((it != iths) && (side->isDry && isWet))
 7006: 
 7007:          } // for k
 7008: 
 7009:       } // if isWet 
 7010:       
 7011: 
 7012: 
 7013:    }
 7014: 
 7015:    __global__ void ul0UpdateSides2(void) {
 7016:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7017:    
 7018:          SIDE(side);
 7019:    
 7020:          const Element *e1 = side->elems[0];
 7021:          const Element *e2 = side->elems[1];
 7022: 
 7023:          // A side is wet if and only if at least one of its elements is wet.
 7024:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7025: 
 7026:          // Update the side's dryness
 7027:          side->isDry = !isWet;
 7028: 
 7029:    }
 7030: 
 7031: 
 7032:    __global__ void zeroNodalVelocities(void) {
 7033:       NODE(node);
 7034: 
 7035:       for (int k = 0; k < nvrt; k++) {
 7036:          node->u2[k]   = {0.0, 0.0};
 7037:          node->w2[k]   = 0.0;
 7038:          node->utmp[k] = {0.0, 0.0};         
 7039:       }
 7040:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7041:    }
 7042:  
 7043: 
 7044:    __global__ void computeNodalVerticalVelocities1(void) {
 7045:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7046:    // Adds the element's vertical velocity times the element's area.
 7047:       ELEM(elem);
 7048: 
 7049:       for (int j = 0; j < elem->i34; j++) {
 7050:          Node *node = elem->nodes[j];
 7051: 
 7052:          for (int k = node->kb; k < nvrt; k++) {
 7053:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7054:          }
 7055:          atomicAdd(&(node->tmp.d), elem->area);
 7056:       }
 7057:    }
 7058: 
 7059:    __global__ void computeNodalVerticalVelocities2(void) {
 7060:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7061:    // Divides by the total area of the elements sharing the    node.
 7062:       NODE(node);
 7063: 
 7064:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 7065: 
 7066:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7067:    }
 7068: 
 7069: 
 7070:    __global__ void computeNodalHorizontalVelocities1(void) {
 7071: 
 7072:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7073: 
 7074:       ELEM(elem);
 7075: 
 7076:       if (elem->isDry) return;
 7077: 
 7078:       const int kb = elem->kb;
 7079:       const bool isTri = elem->isTri();
 7080: 
 7081:       if constexpr(indvel <= 0) {
 7082:          // Assuming discontinous hvel.
 7083: 
 7084:          if (isTri) { // For triangles
 7085:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7086:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7087: 
 7088:             for (int j = 0; j < 3; j++) {
 7089:                // For every node of the triangle...
 7090:                Node *node = elem->nodes[j];
 7091: 
 7092:                if (node->isDry) continue;
 7093: 
 7094:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7095:                const Side *s2 = elem->sides[(j + 1) % 3];
 7096:                const Side *s3 = elem->sides[(j + 2) % 3];
 7097: 
 7098:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7099: 
 7100:                atomicAdd(&(node->tmp.i), 1);
 7101: 
 7102:                for (int k = kb; k < nvrt; k++)  {
 7103:                   Vector2 s1u2 = s1->u2[k];
 7104:                   Vector2 s2u2 = s2->u2[k];
 7105:                   Vector2 s3u2 = s3->u2[k];
 7106: 
 7107:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7108:                   if constexpr(ics == 2) {
 7109:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7110:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7111:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7112:                   }
 7113: 
 7114:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7115:                   u = clampVelocity(u);
 7116:                   atomicAdd(&(node->utmp[k].x), u.x);
 7117:                   atomicAdd(&(node->utmp[k].y), u.y);
 7118: 
 7119:                }
 7120: 
 7121:             }
 7122:          }
 7123:          else { // For quads
 7124:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7125: 
 7126:          }
 7127: 
 7128:       }
 7129:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7130:       
 7131:    }
 7132: 
 7133: 
 7134:    __global__ void computeNodalHorizontalVelocities2(void) {
 7135:       NODE(node);
 7136: 
 7137:       const int nodeCount = node->tmp.i;
 7138: 
 7139:       if (nodeCount == 0) 
 7140:       {
 7141:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7142:          return;
 7143:       }
 7144: 
 7145:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7146:       
 7147:       const int kb = node->kb;
 7148: 
 7149:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7150:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7151:       
 7152:       
 7153:    }   
 7154: 
 7155:  
 7156: 
 7157:    __global__ void resetVelocityOpenBndNodes(void) {
 7158:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7159: 
 7160:       NODE_BND(nodebnd);
 7161: 
 7162:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7163:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7164:       }
 7165: 
 7166:    }
 7167: 
 7168: 
 7169:    __global__ void setVelocityOpenBndNodes(void) {
 7170:    // For open boundary nodes sets their velocity to the imposed values.
 7171: 
 7172:       SIDE_BND(sidebnd);
 7173: 
 7174:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7175:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7176:          // to its segment to the average of the side velocity.
 7177: 
 7178:          for (int k = 0; k < nvrt; k++) {
 7179:             Node *n1 = sidebnd->side->n1;
 7180:             Node *n2 = sidebnd->side->n2;
 7181: 
 7182: 
 7183:             Vector2 n1_u2(n1->u2[k]);
 7184:             Vector2 n2_u2(n2->u2[k]);
 7185: 
 7186:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7187:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7188:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7189:             }
 7190:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7191:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7192:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7193:             }
 7194: 
 7195:          }
 7196: 
 7197:       }
 7198: 
 7199:    }
 7200: 
 7201: 
 7202:    __global__ void computeVerticalVelocity(void) {
 7203:       // Computes the vertical velocity at the (2D) element's centroid.
 7204:       // In this function we will be considering volumetric elements, with side faces and a 
 7205:       // bottom and a top face. We will call them SFs, BF and TF.
 7206:       // It computes the flux coming from BF and the SFs.
 7207:       // If the bed is moving, it takes that into account.
 7208:       // Since water is incompressible, the integral of the velocity times the normal vector
 7209:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7210:       // and the BF is equal to the flux going out from the TF.
 7211:       // TF = - BF - sum(SFs).
 7212:       // It then computes the horizontal velocity at the center of TF.
 7213:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7214:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7215:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7216: 
 7217:       ELEM(elem);
 7218: 
 7219:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7220: 
 7221:       if (elem->isDry) return;
 7222: 
 7223:       const int kb = elem->kb;
 7224:       const bool isTri = elem->isTri();
 7225: 
 7226:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7227: 
 7228:       // Compute the bottom velocity
 7229:       if constexpr(imm != 0) {
 7230:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7231:       }
 7232: 
 7233: 
 7234:       double bottomArea3D;
 7235:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7236: 
 7237:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7238: 
 7239:       double topArea3D;
 7240: 
 7241:       // Bottom face flux
 7242:       double bottomFlux = 0.0;
 7243:       Vector2 u2meanBottom = {0.0, 0.0};
 7244:       const Vector2 gradh = elem->grad2(&Node::depth);
 7245:       if constexpr(imm==2) {
 7246:          Vector3 ubed;
 7247: 
 7248:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7249:          // updateBDEF(ubed);
 7250:      
 7251:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7252: 
 7253:          // elem->w[kb] += ubed.z;
 7254:       }
 7255:       else {
 7256: 
 7257: 
 7258:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7259:   
 7260:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7261:          // in the direction of motion.
 7262:          const double bottomW = - dot(gradh, u2meanBottom);  
 7263:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7264: 
 7265:          // VElocity associated to the bed deformation
 7266:          double bedVelocity = 0.0;
 7267:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7268: 
 7269:          elem->w[kb] = bedVelocity + bottomW; 
 7270: 
 7271:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7272:          
 7273:       } // if imm
 7274: 
 7275:       // Compute w for kb+1 to nvrt-1
 7276:       for (int l = kb; l < nvrt - 1; l++) {
 7277: 
 7278:          // normal vector to the top face of the "volumetric" element (3D)
 7279:          Vector3 elem_top_n = -elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7280: 
 7281:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7282:          assert(elem_top_n.z < 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7283: 
 7284:          // Compute the total flux at the sides
 7285:          double sideFlux = 0.0;
 7286: 
 7287:          for (int j = 0; j < elem->i34; j++) {
 7288:             const Side *side = elem->sides[j];
 7289:             const int kbs = side->kb;
 7290:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7291:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7292:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7293: 
 7294:             // The area is "clamped" meaning that it takes kb into account.
 7295:             const double sideArea = side->areaClamped(l);
 7296: 
 7297:             const double sign = elem->ssign[j]; 
 7298: 
 7299:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7300:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7301:          }
 7302:          
 7303:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7304:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7305:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7306: 
 7307:          // The flux at the top ace can be computed from the other flows.
 7308:          // All fluxes are in directions into the prism.
 7309:          const double topFlux = - sideFlux - bottomFlux;
 7310: 
 7311:          // Flux at the top face due to the horizontal velocities only
 7312:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7313: 
 7314:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + bottomFlux = 0, so:
 7315:          const double topVerticalFlux = -sideFlux - topHorizontalFlux - bottomFlux;  
 7316: 
 7317:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7318: 
 7319:          bottomFlux = -topFlux;
 7320:       }
 7321:    }  
 7322: 
 7323: 
 7324: 
 7325: 
 7326: 
 7327: 
 7328: 
 7329: // !===============================================================================
 7330: // !===============================================================================
 7331: 
 7332: } // extern "C"
 7333: 
 7334: #ifdef DONTCOMPILE
 7335: __device__ void computeVerticalAdvection(void) {
 7336:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7337: 
 7338:    sdbt(1:2,:,:)=0.d0
 7339: 
 7340:    const Side *side = FROM kernel;
 7341: 
 7342:    if(side->isDry) return;
 7343: 
 7344:    // If side is wet...
 7345: 
 7346: 
 7347:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7348:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7349:    double ws[nvrt] = {} // w @ side
 7350:    int icount = 0;
 7351:    for (int j=0; j<2; j++) {
 7352:       const Element *elem = side->elements[j];
 7353:        
 7354:       if(elem != nullptr) {
 7355:          icount++;
 7356:          for (int k=0; k<nvrt; k++) {
 7357:             ws[k] = ws[k] + elem->w[k];
 7358:          }
 7359:       }
 7360:    }  // for j
 7361: 
 7362:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7363:    ws = ws/icount;
 7364: 
 7365:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7366:    // Splines allow for a smooth transition between vertical levels.
 7367:    // Splines have continuity restrictions at the internal knots, but
 7368:    // we have to provide the 1st derivatives at the endpoints.
 7369:    const int kbs = side->kbs; 
 7370:    
 7371:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7372:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7373:    initCubicSpline(kbs, nvrt, side, ws, up)
 7374: 
 7375:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7376:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7377:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7378: 
 7379:    // Total advection (average onto side)
 7380:    const Node *node1 = side->nodes[0];
 7381:    const Node *node2 = side->nodes[1];
 7382:    for (int k=kbs(i); k<nvrt; k++) {
 7383: 
 7384:       Vector2 bcc1 = node1->bcc[k];
 7385:       Vector2 bcc2 = node2->bcc[k];
 7386:       if constexpr(ics == 2) {
 7387:          // Project the velocities from the node frames to the side frame
 7388:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7389:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7390:       }
 7391: 
 7392:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7393:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7394: 
 7395:    }
 7396: }
 7397: #endif
 7398: 
 7399: 
 7400: extern "C" {
 7401:    __global__ void computeElemAverageGhat(void) {
 7402:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7403: 
 7404:       ELEM(elem);
 7405:       
 7406:       elem->ghat1= {0.0, 0.0};  
 7407: 
 7408:       if constexpr(ihydraulics != 0) {
 7409:          if (nhtblocks > 0 && elem->isblock) return;
 7410:       }
 7411: 
 7412:       
 7413:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7414:       // cff1-3: coefficients for 2D/3D
 7415: 
 7416:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7417:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7418:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7419: 
 7420:       if (elem->isDry) return;
 7421: 
 7422:       // Average of the coefficients
 7423:       double av_cff1 = 0.0;  // av. for cff1
 7424:       double av_cff2 = 0.0;  // av. for cff2
 7425:       double av_cff3 = 0.0;  // av. for cff3
 7426:       double av_df = 0.0;  // av. for H^\alpha / H
 7427:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7428:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7429: 
 7430:       const int i34 = elem->i34;
 7431:       const int kb  = elem->kb;
 7432: 
 7433:       for (int j=0; j<i34; j++) {
 7434:          // For each node and side in the element...
 7435: 
 7436:          const Node *node = elem->nodes[j];
 7437:          const Side *side = elem->sides[j];
 7438: 
 7439:          const double chi      = side->chi;
 7440:          const double veg_c2   = side->veg_c2;
 7441:          const double veg_beta = side->veg_beta;
 7442:          const double veg_h    = side->veg_h();
 7443:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7444: 
 7445:          const Vector2 gradPhi = elem->gradPhi[j];
 7446: 
 7447:          // Node - const in elem
 7448:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7449:          elem->gradPr  += node->pr  *gradPhi;
 7450: 
 7451:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7452: 
 7453:         
 7454:          const double htot  = side->htot2();        // Total depth at the side
 7455:          const double zctr2 = side->zTopCanopy();  
 7456: 
 7457:          double cff1; 
 7458:          double cff2; 
 7459:          double cff3;   
 7460:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7461:          // coefficients applied to 2D/3D case 
 7462:             cff1 = side->hhat/htot;
 7463:             cff2 = 0.0;
 7464:             cff3 = 0.0;
 7465:          } else { //3D
 7466:             //Init for no-veg case
 7467:             cff1 = 1.0;
 7468:             cff2 = 1.0;
 7469:             cff3 = 0.0;
 7470: 
 7471:             if constexpr(iveg != 0) {
 7472:                // Computes coefficients used with vegetation terms G1, G2
 7473:                // cff1, cff3 are used for the first two terms in G1, G2:
 7474:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7475:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7476:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7477:                if(veg_h < 0.99*htot) { // submergent vegetation
 7478:                   cff1 = 1.0;
 7479:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7480:                   cff3 = veg_c;
 7481: 
 7482:                } else { // emergent vegetation
 7483:                   cff1 = 1.0/(1.0 + veg_c2);
 7484:                   cff2 = cff1;
 7485:                   cff3 = 0.0;
 7486: 
 7487:                }
 7488:             } // if iveg
 7489:          } //  2D/3D
 7490: 
 7491:          av_cff1 += cff1/i34;
 7492:          av_cff2 += cff2/i34;
 7493:          av_cff3 += cff3/i34;
 7494:          av_cff2_chi += cff2*chi/i34;
 7495:          av_cff3_chi += cff3*chi/i34;
 7496:          av_df += min(htot, veg_h)/(htot*i34);
 7497: 
 7498: 
 7499:          // btrack values: U^\star, U^{\star\alpha}
 7500:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7501:          Vector2 Ustar       = {0.0, 0.0}; 
 7502:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7503: 
 7504:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7505:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7506:          } else { //3D
 7507:             for (int k = side->kb + 1; k < nvrt; k++) {
 7508:             
 7509:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7510:                Ustar += w2;
 7511: 
 7512:                if constexpr(iveg != 0) {
 7513:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7514:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7515:                        Ustar_alpha += zrat*w2; // XXXX
 7516:                    }
 7517:                }  // if iveg
 7518:             }  // for k
 7519:          }  //2D/3D
 7520: 
 7521:          // If needed, project the side velocities to the element frame
 7522:          if constexpr(ics==2) {
 7523:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7524:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7525:          }
 7526:         
 7527: 
 7528:          // Add btrack & surface stress terms to \breve{G} first
 7529:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7530: 
 7531: 
 7532:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7533:          Vector2 tau    = side->tau();  
 7534:          Vector2 ubstar = side->btu[side->kb + 1];  
 7535: 
 7536:          // If needed, project tau and ubstar to the element frame
 7537:          if constexpr(ics==2) {
 7538:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7539:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7540:          }
 7541: 
 7542:          // Term for surface and bottom stress
 7543:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7544: 
 7545: 
 7546:          // All terms in F,F^\alpha,f_b except baroclinic
 7547:          // F, f_b: all explicit terms excluding vegetation 
 7548:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7549:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7550:          const double coriolis = side->coriolis;
 7551:          Vector2 F  =  coriolis*side->U;  // F_x
 7552:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7553:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7554: 
 7555:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7556:             
 7557:             for (int k = side->kb; k < nvrt; k++) {
 7558:                if (zctr2 > side->zc[k-1]) {
 7559:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7560:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7561:                    Fa +=  coriolis*w2*zrat;
 7562:                } // if zctr2
 7563:             } // k
 7564:          } // iveg
 7565: 
 7566:          // Integrate horizontal viscosity force vertically
 7567:          for (int k=side->kb + 1; k<nvrt; k++) {
 7568:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7569: 
 7570:             F += levelHorVisc;
 7571: 
 7572:             // Vegetation term
 7573:             if constexpr(iveg!=0) {
 7574:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7575:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7576:                   Fa += levelHorVisc*zrat;
 7577:                } 
 7578:             } // if iveg
 7579:          } // for k
 7580: 
 7581:          // Get nu*grad(U) at the side's bottom level
 7582:          Vector2 nuGradU = side->nuGradU[side->kb];
 7583: 
 7584:          fb += nuGradU;
 7585: 
 7586:          // If needed, project vectorsF, fb and Fa to the element frame
 7587:          if constexpr(ics==2) {
 7588:             F    = side->frame.projHorVec(F,    elem->frame);
 7589:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7590:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7591:          } // if ics
 7592: 
 7593:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7594:       } // for j (nodes and sides)
 7595: 
 7596:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7597: 
 7598: 
 7599:       // Finish off terms in F, F^\alpha and f_b
 7600:       const double grav3 = elem->mean(&Node::grav2);
 7601:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7602:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7603:       for (int j=0; j<i34; j++) { 
 7604:          // For each side in the element...
 7605:          const Side *side = elem->sides[j];
 7606:          const double chi = side->chi;
 7607: 
 7608:          const double htot = side->htot2();
 7609:          const double veg_h = side->veg_h();
 7610:          const Vector2 F  = htot*fb;
 7611:          const Vector2 Fa = min(htot, veg_h)*fb;
 7612: 
 7613:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7614:       } // for j
 7615: 
 7616:       // tmp is already in elem frame
 7617:       elem->ghat1 += tmp/i34;
 7618: 
 7619:       // Baroclinic force
 7620:       if constexpr(ibc==0) {
 7621:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7622: 
 7623:          Vector2 Fa = {0.0, 0.0};
 7624:          Vector2 intGradRho = {0.0, 0.0};
 7625:          
 7626:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7627:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7628:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7629: 
 7630:             // \in F [m^2/s/s]
 7631:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7632:          }
 7633: 
 7634:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7635:          const Vector2 F = av_df*Fa; //approx
 7636:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7637: 
 7638:       } // if ibc
 7639: 
 7640: 
 7641: 
 7642:    }
 7643: 
 7644: } // extern "C"
 7645: 
 7646: 
 7647: 
 7648: #ifdef DONTCOMPILE
 7649: __global__ void checkMassConservation(Tracers* sumtr) {
 7650: 
 7651:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7652: 
 7653:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7654: 
 7655:    Element *elem = &(mesh->localElemData[i]);
 7656: 
 7657:    // Skip dry elements
 7658:    if (elem->isDry) return;
 7659: 
 7660:    // Local sum array for this thread
 7661:    double localSum[N_TRACERS] = {0.0};
 7662: 
 7663:    // Sum over vertical levels for this element
 7664:    const int kbe = elem->kbe;
 7665:    const double area = elem->area;
 7666: 
 7667:    for (int k = kbe; k < nvrt; k++) {
 7668:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7669:       
 7670:       // Accumulate tracer mass
 7671:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7672:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7673:       }
 7674:    }
 7675: 
 7676:    //  This function returns per element sums. A reduction must be done on the host side.
 7677: }
 7678: 
 7679: 
 7680: __global__ void transport(void) {
 7681: 
 7682:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7683: 
 7684:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7685: 
 7686:    Element *elem = &(mesh->localElemData[ie]);
 7687: 
 7688:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7689: 
 7690:                for (int m=0; m<ntr; m++) {
 7691:                   for (int k=kbe(ie); k<nvrt; k++) {
 7692:                      // Calculate each polynomial's weight 
 7693:                      wm=0.d0; sum1=0.d0; 
 7694:                      wm1=0.d0; wm2=0.d0; 
 7695:                      for (int i=0; i<elem->nweno2; i++) {
 7696:                   
 7697:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7698:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7699:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7700:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7701:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7702:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7703:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7704:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7705:                      // -----------------Hu and Shu (1999)'s method----------------
 7706:                      b4=b1+b2+b3
 7707: 
 7708: //Error: add PRODUCTION CPP
 7709: #ifdef DEBUG
 7710:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7711:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7712:                     call parallel_abort(errmsg)
 7713:                   }
 7714: #endif
 7715: 
 7716:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7717:                   // !----test-------------- 
 7718:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7719:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7720:                   // !wm(i)=wm1(i)*wm2(i)
 7721:                   // !---------------------- 
 7722:                   sum1=sum1+wm(i)
 7723:                 } // end for i
 7724: 
 7725:                 wm=wm/sum1
 7726: 
 7727:                 for (int j=0; j<elem->i34; j++) {
 7728: 
 7729:                   const Side *side  = elem->sides[j];
 7730:                   const Node *node1 = side->n1;
 7731:                   const Node *node2 = side->n2;
 7732: 
 7733:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7734:                      trsd=0.d0
 7735:                      for (int kk=0; kk<nquad; kk++) {
 7736:                         for (int i=0; i<elem->nweno2; i++) {
 7737:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7738:                         } // end for i   
 7739:                      } // end for kk
 7740:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7741:                   } // outward flux
 7742:                } // end for j=1,i34(ie) ! side
 7743:             }
 7744:          }
 7745:               
 7746: 
 7747: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7748: //             //   calculate each polynomial's weight 
 7749: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7750: //                 wm=0.d0; sum1=0.d0
 7751: //                 do i=1,nweno1(ie) !for each polynomial
 7752: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7753: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7754: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7755: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7756: //                   wm(i)=b2
 7757: //                   sum1=sum1+b2
 7758: //                   !wm(i)=1.d0
 7759: //                   !sum1=sum1+1.d0
 7760: 
 7761: // // Error: PRODUCTION
 7762: // #ifdef DEBUG
 7763: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7764: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7765: //                     call parallel_abort(errmsg)
 7766: //                   endif
 7767: // #endif
 7768: 
 7769: //                 enddo !i
 7770: //                 wm=wm/sum1 !final weight
 7771: 
 7772:                 for (int j=0; j<elem->i34; j++) { // side
 7773:                   const Side *side = elem->sides[j];
 7774:                   const Node *node1 = side->n1;
 7775:                   const Node *node2 = side->n2;
 7776: 
 7777:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7778:                     trsd=0.d0
 7779:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7780:                       for (int i=0; i<elem->nweno1; i++) {
 7781:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7782:                       }
 7783:                     enddo //kk
 7784:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7785:                   } // outward flux
 7786:                 } // end for j=1,i34(ie) ! side
 7787:               } // end for k; ntr 
 7788: 
 7789:             else !simple upwind method
 7790:               do j=1,i34(ie)
 7791:                 jsj=elside(j,ie)
 7792:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7793:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7794:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7795:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7796:                   endif
 7797:                 enddo  !vertical layers
 7798:               enddo !j=1,i34(ie) ! side
 7799:             endif !order of accuracy
 7800: 
 7801:          //  enddo !ie
 7802: // !$OMP     end do
