 2740: 
 2741: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2742: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2743: // Returns the normal vector and the area of the element at this level
 2744:    
 2745:    double nx, ny, nz;
 2746: 
 2747:    if (isTri()) {
 2748:       // For triangles...
 2749: 
 2750:       // Indices of the nodes at level k, taking care of not going below the bed
 2751:       const int k0 = max(k, nodes[0]->kb);
 2752:       const int k1 = max(k, nodes[1]->kb);
 2753:       const int k2 = max(k, nodes[2]->kb);
 2754: 
 2755:       // Gets the element frame coordinates of the nodes at level k
 2756:       Point3 x0, x1, x2;
 2757:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2758:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2759:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2760:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2761: 
 2762:       } else {  // ics == 2
 2763:          Point2 h0, h1, h2;
 2764: 
 2765:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2766: 
 2767:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2768:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2769:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2770:       }
 2771: 
 2772:       const Vector3 n20 = x2 - x0;
 2773:       const Vector3 n10 = x1 - x0; 
 2774: 
 2775:       // Computes the cross product of vectors n20 and n10. 
 2776:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2777:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2778:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2779: 
 2780:   
 2781:    }
 2782:    else {
 2783:       // For quads...
 2784:       Point2 h0, h1, h2, h3;
 2785: 
 2786:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2787: 
 2788:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2789:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2790:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2791:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2792: 
 2793:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2794:       nx = n20.y*n31.z - n20.z*n31.y;
 2795:       ny = n20.z*n31.x - n20.x*n31.z;
 2796:       nz = n20.x*n31.y - n20.y*n31.x;
 2797: 
 2798:    }
 2799: 
 2800:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2801:    area3D = 0.5*len;
 2802: 
 2803:    const double inv_len = 1.0/len;
 2804: 
 2805:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2806: 
 2807: }
 2808: 
 2809: 
 2810: // Helper functions to get the 2D local node position for the Celestial walk
 2811: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2812:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2813:    const Node *node = getNodeInOrder(idx2);
 2814: 
 2815:    double z = 0.0;
 2816:    if constexpr(ics == 2) z = node->gz;
 2817:    
 2818:    Point3 p = toPoint3(node->p, z);
 2819: 
 2820:    return toPoint2(origSide->toLocalFrame(p));
 2821: }
 2822: 
 2823: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2824:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2825: }
 2826: 
 2827: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2828:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2829: // Computes the three per-side predicates needed for the celestial walk
 2830: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2831: //
 2832: // xt is in local frame coordinates for origSide if ics == 2.
 2833: //
 2834: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2835: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2836: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2837: // meaningless on triangles are masked to a safe value (see comments below).
 2838: {
 2839:    // Project all 4 corner positions once into the local 2D frame.
 2840:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2841:    // getLocalNodePosition only transforms/projects if ics == 2.
 2842:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2843:                         getLocalNodePosition(1, origSide), 
 2844:                         getLocalNodePosition(2, origSide), 
 2845:                         getLocalNodePosition(3, origSide)};
 2846: 
 2847:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2848:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2849:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2850:    // But still farther towards the target point from the current point.
 2851:    const Vector2 vt0 = xt - x0;
 2852:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2853:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2854:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2855: 
 2856:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2857:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2858: 
 2859: 
 2860: // if (origSide->idx == 2860848 && jlev == 46) {
 2861: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2862: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2863: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2864: // }
 2865:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2866:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2867:    //  here the orientation is baked into the corners array.)
 2868:    const int i3 = nxq(3);
 2869:    const Vector2 s0 = C[ 1] - C[ 0];
 2870:    const Vector2 s1 = C[ 2] - C[ 1];
 2871:    const Vector2 s2 = C[i3] - C[ 2];
 2872:    const Vector2 s3 = C[ 0] - C[i3];
 2873:    
 2874:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2875:    // The corners array is built from getNode in CCW order, so the orientation
 2876:    // is already correct and no ssign factor is needed in the formulas below.
 2877:    //
 2878:    // i3 = nxq(3): the index of the corner after side 2.
 2879:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2880:    //   Quad:     i3 == 3.
 2881:    //
 2882:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2883:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2884:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2885:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2886:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2887:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2888: 
 2889: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2890: 
 2891:    // For triangles, the corner after side 2 is the closing corner where
 2892:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2893:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2894:    // s0 for triangles, s3 for quads.
 2895:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2896: 
 2897:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2898:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2899:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2900:    //
 2901:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2902:    // result is false naturally. No sentinel needed.
 2903:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2904:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2905:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2906:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2907: 
 2908:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2909:    // on the "exit through side I" half of the corner cone, separated by the
 2910:    // approximate angular bisector of the celestial walk. The bisector is
 2911:    // perpendicular to the chord across the corner; the test is the sign of
 2912:    // (xt - corner_vertex) projected onto that chord.
 2913:    //
 2914:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2915:    // (the validity rule sets valid_3 = false), so its computed value for
 2916:    // triangles doesn't matter. No sentinel needed.
 2917:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2918:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2919:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2920:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2921: 
 2922: }
 2923: 
 2924: 
 2925: __inline__ __device__ double Element::computeSignedArea(void) const {
 2926:    // Compute the area of the element
 2927: 
 2928:    Point2 x0, x1, x2, x3;
 2929:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2930: 
 2931: 
 2932:    double res = signedArea(x0, x1, x2);
 2933: 
 2934:    // In the quad case we need to add the area of the other triangle.
 2935:    if (isQuad()) {
 2936:       x3 = getLocalHorizontalNodePosition(3);
 2937:       double ar1 = signedArea(x0, x2, x3);
 2938:       double ar2 = signedArea(x0, x1, x3);
 2939:       double ar3 = signedArea(x1, x2, x3);
 2940:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2941: 
 2942:       res += ar1;
 2943: 
 2944:    }
 2945: 
 2946:    return res;
 2947: }
 2948: 
 2949: 
 2950: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2951:                                                                 (nodes[1]->isDry2()) ||
 2952:                                                                 (nodes[2]->isDry2()) ||
 2953:                                                                 (isQuad() && nodes[3]->isDry2());
 2954: }
 2955: 
 2956: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2957:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2958: }
 2959: 
 2960: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2961:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2962: }
 2963: 
 2964: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2965:    // In boundary sides, the element 1 is nullptr
 2966:    return side->elems[1] == nullptr; 
 2967: }
 2968: 
 2969: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2970:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2971:    // For ics == 2, this function uses local frame coordinates.
 2972: 
 2973:    assert(isQuad());
 2974: 
 2975:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2976:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2977:    // where vxi, veta, vb are vectors and c is the center of the element.
 2978: 
 2979:    Point2 p0, p1, p2, p3;
 2980: 
 2981:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2982: 
 2983:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2984:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2985:    // vectors vxi and veta connect the centers of opposite sides
 2986:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2987:    // vb is zero for parallelogram elements.
 2988:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2989: 
 2990:    //  The bilinear mapping is:
 2991:    //      P(s,t) = C + s*U + t*V + s*t*W
 2992:    //
 2993:    //  where:
 2994:    //    C = centroid (average of four vertices)
 2995:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2996:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2997:    //    W = bilinear correction; measures deviation from parallelogram
 2998:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2999:    //        W = 0 for parallelogram elements.
 3000:    //
 3001:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3002:    //
 3003:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3004:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3005:    //
 3006:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3007:    //
 3008:    //  Geometrically, (L) projects everything onto the direction
 3009:    //  perpendicular to W, where the mapping is purely affine.
 3010:    //
 3011:    //  The dot product with nb retains the nonlinear term:
 3012:    //
 3013:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3014:    //
 3015:    //  Geometrically, (Q) projects onto the W direction, where
 3016:    //  the nonlinearity lives.
 3017:    //
 3018:    //  We solve (L) for whichever variable has the larger coefficient
 3019:    //  (better conditioned back-substitution), substitute into (Q),
 3020:    //  and get a scalar quadratic in the other variable.
 3021:    // ================================================================
 3022: 
 3023:    // ---- Basis vectors ----
 3024:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3025:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3026:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3027:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3028:    // W: nonlinear correction. Difference between quad and parallelogram.
 3029:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3030:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3031: 
 3032:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3033:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3034:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3035:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3036:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3037: 
 3038:    // ---- nb: direction parallel to W, L1-normalized ----
 3039:    // We don't need a unit vector -- just a well-scaled direction parallel
 3040:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3041:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3042:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3043:    //
 3044:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3045:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3046:    // and the quadratic solver takes its linear path (a ~ 0).
 3047:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3048:    const double inv_wlen = 1.0 / wlen1;
 3049:    const Vector2 nb = vb * inv_wlen;
 3050: 
 3051:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3052:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3053:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3054:    // What remains is a pure affine relationship between xi and eta.
 3055:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3056:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3057:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3058: 
 3059:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3060:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3061:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3062:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3063:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3064:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3065:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3066: 
 3067:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3068:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3069:    // minimizing round-off amplification.
 3070:    //
 3071:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3072:    // that uses predicated moves.
 3073:    //
 3074:    // if (fabs(Ls) > fabs(Lt)) {
 3075:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3076:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3077:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3078:    //    const double A = -Qw * Lt;
 3079:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3080:    //    const double C =  Qs * Lp - Qp * Ls;
 3081: 
 3082:    //    double eta1, eta2;
 3083:    //    solveQuadratic(A, B, C, eta1, eta2);
 3084: 
 3085:    //    // Pick root with smaller |eta| (domain centered at 0).
 3086:    //    // Ternary-> predicated move, no branch divergence.
 3087:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3088: 
 3089:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3090:    //    xi = (Lp - Lt * eta) / Ls;
 3091: 
 3092:    // } else {
 3093:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3094:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3095:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3096:    //    const double A = -Qw * Ls;
 3097:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3098:    //    const double C =  Qt * Lp - Qp * Lt;
 3099: 
 3100:    //    double xi1, xi2;
 3101:    //    solveQuadratic(A, B, C, xi1, xi2);
 3102: 
 3103:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3104: 
 3105:    //    eta = (Lp - Ls * xi) / Lt;
 3106:    // }
 3107:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3108:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3109:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3110:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3111:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3112: 
 3113:    // Quadratic:  A*r^2 + B*r + C = 0
 3114:    // (same formula for both cases, just with swapped coefficients)
 3115:    const double A = -Qw * Lb;
 3116:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3117:    const double C =  Qa * Lp - Qp * La;
 3118: 
 3119:    double r1, r2;
 3120:    solveQuadratic(A, B, C, r1, r2);
 3121: 
 3122:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3123:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3124: 
 3125:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3126:    const double other = (Lp - Lb * r) / La;
 3127: 
 3128:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3129:    xi  = solve_s ? r     : other;
 3130:    eta = solve_s ? other : r;
 3131: 
 3132: 
 3133:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3134:    xi  = clamp(xi,  -1.0, 1.0);
 3135:    eta = clamp(eta, -1.0, 1.0);
 3136: 
 3137:    // ---- Shape functions ----
 3138:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3139:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3140:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3141:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3142:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3143:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3144:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3145:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3146: 
 3147:    return true;
 3148: }
 3149: 
 3150: /**
 3151:    Compute the shape coordinates of the point (xt,yt) in the element.
 3152:    @param xt (input): x-coordinate of the point
 3153:    @param shpCoords (output): shape coordinates of the point
 3154:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3155:    @return true if the point is inside the element, false otherwise
 3156: **/
 3157: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3158: 
 3159:    // Compute the shape coordinates of the point xt in the element.
 3160:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3161:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3162:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3163:    // from the local frame, so use additional check.
 3164: 
 3165: 
 3166:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3167: 
 3168:    if (isTri()) { // Triangular element
 3169: 
 3170:       // Horizontal local node coordinates. 
 3171:       Point2 x0, x1, x2;
 3172:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3173: 
 3174:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3175:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3176:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3177:       shpCoords[3] = 0.0;
 3178: 
 3179:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3180:       const bool res = (tmpmin >= -small);  
 3181:       
 3182:       // When to fix the negative shape coordinates?
 3183:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3184: 
 3185:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3186:       // then we fix the negative shape coordinates.
 3187:       if ((tmpmin < 0) && fix) {
 3188: 
 3189:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3190:          // keeping the sum of the shape coordinates equal to 1.
 3191:          // I have tested and compared the new algorithm with the old one, and they give
 3192:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3193:          // The new algorithm should be faster since it is branchless.
 3194:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3195:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3196: 
 3197:          shpCoords[0] = (shpCoords[0] + a)*b;
 3198:          shpCoords[1] = (shpCoords[1] + a)*b;
 3199:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3200: 
 3201:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3202:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3203:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3204: 
 3205:          // Update the point coordinates for the new shape coordinates
 3206:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3207:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3208: 
 3209:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3210: 
 3211:       }
 3212: 
 3213:       // Return true if the point is inside the element
 3214:       return res;      
 3215:    }
 3216:    else {
 3217:       assert(isQuad() && "computeShapeCoords");
 3218: 
 3219:       // Horizontal local node coordinates with respect to the original side.
 3220:       Point2 x0, x1, x2, x3;
 3221:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3222: 
 3223:       const double a0 = signedArea(x0, x1, xt);
 3224:       const double a1 = signedArea(x1, x2, xt);
 3225:       const double a2 = signedArea(x2, x3, xt);
 3226:       const double a3 = signedArea(x3, x0, xt);
 3227: 
 3228:       const double minArea = min4(a0, a1, a2, a3);
 3229:       
 3230:       const bool res = (minArea > -small*area);
 3231: 
 3232:       // When to fix the negative shape coordinates?
 3233:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3234: 
 3235:       double xi, eta;    
 3236: 
 3237:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3238:       // Does nothing if ics == 1.
 3239:       assert(origSide != nullptr);
 3240:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3241: 
 3242:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3243: 
 3244:       if (fix) {
 3245:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3246:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3247:          xt.x = interpolate(shpCoords, xn);
 3248:          xt.y = interpolate(shpCoords, yn);
 3249:       }
 3250: 
 3251:       return res;
 3252:    }
 3253: 
 3254: 
 3255:    assert(false && "computeShapeCoords: should never reach this point");
 3256:    return false;  // Never reached
 3257: 
 3258: }
 3259: 
 3260: 
 3261: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3262: // Convert shape coordinates to cartesian coordinates
 3263: 
 3264:    if (isTri()) {
 3265:       // Triangular element
 3266: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3267:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3268:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3269:    }
 3270:    else {
 3271:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3272:    }
 3273: 
 3274: }
 3275: 
 3276: 
 3277: 
 3278: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3279:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3280:    
 3281:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3282: }
 3283: 
 3284: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3285:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3286:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3287:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3288:    return area * dot(gradPhi[i], gradPhi[j]);
 3289: }
 3290: 
 3291: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3292:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3293:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3294:    // The formula for the integral is:
 3295:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3296:    
 3297:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3298:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3299:    const double eta_sum  = eta_n(i) + eta_n(j);
 3300:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3301: 
 3302:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3303:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3304: 
 3305: 
 3306:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3307: }
 3308:    
 3309: 
 3310: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3311:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3312:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3313:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3314:    // The formula is also based on the identity:
 3315:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3316:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3317: 
 3318:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3319: 
 3320: 
 3321: 
 3322:    double res = 0.0;
 3323:    
 3324:    // Quadrature points in xi and eta coordinates
 3325:    #pragma unroll
 3326:    for (int i = 0; i < 4; i++) {
 3327:       // For each quadrature point...
 3328: 
 3329:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3330:       const double eta = p.x;
 3331:       const double xi  = p.y;
 3332: 
 3333:       // Jacobian entries at the Gauss point p
 3334:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3335:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3336:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3337:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3338: 
 3339:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3340:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3341: 
 3342:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3343:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3344:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3345:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3346:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3347: 
 3348:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3349:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3350:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3351:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3352:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3353: 
 3354:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3355:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3356:    }
 3357: 
 3358:    return res;
 3359: }
 3360: 
 3361: 
 3362: /**  Interpolate velocities at a given point (xt,yt,zt)
 3363: 
 3364:    @param xt, yt, zt: coordinates of the point to interpolate
 3365:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3366: 
 3367:    This is done in four steps:
 3368: 
 3369:    1. Find the shape coordinates for the final position in the element.
 3370:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3371:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3372:       z levels at xt, yt at each step.   
 3373:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3374:       horizontally and vertically.
 3375: **/
 3376: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3377:    // Interpolate the velocities at the point xt. 
 3378:    // This function works the same for triangular and quadrilateral elements.
 3379:    double shpCoord[4];
 3380:    Vector3 u_int;
 3381: 
 3382: 
 3383:    // First step is to compute the shape coordinates of (xt,yt)
 3384: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3385:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3386: 
 3387:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3388: 
 3389:    // Second step is to find the level that contains zt
 3390:    // Uses a binary search to find the level
 3391:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3392:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3393:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3394:    int R = nvrt - 1;
 3395: 
 3396:    // Get the z coordinates at the nodes of the element at the levels L and R
 3397:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3398:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3399:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3400: 
 3401: 
 3402:    double zL = interpolate(shpCoord, zLAtNodes);
 3403:    double zR = interpolate(shpCoord, zRAtNodes);
 3404: 
 3405:    // Interpolates vertically the velocities
 3406:    double wght1, wght2;
 3407:    if (xt.z <= zL) {
 3408:       wght1 = 1.0;
 3409:       wght2 = 0.0;
 3410:       xt.z = zL;
 3411:    }
 3412:    else if (xt.z >= zR) {
 3413:       wght1 = 0.0;
 3414:       wght2 = 1.0;
 3415:       xt.z = zR;
 3416:    }
 3417:    else {
 3418:       // Perform a binary search to find the levels between L and R that contain xt.z
 3419:       while (R - L > 1) {
 3420:          int M = (L + R) / 2.0;
 3421: 
 3422:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3423:          double zM = interpolate(shpCoord, zMAtNodes);
 3424:          if (zM < xt.z) 
 3425:          {
 3426:             L = M;
 3427:             zL = zM;
 3428:          }
 3429:          else 
 3430:          {
 3431:             R = M;
 3432:             zR = zM;
 3433:          }
 3434:       }
 3435:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3436:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3437: 
 3438:       wght2 = (xt.z - zL)/(zR - zL);
 3439:       wght1 = 1.0 - wght2;
 3440: 
 3441:    }
 3442: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3443: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3444:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3445:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3446:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3447:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3448: 
 3449:    // Project the velocity from the local frame to the origSide frame
 3450:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3451:    u_int = {uv.x, uv.y, w};
 3452: 
 3453:    // Neither of the interpolated velocities should be NaN
 3454:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3455: 
 3456:    return u_int;
 3457: 
 3458: }
 3459: 
 3460: 
 3461: 
 3462: 
 3463: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3464: 
 3465:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3466:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3467:    const Node *n1 = side->n1;
 3468:    const Node *n2 = side->n2;
 3469: 
 3470:    bool n1_match = (n1->nodeBnd->segment == segment);
 3471:    bool n2_match = (n2->nodeBnd->segment == segment);
 3472: 
 3473:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3474:    if (n1_match && n2_match) {
 3475:       return 0.5;
 3476:    } else if (n1_match) {
 3477:       return 1.0;
 3478:    } else if (n2_match) {
 3479:       return 0.0;
 3480:    }
 3481: 
 3482:    return 0.0;
 3483: }
 3484: 
 3485: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3486: 
 3487: 
 3488: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3489: 
 3490:    const double w1 = getBoundaryArrayValueWeight();
 3491:    const double w2 = 1.0 - w1;
 3492:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3493:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3494: 
 3495:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3496: }
 3497: 
 3498: 
 3499: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3500:    const double w1 = getBoundaryArrayValueWeight();
 3501:    const double w2 = 1.0 - w1;
 3502:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3503:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3504: 
 3505:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3506: 
 3507: }
 3508: 
 3509: 
 3510: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3511:    // Returns the value of the velocity at the side center
 3512:    const double w1 = getBoundaryArrayValueWeight();
 3513:    const double w2 = 1.0 - w1;
 3514:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3515:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3516: 
 3517:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3518: }
 3519: 
 3520: 
 3521: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3522:    // Returns the value of the normal component of the velocity at the side center
 3523:    const double w1 = getBoundaryArrayValueWeight();
 3524:    const double w2 = 1.0 - w1;
 3525:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3526:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3527: 
 3528:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3529: }
