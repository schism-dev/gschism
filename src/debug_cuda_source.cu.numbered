 8566:    ELEM(elem);
 8567: 
 8568:    switch (varCode) {
 8569:       case (int)VarCode::outputCoords:
 8570:          const Point2 coords = elem->outputCoords();
 8571:          res[elem->idx*2    ] = coords.x;
 8572:          res[elem->idx*2 + 1] = coords.y;
 8573:          break;
 8574:    }
 8575: }
