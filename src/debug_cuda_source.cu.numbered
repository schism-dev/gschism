 4535: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4536:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4537:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4538:                 int *isdel, int *isidenode, int *isbnd,
 4539:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4540:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4541:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4542:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4543:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4544:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4545:                 double *drag, double *roughness,
 4546:                 double *emo, double *efa, 
 4547:                 double *umo, double *ufa, 
 4548:                 double *vmo, double *vfa) {
 4549: 
 4550:    printf("Populating mesh for partition %d\n", partNum);
 4551: 
 4552:    // XXXXXX THIS function does almost nothing. 
 4553: 
 4554:    nbs = *sharedIdxSideBoundary + 1;
 4555:    nbp = *sharedIdxNodeBoundary + 1;
 4556: 
 4557:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4558: 
 4559: }
 4560: 
 4561: 
 4562: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4563:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4564:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4565: 
 4566: 
 4567:    NODE(node1);
 4568: 
 4569:    node1->clearMatrixRow();
 4570:    node1->qel = 0.0;
 4571: 
 4572:    // THIS IS FOR STRUCTURES XXX
 4573:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4574: 
 4575:    
 4576:    for (int j=0; j<node1->numElements; j++) {
 4577:       // For each element connected to the node...
 4578: 
 4579:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4580: 
 4581:       Element *elem = node1->elements[j];
 4582: 
 4583:       // Compute the average gravity
 4584:       const double grav3 = elem->mean(&Node::grav2);
 4585: 
 4586:       // Look at the documentation for the description of the terms in the following integrals
 4587: 
 4588:       // Integral I_1 
 4589:       // \bar{\breve{H}} 
 4590:       const double hhatb = elem->mean(&Side::hhat);        
 4591: 
 4592:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4593: 
 4594:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4595:       const double area = elem->area;
 4596: 
 4597:       // Integral I_4
 4598:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4599:       // Where
 4600:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4601: 
 4602:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4603:       // of U over the element.
 4604:       const Vector2 U = elem->mean(&Side::U);
 4605: 
 4606:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4607: 
 4608:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4609:       const double I_4_1 = dot(gradPhi_1, U);
 4610: 
 4611: 
 4612:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4613:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4614: 
 4615:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4616: 
 4617: 
 4618:       // Normal component of the bed velocity
 4619:       double ubedNormalComp = 0.0;
 4620:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4621:          Vector3 ubed = {0.0, 0.0, 0.0};
 4622:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4623:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4624: 
 4625:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4626:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4627:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4628: 
 4629:          // Computes the normal component of the bed velocity
 4630:          ubedNormalComp = dot(ubed, N);
 4631:       } // imm==2
 4632: 
 4633:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4634: 
 4635:       if (elem->isTri()) {
 4636: 
 4637:          // To clarify the notation in this section: 
 4638:          //   In formulas, we use the following notation:
 4639:          //       i stands for the node under consideration (node1)
 4640:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4641:          //   However, in the code, we use the following notation:
 4642:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4643:          const int id2 = elem->nxq(1 + id1);
 4644:          const int id3 = elem->nxq(2 + id1);
 4645:          Node *node2 = elem->nodes[id2];
 4646:          Node *node3 = elem->nodes[id3];
 4647: 
 4648:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4649: 
 4650:          // integral of phi_i*phi_j
 4651:          const double ipp_ii = (1.0/6.0 )*area;
 4652:          const double ipp_ij = (1.0/12.0)*area;
 4653:          const double ipp_ik = (1.0/12.0)*area;
 4654: 
 4655:          // integral of [(grad phi_i) * (grad phi_j)]
 4656:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4657:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4658:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4659: 
 4660:          // Computes the different components of integral I_1 of each node with respect to node i.
 4661:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4662:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4663:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4664: 
 4665:          node1->addToSparseMatrix(node1, I1_ii);
 4666:          node1->addToSparseMatrix(node2, I1_ij); 
 4667:          node1->addToSparseMatrix(node3, I1_ik);
 4668: 
 4669:          #pragma unroll
 4670:          for (int l=0; l<3; l++) {
 4671: 
 4672:             Node *node = elem->nodes[l];
 4673: 
 4674:             // Additional variation in eta due to bed deformation or vertical velocity
 4675:             double extraEta = 0.0;
 4676:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4677:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4678: 
 4679: 
 4680:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4681:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4682: 
 4683:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4684: 
 4685:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4686:            
 4687:          }
 4688: 
 4689: 
 4690:       }
 4691:       else { // Quad
 4692:          // To clarify the notation in this section: 
 4693:          //   In formulas, we use the following notation:
 4694:          //       i stands for the node under consideration (node1)
 4695:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4696:          //   However, in the code, we use the following notation:
 4697:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4698:          const int id2 = elem->nxq(1 + id1);
 4699:          const int id3 = elem->nxq(2 + id1);
 4700:          const int id4 = elem->nxq(3 + id1);
 4701:          Node *node2 = elem->nodes[id2];
 4702:          Node *node3 = elem->nodes[id3];
 4703:          Node *node4 = elem->nodes[id4];   
 4704:          
 4705:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4706: 
 4707:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4708:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4709:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4710:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4711:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4712: 
 4713:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4714:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4715:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4716:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4717:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4718: 
 4719: 
 4720:          // Computes the different components of integral I_1 of each node with respect to node i.
 4721:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4722:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4723:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4724:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4725: 
 4726:          node1->addToSparseMatrix(node1, I1_ii);
 4727:          node1->addToSparseMatrix(node2, I1_ij); 
 4728:          node1->addToSparseMatrix(node3, I1_ik);
 4729:          node1->addToSparseMatrix(node4, I1_il);
 4730:   
 4731:          #pragma unroll
 4732:          for (int l=0; l<4; l++) {
 4733: 
 4734:             const Node *node = elem->nodes[l];
 4735: 
 4736:             // Additional variation in eta due to bed deformation or vertical velocity
 4737:             double extraEta = 0.0;
 4738:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4739:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4740: 
 4741:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4742:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4743:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4744: 
 4745:          }         
 4746:       } 
 4747: 
 4748: 
 4749:      node1->qel += (dt/elem->i34)*elem->vsource;
 4750:       
 4751: 
 4752:    } // for all elements connected to the node
 4753:    
 4754: 
 4755:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4756:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4757:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4758:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 4759:    // If it is an open boundary node...
 4760: 
 4761:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4762: 
 4763:       // At least one open bnd side, maybe two
 4764:       for (int l=0; l<2; l++) { 
 4765: 
 4766:          // Gets each of the sides sharing the node. 
 4767:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4768: 
 4769:     
 4770: 
 4771:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4772:          if (sideBnd != nullptr) {
 4773:             // If the side is on a boundary...
 4774: 
 4775:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4776: 
 4777:             // Get the boundary segment
 4778:             const BoundarySegment *sideSegment = sideBnd->segment;
 4779:             const Side *side = sideBnd->side;
 4780: 
 4781:             // Integral I_3
 4782:             if (sideSegment->ifltype != 0) {
 4783:             // Natural or Flather b.c.
 4784: 
 4785:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4786:                // especially for Flather b.c.
 4787:                double ri3 = 0.0;
 4788:                if (!side->isDry) {
 4789:                   // If the side is not dry
 4790:                   
 4791:                   // Computes the side flux of (uth, vth)
 4792:                   double Vn = 0.0;
 4793:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4794:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4795:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4796: 
 4797:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4798:                   }
 4799: 
 4800:                   ri3 = 0.5*side->len*Vn;
 4801:                }
 4802: 
 4803:                if (sideSegment->ifltype == -1) { // Flather 1
 4804: 
 4805:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4806:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4807: 
 4808:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4809:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4810:                   
 4811:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4812:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4813: 
 4814:                } 
 4815:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4816:                   // Reset ri3
 4817:                   ri3 = 0.0;
 4818: 
 4819:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4820:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4821: 
 4822:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4823: 
 4824:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4825:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4826: 
 4827:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4828:                   node1->addToSparseMatrix(node1, con0*2.0);
 4829:                   node1->addToSparseMatrix(node2, con0);
 4830: 
 4831:                } // if Flather or Discharge
 4832: 
 4833:                node1->qel -= thetai*dt*ri3;  
 4834: 
 4835: 
 4836:             } // I_3
 4837:           
 4838: 
 4839:             // Integral I_5
 4840:             if(!side->isDry) {
 4841: 
 4842:                const double Unbar = dot(side->U, side->n);
 4843:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4844: 
 4845:             } // I_5
 4846: 
 4847:          } // if is boundary side
 4848: 
 4849:       } // for l
 4850: 
 4851:    } // if isbnd
 4852: 
 4853: 
 4854: }
 4855: 
