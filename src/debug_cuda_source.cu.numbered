  924:    double carea; // Area of the boundary segment
  925: 
  926:    int ifltype;  // Type of flow boundary condition
  927:    
  928:    // Elevation boundary condition
  929:    int iettype;  // Type of elevation boundary condition
  930:    double eth;   // Elevation time history
  931: 
  932:    // Flow boundary condition
  933:    double qthcon;  // Flow time history constant
  934:    double vobc1;   // Velocity coefficient 1
  935:    double vobc2;   // Velocity coefficient 2
  936: 
  937:    // Tracer boundary conditions
  938:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  939:    // int  itrtype[natrm];    // Tracer boundary condition type
  940: 
  941:    BoundarySegment(bool _isLand) {
  942:       isLand = _isLand;
  943:       clen = 0.0;
  944:       carea = 0.0;
  945:       ifltype = 0;
  946:       iettype = 0;
  947:       eth = 0.0;
  948:    }
  949: 
  950:    BoundarySegment(void) {
  951:       isLand = false;
  952:       clen = 0.0;
  953:       carea = 0.0;
  954:       ifltype = 0;
  955:       iettype = 0;
  956:       eth = 0.0;
  957:    }
  958: 
  959:    
  960: };
