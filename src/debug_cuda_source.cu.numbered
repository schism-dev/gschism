 6637: 
 6638:    __global__ void computeVerticalVelocity(void) {
 6639:       // Computes the vertical velocity at the (2D) element's centroid.
 6640:       // In this function we will be considering volumetric elements, with side faces and a 
 6641:       // bottom and a top face. We will call them SFs, BF and TF.
 6642:       // It computes the flux coming from BF and the SFs.
 6643:       // If the bed is moving, it takes that into account.
 6644:       // Since water is incompressible, the integral of the velocity times the normal vector
 6645:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6646:       // and the BF is equal to the flux going out from the TF.
 6647:       // TF = - BF - sum(SFs).
 6648:       // It then computes the horizontal velocity at the center of TF.
 6649:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6650:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6651:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6652: 
 6653:       ELEM(elem);
 6654: 
 6655:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6656: 
 6657:       if (elem->isDry) return;
 6658: 
 6659:       const int kb = elem->kb;
 6660:       const bool isTri = elem->isTri();
 6661: 
 6662:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6663: 
 6664:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6665:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6666:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6667: 
 6668:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6669: 
 6670:       double area3D;
 6671: 
 6672:       // Bottom face flux
 6673:       double bottomFlux = 0.0;
 6674:       Vector2 u2meanBottom = {0.0, 0.0};
 6675:       const Vector2 gradh = elem->grad2(&Node::depth);
 6676:       if constexpr(imm==2) {
 6677:          Vector3 ubed;
 6678: 
 6679:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6680:          // updateBDEF(ubed);
 6681:      
 6682:          // const double bflux0 = dot(ubed, elem_n1);
 6683: 
 6684:          // elem->w[kb] += ubed.z;
 6685:       }
 6686:       else {
 6687:          Vector2 umean;
 6688:          if constexpr(ics == 1) {
 6689:             u2meanBottom = elem->mean(kb, &Side::u2);
 6690:          }
 6691:          else {
 6692:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6693:          }
 6694: 
 6695:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6696:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6697: 
 6698:          bottomFlux = - dot(gradh, u2meanBottom);
 6699:       } // if imm
 6700: 
 6701:       // Compute w for kb+1 to nvrt-1
 6702:       for (int l = kb; l < nvrt - 1; l++) {
 6703: 
 6704:          // normal vector to the top face of the "volumetric" element (3D)
 6705:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6706: 
 6707:          // Compute the total flux at the sides
 6708:          double sideFlux = 0.0;
 6709: 
 6710:          for (int j = 0; j < elem->i34; j++) {
 6711:             const Side *side = elem->sides[j];
 6712: 
 6713:             const double sideArea = side->area(l);
 6714:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6715:             const double sign = elem->ssign[j]; 
 6716: 
 6717:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6718:          }
 6719:          
 6720:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6721:          //velocities at the centers of the sides
 6722:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6723: 
 6724:          // The flx at the top ace can be computed from the other flows.
 6725:          const double topFlux = - sideFlux - bottomFlux;
 6726:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6727: 
 6728:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6729: 
 6730:          elem_n1 = elem_n2;
 6731: 
 6732:          bottomFlux = - topFlux;
 6733:       }
 6734:    }  
 6735: 
 6736: 
 6737: 
 6738: 
 6739: 
 6740: 
 6741: 
 6742: // !===============================================================================
 6743: // !===============================================================================
 6744: 
 6745: } // extern "C"
