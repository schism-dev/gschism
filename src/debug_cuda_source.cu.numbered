 2033: #define IDX(ptr) (ptr == nullptr ? -1 : (ptr->idx))
 2034: 
 2035: // Each device has a global mesh object
 2036: __device__ Mesh* mesh = nullptr; 
 2037: 
 2038: 
 2039: 
 2040: // Convenience macros for accessing the objects in kernels.
 2041: 
 2042: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 2043:                    Side *side = &(mesh->localSideData[idx_side]); \
 2044:                    if (idx_side >= mesh->ns) return;
 2045: 
 2046: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 2047:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 2048:                    if (idx_elem >= mesh->ne) return;
 2049: 
 2050: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 2051:                    Node *node = &(mesh->localNodeData[idx_node]); \
 2052:                    if (idx_node >= mesh->np) return;
 2053: 
 2054: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 2055:                               Node *node = &(mesh->localNodeData[idx_node]); \
 2056:                               const bool valid = (idx_node < mesh->np);                   
 2057: 
 2058: 
 2059: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2060:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 2061:                            if (idx_node_bnd >= mesh->nbp) return;
 2062: 
 2063: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 2064:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 2065:                            if (idx_side_bnd >= mesh->nbs) return;  
 2066: 
 2067: 
 2068: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2069: {
 2070:     uintptr_t p = (uintptr_t)address;
 2071:     assert((p & 1) == 0);
 2072: 
 2073:     unsigned int* base = (unsigned int*)(p & ~3);
 2074:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2075:                                   :  (unsigned int)val;
 2076: 
 2077:     atomicAdd(base, addend);
 2078: }
