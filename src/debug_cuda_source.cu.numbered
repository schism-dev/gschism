 3353: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3354:    const double w1 = getBoundaryArrayValueWeight();
 3355:    const double w2 = 1.0 - w1;
 3356:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3357:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3358: 
 3359:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3360: 
 3361: }
