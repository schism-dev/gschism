  318: __device__ __forceinline__ double clamp(double x, double minval, double maxval) {
  319:    assert(minval <= maxval && "clamp: minval > maxval");
  320:    return fmin(fmax(x, minval), maxval);
  321: }
  322: 
  323: __device__ __forceinline__ int clamp(int x, int minval, int maxval) {
  324:    assert(minval <= maxval && "clamp: minval > maxval");
  325:    return max(minval, min(x, maxval));
  326: }
