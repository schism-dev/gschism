 3275: 
 3276: __device__ void Node::updateKb(void) {
 3277: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3278: 
 3279:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3280: 
 3281: 
 3282:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3283: 
 3284:    if constexpr(ivcor == 2) {  // SZ coordinates
 3285:       
 3286:       // Compute bottom level index
 3287:       if (depth <= mesh->h_s) {
 3288:          kb = izlev;   
 3289:          
 3290:       } else {
 3291:          kb = -1;
 3292:          int L = 0;
 3293:          int R = nzlev; 
 3294:          
 3295:          while (L <= R) {
 3296:             int M = (R + L) / 2;
 3297: 
 3298: 
 3299:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3300:             
 3301:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3302:                R = M;
 3303:             } else {
 3304:                L = M;
 3305:             }
 3306: 
 3307:             if (R - L == 1) {
 3308:                kb = L;
 3309:                break;
 3310:             }
 3311:          }
 3312: 
 3313:          // Checks that the binary search was successful
 3314:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3315:        
 3316:       }
 3317:    } 
 3318: }
