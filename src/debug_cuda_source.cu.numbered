 1611: 
 1612: 
 1613: 
 1614: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1615:                                               double &t, double& tIntersect) {
 1616: 
 1617:    double closest_intersect_t = 1e10;
 1618:    bool found_intersection = false;
 1619: 
 1620: double minDelta = 1e10; 
 1621: double btt1, btt2;
 1622:    for (int i = 0; i < i34; i++) {
 1623: 
 1624:       Side *side2 = sides[i];
 1625: 
 1626:       // (x3,y3)-(x4,y4) is the element side line
 1627:       const Point2 x3 = side2->n1->p2();
 1628:       const Point2 x4 = side2->n2->p2();
 1629: 
 1630:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1631:       const double delta = cross(x2 - x1, x3 - x4);
 1632: 
 1633:       if (abs(delta) > 0) {
 1634: 
 1635:          const double delta1 = cross(x3 - x1, x3 - x4);
 1636:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1637: 
 1638:          // Solves the two linear equations for tt1 and tt2
 1639:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1640:          const double tt2 = delta2/delta;
 1641: 
 1642: if (abs(delta) < minDelta) {
 1643:    minDelta = abs(delta);
 1644:    btt1 = tt1;
 1645:    btt2 = tt2;
 1646: }
 1647: double small = 1e-7;
 1648:          printf("RRRRRR delta = %e, delta1 = %e, delta2 = %e, tt1 = %e, tt2 = %e\n", delta, delta1, delta2, tt1, tt2);
 1649:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1650:             closest_intersect_t = min(closest_intersect_t, tt1);
 1651:             side = side2;
 1652:             nextElement = side->otherElem(this);
 1653:             t = tt2;
 1654:             tIntersect = max(small, min(tt1, 1.0-small));
 1655:             found_intersection = true;
 1656:          }
 1657:       
 1658:       }
 1659:       else {  // parallel segments
 1660:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1661:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1662: 
 1663:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1664: 
 1665:          // const double dist = dot(x1 - x3, side2->n);
 1666:          // if (abs(dist) < small*length(x3 - x4)) {
 1667:          //    const double2 unitarySide = normalize(x4 - x3);
 1668:          //    const double len = dot(x2 - x1, unitarySide);
 1669:          //    t = t + len;
 1670:          //    t = max(0.0, min(t, 1.0));
 1671:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1672: 
 1673: 
 1674:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1675:          //    // t = tt2;
 1676:          //    found_intersection = true;
 1677:          // }
 1678:       }
 1679: 
 1680: 
 1681:    }
 1682: 
 1683:    if (!found_intersection) {
 1684:       
 1685:       printf("ZZ No intersection found:\n"
 1686:            "Element %d\n"
 1687:            "in = %d\n"
 1688:            "minDelta = %e\n"
 1689:            "tt1 = %e, tt2 = %e\n"
 1690:            "segment: (%f, %f)-(%f, %f)\n"
 1691:            "Vertices:\n"
 1692:          //   "  Nodes nextElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n"
 1693:            "  Nodes curElement: (%f, %f), (%f, %f), (%f, %f),(%f, %f)\n",
 1694:            IDX(nextElement),
 1695:            (btt1 >= -small && btt2 >= -small && btt2 <= 1.0 + small && btt1 <= 1.0 + small),
 1696:            minDelta,
 1697:            btt1, btt2,
 1698:            x1.x, x1.y,
 1699:            x2.x, x2.y,
 1700:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1701:          //   nextElement->nodes[1]->p.x, nextElement->nodes[1]->p.y,
 1702:          //   nextElement->nodes[2]->p.x, nextElement->nodes[2]->p.y,
 1703:          //   nextElement->nodes[0]->p.x, nextElement->nodes[0]->p.y,
 1704:            nodes[0]->p.x, nodes[0]->p.y,
 1705:            nodes[1]->p.x, nodes[1]->p.y,
 1706:            nodes[2]->p.x, nodes[2]->p.y,
 1707:            nodes[0]->p.x, nodes[0]->p.y);
 1708: 
 1709:    }
 1710: 
 1711:    // assert(found_intersection && "No intersection found");
 1712: 
 1713:    // found_intersection should always be true, since we checked all the sides.  
 1714:    return found_intersection;
 1715: }
 1716: 
 1717: 
 1718: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1719:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1720: 
 1721:    printf("Tracking segment goes out of water at element %d\n", curElem->idx);
 1722: 
 1723:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1724:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1725:    // curElement.
 1726: 
 1727:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1728:    // And uses this velocity instead to continue the tracking.
 1729: 
 1730:    // computes the intersection point in cartesian coordinates
 1731:    Point2 intersection = nextSide->p_t(tt);
 1732: 
 1733:    // Nudges the point to the barycenter of the element. 
 1734:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1735:    // next segment intersects the element sides.  
 1736:    curElem->nudgeToBarycenter(intersection);
 1737: 
 1738:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1739:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1740:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1741:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1742: 
 1743:    // If the side is an open boundary, the tangential velocity is zero.
 1744:    if (nextSide->isBnd()) vtan = 0.0;
 1745: 
 1746:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1747:    const double us = vtan*nextSide->t().x;
 1748:    const double vs = vtan*nextSide->t().y;
 1749:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1750: 
 1751:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1752:    const double len2 = norm2(intersection - toPoint2(xt));
 1753:    const double vel2 = dot(u_int, u_int);        
 1754:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1755:    else            dt = 0.0;
 1756: 
 1757:    // The end of this tracking segment is now the intersection point.
 1758:    xt = {intersection.x, intersection.y, zint};
 1759: printf("BBB u_int = %f,%f,%f\n", us, vs, ws);   
 1760:    u_int = {us, vs, ws};
 1761:    
 1762: }
 1763: 
 1764: /**
 1765:  * Tracks a particle through elements and vertical levels in the mesh.
 1766:  * 
 1767:  * @param x0,y0,z0     Starting position coordinates
 1768:  * @param xt,yt,zt     Target position coordinates
 1769:  * @param dtb          Time step for tracking
 1770:  * @param uuint,vvint,wwint Initial velocity components
 1771:  * @param nextElem     Starting/resulting element index
 1772:  * 
 1773:  * @return Status code of type trackExitCodes
 1774:  * 
 1775:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1776:  * of the details are different. The idea is that the code requires less branches and is better fit
 1777:  * for GPU execution.
 1778:  * 
 1779:  * The main ideas here are:
 1780:  * - The starting point is expected to be in the starting element.
 1781:  * - The end point is guaranteed to be inside an element.
 1782:  * - since the starting point is inside the element, there are only two cases: 
 1783:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1784:  *     (b) it does not and (xt,yt) is already in the starting element.
 1785:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1786:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1787:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1788:  * - tt1 can be positive or negative. We only consider the positive values.
 1789:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1790:  * - The next intersection will occur at the smallest positive tt1.
 1791:  * - This intersection will be the next (x0,y0) position.
 1792:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1793:  *   of getting stuck in a loop.
 1794:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1795:  *   was found.
 1796:  */
 1797: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1798:                                                        Element *&nextElem, int &jlev, double &dt) {
 1799: 
 1800:    // First thing is to check if the target point is inside the element. If it is there is nothing
 1801:    // else to do.
 1802: 
 1803:    const Element *curElem = nextElem;
 1804:    if (containsPoint(toPoint2(xt))) {
 1805: printf(" ___BBB0_____ idx = %d, u_int = %.17g,%.17g,%.17g\n", curElem->idx, u_int.x, u_int.y, u_int.z);            
 1806:       curElem->interpolateVelocities(xt, u_int);
 1807: printf(" ___BBB_____ idx = %d, u_int = %.17g,%.17g,%.17g\n", curElem->idx, u_int.x, u_int.y, u_int.z);      
 1808:       return true;
 1809:    }
 1810: 
 1811:    Side *side = nullptr;
 1812: 
 1813:    // 1. Initial checks
 1814:    // Verify starting element is valid (wet)
 1815:    assert(!curElem->isDry && "Starting element is dry");
 1816: 
 1817:    // Checks if track has a zero length.
 1818:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1819:    // assert(len2 > 0.0 && "Zero length track"); 
 1820:    
 1821:    const int MAX_ITERATIONS = 1000;
 1822:    
 1823:    double t;
 1824:    Side *nextSide = nullptr;
 1825:    double tIntersect = 1e10;
 1826:    double zint = x0.z;
 1827: 
 1828:    // Horizontal tracking loop
 1829:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1830:    // (x0,y0) is inside the element but the target point is not.
 1831: 
 1832:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1833: 
 1834:    if (!found_intersection) {
 1835: double shpCoords_0[4];
 1836: double shpCoords_t[4];
 1837: computeShapeCoords(toPoint2(x0), shpCoords_0, false);
 1838: computeShapeCoords(toPoint2(xt), shpCoords_t, false);
 1839:       printf("No intersection found (containsPoint = %d, %d [%.17g, %.17g, %.17g] [%.17g, %.17g, %.17g]):\n"
 1840:            "Elements %d, %d\n"
 1841:            "Side %d\n"
 1842:            "segment: (%f, %f),(%f, %f)\n"
 1843:            "triangle node indices: %d, %d, %d\n"
 1844:            "triangle: (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n",
 1845:            containsPoint(toPoint2(x0)), containsPoint(toPoint2(xt)),
 1846:            shpCoords_0[0], shpCoords_0[1], shpCoords_0[2],
 1847:            shpCoords_t[0], shpCoords_t[1], shpCoords_t[2],
 1848:            IDX(curElem), IDX(nextElem),
 1849:            IDX(nextSide),
 1850:            x0.x, x0.y,
 1851:            xt.x, xt.y,
 1852:            curElem->nodes[0]->idx, curElem->nodes[1]->idx, curElem->nodes[2]->idx,
 1853:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y,
 1854:            curElem->nodes[1]->p.x, curElem->nodes[1]->p.y,
 1855:            curElem->nodes[2]->p.x, curElem->nodes[2]->p.y,
 1856:            curElem->nodes[0]->p.x, curElem->nodes[0]->p.y);
 1857:    }
 1858:    assert(found_intersection && "No intersection found at %d");
 1859: 
 1860:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1861: 
 1862:    // if the tracking segment goes out of water (either dry or edge boundary)
 1863:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1864: 
 1865: 
 1866:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1867:       nextElem = this;
 1868:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1869:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1870:       return true;    
 1871:    }
 1872: 
 1873: 
 1874:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1875:    int iterations = 0;
 1876:    while (iterations < MAX_ITERATIONS) {
 1877:       iterations++;
 1878:       
 1879:       Element *curElem = nextElem;
 1880: 
 1881:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1882: 
 1883:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1884: printf(" ___CCC_____ idx = %d, zint = %.17g\n", curElem->idx, zint);      
 1885:       // If we are already in the target element, we are done.
 1886:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1887:       if (!found_intersection) break;
 1888: 
 1889: 
 1890: 
 1891:       // if the tracking segment goes out of water (either dry or edge boundary).
 1892:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1893: 
 1894:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1895: 
 1896:          nextElem = curElem;
 1897: 
 1898: 
 1899:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1900:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1901:          return true;
 1902:       }
 1903:       
 1904:       // Update position and element for next iteration
 1905:       side = nextSide;
 1906: 
 1907:    }
 1908: 
 1909:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 1910: 
 1911:  
 1912:    // Interpolate velocities at the final position. This is a conceptually simple step,
 1913:    // but the function is not simple, because it has to search for the vertical level containing zt.
 1914:    nextElem->interpolateVelocities(xt, u_int);
 1915: printf(" ___AAA_____ u_int = %.17g,%.17g,%.17g\n", u_int.x, u_int.y, u_int.z);      
 1916: 
 1917: 
 1918:    return true;
 1919: }
 1920: 
 1921: 
 1922: __inline__ __device__ double Element::computeSignedArea(void) const {
 1923:    // Compute the area of the element
 1924: 
 1925:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 1926: 
 1927:    // In the quad case we need to add the area of the other triangle.
 1928:    if (isQuad()) {
 1929:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1930:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 1931:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 1932:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 1933:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 1934:          Error("Negative area found in quad element");
 1935:       }
 1936:       res += ar1;
 1937:    }
 1938: 
 1939:    return res;
 1940: }
 1941: 
 1942: 
 1943: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 1944:                                                                 (nodes[1]->isDry2()) ||
 1945:                                                                 (nodes[2]->isDry2()) ||
 1946:                                                                 (i34==4 && nodes[3]->isDry2());
 1947: }
 1948: 
 1949: 
 1950: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 1951:    // In boundary sides, the element 1 is nullptr
 1952:    return side->elems[1] == nullptr; 
 1953: }
 1954: 
 1955: 
 1956: 
 1957: /**
 1958:    Compute the shape coordinates of the point (xt,yt) in the element.
 1959:    @param xt (input): x-coordinate of the point
 1960:    @param shpCoords (output): shape coordinates of the point
 1961:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 1962:    @return true if the point is inside the element, false otherwise
 1963: **/
 1964: __device__ bool Element::computeShapeCoords(Point2 xt, double shpCoords[4],
 1965:                                             bool fixNegshpCoord) const {
 1966: 
 1967:    // Compute the shape coordinates of the point xt in the element.
 1968:    if (i34==3) {
 1969:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 1970:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 1971:       // and in this case, the pt will be nudged into the element
 1972:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 1973:       // from the local frame, so use additional check.
 1974: 
 1975:       Point2 x0, x1, x2;
 1976: 
 1977:       if constexpr(ics==1) {
 1978:          x0 = nodes[0]->p2();
 1979:          x1 = nodes[1]->p2();
 1980:          x2 = nodes[2]->p2();
 1981:       }
 1982:       else // lat/lon
 1983:       {
 1984:          Error("Not implemented yet");
 1985: #ifdef ICS2
 1986:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 1987:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 1988:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 1989: #endif
 1990:       }
 1991: 
 1992:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 1993:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 1994:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 1995:       shpCoords[3] = 0.0;
 1996:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 1997: 
 1998:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 1999:       // then we fix the negative shape coordinates.
 2000:       if (fixNegshpCoord && tmpmin<=0.0) {
 2001: 
 2002:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2003:          // keeping the sum of the shape coordinates equal to 1.
 2004:          // I have tested and compared the new algorithm with the old one, and they give
 2005:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2006:          // The new algorithm should be faster since it is branchless.
 2007:          const double a = - tmpmin + 1.0e-2;  // XXX it used to be 1.0e-4 in the comments of the original code
 2008:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2009:          
 2010:          shpCoords[0] = (shpCoords[0] + a)*b;
 2011:          shpCoords[1] = (shpCoords[1] + a)*b;
 2012:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2013: 
 2014:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2015:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2016:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2017:          }
 2018: 
 2019:          // Update the point coordinates for the new shape coordinates
 2020:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2021:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2022:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2023: 
 2024:       }
 2025: 
 2026:       // Check if the point is inside the element
 2027:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2028:    }
 2029:    else {
 2030:       Error("Not implemented yet");
 2031: #ifdef QUADS
 2032:       // Reproject pt in eframe of nel for ics=2
 2033:       if constexpr(ics==1) {
 2034:          xn2 = xt; 
 2035:          yn2 = yt;
 2036:       }
 2037:       else {
 2038:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2039:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2040:       }
 2041: 
 2042:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2043: #endif
 2044:    }
 2045: 
 2046:    return false;  // Never reached
 2047: 
 2048: }
 2049: 
 2050: 
 2051: /**  Interpolate velocities at a given point (xt,yt,zt)
 2052: 
 2053:    @param xt, yt, zt: coordinates of the point to interpolate
 2054:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2055: 
 2056:    This is done in four steps:
 2057: 
 2058:    1. Find the shape coordinates for the final position in the element.
 2059:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2060:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2061:       z levels at xt, yt at each step.   
 2062:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2063:       horizontally and vertically.
 2064: **/
 2065: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2066:    // Interpolate the velocities at the point xt. 
 2067:    // This function works the same for triangular and quadrilateral elements.
 2068:    double shpCoord[4];
 2069: 
 2070: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2071:    // First step is to compute the shape coordinates of (xt,yt)
 2072:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2073:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2074: 
 2075:    // Second step is to find the level that contains zt
 2076:    // Uses a binary search to find the level
 2077:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2078:    int L = kbe;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2079:    int R = nvrt - 1;
 2080: 
 2081:    // Get the z coordinates at the nodes of the element at the levels L and R
 2082:    double zLAtNodes[4], zRAtNodes[4];
 2083:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2084:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2085: 
 2086:    double zL = interpolate(shpCoord, zLAtNodes);
 2087:    double zR = interpolate(shpCoord, zRAtNodes);
 2088:    
 2089:    // Interpolates vertically the velocities
 2090:    double wght1, wght2;
 2091:    if (xt.z<=zL) {
 2092:       wght1 = 1.0;
 2093:       wght2 = 0.0;
 2094:    }
 2095:    else if (xt.z>=zR) {
 2096:       wght1 = 0.0;
 2097:       wght2 = 1.0;
 2098:    }
 2099:    else {
 2100:       // Perform a binary search to find the levels between L and R that contain xt.z
 2101:       while (R - L > 1) {
 2102:          int M = (L + R) / 2;
 2103: 
 2104:          double zMAtNodes[4];
 2105:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2106:          double zM = interpolate(shpCoord, zMAtNodes);
 2107:          if (zM < xt.z) 
 2108:          {
 2109:             L = M;
 2110:             zL = zM;
 2111:          }
 2112:          else 
 2113:          {
 2114:             R = M;
 2115:             zR = zM;
 2116:          }
 2117:       }
 2118:       assert(L == R-1);
 2119:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2120: 
 2121:       wght2 = (xt.z - zL)/(zR - zL);
 2122:       wght1 = 1.0 - wght2;
 2123:    }
 2124: 
 2125: 
 2126: // printf("$$$ wght1 = %f, wght2 = %f, zt = %f, zL = %f, zR = %f\n", wght1, wght2, xt.z, zL, zR);
 2127: // printf("$$$ shpCoord = %f, %f, %f, %f\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2128:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2129: 
 2130:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2131: printf(" ___BBB2____ idx = %d, wght1 = %.17g, wght2 = %.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u_int = %.17g,%.17g,%.17g\n", idx, wght1, wght2, interpolate(L, shpCoord, &Node::u2).x, interpolate(L, shpCoord, &Node::u2).y, interpolate(L, shpCoord, &Node::u2).z, interpolate(R, shpCoord, &Node::u2).x, interpolate(R, shpCoord, &Node::u2).y, interpolate(R, shpCoord, &Node::u2).z, u_int.x, u_int.y, u_int.z);      
 2132:    // Neither of the interpolated velocities should be NaN
 2133:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2134: 
 2135: }
