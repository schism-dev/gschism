 8226: __global__ void printMatrix(bool full) {
 8227:    // Debugging: print the matrix
 8228: 
 8229:    const int size = mesh->np;
 8230:    double sum = 0.0;
 8231:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8232:       const Node *node = mesh->localNodeData + idx_node;
 8233:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8234:       for (int j = 0; j < node->numNodes; j++) {
 8235:          Node* nbNode = node->nodes[j];
 8236:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8237:          sum += node->coeffMatrix[j];
 8238:       }
 8239:       if (full) printf("]\n");
 8240: 
 8241: 
 8242:    }
 8243:    if (!full) printf("sum=%lf\n", sum);
 8244: }
