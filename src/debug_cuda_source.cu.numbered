  318: // Polynomial class
  319: template<int grade>
  320: struct Polynomial {
  321:     // Static assertion to give a clear error message at compile time
  322:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  323: };
  324: 
  325: 
  326: // Explicit specialization for grade 4
  327: template<>
  328: struct Polynomial<4> {
  329:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  330: 
  331:    // Constructor from coefficients
  332:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  333: 
  334:    __device__ __forceinline__ double eval(double x) const {
  335:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  336:    }
  337: };
  338: 
  339: // ------------------------------------------------------------------------------------------------
  340: 
  341: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  342:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  343:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  344: }
  345: 
  346: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  347:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  348:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  349: }
  350: 
  351: 
  352: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  353:    x3 = y1*z2 - y2*z1;
  354:    y3 = x2*z1 - x1*z2;
  355:    z3 = x1*y2 - x2*y1;
  356: }
  357: 
  358: 
  359: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  360: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  361: 
  362:    const double radius2 = dot(p, p);
  363:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  364:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  365: 
  366:    rlon = atan2(p.y, p.x); // (-pi,pi]
  367: 
  368:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  369:       rlat = asin(p.z/sqrt(radius2));
  370:    } else {
  371:       rlat = asin(p.z/rearth_pole);
  372:    }
  373:   
  374: }
  375: 
  376: __inline__ __device__ void Error(const char* msg) {
  377:    printf("Error: %s\n", msg);
  378:    assert(false);
  379: }
