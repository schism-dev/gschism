 2016: //===============================================================================
 2017: 
 2018: 
 2019: /**
 2020:  * Find the element that contains the target point.
 2021:  * 
 2022:  * @param x0,y0,z0     Starting position coordinates
 2023:  * @param xt,yt,zt     Target position coordinates
 2024:  * @param dtb          Time step for tracking
 2025:  * @param u_int        Initial velocity components
 2026:  * @param nextElem     Starting/resulting element index
 2027:  * 
 2028:  * @return Status code of type trackExitCodes
 2029:  * 
 2030:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 2031:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 2032:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 2033:  * as close the the segment AB as possible, the next point at each iteration is computed
 2034:  * along segment AB, but just after the current element.
 2035:  */
 2036: 
 2037: 
 2038: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 2039: 
 2040:    constexpr int MAX_ITERATIONS = 40;
 2041: 
 2042:    int iter = 0;
 2043:    double fac = 0.00001;
 2044:    while (iter < MAX_ITERATIONS) {
 2045:       iter++;
 2046: 
 2047:       Bool4 isLeft, isObtuse, isBisector;
 2048:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2049: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2050:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2051: 
 2052: 
 2053:       if (isValid.none()) 
 2054:       // Inside the element if none of the edges is a valid continuation
 2055:       {
 2056:          // Just returns true and the element (curElem) is unchanged).
 2057:          // This means that the algorithm has found the element that contains the target point.
 2058:          return true;
 2059:       }
 2060:       else { // Outside the element
 2061: 
 2062:          // Outside this element. Pick the first valid exit side and cross.
 2063:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2064:          Element *prevElem = curElem;
 2065:          curElem = lastCrossSide->otherElem(curElem);
 2066: 
 2067:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2068:          // along the boundary.
 2069:          if (curElem == nullptr || curElem->isDry) {
 2070:          
 2071:             curElem = prevElem;
 2072:             return false;
 2073:          }
 2074:          
 2075:       }
 2076: 
 2077:    }
 2078: 
 2079:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2080: }
 2081: 
 2082: 
