 1775:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1776:       // Compute the different time ramps used in the code 
 1777:       // This function is performed by just one thread
 1778: 
 1779:       rampbc = 1.0;
 1780:       if constexpr(ibc == 0) {
 1781:          if (drampbc > 0.0) {
 1782:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1783:          } else {
 1784:             rampbc = 1.0;
 1785:          }
 1786:       }
 1787: 
 1788:       if (nws != 0) {
 1789:          if (drampwind > 0.0) {
 1790:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1791:          } else {
 1792:             rampwind = 1.0;
 1793:          }
 1794:       }
 1795: 
 1796:       if (drampwafo > 0.0) {
 1797:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1798:       } else {
 1799:          rampwafo = 1.0;
 1800:       }
 1801: 
 1802:       // For source/sinks
 1803:       if (if_source && dramp_ss > 0.0) {
 1804:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1805:       } else {
 1806:          ramp_ss = 1.0;
 1807:       }
 1808: 
 1809:       if (dramp > 0.0) {
 1810:          ramp = tanh(2.0*time/86400.0/dramp);
 1811:       } else {
 1812:          ramp = 1.0;
 1813:       }
 1814: 
 1815: 
 1816:    }
