 5240: extern "C" {
 5241: 
 5242:    __global__ void scaleGravity(double loadtide_coef) {
 5243: 
 5244: 
 5245:       NODE(node);
 5246: 
 5247:       // SAL option: scale gravity
 5248:       if constexpr(iloadtide==2) {  // simple const
 5249:          node->grav2 = grav*(1.0 - loadtide_coef);
 5250: 
 5251:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5252:         
 5253:           const double depth = max(node->depth, 0.0);
 5254:           const double tmp1 = sqrt(depth);
 5255:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5256:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5257:                              2.6969e-13*depth*depth*depth*tmp1;
 5258:           
 5259:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5260:           
 5261: 
 5262: 
 5263:           node->grav2 = grav*(1.0 - beta_bar);
 5264: 
 5265:       } else {  // iloadtide=0,1
 5266:           node->grav2 = grav;
 5267: 
 5268:       }
 5269: 
 5270:    }
 5271: 
 5272: 
 5273:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5274:       NODE(node);
 5275: 
 5276:       const int idx = node->idx;
 5277:       Vector2 wind = {xWind[idx], yWind[idx]};
 5278: 
 5279:       if constexpr(nws != 0 && iwindoff != 0) {
 5280:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5281:       }
 5282: 
 5283:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5284:       node->setWind(wind);
 5285: 
 5286:       node->pr = pressAir[idx];
 5287:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5288: 
 5289:    }
