 1031: struct Side {
 1032: 
 1033:    // Geometry information
 1034:    int idx;               // Index of the side
 1035:    Node *n1, *n2;
 1036:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1037: 
 1038:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1039:    Vector2 center;        // Location of side center. 
 1040:    double zc[nvrt];       // Side center z-coord at each vertical level
 1041: 
 1042: #ifdef USE_FRAMES
 1043:    Frame frame;
 1044: #endif
 1045: 
 1046:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1047:                           // this is nullptr
 1048:    
 1049:    int kb;                // Bottom index of the side
 1050:    bool isDry;            // True if the side is dry
 1051:  
 1052:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1053: 
 1054:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1055: 
 1056:    // Physical information
 1057:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1058:    Vector2 btu[nvrt];           // Back-tracked velocity
 1059:    Vector2 U;                   // Vertically averaged velocity vector  
 1060: 
 1061:    Vector2 nuGradU[nvrt];          // nu*grad u
 1062: 
 1063:    Vector2 bcc[nvrt];           // Baroclinic term
 1064:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1065: 
 1066:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1067:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1068:    Vector2 gradPr;               // Gradient of pressure
 1069:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1070: 
 1071: 
 1072:    double hhat;                 // \breve{H} in notes
 1073: 
 1074:    double shapiro;
 1075: 
 1076:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1077: 
 1078:    double coriolis;             // Coriolis parameter
 1079: 
 1080:    // Vegetation parameters
 1081:    double veg_c2;
 1082:    double veg_beta;
 1083: 
 1084:    // Bottom drag parameters.
 1085:    double chi;
 1086:    double chi2;
 1087: 
 1088:    __inline__ __device__ double x(double t) const;
 1089:    __inline__ __device__ double y(double t) const;
 1090:    __inline__ __device__ double lon(void) const;
 1091:    __inline__ __device__ double lat(void) const;
 1092:    __inline__ __device__ Point2 p_t(double t) const;
 1093: 
 1094:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1095:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1096:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1097: 
 1098:    __inline__ __device__ Side* neigh(int index) const { 
 1099:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1100:       assert(index >= 0 && index < 4); 
 1101:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1102: 
 1103:       const int ielem = index & 1;           // 0 or 1
 1104:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1105: 
 1106:       const Element* elem = elems[ielem];
 1107: 
 1108:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1109: 
 1110:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1111: 
 1112:    }
 1113: 
 1114:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1115: 
 1116:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1117: 
 1118:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1119:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1120:    __inline__ __device__ int iadv(void) const;
 1121: 
 1122:    __inline__ __device__ double grav3(void) const;
 1123:    
 1124:    __inline__ __device__ double eta2(void) const;
 1125:    __inline__ __device__ double eta1(void) const;
 1126:    __inline__ __device__ double w2(int k) const;
 1127:    __inline__ __device__ double depth(void) const;
 1128:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1129:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1130: 
 1131:    __inline__ __device__ double dfv(int k) const;
 1132: 
 1133:    __inline__ __device__ double veg_h(void)  const;
 1134:    __inline__ __device__ double veg_nv(void) const;
 1135:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1136:    __inline__ __device__ double veg_alpha3D(int k) const;
 1137:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1138: 
 1139:    __inline__ __device__ double Cd(void) const;
 1140: 
 1141:    __inline__ __device__ Vector2 tau(void) const;
 1142: 
 1143:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1144:    
 1145: 
 1146:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1147:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1148:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1149:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1150:    } 
 1151:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1152:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1153:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1154:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1155: 
 1156:    // Get valid starting element (for backtracking)
 1157:    __inline__ __device__ Element* getStartElement() {
 1158:       return elems[0] ? elems[0] : elems[1];
 1159:    }
 1160: 
 1161:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1162:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1163:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1164: 
 1165:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1166: 
 1167:       // Dot product of the negative velocity vector with the side normal vector
 1168:       const double dot_prod1 = -dot(u, n);
 1169: 
 1170:       // Vector from side center to element 0 centroid
 1171:       const Vector2 v2 = elems[0]->center - center;
 1172: 
 1173:       // Dot product of the vector with the side normal vector
 1174:       const double dot_prod2 = dot(v2, n);
 1175: 
 1176:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1177:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1178: 
 1179:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1180:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1181: 
 1182:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1183: 
 1184:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1185:       else                           return !isDry1 ? elems[1] : elems[0];
 1186: 
 1187:  
 1188:    }
 1189: 
 1190:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1191:       // Given an element, returns the other element that shares this side
 1192:       return (elems[0] == elem) ? elems[1] : elems[0];
 1193:    }
 1194: 
 1195:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1196:       // Given a node, returns the other node that shares this side
 1197:       return (n1 == node) ? n2 : n1;
 1198:    }
 1199:  
 1200:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1201: 
 1202: 
 1203: 
 1204: 
 1205: };
 1206: 
