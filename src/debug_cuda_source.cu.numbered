 4360: 
 4361: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4362:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4363:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4364: 
 4365: 
 4366:    NODE(node1);
 4367: 
 4368:    node1->clearMatrixRow();
 4369:    node1->qel = 0.0;
 4370: 
 4371:    // THIS IS FOR STRUCTURES XXX
 4372:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4373: 
 4374:    
 4375:    for (int j=0; j<node1->numElements; j++) {
 4376:       // For each element connected to the node...
 4377: 
 4378:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4379: 
 4380:       Element *elem = node1->elements[j];
 4381: 
 4382:       // Compute the average gravity
 4383:       const double grav3 = elem->mean(&Node::grav2);
 4384: 
 4385:       // Look at the documentation for the description of the terms in the following integrals
 4386: 
 4387:       // Integral I_1 
 4388:       // \bar{\breve{H}} 
 4389:       const double hhatb = elem->mean(&Side::hhat);        
 4390: 
 4391:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4392: 
 4393:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4394:       const double area = elem->area;
 4395: 
 4396:       // Integral I_4
 4397:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4398:       // Where
 4399:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4400: 
 4401:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4402:       // of U over the element.
 4403:       const Vector2 U = elem->mean(&Side::U);
 4404: 
 4405:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4406: 
 4407:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4408:       const double I_4_1 = dot(gradPhi_1, U);
 4409: 
 4410: 
 4411:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4412:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4413: 
 4414:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4415: 
 4416: 
 4417:       // Normal component of the bed velocity
 4418:       double ubedNormalComp = 0.0;
 4419:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4420:          Vector3 ubed = {0.0, 0.0, 0.0};
 4421:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4422:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4423: 
 4424:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4425:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4426:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4427: 
 4428:          // Computes the normal component of the bed velocity
 4429:          ubedNormalComp = dot(ubed, N);
 4430:       } // imm==2
 4431: 
 4432:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4433: 
 4434:       if (elem->isTri()) {
 4435: 
 4436:          // To clarify the notation in this section: 
 4437:          //   In formulas, we use the following notation:
 4438:          //       i stands for the node under consideration (node1)
 4439:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4440:          //   However, in the code, we use the following notation:
 4441:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4442:          const int id2 = elem->nxq(1 + id1);
 4443:          const int id3 = elem->nxq(2 + id1);
 4444:          Node *node2 = elem->nodes[id2];
 4445:          Node *node3 = elem->nodes[id3];
 4446: 
 4447:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4448: 
 4449:          // integral of phi_i*phi_j
 4450:          const double ipp_ii = (1.0/6.0 )*area;
 4451:          const double ipp_ij = (1.0/12.0)*area;
 4452:          const double ipp_ik = (1.0/12.0)*area;
 4453: 
 4454:          // integral of [(grad phi_i) * (grad phi_j)]
 4455:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4456:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4457:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4458: 
 4459:          // Computes the different components of integral I_1 of each node with respect to node i.
 4460:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4461:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4462:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4463: 
 4464:          node1->addToSparseMatrix(node1, I1_ii);
 4465:          node1->addToSparseMatrix(node2, I1_ij); 
 4466:          node1->addToSparseMatrix(node3, I1_ik);
 4467: 
 4468:          #pragma unroll
 4469:          for (int l=0; l<3; l++) {
 4470: 
 4471:             Node *node = elem->nodes[l];
 4472: 
 4473:             // Additional variation in eta due to bed deformation or vertical velocity
 4474:             double extraEta = 0.0;
 4475:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4476:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4477: 
 4478: 
 4479:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4480:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4481: 
 4482:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4483: 
 4484:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4485:            
 4486:          }
 4487: 
 4488: 
 4489:       }
 4490:       else { // Quad
 4491:          // To clarify the notation in this section: 
 4492:          //   In formulas, we use the following notation:
 4493:          //       i stands for the node under consideration (node1)
 4494:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4495:          //   However, in the code, we use the following notation:
 4496:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4497:          const int id2 = elem->nxq(1 + id1);
 4498:          const int id3 = elem->nxq(2 + id1);
 4499:          const int id4 = elem->nxq(3 + id1);
 4500:          Node *node2 = elem->nodes[id2];
 4501:          Node *node3 = elem->nodes[id3];
 4502:          Node *node4 = elem->nodes[id4];   
 4503:          
 4504:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4505: 
 4506:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4507:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4508:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4509:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4510:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4511: 
 4512:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4513:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4514:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4515:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4516:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4517: 
 4518: 
 4519:          // Computes the different components of integral I_1 of each node with respect to node i.
 4520:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4521:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4522:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4523:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4524: 
 4525:          node1->addToSparseMatrix(node1, I1_ii);
 4526:          node1->addToSparseMatrix(node2, I1_ij); 
 4527:          node1->addToSparseMatrix(node3, I1_ik);
 4528:          node1->addToSparseMatrix(node4, I1_il);
 4529:   
 4530:          #pragma unroll
 4531:          for (int l=0; l<4; l++) {
 4532: 
 4533:             const Node *node = elem->nodes[l];
 4534: 
 4535:             // Additional variation in eta due to bed deformation or vertical velocity
 4536:             double extraEta = 0.0;
 4537:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4538:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4539: 
 4540:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4541:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4542:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4543: 
 4544:          }         
 4545:       } 
 4546: 
 4547: 
 4548:      node1->qel += (dt/elem->i34)*elem->vsource;
 4549:       
 4550: 
 4551:    } // for all elements connected to the node
 4552:    
 4553: 
 4554:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4555:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4556:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4557:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4558:    // If it is an open boundary node...
 4559: 
 4560:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 4561: 
 4562:       // At least one open bnd side, maybe two
 4563:       for (int l=0; l<2; l++) { 
 4564: 
 4565:          // Gets each of the sides sharing the node. 
 4566:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4567: 
 4568:     
 4569: 
 4570:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4571:          if (sideBnd != nullptr) {
 4572:             // If the side is on a boundary...
 4573: 
 4574:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4575: 
 4576:             // Get the boundary segment
 4577:             const BoundarySegment *sideSegment = sideBnd->segment;
 4578:             const Side *side = sideBnd->side;
 4579: 
 4580:             // Integral I_3
 4581:             if (sideSegment->ifltype != 0) {
 4582:             // Natural or Flather b.c.
 4583: 
 4584:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4585:                // especially for Flather b.c.
 4586:                double ri3 = 0.0;
 4587:                if (!side->isDry) {
 4588:                   // If the side is not dry
 4589:                   
 4590:                   // Computes the side flux of (uth, vth)
 4591:                   double Vn = 0.0;
 4592:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4593:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4594:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4595: 
 4596:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4597:                   }
 4598: 
 4599:                   ri3 = 0.5*side->len*Vn;
 4600:                }
 4601: 
 4602:                if (sideSegment->ifltype == -1) { // Flather 1
 4603: 
 4604:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4605:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4606: 
 4607:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4608:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4609:                   
 4610:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4611:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4612: 
 4613:                } 
 4614:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4615:                   // Reset ri3
 4616:                   ri3 = 0.0;
 4617: 
 4618:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4619:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4620: 
 4621:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4622: 
 4623:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4624:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4625: 
 4626:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4627:                   node1->addToSparseMatrix(node1, con0*2.0);
 4628:                   node1->addToSparseMatrix(node2, con0);
 4629: 
 4630:                } // if Flather or Discharge
 4631: 
 4632:                node1->qel -= thetai*dt*ri3;  
 4633: 
 4634: 
 4635:             } // I_3
 4636:           
 4637: 
 4638:             // Integral I_5
 4639:             if(!side->isDry) {
 4640: 
 4641:                const double Unbar = dot(side->U, side->n);
 4642:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4643: 
 4644:             } // I_5
 4645: 
 4646:          } // if is boundary side
 4647: 
 4648:       } // for l
 4649: 
 4650:    } // if isbnd
 4651: 
 4652: 
 4653: }
 4654: 
 4655: 
 4656: 
 4657: extern "C" {
 4658:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4659:                                   int* indices, int* indptr) {
 4660: 
 4661:       NODE(node);
 4662:       
 4663:       const int idx = node->idx;
 4664:       
 4665:       // Computes the index in the nzz array      
 4666:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4667: 
 4668: 
 4669:       indptr[idx] = nzzIdx;
 4670:       indices[nzzIdx] = idx;
 4671: 
 4672:       data_d[nzzIdx]    = node->coeffDiag;
 4673: 
 4674:       b_d[idx] = node->qel;
 4675: 
 4676:       for (int k = 0; k < node->numNodes; ++k) {
 4677:          const Node* nb = node->nodes[k];
 4678: 
 4679:          const int j = nb->idx;
 4680: 
 4681:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4682: 
 4683:          indices[nzzIdx + k + 1] = j;
 4684:       }
 4685: 
 4686:  
 4687:    }
 4688: 
 4689: 
 4690: 
 4691:    __global__ void solverCopyResult(double* x) {
 4692:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4693:       NODE(node);
 4694:       const int idx = node->idx;
 4695: 
 4696:       node->mX = x[idx];
 4697:    }
 4698: 
 4699: 
 4700:    __global__ void rollUpElevation(void) {
 4701: 
 4702:       NODE(node);
 4703: 
 4704:       node->eta1 = node->eta2;
 4705: 
 4706:    }
 4707: 
 4708: 
 4709:    __global__ void backtrackAllNodes(void) {
 4710: 
 4711:       // max/min # of sub-divisions
 4712:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4713:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4714: 
 4715:       SIDE(side);
 4716: 
 4717:       const int kb = side->kb;
 4718: 
 4719: 
 4720:       // Initialize btrack velocities to the actual velocities at the side 
 4721:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4722:   
 4723:       if (side->isDry) return;
 4724:      
 4725: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4726: 
 4727:       // Checks that at least one element is not dry
 4728:       const Element *elem1 = side->elems[0];
 4729:       const Element *elem2 = side->elems[1];
 4730: 
 4731: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4732: 
 4733:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4734:       
 4735:       // XXXXXX
 4736:       // !swild_tmp to store global coord. of the starting side
 4737:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4738:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4739:       // !Use sframe2 
 4740:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4741: 
 4742: 
 4743:       for (int k = kb; k < nvrt; k++) {
 4744:       //  For ics=2, the coordinates are all in the side's local frame
 4745: 
 4746:          const int iadvf = side->iadv();  // Advection flag   
 4747:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4748: 
 4749:          const double vmag2 = norm2(side->u2[k]);
 4750: 
 4751:          if (vmag2 <= velmin_btrack_sq) {  
 4752:             // No activity 
 4753: 
 4754:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4755:             
 4756:          } else {  // do btrack
 4757: 
 4758:             // Compute number of sub-divisions based on local gradients of the velocity field
 4759: 
 4760:             // XXX IS THIS NECESSARY?
 4761:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4762:             double suma = 0.0;
 4763:             int icount = 0;
 4764:             #pragma unroll
 4765:             for (int l=0; l<2; l++) {
 4766:             // For each element sharing the side...
 4767: 
 4768:                const Element *elem = side->elems[l];
 4769:                  
 4770:                if (elem == nullptr) continue;
 4771: 
 4772:                icount++;
 4773: 
 4774:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4775:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4776:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4777: 
 4778:                double utmp[4];
 4779:                double vtmp[4];
 4780:                #pragma unroll
 4781:                for (int j = 0; j < elem->i34; j++) {
 4782: 
 4783:                   const Node *node = elem->nodes[j];
 4784: 
 4785:                   if constexpr(ics==1) {
 4786:                      utmp[j] = node->u2[k].x;
 4787:                      vtmp[j] = node->u2[k].y;  
 4788: 
 4789:                   } else {
 4790:                      // 'Project' the velocity from the node frame to the element frame
 4791:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4792:                      utmp[j] = tmp_u2.x;
 4793:                      vtmp[j] = tmp_u2.y;
 4794: 
 4795:                   }
 4796:                } // for j
 4797: 
 4798:                const Vector2 grad_u = elem->grad2(utmp); 
 4799:                const Vector2 grad_v = elem->grad2(vtmp);
 4800:    
 4801:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4802:             } // for l
 4803: 
 4804:             assert(icount > 0 && "Impossible 77");
 4805: 
 4806:             // '4' is somewhat arbitrary
 4807:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4808: 
 4809:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4810:             Vector3 u_int = {0.0, 0.0, 0.0};
 4811: 
 4812:             side->btrack(k, dt, dtbk, u_int);
 4813: 
 4814: 
 4815:             side->btu[k] = {u_int.x, u_int.y};
 4816:                
 4817:          } // if vmag (do backtrack)
 4818: 
 4819: 
 4820:       } // for k=kb,nvrt-1
 4821: 
 4822:    }
 4823: 
 4824: } // extern "C"
 4825: 
 4826: template<int nc>
 4827: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4828: 
 4829: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4830: //
 4831: // a,b,c,rhs: input vectors and are not modified by this program.
 4832: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4833: // rhs is the r.h.s.
 4834: // n: actual rank of the system.
 4835: // rows in u() and rhs();
 4836: // u: output with nc columns (transposed to rows)
 4837: // gam: a working array.
 4838: //
 4839: // NOTES:
 4840: // This is a template function that allows for different numbers of columns in the rhs vector.
 4841: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4842: 
 4843:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4844:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4845: 
 4846:    double bet = b[0];
 4847:    if constexpr (nc == 1) {
 4848:       u[0] = rhs[0]/bet;
 4849:    } else {
 4850:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4851:    }
 4852: 
 4853:    for (int j = 1; j < n; j++) {
 4854:       gam[j] = c[j - 1]/bet;
 4855:       bet = b[j] - a[j]*gam[j];
 4856: 
 4857:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4858: 
 4859:       if constexpr (nc == 1) {
 4860:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4861:       } else {
 4862:          for (int l = 0; l < nc; l++) {
 4863:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4864:          }
 4865:       }
 4866:    }
 4867: 
 4868:    // Back-substitution
 4869:    for (int j = n - 2; j >= 0; j--) {
 4870:       if constexpr (nc == 1) {
 4871:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4872:       } else {
 4873:          for (int l = 0; l < nc; l++) {
 4874:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4875:          }
 4876:       }
 4877:    }
 4878: }
 4879: 
 4880: 
 4881: 
 4882: // Helper function that contains the core algorithm
 4883: template<typename XAccessor, typename YAccessor>
 4884: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4885:                                     double  yp_top, double  yp_bot, 
 4886:                                     CubicSpline &spline) {
 4887:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4888:    // 
 4889:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4890:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4891:    //
 4892:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4893:    // 
 4894:    // Inputs: 
 4895:    //            n: dimension for x etc; # of data pts (>=2);
 4896:    //            getX, getY: functions to access x,y coordinates
 4897:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4898:    //     Output: 
 4899:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4900: 
 4901:    const int n = k2 - k1 + 1;
 4902:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4903: 
 4904:    // Allocate memory for the splines
 4905:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4906:    spline.x   = new double[n];
 4907:    spline.y   = new double[n];
 4908:    spline.yp  = new double[n];
 4909:    spline.ypp = new double[n];
 4910: 
 4911:    for (int k=k1; k<=k2; k++) {
 4912:       spline.x[k] = getX(k);
 4913:       spline.y[k] = getY(k);
 4914:    }
 4915: 
 4916:    // This is to simplify expressions later
 4917:    double *x = spline.x;
 4918:    double *y = spline.y;
 4919: 
 4920:    double *a = nullptr;
 4921:    double *b = nullptr;
 4922:    double *c = nullptr;
 4923:    double *gam = nullptr;
 4924:    double *rhs = nullptr;
 4925:    
 4926: 
 4927:       a = new double[n];   // Lower diagonal
 4928:       b = new double[n];   // Diagonal
 4929:       c = new double[n];   // Upper diagonal
 4930:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4931:       rhs = new double[n]; // Right-hand side
 4932: 
 4933:    for (int k=k1; k<=k2; k++) {
 4934:       if (k == k1) {
 4935:          // Bottom level
 4936:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4937:          b[k] = (x[k+1] - x[k])/3.0;
 4938:          c[k] = b[k]/2.0;
 4939:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4940:       } else if (k == n - 1) {
 4941:          // Top level (surface)
 4942:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4943:          b[k] = (x[k] - x[k-1])/3.0;
 4944:          a[k] = b[k]/2.0;
 4945:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4946:       } else {
 4947:          // Intermediate levels
 4948:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4949:          b[k] = (x[k+1] - x[k-1])/3.0;
 4950:          a[k] = (x[k  ] - x[k-1])/6.0;
 4951:          c[k] = (x[k+1] - x[k  ])/6.0;
 4952:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4953:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4954:       }
 4955:    }
 4956: 
 4957:    // Solve the tridiagonal system
 4958:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4959:    
 4960:    spline.yp[k1] = yp_bot;
 4961:    spline.yp[k2] = yp_top;
 4962: 
 4963:    // Compute rest of 1st derivatives using the splines
 4964:    for (int k=k1+1; k<k2; k++) {
 4965:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4966:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4967:    }
 4968:    
 4969:    delete[] a;
 4970:    delete[] b;
 4971:    delete[] c;
 4972:    delete[] gam;
 4973:    delete[] rhs;
 4974: 
 4975: }
 4976: 
 4977: // Array version
 4978: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4979:                                 double y_top, double y_bot, 
 4980:                                 CubicSpline &spline) {
 4981:    auto getX = [x] (int k) { return x[k]; };
 4982:    auto getY = [y] (int k) { return y[k]; };
 4983:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4984: }
 4985: 
 4986: // Lambda version - allows custom access patterns
 4987: template<typename XFunc, typename YFunc>
 4988: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4989:                                 double y_top, double y_bot,
 4990:                                 CubicSpline &spline) {
 4991:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4992: }
 4993: 
 4994: 
 4995: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4996: {
 4997:    assert("Not implemented");
 4998: 
 4999:    return 0.0;
 5000: }
