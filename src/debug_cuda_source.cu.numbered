 8107: extern "C" __global__ void populateElements(int *i34, int *elnode, int *elside,
 8108:    double *node_coords, double *node_coords_ll, bool use_ll,
 8109:    double *wind_rotate_angle,   
 8110:    int *isdel, int *isidenode, int *isbnd,
