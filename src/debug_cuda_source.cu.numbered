 7258: #ifdef DONTCOMPILE
 7259: __device__ void computeVerticalAdvection(void) {
 7260:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7261: 
 7262:    sdbt(1:2,:,:)=0.d0
 7263: 
 7264:    const Side *side = FROM kernel;
 7265: 
 7266:    if(side->isDry) return;
 7267: 
 7268:    // If side is wet...
 7269: 
 7270: 
 7271:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7272:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7273:    double ws[nvrt] = {} // w @ side
 7274:    int icount = 0;
 7275:    for (int j=0; j<2; j++) {
 7276:       const Element *elem = side->elements[j];
 7277:        
 7278:       if(elem != nullptr) {
 7279:          icount++;
 7280:          for (int k=0; k<nvrt; k++) {
 7281:             ws[k] = ws[k] + elem->w[k];
 7282:          }
 7283:       }
 7284:    }  // for j
 7285: 
 7286:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7287:    ws = ws/icount;
 7288: 
 7289:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7290:    // Splines allow for a smooth transition between vertical levels.
 7291:    // Splines have continuity restrictions at the internal knots, but
 7292:    // we have to provide the 1st derivatives at the endpoints.
 7293:    const int kbs = side->kbs; 
 7294:    
 7295:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7296:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7297:    initCubicSpline(kbs, nvrt, side, ws, up)
 7298: 
 7299:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7300:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7301:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7302: 
 7303:    // Total advection (average onto side)
 7304:    const Node *node1 = side->nodes[0];
 7305:    const Node *node2 = side->nodes[1];
 7306:    for (int k=kbs(i); k<nvrt; k++) {
 7307: 
 7308:       Vector2 bcc1 = node1->bcc[k];
 7309:       Vector2 bcc2 = node2->bcc[k];
 7310:       if constexpr(ics == 2) {
 7311:          // Project the velocities from the node frames to the side frame
 7312:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7313:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7314:       }
 7315: 
 7316:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7317:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7318: 
 7319:    }
 7320: }
 7321: #endif
 7322: 
 7323: 
 7324: extern "C" {
 7325:    __global__ void computeElemAverageGhat(void) {
 7326:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7327: 
 7328:       ELEM(elem);
 7329:       
 7330:       elem->ghat1= {0.0, 0.0};  
 7331: 
 7332:       if constexpr(ihydraulics != 0) {
 7333:          if (nhtblocks > 0 && elem->isblock) return;
 7334:       }
 7335: 
 7336:       
 7337:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7338:       // cff1-3: coefficients for 2D/3D
 7339: 
 7340:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7341:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7342:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7343: 
 7344:       if (elem->isDry) return;
 7345: 
 7346:       // Average of the coefficients
 7347:       double av_cff1 = 0.0;  // av. for cff1
 7348:       double av_cff2 = 0.0;  // av. for cff2
 7349:       double av_cff3 = 0.0;  // av. for cff3
 7350:       double av_df = 0.0;  // av. for H^\alpha / H
 7351:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7352:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7353: 
 7354:       const int i34 = elem->i34;
 7355:       const int kb  = elem->kb;
 7356: 
 7357:       for (int j=0; j<i34; j++) {
 7358:          // For each node and side in the element...
 7359: 
 7360:          const Node *node = elem->nodes[j];
 7361:          const Side *side = elem->sides[j];
 7362: 
 7363:          const double chi      = side->chi;
 7364:          const double veg_c2   = side->veg_c2;
 7365:          const double veg_beta = side->veg_beta;
 7366:          const double veg_h    = side->veg_h();
 7367:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7368: 
 7369:          const Vector2 gradPhi = elem->gradPhi[j];
 7370: 
 7371:          // Node - const in elem
 7372:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7373:          elem->gradPr  += node->pr  *gradPhi;
 7374: 
 7375:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7376: 
 7377:         
 7378:          const double htot  = side->htot2();        // Total depth at the side
 7379:          const double zctr2 = side->zTopCanopy();  
 7380: 
 7381:          double cff1; 
 7382:          double cff2; 
 7383:          double cff3;   
 7384:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7385:          // coefficients applied to 2D/3D case 
 7386:             cff1 = side->hhat/htot;
 7387:             cff2 = 0.0;
 7388:             cff3 = 0.0;
 7389:          } else { //3D
 7390:             //Init for no-veg case
 7391:             cff1 = 1.0;
 7392:             cff2 = 1.0;
 7393:             cff3 = 0.0;
 7394: 
 7395:             if constexpr(iveg != 0) {
 7396:                // Computes coefficients used with vegetation terms G1, G2
 7397:                // cff1, cff3 are used for the first two terms in G1, G2:
 7398:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7399:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7400:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7401:                if(veg_h < 0.99*htot) { // submergent vegetation
 7402:                   cff1 = 1.0;
 7403:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7404:                   cff3 = veg_c;
 7405: 
 7406:                } else { // emergent vegetation
 7407:                   cff1 = 1.0/(1.0 + veg_c2);
 7408:                   cff2 = cff1;
 7409:                   cff3 = 0.0;
 7410: 
 7411:                }
 7412:             } // if iveg
 7413:          } //  2D/3D
 7414: 
 7415:          av_cff1 += cff1/i34;
 7416:          av_cff2 += cff2/i34;
 7417:          av_cff3 += cff3/i34;
 7418:          av_cff2_chi += cff2*chi/i34;
 7419:          av_cff3_chi += cff3*chi/i34;
 7420:          av_df += min(htot, veg_h)/(htot*i34);
 7421: 
 7422: 
 7423:          // btrack values: U^\star, U^{\star\alpha}
 7424:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7425:          Vector2 Ustar       = {0.0, 0.0}; 
 7426:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7427: 
 7428:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7429:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7430:          } else { //3D
 7431:             for (int k = side->kb + 1; k < nvrt; k++) {
 7432:             
 7433:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7434:                Ustar += w2;
 7435: 
 7436:                if constexpr(iveg != 0) {
 7437:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7438:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7439:                        Ustar_alpha += zrat*w2; // XXXX
 7440:                    }
 7441:                }  // if iveg
 7442:             }  // for k
 7443:          }  //2D/3D
 7444: 
 7445:          // If needed, project the side velocities to the element frame
 7446:          if constexpr(ics==2) {
 7447:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7448:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7449:          }
 7450:         
 7451: 
 7452:          // Add btrack & surface stress terms to \breve{G} first
 7453:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7454: 
 7455: 
 7456:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7457:          Vector2 tau    = side->tau();  
 7458:          Vector2 ubstar = side->btu[side->kb + 1];  
 7459: 
 7460:          // If needed, project tau and ubstar to the element frame
 7461:          if constexpr(ics==2) {
 7462:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7463:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7464:          }
 7465: 
 7466:          // Term for surface and bottom stress
 7467:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7468: 
 7469: 
 7470:          // All terms in F,F^\alpha,f_b except baroclinic
 7471:          // F, f_b: all explicit terms excluding vegetation 
 7472:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7473:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7474:          const double coriolis = side->coriolis;
 7475:          Vector2 F  =  coriolis*side->U;  // F_x
 7476:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7477:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7478: 
 7479:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7480:             
 7481:             for (int k = side->kb; k < nvrt; k++) {
 7482:                if (zctr2 > side->zc[k-1]) {
 7483:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7484:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7485:                    Fa +=  coriolis*w2*zrat;
 7486:                } // if zctr2
 7487:             } // k
 7488:          } // iveg
 7489: 
 7490:          // Integrate horizontal viscosity force vertically
 7491:          for (int k=side->kb + 1; k<nvrt; k++) {
 7492:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7493: 
 7494:             F += levelHorVisc;
 7495: 
 7496:             // Vegetation term
 7497:             if constexpr(iveg!=0) {
 7498:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7499:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7500:                   Fa += levelHorVisc*zrat;
 7501:                } 
 7502:             } // if iveg
 7503:          } // for k
 7504: 
 7505:          // Get nu*grad(U) at the side's bottom level
 7506:          Vector2 nuGradU = side->nuGradU[side->kb];
 7507: 
 7508:          fb += nuGradU;
 7509: 
 7510:          // If needed, project vectorsF, fb and Fa to the element frame
 7511:          if constexpr(ics==2) {
 7512:             F    = side->frame.projHorVec(F,    elem->frame);
 7513:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7514:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7515:          } // if ics
 7516: 
 7517:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7518:       } // for j (nodes and sides)
 7519: 
 7520:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7521: 
 7522: 
 7523:       // Finish off terms in F, F^\alpha and f_b
 7524:       const double grav3 = elem->mean(&Node::grav2);
 7525:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7526:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7527:       for (int j=0; j<i34; j++) { 
 7528:          // For each side in the element...
 7529:          const Side *side = elem->sides[j];
 7530:          const double chi = side->chi;
 7531: 
 7532:          const double htot = side->htot2();
 7533:          const double veg_h = side->veg_h();
 7534:          const Vector2 F  = htot*fb;
 7535:          const Vector2 Fa = min(htot, veg_h)*fb;
 7536: 
 7537:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7538:       } // for j
 7539: 
 7540:       // tmp is already in elem frame
 7541:       elem->ghat1 += tmp/i34;
 7542: 
 7543:       // Baroclinic force
 7544:       if constexpr(ibc==0) {
 7545:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7546: 
 7547:          Vector2 Fa = {0.0, 0.0};
 7548:          Vector2 intGradRho = {0.0, 0.0};
 7549:          
 7550:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7551:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7552:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7553: 
 7554:             // \in F [m^2/s/s]
 7555:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7556:          }
 7557: 
 7558:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7559:          const Vector2 F = av_df*Fa; //approx
 7560:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7561: 
 7562:       } // if ibc
 7563: 
 7564: 
 7565: 
 7566:    }
 7567: 
 7568: } // extern "C"
 7569: 
 7570: 
 7571: 
 7572: #ifdef DONTCOMPILE
 7573: __global__ void checkMassConservation(Tracers* sumtr) {
 7574: 
 7575:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7576: 
 7577:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7578: 
 7579:    Element *elem = &(mesh->localElemData[i]);
 7580: 
 7581:    // Skip dry elements
 7582:    if (elem->isDry) return;
 7583: 
 7584:    // Local sum array for this thread
 7585:    double localSum[N_TRACERS] = {0.0};
 7586: 
 7587:    // Sum over vertical levels for this element
 7588:    const int kbe = elem->kbe;
 7589:    const double area = elem->area;
 7590: 
 7591:    for (int k = kbe; k < nvrt; k++) {
 7592:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7593:       
 7594:       // Accumulate tracer mass
 7595:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7596:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7597:       }
 7598:    }
 7599: 
 7600:    //  This function returns per element sums. A reduction must be done on the host side.
 7601: }
 7602: 
 7603: 
 7604: __global__ void transport(void) {
 7605: 
 7606:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7607: 
 7608:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7609: 
 7610:    Element *elem = &(mesh->localElemData[ie]);
 7611: 
 7612:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7613: 
 7614:                for (int m=0; m<ntr; m++) {
 7615:                   for (int k=kbe(ie); k<nvrt; k++) {
 7616:                      // Calculate each polynomial's weight 
 7617:                      wm=0.d0; sum1=0.d0; 
 7618:                      wm1=0.d0; wm2=0.d0; 
 7619:                      for (int i=0; i<elem->nweno2; i++) {
 7620:                   
 7621:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7622:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7623:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7624:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7625:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7626:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7627:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7628:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7629:                      // -----------------Hu and Shu (1999)'s method----------------
 7630:                      b4=b1+b2+b3
 7631: 
 7632: //Error: add PRODUCTION CPP
 7633: #ifdef DEBUG
 7634:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7635:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7636:                     call parallel_abort(errmsg)
 7637:                   }
 7638: #endif
 7639: 
 7640:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7641:                   // !----test-------------- 
 7642:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7643:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7644:                   // !wm(i)=wm1(i)*wm2(i)
 7645:                   // !---------------------- 
 7646:                   sum1=sum1+wm(i)
 7647:                 } // end for i
 7648: 
 7649:                 wm=wm/sum1
 7650: 
 7651:                 for (int j=0; j<elem->i34; j++) {
 7652: 
 7653:                   const Side *side  = elem->sides[j];
 7654:                   const Node *node1 = side->n1;
 7655:                   const Node *node2 = side->n2;
 7656: 
 7657:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7658:                      trsd=0.d0
 7659:                      for (int kk=0; kk<nquad; kk++) {
 7660:                         for (int i=0; i<elem->nweno2; i++) {
 7661:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7662:                         } // end for i   
 7663:                      } // end for kk
 7664:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7665:                   } // outward flux
 7666:                } // end for j=1,i34(ie) ! side
 7667:             }
 7668:          }
 7669:               
 7670: 
 7671: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7672: //             //   calculate each polynomial's weight 
 7673: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7674: //                 wm=0.d0; sum1=0.d0
 7675: //                 do i=1,nweno1(ie) !for each polynomial
 7676: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7677: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7678: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7679: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7680: //                   wm(i)=b2
 7681: //                   sum1=sum1+b2
 7682: //                   !wm(i)=1.d0
 7683: //                   !sum1=sum1+1.d0
 7684: 
 7685: // // Error: PRODUCTION
 7686: // #ifdef DEBUG
 7687: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7688: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7689: //                     call parallel_abort(errmsg)
 7690: //                   endif
 7691: // #endif
 7692: 
 7693: //                 enddo !i
 7694: //                 wm=wm/sum1 !final weight
 7695: 
 7696:                 for (int j=0; j<elem->i34; j++) { // side
 7697:                   const Side *side = elem->sides[j];
 7698:                   const Node *node1 = side->n1;
 7699:                   const Node *node2 = side->n2;
 7700: 
 7701:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7702:                     trsd=0.d0
 7703:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7704:                       for (int i=0; i<elem->nweno1; i++) {
 7705:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7706:                       }
 7707:                     enddo //kk
 7708:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7709:                   } // outward flux
 7710:                 } // end for j=1,i34(ie) ! side
 7711:               } // end for k; ntr 
 7712: 
 7713:             else !simple upwind method
 7714:               do j=1,i34(ie)
 7715:                 jsj=elside(j,ie)
 7716:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7717:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7718:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7719:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7720:                   endif
 7721:                 enddo  !vertical layers
 7722:               enddo !j=1,i34(ie) ! side
 7723:             endif !order of accuracy
 7724: 
 7725:          //  enddo !ie
 7726: // !$OMP     end do
 7727: 
 7728: // !$OMP     master
 7729: //           !message passing
 7730: //           if (nproc>1) then
 7731: //             !make a copy of side concentrations
 7732: //             trsd_tmp0=trsd_tmp 
 7733: 
 7734: //             !this exchange routine swaps interface concentration between two partitions
 7735: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7736: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7737: 
 7738: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7739: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7740: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7741: 
 7742: 
 7743: //             !This obtains final values for interface sides
 7744: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7745: //       :    endif !nproc>1
 7746: //           !message passing end
 7747: // !$OMP     end master
 7748: // !$OMP     barrier
 7749: 
 7750: 
 7751: // !         Do advection; conc @ dry elem will not be changed
 7752: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7753: // !$OMP     do reduction(+: h_mass_in)
 7754: //           do i=1,ne
 7755: //             if(idry_e(i)==1) cycle
 7756: 
 7757: 
 7758: // !           Wet elements with 3 wet nodes
 7759: //             do k=kbe(i)+1,nvrt
 7760: 
 7761: 
 7762: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7763: //               dtb_by_bigv = dtb/bigv
 7764:     
 7765: // !             Advective flux
 7766: //               if (ntd_weno==1 .or. itd_weno==1) then
 7767: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7768: //               else
 7769: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7770: //               endif
 7771: 
 7772: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7773: //               do j=1,i34(i)
 7774: //                 jsj=elside(j,i) !side
 7775: //                 iweno=.true. !use weno reconstruction as default
 7776: //                 iel=ic3(j,i) !neighboring elem
 7777: 
 7778: //                 if(iel/=0) then
 7779: //                   if(idry_e(iel)==1) cycle
 7780: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7781: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7782: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7783: //                     iweno=.false.
 7784: //                   endif
 7785: //                 else !land or open bnd side
 7786: //                   !skip land bnd and outflowing open bnd, 
 7787: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7788: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7789: //                     !For outflow open bnd side, estimate mass in (open
 7790: //                     !side cannot be interface side)
 7791: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7792: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7793: //                     endif
 7794: 
 7795: //                     cycle
 7796: //                   endif
 7797: 
 7798: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7799: //                   iweno=.false.  !reset to upwind
 7800: //                   ibnd=isbs(jsj) !global bnd #
 7801: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7802: //                   nwild(1:2)=0
 7803: //                   do ll=1,2 !nodes
 7804: //                     ndo=isidenode(ll,jsj)
 7805: //                     do lll=1,2 !2 possible bnds
 7806: //                       if(isbnd(lll,ndo)==ibnd) then
 7807: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7808: //                         exit
 7809: //                       endif
 7810: //                     enddo !lll
 7811: //                   enddo !ll
 7812: //                   ind1=nwild(1); ind2=nwild(2);
 7813: 
 7814: //                   do jj=1,natrm
 7815: //                     if(ntrs(jj)<=0) cycle
 7816: 
 7817: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7818: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7819: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7820: //                       enddo !ll
 7821: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7822: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7823: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7824: //                       enddo !ll
 7825: //                     else if(itrtype(jj,ibnd)==3) then
 7826: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7827: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7828: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7829: //                       enddo !ll
 7830: //                     else if(itrtype(jj,ibnd)==4) then
 7831: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7832: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7833: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7834: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7835: //                       enddo !ll
 7836: //                     else
 7837: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7838: //   !'
