 2616: 
 2617: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2618: 
 2619: 
 2620: __device__ void Node::updateKb(void) {
 2621: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2622: 
 2623:    if constexpr(ivcor == 1) return;
 2624: 
 2625:    if (isDry2()) return;
 2626: 
 2627:    if constexpr(ivcor == 2) {  // SZ coordinates
 2628:       
 2629:       // Compute bottom level index
 2630:       if (depth <= mesh->h_s) {
 2631:          kb = nzlev;
 2632:       } else {
 2633:          kb = -1;
 2634:          int L = 0;
 2635:          int R = nzlev; 
 2636:          
 2637:          while (L <= R) {
 2638:             int M = (R + L) / 2;
 2639: 
 2640: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2641:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2642:             
 2643:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2644:                R = M;
 2645:             } else {
 2646:                L = M;
 2647:             }
 2648: 
 2649:             if (R - L == 1) {
 2650:                kb = L;
 2651:                break;
 2652:             }
 2653:          }
 2654:       }
 2655:    } 
 2656: }
 2657: 
 2658: 
 2659: __device__ __inline__ void Node::updateZCoordData(void) {
 2660: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2661: 
 2662:    if (isDry2()) return;
 2663: 
 2664:    if constexpr(ivcor == 2) {  // SZ coordinates
 2665:       
 2666:       // Compute bottom level index
 2667:       if (depth <= mesh->h_s) {
 2668:             kb = nzlev - 1;
 2669:       } else {
 2670:          kb = -1;
 2671:          for (int i = 0; i < nzlev; i++) {
 2672:             // XXX Use binary search
 2673:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2674:                kb = i;
 2675:                break;
 2676:             }
 2677:          }
 2678:       }
 2679:    } 
 2680:    else if (ivcor == 1) {  // Localized sigma
 2681:       // Do nothing
 2682:    }
 2683: 
 2684: }
 2685: 
 2686: __device__ double Node::compZCoord(int k) const {
 2687:    // Computes the z coordinate at level k.
 2688:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2689:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2690:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2691:    // used 
 2692:    
 2693:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2694: 
 2695:   
 2696:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2697: 
 2698:    if constexpr(ivcor == 2) {
 2699: 
 2700:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2701:       const double h_c = mesh->h_c;
 2702:       const double theta_f = mesh->theta_f;
 2703:       const double sinh_theta_f = mesh->sinh_theta_f;
 2704: 
 2705:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2706:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2707:       // once per time step/node.
 2708:       // CHECK: updateZCoordData
 2709: 
 2710:       //  To simplify comparisons, I define index versions of count variables.
 2711:       if      (k == ivrt)           return eta2; 
 2712:       else if (k == izlev)          return -hmod2;
 2713:       else if (k == kb)             return -depth;
 2714:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2715:       else if (k > izlev) {
 2716:          const int ksig = k - izlev;
 2717: 
 2718:          if (hmod2 <= h_c) {
 2719: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2720:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2721:          } 
 2722:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2723:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2724:             assert(false && "ZCOOR: invalid h_c\n");
 2725:          } 
 2726:          else {
 2727: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2728:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2729:                          h_c * mesh->sigma[ksig] + 
 2730:                          (hmod2 - h_c) * mesh->cs[ksig];
 2731:          }
 2732:       } else { 
 2733:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2734:       }
 2735: 
 2736:    }
 2737:    else if constexpr(ivcor == 1) {
 2738:       if (k == kb) return -depth;
 2739:       else if (k == nvrt-1) return eta2;
 2740:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2741:    }
 2742:    
 2743:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2744:    return 0.0;
 2745: }
 2746: 
 2747: 
 2748: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2749:    // Checks if a side in on the boundary
 2750:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2751: 
 2752:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2753:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2754: 
 2755:    // Indices of the nodes that form the side
 2756:    const int n1 = side.n1->idx;
 2757:    const int n2 = side.n2->idx;
 2758: 
 2759:    // Check if the side is on a land boundary
 2760:    for (int i = 0; i < nland; i++) {
 2761:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2762:          // Consecutive nodes in the land boundary segment
 2763:          const int b1 = ilnd[i*mnlnd + j];
 2764:          const int b2 = ilnd[i*mnlnd + j + 1];
 2765: 
 2766:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2767:             isLand = true;
 2768:             return i;
 2769:          }
 2770:       }
 2771:    }
 2772: 
 2773:    // Check if the side is on an open boundary
 2774:    for (int i = 0; i < nope; i++) {
 2775:       for (int j = 0; j < nond[i] - 1; j++) {
 2776:          // Consecutive nodes in the open boundary segment
 2777:          const int b1 = iond[i*mnond + j];
 2778:          const int b2 = iond[i*mnond + j + 1];
 2779: 
 2780:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2781:             isLand = false;
 2782:             return i;
 2783:          }
 2784:       }
 2785:    }
 2786:    return -1;
 2787: }
 2788: 
 2789: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2790:                 double *node_coords, double *node_coords_ll, bool use_ll,
 2791:                 double *wind_rotate_angle, 
 2792:                 int *isdel, int *isidenode, int *isbnd,
 2793:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2794:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2795:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2796:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2797:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2798:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2799:                 double *drag, double *roughness,
 2800:                 double *emo, double *efa, 
 2801:                 double *umo, double *ufa, 
 2802:                 double *vmo, double *vfa) {
 2803: 
 2804:    printf("Populating mesh for partition %d\n", partNum);
 2805: 
 2806:    // Horizontal grid
 2807:    printf("Processing %d nodes\n", np);   
 2808: 
 2809:    
 2810:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 2811:    const double fc   = 2.0*omega_e*sin(sfea0);
 2812:    const double beta = 2.0*omega_e*cos(sfea0);
 2813: 
 2814: 
 2815:    int idxNodeBoundary = 0;  
 2816:    for (int i = 0; i < np; i++)
 2817:    {
 2818: printf("NODE i = %d, np = %d\n", i, np);      
 2819:       Node &node = localNodeData[i];
 2820: 
 2821:       node.idx = i;
 2822: 
 2823:       const int idxNodeStart = nodeNeighNodesStart[i];
 2824:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2825:       node.numNodes = idxNodeEnd - idxNodeStart;
 2826:       node.nodes = nodeNeighNodes + idxNodeStart;
 2827:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2828: 
 2829: 
 2830: 
 2831:       const int idxElemStart = nodeNeighElemsStart[i];
 2832:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2833:       node.numElements = idxElemEnd - idxElemStart;
 2834:       node.elements = nodeNeighElems + idxElemStart;
 2835: 
 2836: 
 2837:       
 2838:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2839:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2840:          const int partNode = localNodePart[idxNodeGlobal]; 
 2841:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2842: 
 2843: 
 2844:          Node *node_ptr = nodes[partNode] + idxNode;
 2845:          
 2846:          nodeNeighNodes[idx] = node_ptr;
 2847:       }
 2848: 
 2849:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2850:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2851:          const int partElem = localElemPart[idxElemGlobal];
 2852:          const int idxElem  = localElemIndices[idxElemGlobal];
 2853: 
 2854:          Element *elem_ptr = elems[partElem] + idxElem;
 2855: 
 2856:          nodeNeighElems[idx] = elem_ptr;
 2857:       }      
 2858: 
 2859: 
 2860:       node.wind_angle = wind_rotate_angle[i];
 2861: 
 2862:       // Element **elements; // pointer to the elements connected to this node
 2863:       // int numElements;   // number of elements shared by this node
 2864: 
 2865:       node.p.x   = node_coords[i * 3];
 2866:       node.p.y   = node_coords[i * 3 + 1];
 2867:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2868:       node.depth = node_coords[i * 3 + 2];
 2869: 
 2870:       node.numSides = 0;
 2871: 
 2872:       node.Cd = drag[i];
 2873:       node.rough = roughness[i];
 2874: printf("NODE idx = %d, Cd = %.16f, rough = %.16f\n", i, node.Cd, node.rough);
 2875:       for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 2876: 
 2877:       // Links the node to the boundary information
 2878:       if (isbnd[i] >= 0) {
 2879:        
 2880:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2881:          node.nodeBnd->node = &node;
 2882: 
 2883:          node.nodeBnd->sideBnd1 = nullptr;
 2884:          node.nodeBnd->sideBnd2 = nullptr;
 2885: 
 2886:          if (isbnd[i]>=0) {
 2887: 
 2888:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2889:             
 2890:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2891:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2892: 
 2893:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2894:             node.nodeBnd->segment->clen  = nan("1");
 2895:             node.nodeBnd->segment->carea = nan("1");
 2896: 
 2897:          }
 2898: //          else {  XXXXXX
 2899: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2900: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2901: //          }
 2902:          
 2903:          idxNodeBoundary++;
 2904:       }
 2905:       else {
 2906:          node.nodeBnd = nullptr; // For internal nodes
 2907: 
 2908:          if (isbnd[i] == landSegment) {
 2909:             node.nodeBnd = &landBoundaryNode;
 2910:             node.nodeBnd->segment = &landBoundarySegment;
 2911:          }
 2912:          // node.nodeBnd->node = &node;
 2913:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2914:          // // node.nodeBnd = nullptr;
 2915:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2916:         
 2917:       }
 2918: 
 2919:       // XXXX GAUSSIAN HILL VELOCITIES
 2920: #ifdef GAUSSIAN_HILL_VELOCITIES
 2921:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2922:          constexpr double rot_per = 3000.0;
 2923:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2924:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2925:       // XXXXX
 2926: #endif
 2927:    }
 2928: 
 2929:    nbp = idxNodeBoundary;
 2930: 
 2931:    printf("Processing %d sides\n", ns);
 2932:    int idxSideBoundary = 0;
 2933:    for (int i = 0; i < ns; i++)
 2934:    {
 2935: if (i%1000 == 0) printf("SIDE i = %d, ns = %d\n", i, ns);      
 2936:       Side &side = localSideData[i];
 2937:       side.idx = i;
 2938:       // finding the pointer to the nodes that form the side
 2939:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2940:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2941: 
 2942:       const int locidx_n1 = localNodeIndices[idx_n1];
 2943:       const int locidx_n2 = localNodeIndices[idx_n2];
 2944:       const int part_n1 =   localNodePart[idx_n1];
 2945:       const int part_n2 =   localNodePart[idx_n2];
 2946: 
 2947:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2948:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2949: 
 2950:       // Counts the number of sides connected to each node
 2951:       side.n1->numSides++;
 2952:       side.n2->numSides++;
 2953: 
 2954:       // Normal, unitary vector to the side
 2955:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2956:       side.n = normalize(side.n);
 2957: 
 2958:       // Side boundary type
 2959:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2960:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2961: 
 2962:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2963:       // If both nodes are on the boundary, then the side may be on the boundary
 2964:       {
 2965:          bool isLand = false;
 2966:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2967: 
 2968:          if (isbs > -1) {
 2969:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2970:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2971:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2972: 
 2973:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2974:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2975:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2976: 
 2977:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2978:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2979:           
 2980:             side.sideBnd->side = &side;
 2981:             idxSideBoundary++;
 2982: 
 2983:          }
 2984:          
 2985: 
 2986:       // }
 2987:       // 
 2988: 
 2989: 
 2990: 
 2991: 
 2992: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2993: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2994: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2995: //       {
 2996: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2997: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2998: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2999: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 3000: // if (side.sideBnd->segment == nullptr) continue;
 3001: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 3002: //          else                  side.sideBnd->segment = n2bnd->segment;
 3003: //          side.sideBnd->side = &side;
 3004: //          idxSideBoundary++;
 3005: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 3006:       }
 3007:       else side.sideBnd = nullptr;
 3008: 
 3009:       nbs = idxSideBoundary;
 3010: 
 3011:       // finding the pointer to the elements that share the side
 3012:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 3013:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3014: 
 3015:       if (idx_e1 > -1) {
 3016:          const int locidx_e1 = localElemIndices[idx_e1];
 3017:          const int part_e1 =  localElemPart[idx_e1];
 3018:          side.elems[0] = elems[part_e1] + locidx_e1;
 3019: 
 3020:       }
 3021:       else {
 3022:          side.elems[0] = nullptr;
 3023:       }
 3024: 
 3025:       if (idx_e2 > -1) {
 3026:          const int locidx_e2 = localElemIndices[idx_e2];
 3027:          const int part_e2 =  localElemPart[idx_e2];
 3028:          side.elems[1] = elems[part_e2] + locidx_e2;
 3029:       }
 3030:       else {
 3031:          side.elems[1] = nullptr;
 3032:       }
 3033: 
 3034:       // Compute the center of the side
 3035:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3036: 
 3037:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3038:       side.shapiro = shapiro0;
 3039: 
 3040: #ifdef GAUSSIAN_HILL_VELOCITIES
 3041: // XXXX
 3042: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3043: constexpr double rot_per=3000.0;
 3044: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3045: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3046: // XXXXX      
 3047: #endif
 3048:       // Compute the z level at the center of the side
 3049:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3050: 
 3051:       // Compute the length of the side
 3052:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3053:       side.len = sqrt(dot(vLen, vLen));
 3054: 
 3055: 
 3056:       // Compute the Coriolis coefficient
 3057: 
 3058:       if constexpr(ncor == -1 || ncor == 0) {
 3059:          side.coriolis = coricoef;
 3060:       }
 3061:       else {
 3062:          const double sphi = side.lat();  // Latitude at the center of the side
 3063: 
 3064:          if constexpr(ics == 1) {
 3065:             side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3066:          }
 3067:          else {
 3068:             side.coriolis = 2.0*omega_e*sin(sphi);
 3069:          }
 3070:       }
 3071: 
 3072: 
 3073:    }
 3074: 
 3075:    printf("Processing %d elements\n", ne);
 3076:    for (int i = 0; i < ne; i++)
 3077:    {
 3078: printf("ELEMENT i = %d, ne = %d\n", i, ne);      
 3079:       Element &elem = localElemData[i];
 3080:       elem.idx = i;
 3081:       for (int j = 0; j < i34[i]; j++) {
 3082:          const int idxNode = elnode[i*4 + j];  
 3083:          const int idxSide = elside[i*4 + j];
 3084:          
 3085:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3086:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3087: 
 3088: 
 3089: 
 3090:          // Find the neighboring element  
 3091:          if (elem.sides[j]->elems[0] == &elem) {
 3092:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3093:          }
 3094:          else {
 3095:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3096:          }
 3097:          
 3098:       }
 3099: 
 3100:       elem.i34 = i34[i];
 3101: 
 3102:       // Compute the centroid of the element and its depth
 3103:       Vector2 center = {0.0, 0.0};
 3104:       elem.depth = 0.0;
 3105:       for (int j = 0; j < i34[i]; j++) {
 3106:          center += elem.nodes[j]->p2()/i34[i];
 3107:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3108:       }
 3109:       elem.center.x = center.x;
 3110:       elem.center.y = center.y;
 3111: 
 3112: 
 3113:       
 3114:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3115:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3116: 
 3117:       elem.area = elem.computeSignedArea(); 
 3118:       elem.radius = sqrt(elem.area)/pi; 
 3119:       
 3120:       // Determines which way the normal vector to each side is oriented.
 3121:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3122:       for (int j = 0; j < i34[i]; j++)  
 3123:       {
 3124:          if (elem.sides[j]->elems[0] == &elem) {
 3125:             elem.ssign[j] =  1.0;
 3126:          }
 3127:          else {
 3128:             elem.ssign[j] = -1.0;
 3129:          }
 3130: 
 3131:       }
 3132: 
 3133:       // Derivatives of shape functions
 3134:       //  For ics=2, this is done inside element/ll frame XXX
 3135:       //  For quads, the derivative is evaluated at centroid
 3136:       const int i34 = elem.i34;
 3137:       for (int j = 0; j < i34; j++) {
 3138:          const double area = elem.area;
 3139:          const int id2 = elem.nxq(1 + j);
 3140:          const int id3 = elem.nxq(2 + j);
 3141:          const int id4 = elem.nxq(3 + j);
 3142:          if (elem.isTri()) {
 3143:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3144:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3145:             // da1/dx = (y1 - y2)/(2*area)
 3146:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3147:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3148:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3149:          }
 3150:          else  { // Quad; evaluate at centroid
 3151:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3152:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3153:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3154:          } // if Tri
 3155: 
 3156:       } // for j
 3157: 
 3158:    }
 3159: 
 3160: 
 3161:    // Processing the boundary nodes
 3162:    int idx = 0;
 3163:    for (int iseg = 0; iseg < nope; iseg++) {
 3164:       // for each segment...
 3165:       
 3166:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3167:          // for each node on the segment...
 3168: 
 3169:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3170: 
 3171:          nodeBnd->isEssentialBC = true;
 3172:          nodeBnd->elbc = 0.0;
 3173: 
 3174:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3175: 
 3176:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3177:             nodeBnd->efa[jfr] = efa[idx];
 3178:             nodeBnd->emo[jfr] = emo[idx];
 3179:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3180:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3181: 
 3182:          }
 3183: 
 3184:          idx++;
 3185:       }
 3186: 
 3187:    }
 3188: 
 3189: }
