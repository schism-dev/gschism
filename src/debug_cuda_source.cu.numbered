 5293:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5294: 
 5295:       NODE(node);
 5296: 
 5297:       node->ETP = 0.0;
 5298: 
 5299:       if constexpr(ntip == 0) return;
 5300: 
 5301:       // For all tidal potential components
 5302:       for (int j=0; j<ntip; j++) {
 5303: 
 5304:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5305: 
 5306:          node->ETP += nodeETP;
 5307: 
 5308:          if constexpr(iloadtide==1) { // loading tide
 5309:             assert(false && "Loading tide not implemented");
 5310:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5311:          }
 5312:          
 5313:       }
 5314: 
 5315:      
 5316:    }
