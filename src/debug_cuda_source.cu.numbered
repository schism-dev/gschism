 2764: 
 2765: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2766: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2767: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2768: 
 2769: //       if (delta != 0.0) {
 2770: //          // Solves the two linear equations for tt1 and tt2
 2771: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
