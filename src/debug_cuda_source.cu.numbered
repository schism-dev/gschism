 2545: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2546: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2547: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2548: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2549: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2550: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2551:    Vector2 grad = {0.0, 0.0};
 2552:    int count = 0;
 2553: 
 2554:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2555: 
 2556:    // First element
 2557:    if (elems[0] != nullptr && condition(elems[0])) {
 2558:       grad += elems[0]->grad2(field);
 2559:       count++;
 2560:    }
 2561: 
 2562:    // Second element
 2563:    if (elems[1] != nullptr && condition(elems[1])) {
 2564:       grad += elems[1]->grad2(field);
 2565:       count++;
 2566:    }
 2567: 
 2568:    if (count > 0) {
 2569:       grad = grad/count;
 2570:    }
 2571:    
 2572:    return grad;
 2573: }
