 2851: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2852: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2853: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2854: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2855: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2856: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2857: // Computes the gradient of the field at the side center.
 2858:    Vector2 grad = {0.0, 0.0};
 2859:    int count = 0;
 2860: 
 2861:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 2862:    // as the average of the gradients at each element.
 2863:    // First element
 2864:    if (elems[0] != nullptr && condition(elems[0])) {
 2865:       Vector2 elemGrad = elems[0]->grad2(field);
 2866: 
 2867:       // For ics=2, projects the element gradient from its frame to the side frame
 2868:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 2869: 
 2870:       grad += elemGrad;
 2871: 
 2872:       count++;
 2873:    }
 2874: 
 2875:    // Second element
 2876:    if (elems[1] != nullptr && condition(elems[1])) {
 2877: 
 2878:       Vector2 elemGrad = elems[1]->grad2(field);
 2879: 
 2880:       // For ics=2, projects the element gradient from its frame to the side frame
 2881:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 2882: 
 2883:       grad += elemGrad;
 2884: 
 2885:       count++;
 2886:    }
 2887: 
 2888:    // If there are valid elements, returns the average of the gradients at the side's frame.
 2889:    if (count > 0) {
 2890:       grad = grad*(1.0/count);
 2891:    }
 2892:    
 2893:    return grad;
 2894: }
 2895: 
 2896: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2897: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2898: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2899: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2900: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2901: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2902: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2903: 
 2904: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2905: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2906: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2907: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2908: 
 2909: 
 2910: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2911: 
 2912: __inline__ __device__ Vector2 Side::tau(void)    const { 
 2913:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 2914:    if constexpr(ics == 1) { 
 2915:       return 0.5*(n1->tau + n2->tau);
 2916: 
 2917:    } else {
 2918:       // Project the tau from the node frames to the side frame
 2919:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 2920:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 2921: 
 2922:       return 0.5*(stau1 + stau2);
 2923:    }
 2924: }
 2925: 
 2926: /**
 2927:  * This method performs backtracking from the side center until a time -dt back in time 
 2928:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2929:  * intermediate point.
 2930:  *
 2931:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2932:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2933:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2934:  * remaining time.
 2935:  * 
 2936:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2937:  * 
 2938:  * @param uuint, vvint, wwint: Velocities at the final point
 2939:  * @param jlev: Level at which the backtracking is performed
 2940:  * @param dt, dtbk: Tracking timesteps
 2941:  * @return: True if the backtracking was successful, false otherwise
 2942:  */
 2943: __inline__ __device__ bool Side::btrack(
 2944:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2945:       double dt,            // Tracking time
 2946:       double dtbk,          // Tracking timestep
 2947:       Vector3 &u_int        // Velocities at the initial point
 2948: ) const {
 2949: 
 2950:    // Start from side center
 2951:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2952: 
 2953:  
 2954:    double time_rm = dt; // Remaining time
 2955: 
 2956: 
 2957:    // Initial velocities
 2958:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2959: 
 2960:    // Find the element that is in the direction opposite to the velocity
 2961:    Element* curElem = findElementTowards(toVector2(u_int));
 2962:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2963: 
 2964: 
 2965:    // Nudges it towards the barycenter
 2966:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2967: 
 2968: 
 2969:    const int MAX_ITERATIONS = 100; 
 2970:    Element* nextElem = nullptr;
 2971:    int iter = 0;
 2972:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2973:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2974:    while(true) {
 2975: 
 2976:       // Calculate timestep
 2977:       double dtb = min(dtbk, time_rm);
 2978: 
 2979: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2980: 
 2981:       // Next point in the backtracking curve
 2982: // if (iter >= MAX_ITERATIONS - 50)  {
 2983: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2984: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2985: // }
 2986:         
 2987:       xt = x0 - dtb*u_int;
 2988: 
 2989:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2990:       assert(found && "Backtracking failed in btrack");
 2991: 
 2992: 
 2993:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2994:                       // then time_rm needs to be increased by the unused time.
 2995: 
 2996:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2997: 
 2998:       // If the velocity is too small, we stop the backtracking
 2999:       const double vmag = length(toVector2(u_int));
 3000:       if (vmag <= velmin_btrack) break;
 3001: 
 3002:       // The current point becomes the next segment's starting point.
 3003:       x0 = xt;
 3004:  
 3005:       curElem = nextElem;
 3006: 
 3007:       iter++;
 3008: 
 3009:       if (iter >= MAX_ITERATIONS) break;
 3010: 
 3011:       // if (iter >= MAX_ITERATIONS - 50) {
 3012:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 3013:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 3014:       //    }
 3015:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3016:    }
 3017: 
 3018:    assert(!curElem->isDry && "Final element is dry");
 3019:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element"); 
 3020: 
 3021:    // Interpolate the velocities at the final point
 3022:    u_int = curElem->interpolateVelocities(xt);
 3023: 
 3024:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 3025: 
 3026: 
 3027: }
 3028: 
 3029: 
