 9950:          *sizeType = sizeof(Vector2);
 9951:          break;
 9952:       case (int)VarCode::gradEta1:
 9953:          *offset = (int)((char*)&sides[0].gradEta1.x - (char*)sides);
 9954:          *sizeType = sizeof(Vector2);
 9955:          break;
 9956:       case (int)VarCode::gradEta2:
 9957:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
 9958:          *sizeType = sizeof(Vector2);
 9959:          break;
 9960:       // case (int)VarCode::ghat:
 9961:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 9962:       //    *sizeType = sizeof(Vector2);
 9963:       //    break;   
 9964:       case (int)VarCode::hhat:
 9965:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 9966:          *sizeType = sizeof(Vector2);
 9967:          break;      
 9968:       case (int)VarCode::chi:
 9969:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 9970:          *sizeType = sizeof(double);
 9971:          break;
 9972:       case (int)VarCode::n1:
 9973:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 9974:          *sizeType = sizeof(Node);
 9975:          break;
 9976:       case (int)VarCode::n2:
 9977:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 9978:          *sizeType = sizeof(Node);
 9979:          break;                   
 9980:       default:
 9981:          *offset = -1;
 9982:    }
 9983: }
