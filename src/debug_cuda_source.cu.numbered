 5114: extern "C" {
 5115: 
 5116:    __global__ void scaleGravity(double loadtide_coef) {
 5117: 
 5118: 
 5119:       NODE(node);
 5120: 
 5121:       // SAL option: scale gravity
 5122:       if constexpr(iloadtide==2) {  // simple const
 5123:          node->grav2 = grav*(1.0 - loadtide_coef);
 5124: 
 5125:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5126:         
 5127:           const double depth = max(node->depth, 0.0);
 5128:           const double tmp1 = sqrt(depth);
 5129:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5130:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5131:                              2.6969e-13*depth*depth*depth*tmp1;
 5132:           
 5133:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5134:           
 5135: 
 5136: 
 5137:           node->grav2 = grav*(1.0 - beta_bar);
 5138: 
 5139:       } else {  // iloadtide=0,1
 5140:           node->grav2 = grav;
 5141: 
 5142:       }
 5143: 
 5144:    }
