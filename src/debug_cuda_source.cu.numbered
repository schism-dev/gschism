 4444:    __global__ void computeFlowBcVelocities(double time) {
 4445: 
 4446:       SIDE_BND(sideBnd);
 4447: 
 4448:       const Side *side = sideBnd->side;
 4449:  
 4450:       const bool isDry = side->isDry;
 4451:       const bool isLand = sideBnd->segment->isLand;
 4452: 
 4453:    
 4454:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4455: 
 4456:       if (isDry || isLand) return;
 4457: 
 4458:       // For wet sides in open boundaries...
 4459:       const Vector2 n = side->n;
 4460:       const BoundarySegment *segment = sideBnd->segment;
 4461: 
 4462:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4463: 
 4464:       const int ifltype = segment->ifltype;
 4465: 
 4466:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4467:       const Vector2 r_nuth0 = r_uth0*n;
 4468: 
 4469: 
 4470:       if (ifltype == 1 || ifltype == 2) {
 4471:       
 4472:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4473: 
 4474:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4475:          
 4476:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4477:          
 4478:       } else if (ifltype == -1) { // Flather 1
 4479: 
 4480:          for (int k = 0; k < nvrt; k++) {
 4481: 
 4482:             // uth is the normal vel.; no ramp up
 4483:             const double uth = sideBnd->nuth(k);
 4484:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4485: 
 4486:             sideBnd->ubc[k] += uth*n;
 4487:          }
 4488: 
 4489:       } else if (ifltype == 3 || ifltype == 5) {
 4490:          // vnth0=0 !normal vel.
 4491: 
 4492:          Vector2 r_u1_bar = {0.0, 0.0};
 4493:          // Computes the contribution to the velocity from all tide frequencies
 4494:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4495: 
 4496:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4497:             const Vector2 umo  = sideBnd->umo(jfr); 
 4498: 
 4499:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4500:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4501:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4502:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4503: // printf("r_u1_bar = %f, %f, ramp = %f, ff = %f, umo = %f, %f, ufa = %f, %f\n", r_u1_bar.x, r_u1_bar.y, ramp, ff[jfr], umo.x, umo.y, ufa.x, ufa.y);         
 4504:          }
 4505: 
 4506: 
 4507:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4508: 
 4509:       } // if (ifltype = 3 || ifltype == 5
 4510: 
 4511: 
 4512: 
 4513:    }
 4514: 
 4515:    __global__ void computeElevationBoundaryConditions(double time) {
 4516:       // Compute elevation essential boundary conditions 
 4517: 
 4518:       NODE_BND(nodeBnd); // Each boundary node.
 4519: 
 4520:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4521: 
 4522:       const Node *node = nodeBnd->node;
 4523:       const BoundarySegment *segment = nodeBnd->segment;
 4524:       const int iettype = segment->iettype;
 4525:       
 4526: 
 4527:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4528:       double eic = 0.0;
 4529:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4530:       else                 eic = 0.0;
 4531: 
 4532:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4533:       const double r_eth = ramp*nodeBnd->eth;
 4534:       double r_eta1_bar = 0.0;
 4535: 
 4536: 
 4537:       // Compute tide elevation
 4538:       if (iettype == 3 || iettype == 5) {   
 4539: 
 4540:          if constexpr(iloadtide==1) { // loading tide
 4541:             assert(false && "Loading tide not implemented");
 4542:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4543:          }
 4544:          
 4545:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4546: 
 4547:             const double efa  = nodeBnd->efa[jfr]; 
 4548:             const double emo  = nodeBnd->emo[jfr]; 
 4549: 
 4550:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4551:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4552:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4553: 
 4554:          } // for jfr
 4555: 
 4556:       } // if iettype
 4557: 
 4558:       switch (iettype) {
 4559:          case 1:
 4560:          case 2:
 4561:          case 4:
 4562:             nodeBnd->elbc = r_eic + r_eth;
 4563:             break;
 4564:          case 3:
 4565:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4566:             break;
 4567:          case 5:
 4568:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4569:             break;
 4570:       } // switch
 4571: 
 4572: 
 4573:       //Add inverse barometric effects
 4574:       if (iettype != 0 && inv_atm_bnd == 1) {
 4575:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4576:       }
 4577: 
 4578:    }
 4579: 
 4580: 
 4581:    __global__ void computeHorizontalViscosity(void) { 
 4582: 
 4583:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4584: 
 4585:       SIDE(side);
 4586: 
 4587:       if (side->isDry) return;
 4588: 
 4589:       for (int k = 0; k < nvrt; k++) {
 4590:          side->nuGradU[k] = {0.0, 0.0};
 4591:       }
 4592: 
 4593:       if constexpr(ihorcon == 1) {
 4594:          for (int k = side->kb; k < nvrt - 1; k++) {
 4595:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4596:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4597:             // By Zhang and Baptista.
 4598: 
 4599:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4600:             // This is a standard discretization of the Laplacian operator.
 4601:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4602:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4603:             // Gamma is hvis_coef0 in the code.
 4604:             // The value of gamma needs to be < 0.5.
 4605: 
 4606:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4607:             // side under consideration in each of the two possible elements that share the side.
 4608:             Vector2 sumU = {0.0, 0.0};
 4609:             for (int l = 0; l < 2; l++) {
 4610:                const Element *elem = side->elems[l];
 4611: 
 4612:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4613: 
 4614:                // Find the local index of the side in the element
 4615:                const int idxSide = elem->sideLocalIdx(side);
 4616:                // Find the two sides that are connected to the side under consideration
 4617:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4618:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4619: 
 4620:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4621: 
 4622:             }
 4623: 
 4624:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4625:    
 4626:          }
 4627:       }
 4628:       else if constexpr(ihorcon == 2) {
 4629:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4630:       }
 4631: 
 4632: 
 4633:    }
 4634: 
 4635: 
 4636:    __global__ void setEssentialBC(void) {
 4637:       // Set essential boundary conditions 
 4638:       NODE(node); // Each boundary node
 4639:       NodeBoundary *nodeBnd = node->nodeBnd;
 4640:       
 4641: // nodeBnd->isEssentialBC = true;      
 4642:       // Check if this node has essential BC
 4643:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4644:          // Verify BC value is valid
 4645:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4646: 
 4647:        
 4648:          // Set diagonal to 1 and zero off-diagonals
 4649:          node->coeffDiag = 1.0;
 4650: 
 4651:          for (int j = 0; j < node->numNodes; j++) {
 4652:                node->coeffMatrix[j] = 0.0;
 4653:          }
 4654:          
 4655:          // Set solution and RHS to BC value
 4656:          node->mX  = nodeBnd->elbc;
 4657:          node->qel = nodeBnd->elbc;
 4658: 
 4659:       } else {
 4660:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4661: 
 4662:          for (int j = 0; j < node->numNodes; j++) {
 4663:                Node* nbNode = node->nodes[j];
 4664:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4665:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4666:                   // Verify neighbor's BC value
 4667:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4668: 
 4669:                   // Subtract contribution to RHS
 4670:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4671:                   node->coeffMatrix[j] = 0.0;  
 4672:                }
 4673:          }
 4674:       }
 4675:    }
 4676: 
 4677: 
 4678:    __global__ void updateElevation(void) {
 4679:       NODE(node);
 4680: 
 4681:       node->eta2 = node->mX;
 4682: 
 4683:       node->updateZCoordData();
 4684:    }
 4685: 
