 3100: extern "C" {
 3101:    __global__ void rollUpElevation(void) {
 3102: 
 3103:       NODE(node);
 3104: 
 3105:       node->eta2 += node->eta1;
 3106: 
 3107:    }
 3108: 
 3109: 
 3110:    __global__ void backtrackAllNodes(void) {
 3111: 
 3112:       // max/min # of sub-divisions
 3113:       const int ndelt_max = max(1.0, dt/dtb_min);
 3114:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3115: 
 3116:       // Removed all references to swild98 XXX
 3117:       // swild98=0.d0 !init
 3118: 
 3119: 
 3120:       SIDE(side);
 3121: 
 3122:       const int kb = side->kb;
 3123: 
 3124:       printf("backtrackAllNodes: side->idx = %d, nvrt = %d\n", side->idx, nvrt);
 3125: 
 3126:       // Initialize btrack velocities to the actual velocities at the side 
 3127:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3128: 
 3129: 
 3130:       if (side->isDry) return;
 3131: 
 3132: 
 3133:       // Checks that at least one element is not dry
 3134:       const Element *elem1 = side->elems[0];
 3135:       const Element *elem2 = side->elems[1];
 3136: 
 3137: 
 3138:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3139:       
 3140:       // XXXXXX
 3141:       // !swild_tmp to store global coord. of the starting side
 3142:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3143:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3144:       // !Use sframe2 
 3145:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3146: 
 3147: 
 3148:       for (int k = kb; k < nvrt; k++) {
 3149:       //  Initialize (xt,yt,zt), nnel and vel.
 3150:       //  For ics=2, the coordinates are in local frames
 3151:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3152: 
 3153: 
 3154:          const int iadvf = side->iadv();  // Advection flag
 3155: 
 3156:          Point3 xt;
 3157:          if constexpr(ics==1) {
 3158:             xt = side->center3D(k); 
 3159:          }
 3160:          else // lat/lon; in side lat/lon frame
 3161:          {
 3162:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3163:          // XXX IMPLEMENT THIS
 3164:       //          xt=0.d0
 3165:       //          yt=0.d0
 3166:       //          !centroid coord. for nudging
 3167:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3168:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3169:          }  // ics
 3170: 
 3171: 
 3172:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3173:          // XXX IS THIS NECESSARY?
 3174:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3175: 
 3176:          // If on land or open boundary...
 3177:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3178:          
 3179:          const double vmag = length(toVector2(u_int));
 3180: 
 3181: printf("XXX backtrackAllNodes: side->idx = %d, vmag = %f\n", side->idx, vmag);
 3182: 
 3183:          if (vmag <= velmin_btrack) {
 3184:             // No activity 
 3185: 
 3186:             side->btu[k] = side->u2[k];
 3187: 
 3188:             
 3189:          } else {  // do btrack
 3190: 
 3191:           
 3192:             // Compute number of sub-divisions based on local gradients 
 3193:             // XXX IS THIS NECESSARY?
 3194:             double suma = 0.0;
 3195:             int icount = 0;
 3196:             for (int ii=0; ii<2; ii++) {
 3197: 
 3198:                const Element *elem = side->elems[ii];
 3199:                  
 3200:                if (elem == nullptr) continue;
 3201: 
 3202:                icount++;
 3203: 
 3204:                // Not strictly along z; in ll frame for ics=2
 3205: 
 3206:                double utmp[4];
 3207:                double vtmp[4];
 3208:                for (int jj = 0; jj < elem->i34; jj++) {
 3209: 
 3210:                   const Node *node = elem->nodes[jj];
 3211: 
 3212:                   if constexpr(ics==1) {
 3213:                      utmp[jj] = node->u2[k].x;
 3214:                      vtmp[jj] = node->u2[k].y;  
 3215:                   } else {
 3216:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3217:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3218:                   }
 3219:                } // for jj
 3220: 
 3221:                const Vector2 grad_u = elem->grad2(utmp); 
 3222:                const Vector2 grad_v = elem->grad2(vtmp);
 3223: 
 3224:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3225:             } // for ii
 3226: 
 3227:             assert(icount > 0 && "Impossible 77");
 3228: 
 3229:             // '4' is somewhat arbitrary
 3230:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3231: 
 3232:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3233:          
 3234: 
 3235:             Vector3 u_int = {0.0, 0.0, 0.0};
 3236: 
 3237:             side->btrack(k, dt, dtbk, u_int);
 3238: 
 3239:                
 3240:          } // if vmag (do backtrack)
 3241: 
 3242:       } // for j=jmin,nvrt-1
 3243: 
 3244:    }
 3245: } // extern "C"
 3246: 
 3247: template<int nc>
 3248: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3249: 
 3250: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3251: //
 3252: // a,b,c,rhs: input vectors and are not modified by this program.
 3253: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3254: // rhs is the r.h.s.
 3255: // n: actual rank of the system.
 3256: // rows in u() and rhs();
 3257: // u: output with nc columns (transposed to rows)
 3258: // gam: a working array.
 3259: //
 3260: // NOTES:
 3261: // This is a template function that allows for different numbers of columns in the rhs vector.
 3262: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3263: 
 3264:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3265:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3266: 
 3267:    double bet = b[0];
 3268:    if constexpr (nc == 1) {
 3269:       u[0] = rhs[0]/bet;
 3270:    } else {
 3271:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3272:    }
 3273: 
 3274:    for (int j = 1; j < n; j++) {
 3275:       gam[j] = c[j-1]/bet;
 3276:       bet = b[j] - a[j]*gam[j];
 3277: 
 3278:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3279: 
 3280:       if constexpr (nc == 1) {
 3281:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3282:       } else {
 3283:          for (int k = 0; k < nc; k++) {
 3284:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3285:          }
 3286:       }
 3287:    }
 3288: 
 3289:    // Back-substitution
 3290:    for (int j=n-1; j>=1; j--) {
 3291:       if constexpr (nc == 1) {
 3292:          u[j] = u[j] - gam[j+1]*u[j-1];
 3293:       } else {
 3294:          for (int k = 0; k < nc; k++) {
 3295:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3296:          }
 3297:       }
 3298:    }
 3299: }
 3300: 
 3301: 
 3302: 
 3303: // Helper function that contains the core algorithm
 3304: template<typename XAccessor, typename YAccessor>
 3305: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3306:                                     double  yp_top, double  yp_bot, 
 3307:                                     CubicSpline &spline) {
 3308:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3309:    // 
 3310:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3311:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3312:    //
 3313:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3314:    // 
 3315:    // Inputs: 
 3316:    //            n: dimension for x etc; # of data pts (>=2);
 3317:    //            getX, getY: functions to access x,y coordinates
 3318:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3319:    //     Output: 
 3320:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3321: 
 3322:    const int n = k2 - k1 + 1;
 3323:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3324: 
 3325:    // Allocate memory for the splines
 3326:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3327:    spline.x   = new double[n];
 3328:    spline.y   = new double[n];
 3329:    spline.yp  = new double[n];
 3330:    spline.ypp = new double[n];
 3331: 
 3332:    for (int k=k1; k<=k2; k++) {
 3333:       spline.x[k] = getX(k);
 3334:       spline.y[k] = getY(k);
 3335:    }
 3336: 
 3337:    // This is to simplify expressions later
 3338:    double *x = spline.x;
 3339:    double *y = spline.y;
 3340: 
 3341:    double *a = nullptr;
 3342:    double *b = nullptr;
 3343:    double *c = nullptr;
 3344:    double *gam = nullptr;
 3345:    double *rhs = nullptr;
 3346:    
 3347: 
 3348:       a = new double[n];   // Lower diagonal
 3349:       b = new double[n];   // Diagonal
 3350:       c = new double[n];   // Upper diagonal
 3351:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3352:       rhs = new double[n]; // Right-hand side
 3353: 
 3354:    for (int k=k1; k<=k2; k++) {
 3355:       if (k == k1) {
 3356:          // Bottom level
 3357:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3358:          b[k] = (x[k+1] - x[k])/3.0;
 3359:          c[k] = b[k]/2.0;
 3360:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3361:       } else if (k == n - 1) {
 3362:          // Top level (surface)
 3363:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3364:          b[k] = (x[k] - x[k-1])/3.0;
 3365:          a[k] = b[k]/2.0;
 3366:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3367:       } else {
 3368:          // Intermediate levels
 3369:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3370:          b[k] = (x[k+1] - x[k-1])/3.0;
 3371:          a[k] = (x[k  ] - x[k-1])/6.0;
 3372:          c[k] = (x[k+1] - x[k  ])/6.0;
 3373:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3374:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3375:       }
 3376:    }
 3377: 
 3378:    // Solve the tridiagonal system
 3379:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3380:    
 3381:    spline.yp[k1] = yp_bot;
 3382:    spline.yp[k2] = yp_top;
 3383: 
 3384:    // Compute rest of 1st derivatives using the splines
 3385:    for (int k=k1+1; k<k2; k++) {
 3386:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3387:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3388:    }
 3389:    
 3390:    delete[] a;
 3391:    delete[] b;
 3392:    delete[] c;
 3393:    delete[] gam;
 3394:    delete[] rhs;
 3395: 
 3396: }
 3397: 
 3398: // Array version
 3399: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3400:                                 double y_top, double y_bot, 
 3401:                                 CubicSpline &spline) {
 3402:    auto getX = [x] (int k) { return x[k]; };
 3403:    auto getY = [y] (int k) { return y[k]; };
 3404:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3405: }
 3406: 
 3407: // Lambda version - allows custom access patterns
 3408: template<typename XFunc, typename YFunc>
 3409: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3410:                                 double y_top, double y_bot,
 3411:                                 CubicSpline &spline) {
 3412:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3413: }
 3414: 
 3415: 
 3416: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3417: {
 3418:    assert("Not implemented");
 3419: 
 3420:    return 0.0;
 3421: }
 3422: 
 3423: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 3424: // //     Routine to do vertical linear interpolation in z
 3425: // //     Inputs:
 3426: // //
 3427: // //       nc: actual # of variables 
 3428: // //       k1,k2: lower and upper limits for za, s_in 
 3429: // //       zt: desired interpolation level
 3430: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 3431: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 3432: 
 3433: // //     Outputs:
 3434: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 3435: // //                   is used below bottom or above surface.
