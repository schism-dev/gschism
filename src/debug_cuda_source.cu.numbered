 7447: #ifdef DONTCOMPILE
 7448: __global__ void checkMassConservation(Tracers* sumtr) {
 7449: 
 7450:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7451: 
 7452:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7453: 
 7454:    Element *elem = &(mesh->localElemData[i]);
 7455: 
 7456:    // Skip dry elements
 7457:    if (elem->isDry) return;
 7458: 
 7459:    // Local sum array for this thread
 7460:    double localSum[N_TRACERS] = {0.0};
 7461: 
 7462:    // Sum over vertical levels for this element
 7463:    const int kbe = elem->kbe;
 7464:    const double area = elem->area;
 7465: 
 7466:    for (int k = kbe; k < nvrt; k++) {
 7467:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7468:       
 7469:       // Accumulate tracer mass
 7470:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7471:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7472:       }
 7473:    }
 7474: 
 7475:    
 7476: 
 7477:    //  This function returns per element sums. A reduction must be done on the host side.
 7478: }
 7479: 
 7480: 
 7481: __global__ void transport(void) {
 7482: 
 7483:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7484: 
 7485:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7486: 
 7487:    Element *elem = &(mesh->localElemData[ie]);
 7488: 
 7489:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7490: 
 7491:                for (int m=0; m<ntr; m++) {
 7492:                   for (int k=kbe(ie); k<nvrt; k++) {
 7493:                      // Calculate each polynomial's weight 
 7494:                      wm=0.d0; sum1=0.d0; 
 7495:                      wm1=0.d0; wm2=0.d0; 
 7496:                      for (int i=0; i<elem->nweno2; i++) {
 7497:                   
 7498:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7499:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7500:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7501:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7502:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7503:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7504:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7505:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7506:                      // -----------------Hu and Shu (1999)'s method----------------
 7507:                      b4=b1+b2+b3
 7508: 
 7509: //Error: add PRODUCTION CPP
 7510: #ifdef DEBUG
 7511:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7512:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7513:                     call parallel_abort(errmsg)
 7514:                   }
 7515: #endif
 7516: 
 7517:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7518:                   // !----test-------------- 
 7519:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7520:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7521:                   // !wm(i)=wm1(i)*wm2(i)
 7522:                   // !---------------------- 
 7523:                   sum1=sum1+wm(i)
 7524:                 } // end for i
 7525: 
 7526:                 wm=wm/sum1
 7527: 
 7528:                 for (int j=0; j<elem->i34; j++) {
 7529: 
 7530:                   const Side *side  = elem->sides[j];
 7531:                   const Node *node1 = side->n1;
 7532:                   const Node *node2 = side->n2;
 7533: 
 7534:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7535:                      trsd=0.d0
 7536:                      for (int kk=0; kk<nquad; kk++) {
 7537:                         for (int i=0; i<elem->nweno2; i++) {
 7538:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7539:                         } // end for i   
 7540:                      } // end for kk
 7541:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7542:                   } // outward flux
 7543:                } // end for j=1,i34(ie) ! side
 7544:             }
 7545:          }
 7546:               
 7547: 
 7548: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7549: //             //   calculate each polynomial's weight 
 7550: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7551: //                 wm=0.d0; sum1=0.d0
 7552: //                 do i=1,nweno1(ie) !for each polynomial
 7553: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7554: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7555: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7556: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7557: //                   wm(i)=b2
 7558: //                   sum1=sum1+b2
 7559: //                   !wm(i)=1.d0
 7560: //                   !sum1=sum1+1.d0
 7561: 
 7562: // // Error: PRODUCTION
 7563: // #ifdef DEBUG
 7564: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7565: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7566: //                     call parallel_abort(errmsg)
 7567: //                   endif
 7568: // #endif
 7569: 
 7570: //                 enddo !i
 7571: //                 wm=wm/sum1 !final weight
 7572: 
 7573:                 for (int j=0; j<elem->i34; j++) { // side
 7574:                   const Side *side = elem->sides[j];
 7575:                   const Node *node1 = side->n1;
 7576:                   const Node *node2 = side->n2;
 7577: 
 7578:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7579:                     trsd=0.d0
 7580:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7581:                       for (int i=0; i<elem->nweno1; i++) {
 7582:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7583:                       }
 7584:                     enddo //kk
 7585:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7586:                   } // outward flux
 7587:                 } // end for j=1,i34(ie) ! side
 7588:               } // end for k; ntr 
 7589: 
 7590:             else !simple upwind method
 7591:               do j=1,i34(ie)
 7592:                 jsj=elside(j,ie)
 7593:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7594:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7595:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7596:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7597:                   endif
 7598:                 enddo  !vertical layers
 7599:               enddo !j=1,i34(ie) ! side
 7600:             endif !order of accuracy
 7601: 
 7602:          //  enddo !ie
 7603: // !$OMP     end do
 7604: 
