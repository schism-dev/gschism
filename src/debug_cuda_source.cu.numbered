  906:    double eth;   // Elevation time history
  907: 
  908:    // Flow boundary condition
  909:    double qthcon;  // Flow time history constant
  910:    double vobc1;   // Velocity coefficient 1
  911:    double vobc2;   // Velocity coefficient 2
  912: 
  913:    // Tracer boundary conditions
  914:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  915:    // int  itrtype[natrm];    // Tracer boundary condition type
  916: 
  917:    BoundarySegment(bool _isLand) {
  918:       isLand = _isLand;
  919:       clen = 0.0;
  920:       carea = 0.0;
  921:       ifltype = 0;
  922:       iettype = 0;
  923:       eth = 0.0;
  924:    }
  925: 
  926:    BoundarySegment(void) {
  927:       isLand = false;
  928:       clen = 0.0;
  929:       carea = 0.0;
  930:       ifltype = 0;
  931:       iettype = 0;
  932:       eth = 0.0;
  933:    }
  934: 
  935:    
