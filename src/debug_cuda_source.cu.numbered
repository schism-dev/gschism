 1139: struct Side {
 1140: 
 1141:    // Geometry information
 1142:    int idx;               // Index of the side
 1143:    Node *n1, *n2;
 1144:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1145: 
 1146:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1147:    Vector2 center;        // Location of side center. 
 1148:    double zc[nvrt];       // Side center z-coord at each vertical level
 1149: 
 1150:    Frame<ics> frame;
 1151:    
 1152:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1153:                           // this is nullptr
 1154:    
 1155:    int kb;                // Bottom index of the side
 1156:    bool isDry;            // True if the side is dry
 1157:  
 1158:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1159: 
 1160:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1161: 
 1162:    // Physical information
 1163:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1164:    Vector2 btu[nvrt];           // Back-tracked velocity
 1165:    Vector2 U;                   // Vertically averaged velocity vector  
 1166: 
 1167:    Vector2 nuGradU[nvrt];          // nu*grad u
 1168: 
 1169:    Vector2 bcc[nvrt];           // Baroclinic term
 1170:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1171: 
 1172:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1173:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1174:    Vector2 gradPr;               // Gradient of pressure
 1175:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1176: 
 1177: 
 1178:    double hhat;                 // \breve{H} in notes
 1179: 
 1180:    double shapiro;
 1181: 
 1182:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1183: 
 1184:    double coriolis;             // Coriolis parameter
 1185: 
 1186:    // Vegetation parameters
 1187:    double veg_c2;
 1188:    double veg_beta;
 1189: 
 1190:    // Bottom drag parameters.
 1191:    double chi;
 1192:    double chi2;
 1193: 
 1194:    __inline__ __device__ Point2 outputCoords(void) const;
 1195: 
 1196:    __inline__ __device__ double x(double t) const;
 1197:    __inline__ __device__ double y(double t) const;
 1198:    __inline__ __device__ double z(double t) const;
 1199:    __inline__ __device__ double lon(void) const;
 1200:    __inline__ __device__ double lat(void) const;
 1201:    __inline__ __device__ Point2 p2_t(double t) const;
 1202: 
 1203:    __device__ void setFrame(void) {
 1204:       if constexpr(ics == 1) return;
 1205: 
 1206:       double lat, lon;
 1207:       const Point3 p = toPoint3(center, centerZ());
 1208: 
 1209:       // Compute the latitude and longitude of the element center
 1210:       computeLatLon(p, lat, lon);
 1211: 
 1212:       frame.update(lat, lon);        
 1213:    }
 1214:    
 1215: 
 1216:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1217:    // If ics == 2, convert the global point to the local frame of the side
 1218:       
 1219:       if constexpr (ics == 1) {
 1220:          return p;
 1221:       } else {
 1222:          const Point3 c = {center.x, center.y, centerZ()};
 1223:          const Point3 local = frame.G2L(p - c);
 1224:          return local;
 1225:       }
 1226:    }
 1227: 
 1228:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1229:       if constexpr (ics == 1) {
 1230:          return p;
 1231:       } else {
 1232:          const Point3 c = {center.x, center.y, centerZ()};
 1233:          return c + frame.L2G(p);
 1234:       }
 1235:    }
 1236: 
 1237: 
 1238:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1239:       if constexpr(ics == 1) return v;
 1240:       else return v_frame.projHorVec(v, frame);
 1241:    }
 1242: 
 1243:    __inline__ __device__ double centerZ(void)      const;
 1244:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1245:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1246:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1247:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1248: 
 1249:    __inline__ __device__ Side* neigh(int index) const { 
 1250:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1251:       assert(index >= 0 && index < 4); 
 1252:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1253: 
 1254:       const int ielem = index & 1;           // 0 or 1
 1255:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1256: 
 1257:       const Element* elem = elems[ielem];
 1258: 
 1259:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1260: 
 1261:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1262: 
 1263:    }
 1264: 
 1265:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1266: 
 1267:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1268: 
 1269:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1270:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1271:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1272:    __inline__ __device__ int iadv(void) const;
 1273: 
 1274:    __inline__ __device__ double grav3(void) const;
 1275:    
 1276:    __inline__ __device__ double eta2(void) const;
 1277:    __inline__ __device__ double eta1(void) const;
 1278:    __inline__ __device__ double w2(int k) const;
 1279:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1280:    __inline__ __device__ double depth(void) const;
 1281:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1282:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1283: 
 1284:    __inline__ __device__ double dfv(int k) const;
 1285: 
 1286:    __inline__ __device__ double veg_h(void)  const;
 1287:    __inline__ __device__ double veg_nv(void) const;
 1288:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1289:    __inline__ __device__ double veg_alpha3D(int k) const;
 1290:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1291: 
 1292:    __inline__ __device__ double Cd(void) const;
 1293: 
 1294:    __inline__ __device__ Vector2 tau(void) const;
 1295: 
 1296:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1297:    
 1298: 
 1299:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1300:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1301:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1302:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1303:    } 
 1304:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1305:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1306:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1307:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1308: 
 1309:    // Get valid starting element (for backtracking)
 1310:    __inline__ __device__ Element* getStartElement() {
 1311:       return elems[0] ? elems[0] : elems[1];
 1312:    }
 1313: 
 1314:    
 1315:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1316:       // Given an element, returns the other element that shares this side
 1317:       return (elems[0] == elem) ? elems[1] : elems[0];
 1318:    }
 1319: 
 1320:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1321:       // Given a node, returns the other node that shares this side
 1322:       return (n1 == node) ? n2 : n1;
 1323:    }
 1324:  
 1325:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1326: 
 1327: 
 1328: 
 1329: 
 1330: };
