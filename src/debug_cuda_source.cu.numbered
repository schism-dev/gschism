 3851: __device__ void Node::updateKb(void) {
 3852: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3853: 
 3854:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3855: 
 3856: 
 3857:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3858: 
 3859:    if constexpr(ivcor == 2) {  // SZ coordinates
 3860:       
 3861:       // Compute bottom level index
 3862:       if (depth <= mesh->h_s) {
 3863:          kb = izlev;   
 3864:          
 3865:       } else {
 3866:          kb = -1;
 3867:          int L = 0;
 3868:          int R = nzlev; 
 3869:          
 3870:          while (L <= R) {
 3871:             int M = (R + L) / 2;
 3872: 
 3873: 
 3874:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3875:             
 3876:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3877:                R = M;
 3878:             } else {
 3879:                L = M;
 3880:             }
 3881: 
 3882:             if (R - L == 1) {
 3883:                kb = L;
 3884:                break;
 3885:             }
 3886:          }
 3887: 
 3888:          // Checks that the binary search was successful
 3889:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3890:        
 3891:       }
 3892:    } 
 3893: }
 3894: 
