 5207: 
 5208:    __global__ void computeFlowBcVelocities(double time) {
 5209: 
 5210:       SIDE_BND(sideBnd);
 5211: 
 5212:       const Side *side = sideBnd->side;
 5213:  
 5214:       const bool isDry = side->isDry;
 5215:       const bool isLand = sideBnd->segment->isLand;
 5216: 
 5217:    
 5218:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5219: 
 5220:       if (isDry || isLand) return;
 5221: 
 5222:       // For wet sides in open boundaries...
 5223:       const Vector2 n = side->n;
 5224:       const BoundarySegment *segment = sideBnd->segment;
 5225: 
 5226:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5227: 
 5228:       const int ifltype = segment->ifltype;
 5229: 
 5230:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5231:       const Vector2 r_nuth0 = r_uth0*n;
 5232: 
 5233: 
 5234:       if (ifltype == 1 || ifltype == 2) {
 5235:       
 5236:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5237: 
 5238:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5239:          
 5240:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5241:          
 5242:       } else if (ifltype == -1) { // Flather 1
 5243: 
 5244:          for (int k = 0; k < nvrt; k++) {
 5245: 
 5246:             // uth is the normal vel.; no ramp up
 5247:             const double uth = sideBnd->nuth(k);
 5248:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5249: 
 5250:             sideBnd->ubc[k] += uth*n;
 5251:          }
 5252: 
 5253:       } else if (ifltype == 3 || ifltype == 5) {
 5254:          // vnth0=0 !normal vel.
 5255: 
 5256:          Vector2 r_u1_bar = {0.0, 0.0};
 5257:          // Computes the contribution to the velocity from all tide frequencies
 5258:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5259: 
 5260:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5261:             const Vector2 umo  = sideBnd->umo(jfr); 
 5262: 
 5263:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5264:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5265:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5266:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5267: 
 5268:          }
 5269: 
 5270: 
 5271:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5272: 
 5273:       } // if (ifltype = 3 || ifltype == 5
 5274: 
 5275: 
 5276: 
 5277:    }
 5278: 
 5279:    __global__ void computeElevationBoundaryConditions(double time) {
 5280:       // Compute elevation essential boundary conditions 
 5281: 
 5282:       NODE_BND(nodeBnd); // Each boundary node.
 5283: 
 5284:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5285: 
 5286:       const Node *node = nodeBnd->node;
 5287:       const BoundarySegment *segment = nodeBnd->segment;
 5288:       const int iettype = segment->iettype;
 5289:       
 5290: 
 5291:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5292:       double eic = 0.0;
 5293:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5294:       else                 eic = 0.0;
 5295: 
 5296:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5297:       const double r_eth = ramp*nodeBnd->eth;
 5298:       double r_eta1_bar = 0.0;
 5299: 
 5300: 
 5301:       // Compute tide elevation
 5302:       if (iettype == 3 || iettype == 5) {   
 5303: 
 5304:          if constexpr(iloadtide==1) { // loading tide
 5305:             assert(false && "Loading tide not implemented");
 5306:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5307:          }
 5308:          
 5309:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5310: 
 5311:             const double efa  = nodeBnd->efa[jfr]; 
 5312:             const double emo  = nodeBnd->emo[jfr]; 
 5313: 
 5314:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5315:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5316:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5317: 
 5318:          } // for jfr
 5319: 
 5320:       } // if iettype
 5321: 
 5322:       switch (iettype) {
 5323:          case 1:
 5324:          case 2:
 5325:          case 4:
 5326:             nodeBnd->elbc = r_eic + r_eth;
 5327:             break;
 5328:          case 3:
 5329:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5330:             break;
 5331:          case 5:
 5332:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5333:             break;
 5334:       } // switch
 5335: 
 5336: 
 5337:       //Add inverse barometric effects
 5338:       if (iettype != 0 && inv_atm_bnd == 1) {
 5339:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5340:       }
 5341: 
 5342:    }
 5343: 
 5344: 
 5345:    __global__ void computeHorizontalViscosity(void) { 
 5346: 
 5347:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5348: 
 5349:       SIDE(side);
 5350: 
 5351:       if (side->isDry) return;
 5352: 
 5353:       for (int k = 0; k < nvrt; k++) {
 5354:          side->nuGradU[k] = {0.0, 0.0};
 5355:       }
 5356: 
 5357:       if constexpr(ihorcon == 1) {
 5358:          for (int k = side->kb; k < nvrt - 1; k++) {
 5359:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5360:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5361:             // By Zhang and Baptista.
 5362: 
 5363:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5364:             // This is a standard discretization of the Laplacian operator.
 5365:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5366:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5367:             // Gamma is hvis_coef0 in the code.
 5368:             // The value of gamma needs to be < 0.5.
 5369: 
 5370:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5371:             // side under consideration in each of the two possible elements that share the side.
 5372:             Vector2 sumU = {0.0, 0.0};
 5373:             for (int l = 0; l < 2; l++) {
 5374:                const Element *elem = side->elems[l];
 5375: 
 5376:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5377: 
 5378:                // Find the local index of the side in the element
 5379:                const int idxSide = elem->sideLocalIdx(side);
 5380: 
 5381:                // Find the two sides that are connected to the side under consideration
 5382:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5383:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5384: 
 5385:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5386: 
 5387:             }
 5388: 
 5389:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5390: 
 5391:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5392:    
 5393:          }
 5394:       }
 5395:       else if constexpr(ihorcon == 2) {
 5396:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5397:       }
 5398: 
 5399: 
 5400:    }
 5401: 
 5402: 
 5403:    __global__ void setEssentialBC(void) {
 5404:       // Set essential boundary conditions 
 5405:       NODE(node); // Each boundary node
 5406:       NodeBoundary *nodeBnd = node->nodeBnd;
 5407:       
 5408:  
 5409:       // Check if this node has essential BC
 5410:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5411:          // Verify BC value is valid
 5412:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5413: 
 5414:        
 5415:          // Set diagonal to 1 and zero off-diagonals
 5416:          node->coeffDiag = 1.0;
 5417: 
 5418:          for (int j = 0; j < node->numNodes; j++) {
 5419:                node->coeffMatrix[j] = 0.0;
 5420:          }
 5421:          
 5422:          // Set solution and RHS to BC value
 5423:          node->mX  = nodeBnd->elbc;
 5424:          node->qel = nodeBnd->elbc;
 5425: 
 5426:       } else {
 5427:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5428: 
 5429:          for (int j = 0; j < node->numNodes; j++) {
 5430:                Node* nbNode = node->nodes[j];
 5431:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5432:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5433:                   // Verify neighbor's BC value
 5434:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5435: 
 5436:                   // Subtract contribution to RHS
 5437:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5438:                   node->coeffMatrix[j] = 0.0;  
 5439:                }
 5440:          }
 5441:       }
 5442:    }
 5443: 
 5444: 
 5445:    __global__ void updateElevation(void) {
 5446:       NODE(node);
 5447: 
 5448: 
 5449:       node->eta2 = node->mX;
 5450: 
 5451:       node->updateZCoordData();
 5452:    }
