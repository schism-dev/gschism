  260: 
  261: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  262:     return make_double3(v.x * s, v.y * s, v.z * s);
  263: }
  264: 
  265: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
