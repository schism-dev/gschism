 1839: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1840:    // Computes the 3D normal vector to the element at level k
 1841:    // Returns the normal vector and the area of the element
 1842: 
 1843:    if (isTri()) {
 1844:       // For triangles...
 1845: 
 1846:       // Gets the normal vector to the element (with a length equal to twice the area)
 1847:       if constexpr(ics==1) {
 1848:          const int kb0 = max(k, nodes[0]->kb);
 1849:          const int kb1 = max(k, nodes[1]->kb);
 1850:          const int kb2 = max(k, nodes[2]->kb);
 1851: 
 1852:          const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1853:          const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1854:          
 1855:          // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1856:          const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1857:          const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1858:          const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1859: 
 1860:          const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1861:          area3D = 0.5*len;
 1862: 
 1863:          assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1864: 
 1865:          return {nx/len, ny/len, nz/len};
 1866: 
 1867:          
 1868:       }
 1869:       else {  // lat/lon
 1870:          assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1871:          return {0.0, 0.0, 0.0};
 1872: 
 1873:       } // if ics
 1874:    }
 1875:    else {
 1876:       // For quads...
 1877: 
 1878:       assert(false && "Element normal vector: quads not yet implemented");
 1879:       return {0.0, 0.0, 0.0};
 1880: 
 1881: 
 1882:    }
 1883: }
