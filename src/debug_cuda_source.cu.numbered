 1974:    template<typename T>
 1975:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 1976:       T values[4];
 1977:       getNodalValues(level, func, values);
 1978: 
 1979:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1980:       if constexpr (IsVector2<T>::value && ics == 2) {
 1981:          projectNodeVectorsToElementFrame(values);
 1982:       }
 1983: 
 1984:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1985:    }
 1986: 
 1987:    template<typename T>
 1988:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 1989:       T values[4];
 1990:       getNodalValues(field, values);
 1991: 
 1992:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1993:       if constexpr (IsVector2<T>::value && ics == 2) {
 1994:          projectNodeVectorsToElementFrame(values);
 1995:       }
 1996:       
 1997:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1998:    }
 1999: 
 2000: 
 2001:    template<typename T>
 2002:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2003:       T values[4];
 2004:       getNodalValues(level, field, values);
 2005:       
 2006:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2007:       if constexpr (IsVector2<T>::value && ics == 2) {
 2008:          projectNodeVectorsToElementFrame(values);
 2009:       }
 2010: 
 2011:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2012:    }
 2013: 
 2014:    template<typename T>
 2015:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2016:       T values[4];
 2017:       getNodalValues(field, values);
 2018: 
 2019:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2020:       if constexpr (IsVector2<T>::value && ics == 2) {
 2021:          projectNodeVectorsToElementFrame(values);
 2022:       }
 2023: 
 2024:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2025:    }
