 3896: __device__ __inline__ void Node::updateZCoordData(void) {
 3897: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3898: 
 3899:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3900:    // if (isDry2()) {
 3901:    //    kb = -1;  // XXXXXXXX KKKKK
 3902:    //    return;
 3903:    // }
 3904: 
 3905: 
 3906:    if constexpr(ivcor == 2) {  // SZ coordinates
 3907:       
 3908:       // Compute bottom level index
 3909:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3910:    } 
 3911:    else {  // if (ivcor == 1) Localized sigma
 3912:       // Do nothing
 3913:    }
 3914: 
 3915: 
 3916: }
