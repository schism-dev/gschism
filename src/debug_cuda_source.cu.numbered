 2153: __device__ void lock(int *mutex) {
 2154:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2155: }
 2156: 
 2157: __device__ void unlock(int *mutex) {
 2158:     atomicExch(mutex, 0);
 2159: }
