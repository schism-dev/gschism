 2761: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2762: 
 2763: 
 2764: __device__ void Node::updateKb(void) {
 2765: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2766: 
 2767:    if constexpr(ivcor == 1) return;
 2768: 
 2769: 
 2770:    if (isDry2()) return;
 2771: 
 2772:    if constexpr(ivcor == 2) {  // SZ coordinates
 2773:       
 2774:       // Compute bottom level index
 2775:       if (depth <= mesh->h_s) {
 2776:          kb = izlev;
 2777:          
 2778:       } else {
 2779:          kb = -1;
 2780:          int L = 0;
 2781:          int R = nzlev; 
 2782:          
 2783:          while (L <= R) {
 2784:             int M = (R + L) / 2;
 2785: 
 2786: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2787:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2788:             
 2789:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2790:                R = M;
 2791:             } else {
 2792:                L = M;
 2793:             }
 2794: 
 2795:             if (R - L == 1) {
 2796:                kb = L;
 2797:                break;
 2798:             }
 2799:          }
 2800:       }
 2801:    } 
 2802: }
 2803: 
 2804: 
 2805: __device__ __inline__ void Node::updateZCoordData(void) {
 2806: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2807: 
 2808:    if (isDry2()) return;
 2809: 
 2810:    if constexpr(ivcor == 2) {  // SZ coordinates
 2811:       
 2812:       // Compute bottom level index
 2813:       if (depth <= mesh->h_s) {
 2814:             kb = nzlev - 1;
 2815:       } else {
 2816:          kb = -1;
 2817:          for (int i = 0; i < nzlev; i++) {
 2818:             // XXX Use binary search
 2819:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2820:                kb = i;
 2821:                break;
 2822:             }
 2823:          }
 2824:       }
 2825:    } 
 2826:    else if (ivcor == 1) {  // Localized sigma
 2827:       // Do nothing
 2828:    }
 2829: 
 2830: }
 2831: 
 2832: __device__ double Node::compZCoord(int k) const {
 2833:    // Computes the z coordinate at level k.
 2834:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2835:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2836:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2837:    // used 
 2838:    
 2839:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2840: 
 2841:   
 2842:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2843: 
 2844:    if constexpr(ivcor == 2) {
 2845: 
 2846:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2847:       const double h_c = mesh->h_c;
 2848:       const double theta_f = mesh->theta_f;
 2849:       const double sinh_theta_f = mesh->sinh_theta_f;
 2850: 
 2851:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2852:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2853:       // once per time step/node.
 2854:       // CHECK: updateZCoordData
 2855: 
 2856:       //  To simplify comparisons, I define index versions of count variables.
 2857:       if      (k == ivrt)           return eta2; 
 2858:       else if (k == izlev)          return -hmod2;
 2859:       else if (k == kb)             return -depth;
 2860:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2861:       else if (k > izlev) {
 2862:          const int ksig = k - izlev;
 2863: 
 2864:          if (hmod2 <= h_c) {
 2865: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2866:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2867:          } 
 2868:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2869:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2870:             assert(false && "ZCOOR: invalid h_c\n");
 2871:          } 
 2872:          else {
 2873: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2874:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2875:                          h_c * mesh->sigma[ksig] + 
 2876:                          (hmod2 - h_c) * mesh->cs[ksig];
 2877:          }
 2878:       } else { 
 2879:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2880:       }
 2881: 
 2882:    }
 2883:    else if constexpr(ivcor == 1) {
 2884:       if (k == kb) return -depth;
 2885:       else if (k == nvrt-1) return eta2;
 2886:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2887:    }
 2888:    
 2889:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2890:    return 0.0;
 2891: }
 2892: 
 2893: 
 2894: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2895:    // Checks if a side in on the boundary
 2896:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2897: 
 2898:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2899:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2900: 
 2901:    // Indices of the nodes that form the side
 2902:    const int n1 = side.n1->idx;
 2903:    const int n2 = side.n2->idx;
 2904: 
 2905:    // Check if the side is on a land boundary
 2906:    for (int i = 0; i < nland; i++) {
 2907:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2908:          // Consecutive nodes in the land boundary segment
 2909:          const int b1 = ilnd[i*mnlnd + j];
 2910:          const int b2 = ilnd[i*mnlnd + j + 1];
 2911:         
 2912: 
 2913:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2914:             isLand = true;
 2915: printf("ilnd[%d] = %d, ilnd[%d] = %d, n1 = %d, n2 = %d\n", i*mnlnd + j, b1, i*mnlnd + j + 1, b2, n1, n2);             
 2916:             return i;
 2917:          }
 2918:       }
 2919:    }
 2920: 
 2921:    // Check if the side is on an open boundary
 2922:    for (int i = 0; i < nope; i++) {
 2923:       for (int j = 0; j < nond[i] - 1; j++) {
 2924:          // Consecutive nodes in the open boundary segment
 2925:          const int b1 = iond[i*mnond + j];
 2926:          const int b2 = iond[i*mnond + j + 1];
 2927: 
 2928:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2929:             isLand = false;
 2930:             return i;
 2931:          }
 2932:       }
 2933:    }
 2934: 
 2935:    return -1;
 2936: }
 2937: 
 2938: 
 2939: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 2940:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 2941:                                     double *wind_rotate_angle, 
 2942:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2943:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2944:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2945:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 2946:                                     double *drag, double *roughness) {
 2947: 
 2948:    NODE(pnode);  
 2949:    const int i = idx_node;
 2950:    Node &node(*pnode);
 2951: 
 2952:    node.idx = i;
 2953: 
 2954:    const int idxNodeStart = nodeNeighNodesStart[i];
 2955:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2956:    node.numNodes = idxNodeEnd - idxNodeStart;
 2957:    node.nodes = nodeNeighNodes + idxNodeStart;
 2958:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2959: 
 2960: 
 2961: 
 2962:    const int idxElemStart = nodeNeighElemsStart[i];
 2963:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2964:    node.numElements = idxElemEnd - idxElemStart;
 2965:    node.elements = nodeNeighElems + idxElemStart;
 2966: 
 2967:    
 2968:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2969:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2970:       const int partNode = localNodePart[idxNodeGlobal]; 
 2971:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 2972: 
 2973:       Node *node_ptr = nodes[partNode] + idxNode;
 2974:       
 2975:       nodeNeighNodes[idx] = node_ptr;
 2976:    }
 2977: 
 2978: 
 2979:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2980:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2981:       const int partElem = localElemPart[idxElemGlobal];
 2982:       const int idxElem  = localElemIndices[idxElemGlobal];
 2983: 
 2984:       Element *elem_ptr = elems[partElem] + idxElem;
 2985: 
 2986:       nodeNeighElems[idx] = elem_ptr;
 2987:    }      
 2988: 
 2989: // printf("NODE i = %d, node = %p, node.numNodes = %d\n", node.idx, &node, node.numNodes);      
 2990: 
 2991:    node.wind_angle = wind_rotate_angle[i];
 2992: 
 2993: 
 2994:    node.p.x   = node_coords[i * 3];
 2995:    node.p.y   = node_coords[i * 3 + 1];
 2996:    node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2997:    node.depth = node_coords[i * 3 + 2];
 2998: 
 2999:    node.numSides = 0;
 3000: 
 3001:    node.Cd = drag[i];
 3002:    node.rough = roughness[i];
 3003:    
 3004:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3005: 
 3006:    // Links the node to the boundary information
 3007:    if (isbnd[i] >= 0) {
 3008: 
 3009:      
 3010:       // Get the index of the node boundary
 3011:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3012: 
 3013:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3014:       node.nodeBnd->node = &node;
 3015: 
 3016:       node.nodeBnd->sideBnd1 = nullptr;
 3017:       node.nodeBnd->sideBnd2 = nullptr;
 3018: 
 3019:       if (isbnd[i]>=0) {
 3020: 
 3021:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3022:          
 3023:          node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 3024:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3025: 
 3026:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3027:          node.nodeBnd->segment->clen  = nan("1");
 3028:          node.nodeBnd->segment->carea = nan("1");
 3029: 
 3030:       }
 3031: //          else {  XXXXXX
 3032: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3033: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 3034: //          }
 3035:       
 3036: 
 3037:    }
 3038:    else {
 3039: 
 3040:       node.nodeBnd = nullptr; // For internal nodes
 3041: 
 3042:       if (isbnd[i] == landSegment) {
 3043:          node.nodeBnd = &landBoundaryNode;
 3044:          node.nodeBnd->segment = &landBoundarySegment;
 3045:       }
 3046:       // node.nodeBnd->node = &node;
 3047:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3048:       // // node.nodeBnd = nullptr;
 3049:       // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 3050:       
 3051:    }
 3052: 
 3053:    // XXXX GAUSSIAN HILL VELOCITIES
 3054: #ifdef GAUSSIAN_HILL_VELOCITIES
 3055:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3056:       constexpr double rot_per = 3000.0;
 3057:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3058:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3059:    // XXXXX
 3060: #endif
 3061: 
 3062: }
 3063: 
 3064: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3065:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3066:                                     double *wind_rotate_angle,   
 3067:                                     int *isdel, int *isidenode, int *isbnd,
 3068:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3069:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3070:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3071:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3072:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3073:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3074:                                     double *drag, double *roughness) {
 3075: 
 3076: 
 3077:    SIDE(pside);
 3078:    Side &side(*pside);
 3079:    const int i = idx_side;
 3080: 
 3081:    side.idx = i;  
 3082:    
 3083:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3084:    const double fc   = 2.0*omega_e*sin(sfea0);
 3085:    const double beta = 2.0*omega_e*cos(sfea0);
 3086: 
 3087:    // finding the pointer to the nodes that form the side
 3088:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3089:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3090: 
 3091:    const int locidx_n1 = localNodeIndices[idx_n1];
 3092:    const int locidx_n2 = localNodeIndices[idx_n2];
 3093:    const int part_n1 =   localNodePart[idx_n1];
 3094:    const int part_n2 =   localNodePart[idx_n2];
 3095: 
 3096:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3097:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3098: 
 3099:    // Counts the number of sides connected to each node
 3100:    side.n1->numSides++;
 3101:    side.n2->numSides++;
 3102: 
 3103:    // Normal, unitary vector to the side
 3104:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3105:    side.n = normalize(side.n);
 3106: 
 3107:    // Side boundary type
 3108:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3109:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3110: 
 3111:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3112:    // If both nodes are on the boundary, then the side may be on the boundary
 3113:    {
 3114:       bool isLand = false;
 3115:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3116: 
 3117:       assert(isLand || isbs>=0);
 3118:       const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3119: 
 3120:       side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3121:       if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3122:       else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3123: 
 3124:       assert (isLand == side.sideBnd->segment->isLand);
 3125: 
 3126:       // Links each node boundary to the side boundary using the first available side boundary pointer
 3127:       if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3128:       else                            n1bnd->sideBnd2 = side.sideBnd;
 3129: 
 3130:       if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3131:       else                            n2bnd->sideBnd2 = side.sideBnd;
 3132:       
 3133:       side.sideBnd->side = &side;
 3134: 
 3135:       
 3136:    }
 3137:    else 
 3138:    {
 3139:       side.sideBnd = nullptr;
 3140:    }
 3141: 
 3142: 
 3143:    // finding the pointer to the elements that share the side
 3144:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3145:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3146: 
 3147:    if (idx_e1 > -1) {
 3148:       const int locidx_e1 = localElemIndices[idx_e1];
 3149:       const int part_e1 =  localElemPart[idx_e1];
 3150:       side.elems[0] = elems[part_e1] + locidx_e1;
 3151: 
 3152:    }
 3153:    else {
 3154:       side.elems[0] = nullptr;
 3155:    }
 3156: 
 3157:    if (idx_e2 > -1) {
 3158:       const int locidx_e2 = localElemIndices[idx_e2];
 3159:       const int part_e2 =  localElemPart[idx_e2];
 3160:       side.elems[1] = elems[part_e2] + locidx_e2;
 3161:    }
 3162:    else {
 3163:       side.elems[1] = nullptr;
 3164:    }
 3165: 
 3166:    // Compute the center of the side
 3167:    side.center = 0.5*(side.n1->p2() + side.n2->p2());
 3168: 
 3169:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3170:    side.shapiro = shapiro0;
 3171: 
 3172: #ifdef GAUSSIAN_HILL_VELOCITIES
 3173: // XXXX
 3174: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3175: constexpr double rot_per=3000.0;
 3176: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3177: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3178: // XXXXX      
 3179: #endif
 3180:    // Compute the z level at the center of the side
 3181:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3182: 
 3183:    // Compute the length of the side
 3184:    const Vector2 vLen = side.n2->p2() - side.n1->p2();
 3185:    side.len = sqrt(dot(vLen, vLen));
 3186: 
 3187: 
 3188:    // Compute the Coriolis coefficient
 3189: 
 3190:    if constexpr(ncor == -1 || ncor == 0) {
 3191:       side.coriolis = coricoef;
 3192:    }
 3193:    else {
 3194:       const double sphi = side.lat();  // Latitude at the center of the side
 3195: 
 3196:       if constexpr(ics == 1) {
 3197:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3198:       }
 3199:       else {
 3200:          side.coriolis = 2.0*omega_e*sin(sphi);
 3201:       }
 3202:    }
 3203: }
 3204: 
 3205: 
 3206: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3207:    double *node_coords, double *node_coords_ll, bool use_ll,
 3208:    double *wind_rotate_angle,   
 3209:    int *isdel, int *isidenode, int *isbnd,
 3210:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3211:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3212:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3213:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3214:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3215:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3216:    double *drag, double *roughness) {
 3217: 
 3218:    ELEM(pelem);
 3219:    Element &elem(*pelem);
 3220:    const int i = idx_elem;
 3221:    
 3222:    elem.idx = i;
 3223: 
 3224:    for (int j = 0; j < i34[i]; j++) {
 3225:       const int idxNode = elnode[i*4 + j];  
 3226:       const int idxSide = elside[i*4 + j];
 3227:       
 3228:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3229:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3230: 
 3231: 
 3232:       // Find the neighboring element  
 3233:       if (elem.sides[j]->elems[0] == &elem) {
 3234:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3235:       }
 3236:       else {
 3237:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3238:       }
 3239:       
 3240:    }
 3241: 
 3242:    elem.i34 = i34[i];
 3243: 
 3244:    // Compute the centroid of the element and its depth
 3245:    Vector2 center = {0.0, 0.0};
 3246:    elem.depth = 0.0;
 3247:    for (int j = 0; j < i34[i]; j++) {
 3248:       center += elem.nodes[j]->p2()/i34[i];
 3249:       elem.depth  += elem.nodes[j]->p.z/i34[i];
 3250:    }
 3251:    elem.center = center;
 3252: 
 3253:    
 3254:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3255:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3256: 
 3257:    elem.area = elem.computeSignedArea(); 
 3258:    elem.radius = sqrt(elem.area)/pi; 
 3259:    
 3260:    // Determines which way the normal vector to each side is oriented.
 3261:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3262:    for (int j = 0; j < i34[i]; j++)  
 3263:    {
 3264:       if (elem.sides[j]->elems[0] == &elem) {
 3265:          elem.ssign[j] =  1.0;
 3266:       }
 3267:       else {
 3268:          elem.ssign[j] = -1.0;
 3269:       }
 3270: 
 3271:    }
 3272: 
 3273:    // Derivatives of shape functions
 3274:    //  For ics=2, this is done inside element/ll frame XXX
 3275:    //  For quads, the derivative is evaluated at centroid
 3276:    for (int j = 0; j < elem.i34; j++) {
 3277:       const double area = elem.area;
 3278:       const int id2 = elem.nxq(1 + j);
 3279:       const int id3 = elem.nxq(2 + j);
 3280:       const int id4 = elem.nxq(3 + j);
 3281:       if (elem.isTri()) {
 3282:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3283:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3284:          // da1/dx = (y1 - y2)/(2*area)
 3285:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3286:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3287:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3288:       }
 3289:       else  { // Quad; evaluate at centroid
 3290:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3291:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3292:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3293:       } // if Tri
 3294: 
 3295:    } // for j   
 3296:    
 3297:    
 3298: 
 3299: }
 3300: 
 3301: __device__ void Mesh::populateBoundaryNodes(int *nond, 
 3302:                                             double *emo, double *efa, 
 3303:                                             double *umo, double *ufa, 
 3304:                                             double *vmo, double *vfa) {
 3305: 
 3306:    NODE_BND(nodeBnd);
 3307:    const int idx = idx_node_bnd;                                             
 3308: 
 3309:    // Need to compute the segment index and the index of the node on the segment
 3310:    int sumNodes = 0;
 3311:    int iseg;
 3312:    for (iseg = 0; iseg < nope; iseg++) {
 3313:       // for each segment...
 3314:       sumNodes += nond[iseg];
 3315:       if (idx > sumNodes) break;
 3316:    }
 3317:    if (iseg == nope) iseg--;
 3318:    assert(idx <= sumNodes && "idx is out of bounds");
 3319:    sumNodes -= nond[iseg];
 3320: 
 3321:    const int ind  = idx - sumNodes;
 3322: if (idx > 1000) printf("iseg = %d of %d, ind = %d of %d, idx = %d, mesh->nbp = %d\n", iseg, nope, ind, nond[iseg], idx, mesh->nbp);
 3323: 
 3324: 
 3325:    nodeBnd->isEssentialBC = true;
 3326:    nodeBnd->elbc = 0.0;
 3327: 
 3328:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3329: 
 3330:       const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3331:       nodeBnd->efa[jfr] = efa[idx];
 3332:       nodeBnd->emo[jfr] = emo[idx];
 3333:       nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3334:       nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3335: 
 3336:    }
 3337:         
 3338: 
 3339: }
 3340: 
