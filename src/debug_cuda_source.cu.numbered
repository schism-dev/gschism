 3823: 
 3824: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3825: 
 3826: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3827: 
 3828:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3829:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3830: 
 3831:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3832:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3833: 
 3834:    double fun_lat = 0.0;
 3835:    switch (jspc[idxComp]) {
 3836:       case 0:
 3837:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3838:          break;
 3839:       case 1:
 3840:          fun_lat = sin(2.0*lat);
 3841:          break;
 3842:       case 2:
 3843:          fun_lat = pow<2>(cos(lat));
 3844:          break;
 3845:       default:
 3846:          assert(false && "computeETP: invalid jspc");
 3847:    }
 3848:    
 3849:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3850: 
 3851: }
 3852: 
 3853: __device__ void Node::updateKb(void) {
 3854: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3855: 
 3856:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3857: 
 3858: 
 3859:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3860: 
 3861:    if constexpr(ivcor == 2) {  // SZ coordinates
 3862:       
 3863:       // Compute bottom level index
 3864:       if (depth <= mesh->h_s) {
 3865:          kb = izlev;   
 3866:          
 3867:       } else {
 3868:          kb = -1;
 3869:          int L = 0;
 3870:          int R = nzlev; 
 3871:          
 3872:          while (L <= R) {
 3873:             int M = (R + L) / 2;
 3874: 
 3875: 
 3876:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3877:             
 3878:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3879:                R = M;
 3880:             } else {
 3881:                L = M;
 3882:             }
 3883: 
 3884:             if (R - L == 1) {
 3885:                kb = L;
 3886:                break;
 3887:             }
 3888:          }
 3889: 
 3890:          // Checks that the binary search was successful
 3891:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3892:        
 3893:       }
 3894:    } 
 3895: }
