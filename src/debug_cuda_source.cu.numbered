 4306:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4307: 
 4308:       NODE_BND(nodeBnd);
 4309: 
 4310:       Node *node = nodeBnd->node;
 4311: 
 4312:       node->ETP = 0.0;
 4313: 
 4314:       for (int j=0; j<ntip; j++) {
 4315: 
 4316:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4317:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4318:    
 4319:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4320: 
 4321:          if constexpr(iloadtide==1) { // loading tide
 4322:             assert(false && "Loading tide not implemented");
 4323:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4324:          }
 4325:          
 4326:       }
 4327:       
 4328:    }
