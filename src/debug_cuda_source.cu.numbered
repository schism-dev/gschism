 4714: extern "C" {
 4715: 
 4716:    __global__ void scaleGravity(double loadtide_coef) {
 4717: 
 4718: 
 4719:       NODE(node);
 4720: 
 4721:       // SAL option: scale gravity
 4722:       if constexpr(iloadtide==2) {  // simple const
 4723:          node->grav2 = grav*(1.0 - loadtide_coef);
 4724: 
 4725:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4726:         
 4727:           const double depth = max(node->depth, 0.0);
 4728:           const double tmp1 = sqrt(depth);
 4729:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4730:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4731:                              2.6969e-13*depth*depth*depth*tmp1;
 4732:           
 4733:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4734:           
 4735: 
 4736: 
 4737:           node->grav2 = grav*(1.0 - beta_bar);
 4738: 
 4739:       } else {  // iloadtide=0,1
 4740:           node->grav2 = grav;
 4741: 
 4742:       }
 4743: 
 4744:    }
 4745: 
 4746: 
 4747:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4748: 
 4749:       NODE_BND(nodeBnd);
 4750: 
 4751:       Node *node = nodeBnd->node;
 4752: 
 4753:       node->ETP = 0.0;
 4754: 
 4755:       for (int j=0; j<ntip; j++) {
 4756: 
 4757:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4758:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4759:    
 4760:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4761: 
 4762:          if constexpr(iloadtide==1) { // loading tide
 4763:             assert(false && "Loading tide not implemented");
 4764:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4765:          }
 4766:          
 4767:       }
 4768:       
 4769:    }
