 6379: #ifdef DONTCOMPILE
 6380: __device__ void computeVerticalAdvection(void) {
 6381:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6382: 
 6383:    sdbt(1:2,:,:)=0.d0
 6384: 
 6385:    const Side *side = FROM kernel;
 6386: 
 6387:    if(side->isDry) return;
 6388: 
 6389:    // If side is wet...
 6390: 
 6391: 
 6392:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6393:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6394:    double ws[nvrt] = {} // w @ side
 6395:    int icount = 0;
 6396:    for (int j=0; j<2; j++) {
 6397:       const Element *elem = side->elements[j];
 6398:        
 6399:       if(elem != nullptr) {
 6400:          icount++;
 6401:          for (int k=0; k<nvrt; k++) {
 6402:             ws[k] = ws[k] + elem->w[k];
 6403:          }
 6404:       }
 6405:    }  // for j
 6406: 
 6407:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6408:    ws = ws/icount;
 6409: 
 6410:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6411:    // Splines allow for a smooth transition between vertical levels.
 6412:    // Splines have continuity restrictions at the internal knots, but
 6413:    // we have to provide the 1st derivatives at the endpoints.
 6414:    const int kbs = side->kbs; 
 6415:    
 6416:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6417:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6418:    initCubicSpline(kbs, nvrt, side, ws, up)
 6419: 
 6420:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6421:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6422:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6423: 
 6424:    // Total advection (average onto side)
 6425:    const Node *node1 = side->nodes[0];
 6426:    const Node *node2 = side->nodes[1];
 6427:    for (int k=kbs(i); k<nvrt; k++) {
 6428: 
 6429:       if constexpr(ics==1) {
 6430:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6431:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6432:       } else {
 6433:          // XXX IMPLEMENT THIS
 6434:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6435:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6436:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6437:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6438:       }  // if ics
 6439: 
 6440: 
 6441:    }
 6442: }
 6443: #endif
 6444: 
 6445: 
 6446: extern "C" {
 6447:    __global__ void computeElemAverageGhat(void) {
 6448:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6449: 
 6450:       ELEM(elem);
 6451:       
 6452:       elem->ghat1= {0.0, 0.0};  
 6453: 
 6454:       if constexpr(ihydraulics != 0) {
 6455:          if (nhtblocks > 0 && elem->isblock) return;
 6456:       }
 6457: 
 6458:       if (elem->isDry) return;
 6459: 
 6460:       // Wet elements.
 6461:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6462:       // tidal potential, horizontal diffusion, and baroclinic etc
 6463:       // Remember to update both fb and F 
 6464:       // If ics=2, ghat1 are in eframe (ll)
 6465:       // cff1-3: coefficients for 2D/3D
 6466:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6467:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6468:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6469: 
 6470:       double av_cff1 = 0.0;  // av. for cff1
 6471:       double av_cff2 = 0.0;  // av. for cff2
 6472:       double av_cff3 = 0.0;  // av. for cff3
 6473:       double av_df = 0.0;  // av. for H^\alpha / H
 6474:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6475:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6476: 
 6477:       const int i34 = elem->i34;
 6478:       const int kb = elem->kb;
 6479: 
 6480:       for (int j=0; j<i34; j++) {
 6481:          // For each node and side in the element...
 6482: 
 6483:          const Node *node = elem->nodes[j];
 6484:          const Side *side = elem->sides[j];
 6485: 
 6486:          const double chi      = side->chi;
 6487:          const double veg_c2   = side->veg_c2;
 6488:          const double veg_beta = side->veg_beta;
 6489:          const double veg_h    = side->veg_h();
 6490:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6491: 
 6492:          // Node - const in elem
 6493:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6494:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6495: 
 6496:          if (elem->depth >= tip_dp) {
 6497:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6498:          }
 6499: 
 6500:          
 6501:          const double htot  = side->htot2();        // Total depth at the side
 6502:          const double zctr2 = side->zTopCanopy();  
 6503: 
 6504:          double cff1; 
 6505:          double cff2; 
 6506:          double cff3;   
 6507:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6508:          // coefficients applied to 2D/3D case 
 6509:             cff1 = side->hhat/htot;
 6510:             cff2 = 0.0;
 6511:             cff3 = 0.0;
 6512:          } else { //3D
 6513:             //Init for no-veg case
 6514:             cff1 = 1.0;
 6515:             cff2 = 1.0;
 6516:             cff3 = 0.0;
 6517: 
 6518:             if constexpr(iveg != 0) {
 6519:                // Computes coefficients used with vegetation terms G1, G2
 6520:                // cff1, cff3 are used for the first two terms in G1, G2:
 6521:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6522:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6523:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6524:                if(veg_h < 0.99*htot) { // submergent vegetation
 6525:                   cff1=1;
 6526:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6527:                   cff3 = veg_c;
 6528: 
 6529:                } else { // emergent vegetation
 6530:                   cff1 = 1.0/(1.0 + veg_c2);
 6531:                   cff2 = cff1;
 6532:                   cff3 = 0.0;
 6533: 
 6534:                }
 6535:             } // if iveg
 6536:          } //  2D/3D
 6537: 
 6538:          av_cff1 += cff1/i34;
 6539:          av_cff2 += cff2/i34;
 6540:          av_cff3 += cff3/i34;
 6541:          av_cff2_chi += cff2*chi/i34;
 6542:          av_cff3_chi += cff3*chi/i34;
 6543:          av_df += min(htot, veg_h)/(htot*i34);
 6544: 
 6545: 
 6546:          // btrack values: U^\star, U^{\star\alpha}
 6547:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6548:          Vector2 Ustar       = {0.0, 0.0}; 
 6549:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6550: 
 6551:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6552:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6553:          } else { //3D
 6554:             for (int k = side->kb; k < nvrt; k++) {
 6555:             
 6556:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6557:                Ustar += w2;
 6558: 
 6559:                if constexpr(iveg != 0) {
 6560:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6561:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6562:                        Ustar_alpha += zrat*w2; // XXXX
 6563:                    }
 6564:                }  // if iveg
 6565:             }  // for k
 6566:          }  //2D/3D
 6567:          
 6568: 
 6569:          // Add btrack & surface stress terms to \breve{G} first
 6570:          if constexpr(ics==1) {
 6571: 
 6572:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6573: 
 6574:          } else {
 6575:             // XXX IMPLEMENT THIS
 6576:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6577:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6578:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6579:          }  // if ics
 6580: 
 6581:          // Surface and bottom stress terms
 6582:          if constexpr(ics==1) {
 6583:             const Vector2 tau    = side->tau();
 6584:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6585: 
 6586:             // Term for surface and bottom stress
 6587:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6588: 
 6589:          } else {
 6590:             assert(false && "computeElemAverageGhat: Not implemented");
 6591:             // XXX IMPLEMENT THIS
 6592:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6593:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6594:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6595:             // tau_x=(vn1+tt1)/2.d0
 6596:             // tau_y=(vn2+ss1)/2.d0
 6597:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6598:          }  // if ics
 6599: 
 6600:          
 6601: 
 6602:          // All terms in F,F^\alpha,f_b except baroclinic
 6603:          // F, f_b: all explicit terms excluding vegetation 
 6604:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6605:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6606:          const double coriolis = side->coriolis;
 6607:          Vector2 F  =  coriolis*side->U;  // F_x
 6608:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6609:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6610: 
 6611:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6612:             
 6613:             for (int k = side->kb; k < nvrt; k++) {
 6614:                if (zctr2 > side->zc[k-1]) {
 6615:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6616:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6617:                    Fa +=  coriolis*w2*zrat;
 6618:                } // if zctr2
 6619:             } // k
 6620:          } // iveg
 6621: 
 6622:          // Integrate horizontal viscosity force vertically
 6623:          for (int k=side->kb + 1; k<nvrt; k++) {
 6624:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6625: 
 6626:             F += levelHorVisc;
 6627: 
 6628:             // Vegetation term
 6629:             if constexpr(iveg!=0) {
 6630:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6631:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6632:                   Fa += levelHorVisc*zrat;
 6633:                } 
 6634:             } // if iveg
 6635:          } // for k
 6636: 
 6637:          fb += side->nuGradU[side->kb];
 6638: 
 6639:          // Add to ghat1
 6640:          if constexpr(ics==2) {
 6641:             // XXX IMPLEMENT THIS
 6642:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6643:             // bigf1=vn1; bigf2=vn2
 6644:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6645:             // botf1=vn1; botf2=vn2
 6646:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6647:             // bigfa1=vn1; bigfa2=vn2
 6648:          } // if ics
 6649: 
 6650:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6651:       } // for j (nodes and sides)
 6652: 
 6653:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6654:          
 6655:       // Finish off terms in F, F^\alpha and f_b
 6656:       const double grav3 = elem->mean(&Node::grav2);
 6657:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6658: 
 6659: 
 6660:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6661:       for (int j=1; j<i34; j++) { 
 6662:          // For each side in the element...
 6663:          const Side *side = elem->sides[j];
 6664:          const double chi = side->chi;
 6665: 
 6666:          const double htot = side->htot2();
 6667:          const double veg_h = side->veg_h();
 6668:          const Vector2 F  = htot*fb;
 6669:          const Vector2 Fa = min(htot, veg_h)*fb;
 6670: 
 6671:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6672:       } // for j
 6673: 
 6674:       //botf1 etc are already in elem frame
 6675:       elem->ghat1 += tmp/i34;
 6676: 
 6677:       // Baroclinic force
 6678:       if constexpr(ibc==0) {
 6679:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6680: 
 6681:          Vector2 Fa = {0.0, 0.0};
 6682:          Vector2 intGradRho = {0.0, 0.0};
 6683:          
 6684:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6685:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6686:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6687: 
 6688:             // \in F [m^2/s/s]
 6689:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6690:          }
 6691: 
 6692:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6693:          const Vector2 F = av_df*Fa; //approx
 6694:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6695: 
 6696:       } // if ibc
 6697: 
 6698: 
 6699: 
 6700:    }
 6701: 
 6702: } // extern "C"
 6703: 
 6704: 
 6705: 
 6706: #ifdef DONTCOMPILE
 6707: __global__ void checkMassConservation(Tracers* sumtr) {
 6708: 
 6709:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6710: 
 6711:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6712: 
 6713:    Element *elem = &(mesh->localElemData[i]);
 6714: 
 6715:    // Skip dry elements
 6716:    if (elem->isDry) return;
 6717: 
 6718:    // Local sum array for this thread
 6719:    double localSum[N_TRACERS] = {0.0};
 6720: 
 6721:    // Sum over vertical levels for this element
 6722:    const int kbe = elem->kbe;
 6723:    const double area = elem->area;
 6724: 
 6725:    for (int k = kbe; k < nvrt; k++) {
 6726:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6727:       
 6728:       // Accumulate tracer mass
 6729:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6730:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6731:       }
 6732:    }
 6733: 
 6734:    
 6735: 
 6736:    //  This function returns per element sums. A reduction must be done on the host side.
 6737: }
 6738: 
 6739: 
 6740: __global__ void transport(void) {
 6741: 
 6742:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6743: 
 6744:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6745: 
 6746:    Element *elem = &(mesh->localElemData[ie]);
 6747: 
 6748:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6749: 
 6750:                for (int m=0; m<ntr; m++) {
 6751:                   for (int k=kbe(ie); k<nvrt; k++) {
 6752:                      // Calculate each polynomial's weight 
 6753:                      wm=0.d0; sum1=0.d0; 
 6754:                      wm1=0.d0; wm2=0.d0; 
 6755:                      for (int i=0; i<elem->nweno2; i++) {
 6756:                   
 6757:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6758:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6759:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6760:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6761:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6762:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6763:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6764:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6765:                      // -----------------Hu and Shu (1999)'s method----------------
 6766:                      b4=b1+b2+b3
 6767: 
 6768: //Error: add PRODUCTION CPP
 6769: #ifdef DEBUG
 6770:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6771:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6772:                     call parallel_abort(errmsg)
 6773:                   }
 6774: #endif
 6775: 
 6776:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6777:                   // !----test-------------- 
 6778:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6779:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6780:                   // !wm(i)=wm1(i)*wm2(i)
 6781:                   // !---------------------- 
 6782:                   sum1=sum1+wm(i)
 6783:                 } // end for i
 6784: 
 6785:                 wm=wm/sum1
 6786: 
 6787:                 for (int j=0; j<elem->i34; j++) {
 6788: 
 6789:                   const Side *side  = elem->sides[j];
 6790:                   const Node *node1 = side->n1;
 6791:                   const Node *node2 = side->n2;
 6792: 
 6793:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6794:                      trsd=0.d0
 6795:                      for (int kk=0; kk<nquad; kk++) {
 6796:                         for (int i=0; i<elem->nweno2; i++) {
 6797:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6798:                         } // end for i   
 6799:                      } // end for kk
 6800:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6801:                   } // outward flux
 6802:                } // end for j=1,i34(ie) ! side
 6803:             }
 6804:          }
 6805:               
 6806: 
 6807: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6808: //             //   calculate each polynomial's weight 
 6809: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6810: //                 wm=0.d0; sum1=0.d0
 6811: //                 do i=1,nweno1(ie) !for each polynomial
 6812: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6813: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6814: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6815: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6816: //                   wm(i)=b2
 6817: //                   sum1=sum1+b2
 6818: //                   !wm(i)=1.d0
 6819: //                   !sum1=sum1+1.d0
 6820: 
 6821: // // Error: PRODUCTION
 6822: // #ifdef DEBUG
 6823: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6824: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6825: //                     call parallel_abort(errmsg)
 6826: //                   endif
 6827: // #endif
 6828: 
 6829: //                 enddo !i
 6830: //                 wm=wm/sum1 !final weight
 6831: 
 6832:                 for (int j=0; j<elem->i34; j++) { // side
 6833:                   const Side *side = elem->sides[j];
 6834:                   const Node *node1 = side->n1;
 6835:                   const Node *node2 = side->n2;
 6836: 
 6837:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6838:                     trsd=0.d0
 6839:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6840:                       for (int i=0; i<elem->nweno1; i++) {
 6841:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6842:                       }
 6843:                     enddo //kk
 6844:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6845:                   } // outward flux
 6846:                 } // end for j=1,i34(ie) ! side
 6847:               } // end for k; ntr 
 6848: 
 6849:             else !simple upwind method
 6850:               do j=1,i34(ie)
 6851:                 jsj=elside(j,ie)
 6852:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6853:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6854:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6855:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6856:                   endif
 6857:                 enddo  !vertical layers
 6858:               enddo !j=1,i34(ie) ! side
 6859:             endif !order of accuracy
 6860: 
 6861:          //  enddo !ie
 6862: // !$OMP     end do
 6863: 
 6864: // !$OMP     master
 6865: //           !message passing
 6866: //           if (nproc>1) then
 6867: //             !make a copy of side concentrations
 6868: //             trsd_tmp0=trsd_tmp 
 6869: 
 6870: //             !this exchange routine swaps interface concentration between two partitions
 6871: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 6872: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 6873: 
 6874: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 6875: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 6876: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 6877: 
 6878: 
 6879: //             !This obtains final values for interface sides
 6880: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 6881: //       :    endif !nproc>1
 6882: //           !message passing end
 6883: // !$OMP     end master
 6884: // !$OMP     barrier
 6885: 
 6886: 
 6887: // !         Do advection; conc @ dry elem will not be changed
 6888: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 6889: // !$OMP     do reduction(+: h_mass_in)
 6890: //           do i=1,ne
 6891: //             if(idry_e(i)==1) cycle
 6892: 
 6893: 
 6894: // !           Wet elements with 3 wet nodes
 6895: //             do k=kbe(i)+1,nvrt
 6896: 
 6897: 
 6898: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 6899: //               dtb_by_bigv = dtb/bigv
 6900:     
 6901: // !             Advective flux
 6902: //               if (ntd_weno==1 .or. itd_weno==1) then
 6903: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 6904: //               else
 6905: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 6906: //               endif
 6907: 
 6908: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 6909: //               do j=1,i34(i)
 6910: //                 jsj=elside(j,i) !side
 6911: //                 iweno=.true. !use weno reconstruction as default
 6912: //                 iel=ic3(j,i) !neighboring elem
 6913: 
 6914: //                 if(iel/=0) then
 6915: //                   if(idry_e(iel)==1) cycle
 6916: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 6917: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 6918: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 6919: //                     iweno=.false.
 6920: //                   endif
 6921: //                 else !land or open bnd side
 6922: //                   !skip land bnd and outflowing open bnd, 
