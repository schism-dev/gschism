  884: struct Side {
  885: 
  886:    // Geometry information
  887:    int idx;               // Index of the side
  888:    Node *n1, *n2;
  889:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  890: 
  891:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  892:    Vector2 center;        // Location of side center. 
  893:    double zc[nvrt];       // Side center z-coord at each vertical level
  894: 
  895:    Frame frame;
  896: 
  897:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  898:                           // this is nullptr
  899:    
  900:    int kb;                // Bottom index of the side
  901:    bool isDry;            // True if the side is dry
  902:  
  903:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  904: 
  905:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  906: 
  907:    // Physical information
  908:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  909:    double  w2[nvrt];            // Vertical velocity at each vertical level
  910:    Vector2 btu[nvrt];           // Back-tracked velocity
  911:    Vector2 U;                   // Vertically averaged velocity vector  
  912: 
  913:    Vector2 nuGradU[nvrt];          // nu*grad u
  914: 
  915:    Vector2 bcc[nvrt];           // Baroclinic term
  916:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  917: 
  918:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  919:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  920:    Vector2 gradPr;               // Gradient of pressure
  921:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  922: 
  923: 
  924:    double hhat;                 // \breve{H} in notes
  925: 
  926:    double shapiro;
  927: 
  928:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  929: 
  930:    double coriolis;             // Coriolis parameter
  931: 
  932:    // Vegetation parameters
  933:    double veg_c2;
  934:    double veg_beta;
  935: 
  936:    // Bottom drag parameters.
  937:    double chi;
  938:    double chi2;
  939: 
  940:    __inline__ __device__ double x(double t) const;
  941:    __inline__ __device__ double y(double t) const;
  942:    __inline__ __device__ double lon(void) const;
  943:    __inline__ __device__ double lat(void) const;
  944:    __inline__ __device__ Point2 p_t(double t) const;
  945: 
  946:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  947:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  948:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  949:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  950: 
  951:    __inline__ __device__ Side* neigh(int index) const { 
  952:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  953:       assert(index >= 0 && index < 4); 
  954:       assert(elems[0] != nullptr && elems[1] != nullptr);
  955: 
  956:       const int ielem = index & 1;           // 0 or 1
  957:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  958: 
  959:       const Element* elem = elems[ielem];
  960: 
  961:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  962: 
  963:       return elem->sides[elem->nxq(locSideIdx + iside)];
  964: 
  965:    }
  966: 
  967:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  968: 
  969:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  970: 
  971:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  972:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
  973:    __inline__ __device__ int iadv(void) const;
  974: 
  975:    __inline__ __device__ double grav3(void) const;
  976:    
  977:    __inline__ __device__ double eta2(void) const;
  978:    __inline__ __device__ double eta1(void) const;
  979:    __inline__ __device__ double depth(void) const;
  980:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  981:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  982: 
  983:    __inline__ __device__ double dfv(int k) const;
  984: 
  985:    __inline__ __device__ double veg_h(void)  const;
  986:    __inline__ __device__ double veg_nv(void) const;
  987:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  988:    __inline__ __device__ double veg_alpha3D(int k) const;
  989:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  990: 
  991:    __inline__ __device__ double Cd(void) const;
  992: 
  993:    __inline__ __device__ Vector2 tau(void) const;
  994: 
  995:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  996:    
  997: 
  998:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  999:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1000:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1001:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1002:    } 
 1003:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1004:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1005:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1006:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1007: 
 1008:    // Get valid starting element (for backtracking)
 1009:    __inline__ __device__ Element* getStartElement() {
 1010:       return elems[0] ? elems[0] : elems[1];
 1011:    }
 1012: 
 1013:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1014:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1015: 
 1016:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1017: 
 1018:       // Dot product of the negative velocity vector with the side normal vector
 1019:       const double dot_prod1 = -dot(u, n);
 1020: 
 1021:       // Vector from side center to element 0 centroid
 1022:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1023: 
 1024:       // Dot product of the vector with the side normal vector
 1025:       const double dot_prod2 = dot(v2, n);
 1026: 
 1027:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1028:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1029: 
 1030:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1031:       else                           return elems[1];
 1032: 
 1033:  
 1034:    }
 1035: 
 1036:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1037:       // Given an element, returns the other element that shares this side
 1038:       return (elems[0] == elem) ? elems[1] : elems[0];
 1039:    }
 1040: 
 1041:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1042:       // Given a node, returns the other node that shares this side
 1043:       return (n1 == node) ? n2 : n1;
 1044:    }
 1045:  
 1046:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1047: 
 1048: 
 1049: 
 1050: 
 1051: };
