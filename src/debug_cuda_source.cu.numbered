 3965: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3966: 
 3967: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3968: 
 3969:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3970:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3971: 
 3972:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3973:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3974: 
 3975:    double fun_lat = 0.0;
 3976:    switch (jspc[idxComp]) {
 3977:       case 0:
 3978:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3979:          break;
 3980:       case 1:
 3981:          fun_lat = sin(2.0*lat);
 3982:          break;
 3983:       case 2:
 3984:          fun_lat = pow<2>(cos(lat));
 3985:          break;
 3986:       default:
 3987:          assert(false && "computeETP: invalid jspc");
 3988:    }
 3989:    
 3990:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3991: 
 3992: }
 3993: 
 3994: __device__ void Node::updateKb(void) {
 3995: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3996: 
 3997:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3998: 
 3999: 
 4000:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 4001: 
 4002:    if constexpr(ivcor == 2) {  // SZ coordinates
 4003:       
 4004:       // Compute bottom level index
 4005:       if (depth <= mesh->h_s) {
 4006:          kb = izlev;   
 4007:          
 4008:       } else {
 4009:          kb = -1;
 4010:          int L = 0;
 4011:          int R = nzlev; 
 4012:          
 4013:          while (L <= R) {
 4014:             int M = (R + L) / 2;
 4015: 
 4016: 
 4017:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 4018:             
 4019:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 4020:                R = M;
 4021:             } else {
 4022:                L = M;
 4023:             }
 4024: 
 4025:             if (R - L == 1) {
 4026:                kb = L;
 4027:                break;
 4028:             }
 4029:          }
 4030: 
 4031:          // Checks that the binary search was successful
 4032:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 4033:        
 4034:       }
 4035:    } 
 4036: }
