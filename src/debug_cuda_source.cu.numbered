  832:    // ------------------------------------------------------------------------------------------------
  833:    // These are functions that work on all nodes/sides of the element.
  834:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  835:    //
  836:    // An example of how to use these functions is:
  837:    //   
  838:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  839:    // 
  840:    // Where L is the level at which the field is to be interpolated. The field can be either
  841:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  842:    // There are different versions of getNodalValues for each of these cases.
  843: 
  844:    template<typename T>
  845:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
  846: 
  847:    template<typename T>
  848:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
  849:   
  850:    template<typename T>
  851:    __device__ __forceinline__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const;
  852: 
