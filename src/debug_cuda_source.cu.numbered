 1263: struct Node {
 1264: 
 1265:    // Geometry information
 1266:    int idx;        // Index of the node
 1267:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1268:    int numNodes;   // Number of nodes neighbors of this node
 1269: 
 1270:    Element **elements; // Array of pointers to the elements that share this node
 1271:    int numElements;    // Number of elements that share this node
 1272: 
 1273:    int numSides;       // Number of sides that are connected to this node
 1274: 
 1275:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1276:    double gz;          // Global vertical coordinate at the node.
 1277:    Vector2 u2[nvrt];
 1278:    double  w2[nvrt];
 1279:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1280:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1281:    double lon, lat;
 1282:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1283:    double depth;
 1284: 
 1285: #ifdef USE_FRAMES
 1286:    Frame frame;
 1287: #endif
 1288: 
 1289: #ifdef USE_LOCALIZED_SIGMA   
 1290:    double localSigma[nvrt];
 1291: #endif
 1292: 
 1293:    int kb;       // Bottom index of the node
 1294: 
 1295:    bool isDry;     // True if the node is dry
 1296: 
 1297:    int iadv;     // Advection flag
 1298: 
 1299:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1300:                           // this is nullptr
 1301: 
 1302:    TempVar tmp; // Temporary variable to store different types of variables
 1303: 
 1304:    // Physical information
 1305:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1306:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1307: 
 1308:    double rho[nvrt];     // Density
 1309:    double dfv[nvrt];     // Vertical viscosity
 1310: 
 1311:    double eta1; // Elevation at nodes at previous timestep
 1312:    double eta2; // Elevation at nodes at current timestep
 1313: 
 1314:    double ETP;  // Earth Tidal Potential
 1315: 
 1316:    double pr;    // Air pressure
 1317:    double grav2; // Gravity 
 1318:    
 1319:    Vector2 dav;  // Depth averaged velocity
 1320: 
 1321:    Vector2 tau; // Wind stress vector
 1322: 
 1323:    // Vegetation parameters
 1324:    double veg_h;
 1325:    double veg_nv;
 1326:    double veg_di;
 1327:    double veg_Cd;
 1328:    double veg_h_unbent;
 1329:    double veg_di_unbent;
 1330:    double veg_nv_unbent;
 1331:    double veg_alpha_vert_mean;
 1332:    double veg_alpha0;
 1333:    double veg_alpha3D[nvrt];
 1334: 
 1335:    // Bottom drag parameters
 1336:    double Cd;       // Bottom drag coefficient   
 1337: 
 1338:    // These three are mutually exclusive
 1339:    union {
 1340:       double rmanning; // Bottom Manning's coefficient
 1341:       double rough;    // Bottom roughness length
 1342:       double drag;     // Bottom drag coefficient
 1343:    };
 1344:    Vector2 tau_bot; // Bottom stress vector
 1345: 
 1346:    double bdef1; // Bottom deformation at previous timestep
 1347:    double bdef2; // Bottom deformation at current timestep
 1348: 
 1349:    double qel; // RHS
 1350:    double coeffDiag; // Diagonal coefficient of the matrix
 1351:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1352: 
 1353:    double mP; // Search direction for conjugate gradient method
 1354:    double mR; // Residual for conjugate gradient method
 1355:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1356:    double mX; // Solution for conjugate gradient method
 1357: 
 1358:    // Meteorological forcing
 1359:    Vector2 u_air;
 1360:    double p_air;  // XXXX is this the same as pr?
 1361:    double t_air;
 1362:    double q_air;
 1363:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1364: 
 1365:    __device__ void setWind(Vector2 &u) {
 1366:    // Sets the wind vector taking into account the mesh angle
 1367:    
 1368:       const double speed = length(u);
 1369: 
 1370:       // Rotate wind vector to the node frame
 1371:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1372: 
 1373:       // Sets the surface stress vector due to wind.
 1374:       if constexpr(nws == 0) {
 1375:          tau = {0.0, 0.0};
 1376: 
 1377:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1378:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1379: 
 1380:       } else {
 1381: 
 1382:          double dragcoef;
 1383: 
 1384:          if constexpr(iwind_form == -1) {
 1385:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1386:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1387: 
 1388:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1389:             tau = cff*u_air;
 1390:  
 1391:          } else if constexpr(iwind_form == 1) {
 1392:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1393:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1394: 
 1395:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1396:             tau = cff*u_air;
 1397: 
 1398:          } else {
 1399:             tau = {0.0, 0.0};
 1400:          }
 1401:       }
 1402:    }
 1403: 
 1404: 
 1405:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1406: 
 1407:    __device__ double sigmaTransitionDepth(void) const;
 1408: 
 1409:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1410:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1411:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1412:    
 1413:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1414: 
 1415:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1416: 
 1417:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1418:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1419: 
 1420:    __device__ __forceinline__ void clearMatrixRow(void) {
 1421:       // Clear the matrix row for this node
 1422: 
 1423: 
 1424:       coeffDiag = 0.0;
 1425: 
 1426:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1427: 
 1428:    }
 1429: 
 1430:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1431:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1432:       
 1433:       if (node == this) {
 1434:          coeffDiag += value;
 1435:      
 1436:       } else {
 1437:          // Search (linearly)the index of the node in the array of nodes
 1438:          // XXX: This is not efficient, see if we can improve this
 1439:          int i;
 1440:          for (i = 0; i < numNodes; i++) {
 1441:             if (nodes[i] == node) {
 1442:                break;
 1443:             }
 1444:          }
 1445:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1446:          coeffMatrix[i] += value;
 1447:       }
 1448:    }
 1449: 
 1450: 
 1451:    __device__ __inline__ void updateZCoordData(void);
 1452: 
 1453:    __device__ double compZCoord(int k) const;
 1454: 
 1455:    __device__ void updateKb(void);
 1456: 
 1457:    __device__ __forceinline__ void computeBottomDragCd(void);
 1458: 
 1459: 
 1460: 
 1461: };
