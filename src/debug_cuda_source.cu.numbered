 1140: struct Side {
 1141: 
 1142:    // Geometry information
 1143:    int idx;               // Index of the side
 1144:    Node *n1, *n2;
 1145:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
 1146: 
 1147:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
 1148:    Vector2 center;        // Location of side center. 
 1149:    double zc[nvrt];       // Side center z-coord at each vertical level
 1150: 
 1151:    Frame<ics> frame;
 1152:    
 1153:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
 1154:                           // this is nullptr
 1155:    
 1156:    int kb;                // Bottom index of the side
 1157:    bool isDry;            // True if the side is dry
 1158:  
 1159:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1160: 
 1161:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1162: 
 1163:    // Physical information
 1164:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
 1165:    Vector2 btu[nvrt];           // Back-tracked velocity
 1166:    Vector2 U;                   // Vertically averaged velocity vector  
 1167: 
 1168:    Vector2 nuGradU[nvrt];          // nu*grad u
 1169: 
 1170:    Vector2 bcc[nvrt];           // Baroclinic term
 1171:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1172: 
 1173:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1174:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1175:    Vector2 gradPr;               // Gradient of pressure
 1176:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1177: 
 1178: 
 1179:    double hhat;                 // \breve{H} in notes
 1180: 
 1181:    double shapiro;
 1182: 
 1183:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1184: 
 1185:    double coriolis;             // Coriolis parameter
 1186: 
 1187:    // Vegetation parameters
 1188:    double veg_c2;
 1189:    double veg_beta;
 1190: 
 1191:    // Bottom drag parameters.
 1192:    double chi;
 1193:    double chi2;
 1194: 
 1195:    __inline__ __device__ Point2 outputCoords(void) const;
 1196: 
 1197:    __inline__ __device__ double x(double t) const;
 1198:    __inline__ __device__ double y(double t) const;
 1199:    __inline__ __device__ double z(double t) const;
 1200:    __inline__ __device__ double lon(void) const;
 1201:    __inline__ __device__ double lat(void) const;
 1202:    __inline__ __device__ Point2 p2_t(double t) const;
 1203: 
 1204:    __device__ void setFrame(void) {
 1205:       if constexpr(ics == 1) return;
 1206: 
 1207:       double lat, lon;
 1208:       const Point3 p = toPoint3(center, centerZ());
 1209: 
 1210:       // Compute the latitude and longitude of the element center
 1211:       computeLatLon(p, lat, lon);
 1212: 
 1213:       frame.update(lat, lon);        
 1214:    }
 1215:    
 1216: 
 1217:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1218:    // If ics == 2, convert the global point to the local frame of the side
 1219:       
 1220:       if constexpr (ics == 1) {
 1221:          return p;
 1222:       } else {
 1223:          const Point3 c = {center.x, center.y, centerZ()};
 1224:          const Point3 local = frame.G2L(p - c);
 1225:          return local;
 1226:       }
 1227:    }
 1228: 
 1229:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1230:       if constexpr (ics == 1) {
 1231:          return p;
 1232:       } else {
 1233:          const Point3 c = {center.x, center.y, centerZ()};
 1234:          return c + frame.L2G(p);
 1235:       }
 1236:    }
 1237: 
 1238: 
 1239:    __device__ __forceinline__ Vector2 projectToLocalFrame(Vector2 const& v, Frame<ics> const& v_frame) const {
 1240:       if constexpr(ics == 1) return v;
 1241:       else return v_frame.projHorVec(v, frame);
 1242:    }
 1243: 
 1244:    __inline__ __device__ double centerZ(void)      const;
 1245:    __inline__ __device__ Point3 center3D(int k)    const { assert(false); assert(k < nvrt); return {center.x, center.y, zc[k]}; }  // USED??? CONSISTENT?? XXXXX
 1246:    __inline__ __device__ double Dz(int k)          const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1247:    __inline__ __device__ double area(int k)        const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1248:    __inline__ __device__ double areaClamped(int k) const { assert(k < nvrt - 1); return len*(zc[max(k + 1, kb)] - zc[max(k, kb)]); }
 1249: 
 1250:    __inline__ __device__ Side* neigh(int index) const { 
 1251:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1252:       assert(index >= 0 && index < 4); 
 1253:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1254: 
 1255:       const int ielem = index & 1;           // 0 or 1
 1256:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1257: 
 1258:       const Element* elem = elems[ielem];
 1259: 
 1260:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1261: 
 1262:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1263: 
 1264:    }
 1265: 
 1266:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1267: 
 1268:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1269: 
 1270:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1271:    __inline__ __device__ bool isOpenBnd(void) const { return isBnd() && sideBnd->segment->ifltype == 0; } // True if the side is an open boundary side
 1272:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1273:    __inline__ __device__ int iadv(void) const;
 1274: 
 1275:    __inline__ __device__ double grav3(void) const;
 1276:    
 1277:    __inline__ __device__ double eta2(void) const;
 1278:    __inline__ __device__ double eta1(void) const;
 1279:    __inline__ __device__ double w2(int k) const;
 1280:    __inline__ __device__ Vector2 u2Bottom(int dummy = 0) const { return u2[kb]; }  // XXXX dummy argument to satisfy the template in mean()
 1281:    __inline__ __device__ double depth(void) const;
 1282:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1283:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1284: 
 1285:    __inline__ __device__ double dfv(int k) const;
 1286: 
 1287:    __inline__ __device__ double veg_h(void)  const;
 1288:    __inline__ __device__ double veg_nv(void) const;
 1289:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1290:    __inline__ __device__ double veg_alpha3D(int k) const;
 1291:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1292: 
 1293:    __inline__ __device__ double Cd(void) const;
 1294: 
 1295:    __inline__ __device__ Vector2 tau(void) const;
 1296: 
 1297:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1298:    
 1299: 
 1300:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1301:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1302:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1303:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1304:    } 
 1305:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1306:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1307:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1308:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1309: 
 1310:    // Get valid starting element (for backtracking)
 1311:    __inline__ __device__ Element* getStartElement() {
 1312:       return elems[0] ? elems[0] : elems[1];
 1313:    }
 1314: 
 1315:    
 1316:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1317:       // Given an element, returns the other element that shares this side
 1318:       return (elems[0] == elem) ? elems[1] : elems[0];
 1319:    }
 1320: 
 1321:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1322:       // Given a node, returns the other node that shares this side
 1323:       return (n1 == node) ? n2 : n1;
 1324:    }
 1325:  
 1326:    __inline__ __device__ void btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1327: 
 1328: 
 1329: 
 1330: 
 1331: };
