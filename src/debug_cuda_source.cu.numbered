 2592: /**
 2593:  * This method performs backtracking from the side center until a time -dt back in time 
 2594:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2595:  * intermediate point.
 2596:  *
 2597:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2598:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2599:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2600:  * remaining time.
 2601:  * 
 2602:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2603:  * 
 2604:  * @param uuint, vvint, wwint: Velocities at the final point
 2605:  * @param jlev: Level at which the backtracking is performed
 2606:  * @param dt, dtbk: Tracking timesteps
 2607:  * @return: True if the backtracking was successful, false otherwise
 2608:  */
 2609: __inline__ __device__ bool Side::btrack(
 2610:       int jlev,
 2611:       double dt,            // Tracking time
 2612:       double dtbk,          // Tracking timestep
 2613:       Vector3 &u_int        // Velocities at the initial point
 2614: ) const {
 2615: 
 2616:    // Start from side center
 2617:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2618: 
 2619:  
 2620:    double time_rm = dt; // Remaining time
 2621: 
 2622: 
 2623:    // // Initialize outputs XXX
 2624:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2625:    //    sclr[i] = 0.0;
 2626:    // }
 2627: 
 2628: 
 2629:    // Initial velocities
 2630:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2631: 
 2632:    // Find the element that is in the direction opposite to the velocity
 2633:    Element* curElem = findElementTowards(toVector2(u_int));
 2634: 
 2635: 
 2636:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2637:    if (curElem == nullptr) {
 2638:       // Make velocity parallel to the side
 2639:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2640:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2641:       curElem = otherElem(curElem);
 2642:       
 2643:    }
 2644: 
 2645: // Nudges it towards the circumcenter
 2646: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2647: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2648:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2649: const double eps = 9.013e-3;                 
 2650: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2651: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2652: 
 2653: 
 2654: 
 2655:    const int MAX_ITERATIONS = 1000; 
 2656:    Element* nextElem = curElem;
 2657:    int iter = 0;
 2658:    while(true) {
 2659: 
 2660:       // Calculate timestep
 2661:       double dtb = min(dtbk, time_rm);
 2662: 
 2663:       // Next point in the backtracking curve
 2664:       Point3 xt = x0 - dtb*u_int;
 2665:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2666:       assert(found && "Backtracking failed in btrack");
 2667: 
 2668:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2669: 
 2670:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2671:                       // then time_rm needs to be increased by the unused time.
 2672: 
 2673:       // If the velocity is too small, we stop the backtracking
 2674:       const double vmag = length(toVector2(u_int));
 2675:       if (vmag <= velmin_btrack) break;
 2676: 
 2677:       // The current point becomes the next segment's starting point.
 2678:       x0 = xt;
 2679:  
 2680:       curElem = nextElem;
 2681: 
 2682:       iter++;
 2683:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2684:    }
 2685: 
 2686: 
 2687: }
 2688: 
 2689: 
 2690: 
 2691: // /**
 2692: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2693: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2694: 
 2695: //    Inputs:
 2696: //    @param x1, y1: point inside the element
 2697: //    @param x2, y2: other end of the line segment
 2698: 
 2699: //    Outputs:
 2700: //    @param intersectingSide:  side that intersects the line segment
 2701: //    @param nextElement: element that contains the intersection point
 2702: //    @param xIntersect, yIntersect: intersection point  
 2703: 
 2704: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2705: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2706: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
