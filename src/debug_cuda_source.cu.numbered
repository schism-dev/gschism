  328: 
  329: 
  330: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  331:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  332:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  333: }
  334: 
  335: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  336:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  337:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  338: }
  339: 
  340: 
  341: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  342:    x3 = y1*z2 - y2*z1;
  343:    y3 = x2*z1 - x1*z2;
  344:    z3 = x1*y2 - x2*y1;
  345: }
  346: 
  347: 
  348: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  349: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  350: 
  351:    const double radius2 = dot(p, p);
  352:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  353:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  354: 
  355:    rlon = atan2(p.y, p.x); // (-pi,pi]
  356: 
  357:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  358:       rlat = asin(p.z/sqrt(radius2));
  359:    } else {
  360:       rlat = asin(p.z/rearth_pole);
  361:    }
  362:   
  363: }
  364: 
  365: __inline__ __device__ void Error(const char* msg) {
  366:    printf("Error: %s\n", msg);
  367:    assert(false);
  368: }
