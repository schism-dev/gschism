 8606:          *sizeType = sizeof(double);
 8607:          break;
 8608:       case (int)VarCode::kb:
 8609:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8610:          *sizeType = sizeof(int);
 8611:          break;
 8612:       case (int)VarCode::isdry:
 8613:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8614:          *sizeType = sizeof(int);
 8615:          break;         
 8616:       case (int)VarCode::w:
 8617:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8618:          *sizeType = sizeof(double);
 8619:          break;
 8620:       case (int)VarCode::u:
 8621:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8622:          *sizeType = sizeof(Vector2);
 8623:          break;  
 8624:       case (int)VarCode::u_air:
