 4493: 
 4494:    __global__ void scaleGravity(double loadtide_coef) {
 4495: 
 4496: 
 4497:       NODE(node);
 4498: 
 4499:       // SAL option: scale gravity
 4500:       if constexpr(iloadtide==2) {  // simple const
 4501:          node->grav2 = grav*(1.0 - loadtide_coef);
 4502: 
 4503:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4504:         
 4505:           const double depth = max(node->depth, 0.0);
 4506:           const double tmp1 = sqrt(depth);
 4507:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4508:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4509:                              2.6969e-13*depth*depth*depth*tmp1;
 4510:           
 4511:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4512:           
 4513: 
 4514: 
 4515:           node->grav2 = grav*(1.0 - beta_bar);
 4516: 
 4517:       } else {  // iloadtide=0,1
 4518:         node->grav2=grav;
 4519: 
 4520:       }
 4521: 
 4522:    }
 4523: 
