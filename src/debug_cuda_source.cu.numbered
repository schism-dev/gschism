 9264: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9265:    ELEM(elem);
 9266: 
 9267:    switch (varCode) {
 9268:       case (int)VarCode::outputCoords: {
 9269:          const Point2 coords = elem->outputCoords();
 9270:          double *out = (double *)((char *)res + idx_elem * 16);
 9271:          out[0] = coords.x;
 9272:          out[1] = coords.y;
 9273:          break;
 9274:       }
 9275:       case (int)VarCode::FaceIndices: {
 9276:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9277:          for (int j = 0; j < 4; j++)
 9278:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9279:          break;
 9280:       }
 9281:       case (int)VarCode::isdry:
 9282:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9283:          break;
 9284:       case (int)VarCode::w: {
 9285:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9286:          if (k >= 0)
 9287:             out[0] = elem->w[k];
 9288:          else
 9289:             for (int lev = 0; lev < nvrt; lev++)
 9290:                out[lev] = elem->w[lev];
 9291:          break;
 9292:       }
 9293:    }
 9294: }
