 6235:    __global__ void resetBoundaryAreas(void) {
 6236:       // Reset boundary areas and lengths for each segment.
 6237: 
 6238:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6239:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6240:       SIDE_BND(sideBnd);
 6241: 
 6242:       BoundarySegment *segment = sideBnd->segment;
 6243: 
 6244:       segment->carea = 0.0;
 6245:       segment->clen = 0.0;
 6246:  
 6247:    }
 6248: 
 6249:    __global__ void computeBoundaryAreas(void) {
 6250:    // Calculation of cross-section areas and lengths for flow b.c.
 6251: 
 6252:       SIDE_BND(sideBnd);
 6253: 
 6254:       const Side *side = sideBnd->side;
 6255:       BoundarySegment *segment = sideBnd->segment;
 6256: 
 6257:       if (segment->ifltype != 0) {
 6258: 
 6259:          const Node *n1 = side->n1;
 6260:          const Node *n2 = side->n2;
 6261: 
 6262:          const double htot = side->htot2();
 6263: 
 6264:          if (!side->isDry) {
 6265:             atomicAdd(&segment->carea, htot*side->len);
 6266:             atomicAdd(&segment->clen, side->len);
 6267:          }
 6268:       }
 6269: 
 6270:    }
 6271: 
 6272: 
 6273:    __global__ void computeFlowBcVelocities(double time) {
 6274: 
 6275:       SIDE_BND(sideBnd);
 6276: 
 6277:       const Side *side = sideBnd->side;
 6278:  
 6279:       const bool isDry = side->isDry;
 6280:       const bool isLand = sideBnd->segment->isLand;
 6281: 
 6282:    
 6283:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6284: 
 6285:       if (isDry || isLand) return;
 6286: 
 6287:       // For wet sides in open boundaries...
 6288:       const Vector2 n = side->n;
 6289:       const BoundarySegment *segment = sideBnd->segment;
 6290: 
 6291:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6292: 
 6293:       const int ifltype = segment->ifltype;
 6294: 
 6295:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6296:       const Vector2 r_nuth0 = r_uth0*n;
 6297: 
 6298: 
 6299:       if (ifltype == 1 || ifltype == 2) {
 6300:       
 6301:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6302: 
 6303:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6304: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6305:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6306:          
 6307:       } else if (ifltype == -1) { // Flather 1
 6308: 
 6309:          for (int k = 0; k < nvrt; k++) {
 6310: 
 6311:             // uth is the normal vel.; no ramp up
 6312:             const double uth = sideBnd->nuth(k);
 6313:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6314: 
 6315:             sideBnd->ubc[k] += uth*n;
 6316:          }
 6317: 
 6318:       } else if (ifltype == 3 || ifltype == 5) {
 6319:          // vnth0=0 !normal vel.
 6320: 
 6321:          Vector2 r_u1_bar = {0.0, 0.0};
 6322:          // Computes the contribution to the velocity from all tide frequencies
 6323:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6324: 
 6325:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 6326:             const Vector2 umo  = sideBnd->umo(jfr); 
 6327: 
 6328:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6329:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6330:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6331:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6332: 
 6333:          }
 6334: 
 6335: 
 6336:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6337: 
 6338:       } // if (ifltype = 3 || ifltype == 5
 6339: 
 6340: 
 6341: 
 6342:    }
 6343: 
 6344:    __global__ void computeElevationBoundaryConditions(double time) {
 6345:       // Compute elevation essential boundary conditions 
 6346: 
 6347:       NODE_BND(nodeBnd); // Each boundary node.
 6348: 
 6349:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6350: 
 6351:       const Node *node = nodeBnd->node;
 6352:       const BoundarySegment *segment = nodeBnd->segment;
 6353:       const int iettype = segment->iettype;
 6354:       
 6355: 
 6356:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6357:       double eic = 0.0;
 6358:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6359:       else                 eic = 0.0;
 6360: 
 6361:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6362:       const double r_eth = ramp*nodeBnd->eth;
 6363:       double r_eta1_bar = 0.0;
 6364: 
 6365:       // Compute tide elevation
 6366:       if (iettype == 3 || iettype == 5) {   
 6367: 
 6368:          if constexpr(iloadtide==1) { // loading tide
 6369:             assert(false && "Loading tide not implemented");
 6370:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6371:          }
 6372:          
 6373:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6374: 
 6375:             const double efa  = nodeBnd->efa[jfr]; 
 6376:             const double emo  = nodeBnd->emo[jfr]; 
 6377: 
 6378:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6379:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6380:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6381: 
 6382: 
 6383:          } // for jfr
 6384: 
 6385:       } // if iettype
 6386: 
 6387:       switch (iettype) {
 6388:          case 1:
 6389:          case 2:
 6390:          case 4:
 6391:             nodeBnd->elbc = r_eic + r_eth;
 6392:             break;
 6393:          case 3:
 6394:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6395:             break;
 6396:          case 5:
 6397:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6398:             break;
 6399:       } // switch
 6400: 
 6401: 
 6402:       //Add inverse barometric effects
 6403:       if (iettype != 0 && inv_atm_bnd == 1) {
 6404:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6405:       }
 6406: 
 6407:    }
 6408: 
 6409: 
 6410:    __global__ void computeHorizontalViscosity(void) { 
 6411: 
 6412:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6413: 
 6414:       SIDE(side);
 6415: 
 6416:       if (side->isDry) return;
 6417: 
 6418:       for (int k = 0; k < nvrt; k++) {
 6419:          side->nuGradU[k] = {0.0, 0.0};
 6420:       }
 6421: 
 6422:       if constexpr(ihorcon == 1) {
 6423:          for (int k = side->kb; k < nvrt - 1; k++) {
 6424:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6425:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6426:             // By Zhang and Baptista.
 6427: 
 6428:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6429:             // This is a standard discretization of the Laplacian operator.
 6430:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6431:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6432:             // Gamma is hvis_coef0 in the code.
 6433:             // The value of gamma needs to be < 0.5.
 6434: 
 6435:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6436:             // side under consideration in each of the two possible elements that share the side.
 6437:             Vector2 sumU = {0.0, 0.0};
 6438:             for (int l = 0; l < 2; l++) {
 6439:                const Element *elem = side->elems[l];
 6440: 
 6441:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6442: 
 6443:                // Find the local index of the side in the element
 6444:                const int idxSide = elem->sideLocalIdx(side);
 6445: 
 6446:                // Find the two sides that are connected to the side under consideration
 6447:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6448:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6449: 
 6450:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6451: 
 6452:             }
 6453: 
 6454:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6455: 
 6456:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6457:    
 6458:          }
 6459:       }
 6460:       else if constexpr(ihorcon == 2) {
 6461:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6462:       }
 6463: 
 6464: 
 6465:    }
 6466: 
 6467: 
 6468:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6469: 
 6470:       // Set essential boundary conditions 
 6471:       NODE(node); // Each boundary node
 6472:       NodeBoundary *nodeBnd = node->nodeBnd;
 6473:       
 6474:  
 6475:       // Check if this node has essential BC
 6476:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6477: 
 6478:          // Verify BC value is valid
 6479:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6480: 
 6481:        
 6482:          // Set diagonal to 1 and zero off-diagonals
 6483:          for (int j = 0; j <= node->numNodes; j++) {
 6484:                node->coeffRow[j] = 0.0;
 6485:          }
 6486: 
 6487:          *(node->coeffDiag) = 1.0;
 6488: 
 6489: 
 6490:          // Set solution and RHS to BC value
 6491:          node->mX  = nodeBnd->elbc;
 6492:          node->qel = nodeBnd->elbc;
 6493: 
 6494:       } else {
 6495:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6496: 
 6497:          for (int j = 0; j < node->numNodes; j++) {
 6498:                const Node* nbNode = node->nodes[j];
 6499:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6500: 
 6501:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6502:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6503: 
 6504:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6505:                   // Verify neighbor's BC value
 6506:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6507: 
 6508:                   // Subtract contribution to RHS
 6509:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6510:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6511:                }
 6512:          }
 6513: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6514:       }
 6515:    }
 6516: 
