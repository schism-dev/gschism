 2367: 
 2368: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2369: 
 2370:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2371:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2372:    const Node *n1 = side->n1;
 2373:    const Node *n2 = side->n2;
 2374: 
 2375:    bool n1_match = (n1->nodeBnd->segment == segment);
 2376:    bool n2_match = (n2->nodeBnd->segment == segment);
 2377: 
 2378:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2379:    if (n1_match && n2_match) {
 2380:       return 0.5;
 2381:    } else if (n1_match) {
 2382:       return 1.0;
 2383:    } else if (n2_match) {
 2384:       return 0.0;
 2385:    }
 2386: 
 2387:    return 0.0;
 2388: }
 2389: 
 2390: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2391: 
 2392: 
 2393: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2394: 
 2395:    const double w1 = getBoundaryArrayValueWeight();
 2396:    const double w2 = 1.0 - w1;
 2397:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2398:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2399: 
 2400:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2401: }
 2402: 
 2403: 
 2404: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2405:    const double w1 = getBoundaryArrayValueWeight();
 2406:    const double w2 = 1.0 - w1;
 2407:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2408:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2409: 
 2410:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2411: 
 2412: }
 2413: 
 2414: 
 2415: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2416:    // Returns the value of the velocity at the side center
 2417:    const double w1 = getBoundaryArrayValueWeight();
 2418:    const double w2 = 1.0 - w1;
 2419:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2420:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2421: 
 2422:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2423: }
 2424: 
 2425: 
 2426: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2427:    // Returns the value of the normal component of the velocity at the side center
 2428:    const double w1 = getBoundaryArrayValueWeight();
 2429:    const double w2 = 1.0 - w1;
 2430:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2431:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2432: 
 2433:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2434: }
 2435: 
 2436: 
 2437: 
 2438: __inline__ __device__ double  Side::x(double t, bool checkInterval)   const { assert(!checkInterval || (t >= 0.0 && t <= 1.0)); return (1-t)*n1->p.x + t*n2->p.x; }
 2439: __inline__ __device__ double  Side::y(double t, bool checkInterval)   const { assert(!checkInterval || (t >= 0.0 && t <= 1.0)); return (1-t)*n1->p.y + t*n2->p.y; }
 2440: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2441: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2442: __inline__ __device__ Point2  Side::p_t(double t, bool checkInterval) const { return {x(t, checkInterval), y(t, checkInterval)}; }
 2443: __inline__ __device__ Vector3 Side::interpolateCenterVelocityVertically(Point3 xt) const { 
 2444: // Interpolates the side's center vertically at point xt.
 2445: // 
 2446: // The horizontal velocity (u2) is stored at the side center, but the vertical velocity (w) 
 2447: // is stored at the nodes. Since vertical levels vary in space along the side, we use the 
 2448: // parametric position t of xt along the side to determine which vertical levels bracket 
 2449: // xt.z, then interpolate the center velocity between those levels.
 2450: //
 2451: // This is an approximation used only when backtracking slides along a side.
 2452: //
 2453: // @param xt: A point on the side (not necessarily at the center) whose z-coordinate 
 2454: //            determines the vertical interpolation level
 2455: // @return: Interpolated 3D velocity vector (u, v, w) at the side center at the vertical 
 2456: //          level corresponding to xt.z
 2457: 
 2458: 
 2459:    // Convert 2d coordinates to parametric coordinates on the side
 2460:    const double t = dot(toPoint2(xt) - n1->p, t12())/len;
 2461: 
 2462:    // Searches using binary search the vertical level that contains the z-coordinate of the point
 2463:    int L = kb;
 2464:    int R = nvrt - 1;
 2465:    while (R - L > 1) {
 2466:       int M = (L + R) / 2;
 2467:       const double z = (1 - t)*n1->z[M] + t*n2->z[M];
 2468:       if (z < xt.z) L = M;
 2469:       else R = M;
 2470:    }
 2471:    assert(L == R - 1 && "Binary search failed to find the vertical level containing zt");
 2472: 
 2473:    // Interpolates the center velocity at the relative distance of xt.z between the two levels L and R
 2474:    const double z1 = (1 - t)*n1->z[L] + t*n2->z[L];
 2475:    const double z2 = (1 - t)*n1->z[R] + t*n2->z[R];
 2476:    const double weight2 = (xt.z - z1)/(z2 - z1);
 2477:    const double weight1 = 1.0 - weight2;
 2478: 
 2479:    // Interpolate the horizontal velocity
 2480:    const Vector2 u = weight1*u2[L] + weight2*u2[R];
 2481: 
 2482:    // Interpolate the vertical velocity
 2483:    const double w1 = (1 - t)*n1->w2[L] + t*n2->w2[L];
 2484:    const double w2 = (1 - t)*n1->w2[R] + t*n2->w2[R];
 2485:    const double w = weight1*w1 + weight2*w2;
 2486: 
 2487:    return {u.x, u.y, w};
 2488: 
 2489: }
 2490: 
 2491: __forceinline__ __device__ bool Side::containsPoint(Vector2 x) const { 
 2492:    // Check if the point (x,y) is in the side, meaning that it includes points that are close to the side (within geometricEpsilon).
 2493: 
 2494:    const double t = length(x - n1->p)/len; // Parameterization of the point on the side (0 at n1, 1 at n2)
 2495:    return (t >= -2*geometricEpsilon) && (t <= 1.0 + 2*geometricEpsilon) && (abs(relativeSignedDistanceToPoint(x)) <= geometricEpsilon); 
 2496: }
 2497: 
 2498: 
 2499: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2500:    Vector2 grad = {0.0, 0.0};
 2501:    int count = 0;
 2502: 
 2503:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2504: 
 2505:    // First element
 2506:    if (elems[0] != nullptr && condition(elems[0])) {
 2507:       grad += elems[0]->grad2(field);
 2508:       count++;
 2509:    }
 2510: 
 2511:    // Second element
 2512:    if (elems[1] != nullptr && condition(elems[1])) {
 2513:       grad += elems[1]->grad2(field);
 2514:       count++;
 2515:    }
 2516: 
 2517:    if (count > 0) {
 2518:       grad = grad*(1.0/count);
 2519:    }
 2520:    
 2521:    return grad;
 2522: }
 2523: 
 2524: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2525: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2526: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2527: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2528: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2529: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2530: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2531: 
 2532: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2533: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2534: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2535: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2536: 
 2537: 
 2538: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2539: 
 2540: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
