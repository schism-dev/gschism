 2155:    template<typename T>
 2156:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2157:       // Get the values of the field at the nodes of the element
 2158:       res[0] = nodes[0]->*field;
 2159:       res[1] = nodes[1]->*field;
 2160:       res[2] = nodes[2]->*field;
 2161:       if (isQuad()) res[3] = nodes[3]->*field;
 2162:       else          res[3] = T();
 2163:    }
 2164: 
 2165:    template<typename T>
 2166:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2167: 
 2168:       assert(level < nvrt && "Level is out of range");
 2169:       // Get the values of the field at the nodes of the element
 2170:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2171:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2172:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2173:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2174:       else          res[3] = T();
 2175:    }    
 2176: 
 2177:    template<typename T>
 2178:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2179: 
 2180:       assert(level < nvrt && "Level is out of range");
 2181: 
 2182:       // Get the values of the func at the nodes of the element
 2183:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2184:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2185:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2186:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2187:       else          res[3] = T();  // This is 0.0 or a zero vector
 2188: 
 2189:    }      
