 2233:    template<typename T>
 2234:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2235: 
 2236:       T values[4];
 2237: 
 2238: 
 2239:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2240:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2241:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2242:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2243:       else          values[3] = T();
 2244: 
 2245:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2246: 
 2247:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2248:    }
