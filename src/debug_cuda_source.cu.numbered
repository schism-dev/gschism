 1856:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1857:       // Compute the different time ramps used in the code 
 1858:       // This function is performed by just one thread
 1859: 
 1860:       rampbc = 1.0;
 1861:       if constexpr(ibc == 0) {
 1862:          if (drampbc > 0.0) {
 1863:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1864:          } else {
 1865:             rampbc = 1.0;
 1866:          }
 1867:       }
 1868: 
 1869:       if (nws != 0) {
 1870:          if (drampwind > 0.0) {
 1871:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1872:          } else {
 1873:             rampwind = 1.0;
 1874:          }
 1875:       }
 1876: 
 1877:       if (drampwafo > 0.0) {
 1878:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1879:       } else {
 1880:          rampwafo = 1.0;
 1881:       }
 1882: 
 1883:       // For source/sinks
 1884:       if (if_source && dramp_ss > 0.0) {
 1885:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1886:       } else {
 1887:          ramp_ss = 1.0;
 1888:       }
 1889: 
 1890:       if (dramp > 0.0) {
 1891:          ramp = tanh(2.0*time/86400.0/dramp);
 1892:       } else {
 1893:          ramp = 1.0;
 1894:       }
 1895: 
 1896: 
 1897:    }
