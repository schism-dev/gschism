 9605: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 9606: 
 9607:    ELEM(elem);
 9608: 
 9609:    switch (varCode) {
 9610:       case (int)VarCode::outputCoords:
 9611:          const Point2 coords = elem->outputCoords();
 9612:          res[elem->idx*2    ] = coords.x;
 9613:          res[elem->idx*2 + 1] = coords.y;
 9614:          break;
 9615:    }
 9616: }
 9617: 
 9618: 
 9619: extern "C" __global__ void getSideVarFunc(int varCode, double *res) {
 9620: 
 9621:    SIDE(side);
 9622: 
 9623:    switch (varCode) {
 9624:       case (int)VarCode::outputCoords:
 9625:          const Point2 coords = side->outputCoords();
 9626:          res[side->idx*2    ] = coords.x;
 9627:          res[side->idx*2 + 1] = coords.y;
 9628:          break;
 9629:    }
 9630: }
