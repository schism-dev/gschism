 9325: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9326:    Element *elems = mesh->localElemData;
 9327: 
 9328:    *addr = elems;
 9329:    *sizeElement = sizeof(Element);
 9330:    switch (varCode) {
 9331:       case (int)VarCode::z:
 9332:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9333:          *sizeType = sizeof(double);
 9334:          break;
 9335:       case (int)VarCode::x:
 9336:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9337:          *sizeType = sizeof(Vector2);
 9338:          break;
 9339:       case (int)VarCode::gradETP:
 9340:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9341:          *sizeType = sizeof(Vector2);
 9342:          break;
 9343:       case (int)VarCode::area:
 9344:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9345:          *sizeType = sizeof(double);
 9346:          break;
 9347:       case (int)VarCode::depth:
 9348:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9349:          *sizeType = sizeof(double);
 9350:          break;
 9351:       case (int)VarCode::radius:
 9352:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9353:          *sizeType = sizeof(double);
 9354:          break;
 9355:       case (int)VarCode::ghat:
 9356:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9357:          *sizeType = sizeof(Vector2);
 9358:          break;
 9359:       case (int)VarCode::kb:
 9360:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9361:          *sizeType = sizeof(int);
 9362:          break;
 9363:       case (int)VarCode::isdry:
 9364:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9365:          *sizeType = sizeof(int);
 9366:          break;            
 9367:       case (int)VarCode::w:
 9368:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9369:          *sizeType = sizeof(double);
 9370:          break;
 9371:       case (int)VarCode::FaceIndices:
 9372:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9373:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9374:          *sizeType = sizeof(Node);
 9375:          break;
 9376:       default:
 9377:          *offset = -1;
 9378:    }
 9379: }
