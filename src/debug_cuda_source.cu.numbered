 3883:    __global__ void computeFlowBcVelocities(double time) {
 3884: 
 3885:       SIDE_BND(sideBnd);
 3886: 
 3887:       const Side *side = sideBnd->side;
 3888: 
 3889:       const bool isDry = side->isDry;
 3890: 
 3891:       if (isDry) {
 3892:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 3893:          return;
 3894:       }
 3895: 
 3896:       // For wet sides in open boundaries...
 3897:       const Vector2 n = side->n;
 3898:       const BoundarySegment *segment = sideBnd->segment;
 3899:       const int ifltype = segment->ifltype;
 3900: 
 3901:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 3902:       const Vector2 r_nuth0 = r_uth0*n;
 3903: 
 3904:       Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 3905:       Vector2 r_u1_bar = {0.0, 0.0};
 3906: 
 3907:       for (int k = 0; k < nvrt; k++) {
 3908:          if (ifltype == 1 || ifltype == 2) {
 3909:          
 3910:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 3911: 
 3912:             const double unth0 = segment->qthcon*ramp/segment->carea;
 3913:             
 3914:             r_uth = unth0*n;  // This case has no ramp-up
 3915:             
 3916:          } else if (ifltype == -1) { // Flather 1
 3917: 
 3918:             // uth is the normal vel.; no ramp up
 3919:             const double uth = sideBnd->nuth(k);
 3920:             r_uth = uth*n;
 3921:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 3922: 
 3923: 
 3924:          } else if (ifltype == 3 || ifltype == 5) {
 3925:             // vnth0=0 !normal vel.
 3926: 
 3927: 
 3928:             // Computes the contribution to the velocity from all tide frequencies
 3929:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3930: 
 3931:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 3932:                const Vector2 umo  = sideBnd->umo(jfr); 
 3933: 
 3934:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3935:                const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa;
 3936:                r_u1_bar += ramp*ff[jfr]*umo*cos(arg);
 3937:             }
 3938: 
 3939:          } // if (ifltype = 3 || ifltype == 5
 3940: 
 3941: 
 3942:          switch (iettype) {
 3943:             case 1:
 3944:             case 2:
 3945:             case 4:
 3946:                sideBnd->ubc[k] = r_uth;
 3947:                break;
 3948:             case 3:
 3949:                sideBnd->ubc[k] = r_u1_bar;
 3950:                break;
 3951:             case 5:
 3952:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 3953:                break;
 3954:          } // switch
 3955:       } // for k
 3956:    }
 3957: 
 3958:    __global__ void computeElevationBoundaryConditions(double time) {
 3959:       // Compute elevation essential boundary conditions 
 3960: 
 3961:       NODE_BND(nodeBnd); // Each boundary node.
 3962: 
 3963:       const Node *node = nodeBnd->node;
 3964:       const int iettype = nodeBnd->iettype;
 3965: 
 3966:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 3967:       double eic = 0.0;
 3968:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 3969:       else                 eic = 0.0;
 3970: 
 3971:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 3972:       const double r_eth = ramp*nodeBnd->eth;
 3973:       double r_eta1_bar = 0.0;
 3974: 
 3975: 
 3976:       // Compute tide elevation
 3977:       if (iettype == 3 || iettype == 5) {   
 3978: 
 3979:          if constexpr(iloadtide==1) { // loading tide
 3980:             assert(false && "Loading tide not implemented");
 3981:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3982:          }
 3983:          
 3984:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 3985: 
 3986:             const double efa  = nodeBnd->efa[jfr]; 
 3987:             const double emo  = nodeBnd->emo[jfr]; 
 3988: 
 3989:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 3990:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 3991:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 3992: 
 3993:          } // for jfr
 3994: 
 3995:       } // if iettype
 3996: 
 3997:       switch (iettype) {
 3998:          case 1:
 3999:          case 2:
 4000:          case 4:
 4001:             nodeBnd->elbc = r_eic + r_eth;
 4002:             break;
 4003:          case 3:
 4004:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4005:             break;
 4006:          case 5:
 4007:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4008:             break;
 4009:       } // switch
 4010: 
 4011: 
 4012:       //Add inverse barometric effects
 4013:       if (iettype != 0 && inv_atm_bnd == 1) {
 4014:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4015:       }
 4016: printf("++++>> nodeBnd->elbc = %f\n", nodeBnd->elbc);
 4017:    }
 4018: 
 4019: 
 4020:    __global__ void setEssentialBC(void) {
 4021:       // Set essential boundary conditions 
 4022:       NODE(node); // Each boundary node
 4023:       NodeBoundary *nodeBnd = node->nodeBnd;
 4024: printf("node idx = %d, nodeBnd = %p, essentialBC = %d\n", node->idx, nodeBnd, nodeBnd ? nodeBnd->isEssentialBC : -1);
 4025:       
 4026: // nodeBnd->isEssentialBC = true;      
 4027:       // Check if this node has essential BC
 4028:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4029:          // Verify BC value is valid
 4030:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4031: 
 4032:          printf("XX node IDX = %d, nodeBnd->isEssentialBC = %d\n", node->idx, nodeBnd->isEssentialBC);
 4033:          
 4034:          // Set diagonal to 1 and zero off-diagonals
 4035:          node->coeffDiag = 1.0;
 4036:          printf("ZZZZZZZ node->coeffDiag = %16.9f\n", node->coeffDiag);
 4037: 
 4038:          for (int j = 0; j < node->numNodes; j++) {
 4039:                node->coeffMatrix[j] = 0.0;
 4040:                printf("YY node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4041:          }
 4042:          
 4043:          // Set solution and RHS to BC value
 4044:          node->mX  = nodeBnd->elbc;
 4045:          node->qel = nodeBnd->elbc;
 4046: printf("{{{{ node->mX = %f, node->qel = %f\n", node->mX, node->qel);         
 4047:       } else {
 4048:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4049: 
 4050:          for (int j = 0; j < node->numNodes; j++) {
 4051:                Node* nbNode = node->nodes[j];
 4052:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4053:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4054:                   // Verify neighbor's BC value
 4055:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4056: 
 4057:                   // Subtract contribution to RHS
 4058:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4059:                   node->coeffMatrix[j] = 0.0;  
 4060:                   printf("ZZ node->coeffMatrix[%d, %d] = %f\n", node->idx, node->nodes[j]->idx, node->coeffMatrix[j]);
 4061:                }
 4062:          }
 4063:       }
 4064:    }
 4065: 
 4066: 
 4067:    __global__ void updateElevation(void) {
 4068:       NODE(node);
 4069: 
 4070:       node->eta2 = node->mX;
 4071: printf("node[%d]->eta2 = %f, qel = %f\n", node->idx, node->eta2, node->qel);
 4072:    }
