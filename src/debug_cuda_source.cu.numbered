 2457: // /**
 2458: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2459: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2460: 
 2461: //    Inputs:
 2462: //    @param x1, y1: point inside the element
 2463: //    @param x2, y2: other end of the line segment
 2464: 
 2465: //    Outputs:
