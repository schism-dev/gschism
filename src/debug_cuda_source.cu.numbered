 7292: __global__ void printMatrix(void) {
 7293: 
 7294: 
 7295:    // Let only one thread per block print at a time 
 7296: 
 7297:    if (threadIdx.x == 0) {
 7298:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 7299:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 7300:          if (idx_node >= mesh->np) return;
 7301:          const Node *node = mesh->localNodeData + idx_node;
 7302:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7303:          for (int j = 0; j < node->numNodes; j++) {
 7304:             Node* nbNode = node->nodes[j];
 7305:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7306:          }
 7307:          printf("]\n");
 7308: 
 7309:       }
 7310:    }
 7311: 
 7312: 
 7313: 
 7314: }
 7315: 
 7316: 
 7317: __global__ void computeMatrixProductAndDotProducts() {
 7318:    // Computes A*p, r'Mr and p'Ap
 7319: 
 7320:    // 1) shared buffer: first half for rMr, second for pAp
 7321:    __shared__ double sdata[2*BLOCK_SIZE];
 7322:    double* s_rMr = sdata;
 7323:    double* s_pAp = sdata + BLOCK_SIZE;
 7324: 
 7325:    s_rMr[threadIdx.x] = 0.0;
 7326:    s_pAp[threadIdx.x] = 0.0;
 7327: 
 7328:    // 2) get your node pointer
 7329:    NODE(node);  
 7330:    const int tid = threadIdx.x;
 7331: 
 7332:    const double diag = node->coeffDiag;
 7333:    const double r    = node->mR;
 7334:    const double p    = node->mP;  
 7335: 
 7336:    // apply preconditioner on the fly:
 7337:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7338: 
 7339:    // 4) compute Ap = A.p
 7340:    double Ap = node->coeffDiag * node->mP;
 7341:    for (int j = 0; j < node->numNodes; ++j) {
 7342:       const Node *nbNode = node->nodes[j];
 7343:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7344: 
 7345:    }
 7346:    node->mAp = Ap;
 7347:     
 7348: 
 7349:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7350:    const double l_rMr = r*Mr;  // r'Mr
 7351:    const double l_pAp = p*Ap;  // p'Ap
 7352: 
 7353:    // 6) write into shared mem
 7354:    s_rMr[tid] = l_rMr;
 7355:    s_pAp[tid] = l_pAp;
 7356: 
 7357:    __syncthreads();
 7358: 
 7359:    // 7) block-wide tree reduction
 7360:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7361:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7362:       __syncthreads();
 7363:    }
 7364: 
 7365:    // 8) thread 0 atomically accumulates into the globals
 7366:    // XXX: This is slower than it needs to be, but it is simple and works
 7367:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7368: 
 7369: 
 7370: }
 7371: 
 7372: 
 7373: __global__ void updateSolutionAndDotProducts(void) {
 7374:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7375: 
 7376:    s_rMr[threadIdx.x] = 0.0;
 7377: 
 7378: 
 7379:    // get node & bounds-check:
 7380:    NODE(node);
 7381:    const int tid = threadIdx.x;
 7382: 
 7383: 
 7384:    // Compute alpha
 7385:    const double alpha = (*rMr_old)/(*pAp);
 7386: 
 7387:    // load scalars
 7388:    const double diag = node->coeffDiag;
 7389:    const double p    = node->mP;
 7390:    const double Ap   = node->mAp;
 7391:    const double x    = node->mX;
 7392:    const double r    = node->mR;
 7393:    
 7394:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7395: 
 7396:    // 1) update solution & residual
 7397:    const double x_new = x + alpha*p;
 7398:    const double r_new = r - alpha*Ap;
 7399:    node->mX = x_new;
 7400:    node->mR = r_new;
 7401: 
 7402:    // 2) apply Jacobi preconditioner on the fly
 7403:    const double Mr_new = r_new/diag;
 7404: 
 7405: 
 7406:    // 3) local contributions for the two dot-products
 7407:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7408: 
 7409:    // 4) write into shared-mem
 7410:    s_rMr[tid] = l_rMr;
 7411: 
 7412:    __syncthreads();
 7413: 
 7414: 
 7415:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7416:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7417:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7418:       __syncthreads();
 7419:    }
 7420: 
 7421:    // 6) thread 0 atomically folds into the global accumulators
 7422:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7423: 
 7424: 
 7425: }
 7426: 
 7427: 
 7428: __global__ void updateSearchDirection() {
 7429:     NODE(node);
 7430: 
 7431:     // recompute z on-the-fly
 7432:     const double z = node->mR / node->coeffDiag;
 7433:     const double p = node->mP;
 7434: 
 7435:     const double beta = (*rMr_new)/(*rMr_old);
 7436: 
 7437: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7438: 
 7439:     // p =z + beta*p
 7440:     node->mP = z + beta*p;
 7441: 
 7442: }
 7443: 
 7444: __global__ void initializePreconditionedResidual(double *scalars) {
 7445: 
 7446:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7447: 
 7448:     s_rMr[threadIdx.x] = 0.0;
 7449: 
 7450:     NODE(node);
 7451:     const int tid = threadIdx.x;
 7452:     // For the first iteration:
 7453:     // 1. Initial solution x = 0 (already set)
 7454:     // 2. Initial residual r = b (stored in qel)
 7455:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7456: 
 7457: // XXX we should use the guess solution here    
 7458: 
 7459:     // Set initial residual r = b (from qel)
 7460:     node->mR = node->qel;
 7461: 
 7462:     // Compute z = M^-1 * r (preconditioned residual)
 7463:     const double z = node->mR / node->coeffDiag;
 7464: 
 7465:     // Set initial search direction p = z
 7466:     node->mP = z;
 7467: 
 7468:     // Initialize other variables needed for CG
 7469:     node->mX = 0.0;  // Initial solution
 7470:     node->mAp = 0.0; // Will be computed in first iteration
 7471: 
 7472:     // These point to a cupy array in the host code
 7473:     rMr_old = scalars + 0;
 7474:     rMr_new = scalars + 1;
 7475:     pAp     = scalars + 2;
 7476: 
 7477:     // Computes the first r'Mr (reduction)
 7478:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7479: 
 7480:     // 4) write into shared-mem
 7481:     s_rMr[tid] = l_rMr;
 7482: 
 7483:     __syncthreads();
 7484: 
 7485: 
 7486:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7487:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7488:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7489:         __syncthreads();
 7490:     }
 7491: 
 7492:     // 6) thread 0 atomically folds into the global accumulators
 7493:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7494: 
 7495:     *rMr_old = 0.0;
 7496:     *pAp = 0.0;
 7497: }
 7498: 
 7499: 
 7500: 
