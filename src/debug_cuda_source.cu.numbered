 4851: 
 4852:    __global__ void rollUpElevation(void) {
 4853: 
 4854:       NODE(node);
 4855: 
 4856:       node->eta1 = node->eta2;
 4857: 
 4858:    }
 4859: 
 4860: 
 4861:    __global__ void backtrackAllNodes(void) {
 4862: 
 4863:       // max/min # of sub-divisions
 4864:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4865:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4866: 
 4867:       SIDE(side);
 4868: 
 4869:       const int kb = side->kb;
 4870: 
 4871: 
 4872:       // Initialize btrack velocities to the actual velocities at the side 
 4873:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4874:   
 4875: 
 4876:       if (side->isDry) return;
 4877:      
 4878: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4879: 
 4880:       // Checks that at least one element is not dry
 4881:       const Element *elem1 = side->elems[0];
 4882:       const Element *elem2 = side->elems[1];
 4883: 
 4884: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4885: 
 4886:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4887:       
 4888:       // XXXXXX
 4889:       // !swild_tmp to store global coord. of the starting side
 4890:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4891:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4892:       // !Use sframe2 
 4893:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4894: 
 4895: 
 4896:       for (int k = kb; k < nvrt; k++) {
 4897:       //  Initialize (xt,yt,zt), nnel and vel.
 4898:       //  For ics=2, the coordinates are all in the side's local frame
 4899:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4900: 
 4901:          const int iadvf = side->iadv();  // Advection flag   
 4902:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4903: 
 4904:          const double vmag2 = norm2(side->u2[k]);
 4905: 
 4906:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4907:             // No activity 
 4908: 
 4909:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4910: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4911: 
 4912:             
 4913:          } else {  // do btrack
 4914: 
 4915:             // Compute number of sub-divisions based on local gradients of the velocity field
 4916: 
 4917:             // XXX IS THIS NECESSARY?
 4918:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4919:             double suma = 0.0;
 4920:             int icount = 0;
 4921:             for (int l=0; l<2; l++) {
 4922:             // For each element sharing the side...
 4923: 
 4924:                const Element *elem = side->elems[l];
 4925:                  
 4926:                if (elem == nullptr) continue;
 4927: 
 4928:                icount++;
 4929: 
 4930:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4931:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4932:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4933: 
 4934:                double utmp[4];
 4935:                double vtmp[4];
 4936:                for (int j = 0; j < elem->i34; j++) {
 4937: 
 4938:                   const Node *node = elem->nodes[j];
 4939: 
 4940:                   if constexpr(ics==1) {
 4941:                      utmp[j] = node->u2[k].x;
 4942:                      vtmp[j] = node->u2[k].y;  
 4943: 
 4944:                   } else {
 4945:                      // 'Project' the velocity from the node frame to the element frame
 4946:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4947:                      utmp[j] = tmp_u2.x;
 4948:                      vtmp[j] = tmp_u2.y;
 4949: 
 4950:                   }
 4951:                } // for j
 4952: 
 4953:                const Vector2 grad_u = elem->grad2(utmp); 
 4954:                const Vector2 grad_v = elem->grad2(vtmp);
 4955:    
 4956:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4957:             } // for ii
 4958: 
 4959:             assert(icount > 0 && "Impossible 77");
 4960: 
 4961:             // '4' is somewhat arbitrary
 4962:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4963: 
 4964:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4965:             Vector3 u_int = {0.0, 0.0, 0.0};
 4966: 
 4967:             side->btrack(k, dt, dtbk, u_int);
 4968: 
 4969: 
 4970:             side->btu[k] = {u_int.x, u_int.y};
 4971:                
 4972:          } // if vmag (do backtrack)
 4973: 
 4974: 
 4975:       } // for k=kb,nvrt-1
 4976: 
 4977:    }
 4978: 
 4979: } // extern "C"
 4980: 
 4981: template<int nc>
 4982: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4983: 
 4984: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4985: //
 4986: // a,b,c,rhs: input vectors and are not modified by this program.
 4987: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4988: // rhs is the r.h.s.
 4989: // n: actual rank of the system.
 4990: // rows in u() and rhs();
 4991: // u: output with nc columns (transposed to rows)
 4992: // gam: a working array.
 4993: //
 4994: // NOTES:
 4995: // This is a template function that allows for different numbers of columns in the rhs vector.
 4996: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4997: 
 4998:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4999:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 5000: 
 5001:    double bet = b[0];
 5002:    if constexpr (nc == 1) {
 5003:       u[0] = rhs[0]/bet;
 5004:    } else {
 5005:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 5006:    }
 5007: 
 5008:    for (int j = 1; j < n; j++) {
 5009:       gam[j] = c[j - 1]/bet;
 5010:       bet = b[j] - a[j]*gam[j];
 5011: 
 5012:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 5013: 
 5014:       if constexpr (nc == 1) {
 5015:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 5016:       } else {
 5017:          for (int l = 0; l < nc; l++) {
 5018:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 5019:          }
 5020:       }
 5021:    }
 5022: 
 5023:    // Back-substitution
 5024:    for (int j = n - 2; j >= 0; j--) {
 5025:       if constexpr (nc == 1) {
 5026:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5027:       } else {
 5028:          for (int l = 0; l < nc; l++) {
 5029:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5030:          }
 5031:       }
 5032:    }
 5033: }
 5034: 
 5035: 
 5036: 
 5037: // Helper function that contains the core algorithm
 5038: template<typename XAccessor, typename YAccessor>
 5039: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5040:                                     double  yp_top, double  yp_bot, 
 5041:                                     CubicSpline &spline) {
 5042:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5043:    // 
 5044:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5045:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5046:    //
 5047:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5048:    // 
 5049:    // Inputs: 
 5050:    //            n: dimension for x etc; # of data pts (>=2);
 5051:    //            getX, getY: functions to access x,y coordinates
 5052:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5053:    //     Output: 
 5054:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5055: 
 5056:    const int n = k2 - k1 + 1;
 5057:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5058: 
 5059:    // Allocate memory for the splines
 5060:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5061:    spline.x   = new double[n];
 5062:    spline.y   = new double[n];
 5063:    spline.yp  = new double[n];
 5064:    spline.ypp = new double[n];
 5065: 
 5066:    for (int k=k1; k<=k2; k++) {
 5067:       spline.x[k] = getX(k);
 5068:       spline.y[k] = getY(k);
 5069:    }
 5070: 
 5071:    // This is to simplify expressions later
 5072:    double *x = spline.x;
 5073:    double *y = spline.y;
 5074: 
 5075:    double *a = nullptr;
 5076:    double *b = nullptr;
 5077:    double *c = nullptr;
 5078:    double *gam = nullptr;
 5079:    double *rhs = nullptr;
 5080:    
 5081: 
 5082:       a = new double[n];   // Lower diagonal
 5083:       b = new double[n];   // Diagonal
 5084:       c = new double[n];   // Upper diagonal
 5085:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5086:       rhs = new double[n]; // Right-hand side
 5087: 
 5088:    for (int k=k1; k<=k2; k++) {
 5089:       if (k == k1) {
 5090:          // Bottom level
 5091:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5092:          b[k] = (x[k+1] - x[k])/3.0;
 5093:          c[k] = b[k]/2.0;
 5094:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5095:       } else if (k == n - 1) {
 5096:          // Top level (surface)
 5097:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5098:          b[k] = (x[k] - x[k-1])/3.0;
 5099:          a[k] = b[k]/2.0;
 5100:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5101:       } else {
 5102:          // Intermediate levels
 5103:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5104:          b[k] = (x[k+1] - x[k-1])/3.0;
 5105:          a[k] = (x[k  ] - x[k-1])/6.0;
 5106:          c[k] = (x[k+1] - x[k  ])/6.0;
 5107:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5108:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5109:       }
 5110:    }
 5111: 
 5112:    // Solve the tridiagonal system
 5113:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5114:    
 5115:    spline.yp[k1] = yp_bot;
 5116:    spline.yp[k2] = yp_top;
 5117: 
 5118:    // Compute rest of 1st derivatives using the splines
 5119:    for (int k=k1+1; k<k2; k++) {
 5120:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5121:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5122:    }
 5123:    
 5124:    delete[] a;
 5125:    delete[] b;
 5126:    delete[] c;
 5127:    delete[] gam;
 5128:    delete[] rhs;
 5129: 
 5130: }
 5131: 
 5132: // Array version
 5133: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5134:                                 double y_top, double y_bot, 
 5135:                                 CubicSpline &spline) {
 5136:    auto getX = [x] (int k) { return x[k]; };
 5137:    auto getY = [y] (int k) { return y[k]; };
 5138:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5139: }
 5140: 
 5141: // Lambda version - allows custom access patterns
 5142: template<typename XFunc, typename YFunc>
 5143: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5144:                                 double y_top, double y_bot,
 5145:                                 CubicSpline &spline) {
 5146:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5147: }
 5148: 
 5149: 
 5150: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5151: {
 5152:    assert("Not implemented");
 5153: 
 5154:    return 0.0;
 5155: }
