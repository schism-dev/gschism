 6921: #ifdef DONTCOMPILE
 6922: __device__ void computeVerticalAdvection(void) {
 6923:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6924: 
 6925:    sdbt(1:2,:,:)=0.d0
 6926: 
 6927:    const Side *side = FROM kernel;
 6928: 
 6929:    if(side->isDry) return;
 6930: 
 6931:    // If side is wet...
 6932: 
 6933: 
 6934:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6935:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6936:    double ws[nvrt] = {} // w @ side
 6937:    int icount = 0;
 6938:    for (int j=0; j<2; j++) {
 6939:       const Element *elem = side->elements[j];
 6940:        
 6941:       if(elem != nullptr) {
 6942:          icount++;
 6943:          for (int k=0; k<nvrt; k++) {
 6944:             ws[k] = ws[k] + elem->w[k];
 6945:          }
 6946:       }
 6947:    }  // for j
 6948: 
 6949:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6950:    ws = ws/icount;
 6951: 
 6952:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6953:    // Splines allow for a smooth transition between vertical levels.
 6954:    // Splines have continuity restrictions at the internal knots, but
 6955:    // we have to provide the 1st derivatives at the endpoints.
 6956:    const int kbs = side->kbs; 
 6957:    
 6958:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6959:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6960:    initCubicSpline(kbs, nvrt, side, ws, up)
 6961: 
 6962:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6963:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6964:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6965: 
 6966:    // Total advection (average onto side)
 6967:    const Node *node1 = side->nodes[0];
 6968:    const Node *node2 = side->nodes[1];
 6969:    for (int k=kbs(i); k<nvrt; k++) {
 6970: 
 6971:       if constexpr(ics==1) {
 6972:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6973:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6974:       } else {
 6975:          // XXX IMPLEMENT THIS
 6976:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6977:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6978:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6979:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6980:       }  // if ics
 6981: 
 6982: 
 6983:    }
 6984: }
 6985: #endif
 6986: 
 6987: 
 6988: extern "C" {
 6989:    __global__ void computeElemAverageGhat(void) {
 6990:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6991: 
 6992:       ELEM(elem);
 6993:       
 6994:       elem->ghat1= {0.0, 0.0};  
 6995: 
 6996:       if constexpr(ihydraulics != 0) {
 6997:          if (nhtblocks > 0 && elem->isblock) return;
 6998:       }
 6999: 
 7000:       if (elem->isDry) return;
 7001: 
 7002:       // Wet elements.
 7003:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7004:       // tidal potential, horizontal diffusion, and baroclinic etc
 7005:       // Remember to update both fb and F 
 7006:       // If ics=2, ghat1 are in eframe (ll)
 7007:       // cff1-3: coefficients for 2D/3D
 7008:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7009:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7010:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7011: 
 7012:       double av_cff1 = 0.0;  // av. for cff1
 7013:       double av_cff2 = 0.0;  // av. for cff2
 7014:       double av_cff3 = 0.0;  // av. for cff3
 7015:       double av_df = 0.0;  // av. for H^\alpha / H
 7016:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7017:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7018: 
 7019:       const int i34 = elem->i34;
 7020:       const int kb = elem->kb;
 7021: 
 7022:       for (int j=0; j<i34; j++) {
 7023:          // For each node and side in the element...
 7024: 
 7025:          const Node *node = elem->nodes[j];
 7026:          const Side *side = elem->sides[j];
 7027: 
 7028:          const double chi      = side->chi;
 7029:          const double veg_c2   = side->veg_c2;
 7030:          const double veg_beta = side->veg_beta;
 7031:          const double veg_h    = side->veg_h();
 7032:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7033: 
 7034:          // Node - const in elem
 7035:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7036:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7037: 
 7038:          if (elem->depth >= tip_dp) {
 7039:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7040:          }
 7041: 
 7042:          
 7043:          const double htot  = side->htot2();        // Total depth at the side
 7044:          const double zctr2 = side->zTopCanopy();  
 7045: 
 7046:          double cff1; 
 7047:          double cff2; 
 7048:          double cff3;   
 7049:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7050:          // coefficients applied to 2D/3D case 
 7051:             cff1 = side->hhat/htot;
 7052:             cff2 = 0.0;
 7053:             cff3 = 0.0;
 7054:          } else { //3D
 7055:             //Init for no-veg case
 7056:             cff1 = 1.0;
 7057:             cff2 = 1.0;
 7058:             cff3 = 0.0;
 7059: 
 7060:             if constexpr(iveg != 0) {
 7061:                // Computes coefficients used with vegetation terms G1, G2
 7062:                // cff1, cff3 are used for the first two terms in G1, G2:
 7063:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7064:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7065:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7066:                if(veg_h < 0.99*htot) { // submergent vegetation
 7067:                   cff1=1;
 7068:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7069:                   cff3 = veg_c;
 7070: 
 7071:                } else { // emergent vegetation
 7072:                   cff1 = 1.0/(1.0 + veg_c2);
 7073:                   cff2 = cff1;
 7074:                   cff3 = 0.0;
 7075: 
 7076:                }
 7077:             } // if iveg
 7078:          } //  2D/3D
 7079: 
 7080:          av_cff1 += cff1/i34;
 7081:          av_cff2 += cff2/i34;
 7082:          av_cff3 += cff3/i34;
 7083:          av_cff2_chi += cff2*chi/i34;
 7084:          av_cff3_chi += cff3*chi/i34;
 7085:          av_df += min(htot, veg_h)/(htot*i34);
 7086: 
 7087: 
 7088:          // btrack values: U^\star, U^{\star\alpha}
 7089:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7090:          Vector2 Ustar       = {0.0, 0.0}; 
 7091:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7092: 
 7093:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7094:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7095:          } else { //3D
 7096:             for (int k = side->kb; k < nvrt; k++) {
 7097:             
 7098:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7099:                Ustar += w2;
 7100: 
 7101:                if constexpr(iveg != 0) {
 7102:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7103:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7104:                        Ustar_alpha += zrat*w2; // XXXX
 7105:                    }
 7106:                }  // if iveg
 7107:             }  // for k
 7108:          }  //2D/3D
 7109:          
 7110: 
 7111:          // Add btrack & surface stress terms to \breve{G} first
 7112:          if constexpr(ics==1) {
 7113: 
 7114:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7115: 
 7116:          } else {
 7117:             // XXX IMPLEMENT THIS
 7118:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7119:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7120:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7121:          }  // if ics
 7122: 
 7123:          // Surface and bottom stress terms
 7124:          if constexpr(ics==1) {
 7125:             const Vector2 tau    = side->tau();
 7126:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7127: 
 7128:             // Term for surface and bottom stress
 7129:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7130: 
 7131:          } else {
 7132:             assert(false && "computeElemAverageGhat: Not implemented");
 7133:             // XXX IMPLEMENT THIS
 7134:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7135:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7136:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7137:             // tau_x=(vn1+tt1)/2.d0
 7138:             // tau_y=(vn2+ss1)/2.d0
 7139:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7140:          }  // if ics
 7141: 
 7142:          
 7143: 
 7144:          // All terms in F,F^\alpha,f_b except baroclinic
 7145:          // F, f_b: all explicit terms excluding vegetation 
 7146:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7147:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7148:          const double coriolis = side->coriolis;
 7149:          Vector2 F  =  coriolis*side->U;  // F_x
 7150:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7151:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7152: 
 7153:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7154:             
 7155:             for (int k = side->kb; k < nvrt; k++) {
 7156:                if (zctr2 > side->zc[k-1]) {
 7157:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7158:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7159:                    Fa +=  coriolis*w2*zrat;
 7160:                } // if zctr2
 7161:             } // k
 7162:          } // iveg
 7163: 
 7164:          // Integrate horizontal viscosity force vertically
 7165:          for (int k=side->kb + 1; k<nvrt; k++) {
 7166:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7167: 
 7168:             F += levelHorVisc;
 7169: 
 7170:             // Vegetation term
 7171:             if constexpr(iveg!=0) {
 7172:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7173:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7174:                   Fa += levelHorVisc*zrat;
 7175:                } 
 7176:             } // if iveg
 7177:          } // for k
 7178: 
 7179:          fb += side->nuGradU[side->kb];
 7180: 
 7181:          // Add to ghat1
 7182:          if constexpr(ics==2) {
 7183:             // XXX IMPLEMENT THIS
 7184:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7185:             // bigf1=vn1; bigf2=vn2
 7186:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7187:             // botf1=vn1; botf2=vn2
 7188:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7189:             // bigfa1=vn1; bigfa2=vn2
 7190:          } // if ics
 7191: 
 7192:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7193:       } // for j (nodes and sides)
 7194: 
 7195:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7196:          
 7197:       // Finish off terms in F, F^\alpha and f_b
 7198:       const double grav3 = elem->mean(&Node::grav2);
 7199:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7200: 
 7201: 
 7202:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7203:       for (int j=1; j<i34; j++) { 
 7204:          // For each side in the element...
 7205:          const Side *side = elem->sides[j];
 7206:          const double chi = side->chi;
 7207: 
 7208:          const double htot = side->htot2();
 7209:          const double veg_h = side->veg_h();
 7210:          const Vector2 F  = htot*fb;
 7211:          const Vector2 Fa = min(htot, veg_h)*fb;
 7212: 
 7213:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7214:       } // for j
 7215: 
 7216:       //botf1 etc are already in elem frame
 7217:       elem->ghat1 += tmp/i34;
 7218: 
 7219:       // Baroclinic force
 7220:       if constexpr(ibc==0) {
 7221:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7222: 
 7223:          Vector2 Fa = {0.0, 0.0};
 7224:          Vector2 intGradRho = {0.0, 0.0};
 7225:          
 7226:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7227:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7228:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7229: 
 7230:             // \in F [m^2/s/s]
 7231:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7232:          }
 7233: 
 7234:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7235:          const Vector2 F = av_df*Fa; //approx
 7236:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7237: 
 7238:       } // if ibc
 7239: 
 7240: 
 7241: 
 7242:    }
 7243: 
 7244: } // extern "C"
 7245: 
 7246: 
 7247: 
 7248: #ifdef DONTCOMPILE
 7249: __global__ void checkMassConservation(Tracers* sumtr) {
 7250: 
 7251:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7252: 
 7253:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7254: 
 7255:    Element *elem = &(mesh->localElemData[i]);
 7256: 
 7257:    // Skip dry elements
 7258:    if (elem->isDry) return;
 7259: 
 7260:    // Local sum array for this thread
 7261:    double localSum[N_TRACERS] = {0.0};
 7262: 
 7263:    // Sum over vertical levels for this element
 7264:    const int kbe = elem->kbe;
 7265:    const double area = elem->area;
 7266: 
 7267:    for (int k = kbe; k < nvrt; k++) {
 7268:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7269:       
 7270:       // Accumulate tracer mass
 7271:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7272:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7273:       }
 7274:    }
 7275: 
 7276:    //  This function returns per element sums. A reduction must be done on the host side.
 7277: }
 7278: 
 7279: 
 7280: __global__ void transport(void) {
 7281: 
 7282:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7283: 
 7284:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7285: 
 7286:    Element *elem = &(mesh->localElemData[ie]);
 7287: 
 7288:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7289: 
 7290:                for (int m=0; m<ntr; m++) {
 7291:                   for (int k=kbe(ie); k<nvrt; k++) {
 7292:                      // Calculate each polynomial's weight 
 7293:                      wm=0.d0; sum1=0.d0; 
 7294:                      wm1=0.d0; wm2=0.d0; 
 7295:                      for (int i=0; i<elem->nweno2; i++) {
 7296:                   
 7297:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7298:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7299:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7300:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7301:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7302:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7303:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7304:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7305:                      // -----------------Hu and Shu (1999)'s method----------------
 7306:                      b4=b1+b2+b3
 7307: 
 7308: //Error: add PRODUCTION CPP
 7309: #ifdef DEBUG
 7310:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7311:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7312:                     call parallel_abort(errmsg)
 7313:                   }
 7314: #endif
 7315: 
 7316:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7317:                   // !----test-------------- 
 7318:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7319:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7320:                   // !wm(i)=wm1(i)*wm2(i)
 7321:                   // !---------------------- 
 7322:                   sum1=sum1+wm(i)
 7323:                 } // end for i
 7324: 
 7325:                 wm=wm/sum1
 7326: 
 7327:                 for (int j=0; j<elem->i34; j++) {
 7328: 
 7329:                   const Side *side  = elem->sides[j];
 7330:                   const Node *node1 = side->n1;
 7331:                   const Node *node2 = side->n2;
 7332: 
 7333:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7334:                      trsd=0.d0
 7335:                      for (int kk=0; kk<nquad; kk++) {
 7336:                         for (int i=0; i<elem->nweno2; i++) {
 7337:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7338:                         } // end for i   
 7339:                      } // end for kk
 7340:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7341:                   } // outward flux
 7342:                } // end for j=1,i34(ie) ! side
 7343:             }
 7344:          }
 7345:               
 7346: 
 7347: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7348: //             //   calculate each polynomial's weight 
 7349: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7350: //                 wm=0.d0; sum1=0.d0
 7351: //                 do i=1,nweno1(ie) !for each polynomial
 7352: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7353: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7354: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7355: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7356: //                   wm(i)=b2
 7357: //                   sum1=sum1+b2
 7358: //                   !wm(i)=1.d0
 7359: //                   !sum1=sum1+1.d0
 7360: 
 7361: // // Error: PRODUCTION
 7362: // #ifdef DEBUG
 7363: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7364: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7365: //                     call parallel_abort(errmsg)
 7366: //                   endif
 7367: // #endif
 7368: 
 7369: //                 enddo !i
 7370: //                 wm=wm/sum1 !final weight
 7371: 
 7372:                 for (int j=0; j<elem->i34; j++) { // side
 7373:                   const Side *side = elem->sides[j];
 7374:                   const Node *node1 = side->n1;
 7375:                   const Node *node2 = side->n2;
 7376: 
 7377:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7378:                     trsd=0.d0
 7379:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7380:                       for (int i=0; i<elem->nweno1; i++) {
 7381:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7382:                       }
 7383:                     enddo //kk
 7384:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7385:                   } // outward flux
 7386:                 } // end for j=1,i34(ie) ! side
 7387:               } // end for k; ntr 
 7388: 
 7389:             else !simple upwind method
 7390:               do j=1,i34(ie)
 7391:                 jsj=elside(j,ie)
 7392:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7393:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7394:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7395:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7396:                   endif
 7397:                 enddo  !vertical layers
 7398:               enddo !j=1,i34(ie) ! side
 7399:             endif !order of accuracy
 7400: 
 7401:          //  enddo !ie
 7402: // !$OMP     end do
 7403: 
 7404: // !$OMP     master
 7405: //           !message passing
 7406: //           if (nproc>1) then
 7407: //             !make a copy of side concentrations
 7408: //             trsd_tmp0=trsd_tmp 
 7409: 
 7410: //             !this exchange routine swaps interface concentration between two partitions
 7411: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7412: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7413: 
 7414: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7415: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7416: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7417: 
 7418: 
 7419: //             !This obtains final values for interface sides
 7420: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7421: //       :    endif !nproc>1
 7422: //           !message passing end
 7423: // !$OMP     end master
 7424: // !$OMP     barrier
 7425: 
 7426: 
 7427: // !         Do advection; conc @ dry elem will not be changed
 7428: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7429: // !$OMP     do reduction(+: h_mass_in)
 7430: //           do i=1,ne
 7431: //             if(idry_e(i)==1) cycle
 7432: 
 7433: 
 7434: // !           Wet elements with 3 wet nodes
 7435: //             do k=kbe(i)+1,nvrt
 7436: 
 7437: 
 7438: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7439: //               dtb_by_bigv = dtb/bigv
 7440:     
 7441: // !             Advective flux
 7442: //               if (ntd_weno==1 .or. itd_weno==1) then
 7443: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7444: //               else
 7445: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7446: //               endif
 7447: 
 7448: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7449: //               do j=1,i34(i)
 7450: //                 jsj=elside(j,i) !side
 7451: //                 iweno=.true. !use weno reconstruction as default
 7452: //                 iel=ic3(j,i) !neighboring elem
 7453: 
 7454: //                 if(iel/=0) then
 7455: //                   if(idry_e(iel)==1) cycle
 7456: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7457: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7458: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7459: //                     iweno=.false.
 7460: //                   endif
 7461: //                 else !land or open bnd side
 7462: //                   !skip land bnd and outflowing open bnd, 
 7463: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7464: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7465: //                     !For outflow open bnd side, estimate mass in (open
 7466: //                     !side cannot be interface side)
 7467: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7468: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7469: //                     endif
 7470: 
 7471: //                     cycle
 7472: //                   endif
 7473: 
 7474: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7475: //                   iweno=.false.  !reset to upwind
 7476: //                   ibnd=isbs(jsj) !global bnd #
 7477: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7478: //                   nwild(1:2)=0
 7479: //                   do ll=1,2 !nodes
 7480: //                     ndo=isidenode(ll,jsj)
 7481: //                     do lll=1,2 !2 possible bnds
 7482: //                       if(isbnd(lll,ndo)==ibnd) then
 7483: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7484: //                         exit
 7485: //                       endif
 7486: //                     enddo !lll
 7487: //                   enddo !ll
 7488: //                   ind1=nwild(1); ind2=nwild(2);
 7489: 
 7490: //                   do jj=1,natrm
 7491: //                     if(ntrs(jj)<=0) cycle
 7492: 
 7493: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7494: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7495: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7496: //                       enddo !ll
 7497: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7498: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7499: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7500: //                       enddo !ll
 7501: //                     else if(itrtype(jj,ibnd)==3) then
 7502: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7503: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7504: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7505: //                       enddo !ll
 7506: //                     else if(itrtype(jj,ibnd)==4) then
 7507: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7508: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7509: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7510: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7511: //                       enddo !ll
 7512: //                     else
 7513: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7514: //   !'
