 2287: 
 2288: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2289:    // Returns the value of the velocity at the side center
 2290:    const double w1 = getBoundaryArrayValueWeight();
 2291:    const double w2 = 1.0 - w1;
 2292:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2293:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2294: 
 2295:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2296: }
 2297: 
 2298: 
 2299: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2300:    // Returns the value of the normal component of the velocity at the side center
 2301:    const double w1 = getBoundaryArrayValueWeight();
 2302:    const double w2 = 1.0 - w1;
 2303:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2304:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2305: 
 2306:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2307: }
