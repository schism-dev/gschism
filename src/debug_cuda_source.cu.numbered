 2500:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2501:    // Project the vectors from the node frame to the element frame
 2502: 
 2503:  
 2504:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2505:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2506:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2507:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2508:       else          v[3] = Vector2();
 2509:    }
 2510: 
 2511:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2512:    // Project the vectors from the side frame to the element frame
 2513: 
 2514:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2515:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2516:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2517:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2518:       else          v[3] = Vector2();
 2519:    }
