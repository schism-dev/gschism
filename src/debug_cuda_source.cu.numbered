 1415: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1416:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1417: }
 1418: 
 1419: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1420:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1421: }   
 1422: 
 1423: __device__ __inline__ double min3(double a, double b, double c) {
 1424:    return min(a, min(b, c));
 1425: }
 1426: 
 1427: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1428:    return min(a, min(b, min(c, d)));
 1429: }
