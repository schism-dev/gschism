  503: 
  504: // Polynomial class
  505: template<int grade>
  506: struct Polynomial {
  507:     // Static assertion to give a clear error message at compile time
  508:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  509: };
  510: 
  511: 
  512: // Explicit specialization for grade 4
  513: template<>
  514: struct Polynomial<4> {
  515:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  516: 
  517:    // Constructor from coefficients
  518:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  519: 
  520:    __device__ __forceinline__ double eval(double x) const {
  521:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  522:    }
  523: };
  524: 
  525: // ------------------------------------------------------------------------------------------------
  526: 
  527: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  528:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  529:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  530: }
  531: 
  532: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  533:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  534:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  535: }
  536: 
  537: 
  538: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  539:    x3 = y1*z2 - y2*z1;
  540:    y3 = x2*z1 - x1*z2;
  541:    z3 = x1*y2 - x2*y1;
  542: // XXXXXX IS THIS REPEATED????
  543: }
  544: 
  545: 
  546: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  547: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  548: //
  549: 
  550:    const double radius2 = dot(p, p);
  551:    const double radius = sqrt(radius2);
  552:  
  553:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  554:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  555: 
  556:    rlon = atan2(p.y, p.x); // (-pi,pi]
  557: 
  558:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  559:       rlat = asin(p.z/radius);
  560:    } else {
  561:       rlat = asin(p.z/rearth_pole);
  562:    }
  563:   
  564: }
  565: 
  566: 
  567: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  568: // Compute the 3D Cartesian coordinates from the latitude and longitude
  569: // Inputs:
  570: //        lat: latitude in radians
  571: //        lon: longitude in radians
  572: // Output:
  573: //        x, y, z: 3D Cartesian coordinates
  574: 
  575:    double sin_lat, cos_lat, sin_lon, cos_lon;
  576: 
  577:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  578:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  579: 
  580:    sincos(lat, &sin_lat, &cos_lat);
  581:    sincos(lon, &sin_lon, &cos_lon);
  582: 
  583:    const double x = rearth_eq*cos_lat*cos_lon;
  584:    const double y = rearth_eq*cos_lat*sin_lon;
  585:    const double z = rearth_pole*sin_lat;
  586: 
  587:    return make_double3(x, y, z);
  588: }
  589: 
  590: __inline__ __device__ void Error(const char* msg) {
  591:    printf("Error: %s\n", msg);
  592:    assert(false);
  593: }
