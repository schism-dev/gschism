 7139: __global__ void printMatrix(bool full) {
 7140:    // Debugging: print the matrix
 7141: 
 7142:    const int size = mesh->np;
 7143:    double sum = 0.0;
 7144:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7145:       const Node *node = mesh->localNodeData + idx_node;
 7146:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7147:       for (int j = 0; j < node->numNodes; j++) {
 7148:          Node* nbNode = node->nodes[j];
 7149:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7150:          sum += node->coeffMatrix[j];
 7151:       }
 7152:       if (full) printf("]\n");
 7153: 
 7154: 
 7155:    }
 7156:    if (!full) printf("sum=%lf\n", sum);
 7157: }
