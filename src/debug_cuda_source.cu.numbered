 7187: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7188:    // Get the value of a variable from an element
 7189:    // varName is the name of the variable to get
 7190:    // var is the array to store the value
 7191:    // k is the vertical level index of the variable to get
 7192: 
 7193:    ELEM(elem);
 7194:    
 7195:    int idx = elem->idx;
 7196:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7197: 
 7198:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7199:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7200:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7201:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7202:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7203:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7204:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7205:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7206:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7207:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7208:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7209:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7210:       
 7211:    
 7212: }
 7213: 
 7214: 
 7215: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7216:    // Get the value of a variable from an node
 7217:    // varName is the name of the variable to get
 7218:    // var is the array to store the value
 7219:    // k is the vertical level index of the variable to get
 7220: 
 7221:    NODE(node);
 7222:    
 7223:    int idx = node->idx;
 7224:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7225: 
 7226:    printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7227:    
 7228:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7229:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7230:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7231:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7232:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7233:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7234:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7235:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7236:       
 7237:    
 7238: }
 7239: 
 7240: 
 7241: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7242:    // Get the value of a variable from an side
 7243:    // varName is the name of the variable to get
 7244:    // var is the array to store the value
 7245:    // k is the vertical level index of the variable to get
 7246:    SIDE(side);
 7247:    
 7248:    int idx = side->idx;
 7249:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7250: 
 7251:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7252:    
 7253:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7254:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7255:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7256:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7257:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7258:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7259:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7260:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7261:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7262:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7263:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7264:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7265:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7266:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7267:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth[k].x:0.0;
 7268:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth[k].y:0.0;
 7269:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7270: }
