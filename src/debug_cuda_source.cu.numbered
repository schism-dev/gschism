 4791:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4792: 
 4793:       SIDE(side);
 4794: 
 4795: 
 4796:       side->U = {0.0, 0.0}; 
 4797:          
 4798:       if(side->isDry) return;
 4799: 
 4800:       const Node *node1 = side->n1;
 4801:       const Node *node2 = side->n2;
 4802: 
 4803:       // Vertically integrated velocity U (in ll if ics=2)
 4804:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4805:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4806:       }
 4807: 
 4808:    }
 4809: 
 4810:    __global__ void computeBottomDragVegetation(void) {
 4811:       // UNFINISHED. CHECK THIS:
 4812:       // How many kernels are needed? Why so many for loops?
 4813:       // Is the loop on sides needed?
 4814: 
 4815:       NODE(node);
 4816: 
 4817: 
 4818:       const int    kb      = node->kb;
 4819:       const double htot    = node->htot2(); 
 4820:       
 4821:       if (node->isDry) {
 4822:          // Default values for dry nodes
 4823:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4824:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4825: 
 4826:          return;
 4827:        
 4828:       }
 4829: 
 4830:       // Computes bottom drag Cd based on the selected nchi
 4831:       node->computeBottomDragCd();
 4832:       
 4833: 
 4834: 
 4835:       //   Bottom stress in m^2/s^2
 4836:       if (node->rho[kb + 1] >= -98.0)
 4837:       {
 4838:          const double mag_u = length(node->u2[kb + 1]);
 4839:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4840: 
 4841:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4842:          // !sediment erosion: this part needs more documentation
 4843:       }
 4844:     
 4845: 
 4846: 
 4847:       // Compute vegetation parameters
 4848:       //--------------------------------
 4849: 
 4850:       // SAV constants
 4851:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4852:       constexpr double veg_cfpsi = 0.16;
 4853: 
 4854:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4855:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4856: 
 4857:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4858:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4859:          int kbin = 0; // bin index
 4860:          for (int k = kb; k < nvrt; k++) {
 4861:             // Computes node height above the bottom level
 4862:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4863:             assert(false && "Vertical variation of vegetation not implemented");
 4864: 
 4865:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4866:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4867:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4868:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4869:             // } else {
 4870:             //    // Find the bin at which the current vertical level is
 4871:             //    while (kbin<nbins_veg_vert) {
 4872:             //       const double zn = node->z[kbin];
 4873:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4874:             //          break;
 4875:             //       } // if
 4876:             //       kbin++;
 4877:             //    } // while
 4878:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4879: 
 4880:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4881:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4882:                
 4883:             //    // Linear interpolation of the vegetation parameters
 4884:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4885:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4886:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4887:             // } // if rl10
 4888: 
 4889:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4890: 
 4891:          } // for k
 4892: 
 4893: 
 4894:       } else { // Ganthy (iveg==2)
 4895:       //  Modify canopy height, diameter, and density
 4896: 
 4897:          // Make sure there is vegetation on this node
 4898:          if (node->veg_h_unbent > 0.0) {
 4899:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4900: 
 4901:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4902:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4903:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4904: 
 4905:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4906:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4907:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4908:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4909:          } // if veg_h_unbent
 4910: 
 4911:          for (int k = 0; k < nvrt; k++) {
 4912:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4913:          } // for k
 4914:       
 4915: 
 4916:       } // if iveg
 4917:      
 4918: 
 4919:       // Compute vertical mean of veg_alpha3D
 4920:       if (iveg != 0) {
 4921:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4922:          double sum1=0.0;
 4923:          double sum2=0.0;
 4924:          // Integrate over each level under the canopy...
 4925:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4926:             const double Dz = node->Dz(k);
 4927: 
 4928:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4929:             sum2 += Dz;
 4930: 
 4931:          } // for k
 4932:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4933:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4934: 
 4935:       } // if iveg
 4936: 
 4937:    }
 4938: 
 4939:    __global__ void computeVegetationAndDragParameters(void) {
 4940:       // Computes the vegetation and drag model parameters:
 4941:       // chi, \tilde\chi, beta, \breve{H}
 4942:       
 4943:       SIDE(side);
 4944: 
 4945:       if (side->isDry) return;
 4946: 
 4947:       const double htot = side->htot2();
 4948:       const int    kb   = side->kb;
 4949: 
 4950:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4951: 
 4952:       const double veg_h     = side->veg_h();
 4953:       const double veg_nv    = side->veg_nv();
 4954:       const double veg_c     = side->veg_c();
 4955:       const double veg_beta  = side->veg_beta;
 4956:       const double veg_alpha = side->veg_alpha_vert_mean();
 4957: 
 4958:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4959:       // Velocity magnitude at the bottom level
 4960:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4961:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4962:       side->chi2 = side->Cd()*vmag1;
 4963:       side->chi  = side->chi2;
 4964:       if constexpr(iveg != 0) {
 4965:          const Node *n1 = side->n1;
 4966:          const Node *n2 = side->n2;
 4967:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4968:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4969:       }
 4970: 
 4971:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4972: 
 4973:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4974:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4975:       double magUa = 0.0;
 4976:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4977:          // 3D wet side with veg...
 4978: 
 4979:          double magUa = 0.0;
 4980:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4981:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4982: 
 4983:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4984:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4985:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4986: 
 4987:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4988:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4989: 
 4990:                // Velocity magnitude at the bottom (l) of the level
 4991:                const double ul = length(side->u2[k]);
 4992: 
 4993:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4994:                magUa += Dz*0.5*(uh + ul);
 4995: 
 4996:             } // if HasVegetation
 4997:          } // for k
 4998:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4999: 
 5000:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5001:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5002:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5003:             const double zCpy = side->zTopCanopy();
 5004:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5005:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5006:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5007:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5008:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5009:          } // if isSubmerged
 5010:       } // if iveg   
 5011: 
 5012:       // Computes the friction modified depth, \breve{H} in notes
 5013:       if (side->is2D()) { // 2D
 5014: 
 5015:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5016:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5017: 
 5018:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5019: 
 5020:          side->hhat = htot*htot/fricH; 
 5021: 
 5022:       } else { // 3D
 5023:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5024: 
 5025:          if constexpr(iveg != 0) {
 5026:             
 5027:             if (side->isSubmerged()) { 
 5028:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5029:                side->hhat -= veg_c*Hhat_alpha;
 5030: 
 5031:             } else { // Emergent
 5032:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5033:             }
 5034:          } // if iveg
 5035: 
 5036:          // Enforce positivity for 3D model
 5037:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5038:       } // if 3D
 5039: 
 5040:    }
 5041: 
 5042: 
 5043: 
 5044:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5045:    // Computes the density gradient between two elements, e1 and e2.
 5046:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5047:    // zero in the direction normal to the side. 
 5048:    // 
 5049:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5050:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5051:    //
 5052:    // Input:
 5053:    //    e1: Element
 5054:    //    e2: Neighbor element (or nullptr if boundary)
 5055:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5056:    //    k: Index of the half-level at which the density is interpolated
 5057:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5058:    // 
 5059:    // Output:
 5060:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5061:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5062: 
 5063:       if (e2 == nullptr || e2->isDry) {
 5064:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5065: 
 5066:          Side *side = e1->sides[j];
 5067:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5068:                  
 5069:          if constexpr(ics == 1) {
 5070:             vec = side->n; // Normal vector to the side
 5071:          } else {
 5072:             // IMPLEMENT THIS XXXXXX
 5073:             // !replace with xel, yel?
 5074:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5075:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5076:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5077:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5078:          } //ics
 5079:                    
 5080:          diffRho = 0.0;
 5081: 
 5082:       } else { //internal and wet
 5083:          if constexpr(ics==1) {
 5084:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5085: 
 5086:             // Vector from e1 to e2
 5087:             vec = e2->center - e1->center;
 5088: 
 5089:          } else { 
 5090:             // IMPLEMENT THIS XXXXXX
 5091:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5092:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5093:             //                   alow(j)=xctr2
 5094:             //                   bdia(j)=yctr2
 5095:          } // ics
 5096: 
 5097:          diffRho = rho2 - e1->demeanedDensity(k);
 5098:       }
 5099: 
 5100:    }
 5101: 
 5102:    __global__ void computeDensityCubicSplines(void) {
 5103:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5104: 
 5105:       ELEM(elem);
 5106: 
 5107:       if (elem->isDry) return;
 5108: 
 5109:       const int kb = elem->kb;
 5110: 
 5111:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5112:       if (elem->is2D()) {
 5113:          // In the 2D case, the density is constant at the prism level. 
 5114:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5115:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5116:       } else { //3D
 5117: 
 5118:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5119:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5120:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5121:          ///// XXXX CHECK INDICES!!!!!
 5122:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5123:       } // 2D/3D
 5124: 
 5125:    }
 5126: } // extern "C"
 5127: 
 5128: 
 5129: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5130: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5131: 
 5132:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5133: 
 5134:    const int kb  = elem->kb;
 5135:    const int kb2 = elem2->kb;
 5136: 
 5137:    // z-coordinate of prism of elem
 5138:    const double zp = elem->z_prism(k);
 5139: 
 5140:    double rho = 0.0;
 5141: 
 5142:    if (elem2->is2D()) {
 5143:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5144: 
 5145:    } else {  // 3D
 5146: 
 5147:       // eta_min may be < zmax
 5148:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5149:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5150: 
 5151:       // (Extrapolate density below bottom, we will fix it later)
 5152:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5153:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5154:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5155:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5156:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5157:    } // 2D/3D
 5158:      
 5159: 
 5160:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5161:    // Now we need to fix it.
 5162:    if (elem->z[k] < elem2->z[kb2]) {
 5163:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5164: 
 5165:       // There are two methods to adjust the density at the bottom of the element.
 5166:       // iunder_deep=0: 
 5167:       const double depth1 = abs(elem->z[kb]); // larger depth
 5168: 
 5169:       if (iunder_deep==0) {
 5170: 
 5171:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5172: 
 5173:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5174: 
 5175:       } else { // iunder_deep != 0
 5176: 
 5177:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5178: 
 5179:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5180: 
 5181:          //   Demeaned density at the same z coordinate as
 5182:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5183:          }
 5184: 
 5185:       } // if iunder_deep
 5186:    } // if elem->z[kb] < elem2->z[kb]
 5187: 
 5188:    return rho;
 5189: }
 5190: 
 5191: 
 5192: extern "C" {
 5193:    __global__ void computeDensityGradient(void) {
 5194: 
 5195:       if constexpr(ibc != 0) return;
 5196: 
 5197:          // Compute the horizontal density gradient at each element.
 5198:       // It works in two steps:
 5199:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5200:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5201:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5202:       //             gradRho.r1 = rho1 - rho0
 5203:       //             gradRho.r2 = rho2 - rho0
 5204:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5205:       // 
 5206:       //  NOTE: We use de-meaned densities.
 5207: 
 5208:       ELEM(elem);
 5209: 
 5210:       if (elem->isDry) return;
 5211: 
 5212:       const int kb  = elem->kb;
 5213:       const int i34 = elem->i34;
 5214: 
 5215:       for (int k = kb + 1; k < nvrt; k++) {
 5216:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5217:          //             gradRho.r1 = rho1 - rho0
 5218:          //             gradRho.r2 = rho2 - rho0
 5219:          int icount = 0;
 5220:          double sumRx = 0.0;
 5221:          double sumRy = 0.0;
 5222:          for (int j1=0; j1<i34; j1++) { 
 5223: 
 5224:             const int j2 = elem->nxq(j1 + 1);
 5225: 
 5226:             // Pairs of consecutive neighbor elements of elem
 5227:             const Element *e1 = elem->nghbElems[j1];
 5228:             const Element *e2 = elem->nghbElems[j2];
 5229: 
 5230:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5231:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5232:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5233: 
 5234:             // Compute the density difference and the vector from elem to e1 and e2
 5235:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5236:             double diffRho1, diffRho2;
 5237:             Vector2 vec1, vec2;
 5238:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5239:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5240: 
 5241:             const double rl1 = length(vec1);
 5242:             const double rl2 = length(vec2);
 5243:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5244: 
 5245:             const double delta = cross(vec1, vec2);
 5246:             const double sintheta = abs(delta)/(rl1*rl2);
 5247: 
 5248:             // To avoid problems, avoid elements with small angle between vectors
 5249:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5250:             const bool validEq = (sintheta > sin_one_deg);
 5251: 
 5252:             if (validEq) {
 5253:                // Solve the system of equations to get the density gradient at elem
 5254:                icount++;
 5255:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5256:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5257:                sumRx += Rx;
 5258:                sumRy += Ry;
 5259:             }
 5260:          } // for j1
 5261: 
 5262:          // Compute the average density gradient at elem
 5263:          if (icount==0) {
 5264:            // Bad mesh quality; bail out with 0 b-cc
 5265:            elem->gradRho[k] = {0.0, 0.0};
 5266:          } else {
 5267:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5268:          }
 5269: 
 5270:       } // for k
 5271: 
 5272:    }
 5273: 
 5274:    __global__ void computeBaroclinicTerm(void) {
 5275:    // Computes the baroclinic term at sides (at half levels).
 5276:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5277:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5278: 
 5279:       if (ibc == 1) return;
 5280: 
 5281:       SIDE(side);
 5282: 
 5283:       if (side->isDry) return;
 5284: 
 5285:       const Element *e1 = side->elems[0];
 5286:       const Element *e2 = side->elems[1];      
 5287:       const int kb = side->kb;
 5288:       
 5289:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5290: 
 5291:       // interpolates vertically the density gradient of the two elements at the half level/
 5292: 
 5293:       int k1 = max(kb, nvrt / 2);
 5294:       int k2 = max(kb, nvrt / 2);
 5295: 
 5296:       // Starts the integration at the surface and goes down to the bottom
 5297:       side->bcc[nvrt-1] = {0.0, 0.0};
 5298:       for (int k = nvrt - 2; k >= kb; k--) {
 5299:       // For each prism level (from surface to bottom)...
 5300: 
 5301:          // For both elements, interpolate density gradient at the side's half level.
 5302:          // The gradient at the side is the average of the gradients at the elements.
 5303:          // w1, w2 are used to take into account boundary sides, with just one element.
 5304:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5305:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5306:          const double wsum = w1 + w2;
 5307:          w1 = w1/wsum;
 5308:          w2 = w2/wsum;
 5309:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5310: 
 5311:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5312:          Vector2 gradRho = {0.0, 0.0};
 5313:          if (e1 != nullptr && k > kb) {
 5314:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5315:             
 5316:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5317:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5318:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5319: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5320:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5321:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5322:          }      
 5323:          if (e2 != nullptr && k > kb) {
 5324:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5325:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5326:             
 5327:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5328:          }
 5329: 
 5330:          if constexpr(ics==2) {
 5331:             assert(false && "Not implemented: ics == 2");
 5332:             // IMPLEMENT THIS XXXXXX
 5333:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5334:             // swild(1)=tmp1
 5335:             // swild(2)=tmp2
 5336:          }
 5337:          
 5338:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5339:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5340:          // CHECK INDICES!!! XXX
 5341:          const double grav3 = side->grav3();
 5342:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5343: 
 5344:       } // for
 5345: 
 5346:    }
 5347: 
 5348: 
 5349: 
 5350:    __global__ void computeHorGradientAtSide(void) {
 5351: 
 5352:       // Compute the horizontal density gradient at each element.
 5353:       // It works in two steps:
 5354:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5355:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5356:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5357:       //             gradRho.r1 = rho1 - rho0
 5358:       //             gradRho.r2 = rho2 - rho0
 5359:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5360:       // 
 5361:       //  NOTE: We use de-meaned densities.
 5362: 
 5363:       SIDE(side);
 5364: 
 5365: // printf("side->isDry: %d\n", side->isDry);
 5366:       if (side->isDry) return;
 5367: 
 5368:       // Computes the gradient of the variables at the side center.
 5369:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5370:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5371:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5372: 
 5373:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5374:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5375:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5376:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5377: 
 5378: 
 5379:    }
 5380: 
 5381: 
 5382:    __global__ void solveMomentumEquations(double time) {
 5383: 
 5384:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5385:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5386: 
 5387:       SIDE(side);
 5388: 
 5389:       if (side->isDry) 
 5390:       {
 5391:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5392: 
 5393:          return;
 5394:       }
 5395: 
 5396:       const Node *n1 = side->n1;
 5397:       const Node *n2 = side->n2;
 5398: 
 5399:       const int kb = side->kb;
 5400: 
 5401:       const double veg_h = side->veg_h();
 5402:       const double grav3 = side->grav3();
 5403: 
 5404:       if (side->is2D()) {
 5405:          // Warning: Do not use htot2, which is updated.
 5406:          const double htot = side->htot1();
 5407:          const double hhat = side->hhat;
 5408: 
 5409:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5410: 
 5411:          Vector2 tau2 = {0.0, 0.0};
 5412:           
 5413:          if constexpr(ics==1) {
 5414:             tau2 = side->tau();
 5415: 
 5416:          } else {
 5417:             assert(false && "Not implemented: ics == 2");
 5418:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5419:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5420:             // taux2=(vn1+tt1)*0.5d0
 5421:             // tauy2=(vn2+ss1)*0.5d0
 5422:          } // if ics         
 5423: 
 5424:          // hat_gam has units of m/s
 5425: 
 5426:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5427: 
 5428:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5429:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5430: 
 5431:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5432: 
 5433: 
 5434:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5435:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5436: 
 5437:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5438: 
 5439:       }
 5440:       else { // 3D
 5441: 
 5442:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5443:          // 
 5444:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5445:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5446:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5447:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5448:          // k+1 and k.
 5449: 
 5450: 
 5451:          const int ndim = nvrt - kb;
 5452:          const double zTopCanopy = side->zTopCanopy();
 5453: 
 5454:          // Initialize the tridiagonal system
 5455:          for (int k = kb + 1; k < nvrt; k++) {
 5456:             
 5457:             const int kin = k - (kb + 1);
 5458: 
 5459:             // Vertical viscosity at the face center
 5460:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5461:  
 5462:             alow[kin] = 0.0;
 5463:             cupp[kin] = 0.0;
 5464:             bdia[kin] = 0.0;
 5465: 
 5466:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5467:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5468: 
 5469:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5470:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5471:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5472: 
 5473:             // First part: layers k, k+1
 5474:             if (k < nvrt - 1) {
 5475:                              
 5476:                if constexpr(iveg != 0) {
 5477: 
 5478:                   // If there is vegetation at this level...
 5479:                   if (zTopCanopy > side->zc[k]) {
 5480:                      // If the canopy is above the k layer...
 5481:                      
 5482:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5483:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5484:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5485:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5486: 
 5487:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5488:                      const double vmag2 = length(ut2);
 5489:                      const double vmag1 = length(side->u2[k]);
 5490:                      const double vmag = 0.5*(vmag1 + vmag2);
 5491:                      
 5492:                      // Computes the vegetation alpha at the face center
 5493:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5494: 
 5495:                      cff1 += veg_alpha_sd*dt*vmag;
 5496: 
 5497:                   } // if (zTopCanopy
 5498:                } // if iveg
 5499: 
 5500:                const double dzz = side->Dz(k + 1);
 5501:                const double tmp = dt*dfz/dzz;
 5502:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5503: 
 5504:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5505:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5506:             }
 5507: 
 5508: 
 5509:             // Second part: layers k-1, k
 5510:             if (k > kb + 1) {
 5511: 
 5512:                double cff1 = 1.0; //init \bar{c^k}
 5513: 
 5514:                if constexpr(iveg != 0) {
 5515:                   // If there is vegetation at this level...
 5516:                   if (zTopCanopy > side->zc[k-1]) {
 5517:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5518:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5519: 
 5520:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5521: 
 5522:                      const double vmag2 = length(ut2);
 5523:                      const double vmag1 = length(side->u2[k-1]);
 5524:                      const double vmag = 0.5*(vmag1 + vmag2);
 5525: 
 5526:                      // Computes the vegetation alpha at the face center
 5527:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5528:                      cff1 += veg_alpha_sd*dt*vmag;
 5529:                   } // if zTopCanopy
 5530: 
 5531:                } // if iveg
 5532: 
 5533:                const double dzz = side->Dz(k);
 5534:                const double tmp = dt*dfz/dzz;
 5535:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5536: 
 5537:                alow[kin] += cff1*dzz/6.0 - tmp;
 5538:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5539: 
 5540:             } else { // Bottom boundary
 5541:                // This occurs at the bottom, where the bottom drag is applied.
 5542: 
 5543:                bdia[kin] += dt*side->chi2; // XXXX
 5544: 
 5545:             } // if (k > kb + 1)
 5546: 
 5547: 
 5548:          } // for (int k
 5549: 
 5550: 
 5551: 
 5552:          // Computes the RHS.
 5553:          // -----------------
 5554: 
 5555:          //	BC to be imposed at the end.
 5556: 
 5557:          const Vector2 gradETP  = side->gradETP;
 5558:          const Vector2 gradPr   = side->gradPr;
 5559:          const Vector2 gradEta1 = side->gradEta1;
 5560:          const Vector2 gradEta2 = side->gradEta2;
 5561: 
 5562:          const Vector2 *btu = side->btu;
 5563:          const Vector2 *u2  = side->u2;
 5564:          const double coriolis = side->coriolis;
 5565:          const Vector2 *nuGradU = side->nuGradU;
 5566: 
 5567: 
 5568:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5569: 
 5570:          for (int k = kb + 1; k < nvrt; k++) {
 5571:             const int kin = k - kb - 1;
 5572: 
 5573:             const double dz_0 = side->Dz(k);
 5574:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5575: 
 5576:             rrhs[kin] = {0.0, 0.0};
 5577:             double dz = 0.0;
 5578: 
 5579:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5580:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5581:             if (k < nvrt  ) dz += dz_1;
 5582:             if (k > kb + 1) dz += dz_0;
 5583: 
 5584:             // Elevation gradient, atmospheric pressure and tidal potential
 5585:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5586: 
 5587:             // Coriolis, advection, wind stress, and horizontal viscosity
 5588:             if (k < nvrt - 1) {
 5589: 
 5590: 
 5591:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5592:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5593:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5594:                                                 
 5595: 
 5596:                //diff stress tensors 1006
 5597:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5598:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5599:                   assert(false && "Not implemented: itur == 5");
 5600:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5601:                }
 5602: 
 5603:             } else { // k == nvrt - 1 SURFACE
 5604:                Vector2 tau2 = {0.0, 0.0};
 5605:                if constexpr(ics==1) {
 5606:                   tau2 = side->tau();
 5607:       
 5608:                } else {
 5609:                   assert(false && "Not implemented: ics == 2");
 5610:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5611:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5612:                   // taux2=(vn1+tt1)*0.5d0
 5613:                   // tauy2=(vn2+ss1)*0.5d0
 5614:                } // if ics
 5615: 
 5616:                rrhs[kin] += dt*tau2;
 5617: 
 5618:             } // if k<nvrt
 5619: 
 5620:             if (k > kb + 1) {
 5621:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5622:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5623:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5624: 
 5625:                // diff stress tensors 1006
 5626:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5627:                   assert(false && "Not implemented: itur == 5");
 5628:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5629:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5630:                }
 5631: 
 5632:             } // if k>kbs + 1
 5633: 
 5634:             // Baroclinic
 5635:             Vector2 *bcc = side->bcc;
 5636:             if constexpr(ibc == 0) {
 5637:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5638:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5639: 
 5640:             } // if ibc==0
 5641: 
 5642:          } // k=kb + 1,nvrt
 5643: 
 5644: 
 5645:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5646: 
 5647:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5648:             const int kin = k - kb - 1;
 5649: 
 5650:             // Velocity is always clamped to maximum values
 5651:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5652:          } // k
 5653: 
 5654:       } // if side->is2D()
 5655:       
 5656: 
 5657:       // Impose velocity boundary condition at the bottom
 5658:       if constexpr(imm == 2) { // 3D bed deformation model
 5659:          double dep;
 5660:          Vector2 vel;
 5661: 
 5662:          assert(false && "Not implemented: imm == 2");
 5663:          //update_bdef(time, x0, y0, dep, vel);
 5664:          // side->u2[kb] = vel;
 5665: 
 5666:       } else { // imm = 0 or 1
 5667:          if (side->Cd() == 0.0) {
 5668:             side->u2[kb] = side->u2[kb + 1];
 5669: 
 5670:          } else if (side->is3D()) { // 3D no slip bottom   
 5671:             side->u2[kb] = {0.0, 0.0};
 5672:          }
 5673:           
 5674:       } // if imm
 5675: 
 5676:       // The velocities below the bottom level are set to zero
 5677:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5678: 
 5679: 
 5680:    }
 5681: 
 5682: 
 5683:    __global__ void applyMomentumBC(void) {
 5684: 
 5685:       SIDE_BND(sideBnd);
 5686: 
 5687:       Side *side = sideBnd->side;
 5688:       const BoundarySegment *segment = sideBnd->segment;
 5689:       const Node *n1 = side->n1;
 5690:       const Node *n2 = side->n2;
 5691: 
 5692:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5693: 
 5694:       const bool isLand = segment->isLand;
 5695:       const int ifltype = segment->ifltype;
 5696: 
 5697:       const int kb = side->kb;
 5698: 
 5699:       if (!isLand && ifltype != 0) {
 5700:          const Vector2 *ubc = sideBnd->ubc;
 5701:   
 5702:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5703:             
 5704:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5705:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5706: 
 5707:             if (ifltype == -1) {
 5708:                // Flather 1
 5709: 
 5710:                const double depth = side->depth();
 5711: 
 5712:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5713: 
 5714:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5715: 
 5716:                side->u2[k] = vnorm*side->n;
 5717: 
 5718:             } else if (ifltype == -2) { // Discharge
 5719: 
 5720:                const double eta1 = side->eta1();
 5721:                const double eta2 = side->eta2();
 5722:                const double htot = side->htot2();
 5723: 
 5724:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5725:                assert(false && "Not implemented: Discharge bc");
 5726:                // const double dischrg = discharge(eta1);
 5727:                const double dischrg = 0.0; // XXX REMOVE
 5728:                
 5729: 
 5730:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5731: 
 5732:                const double vnorm = dischrg*eta2/htot;
 5733: 
 5734:                side->u2[k] = vnorm*side->n;
 5735: 
 5736:             }
 5737:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5738:                const double vnorm = dot(side->u2[k], side->n);
 5739: 
 5740:                double rat;
 5741:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5742:                else              rat = segment->vobc2; // outgoing
 5743: 
 5744:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5745: 
 5746:             }
 5747:             else { // not Flather or 3D radiation
 5748:                side->u2[k] = ubc[k];
 5749: 
 5750:             } // if (segment->ifltype...
 5751: 
 5752:          }
 5753: 
 5754:       }
 5755:       else if (isLand) { // if it is land boundary side
 5756: 
 5757:          if constexpr(islip == 0) { // free slip
 5758: 
 5759:             for (int k = kb; k < nvrt; k++) {
 5760: 
 5761:                const Vector2 t = side->t();
 5762:                const Vector2 n = side->n;
 5763: 
 5764:                double vnorm = 0.0; // for most cases
 5765:                const double vtan = dot(side->u2[k], t);
 5766:                
 5767:                side->u2[k] = vtan*t - vnorm*n;
 5768: 
 5769:             }
 5770: 
 5771:          } else { // no slip
 5772:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5773: 
 5774:          }
 5775:       } // if (side segment type...
 5776: 
 5777:    
 5778: 
 5779:    }
 5780: 
 5781: 
 5782:    __global__ void shapiroFilter1(void) {
 5783:       // First step of the Shapiro filter (normally used if indvel<=0)
 5784:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5785: 
 5786:       SIDE(side);
 5787: 
 5788:       // Only internal wet sides are processed
 5789:       if (side->isDry || !(side->isInternal())) return;
 5790: 
 5791:       const int kb = side->kb;
 5792: 
 5793:       for (int mm = 0; mm < niter_shap; mm++) {
 5794: 
 5795:          for (int k = kb + 1; k < nvrt; k++) {
 5796:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5797:             Vector2 suru = {0.0, 0.0};
 5798: 
 5799:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5800: 
 5801:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5802: 
 5803:                int kin = k;
 5804:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5805:                
 5806:                if constexpr(ics==1) {
 5807:                   suru += nSide->u2[kin];
 5808: 
 5809:                } else {
 5810:                   assert(false && "Not implemented: ics == 2");
 5811:                   // Vector2 vn1, vn2;
 5812:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5813:                   // suru=suru+vn1;
 5814:                   // surv=surv+vn2;
 5815:                }
 5816:             }
 5817: 
 5818: 
 5819:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5820: 
 5821:          }
 5822:       }
 5823:    }
 5824: 
 5825:    __global__ void shapiroFilter2(void) {
 5826:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5827: 
 5828:       SIDE(side);
 5829: 
 5830:       if (side->isDry || !(side->isInternal())) return;
 5831: 
 5832:       const int kb = side->kb;
 5833: 
 5834:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5835: 
 5836:       if (side->is2D()) {
 5837:          side->u2[kb + 1] = side->bcc[kb + 1];
 5838:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5839: 
 5840:       } else {
 5841:          // 3D
 5842:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5843:          
 5844:       }
 5845: 
 5846:    }
 5847: 
 5848: 
 5849:    __global__ void ul0UpdateZCoords(void) {
 5850:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5851:       
 5852:       NODE(node);      
 5853: 
 5854: 
 5855:       if (node->isDry2()) { 
 5856: 
 5857:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5858: 
 5859:          if constexpr(ivcor != 1) node->kb = 0;
 5860: 
 5861:       } else {
 5862: 
 5863:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5864:          node->updateKb();
 5865: 
 5866:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5867: 
 5868:       }
 5869: 
 5870:       // We use the temp.b field to store the previous state of isDry.
 5871:       node->tmp.b = node->isDry;
 5872: 
 5873:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5874:       node->isDry = true;
 5875: 
 5876:    }
 5877: 
 5878:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5879:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5880:    {
 5881:       ELEM(elem);
 5882: 
 5883:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5884: 
 5885:       // All the nodes of a wet element are wet.
 5886:       if (!elem->isDry) {
 5887:          elem->nodes[0]->isDry = false;
 5888:          elem->nodes[1]->isDry = false;
 5889:          elem->nodes[2]->isDry = false;
 5890:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5891: 
 5892:       }
 5893: 
 5894: 
 5895:       elem->kb = 0;
 5896: 
 5897:       if (elem->isDry) return;
 5898: 
 5899:       // Wet
 5900:       const Node *n1 = elem->nodes[0];
 5901:       const Node *n2 = elem->nodes[1];
 5902:       const Node *n3 = elem->nodes[2];  
 5903:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5904: 
 5905:    //    if(elem->isDry2()) { // XXXX
 5906:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5907:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5908:    //        call parallel_abort(errmsg)
 5909:    //    }
 5910: 
 5911: 
 5912:       // Computes element's kb as the minimum of the nodes' kb.
 5913:       const int kb1 = n1->kb;
 5914:       const int kb2 = n2->kb;
 5915:       const int kb3 = n3->kb;
 5916:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5917: 
 5918: 
 5919:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5920: 
 5921: 
 5922:       // Computes the element z as the mean of the nodes z.
 5923:       for (int k = elem->kb; k < nvrt; k++) {
 5924: 
 5925:          // Compute the element z as the mean of the nodes z.
 5926:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5927:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5928:          elem->z[k] /= elem->i34;
 5929: 
 5930:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5931:       }
 5932:                   
 5933:    }
 5934: 
 5935:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5936:    {
 5937:       NODE(node);
 5938:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5939: 
 5940:       if (it == iths) return;
 5941: 
 5942: 
 5943:       if(!node->isDry && node->tmp.b) { // rewetted
 5944:          for (int k=0; k < nvrt; k++) {
 5945: 
 5946:             Vector3 utmp={0.0, 0.0, 0.0};
 5947: 
 5948:             double ttmp=0.0;
 5949:             double stmp=0.0;
 5950:             int icount=0;
 5951:             for (int j = 0; j < node->numNodes; j++) {
 5952: 
 5953: 
 5954:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5955:                if (!node->isDry) { // all indices extended
 5956:                   icount++;
 5957: 
 5958:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5959:                   utmp += node->uvw2(k);
 5960:                   
 5961:                   ttmp += node->tracers[k].tracer[0]; 
 5962:                   stmp += node->tracers[k].tracer[1]; 
 5963:                }
 5964:             }
 5965: 
 5966:             if(icount > 0) {
 5967:                const double inv_icount = 1.0/icount;
 5968:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5969:                node->w2[k]     = inv_icount*utmp.z;
 5970:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5971:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5972:             }
 5973:          }
 5974:       }
 5975:    }
 5976: 
 5977: 
 5978:    __global__ void ul0UpdateSides(int it, int iths) {
 5979: 
 5980:       SIDE(side);
 5981: 
 5982:       // A side is wet if and only if at least one of its elements is wet.
 5983:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5984:  
 5985:       const Node *n1 = side->n1;
 5986:       const Node *n2 = side->n2;
 5987:      
 5988:       const int kb1 = n1->kb;
 5989:       const int kb2 = n2->kb;
 5990: 
 5991:       side->kb = 0; // dry
 5992: 
 5993:       if (isWet) {
 5994: 
 5995:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5996: 
 5997:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5998: 
 5999:          side->kb = min(kb1, kb2);
 6000: 
 6001:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6002: 
 6003:          for (int k = side->kb; k < nvrt; k++) {
 6004:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6005: 
 6006:          
 6007:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6008: 
 6009:             // Compute velocity for re-wetted sides 
 6010:             if ((it != iths) && (side->isDry && isWet)) {
 6011:             
 6012:                Vector2 utmp={0.0, 0.0};
 6013: 
 6014:                int icount=0;
 6015: 
 6016:                // For all the sides on the two elements that share this side
 6017:                for (int j=0; j < 2; j++) {
 6018:                   const Element *elem = side->elems[j];
 6019:                   if (elem == nullptr) continue;
 6020: 
 6021:                   for (int jj=0; jj < elem->i34; jj++) {
 6022:                      const Side *nSide = elem->sides[jj];
 6023:                      if (nSide->isDry) continue;
 6024: 
 6025:                      icount++;
 6026:                      utmp += nSide->u2[k];                     
 6027:                   }
 6028:                }
 6029:                   
 6030:                assert(icount > 0 && "No wet sides around this side");
 6031:                if (icount > 0)  side->u2[k] = utmp/icount;
 6032:                   
 6033:             } // if ((it != iths) && (side->isDry && isWet))
 6034: 
 6035:          } // for k
 6036: 
 6037:       } // if isWet
 6038:    
 6039:       side->isDry = !isWet;
 6040: 
 6041:    }
 6042: 
 6043: 
 6044:    __global__ void zeroNodalVelocities(void) {
 6045:       NODE(node);
 6046: 
 6047:       for (int k = 0; k < nvrt; k++) {
 6048:          node->u2[k]   = {0.0, 0.0};
 6049:          node->w2[k]   = 0.0;
 6050:          node->utmp[k] = {0.0, 0.0};
 6051:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6052:       }
 6053:    }
 6054: 
 6055:  
 6056: 
 6057:    __global__ void computeNodalVerticalVelocities1(void) {
 6058:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6059:    // Adds the element's vertical velocity times the element's area.
 6060:       ELEM(elem);
 6061: 
 6062:       for (int j = 0; j < elem->i34; j++) {
 6063:          Node *node = elem->nodes[j];
 6064: 
 6065:          for (int k = node->kb; k < nvrt; k++) {
 6066:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6067:          }
 6068:          atomicAdd(&(node->tmp.d), elem->area);
 6069:       }
 6070:    }
 6071: 
 6072:    __global__ void computeNodalVerticalVelocities2(void) {
 6073:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6074:    // Divides by the total area of the elements sharing the    node.
 6075:       NODE(node);
 6076: 
 6077:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6078:    }
 6079: 
 6080: 
 6081:    __global__ void computeNodalHorizontalVelocities1(void) {
 6082:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6083:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6084: 
 6085:       ELEM(elem);
 6086: 
 6087:       const int kb = elem->kb;
 6088:       const bool isTri = elem->isTri();
 6089: 
 6090:       if constexpr(indvel <= 0) {
 6091:          // Assuming discontinoius hvel.
 6092: 
 6093: 
 6094:          if (isTri) { // For triangles
 6095:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6096:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6097: 
 6098:             for (int j = 0; j < 3; j++) {
 6099:                // For every node of the triangle...
 6100:                Node *node = elem->nodes[j];
 6101: 
 6102:                const Side *s1 = elem->sides[j];
 6103:                const Side *s2 = elem->sides[(j + 1) % 3];
 6104:                const Side *s3 = elem->sides[(j + 2) % 3];
 6105: 
 6106:                const int numElements = node->numElements;
 6107:                const double inv_numElements = 1.0/numElements;
 6108: 
 6109:                for (int k = kb; k < nvrt; k++)  {
 6110:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6111:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6112:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6113:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6114:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6115:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6116: 
 6117:                }
 6118: 
 6119:             }
 6120:          }
 6121:          else { // For quads
 6122:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6123: 
 6124:          }
 6125: 
 6126:       }
 6127:       
 6128:    }
 6129: 
 6130: 
 6131:    __global__ void computeNodalHorizontalVelocities2(void) {
 6132:       NODE(node);
 6133: 
 6134:       for (int k = 0; k < nvrt; k++) {
 6135:          node->u2[k] = node->utmp[k];
 6136:          node->w2[k] = node->w2[k];
 6137:       }
 6138:       
 6139:    }   
 6140: 
 6141:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6142:    // XXXX I'm not sure where I got this function from. 
 6143:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6144:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6145:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6146:    // It uses the utmp array as a temporary array to store the velocities.
 6147: 
 6148:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6149: 
 6150:       SIDE(side);
 6151: 
 6152:       const int kb = side->kb;
 6153: 
 6154:       Node *n1 = side->n1;
 6155:       Node *n2 = side->n2;
 6156: 
 6157:       for (int k = kb; k < nvrt; k++) {
 6158: 
 6159:          // Cast the u2 vector into a Vector2 
 6160:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6161:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6162: 
 6163:          n1_u2 = side->u2[k]/n1->numSides;
 6164:          n2_u2 = side->u2[k]/n2->numSides;
 6165: 
 6166:       }
 6167: 
 6168: 
 6169:    }
 6170: 
 6171:    __global__ void resetVelocityOpenBndNodes(void) {
 6172:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6173: 
 6174:       NODE_BND(nodebnd);
 6175: 
 6176:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6177:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6178:       }
 6179: 
 6180:    }
 6181: 
 6182: 
 6183:    __global__ void setVelocityOpenBndNodes(void) {
 6184:    // For open boundary nodes sets their velocity to the imposed values.
 6185: 
 6186:       SIDE_BND(sidebnd);
 6187: 
 6188:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6189:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6190:          // to its segment to the average of the side velocity.
 6191: 
 6192:          for (int k = 0; k < nvrt; k++) {
 6193:             Node *n1 = sidebnd->side->n1;
 6194:             Node *n2 = sidebnd->side->n2;
 6195: 
 6196: 
 6197:             Vector2 n1_u2(n1->u2[k]);
 6198:             Vector2 n2_u2(n2->u2[k]);
 6199: 
 6200:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6201:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6202:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6203:             }
 6204:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6205:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6206:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6207:             }
 6208: 
 6209:          }
 6210: 
 6211:       }
 6212: 
 6213:    }
