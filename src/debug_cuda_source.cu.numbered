 6498: __global__ void printMatrix(void) {
 6499: 
 6500: 
 6501:    // Let only one thread per block print at a time 
 6502: 
 6503:    if (threadIdx.x == 0) {
 6504:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6505:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6506:          if (idx_node >= mesh->np) return;
 6507:          const Node *node = mesh->localNodeData + idx_node;
 6508:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6509:          for (int j = 0; j < node->numNodes; j++) {
 6510:             Node* nbNode = node->nodes[j];
 6511:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6512:          }
 6513:          printf("]\n");
 6514: 
 6515:       }
 6516:    }
 6517: 
 6518: 
 6519: 
 6520: }
