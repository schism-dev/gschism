 2247:    
 2248:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2249:    // Project the vectors from the node frame to the element frame
 2250: 
 2251:  
 2252:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2253:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2254:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2255:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2256:       else          v[3] = Vector2();
 2257:    }
 2258: 
 2259:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2260:    // Project the vectors from the side frame to the element frame
 2261: 
 2262:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2263:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2264:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2265:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2266:       else          v[3] = Vector2();
 2267:    }
