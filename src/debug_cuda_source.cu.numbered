 1961: __device__ void lock(int *mutex) {
 1962:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1963: }
 1964: 
 1965: __device__ void unlock(int *mutex) {
 1966:     atomicExch(mutex, 0);
 1967: }
