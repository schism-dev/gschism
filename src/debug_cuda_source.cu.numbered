 5536:    __global__ void resetBoundaryAreas(void) {
 5537:       // Reset boundary areas and lengths for each segment.
 5538: 
 5539:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5540:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5541:       SIDE_BND(sideBnd);
 5542: 
 5543:       BoundarySegment *segment = sideBnd->segment;
 5544: 
 5545:       segment->carea = 0.0;
 5546:       segment->clen = 0.0;
 5547:  
 5548:    }
 5549: 
 5550:    __global__ void computeBoundaryAreas(void) {
 5551:    // Calculation of cross-section areas and lengths for flow b.c.
 5552: 
 5553:       SIDE_BND(sideBnd);
 5554: 
 5555:       const Side *side = sideBnd->side;
 5556:       BoundarySegment *segment = sideBnd->segment;
 5557: 
 5558:       if (segment->ifltype != 0) {
 5559: 
 5560:          const Node *n1 = side->n1;
 5561:          const Node *n2 = side->n2;
 5562: 
 5563:          const double htot = side->htot2();
 5564: 
 5565:          if (!side->isDry) {
 5566:             atomicAdd(&segment->carea, htot*side->len);
 5567:             atomicAdd(&segment->clen, side->len);
 5568:          }
 5569:       }
 5570: 
 5571:    }
 5572: 
 5573: 
 5574:    __global__ void computeFlowBcVelocities(double time) {
 5575: 
 5576:       SIDE_BND(sideBnd);
 5577: 
 5578:       const Side *side = sideBnd->side;
 5579:  
 5580:       const bool isDry = side->isDry;
 5581:       const bool isLand = sideBnd->segment->isLand;
 5582: 
 5583:    
 5584:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5585: 
 5586:       if (isDry || isLand) return;
 5587: 
 5588:       // For wet sides in open boundaries...
 5589:       const Vector2 n = side->n;
 5590:       const BoundarySegment *segment = sideBnd->segment;
 5591: 
 5592:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5593: 
 5594:       const int ifltype = segment->ifltype;
 5595: 
 5596:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5597:       const Vector2 r_nuth0 = r_uth0*n;
 5598: 
 5599: 
 5600:       if (ifltype == 1 || ifltype == 2) {
 5601:       
 5602:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5603: 
 5604:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5605:          
 5606:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5607:          
 5608:       } else if (ifltype == -1) { // Flather 1
 5609: 
 5610:          for (int k = 0; k < nvrt; k++) {
 5611: 
 5612:             // uth is the normal vel.; no ramp up
 5613:             const double uth = sideBnd->nuth(k);
 5614:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5615: 
 5616:             sideBnd->ubc[k] += uth*n;
 5617:          }
 5618: 
 5619:       } else if (ifltype == 3 || ifltype == 5) {
 5620:          // vnth0=0 !normal vel.
 5621: 
 5622:          Vector2 r_u1_bar = {0.0, 0.0};
 5623:          // Computes the contribution to the velocity from all tide frequencies
 5624:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5625: 
 5626:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5627:             const Vector2 umo  = sideBnd->umo(jfr); 
 5628: 
 5629:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5630:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5631:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5632:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5633: 
 5634:          }
 5635: 
 5636: 
 5637:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5638: 
 5639:       } // if (ifltype = 3 || ifltype == 5
 5640: 
 5641: 
 5642: 
 5643:    }
 5644: 
 5645:    __global__ void computeElevationBoundaryConditions(double time) {
 5646:       // Compute elevation essential boundary conditions 
 5647: 
 5648:       NODE_BND(nodeBnd); // Each boundary node.
 5649: 
 5650:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5651: 
 5652:       const Node *node = nodeBnd->node;
 5653:       const BoundarySegment *segment = nodeBnd->segment;
 5654:       const int iettype = segment->iettype;
 5655:       
 5656: 
 5657:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5658:       double eic = 0.0;
 5659:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 5660:       else                 eic = 0.0;
 5661: 
 5662:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5663:       const double r_eth = ramp*nodeBnd->eth;
 5664:       double r_eta1_bar = 0.0;
 5665: 
 5666: 
 5667:       // Compute tide elevation
 5668:       if (iettype == 3 || iettype == 5) {   
 5669: 
 5670:          if constexpr(iloadtide==1) { // loading tide
 5671:             assert(false && "Loading tide not implemented");
 5672:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5673:          }
 5674:          
 5675:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5676: 
 5677:             const double efa  = nodeBnd->efa[jfr]; 
 5678:             const double emo  = nodeBnd->emo[jfr]; 
 5679: 
 5680:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5681:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5682:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5683: 
 5684:          } // for jfr
 5685: 
 5686:       } // if iettype
 5687: 
 5688:       switch (iettype) {
 5689:          case 1:
 5690:          case 2:
 5691:          case 4:
 5692:             nodeBnd->elbc = r_eic + r_eth;
 5693:             break;
 5694:          case 3:
 5695:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5696:             break;
 5697:          case 5:
 5698:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5699:             break;
 5700:       } // switch
 5701: 
 5702: 
 5703:       //Add inverse barometric effects
 5704:       if (iettype != 0 && inv_atm_bnd == 1) {
 5705:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5706:       }
 5707: 
 5708:    }
 5709: 
 5710: 
 5711:    __global__ void computeHorizontalViscosity(void) { 
 5712: 
 5713:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5714: 
 5715:       SIDE(side);
 5716: 
 5717:       if (side->isDry) return;
 5718: 
 5719:       for (int k = 0; k < nvrt; k++) {
 5720:          side->nuGradU[k] = {0.0, 0.0};
 5721:       }
 5722: 
 5723:       if constexpr(ihorcon == 1) {
 5724:          for (int k = side->kb; k < nvrt - 1; k++) {
 5725:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5726:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5727:             // By Zhang and Baptista.
 5728: 
 5729:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5730:             // This is a standard discretization of the Laplacian operator.
 5731:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5732:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5733:             // Gamma is hvis_coef0 in the code.
 5734:             // The value of gamma needs to be < 0.5.
 5735: 
 5736:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5737:             // side under consideration in each of the two possible elements that share the side.
 5738:             Vector2 sumU = {0.0, 0.0};
 5739:             for (int l = 0; l < 2; l++) {
 5740:                const Element *elem = side->elems[l];
 5741: 
 5742:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5743: 
 5744:                // Find the local index of the side in the element
 5745:                const int idxSide = elem->sideLocalIdx(side);
 5746: 
 5747:                // Find the two sides that are connected to the side under consideration
 5748:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5749:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5750: 
 5751:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5752: 
 5753:             }
 5754: 
 5755:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5756: 
 5757:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5758:    
 5759:          }
 5760:       }
 5761:       else if constexpr(ihorcon == 2) {
 5762:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5763:       }
 5764: 
 5765: 
 5766:    }
 5767: 
 5768: 
 5769:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5770:       // Set essential boundary conditions 
 5771:       NODE(node); // Each boundary node
 5772:       NodeBoundary *nodeBnd = node->nodeBnd;
 5773:       
 5774:  
 5775:       // Check if this node has essential BC
 5776:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5777:          // Verify BC value is valid
 5778:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5779: 
 5780:        
 5781:          // Set diagonal to 1 and zero off-diagonals
 5782:          node->coeffDiag = 1.0;
 5783: 
 5784:          for (int j = 0; j < node->numNodes; j++) {
 5785:                node->coeffMatrix[j] = 0.0;
 5786:          }
 5787:          
 5788:          // Set solution and RHS to BC value
 5789:          node->mX  = nodeBnd->elbc;
 5790:          node->qel = nodeBnd->elbc;
 5791: 
 5792:       } else {
 5793:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5794: 
 5795:          for (int j = 0; j < node->numNodes; j++) {
 5796:                Node* nbNode = node->nodes[j];
 5797:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5798:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5799:                   // Verify neighbor's BC value
 5800:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5801: 
 5802:                   // Subtract contribution to RHS
 5803:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5804:                   node->coeffMatrix[j] = 0.0;  
 5805:                }
 5806:          }
 5807:       }
 5808:    }
 5809: 
 5810: 
 5811:    __global__ void updateElevation(void) {
 5812:       NODE(node);
 5813: 
 5814: 
 5815:       node->eta2 = node->mX;
 5816: 
 5817:       node->updateZCoordData();
 5818:    }
