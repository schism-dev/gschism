 5262: // __device__ void vertLinearInterp(double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 5263: // //     Routine to do vertical linear interpolation in z
 5264: // //     Inputs:
 5265: // //
 5266: // //       k1,k2: lower and upper limits for za, s_in 
 5267: // //       zt: desired interpolation level
 5268: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 5269: // //       s_in[0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 5270: // //     Outputs:
