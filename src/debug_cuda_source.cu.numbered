  222: // Simple math functions ---------------------------------------------------------------------------
  223: 
  224: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  225: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  226: // Outputs:
  227: //        x1: first solution
  228: //        x2: second solution
  229: 
  230:        // Use float-specific absolute value for speed on GPU
  231:     const double absA = fabs(A);
  232:     const double absB = fabs(B);
  233: 
  234:     // 1. Near-linear case: a is effectively 0.
  235:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  236:     // This branch is almost never taken, so it won't hurt performance.
  237:     if (absA < 1e-14 * (absB + 1e-30)) {
  238:         const double x = -C / B;
  239:         x1 = x;
  240:         x2 = x;
  241:         return;  // Degenerate case: A = 0.
  242:     }
  243: 
  244:    const double delta = max(0.0, B*B - 4.0*A*C);
  245: 
  246:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  247:    const double s = sqrt(delta);
  248: 
  249:    // Numerically stable quadratic roots:
  250:    // q = -0.5*(B + sign(B)*sqrt(delta))
  251:    const double q = -0.5 * (B + copysign(s, B));
  252: 
  253:    x1 = q/A;
  254:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  255: 
  256: }
