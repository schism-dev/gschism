 2134: 
 2135: /**
 2136:    Compute the shape coordinates of the point (xt,yt) in the element.
 2137:    @param xt (input): x-coordinate of the point
 2138:    @param shpCoords (output): shape coordinates of the point
 2139:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2140:    @return true if the point is inside the element, false otherwise
 2141: **/
 2142: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2143:                                             bool fixNegshpCoord) const {
 2144: 
 2145:    // Compute the shape coordinates of the point xt in the element.
 2146:    if (i34==3) {
 2147:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2148:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2149:       // and in this case, the pt will be nudged into the element
 2150:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2151:       // from the local frame, so use additional check.
 2152: 
 2153:       Point2 x0, x1, x2;
 2154: 
 2155:       if constexpr(ics==1) {
 2156:          x0 = nodes[0]->p2();
 2157:          x1 = nodes[1]->p2();
 2158:          x2 = nodes[2]->p2();
 2159:       }
 2160:       else // lat/lon
 2161:       {
 2162:          Error("Not implemented yet");
 2163: #ifdef ICS2
 2164:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2165:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2166:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2167: #endif
 2168:       }
 2169: 
 2170:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2171:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2172:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2173:       shpCoords[3] = 0.0;
 2174:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2175: 
 2176:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2177:       // then we fix the negative shape coordinates.
 2178:       if (fixNegshpCoord && tmpmin<=0.0) {
 2179: 
 2180:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2181:          // keeping the sum of the shape coordinates equal to 1.
 2182:          // I have tested and compared the new algorithm with the old one, and they give
 2183:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2184:          // The new algorithm should be faster since it is branchless.
 2185:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2186:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2187:          
 2188:          shpCoords[0] = (shpCoords[0] + a)*b;
 2189:          shpCoords[1] = (shpCoords[1] + a)*b;
 2190:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2191: 
 2192:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2193:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2194:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2195:          }
 2196: 
 2197:          // Update the point coordinates for the new shape coordinates
 2198:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2199:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2200:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2201: 
 2202:       }
 2203: 
 2204:       // Check if the point is inside the element
 2205:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2206:    }
 2207:    else {
 2208:       Error("Not implemented yet");
 2209: #ifdef QUADS
 2210:       // Reproject pt in eframe of nel for ics=2
 2211:       if constexpr(ics==1) {
 2212:          xn2 = xt; 
 2213:          yn2 = yt;
 2214:       }
 2215:       else {
 2216:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2217:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2218:       }
 2219: 
 2220:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2221: #endif
 2222:    }
 2223: 
 2224:    return false;  // Never reached
 2225: 
 2226: }
 2227: 
 2228: 
 2229: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2230: // Convert shape coordinates to cartesian coordinates
 2231: 
 2232:    if (i34 == 3) {
 2233:       // Triangular element
 2234:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2235:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2236:    }
 2237:    else {
 2238:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2239:    }
 2240: 
 2241: }
 2242: 
 2243: 
 2244: /**  Interpolate velocities at a given point (xt,yt,zt)
 2245: 
 2246:    @param xt, yt, zt: coordinates of the point to interpolate
 2247:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2248: 
 2249:    This is done in four steps:
 2250: 
 2251:    1. Find the shape coordinates for the final position in the element.
 2252:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2253:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2254:       z levels at xt, yt at each step.   
 2255:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2256:       horizontally and vertically.
 2257: **/
 2258: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2259:    // Interpolate the velocities at the point xt. 
 2260:    // This function works the same for triangular and quadrilateral elements.
 2261:    double shpCoord[4];
 2262: 
 2263: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2264:    // First step is to compute the shape coordinates of (xt,yt)
 2265:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2266:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2267: 
 2268:    // Second step is to find the level that contains zt
 2269:    // Uses a binary search to find the level
 2270:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2271:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2272:    int R = nvrt - 1;
 2273: 
 2274:    // Get the z coordinates at the nodes of the element at the levels L and R
 2275:    double zLAtNodes[4], zRAtNodes[4];
 2276:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2277:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2278: 
 2279:    double zL = interpolate(shpCoord, zLAtNodes);
 2280:    double zR = interpolate(shpCoord, zRAtNodes);
 2281:    
 2282:    // Interpolates vertically the velocities
 2283:    double wght1, wght2;
 2284:    if (xt.z<=zL) {
 2285:       wght1 = 1.0;
 2286:       wght2 = 0.0;
 2287:    }
 2288:    else if (xt.z>=zR) {
 2289:       wght1 = 0.0;
 2290:       wght2 = 1.0;
 2291:    }
 2292:    else {
 2293:       // Perform a binary search to find the levels between L and R that contain xt.z
 2294:       while (R - L > 1) {
 2295:          int M = (L + R) / 2;
 2296: 
 2297:          double zMAtNodes[4];
 2298:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2299:          double zM = interpolate(shpCoord, zMAtNodes);
 2300:          if (zM < xt.z) 
 2301:          {
 2302:             L = M;
 2303:             zL = zM;
 2304:          }
 2305:          else 
 2306:          {
 2307:             R = M;
 2308:             zR = zM;
 2309:          }
 2310:       }
 2311:       assert(L == R-1);
 2312:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2313: 
 2314:       wght2 = (xt.z - zL)/(zR - zL);
 2315:       wght1 = 1.0 - wght2;
 2316:    }
 2317: 
 2318:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2319:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2320: 
 2321: if (idx==2) {
 2322: Vector3 u1 = wght1*interpolate(L, shpCoord, &Node::u2);
 2323: Vector3 u2 = wght2*interpolate(R, shpCoord, &Node::u2);
 2324: printf("L = %d, R = %d, Element = %d\n", L, R, idx);
 2325: printf("shpCoord = %.17g,%.17g,%.17g,%.17g\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2326: // printf("node1 (%.17g,%.17g), node2 (%.17g,%.17g,%), node3 (%.17g,%.17g)\n", nodes[0]->p2().x, nodes[0]->p2().y, nodes[1]->p2().x, nodes[1]->p2().y, nodes[2]->p2().x, nodes[2]->p2().y);
 2327: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[L].x, nodes[0]->u2[L].y, nodes[0]->u2[L].z);
 2328: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[L].x, nodes[1]->u2[L].y, nodes[1]->u2[L].z);
 2329: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[L].x, nodes[2]->u2[L].y, nodes[2]->u2[L].z);
 2330: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[R].x, nodes[0]->u2[R].y, nodes[0]->u2[R].z);
 2331: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[R].x, nodes[1]->u2[R].y, nodes[1]->u2[R].z);
 2332: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[R].x, nodes[2]->u2[R].y, nodes[2]->u2[R].z);
 2333: printf("element = %d, idx = %d, u_int = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z);   
 2334: printf("u1 = %.17g,%.17g,%.17g\n", u1.x, u1.y, u1.z);   
 2335: printf("u2 = %.17g,%.17g,%.17g\n", u2.x, u2.y, u2.z);   
 2336: if(!(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z))) {u_int = {0.0, 0.0, 0.0}; return;}
 2337: }
 2338: 
 2339:    // Neither of the interpolated velocities should be NaN
 2340:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2341: 
 2342: }
 2343: 
