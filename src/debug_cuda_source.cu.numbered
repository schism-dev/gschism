 8739: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8740:    // Get the value of a variable from an side
 8741:    // varName is the name of the variable to get
 8742:    // var is the array to store the value
 8743:    // k is the vertical level index of the variable to get
 8744:    SIDE_BND(sideBnd);   
 8745: 
 8746:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8747:    if (sideBnd->segment->isLand) idx = -7;
 8748: 
 8749:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8750:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8751: 
 8752: }
