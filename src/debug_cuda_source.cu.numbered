 2350: 
 2351: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2352: 
 2353:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2354:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2355:    const Node *n1 = side->n1;
 2356:    const Node *n2 = side->n2;
 2357: 
 2358:    bool n1_match = (n1->nodeBnd->segment == segment);
 2359:    bool n2_match = (n2->nodeBnd->segment == segment);
 2360: 
 2361:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2362:    if (n1_match && n2_match) {
 2363:       return 0.5;
 2364:    } else if (n1_match) {
 2365:       return 1.0;
 2366:    } else if (n2_match) {
 2367:       return 0.0;
 2368:    }
 2369:    return 0.0;
 2370: }
 2371: 
 2372: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2373: 
 2374: 
 2375: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2376: 
 2377:    const double w1 = getBoundaryArrayValueWeight();
 2378:    const double w2 = 1.0 - w1;
 2379:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2380:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2381: 
 2382:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2383: }
 2384: 
 2385: 
 2386: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2387:    const double w1 = getBoundaryArrayValueWeight();
 2388:    const double w2 = 1.0 - w1;
 2389:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2390:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2391: 
 2392:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2393: }
 2394: 
 2395: 
 2396: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2397:    // Returns the value of the velocity at the side center
 2398:    const double w1 = getBoundaryArrayValueWeight();
 2399:    const double w2 = 1.0 - w1;
 2400:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2401:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2402: 
 2403:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2404: }
 2405: 
 2406: 
 2407: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2408:    // Returns the value of the normal component of the velocity at the side center
 2409:    const double w1 = getBoundaryArrayValueWeight();
 2410:    const double w2 = 1.0 - w1;
 2411:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2412:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2413: 
 2414:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2415: }
 2416: 
 2417: 
 2418: 
 2419: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2420: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2421: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2422: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2423:    Vector2 grad = {0.0, 0.0};
 2424:    int count = 0;
 2425: 
 2426:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2427: 
 2428:    // First element
 2429:    if (elems[0] != nullptr && condition(elems[0])) {
 2430:       grad += elems[0]->grad2(field);
 2431:       count++;
 2432:    }
 2433: 
 2434:    // Second element
 2435:    if (elems[1] != nullptr && condition(elems[1])) {
 2436:       grad += elems[1]->grad2(field);
 2437:       count++;
 2438:    }
 2439: 
 2440:    if (count > 0) {
 2441:       grad = grad/count;
 2442:    }
 2443:    
 2444:    return grad;
 2445: }
 2446: 
 2447: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2448: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2449: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2450: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2451: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2452: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2453: 
 2454: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2455: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2456: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2457: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2458: 
 2459: 
 2460: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2461: 
 2462: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2463: 
 2464: /**
 2465:  * This method performs backtracking from the side center until a time -dt back in time 
 2466:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2467:  * intermediate point.
 2468:  *
 2469:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2470:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2471:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2472:  * remaining time.
 2473:  * 
 2474:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2475:  * 
 2476:  * @param uuint, vvint, wwint: Velocities at the final point
 2477:  * @param jlev: Level at which the backtracking is performed
 2478:  * @param dt, dtbk: Tracking timesteps
 2479:  * @return: True if the backtracking was successful, false otherwise
 2480:  */
 2481: __inline__ __device__ bool Side::btrack(
 2482:       int jlev,
 2483:       double dt,            // Tracking time
 2484:       double dtbk,          // Tracking timestep
 2485:       Vector3 &u_int        // Velocities at the initial point
 2486: ) const {
 2487: 
 2488:    // Start from side center
 2489:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2490:  
 2491: 
 2492:    double time_rm = dt; // Remaining time
 2493: 
 2494: 
 2495:    // // Initialize outputs XXX
 2496:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2497:    //    sclr[i] = 0.0;
 2498:    // }
 2499: 
 2500: 
 2501:    // Initial velocities
 2502:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2503: 
 2504:    // Find the element that is in the direction opposite to the velocity
 2505:    Element* curElem = findElementTowards(toVector2(u_int));
 2506: 
 2507:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2508:    if (curElem == nullptr) {
 2509:       // Make velocity parallel to the side
 2510:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2511:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2512:       curElem = otherElem(curElem);
 2513:       
 2514:    }
 2515: 
 2516: 
 2517: 
 2518:    const int MAX_ITERATIONS = 1000; 
 2519:    Element* nextElem = curElem;
 2520:    int iter = 0;
 2521:    while(true) {
 2522: 
 2523:       // Calculate timestep
 2524:       double dtb = min(dtbk, time_rm);
 2525: 
 2526:       // Next point in the backtracking curve
 2527:       Point3 xt = x0 - dtb*u_int;
 2528: if (idx == 8) printf("LLLL   dtb: %f, u_int: %g %g %g\n", dtb, u_int.x, u_int.y, u_int.z);
 2529: 
 2530: 
 2531:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2532:       assert(found && "Backtracking failed in btrack");
 2533: 
 2534:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2535:                       // then time_rm needs to be increased by the unused time.
 2536:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2537: 
 2538:       // The current point becomes the next segment's starting point.
 2539:       x0 = xt;
 2540:  
 2541:       curElem = nextElem;
 2542: 
 2543:       iter++;
 2544:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2545:    }
 2546: 
 2547: 
 2548: }
 2549: 
 2550: 
 2551: 
 2552: // /**
 2553: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2554: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2555: 
 2556: //    Inputs:
 2557: //    @param x1, y1: point inside the element
 2558: //    @param x2, y2: other end of the line segment
 2559: 
 2560: //    Outputs:
 2561: //    @param intersectingSide:  side that intersects the line segment
 2562: //    @param nextElement: element that contains the intersection point
 2563: //    @param xIntersect, yIntersect: intersection point  
 2564: 
 2565: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2566: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2567: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2568: 
 2569: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2570: //    (Delta) being zero.
 2571: 
 2572: //    The intersection point happens when:
 2573: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2574: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2575:    
 2576: //    Assumption: the 4 points (including those of the side segment) are different.
 2577: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2578: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2579: //    If true, (xIntersect,yIntersect) is the intersection.				
 2580: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2581: // **/
