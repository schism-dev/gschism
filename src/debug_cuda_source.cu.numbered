 3450: // //                   is used below bottom or above surface.
 3451: // //       ibelow: flag indicating if zt is below za(k1)
 3452: // //
 3453: 
 3454: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 3455: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 3456:    
 3457: //    ibelow = 0;
 3458: 
