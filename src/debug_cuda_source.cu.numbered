 5361:    __global__ void resetBoundaryAreas(void) {
 5362:       // Reset boundary areas and lengths for each segment.
 5363: 
 5364:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5365:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5366:       SIDE_BND(sideBnd);
 5367: 
 5368:       BoundarySegment *segment = sideBnd->segment;
 5369: 
 5370:       segment->carea = 0.0;
 5371:       segment->clen = 0.0;
 5372:  
 5373:    }
 5374: 
 5375:    __global__ void computeBoundaryAreas(void) {
 5376:    // Calculation of cross-section areas and lengths for flow b.c.
 5377: 
 5378:       SIDE_BND(sideBnd);
 5379: 
 5380:       const Side *side = sideBnd->side;
 5381:       BoundarySegment *segment = sideBnd->segment;
 5382: 
 5383:       if (segment->ifltype != 0) {
 5384: 
 5385:          const Node *n1 = side->n1;
 5386:          const Node *n2 = side->n2;
 5387: 
 5388:          const double htot = side->htot2();
 5389: 
 5390:          if (!side->isDry) {
 5391:             atomicAdd(&segment->carea, htot*side->len);
 5392:             atomicAdd(&segment->clen, side->len);
 5393:          }
 5394:       }
 5395: 
 5396:    }
 5397: 
 5398: 
 5399:    __global__ void computeFlowBcVelocities(double time) {
 5400: 
 5401:       SIDE_BND(sideBnd);
 5402: 
 5403:       const Side *side = sideBnd->side;
 5404:  
 5405:       const bool isDry = side->isDry;
 5406:       const bool isLand = sideBnd->segment->isLand;
 5407: 
 5408:    
 5409:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5410: 
 5411:       if (isDry || isLand) return;
 5412: 
 5413:       // For wet sides in open boundaries...
 5414:       const Vector2 n = side->n;
 5415:       const BoundarySegment *segment = sideBnd->segment;
 5416: 
 5417:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5418: 
 5419:       const int ifltype = segment->ifltype;
 5420: 
 5421:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5422:       const Vector2 r_nuth0 = r_uth0*n;
 5423: 
 5424: 
 5425:       if (ifltype == 1 || ifltype == 2) {
 5426:       
 5427:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5428: 
 5429:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5430:          
 5431:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5432:          
 5433:       } else if (ifltype == -1) { // Flather 1
 5434: 
 5435:          for (int k = 0; k < nvrt; k++) {
 5436: 
 5437:             // uth is the normal vel.; no ramp up
 5438:             const double uth = sideBnd->nuth(k);
 5439:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5440: 
 5441:             sideBnd->ubc[k] += uth*n;
 5442:          }
 5443: 
 5444:       } else if (ifltype == 3 || ifltype == 5) {
 5445:          // vnth0=0 !normal vel.
 5446: 
 5447:          Vector2 r_u1_bar = {0.0, 0.0};
 5448:          // Computes the contribution to the velocity from all tide frequencies
 5449:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5450: 
 5451:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5452:             const Vector2 umo  = sideBnd->umo(jfr); 
 5453: 
 5454:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5455:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5456:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5457:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5458: 
 5459:          }
 5460: 
 5461: 
 5462:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5463: 
 5464:       } // if (ifltype = 3 || ifltype == 5
 5465: 
 5466: 
 5467: 
 5468:    }
 5469: 
 5470:    __global__ void computeElevationBoundaryConditions(double time) {
 5471:       // Compute elevation essential boundary conditions 
 5472: 
 5473:       NODE_BND(nodeBnd); // Each boundary node.
 5474: 
 5475:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5476: 
 5477:       const Node *node = nodeBnd->node;
 5478:       const BoundarySegment *segment = nodeBnd->segment;
 5479:       const int iettype = segment->iettype;
 5480:       
 5481: 
 5482:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5483:       double eic = 0.0;
 5484:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5485:       else                 eic = 0.0;
 5486: 
 5487:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5488:       const double r_eth = ramp*nodeBnd->eth;
 5489:       double r_eta1_bar = 0.0;
 5490: 
 5491:       // Compute tide elevation
 5492:       if (iettype == 3 || iettype == 5) {   
 5493: 
 5494:          if constexpr(iloadtide==1) { // loading tide
 5495:             assert(false && "Loading tide not implemented");
 5496:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5497:          }
 5498:          
 5499:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5500: 
 5501:             const double efa  = nodeBnd->efa[jfr]; 
 5502:             const double emo  = nodeBnd->emo[jfr]; 
 5503: 
 5504:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5505:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5506:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5507: 
 5508: 
 5509:          } // for jfr
 5510: 
 5511:       } // if iettype
 5512: 
 5513:       switch (iettype) {
 5514:          case 1:
 5515:          case 2:
 5516:          case 4:
 5517:             nodeBnd->elbc = r_eic + r_eth;
 5518:             break;
 5519:          case 3:
 5520:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5521:             break;
 5522:          case 5:
 5523:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5524:             break;
 5525:       } // switch
 5526: 
 5527: 
 5528:       //Add inverse barometric effects
 5529:       if (iettype != 0 && inv_atm_bnd == 1) {
 5530:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5531:       }
 5532: 
 5533:    }
 5534: 
 5535: 
 5536:    __global__ void computeHorizontalViscosity(void) { 
 5537: 
 5538:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5539: 
 5540:       SIDE(side);
 5541: 
 5542:       if (side->isDry) return;
 5543: 
 5544:       for (int k = 0; k < nvrt; k++) {
 5545:          side->nuGradU[k] = {0.0, 0.0};
 5546:       }
 5547: 
 5548:       if constexpr(ihorcon == 1) {
 5549:          for (int k = side->kb; k < nvrt - 1; k++) {
 5550:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5551:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5552:             // By Zhang and Baptista.
 5553: 
 5554:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5555:             // This is a standard discretization of the Laplacian operator.
 5556:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5557:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5558:             // Gamma is hvis_coef0 in the code.
 5559:             // The value of gamma needs to be < 0.5.
 5560: 
 5561:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5562:             // side under consideration in each of the two possible elements that share the side.
 5563:             Vector2 sumU = {0.0, 0.0};
 5564:             for (int l = 0; l < 2; l++) {
 5565:                const Element *elem = side->elems[l];
 5566: 
 5567:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5568: 
 5569:                // Find the local index of the side in the element
 5570:                const int idxSide = elem->sideLocalIdx(side);
 5571: 
 5572:                // Find the two sides that are connected to the side under consideration
 5573:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5574:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5575: 
 5576:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5577: 
 5578:             }
 5579: 
 5580:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5581: 
 5582:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5583:    
 5584:          }
 5585:       }
 5586:       else if constexpr(ihorcon == 2) {
 5587:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5588:       }
 5589: 
 5590: 
 5591:    }
 5592: 
 5593: 
 5594:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5595: 
 5596:       // Set essential boundary conditions 
 5597:       NODE(node); // Each boundary node
 5598:       NodeBoundary *nodeBnd = node->nodeBnd;
 5599:       
 5600:  
 5601:       // Check if this node has essential BC
 5602:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5603: // printf("setEssentialBC: nodeBnd->isEssentialBC = true");
 5604:          // Verify BC value is valid
 5605:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5606: 
 5607:        
 5608:          // Set diagonal to 1 and zero off-diagonals
 5609:          node->coeffDiag = 1.0;
 5610: 
 5611:          for (int j = 0; j < node->numNodes; j++) {
 5612:                node->coeffMatrix[j] = 0.0;
 5613:          }
 5614: // printf("setEssentialBC: node->coeffMatrix = 0.0\n");         
 5615:          // Set solution and RHS to BC value
 5616:          node->mX  = nodeBnd->elbc;
 5617:          node->qel = nodeBnd->elbc;
 5618: // printf("setEssentialBC: node->qel = nodeBnd->elbc\n");
 5619:       } else {
 5620:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5621: // printf("setEssentialBC: nodeBnd->isEssentialBC = false ****, node = %p\n", node);
 5622:          for (int j = 0; j < node->numNodes; j++) {
 5623:                const Node* nbNode = node->nodes[j];
 5624:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 5625: 
 5626:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5627:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 5628: 
 5629:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5630:                   // Verify neighbor's BC value
 5631:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5632: // printf("setEssentialBC: node = %p\n", node);
 5633:                   // Subtract contribution to RHS
 5634:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5635:                   node->coeffMatrix[j] = 0.0;  
 5636:                }
 5637:          }
 5638: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 5639:       }
 5640:    }
