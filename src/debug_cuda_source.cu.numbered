 7512: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7513:    // Get the value of a variable from an element
 7514:    // varName is the name of the variable to get
 7515:    // var is the array to store the value
 7516:    // k is the vertical level index of the variable to get
 7517: 
 7518:    ELEM(elem);
 7519:    
 7520:    int idx = elem->idx;
 7521:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7522: 
 7523:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7524:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7525:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7526:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7527:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7528:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7529:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7530:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7531:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7532:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7533:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7534:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7535:       
 7536:    
 7537: }
 7538: 
 7539: 
 7540: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7541:    // Get the value of a variable from an node
 7542:    // varName is the name of the variable to get
 7543:    // var is the array to store the value
 7544:    // k is the vertical level index of the variable to get
 7545: 
 7546:    NODE(node);
 7547:    
 7548:    int idx = node->idx;
 7549:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7550: 
 7551:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7552:    
 7553:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7554:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7555:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7556:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7557:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7558:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7559:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7560:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7561:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7562:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7563:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7564:    
 7565:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7566:       
 7567:    
 7568: }
 7569: 
 7570: 
 7571: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7572:    // Get the value of a variable from an side
 7573:    // varName is the name of the variable to get
 7574:    // var is the array to store the value
 7575:    // k is the vertical level index of the variable to get
 7576:    SIDE(side);
 7577:    
 7578:    int idx = side->idx;
 7579:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7580: 
 7581:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7582:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7583:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7584:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7585:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7586:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7587:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7588:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7589:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7590:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7591:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7592:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7593:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7594:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7595:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7596:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7597:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7598:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7599:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7600:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7601:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7602:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7603:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7604:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7605:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7606:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7607:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7608:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7609:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7610:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7611:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7612:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7613:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7614:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7615:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7616:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7617:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7618: }
 7619: 
 7620: 
 7621: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7622:    // Get the value of a variable from an side
 7623:    // varName is the name of the variable to get
 7624:    // var is the array to store the value
 7625:    // k is the vertical level index of the variable to get
 7626:    SIDE_BND(sideBnd);   
 7627: 
 7628:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7629:    if (sideBnd->segment->isLand) idx = -7;
 7630: 
 7631:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7632:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7633: 
 7634: }
