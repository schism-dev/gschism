 2397: 
 2398: __device__ __forceinline__ double Element::centerZ(void) const { 
 2399: // Z coordinate of the element center in the global cartesian coordinates.
 2400: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2401: 
 2402:    if constexpr(ics==1) { 
 2403:       return 0.0; 
 2404: 
 2405:    } else { 
 2406: 
 2407:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2408:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2409:    } 
 2410: }
