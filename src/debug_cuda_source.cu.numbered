 8084: __global__ void printMatrix(bool full) {
 8085:    // Debugging: print the matrix
 8086: 
 8087:    const int size = mesh->np;
 8088:    double sum = 0.0;
 8089:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8090:       const Node *node = mesh->localNodeData + idx_node;
 8091:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8092:       for (int j = 0; j < node->numNodes; j++) {
 8093:          Node* nbNode = node->nodes[j];
 8094:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8095:          sum += node->coeffMatrix[j];
 8096:       }
 8097:       if (full) printf("]\n");
 8098: 
 8099: 
 8100:    }
 8101:    if (!full) printf("sum=%lf\n", sum);
 8102: }
