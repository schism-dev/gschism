 7210: 
 7211: __global__ void returnMatrix(double *res) {
 7212:    // Debugging: returns the matrix as a CuPy array
 7213: 
 7214:    const int size = mesh->np;
 7215:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7216:       const Node *node = mesh->localNodeData + idx_node;
 7217:       res[idx_node*size + idx_node] = node->coeffDiag;
 7218:       for (int j = 0; j < node->numNodes; j++) {
 7219:          Node* nbNode = node->nodes[j];
 7220:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7221:       }
 7222: 
 7223:    }
 7224:    
 7225: }
 7226: 
 7227: 
 7228: __global__ void computeMatrixProductAndDotProducts() {
 7229:    // Computes A*p, r'Mr and p'Ap
 7230: 
 7231:    // 1) shared buffer: first half for rMr, second for pAp
 7232:    __shared__ double sdata[2*BLOCK_SIZE];
 7233:    double* s_rMr = sdata;
 7234:    double* s_pAp = sdata + BLOCK_SIZE;
 7235: 
 7236:    const int tid = threadIdx.x;
 7237: 
 7238:    double l_pAp = 0.0;
 7239: 
 7240:    s_rMr[tid] = 0.0;
 7241:    s_pAp[tid] = 0.0;
 7242: 
 7243:    // 2) get your node pointer
 7244:    // NODE(node);   
 7245:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7246:    Node *node = &(mesh->localNodeData[idx_node]); 
 7247:    if (idx_node < mesh->np) {
 7248: 
 7249: 
 7250:    const double diag = node->coeffDiag;
 7251:    const double r    = node->mR;
 7252:    const double p    = node->mP;  
 7253: 
 7254:    // apply preconditioner on the fly:
 7255:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7256: 
 7257:    // 4) compute Ap = A.p
 7258:    double Ap = node->coeffDiag * node->mP;
 7259:    for (int j = 0; j < node->numNodes; ++j) {
 7260:       const Node *nbNode = node->nodes[j];
 7261:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7262: 
 7263:    }
 7264: 
 7265:    node->mAp = Ap;
 7266:     
 7267: 
 7268:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7269:    // const double l_rMr = r*Mr;  // r'Mr
 7270:    l_pAp = p*Ap;  // p'Ap
 7271: 
 7272: 
 7273:    }
 7274: 
 7275:    // 6) write into shared mem
 7276:    // s_rMr[tid] = l_rMr;
 7277:    s_pAp[tid] = l_pAp;
 7278: 
 7279:    __syncthreads();
 7280: 
 7281:    // 7) block-wide tree reduction
 7282:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7283:       if (tid < stride)  {
 7284:          s_pAp[tid] += s_pAp[tid + stride];
 7285:       }
 7286:       __syncthreads();
 7287:    }
 7288: 
 7289:    // 8) thread 0 atomically accumulates into the globals
 7290:    // XXX: This is slower than it needs to be, but it is simple and works
 7291:    if (tid == 0) {
 7292:       atomicAdd(pAp, s_pAp[0]);
 7293:    }
 7294: 
 7295: 
 7296: }
 7297: 
 7298: 
 7299: __global__ void updateSolutionAndDotProducts(void) {
 7300:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7301: 
 7302:    const int tid = threadIdx.x;
 7303: 
 7304:    s_rMr[tid] = 0.0;
 7305: 
 7306:    // get node & bounds-check:
 7307:    NODE(node);
 7308: 
 7309:    
 7310:    // Compute alpha
 7311:    const double alpha = (*rMr_old)/(*pAp);
 7312: 
 7313:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7314: 
 7315: 
 7316:    // load scalars
 7317:    const double diag = node->coeffDiag;
 7318:    const double p    = node->mP;
 7319:    const double Ap   = node->mAp;
 7320:    const double x    = node->mX;
 7321:    const double r    = node->mR;
 7322:    
 7323:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7324: 
 7325:    // 1) update solution & residual
 7326:    const double x_new = x + alpha*p;
 7327:    const double r_new = r - alpha*Ap;
 7328:    node->mX = x_new;
 7329:    node->mR = r_new;
 7330: 
 7331:    // 2) apply Jacobi preconditioner on the fly
 7332:    const double Mr_new = r_new/diag;
 7333: 
 7334: 
 7335:    // 3) local contributions for the two dot-products
 7336:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7337: 
 7338:    // 4) write into shared-mem
 7339:    s_rMr[tid] = l_rMr;
 7340: 
 7341:    __syncthreads();
 7342: 
 7343: 
 7344:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7345:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7346:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7347:       __syncthreads();
 7348:    }
 7349: 
 7350:    // 6) thread 0 atomically folds into the global accumulators
 7351:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7352: 
 7353: 
 7354: }
 7355: 
 7356: 
 7357: __global__ void updateSearchDirection() {
 7358: 
 7359:     NODE(node);
 7360: 
 7361:     // recompute z on-the-fly
 7362:     const double z = node->mR / node->coeffDiag;
 7363:     const double p = node->mP;
 7364: 
 7365:     const double beta = (*rMr_new)/(*rMr_old);
 7366: 
 7367: 
 7368:     // p =z + beta*p
 7369:     node->mP = z + beta*p;
 7370: 
 7371: }
 7372: 
 7373: __global__ void initializePreconditionedResidual(double *scalars) {
 7374: 
 7375:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7376: 
 7377:     s_rMr[threadIdx.x] = 0.0;
 7378: 
 7379:     NODE(node);
 7380:     const int tid = threadIdx.x;
 7381:     // For the first iteration:
 7382:     // 1. Initial solution x = 0 (already set)
 7383:     // 2. Initial residual r = b (stored in qel)
 7384:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7385: 
 7386: // XXX we should use the guess solution here    
 7387: 
 7388:     // Set initial residual r = b (from qel)
 7389:     node->mR = node->qel;
 7390: 
 7391:     // Compute z = M^-1 * r (preconditioned residual)
 7392:     const double z = node->mR / node->coeffDiag;
 7393: 
 7394:     // Set initial search direction p = z
 7395:     node->mP = z;
 7396: 
 7397:     // Initialize other variables needed for CG
 7398:     node->mX = 0.0;  // Initial solution
 7399:     node->mAp = 0.0; // Will be computed in first iteration
 7400: 
 7401:     // These point to a cupy array in the host code
 7402:     rMr_old = scalars + 0;
 7403:     rMr_new = scalars + 1;
 7404:     pAp     = scalars + 2;
 7405: 
 7406:     // Computes the first r'Mr (reduction)
 7407:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7408: 
 7409:     // 4) write into shared-mem
 7410:     s_rMr[tid] = l_rMr;
 7411: 
 7412:     __syncthreads();
 7413: 
 7414: 
 7415:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7416:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7417:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7418:         __syncthreads();
 7419:     }
 7420: 
 7421:     // 6) thread 0 atomically folds into the global accumulators
 7422:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7423: 
 7424:     *rMr_old = 0.0;
 7425:     *pAp = 0.0;
 7426: }
 7427: 
 7428: 
 7429: 
 7430: 
 7431: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7432:    // Get the value of a variable from an element
 7433:    // varName is the name of the variable to get
 7434:    // var is the array to store the value
 7435:    // k is the vertical level index of the variable to get
 7436: 
 7437:    ELEM(elem);
 7438:    
 7439:    int idx = elem->idx;
 7440:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7441: 
 7442:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7443:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7444:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7445:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7446:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7447:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7448:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7449:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7450:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7451:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7452:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7453:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7454:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7455:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7456:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7457:       
 7458:    
 7459: }
 7460: 
 7461: 
 7462: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7463:    // Get the value of a variable from an node
 7464:    // varName is the name of the variable to get
 7465:    // var is the array to store the value
 7466:    // k is the vertical level index of the variable to get
 7467: 
 7468:    NODE(node);
 7469:    
 7470:    int idx = node->idx;
 7471:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7472: 
 7473:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7474:    
 7475:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7476:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7477:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7478:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7479:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7480:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7481:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7482:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7483:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7484:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7485:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7486:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7487:    
 7488:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7489:       
 7490:    
 7491: }
 7492: 
 7493: 
 7494: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7495:    // Get the value of a variable from an side
 7496:    // varName is the name of the variable to get
 7497:    // var is the array to store the value
 7498:    // k is the vertical level index of the variable to get
 7499:    SIDE(side);
 7500:    
 7501:    int idx = side->idx;
 7502:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7503: 
 7504:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7505:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7506:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7507:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7508:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7509:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7510:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7511:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7512:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7513:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7514:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7515:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7516:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7517:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7518:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7519:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7520:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7521:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7522:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7523:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7524:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7525:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7526:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7527:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7528:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7529:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7530:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7531:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7532:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7533:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7534:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7535:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7536:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7537:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7538: }
