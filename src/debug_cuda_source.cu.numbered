 7996:       //    *sizeType = sizeof(Vector2);
 7997:       //    break;   
 7998:       case (int)VarCode::hhat:
 7999:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8000:          *sizeType = sizeof(Vector2);
 8001:          break;      
 8002:       case (int)VarCode::chi:
 8003:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8004:          *sizeType = sizeof(double);
 8005:          break;
 8006:       case (int)VarCode::n1:
