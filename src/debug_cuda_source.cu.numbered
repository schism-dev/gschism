 3919: 
 3920: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3921:    // Computes the z coordinate at level k.
 3922:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3923:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3924:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3925:    // used 
 3926: 
 3927:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3928:    
 3929:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3930: 
 3931:    if (isDry2()) return 0.0;  
 3932: 
 3933:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3934: 
 3935:    if constexpr(ivcor == 2) {
 3936: 
 3937:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3938:       const double h_c = mesh->h_c;
 3939:       const double theta_f = mesh->theta_f;
 3940:       const double sinh_theta_f = mesh->sinh_theta_f;
 3941: 
 3942: 
 3943:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3944:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3945:       // once per time step/node. XXXX
 3946:       // CHECK: updateZCoordData
 3947: 
 3948:       //  To simplify comparisons, I define index versions of count variables.
 3949:       if      (k == ivrt)     return eta2; 
 3950:       else if (k == izlev)    return -hmod2;
 3951:       else if (k == kb)       return -depth;
 3952:       else if (k < izlev)     return mesh->ztot[k];
 3953:       else if (k > izlev) {
 3954:          const int ksig = k - izlev;
 3955: 
 3956:          if (hmod2 <= h_c) {
 3957:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3958: 
 3959:          } 
 3960:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3961:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3962:             assert(false && "compZCoord: invalid h_c\n");
 3963:          } 
 3964:          else {
 3965:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3966:                    h_c * mesh->sigma[ksig] + 
 3967:                    (hmod2 - h_c) * mesh->cs[ksig];
 3968:          }
 3969:       } else { 
 3970:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3971:       }
 3972: 
 3973:    }
 3974:    else {  // if constexpr(ivcor == 1)
 3975:       if (k <= kb)        return -depth; 
 3976:       else if (k == ivrt) return eta2;
 3977:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3978: 
 3979:    }
 3980:    
 3981:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3982:    return 0.0;
 3983: }
 3984: 
 3985: 
 3986: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3987:    // Computes the bottom drag Cd based on the selected nchi
 3988: 
 3989:    if constexpr(nchi == 0) {
 3990:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3991:       Cd = drag;  // Read from drag file
 3992: 
 3993:    } else if constexpr(nchi == 1) {
 3994:       // 
 3995: 
 3996:       bool ltmp = false; // for WBL iteration
 3997: 
 3998:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3999:       if (isDry || (rough == 0.0)) {
 4000:          Cd = 0.0;
 4001: 
 4002:       } else { //roughness >0 
 4003:          
 4004:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4005: 
 4006:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4007: 
 4008:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4009: 
 4010:       } // if rough
 4011: 
 4012:    } else if constexpr(nchi == -1) {
 4013:    // Manning 
 4014:  
 4015:       const double htot = max(hmin_man, htot2()); 
 4016:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4017: 
 4018:    } else {
 4019:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4020:       
 4021:    } // if nchi
 4022: 
 4023: }
 4024: 
 4025: 
 4026: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4027:    // Checks if a side in on the boundary
 4028:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4029: 
 4030:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4031:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4032: 
 4033:    // Indices of the nodes that form the side
 4034:    //
 4035:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 4036:    const int n1 = side.n1->idx;
 4037:    const int n2 = side.n2->idx;
 4038:    isLand = false;
 4039:    
 4040: 
 4041:    // Check if the side is on a land boundary
 4042:    for (int i = 0; i < nland; i++) {
 4043:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4044:          // Consecutive nodes in the land boundary segment
 4045:          const int b1 = ilnd[i + j*nland];
 4046:          const int b2 = ilnd[i + (j + 1)*nland];
 4047: 
 4048:          assert(b1 != -1 && b2 != -1);
 4049: 
 4050:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4051:             
 4052:             isLand = true;
 4053:             return i;
 4054:          }
 4055:       }
 4056:    }
 4057: 
 4058:    // Check if the side is on an open boundary
 4059:    for (int i = 0; i < nope; i++) {
 4060:       for (int j = 0; j < nond[i] - 1; j++) {
 4061:          // Consecutive nodes in the open boundary segment
 4062:          const int b1 = iond[i + j*nope];
 4063:          const int b2 = iond[i + (j + 1)*nope];
 4064: 
 4065:          assert(b1 != -1 && b2 != -1);
 4066: 
 4067:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4068:             isLand = false;
 4069:             return i;
 4070:          }
 4071:       }
 4072:    }
 4073: 
 4074:    // Check that the nodes are not both on the boundary
 4075:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 4076:         && "side not in ilnd/iond but both nodes are boundary" );
 4077: 
 4078:    return -1;
 4079: }
 4080: 
 4081: 
 4082: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4083:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4084:                                     double *wind_rotate_angle, 
 4085:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4086:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4087:                                     int16_t *nodePermutationSort, double *crs_data,
 4088:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 4089:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4090:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4091:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 4092:                                     double *drag, double *roughness, double *rmanning, 
 4093:                                     double *diffmin, double *diffmax,
 4094:                                     int *kb, double *localSigma) {
 4095: 
 4096:    NODE(pnode);  
 4097:    const int i = idx_node;
 4098:    const int iglobal = globalNodeIndices[i];
 4099:    Node &node(*pnode);
 4100: 
 4101:    node.idx = iglobal;
 4102:    node.part = localNodePart[iglobal];
 4103: 
 4104:    // It is important to differentiate between the global and local "start" indices because they
 4105:    // play different, but related, roles in this code. The global "start" indices are used
 4106:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 4107:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 4108:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 4109:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 4110:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 4111:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4112:    node.numNodes = idxNodeEnd - idxNodeStart;
 4113:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 4114: 
 4115:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 4116:    node.coeffRow = crs_data + rowStart; 
 4117: 
 4118:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 4119: 
 4120: 
 4121: 
 4122:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 4123:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 4124:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 4125:    node.numElements = idxElemEnd - idxElemStart;
 4126:    node.elements = nodeNeighElems + idxElemLocalStart;
 4127: 
 4128: 
 4129:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 4130:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4131:       const int partNode = localNodePart[idxNodeGlobal]; 
 4132:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4133: 
 4134:       Node *node_ptr = nodes[partNode] + idxNode;
 4135:       
 4136:       nodeNeighNodes[idxLocal] = node_ptr;
 4137:    }
 4138: 
 4139: 
 4140:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 4141:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4142:       const int partElem = localElemPart[idxElemGlobal];
 4143:       const int idxElem  = localElemIndices[idxElemGlobal];
 4144: 
 4145:       Element *elem_ptr = elems[partElem] + idxElem;
 4146: 
 4147:       nodeNeighElems[idxLocal] = elem_ptr;
 4148:    }      
 4149: 
 4150:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4151:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4152: 
 4153:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4154: 
 4155:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4156:    if constexpr(ics == 1) {
 4157:       node.p.x   = node_coords[i * 3];
 4158:       node.p.y   = node_coords[i * 3 + 1];
 4159:       node.gz = 0.0;
 4160: 
 4161:       if (use_ll) {                                    // <-- add
 4162:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4163:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4164:       }  
 4165: 
 4166:    } else {
 4167:       const double lon = deg2rad*node_coords[i * 3];
 4168:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4169: 
 4170:       Point3 p = computeXYZfromLatLon(lat, lon);
 4171:       node.p = toVector2(p);
 4172:       node.gz = p.z;
 4173:       node.lon = lon;
 4174:       node.lat = lat;
 4175: 
 4176:       #ifdef USE_FRAMES
 4177:       node.setFrame(lat, lon);
 4178:       #endif
 4179: 
 4180: 
 4181:    }
 4182: 
 4183:    node.depth = node_coords[i * 3 + 2];
 4184: 
 4185:    node.numSides = 0;
 4186: 
 4187:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4188:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4189:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4190:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4191:    else assert(false && "populateNodes: selected nchi not implemented.");
 4192: 
 4193:    // Populate the diffmin and diffmax values read from the files.
 4194:    // (Only used for GLS, GOTM, and SedimentMix.)
 4195:    node.turb.setDiffLimits(diffmin[iglobal], diffmax[iglobal]);
 4196: 
 4197:    if constexpr(ivcor == 1) 
 4198:    {  
 4199:       node.kb = kb[iglobal];
 4200: 
 4201:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4202:    }
 4203: 
 4204:    for (int k = 0; k < nvrt; k++) {
 4205:       node.rho[k] = rho0;
 4206:       node.z[k] = -1e20;
 4207:    }
 4208: 
 4209:    // Initialize the turbulence model including the vertical viscosity/diffusivity
 4210:    node.turb.init(&node);
 4211: 
 4212:    
 4213:    // Links the node to the boundary information
 4214:    if (isbnd[iglobal] >= 0) {
 4215:      
 4216:       // Get the index of the node boundary
 4217:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4218: 
 4219:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4220:       node.nodeBnd->node = &node;
 4221: 
 4222:       node.nodeBnd->sideBnd1 = nullptr;
 4223:       node.nodeBnd->sideBnd2 = nullptr;
 4224: 
 4225:       if (isbnd[iglobal]>=0) {
 4226: 
 4227:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4228:          
 4229:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4230:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4231: 
 4232:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4233:          node.nodeBnd->segment->clen  = nan("1");
 4234:          node.nodeBnd->segment->carea = nan("1");
 4235: 
 4236:       }
 4237:    } else {
 4238: 
 4239:       node.nodeBnd = nullptr; // For internal nodes
 4240: 
 4241:       if (isbnd[iglobal] == landSegment) {
 4242:          node.nodeBnd = landBoundaryNode;
 4243:          node.nodeBnd->segment = landBoundarySegment;
 4244:       }
 4245:       
 4246:    }
 4247:    
 4248:    // XXXX GAUSSIAN HILL VELOCITIES
 4249:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4250:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4251:          constexpr double rot_per = 3000.0;
 4252:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4253:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4254:       // XXXXX
 4255:    #endif
 4256: 
 4257: }
 4258: 
 4259: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4260:    
 4261:    NODE(node);
 4262:    const int localIdx = idx_node;
 4263: 
 4264: 
 4265:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4266:    int16_t *csrSlot = node->csrSlot;  
 4267: 
 4268:    // Simply count the number of nodes with a smaller global index than the current node.
 4269:    // It accounts for the diagonal element.
 4270:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4271:    // local index, but taking into account all the partitions (in order).
 4272:    for (int i = 0; i < node->numNodes; ++i) {
 4273:       const int col = node->nodes[i]->packedIndex();
 4274:       int16_t idx = 0;
 4275: 
 4276:       //Takes care of the diagonal element.
 4277:       if (node->packedIndex() < col) ++idx;          
 4278: 
 4279:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4280:       csrSlot[i] = idx;
 4281:    }
 4282: 
 4283:    // Find the diagonal element in the CRS matrix.
 4284:    int16_t idxDiag = 0;
 4285:    for (int j = 0; j < node->numNodes; ++j)
 4286:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4287: 
 4288:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4289: 
 4290:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4291:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4292: 
 4293:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4294:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4295:    crs_indptr[localIdx] = rowStart;
 4296: 
 4297:    // Fills crs_indices array using the per-partition indexing.
 4298:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4299:    crs_indices[rowStart + d] = node->packedIndex();  
 4300:    for (int j = 0; j < node->numNodes; ++j) {
 4301:       Node *nb = node->nodes[j];
 4302:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4303:    }
 4304: 
 4305: 
 4306: }
 4307: 
 4308: 
 4309: 
 4310: 
 4311: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4312:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4313:                                     double *wind_rotate_angle,   
 4314:                                     int *isdel, int *isidenode, int *isbnd,
 4315:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4316:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4317:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4318:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4319:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4320:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4321:                                     double *drag, double *roughness) {
 4322: 
 4323: 
 4324:    SIDE(pside);
 4325:    Side &side(*pside);
 4326:    const int i = idx_side;
 4327:    const int iglobal = globalSideIndices[i];
 4328:    side.idx = iglobal;  
 4329:    
 4330:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4331:    const double fc   = 2.0*omega_e*sin(sfea0);
 4332:    const double beta = 2.0*omega_e*cos(sfea0);
 4333: 
 4334:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4335: 
 4336:    // finding the pointer to the nodes that form the side
 4337:    const int idx_n1 = isidenode[iglobal*2];
 4338:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4339: 
 4340: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4341: 
 4342:    const int locidx_n1 = localNodeIndices[idx_n1];
 4343:    const int locidx_n2 = localNodeIndices[idx_n2];
 4344:    const int part_n1 =   localNodePart[idx_n1];
 4345:    const int part_n2 =   localNodePart[idx_n2];
 4346: 
 4347: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4348: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4349: 
 4350:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4351:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4352: 
 4353: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4354: 
 4355:    // Counts the number of sides connected to each node
 4356:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4357:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4358: 
 4359:    // Side boundary type
 4360:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4361:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4362: // if (i == 0) printf("populateSides: 2\n");
 4363: 
 4364:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4365:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4366:    {
 4367:       bool isLand = false;
 4368:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4369:       
 4370:       if (isbs > -1) {
 4371:          // assert(isLand || isbs>=0);
 4372:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4373: 
 4374:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4375: 
 4376:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4377:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4378: 
 4379:          assert (isLand == side.sideBnd->segment->isLand);
 4380:          
 4381:          side.sideBnd->side = &side;
 4382: 
 4383:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4384:          n1bnd->linkSideBoundary(side.sideBnd);
 4385:          n2bnd->linkSideBoundary(side.sideBnd);
 4386: 
 4387:       }
 4388:       else {
 4389:          side.sideBnd = nullptr;
 4390:       }
 4391:    }
 4392:    else 
 4393:    {
 4394:       side.sideBnd = nullptr;
 4395:    }
 4396: 
 4397: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4398: 
 4399:    // finding the pointer to the elements that share the side
 4400:    const int idx_e1 = isdel[iglobal*2];
 4401:    const int idx_e2 = isdel[iglobal*2 + 1];
 4402: 
 4403:    if (idx_e1 > -1) {
 4404:       const int locidx_e1 = localElemIndices[idx_e1];
 4405:       const int part_e1 =  localElemPart[idx_e1];
 4406:       side.elems[0] = elems[part_e1] + locidx_e1;
 4407: 
 4408:    }
 4409:    else {
 4410:       side.elems[0] = nullptr;
 4411:    }
 4412: 
 4413: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4414: 
 4415:    if (idx_e2 > -1) {
 4416:       const int locidx_e2 = localElemIndices[idx_e2];
 4417:       const int part_e2 =  localElemPart[idx_e2];
 4418:       side.elems[1] = elems[part_e2] + locidx_e2;
 4419:    }
 4420:    else {
 4421:       side.elems[1] = nullptr;
 4422:    }
 4423: 
 4424: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4425: 
 4426:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4427:       
 4428:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4429:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4430:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4431:          
 4432:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4433:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4434:       // printf("sideBnd: %p\n", side.sideBnd);
 4435:       // assert(false && "Side has no elements and no boundary");
 4436:    }
 4437:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4438: 
 4439:    // Compute the center of the side
 4440:    side.center = 0.5*(side.n1->p + side.n2->p);
 4441: 
 4442:    #ifdef USE_FRAMES
 4443:    side.setFrame();
 4444:    #endif
 4445: 
 4446: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4447: 
 4448:    // Normal, unitary vector to the side
 4449:    if constexpr(ics == 1) {
 4450:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4451:       side.n = normalize(side.n);
 4452:    }
 4453:    else {
 4454:       // Unit side vector in 3D cartesian coordinates
 4455:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4456: 
 4457:       nSide = normalize(nSide);
 4458: 
 4459:       // Its cross product with the unit local z-axis vector (nUp) is the
 4460:       // normal vector we are looking for.
 4461:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4462: 
 4463:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4464:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4465:       side.n = -normalize(n2D); 
 4466: 
 4467:    }
 4468: 
 4469: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4470: 
 4471:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4472:    side.shapiro = shapiro0;
 4473: 
 4474:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4475:    // XXXX
 4476:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4477:    constexpr double rot_per=3000.0;
 4478:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4479:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4480:    // XXXXX      
 4481:    #endif
 4482:    // Compute the z level at the center of the side
 4483:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4484:    
 4485:    // Compute the length of the side
 4486:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4487: 
 4488: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4489: 
 4490:    // Compute the Coriolis coefficient
 4491: 
 4492:    if constexpr(ncor == -1 || ncor == 0) {
 4493:       side.coriolis = coricoef;
 4494:    }
 4495:    else {
 4496:       const double sphi = side.lat();  // Latitude at the center of the side
 4497: 
 4498:       assert(use_ll && "use_ll must be true when ncor > 0");
 4499: 
 4500:       if constexpr(ics == 1) {
 4501:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4502:       }
 4503:       else { // ics == 2
 4504:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4505:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4506:       }
 4507: 
 4508:    }
 4509: 
 4510: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4511: 
 4512: }
 4513: 
 4514: 
 4515: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4516:    double *node_coords, double *node_coords_ll, bool use_ll,
 4517:    double *wind_rotate_angle,   
 4518:    int *isdel, int *isidenode, int *isbnd,
 4519:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4520:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4521:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4522:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4523:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4524:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4525:    double *drag, double *roughness) {
 4526: 
 4527:    ELEM(pelem);
 4528:    Element &elem(*pelem);
 4529:    const int i = idx_elem;
 4530: 
 4531:    elem.idx = i;
 4532: 
 4533:    for (int j = 0; j < i34[i]; j++) {
 4534:       const int idxNode = elnode[i*4 + j];  
 4535:       const int idxSide = elside[i*4 + j];
 4536:       
 4537:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4538:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4539: 
 4540:       // Find the neighboring element  
 4541:       if (elem.sides[j]->elems[0] == &elem) {
 4542:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4543:       }
 4544:       else {
 4545:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4546:       }
 4547:       
 4548:    }
 4549: 
 4550:    elem.i34 = i34[i];
 4551: 
 4552:    // Compute the barycenter of the element and its depth
 4553:    elem.center = {0.0, 0.0};
 4554:    elem.depth = 1e10;
 4555:    for (int j = 0; j < i34[i]; j++) {
 4556: 
 4557:       elem.center += elem.nodes[j]->p/i34[i];
 4558:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4559:    }
 4560: 
 4561:    #ifdef USE_FRAMES
 4562:    elem.setFrame();
 4563:    #endif
 4564: 
 4565:    elem.area = elem.computeSignedArea(); 
 4566:    elem.radius = sqrt(elem.area)/pi; 
 4567:    
 4568:    // Determines which way the normal vector to each side is oriented.
 4569:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4570:    for (int j = 0; j < i34[i]; j++)  
 4571:    {
 4572:       if (elem.sides[j]->elems[0] == &elem) {
 4573:          elem.ssign[j] =  1.0;
 4574:       }
 4575:       else {
 4576:          elem.ssign[j] = -1.0;
 4577:       }
 4578: 
 4579:    }
 4580: 
 4581:   
 4582: 
 4583:    // Derivatives of shape functions
 4584:    //  For ics=2, this is done in the element frame
 4585:    //  For quads, the derivative is evaluated at centroid
 4586:    for (int j = 0; j < elem.i34; j++) {
 4587:       const double area = elem.area;
 4588:       const int id2 = elem.nxq(1 + j);
 4589:       const int id3 = elem.nxq(2 + j);
 4590:       const int id4 = elem.nxq(3 + j);
 4591:       if (elem.isTri()) {
 4592:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4593:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4594:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4595:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4596:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4597:          // And so on for the other shape functions.
 4598: 
 4599:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4600:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4601:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4602: 
 4603:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4604:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4605: 
 4606:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4607: 
 4608:       }
 4609:       else  { // Quad, the derivatives are evaluated at the centroid
 4610: 
 4611:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4612:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4613:          // ...
 4614:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4615: 
 4616:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4617:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4618:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4619: 
 4620:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4621:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4622: 
 4623:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4624: 
 4625:       } // if Tri/Quad
 4626: 
 4627:    } // for j   
 4628:    
 4629:    
 4630: 
 4631: }
 4632: 
 4633: 
 4634: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4635:                                             double *emo, double *efa, 
 4636:                                             double *umo, double *ufa, 
 4637:                                             double *vmo, double *vfa,
 4638:                                             int *ifltype, int *iettype, double *qthcon) {
 4639: 
 4640:    NODE_BND(nodeBnd);
 4641:    const int idx = idx_node_bnd;    
 4642: 
 4643:    nodeBnd->idx = idx;
 4644: 
 4645:    // Need to find the segment index and the index of the node on the segment
 4646:    int idxNode = -1;
 4647:    int iseg, i;
 4648:    for (iseg = 0; iseg < nope; iseg++) {
 4649:       // for each segment...
 4650:       for (i = 0; i < nond[iseg]; i++) {
 4651:          idxNode = iond[iseg + i*nope];
 4652:          if (idxNode == nodeBnd->node->idx) 
 4653:          {
 4654:             // This is done for every segment that the node is part of, overwriting the previous values.
 4655:             // The result is that the segment with the highest index is the one that is used.
 4656:             nodeBnd->isEssentialBC = (iettype[iseg] != 0);
 4657:             nodeBnd->elbc = 0.0;
 4658: 
 4659:             // XXXXXX This may make more sense in populateBoundarySides.
 4660:             nodeBnd->segment->ifltype = ifltype[iseg];
 4661:             nodeBnd->segment->iettype = iettype[iseg];
 4662:             nodeBnd->segment->qthcon  = qthcon[iseg];
 4663:             nodeBnd->segment->idx = iseg;
 4664: 
 4665:             for (int jfr = 0; jfr < nbfr; jfr++) {
 4666: 
 4667:                const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4668: 
 4669:                nodeBnd->efa[jfr] = efa[idx2];
 4670:                nodeBnd->emo[jfr] = emo[idx2];
 4671: 
 4672:             }
 4673:          }         
 4674:       }
 4675:    }
 4676: 
 4677:    assert(iseg < nope && "iseg is out of bounds");
 4678: 
 4679: 
 4680: 
 4681: 
 4682:         
 4683: 
 4684: }
 4685: 
 4686: __device__ void Mesh::populateBoundarySides(int *nond, int *iond,
 4687:                                             double *emo, double *efa, 
 4688:                                             double *umo, double *ufa, 
 4689:                                             double *vmo, double *vfa,
 4690:                                             int *ifltype, int *iettype, double *qthcon) {
 4691: 
 4692:    SIDE_BND(sideBnd);
 4693: 
 4694:    const Side *side = sideBnd->side;
 4695: 
 4696: 
 4697:    // Indices of the nodes on the side 
 4698:    const int n1 = side->n1->idx;
 4699:    const int n2 = side->n2->idx;
 4700: 
 4701:    const int iseg = sideBnd->segment->idx;
 4702: 
 4703:    // Find the index of the side in the segment data array.
 4704:    for (int i = 0; i < nond[iseg] - 1; i++) {
 4705: 
 4706:       // Indices of the nodes at both ends of the side (obtained from the boundary node list)
 4707:       const int b1 = iond[iseg + i*nope];
 4708:       const int b2 = iond[iseg + (i + 1)*nope];
 4709: 
 4710:       // Find the side that connects the two nodes by comparing the indices of the nodes at both ends of the side (computed from 
 4711:       // the boundary node list) with the indices of the nodes at the ends of the side (obtained from the side structure).
 4712:       if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4713: 
 4714:          for (int jfr = 0; jfr < nbfr; jfr++) {
 4715:          // For each tidal component...
 4716: 
 4717:             const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4718: 
 4719:             // velocity magnitude at both ends of the side (1,2)            
 4720:             const double umo1 = umo[idx2];
 4721:             const double vmo1 = vmo[idx2];
 4722:             const double umo2 = umo[idx2 + nope];
 4723:             const double vmo2 = vmo[idx2 + nope];
 4724: 
 4725:             // velocity phases at both ends of the side (1,2)
 4726:             const double ufa1 = ufa[idx2];
 4727:             const double vfa1 = vfa[idx2];
 4728:             const double ufa2 = ufa[idx2 + nope];
 4729:             const double vfa2 = vfa[idx2 + nope];
 4730: 
 4731:             // These expressions compute the amplitude and phase of the velocity components at the center of the side.
 4732:             // The expressions replicate SCHISM by computing equivalent amplitude and phase for the velocity components at the center of the side.
 4733:             // Equivalent to SCHISM: average of the two reconstructed node tides
 4734:             //   0.5 * (a1*cos(theta - phi1) + a2*cos(theta - phi2))
 4735:             // with theta = amig*t + face. Folded here into one (umo, ufa) per
 4736:             // frequency so the step only does ramp*ff*umo*cos(theta - ufa).
 4737:             // Fortran keeps both (a, phi) on the nodes and averages after the
 4738:             // cosines; the result is the same.
 4739:             sideBnd->umo[jfr] = {0.5*sqrt(pow<2>(umo1) + pow<2>(umo2) + 2*umo1*umo2*cos(ufa1 - ufa2)), 0.5*sqrt(pow<2>(vmo1) + pow<2>(vmo2) + 2*vmo1*vmo2*cos(vfa1 - vfa2))};
 4740:             sideBnd->ufa[jfr] = {atan2(umo1*sin(ufa1) + umo2*sin(ufa2), umo1*cos(ufa1) + umo2*cos(ufa2)), atan2(vmo1*sin(vfa1) + vmo2*sin(vfa2), vmo1*cos(vfa1) + vmo2*cos(vfa2))};
 4741: 
 4742:          } // for jfr
 4743: 
 4744:       }
 4745:    }
 4746: 
 4747: 
 4748: }
 4749: 
 4750: __device__ void Mesh::populateBoundarySideLinks(void) {
 4751: 
 4752:    SIDE_BND(sideBnd);
 4753: 
 4754:    const Side *side = sideBnd->side;
 4755: 
 4756:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4757:    // and the rightSide is the side s that has s->n1 == side->n2
 4758:    for (int i = 0; i < mesh->nbs; i++) {
 4759: 
 4760:       Side *s = &mesh->localSideData[i];
 4761: 
 4762:       if (s == side) continue;  // Do not link the side to itself
 4763:    
 4764:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4765:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4766:    }
 4767: 
 4768:   
 4769: }
 4770: 
 4771: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4772:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4773:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4774:                 int *isdel, int *isidenode, int *isbnd,
 4775:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4776:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4777:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4778:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4779:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4780:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4781:                 double *drag, double *roughness,
 4782:                 double *emo, double *efa, 
 4783:                 double *umo, double *ufa, 
 4784:                 double *vmo, double *vfa) {
 4785: 
 4786:    printf("Populating mesh for partition %d\n", partNum);
 4787: 
 4788:    // XXXXXX THIS function does almost nothing. 
 4789: 
 4790:    nbs = *sharedIdxSideBoundary + 1;
 4791:    nbp = *sharedIdxNodeBoundary + 1;
 4792: 
 4793:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4794: 
 4795: }
 4796: 
 4797: 
 4798: 
 4799: 
 4800: 
 4801: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4802:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4803:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4804:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4805: }
 4806: 
 4807: 
 4808: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4809:    // Brunt-Väisälä frequency at level k.
 4810:    if (k <= node->kb || k >= ivrt) return 0.0;
 4811:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4812: }
 4813: 
 4814: 
 4815: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4816: 
 4817:    
 4818:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4819:    // k is the layer bottom index.
 4820: 
 4821: 
 4822: 
 4823:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4824: 
 4825:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4826:       const double eta2 = node->eta2;
 4827:       const double depth = node->depth;
 4828: 
 4829:       // Distances from the layer midpoint to the surface and bottom
 4830:       const double dist_s = eta2 - z_c;
 4831:       const double dist_b = z_c + depth;
 4832: 
 4833:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4834: 
 4835:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4836: 
 4837: 
 4838:    } else {
 4839:       return 1.0; // Other GLS submodels
 4840: 
 4841:    }
 4842: }
 4843: 
 4844: 
 4845: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4846:    // Minimum mixing length for levels below the surface.
 4847:    // Independent of psimin(); do not invert one to get the other.
 4848:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4849: }
 4850: 
 4851: 
 4852: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4853:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4854:    for (int k = 0; k < nvrt; k++) {
 4855:       tke[k]    = tkemin();
 4856:       mxl[k]    = mxlmin(node->depth);
 4857:       nu_tke[k] = diffmin;
 4858:       nu_phi[k] = diffmin;
 4859: 
 4860:       node->dfv[k] = 0.0;
 4861:       node->dfh[k] = 0.0;
 4862:    }
 4863: }
 4864: 
 4865: 
 4866: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4867: 
 4868:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4869: 
 4870:    if constexpr(iveg == 1) {
 4871:       
 4872:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4873:       const double zTopCanopy = node->zTopCanopy();
 4874: 
 4875:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4876: 
 4877:          const double ztop = node->z[k];   // Top of the current layer.
 4878: 
 4879:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4880:          // Where 1 means that the current level is fully within the vegetation layer.
 4881:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4882: 
 4883:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4884:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4885: 
 4886:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4887:          // and at the bottom of the layer.
 4888:          const double vmag_top = length(ub2_top);
 4889:          const double vmag_bot = length(node->u2[k-1]);
 4890: 
 4891:          // Volume-averaged velocity cubed.
 4892:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4893: 
 4894:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4895:          // and at the bottom of the layer.
 4896:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4897:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4898: 
 4899:          // Volume-averaged vegetation alpha cubed.
 4900:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4901: 
 4902:          return veg_alpha3D*vmag3;
 4903:       } 
 4904:       else {
 4905:          // The current level is not within the vegetation layer, so the production is 0.
 4906:          return 0.0;
 4907:       }
 4908:    } else {
 4909: 
 4910:       // If no vegetation, the production is 0.
 4911:       return 0.0;
 4912:    }
 4913: 
 4914: }
 4915: 
 4916: 
 4917: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4918:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4919:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4920: 
 4921:    const int kb = node->kb;
 4922: 
 4923:    for (int k = kb; k < nvrt; k++) {
 4924:       const double tke = this->tke[k];
 4925:       const double mxl = this->mxl[k];
 4926:       const double u = sqrt(tke);  // Characteristic velocity
 4927:       const double lu = mxl*u;     // Characteristic diffusivity 
 4928: 
 4929:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4930:       double drho_dz = 0.0;
 4931:       if (k > kb && k < ivrt) {
 4932:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4933:       }
 4934: 
 4935:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4936: 
 4937:       // Tsinghua group       
 4938:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4939: 
 4940:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4941:       if constexpr (stabilityModel == Galperin) {
 4942:          sh = 0.49393/(1.0-34.676*Gh);
 4943:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4944:          cmiu  = sqrt(2.0)*sm;
 4945:          cmiup = sqrt(2.0)*sh;
 4946:          cmiu1 = sqrt(2.0)*0.2;
 4947:          cmiu2 = sqrt(2.0)*0.2;
 4948: 
 4949:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4950:          // Warner's paper has problem
 4951:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 4952:          const double Ghp = Gh;  /// XXXXX needed?
 4953:          sh = 0.4939/(1.0 - 30.19*Ghp);
 4954:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 4955:          cmiu  = sqrt(2.0)*sm;
 4956:          cmiup = sqrt(2.0)*sh;
 4957:          cmiu1 = cmiu/schk();
 4958:          cmiu2 = cmiu/schpsi();
 4959: 
 4960:       } else {
 4961:          assert(false && "Unknown ASM");
 4962: 
 4963:       }
 4964: 
 4965:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 4966:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 4967:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 4968:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 4969:    }
 4970: }
 4971: 
 4972: 
 4973: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 4974: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 4975: 
 4976:    const double z = node->z[k];
 4977:    const double eta2 = node->eta2;
 4978:    const double depth = node->depth;
 4979: 
 4980:    // Distances to the surface and bottom
 4981:    const double dist_s = eta2 - z;
 4982:    const double dist_b = z + depth;
 4983: 
 4984:    // Distance to the closest "wall" (either surface or bottom).  
 4985:    // In the top layer, it is the size of the layer.
 4986:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 4987:    assert(min_dist > 0.0 && "Invalid minimum distance");
 4988: 
 4989:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 4990:    return kappa*min_dist;
 4991: }
 4992: 
 4993: 
 4994: 
 4995: template<TurbulenceModel turbulenceModel>
 4996: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 4997: 
 4998: 
 4999: template<>
 5000: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5001:    // Constant turbulence model
 5002:    // Does nothing since dfv and dfh are already set  in the initialization.
 5003: }
 5004: 
 5005: template<>
 5006: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5007:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5008: 
 5009:    // Solves the following PDEs:
 5010:    //
 5011:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5012:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5013:    //
 5014:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5015:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5016:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5017:    //
 5018:    // The equations are solved using a linear *vertical* FEM formulation.
 5019:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5020:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5021:    
 5022:    
 5023:    // Get the turbulence model
 5024:    // reinterpret_cast is used to avoid stupid compiler errors.
 5025:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5026:      
 5027:    const int kb = node->kb;
 5028:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5029: 
 5030:    double alow_tke[nvrt], alow_phi[nvrt];
 5031:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5032:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5033:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5034:    
 5035:    // Initialize the tridiagonal system
 5036:    for (int kin = 0; kin < nqrows; kin++) {
 5037:       alow_tke[kin]=0.0;
 5038:       bdia_tke[kin]=0.0;
 5039:       cupp_tke[kin]=0.0;
 5040:       rhs_tke [kin]=0.0; 
 5041:       alow_phi[kin]=0.0;
 5042:       bdia_phi[kin]=0.0;
 5043:       cupp_phi[kin]=0.0;
 5044:       rhs_phi [kin]=0.0; 
 5045:    }
 5046: 
 5047: 
 5048: 
 5049:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5050:    if (node->isDry || node->is2D()) {
 5051: 
 5052:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5053:       const double diffmin = turb.diffmin;
 5054: 
 5055:       for (int k = 0; k < nvrt; k++) {
 5056:          turb.tke[k]    = turb.tkemin();
 5057:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5058:          node->dfv[k]   = diffmin;
 5059:          node->dfh[k]   = diffmin;
 5060:          turb.nu_tke[k] = diffmin;
 5061:          turb.nu_phi[k] = diffmin;
 5062:       }
 5063: 
 5064:       return;
 5065:    }
 5066: 
 5067:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5068:    
 5069:    // After here we know that the node is wet and has at least 2 layers.
 5070: 
 5071:    double solution[nvrt], gam[nvrt];
 5072:    
 5073:    const double eta2       = node->eta2;
 5074:    const double depth      = node->depth;
 5075:    const double Cd         = node->Cd; // Drag coefficient
 5076: 
 5077:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5078:    
 5079:    const double sqU2 = norm2(node->u2[kb + 1]);
 5080:    const double modTau = length(node->tau);
 5081: 
 5082:  
 5083: 
 5084:    const double cpsi1 = turb.cpsi1();
 5085:    const double cpsi2 = turb.cpsi2();
 5086:    // cpsi3 is computed later because it depends on k
 5087: 
 5088: 
 5089:    // Assemble the tridiagonal system
 5090:    // -------------------------------
 5091: 
 5092:    // Loop over each vertical layer (interval between two vertical levels)
 5093:    // Each interval is an element of the vertical FEM formulation.
 5094:    // Two shape functions are defined over each interval. In this function we well call them
 5095:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5096:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5097:    //
 5098:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5099:    // Both systems of equations are assembled in the same loop.
 5100:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5101: 
 5102:       // Indices for the *rows* of the tridiagonal system.
 5103:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5104:       const int k2 = k - kb;     // One at k = kb + 1
 5105: 
 5106:       // Get the properties of the current interval.
 5107:       const double z  = node->z[k]; // bottom level of the interval
 5108:       const double dz = node->Dz(k + 1);
 5109:       
 5110:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5111: 
 5112:       // Turbulence production/dissipation terms (at the center of the interval).
 5113:       
 5114:       const double M2 = norm2(du_dz_c);              // Shear production term
 5115: 
 5116:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5117: 
 5118:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5119: 
 5120:       const double cpsi3 = turb.cpsi3(N2); 
 5121: 
 5122: 
 5123:       // Turbulence quantities at half levels (cell [c]enter)
 5124:       const double tke_1     = turb.tke[k];
 5125:       const double tke_2     = turb.tke[k+1];
 5126:       const double mxl_1     = turb.mxl[k];
 5127:       const double mxl_2     = turb.mxl[k+1];
 5128:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5129:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5130:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5131:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5132:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5133:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5134:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5135: 
 5136:       // Integral of the shape function products:
 5137:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5138:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5139:       const double p1p1 = dz/3.0;
 5140:       const double p1p2 = dz/6.0;
 5141:       const double d1d1 =  1.0/dz;
 5142:       const double d1d2 = -1.0/dz;
 5143: 
 5144:       // Production/dissipation related terms
 5145:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5146:       const double buoy = dfh_c*N2;
 5147:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5148: 
 5149: 
 5150: 
 5151:       // Equation for tke
 5152:       // ---------------
 5153: 
 5154:       // First row (of the two rows that the interval contributes to)
 5155:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5156:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5157:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5158: 
 5159: 
 5160:       if(prod + buoy >= 0.0) { // Net production
 5161:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5162:       } else { // Net dissipation
 5163:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5164:          bdia_tke[k1] -= 2.0*tmp;
 5165:          cupp_tke[k1] -= tmp;
 5166:       }      
 5167:       
 5168:       bdia_tke[k1] += 2.0*dt*diss;
 5169:       cupp_tke[k1] += dt*diss;
 5170:       
 5171:   
 5172:       // Second row (of the two rows that the interval contributes to)
 5173:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5174:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5175:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5176: 
 5177:       if (prod + buoy >= 0.0) { // Net production
 5178:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5179:       } else { // Net dissipation
 5180:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5181:          bdia_tke[k2] -= 2.0*tmp;
 5182:          alow_tke[k2] -= tmp;
 5183:       }
 5184:       
 5185:       bdia_tke[k2] += 2.0*dt*diss;
 5186:       alow_tke[k2] += dt*diss;
 5187: 
 5188: 
 5189:       // Equation for xl
 5190:       // ---------------
 5191: 
 5192:       const double rpub = turb.rpub();
 5193:       const double rmub = turb.rmub();
 5194:       const double rnub = turb.rnub();
 5195:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5196:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5197:       const double psi_c = 0.5*(psi_1 + psi_2);
 5198: 
 5199:       // Production/dissipation related terms
 5200:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5201:       const double buoy_phi = cpsi3*dfh_c*N2;
 5202:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5203: 
 5204:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5205:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5206:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5207: 
 5208:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5209:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5210:       } else { // Net dissipation
 5211:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5212:          bdia_phi[k1] -= 2.0*tmp;
 5213:          cupp_phi[k1] -= tmp;
 5214:       }
 5215: 
 5216:       // Production/dissipation terms
 5217:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5218:       cupp_phi[k1] += dt*diss_phi;
 5219:  
 5220: 
 5221:       // row k2 (upper)
 5222:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5223:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5224:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5225: 
 5226:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5227:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5228:       } else { // Net dissipation
 5229:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5230:          bdia_phi[k2] -= 2.0*tmp;
 5231:          alow_phi[k2] -= tmp;
 5232:       }
 5233: 
 5234:       // Production/dissipation terms
 5235:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5236:       alow_phi[k2] += dt*diss_phi;
 5237: 
 5238:    }
 5239: 
 5240:    // BC
 5241:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5242:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5243: 
 5244: 
 5245:    // Solves for tke.
 5246:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5247: 
 5248: 
 5249:    // B.C. (computed using values from previous time except wind)
 5250:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5251:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5252: 
 5253: 
 5254:    // Update TKE.
 5255:    turb.tke[kb]     = tkebot;
 5256:    turb.tke[kb + 1] = tkebot;
 5257:    turb.tke[ivrt]   = tkesrf;
 5258:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5259:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5260: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5261:    }
 5262: 
 5263: 
 5264: 
 5265:  
 5266:    // Solves for phi.
 5267:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5268: 
 5269: 
 5270:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5271:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5272:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5273: 
 5274:    turb.mxl[kb+1] = mxlbot;
 5275:    turb.mxl[ivrt] = mxlsrf;
 5276:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5277:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5278: 
 5279:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5280: 
 5281:       // Galperin's clipping
 5282:       if (N2 < 0.0) {
 5283:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5284:          turb.mxl[k] = min(turb.mxl[k], upper);
 5285:       }   
 5286: 
 5287: 
 5288: 
 5289:       // Max. mixing length based on dissipation; mxlmin prevails
 5290:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5291: 
 5292:       // Combined max. mixing length including geometric limit
 5293:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5294: 
 5295:       // Clamp the mixing length between the minimum and maximum values
 5296:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5297: 
 5298:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5299: 
 5300: 
 5301:    } // for k
 5302: 
 5303: 
 5304:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5305:    turb.tke[kb] = turb.tke[kb + 1];
 5306:    turb.mxl[kb] = turb.mxl[kb + 1];
 5307: 
 5308: 
 5309:    // Compute vertical diffusivities at new time
 5310:    turb.computeDiffusivities(node);
 5311: 
 5312:    // make all the variables uniform below the bottom level kb
 5313:    for (int k = 0; k < kb; k++) {
 5314:       node->dfv[k] = node->dfv[kb];
 5315:       node->dfh[k] = node->dfh[kb];
 5316:       turb.tke[k] = turb.tke[kb];
 5317:       turb.mxl[k] = turb.mxl[kb];
 5318:       turb.nu_tke[k] = turb.nu_tke[kb];
 5319:       turb.nu_phi[k] = turb.nu_phi[kb];
 5320:    }
 5321: 
 5322:       
 5323: 
 5324: }
 5325: 
 5326: 
 5327: 
 5328: 
 5329: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5330:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5331:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5332: 
 5333: 
 5334:    NODE(node1);
 5335: 
 5336:    node1->clearMatrixRow();
 5337:    node1->qel = 0.0;
 5338: 
 5339:    // THIS IS FOR STRUCTURES XXX
 5340:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5341: 
 5342:    
 5343:    for (int j=0; j<node1->numElements; j++) {
 5344:       // For each element connected to the node...
 5345: 
 5346:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5347: 
 5348:       Element *elem = node1->elements[j];
 5349: 
 5350:       // Compute the average gravity
 5351:       const double grav3 = elem->mean(&Node::grav2);
 5352: 
 5353:       // Look at the documentation for the description of the terms in the following integrals
 5354: 
 5355:       // Integral I_1 
 5356:       // \bar{\breve{H}} 
 5357:       const double hhatb = elem->mean(&Side::hhat);        
 5358: 
 5359:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5360: 
 5361:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5362:       const double area = elem->area;
 5363: 
 5364:       // Integral I_4
 5365:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5366:       // Where
 5367:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5368: 
 5369:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5370:       // of U over the element.
 5371:       const Vector2 U = elem->mean(&Side::U);
 5372: 
 5373:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5374: 
 5375:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5376:       const double I_4_1 = dot(gradPhi_1, U);
 5377: 
 5378: 
 5379:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5380:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5381: 
 5382:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5383: 
 5384: 
 5385:       // Normal component of the bed velocity
 5386:       double ubedNormalComp = 0.0;
 5387:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5388:          Vector3 ubed = {0.0, 0.0, 0.0};
 5389:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5390:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5391: 
 5392:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5393:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5394:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5395: 
 5396:          // Computes the normal component of the bed velocity
 5397:          ubedNormalComp = dot(ubed, N);
 5398:       } // imm==2
 5399: 
 5400:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5401: 
 5402:       if (elem->isTri()) {
 5403: 
 5404:          // To clarify the notation in this section: 
 5405:          //   In formulas, we use the following notation:
 5406:          //       i stands for the node under consideration (node1)
 5407:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5408:          //   However, in the code, we use the following notation:
 5409:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5410:          const int id2 = elem->nxq(1 + id1);
 5411:          const int id3 = elem->nxq(2 + id1);
 5412:          Node *node2 = elem->nodes[id2];
 5413:          Node *node3 = elem->nodes[id3];
 5414: 
 5415:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5416: 
 5417:          // integral of phi_i*phi_j
 5418:          const double ipp_ii = (1.0/6.0 )*area;
 5419:          const double ipp_ij = (1.0/12.0)*area;
 5420:          const double ipp_ik = (1.0/12.0)*area;
 5421: 
 5422:          // integral of [(grad phi_i) * (grad phi_j)]
 5423:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5424:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5425:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5426: 
 5427:          // Computes the different components of integral I_1 of each node with respect to node i.
 5428:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5429:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5430:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5431: 
 5432:          node1->addToSparseMatrix(node1, I1_ii);
 5433:          node1->addToSparseMatrix(node2, I1_ij); 
 5434:          node1->addToSparseMatrix(node3, I1_ik);
 5435: 
 5436:          #pragma unroll
 5437:          for (int l=0; l<3; l++) {
 5438: 
 5439:             Node *node = elem->nodes[l];
 5440: 
 5441:             // Additional variation in eta due to bed deformation or vertical velocity
 5442:             double extraEta = 0.0;
 5443:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5444:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5445: 
 5446: 
 5447:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5448:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5449: 
 5450:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5451: 
 5452:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5453:            
 5454:          }
 5455: 
 5456: 
 5457:       }
 5458:       else { // Quad
 5459:          // To clarify the notation in this section: 
 5460:          //   In formulas, we use the following notation:
 5461:          //       i stands for the node under consideration (node1)
 5462:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5463:          //   However, in the code, we use the following notation:
 5464:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5465:          const int id2 = elem->nxq(1 + id1);
 5466:          const int id3 = elem->nxq(2 + id1);
 5467:          const int id4 = elem->nxq(3 + id1);
 5468:          Node *node2 = elem->nodes[id2];
 5469:          Node *node3 = elem->nodes[id3];
 5470:          Node *node4 = elem->nodes[id4];   
 5471:          
 5472:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5473: 
 5474:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5475:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5476:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5477:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5478:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5479: 
 5480:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5481:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5482:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5483:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5484:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5485: 
 5486: 
 5487:          // Computes the different components of integral I_1 of each node with respect to node i.
 5488:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5489:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5490:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5491:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5492: 
 5493:          node1->addToSparseMatrix(node1, I1_ii);
 5494:          node1->addToSparseMatrix(node2, I1_ij); 
 5495:          node1->addToSparseMatrix(node3, I1_ik);
 5496:          node1->addToSparseMatrix(node4, I1_il);
 5497:   
 5498:          #pragma unroll
 5499:          for (int l=0; l<4; l++) {
 5500: 
 5501:             const Node *node = elem->nodes[l];
 5502: 
 5503:             // Additional variation in eta due to bed deformation or vertical velocity
 5504:             double extraEta = 0.0;
 5505:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5506:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5507: 
 5508:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5509:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5510:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5511: 
 5512:          }         
 5513:       } 
 5514: 
 5515: 
 5516:      node1->qel += (dt/elem->i34)*elem->vsource;
 5517:       
 5518: 
 5519:    } // for all elements connected to the node
 5520:    
 5521: 
 5522:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5523:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5524:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5525:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5526:    // If it is an open boundary node...
 5527: 
 5528:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5529: 
 5530:       // At least one open bnd side, maybe two
 5531:       for (int l=0; l<2; l++) { 
 5532: 
 5533:          // Gets each of the sides sharing the node. 
 5534:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5535: 
 5536:     
 5537: 
 5538:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5539:          if (sideBnd != nullptr) {
 5540:             // If the side is on a boundary...
 5541: 
 5542:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5543: 
 5544:             // Get the boundary segment
 5545:             const BoundarySegment *sideSegment = sideBnd->segment;
 5546:             const Side *side = sideBnd->side;
 5547: 
 5548:             // Integral I_3
 5549:             if (sideSegment->ifltype != 0) {
 5550:             // Natural or Flather b.c.
 5551: 
 5552:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5553:                // especially for Flather b.c.
 5554:                double ri3 = 0.0;
 5555:                if (!side->isDry) {
 5556:                   // If the side is not dry
 5557:                   
 5558:                   // Computes the side flux of (uth, vth)
 5559:                   double Vn = 0.0;
 5560:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5561:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5562:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5563: 
 5564:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5565:                   }
 5566: 
 5567:                   ri3 = 0.5*side->len*Vn;
 5568:                }
 5569: 
 5570:                if (sideSegment->ifltype == -1) { // Flather 1
 5571: 
 5572:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5573:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5574: 
 5575:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5576:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5577:                   
 5578:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5579:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5580: 
 5581:                } 
 5582:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5583:                   // Reset ri3
 5584:                   ri3 = 0.0;
 5585: 
 5586:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5587:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5588: 
 5589:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5590: 
 5591:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5592:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5593: 
 5594:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5595:                   node1->addToSparseMatrix(node1, con0*2.0);
 5596:                   node1->addToSparseMatrix(node2, con0);
 5597: 
 5598:                } // if Flather or Discharge
 5599: 
 5600:                node1->qel -= thetai*dt*ri3;  
 5601: 
 5602: 
 5603:             } // I_3
 5604:           
 5605: 
 5606:             // Integral I_5
 5607:             if(!side->isDry) {
 5608: 
 5609:                const double Unbar = dot(side->U, side->n);
 5610:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5611: 
 5612:             } // I_5
 5613: 
 5614:          } // if is boundary side
 5615: 
 5616:       } // for l
 5617: 
 5618:    } // if isbnd
 5619: 
 5620: 
 5621: }
 5622: 
 5623: 
 5624: 
 5625: extern "C" {
 5626: 
 5627:    __global__ void gatherBFromMesh(double* b) {
 5628:       // b[local] <- qel  (local = idx_node on this device)
 5629:       NODE(node);
