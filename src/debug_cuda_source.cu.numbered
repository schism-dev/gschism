 4392: extern "C" {
 4393: 
 4394:    __global__ void scaleGravity(double loadtide_coef) {
 4395: 
 4396: 
 4397:       NODE(node);
 4398: 
 4399:       // SAL option: scale gravity
 4400:       if constexpr(iloadtide==2) {  // simple const
 4401:          node->grav2 = grav*(1.0 - loadtide_coef);
 4402: 
 4403:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4404:         
 4405:           const double depth = max(node->depth, 0.0);
 4406:           const double tmp1 = sqrt(depth);
 4407:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4408:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4409:                              2.6969e-13*depth*depth*depth*tmp1;
 4410:           
 4411:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4412:           
 4413: 
 4414: 
 4415:           node->grav2 = grav*(1.0 - beta_bar);
 4416: 
 4417:       } else {  // iloadtide=0,1
 4418:           node->grav2 = grav;
 4419: 
 4420:       }
 4421: 
 4422:    }
 4423: 
