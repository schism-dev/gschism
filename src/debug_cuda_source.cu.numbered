 1578: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1579:    // Lock the mutex
 1580:    lock(&debugPlotMutex);
 1581:  
 1582:    bool ok = true;
 1583:    if (debugPlotIdx == nullptr) ok = false;
 1584:    if (*debugPlotIdx >= 10000) ok = false;
 1585:    if (ok) {
 1586:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1587:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1588:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1589:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1590:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1591:       (*debugPlotIdx)++;
 1592:    }
 1593: 
 1594:    __threadfence();               // ensure all above writes are visible
 1595:    // Unlock the mutex
 1596:    unlock(&debugPlotMutex);
 1597: 
 1598: }
