 1365: struct Node {
 1366: 
 1367:    // Geometry information
 1368:    int idx;        // Index of the node
 1369:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1370:    int numNodes;   // Number of nodes neighbors of this node
 1371: 
 1372:    Element **elements; // Array of pointers to the elements that share this node
 1373:    int numElements;    // Number of elements that share this node
 1374: 
 1375:    int numSides;       // Number of sides that are connected to this node
 1376: 
 1377:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1378:    double gz;          // Global vertical coordinate at the node.
 1379:    Vector2 u2[nvrt];
 1380:    double  w2[nvrt];
 1381:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1382:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1383:    double lon, lat;
 1384:    double depth;
 1385: 
 1386:    Frame<ics> frame;
 1387: 
 1388:    LocalSigma<ivcor> localSigma;  
 1389: 
 1390:    int kb;       // Bottom index of the node
 1391: 
 1392:    bool isDry;     // True if the node is dry
 1393: 
 1394:    int iadv;     // Advection flag
 1395: 
 1396:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1397:                           // this is nullptr
 1398: 
 1399:    TempVar tmp; // Temporary variable to store different types of variables
 1400: 
 1401:    // Physical information
 1402:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1403:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1404: 
 1405:    double rho[nvrt];     // Density
 1406:    double dfv[nvrt];     // Vertical viscosity
 1407: 
 1408:    double eta1; // Elevation at nodes at previous timestep
 1409:    double eta2; // Elevation at nodes at current timestep
 1410: 
 1411:    double ETP;  // Earth Tidal Potential
 1412: 
 1413:    double pr;    // Air pressure
 1414:    double grav2; // Gravity 
 1415:    
 1416:    Vector2 dav;  // Depth averaged velocity
 1417: 
 1418:    Vector2 tau; // Wind stress vector
 1419: 
 1420:    // Vegetation parameters
 1421:    double veg_h;
 1422:    double veg_nv;
 1423:    double veg_di;
 1424:    double veg_Cd;
 1425:    double veg_h_unbent;
 1426:    double veg_di_unbent;
 1427:    double veg_nv_unbent;
 1428:    double veg_alpha_vert_mean;
 1429:    double veg_alpha0;
 1430:    double veg_alpha3D[nvrt];
 1431: 
 1432:    // Bottom drag parameters
 1433:    double Cd;       // Bottom drag coefficient   
 1434: 
 1435:    // These three are mutually exclusive
 1436:    union {
 1437:       double rmanning; // Bottom Manning's coefficient
 1438:       double rough;    // Bottom roughness length
 1439:       double drag;     // Bottom drag coefficient
 1440:    };
 1441:    Vector2 tau_bot; // Bottom stress vector
 1442: 
 1443:    // XXXX REMOVE FOR IMM>0???
 1444:    double bdef1 = 0.0; // Bottom deformation at previous timestep
 1445:    double bdef2 = 0.0; // Bottom deformation at current timestep
 1446: 
 1447:    double qel; // RHS
 1448:    double coeffDiag; // Diagonal coefficient of the matrix
 1449:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1450: 
 1451:    // This was used by a previous version of the conjugate gradient method
 1452:    // double mP; // Search direction for conjugate gradient method
 1453:    // double mR; // Residual for conjugate gradient method
 1454:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1455: 
 1456:    double mX; // Solution of the FEM system
 1457: 
 1458:    // Meteorological forcing
 1459:    Vector2 u_air;
 1460:    double p_air;  // XXXX is this the same as pr?
 1461:    double t_air;
 1462:    double q_air;
 1463:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1464: 
 1465:    __device__ void setWind(Vector2 &u) {
 1466:    // Sets the wind vector taking into account the mesh angle
 1467:    
 1468:       const double speed = length(u);
 1469: 
 1470:       // Rotate wind vector to the node frame
 1471:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1472: 
 1473:       // Sets the surface stress vector due to wind.
 1474:       if constexpr(nws == 0) {
 1475:          tau = {0.0, 0.0};
 1476: 
 1477:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1478:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1479: 
 1480:       } else {
 1481: 
 1482:          double dragcoef;
 1483: 
 1484:          if constexpr(iwind_form == -1) {
 1485:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1486:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1487: 
 1488:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1489:             tau = cff*u_air;
 1490:  
 1491:          } else if constexpr(iwind_form == 1) {
 1492:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1493:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1494: 
 1495:             dragcoef = max(dragcoef, 4.0e-4);
 1496:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1497:             tau = cff*u_air;
 1498: 
 1499:          } else {
 1500:             tau = {0.0, 0.0};
 1501:          }
 1502:       }
 1503:    }
 1504: 
 1505: 
 1506:    __device__ void setFrame(double lat, double lon) {
 1507:       if constexpr(ics == 1) return;
 1508: 
 1509:       frame.update(lat, lon);        
 1510:     }
 1511: 
 1512:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1513: 
 1514:    __device__ double sigmaTransitionDepth(void) const;
 1515: 
 1516:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1517: 
 1518:    __inline__ __device__ Point2 outputCoords(void) const {
 1519:       if constexpr(ics == 1)  return p;
 1520:       else                    return {rad2deg*lon, rad2deg*lat};
 1521:    }
 1522: 
 1523:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1524:    // If ics == 2, convert the global point to the local frame
 1525:       
 1526:       if constexpr (ics == 1) {
 1527:          return p;
 1528:       } else {
 1529:          const Point3 c = {p.x, p.y, gz};
 1530:          const Point3 local = frame.G2L(p - c);
 1531:          return local;
 1532:       }
 1533:    }
 1534: 
 1535:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1536:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1537:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1538:    
 1539:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1540: 
 1541:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1542: 
 1543:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1544:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1545: 
 1546:    __device__ __forceinline__ void clearMatrixRow(void) {
 1547:       // Clear the matrix row for this node
 1548: 
 1549: 
 1550:       coeffDiag = 0.0;
 1551: 
 1552:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1553: 
 1554:    }
 1555: 
 1556:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1557:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1558:       
 1559:       if (node == this) {
 1560:          coeffDiag += value;
 1561:      
 1562:       } else {
 1563:          // Search (linearly) the index of the node in the array of nodes
 1564:          // XXX: This is not efficient, see if we can improve this
 1565:          int i;
 1566:          for (i = 0; i < numNodes; i++) {
 1567:             if (nodes[i] == node) {
 1568:                break;
 1569:             }
 1570:          }
 1571:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1572:          coeffMatrix[i] += value;
 1573:       }
 1574:    }
 1575: 
 1576: 
 1577:    __device__ __inline__ void updateZCoordData(void);
 1578: 
 1579:    __device__ __forceinline__ double compZCoord(int k) const;
 1580: 
 1581:    __device__ void updateKb(void);
 1582: 
 1583:    __device__ __forceinline__ void computeBottomDragCd(void);
 1584: 
 1585: 
 1586: 
 1587: };
