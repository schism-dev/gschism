 1643: // Helper functions for computing the local node index at a given offset from another.
 1644: __device__ __inline__ int nxq(int offset, int index, int size) {
 1645:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1646:    // to the index to make it positive
 1647:    assert(index + offset + 16*size >= 0);
 1648:    return (index + offset + 16*size) % size;  
 1649: }
 1650: 
 1651: __device__ __inline__ int nxq(int index, int size) {
 1652:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1653:    // to the index to make it positive
 1654:    assert(index + 16*size >= 0);
 1655:    return (index + 16*size) % size; 
 1656: }
