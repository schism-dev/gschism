  784: struct Side {
  785: 
  786:    // Geometry information
  787:    int idx;               // Index of the side
  788:    Node *n1, *n2;
  789:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  790: 
  791:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  792:    Vector2 center;        // Location of side center. 
  793:    double zc[nvrt];       // Side center z-coord at each vertical level
  794: 
  795:    Frame frame;
  796: 
  797:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  798:                           // this is nullptr
  799:    
  800:    int kb;                // Bottom index of the side
  801:    bool isDry;             // True if the side is dry
  802:  
  803:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  804: 
  805:    // Physical information
  806:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  807:    double  w2[nvrt];            // Vertical velocity at each vertical level
  808:    Vector2 btu[nvrt];           // Back-tracked velocity
  809:    Vector2 uth[nvrt];           // "Time history" velocity
  810:    Vector2 U;                   // Vertically averaged velocity vector  
  811: 
  812:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  813: 
  814:    Vector2 bcc[nvrt];           // Baroclinic term
  815: 
  816:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  817:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  818:    Vector2 gradPr;              // Gradient of pressure
  819:    Vector2 gradETP;             // Gradient of Earth Tidal Potential
  820: 
  821: 
  822:    double hhat;                 // \breve{H} in notes
  823: 
  824:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  825: 
  826:    double coriolis;             // Coriolis parameter
  827: 
  828:    // Vegetation parameters
  829:    double veg_c2;
  830:    double veg_beta;
  831: 
  832:    // Bottom drag parameters.
  833:    double chi;
  834:    double chi2;
  835: 
  836:    __inline__ __device__ double x(double t) const;
  837:    __inline__ __device__ double y(double t) const;
  838:    __inline__ __device__ Point2 p_t(double t) const;
  839: 
  840:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  841:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  842:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  843: 
  844:    __inline__ __device__ Side* neigh(int index) const { 
  845:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  846:       assert(index >= 0 && index < 4); 
  847:       assert(elems[0] != nullptr && elems[1] != nullptr);
  848: 
  849:       const int ielem = index & 1;           // 0 or 1
  850:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  851: 
  852:       const Element* elem = elems[ielem];
  853: 
  854:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  855: 
  856:       return elem->sides[elem->nxq(locSideIdx + iside)];
  857: 
  858:    }
  859: 
  860:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  861: 
  862:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  863: 
  864:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  865:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  866:    __inline__ __device__ int iadv(void) const;
  867: 
  868:    __inline__ __device__ double grav3(void) const;
  869:    
  870:    __inline__ __device__ double eta2(void) const;
  871:    __inline__ __device__ double eta1(void) const;
  872:    __inline__ __device__ double depth(void) const;
  873:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  874:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  875: 
  876:    __inline__ __device__ double dfv(int k) const;
  877: 
  878:    __inline__ __device__ double veg_h(void)  const;
  879:    __inline__ __device__ double veg_nv(void) const;
  880:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  881:    __inline__ __device__ double veg_alpha3D(int k) const;
  882:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  883: 
  884:    __inline__ __device__ double Cd(void) const;
  885: 
  886:    __inline__ __device__ Vector2 tau(void) const;
  887: 
  888:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  889:    
  890: 
  891:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  892:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  893:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  894:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  895:    } 
  896:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  897:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  898:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 1; }
  899:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 1; }
  900: 
  901:    // Get valid starting element (for backtracking)
  902:    __inline__ __device__ Element* getStartElement() {
  903:       return elems[0] ? elems[0] : elems[1];
  904:    }
  905: 
  906:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  907:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  908: 
  909:       // If one of the elements is null, return the other one
  910:       if      (elems[0] == nullptr) return elems[1];
  911:       else if (elems[1] == nullptr) return elems[0];
  912: 
  913: 
  914:       // Dot product of the negative velocity vector with the side normal vector
  915:       const double dot_prod1 = -dot(u, n);
  916:       
  917:       // Vector from side center to element 0 centroid
  918:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  919: 
  920:       // Dot product of the vector with the side normal vector
  921:       const double dot_prod2 = dot(v2, n);
  922: 
  923:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  924:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  925: 
  926:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  927:       else                           return elems[1];
  928: 
  929:  
  930:    }
  931: 
  932:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  933:       // Given an element, returns the other element that shares this side
  934:       return (elems[0] == elem) ? elems[1] : elems[0];
  935:    }
  936: 
  937:    __forceinline__ __device__ Node* otherNode(Node* node) {
  938:       // Given a node, returns the other node that shares this side
  939:       return (n1 == node) ? n2 : n1;
  940:    }
  941:  
  942:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  943: 
  944: 
  945: 
  946: 
  947: };
