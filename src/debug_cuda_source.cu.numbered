 3740: // /**
 3741: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 3742: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 3743: 
 3744: //    Inputs:
 3745: //    @param x1, y1: point inside the element
 3746: //    @param x2, y2: other end of the line segment
 3747: 
 3748: //    Outputs:
 3749: //    @param intersectingSide:  side that intersects the line segment
 3750: //    @param nextElement: element that contains the intersection point
 3751: //    @param xIntersect, yIntersect: intersection point  
 3752: 
 3753: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 3754: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 3755: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 3756: 
 3757: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 3758: //    (Delta) being zero.
 3759: 
 3760: //    The intersection point happens when:
 3761: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 3762: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 3763:    
 3764: //    Assumption: the 4 points (including those of the side segment) are different.
 3765: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 3766: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 3767: //    If true, (xIntersect,yIntersect) is the intersection.				
 3768: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 3769: // **/
 3770: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 3771: //                                                          Side& intersectingSide, Element& nextElement,
 3772: //                                                          double& xIntersect, double& yIntersect) {
 3773: //    for (int i = 0; i < i34; i++) {
 3774: //       const double x3 = nodes[i]->x;
 3775: //       const double y3 = nodes[i]->y;
 3776: //       const double x4 = nodes[nxq(i+1)]->x;
 3777: //       const double y4 = nodes[nxq(i+1)]->y;
 3778: 
 3779: //       const Side& side = sides[i];
 3780: 
 3781: //       xIntersect=-1.e25;
 3782: //       yIntersect=-1.e25;
 3783: 
 3784: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 3785: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 3786: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 3787: 
 3788: //       if (delta != 0.0) {
 3789: //          // Solves the two linear equations for tt1 and tt2
 3790: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3791: //          const double tt2 = delta2/delta;
 3792: 
 3793: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3794: //          // Similarly, we use tt2 to compute the intersection point.
 3795: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3796: //             xIntersect = x3 + (x4 - x3)*tt2;
 3797: //             yIntersect = y3 + (y4 - y3)*tt2;
 3798: 
 3799: //             intersectingSide = side;
 3800: //             nextElement = nghbElems[i];
 3801: 
 3802: //             return true;
 3803: //          }
 3804:       
 3805: //       }
 3806: //       else {
 3807: //          // The two segments are parallel
 3808: //          return false;
 3809: //       }
 3810: 
 3811: //    }
 3812: 
 3813: //    return false;
 3814: 
