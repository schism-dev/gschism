 9704: 
 9705: __global__ void returnMatrix(double *res) {
 9706:    // Debugging: dense local matrix, row-major, size = mesh->np
 9707:    // Assumes single-partition / local indexing (see note below).
 9708: 
 9709:    const int size = mesh->np;
 9710: 
 9711:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9712:       const Node *node = mesh->localNodeData + idx_node;
 9713: 
 9714:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9715: 
 9716:       for (int j = 0; j < node->numNodes; j++) {
 9717:          const Node *nbNode = node->nodes[j];
 9718:          // Only dump neighbors that live on this partition
 9719:          if (nbNode->part != mesh->partNum) continue;
 9720: 
 9721:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9722:          const double aij = node->coeffRow[node->csrSlot[j]];
 9723:          if (aij != 0.0)
 9724:             res[jlocal * size + idx_node] = aij;
 9725:       }
 9726:    }
 9727: }
