 4668:    __global__ void computeFlowBcVelocities(double time) {
 4669: 
 4670:       SIDE_BND(sideBnd);
 4671: 
 4672:       const Side *side = sideBnd->side;
 4673:  
 4674:       const bool isDry = side->isDry;
 4675: 
 4676:    
 4677: 
 4678:       if (isDry) {
 4679:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4680:          return;
 4681:       }
 4682: 
 4683:       // For wet sides in open boundaries...
 4684:       const Vector2 n = side->n;
 4685:       const BoundarySegment *segment = sideBnd->segment;
 4686: 
 4687:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4688: 
 4689:       const int ifltype = segment->ifltype;
 4690: 
 4691:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4692:       const Vector2 r_nuth0 = r_uth0*n;
 4693: 
 4694:       for (int k = 0; k < nvrt; k++) {
 4695:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4696:          Vector2 r_u1_bar = {0.0, 0.0};
 4697:       
 4698:          if (ifltype == 1 || ifltype == 2) {
 4699:          
 4700:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4701: 
 4702:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4703:             
 4704:             r_uth = unth0*n;  // This case has no ramp-up
 4705:             
 4706:          } else if (ifltype == -1) { // Flather 1
 4707: 
 4708:             // uth is the normal vel.; no ramp up
 4709:             const double uth = sideBnd->nuth(k);
 4710:             r_uth = uth*n;
 4711:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4712: 
 4713: 
 4714:          } else if (ifltype == 3 || ifltype == 5) {
 4715:             // vnth0=0 !normal vel.
 4716: 
 4717:             // Computes the contribution to the velocity from all tide frequencies
 4718:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4719: 
 4720:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4721:                const Vector2 umo  = sideBnd->umo(jfr); 
 4722: 
 4723:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4724:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4725:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4726:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4727:             }
 4728: 
 4729:          } // if (ifltype = 3 || ifltype == 5
 4730: 
 4731: 
 4732:          switch (ifltype) {
 4733:             case 1:
 4734:             case 2:
 4735:             case 4:
 4736:                sideBnd->ubc[k] = r_uth;
 4737:                break;
 4738:             case 3:
 4739:                sideBnd->ubc[k] = r_u1_bar;
 4740:                break;
 4741:             case 5:
 4742:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4743:                break;
 4744:          } // switch
 4745: 
 4746:       } // for k
 4747:    }
 4748: 
 4749:    __global__ void computeElevationBoundaryConditions(double time) {
 4750:       // Compute elevation essential boundary conditions 
 4751: 
 4752:       NODE_BND(nodeBnd); // Each boundary node.
 4753: 
 4754:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4755: 
 4756:       const Node *node = nodeBnd->node;
 4757:       const BoundarySegment *segment = nodeBnd->segment;
 4758:       const int iettype = segment->iettype;
 4759:       
 4760: 
 4761:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4762:       double eic = 0.0;
 4763:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4764:       else                 eic = 0.0;
 4765: 
 4766:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4767:       const double r_eth = ramp*nodeBnd->eth;
 4768:       double r_eta1_bar = 0.0;
 4769: 
 4770: 
 4771:       // Compute tide elevation
 4772:       if (iettype == 3 || iettype == 5) {   
 4773: 
 4774:          if constexpr(iloadtide==1) { // loading tide
 4775:             assert(false && "Loading tide not implemented");
 4776:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4777:          }
 4778:          
 4779:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4780: 
 4781:             const double efa  = nodeBnd->efa[jfr]; 
 4782:             const double emo  = nodeBnd->emo[jfr]; 
 4783: 
 4784:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4785:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4786:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4787: 
 4788:          } // for jfr
 4789: 
 4790:       } // if iettype
 4791: 
 4792:       switch (iettype) {
 4793:          case 1:
 4794:          case 2:
 4795:          case 4:
 4796:             nodeBnd->elbc = r_eic + r_eth;
 4797:             break;
 4798:          case 3:
 4799:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4800:             break;
 4801:          case 5:
 4802:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4803:             break;
 4804:       } // switch
 4805: 
 4806: 
 4807:       //Add inverse barometric effects
 4808:       if (iettype != 0 && inv_atm_bnd == 1) {
 4809:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4810:       }
 4811: 
 4812:    }
 4813: 
 4814: 
 4815:    __global__ void computeHorizontalViscosity(void) { 
 4816: 
 4817:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4818: 
 4819:       SIDE(side);
 4820: 
 4821:       if (side->isDry) return;
 4822: 
 4823:       for (int k = 0; k < nvrt; k++) {
 4824:          side->nuGradU[k] = {0.0, 0.0};
 4825:       }
 4826: 
 4827:       if constexpr(ihorcon == 1) {
 4828:          for (int k = side->kb; k < nvrt - 1; k++) {
 4829:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4830:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4831:             // By Zhang and Baptista.
 4832: 
 4833:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4834:             // This is a standard discretization of the Laplacian operator.
 4835:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4836:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4837:             // Gamma is hvis_coef0 in the code.
 4838:             // The value of gamma needs to be < 0.5.
 4839: 
 4840:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4841:             // side under consideration in each of the two possible elements that share the side.
 4842:             Vector2 sumU = {0.0, 0.0};
 4843:             for (int l = 0; l < 2; l++) {
 4844:                const Element *elem = side->elems[l];
 4845: 
 4846:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4847: 
 4848:                // Find the local index of the side in the element
 4849:                const int idxSide = elem->sideLocalIdx(side);
 4850:                // Find the two sides that are connected to the side under consideration
 4851:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4852:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4853: 
 4854:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4855: 
 4856:             }
 4857: 
 4858:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4859:    
 4860:          }
 4861:       }
 4862:       else if constexpr(ihorcon == 2) {
 4863:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4864:       }
 4865: 
 4866: 
 4867:    }
 4868: 
 4869: 
 4870:    __global__ void setEssentialBC(void) {
 4871:       // Set essential boundary conditions 
 4872:       NODE(node); // Each boundary node
 4873:       NodeBoundary *nodeBnd = node->nodeBnd;
 4874:       
 4875: // nodeBnd->isEssentialBC = true;      
 4876:       // Check if this node has essential BC
 4877:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4878:          // Verify BC value is valid
 4879:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4880: 
 4881:        
 4882:          // Set diagonal to 1 and zero off-diagonals
 4883:          node->coeffDiag = 1.0;
 4884: 
 4885:          for (int j = 0; j < node->numNodes; j++) {
 4886:                node->coeffMatrix[j] = 0.0;
 4887:          }
 4888:          
 4889:          // Set solution and RHS to BC value
 4890:          node->mX  = nodeBnd->elbc;
 4891:          node->qel = nodeBnd->elbc;
 4892: // printf("bbbbb\n");
 4893:       } else {
 4894:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4895: // printf("aaaaaa\n");
 4896:          for (int j = 0; j < node->numNodes; j++) {
 4897:                Node* nbNode = node->nodes[j];
 4898:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4899:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4900:                   // Verify neighbor's BC value
 4901:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4902: 
 4903:                   // Subtract contribution to RHS
 4904:                   // node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4905:                   node->coeffMatrix[j] = 0.0;  
 4906:                }
 4907:          }
 4908:       }
 4909:    }
 4910: 
 4911: 
 4912:    __global__ void updateElevation(void) {
 4913:       NODE(node);
 4914: 
 4915:       node->eta2 = node->mX;
 4916: 
 4917:       node->updateZCoordData();
 4918:    }
 4919: 
 4920: 
 4921:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4922: 
 4923:       SIDE(side);
 4924: 
 4925: 
 4926:       side->U = {0.0, 0.0}; 
 4927:          
 4928:       if(side->isDry) return;
 4929: 
 4930:       const Node *node1 = side->n1;
 4931:       const Node *node2 = side->n2;
 4932: 
 4933:       // Vertically integrated velocity U (in ll if ics=2)
 4934:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4935:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4936:       }
 4937: 
 4938:    }
 4939: 
 4940:    __global__ void computeBottomDragVegetation(void) {
 4941:       // UNFINISHED. CHECK THIS:
 4942:       // How many kernels are needed? Why so many for loops?
 4943:       // Is the loop on sides needed?
 4944: 
 4945:       NODE(node);
 4946: 
 4947: 
 4948:       const int    kb      = node->kb;
 4949:       const double htot    = node->htot2(); 
 4950:       const double rough   = node->rough;
 4951: 
 4952:       
 4953:       if (node->isDry) {
 4954:          // Default values for dry nodes
 4955:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4956:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4957: 
 4958:          return;
 4959:        
 4960:       }
 4961: 
 4962:       // Compute bottom drag Cd
 4963:       //--------------------------------
 4964: 
 4965:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4966:       if constexpr(nchi == 1) {
 4967: 
 4968:          bool ltmp = false; // for WBL iteration
 4969: 
 4970:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4971:          // Drag at nodes
 4972:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)   XXXXXXXXXXXX
 4973:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4974:         
 4975:          const double rough = node->rough;
 4976:         
 4977:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4978:          if (node->rough == 0.0) {
 4979:             node->Cd = 0.0;
 4980: 
 4981:          } else { //roughness >0 
 4982:           
 4983:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4984:             const double bthick = max(dzb_min, bthick_ori);
 4985: 
 4986:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4987: 
 4988:             double tmp = 1.0/(2.5*log(bthick/rough));
 4989:             node->Cd = tmp*tmp;
 4990: 
 4991:          } // if rough
 4992: 
 4993: 
 4994:          // RECOVER THIS: XXX
 4995:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4996:          // Output warning for WBL if iteration didn't converge
 4997: 
 4998: 
 4999:       } // nchi==1
 5000: 
 5001: 
 5002:       //   Bottom stress in m^2/s^2
 5003:       if (node->rho[kb + 1] >= -98.0)
 5004:       {
 5005:          const double mag_u = length(node->u2[kb + 1]);
 5006:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5007: 
 5008:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5009:          // !sediment erosion: this part needs more documentation
 5010:       }
 5011:     
 5012: 
 5013: 
 5014:       // Compute vegetation parameters
 5015:       //--------------------------------
 5016: 
 5017:       // SAV constants
 5018:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5019:       constexpr double veg_cfpsi = 0.16;
 5020: 
 5021:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5022:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5023: 
 5024:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5025:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5026:          int kbin = 0; // bin index
 5027:          for (int k = kb; k < nvrt; k++) {
 5028:             // Computes node height above the bottom level
 5029:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5030:             assert(false && "Vertical variation of vegetation not implemented");
 5031: 
 5032:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5033:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5034:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5035:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5036:             // } else {
 5037:             //    // Find the bin at which the current vertical level is
 5038:             //    while (kbin<nbins_veg_vert) {
 5039:             //       const double zn = node->z[kbin];
 5040:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5041:             //          break;
 5042:             //       } // if
 5043:             //       kbin++;
 5044:             //    } // while
 5045:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5046: 
 5047:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5048:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5049:                
 5050:             //    // Linear interpolation of the vegetation parameters
 5051:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5052:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5053:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5054:             // } // if rl10
 5055: 
 5056:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5057: 
 5058:          } // for k
 5059: 
 5060: 
 5061:       } else { // Ganthy (iveg==2)
 5062:       //  Modify canopy height, diameter, and density
 5063: 
 5064:          // Make sure there is vegetation on this node
 5065:          if (node->veg_h_unbent > 0.0) {
 5066:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5067: 
 5068:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5069:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5070:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5071: 
 5072:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5073:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5074:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5075:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5076:          } // if veg_h_unbent
 5077: 
 5078:          for (int k = 0; k < nvrt; k++) {
 5079:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5080:          } // for k
 5081:       
 5082: 
 5083:       } // if iveg
 5084:      
 5085: 
 5086:       // Compute vertical mean of veg_alpha3D
 5087:       if (iveg != 0) {
 5088:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5089:          double sum1=0.0;
 5090:          double sum2=0.0;
 5091:          // Integrate over each level under the canopy...
 5092:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5093:             const double Dz = node->Dz(k);
 5094: 
 5095:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5096:             sum2 += Dz;
 5097: 
 5098:          } // for k
 5099:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5100:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5101: 
 5102:       } // if iveg
 5103: 
 5104:    }
 5105: 
 5106:    __global__ void computeVegetationAndDragParameters(void) {
 5107:       // Computes the vegetation and drag model parameters:
 5108:       // chi, \tilde\chi, beta, \breve{H}
 5109:       
 5110:       SIDE(side);
 5111: 
 5112:       if (side->isDry) return;
 5113: 
 5114:       const double htot = side->htot2();
 5115:       const int    kb   = side->kb;
 5116: 
 5117:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5118: 
 5119:       const double veg_h     = side->veg_h();
 5120:       const double veg_nv    = side->veg_nv();
 5121:       const double veg_c     = side->veg_c();
 5122:       const double veg_beta  = side->veg_beta;
 5123:       const double veg_alpha = side->veg_alpha_vert_mean();
 5124: 
 5125:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5126:       // Velocity magnitude at the bottom level
 5127:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5128:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 5129:       side->chi2 = side->Cd()*vmag1;
 5130:       side->chi  = side->chi2;
 5131:       if constexpr(iveg != 0) {
 5132:          const Node *n1 = side->n1;
 5133:          const Node *n2 = side->n2;
 5134:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5135:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5136:       }
 5137: 
 5138:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5139: 
 5140:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5141:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5142:       double magUa = 0.0;
 5143:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5144:          // 3D wet side with veg...
 5145: 
 5146:          double magUa = 0.0;
 5147:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5148:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5149: 
 5150:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5151:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5152:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5153: 
 5154:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5155:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5156: 
 5157:                // Velocity magnitude at the bottom (l) of the level
 5158:                const double ul = length(side->u2[k]);
 5159: 
 5160:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5161:                magUa += Dz*0.5*(uh + ul);
 5162: 
 5163:             } // if HasVegetation
 5164:          } // for k
 5165:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5166: 
 5167:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5168:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5169:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5170:             const double zCpy = side->zTopCanopy();
 5171:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5172:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5173:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5174:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5175:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5176:          } // if isSubmerged
 5177:       } // if iveg   
 5178: 
 5179:       // Computes the friction modified depth, \breve{H} in notes
 5180:       if (side->is2D()) { // 2D
 5181: 
 5182:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5183:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5184: 
 5185:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5186: 
 5187:          side->hhat = htot*htot/fricH; 
 5188: 
 5189:       } else { // 3D
 5190:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5191: 
 5192:          if constexpr(iveg != 0) {
 5193:             
 5194:             if (side->isSubmerged()) { 
 5195:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5196:                side->hhat -= veg_c*Hhat_alpha;
 5197: 
 5198:             } else { // Emergent
 5199:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5200:             }
 5201:          } // if iveg
 5202: 
 5203:          // Enforce positivity for 3D model
 5204:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5205:       } // if 3D
 5206: 
 5207:    }
 5208: 
 5209: 
 5210: 
 5211:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5212:    // Computes the density gradient between two elements, e1 and e2.
 5213:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5214:    // zero in the direction normal to the side. 
 5215:    // 
 5216:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5217:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5218:    //
 5219:    // Input:
 5220:    //    e1: Element
 5221:    //    e2: Neighbor element (or nullptr if boundary)
 5222:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5223:    //    k: Index of the half-level at which the density is interpolated
 5224:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5225:    // 
 5226:    // Output:
 5227:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5228:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5229: 
 5230:       if (e2 == nullptr || e2->isDry) {
 5231:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5232: 
 5233:          Side *side = e1->sides[j];
 5234:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5235:                  
 5236:          if constexpr(ics == 1) {
 5237:             vec = side->n; // Normal vector to the side
 5238:          } else {
 5239:             // IMPLEMENT THIS XXXXXX
 5240:             // !replace with xel, yel?
 5241:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5242:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5243:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5244:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5245:          } //ics
 5246:                    
 5247:          diffRho = 0.0;
 5248: 
 5249:       } else { //internal and wet
 5250:          if constexpr(ics==1) {
 5251:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5252: 
 5253:             // Vector from e1 to e2
 5254:             vec = e2->center - e1->center;
 5255: 
 5256:          } else { 
 5257:             // IMPLEMENT THIS XXXXXX
 5258:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5259:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5260:             //                   alow(j)=xctr2
 5261:             //                   bdia(j)=yctr2
 5262:          } // ics
 5263: 
 5264:          diffRho = rho2 - e1->demeanedDensity(k);
 5265:       }
 5266: 
 5267:    }
 5268: 
 5269:    __global__ void computeDensityCubicSplines(void) {
 5270:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5271: 
 5272:       ELEM(elem);
 5273: 
 5274:       if (elem->isDry) return;
 5275: 
 5276:       const int kb = elem->kb;
 5277: 
 5278:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5279:       if (elem->is2D()) {
 5280:          // In the 2D case, the density is constant at the prism level. 
 5281:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5282:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5283:       } else { //3D
 5284: 
 5285:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5286:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5287:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5288:          ///// XXXX CHECK INDICES!!!!!
 5289:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5290:       } // 2D/3D
 5291: 
 5292:    }
 5293: } // extern "C"
 5294: 
 5295: 
 5296: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5297: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5298: 
 5299:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5300: 
 5301:    const int kb  = elem->kb;
 5302:    const int kb2 = elem2->kb;
 5303: 
 5304:    // z-coordinate of prism of elem
 5305:    const double zp = elem->z_prism(k);
 5306: 
 5307:    double rho = 0.0;
 5308: 
 5309:    if (elem2->is2D()) {
 5310:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5311: 
 5312:    } else {  // 3D
 5313: 
 5314:       // eta_min may be < zmax
 5315:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5316:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5317: 
 5318:       // (Extrapolate density below bottom, we will fix it later)
 5319:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5320:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5321:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5322:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5323:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5324:    } // 2D/3D
 5325:      
 5326: 
 5327:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5328:    // Now we need to fix it.
 5329:    if (elem->z[k] < elem2->z[kb2]) {
 5330:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5331: 
 5332:       // There are two methods to adjust the density at the bottom of the element.
 5333:       // iunder_deep=0: 
 5334:       const double depth1 = abs(elem->z[kb]); // larger depth
 5335: 
 5336:       if (iunder_deep==0) {
 5337: 
 5338:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5339: 
 5340:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5341: 
 5342:       } else { // iunder_deep != 0
 5343: 
 5344:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5345: 
 5346:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5347: 
 5348:          //   Demeaned density at the same z coordinate as
 5349:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5350:          }
 5351: 
 5352:       } // if iunder_deep
 5353:    } // if elem->z[kb] < elem2->z[kb]
 5354: 
 5355:    return rho;
 5356: }
 5357: 
 5358: 
 5359: extern "C" {
 5360:    __global__ void computeDensityGradient(void) {
 5361: 
 5362:       if constexpr(ibc != 0) return;
 5363: 
 5364:          // Compute the horizontal density gradient at each element.
 5365:       // It works in two steps:
 5366:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5367:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5368:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5369:       //             gradRho.r1 = rho1 - rho0
 5370:       //             gradRho.r2 = rho2 - rho0
 5371:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5372:       // 
 5373:       //  NOTE: We use de-meaned densities.
 5374: 
 5375:       ELEM(elem);
 5376: 
 5377:       if (elem->isDry) return;
 5378: 
 5379:       const int kb  = elem->kb;
 5380:       const int i34 = elem->i34;
 5381: 
 5382:       for (int k = kb + 1; k < nvrt; k++) {
 5383:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5384:          //             gradRho.r1 = rho1 - rho0
 5385:          //             gradRho.r2 = rho2 - rho0
 5386:          int icount = 0;
 5387:          double sumRx = 0.0;
 5388:          double sumRy = 0.0;
 5389:          for (int j1=0; j1<i34; j1++) { 
 5390: 
 5391:             const int j2 = elem->nxq(j1 + 1);
 5392: 
 5393:             // Pairs of consecutive neighbor elements of elem
 5394:             const Element *e1 = elem->nghbElems[j1];
 5395:             const Element *e2 = elem->nghbElems[j2];
 5396: 
 5397:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5398:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5399:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5400: if (elem->idx == 21) printf("$$AAAXXXXXXXA$$$ rho1 = %.16f, rho2 = %.16f\n", rho1, rho2);            
 5401: 
 5402:             // Compute the density difference and the vector from elem to e1 and e2
 5403:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5404:             double diffRho1, diffRho2;
 5405:             Vector2 vec1, vec2;
 5406:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5407:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5408: 
 5409:             const double rl1 = length(vec1);
 5410:             const double rl2 = length(vec2);
 5411:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5412: 
 5413:             const double delta = cross(vec1, vec2);
 5414:             const double sintheta = abs(delta)/(rl1*rl2);
 5415: 
 5416:             // To avoid problems, avoid elements with small angle between vectors
 5417:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5418:             const bool validEq = (sintheta > sin_one_deg);
 5419: 
 5420:             if (validEq) {
 5421:                // Solve the system of equations to get the density gradient at elem
 5422:                icount++;
 5423:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5424:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5425:                sumRx += Rx;
 5426:                sumRy += Ry;
 5427:             }
 5428:          } // for j1
 5429: 
 5430:          // Compute the average density gradient at elem
 5431:          if (icount==0) {
 5432:            // Bad mesh quality; bail out with 0 b-cc
 5433:            elem->gradRho[k] = {0.0, 0.0};
 5434:          } else {
 5435:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5436:          }
 5437: 
 5438:       } // for k
 5439: 
 5440:    }
 5441: 
 5442:    __global__ void computeBaroclinicTerm(void) {
 5443:    // Computes the baroclinic term at sides (at half levels).
 5444:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5445:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5446: 
 5447:       if (ibc == 1) return;
 5448: 
 5449:       SIDE(side);
 5450: 
 5451:       if (side->isDry) return;
 5452: 
 5453:       const Element *e1 = side->elems[0];
 5454:       const Element *e2 = side->elems[1];      
 5455:       const int kb = side->kb;
 5456:       
 5457:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5458: 
 5459:       // interpolates vertically the density gradient of the two elements at the half level/
 5460: 
 5461:       int k1 = max(kb, nvrt / 2);
 5462:       int k2 = max(kb, nvrt / 2);
 5463: 
 5464:       // Starts the integration at the surface and goes down to the bottom
 5465:       side->bcc[nvrt-1] = {0.0, 0.0};
 5466:       for (int k = nvrt - 2; k >= kb; k--) {
 5467:       // For each prism level (from surface to bottom)...
 5468: 
 5469:          // For both elements, interpolate density gradient at the side's half level.
 5470:          // The gradient at the side is the average of the gradients at the elements.
 5471:          // w1, w2 are used to take into account boundary sides, with just one element.
 5472:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5473:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5474:          const double wsum = w1 + w2;
 5475:          w1 = w1/wsum;
 5476:          w2 = w2/wsum;
 5477:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5478: 
 5479:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5480:          Vector2 gradRho = {0.0, 0.0};
 5481:          if (e1 != nullptr && k > kb) {
 5482:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5483:             
 5484:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5485:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5486:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5487: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5488:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5489:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5490:          }      
 5491:          if (e2 != nullptr && k > kb) {
 5492:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5493:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5494:             
 5495:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5496:          }
 5497: 
 5498:          if constexpr(ics==2) {
 5499:             assert(false && "Not implemented: ics == 2");
 5500:             // IMPLEMENT THIS XXXXXX
 5501:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5502:             // swild(1)=tmp1
 5503:             // swild(2)=tmp2
 5504:          }
 5505:          
 5506:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5507:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5508:          // CHECK INDICES!!! XXX
 5509:          const double grav3 = side->grav3();
 5510:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5511: 
 5512:       } // for
 5513: 
 5514:    }
 5515: 
 5516: 
 5517: 
 5518:    __global__ void computeHorGradientAtSide(void) {
 5519: 
 5520:       // Compute the horizontal density gradient at each element.
 5521:       // It works in two steps:
 5522:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5523:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5524:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5525:       //             gradRho.r1 = rho1 - rho0
 5526:       //             gradRho.r2 = rho2 - rho0
 5527:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5528:       // 
 5529:       //  NOTE: We use de-meaned densities.
 5530: 
 5531:       SIDE(side);
 5532: 
 5533: // printf("side->isDry: %d\n", side->isDry);
 5534:       if (side->isDry) return;
 5535: 
 5536:       // Computes the gradient of the variables at the side center.
 5537:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5538:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5539:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5540: 
 5541:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5542:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5543:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5544:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5545: 
 5546: 
 5547:    }
 5548: 
 5549: 
 5550:    __global__ void solveMomentumEquations(double time) {
 5551: 
 5552:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5553:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5554: 
 5555:       SIDE(side);
 5556: 
 5557:       if (side->isDry) 
 5558:       {
 5559:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5560: 
 5561:          return;
 5562:       }
 5563: 
 5564:       const Node *n1 = side->n1;
 5565:       const Node *n2 = side->n2;
 5566: 
 5567:       const int kb = side->kb;
 5568: 
 5569:       const double veg_h = side->veg_h();
 5570:       const double grav3 = side->grav3();
 5571: 
 5572:       if (side->is2D()) {
 5573:          // Warning: Do not use htot2, which is updated.
 5574:          const double htot = side->htot1();
 5575:          const double hhat = side->hhat;
 5576: 
 5577:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5578: 
 5579:          Vector2 tau2 = {0.0, 0.0};
 5580:           
 5581:          if constexpr(ics==1) {
 5582:             tau2 = side->tau();
 5583: 
 5584:          } else {
 5585:             assert(false && "Not implemented: ics == 2");
 5586:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5587:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5588:             // taux2=(vn1+tt1)*0.5d0
 5589:             // tauy2=(vn2+ss1)*0.5d0
 5590:          } // if ics         
 5591: 
 5592:          // hat_gam has units of m/s
 5593: 
 5594:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5595: 
 5596:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5597:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5598: 
 5599:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5600: 
 5601: 
 5602:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5603:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5604: 
 5605:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5606: 
 5607: 
 5608:       }
 5609:       else { // 3D
 5610: 
 5611:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5612:          // 
 5613:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5614:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5615:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5616:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5617:          // k+1 and k.
 5618: 
 5619: 
 5620:    
 5621: 
 5622: 
 5623:          const int ndim = nvrt - kb;
 5624:          const double zTopCanopy = side->zTopCanopy();
 5625: 
 5626:          // Initialize the tridiagonal system
 5627:          for (int k = kb + 1; k < nvrt; k++) {
 5628:             
 5629:             const int kin = k - (kb + 1);
 5630: 
 5631:             // Vertical viscosity at the face center
 5632:             const double dfz = 1e-6; //0.5*(side->dfv(k) + side->dfv(k + 1)); XXXXX
 5633:            
 5634: 
 5635:             alow[kin] = 0.0;
 5636:             cupp[kin] = 0.0;
 5637:             bdia[kin] = 0.0;
 5638: 
 5639:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5640:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5641: 
 5642:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5643:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5644:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5645: 
 5646:             // First part: layers k, k+1
 5647:             if (k < nvrt - 1) {
 5648:                              
 5649:                if constexpr(iveg != 0) {
 5650: 
 5651:                   // If there is vegetation at this level...
 5652:                   if (zTopCanopy > side->zc[k]) {
 5653:                      // If the canopy is above the k layer...
 5654:                      
 5655:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5656:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5657:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5658:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5659: 
 5660:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5661:                      const double vmag2 = length(ut2);
 5662:                      const double vmag1 = length(side->u2[k]);
 5663:                      const double vmag = 0.5*(vmag1 + vmag2);
 5664:                      
 5665:                      // Computes the vegetation alpha at the face center
 5666:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5667: 
 5668:                      cff1 += veg_alpha_sd*dt*vmag;
 5669: 
 5670:                   } // if (zTopCanopy
 5671:                } // if iveg
 5672: 
 5673:                const double dzz = side->Dz(k + 1);
 5674:                const double tmp = dt*dfz/dzz;
 5675:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5676: 
 5677:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5678:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5679:             }
 5680: 
 5681: 
 5682:             // Second part: layers k-1, k
 5683:             if (k > kb + 1) {
 5684: 
 5685:                double cff1 = 1.0; //init \bar{c^k}
 5686: 
 5687:                if constexpr(iveg != 0) {
 5688:                   // If there is vegetation at this level...
 5689:                   if (zTopCanopy > side->zc[k-1]) {
 5690:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5691:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5692: 
 5693:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5694: 
 5695:                      const double vmag2 = length(ut2);
 5696:                      const double vmag1 = length(side->u2[k-1]);
 5697:                      const double vmag = 0.5*(vmag1 + vmag2);
 5698: 
 5699:                      // Computes the vegetation alpha at the face center
 5700:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5701:                      cff1 += veg_alpha_sd*dt*vmag;
 5702:                   } // if zTopCanopy
 5703: 
 5704:                } // if iveg
 5705: 
 5706:                const double dzz = side->Dz(k);
 5707:                const double tmp = dt*dfz/dzz;
 5708:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5709: 
 5710:                alow[kin] += cff1*dzz/6.0 - tmp;
 5711:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5712: 
 5713:             } else { // Bottom boundary
 5714:                // This occurs at the bottom, where the bottom drag is applied.
 5715: 
 5716:                bdia[kin] += dt*side->chi2; // XXXX
 5717: 
 5718: 
 5719:             } // if (k > kb + 1)
 5720: 
 5721: 
 5722: 
 5723:          } // for (int k
 5724: 
 5725: 
 5726: 
 5727:          // Computes the RHS.
 5728:          // -----------------
 5729: 
 5730:          //	BC to be imposed at the end.
 5731: 
 5732:          const Vector2 gradETP  = side->gradETP;
 5733:          const Vector2 gradPr   = side->gradPr;
 5734:          const Vector2 gradEta1 = side->gradEta1;
 5735:          const Vector2 gradEta2 = side->gradEta2;
 5736: 
 5737:          const Vector2 *btu = side->btu;
 5738:          const Vector2 *u2  = side->u2;
 5739:          const double coriolis = side->coriolis;
 5740:          const Vector2 *nuGradU = side->nuGradU;
 5741: 
 5742: 
 5743:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5744: 
 5745:          for (int k = kb + 1; k < nvrt; k++) {
 5746:             const int kin = k - kb - 1;
 5747: 
 5748:             const double dz_0 = side->Dz(k);
 5749:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5750: 
 5751:             rrhs[kin] = {0.0, 0.0};
 5752:             double dz = 0.0;
 5753: 
 5754:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5755:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5756:             if (k < nvrt  ) dz += dz_1;
 5757:             if (k > kb + 1) dz += dz_0;
 5758: 
 5759:             // Elevation gradient, atmospheric pressure and tidal potential
 5760:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5761: 
 5762:             // Coriolis, advection, wind stress, and horizontal viscosity
 5763:             if (k < nvrt - 1) {
 5764: 
 5765: 
 5766:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5767:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5768:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5769:                                                 
 5770: // if (side->idx == 21) printf("$$BBBB$$$ dz_1 = %.16f, coriolis = %.16f, btu[%d] = %.16f, %.16f, u2[%d] = %.16f, %.16f, nuGradU[%d] = %.16f, %.16f\n", dz_1, coriolis, k, btu[k].x, btu[k].y, k, u2[k].x, u2[k].y, k, nuGradU[k].x, nuGradU[k].y);            
 5771:                //diff stress tensors 1006
 5772:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5773:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5774:                   assert(false && "Not implemented: itur == 5");
 5775:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5776:                }
 5777: 
 5778:             } else { // k == nvrt - 1 SURFACE
 5779:                Vector2 tau2 = {0.0, 0.0};
 5780:                if constexpr(ics==1) {
 5781:                   tau2 = side->tau();
 5782:       
 5783:                } else {
 5784:                   assert(false && "Not implemented: ics == 2");
 5785:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5786:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5787:                   // taux2=(vn1+tt1)*0.5d0
 5788:                   // tauy2=(vn2+ss1)*0.5d0
 5789:                } // if ics
 5790: 
 5791:                rrhs[kin] += dt*tau2;
 5792: 
 5793:             } // if k<nvrt
 5794: 
 5795:             if (k > kb + 1) {
 5796:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5797:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5798:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5799: 
 5800:                // diff stress tensors 1006
 5801:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5802:                   assert(false && "Not implemented: itur == 5");
 5803:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5804:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5805:                }
 5806: 
 5807:             } // if k>kbs + 1
 5808: 
 5809:             // Baroclinic
 5810:             Vector2 *bcc = side->bcc;
 5811:             if constexpr(ibc == 0) {
 5812:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5813:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5814: 
 5815:             } // if ibc==0
 5816: 
 5817:          } // k=kb + 1,nvrt
 5818: 
 5819: 
 5820:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5821: 
 5822:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5823:             const int kin = k - kb - 1;
 5824: 
 5825:             // Velocity is always clamped to maximum values
 5826:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5827:          } // k
 5828: 
 5829:       } // if side->is2D()
 5830:       
 5831: 
 5832:       // Impose velocity boundary condition at the bottom
 5833:       if constexpr(imm == 2) { // 3D bed deformation model
 5834:          double dep;
 5835:          Vector2 vel;
 5836: 
 5837:          assert(false && "Not implemented: imm == 2");
 5838:          //update_bdef(time, x0, y0, dep, vel);
 5839:          // side->u2[kb] = vel;
 5840: 
 5841:       } else { // imm = 0 or 1
 5842:          if (side->Cd() == 0.0) {
 5843:             side->u2[kb] = side->u2[kb + 1];
 5844: 
 5845:          } else if (side->is3D()) { // 3D no slip bottom   
 5846:             side->u2[kb] = {0.0, 0.0};
 5847:          }
 5848:           
 5849:       } // if imm
 5850: 
 5851:       // The velocities below the bottom level are set to zero
 5852:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5853: 
 5854: 
 5855:    }
 5856: 
 5857: 
 5858:    __global__ void applyMomentumBC(void) {
 5859: 
 5860:       SIDE_BND(sideBnd);
 5861: 
 5862:       Side *side = sideBnd->side;
 5863:       const BoundarySegment *segment = sideBnd->segment;
 5864:       const Node *n1 = side->n1;
 5865:       const Node *n2 = side->n2;
 5866: 
 5867:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5868: 
 5869:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5870:       const bool isLand = segment->isLand;
 5871:       const int ifltype = segment->ifltype;
 5872: 
 5873:       const int kb = side->kb;
 5874: 
 5875:       if (!isLand && ifltype != 0) {
 5876:          const Vector2 *ubc = sideBnd->ubc;
 5877:   
 5878:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5879:             
 5880:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5881:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5882: 
 5883:             if (ifltype == -1) {
 5884:                // Flather 1
 5885: 
 5886:                const double depth = side->depth();
 5887: 
 5888:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5889: 
 5890:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5891: 
 5892:                side->u2[k] = vnorm*side->n;
 5893: 
 5894:             } else if (ifltype == -2) { // Discharge
 5895: 
 5896:                const double eta1 = side->eta1();
 5897:                const double eta2 = side->eta2();
 5898:                const double htot = side->htot2();
 5899: 
 5900:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5901:                assert(false && "Not implemented: Discharge bc");
 5902:                // const double dischrg = discharge(eta1);
 5903:                const double dischrg = 0.0; // XXX REMOVE
 5904:                
 5905: 
 5906:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5907: 
 5908:                const double vnorm = dischrg*eta2/htot;
 5909: 
 5910:                side->u2[k] = vnorm*side->n;
 5911: 
 5912:             }
 5913:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5914:                const double vnorm = dot(side->u2[k], side->n);
 5915: 
 5916:                double rat;
 5917:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5918:                else              rat = segment->vobc2; // outgoing
 5919: 
 5920:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5921: 
 5922:             }
 5923:             else { // not Flather or 3D radiation
 5924:                side->u2[k] = ubc[k];
 5925: 
 5926:             } // if (segment->ifltype...
 5927: 
 5928:          }
 5929: 
 5930:       }
 5931:       else if (isLand) { // if it is land boundary side
 5932: 
 5933:          if constexpr(islip == 0) { // free slip
 5934: 
 5935:             for (int k = kb; k < nvrt; k++) {
 5936: 
 5937:                const Vector2 t = side->t();
 5938:                const Vector2 n = side->n;
 5939: 
 5940:                double vnorm = 0.0; // for most cases
 5941:                const double vtan = dot(side->u2[k], t);
 5942:                
 5943:                side->u2[k] = vtan*t - vnorm*n;
 5944: 
 5945:             }
 5946: 
 5947:          } else { // no slip
 5948:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5949: 
 5950:          }
 5951:       } // if (side segment type...
 5952: 
 5953:    
 5954: 
 5955:    }
 5956: 
 5957: 
 5958:    __global__ void shapiroFilter1(void) {
 5959:       // First step of the Shapiro filter (normally used if indvel<=0)
 5960:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5961: 
 5962:       SIDE(side);
 5963: 
 5964:       // Only internal wet sides are processed
 5965:       if (side->isDry || !(side->isInternal())) return;
 5966: 
 5967:       const int kb = side->kb;
 5968: 
 5969:       for (int mm = 0; mm < niter_shap; mm++) {
 5970: 
 5971:          for (int k = kb + 1; k < nvrt; k++) {
 5972:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5973:             Vector2 suru = {0.0, 0.0};
 5974: 
 5975:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5976: 
 5977:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5978: 
 5979:                int kin = k;
 5980:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5981:                
 5982:                if constexpr(ics==1) {
 5983:                   suru += nSide->u2[kin];
 5984: 
 5985:                } else {
 5986:                   assert(false && "Not implemented: ics == 2");
 5987:                   // Vector2 vn1, vn2;
 5988:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5989:                   // suru=suru+vn1;
 5990:                   // surv=surv+vn2;
 5991:                }
 5992:             }
 5993: 
 5994: 
 5995:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5996: 
 5997:          }
 5998:       }
 5999:    }
 6000: 
 6001:    __global__ void shapiroFilter2(void) {
 6002:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6003: 
 6004:       SIDE(side);
 6005: 
 6006:       if (side->isDry || !(side->isInternal())) return;
 6007: 
 6008:       const int kb = side->kb;
 6009: 
 6010:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6011: 
 6012:       if (side->is2D()) {
 6013:          side->u2[kb + 1] = side->bcc[kb + 1];
 6014:          side->u2[kb    ] = side->u2 [nvrt - 1];
 6015: 
 6016:       } else {
 6017:          // 3D
 6018:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6019:          
 6020:       }
 6021: 
 6022:    }
 6023: 
 6024: 
 6025:    __global__ void ul0UpdateZCoords(void) {
 6026:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6027:       
 6028:       NODE(node);      
 6029: 
 6030: 
 6031:       if (node->isDry2()) { 
 6032: 
 6033:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6034: 
 6035:          if constexpr(ivcor != 1) node->kb = 0;
 6036: 
 6037:       } else {
 6038: 
 6039:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6040:          node->updateKb();
 6041: 
 6042:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6043: 
 6044:       }
 6045: 
 6046:       // We use the temp.b field to store the previous state of isDry.
 6047:       node->tmp.b = node->isDry;
 6048: 
 6049:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6050:       node->isDry = true;
 6051: 
 6052:    }
 6053: 
 6054:    __global__ void ul0ComputeDryElementsAndNodes(void)
 6055:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 6056:    {
 6057:       ELEM(elem);
 6058: 
 6059:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 6060: 
 6061:       // All the nodes of a wet element are wet.
 6062:       if (!elem->isDry) {
 6063:          elem->nodes[0]->isDry = false;
 6064:          elem->nodes[1]->isDry = false;
 6065:          elem->nodes[2]->isDry = false;
 6066:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 6067: 
 6068:       }
 6069: 
 6070: 
 6071:       elem->kb = 0;
 6072: 
 6073:       if (elem->isDry) return;
 6074: 
 6075:       // Wet
 6076:       const Node *n1 = elem->nodes[0];
 6077:       const Node *n2 = elem->nodes[1];
 6078:       const Node *n3 = elem->nodes[2];  
 6079:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 6080: 
 6081:    //    if(elem->isDry2()) {
 6082:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6083:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6084:    //        call parallel_abort(errmsg)
 6085:    //    }
 6086: 
 6087: 
 6088:       // Computes element's kb as the minimum of the nodes' kb.
 6089:       const int kb1 = n1->kb;
 6090:       const int kb2 = n2->kb;
 6091:       const int kb3 = n3->kb;
 6092:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6093: 
 6094: 
 6095:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6096: 
 6097: 
 6098:       // Computes the element z as the mean of the nodes z.
 6099:       for (int k = elem->kb; k < nvrt; k++) {
 6100: 
 6101:          // Compute the element z as the mean of the nodes z.
 6102:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 6103:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6104:          elem->z[k] /= elem->i34;
 6105: 
 6106:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6107:       }
 6108:                   
 6109:    }
 6110: 
 6111:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6112:    {
 6113:       NODE(node);
 6114:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6115: 
 6116:       if (it == iths) return;
 6117: 
 6118: 
 6119:       if(!node->isDry && node->tmp.b) { // rewetted
 6120:          for (int k=0; k < nvrt; k++) {
 6121: 
 6122:             Vector3 utmp={0.0, 0.0, 0.0};
 6123: 
 6124:             double ttmp=0.0;
 6125:             double stmp=0.0;
 6126:             int icount=0;
 6127:             for (int j = 0; j < node->numNodes; j++) {
 6128: 
 6129: 
 6130:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 6131:                if (!node->isDry) { // all indices extended
 6132:                   icount++;
 6133: 
 6134:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6135:                   utmp += node->uvw2(k);
 6136:                   
 6137:                   ttmp += node->tracers[k].tracer[0]; 
 6138:                   stmp += node->tracers[k].tracer[1]; 
 6139:                }
 6140:             }
 6141: 
 6142:             if(icount > 0) {
 6143:                const double inv_icount = 1.0/icount;
 6144:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 6145:                node->w2[k]     = inv_icount*utmp.z;
 6146:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6147:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6148:             }
 6149:          }
 6150:       }
 6151:    }
 6152: 
 6153: 
 6154:    __global__ void ul0UpdateSides(int it, int iths) {
 6155: 
 6156:       SIDE(side);
 6157: 
 6158:       // A side is wet if and only if at least one of its elements is wet.
 6159:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6160: 
 6161:       const Node *n1 = side->n1;
 6162:       const Node *n2 = side->n2;
 6163:       const int kb1 = n1->kb;
 6164:       const int kb2 = n2->kb;
 6165: 
 6166:       side->kb = 0; // dry
 6167: 
 6168:       if (isWet) {
 6169: 
 6170:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6171: 
 6172:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6173: 
 6174:          side->kb = min(kb1, kb2);
 6175: 
 6176:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6177: 
 6178:          for (int k = side->kb; k < nvrt; k++) {
 6179:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6180: 
 6181:          
 6182:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 6183: 
 6184:             // Compute velocity for re-wetted sides 
 6185:             if ((it != iths) && (side->isDry && isWet)) {
 6186:             
 6187:                Vector2 utmp={0.0, 0.0};
 6188: 
 6189:                int icount=0;
 6190: 
 6191:                // For all the sides on the two elements that share this side
 6192:                for (int j=0; j < 2; j++) {
 6193:                   const Element *elem = side->elems[j];
 6194:                   if (elem == nullptr) continue;
 6195: 
 6196:                   for (int jj=0; jj < elem->i34; jj++) {
 6197:                      const Side *nSide = elem->sides[jj];
 6198:                      if (nSide->isDry) continue;
 6199: 
 6200:                      icount++;
 6201:                      utmp += nSide->u2[k];                     
 6202:                   }
 6203:                }
 6204:                   
 6205:                assert(icount > 0 && "No wet sides around this side");
 6206:                if (icount > 0)  side->u2[k] = utmp/icount;
 6207:                   
 6208:             } // if ((it != iths) && (side->isDry && isWet))
 6209: 
 6210:          } // for k
 6211: 
 6212:       } // if isWet
 6213:    
 6214:       side->isDry = !isWet;
 6215: 
 6216:    }
 6217: 
 6218: 
 6219:    __global__ void zeroNodalVelocities(void) {
 6220:       NODE(node);
 6221: 
 6222:       for (int k = 0; k < nvrt; k++) {
 6223:          node->u2[k]   = {0.0, 0.0};
 6224:          node->w2[k]   = 0.0;
 6225:          node->utmp[k] = {0.0, 0.0};
 6226:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6227:       }
 6228:    }
 6229: 
 6230:  
 6231: 
 6232:    __global__ void computeNodalVerticalVelocities1(void) {
 6233:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6234:    // Adds the element's vertical velocity times the element's area.
 6235:       ELEM(elem);
 6236: 
 6237:       for (int j = 0; j < elem->i34; j++) {
 6238:          Node *node = elem->nodes[j];
 6239: 
 6240:          for (int k = node->kb; k < nvrt; k++) {
 6241:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6242:          }
 6243:          atomicAdd(&(node->tmp.d), elem->area);
 6244:       }
 6245:    }
 6246: 
 6247:    __global__ void computeNodalVerticalVelocities2(void) {
 6248:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6249:    // Divides by the total area of the elements sharing the    node.
 6250:       NODE(node);
 6251: 
 6252:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6253:    }
 6254: 
 6255: 
 6256:    __global__ void computeNodalHorizontalVelocities1(void) {
 6257:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6258:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6259: 
 6260:       ELEM(elem);
 6261: 
 6262:       const int kb = elem->kb;
 6263:       const bool isTri = elem->isTri();
 6264: 
 6265:       if constexpr(indvel <= 0) {
 6266:          // Assuming discontinoius hvel.
 6267: 
 6268: 
 6269:          if (isTri) { // For triangles
 6270:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6271:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6272: 
 6273:             for (int j = 0; j < 3; j++) {
 6274:                // For every node of the triangle...
 6275:                Node *node = elem->nodes[j];
 6276: 
 6277:                const Side *s1 = elem->sides[j];
 6278:                const Side *s2 = elem->sides[(j + 1) % 3];
 6279:                const Side *s3 = elem->sides[(j + 2) % 3];
 6280: 
 6281:                const int numElements = node->numElements;
 6282:                const double inv_numElements = 1.0/numElements;
 6283: 
 6284:                for (int k = kb; k < nvrt; k++)  {
 6285:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6286:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6287:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6288:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6289:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6290:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6291: 
 6292:                }
 6293: 
 6294:             }
 6295:          }
 6296:          else { // For quads
 6297:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6298: 
 6299:          }
 6300: 
 6301:       }
 6302:       
 6303:    }
 6304: 
 6305: 
 6306:    __global__ void computeNodalHorizontalVelocities2(void) {
 6307:       NODE(node);
 6308: 
 6309:       for (int k = 0; k < nvrt; k++) {
 6310:          node->u2[k] = node->utmp[k];
 6311:          node->w2[k] = node->w2[k];
 6312:       }
 6313:       
 6314:    }   
 6315: 
 6316:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6317:    // XXXX I'm not sure where I got this function from. 
 6318:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6319:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6320:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6321:    // It uses the utmp array as a temporary array to store the velocities.
 6322: 
 6323:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6324: 
 6325:       SIDE(side);
 6326: 
 6327:       const int kb = side->kb;
 6328: 
 6329:       Node *n1 = side->n1;
 6330:       Node *n2 = side->n2;
 6331: 
 6332:       for (int k = kb; k < nvrt; k++) {
 6333: 
 6334:          // Cast the u2 vector into a Vector2 
 6335:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6336:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6337: 
 6338:          n1_u2 = side->u2[k]/n1->numSides;
 6339:          n2_u2 = side->u2[k]/n2->numSides;
 6340: 
 6341:       }
 6342: 
 6343: 
 6344:    }
 6345: 
 6346:    __global__ void resetVelocityOpenBndNodes(void) {
 6347:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6348: 
 6349:       NODE_BND(nodebnd);
 6350: 
 6351:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6352:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6353:       }
 6354: 
 6355:    }
 6356: 
 6357: 
 6358:    __global__ void setVelocityOpenBndNodes(void) {
 6359:    // For open boundary nodes sets their velocity to the imposed values.
 6360: 
 6361:       SIDE_BND(sidebnd);
 6362: 
 6363:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6364:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6365:          // to its segment to the average of the side velocity.
 6366: 
 6367:          for (int k = 0; k < nvrt; k++) {
 6368:             Node *n1 = sidebnd->side->n1;
 6369:             Node *n2 = sidebnd->side->n2;
 6370: 
 6371: 
 6372:             Vector2 n1_u2(n1->u2[k]);
 6373:             Vector2 n2_u2(n2->u2[k]);
 6374: 
 6375:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6376:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6377:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6378:             }
 6379:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6380:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6381:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6382:             }
 6383: 
 6384:          }
 6385: 
 6386:       }
 6387: 
 6388:    }
 6389: 
 6390: 
 6391:    __global__ void computeVerticalVelocity(void) {
 6392:       // Computes the vertical velocity at the (2D) element's centroid.
 6393:       // In this function we will be considering volumetric elements, with side faces and a 
 6394:       // bottom and a top face. We will call them SFs, BF and TF.
 6395:       // It computes the flux coming from BF and the SFs.
 6396:       // If the bed is moving, it takes that into account.
 6397:       // Since water is incompressible, the integral of the velocity times the normal vector
 6398:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6399:       // and the BF is equal to the flux going out from the TF.
 6400:       // TF = - BF - sum(SFs).
 6401:       // It then computes the horizontal velocity at the center of TF.
 6402:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6403:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6404:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6405: 
 6406:       ELEM(elem);
 6407: 
 6408:       if (elem->isDry) return;
 6409: 
 6410:       const int kb = elem->kb;
 6411:       const bool isTri = elem->isTri();
 6412: 
 6413:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6414: 
 6415:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6416:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6417:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6418: 
 6419:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6420: 
 6421:       double area3D;
 6422: 
 6423:       // Bottom face flux
 6424:       double bottomFlux = 0.0;
 6425:       Vector2 u2meanBottom = {0.0, 0.0};
 6426:       const Vector2 gradh = elem->grad2(&Node::depth);
 6427:       if constexpr(imm==2) {
 6428:          Vector3 ubed;
 6429: 
 6430:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6431:          // updateBDEF(ubed);
 6432:      
 6433:          // const double bflux0 = dot(ubed, elem_n1);
 6434: 
 6435:          // elem->w[kb] += ubed.z;
 6436:       }
 6437:       else {
 6438:          Vector2 umean;
 6439:          if constexpr(ics == 1) {
 6440:             u2meanBottom = elem->mean(kb, &Side::u2);
 6441:          }
 6442:          else {
 6443:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6444:          }
 6445: 
 6446:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6447:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6448: 
 6449:          bottomFlux = - dot(gradh, u2meanBottom);
 6450:       } // if imm
 6451: 
 6452:       // Compute w for kb+1 to nvrt-1
 6453:       for (int l = kb; l < nvrt - 1; l++) {
 6454: 
 6455:          // normal vector to the top face of the "volumetric" element (3D)
 6456:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6457: 
 6458:          // Compute the total flux at the sides
 6459:          double sideFlux = 0.0;
 6460:          Vector2 u2top = {0.0, 0.0};
 6461:          for (int j = 0; j < elem->i34; j++) {
 6462:             const Side *side = elem->sides[j];
 6463: 
 6464:             const double sideArea = side->area(l);
 6465:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6466:             const double sign = elem->ssign[j]; 
 6467: 
 6468:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6469:          }
 6470:          
 6471:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6472:          //velocities at the centers of the sides
 6473:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6474: 
 6475:          // The flx at the top ace can be computed from the other flows.
 6476:          const double topFlux = - sideFlux - bottomFlux;
 6477:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6478: 
 6479:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6480: 
 6481:          elem_n1 = elem_n2;
 6482: 
 6483:          bottomFlux = - topFlux;
 6484:       }
 6485:    }  
