 2723: 
 2724: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2725: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2726: // Returns the normal vector and the area of the element at this level
 2727:    
 2728:    double nx, ny, nz;
 2729: 
 2730:    if (isTri()) {
 2731:       // For triangles...
 2732: 
 2733:       // Indices of the nodes at level k, taking care of not going below the bed
 2734:       const int k0 = max(k, nodes[0]->kb);
 2735:       const int k1 = max(k, nodes[1]->kb);
 2736:       const int k2 = max(k, nodes[2]->kb);
 2737: 
 2738:       // Gets the element frame coordinates of the nodes at level k
 2739:       Point3 x0, x1, x2;
 2740:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2741:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2742:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2743:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2744: 
 2745:       } else {  // ics == 2
 2746:          Point2 h0, h1, h2;
 2747: 
 2748:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2749: 
 2750:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2751:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2752:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2753:       }
 2754: 
 2755:       const Vector3 n20 = x2 - x0;
 2756:       const Vector3 n10 = x1 - x0; 
 2757: 
 2758:       // Computes the cross product of vectors n20 and n10. 
 2759:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2760:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2761:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2762: 
 2763:   
 2764:    }
 2765:    else {
 2766:       // For quads...
 2767:       Point2 h0, h1, h2, h3;
 2768: 
 2769:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2770: 
 2771:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2772:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2773:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2774:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2775: 
 2776:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2777:       nx = n20.y*n31.z - n20.z*n31.y;
 2778:       ny = n20.z*n31.x - n20.x*n31.z;
 2779:       nz = n20.x*n31.y - n20.y*n31.x;
 2780: 
 2781:    }
 2782: 
 2783:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2784:    area3D = 0.5*len;
 2785: 
 2786:    const double inv_len = 1.0/len;
 2787: 
 2788:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2789: 
 2790: }
 2791: 
 2792: 
 2793: // Helper functions to get the 2D local node position for the Celestial walk
 2794: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2795:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2796:    const Node *node = getNodeInOrder(idx2);
 2797: 
 2798:    double z = 0.0;
 2799:    if constexpr(ics == 2) z = node->gz;
 2800:    
 2801:    Point3 p = toPoint3(node->p, z);
 2802: 
 2803:    return toPoint2(origSide->toLocalFrame(p));
 2804: }
 2805: 
 2806: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2807:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2808: }
 2809: 
 2810: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2811:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2812: // Computes the three per-side predicates needed for the celestial walk
 2813: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2814: //
 2815: // xt is in local frame coordinates for origSide if ics == 2.
 2816: //
 2817: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2818: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2819: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2820: // meaningless on triangles are masked to a safe value (see comments below).
 2821: {
 2822:    // Project all 4 corner positions once into the local 2D frame.
 2823:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2824:    // getLocalNodePosition only transforms/projects if ics == 2.
 2825:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2826:                         getLocalNodePosition(1, origSide), 
 2827:                         getLocalNodePosition(2, origSide), 
 2828:                         getLocalNodePosition(3, origSide)};
 2829: 
 2830:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2831:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2832:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2833:    // But still farther towards the target point from the current point.
 2834:    const Vector2 vt0 = xt - x0;
 2835:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2836:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2837:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2838: 
 2839:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2840:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2841: 
 2842: 
 2843: // if (origSide->idx == 2860848 && jlev == 46) {
 2844: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2845: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2846: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2847: // }
 2848:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2849:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2850:    //  here the orientation is baked into the corners array.)
 2851:    const int i3 = nxq(3);
 2852:    const Vector2 s0 = C[ 1] - C[ 0];
 2853:    const Vector2 s1 = C[ 2] - C[ 1];
 2854:    const Vector2 s2 = C[i3] - C[ 2];
 2855:    const Vector2 s3 = C[ 0] - C[i3];
 2856:    
 2857:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2858:    // The corners array is built from getNode in CCW order, so the orientation
 2859:    // is already correct and no ssign factor is needed in the formulas below.
 2860:    //
 2861:    // i3 = nxq(3): the index of the corner after side 2.
 2862:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2863:    //   Quad:     i3 == 3.
 2864:    //
 2865:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2866:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2867:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2868:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2869:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2870:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2871: 
 2872: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2873: 
 2874:    // For triangles, the corner after side 2 is the closing corner where
 2875:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2876:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2877:    // s0 for triangles, s3 for quads.
 2878:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2879: 
 2880:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2881:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2882:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2883:    //
 2884:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2885:    // result is false naturally. No sentinel needed.
 2886:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2887:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2888:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2889:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2890: 
 2891:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2892:    // on the "exit through side I" half of the corner cone, separated by the
 2893:    // approximate angular bisector of the celestial walk. The bisector is
 2894:    // perpendicular to the chord across the corner; the test is the sign of
 2895:    // (xt - corner_vertex) projected onto that chord.
 2896:    //
 2897:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2898:    // (the validity rule sets valid_3 = false), so its computed value for
 2899:    // triangles doesn't matter. No sentinel needed.
 2900:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2901:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2902:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2903:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2904: 
 2905: }
 2906: 
 2907: 
 2908: __inline__ __device__ double Element::computeSignedArea(void) const {
 2909:    // Compute the area of the element
 2910: 
 2911:    Point2 x0, x1, x2, x3;
 2912:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2913: 
 2914: 
 2915:    double res = signedArea(x0, x1, x2);
 2916: 
 2917:    // In the quad case we need to add the area of the other triangle.
 2918:    if (isQuad()) {
 2919:       x3 = getLocalHorizontalNodePosition(3);
 2920:       double ar1 = signedArea(x0, x2, x3);
 2921:       double ar2 = signedArea(x0, x1, x3);
 2922:       double ar3 = signedArea(x1, x2, x3);
 2923:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2924: 
 2925:       res += ar1;
 2926: 
 2927:    }
 2928: 
 2929:    return res;
 2930: }
 2931: 
 2932: 
 2933: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2934:                                                                 (nodes[1]->isDry2()) ||
 2935:                                                                 (nodes[2]->isDry2()) ||
 2936:                                                                 (isQuad() && nodes[3]->isDry2());
 2937: }
 2938: 
 2939: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2940:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2941: }
 2942: 
 2943: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2944:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2945: }
 2946: 
 2947: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2948:    // In boundary sides, the element 1 is nullptr
 2949:    return side->elems[1] == nullptr; 
 2950: }
 2951: 
 2952: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2953:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2954:    // For ics == 2, this function uses local frame coordinates.
 2955: 
 2956:    assert(isQuad());
 2957: 
 2958:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2959:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2960:    // where vxi, veta, vb are vectors and c is the center of the element.
 2961: 
 2962:    Point2 p0, p1, p2, p3;
 2963: 
 2964:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2965: 
 2966:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2967:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2968:    // vectors vxi and veta connect the centers of opposite sides
 2969:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2970:    // vb is zero for parallelogram elements.
 2971:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2972: 
 2973:    //  The bilinear mapping is:
 2974:    //      P(s,t) = C + s*U + t*V + s*t*W
 2975:    //
 2976:    //  where:
 2977:    //    C = centroid (average of four vertices)
 2978:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2979:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2980:    //    W = bilinear correction; measures deviation from parallelogram
 2981:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2982:    //        W = 0 for parallelogram elements.
 2983:    //
 2984:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2985:    //
 2986:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2987:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2988:    //
 2989:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2990:    //
 2991:    //  Geometrically, (L) projects everything onto the direction
 2992:    //  perpendicular to W, where the mapping is purely affine.
 2993:    //
 2994:    //  The dot product with nb retains the nonlinear term:
 2995:    //
 2996:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2997:    //
 2998:    //  Geometrically, (Q) projects onto the W direction, where
 2999:    //  the nonlinearity lives.
 3000:    //
 3001:    //  We solve (L) for whichever variable has the larger coefficient
 3002:    //  (better conditioned back-substitution), substitute into (Q),
 3003:    //  and get a scalar quadratic in the other variable.
 3004:    // ================================================================
 3005: 
 3006:    // ---- Basis vectors ----
 3007:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3008:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3009:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3010:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3011:    // W: nonlinear correction. Difference between quad and parallelogram.
 3012:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3013:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3014: 
 3015:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3016:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3017:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3018:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3019:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3020: 
 3021:    // ---- nb: direction parallel to W, L1-normalized ----
 3022:    // We don't need a unit vector -- just a well-scaled direction parallel
 3023:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3024:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3025:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3026:    //
 3027:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3028:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3029:    // and the quadratic solver takes its linear path (a ~ 0).
 3030:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3031:    const double inv_wlen = 1.0 / wlen1;
 3032:    const Vector2 nb = vb * inv_wlen;
 3033: 
 3034:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3035:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3036:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3037:    // What remains is a pure affine relationship between xi and eta.
 3038:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3039:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3040:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3041: 
 3042:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3043:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3044:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3045:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3046:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3047:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3048:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3049: 
 3050:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3051:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3052:    // minimizing round-off amplification.
 3053:    //
 3054:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3055:    // that uses predicated moves.
 3056:    //
 3057:    // if (fabs(Ls) > fabs(Lt)) {
 3058:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3059:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3060:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3061:    //    const double A = -Qw * Lt;
 3062:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3063:    //    const double C =  Qs * Lp - Qp * Ls;
 3064: 
 3065:    //    double eta1, eta2;
 3066:    //    solveQuadratic(A, B, C, eta1, eta2);
 3067: 
 3068:    //    // Pick root with smaller |eta| (domain centered at 0).
 3069:    //    // Ternary-> predicated move, no branch divergence.
 3070:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3071: 
 3072:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3073:    //    xi = (Lp - Lt * eta) / Ls;
 3074: 
 3075:    // } else {
 3076:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3077:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3078:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3079:    //    const double A = -Qw * Ls;
 3080:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3081:    //    const double C =  Qt * Lp - Qp * Lt;
 3082: 
 3083:    //    double xi1, xi2;
 3084:    //    solveQuadratic(A, B, C, xi1, xi2);
 3085: 
 3086:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3087: 
 3088:    //    eta = (Lp - Ls * xi) / Lt;
 3089:    // }
 3090:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3091:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3092:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3093:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3094:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3095: 
 3096:    // Quadratic:  A*r^2 + B*r + C = 0
 3097:    // (same formula for both cases, just with swapped coefficients)
 3098:    const double A = -Qw * Lb;
 3099:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3100:    const double C =  Qa * Lp - Qp * La;
 3101: 
 3102:    double r1, r2;
 3103:    solveQuadratic(A, B, C, r1, r2);
 3104: 
 3105:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3106:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3107: 
 3108:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3109:    const double other = (Lp - Lb * r) / La;
 3110: 
 3111:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3112:    xi  = solve_s ? r     : other;
 3113:    eta = solve_s ? other : r;
 3114: 
 3115: 
 3116:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3117:    xi  = clamp(xi,  -1.0, 1.0);
 3118:    eta = clamp(eta, -1.0, 1.0);
 3119: 
 3120:    // ---- Shape functions ----
 3121:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3122:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3123:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3124:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3125:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3126:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3127:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3128:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3129: 
 3130:    return true;
 3131: }
 3132: 
 3133: /**
 3134:    Compute the shape coordinates of the point (xt,yt) in the element.
 3135:    @param xt (input): x-coordinate of the point
 3136:    @param shpCoords (output): shape coordinates of the point
 3137:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3138:    @return true if the point is inside the element, false otherwise
 3139: **/
 3140: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3141: 
 3142:    // Compute the shape coordinates of the point xt in the element.
 3143:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3144:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3145:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3146:    // from the local frame, so use additional check.
 3147: 
 3148: 
 3149:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3150: 
 3151:    if (isTri()) { // Triangular element
 3152: 
 3153:       // Horizontal local node coordinates. 
 3154:       Point2 x0, x1, x2;
 3155:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3156: 
 3157:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3158:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3159:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3160:       shpCoords[3] = 0.0;
 3161: 
 3162:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3163:       const bool res = (tmpmin >= -small);  
 3164:       
 3165:       // When to fix the negative shape coordinates?
 3166:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3167: 
 3168:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3169:       // then we fix the negative shape coordinates.
 3170:       if ((tmpmin < 0) && fix) {
 3171: 
 3172:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3173:          // keeping the sum of the shape coordinates equal to 1.
 3174:          // I have tested and compared the new algorithm with the old one, and they give
 3175:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3176:          // The new algorithm should be faster since it is branchless.
 3177:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3178:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3179: 
 3180:          shpCoords[0] = (shpCoords[0] + a)*b;
 3181:          shpCoords[1] = (shpCoords[1] + a)*b;
 3182:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3183: 
 3184:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3185:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3186:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3187: 
 3188:          // Update the point coordinates for the new shape coordinates
 3189:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3190:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3191: 
 3192:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3193: 
 3194:       }
 3195: 
 3196:       // Return true if the point is inside the element
 3197:       return res;      
 3198:    }
 3199:    else {
 3200:       assert(isQuad() && "computeShapeCoords");
 3201: 
 3202:       // Horizontal local node coordinates with respect to the original side.
 3203:       Point2 x0, x1, x2, x3;
 3204:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3205: 
 3206:       const double a0 = signedArea(x0, x1, xt);
 3207:       const double a1 = signedArea(x1, x2, xt);
 3208:       const double a2 = signedArea(x2, x3, xt);
 3209:       const double a3 = signedArea(x3, x0, xt);
 3210: 
 3211:       const double minArea = min4(a0, a1, a2, a3);
 3212:       
 3213:       const bool res = (minArea > -small*area);
 3214: 
 3215:       // When to fix the negative shape coordinates?
 3216:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3217: 
 3218:       double xi, eta;    
 3219: 
 3220:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3221:       // Does nothing if ics == 1.
 3222:       assert(origSide != nullptr);
 3223:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3224: 
 3225:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3226: 
 3227:       if (fix) {
 3228:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3229:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3230:          xt.x = interpolate(shpCoords, xn);
 3231:          xt.y = interpolate(shpCoords, yn);
 3232:       }
 3233: 
 3234:       return res;
 3235:    }
 3236: 
 3237: 
 3238:    assert(false && "computeShapeCoords: should never reach this point");
 3239:    return false;  // Never reached
 3240: 
 3241: }
 3242: 
 3243: 
 3244: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3245: // Convert shape coordinates to cartesian coordinates
 3246: 
 3247:    if (isTri()) {
 3248:       // Triangular element
 3249: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3250:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3251:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3252:    }
 3253:    else {
 3254:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3255:    }
 3256: 
 3257: }
 3258: 
 3259: 
 3260: 
 3261: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3262:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3263:    
 3264:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3265: }
 3266: 
 3267: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3268:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3269:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3270:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3271:    return area * dot(gradPhi[i], gradPhi[j]);
 3272: }
 3273: 
 3274: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3275:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3276:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3277:    // The formula for the integral is:
 3278:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3279:    
 3280:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3281:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3282:    const double eta_sum  = eta_n(i) + eta_n(j);
 3283:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3284: 
 3285:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3286:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3287: 
 3288: 
 3289:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3290: }
 3291:    
 3292: 
 3293: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3294:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3295:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3296:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3297:    // The formula is also based on the identity:
 3298:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3299:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3300: 
 3301:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3302: 
 3303: 
 3304: 
 3305:    double res = 0.0;
 3306:    
 3307:    // Quadrature points in xi and eta coordinates
 3308:    #pragma unroll
 3309:    for (int i = 0; i < 4; i++) {
 3310:       // For each quadrature point...
 3311: 
 3312:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3313:       const double eta = p.x;
 3314:       const double xi  = p.y;
 3315: 
 3316:       // Jacobian entries at the Gauss point p
 3317:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3318:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3319:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3320:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3321: 
 3322:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3323:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3324: 
 3325:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3326:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3327:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3328:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3329:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3330: 
 3331:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3332:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3333:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3334:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3335:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3336: 
 3337:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3338:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3339:    }
 3340: 
 3341:    return res;
 3342: }
 3343: 
 3344: 
 3345: /**  Interpolate velocities at a given point (xt,yt,zt)
 3346: 
 3347:    @param xt, yt, zt: coordinates of the point to interpolate
 3348:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3349: 
 3350:    This is done in four steps:
 3351: 
 3352:    1. Find the shape coordinates for the final position in the element.
 3353:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3354:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3355:       z levels at xt, yt at each step.   
 3356:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3357:       horizontally and vertically.
 3358: **/
 3359: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3360:    // Interpolate the velocities at the point xt. 
 3361:    // This function works the same for triangular and quadrilateral elements.
 3362:    double shpCoord[4];
 3363:    Vector3 u_int;
 3364: 
 3365: 
 3366:    // First step is to compute the shape coordinates of (xt,yt)
 3367: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3368:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3369: 
 3370:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3371: 
 3372:    // Second step is to find the level that contains zt
 3373:    // Uses a binary search to find the level
 3374:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3375:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3376:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3377:    int R = nvrt - 1;
 3378: 
 3379:    // Get the z coordinates at the nodes of the element at the levels L and R
 3380:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3381:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3382:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3383: 
 3384: 
 3385:    double zL = interpolate(shpCoord, zLAtNodes);
 3386:    double zR = interpolate(shpCoord, zRAtNodes);
 3387: 
 3388:    // Interpolates vertically the velocities
 3389:    double wght1, wght2;
 3390:    if (xt.z <= zL) {
 3391:       wght1 = 1.0;
 3392:       wght2 = 0.0;
 3393:       xt.z = zL;
 3394:    }
 3395:    else if (xt.z >= zR) {
 3396:       wght1 = 0.0;
 3397:       wght2 = 1.0;
 3398:       xt.z = zR;
 3399:    }
 3400:    else {
 3401:       // Perform a binary search to find the levels between L and R that contain xt.z
 3402:       while (R - L > 1) {
 3403:          int M = (L + R) / 2.0;
 3404: 
 3405:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3406:          double zM = interpolate(shpCoord, zMAtNodes);
 3407:          if (zM < xt.z) 
 3408:          {
 3409:             L = M;
 3410:             zL = zM;
 3411:          }
 3412:          else 
 3413:          {
 3414:             R = M;
 3415:             zR = zM;
 3416:          }
 3417:       }
 3418:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3419:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3420: 
 3421:       wght2 = (xt.z - zL)/(zR - zL);
 3422:       wght1 = 1.0 - wght2;
 3423: 
 3424:    }
 3425: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3426: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3427:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3428:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3429:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3430:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3431: 
 3432:    // Project the velocity from the local frame to the origSide frame
 3433:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3434:    u_int = {uv.x, uv.y, w};
 3435: 
 3436:    // Neither of the interpolated velocities should be NaN
 3437:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3438: 
 3439:    return u_int;
 3440: 
 3441: }
 3442: 
 3443: 
 3444: 
 3445: 
 3446: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3447: 
 3448:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3449:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3450:    const Node *n1 = side->n1;
 3451:    const Node *n2 = side->n2;
 3452: 
 3453:    bool n1_match = (n1->nodeBnd->segment == segment);
 3454:    bool n2_match = (n2->nodeBnd->segment == segment);
 3455: 
 3456:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3457:    if (n1_match && n2_match) {
 3458:       return 0.5;
 3459:    } else if (n1_match) {
 3460:       return 1.0;
 3461:    } else if (n2_match) {
 3462:       return 0.0;
 3463:    }
 3464: 
 3465:    return 0.0;
 3466: }
 3467: 
 3468: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3469: 
 3470: 
 3471: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3472: 
 3473:    const double w1 = getBoundaryArrayValueWeight();
 3474:    const double w2 = 1.0 - w1;
 3475:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3476:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3477: 
 3478:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3479: }
 3480: 
 3481: 
 3482: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3483:    const double w1 = getBoundaryArrayValueWeight();
 3484:    const double w2 = 1.0 - w1;
 3485:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3486:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3487: 
 3488:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3489: 
 3490: }
 3491: 
 3492: 
 3493: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3494:    // Returns the value of the velocity at the side center
 3495:    const double w1 = getBoundaryArrayValueWeight();
 3496:    const double w2 = 1.0 - w1;
 3497:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3498:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3499: 
 3500:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3501: }
 3502: 
 3503: 
 3504: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3505:    // Returns the value of the normal component of the velocity at the side center
 3506:    const double w1 = getBoundaryArrayValueWeight();
 3507:    const double w2 = 1.0 - w1;
 3508:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3509:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3510: 
 3511:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3512: }
 3513: 
 3514: 
 3515: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3516:    if constexpr(ics == 1) {
 3517:       return center;
 3518: 
 3519:    } else {
 3520:       const Point2 p0 = n1->outputCoords();
 3521:       const Point2 p1 = n2->outputCoords();
 3522:       return (1.0/2.0)*(p0 + p1);
 3523: 
 3524:    }
 3525: }
 3526: 
 3527: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3528: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3529: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3530: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3531: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3532: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3533: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3534: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3535: // Computes the gradient of the field at the side center.
 3536:    Vector2 grad = {0.0, 0.0};
 3537:    int count = 0;
 3538: 
 3539:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3540:    // as the average of the gradients at each element.
 3541:    // First element
 3542:    if (elems[0] != nullptr && condition(elems[0])) {
 3543:       Vector2 elemGrad = elems[0]->grad2(field);
 3544: 
 3545:       // For ics=2, projects the element gradient from its frame to the side frame
 3546:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3547: 
 3548:       grad += elemGrad;
 3549: 
 3550:       count++;
 3551:    }
 3552: 
 3553:    // Second element
 3554:    if (elems[1] != nullptr && condition(elems[1])) {
 3555: 
 3556:       Vector2 elemGrad = elems[1]->grad2(field);
 3557: 
 3558:       // For ics=2, projects the element gradient from its frame to the side frame
 3559:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3560: 
 3561:       grad += elemGrad;
 3562: 
 3563:       count++;
 3564:    }
 3565: 
 3566:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3567:    if (count > 0) {
 3568:       grad = grad*(1.0/count);
 3569:    }
 3570:    
 3571:    return grad;
 3572: }
 3573: 
 3574: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3575: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3576: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3577: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3578: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3579: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3580: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3581: 
 3582: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3583: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3584: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3585: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3586: 
 3587: 
 3588: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3589: 
 3590: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3591:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3592:    if constexpr(ics == 1) { 
 3593:       return 0.5*(n1->tau + n2->tau);
 3594: 
 3595:    } else {
 3596:       // Project the tau from the node frames to the side frame
 3597:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3598:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3599: 
 3600:       return 0.5*(stau1 + stau2);
 3601:    }
 3602: }
 3603: 
 3604: /**
 3605:  * This method performs backtracking from the side center until a time -dt back in time 
 3606:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3607:  * intermediate point.
 3608:  *
 3609:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3610:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3611:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3612:  * remaining time.
 3613:  * 
 3614:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3615:  * 
 3616:  * @param uuint, vvint, wwint: Velocities at the final point
 3617:  * @param jlev: Level at which the backtracking is performed
 3618:  * @param dt, dtbk: Tracking timesteps
 3619:   */
 3620: __inline__ __device__ void Side::btrack(
 3621:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3622:       double dt,            // Tracking time
 3623:       double dtbk,          // Tracking timestep
 3624:       Vector3 &u_int        // Velocities at the initial point
 3625: ) const {
 3626: 
 3627:    // Start from side center
 3628:    Point3 x0;
 3629: 
 3630:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3631:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3632: 
 3633:  
 3634:    double time_rm = dt; // Remaining time
 3635:    double time_rm_1 = 1e10;
 3636:    double time_rm_2 = 2e10;
 3637:    double time_rm_3 = 3e10;
 3638: 
 3639: 
 3640:    // Initial velocities
 3641:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3642: 
 3643:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3644:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3645: 
 3646:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3647: 
 3648: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3649: 
 3650: 
 3651:    constexpr int MAX_ITERATIONS = 100; 
 3652:    int iter = 0;
 3653:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3654:    while(true) {
 3655: 
 3656:       // Calculate timestep
 3657:       const double dtb = min(dtbk, time_rm);
 3658: 
 3659:       // Next point in the backtracking curve
 3660:       xt = x0 - dtb*u_int;
 3661: 
 3662:       double t, s; // parameters for the line segments p0pt and p1p2
 3663:       Side *lastCrossSide = nullptr;
 3664:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3665: 
 3666: 
 3667:       if (time_rm_3 <= time_rm) {
 3668:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3669:          xt = x0;
 3670:          break;
 3671:       }
 3672: 
 3673: 
 3674:       if (!found) {
 3675:       // This means that the walk reached a boundary or a dry element.
 3676: 
 3677:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3678: 
 3679:          // Finds the point at the boundary where the line segment x0xt intersects.
 3680:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3681:          // due to floating point errors, it does not exactly intersect.
 3682:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3683:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3684:          // To compute the intersection point we start with the parametric equations.
 3685:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3686:          // We cross-prouct by v1 to cancel the s term:
 3687:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3688:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3689: 
 3690:          // Side coordinates in the origSide frame.
 3691:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3692:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3693: 
 3694:          Point2  p0 = {x0.x, x0.y};
 3695:          Point2  pt = {xt.x, xt.y};
 3696: 
 3697:          const Vector2 v1 = pt - p0;
 3698:          const Vector2 v2 = p2 - p1;
 3699: 
 3700: 
 3701: 
 3702:          // We are assuming intersection, so we clamp t to the range [0,1].
 3703:          const double denom = cross(v2, v1);
 3704:          
 3705: 
 3706: 
 3707: 
 3708:          if (abs(denom) < small) {
 3709:             // small denominators are fairly common. They occur when the line segment x0xt 
 3710:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3711:             // boundary, where the backtracking curve startt sliding along the boundary.
 3712:             // In this case, we simply assume that the two lines are very close to each other
 3713:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3714:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3715:             if (t<0.0000000001) t = 0.0;
 3716:             if (t>0.9999999999) t = 1.0;
 3717: 
 3718:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3719:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3720: 
 3721:          }
 3722:          else {
 3723:             
 3724:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3725:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3726:             if (t>0.9999999999) t = 1.0;
 3727:             // From the originaL equation we can solve for s:
 3728:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3729:             // Computing the dot product by v1, we get:
 3730:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3731:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3732:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3733: 
 3734:          }
 3735: 
 3736:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3737: 
 3738: 
 3739:          // We update the new target point to be right at the intersection point,
 3740:          // and the remaining time must include the time we haven't "used".
 3741:          time_rm -= s*dtb;
 3742:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3743: 
 3744: 
 3745:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3746:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3747: 
 3748:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3749:          // but extracting only the component along the tangent vector v2.
 3750:          Vector2 tangent = normalize(v2);
 3751:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3752: 
 3753:          const Vector2 u2D = make_double2(u.x, u.y);
 3754:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3755: 
 3756: 
 3757:       } else {
 3758: 
 3759:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3760: 
 3761:          time_rm -= dtb; 
 3762: 
 3763:          u_int = curElem->interpolateVelocities(xt, this);
 3764: 
 3765:       }
 3766: 
 3767:       if (time_rm <= 0.0) break; 
 3768: 
 3769:       // If the velocity is too small, we stop the backtracking
 3770:       const double vmag2 = norm2(toVector2(u_int));
 3771:       if (vmag2 <= velmin_btrack_sq)  {
 3772:          time_rm = 0.0; 
 3773:          return; 
 3774:       }
 3775: 
 3776:       // The current point becomes the next segment's starting point.
 3777:       x0 = xt;
 3778:  
 3779:       iter++;
 3780: 
 3781: // XXXXXXXXXXXXXXXXX
 3782: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3783:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3784: 
 3785:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3786:       time_rm_3 = time_rm_2;
 3787:       time_rm_2 = time_rm_1;
 3788:       time_rm_1 = time_rm;
 3789:    }
 3790: 
 3791:    assert(curElem != nullptr && "Final element is nullptr");
 3792:    assert(!curElem->isDry && "Final element is dry");
 3793:    
 3794: 
 3795: 
 3796:    // Interpolate the velocities at the final point with respect to the current side frame
 3797:    u_int = curElem->interpolateVelocities(xt, this);
 3798: 
 3799: 
 3800: }
 3801: 
 3802: 
 3803: 
 3804: __device__ __forceinline__ int Node::localIndex() const {
 3805:    // Returns the local index of the node in the partition
 3806:    // Local index is just the offset from the start of the partition's node memory
 3807:    return int(this - mesh->nodes[part]);
 3808: }
