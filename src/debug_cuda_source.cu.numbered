  971:    __device__ void setFrame(void) {
  972:       if constexpr(ics == 1) return;
  973: 
  974:       double lat, lon;
  975:       const Point3 p = toPoint3(center, centerZ());
  976: 
  977:       // Compute the latitude and longitude of the element center
  978:       computeLatLon(p, lat, lon);
  979: 
  980:       frame.update(lat, lon);        
  981:    }
  982: 
  983: 
  984:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  985:    {
  986:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  987:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  988:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  989:       
  990:    }
