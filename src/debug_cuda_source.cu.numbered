 3459: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3460:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3461:    if constexpr(ics == 1) { 
 3462:       return 0.5*(n1->tau + n2->tau);
 3463: 
 3464:    } else {
 3465:       // Project the tau from the node frames to the side frame
 3466:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3467:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3468: 
 3469:       return 0.5*(stau1 + stau2);
 3470:    }
 3471: }
 3472: 
 3473: /**
 3474:  * This method performs backtracking from the side center until a time -dt back in time 
 3475:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3476:  * intermediate point.
 3477:  *
 3478:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3479:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3480:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3481:  * remaining time.
 3482:  * 
 3483:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3484:  * 
 3485:  * @param uuint, vvint, wwint: Velocities at the final point
 3486:  * @param jlev: Level at which the backtracking is performed
 3487:  * @param dt, dtbk: Tracking timesteps
 3488:   */
 3489: __inline__ __device__ void Side::btrack(
 3490:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3491:       double dt,            // Tracking time
 3492:       double dtbk,          // Tracking timestep
 3493:       Vector3 &u_int        // Velocities at the initial point
 3494: ) const {
 3495: 
 3496:    // Start from side center
 3497:    Point3 x0;
 3498: 
 3499:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3500:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3501: 
 3502:  
 3503:    double time_rm = dt; // Remaining time
 3504: 
 3505: 
 3506:    // Initial velocities
 3507:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3508: 
 3509:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3510:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3511: return;
 3512:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3513: 
 3514: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3515: 
 3516: 
 3517:    constexpr int MAX_ITERATIONS = 200; 
 3518:    int iter = 0;
 3519:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3520:    while(true) {
 3521: 
 3522:       // Calculate timestep
 3523:       const double dtb = min(dtbk, time_rm);
 3524: 
 3525:       // Next point in the backtracking curve
 3526:       xt = x0 - dtb*u_int;
 3527: 
 3528: // showPoints(x0, xt, jlev, this, 0xFF00FFu, 'o', 1, 15, iter);
 3529: 
 3530:       Side *lastCrossSide = nullptr;
 3531:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3532: 
 3533:       // This means that the walk reached a boundary or a dry element.
 3534:       if (!found) {
 3535: assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3536:          // Check that the crossing point is not too far from the segment x0xt.
 3537:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3538:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3539:          const Vector2 v1 = toPoint2(xt) - toPoint2(x0);
 3540:          const Vector2 v2 = p1 - p2;
 3541:          const Point2  p0 = toPoint2(x0);
 3542:          const Point2  pt = toPoint2(xt);
 3543: 
 3544: 
 3545:          const double denom = cross(v2, v1);
 3546:          double t = clamp(cross(p1 - p0, v1) / denom, 0.0, 1.0);
 3547: 
 3548:          if (abs(denom) < small) t = (norm2(p1 - p0) < norm2(p2 - p0)) ? 0.0 : 1.0;
 3549:          // else printf("AAAAAAA idx = %d, jlev = %d, t = %.17f, denom = %.17f\n", idx, jlev, t, denom);
 3550: assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3551:          const double fac = clamp(length(p1 + t*v2 - p0)/length(v1), 0.0, 1.0);
 3552:          time_rm = (1.0 - fac)*dtb;
 3553:          xt = x0 + fac*(xt - x0);
 3554:          Vector2 tangent = normalize(v2);
 3555:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3556: 
 3557:          const Vector2 u2D = make_double2(u.x, u.y);
 3558:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3559: 
 3560: 
 3561:    
 3562: 
 3563: 
 3564:          // FIND CROSSING POINT xtp ON BOUNDARY SEGMENT
 3565:          // COMPUTE DISTANCE dtb = distance(x0, xtp) / length(u_int).
 3566:          // COMPUTE U along the boundary segment.
 3567:          // If the velocity is too small, we stop the backtracking
 3568:          // time_rm -= dtb;
 3569:          // MOVE time_rm along the boundary.
 3570:          // X0 = XT
 3571:          // time_rm = 0.0;
 3572: 
 3573:          // u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};//{0.0, 0.0, 0.0}; XXXXX put 0,0,0 back?
 3574: 
 3575: 
 3576:       } else {
 3577: 
 3578:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3579: 
 3580:          time_rm -= dtb; 
 3581: 
 3582:          assert(curElem->containsPoint(toPoint2(xt), this) && "Target point is not inside the current element");
 3583: // printf("HEREEEEEE 4, xt = (%.17f, %.17f, %.17f)\n", xt.x, xt.y, xt.z);
 3584:          u_int = curElem->interpolateVelocities(xt, this);
 3585:       }
 3586: 
 3587: if (iter>20) printf("iter = %d, time_rm = %.17f, dtb = %.17f, dtbk = %.17f, u_int = (%.17f, %.17f, %.17f)\n", iter, time_rm, dtb, dtbk, u_int.x, u_int.y, u_int.z);
 3588:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 3589: 
 3590:       // If the velocity is too small, we stop the backtracking
 3591:       const double vmag2 = norm2(toVector2(u_int));
 3592:       if (vmag2 <= velmin_btrack_sq) break;
 3593: 
 3594:       // The current point becomes the next segment's starting point.
 3595:       x0 = xt;
 3596:  
 3597:       iter++;
 3598: 
 3599: 
 3600:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3601:    }
 3602: 
 3603:    assert(curElem != nullptr && "Final element is nullptr");
 3604:    assert(!curElem->isDry && "Final element is dry");
 3605: 
 3606: // const Point3 p0 = toLocalFrame(toPoint3(curElem->nodes[0]->p, curElem->nodes[0]->gz));
 3607: // const Point3 p1 = toLocalFrame(toPoint3(curElem->nodes[1]->p, curElem->nodes[1]->gz));
 3608: // const Point3 p2 = toLocalFrame(toPoint3(curElem->nodes[2]->p, curElem->nodes[2]->gz));
 3609: // Vector3 xt_Before = xt;
 3610: // curElem->nudgeToBarycenter(toPoint2(xt), this);
 3611: // Vector3 xt_After = xt;
 3612: // showPoints(xt_Before, xt_After, jlev, this, 0x00006Fu, '+', 2, 10, iter);
 3613: // if (!curElem->containsPoint(toPoint2(xt), this)) printf("side->idx = %d, (%.16f,%.16f),(%.16f,%.16f),(%.16f,%.16f)  xt = (%.17f, %.17f, %.17f)\n", idx, p0.x, p0.y, p1.x, p1.y, p2.x, p2.y, xt.x, xt.y, xt.z);
 3614: 
 3615: 
 3616: 
 3617:    // Interpolate the velocities at the final point
 3618:    u_int = curElem->interpolateVelocities(xt, this);
 3619: 
 3620: 
 3621: }
 3622: 
 3623: 
