 5631:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5632: 
 5633:       SIDE(side);
 5634: 
 5635:       side->U = {0.0, 0.0}; 
 5636:          
 5637:       if(side->isDry) return;
 5638: 
 5639:       // Vertically integrated velocity U
 5640:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5641:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5642:          side->U += side->Dz(k + 1)*uc;  
 5643:       }
 5644: 
 5645:    }
 5646: 
 5647:    __global__ void computeBottomDragVegetation(void) {
 5648:       // UNFINISHED. CHECK THIS:
 5649:       // How many kernels are needed? Why so many for loops?
 5650:       // Is the loop on sides needed?
 5651: 
 5652:       NODE(node);
 5653: 
 5654: 
 5655:       const int    kb      = node->kb;
 5656:       const double htot    = node->htot2(); 
 5657:       
 5658:       if (node->isDry) {
 5659:          // Default values for dry nodes
 5660:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5661:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5662: 
 5663:          return;
 5664:        
 5665:       }
 5666: 
 5667:       // Computes bottom drag Cd based on the selected nchi
 5668:       node->computeBottomDragCd();
 5669:       
 5670: 
 5671: 
 5672:       //   Bottom stress in m^2/s^2
 5673:       if (node->rho[kb + 1] >= -98.0)
 5674:       {
 5675:          const double mag_u = length(node->u2[kb + 1]);
 5676:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5677: 
 5678:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5679:          // !sediment erosion: this part needs more documentation
 5680:       }
 5681:     
 5682: 
 5683: 
 5684:       // Compute vegetation parameters
 5685:       //--------------------------------
 5686: 
 5687:       // SAV constants
 5688:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5689:       constexpr double veg_cfpsi = 0.16;
 5690: 
 5691:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5692:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5693: 
 5694:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5695:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5696:          int kbin = 0; // bin index
 5697:          for (int k = kb; k < nvrt; k++) {
 5698:             // Computes node height above the bottom level
 5699:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5700:             assert(false && "Vertical variation of vegetation not implemented");
 5701: 
 5702:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5703:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5704:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5705:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5706:             // } else {
 5707:             //    // Find the bin at which the current vertical level is
 5708:             //    while (kbin<nbins_veg_vert) {
 5709:             //       const double zn = node->z[kbin];
 5710:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5711:             //          break;
 5712:             //       } // if
 5713:             //       kbin++;
 5714:             //    } // while
 5715:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5716: 
 5717:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5718:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5719:                
 5720:             //    // Linear interpolation of the vegetation parameters
 5721:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5722:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5723:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5724:             // } // if rl10
 5725: 
 5726:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5727: 
 5728:          } // for k
 5729: 
 5730: 
 5731:       } else { // Ganthy (iveg==2)
 5732:       //  Modify canopy height, diameter, and density
 5733: 
 5734:          // Make sure there is vegetation on this node
 5735:          if (node->veg_h_unbent > 0.0) {
 5736:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5737: 
 5738:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5739:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5740:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5741: 
 5742:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5743:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5744:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5745:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5746:          } // if veg_h_unbent
 5747: 
 5748:          for (int k = 0; k < nvrt; k++) {
 5749:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5750:          } // for k
 5751:       
 5752: 
 5753:       } // if iveg
 5754:      
 5755: 
 5756:       // Compute vertical mean of veg_alpha3D
 5757:       if (iveg != 0) {
 5758:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5759:          double sum1=0.0;
 5760:          double sum2=0.0;
 5761:          // Integrate over each level under the canopy...
 5762:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5763:             const double Dz = node->Dz(k);
 5764: 
 5765:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5766:             sum2 += Dz;
 5767: 
 5768:          } // for k
 5769:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5770:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5771: 
 5772:       } // if iveg
 5773: 
 5774:    }
 5775: 
 5776:    __global__ void computeVegetationAndDragParameters(void) {
 5777:       // Computes the vegetation and drag model parameters:
 5778:       // chi, \tilde\chi, beta, \breve{H}
 5779:       
 5780:       SIDE(side);
 5781: 
 5782:       side->hhat = 0.0;
 5783:       side->chi2 = 0.0;
 5784:       side->chi = 0.0;
 5785:       side->veg_c2 = 0.0;
 5786:       side->veg_beta = 0.0;
 5787: 
 5788:       if (side->isDry) return;
 5789: 
 5790:       const double htot = side->htot2();
 5791:       const int    kb   = side->kb;
 5792: 
 5793:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5794: 
 5795:       const double veg_h     = side->veg_h();
 5796:       const double veg_nv    = side->veg_nv();
 5797:       const double veg_c     = side->veg_c();
 5798:       const double veg_beta  = side->veg_beta;
 5799:       const double veg_alpha = side->veg_alpha_vert_mean();
 5800: 
 5801:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5802:       // Velocity magnitude at the bottom level
 5803:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5804:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5805:       side->chi2 = side->Cd()*vmag1;
 5806:       side->chi  = side->chi2;
 5807: 
 5808:       if constexpr(iveg != 0) {
 5809:          const Node *n1 = side->n1;
 5810:          const Node *n2 = side->n2;
 5811:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5812:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5813:       }
 5814: 
 5815:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5816: 
 5817:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5818:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5819:       double magUa = 0.0;
 5820:       if constexpr(iveg != 0) {
 5821:          if (side->is3D() && veg_h > 0.0) {
 5822:             // 3D wet side with veg...
 5823: 
 5824:             double magUa = 0.0;
 5825:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5826:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5827: 
 5828:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5829:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5830:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5831: 
 5832:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5833:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5834: 
 5835:                   // Velocity magnitude at the bottom (l) of the level
 5836:                   const double ul = length(side->u2[k]);
 5837: 
 5838:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5839:                   magUa += Dz*0.5*(uh + ul);
 5840: 
 5841:                } // if HasVegetation
 5842:             } // for k
 5843:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5844: 
 5845:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5846:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5847:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5848:                const double zCpy = side->zTopCanopy();
 5849:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5850:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5851:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5852:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5853:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5854:             } // if isSubmerged
 5855:          } // if is3D
 5856:       } // if iveg   
 5857: 
 5858:       // Computes the friction modified depth, \breve{H} in notes
 5859:       if (side->is2D()) { // 2D
 5860: 
 5861:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5862:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5863: 
 5864:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5865: 
 5866:          side->hhat = htot*htot/fricH; 
 5867: 
 5868:       } else { // 3D
 5869:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5870: 
 5871:          if constexpr(iveg != 0) {
 5872:             
 5873:             if (side->isSubmerged()) { 
 5874:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5875:                side->hhat -= veg_c*Hhat_alpha;
 5876: 
 5877:             } else { // Emergent
 5878:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5879:             }
 5880:          } // if iveg
 5881: 
 5882:          // Enforce positivity for 3D model
 5883:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5884:       } // if 3D
 5885: 
 5886:    }
 5887: 
 5888: 
 5889: 
 5890:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5891:    // Computes the density gradient between two elements, e1 and e2.
 5892:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5893:    // zero in the direction normal to the side. 
 5894:    // 
 5895:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5896:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5897:    //
 5898:    // Input:
 5899:    //    e1: Element
 5900:    //    e2: Neighbor element (or nullptr if boundary)
 5901:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5902:    //    k: Index of the half-level at which the density is interpolated
 5903:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5904:    // 
 5905:    // Output:
 5906:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5907:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5908: 
 5909:       if (e2 == nullptr || e2->isDry) {
 5910:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5911: 
 5912:          Side *side = e1->sides[j];
 5913:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5914:                  
 5915:          if constexpr(ics == 1) {
 5916:             vec = side->n; // Normal vector to the side
 5917:          } else {
 5918:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5919:             // IMPLEMENT THIS XXXXXX
 5920:             // !replace with xel, yel?
 5921:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5922:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5923:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5924:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5925:          } //ics
 5926:                    
 5927:          diffRho = 0.0;
 5928: 
 5929:       } else { //internal and wet
 5930:          if constexpr(ics==1) {
 5931:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5932: 
 5933:             // Vector from e1 to e2
 5934:             vec = e2->center - e1->center;
 5935: 
 5936:          } else { 
 5937:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5938:             // Remember that elem->center is in global coordinates
 5939:             // IMPLEMENT THIS XXXXXX
 5940:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5941:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5942:             //                   alow(j)=xctr2
 5943:             //                   bdia(j)=yctr2
 5944:          } // ics
 5945: 
 5946:          diffRho = rho2 - e1->demeanedDensity(k);
 5947:       }
 5948: 
 5949:    }
 5950: 
 5951:    __global__ void computeDensityCubicSplines(void) {
 5952:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5953: 
 5954:       ELEM(elem);
 5955: 
 5956:       if (elem->isDry) return;
 5957: 
 5958:       const int kb = elem->kb;
 5959: 
 5960:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5961:       if (elem->is2D()) {
 5962:          // In the 2D case, the density is constant at the prism level. 
 5963:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5964:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5965:       } else { //3D
 5966: 
 5967:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5968:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5969:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5970:          ///// XXXX CHECK INDICES!!!!!
 5971:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5972:       } // 2D/3D
 5973: 
 5974:    }
 5975: } // extern "C"
 5976: 
 5977: 
 5978: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5979: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5980: 
 5981:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5982: 
 5983:    const int kb  = elem->kb;
 5984:    const int kb2 = elem2->kb;
 5985: 
 5986:    // z-coordinate of prism of elem
 5987:    const double zp = elem->z_prism(k);
 5988: 
 5989:    double rho = 0.0;
 5990: 
 5991:    if (elem2->is2D()) {
 5992:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5993: 
 5994:    } else {  // 3D
 5995: 
 5996:       // eta_min may be < zmax
 5997:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5998:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5999: 
 6000:       // (Extrapolate density below bottom, we will fix it later)
 6001:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6002:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6003:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6004:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6005:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6006:    } // 2D/3D
 6007:      
 6008: 
 6009:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6010:    // Now we need to fix it.
 6011:    if (elem->z[k] < elem2->z[kb2]) {
 6012:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6013: 
 6014:       // There are two methods to adjust the density at the bottom of the element.
 6015:       // iunder_deep=0: 
 6016:       const double depth1 = abs(elem->z[kb]); // larger depth
 6017: 
 6018:       if (iunder_deep==0) {
 6019: 
 6020:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6021: 
 6022:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6023: 
 6024:       } else { // iunder_deep != 0
 6025: 
 6026:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6027: 
 6028:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6029: 
 6030:          //   Demeaned density at the same z coordinate as
 6031:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6032:          }
 6033: 
 6034:       } // if iunder_deep
 6035:    } // if elem->z[kb] < elem2->z[kb]
 6036: 
 6037:    return rho;
 6038: }
 6039: 
 6040: 
 6041: extern "C" {
 6042:    __global__ void computeDensityGradient(void) {
 6043: 
 6044:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6045:       if constexpr(ibc != 0) return;
 6046: 
 6047:          // Compute the horizontal density gradient at each element.
 6048:       // It works in two steps:
 6049:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6050:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6051:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6052:       //             gradRho.r1 = rho1 - rho0
 6053:       //             gradRho.r2 = rho2 - rho0
 6054:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6055:       // 
 6056:       //  NOTE: We use de-meaned densities.
 6057: 
 6058:       ELEM(elem);
 6059: 
 6060:       if (elem->isDry) return;
 6061: 
 6062:       const int kb  = elem->kb;
 6063:       const int i34 = elem->i34;
 6064: 
 6065:       for (int k = kb + 1; k < nvrt; k++) {
 6066:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6067:          //             gradRho.r1 = rho1 - rho0
 6068:          //             gradRho.r2 = rho2 - rho0
 6069:          int icount = 0;
 6070:          double sumRx = 0.0;
 6071:          double sumRy = 0.0;
 6072:          for (int j1=0; j1<i34; j1++) { 
 6073: 
 6074:             const int j2 = elem->nxq(j1 + 1);
 6075: 
 6076:             // Pairs of consecutive neighbor elements of elem
 6077:             const Element *e1 = elem->nghbElems[j1];
 6078:             const Element *e2 = elem->nghbElems[j2];
 6079: 
 6080:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6081:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6082:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6083: 
 6084:             // Compute the density difference and the vector from elem to e1 and e2
 6085:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6086:             double diffRho1, diffRho2;
 6087:             Vector2 vec1, vec2;
 6088:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6089:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6090: 
 6091:             const double rl1 = length(vec1);
 6092:             const double rl2 = length(vec2);
 6093:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6094: 
 6095:             const double delta = cross(vec1, vec2);
 6096:             const double sintheta = abs(delta)/(rl1*rl2);
 6097: 
 6098:             // To avoid problems, avoid elements with small angle between vectors
 6099:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6100:             const bool validEq = (sintheta > sin_one_deg);
 6101: 
 6102:             if (validEq) {
 6103:                // Solve the system of equations to get the density gradient at elem
 6104:                icount++;
 6105:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6106:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6107:                sumRx += Rx;
 6108:                sumRy += Ry;
 6109:             }
 6110:          } // for j1
 6111: 
 6112:          // Compute the average density gradient at elem
 6113:          if (icount==0) {
 6114:            // Bad mesh quality; bail out with 0 b-cc
 6115:            elem->gradRho[k] = {0.0, 0.0};
 6116:          } else {
 6117:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6118:          }
 6119: 
 6120:       } // for k
 6121: 
 6122:    }
 6123: 
 6124:    __global__ void computeBaroclinicTerm(void) {
 6125:    // Computes the baroclinic term at sides (at half levels).
 6126:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6127:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6128: 
 6129:       if (ibc == 1) return;
 6130: 
 6131:       SIDE(side);
 6132: 
 6133:       if (side->isDry) return;
 6134: 
 6135:       const Element *e1 = side->elems[0];
 6136:       const Element *e2 = side->elems[1]; 
 6137:       const int kb = side->kb;
 6138:       
 6139:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6140: 
 6141:       // interpolates vertically the density gradient of the two elements at the half level/
 6142: 
 6143:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6144:       int k2 = max(kb, nvrt / 2);
 6145: 
 6146:       // Starts the integration at the surface and goes down to the bottom
 6147:       side->bcc[nvrt-1] = {0.0, 0.0};
 6148:       for (int k = nvrt - 2; k >= kb; k--) {
 6149:       // For each prism level (from surface to bottom)...
 6150: 
 6151:          // For both elements, interpolate density gradient at the side's half level.
 6152:          // The gradient at the side is the average of the gradients at the elements.
 6153:          // w1, w2 are used to take into account boundary sides, with just one element.
 6154:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6155:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6156:          const double wsum = w1 + w2;
 6157:          w1 = w1/wsum;
 6158:          w2 = w2/wsum;
 6159:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6160: 
 6161:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6162:          Vector2 gradRho = {0.0, 0.0};
 6163:          if (e1 != nullptr && k > kb) {
 6164:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6165:             
 6166:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6167:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6168:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6169: 
 6170:             // Grad(rho) vertically interpolated at the side's half level
 6171:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6172: 
 6173:             // Projects the element density gradient to the side frame if needed.
 6174:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6175: 
 6176:             // Adds the contribution of the density gradient at the side's half level
 6177:             gradRho += gradRho1*w1;
 6178:          }      
 6179:          if (e2 != nullptr && k > kb) {
 6180:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6181:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6182:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6183:             
 6184:             // Grad(rho) vertically interpolated at the side's half level
 6185:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6186: 
 6187:             // Projects the element density gradient to the side frame if needed.
 6188:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6189: 
 6190:             // Adds the contribution of the density gradient at the side's half level
 6191:             gradRho += gradRho2*w2;
 6192:          }
 6193: 
 6194:          
 6195:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6196:          // multiplied by -rampbc*(g/rho0) 
 6197:          const double grav3 = side->grav3();
 6198:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6199: 
 6200:       } // for
 6201: 
 6202:    }
 6203: 
 6204: 
 6205: 
 6206:    __global__ void computeHorGradientAtSide(void) {
 6207: 
 6208:       // Compute the horizontal density gradient at each element.
 6209:       // It works in two steps:
 6210:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6211:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6212:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6213:       //             gradRho.r1 = rho1 - rho0
 6214:       //             gradRho.r2 = rho2 - rho0
 6215:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6216:       // 
 6217:       //  NOTE: We use de-meaned densities.
 6218: 
 6219:       SIDE(side);
 6220: 
 6221: 
 6222:       if (side->isDry) return;
 6223: 
 6224:       // Computes the gradient of the variables at the side center.
 6225:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6226:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6227:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6228: 
 6229:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6230:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6231:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6232:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6233: 
 6234:    }
 6235: 
 6236: 
 6237:    __global__ void solveMomentumEquations(double time) {
 6238: 
 6239:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6240:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6241: 
 6242:       SIDE(side);
 6243: 
 6244:       if (side->isDry) 
 6245:       {
 6246:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6247: 
 6248:          return;
 6249:       }
 6250: 
 6251:       const Node *n1 = side->n1;
 6252:       const Node *n2 = side->n2;
 6253: 
 6254:       const int kb = side->kb;
 6255: 
 6256:       const double veg_h = side->veg_h();
 6257:       const double grav3 = side->grav3();
 6258: 
 6259:       if (side->is2D()) {
 6260:          // Remember: Do not use htot2, which is updated.
 6261:          const double htot = side->htot1();
 6262:          const double hhat = side->hhat;
 6263: 
 6264:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6265: 
 6266:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6267:          const Vector2 tau2 = side->tau();
 6268: 
 6269:          // hat_gam has units of m/s
 6270: 
 6271:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6272:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6273:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6274: 
 6275:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6276: 
 6277: 
 6278:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6279: 
 6280:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6281: 
 6282:       }
 6283:       else { // 3D
 6284: 
 6285:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6286:          // 
 6287:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6288:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6289:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6290:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6291:          // k+1 and k.
 6292: 
 6293: 
 6294:          const int ndim = nvrt - kb;
 6295:          const double zTopCanopy = side->zTopCanopy();
 6296: 
 6297:          // Initialize the tridiagonal system
 6298:          for (int k = kb + 1; k < nvrt; k++) {
 6299:             
 6300:             const int kin = k - (kb + 1);
 6301: 
 6302:             // Vertical viscosity at the face center
 6303:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6304: 
 6305:  
 6306:             alow[kin] = 0.0;
 6307:             cupp[kin] = 0.0;
 6308:             bdia[kin] = 0.0;
 6309: 
 6310:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6311:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6312: 
 6313:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6314:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6315:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6316: 
 6317:             // First part: layers k, k+1
 6318:             if (k < nvrt - 1) {
 6319:                              
 6320:                if constexpr(iveg != 0) {
 6321: 
 6322:                   // If there is vegetation at this level...
 6323:                   if (zTopCanopy > side->zc[k]) {
 6324:                      // If the canopy is above the k layer...
 6325:                      
 6326:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6327:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6328:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6329:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6330: 
 6331:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6332:                      const double vmag2 = length(ut2);
 6333:                      const double vmag1 = length(side->u2[k]);
 6334:                      const double vmag = 0.5*(vmag1 + vmag2);
 6335:                      
 6336:                      // Computes the vegetation alpha at the face center
 6337:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6338: 
 6339:                      cff1 += veg_alpha_sd*dt*vmag;
 6340: 
 6341:                   } // if (zTopCanopy
 6342:                } // if iveg
 6343: 
 6344:                const double dzz = side->Dz(k + 1);
 6345:                const double tmp = dt*dfz/dzz;
 6346:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6347: 
 6348:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6349:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6350:             }
 6351: 
 6352: 
 6353:             // Second part: layers k-1, k
 6354:             if (k > kb + 1) {
 6355: 
 6356:                double cff1 = 1.0; //init \bar{c^k}
 6357: 
 6358:                if constexpr(iveg != 0) {
 6359:                   // If there is vegetation at this level...
 6360:                   if (zTopCanopy > side->zc[k-1]) {
 6361:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6362:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6363: 
 6364:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6365: 
 6366:                      const double vmag2 = length(ut2);
 6367:                      const double vmag1 = length(side->u2[k-1]);
 6368:                      const double vmag = 0.5*(vmag1 + vmag2);
 6369: 
 6370:                      // Computes the vegetation alpha at the face center
 6371:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6372:                      cff1 += veg_alpha_sd*dt*vmag;
 6373:                   } // if zTopCanopy
 6374: 
 6375:                } // if iveg
 6376: 
 6377:                const double dzz = side->Dz(k);
 6378:                const double tmp = dt*dfz/dzz;
 6379:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6380: 
 6381:                alow[kin] += cff1*dzz/6.0 - tmp;
 6382:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6383: 
 6384:             } else { // Bottom boundary
 6385:                // This occurs at the bottom, where the bottom drag is applied.
 6386: 
 6387:                bdia[kin] += dt*side->chi2; // XXXX
 6388: 
 6389:             } // if (k > kb + 1)
 6390: 
 6391: 
 6392:          } // for (int k
 6393: 
 6394: 
 6395: 
 6396:          // Computes the RHS.
 6397:          // -----------------
 6398: 
 6399:          //	BC to be imposed at the end.
 6400: 
 6401:          const Vector2 gradETP  = side->gradETP;
 6402:          const Vector2 gradPr   = side->gradPr;
 6403:          const Vector2 gradEta1 = side->gradEta1;
 6404:          const Vector2 gradEta2 = side->gradEta2;
 6405: 
 6406:          const Vector2 *btu = side->btu;
 6407:          const Vector2 *u2  = side->u2;
 6408:          const double coriolis = side->coriolis;
 6409:          const Vector2 *nuGradU = side->nuGradU;
 6410: 
 6411:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6412:          for (int k = kb + 1; k < nvrt; k++) {
 6413:             const int kin = k - kb - 1;
 6414: 
 6415:             const double dz_0 = side->Dz(k);
 6416:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6417: 
 6418:             rrhs[kin] = {0.0, 0.0};
 6419:             double dz = 0.0;
 6420: 
 6421:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6422:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6423:             if (k < nvrt  ) dz += dz_1;
 6424:             if (k > kb + 1) dz += dz_0;
 6425: 
 6426:             // Elevation gradient, atmospheric pressure and tidal potential
 6427:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6428: 
 6429:             // Coriolis, advection, wind stress, and horizontal viscosity
 6430:             if (k < nvrt - 1) {
 6431: 
 6432: 
 6433:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6434:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6435:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6436:                                                 
 6437: 
 6438:                //diff stress tensors 1006
 6439:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6440:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6441:                   assert(false && "Not implemented: itur == 5");
 6442:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6443:                }
 6444:                // else assert(false && "itur # Not implemented");
 6445: 
 6446:             } else { // k == nvrt - 1 SURFACE
 6447:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6448:                const Vector2 tau2 = side->tau();
 6449: 
 6450:                rrhs[kin] += dt*tau2;          
 6451: 
 6452:             } // if k<nvrt
 6453: 
 6454: 
 6455:             if (k > kb + 1) {
 6456:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6457:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6458:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6459: 
 6460:                // diff stress tensors 1006
 6461:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6462:                   assert(false && "Not implemented: itur == 5");
 6463:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6464:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6465:                }
 6466:                // else assert(false && "itur # Not implemented");
 6467: 
 6468: 
 6469:             } // if k>kbs + 1
 6470: 
 6471:             // Baroclinic
 6472:             Vector2 *bcc = side->bcc;
 6473:             if constexpr(ibc == 0) {
 6474:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6475:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6476: 
 6477:             } // if ibc==0
 6478: 
 6479:          } // k=kb + 1,nvrt
 6480: 
 6481: 
 6482:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6483: 
 6484:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6485:             const int kin = k - kb - 1;
 6486:    
 6487:             // Velocity is always clamped to maximum values
 6488:             side->u2[k] = clampVelocity(soln[kin]);
 6489:          } // k
 6490: 
 6491:       } // if side->is2D()
 6492:       
 6493: 
 6494:       // Impose velocity boundary condition at the bottom
 6495:       if constexpr(imm == 2) { // 3D bed deformation model
 6496:          double dep;
 6497:          Vector2 vel;
 6498: 
 6499:          assert(false && "Not implemented: imm == 2");
 6500:          //update_bdef(time, x0, y0, dep, vel);
 6501:          // side->u2[kb] = vel;
 6502: 
 6503:       } else { // imm = 0 or 1
 6504:          if (side->Cd() == 0.0) {
 6505:             side->u2[kb] = side->u2[kb + 1];
 6506: 
 6507:          } else if (side->is3D()) { // 3D no slip bottom   
 6508:             side->u2[kb] = {0.0, 0.0};
 6509: 
 6510:          }
 6511:           
 6512:       } // if imm
 6513: 
 6514:       // The velocities below the bottom level are set to zero
 6515:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6516: 
 6517: 
 6518:    }
 6519: 
 6520: 
 6521:    __global__ void applyMomentumBC(void) {
 6522: 
 6523:       SIDE_BND(sideBnd);
 6524: 
 6525:       Side *side = sideBnd->side;
 6526:       const BoundarySegment *segment = sideBnd->segment;
 6527:       const Node *n1 = side->n1;
 6528:       const Node *n2 = side->n2;
 6529: 
 6530:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6531: 
 6532:       const bool isLand = segment->isLand;
 6533:       const int ifltype = segment->ifltype;
 6534: 
 6535:       const int kb = side->kb;
 6536: 
 6537: 
 6538:       if (!isLand && ifltype != 0) {
 6539:          const Vector2 *ubc = sideBnd->ubc;
 6540:   
 6541:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6542:             
 6543:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6544:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6545: 
 6546:             if (ifltype == -1) {
 6547:                // Flather 1
 6548: 
 6549:                const double depth = side->depth();
 6550: 
 6551:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6552: 
 6553:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6554: 
 6555:                side->u2[k] = vnorm*side->n;
 6556: 
 6557:             } else if (ifltype == -2) { // Discharge
 6558: 
 6559:                const double eta1 = side->eta1();
 6560:                const double eta2 = side->eta2();
 6561:                const double htot = side->htot2();
 6562: 
 6563:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6564:                assert(false && "Not implemented: Discharge bc");
 6565:                // const double dischrg = discharge(eta1);
 6566:                const double dischrg = 0.0; // XXX REMOVE
 6567:                
 6568: 
 6569:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6570: 
 6571:                const double vnorm = dischrg*eta2/htot;
 6572: 
 6573:                side->u2[k] = vnorm*side->n;
 6574: 
 6575:             }
 6576:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6577:                const double vnorm = dot(side->u2[k], side->n);
 6578: 
 6579:                double rat;
 6580:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6581:                else              rat = segment->vobc2; // outgoing
 6582: 
 6583:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6584: 
 6585:             }
 6586:             else { // not Flather or 3D radiation
 6587:                side->u2[k] = ubc[k];
 6588: 
 6589:             } // if (segment->ifltype...
 6590: 
 6591:          }
 6592: 
 6593:       }
 6594:       else if (isLand) { // if it is land boundary side
 6595: 
 6596:          if constexpr(islip == 0) { // free slip
 6597: 
 6598:             for (int k = kb; k < nvrt; k++) {
 6599: 
 6600:                const Vector2 t = side->t();
 6601:                const Vector2 n = side->n;
 6602: 
 6603:                double vnorm = 0.0; // for most cases
 6604:                const double vtan = dot(side->u2[k], t);
 6605:                
 6606:                side->u2[k] = vtan*t - vnorm*n;
 6607: 
 6608:             }
 6609: 
 6610:          } else { // no slip
 6611:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6612: 
 6613:          }
 6614:       } // if (side segment type...
 6615: 
 6616:    }
 6617: 
 6618: 
 6619:    __global__ void shapiroFilter1(void) {
 6620:       // First step of the Shapiro filter (normally used if indvel<=0)
 6621:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6622: 
 6623:       SIDE(side);
 6624: 
 6625:       // Only internal wet sides are processed
 6626:       if (side->isDry || !(side->isInternal())) return;
 6627: 
 6628:       const int kb = side->kb;
 6629: 
 6630:       for (int mm = 0; mm < niter_shap; mm++) {
 6631: 
 6632:          for (int k = kb + 1; k < nvrt; k++) {
 6633:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6634:             Vector2 suru = {0.0, 0.0};
 6635: 
 6636:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6637: 
 6638:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6639: 
 6640:                int kin = k;
 6641:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6642:                
 6643:                // Get the velocity at the neighbor's side.
 6644:                Vector2 nSideU2 = nSide->u2[kin];
 6645: 
 6646:                // Projects the velocity to the current side frame if needed.
 6647:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6648: 
 6649:                suru += nSideU2;
 6650:             }
 6651: 
 6652:             // Reusing bcc as a temporary array to store the suru values.
 6653:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6654: 
 6655:          }
 6656:       }
 6657:    }
 6658: 
 6659:    __global__ void shapiroFilter2(void) {
 6660:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6661: 
 6662:       SIDE(side);
 6663: 
 6664: 
 6665:       if (side->isDry || !(side->isInternal())) return;
 6666: 
 6667:       const int kb = side->kb;
 6668: 
 6669:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6670: 
 6671:       if (side->is2D()) {
 6672:          side->u2[kb + 1] = side->bcc[kb + 1];
 6673:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6674: 
 6675:       } else {
 6676:          // 3D
 6677:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6678:          
 6679:       }
 6680: 
 6681:    }
 6682: 
 6683: 
 6684:    __global__ void ul0UpdateZCoords(void) {
 6685:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6686:       
 6687:       NODE(node);      
 6688: 
 6689: 
 6690:       if (false) { //node->isDry) { XXXXXXX
 6691: 
 6692:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6693: 
 6694:          if constexpr(ivcor != 1) node->kb = 0;
 6695: 
 6696:       } else {
 6697: 
 6698:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6699:          node->updateKb();
 6700: 
 6701:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6702: 
 6703:       }
 6704: 
 6705:       // We use the temp.b field to store the previous state of isDry.
 6706:       node->tmp.b = node->isDry;
 6707: 
 6708:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6709:       node->isDry = true;
 6710: 
 6711:    }
 6712: 
 6713:    __global__ void ul0ComputeDryElements(void)
 6714:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6715:    {
 6716:       ELEM(elem);
 6717: 
 6718:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6719: 
 6720:       elem->kb = 0;
 6721: 
 6722:       if (elem->isDry) return;
 6723: 
 6724: 
 6725:    //    if(elem->isDry2()) { // XXXX
 6726:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6727:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6728:    //        call parallel_abort(errmsg)
 6729:    //    }
 6730: 
 6731:       const Node *n1 = elem->nodes[0];
 6732:       const Node *n2 = elem->nodes[1];
 6733:       const Node *n3 = elem->nodes[2];  
 6734:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6735: 
 6736:       // Computes element's kb as the minimum of the nodes' kb.
 6737:       const int kb1 = n1->kb;
 6738:       const int kb2 = n2->kb;
 6739:       const int kb3 = n3->kb;
 6740:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6741: 
 6742: 
 6743:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6744: 
 6745: 
 6746:       // Computes the element z as the mean of the nodes z.
 6747:       for (int k = elem->kb; k < nvrt; k++) {
 6748: 
 6749:          // Compute the element z as the mean of the nodes z.
 6750:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6751:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6752:          elem->z[k] /= elem->i34;
 6753: 
 6754:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6755:       }
 6756:                   
 6757:    }
 6758: 
 6759:    __global__ void ul0ComputeDryNodes(void)
 6760:    // Updates node's isDry based on the elements' isDry. 
 6761:    {
 6762:       NODE(node);
 6763: 
 6764:       node->isDry = true;
 6765: 
 6766:       // A node is wet if at least one of the elements sharing it is wet.
 6767:       for (int j = 0; j < node->numElements; j++) {
 6768:          const Element *elem = node->elements[j];
 6769:          if (!elem->isDry) {
 6770:             node->isDry = false;
 6771:             break;
 6772:          }
 6773:       }
 6774: 
 6775:        
 6776:    }
 6777: 
 6778: 
 6779:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6780:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6781:    // node->tmp.b is true if the node was previously dry.
 6782:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6783:    {
 6784:       NODE(node);
 6785:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6786: 
 6787:       // Avoid this the first time step.
 6788:       if (it == iths) return;  
 6789: 
 6790:       const bool wasDry = node->tmp.b;
 6791: 
 6792: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6793: 
 6794:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6795: 
 6796:          for (int k=0; k < nvrt; k++) {
 6797: 
 6798:             Vector3 utmp={0.0, 0.0, 0.0};
 6799: 
 6800:             double ttmp=0.0;
 6801:             double stmp=0.0;
 6802:             int icount=0;
 6803:             for (int j = 0; j < node->numNodes; j++) {
 6804: 
 6805:                const Node *nbrNode = node->nodes[j];
 6806:                
 6807:                const bool wasNbrDry = nbrNode->tmp.b;
 6808: 
 6809:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6810:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6811: 
 6812:                   icount++;
 6813: 
 6814:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6815:                   utmp += nbrNode->uvw2(k);
 6816:                   
 6817:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6818:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6819:                }
 6820:             }
 6821: 
 6822:             if (icount > 0) {
 6823:                const double inv_icount = 1.0/icount;
 6824:                utmp = inv_icount*utmp;
 6825:                node->u2[k]     = {utmp.x, utmp.y};
 6826:                node->w2[k]     = utmp.z;
 6827:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6828:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6829:             } else {
 6830:                node->u2[k] = {0.0, 0.0};
 6831:                node->w2[k] = 0.0;
 6832:                // Initialize tracers to 0.0??? XXXXX
 6833:             }
 6834:          }
 6835:       }
 6836:    }
 6837: 
 6838:   
 6839:    
 6840: 
 6841: 
 6842:    __global__ void ul0UpdateSides(int it, int iths) {
 6843:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6844:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6845:    // The dryness of the sides is updated in ul0UpdateSides2.
 6846: 
 6847:       SIDE(side);
 6848: 
 6849:       // A side is wet if and only if at least one of its elements is wet.
 6850:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6851:  
 6852:       const Node *n1 = side->n1;
 6853:       const Node *n2 = side->n2;
 6854:      
 6855:       const int kb1 = n1->kb;
 6856:       const int kb2 = n2->kb;
 6857: 
 6858:       side->kb = 0; // default when dry
 6859: 
 6860:       if (isWet) {
 6861: 
 6862:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6863: 
 6864:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6865: 
 6866:          side->kb = min(kb1, kb2);
 6867: 
 6868:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6869: 
 6870:          for (int k = side->kb; k < nvrt; k++) {
 6871:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6872: 
 6873:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6874: 
 6875:             // Compute velocity for re-wetted sides 
 6876:             if ((it != iths) && (side->isDry && isWet)) {
 6877: 
 6878:                Vector2 utmp={0.0, 0.0};
 6879: 
 6880:                int icount=0;
 6881: 
 6882:                // For all the sides on the two elements that share this side
 6883:                for (int j = 0; j < 2; j++) {
 6884:                   const Element *elem = side->elems[j];
 6885:                   if (elem == nullptr) continue;
 6886: 
 6887:                   for (int jj=0; jj < elem->i34; jj++) {
 6888:                      const Side *nSide = elem->sides[jj];
 6889:                      if (nSide->isDry) continue;
 6890: 
 6891:                      icount++;
 6892:                      utmp += nSide->u2[k];  
 6893:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6894:                   }
 6895:                }
 6896:                   
 6897:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6898:                if (icount > 0)  side->u2[k] = utmp/icount;
 6899:                else             side->u2[k] = {0.0, 0.0};
 6900:                   
 6901:             } // if ((it != iths) && (side->isDry && isWet))
 6902: 
 6903:          } // for k
 6904: 
 6905:       } // if isWet 
 6906:       
 6907: 
 6908: 
 6909:    }
 6910: 
 6911:    __global__ void ul0UpdateSides2(void) {
 6912:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6913:    
 6914:          SIDE(side);
 6915:    
 6916:          const Element *e1 = side->elems[0];
 6917:          const Element *e2 = side->elems[1];
 6918: 
 6919:          // A side is wet if and only if at least one of its elements is wet.
 6920:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6921: 
 6922:          // Update the side's dryness
 6923:          side->isDry = !isWet;
 6924: 
 6925:    }
 6926: 
 6927: 
 6928:    __global__ void zeroNodalVelocities(void) {
 6929:       NODE(node);
 6930: 
 6931:       for (int k = 0; k < nvrt; k++) {
 6932:          node->u2[k]   = {0.0, 0.0};
 6933:          node->w2[k]   = 0.0;
 6934:          node->utmp[k] = {0.0, 0.0};         
 6935:       }
 6936:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6937:    }
 6938:  
 6939: 
 6940:    __global__ void computeNodalVerticalVelocities1(void) {
 6941:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6942:    // Adds the element's vertical velocity times the element's area.
 6943:       ELEM(elem);
 6944: 
 6945:       for (int j = 0; j < elem->i34; j++) {
 6946:          Node *node = elem->nodes[j];
 6947: 
 6948:          for (int k = node->kb; k < nvrt; k++) {
 6949:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6950:          }
 6951:          atomicAdd(&(node->tmp.d), elem->area);
 6952:       }
 6953:    }
 6954: 
 6955:    __global__ void computeNodalVerticalVelocities2(void) {
 6956:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6957:    // Divides by the total area of the elements sharing the    node.
 6958:       NODE(node);
 6959: 
 6960: 
 6961:       const double invArea = 1.0 / node->tmp.d;
 6962:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6963: 
 6964:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6965:    }
 6966: 
 6967: 
 6968:    __global__ void computeNodalHorizontalVelocities1(void) {
 6969: 
 6970:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6971: 
 6972:       ELEM(elem);
 6973: 
 6974:       if (elem->isDry) return;
 6975: 
 6976:       const int kb = elem->kb;
 6977:       const bool isTri = elem->isTri();
 6978: 
 6979:       if constexpr(indvel <= 0) {
 6980:          // Assuming discontinous hvel.
 6981: 
 6982:          if (isTri) { // For triangles
 6983:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6984:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6985:             #pragma unroll
 6986:             for (int j = 0; j < 3; j++) {
 6987:                // For every node of the triangle...
 6988:                Node *node = elem->nodes[j];
 6989: 
 6990:                if (node->isDry) continue;
 6991: 
 6992:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6993:                const Side *s2 = elem->sides[(j + 1) % 3];
 6994:                const Side *s3 = elem->sides[(j + 2) % 3];
 6995: 
 6996:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6997: 
 6998:                atomicAdd(&(node->tmp.i), 1);
 6999: 
 7000:                for (int k = kb; k < nvrt; k++)  {
 7001:                   Vector2 s1u2 = s1->u2[k];
 7002:                   Vector2 s2u2 = s2->u2[k];
 7003:                   Vector2 s3u2 = s3->u2[k];
 7004: 
 7005:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7006:                   if constexpr(ics == 2) {
 7007:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7008:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7009:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7010:                   }
 7011: 
 7012:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7013:                   u = clampVelocity(u);
 7014:                   atomicAdd(&(node->utmp[k].x), u.x);
 7015:                   atomicAdd(&(node->utmp[k].y), u.y);
 7016: 
 7017:                }
 7018: 
 7019:             }
 7020:          }
 7021:          else { // For quads
 7022: 
 7023: 
 7024:             // Compute the bilinear coordinates of the center of each diagonal.
 7025:             double xi, eta;
 7026:             double shp13[4], shp24[4];
 7027:             Point2 x0, x1, x2, x3;
 7028:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7029:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7030:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7031: 
 7032:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7033:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7034: 
 7035: 
 7036: 
 7037: 
 7038:             for (int k = kb; k < nvrt; k++) {
 7039: 
 7040:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7041:                Vector2 sideU[4];
 7042:                #pragma unroll
 7043:                for (int j = 0; j < 4; j++) {
 7044:                   Vector2 u = elem->sides[j]->u2[k];
 7045:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7046:                   sideU[j] = u;
 7047:                }
 7048: 
 7049:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7050:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7051: 
 7052:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7053:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7054:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7055:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7056:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7057:                #pragma unroll
 7058:                for (int j = 0; j < 4; j++) {
 7059:                   Node *node = elem->nodes[j];
 7060:                   if (node->isDry) continue;
 7061: 
 7062:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7063:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7064:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7065:                }
 7066:             }
 7067: 
 7068:          }
 7069: 
 7070:       }
 7071:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7072:       
 7073:    }
 7074: 
 7075: 
 7076:    __global__ void computeNodalHorizontalVelocities2(void) {
 7077:       NODE(node);
 7078: 
 7079:       const int nodeCount = node->tmp.i;
 7080: 
 7081:       if (nodeCount == 0) 
 7082:       {
 7083:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7084:          return;
 7085:       }
 7086: 
 7087:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7088:       
 7089:       const int kb = node->kb;
 7090: 
 7091:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7092:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7093:       
 7094:       
 7095:    }   
 7096: 
 7097:  
 7098: 
 7099:    __global__ void resetVelocityOpenBndNodes(void) {
 7100:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7101: 
 7102:       NODE_BND(nodebnd);
 7103: printf("DDDDDDDDDD\n");
 7104:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7105:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7106:       }
 7107: 
 7108:    }
