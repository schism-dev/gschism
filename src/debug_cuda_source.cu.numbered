 3626: 
 3627: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3628: 
 3629: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3630: 
 3631:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3632:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3633: 
 3634: 
 3635: 
 3636:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3637:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3638: 
 3639:    double fun_lat = 0.0;
 3640:    switch (jspc[idxComp]) {
 3641:       case 0:
 3642:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3643:          break;
 3644:       case 1:
 3645:          fun_lat = sin(2.0*lat);
 3646:          break;
 3647:       case 2:
 3648:          fun_lat = pow<2>(cos(lat));
 3649:          break;
 3650:       default:
 3651:          assert(false && "computeETP: invalid jspc");
 3652:    }
 3653:    
 3654:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3655: 
 3656: }
 3657: 
 3658: 
 3659: __device__ void Node::updateKb(void) {
 3660: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3661: 
 3662:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3663: 
 3664: 
 3665:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3666: 
 3667:    if constexpr(ivcor == 2) {  // SZ coordinates
 3668:       
 3669:       // Compute bottom level index
 3670:       if (depth <= mesh->h_s) {
 3671:          kb = izlev;   
 3672:          
 3673:       } else {
 3674:          kb = -1;
 3675:          int L = 0;
 3676:          int R = nzlev; 
 3677:          
 3678:          while (L <= R) {
 3679:             int M = (R + L) / 2;
 3680: 
 3681: 
 3682:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3683:             
 3684:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3685:                R = M;
 3686:             } else {
 3687:                L = M;
 3688:             }
 3689: 
 3690:             if (R - L == 1) {
 3691:                kb = L;
 3692:                break;
 3693:             }
 3694:          }
 3695: 
 3696:          // Checks that the binary search was successful
 3697:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3698:        
 3699:       }
 3700:    } 
 3701: }
 3702: 
 3703: 
 3704: __device__ __inline__ void Node::updateZCoordData(void) {
 3705: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3706: 
 3707:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3708:    // if (isDry2()) {
 3709:    //    kb = -1;  // XXXXXXXX KKKKK
 3710:    //    return;
 3711:    // }
 3712: 
 3713: 
 3714:    if constexpr(ivcor == 2) {  // SZ coordinates
 3715:       
 3716:       // Compute bottom level index
 3717:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3718:    } 
 3719:    else {  // if (ivcor == 1) Localized sigma
 3720:       // Do nothing
 3721:    }
 3722: 
 3723: 
 3724: }
