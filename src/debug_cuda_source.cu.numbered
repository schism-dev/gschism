 7123: 
 7124:    __global__ void computeVerticalVelocity(void) {
 7125:       // Computes the vertical velocity at the (2D) element's centroid.
 7126:       // In this function we will be considering volumetric elements, with side faces and a 
 7127:       // bottom and a top face. We will call them SFs, BF and TF.
 7128:       // It computes the flux coming from BF and the SFs.
 7129:       // If the bed is moving, it takes that into account.
 7130:       // Since water is incompressible, the integral of the velocity times the normal vector
 7131:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7132:       // and the BF is equal to the flux going out from the TF.
 7133:       // TF = - BF - sum(SFs).
 7134:       // It then computes the horizontal velocity at the center of TF.
 7135:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7136:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7137:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7138: 
 7139:       ELEM(elem);
 7140: 
 7141:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7142: 
 7143:       if (elem->isDry) return;
 7144: 
 7145:       const int kb = elem->kb;
 7146:       const bool isTri = elem->isTri();
 7147: 
 7148:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7149: 
 7150:       // Compute the bottom velocity
 7151:       if constexpr(imm != 0) {
 7152:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7153:       }
 7154: 
 7155: 
 7156:       double bottomArea3D;
 7157:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7158: 
 7159:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7160: 
 7161:       double topArea3D;
 7162: 
 7163:       // Bottom face flux
 7164:       double bottomFlux = 0.0;
 7165:       Vector2 u2meanBottom = {0.0, 0.0};
 7166:       const Vector2 gradh = elem->grad2(&Node::depth);
 7167:       if constexpr(imm==2) {
 7168:          Vector3 ubed;
 7169: 
 7170:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7171:          // updateBDEF(ubed);
 7172:      
 7173:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7174: 
 7175:          // elem->w[kb] += ubed.z;
 7176:       }
 7177:       else {
 7178: 
 7179:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7180:   
 7181:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7182:          // in the direction of motion.
 7183:          const double bottomW = - dot(gradh, u2meanBottom);  
 7184:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7185: 
 7186:          // VElocity associated to the bed deformation
 7187:          double bedVelocity = 0.0;
 7188:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7189: 
 7190:          elem->w[kb] = bedVelocity + bottomW; 
 7191: 
 7192:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7193:          
 7194:       } // if imm
 7195: 
 7196:       // Compute w for kb+1 to nvrt-1
 7197:       for (int l = kb; l < nvrt - 1; l++) {
 7198: 
 7199:          // normal vector to the top face of the "volumetric" element (3D)
 7200:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7201: 
 7202:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7203:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7204: 
 7205:          // Compute the total flux at the sides
 7206:          double sideFlux = 0.0;
 7207: 
 7208:          for (int j = 0; j < elem->i34; j++) {
 7209:             const Side *side = elem->sides[j];
 7210:             const int kbs = side->kb;
 7211:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7212:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7213:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7214: 
 7215:             // The area is "clamped" meaning that it takes kb into account.
 7216:             const double sideArea = side->areaClamped(l);
 7217: 
 7218:             const double sign = elem->ssign[j]; 
 7219: 
 7220:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7221:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7222:          }
 7223:          
 7224:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7225:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7226:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7227: 
 7228:          // The flux at the top ace can be computed from the other flows.
 7229:          // All fluxes are in directions into the prism.
 7230:          const double topFlux = - sideFlux - bottomFlux;
 7231: 
 7232:          // Flux at the top face due to the horizontal velocities only
 7233:          // topFlux = topHorizontalFlux + topVerticalFlux
 7234:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7235: 
 7236:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7237:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7238: 
 7239:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7240: 
 7241:          bottomFlux = -topFlux;
 7242:          
 7243:       }
 7244: 
 7245:    }  
 7246: 
 7247: 
 7248: 
 7249: 
 7250: 
 7251: 
 7252: 
