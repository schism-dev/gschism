 2505: 
 2506: __inline__ __device__ double  Side::x(double t)   const { if (t<0.0 || t>1.0) printf("XX t = %.7g\n", t); assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2507: __inline__ __device__ double  Side::y(double t)   const { if (t<0.0 || t>1.0) printf("YY t = %.7g\n", t); assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2508: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2509: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2510: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2511: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2512:    Vector2 grad = {0.0, 0.0};
 2513:    int count = 0;
 2514: 
 2515:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2516: 
 2517:    // First element
 2518:    if (elems[0] != nullptr && condition(elems[0])) {
 2519:       grad += elems[0]->grad2(field);
 2520:       count++;
 2521:    }
 2522: 
 2523:    // Second element
 2524:    if (elems[1] != nullptr && condition(elems[1])) {
 2525:       grad += elems[1]->grad2(field);
 2526:       count++;
 2527:    }
 2528: 
 2529:    if (count > 0) {
 2530:       grad = grad*(1.0/count);
 2531:    }
 2532:    
 2533:    return grad;
 2534: }
