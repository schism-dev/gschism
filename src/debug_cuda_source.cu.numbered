 2546: 
 2547: __device__ __forceinline__ double Element::centerZ(void) const { 
 2548: // Z coordinate of the element center in the global cartesian coordinates.
 2549: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2550: 
 2551:    if constexpr(ics==1) { 
 2552:       return 0.0; 
 2553: 
 2554:    } else { 
 2555: 
 2556:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2557:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2558:    } 
 2559: }
 2560: 
 2561: 
 2562:    template<typename T>
 2563:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2564:       // Get the values of the field at the nodes of the element
 2565:       res[0] = nodes[0]->*field;
 2566:       res[1] = nodes[1]->*field;
 2567:       res[2] = nodes[2]->*field;
 2568:       if (isQuad()) res[3] = nodes[3]->*field;
 2569:       else          res[3] = T();
 2570:    }
 2571: 
 2572:    template<typename T>
 2573:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2574: 
 2575:       assert(level < nvrt && "Level is out of range");
 2576:       // Get the values of the field at the nodes of the element
 2577:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2578:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2579:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2580:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2581:       else          res[3] = T();
 2582:    }    
 2583: 
 2584:    template<typename T>
 2585:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2586: 
 2587:       assert(level < nvrt && "Level is out of range");
 2588: 
 2589:       // Get the values of the func at the nodes of the element
 2590:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2591:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2592:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2593:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2594:       else          res[3] = T();  // This is 0.0 or a zero vector
 2595: 
 2596:    }      
