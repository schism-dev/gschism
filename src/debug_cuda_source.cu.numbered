 1277: // This struct is used to store the boundary information for a node.
 1278: struct NodeBoundary {   
 1279:    int idx;
 1280:    BoundarySegment *segment;
 1281:    Node *node;
 1282:    
 1283:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1284:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1285: 
 1286:    bool isLand;
 1287: 
 1288:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1289:    double elbc;   // Elevation boundary condition
 1290:    double eth;    // Elevation time history
 1291: 
 1292:    double eta_mean; // Mean elevation at nodes
 1293: 
 1294:    bool isEssentialBC;
 1295: 
 1296:    Vector2 uth[nvrt];  // "Time history" velocity
 1297: 
 1298:    // Arrays for harmonic constituents (if needed)
 1299:    double  emo[nbfr];  // Elevation amplitude
 1300:    double  efa[nbfr];  // Elevation phase
 1301:    Vector2 umo[nbfr];  // velocity amplitude
 1302:    Vector2 ufa[nbfr];  // velocity phase
 1303: 
 1304: 
 1305:    NodeBoundary(void) {
 1306:       isLand = false;
 1307:    }
 1308:    NodeBoundary(bool _isLand) {
 1309:       isLand = _isLand;
 1310:    }
 1311: 
 1312:    
 1313:    __forceinline__ __device__ int numSidesForAverage() const {
 1314:    // Returns the number of sides that are connected to the node and have the same segment.
 1315:    // This is used to compute the average velocity at the node for open boundary nodes.
 1316:       int res = 0;
 1317:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1318:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1319: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1320:       return res;
 1321:    }
 1322: 
 1323: 
 1324:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1325:       assert(index == 0 || index == 1); 
 1326:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1327:    }
 1328: 
 1329: 
 1330: };
 1331: 
 1332: struct Node {
 1333: 
 1334:    // Geometry information
 1335:    int idx;        // Index of the node
 1336:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1337:    int numNodes;   // Number of nodes neighbors of this node
 1338: 
 1339:    Element **elements; // Array of pointers to the elements that share this node
 1340:    int numElements;    // Number of elements that share this node
 1341: 
 1342:    int numSides;       // Number of sides that are connected to this node
 1343: 
 1344:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1345:    double gz;          // Global vertical coordinate at the node.
 1346:    Vector2 u2[nvrt];
 1347:    double  w2[nvrt];
 1348:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1349:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1350:    double lon, lat;
 1351:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1352:    double depth;
 1353: 
 1354:    #ifdef USE_FRAMES
 1355:    Frame frame;
 1356:    #endif
 1357: 
 1358:    #ifdef USE_LOCALIZED_SIGMA   
 1359:    double localSigma[nvrt];
 1360:    #endif
 1361: 
 1362:    int kb;       // Bottom index of the node
 1363: 
 1364:    bool isDry;     // True if the node is dry
 1365: 
 1366:    int iadv;     // Advection flag
 1367: 
 1368:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1369:                           // this is nullptr
 1370: 
 1371:    TempVar tmp; // Temporary variable to store different types of variables
 1372: 
 1373:    // Physical information
 1374:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1375:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1376: 
 1377:    double rho[nvrt];     // Density
 1378:    double dfv[nvrt];     // Vertical viscosity
 1379: 
 1380:    double eta1; // Elevation at nodes at previous timestep
 1381:    double eta2; // Elevation at nodes at current timestep
 1382: 
 1383:    double ETP;  // Earth Tidal Potential
 1384: 
 1385:    double pr;    // Air pressure
 1386:    double grav2; // Gravity 
 1387:    
 1388:    Vector2 dav;  // Depth averaged velocity
 1389: 
 1390:    Vector2 tau; // Wind stress vector
 1391: 
 1392:    // Vegetation parameters
 1393:    double veg_h;
 1394:    double veg_nv;
 1395:    double veg_di;
 1396:    double veg_Cd;
 1397:    double veg_h_unbent;
 1398:    double veg_di_unbent;
 1399:    double veg_nv_unbent;
 1400:    double veg_alpha_vert_mean;
 1401:    double veg_alpha0;
 1402:    double veg_alpha3D[nvrt];
 1403: 
 1404:    // Bottom drag parameters
 1405:    double Cd;       // Bottom drag coefficient   
 1406: 
 1407:    // These three are mutually exclusive
 1408:    union {
 1409:       double rmanning; // Bottom Manning's coefficient
 1410:       double rough;    // Bottom roughness length
 1411:       double drag;     // Bottom drag coefficient
 1412:    };
 1413:    Vector2 tau_bot; // Bottom stress vector
 1414: 
 1415:    // XXXX REMOVE FOR IMM>0???
 1416:    double bdef1; // Bottom deformation at previous timestep
 1417:    double bdef2; // Bottom deformation at current timestep
 1418: 
 1419:    double qel; // RHS
 1420:    double coeffDiag; // Diagonal coefficient of the matrix
 1421:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1422: 
 1423:    // This was used by a previous version of the conjugate gradient method
 1424:    // double mP; // Search direction for conjugate gradient method
 1425:    // double mR; // Residual for conjugate gradient method
 1426:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1427: 
 1428:    double mX; // Solution of the FEM system
 1429: 
 1430:    // Meteorological forcing
 1431:    Vector2 u_air;
 1432:    double p_air;  // XXXX is this the same as pr?
 1433:    double t_air;
 1434:    double q_air;
 1435:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1436: 
 1437:    __device__ void setWind(Vector2 &u) {
 1438:    // Sets the wind vector taking into account the mesh angle
 1439:    
 1440:       const double speed = length(u);
 1441: 
 1442:       // Rotate wind vector to the node frame
 1443:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1444: 
 1445:       // Sets the surface stress vector due to wind.
 1446:       if constexpr(nws == 0) {
 1447:          tau = {0.0, 0.0};
 1448: 
 1449:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1450:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1451: 
 1452:       } else {
 1453: 
 1454:          double dragcoef;
 1455: 
 1456:          if constexpr(iwind_form == -1) {
 1457:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1458:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1459: 
 1460:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1461:             tau = cff*u_air;
 1462:  
 1463:          } else if constexpr(iwind_form == 1) {
 1464:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1465:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1466: 
 1467:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1468:             tau = cff*u_air;
 1469: 
 1470:          } else {
 1471:             tau = {0.0, 0.0};
 1472:          }
 1473:       }
 1474:    }
 1475: 
 1476:    #ifdef USE_FRAMES
 1477:    __device__ void setFrame(double lat, double lon) {
 1478: 
 1479:       frame.update(lat, lon);        
 1480:     }
 1481:    #endif
 1482: 
 1483:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1484: 
 1485:    __device__ double sigmaTransitionDepth(void) const;
 1486: 
 1487:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1488: 
 1489:    __inline__ __device__ Point2 outputCoords(void) const {
 1490:       if constexpr(ics == 1)  return p;
 1491:       else                    return {rad2deg*lon, rad2deg*lat};
 1492:    }
 1493: 
 1494:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1495:    // If ics == 2, convert the global point to the local frame
 1496:       
 1497:       if constexpr (ics == 1) {
 1498:          return p;
 1499:       } else {
 1500:          const Point3 c = {p.x, p.y, gz};
 1501:          const Point3 local = frame.G2L(p - c);
 1502:          return local;
 1503:       }
 1504:    }
 1505: 
 1506:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1507:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1508:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1509:    
 1510:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1511: 
 1512:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1513: 
 1514:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1515:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1516: 
 1517:    __device__ __forceinline__ void clearMatrixRow(void) {
 1518:       // Clear the matrix row for this node
 1519: 
 1520: 
 1521:       coeffDiag = 0.0;
 1522: 
 1523:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1524: 
 1525:    }
 1526: 
 1527:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1528:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1529:       
 1530:       if (node == this) {
 1531:          coeffDiag += value;
 1532:      
 1533:       } else {
 1534:          // Search (linearly)the index of the node in the array of nodes
 1535:          // XXX: This is not efficient, see if we can improve this
 1536:          int i;
 1537:          for (i = 0; i < numNodes; i++) {
 1538:             if (nodes[i] == node) {
 1539:                break;
 1540:             }
 1541:          }
 1542:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1543:          coeffMatrix[i] += value;
 1544:       }
 1545:    }
