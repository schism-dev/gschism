 8606: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8607:    Element *elems = mesh->localElemData;
 8608: 
 8609:    *addr = elems;
 8610:    *sizeElement = sizeof(Element);
 8611:    switch (varCode) {
 8612:       case (int)VarCode::z:
 8613:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8614:          *sizeType = sizeof(double);
 8615:          break;
 8616:       case (int)VarCode::x:
 8617:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8618:          *sizeType = sizeof(Vector2);
 8619:          break;
 8620:       case (int)VarCode::gradETP:
 8621:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8622:          *sizeType = sizeof(Vector2);
 8623:          break;
 8624:       case (int)VarCode::area:
 8625:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8626:          *sizeType = sizeof(double);
 8627:          break;
 8628:       case (int)VarCode::depth:
 8629:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8630:          *sizeType = sizeof(double);
 8631:          break;
 8632:       case (int)VarCode::radius:
 8633:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8634:          *sizeType = sizeof(double);
 8635:          break;
 8636:       case (int)VarCode::ghat:
 8637:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8638:          *sizeType = sizeof(Vector2);
 8639:          break;
 8640:       case (int)VarCode::kb:
 8641:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8642:          *sizeType = sizeof(int);
 8643:          break;
 8644:       case (int)VarCode::isdry:
 8645:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8646:          *sizeType = sizeof(int);
 8647:          break;            
 8648:       case (int)VarCode::w:
 8649:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8650:          *sizeType = sizeof(double);
 8651:          break;
 8652:       case (int)VarCode::FaceIndices:
 8653:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8654:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8655:          *sizeType = sizeof(Node);
 8656:          break;
 8657:       default:
 8658:          *offset = -1;
 8659:    }
 8660: }
