  969: struct Side {
  970: 
  971:    // Geometry information
  972:    int idx;               // Index of the side
  973:    Node *n1, *n2;
  974:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  975: 
  976:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  977:    Vector2 center;        // Location of side center. 
  978:    double zc[nvrt];       // Side center z-coord at each vertical level
  979: 
  980:    Frame frame;
  981: 
  982:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  983:                           // this is nullptr
  984:    
  985:    int kb;                // Bottom index of the side
  986:    bool isDry;            // True if the side is dry
  987:  
  988:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  989: 
  990:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  991: 
  992:    // Physical information
  993:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  994:    Vector2 btu[nvrt];           // Back-tracked velocity
  995:    Vector2 U;                   // Vertically averaged velocity vector  
  996: 
  997:    Vector2 nuGradU[nvrt];          // nu*grad u
  998: 
  999:    Vector2 bcc[nvrt];           // Baroclinic term
 1000:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
 1001: 
 1002:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
 1003:    Vector2 gradEta2;             // Gradient of elevation at current timestep
 1004:    Vector2 gradPr;               // Gradient of pressure
 1005:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
 1006: 
 1007: 
 1008:    double hhat;                 // \breve{H} in notes
 1009: 
 1010:    double shapiro;
 1011: 
 1012:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1013: 
 1014:    double coriolis;             // Coriolis parameter
 1015: 
 1016:    // Vegetation parameters
 1017:    double veg_c2;
 1018:    double veg_beta;
 1019: 
 1020:    // Bottom drag parameters.
 1021:    double chi;
 1022:    double chi2;
 1023: 
 1024:    __inline__ __device__ double x(double t) const;
 1025:    __inline__ __device__ double y(double t) const;
 1026:    __inline__ __device__ double lon(void) const;
 1027:    __inline__ __device__ double lat(void) const;
 1028:    __inline__ __device__ Point2 p_t(double t) const;
 1029: 
 1030:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1031:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1032:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1033: 
 1034:    __inline__ __device__ Side* neigh(int index) const { 
 1035:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1036:       assert(index >= 0 && index < 4); 
 1037:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1038: 
 1039:       const int ielem = index & 1;           // 0 or 1
 1040:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1041: 
 1042:       const Element* elem = elems[ielem];
 1043: 
 1044:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1045: 
 1046:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1047: 
 1048:    }
 1049: 
 1050:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1051: 
 1052:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1053: 
 1054:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1055:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1056:    __inline__ __device__ int iadv(void) const;
 1057: 
 1058:    __inline__ __device__ double grav3(void) const;
 1059:    
 1060:    __inline__ __device__ double eta2(void) const;
 1061:    __inline__ __device__ double eta1(void) const;
 1062:    __inline__ __device__ double w2(int k) const;
 1063:    __inline__ __device__ double depth(void) const;
 1064:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1065:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1066: 
 1067:    __inline__ __device__ double dfv(int k) const;
 1068: 
 1069:    __inline__ __device__ double veg_h(void)  const;
 1070:    __inline__ __device__ double veg_nv(void) const;
 1071:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1072:    __inline__ __device__ double veg_alpha3D(int k) const;
 1073:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1074: 
 1075:    __inline__ __device__ double Cd(void) const;
 1076: 
 1077:    __inline__ __device__ Vector2 tau(void) const;
 1078: 
 1079:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1080:    
 1081: 
 1082:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1083:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1084:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1085:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1086:    } 
 1087:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1088:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1089:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1090:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1091: 
 1092:    // Get valid starting element (for backtracking)
 1093:    __inline__ __device__ Element* getStartElement() {
 1094:       return elems[0] ? elems[0] : elems[1];
 1095:    }
 1096: 
 1097:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1098:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1099:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1100: 
 1101:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1102: 
 1103:       // Dot product of the negative velocity vector with the side normal vector
 1104:       const double dot_prod1 = -dot(u, n);
 1105: 
 1106:       // Vector from side center to element 0 centroid
 1107:       const Vector2 v2 = elems[0]->center - center;
 1108: 
 1109:       // Dot product of the vector with the side normal vector
 1110:       const double dot_prod2 = dot(v2, n);
 1111: 
 1112:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1113:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1114: 
 1115:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1116:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1117: 
 1118:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1119: 
 1120:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1121:       else                           return !isDry1 ? elems[1] : elems[0];
 1122: 
 1123:  
 1124:    }
 1125: 
 1126:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1127:       // Given an element, returns the other element that shares this side
 1128:       return (elems[0] == elem) ? elems[1] : elems[0];
 1129:    }
 1130: 
 1131:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1132:       // Given a node, returns the other node that shares this side
 1133:       return (n1 == node) ? n2 : n1;
 1134:    }
 1135:  
 1136:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1137: 
 1138: 
 1139: 
 1140: 
 1141: };
