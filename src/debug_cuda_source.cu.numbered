  682: 
  683: // GLS turbulence model
  684: template<>
  685: struct Turbulence<TurbulenceModel::GLS> {
  686:    using enum TurbulenceSubmodel;
  687:    using enum StabilityModel;
  688: 
  689:    double tke[nvrt];    // TKE
  690:    double mxl[nvrt];    // mixing length for GLS
  691:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  692:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  693: 
  694:    double diffmin;  // from diffmin.gr3
  695:    double diffmax;  // from diffmax.gr3
  696:    
  697:    __device__ void setDiffLimits(double lo, double hi) {
  698:       diffmin = lo;
  699:       diffmax = hi;
  700:    }
  701: 
  702:    // Fortran cold start: q2 = q2min, xl = xlmin2, dfq1 = dfq2 = diffmin.
  703:    // Call after setDiffLimits. depth is the node depth used by xlmin2.
  704:    __device__ void init(Node *node);
  705: 
  706: 
  707:    __device__ __forceinline__ constexpr double cpsi1() const {
  708:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  709:       else if constexpr (turbSubmodel == KL)             return 0.9;
  710:       else if constexpr (turbSubmodel == KE)             return 1.44;
  711:       else if constexpr (turbSubmodel == KW)             return 0.555;
  712:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  713:       else { assert(false && "unknown submodel"); return 0.0; }
  714:    }
  715: 
  716:    
  717:    __device__ __forceinline__ constexpr double cpsi2() const {
  718:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  719:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  720:       else if constexpr (turbSubmodel == KL)             return 0.5;
  721:       else if constexpr (turbSubmodel == KE)             return 1.92;
  722:       else if constexpr (turbSubmodel == KW)             return 0.833;
  723:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  724:       else { assert(false && "unknown submodel"); return 0.0; }
  725:    }
  726: 
  727: 
  728:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  729: 
  730:    __device__ __forceinline__ double cpsi3(double N2) const {
  731: 
  732:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  733:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  734: 
  735:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  736: 
  737:       if constexpr (turbSubmodel == MellorYamada) {
  738:          return 0.9;   
  739: 
  740:       } else { // Other GLS submodels
  741: 
  742: 
  743:          if (N2 > 0.0) { // unstable (inverse stratification)
  744:             return 1.0;   
  745: 
  746:          } else { // stable (regular stratification)
  747: 
  748:             if      constexpr (turbSubmodel == KL)             return 2.53;
  749:             else if constexpr (turbSubmodel == KE)             return -0.52;
  750:             else if constexpr (turbSubmodel == KW)             return -0.58;
  751:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  752:             else { assert(false && "unknown submodel"); return 0.0; }
  753:          }
  754: 
  755:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  756: 
  757:    }
  758: 
  759:    
  760:    __device__ __forceinline__ constexpr double rpub(void) const {
  761:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  762:       else if constexpr (turbSubmodel == KL)             return  0.0;
  763:       else if constexpr (turbSubmodel == KE)             return  3.0;
  764:       else if constexpr (turbSubmodel == KW)             return -1.0;
  765:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  766:       else { assert(false && "unknown submodel"); return 0.0; }
  767:    }
  768: 
  769: 
  770:    __device__ __forceinline__ constexpr double rmub(void) const {
  771:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  772:       else if constexpr (turbSubmodel == KL)             return 1.0;
  773:       else if constexpr (turbSubmodel == KE)             return 1.5;
  774:       else if constexpr (turbSubmodel == KW)             return 0.5;
  775:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  776:       else { assert(false && "unknown submodel"); return 0.0; }
  777:    }
  778: 
  779: 
  780:    __device__ __forceinline__ constexpr double rnub(void) const {
  781:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  782:       else if constexpr (turbSubmodel == KL)             return  1.0;
  783:       else if constexpr (turbSubmodel == KE)             return -1.0;
  784:       else if constexpr (turbSubmodel == KW)             return -1.0;
  785:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  786:       else { assert(false && "unknown submodel"); return 0.0; }
  787:    }
  788: 
  789: 
  790:    __device__ __forceinline__ constexpr double schk(void) const {
  791:       if      constexpr (turbSubmodel == KL)             return 2.44;
  792:       else if constexpr (turbSubmodel == KE)             return 1.0;
  793:       else if constexpr (turbSubmodel == KW)             return 2.0;
  794:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  795:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  796:    }
  797: 
  798: 
  799:    __device__ __forceinline__ constexpr double schpsi(void) const {
  800:       if      constexpr (turbSubmodel == KL)             return 2.44;
  801:       else if constexpr (turbSubmodel == KE)             return 1.3;
  802:       else if constexpr (turbSubmodel == KW)             return 2.0;
  803:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  804:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  805:    }
  806: 
  807: 
  808:    __device__ __forceinline__ constexpr double tkemin(void) const {
  809:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  810:          return 5.0e-6;
  811:       else
  812:          return 7.6e-6; // Warner et al., OM 2005
  813:    }
  814: 
  815: 
  816:    __device__ __forceinline__ constexpr double psimin(void) const {
  817:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  818:          return 1.0e-8;
  819:       else
  820:          return 1.0e-12; // Warner et al., OM 2005
  821:    }
  822: 
  823:    __device__ __forceinline__ constexpr double epsmin(void) const {
  824:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  825:    }
  826: 
  827:    __device__ __forceinline__ double mxlmin(double depth) const;
  828: 
  829:    
  830:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  831: 
  832:    __device__ __forceinline__ double N2(Node *node, int k) const;
  833: 
  834: 
  835:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  836: 
  837:    __device__ void computeDiffusivities(Node *node);
  838: 
  839:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  840: 
  841: 
  842:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  843:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  844:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  845:    }
  846: 
  847: 
  848:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  849:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  850:    }
  851: 
  852: };
