 7625: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7626:    // Get the value of a variable from an element
 7627:    // varName is the name of the variable to get
 7628:    // var is the array to store the value
 7629:    // k is the vertical level index of the variable to get
 7630: 
 7631:    ELEM(elem);
 7632:    
 7633:    int idx = elem->idx;
 7634:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7635: 
 7636:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7637:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7638:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7639:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7640:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7641:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7642:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7643:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7644:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7645:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7646:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7647:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7648:       
 7649:    
 7650: }
 7651: 
 7652: 
 7653: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7654:    // Get the value of a variable from an node
 7655:    // varName is the name of the variable to get
 7656:    // var is the array to store the value
 7657:    // k is the vertical level index of the variable to get
 7658: 
 7659:    NODE(node);
 7660:    
 7661:    int idx = node->idx;
 7662:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7663: 
 7664:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7665:    
 7666:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7667:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7668:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7669:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7670:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7671:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7672:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7673:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7674:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7675:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7676:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7677:    
 7678:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7679:       
 7680:    
 7681: }
 7682: 
 7683: 
 7684: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7685:    // Get the value of a variable from an side
 7686:    // varName is the name of the variable to get
 7687:    // var is the array to store the value
 7688:    // k is the vertical level index of the variable to get
 7689:    SIDE(side);
 7690:    
 7691:    int idx = side->idx;
 7692:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7693: 
 7694:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7695:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7696:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7697:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7698:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7699:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7700:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7701:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7702:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7703:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7704:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7705:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7706:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7707:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7708:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7709:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7710:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7711:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7712:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7713:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7714:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7715:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7716:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7717:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7718:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7719:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7720:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7721:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7722:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7723:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7724:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7725:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7726:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7727:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7728:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7729:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7730:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7731: }
 7732: 
 7733: 
 7734: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7735:    // Get the value of a variable from an side
 7736:    // varName is the name of the variable to get
 7737:    // var is the array to store the value
 7738:    // k is the vertical level index of the variable to get
 7739:    SIDE_BND(sideBnd);   
 7740: 
 7741:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7742:    if (sideBnd->segment->isLand) idx = -7;
 7743: 
 7744:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7745:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7746: 
 7747: }
