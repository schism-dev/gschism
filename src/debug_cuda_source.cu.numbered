 1054: // This struct is used to store the boundary information for a node.
 1055: struct NodeBoundary {   
 1056:    BoundarySegment *segment;
 1057:    Node *node;
 1058:    
 1059:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1060:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1061: 
 1062:    bool isLand;
 1063: 
 1064:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1065:    double elbc;   // Elevation boundary condition
 1066:    double eth;    // Elevation time history
 1067: 
 1068:    double eta_mean; // Mean elevation at nodes
 1069: 
 1070:    bool isEssentialBC;
 1071: 
 1072:    Vector2 uth[nvrt];  // "Time history" velocity
 1073: 
 1074:    // Arrays for harmonic constituents (if needed)
 1075:    double  emo[nbfr];  // Elevation amplitude
 1076:    double  efa[nbfr];  // Elevation phase
 1077:    Vector2 umo[nbfr];  // velocity amplitude
 1078:    Vector2 ufa[nbfr];  // velocity phase
 1079: 
 1080: 
 1081:    NodeBoundary(void) {
 1082:       isLand = false;
 1083:    }
 1084:    NodeBoundary(bool _isLand) {
 1085:       isLand = _isLand;
 1086:    }
 1087: 
 1088:    
 1089:    __forceinline__ __device__ int numSidesForAverage() const {
 1090:    // Returns the number of sides that are connected to the node and have the same segment.
 1091:    // This is used to compute the average velocity at the node for open boundary nodes.
 1092:       int res = 0;
 1093:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1094:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1095: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1096:       return res;
 1097:    }
 1098: 
 1099: 
 1100:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1101:       assert(index == 0 || index == 1); 
 1102:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1103:    }
 1104: 
 1105: 
 1106: };
