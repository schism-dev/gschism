 2999: 
 3000: 
 3001: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3002:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3003:    
 3004:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3005: }
 3006: 
 3007: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3008:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3009:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3010:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3011:    return area * dot(gradPhi[i], gradPhi[j]);
 3012: }
 3013: 
 3014: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3015:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3016:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3017:    // The formula for the integral is:
 3018:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3019:    
 3020:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3021:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3022:    const double eta_sum  = eta_n(i) + eta_n(j);
 3023:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3024: 
 3025:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3026:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3027: 
 3028: 
 3029:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3030: }
 3031:    
 3032: 
 3033: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3034:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3035:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3036:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3037:    // The formula is also based on the identity:
 3038:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3039:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3040: 
 3041:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3042: 
 3043: 
 3044: 
 3045:    double res = 0.0;
 3046:    
 3047:    // Quadrature points in xi and eta coordinates
 3048:    #pragma unroll
 3049:    for (int i = 0; i < 4; i++) {
 3050:       // For each quadrature point...
 3051: 
 3052:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3053:       const double eta = p.x;
 3054:       const double xi  = p.y;
 3055: 
 3056:       // Jacobian entries at the Gauss point p
 3057:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3058:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3059:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3060:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3061: 
 3062:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3063:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3064: 
 3065:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3066:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3067:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3068:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3069:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3070: 
 3071:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3072:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3073:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3074:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3075:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3076: 
 3077:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3078:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3079:    }
 3080: 
 3081:    return res;
 3082: }
 3083: 
 3084: 
 3085: /**  Interpolate velocities at a given point (xt,yt,zt)
 3086: 
 3087:    @param xt, yt, zt: coordinates of the point to interpolate
 3088:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3089: 
 3090:    This is done in four steps:
 3091: 
 3092:    1. Find the shape coordinates for the final position in the element.
 3093:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3094:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3095:       z levels at xt, yt at each step.   
 3096:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3097:       horizontally and vertically.
 3098: **/
 3099: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3100:    // Interpolate the velocities at the point xt. 
 3101:    // This function works the same for triangular and quadrilateral elements.
 3102:    double shpCoord[4];
 3103:    Vector3 u_int;
 3104: 
 3105: 
 3106:    // First step is to compute the shape coordinates of (xt,yt)
 3107: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3108:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3109: 
 3110:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3111: 
 3112:    // Second step is to find the level that contains zt
 3113:    // Uses a binary search to find the level
 3114:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3115:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3116:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3117:    int R = nvrt - 1;
 3118: 
 3119:    // Get the z coordinates at the nodes of the element at the levels L and R
 3120:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3121:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3122:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3123: 
 3124: 
 3125:    double zL = interpolate(shpCoord, zLAtNodes);
 3126:    double zR = interpolate(shpCoord, zRAtNodes);
 3127: 
 3128:    // Interpolates vertically the velocities
 3129:    double wght1, wght2;
 3130:    if (xt.z <= zL) {
 3131:       wght1 = 1.0;
 3132:       wght2 = 0.0;
 3133:       xt.z = zL;
 3134:    }
 3135:    else if (xt.z >= zR) {
 3136:       wght1 = 0.0;
 3137:       wght2 = 1.0;
 3138:       xt.z = zR;
 3139:    }
 3140:    else {
 3141:       // Perform a binary search to find the levels between L and R that contain xt.z
 3142:       while (R - L > 1) {
 3143:          int M = (L + R) / 2.0;
 3144: 
 3145:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3146:          double zM = interpolate(shpCoord, zMAtNodes);
 3147:          if (zM < xt.z) 
 3148:          {
 3149:             L = M;
 3150:             zL = zM;
 3151:          }
 3152:          else 
 3153:          {
 3154:             R = M;
 3155:             zR = zM;
 3156:          }
 3157:       }
 3158:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3159:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3160: 
 3161:       wght2 = (xt.z - zL)/(zR - zL);
 3162:       wght1 = 1.0 - wght2;
 3163: 
 3164:    }
 3165: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3166: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3167:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3168:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3169:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3170:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3171: 
 3172:    // Project the velocity from the local frame to the origSide frame
 3173:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3174:    u_int = {uv.x, uv.y, w};
 3175: 
 3176:    // Neither of the interpolated velocities should be NaN
 3177:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3178: 
 3179:    return u_int;
 3180: 
 3181: }
 3182: 
 3183: 
 3184: 
 3185: 
 3186: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3187: 
 3188:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3189:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3190:    const Node *n1 = side->n1;
 3191:    const Node *n2 = side->n2;
 3192: 
 3193:    bool n1_match = (n1->nodeBnd->segment == segment);
 3194:    bool n2_match = (n2->nodeBnd->segment == segment);
 3195: 
 3196:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3197:    if (n1_match && n2_match) {
 3198:       return 0.5;
 3199:    } else if (n1_match) {
 3200:       return 1.0;
 3201:    } else if (n2_match) {
 3202:       return 0.0;
 3203:    }
 3204: 
 3205:    return 0.0;
 3206: }
 3207: 
 3208: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3209: 
 3210: 
 3211: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3212: 
 3213:    const double w1 = getBoundaryArrayValueWeight();
 3214:    const double w2 = 1.0 - w1;
 3215:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3216:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3217: 
 3218:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3219: }
 3220: 
 3221: 
 3222: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3223:    const double w1 = getBoundaryArrayValueWeight();
 3224:    const double w2 = 1.0 - w1;
 3225:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3226:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3227: 
 3228:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3229: 
 3230: }
 3231: 
 3232: 
 3233: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3234:    // Returns the value of the velocity at the side center
 3235:    const double w1 = getBoundaryArrayValueWeight();
 3236:    const double w2 = 1.0 - w1;
 3237:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3238:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3239: 
 3240:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3241: }
 3242: 
 3243: 
 3244: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3245:    // Returns the value of the normal component of the velocity at the side center
 3246:    const double w1 = getBoundaryArrayValueWeight();
 3247:    const double w2 = 1.0 - w1;
 3248:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3249:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3250: 
 3251:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3252: }
 3253: 
 3254: 
 3255: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3256:    if constexpr(ics == 1) {
 3257:       return center;
 3258: 
 3259:    } else {
 3260:       const Point2 p0 = n1->outputCoords();
 3261:       const Point2 p1 = n2->outputCoords();
 3262:       return (1.0/2.0)*(p0 + p1);
 3263: 
 3264:    }
 3265: }
 3266: 
 3267: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3268: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3269: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3270: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3271: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3272: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3273: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3274: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3275: // Computes the gradient of the field at the side center.
 3276:    Vector2 grad = {0.0, 0.0};
 3277:    int count = 0;
 3278: 
 3279:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3280:    // as the average of the gradients at each element.
 3281:    // First element
 3282:    if (elems[0] != nullptr && condition(elems[0])) {
 3283:       Vector2 elemGrad = elems[0]->grad2(field);
 3284: 
 3285:       // For ics=2, projects the element gradient from its frame to the side frame
 3286:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3287: 
 3288:       grad += elemGrad;
 3289: 
 3290:       count++;
 3291:    }
 3292: 
 3293:    // Second element
 3294:    if (elems[1] != nullptr && condition(elems[1])) {
 3295: 
 3296:       Vector2 elemGrad = elems[1]->grad2(field);
 3297: 
 3298:       // For ics=2, projects the element gradient from its frame to the side frame
 3299:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3300: 
 3301:       grad += elemGrad;
 3302: 
 3303:       count++;
 3304:    }
 3305: 
 3306:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3307:    if (count > 0) {
 3308:       grad = grad*(1.0/count);
 3309:    }
 3310:    
 3311:    return grad;
 3312: }
 3313: 
 3314: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3315: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3316: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3317: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3318: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3319: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3320: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3321: 
 3322: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3323: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3324: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3325: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3326: 
 3327: 
 3328: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3329: 
 3330: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3331:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3332:    if constexpr(ics == 1) { 
 3333:       return 0.5*(n1->tau + n2->tau);
 3334: 
 3335:    } else {
 3336:       // Project the tau from the node frames to the side frame
 3337:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3338:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3339: 
 3340:       return 0.5*(stau1 + stau2);
 3341:    }
 3342: }
 3343: 
 3344: /**
 3345:  * This method performs backtracking from the side center until a time -dt back in time 
 3346:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3347:  * intermediate point.
 3348:  *
 3349:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3350:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3351:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3352:  * remaining time.
 3353:  * 
 3354:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3355:  * 
 3356:  * @param uuint, vvint, wwint: Velocities at the final point
 3357:  * @param jlev: Level at which the backtracking is performed
 3358:  * @param dt, dtbk: Tracking timesteps
 3359:   */
 3360: __inline__ __device__ void Side::btrack(
 3361:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3362:       double dt,            // Tracking time
 3363:       double dtbk,          // Tracking timestep
 3364:       Vector3 &u_int        // Velocities at the initial point
 3365: ) const {
 3366: 
 3367:    // Start from side center
 3368:    Point3 x0;
 3369: 
 3370:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3371:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3372: 
 3373:  
 3374:    double time_rm = dt; // Remaining time
 3375:    double time_rm_1 = 1e10;
 3376:    double time_rm_2 = 2e10;
 3377:    double time_rm_3 = 3e10;
 3378: 
 3379: 
 3380:    // Initial velocities
 3381:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3382: 
 3383:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3384:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3385: 
 3386:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3387: 
 3388: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3389: 
 3390: 
 3391:    constexpr int MAX_ITERATIONS = 100; 
 3392:    int iter = 0;
 3393:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3394:    while(true) {
 3395: 
 3396:       // Calculate timestep
 3397:       const double dtb = min(dtbk, time_rm);
 3398: 
 3399:       // Next point in the backtracking curve
 3400:       xt = x0 - dtb*u_int;
 3401: 
 3402:       double t, s; // parameters for the line segments p0pt and p1p2
 3403:       Side *lastCrossSide = nullptr;
 3404:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3405: 
 3406: 
 3407:       if (time_rm_3 <= time_rm) {
 3408:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3409:          xt = x0;
 3410:          break;
 3411:       }
 3412: 
 3413: 
 3414:       if (!found) {
 3415:       // This means that the walk reached a boundary or a dry element.
 3416: 
 3417:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3418: 
 3419:          // Finds the point at the boundary where the line segment x0xt intersects.
 3420:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3421:          // due to floating point errors, it does not exactly intersect.
 3422:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3423:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3424:          // To compute the intersection point we start with the parametric equations.
 3425:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3426:          // We cross-prouct by v1 to cancel the s term:
 3427:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3428:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3429: 
 3430:          // Side coordinates in the origSide frame.
 3431:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3432:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3433: 
 3434:          Point2  p0 = {x0.x, x0.y};
 3435:          Point2  pt = {xt.x, xt.y};
 3436: 
 3437:          const Vector2 v1 = pt - p0;
 3438:          const Vector2 v2 = p2 - p1;
 3439: 
 3440: 
 3441: 
 3442:          // We are assuming intersection, so we clamp t to the range [0,1].
 3443:          const double denom = cross(v2, v1);
 3444:          
 3445: 
 3446: 
 3447: 
 3448:          if (abs(denom) < small) {
 3449:             // small denominators are fairly common. They occur when the line segment x0xt 
 3450:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3451:             // boundary, where the backtracking curve startt sliding along the boundary.
 3452:             // In this case, we simply assume that the two lines are very close to each other
 3453:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3454:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3455:             if (t<0.0000000001) t = 0.0;
 3456:             if (t>0.9999999999) t = 1.0;
 3457: 
 3458:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3459:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3460: 
 3461:          }
 3462:          else {
 3463:             
 3464:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3465:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3466:             if (t>0.9999999999) t = 1.0;
 3467:             // From the originaL equation we can solve for s:
 3468:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3469:             // Computing the dot product by v1, we get:
 3470:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3471:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3472:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3473: 
 3474:          }
 3475: 
 3476:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3477: 
 3478: 
 3479:          // We update the new target point to be right at the intersection point,
 3480:          // and the remaining time must include the time we haven't "used".
 3481:          time_rm -= s*dtb;
 3482:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3483: 
 3484: 
 3485:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3486:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3487: 
 3488:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3489:          // but extracting only the component along the tangent vector v2.
 3490:          Vector2 tangent = normalize(v2);
 3491:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3492: 
 3493:          const Vector2 u2D = make_double2(u.x, u.y);
 3494:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3495: 
 3496: 
 3497:       } else {
 3498: 
 3499:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3500: 
 3501:          time_rm -= dtb; 
 3502: 
 3503:          u_int = curElem->interpolateVelocities(xt, this);
 3504: 
 3505:       }
 3506: 
 3507:       if (time_rm <= 0.0) break; 
 3508: 
 3509:       // If the velocity is too small, we stop the backtracking
 3510:       const double vmag2 = norm2(toVector2(u_int));
 3511:       if (vmag2 <= velmin_btrack_sq)  {
 3512:          time_rm = 0.0; 
 3513:          return; 
 3514:       }
 3515: 
 3516:       // The current point becomes the next segment's starting point.
 3517:       x0 = xt;
 3518:  
 3519:       iter++;
 3520: 
 3521: // XXXXXXXXXXXXXXXXX
 3522: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3523:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3524: 
 3525:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3526:       time_rm_3 = time_rm_2;
 3527:       time_rm_2 = time_rm_1;
 3528:       time_rm_1 = time_rm;
 3529:    }
 3530: 
 3531:    assert(curElem != nullptr && "Final element is nullptr");
 3532:    assert(!curElem->isDry && "Final element is dry");
 3533:    
 3534: 
 3535: 
 3536:    // Interpolate the velocities at the final point with respect to the current side frame
 3537:    u_int = curElem->interpolateVelocities(xt, this);
 3538: 
 3539: 
 3540: }
 3541: 
 3542: 
 3543: 
 3544: 
 3545: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3546: 
 3547: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3548: 
 3549:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3550:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3551: 
 3552:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3553:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3554: 
 3555:    double fun_lat = 0.0;
 3556:    switch (jspc[idxComp]) {
 3557:       case 0:
 3558:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3559:          break;
 3560:       case 1:
 3561:          fun_lat = sin(2.0*lat);
 3562:          break;
 3563:       case 2:
 3564:          fun_lat = pow<2>(cos(lat));
 3565:          break;
 3566:       default:
 3567:          assert(false && "computeETP: invalid jspc");
 3568:    }
 3569:    
 3570:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3571: 
 3572: }
 3573: 
 3574: 
 3575: __device__ void Node::updateKb(void) {
 3576: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3577: 
 3578:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3579: 
 3580: 
 3581:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3582: 
 3583:    if constexpr(ivcor == 2) {  // SZ coordinates
 3584:       
 3585:       // Compute bottom level index
 3586:       if (depth <= mesh->h_s) {
 3587:          kb = izlev;   
 3588:          
 3589:       } else {
 3590:          kb = -1;
 3591:          int L = 0;
 3592:          int R = nzlev; 
 3593:          
 3594:          while (L <= R) {
 3595:             int M = (R + L) / 2;
 3596: 
 3597: 
 3598:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3599:             
 3600:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3601:                R = M;
 3602:             } else {
 3603:                L = M;
 3604:             }
 3605: 
 3606:             if (R - L == 1) {
 3607:                kb = L;
 3608:                break;
 3609:             }
 3610:          }
 3611: 
 3612:          // Checks that the binary search was successful
 3613:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3614:        
 3615:       }
 3616:    } 
 3617: }
 3618: 
 3619: 
 3620: __device__ __inline__ void Node::updateZCoordData(void) {
 3621: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3622: 
 3623:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3624:    // if (isDry2()) {
 3625:    //    kb = -1;  // XXXXXXXX KKKKK
 3626:    //    return;
 3627:    // }
 3628: 
 3629: 
 3630:    if constexpr(ivcor == 2) {  // SZ coordinates
 3631:       
 3632:       // Compute bottom level index
 3633:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3634:    } 
 3635:    else {  // if (ivcor == 1) Localized sigma
 3636:       // Do nothing
 3637:    }
 3638: 
 3639: 
 3640: }
 3641: 
 3642: 
 3643: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3644:    // Computes the z coordinate at level k.
 3645:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3646:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3647:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3648:    // used 
 3649: 
 3650:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3651:    
 3652:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3653: 
 3654:    if (isDry2()) return 0.0;  
 3655: 
 3656:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3657: 
 3658:    if constexpr(ivcor == 2) {
 3659: 
 3660:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3661:       const double h_c = mesh->h_c;
 3662:       const double theta_f = mesh->theta_f;
 3663:       const double sinh_theta_f = mesh->sinh_theta_f;
 3664: 
 3665: 
 3666:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3667:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3668:       // once per time step/node. XXXX
 3669:       // CHECK: updateZCoordData
 3670: 
 3671:       //  To simplify comparisons, I define index versions of count variables.
 3672:       if      (k == ivrt)     return eta2; 
 3673:       else if (k == izlev)    return -hmod2;
 3674:       else if (k == kb)       return -depth;
 3675:       else if (k < izlev)     return mesh->ztot[k];
 3676:       else if (k > izlev) {
 3677:          const int ksig = k - izlev;
 3678: 
 3679:          if (hmod2 <= h_c) {
 3680:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3681: 
 3682:          } 
 3683:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3684:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3685:             assert(false && "compZCoord: invalid h_c\n");
 3686:          } 
 3687:          else {
 3688:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3689:                    h_c * mesh->sigma[ksig] + 
 3690:                    (hmod2 - h_c) * mesh->cs[ksig];
 3691:          }
 3692:       } else { 
 3693:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3694:       }
 3695: 
 3696:    }
 3697:    else {  // if constexpr(ivcor == 1)
 3698:       if (k <= kb)        return -depth; 
 3699:       else if (k == ivrt) return eta2;
 3700:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3701: 
 3702:    }
 3703:    
 3704:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3705:    return 0.0;
 3706: }
 3707: 
 3708: 
 3709: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3710:    // Computes the bottom drag Cd based on the selected nchi
 3711: 
 3712:    if constexpr(nchi == 0) {
 3713:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3714:       Cd = drag;  // Read from drag file
 3715: 
 3716:    } else if constexpr(nchi == 1) {
 3717:       // 
 3718: 
 3719:       bool ltmp = false; // for WBL iteration
 3720: 
 3721:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3722:       if (isDry || (rough == 0.0)) {
 3723:          Cd = 0.0;
 3724: 
 3725:       } else { //roughness >0 
 3726:          
 3727:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3728: 
 3729:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3730: 
 3731:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3732: 
 3733:       } // if rough
 3734: 
 3735:    } else if constexpr(nchi == -1) {
 3736:    // Manning 
 3737:  
 3738:       const double htot = max(hmin_man, htot2()); 
 3739:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3740: 
 3741:    } else {
 3742:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3743:       
 3744:    } // if nchi
 3745: 
 3746: }
 3747: 
 3748: 
 3749: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3750:    // Checks if a side in on the boundary
 3751:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3752: 
 3753:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3754:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3755: 
 3756:    // Indices of the nodes that form the side
 3757:    //
 3758:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3759:    const int n1 = side.n1->idx;
 3760:    const int n2 = side.n2->idx;
 3761:    isLand = false;
 3762:    
 3763: 
 3764:    // Check if the side is on a land boundary
 3765:    for (int i = 0; i < nland; i++) {
 3766:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3767:          // Consecutive nodes in the land boundary segment
 3768:          const int b1 = ilnd[i + j*nland];
 3769:          const int b2 = ilnd[i + (j + 1)*nland];
 3770: 
 3771:          assert(b1 != -1 && b2 != -1);
 3772: 
 3773:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3774:             
 3775:             isLand = true;
 3776:             return i;
 3777:          }
 3778:       }
 3779:    }
 3780: 
 3781:    // Check if the side is on an open boundary
 3782:    for (int i = 0; i < nope; i++) {
 3783:       for (int j = 0; j < nond[i] - 1; j++) {
 3784:          // Consecutive nodes in the open boundary segment
 3785:          const int b1 = iond[i + j*nope];
 3786:          const int b2 = iond[i + (j + 1)*nope];
 3787: 
 3788:          assert(b1 != -1 && b2 != -1);
 3789: 
 3790:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3791:             isLand = false;
 3792:             return i;
 3793:          }
 3794:       }
 3795:    }
 3796: 
 3797:    return -1;
 3798: }
 3799: 
 3800: 
 3801: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3802:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3803:                                     double *wind_rotate_angle, 
 3804:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3805:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3806:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3807:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3808:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3809: 
 3810:    NODE(pnode);  
 3811:    const int i = idx_node;
 3812:    Node &node(*pnode);
 3813: 
 3814:    node.idx = i;
 3815: 
 3816:    const int idxNodeStart = nodeNeighNodesStart[i];
 3817:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3818:    node.numNodes = idxNodeEnd - idxNodeStart;
 3819:    node.nodes = nodeNeighNodes + idxNodeStart;
 3820:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3821: 
 3822: 
 3823: 
 3824:    const int idxElemStart = nodeNeighElemsStart[i];
 3825:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3826:    node.numElements = idxElemEnd - idxElemStart;
 3827:    node.elements = nodeNeighElems + idxElemStart;
 3828: 
 3829: 
 3830:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3831:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3832:       const int partNode = localNodePart[idxNodeGlobal]; 
 3833:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3834: 
 3835:       Node *node_ptr = nodes[partNode] + idxNode;
 3836:       
 3837:       nodeNeighNodes[idx] = node_ptr;
 3838:    }
 3839: 
 3840: 
 3841:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3842:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3843:       const int partElem = localElemPart[idxElemGlobal];
 3844:       const int idxElem  = localElemIndices[idxElemGlobal];
 3845: 
 3846:       Element *elem_ptr = elems[partElem] + idxElem;
 3847: 
 3848:       nodeNeighElems[idx] = elem_ptr;
 3849:    }      
 3850: 
 3851:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3852:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3853: 
 3854:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3855: 
 3856:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3857:    if constexpr(ics == 1) {
 3858:       node.p.x   = node_coords[i * 3];
 3859:       node.p.y   = node_coords[i * 3 + 1];
 3860:       node.gz = 0.0;
 3861: 
 3862:       if (use_ll) {                                    // <-- add
 3863:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3864:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3865:       }  
 3866: 
 3867:    } else {
 3868:       const double lon = deg2rad*node_coords[i * 3];
 3869:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3870: 
 3871:       Point3 p = computeXYZfromLatLon(lat, lon);
 3872:       node.p = toVector2(p);
 3873:       node.gz = p.z;
 3874:       node.lon = lon;
 3875:       node.lat = lat;
 3876: 
 3877:       #ifdef USE_FRAMES
 3878:       node.setFrame(lat, lon);
 3879:       #endif
 3880: 
 3881: 
 3882:    }
 3883: 
 3884:    node.depth = node_coords[i * 3 + 2];
 3885: 
 3886:    node.numSides = 0;
 3887: 
 3888:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3889:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3890:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3891:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3892:    else assert(false && "populateNodes: selected nchi not implemented.");
 3893: 
 3894:    if constexpr(ivcor == 1) 
 3895:    {  
 3896:       node.kb = kb[i];
 3897: 
 3898:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3899:    }
 3900: 
 3901:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3902:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3903:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3904: 
 3905:    
 3906:    // Links the node to the boundary information
 3907:    if (isbnd[i] >= 0) {
 3908:      
 3909:       // Get the index of the node boundary
 3910:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3911: 
 3912:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3913:       node.nodeBnd->node = &node;
 3914: 
 3915:       node.nodeBnd->sideBnd1 = nullptr;
 3916:       node.nodeBnd->sideBnd2 = nullptr;
 3917: 
 3918:       if (isbnd[i]>=0) {
 3919: 
 3920:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3921:          
 3922:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3923:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3924: 
 3925:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3926:          node.nodeBnd->segment->clen  = nan("1");
 3927:          node.nodeBnd->segment->carea = nan("1");
 3928: 
 3929:       }
 3930:    } else {
 3931: 
 3932:       node.nodeBnd = nullptr; // For internal nodes
 3933: 
 3934:       if (isbnd[i] == landSegment) {
 3935:          node.nodeBnd = &landBoundaryNode;
 3936:          node.nodeBnd->segment = &landBoundarySegment;
 3937:       }
 3938:       
 3939:    }
 3940:    
 3941:    // XXXX GAUSSIAN HILL VELOCITIES
 3942:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3943:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3944:          constexpr double rot_per = 3000.0;
 3945:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3946:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3947:       // XXXXX
 3948:    #endif
 3949: 
 3950: }
 3951: 
 3952: 
 3953: 
 3954: 
 3955: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3956:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3957:                                     double *wind_rotate_angle,   
 3958:                                     int *isdel, int *isidenode, int *isbnd,
 3959:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3960:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3961:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3962:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3963:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3964:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3965:                                     double *drag, double *roughness) {
 3966: 
 3967: 
 3968:    SIDE(pside);
 3969:    Side &side(*pside);
 3970:    const int i = idx_side;
 3971: 
 3972:    side.idx = i;  
 3973:    
 3974:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3975:    const double fc   = 2.0*omega_e*sin(sfea0);
 3976:    const double beta = 2.0*omega_e*cos(sfea0);
 3977: 
 3978:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3979: 
 3980:    // finding the pointer to the nodes that form the side
 3981:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3982:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3983: 
 3984:    const int locidx_n1 = localNodeIndices[idx_n1];
 3985:    const int locidx_n2 = localNodeIndices[idx_n2];
 3986:    const int part_n1 =   localNodePart[idx_n1];
 3987:    const int part_n2 =   localNodePart[idx_n2];
 3988: 
 3989:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3990:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3991: 
 3992: 
 3993:    // Counts the number of sides connected to each node
 3994:    atomicAdd(&side.n1->numSides, 1);
 3995:    atomicAdd(&side.n2->numSides, 1);
 3996: 
 3997:    // Side boundary type
 3998:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3999:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4000: 
 4001:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4002:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4003:    {
 4004:       bool isLand = false;
 4005:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4006:       
 4007:       if (isbs > -1) {
 4008:          // assert(isLand || isbs>=0);
 4009:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4010: 
 4011:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4012: 
 4013:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4014:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4015: 
 4016:          assert (isLand == side.sideBnd->segment->isLand);
 4017: 
 4018: printf("idx_side: %d, side.sideBnd = %p, n1bnd->idx: %d, n2bnd->idx: %d, n1bnd->sideBnd1: %p, n1bnd->sideBnd2: %p, n2bnd->sideBnd1: %p, n2bnd->sideBnd2: %p\n", i, side.sideBnd, n1bnd->idx, n2bnd->idx, n1bnd->sideBnd1, n1bnd->sideBnd2, n2bnd->sideBnd1, n2bnd->sideBnd2);
 4019: 
 4020:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4021:          // if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4022:          // else                            n1bnd->sideBnd2 = side.sideBnd;
 4023: 
 4024:          // if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4025:          // else                            n2bnd->sideBnd2 = side.sideBnd;
 4026:          
 4027:          side.sideBnd->side = &side;
 4028: 
 4029:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4030:          n1bnd->linkSideBoundary(side.sideBnd);
 4031:          n2bnd->linkSideBoundary(side.sideBnd);
 4032: 
 4033:       }
 4034:       else {
 4035:          side.sideBnd = nullptr;
 4036:       }
 4037:    }
 4038:    else 
 4039:    {
 4040:       side.sideBnd = nullptr;
 4041:    }
 4042: 
 4043: 
 4044:    // finding the pointer to the elements that share the side
 4045:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4046:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4047: 
 4048:    if (idx_e1 > -1) {
 4049:       const int locidx_e1 = localElemIndices[idx_e1];
 4050:       const int part_e1 =  localElemPart[idx_e1];
 4051:       side.elems[0] = elems[part_e1] + locidx_e1;
 4052: 
 4053:    }
 4054:    else {
 4055:       side.elems[0] = nullptr;
 4056:    }
 4057: 
 4058:    if (idx_e2 > -1) {
 4059:       const int locidx_e2 = localElemIndices[idx_e2];
 4060:       const int part_e2 =  localElemPart[idx_e2];
 4061:       side.elems[1] = elems[part_e2] + locidx_e2;
 4062:    }
 4063:    else {
 4064:       side.elems[1] = nullptr;
 4065:    }
 4066:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4067:       
 4068:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4069:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4070:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4071:          
 4072:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4073:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4074:       // printf("sideBnd: %p\n", side.sideBnd);
 4075:       // assert(false && "Side has no elements and no boundary");
 4076:    }
 4077:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4078: 
 4079:    // Compute the center of the side
 4080:    side.center = 0.5*(side.n1->p + side.n2->p);
 4081: 
 4082:    #ifdef USE_FRAMES
 4083:    side.setFrame();
 4084:    #endif
 4085: 
 4086:    // Normal, unitary vector to the side
 4087:    if constexpr(ics == 1) {
 4088:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4089:       side.n = normalize(side.n);
 4090:    }
 4091:    else {
 4092:       // Unit side vector in 3D cartesian coordinates
 4093:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4094: 
 4095:       nSide = normalize(nSide);
 4096: 
 4097:       // Its cross product with the unit local z-axis vector (nUp) is the
 4098:       // normal vector we are looking for.
 4099:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4100: 
 4101:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4102:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4103:       side.n = -normalize(n2D); 
 4104: 
 4105:    }
 4106: 
 4107:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4108:    side.shapiro = shapiro0;
 4109: 
 4110:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4111:    // XXXX
 4112:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4113:    constexpr double rot_per=3000.0;
 4114:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4115:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4116:    // XXXXX      
 4117:    #endif
 4118:    // Compute the z level at the center of the side
 4119:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4120:    
 4121:    // Compute the length of the side
 4122:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4123: 
 4124: 
 4125:    // Compute the Coriolis coefficient
 4126: 
 4127:    if constexpr(ncor == -1 || ncor == 0) {
 4128:       side.coriolis = coricoef;
 4129:    }
 4130:    else {
 4131:       const double sphi = side.lat();  // Latitude at the center of the side
 4132: 
 4133:       assert(use_ll && "use_ll must be true when ncor > 0");
 4134: 
 4135:       if constexpr(ics == 1) {
 4136:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4137:       }
 4138:       else { // ics == 2
 4139:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4140:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4141:       }
 4142: 
 4143:    }
 4144: 
 4145: }
 4146: 
 4147: 
 4148: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4149:    double *node_coords, double *node_coords_ll, bool use_ll,
 4150:    double *wind_rotate_angle,   
 4151:    int *isdel, int *isidenode, int *isbnd,
 4152:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4153:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4154:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4155:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4156:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4157:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4158:    double *drag, double *roughness) {
 4159: 
 4160:    ELEM(pelem);
 4161:    Element &elem(*pelem);
 4162:    const int i = idx_elem;
 4163: 
 4164:    elem.idx = i;
 4165: 
 4166:    for (int j = 0; j < i34[i]; j++) {
 4167:       const int idxNode = elnode[i*4 + j];  
 4168:       const int idxSide = elside[i*4 + j];
 4169:       
 4170:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4171:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4172: 
 4173:       // Find the neighboring element  
 4174:       if (elem.sides[j]->elems[0] == &elem) {
 4175:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4176:       }
 4177:       else {
 4178:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4179:       }
 4180:       
 4181:    }
 4182: 
 4183:    elem.i34 = i34[i];
 4184: 
 4185:    // Compute the barycenter of the element and its depth
 4186:    elem.center = {0.0, 0.0};
 4187:    elem.depth = 1e10;
 4188:    for (int j = 0; j < i34[i]; j++) {
 4189: 
 4190:       elem.center += elem.nodes[j]->p/i34[i];
 4191:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4192:    }
 4193: 
 4194:    #ifdef USE_FRAMES
 4195:    elem.setFrame();
 4196:    #endif
 4197: 
 4198:    elem.area = elem.computeSignedArea(); 
 4199:    elem.radius = sqrt(elem.area)/pi; 
 4200:    
 4201:    // Determines which way the normal vector to each side is oriented.
 4202:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4203:    for (int j = 0; j < i34[i]; j++)  
 4204:    {
 4205:       if (elem.sides[j]->elems[0] == &elem) {
 4206:          elem.ssign[j] =  1.0;
 4207:       }
 4208:       else {
 4209:          elem.ssign[j] = -1.0;
 4210:       }
 4211: 
 4212:    }
 4213: 
 4214:   
 4215: 
 4216:    // Derivatives of shape functions
 4217:    //  For ics=2, this is done in the element frame
 4218:    //  For quads, the derivative is evaluated at centroid
 4219:    for (int j = 0; j < elem.i34; j++) {
 4220:       const double area = elem.area;
 4221:       const int id2 = elem.nxq(1 + j);
 4222:       const int id3 = elem.nxq(2 + j);
 4223:       const int id4 = elem.nxq(3 + j);
 4224:       if (elem.isTri()) {
 4225:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4226:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4227:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4228:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4229:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4230:          // And so on for the other shape functions.
 4231: 
 4232:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4233:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4234:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4235: 
 4236:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4237:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4238: 
 4239:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4240: 
 4241:       }
 4242:       else  { // Quad, the derivatives are evaluated at the centroid
 4243: 
 4244:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4245:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4246:          // ...
 4247:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4248: 
 4249:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4250:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4251:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4252: 
 4253:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4254:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4255: 
 4256:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4257: 
 4258:       } // if Tri/Quad
 4259: 
 4260:    } // for j   
 4261:    
 4262:    
 4263: 
 4264: }
 4265: 
 4266: 
 4267: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4268:                                             double *emo, double *efa, 
 4269:                                             double *umo, double *ufa, 
 4270:                                             double *vmo, double *vfa,
 4271:                                             int *ifltype, int *iettype) {
 4272: 
 4273:    NODE_BND(nodeBnd);
 4274:    const int idx = idx_node_bnd;    
 4275: 
 4276:    nodeBnd->idx = idx;
 4277: 
 4278:    // Need to find the segment index and the index of the node on the segment
 4279:    int idxNode = -1;
 4280:    int iseg, i;
 4281:    for (iseg = 0; iseg < nope; iseg++) {
 4282:       // for each segment...
 4283:       for (i = 0; i < nond[iseg]; i++) {
 4284:          idxNode = iond[iseg + i*nope];
 4285:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4286:          
 4287:       }
 4288:    }
 4289: 
 4290:    assert(iseg < nope && "iseg is out of bounds");
 4291: 
 4292: found: // Jumped here when the node was found
 4293: printf("idxNode: %d, iseg: %d, i: %d\n", idxNode, iseg, i);
 4294:    nodeBnd->isEssentialBC = true;
 4295:    nodeBnd->elbc = 0.0;
 4296: 
 4297:    nodeBnd->segment->ifltype = ifltype[iseg];
 4298:    nodeBnd->segment->iettype = iettype[iseg];
 4299: 
 4300:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4301: 
 4302:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4303: 
 4304:       nodeBnd->efa[jfr] = efa[idx2];
 4305:       nodeBnd->emo[jfr] = emo[idx2];
 4306:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4307:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4308: 
 4309:    }
 4310:         
 4311: 
 4312: }
 4313: 
 4314: __device__ void Mesh::populateBoundarySideLinks(void) {
 4315: 
 4316:    SIDE_BND(sideBnd);
 4317: 
 4318:    const Side *side = sideBnd->side;
 4319: 
 4320:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4321:    // and the rightSide is the side s that has s->n1 == side->n2
 4322:    for (int i = 0; i < mesh->nbs; i++) {
 4323: 
 4324:       Side *s = &mesh->localSideData[i];
 4325: 
 4326:       if (s == side) continue;  // Do not link the side to itself
 4327:    
 4328:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4329:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4330:    }
 4331:    
 4332: }
