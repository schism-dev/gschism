 1402: struct BoundarySegment {
 1403: 
 1404:    bool isLand;
 1405: 
 1406:    int idx; // Index of the boundary segment in the input files.
 1407: 
 1408:    double clen;  // Length of the boundary segment
 1409:    double carea; // Area of the boundary segment
 1410: 
 1411:    int ifltype;  // Type of flow boundary condition
 1412:    
 1413:    // Elevation boundary condition
 1414:    int iettype;  // Type of elevation boundary condition
 1415:    double eth;   // Elevation time history
 1416: 
 1417:    // Flow boundary condition
 1418:    double qthcon;  // Flow time history constant
 1419:    double vobc1;   // Velocity coefficient 1
 1420:    double vobc2;   // Velocity coefficient 2
 1421: 
 1422:    // Tracer boundary conditions
 1423:    // double trobc[natrm];    // Tracer boundary condition nudging factor
 1424:    // int  itrtype[natrm];    // Tracer boundary condition type
 1425: 
 1426:    BoundarySegment(bool _isLand) {
 1427:       isLand = _isLand;
 1428:       clen = 0.0;
 1429:       carea = 0.0;
 1430:       ifltype = 0;
 1431:       iettype = 0;
 1432:       eth = 0.0;
 1433:    }
 1434: 
 1435:    BoundarySegment(void) {
 1436:       isLand = false;
 1437:       clen = 0.0; 
 1438:       carea = 0.0;
 1439:       ifltype = 0;
 1440:       iettype = 0;
