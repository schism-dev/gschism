  990: // This struct is used to store the boundary information for a node.
  991: struct NodeBoundary {   
  992:    BoundarySegment *segment;
  993:    Node *node;
  994:    
  995:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  996:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  997: 
  998:    double etaic;  // Elevation at nodes used for essential boundary conditions
  999:    double elbc;   // Elevation boundary condition
 1000:    int iettype;   // Type of elevation boundary condition
 1001:    double eth;    // Elevation time history
 1002: 
 1003:    double eta_mean; // Mean elevation at nodes
 1004: 
 1005:    bool isEssentialBC;
 1006: 
 1007: 
 1008:    // Arrays for harmonic constituents (if needed)
 1009:    double emo[nbfr];  // Elevation amplitude
 1010:    double efa[nbfr];  // Elevation phase
 1011:    double umo[nbfr];  // U-velocity amplitude
 1012:    double ufa[nbfr];  // U-velocity phase
 1013:    double vmo[nbfr];  // V-velocity amplitude
 1014:    double vfa[nbfr];  // V-velocity phase 
 1015: 
 1016:    
 1017:    __forceinline__ __device__ int numSidesForAverage() const {
 1018:    // Returns the number of sides that are connected to the node and have the same segment.
 1019:    // This is used to compute the average velocity at the node for open boundary nodes.
 1020:       int res = 0;
 1021:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1022:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1023:       return res;
 1024:    }
 1025: 
 1026: 
 1027:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1028:       assert(index == 0 || index == 1); 
 1029:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1030:    }
 1031: 
 1032: 
 1033: };
 1034: 
 1035: struct Node {
 1036: 
 1037:    // Geometry information
 1038:    int idx;        // Index of the node
 1039:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1040:    int numNodes;   // Number of nodes neighbors of this node
 1041: 
 1042:    Element **elements; // Array of pointers to the elements that share this node
 1043:    int numElements;    // Number of elements that share this node
 1044: 
 1045:    int numSides;       // Number of sides that are connected to this node
 1046: 
 1047:    Point3 p;
 1048:    Vector3 u2[nvrt];
 1049:    double z[nvrt];
 1050:    double lon, lat;
 1051:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1052:    double depth;
 1053: 
 1054:    int kb;       // Bottom index of the node
 1055: 
 1056:    bool isDry;     // True if the node is dry
 1057: 
 1058:    int iadv;     // Advection flag
 1059: 
 1060:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1061:                           // this is nullptr
 1062: 
 1063:    TempVar tmp; // Temporary variable to store different types of variables
 1064: 
 1065:    // Physical information
 1066:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1067:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1068: 
 1069:    double rho[nvrt];     // Density
 1070:    double dfv[nvrt];     // Vertical viscosity
 1071: 
 1072:    double eta1; // Elevation at nodes at previous timestep
 1073:    double eta2; // Elevation at nodes at current timestep
 1074: 
 1075:    double ETP;  // Earth Tidal Potential
 1076: 
 1077:    double pr;    // Air pressure
 1078:    double grav2; // Gravity 
 1079:    
 1080:    Vector2 dav;  // Depth averaged velocity
 1081: 
 1082:    Vector2 tau; // Wind stress vector
 1083: 
 1084:    // Vegetation parameters
 1085:    double veg_h;
 1086:    double veg_nv;
 1087:    double veg_di;
 1088:    double veg_Cd;
 1089:    double veg_h_unbent;
 1090:    double veg_di_unbent;
 1091:    double veg_nv_unbent;
 1092:    double veg_alpha_vert_mean;
 1093:    double veg_alpha0;
 1094:    double veg_alpha3D[nvrt];
 1095: 
 1096:    // Bottom drag parameters
 1097:    double Cd;       // Bottom drag coefficient
 1098:    double rough;    // Bottom roughness length
 1099:    Vector2 tau_bot; // Bottom stress vector
 1100: 
 1101:    double bdef1; // Bottom deformation at previous timestep
 1102:    double bdef2; // Bottom deformation at current timestep
 1103: 
 1104:    double qel; // RHS
 1105:    double coeffDiag; // Diagonal coefficient of the matrix
 1106:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1107: 
 1108:    double mP; // Search direction for conjugate gradient method
 1109:    double mR; // Residual for conjugate gradient method
 1110:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1111:    double mX; // Solution for conjugate gradient method
 1112: 
 1113:    // Meteorological forcing
 1114:    Vector2 u_air;
 1115:    double p_air;
 1116:    double t_air;
 1117:    double q_air;
 1118:    double wind_angle;  // Wind rotation angle
 1119: 
 1120:    __device__ void setWind(Vector2 &u) {
 1121:    // Sets the wind vector taking into account the wind rotation angle
 1122:    
 1123:       const double dir = atan2(-u.x,-u.y);
 1124:       const double speed = length(u);
 1125: 
 1126:       // Calculate new u and v components with added rotation angle
 1127:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1128:    }
 1129: 
 1130:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1131: 
 1132:    __device__ double sigmaTransitionDepth(void) const;
 1133: 
 1134:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1135:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1136:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1137: 
 1138:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1139: 
 1140:    __device__ void clearMatrixRow(void) {
 1141:       // Clear the matrix row for this node
 1142:       coeffDiag = 0.0;
 1143:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1144: 
 1145:    }
 1146: 
 1147:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1148:       // Add the value to the sparse matrix for this node
 1149:       
 1150:       if (node == this) {
 1151:          coeffDiag += value;
 1152: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1153:       } else {
 1154:          // Search (linearly)the index of the node in the array of nodes
 1155:          // XXX: This is not efficient, see if we can improve this
 1156:          int i;
 1157:          for (i = 0; i < numNodes; i++) {
 1158:             if (nodes[i] == node) {
 1159:                break;
 1160:             }
 1161:          }
 1162:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1163:          coeffMatrix[i] += value;
 1164:       }
 1165:    }
 1166: 
 1167: #ifdef BACKTRACKING
 1168:    __device__ void updateZCoordData() {
 1169:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1170: 
 1171:       // Check if node is wet
 1172:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1173: 
 1174:       if (idry) return;
 1175: 
 1176:       if constexpr(ivcor == 2) {  // SZ coordinates
 1177:          
 1178:          // Compute bottom level index
 1179:          if (depth <= mesh->h_s) {
 1180:                kb = mesh->nzlevels;
 1181:          } else {
 1182:                kb = -1;
 1183:                for (int i = 0; i < mesh->kz-1; i++) {
 1184:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1185:                      kb = i;
 1186:                      break;
 1187:                   }
 1188:                }
 1189:          }
 1190:       } 
 1191:       else if (ivcor == 1) {  // Localized sigma
 1192:          // Do nothing
 1193:       }
 1194: 
 1195:    }
 1196: #endif   
 1197: 
 1198:    __device__ double compZCoord(int k) const;
 1199: 
 1200:    __device__ void updateKb(void);
 1201: 
 1202: 
 1203: 
 1204: };
