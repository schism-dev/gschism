 3499:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3500: 
 3501:       NODE_BND(nodeBnd);
 3502: 
 3503:       Node *node = nodeBnd->node;
 3504: 
 3505:       node->ETP = 0.0;
 3506: 
 3507:       for (int j=0; j<ntip; j++) {
 3508: 
 3509:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3510:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3511:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3512: 
 3513:          if constexpr(iloadtide==1) { // loading tide
 3514:             assert(false && "Loading tide not implemented");
 3515:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3516:          }
 3517:          
 3518:       }
 3519:       
 3520:    }
