 1635: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1636:    // Computes the 3D normal vector to the element at level k
 1637:    // Returns the normal vector and the area of the element
 1638: 
 1639:       if (isTri()) {
 1640:          // For triangles...
 1641: 
 1642:          // Gets the normal vector to the element (with a length equal to twice the area)
 1643:          if constexpr(ics==1) {
 1644:             const int kb0 = max(k, nodes[0]->kb);
 1645:             const int kb1 = max(k, nodes[1]->kb);
 1646:             const int kb2 = max(k, nodes[2]->kb);
 1647: 
 1648:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1649:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1650:             
 1651:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1652:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1653:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1654:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1655: 
 1656:             area3D = sqrt(nx*nx + ny*ny + nz*nz);
 1657: 
 1658:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1659: 
 1660:             return {nx/area3D, ny/area3D, nz/area3D};
 1661: 
 1662:            
 1663:          }
 1664:          else {  // lat/lon
 1665:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1666: 
 1667:          } // if ics
 1668:       }
 1669:       else {
 1670:          // For quads...
 1671: 
 1672:          assert(false && "Element normal vector: quads not yet implemented");
 1673: 
 1674: 
 1675:       }
 1676:    }
 1677: 
 1678: /**
 1679:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1680:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1681:    If the segment is completely inside the element, then it returns true.
 1682: 
 1683:    This function assumes:
 1684:    - The initial point is on a side of the element. 
 1685:    - Its position is given by parameter t in the range [0,1].
 1686:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1687:       intersects the element (elements are convex).
 1688: 
 1689:    To find the intersection point, this function does the following:
 1690:    - it finds the intersection of the line segment with all the element side lines,
 1691:       except for the one that contains the initial point.
 1692:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1693:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1694:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1695:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1696:       track segment is almost parallel to the element side line.
 1697: 
 1698:    Inputs:
 1699:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1700:    @param x2, y2: other end of the line segment
 1701: 
 1702:    Outputs:
 1703:    @param side:  side that intersects the line segment (input and output)
 1704:    @param nextElement (output): element that contains the intersection point
 1705:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1706:    @param zint (input/output): Vertical coordinate of the intersection point
 1707: 
 1708:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1709:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1710:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1711: 
 1712:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1713:    (Delta) being zero.
 1714: 
 1715:    The intersection2 point happens when:
 1716:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1717:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1718:    
 1719:    Assumption: the 4 points (including those of the side segment) are different.
 1720:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1721:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1722:    If true, (xIntersect,yIntersect) is the intersection.				
 1723:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1724: **/
 1725: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1726:                                               double &t, double& tIntersect) {
 1727: 
 1728:    double closest_intersect_t = 1e10;
 1729:    bool found_intersection = false;
 1730: 
 1731:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1732:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1733:    const Point2 x1 = side->point(t);
 1734:    
 1735: 
 1736:    Side *nextSide = nullptr;
 1737:    for (int i = 0; i < i34; i++) {
 1738: 
 1739:       // Element's i-th side 
 1740:       Side *side2 = sides[i];
 1741: 
 1742:       // Skip the side that contains the initial point
 1743:       if (side2 == side) continue;
 1744: 
 1745:       // (x3,y3)-(x4,y4) is the element side line
 1746:       const Point2 x3 = side2->n1->p2();
 1747:       const Point2 x4 = side2->n2->p2();
 1748: 
 1749:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1750:       const double delta = cross(x2 - x1, x3 - x4);
 1751: 
 1752:       if (delta != 0.0) {
 1753: 
 1754:          const double delta1 = cross(x3 - x1, x3 - x4);
 1755:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1756: 
 1757:          // Solves the two linear equations for tt1 and tt2
 1758:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1759:          const double tt2 = delta2/delta;
 1760: 
 1761:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1762:             closest_intersect_t = min(closest_intersect_t, tt1);
 1763:             nextSide = side2;
 1764: 
 1765:             nextElement = nextSide->otherElem(this);
 1766:             tIntersect = max(small, min(tt1, 1.0-small));
 1767:             t = tt2;
 1768: 
 1769:             found_intersection = true;
 1770:          }
 1771:       
 1772:       }
 1773: 
 1774:    }
 1775:    
 1776: printf("AAA 1, found_intersection = %d, nextSide = %p, nextElement = %p\n", found_intersection, nextSide, nextElement);
 1777: 
 1778: 
 1779:    // found_intersection should always be true, since we checked all the sides.  
 1780:    side = nextSide;
 1781: // if (found_intersection) {
 1782: // if (nextElement == nullptr)  printf("$$$  0, %d, %.5f, %.5f\n",  side->idx, side->x(t), side->y(t));
 1783: // else   printf("$$$  %d, %d, %.5f, %.5f\n", nextElement->idx, side->idx, side->x(t), side->y(t));
 1784: // }   
 1785:    // if (!found_intersection) {
 1786:    //    // Check if the segment is parallel to the initial side
 1787:    //    printf("XXX segment: side = %p\n", side);
 1788:    //    printf("XXX %f\n", dot(x2 - x1, side->n1->p2() - side->n2->p2()));
 1789:    //    if (abs(dot(x2 - x1, side->n1->p2() - side->n2->p2())) < small) {
 1790:    //       assert(false && "Segment is parallel to the initial side");
 1791:    //       found_intersection = true;
 1792:    //       nextElement = side->otherElem(this);
 1793:    //       tIntersect = t;
 1794:    //       t = 0.0;
 1795:    //       found_intersection = true;
 1796:    //    }
 1797:    // }
 1798:    return found_intersection;
 1799: }
