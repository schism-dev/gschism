 7108:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7109:                    double *node_coords, double *wind_rotate_angle, 
 7110:                    int *isdel, int *isidenode, int *isbnd,
 7111:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7112:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7113:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7114:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7115:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7116:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7117:                    double *emo, double *efa, 
