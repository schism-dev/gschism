 1745: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1746:    // Computes the 3D normal vector to the element at level k
 1747:    // Returns the normal vector and the area of the element
 1748: 
 1749:       if (isTri()) {
 1750:          // For triangles...
 1751: 
 1752:          // Gets the normal vector to the element (with a length equal to twice the area)
 1753:          if constexpr(ics==1) {
 1754:             const int kb0 = max(k, nodes[0]->kb);
 1755:             const int kb1 = max(k, nodes[1]->kb);
 1756:             const int kb2 = max(k, nodes[2]->kb);
 1757: 
 1758:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1759:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1760:             
 1761:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1762:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1763:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1764:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1765: 
 1766:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1767:             area3D = 0.5*len;
 1768: 
 1769:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1770: 
 1771:             return {nx/len, ny/len, nz/len};
 1772: 
 1773:            
 1774:          }
 1775:          else {  // lat/lon
 1776:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1777: 
 1778:          } // if ics
 1779:       }
 1780:       else {
 1781:          // For quads...
 1782: 
 1783:          assert(false && "Element normal vector: quads not yet implemented");
 1784: 
 1785: 
 1786:       }
 1787:    }
 1788: 
 1789: /**
 1790:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1791:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1792:    If the segment is completely inside the element, then it returns true.
 1793: 
 1794:    This function assumes:
 1795:    - The initial point is on a side of the element. 
 1796:    - Its position is given by parameter t in the range [0,1].
 1797:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1798:       intersects the element (elements are convex).
 1799: 
 1800:    To find the intersection point, this function does the following:
 1801:    - it finds the intersection of the line segment with all the element side lines,
 1802:       except for the one that contains the initial point.
 1803:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1804:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1805:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1806:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1807:       track segment is almost parallel to the element side line.
 1808: 
 1809:    Inputs:
 1810:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1811:    @param x2, y2: other end of the line segment
 1812: 
 1813:    Outputs:
 1814:    @param side:  side that intersects the line segment (input and output)
 1815:    @param nextElement (output): element that contains the intersection point
 1816:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1817:    @param zint (input/output): Vertical coordinate of the intersection point
 1818: 
 1819:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1820:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1821:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1822: 
 1823:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1824:    (Delta) being zero.
 1825: 
 1826:    The intersection2 point happens when:
 1827:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1828:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1829:    
 1830:    Assumption: the 4 points (including those of the side segment) are different.
 1831:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1832:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1833:    If true, (xIntersect,yIntersect) is the intersection.				
 1834:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1835: **/
 1836: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1837:                                               double &t, double& tIntersect) {
 1838: 
 1839:    double closest_intersect_t = 1e10;
 1840:    bool found_intersection = false;
 1841: 
 1842:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1843:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1844:    const Point2 x1 = side->point(t);
 1845:    
 1846: 
 1847:    Side *nextSide = nullptr;
 1848:    for (int i = 0; i < i34; i++) {
 1849: 
 1850:       // Element's i-th side 
 1851:       Side *side2 = sides[i];
 1852: 
 1853:       // Skip the side that contains the initial point
 1854:       if (side2 == side) continue;
 1855: 
 1856:       // (x3,y3)-(x4,y4) is the element side line
 1857:       const Point2 x3 = side2->n1->p;
 1858:       const Point2 x4 = side2->n2->p;
 1859: 
 1860:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1861:       const double delta = cross(x2 - x1, x3 - x4);
 1862: 
 1863:       if (delta != 0.0) {
 1864: 
 1865:          const double delta1 = cross(x3 - x1, x3 - x4);
 1866:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1867: 
 1868:          // Solves the two linear equations for tt1 and tt2
 1869:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1870:          const double tt2 = delta2/delta;
 1871: 
 1872:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1873:             closest_intersect_t = min(closest_intersect_t, tt1);
 1874:             nextSide = side2;
 1875: 
 1876:             nextElement = nextSide->otherElem(this);
 1877:             tIntersect = max(small, min(tt1, 1.0-small));
 1878:             t = tt2;
 1879: 
 1880:             found_intersection = true;
 1881:          }
 1882:       
 1883:       }
 1884: 
 1885:    }
 1886: 
 1887:    // found_intersection should always be true, since we checked all the sides.  
 1888:    side = nextSide;
 1889: 
 1890:    return found_intersection;
 1891: }
 1892: 
 1893: 
 1894: 
 1895: 
 1896: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1897:                                               double &t, double& tIntersect) {
 1898: 
 1899:    double closest_intersect_t = 1e10;
 1900:    bool found_intersection = false;
 1901: 
 1902:    for (int i = 0; i < i34; i++) {
 1903: 
 1904:       Side *side2 = sides[i];
 1905: 
 1906:       // (x3,y3)-(x4,y4) is the element side line
 1907:       const Point2 x3 = side2->n1->p;
 1908:       const Point2 x4 = side2->n2->p;
 1909: 
 1910:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1911:       const double delta = cross(x2 - x1, x3 - x4);
 1912: 
 1913:       if (abs(delta) > 0) {
 1914: 
 1915:          const double delta1 = cross(x3 - x1, x3 - x4);
 1916:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1917: 
 1918:          // Solves the two linear equations for tt1 and tt2
 1919:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1920:          const double tt2 = delta2/delta;
 1921: 
 1922:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1923:             closest_intersect_t = min(closest_intersect_t, tt1);
 1924:             side = side2;
 1925:             nextElement = side->otherElem(this);
 1926:             t = tt2;
 1927:             tIntersect = max(small, min(tt1, 1.0-small));
 1928:             found_intersection = true;
 1929:          }
 1930:       
 1931:       }
 1932:       else {  // parallel segments
 1933:          assert(false && "Parallel segments");
 1934:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1935:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1936: 
 1937:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1938: 
 1939:          // const double dist = dot(x1 - x3, side2->n);
 1940:          // if (abs(dist) < small*length(x3 - x4)) {
 1941:          //    const double2 unitarySide = normalize(x4 - x3);
 1942:          //    const double len = dot(x2 - x1, unitarySide);
 1943:          //    t = t + len;
 1944:          //    t = max(0.0, min(t, 1.0));
 1945:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1946: 
 1947: 
 1948:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1949:          //    // t = tt2;
 1950:          //    found_intersection = true;
 1951:          // }
 1952:       }
 1953: 
 1954: 
 1955:    }
 1956: 
 1957:       
 1958:    assert(found_intersection && "No intersection found");
 1959: 
 1960:    // found_intersection should always be true, since we checked all the sides.  
 1961:    return found_intersection;
 1962: }
 1963: 
 1964: 
 1965: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1966:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1967: 
 1968:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1969: 
 1970:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1971:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1972:    // curElement.
 1973: 
 1974:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1975:    // And uses this velocity instead to continue the tracking.
 1976: 
 1977:    // computes the intersection point in cartesian coordinates
 1978:    Point2 intersection = nextSide->p_t(tt);
 1979: 
 1980:    // Nudges the point to the barycenter of the element. 
 1981:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1982:    // next segment intersects the element sides.  
 1983:    curElem->nudgeToBarycenter(intersection);
 1984: 
 1985:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1986:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1987:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1988:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1989: 
 1990:    // If the side is an open boundary, the tangential velocity is zero.
 1991:    if (nextSide->isBnd()) vtan = 0.0;
 1992: 
 1993:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1994:    const double us = vtan*nextSide->t().x;
 1995:    const double vs = vtan*nextSide->t().y;
 1996:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 1997: 
 1998:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1999:    const double len2 = norm2(intersection - toPoint2(xt));
 2000:    const double vel2 = dot(u_int, u_int);        
 2001:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2002:    else            dt = 0.0;
 2003: 
 2004:    // The end of this tracking segment is now the intersection point.
 2005:    xt = {intersection.x, intersection.y, zint};
 2006: 
 2007:    u_int = {us, vs, ws};
 2008:    
 2009: }
 2010: 
 2011: /**
 2012:  * Tracks a particle through elements and vertical levels in the mesh.
 2013:  * 
 2014:  * @param x0,y0,z0     Starting position coordinates
 2015:  * @param xt,yt,zt     Target position coordinates
 2016:  * @param dtb          Time step for tracking
 2017:  * @param uuint,vvint,wwint Initial velocity components
 2018:  * @param nextElem     Starting/resulting element index
 2019:  * 
 2020:  * @return Status code of type trackExitCodes
 2021:  * 
 2022:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2023:  * of the details are different. The idea is that the code requires less branches and is better fit
 2024:  * for GPU execution.
 2025:  * 
 2026:  * The main ideas here are:
 2027:  * - The starting point is expected to be in the starting element.
 2028:  * - The end point is guaranteed to be inside an element.
 2029:  * - since the starting point is inside the element, there are only two cases: 
 2030:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2031:  *     (b) it does not and (xt,yt) is already in the starting element.
 2032:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2033:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2034:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2035:  * - tt1 can be positive or negative. We only consider the positive values.
 2036:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2037:  * - The next intersection will occur at the smallest positive tt1.
 2038:  * - This intersection will be the next (x0,y0) position.
 2039:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2040:  *   of getting stuck in a loop.
 2041:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2042:  *   was found.
 2043:  */
 2044: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2045:                                                        Element *&nextElem, int &jlev, double &dt,
 2046:                                                        const Side *origSide) {
 2047: 
 2048: 
 2049: 
 2050:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2051:    // else to do.
 2052:    // If it is, nudges the point to be inside the element.
 2053:    const Element *curElem = nextElem;
 2054:    if (containsPoint(toPoint2(xt), true)) {
 2055: 
 2056:       curElem->interpolateVelocities(xt, u_int);
 2057: 
 2058: addDebugPlot(x0, xt);
 2059:       return true;
 2060:    }
 2061: 
 2062:    Side *side = nullptr;
 2063: 
 2064:    // 1. Initial checks
 2065:    // Verify starting element is valid (wet)
 2066:    assert(!curElem->isDry && "Starting element is dry");
 2067: 
 2068:    // Checks if track has a zero length.
 2069:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2070:    // assert(len2 > 0.0 && "Zero length track"); 
 2071:    
 2072:    const int MAX_ITERATIONS = 1000;
 2073:    
 2074:    double t;
 2075:    Side *nextSide = nullptr;
 2076:    double tIntersect = 1e10;
 2077:    double zint = x0.z;
 2078: 
 2079:    // Horizontal tracking loop
 2080:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2081:    // (x0,y0) is inside the element but the target point is not.
 2082: 
 2083:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2084: 
 2085:    assert(found_intersection && "No intersection found at %d");
 2086: 
 2087:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2088: 
 2089:    // if the tracking segment goes out of water (either dry or edge boundary)
 2090:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2091: 
 2092: addDebugPlot(x0, xt, 0x00A0FF);
 2093:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2094: addDebugPlot(x0, xt, 0x00A0FF);      
 2095: 
 2096:       nextElem = this;
 2097:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2098:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2099:       return true;    
 2100:    }
 2101: 
 2102: 
 2103:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2104:    int iterations = 0;
 2105:    while (iterations < MAX_ITERATIONS) {
 2106:       iterations++;
 2107:       
 2108:       Element *curElem = nextElem;
 2109: 
 2110:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2111: addDebugPlot(x0, xt);
 2112:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2113: 
 2114:       // If we are already in the target element, we are done.
 2115:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2116:       if (!found_intersection) break;
 2117: 
 2118: 
 2119: 
 2120:       // if the tracking segment goes out of water (either dry or edge boundary).
 2121:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2122: addDebugPlot(x0, xt, 0x00A0FF);
 2123:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2124: addDebugPlot(x0, xt, 0x00A0FF);   
 2125:          nextElem = curElem;
 2126: 
 2127:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2128:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2129:          return true;
 2130:       }
 2131:       
 2132:       // Update position and element for next iteration
 2133:       side = nextSide;
 2134: 
 2135:    }
 2136: 
 2137:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2138: 
 2139:  
 2140:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2141:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2142: addDebugPlot(x0, xt);   
 2143:    nextElem->interpolateVelocities(xt, u_int); 
 2144: 
 2145:    return true;
 2146: }
 2147: 
 2148: 
 2149: __inline__ __device__ double Element::computeSignedArea(void) const {
 2150:    // Compute the area of the element
 2151: 
 2152:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2153: 
 2154:    // In the quad case we need to add the area of the other triangle.
 2155:    if (isQuad()) {
 2156:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2157:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2158:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2159:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2160: 
 2161:       res += ar1;
 2162:    }
 2163: 
 2164:    return res;
 2165: }
 2166: 
 2167: 
 2168: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2169:                                                                 (nodes[1]->isDry2()) ||
 2170:                                                                 (nodes[2]->isDry2()) ||
 2171:                                                                 (i34==4 && nodes[3]->isDry2());
 2172: }
 2173: 
 2174: __inline__ __device__ double Element::detJ_eta(void) const {
 2175:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2176:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2177: }
 2178: 
 2179: __inline__ __device__ double Element::detJ_xi(void) const {
 2180:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2181:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2182: }
 2183: 
 2184: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2185:    // In boundary sides, the element 1 is nullptr
 2186:    return side->elems[1] == nullptr; 
 2187: }
 2188: 
 2189: 
 2190: 
 2191: /**
 2192:    Compute the shape coordinates of the point (xt,yt) in the element.
 2193:    @param xt (input): x-coordinate of the point
 2194:    @param shpCoords (output): shape coordinates of the point
 2195:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2196:    @return true if the point is inside the element, false otherwise
 2197: **/
 2198: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2199:                                             bool fixNegshpCoord) const {
 2200: 
 2201:    // Compute the shape coordinates of the point xt in the element.
 2202:    if (i34==3) {
 2203:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2204:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2205:       // and in this case, the pt will be nudged into the element
 2206:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2207:       // from the local frame, so use additional check.
 2208: 
 2209:       Point2 x0, x1, x2;
 2210: 
 2211:       if constexpr(ics==1) {
 2212:          x0 = nodes[0]->p;
 2213:          x1 = nodes[1]->p;
 2214:          x2 = nodes[2]->p;
 2215:       }
 2216:       else // lat/lon
 2217:       {
 2218:          Error("Not implemented yet");
 2219: #ifdef ICS2
 2220:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2221:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2222:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2223: #endif
 2224:       }
 2225: 
 2226:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2227:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2228:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2229:       shpCoords[3] = 0.0;
 2230:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2231: 
 2232:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2233:       // then we fix the negative shape coordinates.
 2234:       if (fixNegshpCoord && tmpmin<=0.0) {
 2235: 
 2236:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2237:          // keeping the sum of the shape coordinates equal to 1.
 2238:          // I have tested and compared the new algorithm with the old one, and they give
 2239:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2240:          // The new algorithm should be faster since it is branchless.
 2241:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2242:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2243:          
 2244:          shpCoords[0] = (shpCoords[0] + a)*b;
 2245:          shpCoords[1] = (shpCoords[1] + a)*b;
 2246:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2247: 
 2248:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2249:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2250:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2251:          }
 2252: 
 2253:          // Update the point coordinates for the new shape coordinates
 2254:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2255:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2256:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2257: 
 2258:       }
 2259: 
 2260:       // Check if the point is inside the element
 2261:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2262:    }
 2263:    else {
 2264:       Error("Not implemented yet");
 2265: #ifdef QUADS
 2266:       // Reproject pt in eframe of nel for ics=2
 2267:       if constexpr(ics==1) {
 2268:          xn2 = xt; 
 2269:          yn2 = yt;
 2270:       }
 2271:       else {
 2272:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2273:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2274:       }
 2275: 
 2276:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2277: #endif
 2278:    }
 2279: 
 2280:    return false;  // Never reached
 2281: 
 2282: }
 2283: 
 2284: 
 2285: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2286: // Convert shape coordinates to cartesian coordinates
 2287: 
 2288:    if (i34 == 3) {
 2289:       // Triangular element
 2290:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2291:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2292:    }
 2293:    else {
 2294:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2295:    }
 2296: 
 2297: }
 2298: 
 2299: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2300:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2301:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2302:    // The formula for the integral is:
 2303:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2304: 
 2305:    printf("intPhiPhi: TEST\n");
 2306: 
 2307:    const Node *n0 = nodes[0];
 2308:    const Node *n1 = nodes[1];
 2309:    const Node *n2 = nodes[2];
 2310:    const Node *n3 = nodes[3];
 2311: 
 2312:    const Vector2 p0 = n0->p;
 2313:    const Vector2 p1 = n1->p;
 2314:    const Vector2 p2 = n2->p;
 2315:    const Vector2 p3 = n3->p;
 2316: 
 2317:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2318:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2319:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2320:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2321: 
 2322:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2323: }
 2324:    
 2325: 
 2326: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2327:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2328:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2329:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2330:    // The formula is also based on the identity:
 2331:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2332:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2333: 
 2334:    printf("intGradPhiGradPhi: TEST\n");   
 2335: 
 2336:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2337: 
 2338:    const double x0 = nodes[0]->p.x;
 2339:    const double y0 = nodes[0]->p.y;
 2340:    const double x1 = nodes[1]->p.x;
 2341:    const double y1 = nodes[1]->p.y;
 2342:    const double x2 = nodes[2]->p.x;
 2343:    const double y2 = nodes[2]->p.y;
 2344:    const double x3 = nodes[3]->p.x;
 2345:    const double y3 = nodes[3]->p.y;
 2346: 
 2347:    double res = 0.0;
 2348:    
 2349:    // Quadrature points in xi and eta coordinates
 2350:    #pragma unroll
 2351:    for (int i = 0; i < 4; i++) {
 2352:       // For each quadrature point...
 2353: 
 2354:       const Point2 p = GaussPoint(i);
 2355:       const double eta = p.x;
 2356:       const double xi  = p.y;
 2357: 
 2358:       // Jacobian entries at the Gauss point p
 2359:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2360:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2361:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2362:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2363: 
 2364:       const double detJ = jacobianDet(p);
 2365:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2366: 
 2367:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2368:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2369:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2370:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2371:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2372: 
 2373:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2374:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2375:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2376:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2377:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2378: 
 2379:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2380:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2381:    }
 2382: 
 2383:    return res;
 2384: }
 2385: 
 2386: 
 2387: /**  Interpolate velocities at a given point (xt,yt,zt)
 2388: 
 2389:    @param xt, yt, zt: coordinates of the point to interpolate
 2390:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2391: 
 2392:    This is done in four steps:
 2393: 
 2394:    1. Find the shape coordinates for the final position in the element.
 2395:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2396:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2397:       z levels at xt, yt at each step.   
 2398:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2399:       horizontally and vertically.
 2400: **/
 2401: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2402:    // Interpolate the velocities at the point xt. 
 2403:    // This function works the same for triangular and quadrilateral elements.
 2404:    double shpCoord[4];
 2405: 
 2406:    // First step is to compute the shape coordinates of (xt,yt)
 2407:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2408:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2409: 
 2410:    // Second step is to find the level that contains zt
 2411:    // Uses a binary search to find the level
 2412:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2413:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2414:    int R = nvrt - 1;
 2415: 
 2416:    // Get the z coordinates at the nodes of the element at the levels L and R
 2417:    double zLAtNodes[4], zRAtNodes[4];
 2418:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2419:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2420: 
 2421:    double zL = interpolate(shpCoord, zLAtNodes);
 2422:    double zR = interpolate(shpCoord, zRAtNodes);
 2423:    
 2424:    // Interpolates vertically the velocities
 2425:    double wght1, wght2;
 2426:    if (xt.z<=zL) {
 2427:       wght1 = 1.0;
 2428:       wght2 = 0.0;
 2429:    }
 2430:    else if (xt.z>=zR) {
 2431:       wght1 = 0.0;
 2432:       wght2 = 1.0;
 2433:    }
 2434:    else {
 2435:       // Perform a binary search to find the levels between L and R that contain xt.z
 2436:       while (R - L > 1) {
 2437:          int M = (L + R) / 2;
 2438: 
 2439:          double zMAtNodes[4];
 2440:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2441:          double zM = interpolate(shpCoord, zMAtNodes);
 2442:          if (zM < xt.z) 
 2443:          {
 2444:             L = M;
 2445:             zL = zM;
 2446:          }
 2447:          else 
 2448:          {
 2449:             R = M;
 2450:             zR = zM;
 2451:          }
 2452:       }
 2453:       assert(L == R-1);
 2454:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2455: 
 2456:       wght2 = (xt.z - zL)/(zR - zL);
 2457:       wght1 = 1.0 - wght2;
 2458:    }
 2459: 
 2460:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2461:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2462: 
 2463:    // Neither of the interpolated velocities should be NaN
 2464:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2465: 
 2466: }
 2467: 
 2468: 
 2469: 
 2470: 
 2471: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2472: 
 2473:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2474:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2475:    const Node *n1 = side->n1;
 2476:    const Node *n2 = side->n2;
 2477: 
 2478:    bool n1_match = (n1->nodeBnd->segment == segment);
 2479:    bool n2_match = (n2->nodeBnd->segment == segment);
 2480: 
 2481:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2482:    if (n1_match && n2_match) {
 2483:       return 0.5;
 2484:    } else if (n1_match) {
 2485:       return 1.0;
 2486:    } else if (n2_match) {
 2487:       return 0.0;
 2488:    }
 2489: 
 2490:    return 0.0;
 2491: }
