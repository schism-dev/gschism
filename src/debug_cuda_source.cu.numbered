 7250: __global__ void returnMatrix(double *res) {
 7251:    // Debugging: returns the matrix as a CuPy array
 7252: 
 7253:    const int size = mesh->np;
 7254:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7255:       const Node *node = mesh->localNodeData + idx_node;
 7256:       res[idx_node*size + idx_node] = node->coeffDiag;
 7257:       for (int j = 0; j < node->numNodes; j++) {
 7258:          Node* nbNode = node->nodes[j];
 7259:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7260:       }
 7261: 
 7262:    }
 7263:    
 7264: }
