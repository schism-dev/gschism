  328: // Polynomial class
  329: template<int grade>
  330: struct Polynomial {
  331:     // Static assertion to give a clear error message at compile time
  332:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  333: };
  334: 
  335: 
  336: // Explicit specialization for grade 4
  337: template<>
  338: struct Polynomial<4> {
  339:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  340: 
  341:    // Constructor from coefficients
  342:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  343: 
  344:    __device__ __forceinline__ double eval(double x) const {
  345:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  346:    }
  347: };
  348: 
  349: // ------------------------------------------------------------------------------------------------
  350: 
  351: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  352:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  353:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  354: }
  355: 
  356: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  357:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  358:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  359: }
  360: 
  361: 
  362: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  363:    x3 = y1*z2 - y2*z1;
  364:    y3 = x2*z1 - x1*z2;
  365:    z3 = x1*y2 - x2*y1;
  366: }
  367: 
  368: 
  369: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  370: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  371: 
  372:    const double radius2 = dot(p, p);
  373:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  374:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  375: 
  376:    rlon = atan2(p.y, p.x); // (-pi,pi]
  377: 
  378:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  379:       rlat = asin(p.z/sqrt(radius2));
  380:    } else {
  381:       rlat = asin(p.z/rearth_pole);
  382:    }
  383:   
  384: }
  385: 
  386: __inline__ __device__ void Error(const char* msg) {
  387:    printf("Error: %s\n", msg);
  388:    assert(false);
  389: }
