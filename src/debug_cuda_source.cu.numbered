 9349: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 9350:    Element *elems = mesh->localElemData;
 9351: 
 9352:    *addr = elems;
 9353:    *sizeElement = sizeof(Element);
 9354:    switch (varCode) {
 9355:       case (int)VarCode::z:
 9356:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 9357:          *sizeType = sizeof(double);
 9358:          break;
 9359:       case (int)VarCode::x:
 9360:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 9361:          *sizeType = sizeof(Vector2);
 9362:          break;
 9363:       case (int)VarCode::gradETP:
 9364:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 9365:          *sizeType = sizeof(Vector2);
 9366:          break;
 9367:       case (int)VarCode::area:
 9368:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 9369:          *sizeType = sizeof(double);
 9370:          break;
 9371:       case (int)VarCode::depth:
 9372:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 9373:          *sizeType = sizeof(double);
 9374:          break;
 9375:       case (int)VarCode::radius:
 9376:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 9377:          *sizeType = sizeof(double);
 9378:          break;
 9379:       case (int)VarCode::ghat:
 9380:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 9381:          *sizeType = sizeof(Vector2);
 9382:          break;
 9383:       case (int)VarCode::kb:
 9384:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 9385:          *sizeType = sizeof(int);
 9386:          break;
 9387:       case (int)VarCode::isdry:
 9388:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 9389:          *sizeType = sizeof(int);
 9390:          break;            
 9391:       case (int)VarCode::w:
 9392:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 9393:          *sizeType = sizeof(double);
 9394:          break;
 9395:       case (int)VarCode::FaceIndices:
 9396:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 9397:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 9398:          *sizeType = sizeof(Node);
 9399:          break;
 9400:       default:
 9401:          *offset = -1;
 9402:    }
 9403: }
