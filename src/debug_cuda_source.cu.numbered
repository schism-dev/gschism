 9439: 
 9440: __global__ void returnMatrix(double *res) {
 9441:    // Debugging: dense local matrix, row-major, size = mesh->np
 9442:    // Assumes single-partition / local indexing (see note below).
 9443: 
 9444:    const int size = mesh->np;
 9445: 
 9446:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9447:       const Node *node = mesh->localNodeData + idx_node;
 9448: 
 9449:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9450: 
 9451:       for (int j = 0; j < node->numNodes; j++) {
 9452:          const Node *nbNode = node->nodes[j];
 9453:          // Only dump neighbors that live on this partition
 9454:          if (nbNode->part != mesh->partNum) continue;
 9455: 
 9456:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9457:          const double aij = node->coeffRow[node->csrSlot[j]];
 9458:          if (aij != 0.0)
 9459:             res[jlocal * size + idx_node] = aij;
 9460:       }
 9461:    }
 9462: }
 9463: 
 9464: 
 9465: __global__ void returnX(double *res) {
 9466:    // Debugging: returns the matrix as a CuPy array
 9467: 
 9468:    const int size = mesh->np;
 9469:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9470:       const Node *node = mesh->localNodeData + idx_node;
 9471: 
 9472:       res[idx_node] = node->mX;
 9473: 
 9474:    }
 9475:    
 9476: }
 9477: 
 9478: 
