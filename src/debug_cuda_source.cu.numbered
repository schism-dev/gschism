 4778:    __global__ void computeFlowBcVelocities(double time) {
 4779: 
 4780:       SIDE_BND(sideBnd);
 4781: 
 4782:       const Side *side = sideBnd->side;
 4783:  
 4784:       const bool isDry = side->isDry;
 4785:       const bool isLand = sideBnd->segment->isLand;
 4786: 
 4787:    
 4788:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4789: 
 4790:       if (isDry || isLand) return;
 4791: 
 4792:       // For wet sides in open boundaries...
 4793:       const Vector2 n = side->n;
 4794:       const BoundarySegment *segment = sideBnd->segment;
 4795: 
 4796:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4797: 
 4798:       const int ifltype = segment->ifltype;
 4799: 
 4800:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4801:       const Vector2 r_nuth0 = r_uth0*n;
 4802: 
 4803: 
 4804:       if (ifltype == 1 || ifltype == 2) {
 4805:       
 4806:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4807: 
 4808:          const double unth0 = segment->qthcon*ramp/segment->carea;
 4809:          
 4810:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 4811:          
 4812:       } else if (ifltype == -1) { // Flather 1
 4813: 
 4814:          for (int k = 0; k < nvrt; k++) {
 4815: 
 4816:             // uth is the normal vel.; no ramp up
 4817:             const double uth = sideBnd->nuth(k);
 4818:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4819: 
 4820:             sideBnd->ubc[k] += uth*n;
 4821:          }
 4822: 
 4823:       } else if (ifltype == 3 || ifltype == 5) {
 4824:          // vnth0=0 !normal vel.
 4825: 
 4826:          Vector2 r_u1_bar = {0.0, 0.0};
 4827:          // Computes the contribution to the velocity from all tide frequencies
 4828:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4829: 
 4830:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 4831:             const Vector2 umo  = sideBnd->umo(jfr); 
 4832: 
 4833:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4834:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4835:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4836:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4837: 
 4838:          }
 4839: 
 4840: 
 4841:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 4842: 
 4843:       } // if (ifltype = 3 || ifltype == 5
 4844: 
 4845: 
 4846: 
 4847:    }
 4848: 
 4849:    __global__ void computeElevationBoundaryConditions(double time) {
 4850:       // Compute elevation essential boundary conditions 
 4851: 
 4852:       NODE_BND(nodeBnd); // Each boundary node.
 4853: 
 4854:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4855: 
 4856:       const Node *node = nodeBnd->node;
 4857:       const BoundarySegment *segment = nodeBnd->segment;
 4858:       const int iettype = segment->iettype;
 4859:       
 4860: 
 4861:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4862:       double eic = 0.0;
 4863:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4864:       else                 eic = 0.0;
 4865: 
 4866:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4867:       const double r_eth = ramp*nodeBnd->eth;
 4868:       double r_eta1_bar = 0.0;
 4869: 
 4870: 
 4871:       // Compute tide elevation
 4872:       if (iettype == 3 || iettype == 5) {   
 4873: 
 4874:          if constexpr(iloadtide==1) { // loading tide
 4875:             assert(false && "Loading tide not implemented");
 4876:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4877:          }
 4878:          
 4879:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4880: 
 4881:             const double efa  = nodeBnd->efa[jfr]; 
 4882:             const double emo  = nodeBnd->emo[jfr]; 
 4883: 
 4884:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4885:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4886:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4887: 
 4888:          } // for jfr
 4889: 
 4890:       } // if iettype
 4891: 
 4892:       switch (iettype) {
 4893:          case 1:
 4894:          case 2:
 4895:          case 4:
 4896:             nodeBnd->elbc = r_eic + r_eth;
 4897:             break;
 4898:          case 3:
 4899:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4900:             break;
 4901:          case 5:
 4902:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4903:             break;
 4904:       } // switch
 4905: 
 4906: 
 4907:       //Add inverse barometric effects
 4908:       if (iettype != 0 && inv_atm_bnd == 1) {
 4909:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4910:       }
 4911: 
 4912:    }
 4913: 
 4914: 
 4915:    __global__ void computeHorizontalViscosity(void) { 
 4916: 
 4917:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4918: 
 4919:       SIDE(side);
 4920: 
 4921:       if (side->isDry) return;
 4922: 
 4923:       for (int k = 0; k < nvrt; k++) {
 4924:          side->nuGradU[k] = {0.0, 0.0};
 4925:       }
 4926: 
 4927:       if constexpr(ihorcon == 1) {
 4928:          for (int k = side->kb; k < nvrt - 1; k++) {
 4929:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4930:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 4931:             // By Zhang and Baptista.
 4932: 
 4933:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4934:             // This is a standard discretization of the Laplacian operator.
 4935:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4936:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4937:             // Gamma is hvis_coef0 in the code.
 4938:             // The value of gamma needs to be < 0.5.
 4939: 
 4940:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4941:             // side under consideration in each of the two possible elements that share the side.
 4942:             Vector2 sumU = {0.0, 0.0};
 4943:             for (int l = 0; l < 2; l++) {
 4944:                const Element *elem = side->elems[l];
 4945: 
 4946:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4947: 
 4948:                // Find the local index of the side in the element
 4949:                const int idxSide = elem->sideLocalIdx(side);
 4950: 
 4951:                // Find the two sides that are connected to the side under consideration
 4952:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 4953:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 4954: 
 4955:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 4956: 
 4957:             }
 4958: 
 4959:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4960: 
 4961:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 4962:    
 4963:          }
 4964:       }
 4965:       else if constexpr(ihorcon == 2) {
 4966:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4967:       }
 4968: 
 4969: 
 4970:    }
 4971: 
 4972: 
 4973:    __global__ void setEssentialBC(void) {
 4974:       // Set essential boundary conditions 
 4975:       NODE(node); // Each boundary node
 4976:       NodeBoundary *nodeBnd = node->nodeBnd;
 4977:       
 4978:  
 4979:       // Check if this node has essential BC
 4980:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4981:          // Verify BC value is valid
 4982:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4983: 
 4984:        
 4985:          // Set diagonal to 1 and zero off-diagonals
 4986:          node->coeffDiag = 1.0;
 4987: 
 4988:          for (int j = 0; j < node->numNodes; j++) {
 4989:                node->coeffMatrix[j] = 0.0;
 4990:          }
 4991:          
 4992:          // Set solution and RHS to BC value
 4993:          node->mX  = nodeBnd->elbc;
 4994:          node->qel = nodeBnd->elbc;
 4995: 
 4996:       } else {
 4997:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4998: 
 4999:          for (int j = 0; j < node->numNodes; j++) {
 5000:                Node* nbNode = node->nodes[j];
 5001:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5002:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5003:                   // Verify neighbor's BC value
 5004:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5005: 
 5006:                   // Subtract contribution to RHS
 5007:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5008:                   node->coeffMatrix[j] = 0.0;  
 5009:                }
 5010:          }
 5011:       }
 5012:    }
 5013: 
