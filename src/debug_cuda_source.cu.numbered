 2105:    template<typename T>
 2106:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2107:       // Get the values of the field at the nodes of the element
 2108:       res[0] = nodes[0]->*field;
 2109:       res[1] = nodes[1]->*field;
 2110:       res[2] = nodes[2]->*field;
 2111:       if (isQuad()) res[3] = nodes[3]->*field;
 2112:       else          res[3] = T();
 2113:    }
 2114: 
 2115:    template<typename T>
 2116:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2117: 
 2118:       assert(level < nvrt && "Level is out of range");
 2119:       // Get the values of the field at the nodes of the element
 2120:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2121:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2122:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2123:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2124:       else          res[3] = T();
 2125:    }    
 2126: 
 2127:    template<typename T>
 2128:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2129: 
 2130:       assert(level < nvrt && "Level is out of range");
 2131: 
 2132:       // Get the values of the func at the nodes of the element
 2133:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2134:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2135:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2136:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2137:       else          res[3] = T();  // This is 0.0 or a zero vector
 2138: 
 2139:    }      
