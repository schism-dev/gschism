 4252:    __global__ void setWinds(double *windx, double *windy) {
 4253:       NODE(node);
 4254: 
 4255:       const int idx = node->idx;
 4256:       Vector2 wind = {windx[idx], windy[idx]};
 4257: 
 4258:       if constexpr(nws != 0 && iwindoff != 0) {
 4259:          assert(false && "setWinds: windfactor not implemented");
 4260:       }
 4261: 
 4262:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4263:       node->setWind(wind);
 4264: 
 4265:    }
