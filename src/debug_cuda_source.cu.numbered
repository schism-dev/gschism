 2365:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2366:    // Project the vectors from the side frame to the element frame
 2367: 
 2368:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2369:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2370:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2371:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2372:       else          v[3] = Vector2();
 2373:    }
