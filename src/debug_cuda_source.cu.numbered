 1858: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1859:    // Computes the 3D normal vector to the element at level k
 1860:    // Returns the normal vector and the area of the element
 1861: 
 1862:       if (isTri()) {
 1863:          // For triangles...
 1864: 
 1865:          // Gets the normal vector to the element (with a length equal to twice the area)
 1866:          if constexpr(ics==1) {
 1867:             const int kb0 = max(k, nodes[0]->kb);
 1868:             const int kb1 = max(k, nodes[1]->kb);
 1869:             const int kb2 = max(k, nodes[2]->kb);
 1870: 
 1871: FIX
 1872:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1873:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1874:             
 1875:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1876:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1877:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1878:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1879: 
 1880:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1881:             area3D = 0.5*len;
 1882: 
 1883:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1884: 
 1885:             return {nx/len, ny/len, nz/len};
 1886: 
 1887:            
 1888:          }
 1889:          else {  // lat/lon
 1890:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1891:             return {0.0, 0.0, 0.0};
 1892: 
 1893:          } // if ics
 1894:       }
 1895:       else {
 1896:          // For quads...
 1897: 
 1898:          assert(false && "Element normal vector: quads not yet implemented");
 1899:          return {0.0, 0.0, 0.0};
 1900: 
 1901: 
 1902:       }
 1903:    }
 1904: 
 1905: /**
 1906:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1907:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1908:    If the segment is completely inside the element, then it returns true.
 1909: 
 1910:    This function assumes:
 1911:    - The initial point is on a side of the element. 
 1912:    - Its position is given by parameter t in the range [0,1].
 1913:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1914:       intersects the element (elements are convex).
 1915: 
 1916:    To find the intersection point, this function does the following:
 1917:    - it finds the intersection of the line segment with all the element side lines,
 1918:       except for the one that contains the initial point.
 1919:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1920:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1921:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1922:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1923:       track segment is almost parallel to the element side line.
 1924: 
 1925:    Inputs:
 1926:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1927:    @param x2, y2: other end of the line segment
 1928: 
 1929:    Outputs:
 1930:    @param side:  side that intersects the line segment (input and output)
 1931:    @param nextElement (output): element that contains the intersection point
 1932:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1933:    @param zint (input/output): Vertical coordinate of the intersection point
 1934: 
 1935:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1936:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1937:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1938: 
 1939:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1940:    (Delta) being zero.
 1941: 
 1942:    The intersection2 point happens when:
 1943:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1944:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1945:    
 1946:    Assumption: the 4 points (including those of the side segment) are different.
 1947:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1948:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1949:    If true, (xIntersect,yIntersect) is the intersection.				
 1950:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1951: **/
 1952: 
 1953: 
 1954: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1955:                                               double &t, double& tIntersect) {
 1956:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 1957:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 1958: 
 1959:    double closest_intersect_t = 1e10;
 1960:    bool found_intersection = false;
 1961: 
 1962:    for (int i = 0; i < i34; i++) {
 1963: 
 1964:       Side *side2 = sides[i];
 1965: 
 1966:       // (x3,y3)-(x4,y4) is the element side line
 1967:       const Point2 x3 = side2->n1->p;
 1968:       const Point2 x4 = side2->n2->p;
 1969: 
 1970:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1971:       const double delta = cross(x2 - x1, x3 - x4);
 1972: 
 1973:       if (abs(delta) > 0) {
 1974: 
 1975:          const double delta1 = cross(x3 - x1, x3 - x4);
 1976:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1977: 
 1978:          // Solves the two linear equations for tt1 and tt2
 1979:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1980:          const double tt2 = delta2/delta;
 1981: 
 1982:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1983:             closest_intersect_t = min(closest_intersect_t, tt1);
 1984:             side = side2;
 1985:             nextElement = side->otherElem(this);
 1986:             t =          clamp(tt2, small, 1.0-small);
 1987:             tIntersect = clamp(tt1, small, 1.0-small);
 1988:             found_intersection = true;
 1989:          }
 1990: 
 1991:       
 1992:       }
 1993:       else {  // parallel segments
 1994: 
 1995:          continue; 
 1996:          assert(false && "Parallel segments should not happen under the new code");
 1997:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 1998:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1999: 
 2000:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2001:          const double dist = dot(x1 - x3, side2->n);
 2002:          if (abs(dist) < small*length(x3 - x4)) {
 2003:             const double2 unitarySide = normalize(x4 - x3);
 2004:             const double len = dot(x2 - x1, unitarySide);
 2005:             t = t + len;
 2006:             t = max(0.0, min(t, 1.0));
 2007:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2008: 
 2009: 
 2010:             // tIntersect = max(small, min(tt1, 1.0-small));
 2011:             // t = tt2;
 2012:             found_intersection = true;
 2013:          }
 2014:       }
 2015: 
 2016: 
 2017:    }
 2018: 
 2019: 
 2020:    assert(found_intersection && "No intersection found");
 2021: 
 2022:    // found_intersection should always be true, since we checked all the sides.  
 2023:    return found_intersection;
 2024: }
 2025: 
 2026: 
 2027: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2028:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2029: 
 2030:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2031:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2032:    // curElement.
 2033: 
 2034:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2035:    // And uses this velocity instead to continue the tracking.
 2036: 
 2037:    // computes the intersection point in cartesian coordinates
 2038:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2039: 
 2040:    // Nudges the point to the barycenter of the element. 
 2041:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2042:    // next segment intersects the element sides. 
 2043:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2044: 
 2045: 
 2046:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2047:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2048:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2049:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2050: 
 2051:    // If the side is an open boundary, the tangential velocity is set to zero.
 2052:    if (nextSide->isBnd()) vtan = 0.0;
 2053: 
 2054:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2055:    const double us = vtan*nextSide->t().x;
 2056:    const double vs = vtan*nextSide->t().y;
 2057:    const double ws = nextSide->w2(jlev); 
 2058: 
 2059:    u_int = {us, vs, ws};
 2060: 
 2061:    // The end of this tracking segment is now the intersection point.
 2062:    xt = {intersection.x, intersection.y, zint};
 2063:    
 2064: }
 2065: 
 2066: /**
 2067:  * Tracks a particle through elements and vertical levels in the mesh.
 2068:  * 
 2069:  * @param x0,y0,z0     Starting position coordinates
 2070:  * @param xt,yt,zt     Target position coordinates
 2071:  * @param dtb          Time step for tracking
 2072:  * @param u_int        Initial velocity components
 2073:  * @param nextElem     Starting/resulting element index
 2074:  * 
 2075:  * @return Status code of type trackExitCodes
 2076:  * 
 2077:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2078:  * of the details are different. The idea is that the code requires less branches and is better fit
 2079:  * for GPU execution.
 2080:  * 
 2081:  * The main ideas here are:
 2082:  * - The starting point is expected to be in the starting element.
 2083:  * - since the starting point is inside the element, there are only two cases: 
 2084:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2085:  *     (b) it does not and (xt,yt) is already in the starting element.
 2086:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2087:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2088:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2089:  * - tt1 can be positive or negative. We only consider the positive values.
 2090:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2091:  * - The next intersection will occur at the smallest positive tt1.
 2092:  * - This intersection will be the next (x0,y0) position.
 2093:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2094:  *   of getting stuck in a loop.
 2095:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2096:  *   was found.
 2097:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2098:  */
 2099: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2100:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2101:                                                        const Side *origSide) {
 2102:                                                             
 2103:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2104:    // else to do. This means that the full step occurred within the current element.
 2105:    assert(!isDry && "Starting element is dry");
 2106:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2107: 
 2108:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2109: 
 2110:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2111:       assert(!isDry && "Target point is inside a dry element");
 2112: 
 2113:       u_int = interpolateVelocities(xt);
 2114: 
 2115:       nextElem = this;
 2116: 
 2117: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2118:       return true;
 2119:    }
 2120: 
 2121: 
 2122:    
 2123: 
 2124:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2125:    
 2126:    double t;
 2127:    Side *nextSide = nullptr;
 2128:    double tIntersect = 1e10;
 2129: 
 2130: 
 2131:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2132:    // (x0,y0) is inside the element but the target point is not.
 2133:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2134:    assert(found_intersection && "No intersection found at %d");
 2135: 
 2136:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2137: 
 2138:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2139:    if (nextElem != nullptr && !nextElem->isDry) {
 2140:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2141:       nextElem->nudgeToBarycenter(xtmp);
 2142:    }
 2143: 
 2144:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2145:    xt = {xtmp.x, xtmp.y, zint};
 2146: 
 2147:    // if the tracking segment goes out of water (either dry or edge boundary)
 2148:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2149: 
 2150: 
 2151:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2152: 
 2153:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2154:       // When this happens, the backtracking stops.
 2155:       // dt = time_rm;  LLLLLL KKKK XXXX
 2156:       dt *= tIntersect;
 2157: 
 2158:       // In this case, the next element is again the current element.
 2159:       nextElem = this;
 2160: 
 2161: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2162: 
 2163:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2164:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2165:       return true;    
 2166:    }
 2167: 
 2168: 
 2169:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2170:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2171:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2172: 
 2173:    
 2174:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2175: 
 2176:    nextElem->interpolateVelocities(xt, u_int); 
 2177: 
 2178:    assert(nextElem != this && "Next element is the same as the current element");
 2179: 
 2180:    return true;
 2181: }
 2182: 
 2183: 
 2184: __inline__ __device__ double Element::computeSignedArea(void) const {
 2185:    // Compute the area of the element
 2186: 
 2187:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2188: 
 2189:    // In the quad case we need to add the area of the other triangle.
 2190:    if (isQuad()) {
 2191:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2192:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2193:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2194:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2195: 
 2196:       res += ar1;
 2197:    }
 2198: 
 2199:    return res;
 2200: }
 2201: 
 2202: 
 2203: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2204:                                                                 (nodes[1]->isDry2()) ||
 2205:                                                                 (nodes[2]->isDry2()) ||
 2206:                                                                 (i34==4 && nodes[3]->isDry2());
 2207: }
 2208: 
 2209: __inline__ __device__ double Element::detJ_eta(void) const {
 2210:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2211:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2212: }
 2213: 
 2214: __inline__ __device__ double Element::detJ_xi(void) const {
 2215:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2216:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2217: }
 2218: 
 2219: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2220:    // In boundary sides, the element 1 is nullptr
 2221:    return side->elems[1] == nullptr; 
 2222: }
 2223: 
 2224: 
 2225: 
 2226: /**
 2227:    Compute the shape coordinates of the point (xt,yt) in the element.
 2228:    @param xt (input): x-coordinate of the point
 2229:    @param shpCoords (output): shape coordinates of the point
 2230:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2231:    @return true if the point is inside the element, false otherwise
 2232: **/
 2233: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord) const {
 2234: 
 2235:    // Compute the shape coordinates of the point xt in the element.
 2236:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2237:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2238:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2239:    // from the local frame, so use additional check.
 2240: 
 2241:    if (i34==3) {
 2242: 
 2243: 
 2244:       Point2 x0, x1, x2;
 2245: 
 2246:       // Horinzontal local node coordinates. If ics == 2, the node coordinates are transformed to local frame.
 2247:       const Point2 x0 = toPoint2(nodes[0]->localP3D());
 2248:       const Point2 x1 = toPoint2(nodes[1]->localP3D());
 2249:       const Point2 x2 = toPoint2(nodes[2]->localP3D());
 2250: 
 2251:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2252:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2253:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2254:       shpCoords[3] = 0.0;
 2255: 
 2256:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2257:       const bool res = (tmpmin >= -small);  
 2258:       
 2259:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2260:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2261: 
 2262:       
 2263:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2264:       // then we fix the negative shape coordinates.
 2265:       if ((tmpmin < 0) && fix) {
 2266: 
 2267:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2268:          // keeping the sum of the shape coordinates equal to 1.
 2269:          // I have tested and compared the new algorithm with the old one, and they give
 2270:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2271:          // The new algorithm should be faster since it is branchless.
 2272:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2273:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2274:          
 2275:          shpCoords[0] = (shpCoords[0] + a)*b;
 2276:          shpCoords[1] = (shpCoords[1] + a)*b;
 2277:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2278: 
 2279:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2280:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2281:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2282: 
 2283:          // Update the point coordinates for the new shape coordinates
 2284:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2285:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2286:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2287: 
 2288:       }
 2289: 
 2290:       // Check if the point is inside the element
 2291:       return res;      
 2292:    }
 2293:    else {
 2294:       Error("Not implemented yet");
 2295: #ifdef QUADS
 2296:       // Reproject pt in eframe of nel for ics=2
 2297:       if constexpr(ics==1) {
 2298:          xn2 = xt; 
 2299:          yn2 = yt;
 2300:       }
 2301:       else {
 2302:          // Transform the point coordinates to the local frame
 2303:          frame.G2L(xt, xn2);
 2304:          frame.G2L(yt, yn2);
 2305:       }
 2306: 
 2307:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2308: #endif
 2309:    }
 2310: 
 2311:    assert(false && "computeShapeCoords: should never reach this point");
 2312:    return false;  // Never reached
 2313: 
 2314: }
 2315: 
 2316: 
 2317: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2318: // Convert shape coordinates to cartesian coordinates
 2319: 
 2320:    if (i34 == 3) {
 2321:       // Triangular element
 2322:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2323:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2324:    }
 2325:    else {
 2326:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2327:    }
 2328: 
 2329: }
 2330: 
 2331: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2332:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2333:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2334:    // The formula for the integral is:
 2335:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2336: 
 2337:    printf("intPhiPhi: TEST\n");
 2338: 
 2339:    const Node *n0 = nodes[0];
 2340:    const Node *n1 = nodes[1];
 2341:    const Node *n2 = nodes[2];
 2342:    const Node *n3 = nodes[3];
 2343: 
 2344:    const Vector2 p0 = n0->p;
 2345:    const Vector2 p1 = n1->p;
 2346:    const Vector2 p2 = n2->p;
 2347:    const Vector2 p3 = n3->p;
 2348: 
 2349:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2350:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2351:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2352:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2353: 
 2354:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2355: }
 2356:    
 2357: 
 2358: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2359:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2360:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2361:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2362:    // The formula is also based on the identity:
 2363:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2364:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2365: 
 2366:    printf("intGradPhiGradPhi: TEST\n");   
 2367: 
 2368:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2369: 
 2370:    const double x0 = nodes[0]->p.x;
 2371:    const double y0 = nodes[0]->p.y;
 2372:    const double x1 = nodes[1]->p.x;
 2373:    const double y1 = nodes[1]->p.y;
 2374:    const double x2 = nodes[2]->p.x;
 2375:    const double y2 = nodes[2]->p.y;
 2376:    const double x3 = nodes[3]->p.x;
 2377:    const double y3 = nodes[3]->p.y;
 2378: 
 2379:    double res = 0.0;
 2380:    
 2381:    // Quadrature points in xi and eta coordinates
 2382:    #pragma unroll
 2383:    for (int i = 0; i < 4; i++) {
 2384:       // For each quadrature point...
 2385: 
 2386:       const Point2 p = GaussPoint(i);
 2387:       const double eta = p.x;
 2388:       const double xi  = p.y;
 2389: 
 2390:       // Jacobian entries at the Gauss point p
 2391:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2392:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2393:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2394:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2395: 
 2396:       const double detJ = jacobianDet(p);
 2397:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2398: 
 2399:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2400:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2401:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2402:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2403:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2404: 
 2405:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2406:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2407:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2408:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2409:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2410: 
 2411:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2412:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2413:    }
 2414: 
 2415:    return res;
 2416: }
 2417: 
 2418: 
 2419: /**  Interpolate velocities at a given point (xt,yt,zt)
 2420: 
 2421:    @param xt, yt, zt: coordinates of the point to interpolate
 2422:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2423: 
 2424:    This is done in four steps:
 2425: 
 2426:    1. Find the shape coordinates for the final position in the element.
 2427:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2428:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2429:       z levels at xt, yt at each step.   
 2430:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2431:       horizontally and vertically.
 2432: **/
 2433: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2434:    // Interpolate the velocities at the point xt. 
 2435:    // This function works the same for triangular and quadrilateral elements.
 2436:    double shpCoord[4];
 2437: 
 2438:    // First step is to compute the shape coordinates of (xt,yt)
 2439:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside);
 2440: 
 2441:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2442: 
 2443:    // Second step is to find the level that contains zt
 2444:    // Uses a binary search to find the level
 2445:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2446:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2447:    int R = nvrt - 1;
 2448: 
 2449:    // Get the z coordinates at the nodes of the element at the levels L and R
 2450:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2451:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2452:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2453: 
 2454:    double zL = interpolate(shpCoord, zLAtNodes);
 2455:    double zR = interpolate(shpCoord, zRAtNodes);
 2456:    
 2457:    // Interpolates vertically the velocities
 2458:    double wght1, wght2;
 2459:    if (xt.z<=zL) {
 2460:       wght1 = 1.0;
 2461:       wght2 = 0.0;
 2462:       xt.z = zL;
 2463:    }
 2464:    else if (xt.z>=zR) {
 2465:       wght1 = 0.0;
 2466:       wght2 = 1.0;
 2467:       xt.z = zR;
 2468:    }
 2469:    else {
 2470:       // Perform a binary search to find the levels between L and R that contain xt.z
 2471:       while (R - L > 1) {
 2472:          int M = (L + R) / 2.0;
 2473: 
 2474:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2475:          double zM = interpolate(shpCoord, zMAtNodes);
 2476:          if (zM < xt.z) 
 2477:          {
 2478:             L = M;
 2479:             zL = zM;
 2480:          }
 2481:          else 
 2482:          {
 2483:             R = M;
 2484:             zR = zM;
 2485:          }
 2486:       }
 2487:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2488:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2489: 
 2490:       wght2 = (xt.z - zL)/(zR - zL);
 2491:       wght1 = 1.0 - wght2;
 2492: 
 2493:    }
 2494: 
 2495: 
 2496:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2497:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2498: 
 2499:    // Neither of the interpolated velocities should be NaN
 2500:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2501: 
 2502: }
 2503: 
 2504: 
 2505: 
 2506: 
 2507: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2508: 
 2509:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2510:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2511:    const Node *n1 = side->n1;
 2512:    const Node *n2 = side->n2;
 2513: 
 2514:    bool n1_match = (n1->nodeBnd->segment == segment);
 2515:    bool n2_match = (n2->nodeBnd->segment == segment);
 2516: 
 2517:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2518:    if (n1_match && n2_match) {
 2519:       return 0.5;
 2520:    } else if (n1_match) {
 2521:       return 1.0;
 2522:    } else if (n2_match) {
 2523:       return 0.0;
 2524:    }
 2525: 
 2526:    return 0.0;
 2527: }
 2528: 
 2529: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2530: 
 2531: 
 2532: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2533: 
 2534:    const double w1 = getBoundaryArrayValueWeight();
 2535:    const double w2 = 1.0 - w1;
 2536:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2537:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2538: 
 2539:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2540: }
 2541: 
 2542: 
 2543: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2544:    const double w1 = getBoundaryArrayValueWeight();
 2545:    const double w2 = 1.0 - w1;
 2546:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2547:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2548: 
 2549:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2550: 
 2551: }
 2552: 
 2553: 
 2554: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2555:    // Returns the value of the velocity at the side center
 2556:    const double w1 = getBoundaryArrayValueWeight();
 2557:    const double w2 = 1.0 - w1;
 2558:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2559:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2560: 
 2561:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2562: }
 2563: 
 2564: 
 2565: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2566:    // Returns the value of the normal component of the velocity at the side center
 2567:    const double w1 = getBoundaryArrayValueWeight();
 2568:    const double w2 = 1.0 - w1;
 2569:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2570:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2571: 
 2572:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2573: }
