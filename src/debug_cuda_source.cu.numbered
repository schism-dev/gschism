 1210: struct Node {
 1211: 
 1212:    // Geometry information
 1213:    int idx;        // Index of the node
 1214:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1215:    int numNodes;   // Number of nodes neighbors of this node
 1216: 
 1217:    Element **elements; // Array of pointers to the elements that share this node
 1218:    int numElements;    // Number of elements that share this node
 1219: 
 1220:    int numSides;       // Number of sides that are connected to this node
 1221: 
 1222:    Point2 p;
 1223:    Vector2 u2[nvrt];
 1224:    double  w2[nvrt];
 1225:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1226:    double z[nvrt];
 1227:    double lon, lat;
 1228:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1229:    double depth;
 1230: 
 1231:    int kb;       // Bottom index of the node
 1232: 
 1233:    bool isDry;     // True if the node is dry
 1234: 
 1235:    int iadv;     // Advection flag
 1236: 
 1237:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1238:                           // this is nullptr
 1239: 
 1240:    TempVar tmp; // Temporary variable to store different types of variables
 1241: 
 1242:    // Physical information
 1243:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1244:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1245: 
 1246:    double rho[nvrt];     // Density
 1247:    double dfv[nvrt];     // Vertical viscosity
 1248: 
 1249:    double eta1; // Elevation at nodes at previous timestep
 1250:    double eta2; // Elevation at nodes at current timestep
 1251: 
 1252:    double ETP;  // Earth Tidal Potential
 1253: 
 1254:    double pr;    // Air pressure
 1255:    double grav2; // Gravity 
 1256:    
 1257:    Vector2 dav;  // Depth averaged velocity
 1258: 
 1259:    Vector2 tau; // Wind stress vector
 1260: 
 1261:    // Vegetation parameters
 1262:    double veg_h;
 1263:    double veg_nv;
 1264:    double veg_di;
 1265:    double veg_Cd;
 1266:    double veg_h_unbent;
 1267:    double veg_di_unbent;
 1268:    double veg_nv_unbent;
 1269:    double veg_alpha_vert_mean;
 1270:    double veg_alpha0;
 1271:    double veg_alpha3D[nvrt];
 1272: 
 1273:    // Bottom drag parameters
 1274:    double Cd;       // Bottom drag coefficient   
 1275: 
 1276:    // These three are mutually exclusive
 1277:    union {
 1278:       double rmanning; // Bottom Manning's coefficient
 1279:       double rough;    // Bottom roughness length
 1280:       double drag;     // Bottom drag coefficient
 1281:    };
 1282:    Vector2 tau_bot; // Bottom stress vector
 1283: 
 1284:    double bdef1; // Bottom deformation at previous timestep
 1285:    double bdef2; // Bottom deformation at current timestep
 1286: 
 1287:    double qel; // RHS
 1288:    double coeffDiag; // Diagonal coefficient of the matrix
 1289:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1290: 
 1291:    double mP; // Search direction for conjugate gradient method
 1292:    double mR; // Residual for conjugate gradient method
 1293:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1294:    double mX; // Solution for conjugate gradient method
 1295: 
 1296:    // Meteorological forcing
 1297:    Vector2 u_air;
 1298:    double p_air;  // XXXX is this the same as pr?
 1299:    double t_air;
 1300:    double q_air;
 1301:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1302: 
 1303:    __device__ void setWind(Vector2 &u) {
 1304:    // Sets the wind vector taking into account the mesh angle
 1305:    
 1306:       const double speed = length(u);
 1307: 
 1308:       // Rotate wind vector to the node frame
 1309:       const Vector2 u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1310: 
 1311:       // Sets the surface stress vector due to wind.
 1312:       if constexpr(nws == 0) {
 1313:          tau = {0.0, 0.0};
 1314: 
 1315:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1316:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1317: 
 1318:       } else {
 1319: 
 1320:          double dragcoef;
 1321: 
 1322:          if constexpr(iwind_form == -1) {
 1323:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1324:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1325: 
 1326:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1327:             tau = cff*u_air;
 1328:  
 1329:          } else if constexpr(iwind_form == 1) {
 1330:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1331:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1332: 
 1333:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1334:             tau = cff*u_air;
 1335: 
 1336:          } else {
 1337:             tau = {0.0, 0.0};
 1338:          }
 1339:       }
 1340:    }
 1341: 
 1342: 
 1343:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1344: 
 1345:    __device__ double sigmaTransitionDepth(void) const;
 1346: 
 1347:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1348:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1349:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1350:    
 1351:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1352: 
 1353:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1354: 
 1355:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1356:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1357: 
 1358:    __device__ __forceinline__ void clearMatrixRow(void) {
 1359:       // Clear the matrix row for this node
 1360: 
 1361: 
 1362:       coeffDiag = 0.0;
 1363: 
 1364:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1365: 
 1366:    }
 1367: 
 1368:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1369:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1370:       
 1371:       if (node == this) {
 1372:          coeffDiag += value;
 1373:      
 1374:       } else {
 1375:          // Search (linearly)the index of the node in the array of nodes
 1376:          // XXX: This is not efficient, see if we can improve this
 1377:          int i;
 1378:          for (i = 0; i < numNodes; i++) {
 1379:             if (nodes[i] == node) {
 1380:                break;
 1381:             }
 1382:          }
 1383:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1384:          coeffMatrix[i] += value;
 1385:       }
 1386:    }
 1387: 
 1388: 
 1389:    __device__ __inline__ void updateZCoordData(void);
 1390: 
 1391:    __device__ double compZCoord(int k) const;
 1392: 
 1393:    __device__ void updateKb(void);
 1394: 
 1395:    __device__ __forceinline__ void computeBottomDragCd(void);
 1396: 
 1397: 
 1398: 
 1399: };
