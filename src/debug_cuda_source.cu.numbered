  276: 
  277: __device__ __forceinline__ double dot(const double3& v, const double3& w) {
  278:     return v.x*w.x + v.y*w.y + v.z*w.z;
  279: }
  280: 
  281: __device__ __forceinline__ double norm2(const double3& v) {
  282:     return v.x*v.x + v.y*v.y + v.z*v.z;
