  586:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  587:    
  588:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  589: 
  590:    __device__ Vector2 grad2(double *a) const
  591:    {
  592:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  593:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  594:       if (isQuad()) {
  595:          gx += a[3]*gradPhi[3].x;
  596:          gy += a[3]*gradPhi[3].y;
  597:       }
  598:       return {gx, gy};
  599:    }
  600: 
  601:    __device__ Vector2 grad2(double Node::* field) const
  602:    {
  603:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  604:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  605:       if (isQuad()) {
  606:          gx += (nodes[3]->*field)*gradPhi[3].x;
  607:          gy += (nodes[3]->*field)*gradPhi[3].y;
  608:       }
  609:       return {gx, gy};
  610:    }
  611: 
  612:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  613:    __device__ __forceinline__ Vector3 n(int k) const {
  614:       double area3D;
  615:       return n(k, area3D);
  616:     }
