 1905:                    if (idx_node >= mesh->np) return;
 1906: 
 1907: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1908:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1909:                               const bool valid = (idx_node < mesh->np);                   
 1910: 
 1911: 
 1912: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1913:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1914:                            if (idx_node_bnd >= mesh->nbp) return;
 1915: 
 1916: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1917:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1918:                            if (idx_side_bnd >= mesh->nbs) return;                           
