 7694: __global__ void getStructSizes(int* sizes)  {
 7695:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7696:       sizes[0] = (int)sizeof(Node);
 7697:       sizes[1] = (int)sizeof(Element);
 7698:       sizes[2] = (int)sizeof(Side);
 7699:       sizes[3] = (int)sizeof(NodeBoundary);
 7700:       sizes[4] = (int)sizeof(SideBoundary);
 7701:       sizes[5] = (int)sizeof(BoundarySegment);
 7702: }
