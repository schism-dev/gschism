 1743: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1744:    // Computes the 3D normal vector to the element at level k
 1745:    // Returns the normal vector and the area of the element
 1746: 
 1747:       if (isTri()) {
 1748:          // For triangles...
 1749: 
 1750:          // Gets the normal vector to the element (with a length equal to twice the area)
 1751:          if constexpr(ics==1) {
 1752:             const int kb0 = max(k, nodes[0]->kb);
 1753:             const int kb1 = max(k, nodes[1]->kb);
 1754:             const int kb2 = max(k, nodes[2]->kb);
 1755: 
 1756:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1757:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1758:             
 1759:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1760:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1761:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1762:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1763: 
 1764:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1765:             area3D = 0.5*len;
 1766: 
 1767:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1768: 
 1769:             return {nx/len, ny/len, nz/len};
 1770: 
 1771:            
 1772:          }
 1773:          else {  // lat/lon
 1774:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1775: 
 1776:          } // if ics
 1777:       }
 1778:       else {
 1779:          // For quads...
 1780: 
 1781:          assert(false && "Element normal vector: quads not yet implemented");
 1782: 
 1783: 
 1784:       }
 1785:    }
 1786: 
 1787: /**
 1788:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1789:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1790:    If the segment is completely inside the element, then it returns true.
 1791: 
 1792:    This function assumes:
 1793:    - The initial point is on a side of the element. 
 1794:    - Its position is given by parameter t in the range [0,1].
 1795:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1796:       intersects the element (elements are convex).
 1797: 
 1798:    To find the intersection point, this function does the following:
 1799:    - it finds the intersection of the line segment with all the element side lines,
 1800:       except for the one that contains the initial point.
 1801:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1802:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1803:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1804:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1805:       track segment is almost parallel to the element side line.
 1806: 
 1807:    Inputs:
 1808:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1809:    @param x2, y2: other end of the line segment
 1810: 
 1811:    Outputs:
 1812:    @param side:  side that intersects the line segment (input and output)
 1813:    @param nextElement (output): element that contains the intersection point
 1814:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1815:    @param zint (input/output): Vertical coordinate of the intersection point
 1816: 
 1817:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1818:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1819:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1820: 
 1821:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1822:    (Delta) being zero.
 1823: 
 1824:    The intersection2 point happens when:
 1825:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1826:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1827:    
 1828:    Assumption: the 4 points (including those of the side segment) are different.
 1829:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1830:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1831:    If true, (xIntersect,yIntersect) is the intersection.				
 1832:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1833: **/
 1834: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1835:                                               double &t, double& tIntersect) {
 1836: 
 1837:    double closest_intersect_t = 1e10;
 1838:    bool found_intersection = false;
 1839: 
 1840:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1841:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1842:    const Point2 x1 = side->point(t);
 1843:    
 1844: 
 1845:    Side *nextSide = nullptr;
 1846:    for (int i = 0; i < i34; i++) {
 1847: 
 1848:       // Element's i-th side 
 1849:       Side *side2 = sides[i];
 1850: 
 1851:       // Skip the side that contains the initial point
 1852:       if (side2 == side) continue;
 1853: 
 1854:       // (x3,y3)-(x4,y4) is the element side line
 1855:       const Point2 x3 = side2->n1->p;
 1856:       const Point2 x4 = side2->n2->p;
 1857: 
 1858:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1859:       const double delta = cross(x2 - x1, x3 - x4);
 1860: 
 1861:       if (delta != 0.0) {
 1862: 
 1863:          const double delta1 = cross(x3 - x1, x3 - x4);
 1864:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1865: 
 1866:          // Solves the two linear equations for tt1 and tt2
 1867:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1868:          const double tt2 = delta2/delta;
 1869: 
 1870:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1871:             closest_intersect_t = min(closest_intersect_t, tt1);
 1872:             nextSide = side2;
 1873: 
 1874:             nextElement = nextSide->otherElem(this);
 1875:             tIntersect = max(small, min(tt1, 1.0-small));
 1876:             t = tt2;
 1877: 
 1878:             found_intersection = true;
 1879:          }
 1880:       
 1881:       }
 1882: 
 1883:    }
 1884: 
 1885:    // found_intersection should always be true, since we checked all the sides.  
 1886:    side = nextSide;
 1887: 
 1888:    return found_intersection;
 1889: }
 1890: 
 1891: 
 1892: 
 1893: 
 1894: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1895:                                               double &t, double& tIntersect) {
 1896: 
 1897:    double closest_intersect_t = 1e10;
 1898:    bool found_intersection = false;
 1899: 
 1900:    for (int i = 0; i < i34; i++) {
 1901: 
 1902:       Side *side2 = sides[i];
 1903: 
 1904:       // (x3,y3)-(x4,y4) is the element side line
 1905:       const Point2 x3 = side2->n1->p;
 1906:       const Point2 x4 = side2->n2->p;
 1907: 
 1908:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1909:       const double delta = cross(x2 - x1, x3 - x4);
 1910: 
 1911:       if (abs(delta) > 0) {
 1912: 
 1913:          const double delta1 = cross(x3 - x1, x3 - x4);
 1914:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1915: 
 1916:          // Solves the two linear equations for tt1 and tt2
 1917:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1918:          const double tt2 = delta2/delta;
 1919: 
 1920:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1921:             closest_intersect_t = min(closest_intersect_t, tt1);
 1922:             side = side2;
 1923:             nextElement = side->otherElem(this);
 1924:             t = tt2;
 1925:             tIntersect = max(small, min(tt1, 1.0-small));
 1926:             found_intersection = true;
 1927:          }
 1928:       
 1929:       }
 1930:       else {  // parallel segments
 1931:          assert(false && "Parallel segments");
 1932:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1933:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1934: 
 1935:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1936: 
 1937:          // const double dist = dot(x1 - x3, side2->n);
 1938:          // if (abs(dist) < small*length(x3 - x4)) {
 1939:          //    const double2 unitarySide = normalize(x4 - x3);
 1940:          //    const double len = dot(x2 - x1, unitarySide);
 1941:          //    t = t + len;
 1942:          //    t = max(0.0, min(t, 1.0));
 1943:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1944: 
 1945: 
 1946:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1947:          //    // t = tt2;
 1948:          //    found_intersection = true;
 1949:          // }
 1950:       }
 1951: 
 1952: 
 1953:    }
 1954: 
 1955:       
 1956:    assert(found_intersection && "No intersection found");
 1957: 
 1958:    // found_intersection should always be true, since we checked all the sides.  
 1959:    return found_intersection;
 1960: }
 1961: 
 1962: 
 1963: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1964:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1965: 
 1966:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1967: 
 1968:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1969:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1970:    // curElement.
 1971: 
 1972:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1973:    // And uses this velocity instead to continue the tracking.
 1974: 
 1975:    // computes the intersection point in cartesian coordinates
 1976:    Point2 intersection = nextSide->p_t(tt);
 1977: 
 1978:    // Nudges the point to the barycenter of the element. 
 1979:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1980:    // next segment intersects the element sides.  
 1981:    curElem->nudgeToBarycenter(intersection);
 1982: 
 1983:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1984:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1985:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1986:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1987: 
 1988:    // If the side is an open boundary, the tangential velocity is zero.
 1989:    if (nextSide->isBnd()) vtan = 0.0;
 1990: 
 1991:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1992:    const double us = vtan*nextSide->t().x;
 1993:    const double vs = vtan*nextSide->t().y;
 1994:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 1995: 
 1996:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1997:    const double len2 = norm2(intersection - toPoint2(xt));
 1998:    const double vel2 = dot(u_int, u_int);        
 1999:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2000:    else            dt = 0.0;
 2001: 
 2002:    // The end of this tracking segment is now the intersection point.
 2003:    xt = {intersection.x, intersection.y, zint};
 2004: 
 2005:    u_int = {us, vs, ws};
 2006:    
 2007: }
 2008: 
 2009: /**
 2010:  * Tracks a particle through elements and vertical levels in the mesh.
 2011:  * 
 2012:  * @param x0,y0,z0     Starting position coordinates
 2013:  * @param xt,yt,zt     Target position coordinates
 2014:  * @param dtb          Time step for tracking
 2015:  * @param uuint,vvint,wwint Initial velocity components
 2016:  * @param nextElem     Starting/resulting element index
 2017:  * 
 2018:  * @return Status code of type trackExitCodes
 2019:  * 
 2020:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2021:  * of the details are different. The idea is that the code requires less branches and is better fit
 2022:  * for GPU execution.
 2023:  * 
 2024:  * The main ideas here are:
 2025:  * - The starting point is expected to be in the starting element.
 2026:  * - The end point is guaranteed to be inside an element.
 2027:  * - since the starting point is inside the element, there are only two cases: 
 2028:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2029:  *     (b) it does not and (xt,yt) is already in the starting element.
 2030:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2031:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2032:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2033:  * - tt1 can be positive or negative. We only consider the positive values.
 2034:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2035:  * - The next intersection will occur at the smallest positive tt1.
 2036:  * - This intersection will be the next (x0,y0) position.
 2037:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2038:  *   of getting stuck in a loop.
 2039:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2040:  *   was found.
 2041:  */
 2042: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2043:                                                        Element *&nextElem, int &jlev, double &dt,
 2044:                                                        const Side *origSide) {
 2045: 
 2046: 
 2047: 
 2048:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2049:    // else to do.
 2050:    // If it is, nudges the point to be inside the element.
 2051:    const Element *curElem = nextElem;
 2052:    if (containsPoint(toPoint2(xt), true)) {
 2053: 
 2054:       curElem->interpolateVelocities(xt, u_int);
 2055: 
 2056: addDebugPlot(x0, xt);
 2057:       return true;
 2058:    }
 2059: 
 2060:    Side *side = nullptr;
 2061: 
 2062:    // 1. Initial checks
 2063:    // Verify starting element is valid (wet)
 2064:    assert(!curElem->isDry && "Starting element is dry");
 2065: 
 2066:    // Checks if track has a zero length.
 2067:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2068:    // assert(len2 > 0.0 && "Zero length track"); 
 2069:    
 2070:    const int MAX_ITERATIONS = 1000;
 2071:    
 2072:    double t;
 2073:    Side *nextSide = nullptr;
 2074:    double tIntersect = 1e10;
 2075:    double zint = x0.z;
 2076: 
 2077:    // Horizontal tracking loop
 2078:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2079:    // (x0,y0) is inside the element but the target point is not.
 2080: 
 2081:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2082: 
 2083:    assert(found_intersection && "No intersection found at %d");
 2084: 
 2085:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2086: 
 2087:    // if the tracking segment goes out of water (either dry or edge boundary)
 2088:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2089: 
 2090: addDebugPlot(x0, xt, 0x00A0FF);
 2091:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2092: addDebugPlot(x0, xt, 0x00A0FF);      
 2093: 
 2094:       nextElem = this;
 2095:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2096:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2097:       return true;    
 2098:    }
 2099: 
 2100: 
 2101:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2102:    int iterations = 0;
 2103:    while (iterations < MAX_ITERATIONS) {
 2104:       iterations++;
 2105:       
 2106:       Element *curElem = nextElem;
 2107: 
 2108:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2109: addDebugPlot(x0, xt);
 2110:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2111: 
 2112:       // If we are already in the target element, we are done.
 2113:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2114:       if (!found_intersection) break;
 2115: 
 2116: 
 2117: 
 2118:       // if the tracking segment goes out of water (either dry or edge boundary).
 2119:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2120: addDebugPlot(x0, xt, 0x00A0FF);
 2121:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2122: addDebugPlot(x0, xt, 0x00A0FF);   
 2123:          nextElem = curElem;
 2124: 
 2125:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2126:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2127:          return true;
 2128:       }
 2129:       
 2130:       // Update position and element for next iteration
 2131:       side = nextSide;
 2132: 
 2133:    }
 2134: 
 2135:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2136: 
 2137:  
 2138:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2139:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2140: addDebugPlot(x0, xt);   
 2141:    nextElem->interpolateVelocities(xt, u_int); 
 2142: 
 2143:    return true;
 2144: }
 2145: 
 2146: 
 2147: __inline__ __device__ double Element::computeSignedArea(void) const {
 2148:    // Compute the area of the element
 2149: 
 2150:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2151: 
 2152:    // In the quad case we need to add the area of the other triangle.
 2153:    if (isQuad()) {
 2154:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2155:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2156:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2157:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2158: 
 2159:       res += ar1;
 2160:    }
 2161: 
 2162:    return res;
 2163: }
 2164: 
 2165: 
 2166: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2167:                                                                 (nodes[1]->isDry2()) ||
 2168:                                                                 (nodes[2]->isDry2()) ||
 2169:                                                                 (i34==4 && nodes[3]->isDry2());
 2170: }
 2171: 
 2172: __inline__ __device__ double Element::detJ_eta(void) const {
 2173:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2174:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2175: }
 2176: 
 2177: __inline__ __device__ double Element::detJ_xi(void) const {
 2178:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2179:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2180: }
 2181: 
 2182: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2183:    // In boundary sides, the element 1 is nullptr
 2184:    return side->elems[1] == nullptr; 
 2185: }
 2186: 
 2187: 
 2188: 
 2189: /**
 2190:    Compute the shape coordinates of the point (xt,yt) in the element.
 2191:    @param xt (input): x-coordinate of the point
 2192:    @param shpCoords (output): shape coordinates of the point
 2193:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2194:    @return true if the point is inside the element, false otherwise
 2195: **/
 2196: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2197:                                             bool fixNegshpCoord) const {
 2198: 
 2199:    // Compute the shape coordinates of the point xt in the element.
 2200:    if (i34==3) {
 2201:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2202:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2203:       // and in this case, the pt will be nudged into the element
 2204:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2205:       // from the local frame, so use additional check.
 2206: 
 2207:       Point2 x0, x1, x2;
 2208: 
 2209:       if constexpr(ics==1) {
 2210:          x0 = nodes[0]->p;
 2211:          x1 = nodes[1]->p;
 2212:          x2 = nodes[2]->p;
 2213:       }
 2214:       else // lat/lon
 2215:       {
 2216:          Error("Not implemented yet");
 2217: #ifdef ICS2
 2218:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2219:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2220:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2221: #endif
 2222:       }
 2223: 
 2224:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2225:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2226:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2227:       shpCoords[3] = 0.0;
 2228:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2229: 
 2230:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2231:       // then we fix the negative shape coordinates.
 2232:       if (fixNegshpCoord && tmpmin<=0.0) {
 2233: 
 2234:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2235:          // keeping the sum of the shape coordinates equal to 1.
 2236:          // I have tested and compared the new algorithm with the old one, and they give
 2237:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2238:          // The new algorithm should be faster since it is branchless.
 2239:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2240:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2241:          
 2242:          shpCoords[0] = (shpCoords[0] + a)*b;
 2243:          shpCoords[1] = (shpCoords[1] + a)*b;
 2244:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2245: 
 2246:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2247:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2248:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2249:          }
 2250: 
 2251:          // Update the point coordinates for the new shape coordinates
 2252:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2253:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2254:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2255: 
 2256:       }
 2257: 
 2258:       // Check if the point is inside the element
 2259:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2260:    }
 2261:    else {
 2262:       Error("Not implemented yet");
 2263: #ifdef QUADS
 2264:       // Reproject pt in eframe of nel for ics=2
 2265:       if constexpr(ics==1) {
 2266:          xn2 = xt; 
 2267:          yn2 = yt;
 2268:       }
 2269:       else {
 2270:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2271:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2272:       }
 2273: 
 2274:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2275: #endif
 2276:    }
 2277: 
 2278:    return false;  // Never reached
 2279: 
 2280: }
 2281: 
 2282: 
 2283: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2284: // Convert shape coordinates to cartesian coordinates
 2285: 
 2286:    if (i34 == 3) {
 2287:       // Triangular element
 2288:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2289:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2290:    }
 2291:    else {
 2292:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2293:    }
 2294: 
 2295: }
 2296: 
 2297: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2298:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2299:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2300:    // The formula for the integral is:
 2301:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2302: 
 2303:    printf("intPhiPhi: TEST\n");
 2304: 
 2305:    const Node *n0 = nodes[0];
 2306:    const Node *n1 = nodes[1];
 2307:    const Node *n2 = nodes[2];
 2308:    const Node *n3 = nodes[3];
 2309: 
 2310:    const Vector2 p0 = n0->p;
 2311:    const Vector2 p1 = n1->p;
 2312:    const Vector2 p2 = n2->p;
 2313:    const Vector2 p3 = n3->p;
 2314: 
 2315:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2316:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2317:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2318:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2319: 
 2320:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2321: }
 2322:    
 2323: 
 2324: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2325:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2326:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2327:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2328:    // The formula is also based on the identity:
 2329:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2330:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2331: 
 2332:    printf("intGradPhiGradPhi: TEST\n");   
 2333: 
 2334:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2335: 
 2336:    const double x0 = nodes[0]->p.x;
 2337:    const double y0 = nodes[0]->p.y;
 2338:    const double x1 = nodes[1]->p.x;
 2339:    const double y1 = nodes[1]->p.y;
 2340:    const double x2 = nodes[2]->p.x;
 2341:    const double y2 = nodes[2]->p.y;
 2342:    const double x3 = nodes[3]->p.x;
 2343:    const double y3 = nodes[3]->p.y;
 2344: 
 2345:    double res = 0.0;
 2346:    
 2347:    // Quadrature points in xi and eta coordinates
 2348:    #pragma unroll
 2349:    for (int i = 0; i < 4; i++) {
 2350:       // For each quadrature point...
 2351: 
 2352:       const Point2 p = GaussPoint(i);
 2353:       const double eta = p.x;
 2354:       const double xi  = p.y;
 2355: 
 2356:       // Jacobian entries at the Gauss point p
 2357:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2358:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2359:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2360:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2361: 
 2362:       const double detJ = jacobianDet(p);
 2363:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2364: 
 2365:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2366:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2367:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2368:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2369:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2370: 
 2371:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2372:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2373:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2374:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2375:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2376: 
 2377:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2378:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2379:    }
 2380: 
 2381:    return res;
 2382: }
 2383: 
 2384: 
 2385: /**  Interpolate velocities at a given point (xt,yt,zt)
 2386: 
 2387:    @param xt, yt, zt: coordinates of the point to interpolate
 2388:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2389: 
 2390:    This is done in four steps:
 2391: 
 2392:    1. Find the shape coordinates for the final position in the element.
 2393:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2394:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2395:       z levels at xt, yt at each step.   
 2396:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2397:       horizontally and vertically.
 2398: **/
 2399: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2400:    // Interpolate the velocities at the point xt. 
 2401:    // This function works the same for triangular and quadrilateral elements.
 2402:    double shpCoord[4];
 2403: 
 2404:    // First step is to compute the shape coordinates of (xt,yt)
 2405:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2406:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2407: 
 2408:    // Second step is to find the level that contains zt
 2409:    // Uses a binary search to find the level
 2410:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2411:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2412:    int R = nvrt - 1;
 2413: 
 2414:    // Get the z coordinates at the nodes of the element at the levels L and R
 2415:    double zLAtNodes[4], zRAtNodes[4];
 2416:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2417:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2418: 
 2419:    double zL = interpolate(shpCoord, zLAtNodes);
 2420:    double zR = interpolate(shpCoord, zRAtNodes);
 2421:    
 2422:    // Interpolates vertically the velocities
 2423:    double wght1, wght2;
 2424:    if (xt.z<=zL) {
 2425:       wght1 = 1.0;
 2426:       wght2 = 0.0;
 2427:    }
 2428:    else if (xt.z>=zR) {
 2429:       wght1 = 0.0;
 2430:       wght2 = 1.0;
 2431:    }
 2432:    else {
 2433:       // Perform a binary search to find the levels between L and R that contain xt.z
 2434:       while (R - L > 1) {
 2435:          int M = (L + R) / 2;
 2436: 
 2437:          double zMAtNodes[4];
 2438:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2439:          double zM = interpolate(shpCoord, zMAtNodes);
 2440:          if (zM < xt.z) 
 2441:          {
 2442:             L = M;
 2443:             zL = zM;
 2444:          }
 2445:          else 
 2446:          {
 2447:             R = M;
 2448:             zR = zM;
 2449:          }
 2450:       }
 2451:       assert(L == R-1);
 2452:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2453: 
 2454:       wght2 = (xt.z - zL)/(zR - zL);
 2455:       wght1 = 1.0 - wght2;
 2456:    }
 2457: 
 2458:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2459:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2460: 
 2461:    // Neither of the interpolated velocities should be NaN
 2462:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2463: 
 2464: }
 2465: 
 2466: 
 2467: 
 2468: 
 2469: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2470: 
 2471:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2472:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2473:    const Node *n1 = side->n1;
 2474:    const Node *n2 = side->n2;
 2475: 
 2476:    bool n1_match = (n1->nodeBnd->segment == segment);
 2477:    bool n2_match = (n2->nodeBnd->segment == segment);
 2478: 
 2479:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2480:    if (n1_match && n2_match) {
 2481:       return 0.5;
 2482:    } else if (n1_match) {
 2483:       return 1.0;
 2484:    } else if (n2_match) {
 2485:       return 0.0;
 2486:    }
 2487: 
 2488:    return 0.0;
 2489: }
