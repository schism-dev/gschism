 8114: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8115:    // Get the value of a variable from an element
 8116:    // varName is the name of the variable to get
 8117:    // var is the array to store the value
 8118:    // k is the vertical level index of the variable to get
 8119: 
 8120:    ELEM(elem);
 8121:    
 8122:    int idx = elem->idx;
 8123:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8124: 
 8125:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8126:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8127:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8128:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8129:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8130:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8131:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8132:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8133:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8134:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8135:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8136:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8137:       
 8138:    
 8139: }
 8140: 
 8141: 
 8142: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8143:    // Get the value of a variable from an node
 8144:    // varName is the name of the variable to get
 8145:    // var is the array to store the value
 8146:    // k is the vertical level index of the variable to get
 8147: 
 8148:    NODE(node);
 8149:    
 8150:    int idx = node->idx;
 8151:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8152: 
 8153:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8154:    
 8155:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8156:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8157:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8158:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8159:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8160:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8161:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8162:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8163:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8164:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8165:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8166:    
 8167:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8168:       
 8169:    
 8170: }
 8171: 
 8172: 
 8173: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8174:    // Get the value of a variable from an side
 8175:    // varName is the name of the variable to get
 8176:    // var is the array to store the value
 8177:    // k is the vertical level index of the variable to get
 8178:    SIDE(side);
 8179:    
 8180:    int idx = side->idx;
 8181:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8182: 
 8183:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8184:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8185:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8186:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8187:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8188:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8189:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8190:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8191:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8192:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8193:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8194:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8195:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8196:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8197:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8198:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8199:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8200:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8201:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8202:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8203:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8204:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8205:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8206:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8207:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8208:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8209:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8210:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8211:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8212:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8213:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8214:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8215:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8216:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8217:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8218:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8219: }
 8220: 
 8221: 
 8222: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8223:    // Get the value of a variable from an side
 8224:    // varName is the name of the variable to get
 8225:    // var is the array to store the value
 8226:    // k is the vertical level index of the variable to get
 8227:    SIDE_BND(sideBnd);   
 8228: 
 8229:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8230:    if (sideBnd->segment->isLand) idx = -7;
 8231: 
 8232:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8233:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8234: 
 8235: }
