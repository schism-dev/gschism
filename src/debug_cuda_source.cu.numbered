 8637: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8638:    // Get the value of a variable from an side
 8639:    // varName is the name of the variable to get
 8640:    // var is the array to store the value
 8641:    // k is the vertical level index of the variable to get
 8642:    SIDE_BND(sideBnd);   
 8643: 
 8644:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8645:    if (sideBnd->segment->isLand) idx = -7;
 8646: 
 8647:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8648:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8649: 
 8650: }
