 2576: 
 2577: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2578: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2579: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 2580: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 2581: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2582: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2583:    Vector2 grad = {0.0, 0.0};
 2584:    int count = 0;
 2585: 
 2586:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2587: 
 2588:    // First element
 2589:    if (elems[0] != nullptr && condition(elems[0])) {
 2590:       grad += elems[0]->grad2(field);
 2591:       count++;
 2592:    }
 2593: 
 2594:    // Second element
 2595:    if (elems[1] != nullptr && condition(elems[1])) {
 2596:       grad += elems[1]->grad2(field);
 2597:       count++;
 2598:    }
 2599: 
 2600:    if (count > 0) {
 2601:       grad = grad*(1.0/count);
 2602:    }
 2603:    
 2604:    return grad;
 2605: }
 2606: 
 2607: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 2608: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 2609: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 2610: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 2611: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 2612: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 2613: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2614: 
 2615: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2616: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2617: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2618: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2619: 
 2620: 
 2621: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2622: 
 2623: __inline__ __device__ Vector2 Side::tau(void)    const { 
 2624:    // Returns the value of the tau at the side center, taking care of the projection to the side frame (ics==1 or ics==2)
 2625:    if constexpr(ics==1) { 
 2626:       return 0.5*(n1->tau + n2->tau);
 2627:    } else {
 2628:       // Project the tau from the node frames to the side frame
 2629:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau(), frame);
 2630:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau(), frame);
 2631: 
 2632:       return 0.5*(stau1 + stau2);
 2633:    }
 2634: }
 2635: 
 2636: /**
 2637:  * This method performs backtracking from the side center until a time -dt back in time 
 2638:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2639:  * intermediate point.
 2640:  *
 2641:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2642:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2643:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2644:  * remaining time.
 2645:  * 
 2646:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2647:  * 
 2648:  * @param uuint, vvint, wwint: Velocities at the final point
 2649:  * @param jlev: Level at which the backtracking is performed
 2650:  * @param dt, dtbk: Tracking timesteps
 2651:  * @return: True if the backtracking was successful, false otherwise
 2652:  */
 2653: __inline__ __device__ bool Side::btrack(
 2654:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2655:       double dt,            // Tracking time
 2656:       double dtbk,          // Tracking timestep
 2657:       Vector3 &u_int        // Velocities at the initial point
 2658: ) const {
 2659: 
 2660:    // Start from side center
 2661:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2662: 
 2663:  
 2664:    double time_rm = dt; // Remaining time
 2665: 
 2666: 
 2667:    // Initial velocities
 2668:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2669: 
 2670:    // Find the element that is in the direction opposite to the velocity
 2671:    Element* curElem = findElementTowards(toVector2(u_int));
 2672:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2673: 
 2674: 
 2675:    // Nudges it towards the barycenter
 2676:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2677: 
 2678: 
 2679:    const int MAX_ITERATIONS = 100; 
 2680:    Element* nextElem = nullptr;
 2681:    int iter = 0;
 2682:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2683:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2684:    while(true) {
 2685: 
 2686:       // Calculate timestep
 2687:       double dtb = min(dtbk, time_rm);
 2688: 
 2689: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2690: 
 2691:       // Next point in the backtracking curve
 2692: // if (iter >= MAX_ITERATIONS - 50)  {
 2693: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2694: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2695: // }
 2696:         
 2697:       xt = x0 - dtb*u_int;
 2698: 
 2699:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2700:       assert(found && "Backtracking failed in btrack");
 2701: 
 2702: 
 2703:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2704:                       // then time_rm needs to be increased by the unused time.
 2705: 
 2706:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2707: 
 2708:       // If the velocity is too small, we stop the backtracking
 2709:       const double vmag = length(toVector2(u_int));
 2710:       if (vmag <= velmin_btrack) break;
 2711: 
 2712:       // The current point becomes the next segment's starting point.
 2713:       x0 = xt;
 2714:  
 2715:       curElem = nextElem;
 2716: 
 2717:       iter++;
 2718: 
 2719:       if (iter >= MAX_ITERATIONS) break;
 2720: 
 2721:       // if (iter >= MAX_ITERATIONS - 50) {
 2722:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 2723:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 2724:       //    }
 2725:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2726:    }
 2727: 
 2728:    assert(!curElem->isDry && "Final element is dry");
 2729:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element"); 
 2730: 
 2731:    // Interpolate the velocities at the final point
 2732:    curElem->interpolateVelocities(xt, u_int);
 2733: 
 2734:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 2735: 
 2736: 
 2737: }
 2738: 
 2739: 
