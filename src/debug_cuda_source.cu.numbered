 2281:    template<typename T>
 2282:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2283:       T values[4];
 2284:       getNodalValues(level, func, values);
 2285: 
 2286:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2287:       if constexpr (IsVector2<T>::value && ics == 2) {
 2288: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2289:          projectNodeVectorsToElementFrame(values);
 2290: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2291:       }
 2292: 
 2293:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2294:    }
 2295: 
 2296:    template<typename T>
 2297:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2298:       T values[4];
 2299:       getNodalValues(field, values);
 2300: 
 2301:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2302:       if constexpr (IsVector2<T>::value && ics == 2) {
 2303: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2304:          projectNodeVectorsToElementFrame(values);
 2305: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2306:       }
 2307:       
 2308:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2309:    }
