 1444: // Helper functions for computing the local node index at a given offset from another.
 1445: __device__ __inline__ int nxq(int offset, int index, int size) {
 1446:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1447:    // to the index to make it positive
 1448:    assert(index + offset + 16*size >= 0);
 1449:    return (index + offset + 16*size) % size;  
 1450: }
 1451: 
 1452: __device__ __inline__ int nxq(int index, int size) {
 1453:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1454:    // to the index to make it positive
 1455:    assert(index + 16*size >= 0);
 1456:    return (index + 16*size) % size; 
 1457: }
