 7933:          *sizeType = sizeof(double);
 7934:          break;
 7935:       case (int)VarCode::u:
 7936:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7937:          *sizeType = sizeof(Vector2);
 7938:          break;   
 7939:       case (int)VarCode::n1:
