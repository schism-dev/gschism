 8152: #ifdef OLD_PCG_SOLVER
 8153: __global__ void computeMatrixProductAndDotProducts() {
 8154:    // Computes A*p, r'Mr and p'Ap
 8155: 
 8156:    // 1) shared buffer: first half for rMr, second for pAp
 8157:    __shared__ double sdata[2*BLOCK_SIZE];
 8158:    double* s_rMr = sdata;
 8159:    double* s_pAp = sdata + BLOCK_SIZE;
 8160: 
 8161:    const int tid = threadIdx.x;
 8162: 
 8163:    double l_pAp = 0.0;
 8164: 
 8165:    s_rMr[tid] = 0.0;
 8166:    s_pAp[tid] = 0.0;
 8167: 
 8168:    // 2) get your node pointer
 8169:    // NODE(node);   
 8170:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 8171:    Node *node = &(mesh->localNodeData[idx_node]); 
 8172:       if (idx_node < mesh->np) {
 8173: 
 8174:       const double diag = node->coeffDiag;
 8175:       const double r    = node->mR;
 8176:       const double p    = node->mP;  
 8177: 
 8178:       // apply preconditioner on the fly:
 8179:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 8180: 
 8181:       // 4) compute Ap = A.p
 8182:       double Ap = node->coeffDiag * node->mP;
 8183:       for (int j = 0; j < node->numNodes; ++j) {
 8184:          const Node *nbNode = node->nodes[j];
 8185:          Ap += node->coeffMatrix[j] * nbNode->mP;
 8186: 
 8187:       }
 8188: 
 8189:       node->mAp = Ap;
 8190:       
 8191: 
 8192:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 8193:       // const double l_rMr = r*Mr;  // r'Mr
 8194:       l_pAp = p*Ap;  // p'Ap
 8195: 
 8196: 
 8197:    }
 8198: 
 8199:    // 6) write into shared mem
 8200:    // s_rMr[tid] = l_rMr;
 8201:    s_pAp[tid] = l_pAp;
 8202: 
 8203:    __syncthreads();
 8204: 
 8205:    // 7) block-wide tree reduction
 8206:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8207:       if (tid < stride)  {
 8208:          s_pAp[tid] += s_pAp[tid + stride];
 8209:       }
 8210:       __syncthreads();
 8211:    }
 8212: 
 8213:    // 8) thread 0 atomically accumulates into the globals
 8214:    // XXX: This is slower than it needs to be, but it is simple and works
 8215:    if (tid == 0) {
 8216:       atomicAdd(pAp, s_pAp[0]);
 8217:    }
 8218: 
 8219: 
 8220: }
 8221: 
 8222: 
 8223: __global__ void updateSolutionAndDotProducts(void) {
 8224:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 8225: 
 8226:    const int tid = threadIdx.x;
 8227: 
 8228:    s_rMr[tid] = 0.0;
 8229: 
 8230:    // get node & bounds-check:
 8231:    NODE(node);
 8232: 
 8233:    
 8234:    // Compute alpha
 8235:    const double alpha = (*rMr_old)/(*pAp); 
 8236: 
 8237: 
 8238:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 8239: 
 8240: 
 8241:    // load scalars
 8242:    const double diag = node->coeffDiag;
 8243:    const double p    = node->mP;
 8244:    const double Ap   = node->mAp;
 8245:    const double x    = node->mX;
 8246:    const double r    = node->mR;
 8247:    
 8248:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 8249: 
 8250:    // 1) update solution & residual
 8251:    const double x_new = x + alpha*p;
 8252:    const double r_new = r - alpha*Ap;
 8253:    node->mX = x_new;
 8254:    node->mR = r_new;
 8255: 
 8256:    // 2) apply Jacobi preconditioner on the fly
 8257:    const double Mr_new = r_new/diag;
 8258: 
 8259: 
 8260:    // 3) local contributions for the two dot-products
 8261:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 8262: 
 8263:    // 4) write into shared-mem
 8264:    s_rMr[tid] = l_rMr;
 8265: 
 8266:    __syncthreads();
 8267: 
 8268: 
 8269:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8270:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8271:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8272:       __syncthreads();
 8273:    }
 8274: 
 8275:    // 6) thread 0 atomically folds into the global accumulators
 8276:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 8277: 
 8278: 
 8279: }
 8280: 
 8281: 
 8282: __global__ void updateSearchDirection() {
 8283: 
 8284:     NODE(node);
 8285: 
 8286:     // recompute z on-the-fly
 8287:     const double z = node->mR / node->coeffDiag;
 8288:     const double p = node->mP;
 8289: 
 8290:     const double beta = (*rMr_new)/(*rMr_old);
 8291: 
 8292: 
 8293:     // p =z + beta*p
 8294:     node->mP = z + beta*p;
 8295: 
 8296: }
 8297: 
 8298: __global__ void initializeScalars(double *scalars) {
 8299: 
 8300:    // These point to a cupy array in the host code
 8301:    rMr_old = scalars + 0;
 8302:    rMr_new = scalars + 1;
 8303:    pAp     = scalars + 2;
 8304: }
 8305: 
 8306: __global__ void initializePreconditionedResidual(void) {
 8307: 
 8308:     __shared__ double s_rMr[BLOCK_SIZE];  
 8309: 
 8310:     s_rMr[threadIdx.x] = 0.0;
 8311: 
 8312:     NODE_ALL(node, valid);
 8313:     const int tid = threadIdx.x;
 8314:     // For the first iteration:
 8315:     // 1. Initial solution x = 0 (already set)
 8316:     // 2. Initial residual r = b (stored in qel)
 8317:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 8318: 
 8319: // XXX we should use the guess solution here    
 8320: 
 8321:     double l_rMr = 0.0;
 8322:     if (valid) {
 8323:       // Set initial residual r = b (from qel)
 8324:       node->mR = node->qel;
 8325: 
 8326:       // Compute z = M^-1 * r (preconditioned residual)
 8327:       const double z = node->mR / node->coeffDiag;
 8328: 
 8329:       // Set initial search direction p = z
 8330:       node->mP = z;
 8331: 
 8332:       // Initialize other variables needed for CG
 8333:       node->mX = 0.0;  // Initial solution
 8334:       node->mAp = 0.0; // Will be computed in first iteration
 8335: 
 8336: 
 8337:       // Computes the first r'Mr (reduction)
 8338:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 8339:     }
 8340:     // 4) write into shared-mem
 8341:     s_rMr[tid] = l_rMr;
 8342: 
 8343:     __syncthreads();
 8344: 
 8345: 
 8346:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 8347:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 8348:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 8349:         __syncthreads();
 8350:     }
 8351: 
 8352:     // 6) thread 0 atomically folds into the global accumulators
 8353:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 8354: 
 8355:     *rMr_old = 0.0;
 8356:     *pAp = 0.0;
 8357: }
 8358: #endif
 8359: 
 8360: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 8361: 
 8362:    ELEM(elem);
 8363: 
 8364:    switch (varCode) {
 8365:       case (int)VarCode::outputCoords:
 8366:          const Point2 coords = elem->outputCoords();
 8367:          res[elem->idx*2    ] = coords.x;
 8368:          res[elem->idx*2 + 1] = coords.y;
 8369:          break;
 8370:    }
 8371: }
