 1167: // This struct is used to store the boundary information for a node.
 1168: struct NodeBoundary {   
 1169:    int idx;
 1170:    BoundarySegment *segment;
 1171:    Node *node;
 1172:    
 1173:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1174:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1175: 
 1176:    bool isLand;
 1177: 
 1178:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1179:    double elbc;   // Elevation boundary condition
 1180:    double eth;    // Elevation time history
 1181: 
 1182:    double eta_mean; // Mean elevation at nodes
 1183: 
 1184:    bool isEssentialBC;
 1185: 
 1186:    Vector2 uth[nvrt];  // "Time history" velocity
 1187: 
 1188:    // Arrays for harmonic constituents (if needed)
 1189:    double  emo[nbfr];  // Elevation amplitude
 1190:    double  efa[nbfr];  // Elevation phase
 1191:    Vector2 umo[nbfr];  // velocity amplitude
 1192:    Vector2 ufa[nbfr];  // velocity phase
 1193: 
 1194: 
 1195:    NodeBoundary(void) {
 1196:       isLand = false;
 1197:    }
 1198:    NodeBoundary(bool _isLand) {
 1199:       isLand = _isLand;
 1200:    }
 1201: 
 1202:    
 1203:    __forceinline__ __device__ int numSidesForAverage() const {
 1204:    // Returns the number of sides that are connected to the node and have the same segment.
 1205:    // This is used to compute the average velocity at the node for open boundary nodes.
 1206:       int res = 0;
 1207:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1208:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1209: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1210:       return res;
 1211:    }
 1212: 
 1213: 
 1214:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1215:       assert(index == 0 || index == 1); 
 1216:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1217:    }
 1218: 
 1219: 
 1220: };
