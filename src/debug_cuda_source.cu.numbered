 7152: 
 7153: __global__ void computeMatrixProductAndDotProducts() {
 7154:    // Computes A*p, r'Mr and p'Ap
 7155: 
 7156:    // 1) shared buffer: first half for rMr, second for pAp
 7157:    __shared__ double sdata[2*BLOCK_SIZE];
 7158:    double* s_rMr = sdata;
 7159:    double* s_pAp = sdata + BLOCK_SIZE;
 7160: 
 7161:    const int tid = threadIdx.x;
 7162: 
 7163:    double l_pAp = 0.0;
 7164: 
 7165:    s_rMr[tid] = 0.0;
 7166:    s_pAp[tid] = 0.0;
 7167: 
 7168:    // 2) get your node pointer
 7169:    // NODE(node);   
 7170:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7171:    Node *node = &(mesh->localNodeData[idx_node]); 
 7172:       if (idx_node < mesh->np) {
 7173: 
 7174:       const double diag = node->coeffDiag;
 7175:       const double r    = node->mR;
 7176:       const double p    = node->mP;  
 7177: 
 7178:       // apply preconditioner on the fly:
 7179:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7180: 
 7181:       // 4) compute Ap = A.p
 7182:       double Ap = node->coeffDiag * node->mP;
 7183:       for (int j = 0; j < node->numNodes; ++j) {
 7184:          const Node *nbNode = node->nodes[j];
 7185:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7186: 
 7187:       }
 7188: 
 7189:       node->mAp = Ap;
 7190:       
 7191: 
 7192:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7193:       // const double l_rMr = r*Mr;  // r'Mr
 7194:       l_pAp = p*Ap;  // p'Ap
 7195: 
 7196: 
 7197:    }
 7198: 
 7199:    // 6) write into shared mem
 7200:    // s_rMr[tid] = l_rMr;
 7201:    s_pAp[tid] = l_pAp;
 7202: 
 7203:    __syncthreads();
 7204: 
 7205:    // 7) block-wide tree reduction
 7206:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7207:       if (tid < stride)  {
 7208:          s_pAp[tid] += s_pAp[tid + stride];
 7209:       }
 7210:       __syncthreads();
 7211:    }
 7212: 
 7213:    // 8) thread 0 atomically accumulates into the globals
 7214:    // XXX: This is slower than it needs to be, but it is simple and works
 7215:    if (tid == 0) {
 7216:       atomicAdd(pAp, s_pAp[0]);
 7217:    }
 7218: 
 7219: 
 7220: }
 7221: 
 7222: 
 7223: __global__ void updateSolutionAndDotProducts(void) {
 7224:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7225: 
 7226:    const int tid = threadIdx.x;
 7227: 
 7228:    s_rMr[tid] = 0.0;
 7229: 
 7230:    // get node & bounds-check:
 7231:    NODE(node);
 7232: 
 7233:    
 7234:    // Compute alpha
 7235:    const double alpha = (*rMr_old)/(*pAp); 
 7236: 
 7237: 
 7238:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7239: 
 7240: 
 7241:    // load scalars
 7242:    const double diag = node->coeffDiag;
 7243:    const double p    = node->mP;
 7244:    const double Ap   = node->mAp;
 7245:    const double x    = node->mX;
 7246:    const double r    = node->mR;
 7247:    
 7248:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7249: 
 7250:    // 1) update solution & residual
 7251:    const double x_new = x + alpha*p;
 7252:    const double r_new = r - alpha*Ap;
 7253:    node->mX = x_new;
 7254:    node->mR = r_new;
 7255: 
 7256:    // 2) apply Jacobi preconditioner on the fly
 7257:    const double Mr_new = r_new/diag;
 7258: 
 7259: 
 7260:    // 3) local contributions for the two dot-products
 7261:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7262: 
 7263:    // 4) write into shared-mem
 7264:    s_rMr[tid] = l_rMr;
 7265: 
 7266:    __syncthreads();
 7267: 
 7268: 
 7269:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7270:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7271:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7272:       __syncthreads();
 7273:    }
 7274: 
 7275:    // 6) thread 0 atomically folds into the global accumulators
 7276:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7277: 
 7278: 
 7279: }
 7280: 
 7281: 
 7282: __global__ void updateSearchDirection() {
 7283: 
 7284:     NODE(node);
 7285: 
 7286:     // recompute z on-the-fly
 7287:     const double z = node->mR / node->coeffDiag;
 7288:     const double p = node->mP;
 7289: 
 7290:     const double beta = (*rMr_new)/(*rMr_old);
 7291: 
 7292: 
 7293:     // p =z + beta*p
 7294:     node->mP = z + beta*p;
 7295: 
 7296: }
 7297: 
 7298: __global__ void initializeScalars(double *scalars) {
 7299: 
 7300:    // These point to a cupy array in the host code
 7301:    rMr_old = scalars + 0;
 7302:    rMr_new = scalars + 1;
 7303:    pAp     = scalars + 2;
 7304: }
 7305: 
 7306: __global__ void initializePreconditionedResidual(void) {
 7307: 
 7308:     __shared__ double s_rMr[BLOCK_SIZE];  
 7309: 
 7310:     s_rMr[threadIdx.x] = 0.0;
 7311: 
 7312:     NODE_ALL(node, valid);
 7313:     const int tid = threadIdx.x;
 7314:     // For the first iteration:
 7315:     // 1. Initial solution x = 0 (already set)
 7316:     // 2. Initial residual r = b (stored in qel)
 7317:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7318: 
 7319: // XXX we should use the guess solution here    
 7320: 
 7321:     double l_rMr = 0.0;
 7322:     if (valid) {
 7323:       // Set initial residual r = b (from qel)
 7324:       node->mR = node->qel;
 7325: 
 7326:       // Compute z = M^-1 * r (preconditioned residual)
 7327:       const double z = node->mR / node->coeffDiag;
 7328: 
 7329:       // Set initial search direction p = z
 7330:       node->mP = z;
 7331: 
 7332:       // Initialize other variables needed for CG
 7333:       node->mX = 0.0;  // Initial solution
 7334:       node->mAp = 0.0; // Will be computed in first iteration
 7335: 
 7336: 
 7337:       // Computes the first r'Mr (reduction)
 7338:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7339:     }
 7340:     // 4) write into shared-mem
 7341:     s_rMr[tid] = l_rMr;
 7342: 
 7343:     __syncthreads();
 7344: 
 7345: 
 7346:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7347:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7348:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7349:         __syncthreads();
 7350:     }
 7351: 
 7352:     // 6) thread 0 atomically folds into the global accumulators
 7353:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7354: 
 7355:     *rMr_old = 0.0;
 7356:     *pAp = 0.0;
 7357: }
 7358: 
 7359: 
 7360: 
 7361: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7362:    Element *elems = mesh->localElemData;
 7363: 
 7364:    *addr = elems;
 7365:    *sizeElement = sizeof(Element);
 7366:    switch (varCode) {
 7367:       case (int)VarCode::z:
 7368:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7369:          *sizeType = sizeof(double);
 7370:          break;
 7371:       case (int)VarCode::x:
 7372:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7373:          *sizeType = sizeof(Vector2);
 7374:          break;
 7375:       case (int)VarCode::area:
 7376:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7377:          *sizeType = sizeof(double);
 7378:          break;
 7379:       case (int)VarCode::depth:
 7380:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7381:          *sizeType = sizeof(double);
 7382:          break;
 7383:       case (int)VarCode::radius:
 7384:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7385:          *sizeType = sizeof(double);
 7386:          break;
 7387:       case (int)VarCode::lonlat:
 7388:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7389:          *sizeType = sizeof(double);
 7390:          break;
 7391:       case (int)VarCode::ghat:
 7392:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7393:          *sizeType = sizeof(Vector2);
 7394:          break;
 7395:       case (int)VarCode::kb:
 7396:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7397:          *sizeType = sizeof(int);
 7398:          break;
 7399:       case (int)VarCode::isdry:
 7400:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7401:          *sizeType = sizeof(int);
 7402:          break;            
 7403:       case (int)VarCode::w:
 7404:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7405:          *sizeType = sizeof(double);
 7406:          break;
 7407:       case (int)VarCode::FaceIndices:
 7408:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7409:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7410:          *sizeType = sizeof(Node);
 7411:          break;
 7412:       default:
 7413:          *offset = -1;
 7414:    }
 7415: }
