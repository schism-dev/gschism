 6314:    __global__ void resetBoundaryAreas(void) {
 6315:       // Reset boundary areas and lengths for each segment.
 6316: 
 6317:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6318:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6319:       SIDE_BND(sideBnd);
 6320: 
 6321:       BoundarySegment *segment = sideBnd->segment;
 6322: 
 6323:       segment->carea = 0.0;
 6324:       segment->clen = 0.0;
 6325:  
 6326:    }
 6327: 
 6328:    __global__ void computeBoundaryAreas(void) {
 6329:    // Calculation of cross-section areas and lengths for flow b.c.
 6330: 
 6331:       SIDE_BND(sideBnd);
 6332: 
 6333:       const Side *side = sideBnd->side;
 6334:       BoundarySegment *segment = sideBnd->segment;
 6335: 
 6336:       if (segment->ifltype != 0) {
 6337: 
 6338:          const Node *n1 = side->n1;
 6339:          const Node *n2 = side->n2;
 6340: 
 6341:          const double htot = side->htot2();
 6342: 
 6343:          if (!side->isDry) {
 6344:             atomicAdd(&segment->carea, htot*side->len);
 6345:             atomicAdd(&segment->clen, side->len);
 6346:          }
 6347:       }
 6348: 
 6349:    }
 6350: 
 6351: 
 6352:    __global__ void computeFlowBcVelocities(double time) {
 6353: 
 6354:       SIDE_BND(sideBnd);
 6355: 
 6356:       const Side *side = sideBnd->side;
 6357:  
 6358:       const bool isDry = side->isDry;
 6359:       const bool isLand = sideBnd->segment->isLand;
 6360: 
 6361:    
 6362:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6363: 
 6364:       if (isDry || isLand) return;
 6365: 
 6366:       // For wet sides in open boundaries...
 6367:       const Vector2 n = side->n;
 6368:       const BoundarySegment *segment = sideBnd->segment;
 6369: 
 6370:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6371: 
 6372:       const int ifltype = segment->ifltype;
 6373: 
 6374:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6375:       const Vector2 r_nuth0 = r_uth0*n;
 6376: 
 6377: 
 6378:       if (ifltype == 1 || ifltype == 2) {
 6379:       
 6380:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6381: 
 6382:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6383: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6384:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6385:          
 6386:       } else if (ifltype == -1) { // Flather 1
 6387: 
 6388:          for (int k = 0; k < nvrt; k++) {
 6389: 
 6390:             // uth is the normal vel.; no ramp up
 6391:             const double uth = sideBnd->nuth(k);
 6392:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6393: 
 6394:             sideBnd->ubc[k] += uth*n;
 6395:          }
 6396: 
 6397:       } else if (ifltype == 3 || ifltype == 5) {
 6398:          // vnth0=0 !normal vel.
 6399: 
 6400:          Vector2 r_u1_bar = {0.0, 0.0};
 6401:          // Computes the contribution to the velocity from all tide frequencies
 6402:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6403: 
 6404:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6405:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6406: 
 6407:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6408:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6409:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6410:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6411: 
 6412:          }
 6413: 
 6414: 
 6415:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6416: 
 6417:       } // if (ifltype = 3 || ifltype == 5
 6418: 
 6419: 
 6420: 
 6421:    }
 6422: 
 6423:    __global__ void computeElevationBoundaryConditions(double time) {
 6424:       // Compute elevation essential boundary conditions 
 6425: 
 6426:       NODE_BND(nodeBnd); // Each boundary node.
 6427: 
 6428:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6429: 
 6430:       const Node *node = nodeBnd->node;
 6431:       const BoundarySegment *segment = nodeBnd->segment;
 6432:       const int iettype = segment->iettype;
 6433:       
 6434: 
 6435:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6436:       double eic = 0.0;
 6437:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6438:       else                 eic = 0.0;
 6439: 
 6440:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6441:       const double r_eth = ramp*nodeBnd->eth;
 6442:       double r_eta1_bar = 0.0;
 6443: 
 6444:       // Compute tide elevation
 6445:       if (iettype == 3 || iettype == 5) {   
 6446: 
 6447:          if constexpr(iloadtide==1) { // loading tide
 6448:             assert(false && "Loading tide not implemented");
 6449:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6450:          }
 6451:          
 6452:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6453: 
 6454:             const double efa  = nodeBnd->efa[jfr]; 
 6455:             const double emo  = nodeBnd->emo[jfr]; 
 6456: 
 6457:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6458:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6459:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6460: 
 6461: 
 6462:          } // for jfr
 6463: 
 6464:       } // if iettype
 6465: 
 6466:       switch (iettype) {
 6467:          case 1:
 6468:          case 2:
 6469:          case 4:
 6470:             nodeBnd->elbc = r_eic + r_eth;
 6471:             break;
 6472:          case 3:
 6473:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6474:             break;
 6475:          case 5:
 6476:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6477:             break;
 6478:       } // switch
 6479: 
 6480: 
 6481:       //Add inverse barometric effects
 6482:       if (iettype != 0 && inv_atm_bnd == 1) {
 6483:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6484:       }
 6485: 
 6486:    }
 6487: 
 6488: 
 6489:    __global__ void computeHorizontalViscosity(void) { 
 6490: 
 6491:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6492: 
 6493:       SIDE(side);
 6494: 
 6495:       if (side->isDry) return;
 6496: 
 6497:       for (int k = 0; k < nvrt; k++) {
 6498:          side->nuGradU[k] = {0.0, 0.0};
 6499:       }
 6500: 
 6501:       if constexpr(ihorcon == 1) {
 6502:          for (int k = side->kb; k < nvrt - 1; k++) {
 6503:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6504:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6505:             // By Zhang and Baptista.
 6506: 
 6507:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6508:             // This is a standard discretization of the Laplacian operator.
 6509:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6510:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6511:             // Gamma is hvis_coef0 in the code.
 6512:             // The value of gamma needs to be < 0.5.
 6513: 
 6514:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6515:             // side under consideration in each of the two possible elements that share the side.
 6516:             Vector2 sumU = {0.0, 0.0};
 6517:             for (int l = 0; l < 2; l++) {
 6518:                const Element *elem = side->elems[l];
 6519: 
 6520:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6521: 
 6522:                // Find the local index of the side in the element
 6523:                const int idxSide = elem->sideLocalIdx(side);
 6524: 
 6525:                // Find the two sides that are connected to the side under consideration
 6526:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6527:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6528: 
 6529:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6530: 
 6531:             }
 6532: 
 6533:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6534: 
 6535:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6536:    
 6537:          }
 6538:       }
 6539:       else if constexpr(ihorcon == 2) {
 6540:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6541:       }
 6542: 
 6543: 
 6544:    }
 6545: 
 6546: 
 6547:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6548: 
 6549:       // Set essential boundary conditions 
 6550:       NODE(node); // Each boundary node
 6551:       NodeBoundary *nodeBnd = node->nodeBnd;
 6552:       
 6553:  
 6554:       // Check if this node has essential BC
 6555:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6556: 
 6557:          // Verify BC value is valid
 6558:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6559: 
 6560:        
 6561:          // Set diagonal to 1 and zero off-diagonals
 6562:          for (int j = 0; j <= node->numNodes; j++) {
 6563:                node->coeffRow[j] = 0.0;
 6564:          }
 6565: 
 6566:          *(node->coeffDiag) = 1.0;
 6567: 
 6568: 
 6569:          // Set solution and RHS to BC value
 6570:          node->mX  = nodeBnd->elbc;
 6571:          node->qel = nodeBnd->elbc;
 6572: 
 6573:       } else {
 6574:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6575: 
 6576:          for (int j = 0; j < node->numNodes; j++) {
 6577:                const Node* nbNode = node->nodes[j];
 6578:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6579: 
 6580:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6581:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6582: 
 6583:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6584:                   // Verify neighbor's BC value
 6585:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6586: 
 6587:                   // Subtract contribution to RHS
 6588:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6589:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6590:                }
 6591:          }
 6592: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6593:       }
 6594:    }
 6595: 
