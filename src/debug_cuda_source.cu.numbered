 2378: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2379: // return;   
 2380:    // Lock the mutex
 2381:    lock(&debugPlotMutex);
 2382:  
 2383:    bool ok = true;
 2384:    if (debugPlotIdx == nullptr) ok = false;
 2385:    if (*debugPlotIdx >= 1000000) ok = false;
 2386:    if (ok) {
 2387:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2388:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2389:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2390:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2391:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2392:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2393:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2394:       (*debugPlotIdx)++;
 2395:    }
 2396: 
 2397:    __threadfence();               // ensure all above writes are visible
 2398:    // Unlock the mutex
 2399:    unlock(&debugPlotMutex);
 2400: 
 2401: }
 2402: 
 2403: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2404:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2405: }
