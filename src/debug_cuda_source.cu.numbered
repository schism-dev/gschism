 3844: extern "C" {
 3845: 
 3846:    __global__ void scaleGravity(double loadtide_coef) {
 3847: 
 3848: 
 3849:       NODE(node);
 3850: 
 3851:       // SAL option: scale gravity
 3852:       if constexpr(iloadtide==2) {  // simple const
 3853:          node->grav2 = grav*(1.0 - loadtide_coef);
 3854: 
 3855:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3856:         
 3857:           const double depth = max(node->depth, 0.0);
 3858:           const double tmp1 = sqrt(depth);
 3859:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3860:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3861:                              2.6969e-13*depth*depth*depth*tmp1;
 3862:           
 3863:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3864:           
 3865: 
 3866: 
 3867:           node->grav2 = grav*(1.0 - beta_bar);
 3868: 
 3869:       } else {  // iloadtide=0,1
 3870:         node->grav2=grav;
 3871: 
 3872:       }
 3873: 
 3874:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3875:    }
 3876: 
