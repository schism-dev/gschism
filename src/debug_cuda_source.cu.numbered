 9857: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 9858:    Node *nodes = mesh->localNodeData;
 9859: 
 9860:    *addr = nodes;
 9861:    *sizeNode = sizeof(Node);
 9862: 
 9863:    switch (varCode) {
 9864:       case (int)VarCode::depth:
 9865:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 9866:          *sizeType = sizeof(double);
 9867:          break;
 9868:       case (int)VarCode::eta:
 9869:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 9870:          *sizeType = sizeof(double);
 9871:          break;
 9872:       case (int)VarCode::x:
 9873:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 9874:          *sizeType = sizeof(Vector2);
 9875:          break;
 9876:       case (int)VarCode::z:
 9877:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 9878:          *sizeType = sizeof(double);
 9879:          break;
 9880:       case (int)VarCode::kb:
 9881:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 9882:          *sizeType = sizeof(int);
 9883:          break;
 9884:       case (int)VarCode::isdry:
 9885:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 9886:          *sizeType = sizeof(int);
 9887:          break;         
 9888:       case (int)VarCode::w:
 9889:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 9890:          *sizeType = sizeof(double);
 9891:          break;
 9892:       case (int)VarCode::u:
 9893:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 9894:          *sizeType = sizeof(Vector2);
 9895:          break;  
 9896:       case (int)VarCode::u_air:
 9897:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 9898:          *sizeType = sizeof(Vector2);
 9899:          break;
 9900:       default:
 9901:          *offset = -1;    
 9902:    }  
 9903:    
 9904: }
