 1657: // Helper functions for computing the local node index at a given offset from another.
 1658: __device__ __inline__ int nxq(int offset, int index, int size) {
 1659:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1660:    // to the index to make it positive
 1661:    assert(index + offset + 16*size >= 0);
 1662:    return (index + offset + 16*size) % size;  
 1663: }
 1664: 
 1665: __device__ __inline__ int nxq(int index, int size) {
 1666:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1667:    // to the index to make it positive
 1668:    assert(index + 16*size >= 0);
 1669:    return (index + 16*size) % size; 
 1670: }
