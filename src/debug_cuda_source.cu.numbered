 3764: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3765:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3766:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3767:    // 
 3768:    // This kernel is called for all nodes.
 3769: 
 3770: 
 3771:    NODE(node1);
 3772: 
 3773: 
 3774:    node1->clearMatrixRow();
 3775:    node1->qel = 0.0;
 3776: 
 3777:    // THIS IS FOR STRUCTURES XXX
 3778:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3779: 
 3780:    
 3781:    for (int j=0; j<node1->numElements; j++) {
 3782:       // For each element connected to the node...
 3783: 
 3784:       Element *elem = node1->elements[j];
 3785: 
 3786:       // Compute the average gravity
 3787:       const double grav3 = elem->mean(&Node::grav2);
 3788: 
 3789:       // Look at the documentation for the description of the terms in the following integrals
 3790: 
 3791:       // Integral I_1 
 3792:       // \bar{\breve{H}} 
 3793:       const double hhatb = elem->mean(&Side::hhat);        
 3794: 
 3795:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3796: 
 3797:       const int id1 = elem->nodeLocalIdx(node1); 
 3798:       const double area = elem->area;
 3799: 
 3800:       if (elem->isTri()) {
 3801: 
 3802:          // To clarify the notation in this section: 
 3803:          //   i stands for the node under consideration (node1)
 3804:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3805:          const int id2 = elem->nxq(1 + id1);
 3806:          const int id3 = elem->nxq(2 + id1);
 3807:          Node *node2 = elem->nodes[id2];
 3808:          Node *node3 = elem->nodes[id3];
 3809: 
 3810:          const Point2 x1 = node1->p2();
 3811:          const Point2 x2 = node2->p2();
 3812:          const Point2 x3 = node3->p2();
 3813: 
 3814:          // integral of phi_i*phi_j
 3815:          const double ipp_ii = (1.0/6.0 )*area;
 3816:          const double ipp_ij = (1.0/12.0)*area;
 3817:          const double ipp_ik = (1.0/12.0)*area;
 3818: 
 3819:          // integral of [(grad phi_i) * (grad phi_j)]
 3820:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3821:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3822:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3823: 
 3824:          // Computes the different components of integral I_1 of each node with respect to node i.
 3825:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3826:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3827:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3828: 
 3829:          node1->addToSparseMatrix(node1, I1_ii);
 3830:          node1->addToSparseMatrix(node2, I1_ij); 
 3831:          node1->addToSparseMatrix(node3, I1_ik);
 3832: 
 3833:       }
 3834:       else { // Quad
 3835:          // XXX IMPLEMENT THIS
 3836:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3837: 
 3838:          // To clarify the notation in this section: 
 3839:          //   i stands for the node under consideration (node1)
 3840:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3841:          const int id2 = elem->nxq(1 + id1);
 3842:          const int id3 = elem->nxq(2 + id1);
 3843:          const int id4 = elem->nxq(3 + id1);
 3844:          Node *node2 = elem->nodes[id2];
 3845:          Node *node3 = elem->nodes[id3];
 3846:          Node *node4 = elem->nodes[id4];         
 3847: 
 3848:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3849:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3850:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3851:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3852:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3853: 
 3854:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3855:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3856:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3857:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3858:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3859: 
 3860:          // Computes the different components of integral I_1 of each node with respect to node i.
 3861:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3862:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3863:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3864:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3865: 
 3866:          node1->addToSparseMatrix(node1, I1_ii);
 3867:          node1->addToSparseMatrix(node2, I1_ij); 
 3868:          node1->addToSparseMatrix(node3, I1_ik);
 3869:          node1->addToSparseMatrix(node4, I1_il);
 3870:   
 3871: 
 3872: 
 3873:       
 3874:       } 
 3875: 
 3876:  
 3877:       // Integral I_4
 3878:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3879:       // Where
 3880:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3881: 
 3882:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3883:       // of U over the element.
 3884:       Vector2 Umean = {0.0, 0.0};
 3885:       for (int m=0; m<elem->i34; m++) {      
 3886:          const Side *side = elem->sides[m];
 3887: 
 3888:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3889:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3890:       }
 3891:       Umean = Umean/elem->i34;
 3892: 
 3893:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3894: 
 3895:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3896:       const double I_4_1 = dot(gradPhi_1, Umean);
 3897: 
 3898:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3899:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3900:      
 3901:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3902: 
 3903:       // Additional terms 
 3904:       double vnorm = 0.0;
 3905:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3906:          Vector3 ubed;
 3907:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3908: 
 3909:          Vector3 gradP = {0.0, 0.0, 1.0};
 3910:          for (int m=0; m < elem->i34; m++) {
 3911:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3912:            gradP += toVector3(gradP_2D, 0.0);
 3913:          }   
 3914:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3915:       } // imm==2
 3916: 
 3917:       if (elem->isTri()) {
 3918:          for (int l=0; l<3; l++) {
 3919:             double fac;
 3920: 
 3921:             Node *node = elem->nodes[l];
 3922: 
 3923:             fac = (node == node1) ? 2.0 : 1.0;
 3924:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3925:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3926: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3927:            
 3928:          }
 3929: 
 3930: 
 3931:          if (!elem->isDry) {
 3932:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3933: 
 3934:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3935: 
 3936:          }
 3937: 
 3938:       } // isTri
 3939:       else { // isQuad
 3940:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3941:          // for (int l=0; l<4; l++) {
 3942:          //   const Node *node = elem->nodes[l];
 3943: 
 3944:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3945:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3946: 
 3947:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3948:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3949:          // }
 3950: 
 3951:       } // isQuad
 3952: 
 3953: 
 3954:      node1->qel += (dt/elem->i34)*elem->vsource;
 3955:       
 3956: 
 3957:    } // for all elements connected to the node
 3958:    
 3959: 
 3960:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3961:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3962:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3963:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3964:       // If it is an open boundary node...
 3965: 
 3966:       // At least one open bnd side, maybe two
 3967:       for (int l=0; l<2; l++) { 
 3968: 
 3969:          // Gets each of the sides sharing the node. 
 3970:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3971: 
 3972: printf("l = %d, sideBnd = %p\n", l, sideBnd);         
 3973: 
 3974:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3975: 
 3976:          
 3977: 
 3978:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3979:          if (sideBnd != nullptr) {
 3980:             // If the side is on a boundary...
 3981: 
 3982:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3983: 
 3984:             // Get the boundary segment
 3985:             const BoundarySegment *sideSegment = sideBnd->segment;
 3986:             const Side *side = sideBnd->side;
 3987: 
 3988:             // Integral I_3
 3989:             if (sideSegment->ifltype != 0) {
 3990:             // Natural or Flather b.c.
 3991: 
 3992:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3993:                // especially for Flather b.c.
 3994:                double ri3 = 0.0;
 3995:                if (!side->isDry) {
 3996:                   // If the side is not dry
 3997:                   
 3998:                   // Computes the side flux of (uth, vth)
 3999:                   double Vn = 0.0;
 4000:                   for (int k = side->kb; k<nvrt-1; k++) {
 4001:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4002:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4003: 
 4004:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 4005:                   }
 4006: printf("side->idx = %d, side->len = %f, Vn = %f\n",  side->idx, side->len, Vn);
 4007:                   ri3 = 0.5*side->len*Vn;
 4008:                }
 4009: 
 4010:                if (sideSegment->ifltype == -1) { // Flather 1
 4011: 
 4012:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4013:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4014: 
 4015:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4016:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4017:                   
 4018:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4019:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4020: 
 4021:                } 
 4022:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4023:                   // Reset ri3
 4024:                   ri3 = 0.0;
 4025: 
 4026:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4027: 
 4028:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4029: 
 4030:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4031:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4032: 
 4033:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4034:                   node1->addToSparseMatrix(node1, con0*2.0);
 4035:                   node1->addToSparseMatrix(node2, con0);
 4036: 
 4037:                } // if Flather or Discharge
 4038: 
 4039: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 4040:                node1->qel -= thetai*dt*ri3;
 4041: 
 4042: 
 4043:             } // I_3
 4044:           
 4045: 
 4046:             // Integral I_5
 4047:             if(!side->isDry) {
 4048: 
 4049:                const double Unbar = dot(side->U, side->n);
 4050:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4051: 
 4052:             } // I_5
 4053: 
 4054:          } // if is boundary side
 4055: 
 4056:       } // for l
 4057: 
 4058:    } // if isbnd
 4059: 
 4060: 
 4061: }
 4062: 
 4063: 
 4064: 
 4065: extern "C" {
 4066:    __global__ void rollUpElevation(void) {
 4067: 
 4068:       NODE(node);
 4069: 
 4070:       node->eta1 = node->eta2;
 4071: 
 4072:    }
 4073: 
 4074: 
 4075:    __global__ void backtrackAllNodes(void) {
 4076: 
 4077:       // max/min # of sub-divisions
 4078:       const int ndelt_max = max(1.0, dt/dtb_min);
 4079:       const int ndelt_min = max(1.0, dt/dtb_max); 
 4080: 
 4081:       // Removed all references to swild98 XXX
 4082:       // swild98=0.d0 !init
 4083: 
 4084: 
 4085:       SIDE(side);
 4086: 
 4087:       const int kb = side->kb;
 4088: 
 4089: 
 4090:       // Initialize btrack velocities to the actual velocities at the side 
 4091:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4092: 
 4093:       if (side->isDry) return;
 4094: 
 4095: 
 4096:       // Checks that at least one element is not dry
 4097:       const Element *elem1 = side->elems[0];
 4098:       const Element *elem2 = side->elems[1];
 4099: 
 4100: 
 4101:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4102:       
 4103:       // XXXXXX
 4104:       // !swild_tmp to store global coord. of the starting side
 4105:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4106:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4107:       // !Use sframe2 
 4108:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4109: 
 4110: 
 4111:       for (int k = kb; k < nvrt; k++) {
 4112:       //  Initialize (xt,yt,zt), nnel and vel.
 4113:       //  For ics=2, the coordinates are in local frames
 4114:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4115: 
 4116: 
 4117:          const int iadvf = side->iadv();  // Advection flag
 4118: 
 4119:          Point3 xt;
 4120:          if constexpr(ics==1) {
 4121:             xt = side->center3D(k); 
 4122:          }
 4123:          else // lat/lon; in side lat/lon frame
 4124:          {
 4125:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4126:          // XXX IMPLEMENT THIS
 4127:       //          xt=0.d0
 4128:       //          yt=0.d0
 4129:       //          !centroid coord. for nudging
 4130:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4131:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4132:          }  // ics
 4133: 
 4134: 
 4135: 
 4136:          // If on land or open boundary...
 4137:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4138:          
 4139:          const double vmag = length(side->u2[k]);
 4140: 
 4141:          if (vmag <= velmin_btrack) {
 4142:             // No activity 
 4143: 
 4144:             side->btu[k] = side->u2[k];
 4145:             
 4146:          } else {  // do btrack
 4147: 
 4148:             // Compute number of sub-divisions based on local gradients 
 4149:             // XXX IS THIS NECESSARY?
 4150:             double suma = 0.0;
 4151:             int icount = 0;
 4152:             for (int ii=0; ii<2; ii++) {
 4153: 
 4154:                const Element *elem = side->elems[ii];
 4155:                  
 4156:                if (elem == nullptr) continue;
 4157: 
 4158:                icount++;
 4159: 
 4160:                // Not strictly along z; in ll frame for ics=2
 4161: 
 4162:                double utmp[4];
 4163:                double vtmp[4];
 4164:                for (int jj = 0; jj < elem->i34; jj++) {
 4165: 
 4166:                   const Node *node = elem->nodes[jj];
 4167: 
 4168:                   if constexpr(ics==1) {
 4169:                      utmp[jj] = node->u2[k].x;
 4170:                      vtmp[jj] = node->u2[k].y;  
 4171:                   } else {
 4172:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4173:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4174:                   }
 4175:                } // for jj
 4176: 
 4177:                const Vector2 grad_u = elem->grad2(utmp); 
 4178:                const Vector2 grad_v = elem->grad2(vtmp);
 4179: 
 4180:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4181:             } // for ii
 4182: 
 4183:             assert(icount > 0 && "Impossible 77");
 4184: 
 4185:             // '4' is somewhat arbitrary
 4186:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4187: 
 4188:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4189:          
 4190: 
 4191:             Vector3 u_int = {0.0, 0.0, 0.0};
 4192: 
 4193:             side->btrack(k, dt, dtbk, u_int);
 4194:             side->btu[k] = toVector2(u_int);
 4195:                
 4196:          } // if vmag (do backtrack)
 4197: 
 4198:       } // for k=kb,nvrt-1
 4199: 
 4200:    }
 4201: 
 4202: } // extern "C"
 4203: 
 4204: template<int nc>
 4205: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4206: 
 4207: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4208: //
 4209: // a,b,c,rhs: input vectors and are not modified by this program.
 4210: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4211: // rhs is the r.h.s.
 4212: // n: actual rank of the system.
 4213: // rows in u() and rhs();
 4214: // u: output with nc columns (transposed to rows)
 4215: // gam: a working array.
 4216: //
 4217: // NOTES:
 4218: // This is a template function that allows for different numbers of columns in the rhs vector.
 4219: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4220: 
 4221:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4222:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4223: 
 4224:    double bet = b[0];
 4225:    if constexpr (nc == 1) {
 4226:       u[0] = rhs[0]/bet;
 4227:    } else {
 4228:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4229:    }
 4230: 
 4231:    for (int j = 1; j < n; j++) {
 4232:       gam[j] = c[j - 1]/bet;
 4233:       bet = b[j] - a[j]*gam[j];
 4234: 
 4235:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4236: 
 4237:       if constexpr (nc == 1) {
 4238:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4239:       } else {
 4240:          for (int l = 0; l < nc; l++) {
 4241:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4242:          }
 4243:       }
 4244:    }
 4245: 
 4246:    // Back-substitution
 4247:    for (int j = n - 2; j >= 0; j--) {
 4248:       if constexpr (nc == 1) {
 4249:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4250:       } else {
 4251:          for (int l = 0; l < nc; l++) {
 4252:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4253:          }
 4254:       }
 4255:    }
 4256: }
 4257: 
 4258: 
 4259: 
 4260: // Helper function that contains the core algorithm
 4261: template<typename XAccessor, typename YAccessor>
 4262: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4263:                                     double  yp_top, double  yp_bot, 
 4264:                                     CubicSpline &spline) {
 4265:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4266:    // 
 4267:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4268:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4269:    //
 4270:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4271:    // 
 4272:    // Inputs: 
 4273:    //            n: dimension for x etc; # of data pts (>=2);
 4274:    //            getX, getY: functions to access x,y coordinates
 4275:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4276:    //     Output: 
 4277:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4278: 
 4279:    const int n = k2 - k1 + 1;
 4280:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4281: 
 4282:    // Allocate memory for the splines
 4283:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4284:    spline.x   = new double[n];
 4285:    spline.y   = new double[n];
 4286:    spline.yp  = new double[n];
 4287:    spline.ypp = new double[n];
 4288: 
 4289:    for (int k=k1; k<=k2; k++) {
 4290:       spline.x[k] = getX(k);
 4291:       spline.y[k] = getY(k);
 4292:    }
 4293: 
 4294:    // This is to simplify expressions later
 4295:    double *x = spline.x;
 4296:    double *y = spline.y;
 4297: 
 4298:    double *a = nullptr;
 4299:    double *b = nullptr;
 4300:    double *c = nullptr;
 4301:    double *gam = nullptr;
 4302:    double *rhs = nullptr;
 4303:    
 4304: 
 4305:       a = new double[n];   // Lower diagonal
 4306:       b = new double[n];   // Diagonal
 4307:       c = new double[n];   // Upper diagonal
 4308:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4309:       rhs = new double[n]; // Right-hand side
 4310: 
 4311:    for (int k=k1; k<=k2; k++) {
 4312:       if (k == k1) {
 4313:          // Bottom level
 4314:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4315:          b[k] = (x[k+1] - x[k])/3.0;
 4316:          c[k] = b[k]/2.0;
 4317:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4318:       } else if (k == n - 1) {
 4319:          // Top level (surface)
 4320:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4321:          b[k] = (x[k] - x[k-1])/3.0;
 4322:          a[k] = b[k]/2.0;
 4323:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4324:       } else {
 4325:          // Intermediate levels
 4326:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4327:          b[k] = (x[k+1] - x[k-1])/3.0;
 4328:          a[k] = (x[k  ] - x[k-1])/6.0;
 4329:          c[k] = (x[k+1] - x[k  ])/6.0;
 4330:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4331:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4332:       }
 4333:    }
 4334: 
 4335:    // Solve the tridiagonal system
 4336:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4337:    
 4338:    spline.yp[k1] = yp_bot;
 4339:    spline.yp[k2] = yp_top;
 4340: 
 4341:    // Compute rest of 1st derivatives using the splines
 4342:    for (int k=k1+1; k<k2; k++) {
 4343:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4344:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4345:    }
 4346:    
 4347:    delete[] a;
 4348:    delete[] b;
 4349:    delete[] c;
 4350:    delete[] gam;
 4351:    delete[] rhs;
 4352: 
 4353: }
 4354: 
 4355: // Array version
 4356: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4357:                                 double y_top, double y_bot, 
 4358:                                 CubicSpline &spline) {
 4359:    auto getX = [x] (int k) { return x[k]; };
 4360:    auto getY = [y] (int k) { return y[k]; };
 4361:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4362: }
 4363: 
 4364: // Lambda version - allows custom access patterns
 4365: template<typename XFunc, typename YFunc>
 4366: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4367:                                 double y_top, double y_bot,
 4368:                                 CubicSpline &spline) {
 4369:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4370: }
 4371: 
 4372: 
 4373: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4374: {
 4375:    assert("Not implemented");
 4376: 
 4377:    return 0.0;
 4378: }
 4379: 
 4380: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4381: // //     Routine to do vertical linear interpolation in z
 4382: // //     Inputs:
