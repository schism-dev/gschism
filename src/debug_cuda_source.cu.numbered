 7558: //                       adv_tr(jj)=adv_tr(jj)+tmp
 7559: //                       if (adv_tr(jj)<tr_min_max(1,jj) .or. adv_tr(jj)>tr_min_max(2,jj) ) then !reset to upwind
 7560: //                         adv_tr(jj)=adv_tr(jj)-tmp !reset to previous value
 7561: //                         if(ssign(j,i)*flux_adv_hface(k,jsj)<0.d0) then  !inflow 
 7562: //                           adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp_outside(jj)-trel_tmp(jj,k,i))
 7563: //                         endif
 7564: //                       endif
 7565: //                       !when ntd_weno=1, reduces to: adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*( ssign(j,i)*(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj)) )
 7566: //                     enddo
