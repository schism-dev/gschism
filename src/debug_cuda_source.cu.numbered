 1918: __device__ __inline__ double dotprod3(double* vec1, double* vec2) {
 1919:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2];
 1920: }
 1921: 
 1922: __device__ __inline__ double dotprod4(double* vec1, double* vec2) {
 1923:    return vec1[0]*vec2[0] + vec1[1]*vec2[1] + vec1[2]*vec2[2] + vec1[3]*vec2[3];
 1924: }   
 1925: 
 1926: __device__ __inline__ double min3(double a, double b, double c) {
 1927:    return min(a, min(b, c));
 1928: }
 1929: 
 1930: __device__ __inline__ double max3(double a, double b, double c) {
 1931:    return max(a, max(b, c));
 1932: }
 1933: 
 1934: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1935:    return min(a, min(b, min(c, d)));
 1936: }
