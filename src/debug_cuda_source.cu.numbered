 4321:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4322: 
 4323:       SIDE(side);
 4324: 
 4325: 
 4326:       side->U = {0.0, 0.0}; 
 4327:          
 4328:       if(side->isDry) return;
 4329: 
 4330:       const Node *node1 = side->n1;
 4331:       const Node *node2 = side->n2;
 4332: 
 4333:       // Vertically integrated velocity U (in ll if ics=2)
 4334:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4335:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4336:       }
 4337: 
 4338:    }
 4339: 
 4340:    __global__ void computeBottomDragVegetation(void) {
 4341:       // UNFINISHED. CHECK THIS:
 4342:       // How many kernels are needed? Why so many for loops?
 4343:       // Is the loop on sides needed?
 4344: 
 4345:       NODE(node);
 4346: 
 4347:       const int    kb      = node->kb;
 4348:       const double htot    = node->htot2();
 4349:       const double rough   = node->rough;
 4350: 
 4351: 
 4352:       if (node->isDry) {
 4353:          // Default values for dry nodes
 4354:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4355:          /// XXX CHECK INDICES
 4356:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4357:       }
 4358: 
 4359:       // Compute bottom drag Cd
 4360:       //--------------------------------
 4361: 
 4362:       // nchi = {-1, 0, 1} is the type of bottom drag.
 4363:       if (nchi==1) {
 4364: 
 4365:          bool ltmp = false; // for WBL iteration
 4366: 
 4367:          // Cdmax=-1 !max. Cd at node for this process (info only)
 4368:          // Drag at nodes
 4369:    /////////////////!$OMP   do reduction(max: iwbl_itmax) reduction(.or.: ltmp)
 4370:    // !        z0b_save(:) = 0.d0 ! Initialization of mixing length at bottom (z0b, T. Guerin) 
 4371:         
 4372:          const double rough = node->rough;
 4373:          assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 4374:          if (node->rough == 0.0) {
 4375:             node->Cd = 0.0;
 4376: 
 4377:          } else { //roughness >0 
 4378:             
 4379:             const double bthick_ori = node->z[kb + 1] - node->z[kb];  // thickness of bottom bnd layer
 4380:             const double bthick = max(dzb_min, bthick_ori);
 4381: 
 4382:             assert(bthick > 0.0 && "computeBottomDragVegetation: bthick <= 0");
 4383: 
 4384:             double tmp = 1.0/(2.5*log(bthick/rough));
 4385:             node->Cd = tmp*tmp;
 4386: 
 4387:          } // if rough
 4388: 
 4389: 
 4390:          // RECOVER THIS: XXX
 4391:          // if (it == iths_main + 1) log("Cd min/max at 1st step= ", minval(Cdp), maxval(Cdp));
 4392:          // Output warning for WBL if iteration didn't converge
 4393: 
 4394: 
 4395:       } // nchi==1
 4396: 
 4397:       //   Bottom stress in m^2/s^2
 4398:       if (node->rho[kb + 1] >= -98.0)
 4399:       {
 4400:          const double mag_u = length(toVector2(node->u2[kb + 1]));
 4401:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*toVector2(node->u2[kb + 1]); // units: kg/m/s^2 (Pa)
 4402:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4403:          // !sediment erosion: this part needs more documentation
 4404:       }
 4405: 
 4406:     
 4407:       // Compute vegetation parameters
 4408:       //--------------------------------
 4409: 
 4410:       // SAV constants
 4411:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4412:       constexpr double veg_cfpsi = 0.16;
 4413: 
 4414:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4415:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4416: 
 4417:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4418:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4419:          int kbin = 0; // bin index
 4420:          for (int k = kb; k < nvrt; k++) {
 4421:             // Computes node height above the bottom level
 4422:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4423:             assert(false && "Vertical variation of vegetation not implemented");
 4424: 
 4425:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4426:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4427:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4428:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4429:             // } else {
 4430:             //    // Find the bin at which the current vertical level is
 4431:             //    while (kbin<nbins_veg_vert) {
 4432:             //       const double zn = node->z[kbin];
 4433:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4434:             //          break;
 4435:             //       } // if
 4436:             //       kbin++;
 4437:             //    } // while
 4438:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4439: 
 4440:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4441:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4442:                
 4443:             //    // Linear interpolation of the vegetation parameters
 4444:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4445:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4446:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4447:             // } // if rl10
 4448: 
 4449:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4450: 
 4451:          } // for k
 4452: 
 4453: 
 4454:       } else { // Ganthy (iveg=2)
 4455:       //  Modify canopy height, diameter, and density
 4456: 
 4457:          // Make sure there is vegetation on this node
 4458:          if (node->veg_h_unbent > 0.0) {
 4459:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4460: 
 4461:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4462:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4463:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4464: 
 4465:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4466:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4467:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4468:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4469:          } // if veg_h_unbent
 4470: 
 4471:          for (int k = 0; k < nvrt; k++) {
 4472:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4473:          } // for k
 4474:       
 4475: 
 4476:       } // if iveg
 4477:      
 4478:          
 4479: 
 4480:       // Compute vertical mean of veg_alpha3D
 4481:       if (iveg != 0) {
 4482:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4483:          double sum1=0.0;
 4484:          double sum2=0.0;
 4485:          // Integrate over each level under the canopy...
 4486:          for (int k=kb; k<nvrt-1 && node->z[k+1] <= ztop; k++) { /// XXX CHECK INDICES
 4487:             const double Dz = node->Dz(k);
 4488: 
 4489:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k+1])*Dz;
 4490:             sum2 += Dz;
 4491: 
 4492:          } // for k
 4493: 
 4494:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4495:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4496: 
 4497:       } // if iveg
 4498: 
 4499:       printf("computeBottomDragVegetation: nodeIdx = %d, node->veg_alpha_vert_mean = %f\n", node->idx, node->veg_alpha_vert_mean);
 4500: 
 4501:    }
 4502: 
 4503:    __global__ void computeVegetationAndDragParameters(void) {
 4504:       // Computes the vegetation and drag model parameters:
 4505:       // chi, \tilde\chi, beta, \breve{H}
 4506:       
 4507:       SIDE(side);
 4508: 
 4509:       const double htot = side->htot2();
 4510:       const int    kb   = side->kb;
 4511: 
 4512:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4513: 
 4514:       const double veg_h     = side->veg_h();
 4515:       const double veg_nv    = side->veg_nv();
 4516:       const double veg_c     = side->veg_c();
 4517:       const double veg_beta  = side->veg_beta;
 4518:       const double veg_alpha = side->veg_alpha_vert_mean();
 4519: 
 4520:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4521:       // Velocity magnitude at the bottom level
 4522:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4523:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4524:       side->chi2 = side->Cd()*vmag1;
 4525:       side->chi  = side->chi2;
 4526:       if constexpr(iveg != 0) {
 4527:          const Node *n1 = side->n1;
 4528:          const Node *n2 = side->n2;
 4529:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4530:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4531:       }
 4532: 
 4533:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4534: 
 4535:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4536:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4537:       double magUa = 0.0;
 4538:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4539:          // 3D wet side with veg...
 4540: 
 4541:          double magUa = 0.0;
 4542:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4543:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4544: 
 4545:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4546:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4547:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4548: 
 4549:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4550:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4551: 
 4552:                // Velocity magnitude at the bottom (l) of the level
 4553:                const double ul = length(side->u2[k]);
 4554: 
 4555:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4556:                magUa += Dz*0.5*(uh + ul);
 4557: 
 4558:             } // if HasVegetation
 4559:          } // for k
 4560:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4561: 
 4562:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4563:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4564:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4565:             const double zCpy = side->zTopCanopy();
 4566:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4567:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4568:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4569:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4570:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4571:          } // if isSubmerged
 4572:       } // if iveg   
 4573: 
 4574:       // Computes the friction modified depth, \breve{H} in notes
 4575:       if (side->is2D()) { // 2D
 4576: 
 4577:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4578:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4579: 
 4580:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4581: 
 4582:          side->hhat = htot*htot/fricH; 
 4583: 
 4584:       } else { // 3D
 4585:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4586: 
 4587:          if constexpr(iveg != 0) {
 4588:             
 4589:             if (side->isSubmerged()) { 
 4590:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4591:                side->hhat -= veg_c*Hhat_alpha;
 4592: 
 4593:             } else { // Emergent
 4594:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4595:             }
 4596:          } // if iveg
 4597: 
 4598:          // Enforce positivity for 3D model
 4599:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 4600:       } // if 3D
 4601: 
 4602:       printf("computeVegetationAndDragParameters: sideIdx = %d, side->htot = %f, side->hhat = %f\n", side->idx, side->htot2(), side->hhat);
 4603: 
 4604:         
 4605:    }
 4606: 
 4607: 
 4608: 
 4609:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4610:    // Computes the density gradient between two elements, e1 and e2.
 4611:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4612:    // zero in the direction normal to the side. 
 4613:    // 
 4614:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4615:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4616:    //
 4617:    // Input:
 4618:    //    e1: Element
 4619:    //    e2: Neighbor element (or nullptr if boundary)
 4620:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4621:    //    k: Index of the half-level at which the density is interpolated
 4622:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4623:    // 
 4624:    // Output:
 4625:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4626:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4627: 
 4628:       if (e2 == nullptr || e2->isDry) {
 4629:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4630: 
 4631:          Side *side = e1->sides[j];
 4632:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4633:                  
 4634:          if constexpr(ics == 1) {
 4635:             vec = side->n; // Normal vector to the side
 4636:          } else {
 4637:             // IMPLEMENT THIS XXXXXX
 4638:             // !replace with xel, yel?
 4639:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4640:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4641:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4642:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4643:          } //ics
 4644:                    
 4645:          diffRho = 0.0;
 4646: 
 4647:       } else { //internal and wet
 4648:          if constexpr(ics==1) {
 4649:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4650: 
 4651:             // Vector from e1 to e2
 4652:             vec = toVector2(e2->center - e1->center);
 4653: 
 4654:          } else { 
 4655:             // IMPLEMENT THIS XXXXXX
 4656:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4657:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4658:             //                   alow(j)=xctr2
 4659:             //                   bdia(j)=yctr2
 4660:          } // ics
 4661: 
 4662:          diffRho = rho2 - e1->demeanedDensity(k);
 4663:       }
 4664: 
 4665:    }
 4666: 
 4667:    __global__ void computeDensityCubicSplines(void) {
 4668:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4669: 
 4670:       ELEM(elem);
 4671: 
 4672:       if (elem->isDry) return;
 4673: 
 4674:       const int kb = elem->kb;
 4675: 
 4676:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4677:       if (elem->is2D()) {
 4678:          // In the 2D case, the density is constant at the prism level. 
 4679:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4680:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4681:       } else { //3D
 4682: 
 4683:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4684:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4685:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4686:          ///// XXXX CHECK INDICES!!!!!
 4687:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4688:       } // 2D/3D
 4689: 
 4690:    }
 4691: } // extern "C"
 4692: 
 4693: 
 4694: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4695: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4696: 
 4697:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4698: 
 4699:    const int kb  = elem->kb;
 4700:    const int kb2 = elem2->kb;
 4701: 
 4702:    // z-coordinate of prism of elem
 4703:    const double zp = elem->z_prism(k);
 4704: 
 4705:    double rho = 0.0;
 4706: 
 4707:    if (elem2->is2D()) {
 4708:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4709: 
 4710:    } else {  // 3D
 4711: 
 4712:       // eta_min may be < zmax
 4713:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4714:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4715: 
 4716:       // (Extrapolate density below bottom, we will fix it later)
 4717:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4718:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4719:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4720:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4721:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4722:    } // 2D/3D
 4723:      
 4724: 
 4725:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4726:    // Now we need to fix it.
 4727:    if (elem->z[k] < elem2->z[kb2]) {
 4728:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4729: 
 4730:       // There are two methods to adjust the density at the bottom of the element.
 4731:       // iunder_deep=0: 
 4732:       const double depth1 = abs(elem->z[kb]); // larger depth
 4733: 
 4734:       if (iunder_deep==0) {
 4735: 
 4736:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4737: 
 4738:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4739: 
 4740:       } else { // iunder_deep != 0
 4741: 
 4742:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4743: 
 4744:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 4745: 
 4746:          //   Demeaned density at the same z coordinate as
 4747:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 4748:          }
 4749: 
 4750:       } // if iunder_deep
 4751:    } // if elem->z[kb] < elem2->z[kb]
 4752: 
 4753:    return rho;
 4754: }
 4755: 
 4756: 
 4757: extern "C" {
 4758:    __global__ void computeDensityGradient(void) {
 4759: 
 4760:          // Compute the horizontal density gradient at each element.
 4761:       // It works in two steps:
 4762:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4763:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4764:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4765:       //             gradRho.r1 = rho1 - rho0
 4766:       //             gradRho.r2 = rho2 - rho0
 4767:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4768:       // 
 4769:       //  NOTE: We use de-meaned densities.
 4770: 
 4771:       ELEM(elem);
 4772: 
 4773:       if (elem->isDry) return;
 4774: 
 4775:       const int kb  = elem->kb;
 4776:       const int i34 = elem->i34;
 4777: 
 4778:       for (int k = kb + 1; k < nvrt; k++) {
 4779:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 4780:          //             gradRho.r1 = rho1 - rho0
 4781:          //             gradRho.r2 = rho2 - rho0
 4782:          int icount = 0;
 4783:          double sumRx = 0.0;
 4784:          double sumRy = 0.0;
 4785:          for (int j1=0; j1<i34; j1++) { 
 4786: 
 4787:             const int j2 = elem->nxq(j1 + 1);
 4788: 
 4789:             // Pairs of consecutive neighbor elements of elem
 4790:             const Element *e1 = elem->nghbElems[j1];
 4791:             const Element *e2 = elem->nghbElems[j2];
 4792: 
 4793:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 4794:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 4795:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 4796: 
 4797:             // Compute the density difference and the vector from elem to e1 and e2
 4798:             // getRhoDiffAndVec takes into account boundaries/dry elements
 4799:             double diffRho1, diffRho2;
 4800:             Vector2 vec1, vec2;
 4801:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 4802:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 4803: 
 4804:             const double rl1 = length(vec1);
 4805:             const double rl2 = length(vec2);
 4806:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 4807: 
 4808:             const double delta = cross(vec1, vec2);
 4809:             const double sintheta = abs(delta)/(rl1*rl2);
 4810: 
 4811:             // To avoid problems, avoid elements with small angle between vectors
 4812:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 4813:             const bool validEq = (sintheta > sin_one_deg);
 4814: 
 4815:             if (validEq) {
 4816:                // Solve the system of equations to get the density gradient at elem
 4817:                icount++;
 4818:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 4819:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 4820:                sumRx += Rx;
 4821:                sumRy += Ry;
 4822:             }
 4823:          } // for j1
 4824: 
 4825:          // Compute the average density gradient at elem
 4826:          if (icount==0) {
 4827:            // Bad mesh quality; bail out with 0 b-cc
 4828:            elem->gradRho[k] = {0.0, 0.0};
 4829:          } else {
 4830:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 4831:          }
 4832: 
 4833:       } // for k
 4834: 
 4835:    }
 4836: 
 4837:    __global__ void computeBaroclinicTerm(void) {
 4838:    // Computes the baroclinic term at sides (at half levels).
 4839:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 4840:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 4841: 
 4842:       SIDE(side);
 4843: 
 4844:       if (side->isDry) return;
 4845: 
 4846:       const Element *e1 = side->elems[0];
 4847:       const Element *e2 = side->elems[1];      
 4848:       const int kb = side->kb;
 4849:       
 4850:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side has no elements");
 4851: 
 4852:       // interpolates vertically the density gradient of the two elements at the half level/
 4853: 
 4854:       // Starts the integration at the surface and goes down to the bottom
 4855:       int k1 = nvrt - 1;
 4856:       int k2 = nvrt - 1;
 4857: 
 4858:       side->bcc[nvrt-1] = {0.0, 0.0};
 4859:       for (int k = nvrt-2; k >= kb; k--) {
 4860:       // For each prism level (from surface to bottom)...
 4861: 
 4862:          // For both elements, interpolate density gradient at the side's half level.
 4863:          // The gradient at the side is the average of the gradients at the elements.
 4864:          // w1, w2 are used to take into account boundary sides, with just one element.
 4865:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 4866:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 4867:          const double wsum = w1 + w2;
 4868:          w1 = w1/wsum;
 4869:          w2 = w2/wsum;
 4870:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 4871: 
 4872:          // Linear interpolation of both elements' density gradient at the shared side's level.
 4873:          Vector2 gradRho = {0.0, 0.0};
 4874:          if (e1 != nullptr && k > kb) {
 4875:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 4876:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 4877:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 4878:             
 4879:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 4880:          }      
 4881:          if (e2 != nullptr && k > kb) {
 4882:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 4883:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 4884:             
 4885:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 4886:          }
 4887: 
 4888:          if constexpr(ics==2) {
 4889:             // IMPLEMENT THIS XXXXXX
 4890:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 4891:             // swild(1)=tmp1
 4892:             // swild(2)=tmp2
 4893:          }
 4894:          
 4895:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 4896:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 4897:          // CHECK INDICES!!! XXX
 4898:          const double grav3 = side->grav3();
 4899:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 4900: printf(">>>side->bcc[%d] = %e, %e, rampbc: %e, grav3: %e, rho0: %e, side->Dz(k + 1): %e, gradRho: %e, %e\n", k, side->bcc[k].x, side->bcc[k].y, rampbc, grav3, rho0, side->Dz(k + 1), gradRho.x, gradRho.y);
 4901: 
 4902:       } // for
 4903: 
 4904:    }
 4905: 
 4906: 
 4907: 
 4908:    __global__ void computeHorGradientAtSide(void) {
 4909: 
 4910:       // Compute the horizontal density gradient at each element.
 4911:       // It works in two steps:
 4912:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 4913:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 4914:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 4915:       //             gradRho.r1 = rho1 - rho0
 4916:       //             gradRho.r2 = rho2 - rho0
 4917:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 4918:       // 
 4919:       //  NOTE: We use de-meaned densities.
 4920: 
 4921:       SIDE(side);
 4922: 
 4923:       if (side->isDry) return;
 4924: 
 4925:       // Computes the gradient of the variables at the side center.
 4926:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 4927:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 4928:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 4929: 
 4930:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 4931:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 4932:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 4933:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 4934: 
 4935: 
 4936:       printf("gradEta1: %e, %e, gradEta2: %e, %e, gradETP: %e, %e, gradPr: %e, %e\n", 
 4937:          side->gradEta1.x, side->gradEta1.y, 
 4938:          side->gradEta2.x, side->gradEta2.y, 
 4939:          side->gradETP.x, side->gradETP.y, 
 4940:          side->gradPr.x, side->gradPr.y);
 4941: 
 4942: 
 4943:    }
 4944: 
 4945: 
 4946:    __global__ void solveMomentumEquations(double time) {
 4947: 
 4948:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 4949:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 4950: 
 4951:       SIDE(side);
 4952: 
 4953:       if (side->isDry) 
 4954:       {
 4955:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 4956: 
 4957:          return;
 4958:       }
 4959: 
 4960:       const Node *n1 = side->n1;
 4961:       const Node *n2 = side->n2;
 4962: 
 4963:       const int kb = side->kb;
 4964: 
 4965:       const double veg_h = side->veg_h();
 4966:       const double grav3 = side->grav3();
 4967: 
 4968: printf("###>>>#side->is2D() = %d\n", side->is2D());
 4969:       if (side->is2D()) {
 4970:          // Warning: Do not use htot2, which is updated.
 4971:          const double htot = side->htot1();
 4972:          const double hhat = side->hhat;
 4973: printf("htot: %e, hhat: %e\n", htot, hhat);
 4974:          assert(hhat > 0.0 && htot > 0.0 && "Impossible dry 55:");
 4975: 
 4976:          Vector2 tau2 = {0.0, 0.0};
 4977:           
 4978:          if constexpr(ics==1) {
 4979:             tau2 = side->tau();
 4980: 
 4981:          } else {
 4982:             assert(false && "Not implemented: ics == 2");
 4983:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 4984:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 4985:             // taux2=(vn1+tt1)*0.5d0
 4986:             // tauy2=(vn2+ss1)*0.5d0
 4987:          } // if ics         
 4988: 
 4989:          // hat_gam has units of m/s
 4990: 
 4991:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 4992: 
 4993: printf("coriolisTerm: %e, %e\n", coriolisTerm.x, coriolisTerm.y);
 4994: 
 4995:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 4996:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 4997: 
 4998:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 4999: 
 5000:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5001:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5002: 
 5003:          for (int k=0; k<nvrt; k++) side->u2[k] = {ux, uy};
 5004: 
 5005: printf("###>>>#side->u2[0] = %e, %e, side->u2[1] = %e, %e, hat_gam = %e, %e, hhat = %e, htot = %e\n", side->u2[0].x, side->u2[0].y, side->u2[1].x, side->u2[1].y, side->nuGradU[nvrt-1].x, side->nuGradU[nvrt-1].y, hhat, htot);
 5006: 
 5007:       }
 5008:       else { // 3D
 5009: 
 5010:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5011:          // 
 5012:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5013:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5014:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5015:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5016:          // k+1 and k.
 5017: 
 5018: 
 5019:          // // Define layer thickness & viscosity
 5020:          // for (int k=kb + 1; k<nvrt; k++) {
 5021:          //    const double dzz = side->Dz(k - 1);
 5022: 
 5023:          //    assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5024: 
 5025:          //    // Vertical viscosity at the face center
 5026:          //    dfz(k) = 0.25*(n1->dfv[k] + n2->dfv[k] + n1->dfv[k-1] + n2->dfv[k-1]);
 5027:         
 5028:          // }
 5029: 
 5030: 
 5031:          const int ndim = nvrt - kb;
 5032:          const double zTopCanopy = side->zTopCanopy();
 5033: 
 5034:          // Initialize the tridiagonal system
 5035:          for (int k = kb + 1; k<nvrt; k++) {
 5036:             
 5037:             const int kin = k - kb;
 5038: 
 5039:             // Vertical viscosity at the face center
 5040:             const double dfz = 0.25*(side->dfv(k) + side->dfv(k + 1));
 5041:             const double dzz = side->Dz(k);
 5042: 
 5043:             printf("k: %d, side->zc[0]: %e, side->n1->z[0]: %e, side->n2->z[0]: %e, dzz: %e, dfz: %e\n",k, side->zc[0], side->n1->z[0], side->n2->z[0], dzz, dfz);
 5044:             printf("k: %d, side->zc[1]: %e, side->n1->z[1]: %e, side->n2->z[1]: %e, dzz: %e, dfz: %e\n",k, side->zc[1], side->n1->z[1], side->n2->z[1], dzz, dfz);
 5045:             assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5046: 
 5047:             alow[kin] = 0.0;
 5048:             cupp[kin] = 0.0;
 5049:             bdia[kin] = 0.0;
 5050: 
 5051:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5052:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5053: 
 5054:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5055:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5056:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5057: 
 5058:             // First part: layers k, k+1
 5059:             if (k < nvrt - 1) {
 5060:                              
 5061:                if constexpr(iveg != 0) {
 5062: 
 5063:                   // If there is vegetation at this level...
 5064:                   if (zTopCanopy > side->zc[k]) {
 5065:                      // If the canopy is above the k layer...
 5066:                      
 5067:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5068:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5069:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5070:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5071: 
 5072:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5073:                      const double vmag2 = length(ut2);
 5074:                      const double vmag1 = length(side->u2[k]);
 5075:                      const double vmag = 0.5*(vmag1 + vmag2);
 5076:                      
 5077:                      // Computes the vegetation alpha at the face center
 5078:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5079: 
 5080:                      cff1 += veg_alpha_sd*dt*vmag;
 5081: 
 5082:                   } // if (zTopCanopy
 5083:                } // if iveg
 5084: 
 5085:                const double tmp = dt*dfz/dzz;
 5086:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5087:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5088: printf("####cff1 = %f, dzz = %f, tmp = %f, cupp[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, cupp[kin], kin, bdia[kin]);               
 5089:             }
 5090: 
 5091: 
 5092:             // Second part: layers k-1, k
 5093:             if (k > kb + 1) {
 5094: 
 5095:                double cff1 = 1.0; //init \bar{c^k}
 5096: 
 5097:                if constexpr(iveg != 0) {
 5098:                   // If there is vegetation at this level...
 5099:                   if (zTopCanopy > side->zc[k-1]) {
 5100:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5101:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5102: 
 5103:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5104: 
 5105:                      const double vmag2 = length(ut2);
 5106:                      const double vmag1 = length(side->u2[k-1]);
 5107:                      const double vmag = 0.5*(vmag1 + vmag2);
 5108: 
 5109:                      // Computes the vegetation alpha at the face center
 5110:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5111:                      cff1 += veg_alpha_sd*dt*vmag;
 5112:                   } // if zTopCanopy
 5113: 
 5114:                } // if iveg
 5115: 
 5116:                const double tmp = dt*dfz/dzz;
 5117:                alow[kin] += cff1*dzz/6.0 - tmp;
 5118:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5119: printf("####cff1 = %f, dzz = %f, tmp = %f, alow[%d] = %f, bdia[%d] = %f\n", cff1, dzz, tmp, alow[kin], kin, bdia[kin]);               
 5120:             } else { // Bottom boundary
 5121:                // This occurs at the bottom, where the bottom drag is applied.
 5122: 
 5123:                bdia[kin] += dt*side->chi2;
 5124: printf("####3 k = %d, kb + 1 = %d, nvrt - 1 = %d, chi2 = %f, alow[%d] = %f, bdia[%d] = %f\n", k, kb + 1, nvrt - 1, side->chi2, kin, alow[kin], kin, bdia[kin]);               
 5125:             } // if (k > kb + 1)
 5126: 
 5127: 
 5128: 
 5129:          } // for (int k
 5130: 
 5131: 
 5132: 
 5133:          // Computes the RHS.
 5134:          // -----------------
 5135: 
 5136:          //	BC to be imposed at the end.
 5137: 
 5138:          const Vector2 gradETP  = side->gradETP;
 5139:          const Vector2 gradPr   = side->gradPr;
 5140:          const Vector2 gradEta1 = side->gradEta1;
 5141:          const Vector2 gradEta2 = side->gradEta2;
 5142: 
 5143:          const Vector2 *btu = side->btu;
 5144:          const Vector2 *u2  = side->u2;
 5145:          const double coriolis = side->coriolis;
 5146:          const Vector2 *nuGradU = side->nuGradU;
 5147: 
 5148: 
 5149:          for (int k = kb + 1; k<nvrt; k++) {
 5150:             const int kin = k - kb;
 5151: 
 5152:             const double dz_0 = side->Dz(k);
 5153:             const double dz_1 = side->Dz(k+1);  
 5154: 
 5155:             rrhs[kin] = {0.0, 0.0};
 5156:             double dz = 0.0;
 5157: 
 5158:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5159:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5160:             if (k < nvrt  ) dz += 0.5*dz_1;
 5161:             if (k > kb + 1) dz += 0.5*dz_0;
 5162: 
 5163:             // Elevation gradient, atmospheric pressure and tidal potential
 5164:             rrhs[kin] = -dz*dt*(grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0);
 5165: 
 5166:             // Coriolis, advection, wind stress, and horizontal viscosity
 5167:             if (k < nvrt - 1) {
 5168: 
 5169: 
 5170:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5171:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5172:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5173: 
 5174:                //diff stress tensors 1006
 5175:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5176:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5177:                   assert(false && "Not implemented: itur == 5");
 5178:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5179:                }
 5180: 
 5181:             } else { // k=nvrt
 5182:                Vector2 tau2 = {0.0, 0.0};
 5183:                if constexpr(ics==1) {
 5184:                   tau2 = side->tau();
 5185:                } else {
 5186:                   assert(false && "Not implemented: ics == 2");
 5187:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5188:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5189:                   // taux2=(vn1+tt1)*0.5d0
 5190:                   // tauy2=(vn2+ss1)*0.5d0
 5191:                } // if ics
 5192: 
 5193:                rrhs[kin] += dt*tau2;
 5194: 
 5195:             } // if k<nvrt
 5196: 
 5197:             if (k > kb + 1) {
 5198:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5199:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5200:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5201: 
 5202: 
 5203:                // diff stress tensors 1006
 5204:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5205:                   assert(false && "Not implemented: itur == 5");
 5206:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5207:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5208:                }
 5209: 
 5210:             } // if k>kbs + 1
 5211: 
 5212:             // Baroclinic
 5213:             Vector2 *bcc = side->bcc;
 5214:             if constexpr(ibc == 0) {
 5215:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5216:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5217: 
 5218:             } // if ibc==0
 5219: 
 5220: 
 5221:          } // k=kb + 1,nvrt
 5222: 
 5223: printf("#### bdia[0] = %f, bdia[1] = %f, bdia[2] = %f, bdia[3] = %f\n", bdia[0], bdia[1], bdia[2], bdia[3]);         
 5224:    // tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 5225:          tridag_sch<2>(nvrt, alow, bdia, cupp, (double *)rrhs, (double *)u, (double *)gam);
 5226: printf("::: u[0] = %e, u[1] = %e, u[2] = %e, u[3] = %e\n", u[0], u[1], u[2], u[3]);
 5227: 
 5228: 
 5229:          for (int k=kb + 1; k<nvrt; k++) {
 5230:             const int kin = k - kb;
 5231: 
 5232:             // Velocity is always clamped to maximum values
 5233:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5234:          } // k
 5235: 
 5236:       } // if side->is2D()
 5237:       
 5238: 
 5239:       // Impose velocity boundary condition at the bottom
 5240:       if constexpr(imm == 2) { // 3D bed deformation model
 5241:          double dep;
 5242:          Vector2 vel;
 5243: 
 5244:          assert(false && "Not implemented: imm == 2");
 5245:          //update_bdef(time, x0, y0, dep, vel);
 5246:          // side->u2[kb] = vel;
 5247: 
 5248:       } else { // imm = 0 or 1
 5249:          if (side->Cd() == 0.0) {
 5250:             side->u2[kb] = side->u2[kb + 1];
 5251:          } else if (nvrt - 1 > kb + 1) { // 3D no slip bottom
 5252:             side->u2[kb] = {0.0, 0.0};
 5253:          }
 5254:           
 5255:       } // if imm
 5256: 
 5257:       // The velocities below the bottom level are set to zero
 5258:       for (int k=0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5259: 
 5260: 
 5261:    }
 5262: 
 5263: 
 5264:    __global__ void applyMomentumBC(void) {
 5265: 
 5266:       SIDE_BND(sideBnd);
 5267: 
 5268:       Side *side = sideBnd->side;
 5269:       const BoundarySegment *segment = sideBnd->segment;
 5270:       const Node *n1 = side->n1;
 5271:       const Node *n2 = side->n2;
 5272: 
 5273:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5274: 
 5275:       // REMEMEBER, this is a trick, segment can be a pointer or (-1, -2)
 5276:       const bool isLand = segment->isLand;
 5277:       const int ifltype = segment->ifltype;
 5278: 
 5279:       const int kb = side->kb;
 5280: 
 5281: printf("ifltype = %d, isLand = %d, segment = %d, ubc = %e,%e\n", ifltype, segment->isLand, segment, sideBnd->ubc[kb].x, sideBnd->ubc[kb].y);    
 5282:       if (!isLand && ifltype != 0) {
 5283:          const Vector2 *ubc = sideBnd->ubc;
 5284:   
 5285:          for (int k=kb; k < nvrt; k++) {
 5286:             
 5287:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5288:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5289: 
 5290:             if (ifltype == -1) {
 5291:                // Flather 1
 5292: 
 5293:                const double depth = side->depth();
 5294: 
 5295:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5296: 
 5297:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5298: 
 5299:                side->u2[k] = vnorm*side->n;
 5300: 
 5301:             } else if (ifltype == -2) { // Discharge
 5302: 
 5303:                const double eta1 = side->eta1();
 5304:                const double eta2 = side->eta2();
 5305:                const double htot = side->htot2();
 5306: 
 5307:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5308:                assert(false && "Not implemented: Discharge bc");
 5309:                // const double dischrg = discharge(eta1);
 5310:                const double dischrg = 0.0; // XXX REMOVE
 5311:                
 5312: 
 5313:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5314: 
 5315:                const double vnorm = dischrg*eta2/htot;
 5316: 
 5317:                side->u2[k] = vnorm*side->n;
 5318: 
 5319: 
 5320:             }
 5321:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5322:                const double vnorm = dot(side->u2[k], side->n);
 5323: 
 5324:                double rat;
 5325:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5326:                else              rat = segment->vobc2; // outgoing
 5327: 
 5328:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5329:             }
 5330:             else { // not Flather or 3D radiation
 5331:                side->u2[k] = ubc[k];
 5332: printf("****** idx = %d, k = %d, side->idx = %d, ubc = %e,%e\n", side->idx, k, side->idx, ubc[k].x, ubc[k].y);               
 5333: 
 5334:             } // if (segment->ifltype...
 5335: 
 5336:          }
 5337: 
 5338:       }
 5339:       else if (isLand) { // if it is land boundary side
 5340: 
 5341:          if constexpr(islip == 0) { // free slip
 5342:             for (int k=kb; k < nvrt; k++) {
 5343:                double vnorm = 0.0; // for most cases
 5344:                const double vtan = dot(side->u2[k], side->t());
 5345:                const Vector2 t = side->t();
 5346:                const Vector2 n = side->n;
 5347: printf("islip   = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);      
 5348:                side->u2[k] = vtan*t - vnorm*n;
 5349: printf("islipXX = %d, k = %d, side->idx = %d, u2 = %f,%f, vtan*t - vnorm*n = %f,%f\n", islip, k, side->idx, side->u2[k].x, side->u2[k].y, (vtan*t - vnorm*n).x, (vtan*t - vnorm*n).y);                     
 5350:             }
 5351: 
 5352:          } else { // no slip
 5353:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5354: 
 5355:          }
 5356:       } // if (side segment type...
 5357: 
 5358:    
 5359: 
 5360:    }
 5361: 
 5362: 
 5363:    __global__ void shapiroFilter1(void) {
 5364:       // First step of the Shapiro filter (normally used if indvel<=0)
 5365:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5366: 
 5367:       SIDE(side);
 5368: 
 5369:       // Only internal wet sides are processed
 5370:       if (side->isDry || !(side->isInternal())) return;
 5371: 
 5372:       const int kb = side->kb;
 5373: 
 5374:       for (int mm = 1; mm <= niter_shap; mm++) {
 5375: 
 5376:          for (int k = kb + 1; k < nvrt; k++) {
 5377:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5378:             side->bcc[k] = {0.0, 0.0};
 5379:             Vector2 suru = {0.0, 0.0};
 5380: 
 5381:             for (int j=0; j<4; j++) { // 4 neighbors per side
 5382: 
 5383:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5384: printf("idx = %d, j = %d,nSide->idx = %d, nSide->u2[k] = %e,%e\n", side->idx, j, nSide->idx, nSide->u2[k].x, nSide->u2[k].y);
 5385: 
 5386:                int kin = k;
 5387:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5388:                
 5389:                if constexpr(ics==1) {
 5390:                   suru += nSide->u2[kin];
 5391: 
 5392:                } else {
 5393:                   assert(false && "Not implemented: ics == 2");
 5394:                   // Vector2 vn1, vn2;
 5395:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5396:                   // suru=suru+vn1;
 5397:                   // surv=surv+vn2;
 5398:                }
 5399:             }
 5400: 
 5401: 
 5402:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5403: printf("NNNN idx = %d, suru = %f,%f, side->u2[k] = %f,%f, side->bcc[k] = %f,%f\n", side->idx, suru.x, suru.y, side->u2[k].x, side->u2[k].y, side->bcc[k].x, side->bcc[k].y);            
 5404: 
 5405:          }
 5406:       }
 5407:    }
 5408: 
 5409:    __global__ void shapiroFilter2(void) {
 5410:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5411: 
 5412:       SIDE(side);
 5413: 
 5414:       if (side->isDry || !(side->isInternal())) return;
 5415: 
 5416:       const int kb = side->kb;
 5417: 
 5418:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5419: 
 5420:       if (side->is2D()) {
 5421:          // side->u2[kb] = side->u2[nvrt - 1];
 5422:          side->u2[kb + 1] = side->bcc[kb + 1];
 5423:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5424: 
 5425:       } else {
 5426:          // 3D
 5427:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5428:          
 5429:       }
 5430: 
 5431:    }
 5432: 
 5433: 
 5434:    __global__ void ul0UpdateZCoords(void) {
 5435:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5436:       
 5437:       NODE(node);      
 5438: 
 5439:       if (node->isDry2()) { 
 5440: 
 5441:          assert((ivcor != 2) && (node->depth < mesh->h_s) && "Deep depth dry");
 5442: 
 5443:          if constexpr(ivcor != 1) node->kb = 0;
 5444: 
 5445:       } else {
 5446: 
 5447:          node->updateKb();
 5448:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5449: for (int k = node->kb; k < nvrt; k++) printf("k = %d, node->kb = %d, node->z[k] = %f\n", k, node->kb, node->z[k]);
 5450: 
 5451:       } // if wet or dry
 5452: 
 5453:       // We use the temp.b field to store the previous state of isDry.
 5454:       node->tmp.b = node->isDry;
 5455: 
 5456:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5457:       node->isDry = true;
 5458: 
 5459:    }
 5460: 
 5461:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5462:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5463:    {
 5464:       ELEM(elem);
 5465: 
 5466:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5467: 
 5468:       // All the nodes of a wet element are wet.
 5469:       if (!elem->isDry) {
 5470:          elem->nodes[0]->isDry = false;
 5471:          elem->nodes[1]->isDry = false;
 5472:          elem->nodes[2]->isDry = false;
 5473:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5474: 
 5475:       }
 5476: 
 5477: 
 5478:       elem->kb = 0;
 5479: 
 5480:       if (elem->isDry) return;
 5481: 
 5482:       // Wet
 5483:       const Node *n1 = elem->nodes[0];
 5484:       const Node *n2 = elem->nodes[1];
 5485:       const Node *n3 = elem->nodes[2];  
 5486:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5487: 
 5488:    //    if(elem->isDry2()) {
 5489:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5490:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5491:    //        call parallel_abort(errmsg)
 5492:    //    }
 5493: 
 5494: 
 5495:       // Computes element's kb as the minimum of the nodes' kb.
 5496:       const int kb1 = n1->kb;
 5497:       const int kb2 = n2->kb;
 5498:       const int kb3 = n3->kb;
 5499:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5500: 
 5501: printf("kb1 = %d, kb2 = %d, kb3 = %d, kb4 = %d\n", kb1, kb2, kb3, kb4);
 5502: 
 5503:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5504: 
 5505: 
 5506:       // Computes the element z as the mean of the nodes z.
 5507:       for (int k = elem->kb; k < nvrt; k++) {
 5508: 
 5509:          // Compute the element z as the mean of the nodes z.
 5510:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5511:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5512:          elem->z[k] /= elem->i34;
 5513: 
 5514:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5515:       }
 5516:                   
 5517:    }
 5518: 
 5519:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5520:    {
 5521:       NODE(node);
 5522:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5523: 
 5524:       if (it == iths) return;
 5525: 
 5526: 
 5527:       if(!node->isDry && node->tmp.b) { // rewetted
 5528:          for (int k=0; k < nvrt; k++) {
 5529: 
 5530:             Vector3 utmp={0.0, 0.0, 0.0};
 5531: 
 5532:             double ttmp=0.0;
 5533:             double stmp=0.0;
 5534:             int icount=0;
 5535:             for (int j = 0; j < node->numNodes; j++) {
 5536: 
 5537: 
 5538:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5539:                if (!node->isDry) { // all indices extended
 5540:                   icount++;
 5541: 
 5542:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5543:                   utmp += node->u2[k];
 5544:                   
 5545:                   ttmp += node->tracers[k].tracer[0]; 
 5546:                   stmp += node->tracers[k].tracer[1]; 
 5547:                }
 5548:             }
 5549: 
 5550:             if(icount > 0) {
 5551:                const double inv_icount = 1.0/icount;
 5552:                node->u2[k]     = inv_icount*utmp;
 5553:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5554:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5555:             }
 5556:          }
 5557:       }
 5558:    }
 5559: 
 5560: 
 5561:    __global__ void ul0UpdateSides(int it, int iths) {
 5562: 
 5563:       SIDE(side);
 5564: 
 5565:       // A side is wet if and only if at least one of its elements is wet.
 5566:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5567: 
 5568:       const Node *n1 = side->n1;
 5569:       const Node *n2 = side->n2;
 5570:       const int kb1 = n1->kb;
 5571:       const int kb2 = n2->kb;
 5572: 
 5573:       side->kb = 0; // dry
 5574: 
 5575:       if (isWet) {
 5576: 
 5577:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5578: 
 5579:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5580: 
 5581:          side->kb = min(kb1, kb2);
 5582: 
 5583:          for (int k = side->kb; k < nvrt; k++) {
 5584:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5585: 
 5586:          
 5587:             assert((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0) && "Weird side (3)");
 5588: 
 5589:             // Compute velocity for re-wetted sides 
 5590:             if ((it != iths) && (side->isDry && isWet)) {
 5591:             
 5592:                Vector2 utmp={0.0, 0.0};
 5593: 
 5594:                int icount=0;
 5595: 
 5596:                // For all the sides on the two elements that share this side
 5597:                for (int j=0; j < 2; j++) {
 5598:                   const Element *elem = side->elems[j];
 5599:                   if (elem == nullptr) continue;
 5600: 
 5601:                   for (int jj=0; jj < elem->i34; jj++) {
 5602:                      const Side *nSide = elem->sides[jj];
 5603:                      if (nSide->isDry) continue;
 5604: 
 5605:                      icount++;
 5606:                      utmp += nSide->u2[k];                     
 5607:                   }
 5608:                }
 5609:                   
 5610:                assert(icount > 0 && "No wet sides around this side");
 5611:                if (icount > 0)  side->u2[k] = utmp/icount;
 5612:                   
 5613:             } // if ((it != iths) && (side->isDry && isWet))
 5614: 
 5615:          } // for k
 5616: 
 5617:       } // if isWet
 5618:    
 5619:       side->isDry = !isWet;
 5620: 
 5621:    }
 5622: 
