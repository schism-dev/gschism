 1866:    template<typename T>
 1867:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 1868:       // Get the values of the field at the nodes of the element
 1869:       res[0] = nodes[0]->*field;
 1870:       res[1] = nodes[1]->*field;
 1871:       res[2] = nodes[2]->*field;
 1872:       if (isQuad()) res[3] = nodes[3]->*field;
 1873:       else          res[3] = T();
 1874:    }
 1875: 
 1876:    template<typename T>
 1877:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 1878:       // Get the values of the field at the nodes of the element
 1879:       res[0] = (nodes[0]->*field)[level];
 1880:       res[1] = (nodes[1]->*field)[level];
 1881:       res[2] = (nodes[2]->*field)[level];
 1882:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
 1883:       else          res[3] = T();
 1884:    }    
 1885: 
 1886:    template<typename T>
 1887:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 1888:       // Get the values of the func at the nodes of the element
 1889:       res[0] = (nodes[0]->*func)(level);
 1890:       res[1] = (nodes[1]->*func)(level);
 1891:       res[2] = (nodes[2]->*func)(level);
 1892:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
 1893:       else          res[3] = T();  // This is 0.0 or a zero vector
 1894: 
 1895:    }      
