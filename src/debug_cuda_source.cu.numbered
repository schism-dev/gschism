  239: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  240:     return make_double2(v.x * s, v.y * s);
  241: }
  242: 
  243: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  244:     return v * s;  // reuse the previous operator
  245: }
  246: 
  247: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  248:     return make_double2(v.x / s, v.y / s);
  249: }
  250: 
  251: __device__ __forceinline__ double norm2(const double2& v) {
  252:     return v.x*v.x + v.y*v.y;
  253: }
  254: 
  255: __device__ __forceinline__ double length(const double2& v) {
  256:     return sqrt(v.x*v.x + v.y*v.y);
  257: }
  258: 
  259: __device__ __forceinline__ double2 normalize(const double2& v) {
  260:     return v / length(v);
  261: }
  262: 
  263: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  264:     return v.x*w.x + v.y*w.y;
  265: }
  266: 
  267: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  268:     return v.x*w.y - v.y*w.x;
  269: }
  270: 
  271: __device__ __forceinline__ double2 rot90(const double2& a) {
