  808: 
  809: // ----------------------------- Frames -----------------------------
  810: 
  811: // Frames are used to transform vectors between different coordinate systems.
  812: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  813: template<int ICS>
  814: struct Frame {};
  815: 
  816: template<>
  817: struct Frame<1> {
  818:    __forceinline__ __device__ void update(double, double) {}
  819:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  820:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  821:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  822:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  823:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  824:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  825: };
  826: 
  827: template<>
  828: struct Frame<2> {
  829:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  830:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  831:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  832:     double t00, t10;        // col0 (t20=0 implicit)
  833:     double t01, t11, t21;   // col1
  834: 
  835:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  836: 
  837:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  838:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  839: 
  840:       double sin_lon, cos_lon, sin_lat, cos_lat;
  841:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  842:       sincos(lat, &sin_lat, &cos_lat);
  843: 
  844:       t00 = -sin_lon;
  845:       t10 =  cos_lon;
  846:       t01 = -cos_lon*sin_lat;
  847:       t11 = -sin_lon*sin_lat;
  848:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  849: 
  850:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  851:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  852: 
  853:       const double col1_norm_inv = 1.0/col1_norm;
  854:       t01 = t01*col1_norm_inv;
  855:       t11 = t11*col1_norm_inv;
  856:       t21 = t21*col1_norm_inv;
  857: 
  858:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  859: 
  860: 
  861:    }
  862: 
  863:    __forceinline__ __device__ void print(void) const {
  864:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  865:    }
  866: 
  867:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  868:       // cross(col0, col1), with t20=0 implicitly:
  869:       // |  i       j       k   |
  870:       // | t00     t10      0   |
  871:       // | t01     t11     t21  |
  872:       t02 =  t10*t21;
  873:       t12 = -t00*t21;
  874:       t22 =  t00*t11 - t10*t01;
  875:    }
  876: 
  877: 
  878:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  879:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  880:    // Inputs:
  881:    //        vec0: vel. in this frame;
  882:    //        frameout: Output frame;
  883:    // Output: 
  884:    //        vel. in new frame  
  885:    //
  886:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  887:    // discarding the z-component of the result to keep only the local horizontal
  888:    // plane of frame 2.
  889:    //
  890:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  891:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  892:    // are orthogonal. This product is computed as dot products between columns of
  893:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  894:    // columns of F2.// 
  895: 
  896:       auto const fo = frameout; // Just an alias for the output frame.
  897:       Vector2 res;
  898: 
  899:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  900:       // of t and fo.t are the same.
  901:       const double d00 = t00*fo.t00 + t10*fo.t10;
  902:       const double d10 = t01*fo.t00 + t11*fo.t10;
  903: 
  904:       const double d01 = t00*fo.t01 + t10*fo.t11;
  905:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  906: 
  907:       res.x = vec0.x * d00 + vec0.y * d10;
  908:       res.y = vec0.x * d01 + vec0.y * d11;
  909: 
  910:       return res;
  911:    }
  912: 
  913:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  914:       Vector3 vo;
  915:       double t02, t12, t22;
  916: 
  917:       // Compute the 3rd column of the frame tensor
  918:       getCol2(t02, t12, t22);
  919: 
  920:       vo.x = vi.x*t00 + vi.y*t10;
  921:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  922:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  923: 
  924:       return vo;
  925:    
  926:    }
  927: 
  928:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  929:       Vector3 vo;
  930:       double t02, t12, t22;
  931: 
  932:    // Compute the 3rd column of the frame tensor
  933:       getCol2(t02, t12, t22);
  934: 
  935:       // F * vi (non-transposed, so we use rows of F)
  936:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  937:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  938:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  939: 
  940:       return vo;
  941:    }
  942: 
  943:    // Unit vectors that define the local frame
  944:    __forceinline__ __device__ Vector3 nUp(void) const {
  945:       // Column 2 = cross(column0, column1)
  946:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  947:    }
  948: 
  949:    __forceinline__ __device__ Vector3 nZonal(void) const {
  950:       // Column 0
  951:       return { t00, t10, 0.0 };
  952:    }
  953: 
  954:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  955:       // Column 1
  956:       return { t01, t11, t21 };
  957:    }
  958: 
  959: };
