 8409:    SIDE(side);
 8410: 
 8411:    switch (varCode) {
 8412:       case (int)VarCode::outputCoords:
 8413:          const Point2 coords = side->outputCoords();
 8414:          res[side->idx*2    ] = coords.x;
 8415:          res[side->idx*2 + 1] = coords.y;
 8416:          break;
 8417:    }
 8418: }
