 4334: extern "C" {
 4335: 
 4336:    __global__ void scaleGravity(double loadtide_coef) {
 4337: 
 4338: 
 4339:       NODE(node);
 4340: 
 4341:       // SAL option: scale gravity
 4342:       if constexpr(iloadtide==2) {  // simple const
 4343:          node->grav2 = grav*(1.0 - loadtide_coef);
 4344: 
 4345:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4346:         
 4347:           const double depth = max(node->depth, 0.0);
 4348:           const double tmp1 = sqrt(depth);
 4349:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4350:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4351:                              2.6969e-13*depth*depth*depth*tmp1;
 4352:           
 4353:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4354:           
 4355: 
 4356: 
 4357:           node->grav2 = grav*(1.0 - beta_bar);
 4358: 
 4359:       } else {  // iloadtide=0,1
 4360:         node->grav2=grav;
 4361: 
 4362:       }
 4363: 
 4364:    }
 4365: 
 4366: 
 4367:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4368: 
 4369:       NODE_BND(nodeBnd);
 4370: 
 4371:       Node *node = nodeBnd->node;
 4372: 
 4373:       node->ETP = 0.0;
 4374: 
 4375:       for (int j=0; j<ntip; j++) {
 4376: 
 4377:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4378:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4379:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4380: 
 4381:          if constexpr(iloadtide==1) { // loading tide
 4382:             assert(false && "Loading tide not implemented");
 4383:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4384:          }
 4385:          
 4386:       }
 4387:       
 4388:    }
