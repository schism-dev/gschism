  954: struct Side {
  955: 
  956:    // Geometry information
  957:    int idx;               // Index of the side
  958:    Node *n1, *n2;
  959:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  960: 
  961:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  962:    Vector2 center;        // Location of side center. 
  963:    double zc[nvrt];       // Side center z-coord at each vertical level
  964: 
  965:    Frame frame;
  966: 
  967:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  968:                           // this is nullptr
  969:    
  970:    int kb;                // Bottom index of the side
  971:    bool isDry;            // True if the side is dry
  972:  
  973:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  974: 
  975:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  976: 
  977:    // Physical information
  978:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  979:    double  w2[nvrt];            // Vertical velocity at each vertical level
  980:    Vector2 btu[nvrt];           // Back-tracked velocity
  981:    Vector2 U;                   // Vertically averaged velocity vector  
  982: 
  983:    Vector2 nuGradU[nvrt];          // nu*grad u
  984: 
  985:    Vector2 bcc[nvrt];           // Baroclinic term
  986:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  987: 
  988:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  989:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  990:    Vector2 gradPr;               // Gradient of pressure
  991:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  992: 
  993: 
  994:    double hhat;                 // \breve{H} in notes
  995: 
  996:    double shapiro;
  997: 
  998:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  999: 
 1000:    double coriolis;             // Coriolis parameter
 1001: 
 1002:    // Vegetation parameters
 1003:    double veg_c2;
 1004:    double veg_beta;
 1005: 
 1006:    // Bottom drag parameters.
 1007:    double chi;
 1008:    double chi2;
 1009: 
 1010:    __inline__ __device__ double x(double t) const;
 1011:    __inline__ __device__ double y(double t) const;
 1012:    __inline__ __device__ double lon(void) const;
 1013:    __inline__ __device__ double lat(void) const;
 1014:    __inline__ __device__ Point2 p_t(double t) const;
 1015: 
 1016:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1017:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
 1018:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1019:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1020: 
 1021:    __inline__ __device__ Side* neigh(int index) const { 
 1022:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1023:       assert(index >= 0 && index < 4); 
 1024:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1025: 
 1026:       const int ielem = index & 1;           // 0 or 1
 1027:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1028: 
 1029:       const Element* elem = elems[ielem];
 1030: 
 1031:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1032: 
 1033:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1034: 
 1035:    }
 1036: 
 1037:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1038: 
 1039:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1040: 
 1041:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1042:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1043:    __inline__ __device__ int iadv(void) const;
 1044: 
 1045:    __inline__ __device__ double grav3(void) const;
 1046:    
 1047:    __inline__ __device__ double eta2(void) const;
 1048:    __inline__ __device__ double eta1(void) const;
 1049:    __inline__ __device__ double depth(void) const;
 1050:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1051:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1052: 
 1053:    __inline__ __device__ double dfv(int k) const;
 1054: 
 1055:    __inline__ __device__ double veg_h(void)  const;
 1056:    __inline__ __device__ double veg_nv(void) const;
 1057:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1058:    __inline__ __device__ double veg_alpha3D(int k) const;
 1059:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1060: 
 1061:    __inline__ __device__ double Cd(void) const;
 1062: 
 1063:    __inline__ __device__ Vector2 tau(void) const;
 1064: 
 1065:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1066:    
 1067: 
 1068:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1069:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1070:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1071:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1072:    } 
 1073:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1074:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1075:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1076:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1077: 
 1078:    // Get valid starting element (for backtracking)
 1079:    __inline__ __device__ Element* getStartElement() {
 1080:       return elems[0] ? elems[0] : elems[1];
 1081:    }
 1082: 
 1083:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1084:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1085: 
 1086:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1087: 
 1088:       // Dot product of the negative velocity vector with the side normal vector
 1089:       const double dot_prod1 = -dot(u, n);
 1090: 
 1091:       // Vector from side center to element 0 centroid
 1092:       const Vector2 v2 = elems[0]->center - center;
 1093: 
 1094:       // Dot product of the vector with the side normal vector
 1095:       const double dot_prod2 = dot(v2, n);
 1096: 
 1097:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1098:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1099: 
 1100:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1101:       else                           return elems[1];
 1102: 
 1103:  
 1104:    }
 1105: 
 1106:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1107:       // Given an element, returns the other element that shares this side
 1108:       return (elems[0] == elem) ? elems[1] : elems[0];
 1109:    }
 1110: 
 1111:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1112:       // Given a node, returns the other node that shares this side
 1113:       return (n1 == node) ? n2 : n1;
 1114:    }
 1115:  
 1116:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1117: 
 1118: 
 1119: 
 1120: 
 1121: };
