 3141: 
 3142: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3143:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3144:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3145:    // 
 3146:    // This kernel is called for all nodes.
 3147: 
 3148: 
 3149:    NODE(node1);
 3150: 
 3151: 
 3152:    node1->clearMatrixRow();
 3153:    node1->qel = 0.0;
 3154: 
 3155:    // THIS IS FOR STRUCTURES XXX
 3156:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3157: 
 3158:    
 3159:    for (int j=0; j<node1->numElements; j++) {
 3160:       // For each element connected to the node...
 3161: 
 3162:       Element *elem = node1->elements[j];
 3163: 
 3164:       // Compute the average gravity
 3165:       const double grav3 = elem->mean(&Node::grav2);
 3166: 
 3167:       // Look at the documentation for the description of the terms in the following integrals
 3168: 
 3169:       // Integral I_1 
 3170:       // \bar{\breve{H}} 
 3171:       const double hhatb = elem->mean(&Side::hhat);        
 3172: 
 3173: 
 3174:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3175: 
 3176:       const int id1 = elem->nodeLocalIdx(node1); 
 3177:       const double area = elem->area;
 3178: 
 3179:       if (elem->isTri()) {
 3180: 
 3181:          // To clarify the notation in this section: 
 3182:          //   i stands for the node under consideration (node1)
 3183:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3184:          const int id2 = elem->nxq(1 + id1);
 3185:          const int id3 = elem->nxq(2 + id1);
 3186:          Node *node2 = elem->nodes[id2];
 3187:          Node *node3 = elem->nodes[id3];
 3188: 
 3189:          const Point2 x1 = node1->p2();
 3190:          const Point2 x2 = node2->p2();
 3191:          const Point2 x3 = node3->p2();
 3192: 
 3193:          // integral of phi_i*phi_j
 3194:          const double ipp_ii = (1.0/6.0 )*area;
 3195:          const double ipp_ij = (1.0/12.0)*area;
 3196:          const double ipp_ik = (1.0/12.0)*area;
 3197: 
 3198:          // integral of [(grad phi_i) * (grad phi_j)]
 3199:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3200:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3201:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3202: 
 3203:          // Computes the different components of integral I_1 of each node with respect to node i.
 3204:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3205:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3206:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3207: 
 3208: if (j==node1->numElements-1) {
 3209: printf("grav3 = %f, thetai = %f, dt = %f, hhatb = %f, area = %f, dot1= %f, dot2 = %f, dot3 = %f\n", grav3, thetai, dt, hhatb, area, dot(x3-x2, x3-x2), dot(x3-x2, x1-x3), dot(x1-x3, x1-x3));
 3210: printf("node idx = %d, x1 = %f, %f, x2 = %f, %f, x3 = %f, %f\n", node1->idx, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y);
 3211: printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3212: }
 3213: 
 3214:          node1->addToSparseMatrix(node1, I1_ii);
 3215:          node1->addToSparseMatrix(node2, I1_ij); 
 3216:          node1->addToSparseMatrix(node3, I1_ik);
 3217: 
 3218: if (j==node1->numElements-1) printf("I1_ii = %f, I1_ij = %f, I1_ik = %f\n", I1_ii, I1_ij, I1_ik);
 3219:      
 3220:       }
 3221:       else { // Quad
 3222:          // XXX IMPLEMENT THIS
 3223:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3224:       } 
 3225: 
 3226:  
 3227:       // Integral I_4
 3228:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3229:       // Where
 3230:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3231: 
 3232:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3233:       // of U over the element.
 3234:       Vector2 Umean = {0.0, 0.0};
 3235:       for (int m=0; m<elem->i34; m++) {      
 3236:          const Side *side = elem->sides[m];
 3237: 
 3238:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3239:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3240:       }
 3241:       Umean = Umean/elem->i34;
 3242: 
 3243:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3244: 
 3245:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3246:       const double I_4_1 = dot(gradPhi_1, Umean);
 3247: 
 3248:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3249:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3250:      
 3251:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3252: if (j==node1->numElements-1) printf("MMMMmm  idx_node = %d, I_4_1 = %.15g, I_4_2 = %.15g, node1->qel = %.15g, gradPhi_1 = %.15g, %.15g, elem->ghat1 = %.15g, %.15g\n", node1->idx, I_4_1, I_4_2, node1->qel, gradPhi_1.x, gradPhi_1.y, elem->ghat1.x, elem->ghat1.y);
 3253: 
 3254:       // Additional terms 
 3255:       double vnorm = 0.0;
 3256:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3257:          Vector3 ubed;
 3258:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3259: 
 3260:          Vector3 gradP = {0.0, 0.0, 1.0};
 3261:          for (int m=0; m < elem->i34; m++) {
 3262:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3263:            gradP += toVector3(gradP_2D, 0.0);
 3264:          }   
 3265:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3266:       } // imm==2
 3267: 
 3268:       if (elem->isTri()) {
 3269:          for (int l=0; l<3; l++) {
 3270:            double fac;
 3271: 
 3272:            Node *node = elem->nodes[l];
 3273: 
 3274:            (node == node1)? fac=2.0 : fac=1.0;
 3275: 
 3276:            if constexpr(imm==2) node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3277:            else                 node->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3278:            
 3279:          }
 3280: 
 3281: 
 3282:          if (!elem->isDry) {
 3283:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3284: 
 3285:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3286:          }
 3287: if (j==node1->numElements-1) printf("&&& node1->qel = %f\n", node1->qel, node1->eta2);
 3288: 
 3289:       } // isTri
 3290:       else { // isQuad
 3291:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3292:          // for (int l=0; l<4; l++) {
 3293:          //   const Node *node = elem->nodes[l];
 3294: 
 3295:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3296:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3297: 
 3298:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3299:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3300:          // }
 3301: 
 3302:       } // isQuad
 3303: 
 3304: 
 3305:       node1->qel += (dt/elem->i34)*elem->vsource;
 3306:       
 3307: 
 3308:    } // for all elements connected to the node
 3309:    
 3310: 
 3311: 
 3312:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3313:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3314:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3315:    if (nodeBnd != nullptr)  { 
 3316:       // If it is an open boundary node...
 3317: 
 3318:       // At least one open bnd side, maybe two
 3319:       for (int l=0; l<2; l++) { 
 3320: 
 3321:          // Gets each of the sides sharing the node. 
 3322:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3323: 
 3324:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3325: 
 3326:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3327: 
 3328:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3329:          if (sideBnd != nullptr) {
 3330:             // If the side is on a boundary...
 3331: 
 3332:             // Get the boundary segment
 3333:             const BoundarySegment *sideSegment = sideBnd->segment;
 3334:             const Side *side = sideBnd->side;
 3335: 
 3336:             // Integral I_3
 3337:             if (sideSegment->ifltype != 0) {
 3338:             // Natural or Flather b.c.
 3339: 
 3340:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3341:                // especially for Flather b.c.
 3342:                double ri3 = 0.0;
 3343:                if (!side->isDry) {
 3344:                   // If the side is not dry
 3345:                   
 3346:                   // Computes the side flux of (uth, vth)
 3347:                   double Vn = 0.0;
 3348:                   for (int k = side->kb; k<nvrt-1; k++) {
 3349:                      // uth, vth in lat/lon frame if ics=2
 3350:                      // XXX Are uth,vth really necessary? Why not just store the normal component?
 3351:                      const double vn1 = dot(sideBnd->uth(k  ), side->n); // outer normal
 3352:                      const double vn2 = dot(sideBnd->uth(k+1), side->n);
 3353: 
 3354:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3355:                   }
 3356: 
 3357:                   ri3 = 0.5*side->len*Vn;
 3358:                }
 3359: 
 3360:                if (sideSegment->ifltype == -1) { // Flather 1
 3361: 
 3362:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3363:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3364: 
 3365:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3366:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3367:                   
 3368:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3369:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3370: 
 3371:                } 
 3372:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3373:                   // Reset ri3
 3374:                   ri3 = 0.0;
 3375: 
 3376:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3377: 
 3378:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3379: 
 3380:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3381:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3382: 
 3383:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3384:                   node1->addToSparseMatrix(node1, con0*2.0);
 3385:                   node1->addToSparseMatrix(node2, con0);
 3386: 
 3387:                } // if Flather or Discharge
 3388: 
 3389:                node1->qel -= thetai*dt*ri3;
 3390: 
 3391:             } // I_3
 3392:           
 3393: 
 3394:             // Integral I_5
 3395:             if(!side->isDry) {
 3396: 
 3397:                const double Unbar = dot(side->U, side->n);
 3398: 
 3399:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3400:                
 3401:             } // I_5
 3402: 
 3403:          } // if is boundary side
 3404: 
 3405:       } // for l
 3406: 
 3407:    } // if isbnd
 3408: 
 3409: 
 3410:    printf("44444444 idx_node = %d, node1->qel = %f\n", node1->idx, node1->qel);
 3411: 
 3412: }
 3413: 
 3414: 
 3415: 
 3416: extern "C" {
 3417:    __global__ void rollUpElevation(void) {
 3418: 
 3419:       NODE(node);
 3420: 
 3421:       node->eta2 += node->eta1;
 3422: 
 3423:    }
 3424: 
 3425: 
 3426:    __global__ void backtrackAllNodes(void) {
 3427: 
 3428:       // max/min # of sub-divisions
 3429:       const int ndelt_max = max(1.0, dt/dtb_min);
 3430:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3431: 
 3432:       // Removed all references to swild98 XXX
 3433:       // swild98=0.d0 !init
 3434: 
 3435: 
 3436:       SIDE(side);
 3437: 
 3438:       const int kb = side->kb;
 3439: 
 3440: 
 3441: 
 3442:       // Initialize btrack velocities to the actual velocities at the side 
 3443:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3444: 
 3445: 
 3446:       if (side->isDry) return;
 3447: 
 3448: 
 3449:       // Checks that at least one element is not dry
 3450:       const Element *elem1 = side->elems[0];
 3451:       const Element *elem2 = side->elems[1];
 3452: 
 3453: 
 3454:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3455:       
 3456:       // XXXXXX
 3457:       // !swild_tmp to store global coord. of the starting side
 3458:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3459:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3460:       // !Use sframe2 
 3461:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3462: 
 3463: 
 3464:       for (int k = kb; k < nvrt; k++) {
 3465:       //  Initialize (xt,yt,zt), nnel and vel.
 3466:       //  For ics=2, the coordinates are in local frames
 3467:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3468: 
 3469: 
 3470:          const int iadvf = side->iadv();  // Advection flag
 3471: 
 3472:          Point3 xt;
 3473:          if constexpr(ics==1) {
 3474:             xt = side->center3D(k); 
 3475:          }
 3476:          else // lat/lon; in side lat/lon frame
 3477:          {
 3478:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3479:          // XXX IMPLEMENT THIS
 3480:       //          xt=0.d0
 3481:       //          yt=0.d0
 3482:       //          !centroid coord. for nudging
 3483:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3484:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3485:          }  // ics
 3486: 
 3487: 
 3488:          // Velocity at the side (in ll frame for ics, same vertical direction)
 3489:          // XXX IS THIS NECESSARY?
 3490:          Vector3 u_int = toVector3(side->u2[k], 0.5*(side->w2[k] + side->w2[k+1])); // XXX {side->u2[j].x, side->u2[j].y, 0.5*(side->w2[j] + side->w2[j+1])};
 3491: 
 3492:          // If on land or open boundary...
 3493:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3494:          
 3495:          const double vmag = length(toVector2(u_int));
 3496: 
 3497:          if (vmag <= velmin_btrack) {
 3498:             // No activity 
 3499: addDebugPlot(side->center, side->center, 0x00FF00);
 3500:             side->btu[k] = side->u2[k];
 3501:             
 3502:          } else {  // do btrack
 3503: 
 3504:             // Compute number of sub-divisions based on local gradients 
 3505:             // XXX IS THIS NECESSARY?
 3506:             double suma = 0.0;
 3507:             int icount = 0;
 3508:             for (int ii=0; ii<2; ii++) {
 3509: 
 3510:                const Element *elem = side->elems[ii];
 3511:                  
 3512:                if (elem == nullptr) continue;
 3513: 
 3514:                icount++;
 3515: 
 3516:                // Not strictly along z; in ll frame for ics=2
 3517: 
 3518:                double utmp[4];
 3519:                double vtmp[4];
 3520:                for (int jj = 0; jj < elem->i34; jj++) {
 3521: 
 3522:                   const Node *node = elem->nodes[jj];
 3523: 
 3524:                   if constexpr(ics==1) {
 3525:                      utmp[jj] = node->u2[k].x;
 3526:                      vtmp[jj] = node->u2[k].y;  
 3527:                   } else {
 3528:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3529:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3530:                   }
 3531:                } // for jj
 3532: 
 3533:                const Vector2 grad_u = elem->grad2(utmp); 
 3534:                const Vector2 grad_v = elem->grad2(vtmp);
 3535: 
 3536:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3537:             } // for ii
 3538: 
 3539:             assert(icount > 0 && "Impossible 77");
 3540: 
 3541:             // '4' is somewhat arbitrary
 3542:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3543: 
 3544:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3545:          
 3546: 
 3547:             Vector3 u_int = {0.0, 0.0, 0.0};
 3548: 
 3549:             side->btrack(k, dt, dtbk, u_int);
 3550:                
 3551:          } // if vmag (do backtrack)
 3552: 
 3553:       } // for j=jmin,nvrt-1
 3554: 
 3555:    }
 3556: } // extern "C"
 3557: 
 3558: template<int nc>
 3559: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3560: 
 3561: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3562: //
 3563: // a,b,c,rhs: input vectors and are not modified by this program.
 3564: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3565: // rhs is the r.h.s.
 3566: // n: actual rank of the system.
 3567: // rows in u() and rhs();
 3568: // u: output with nc columns (transposed to rows)
 3569: // gam: a working array.
 3570: //
 3571: // NOTES:
 3572: // This is a template function that allows for different numbers of columns in the rhs vector.
 3573: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3574: 
 3575:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3576:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3577: 
 3578:    double bet = b[0];
 3579:    if constexpr (nc == 1) {
 3580:       u[0] = rhs[0]/bet;
 3581:    } else {
 3582:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3583:    }
 3584: 
 3585:    for (int j = 1; j < n; j++) {
 3586:       gam[j] = c[j-1]/bet;
 3587:       bet = b[j] - a[j]*gam[j];
 3588: 
 3589:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3590: 
 3591:       if constexpr (nc == 1) {
 3592:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3593:       } else {
 3594:          for (int k = 0; k < nc; k++) {
 3595:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3596:          }
 3597:       }
 3598:    }
 3599: 
 3600:    // Back-substitution
 3601:    for (int j=n-1; j>=1; j--) {
 3602:       if constexpr (nc == 1) {
 3603:          u[j] = u[j] - gam[j+1]*u[j-1];
 3604:       } else {
 3605:          for (int k = 0; k < nc; k++) {
 3606:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3607:          }
 3608:       }
 3609:    }
 3610: }
 3611: 
 3612: 
 3613: 
 3614: // Helper function that contains the core algorithm
 3615: template<typename XAccessor, typename YAccessor>
 3616: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3617:                                     double  yp_top, double  yp_bot, 
 3618:                                     CubicSpline &spline) {
 3619:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3620:    // 
 3621:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3622:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3623:    //
 3624:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3625:    // 
 3626:    // Inputs: 
 3627:    //            n: dimension for x etc; # of data pts (>=2);
 3628:    //            getX, getY: functions to access x,y coordinates
 3629:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3630:    //     Output: 
 3631:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3632: 
 3633:    const int n = k2 - k1 + 1;
 3634:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3635: 
 3636:    // Allocate memory for the splines
 3637:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3638:    spline.x   = new double[n];
 3639:    spline.y   = new double[n];
 3640:    spline.yp  = new double[n];
 3641:    spline.ypp = new double[n];
 3642: 
 3643:    for (int k=k1; k<=k2; k++) {
 3644:       spline.x[k] = getX(k);
 3645:       spline.y[k] = getY(k);
 3646:    }
 3647: 
 3648:    // This is to simplify expressions later
 3649:    double *x = spline.x;
 3650:    double *y = spline.y;
 3651: 
 3652:    double *a = nullptr;
 3653:    double *b = nullptr;
 3654:    double *c = nullptr;
 3655:    double *gam = nullptr;
 3656:    double *rhs = nullptr;
 3657:    
 3658: 
 3659:       a = new double[n];   // Lower diagonal
 3660:       b = new double[n];   // Diagonal
 3661:       c = new double[n];   // Upper diagonal
 3662:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3663:       rhs = new double[n]; // Right-hand side
 3664: 
 3665:    for (int k=k1; k<=k2; k++) {
 3666:       if (k == k1) {
 3667:          // Bottom level
 3668:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3669:          b[k] = (x[k+1] - x[k])/3.0;
 3670:          c[k] = b[k]/2.0;
 3671:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3672:       } else if (k == n - 1) {
 3673:          // Top level (surface)
 3674:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3675:          b[k] = (x[k] - x[k-1])/3.0;
 3676:          a[k] = b[k]/2.0;
 3677:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3678:       } else {
 3679:          // Intermediate levels
 3680:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3681:          b[k] = (x[k+1] - x[k-1])/3.0;
 3682:          a[k] = (x[k  ] - x[k-1])/6.0;
 3683:          c[k] = (x[k+1] - x[k  ])/6.0;
 3684:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3685:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3686:       }
 3687:    }
 3688: 
 3689:    // Solve the tridiagonal system
 3690:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3691:    
 3692:    spline.yp[k1] = yp_bot;
 3693:    spline.yp[k2] = yp_top;
 3694: 
 3695:    // Compute rest of 1st derivatives using the splines
 3696:    for (int k=k1+1; k<k2; k++) {
 3697:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3698:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3699:    }
 3700:    
 3701:    delete[] a;
 3702:    delete[] b;
 3703:    delete[] c;
 3704:    delete[] gam;
 3705:    delete[] rhs;
 3706: 
 3707: }
 3708: 
 3709: // Array version
 3710: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3711:                                 double y_top, double y_bot, 
 3712:                                 CubicSpline &spline) {
 3713:    auto getX = [x] (int k) { return x[k]; };
 3714:    auto getY = [y] (int k) { return y[k]; };
 3715:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3716: }
 3717: 
 3718: // Lambda version - allows custom access patterns
 3719: template<typename XFunc, typename YFunc>
 3720: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3721:                                 double y_top, double y_bot,
 3722:                                 CubicSpline &spline) {
 3723:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3724: }
 3725: 
 3726: 
 3727: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 3728: {
 3729:    assert("Not implemented");
 3730: 
 3731:    return 0.0;
 3732: }
