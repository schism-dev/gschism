 1775: // Convenience macros for accessing the objects in kernels.
 1776: 
 1777: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1778:                    Side *side = &(mesh->localSideData[idx_side]); \
 1779:                    if (idx_side >= mesh->ns) return;
 1780: 
 1781: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1782:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1783:                    if (idx_elem >= mesh->ne) return;
 1784: 
 1785: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1786:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1787:                    if (idx_node >= mesh->np) return;
 1788: 
 1789: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1790:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1791:                               const bool valid = (idx_node < mesh->np);                   
 1792: 
 1793: 
 1794: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1795:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1796:                            if (idx_node_bnd >= mesh->nbp) return;
 1797: 
 1798: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1799:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1800:                            if (idx_side_bnd >= mesh->nbs) return;                           
