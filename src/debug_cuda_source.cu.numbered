 2605: 
 2606: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2607: 
 2608: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2609: 
 2610: /**
 2611:  * This method performs backtracking from the side center until a time -dt back in time 
 2612:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2613:  * intermediate point.
 2614:  *
 2615:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2616:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2617:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2618:  * remaining time.
 2619:  * 
 2620:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2621:  * 
 2622:  * @param uuint, vvint, wwint: Velocities at the final point
 2623:  * @param jlev: Level at which the backtracking is performed
 2624:  * @param dt, dtbk: Tracking timesteps
 2625:  * @return: True if the backtracking was successful, false otherwise
 2626:  */
 2627: __inline__ __device__ bool Side::btrack(
 2628:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 2629:       double dt,            // Tracking time
 2630:       double dtbk,          // Tracking timestep
 2631:       Vector3 &u_int        // Velocities at the initial point
 2632: ) const {
 2633: 
 2634:    // Start from side center
 2635:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2636: 
 2637:  
 2638:    double time_rm = dt; // Remaining time
 2639: 
 2640: 
 2641:    // Initial velocities
 2642:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 2643: 
 2644:    // Find the element that is in the direction opposite to the velocity
 2645:    Element* curElem = findElementTowards(toVector2(u_int));
 2646:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2647: 
 2648: 
 2649:    // Nudges it towards the barycenter
 2650:    curElem->nudgeToBarycenter(toPoint2(x0)); // XXXX Necessary?
 2651: 
 2652: 
 2653:    const int MAX_ITERATIONS = 100; 
 2654:    Element* nextElem = nullptr;
 2655:    int iter = 0;
 2656:    // assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 2657:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 2658:    while(true) {
 2659: 
 2660:       // Calculate timestep
 2661:       double dtb = min(dtbk, time_rm);
 2662: 
 2663: // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);      
 2664: 
 2665:       // Next point in the backtracking curve
 2666: // if (iter >= MAX_ITERATIONS - 50)  {
 2667: //    printf("iter = %d, side->idx = %d, dtb = %.17f, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, dtb, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);
 2668: //    addDebugPlot(x0, x0 - dtb*u_int, 0xFF00FF, '+');        
 2669: // }
 2670:         
 2671:       xt = x0 - dtb*u_int;
 2672: 
 2673:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, time_rm, this);
 2674:       assert(found && "Backtracking failed in btrack");
 2675: 
 2676: 
 2677:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2678:                       // then time_rm needs to be increased by the unused time.
 2679: 
 2680:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0                      
 2681: 
 2682:       // If the velocity is too small, we stop the backtracking
 2683:       const double vmag = length(toVector2(u_int));
 2684:       if (vmag <= velmin_btrack) break;
 2685: 
 2686:       // The current point becomes the next segment's starting point.
 2687:       x0 = xt;
 2688:  
 2689:       curElem = nextElem;
 2690: 
 2691:       iter++;
 2692: 
 2693:       if (iter >= MAX_ITERATIONS) break;
 2694: 
 2695:       // if (iter >= MAX_ITERATIONS - 50) {
 2696:       //    addDebugPlot(center, center, 0xFF001F, 'x');  
 2697:       //    printf("iter = %d, side->idx = %d, elems[0]->idx = %d, elems[1]->idx = %d, curElem->idx = %d, time_rm = %.17f, dtb = %.17f, u_int = (%.17f, %.17f, %.17f), xt = (%.17f, %.17f, %.17f)\n", iter, idx, elems[0]->idx, elems[1]->idx, curElem->idx, time_rm, dtb, u_int.x, u_int.y, u_int.z, xt.x, xt.y, xt.z);      
 2698:       //    }
 2699:       // assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2700:    }
 2701: 
 2702:    assert(!curElem->isDry && "Final element is dry");
 2703:    assert(curElem->containsPoint(toPoint2(xt)) && "Target point is not inside the final element");
 2704: 
 2705:    // Interpolate the velocities at the final point
 2706:    curElem->interpolateVelocities(xt, u_int);
 2707: 
 2708:    // if (idx == 18867) printf("iter = %d, side->idx = %d, curElem->idx = %d, x0 = (%.17f, %.17f, %.17f), u_int = (%.17f, %.17f, %.17f)\n", iter, idx, curElem->idx, x0.x, x0.y, x0.z, u_int.x, u_int.y, u_int.z);         
 2709: 
 2710: 
 2711: }
 2712: 
