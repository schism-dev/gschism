 2217:    template<typename T>
 2218:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2219:       T values[4];
 2220:       getNodalValues(field, values);
 2221: 
 2222:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2223:       if constexpr (IsVector2<T>::value && ics == 2) {
 2224: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2225:          projectNodeVectorsToElementFrame(values);
 2226: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2227:       }
 2228: 
 2229:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2230:    }
