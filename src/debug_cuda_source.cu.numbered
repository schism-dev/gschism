 2101: 
 2102:       // Get the values of the func at the nodes of the element
 2103:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2104:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2105:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2106:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2107:       else          res[3] = T();  // This is 0.0 or a zero vector
