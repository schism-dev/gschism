 2137: 
 2138: 
 2139: /**
 2140:    Compute the shape coordinates of the point (xt,yt) in the element.
 2141:    @param xt (input): x-coordinate of the point
 2142:    @param shpCoords (output): shape coordinates of the point
 2143:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2144:    @return true if the point is inside the element, false otherwise
 2145: **/
 2146: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2147:                                             bool fixNegshpCoord) const {
 2148: 
 2149:    // Compute the shape coordinates of the point xt in the element.
 2150:    if (i34==3) {
 2151:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2152:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2153:       // and in this case, the pt will be nudged into the element
 2154:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2155:       // from the local frame, so use additional check.
 2156: 
 2157:       Point2 x0, x1, x2;
 2158: 
 2159:       if constexpr(ics==1) {
 2160:          x0 = nodes[0]->p2();
 2161:          x1 = nodes[1]->p2();
 2162:          x2 = nodes[2]->p2();
 2163:       }
 2164:       else // lat/lon
 2165:       {
 2166:          Error("Not implemented yet");
 2167: #ifdef ICS2
 2168:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2169:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2170:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2171: #endif
 2172:       }
 2173: 
 2174:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2175:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2176:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2177:       shpCoords[3] = 0.0;
 2178:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2179: 
 2180:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2181:       // then we fix the negative shape coordinates.
 2182:       if (fixNegshpCoord && tmpmin<=0.0) {
 2183: 
 2184:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2185:          // keeping the sum of the shape coordinates equal to 1.
 2186:          // I have tested and compared the new algorithm with the old one, and they give
 2187:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2188:          // The new algorithm should be faster since it is branchless.
 2189:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2190:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2191:          
 2192:          shpCoords[0] = (shpCoords[0] + a)*b;
 2193:          shpCoords[1] = (shpCoords[1] + a)*b;
 2194:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2195: 
 2196:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2197:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2198:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2199:          }
 2200: 
 2201:          // Update the point coordinates for the new shape coordinates
 2202:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2203:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2204:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2205: 
 2206:       }
 2207: 
 2208:       // Check if the point is inside the element
 2209:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2210:    }
 2211:    else {
 2212:       Error("Not implemented yet");
 2213: #ifdef QUADS
 2214:       // Reproject pt in eframe of nel for ics=2
 2215:       if constexpr(ics==1) {
 2216:          xn2 = xt; 
 2217:          yn2 = yt;
 2218:       }
 2219:       else {
 2220:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2221:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2222:       }
 2223: 
 2224:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2225: #endif
 2226:    }
 2227: 
 2228:    return false;  // Never reached
 2229: 
 2230: }
 2231: 
 2232: 
 2233: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2234: // Convert shape coordinates to cartesian coordinates
 2235: 
 2236:    if (i34 == 3) {
 2237:       // Triangular element
 2238:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2239:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2240:    }
 2241:    else {
 2242:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2243:    }
 2244: 
 2245: }
 2246: 
 2247: 
 2248: /**  Interpolate velocities at a given point (xt,yt,zt)
 2249: 
 2250:    @param xt, yt, zt: coordinates of the point to interpolate
 2251:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2252: 
 2253:    This is done in four steps:
 2254: 
 2255:    1. Find the shape coordinates for the final position in the element.
 2256:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2257:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2258:       z levels at xt, yt at each step.   
 2259:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2260:       horizontally and vertically.
 2261: **/
 2262: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2263:    // Interpolate the velocities at the point xt. 
 2264:    // This function works the same for triangular and quadrilateral elements.
 2265:    double shpCoord[4];
 2266: 
 2267: printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2268:    // First step is to compute the shape coordinates of (xt,yt)
 2269:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2270:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2271: 
 2272:    // Second step is to find the level that contains zt
 2273:    // Uses a binary search to find the level
 2274:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2275:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2276:    int R = nvrt - 1;
 2277: 
 2278:    // Get the z coordinates at the nodes of the element at the levels L and R
 2279:    double zLAtNodes[4], zRAtNodes[4];
 2280:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2281:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2282: 
 2283:    double zL = interpolate(shpCoord, zLAtNodes);
 2284:    double zR = interpolate(shpCoord, zRAtNodes);
 2285:    
 2286:    // Interpolates vertically the velocities
 2287:    double wght1, wght2;
 2288:    if (xt.z<=zL) {
 2289:       wght1 = 1.0;
 2290:       wght2 = 0.0;
 2291:    }
 2292:    else if (xt.z>=zR) {
 2293:       wght1 = 0.0;
 2294:       wght2 = 1.0;
 2295:    }
 2296:    else {
 2297:       // Perform a binary search to find the levels between L and R that contain xt.z
 2298:       while (R - L > 1) {
 2299:          int M = (L + R) / 2;
 2300: 
 2301:          double zMAtNodes[4];
 2302:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2303:          double zM = interpolate(shpCoord, zMAtNodes);
 2304:          if (zM < xt.z) 
 2305:          {
 2306:             L = M;
 2307:             zL = zM;
 2308:          }
 2309:          else 
 2310:          {
 2311:             R = M;
 2312:             zR = zM;
 2313:          }
 2314:       }
 2315:       assert(L == R-1);
 2316:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2317: 
 2318:       wght2 = (xt.z - zL)/(zR - zL);
 2319:       wght1 = 1.0 - wght2;
 2320:    }
 2321: 
 2322:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2323:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2324: 
 2325: if (idx==2) {
 2326: Vector3 u1 = wght1*interpolate(L, shpCoord, &Node::u2);
 2327: Vector3 u2 = wght2*interpolate(R, shpCoord, &Node::u2);
 2328: printf("L = %d, R = %d, Element = %d\n", L, R, idx);
 2329: printf("shpCoord = %.17g,%.17g,%.17g,%.17g\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 2330: // printf("node1 (%.17g,%.17g), node2 (%.17g,%.17g,%), node3 (%.17g,%.17g)\n", nodes[0]->p2().x, nodes[0]->p2().y, nodes[1]->p2().x, nodes[1]->p2().y, nodes[2]->p2().x, nodes[2]->p2().y);
 2331: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[L].x, nodes[0]->u2[L].y, nodes[0]->u2[L].z);
 2332: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[L].x, nodes[1]->u2[L].y, nodes[1]->u2[L].z);
 2333: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[L].x, nodes[2]->u2[L].y, nodes[2]->u2[L].z);
 2334: printf("element = %d, idx = %d, u_n1 = %.17g,%.17g,%.17g\n", idx, nodes[0]->idx, nodes[0]->u2[R].x, nodes[0]->u2[R].y, nodes[0]->u2[R].z);
 2335: printf("element = %d, idx = %d, u_n2 = %.17g,%.17g,%.17g\n", idx, nodes[1]->idx, nodes[1]->u2[R].x, nodes[1]->u2[R].y, nodes[1]->u2[R].z);
 2336: printf("element = %d, idx = %d, u_n3 = %.17g,%.17g,%.17g\n", idx, nodes[2]->idx, nodes[2]->u2[R].x, nodes[2]->u2[R].y, nodes[2]->u2[R].z);
 2337: printf("element = %d, idx = %d, u_int = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z);   
 2338: printf("u1 = %.17g,%.17g,%.17g\n", u1.x, u1.y, u1.z);   
 2339: printf("u2 = %.17g,%.17g,%.17g\n", u2.x, u2.y, u2.z);   
 2340: if(!(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z))) {u_int = {0.0, 0.0, 0.0}; return;}
 2341: }
 2342: 
 2343:    // Neither of the interpolated velocities should be NaN
 2344:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2345: 
 2346: }
