 3943: __device__ __inline__ void Node::updateZCoordData(void) {
 3944: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3945: 
 3946:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3947:    // if (isDry2()) {
 3948:    //    kb = -1;  // XXXXXXXX KKKKK
 3949:    //    return;
 3950:    // }
 3951: 
 3952: 
 3953:    if constexpr(ivcor == 2) {  // SZ coordinates
 3954:       
 3955:       // Compute bottom level index
 3956:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3957:    } 
 3958:    else {  // if (ivcor == 1) Localized sigma
 3959:       // Do nothing
 3960:    }
 3961: 
 3962: 
 3963: }
