  745:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  746: 
  747:    // ------------------------------------------------------------------------------------------------
  748:    // These are functions that work on all nodes of the element.
  749:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  750:    //
  751:    // An example of how to use these functions is:
  752:    //   
  753:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  754:    // 
  755:    // Where L is the level at which the field is to be interpolated. The field can be either
  756:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  757:    // There are different versions of getNodalValues for each of these cases.
  758: 
  759:    template<typename T>
  760:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  761:       // Get the values of the field at the nodes of the element
  762:       res[0] = nodes[0]->*field;
  763:       res[1] = nodes[1]->*field;
  764:       res[2] = nodes[2]->*field;
  765:       if (isQuad()) res[3] = nodes[3]->*field;
  766:       else          res[3] = T();
  767:    }
  768: 
  769:    template<typename T>
  770:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  771:       // Get the values of the field at the nodes of the element
  772:       res[0] = (nodes[0]->*field)[level];
  773:       res[1] = (nodes[1]->*field)[level];
  774:       res[2] = (nodes[2]->*field)[level];
  775:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  776:       else          res[3] = T();
  777:    }    
  778: 
  779:    template<typename T>
  780:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  781:       // Get the values of the func at the nodes of the element
  782:       res[0] = (nodes[0]->*func)(level);
  783:       res[1] = (nodes[1]->*func)(level);
  784:       res[2] = (nodes[2]->*func)(level);
  785:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  786:       else          res[3] = T();  // This is 0.0 or a zero vector
  787: 
  788:    }      
  789: 
  790:    template<typename T>
  791:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  792:       // Get the values of the field at the nodes of the element
  793:       res[0] = sides[0]->*field;
  794:       res[1] = sides[1]->*field;
  795:       res[2] = sides[2]->*field;
  796:       if (isQuad()) res[3] = sides[3]->*field;
  797:       else          res[3] = T();
  798:    }
  799: 
  800:    template<typename T>
  801:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  802:       // Get the values of the field at the nodes of the element
  803:       res[0] = (sides[0]->*field)[level];
  804:       res[1] = (sides[1]->*field)[level];
  805:       res[2] = (sides[2]->*field)[level];
  806:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  807:       else          res[3] = T();
  808:    }    
  809: 
  810:    template<typename T>
  811:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  812:       // Get the values of the func at the nodes of the element
  813:       res[0] = (sides[0]->*func)(level);
  814:       res[1] = (sides[1]->*func)(level);
  815:       res[2] = (sides[2]->*func)(level);
  816:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  817:       else          res[3] = T();  // This is 0.0 or a zero vector
  818: 
  819:    }      
  820: 
  821:    template<typename T>
  822:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
  823:       T values[4];
  824:       getNodalValues(level, func, values);
  825: 
  826:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  827:    }
  828: 
  829:    template<typename T>
  830:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  831:       T values[4];
  832:       getNodalValues(field, values);
  833:       
  834:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  835:    }
  836: 
  837: 
  838:    template<typename T>
  839:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  840:       T values[4];
  841:       getNodalValues(level, field, values);
  842: 
  843:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  844:    }
  845: 
  846:    template<typename T>
  847:    __device__ T mean(T Node::* field) const {
  848:       T values[4];
  849:       getNodalValues(field, values);
  850: 
  851:       assert(i34 == 4 || values[3] == T() && "mean: values[3] is not zero with i34 == 4");
  852: 
  853:       return (values[0] + values[1] + values[2] + values[3])/i34;
  854:    }
  855: 
  856:    template<typename T>
  857:    __device__ T mean(T Side::* field) const {
  858:       T values[4];
  859:       getSideValues(field, values);
  860:       
  861:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  862: 
  863:       return (values[0] + values[1] + values[2] + values[3])/i34;
  864:    }   
  865: 
  866:    template<typename T>
  867:    __device__ T mean(int level, T (Node::* field)[nvrt]) const {
  868:       T values[4];
  869:       getNodalValues(level, field, values);
  870: 
  871:       assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  872: 
  873:       return (values[0] + values[1] + values[2] + values[3])/i34;
  874:    }
  875: 
  876:    template<typename T>
  877:    __device__ T mean(int level, T (Side::* field)[nvrt]) const {
  878:       T values[4];
  879:       getSideValues(level, field, values);
  880:       
  881:       // assert((i34 == 4) || (values[3] == T()) && "mean: values[3] is not zero with i34 == 4");
  882: 
  883:       return (values[0] + values[1] + values[2] + values[3])/i34;
  884:    }   
  885: 
  886:    // __device__ double mean(double (Node::*func)(int) const) const {
  887:    //    double values[4];
  888:    //    getNodalValues(level, func, values);
  889:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  890:    // }
  891:    // ------------------------------------------------------------------------------------------------
  892: 
  893:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  894:       // Convert global coordinates to local coordinates
