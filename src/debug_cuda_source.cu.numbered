 1598:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1599:       // Compute the different time ramps used in the code 
 1600:       // This function is performed by just one thread
 1601: 
 1602:       if constexpr(ibc == 0) {
 1603:          if (drampbc > 0.0) {
 1604:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1605:          } else {
 1606:             rampbc = 1.0;
 1607:          }
 1608: 
 1609:          if (nws != 0 && drampwind > 0.0) {
 1610:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1611:          } else {
 1612:             rampwind = 1.0;
 1613:          }
 1614:       }
 1615: 
 1616:       if (drampwafo > 0.0) {
 1617:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1618:       } else {
 1619:          rampwafo = 1.0;
 1620:       }
 1621: 
 1622:       // For source/sinks
 1623:       if (if_source && dramp_ss > 0.0) {
 1624:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1625:       } else {
 1626:          ramp_ss = 1.0;
 1627:       }
 1628: 
 1629:       if (dramp > 0.0) {
 1630:          ramp = tanh(2.0*time/86400.0/dramp);
 1631:       } else {
 1632:          ramp = 1.0;
 1633:       }
 1634: 
 1635:    }
