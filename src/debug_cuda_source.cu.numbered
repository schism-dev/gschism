 3797:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3798: 
 3799:       NODE_BND(nodeBnd);
 3800: 
 3801:       Node *node = nodeBnd->node;
 3802: 
 3803:       node->ETP = 0.0;
 3804: 
 3805:       for (int j=0; j<ntip; j++) {
 3806: 
 3807:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3808:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3809:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3810: 
 3811:          if constexpr(iloadtide==1) { // loading tide
 3812:             assert(false && "Loading tide not implemented");
 3813:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3814:          }
 3815:          
 3816:       }
 3817:       
 3818:    }
