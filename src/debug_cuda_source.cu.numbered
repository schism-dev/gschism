 2174:    template<typename T>
 2175:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2176:       // Get the values of the field at the nodes of the element
 2177:       res[0] = nodes[0]->*field;
 2178:       res[1] = nodes[1]->*field;
 2179:       res[2] = nodes[2]->*field;
 2180:       if (isQuad()) res[3] = nodes[3]->*field;
 2181:       else          res[3] = T();
 2182:    }
 2183: 
 2184:    template<typename T>
 2185:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2186: 
 2187:       assert(level < nvrt && "Level is out of range");
 2188:       // Get the values of the field at the nodes of the element
 2189:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2190:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2191:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2192:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2193:       else          res[3] = T();
 2194:    }    
 2195: 
 2196:    template<typename T>
 2197:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 2198: 
 2199:       assert(level < nvrt && "Level is out of range");
 2200: 
 2201:       // Get the values of the func at the nodes of the element
 2202:       res[0] = (nodes[0]->*func)(max(level, nodes[0]->kb));
 2203:       res[1] = (nodes[1]->*func)(max(level, nodes[1]->kb));
 2204:       res[2] = (nodes[2]->*func)(max(level, nodes[2]->kb));
 2205:       if (isQuad()) res[3] = (nodes[3]->*func)(max(level, nodes[3]->kb));
 2206:       else          res[3] = T();  // This is 0.0 or a zero vector
 2207: 
 2208:    }      
