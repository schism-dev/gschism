 2193: 
 2194: 
 2195: /**
 2196:    Compute the shape coordinates of the point (xt,yt) in the element.
 2197:    @param xt (input): x-coordinate of the point
 2198:    @param shpCoords (output): shape coordinates of the point
 2199:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2200:    @return true if the point is inside the element, false otherwise
 2201: **/
 2202: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2203:                                             bool fixNegshpCoord) const {
 2204: 
 2205:    // Compute the shape coordinates of the point xt in the element.
 2206:    if (i34==3) {
 2207:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2208:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2209:       // and in this case, the pt will be nudged into the element
 2210:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2211:       // from the local frame, so use additional check.
 2212: 
 2213:       Point2 x0, x1, x2;
 2214: 
 2215:       if constexpr(ics==1) {
 2216:          x0 = nodes[0]->p;
 2217:          x1 = nodes[1]->p;
 2218:          x2 = nodes[2]->p;
 2219:       }
 2220:       else // lat/lon
 2221:       {
 2222:          Error("Not implemented yet");
 2223:          // globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2224:          // globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2225:          // globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2226:       }
 2227: 
 2228:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2229:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2230:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2231:       shpCoords[3] = 0.0;
 2232: 
 2233:       const double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2234:       const bool res = (tmpmin >= -small);     
 2235: 
 2236:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2237:       // then we fix the negative shape coordinates.
 2238:       if ((tmpmin < 1.0e-4) && fixNegshpCoord) {
 2239: 
 2240:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2241:          // keeping the sum of the shape coordinates equal to 1.
 2242:          // I have tested and compared the new algorithm with the old one, and they give
 2243:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2244:          // The new algorithm should be faster since it is branchless.
 2245:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2246:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2247:          
 2248:          shpCoords[0] = (shpCoords[0] + a)*b;
 2249:          shpCoords[1] = (shpCoords[1] + a)*b;
 2250:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2251: 
 2252:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2253:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2254:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2255:          }
 2256: 
 2257:          // Update the point coordinates for the new shape coordinates
 2258:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2259:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2260:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2261: 
 2262:       }
 2263: 
 2264:       // Check if the point is inside the element
 2265:       return res;      
 2266:    }
 2267:    else {
 2268:       Error("Not implemented yet");
 2269: #ifdef QUADS
 2270:       // Reproject pt in eframe of nel for ics=2
 2271:       if constexpr(ics==1) {
 2272:          xn2 = xt; 
 2273:          yn2 = yt;
 2274:       }
 2275:       else {
 2276:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2277:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2278:       }
 2279: 
 2280:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2281: #endif
 2282:    }
 2283: 
 2284:    assert(false && "computeShapeCoords: should never reach this point");
 2285:    return false;  // Never reached
 2286: 
 2287: }
 2288: 
 2289: 
 2290: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2291: // Convert shape coordinates to cartesian coordinates
 2292: 
 2293:    if (i34 == 3) {
 2294:       // Triangular element
 2295:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2296:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2297:    }
 2298:    else {
 2299:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2300:    }
 2301: 
 2302: }
 2303: 
 2304: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2305:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2306:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2307:    // The formula for the integral is:
 2308:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2309: 
 2310:    printf("intPhiPhi: TEST\n");
 2311: 
 2312:    const Node *n0 = nodes[0];
 2313:    const Node *n1 = nodes[1];
 2314:    const Node *n2 = nodes[2];
 2315:    const Node *n3 = nodes[3];
 2316: 
 2317:    const Vector2 p0 = n0->p;
 2318:    const Vector2 p1 = n1->p;
 2319:    const Vector2 p2 = n2->p;
 2320:    const Vector2 p3 = n3->p;
 2321: 
 2322:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2323:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2324:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2325:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2326: 
 2327:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2328: }
 2329:    
 2330: 
 2331: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2332:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2333:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2334:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2335:    // The formula is also based on the identity:
 2336:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2337:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2338: 
 2339:    printf("intGradPhiGradPhi: TEST\n");   
 2340: 
 2341:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2342: 
 2343:    const double x0 = nodes[0]->p.x;
 2344:    const double y0 = nodes[0]->p.y;
 2345:    const double x1 = nodes[1]->p.x;
 2346:    const double y1 = nodes[1]->p.y;
 2347:    const double x2 = nodes[2]->p.x;
 2348:    const double y2 = nodes[2]->p.y;
 2349:    const double x3 = nodes[3]->p.x;
 2350:    const double y3 = nodes[3]->p.y;
 2351: 
 2352:    double res = 0.0;
 2353:    
 2354:    // Quadrature points in xi and eta coordinates
 2355:    #pragma unroll
 2356:    for (int i = 0; i < 4; i++) {
 2357:       // For each quadrature point...
 2358: 
 2359:       const Point2 p = GaussPoint(i);
 2360:       const double eta = p.x;
 2361:       const double xi  = p.y;
 2362: 
 2363:       // Jacobian entries at the Gauss point p
 2364:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2365:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2366:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2367:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2368: 
 2369:       const double detJ = jacobianDet(p);
 2370:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2371: 
 2372:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2373:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2374:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2375:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2376:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2377: 
 2378:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2379:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2380:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2381:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2382:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2383: 
 2384:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2385:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2386:    }
 2387: 
 2388:    return res;
 2389: }
 2390: 
 2391: 
 2392: /**  Interpolate velocities at a given point (xt,yt,zt)
 2393: 
 2394:    @param xt, yt, zt: coordinates of the point to interpolate
 2395:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2396: 
 2397:    This is done in four steps:
 2398: 
 2399:    1. Find the shape coordinates for the final position in the element.
 2400:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2401:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2402:       z levels at xt, yt at each step.   
 2403:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2404:       horizontally and vertically.
 2405: **/
 2406: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2407:    // Interpolate the velocities at the point xt. 
 2408:    // This function works the same for triangular and quadrilateral elements.
 2409:    double shpCoord[4];
 2410: 
 2411:    // First step is to compute the shape coordinates of (xt,yt)
 2412:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2413: if ((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) < -small)) printf("XXXXXX shpCoord = %.17g, %.17g, %.17g, %.17g\n", shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);   
 2414:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2415: 
 2416:    // Second step is to find the level that contains zt
 2417:    // Uses a binary search to find the level
 2418:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2419:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2420:    int R = nvrt - 1;
 2421: 
 2422:    // Get the z coordinates at the nodes of the element at the levels L and R
 2423:    double zLAtNodes[4], zRAtNodes[4];
 2424:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2425:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2426: 
 2427:    double zL = interpolate(shpCoord, zLAtNodes);
 2428:    double zR = interpolate(shpCoord, zRAtNodes);
 2429:    
 2430:    // Interpolates vertically the velocities
 2431:    double wght1, wght2;
 2432:    if (xt.z<=zL) {
 2433:       wght1 = 1.0;
 2434:       wght2 = 0.0;
 2435:    }
 2436:    else if (xt.z>=zR) {
 2437:       wght1 = 0.0;
 2438:       wght2 = 1.0;
 2439:    }
 2440:    else {
 2441:       // Perform a binary search to find the levels between L and R that contain xt.z
 2442:       while (R - L > 1) {
 2443:          int M = (L + R) / 2;
 2444: 
 2445:          double zMAtNodes[4];
 2446:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2447:          double zM = interpolate(shpCoord, zMAtNodes);
 2448:          if (zM < xt.z) 
 2449:          {
 2450:             L = M;
 2451:             zL = zM;
 2452:          }
 2453:          else 
 2454:          {
 2455:             R = M;
 2456:             zR = zM;
 2457:          }
 2458:       }
 2459:       assert(L == R-1);
 2460:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2461: 
 2462:       wght2 = (xt.z - zL)/(zR - zL);
 2463:       wght1 = 1.0 - wght2;
 2464:    }
 2465: 
 2466:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2467:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2468: 
 2469:    // Neither of the interpolated velocities should be NaN
 2470:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2471: 
 2472: }
 2473: 
 2474: 
 2475: 
 2476: 
 2477: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2478: 
 2479:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2480:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2481:    const Node *n1 = side->n1;
 2482:    const Node *n2 = side->n2;
 2483: 
 2484:    bool n1_match = (n1->nodeBnd->segment == segment);
 2485:    bool n2_match = (n2->nodeBnd->segment == segment);
 2486: 
 2487:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2488:    if (n1_match && n2_match) {
 2489:       return 0.5;
 2490:    } else if (n1_match) {
 2491:       return 1.0;
 2492:    } else if (n2_match) {
 2493:       return 0.0;
 2494:    }
 2495: 
 2496:    return 0.0;
 2497: }
 2498: 
 2499: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2500: 
 2501: 
 2502: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2503: 
 2504:    const double w1 = getBoundaryArrayValueWeight();
 2505:    const double w2 = 1.0 - w1;
 2506:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2507:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2508: 
 2509:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2510: }
 2511: 
 2512: 
 2513: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2514:    const double w1 = getBoundaryArrayValueWeight();
 2515:    const double w2 = 1.0 - w1;
 2516:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2517:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2518: 
 2519:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2520: 
 2521: }
