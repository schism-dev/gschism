 7526: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7527:    // Get the value of a variable from an element
 7528:    // varName is the name of the variable to get
 7529:    // var is the array to store the value
 7530:    // k is the vertical level index of the variable to get
 7531: 
 7532:    ELEM(elem);
 7533:    
 7534:    int idx = elem->idx;
 7535:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7536: 
 7537:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7538:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7539:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7540:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7541:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7542:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7543:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7544:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7545:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7546:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7547:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7548:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7549:       
 7550:    
 7551: }
 7552: 
 7553: 
 7554: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7555:    // Get the value of a variable from an node
 7556:    // varName is the name of the variable to get
 7557:    // var is the array to store the value
 7558:    // k is the vertical level index of the variable to get
 7559: 
 7560:    NODE(node);
 7561:    
 7562:    int idx = node->idx;
 7563:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7564: 
 7565:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7566:    
 7567:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7568:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7569:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7570:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7571:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7572:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7573:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7574:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7575:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7576:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7577:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7578:    
 7579:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7580:       
 7581:    
 7582: }
 7583: 
 7584: 
 7585: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7586:    // Get the value of a variable from an side
 7587:    // varName is the name of the variable to get
 7588:    // var is the array to store the value
 7589:    // k is the vertical level index of the variable to get
 7590:    SIDE(side);
 7591:    
 7592:    int idx = side->idx;
 7593:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7594: 
 7595:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7596:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7597:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7598:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7599:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7600:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7601:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7602:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7603:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7604:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7605:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7606:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7607:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7608:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7609:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7610:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7611:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7612:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 7613:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7614:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7615:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7616:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7617:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7618:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7619:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7620:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7621:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7622:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7623:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7624:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7625:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7626:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7627:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7628:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7629:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7630:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7631: }
 7632: 
 7633: 
 7634: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7635:    // Get the value of a variable from an side
 7636:    // varName is the name of the variable to get
 7637:    // var is the array to store the value
 7638:    // k is the vertical level index of the variable to get
 7639:    SIDE_BND(sideBnd);   
 7640: 
 7641:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7642:    if (sideBnd->segment->isLand) idx = -7;
 7643: 
 7644:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7645:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7646: 
 7647: }
