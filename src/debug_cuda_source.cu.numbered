 3680: 
 3681: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3682:    // Computes the z coordinate at level k.
 3683:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3684:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3685:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3686:    // used 
 3687: 
 3688:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3689:    
 3690:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3691: 
 3692:    if (isDry2()) return 0.0;  
 3693: 
 3694:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3695: 
 3696:    if constexpr(ivcor == 2) {
 3697: 
 3698:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3699:       const double h_c = mesh->h_c;
 3700:       const double theta_f = mesh->theta_f;
 3701:       const double sinh_theta_f = mesh->sinh_theta_f;
 3702: 
 3703: 
 3704:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3705:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3706:       // once per time step/node. XXXX
 3707:       // CHECK: updateZCoordData
 3708: 
 3709:       //  To simplify comparisons, I define index versions of count variables.
 3710:       if      (k == ivrt)     return eta2; 
 3711:       else if (k == izlev)    return -hmod2;
 3712:       else if (k == kb)       return -depth;
 3713:       else if (k < izlev)     return mesh->ztot[k];
 3714:       else if (k > izlev) {
 3715:          const int ksig = k - izlev;
 3716: 
 3717:          if (hmod2 <= h_c) {
 3718:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3719: 
 3720:          } 
 3721:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3722:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3723:             assert(false && "compZCoord: invalid h_c\n");
 3724:          } 
 3725:          else {
 3726:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3727:                    h_c * mesh->sigma[ksig] + 
 3728:                    (hmod2 - h_c) * mesh->cs[ksig];
 3729:          }
 3730:       } else { 
 3731:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3732:       }
 3733: 
 3734:    }
 3735:    else {  // if constexpr(ivcor == 1)
 3736:       if (k <= kb)        return -depth; 
 3737:       else if (k == ivrt) return eta2;
 3738:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3739: 
 3740:    }
 3741:    
 3742:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3743:    return 0.0;
 3744: }
 3745: 
 3746: 
 3747: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3748:    // Computes the bottom drag Cd based on the selected nchi
 3749: 
 3750:    if constexpr(nchi == 0) {
 3751:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3752:       Cd = drag;  // Read from drag file
 3753: 
 3754:    } else if constexpr(nchi == 1) {
 3755:       // 
 3756: 
 3757:       bool ltmp = false; // for WBL iteration
 3758: 
 3759:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3760:       if (isDry || (rough == 0.0)) {
 3761:          Cd = 0.0;
 3762: 
 3763:       } else { //roughness >0 
 3764:          
 3765:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3766: 
 3767:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3768: 
 3769:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3770: 
 3771:       } // if rough
 3772: 
 3773:    } else if constexpr(nchi == -1) {
 3774:    // Manning 
 3775:  
 3776:       const double htot = max(hmin_man, htot2()); 
 3777:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3778: 
 3779:    } else {
 3780:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3781:       
 3782:    } // if nchi
 3783: 
 3784: }
 3785: 
 3786: 
 3787: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3788:    // Checks if a side in on the boundary
 3789:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3790: 
 3791:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3792:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3793: 
 3794:    // Indices of the nodes that form the side
 3795:    //
 3796:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3797:    const int n1 = side.n1->idx;
 3798:    const int n2 = side.n2->idx;
 3799:    isLand = false;
 3800:    
 3801: 
 3802:    // Check if the side is on a land boundary
 3803:    for (int i = 0; i < nland; i++) {
 3804:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3805:          // Consecutive nodes in the land boundary segment
 3806:          const int b1 = ilnd[i + j*nland];
 3807:          const int b2 = ilnd[i + (j + 1)*nland];
 3808: 
 3809:          assert(b1 != -1 && b2 != -1);
 3810: 
 3811:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3812:             
 3813:             isLand = true;
 3814:             return i;
 3815:          }
 3816:       }
 3817:    }
 3818: 
 3819:    // Check if the side is on an open boundary
 3820:    for (int i = 0; i < nope; i++) {
 3821:       for (int j = 0; j < nond[i] - 1; j++) {
 3822:          // Consecutive nodes in the open boundary segment
 3823:          const int b1 = iond[i + j*nope];
 3824:          const int b2 = iond[i + (j + 1)*nope];
 3825: 
 3826:          assert(b1 != -1 && b2 != -1);
 3827: 
 3828:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3829:             isLand = false;
 3830:             return i;
 3831:          }
 3832:       }
 3833:    }
 3834: 
 3835:    // Check that the nodes are not both on the boundary
 3836:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 3837:         && "side not in ilnd/iond but both nodes are boundary" );
 3838: 
 3839:    return -1;
 3840: }
 3841: 
 3842: 
 3843: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3844:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3845:                                     double *wind_rotate_angle, 
 3846:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3847:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3848:                                     int16_t *nodePermutationSort, double *crs_data,
 3849:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 3850:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3851:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3852:                                     int *localNodePart,     int *localElemPart,     int *localSidePart, 
 3853:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3854: 
 3855:    NODE(pnode);  
 3856:    const int i = idx_node;
 3857:    const int iglobal = globalNodeIndices[i];
 3858:    Node &node(*pnode);
 3859: 
 3860:    node.idx = iglobal;
 3861:    node.part = localNodePart[iglobal];
 3862: 
 3863:    // It is important to differentiate between the global and local "start" indices because they
 3864:    // play different, but related, roles in this code. The global "start" indices are used
 3865:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 3866:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 3867:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 3868:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 3869:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 3870:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 3871:    node.numNodes = idxNodeEnd - idxNodeStart;
 3872:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 3873: 
 3874:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 3875:    node.coeffRow = crs_data + rowStart; 
 3876: 
 3877:    node.csrSlot = nodePermutationSort + idxNodeLocalStart;
 3878: 
 3879: 
 3880: 
 3881:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 3882:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 3883:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 3884:    node.numElements = idxElemEnd - idxElemStart;
 3885:    node.elements = nodeNeighElems + idxElemLocalStart;
 3886: 
 3887: 
 3888:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 3889:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3890:       const int partNode = localNodePart[idxNodeGlobal]; 
 3891:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3892: 
 3893:       Node *node_ptr = nodes[partNode] + idxNode;
 3894:       
 3895:       nodeNeighNodes[idxLocal] = node_ptr;
 3896:    }
 3897: 
 3898: 
 3899:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 3900:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3901:       const int partElem = localElemPart[idxElemGlobal];
 3902:       const int idxElem  = localElemIndices[idxElemGlobal];
 3903: 
 3904:       Element *elem_ptr = elems[partElem] + idxElem;
 3905: 
 3906:       nodeNeighElems[idxLocal] = elem_ptr;
 3907:    }      
 3908: 
 3909:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3910:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3911: 
 3912:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3913: 
 3914:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3915:    if constexpr(ics == 1) {
 3916:       node.p.x   = node_coords[i * 3];
 3917:       node.p.y   = node_coords[i * 3 + 1];
 3918:       node.gz = 0.0;
 3919: 
 3920:       if (use_ll) {                                    // <-- add
 3921:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3922:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3923:       }  
 3924: 
 3925:    } else {
 3926:       const double lon = deg2rad*node_coords[i * 3];
 3927:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3928: 
 3929:       Point3 p = computeXYZfromLatLon(lat, lon);
 3930:       node.p = toVector2(p);
 3931:       node.gz = p.z;
 3932:       node.lon = lon;
 3933:       node.lat = lat;
 3934: 
 3935:       #ifdef USE_FRAMES
 3936:       node.setFrame(lat, lon);
 3937:       #endif
 3938: 
 3939: 
 3940:    }
 3941: 
 3942:    node.depth = node_coords[i * 3 + 2];
 3943: 
 3944:    node.numSides = 0;
 3945: 
 3946:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3947:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 3948:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 3949:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 3950:    else assert(false && "populateNodes: selected nchi not implemented.");
 3951: 
 3952:    if constexpr(ivcor == 1) 
 3953:    {  
 3954:       node.kb = kb[iglobal];
 3955: 
 3956:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 3957:    }
 3958: 
 3959:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3960:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3961:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3962: 
 3963:    
 3964:    // Links the node to the boundary information
 3965:    if (isbnd[iglobal] >= 0) {
 3966:      
 3967:       // Get the index of the node boundary
 3968:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3969: 
 3970:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3971:       node.nodeBnd->node = &node;
 3972: 
 3973:       node.nodeBnd->sideBnd1 = nullptr;
 3974:       node.nodeBnd->sideBnd2 = nullptr;
 3975: 
 3976:       if (isbnd[iglobal]>=0) {
 3977: 
 3978:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 3979:          
 3980:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3981:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3982: 
 3983:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3984:          node.nodeBnd->segment->clen  = nan("1");
 3985:          node.nodeBnd->segment->carea = nan("1");
 3986: 
 3987:       }
 3988:    } else {
 3989: 
 3990:       node.nodeBnd = nullptr; // For internal nodes
 3991: 
 3992:       if (isbnd[iglobal] == landSegment) {
 3993:          node.nodeBnd = landBoundaryNode;
 3994:          node.nodeBnd->segment = landBoundarySegment;
 3995:       }
 3996:       
 3997:    }
 3998:    
 3999:    // XXXX GAUSSIAN HILL VELOCITIES
 4000:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4001:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4002:          constexpr double rot_per = 3000.0;
 4003:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4004:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4005:       // XXXXX
 4006:    #endif
 4007: 
 4008: }
 4009: 
 4010: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4011:    
 4012:    NODE(node);
 4013:    const int localIdx = idx_node;
 4014: 
 4015: 
 4016:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4017:    int16_t *csrSlot = node->csrSlot;  
 4018: 
 4019:    // Simply count the number of nodes with a smaller global index than the current node.
 4020:    // It accounts for the diagonal element.
 4021:    // packedIndex is a special type of global index in which nodes are counted in the order as the
 4022:    // local index, but taking into account all the partitions (in order).
 4023:    for (int i = 0; i < node->numNodes; ++i) {
 4024:       const int col = node->nodes[i]->packedIndex();
 4025:       int16_t idx = 0;
 4026: 
 4027:       //Takes care of the diagonal element.
 4028:       if (node->packedIndex() < col) ++idx;          
 4029: 
 4030:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->packedIndex() < col) ++idx;
 4031:       csrSlot[i] = idx;
 4032:    }
 4033: 
 4034:    // Find the diagonal element in the CRS matrix.
 4035:    int16_t idxDiag = 0;
 4036:    for (int j = 0; j < node->numNodes; ++j)
 4037:       if (node->nodes[j]->packedIndex() < node->packedIndex()) ++idxDiag;
 4038: 
 4039:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4040: 
 4041:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4042:    const int idxNodeLocalStart = localNodeNeighNodesStart[localIdx];
 4043: 
 4044:    const int rowStart = idxNodeLocalStart + localIdx;  // +i is to account for the diagonal element.
 4045:    const int rowNNZ = node->numNodes + 1;        // +1 is to account for the diagonal element.
 4046:    crs_indptr[localIdx] = rowStart;
 4047: 
 4048:    // Fills crs_indices array using the per-partition indexing.
 4049:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4050:    crs_indices[rowStart + d] = node->packedIndex();  
 4051:    for (int j = 0; j < node->numNodes; ++j) {
 4052:       Node *nb = node->nodes[j];
 4053:       crs_indices[rowStart + node->csrSlot[j]] = nb->packedIndex();
 4054:    }
 4055: 
 4056: 
 4057: }
 4058: 
 4059: 
 4060: 
 4061: 
 4062: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4063:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4064:                                     double *wind_rotate_angle,   
 4065:                                     int *isdel, int *isidenode, int *isbnd,
 4066:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4067:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4068:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4069:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4070:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4071:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4072:                                     double *drag, double *roughness) {
 4073: 
 4074: 
 4075:    SIDE(pside);
 4076:    Side &side(*pside);
 4077:    const int i = idx_side;
 4078:    const int iglobal = globalSideIndices[i];
 4079:    side.idx = iglobal;  
 4080:    
 4081:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4082:    const double fc   = 2.0*omega_e*sin(sfea0);
 4083:    const double beta = 2.0*omega_e*cos(sfea0);
 4084: 
 4085:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4086: 
 4087:    // finding the pointer to the nodes that form the side
 4088:    const int idx_n1 = isidenode[iglobal*2];
 4089:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4090: 
 4091: // if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4092: 
 4093:    const int locidx_n1 = localNodeIndices[idx_n1];
 4094:    const int locidx_n2 = localNodeIndices[idx_n2];
 4095:    const int part_n1 =   localNodePart[idx_n1];
 4096:    const int part_n2 =   localNodePart[idx_n2];
 4097: 
 4098: // if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4099: // if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4100: 
 4101:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4102:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4103: 
 4104: // if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4105: 
 4106:    // Counts the number of sides connected to each node
 4107:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4108:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4109: 
 4110:    // Side boundary type
 4111:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4112:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4113: // if (i == 0) printf("populateSides: 2\n");
 4114: 
 4115:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4116:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4117:    {
 4118:       bool isLand = false;
 4119:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4120:       
 4121:       if (isbs > -1) {
 4122:          // assert(isLand || isbs>=0);
 4123:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4124: 
 4125:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4126: 
 4127:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4128:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4129: 
 4130:          assert (isLand == side.sideBnd->segment->isLand);
 4131:          
 4132:          side.sideBnd->side = &side;
 4133: 
 4134:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4135:          n1bnd->linkSideBoundary(side.sideBnd);
 4136:          n2bnd->linkSideBoundary(side.sideBnd);
 4137: 
 4138:       }
 4139:       else {
 4140:          side.sideBnd = nullptr;
 4141:       }
 4142:    }
 4143:    else 
 4144:    {
 4145:       side.sideBnd = nullptr;
 4146:    }
 4147: 
 4148: // if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4149: 
 4150:    // finding the pointer to the elements that share the side
 4151:    const int idx_e1 = isdel[iglobal*2];
 4152:    const int idx_e2 = isdel[iglobal*2 + 1];
 4153: 
 4154:    if (idx_e1 > -1) {
 4155:       const int locidx_e1 = localElemIndices[idx_e1];
 4156:       const int part_e1 =  localElemPart[idx_e1];
 4157:       side.elems[0] = elems[part_e1] + locidx_e1;
 4158: 
 4159:    }
 4160:    else {
 4161:       side.elems[0] = nullptr;
 4162:    }
 4163: 
 4164: // if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4165: 
 4166:    if (idx_e2 > -1) {
 4167:       const int locidx_e2 = localElemIndices[idx_e2];
 4168:       const int part_e2 =  localElemPart[idx_e2];
 4169:       side.elems[1] = elems[part_e2] + locidx_e2;
 4170:    }
 4171:    else {
 4172:       side.elems[1] = nullptr;
 4173:    }
 4174: 
 4175: // if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4176: 
 4177:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4178:       
 4179:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4180:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4181:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4182:          
 4183:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4184:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4185:       // printf("sideBnd: %p\n", side.sideBnd);
 4186:       // assert(false && "Side has no elements and no boundary");
 4187:    }
 4188:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4189: 
 4190:    // Compute the center of the side
 4191:    side.center = 0.5*(side.n1->p + side.n2->p);
 4192: 
 4193:    #ifdef USE_FRAMES
 4194:    side.setFrame();
 4195:    #endif
 4196: 
 4197: // if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4198: 
 4199:    // Normal, unitary vector to the side
 4200:    if constexpr(ics == 1) {
 4201:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4202:       side.n = normalize(side.n);
 4203:    }
 4204:    else {
 4205:       // Unit side vector in 3D cartesian coordinates
 4206:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4207: 
 4208:       nSide = normalize(nSide);
 4209: 
 4210:       // Its cross product with the unit local z-axis vector (nUp) is the
 4211:       // normal vector we are looking for.
 4212:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4213: 
 4214:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4215:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4216:       side.n = -normalize(n2D); 
 4217: 
 4218:    }
 4219: 
 4220: // if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4221: 
 4222:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4223:    side.shapiro = shapiro0;
 4224: 
 4225:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4226:    // XXXX
 4227:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4228:    constexpr double rot_per=3000.0;
 4229:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4230:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4231:    // XXXXX      
 4232:    #endif
 4233:    // Compute the z level at the center of the side
 4234:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4235:    
 4236:    // Compute the length of the side
 4237:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4238: 
 4239: // if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4240: 
 4241:    // Compute the Coriolis coefficient
 4242: 
 4243:    if constexpr(ncor == -1 || ncor == 0) {
 4244:       side.coriolis = coricoef;
 4245:    }
 4246:    else {
 4247:       const double sphi = side.lat();  // Latitude at the center of the side
 4248: 
 4249:       assert(use_ll && "use_ll must be true when ncor > 0");
 4250: 
 4251:       if constexpr(ics == 1) {
 4252:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4253:       }
 4254:       else { // ics == 2
 4255:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4256:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4257:       }
 4258: 
 4259:    }
 4260: 
 4261: // if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4262: 
 4263: }
 4264: 
 4265: 
 4266: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4267:    double *node_coords, double *node_coords_ll, bool use_ll,
 4268:    double *wind_rotate_angle,   
 4269:    int *isdel, int *isidenode, int *isbnd,
 4270:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4271:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4272:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4273:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4274:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4275:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4276:    double *drag, double *roughness) {
 4277: 
 4278:    ELEM(pelem);
 4279:    Element &elem(*pelem);
 4280:    const int i = idx_elem;
 4281: 
 4282:    elem.idx = i;
 4283: 
 4284:    for (int j = 0; j < i34[i]; j++) {
 4285:       const int idxNode = elnode[i*4 + j];  
 4286:       const int idxSide = elside[i*4 + j];
 4287:       
 4288:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4289:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4290: 
 4291:       // Find the neighboring element  
 4292:       if (elem.sides[j]->elems[0] == &elem) {
 4293:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4294:       }
 4295:       else {
 4296:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4297:       }
 4298:       
 4299:    }
 4300: 
 4301:    elem.i34 = i34[i];
 4302: 
 4303:    // Compute the barycenter of the element and its depth
 4304:    elem.center = {0.0, 0.0};
 4305:    elem.depth = 1e10;
 4306:    for (int j = 0; j < i34[i]; j++) {
 4307: 
 4308:       elem.center += elem.nodes[j]->p/i34[i];
 4309:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4310:    }
 4311: 
 4312:    #ifdef USE_FRAMES
 4313:    elem.setFrame();
 4314:    #endif
 4315: 
 4316:    elem.area = elem.computeSignedArea(); 
 4317:    elem.radius = sqrt(elem.area)/pi; 
 4318:    
 4319:    // Determines which way the normal vector to each side is oriented.
 4320:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4321:    for (int j = 0; j < i34[i]; j++)  
 4322:    {
 4323:       if (elem.sides[j]->elems[0] == &elem) {
 4324:          elem.ssign[j] =  1.0;
 4325:       }
 4326:       else {
 4327:          elem.ssign[j] = -1.0;
 4328:       }
 4329: 
 4330:    }
 4331: 
 4332:   
 4333: 
 4334:    // Derivatives of shape functions
 4335:    //  For ics=2, this is done in the element frame
 4336:    //  For quads, the derivative is evaluated at centroid
 4337:    for (int j = 0; j < elem.i34; j++) {
 4338:       const double area = elem.area;
 4339:       const int id2 = elem.nxq(1 + j);
 4340:       const int id3 = elem.nxq(2 + j);
 4341:       const int id4 = elem.nxq(3 + j);
 4342:       if (elem.isTri()) {
 4343:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4344:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4345:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4346:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4347:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4348:          // And so on for the other shape functions.
 4349: 
 4350:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4351:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4352:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4353: 
 4354:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4355:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4356: 
 4357:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4358: 
 4359:       }
 4360:       else  { // Quad, the derivatives are evaluated at the centroid
 4361: 
 4362:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4363:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4364:          // ...
 4365:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4366: 
 4367:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4368:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4369:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4370: 
 4371:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4372:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4373: 
 4374:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4375: 
 4376:       } // if Tri/Quad
 4377: 
 4378:    } // for j   
 4379:    
 4380:    
 4381: 
 4382: }
 4383: 
 4384: 
 4385: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4386:                                             double *emo, double *efa, 
 4387:                                             double *umo, double *ufa, 
 4388:                                             double *vmo, double *vfa,
 4389:                                             int *ifltype, int *iettype) {
 4390: 
 4391:    NODE_BND(nodeBnd);
 4392:    const int idx = idx_node_bnd;    
 4393: 
 4394:    nodeBnd->idx = idx;
 4395: 
 4396:    // Need to find the segment index and the index of the node on the segment
 4397:    int idxNode = -1;
 4398:    int iseg, i;
 4399:    for (iseg = 0; iseg < nope; iseg++) {
 4400:       // for each segment...
 4401:       for (i = 0; i < nond[iseg]; i++) {
 4402:          idxNode = iond[iseg + i*nope];
 4403:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4404:          
 4405:       }
 4406:    }
 4407: 
 4408:    assert(iseg < nope && "iseg is out of bounds");
 4409: 
 4410: found: // Jumped here when the node was found
 4411: 
 4412:    nodeBnd->isEssentialBC = true;
 4413:    nodeBnd->elbc = 0.0;
 4414: 
 4415:    nodeBnd->segment->ifltype = ifltype[iseg];
 4416:    nodeBnd->segment->iettype = iettype[iseg];
 4417: 
 4418:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4419: 
 4420:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4421: 
 4422:       nodeBnd->efa[jfr] = efa[idx2];
 4423:       nodeBnd->emo[jfr] = emo[idx2];
 4424:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4425:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4426: 
 4427:    }
 4428:         
 4429: 
 4430: }
 4431: 
 4432: __device__ void Mesh::populateBoundarySideLinks(void) {
 4433: 
 4434:    SIDE_BND(sideBnd);
 4435: 
 4436:    const Side *side = sideBnd->side;
 4437: 
 4438:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4439:    // and the rightSide is the side s that has s->n1 == side->n2
 4440:    for (int i = 0; i < mesh->nbs; i++) {
 4441: 
 4442:       Side *s = &mesh->localSideData[i];
 4443: 
 4444:       if (s == side) continue;  // Do not link the side to itself
 4445:    
 4446:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4447:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4448:    }
 4449:    
 4450: }
 4451: 
 4452: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4453:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4454:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4455:                 int *isdel, int *isidenode, int *isbnd,
 4456:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4457:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4458:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4459:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4460:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4461:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4462:                 double *drag, double *roughness,
 4463:                 double *emo, double *efa, 
 4464:                 double *umo, double *ufa, 
 4465:                 double *vmo, double *vfa) {
 4466: 
 4467:    printf("Populating mesh for partition %d\n", partNum);
 4468: 
 4469:    // XXXXXX THIS function does almost nothing. 
 4470: 
 4471:    nbs = *sharedIdxSideBoundary + 1;
 4472:    nbp = *sharedIdxNodeBoundary + 1;
 4473: 
 4474:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4475: 
 4476: }
