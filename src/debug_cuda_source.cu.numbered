 4463: extern "C" {
 4464: 
 4465:    __global__ void scaleGravity(double loadtide_coef) {
 4466: 
 4467: 
 4468:       NODE(node);
 4469: 
 4470:       // SAL option: scale gravity
 4471:       if constexpr(iloadtide==2) {  // simple const
 4472:          node->grav2 = grav*(1.0 - loadtide_coef);
 4473: 
 4474:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4475:         
 4476:           const double depth = max(node->depth, 0.0);
 4477:           const double tmp1 = sqrt(depth);
 4478:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4479:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4480:                              2.6969e-13*depth*depth*depth*tmp1;
 4481:           
 4482:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4483:           
 4484: 
 4485: 
 4486:           node->grav2 = grav*(1.0 - beta_bar);
 4487: 
 4488:       } else {  // iloadtide=0,1
 4489:         node->grav2=grav;
 4490: 
 4491:       }
 4492: 
 4493:    }
 4494: 
