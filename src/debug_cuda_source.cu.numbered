 1766: // Convenience macros for accessing the objects in kernels.
 1767: 
 1768: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1769:                    Side *side = &(mesh->localSideData[idx_side]); \
 1770:                    if (idx_side >= mesh->ns) return;
 1771: 
 1772: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1773:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1774:                    if (idx_elem >= mesh->ne) return;
 1775: 
 1776: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1777:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1778:                    if (idx_node >= mesh->np) return;
 1779: 
 1780: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1781:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1782:                               const bool valid = (idx_node < mesh->np);                   
 1783: 
 1784: 
 1785: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1786:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1787:                            if (idx_node_bnd >= mesh->nbp) return;
 1788: 
 1789: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1790:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1791:                            if (idx_side_bnd >= mesh->nbs) return;                           
