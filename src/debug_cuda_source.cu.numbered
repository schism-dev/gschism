  961: struct Side {
  962: 
  963:    // Geometry information
  964:    int idx;               // Index of the side
  965:    Node *n1, *n2;
  966:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  967: 
  968:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  969:    Vector2 center;        // Location of side center. 
  970:    double zc[nvrt];       // Side center z-coord at each vertical level
  971: 
  972:    Frame frame;
  973: 
  974:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  975:                           // this is nullptr
  976:    
  977:    int kb;                // Bottom index of the side
  978:    bool isDry;            // True if the side is dry
  979:  
  980:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  981: 
  982:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  983: 
  984:    // Physical information
  985:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  986:    double  w2[nvrt];            // Vertical velocity at each vertical level
  987:    Vector2 btu[nvrt];           // Back-tracked velocity
  988:    Vector2 U;                   // Vertically averaged velocity vector  
  989: 
  990:    Vector2 nuGradU[nvrt];          // nu*grad u
  991: 
  992:    Vector2 bcc[nvrt];           // Baroclinic term
  993:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  994: 
  995:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  996:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  997:    Vector2 gradPr;               // Gradient of pressure
  998:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  999: 
 1000: 
 1001:    double hhat;                 // \breve{H} in notes
 1002: 
 1003:    double shapiro;
 1004: 
 1005:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1006: 
 1007:    double coriolis;             // Coriolis parameter
 1008: 
 1009:    // Vegetation parameters
 1010:    double veg_c2;
 1011:    double veg_beta;
 1012: 
 1013:    // Bottom drag parameters.
 1014:    double chi;
 1015:    double chi2;
 1016: 
 1017:    __inline__ __device__ double x(double t) const;
 1018:    __inline__ __device__ double y(double t) const;
 1019:    __inline__ __device__ double lon(void) const;
 1020:    __inline__ __device__ double lat(void) const;
 1021:    __inline__ __device__ Point2 p_t(double t) const;
 1022: 
 1023:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1024:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1025:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1026: 
 1027:    __inline__ __device__ Side* neigh(int index) const { 
 1028:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1029:       assert(index >= 0 && index < 4); 
 1030:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1031: 
 1032:       const int ielem = index & 1;           // 0 or 1
 1033:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1034: 
 1035:       const Element* elem = elems[ielem];
 1036: 
 1037:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1038: 
 1039:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1040: 
 1041:    }
 1042: 
 1043:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1044: 
 1045:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1046: 
 1047:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1048:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1049:    __inline__ __device__ int iadv(void) const;
 1050: 
 1051:    __inline__ __device__ double grav3(void) const;
 1052:    
 1053:    __inline__ __device__ double eta2(void) const;
 1054:    __inline__ __device__ double eta1(void) const;
 1055:    __inline__ __device__ double depth(void) const;
 1056:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1057:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1058: 
 1059:    __inline__ __device__ double dfv(int k) const;
 1060: 
 1061:    __inline__ __device__ double veg_h(void)  const;
 1062:    __inline__ __device__ double veg_nv(void) const;
 1063:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1064:    __inline__ __device__ double veg_alpha3D(int k) const;
 1065:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1066: 
 1067:    __inline__ __device__ double Cd(void) const;
 1068: 
 1069:    __inline__ __device__ Vector2 tau(void) const;
 1070: 
 1071:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1072:    
 1073: 
 1074:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1075:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1076:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1077:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1078:    } 
 1079:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1080:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1081:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1082:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1083: 
 1084:    // Get valid starting element (for backtracking)
 1085:    __inline__ __device__ Element* getStartElement() {
 1086:       return elems[0] ? elems[0] : elems[1];
 1087:    }
 1088: 
 1089:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1090:       // From the elements that share this side, find the one that is in the direction opposite to the velocity vector
 1091:       // (unless it is a boundary side or a dry element, in which case we return the only wet element)
 1092: 
 1093:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1094: 
 1095:       // Dot product of the negative velocity vector with the side normal vector
 1096:       const double dot_prod1 = -dot(u, n);
 1097: 
 1098:       // Vector from side center to element 0 centroid
 1099:       const Vector2 v2 = elems[0]->center - center;
 1100: 
 1101:       // Dot product of the vector with the side normal vector
 1102:       const double dot_prod2 = dot(v2, n);
 1103: 
 1104:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1105:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1106: 
 1107:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1108:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1109: 
 1110:       assert(!isDry0 || !isDry1 && "Both elements are dry in findElementTowards");
 1111: 
 1112:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : elems[1];
 1113:       else                           return !isDry1 ? elems[1] : elems[0];
 1114: 
 1115:  
 1116:    }
 1117: 
 1118:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1119:       // Given an element, returns the other element that shares this side
 1120:       return (elems[0] == elem) ? elems[1] : elems[0];
 1121:    }
 1122: 
 1123:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1124:       // Given a node, returns the other node that shares this side
 1125:       return (n1 == node) ? n2 : n1;
 1126:    }
 1127:  
 1128:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1129: 
 1130: 
 1131: 
 1132: 
 1133: };
