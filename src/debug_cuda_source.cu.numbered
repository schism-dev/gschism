 1971: struct Mesh {
 1972:    public:  
 1973: 
 1974:    int partNum; // Partition number for this mesh.
 1975: 
 1976:    // Pointers to each GPU's local memory (size is the number of partitions).
 1977:    Node**    nodes;  
 1978:    Element** elems;  
 1979:    Side**    sides;  
 1980:    
 1981:    // Local memory
 1982:    Node*    localNodeData; 
 1983:    Element* localElemData;
 1984:    Side*    localSideData; 
 1985: 
 1986:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1987:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1988:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1989:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1990:    
 1991:    const int npgb;  // Global number of horizontal nodes
 1992:    const int negb;  // Global number of elements
 1993:    const int nsgb;  // Global number of sides
 1994: 
 1995:    const int np;   // Local number of horizontal nodes 
 1996:    const int ne;   // Local number of elements
 1997:    const int ns;   // Local number of sides
 1998: 
 1999:    int nbp;  // Local number of boundary nodes
 2000:    int nbs;  // Local number of boundary sides
 2001: 
 2002:    int nEntries;  // Total number of matrix elements
 2003: 
 2004:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 2005:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 2006:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 2007: 
 2008:   
 2009:    // Additional topology information
 2010:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 2011:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 2012:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 2013: 
 2014:    BoundarySegment *landBoundarySegment;
 2015:    NodeBoundary *landBoundaryNode;
 2016: 
 2017:    // Vertical coordinate system
 2018:    // Sigma levels
 2019:    double h_s; 
 2020:    double h_c; 
 2021: 
 2022:    double theta_b;
 2023:    double theta_f, sinh_theta_f;
 2024:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 2025:    double *ztot;
 2026:    double *cs;
 2027:    double *dcs;
 2028: 
 2029: 
 2030: 
 2031:    __device__ Mesh(int partNum,
 2032:                    int npgb, int negb, int nsgb, 
 2033:                    int np, int ne, int ns,
 2034:                    int max_np, int max_ne, int max_ns, int nseg,
 2035:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 2036:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 2037:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 2038:                    Node    **localNodeNeighNodesMem,
 2039:                    Element **localNodeNeighElemsMem,
 2040:                    int16_t *localNodePermutationSortMem,
 2041:                    double *partCoeffMatrixMem,
 2042:                    NodeBoundary *localNodeBoundaryMem,
 2043:                    SideBoundary *localSideBoundaryMem,
 2044:                    BoundarySegment *localSegmentMem,
 2045:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 2046:                    double *cs, double *dcs
 2047:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 2048:                        np(np), ne(ne), ns(ns),
 2049:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 2050:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 2051:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 2052:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 2053:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 2054:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 2055:                        localSegmentMem(localSegmentMem),
 2056:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 2057:                        cs(cs), dcs(dcs),
 2058:                        landBoundarySegment(plandSegMem),
 2059:                        landBoundaryNode(plandNodeBndMem)
 2060:    {
 2061:       printf("Mesh constructor for partition %d\n", partNum);
 2062: 
 2063:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 2064:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 2065:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 2066:  
 2067:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2068:       
 2069:       sinh_theta_f = sinh(theta_f);
 2070: 
 2071:       *landBoundaryNode    = NodeBoundary(true);
