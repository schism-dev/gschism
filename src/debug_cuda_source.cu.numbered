 1207: struct Node {
 1208: 
 1209:    // Geometry information
 1210:    int idx;        // Index of the node
 1211:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1212:    int numNodes;   // Number of nodes neighbors of this node
 1213: 
 1214:    Element **elements; // Array of pointers to the elements that share this node
 1215:    int numElements;    // Number of elements that share this node
 1216: 
 1217:    int numSides;       // Number of sides that are connected to this node
 1218: 
 1219:    Point2 p;
 1220:    Vector2 u2[nvrt];
 1221:    double  w2[nvrt];
 1222:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1223:    double z[nvrt];
 1224:    double lon, lat;
 1225:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1226:    double depth;
 1227: 
 1228:    int kb;       // Bottom index of the node
 1229: 
 1230:    bool isDry;     // True if the node is dry
 1231: 
 1232:    int iadv;     // Advection flag
 1233: 
 1234:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1235:                           // this is nullptr
 1236: 
 1237:    TempVar tmp; // Temporary variable to store different types of variables
 1238: 
 1239:    // Physical information
 1240:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1241:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1242: 
 1243:    double rho[nvrt];     // Density
 1244:    double dfv[nvrt];     // Vertical viscosity
 1245: 
 1246:    double eta1; // Elevation at nodes at previous timestep
 1247:    double eta2; // Elevation at nodes at current timestep
 1248: 
 1249:    double ETP;  // Earth Tidal Potential
 1250: 
 1251:    double pr;    // Air pressure
 1252:    double grav2; // Gravity 
 1253:    
 1254:    Vector2 dav;  // Depth averaged velocity
 1255: 
 1256:    Vector2 tau; // Wind stress vector
 1257: 
 1258:    // Vegetation parameters
 1259:    double veg_h;
 1260:    double veg_nv;
 1261:    double veg_di;
 1262:    double veg_Cd;
 1263:    double veg_h_unbent;
 1264:    double veg_di_unbent;
 1265:    double veg_nv_unbent;
 1266:    double veg_alpha_vert_mean;
 1267:    double veg_alpha0;
 1268:    double veg_alpha3D[nvrt];
 1269: 
 1270:    // Bottom drag parameters
 1271:    double Cd;       // Bottom drag coefficient   
 1272: 
 1273:    // These three are mutually exclusive
 1274:    union {
 1275:       double rmanning; // Bottom Manning's coefficient
 1276:       double rough;    // Bottom roughness length
 1277:       double drag;     // Bottom drag coefficient
 1278:    };
 1279:    Vector2 tau_bot; // Bottom stress vector
 1280: 
 1281:    double bdef1; // Bottom deformation at previous timestep
 1282:    double bdef2; // Bottom deformation at current timestep
 1283: 
 1284:    double qel; // RHS
 1285:    double coeffDiag; // Diagonal coefficient of the matrix
 1286:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1287: 
 1288:    double mP; // Search direction for conjugate gradient method
 1289:    double mR; // Residual for conjugate gradient method
 1290:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1291:    double mX; // Solution for conjugate gradient method
 1292: 
 1293:    // Meteorological forcing
 1294:    Vector2 u_air;
 1295:    double p_air;
 1296:    double t_air;
 1297:    double q_air;
 1298:    double wind_angle;  // Wind rotation angle
 1299: 
 1300:    __device__ void setWind(Vector2 &u) {
 1301:    // Sets the wind vector taking into account the mesh angle
 1302:    
 1303:       const double dir = atan2(-u.x,-u.y);
 1304:       const double speed = length(u);
 1305: 
 1306:       // Calculate new u and v components with added rotation angle
 1307:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1308: 
 1309:       // Sets the surface stress vector due to wind.
 1310:       if constexpr(nws == 0) {
 1311:          tau = {0.0, 0.0};
 1312: 
 1313:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1314:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1315: 
 1316:       } else {
 1317: 
 1318:          double dragcoef;
 1319: 
 1320:          if constexpr(iwind_form == -1) {
 1321:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1322:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1323: 
 1324:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1325:             tau = cff*u_air;
 1326:  
 1327:          } else if constexpr(iwind_form == 1) {
 1328:             if (speed <= 35.0) dragcoef = 1.0e-4*(-0.016*speed*speed + 0.967*speed + 8.058);
 1329:             else               dragcoef = 2.23e-3*35.0/speed;
 1330: 
 1331:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1332:             tau = cff*u_air;
 1333: 
 1334:          } else {
 1335:             tau = {0.0, 0.0};
 1336:          }
 1337:       }
 1338:    }
 1339: 
 1340: 
 1341:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1342: 
 1343:    __device__ double sigmaTransitionDepth(void) const;
 1344: 
 1345:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1346:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1347:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1348:    
 1349:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1350: 
 1351:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1352: 
 1353:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1354:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1355: 
 1356:    __device__ __forceinline__ void clearMatrixRow(void) {
 1357:       // Clear the matrix row for this node
 1358: 
 1359: 
 1360:       coeffDiag = 0.0;
 1361: 
 1362:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1363: 
 1364:    }
 1365: 
 1366:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1367:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1368:       
 1369:       if (node == this) {
 1370:          coeffDiag += value;
 1371:      
 1372:       } else {
 1373:          // Search (linearly)the index of the node in the array of nodes
 1374:          // XXX: This is not efficient, see if we can improve this
 1375:          int i;
 1376:          for (i = 0; i < numNodes; i++) {
 1377:             if (nodes[i] == node) {
 1378:                break;
 1379:             }
 1380:          }
 1381:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1382:          coeffMatrix[i] += value;
 1383:       }
 1384:    }
 1385: 
 1386: 
 1387:    __device__ __inline__ void updateZCoordData(void);
 1388: 
 1389:    __device__ double compZCoord(int k) const;
 1390: 
 1391:    __device__ void updateKb(void);
 1392: 
 1393:    __device__ __forceinline__ void computeBottomDragCd(void);
 1394: 
 1395: 
 1396: 
 1397: };
