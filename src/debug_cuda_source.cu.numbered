 4607:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4608: 
 4609:       SIDE(side);
 4610: 
 4611:       side->U = {0.0, 0.0}; 
 4612:          
 4613:       if(side->isDry) return;
 4614: 
 4615:       // Vertically integrated velocity U (in ll if ics=2)
 4616:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4617:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4618:          side->U += side->Dz(k + 1)*uc;  
 4619:       }
 4620: 
 4621:    }
 4622: 
 4623:    __global__ void computeBottomDragVegetation(void) {
 4624:       // UNFINISHED. CHECK THIS:
 4625:       // How many kernels are needed? Why so many for loops?
 4626:       // Is the loop on sides needed?
 4627: 
 4628:       NODE(node);
 4629: 
 4630: 
 4631:       const int    kb      = node->kb;
 4632:       const double htot    = node->htot2(); 
 4633:       
 4634:       if (node->isDry) {
 4635:          // Default values for dry nodes
 4636:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4637:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4638: 
 4639:          return;
 4640:        
 4641:       }
 4642: 
 4643:       // Computes bottom drag Cd based on the selected nchi
 4644:       node->computeBottomDragCd();
 4645:       
 4646: 
 4647: 
 4648:       //   Bottom stress in m^2/s^2
 4649:       if (node->rho[kb + 1] >= -98.0)
 4650:       {
 4651:          const double mag_u = length(node->u2[kb + 1]);
 4652:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4653: 
 4654:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4655:          // !sediment erosion: this part needs more documentation
 4656:       }
 4657:     
 4658: 
 4659: 
 4660:       // Compute vegetation parameters
 4661:       //--------------------------------
 4662: 
 4663:       // SAV constants
 4664:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4665:       constexpr double veg_cfpsi = 0.16;
 4666: 
 4667:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4668:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4669: 
 4670:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4671:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4672:          int kbin = 0; // bin index
 4673:          for (int k = kb; k < nvrt; k++) {
 4674:             // Computes node height above the bottom level
 4675:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4676:             assert(false && "Vertical variation of vegetation not implemented");
 4677: 
 4678:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4679:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4680:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4681:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4682:             // } else {
 4683:             //    // Find the bin at which the current vertical level is
 4684:             //    while (kbin<nbins_veg_vert) {
 4685:             //       const double zn = node->z[kbin];
 4686:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4687:             //          break;
 4688:             //       } // if
 4689:             //       kbin++;
 4690:             //    } // while
 4691:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4692: 
 4693:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4694:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4695:                
 4696:             //    // Linear interpolation of the vegetation parameters
 4697:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4698:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4699:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4700:             // } // if rl10
 4701: 
 4702:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4703: 
 4704:          } // for k
 4705: 
 4706: 
 4707:       } else { // Ganthy (iveg==2)
 4708:       //  Modify canopy height, diameter, and density
 4709: 
 4710:          // Make sure there is vegetation on this node
 4711:          if (node->veg_h_unbent > 0.0) {
 4712:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4713: 
 4714:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4715:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4716:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4717: 
 4718:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4719:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4720:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4721:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4722:          } // if veg_h_unbent
 4723: 
 4724:          for (int k = 0; k < nvrt; k++) {
 4725:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4726:          } // for k
 4727:       
 4728: 
 4729:       } // if iveg
 4730:      
 4731: 
 4732:       // Compute vertical mean of veg_alpha3D
 4733:       if (iveg != 0) {
 4734:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4735:          double sum1=0.0;
 4736:          double sum2=0.0;
 4737:          // Integrate over each level under the canopy...
 4738:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4739:             const double Dz = node->Dz(k);
 4740: 
 4741:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4742:             sum2 += Dz;
 4743: 
 4744:          } // for k
 4745:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4746:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4747: 
 4748:       } // if iveg
 4749: 
 4750:    }
 4751: 
 4752:    __global__ void computeVegetationAndDragParameters(void) {
 4753:       // Computes the vegetation and drag model parameters:
 4754:       // chi, \tilde\chi, beta, \breve{H}
 4755:       
 4756:       SIDE(side);
 4757: 
 4758:       side->hhat = 0.0;
 4759:       side->chi2 = 0.0;
 4760:       side->chi = 0.0;
 4761:       side->veg_c2 = 0.0;
 4762:       side->veg_beta = 0.0;
 4763: 
 4764:       if (side->isDry) return;
 4765: 
 4766:       const double htot = side->htot2();
 4767:       const int    kb   = side->kb;
 4768: 
 4769:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4770: 
 4771:       const double veg_h     = side->veg_h();
 4772:       const double veg_nv    = side->veg_nv();
 4773:       const double veg_c     = side->veg_c();
 4774:       const double veg_beta  = side->veg_beta;
 4775:       const double veg_alpha = side->veg_alpha_vert_mean();
 4776: 
 4777:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4778:       // Velocity magnitude at the bottom level
 4779:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4780:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4781:       side->chi2 = side->Cd()*vmag1;
 4782:       side->chi  = side->chi2;
 4783:       if constexpr(iveg != 0) {
 4784:          const Node *n1 = side->n1;
 4785:          const Node *n2 = side->n2;
 4786:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4787:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4788:       }
 4789: 
 4790:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4791: 
 4792:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4793:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4794:       double magUa = 0.0;
 4795:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4796:          // 3D wet side with veg...
 4797: 
 4798:          double magUa = 0.0;
 4799:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4800:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4801: 
 4802:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4803:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4804:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4805: 
 4806:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4807:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4808: 
 4809:                // Velocity magnitude at the bottom (l) of the level
 4810:                const double ul = length(side->u2[k]);
 4811: 
 4812:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4813:                magUa += Dz*0.5*(uh + ul);
 4814: 
 4815:             } // if HasVegetation
 4816:          } // for k
 4817:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4818: 
 4819:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4820:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4821:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4822:             const double zCpy = side->zTopCanopy();
 4823:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4824:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4825:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4826:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4827:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4828:          } // if isSubmerged
 4829:       } // if iveg   
 4830: 
 4831:       // Computes the friction modified depth, \breve{H} in notes
 4832:       if (side->is2D()) { // 2D
 4833: 
 4834:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4835:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4836: 
 4837:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4838: 
 4839:          side->hhat = htot*htot/fricH; 
 4840: 
 4841:       } else { // 3D
 4842:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 4843: 
 4844:          if constexpr(iveg != 0) {
 4845:             
 4846:             if (side->isSubmerged()) { 
 4847:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4848:                side->hhat -= veg_c*Hhat_alpha;
 4849: 
 4850:             } else { // Emergent
 4851:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4852:             }
 4853:          } // if iveg
 4854: 
 4855:          // Enforce positivity for 3D model
 4856:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4857:       } // if 3D
 4858: 
 4859:    }
 4860: 
 4861: 
 4862: 
 4863:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4864:    // Computes the density gradient between two elements, e1 and e2.
 4865:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4866:    // zero in the direction normal to the side. 
 4867:    // 
 4868:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4869:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4870:    //
 4871:    // Input:
 4872:    //    e1: Element
 4873:    //    e2: Neighbor element (or nullptr if boundary)
 4874:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4875:    //    k: Index of the half-level at which the density is interpolated
 4876:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4877:    // 
 4878:    // Output:
 4879:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4880:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4881: 
 4882:       if (e2 == nullptr || e2->isDry) {
 4883:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4884: 
 4885:          Side *side = e1->sides[j];
 4886:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4887:                  
 4888:          if constexpr(ics == 1) {
 4889:             vec = side->n; // Normal vector to the side
 4890:          } else {
 4891:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4892:             // IMPLEMENT THIS XXXXXX
 4893:             // !replace with xel, yel?
 4894:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 4895:             //      &eframe(:,:,i),xn1,yn1,tmp)
 4896:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 4897:             //      &eframe(:,:,i),xn2,yn2,tmp)
 4898:          } //ics
 4899:                    
 4900:          diffRho = 0.0;
 4901: 
 4902:       } else { //internal and wet
 4903:          if constexpr(ics==1) {
 4904:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 4905: 
 4906:             // Vector from e1 to e2
 4907:             vec = e2->center - e1->center;
 4908: 
 4909:          } else { 
 4910:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 4911:             // IMPLEMENT THIS XXXXXX
 4912:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 4913:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 4914:             //                   alow(j)=xctr2
 4915:             //                   bdia(j)=yctr2
 4916:          } // ics
 4917: 
 4918:          diffRho = rho2 - e1->demeanedDensity(k);
 4919:       }
 4920: 
 4921:    }
 4922: 
 4923:    __global__ void computeDensityCubicSplines(void) {
 4924:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 4925: 
 4926:       ELEM(elem);
 4927: 
 4928:       if (elem->isDry) return;
 4929: 
 4930:       const int kb = elem->kb;
 4931: 
 4932:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 4933:       if (elem->is2D()) {
 4934:          // In the 2D case, the density is constant at the prism level. 
 4935:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 4936:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 4937:       } else { //3D
 4938: 
 4939:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 4940:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 4941:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 4942:          ///// XXXX CHECK INDICES!!!!!
 4943:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 4944:       } // 2D/3D
 4945: 
 4946:    }
 4947: } // extern "C"
 4948: 
 4949: 
 4950: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 4951: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 4952: 
 4953:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 4954: 
 4955:    const int kb  = elem->kb;
 4956:    const int kb2 = elem2->kb;
 4957: 
 4958:    // z-coordinate of prism of elem
 4959:    const double zp = elem->z_prism(k);
 4960: 
 4961:    double rho = 0.0;
 4962: 
 4963:    if (elem2->is2D()) {
 4964:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 4965: 
 4966:    } else {  // 3D
 4967: 
 4968:       // eta_min may be < zmax
 4969:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 4970:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 4971: 
 4972:       // (Extrapolate density below bottom, we will fix it later)
 4973:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 4974:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 4975:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 4976:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 4977:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 4978:    } // 2D/3D
 4979:      
 4980: 
 4981:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 4982:    // Now we need to fix it.
 4983:    if (elem->z[k] < elem2->z[kb2]) {
 4984:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 4985: 
 4986:       // There are two methods to adjust the density at the bottom of the element.
 4987:       // iunder_deep=0: 
 4988:       const double depth1 = abs(elem->z[kb]); // larger depth
 4989: 
 4990:       if (iunder_deep==0) {
 4991: 
 4992:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 4993: 
 4994:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 4995: 
 4996:       } else { // iunder_deep != 0
 4997: 
 4998:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 4999: 
 5000:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5001: 
 5002:          //   Demeaned density at the same z coordinate as
 5003:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5004:          }
 5005: 
 5006:       } // if iunder_deep
 5007:    } // if elem->z[kb] < elem2->z[kb]
 5008: 
 5009:    return rho;
 5010: }
 5011: 
 5012: 
 5013: extern "C" {
 5014:    __global__ void computeDensityGradient(void) {
 5015: 
 5016:       if constexpr(ibc != 0) return;
 5017: 
 5018:          // Compute the horizontal density gradient at each element.
 5019:       // It works in two steps:
 5020:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5021:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5022:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5023:       //             gradRho.r1 = rho1 - rho0
 5024:       //             gradRho.r2 = rho2 - rho0
 5025:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5026:       // 
 5027:       //  NOTE: We use de-meaned densities.
 5028: 
 5029:       ELEM(elem);
 5030: 
 5031:       if (elem->isDry) return;
 5032: 
 5033:       const int kb  = elem->kb;
 5034:       const int i34 = elem->i34;
 5035: 
 5036:       for (int k = kb + 1; k < nvrt; k++) {
 5037:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5038:          //             gradRho.r1 = rho1 - rho0
 5039:          //             gradRho.r2 = rho2 - rho0
 5040:          int icount = 0;
 5041:          double sumRx = 0.0;
 5042:          double sumRy = 0.0;
 5043:          for (int j1=0; j1<i34; j1++) { 
 5044: 
 5045:             const int j2 = elem->nxq(j1 + 1);
 5046: 
 5047:             // Pairs of consecutive neighbor elements of elem
 5048:             const Element *e1 = elem->nghbElems[j1];
 5049:             const Element *e2 = elem->nghbElems[j2];
 5050: 
 5051:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5052:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5053:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5054: 
 5055:             // Compute the density difference and the vector from elem to e1 and e2
 5056:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5057:             double diffRho1, diffRho2;
 5058:             Vector2 vec1, vec2;
 5059:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5060:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5061: 
 5062:             const double rl1 = length(vec1);
 5063:             const double rl2 = length(vec2);
 5064:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5065: 
 5066:             const double delta = cross(vec1, vec2);
 5067:             const double sintheta = abs(delta)/(rl1*rl2);
 5068: 
 5069:             // To avoid problems, avoid elements with small angle between vectors
 5070:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5071:             const bool validEq = (sintheta > sin_one_deg);
 5072: 
 5073:             if (validEq) {
 5074:                // Solve the system of equations to get the density gradient at elem
 5075:                icount++;
 5076:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5077:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5078:                sumRx += Rx;
 5079:                sumRy += Ry;
 5080:             }
 5081:          } // for j1
 5082: 
 5083:          // Compute the average density gradient at elem
 5084:          if (icount==0) {
 5085:            // Bad mesh quality; bail out with 0 b-cc
 5086:            elem->gradRho[k] = {0.0, 0.0};
 5087:          } else {
 5088:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5089:          }
 5090: 
 5091:       } // for k
 5092: 
 5093:    }
 5094: 
 5095:    __global__ void computeBaroclinicTerm(void) {
 5096:    // Computes the baroclinic term at sides (at half levels).
 5097:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5098:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5099: 
 5100:       if (ibc == 1) return;
 5101: 
 5102:       SIDE(side);
 5103: 
 5104:       if (side->isDry) return;
 5105: 
 5106:       const Element *e1 = side->elems[0];
 5107:       const Element *e2 = side->elems[1];      
 5108:       const int kb = side->kb;
 5109:       
 5110:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5111: 
 5112:       // interpolates vertically the density gradient of the two elements at the half level/
 5113: 
 5114:       int k1 = max(kb, nvrt / 2);
 5115:       int k2 = max(kb, nvrt / 2);
 5116: 
 5117:       // Starts the integration at the surface and goes down to the bottom
 5118:       side->bcc[nvrt-1] = {0.0, 0.0};
 5119:       for (int k = nvrt - 2; k >= kb; k--) {
 5120:       // For each prism level (from surface to bottom)...
 5121: 
 5122:          // For both elements, interpolate density gradient at the side's half level.
 5123:          // The gradient at the side is the average of the gradients at the elements.
 5124:          // w1, w2 are used to take into account boundary sides, with just one element.
 5125:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5126:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5127:          const double wsum = w1 + w2;
 5128:          w1 = w1/wsum;
 5129:          w2 = w2/wsum;
 5130:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5131: 
 5132:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5133:          Vector2 gradRho = {0.0, 0.0};
 5134:          if (e1 != nullptr && k > kb) {
 5135:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5136:             
 5137:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5138:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5139:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5140: 
 5141:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5142:          }      
 5143:          if (e2 != nullptr && k > kb) {
 5144:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5145:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5146:             
 5147:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5148:          }
 5149: 
 5150:          if constexpr(ics==2) {
 5151:             assert(false && "Not implemented: ics == 2");
 5152:             // IMPLEMENT THIS XXXXXX
 5153:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5154:             // swild(1)=tmp1
 5155:             // swild(2)=tmp2
 5156:          }
 5157:          
 5158:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5159:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5160:          // CHECK INDICES!!! XXX
 5161:          const double grav3 = side->grav3();
 5162:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5163: 
 5164:       } // for
 5165: 
 5166:    }
 5167: 
 5168: 
 5169: 
 5170:    __global__ void computeHorGradientAtSide(void) {
 5171: 
 5172:       // Compute the horizontal density gradient at each element.
 5173:       // It works in two steps:
 5174:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5175:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5176:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5177:       //             gradRho.r1 = rho1 - rho0
 5178:       //             gradRho.r2 = rho2 - rho0
 5179:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5180:       // 
 5181:       //  NOTE: We use de-meaned densities.
 5182: 
 5183:       SIDE(side);
 5184: 
 5185: 
 5186:       if (side->isDry) return;
 5187: 
 5188:       // Computes the gradient of the variables at the side center.
 5189:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5190:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5191:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5192: 
 5193:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5194:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5195:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5196:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5197: 
 5198:    }
 5199: 
 5200: 
 5201:    __global__ void solveMomentumEquations(double time) {
 5202: 
 5203:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5204:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5205: 
 5206:       SIDE(side);
 5207: 
 5208:       if (side->isDry) 
 5209:       {
 5210:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5211: 
 5212:          return;
 5213:       }
 5214: 
 5215:       const Node *n1 = side->n1;
 5216:       const Node *n2 = side->n2;
 5217: 
 5218:       const int kb = side->kb;
 5219: 
 5220:       const double veg_h = side->veg_h();
 5221:       const double grav3 = side->grav3();
 5222: 
 5223:       if (side->is2D()) {
 5224:          // Warning: Do not use htot2, which is updated.
 5225:          const double htot = side->htot1();
 5226:          const double hhat = side->hhat;
 5227: 
 5228:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5229: 
 5230:          Vector2 tau2 = {0.0, 0.0};
 5231:           
 5232:          if constexpr(ics==1) {
 5233:             tau2 = side->tau();
 5234: 
 5235:          } else {
 5236:             assert(false && "Not implemented: ics == 2");
 5237:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5238:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5239:             // taux2=(vn1+tt1)*0.5d0
 5240:             // tauy2=(vn2+ss1)*0.5d0
 5241:          } // if ics         
 5242: 
 5243:          // hat_gam has units of m/s
 5244: 
 5245:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5246: 
 5247:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5248:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5249: 
 5250:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5251: 
 5252: 
 5253:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5254: 
 5255:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5256: 
 5257:       }
 5258:       else { // 3D
 5259: 
 5260:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5261:          // 
 5262:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5263:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5264:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5265:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5266:          // k+1 and k.
 5267: 
 5268: 
 5269:          const int ndim = nvrt - kb;
 5270:          const double zTopCanopy = side->zTopCanopy();
 5271: 
 5272:          // Initialize the tridiagonal system
 5273:          for (int k = kb + 1; k < nvrt; k++) {
 5274:             
 5275:             const int kin = k - (kb + 1);
 5276: 
 5277:             // Vertical viscosity at the face center
 5278:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5279: 
 5280:  
 5281:             alow[kin] = 0.0;
 5282:             cupp[kin] = 0.0;
 5283:             bdia[kin] = 0.0;
 5284: 
 5285:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5286:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5287: 
 5288:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5289:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5290:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5291: 
 5292:             // First part: layers k, k+1
 5293:             if (k < nvrt - 1) {
 5294:                              
 5295:                if constexpr(iveg != 0) {
 5296: 
 5297:                   // If there is vegetation at this level...
 5298:                   if (zTopCanopy > side->zc[k]) {
 5299:                      // If the canopy is above the k layer...
 5300:                      
 5301:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5302:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5303:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5304:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5305: 
 5306:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5307:                      const double vmag2 = length(ut2);
 5308:                      const double vmag1 = length(side->u2[k]);
 5309:                      const double vmag = 0.5*(vmag1 + vmag2);
 5310:                      
 5311:                      // Computes the vegetation alpha at the face center
 5312:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5313: 
 5314:                      cff1 += veg_alpha_sd*dt*vmag;
 5315: 
 5316:                   } // if (zTopCanopy
 5317:                } // if iveg
 5318: 
 5319:                const double dzz = side->Dz(k + 1);
 5320:                const double tmp = dt*dfz/dzz;
 5321:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5322: 
 5323:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5324:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5325:             }
 5326: 
 5327: 
 5328:             // Second part: layers k-1, k
 5329:             if (k > kb + 1) {
 5330: 
 5331:                double cff1 = 1.0; //init \bar{c^k}
 5332: 
 5333:                if constexpr(iveg != 0) {
 5334:                   // If there is vegetation at this level...
 5335:                   if (zTopCanopy > side->zc[k-1]) {
 5336:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5337:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5338: 
 5339:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5340: 
 5341:                      const double vmag2 = length(ut2);
 5342:                      const double vmag1 = length(side->u2[k-1]);
 5343:                      const double vmag = 0.5*(vmag1 + vmag2);
 5344: 
 5345:                      // Computes the vegetation alpha at the face center
 5346:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5347:                      cff1 += veg_alpha_sd*dt*vmag;
 5348:                   } // if zTopCanopy
 5349: 
 5350:                } // if iveg
 5351: 
 5352:                const double dzz = side->Dz(k);
 5353:                const double tmp = dt*dfz/dzz;
 5354:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5355: 
 5356:                alow[kin] += cff1*dzz/6.0 - tmp;
 5357:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5358: 
 5359:             } else { // Bottom boundary
 5360:                // This occurs at the bottom, where the bottom drag is applied.
 5361: 
 5362:                bdia[kin] += dt*side->chi2; // XXXX
 5363: 
 5364:             } // if (k > kb + 1)
 5365: 
 5366: 
 5367:          } // for (int k
 5368: 
 5369: 
 5370: 
 5371:          // Computes the RHS.
 5372:          // -----------------
 5373: 
 5374:          //	BC to be imposed at the end.
 5375: 
 5376:          const Vector2 gradETP  = side->gradETP;
 5377:          const Vector2 gradPr   = side->gradPr;
 5378:          const Vector2 gradEta1 = side->gradEta1;
 5379:          const Vector2 gradEta2 = side->gradEta2;
 5380: 
 5381:          const Vector2 *btu = side->btu;
 5382:          const Vector2 *u2  = side->u2;
 5383:          const double coriolis = side->coriolis;
 5384:          const Vector2 *nuGradU = side->nuGradU;
 5385: 
 5386: 
 5387:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5388: 
 5389:          for (int k = kb + 1; k < nvrt; k++) {
 5390:             const int kin = k - kb - 1;
 5391: 
 5392:             const double dz_0 = side->Dz(k);
 5393:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5394: 
 5395:             rrhs[kin] = {0.0, 0.0};
 5396:             double dz = 0.0;
 5397: 
 5398:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5399:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5400:             if (k < nvrt  ) dz += dz_1;
 5401:             if (k > kb + 1) dz += dz_0;
 5402: 
 5403:             // Elevation gradient, atmospheric pressure and tidal potential
 5404:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5405: 
 5406:             // Coriolis, advection, wind stress, and horizontal viscosity
 5407:             if (k < nvrt - 1) {
 5408: 
 5409: 
 5410:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5411:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5412:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5413:                                                 
 5414: 
 5415:                //diff stress tensors 1006
 5416:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5417:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5418:                   assert(false && "Not implemented: itur == 5");
 5419:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5420:                }
 5421:                // else assert(false && "itur # Not implemented");
 5422: 
 5423:             } else { // k == nvrt - 1 SURFACE
 5424:                Vector2 tau2 = {0.0, 0.0};
 5425:                if constexpr(ics==1) {
 5426:                   tau2 = side->tau();
 5427:       
 5428:                } else {
 5429:                   assert(false && "Not implemented: ics == 2");
 5430:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5431:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5432:                   // taux2=(vn1+tt1)*0.5d0
 5433:                   // tauy2=(vn2+ss1)*0.5d0
 5434:                } // if ics
 5435: 
 5436:                rrhs[kin] += dt*tau2;
 5437:           
 5438: 
 5439:             } // if k<nvrt
 5440: 
 5441: 
 5442:             if (k > kb + 1) {
 5443:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5444:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5445:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5446: 
 5447:                // diff stress tensors 1006
 5448:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5449:                   assert(false && "Not implemented: itur == 5");
 5450:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5451:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5452:                }
 5453:                // else assert(false && "itur # Not implemented");
 5454: 
 5455: 
 5456:             } // if k>kbs + 1
 5457: 
 5458:             // Baroclinic
 5459:             Vector2 *bcc = side->bcc;
 5460:             if constexpr(ibc == 0) {
 5461:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5462:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5463: 
 5464:             } // if ibc==0
 5465: 
 5466:          } // k=kb + 1,nvrt
 5467: 
 5468: 
 5469:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5470: 
 5471:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5472:             const int kin = k - kb - 1;
 5473:    
 5474:             // Velocity is always clamped to maximum values
 5475:             side->u2[k] = clampVelocity(soln[kin]);
 5476:          } // k
 5477: 
 5478:       } // if side->is2D()
 5479:       
 5480: 
 5481:       // Impose velocity boundary condition at the bottom
 5482:       if constexpr(imm == 2) { // 3D bed deformation model
 5483:          double dep;
 5484:          Vector2 vel;
 5485: 
 5486:          assert(false && "Not implemented: imm == 2");
 5487:          //update_bdef(time, x0, y0, dep, vel);
 5488:          // side->u2[kb] = vel;
 5489: 
 5490:       } else { // imm = 0 or 1
 5491:          if (side->Cd() == 0.0) {
 5492:             side->u2[kb] = side->u2[kb + 1];
 5493: 
 5494:          } else if (side->is3D()) { // 3D no slip bottom   
 5495:             side->u2[kb] = {0.0, 0.0};
 5496:          }
 5497:           
 5498:       } // if imm
 5499: 
 5500:       // The velocities below the bottom level are set to zero
 5501:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5502: 
 5503: 
 5504:    }
 5505: 
 5506: 
 5507:    __global__ void applyMomentumBC(void) {
 5508: 
 5509:       SIDE_BND(sideBnd);
 5510: 
 5511:       Side *side = sideBnd->side;
 5512:       const BoundarySegment *segment = sideBnd->segment;
 5513:       const Node *n1 = side->n1;
 5514:       const Node *n2 = side->n2;
 5515: 
 5516:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5517: 
 5518:       const bool isLand = segment->isLand;
 5519:       const int ifltype = segment->ifltype;
 5520: 
 5521:       const int kb = side->kb;
 5522: 
 5523: 
 5524:       if (!isLand && ifltype != 0) {
 5525:          const Vector2 *ubc = sideBnd->ubc;
 5526:   
 5527:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5528:             
 5529:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5530:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5531: 
 5532:             if (ifltype == -1) {
 5533:                // Flather 1
 5534: 
 5535:                const double depth = side->depth();
 5536: 
 5537:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5538: 
 5539:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5540: 
 5541:                side->u2[k] = vnorm*side->n;
 5542: 
 5543:             } else if (ifltype == -2) { // Discharge
 5544: 
 5545:                const double eta1 = side->eta1();
 5546:                const double eta2 = side->eta2();
 5547:                const double htot = side->htot2();
 5548: 
 5549:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5550:                assert(false && "Not implemented: Discharge bc");
 5551:                // const double dischrg = discharge(eta1);
 5552:                const double dischrg = 0.0; // XXX REMOVE
 5553:                
 5554: 
 5555:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5556: 
 5557:                const double vnorm = dischrg*eta2/htot;
 5558: 
 5559:                side->u2[k] = vnorm*side->n;
 5560: 
 5561:             }
 5562:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5563:                const double vnorm = dot(side->u2[k], side->n);
 5564: 
 5565:                double rat;
 5566:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5567:                else              rat = segment->vobc2; // outgoing
 5568: 
 5569:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5570: 
 5571:             }
 5572:             else { // not Flather or 3D radiation
 5573:                side->u2[k] = ubc[k];
 5574: 
 5575:             } // if (segment->ifltype...
 5576: 
 5577:          }
 5578: 
 5579:       }
 5580:       else if (isLand) { // if it is land boundary side
 5581: 
 5582:          if constexpr(islip == 0) { // free slip
 5583: 
 5584:             for (int k = kb; k < nvrt; k++) {
 5585: 
 5586:                const Vector2 t = side->t();
 5587:                const Vector2 n = side->n;
 5588: 
 5589:                double vnorm = 0.0; // for most cases
 5590:                const double vtan = dot(side->u2[k], t);
 5591:                
 5592:                side->u2[k] = vtan*t - vnorm*n;
 5593: 
 5594:             }
 5595: 
 5596:          } else { // no slip
 5597:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5598: 
 5599:          }
 5600:       } // if (side segment type...
 5601: 
 5602:    
 5603: 
 5604:    }
 5605: 
 5606: 
 5607:    __global__ void shapiroFilter1(void) {
 5608:       // First step of the Shapiro filter (normally used if indvel<=0)
 5609:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5610: 
 5611:       SIDE(side);
 5612: 
 5613:       // Only internal wet sides are processed
 5614:       if (side->isDry || !(side->isInternal())) return;
 5615: 
 5616:       const int kb = side->kb;
 5617: 
 5618:       for (int mm = 0; mm < niter_shap; mm++) {
 5619: 
 5620:          for (int k = kb + 1; k < nvrt; k++) {
 5621:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5622:             Vector2 suru = {0.0, 0.0};
 5623: 
 5624:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5625: 
 5626:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5627: 
 5628:                int kin = k;
 5629:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5630:                
 5631:                if constexpr(ics==1) {
 5632:                   suru += nSide->u2[kin];
 5633: 
 5634:                } else {
 5635:                   assert(false && "Not implemented: ics == 2");
 5636:                   // Vector2 vn1, vn2;
 5637:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5638:                   // suru=suru+vn1;
 5639:                   // surv=surv+vn2;
 5640:                }
 5641:             }
 5642: 
 5643:             // Reusing bcc as a temporary array to store the suru values.
 5644:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5645: 
 5646:          }
 5647:       }
 5648:    }
 5649: 
 5650:    __global__ void shapiroFilter2(void) {
 5651:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5652: 
 5653:       SIDE(side);
 5654: 
 5655: 
 5656:       if (side->isDry || !(side->isInternal())) return;
 5657: 
 5658:       const int kb = side->kb;
 5659: 
 5660:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5661: 
 5662:       if (side->is2D()) {
 5663:          side->u2[kb + 1] = side->bcc[kb + 1];
 5664:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5665: 
 5666:       } else {
 5667:          // 3D
 5668:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5669:          
 5670:       }
 5671: 
 5672:    }
 5673: 
 5674: 
 5675:    __global__ void ul0UpdateZCoords(void) {
 5676:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5677:       
 5678:       NODE(node);      
 5679: 
 5680: 
 5681:       if (false) {//node->isDry) {  //XXXXXXXXXXXXXXXXX
 5682: 
 5683:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5684: 
 5685:          if constexpr(ivcor != 1) node->kb = 0;
 5686: 
 5687:       } else {
 5688: 
 5689:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5690:          node->updateKb();
 5691: 
 5692:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5693: 
 5694:       }
 5695: 
 5696:       // We use the temp.b field to store the previous state of isDry.
 5697:       node->tmp.b = node->isDry;
 5698: 
 5699:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5700:       node->isDry = true;
 5701: 
 5702:    }
 5703: 
 5704:    __global__ void ul0ComputeDryElements(void)
 5705:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5706:    {
 5707:       ELEM(elem);
 5708: 
 5709:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5710: 
 5711:       elem->kb = 0;
 5712: 
 5713:       if (elem->isDry) return;
 5714: 
 5715: 
 5716:    //    if(elem->isDry2()) { // XXXX
 5717:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5718:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5719:    //        call parallel_abort(errmsg)
 5720:    //    }
 5721: 
 5722:       const Node *n1 = elem->nodes[0];
 5723:       const Node *n2 = elem->nodes[1];
 5724:       const Node *n3 = elem->nodes[2];  
 5725:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5726: 
 5727:       // Computes element's kb as the minimum of the nodes' kb.
 5728:       const int kb1 = n1->kb;
 5729:       const int kb2 = n2->kb;
 5730:       const int kb3 = n3->kb;
 5731:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5732: 
 5733: 
 5734:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5735: 
 5736: 
 5737:       // Computes the element z as the mean of the nodes z.
 5738:       for (int k = elem->kb; k < nvrt; k++) {
 5739: 
 5740:          // Compute the element z as the mean of the nodes z.
 5741:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5742:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5743:          elem->z[k] /= elem->i34;
 5744: 
 5745:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5746:       }
 5747:                   
 5748:    }
 5749: 
 5750:    __global__ void ul0ComputeDryNodes(void)
 5751:    // Updates node's isDry based on the elements' isDry. 
 5752:    {
 5753:       NODE(node);
 5754: 
 5755:       node->isDry = true;
 5756: 
 5757:       // A node is wet if at least one of the elements sharing it is wet.
 5758:       for (int j = 0; j < node->numElements; j++) {
 5759:          const Element *elem = node->elements[j];
 5760:          if (!elem->isDry) {
 5761:             node->isDry = false;
 5762:             break;
 5763:          }
 5764:       }
 5765: 
 5766:        
 5767:    }
 5768: 
 5769: 
 5770:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5771:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5772:    // node->tmp.b is true if the node was previously dry.
 5773:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5774:    {
 5775:       NODE(node);
 5776:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5777: 
 5778:       // Avoid this the first time step.
 5779:       if (it == iths) return;  
 5780: 
 5781:       const bool wasDry = node->tmp.b;
 5782: 
 5783: if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5784: 
 5785:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5786:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5787: 
 5788:          for (int k=0; k < nvrt; k++) {
 5789: 
 5790:             Vector3 utmp={0.0, 0.0, 0.0};
 5791: 
 5792:             double ttmp=0.0;
 5793:             double stmp=0.0;
 5794:             int icount=0;
 5795:             for (int j = 0; j < node->numNodes; j++) {
 5796: 
 5797:                const Node *nbrNode = node->nodes[j];
 5798:                
 5799:                const bool wasNbrDry = nbrNode->tmp.b;
 5800: 
 5801:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5802:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5803: 
 5804:                   icount++;
 5805: 
 5806:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5807:                   utmp += nbrNode->uvw2(k);
 5808:                   
 5809:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5810:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5811:                }
 5812:             }
 5813: 
 5814:             if (icount > 0) {
 5815:                const double inv_icount = 1.0/icount;
 5816:                utmp = inv_icount*utmp;
 5817:                node->u2[k]     = toVector2(utmp);
 5818:                node->w2[k]     = utmp.z;
 5819:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5820:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5821:             } else {
 5822:                node->u2[k] = {0.0, 0.0};
 5823:                node->w2[k] = 0.0;
 5824:                // Initialize tracers to 0.0??? XXXXX
 5825:             }
 5826:          }
 5827:       }
 5828:    }
 5829: 
 5830:   
 5831:    
 5832: 
 5833: 
 5834:    __global__ void ul0UpdateSides(int it, int iths) {
 5835:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5836:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5837:    // The dryness of the sides is updated in ul0UpdateSides2.
 5838: 
 5839:       SIDE(side);
 5840: 
 5841:       // A side is wet if and only if at least one of its elements is wet.
 5842:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5843:  
 5844:       const Node *n1 = side->n1;
 5845:       const Node *n2 = side->n2;
 5846:      
 5847:       const int kb1 = n1->kb;
 5848:       const int kb2 = n2->kb;
 5849: 
 5850:       side->kb = 0; // default when dry
 5851: 
 5852:       if (isWet) {
 5853: 
 5854:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5855: 
 5856:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5857: 
 5858:          side->kb = min(kb1, kb2);
 5859: 
 5860:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5861: 
 5862:          for (int k = side->kb; k < nvrt; k++) {
 5863:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5864: 
 5865:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5866: 
 5867:             // Compute velocity for re-wetted sides 
 5868:             if ((it != iths) && (side->isDry && isWet)) {
 5869: 
 5870:                Vector2 utmp={0.0, 0.0};
 5871: 
 5872:                int icount=0;
 5873: 
 5874:                // For all the sides on the two elements that share this side
 5875:                for (int j = 0; j < 2; j++) {
 5876:                   const Element *elem = side->elems[j];
 5877:                   if (elem == nullptr) continue;
 5878: 
 5879:                   for (int jj=0; jj < elem->i34; jj++) {
 5880:                      const Side *nSide = elem->sides[jj];
 5881:                      if (nSide->isDry) continue;
 5882: 
 5883:                      icount++;
 5884:                      utmp += nSide->u2[k];  
 5885:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5886:                   }
 5887:                }
 5888:                   
 5889:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 5890:                if (icount > 0)  side->u2[k] = utmp/icount;
 5891:                else             side->u2[k] = {0.0, 0.0};
 5892:                   
 5893:             } // if ((it != iths) && (side->isDry && isWet))
 5894: 
 5895:          } // for k
 5896: 
 5897:       } // if isWet 
 5898:       
 5899: 
 5900: 
 5901:    }
 5902: 
 5903:    __global__ void ul0UpdateSides2(void) {
 5904:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 5905:    
 5906:          SIDE(side);
 5907:    
 5908:          const Element *e1 = side->elems[0];
 5909:          const Element *e2 = side->elems[1];
 5910: 
 5911:          // A side is wet if and only if at least one of its elements is wet.
 5912:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 5913: 
 5914:          // Update the side's dryness
 5915:          side->isDry = !isWet;
 5916: 
 5917: // if (side->isDry) {for (int k = 0; k < nvrt; k++) {side->u2[k] = {0.0, 0.0};side->w2[k] = 0.0;}}  // XXXX KKKKKK Not in the original code
 5918: 
 5919:    }
 5920: 
 5921: 
 5922:    __global__ void zeroNodalVelocities(void) {
 5923:       NODE(node);
 5924: 
 5925:       for (int k = 0; k < nvrt; k++) {
 5926:          node->u2[k]   = {0.0, 0.0};
 5927:          node->w2[k]   = 0.0;
 5928:          node->utmp[k] = {0.0, 0.0};
 5929:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 5930:       }
 5931:    }
 5932: 
 5933:  
 5934: 
 5935:    __global__ void computeNodalVerticalVelocities1(void) {
 5936:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5937:    // Adds the element's vertical velocity times the element's area.
 5938:       ELEM(elem);
 5939: 
 5940:       for (int j = 0; j < elem->i34; j++) {
 5941:          Node *node = elem->nodes[j];
 5942: 
 5943:          for (int k = node->kb; k < nvrt; k++) {
 5944:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 5945:          }
 5946:          atomicAdd(&(node->tmp.d), elem->area);
 5947:       }
 5948:    }
 5949: 
 5950:    __global__ void computeNodalVerticalVelocities2(void) {
 5951:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 5952:    // Divides by the total area of the elements sharing the    node.
 5953:       NODE(node);
 5954: 
 5955:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 5956: 
 5957:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 5958:    }
 5959: 
 5960: 
 5961:    __global__ void computeNodalHorizontalVelocities1(void) {
 5962: 
 5963:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 5964:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 5965: 
 5966:       ELEM(elem);
 5967: 
 5968:       if (elem->isDry) return;
 5969: 
 5970:       const int kb = elem->kb;
 5971:       const bool isTri = elem->isTri();
 5972: 
 5973:       if constexpr(indvel <= 0) {
 5974:          // Assuming discontinous hvel.
 5975: 
 5976:          if (isTri) { // For triangles
 5977:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 5978:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 5979: 
 5980:             for (int j = 0; j < 3; j++) {
 5981:                // For every node of the triangle...
 5982:                Node *node = elem->nodes[j];
 5983: 
 5984:                if (node->isDry) continue;
 5985: 
 5986:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 5987:                const Side *s2 = elem->sides[(j + 1) % 3];
 5988:                const Side *s3 = elem->sides[(j + 2) % 3];
 5989: 
 5990: 
 5991:                atomicAdd(&(node->tmp.i), 1);
 5992: 
 5993:                for (int k = kb; k < nvrt; k++)  {
 5994:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 5995:                   u = clampVelocity(u);
 5996:                   atomicAdd(&(node->utmp[k].x), u.x);
 5997:                   atomicAdd(&(node->utmp[k].y), u.y);
 5998: 
 5999:                }
 6000: 
 6001:             }
 6002:          }
 6003:          else { // For quads
 6004:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6005: 
 6006:          }
 6007: 
 6008:       }
 6009:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6010:       
 6011:    }
 6012: 
 6013: 
 6014:    __global__ void computeNodalHorizontalVelocities2(void) {
 6015:       NODE(node);
 6016: 
 6017:       const int nodeCount = node->tmp.i;
 6018: 
 6019:       if (nodeCount == 0) 
 6020:       {
 6021:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6022:          return;
 6023:       }
 6024: 
 6025:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6026:       
 6027:       const int kb = node->kb;
 6028: 
 6029:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6030:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6031:       
 6032:       
 6033:    }   
 6034: 
 6035:  
 6036: 
 6037:    __global__ void resetVelocityOpenBndNodes(void) {
 6038:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6039: 
 6040:       NODE_BND(nodebnd);
 6041: 
 6042:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6043:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6044:       }
 6045: 
 6046:    }
 6047: 
 6048: 
 6049:    __global__ void setVelocityOpenBndNodes(void) {
 6050:    // For open boundary nodes sets their velocity to the imposed values.
 6051: 
 6052:       SIDE_BND(sidebnd);
 6053: 
 6054:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6055:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6056:          // to its segment to the average of the side velocity.
 6057: 
 6058:          for (int k = 0; k < nvrt; k++) {
 6059:             Node *n1 = sidebnd->side->n1;
 6060:             Node *n2 = sidebnd->side->n2;
 6061: 
 6062: 
 6063:             Vector2 n1_u2(n1->u2[k]);
 6064:             Vector2 n2_u2(n2->u2[k]);
 6065: 
 6066:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6067:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6068:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6069:             }
 6070:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6071:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6072:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6073:             }
 6074: 
 6075:          }
 6076: 
 6077:       }
 6078: 
 6079:    }
 6080: 
 6081: 
 6082:    __global__ void computeVerticalVelocity(void) {
 6083:       // Computes the vertical velocity at the (2D) element's centroid.
 6084:       // In this function we will be considering volumetric elements, with side faces and a 
 6085:       // bottom and a top face. We will call them SFs, BF and TF.
 6086:       // It computes the flux coming from BF and the SFs.
 6087:       // If the bed is moving, it takes that into account.
 6088:       // Since water is incompressible, the integral of the velocity times the normal vector
 6089:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6090:       // and the BF is equal to the flux going out from the TF.
 6091:       // TF = - BF - sum(SFs).
 6092:       // It then computes the horizontal velocity at the center of TF.
 6093:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6094:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6095:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6096: 
 6097:       ELEM(elem);
 6098: 
 6099:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6100: 
 6101:       if (elem->isDry) return;
 6102: 
 6103:       const int kb = elem->kb;
 6104:       const bool isTri = elem->isTri();
 6105: 
 6106:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6107: 
 6108:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6109:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6110:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6111: 
 6112:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6113: 
 6114:       double area3D;
 6115: 
 6116:       // Bottom face flux
 6117:       double bottomFlux = 0.0;
 6118:       Vector2 u2meanBottom = {0.0, 0.0};
 6119:       const Vector2 gradh = elem->grad2(&Node::depth);
 6120:       if constexpr(imm==2) {
 6121:          Vector3 ubed;
 6122: 
 6123:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6124:          // updateBDEF(ubed);
 6125:      
 6126:          // const double bflux0 = dot(ubed, elem_n1);
 6127: 
 6128:          // elem->w[kb] += ubed.z;
 6129:       }
 6130:       else {
 6131:          Vector2 umean;
 6132:          if constexpr(ics == 1) {
 6133:             u2meanBottom = elem->mean(kb, &Side::u2);
 6134:          }
 6135:          else {
 6136:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6137:          }
 6138: 
 6139:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6140:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6141: 
 6142:          bottomFlux = - dot(gradh, u2meanBottom);
 6143:       } // if imm
 6144: 
 6145:       // Compute w for kb+1 to nvrt-1
 6146:       for (int l = kb; l < nvrt - 1; l++) {
 6147: 
 6148:          // normal vector to the top face of the "volumetric" element (3D)
 6149:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6150: 
 6151:          // Compute the total flux at the sides
 6152:          double sideFlux = 0.0;
 6153: 
 6154:          for (int j = 0; j < elem->i34; j++) {
 6155:             const Side *side = elem->sides[j];
 6156: 
 6157:             const double sideArea = side->area(l);
 6158:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6159:             const double sign = elem->ssign[j]; 
 6160: 
 6161:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6162:          }
 6163:          
 6164:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6165:          //velocities at the centers of the sides
 6166:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6167: 
 6168:          // The flx at the top ace can be computed from the other flows.
 6169:          const double topFlux = - sideFlux - bottomFlux;
 6170:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6171: 
 6172:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6173: 
 6174:          elem_n1 = elem_n2;
 6175: 
 6176:          bottomFlux = - topFlux;
 6177:       }
 6178:    }  
 6179: 
 6180: 
 6181: 
 6182: 
 6183: 
 6184: 
 6185: 
 6186: // !===============================================================================
 6187: // !===============================================================================
 6188: 
 6189: } // extern "C"
 6190: 
 6191: #ifdef DONTCOMPILE
 6192: __device__ void computeVerticalAdvection(void) {
 6193:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6194: 
 6195:    sdbt(1:2,:,:)=0.d0
 6196: 
 6197:    const Side *side = FROM kernel;
 6198: 
 6199:    if(side->isDry) return;
 6200: 
 6201:    // If side is wet...
 6202: 
 6203: 
 6204:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6205:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6206:    double ws[nvrt] = {} // w @ side
 6207:    int icount = 0;
 6208:    for (int j=0; j<2; j++) {
 6209:       const Element *elem = side->elements[j];
 6210:        
 6211:       if(elem != nullptr) {
 6212:          icount++;
 6213:          for (int k=0; k<nvrt; k++) {
 6214:             ws[k] = ws[k] + elem->w[k];
 6215:          }
 6216:       }
 6217:    }  // for j
 6218: 
 6219:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6220:    ws = ws/icount;
 6221: 
 6222:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6223:    // Splines allow for a smooth transition between vertical levels.
 6224:    // Splines have continuity restrictions at the internal knots, but
 6225:    // we have to provide the 1st derivatives at the endpoints.
 6226:    const int kbs = side->kbs; 
 6227:    
 6228:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6229:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6230:    initCubicSpline(kbs, nvrt, side, ws, up)
 6231: 
 6232:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6233:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6234:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6235: 
 6236:    // Total advection (average onto side)
 6237:    const Node *node1 = side->nodes[0];
 6238:    const Node *node2 = side->nodes[1];
 6239:    for (int k=kbs(i); k<nvrt; k++) {
 6240: 
 6241:       if constexpr(ics==1) {
 6242:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6243:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6244:       } else {
 6245:          // XXX IMPLEMENT THIS
 6246:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6247:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6248:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6249:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6250:       }  // if ics
 6251: 
 6252: 
 6253:    }
 6254: }
 6255: #endif
 6256: 
 6257: 
 6258: extern "C" {
 6259:    __global__ void computeElemAverageGhat(void) {
 6260:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6261: 
 6262:       ELEM(elem);
 6263:       
 6264:       elem->ghat1= {0.0, 0.0};  
 6265: 
 6266:       if constexpr(ihydraulics != 0) {
 6267:          if (nhtblocks > 0 && elem->isblock) return;
 6268:       }
 6269: 
 6270: 
 6271: 
 6272:       
 6273:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6274:       // tidal potential, horizontal diffusion, and baroclinic etc
 6275:       // Remember to update both fb and F 
 6276:       // If ics=2, ghat1 are in eframe (ll)
 6277:       // cff1-3: coefficients for 2D/3D
 6278:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6279:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6280:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6281: 
 6282:       if (elem->isDry) return;
 6283: 
 6284:       double av_cff1 = 0.0;  // av. for cff1
 6285:       double av_cff2 = 0.0;  // av. for cff2
 6286:       double av_cff3 = 0.0;  // av. for cff3
 6287:       double av_df = 0.0;  // av. for H^\alpha / H
 6288:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6289:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6290: 
 6291:       const int i34 = elem->i34;
 6292:       const int kb = elem->kb;
 6293: 
 6294:       for (int j=0; j<i34; j++) {
 6295:          // For each node and side in the element...
 6296: 
 6297:          const Node *node = elem->nodes[j];
 6298:          const Side *side = elem->sides[j];
 6299: 
 6300:          const double chi      = side->chi;
 6301:          const double veg_c2   = side->veg_c2;
 6302:          const double veg_beta = side->veg_beta;
 6303:          const double veg_h    = side->veg_h();
 6304:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6305: 
 6306:          // Node - const in elem
 6307:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6308:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6309: 
 6310:          if (elem->depth >= tip_dp) {
 6311:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6312:          }
 6313: 
 6314:          
 6315:          const double htot  = side->htot2();        // Total depth at the side
 6316:          const double zctr2 = side->zTopCanopy();  
 6317: 
 6318:          double cff1; 
 6319:          double cff2; 
 6320:          double cff3;   
 6321:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6322:          // coefficients applied to 2D/3D case 
 6323:             cff1 = side->hhat/htot;
 6324:             cff2 = 0.0;
 6325:             cff3 = 0.0;
 6326:          } else { //3D
 6327:             //Init for no-veg case
 6328:             cff1 = 1.0;
 6329:             cff2 = 1.0;
 6330:             cff3 = 0.0;
 6331: 
 6332:             if constexpr(iveg != 0) {
 6333:                // Computes coefficients used with vegetation terms G1, G2
 6334:                // cff1, cff3 are used for the first two terms in G1, G2:
 6335:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6336:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6337:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6338:                if(veg_h < 0.99*htot) { // submergent vegetation
 6339:                   cff1=1;
 6340:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6341:                   cff3 = veg_c;
 6342: 
 6343:                } else { // emergent vegetation
 6344:                   cff1 = 1.0/(1.0 + veg_c2);
 6345:                   cff2 = cff1;
 6346:                   cff3 = 0.0;
 6347: 
 6348:                }
 6349:             } // if iveg
 6350:          } //  2D/3D
 6351: 
 6352:          av_cff1 += cff1/i34;
 6353:          av_cff2 += cff2/i34;
 6354:          av_cff3 += cff3/i34;
 6355:          av_cff2_chi += cff2*chi/i34;
 6356:          av_cff3_chi += cff3*chi/i34;
 6357:          av_df += min(htot, veg_h)/(htot*i34);
 6358: 
 6359: 
 6360:          // btrack values: U^\star, U^{\star\alpha}
 6361:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6362:          Vector2 Ustar       = {0.0, 0.0}; 
 6363:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6364: 
 6365:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6366:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6367:          } else { //3D
 6368:             for (int k = side->kb + 1; k < nvrt; k++) {
 6369:             
 6370:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6371:                Ustar += w2;
 6372: 
 6373:                if constexpr(iveg != 0) {
 6374:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6375:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6376:                        Ustar_alpha += zrat*w2; // XXXX
 6377:                    }
 6378:                }  // if iveg
 6379:             }  // for k
 6380:          }  //2D/3D
 6381:          
 6382: 
 6383:          // Add btrack & surface stress terms to \breve{G} first
 6384:          if constexpr(ics==1) {
 6385: 
 6386:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6387: 
 6388:          } else {
 6389:             assert(false && "computeElemAverageGhat: Not implemented");
 6390:             // XXX IMPLEMENT THIS
 6391:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6392:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6393:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6394:          }  // if ics
 6395: 
 6396:          // Surface and bottom stress terms
 6397:          if constexpr(ics==1) {
 6398:             const Vector2 tau    = side->tau();
 6399:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6400: 
 6401:             // Term for surface and bottom stress
 6402:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6403: 
 6404:          } else {
 6405:             assert(false && "computeElemAverageGhat: Not implemented");
 6406:             // XXX IMPLEMENT THIS
 6407:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6408:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6409:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6410:             // tau_x=(vn1+tt1)/2.d0
 6411:             // tau_y=(vn2+ss1)/2.d0
 6412:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6413:          }  // if ics
 6414: 
 6415:          
 6416: 
 6417:          // All terms in F,F^\alpha,f_b except baroclinic
 6418:          // F, f_b: all explicit terms excluding vegetation 
 6419:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6420:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6421:          const double coriolis = side->coriolis;
 6422:          Vector2 F  =  coriolis*side->U;  // F_x
 6423:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6424:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6425: 
 6426:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6427:             
 6428:             for (int k = side->kb; k < nvrt; k++) {
 6429:                if (zctr2 > side->zc[k-1]) {
 6430:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6431:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6432:                    Fa +=  coriolis*w2*zrat;
 6433:                } // if zctr2
 6434:             } // k
 6435:          } // iveg
 6436: 
 6437:          // Integrate horizontal viscosity force vertically
 6438:          for (int k=side->kb + 1; k<nvrt; k++) {
 6439:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6440: 
 6441:             F += levelHorVisc;
 6442: 
 6443:             // Vegetation term
 6444:             if constexpr(iveg!=0) {
 6445:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6446:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6447:                   Fa += levelHorVisc*zrat;
 6448:                } 
 6449:             } // if iveg
 6450:          } // for k
 6451: 
 6452:          fb += side->nuGradU[side->kb];
 6453: 
 6454:          // Add to ghat1
 6455:          if constexpr(ics==2) {
 6456:             assert(false && "computeElemAverageGhat: Not implemented");
 6457:             // XXX IMPLEMENT THIS
 6458:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6459:             // bigf1=vn1; bigf2=vn2
 6460:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6461:             // botf1=vn1; botf2=vn2
 6462:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6463:             // bigfa1=vn1; bigfa2=vn2
 6464:          } // if ics
 6465: 
 6466:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6467:       } // for j (nodes and sides)
 6468: 
 6469:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6470:          
 6471:       // Finish off terms in F, F^\alpha and f_b
 6472:       const double grav3 = elem->mean(&Node::grav2);
 6473:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6474: 
 6475: 
 6476:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6477:       for (int j=1; j<i34; j++) { 
 6478:          // For each side in the element...
 6479:          const Side *side = elem->sides[j];
 6480:          const double chi = side->chi;
 6481: 
 6482:          const double htot = side->htot2();
 6483:          const double veg_h = side->veg_h();
 6484:          const Vector2 F  = htot*fb;
 6485:          const Vector2 Fa = min(htot, veg_h)*fb;
 6486: 
 6487:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6488:       } // for j
 6489: 
 6490:       //botf1 etc are already in elem frame
 6491:       elem->ghat1 += tmp/i34;
 6492: 
 6493:       // Baroclinic force
 6494:       if constexpr(ibc==0) {
 6495:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6496: 
 6497:          Vector2 Fa = {0.0, 0.0};
 6498:          Vector2 intGradRho = {0.0, 0.0};
 6499:          
 6500:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6501:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6502:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6503: 
 6504:             // \in F [m^2/s/s]
 6505:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6506:          }
 6507: 
 6508:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6509:          const Vector2 F = av_df*Fa; //approx
 6510:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6511: 
 6512:       } // if ibc
 6513: 
 6514: 
 6515: 
 6516:    }
 6517: 
 6518: } // extern "C"
 6519: 
 6520: 
 6521: 
 6522: #ifdef DONTCOMPILE
 6523: __global__ void checkMassConservation(Tracers* sumtr) {
 6524: 
 6525:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6526: 
 6527:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6528: 
 6529:    Element *elem = &(mesh->localElemData[i]);
 6530: 
 6531:    // Skip dry elements
 6532:    if (elem->isDry) return;
 6533: 
 6534:    // Local sum array for this thread
 6535:    double localSum[N_TRACERS] = {0.0};
 6536: 
 6537:    // Sum over vertical levels for this element
 6538:    const int kbe = elem->kbe;
 6539:    const double area = elem->area;
 6540: 
 6541:    for (int k = kbe; k < nvrt; k++) {
 6542:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6543:       
 6544:       // Accumulate tracer mass
 6545:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6546:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6547:       }
 6548:    }
 6549: 
 6550:    //  This function returns per element sums. A reduction must be done on the host side.
 6551: }
 6552: 
 6553: 
 6554: __global__ void transport(void) {
 6555: 
 6556:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6557: 
 6558:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6559: 
 6560:    Element *elem = &(mesh->localElemData[ie]);
 6561: 
 6562:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6563: 
 6564:                for (int m=0; m<ntr; m++) {
 6565:                   for (int k=kbe(ie); k<nvrt; k++) {
 6566:                      // Calculate each polynomial's weight 
 6567:                      wm=0.d0; sum1=0.d0; 
 6568:                      wm1=0.d0; wm2=0.d0; 
 6569:                      for (int i=0; i<elem->nweno2; i++) {
 6570:                   
 6571:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6572:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6573:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6574:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6575:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6576:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6577:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6578:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6579:                      // -----------------Hu and Shu (1999)'s method----------------
 6580:                      b4=b1+b2+b3
 6581: 
 6582: //Error: add PRODUCTION CPP
 6583: #ifdef DEBUG
 6584:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6585:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6586:                     call parallel_abort(errmsg)
 6587:                   }
 6588: #endif
 6589: 
 6590:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6591:                   // !----test-------------- 
 6592:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6593:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6594:                   // !wm(i)=wm1(i)*wm2(i)
 6595:                   // !---------------------- 
 6596:                   sum1=sum1+wm(i)
 6597:                 } // end for i
 6598: 
 6599:                 wm=wm/sum1
 6600: 
 6601:                 for (int j=0; j<elem->i34; j++) {
 6602: 
 6603:                   const Side *side  = elem->sides[j];
 6604:                   const Node *node1 = side->n1;
 6605:                   const Node *node2 = side->n2;
 6606: 
 6607:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6608:                      trsd=0.d0
 6609:                      for (int kk=0; kk<nquad; kk++) {
 6610:                         for (int i=0; i<elem->nweno2; i++) {
 6611:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6612:                         } // end for i   
 6613:                      } // end for kk
 6614:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6615:                   } // outward flux
 6616:                } // end for j=1,i34(ie) ! side
 6617:             }
 6618:          }
 6619:               
 6620: 
 6621: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6622: //             //   calculate each polynomial's weight 
 6623: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6624: //                 wm=0.d0; sum1=0.d0
 6625: //                 do i=1,nweno1(ie) !for each polynomial
 6626: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6627: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6628: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6629: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6630: //                   wm(i)=b2
 6631: //                   sum1=sum1+b2
 6632: //                   !wm(i)=1.d0
 6633: //                   !sum1=sum1+1.d0
 6634: 
 6635: // // Error: PRODUCTION
 6636: // #ifdef DEBUG
 6637: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6638: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6639: //                     call parallel_abort(errmsg)
 6640: //                   endif
 6641: // #endif
 6642: 
 6643: //                 enddo !i
 6644: //                 wm=wm/sum1 !final weight
 6645: 
 6646:                 for (int j=0; j<elem->i34; j++) { // side
 6647:                   const Side *side = elem->sides[j];
 6648:                   const Node *node1 = side->n1;
 6649:                   const Node *node2 = side->n2;
 6650: 
 6651:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6652:                     trsd=0.d0
 6653:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6654:                       for (int i=0; i<elem->nweno1; i++) {
 6655:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6656:                       }
 6657:                     enddo //kk
 6658:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6659:                   } // outward flux
 6660:                 } // end for j=1,i34(ie) ! side
 6661:               } // end for k; ntr 
 6662: 
 6663:             else !simple upwind method
 6664:               do j=1,i34(ie)
 6665:                 jsj=elside(j,ie)
 6666:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6667:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6668:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6669:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6670:                   endif
 6671:                 enddo  !vertical layers
 6672:               enddo !j=1,i34(ie) ! side
 6673:             endif !order of accuracy
 6674: 
 6675:          //  enddo !ie
 6676: // !$OMP     end do
