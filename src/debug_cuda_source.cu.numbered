 9807: template<TurbulenceModel M>
 9808: __device__ __forceinline__ double getTKE(const Turbulence<M> &turb, int k) {
 9809:    if constexpr (M == TurbulenceModel::GLS)
 9810:       return turb.tke[k];
 9811:    else
 9812:       return 0.0;
 9813: }
 9814: template<TurbulenceModel M>
 9815: __device__ __forceinline__ double getMXL(const Turbulence<M> &turb, int k) {
 9816:    if constexpr (M == TurbulenceModel::GLS)
 9817:       return turb.mxl[k];
 9818:    else
 9819:       return 0.0;
 9820: }
