  591:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  592:    
  593:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  594: 
  595:    __device__ Vector2 grad2(double *a) const
  596:    {
  597:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  598:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  599:       if (isQuad()) {
  600:          gx += a[3]*gradPhi[3].x;
  601:          gy += a[3]*gradPhi[3].y;
  602:       }
  603:       return {gx, gy};
  604:    }
  605: 
  606:    __device__ Vector2 grad2(double Node::* field) const
  607:    {
  608:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  609:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  610:       if (isQuad()) {
  611:          gx += (nodes[3]->*field)*gradPhi[3].x;
  612:          gy += (nodes[3]->*field)*gradPhi[3].y;
  613:       }
  614:       return {gx, gy};
  615:    }
  616: 
  617:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  618:    __device__ __forceinline__ Vector3 n(int k) const {
  619:       double area3D;
  620:       return n(k, area3D);
  621:     }
