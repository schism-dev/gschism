 7084: __global__ void returnMatrix(double *res) {
 7085:    // Debugging: returns the matrix as a CuPy array
 7086: 
 7087:    const int size = mesh->np;
 7088:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7089:       const Node *node = mesh->localNodeData + idx_node;
 7090:       res[idx_node*size + idx_node] = node->coeffDiag;
 7091:       for (int j = 0; j < node->numNodes; j++) {
 7092:          Node* nbNode = node->nodes[j];
 7093:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7094:       }
 7095: 
 7096:    }
 7097:    
 7098: }
