  300: // ------------------------------------------------------------------------------------------------
  301: 
  302: 
  303: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  304:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  305:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  306: }
  307: 
  308: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  309:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  310:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  311: }
  312: 
  313: 
  314: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  315:    x3 = y1*z2 - y2*z1;
  316:    y3 = x2*z1 - x1*z2;
  317:    z3 = x1*y2 - x2*y1;
  318: }
  319: 
  320: 
  321: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  322: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  323: 
  324:    const double radius2 = dot(p, p);
  325:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  326:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  327: 
  328:    rlon = atan2(p.y, p.x); // (-pi,pi]
  329: 
  330:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  331:       rlat = asin(p.z/sqrt(radius2));
  332:    } else {
  333:       rlat = asin(p.z/rearth_pole);
  334:    }
  335:   
  336: }
  337: 
  338: __inline__ __device__ void Error(const char* msg) {
  339:    printf("Error: %s\n", msg);
  340:    assert(false);
  341: }
  342: 
  343: struct Tracers {
  344:     double tracer[N_TRACERS];
  345: };
  346: 
  347: 
  348: 
  349: struct Frame {
  350:    double _t[9]; // t stands for tensor.
  351: 
  352:    // Access the tensor in Fortran order
  353:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  354: 
  355:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  356: 
  357:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  358: 
  359:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  360:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  361:       sincos(ar2, &sin_ar2, &cos_ar2);
  362: 
  363:       t(0,0) = -sin_ar1;
  364:       t(1,0) =  cos_ar1;
  365:       t(2,0) =  0.0;
  366:       t(0,1) = -cos_ar1*sin_ar2;
  367:       t(1,1) = -sin_ar1*sin_ar2;
  368: 
  369:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  370: 
  371:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  372:       assert (ar4!=0.0 && "GRID: ar4=0");
  373: 
  374:       const double ar4_inv = 1.0/ar4;
  375:       t(0,1) = t(0,1)*ar4_inv;
  376:       t(1,1) = t(1,1)*ar4_inv;
  377:       t(2,1) = t(2,1)*ar4_inv;
  378: 
  379:       // The third vector is the cross product of the first two
  380:       crossProduct(t(0,0), t(1,0), t(2,0), 
  381:                    t(0,1), t(1,1), t(2,1), 
  382:                    t(0,2), t(1,2), t(2,2));
  383:    }
  384: 
  385: 
  386:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  387:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  388:    // Inputs:
  389:    //        vec0: vel. in this frame;
  390:    //        frameout: Output frame;
  391:    // Output: 
  392:    //        vec1: vel. in new frame  
  393: 
  394:       auto const fo = frameout;
  395:       Vector2 vec1;
  396: 
  397:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  398:       // of t and fo.t are the same.
  399:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  400:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  401: 
  402:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  403:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  404: 
  405:       return vec1;
  406:    }
  407: 
  408:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  409:       // Transform a vector from global to local frame
  410:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  411:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  412:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  413:    }
  414: 
  415:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  416:       // Transform a vector from local to global frame
  417:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  418:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  419:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  420:    }   
  421: 
  422:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  423:    // Tranforms a point from global to local frame     
  424:       G2L(pi - origin0, po);
  425:    }
  426: 
  427:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  428:    // Transforms a point from local to global frame      
  429:       L2G(pi, po);
  430:       po = po + origin0;
  431:    }
  432: 
  433: };
