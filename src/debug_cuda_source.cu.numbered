 8391: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 8392:    Element *elems = mesh->localElemData;
 8393: 
 8394:    *addr = elems;
 8395:    *sizeElement = sizeof(Element);
 8396:    switch (varCode) {
 8397:       case (int)VarCode::z:
 8398:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 8399:          *sizeType = sizeof(double);
 8400:          break;
 8401:       case (int)VarCode::x:
 8402:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 8403:          *sizeType = sizeof(Vector2);
 8404:          break;
 8405:       case (int)VarCode::gradETP:
 8406:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
 8407:          *sizeType = sizeof(Vector2);
 8408:          break;
 8409:       case (int)VarCode::area:
 8410:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 8411:          *sizeType = sizeof(double);
 8412:          break;
 8413:       case (int)VarCode::depth:
 8414:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 8415:          *sizeType = sizeof(double);
 8416:          break;
 8417:       case (int)VarCode::radius:
 8418:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 8419:          *sizeType = sizeof(double);
 8420:          break;
 8421:       case (int)VarCode::ghat:
 8422:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 8423:          *sizeType = sizeof(Vector2);
 8424:          break;
 8425:       case (int)VarCode::kb:
 8426:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 8427:          *sizeType = sizeof(int);
 8428:          break;
 8429:       case (int)VarCode::isdry:
 8430:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 8431:          *sizeType = sizeof(int);
 8432:          break;            
 8433:       case (int)VarCode::w:
 8434:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 8435:          *sizeType = sizeof(double);
 8436:          break;
 8437:       case (int)VarCode::FaceIndices:
 8438:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 8439:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 8440:          *sizeType = sizeof(Node);
 8441:          break;
 8442:       default:
 8443:          *offset = -1;
 8444:    }
 8445: }
