 8085: __global__ void getStructSizes(int* sizes)  {
 8086:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 8087:       sizes[0] = (int)sizeof(Node);
 8088:       sizes[1] = (int)sizeof(Element);
 8089:       sizes[2] = (int)sizeof(Side);
 8090:       sizes[3] = (int)sizeof(NodeBoundary);
 8091:       sizes[4] = (int)sizeof(SideBoundary);
 8092:       sizes[5] = (int)sizeof(BoundarySegment);
 8093: }
