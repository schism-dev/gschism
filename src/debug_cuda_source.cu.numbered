 7395: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
 7396:    Side *sides = mesh->localSideData;
 7397: 
 7398:    *addr = sides;
 7399:    *sizeSide = sizeof(Side);
 7400:    switch (varCode) {
 7401:       case (int)VarCode::z:
 7402:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
 7403:          *sizeType = sizeof(double);
 7404:          break;
 7405:       // case (int)VarCode::depth:
 7406:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7407:       //    *sizeType = sizeof(double);
 7408:       //    break;         
 7409:       case (int)VarCode::x:
 7410:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7411:          *sizeType = sizeof(Vector2);
 7412:          break;
 7413:       case (int)VarCode::len:
 7414:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7415:          *sizeType = sizeof(double);
 7416:          break;
 7417:       case (int)VarCode::kb:
 7418:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7419:          *sizeType = sizeof(int);
 7420:          break;
 7421:       case (int)VarCode::isdry:
 7422:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7423:          *sizeType = sizeof(int);
 7424:          break;            
 7425:       case (int)VarCode::w:
 7426:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7427:          *sizeType = sizeof(double);
 7428:          break;
 7429:       case (int)VarCode::u:
 7430:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7431:          *sizeType = sizeof(Vector2);
 7432:          break;   
 7433:       case (int)VarCode::btu:
 7434:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7435:          *sizeType = sizeof(Vector2);
 7436:          break;          
 7437:       case (int)VarCode::U:
 7438:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7439:          *sizeType = sizeof(Vector2);
 7440:          break;
 7441:       // case (int)VarCode::ghat:
 7442:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7443:       //    *sizeType = sizeof(Vector2);
 7444:       //    break;   
 7445:       case (int)VarCode::hhat:
 7446:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7447:          *sizeType = sizeof(Vector2);
 7448:          break;      
 7449:       case (int)VarCode::chi:
 7450:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7451:          *sizeType = sizeof(double);
 7452:          break;
 7453:       case (int)VarCode::n1:
 7454:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7455:          *sizeType = sizeof(Node);
 7456:          break;
 7457:       case (int)VarCode::n2:
 7458:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7459:          *sizeType = sizeof(Node);
 7460:          break;                   
 7461:       default:
 7462:          *offset = -1;
 7463:    }
 7464: }
