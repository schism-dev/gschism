 1124: // This struct is used to store the boundary information for a node.
 1125: struct NodeBoundary {   
 1126:    BoundarySegment *segment;
 1127:    Node *node;
 1128:    
 1129:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1130:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1131: 
 1132:    bool isLand;
 1133: 
 1134:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1135:    double elbc;   // Elevation boundary condition
 1136:    double eth;    // Elevation time history
 1137: 
 1138:    double eta_mean; // Mean elevation at nodes
 1139: 
 1140:    bool isEssentialBC;
 1141: 
 1142:    Vector2 uth[nvrt];  // "Time history" velocity
 1143: 
 1144:    // Arrays for harmonic constituents (if needed)
 1145:    double  emo[nbfr];  // Elevation amplitude
 1146:    double  efa[nbfr];  // Elevation phase
 1147:    Vector2 umo[nbfr];  // velocity amplitude
 1148:    Vector2 ufa[nbfr];  // velocity phase
 1149: 
 1150: 
 1151:    NodeBoundary(void) {
 1152:       isLand = false;
 1153:    }
 1154:    NodeBoundary(bool _isLand) {
 1155:       isLand = _isLand;
 1156:    }
 1157: 
 1158:    
 1159:    __forceinline__ __device__ int numSidesForAverage() const {
 1160:    // Returns the number of sides that are connected to the node and have the same segment.
 1161:    // This is used to compute the average velocity at the node for open boundary nodes.
 1162:       int res = 0;
 1163:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1164:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1165: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1166:       return res;
 1167:    }
 1168: 
 1169: 
 1170:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1171:       assert(index == 0 || index == 1); 
 1172:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1173:    }
 1174: 
 1175: 
 1176: };
