 8083: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 8084:    // Get the value of a variable from an element
 8085:    // varName is the name of the variable to get
 8086:    // var is the array to store the value
 8087:    // k is the vertical level index of the variable to get
 8088: 
 8089:    ELEM(elem);
 8090:    
 8091:    int idx = elem->idx;
 8092:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8093: 
 8094:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8095:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 8096:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 8097:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 8098:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 8099:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 8100:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 8101:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 8102:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 8103:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 8104:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 8105:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 8106:       
 8107:    
 8108: }
 8109: 
 8110: 
 8111: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 8112:    // Get the value of a variable from an node
 8113:    // varName is the name of the variable to get
 8114:    // var is the array to store the value
 8115:    // k is the vertical level index of the variable to get
 8116: 
 8117:    NODE(node);
 8118:    
 8119:    int idx = node->idx;
 8120:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8121: 
 8122:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 8123:    
 8124:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 8125:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 8126:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 8127:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 8128:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 8129:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 8130:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 8131:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 8132:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 8133:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 8134:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 8135:    
 8136:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 8137:       
 8138:    
 8139: }
 8140: 
 8141: 
 8142: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 8143:    // Get the value of a variable from an side
 8144:    // varName is the name of the variable to get
 8145:    // var is the array to store the value
 8146:    // k is the vertical level index of the variable to get
 8147:    SIDE(side);
 8148:    
 8149:    int idx = side->idx;
 8150:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 8151: 
 8152:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 8153:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 8154:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 8155:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 8156:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 8157:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 8158:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 8159:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 8160:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 8161:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 8162:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 8163:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 8164:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 8165:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 8166:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 8167:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 8168:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 8169:    else if (varCode == (int)VarCode::bcc && k >= 0)     var[idx] = side->bcc[k].x;
 8170:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 8171:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 8172:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 8173:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 8174:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 8175:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 8176:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 8177:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 8178:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 8179:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 8180:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 8181:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 8182:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 8183:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 8184:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 8185:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 8186:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 8187:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 8188: }
 8189: 
 8190: 
 8191: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8192:    // Get the value of a variable from an side
 8193:    // varName is the name of the variable to get
 8194:    // var is the array to store the value
 8195:    // k is the vertical level index of the variable to get
 8196:    SIDE_BND(sideBnd);   
 8197: 
 8198:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8199:    if (sideBnd->segment->isLand) idx = -7;
 8200: 
 8201:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8202:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8203: 
 8204: }
