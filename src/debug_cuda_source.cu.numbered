 2537: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2538: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2539: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2540: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2541: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2542: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2543:    Vector2 grad = {0.0, 0.0};
 2544:    int count = 0;
 2545: 
 2546:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2547: 
 2548:    // First element
 2549:    if (elems[0] != nullptr && condition(elems[0])) {
 2550:       grad += elems[0]->grad2(field);
 2551:       count++;
 2552:    }
 2553: 
 2554:    // Second element
 2555:    if (elems[1] != nullptr && condition(elems[1])) {
 2556:       grad += elems[1]->grad2(field);
 2557:       count++;
 2558:    }
 2559: 
 2560:    if (count > 0) {
 2561:       grad = grad/count;
 2562:    }
 2563:    
 2564:    return grad;
 2565: }
