 8167: #ifdef DONTCOMPILE
 8168: __device__ void computeVerticalAdvection(void) {
 8169:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 8170: 
 8171:    sdbt(1:2,:,:)=0.d0
 8172: 
 8173:    const Side *side = FROM kernel;
 8174: 
 8175:    if(side->isDry) return;
 8176: 
 8177:    // If side is wet...
 8178: 
 8179: 
 8180:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 8181:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 8182:    double ws[nvrt] = {} // w @ side
 8183:    int icount = 0;
 8184:    for (int j=0; j<2; j++) {
 8185:       const Element *elem = side->elements[j];
 8186:        
 8187:       if(elem != nullptr) {
 8188:          icount++;
 8189:          for (int k=0; k<nvrt; k++) {
 8190:             ws[k] = ws[k] + elem->w[k];
 8191:          }
 8192:       }
 8193:    }  // for j
 8194: 
 8195:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 8196:    ws = ws/icount;
 8197: 
 8198:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 8199:    // Splines allow for a smooth transition between vertical levels.
 8200:    // Splines have continuity restrictions at the internal knots, but
 8201:    // we have to provide the 1st derivatives at the endpoints.
 8202:    const int kbs = side->kbs; 
 8203:    
 8204:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8205:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8206:    initCubicSpline(kbs, nvrt, side, ws, up)
 8207: 
 8208:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 8209:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 8210:    initCubicSpline(kbs, nvrt, side, ws, vp)
 8211: 
 8212:    // Total advection (average onto side)
 8213:    const Node *node1 = side->nodes[0];
 8214:    const Node *node2 = side->nodes[1];
 8215:    for (int k=kbs(i); k<nvrt; k++) {
 8216: 
 8217:       Vector2 bcc1 = node1->bcc[k];
 8218:       Vector2 bcc2 = node2->bcc[k];
 8219:       if constexpr(ics == 2) {
 8220:          // Project the velocities from the node frames to the side frame
 8221:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 8222:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 8223:       }
 8224: 
 8225:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 8226:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 8227: 
 8228:    }
 8229: }
 8230: #endif
 8231: 
 8232: 
 8233: extern "C" {
 8234:    __global__ void computeElemAverageGhat(void) {
 8235:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 8236: 
 8237:       ELEM(elem);
 8238:       
 8239:       elem->ghat1= {0.0, 0.0};  
 8240: 
 8241:       if constexpr(ihydraulics != 0) {
 8242:          if (nhtblocks > 0 && elem->isblock) return;
 8243:       }
 8244: 
 8245:       
 8246:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 8247:       // cff1-3: coefficients for 2D/3D
 8248: 
 8249:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 8250:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 8251:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 8252: 
 8253:       if (elem->isDry) return;
 8254: 
 8255:       // Average of the coefficients
 8256:       double av_cff1 = 0.0;  // av. for cff1
 8257:       double av_cff2 = 0.0;  // av. for cff2
 8258:       double av_cff3 = 0.0;  // av. for cff3
 8259:       double av_df = 0.0;  // av. for H^\alpha / H
 8260:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 8261:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 8262: 
 8263:       const int i34 = elem->i34;
 8264:       const int kb  = elem->kb;
 8265: 
 8266:       for (int j=0; j<i34; j++) {
 8267:          // For each node and side in the element...
 8268: 
 8269:          const Node *node = elem->nodes[j];
 8270:          const Side *side = elem->sides[j];
 8271: 
 8272:          const double chi      = side->chi;
 8273:          const double veg_c2   = side->veg_c2;
 8274:          const double veg_beta = side->veg_beta;
 8275:          const double veg_h    = side->veg_h();
 8276:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 8277: 
 8278:          const Vector2 gradPhi = elem->gradPhi[j];
 8279: 
 8280:          // Node - const in elem
 8281:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 8282:          elem->gradPr  += node->pr  *gradPhi;
 8283: 
 8284:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 8285: 
 8286:         
 8287:          const double htot  = side->htot2();        // Total depth at the side
 8288:          const double zctr2 = side->zTopCanopy();  
 8289: 
 8290:          double cff1; 
 8291:          double cff2; 
 8292:          double cff3;   
 8293:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 8294:          // coefficients applied to 2D/3D case 
 8295:             cff1 = side->hhat/htot;
 8296:             cff2 = 0.0;
 8297:             cff3 = 0.0;
 8298:          } else { //3D
 8299:             //Init for no-veg case
 8300:             cff1 = 1.0;
 8301:             cff2 = 1.0;
 8302:             cff3 = 0.0;
 8303: 
 8304:             if constexpr(iveg != 0) {
 8305:                // Computes coefficients used with vegetation terms G1, G2
 8306:                // cff1, cff3 are used for the first two terms in G1, G2:
 8307:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 8308:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 8309:                // In general, cff1*Ustar - cff3*Ustar_alpha
 8310:                if(veg_h < 0.99*htot) { // submergent vegetation
 8311:                   cff1 = 1.0;
 8312:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 8313:                   cff3 = veg_c;
 8314: 
 8315:                } else { // emergent vegetation
 8316:                   cff1 = 1.0/(1.0 + veg_c2);
 8317:                   cff2 = cff1;
 8318:                   cff3 = 0.0;
 8319: 
 8320:                }
 8321:             } // if iveg
 8322:          } //  2D/3D
 8323: 
 8324:          av_cff1 += cff1/i34;
 8325:          av_cff2 += cff2/i34;
 8326:          av_cff3 += cff3/i34;
 8327:          av_cff2_chi += cff2*chi/i34;
 8328:          av_cff3_chi += cff3*chi/i34;
 8329:          av_df += min(htot, veg_h)/(htot*i34);
 8330: 
 8331: 
 8332:          // btrack values: U^\star, U^{\star\alpha}
 8333:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 8334:          Vector2 Ustar       = {0.0, 0.0}; 
 8335:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 8336: 
 8337:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 8338:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 8339:          } else { //3D
 8340:             for (int k = side->kb + 1; k < nvrt; k++) {
 8341:             
 8342:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 8343:                Ustar += w2;
 8344: 
 8345:                if constexpr(iveg != 0) {
 8346:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 8347:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 8348:                        Ustar_alpha += zrat*w2; // XXXX
 8349:                    }
 8350:                }  // if iveg
 8351:             }  // for k
 8352:          }  //2D/3D
 8353: 
 8354:          // If needed, project the side velocities to the element frame
 8355:          if constexpr(ics==2) {
 8356:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 8357:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 8358:          }
 8359:         
 8360: 
 8361:          // Add btrack & surface stress terms to \breve{G} first
 8362:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 8363: 
 8364: 
 8365:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 8366:          Vector2 tau    = side->tau();  
 8367:          Vector2 ubstar = side->btu[side->kb + 1];  
 8368: 
 8369:          // If needed, project tau and ubstar to the element frame
 8370:          if constexpr(ics==2) {
 8371:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 8372:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 8373:          }
 8374: 
 8375:          // Term for surface and bottom stress
 8376:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 8377: 
 8378: 
 8379:          // All terms in F,F^\alpha,f_b except baroclinic
 8380:          // F, f_b: all explicit terms excluding vegetation 
 8381:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 8382:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 8383:          const double coriolis = side->coriolis;
 8384:          Vector2 F  =  coriolis*side->U;  // F_x
 8385:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 8386:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 8387: 
 8388:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 8389:             
 8390:             for (int k = side->kb; k < nvrt; k++) {
 8391:                if (zctr2 > side->zc[k-1]) {
 8392:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 8393:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8394:                    Fa +=  coriolis*w2*zrat;
 8395:                } // if zctr2
 8396:             } // k
 8397:          } // iveg
 8398: 
 8399:          // Integrate horizontal viscosity force vertically
 8400:          for (int k=side->kb + 1; k<nvrt; k++) {
 8401:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 8402: 
 8403:             F += levelHorVisc;
 8404: 
 8405:             // Vegetation term
 8406:             if constexpr(iveg!=0) {
 8407:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 8408:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 8409:                   Fa += levelHorVisc*zrat;
 8410:                } 
 8411:             } // if iveg
 8412:          } // for k
 8413: 
 8414:          // Get nu*grad(U) at the side's bottom level
 8415:          Vector2 nuGradU = side->nuGradU[side->kb];
 8416: 
 8417:          fb += nuGradU;
 8418: 
 8419:          // If needed, project vectorsF, fb and Fa to the element frame
 8420:          if constexpr(ics==2) {
 8421:             F    = side->frame.projHorVec(F,    elem->frame);
 8422:             fb   = side->frame.projHorVec(fb,   elem->frame);
 8423:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 8424:          } // if ics
 8425: 
 8426:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 8427:       } // for j (nodes and sides)
 8428: 
 8429:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 8430: 
 8431: 
 8432:       // Finish off terms in F, F^\alpha and f_b
 8433:       const double grav3 = elem->mean(&Node::grav2);
 8434:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 8435:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 8436:       for (int j=0; j<i34; j++) { 
 8437:          // For each side in the element...
 8438:          const Side *side = elem->sides[j];
 8439:          const double chi = side->chi;
 8440: 
 8441:          const double htot = side->htot2();
 8442:          const double veg_h = side->veg_h();
 8443:          const Vector2 F  = htot*fb;
 8444:          const Vector2 Fa = min(htot, veg_h)*fb;
 8445: 
 8446:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 8447:       } // for j
 8448: 
 8449:       // tmp is already in elem frame
 8450:       elem->ghat1 += tmp/i34;
 8451: 
 8452:       // Baroclinic force
 8453:       if constexpr(ibc==0) {
 8454:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 8455: 
 8456:          Vector2 Fa = {0.0, 0.0};
 8457:          Vector2 intGradRho = {0.0, 0.0};
 8458:          
 8459:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 8460:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 8461:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 8462: 
 8463:             // \in F [m^2/s/s]
 8464:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 8465:          }
 8466: 
 8467:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 8468:          const Vector2 F = av_df*Fa; //approx
 8469:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 8470: 
 8471:       } // if ibc
 8472: 
 8473: 
 8474: 
 8475:    }
 8476: 
 8477: } // extern "C"
 8478: 
 8479: 
 8480: 
 8481: #ifdef DONTCOMPILE
 8482: __global__ void checkMassConservation(Tracers* sumtr) {
 8483: 
 8484:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 8485: 
 8486:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 8487: 
 8488:    Element *elem = &(mesh->localElemData[i]);
 8489: 
 8490:    // Skip dry elements
 8491:    if (elem->isDry) return;
 8492: 
 8493:    // Local sum array for this thread
 8494:    double localSum[N_TRACERS] = {0.0};
 8495: 
 8496:    // Sum over vertical levels for this element
 8497:    const int kbe = elem->kbe;
 8498:    const double area = elem->area;
 8499: 
 8500:    for (int k = kbe; k < nvrt; k++) {
 8501:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 8502:       
 8503:       // Accumulate tracer mass
 8504:       for (int tr = 0; tr < N_TRACERS; tr++) {
 8505:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 8506:       }
 8507:    }
 8508: 
 8509:    //  This function returns per element sums. A reduction must be done on the host side.
 8510: }
 8511: 
 8512: 
 8513: __global__ void transport(void) {
 8514: 
 8515:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 8516: 
 8517:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 8518: 
 8519:    Element *elem = &(mesh->localElemData[ie]);
 8520: 
 8521:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 8522: 
 8523:                for (int m=0; m<ntr; m++) {
 8524:                   for (int k=kbe(ie); k<nvrt; k++) {
 8525:                      // Calculate each polynomial's weight 
 8526:                      wm=0.d0; sum1=0.d0; 
 8527:                      wm1=0.d0; wm2=0.d0; 
 8528:                      for (int i=0; i<elem->nweno2; i++) {
 8529:                   
 8530:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8531:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8532:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8533:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8534:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8535:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 8536:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 8537:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 8538:                      // -----------------Hu and Shu (1999)'s method----------------
 8539:                      b4=b1+b2+b3
 8540: 
 8541: //Error: add PRODUCTION CPP
 8542: #ifdef DEBUG
 8543:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 8544:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 8545:                     call parallel_abort(errmsg)
 8546:                   }
 8547: #endif
 8548: 
 8549:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 8550:                   // !----test-------------- 
 8551:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 8552:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 8553:                   // !wm(i)=wm1(i)*wm2(i)
 8554:                   // !---------------------- 
 8555:                   sum1=sum1+wm(i)
 8556:                 } // end for i
 8557: 
 8558:                 wm=wm/sum1
 8559: 
 8560:                 for (int j=0; j<elem->i34; j++) {
 8561: 
 8562:                   const Side *side  = elem->sides[j];
 8563:                   const Node *node1 = side->n1;
 8564:                   const Node *node2 = side->n2;
 8565: 
 8566:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 8567:                      trsd=0.d0
 8568:                      for (int kk=0; kk<nquad; kk++) {
 8569:                         for (int i=0; i<elem->nweno2; i++) {
 8570:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 8571:                         } // end for i   
 8572:                      } // end for kk
 8573:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8574:                   } // outward flux
 8575:                } // end for j=1,i34(ie) ! side
 8576:             }
 8577:          }
 8578:               
 8579: 
 8580: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 8581: //             //   calculate each polynomial's weight 
 8582: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 8583: //                 wm=0.d0; sum1=0.d0
 8584: //                 do i=1,nweno1(ie) !for each polynomial
 8585: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8586: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 8587: //                   b1=b1*b1+b2*b2 !smoothness indicator
 8588: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 8589: //                   wm(i)=b2
 8590: //                   sum1=sum1+b2
 8591: //                   !wm(i)=1.d0
 8592: //                   !sum1=sum1+1.d0
 8593: 
 8594: // // Error: PRODUCTION
 8595: // #ifdef DEBUG
 8596: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 8597: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 8598: //                     call parallel_abort(errmsg)
 8599: //                   endif
 8600: // #endif
 8601: 
 8602: //                 enddo !i
 8603: //                 wm=wm/sum1 !final weight
 8604: 
 8605:                 for (int j=0; j<elem->i34; j++) { // side
 8606:                   const Side *side = elem->sides[j];
 8607:                   const Node *node1 = side->n1;
 8608:                   const Node *node2 = side->n2;
 8609: 
 8610:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 8611:                     trsd=0.d0
 8612:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 8613:                       for (int i=0; i<elem->nweno1; i++) {
 8614:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 8615:                       }
 8616:                     enddo //kk
 8617:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 8618:                   } // outward flux
 8619:                 } // end for j=1,i34(ie) ! side
 8620:               } // end for k; ntr 
 8621: 
 8622:             else !simple upwind method
 8623:               do j=1,i34(ie)
 8624:                 jsj=elside(j,ie)
 8625:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 8626:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 8627:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 8628:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 8629:                   endif
 8630:                 enddo  !vertical layers
 8631:               enddo !j=1,i34(ie) ! side
 8632:             endif !order of accuracy
 8633: 
 8634:          //  enddo !ie
 8635: // !$OMP     end do
 8636: 
 8637: // !$OMP     master
 8638: //           !message passing
 8639: //           if (nproc>1) then
 8640: //             !make a copy of side concentrations
 8641: //             trsd_tmp0=trsd_tmp 
 8642: 
 8643: //             !this exchange routine swaps interface concentration between two partitions
 8644: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 8645: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 8646: 
 8647: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 8648: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 8649: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 8650: 
 8651: 
 8652: //             !This obtains final values for interface sides
 8653: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 8654: //       :    endif !nproc>1
 8655: //           !message passing end
 8656: // !$OMP     end master
 8657: // !$OMP     barrier
 8658: 
 8659: 
 8660: // !         Do advection; conc @ dry elem will not be changed
 8661: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 8662: // !$OMP     do reduction(+: h_mass_in)
 8663: //           do i=1,ne
 8664: //             if(idry_e(i)==1) cycle
 8665: 
 8666: 
 8667: // !           Wet elements with 3 wet nodes
 8668: //             do k=kbe(i)+1,nvrt
 8669: 
 8670: 
