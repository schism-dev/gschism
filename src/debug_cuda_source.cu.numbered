 6825: __global__ void printMatrix(void) {
 6826: 
 6827: 
 6828:    // Let only one thread per block print at a time 
 6829: 
 6830:    if (threadIdx.x == 0) {
 6831:       for (int ithread = 0; ithread < blockDim.x; ithread++) {
 6832:          const int idx_node = ithread + blockIdx.x * blockDim.x;
 6833:          if (idx_node >= mesh->np) return;
 6834:          const Node *node = mesh->localNodeData + idx_node;
 6835:          printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 6836:          for (int j = 0; j < node->numNodes; j++) {
 6837:             Node* nbNode = node->nodes[j];
 6838:             if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 6839:          }
 6840:          printf("]\n");
 6841: 
 6842:       }
 6843:    }
 6844: 
 6845: 
 6846: 
 6847: }
