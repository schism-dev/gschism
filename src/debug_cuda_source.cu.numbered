  136: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  137: __device__ __forceinline__ double eta_n(int idxNode) {
  138:    // bit1: 0 -> -1, 1 -> +1
  139:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  140:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  141: }
  142: 
  143: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  144: __device__ __forceinline__ double xi_n(int idxNode) {
  145:    // +1 if (bit0 XOR bit1), else -1
  146:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  147:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  148: 
  149: }
