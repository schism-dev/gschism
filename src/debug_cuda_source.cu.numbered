 1704: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1705:    return;
 1706:    // Lock the mutex
 1707:    lock(&debugPlotMutex);
 1708:  
 1709:    bool ok = true;
 1710:    if (debugPlotIdx == nullptr) ok = false;
 1711:    if (*debugPlotIdx >= 10000) ok = false;
 1712:    if (ok) {
 1713:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1714:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1715:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1716:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1717:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1718:       (*debugPlotIdx)++;
 1719:    }
 1720: 
 1721:    __threadfence();               // ensure all above writes are visible
 1722:    // Unlock the mutex
 1723:    unlock(&debugPlotMutex);
 1724: 
 1725: }
 1726: 
 1727: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xFF0000) {
 1728:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color);
 1729: }
