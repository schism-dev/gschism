 1644: __device__ __inline__ double min3(double a, double b, double c) {
 1645:    return min(a, min(b, c));
 1646: }
 1647: 
 1648: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1649:    return min(a, min(b, min(c, d)));
