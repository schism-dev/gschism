 3086: //       const double x4 = nodes[nxq(i+1)]->x;
 3087: //       const double y4 = nodes[nxq(i+1)]->y;
 3088: 
 3089: //       const Side& side = sides[i];
 3090: 
 3091: //       xIntersect=-1.e25;
 3092: //       yIntersect=-1.e25;
 3093: 
 3094: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 3095: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 3096: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 3097: 
 3098: //       if (delta != 0.0) {
 3099: //          // Solves the two linear equations for tt1 and tt2
 3100: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3101: //          const double tt2 = delta2/delta;
 3102: 
 3103: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3104: //          // Similarly, we use tt2 to compute the intersection point.
 3105: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3106: //             xIntersect = x3 + (x4 - x3)*tt2;
 3107: //             yIntersect = y3 + (y4 - y3)*tt2;
 3108: 
 3109: //             intersectingSide = side;
 3110: //             nextElement = nghbElems[i];
 3111: 
 3112: //             return true;
 3113: //          }
 3114:       
 3115: //       }
 3116: //       else {
 3117: //          // The two segments are parallel
 3118: //          return false;
 3119: //       }
