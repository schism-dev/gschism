 6160:    __global__ void zeroNodalVelocities(void) {
 6161:       NODE(node);
 6162: 
 6163:       for (int k = 0; k < nvrt; k++) {
 6164:          node->u2[k]   = {0.0, 0.0};
 6165:          node->w2[k]   = 0.0;
 6166:          node->utmp[k] = {0.0, 0.0};
 6167:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6168:       }
 6169:    }
 6170:  
 6171: 
 6172:    __global__ void computeNodalVerticalVelocities1(void) {
 6173:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6174:    // Adds the element's vertical velocity times the element's area.
 6175:       ELEM(elem);
 6176: 
 6177:       for (int j = 0; j < elem->i34; j++) {
 6178:          Node *node = elem->nodes[j];
 6179: 
 6180:          for (int k = node->kb; k < nvrt; k++) {
 6181:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6182:          }
 6183:          atomicAdd(&(node->tmp.d), elem->area);
 6184:       }
 6185:    }
 6186: 
 6187:    __global__ void computeNodalVerticalVelocities2(void) {
 6188:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6189:    // Divides by the total area of the elements sharing the    node.
 6190:       NODE(node);
 6191: 
 6192:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6193: 
 6194:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6195:    }
 6196: 
 6197: 
 6198:    __global__ void computeNodalHorizontalVelocities1(void) {
 6199: 
 6200:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6201:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6202: 
 6203:       ELEM(elem);
 6204: 
 6205:       if (elem->isDry) return;
 6206: 
 6207:       const int kb = elem->kb;
 6208:       const bool isTri = elem->isTri();
 6209: 
 6210:       if constexpr(indvel <= 0) {
 6211:          // Assuming discontinous hvel.
 6212: 
 6213:          if (isTri) { // For triangles
 6214:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6215:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6216: 
 6217:             for (int j = 0; j < 3; j++) {
 6218:                // For every node of the triangle...
 6219:                Node *node = elem->nodes[j];
 6220: 
 6221:                if (node->isDry) continue;
 6222: 
 6223:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6224:                const Side *s2 = elem->sides[(j + 1) % 3];
 6225:                const Side *s3 = elem->sides[(j + 2) % 3];
 6226: 
 6227:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6228: 
 6229:                atomicAdd(&(node->tmp.i), 1);
 6230: 
 6231:                for (int k = kb; k < nvrt; k++)  {
 6232:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6233:                   u = clampVelocity(u);
 6234:                   atomicAdd(&(node->utmp[k].x), u.x);
 6235:                   atomicAdd(&(node->utmp[k].y), u.y);
 6236: 
 6237:                }
 6238: 
 6239:             }
 6240:          }
 6241:          else { // For quads
 6242:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6243: 
 6244:          }
 6245: 
 6246:       }
 6247:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6248:       
 6249:    }
 6250: 
 6251: 
 6252:    __global__ void computeNodalHorizontalVelocities2(void) {
 6253:       NODE(node);
 6254: 
 6255:       const int nodeCount = node->tmp.i;
 6256: 
 6257:       if (nodeCount == 0) 
 6258:       {
 6259:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6260:          return;
 6261:       }
 6262: 
 6263:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6264:       
 6265:       const int kb = node->kb;
 6266: 
 6267:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6268:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6269:       
 6270:       
 6271:    }   
 6272: 
 6273:  
