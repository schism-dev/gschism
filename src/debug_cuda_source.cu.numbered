 1623: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1624:    // Computes the 3D normal vector to the element at level k
 1625:    // Returns the normal vector and the area of the element
 1626: 
 1627:       if (isTri()) {
 1628:          // For triangles...
 1629: 
 1630:          // Gets the normal vector to the element (with a length equal to twice the area)
 1631:          if constexpr(ics==1) {
 1632:             const int kb0 = max(k, nodes[0]->kb);
 1633:             const int kb1 = max(k, nodes[1]->kb);
 1634:             const int kb2 = max(k, nodes[2]->kb);
 1635: 
 1636:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1637:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1638:             
 1639:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1640:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1641:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1642:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1643: 
 1644:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1645:             area3D = 0.5*len;
 1646: 
 1647:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1648: 
 1649:             return {nx/len, ny/len, nz/len};
 1650: 
 1651:            
 1652:          }
 1653:          else {  // lat/lon
 1654:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1655: 
 1656:          } // if ics
 1657:       }
 1658:       else {
 1659:          // For quads...
 1660: 
 1661:          assert(false && "Element normal vector: quads not yet implemented");
 1662: 
 1663: 
 1664:       }
 1665:    }
 1666: 
 1667: /**
 1668:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1669:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1670:    If the segment is completely inside the element, then it returns true.
 1671: 
 1672:    This function assumes:
 1673:    - The initial point is on a side of the element. 
 1674:    - Its position is given by parameter t in the range [0,1].
 1675:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1676:       intersects the element (elements are convex).
 1677: 
 1678:    To find the intersection point, this function does the following:
 1679:    - it finds the intersection of the line segment with all the element side lines,
 1680:       except for the one that contains the initial point.
 1681:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1682:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1683:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1684:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1685:       track segment is almost parallel to the element side line.
 1686: 
 1687:    Inputs:
 1688:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1689:    @param x2, y2: other end of the line segment
 1690: 
 1691:    Outputs:
 1692:    @param side:  side that intersects the line segment (input and output)
 1693:    @param nextElement (output): element that contains the intersection point
 1694:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1695:    @param zint (input/output): Vertical coordinate of the intersection point
 1696: 
 1697:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1698:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1699:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1700: 
 1701:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1702:    (Delta) being zero.
 1703: 
 1704:    The intersection2 point happens when:
 1705:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1706:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1707:    
 1708:    Assumption: the 4 points (including those of the side segment) are different.
 1709:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1710:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1711:    If true, (xIntersect,yIntersect) is the intersection.				
 1712:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1713: **/
 1714: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1715:                                               double &t, double& tIntersect) {
 1716: 
 1717:    double closest_intersect_t = 1e10;
 1718:    bool found_intersection = false;
 1719: 
 1720:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1721:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1722:    const Point2 x1 = side->point(t);
 1723:    
 1724: 
 1725:    Side *nextSide = nullptr;
 1726:    for (int i = 0; i < i34; i++) {
 1727: 
 1728:       // Element's i-th side 
 1729:       Side *side2 = sides[i];
 1730: 
 1731:       // Skip the side that contains the initial point
 1732:       if (side2 == side) continue;
 1733: 
 1734:       // (x3,y3)-(x4,y4) is the element side line
 1735:       const Point2 x3 = side2->n1->p2();
 1736:       const Point2 x4 = side2->n2->p2();
 1737: 
 1738:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1739:       const double delta = cross(x2 - x1, x3 - x4);
 1740: 
 1741:       if (delta != 0.0) {
 1742: 
 1743:          const double delta1 = cross(x3 - x1, x3 - x4);
 1744:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1745: 
 1746:          // Solves the two linear equations for tt1 and tt2
 1747:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1748:          const double tt2 = delta2/delta;
 1749: 
 1750:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1751:             closest_intersect_t = min(closest_intersect_t, tt1);
 1752:             nextSide = side2;
 1753: 
 1754:             nextElement = nextSide->otherElem(this);
 1755:             tIntersect = max(small, min(tt1, 1.0-small));
 1756:             t = tt2;
 1757: 
 1758:             found_intersection = true;
 1759:          }
 1760:       
 1761:       }
 1762: 
 1763:    }
 1764: 
 1765:    // found_intersection should always be true, since we checked all the sides.  
 1766:    side = nextSide;
 1767: 
 1768:    return found_intersection;
 1769: }
 1770: 
 1771: 
 1772: 
 1773: 
 1774: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1775:                                               double &t, double& tIntersect) {
 1776: 
 1777:    double closest_intersect_t = 1e10;
 1778:    bool found_intersection = false;
 1779: 
 1780:    for (int i = 0; i < i34; i++) {
 1781: 
 1782:       Side *side2 = sides[i];
 1783: 
 1784:       // (x3,y3)-(x4,y4) is the element side line
 1785:       const Point2 x3 = side2->n1->p2();
 1786:       const Point2 x4 = side2->n2->p2();
 1787: 
 1788:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1789:       const double delta = cross(x2 - x1, x3 - x4);
 1790: 
 1791:       if (abs(delta) > 0) {
 1792: 
 1793:          const double delta1 = cross(x3 - x1, x3 - x4);
 1794:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1795: 
 1796:          // Solves the two linear equations for tt1 and tt2
 1797:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1798:          const double tt2 = delta2/delta;
 1799: 
 1800:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1801:             closest_intersect_t = min(closest_intersect_t, tt1);
 1802:             side = side2;
 1803:             nextElement = side->otherElem(this);
 1804:             t = tt2;
 1805:             tIntersect = max(small, min(tt1, 1.0-small));
 1806:             found_intersection = true;
 1807:          }
 1808:       
 1809:       }
 1810:       else {  // parallel segments
 1811:          assert(false && "Parallel segments");
 1812:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1813:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1814: 
 1815:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1816: 
 1817:          // const double dist = dot(x1 - x3, side2->n);
 1818:          // if (abs(dist) < small*length(x3 - x4)) {
 1819:          //    const double2 unitarySide = normalize(x4 - x3);
 1820:          //    const double len = dot(x2 - x1, unitarySide);
 1821:          //    t = t + len;
 1822:          //    t = max(0.0, min(t, 1.0));
 1823:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1824: 
 1825: 
 1826:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1827:          //    // t = tt2;
 1828:          //    found_intersection = true;
 1829:          // }
 1830:       }
 1831: 
 1832: 
 1833:    }
 1834: 
 1835:       
 1836:    assert(found_intersection && "No intersection found");
 1837: 
 1838:    // found_intersection should always be true, since we checked all the sides.  
 1839:    return found_intersection;
 1840: }
 1841: 
 1842: 
 1843: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1844:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1845: 
 1846:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1847: 
 1848:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1849:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1850:    // curElement.
 1851: 
 1852:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1853:    // And uses this velocity instead to continue the tracking.
 1854: 
 1855:    // computes the intersection point in cartesian coordinates
 1856:    Point2 intersection = nextSide->p_t(tt);
 1857: 
 1858:    // Nudges the point to the barycenter of the element. 
 1859:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1860:    // next segment intersects the element sides.  
 1861:    curElem->nudgeToBarycenter(intersection);
 1862: 
 1863:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1864:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1865:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1866:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1867: 
 1868:    // If the side is an open boundary, the tangential velocity is zero.
 1869:    if (nextSide->isBnd()) vtan = 0.0;
 1870: 
 1871:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1872:    const double us = vtan*nextSide->t().x;
 1873:    const double vs = vtan*nextSide->t().y;
 1874:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1875: 
 1876:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1877:    const double len2 = norm2(intersection - toPoint2(xt));
 1878:    const double vel2 = dot(u_int, u_int);        
 1879:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1880:    else            dt = 0.0;
 1881: 
 1882:    // The end of this tracking segment is now the intersection point.
 1883:    xt = {intersection.x, intersection.y, zint};
 1884: 
 1885:    u_int = {us, vs, ws};
 1886:    
 1887: }
 1888: 
 1889: /**
 1890:  * Tracks a particle through elements and vertical levels in the mesh.
 1891:  * 
 1892:  * @param x0,y0,z0     Starting position coordinates
 1893:  * @param xt,yt,zt     Target position coordinates
 1894:  * @param dtb          Time step for tracking
 1895:  * @param uuint,vvint,wwint Initial velocity components
 1896:  * @param nextElem     Starting/resulting element index
 1897:  * 
 1898:  * @return Status code of type trackExitCodes
 1899:  * 
 1900:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1901:  * of the details are different. The idea is that the code requires less branches and is better fit
 1902:  * for GPU execution.
 1903:  * 
 1904:  * The main ideas here are:
 1905:  * - The starting point is expected to be in the starting element.
 1906:  * - The end point is guaranteed to be inside an element.
 1907:  * - since the starting point is inside the element, there are only two cases: 
 1908:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1909:  *     (b) it does not and (xt,yt) is already in the starting element.
 1910:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1911:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1912:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1913:  * - tt1 can be positive or negative. We only consider the positive values.
 1914:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1915:  * - The next intersection will occur at the smallest positive tt1.
 1916:  * - This intersection will be the next (x0,y0) position.
 1917:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1918:  *   of getting stuck in a loop.
 1919:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1920:  *   was found.
 1921:  */
 1922: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1923:                                                        Element *&nextElem, int &jlev, double &dt,
 1924:                                                        const Side *origSide) {
 1925: 
 1926: 
 1927: 
 1928:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1929:    // else to do.
 1930:    // If it is, nudges the point to be inside the element.
 1931:    const Element *curElem = nextElem;
 1932:    if (containsPoint(toPoint2(xt), true)) {
 1933: 
 1934:       curElem->interpolateVelocities(xt, u_int);
 1935: 
 1936: addDebugPlot(x0, xt);
 1937:       return true;
 1938:    }
 1939: 
 1940:    Side *side = nullptr;
 1941: 
 1942:    // 1. Initial checks
 1943:    // Verify starting element is valid (wet)
 1944:    assert(!curElem->isDry && "Starting element is dry");
 1945: 
 1946:    // Checks if track has a zero length.
 1947:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1948:    // assert(len2 > 0.0 && "Zero length track"); 
 1949:    
 1950:    const int MAX_ITERATIONS = 1000;
 1951:    
 1952:    double t;
 1953:    Side *nextSide = nullptr;
 1954:    double tIntersect = 1e10;
 1955:    double zint = x0.z;
 1956: 
 1957:    // Horizontal tracking loop
 1958:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1959:    // (x0,y0) is inside the element but the target point is not.
 1960: 
 1961:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1962: 
 1963:    assert(found_intersection && "No intersection found at %d");
 1964: 
 1965:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1966: 
 1967:    // if the tracking segment goes out of water (either dry or edge boundary)
 1968:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1969: 
 1970: addDebugPlot(x0, xt, 0x00A0FF);
 1971:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1972: addDebugPlot(x0, xt, 0x00A0FF);      
 1973: 
 1974:       nextElem = this;
 1975:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1976:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1977:       return true;    
 1978:    }
 1979: 
 1980: 
 1981:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1982:    int iterations = 0;
 1983:    while (iterations < MAX_ITERATIONS) {
 1984:       iterations++;
 1985:       
 1986:       Element *curElem = nextElem;
 1987: 
 1988:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1989: addDebugPlot(x0, xt);
 1990:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1991: 
 1992:       // If we are already in the target element, we are done.
 1993:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1994:       if (!found_intersection) break;
 1995: 
 1996: 
 1997: 
 1998:       // if the tracking segment goes out of water (either dry or edge boundary).
 1999:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2000: addDebugPlot(x0, xt, 0x00A0FF);
 2001:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2002: addDebugPlot(x0, xt, 0x00A0FF);   
 2003:          nextElem = curElem;
 2004: 
 2005:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2006:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2007:          return true;
 2008:       }
 2009:       
 2010:       // Update position and element for next iteration
 2011:       side = nextSide;
 2012: 
 2013:    }
 2014: 
 2015:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2016: 
 2017:  
 2018:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2019:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2020: addDebugPlot(x0, xt);   
 2021:    nextElem->interpolateVelocities(xt, u_int); 
 2022: 
 2023:    return true;
 2024: }
 2025: 
 2026: 
 2027: __inline__ __device__ double Element::computeSignedArea(void) const {
 2028:    // Compute the area of the element
 2029: 
 2030:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2031: 
 2032:    // In the quad case we need to add the area of the other triangle.
 2033:    if (isQuad()) {
 2034:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2035:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2036:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2037:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2038:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2039:          Error("Negative area found in quad element");
 2040:       }
 2041:       res += ar1;
 2042:    }
 2043: 
 2044:    return res;
 2045: }
 2046: 
 2047: 
 2048: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2049:                                                                 (nodes[1]->isDry2()) ||
 2050:                                                                 (nodes[2]->isDry2()) ||
 2051:                                                                 (i34==4 && nodes[3]->isDry2());
 2052: }
 2053: 
 2054: 
 2055: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2056:    // In boundary sides, the element 1 is nullptr
 2057:    return side->elems[1] == nullptr; 
 2058: }
 2059: 
 2060: 
 2061: 
 2062: /**
 2063:    Compute the shape coordinates of the point (xt,yt) in the element.
 2064:    @param xt (input): x-coordinate of the point
 2065:    @param shpCoords (output): shape coordinates of the point
 2066:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2067:    @return true if the point is inside the element, false otherwise
 2068: **/
 2069: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2070:                                             bool fixNegshpCoord) const {
 2071: 
 2072:    // Compute the shape coordinates of the point xt in the element.
 2073:    if (i34==3) {
 2074:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2075:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2076:       // and in this case, the pt will be nudged into the element
 2077:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2078:       // from the local frame, so use additional check.
 2079: 
 2080:       Point2 x0, x1, x2;
 2081: 
 2082:       if constexpr(ics==1) {
 2083:          x0 = nodes[0]->p2();
 2084:          x1 = nodes[1]->p2();
 2085:          x2 = nodes[2]->p2();
 2086:       }
 2087:       else // lat/lon
 2088:       {
 2089:          Error("Not implemented yet");
 2090: #ifdef ICS2
 2091:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2092:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2093:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2094: #endif
 2095:       }
 2096: 
 2097:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2098:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2099:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2100:       shpCoords[3] = 0.0;
 2101:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2102: 
 2103:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2104:       // then we fix the negative shape coordinates.
 2105:       if (fixNegshpCoord && tmpmin<=0.0) {
 2106: 
 2107:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2108:          // keeping the sum of the shape coordinates equal to 1.
 2109:          // I have tested and compared the new algorithm with the old one, and they give
 2110:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2111:          // The new algorithm should be faster since it is branchless.
 2112:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2113:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2114:          
 2115:          shpCoords[0] = (shpCoords[0] + a)*b;
 2116:          shpCoords[1] = (shpCoords[1] + a)*b;
 2117:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2118: 
 2119:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2120:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2121:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2122:          }
 2123: 
 2124:          // Update the point coordinates for the new shape coordinates
 2125:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2126:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2127:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2128: 
 2129:       }
 2130: 
 2131:       // Check if the point is inside the element
 2132:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2133:    }
 2134:    else {
 2135:       Error("Not implemented yet");
 2136: #ifdef QUADS
 2137:       // Reproject pt in eframe of nel for ics=2
 2138:       if constexpr(ics==1) {
 2139:          xn2 = xt; 
 2140:          yn2 = yt;
 2141:       }
 2142:       else {
 2143:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2144:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2145:       }
 2146: 
 2147:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2148: #endif
 2149:    }
 2150: 
 2151:    return false;  // Never reached
 2152: 
 2153: }
 2154: 
 2155: 
 2156: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2157: // Convert shape coordinates to cartesian coordinates
 2158: 
 2159:    if (i34 == 3) {
 2160:       // Triangular element
 2161:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2162:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2163:    }
 2164:    else {
 2165:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2166:    }
 2167: 
 2168: }
 2169: 
 2170: 
 2171: /**  Interpolate velocities at a given point (xt,yt,zt)
 2172: 
 2173:    @param xt, yt, zt: coordinates of the point to interpolate
 2174:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2175: 
 2176:    This is done in four steps:
 2177: 
 2178:    1. Find the shape coordinates for the final position in the element.
 2179:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2180:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2181:       z levels at xt, yt at each step.   
 2182:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2183:       horizontally and vertically.
 2184: **/
 2185: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2186:    // Interpolate the velocities at the point xt. 
 2187:    // This function works the same for triangular and quadrilateral elements.
 2188:    double shpCoord[4];
 2189: 
 2190:    // First step is to compute the shape coordinates of (xt,yt)
 2191:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2192:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2193: 
 2194:    // Second step is to find the level that contains zt
 2195:    // Uses a binary search to find the level
 2196:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2197:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2198:    int R = nvrt - 1;
 2199: 
 2200:    // Get the z coordinates at the nodes of the element at the levels L and R
 2201:    double zLAtNodes[4], zRAtNodes[4];
 2202:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2203:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2204: 
 2205:    double zL = interpolate(shpCoord, zLAtNodes);
 2206:    double zR = interpolate(shpCoord, zRAtNodes);
 2207:    
 2208:    // Interpolates vertically the velocities
 2209:    double wght1, wght2;
 2210:    if (xt.z<=zL) {
 2211:       wght1 = 1.0;
 2212:       wght2 = 0.0;
 2213:    }
 2214:    else if (xt.z>=zR) {
 2215:       wght1 = 0.0;
 2216:       wght2 = 1.0;
 2217:    }
 2218:    else {
 2219:       // Perform a binary search to find the levels between L and R that contain xt.z
 2220:       while (R - L > 1) {
 2221:          int M = (L + R) / 2;
 2222: 
 2223:          double zMAtNodes[4];
 2224:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2225:          double zM = interpolate(shpCoord, zMAtNodes);
 2226:          if (zM < xt.z) 
 2227:          {
 2228:             L = M;
 2229:             zL = zM;
 2230:          }
 2231:          else 
 2232:          {
 2233:             R = M;
 2234:             zR = zM;
 2235:          }
 2236:       }
 2237:       assert(L == R-1);
 2238:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2239: 
 2240:       wght2 = (xt.z - zL)/(zR - zL);
 2241:       wght1 = 1.0 - wght2;
 2242:    }
 2243: 
 2244:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2245:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2246: 
 2247:    // Neither of the interpolated velocities should be NaN
 2248:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2249: 
 2250: }
 2251: 
 2252: 
 2253: 
 2254: 
 2255: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2256: 
 2257:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2258:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2259:    const Node *n1 = side->n1;
 2260:    const Node *n2 = side->n2;
 2261: 
 2262:    bool n1_match = (n1->nodeBnd->segment == segment);
 2263:    bool n2_match = (n2->nodeBnd->segment == segment);
 2264: 
 2265:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2266:    if (n1_match && n2_match) {
 2267:       return 0.5;
 2268:    } else if (n1_match) {
 2269:       return 1.0;
 2270:    } else if (n2_match) {
 2271:       return 0.0;
 2272:    }
 2273:    return 0.0;
 2274: }
 2275: 
 2276: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2277: 
 2278: 
 2279: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2280: 
 2281:    const double w1 = getBoundaryArrayValueWeight();
 2282:    const double w2 = 1.0 - w1;
 2283:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2284:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2285: 
 2286:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2287: }
 2288: 
 2289: 
 2290: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2291:    const double w1 = getBoundaryArrayValueWeight();
 2292:    const double w2 = 1.0 - w1;
 2293:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2294:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2295: 
 2296:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2297: }
