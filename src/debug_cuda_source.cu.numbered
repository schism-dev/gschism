 7129: 
 7130: __global__ void computeMatrixProductAndDotProducts() {
 7131:    // Computes A*p, r'Mr and p'Ap
 7132: 
 7133:    // 1) shared buffer: first half for rMr, second for pAp
 7134:    __shared__ double sdata[2*BLOCK_SIZE];
 7135:    double* s_rMr = sdata;
 7136:    double* s_pAp = sdata + BLOCK_SIZE;
 7137: 
 7138:    const int tid = threadIdx.x;
 7139: 
 7140:    double l_pAp = 0.0;
 7141: 
 7142:    s_rMr[tid] = 0.0;
 7143:    s_pAp[tid] = 0.0;
 7144: 
 7145:    // 2) get your node pointer
 7146:    // NODE(node);   
 7147:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7148:    Node *node = &(mesh->localNodeData[idx_node]); 
 7149:       if (idx_node < mesh->np) {
 7150: 
 7151:       const double diag = node->coeffDiag;
 7152:       const double r    = node->mR;
 7153:       const double p    = node->mP;  
 7154: 
 7155:       // apply preconditioner on the fly:
 7156:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7157: 
 7158:       // 4) compute Ap = A.p
 7159:       double Ap = node->coeffDiag * node->mP;
 7160:       for (int j = 0; j < node->numNodes; ++j) {
 7161:          const Node *nbNode = node->nodes[j];
 7162:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7163: 
 7164:       }
 7165: 
 7166:       node->mAp = Ap;
 7167:       
 7168: 
 7169:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7170:       // const double l_rMr = r*Mr;  // r'Mr
 7171:       l_pAp = p*Ap;  // p'Ap
 7172: 
 7173: 
 7174:    }
 7175: 
 7176:    // 6) write into shared mem
 7177:    // s_rMr[tid] = l_rMr;
 7178:    s_pAp[tid] = l_pAp;
 7179: 
 7180:    __syncthreads();
 7181: 
 7182:    // 7) block-wide tree reduction
 7183:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7184:       if (tid < stride)  {
 7185:          s_pAp[tid] += s_pAp[tid + stride];
 7186:       }
 7187:       __syncthreads();
 7188:    }
 7189: 
 7190:    // 8) thread 0 atomically accumulates into the globals
 7191:    // XXX: This is slower than it needs to be, but it is simple and works
 7192:    if (tid == 0) {
 7193:       atomicAdd(pAp, s_pAp[0]);
 7194:    }
 7195: 
 7196: 
 7197: }
 7198: 
 7199: 
 7200: __global__ void updateSolutionAndDotProducts(void) {
 7201:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7202: 
 7203:    const int tid = threadIdx.x;
 7204: 
 7205:    s_rMr[tid] = 0.0;
 7206: 
 7207:    // get node & bounds-check:
 7208:    NODE(node);
 7209: 
 7210:    
 7211:    // Compute alpha
 7212:    const double alpha = (*rMr_old)/(*pAp); 
 7213: 
 7214: 
 7215:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7216: 
 7217: 
 7218:    // load scalars
 7219:    const double diag = node->coeffDiag;
 7220:    const double p    = node->mP;
 7221:    const double Ap   = node->mAp;
 7222:    const double x    = node->mX;
 7223:    const double r    = node->mR;
 7224:    
 7225:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7226: 
 7227:    // 1) update solution & residual
 7228:    const double x_new = x + alpha*p;
 7229:    const double r_new = r - alpha*Ap;
 7230:    node->mX = x_new;
 7231:    node->mR = r_new;
 7232: 
 7233:    // 2) apply Jacobi preconditioner on the fly
 7234:    const double Mr_new = r_new/diag;
 7235: 
 7236: 
 7237:    // 3) local contributions for the two dot-products
 7238:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7239: 
 7240:    // 4) write into shared-mem
 7241:    s_rMr[tid] = l_rMr;
 7242: 
 7243:    __syncthreads();
 7244: 
 7245: 
 7246:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7247:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7248:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7249:       __syncthreads();
 7250:    }
 7251: 
 7252:    // 6) thread 0 atomically folds into the global accumulators
 7253:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7254: 
 7255: 
 7256: }
 7257: 
 7258: 
 7259: __global__ void updateSearchDirection() {
 7260: 
 7261:     NODE(node);
 7262: 
 7263:     // recompute z on-the-fly
 7264:     const double z = node->mR / node->coeffDiag;
 7265:     const double p = node->mP;
 7266: 
 7267:     const double beta = (*rMr_new)/(*rMr_old);
 7268: 
 7269: 
 7270:     // p =z + beta*p
 7271:     node->mP = z + beta*p;
 7272: 
 7273: }
 7274: 
 7275: __global__ void initializeScalars(double *scalars) {
 7276: 
 7277:    // These point to a cupy array in the host code
 7278:    rMr_old = scalars + 0;
 7279:    rMr_new = scalars + 1;
 7280:    pAp     = scalars + 2;
 7281: }
 7282: 
 7283: __global__ void initializePreconditionedResidual(void) {
 7284: 
 7285:     __shared__ double s_rMr[BLOCK_SIZE];  
 7286: 
 7287:     s_rMr[threadIdx.x] = 0.0;
 7288: 
 7289:     NODE_ALL(node, valid);
 7290:     const int tid = threadIdx.x;
 7291:     // For the first iteration:
 7292:     // 1. Initial solution x = 0 (already set)
 7293:     // 2. Initial residual r = b (stored in qel)
 7294:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7295: 
 7296: // XXX we should use the guess solution here    
 7297: 
 7298:     double l_rMr = 0.0;
 7299:     if (valid) {
 7300:       // Set initial residual r = b (from qel)
 7301:       node->mR = node->qel;
 7302: 
 7303:       // Compute z = M^-1 * r (preconditioned residual)
 7304:       const double z = node->mR / node->coeffDiag;
 7305: 
 7306:       // Set initial search direction p = z
 7307:       node->mP = z;
 7308: 
 7309:       // Initialize other variables needed for CG
 7310:       node->mX = 0.0;  // Initial solution
 7311:       node->mAp = 0.0; // Will be computed in first iteration
 7312: 
 7313: 
 7314:       // Computes the first r'Mr (reduction)
 7315:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7316:     }
 7317:     // 4) write into shared-mem
 7318:     s_rMr[tid] = l_rMr;
 7319: 
 7320:     __syncthreads();
 7321: 
 7322: 
 7323:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7324:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7325:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7326:         __syncthreads();
 7327:     }
 7328: 
 7329:     // 6) thread 0 atomically folds into the global accumulators
 7330:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7331: 
 7332:     *rMr_old = 0.0;
 7333:     *pAp = 0.0;
 7334: }
 7335: 
 7336: 
 7337: 
 7338: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7339:    Element *elems = mesh->localElemData;
 7340: 
 7341:    *addr = elems;
 7342:    *sizeElement = sizeof(Element);
 7343:    switch (varCode) {
 7344:       case (int)VarCode::z:
 7345:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7346:          *sizeType = sizeof(double);
 7347:          break;
 7348:       case (int)VarCode::x:
 7349:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7350:          *sizeType = sizeof(Vector2);
 7351:          break;
 7352:       case (int)VarCode::area:
 7353:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7354:          *sizeType = sizeof(double);
 7355:          break;
 7356:       case (int)VarCode::depth:
 7357:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7358:          *sizeType = sizeof(double);
 7359:          break;
 7360:       case (int)VarCode::radius:
 7361:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7362:          *sizeType = sizeof(double);
 7363:          break;
 7364:       case (int)VarCode::lonlat:
 7365:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7366:          *sizeType = sizeof(double);
 7367:          break;
 7368:       case (int)VarCode::ghat:
 7369:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7370:          *sizeType = sizeof(Vector2);
 7371:          break;
 7372:       case (int)VarCode::kb:
 7373:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7374:          *sizeType = sizeof(int);
 7375:          break;
 7376:       case (int)VarCode::isdry:
 7377:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7378:          *sizeType = sizeof(int);
 7379:          break;            
 7380:       case (int)VarCode::w:
 7381:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7382:          *sizeType = sizeof(double);
 7383:          break;
 7384:       case (int)VarCode::FaceIndices:
 7385:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7386:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7387:          *sizeType = sizeof(Node);
 7388:          break;
 7389:       default:
 7390:          *offset = -1;
 7391:    }
 7392: }
