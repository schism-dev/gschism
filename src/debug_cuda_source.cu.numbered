 2270:    template<typename T>
 2271:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2272:       T values[4];
 2273:       getNodalValues(level, func, values);
 2274: 
 2275:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2276:       if constexpr (IsVector2<T>::value && ics == 2) {
 2277: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2278:          projectNodeVectorsToElementFrame(values);
 2279: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2280:       }
 2281: 
 2282:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2283:    }
 2284: 
 2285:    template<typename T>
 2286:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2287:       T values[4];
 2288:       getNodalValues(field, values);
 2289: 
 2290:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2291:       if constexpr (IsVector2<T>::value && ics == 2) {
 2292: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2293:          projectNodeVectorsToElementFrame(values);
 2294: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2295:       }
 2296:       
 2297:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2298:    }
 2299: 
 2300: 
 2301:    template<typename T>
 2302:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2303:       T values[4];
 2304:       getNodalValues(level, field, values);
 2305:       
 2306: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2307:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2308:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2309:       if constexpr (IsVector2<T>::value && ics == 2) {
 2310: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2311:          projectNodeVectorsToElementFrame(values);
 2312: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2313:       }
 2314: 
 2315:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2316:    }
