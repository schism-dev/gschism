 1395:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1396:       // Compute the different time ramps used in the code 
 1397:       // This function is performed by just one thread
 1398: 
 1399:       if constexpr(ibc == 0) {
 1400:          if (drampbc > 0.0) {
 1401:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1402:          } else {
 1403:             rampbc = 1.0;
 1404:          }
 1405: 
 1406:          if (nws != 0 && drampwind > 0.0) {
 1407:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1408:          } else {
 1409:             rampwind = 1.0;
 1410:          }
 1411:       }
 1412: 
 1413:       if (drampwafo > 0.0) {
 1414:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1415:       } else {
 1416:          rampwafo = 1.0;
 1417:       }
 1418: 
 1419:       // For source/sinks
 1420:       if (if_source && dramp_ss > 0.0) {
 1421:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1422:       } else {
 1423:          ramp_ss = 1.0;
 1424:       }
 1425: 
 1426:       if (dramp > 0.0) {
 1427:          ramp = tanh(2.0*time/86400.0/dramp);
 1428:       } else {
 1429:          ramp = 1.0;
 1430:       }
 1431: 
 1432:       printf("computeTimeRamps: i = %d, time = %f, nws = %d, if_source = %d, ramp = %f, drampbc = %f, drampwind = %f, drampwafo = %f, dramp_ss = %f, dramp = %f\n", 
 1433:              threadIdx.x + blockIdx.x * blockDim.x, time, nws, if_source, ramp, drampbc, drampwind, drampwafo, dramp_ss, dramp);
 1434:    }
 1435:       
