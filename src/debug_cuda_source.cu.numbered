 8108: __global__ void printMatrix(bool full) {
 8109:    // Debugging: print the matrix
 8110: 
 8111:    const int size = mesh->np;
 8112:    double sum = 0.0;
 8113:    for (int idx_node = 0; idx_node < size; idx_node++) {
 8114:       const Node *node = mesh->localNodeData + idx_node;
 8115:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 8116:       for (int j = 0; j < node->numNodes; j++) {
 8117:          Node* nbNode = node->nodes[j];
 8118:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 8119:          sum += node->coeffMatrix[j];
 8120:       }
 8121:       if (full) printf("]\n");
 8122: 
 8123: 
 8124:    }
 8125:    if (!full) printf("sum=%lf\n", sum);
 8126: }
