 3038: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 3039:    // In boundary sides, the element 1 is nullptr
 3040:    return side->elems[1] == nullptr; 
 3041: }
 3042: 
 3043: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 3044:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 3045:    // For ics == 2, this function uses local frame coordinates.
 3046: 
 3047:    assert(isQuad());
 3048: 
 3049:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 3050:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 3051:    // where vxi, veta, vb are vectors and c is the center of the element.
 3052: 
 3053:    Point2 p0, p1, p2, p3;
 3054: 
 3055:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 3056: 
 3057:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 3058:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 3059:    // vectors vxi and veta connect the centers of opposite sides
 3060:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 3061:    // vb is zero for parallelogram elements.
 3062:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 3063: 
 3064:    //  The bilinear mapping is:
 3065:    //      P(s,t) = C + s*U + t*V + s*t*W
 3066:    //
 3067:    //  where:
 3068:    //    C = centroid (average of four vertices)
 3069:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 3070:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 3071:    //    W = bilinear correction; measures deviation from parallelogram
 3072:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 3073:    //        W = 0 for parallelogram elements.
 3074:    //
 3075:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3076:    //
 3077:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3078:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3079:    //
 3080:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3081:    //
 3082:    //  Geometrically, (L) projects everything onto the direction
 3083:    //  perpendicular to W, where the mapping is purely affine.
 3084:    //
 3085:    //  The dot product with nb retains the nonlinear term:
 3086:    //
 3087:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3088:    //
 3089:    //  Geometrically, (Q) projects onto the W direction, where
 3090:    //  the nonlinearity lives.
 3091:    //
 3092:    //  We solve (L) for whichever variable has the larger coefficient
 3093:    //  (better conditioned back-substitution), substitute into (Q),
 3094:    //  and get a scalar quadratic in the other variable.
 3095:    // ================================================================
 3096: 
 3097:    // ---- Basis vectors ----
 3098:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3099:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3100:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3101:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3102:    // W: nonlinear correction. Difference between quad and parallelogram.
 3103:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3104:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3105: 
 3106:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3107:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3108:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3109:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3110:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3111: 
 3112:    // ---- nb: direction parallel to W, L1-normalized ----
 3113:    // We don't need a unit vector -- just a well-scaled direction parallel
 3114:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3115:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3116:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3117:    //
 3118:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3119:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3120:    // and the quadratic solver takes its linear path (a ~ 0).
 3121:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3122:    const double inv_wlen = 1.0 / wlen1;
 3123:    const Vector2 nb = vb * inv_wlen;
 3124: 
 3125:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3126:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3127:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3128:    // What remains is a pure affine relationship between xi and eta.
 3129:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3130:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3131:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3132: 
 3133:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3134:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3135:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3136:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3137:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3138:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3139:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3140: 
 3141:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3142:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3143:    // minimizing round-off amplification.
 3144:    //
 3145:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3146:    // that uses predicated moves.
 3147:    //
 3148:    // if (fabs(Ls) > fabs(Lt)) {
 3149:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3150:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3151:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3152:    //    const double A = -Qw * Lt;
 3153:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3154:    //    const double C =  Qs * Lp - Qp * Ls;
 3155: 
 3156:    //    double eta1, eta2;
 3157:    //    solveQuadratic(A, B, C, eta1, eta2);
 3158: 
 3159:    //    // Pick root with smaller |eta| (domain centered at 0).
 3160:    //    // Ternary-> predicated move, no branch divergence.
 3161:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3162: 
 3163:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3164:    //    xi = (Lp - Lt * eta) / Ls;
 3165: 
 3166:    // } else {
 3167:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3168:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3169:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3170:    //    const double A = -Qw * Ls;
 3171:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3172:    //    const double C =  Qt * Lp - Qp * Lt;
 3173: 
 3174:    //    double xi1, xi2;
 3175:    //    solveQuadratic(A, B, C, xi1, xi2);
 3176: 
 3177:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3178: 
 3179:    //    eta = (Lp - Ls * xi) / Lt;
 3180:    // }
 3181:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3182:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3183:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3184:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3185:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3186: 
 3187:    // Quadratic:  A*r^2 + B*r + C = 0
 3188:    // (same formula for both cases, just with swapped coefficients)
 3189:    const double A = -Qw * Lb;
 3190:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3191:    const double C =  Qa * Lp - Qp * La;
 3192: 
 3193:    double r1, r2;
 3194:    solveQuadratic(A, B, C, r1, r2);
 3195: 
 3196:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3197:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3198: 
 3199:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3200:    const double other = (Lp - Lb * r) / La;
 3201: 
 3202:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3203:    xi  = solve_s ? r     : other;
 3204:    eta = solve_s ? other : r;
 3205: 
 3206: 
 3207:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3208:    xi  = clamp(xi,  -1.0, 1.0);
 3209:    eta = clamp(eta, -1.0, 1.0);
 3210: 
 3211:    // ---- Shape functions ----
 3212:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3213:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3214:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3215:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3216:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3217:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3218:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3219:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3220: 
 3221:    return true;
 3222: }
 3223: 
 3224: /**
 3225:    Compute the shape coordinates of the point (xt,yt) in the element.
 3226:    @param xt (input): x-coordinate of the point
 3227:    @param shpCoords (output): shape coordinates of the point
 3228:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3229:    @return true if the point is inside the element, false otherwise
 3230: **/
 3231: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3232: 
 3233:    // Compute the shape coordinates of the point xt in the element.
 3234:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3235:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3236:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3237:    // from the local frame, so use additional check.
 3238: 
 3239: 
 3240:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3241: 
 3242:    if (isTri()) { // Triangular element
 3243: 
 3244:       // Horizontal local node coordinates. 
 3245:       Point2 x0, x1, x2;
 3246:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3247: 
 3248:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3249:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3250:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3251:       shpCoords[3] = 0.0;
 3252: 
 3253:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3254:       const bool res = (tmpmin >= -small);  
 3255:       
 3256:       // When to fix the negative shape coordinates?
 3257:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3258: 
 3259:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3260:       // then we fix the negative shape coordinates.
 3261:       if ((tmpmin < 0) && fix) {
 3262: 
 3263:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3264:          // keeping the sum of the shape coordinates equal to 1.
 3265:          // I have tested and compared the new algorithm with the old one, and they give
 3266:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3267:          // The new algorithm should be faster since it is branchless.
 3268:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3269:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3270: 
 3271:          shpCoords[0] = (shpCoords[0] + a)*b;
 3272:          shpCoords[1] = (shpCoords[1] + a)*b;
 3273:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3274: 
 3275:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3276:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3277:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3278: 
 3279:          // Update the point coordinates for the new shape coordinates
 3280:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3281:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3282: 
 3283:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3284: 
 3285:       }
 3286: 
 3287:       // Return true if the point is inside the element
 3288:       return res;      
 3289:    }
 3290:    else {
 3291:       assert(isQuad() && "computeShapeCoords");
 3292: 
 3293:       // Horizontal local node coordinates with respect to the original side.
 3294:       Point2 x0, x1, x2, x3;
 3295:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3296: 
 3297:       const double a0 = signedArea(x0, x1, xt);
 3298:       const double a1 = signedArea(x1, x2, xt);
 3299:       const double a2 = signedArea(x2, x3, xt);
 3300:       const double a3 = signedArea(x3, x0, xt);
 3301: 
 3302:       const double minArea = min4(a0, a1, a2, a3);
 3303:       
 3304:       const bool res = (minArea > -small*area);
 3305: 
 3306:       // When to fix the negative shape coordinates?
 3307:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3308: 
 3309:       double xi, eta;    
 3310: 
 3311:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3312:       // Does nothing if ics == 1.
 3313:       assert(origSide != nullptr);
 3314:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3315: 
 3316:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3317: 
 3318:       if (fix) {
 3319:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3320:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3321:          xt.x = interpolate(shpCoords, xn);
 3322:          xt.y = interpolate(shpCoords, yn);
 3323:       }
 3324: 
 3325:       return res;
 3326:    }
 3327: 
 3328: 
 3329:    assert(false && "computeShapeCoords: should never reach this point");
 3330:    return false;  // Never reached
 3331: 
 3332: }
 3333: 
 3334: 
 3335: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3336: // Convert shape coordinates to cartesian coordinates
 3337: 
 3338:    if (isTri()) {
 3339:       // Triangular element
 3340: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3341:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3342:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3343:    }
 3344:    else {
 3345:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3346:    }
 3347: 
 3348: }
 3349: 
 3350: 
 3351: 
 3352: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3353:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3354:    
 3355:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3356: }
 3357: 
 3358: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3359:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3360:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3361:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3362:    return area * dot(gradPhi[i], gradPhi[j]);
 3363: }
 3364: 
 3365: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3366:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3367:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3368:    // The formula for the integral is:
 3369:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3370:    
 3371:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3372:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3373:    const double eta_sum  = eta_n(i) + eta_n(j);
 3374:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3375: 
 3376:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3377:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3378: 
 3379: 
 3380:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3381: }
 3382:    
 3383: 
 3384: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3385:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3386:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3387:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3388:    // The formula is also based on the identity:
 3389:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3390:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3391: 
 3392:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3393: 
 3394: 
 3395: 
 3396:    double res = 0.0;
 3397:    
 3398:    // Quadrature points in xi and eta coordinates
 3399:    #pragma unroll
 3400:    for (int i = 0; i < 4; i++) {
 3401:       // For each quadrature point...
 3402: 
 3403:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3404:       const double eta = p.x;
 3405:       const double xi  = p.y;
 3406: 
 3407:       // Jacobian entries at the Gauss point p
 3408:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3409:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3410:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3411:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3412: 
 3413:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3414:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3415: 
 3416:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3417:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3418:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3419:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3420:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3421: 
 3422:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3423:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3424:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3425:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3426:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3427: 
 3428:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3429:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3430:    }
 3431: 
 3432:    return res;
 3433: }
 3434: 
 3435: 
 3436: /**  Interpolate velocities at a given point (xt,yt,zt)
 3437: 
 3438:    @param xt, yt, zt: coordinates of the point to interpolate
 3439:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3440: 
 3441:    This is done in four steps:
 3442: 
 3443:    1. Find the shape coordinates for the final position in the element.
 3444:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3445:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3446:       z levels at xt, yt at each step.   
 3447:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3448:       horizontally and vertically.
 3449: **/
 3450: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3451:    // Interpolate the velocities at the point xt. 
 3452:    // This function works the same for triangular and quadrilateral elements.
 3453:    double shpCoord[4];
 3454:    Vector3 u_int;
 3455: 
 3456: 
 3457:    // First step is to compute the shape coordinates of (xt,yt)
 3458: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3459:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3460: 
 3461:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3462: 
 3463:    // Second step is to find the level that contains zt
 3464:    // Uses a binary search to find the level
 3465:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3466:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3467:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3468:    int R = nvrt - 1;
 3469: 
 3470:    // Get the z coordinates at the nodes of the element at the levels L and R
 3471:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3472:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3473:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3474: 
 3475: 
 3476:    double zL = interpolate(shpCoord, zLAtNodes);
 3477:    double zR = interpolate(shpCoord, zRAtNodes);
 3478: 
 3479:    // Interpolates vertically the velocities
 3480:    double wght1, wght2;
 3481:    if (xt.z <= zL) {
 3482:       wght1 = 1.0;
 3483:       wght2 = 0.0;
 3484:       xt.z = zL;
 3485:    }
 3486:    else if (xt.z >= zR) {
 3487:       wght1 = 0.0;
 3488:       wght2 = 1.0;
 3489:       xt.z = zR;
 3490:    }
 3491:    else {
 3492:       // Perform a binary search to find the levels between L and R that contain xt.z
 3493:       while (R - L > 1) {
 3494:          int M = (L + R) / 2.0;
 3495: 
 3496:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3497:          double zM = interpolate(shpCoord, zMAtNodes);
 3498:          if (zM < xt.z) 
 3499:          {
 3500:             L = M;
 3501:             zL = zM;
 3502:          }
 3503:          else 
 3504:          {
 3505:             R = M;
 3506:             zR = zM;
 3507:          }
 3508:       }
 3509:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3510:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3511: 
 3512:       wght2 = (xt.z - zL)/(zR - zL);
 3513:       wght1 = 1.0 - wght2;
 3514: 
 3515:    }
 3516: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3517: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3518:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3519:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3520:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3521:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3522: 
 3523:    // Project the velocity from the local frame to the origSide frame
 3524:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3525:    u_int = {uv.x, uv.y, w};
 3526: 
 3527:    // Neither of the interpolated velocities should be NaN
 3528:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3529: 
 3530:    return u_int;
 3531: 
 3532: }
 3533: 
 3534: 
 3535: 
 3536: 
 3537: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3538: 
 3539:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3540:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3541:    const Node *n1 = side->n1;
 3542:    const Node *n2 = side->n2;
 3543: 
 3544:    bool n1_match = (n1->nodeBnd->segment == segment);
 3545:    bool n2_match = (n2->nodeBnd->segment == segment);
 3546: 
 3547:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3548:    if (n1_match && n2_match) {
 3549:       return 0.5;
 3550:    } else if (n1_match) {
 3551:       return 1.0;
 3552:    } else if (n2_match) {
 3553:       return 0.0;
 3554:    }
 3555: 
 3556:    return 0.0;
 3557: }
 3558: 
 3559: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3560: 
 3561: 
 3562: 
 3563: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3564:    // Returns the value of the velocity at the side center
 3565:    const double w1 = getBoundaryArrayValueWeight();
 3566:    const double w2 = 1.0 - w1;
 3567:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3568:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3569: 
 3570:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3571: }
 3572: 
 3573: 
 3574: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3575:    // Returns the value of the normal component of the velocity at the side center
 3576:    const double w1 = getBoundaryArrayValueWeight();
 3577:    const double w2 = 1.0 - w1;
 3578:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3579:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3580: 
 3581:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3582: }
