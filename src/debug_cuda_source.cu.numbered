 1975: 
 1976: 
 1977: /**
 1978:  * Find the element that contains the target point.
 1979:  * 
 1980:  * @param x0,y0,z0     Starting position coordinates
 1981:  * @param xt,yt,zt     Target position coordinates
 1982:  * @param dtb          Time step for tracking
 1983:  * @param u_int        Initial velocity components
 1984:  * @param nextElem     Starting/resulting element index
 1985:  * 
 1986:  * @return Status code of type trackExitCodes
 1987:  * 
 1988:  * Uses the Leaded Celestial Walk algorithm to find the element that contains the target point.
 1989:  * This is a variant of the Celestial Walk algorithm that goes from element A containing the starting 
 1990:  * point x0 (in one side) to element B containing the target point xt. To enforce that the next element is
 1991:  * as close the the segment AB as possible, the next point at each iteration is computed
 1992:  * along segment AB, but just after the current element.
 1993:  */
 1994: 
 1995: 
 1996: __device__ __forceinline__ bool celestialWalk(Element *&curElem, Point3 x0, Point3 &xt, const Side *origSide, Side *&lastCrossSide, int jlev) {
 1997: 
 1998:    constexpr int MAX_ITERATIONS = 40;
 1999: 
 2000:    int iter = 0;
 2001:    double fac = 0.00001;
 2002:    while (iter < MAX_ITERATIONS) {
 2003:       iter++;
 2004: 
 2005:       Bool4 isLeft, isObtuse, isBisector;
 2006:       curElem->computePredicates(toPoint2(x0), toPoint2(xt), fac, origSide, isLeft, isObtuse, isBisector, jlev);
 2007: // showPoints(x0, xt, jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2008:       Bool4 isValid = !isLeft & (!isObtuse | isBisector); // bitwise operation are overloaded
 2009: 
 2010: 
 2011:       if (isValid.none()) 
 2012:       // Inside the element if none of the edges is a valid continuation
 2013:       {
 2014:          // Just returns true and the element (curElem) is unchanged).
 2015:          // This means that the algorithm has found the element that contains the target point.
 2016:          return true;
 2017:       }
 2018:       else { // Outside the element
 2019: 
 2020:          // Outside this element. Pick the first valid exit side and cross.
 2021:          lastCrossSide = curElem->sides[isValid.firstOne()];
 2022:          Element *prevElem = curElem;
 2023:          curElem = lastCrossSide->otherElem(curElem);
 2024: 
 2025:          // If it crosses into a dry element or a boundary element, return false. This means that the track will now move 
 2026:          // along the boundary.
 2027:          if (curElem == nullptr || curElem->isDry) {
 2028:          
 2029:             curElem = prevElem;
 2030:             return false;
 2031:          }
 2032:          
 2033:       }
 2034: 
 2035:    }
 2036: 
 2037:   assert(false && "Leaded Celestial Walk: exceeded max iterations");
 2038: }
 2039: 
