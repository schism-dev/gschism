 2229:    
 2230:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2231:    // Project the vectors from the node frame to the element frame
 2232: 
 2233:  
 2234:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2235:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2236:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2237:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2238:       else          v[3] = Vector2();
 2239:    }
