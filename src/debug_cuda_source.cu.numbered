 5235: 
 5236: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 5237: {
 5238:    assert("Not implemented");
 5239: 
 5240:    return 0.0;
 5241: }
 5242: 
 5243: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 5244: // //     Routine to do vertical linear interpolation in z
