 7247: 
 7248: __global__ void computeMatrixProductAndDotProducts() {
 7249:    // Computes A*p, r'Mr and p'Ap
 7250: 
 7251:    // 1) shared buffer: first half for rMr, second for pAp
 7252:    __shared__ double sdata[2*BLOCK_SIZE];
 7253:    double* s_rMr = sdata;
 7254:    double* s_pAp = sdata + BLOCK_SIZE;
 7255: 
 7256:    s_rMr[threadIdx.x] = 0.0;
 7257:    s_pAp[threadIdx.x] = 0.0;
 7258: 
 7259:    // 2) get your node pointer
 7260:    NODE(node);  
 7261:    const int tid = threadIdx.x;
 7262: 
 7263:    const double diag = node->coeffDiag;
 7264:    const double r    = node->mR;
 7265:    const double p    = node->mP;  
 7266: 
 7267:    // apply preconditioner on the fly:
 7268:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7269: 
 7270:    // 4) compute Ap = A.p
 7271:    double Ap = node->coeffDiag * node->mP;
 7272:    for (int j = 0; j < node->numNodes; ++j) {
 7273:       const Node *nbNode = node->nodes[j];
 7274:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7275: 
 7276:    }
 7277:    node->mAp = Ap;
 7278:     
 7279: 
 7280:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7281:    const double l_rMr = r*Mr;  // r'Mr
 7282:    const double l_pAp = p*Ap;  // p'Ap
 7283: 
 7284:    // 6) write into shared mem
 7285:    s_rMr[tid] = l_rMr;
 7286:    s_pAp[tid] = l_pAp;
 7287: 
 7288:    __syncthreads();
 7289: 
 7290:    // 7) block-wide tree reduction
 7291:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7292:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 7293:       __syncthreads();
 7294:    }
 7295: 
 7296:    // 8) thread 0 atomically accumulates into the globals
 7297:    // XXX: This is slower than it needs to be, but it is simple and works
 7298:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 7299: 
 7300: 
 7301: }
 7302: 
 7303: 
 7304: __global__ void updateSolutionAndDotProducts(void) {
 7305:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7306: 
 7307:    s_rMr[threadIdx.x] = 0.0;
 7308: 
 7309: 
 7310:    // get node & bounds-check:
 7311:    NODE(node);
 7312:    const int tid = threadIdx.x;
 7313: 
 7314: 
 7315:    // Compute alpha
 7316:    const double alpha = (*rMr_old)/(*pAp);
 7317: 
 7318:    // load scalars
 7319:    const double diag = node->coeffDiag;
 7320:    const double p    = node->mP;
 7321:    const double Ap   = node->mAp;
 7322:    const double x    = node->mX;
 7323:    const double r    = node->mR;
 7324:    
 7325:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7326: 
 7327:    // 1) update solution & residual
 7328:    const double x_new = x + alpha*p;
 7329:    const double r_new = r - alpha*Ap;
 7330:    node->mX = x_new;
 7331:    node->mR = r_new;
 7332: 
 7333:    // 2) apply Jacobi preconditioner on the fly
 7334:    const double Mr_new = r_new/diag;
 7335: 
 7336: 
 7337:    // 3) local contributions for the two dot-products
 7338:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7339: 
 7340:    // 4) write into shared-mem
 7341:    s_rMr[tid] = l_rMr;
 7342: 
 7343:    __syncthreads();
 7344: 
 7345: 
 7346:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7347:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7348:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7349:       __syncthreads();
 7350:    }
 7351: 
 7352:    // 6) thread 0 atomically folds into the global accumulators
 7353:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7354: 
 7355: 
 7356: }
 7357: 
 7358: 
 7359: __global__ void updateSearchDirection() {
 7360:     NODE(node);
 7361: 
 7362:     // recompute z on-the-fly
 7363:     const double z = node->mR / node->coeffDiag;
 7364:     const double p = node->mP;
 7365: 
 7366:     const double beta = (*rMr_new)/(*rMr_old);
 7367: 
 7368: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 7369: 
 7370:     // p =z + beta*p
 7371:     node->mP = z + beta*p;
 7372: 
 7373: }
 7374: 
 7375: __global__ void initializePreconditionedResidual(double *scalars) {
 7376: 
 7377:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7378: 
 7379:     s_rMr[threadIdx.x] = 0.0;
 7380: 
 7381:     NODE(node);
 7382:     const int tid = threadIdx.x;
 7383:     // For the first iteration:
 7384:     // 1. Initial solution x = 0 (already set)
 7385:     // 2. Initial residual r = b (stored in qel)
 7386:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7387: 
 7388: // XXX we should use the guess solution here    
 7389: 
 7390:     // Set initial residual r = b (from qel)
 7391:     node->mR = node->qel;
 7392: 
 7393:     // Compute z = M^-1 * r (preconditioned residual)
 7394:     const double z = node->mR / node->coeffDiag;
 7395: 
 7396:     // Set initial search direction p = z
 7397:     node->mP = z;
 7398: 
 7399:     // Initialize other variables needed for CG
 7400:     node->mX = 0.0;  // Initial solution
 7401:     node->mAp = 0.0; // Will be computed in first iteration
 7402: 
 7403:     // These point to a cupy array in the host code
 7404:     rMr_old = scalars + 0;
 7405:     rMr_new = scalars + 1;
 7406:     pAp     = scalars + 2;
 7407: 
 7408:     // Computes the first r'Mr (reduction)
 7409:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7410: 
 7411:     // 4) write into shared-mem
 7412:     s_rMr[tid] = l_rMr;
 7413: 
 7414:     __syncthreads();
 7415: 
 7416: 
 7417:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7418:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7419:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7420:         __syncthreads();
 7421:     }
 7422: 
 7423:     // 6) thread 0 atomically folds into the global accumulators
 7424:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7425: 
 7426:     *rMr_old = 0.0;
 7427:     *pAp = 0.0;
 7428: }
