 6276: // !===============================================================================
 6277: 
 6278: } // extern "C"
 6279: 
 6280: #ifdef DONTCOMPILE
 6281: __device__ void computeVerticalAdvection(void) {
 6282:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6283: 
 6284:    sdbt(1:2,:,:)=0.d0
 6285: 
 6286:    const Side *side = FROM kernel;
 6287: 
 6288:    if(side->isDry) return;
 6289: 
 6290:    // If side is wet...
 6291: 
 6292: 
 6293:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6294:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6295:    double ws[nvrt] = {} // w @ side
 6296:    int icount = 0;
 6297:    for (int j=0; j<2; j++) {
 6298:       const Element *elem = side->elements[j];
 6299:        
 6300:       if(elem != nullptr) {
 6301:          icount++;
 6302:          for (int k=0; k<nvrt; k++) {
 6303:             ws[k] = ws[k] + elem->w[k];
 6304:          }
 6305:       }
 6306:    }  // for j
 6307: 
 6308:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6309:    ws = ws/icount;
 6310: 
 6311:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6312:    // Splines allow for a smooth transition between vertical levels.
 6313:    // Splines have continuity restrictions at the internal knots, but
 6314:    // we have to provide the 1st derivatives at the endpoints.
 6315:    const int kbs = side->kbs; 
 6316:    
 6317:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6318:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6319:    initCubicSpline(kbs, nvrt, side, ws, up)
 6320: 
 6321:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6322:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6323:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6324: 
 6325:    // Total advection (average onto side)
 6326:    const Node *node1 = side->nodes[0];
 6327:    const Node *node2 = side->nodes[1];
 6328:    for (int k=kbs(i); k<nvrt; k++) {
 6329: 
 6330:       if constexpr(ics==1) {
 6331:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6332:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6333:       } else {
 6334:          // XXX IMPLEMENT THIS
 6335:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6336:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6337:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6338:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6339:       }  // if ics
 6340: 
 6341: 
 6342:    }
 6343: }
 6344: #endif
 6345: 
 6346: 
 6347: extern "C" {
 6348:    __global__ void computeElemAverageGhat(void) {
 6349:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6350: 
 6351:       ELEM(elem);
 6352:       
 6353:       elem->ghat1= {0.0, 0.0};  
 6354: 
 6355:       if constexpr(ihydraulics != 0) {
 6356:          if (nhtblocks > 0 && elem->isblock) return;
 6357:       }
 6358: 
 6359: 
 6360: 
 6361:       
 6362:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6363:       // tidal potential, horizontal diffusion, and baroclinic etc
 6364:       // Remember to update both fb and F 
 6365:       // If ics=2, ghat1 are in eframe (ll)
 6366:       // cff1-3: coefficients for 2D/3D
 6367:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6368:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6369:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6370: 
 6371:       if (elem->isDry) return;
 6372: 
 6373:       double av_cff1 = 0.0;  // av. for cff1
 6374:       double av_cff2 = 0.0;  // av. for cff2
 6375:       double av_cff3 = 0.0;  // av. for cff3
 6376:       double av_df = 0.0;  // av. for H^\alpha / H
 6377:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6378:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6379: 
 6380:       const int i34 = elem->i34;
 6381:       const int kb = elem->kb;
 6382: 
 6383:       for (int j=0; j<i34; j++) {
 6384:          // For each node and side in the element...
 6385: 
 6386:          const Node *node = elem->nodes[j];
 6387:          const Side *side = elem->sides[j];
 6388: 
 6389:          const double chi      = side->chi;
 6390:          const double veg_c2   = side->veg_c2;
 6391:          const double veg_beta = side->veg_beta;
 6392:          const double veg_h    = side->veg_h();
 6393:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6394: 
 6395:          // Node - const in elem
 6396:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6397:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6398: 
 6399:          if (elem->depth >= tip_dp) {
 6400:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6401:          }
 6402: 
 6403:          
 6404:          const double htot  = side->htot2();        // Total depth at the side
 6405:          const double zctr2 = side->zTopCanopy();  
 6406: 
 6407:          double cff1; 
 6408:          double cff2; 
 6409:          double cff3;   
 6410:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6411:          // coefficients applied to 2D/3D case 
 6412:             cff1 = side->hhat/htot;
 6413:             cff2 = 0.0;
 6414:             cff3 = 0.0;
 6415:          } else { //3D
 6416:             //Init for no-veg case
 6417:             cff1 = 1.0;
 6418:             cff2 = 1.0;
 6419:             cff3 = 0.0;
 6420: 
 6421:             if constexpr(iveg != 0) {
 6422:                // Computes coefficients used with vegetation terms G1, G2
 6423:                // cff1, cff3 are used for the first two terms in G1, G2:
 6424:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6425:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6426:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6427:                if(veg_h < 0.99*htot) { // submergent vegetation
 6428:                   cff1=1;
 6429:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6430:                   cff3 = veg_c;
 6431: 
 6432:                } else { // emergent vegetation
 6433:                   cff1 = 1.0/(1.0 + veg_c2);
 6434:                   cff2 = cff1;
 6435:                   cff3 = 0.0;
 6436: 
 6437:                }
 6438:             } // if iveg
 6439:          } //  2D/3D
 6440: 
 6441:          av_cff1 += cff1/i34;
 6442:          av_cff2 += cff2/i34;
 6443:          av_cff3 += cff3/i34;
 6444:          av_cff2_chi += cff2*chi/i34;
 6445:          av_cff3_chi += cff3*chi/i34;
 6446:          av_df += min(htot, veg_h)/(htot*i34);
 6447: 
 6448: 
 6449:          // btrack values: U^\star, U^{\star\alpha}
 6450:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6451:          Vector2 Ustar       = {0.0, 0.0}; 
 6452:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6453: 
 6454:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6455:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6456:          } else { //3D
 6457:             for (int k = side->kb + 1; k < nvrt; k++) {
 6458:             
 6459:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6460:                Ustar += w2;
 6461: 
 6462:                if constexpr(iveg != 0) {
 6463:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6464:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6465:                        Ustar_alpha += zrat*w2; // XXXX
 6466:                    }
 6467:                }  // if iveg
 6468:             }  // for k
 6469:          }  //2D/3D
 6470:          
 6471: 
 6472:          // Add btrack & surface stress terms to \breve{G} first
 6473:          if constexpr(ics==1) {
 6474: 
 6475:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6476: 
 6477:          } else {
 6478:             assert(false && "computeElemAverageGhat: Not implemented");
 6479:             // XXX IMPLEMENT THIS
 6480:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6481:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6482:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6483:          }  // if ics
 6484: 
 6485:          // Surface and bottom stress terms
 6486:          if constexpr(ics==1) {
 6487:             const Vector2 tau    = side->tau();
 6488:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6489: 
 6490:             // Term for surface and bottom stress
 6491:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6492: 
 6493:          } else {
 6494:             assert(false && "computeElemAverageGhat: Not implemented");
 6495:             // XXX IMPLEMENT THIS
 6496:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6497:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6498:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6499:             // tau_x=(vn1+tt1)/2.d0
 6500:             // tau_y=(vn2+ss1)/2.d0
 6501:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6502:          }  // if ics
 6503: 
 6504:          
 6505: 
 6506:          // All terms in F,F^\alpha,f_b except baroclinic
 6507:          // F, f_b: all explicit terms excluding vegetation 
 6508:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6509:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6510:          const double coriolis = side->coriolis;
 6511:          Vector2 F  =  coriolis*side->U;  // F_x
 6512:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6513:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6514: 
 6515:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6516:             
 6517:             for (int k = side->kb; k < nvrt; k++) {
 6518:                if (zctr2 > side->zc[k-1]) {
 6519:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6520:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6521:                    Fa +=  coriolis*w2*zrat;
 6522:                } // if zctr2
 6523:             } // k
 6524:          } // iveg
 6525: 
 6526:          // Integrate horizontal viscosity force vertically
 6527:          for (int k=side->kb + 1; k<nvrt; k++) {
 6528:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6529: 
 6530:             F += levelHorVisc;
 6531: 
 6532:             // Vegetation term
 6533:             if constexpr(iveg!=0) {
 6534:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6535:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6536:                   Fa += levelHorVisc*zrat;
 6537:                } 
 6538:             } // if iveg
 6539:          } // for k
 6540: 
 6541:          fb += side->nuGradU[side->kb];
 6542: 
 6543:          // Add to ghat1
 6544:          if constexpr(ics==2) {
 6545:             assert(false && "computeElemAverageGhat: Not implemented");
 6546:             // XXX IMPLEMENT THIS
 6547:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6548:             // bigf1=vn1; bigf2=vn2
 6549:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6550:             // botf1=vn1; botf2=vn2
 6551:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6552:             // bigfa1=vn1; bigfa2=vn2
 6553:          } // if ics
 6554: 
 6555:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6556:       } // for j (nodes and sides)
 6557: 
 6558:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6559:          
 6560:       // Finish off terms in F, F^\alpha and f_b
 6561:       const double grav3 = elem->mean(&Node::grav2);
 6562:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6563: 
 6564: 
 6565:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6566:       for (int j=1; j<i34; j++) { 
 6567:          // For each side in the element...
 6568:          const Side *side = elem->sides[j];
 6569:          const double chi = side->chi;
 6570: 
 6571:          const double htot = side->htot2();
 6572:          const double veg_h = side->veg_h();
 6573:          const Vector2 F  = htot*fb;
 6574:          const Vector2 Fa = min(htot, veg_h)*fb;
 6575: 
 6576:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6577:       } // for j
 6578: 
 6579:       //botf1 etc are already in elem frame
 6580:       elem->ghat1 += tmp/i34;
 6581: 
 6582:       // Baroclinic force
 6583:       if constexpr(ibc==0) {
 6584:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6585: 
 6586:          Vector2 Fa = {0.0, 0.0};
 6587:          Vector2 intGradRho = {0.0, 0.0};
 6588:          
 6589:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6590:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6591:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6592: 
 6593:             // \in F [m^2/s/s]
 6594:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6595:          }
 6596: 
 6597:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6598:          const Vector2 F = av_df*Fa; //approx
 6599:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6600: 
 6601:       } // if ibc
 6602: 
 6603: 
 6604: 
 6605:    }
 6606: 
 6607: } // extern "C"
 6608: 
 6609: 
 6610: 
 6611: #ifdef DONTCOMPILE
 6612: __global__ void checkMassConservation(Tracers* sumtr) {
 6613: 
 6614:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6615: 
 6616:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6617: 
 6618:    Element *elem = &(mesh->localElemData[i]);
 6619: 
 6620:    // Skip dry elements
 6621:    if (elem->isDry) return;
 6622: 
 6623:    // Local sum array for this thread
 6624:    double localSum[N_TRACERS] = {0.0};
 6625: 
 6626:    // Sum over vertical levels for this element
 6627:    const int kbe = elem->kbe;
 6628:    const double area = elem->area;
 6629: 
 6630:    for (int k = kbe; k < nvrt; k++) {
 6631:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6632:       
 6633:       // Accumulate tracer mass
 6634:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6635:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6636:       }
 6637:    }
 6638: 
 6639:    //  This function returns per element sums. A reduction must be done on the host side.
 6640: }
 6641: 
 6642: 
 6643: __global__ void transport(void) {
 6644: 
 6645:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6646: 
 6647:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6648: 
 6649:    Element *elem = &(mesh->localElemData[ie]);
 6650: 
 6651:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6652: 
 6653:                for (int m=0; m<ntr; m++) {
 6654:                   for (int k=kbe(ie); k<nvrt; k++) {
 6655:                      // Calculate each polynomial's weight 
 6656:                      wm=0.d0; sum1=0.d0; 
 6657:                      wm1=0.d0; wm2=0.d0; 
 6658:                      for (int i=0; i<elem->nweno2; i++) {
 6659:                   
 6660:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6661:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6662:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6663:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6664:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6665:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6666:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6667:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6668:                      // -----------------Hu and Shu (1999)'s method----------------
 6669:                      b4=b1+b2+b3
 6670: 
 6671: //Error: add PRODUCTION CPP
 6672: #ifdef DEBUG
 6673:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6674:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6675:                     call parallel_abort(errmsg)
 6676:                   }
 6677: #endif
 6678: 
 6679:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6680:                   // !----test-------------- 
 6681:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6682:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6683:                   // !wm(i)=wm1(i)*wm2(i)
 6684:                   // !---------------------- 
 6685:                   sum1=sum1+wm(i)
 6686:                 } // end for i
 6687: 
 6688:                 wm=wm/sum1
 6689: 
 6690:                 for (int j=0; j<elem->i34; j++) {
 6691: 
 6692:                   const Side *side  = elem->sides[j];
 6693:                   const Node *node1 = side->n1;
 6694:                   const Node *node2 = side->n2;
 6695: 
 6696:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6697:                      trsd=0.d0
 6698:                      for (int kk=0; kk<nquad; kk++) {
 6699:                         for (int i=0; i<elem->nweno2; i++) {
 6700:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6701:                         } // end for i   
 6702:                      } // end for kk
 6703:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6704:                   } // outward flux
 6705:                } // end for j=1,i34(ie) ! side
 6706:             }
 6707:          }
 6708:               
 6709: 
 6710: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6711: //             //   calculate each polynomial's weight 
 6712: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6713: //                 wm=0.d0; sum1=0.d0
 6714: //                 do i=1,nweno1(ie) !for each polynomial
 6715: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6716: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6717: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6718: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6719: //                   wm(i)=b2
 6720: //                   sum1=sum1+b2
 6721: //                   !wm(i)=1.d0
 6722: //                   !sum1=sum1+1.d0
 6723: 
 6724: // // Error: PRODUCTION
 6725: // #ifdef DEBUG
 6726: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6727: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6728: //                     call parallel_abort(errmsg)
 6729: //                   endif
 6730: // #endif
 6731: 
 6732: //                 enddo !i
 6733: //                 wm=wm/sum1 !final weight
 6734: 
 6735:                 for (int j=0; j<elem->i34; j++) { // side
 6736:                   const Side *side = elem->sides[j];
 6737:                   const Node *node1 = side->n1;
 6738:                   const Node *node2 = side->n2;
 6739: 
 6740:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6741:                     trsd=0.d0
 6742:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6743:                       for (int i=0; i<elem->nweno1; i++) {
 6744:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6745:                       }
 6746:                     enddo //kk
 6747:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6748:                   } // outward flux
 6749:                 } // end for j=1,i34(ie) ! side
 6750:               } // end for k; ntr 
 6751: 
 6752:             else !simple upwind method
 6753:               do j=1,i34(ie)
 6754:                 jsj=elside(j,ie)
 6755:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6756:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6757:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6758:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6759:                   endif
 6760:                 enddo  !vertical layers
 6761:               enddo !j=1,i34(ie) ! side
 6762:             endif !order of accuracy
 6763: 
 6764:          //  enddo !ie
 6765: // !$OMP     end do
 6766: 
 6767: // !$OMP     master
 6768: //           !message passing
 6769: //           if (nproc>1) then
 6770: //             !make a copy of side concentrations
 6771: //             trsd_tmp0=trsd_tmp 
 6772: 
 6773: //             !this exchange routine swaps interface concentration between two partitions
 6774: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
