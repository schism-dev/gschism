 2183:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 2184:       // Compute the different time ramps used in the code 
 2185:       // This function is performed by just one thread
 2186: 
 2187:       rampbc = 1.0;
 2188:       if constexpr(ibc == 0) {
 2189:          if (drampbc > 0.0) {
 2190:             rampbc = tanh(2.0*time/86400.0/drampbc);
 2191:          } else {
 2192:             rampbc = 1.0;
 2193:          }
 2194:       }
 2195: 
 2196:       if (nws != 0) {
 2197:          if (drampwind > 0.0) {
 2198:             rampwind = tanh(2.0*time/86400.0/drampwind);
 2199:          } else {
 2200:             rampwind = 1.0;
 2201:          }
 2202:       }
 2203: 
 2204:       if (drampwafo > 0.0) {
 2205:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 2206:       } else {
 2207:          rampwafo = 1.0;
 2208:       }
 2209: 
 2210:       // For source/sinks
 2211:       if (if_source && dramp_ss > 0.0) {
 2212:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 2213:       } else {
 2214:          ramp_ss = 1.0;
 2215:       }
 2216: 
 2217:       if (dramp > 0.0) {
 2218:          ramp = tanh(2.0*time/86400.0/dramp);
 2219:       } else {
 2220:          ramp = 1.0;
 2221:       }
 2222: 
 2223: 
 2224:    }
