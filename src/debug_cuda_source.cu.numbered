  542: 
  543: template<int IVCOR>
  544: struct LocalSigma {};   
  545: 
  546: template<>
  547: struct LocalSigma<2> {
  548:    __device__ double operator[](int k) const { return 0.0; }
  549:    __device__ double& operator[](int k) { assert(false && "LocalSigma<2>: operator[] not implemented"); return (double &)*((double *)nullptr); }
  550: };
  551: 
  552: template<>
  553: struct LocalSigma<1> {
  554:    double localSigma[nvrt];
  555:    __device__ double operator[](int k) const { return localSigma[k]; }
