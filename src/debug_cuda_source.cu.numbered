 4075:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4076: 
 4077:       SIDE(side);
 4078: 
 4079: 
 4080:       side->U = {0.0, 0.0}; 
 4081:          
 4082:       if(side->isDry) return;
 4083: 
 4084:       const Node *node1 = side->n1;
 4085:       const Node *node2 = side->n2;
 4086: 
 4087:       // Vertically integrated velocity U (in ll if ics=2)
 4088:       for (int k = side->kb; k < nvrt - 1; k++) { /// XXX CHECK INDICES
 4089:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  // CHECK INDICES!!!!
 4090:       }
 4091: 
 4092:    }
