 9136: __global__ void getStructSizes(int* sizes)  {
 9137:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9138:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9139:       sizes[0] = (int)sizeof(Node);
 9140:       sizes[1] = (int)sizeof(Element);
 9141:       sizes[2] = (int)sizeof(Side);
