 1867: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int label = -1) {
 1868: // return;   
 1869:    // Lock the mutex
 1870:    lock(&debugPlotMutex);
 1871:  
 1872:    bool ok = true;
 1873:    if (debugPlotIdx == nullptr) ok = false;
 1874:    if (*debugPlotIdx >= 10000) ok = false;
 1875:    if (ok) {
 1876:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1877:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1878:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1879:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1880:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1881:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1882:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 1883:       (*debugPlotIdx)++;
 1884:    }
 1885: 
 1886:    __threadfence();               // ensure all above writes are visible
 1887:    // Unlock the mutex
 1888:    unlock(&debugPlotMutex);
 1889: 
 1890: }
 1891: 
 1892: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int label = -1) {
 1893:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, label);
 1894: }
