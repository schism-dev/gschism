 2146: 
 2147: /**  Interpolate velocities at a given point (xt,yt,zt)
 2148: 
 2149:    @param xt, yt, zt: coordinates of the point to interpolate
 2150:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2151: 
 2152:    This is done in four steps:
 2153: 
 2154:    1. Find the shape coordinates for the final position in the element.
 2155:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2156:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2157:       z levels at xt, yt at each step.   
 2158:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2159:       horizontally and vertically.
 2160: **/
 2161: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2162:    // Interpolate the velocities at the point xt. 
 2163:    // This function works the same for triangular and quadrilateral elements.
 2164:    double shpCoord[4];
 2165: 
 2166: // printf(" ___BBB02____ idx = %d, u_int = %.17g,%.17g,%.17g, u1 = %.17g,%.17g,%.17g, u2 = %.17g,%.17g,%.17g, u3 = %.17g,%.17g,%.17g\n", idx, u_int.x, u_int.y, u_int.z, nodes[0]->u2[0].x, nodes[0]->u2[0].y, nodes[0]->u2[0].z, nodes[1]->u2[0].x, nodes[1]->u2[0].y, nodes[1]->u2[0].z, nodes[2]->u2[0].x, nodes[2]->u2[0].y, nodes[2]->u2[0].z);         
 2167:    // First step is to compute the shape coordinates of (xt,yt)
 2168:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2169:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2170: 
 2171:    // Second step is to find the level that contains zt
 2172:    // Uses a binary search to find the level
 2173:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2174:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2175:    int R = nvrt - 1;
 2176: 
 2177:    // Get the z coordinates at the nodes of the element at the levels L and R
 2178:    double zLAtNodes[4], zRAtNodes[4];
 2179:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2180:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2181: 
 2182:    double zL = interpolate(shpCoord, zLAtNodes);
 2183:    double zR = interpolate(shpCoord, zRAtNodes);
 2184:    
 2185:    // Interpolates vertically the velocities
 2186:    double wght1, wght2;
 2187:    if (xt.z<=zL) {
 2188:       wght1 = 1.0;
 2189:       wght2 = 0.0;
 2190:    }
 2191:    else if (xt.z>=zR) {
 2192:       wght1 = 0.0;
 2193:       wght2 = 1.0;
 2194:    }
 2195:    else {
 2196:       // Perform a binary search to find the levels between L and R that contain xt.z
 2197:       while (R - L > 1) {
 2198:          int M = (L + R) / 2;
 2199: 
 2200:          double zMAtNodes[4];
 2201:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2202:          double zM = interpolate(shpCoord, zMAtNodes);
 2203:          if (zM < xt.z) 
 2204:          {
 2205:             L = M;
 2206:             zL = zM;
 2207:          }
 2208:          else 
 2209:          {
 2210:             R = M;
 2211:             zR = zM;
 2212:          }
 2213:       }
 2214:       assert(L == R-1);
 2215:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2216: 
 2217:       wght2 = (xt.z - zL)/(zR - zL);
 2218:       wght1 = 1.0 - wght2;
 2219:    }
 2220: 
 2221:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2222:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2223: 
 2224:    // Neither of the interpolated velocities should be NaN
 2225:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2226: 
 2227: }
 2228: 
