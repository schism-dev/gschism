 1618:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1619:                    double *cs, double *dcs
 1620:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1621:                        np(np), ne(ne), ns(ns),
 1622:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1623:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1624:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1625:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1626:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1627:                        localSegmentMem(localSegmentMem),
 1628:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1629:                        cs(cs), dcs(dcs),
 1630:                        coeffMatrixMem(partCoeffMatrixMem),
 1631:                        landBoundarySegment(true),
 1632:                        landBoundaryNode(true)
 1633:    {
