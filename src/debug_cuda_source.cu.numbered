 1596: __device__ void lock(int *mutex) {
 1597:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1598: }
 1599: 
 1600: __device__ void unlock(int *mutex) {
 1601:     atomicExch(mutex, 0);
