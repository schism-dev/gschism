 1126: // This struct is used to store the boundary information for a node.
 1127: struct NodeBoundary {   
 1128:    int idx;
 1129:    BoundarySegment *segment;
 1130:    Node *node;
 1131:    
 1132:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1133:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1134: 
 1135:    bool isLand;
 1136: 
 1137:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1138:    double elbc;   // Elevation boundary condition
 1139:    double eth;    // Elevation time history
 1140: 
 1141:    double eta_mean; // Mean elevation at nodes
 1142: 
 1143:    bool isEssentialBC;
 1144: 
 1145:    Vector2 uth[nvrt];  // "Time history" velocity
 1146: 
 1147:    // Arrays for harmonic constituents (if needed)
 1148:    double  emo[nbfr];  // Elevation amplitude
 1149:    double  efa[nbfr];  // Elevation phase
 1150:    Vector2 umo[nbfr];  // velocity amplitude
 1151:    Vector2 ufa[nbfr];  // velocity phase
 1152: 
 1153: 
 1154:    NodeBoundary(void) {
 1155:       isLand = false;
 1156:    }
 1157:    NodeBoundary(bool _isLand) {
 1158:       isLand = _isLand;
 1159:    }
 1160: 
 1161:    
 1162:    __forceinline__ __device__ int numSidesForAverage() const {
 1163:    // Returns the number of sides that are connected to the node and have the same segment.
 1164:    // This is used to compute the average velocity at the node for open boundary nodes.
 1165:       int res = 0;
 1166:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1167:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1168: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1169:       return res;
 1170:    }
 1171: 
 1172: 
 1173:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1174:       assert(index == 0 || index == 1); 
 1175:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1176:    }
 1177: 
 1178: 
 1179: };
 1180: 
 1181: struct Node {
 1182: 
 1183:    // Geometry information
 1184:    int idx;        // Index of the node
 1185:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1186:    int numNodes;   // Number of nodes neighbors of this node
 1187: 
 1188:    Element **elements; // Array of pointers to the elements that share this node
 1189:    int numElements;    // Number of elements that share this node
 1190: 
 1191:    int numSides;       // Number of sides that are connected to this node
 1192: 
 1193:    Point2 p;
 1194:    Vector2 u2[nvrt];
 1195:    double  w2[nvrt];
 1196:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1197:    double z[nvrt];
 1198:    double lon, lat;
 1199:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1200:    double depth;
 1201: 
 1202:    int kb;       // Bottom index of the node
 1203: 
 1204:    bool isDry;     // True if the node is dry
 1205: 
 1206:    int iadv;     // Advection flag
 1207: 
 1208:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1209:                           // this is nullptr
 1210: 
 1211:    TempVar tmp; // Temporary variable to store different types of variables
 1212: 
 1213:    // Physical information
 1214:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1215:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1216: 
 1217:    double rho[nvrt];     // Density
 1218:    double dfv[nvrt];     // Vertical viscosity
 1219: 
 1220:    double eta1; // Elevation at nodes at previous timestep
 1221:    double eta2; // Elevation at nodes at current timestep
 1222: 
 1223:    double ETP;  // Earth Tidal Potential
 1224: 
 1225:    double pr;    // Air pressure
 1226:    double grav2; // Gravity 
 1227:    
 1228:    Vector2 dav;  // Depth averaged velocity
 1229: 
 1230:    Vector2 tau; // Wind stress vector
 1231: 
 1232:    // Vegetation parameters
 1233:    double veg_h;
 1234:    double veg_nv;
 1235:    double veg_di;
 1236:    double veg_Cd;
 1237:    double veg_h_unbent;
 1238:    double veg_di_unbent;
 1239:    double veg_nv_unbent;
 1240:    double veg_alpha_vert_mean;
 1241:    double veg_alpha0;
 1242:    double veg_alpha3D[nvrt];
 1243: 
 1244:    // Bottom drag parameters
 1245:    double Cd;       // Bottom drag coefficient
 1246:    double rough;    // Bottom roughness length
 1247:    Vector2 tau_bot; // Bottom stress vector
 1248: 
 1249:    double bdef1; // Bottom deformation at previous timestep
 1250:    double bdef2; // Bottom deformation at current timestep
 1251: 
 1252:    double qel; // RHS
 1253:    double coeffDiag; // Diagonal coefficient of the matrix
 1254:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1255: 
 1256:    double mP; // Search direction for conjugate gradient method
 1257:    double mR; // Residual for conjugate gradient method
 1258:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1259:    double mX; // Solution for conjugate gradient method
 1260: 
 1261:    // Meteorological forcing
 1262:    Vector2 u_air;
 1263:    double p_air;
 1264:    double t_air;
 1265:    double q_air;
 1266:    double wind_angle;  // Wind rotation angle
 1267: 
 1268:    __device__ void setWind(Vector2 &u) {
 1269:    // Sets the wind vector taking into account the wind rotation angle
 1270:    
 1271:       const double dir = atan2(-u.x,-u.y);
 1272:       const double speed = length(u);
 1273: 
 1274:       // Calculate new u and v components with added rotation angle
 1275:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1276:    }
 1277: 
 1278: 
 1279:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1280: 
 1281:    __device__ double sigmaTransitionDepth(void) const;
 1282: 
 1283:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1284:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1285:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1286:    
 1287:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1288: 
 1289:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1290: 
 1291:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1292:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1293: 
 1294:    __device__ void clearMatrixRow(void) {
 1295:       // Clear the matrix row for this node
 1296:       coeffDiag = 0.0;
 1297:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1298: 
 1299:    }
 1300: 
 1301:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1302:       // Add the value to the sparse matrix for this node
 1303:       
 1304:       if (node == this) {
 1305:          coeffDiag += value;
 1306:      
 1307:       } else {
 1308:          // Search (linearly)the index of the node in the array of nodes
 1309:          // XXX: This is not efficient, see if we can improve this
 1310:          int i;
 1311:          for (i = 0; i < numNodes; i++) {
 1312:             if (nodes[i] == node) {
 1313:                break;
 1314:             }
 1315:          }
 1316:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1317:          coeffMatrix[i] += value;
 1318:       }
 1319:    }
 1320: 
 1321: 
 1322:    __device__ __inline__ void updateZCoordData(void);
 1323: 
 1324:    __device__ double compZCoord(int k) const;
 1325: 
 1326:    __device__ void updateKb(void);
 1327: 
 1328: 
 1329: 
 1330: };
