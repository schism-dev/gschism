 7135: 
 7136: __global__ void computeMatrixProductAndDotProducts() {
 7137:    // Computes A*p, r'Mr and p'Ap
 7138: 
 7139:    // 1) shared buffer: first half for rMr, second for pAp
 7140:    __shared__ double sdata[2*BLOCK_SIZE];
 7141:    double* s_rMr = sdata;
 7142:    double* s_pAp = sdata + BLOCK_SIZE;
 7143: 
 7144:    const int tid = threadIdx.x;
 7145: 
 7146:    double l_pAp = 0.0;
 7147: 
 7148:    s_rMr[tid] = 0.0;
 7149:    s_pAp[tid] = 0.0;
 7150: 
 7151:    // 2) get your node pointer
 7152:    // NODE(node);   
 7153:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7154:    Node *node = &(mesh->localNodeData[idx_node]); 
 7155:       if (idx_node < mesh->np) {
 7156: 
 7157:       const double diag = node->coeffDiag;
 7158:       const double r    = node->mR;
 7159:       const double p    = node->mP;  
 7160: 
 7161:       // apply preconditioner on the fly:
 7162:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7163: 
 7164:       // 4) compute Ap = A.p
 7165:       double Ap = node->coeffDiag * node->mP;
 7166:       for (int j = 0; j < node->numNodes; ++j) {
 7167:          const Node *nbNode = node->nodes[j];
 7168:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7169: 
 7170:       }
 7171: 
 7172:       node->mAp = Ap;
 7173:       
 7174: 
 7175:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7176:       // const double l_rMr = r*Mr;  // r'Mr
 7177:       l_pAp = p*Ap;  // p'Ap
 7178: 
 7179: 
 7180:    }
 7181: 
 7182:    // 6) write into shared mem
 7183:    // s_rMr[tid] = l_rMr;
 7184:    s_pAp[tid] = l_pAp;
 7185: 
 7186:    __syncthreads();
 7187: 
 7188:    // 7) block-wide tree reduction
 7189:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7190:       if (tid < stride)  {
 7191:          s_pAp[tid] += s_pAp[tid + stride];
 7192:       }
 7193:       __syncthreads();
 7194:    }
 7195: 
 7196:    // 8) thread 0 atomically accumulates into the globals
 7197:    // XXX: This is slower than it needs to be, but it is simple and works
 7198:    if (tid == 0) {
 7199:       atomicAdd(pAp, s_pAp[0]);
 7200:    }
 7201: 
 7202: 
 7203: }
 7204: 
 7205: 
 7206: __global__ void updateSolutionAndDotProducts(void) {
 7207:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7208: 
 7209:    const int tid = threadIdx.x;
 7210: 
 7211:    s_rMr[tid] = 0.0;
 7212: 
 7213:    // get node & bounds-check:
 7214:    NODE(node);
 7215: 
 7216:    
 7217:    // Compute alpha
 7218:    const double alpha = (*rMr_old)/(*pAp); 
 7219: 
 7220: 
 7221:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7222: 
 7223: 
 7224:    // load scalars
 7225:    const double diag = node->coeffDiag;
 7226:    const double p    = node->mP;
 7227:    const double Ap   = node->mAp;
 7228:    const double x    = node->mX;
 7229:    const double r    = node->mR;
 7230:    
 7231:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7232: 
 7233:    // 1) update solution & residual
 7234:    const double x_new = x + alpha*p;
 7235:    const double r_new = r - alpha*Ap;
 7236:    node->mX = x_new;
 7237:    node->mR = r_new;
 7238: 
 7239:    // 2) apply Jacobi preconditioner on the fly
 7240:    const double Mr_new = r_new/diag;
 7241: 
 7242: 
 7243:    // 3) local contributions for the two dot-products
 7244:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7245: 
 7246:    // 4) write into shared-mem
 7247:    s_rMr[tid] = l_rMr;
 7248: 
 7249:    __syncthreads();
 7250: 
 7251: 
 7252:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7253:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7254:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7255:       __syncthreads();
 7256:    }
 7257: 
 7258:    // 6) thread 0 atomically folds into the global accumulators
 7259:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7260: 
 7261: 
 7262: }
 7263: 
 7264: 
 7265: __global__ void updateSearchDirection() {
 7266: 
 7267:     NODE(node);
 7268: 
 7269:     // recompute z on-the-fly
 7270:     const double z = node->mR / node->coeffDiag;
 7271:     const double p = node->mP;
 7272: 
 7273:     const double beta = (*rMr_new)/(*rMr_old);
 7274: 
 7275: 
 7276:     // p =z + beta*p
 7277:     node->mP = z + beta*p;
 7278: 
 7279: }
 7280: 
 7281: __global__ void initializeScalars(double *scalars) {
 7282: 
 7283:    // These point to a cupy array in the host code
 7284:    rMr_old = scalars + 0;
 7285:    rMr_new = scalars + 1;
 7286:    pAp     = scalars + 2;
 7287: }
 7288: 
 7289: __global__ void initializePreconditionedResidual(void) {
 7290: 
 7291:     __shared__ double s_rMr[BLOCK_SIZE];  
 7292: 
 7293:     s_rMr[threadIdx.x] = 0.0;
 7294: 
 7295:     NODE_ALL(node, valid);
 7296:     const int tid = threadIdx.x;
 7297:     // For the first iteration:
 7298:     // 1. Initial solution x = 0 (already set)
 7299:     // 2. Initial residual r = b (stored in qel)
 7300:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7301: 
 7302: // XXX we should use the guess solution here    
 7303: 
 7304:     double l_rMr = 0.0;
 7305:     if (valid) {
 7306:       // Set initial residual r = b (from qel)
 7307:       node->mR = node->qel;
 7308: 
 7309:       // Compute z = M^-1 * r (preconditioned residual)
 7310:       const double z = node->mR / node->coeffDiag;
 7311: 
 7312:       // Set initial search direction p = z
 7313:       node->mP = z;
 7314: 
 7315:       // Initialize other variables needed for CG
 7316:       node->mX = 0.0;  // Initial solution
 7317:       node->mAp = 0.0; // Will be computed in first iteration
 7318: 
 7319: 
 7320:       // Computes the first r'Mr (reduction)
 7321:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7322:     }
 7323:     // 4) write into shared-mem
 7324:     s_rMr[tid] = l_rMr;
 7325: 
 7326:     __syncthreads();
 7327: 
 7328: 
 7329:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7330:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7331:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7332:         __syncthreads();
 7333:     }
 7334: 
 7335:     // 6) thread 0 atomically folds into the global accumulators
 7336:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7337: 
 7338:     *rMr_old = 0.0;
 7339:     *pAp = 0.0;
 7340: }
 7341: 
 7342: 
 7343: 
 7344: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7345:    Element *elems = mesh->localElemData;
 7346: 
 7347:    *addr = elems;
 7348:    *sizeElement = sizeof(Element);
 7349:    switch (varCode) {
 7350:       case (int)VarCode::z:
 7351:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7352:          *sizeType = sizeof(double);
 7353:          break;
 7354:       case (int)VarCode::x:
 7355:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7356:          *sizeType = sizeof(Vector2);
 7357:          break;
 7358:       case (int)VarCode::area:
 7359:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7360:          *sizeType = sizeof(double);
 7361:          break;
 7362:       case (int)VarCode::depth:
 7363:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7364:          *sizeType = sizeof(double);
 7365:          break;
 7366:       case (int)VarCode::radius:
 7367:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7368:          *sizeType = sizeof(double);
 7369:          break;
 7370:       case (int)VarCode::lonlat:
 7371:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7372:          *sizeType = sizeof(double);
 7373:          break;
 7374:       case (int)VarCode::ghat:
 7375:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7376:          *sizeType = sizeof(Vector2);
 7377:          break;
 7378:       case (int)VarCode::kb:
 7379:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7380:          *sizeType = sizeof(int);
 7381:          break;
 7382:       case (int)VarCode::isdry:
 7383:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7384:          *sizeType = sizeof(int);
 7385:          break;            
 7386:       case (int)VarCode::w:
 7387:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7388:          *sizeType = sizeof(double);
 7389:          break;
 7390:       case (int)VarCode::FaceIndices:
 7391:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7392:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7393:          *sizeType = sizeof(Node);
 7394:          break;
 7395:       default:
 7396:          *offset = -1;
 7397:    }
 7398: }
 7399: 
 7400: 
 7401: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
 7402:    Side *sides = mesh->localSideData;
 7403: 
 7404:    *addr = sides;
 7405:    *sizeSide = sizeof(Side);
 7406:    switch (varCode) {
 7407:       case (int)VarCode::z:
 7408:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
 7409:          *sizeType = sizeof(double);
 7410:          break;
 7411:       // case (int)VarCode::depth:
 7412:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7413:       //    *sizeType = sizeof(double);
 7414:       //    break;         
 7415:       case (int)VarCode::x:
 7416:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7417:          *sizeType = sizeof(Vector2);
 7418:          break;
 7419:       case (int)VarCode::len:
 7420:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7421:          *sizeType = sizeof(double);
 7422:          break;
 7423:       case (int)VarCode::kb:
 7424:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7425:          *sizeType = sizeof(int);
 7426:          break;
 7427:       case (int)VarCode::isdry:
 7428:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7429:          *sizeType = sizeof(int);
 7430:          break;            
 7431:       case (int)VarCode::w:
 7432:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7433:          *sizeType = sizeof(double);
 7434:          break;
 7435:       case (int)VarCode::u:
 7436:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7437:          *sizeType = sizeof(Vector2);
 7438:          break;   
 7439:       case (int)VarCode::btu:
 7440:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7441:          *sizeType = sizeof(Vector2);
 7442:          break;          
 7443:       case (int)VarCode::U:
 7444:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7445:          *sizeType = sizeof(Vector2);
 7446:          break;
 7447:       // case (int)VarCode::ghat:
 7448:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7449:       //    *sizeType = sizeof(Vector2);
 7450:       //    break;   
 7451:       case (int)VarCode::hhat:
 7452:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7453:          *sizeType = sizeof(Vector2);
 7454:          break;      
 7455:       case (int)VarCode::chi:
 7456:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7457:          *sizeType = sizeof(double);
 7458:          break;
 7459:       case (int)VarCode::n1:
 7460:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7461:          *sizeType = sizeof(Node);
 7462:          break;
 7463:       case (int)VarCode::n2:
 7464:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7465:          *sizeType = sizeof(Node);
 7466:          break;                   
 7467:       default:
 7468:          *offset = -1;
 7469:    }
 7470: }
 7471: 
 7472: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7473:    Node *nodes = mesh->localNodeData;
 7474: 
 7475:    *addr = nodes;
 7476:    *sizeNode = sizeof(Node);
 7477: 
 7478:    switch (varCode) {
 7479:       case (int)VarCode::depth:
 7480:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7481:          *sizeType = sizeof(double);
 7482:          break;
 7483:       case (int)VarCode::eta:
 7484:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7485:          *sizeType = sizeof(double);
 7486:          break;
 7487:       case (int)VarCode::x:
 7488:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7489:          *sizeType = sizeof(Vector2);
 7490:          break;
 7491:       case (int)VarCode::z:
 7492:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7493:          *sizeType = sizeof(double);
 7494:          break;
 7495:       case (int)VarCode::kb:
 7496:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7497:          *sizeType = sizeof(int);
 7498:          break;
 7499:       case (int)VarCode::isdry:
 7500:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7501:          *sizeType = sizeof(int);
 7502:          break;         
 7503:       case (int)VarCode::w:
 7504:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7505:          *sizeType = sizeof(double);
 7506:          break;
 7507:       case (int)VarCode::u:
 7508:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7509:          *sizeType = sizeof(Vector2);
 7510:          break;         
 7511:       default:
 7512:          *offset = -1;    
 7513:    }  
 7514:    
 7515: }
 7516: 
 7517: extern "C" __global__ void getElementVar(int varCode, bool is3D, double *var1, double *var2, int *ivar1, int *ivar2, int k = -1, int j = -1) {
 7518:    // Get the value of a variable from an element
 7519:    // varName is the name of the variable to get
 7520:    // var is the array to store the value
 7521:    // k is the vertical level index of the variable to get
 7522: 
 7523:    ELEM(elem);
 7524:    
 7525:    int idx = elem->idx;
 7526:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7527: 
 7528:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7529:    if      (varCode == (int)VarCode::w)       { var1[idx] = elem->w[k];}
 7530:    else if (varCode == (int)VarCode::z)       { var1[idx] = elem->z[k];}
 7531:    else if (varCode == (int)VarCode::x)       { var1[idx] = elem->center.x; var2[idx] = elem->center.x;}
 7532:    else if (varCode == (int)VarCode::area)    { var1[idx] = elem->area;}
 7533:    else if (varCode == (int)VarCode::depth)   { var1[idx] = elem->depth;}
 7534:    else if (varCode == (int)VarCode::radius)  { var1[idx] = elem->radius;}
 7535:    else if (varCode == (int)VarCode::lonlat)  { var1[idx] = elem->xlon;     var2[idx] = elem->ylat;}
 7536:    else if (varCode == (int)VarCode::ghat)    { var1[idx] = elem->ghat1.x;  var2[idx] = elem->ghat1.y;}
 7537:    else if (varCode == (int)VarCode::kb)      { ivar1[idx] = elem->kb;}
 7538:    else if (varCode == (int)VarCode::ssign && j > -1)  {ivar1[idx] = elem->ssign[j];}
 7539:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7540:       
 7541:    
 7542: }
 7543: 
 7544: 
 7545: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7546:    // Get the value of a variable from an node
 7547:    // varName is the name of the variable to get
 7548:    // var is the array to store the value
 7549:    // k is the vertical level index of the variable to get
 7550: 
 7551:    NODE(node);
 7552:    
 7553:    int idx = node->idx;
 7554:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7555: 
 7556:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7557:    
 7558:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7559:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7560:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7561:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7562:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7563:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7564:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;  
 7565:    else if (varCode == (int)VarCode::isdry && k == -1)  var[idx] = node->isDry?1.0:0.0;
 7566:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7567:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7568:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->w2[k];
 7569:    
 7570:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7571:       
 7572:    
 7573: }
 7574: 
 7575: 
 7576: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7577:    // Get the value of a variable from an side
 7578:    // varName is the name of the variable to get
 7579:    // var is the array to store the value
 7580:    // k is the vertical level index of the variable to get
 7581:    SIDE(side);
 7582:    
 7583:    int idx = side->idx;
 7584:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7585: 
 7586:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7587:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7588:    // else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7589:    else if (varCode == (int)VarCode::isdry && k == -1)   var[idx] = side->isDry?1.0:0.0;
 7590:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7591:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7592:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7593:    // else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7594:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7595:    // else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7596:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7597:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7598:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7599:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7600:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7601:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7602:    // else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7603:    else if (varCode == (int)VarCode::bcc && k >= 0)      var[idx] = side->bcc[k].x;
 7604:    // else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7605:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7606:    // else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7607:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7608:    // else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7609:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7610:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?(double)(side->sideBnd->segment->isLand):7.7;
 7611:    // else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd != nullptr ? (double)((unsigned long long)(side->sideBnd->segment) & 0xFFFFFFFF) : 7.7;
 7612:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7613:    else if (varCode == (int)VarCode::chi  && k == -1)    var[idx] = side->chi;
 7614:    // else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7615:    // else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7616:    // else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7617:    // else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7618:    // else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7619:    // else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7620:    // else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7621:    // else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7622:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7623: }
 7624: 
 7625: 
 7626: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 7627:    // Get the value of a variable from an side
 7628:    // varName is the name of the variable to get
 7629:    // var is the array to store the value
 7630:    // k is the vertical level index of the variable to get
 7631:    SIDE_BND(sideBnd);   
 7632: 
 7633:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 7634:    if (sideBnd->segment->isLand) idx = -7;
 7635: 
 7636:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 7637:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 7638: 
 7639: }
