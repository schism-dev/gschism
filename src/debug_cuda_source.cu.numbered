 1740:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1741:       // Compute the different time ramps used in the code 
 1742:       // This function is performed by just one thread
 1743: 
 1744:       rampbc = 1.0;
 1745:       if constexpr(ibc == 0) {
 1746:          if (drampbc > 0.0) {
 1747:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1748:          } else {
 1749:             rampbc = 1.0;
 1750:          }
 1751:       }
 1752: 
 1753:       if (nws != 0) {
 1754:          if (drampwind > 0.0) {
 1755:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1756:          } else {
 1757:             rampwind = 1.0;
 1758:          }
 1759:       }
 1760: 
 1761:       if (drampwafo > 0.0) {
 1762:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1763:       } else {
 1764:          rampwafo = 1.0;
 1765:       }
 1766: 
 1767:       // For source/sinks
 1768:       if (if_source && dramp_ss > 0.0) {
 1769:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1770:       } else {
 1771:          ramp_ss = 1.0;
 1772:       }
 1773: 
 1774:       if (dramp > 0.0) {
 1775:          ramp = tanh(2.0*time/86400.0/dramp);
 1776:       } else {
 1777:          ramp = 1.0;
 1778:       }
 1779: 
 1780: 
 1781:    }
