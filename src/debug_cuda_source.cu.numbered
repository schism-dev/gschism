 5196:       // For all tidal potential components
 5197:       for (int j=0; j<ntip; j++) {
 5198: 
 5199:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5200: 
 5201:          node->ETP += nodeETP;
 5202: 
 5203:          if constexpr(iloadtide==1) { // loading tide
 5204:             assert(false && "Loading tide not implemented");
 5205:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5206:          }
