 7709: __global__ void printMatrix(bool full) {
 7710:    // Debugging: print the matrix
 7711: 
 7712:    const int size = mesh->np;
 7713:    double sum = 0.0;
 7714:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7715:       const Node *node = mesh->localNodeData + idx_node;
 7716:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7717:       for (int j = 0; j < node->numNodes; j++) {
 7718:          Node* nbNode = node->nodes[j];
 7719:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7720:          sum += node->coeffMatrix[j];
 7721:       }
 7722:       if (full) printf("]\n");
 7723: 
 7724: 
 7725:    }
 7726:    if (!full) printf("sum=%lf\n", sum);
 7727: }
 7728: 
 7729: 
 7730: __global__ void returnMatrix(double *res) {
 7731:    // Debugging: returns the matrix as a CuPy array
 7732: 
 7733:    const int size = mesh->np;
 7734:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7735:       const Node *node = mesh->localNodeData + idx_node;
 7736:       res[idx_node*size + idx_node] = node->coeffDiag;
 7737:       for (int j = 0; j < node->numNodes; j++) {
 7738:          Node* nbNode = node->nodes[j];
 7739:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7740:       }
 7741: 
 7742:    }
 7743:    
 7744: }
