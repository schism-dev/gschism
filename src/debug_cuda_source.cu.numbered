  844: struct Side {
  845: 
  846:    // Geometry information
  847:    int idx;               // Index of the side
  848:    Node *n1, *n2;
  849:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  850: 
  851:    double len;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  852:    Vector2 center;        // Location of side center. 
  853:    double zc[nvrt];       // Side center z-coord at each vertical level
  854: 
  855:    Frame frame;
  856: 
  857:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  858:                           // this is nullptr
  859:    
  860:    int kb;                // Bottom index of the side
  861:    bool isDry;             // True if the side is dry
  862:  
  863:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  864: 
  865:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  866: 
  867:    // Physical information
  868:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  869:    double  w2[nvrt];            // Vertical velocity at each vertical level
  870:    Vector2 btu[nvrt];           // Back-tracked velocity
  871:    Vector2 uth[nvrt];           // "Time history" velocity
  872:    Vector2 U;                   // Vertically averaged velocity vector  
  873: 
  874:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  875: 
  876:    Vector2 bcc[nvrt];           // Baroclinic term
  877:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  878: 
  879:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  880:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  881:    Vector2 gradPr;               // Gradient of pressure
  882:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  883: 
  884: 
  885:    double hhat;                 // \breve{H} in notes
  886: 
  887:    double shapiro;
  888: 
  889:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  890: 
  891:    double coriolis;             // Coriolis parameter
  892: 
  893:    // Vegetation parameters
  894:    double veg_c2;
  895:    double veg_beta;
  896: 
  897:    // Bottom drag parameters.
  898:    double chi;
  899:    double chi2;
  900: 
  901:    __inline__ __device__ double x(double t) const;
  902:    __inline__ __device__ double y(double t) const;
  903:    __inline__ __device__ Point2 p_t(double t) const;
  904: 
  905:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  906:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  907:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  908:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  909: 
  910:    __inline__ __device__ Side* neigh(int index) const { 
  911:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  912:       assert(index >= 0 && index < 4); 
  913:       assert(elems[0] != nullptr && elems[1] != nullptr);
  914: 
  915:       const int ielem = index & 1;           // 0 or 1
  916:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  917: 
  918:       const Element* elem = elems[ielem];
  919: 
  920:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  921: 
  922:       return elem->sides[elem->nxq(locSideIdx + iside)];
  923: 
  924:    }
  925: 
  926:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  927: 
  928:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  929: 
  930:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  931:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  932:    __inline__ __device__ int iadv(void) const;
  933: 
  934:    __inline__ __device__ double grav3(void) const;
  935:    
  936:    __inline__ __device__ double eta2(void) const;
  937:    __inline__ __device__ double eta1(void) const;
  938:    __inline__ __device__ double depth(void) const;
  939:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  940:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  941: 
  942:    __inline__ __device__ double dfv(int k) const;
  943: 
  944:    __inline__ __device__ double veg_h(void)  const;
  945:    __inline__ __device__ double veg_nv(void) const;
  946:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  947:    __inline__ __device__ double veg_alpha3D(int k) const;
  948:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  949: 
  950:    __inline__ __device__ double etaMeanBnd(void) const;
  951: 
  952:    __inline__ __device__ double Cd(void) const;
  953: 
  954:    __inline__ __device__ Vector2 tau(void) const;
  955: 
  956:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  957:    
  958: 
  959:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  960:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  961:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  962:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  963:    } 
  964:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  965:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  966:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  967:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  968: 
  969:    // Get valid starting element (for backtracking)
  970:    __inline__ __device__ Element* getStartElement() {
  971:       return elems[0] ? elems[0] : elems[1];
  972:    }
  973: 
  974:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  975:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  976: 
  977:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
  978: 
  979:       // Dot product of the negative velocity vector with the side normal vector
  980:       const double dot_prod1 = -dot(u, n);
  981: 
  982:       // Vector from side center to element 0 centroid
  983:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  984: 
  985:       // Dot product of the vector with the side normal vector
  986:       const double dot_prod2 = dot(v2, n);
  987: 
  988:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  989:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  990: 
  991:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  992:       else                           return elems[1];
  993: 
  994:  
  995:    }
  996: 
  997:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
  998:       // Given an element, returns the other element that shares this side
  999:       return (elems[0] == elem) ? elems[1] : elems[0];
 1000:    }
 1001: 
 1002:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1003:       // Given a node, returns the other node that shares this side
 1004:       return (n1 == node) ? n2 : n1;
 1005:    }
 1006:  
 1007:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1008: 
