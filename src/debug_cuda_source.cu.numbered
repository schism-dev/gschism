 1918:    template<typename T>
 1919:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 1920:       // Get the values of the field at the nodes of the element
 1921:       res[0] = nodes[0]->*field;
 1922:       res[1] = nodes[1]->*field;
 1923:       res[2] = nodes[2]->*field;
 1924:       if (isQuad()) res[3] = nodes[3]->*field;
 1925:       else          res[3] = T();
 1926:    }
 1927: 
 1928:    template<typename T>
 1929:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 1930:       // Get the values of the field at the nodes of the element
 1931:       res[0] = (nodes[0]->*field)[level];
 1932:       res[1] = (nodes[1]->*field)[level];
 1933:       res[2] = (nodes[2]->*field)[level];
 1934:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
 1935:       else          res[3] = T();
 1936:    }    
 1937: 
 1938:    template<typename T>
 1939:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 1940:       // Get the values of the func at the nodes of the element
 1941:       res[0] = (nodes[0]->*func)(level);
 1942:       res[1] = (nodes[1]->*func)(level);
 1943:       res[2] = (nodes[2]->*func)(level);
 1944:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
 1945:       else          res[3] = T();  // This is 0.0 or a zero vector
 1946: 
 1947:    }      
