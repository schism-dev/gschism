 2130:    template<typename T>
 2131:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2132: 
 2133:       T values[4];
 2134: 
 2135: 
 2136:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2137:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2138:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2139:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2140:       else          values[3] = T();
 2141: 
 2142:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2143: 
 2144:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2145:    }
