 2361:    template<typename T>
 2362:    __device__ __forceinline__ T Element::mean(int level, T (Side::* field)[nvrt]) const {
 2363:       T values[4];
 2364:       getSideValues(level, field, values);
 2365: 
 2366:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2367:       if constexpr (IsVector2<T>::value && ics == 2) {
 2368: // XXXXX printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2369:          projectSideVectorsToElementFrame(values);
 2370: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2371:       }
 2372: 
 2373:       return (values[0] + values[1] + values[2] + values[3])/i34;
