  459: struct Element {
  460: 
  461:    // Geometry information
  462:    int idx;               // Index of the element
  463:    int i34;               // Number of sides for the element 
  464:    Side *sides[4];        // Sides of the element
  465:    Node *nodes[4];        // Nodes of the element
  466:    Element *nghbElems[4]; // Neighbors of the element
  467: 
  468:    int kb;                    // Bottom index of the element
  469:    double area;               // Area of the element
  470:    double ssign[4];           // Sign associated with each side of an element
  471:    double radius;             // Element equivalent radii
  472: 
  473:    Frame frame;
  474: 
  475:    Vector2 gradPhi[4];       // Derivatives of shape functions
  476:    Vector2 gradEta;          // Gradient of free surface elevation
  477:    Vector2 gradPr;           // Gradient of pressure    
  478:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  479: 
  480:    bool isDry;                  // True if the element is dry
  481:    int kbe;                   // Bottom index of the element
  482: 
  483:    Vector3 center;            // Element center coordinates
  484:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  485:    double depth;              // Depth at element (min of all nodes)
  486:    double z[nvrt];            // z-coord  (local frame - vertical up)
  487: 
  488:    // Physical information
  489:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  490: 
  491:    static const bool isblock = false;              // Always false
  492: 
  493:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  494:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  495: 
  496:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  497: 
  498:    
  499: 
  500:    double vsource;            // Volumetric source/sink term [m^3/s]
  501: 
  502:    double rho[nvrt];          // Density at each prism center
  503:    double rho_mean[nvrt];     // Mean density at each prism center
  504:    CubicSpline rho_spl;
  505:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  506:    double rho_z[nvrt];        // First derivative of density at each prism center
  507:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  508: 
  509:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  510: 
  511:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  512:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  513: 
  514:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  515:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  516: 
  517:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  518:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  519:       // Find the local index of the node in the element (0,1,2,3)
  520:       int res = __ffs((nodes[0] == node) | 
  521:                      ((nodes[1] == node) << 1) | 
  522:                      ((nodes[2] == node) << 2) | 
  523:                      ((nodes[3] == node) << 3)) - 1;
  524:       
  525:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  526:       return res;
  527:    }
  528: 
  529:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  530:       // Find the local index of the side in the element (0,1,2,3)
  531:       int res = __ffs((sides[0] == side) | 
  532:                      ((sides[1] == side) << 1) | 
  533:                      ((sides[2] == side) << 2) | 
  534:                      ((sides[3] == side) << 3)) - 1;
  535:       
  536:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  537:       return res;
  538:    }
  539: 
  540: 
  541:    __inline__ __device__ int findLevel(double z1, int k) const {
  542:       // Starting at index k, find sequentially the level that contains z
  543: 
  544:       // if z is already betweeen z[k] and z[k+1], return k
  545:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  546:       else if (z1 < z[k]) { 
  547:          // Search for increasing levels
  548:          for (int kk = k; kk < nvrt - 1; kk++) {
  549:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  550:          }
  551:          return nvrt - 1;
  552:       }
  553:       else {
  554:          // Search for decreasing levels
  555:          for (int kk = k; kk > 0; kk--) {
  556:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  557:          }
  558:          return 0;
  559:       }
  560:    }
  561: 
  562:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  563:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  564: 
  565:    // Check if the element is dry using the more up-to-date elevation.
  566:    __inline__ __device__ bool isDry2(void) const;
  567: 
  568:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  569: 
  570:    __inline__ __device__ double computeSignedArea(void) const;
  571: 
  572:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  573:       // Nudges the point (x,y) to the barycenter of the element
  574:       p = (1-eps)*p + eps*toVector2(center);
  575:    }
  576: 
  577:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  578:    
  579:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  580: 
  581:    __device__ Vector2 grad2(double *a) const
  582:    {
  583:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  584:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  585:       if (isQuad()) {
  586:          gx += a[3]*gradPhi[3].x;
  587:          gy += a[3]*gradPhi[3].y;
  588:       }
  589:       return {gx, gy};
  590:    }
  591: 
  592:    __device__ Vector2 grad2(double Node::* field) const
  593:    {
  594:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  595:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  596:       if (isQuad()) {
  597:          gx += (nodes[3]->*field)*gradPhi[3].x;
  598:          gy += (nodes[3]->*field)*gradPhi[3].y;
  599:       }
  600:       return {gx, gy};
  601:    }
  602: 
  603:    __device__ void setFrame(void) {
  604: 
  605:       double ar1, ar2;
  606:       computeLonLat(center, ar1, ar2);
  607: 
  608:       frame.update(ar1, ar2);        
  609:     }
  610: 
  611:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  612:                                         double& tIntersect);
  613:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  614:                                         double& tIntersect);
  615: 
  616:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  617:       // Check if the point (xt,yt) is inside the element
  618:       double shpCoords[4];
  619: 
  620:       bool res = computeShapeCoords(xt, shpCoords, false);
  621: 
  622:       return res;
  623:    }
  624: 
  625:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  626:       // Check if the point (xt,yt) is inside the element
  627:       double shpCoords[4];
  628: 
  629:       Vector2 tmp_xt = xt;
  630:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  631: 
  632:       if (fixCoords && res) xt = tmp_xt;
  633: 
  634:       return res;
  635:    }
  636: 
  637:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  638:    {
  639:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  640:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  641:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  642:       
  643:    }
  644: 
  645:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  646: 
  647:    // ------------------------------------------------------------------------------------------------
  648:    // These are functions that work on all nodes of the element.
  649:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  650:    //
  651:    // An example of how to use these functions is:
  652:    //   
  653:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  654:    // 
  655:    // Where L is the level at which the field is to be interpolated. The field can be either
  656:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  657:    // There are different versions of getNodalValues for each of these cases.
  658: 
  659:    template<typename T>
  660:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  661:       // Get the values of the field at the nodes of the element
  662:       res[0] = nodes[0]->*field;
  663:       res[1] = nodes[1]->*field;
  664:       res[2] = nodes[2]->*field;
  665:       if (isQuad()) res[3] = nodes[3]->*field;
  666:       else          res[3] = T();
  667:    }
  668: 
  669:    template<typename T>
  670:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  671:       // Get the values of the field at the nodes of the element
  672:       res[0] = (nodes[0]->*field)[level];
  673:       res[1] = (nodes[1]->*field)[level];
  674:       res[2] = (nodes[2]->*field)[level];
  675:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  676:       else          res[3] = T();
  677:    }    
  678: 
  679:    template<typename T>
  680:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  681:       // Get the values of the func at the nodes of the element
  682:       res[0] = (nodes[0]->*func)(level);
  683:       res[1] = (nodes[1]->*func)(level);
  684:       res[2] = (nodes[2]->*func)(level);
  685:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  686:       else          res[3] = T();  // This is 0.0 or a zero vector
  687: 
  688:    }      
  689: 
  690:    template<typename T>
  691:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  692:       // Get the values of the field at the nodes of the element
  693:       res[0] = sides[0]->*field;
  694:       res[1] = sides[1]->*field;
  695:       res[2] = sides[2]->*field;
  696:       if (isQuad()) res[3] = sides[3]->*field;
  697:       else          res[3] = T();
  698:    }
  699: 
  700:    template<typename T>
  701:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  702:       // Get the values of the field at the nodes of the element
  703:       res[0] = (sides[0]->*field)[level];
  704:       res[1] = (sides[1]->*field)[level];
  705:       res[2] = (sides[2]->*field)[level];
  706:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  707:       else          res[3] = T();
  708:    }    
  709: 
  710:    template<typename T>
  711:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  712:       // Get the values of the func at the nodes of the element
  713:       res[0] = (sides[0]->*func)(level);
  714:       res[1] = (sides[1]->*func)(level);
  715:       res[2] = (sides[2]->*func)(level);
  716:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  717:       else          res[3] = T();  // This is 0.0 or a zero vector
  718: 
  719:    }      
  720: 
  721: 
  722:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  723:       double values[4];
  724:       getNodalValues(level, func, values);
  725: 
  726:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  727:    }
  728: 
  729:    template<typename T>
  730:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  731:       T values[4];
  732:       getNodalValues(field, values);
  733:       
  734:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  735:    }
  736: 
  737: 
  738:    template<typename T>
  739:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  740:       T values[4];
  741:       getNodalValues(level, field, values);
  742: 
  743:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  744:    }
  745: 
  746:    template<typename T>
  747:    __device__ T mean(T Node::* field) const {
  748:       T values[4];
  749:       getNodalValues(field, values);
  750: 
  751:       return (values[0] + values[1] + values[2] + values[3])/i34;
  752:    }
  753: 
  754:    template<typename T>
  755:    __device__ T mean(T Side::* field) const {
  756:       T values[4];
  757:       getSideValues(field, values);
  758:       
  759:       return (values[0] + values[1] + values[2] + values[3])/i34;
  760:    }   
  761: 
  762:    // __device__ double mean(double (Node::*func)(int) const) const {
  763:    //    double values[4];
  764:    //    getNodalValues(level, func, values);
  765:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  766:    // }
  767:    // ------------------------------------------------------------------------------------------------
  768: 
  769:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  770:       // Convert global coordinates to local coordinates
  771:       printf("NOT IMPLEMENTED: globalToLocal\n");
  772:       return true;
  773:    }
  774: 
  775:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  776:       // Convert local coordinates to global coordinates
  777:       printf("NOT IMPLEMENTED: localToGlobal\n");
  778:       return true;
  779:    }
  780: 
  781:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  782:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  783:     
  784:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  785:                                                  Element *&nextElem, int &jlev, double &dt);
  786: 
