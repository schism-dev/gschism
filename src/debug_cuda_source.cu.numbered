 2749: 
 2750: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2751: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2752: // Returns the normal vector and the area of the element at this level
 2753:    
 2754:    double nx, ny, nz;
 2755: 
 2756:    if (isTri()) {
 2757:       // For triangles...
 2758: 
 2759:       // Indices of the nodes at level k, taking care of not going below the bed
 2760:       const int k0 = max(k, nodes[0]->kb);
 2761:       const int k1 = max(k, nodes[1]->kb);
 2762:       const int k2 = max(k, nodes[2]->kb);
 2763: 
 2764:       // Gets the element frame coordinates of the nodes at level k
 2765:       Point3 x0, x1, x2;
 2766:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2767:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2768:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2769:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2770: 
 2771:       } else {  // ics == 2
 2772:          Point2 h0, h1, h2;
 2773: 
 2774:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2775: 
 2776:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2777:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2778:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2779:       }
 2780: 
 2781:       const Vector3 n20 = x2 - x0;
 2782:       const Vector3 n10 = x1 - x0; 
 2783: 
 2784:       // Computes the cross product of vectors n20 and n10. 
 2785:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2786:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2787:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2788: 
 2789:   
 2790:    }
 2791:    else {
 2792:       // For quads...
 2793:       Point2 h0, h1, h2, h3;
 2794: 
 2795:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2796: 
 2797:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2798:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2799:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2800:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2801: 
 2802:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2803:       nx = n20.y*n31.z - n20.z*n31.y;
 2804:       ny = n20.z*n31.x - n20.x*n31.z;
 2805:       nz = n20.x*n31.y - n20.y*n31.x;
 2806: 
 2807:    }
 2808: 
 2809:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2810:    area3D = 0.5*len;
 2811: 
 2812:    const double inv_len = 1.0/len;
 2813: 
 2814:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2815: 
 2816: }
 2817: 
 2818: 
 2819: // Helper functions to get the 2D local node position for the Celestial walk
 2820: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2821:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2822:    const Node *node = getNodeInOrder(idx2);
 2823: 
 2824:    double z = 0.0;
 2825:    if constexpr(ics == 2) z = node->gz;
 2826:    
 2827:    Point3 p = toPoint3(node->p, z);
 2828: 
 2829:    return toPoint2(origSide->toLocalFrame(p));
 2830: }
 2831: 
 2832: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2833:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2834: }
 2835: 
 2836: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2837:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2838: // Computes the three per-side predicates needed for the celestial walk
 2839: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2840: //
 2841: // xt is in local frame coordinates for origSide if ics == 2.
 2842: //
 2843: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2844: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2845: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2846: // meaningless on triangles are masked to a safe value (see comments below).
 2847: {
 2848:    // Project all 4 corner positions once into the local 2D frame.
 2849:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2850:    // getLocalNodePosition only transforms/projects if ics == 2.
 2851:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2852:                         getLocalNodePosition(1, origSide), 
 2853:                         getLocalNodePosition(2, origSide), 
 2854:                         getLocalNodePosition(3, origSide)};
 2855: 
 2856:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2857:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2858:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2859:    // But still farther towards the target point from the current point.
 2860:    const Vector2 vt0 = xt - x0;
 2861:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2862:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2863:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2864: 
 2865:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2866:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2867: 
 2868: 
 2869: // if (origSide->idx == 2860848 && jlev == 46) {
 2870: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2871: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2872: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2873: // }
 2874:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2875:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2876:    //  here the orientation is baked into the corners array.)
 2877:    const int i3 = nxq(3);
 2878:    const Vector2 s0 = C[ 1] - C[ 0];
 2879:    const Vector2 s1 = C[ 2] - C[ 1];
 2880:    const Vector2 s2 = C[i3] - C[ 2];
 2881:    const Vector2 s3 = C[ 0] - C[i3];
 2882:    
 2883:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2884:    // The corners array is built from getNode in CCW order, so the orientation
 2885:    // is already correct and no ssign factor is needed in the formulas below.
 2886:    //
 2887:    // i3 = nxq(3): the index of the corner after side 2.
 2888:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2889:    //   Quad:     i3 == 3.
 2890:    //
 2891:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2892:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2893:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2894:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2895:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2896:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2897: 
 2898: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2899: 
 2900:    // For triangles, the corner after side 2 is the closing corner where
 2901:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2902:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2903:    // s0 for triangles, s3 for quads.
 2904:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2905: 
 2906:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2907:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2908:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2909:    //
 2910:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2911:    // result is false naturally. No sentinel needed.
 2912:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2913:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2914:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2915:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2916: 
 2917:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2918:    // on the "exit through side I" half of the corner cone, separated by the
 2919:    // approximate angular bisector of the celestial walk. The bisector is
 2920:    // perpendicular to the chord across the corner; the test is the sign of
 2921:    // (xt - corner_vertex) projected onto that chord.
 2922:    //
 2923:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2924:    // (the validity rule sets valid_3 = false), so its computed value for
 2925:    // triangles doesn't matter. No sentinel needed.
 2926:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2927:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2928:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2929:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2930: 
 2931: }
 2932: 
 2933: 
 2934: __inline__ __device__ double Element::computeSignedArea(void) const {
 2935:    // Compute the area of the element
 2936: 
 2937:    Point2 x0, x1, x2, x3;
 2938:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2939: 
 2940: 
 2941:    double res = signedArea(x0, x1, x2);
 2942: 
 2943:    // In the quad case we need to add the area of the other triangle.
 2944:    if (isQuad()) {
 2945:       x3 = getLocalHorizontalNodePosition(3);
 2946:       double ar1 = signedArea(x0, x2, x3);
 2947:       double ar2 = signedArea(x0, x1, x3);
 2948:       double ar3 = signedArea(x1, x2, x3);
 2949:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2950: 
 2951:       res += ar1;
 2952: 
 2953:    }
 2954: 
 2955:    return res;
 2956: }
 2957: 
 2958: 
 2959: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2960:                                                                 (nodes[1]->isDry2()) ||
 2961:                                                                 (nodes[2]->isDry2()) ||
 2962:                                                                 (isQuad() && nodes[3]->isDry2());
 2963: }
 2964: 
 2965: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2966:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2967: }
 2968: 
 2969: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2970:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2971: }
 2972: 
 2973: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2974:    // In boundary sides, the element 1 is nullptr
 2975:    return side->elems[1] == nullptr; 
 2976: }
 2977: 
 2978: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2979:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2980:    // For ics == 2, this function uses local frame coordinates.
 2981: 
 2982:    assert(isQuad());
 2983: 
 2984:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2985:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2986:    // where vxi, veta, vb are vectors and c is the center of the element.
 2987: 
 2988:    Point2 p0, p1, p2, p3;
 2989: 
 2990:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2991: 
 2992:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2993:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2994:    // vectors vxi and veta connect the centers of opposite sides
 2995:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2996:    // vb is zero for parallelogram elements.
 2997:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2998: 
 2999:    //  The bilinear mapping is:
 3000:    //      P(s,t) = C + s*U + t*V + s*t*W
 3001:    //
 3002:    //  where:
 3003:    //    C = centroid (average of four vertices)
 3004:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 3005:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 3006:    //    W = bilinear correction; measures deviation from parallelogram
 3007:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 3008:    //        W = 0 for parallelogram elements.
 3009:    //
 3010:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 3011:    //
 3012:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 3013:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 3014:    //
 3015:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 3016:    //
 3017:    //  Geometrically, (L) projects everything onto the direction
 3018:    //  perpendicular to W, where the mapping is purely affine.
 3019:    //
 3020:    //  The dot product with nb retains the nonlinear term:
 3021:    //
 3022:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 3023:    //
 3024:    //  Geometrically, (Q) projects onto the W direction, where
 3025:    //  the nonlinearity lives.
 3026:    //
 3027:    //  We solve (L) for whichever variable has the larger coefficient
 3028:    //  (better conditioned back-substitution), substitute into (Q),
 3029:    //  and get a scalar quadratic in the other variable.
 3030:    // ================================================================
 3031: 
 3032:    // ---- Basis vectors ----
 3033:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 3034:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 3035:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 3036:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 3037:    // W: nonlinear correction. Difference between quad and parallelogram.
 3038:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 3039:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 3040: 
 3041:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 3042:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 3043:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 3044:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 3045:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 3046: 
 3047:    // ---- nb: direction parallel to W, L1-normalized ----
 3048:    // We don't need a unit vector -- just a well-scaled direction parallel
 3049:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 3050:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 3051:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 3052:    //
 3053:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 3054:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 3055:    // and the quadratic solver takes its linear path (a ~ 0).
 3056:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 3057:    const double inv_wlen = 1.0 / wlen1;
 3058:    const Vector2 nb = vb * inv_wlen;
 3059: 
 3060:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 3061:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 3062:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 3063:    // What remains is a pure affine relationship between xi and eta.
 3064:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 3065:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 3066:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 3067: 
 3068:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 3069:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 3070:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 3071:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 3072:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 3073:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 3074:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 3075: 
 3076:    // ---- Solve: pick the better-conditioned variable from (L) ----
 3077:    // Back-substitute from (L) dividing by the LARGER coefficient,
 3078:    // minimizing round-off amplification.
 3079:    //
 3080:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 3081:    // that uses predicated moves.
 3082:    //
 3083:    // if (fabs(Ls) > fabs(Lt)) {
 3084:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 3085:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 3086:    //    // Substitute into (Q), multiply by Ls, group by eta:
 3087:    //    const double A = -Qw * Lt;
 3088:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 3089:    //    const double C =  Qs * Lp - Qp * Ls;
 3090: 
 3091:    //    double eta1, eta2;
 3092:    //    solveQuadratic(A, B, C, eta1, eta2);
 3093: 
 3094:    //    // Pick root with smaller |eta| (domain centered at 0).
 3095:    //    // Ternary-> predicated move, no branch divergence.
 3096:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 3097: 
 3098:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 3099:    //    xi = (Lp - Lt * eta) / Ls;
 3100: 
 3101:    // } else {
 3102:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 3103:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 3104:    //    // Substitute into (Q), multiply by Lt, group by xi:
 3105:    //    const double A = -Qw * Ls;
 3106:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 3107:    //    const double C =  Qt * Lp - Qp * Lt;
 3108: 
 3109:    //    double xi1, xi2;
 3110:    //    solveQuadratic(A, B, C, xi1, xi2);
 3111: 
 3112:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 3113: 
 3114:    //    eta = (Lp - Ls * xi) / Lt;
 3115:    // }
 3116:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 3117:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 3118:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 3119:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 3120:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 3121: 
 3122:    // Quadratic:  A*r^2 + B*r + C = 0
 3123:    // (same formula for both cases, just with swapped coefficients)
 3124:    const double A = -Qw * Lb;
 3125:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 3126:    const double C =  Qa * Lp - Qp * La;
 3127: 
 3128:    double r1, r2;
 3129:    solveQuadratic(A, B, C, r1, r2);
 3130: 
 3131:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 3132:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 3133: 
 3134:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 3135:    const double other = (Lp - Lb * r) / La;
 3136: 
 3137:    // Assign to (xi, eta) depending on which variable the quadratic solved
 3138:    xi  = solve_s ? r     : other;
 3139:    eta = solve_s ? other : r;
 3140: 
 3141: 
 3142:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 3143:    xi  = clamp(xi,  -1.0, 1.0);
 3144:    eta = clamp(eta, -1.0, 1.0);
 3145: 
 3146:    // ---- Shape functions ----
 3147:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 3148:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 3149:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 3150:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 3151:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 3152:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 3153:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 3154:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 3155: 
 3156:    return true;
 3157: }
 3158: 
 3159: /**
 3160:    Compute the shape coordinates of the point (xt,yt) in the element.
 3161:    @param xt (input): x-coordinate of the point
 3162:    @param shpCoords (output): shape coordinates of the point
 3163:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 3164:    @return true if the point is inside the element, false otherwise
 3165: **/
 3166: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 3167: 
 3168:    // Compute the shape coordinates of the point xt in the element.
 3169:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 3170:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 3171:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 3172:    // from the local frame, so use additional check.
 3173: 
 3174: 
 3175:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 3176: 
 3177:    if (isTri()) { // Triangular element
 3178: 
 3179:       // Horizontal local node coordinates. 
 3180:       Point2 x0, x1, x2;
 3181:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 3182: 
 3183:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 3184:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 3185:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 3186:       shpCoords[3] = 0.0;
 3187: 
 3188:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 3189:       const bool res = (tmpmin >= -small);  
 3190:       
 3191:       // When to fix the negative shape coordinates?
 3192:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3193: 
 3194:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 3195:       // then we fix the negative shape coordinates.
 3196:       if ((tmpmin < 0) && fix) {
 3197: 
 3198:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 3199:          // keeping the sum of the shape coordinates equal to 1.
 3200:          // I have tested and compared the new algorithm with the old one, and they give
 3201:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 3202:          // The new algorithm should be faster since it is branchless.
 3203:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 3204:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 3205: 
 3206:          shpCoords[0] = (shpCoords[0] + a)*b;
 3207:          shpCoords[1] = (shpCoords[1] + a)*b;
 3208:          shpCoords[2] = (shpCoords[2] + a)*b;          
 3209: 
 3210:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 3211:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 3212:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 3213: 
 3214:          // Update the point coordinates for the new shape coordinates
 3215:          double xcoords[3] = {x0.x, x1.x, x2.x};
 3216:          double ycoords[3] = {x0.y, x1.y, x2.y};
 3217: 
 3218:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 3219: 
 3220:       }
 3221: 
 3222:       // Return true if the point is inside the element
 3223:       return res;      
 3224:    }
 3225:    else {
 3226:       assert(isQuad() && "computeShapeCoords");
 3227: 
 3228:       // Horizontal local node coordinates with respect to the original side.
 3229:       Point2 x0, x1, x2, x3;
 3230:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 3231: 
 3232:       const double a0 = signedArea(x0, x1, xt);
 3233:       const double a1 = signedArea(x1, x2, xt);
 3234:       const double a2 = signedArea(x2, x3, xt);
 3235:       const double a3 = signedArea(x3, x0, xt);
 3236: 
 3237:       const double minArea = min4(a0, a1, a2, a3);
 3238:       
 3239:       const bool res = (minArea > -small*area);
 3240: 
 3241:       // When to fix the negative shape coordinates?
 3242:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 3243: 
 3244:       double xi, eta;    
 3245: 
 3246:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 3247:       // Does nothing if ics == 1.
 3248:       assert(origSide != nullptr);
 3249:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 3250: 
 3251:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 3252: 
 3253:       if (fix) {
 3254:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 3255:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 3256:          xt.x = interpolate(shpCoords, xn);
 3257:          xt.y = interpolate(shpCoords, yn);
 3258:       }
 3259: 
 3260:       return res;
 3261:    }
 3262: 
 3263: 
 3264:    assert(false && "computeShapeCoords: should never reach this point");
 3265:    return false;  // Never reached
 3266: 
 3267: }
 3268: 
 3269: 
 3270: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3271: // Convert shape coordinates to cartesian coordinates
 3272: 
 3273:    if (isTri()) {
 3274:       // Triangular element
 3275: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3276:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3277:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3278:    }
 3279:    else {
 3280:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3281:    }
 3282: 
 3283: }
 3284: 
 3285: 
 3286: 
 3287: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3288:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3289:    
 3290:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3291: }
 3292: 
 3293: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3294:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3295:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3296:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3297:    return area * dot(gradPhi[i], gradPhi[j]);
 3298: }
 3299: 
 3300: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3301:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3302:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3303:    // The formula for the integral is:
 3304:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3305:    
 3306:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3307:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3308:    const double eta_sum  = eta_n(i) + eta_n(j);
 3309:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3310: 
 3311:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3312:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3313: 
 3314: 
 3315:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3316: }
 3317:    
 3318: 
 3319: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3320:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3321:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3322:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3323:    // The formula is also based on the identity:
 3324:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3325:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3326: 
 3327:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3328: 
 3329: 
 3330: 
 3331:    double res = 0.0;
 3332:    
 3333:    // Quadrature points in xi and eta coordinates
 3334:    #pragma unroll
 3335:    for (int i = 0; i < 4; i++) {
 3336:       // For each quadrature point...
 3337: 
 3338:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3339:       const double eta = p.x;
 3340:       const double xi  = p.y;
 3341: 
 3342:       // Jacobian entries at the Gauss point p
 3343:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3344:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3345:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3346:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3347: 
 3348:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3349:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3350: 
 3351:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3352:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3353:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3354:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3355:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3356: 
 3357:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3358:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3359:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3360:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3361:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3362: 
 3363:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3364:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3365:    }
 3366: 
 3367:    return res;
 3368: }
 3369: 
 3370: 
 3371: /**  Interpolate velocities at a given point (xt,yt,zt)
 3372: 
 3373:    @param xt, yt, zt: coordinates of the point to interpolate
 3374:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3375: 
 3376:    This is done in four steps:
 3377: 
 3378:    1. Find the shape coordinates for the final position in the element.
 3379:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3380:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3381:       z levels at xt, yt at each step.   
 3382:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3383:       horizontally and vertically.
 3384: **/
 3385: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3386:    // Interpolate the velocities at the point xt. 
 3387:    // This function works the same for triangular and quadrilateral elements.
 3388:    double shpCoord[4];
 3389:    Vector3 u_int;
 3390: 
 3391: 
 3392:    // First step is to compute the shape coordinates of (xt,yt)
 3393: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3394:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3395: 
 3396:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3397: 
 3398:    // Second step is to find the level that contains zt
 3399:    // Uses a binary search to find the level
 3400:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3401:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3402:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3403:    int R = nvrt - 1;
 3404: 
 3405:    // Get the z coordinates at the nodes of the element at the levels L and R
 3406:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3407:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3408:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3409: 
 3410: 
 3411:    double zL = interpolate(shpCoord, zLAtNodes);
 3412:    double zR = interpolate(shpCoord, zRAtNodes);
 3413: 
 3414:    // Interpolates vertically the velocities
 3415:    double wght1, wght2;
 3416:    if (xt.z <= zL) {
 3417:       wght1 = 1.0;
 3418:       wght2 = 0.0;
 3419:       xt.z = zL;
 3420:    }
 3421:    else if (xt.z >= zR) {
 3422:       wght1 = 0.0;
 3423:       wght2 = 1.0;
 3424:       xt.z = zR;
 3425:    }
 3426:    else {
 3427:       // Perform a binary search to find the levels between L and R that contain xt.z
 3428:       while (R - L > 1) {
 3429:          int M = (L + R) / 2.0;
 3430: 
 3431:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3432:          double zM = interpolate(shpCoord, zMAtNodes);
 3433:          if (zM < xt.z) 
 3434:          {
 3435:             L = M;
 3436:             zL = zM;
 3437:          }
 3438:          else 
 3439:          {
 3440:             R = M;
 3441:             zR = zM;
 3442:          }
 3443:       }
 3444:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3445:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3446: 
 3447:       wght2 = (xt.z - zL)/(zR - zL);
 3448:       wght1 = 1.0 - wght2;
 3449: 
 3450:    }
 3451: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3452: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3453:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3454:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3455:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3456:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3457: 
 3458:    // Project the velocity from the local frame to the origSide frame
 3459:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3460:    u_int = {uv.x, uv.y, w};
 3461: 
 3462:    // Neither of the interpolated velocities should be NaN
 3463:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3464: 
 3465:    return u_int;
 3466: 
 3467: }
 3468: 
 3469: 
 3470: 
 3471: 
 3472: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3473: 
 3474:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3475:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3476:    const Node *n1 = side->n1;
 3477:    const Node *n2 = side->n2;
 3478: 
 3479:    bool n1_match = (n1->nodeBnd->segment == segment);
 3480:    bool n2_match = (n2->nodeBnd->segment == segment);
 3481: 
 3482:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3483:    if (n1_match && n2_match) {
 3484:       return 0.5;
 3485:    } else if (n1_match) {
 3486:       return 1.0;
 3487:    } else if (n2_match) {
 3488:       return 0.0;
 3489:    }
 3490: 
 3491:    return 0.0;
 3492: }
 3493: 
 3494: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3495: 
 3496: 
 3497: 
 3498: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3499:    // Returns the value of the velocity at the side center
 3500:    const double w1 = getBoundaryArrayValueWeight();
 3501:    const double w2 = 1.0 - w1;
 3502:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3503:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3504: 
 3505:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3506: }
 3507: 
 3508: 
 3509: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3510:    // Returns the value of the normal component of the velocity at the side center
 3511:    const double w1 = getBoundaryArrayValueWeight();
 3512:    const double w2 = 1.0 - w1;
 3513:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3514:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3515: 
 3516:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3517: }
