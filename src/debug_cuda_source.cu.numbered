 2306: 
 2307: 
 2308: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2309: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2310: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2311: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2312:    Vector2 grad = {0.0, 0.0};
 2313:    int count = 0;
 2314: 
 2315:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2316: 
 2317:    // First element
 2318:    if (elems[0] != nullptr && condition(elems[0])) {
 2319:       grad += elems[0]->grad2(field);
 2320:       count++;
 2321:    }
 2322: 
 2323:    // Second element
 2324:    if (elems[1] != nullptr && condition(elems[1])) {
 2325:       grad += elems[1]->grad2(field);
 2326:       count++;
 2327:    }
 2328: 
 2329:    if (count > 0) {
 2330:       grad = grad/count;
 2331:    }
 2332:    
 2333:    return grad;
 2334: }
 2335: 
 2336: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2337: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2338: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2339: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2340: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2341: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2342: 
 2343: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2344: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2345: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2346: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2347: 
 2348: __inline__ __device__ double  Side::etaMeanBnd(void) const { assert(n1->nodeBnd != nullptr && n2->nodeBnd != nullptr && "etaMeanBnd not assigned"); 
 2349:                                                              assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Bad value for etaMeanBnd");
 2350:                                                              // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2351:                                                              return 0.5*(n1->nodeBnd->eta_mean + n2->nodeBnd->eta_mean); }
 2352: 
 2353: 
 2354: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2355: 
 2356: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2357: 
 2358: /**
 2359:  * This method performs backtracking from the side center until a time -dt back in time 
 2360:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2361:  * intermediate point.
 2362:  *
 2363:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2364:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2365:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2366:  * remaining time.
 2367:  * 
 2368:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2369:  * 
 2370:  * @param uuint, vvint, wwint: Velocities at the final point
 2371:  * @param jlev: Level at which the backtracking is performed
 2372:  * @param dt, dtbk: Tracking timesteps
 2373:  * @return: True if the backtracking was successful, false otherwise
 2374:  */
 2375: __inline__ __device__ bool Side::btrack(
 2376:       int jlev,
 2377:       double dt,            // Tracking time
 2378:       double dtbk,          // Tracking timestep
 2379:       Vector3 &u_int        // Velocities at the initial point
 2380: ) const {
 2381: 
 2382:    // Start from side center
 2383:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2384:  
 2385: 
 2386:    double time_rm = dt; // Remaining time
 2387: 
 2388: 
 2389:    // // Initialize outputs XXX
 2390:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2391:    //    sclr[i] = 0.0;
 2392:    // }
 2393: 
 2394: 
 2395:    // Initial velocities
 2396:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2397: 
 2398:    // Find the element that is in the direction opposite to the velocity
 2399:    Element* curElem = findElementTowards(toVector2(u_int));
 2400: 
 2401:    // If it starts at a boundary side, we should start with a velocity parallel to the side.
 2402:    if (curElem == nullptr) {
 2403:       // Make velocity parallel to the side
 2404:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2405:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2406:       curElem = otherElem(curElem);
 2407:       
 2408:    }
 2409: 
 2410: 
 2411: 
 2412:    const int MAX_ITERATIONS = 1000; 
 2413:    Element* nextElem = curElem;
 2414:    int iter = 0;
 2415:    while(true) {
 2416: 
 2417:       // Calculate timestep
 2418:       double dtb = min(dtbk, time_rm);
 2419: 
 2420:       // Next point in the backtracking curve
 2421:       Point3 xt = x0 - dtb*u_int;
 2422: 
 2423: 
 2424:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2425:       assert(found && "Backtracking failed in btrack");
 2426: 
 2427:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2428:                       // then time_rm needs to be increased by the unused time.
 2429:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2430: 
 2431:       // The current point becomes the next segment's starting point.
 2432:       x0 = xt;
 2433:  
 2434:       curElem = nextElem;
 2435: 
 2436:       iter++;
 2437:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2438:    }
 2439: 
 2440: 
 2441: }
 2442: 
 2443: 
 2444: 
 2445: // /**
 2446: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2447: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2448: 
 2449: //    Inputs:
 2450: //    @param x1, y1: point inside the element
 2451: //    @param x2, y2: other end of the line segment
 2452: 
 2453: //    Outputs:
 2454: //    @param intersectingSide:  side that intersects the line segment
 2455: //    @param nextElement: element that contains the intersection point
 2456: //    @param xIntersect, yIntersect: intersection point  
 2457: 
 2458: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2459: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2460: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2461: 
 2462: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2463: //    (Delta) being zero.
 2464: 
 2465: //    The intersection point happens when:
 2466: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2467: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2468:    
 2469: //    Assumption: the 4 points (including those of the side segment) are different.
 2470: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2471: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2472: //    If true, (xIntersect,yIntersect) is the intersection.				
 2473: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2474: // **/
 2475: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2476: //                                                          Side& intersectingSide, Element& nextElement,
 2477: //                                                          double& xIntersect, double& yIntersect) {
 2478: //    for (int i = 0; i < i34; i++) {
 2479: //       const double x3 = nodes[i]->x;
 2480: //       const double y3 = nodes[i]->y;
 2481: //       const double x4 = nodes[nxq(i+1)]->x;
 2482: //       const double y4 = nodes[nxq(i+1)]->y;
 2483: 
 2484: //       const Side& side = sides[i];
 2485: 
 2486: //       xIntersect=-1.e25;
 2487: //       yIntersect=-1.e25;
 2488: 
 2489: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2490: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2491: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2492: 
 2493: //       if (delta != 0.0) {
 2494: //          // Solves the two linear equations for tt1 and tt2
 2495: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2496: //          const double tt2 = delta2/delta;
 2497: 
 2498: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2499: //          // Similarly, we use tt2 to compute the intersection point.
 2500: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2501: //             xIntersect = x3 + (x4 - x3)*tt2;
 2502: //             yIntersect = y3 + (y4 - y3)*tt2;
 2503: 
 2504: //             intersectingSide = side;
 2505: //             nextElement = nghbElems[i];
 2506: 
 2507: //             return true;
 2508: //          }
 2509:       
 2510: //       }
 2511: //       else {
 2512: //          // The two segments are parallel
 2513: //          return false;
 2514: //       }
 2515: 
 2516: //    }
 2517: 
 2518: //    return false;
 2519: 
 2520: // }
