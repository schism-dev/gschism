  981: struct Element {
  982: 
  983:    // Geometry information
  984:    int idx;                   // Index of the element
  985:    int16_t i34;               // Number of sides for the element 
  986:    Side *sides[4];            // Sides of the element
  987:    Node *nodes[4];            // Nodes of the element
  988:    Element *nghbElems[4];     // Neighbors of the element
  989: 
  990:    int16_t kb;                // Bottom index of the element
  991:    double area;               // Area of the element
  992:    double ssign[4];           // Sign associated with each side of an element
  993:    double radius;             // Element equivalent radii
  994: 
  995:    Frame<ics> frame;
  996: 
  997:    Vector2 gradPhi[4];        // Derivatives of shape functions
  998:    Vector2 gradEta;           // Gradient of free surface elevation
  999:    Vector2 gradPr;            // Gradient of pressure    
 1000:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
 1001: 
 1002:    bool isDry;                // True if the element is dry
 1003: 
 1004:    Point2 center;            // Element center coordinates (global coordinates)
 1005: 
 1006:    double depth;              // Depth at element (min of all nodes)
 1007:    double z[nvrt];            // z-coord  (local frame - vertical up)
 1008: 
 1009:    // Physical information
 1010:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
 1011: 
 1012:    static const bool isblock = false;              // Always false
 1013: 
 1014:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
 1015:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
 1016: 
 1017:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
 1018:    
 1019: 
 1020:    double vsource;            // Volumetric source/sink term [m^3/s]
 1021: 
 1022:    double rho[nvrt];          // Density at each prism center
 1023:    double rho_mean[nvrt];     // Mean density at each prism center
 1024:    CubicSpline rho_spl;
 1025:    double rho_zz[nvrt];       // Second derivative of density at each prism center
 1026:    double rho_z[nvrt];        // First derivative of density at each prism center
 1027:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
 1028:    
 1029: 
 1030:    __inline__ __device__ Point2 outputCoords(void) const;
 1031: 
 1032:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }  
 1033: 
 1034:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1035:    // If ics == 2, convert the global point to the local frame of the element
 1036:       
 1037:       if constexpr (ics == 1) {
 1038:          return p;
 1039:       } else {
 1040:          const Point3 c = {center.x, center.y, centerZ()};
 1041:          return frame.G2L(p - c);
 1042:       }
 1043:    }
 1044: 
 1045:    __device__ __forceinline__ Point3 toGlobal(Point3 const& p) const {
 1046:    // If ics == 2, convert the local point to a global point
 1047:       
 1048:       if constexpr (ics == 1) {
 1049:          return p;
 1050:       } else {
 1051:          const Point3 c = {center.x, center.y, centerZ()};
 1052:          return c + frame.L2G(p);
 1053:       }
 1054:    }
 1055: 
 1056:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
 1057:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
 1058: 
 1059:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1060:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1061: 
 1062:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
 1063:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
 1064:       // Find the local index of the node in the element (0,1,2,3)
 1065:       int res = __ffs((nodes[0] == node) | 
 1066:                      ((nodes[1] == node) << 1) | 
 1067:                      ((nodes[2] == node) << 2) | 
 1068:                      ((nodes[3] == node) << 3)) - 1;
 1069:       
 1070:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
 1071:       return res;  
 1072:    }
 1073: 
 1074:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
 1075:       // Find the local index of the side in the element (0,1,2,3)
 1076:       int res = __ffs((sides[0] == side) | 
 1077:                      ((sides[1] == side) << 1) | 
 1078:                      ((sides[2] == side) << 2) | 
 1079:                      ((sides[3] == side) << 3)) - 1;
 1080:       
 1081:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
 1082:       return res;
 1083:    }
 1084: 
 1085:    __inline__ __device__ int findLevel(double z1, int k) const {
 1086:       // Starting at index k, find sequentially the level that contains z
 1087: 
 1088:       // For testing purposes, forgets k and performs a full search.
 1089:       for (k = kb; k < nvrt - 1; k++) {
 1090:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1091:       }
 1092:       return nvrt - 2;
 1093: 
 1094: 
 1095:       // if z is already betweeen z[k] and z[k+1], return k
 1096:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
 1097:       else if (z1 <  z[k]) { 
 1098:          // Search for increasing levels
 1099:          for (int kk = k; kk < nvrt - 1; kk++) {
 1100:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1101:          }
 1102:          return nvrt - 1;
 1103:       }
 1104:       else {
 1105:          // Search for decreasing levels
 1106:          for (int kk = k; kk >= kb; kk--) {
 1107:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
 1108:          }
 1109:          return 0;
 1110:       }
 1111:    }
 1112: 
 1113:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
 1114:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
 1115: 
