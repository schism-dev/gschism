 3101: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3102: // Convert shape coordinates to cartesian coordinates
 3103: 
 3104:    if (isTri()) {
 3105:       // Triangular element
 3106: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3107:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3108:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3109:    }
 3110:    else {
 3111:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3112:    }
 3113: 
 3114: }
