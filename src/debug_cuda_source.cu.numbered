 5773:    __global__ void computeBottomDragVegetation(void) {
 5774:       // UNFINISHED. CHECK THIS:
 5775:       // How many kernels are needed? Why so many for loops?
 5776:       // Is the loop on sides needed?
 5777: 
 5778:       NODE(node);
 5779: 
 5780: 
 5781:       const int    kb      = node->kb;
 5782:       const double htot    = node->htot2(); 
 5783:       
 5784:       if (node->isDry) {
 5785:          // Default values for dry nodes
 5786:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5787:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5788: 
 5789:          return;
 5790:        
 5791:       }
 5792: 
 5793:       // Computes bottom drag Cd based on the selected nchi
 5794:       node->computeBottomDragCd();
 5795:       
 5796: 
 5797: 
 5798:       //   Bottom stress in m^2/s^2
 5799:       if (node->rho[kb + 1] >= -98.0)
 5800:       {
 5801:          const double mag_u = length(node->u2[kb + 1]);
 5802:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5803: 
 5804:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5805:          // !sediment erosion: this part needs more documentation
 5806:       }
 5807:     
 5808: 
 5809: 
 5810:       // Compute vegetation parameters
 5811:       //--------------------------------
 5812: 
 5813:       // SAV constants
 5814:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5815:       constexpr double veg_cfpsi = 0.16;
 5816: 
 5817:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5818:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5819: 
 5820:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5821:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5822:          int kbin = 0; // bin index
 5823:          for (int k = kb; k < nvrt; k++) {
 5824:             // Computes node height above the bottom level
 5825:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5826:             assert(false && "Vertical variation of vegetation not implemented");
 5827: 
 5828:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5829:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5830:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5831:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5832:             // } else {
 5833:             //    // Find the bin at which the current vertical level is
 5834:             //    while (kbin<nbins_veg_vert) {
 5835:             //       const double zn = node->z[kbin];
 5836:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5837:             //          break;
 5838:             //       } // if
 5839:             //       kbin++;
 5840:             //    } // while
 5841:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5842: 
 5843:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5844:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5845:                
 5846:             //    // Linear interpolation of the vegetation parameters
 5847:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5848:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5849:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5850:             // } // if rl10
 5851: 
 5852:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5853: 
 5854:          } // for k
 5855: 
 5856: 
 5857:       } else { // Ganthy (iveg==2)
 5858:       //  Modify canopy height, diameter, and density
 5859: 
 5860:          // Make sure there is vegetation on this node
 5861:          if (node->veg_h_unbent > 0.0) {
 5862:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5863: 
 5864:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5865:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5866:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5867: 
 5868:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5869:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5870:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5871:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5872:          } // if veg_h_unbent
 5873: 
 5874:          for (int k = 0; k < nvrt; k++) {
 5875:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5876:          } // for k
 5877:       
 5878: 
 5879:       } // if iveg
 5880:      
 5881: 
 5882:       // Compute vertical mean of veg_alpha3D
 5883:       if (iveg != 0) {
 5884:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5885:          double sum1=0.0;
 5886:          double sum2=0.0;
 5887:          // Integrate over each level under the canopy...
 5888:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5889:             const double Dz = node->Dz(k);
 5890: 
 5891:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5892:             sum2 += Dz;
 5893: 
 5894:          } // for k
 5895:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5896:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5897: 
 5898:       } // if iveg
 5899: 
 5900:    }
 5901: 
 5902:    __global__ void computeVegetationAndDragParameters(void) {
 5903:       // Computes the vegetation and drag model parameters:
 5904:       // chi, \tilde\chi, beta, \breve{H}
 5905:       
 5906:       SIDE(side);
 5907: 
 5908:       side->hhat = 0.0;
 5909:       side->chi2 = 0.0;
 5910:       side->chi = 0.0;
 5911:       side->veg_c2 = 0.0;
 5912:       side->veg_beta = 0.0;
 5913: 
 5914:       if (side->isDry) return;
 5915: 
 5916:       const double htot = side->htot2();
 5917:       const int    kb   = side->kb;
 5918: 
 5919:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5920: 
 5921:       const double veg_h     = side->veg_h();
 5922:       const double veg_nv    = side->veg_nv();
 5923:       const double veg_c     = side->veg_c();
 5924:       const double veg_beta  = side->veg_beta;
 5925:       const double veg_alpha = side->veg_alpha_vert_mean();
 5926: 
 5927:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5928:       // Velocity magnitude at the bottom level
 5929:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5930:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5931:       side->chi2 = side->Cd()*vmag1;
 5932:       side->chi  = side->chi2;
 5933: 
 5934:       if constexpr(iveg != 0) {
 5935:          const Node *n1 = side->n1;
 5936:          const Node *n2 = side->n2;
 5937:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5938:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5939:       }
 5940: 
 5941:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5942: 
 5943:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5944:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5945:       double magUa = 0.0;
 5946:       if constexpr(iveg != 0) {
 5947:          if (side->is3D() && veg_h > 0.0) {
 5948:             // 3D wet side with veg...
 5949: 
 5950:             double magUa = 0.0;
 5951:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5952:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5953: 
 5954:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5955:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5956:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5957: 
 5958:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5959:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5960: 
 5961:                   // Velocity magnitude at the bottom (l) of the level
 5962:                   const double ul = length(side->u2[k]);
 5963: 
 5964:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5965:                   magUa += Dz*0.5*(uh + ul);
 5966: 
 5967:                } // if HasVegetation
 5968:             } // for k
 5969:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5970: 
 5971:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5972:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5973:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5974:                const double zCpy = side->zTopCanopy();
 5975:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5976:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5977:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5978:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5979:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5980:             } // if isSubmerged
 5981:          } // if is3D
 5982:       } // if iveg   
 5983: 
 5984:       // Computes the friction modified depth, \breve{H} in notes
 5985:       if (side->is2D()) { // 2D
 5986: 
 5987:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5988:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5989: 
 5990:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5991: 
 5992:          side->hhat = htot*htot/fricH; 
 5993: 
 5994:       } else { // 3D
 5995:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5996: 
 5997:          if constexpr(iveg != 0) {
 5998:             
 5999:             if (side->isSubmerged()) { 
 6000:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6001:                side->hhat -= veg_c*Hhat_alpha;
 6002: 
 6003:             } else { // Emergent
 6004:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6005:             }
 6006:          } // if iveg
 6007: 
 6008:          // Enforce positivity for 3D model
 6009:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6010:       } // if 3D
 6011: 
 6012:    }
 6013: 
 6014: 
 6015: 
 6016:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6017:    // Computes the density gradient between two elements, e1 and e2.
 6018:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6019:    // zero in the direction normal to the side. 
 6020:    // 
 6021:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6022:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6023:    //
 6024:    // Input:
 6025:    //    e1: Element
 6026:    //    e2: Neighbor element (or nullptr if boundary)
 6027:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6028:    //    k: Index of the half-level at which the density is interpolated
 6029:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6030:    // 
 6031:    // Output:
 6032:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6033:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6034: 
 6035:       if (e2 == nullptr || e2->isDry) {
 6036:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6037: 
 6038:          Side *side = e1->sides[j];
 6039:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6040:                  
 6041:          if constexpr(ics == 1) {
 6042:             vec = side->n; // Normal vector to the side
 6043:          } else {
 6044:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6045:             // IMPLEMENT THIS XXXXXX
 6046:             // !replace with xel, yel?
 6047:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6048:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6049:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6050:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6051:          } //ics
 6052:                    
 6053:          diffRho = 0.0;
 6054: 
 6055:       } else { //internal and wet
 6056:          if constexpr(ics==1) {
 6057:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6058: 
 6059:             // Vector from e1 to e2
 6060:             vec = e2->center - e1->center;
 6061: 
 6062:          } else { 
 6063:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6064:             // Remember that elem->center is in global coordinates
 6065:             // IMPLEMENT THIS XXXXXX
 6066:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6067:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6068:             //                   alow(j)=xctr2
 6069:             //                   bdia(j)=yctr2
 6070:          } // ics
 6071: 
 6072:          diffRho = rho2 - e1->demeanedDensity(k);
 6073:       }
 6074: 
 6075:    }
 6076: 
 6077:    __global__ void computeDensityCubicSplines(void) {
 6078:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6079: 
 6080:       ELEM(elem);
 6081: 
 6082:       if (elem->isDry) return;
 6083: 
 6084:       const int kb = elem->kb;
 6085: 
 6086:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6087:       if (elem->is2D()) {
 6088:          // In the 2D case, the density is constant at the prism level. 
 6089:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6090:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6091:       } else { //3D
 6092: 
 6093:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6094:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6095:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6096:          ///// XXXX CHECK INDICES!!!!!
 6097:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6098:       } // 2D/3D
 6099: 
 6100:    }
 6101: } // extern "C"
 6102: 
 6103: 
 6104: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6105: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6106: 
 6107:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6108: 
 6109:    const int kb  = elem->kb;
 6110:    const int kb2 = elem2->kb;
 6111: 
 6112:    // z-coordinate of prism of elem
 6113:    const double zp = elem->z_prism(k);
 6114: 
 6115:    double rho = 0.0;
 6116: 
 6117:    if (elem2->is2D()) {
 6118:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6119: 
 6120:    } else {  // 3D
 6121: 
 6122:       // eta_min may be < zmax
 6123:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6124:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6125: 
 6126:       // (Extrapolate density below bottom, we will fix it later)
 6127:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6128:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6129:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6130:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6131:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6132:    } // 2D/3D
 6133:      
 6134: 
 6135:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6136:    // Now we need to fix it.
 6137:    if (elem->z[k] < elem2->z[kb2]) {
 6138:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6139: 
 6140:       // There are two methods to adjust the density at the bottom of the element.
 6141:       // iunder_deep=0: 
 6142:       const double depth1 = abs(elem->z[kb]); // larger depth
 6143: 
 6144:       if (iunder_deep==0) {
 6145: 
 6146:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6147: 
 6148:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6149: 
 6150:       } else { // iunder_deep != 0
 6151: 
 6152:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6153: 
 6154:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6155: 
 6156:          //   Demeaned density at the same z coordinate as
 6157:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6158:          }
 6159: 
 6160:       } // if iunder_deep
 6161:    } // if elem->z[kb] < elem2->z[kb]
 6162: 
 6163:    return rho;
 6164: }
 6165: 
 6166: 
 6167: extern "C" {
 6168:    __global__ void computeDensityGradient(void) {
 6169: 
 6170:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6171:       if constexpr(ibc != 0) return;
 6172: 
 6173:          // Compute the horizontal density gradient at each element.
 6174:       // It works in two steps:
 6175:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6176:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6177:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6178:       //             gradRho.r1 = rho1 - rho0
 6179:       //             gradRho.r2 = rho2 - rho0
 6180:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6181:       // 
 6182:       //  NOTE: We use de-meaned densities.
 6183: 
 6184:       ELEM(elem);
 6185: 
 6186:       if (elem->isDry) return;
 6187: 
 6188:       const int kb  = elem->kb;
 6189:       const int i34 = elem->i34;
 6190: 
 6191:       for (int k = kb + 1; k < nvrt; k++) {
 6192:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6193:          //             gradRho.r1 = rho1 - rho0
 6194:          //             gradRho.r2 = rho2 - rho0
 6195:          int icount = 0;
 6196:          double sumRx = 0.0;
 6197:          double sumRy = 0.0;
 6198:          for (int j1=0; j1<i34; j1++) { 
 6199: 
 6200:             const int j2 = elem->nxq(j1 + 1);
 6201: 
 6202:             // Pairs of consecutive neighbor elements of elem
 6203:             const Element *e1 = elem->nghbElems[j1];
 6204:             const Element *e2 = elem->nghbElems[j2];
 6205: 
 6206:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6207:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6208:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6209: 
 6210:             // Compute the density difference and the vector from elem to e1 and e2
 6211:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6212:             double diffRho1, diffRho2;
 6213:             Vector2 vec1, vec2;
 6214:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6215:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6216: 
 6217:             const double rl1 = length(vec1);
 6218:             const double rl2 = length(vec2);
 6219:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6220: 
 6221:             const double delta = cross(vec1, vec2);
 6222:             const double sintheta = abs(delta)/(rl1*rl2);
 6223: 
 6224:             // To avoid problems, avoid elements with small angle between vectors
 6225:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6226:             const bool validEq = (sintheta > sin_one_deg);
 6227: 
 6228:             if (validEq) {
 6229:                // Solve the system of equations to get the density gradient at elem
 6230:                icount++;
 6231:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6232:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6233:                sumRx += Rx;
 6234:                sumRy += Ry;
 6235:             }
 6236:          } // for j1
 6237: 
 6238:          // Compute the average density gradient at elem
 6239:          if (icount==0) {
 6240:            // Bad mesh quality; bail out with 0 b-cc
 6241:            elem->gradRho[k] = {0.0, 0.0};
 6242:          } else {
 6243:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6244:          }
 6245: 
 6246:       } // for k
 6247: 
 6248:    }
 6249: 
 6250:    __global__ void computeBaroclinicTerm(void) {
 6251:    // Computes the baroclinic term at sides (at half levels).
 6252:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6253:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6254: 
 6255:       if (ibc == 1) return;
 6256: 
 6257:       SIDE(side);
 6258: 
 6259:       if (side->isDry) return;
 6260: 
 6261:       const Element *e1 = side->elems[0];
 6262:       const Element *e2 = side->elems[1]; 
 6263:       const int kb = side->kb;
 6264:       
 6265:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6266: 
 6267:       // interpolates vertically the density gradient of the two elements at the half level/
 6268: 
 6269:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6270:       int k2 = max(kb, nvrt / 2);
 6271: 
 6272:       // Starts the integration at the surface and goes down to the bottom
 6273:       side->bcc[nvrt-1] = {0.0, 0.0};
 6274:       for (int k = nvrt - 2; k >= kb; k--) {
 6275:       // For each prism level (from surface to bottom)...
 6276: 
 6277:          // For both elements, interpolate density gradient at the side's half level.
 6278:          // The gradient at the side is the average of the gradients at the elements.
 6279:          // w1, w2 are used to take into account boundary sides, with just one element.
 6280:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6281:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6282:          const double wsum = w1 + w2;
 6283:          w1 = w1/wsum;
 6284:          w2 = w2/wsum;
 6285:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6286: 
 6287:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6288:          Vector2 gradRho = {0.0, 0.0};
 6289:          if (e1 != nullptr && k > kb) {
 6290:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6291:             
 6292:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6293:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6294:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6295: 
 6296:             // Grad(rho) vertically interpolated at the side's half level
 6297:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6298: 
 6299:             // Projects the element density gradient to the side frame if needed.
 6300:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6301: 
 6302:             // Adds the contribution of the density gradient at the side's half level
 6303:             gradRho += gradRho1*w1;
 6304:          }      
 6305:          if (e2 != nullptr && k > kb) {
 6306:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6307:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6308:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6309:             
 6310:             // Grad(rho) vertically interpolated at the side's half level
 6311:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6312: 
 6313:             // Projects the element density gradient to the side frame if needed.
 6314:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6315: 
 6316:             // Adds the contribution of the density gradient at the side's half level
 6317:             gradRho += gradRho2*w2;
 6318:          }
 6319: 
 6320:          
 6321:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6322:          // multiplied by -rampbc*(g/rho0) 
 6323:          const double grav3 = side->grav3();
 6324:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6325: 
 6326:       } // for
 6327: 
 6328:    }
 6329: 
 6330: 
 6331: 
 6332:    __global__ void computeHorGradientAtSide(void) {
 6333: 
 6334:       // Compute the horizontal density gradient at each element.
 6335:       // It works in two steps:
 6336:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6337:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6338:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6339:       //             gradRho.r1 = rho1 - rho0
 6340:       //             gradRho.r2 = rho2 - rho0
 6341:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6342:       // 
 6343:       //  NOTE: We use de-meaned densities.
 6344: 
 6345:       SIDE(side);
 6346: 
 6347: 
 6348:       if (side->isDry) return;
 6349: 
 6350:       // Computes the gradient of the variables at the side center.
 6351:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6352:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6353:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6354: 
 6355:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6356:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6357:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6358:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6359: 
 6360:    }
 6361: 
 6362: 
 6363:    __global__ void solveMomentumEquations(double time) {
 6364: 
 6365:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6366:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6367: 
 6368:       SIDE(side);
 6369: 
 6370:       if (side->isDry) 
 6371:       {
 6372:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6373: 
 6374:          return;
 6375:       }
 6376: 
 6377:       const Node *n1 = side->n1;
 6378:       const Node *n2 = side->n2;
 6379: 
 6380:       const int kb = side->kb;
 6381: 
 6382:       const double veg_h = side->veg_h();
 6383:       const double grav3 = side->grav3();
 6384: 
 6385:       if (side->is2D()) {
 6386:          // Remember: Do not use htot2, which is updated.
 6387:          const double htot = side->htot1();
 6388:          const double hhat = side->hhat;
 6389: 
 6390:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6391: 
 6392:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6393:          const Vector2 tau2 = side->tau();
 6394: 
 6395:          // hat_gam has units of m/s
 6396: 
 6397:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6398:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6399:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6400: 
 6401:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6402: 
 6403: 
 6404:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6405: 
 6406:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6407: 
 6408:       }
 6409:       else { // 3D
 6410: 
 6411:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6412:          // 
 6413:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6414:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6415:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6416:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6417:          // k+1 and k.
 6418: 
 6419: 
 6420:          const int ndim = nvrt - kb;
 6421:          const double zTopCanopy = side->zTopCanopy();
 6422: 
 6423:          // Initialize the tridiagonal system
 6424:          for (int k = kb + 1; k < nvrt; k++) {
 6425:             
 6426:             const int kin = k - (kb + 1);
 6427: 
 6428:             // Vertical viscosity at the face center
 6429:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6430: 
 6431:  
 6432:             alow[kin] = 0.0;
 6433:             cupp[kin] = 0.0;
 6434:             bdia[kin] = 0.0;
 6435: 
 6436:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6437:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6438: 
 6439:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6440:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6441:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6442: 
 6443:             // First part: layers k, k+1
 6444:             if (k < nvrt - 1) {
 6445:                              
 6446:                if constexpr(iveg != 0) {
 6447: 
 6448:                   // If there is vegetation at this level...
 6449:                   if (zTopCanopy > side->zc[k]) {
 6450:                      // If the canopy is above the k layer...
 6451:                      
 6452:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6453:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6454:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6455:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6456: 
 6457:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6458:                      const double vmag2 = length(ut2);
 6459:                      const double vmag1 = length(side->u2[k]);
 6460:                      const double vmag = 0.5*(vmag1 + vmag2);
 6461:                      
 6462:                      // Computes the vegetation alpha at the face center
 6463:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6464: 
 6465:                      cff1 += veg_alpha_sd*dt*vmag;
 6466: 
 6467:                   } // if (zTopCanopy
 6468:                } // if iveg
 6469: 
 6470:                const double dzz = side->Dz(k + 1);
 6471:                const double tmp = dt*dfz/dzz;
 6472:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6473: 
 6474:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6475:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6476:             }
 6477: 
 6478: 
 6479:             // Second part: layers k-1, k
 6480:             if (k > kb + 1) {
 6481: 
 6482:                double cff1 = 1.0; //init \bar{c^k}
 6483: 
 6484:                if constexpr(iveg != 0) {
 6485:                   // If there is vegetation at this level...
 6486:                   if (zTopCanopy > side->zc[k-1]) {
 6487:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6488:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6489: 
 6490:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6491: 
 6492:                      const double vmag2 = length(ut2);
 6493:                      const double vmag1 = length(side->u2[k-1]);
 6494:                      const double vmag = 0.5*(vmag1 + vmag2);
 6495: 
 6496:                      // Computes the vegetation alpha at the face center
 6497:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6498:                      cff1 += veg_alpha_sd*dt*vmag;
 6499:                   } // if zTopCanopy
 6500: 
 6501:                } // if iveg
 6502: 
 6503:                const double dzz = side->Dz(k);
 6504:                const double tmp = dt*dfz/dzz;
 6505:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6506: 
 6507:                alow[kin] += cff1*dzz/6.0 - tmp;
 6508:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6509: 
 6510:             } else { // Bottom boundary
 6511:                // This occurs at the bottom, where the bottom drag is applied.
 6512: 
 6513:                bdia[kin] += dt*side->chi2; // XXXX
 6514: 
 6515:             } // if (k > kb + 1)
 6516: 
 6517: 
 6518:          } // for (int k
 6519: 
 6520: 
 6521: 
 6522:          // Computes the RHS.
 6523:          // -----------------
 6524: 
 6525:          //	BC to be imposed at the end.
 6526: 
 6527:          const Vector2 gradETP  = side->gradETP;
 6528:          const Vector2 gradPr   = side->gradPr;
 6529:          const Vector2 gradEta1 = side->gradEta1;
 6530:          const Vector2 gradEta2 = side->gradEta2;
 6531: 
 6532:          const Vector2 *btu = side->btu;
 6533:          const Vector2 *u2  = side->u2;
 6534:          const double coriolis = side->coriolis;
 6535:          const Vector2 *nuGradU = side->nuGradU;
 6536: 
 6537:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6538:          for (int k = kb + 1; k < nvrt; k++) {
 6539:             const int kin = k - kb - 1;
 6540: 
 6541:             const double dz_0 = side->Dz(k);
 6542:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6543: 
 6544:             rrhs[kin] = {0.0, 0.0};
 6545:             double dz = 0.0;
 6546: 
 6547:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6548:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6549:             if (k < nvrt  ) dz += dz_1;
 6550:             if (k > kb + 1) dz += dz_0;
 6551: 
 6552:             // Elevation gradient, atmospheric pressure and tidal potential
 6553:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6554: 
 6555:             // Coriolis, advection, wind stress, and horizontal viscosity
 6556:             if (k < nvrt - 1) {
 6557: 
 6558: 
 6559:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6560:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6561:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6562:                                                 
 6563: 
 6564:                //diff stress tensors 1006
 6565:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6566:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6567:                   assert(false && "Not implemented: itur == 5");
 6568:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6569:                }
 6570:                // else assert(false && "itur # Not implemented");
 6571: 
 6572:             } else { // k == nvrt - 1 SURFACE
 6573:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6574:                const Vector2 tau2 = side->tau();
 6575: 
 6576:                rrhs[kin] += dt*tau2;          
 6577: 
 6578:             } // if k<nvrt
 6579: 
 6580: 
 6581:             if (k > kb + 1) {
 6582:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6583:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6584:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6585: 
 6586:                // diff stress tensors 1006
 6587:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6588:                   assert(false && "Not implemented: itur == 5");
 6589:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6590:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6591:                }
 6592:                // else assert(false && "itur # Not implemented");
 6593: 
 6594: 
 6595:             } // if k>kbs + 1
 6596: 
 6597:             // Baroclinic
 6598:             Vector2 *bcc = side->bcc;
 6599:             if constexpr(ibc == 0) {
 6600:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6601:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6602: 
 6603:             } // if ibc==0
 6604: 
 6605:          } // k=kb + 1,nvrt
 6606: 
 6607: 
 6608:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6609: 
 6610:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6611:             const int kin = k - kb - 1;
 6612:    
 6613:             // Velocity is always clamped to maximum values
 6614:             side->u2[k] = clampVelocity(soln[kin]);
 6615:          } // k
 6616: 
 6617:       } // if side->is2D()
 6618:       
 6619: 
 6620:       // Impose velocity boundary condition at the bottom
 6621:       if constexpr(imm == 2) { // 3D bed deformation model
 6622:          double dep;
 6623:          Vector2 vel;
 6624: 
 6625:          assert(false && "Not implemented: imm == 2");
 6626:          //update_bdef(time, x0, y0, dep, vel);
 6627:          // side->u2[kb] = vel;
 6628: 
 6629:       } else { // imm = 0 or 1
 6630:          if (side->Cd() == 0.0) {
 6631:             side->u2[kb] = side->u2[kb + 1];
 6632: 
 6633:          } else if (side->is3D()) { // 3D no slip bottom   
 6634:             side->u2[kb] = {0.0, 0.0};
 6635: 
 6636:          }
 6637:           
 6638:       } // if imm
 6639: 
 6640:       // The velocities below the bottom level are set to zero
 6641:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6642: 
 6643: 
 6644:    }
 6645: 
 6646: 
 6647:    __global__ void applyMomentumBC(void) {
 6648: 
 6649:       SIDE_BND(sideBnd);
 6650: 
 6651:       Side *side = sideBnd->side;
 6652:       const BoundarySegment *segment = sideBnd->segment;
 6653:       const Node *n1 = side->n1;
 6654:       const Node *n2 = side->n2;
 6655: 
 6656:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6657: 
 6658:       const bool isLand = segment->isLand;
 6659:       const int ifltype = segment->ifltype;
 6660: 
 6661:       const int kb = side->kb;
 6662: 
 6663: 
 6664:       if (!isLand && ifltype != 0) {
 6665:          const Vector2 *ubc = sideBnd->ubc;
 6666:   
 6667:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6668:             
 6669:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6670:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6671: 
 6672:             if (ifltype == -1) {
 6673:                // Flather 1
 6674: 
 6675:                const double depth = side->depth();
 6676: 
 6677:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6678: 
 6679:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6680: 
 6681:                side->u2[k] = vnorm*side->n;
 6682: 
 6683:             } else if (ifltype == -2) { // Discharge
 6684: 
 6685:                const double eta1 = side->eta1();
 6686:                const double eta2 = side->eta2();
 6687:                const double htot = side->htot2();
 6688: 
 6689:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6690:                assert(false && "Not implemented: Discharge bc");
 6691:                // const double dischrg = discharge(eta1);
 6692:                const double dischrg = 0.0; // XXX REMOVE
 6693:                
 6694: 
 6695:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6696: 
 6697:                const double vnorm = dischrg*eta2/htot;
 6698: 
 6699:                side->u2[k] = vnorm*side->n;
 6700: 
 6701:             }
 6702:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6703:                const double vnorm = dot(side->u2[k], side->n);
 6704: 
 6705:                double rat;
 6706:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6707:                else              rat = segment->vobc2; // outgoing
 6708: 
 6709:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6710: 
 6711:             }
 6712:             else { // not Flather or 3D radiation
 6713:                side->u2[k] = ubc[k];
 6714: 
 6715:             } // if (segment->ifltype...
 6716: 
 6717:          }
 6718: 
 6719:       }
 6720:       else if (isLand) { // if it is land boundary side
 6721: 
 6722:          if constexpr(islip == 0) { // free slip
 6723: 
 6724:             for (int k = kb; k < nvrt; k++) {
 6725: 
 6726:                const Vector2 t = side->t();
 6727:                const Vector2 n = side->n;
 6728: 
 6729:                double vnorm = 0.0; // for most cases
 6730:                const double vtan = dot(side->u2[k], t);
 6731:                
 6732:                side->u2[k] = vtan*t - vnorm*n;
 6733: 
 6734:             }
 6735: 
 6736:          } else { // no slip
 6737:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6738: 
 6739:          }
 6740:       } // if (side segment type...
 6741: 
 6742:    }
 6743: 
 6744: 
 6745:    __global__ void shapiroFilter1(void) {
 6746:       // First step of the Shapiro filter (normally used if indvel<=0)
 6747:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6748: 
 6749:       SIDE(side);
 6750: 
 6751:       // Only internal wet sides are processed
 6752:       if (side->isDry || !(side->isInternal())) return;
 6753: 
 6754:       const int kb = side->kb;
 6755: 
 6756:       for (int mm = 0; mm < niter_shap; mm++) {
 6757: 
 6758:          for (int k = kb + 1; k < nvrt; k++) {
 6759:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6760:             Vector2 suru = {0.0, 0.0};
 6761: 
 6762:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6763: 
 6764:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6765: 
 6766:                int kin = k;
 6767:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6768:                
 6769:                // Get the velocity at the neighbor's side.
 6770:                Vector2 nSideU2 = nSide->u2[kin];
 6771: 
 6772:                // Projects the velocity to the current side frame if needed.
 6773:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6774: 
 6775:                suru += nSideU2;
 6776:             }
 6777: 
 6778:             // Reusing bcc as a temporary array to store the suru values.
 6779:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6780: 
 6781:          }
 6782:       }
 6783:    }
 6784: 
 6785:    __global__ void shapiroFilter2(void) {
 6786:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6787: 
 6788:       SIDE(side);
 6789: 
 6790: 
 6791:       if (side->isDry || !(side->isInternal())) return;
 6792: 
 6793:       const int kb = side->kb;
 6794: 
 6795:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6796: 
 6797:       if (side->is2D()) {
 6798:          side->u2[kb + 1] = side->bcc[kb + 1];
 6799:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6800: 
 6801:       } else {
 6802:          // 3D
 6803:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6804:          
 6805:       }
 6806: 
 6807:    }
 6808: 
 6809: 
 6810:    __global__ void ul0UpdateZCoords(void) {
 6811:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6812:       
 6813:       NODE(node);      
 6814: 
 6815: 
 6816:       if (false) { //node->isDry) { XXXXXXX
 6817: 
 6818:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6819: 
 6820:          if constexpr(ivcor != 1) node->kb = 0;
 6821: 
 6822:       } else {
 6823: 
 6824:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6825:          node->updateKb();
 6826: 
 6827:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6828: 
 6829:       }
 6830: 
 6831:       // We use the temp.b field to store the previous state of isDry.
 6832:       node->tmp.b = node->isDry;
 6833: 
 6834:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6835:       node->isDry = true;
 6836: 
 6837:    }
 6838: 
 6839:    __global__ void ul0ComputeDryElements(void)
 6840:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6841:    {
 6842:       ELEM(elem);
 6843: 
 6844:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6845: 
 6846:       elem->kb = 0;
 6847: 
 6848:       if (elem->isDry) return;
 6849: 
 6850: 
 6851:    //    if(elem->isDry2()) { // XXXX
 6852:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6853:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6854:    //        call parallel_abort(errmsg)
 6855:    //    }
 6856: 
 6857:       const Node *n1 = elem->nodes[0];
 6858:       const Node *n2 = elem->nodes[1];
 6859:       const Node *n3 = elem->nodes[2];  
 6860:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6861: 
 6862:       // Computes element's kb as the minimum of the nodes' kb.
 6863:       const int kb1 = n1->kb;
 6864:       const int kb2 = n2->kb;
 6865:       const int kb3 = n3->kb;
 6866:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6867: 
 6868: 
 6869:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6870: 
 6871: 
 6872:       // Computes the element z as the mean of the nodes z.
 6873:       for (int k = elem->kb; k < nvrt; k++) {
 6874: 
 6875:          // Compute the element z as the mean of the nodes z.
 6876:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6877:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6878:          elem->z[k] /= elem->i34;
 6879: 
 6880:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6881:       }
 6882:                   
 6883:    }
 6884: 
 6885:    __global__ void ul0ComputeDryNodes(void)
 6886:    // Updates node's isDry based on the elements' isDry. 
 6887:    {
 6888:       NODE(node);
 6889: 
 6890:       node->isDry = true;
 6891: 
 6892:       // A node is wet if at least one of the elements sharing it is wet.
 6893:       for (int j = 0; j < node->numElements; j++) {
 6894:          const Element *elem = node->elements[j];
 6895:          if (!elem->isDry) {
 6896:             node->isDry = false;
 6897:             break;
 6898:          }
 6899:       }
 6900: 
 6901:        
 6902:    }
 6903: 
 6904: 
 6905:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6906:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6907:    // node->tmp.b is true if the node was previously dry.
 6908:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6909:    {
 6910:       NODE(node);
 6911:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6912: 
 6913:       // Avoid this the first time step.
 6914:       if (it == iths) return;  
 6915: 
 6916:       const bool wasDry = node->tmp.b;
 6917: 
 6918: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6919: 
 6920:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6921: 
 6922:          for (int k=0; k < nvrt; k++) {
 6923: 
 6924:             Vector3 utmp={0.0, 0.0, 0.0};
 6925: 
 6926:             double ttmp=0.0;
 6927:             double stmp=0.0;
 6928:             int icount=0;
 6929:             for (int j = 0; j < node->numNodes; j++) {
 6930: 
 6931:                const Node *nbrNode = node->nodes[j];
 6932:                
 6933:                const bool wasNbrDry = nbrNode->tmp.b;
 6934: 
 6935:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6936:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6937: 
 6938:                   icount++;
 6939: 
 6940:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6941:                   utmp += nbrNode->uvw2(k);
 6942:                   
 6943:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6944:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6945:                }
 6946:             }
 6947: 
 6948:             if (icount > 0) {
 6949:                const double inv_icount = 1.0/icount;
 6950:                utmp = inv_icount*utmp;
 6951:                node->u2[k]     = {utmp.x, utmp.y};
 6952:                node->w2[k]     = utmp.z;
 6953:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6954:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6955:             } else {
 6956:                node->u2[k] = {0.0, 0.0};
 6957:                node->w2[k] = 0.0;
 6958:                // Initialize tracers to 0.0??? XXXXX
 6959:             }
 6960:          }
 6961:       }
 6962:    }
 6963: 
 6964:   
 6965:    
 6966: 
 6967: 
 6968:    __global__ void ul0UpdateSides(int it, int iths) {
 6969:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6970:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6971:    // The dryness of the sides is updated in ul0UpdateSides2.
 6972: 
 6973:       SIDE(side);
 6974: 
 6975:       // A side is wet if and only if at least one of its elements is wet.
 6976:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6977:  
 6978:       const Node *n1 = side->n1;
 6979:       const Node *n2 = side->n2;
 6980:      
 6981:       const int kb1 = n1->kb;
 6982:       const int kb2 = n2->kb;
 6983: 
 6984:       side->kb = 0; // default when dry
 6985: 
 6986:       if (isWet) {
 6987: 
 6988:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6989: 
 6990:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6991: 
 6992:          side->kb = min(kb1, kb2);
 6993: 
 6994:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6995: 
 6996:          for (int k = side->kb; k < nvrt; k++) {
 6997:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6998: 
 6999:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7000: 
 7001:             // Compute velocity for re-wetted sides 
 7002:             if ((it != iths) && (side->isDry && isWet)) {
 7003: 
 7004:                Vector2 utmp={0.0, 0.0};
 7005: 
 7006:                int icount=0;
 7007: 
 7008:                // For all the sides on the two elements that share this side
 7009:                for (int j = 0; j < 2; j++) {
 7010:                   const Element *elem = side->elems[j];
 7011:                   if (elem == nullptr) continue;
 7012: 
 7013:                   for (int jj=0; jj < elem->i34; jj++) {
 7014:                      const Side *nSide = elem->sides[jj];
 7015:                      if (nSide->isDry) continue;
 7016: 
 7017:                      icount++;
 7018:                      utmp += nSide->u2[k];  
 7019:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7020:                   }
 7021:                }
 7022:                   
 7023:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7024:                if (icount > 0)  side->u2[k] = utmp/icount;
 7025:                else             side->u2[k] = {0.0, 0.0};
 7026:                   
 7027:             } // if ((it != iths) && (side->isDry && isWet))
 7028: 
 7029:          } // for k
 7030: 
 7031:       } // if isWet 
 7032:       
 7033: 
 7034: 
 7035:    }
 7036: 
 7037:    __global__ void ul0UpdateSides2(void) {
 7038:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7039:    
 7040:          SIDE(side);
 7041:    
 7042:          const Element *e1 = side->elems[0];
 7043:          const Element *e2 = side->elems[1];
 7044: 
 7045:          // A side is wet if and only if at least one of its elements is wet.
 7046:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7047: 
 7048:          // Update the side's dryness
 7049:          side->isDry = !isWet;
 7050: 
 7051:    }
 7052: 
 7053: 
 7054:    __global__ void zeroNodalVelocities(void) {
 7055:       NODE(node);
 7056: 
 7057:       for (int k = 0; k < nvrt; k++) {
 7058:          node->u2[k]   = {0.0, 0.0};
 7059:          node->w2[k]   = 0.0;
 7060:          node->utmp[k] = {0.0, 0.0};         
 7061:       }
 7062:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7063:    }
 7064:  
 7065: 
 7066:    __global__ void computeNodalVerticalVelocities1(void) {
 7067:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7068:    // Adds the element's vertical velocity times the element's area.
 7069:       ELEM(elem);
 7070: 
 7071:       for (int j = 0; j < elem->i34; j++) {
 7072:          Node *node = elem->nodes[j];
 7073: 
 7074:          for (int k = node->kb; k < nvrt; k++) {
 7075:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7076:          }
 7077:          atomicAdd(&(node->tmp.d), elem->area);
 7078:       }
 7079:    }
 7080: 
 7081:    __global__ void computeNodalVerticalVelocities2(void) {
 7082:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7083:    // Divides by the total area of the elements sharing the    node.
 7084:       NODE(node);
 7085: 
 7086: 
 7087:       const double invArea = 1.0 / node->tmp.d;
 7088:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7089: 
 7090:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7091:    }
 7092: 
 7093: 
 7094:    __global__ void computeNodalHorizontalVelocities1(void) {
 7095: 
 7096:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7097: 
 7098:       ELEM(elem);
 7099: 
 7100:       if (elem->isDry) return;
 7101: 
 7102:       const int kb = elem->kb;
 7103:       const bool isTri = elem->isTri();
 7104: 
 7105:       if constexpr(indvel <= 0) {
 7106:          // Assuming discontinous hvel.
 7107: 
 7108:          if (isTri) { // For triangles
 7109:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7110:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7111:             #pragma unroll
 7112:             for (int j = 0; j < 3; j++) {
 7113:                // For every node of the triangle...
 7114:                Node *node = elem->nodes[j];
 7115: 
 7116:                if (node->isDry) continue;
 7117: 
 7118:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7119:                const Side *s2 = elem->sides[(j + 1) % 3];
 7120:                const Side *s3 = elem->sides[(j + 2) % 3];
 7121: 
 7122:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7123: 
 7124:                atomicAdd(&(node->tmp.i), 1);
 7125: 
 7126:                for (int k = kb; k < nvrt; k++)  {
 7127:                   Vector2 s1u2 = s1->u2[k];
 7128:                   Vector2 s2u2 = s2->u2[k];
 7129:                   Vector2 s3u2 = s3->u2[k];
 7130: 
 7131:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7132:                   if constexpr(ics == 2) {
 7133:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7134:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7135:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7136:                   }
 7137: 
 7138:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7139:                   u = clampVelocity(u);
 7140:                   atomicAdd(&(node->utmp[k].x), u.x);
 7141:                   atomicAdd(&(node->utmp[k].y), u.y);
 7142: 
 7143:                }
 7144: 
 7145:             }
 7146:          }
 7147:          else { // For quads
 7148: 
 7149: 
 7150:             // Compute the bilinear coordinates of the center of each diagonal.
 7151:             double xi, eta;
 7152:             double shp13[4], shp24[4];
 7153:             Point2 x0, x1, x2, x3;
 7154:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7155:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7156:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7157: 
 7158:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7159:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7160: 
 7161: 
 7162: 
 7163: 
 7164:             for (int k = kb; k < nvrt; k++) {
 7165: 
 7166:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7167:                Vector2 sideU[4];
 7168:                #pragma unroll
 7169:                for (int j = 0; j < 4; j++) {
 7170:                   Vector2 u = elem->sides[j]->u2[k];
 7171:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7172:                   sideU[j] = u;
 7173:                }
 7174: 
 7175:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7176:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7177: 
 7178:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7179:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7180:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7181:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7182:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7183:                #pragma unroll
 7184:                for (int j = 0; j < 4; j++) {
 7185:                   Node *node = elem->nodes[j];
 7186:                   if (node->isDry) continue;
 7187: 
 7188:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7189:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7190:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7191:                }
 7192:             }
 7193: 
 7194:          }
 7195: 
 7196:       }
 7197:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7198:       
 7199:    }
 7200: 
 7201: 
 7202:    __global__ void computeNodalHorizontalVelocities2(void) {
 7203:       NODE(node);
 7204: 
 7205:       const int nodeCount = node->tmp.i;
 7206: 
 7207:       if (nodeCount == 0) 
 7208:       {
 7209:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7210:          return;
 7211:       }
 7212: 
 7213:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7214:       
 7215:       const int kb = node->kb;
 7216: 
 7217:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7218:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7219:       
 7220:       
 7221:    }   
 7222: 
 7223:  
 7224: 
 7225:    __global__ void resetVelocityOpenBndNodes(void) {
 7226:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7227: 
 7228:       NODE_BND(nodebnd);
 7229: printf("DDDDDDDDDD\n");  // XXXXXXX
 7230:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7231:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7232:       }
 7233: 
 7234:    }
 7235: 
 7236: 
 7237:    __global__ void setVelocityOpenBndNodes(void) {
 7238:    // For open boundary nodes sets their velocity to the imposed values.
 7239: 
 7240:       SIDE_BND(sidebnd);
 7241: 
 7242:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7243:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7244:          // to its segment to the average of the side velocity.
 7245: 
 7246:          for (int k = 0; k < nvrt; k++) {
 7247:             Node *n1 = sidebnd->side->n1;
 7248:             Node *n2 = sidebnd->side->n2;
 7249: 
 7250: 
 7251:             Vector2 n1_u2(n1->u2[k]);
 7252:             Vector2 n2_u2(n2->u2[k]);
 7253: 
 7254:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7255:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7256:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7257:             }
 7258:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7259:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7260:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7261:             }
 7262: 
 7263:          }
 7264: 
 7265:       }
 7266: 
 7267:    }
 7268: 
 7269: 
 7270:    __global__ void computeVerticalVelocity(void) {
 7271:       // Computes the vertical velocity at the (2D) element's centroid.
 7272:       // In this function we will be considering volumetric elements, with side faces and a 
 7273:       // bottom and a top face. We will call them SFs, BF and TF.
 7274:       // It computes the flux coming from BF and the SFs.
 7275:       // If the bed is moving, it takes that into account.
 7276:       // Since water is incompressible, the integral of the velocity times the normal vector
 7277:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7278:       // and the BF is equal to the flux going out from the TF.
 7279:       // TF = - BF - sum(SFs).
 7280:       // It then computes the horizontal velocity at the center of TF.
 7281:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7282:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7283:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7284: 
 7285:       ELEM(elem);
 7286: 
 7287:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7288: 
 7289:       if (elem->isDry) return;
 7290: 
 7291:       const int kb = elem->kb;
 7292:       const bool isTri = elem->isTri();
 7293: 
 7294:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7295: 
 7296:       // Compute the bottom velocity
 7297:       if constexpr(imm != 0) {
 7298:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7299:       }
 7300: 
 7301: 
 7302:       double bottomArea3D;
 7303:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7304: 
 7305:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7306: 
 7307:       double topArea3D;
 7308: 
 7309:       // Bottom face flux
 7310:       double bottomFlux = 0.0;
 7311:       Vector2 u2meanBottom = {0.0, 0.0};
 7312:       const Vector2 gradh = elem->grad2(&Node::depth);
 7313:       if constexpr(imm==2) {
 7314:          Vector3 ubed;
 7315: 
 7316:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7317:          // updateBDEF(ubed);
 7318:      
 7319:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7320: 
 7321:          // elem->w[kb] += ubed.z;
 7322:       }
 7323:       else {
 7324: 
 7325:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7326:   
 7327:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7328:          // in the direction of motion.
 7329:          const double bottomW = - dot(gradh, u2meanBottom);  
 7330:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7331: 
 7332:          // VElocity associated to the bed deformation
 7333:          double bedVelocity = 0.0;
 7334:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7335: 
 7336:          elem->w[kb] = bedVelocity + bottomW; 
 7337: 
 7338:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7339:          
 7340:       } // if imm
 7341: 
 7342:       // Compute w for kb+1 to nvrt-1
 7343:       for (int l = kb; l < nvrt - 1; l++) {
 7344: 
 7345:          // normal vector to the top face of the "volumetric" element (3D)
 7346:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7347: 
 7348:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7349:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7350: 
 7351:          // Compute the total flux at the sides
 7352:          double sideFlux = 0.0;
 7353: 
 7354:          for (int j = 0; j < elem->i34; j++) {
 7355:             const Side *side = elem->sides[j];
 7356:             const int kbs = side->kb;
 7357:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7358:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7359:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7360: 
 7361:             // The area is "clamped" meaning that it takes kb into account.
 7362:             const double sideArea = side->areaClamped(l);
 7363: 
 7364:             const double sign = elem->ssign[j]; 
 7365: 
 7366:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7367:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7368:          }
 7369:          
 7370:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7371:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7372:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7373: 
 7374:          // The flux at the top ace can be computed from the other flows.
 7375:          // All fluxes are in directions into the prism.
 7376:          const double topFlux = - sideFlux - bottomFlux;
 7377: 
 7378:          // Flux at the top face due to the horizontal velocities only
 7379:          // topFlux = topHorizontalFlux + topVerticalFlux
 7380:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7381: 
 7382:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7383:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7384: 
 7385:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7386: 
 7387:          bottomFlux = -topFlux;
 7388:          
 7389:       }
 7390: 
 7391:    }  
 7392: 
 7393: 
 7394: 
 7395: 
 7396: 
 7397: 
 7398: 
 7399: // !===============================================================================
 7400: // !===============================================================================
 7401: 
 7402: } // extern "C"
 7403: 
 7404: #ifdef DONTCOMPILE
 7405: __device__ void computeVerticalAdvection(void) {
 7406:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7407: 
 7408:    sdbt(1:2,:,:)=0.d0
 7409: 
 7410:    const Side *side = FROM kernel;
 7411: 
 7412:    if(side->isDry) return;
 7413: 
 7414:    // If side is wet...
 7415: 
 7416: 
 7417:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7418:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7419:    double ws[nvrt] = {} // w @ side
 7420:    int icount = 0;
 7421:    for (int j=0; j<2; j++) {
 7422:       const Element *elem = side->elements[j];
 7423:        
 7424:       if(elem != nullptr) {
 7425:          icount++;
 7426:          for (int k=0; k<nvrt; k++) {
 7427:             ws[k] = ws[k] + elem->w[k];
 7428:          }
 7429:       }
 7430:    }  // for j
 7431: 
 7432:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7433:    ws = ws/icount;
 7434: 
 7435:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7436:    // Splines allow for a smooth transition between vertical levels.
 7437:    // Splines have continuity restrictions at the internal knots, but
 7438:    // we have to provide the 1st derivatives at the endpoints.
 7439:    const int kbs = side->kbs; 
 7440:    
 7441:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7442:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7443:    initCubicSpline(kbs, nvrt, side, ws, up)
 7444: 
 7445:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7446:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7447:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7448: 
 7449:    // Total advection (average onto side)
 7450:    const Node *node1 = side->nodes[0];
 7451:    const Node *node2 = side->nodes[1];
 7452:    for (int k=kbs(i); k<nvrt; k++) {
 7453: 
 7454:       Vector2 bcc1 = node1->bcc[k];
 7455:       Vector2 bcc2 = node2->bcc[k];
 7456:       if constexpr(ics == 2) {
 7457:          // Project the velocities from the node frames to the side frame
 7458:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7459:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7460:       }
 7461: 
 7462:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7463:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7464: 
 7465:    }
 7466: }
 7467: #endif
 7468: 
 7469: 
 7470: extern "C" {
 7471:    __global__ void computeElemAverageGhat(void) {
 7472:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7473: 
 7474:       ELEM(elem);
 7475:       
 7476:       elem->ghat1= {0.0, 0.0};  
 7477: 
 7478:       if constexpr(ihydraulics != 0) {
 7479:          if (nhtblocks > 0 && elem->isblock) return;
 7480:       }
 7481: 
 7482:       
 7483:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7484:       // cff1-3: coefficients for 2D/3D
 7485: 
 7486:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7487:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7488:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7489: 
 7490:       if (elem->isDry) return;
 7491: 
 7492:       // Average of the coefficients
 7493:       double av_cff1 = 0.0;  // av. for cff1
 7494:       double av_cff2 = 0.0;  // av. for cff2
 7495:       double av_cff3 = 0.0;  // av. for cff3
 7496:       double av_df = 0.0;  // av. for H^\alpha / H
 7497:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7498:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7499: 
 7500:       const int i34 = elem->i34;
 7501:       const int kb  = elem->kb;
 7502: 
 7503:       for (int j=0; j<i34; j++) {
 7504:          // For each node and side in the element...
 7505: 
 7506:          const Node *node = elem->nodes[j];
 7507:          const Side *side = elem->sides[j];
 7508: 
 7509:          const double chi      = side->chi;
 7510:          const double veg_c2   = side->veg_c2;
 7511:          const double veg_beta = side->veg_beta;
 7512:          const double veg_h    = side->veg_h();
 7513:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7514: 
 7515:          const Vector2 gradPhi = elem->gradPhi[j];
 7516: 
 7517:          // Node - const in elem
 7518:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7519:          elem->gradPr  += node->pr  *gradPhi;
 7520: 
 7521:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7522: 
 7523:         
 7524:          const double htot  = side->htot2();        // Total depth at the side
 7525:          const double zctr2 = side->zTopCanopy();  
 7526: 
 7527:          double cff1; 
 7528:          double cff2; 
 7529:          double cff3;   
 7530:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7531:          // coefficients applied to 2D/3D case 
 7532:             cff1 = side->hhat/htot;
 7533:             cff2 = 0.0;
 7534:             cff3 = 0.0;
 7535:          } else { //3D
 7536:             //Init for no-veg case
 7537:             cff1 = 1.0;
 7538:             cff2 = 1.0;
 7539:             cff3 = 0.0;
 7540: 
 7541:             if constexpr(iveg != 0) {
 7542:                // Computes coefficients used with vegetation terms G1, G2
 7543:                // cff1, cff3 are used for the first two terms in G1, G2:
 7544:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7545:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7546:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7547:                if(veg_h < 0.99*htot) { // submergent vegetation
 7548:                   cff1 = 1.0;
 7549:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7550:                   cff3 = veg_c;
 7551: 
 7552:                } else { // emergent vegetation
 7553:                   cff1 = 1.0/(1.0 + veg_c2);
 7554:                   cff2 = cff1;
 7555:                   cff3 = 0.0;
 7556: 
 7557:                }
 7558:             } // if iveg
 7559:          } //  2D/3D
 7560: 
 7561:          av_cff1 += cff1/i34;
 7562:          av_cff2 += cff2/i34;
 7563:          av_cff3 += cff3/i34;
 7564:          av_cff2_chi += cff2*chi/i34;
 7565:          av_cff3_chi += cff3*chi/i34;
 7566:          av_df += min(htot, veg_h)/(htot*i34);
 7567: 
 7568: 
 7569:          // btrack values: U^\star, U^{\star\alpha}
 7570:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7571:          Vector2 Ustar       = {0.0, 0.0}; 
 7572:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7573: 
 7574:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7575:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7576:          } else { //3D
 7577:             for (int k = side->kb + 1; k < nvrt; k++) {
 7578:             
 7579:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7580:                Ustar += w2;
 7581: 
 7582:                if constexpr(iveg != 0) {
 7583:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7584:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7585:                        Ustar_alpha += zrat*w2; // XXXX
 7586:                    }
 7587:                }  // if iveg
 7588:             }  // for k
 7589:          }  //2D/3D
 7590: 
 7591:          // If needed, project the side velocities to the element frame
 7592:          if constexpr(ics==2) {
 7593:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7594:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7595:          }
 7596:         
 7597: 
 7598:          // Add btrack & surface stress terms to \breve{G} first
 7599:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7600: 
 7601: 
 7602:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7603:          Vector2 tau    = side->tau();  
 7604:          Vector2 ubstar = side->btu[side->kb + 1];  
 7605: 
 7606:          // If needed, project tau and ubstar to the element frame
 7607:          if constexpr(ics==2) {
 7608:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7609:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7610:          }
 7611: 
 7612:          // Term for surface and bottom stress
 7613:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7614: 
 7615: 
 7616:          // All terms in F,F^\alpha,f_b except baroclinic
 7617:          // F, f_b: all explicit terms excluding vegetation 
 7618:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7619:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7620:          const double coriolis = side->coriolis;
 7621:          Vector2 F  =  coriolis*side->U;  // F_x
 7622:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7623:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7624: 
 7625:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7626:             
 7627:             for (int k = side->kb; k < nvrt; k++) {
 7628:                if (zctr2 > side->zc[k-1]) {
 7629:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7630:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7631:                    Fa +=  coriolis*w2*zrat;
 7632:                } // if zctr2
 7633:             } // k
 7634:          } // iveg
 7635: 
 7636:          // Integrate horizontal viscosity force vertically
 7637:          for (int k=side->kb + 1; k<nvrt; k++) {
 7638:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7639: 
 7640:             F += levelHorVisc;
 7641: 
 7642:             // Vegetation term
 7643:             if constexpr(iveg!=0) {
 7644:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7645:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7646:                   Fa += levelHorVisc*zrat;
 7647:                } 
 7648:             } // if iveg
 7649:          } // for k
 7650: 
 7651:          // Get nu*grad(U) at the side's bottom level
 7652:          Vector2 nuGradU = side->nuGradU[side->kb];
 7653: 
 7654:          fb += nuGradU;
 7655: 
 7656:          // If needed, project vectorsF, fb and Fa to the element frame
 7657:          if constexpr(ics==2) {
 7658:             F    = side->frame.projHorVec(F,    elem->frame);
 7659:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7660:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7661:          } // if ics
 7662: 
 7663:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7664:       } // for j (nodes and sides)
 7665: 
 7666:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7667: 
 7668: 
 7669:       // Finish off terms in F, F^\alpha and f_b
 7670:       const double grav3 = elem->mean(&Node::grav2);
 7671:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7672:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7673:       for (int j=0; j<i34; j++) { 
 7674:          // For each side in the element...
 7675:          const Side *side = elem->sides[j];
 7676:          const double chi = side->chi;
 7677: 
 7678:          const double htot = side->htot2();
 7679:          const double veg_h = side->veg_h();
 7680:          const Vector2 F  = htot*fb;
 7681:          const Vector2 Fa = min(htot, veg_h)*fb;
 7682: 
 7683:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7684:       } // for j
 7685: 
 7686:       // tmp is already in elem frame
 7687:       elem->ghat1 += tmp/i34;
 7688: 
 7689:       // Baroclinic force
 7690:       if constexpr(ibc==0) {
 7691:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7692: 
 7693:          Vector2 Fa = {0.0, 0.0};
 7694:          Vector2 intGradRho = {0.0, 0.0};
 7695:          
 7696:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7697:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7698:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7699: 
 7700:             // \in F [m^2/s/s]
 7701:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7702:          }
 7703: 
 7704:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7705:          const Vector2 F = av_df*Fa; //approx
 7706:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7707: 
 7708:       } // if ibc
 7709: 
 7710: 
 7711: 
 7712:    }
 7713: 
 7714: } // extern "C"
 7715: 
 7716: 
 7717: 
 7718: #ifdef DONTCOMPILE
 7719: __global__ void checkMassConservation(Tracers* sumtr) {
 7720: 
 7721:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7722: 
 7723:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7724: 
 7725:    Element *elem = &(mesh->localElemData[i]);
 7726: 
 7727:    // Skip dry elements
 7728:    if (elem->isDry) return;
 7729: 
 7730:    // Local sum array for this thread
 7731:    double localSum[N_TRACERS] = {0.0};
 7732: 
 7733:    // Sum over vertical levels for this element
 7734:    const int kbe = elem->kbe;
 7735:    const double area = elem->area;
 7736: 
 7737:    for (int k = kbe; k < nvrt; k++) {
 7738:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7739:       
 7740:       // Accumulate tracer mass
 7741:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7742:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7743:       }
 7744:    }
 7745: 
 7746:    //  This function returns per element sums. A reduction must be done on the host side.
 7747: }
 7748: 
 7749: 
 7750: __global__ void transport(void) {
 7751: 
 7752:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7753: 
 7754:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7755: 
 7756:    Element *elem = &(mesh->localElemData[ie]);
 7757: 
 7758:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7759: 
 7760:                for (int m=0; m<ntr; m++) {
 7761:                   for (int k=kbe(ie); k<nvrt; k++) {
 7762:                      // Calculate each polynomial's weight 
 7763:                      wm=0.d0; sum1=0.d0; 
 7764:                      wm1=0.d0; wm2=0.d0; 
 7765:                      for (int i=0; i<elem->nweno2; i++) {
 7766:                   
 7767:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7768:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7769:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7770:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7771:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7772:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7773:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7774:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7775:                      // -----------------Hu and Shu (1999)'s method----------------
 7776:                      b4=b1+b2+b3
 7777: 
 7778: //Error: add PRODUCTION CPP
 7779: #ifdef DEBUG
 7780:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7781:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7782:                     call parallel_abort(errmsg)
 7783:                   }
 7784: #endif
 7785: 
 7786:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7787:                   // !----test-------------- 
 7788:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7789:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7790:                   // !wm(i)=wm1(i)*wm2(i)
 7791:                   // !---------------------- 
 7792:                   sum1=sum1+wm(i)
 7793:                 } // end for i
 7794: 
 7795:                 wm=wm/sum1
 7796: 
 7797:                 for (int j=0; j<elem->i34; j++) {
 7798: 
 7799:                   const Side *side  = elem->sides[j];
 7800:                   const Node *node1 = side->n1;
 7801:                   const Node *node2 = side->n2;
 7802: 
 7803:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7804:                      trsd=0.d0
 7805:                      for (int kk=0; kk<nquad; kk++) {
 7806:                         for (int i=0; i<elem->nweno2; i++) {
 7807:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7808:                         } // end for i   
 7809:                      } // end for kk
 7810:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7811:                   } // outward flux
 7812:                } // end for j=1,i34(ie) ! side
 7813:             }
 7814:          }
 7815:               
 7816: 
 7817: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7818: //             //   calculate each polynomial's weight 
 7819: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7820: //                 wm=0.d0; sum1=0.d0
 7821: //                 do i=1,nweno1(ie) !for each polynomial
 7822: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7823: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7824: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7825: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7826: //                   wm(i)=b2
 7827: //                   sum1=sum1+b2
 7828: //                   !wm(i)=1.d0
 7829: //                   !sum1=sum1+1.d0
 7830: 
 7831: // // Error: PRODUCTION
 7832: // #ifdef DEBUG
 7833: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7834: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7835: //                     call parallel_abort(errmsg)
 7836: //                   endif
 7837: // #endif
 7838: 
 7839: //                 enddo !i
 7840: //                 wm=wm/sum1 !final weight
 7841: 
 7842:                 for (int j=0; j<elem->i34; j++) { // side
 7843:                   const Side *side = elem->sides[j];
 7844:                   const Node *node1 = side->n1;
 7845:                   const Node *node2 = side->n2;
 7846: 
 7847:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7848:                     trsd=0.d0
 7849:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7850:                       for (int i=0; i<elem->nweno1; i++) {
 7851:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7852:                       }
 7853:                     enddo //kk
 7854:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7855:                   } // outward flux
 7856:                 } // end for j=1,i34(ie) ! side
 7857:               } // end for k; ntr 
 7858: 
 7859:             else !simple upwind method
 7860:               do j=1,i34(ie)
 7861:                 jsj=elside(j,ie)
 7862:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7863:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7864:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7865:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7866:                   endif
 7867:                 enddo  !vertical layers
 7868:               enddo !j=1,i34(ie) ! side
 7869:             endif !order of accuracy
 7870: 
 7871:          //  enddo !ie
 7872: // !$OMP     end do
