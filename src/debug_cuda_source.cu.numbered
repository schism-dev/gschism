 7540: 
 7541: __global__ void computeMatrixProductAndDotProducts() {
 7542:    // Computes A*p, r'Mr and p'Ap
 7543: 
 7544:    // 1) shared buffer: first half for rMr, second for pAp
 7545:    __shared__ double sdata[2*BLOCK_SIZE];
 7546:    double* s_rMr = sdata;
 7547:    double* s_pAp = sdata + BLOCK_SIZE;
 7548: 
 7549:    const int tid = threadIdx.x;
 7550: 
 7551:    double l_pAp = 0.0;
 7552: 
 7553:    s_rMr[tid] = 0.0;
 7554:    s_pAp[tid] = 0.0;
 7555: 
 7556:    // 2) get your node pointer
 7557:    // NODE(node);   
 7558:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7559:    Node *node = &(mesh->localNodeData[idx_node]); 
 7560:       if (idx_node < mesh->np) {
 7561: 
 7562:       const double diag = node->coeffDiag;
 7563:       const double r    = node->mR;
 7564:       const double p    = node->mP;  
 7565: 
 7566:       // apply preconditioner on the fly:
 7567:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7568: 
 7569:       // 4) compute Ap = A.p
 7570:       double Ap = node->coeffDiag * node->mP;
 7571:       for (int j = 0; j < node->numNodes; ++j) {
 7572:          const Node *nbNode = node->nodes[j];
 7573:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7574: 
 7575:       }
 7576: 
 7577:       node->mAp = Ap;
 7578:       
 7579: 
 7580:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7581:       // const double l_rMr = r*Mr;  // r'Mr
 7582:       l_pAp = p*Ap;  // p'Ap
 7583: 
 7584: 
 7585:    }
 7586: 
 7587:    // 6) write into shared mem
 7588:    // s_rMr[tid] = l_rMr;
 7589:    s_pAp[tid] = l_pAp;
 7590: 
 7591:    __syncthreads();
 7592: 
 7593:    // 7) block-wide tree reduction
 7594:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7595:       if (tid < stride)  {
 7596:          s_pAp[tid] += s_pAp[tid + stride];
 7597:       }
 7598:       __syncthreads();
 7599:    }
 7600: 
 7601:    // 8) thread 0 atomically accumulates into the globals
 7602:    // XXX: This is slower than it needs to be, but it is simple and works
 7603:    if (tid == 0) {
 7604:       atomicAdd(pAp, s_pAp[0]);
 7605:    }
 7606: 
 7607: 
 7608: }
 7609: 
 7610: 
 7611: __global__ void updateSolutionAndDotProducts(void) {
 7612:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7613: 
 7614:    const int tid = threadIdx.x;
 7615: 
 7616:    s_rMr[tid] = 0.0;
 7617: 
 7618:    // get node & bounds-check:
 7619:    NODE(node);
 7620: 
 7621:    
 7622:    // Compute alpha
 7623:    const double alpha = (*rMr_old)/(*pAp); 
 7624: 
 7625: 
 7626:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7627: 
 7628: 
 7629:    // load scalars
 7630:    const double diag = node->coeffDiag;
 7631:    const double p    = node->mP;
 7632:    const double Ap   = node->mAp;
 7633:    const double x    = node->mX;
 7634:    const double r    = node->mR;
 7635:    
 7636:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7637: 
 7638:    // 1) update solution & residual
 7639:    const double x_new = x + alpha*p;
 7640:    const double r_new = r - alpha*Ap;
 7641:    node->mX = x_new;
 7642:    node->mR = r_new;
 7643: 
 7644:    // 2) apply Jacobi preconditioner on the fly
 7645:    const double Mr_new = r_new/diag;
 7646: 
 7647: 
 7648:    // 3) local contributions for the two dot-products
 7649:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7650: 
 7651:    // 4) write into shared-mem
 7652:    s_rMr[tid] = l_rMr;
 7653: 
 7654:    __syncthreads();
 7655: 
 7656: 
 7657:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7658:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7659:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7660:       __syncthreads();
 7661:    }
 7662: 
 7663:    // 6) thread 0 atomically folds into the global accumulators
 7664:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7665: 
 7666: 
 7667: }
 7668: 
 7669: 
 7670: __global__ void updateSearchDirection() {
 7671: 
 7672:     NODE(node);
 7673: 
 7674:     // recompute z on-the-fly
 7675:     const double z = node->mR / node->coeffDiag;
 7676:     const double p = node->mP;
 7677: 
 7678:     const double beta = (*rMr_new)/(*rMr_old);
 7679: 
 7680: 
 7681:     // p =z + beta*p
 7682:     node->mP = z + beta*p;
 7683: 
 7684: }
 7685: 
 7686: __global__ void initializeScalars(double *scalars) {
 7687: 
 7688:    // These point to a cupy array in the host code
 7689:    rMr_old = scalars + 0;
 7690:    rMr_new = scalars + 1;
 7691:    pAp     = scalars + 2;
 7692: }
 7693: 
 7694: __global__ void initializePreconditionedResidual(void) {
 7695: 
 7696:     __shared__ double s_rMr[BLOCK_SIZE];  
 7697: 
 7698:     s_rMr[threadIdx.x] = 0.0;
 7699: 
 7700:     NODE_ALL(node, valid);
 7701:     const int tid = threadIdx.x;
 7702:     // For the first iteration:
 7703:     // 1. Initial solution x = 0 (already set)
 7704:     // 2. Initial residual r = b (stored in qel)
 7705:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7706: 
 7707: // XXX we should use the guess solution here    
 7708: 
 7709:     double l_rMr = 0.0;
 7710:     if (valid) {
 7711:       // Set initial residual r = b (from qel)
 7712:       node->mR = node->qel;
 7713: 
 7714:       // Compute z = M^-1 * r (preconditioned residual)
 7715:       const double z = node->mR / node->coeffDiag;
 7716: 
 7717:       // Set initial search direction p = z
 7718:       node->mP = z;
 7719: 
 7720:       // Initialize other variables needed for CG
 7721:       node->mX = 0.0;  // Initial solution
 7722:       node->mAp = 0.0; // Will be computed in first iteration
 7723: 
 7724: 
 7725:       // Computes the first r'Mr (reduction)
 7726:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7727:     }
 7728:     // 4) write into shared-mem
 7729:     s_rMr[tid] = l_rMr;
 7730: 
 7731:     __syncthreads();
 7732: 
 7733: 
 7734:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7735:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7736:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7737:         __syncthreads();
 7738:     }
 7739: 
 7740:     // 6) thread 0 atomically folds into the global accumulators
 7741:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7742: 
 7743:     *rMr_old = 0.0;
 7744:     *pAp = 0.0;
 7745: }
 7746: 
