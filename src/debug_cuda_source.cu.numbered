 1765: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1766:    // Computes the 3D normal vector to the element at level k
 1767:    // Returns the normal vector and the area of the element
 1768: 
 1769:       if (isTri()) {
 1770:          // For triangles...
 1771: 
 1772:          // Gets the normal vector to the element (with a length equal to twice the area)
 1773:          if constexpr(ics==1) {
 1774:             const int kb0 = max(k, nodes[0]->kb);
 1775:             const int kb1 = max(k, nodes[1]->kb);
 1776:             const int kb2 = max(k, nodes[2]->kb);
 1777: 
 1778:             const Vector3 n20 = nodes[2]->p3D(k) - nodes[0]->p3D(k);
 1779:             const Vector3 n10 = nodes[1]->p3D(k) - nodes[0]->p3D(k);
 1780:             
 1781:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1782:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1783:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1784:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1785: 
 1786:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1787:             area3D = 0.5*len;
 1788: 
 1789:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1790: 
 1791:             return {nx/len, ny/len, nz/len};
 1792: 
 1793:            
 1794:          }
 1795:          else {  // lat/lon
 1796:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1797: 
 1798:          } // if ics
 1799:       }
 1800:       else {
 1801:          // For quads...
 1802: 
 1803:          assert(false && "Element normal vector: quads not yet implemented");
 1804: 
 1805: 
 1806:       }
 1807:    }
 1808: 
 1809: /**
 1810:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1811:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1812:    If the segment is completely inside the element, then it returns true.
 1813: 
 1814:    This function assumes:
 1815:    - The initial point is on a side of the element. 
 1816:    - Its position is given by parameter t in the range [0,1].
 1817:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1818:       intersects the element (elements are convex).
 1819: 
 1820:    To find the intersection point, this function does the following:
 1821:    - it finds the intersection of the line segment with all the element side lines,
 1822:       except for the one that contains the initial point.
 1823:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1824:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1825:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1826:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1827:       track segment is almost parallel to the element side line.
 1828: 
 1829:    Inputs:
 1830:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1831:    @param x2, y2: other end of the line segment
 1832: 
 1833:    Outputs:
 1834:    @param side:  side that intersects the line segment (input and output)
 1835:    @param nextElement (output): element that contains the intersection point
 1836:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1837:    @param zint (input/output): Vertical coordinate of the intersection point
 1838: 
 1839:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1840:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1841:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1842: 
 1843:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1844:    (Delta) being zero.
 1845: 
 1846:    The intersection2 point happens when:
 1847:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1848:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1849:    
 1850:    Assumption: the 4 points (including those of the side segment) are different.
 1851:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1852:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1853:    If true, (xIntersect,yIntersect) is the intersection.				
 1854:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1855: **/
 1856: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1857:                                               double &t, double& tIntersect) {
 1858: 
 1859:    double closest_intersect_t = 1e10;
 1860:    bool found_intersection = false;
 1861: 
 1862:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1863:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1864:    const Point2 x1 = side->point(t);
 1865:    
 1866: 
 1867:    Side *nextSide = nullptr;
 1868:    for (int i = 0; i < i34; i++) {
 1869: 
 1870:       // Element's i-th side 
 1871:       Side *side2 = sides[i];
 1872: 
 1873:       // Skip the side that contains the initial point
 1874:       if (side2 == side) continue;
 1875: 
 1876:       // (x3,y3)-(x4,y4) is the element side line
 1877:       const Point2 x3 = side2->n1->p;
 1878:       const Point2 x4 = side2->n2->p;
 1879: 
 1880:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1881:       const double delta = cross(x2 - x1, x3 - x4);
 1882: 
 1883:       if (delta != 0.0) {
 1884: 
 1885:          const double delta1 = cross(x3 - x1, x3 - x4);
 1886:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1887: 
 1888:          // Solves the two linear equations for tt1 and tt2
 1889:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1890:          const double tt2 = delta2/delta;
 1891: 
 1892:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1893:             closest_intersect_t = min(closest_intersect_t, tt1);
 1894:             nextSide = side2;
 1895: 
 1896:             nextElement = nextSide->otherElem(this);
 1897:             tIntersect = max(small, min(tt1, 1.0-small));
 1898:             t = tt2;
 1899: 
 1900:             found_intersection = true;
 1901:          }
 1902:       
 1903:       }
 1904: 
 1905:    }
 1906: 
 1907:    // found_intersection should always be true, since we checked all the sides.  
 1908:    side = nextSide;
 1909: 
 1910:    return found_intersection;
 1911: }
 1912: 
 1913: 
 1914: 
 1915: 
 1916: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1917:                                               double &t, double& tIntersect) {
 1918: 
 1919:    double closest_intersect_t = 1e10;
 1920:    bool found_intersection = false;
 1921: 
 1922:    for (int i = 0; i < i34; i++) {
 1923: 
 1924:       Side *side2 = sides[i];
 1925: 
 1926:       // (x3,y3)-(x4,y4) is the element side line
 1927:       const Point2 x3 = side2->n1->p;
 1928:       const Point2 x4 = side2->n2->p;
 1929: 
 1930:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1931:       const double delta = cross(x2 - x1, x3 - x4);
 1932: 
 1933:       if (abs(delta) > 0) {
 1934: 
 1935:          const double delta1 = cross(x3 - x1, x3 - x4);
 1936:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1937: 
 1938:          // Solves the two linear equations for tt1 and tt2
 1939:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1940:          const double tt2 = delta2/delta;
 1941: 
 1942:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1943:             closest_intersect_t = min(closest_intersect_t, tt1);
 1944:             side = side2;
 1945:             nextElement = side->otherElem(this);
 1946:             t = tt2;
 1947:             tIntersect = max(small, min(tt1, 1.0-small));
 1948:             found_intersection = true;
 1949:          }
 1950:       
 1951:       }
 1952:       else {  // parallel segments
 1953:          assert(false && "Parallel segments");
 1954:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1955:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1956: 
 1957:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1958: 
 1959:          // const double dist = dot(x1 - x3, side2->n);
 1960:          // if (abs(dist) < small*length(x3 - x4)) {
 1961:          //    const double2 unitarySide = normalize(x4 - x3);
 1962:          //    const double len = dot(x2 - x1, unitarySide);
 1963:          //    t = t + len;
 1964:          //    t = max(0.0, min(t, 1.0));
 1965:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1966: 
 1967: 
 1968:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1969:          //    // t = tt2;
 1970:          //    found_intersection = true;
 1971:          // }
 1972:       }
 1973: 
 1974: 
 1975:    }
 1976: 
 1977:       
 1978:    assert(found_intersection && "No intersection found");
 1979: 
 1980:    // found_intersection should always be true, since we checked all the sides.  
 1981:    return found_intersection;
 1982: }
 1983: 
 1984: 
 1985: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1986:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1987: 
 1988:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1989: 
 1990:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1991:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1992:    // curElement.
 1993: 
 1994:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1995:    // And uses this velocity instead to continue the tracking.
 1996: 
 1997:    // computes the intersection point in cartesian coordinates
 1998:    Point2 intersection = nextSide->p_t(tt);
 1999: 
 2000:    // Nudges the point to the barycenter of the element. 
 2001:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2002:    // next segment intersects the element sides.  
 2003:    curElem->nudgeToBarycenter(intersection);
 2004: 
 2005:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2006:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2007:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2008:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2009: 
 2010:    // If the side is an open boundary, the tangential velocity is zero.
 2011:    if (nextSide->isBnd()) vtan = 0.0;
 2012: 
 2013:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2014:    const double us = vtan*nextSide->t().x;
 2015:    const double vs = vtan*nextSide->t().y;
 2016:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 2017: 
 2018:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 2019:    const double len2 = norm2(intersection - toPoint2(xt));
 2020:    const double vel2 = dot(u_int, u_int);        
 2021:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 2022:    else            dt = 0.0;
 2023: 
 2024:    // The end of this tracking segment is now the intersection point.
 2025:    xt = {intersection.x, intersection.y, zint};
 2026: 
 2027:    u_int = {us, vs, ws};
 2028:    
 2029: }
 2030: 
 2031: /**
 2032:  * Tracks a particle through elements and vertical levels in the mesh.
 2033:  * 
 2034:  * @param x0,y0,z0     Starting position coordinates
 2035:  * @param xt,yt,zt     Target position coordinates
 2036:  * @param dtb          Time step for tracking
 2037:  * @param uuint,vvint,wwint Initial velocity components
 2038:  * @param nextElem     Starting/resulting element index
 2039:  * 
 2040:  * @return Status code of type trackExitCodes
 2041:  * 
 2042:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2043:  * of the details are different. The idea is that the code requires less branches and is better fit
 2044:  * for GPU execution.
 2045:  * 
 2046:  * The main ideas here are:
 2047:  * - The starting point is expected to be in the starting element.
 2048:  * - The end point is guaranteed to be inside an element.
 2049:  * - since the starting point is inside the element, there are only two cases: 
 2050:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2051:  *     (b) it does not and (xt,yt) is already in the starting element.
 2052:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2053:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2054:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2055:  * - tt1 can be positive or negative. We only consider the positive values.
 2056:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2057:  * - The next intersection will occur at the smallest positive tt1.
 2058:  * - This intersection will be the next (x0,y0) position.
 2059:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2060:  *   of getting stuck in a loop.
 2061:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2062:  *   was found.
 2063:  */
 2064: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2065:                                                        Element *&nextElem, int &jlev, double &dt,
 2066:                                                        const Side *origSide) {
 2067: 
 2068: 
 2069: 
 2070:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2071:    // else to do.
 2072:    // If it is, nudges the point to be inside the element.
 2073:    const Element *curElem = nextElem;
 2074:    if (containsPoint(toPoint2(xt), true)) {
 2075: 
 2076:       curElem->interpolateVelocities(xt, u_int);
 2077: 
 2078: addDebugPlot(x0, xt);
 2079:       return true;
 2080:    }
 2081: 
 2082:    Side *side = nullptr;
 2083: 
 2084:    // 1. Initial checks
 2085:    // Verify starting element is valid (wet)
 2086:    assert(!curElem->isDry && "Starting element is dry");
 2087: 
 2088:    // Checks if track has a zero length.
 2089:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2090:    // assert(len2 > 0.0 && "Zero length track"); 
 2091:    
 2092:    const int MAX_ITERATIONS = 1000;
 2093:    
 2094:    double t;
 2095:    Side *nextSide = nullptr;
 2096:    double tIntersect = 1e10;
 2097:    double zint = x0.z;
 2098: 
 2099:    // Horizontal tracking loop
 2100:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2101:    // (x0,y0) is inside the element but the target point is not.
 2102: 
 2103:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2104: 
 2105:    assert(found_intersection && "No intersection found at %d");
 2106: 
 2107:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2108: 
 2109:    // if the tracking segment goes out of water (either dry or edge boundary)
 2110:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2111: 
 2112: addDebugPlot(x0, xt, 0x00A0FF);
 2113:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2114: addDebugPlot(x0, xt, 0x00A0FF);      
 2115: 
 2116:       nextElem = this;
 2117:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2118:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2119:       return true;    
 2120:    }
 2121: 
 2122: 
 2123:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2124:    int iterations = 0;
 2125:    while (iterations < MAX_ITERATIONS) {
 2126:       iterations++;
 2127:       
 2128:       Element *curElem = nextElem;
 2129: 
 2130:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2131: addDebugPlot(x0, xt);
 2132:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2133: 
 2134:       // If we are already in the target element, we are done.
 2135:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2136:       if (!found_intersection) break;
 2137: 
 2138: 
 2139: 
 2140:       // if the tracking segment goes out of water (either dry or edge boundary).
 2141:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2142: addDebugPlot(x0, xt, 0x00A0FF);
 2143:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2144: addDebugPlot(x0, xt, 0x00A0FF);   
 2145:          nextElem = curElem;
 2146: 
 2147:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2148:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2149:          return true;
 2150:       }
 2151:       
 2152:       // Update position and element for next iteration
 2153:       side = nextSide;
 2154: 
 2155:    }
 2156: 
 2157:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2158: 
 2159:  
 2160:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2161:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2162: addDebugPlot(x0, xt);   
 2163:    nextElem->interpolateVelocities(xt, u_int); 
 2164: 
 2165:    return true;
 2166: }
 2167: 
 2168: 
 2169: __inline__ __device__ double Element::computeSignedArea(void) const {
 2170:    // Compute the area of the element
 2171: 
 2172:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2173: 
 2174:    // In the quad case we need to add the area of the other triangle.
 2175:    if (isQuad()) {
 2176:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2177:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2178:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2179:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2180: 
 2181:       res += ar1;
 2182:    }
 2183: 
 2184:    return res;
 2185: }
 2186: 
 2187: 
 2188: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2189:                                                                 (nodes[1]->isDry2()) ||
 2190:                                                                 (nodes[2]->isDry2()) ||
 2191:                                                                 (i34==4 && nodes[3]->isDry2());
 2192: }
 2193: 
 2194: __inline__ __device__ double Element::detJ_eta(void) const {
 2195:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2196:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2197: }
 2198: 
 2199: __inline__ __device__ double Element::detJ_xi(void) const {
 2200:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2201:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2202: }
 2203: 
 2204: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2205:    // In boundary sides, the element 1 is nullptr
 2206:    return side->elems[1] == nullptr; 
 2207: }
 2208: 
 2209: 
 2210: 
 2211: /**
 2212:    Compute the shape coordinates of the point (xt,yt) in the element.
 2213:    @param xt (input): x-coordinate of the point
 2214:    @param shpCoords (output): shape coordinates of the point
 2215:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2216:    @return true if the point is inside the element, false otherwise
 2217: **/
 2218: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2219:                                             bool fixNegshpCoord) const {
 2220: 
 2221:    // Compute the shape coordinates of the point xt in the element.
 2222:    if (i34==3) {
 2223:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2224:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2225:       // and in this case, the pt will be nudged into the element
 2226:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2227:       // from the local frame, so use additional check.
 2228: 
 2229:       Point2 x0, x1, x2;
 2230: 
 2231:       if constexpr(ics==1) {
 2232:          x0 = nodes[0]->p;
 2233:          x1 = nodes[1]->p;
 2234:          x2 = nodes[2]->p;
 2235:       }
 2236:       else // lat/lon
 2237:       {
 2238:          Error("Not implemented yet");
 2239: #ifdef ICS2
 2240:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2241:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2242:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2243: #endif
 2244:       }
 2245: 
 2246:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2247:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2248:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2249:       shpCoords[3] = 0.0;
 2250:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2251: 
 2252:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2253:       // then we fix the negative shape coordinates.
 2254:       if (fixNegshpCoord && tmpmin<=0.0) {
 2255: 
 2256:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2257:          // keeping the sum of the shape coordinates equal to 1.
 2258:          // I have tested and compared the new algorithm with the old one, and they give
 2259:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2260:          // The new algorithm should be faster since it is branchless.
 2261:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2262:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2263:          
 2264:          shpCoords[0] = (shpCoords[0] + a)*b;
 2265:          shpCoords[1] = (shpCoords[1] + a)*b;
 2266:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2267: 
 2268:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2269:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2270:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2271:          }
 2272: 
 2273:          // Update the point coordinates for the new shape coordinates
 2274:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2275:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2276:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2277: 
 2278:       }
 2279: 
 2280:       // Check if the point is inside the element
 2281:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2282:    }
 2283:    else {
 2284:       Error("Not implemented yet");
 2285: #ifdef QUADS
 2286:       // Reproject pt in eframe of nel for ics=2
 2287:       if constexpr(ics==1) {
 2288:          xn2 = xt; 
 2289:          yn2 = yt;
 2290:       }
 2291:       else {
 2292:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2293:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2294:       }
 2295: 
 2296:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2297: #endif
 2298:    }
 2299: 
 2300:    return false;  // Never reached
 2301: 
 2302: }
 2303: 
 2304: 
 2305: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2306: // Convert shape coordinates to cartesian coordinates
 2307: 
 2308:    if (i34 == 3) {
 2309:       // Triangular element
 2310:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2311:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2312:    }
 2313:    else {
 2314:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2315:    }
 2316: 
 2317: }
 2318: 
 2319: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2320:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2321:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2322:    // The formula for the integral is:
 2323:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2324: 
 2325:    printf("intPhiPhi: TEST\n");
 2326: 
 2327:    const Node *n0 = nodes[0];
 2328:    const Node *n1 = nodes[1];
 2329:    const Node *n2 = nodes[2];
 2330:    const Node *n3 = nodes[3];
 2331: 
 2332:    const Vector2 p0 = n0->p;
 2333:    const Vector2 p1 = n1->p;
 2334:    const Vector2 p2 = n2->p;
 2335:    const Vector2 p3 = n3->p;
 2336: 
 2337:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2338:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2339:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2340:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2341: 
 2342:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2343: }
 2344:    
 2345: 
 2346: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2347:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2348:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2349:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2350:    // The formula is also based on the identity:
 2351:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2352:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2353: 
 2354:    printf("intGradPhiGradPhi: TEST\n");   
 2355: 
 2356:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2357: 
 2358:    const double x0 = nodes[0]->p.x;
 2359:    const double y0 = nodes[0]->p.y;
 2360:    const double x1 = nodes[1]->p.x;
 2361:    const double y1 = nodes[1]->p.y;
 2362:    const double x2 = nodes[2]->p.x;
 2363:    const double y2 = nodes[2]->p.y;
 2364:    const double x3 = nodes[3]->p.x;
 2365:    const double y3 = nodes[3]->p.y;
 2366: 
 2367:    double res = 0.0;
 2368:    
 2369:    // Quadrature points in xi and eta coordinates
 2370:    #pragma unroll
 2371:    for (int i = 0; i < 4; i++) {
 2372:       // For each quadrature point...
 2373: 
 2374:       const Point2 p = GaussPoint(i);
 2375:       const double eta = p.x;
 2376:       const double xi  = p.y;
 2377: 
 2378:       // Jacobian entries at the Gauss point p
 2379:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2380:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2381:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2382:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2383: 
 2384:       const double detJ = jacobianDet(p);
 2385:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2386: 
 2387:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2388:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2389:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2390:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2391:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2392: 
 2393:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2394:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2395:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2396:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2397:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2398: 
 2399:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2400:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2401:    }
 2402: 
 2403:    return res;
 2404: }
 2405: 
 2406: 
 2407: /**  Interpolate velocities at a given point (xt,yt,zt)
 2408: 
 2409:    @param xt, yt, zt: coordinates of the point to interpolate
 2410:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2411: 
 2412:    This is done in four steps:
 2413: 
 2414:    1. Find the shape coordinates for the final position in the element.
 2415:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2416:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2417:       z levels at xt, yt at each step.   
 2418:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2419:       horizontally and vertically.
 2420: **/
 2421: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2422:    // Interpolate the velocities at the point xt. 
 2423:    // This function works the same for triangular and quadrilateral elements.
 2424:    double shpCoord[4];
 2425: 
 2426:    // First step is to compute the shape coordinates of (xt,yt)
 2427:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2428:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2429: 
 2430:    // Second step is to find the level that contains zt
 2431:    // Uses a binary search to find the level
 2432:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2433:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2434:    int R = nvrt - 1;
 2435: 
 2436:    // Get the z coordinates at the nodes of the element at the levels L and R
 2437:    double zLAtNodes[4], zRAtNodes[4];
 2438:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2439:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2440: 
 2441:    double zL = interpolate(shpCoord, zLAtNodes);
 2442:    double zR = interpolate(shpCoord, zRAtNodes);
 2443:    
 2444:    // Interpolates vertically the velocities
 2445:    double wght1, wght2;
 2446:    if (xt.z<=zL) {
 2447:       wght1 = 1.0;
 2448:       wght2 = 0.0;
 2449:    }
 2450:    else if (xt.z>=zR) {
 2451:       wght1 = 0.0;
 2452:       wght2 = 1.0;
 2453:    }
 2454:    else {
 2455:       // Perform a binary search to find the levels between L and R that contain xt.z
 2456:       while (R - L > 1) {
 2457:          int M = (L + R) / 2;
 2458: 
 2459:          double zMAtNodes[4];
 2460:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2461:          double zM = interpolate(shpCoord, zMAtNodes);
 2462:          if (zM < xt.z) 
 2463:          {
 2464:             L = M;
 2465:             zL = zM;
 2466:          }
 2467:          else 
 2468:          {
 2469:             R = M;
 2470:             zR = zM;
 2471:          }
 2472:       }
 2473:       assert(L == R-1);
 2474:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2475: 
 2476:       wght2 = (xt.z - zL)/(zR - zL);
 2477:       wght1 = 1.0 - wght2;
 2478:    }
 2479: 
 2480:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2481:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2482: 
 2483:    // Neither of the interpolated velocities should be NaN
 2484:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2485: 
 2486: }
 2487: 
 2488: 
 2489: 
 2490: 
 2491: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2492: 
 2493:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2494:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2495:    const Node *n1 = side->n1;
 2496:    const Node *n2 = side->n2;
 2497: 
 2498:    bool n1_match = (n1->nodeBnd->segment == segment);
 2499:    bool n2_match = (n2->nodeBnd->segment == segment);
 2500: 
 2501:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2502:    if (n1_match && n2_match) {
 2503:       return 0.5;
 2504:    } else if (n1_match) {
 2505:       return 1.0;
 2506:    } else if (n2_match) {
 2507:       return 0.0;
 2508:    }
 2509: 
 2510:    return 0.0;
 2511: }
