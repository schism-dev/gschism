 3774: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3775:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3776:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3777:    // 
 3778:    // This kernel is called for all nodes.
 3779: 
 3780: 
 3781:    NODE(node1);
 3782: 
 3783: 
 3784:    node1->clearMatrixRow();
 3785:    node1->qel = 0.0;
 3786: 
 3787:    // THIS IS FOR STRUCTURES XXX
 3788:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3789: 
 3790:    
 3791:    for (int j=0; j<node1->numElements; j++) {
 3792:       // For each element connected to the node...
 3793: 
 3794:       Element *elem = node1->elements[j];
 3795: 
 3796:       // Compute the average gravity
 3797:       const double grav3 = elem->mean(&Node::grav2);
 3798: 
 3799:       // Look at the documentation for the description of the terms in the following integrals
 3800: 
 3801:       // Integral I_1 
 3802:       // \bar{\breve{H}} 
 3803:       const double hhatb = elem->mean(&Side::hhat);        
 3804: 
 3805:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3806: 
 3807:       const int id1 = elem->nodeLocalIdx(node1); 
 3808:       const double area = elem->area;
 3809: 
 3810:       if (elem->isTri()) {
 3811: 
 3812:          // To clarify the notation in this section: 
 3813:          //   i stands for the node under consideration (node1)
 3814:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3815:          const int id2 = elem->nxq(1 + id1);
 3816:          const int id3 = elem->nxq(2 + id1);
 3817:          Node *node2 = elem->nodes[id2];
 3818:          Node *node3 = elem->nodes[id3];
 3819: 
 3820:          const Point2 x1 = node1->p2();
 3821:          const Point2 x2 = node2->p2();
 3822:          const Point2 x3 = node3->p2();
 3823: 
 3824:          // integral of phi_i*phi_j
 3825:          const double ipp_ii = (1.0/6.0 )*area;
 3826:          const double ipp_ij = (1.0/12.0)*area;
 3827:          const double ipp_ik = (1.0/12.0)*area;
 3828: 
 3829:          // integral of [(grad phi_i) * (grad phi_j)]
 3830:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3831:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3832:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3833: 
 3834:          // Computes the different components of integral I_1 of each node with respect to node i.
 3835:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3836:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3837:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3838: 
 3839:          node1->addToSparseMatrix(node1, I1_ii);
 3840:          node1->addToSparseMatrix(node2, I1_ij); 
 3841:          node1->addToSparseMatrix(node3, I1_ik);
 3842: 
 3843:       }
 3844:       else { // Quad
 3845:          // XXX IMPLEMENT THIS
 3846:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3847: 
 3848:          // To clarify the notation in this section: 
 3849:          //   i stands for the node under consideration (node1)
 3850:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3851:          const int id2 = elem->nxq(1 + id1);
 3852:          const int id3 = elem->nxq(2 + id1);
 3853:          const int id4 = elem->nxq(3 + id1);
 3854:          Node *node2 = elem->nodes[id2];
 3855:          Node *node3 = elem->nodes[id3];
 3856:          Node *node4 = elem->nodes[id4];         
 3857: 
 3858:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3859:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3860:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3861:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3862:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3863: 
 3864:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3865:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3866:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3867:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3868:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3869: 
 3870:          // Computes the different components of integral I_1 of each node with respect to node i.
 3871:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3872:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3873:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3874:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3875: 
 3876:          node1->addToSparseMatrix(node1, I1_ii);
 3877:          node1->addToSparseMatrix(node2, I1_ij); 
 3878:          node1->addToSparseMatrix(node3, I1_ik);
 3879:          node1->addToSparseMatrix(node4, I1_il);
 3880:   
 3881: 
 3882: 
 3883:       
 3884:       } 
 3885: 
 3886:  
 3887:       // Integral I_4
 3888:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3889:       // Where
 3890:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3891: 
 3892:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3893:       // of U over the element.
 3894:       Vector2 Umean = {0.0, 0.0};
 3895:       for (int m=0; m<elem->i34; m++) {      
 3896:          const Side *side = elem->sides[m];
 3897: 
 3898:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3899:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3900:       }
 3901:       Umean = Umean/elem->i34;
 3902: 
 3903:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3904: 
 3905:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3906:       const double I_4_1 = dot(gradPhi_1, Umean);
 3907: 
 3908:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3909:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3910:      
 3911:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3912: 
 3913:       // Additional terms 
 3914:       double vnorm = 0.0;
 3915:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3916:          Vector3 ubed;
 3917:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3918: 
 3919:          Vector3 gradP = {0.0, 0.0, 1.0};
 3920:          for (int m=0; m < elem->i34; m++) {
 3921:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3922:            gradP += toVector3(gradP_2D, 0.0);
 3923:          }   
 3924:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3925:       } // imm==2
 3926: 
 3927:       if (elem->isTri()) {
 3928:          for (int l=0; l<3; l++) {
 3929:             double fac;
 3930: 
 3931:             Node *node = elem->nodes[l];
 3932: 
 3933:             fac = (node == node1) ? 2.0 : 1.0;
 3934:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3935:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3936: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3937:            
 3938:          }
 3939: 
 3940: 
 3941:          if (!elem->isDry) {
 3942:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3943: 
 3944:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3945: 
 3946:          }
 3947: 
 3948:       } // isTri
 3949:       else { // isQuad
 3950:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3951:          // for (int l=0; l<4; l++) {
 3952:          //   const Node *node = elem->nodes[l];
 3953: 
 3954:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3955:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3956: 
 3957:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3958:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3959:          // }
 3960: 
 3961:       } // isQuad
 3962: 
 3963: 
 3964:      node1->qel += (dt/elem->i34)*elem->vsource;
 3965:       
 3966: 
 3967:    } // for all elements connected to the node
 3968:    
 3969: 
 3970:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3971:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3972:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3973:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3974:       // If it is an open boundary node...
 3975: 
 3976:       // At least one open bnd side, maybe two
 3977:       for (int l=0; l<2; l++) { 
 3978: 
 3979:          // Gets each of the sides sharing the node. 
 3980:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3981: 
 3982:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3983:          
 3984: 
 3985:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3986:          if (sideBnd != nullptr) {
 3987:             // If the side is on a boundary...
 3988: 
 3989:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3990: 
 3991:             // Get the boundary segment
 3992:             const BoundarySegment *sideSegment = sideBnd->segment;
 3993:             const Side *side = sideBnd->side;
 3994: 
 3995:             // Integral I_3
 3996:             if (sideSegment->ifltype != 0) {
 3997:             // Natural or Flather b.c.
 3998: 
 3999:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4000:                // especially for Flather b.c.
 4001:                double ri3 = 0.0;
 4002:                if (!side->isDry) {
 4003:                   // If the side is not dry
 4004:                   
 4005:                   // Computes the side flux of (uth, vth)
 4006:                   double Vn = 0.0;
 4007:                   for (int k = side->kb; k<nvrt-1; k++) {
 4008:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4009:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4010: 
 4011:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 4012:                   }
 4013: 
 4014:                   ri3 = 0.5*side->len*Vn;
 4015:                }
 4016: 
 4017:                if (sideSegment->ifltype == -1) { // Flather 1
 4018: 
 4019:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4020:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4021: 
 4022:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4023:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4024:                   
 4025:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4026:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4027: 
 4028:                } 
 4029:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4030:                   // Reset ri3
 4031:                   ri3 = 0.0;
 4032: 
 4033:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4034: 
 4035:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4036: 
 4037:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4038:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4039: 
 4040:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4041:                   node1->addToSparseMatrix(node1, con0*2.0);
 4042:                   node1->addToSparseMatrix(node2, con0);
 4043: 
 4044:                } // if Flather or Discharge
 4045: 
 4046: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 4047:                node1->qel -= thetai*dt*ri3;
 4048: 
 4049: 
 4050:             } // I_3
 4051:           
 4052: 
 4053:             // Integral I_5
 4054:             if(!side->isDry) {
 4055: 
 4056:                const double Unbar = dot(side->U, side->n);
 4057:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4058: 
 4059:             } // I_5
 4060: 
 4061:          } // if is boundary side
 4062: 
 4063:       } // for l
 4064: 
 4065:    } // if isbnd
 4066: 
 4067: 
 4068: }
 4069: 
 4070: 
 4071: 
 4072: extern "C" {
 4073:    __global__ void rollUpElevation(void) {
 4074: 
 4075:       NODE(node);
 4076: 
 4077:       node->eta1 = node->eta2;
 4078: 
 4079:    }
 4080: 
 4081: 
 4082:    __global__ void backtrackAllNodes(void) {
 4083: 
 4084:       // max/min # of sub-divisions
 4085:       const int ndelt_max = max(1.0, dt/dtb_min);
 4086:       const int ndelt_min = max(1.0, dt/dtb_max); 
 4087: 
 4088:       // Removed all references to swild98 XXX
 4089:       // swild98=0.d0 !init
 4090: 
 4091: 
 4092:       SIDE(side);
 4093: 
 4094:       const int kb = side->kb;
 4095: 
 4096: 
 4097:       // Initialize btrack velocities to the actual velocities at the side 
 4098:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4099: 
 4100:       if (side->isDry) return;
 4101: 
 4102: 
 4103:       // Checks that at least one element is not dry
 4104:       const Element *elem1 = side->elems[0];
 4105:       const Element *elem2 = side->elems[1];
 4106: 
 4107: 
 4108:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4109:       
 4110:       // XXXXXX
 4111:       // !swild_tmp to store global coord. of the starting side
 4112:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4113:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4114:       // !Use sframe2 
 4115:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4116: 
 4117: 
 4118:       for (int k = kb; k < nvrt; k++) {
 4119:       //  Initialize (xt,yt,zt), nnel and vel.
 4120:       //  For ics=2, the coordinates are in local frames
 4121:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4122: 
 4123: 
 4124:          const int iadvf = side->iadv();  // Advection flag
 4125: 
 4126:          Point3 xt;
 4127:          if constexpr(ics==1) {
 4128:             xt = side->center3D(k); 
 4129:          }
 4130:          else // lat/lon; in side lat/lon frame
 4131:          {
 4132:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 4133:          // XXX IMPLEMENT THIS
 4134:       //          xt=0.d0
 4135:       //          yt=0.d0
 4136:       //          !centroid coord. for nudging
 4137:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 4138:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 4139:          }  // ics
 4140: 
 4141: 
 4142: 
 4143:          // If on land or open boundary...
 4144:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4145:          
 4146:          const double vmag = length(side->u2[k]);
 4147: 
 4148:          if (vmag <= velmin_btrack) {
 4149:             // No activity 
 4150: 
 4151:             side->btu[k] = side->u2[k];
 4152:             
 4153:          } else {  // do btrack
 4154: 
 4155:             // Compute number of sub-divisions based on local gradients 
 4156:             // XXX IS THIS NECESSARY?
 4157:             double suma = 0.0;
 4158:             int icount = 0;
 4159:             for (int ii=0; ii<2; ii++) {
 4160: 
 4161:                const Element *elem = side->elems[ii];
 4162:                  
 4163:                if (elem == nullptr) continue;
 4164: 
 4165:                icount++;
 4166: 
 4167:                // Not strictly along z; in ll frame for ics=2
 4168: 
 4169:                double utmp[4];
 4170:                double vtmp[4];
 4171:                for (int jj = 0; jj < elem->i34; jj++) {
 4172: 
 4173:                   const Node *node = elem->nodes[jj];
 4174: 
 4175:                   if constexpr(ics==1) {
 4176:                      utmp[jj] = node->u2[k].x;
 4177:                      vtmp[jj] = node->u2[k].y;  
 4178:                   } else {
 4179:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4180:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4181:                   }
 4182:                } // for jj
 4183: 
 4184:                const Vector2 grad_u = elem->grad2(utmp); 
 4185:                const Vector2 grad_v = elem->grad2(vtmp);
 4186: 
 4187:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4188:             } // for ii
 4189: 
 4190:             assert(icount > 0 && "Impossible 77");
 4191: 
 4192:             // '4' is somewhat arbitrary
 4193:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4194: 
 4195:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4196:          
 4197: 
 4198:             Vector3 u_int = {0.0, 0.0, 0.0};
 4199: 
 4200:             side->btrack(k, dt, dtbk, u_int);
 4201:             side->btu[k] = toVector2(u_int);
 4202:                
 4203:          } // if vmag (do backtrack)
 4204: 
 4205:       } // for k=kb,nvrt-1
 4206: 
 4207:    }
 4208: 
 4209: } // extern "C"
 4210: 
 4211: template<int nc>
 4212: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4213: 
 4214: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4215: //
 4216: // a,b,c,rhs: input vectors and are not modified by this program.
 4217: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4218: // rhs is the r.h.s.
 4219: // n: actual rank of the system.
 4220: // rows in u() and rhs();
 4221: // u: output with nc columns (transposed to rows)
 4222: // gam: a working array.
 4223: //
 4224: // NOTES:
 4225: // This is a template function that allows for different numbers of columns in the rhs vector.
 4226: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4227: 
 4228:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4229:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4230: 
 4231:    double bet = b[0];
 4232:    if constexpr (nc == 1) {
 4233:       u[0] = rhs[0]/bet;
 4234:    } else {
 4235:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4236:    }
 4237: 
 4238:    for (int j = 1; j < n; j++) {
 4239:       gam[j] = c[j - 1]/bet;
 4240:       bet = b[j] - a[j]*gam[j];
 4241: 
 4242:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4243: 
 4244:       if constexpr (nc == 1) {
 4245:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4246:       } else {
 4247:          for (int l = 0; l < nc; l++) {
 4248:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4249:          }
 4250:       }
 4251:    }
 4252: 
 4253:    // Back-substitution
 4254:    for (int j = n - 2; j >= 0; j--) {
 4255:       if constexpr (nc == 1) {
 4256:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4257:       } else {
 4258:          for (int l = 0; l < nc; l++) {
 4259:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4260:          }
 4261:       }
 4262:    }
 4263: }
 4264: 
 4265: 
 4266: 
 4267: // Helper function that contains the core algorithm
 4268: template<typename XAccessor, typename YAccessor>
 4269: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4270:                                     double  yp_top, double  yp_bot, 
 4271:                                     CubicSpline &spline) {
 4272:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4273:    // 
 4274:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4275:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4276:    //
 4277:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4278:    // 
 4279:    // Inputs: 
 4280:    //            n: dimension for x etc; # of data pts (>=2);
 4281:    //            getX, getY: functions to access x,y coordinates
 4282:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4283:    //     Output: 
 4284:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4285: 
 4286:    const int n = k2 - k1 + 1;
 4287:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4288: 
 4289:    // Allocate memory for the splines
 4290:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4291:    spline.x   = new double[n];
 4292:    spline.y   = new double[n];
 4293:    spline.yp  = new double[n];
 4294:    spline.ypp = new double[n];
 4295: 
 4296:    for (int k=k1; k<=k2; k++) {
 4297:       spline.x[k] = getX(k);
 4298:       spline.y[k] = getY(k);
 4299:    }
 4300: 
 4301:    // This is to simplify expressions later
 4302:    double *x = spline.x;
 4303:    double *y = spline.y;
 4304: 
 4305:    double *a = nullptr;
 4306:    double *b = nullptr;
 4307:    double *c = nullptr;
 4308:    double *gam = nullptr;
 4309:    double *rhs = nullptr;
 4310:    
 4311: 
 4312:       a = new double[n];   // Lower diagonal
 4313:       b = new double[n];   // Diagonal
 4314:       c = new double[n];   // Upper diagonal
 4315:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4316:       rhs = new double[n]; // Right-hand side
 4317: 
 4318:    for (int k=k1; k<=k2; k++) {
 4319:       if (k == k1) {
 4320:          // Bottom level
 4321:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4322:          b[k] = (x[k+1] - x[k])/3.0;
 4323:          c[k] = b[k]/2.0;
 4324:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4325:       } else if (k == n - 1) {
 4326:          // Top level (surface)
 4327:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4328:          b[k] = (x[k] - x[k-1])/3.0;
 4329:          a[k] = b[k]/2.0;
 4330:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4331:       } else {
 4332:          // Intermediate levels
 4333:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4334:          b[k] = (x[k+1] - x[k-1])/3.0;
 4335:          a[k] = (x[k  ] - x[k-1])/6.0;
 4336:          c[k] = (x[k+1] - x[k  ])/6.0;
 4337:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4338:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4339:       }
 4340:    }
 4341: 
 4342:    // Solve the tridiagonal system
 4343:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4344:    
 4345:    spline.yp[k1] = yp_bot;
 4346:    spline.yp[k2] = yp_top;
 4347: 
 4348:    // Compute rest of 1st derivatives using the splines
 4349:    for (int k=k1+1; k<k2; k++) {
 4350:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4351:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4352:    }
 4353:    
 4354:    delete[] a;
 4355:    delete[] b;
 4356:    delete[] c;
 4357:    delete[] gam;
 4358:    delete[] rhs;
 4359: 
 4360: }
 4361: 
 4362: // Array version
 4363: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4364:                                 double y_top, double y_bot, 
 4365:                                 CubicSpline &spline) {
 4366:    auto getX = [x] (int k) { return x[k]; };
 4367:    auto getY = [y] (int k) { return y[k]; };
 4368:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4369: }
 4370: 
 4371: // Lambda version - allows custom access patterns
 4372: template<typename XFunc, typename YFunc>
 4373: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4374:                                 double y_top, double y_bot,
 4375:                                 CubicSpline &spline) {
 4376:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4377: }
 4378: 
 4379: 
 4380: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4381: {
 4382:    assert("Not implemented");
 4383: 
 4384:    return 0.0;
 4385: }
 4386: 
 4387: // __device__ void vertLinearInterp(int nc, double zt, int k1, int k2, double *za, double *s_in, double *s_out, int *ibelow) {
 4388: // //     Routine to do vertical linear interpolation in z
 4389: // //     Inputs:
 4390: // //
 4391: // //       nc: actual # of variables 
 4392: // //       k1,k2: lower and upper limits for za, s_in 
 4393: // //       zt: desired interpolation level
 4394: // //       za[0:nvrt-1]: z-coordinates for s_in (must be in ascending order)
 4395: // //       s_in[0:nc-1,0:nvrt-1]: values to be interpolated from; dimensions must match driving program
 4396: 
 4397: // //     Outputs:
 4398: // //       s_out[0:nc-1]: interpolated value @ z=zt (bottom value if ibelow=1). Constant extrapolation
 4399: // //                   is used below bottom or above surface.
 4400: // //       ibelow: flag indicating if zt is below za(k1)
 4401: // //
 4402: 
 4403: //    assert(k1 >= 0 && k2 < nvrt && "vertLinearInterp: k1 or k2 out of bounds");
 4404: //    assert(k1 <= k2 && "vertLinearInterp: k1 > k2");
 4405:    
 4406: //    ibelow = 0;
 4407: 
 4408: //    if (zt < za[k1]) {
 4409: //       // Below bottom
 4410: //       ibelow = 1;
 4411: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k1*nc];
 4412: 
 4413: //    } else if(zt>=za[k2]) {
 4414: //       // Above surface
 4415: //       for (int i = 0; i < nc; i++) s_out[i] = s_in[i + k2*nc];
 4416: 
 4417: //    } else {
 4418: //       // Normal case (between bottom and surface)
 4419:       
 4420: //       // Finds the level index using binary search
 4421: //       int l1 = k1;
 4422: //       int l2 = k2;
 4423: //       int k = (l1 + l2)/2;
 4424: //       while (l2 - l1 > 1) {  // Stop when we have adjacent levels
 4425: //           int k = (l1 + l2)/2;
 4426: //           if (zt >= za[k]) l1 = k;
 4427: //           else             l2 = k;
 4428: //       }
 4429: //       // Now l1 and l2 are adjacent levels and zt is between them
 4430: 
