 3527: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3528: 
 3529: 
 3530: __device__ void Node::updateKb(void) {
 3531: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3532: 
 3533:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3534: 
 3535: 
 3536:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3537: 
 3538:    if constexpr(ivcor == 2) {  // SZ coordinates
 3539:       
 3540:       // Compute bottom level index
 3541:       if (depth <= mesh->h_s) {
 3542:          kb = izlev;   
 3543:          
 3544:       } else {
 3545:          kb = -1;
 3546:          int L = 0;
 3547:          int R = nzlev; 
 3548:          
 3549:          while (L <= R) {
 3550:             int M = (R + L) / 2;
 3551: 
 3552: 
 3553:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3554:             
 3555:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3556:                R = M;
 3557:             } else {
 3558:                L = M;
 3559:             }
 3560: 
 3561:             if (R - L == 1) {
 3562:                kb = L;
 3563:                break;
 3564:             }
 3565:          }
 3566: 
 3567:          // Checks that the binary search was successful
 3568:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3569:        
 3570:       }
 3571:    } 
 3572: }
 3573: 
 3574: 
 3575: __device__ __inline__ void Node::updateZCoordData(void) {
 3576: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3577: 
 3578:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3579:    // if (isDry2()) {
 3580:    //    kb = -1;  // XXXXXXXX KKKKK
 3581:    //    return;
 3582:    // }
 3583: 
 3584: 
 3585:    if constexpr(ivcor == 2) {  // SZ coordinates
 3586:       
 3587:       // Compute bottom level index
 3588:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3589:    } 
 3590:    else {  // if (ivcor == 1) Localized sigma
 3591:       // Do nothing
 3592:    }
 3593: 
 3594: 
 3595: }
 3596: 
 3597: 
 3598: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3599:    // Computes the z coordinate at level k.
 3600:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3601:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3602:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3603:    // used 
 3604: 
 3605:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3606:    
 3607:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3608: 
 3609:    if (isDry2()) return 0.0;  
 3610: 
 3611:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3612: 
 3613:    if constexpr(ivcor == 2) {
 3614: 
 3615:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3616:       const double h_c = mesh->h_c;
 3617:       const double theta_f = mesh->theta_f;
 3618:       const double sinh_theta_f = mesh->sinh_theta_f;
 3619: 
 3620: 
 3621:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3622:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3623:       // once per time step/node. XXXX
 3624:       // CHECK: updateZCoordData
 3625: 
 3626:       //  To simplify comparisons, I define index versions of count variables.
 3627:       if      (k == ivrt)     return eta2; 
 3628:       else if (k == izlev)    return -hmod2;
 3629:       else if (k == kb)       return -depth;
 3630:       else if (k < izlev)     return mesh->ztot[k];
 3631:       else if (k > izlev) {
 3632:          const int ksig = k - izlev;
 3633: 
 3634:          if (hmod2 <= h_c) {
 3635:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3636: 
 3637:          } 
 3638:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3639:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3640:             assert(false && "compZCoord: invalid h_c\n");
 3641:          } 
 3642:          else {
 3643:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3644:                    h_c * mesh->sigma[ksig] + 
 3645:                    (hmod2 - h_c) * mesh->cs[ksig];
 3646:          }
 3647:       } else { 
 3648:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3649:       }
 3650: 
 3651:    }
 3652:    else {  // if constexpr(ivcor == 1)
 3653:       if (k <= kb)        return -depth; 
 3654:       else if (k == ivrt) return eta2;
 3655:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3656: 
 3657:    }
 3658:    
 3659:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3660:    return 0.0;
 3661: }
 3662: 
 3663: 
 3664: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3665:    // Computes the bottom drag Cd based on the selected nchi
 3666: 
 3667:    if constexpr(nchi == 0) {
 3668:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3669:       Cd = drag;  // Read from drag file
 3670: 
 3671:    } else if constexpr(nchi == 1) {
 3672:       // 
 3673: 
 3674:       bool ltmp = false; // for WBL iteration
 3675: 
 3676:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3677:       if (isDry || (rough == 0.0)) {
 3678:          Cd = 0.0;
 3679: 
 3680:       } else { //roughness >0 
 3681:          
 3682:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3683: 
 3684:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3685: 
 3686:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3687: 
 3688:       } // if rough
 3689: 
 3690:    } else if constexpr(nchi == -1) {
 3691:    // Manning 
 3692:  
 3693:       const double htot = max(hmin_man, htot2()); 
 3694:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3695: 
 3696:    } else {
 3697:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3698:       
 3699:    } // if nchi
 3700: 
 3701: }
 3702: 
 3703: 
 3704: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3705:    // Checks if a side in on the boundary
 3706:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3707: 
 3708:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3709:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3710: 
 3711:    // Indices of the nodes that form the side
 3712:    const int n1 = side.n1->idx;
 3713:    const int n2 = side.n2->idx;
 3714:    isLand = false;
 3715:    
 3716: 
 3717:    // Check if the side is on a land boundary
 3718:    for (int i = 0; i < nland; i++) {
 3719:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3720:          // Consecutive nodes in the land boundary segment
 3721:          const int b1 = ilnd[i + j*nland];
 3722:          const int b2 = ilnd[i + (j + 1)*nland];
 3723: 
 3724:          assert(b1 != -1 && b2 != -1);
 3725: 
 3726:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3727:             
 3728:             isLand = true;
 3729:             return i;
 3730:          }
 3731:       }
 3732:    }
 3733: 
 3734:    // Check if the side is on an open boundary
 3735:    for (int i = 0; i < nope; i++) {
 3736:       for (int j = 0; j < nond[i] - 1; j++) {
 3737:          // Consecutive nodes in the open boundary segment
 3738:          const int b1 = iond[i + j*nope];
 3739:          const int b2 = iond[i + (j + 1)*nope];
 3740: 
 3741:          assert(b1 != -1 && b2 != -1);
 3742: 
 3743:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3744:             isLand = false;
 3745:             return i;
 3746:          }
 3747:       }
 3748:    }
 3749: 
 3750:    return -1;
 3751: }
 3752: 
 3753: 
 3754: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3755:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3756:                                     double *wind_rotate_angle, 
 3757:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3758:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3759:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3760:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3761:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3762: 
 3763:    NODE(pnode);  
 3764:    const int i = idx_node;
 3765:    Node &node(*pnode);
 3766: 
 3767:    node.idx = i;
 3768: 
 3769:    const int idxNodeStart = nodeNeighNodesStart[i];
 3770:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3771:    node.numNodes = idxNodeEnd - idxNodeStart;
 3772:    node.nodes = nodeNeighNodes + idxNodeStart;
 3773:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3774: 
 3775: 
 3776: 
 3777:    const int idxElemStart = nodeNeighElemsStart[i];
 3778:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3779:    node.numElements = idxElemEnd - idxElemStart;
 3780:    node.elements = nodeNeighElems + idxElemStart;
 3781: 
 3782: 
 3783:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3784:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3785:       const int partNode = localNodePart[idxNodeGlobal]; 
 3786:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3787: 
 3788:       Node *node_ptr = nodes[partNode] + idxNode;
 3789:       
 3790:       nodeNeighNodes[idx] = node_ptr;
 3791:    }
 3792: 
 3793: 
 3794:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3795:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3796:       const int partElem = localElemPart[idxElemGlobal];
 3797:       const int idxElem  = localElemIndices[idxElemGlobal];
 3798: 
 3799:       Element *elem_ptr = elems[partElem] + idxElem;
 3800: 
 3801:       nodeNeighElems[idx] = elem_ptr;
 3802:    }      
 3803: 
 3804:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3805:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3806:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3807: 
 3808:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3809:    if constexpr(ics == 1) {
 3810:       node.p.x   = node_coords[i * 3];
 3811:       node.p.y   = node_coords[i * 3 + 1];
 3812:       node.gz = 0.0;
 3813: 
 3814:    } else {
 3815:       const double lon = deg2rad*node_coords[i * 3];
 3816:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3817: // printf("lat = %f, lon = %f, x = %f, y = %f\n", lat, lon, node.lat, node.lon); 
 3818:       Point3 p = computeXYZfromLatLon(lat, lon);
 3819:       node.p = toVector2(p);
 3820:       node.gz = p.z;
 3821:       node.lon = lon;
 3822:       node.lat = lat;
 3823: 
 3824:       #ifdef USE_FRAMES
 3825:       node.setFrame(lat, lon);
 3826:       #endif
 3827: 
 3828: 
 3829:    }
 3830: 
 3831:    node.depth = node_coords[i * 3 + 2];
 3832: 
 3833:    node.numSides = 0;
 3834: 
 3835:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3836:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3837:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3838:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3839:    else assert(false && "populateNodes: selected nchi not implemented.");
 3840:    
 3841:    if constexpr(ivcor == 1) 
 3842:    {  
 3843:       node.kb = kb[i];
 3844:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3845:    }
 3846: 
 3847:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3848:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3849:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3850: 
 3851:    
 3852:    // Links the node to the boundary information
 3853:    if (isbnd[i] >= 0) {
 3854:      
 3855:       // Get the index of the node boundary
 3856:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3857: 
 3858:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3859:       node.nodeBnd->node = &node;
 3860: 
 3861:       node.nodeBnd->sideBnd1 = nullptr;
 3862:       node.nodeBnd->sideBnd2 = nullptr;
 3863: 
 3864:       if (isbnd[i]>=0) {
 3865: 
 3866:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3867:          
 3868:          node.nodeBnd->segment->ifltype = 3 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3869:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3870: 
 3871:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3872:          node.nodeBnd->segment->clen  = nan("1");
 3873:          node.nodeBnd->segment->carea = nan("1");
 3874: 
 3875:       }
 3876:    } else {
 3877: 
 3878:       node.nodeBnd = nullptr; // For internal nodes
 3879: 
 3880:       if (isbnd[i] == landSegment) {
 3881:          node.nodeBnd = &landBoundaryNode;
 3882:          node.nodeBnd->segment = &landBoundarySegment;
 3883:       }
 3884:       
 3885:    }
 3886:    
 3887:    // XXXX GAUSSIAN HILL VELOCITIES
 3888: #ifdef GAUSSIAN_HILL_VELOCITIES
 3889:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3890:       constexpr double rot_per = 3000.0;
 3891:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3892:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3893:    // XXXXX
 3894: #endif
 3895: 
 3896: }
 3897: 
 3898: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3899:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3900:                                     double *wind_rotate_angle,   
 3901:                                     int *isdel, int *isidenode, int *isbnd,
 3902:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3903:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3904:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3905:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3906:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3907:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3908:                                     double *drag, double *roughness) {
 3909: 
 3910: 
 3911:    SIDE(pside);
 3912:    Side &side(*pside);
 3913:    const int i = idx_side;
 3914: 
 3915:    side.idx = i;  
 3916:    
 3917:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3918:    const double fc   = 2.0*omega_e*sin(sfea0);
 3919:    const double beta = 2.0*omega_e*cos(sfea0);
 3920: 
 3921:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3922: 
 3923:    // finding the pointer to the nodes that form the side
 3924:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3925:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3926: 
 3927:    const int locidx_n1 = localNodeIndices[idx_n1];
 3928:    const int locidx_n2 = localNodeIndices[idx_n2];
 3929:    const int part_n1 =   localNodePart[idx_n1];
 3930:    const int part_n2 =   localNodePart[idx_n2];
 3931: 
 3932:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3933:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3934: 
 3935: 
 3936:    // Counts the number of sides connected to each node
 3937:    side.n1->numSides++;
 3938:    side.n2->numSides++;
 3939: 
 3940:    // Normal, unitary vector to the side
 3941:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3942:    side.n = normalize(side.n);
 3943: 
 3944:    // Side boundary type
 3945:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3946:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3947: 
 3948:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3949:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3950:    {
 3951:       bool isLand = false;
 3952:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3953:       
 3954:       if (isbs > -1) {
 3955:          // assert(isLand || isbs>=0);
 3956:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3957: 
 3958:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3959: 
 3960:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3961:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3962: 
 3963:          assert (isLand == side.sideBnd->segment->isLand);
 3964: 
 3965:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3966:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3967:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3968: 
 3969:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3970:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3971:          
 3972:          side.sideBnd->side = &side;
 3973: 
 3974:       }
 3975:       else {
 3976:          side.sideBnd = nullptr;
 3977:       }
 3978:    }
 3979:    else 
 3980:    {
 3981:       side.sideBnd = nullptr;
 3982:    }
 3983: 
 3984: 
 3985:    // finding the pointer to the elements that share the side
 3986:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3987:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3988: 
 3989:    if (idx_e1 > -1) {
 3990:       const int locidx_e1 = localElemIndices[idx_e1];
 3991:       const int part_e1 =  localElemPart[idx_e1];
 3992:       side.elems[0] = elems[part_e1] + locidx_e1;
 3993: 
 3994:    }
 3995:    else {
 3996:       side.elems[0] = nullptr;
 3997:    }
 3998: 
 3999:    if (idx_e2 > -1) {
 4000:       const int locidx_e2 = localElemIndices[idx_e2];
 4001:       const int part_e2 =  localElemPart[idx_e2];
 4002:       side.elems[1] = elems[part_e2] + locidx_e2;
 4003:    }
 4004:    else {
 4005:       side.elems[1] = nullptr;
 4006:    }
 4007: 
 4008:    // Compute the center of the side
 4009:    side.center = 0.5*(side.n1->p + side.n2->p);
 4010: 
 4011:    #ifdef USE_FRAMES
 4012:    side.setFrame();
 4013:    #endif
 4014: 
 4015:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4016:    side.shapiro = shapiro0;
 4017: 
 4018: #ifdef GAUSSIAN_HILL_VELOCITIES
 4019: // XXXX
 4020: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4021: constexpr double rot_per=3000.0;
 4022: constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4023: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4024: // XXXXX      
 4025: #endif
 4026:    // Compute the z level at the center of the side
 4027:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4028:    
 4029:    // Compute the length of the side
 4030:    const Vector2 vLen = side.n2->p - side.n1->p;
 4031:    side.len = sqrt(dot(vLen, vLen));
 4032: 
 4033: 
 4034:    // Compute the Coriolis coefficient
 4035: 
 4036:    if constexpr(ncor == -1 || ncor == 0) {
 4037:       side.coriolis = coricoef;
 4038:    }
 4039:    else {
 4040:       const double sphi = side.lat();  // Latitude at the center of the side
 4041: 
 4042:       assert(use_ll && "use_ll must be true when ncor > 0");
 4043: 
 4044:       if constexpr(ics == 1) {
 4045:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4046:       }
 4047:       else { // ics == 2
 4048:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4049:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4050:       }
 4051: 
 4052:    }
 4053: 
 4054: }
 4055: 
 4056: 
 4057: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4058:    double *node_coords, double *node_coords_ll, bool use_ll,
 4059:    double *wind_rotate_angle,   
 4060:    int *isdel, int *isidenode, int *isbnd,
 4061:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4062:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4063:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4064:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4065:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4066:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4067:    double *drag, double *roughness) {
 4068: 
 4069:    ELEM(pelem);
 4070:    Element &elem(*pelem);
 4071:    const int i = idx_elem;
 4072: 
 4073:    elem.idx = i;
 4074: 
 4075:    for (int j = 0; j < i34[i]; j++) {
 4076:       const int idxNode = elnode[i*4 + j];  
 4077:       const int idxSide = elside[i*4 + j];
 4078:       
 4079:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4080:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4081: 
 4082:       // Find the neighboring element  
 4083:       if (elem.sides[j]->elems[0] == &elem) {
 4084:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4085:       }
 4086:       else {
 4087:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4088:       }
 4089:       
 4090:    }
 4091: 
 4092:    elem.i34 = i34[i];
 4093: 
 4094:    // Compute the barycenter of the element and its depth
 4095:    elem.center = {0.0, 0.0};
 4096:    elem.depth = 1e10;
 4097:    for (int j = 0; j < i34[i]; j++) {
 4098: 
 4099:       elem.center += elem.nodes[j]->p/i34[i];
 4100:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4101:    }
 4102: 
 4103:    #ifdef USE_FRAMES
 4104:    elem.setFrame();
 4105:    #endif
 4106: 
 4107:    elem.area = elem.computeSignedArea(); 
 4108:    elem.radius = sqrt(elem.area)/pi; 
 4109:    
 4110:    // Determines which way the normal vector to each side is oriented.
 4111:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4112:    for (int j = 0; j < i34[i]; j++)  
 4113:    {
 4114:       if (elem.sides[j]->elems[0] == &elem) {
 4115:          elem.ssign[j] =  1.0;
 4116:       }
 4117:       else {
 4118:          elem.ssign[j] = -1.0;
 4119:       }
 4120: 
 4121:    }
 4122: 
 4123:   
 4124: 
 4125:    // Derivatives of shape functions
 4126:    //  For ics=2, this is done in the element frame
 4127:    //  For quads, the derivative is evaluated at centroid
 4128:    for (int j = 0; j < elem.i34; j++) {
 4129:       const double area = elem.area;
 4130:       const int id2 = elem.nxq(1 + j);
 4131:       const int id3 = elem.nxq(2 + j);
 4132:       const int id4 = elem.nxq(3 + j);
 4133:       if (elem.isTri()) {
 4134:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4135:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4136:          // da1/dx = (y1 - y2)/(2*area)
 4137: 
 4138:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4139:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4140:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4141: 
 4142:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4143:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4144: 
 4145:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4146: 
 4147:       }
 4148:       else  { // Quad; evaluate at centroid
 4149: 
 4150:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4151:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4152:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4153: 
 4154:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4155:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4156: 
 4157:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4158:       } // if Tri
 4159: 
 4160:    } // for j   
 4161:    
 4162:    
 4163: 
 4164: }
 4165: 
 4166: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4167:                                             double *emo, double *efa, 
 4168:                                             double *umo, double *ufa, 
 4169:                                             double *vmo, double *vfa) {
 4170: 
 4171:    NODE_BND(nodeBnd);
 4172:    const int idx = idx_node_bnd;    
 4173: 
 4174:    nodeBnd->idx = idx;
 4175: 
 4176:    // Need to find the segment index and the index of the node on the segment
 4177:    int idxNode = -1;
 4178:    int iseg, i;
 4179:    for (iseg = 0; iseg < nope; iseg++) {
 4180:       // for each segment...
 4181:       for (i = 0; i < nond[iseg]; i++) {
 4182:          idxNode = iond[iseg + i*nope];
 4183:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4184:          
 4185:       }
 4186:    }
 4187: 
 4188:    assert(iseg < nope && "iseg is out of bounds");
 4189: 
 4190: found: // Jumped here when the node was found
 4191: 
 4192:    nodeBnd->isEssentialBC = true;
 4193:    nodeBnd->elbc = 0.0;
 4194: 
 4195:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4196: 
 4197:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4198:       nodeBnd->efa[jfr] = efa[idx2];
 4199:       nodeBnd->emo[jfr] = emo[idx2];
 4200:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4201:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4202: 
 4203:    }
 4204:         
 4205: 
 4206: }
