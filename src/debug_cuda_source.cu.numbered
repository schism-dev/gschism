 1970: struct Mesh {
 1971:    public:  
 1972: 
 1973:    int partNum; // Partition number for this mesh.
 1974: 
 1975:    // Pointers to each GPU's local memory (size is the number of partitions).
 1976:    Node**    nodes;  
 1977:    Element** elems;  
 1978:    Side**    sides;  
 1979:    
 1980:    // Local memory
 1981:    Node*    localNodeData; 
 1982:    Element* localElemData;
 1983:    Side*    localSideData; 
 1984: 
 1985:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1986:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1987:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1988:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1989:    
 1990:    const int npgb;  // Global number of horizontal nodes
 1991:    const int negb;  // Global number of elements
 1992:    const int nsgb;  // Global number of sides
 1993: 
 1994:    const int np;   // Local number of horizontal nodes 
 1995:    const int ne;   // Local number of elements
 1996:    const int ns;   // Local number of sides
 1997: 
 1998:    int nbp;  // Local number of boundary nodes
 1999:    int nbs;  // Local number of boundary sides
 2000: 
 2001:    int nEntries;  // Total number of matrix elements
 2002: 
 2003:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 2004:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 2005:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 2006: 
 2007:   
 2008:    // Additional topology information
 2009:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 2010:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 2011:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 2012: 
 2013:    BoundarySegment *landBoundarySegment;
 2014:    NodeBoundary *landBoundaryNode;
 2015: 
 2016:    // Vertical coordinate system
 2017:    // Sigma levels
 2018:    double h_s; 
 2019:    double h_c; 
 2020: 
 2021:    double theta_b;
 2022:    double theta_f, sinh_theta_f;
 2023:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 2024:    double *ztot;
 2025:    double *cs;
 2026:    double *dcs;
 2027: 
 2028: 
 2029: 
 2030:    __device__ Mesh(int partNum,
 2031:                    int npgb, int negb, int nsgb, 
 2032:                    int np, int ne, int ns,
 2033:                    int max_np, int max_ne, int max_ns, int nseg,
 2034:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 2035:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 2036:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 2037:                    Node    **localNodeNeighNodesMem,
 2038:                    Element **localNodeNeighElemsMem,
 2039:                    int16_t *localNodePermutationSortMem,
 2040:                    double *partCoeffMatrixMem,
 2041:                    NodeBoundary *localNodeBoundaryMem,
 2042:                    SideBoundary *localSideBoundaryMem,
 2043:                    BoundarySegment *localSegmentMem,
 2044:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 2045:                    double *cs, double *dcs
 2046:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 2047:                        np(np), ne(ne), ns(ns),
 2048:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 2049:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 2050:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 2051:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 2052:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 2053:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 2054:                        localSegmentMem(localSegmentMem),
 2055:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 2056:                        cs(cs), dcs(dcs),
 2057:                        landBoundarySegment(plandSegMem),
 2058:                        landBoundaryNode(plandNodeBndMem)
 2059:    {
 2060:       printf("Mesh constructor for partition %d\n", partNum);
 2061: 
 2062:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 2063:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 2064:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 2065:  
 2066:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 2067:       
 2068:       sinh_theta_f = sinh(theta_f);
 2069: 
 2070:       *landBoundaryNode    = NodeBoundary(true);
 2071:       *landBoundarySegment = BoundarySegment(true);   
