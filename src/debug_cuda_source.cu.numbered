 5558:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5559: 
 5560:       SIDE(side);
 5561: 
 5562:       side->U = {0.0, 0.0}; 
 5563:          
 5564:       if(side->isDry) return;
 5565: 
 5566:       // Vertically integrated velocity U
 5567:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5568:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5569:          side->U += side->Dz(k + 1)*uc;  
 5570:       }
 5571: 
 5572:    }
 5573: 
 5574:    __global__ void computeBottomDragVegetation(void) {
 5575:       // UNFINISHED. CHECK THIS:
 5576:       // How many kernels are needed? Why so many for loops?
 5577:       // Is the loop on sides needed?
 5578: 
 5579:       NODE(node);
 5580: 
 5581: 
 5582:       const int    kb      = node->kb;
 5583:       const double htot    = node->htot2(); 
 5584:       
 5585:       if (node->isDry) {
 5586:          // Default values for dry nodes
 5587:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5588:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5589: 
 5590:          return;
 5591:        
 5592:       }
 5593: 
 5594:       // Computes bottom drag Cd based on the selected nchi
 5595:       node->computeBottomDragCd();
 5596:       
 5597: 
 5598: 
 5599:       //   Bottom stress in m^2/s^2
 5600:       if (node->rho[kb + 1] >= -98.0)
 5601:       {
 5602:          const double mag_u = length(node->u2[kb + 1]);
 5603:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5604: 
 5605:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5606:          // !sediment erosion: this part needs more documentation
 5607:       }
 5608:     
 5609: 
 5610: 
 5611:       // Compute vegetation parameters
 5612:       //--------------------------------
 5613: 
 5614:       // SAV constants
 5615:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5616:       constexpr double veg_cfpsi = 0.16;
 5617: 
 5618:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5619:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5620: 
 5621:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5622:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5623:          int kbin = 0; // bin index
 5624:          for (int k = kb; k < nvrt; k++) {
 5625:             // Computes node height above the bottom level
 5626:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5627:             assert(false && "Vertical variation of vegetation not implemented");
 5628: 
 5629:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5630:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5631:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5632:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5633:             // } else {
 5634:             //    // Find the bin at which the current vertical level is
 5635:             //    while (kbin<nbins_veg_vert) {
 5636:             //       const double zn = node->z[kbin];
 5637:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5638:             //          break;
 5639:             //       } // if
 5640:             //       kbin++;
 5641:             //    } // while
 5642:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5643: 
 5644:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5645:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5646:                
 5647:             //    // Linear interpolation of the vegetation parameters
 5648:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5649:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5650:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5651:             // } // if rl10
 5652: 
 5653:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5654: 
 5655:          } // for k
 5656: 
 5657: 
 5658:       } else { // Ganthy (iveg==2)
 5659:       //  Modify canopy height, diameter, and density
 5660: 
 5661:          // Make sure there is vegetation on this node
 5662:          if (node->veg_h_unbent > 0.0) {
 5663:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5664: 
 5665:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5666:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5667:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5668: 
 5669:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5670:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5671:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5672:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5673:          } // if veg_h_unbent
 5674: 
 5675:          for (int k = 0; k < nvrt; k++) {
 5676:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5677:          } // for k
 5678:       
 5679: 
 5680:       } // if iveg
 5681:      
 5682: 
 5683:       // Compute vertical mean of veg_alpha3D
 5684:       if (iveg != 0) {
 5685:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5686:          double sum1=0.0;
 5687:          double sum2=0.0;
 5688:          // Integrate over each level under the canopy...
 5689:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5690:             const double Dz = node->Dz(k);
 5691: 
 5692:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5693:             sum2 += Dz;
 5694: 
 5695:          } // for k
 5696:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5697:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5698: 
 5699:       } // if iveg
 5700: 
 5701:    }
 5702: 
 5703:    __global__ void computeVegetationAndDragParameters(void) {
 5704:       // Computes the vegetation and drag model parameters:
 5705:       // chi, \tilde\chi, beta, \breve{H}
 5706:       
 5707:       SIDE(side);
 5708: 
 5709:       side->hhat = 0.0;
 5710:       side->chi2 = 0.0;
 5711:       side->chi = 0.0;
 5712:       side->veg_c2 = 0.0;
 5713:       side->veg_beta = 0.0;
 5714: 
 5715:       if (side->isDry) return;
 5716: 
 5717:       const double htot = side->htot2();
 5718:       const int    kb   = side->kb;
 5719: 
 5720:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5721: 
 5722:       const double veg_h     = side->veg_h();
 5723:       const double veg_nv    = side->veg_nv();
 5724:       const double veg_c     = side->veg_c();
 5725:       const double veg_beta  = side->veg_beta;
 5726:       const double veg_alpha = side->veg_alpha_vert_mean();
 5727: 
 5728:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5729:       // Velocity magnitude at the bottom level
 5730:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5731:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5732:       side->chi2 = side->Cd()*vmag1;
 5733:       side->chi  = side->chi2;
 5734:       if constexpr(iveg != 0) {
 5735:          const Node *n1 = side->n1;
 5736:          const Node *n2 = side->n2;
 5737:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5738:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5739:       }
 5740: 
 5741:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5742: 
 5743:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5744:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5745:       double magUa = 0.0;
 5746:       if constexpr(iveg != 0) {
 5747:          if (side->is3D() && veg_h > 0.0) {
 5748:             // 3D wet side with veg...
 5749: 
 5750:             double magUa = 0.0;
 5751:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5752:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5753: 
 5754:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5755:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5756:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5757: 
 5758:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5759:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5760: 
 5761:                   // Velocity magnitude at the bottom (l) of the level
 5762:                   const double ul = length(side->u2[k]);
 5763: 
 5764:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5765:                   magUa += Dz*0.5*(uh + ul);
 5766: 
 5767:                } // if HasVegetation
 5768:             } // for k
 5769:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5770: 
 5771:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5772:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5773:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5774:                const double zCpy = side->zTopCanopy();
 5775:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5776:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5777:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5778:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5779:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5780:             } // if isSubmerged
 5781:          } // if is3D
 5782:       } // if iveg   
 5783: 
 5784:       // Computes the friction modified depth, \breve{H} in notes
 5785:       if (side->is2D()) { // 2D
 5786: 
 5787:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5788:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5789: 
 5790:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5791: 
 5792:          side->hhat = htot*htot/fricH; 
 5793: 
 5794:       } else { // 3D
 5795:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5796: 
 5797:          if constexpr(iveg != 0) {
 5798:             
 5799:             if (side->isSubmerged()) { 
 5800:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5801:                side->hhat -= veg_c*Hhat_alpha;
 5802: 
 5803:             } else { // Emergent
 5804:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5805:             }
 5806:          } // if iveg
 5807: 
 5808:          // Enforce positivity for 3D model
 5809:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5810:       } // if 3D
 5811: 
 5812:    }
 5813: 
 5814: 
 5815: 
 5816:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5817:    // Computes the density gradient between two elements, e1 and e2.
 5818:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5819:    // zero in the direction normal to the side. 
 5820:    // 
 5821:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5822:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5823:    //
 5824:    // Input:
 5825:    //    e1: Element
 5826:    //    e2: Neighbor element (or nullptr if boundary)
 5827:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5828:    //    k: Index of the half-level at which the density is interpolated
 5829:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5830:    // 
 5831:    // Output:
 5832:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5833:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5834: 
 5835:       if (e2 == nullptr || e2->isDry) {
 5836:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5837: 
 5838:          Side *side = e1->sides[j];
 5839:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5840:                  
 5841:          if constexpr(ics == 1) {
 5842:             vec = side->n; // Normal vector to the side
 5843:          } else {
 5844:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5845:             // IMPLEMENT THIS XXXXXX
 5846:             // !replace with xel, yel?
 5847:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5848:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5849:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5850:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5851:          } //ics
 5852:                    
 5853:          diffRho = 0.0;
 5854: 
 5855:       } else { //internal and wet
 5856:          if constexpr(ics==1) {
 5857:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5858: 
 5859:             // Vector from e1 to e2
 5860:             vec = e2->center - e1->center;
 5861: 
 5862:          } else { 
 5863:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5864:             // Remember that elem->center is in global coordinates
 5865:             // IMPLEMENT THIS XXXXXX
 5866:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5867:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5868:             //                   alow(j)=xctr2
 5869:             //                   bdia(j)=yctr2
 5870:          } // ics
 5871: 
 5872:          diffRho = rho2 - e1->demeanedDensity(k);
 5873:       }
 5874: 
 5875:    }
 5876: 
 5877:    __global__ void computeDensityCubicSplines(void) {
 5878:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5879: 
 5880:       ELEM(elem);
 5881: 
 5882:       if (elem->isDry) return;
 5883: 
 5884:       const int kb = elem->kb;
 5885: 
 5886:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5887:       if (elem->is2D()) {
 5888:          // In the 2D case, the density is constant at the prism level. 
 5889:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5890:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5891:       } else { //3D
 5892: 
 5893:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5894:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5895:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5896:          ///// XXXX CHECK INDICES!!!!!
 5897:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5898:       } // 2D/3D
 5899: 
 5900:    }
 5901: } // extern "C"
 5902: 
 5903: 
 5904: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5905: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5906: 
 5907:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5908: 
 5909:    const int kb  = elem->kb;
 5910:    const int kb2 = elem2->kb;
 5911: 
 5912:    // z-coordinate of prism of elem
 5913:    const double zp = elem->z_prism(k);
 5914: 
 5915:    double rho = 0.0;
 5916: 
 5917:    if (elem2->is2D()) {
 5918:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5919: 
 5920:    } else {  // 3D
 5921: 
 5922:       // eta_min may be < zmax
 5923:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5924:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5925: 
 5926:       // (Extrapolate density below bottom, we will fix it later)
 5927:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5928:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5929:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5930:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5931:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5932:    } // 2D/3D
 5933:      
 5934: 
 5935:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5936:    // Now we need to fix it.
 5937:    if (elem->z[k] < elem2->z[kb2]) {
 5938:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5939: 
 5940:       // There are two methods to adjust the density at the bottom of the element.
 5941:       // iunder_deep=0: 
 5942:       const double depth1 = abs(elem->z[kb]); // larger depth
 5943: 
 5944:       if (iunder_deep==0) {
 5945: 
 5946:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5947: 
 5948:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5949: 
 5950:       } else { // iunder_deep != 0
 5951: 
 5952:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5953: 
 5954:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5955: 
 5956:          //   Demeaned density at the same z coordinate as
 5957:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5958:          }
 5959: 
 5960:       } // if iunder_deep
 5961:    } // if elem->z[kb] < elem2->z[kb]
 5962: 
 5963:    return rho;
 5964: }
 5965: 
 5966: 
 5967: extern "C" {
 5968:    __global__ void computeDensityGradient(void) {
 5969: 
 5970:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 5971:       if constexpr(ibc != 0) return;
 5972: 
 5973:          // Compute the horizontal density gradient at each element.
 5974:       // It works in two steps:
 5975:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5976:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5977:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5978:       //             gradRho.r1 = rho1 - rho0
 5979:       //             gradRho.r2 = rho2 - rho0
 5980:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5981:       // 
 5982:       //  NOTE: We use de-meaned densities.
 5983: 
 5984:       ELEM(elem);
 5985: 
 5986:       if (elem->isDry) return;
 5987: 
 5988:       const int kb  = elem->kb;
 5989:       const int i34 = elem->i34;
 5990: 
 5991:       for (int k = kb + 1; k < nvrt; k++) {
 5992:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5993:          //             gradRho.r1 = rho1 - rho0
 5994:          //             gradRho.r2 = rho2 - rho0
 5995:          int icount = 0;
 5996:          double sumRx = 0.0;
 5997:          double sumRy = 0.0;
 5998:          for (int j1=0; j1<i34; j1++) { 
 5999: 
 6000:             const int j2 = elem->nxq(j1 + 1);
 6001: 
 6002:             // Pairs of consecutive neighbor elements of elem
 6003:             const Element *e1 = elem->nghbElems[j1];
 6004:             const Element *e2 = elem->nghbElems[j2];
 6005: 
 6006:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6007:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6008:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6009: 
 6010:             // Compute the density difference and the vector from elem to e1 and e2
 6011:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6012:             double diffRho1, diffRho2;
 6013:             Vector2 vec1, vec2;
 6014:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6015:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6016: 
 6017:             const double rl1 = length(vec1);
 6018:             const double rl2 = length(vec2);
 6019:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6020: 
 6021:             const double delta = cross(vec1, vec2);
 6022:             const double sintheta = abs(delta)/(rl1*rl2);
 6023: 
 6024:             // To avoid problems, avoid elements with small angle between vectors
 6025:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6026:             const bool validEq = (sintheta > sin_one_deg);
 6027: 
 6028:             if (validEq) {
 6029:                // Solve the system of equations to get the density gradient at elem
 6030:                icount++;
 6031:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6032:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6033:                sumRx += Rx;
 6034:                sumRy += Ry;
 6035:             }
 6036:          } // for j1
 6037: 
 6038:          // Compute the average density gradient at elem
 6039:          if (icount==0) {
 6040:            // Bad mesh quality; bail out with 0 b-cc
 6041:            elem->gradRho[k] = {0.0, 0.0};
 6042:          } else {
 6043:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6044:          }
 6045: 
 6046:       } // for k
 6047: 
 6048:    }
 6049: 
 6050:    __global__ void computeBaroclinicTerm(void) {
 6051:    // Computes the baroclinic term at sides (at half levels).
 6052:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6053:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6054: 
 6055:       if (ibc == 1) return;
 6056: 
 6057:       SIDE(side);
 6058: 
 6059:       if (side->isDry) return;
 6060: 
 6061:       const Element *e1 = side->elems[0];
 6062:       const Element *e2 = side->elems[1]; 
 6063:       const int kb = side->kb;
 6064:       
 6065:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6066: 
 6067:       // interpolates vertically the density gradient of the two elements at the half level/
 6068: 
 6069:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6070:       int k2 = max(kb, nvrt / 2);
 6071: 
 6072:       // Starts the integration at the surface and goes down to the bottom
 6073:       side->bcc[nvrt-1] = {0.0, 0.0};
 6074:       for (int k = nvrt - 2; k >= kb; k--) {
 6075:       // For each prism level (from surface to bottom)...
 6076: 
 6077:          // For both elements, interpolate density gradient at the side's half level.
 6078:          // The gradient at the side is the average of the gradients at the elements.
 6079:          // w1, w2 are used to take into account boundary sides, with just one element.
 6080:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6081:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6082:          const double wsum = w1 + w2;
 6083:          w1 = w1/wsum;
 6084:          w2 = w2/wsum;
 6085:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6086: 
 6087:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6088:          Vector2 gradRho = {0.0, 0.0};
 6089:          if (e1 != nullptr && k > kb) {
 6090:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6091:             
 6092:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6093:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6094:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6095: 
 6096:             // Grad(rho) vertically interpolated at the side's half level
 6097:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6098: 
 6099:             // Projects the element density gradient to the side frame if needed.
 6100:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6101: 
 6102:             // Adds the contribution of the density gradient at the side's half level
 6103:             gradRho += gradRho1*w1;
 6104:          }      
 6105:          if (e2 != nullptr && k > kb) {
 6106:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6107:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6108:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6109:             
 6110:             // Grad(rho) vertically interpolated at the side's half level
 6111:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6112: 
 6113:             // Projects the element density gradient to the side frame if needed.
 6114:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6115: 
 6116:             // Adds the contribution of the density gradient at the side's half level
 6117:             gradRho += gradRho2*w2;
 6118:          }
 6119: 
 6120:          
 6121:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6122:          // multiplied by -rampbc*(g/rho0) 
 6123:          const double grav3 = side->grav3();
 6124:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6125: 
 6126:       } // for
 6127: 
 6128:    }
 6129: 
 6130: 
 6131: 
 6132:    __global__ void computeHorGradientAtSide(void) {
 6133: 
 6134:       // Compute the horizontal density gradient at each element.
 6135:       // It works in two steps:
 6136:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6137:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6138:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6139:       //             gradRho.r1 = rho1 - rho0
 6140:       //             gradRho.r2 = rho2 - rho0
 6141:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6142:       // 
 6143:       //  NOTE: We use de-meaned densities.
 6144: 
 6145:       SIDE(side);
 6146: 
 6147: 
 6148:       if (side->isDry) return;
 6149: 
 6150:       // Computes the gradient of the variables at the side center.
 6151:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6152:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6153:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6154: 
 6155:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6156:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6157:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6158:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6159: 
 6160:    }
 6161: 
 6162: 
 6163:    __global__ void solveMomentumEquations(double time) {
 6164: 
 6165:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6166:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6167: 
 6168:       SIDE(side);
 6169: 
 6170:       if (side->isDry) 
 6171:       {
 6172:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6173: 
 6174:          return;
 6175:       }
 6176: 
 6177:       const Node *n1 = side->n1;
 6178:       const Node *n2 = side->n2;
 6179: 
 6180:       const int kb = side->kb;
 6181: 
 6182:       const double veg_h = side->veg_h();
 6183:       const double grav3 = side->grav3();
 6184: 
 6185:       if (side->is2D()) {
 6186:          // Remember: Do not use htot2, which is updated.
 6187:          const double htot = side->htot1();
 6188:          const double hhat = side->hhat;
 6189: 
 6190:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6191: 
 6192:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6193:          const Vector2 tau2 = side->tau();
 6194: 
 6195:          // hat_gam has units of m/s
 6196: 
 6197:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6198:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6199:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6200: 
 6201:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6202: 
 6203: 
 6204:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6205: 
 6206:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6207: 
 6208:       }
 6209:       else { // 3D
 6210: 
 6211:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6212:          // 
 6213:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6214:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6215:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6216:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6217:          // k+1 and k.
 6218: 
 6219: 
 6220:          const int ndim = nvrt - kb;
 6221:          const double zTopCanopy = side->zTopCanopy();
 6222: 
 6223:          // Initialize the tridiagonal system
 6224:          for (int k = kb + 1; k < nvrt; k++) {
 6225:             
 6226:             const int kin = k - (kb + 1);
 6227: 
 6228:             // Vertical viscosity at the face center
 6229:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6230: 
 6231:  
 6232:             alow[kin] = 0.0;
 6233:             cupp[kin] = 0.0;
 6234:             bdia[kin] = 0.0;
 6235: 
 6236:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6237:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6238: 
 6239:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6240:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6241:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6242: 
 6243:             // First part: layers k, k+1
 6244:             if (k < nvrt - 1) {
 6245:                              
 6246:                if constexpr(iveg != 0) {
 6247: 
 6248:                   // If there is vegetation at this level...
 6249:                   if (zTopCanopy > side->zc[k]) {
 6250:                      // If the canopy is above the k layer...
 6251:                      
 6252:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6253:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6254:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6255:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6256: 
 6257:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6258:                      const double vmag2 = length(ut2);
 6259:                      const double vmag1 = length(side->u2[k]);
 6260:                      const double vmag = 0.5*(vmag1 + vmag2);
 6261:                      
 6262:                      // Computes the vegetation alpha at the face center
 6263:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6264: 
 6265:                      cff1 += veg_alpha_sd*dt*vmag;
 6266: 
 6267:                   } // if (zTopCanopy
 6268:                } // if iveg
 6269: 
 6270:                const double dzz = side->Dz(k + 1);
 6271:                const double tmp = dt*dfz/dzz;
 6272:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6273: 
 6274:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6275:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6276:             }
 6277: 
 6278: 
 6279:             // Second part: layers k-1, k
 6280:             if (k > kb + 1) {
 6281: 
 6282:                double cff1 = 1.0; //init \bar{c^k}
 6283: 
 6284:                if constexpr(iveg != 0) {
 6285:                   // If there is vegetation at this level...
 6286:                   if (zTopCanopy > side->zc[k-1]) {
 6287:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6288:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6289: 
 6290:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6291: 
 6292:                      const double vmag2 = length(ut2);
 6293:                      const double vmag1 = length(side->u2[k-1]);
 6294:                      const double vmag = 0.5*(vmag1 + vmag2);
 6295: 
 6296:                      // Computes the vegetation alpha at the face center
 6297:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6298:                      cff1 += veg_alpha_sd*dt*vmag;
 6299:                   } // if zTopCanopy
 6300: 
 6301:                } // if iveg
 6302: 
 6303:                const double dzz = side->Dz(k);
 6304:                const double tmp = dt*dfz/dzz;
 6305:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6306: 
 6307:                alow[kin] += cff1*dzz/6.0 - tmp;
 6308:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6309: 
 6310:             } else { // Bottom boundary
 6311:                // This occurs at the bottom, where the bottom drag is applied.
 6312: 
 6313:                bdia[kin] += dt*side->chi2; // XXXX
 6314: 
 6315:             } // if (k > kb + 1)
 6316: 
 6317: 
 6318:          } // for (int k
 6319: 
 6320: 
 6321: 
 6322:          // Computes the RHS.
 6323:          // -----------------
 6324: 
 6325:          //	BC to be imposed at the end.
 6326: 
 6327:          const Vector2 gradETP  = side->gradETP;
 6328:          const Vector2 gradPr   = side->gradPr;
 6329:          const Vector2 gradEta1 = side->gradEta1;
 6330:          const Vector2 gradEta2 = side->gradEta2;
 6331: 
 6332:          const Vector2 *btu = side->btu;
 6333:          const Vector2 *u2  = side->u2;
 6334:          const double coriolis = side->coriolis;
 6335:          const Vector2 *nuGradU = side->nuGradU;
 6336: 
 6337:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6338:          for (int k = kb + 1; k < nvrt; k++) {
 6339:             const int kin = k - kb - 1;
 6340: 
 6341:             const double dz_0 = side->Dz(k);
 6342:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6343: 
 6344:             rrhs[kin] = {0.0, 0.0};
 6345:             double dz = 0.0;
 6346: 
 6347:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6348:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6349:             if (k < nvrt  ) dz += dz_1;
 6350:             if (k > kb + 1) dz += dz_0;
 6351: 
 6352:             // Elevation gradient, atmospheric pressure and tidal potential
 6353:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6354: 
 6355:             // Coriolis, advection, wind stress, and horizontal viscosity
 6356:             if (k < nvrt - 1) {
 6357: 
 6358: 
 6359:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6360:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6361:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6362:                                                 
 6363: 
 6364:                //diff stress tensors 1006
 6365:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6366:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6367:                   assert(false && "Not implemented: itur == 5");
 6368:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6369:                }
 6370:                // else assert(false && "itur # Not implemented");
 6371: 
 6372:             } else { // k == nvrt - 1 SURFACE
 6373:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6374:                const Vector2 tau2 = side->tau();
 6375: 
 6376:                rrhs[kin] += dt*tau2;          
 6377: 
 6378:             } // if k<nvrt
 6379: 
 6380: 
 6381:             if (k > kb + 1) {
 6382:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6383:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6384:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6385: 
 6386:                // diff stress tensors 1006
 6387:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6388:                   assert(false && "Not implemented: itur == 5");
 6389:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6390:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6391:                }
 6392:                // else assert(false && "itur # Not implemented");
 6393: 
 6394: 
 6395:             } // if k>kbs + 1
 6396: 
 6397:             // Baroclinic
 6398:             Vector2 *bcc = side->bcc;
 6399:             if constexpr(ibc == 0) {
 6400:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6401:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6402: 
 6403:             } // if ibc==0
 6404: 
 6405:          } // k=kb + 1,nvrt
 6406: 
 6407: 
 6408:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6409: 
 6410:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6411:             const int kin = k - kb - 1;
 6412:    
 6413:             // Velocity is always clamped to maximum values
 6414:             side->u2[k] = clampVelocity(soln[kin]);
 6415:          } // k
 6416: 
 6417:       } // if side->is2D()
 6418:       
 6419: 
 6420:       // Impose velocity boundary condition at the bottom
 6421:       if constexpr(imm == 2) { // 3D bed deformation model
 6422:          double dep;
 6423:          Vector2 vel;
 6424: 
 6425:          assert(false && "Not implemented: imm == 2");
 6426:          //update_bdef(time, x0, y0, dep, vel);
 6427:          // side->u2[kb] = vel;
 6428: 
 6429:       } else { // imm = 0 or 1
 6430:          if (side->Cd() == 0.0) {
 6431:             side->u2[kb] = side->u2[kb + 1];
 6432: 
 6433:          } else if (side->is3D()) { // 3D no slip bottom   
 6434:             side->u2[kb] = {0.0, 0.0};
 6435: 
 6436:          }
 6437:           
 6438:       } // if imm
 6439: 
 6440:       // The velocities below the bottom level are set to zero
 6441:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6442: 
 6443: 
 6444:    }
 6445: 
 6446: 
 6447:    __global__ void applyMomentumBC(void) {
 6448: 
 6449:       SIDE_BND(sideBnd);
 6450: 
 6451:       Side *side = sideBnd->side;
 6452:       const BoundarySegment *segment = sideBnd->segment;
 6453:       const Node *n1 = side->n1;
 6454:       const Node *n2 = side->n2;
 6455: 
 6456:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6457: 
 6458:       const bool isLand = segment->isLand;
 6459:       const int ifltype = segment->ifltype;
 6460: 
 6461:       const int kb = side->kb;
 6462: 
 6463: 
 6464:       if (!isLand && ifltype != 0) {
 6465:          const Vector2 *ubc = sideBnd->ubc;
 6466:   
 6467:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6468:             
 6469:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6470:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6471: 
 6472:             if (ifltype == -1) {
 6473:                // Flather 1
 6474: 
 6475:                const double depth = side->depth();
 6476: 
 6477:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6478: 
 6479:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6480: 
 6481:                side->u2[k] = vnorm*side->n;
 6482: 
 6483:             } else if (ifltype == -2) { // Discharge
 6484: 
 6485:                const double eta1 = side->eta1();
 6486:                const double eta2 = side->eta2();
 6487:                const double htot = side->htot2();
 6488: 
 6489:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6490:                assert(false && "Not implemented: Discharge bc");
 6491:                // const double dischrg = discharge(eta1);
 6492:                const double dischrg = 0.0; // XXX REMOVE
 6493:                
 6494: 
 6495:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6496: 
 6497:                const double vnorm = dischrg*eta2/htot;
 6498: 
 6499:                side->u2[k] = vnorm*side->n;
 6500: 
 6501:             }
 6502:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6503:                const double vnorm = dot(side->u2[k], side->n);
 6504: 
 6505:                double rat;
 6506:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6507:                else              rat = segment->vobc2; // outgoing
 6508: 
 6509:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6510: 
 6511:             }
 6512:             else { // not Flather or 3D radiation
 6513:                side->u2[k] = ubc[k];
 6514: 
 6515:             } // if (segment->ifltype...
 6516: 
 6517:          }
 6518: 
 6519:       }
 6520:       else if (isLand) { // if it is land boundary side
 6521: 
 6522:          if constexpr(islip == 0) { // free slip
 6523: 
 6524:             for (int k = kb; k < nvrt; k++) {
 6525: 
 6526:                const Vector2 t = side->t();
 6527:                const Vector2 n = side->n;
 6528: 
 6529:                double vnorm = 0.0; // for most cases
 6530:                const double vtan = dot(side->u2[k], t);
 6531:                
 6532:                side->u2[k] = vtan*t - vnorm*n;
 6533: 
 6534:             }
 6535: 
 6536:          } else { // no slip
 6537:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6538: 
 6539:          }
 6540:       } // if (side segment type...
 6541: 
 6542:    }
 6543: 
 6544: 
 6545:    __global__ void shapiroFilter1(void) {
 6546:       // First step of the Shapiro filter (normally used if indvel<=0)
 6547:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6548: 
 6549:       SIDE(side);
 6550: 
 6551:       // Only internal wet sides are processed
 6552:       if (side->isDry || !(side->isInternal())) return;
 6553: 
 6554:       const int kb = side->kb;
 6555: 
 6556:       for (int mm = 0; mm < niter_shap; mm++) {
 6557: 
 6558:          for (int k = kb + 1; k < nvrt; k++) {
 6559:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6560:             Vector2 suru = {0.0, 0.0};
 6561: 
 6562:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6563: 
 6564:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6565: 
 6566:                int kin = k;
 6567:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6568:                
 6569:                // Get the velocity at the neighbor's side.
 6570:                Vector2 nSideU2 = nSide->u2[kin];
 6571: 
 6572:                // Projects the velocity to the current side frame if needed.
 6573:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6574: 
 6575:                suru += nSideU2;
 6576:             }
 6577: 
 6578:             // Reusing bcc as a temporary array to store the suru values.
 6579:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6580: 
 6581:          }
 6582:       }
 6583:    }
 6584: 
 6585:    __global__ void shapiroFilter2(void) {
 6586:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6587: 
 6588:       SIDE(side);
 6589: 
 6590: 
 6591:       if (side->isDry || !(side->isInternal())) return;
 6592: 
 6593:       const int kb = side->kb;
 6594: 
 6595:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6596: 
 6597:       if (side->is2D()) {
 6598:          side->u2[kb + 1] = side->bcc[kb + 1];
 6599:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6600: 
 6601:       } else {
 6602:          // 3D
 6603:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6604:          
 6605:       }
 6606: 
 6607:    }
 6608: 
 6609: 
 6610:    __global__ void ul0UpdateZCoords(void) {
 6611:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6612:       
 6613:       NODE(node);      
 6614: 
 6615: 
 6616:       if (false) { //node->isDry) { XXXXXXX
 6617: 
 6618:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6619: 
 6620:          if constexpr(ivcor != 1) node->kb = 0;
 6621: 
 6622:       } else {
 6623: 
 6624:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6625:          node->updateKb();
 6626: 
 6627:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6628: 
 6629:       }
 6630: 
 6631:       // We use the temp.b field to store the previous state of isDry.
 6632:       node->tmp.b = node->isDry;
 6633: 
 6634:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6635:       node->isDry = true;
 6636: 
 6637:    }
 6638: 
 6639:    __global__ void ul0ComputeDryElements(void)
 6640:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6641:    {
 6642:       ELEM(elem);
 6643: 
 6644:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6645: 
 6646:       elem->kb = 0;
 6647: 
 6648:       if (elem->isDry) return;
 6649: 
 6650: 
 6651:    //    if(elem->isDry2()) { // XXXX
 6652:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6653:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6654:    //        call parallel_abort(errmsg)
 6655:    //    }
 6656: 
 6657:       const Node *n1 = elem->nodes[0];
 6658:       const Node *n2 = elem->nodes[1];
 6659:       const Node *n3 = elem->nodes[2];  
 6660:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6661: 
 6662:       // Computes element's kb as the minimum of the nodes' kb.
 6663:       const int kb1 = n1->kb;
 6664:       const int kb2 = n2->kb;
 6665:       const int kb3 = n3->kb;
 6666:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6667: 
 6668: 
 6669:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6670: 
 6671: 
 6672:       // Computes the element z as the mean of the nodes z.
 6673:       for (int k = elem->kb; k < nvrt; k++) {
 6674: 
 6675:          // Compute the element z as the mean of the nodes z.
 6676:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6677:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6678:          elem->z[k] /= elem->i34;
 6679: 
 6680:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6681:       }
 6682:                   
 6683:    }
 6684: 
 6685:    __global__ void ul0ComputeDryNodes(void)
 6686:    // Updates node's isDry based on the elements' isDry. 
 6687:    {
 6688:       NODE(node);
 6689: 
 6690:       node->isDry = true;
 6691: 
 6692:       // A node is wet if at least one of the elements sharing it is wet.
 6693:       for (int j = 0; j < node->numElements; j++) {
 6694:          const Element *elem = node->elements[j];
 6695:          if (!elem->isDry) {
 6696:             node->isDry = false;
 6697:             break;
 6698:          }
 6699:       }
 6700: 
 6701:        
 6702:    }
 6703: 
 6704: 
 6705:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6706:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6707:    // node->tmp.b is true if the node was previously dry.
 6708:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6709:    {
 6710:       NODE(node);
 6711:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6712: 
 6713:       // Avoid this the first time step.
 6714:       if (it == iths) return;  
 6715: 
 6716:       const bool wasDry = node->tmp.b;
 6717: 
 6718: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6719: 
 6720:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6721: 
 6722:          for (int k=0; k < nvrt; k++) {
 6723: 
 6724:             Vector3 utmp={0.0, 0.0, 0.0};
 6725: 
 6726:             double ttmp=0.0;
 6727:             double stmp=0.0;
 6728:             int icount=0;
 6729:             for (int j = 0; j < node->numNodes; j++) {
 6730: 
 6731:                const Node *nbrNode = node->nodes[j];
 6732:                
 6733:                const bool wasNbrDry = nbrNode->tmp.b;
 6734: 
 6735:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6736:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6737: 
 6738:                   icount++;
 6739: 
 6740:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6741:                   utmp += nbrNode->uvw2(k);
 6742:                   
 6743:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6744:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6745:                }
 6746:             }
 6747: 
 6748:             if (icount > 0) {
 6749:                const double inv_icount = 1.0/icount;
 6750:                utmp = inv_icount*utmp;
 6751:                node->u2[k]     = {utmp.x, utmp.y};
 6752:                node->w2[k]     = utmp.z;
 6753:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6754:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6755:             } else {
 6756:                node->u2[k] = {0.0, 0.0};
 6757:                node->w2[k] = 0.0;
 6758:                // Initialize tracers to 0.0??? XXXXX
 6759:             }
 6760:          }
 6761:       }
 6762:    }
 6763: 
 6764:   
 6765:    
 6766: 
 6767: 
 6768:    __global__ void ul0UpdateSides(int it, int iths) {
 6769:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6770:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6771:    // The dryness of the sides is updated in ul0UpdateSides2.
 6772: 
 6773:       SIDE(side);
 6774: 
 6775:       // A side is wet if and only if at least one of its elements is wet.
 6776:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6777:  
 6778:       const Node *n1 = side->n1;
 6779:       const Node *n2 = side->n2;
 6780:      
 6781:       const int kb1 = n1->kb;
 6782:       const int kb2 = n2->kb;
 6783: 
 6784:       side->kb = 0; // default when dry
 6785: 
 6786:       if (isWet) {
 6787: 
 6788:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6789: 
 6790:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6791: 
 6792:          side->kb = min(kb1, kb2);
 6793: 
 6794:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6795: 
 6796:          for (int k = side->kb; k < nvrt; k++) {
 6797:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6798: 
 6799:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6800: 
 6801:             // Compute velocity for re-wetted sides 
 6802:             if ((it != iths) && (side->isDry && isWet)) {
 6803: 
 6804:                Vector2 utmp={0.0, 0.0};
 6805: 
 6806:                int icount=0;
 6807: 
 6808:                // For all the sides on the two elements that share this side
 6809:                for (int j = 0; j < 2; j++) {
 6810:                   const Element *elem = side->elems[j];
 6811:                   if (elem == nullptr) continue;
 6812: 
 6813:                   for (int jj=0; jj < elem->i34; jj++) {
 6814:                      const Side *nSide = elem->sides[jj];
 6815:                      if (nSide->isDry) continue;
 6816: 
 6817:                      icount++;
 6818:                      utmp += nSide->u2[k];  
 6819:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6820:                   }
 6821:                }
 6822:                   
 6823:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6824:                if (icount > 0)  side->u2[k] = utmp/icount;
 6825:                else             side->u2[k] = {0.0, 0.0};
 6826:                   
 6827:             } // if ((it != iths) && (side->isDry && isWet))
 6828: 
 6829:          } // for k
 6830: 
 6831:       } // if isWet 
 6832:       
 6833: 
 6834: 
 6835:    }
 6836: 
 6837:    __global__ void ul0UpdateSides2(void) {
 6838:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6839:    
 6840:          SIDE(side);
 6841:    
 6842:          const Element *e1 = side->elems[0];
 6843:          const Element *e2 = side->elems[1];
 6844: 
 6845:          // A side is wet if and only if at least one of its elements is wet.
 6846:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6847: 
 6848:          // Update the side's dryness
 6849:          side->isDry = !isWet;
 6850: 
 6851:    }
 6852: 
 6853: 
 6854:    __global__ void zeroNodalVelocities(void) {
 6855:       NODE(node);
 6856: 
 6857:       for (int k = 0; k < nvrt; k++) {
 6858:          node->u2[k]   = {0.0, 0.0};
 6859:          node->w2[k]   = 0.0;
 6860:          node->utmp[k] = {0.0, 0.0};         
 6861:       }
 6862:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6863:    }
 6864:  
 6865: 
 6866:    __global__ void computeNodalVerticalVelocities1(void) {
 6867:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6868:    // Adds the element's vertical velocity times the element's area.
 6869:       ELEM(elem);
 6870: 
 6871:       for (int j = 0; j < elem->i34; j++) {
 6872:          Node *node = elem->nodes[j];
 6873: 
 6874:          for (int k = node->kb; k < nvrt; k++) {
 6875:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6876:          }
 6877:          atomicAdd(&(node->tmp.d), elem->area);
 6878:       }
 6879:    }
 6880: 
 6881:    __global__ void computeNodalVerticalVelocities2(void) {
 6882:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6883:    // Divides by the total area of the elements sharing the    node.
 6884:       NODE(node);
 6885: 
 6886: 
 6887:       const double invArea = 1.0 / node->tmp.d;
 6888:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6889: 
 6890:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6891:    }
 6892: 
 6893: 
 6894:    __global__ void computeNodalHorizontalVelocities1(void) {
 6895: 
 6896:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6897: 
 6898:       ELEM(elem);
 6899: 
 6900:       if (elem->isDry) return;
 6901: 
 6902:       const int kb = elem->kb;
 6903:       const bool isTri = elem->isTri();
 6904: 
 6905:       if constexpr(indvel <= 0) {
 6906:          // Assuming discontinous hvel.
 6907: 
 6908:          if (isTri) { // For triangles
 6909:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6910:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6911:             #pragma unroll
 6912:             for (int j = 0; j < 3; j++) {
 6913:                // For every node of the triangle...
 6914:                Node *node = elem->nodes[j];
 6915: 
 6916:                if (node->isDry) continue;
 6917: 
 6918:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6919:                const Side *s2 = elem->sides[(j + 1) % 3];
 6920:                const Side *s3 = elem->sides[(j + 2) % 3];
 6921: 
 6922:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6923: 
 6924:                atomicAdd(&(node->tmp.i), 1);
 6925: 
 6926:                for (int k = kb; k < nvrt; k++)  {
 6927:                   Vector2 s1u2 = s1->u2[k];
 6928:                   Vector2 s2u2 = s2->u2[k];
 6929:                   Vector2 s3u2 = s3->u2[k];
 6930: 
 6931:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 6932:                   if constexpr(ics == 2) {
 6933:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 6934:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 6935:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 6936:                   }
 6937: 
 6938:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 6939:                   u = clampVelocity(u);
 6940:                   atomicAdd(&(node->utmp[k].x), u.x);
 6941:                   atomicAdd(&(node->utmp[k].y), u.y);
 6942: 
 6943:                }
 6944: 
 6945:             }
 6946:          }
 6947:          else { // For quads
 6948: 
 6949: 
 6950:             // Compute the bilinear coordinates of the center of each diagonal.
 6951:             double xi, eta;
 6952:             double shp13[4], shp24[4];
 6953:             Point2 x0, x1, x2, x3;
 6954:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 6955:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 6956:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 6957: 
 6958:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 6959:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 6960: 
 6961: 
 6962: 
 6963: 
 6964:             for (int k = kb; k < nvrt; k++) {
 6965: 
 6966:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 6967:                Vector2 sideU[4];
 6968:                #pragma unroll
 6969:                for (int j = 0; j < 4; j++) {
 6970:                   Vector2 u = elem->sides[j]->u2[k];
 6971:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 6972:                   sideU[j] = u;
 6973:                }
 6974: 
 6975:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 6976:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 6977: 
 6978:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 6979:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 6980:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 6981:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 6982:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 6983:                #pragma unroll
 6984:                for (int j = 0; j < 4; j++) {
 6985:                   Node *node = elem->nodes[j];
 6986:                   if (node->isDry) continue;
 6987: 
 6988:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 6989:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 6990:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 6991:                }
 6992:             }
 6993: 
 6994:          }
 6995: 
 6996:       }
 6997:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6998:       
 6999:    }
 7000: 
 7001: 
 7002:    __global__ void computeNodalHorizontalVelocities2(void) {
 7003:       NODE(node);
 7004: 
 7005:       const int nodeCount = node->tmp.i;
 7006: 
 7007:       if (nodeCount == 0) 
 7008:       {
 7009:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7010:          return;
 7011:       }
 7012: 
 7013:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7014:       
 7015:       const int kb = node->kb;
 7016: 
 7017:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7018:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7019:       
 7020:       
 7021:    }   
