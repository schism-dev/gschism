 9250: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9251:    SIDE(side);
 9252: 
 9253:    switch (varCode) {
 9254:       case (int)VarCode::outputCoords: {
 9255:          const Point2 coords = side->outputCoords();
 9256:          double *out = (double *)((char *)res + idx_side * 16);
 9257:          out[0] = coords.x;
 9258:          out[1] = coords.y;
 9259:          break;
 9260:       }
 9261:       case (int)VarCode::n1:
 9262:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9263:          break;
 9264:       case (int)VarCode::n2:
 9265:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9266:          break;
 9267:       case (int)VarCode::isdry:
 9268:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9269:          break;
 9270:    }
 9271: }
