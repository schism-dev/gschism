 7218: 
 7219: __global__ void computeMatrixProductAndDotProducts() {
 7220:    // Computes A*p, r'Mr and p'Ap
 7221: 
 7222:    // 1) shared buffer: first half for rMr, second for pAp
 7223:    __shared__ double sdata[2*BLOCK_SIZE];
 7224:    double* s_rMr = sdata;
 7225:    double* s_pAp = sdata + BLOCK_SIZE;
 7226: 
 7227:    const int tid = threadIdx.x;
 7228: 
 7229:    double l_pAp = 0.0;
 7230: 
 7231:    s_rMr[tid] = 0.0;
 7232:    s_pAp[tid] = 0.0;
 7233: 
 7234:    // 2) get your node pointer
 7235:    // NODE(node);   
 7236:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7237:    Node *node = &(mesh->localNodeData[idx_node]); 
 7238:       if (idx_node < mesh->np) {
 7239: 
 7240:       const double diag = node->coeffDiag;
 7241:       const double r    = node->mR;
 7242:       const double p    = node->mP;  
 7243: 
 7244:       // apply preconditioner on the fly:
 7245:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7246: 
 7247:       // 4) compute Ap = A.p
 7248:       double Ap = node->coeffDiag * node->mP;
 7249:       for (int j = 0; j < node->numNodes; ++j) {
 7250:          const Node *nbNode = node->nodes[j];
 7251:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7252: 
 7253:       }
 7254: 
 7255:       node->mAp = Ap;
 7256:       
 7257: 
 7258:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7259:       // const double l_rMr = r*Mr;  // r'Mr
 7260:       l_pAp = p*Ap;  // p'Ap
 7261: 
 7262: 
 7263:    }
 7264: 
 7265:    // 6) write into shared mem
 7266:    // s_rMr[tid] = l_rMr;
 7267:    s_pAp[tid] = l_pAp;
 7268: 
 7269:    __syncthreads();
 7270: 
 7271:    // 7) block-wide tree reduction
 7272:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7273:       if (tid < stride)  {
 7274:          s_pAp[tid] += s_pAp[tid + stride];
 7275:       }
 7276:       __syncthreads();
 7277:    }
 7278: 
 7279:    // 8) thread 0 atomically accumulates into the globals
 7280:    // XXX: This is slower than it needs to be, but it is simple and works
 7281:    if (tid == 0) {
 7282:       atomicAdd(pAp, s_pAp[0]);
 7283:    }
 7284: 
 7285: 
 7286: }
 7287: 
 7288: 
 7289: __global__ void updateSolutionAndDotProducts(void) {
 7290:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7291: 
 7292:    const int tid = threadIdx.x;
 7293: 
 7294:    s_rMr[tid] = 0.0;
 7295: 
 7296:    // get node & bounds-check:
 7297:    NODE(node);
 7298: 
 7299:    
 7300:    // Compute alpha
 7301:    const double alpha = (*rMr_old)/(*pAp); 
 7302: 
 7303: 
 7304:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7305: 
 7306: 
 7307:    // load scalars
 7308:    const double diag = node->coeffDiag;
 7309:    const double p    = node->mP;
 7310:    const double Ap   = node->mAp;
 7311:    const double x    = node->mX;
 7312:    const double r    = node->mR;
 7313:    
 7314:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7315: 
 7316:    // 1) update solution & residual
 7317:    const double x_new = x + alpha*p;
 7318:    const double r_new = r - alpha*Ap;
 7319:    node->mX = x_new;
 7320:    node->mR = r_new;
 7321: 
 7322:    // 2) apply Jacobi preconditioner on the fly
 7323:    const double Mr_new = r_new/diag;
 7324: 
 7325: 
 7326:    // 3) local contributions for the two dot-products
 7327:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7328: 
 7329:    // 4) write into shared-mem
 7330:    s_rMr[tid] = l_rMr;
 7331: 
 7332:    __syncthreads();
 7333: 
 7334: 
 7335:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7336:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7337:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7338:       __syncthreads();
 7339:    }
 7340: 
 7341:    // 6) thread 0 atomically folds into the global accumulators
 7342:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7343: 
 7344: 
 7345: }
 7346: 
 7347: 
 7348: __global__ void updateSearchDirection() {
 7349: 
 7350:     NODE(node);
 7351: 
 7352:     // recompute z on-the-fly
 7353:     const double z = node->mR / node->coeffDiag;
 7354:     const double p = node->mP;
 7355: 
 7356:     const double beta = (*rMr_new)/(*rMr_old);
 7357: 
 7358: 
 7359:     // p =z + beta*p
 7360:     node->mP = z + beta*p;
 7361: 
 7362: }
 7363: 
 7364: __global__ void initializeScalars(double *scalars) {
 7365: 
 7366:    // These point to a cupy array in the host code
 7367:    rMr_old = scalars + 0;
 7368:    rMr_new = scalars + 1;
 7369:    pAp     = scalars + 2;
 7370: }
 7371: 
 7372: __global__ void initializePreconditionedResidual(void) {
 7373: 
 7374:     __shared__ double s_rMr[BLOCK_SIZE];  
 7375: 
 7376:     s_rMr[threadIdx.x] = 0.0;
 7377: 
 7378:     NODE_ALL(node, valid);
 7379:     const int tid = threadIdx.x;
 7380:     // For the first iteration:
 7381:     // 1. Initial solution x = 0 (already set)
 7382:     // 2. Initial residual r = b (stored in qel)
 7383:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7384: 
 7385: // XXX we should use the guess solution here    
 7386: 
 7387:     double l_rMr = 0.0;
 7388:     if (valid) {
 7389:       // Set initial residual r = b (from qel)
 7390:       node->mR = node->qel;
 7391: 
 7392:       // Compute z = M^-1 * r (preconditioned residual)
 7393:       const double z = node->mR / node->coeffDiag;
 7394: 
 7395:       // Set initial search direction p = z
 7396:       node->mP = z;
 7397: 
 7398:       // Initialize other variables needed for CG
 7399:       node->mX = 0.0;  // Initial solution
 7400:       node->mAp = 0.0; // Will be computed in first iteration
 7401: 
 7402: 
 7403:       // Computes the first r'Mr (reduction)
 7404:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7405:     }
 7406:     // 4) write into shared-mem
 7407:     s_rMr[tid] = l_rMr;
 7408: 
 7409:     __syncthreads();
 7410: 
 7411: 
 7412:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7413:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7414:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7415:         __syncthreads();
 7416:     }
 7417: 
 7418:     // 6) thread 0 atomically folds into the global accumulators
 7419:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7420: 
 7421:     *rMr_old = 0.0;
 7422:     *pAp = 0.0;
 7423: }
 7424: 
 7425: 
