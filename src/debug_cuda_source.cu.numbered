 7118: //                 !    do jj=1,ntr
 7119: //                 !      adv_tr(jj)=adv_tr(jj)+dtb_by_bigv*abs(flux_adv_hface(k,jsj))*(trel_tmp(jj,k,i)-trsd_tmp(jj,k,jsj) )
 7120: //                 !    enddo
