 1557: __device__ __inline__ double min3(double a, double b, double c) {
 1558:    return min(a, min(b, c));
 1559: }
 1560: 
 1561: __device__ __inline__ double min4(double a, double b, double c, double d) {
 1562:    return min(a, min(b, min(c, d)));
 1563: }
