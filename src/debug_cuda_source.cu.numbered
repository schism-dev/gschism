 2558: // Helper functions to get the 2D local node position for the Celestial walk
 2559: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2560:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2561:    const Node *node = getNodeInOrder(idx2);
 2562: 
 2563:    double z = 0.0;
 2564:    if constexpr(ics == 2) z = node->gz;
 2565:    
 2566:    Point3 p = toPoint3(node->p, z);
 2567: 
 2568:    return toPoint2(origSide->toLocalFrame(p));
 2569: }
 2570: 
 2571: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2572:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2573: }
 2574: 
 2575: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2576:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2577: // Computes the three per-side predicates needed for the celestial walk
 2578: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2579: //
 2580: // xt is in local frame coordinates for origSide if ics == 2.
 2581: //
 2582: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2583: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2584: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2585: // meaningless on triangles are masked to a safe value (see comments below).
 2586: {
 2587:    // Project all 4 corner positions once into the local 2D frame.
 2588:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2589:    // getLocalNodePosition only transforms/projects if ics == 2.
 2590:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2591:                         getLocalNodePosition(1, origSide), 
 2592:                         getLocalNodePosition(2, origSide), 
 2593:                         getLocalNodePosition(3, origSide)};
 2594: 
 2595:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2596:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2597:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2598:    // But still farther towards the target point from the current point.
 2599:    const Vector2 vt0 = xt - x0;
 2600:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2601:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2602:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2603: 
 2604:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2605:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2606: 
 2607: 
 2608: // if (origSide->idx == 2860848 && jlev == 46) {
 2609: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2610: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2611: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2612: // }
 2613:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2614:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2615:    //  here the orientation is baked into the corners array.)
 2616:    const int i3 = nxq(3);
 2617:    const Vector2 s0 = C[ 1] - C[ 0];
 2618:    const Vector2 s1 = C[ 2] - C[ 1];
 2619:    const Vector2 s2 = C[i3] - C[ 2];
 2620:    const Vector2 s3 = C[ 0] - C[i3];
 2621:    
 2622:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2623:    // The corners array is built from getNode in CCW order, so the orientation
 2624:    // is already correct and no ssign factor is needed in the formulas below.
 2625:    //
 2626:    // i3 = nxq(3): the index of the corner after side 2.
 2627:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2628:    //   Quad:     i3 == 3.
 2629:    //
 2630:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2631:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2632:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2633:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2634:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2635:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2636: 
 2637: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2638: 
 2639:    // For triangles, the corner after side 2 is the closing corner where
 2640:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2641:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2642:    // s0 for triangles, s3 for quads.
 2643:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2644: 
 2645:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2646:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2647:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2648:    //
 2649:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2650:    // result is false naturally. No sentinel needed.
 2651:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2652:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2653:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2654:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2655: 
 2656:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2657:    // on the "exit through side I" half of the corner cone, separated by the
 2658:    // approximate angular bisector of the celestial walk. The bisector is
 2659:    // perpendicular to the chord across the corner; the test is the sign of
 2660:    // (xt - corner_vertex) projected onto that chord.
 2661:    //
 2662:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2663:    // (the validity rule sets valid_3 = false), so its computed value for
 2664:    // triangles doesn't matter. No sentinel needed.
 2665:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2666:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2667:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2668:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2669: 
 2670: }
 2671: 
 2672: 
 2673: __inline__ __device__ double Element::computeSignedArea(void) const {
 2674:    // Compute the area of the element
 2675: 
 2676:    Point2 x0, x1, x2, x3;
 2677:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2678: 
 2679:    double res = signedArea(x0, x1, x2);
 2680: 
 2681:    // In the quad case we need to add the area of the other triangle.
 2682:    if (isQuad()) {
 2683:       x3 = getLocalHorizontalNodePosition(3);
 2684:       double ar1 = signedArea(x0, x2, x3);
 2685:       double ar2 = signedArea(x0, x1, x3);
 2686:       double ar3 = signedArea(x1, x2, x3);
 2687:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2688: 
 2689:       res += ar1 + ar2 + ar3;
 2690: 
 2691:    }
 2692: 
 2693:    return res;
 2694: }
 2695: 
 2696: 
 2697: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2698:                                                                 (nodes[1]->isDry2()) ||
 2699:                                                                 (nodes[2]->isDry2()) ||
 2700:                                                                 (isQuad() && nodes[3]->isDry2());
 2701: }
 2702: 
 2703: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2704:    return (x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y);
 2705: }
 2706: 
 2707: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2708:    return (x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y);
 2709: }
 2710: 
 2711: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2712:    // In boundary sides, the element 1 is nullptr
 2713:    return side->elems[1] == nullptr; 
 2714: }
 2715: 
 2716: __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2717:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2718:    // For ics == 2, this function uses local frame coordinates.
 2719: 
 2720:    assert(isQuad());
 2721: 
 2722:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2723:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2724:    // where vxi, veta, vb are vectors and c is the center of the element.
 2725: 
 2726:    Point2 p0, p1, p2, p3;
 2727: 
 2728:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2729: 
 2730:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2731:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2732:    // vectors vxi and veta connect the centers of opposite sides
 2733:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2734:    // vb is zero for parallelogram elements.
 2735:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2736: 
 2737:    //  The bilinear mapping is:
 2738:    //      P(s,t) = C + s*U + t*V + s*t*W
 2739:    //
 2740:    //  where:
 2741:    //    C = centroid (average of four vertices)
 2742:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2743:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2744:    //    W = bilinear correction; measures deviation from parallelogram
 2745:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2746:    //        W = 0 for parallelogram elements.
 2747:    //
 2748:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2749:    //
 2750:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2751:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2752:    //
 2753:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2754:    //
 2755:    //  Geometrically, (L) projects everything onto the direction
 2756:    //  perpendicular to W, where the mapping is purely affine.
 2757:    //
 2758:    //  The dot product with nb retains the nonlinear term:
 2759:    //
 2760:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2761:    //
 2762:    //  Geometrically, (Q) projects onto the W direction, where
 2763:    //  the nonlinearity lives.
 2764:    //
 2765:    //  We solve (L) for whichever variable has the larger coefficient
 2766:    //  (better conditioned back-substitution), substitute into (Q),
 2767:    //  and get a scalar quadratic in the other variable.
 2768:    // ================================================================
 2769: 
 2770:    // ---- Basis vectors ----
 2771:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2772:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2773:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2774:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2775:    // W: nonlinear correction. Difference between quad and parallelogram.
 2776:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2777:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2778: 
 2779:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2780:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2781:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2782:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2783:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2784: 
 2785:    // ---- nb: direction parallel to W, L1-normalized ----
 2786:    // We don't need a unit vector -- just a well-scaled direction parallel
 2787:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2788:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2789:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2790:    //
 2791:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2792:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2793:    // and the quadratic solver takes its linear path (a ~ 0).
 2794:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2795:    const double inv_wlen = 1.0 / wlen1;
 2796:    const Vector2 nb = vb * inv_wlen;
 2797: 
 2798:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2799:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2800:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2801:    // What remains is a pure affine relationship between xi and eta.
 2802:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2803:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2804:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2805: 
 2806:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2807:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2808:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2809:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2810:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2811:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2812:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2813: 
 2814:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2815:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2816:    // minimizing round-off amplification.
 2817:    //
 2818:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2819:    // that uses predicated moves.
 2820:    //
 2821:    // if (fabs(Ls) > fabs(Lt)) {
 2822:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2823:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2824:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2825:    //    const double A = -Qw * Lt;
 2826:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2827:    //    const double C =  Qs * Lp - Qp * Ls;
 2828: 
 2829:    //    double eta1, eta2;
 2830:    //    solveQuadratic(A, B, C, eta1, eta2);
 2831: 
 2832:    //    // Pick root with smaller |eta| (domain centered at 0).
 2833:    //    // Ternary-> predicated move, no branch divergence.
 2834:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2835: 
 2836:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2837:    //    xi = (Lp - Lt * eta) / Ls;
 2838: 
 2839:    // } else {
 2840:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2841:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2842:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2843:    //    const double A = -Qw * Ls;
 2844:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2845:    //    const double C =  Qt * Lp - Qp * Lt;
 2846: 
 2847:    //    double xi1, xi2;
 2848:    //    solveQuadratic(A, B, C, xi1, xi2);
 2849: 
 2850:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2851: 
 2852:    //    eta = (Lp - Ls * xi) / Lt;
 2853:    // }
 2854:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2855:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2856:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2857:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2858:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2859: 
 2860:    // Quadratic:  A*r^2 + B*r + C = 0
 2861:    // (same formula for both cases, just with swapped coefficients)
 2862:    const double A = -Qw * Lb;
 2863:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2864:    const double C =  Qa * Lp - Qp * La;
 2865: 
 2866:    double r1, r2;
 2867:    solveQuadratic(A, B, C, r1, r2);
 2868: 
 2869:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2870:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2871: 
 2872:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2873:    const double other = (Lp - Lb * r) / La;
 2874: 
 2875:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2876:    xi  = solve_s ? r     : other;
 2877:    eta = solve_s ? other : r;
 2878: 
 2879: 
 2880:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2881:    xi  = fmin(1.0, fmax(xi,  -1.0));
 2882:    eta = fmin(1.0, fmax(eta, -1.0));
 2883: 
 2884:    // ---- Shape functions ----
 2885:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2886:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2887:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2888:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2889:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2890:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2891:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2892:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2893: 
 2894:    return true;
 2895: }
 2896: 
 2897: /**
 2898:    Compute the shape coordinates of the point (xt,yt) in the element.
 2899:    @param xt (input): x-coordinate of the point
 2900:    @param shpCoords (output): shape coordinates of the point
 2901:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2902:    @return true if the point is inside the element, false otherwise
 2903: **/
 2904: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2905: 
 2906:    // Compute the shape coordinates of the point xt in the element.
 2907:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2908:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2909:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2910:    // from the local frame, so use additional check.
 2911: 
 2912: 
 2913:    if (isTri()) { // Triangular element
 2914: 
 2915:       // Horizontal local node coordinates. 
 2916:       Point2 x0 = nodes[0]->p;
 2917:       Point2 x1 = nodes[1]->p;
 2918:       Point2 x2 = nodes[2]->p;
 2919: 
 2920:       // If ics == 2, the node coordinates are transformed to local frame.
 2921:       if constexpr(ics==2) {
 2922:          const Point3 p0 = toPoint3(x0, nodes[0]->gz);
 2923:          const Point3 p1 = toPoint3(x1, nodes[1]->gz);
 2924:          const Point3 p2 = toPoint3(x2, nodes[2]->gz);
 2925: 
 2926: 
 2927:          // Convert the node coordinates to the local frame centered at the element center
 2928:          x0 = toPoint2(origSide->toLocalFrame(p0));
 2929:          x1 = toPoint2(origSide->toLocalFrame(p1));
 2930:          x2 = toPoint2(origSide->toLocalFrame(p2));
 2931:       }
 2932: 
 2933:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2934:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2935:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2936:       shpCoords[3] = 0.0;
 2937: 
 2938: 
 2939:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2940:       const bool res = (tmpmin >= -small);  
 2941:       
 2942:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2943:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2944: 
 2945: 
 2946:       
 2947:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2948:       // then we fix the negative shape coordinates.
 2949:       if ((tmpmin < 0) && fix) {
 2950: 
 2951:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2952:          // keeping the sum of the shape coordinates equal to 1.
 2953:          // I have tested and compared the new algorithm with the old one, and they give
 2954:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2955:          // The new algorithm should be faster since it is branchless.
 2956:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2957:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2958: 
 2959:          shpCoords[0] = (shpCoords[0] + a)*b;
 2960:          shpCoords[1] = (shpCoords[1] + a)*b;
 2961:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2962: 
 2963:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2964:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2965:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2966: 
 2967:          // Update the point coordinates for the new shape coordinates
 2968:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2969:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2970: 
 2971:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2972: 
 2973:       }
 2974: 
 2975:       // Check if the point is inside the element
 2976:       return res;      
 2977:    }
 2978:    else {
 2979:       assert(isQuad() && "computeShapeCoords");
 2980: 
 2981: 
 2982:       bool inside = false;
 2983: printf("computeShapeCoords: quad element not implemented\n");
 2984:       return true;
 2985: 
 2986: 
 2987: 
 2988:    //    if (ifl==0) then
 2989:    //      do i=1,4
 2990:    //        in1=nxq(1,i,i34(ie))
 2991:    //        in2=nxq(2,i,i34(ie))
 2992:    //        swild2(i)=signa2(xel(in1,ie),xel(in2,ie),x,yel(in1,ie),yel(in2,ie),y)
 2993:    //      enddo !i
 2994:    //      tmp=minval(swild2(1:4))/area(ie)
 2995:    //      if(tmp>-small2) then
 2996:    //        inside=1
 2997:    //        call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 2998:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 2999:    //      endif !inside quad
 3000:    //    else !ifl=1 - already inside
 3001: 
 3002: 
 3003:    //    call ibilinear(itag,ie,area(ie),xel(1,ie),xel(2,ie),xel(3,ie),xel(4,ie), &
 3004:    //   &yel(1,ie),yel(2,ie),yel(3,ie),yel(4,ie),x,y,xi,eta,shapef,icaseno)
 3005:    //      !Update pt
 3006:    //      x=dot_product(xel(1:4,ie),shapef(1:4))
 3007:    //      y=dot_product(yel(1:4,ie),shapef(1:4))
 3008:    //    endif !ifl
 3009: 
 3010: 
 3011:    //    return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 3012: 
 3013:    }
 3014: 
 3015:    assert(false && "computeShapeCoords: should never reach this point");
 3016:    return false;  // Never reached
 3017: 
 3018: }
 3019: 
 3020: 
 3021: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 3022: // Convert shape coordinates to cartesian coordinates
 3023: 
 3024:    if (isTri()) {
 3025:       // Triangular element
 3026: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 3027:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 3028:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 3029:    }
 3030:    else {
 3031:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3032:    }
 3033: 
 3034: }
