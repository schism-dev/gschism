 6420: #ifdef DONTCOMPILE
 6421: __device__ void computeVerticalAdvection(void) {
 6422:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6423: 
 6424:    sdbt(1:2,:,:)=0.d0
 6425: 
 6426:    const Side *side = FROM kernel;
 6427: 
 6428:    if(side->isDry) return;
 6429: 
 6430:    // If side is wet...
 6431: 
 6432: 
 6433:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6434:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6435:    double ws[nvrt] = {} // w @ side
 6436:    int icount = 0;
 6437:    for (int j=0; j<2; j++) {
 6438:       const Element *elem = side->elements[j];
 6439:        
 6440:       if(elem != nullptr) {
 6441:          icount++;
 6442:          for (int k=0; k<nvrt; k++) {
 6443:             ws[k] = ws[k] + elem->w[k];
 6444:          }
 6445:       }
 6446:    }  // for j
 6447: 
 6448:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6449:    ws = ws/icount;
 6450: 
 6451:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6452:    // Splines allow for a smooth transition between vertical levels.
 6453:    // Splines have continuity restrictions at the internal knots, but
 6454:    // we have to provide the 1st derivatives at the endpoints.
 6455:    const int kbs = side->kbs; 
 6456:    
 6457:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6458:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6459:    initCubicSpline(kbs, nvrt, side, ws, up)
 6460: 
 6461:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6462:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6463:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6464: 
 6465:    // Total advection (average onto side)
 6466:    const Node *node1 = side->nodes[0];
 6467:    const Node *node2 = side->nodes[1];
 6468:    for (int k=kbs(i); k<nvrt; k++) {
 6469: 
 6470:       if constexpr(ics==1) {
 6471:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6472:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6473:       } else {
 6474:          // XXX IMPLEMENT THIS
 6475:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6476:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6477:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6478:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6479:       }  // if ics
 6480: 
 6481: 
 6482:    }
 6483: }
 6484: #endif
 6485: 
 6486: 
 6487: extern "C" {
 6488:    __global__ void computeElemAverageGhat(void) {
 6489:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6490: 
 6491:       ELEM(elem);
 6492:       
 6493:       elem->ghat1= {0.0, 0.0};  
 6494: 
 6495:       if constexpr(ihydraulics != 0) {
 6496:          if (nhtblocks > 0 && elem->isblock) return;
 6497:       }
 6498: 
 6499:       if (elem->isDry) return;
 6500: 
 6501:       // Wet elements.
 6502:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6503:       // tidal potential, horizontal diffusion, and baroclinic etc
 6504:       // Remember to update both fb and F 
 6505:       // If ics=2, ghat1 are in eframe (ll)
 6506:       // cff1-3: coefficients for 2D/3D
 6507:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6508:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6509:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6510: 
 6511:       double av_cff1 = 0.0;  // av. for cff1
 6512:       double av_cff2 = 0.0;  // av. for cff2
 6513:       double av_cff3 = 0.0;  // av. for cff3
 6514:       double av_df = 0.0;  // av. for H^\alpha / H
 6515:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6516:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6517: 
 6518:       const int i34 = elem->i34;
 6519:       const int kb = elem->kb;
 6520: 
 6521:       for (int j=1; j<i34; j++) {
 6522:          // For each node and side in the element...
 6523: 
 6524:          const Node *node = elem->nodes[j];
 6525:          const Side *side = elem->sides[j];
 6526: 
 6527:          const double chi      = side->chi;
 6528:          const double veg_c2   = side->veg_c2;
 6529:          const double veg_beta = side->veg_beta;
 6530:          const double veg_h    = side->veg_h();
 6531:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6532: 
 6533:          // Node - const in elem
 6534:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6535:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6536: 
 6537:          if (elem->depth >= tip_dp) {
 6538:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6539:          }
 6540: 
 6541:          
 6542:          const double htot  = side->htot2();        // Total depth at the side
 6543:          const double zctr2 = side->zTopCanopy();  
 6544: 
 6545:          double cff1; 
 6546:          double cff2; 
 6547:          double cff3;   
 6548:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6549:          // coefficients applied to 2D/3D case 
 6550:             cff1 = side->hhat/htot;
 6551:             cff2 = 0.0;
 6552:             cff3 = 0.0;
 6553:          } else { //3D
 6554:             //Init for no-veg case
 6555:             cff1 = 1.0;
 6556:             cff2 = 1.0;
 6557:             cff3 = 0.0;
 6558: 
 6559:             if constexpr(iveg != 0) {
 6560:                // Computes coefficients used with vegetation terms G1, G2
 6561:                // cff1, cff3 are used for the first two terms in G1, G2:
 6562:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6563:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6564:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6565:                if(veg_h < 0.99*htot) { // submergent vegetation
 6566:                   cff1=1;
 6567:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6568:                   cff3 = veg_c;
 6569: 
 6570:                } else { // emergent vegetation
 6571:                   cff1 = 1.0/(1.0 + veg_c2);
 6572:                   cff2 = cff1;
 6573:                   cff3 = 0.0;
 6574: 
 6575:                }
 6576:             } // if iveg
 6577:          } //  2D/3D
 6578: 
 6579:          av_cff1 += cff1/i34;
 6580:          av_cff2 += cff2/i34;
 6581:          av_cff3 += cff3/i34;
 6582:          av_cff2_chi += cff2*chi/i34;
 6583:          av_cff3_chi += cff3*chi/i34;
 6584:          av_df += min(htot, veg_h)/(htot*i34);
 6585: 
 6586: 
 6587:          // btrack values: U^\star, U^{\star\alpha}
 6588:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6589:          Vector2 Ustar       = {0.0, 0.0}; 
 6590:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6591: 
 6592:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6593:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6594:          } else { //3D
 6595:             for (int k = side->kb; k < nvrt; k++) {
 6596:             
 6597:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6598:                Ustar += w2;
 6599: 
 6600:                if constexpr(iveg != 0) {
 6601:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6602:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6603:                        Ustar_alpha += zrat*w2; // XXXX
 6604:                    }
 6605:                }  // if iveg
 6606:             }  // for k
 6607:          }  //2D/3D
 6608:          
 6609: 
 6610:          // Add btrack & surface stress terms to \breve{G} first
 6611:          if constexpr(ics==1) {
 6612:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6613:          } else {
 6614:             // XXX IMPLEMENT THIS
 6615:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6616:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6617:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6618:          }  // if ics
 6619: 
 6620:          // Surface and bottom stress terms
 6621:          if constexpr(ics==1) {
 6622:             const Vector2 tau    = side->tau();
 6623:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6624: 
 6625:             // Term for surface and bottom stress
 6626:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6627:          } else {
 6628:             // XXX IMPLEMENT THIS
 6629:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6630:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6631:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6632:             // tau_x=(vn1+tt1)/2.d0
 6633:             // tau_y=(vn2+ss1)/2.d0
 6634:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6635:          }  // if ics
 6636: 
 6637:          
 6638: 
 6639:          // All terms in F,F^\alpha,f_b except baroclinic
 6640:          // F, f_b: all explicit terms excluding vegetation 
 6641:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 6642:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 6643:          const double coriolis = side->coriolis;
 6644:          Vector2 F  =  coriolis*side->U;  // F_x
 6645:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 6646:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 6647: 
 6648:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 6649:             
 6650:             for (int k = side->kb; k < nvrt; k++) {
 6651:                if (zctr2 > side->zc[k-1]) {
 6652:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 6653:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6654:                    Fa +=  coriolis*w2*zrat;
 6655:                } // if zctr2
 6656:             } // k
 6657:          } // iveg
 6658: 
 6659:          // Integrate horizontal viscosity force vertically
 6660:          for (int k=side->kb + 1; k<nvrt; k++) {
 6661:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 6662: 
 6663:             F += levelHorVisc;
 6664: 
 6665:             // Vegetation term
 6666:             if constexpr(iveg!=0) {
 6667:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 6668:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 6669:                   Fa += levelHorVisc*zrat;
 6670:                } 
 6671:             } // if iveg
 6672:          } // for k
 6673: 
 6674:          fb += side->nuGradU[side->kb];
 6675: 
 6676:          // Add to ghat1
 6677:          if constexpr(ics==2) {
 6678:             // XXX IMPLEMENT THIS
 6679:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6680:             // bigf1=vn1; bigf2=vn2
 6681:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6682:             // botf1=vn1; botf2=vn2
 6683:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 6684:             // bigfa1=vn1; bigfa2=vn2
 6685:          } // if ics
 6686: 
 6687:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 6688:       } // for j (nodes and sides)
 6689: 
 6690:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 6691:          
 6692:       // Finish off terms in F, F^\alpha and f_b
 6693:       const double grav3 = elem->mean(&Node::grav2);
 6694:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 6695: 
 6696: 
 6697:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 6698:       for (int j=1; j<i34; j++) { 
 6699:          // For each side in the element...
 6700:          const Side *side = elem->sides[j];
 6701:          const double chi = side->chi;
 6702: 
 6703:          const double htot = side->htot2();
 6704:          const double veg_h = side->veg_h();
 6705:          const Vector2 F  = htot*fb;
 6706:          const Vector2 Fa = min(htot, veg_h)*fb;
 6707: 
 6708:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 6709:       } // for j
 6710: printf("$$$ tmp = %.15g, %.15g\n", tmp.x, tmp.y);
 6711:       //botf1 etc are already in elem frame
 6712:       elem->ghat1 += tmp/i34;
 6713: 
 6714:       // Baroclinic force
 6715:       if constexpr(ibc==0) {
 6716:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 6717: 
 6718:          Vector2 Fa = {0.0, 0.0};
 6719:          Vector2 intGradRho = {0.0, 0.0};
 6720:          
 6721:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 6722:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 6723:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 6724: 
 6725:             // \in F [m^2/s/s]
 6726:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 6727:          }
 6728: 
 6729:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 6730:          const Vector2 F = av_df*Fa; //approx
 6731:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 6732: 
 6733:       } // if ibc
 6734: 
 6735: 
 6736: 
 6737:    }
 6738: 
 6739: } // extern "C"
 6740: 
 6741: 
 6742: 
 6743: #ifdef DONTCOMPILE
 6744: __global__ void checkMassConservation(Tracers* sumtr) {
 6745: 
 6746:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6747: 
 6748:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6749: 
 6750:    Element *elem = &(mesh->localElemData[i]);
 6751: 
 6752:    // Skip dry elements
 6753:    if (elem->isDry) return;
 6754: 
 6755:    // Local sum array for this thread
 6756:    double localSum[N_TRACERS] = {0.0};
 6757: 
 6758:    // Sum over vertical levels for this element
 6759:    const int kbe = elem->kbe;
 6760:    const double area = elem->area;
 6761: 
 6762:    for (int k = kbe; k < nvrt; k++) {
 6763:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6764:       
 6765:       // Accumulate tracer mass
 6766:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6767:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6768:       }
 6769:    }
 6770: 
 6771:    
 6772: 
 6773:    //  This function returns per element sums. A reduction must be done on the host side.
 6774: }
 6775: 
 6776: 
 6777: __global__ void transport(void) {
 6778: 
 6779:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6780: 
 6781:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6782: 
 6783:    Element *elem = &(mesh->localElemData[ie]);
 6784: 
 6785:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6786: 
 6787:                for (int m=0; m<ntr; m++) {
 6788:                   for (int k=kbe(ie); k<nvrt; k++) {
 6789:                      // Calculate each polynomial's weight 
 6790:                      wm=0.d0; sum1=0.d0; 
 6791:                      wm1=0.d0; wm2=0.d0; 
 6792:                      for (int i=0; i<elem->nweno2; i++) {
 6793:                   
 6794:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6795:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6796:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6797:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6798:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6799:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6800:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6801:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6802:                      // -----------------Hu and Shu (1999)'s method----------------
 6803:                      b4=b1+b2+b3
 6804: 
 6805: //Error: add PRODUCTION CPP
 6806: #ifdef DEBUG
 6807:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6808:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6809:                     call parallel_abort(errmsg)
 6810:                   }
 6811: #endif
 6812: 
 6813:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6814:                   // !----test-------------- 
 6815:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6816:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6817:                   // !wm(i)=wm1(i)*wm2(i)
 6818:                   // !---------------------- 
 6819:                   sum1=sum1+wm(i)
 6820:                 } // end for i
 6821: 
 6822:                 wm=wm/sum1
 6823: 
 6824:                 for (int j=0; j<elem->i34; j++) {
 6825: 
 6826:                   const Side *side  = elem->sides[j];
 6827:                   const Node *node1 = side->n1;
 6828:                   const Node *node2 = side->n2;
 6829: 
 6830:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6831:                      trsd=0.d0
 6832:                      for (int kk=0; kk<nquad; kk++) {
 6833:                         for (int i=0; i<elem->nweno2; i++) {
 6834:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6835:                         } // end for i   
 6836:                      } // end for kk
 6837:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6838:                   } // outward flux
 6839:                } // end for j=1,i34(ie) ! side
 6840:             }
 6841:          }
 6842:               
 6843: 
 6844: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6845: //             //   calculate each polynomial's weight 
 6846: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6847: //                 wm=0.d0; sum1=0.d0
 6848: //                 do i=1,nweno1(ie) !for each polynomial
 6849: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6850: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6851: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6852: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6853: //                   wm(i)=b2
 6854: //                   sum1=sum1+b2
 6855: //                   !wm(i)=1.d0
 6856: //                   !sum1=sum1+1.d0
 6857: 
 6858: // // Error: PRODUCTION
 6859: // #ifdef DEBUG
 6860: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6861: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6862: //                     call parallel_abort(errmsg)
 6863: //                   endif
 6864: // #endif
 6865: 
 6866: //                 enddo !i
 6867: //                 wm=wm/sum1 !final weight
 6868: 
 6869:                 for (int j=0; j<elem->i34; j++) { // side
 6870:                   const Side *side = elem->sides[j];
 6871:                   const Node *node1 = side->n1;
 6872:                   const Node *node2 = side->n2;
 6873: 
 6874:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6875:                     trsd=0.d0
 6876:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6877:                       for (int i=0; i<elem->nweno1; i++) {
 6878:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6879:                       }
 6880:                     enddo //kk
 6881:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6882:                   } // outward flux
 6883:                 } // end for j=1,i34(ie) ! side
 6884:               } // end for k; ntr 
 6885: 
 6886:             else !simple upwind method
 6887:               do j=1,i34(ie)
 6888:                 jsj=elside(j,ie)
 6889:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6890:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6891:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6892:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6893:                   endif
 6894:                 enddo  !vertical layers
 6895:               enddo !j=1,i34(ie) ! side
 6896:             endif !order of accuracy
 6897: 
 6898:          //  enddo !ie
 6899: // !$OMP     end do
 6900: 
