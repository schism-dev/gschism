 3917: extern "C" {
 3918:    __global__ void rollUpElevation(void) {
 3919: 
 3920:       NODE(node);
 3921: 
 3922:       node->eta1 = node->eta2;
 3923: 
 3924:    }
 3925: 
 3926: 
 3927:    __global__ void backtrackAllNodes(void) {
 3928: 
 3929:       // max/min # of sub-divisions
 3930:       const int ndelt_max = max(1.0, dt/dtb_min);
 3931:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3932: 
 3933:       // Removed all references to swild98 XXX
 3934:       // swild98=0.d0 !init
 3935: 
 3936: 
 3937:       SIDE(side);
 3938: 
 3939:       const int kb = side->kb;
 3940: 
 3941: 
 3942:       // Initialize btrack velocities to the actual velocities at the side 
 3943:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3944: 
 3945:       if (side->isDry) return;
 3946: 
 3947: 
 3948:       // Checks that at least one element is not dry
 3949:       const Element *elem1 = side->elems[0];
 3950:       const Element *elem2 = side->elems[1];
 3951: 
 3952: 
 3953:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3954:       
 3955:       // XXXXXX
 3956:       // !swild_tmp to store global coord. of the starting side
 3957:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3958:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3959:       // !Use sframe2 
 3960:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3961: 
 3962: 
 3963:       for (int k = kb; k < nvrt; k++) {
 3964:       //  Initialize (xt,yt,zt), nnel and vel.
 3965:       //  For ics=2, the coordinates are in local frames
 3966:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3967: 
 3968: 
 3969:          const int iadvf = side->iadv();  // Advection flag
 3970: 
 3971:          Point3 xt;
 3972:          if constexpr(ics==1) {
 3973:             xt = side->center3D(k); 
 3974:          }
 3975:          else // lat/lon; in side lat/lon frame
 3976:          {
 3977:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3978:          // XXX IMPLEMENT THIS
 3979:       //          xt=0.d0
 3980:       //          yt=0.d0
 3981:       //          !centroid coord. for nudging
 3982:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3983:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3984:          }  // ics
 3985: 
 3986: 
 3987: 
 3988:          // If on land or open boundary...
 3989:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3990:          
 3991:          const double vmag = length(side->u2[k]);
 3992: 
 3993:          if (vmag <= velmin_btrack) {
 3994:             // No activity 
 3995: 
 3996:             side->btu[k] = side->u2[k];
 3997:             
 3998:          } else {  // do btrack
 3999: 
 4000:             // Compute number of sub-divisions based on local gradients 
 4001:             // XXX IS THIS NECESSARY?
 4002:             double suma = 0.0;
 4003:             int icount = 0;
 4004:             for (int ii=0; ii<2; ii++) {
 4005: 
 4006:                const Element *elem = side->elems[ii];
 4007:                  
 4008:                if (elem == nullptr) continue;
 4009: 
 4010:                icount++;
 4011: 
 4012:                // Not strictly along z; in ll frame for ics=2
 4013: 
 4014:                double utmp[4];
 4015:                double vtmp[4];
 4016:                for (int jj = 0; jj < elem->i34; jj++) {
 4017: 
 4018:                   const Node *node = elem->nodes[jj];
 4019: 
 4020:                   if constexpr(ics==1) {
 4021:                      utmp[jj] = node->u2[k].x;
 4022:                      vtmp[jj] = node->u2[k].y;  
 4023:                   } else {
 4024:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 4025:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 4026:                   }
 4027:                } // for jj
 4028: 
 4029:                const Vector2 grad_u = elem->grad2(utmp); 
 4030:                const Vector2 grad_v = elem->grad2(vtmp);
 4031: 
 4032:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4033:             } // for ii
 4034: 
 4035:             assert(icount > 0 && "Impossible 77");
 4036: 
 4037:             // '4' is somewhat arbitrary
 4038:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4039: 
 4040:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4041:          
 4042: 
 4043:             Vector3 u_int = {0.0, 0.0, 0.0};
 4044: 
 4045:             side->btrack(k, dt, dtbk, u_int);
 4046:             side->btu[k] = toVector2(u_int);
 4047:                
 4048:          } // if vmag (do backtrack)
 4049: 
 4050:       } // for k=kb,nvrt-1
 4051: 
 4052:    }
 4053: 
 4054: } // extern "C"
 4055: 
 4056: template<int nc>
 4057: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4058: 
 4059: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4060: //
 4061: // a,b,c,rhs: input vectors and are not modified by this program.
 4062: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4063: // rhs is the r.h.s.
 4064: // n: actual rank of the system.
 4065: // rows in u() and rhs();
 4066: // u: output with nc columns (transposed to rows)
 4067: // gam: a working array.
 4068: //
 4069: // NOTES:
 4070: // This is a template function that allows for different numbers of columns in the rhs vector.
 4071: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4072: 
 4073:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4074:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4075: 
 4076:    double bet = b[0];
 4077:    if constexpr (nc == 1) {
 4078:       u[0] = rhs[0]/bet;
 4079:    } else {
 4080:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4081:    }
 4082: 
 4083:    for (int j = 1; j < n; j++) {
 4084:       gam[j] = c[j - 1]/bet;
 4085:       bet = b[j] - a[j]*gam[j];
 4086: 
 4087:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4088: 
 4089:       if constexpr (nc == 1) {
 4090:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4091:       } else {
 4092:          for (int l = 0; l < nc; l++) {
 4093:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4094:          }
 4095:       }
 4096:    }
 4097: 
 4098:    // Back-substitution
 4099:    for (int j = n - 2; j >= 0; j--) {
 4100:       if constexpr (nc == 1) {
 4101:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4102:       } else {
 4103:          for (int l = 0; l < nc; l++) {
 4104:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4105:          }
 4106:       }
 4107:    }
 4108: }
 4109: 
 4110: 
 4111: 
 4112: // Helper function that contains the core algorithm
 4113: template<typename XAccessor, typename YAccessor>
 4114: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4115:                                     double  yp_top, double  yp_bot, 
 4116:                                     CubicSpline &spline) {
 4117:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4118:    // 
 4119:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4120:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4121:    //
 4122:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4123:    // 
 4124:    // Inputs: 
 4125:    //            n: dimension for x etc; # of data pts (>=2);
 4126:    //            getX, getY: functions to access x,y coordinates
 4127:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4128:    //     Output: 
 4129:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4130: 
 4131:    const int n = k2 - k1 + 1;
 4132:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4133: 
 4134:    // Allocate memory for the splines
 4135:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4136:    spline.x   = new double[n];
 4137:    spline.y   = new double[n];
 4138:    spline.yp  = new double[n];
 4139:    spline.ypp = new double[n];
 4140: 
 4141:    for (int k=k1; k<=k2; k++) {
 4142:       spline.x[k] = getX(k);
 4143:       spline.y[k] = getY(k);
 4144:    }
 4145: 
 4146:    // This is to simplify expressions later
 4147:    double *x = spline.x;
 4148:    double *y = spline.y;
 4149: 
 4150:    double *a = nullptr;
 4151:    double *b = nullptr;
 4152:    double *c = nullptr;
 4153:    double *gam = nullptr;
 4154:    double *rhs = nullptr;
 4155:    
 4156: 
 4157:       a = new double[n];   // Lower diagonal
 4158:       b = new double[n];   // Diagonal
 4159:       c = new double[n];   // Upper diagonal
 4160:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4161:       rhs = new double[n]; // Right-hand side
 4162: 
 4163:    for (int k=k1; k<=k2; k++) {
 4164:       if (k == k1) {
 4165:          // Bottom level
 4166:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4167:          b[k] = (x[k+1] - x[k])/3.0;
 4168:          c[k] = b[k]/2.0;
 4169:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4170:       } else if (k == n - 1) {
 4171:          // Top level (surface)
 4172:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4173:          b[k] = (x[k] - x[k-1])/3.0;
 4174:          a[k] = b[k]/2.0;
 4175:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4176:       } else {
 4177:          // Intermediate levels
 4178:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4179:          b[k] = (x[k+1] - x[k-1])/3.0;
 4180:          a[k] = (x[k  ] - x[k-1])/6.0;
 4181:          c[k] = (x[k+1] - x[k  ])/6.0;
 4182:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4183:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4184:       }
 4185:    }
 4186: 
 4187:    // Solve the tridiagonal system
 4188:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4189:    
 4190:    spline.yp[k1] = yp_bot;
 4191:    spline.yp[k2] = yp_top;
 4192: 
 4193:    // Compute rest of 1st derivatives using the splines
 4194:    for (int k=k1+1; k<k2; k++) {
 4195:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4196:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4197:    }
 4198:    
 4199:    delete[] a;
 4200:    delete[] b;
 4201:    delete[] c;
 4202:    delete[] gam;
 4203:    delete[] rhs;
 4204: 
 4205: }
 4206: 
 4207: // Array version
 4208: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4209:                                 double y_top, double y_bot, 
 4210:                                 CubicSpline &spline) {
 4211:    auto getX = [x] (int k) { return x[k]; };
 4212:    auto getY = [y] (int k) { return y[k]; };
 4213:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4214: }
 4215: 
 4216: // Lambda version - allows custom access patterns
 4217: template<typename XFunc, typename YFunc>
 4218: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4219:                                 double y_top, double y_bot,
 4220:                                 CubicSpline &spline) {
 4221:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4222: }
