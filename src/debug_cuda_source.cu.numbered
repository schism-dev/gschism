 7739: 
 7740: __global__ void computeMatrixProductAndDotProducts() {
 7741:    // Computes A*p, r'Mr and p'Ap
 7742: 
 7743:    // 1) shared buffer: first half for rMr, second for pAp
 7744:    __shared__ double sdata[2*BLOCK_SIZE];
 7745:    double* s_rMr = sdata;
 7746:    double* s_pAp = sdata + BLOCK_SIZE;
 7747: 
 7748:    const int tid = threadIdx.x;
 7749: 
 7750:    double l_pAp = 0.0;
 7751: 
 7752:    s_rMr[tid] = 0.0;
 7753:    s_pAp[tid] = 0.0;
 7754: 
 7755:    // 2) get your node pointer
 7756:    // NODE(node);   
 7757:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7758:    Node *node = &(mesh->localNodeData[idx_node]); 
 7759:       if (idx_node < mesh->np) {
 7760: 
 7761:       const double diag = node->coeffDiag;
 7762:       const double r    = node->mR;
 7763:       const double p    = node->mP;  
 7764: 
 7765:       // apply preconditioner on the fly:
 7766:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7767: 
 7768:       // 4) compute Ap = A.p
 7769:       double Ap = node->coeffDiag * node->mP;
 7770:       for (int j = 0; j < node->numNodes; ++j) {
 7771:          const Node *nbNode = node->nodes[j];
 7772:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7773: 
 7774:       }
 7775: 
 7776:       node->mAp = Ap;
 7777:       
 7778: 
 7779:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7780:       // const double l_rMr = r*Mr;  // r'Mr
 7781:       l_pAp = p*Ap;  // p'Ap
 7782: 
 7783: 
 7784:    }
 7785: 
 7786:    // 6) write into shared mem
 7787:    // s_rMr[tid] = l_rMr;
 7788:    s_pAp[tid] = l_pAp;
 7789: 
 7790:    __syncthreads();
 7791: 
 7792:    // 7) block-wide tree reduction
 7793:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7794:       if (tid < stride)  {
 7795:          s_pAp[tid] += s_pAp[tid + stride];
 7796:       }
 7797:       __syncthreads();
 7798:    }
 7799: 
 7800:    // 8) thread 0 atomically accumulates into the globals
 7801:    // XXX: This is slower than it needs to be, but it is simple and works
 7802:    if (tid == 0) {
 7803:       atomicAdd(pAp, s_pAp[0]);
 7804:    }
 7805: 
 7806: 
 7807: }
 7808: 
 7809: 
 7810: __global__ void updateSolutionAndDotProducts(void) {
 7811:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7812: 
 7813:    const int tid = threadIdx.x;
 7814: 
 7815:    s_rMr[tid] = 0.0;
 7816: 
 7817:    // get node & bounds-check:
 7818:    NODE(node);
 7819: 
 7820:    
 7821:    // Compute alpha
 7822:    const double alpha = (*rMr_old)/(*pAp); 
 7823: 
 7824: 
 7825:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7826: 
 7827: 
 7828:    // load scalars
 7829:    const double diag = node->coeffDiag;
 7830:    const double p    = node->mP;
 7831:    const double Ap   = node->mAp;
 7832:    const double x    = node->mX;
 7833:    const double r    = node->mR;
 7834:    
 7835:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7836: 
 7837:    // 1) update solution & residual
 7838:    const double x_new = x + alpha*p;
 7839:    const double r_new = r - alpha*Ap;
 7840:    node->mX = x_new;
 7841:    node->mR = r_new;
 7842: 
 7843:    // 2) apply Jacobi preconditioner on the fly
 7844:    const double Mr_new = r_new/diag;
 7845: 
 7846: 
 7847:    // 3) local contributions for the two dot-products
 7848:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7849: 
 7850:    // 4) write into shared-mem
 7851:    s_rMr[tid] = l_rMr;
 7852: 
 7853:    __syncthreads();
 7854: 
 7855: 
 7856:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7857:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7858:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7859:       __syncthreads();
 7860:    }
 7861: 
 7862:    // 6) thread 0 atomically folds into the global accumulators
 7863:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7864: 
 7865: 
 7866: }
 7867: 
 7868: 
 7869: __global__ void updateSearchDirection() {
 7870: 
 7871:     NODE(node);
 7872: 
 7873:     // recompute z on-the-fly
 7874:     const double z = node->mR / node->coeffDiag;
 7875:     const double p = node->mP;
 7876: 
 7877:     const double beta = (*rMr_new)/(*rMr_old);
 7878: 
 7879: 
 7880:     // p =z + beta*p
 7881:     node->mP = z + beta*p;
 7882: 
 7883: }
 7884: 
 7885: __global__ void initializeScalars(double *scalars) {
 7886: 
 7887:    // These point to a cupy array in the host code
 7888:    rMr_old = scalars + 0;
 7889:    rMr_new = scalars + 1;
 7890:    pAp     = scalars + 2;
 7891: }
 7892: 
 7893: __global__ void initializePreconditionedResidual(void) {
 7894: 
 7895:     __shared__ double s_rMr[BLOCK_SIZE];  
 7896: 
 7897:     s_rMr[threadIdx.x] = 0.0;
 7898: 
 7899:     NODE_ALL(node, valid);
 7900:     const int tid = threadIdx.x;
 7901:     // For the first iteration:
 7902:     // 1. Initial solution x = 0 (already set)
 7903:     // 2. Initial residual r = b (stored in qel)
 7904:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7905: 
 7906: // XXX we should use the guess solution here    
 7907: 
 7908:     double l_rMr = 0.0;
 7909:     if (valid) {
 7910:       // Set initial residual r = b (from qel)
 7911:       node->mR = node->qel;
 7912: 
 7913:       // Compute z = M^-1 * r (preconditioned residual)
 7914:       const double z = node->mR / node->coeffDiag;
 7915: 
 7916:       // Set initial search direction p = z
 7917:       node->mP = z;
 7918: 
 7919:       // Initialize other variables needed for CG
 7920:       node->mX = 0.0;  // Initial solution
 7921:       node->mAp = 0.0; // Will be computed in first iteration
 7922: 
 7923: 
 7924:       // Computes the first r'Mr (reduction)
 7925:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7926:     }
 7927:     // 4) write into shared-mem
 7928:     s_rMr[tid] = l_rMr;
 7929: 
 7930:     __syncthreads();
 7931: 
 7932: 
 7933:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7934:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7935:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7936:         __syncthreads();
 7937:     }
 7938: 
 7939:     // 6) thread 0 atomically folds into the global accumulators
 7940:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7941: 
 7942:     *rMr_old = 0.0;
 7943:     *pAp = 0.0;
 7944: }
 7945: 
 7946: 
 7947: 
 7948: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7949:    Element *elems = mesh->localElemData;
 7950: 
 7951:    *addr = elems;
 7952:    *sizeElement = sizeof(Element);
 7953:    switch (varCode) {
 7954:       case (int)VarCode::z:
 7955:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7956:          *sizeType = sizeof(double);
 7957:          break;
 7958:       case (int)VarCode::x:
 7959:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7960:          *sizeType = sizeof(Vector2);
 7961:          break;
 7962:       case (int)VarCode::area:
 7963:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7964:          *sizeType = sizeof(double);
 7965:          break;
 7966:       case (int)VarCode::depth:
 7967:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7968:          *sizeType = sizeof(double);
 7969:          break;
 7970:       case (int)VarCode::radius:
 7971:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7972:          *sizeType = sizeof(double);
 7973:          break;
 7974:       case (int)VarCode::lonlat:
 7975:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7976:          *sizeType = sizeof(double);
 7977:          break;
 7978:       case (int)VarCode::ghat:
 7979:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7980:          *sizeType = sizeof(Vector2);
 7981:          break;
 7982:       case (int)VarCode::kb:
 7983:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7984:          *sizeType = sizeof(int);
 7985:          break;
 7986:       case (int)VarCode::isdry:
 7987:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7988:          *sizeType = sizeof(int);
 7989:          break;            
 7990:       case (int)VarCode::w:
 7991:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7992:          *sizeType = sizeof(double);
 7993:          break;
 7994:       case (int)VarCode::FaceIndices:
 7995:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7996:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7997:          *sizeType = sizeof(Node);
 7998:          break;
 7999:       default:
 8000:          *offset = -1;
 8001:    }
 8002: }
 8003: 
