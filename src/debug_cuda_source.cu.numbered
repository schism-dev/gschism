 2378: 
 2379: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2380: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2381: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2382: // Only when ics == 2, the origin is at the element center.
 2383: 
 2384:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2385: 
 2386:    const Node *node = nodes[idxNode];
 2387: 
 2388:    if constexpr(ics==1) {
 2389:       return node->p;
 2390: 
 2391:    } else {
 2392:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2393: 
 2394:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2395: 
 2396:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2397:    }
 2398: 
 2399: }
 2400: 
 2401: 
 2402: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2403:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2404: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2405: 
 2406:    const int id1 = idx;
 2407:    const int id2 = nxq(1 + id1);
 2408:    const int id3 = nxq(2 + id1);
 2409: 
 2410:    if constexpr(ics==1) {
 2411:       x0 = nodes[id1]->p;
 2412:       x1 = nodes[id2]->p;
 2413:       x2 = nodes[id3]->p;
 2414: 
 2415:    } else {
 2416: 
 2417:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2418:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2419:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2420: 
 2421:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2422:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2423:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2424: 
 2425:    }
 2426: 
 2427: }
 2428: 
 2429: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2430:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2431: }
 2432: 
 2433: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2434:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2435:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2436: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2437: 
 2438:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2439: 
 2440: 
 2441: 
 2442:    if constexpr(ics==1) {
 2443:       x0 = nodes[0]->p;
 2444:       x1 = nodes[1]->p;
 2445:       x2 = nodes[2]->p;  
 2446:       x3 = nodes[3]->p;
 2447: 
 2448:    } else {
 2449: 
 2450:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2451:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2452:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2453:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2454: 
 2455:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2456:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2457:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2458:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2459:    }
 2460: 
 2461: }
 2462: 
 2463: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2464:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2465: {
 2466:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2467: }
 2468: 
 2469: 
 2470: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2471: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2472: // Returns the normal vector and the area of the element at this level
 2473:    
 2474:    double nx, ny, nz;
 2475: 
 2476:    if (isTri()) {
 2477:       // For triangles...
 2478: 
 2479:       // Indices of the nodes at level k, taking care of not going below the bed
 2480:       const int k0 = max(k, nodes[0]->kb);
 2481:       const int k1 = max(k, nodes[1]->kb);
 2482:       const int k2 = max(k, nodes[2]->kb);
 2483: 
 2484:       // Gets the element frame coordinates of the nodes at level k
 2485:       Point3 x0, x1, x2;
 2486:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2487:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2488:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2489:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2490: 
 2491:       } else {  // ics == 2
 2492:          Point2 h0, h1, h2;
 2493: 
 2494:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2495: 
 2496:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2497:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2498:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2499:       }
 2500: 
 2501:       const Vector3 n20 = x2 - x0;
 2502:       const Vector3 n10 = x1 - x0; 
 2503: 
 2504:       // Computes the cross product of vectors n20 and n10. 
 2505:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2506:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2507:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2508: 
 2509:   
 2510:    }
 2511:    else {
 2512:       // For quads...
 2513:       Point2 h0, h1, h2, h3;
 2514: 
 2515:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2516: 
 2517:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2518:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2519:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2520:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2521: 
 2522:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2523:       nx = n20.y*n31.z - n20.z*n31.y;
 2524:       ny = n20.z*n31.x - n20.x*n31.z;
 2525:       nz = n20.x*n31.y - n20.y*n31.x;
 2526: 
 2527:    }
 2528: 
 2529:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2530:    area3D = 0.5*len;
 2531: 
 2532:    const double inv_len = 1.0/len;
 2533: 
 2534:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2535: 
 2536: }
 2537: 
 2538: 
 2539: // Helper functions to get the 2D local node position for the Celestial walk
 2540: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2541:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2542:    const Node *node = getNodeInOrder(idx2);
 2543: 
 2544:    double z = 0.0;
 2545:    if constexpr(ics == 2) z = node->gz;
 2546:    
 2547:    Point3 p = toPoint3(node->p, z);
 2548: 
 2549:    return toPoint2(origSide->toLocalFrame(p));
 2550: }
 2551: 
 2552: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2553:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2554: }
 2555: 
 2556: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2557:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2558: // Computes the three per-side predicates needed for the celestial walk
 2559: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2560: //
 2561: // xt is in local frame coordinates for origSide if ics == 2.
 2562: //
 2563: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2564: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2565: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2566: // meaningless on triangles are masked to a safe value (see comments below).
 2567: {
 2568:    // Project all 4 corner positions once into the local 2D frame.
 2569:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2570:    // getLocalNodePosition only transforms/projects if ics == 2.
 2571:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2572:                         getLocalNodePosition(1, origSide), 
 2573:                         getLocalNodePosition(2, origSide), 
 2574:                         getLocalNodePosition(3, origSide)};
 2575: 
 2576:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2577:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2578:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2579:    // But still farther towards the target point from the current point.
 2580:    const Vector2 vt0 = xt - x0;
 2581:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2582:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2583:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2584: 
 2585:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2586:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2587: 
 2588: 
 2589: // if (origSide->idx == 2860848 && jlev == 46) {
 2590: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2591: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2592: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2593: // }
 2594:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2595:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2596:    //  here the orientation is baked into the corners array.)
 2597:    const int i3 = nxq(3);
 2598:    const Vector2 s0 = C[ 1] - C[ 0];
 2599:    const Vector2 s1 = C[ 2] - C[ 1];
 2600:    const Vector2 s2 = C[i3] - C[ 2];
 2601:    const Vector2 s3 = C[ 0] - C[i3];
 2602:    
 2603:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2604:    // The corners array is built from getNode in CCW order, so the orientation
 2605:    // is already correct and no ssign factor is needed in the formulas below.
 2606:    //
 2607:    // i3 = nxq(3): the index of the corner after side 2.
 2608:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2609:    //   Quad:     i3 == 3.
 2610:    //
 2611:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2612:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2613:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2614:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2615:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2616:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2617: 
 2618: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2619: 
 2620:    // For triangles, the corner after side 2 is the closing corner where
 2621:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2622:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2623:    // s0 for triangles, s3 for quads.
 2624:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2625: 
 2626:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2627:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2628:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2629:    //
 2630:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2631:    // result is false naturally. No sentinel needed.
 2632:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2633:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2634:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2635:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2636: 
 2637:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2638:    // on the "exit through side I" half of the corner cone, separated by the
 2639:    // approximate angular bisector of the celestial walk. The bisector is
 2640:    // perpendicular to the chord across the corner; the test is the sign of
 2641:    // (xt - corner_vertex) projected onto that chord.
 2642:    //
 2643:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2644:    // (the validity rule sets valid_3 = false), so its computed value for
 2645:    // triangles doesn't matter. No sentinel needed.
 2646:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2647:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2648:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2649:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2650: 
 2651: }
 2652: 
 2653: 
 2654: __inline__ __device__ double Element::computeSignedArea(void) const {
 2655:    // Compute the area of the element
 2656: 
 2657:    Point2 x0, x1, x2, x3;
 2658:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2659: 
 2660: 
 2661:    double res = signedArea(x0, x1, x2);
 2662: 
 2663:    // In the quad case we need to add the area of the other triangle.
 2664:    if (isQuad()) {
 2665:       x3 = getLocalHorizontalNodePosition(3);
 2666:       double ar1 = signedArea(x0, x2, x3);
 2667:       double ar2 = signedArea(x0, x1, x3);
 2668:       double ar3 = signedArea(x1, x2, x3);
 2669:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2670: 
 2671:       res += ar1;
 2672: 
 2673:    }
 2674: 
 2675:    return res;
 2676: }
 2677: 
 2678: 
 2679: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2680:                                                                 (nodes[1]->isDry2()) ||
 2681:                                                                 (nodes[2]->isDry2()) ||
 2682:                                                                 (isQuad() && nodes[3]->isDry2());
 2683: }
 2684: 
 2685: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2686:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2687: }
 2688: 
 2689: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2690:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2691: }
 2692: 
 2693: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2694:    // In boundary sides, the element 1 is nullptr
 2695:    return side->elems[1] == nullptr; 
 2696: }
 2697: 
 2698: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2699:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2700:    // For ics == 2, this function uses local frame coordinates.
 2701: 
 2702:    assert(isQuad());
 2703: 
 2704:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2705:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2706:    // where vxi, veta, vb are vectors and c is the center of the element.
 2707: 
 2708:    Point2 p0, p1, p2, p3;
 2709: 
 2710:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2711: 
 2712:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2713:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2714:    // vectors vxi and veta connect the centers of opposite sides
 2715:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2716:    // vb is zero for parallelogram elements.
 2717:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2718: 
 2719:    //  The bilinear mapping is:
 2720:    //      P(s,t) = C + s*U + t*V + s*t*W
 2721:    //
 2722:    //  where:
 2723:    //    C = centroid (average of four vertices)
 2724:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2725:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2726:    //    W = bilinear correction; measures deviation from parallelogram
 2727:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2728:    //        W = 0 for parallelogram elements.
 2729:    //
 2730:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2731:    //
 2732:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2733:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2734:    //
 2735:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2736:    //
 2737:    //  Geometrically, (L) projects everything onto the direction
 2738:    //  perpendicular to W, where the mapping is purely affine.
 2739:    //
 2740:    //  The dot product with nb retains the nonlinear term:
 2741:    //
 2742:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2743:    //
 2744:    //  Geometrically, (Q) projects onto the W direction, where
 2745:    //  the nonlinearity lives.
 2746:    //
 2747:    //  We solve (L) for whichever variable has the larger coefficient
 2748:    //  (better conditioned back-substitution), substitute into (Q),
 2749:    //  and get a scalar quadratic in the other variable.
 2750:    // ================================================================
 2751: 
 2752:    // ---- Basis vectors ----
 2753:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2754:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2755:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2756:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2757:    // W: nonlinear correction. Difference between quad and parallelogram.
 2758:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2759:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2760: 
 2761:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2762:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2763:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2764:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2765:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2766: 
 2767:    // ---- nb: direction parallel to W, L1-normalized ----
 2768:    // We don't need a unit vector -- just a well-scaled direction parallel
 2769:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2770:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2771:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2772:    //
 2773:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2774:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2775:    // and the quadratic solver takes its linear path (a ~ 0).
 2776:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2777:    const double inv_wlen = 1.0 / wlen1;
 2778:    const Vector2 nb = vb * inv_wlen;
 2779: 
 2780:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2781:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2782:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2783:    // What remains is a pure affine relationship between xi and eta.
 2784:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2785:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2786:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2787: 
 2788:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2789:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2790:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2791:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2792:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2793:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2794:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2795: 
 2796:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2797:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2798:    // minimizing round-off amplification.
 2799:    //
 2800:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2801:    // that uses predicated moves.
 2802:    //
 2803:    // if (fabs(Ls) > fabs(Lt)) {
 2804:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2805:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2806:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2807:    //    const double A = -Qw * Lt;
 2808:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2809:    //    const double C =  Qs * Lp - Qp * Ls;
 2810: 
 2811:    //    double eta1, eta2;
 2812:    //    solveQuadratic(A, B, C, eta1, eta2);
 2813: 
 2814:    //    // Pick root with smaller |eta| (domain centered at 0).
 2815:    //    // Ternary-> predicated move, no branch divergence.
 2816:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2817: 
 2818:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2819:    //    xi = (Lp - Lt * eta) / Ls;
 2820: 
 2821:    // } else {
 2822:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2823:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2824:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2825:    //    const double A = -Qw * Ls;
 2826:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2827:    //    const double C =  Qt * Lp - Qp * Lt;
 2828: 
 2829:    //    double xi1, xi2;
 2830:    //    solveQuadratic(A, B, C, xi1, xi2);
 2831: 
 2832:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2833: 
 2834:    //    eta = (Lp - Ls * xi) / Lt;
 2835:    // }
 2836:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2837:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2838:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2839:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2840:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2841: 
 2842:    // Quadratic:  A*r^2 + B*r + C = 0
 2843:    // (same formula for both cases, just with swapped coefficients)
 2844:    const double A = -Qw * Lb;
 2845:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2846:    const double C =  Qa * Lp - Qp * La;
 2847: 
 2848:    double r1, r2;
 2849:    solveQuadratic(A, B, C, r1, r2);
 2850: 
 2851:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2852:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2853: 
 2854:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2855:    const double other = (Lp - Lb * r) / La;
 2856: 
 2857:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2858:    xi  = solve_s ? r     : other;
 2859:    eta = solve_s ? other : r;
 2860: 
 2861: 
 2862:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2863:    xi  = clamp(xi,  -1.0, 1.0);
 2864:    eta = clamp(eta, -1.0, 1.0);
 2865: 
 2866:    // ---- Shape functions ----
 2867:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2868:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2869:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2870:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2871:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2872:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2873:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2874:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2875: 
 2876:    return true;
 2877: }
 2878: 
 2879: /**
 2880:    Compute the shape coordinates of the point (xt,yt) in the element.
 2881:    @param xt (input): x-coordinate of the point
 2882:    @param shpCoords (output): shape coordinates of the point
 2883:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2884:    @return true if the point is inside the element, false otherwise
 2885: **/
 2886: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2887: 
 2888:    // Compute the shape coordinates of the point xt in the element.
 2889:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2890:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2891:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2892:    // from the local frame, so use additional check.
 2893: 
 2894: 
 2895:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2896: 
 2897:    if (isTri()) { // Triangular element
 2898: 
 2899:       // Horizontal local node coordinates. 
 2900:       Point2 x0, x1, x2;
 2901:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2902: 
 2903:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2904:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2905:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2906:       shpCoords[3] = 0.0;
 2907: 
 2908:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2909:       const bool res = (tmpmin >= -small);  
 2910:       
 2911:       // When to fix the negative shape coordinates?
 2912:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2913: 
 2914:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2915:       // then we fix the negative shape coordinates.
 2916:       if ((tmpmin < 0) && fix) {
 2917: 
 2918:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2919:          // keeping the sum of the shape coordinates equal to 1.
 2920:          // I have tested and compared the new algorithm with the old one, and they give
 2921:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2922:          // The new algorithm should be faster since it is branchless.
 2923:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2924:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2925: 
 2926:          shpCoords[0] = (shpCoords[0] + a)*b;
 2927:          shpCoords[1] = (shpCoords[1] + a)*b;
 2928:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2929: 
 2930:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2931:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2932:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2933: 
 2934:          // Update the point coordinates for the new shape coordinates
 2935:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2936:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2937: 
 2938:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2939: 
 2940:       }
 2941: 
 2942:       // Return true if the point is inside the element
 2943:       return res;      
 2944:    }
 2945:    else {
 2946:       assert(isQuad() && "computeShapeCoords");
 2947: 
 2948:       // Horizontal local node coordinates with respect to the original side.
 2949:       Point2 x0, x1, x2, x3;
 2950:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2951: 
 2952:       const double a0 = signedArea(x0, x1, xt);
 2953:       const double a1 = signedArea(x1, x2, xt);
 2954:       const double a2 = signedArea(x2, x3, xt);
 2955:       const double a3 = signedArea(x3, x0, xt);
 2956: 
 2957:       const double minArea = min4(a0, a1, a2, a3);
 2958:       
 2959:       const bool res = (minArea > -small*area);
 2960: 
 2961:       // When to fix the negative shape coordinates?
 2962:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2963: 
 2964:       double xi, eta;    
 2965: 
 2966:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2967:       // Does nothing if ics == 1.
 2968:       assert(origSide != nullptr);
 2969:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 2970: 
 2971:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2972: 
 2973:       if (fix) {
 2974:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2975:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2976:          xt.x = interpolate(shpCoords, xn);
 2977:          xt.y = interpolate(shpCoords, yn);
 2978:       }
 2979: 
 2980:       return res;
 2981:    }
 2982: 
 2983: 
 2984:    assert(false && "computeShapeCoords: should never reach this point");
 2985:    return false;  // Never reached
 2986: 
 2987: }
 2988: 
 2989: 
 2990: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2991: // Convert shape coordinates to cartesian coordinates
 2992: 
 2993:    if (isTri()) {
 2994:       // Triangular element
 2995: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2996:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2997:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2998:    }
 2999:    else {
 3000:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3001:    }
 3002: 
 3003: }
 3004: 
 3005: 
 3006: 
 3007: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3008:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3009:    
 3010:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3011: }
 3012: 
 3013: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3014:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3015:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3016:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3017:    return area * dot(gradPhi[i], gradPhi[j]);
 3018: }
 3019: 
 3020: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3021:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3022:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3023:    // The formula for the integral is:
 3024:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3025:    
 3026:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3027:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3028:    const double eta_sum  = eta_n(i) + eta_n(j);
 3029:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3030: 
 3031:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3032:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3033: 
 3034: 
 3035:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3036: }
 3037:    
 3038: 
 3039: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3040:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3041:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3042:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3043:    // The formula is also based on the identity:
 3044:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3045:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3046: 
 3047:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3048: 
 3049: 
 3050: 
 3051:    double res = 0.0;
 3052:    
 3053:    // Quadrature points in xi and eta coordinates
 3054:    #pragma unroll
 3055:    for (int i = 0; i < 4; i++) {
 3056:       // For each quadrature point...
 3057: 
 3058:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3059:       const double eta = p.x;
 3060:       const double xi  = p.y;
 3061: 
 3062:       // Jacobian entries at the Gauss point p
 3063:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3064:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3065:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3066:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3067: 
 3068:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3069:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3070: 
 3071:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3072:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3073:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3074:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3075:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3076: 
 3077:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3078:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3079:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3080:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3081:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3082: 
 3083:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3084:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3085:    }
 3086: 
 3087:    return res;
 3088: }
 3089: 
 3090: 
 3091: /**  Interpolate velocities at a given point (xt,yt,zt)
 3092: 
 3093:    @param xt, yt, zt: coordinates of the point to interpolate
 3094:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3095: 
 3096:    This is done in four steps:
 3097: 
 3098:    1. Find the shape coordinates for the final position in the element.
 3099:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3100:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3101:       z levels at xt, yt at each step.   
 3102:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3103:       horizontally and vertically.
 3104: **/
 3105: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3106:    // Interpolate the velocities at the point xt. 
 3107:    // This function works the same for triangular and quadrilateral elements.
 3108:    double shpCoord[4];
 3109:    Vector3 u_int;
 3110: 
 3111: 
 3112:    // First step is to compute the shape coordinates of (xt,yt)
 3113: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3114:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3115: 
 3116:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3117: 
 3118:    // Second step is to find the level that contains zt
 3119:    // Uses a binary search to find the level
 3120:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3121:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3122:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3123:    int R = nvrt - 1;
 3124: 
 3125:    // Get the z coordinates at the nodes of the element at the levels L and R
 3126:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3127:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3128:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3129: 
 3130: 
 3131:    double zL = interpolate(shpCoord, zLAtNodes);
 3132:    double zR = interpolate(shpCoord, zRAtNodes);
 3133: 
 3134:    // Interpolates vertically the velocities
 3135:    double wght1, wght2;
 3136:    if (xt.z <= zL) {
 3137:       wght1 = 1.0;
 3138:       wght2 = 0.0;
 3139:       xt.z = zL;
 3140:    }
 3141:    else if (xt.z >= zR) {
 3142:       wght1 = 0.0;
 3143:       wght2 = 1.0;
 3144:       xt.z = zR;
 3145:    }
 3146:    else {
 3147:       // Perform a binary search to find the levels between L and R that contain xt.z
 3148:       while (R - L > 1) {
 3149:          int M = (L + R) / 2.0;
 3150: 
 3151:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3152:          double zM = interpolate(shpCoord, zMAtNodes);
 3153:          if (zM < xt.z) 
 3154:          {
 3155:             L = M;
 3156:             zL = zM;
 3157:          }
 3158:          else 
 3159:          {
 3160:             R = M;
 3161:             zR = zM;
 3162:          }
 3163:       }
 3164:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3165:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3166: 
 3167:       wght2 = (xt.z - zL)/(zR - zL);
 3168:       wght1 = 1.0 - wght2;
 3169: 
 3170:    }
 3171: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3172: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3173:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3174:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3175:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3176:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3177: 
 3178:    // Project the velocity from the local frame to the origSide frame
 3179:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3180:    u_int = {uv.x, uv.y, w};
 3181: 
 3182:    // Neither of the interpolated velocities should be NaN
 3183:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3184: 
 3185:    return u_int;
 3186: 
 3187: }
 3188: 
 3189: 
 3190: 
 3191: 
 3192: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3193: 
 3194:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3195:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3196:    const Node *n1 = side->n1;
 3197:    const Node *n2 = side->n2;
 3198: 
 3199:    bool n1_match = (n1->nodeBnd->segment == segment);
 3200:    bool n2_match = (n2->nodeBnd->segment == segment);
 3201: 
 3202:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3203:    if (n1_match && n2_match) {
 3204:       return 0.5;
 3205:    } else if (n1_match) {
 3206:       return 1.0;
 3207:    } else if (n2_match) {
 3208:       return 0.0;
 3209:    }
 3210: 
 3211:    return 0.0;
 3212: }
 3213: 
 3214: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3215: 
 3216: 
 3217: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3218: 
 3219:    const double w1 = getBoundaryArrayValueWeight();
 3220:    const double w2 = 1.0 - w1;
 3221:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3222:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3223: 
 3224:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3225: }
 3226: 
 3227: 
 3228: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3229:    const double w1 = getBoundaryArrayValueWeight();
 3230:    const double w2 = 1.0 - w1;
 3231:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3232:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3233: 
 3234:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3235: 
 3236: }
 3237: 
 3238: 
 3239: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3240:    // Returns the value of the velocity at the side center
 3241:    const double w1 = getBoundaryArrayValueWeight();
 3242:    const double w2 = 1.0 - w1;
 3243:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3244:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3245: 
 3246:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3247: }
 3248: 
 3249: 
 3250: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3251:    // Returns the value of the normal component of the velocity at the side center
 3252:    const double w1 = getBoundaryArrayValueWeight();
 3253:    const double w2 = 1.0 - w1;
 3254:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3255:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3256: 
 3257:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3258: }
 3259: 
 3260: 
 3261: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3262:    if constexpr(ics == 1) {
 3263:       return center;
 3264: 
 3265:    } else {
 3266:       const Point2 p0 = n1->outputCoords();
 3267:       const Point2 p1 = n2->outputCoords();
 3268:       return (1.0/2.0)*(p0 + p1);
 3269: 
 3270:    }
 3271: }
 3272: 
 3273: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3274: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3275: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3276: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3277: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3278: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3279: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3280: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3281: // Computes the gradient of the field at the side center.
 3282:    Vector2 grad = {0.0, 0.0};
 3283:    int count = 0;
 3284: 
 3285:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3286:    // as the average of the gradients at each element.
 3287:    // First element
 3288:    if (elems[0] != nullptr && condition(elems[0])) {
 3289:       Vector2 elemGrad = elems[0]->grad2(field);
 3290: 
 3291:       // For ics=2, projects the element gradient from its frame to the side frame
 3292:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3293: 
 3294:       grad += elemGrad;
 3295: 
 3296:       count++;
 3297:    }
 3298: 
 3299:    // Second element
 3300:    if (elems[1] != nullptr && condition(elems[1])) {
 3301: 
 3302:       Vector2 elemGrad = elems[1]->grad2(field);
 3303: 
 3304:       // For ics=2, projects the element gradient from its frame to the side frame
 3305:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3306: 
 3307:       grad += elemGrad;
 3308: 
 3309:       count++;
 3310:    }
 3311: 
 3312:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3313:    if (count > 0) {
 3314:       grad = grad*(1.0/count);
 3315:    }
 3316:    
 3317:    return grad;
 3318: }
 3319: 
 3320: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3321: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3322: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3323: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3324: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3325: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3326: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3327: 
 3328: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3329: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3330: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3331: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3332: 
 3333: 
 3334: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3335: 
 3336: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3337:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3338:    if constexpr(ics == 1) { 
 3339:       return 0.5*(n1->tau + n2->tau);
 3340: 
 3341:    } else {
 3342:       // Project the tau from the node frames to the side frame
 3343:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3344:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3345: 
 3346:       return 0.5*(stau1 + stau2);
 3347:    }
 3348: }
 3349: 
 3350: /**
 3351:  * This method performs backtracking from the side center until a time -dt back in time 
 3352:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3353:  * intermediate point.
 3354:  *
 3355:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3356:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3357:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3358:  * remaining time.
 3359:  * 
 3360:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3361:  * 
 3362:  * @param uuint, vvint, wwint: Velocities at the final point
 3363:  * @param jlev: Level at which the backtracking is performed
 3364:  * @param dt, dtbk: Tracking timesteps
 3365:   */
 3366: __inline__ __device__ void Side::btrack(
 3367:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3368:       double dt,            // Tracking time
 3369:       double dtbk,          // Tracking timestep
 3370:       Vector3 &u_int        // Velocities at the initial point
 3371: ) const {
 3372: 
 3373:    // Start from side center
 3374:    Point3 x0;
 3375: 
 3376:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3377:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3378: 
 3379:  
 3380:    double time_rm = dt; // Remaining time
 3381:    double time_rm_1 = 1e10;
 3382:    double time_rm_2 = 2e10;
 3383:    double time_rm_3 = 3e10;
 3384: 
 3385: 
 3386:    // Initial velocities
 3387:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3388: 
 3389:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3390:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3391: 
 3392:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3393: 
 3394: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3395: 
 3396: 
 3397:    constexpr int MAX_ITERATIONS = 100; 
 3398:    int iter = 0;
 3399:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3400:    while(true) {
 3401: 
 3402:       // Calculate timestep
 3403:       const double dtb = min(dtbk, time_rm);
 3404: 
 3405:       // Next point in the backtracking curve
 3406:       xt = x0 - dtb*u_int;
 3407: 
 3408:       double t, s; // parameters for the line segments p0pt and p1p2
 3409:       Side *lastCrossSide = nullptr;
 3410:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3411: 
 3412: 
 3413:       if (time_rm_3 <= time_rm) {
 3414:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3415:          xt = x0;
 3416:          break;
 3417:       }
 3418: 
 3419: 
 3420:       if (!found) {
 3421:       // This means that the walk reached a boundary or a dry element.
 3422: 
 3423:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3424: 
 3425:          // Finds the point at the boundary where the line segment x0xt intersects.
 3426:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3427:          // due to floating point errors, it does not exactly intersect.
 3428:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3429:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3430:          // To compute the intersection point we start with the parametric equations.
 3431:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3432:          // We cross-prouct by v1 to cancel the s term:
 3433:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3434:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3435: 
 3436:          // Side coordinates in the origSide frame.
 3437:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3438:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3439: 
 3440:          Point2  p0 = {x0.x, x0.y};
 3441:          Point2  pt = {xt.x, xt.y};
 3442: 
 3443:          const Vector2 v1 = pt - p0;
 3444:          const Vector2 v2 = p2 - p1;
 3445: 
 3446: 
 3447: 
 3448:          // We are assuming intersection, so we clamp t to the range [0,1].
 3449:          const double denom = cross(v2, v1);
 3450:          
 3451: 
 3452: 
 3453: 
 3454:          if (abs(denom) < small) {
 3455:             // small denominators are fairly common. They occur when the line segment x0xt 
 3456:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3457:             // boundary, where the backtracking curve startt sliding along the boundary.
 3458:             // In this case, we simply assume that the two lines are very close to each other
 3459:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3460:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3461:             if (t<0.0000000001) t = 0.0;
 3462:             if (t>0.9999999999) t = 1.0;
 3463: 
 3464:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3465:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3466: 
 3467:          }
 3468:          else {
 3469:             
 3470:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3471:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3472:             if (t>0.9999999999) t = 1.0;
 3473:             // From the originaL equation we can solve for s:
 3474:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3475:             // Computing the dot product by v1, we get:
 3476:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3477:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3478:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3479: 
 3480:          }
 3481: 
 3482:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3483: 
 3484: 
 3485:          // We update the new target point to be right at the intersection point,
 3486:          // and the remaining time must include the time we haven't "used".
 3487:          time_rm -= s*dtb;
 3488:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3489: 
 3490: 
 3491:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3492:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3493: 
 3494:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3495:          // but extracting only the component along the tangent vector v2.
 3496:          Vector2 tangent = normalize(v2);
 3497:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3498: 
 3499:          const Vector2 u2D = make_double2(u.x, u.y);
 3500:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3501: 
 3502: 
 3503:       } else {
 3504: 
 3505:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3506: 
 3507:          time_rm -= dtb; 
 3508: 
 3509:          u_int = curElem->interpolateVelocities(xt, this);
 3510: 
 3511:       }
 3512: 
 3513:       if (time_rm <= 0.0) break; 
 3514: 
 3515:       // If the velocity is too small, we stop the backtracking
 3516:       const double vmag2 = norm2(toVector2(u_int));
 3517:       if (vmag2 <= velmin_btrack_sq)  {
 3518:          time_rm = 0.0; 
 3519:          return; 
 3520:       }
 3521: 
 3522:       // The current point becomes the next segment's starting point.
 3523:       x0 = xt;
 3524:  
 3525:       iter++;
 3526: 
 3527: // XXXXXXXXXXXXXXXXX
 3528: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3529:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3530: 
 3531:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3532:       time_rm_3 = time_rm_2;
 3533:       time_rm_2 = time_rm_1;
 3534:       time_rm_1 = time_rm;
 3535:    }
 3536: 
 3537:    assert(curElem != nullptr && "Final element is nullptr");
 3538:    assert(!curElem->isDry && "Final element is dry");
 3539:    
 3540: 
 3541: 
 3542:    // Interpolate the velocities at the final point with respect to the current side frame
 3543:    u_int = curElem->interpolateVelocities(xt, this);
 3544: 
 3545: 
 3546: }
 3547: 
 3548: 
 3549: 
 3550: 
 3551: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3552: 
 3553: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3554: 
 3555:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3556:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3557: 
 3558:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3559:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3560: 
 3561:    double fun_lat = 0.0;
 3562:    switch (jspc[idxComp]) {
 3563:       case 0:
 3564:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3565:          break;
 3566:       case 1:
 3567:          fun_lat = sin(2.0*lat);
 3568:          break;
 3569:       case 2:
 3570:          fun_lat = pow<2>(cos(lat));
 3571:          break;
 3572:       default:
 3573:          assert(false && "computeETP: invalid jspc");
 3574:    }
 3575:    
 3576:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3577: 
 3578: }
 3579: 
 3580: 
 3581: __device__ void Node::updateKb(void) {
 3582: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3583: 
 3584:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3585: 
 3586: 
 3587:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3588: 
 3589:    if constexpr(ivcor == 2) {  // SZ coordinates
 3590:       
 3591:       // Compute bottom level index
 3592:       if (depth <= mesh->h_s) {
 3593:          kb = izlev;   
 3594:          
 3595:       } else {
 3596:          kb = -1;
 3597:          int L = 0;
 3598:          int R = nzlev; 
 3599:          
 3600:          while (L <= R) {
 3601:             int M = (R + L) / 2;
 3602: 
 3603: 
 3604:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3605:             
 3606:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3607:                R = M;
 3608:             } else {
 3609:                L = M;
 3610:             }
 3611: 
 3612:             if (R - L == 1) {
 3613:                kb = L;
 3614:                break;
 3615:             }
 3616:          }
 3617: 
 3618:          // Checks that the binary search was successful
 3619:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3620:        
 3621:       }
 3622:    } 
 3623: }
 3624: 
