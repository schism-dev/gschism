 1816: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int label = -1) {
 1817: // return;   
 1818:    // Lock the mutex
 1819:    lock(&debugPlotMutex);
 1820:  
 1821:    bool ok = true;
 1822:    if (debugPlotIdx == nullptr) ok = false;
 1823:    if (*debugPlotIdx >= 10000) ok = false;
 1824:    if (ok) {
 1825:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1826:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1827:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1828:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1829:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1830:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1831:       debugPlot[(*debugPlotIdx) + 6*10000] = (double)label;
 1832:       (*debugPlotIdx)++;
 1833:    }
 1834: 
 1835:    __threadfence();               // ensure all above writes are visible
 1836:    // Unlock the mutex
 1837:    unlock(&debugPlotMutex);
 1838: 
 1839: }
