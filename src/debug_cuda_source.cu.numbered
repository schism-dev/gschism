 2305: 
 2306: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2307:    // Returns the value of the velocity at the side center
 2308:    const double w1 = getBoundaryArrayValueWeight();
 2309:    const double w2 = 1.0 - w1;
 2310:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2311:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2312: 
 2313:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2314: }
 2315: 
 2316: 
 2317: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 2318:    // Returns the value of the normal component of the velocity at the side center
 2319:    const double w1 = getBoundaryArrayValueWeight();
 2320:    const double w2 = 1.0 - w1;
 2321:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2322:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2323: 
 2324:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 2325: }
