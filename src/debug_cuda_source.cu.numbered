 6190:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 6191: 
 6192:       NODE(node);
 6193: 
 6194:       node->ETP = 0.0;
 6195: 
 6196:       if constexpr(ntip == 0) return;
 6197: 
 6198:       // For all tidal potential components
 6199:       for (int j=0; j<ntip; j++) {
 6200: 
 6201:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 6202: 
 6203:          node->ETP += nodeETP;
 6204: 
 6205:          if constexpr(iloadtide==1) { // loading tide
 6206:             assert(false && "Loading tide not implemented");
 6207:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6208:          }
 6209:          
 6210:       }
 6211: 
 6212:      
 6213:    }
