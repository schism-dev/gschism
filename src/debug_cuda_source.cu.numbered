 3628: 
 3629:    printf("Processing %d elements\n", ne);
 3630:    for (int i = 0; i < ne; i++)
 3631:    {
 3632: if (i%1000 == 0) printf("ELEMENT i = %d, ne = %d\n", i, ne);      
 3633:       Element &elem = localElemData[i];
 3634:       elem.idx = i;
 3635:       for (int j = 0; j < i34[i]; j++) {
 3636:          const int idxNode = elnode[i*4 + j];  
 3637:          const int idxSide = elside[i*4 + j];
 3638:          
 3639:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3640:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3641: 
 3642: 
 3643: 
 3644:          // Find the neighboring element  
 3645:          if (elem.sides[j]->elems[0] == &elem) {
 3646:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3647:          }
 3648:          else {
 3649:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3650:          }
 3651:          
 3652:       }
 3653: 
 3654:       elem.i34 = i34[i];
 3655: 
 3656:       // Compute the centroid of the element and its depth
 3657:       Vector2 center = {0.0, 0.0};
 3658:       elem.depth = 0.0;
 3659:       for (int j = 0; j < i34[i]; j++) {
 3660:          center += elem.nodes[j]->p2()/i34[i];
 3661:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3662:       }
 3663:       elem.center = center;
 3664: 
 3665: 
 3666:       
 3667:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3668:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3669: 
 3670:       elem.area = elem.computeSignedArea(); 
 3671:       elem.radius = sqrt(elem.area)/pi; 
 3672:       
 3673:       // Determines which way the normal vector to each side is oriented.
 3674:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3675:       for (int j = 0; j < i34[i]; j++)  
 3676:       {
 3677:          if (elem.sides[j]->elems[0] == &elem) {
 3678:             elem.ssign[j] =  1.0;
 3679:          }
 3680:          else {
 3681:             elem.ssign[j] = -1.0;
 3682:          }
 3683: 
 3684:       }
 3685: 
 3686:       // Derivatives of shape functions
 3687:       //  For ics=2, this is done inside element/ll frame XXX
 3688:       //  For quads, the derivative is evaluated at centroid
 3689:       const int i34 = elem.i34;
 3690:       for (int j = 0; j < i34; j++) {
 3691:          const double area = elem.area;
 3692:          const int id2 = elem.nxq(1 + j);
 3693:          const int id3 = elem.nxq(2 + j);
 3694:          const int id4 = elem.nxq(3 + j);
 3695:          if (elem.isTri()) {
 3696:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3697:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3698:             // da1/dx = (y1 - y2)/(2*area)
 3699:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3700:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3701:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3702:          }
 3703:          else  { // Quad; evaluate at centroid
 3704:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3705:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3706:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3707:          } // if Tri
 3708: 
 3709:       } // for j
 3710: 
 3711:    }
 3712: 
 3713: #endif
 3714: 
 3715:    // Processing the boundary nodes
 3716:    int idx = 0;
 3717:    for (int iseg = 0; iseg < nope; iseg++) {
 3718:       // for each segment...
 3719:       idx++;
 3720: 
 3721:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3722:          // for each node on the segment...
 3723: 
 3724:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3725: 
 3726:          nodeBnd->isEssentialBC = true;
 3727:          nodeBnd->elbc = 0.0;
 3728: 
 3729:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3730: 
 3731:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3732:             nodeBnd->efa[jfr] = efa[idx];
 3733:             nodeBnd->emo[jfr] = emo[idx];
 3734:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3735:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3736: 
 3737:          }
 3738: 
 3739:          
 3740:       }
 3741: 
 3742:    }
 3743: 
 3744: }
