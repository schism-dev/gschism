 1887: struct Mesh {
 1888:    public:  
 1889: 
 1890:    int partNum; // Partition number for this mesh.
 1891: 
 1892:    // Pointers to each GPU's local memory (size is the number of partitions).
 1893:    Node**    nodes;  
 1894:    Element** elems;  
 1895:    Side**    sides;  
 1896:    
 1897:    // Local memory
 1898:    Node*    localNodeData; 
 1899:    Element* localElemData;
 1900:    Side*    localSideData; 
 1901: 
 1902:    NodeBoundary *localNodeBoundaryMem; // Array of objects with the boundary information of each node
 1903:    SideBoundary *localSideBoundaryMem; // Array of objects with the boundary information of each side
 1904:    double       *coeffMatrixMem;       // Matrix coefficients for neighbors. [0..numNodes-1], doesn't include the diagonal
 1905:    BoundarySegment *localSegmentMem;   // Array of objects with the boundary segments
 1906:    
 1907:    const int npgb;  // Global number of horizontal nodes
 1908:    const int negb;  // Global number of elements
 1909:    const int nsgb;  // Global number of sides
 1910: 
 1911:    const int np;   // Local number of horizontal nodes 
 1912:    const int ne;   // Local number of elements
 1913:    const int ns;   // Local number of sides
 1914: 
 1915:    int nbp;  // Local number of boundary nodes
 1916:    int nbs;  // Local number of boundary sides
 1917: 
 1918:    int nEntries;  // Total number of matrix elements
 1919: 
 1920:    const int max_np; // Maximum number of horizontal nodes per partition (shared by all partitions)
 1921:    const int max_ne; // Maximum number of elements per partition (shared by all partitions)
 1922:    const int max_ns; // Maximum number of sides per partition (shared by all partitions)
 1923: 
 1924:   
 1925:    // Additional topology information
 1926:    Node    **nodeNeighNodes;     // Array of pointers to the nodes neighbors of each node
 1927:    Element **nodeNeighElems;     // Array of pointers to the elements neighbors of each node
 1928:    int16_t *nodePermutationSort; // Array of indices for the array nodes such that neighbors nodes are sorted in increasing order of their global index.
 1929: 
 1930:    BoundarySegment *landBoundarySegment;
 1931:    NodeBoundary *landBoundaryNode;
 1932: 
 1933:    // Vertical coordinate system
 1934:    // Sigma levels
 1935:    double h_s; 
 1936:    double h_c; 
 1937: 
 1938:    double theta_b;
 1939:    double theta_f, sinh_theta_f;
 1940:    double *sigma;  // There is a sigma_local on each node for the case ivcor=1
 1941:    double *ztot;
 1942:    double *cs;
 1943:    double *dcs;
 1944: 
 1945: 
 1946: 
 1947:    __device__ Mesh(int partNum,
 1948:                    int npgb, int negb, int nsgb, 
 1949:                    int np, int ne, int ns,
 1950:                    int max_np, int max_ne, int max_ns, int nseg,
 1951:                    NodeBoundary *plandNodeBndMem, BoundarySegment *plandSegMem,
 1952:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1953:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1954:                    Node    **localNodeNeighNodesMem,
 1955:                    Element **localNodeNeighElemsMem,
 1956:                    int16_t *localNodePermutationSortMem,
 1957:                    double *partCoeffMatrixMem,
 1958:                    NodeBoundary *localNodeBoundaryMem,
 1959:                    SideBoundary *localSideBoundaryMem,
 1960:                    BoundarySegment *localSegmentMem,
 1961:                    int *kb, double h_c, double h_s, double theta_b, double theta_f, double *sigma, double *ztot,
 1962:                    double *cs, double *dcs
 1963:                    ) : partNum(partNum), npgb(npgb), negb(negb), nsgb(nsgb),
 1964:                        np(np), ne(ne), ns(ns),
 1965:                        max_np(max_np), max_ne(max_ne), max_ns(max_ns),
 1966:                        nodes(nodesPtr), elems(elemsPtr), sides(sidesPtr),
 1967:                        localNodeData(nodesMem), localElemData(elemsMem), localSideData(sidesMem),
 1968:                        nodeNeighNodes(localNodeNeighNodesMem), nodeNeighElems(localNodeNeighElemsMem),
 1969:                        nodePermutationSort(localNodePermutationSortMem), coeffMatrixMem(partCoeffMatrixMem),
 1970:                        localNodeBoundaryMem(localNodeBoundaryMem), localSideBoundaryMem(localSideBoundaryMem),
 1971:                        localSegmentMem(localSegmentMem),
 1972:                        h_c(h_c), h_s(h_s), theta_b(theta_b), theta_f(theta_f), sigma(sigma), ztot(ztot),
 1973:                        cs(cs), dcs(dcs),
 1974:                        landBoundarySegment(plandSegMem),
 1975:                        landBoundaryNode(plandNodeBndMem)
 1976:    {
 1977:       printf("Mesh constructor for partition %d\n", partNum);
 1978: 
 1979:       printf("npgb = %d, negb = %d, nsgb = %d, nseg = %d\n", npgb, negb, nsgb, nseg);
 1980:       printf("np = %d, ne = %d, ns = %d\n", np, ne, ns);
 1981:       printf("max_np = %d, max_ne = %d, max_ns = %d\n", max_np, max_ne, max_ns);
 1982:  
 1983:       printf("elemsPtr = %p, elems = %p\n", *elems, elemsMem);
 1984:       
 1985:       sinh_theta_f = sinh(theta_f);
 1986: 
 1987:       *landBoundaryNode    = NodeBoundary(true);
 1988:       *landBoundarySegment = BoundarySegment(true);   
 1989: 
 1990:    }
