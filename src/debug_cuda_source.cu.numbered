 6478:    __global__ void zeroNodalVelocities(void) {
 6479:       NODE(node);
 6480: 
 6481:       for (int k = 0; k < nvrt; k++) {
 6482:          node->u2[k]   = {0.0, 0.0};
 6483:          node->w2[k]   = 0.0;
 6484:          node->utmp[k] = {0.0, 0.0};
 6485:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6486:       }
 6487:    }
 6488:  
 6489: 
 6490:    __global__ void computeNodalVerticalVelocities1(void) {
 6491:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6492:    // Adds the element's vertical velocity times the element's area.
 6493:       ELEM(elem);
 6494: 
 6495:       for (int j = 0; j < elem->i34; j++) {
 6496:          Node *node = elem->nodes[j];
 6497: 
 6498:          for (int k = node->kb; k < nvrt; k++) {
 6499:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6500:          }
 6501:          atomicAdd(&(node->tmp.d), elem->area);
 6502:       }
 6503:    }
 6504: 
 6505:    __global__ void computeNodalVerticalVelocities2(void) {
 6506:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6507:    // Divides by the total area of the elements sharing the    node.
 6508:       NODE(node);
 6509: 
 6510:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6511: 
 6512:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6513:    }
 6514: 
 6515: 
 6516:    __global__ void computeNodalHorizontalVelocities1(void) {
 6517: 
 6518:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6519:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6520: 
 6521:       ELEM(elem);
 6522: 
 6523:       if (elem->isDry) return;
 6524: 
 6525:       const int kb = elem->kb;
 6526:       const bool isTri = elem->isTri();
 6527: 
 6528:       if constexpr(indvel <= 0) {
 6529:          // Assuming discontinous hvel.
 6530: 
 6531:          if (isTri) { // For triangles
 6532:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6533:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6534: 
 6535:             for (int j = 0; j < 3; j++) {
 6536:                // For every node of the triangle...
 6537:                Node *node = elem->nodes[j];
 6538: 
 6539:                if (node->isDry) continue;
 6540: 
 6541:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6542:                const Side *s2 = elem->sides[(j + 1) % 3];
 6543:                const Side *s3 = elem->sides[(j + 2) % 3];
 6544: 
 6545:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 6546: 
 6547:                atomicAdd(&(node->tmp.i), 1);
 6548: 
 6549:                for (int k = kb; k < nvrt; k++)  {
 6550:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated linearly at node j.   
 6551:                   u = clampVelocity(u);
 6552:                   atomicAdd(&(node->utmp[k].x), u.x);
 6553:                   atomicAdd(&(node->utmp[k].y), u.y);
 6554: 
 6555:                }
 6556: 
 6557:             }
 6558:          }
 6559:          else { // For quads
 6560:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6561: 
 6562:          }
 6563: 
 6564:       }
 6565:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6566:       
 6567:    }
 6568: 
 6569: 
 6570:    __global__ void computeNodalHorizontalVelocities2(void) {
 6571:       NODE(node);
 6572: 
 6573:       const int nodeCount = node->tmp.i;
 6574: 
 6575:       if (nodeCount == 0) 
 6576:       {
 6577:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6578:          return;
 6579:       }
 6580: 
 6581:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6582:       
 6583:       const int kb = node->kb;
 6584: 
 6585:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6586:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6587:       
 6588:       
 6589:    }   
 6590: 
 6591:  
