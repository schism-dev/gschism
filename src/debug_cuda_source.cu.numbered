 2070: 
 2071: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2) const {
 2072: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2073: 
 2074:    assert(!isQuad() && "getLocalHorizontalNodePositions only works for triangles");
 2075: 
 2076:    if constexpr(ics==1) {
 2077:       x0 = nodes[0]->p;
 2078:       x1 = nodes[1]->p;
 2079:       x2 = nodes[2]->p;
 2080: 
 2081:    } else {
 2082:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2083: 
 2084:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2085:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2086:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2087: 
 2088:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2089:       x1 = toVector2(frame.G2L(p1 - c));
 2090:       x2 = toVector2(frame.G2L(p2 - c));
 2091:    }
 2092: 
 2093: }
 2094: 
 2095: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2096: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2097: 
 2098:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2099: 
 2100:    if constexpr(ics==1) {
 2101:       x0 = nodes[0]->p;
 2102:       x1 = nodes[1]->p;
 2103:       x2 = nodes[2]->p;  
 2104:       x3 = nodes[3]->p;
 2105: 
 2106:    } else {
 2107:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2108: 
 2109:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2110:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2111:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2112:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2113: 
 2114:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2115:       x1 = toVector2(frame.G2L(p1 - c));
 2116:       x2 = toVector2(frame.G2L(p2 - c));
 2117:       x3 = toVector2(frame.G2L(p3 - c));
 2118:    }
 2119: 
 2120: }
 2121: 
 2122: 
 2123: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2124: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2125: // Returns the normal vector and the area of the element at this level
 2126: 
 2127:    if (isTri()) {
 2128:       // For triangles...
 2129: 
 2130:       // Indices of the nodes at level k, taking care of not going below the bed
 2131:       const int k0 = max(k, nodes[0]->kb);
 2132:       const int k1 = max(k, nodes[1]->kb);
 2133:       const int k2 = max(k, nodes[2]->kb);
 2134: 
 2135:       // Gets the element frame coordinates of the nodes at level k
 2136:       Point3 x0, x1, x2;
 2137:       if constexpr(ics==1) {
 2138:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2139:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2140:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2141: 
 2142:       } else {  // ics == 2
 2143:          Vector2 h0, h1, h2;
 2144: 
 2145:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2146: 
 2147:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2148:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2149:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2150:       }
 2151: 
 2152:       const Vector3 n20 = x2 - x0;
 2153:       const Vector3 n10 = x1 - x0; 
 2154: 
 2155:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2156:       const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2157:       const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2158:       const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2159: 
 2160:       const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2161:       area3D = 0.5*len;
 2162: 
 2163:       const double inv_len = 1.0/len;
 2164:       return {nx*inv_len, ny*inv_len, nz*inv_len};
 2165:    
 2166:    }
 2167:    else {
 2168:       // For quads...
 2169: 
 2170:       assert(false && "Element normal vector: quads not yet implemented");
 2171:       return {0.0, 0.0, 0.0};
 2172: 
 2173: 
 2174:    }
 2175: }
 2176: 
 2177: /**
 2178:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2179:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2180:    If the segment is completely inside the element, then it returns true.
 2181: 
 2182:    This function assumes:
 2183:    - The initial point is on a side of the element. 
 2184:    - Its position is given by parameter t in the range [0,1].
 2185:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2186:       intersects the element (elements are convex).
 2187: 
 2188:    To find the intersection point, this function does the following:
 2189:    - it finds the intersection of the line segment with all the element side lines,
 2190:       except for the one that contains the initial point.
 2191:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2192:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2193:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2194:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2195:       track segment is almost parallel to the element side line.
 2196: 
 2197:    Inputs:
 2198:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2199:    @param x2, y2: other end of the line segment
 2200: 
 2201:    Outputs:
 2202:    @param side:  side that intersects the line segment (input and output)
 2203:    @param nextElement (output): element that contains the intersection point
 2204:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2205:    @param zint (input/output): Vertical coordinate of the intersection point
 2206: 
 2207:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2208:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2209:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2210: 
 2211:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2212:    (Delta) being zero.
 2213: 
 2214:    The intersection2 point happens when:
 2215:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2216:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2217:    
 2218:    Assumption: the 4 points (including those of the side segment) are different.
 2219:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2220:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2221:    If true, (xIntersect,yIntersect) is the intersection.				
 2222:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2223: **/
 2224: 
 2225: 
 2226: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 2227:                                               double &t, double& tIntersect) {
 2228:    assert( containsPoint(x1) && "Starting point is not inside the element");                                    
 2229:    assert(!containsPoint(x2) && "Ending point is not outside the element");
 2230: 
 2231:    double closest_intersect_t = 1e10;
 2232:    bool found_intersection = false;
 2233: 
 2234:    for (int i = 0; i < i34; i++) {
 2235: 
 2236:       Side *side2 = sides[i];
 2237: 
 2238:       // (x3,y3)-(x4,y4) is the element side line
 2239:       const Point2 x3 = side2->n1->p;
 2240:       const Point2 x4 = side2->n2->p;
 2241: 
 2242:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 2243:       const double delta = cross(x2 - x1, x3 - x4);
 2244: 
 2245:       if (abs(delta) > 0) {
 2246: 
 2247:          const double delta1 = cross(x3 - x1, x3 - x4);
 2248:          const double delta2 = cross(x2 - x1, x3 - x1); 
 2249: 
 2250:          // Solves the two linear equations for tt1 and tt2
 2251:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2252:          const double tt2 = delta2/delta;
 2253: 
 2254:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 2255:             closest_intersect_t = min(closest_intersect_t, tt1);
 2256:             side = side2;
 2257:             nextElement = side->otherElem(this);
 2258:             t =          clamp(tt2, small, 1.0-small);
 2259:             tIntersect = clamp(tt1, small, 1.0-small);
 2260:             found_intersection = true;
 2261:          }
 2262: 
 2263:       
 2264:       }
 2265:       else {  // parallel segments
 2266: 
 2267:          continue; 
 2268:          assert(false && "Parallel segments should not happen under the new code");
 2269:          // In this case, we check if they are colinear. if they are, we compute the intersection point as:
 2270:          // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 2271: 
 2272:          // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 2273:          const double dist = dot(x1 - x3, side2->n);
 2274:          if (abs(dist) < small*length(x3 - x4)) {
 2275:             const double2 unitarySide = normalize(x4 - x3);
 2276:             const double len = dot(x2 - x1, unitarySide);
 2277:             t = t + len;
 2278:             t = max(0.0, min(t, 1.0));
 2279:             printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 2280: 
 2281: 
 2282:             // tIntersect = max(small, min(tt1, 1.0-small));
 2283:             // t = tt2;
 2284:             found_intersection = true;
 2285:          }
 2286:       }
 2287: 
 2288: 
 2289:    }
 2290: 
 2291: 
 2292:    assert(found_intersection && "No intersection found");
 2293: 
 2294:    // found_intersection should always be true, since we checked all the sides.  
 2295:    return found_intersection;
 2296: }
 2297: 
 2298: 
 2299: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 2300:                                              Point3 &xt, double zint, Vector3 &u_int) {
 2301: 
 2302:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 2303:    // Instead, we nudge the intersection point to the barycenter of the current element, and nextElement becomes
 2304:    // curElement.
 2305: 
 2306:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 2307:    // And uses this velocity instead to continue the tracking.
 2308: 
 2309:    // computes the intersection point in cartesian coordinates
 2310:    Point2 intersection = nextSide->p_t(tt);  // XXXX I don't think this is necessary. THE intersection is already computed in findNextIntersection.
 2311: 
 2312:    // Nudges the point to the barycenter of the element. 
 2313:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 2314:    // next segment intersects the element sides. 
 2315:    // TODO: curElem->nudgeToBarycenter(intersection);  REMEMBER!!! RECOVER??? XXX KKKKK
 2316: 
 2317: 
 2318:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 2319:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 2320:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 2321:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 2322: 
 2323:    // If the side is an open boundary, the tangential velocity is set to zero.
 2324:    if (nextSide->isBnd()) vtan = 0.0;
 2325: 
 2326:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 2327:    const double us = vtan*nextSide->t().x;
 2328:    const double vs = vtan*nextSide->t().y;
 2329:    const double ws = nextSide->w2(jlev); 
 2330: 
 2331:    u_int = {us, vs, ws};
 2332: 
 2333:    // The end of this tracking segment is now the intersection point.
 2334:    xt = {intersection.x, intersection.y, zint};
 2335:    
 2336: }
 2337: 
 2338: /**
 2339:  * Tracks a particle through elements and vertical levels in the mesh.
 2340:  * 
 2341:  * @param x0,y0,z0     Starting position coordinates
 2342:  * @param xt,yt,zt     Target position coordinates
 2343:  * @param dtb          Time step for tracking
 2344:  * @param u_int        Initial velocity components
 2345:  * @param nextElem     Starting/resulting element index
 2346:  * 
 2347:  * @return Status code of type trackExitCodes
 2348:  * 
 2349:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2350:  * of the details are different. The idea is that the code requires less branches and is better fit
 2351:  * for GPU execution.
 2352:  * 
 2353:  * The main ideas here are:
 2354:  * - The starting point is expected to be in the starting element.
 2355:  * - since the starting point is inside the element, there are only two cases: 
 2356:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2357:  *     (b) it does not and (xt,yt) is already in the starting element.
 2358:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2359:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2360:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2361:  * - tt1 can be positive or negative. We only consider the positive values.
 2362:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2363:  * - The next intersection will occur at the smallest positive tt1.
 2364:  * - This intersection will be the next (x0,y0) position.
 2365:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2366:  *   of getting stuck in a loop.
 2367:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2368:  *   was found.
 2369:  * - Notice that curElement is the current element, while this is the element for which the first call to this function was made.
 2370:  */
 2371: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2372:                                                        Element *&nextElem, int &jlev, double &dt, double time_rm,
 2373:                                                        const Side *origSide) {
 2374:                                                             
 2375:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2376:    // else to do. This means that the full step occurred within the current element.
 2377:    assert(!isDry && "Starting element is dry");
 2378:    assert(containsPoint(toPoint2(x0)) && "Starting point is not inside the element");
 2379: 
 2380:    if (containsPoint(toPoint2(xt), true)) {  // The "true" means that, if the point is very close to the boundary, it is nudged to be definitely inside the element.
 2381: 
 2382:       assert(containsPoint(toPoint2(xt)) && "Target point is not inside the element");
 2383:       assert(!isDry && "Target point is inside a dry element");
 2384: 
 2385:       u_int = interpolateVelocities(xt);
 2386: 
 2387:       nextElem = this;
 2388: 
 2389: // if (jlev==10) addDebugPlot(x0, xt, 0x00FF00); // green
 2390:       return true;
 2391:    }
 2392: 
 2393: 
 2394:    
 2395: 
 2396:    assert(norm2(toVector2(xt - x0)) > 0.0 && "Zero length track"); 
 2397:    
 2398:    double t;
 2399:    Side *nextSide = nullptr;
 2400:    double tIntersect = 1e10;
 2401: 
 2402: 
 2403:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2404:    // (x0,y0) is inside the element but the target point is not.
 2405:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2406:    assert(found_intersection && "No intersection found at %d");
 2407: 
 2408:    Point2 xtmp = nextSide->p_t(t); // moves the target point to the intersection point
 2409: 
 2410:    // If the next element is not dry, nudge it to the barycenter to ensure that the point is inside the element.
 2411:    if (nextElem != nullptr && !nextElem->isDry) {
 2412:       assert(nextElem->containsPoint(xtmp) && "Intersection point is not inside the next element");
 2413:       nextElem->nudgeToBarycenter(xtmp);
 2414:    }
 2415: 
 2416:    const double zint = (1 - tIntersect)*x0.z + tIntersect*xt.z;
 2417:    xt = {xtmp.x, xtmp.y, zint};
 2418: 
 2419:    // if the tracking segment goes out of water (either dry or edge boundary)
 2420:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2421: 
 2422: 
 2423:       trackGoesOutOfWater(nextSide, this, t, jlev, xt, zint, u_int);
 2424: 
 2425:       assert(this->containsPoint(toPoint2(xt)) && "Target point is not inside the current element");
 2426:       // When this happens, the backtracking stops.
 2427:       // dt = time_rm;  LLLLLL KKKK XXXX
 2428:       dt *= tIntersect;
 2429: 
 2430:       // In this case, the next element is again the current element.
 2431:       nextElem = this;
 2432: 
 2433: // printf("trackGoesOutOfWater: side->idx = %d, dt = %.17f, time_rm = %.17f, u_int = (%.17f, %.17f, %.17f)\n", nextSide->idx, dt, time_rm, u_int.x, u_int.y, u_int.z);
 2434: 
 2435:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2436:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2437:       return true;    
 2438:    }
 2439: 
 2440: 
 2441:    assert(nextElem->containsPoint(toPoint2(xt)) && "Target point is not inside the next element");
 2442:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2443:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2444: 
 2445:    
 2446:    dt *= tIntersect; // reduces the time step to the time it takes to reach the intersection
 2447: 
 2448:    u_int = nextElem->interpolateVelocities(xt); 
 2449: 
 2450:    assert(nextElem != this && "Next element is the same as the current element");
 2451: 
 2452:    return true;
 2453: }
 2454: 
 2455: 
 2456: __inline__ __device__ double Element::computeSignedArea(void) const {
 2457:    // Compute the area of the element
 2458: 
 2459:    double res = signedArea(nodes[0]->p, nodes[1]->p, nodes[2]->p);
 2460: 
 2461:    // In the quad case we need to add the area of the other triangle.
 2462:    if (isQuad()) {
 2463:       double ar1 = signedArea(nodes[0]->p, nodes[2]->p, nodes[3]->p);
 2464:       double ar2 = signedArea(nodes[0]->p, nodes[1]->p, nodes[3]->p);
 2465:       double ar3 = signedArea(nodes[1]->p, nodes[2]->p, nodes[3]->p);
 2466:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2467: 
 2468:       res += ar1;
 2469:    }
 2470: 
 2471:    return res;
 2472: }
 2473: 
 2474: 
 2475: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2476:                                                                 (nodes[1]->isDry2()) ||
 2477:                                                                 (nodes[2]->isDry2()) ||
 2478:                                                                 (i34==4 && nodes[3]->isDry2());
 2479: }
 2480: 
 2481: __inline__ __device__ double Element::detJ_eta(void) const {
 2482:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2483:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2484: }
 2485: 
 2486: __inline__ __device__ double Element::detJ_xi(void) const {
 2487:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2488:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2489: }
 2490: 
 2491: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2492:    // In boundary sides, the element 1 is nullptr
 2493:    return side->elems[1] == nullptr; 
 2494: }
 2495: 
 2496: 
 2497: 
 2498: /**
 2499:    Compute the shape coordinates of the point (xt,yt) in the element.
 2500:    @param xt (input): x-coordinate of the point
 2501:    @param shpCoords (output): shape coordinates of the point
 2502:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2503:    @return true if the point is inside the element, false otherwise
 2504: **/
 2505: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord) const {
 2506: 
 2507:    // Compute the shape coordinates of the point xt in the element.
 2508:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2509:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2510:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2511:    // from the local frame, so use additional check.
 2512: 
 2513:    if (i34==3) { // Triangular element
 2514: 
 2515:       Point2 x0, x1, x2;
 2516: 
 2517:       // Horizontal local node coordinates. If ics == 2, the node coordinates are transformed to local frame.
 2518:       getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2519: 
 2520:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2521:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2522:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2523:       shpCoords[3] = 0.0;
 2524: 
 2525:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2526:       const bool res = (tmpmin >= -small);  
 2527:       
 2528:       // If the point is not inside the element (with a small tolerance), we do not need to fix the negative shape coordinates.
 2529:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2530: 
 2531:       
 2532:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2533:       // then we fix the negative shape coordinates.
 2534:       if ((tmpmin < 0) && fix) {
 2535: 
 2536:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2537:          // keeping the sum of the shape coordinates equal to 1.
 2538:          // I have tested and compared the new algorithm with the old one, and they give
 2539:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2540:          // The new algorithm should be faster since it is branchless.
 2541:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2542:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2543:          
 2544:          shpCoords[0] = (shpCoords[0] + a)*b;
 2545:          shpCoords[1] = (shpCoords[1] + a)*b;
 2546:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2547: 
 2548:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2549:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2550:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2551: 
 2552:          // Update the point coordinates for the new shape coordinates
 2553:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2554:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2555:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2556: 
 2557:       }
 2558: 
 2559:       // Check if the point is inside the element
 2560:       return res;      
 2561:    }
 2562:    else {
 2563:       Error("Not implemented yet");
 2564: #ifdef QUADS
 2565:       // Reproject pt in eframe of nel for ics=2
 2566:       if constexpr(ics==1) {
 2567:          xn2 = xt; 
 2568:          yn2 = yt;
 2569:       }
 2570:       else {
 2571:          // Transform the point coordinates to the local frame
 2572:          frame.G2L(xt, xn2);
 2573:          frame.G2L(yt, yn2);
 2574:       }
 2575: 
 2576:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2577: #endif
 2578:    }
 2579: 
 2580:    assert(false && "computeShapeCoords: should never reach this point");
 2581:    return false;  // Never reached
 2582: 
 2583: }
 2584: 
 2585: 
 2586: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2587: // Convert shape coordinates to cartesian coordinates
 2588: 
 2589:    if (i34 == 3) {
 2590:       // Triangular element
 2591:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2592:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2593:    }
 2594:    else {
 2595:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2596:    }
 2597: 
 2598: }
 2599: 
 2600: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2601:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2602:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2603:    // The formula for the integral is:
 2604:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2605: 
 2606:    printf("intPhiPhi: TEST\n");
 2607: 
 2608:    const Node *n0 = nodes[0];
 2609:    const Node *n1 = nodes[1];
 2610:    const Node *n2 = nodes[2];
 2611:    const Node *n3 = nodes[3];
 2612: 
 2613:    const Vector2 p0 = n0->p;
 2614:    const Vector2 p1 = n1->p;
 2615:    const Vector2 p2 = n2->p;
 2616:    const Vector2 p3 = n3->p;
 2617: 
 2618:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2619:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2620:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2621:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2622: 
 2623:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2624: }
 2625:    
 2626: 
 2627: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2628:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2629:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2630:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2631:    // The formula is also based on the identity:
 2632:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2633:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2634: 
 2635:    printf("intGradPhiGradPhi: TEST\n");   
 2636: 
 2637:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2638: 
 2639:    const double x0 = nodes[0]->p.x;
 2640:    const double y0 = nodes[0]->p.y;
 2641:    const double x1 = nodes[1]->p.x;
 2642:    const double y1 = nodes[1]->p.y;
 2643:    const double x2 = nodes[2]->p.x;
 2644:    const double y2 = nodes[2]->p.y;
 2645:    const double x3 = nodes[3]->p.x;
 2646:    const double y3 = nodes[3]->p.y;
 2647: 
 2648:    double res = 0.0;
 2649:    
 2650:    // Quadrature points in xi and eta coordinates
 2651:    #pragma unroll
 2652:    for (int i = 0; i < 4; i++) {
 2653:       // For each quadrature point...
 2654: 
 2655:       const Point2 p = GaussPoint(i);
 2656:       const double eta = p.x;
 2657:       const double xi  = p.y;
 2658: 
 2659:       // Jacobian entries at the Gauss point p
 2660:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2661:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2662:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2663:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2664: 
 2665:       const double detJ = jacobianDet(p);
 2666:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2667: 
 2668:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2669:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2670:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2671:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2672:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2673: 
 2674:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2675:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2676:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2677:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2678:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2679: 
 2680:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2681:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2682:    }
 2683: 
 2684:    return res;
 2685: }
 2686: 
 2687: 
 2688: /**  Interpolate velocities at a given point (xt,yt,zt)
 2689: 
 2690:    @param xt, yt, zt: coordinates of the point to interpolate
 2691:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2692: 
 2693:    This is done in four steps:
 2694: 
 2695:    1. Find the shape coordinates for the final position in the element.
 2696:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2697:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2698:       z levels at xt, yt at each step.   
 2699:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2700:       horizontally and vertically.
 2701: **/
 2702: __device__ Vector3 Element::interpolateVelocities(Point3 xt) const {
 2703:    // Interpolate the velocities at the point xt. 
 2704:    // This function works the same for triangular and quadrilateral elements.
 2705:    double shpCoord[4];
 2706:    Vector3 u_int;
 2707: 
 2708:    // First step is to compute the shape coordinates of (xt,yt)
 2709:    computeShapeCoords(toVector2(xt), shpCoord, fiOnlyInside);
 2710: 
 2711:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2712: 
 2713:    // Second step is to find the level that contains zt
 2714:    // Uses a binary search to find the level
 2715:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2716:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2717:    int R = nvrt - 1;
 2718: 
 2719:    // Get the z coordinates at the nodes of the element at the levels L and R
 2720:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 2721:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2722:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2723: 
 2724:    double zL = interpolate(shpCoord, zLAtNodes);
 2725:    double zR = interpolate(shpCoord, zRAtNodes);
 2726:    
 2727:    // Interpolates vertically the velocities
 2728:    double wght1, wght2;
 2729:    if (xt.z<=zL) {
 2730:       wght1 = 1.0;
 2731:       wght2 = 0.0;
 2732:       xt.z = zL;
 2733:    }
 2734:    else if (xt.z>=zR) {
 2735:       wght1 = 0.0;
 2736:       wght2 = 1.0;
 2737:       xt.z = zR;
 2738:    }
 2739:    else {
 2740:       // Perform a binary search to find the levels between L and R that contain xt.z
 2741:       while (R - L > 1) {
 2742:          int M = (L + R) / 2.0;
 2743: 
 2744:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2745:          double zM = interpolate(shpCoord, zMAtNodes);
 2746:          if (zM < xt.z) 
 2747:          {
 2748:             L = M;
 2749:             zL = zM;
 2750:          }
 2751:          else 
 2752:          {
 2753:             R = M;
 2754:             zR = zM;
 2755:          }
 2756:       }
 2757:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 2758:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2759: 
 2760:       wght2 = (xt.z - zL)/(zR - zL);
 2761:       wght1 = 1.0 - wght2;
 2762: 
 2763:    }
 2764: 
 2765: 
 2766:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2767:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 2768:    toVector2(u_int) = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2769:    u_int.z          = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 2770: 
 2771:    // Neither of the interpolated velocities should be NaN
 2772:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2773: 
 2774:    return u_int;
 2775: 
 2776: }
 2777: 
 2778: 
 2779: 
 2780: 
 2781: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2782: 
 2783:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2784:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2785:    const Node *n1 = side->n1;
 2786:    const Node *n2 = side->n2;
 2787: 
 2788:    bool n1_match = (n1->nodeBnd->segment == segment);
 2789:    bool n2_match = (n2->nodeBnd->segment == segment);
 2790: 
 2791:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2792:    if (n1_match && n2_match) {
 2793:       return 0.5;
 2794:    } else if (n1_match) {
 2795:       return 1.0;
 2796:    } else if (n2_match) {
 2797:       return 0.0;
 2798:    }
 2799: 
 2800:    return 0.0;
 2801: }
 2802: 
 2803: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2804: 
 2805: 
 2806: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 2807: 
 2808:    const double w1 = getBoundaryArrayValueWeight();
 2809:    const double w2 = 1.0 - w1;
 2810:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2811:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2812: 
 2813:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 2814: }
 2815: 
 2816: 
 2817: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 2818:    const double w1 = getBoundaryArrayValueWeight();
 2819:    const double w2 = 1.0 - w1;
 2820:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2821:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2822: 
 2823:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 2824: 
 2825: }
 2826: 
 2827: 
 2828: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 2829:    // Returns the value of the velocity at the side center
 2830:    const double w1 = getBoundaryArrayValueWeight();
 2831:    const double w2 = 1.0 - w1;
 2832:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 2833:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 2834: 
 2835:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 2836: }
