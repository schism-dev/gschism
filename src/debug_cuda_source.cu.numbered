 2230: __device__ inline void atomicAddInt16Unsafe(int16_t* address, int16_t val)
 2231: {
 2232:     uintptr_t p = (uintptr_t)address;
 2233:     assert((p & 1) == 0);
 2234: 
 2235:     unsigned int* base = (unsigned int*)(p & ~3);
 2236:     unsigned int addend = (p & 2) ? ((unsigned int)val << 16)
 2237:                                   :  (unsigned int)val;
 2238: 
 2239:     atomicAdd(base, addend);
 2240: }
