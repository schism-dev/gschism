 3394: 
 3395: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3396:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3397:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3398:    // 
 3399:    // This kernel is called for all nodes.
 3400: 
 3401: 
 3402:    NODE(node1);
 3403: 
 3404: 
 3405:    node1->clearMatrixRow();
 3406:    node1->qel = 0.0;
 3407: 
 3408:    // THIS IS FOR STRUCTURES XXX
 3409:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3410: 
 3411:    
 3412:    for (int j=0; j<node1->numElements; j++) {
 3413:       // For each element connected to the node...
 3414: 
 3415:       Element *elem = node1->elements[j];
 3416: 
 3417:       // Compute the average gravity
 3418:       const double grav3 = elem->mean(&Node::grav2);
 3419: 
 3420:       // Look at the documentation for the description of the terms in the following integrals
 3421: 
 3422:       // Integral I_1 
 3423:       // \bar{\breve{H}} 
 3424:       const double hhatb = elem->mean(&Side::hhat);        
 3425: 
 3426:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3427: 
 3428:       const int id1 = elem->nodeLocalIdx(node1); 
 3429:       const double area = elem->area;
 3430: 
 3431:       if (elem->isTri()) {
 3432: 
 3433:          // To clarify the notation in this section: 
 3434:          //   i stands for the node under consideration (node1)
 3435:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3436:          const int id2 = elem->nxq(1 + id1);
 3437:          const int id3 = elem->nxq(2 + id1);
 3438:          Node *node2 = elem->nodes[id2];
 3439:          Node *node3 = elem->nodes[id3];
 3440: 
 3441:          const Point2 x1 = node1->p;
 3442:          const Point2 x2 = node2->p;
 3443:          const Point2 x3 = node3->p;
 3444: 
 3445:          // integral of phi_i*phi_j
 3446:          const double ipp_ii = (1.0/6.0 )*area;
 3447:          const double ipp_ij = (1.0/12.0)*area;
 3448:          const double ipp_ik = (1.0/12.0)*area;
 3449: 
 3450:          // integral of [(grad phi_i) * (grad phi_j)]
 3451:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3452:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3453:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3454: 
 3455:          // Computes the different components of integral I_1 of each node with respect to node i.
 3456:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3457:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3458:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3459: 
 3460:          node1->addToSparseMatrix(node1, I1_ii);
 3461:          node1->addToSparseMatrix(node2, I1_ij); 
 3462:          node1->addToSparseMatrix(node3, I1_ik);
 3463: 
 3464:       }
 3465:       else { // Quad
 3466:          // XXX IMPLEMENT THIS
 3467:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3468: 
 3469:          // To clarify the notation in this section: 
 3470:          //   i stands for the node under consideration (node1)
 3471:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3472:          const int id2 = elem->nxq(1 + id1);
 3473:          const int id3 = elem->nxq(2 + id1);
 3474:          const int id4 = elem->nxq(3 + id1);
 3475:          Node *node2 = elem->nodes[id2];
 3476:          Node *node3 = elem->nodes[id3];
 3477:          Node *node4 = elem->nodes[id4];         
 3478: 
 3479:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3480:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3481:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3482:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3483:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3484: 
 3485:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3486:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3487:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3488:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3489:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3490: 
 3491:          // Computes the different components of integral I_1 of each node with respect to node i.
 3492:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3493:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3494:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3495:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3496: 
 3497:          node1->addToSparseMatrix(node1, I1_ii);
 3498:          node1->addToSparseMatrix(node2, I1_ij); 
 3499:          node1->addToSparseMatrix(node3, I1_ik);
 3500:          node1->addToSparseMatrix(node4, I1_il);
 3501:   
 3502: 
 3503: 
 3504:       
 3505:       } 
 3506: 
 3507:  
 3508:       // Integral I_4
 3509:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3510:       // Where
 3511:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3512: 
 3513:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3514:       // of U over the element.
 3515:       Vector2 Umean = {0.0, 0.0};
 3516:       for (int m=0; m<elem->i34; m++) {      
 3517:          const Side *side = elem->sides[m];
 3518: 
 3519:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3520:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3521:       }
 3522:       Umean = Umean/elem->i34;
 3523: 
 3524:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3525: 
 3526:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3527:       const double I_4_1 = dot(gradPhi_1, Umean);
 3528: 
 3529:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3530:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3531:      
 3532:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3533: 
 3534:       // Additional terms 
 3535:       double vnorm = 0.0;
 3536:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3537:          Vector3 ubed;
 3538:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3539: 
 3540:          Vector3 gradP = {0.0, 0.0, 1.0};
 3541:          for (int m=0; m < elem->i34; m++) {
 3542:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3543:            gradP += toVector3(gradP_2D, 0.0);
 3544:          }   
 3545:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3546:       } // imm==2
 3547: 
 3548:       if (elem->isTri()) {
 3549:          for (int l=0; l<3; l++) {
 3550:             double fac;
 3551: 
 3552:             Node *node = elem->nodes[l];
 3553: 
 3554:             fac = (node == node1) ? 2.0 : 1.0;
 3555:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3556:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3557:            
 3558:          }
 3559: 
 3560: 
 3561:          if (!elem->isDry) {
 3562:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3563: 
 3564:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3565: 
 3566:          }
 3567: 
 3568:       } // isTri
 3569:       else { // isQuad
 3570:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3571:          // for (int l=0; l<4; l++) {
 3572:          //   const Node *node = elem->nodes[l];
 3573: 
 3574:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3575:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3576: 
 3577:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3578:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3579:          // }
 3580: 
 3581:       } // isQuad
 3582: 
 3583: 
 3584:      node1->qel += (dt/elem->i34)*elem->vsource;
 3585:       
 3586: 
 3587:    } // for all elements connected to the node
 3588:    
 3589: 
 3590:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3591:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3592:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3593:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3594:       // If it is an open boundary node...
 3595: 
 3596:       // At least one open bnd side, maybe two
 3597:       for (int l=0; l<2; l++) { 
 3598: 
 3599:          // Gets each of the sides sharing the node. 
 3600:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3601: 
 3602:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3603:          
 3604: 
 3605:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3606:          if (sideBnd != nullptr) {
 3607:             // If the side is on a boundary...
 3608: 
 3609:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3610: 
 3611:             // Get the boundary segment
 3612:             const BoundarySegment *sideSegment = sideBnd->segment;
 3613:             const Side *side = sideBnd->side;
 3614: 
 3615:             // Integral I_3
 3616:             if (sideSegment->ifltype != 0) {
 3617:             // Natural or Flather b.c.
 3618: 
 3619:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3620:                // especially for Flather b.c.
 3621:                double ri3 = 0.0;
 3622:                if (!side->isDry) {
 3623:                   // If the side is not dry
 3624:                   
 3625:                   // Computes the side flux of (uth, vth)
 3626:                   double Vn = 0.0;
 3627:                   for (int k = side->kb; k<nvrt-1; k++) {
 3628:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3629:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3630: 
 3631:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3632:                   }
 3633: 
 3634:                   ri3 = 0.5*side->len*Vn;
 3635:                }
 3636: 
 3637:                if (sideSegment->ifltype == -1) { // Flather 1
 3638: 
 3639:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3640:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3641: 
 3642:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3643:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3644:                   
 3645:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3646:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3647: 
 3648:                } 
 3649:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3650:                   // Reset ri3
 3651:                   ri3 = 0.0;
 3652: 
 3653:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3654: 
 3655:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3656: 
 3657:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3658:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3659: 
 3660:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3661:                   node1->addToSparseMatrix(node1, con0*2.0);
 3662:                   node1->addToSparseMatrix(node2, con0);
 3663: 
 3664:                } // if Flather or Discharge
 3665: 
 3666: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3667:                node1->qel -= thetai*dt*ri3;
 3668: 
 3669: 
 3670:             } // I_3
 3671:           
 3672: 
 3673:             // Integral I_5
 3674:             if(!side->isDry) {
 3675: 
 3676:                const double Unbar = dot(side->U, side->n);
 3677:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3678: 
 3679:             } // I_5
 3680: 
 3681:          } // if is boundary side
 3682: 
 3683:       } // for l
 3684: 
 3685:    } // if isbnd
 3686: 
 3687: 
 3688: }
 3689: 
 3690: 
 3691: 
 3692: extern "C" {
 3693:    __global__ void rollUpElevation(void) {
 3694: 
 3695:       NODE(node);
 3696: 
 3697:       node->eta1 = node->eta2;
 3698: 
 3699:    }
 3700: 
 3701: 
 3702:    __global__ void backtrackAllNodes(void) {
 3703: 
 3704:       // max/min # of sub-divisions
 3705:       const int ndelt_max = max(1.0, dt/dtb_min);
 3706:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3707: 
 3708:       // Removed all references to swild98 XXX
 3709:       // swild98=0.d0 !init
 3710: 
 3711: 
 3712:       SIDE(side);
 3713: 
 3714:       const int kb = side->kb;
 3715: 
 3716: 
 3717:       // Initialize btrack velocities to the actual velocities at the side 
 3718:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3719: 
 3720:       if (side->isDry) return;
 3721: 
 3722: 
 3723:       // Checks that at least one element is not dry
 3724:       const Element *elem1 = side->elems[0];
 3725:       const Element *elem2 = side->elems[1];
 3726: 
 3727: 
 3728:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3729:       
 3730:       // XXXXXX
 3731:       // !swild_tmp to store global coord. of the starting side
 3732:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3733:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3734:       // !Use sframe2 
 3735:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3736: 
 3737: 
 3738:       for (int k = kb; k < nvrt; k++) {
 3739:       //  Initialize (xt,yt,zt), nnel and vel.
 3740:       //  For ics=2, the coordinates are in local frames
 3741:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3742: 
 3743: 
 3744:          const int iadvf = side->iadv();  // Advection flag
 3745: 
 3746:          Point3 xt;
 3747:          if constexpr(ics==1) {
 3748:             xt = side->center3D(k); 
 3749:          }
 3750:          else // lat/lon; in side lat/lon frame
 3751:          {
 3752:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3753:          // XXX IMPLEMENT THIS
 3754:       //          xt=0.d0
 3755:       //          yt=0.d0
 3756:       //          !centroid coord. for nudging
 3757:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3758:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3759:          }  // ics
 3760: 
 3761: 
 3762: 
 3763:          // If on land or open boundary...
 3764:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3765:          
 3766:          const double vmag = length(side->u2[k]);
 3767: 
 3768:          if (vmag <= velmin_btrack) {
 3769:             // No activity 
 3770: 
 3771:             side->btu[k] = side->u2[k];
 3772:             
 3773:          } else {  // do btrack
 3774: 
 3775:             // Compute number of sub-divisions based on local gradients 
 3776:             // XXX IS THIS NECESSARY?
 3777:             double suma = 0.0;
 3778:             int icount = 0;
 3779:             for (int ii=0; ii<2; ii++) {
 3780: 
 3781:                const Element *elem = side->elems[ii];
 3782:                  
 3783:                if (elem == nullptr) continue;
 3784: 
 3785:                icount++;
 3786: 
 3787:                // Not strictly along z; in ll frame for ics=2
 3788: 
 3789:                double utmp[4];
 3790:                double vtmp[4];
 3791:                for (int jj = 0; jj < elem->i34; jj++) {
 3792: 
 3793:                   const Node *node = elem->nodes[jj];
 3794: 
 3795:                   if constexpr(ics==1) {
 3796:                      utmp[jj] = node->u2[k].x;
 3797:                      vtmp[jj] = node->u2[k].y;  
 3798:                   } else {
 3799:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3800:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3801:                   }
 3802:                } // for jj
 3803: 
 3804:                const Vector2 grad_u = elem->grad2(utmp); 
 3805:                const Vector2 grad_v = elem->grad2(vtmp);
 3806: 
 3807:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3808:             } // for ii
 3809: 
 3810:             assert(icount > 0 && "Impossible 77");
 3811: 
 3812:             // '4' is somewhat arbitrary
 3813:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3814: 
 3815:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3816:          
 3817: 
 3818:             Vector3 u_int = {0.0, 0.0, 0.0};
 3819: 
 3820:             side->btrack(k, dt, dtbk, u_int);
 3821:             side->btu[k] = toVector2(u_int);
 3822:                
 3823:          } // if vmag (do backtrack)
 3824: 
 3825:       } // for k=kb,nvrt-1
 3826: 
 3827:    }
 3828: 
 3829: } // extern "C"
 3830: 
 3831: template<int nc>
 3832: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3833: 
 3834: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3835: //
 3836: // a,b,c,rhs: input vectors and are not modified by this program.
 3837: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3838: // rhs is the r.h.s.
 3839: // n: actual rank of the system.
 3840: // rows in u() and rhs();
 3841: // u: output with nc columns (transposed to rows)
 3842: // gam: a working array.
 3843: //
 3844: // NOTES:
 3845: // This is a template function that allows for different numbers of columns in the rhs vector.
 3846: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3847: 
 3848:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3849:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3850: 
 3851:    double bet = b[0];
 3852:    if constexpr (nc == 1) {
 3853:       u[0] = rhs[0]/bet;
 3854:    } else {
 3855:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3856:    }
 3857: 
 3858:    for (int j = 1; j < n; j++) {
 3859:       gam[j] = c[j - 1]/bet;
 3860:       bet = b[j] - a[j]*gam[j];
 3861: 
 3862:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3863: 
 3864:       if constexpr (nc == 1) {
 3865:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3866:       } else {
 3867:          for (int l = 0; l < nc; l++) {
 3868:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3869:          }
 3870:       }
 3871:    }
 3872: 
 3873:    // Back-substitution
 3874:    for (int j = n - 2; j >= 0; j--) {
 3875:       if constexpr (nc == 1) {
 3876:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3877:       } else {
 3878:          for (int l = 0; l < nc; l++) {
 3879:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3880:          }
 3881:       }
 3882:    }
 3883: }
 3884: 
 3885: 
 3886: 
 3887: // Helper function that contains the core algorithm
 3888: template<typename XAccessor, typename YAccessor>
 3889: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3890:                                     double  yp_top, double  yp_bot, 
 3891:                                     CubicSpline &spline) {
 3892:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3893:    // 
 3894:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3895:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3896:    //
 3897:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3898:    // 
 3899:    // Inputs: 
 3900:    //            n: dimension for x etc; # of data pts (>=2);
 3901:    //            getX, getY: functions to access x,y coordinates
 3902:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3903:    //     Output: 
 3904:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3905: 
 3906:    const int n = k2 - k1 + 1;
 3907:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3908: 
 3909:    // Allocate memory for the splines
 3910:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3911:    spline.x   = new double[n];
 3912:    spline.y   = new double[n];
 3913:    spline.yp  = new double[n];
 3914:    spline.ypp = new double[n];
 3915: 
 3916:    for (int k=k1; k<=k2; k++) {
 3917:       spline.x[k] = getX(k);
 3918:       spline.y[k] = getY(k);
 3919:    }
 3920: 
 3921:    // This is to simplify expressions later
 3922:    double *x = spline.x;
 3923:    double *y = spline.y;
 3924: 
 3925:    double *a = nullptr;
 3926:    double *b = nullptr;
 3927:    double *c = nullptr;
 3928:    double *gam = nullptr;
 3929:    double *rhs = nullptr;
 3930:    
 3931: 
 3932:       a = new double[n];   // Lower diagonal
 3933:       b = new double[n];   // Diagonal
 3934:       c = new double[n];   // Upper diagonal
 3935:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3936:       rhs = new double[n]; // Right-hand side
 3937: 
 3938:    for (int k=k1; k<=k2; k++) {
 3939:       if (k == k1) {
 3940:          // Bottom level
 3941:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3942:          b[k] = (x[k+1] - x[k])/3.0;
 3943:          c[k] = b[k]/2.0;
 3944:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3945:       } else if (k == n - 1) {
 3946:          // Top level (surface)
 3947:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3948:          b[k] = (x[k] - x[k-1])/3.0;
 3949:          a[k] = b[k]/2.0;
 3950:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3951:       } else {
 3952:          // Intermediate levels
 3953:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3954:          b[k] = (x[k+1] - x[k-1])/3.0;
 3955:          a[k] = (x[k  ] - x[k-1])/6.0;
 3956:          c[k] = (x[k+1] - x[k  ])/6.0;
 3957:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3958:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3959:       }
 3960:    }
 3961: 
 3962:    // Solve the tridiagonal system
 3963:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3964:    
 3965:    spline.yp[k1] = yp_bot;
 3966:    spline.yp[k2] = yp_top;
 3967: 
 3968:    // Compute rest of 1st derivatives using the splines
 3969:    for (int k=k1+1; k<k2; k++) {
 3970:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3971:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3972:    }
 3973:    
 3974:    delete[] a;
 3975:    delete[] b;
 3976:    delete[] c;
 3977:    delete[] gam;
 3978:    delete[] rhs;
 3979: 
 3980: }
 3981: 
 3982: // Array version
 3983: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3984:                                 double y_top, double y_bot, 
 3985:                                 CubicSpline &spline) {
 3986:    auto getX = [x] (int k) { return x[k]; };
 3987:    auto getY = [y] (int k) { return y[k]; };
 3988:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3989: }
 3990: 
 3991: // Lambda version - allows custom access patterns
 3992: template<typename XFunc, typename YFunc>
 3993: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3994:                                 double y_top, double y_bot,
 3995:                                 CubicSpline &spline) {
 3996:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3997: }
 3998: 
