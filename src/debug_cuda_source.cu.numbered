 4722: 
 4723:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4724: 
 4725:       SIDE(side);
 4726: 
 4727:       side->U = {0.0, 0.0}; 
 4728:          
 4729:       if(side->isDry) return;
 4730: 
 4731:       // Vertically integrated velocity U (in ll if ics=2)
 4732:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4733:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 4734:          side->U += side->Dz(k + 1)*uc;  
 4735:       }
 4736: 
 4737:    }
 4738: 
 4739:    __global__ void computeBottomDragVegetation(void) {
 4740:       // UNFINISHED. CHECK THIS:
 4741:       // How many kernels are needed? Why so many for loops?
 4742:       // Is the loop on sides needed?
 4743: 
 4744:       NODE(node);
 4745: 
 4746: 
 4747:       const int    kb      = node->kb;
 4748:       const double htot    = node->htot2(); 
 4749:       
 4750:       if (node->isDry) {
 4751:          // Default values for dry nodes
 4752:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4753:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4754: 
 4755:          return;
 4756:        
 4757:       }
 4758: 
 4759:       // Computes bottom drag Cd based on the selected nchi
 4760:       node->computeBottomDragCd();
 4761:       
 4762: 
 4763: 
 4764:       //   Bottom stress in m^2/s^2
 4765:       if (node->rho[kb + 1] >= -98.0)
 4766:       {
 4767:          const double mag_u = length(node->u2[kb + 1]);
 4768:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4769: 
 4770:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4771:          // !sediment erosion: this part needs more documentation
 4772:       }
 4773:     
 4774: 
 4775: 
 4776:       // Compute vegetation parameters
 4777:       //--------------------------------
 4778: 
 4779:       // SAV constants
 4780:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4781:       constexpr double veg_cfpsi = 0.16;
 4782: 
 4783:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4784:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4785: 
 4786:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4787:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4788:          int kbin = 0; // bin index
 4789:          for (int k = kb; k < nvrt; k++) {
 4790:             // Computes node height above the bottom level
 4791:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4792:             assert(false && "Vertical variation of vegetation not implemented");
 4793: 
 4794:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4795:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4796:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4797:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4798:             // } else {
 4799:             //    // Find the bin at which the current vertical level is
 4800:             //    while (kbin<nbins_veg_vert) {
 4801:             //       const double zn = node->z[kbin];
 4802:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4803:             //          break;
 4804:             //       } // if
 4805:             //       kbin++;
 4806:             //    } // while
 4807:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4808: 
 4809:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4810:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4811:                
 4812:             //    // Linear interpolation of the vegetation parameters
 4813:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4814:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4815:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4816:             // } // if rl10
 4817: 
 4818:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4819: 
 4820:          } // for k
 4821: 
 4822: 
 4823:       } else { // Ganthy (iveg==2)
 4824:       //  Modify canopy height, diameter, and density
 4825: 
 4826:          // Make sure there is vegetation on this node
 4827:          if (node->veg_h_unbent > 0.0) {
 4828:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4829: 
 4830:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4831:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4832:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4833: 
 4834:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4835:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4836:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4837:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4838:          } // if veg_h_unbent
 4839: 
 4840:          for (int k = 0; k < nvrt; k++) {
 4841:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4842:          } // for k
 4843:       
 4844: 
 4845:       } // if iveg
 4846:      
 4847: 
 4848:       // Compute vertical mean of veg_alpha3D
 4849:       if (iveg != 0) {
 4850:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4851:          double sum1=0.0;
 4852:          double sum2=0.0;
 4853:          // Integrate over each level under the canopy...
 4854:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4855:             const double Dz = node->Dz(k);
 4856: 
 4857:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4858:             sum2 += Dz;
 4859: 
 4860:          } // for k
 4861:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4862:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4863: 
 4864:       } // if iveg
 4865: 
 4866:    }
 4867: 
 4868:    __global__ void computeVegetationAndDragParameters(void) {
 4869:       // Computes the vegetation and drag model parameters:
 4870:       // chi, \tilde\chi, beta, \breve{H}
 4871:       
 4872:       SIDE(side);
 4873: 
 4874:       if (side->isDry) return;
 4875: 
 4876:       const double htot = side->htot2();
 4877:       const int    kb   = side->kb;
 4878: 
 4879:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4880: 
 4881:       const double veg_h     = side->veg_h();
 4882:       const double veg_nv    = side->veg_nv();
 4883:       const double veg_c     = side->veg_c();
 4884:       const double veg_beta  = side->veg_beta;
 4885:       const double veg_alpha = side->veg_alpha_vert_mean();
 4886: 
 4887:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4888:       // Velocity magnitude at the bottom level
 4889:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4890:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 4891:       side->chi2 = side->Cd()*vmag1;
 4892:       side->chi  = side->chi2;
 4893:       if constexpr(iveg != 0) {
 4894:          const Node *n1 = side->n1;
 4895:          const Node *n2 = side->n2;
 4896:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4897:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4898:       }
 4899: 
 4900:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4901: 
 4902:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4903:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4904:       double magUa = 0.0;
 4905:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4906:          // 3D wet side with veg...
 4907: 
 4908:          double magUa = 0.0;
 4909:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4910:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4911: 
 4912:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4913:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4914:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4915: 
 4916:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4917:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4918: 
 4919:                // Velocity magnitude at the bottom (l) of the level
 4920:                const double ul = length(side->u2[k]);
 4921: 
 4922:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4923:                magUa += Dz*0.5*(uh + ul);
 4924: 
 4925:             } // if HasVegetation
 4926:          } // for k
 4927:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4928: 
 4929:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4930:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4931:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4932:             const double zCpy = side->zTopCanopy();
 4933:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4934:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4935:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4936:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4937:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4938:          } // if isSubmerged
 4939:       } // if iveg   
 4940: 
 4941:       // Computes the friction modified depth, \breve{H} in notes
 4942:       if (side->is2D()) { // 2D
 4943: 
 4944:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 4945:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 4946: 
 4947:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 4948: 
 4949:          side->hhat = htot*htot/fricH; 
 4950: 
 4951:       } else { // 3D
 4952:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 4953: 
 4954:          if constexpr(iveg != 0) {
 4955:             
 4956:             if (side->isSubmerged()) { 
 4957:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 4958:                side->hhat -= veg_c*Hhat_alpha;
 4959: 
 4960:             } else { // Emergent
 4961:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 4962:             }
 4963:          } // if iveg
 4964: 
 4965:          // Enforce positivity for 3D model
 4966:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 4967:       } // if 3D
 4968: 
 4969:    }
 4970: 
 4971: 
 4972: 
 4973:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 4974:    // Computes the density gradient between two elements, e1 and e2.
 4975:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 4976:    // zero in the direction normal to the side. 
 4977:    // 
 4978:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 4979:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 4980:    //
 4981:    // Input:
 4982:    //    e1: Element
 4983:    //    e2: Neighbor element (or nullptr if boundary)
 4984:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 4985:    //    k: Index of the half-level at which the density is interpolated
 4986:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 4987:    // 
 4988:    // Output:
 4989:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 4990:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 4991: 
 4992:       if (e2 == nullptr || e2->isDry) {
 4993:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 4994: 
 4995:          Side *side = e1->sides[j];
 4996:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 4997:                  
 4998:          if constexpr(ics == 1) {
 4999:             vec = side->n; // Normal vector to the side
 5000:          } else {
 5001:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5002:             // IMPLEMENT THIS XXXXXX
 5003:             // !replace with xel, yel?
 5004:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5005:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5006:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5007:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5008:          } //ics
 5009:                    
 5010:          diffRho = 0.0;
 5011: 
 5012:       } else { //internal and wet
 5013:          if constexpr(ics==1) {
 5014:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5015: 
 5016:             // Vector from e1 to e2
 5017:             vec = e2->center - e1->center;
 5018: 
 5019:          } else { 
 5020:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5021:             // IMPLEMENT THIS XXXXXX
 5022:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5023:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5024:             //                   alow(j)=xctr2
 5025:             //                   bdia(j)=yctr2
 5026:          } // ics
 5027: 
 5028:          diffRho = rho2 - e1->demeanedDensity(k);
 5029:       }
 5030: 
 5031:    }
 5032: 
 5033:    __global__ void computeDensityCubicSplines(void) {
 5034:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5035: 
 5036:       ELEM(elem);
 5037: 
 5038:       if (elem->isDry) return;
 5039: 
 5040:       const int kb = elem->kb;
 5041: 
 5042:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5043:       if (elem->is2D()) {
 5044:          // In the 2D case, the density is constant at the prism level. 
 5045:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5046:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5047:       } else { //3D
 5048: 
 5049:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5050:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5051:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5052:          ///// XXXX CHECK INDICES!!!!!
 5053:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5054:       } // 2D/3D
 5055: 
 5056:    }
 5057: } // extern "C"
 5058: 
 5059: 
 5060: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5061: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5062: 
 5063:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5064: 
 5065:    const int kb  = elem->kb;
 5066:    const int kb2 = elem2->kb;
 5067: 
 5068:    // z-coordinate of prism of elem
 5069:    const double zp = elem->z_prism(k);
 5070: 
 5071:    double rho = 0.0;
 5072: 
 5073:    if (elem2->is2D()) {
 5074:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5075: 
 5076:    } else {  // 3D
 5077: 
 5078:       // eta_min may be < zmax
 5079:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5080:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5081: 
 5082:       // (Extrapolate density below bottom, we will fix it later)
 5083:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5084:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5085:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5086:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5087:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5088:    } // 2D/3D
 5089:      
 5090: 
 5091:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5092:    // Now we need to fix it.
 5093:    if (elem->z[k] < elem2->z[kb2]) {
 5094:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5095: 
 5096:       // There are two methods to adjust the density at the bottom of the element.
 5097:       // iunder_deep=0: 
 5098:       const double depth1 = abs(elem->z[kb]); // larger depth
 5099: 
 5100:       if (iunder_deep==0) {
 5101: 
 5102:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5103: 
 5104:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5105: 
 5106:       } else { // iunder_deep != 0
 5107: 
 5108:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5109: 
 5110:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5111: 
 5112:          //   Demeaned density at the same z coordinate as
 5113:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5114:          }
 5115: 
 5116:       } // if iunder_deep
 5117:    } // if elem->z[kb] < elem2->z[kb]
 5118: 
 5119:    return rho;
 5120: }
 5121: 
 5122: 
 5123: extern "C" {
 5124:    __global__ void computeDensityGradient(void) {
 5125: 
 5126:       if constexpr(ibc != 0) return;
 5127: 
 5128:          // Compute the horizontal density gradient at each element.
 5129:       // It works in two steps:
 5130:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5131:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5132:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5133:       //             gradRho.r1 = rho1 - rho0
 5134:       //             gradRho.r2 = rho2 - rho0
 5135:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5136:       // 
 5137:       //  NOTE: We use de-meaned densities.
 5138: 
 5139:       ELEM(elem);
 5140: 
 5141:       if (elem->isDry) return;
 5142: 
 5143:       const int kb  = elem->kb;
 5144:       const int i34 = elem->i34;
 5145: 
 5146:       for (int k = kb + 1; k < nvrt; k++) {
 5147:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5148:          //             gradRho.r1 = rho1 - rho0
 5149:          //             gradRho.r2 = rho2 - rho0
 5150:          int icount = 0;
 5151:          double sumRx = 0.0;
 5152:          double sumRy = 0.0;
 5153:          for (int j1=0; j1<i34; j1++) { 
 5154: 
 5155:             const int j2 = elem->nxq(j1 + 1);
 5156: 
 5157:             // Pairs of consecutive neighbor elements of elem
 5158:             const Element *e1 = elem->nghbElems[j1];
 5159:             const Element *e2 = elem->nghbElems[j2];
 5160: 
 5161:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5162:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5163:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5164: 
 5165:             // Compute the density difference and the vector from elem to e1 and e2
 5166:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5167:             double diffRho1, diffRho2;
 5168:             Vector2 vec1, vec2;
 5169:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5170:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5171: 
 5172:             const double rl1 = length(vec1);
 5173:             const double rl2 = length(vec2);
 5174:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5175: 
 5176:             const double delta = cross(vec1, vec2);
 5177:             const double sintheta = abs(delta)/(rl1*rl2);
 5178: 
 5179:             // To avoid problems, avoid elements with small angle between vectors
 5180:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5181:             const bool validEq = (sintheta > sin_one_deg);
 5182: 
 5183:             if (validEq) {
 5184:                // Solve the system of equations to get the density gradient at elem
 5185:                icount++;
 5186:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5187:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5188:                sumRx += Rx;
 5189:                sumRy += Ry;
 5190:             }
 5191:          } // for j1
 5192: 
 5193:          // Compute the average density gradient at elem
 5194:          if (icount==0) {
 5195:            // Bad mesh quality; bail out with 0 b-cc
 5196:            elem->gradRho[k] = {0.0, 0.0};
 5197:          } else {
 5198:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5199:          }
 5200: 
 5201:       } // for k
 5202: 
 5203:    }
 5204: 
 5205:    __global__ void computeBaroclinicTerm(void) {
 5206:    // Computes the baroclinic term at sides (at half levels).
 5207:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5208:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5209: 
 5210:       if (ibc == 1) return;
 5211: 
 5212:       SIDE(side);
 5213: 
 5214:       if (side->isDry) return;
 5215: 
 5216:       const Element *e1 = side->elems[0];
 5217:       const Element *e2 = side->elems[1];      
 5218:       const int kb = side->kb;
 5219:       
 5220:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5221: 
 5222:       // interpolates vertically the density gradient of the two elements at the half level/
 5223: 
 5224:       int k1 = max(kb, nvrt / 2);
 5225:       int k2 = max(kb, nvrt / 2);
 5226: 
 5227:       // Starts the integration at the surface and goes down to the bottom
 5228:       side->bcc[nvrt-1] = {0.0, 0.0};
 5229:       for (int k = nvrt - 2; k >= kb; k--) {
 5230:       // For each prism level (from surface to bottom)...
 5231: 
 5232:          // For both elements, interpolate density gradient at the side's half level.
 5233:          // The gradient at the side is the average of the gradients at the elements.
 5234:          // w1, w2 are used to take into account boundary sides, with just one element.
 5235:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5236:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5237:          const double wsum = w1 + w2;
 5238:          w1 = w1/wsum;
 5239:          w2 = w2/wsum;
 5240:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5241: 
 5242:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5243:          Vector2 gradRho = {0.0, 0.0};
 5244:          if (e1 != nullptr && k > kb) {
 5245:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5246:             
 5247:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5248:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5249:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5250: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5251:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5252:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5253:          }      
 5254:          if (e2 != nullptr && k > kb) {
 5255:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5256:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5257:             
 5258:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5259:          }
 5260: 
 5261:          if constexpr(ics==2) {
 5262:             assert(false && "Not implemented: ics == 2");
 5263:             // IMPLEMENT THIS XXXXXX
 5264:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5265:             // swild(1)=tmp1
 5266:             // swild(2)=tmp2
 5267:          }
 5268:          
 5269:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5270:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5271:          // CHECK INDICES!!! XXX
 5272:          const double grav3 = side->grav3();
 5273:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5274: 
 5275:       } // for
 5276: 
 5277:    }
 5278: 
 5279: 
 5280: 
 5281:    __global__ void computeHorGradientAtSide(void) {
 5282: 
 5283:       // Compute the horizontal density gradient at each element.
 5284:       // It works in two steps:
 5285:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5286:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5287:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5288:       //             gradRho.r1 = rho1 - rho0
 5289:       //             gradRho.r2 = rho2 - rho0
 5290:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5291:       // 
 5292:       //  NOTE: We use de-meaned densities.
 5293: 
 5294:       SIDE(side);
 5295: 
 5296: // printf("side->isDry: %d\n", side->isDry);
 5297:       if (side->isDry) return;
 5298: 
 5299:       // Computes the gradient of the variables at the side center.
 5300:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5301:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5302:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5303: 
 5304:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5305:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5306:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5307:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5308: 
 5309:    }
 5310: 
 5311: 
 5312:    __global__ void solveMomentumEquations(double time) {
 5313: 
 5314:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5315:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5316: 
 5317:       SIDE(side);
 5318: 
 5319:       if (side->isDry) 
 5320:       {
 5321:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5322: 
 5323:          return;
 5324:       }
 5325: 
 5326:       const Node *n1 = side->n1;
 5327:       const Node *n2 = side->n2;
 5328: 
 5329:       const int kb = side->kb;
 5330: 
 5331:       const double veg_h = side->veg_h();
 5332:       const double grav3 = side->grav3();
 5333: 
 5334:       if (side->is2D()) {
 5335:          // Warning: Do not use htot2, which is updated.
 5336:          const double htot = side->htot1();
 5337:          const double hhat = side->hhat;
 5338: 
 5339:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5340: 
 5341:          Vector2 tau2 = {0.0, 0.0};
 5342:           
 5343:          if constexpr(ics==1) {
 5344:             tau2 = side->tau();
 5345: 
 5346:          } else {
 5347:             assert(false && "Not implemented: ics == 2");
 5348:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5349:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5350:             // taux2=(vn1+tt1)*0.5d0
 5351:             // tauy2=(vn2+ss1)*0.5d0
 5352:          } // if ics         
 5353: 
 5354:          // hat_gam has units of m/s
 5355: 
 5356:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5357: 
 5358:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5359:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5360: 
 5361:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5362: 
 5363: 
 5364:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5365:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5366: 
 5367:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5368: 
 5369:       }
 5370:       else { // 3D
 5371: 
 5372:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5373:          // 
 5374:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5375:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5376:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5377:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5378:          // k+1 and k.
 5379: 
 5380: 
 5381:          const int ndim = nvrt - kb;
 5382:          const double zTopCanopy = side->zTopCanopy();
 5383: 
 5384:          // Initialize the tridiagonal system
 5385:          for (int k = kb + 1; k < nvrt; k++) {
 5386:             
 5387:             const int kin = k - (kb + 1);
 5388: 
 5389:             // Vertical viscosity at the face center
 5390:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5391: 
 5392:  
 5393:             alow[kin] = 0.0;
 5394:             cupp[kin] = 0.0;
 5395:             bdia[kin] = 0.0;
 5396: 
 5397:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5398:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5399: 
 5400:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5401:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5402:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5403: 
 5404:             // First part: layers k, k+1
 5405:             if (k < nvrt - 1) {
 5406:                              
 5407:                if constexpr(iveg != 0) {
 5408: 
 5409:                   // If there is vegetation at this level...
 5410:                   if (zTopCanopy > side->zc[k]) {
 5411:                      // If the canopy is above the k layer...
 5412:                      
 5413:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5414:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5415:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5416:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5417: 
 5418:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5419:                      const double vmag2 = length(ut2);
 5420:                      const double vmag1 = length(side->u2[k]);
 5421:                      const double vmag = 0.5*(vmag1 + vmag2);
 5422:                      
 5423:                      // Computes the vegetation alpha at the face center
 5424:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5425: 
 5426:                      cff1 += veg_alpha_sd*dt*vmag;
 5427: 
 5428:                   } // if (zTopCanopy
 5429:                } // if iveg
 5430: 
 5431:                const double dzz = side->Dz(k + 1);
 5432:                const double tmp = dt*dfz/dzz;
 5433:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5434: 
 5435:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5436:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5437:             }
 5438: 
 5439: 
 5440:             // Second part: layers k-1, k
 5441:             if (k > kb + 1) {
 5442: 
 5443:                double cff1 = 1.0; //init \bar{c^k}
 5444: 
 5445:                if constexpr(iveg != 0) {
 5446:                   // If there is vegetation at this level...
 5447:                   if (zTopCanopy > side->zc[k-1]) {
 5448:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5449:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5450: 
 5451:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5452: 
 5453:                      const double vmag2 = length(ut2);
 5454:                      const double vmag1 = length(side->u2[k-1]);
 5455:                      const double vmag = 0.5*(vmag1 + vmag2);
 5456: 
 5457:                      // Computes the vegetation alpha at the face center
 5458:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5459:                      cff1 += veg_alpha_sd*dt*vmag;
 5460:                   } // if zTopCanopy
 5461: 
 5462:                } // if iveg
 5463: 
 5464:                const double dzz = side->Dz(k);
 5465:                const double tmp = dt*dfz/dzz;
 5466:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5467: 
 5468:                alow[kin] += cff1*dzz/6.0 - tmp;
 5469:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5470: 
 5471:             } else { // Bottom boundary
 5472:                // This occurs at the bottom, where the bottom drag is applied.
 5473: 
 5474:                bdia[kin] += dt*side->chi2; // XXXX
 5475: 
 5476:             } // if (k > kb + 1)
 5477: 
 5478: 
 5479:          } // for (int k
 5480: 
 5481: 
 5482: 
 5483:          // Computes the RHS.
 5484:          // -----------------
 5485: 
 5486:          //	BC to be imposed at the end.
 5487: 
 5488:          const Vector2 gradETP  = side->gradETP;
 5489:          const Vector2 gradPr   = side->gradPr;
 5490:          const Vector2 gradEta1 = side->gradEta1;
 5491:          const Vector2 gradEta2 = side->gradEta2;
 5492: 
 5493:          const Vector2 *btu = side->btu;
 5494:          const Vector2 *u2  = side->u2;
 5495:          const double coriolis = side->coriolis;
 5496:          const Vector2 *nuGradU = side->nuGradU;
 5497: 
 5498: 
 5499:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5500: 
 5501:          for (int k = kb + 1; k < nvrt; k++) {
 5502:             const int kin = k - kb - 1;
 5503: 
 5504:             const double dz_0 = side->Dz(k);
 5505:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5506: 
 5507:             rrhs[kin] = {0.0, 0.0};
 5508:             double dz = 0.0;
 5509: 
 5510:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5511:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5512:             if (k < nvrt  ) dz += dz_1;
 5513:             if (k > kb + 1) dz += dz_0;
 5514: 
 5515:             // Elevation gradient, atmospheric pressure and tidal potential
 5516:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5517: 
 5518:             // Coriolis, advection, wind stress, and horizontal viscosity
 5519:             if (k < nvrt - 1) {
 5520: 
 5521: 
 5522:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5523:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5524:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5525:                                                 
 5526: 
 5527:                //diff stress tensors 1006
 5528:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5529:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5530:                   assert(false && "Not implemented: itur == 5");
 5531:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5532:                }
 5533:                // else assert(false && "itur # Not implemented");
 5534: 
 5535:             } else { // k == nvrt - 1 SURFACE
 5536:                Vector2 tau2 = {0.0, 0.0};
 5537:                if constexpr(ics==1) {
 5538:                   tau2 = side->tau();
 5539:       
 5540:                } else {
 5541:                   assert(false && "Not implemented: ics == 2");
 5542:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5543:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5544:                   // taux2=(vn1+tt1)*0.5d0
 5545:                   // tauy2=(vn2+ss1)*0.5d0
 5546:                } // if ics
 5547: 
 5548:                rrhs[kin] += dt*tau2;
 5549:           
 5550: 
 5551:             } // if k<nvrt
 5552: 
 5553: 
 5554:             if (k > kb + 1) {
 5555:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5556:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5557:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5558: 
 5559:                // diff stress tensors 1006
 5560:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5561:                   assert(false && "Not implemented: itur == 5");
 5562:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5563:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5564:                }
 5565:                // else assert(false && "itur # Not implemented");
 5566: 
 5567: 
 5568:             } // if k>kbs + 1
 5569: 
 5570:             // Baroclinic
 5571:             Vector2 *bcc = side->bcc;
 5572:             if constexpr(ibc == 0) {
 5573:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5574:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5575: 
 5576:             } // if ibc==0
 5577: 
 5578:          } // k=kb + 1,nvrt
 5579: 
 5580: 
 5581:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5582: 
 5583:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 5584:             const int kin = k - kb - 1;
 5585:    
 5586:             // Velocity is always clamped to maximum values
 5587:             side->u2[k] = {clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely)};
 5588:          } // k
 5589: 
 5590:       } // if side->is2D()
 5591:       
 5592: 
 5593:       // Impose velocity boundary condition at the bottom
 5594:       if constexpr(imm == 2) { // 3D bed deformation model
 5595:          double dep;
 5596:          Vector2 vel;
 5597: 
 5598:          assert(false && "Not implemented: imm == 2");
 5599:          //update_bdef(time, x0, y0, dep, vel);
 5600:          // side->u2[kb] = vel;
 5601: 
 5602:       } else { // imm = 0 or 1
 5603:          if (side->Cd() == 0.0) {
 5604:             side->u2[kb] = side->u2[kb + 1];
 5605: 
 5606:          } else if (side->is3D()) { // 3D no slip bottom   
 5607:             side->u2[kb] = {0.0, 0.0};
 5608:          }
 5609:           
 5610:       } // if imm
 5611: 
 5612:       // The velocities below the bottom level are set to zero
 5613:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 5614: 
 5615: 
 5616:    }
 5617: 
 5618: 
 5619:    __global__ void applyMomentumBC(void) {
 5620: 
 5621:       SIDE_BND(sideBnd);
 5622: 
 5623:       Side *side = sideBnd->side;
 5624:       const BoundarySegment *segment = sideBnd->segment;
 5625:       const Node *n1 = side->n1;
 5626:       const Node *n2 = side->n2;
 5627: 
 5628:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5629: 
 5630:       const bool isLand = segment->isLand;
 5631:       const int ifltype = segment->ifltype;
 5632: 
 5633:       const int kb = side->kb;
 5634: 
 5635: 
 5636:       if (!isLand && ifltype != 0) {
 5637:          const Vector2 *ubc = sideBnd->ubc;
 5638:   
 5639:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5640:             
 5641:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5642:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5643: 
 5644:             if (ifltype == -1) {
 5645:                // Flather 1
 5646: 
 5647:                const double depth = side->depth();
 5648: 
 5649:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5650: 
 5651:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5652: 
 5653:                side->u2[k] = vnorm*side->n;
 5654: 
 5655:             } else if (ifltype == -2) { // Discharge
 5656: 
 5657:                const double eta1 = side->eta1();
 5658:                const double eta2 = side->eta2();
 5659:                const double htot = side->htot2();
 5660: 
 5661:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5662:                assert(false && "Not implemented: Discharge bc");
 5663:                // const double dischrg = discharge(eta1);
 5664:                const double dischrg = 0.0; // XXX REMOVE
 5665:                
 5666: 
 5667:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5668: 
 5669:                const double vnorm = dischrg*eta2/htot;
 5670: 
 5671:                side->u2[k] = vnorm*side->n;
 5672: 
 5673:             }
 5674:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5675:                const double vnorm = dot(side->u2[k], side->n);
 5676: 
 5677:                double rat;
 5678:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5679:                else              rat = segment->vobc2; // outgoing
 5680: 
 5681:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5682: 
 5683:             }
 5684:             else { // not Flather or 3D radiation
 5685:                side->u2[k] = ubc[k];
 5686: 
 5687:             } // if (segment->ifltype...
 5688: 
 5689:          }
 5690: 
 5691:       }
 5692:       else if (isLand) { // if it is land boundary side
 5693: 
 5694:          if constexpr(islip == 0) { // free slip
 5695: 
 5696:             for (int k = kb; k < nvrt; k++) {
 5697: 
 5698:                const Vector2 t = side->t();
 5699:                const Vector2 n = side->n;
 5700: 
 5701:                double vnorm = 0.0; // for most cases
 5702:                const double vtan = dot(side->u2[k], t);
 5703:                
 5704:                side->u2[k] = vtan*t - vnorm*n;
 5705: 
 5706:             }
 5707: 
 5708:          } else { // no slip
 5709:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5710: 
 5711:          }
 5712:       } // if (side segment type...
 5713: 
 5714:    
 5715: 
 5716:    }
 5717: 
 5718: 
 5719:    __global__ void shapiroFilter1(void) {
 5720:       // First step of the Shapiro filter (normally used if indvel<=0)
 5721:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5722: 
 5723:       SIDE(side);
 5724: 
 5725:       // Only internal wet sides are processed
 5726:       if (side->isDry || !(side->isInternal())) return;
 5727: 
 5728:       const int kb = side->kb;
 5729: 
 5730:       for (int mm = 0; mm < niter_shap; mm++) {
 5731: 
 5732:          for (int k = kb + 1; k < nvrt; k++) {
 5733:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5734:             Vector2 suru = {0.0, 0.0};
 5735: 
 5736:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5737: 
 5738:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 5739: 
 5740:                int kin = k;
 5741:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 5742:                
 5743:                if constexpr(ics==1) {
 5744:                   suru += nSide->u2[kin];
 5745: 
 5746:                } else {
 5747:                   assert(false && "Not implemented: ics == 2");
 5748:                   // Vector2 vn1, vn2;
 5749:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5750:                   // suru=suru+vn1;
 5751:                   // surv=surv+vn2;
 5752:                }
 5753:             }
 5754: 
 5755:             // Reusing bcc as a temporary array to store the suru values.
 5756:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5757: 
 5758:          }
 5759:       }
 5760:    }
 5761: 
 5762:    __global__ void shapiroFilter2(void) {
 5763:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5764: 
 5765:       SIDE(side);
 5766: 
 5767: 
 5768:       if (side->isDry || !(side->isInternal())) return;
 5769: 
 5770:       const int kb = side->kb;
 5771: 
 5772:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5773: 
 5774:       if (side->is2D()) {
 5775:          side->u2[kb + 1] = side->bcc[kb + 1];
 5776:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 5777: 
 5778:       } else {
 5779:          // 3D
 5780:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5781:          
 5782:       }
 5783: 
 5784:    }
 5785: 
 5786: 
 5787:    __global__ void ul0UpdateZCoords(void) {
 5788:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5789:       
 5790:       NODE(node);      
 5791: 
 5792: 
 5793:       if (false) {//node->isDry) {  //XXXXXXXXXXXXXXXXX
 5794: 
 5795:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5796: 
 5797:          if constexpr(ivcor != 1) node->kb = 0;
 5798: 
 5799:       } else {
 5800: 
 5801:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5802:          node->updateKb();
 5803: 
 5804:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5805: 
 5806:       }
 5807: 
 5808:       // We use the temp.b field to store the previous state of isDry.
 5809:       node->tmp.b = node->isDry;
 5810: 
 5811:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5812:       node->isDry = true;
 5813: 
 5814:    }
 5815: 
 5816:    __global__ void ul0ComputeDryElements(void)
 5817:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 5818:    {
 5819:       ELEM(elem);
 5820: 
 5821:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 5822: 
 5823:       elem->kb = 0;
 5824: 
 5825:       if (elem->isDry) return;
 5826: 
 5827: 
 5828:    //    if(elem->isDry2()) { // XXXX
 5829:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5830:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5831:    //        call parallel_abort(errmsg)
 5832:    //    }
 5833: 
 5834:       const Node *n1 = elem->nodes[0];
 5835:       const Node *n2 = elem->nodes[1];
 5836:       const Node *n3 = elem->nodes[2];  
 5837:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 5838: 
 5839:       // Computes element's kb as the minimum of the nodes' kb.
 5840:       const int kb1 = n1->kb;
 5841:       const int kb2 = n2->kb;
 5842:       const int kb3 = n3->kb;
 5843:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5844: 
 5845: 
 5846:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5847: 
 5848: 
 5849:       // Computes the element z as the mean of the nodes z.
 5850:       for (int k = elem->kb; k < nvrt; k++) {
 5851: 
 5852:          // Compute the element z as the mean of the nodes z.
 5853:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 5854:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5855:          elem->z[k] /= elem->i34;
 5856: 
 5857:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5858:       }
 5859:                   
 5860:    }
 5861: 
 5862:    __global__ void ul0ComputeDryNodes(void)
 5863:    // Updates node's isDry based on the elements' isDry. 
 5864:    {
 5865:       NODE(node);
 5866: 
 5867:       node->isDry = true;
 5868: 
 5869:       // A node is wet if at least one of the elements sharing it is wet.
 5870:       for (int j = 0; j < node->numElements; j++) {
 5871:          const Element *elem = node->elements[j];
 5872:          if (!elem->isDry) {
 5873:             node->isDry = false;
 5874:             break;
 5875:          }
 5876:       }
 5877: 
 5878:        
 5879:    }
 5880: 
 5881: 
 5882:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5883:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 5884:    // node->tmp.b is true if the node was previously dry.
 5885:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 5886:    {
 5887:       NODE(node);
 5888:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5889: 
 5890:       // Avoid this the first time step.
 5891:       if (it == iths) return;  
 5892: 
 5893:       const bool wasDry = node->tmp.b;
 5894: 
 5895: if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 5896: 
 5897:       // assert(node->isDry == node->isDry2() && "These two must be identical at this point"); XXXXX 
 5898:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 5899: 
 5900:          for (int k=0; k < nvrt; k++) {
 5901: 
 5902:             Vector3 utmp={0.0, 0.0, 0.0};
 5903: 
 5904:             double ttmp=0.0;
 5905:             double stmp=0.0;
 5906:             int icount=0;
 5907:             for (int j = 0; j < node->numNodes; j++) {
 5908: 
 5909:                const Node *nbrNode = node->nodes[j];
 5910:                
 5911:                const bool wasNbrDry = nbrNode->tmp.b;
 5912: 
 5913:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 5914:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 5915: 
 5916:                   icount++;
 5917: 
 5918:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5919:                   utmp += nbrNode->uvw2(k);
 5920:                   
 5921:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 5922:                   stmp += nbrNode->tracers[k].tracer[1]; 
 5923:                }
 5924:             }
 5925: 
 5926:             if (icount > 0) {
 5927:                const double inv_icount = 1.0/icount;
 5928:                utmp = inv_icount*utmp;
 5929:                node->u2[k]     = toVector2(utmp);
 5930:                node->w2[k]     = utmp.z;
 5931:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5932:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5933:             } else {
 5934:                node->u2[k] = {0.0, 0.0};
 5935:                node->w2[k] = 0.0;
 5936:                // Initialize tracers to 0.0??? XXXXX
 5937:             }
 5938:          }
 5939:       }
 5940:    }
 5941: 
 5942:   
 5943:    
 5944: 
 5945: 
 5946:    __global__ void ul0UpdateSides(int it, int iths) {
 5947:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 5948:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 5949:    // The dryness of the sides is updated in ul0UpdateSides2.
 5950: 
 5951:       SIDE(side);
 5952: 
 5953:       // A side is wet if and only if at least one of its elements is wet.
 5954:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5955:  
 5956:       const Node *n1 = side->n1;
 5957:       const Node *n2 = side->n2;
 5958:      
 5959:       const int kb1 = n1->kb;
 5960:       const int kb2 = n2->kb;
 5961: 
 5962:       side->kb = 0; // default when dry
 5963: 
 5964:       if (isWet) {
 5965: 
 5966:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5967: 
 5968:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5969: 
 5970:          side->kb = min(kb1, kb2);
 5971: 
 5972:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5973: 
 5974:          for (int k = side->kb; k < nvrt; k++) {
 5975:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5976: 
 5977:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 5978: 
 5979:             // Compute velocity for re-wetted sides 
 5980:             if ((it != iths) && (side->isDry && isWet)) {
 5981: 
 5982:                Vector2 utmp={0.0, 0.0};
 5983: 
 5984:                int icount=0;
 5985: 
 5986:                // For all the sides on the two elements that share this side
 5987:                for (int j = 0; j < 2; j++) {
 5988:                   const Element *elem = side->elems[j];
 5989:                   if (elem == nullptr) continue;
 5990: 
 5991:                   for (int jj=0; jj < elem->i34; jj++) {
 5992:                      const Side *nSide = elem->sides[jj];
 5993:                      if (nSide->isDry) continue;
 5994: 
 5995:                      icount++;
 5996:                      utmp += nSide->u2[k];  
 5997:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 5998:                   }
 5999:                }
 6000:                   
 6001:                // assert(icount > 0 && "No wet sides around this side");  XXXXX RECOVER??? 
 6002:                if (icount > 0)  side->u2[k] = utmp/icount;
 6003:                else             side->u2[k] = {0.0, 0.0};
 6004:                   
 6005:             } // if ((it != iths) && (side->isDry && isWet))
 6006: 
 6007:          } // for k
 6008: 
 6009:       } // if isWet 
 6010:       
 6011: 
 6012: 
 6013:    }
 6014: 
 6015:    __global__ void ul0UpdateSides2(void) {
 6016:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6017:    
 6018:          SIDE(side);
 6019:    
 6020:          const Element *e1 = side->elems[0];
 6021:          const Element *e2 = side->elems[1];
 6022: 
 6023:          // A side is wet if and only if at least one of its elements is wet.
 6024:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6025: 
 6026:          // Update the side's dryness
 6027:          side->isDry = !isWet;
 6028: 
 6029: // if (side->isDry) {for (int k = 0; k < nvrt; k++) {side->u2[k] = {0.0, 0.0};side->w2[k] = 0.0;}}  // XXXX KKKKKK Not in the original code
 6030: 
 6031:    }
 6032: 
 6033: 
 6034:    __global__ void zeroNodalVelocities(void) {
 6035:       NODE(node);
 6036: 
 6037:       for (int k = 0; k < nvrt; k++) {
 6038:          node->u2[k]   = {0.0, 0.0};
 6039:          node->w2[k]   = 0.0;
 6040:          node->utmp[k] = {0.0, 0.0};
 6041:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6042:       }
 6043:    }
 6044: 
 6045:  
 6046: 
 6047:    __global__ void computeNodalVerticalVelocities1(void) {
 6048:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6049:    // Adds the element's vertical velocity times the element's area.
 6050:       ELEM(elem);
 6051: 
 6052:       for (int j = 0; j < elem->i34; j++) {
 6053:          Node *node = elem->nodes[j];
 6054: 
 6055:          for (int k = node->kb; k < nvrt; k++) {
 6056:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6057:          }
 6058:          atomicAdd(&(node->tmp.d), elem->area);
 6059:       }
 6060:    }
 6061: 
 6062:    __global__ void computeNodalVerticalVelocities2(void) {
 6063:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6064:    // Divides by the total area of the elements sharing the    node.
 6065:       NODE(node);
 6066: 
 6067:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6068: 
 6069:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6070:    }
 6071: 
 6072: 
 6073:    __global__ void computeNodalHorizontalVelocities1(void) {
 6074: 
 6075:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6076:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6077: 
 6078:       ELEM(elem);
 6079: 
 6080:       if (elem->isDry) return;
 6081: 
 6082:       const int kb = elem->kb;
 6083:       const bool isTri = elem->isTri();
 6084: 
 6085:       if constexpr(indvel <= 0) {
 6086:          // Assuming discontinous hvel.
 6087: 
 6088:          if (isTri) { // For triangles
 6089:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6090:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6091: 
 6092:             for (int j = 0; j < 3; j++) {
 6093:                // For every node of the triangle...
 6094:                Node *node = elem->nodes[j];
 6095: 
 6096:                if (node->isDry) continue;
 6097: 
 6098:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 6099:                const Side *s2 = elem->sides[(j + 1) % 3];
 6100:                const Side *s3 = elem->sides[(j + 2) % 3];
 6101: 
 6102: 
 6103:                atomicAdd(&(node->tmp.i), 1);
 6104: 
 6105:                for (int k = kb; k < nvrt; k++)  {
 6106:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at node j.   XXXX Function for clamping velocities. const vector2 u
 6107:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6108:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6109:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6110:                   atomicAdd(&(node->utmp[k].x), u.x);
 6111:                   atomicAdd(&(node->utmp[k].y), u.y);
 6112: 
 6113:                }
 6114: 
 6115:             }
 6116:          }
 6117:          else { // For quads
 6118:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6119: 
 6120:          }
 6121: 
 6122:       }
 6123:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 6124:       
 6125:    }
 6126: 
 6127: 
 6128:    __global__ void computeNodalHorizontalVelocities2(void) {
 6129:       NODE(node);
 6130: 
 6131:       const int nodeCount = node->tmp.i;
 6132: 
 6133:       if (nodeCount == 0) 
 6134:       {
 6135:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 6136:          return;
 6137:       }
 6138: 
 6139:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 6140:       
 6141:       const int kb = node->kb;
 6142: 
 6143:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 6144:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 6145:       
 6146:       
 6147:    }   
 6148: 
 6149:  
