 4504:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4505: 
 4506:       NODE_BND(nodeBnd);
 4507: 
 4508:       Node *node = nodeBnd->node;
 4509: 
 4510:       node->ETP = 0.0;
 4511: 
 4512:       for (int j=0; j<ntip; j++) {
 4513: 
 4514:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4515:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4516:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4517: 
 4518:          if constexpr(iloadtide==1) { // loading tide
 4519:             assert(false && "Loading tide not implemented");
 4520:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4521:          }
 4522:          
 4523:       }
 4524:       
 4525:    }
