 2145: __device__ __inline__ double min3(double a, double b, double c) {
 2146:    return min(a, min(b, c));
 2147: }
 2148: 
 2149: __device__ __inline__ double max3(double a, double b, double c) {
 2150:    return max(a, max(b, c));
 2151: }
 2152: 
 2153: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2154:    return min(a, min(b, min(c, d)));
 2155: }
