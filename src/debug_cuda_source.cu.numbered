  137: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  138: __device__ __forceinline__ double eta_n(int idxNode) {
  139:    // bit1: 0 -> -1, 1 -> +1
  140:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  141:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  142: }
  143: 
  144: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  145: __device__ __forceinline__ double xi_n(int idxNode) {
  146:    // +1 if (bit0 XOR bit1), else -1
  147:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  148:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  149: 
  150: }
