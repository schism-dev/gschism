 3364: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3365:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3366:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3367:                 int *isdel, int *isidenode, int *isbnd,
 3368:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3369:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3370:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3371:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3372:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3373:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3374:                 double *drag, double *roughness,
 3375:                 double *emo, double *efa, 
 3376:                 double *umo, double *ufa, 
 3377:                 double *vmo, double *vfa) {
 3378: 
 3379:    printf("Populating mesh for partition %d\n", partNum);
 3380: 
