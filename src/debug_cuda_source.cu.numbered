 4001:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4002:    //          enddo !j
 4003:    //        endif
 4004:    //      enddo !k
 4005:    //    endif !nfltype2
 4006:    }
 4007: 
 4008: 
 4009:    __global__ void computeFlowBcVelocities(double time) {
 4010: 
 4011:       SIDE_BND(sideBnd);
 4012: 
 4013:       const Side *side = sideBnd->side;
 4014:  
 4015:       const bool isDry = side->isDry;
 4016: 
 4017:       if (isDry) {
 4018:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4019:          return;
 4020:       }
 4021: 
 4022:       // For wet sides in open boundaries...
 4023:       const Vector2 n = side->n;
 4024:       const BoundarySegment *segment = sideBnd->segment;
 4025: 
 4026:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4027: 
 4028:       const int ifltype = segment->ifltype;
 4029:       const int iettype = segment->iettype;
 4030: 
 4031:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4032:       const Vector2 r_nuth0 = r_uth0*n;
 4033: 
 4034:       for (int k = 0; k < nvrt; k++) {
 4035:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4036:          Vector2 r_u1_bar = {0.0, 0.0};
 4037:       
 4038:          if (ifltype == 1 || ifltype == 2) {
 4039:          
 4040:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4041: 
 4042:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4043:             
 4044:             r_uth = unth0*n;  // This case has no ramp-up
 4045:             
 4046:          } else if (ifltype == -1) { // Flather 1
 4047: 
 4048:             // uth is the normal vel.; no ramp up
 4049:             const double uth = sideBnd->nuth(k);
 4050:             r_uth = uth*n;
 4051:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4052: 
 4053: 
 4054:          } else if (ifltype == 3 || ifltype == 5) {
 4055:             // vnth0=0 !normal vel.
 4056: 
 4057:             // Computes the contribution to the velocity from all tide frequencies
 4058:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4059: 
 4060:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4061:                const Vector2 umo  = sideBnd->umo(jfr); 
 4062: 
 4063:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4064:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4065:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4066:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4067:             }
 4068: 
 4069:          } // if (ifltype = 3 || ifltype == 5
 4070: 
 4071: 
 4072:          switch (iettype) {
 4073:             case 1:
 4074:             case 2:
 4075:             case 4:
 4076:                sideBnd->ubc[k] = r_uth;
 4077:                break;
 4078:             case 3:
 4079:                sideBnd->ubc[k] = r_u1_bar;
 4080:                break;
 4081:             case 5:
 4082:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4083:                break;
 4084:          } // switch
 4085: 
 4086:       } // for k
 4087:    }
 4088: 
 4089:    __global__ void computeElevationBoundaryConditions(double time) {
 4090:       // Compute elevation essential boundary conditions 
 4091: 
 4092:       NODE_BND(nodeBnd); // Each boundary node.
 4093: 
 4094:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4095: 
 4096:       const Node *node = nodeBnd->node;
 4097:       const BoundarySegment *segment = nodeBnd->segment;
 4098:       const int iettype = segment->iettype;
 4099:       
 4100: 
 4101:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4102:       double eic = 0.0;
 4103:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4104:       else                 eic = 0.0;
 4105: 
 4106:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4107:       const double r_eth = ramp*nodeBnd->eth;
 4108:       double r_eta1_bar = 0.0;
 4109: 
 4110: 
 4111:       // Compute tide elevation
 4112:       if (iettype == 3 || iettype == 5) {   
 4113: 
 4114:          if constexpr(iloadtide==1) { // loading tide
 4115:             assert(false && "Loading tide not implemented");
 4116:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4117:          }
 4118:          
 4119:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4120: 
 4121:             const double efa  = nodeBnd->efa[jfr]; 
 4122:             const double emo  = nodeBnd->emo[jfr]; 
 4123: 
 4124:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4125:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4126:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4127: 
 4128:          } // for jfr
 4129: 
 4130:       } // if iettype
 4131: 
 4132:       switch (iettype) {
 4133:          case 1:
 4134:          case 2:
 4135:          case 4:
 4136:             nodeBnd->elbc = r_eic + r_eth;
 4137:             break;
 4138:          case 3:
 4139:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4140:             break;
 4141:          case 5:
 4142:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4143:             break;
 4144:       } // switch
 4145: 
 4146: 
 4147:       //Add inverse barometric effects
 4148:       if (iettype != 0 && inv_atm_bnd == 1) {
 4149:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4150:       }
 4151: 
 4152:    }
 4153: 
 4154: 
 4155:    __global__ void computeHorizontalViscosity(void) { 
 4156: 
 4157:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4158: 
 4159:       SIDE(side);
 4160: 
 4161:       if (side->isDry) return;
 4162: 
 4163:       for (int k = 0; k < nvrt; k++) {
 4164:          side->nuGradU[k] = {0.0, 0.0};
 4165:       }
 4166: 
 4167:       if constexpr(ihorcon == 1) {
 4168:          for (int k = side->kb; k < nvrt - 1; k++) {
 4169:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4170:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4171:             // By Zhang and Baptista.
 4172: 
 4173:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4174:             // This is a standard discretization of the Laplacian operator.
 4175:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4176:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4177:             // Gamma is hvis_coef0 in the code.
 4178:             // The value of gamma needs to be < 0.5.
 4179: 
 4180:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4181:             // side under consideration in each of the two possible elements that share the side.
 4182:             Vector2 sumU = {0.0, 0.0};
 4183:             for (int l = 0; l < 2; l++) {
 4184:                const Element *elem = side->elems[l];
 4185: 
 4186:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4187: 
 4188:                // Find the local index of the side in the element
 4189:                const int idxSide = elem->sideLocalIdx(side);
 4190:                // Find the two sides that are connected to the side under consideration
 4191:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4192:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4193: 
 4194:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4195: 
 4196:             }
 4197: 
 4198:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4199:    
 4200:          }
 4201:       }
 4202:       else if constexpr(ihorcon == 2) {
 4203:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4204:       }
 4205: 
 4206: 
 4207:    }
 4208: 
 4209: 
 4210:    __global__ void setEssentialBC(void) {
 4211:       // Set essential boundary conditions 
 4212:       NODE(node); // Each boundary node
 4213:       NodeBoundary *nodeBnd = node->nodeBnd;
 4214:       
 4215: // nodeBnd->isEssentialBC = true;      
 4216:       // Check if this node has essential BC
 4217:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4218:          // Verify BC value is valid
 4219:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4220: 
 4221:        
 4222:          // Set diagonal to 1 and zero off-diagonals
 4223:          node->coeffDiag = 1.0;
 4224: 
 4225:          for (int j = 0; j < node->numNodes; j++) {
 4226:                node->coeffMatrix[j] = 0.0;
 4227:          }
 4228:          
 4229:          // Set solution and RHS to BC value
 4230:          node->mX  = nodeBnd->elbc;
 4231:          node->qel = nodeBnd->elbc;
 4232: 
 4233:       } else {
 4234:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4235: 
 4236:          for (int j = 0; j < node->numNodes; j++) {
 4237:                Node* nbNode = node->nodes[j];
 4238:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4239:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4240:                   // Verify neighbor's BC value
 4241:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4242: 
 4243:                   // Subtract contribution to RHS
 4244:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4245:                   node->coeffMatrix[j] = 0.0;  
 4246:                }
 4247:          }
 4248:       }
 4249:    }
 4250: 
 4251: 
 4252:    __global__ void updateElevation(void) {
 4253:       NODE(node);
 4254: 
 4255:       node->eta2 = node->mX;
 4256: 
 4257:       node->updateZCoordData();
 4258:    }
