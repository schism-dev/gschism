  269: // Simple math functions ---------------------------------------------------------------------------
  270: 
  271: __device__ __forceinline__ void solveQuadratic(double A, double B, double C, double &x1, double &x2) {
  272: // Solves the quadratic equation A*x^2 + B*x + C = 0 and returns the two solutions in x1 and x2.
  273: // Outputs:
  274: //        x1: first solution
  275: //        x2: second solution
  276: 
  277:        // Use float-specific absolute value for speed on GPU
  278:     const double absA = fabs(A);
  279:     const double absB = fabs(B);
  280: 
  281:     // 1. Near-linear case: a is effectively 0.
  282:     // We use a small epsilon to prevent division by zero and handle degenerate quads.
  283:     // This branch is almost never taken, so it won't hurt performance.
  284:     if (absA < 1e-14 * (absB + 1e-30)) {
  285:         const double x = -C / B;
  286:         x1 = x;
  287:         x2 = x;
  288:         return;  // Degenerate case: A = 0.
  289:     }
  290: 
  291:    const double delta = max(0.0, B*B - 4.0*A*C);
  292: 
  293:    assert(delta >= 0.0 && "solveQuadratic: negative discriminant");
  294:    const double s = sqrt(delta);
  295: 
  296:    // Numerically stable quadratic roots:
  297:    // q = -0.5*(B + sign(B)*sqrt(delta))
  298:    const double q = -0.5 * (B + copysign(s, B));
  299: 
  300:    x1 = q/A;
  301:    x2 = (fabs(q) > 1e-30) ? (C/q) : x1;   // Moving predicate.
  302: 
  303: }
