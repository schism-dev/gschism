 1277:    __device__ void setFrame(void) {
 1278:       if constexpr(ics == 1) return;
 1279: 
 1280:       double lat, lon;
 1281:       const Point3 p = toPoint3(center, centerZ());
 1282: 
 1283:       // Compute the latitude and longitude of the element center
 1284:       computeLatLon(p, lat, lon);
 1285: 
 1286:       frame.update(lat, lon);        
 1287:    }
