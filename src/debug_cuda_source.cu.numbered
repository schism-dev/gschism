 9380: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9381:    SIDE(side);
 9382: 
 9383:    switch (varCode) {
 9384:       case (int)VarCode::outputCoords: {
 9385:          const Point2 coords = side->outputCoords();
 9386:          double *out = (double *)((char *)res + idx_side * 16);
 9387:          out[0] = coords.x;
 9388:          out[1] = coords.y;
 9389:          break;
 9390:       }
 9391:       case (int)VarCode::n1:
 9392:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9393:          break;
 9394:       case (int)VarCode::n2:
 9395:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9396:          break;
 9397:       case (int)VarCode::isdry:
 9398:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9399:          break;
 9400:    }
 9401: }
 9402: 
 9403: 
 9404: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9405:    ELEM(elem);
 9406: 
 9407:    switch (varCode) {
 9408:       case (int)VarCode::outputCoords: {
 9409:          const Point2 coords = elem->outputCoords();
 9410:          double *out = (double *)((char *)res + idx_elem * 16);
 9411:          out[0] = coords.x;
 9412:          out[1] = coords.y;
 9413:          break;
 9414:       }
 9415:       case (int)VarCode::FaceIndices: {
 9416:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9417:          for (int j = 0; j < 4; j++)
 9418:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9419:          break;
 9420:       }
 9421:       case (int)VarCode::isdry:
 9422:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9423:          break;
 9424:       case (int)VarCode::w: {
 9425:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9426:          if (k >= 0)
 9427:             out[0] = elem->w[k];
 9428:          else
 9429:             for (int lev = 0; lev < nvrt; lev++)
 9430:                out[lev] = elem->w[lev];
 9431:          break;
 9432:       }
 9433:    }
 9434: }
