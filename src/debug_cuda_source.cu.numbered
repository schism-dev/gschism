 6680: 
 6681:    __global__ void computeVegetationAndDragParameters(void) {
 6682:       // Computes the vegetation and drag model parameters:
 6683:       // chi, \tilde\chi, beta, \breve{H}
 6684:       
 6685:       SIDE(side);
 6686: 
 6687:       side->hhat = 0.0;
 6688:       side->chi2 = 0.0;
 6689:       side->chi = 0.0;
 6690:       side->veg_c2 = 0.0;
 6691:       side->veg_beta = 0.0;
 6692: 
 6693:       if (side->isDry) return;
 6694: 
 6695:       const double htot = side->htot2();
 6696:       const int    kb   = side->kb;
 6697: 
 6698:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 6699: 
 6700:       const double veg_h     = side->veg_h();
 6701:       const double veg_nv    = side->veg_nv();
 6702:       const double veg_c     = side->veg_c();
 6703:       const double veg_beta  = side->veg_beta;
 6704:       const double veg_alpha = side->veg_alpha_vert_mean();
 6705: 
 6706:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 6707:       // Velocity magnitude at the bottom level
 6708:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 6709:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 6710:       side->chi2 = side->Cd()*vmag1;
 6711:       side->chi  = side->chi2;
 6712: 
 6713:       if constexpr(iveg != 0) {
 6714:          const Node *n1 = side->n1;
 6715:          const Node *n2 = side->n2;
 6716:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 6717:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 6718:       }
 6719: 
 6720:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 6721: 
 6722:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 6723:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 6724:       double magUa = 0.0;
 6725:       if constexpr(iveg != 0) {
 6726:          if (side->is3D() && veg_h > 0.0) {
 6727:             // 3D wet side with veg...
 6728: 
 6729:             double magUa = 0.0;
 6730:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 6731:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 6732: 
 6733:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 6734:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 6735:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 6736: 
 6737:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 6738:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 6739: 
 6740:                   // Velocity magnitude at the bottom (l) of the level
 6741:                   const double ul = length(side->u2[k]);
 6742: 
 6743:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 6744:                   magUa += Dz*0.5*(uh + ul);
 6745: 
 6746:                } // if HasVegetation
 6747:             } // for k
 6748:             const double ua = magUa/min(htot, veg_h); // Vertical average
 6749: 
 6750:             // Computes beta, used for computing the stress term at the top of the canopy.      
 6751:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 6752:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 6753:                const double zCpy = side->zTopCanopy();
 6754:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 6755:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 6756:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 6757:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 6758:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 6759:             } // if isSubmerged
 6760:          } // if is3D
 6761:       } // if iveg   
 6762: 
 6763:       // Computes the friction modified depth, \breve{H} in notes
 6764:       if (side->is2D()) { // 2D
 6765: 
 6766:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 6767:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 6768: 
 6769:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 6770: 
 6771:          side->hhat = htot*htot/fricH; 
 6772: 
 6773:       } else { // 3D
 6774:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 6775: 
 6776:          if constexpr(iveg != 0) {
 6777:             
 6778:             if (side->isSubmerged()) { 
 6779:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 6780:                side->hhat -= veg_c*Hhat_alpha;
 6781: 
 6782:             } else { // Emergent
 6783:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 6784:             }
 6785:          } // if iveg
 6786: 
 6787:          // Enforce positivity for 3D model
 6788:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6789:       } // if 3D
 6790: 
 6791:    }
 6792: 
 6793: 
 6794: 
 6795:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6796:    // Computes the density gradient between two elements, e1 and e2.
 6797:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6798:    // zero in the direction normal to the side. 
 6799:    // 
 6800:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6801:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6802:    //
 6803:    // Input:
 6804:    //    e1: Element
 6805:    //    e2: Neighbor element (or nullptr if boundary)
 6806:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6807:    //    k: Index of the half-level at which the density is interpolated
 6808:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6809:    // 
 6810:    // Output:
 6811:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6812:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6813: 
 6814:       if (e2 == nullptr || e2->isDry) {
 6815:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6816: 
 6817:          Side *side = e1->sides[j];
 6818:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6819:                  
 6820:          if constexpr(ics == 1) {
 6821:             vec = side->n; // Normal vector to the side
 6822:          } else {
 6823:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6824:             // IMPLEMENT THIS XXXXXX
 6825:             // !replace with xel, yel?
 6826:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6827:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6828:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6829:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6830:          } //ics
 6831:                    
 6832:          diffRho = 0.0;
 6833: 
 6834:       } else { //internal and wet
 6835:          if constexpr(ics==1) {
 6836:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6837: 
 6838:             // Vector from e1 to e2
 6839:             vec = e2->center - e1->center;
 6840: 
 6841:          } else { 
 6842:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6843:             // Remember that elem->center is in global coordinates
 6844:             // IMPLEMENT THIS XXXXXX
 6845:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6846:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6847:             //                   alow(j)=xctr2
 6848:             //                   bdia(j)=yctr2
 6849:          } // ics
 6850: 
 6851:          diffRho = rho2 - e1->demeanedDensity(k);
 6852:       }
 6853: 
 6854:    }
 6855: 
 6856:    __global__ void computeDensityCubicSplines(void) {
 6857:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6858: 
 6859:       ELEM(elem);
 6860: 
 6861:       if (elem->isDry) return;
 6862: 
 6863:       const int kb = elem->kb;
 6864: 
 6865:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6866:       if (elem->is2D()) {
 6867:          // In the 2D case, the density is constant at the prism level. 
 6868:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6869:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6870:       } else { //3D
 6871: 
 6872:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6873:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6874:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6875:          ///// XXXX CHECK INDICES!!!!!
 6876:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6877:       } // 2D/3D
 6878: 
 6879:    }
 6880: } // extern "C"
 6881: 
 6882: 
 6883: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6884: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6885: 
 6886:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6887: 
 6888:    const int kb  = elem->kb;
 6889:    const int kb2 = elem2->kb;
 6890: 
 6891:    // z-coordinate of prism of elem
 6892:    const double zp = elem->z_prism(k);
 6893: 
 6894:    double rho = 0.0;
 6895: 
 6896:    if (elem2->is2D()) {
 6897:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6898: 
 6899:    } else {  // 3D
 6900: 
 6901:       // eta_min may be < zmax
 6902:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6903:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6904: 
 6905:       // (Extrapolate density below bottom, we will fix it later)
 6906:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6907:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6908:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6909:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6910:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6911:    } // 2D/3D
 6912:      
 6913: 
 6914:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6915:    // Now we need to fix it.
 6916:    if (elem->z[k] < elem2->z[kb2]) {
 6917:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6918: 
 6919:       // There are two methods to adjust the density at the bottom of the element.
 6920:       // iunder_deep=0: 
 6921:       const double depth1 = abs(elem->z[kb]); // larger depth
 6922: 
 6923:       if (iunder_deep==0) {
 6924: 
 6925:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6926: 
 6927:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6928: 
 6929:       } else { // iunder_deep != 0
 6930: 
 6931:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6932: 
 6933:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6934: 
 6935:          //   Demeaned density at the same z coordinate as
 6936:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6937:          }
 6938: 
 6939:       } // if iunder_deep
 6940:    } // if elem->z[kb] < elem2->z[kb]
 6941: 
 6942:    return rho;
 6943: }
 6944: 
 6945: 
 6946: extern "C" {
 6947:    __global__ void computeDensityGradient(void) {
 6948: 
 6949:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6950:       if constexpr(ibc != 0) return;
 6951: 
 6952:          // Compute the horizontal density gradient at each element.
 6953:       // It works in two steps:
 6954:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6955:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6956:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6957:       //             gradRho.r1 = rho1 - rho0
 6958:       //             gradRho.r2 = rho2 - rho0
 6959:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6960:       // 
 6961:       //  NOTE: We use de-meaned densities.
 6962: 
 6963:       ELEM(elem);
 6964: 
 6965:       if (elem->isDry) return;
 6966: 
 6967:       const int kb  = elem->kb;
 6968:       const int i34 = elem->i34;
 6969: 
 6970:       for (int k = kb + 1; k < nvrt; k++) {
 6971:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6972:          //             gradRho.r1 = rho1 - rho0
 6973:          //             gradRho.r2 = rho2 - rho0
 6974:          int icount = 0;
 6975:          double sumRx = 0.0;
 6976:          double sumRy = 0.0;
 6977:          for (int j1=0; j1<i34; j1++) { 
 6978: 
 6979:             const int j2 = elem->nxq(j1 + 1);
 6980: 
 6981:             // Pairs of consecutive neighbor elements of elem
 6982:             const Element *e1 = elem->nghbElems[j1];
 6983:             const Element *e2 = elem->nghbElems[j2];
 6984: 
 6985:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6986:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6987:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6988: 
 6989:             // Compute the density difference and the vector from elem to e1 and e2
 6990:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6991:             double diffRho1, diffRho2;
 6992:             Vector2 vec1, vec2;
 6993:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6994:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6995: 
 6996:             const double rl1 = length(vec1);
 6997:             const double rl2 = length(vec2);
 6998:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6999: 
 7000:             const double delta = cross(vec1, vec2);
 7001:             const double sintheta = abs(delta)/(rl1*rl2);
 7002: 
 7003:             // To avoid problems, avoid elements with small angle between vectors
 7004:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 7005:             const bool validEq = (sintheta > sin_one_deg);
 7006: 
 7007:             if (validEq) {
 7008:                // Solve the system of equations to get the density gradient at elem
 7009:                icount++;
 7010:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 7011:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 7012:                sumRx += Rx;
 7013:                sumRy += Ry;
 7014:             }
 7015:          } // for j1
 7016: 
 7017:          // Compute the average density gradient at elem
 7018:          if (icount==0) {
 7019:            // Bad mesh quality; bail out with 0 b-cc
 7020:            elem->gradRho[k] = {0.0, 0.0};
 7021:          } else {
 7022:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 7023:          }
 7024: 
 7025:       } // for k
 7026: 
 7027:    }
 7028: 
 7029:    __global__ void computeBaroclinicTerm(void) {
 7030:    // Computes the baroclinic term at sides (at half levels).
 7031:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 7032:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 7033: 
 7034:       if (ibc == 1) return;
 7035: 
 7036:       SIDE(side);
 7037: 
 7038:       if (side->isDry) return;
 7039: 
 7040:       const Element *e1 = side->elems[0];
 7041:       const Element *e2 = side->elems[1]; 
 7042:       const int kb = side->kb;
 7043:       
 7044:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 7045: 
 7046:       // interpolates vertically the density gradient of the two elements at the half level/
 7047: 
 7048:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 7049:       int k2 = max(kb, nvrt / 2);
 7050: 
 7051:       // Starts the integration at the surface and goes down to the bottom
 7052:       side->bcc[nvrt-1] = {0.0, 0.0};
 7053:       for (int k = nvrt - 2; k >= kb; k--) {
 7054:       // For each prism level (from surface to bottom)...
 7055: 
 7056:          // For both elements, interpolate density gradient at the side's half level.
 7057:          // The gradient at the side is the average of the gradients at the elements.
 7058:          // w1, w2 are used to take into account boundary sides, with just one element.
 7059:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 7060:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 7061:          const double wsum = w1 + w2;
 7062:          w1 = w1/wsum;
 7063:          w2 = w2/wsum;
 7064:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 7065: 
 7066:          // Linear interpolation of both elements' density gradient at the shared side's level.
 7067:          Vector2 gradRho = {0.0, 0.0};
 7068:          if (e1 != nullptr && k > kb) {
 7069:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 7070:             
 7071:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 7072:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 7073:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7074: 
 7075:             // Grad(rho) vertically interpolated at the side's half level
 7076:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 7077: 
 7078:             // Projects the element density gradient to the side frame if needed.
 7079:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 7080: 
 7081:             // Adds the contribution of the density gradient at the side's half level
 7082:             gradRho += gradRho1*w1;
 7083:          }      
 7084:          if (e2 != nullptr && k > kb) {
 7085:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 7086:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 7087:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 7088:             
 7089:             // Grad(rho) vertically interpolated at the side's half level
 7090:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 7091: 
 7092:             // Projects the element density gradient to the side frame if needed.
 7093:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 7094: 
 7095:             // Adds the contribution of the density gradient at the side's half level
 7096:             gradRho += gradRho2*w2;
 7097:          }
 7098: 
 7099:          
 7100:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 7101:          // multiplied by -rampbc*(g/rho0) 
 7102:          const double grav3 = side->grav3();
 7103:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 7104: 
 7105:       } // for
 7106: 
 7107:    }
 7108: 
 7109: 
 7110: 
 7111:    __global__ void computeHorGradientAtSide(void) {
 7112: 
 7113:       // Compute the horizontal density gradient at each element.
 7114:       // It works in two steps:
 7115:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 7116:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 7117:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 7118:       //             gradRho.r1 = rho1 - rho0
 7119:       //             gradRho.r2 = rho2 - rho0
 7120:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 7121:       // 
 7122:       //  NOTE: We use de-meaned densities.
 7123: 
 7124:       SIDE(side);
 7125: 
 7126: 
 7127:       if (side->isDry) return;
 7128: 
 7129:       // Computes the gradient of the variables at the side center.
 7130:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 7131:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 7132:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 7133: 
 7134:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 7135:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 7136:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 7137:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 7138: 
 7139:    }
 7140: 
 7141: 
 7142:    __global__ void solveMomentumEquations(double time) {
 7143: 
 7144:       double alow[nvrt], cupp[nvrt], bdia[nvrt]; // a = low, c = up, b = diag
 7145:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 7146: 
 7147:       SIDE(side);
 7148: 
 7149:       if (side->isDry) 
 7150:       {
 7151:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 7152: 
 7153:          return;
 7154:       }
 7155: 
 7156:       const Node *n1 = side->n1;
 7157:       const Node *n2 = side->n2;
 7158: 
 7159:       const int kb = side->kb;
 7160: 
 7161:       const double veg_h = side->veg_h();
 7162:       const double grav3 = side->grav3();
 7163: 
 7164:       if (side->is2D()) {
 7165:          // Remember: Do not use htot2, which is updated.
 7166:          const double htot = side->htot1();
 7167:          const double hhat = side->hhat;
 7168: 
 7169:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 7170: 
 7171:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7172:          const Vector2 tau2 = side->tau();
 7173: 
 7174:          // hat_gam has units of m/s
 7175: 
 7176:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 7177:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 7178:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 7179: 
 7180:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 7181: 
 7182: 
 7183:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 7184: 
 7185:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 7186: 
 7187:       }
 7188:       else { // 3D
 7189: 
 7190:          // For 3D it is necessary to solve an implicit tridiagonal system.
 7191:          // 
 7192:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 7193:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 7194:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 7195:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 7196:          // k+1 and k.
 7197: 
 7198: 
 7199:          const int ndim = nvrt - kb;
 7200:          const double zTopCanopy = side->zTopCanopy();
 7201: 
 7202:          // Initialize the tridiagonal system
 7203:          for (int k = kb + 1; k < nvrt; k++) {
 7204:             
 7205:             const int kin = k - (kb + 1);
 7206: 
 7207:  
 7208:             alow[kin] = 0.0;
 7209:             cupp[kin] = 0.0;
 7210:             bdia[kin] = 0.0;
 7211: 
 7212:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 7213:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 7214: 
 7215:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 7216:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 7217:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 7218: 
 7219:             // First part: layers k, k+1
 7220:             if (k < nvrt - 1) {
 7221:                              
 7222:                if constexpr(iveg != 0) {
 7223: 
 7224:                   // If there is vegetation at this level...
 7225:                   if (zTopCanopy > side->zc[k]) {
 7226:                      // If the canopy is above the k layer...
 7227:                      
 7228:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 7229:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 7230:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 7231:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 7232: 
 7233:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 7234:                      const double vmag2 = length(ut2);
 7235:                      const double vmag1 = length(side->u2[k]);
 7236:                      const double vmag = 0.5*(vmag1 + vmag2);
 7237:                      
 7238:                      // Computes the vegetation alpha at the face center
 7239:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 7240: 
 7241:                      cff1 += veg_alpha_sd*dt*vmag;
 7242: 
 7243:                   } // if (zTopCanopy
 7244:                } // if iveg
 7245: 
 7246:                const double dzz = side->Dz(k + 1);
 7247:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k + 1)); // Vertical viscosity at the face center
 7248:                const double tmp = dt*dfz/dzz;
 7249:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7250: 
 7251:                cupp[kin] += cff1*dzz/6.0 - tmp;
 7252:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7253:             }
 7254: 
 7255: 
 7256:             // Second part: layers k-1, k
 7257:             if (k > kb + 1) {
 7258: 
 7259:                double cff1 = 1.0; //init \bar{c^k}
 7260: 
 7261:                if constexpr(iveg != 0) {
 7262:                   // If there is vegetation at this level...
 7263:                   if (zTopCanopy > side->zc[k-1]) {
 7264:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 7265:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 7266: 
 7267:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 7268: 
 7269:                      const double vmag2 = length(ut2);
 7270:                      const double vmag1 = length(side->u2[k-1]);
 7271:                      const double vmag = 0.5*(vmag1 + vmag2);
 7272: 
 7273:                      // Computes the vegetation alpha at the face center
 7274:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 7275:                      cff1 += veg_alpha_sd*dt*vmag;
 7276:                   } // if zTopCanopy
 7277: 
 7278:                } // if iveg
 7279: 
 7280:                const double dzz = side->Dz(k);
 7281:                const double dfz = 0.5*(side->dfv(k) + side->dfv(k - 1)); // Vertical viscosity at the face center
 7282:                const double tmp = dt*dfz/dzz;
 7283:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 7284: 
 7285:                alow[kin] += cff1*dzz/6.0 - tmp;
 7286:                bdia[kin] += cff1*dzz/3.0 + tmp;
 7287: 
 7288:             } else { // Bottom boundary
 7289:                // This occurs at the bottom, where the bottom drag is applied.
 7290: 
 7291:                bdia[kin] += dt*side->chi2; // XXXX
 7292: 
 7293:             } // if (k > kb + 1)
 7294: 
 7295: 
 7296:          } // for (int k
 7297: 
 7298: 
 7299: 
 7300:          // Computes the RHS.
 7301:          // -----------------
 7302: 
 7303:          //	BC to be imposed at the end.
 7304: 
 7305:          const Vector2 gradETP  = side->gradETP;
 7306:          const Vector2 gradPr   = side->gradPr;
 7307:          const Vector2 gradEta1 = side->gradEta1;
 7308:          const Vector2 gradEta2 = side->gradEta2;
 7309: 
 7310:          const Vector2 *btu = side->btu;
 7311:          const Vector2 *u2  = side->u2;
 7312:          const double coriolis = side->coriolis;
 7313:          const Vector2 *nuGradU = side->nuGradU;
 7314: 
 7315:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 7316:          for (int k = kb + 1; k < nvrt; k++) {
 7317:             const int kin = k - kb - 1;
 7318: 
 7319:             const double dz_0 = side->Dz(k);
 7320:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 7321: 
 7322:             rrhs[kin] = {0.0, 0.0};
 7323:             double dz = 0.0;
 7324: 
 7325:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 7326:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 7327:             if (k < nvrt  ) dz += dz_1;
 7328:             if (k > kb + 1) dz += dz_0;
 7329: 
 7330:             // Elevation gradient, atmospheric pressure and tidal potential
 7331:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 7332: 
 7333:             // Coriolis, advection, wind stress, and horizontal viscosity
 7334:             if (k < nvrt - 1) {
 7335: 
 7336: 
 7337:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 7338:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 7339:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 7340:                                                 
 7341: 
 7342:                //diff stress tensors 1006
 7343:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 7344:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 7345:                   assert(false && "Not implemented: itur == 5");
 7346:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 7347:                }
 7348:                // else assert(false && "itur # Not implemented");
 7349: 
 7350:             } else { // k == nvrt - 1 SURFACE
 7351:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 7352:                const Vector2 tau2 = side->tau();
 7353: 
 7354:                rrhs[kin] += dt*tau2;          
 7355: 
 7356:             } // if k<nvrt
 7357: 
 7358: 
 7359:             if (k > kb + 1) {
 7360:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 7361:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 7362:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 7363: 
 7364:                // diff stress tensors 1006
 7365:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 7366:                   assert(false && "Not implemented: itur == 5");
 7367:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 7368:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 7369:                }
 7370:                // else assert(false && "itur # Not implemented");
 7371: 
 7372: 
 7373:             } // if k>kbs + 1
 7374: 
 7375:             // Baroclinic
 7376:             Vector2 *bcc = side->bcc;
 7377:             if constexpr(ibc == 0) {
 7378:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 7379:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 7380: 
 7381:             } // if ibc==0
 7382: 
 7383:          } // k=kb + 1,nvrt
 7384: 
 7385: 
 7386:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 7387: 
 7388:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 7389:             const int kin = k - kb - 1;
 7390:    
 7391:             // Velocity is always clamped to maximum values
 7392:             side->u2[k] = clampVelocity(soln[kin]);
 7393:          } // k
 7394: 
 7395:       } // if side->is2D()
 7396:       
 7397: 
 7398:       // Impose velocity boundary condition at the bottom
 7399:       if constexpr(imm == 2) { // 3D bed deformation model
 7400:          double dep;
 7401:          Vector2 vel;
 7402: 
 7403:          assert(false && "Not implemented: imm == 2");
 7404:          //update_bdef(time, x0, y0, dep, vel);
 7405:          // side->u2[kb] = vel;
 7406: 
 7407:       } else { // imm = 0 or 1
 7408:          if (side->Cd() == 0.0) {
 7409:             side->u2[kb] = side->u2[kb + 1];
 7410: 
 7411:          } else if (side->is3D()) { // 3D no slip bottom   
 7412:             side->u2[kb] = {0.0, 0.0};
 7413: 
 7414:          }
 7415:           
 7416:       } // if imm
 7417: 
 7418:       // The velocities below the bottom level are set to zero
 7419:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 7420: 
 7421: 
 7422:    }
 7423: 
 7424: 
 7425:    __global__ void applyMomentumBC(void) {
 7426: 
 7427:       SIDE_BND(sideBnd);
 7428: 
 7429:       Side *side = sideBnd->side;
 7430:       const BoundarySegment *segment = sideBnd->segment;
 7431:       const Node *n1 = side->n1;
 7432:       const Node *n2 = side->n2;
 7433: 
 7434:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 7435: 
 7436:       const bool isLand = segment->isLand;
 7437:       const int ifltype = segment->ifltype;
 7438: 
 7439:       const int kb = side->kb;
 7440: 
 7441: 
 7442:       if (!isLand && ifltype != 0) {
 7443:          const Vector2 *ubc = sideBnd->ubc;
 7444:   
 7445:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 7446:             
 7447:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 7448:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 7449: 
 7450:             if (ifltype == -1) {
 7451:                // Flather 1
 7452: 
 7453:                const double depth = side->depth();
 7454: 
 7455:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 7456: 
 7457:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 7458: 
 7459:                side->u2[k] = vnorm*side->n;
 7460: 
 7461:             } else if (ifltype == -2) { // Discharge
 7462: 
 7463:                const double eta1 = side->eta1();
 7464:                const double eta2 = side->eta2();
 7465:                const double htot = side->htot2();
 7466: 
 7467:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 7468:                assert(false && "Not implemented: Discharge bc");
 7469:                // const double dischrg = discharge(eta1);
 7470:                const double dischrg = 0.0; // XXX REMOVE
 7471:                
 7472: 
 7473:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 7474: 
 7475:                const double vnorm = dischrg*eta2/htot;
 7476: 
 7477:                side->u2[k] = vnorm*side->n;
 7478: 
 7479:             }
 7480:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 7481:                const double vnorm = dot(side->u2[k], side->n);
 7482: 
 7483:                double rat;
 7484:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 7485:                else              rat = segment->vobc2; // outgoing
 7486: 
 7487:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 7488: 
 7489:             }
 7490:             else { // not Flather or 3D radiation
 7491: if (ifltype == 2) printf("XXXXX ubc: %f, %f\n", ubc[k].x, ubc[k].y);
 7492:                side->u2[k] = ubc[k];
 7493: 
 7494:             } // if (segment->ifltype...
 7495: 
 7496:          }
 7497: 
 7498:       }
 7499:       else if (isLand) { // if it is land boundary side
 7500: 
 7501:          if constexpr(islip == 0) { // free slip
 7502: 
 7503:             for (int k = kb; k < nvrt; k++) {
 7504: 
 7505:                const Vector2 t = side->t();
 7506:                const Vector2 n = side->n;
 7507: 
 7508:                double vnorm = 0.0; // for most cases
 7509:                const double vtan = dot(side->u2[k], t);
 7510:                
 7511:                side->u2[k] = vtan*t - vnorm*n;
 7512: 
 7513:             }
 7514: 
 7515:          } else { // no slip
 7516:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 7517: 
 7518:          }
 7519:       } // if (side segment type...
 7520: 
 7521:    }
 7522: 
 7523: 
 7524:    __global__ void shapiroFilter1(void) {
 7525:       // First step of the Shapiro filter (normally used if indvel<=0)
 7526:       // Computes the filtered values and stores them in bcc (as a temporary array).
 7527: 
 7528:       SIDE(side);
 7529: 
 7530:       // Only internal wet sides are processed
 7531:       if (side->isDry || !(side->isInternal())) return;
 7532: 
 7533:       const int kb = side->kb;
 7534: 
 7535:       for (int mm = 0; mm < niter_shap; mm++) {
 7536: 
 7537:          for (int k = kb + 1; k < nvrt; k++) {
 7538:             // WARNING: reusing bcc as a temporary array to store the suru values.
 7539:             Vector2 suru = {0.0, 0.0};
 7540: 
 7541:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 7542: 
 7543:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 7544: 
 7545:                int kin = k;
 7546:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 7547:                
 7548:                // Get the velocity at the neighbor's side.
 7549:                Vector2 nSideU2 = nSide->u2[kin];
 7550: 
 7551:                // Projects the velocity to the current side frame if needed.
 7552:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 7553: 
 7554:                suru += nSideU2;
 7555:             }
 7556: 
 7557:             // Reusing bcc as a temporary array to store the suru values.
 7558:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 7559: 
 7560:          }
 7561:       }
 7562:    }
 7563: 
 7564:    __global__ void shapiroFilter2(void) {
 7565:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 7566: 
 7567:       SIDE(side);
 7568: 
 7569: 
 7570:       if (side->isDry || !(side->isInternal())) return;
 7571: 
 7572:       const int kb = side->kb;
 7573: 
 7574:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 7575: 
 7576:       if (side->is2D()) {
 7577:          side->u2[kb + 1] = side->bcc[kb + 1];
 7578:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 7579: 
 7580:       } else {
 7581:          // 3D
 7582:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 7583:          
 7584:       }
 7585: 
 7586:    }
 7587: 
 7588: 
 7589:    __global__ void ul0UpdateZCoords(void) {
 7590:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 7591:       
 7592:       NODE(node);      
 7593: 
 7594: 
 7595:       if (false) { //node->isDry) { XXXXXXX
 7596: 
 7597:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 7598: 
 7599:          if constexpr(ivcor != 1) node->kb = 0;
 7600: 
 7601:       } else {
 7602: 
 7603:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 7604:          node->updateKb();
 7605: 
 7606:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 7607: 
 7608:       }
 7609: 
 7610:       // We use the temp.b field to store the previous state of isDry.
 7611:       node->tmp.b = node->isDry;
 7612: 
 7613:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 7614:       node->isDry = true;
 7615: 
 7616:    }
 7617: 
 7618:    __global__ void ul0ComputeDryElements(void)
 7619:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 7620:    {
 7621:       ELEM(elem);
 7622: 
 7623:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 7624: 
 7625:       elem->kb = 0;
 7626: 
 7627:       if (elem->isDry) return;
 7628: 
 7629: 
 7630:    //    if(elem->isDry2()) { // XXXX
 7631:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 7632:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 7633:    //        call parallel_abort(errmsg)
 7634:    //    }
 7635: 
 7636:       const Node *n1 = elem->nodes[0];
 7637:       const Node *n2 = elem->nodes[1];
 7638:       const Node *n3 = elem->nodes[2];  
 7639:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 7640: 
 7641:       // Computes element's kb as the minimum of the nodes' kb.
 7642:       const int kb1 = n1->kb;
 7643:       const int kb2 = n2->kb;
 7644:       const int kb3 = n3->kb;
 7645:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 7646: 
 7647: 
 7648:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 7649: 
 7650: 
 7651:       // Computes the element z as the mean of the nodes z.
 7652:       for (int k = elem->kb; k < nvrt; k++) {
 7653: 
 7654:          // Compute the element z as the mean of the nodes z.
 7655:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 7656:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 7657:          elem->z[k] /= elem->i34;
 7658: 
 7659:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 7660:       }
 7661:                   
 7662:    }
 7663: 
 7664:    __global__ void ul0ComputeDryNodes(void)
 7665:    // Updates node's isDry based on the elements' isDry. 
 7666:    {
 7667:       NODE(node);
 7668: 
 7669:       node->isDry = true;
 7670: 
 7671:       // A node is wet if at least one of the elements sharing it is wet.
 7672:       for (int j = 0; j < node->numElements; j++) {
 7673:          const Element *elem = node->elements[j];
 7674:          if (!elem->isDry) {
 7675:             node->isDry = false;
 7676:             break;
 7677:          }
 7678:       }
 7679: 
 7680:        
 7681:    }
 7682: 
 7683: 
 7684:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 7685:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 7686:    // node->tmp.b is true if the node was previously dry.
 7687:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 7688:    {
 7689:       NODE(node);
 7690:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 7691: 
 7692:       // Avoid this the first time step.
 7693:       if (it == iths) return;  
 7694: 
 7695:       const bool wasDry = node->tmp.b;
 7696: 
 7697: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 7698: 
 7699:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 7700: 
 7701:          for (int k=0; k < nvrt; k++) {
 7702: 
 7703:             Vector3 utmp={0.0, 0.0, 0.0};
 7704: 
 7705:             double ttmp=0.0;
 7706:             double stmp=0.0;
 7707:             int icount=0;
 7708:             for (int j = 0; j < node->numNodes; j++) {
 7709: 
 7710:                const Node *nbrNode = node->nodes[j];
 7711:                
 7712:                const bool wasNbrDry = nbrNode->tmp.b;
 7713: 
 7714:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 7715:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 7716: 
 7717:                   icount++;
 7718: 
 7719:                   // Assume small element size in wet/dry zone so pframes are close to each other
 7720:                   utmp += nbrNode->uvw2(k);
 7721:                   
 7722:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 7723:                   stmp += nbrNode->tracers[k].tracer[1]; 
 7724:                }
 7725:             }
 7726: 
 7727:             if (icount > 0) {
 7728:                const double inv_icount = 1.0/icount;
 7729:                utmp = inv_icount*utmp;
 7730:                node->u2[k]     = {utmp.x, utmp.y};
 7731:                node->w2[k]     = utmp.z;
 7732:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 7733:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 7734:             } else {
 7735:                node->u2[k] = {0.0, 0.0};
 7736:                node->w2[k] = 0.0;
 7737:                // Initialize tracers to 0.0??? XXXXX
 7738:             }
 7739:          }
 7740:       }
 7741:    }
 7742: 
 7743:   
 7744:    
 7745: 
 7746: 
 7747:    __global__ void ul0UpdateSides(int it, int iths) {
 7748:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 7749:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 7750:    // The dryness of the sides is updated in ul0UpdateSides2.
 7751: 
 7752:       SIDE(side);
 7753: 
 7754:       // A side is wet if and only if at least one of its elements is wet.
 7755:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 7756:  
 7757:       const Node *n1 = side->n1;
 7758:       const Node *n2 = side->n2;
 7759:      
 7760:       const int kb1 = n1->kb;
 7761:       const int kb2 = n2->kb;
 7762: 
 7763:       side->kb = 0; // default when dry
 7764: 
 7765:       if (isWet) {
 7766: 
 7767:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 7768: 
 7769:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 7770: 
 7771:          side->kb = min(kb1, kb2);
 7772: 
 7773:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 7774: 
 7775:          for (int k = side->kb; k < nvrt; k++) {
 7776:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 7777: 
 7778:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 7779: 
 7780:             // Compute velocity for re-wetted sides 
 7781:             if ((it != iths) && (side->isDry && isWet)) {
 7782: 
 7783:                Vector2 utmp={0.0, 0.0};
 7784: 
 7785:                int icount=0;
 7786: 
 7787:                // For all the sides on the two elements that share this side
 7788:                for (int j = 0; j < 2; j++) {
 7789:                   const Element *elem = side->elems[j];
 7790:                   if (elem == nullptr) continue;
 7791: 
 7792:                   for (int jj=0; jj < elem->i34; jj++) {
 7793:                      const Side *nSide = elem->sides[jj];
 7794:                      if (nSide->isDry) continue;
 7795: 
 7796:                      icount++;
 7797:                      utmp += nSide->u2[k];  
 7798:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7799:                   }
 7800:                }
 7801:                   
 7802:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7803:                if (icount > 0)  side->u2[k] = utmp/icount;
 7804:                else             side->u2[k] = {0.0, 0.0};
 7805:                   
 7806:             } // if ((it != iths) && (side->isDry && isWet))
 7807: 
 7808:          } // for k
 7809: 
 7810:       } // if isWet 
 7811:       
 7812: 
 7813: 
 7814:    }
 7815: 
 7816:    __global__ void ul0UpdateSides2(void) {
 7817:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7818:    
 7819:          SIDE(side);
 7820:    
 7821:          const Element *e1 = side->elems[0];
 7822:          const Element *e2 = side->elems[1];
 7823: 
 7824:          // A side is wet if and only if at least one of its elements is wet.
 7825:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7826: 
 7827:          // Update the side's dryness
 7828:          side->isDry = !isWet;
 7829: 
 7830:    }
 7831: 
 7832: 
 7833:    __global__ void zeroNodalVelocities(void) {
 7834:       NODE(node);
 7835: 
 7836:       for (int k = 0; k < nvrt; k++) {
 7837:          node->u2[k]   = {0.0, 0.0};
 7838:          node->w2[k]   = 0.0;
 7839:          node->utmp[k] = {0.0, 0.0};         
 7840:       }
 7841:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7842:    }
 7843:  
 7844: 
 7845:    __global__ void computeNodalVerticalVelocities1(void) {
 7846:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7847:    // Adds the element's vertical velocity times the element's area.
 7848:       ELEM(elem);
 7849: 
 7850:       for (int j = 0; j < elem->i34; j++) {
 7851:          Node *node = elem->nodes[j];
 7852: 
 7853:          for (int k = node->kb; k < nvrt; k++) {
 7854:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7855:          }
 7856:          atomicAdd(&(node->tmp.d), elem->area);
 7857:       }
 7858:    }
 7859: 
 7860:    __global__ void computeNodalVerticalVelocities2(void) {
 7861:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7862:    // Divides by the total area of the elements sharing the    node.
 7863:       NODE(node);
 7864: 
 7865: 
 7866:       const double invArea = 1.0 / node->tmp.d;
 7867:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7868: 
 7869:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7870:    }
 7871: 
 7872: 
 7873:    __global__ void computeNodalHorizontalVelocities1(void) {
 7874: 
 7875:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7876: 
 7877:       ELEM(elem);
 7878: 
 7879:       if (elem->isDry) return;
 7880: 
 7881:       const int kb = elem->kb;
 7882:       const bool isTri = elem->isTri();
 7883: 
 7884:       if constexpr(indvel <= 0) {
 7885:          // Assuming discontinous hvel.
 7886: 
 7887:          if (isTri) { // For triangles
 7888:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7889:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7890:             #pragma unroll
 7891:             for (int j = 0; j < 3; j++) {
 7892:                // For every node of the triangle...
 7893:                Node *node = elem->nodes[j];
 7894: 
 7895:                if (node->isDry) continue;
 7896: 
 7897:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7898:                const Side *s2 = elem->sides[(j + 1) % 3];
 7899:                const Side *s3 = elem->sides[(j + 2) % 3];
 7900: 
 7901:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7902: 
 7903:                atomicAdd(&(node->tmp.i), 1);
 7904: 
 7905:                for (int k = kb; k < nvrt; k++)  {
 7906:                   Vector2 s1u2 = s1->u2[k];
 7907:                   Vector2 s2u2 = s2->u2[k];
 7908:                   Vector2 s3u2 = s3->u2[k];
 7909: 
 7910:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7911:                   if constexpr(ics == 2) {
 7912:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7913:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7914:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7915:                   }
 7916: 
 7917:                   Vector2 u = s2u2 + s3u2 - s1u2; // u extrapolated linearly at node j.   
 7918:                   u = clampVelocity(u);
 7919:                   atomicAdd(&(node->utmp[k].x), u.x);
 7920:                   atomicAdd(&(node->utmp[k].y), u.y);
 7921: 
 7922:                }
 7923: 
 7924:             }
 7925:          }
 7926:          else { // For quads
 7927: 
 7928: 
 7929:             // Compute the bilinear coordinates of the center of each diagonal.
 7930:             double xi, eta;
 7931:             double shp13[4], shp24[4];
 7932:             Point2 x0, x1, x2, x3;
 7933:             elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 7934:             const Point2 p13 = 0.5 * (x0 + x2);   // Center of sides 1 & 3
 7935:             const Point2 p24 = 0.5 * (x1 + x3);   // Center of sides 2 & 4
 7936: 
 7937:             elem->inverseBilinearQuad(p13, xi, eta, shp13);
 7938:             elem->inverseBilinearQuad(p24, xi, eta, shp24);
 7939: 
 7940: 
 7941: 
 7942: 
 7943:             for (int k = kb; k < nvrt; k++) {
 7944: 
 7945:                //Each quad is split into two triangles. For each triangle we extrapolate as we did for triangles.
 7946:                Vector2 sideU[4];
 7947:                #pragma unroll
 7948:                for (int j = 0; j < 4; j++) {
 7949:                   Vector2 u = elem->sides[j]->u2[k];
 7950:                   if constexpr(ics == 2) u = elem->sides[j]->frame.projHorVec(u, elem->frame);
 7951:                   sideU[j] = u;
 7952:                }
 7953: 
 7954:                Vector2 ud1 = shp13[0]*sideU[0] + shp13[1]*sideU[1] + shp13[2]*sideU[2] + shp13[3]*sideU[3];
 7955:                Vector2 ud2 = shp24[0]*sideU[0] + shp24[1]*sideU[1] + shp24[2]*sideU[2] + shp24[3]*sideU[3];
 7956: 
 7957:                Vector2 ufg0 = clampVelocity(sideU[2] + sideU[3] - ud2);  // node 1: sides 3,4
 7958:                Vector2 ufg1 = clampVelocity(sideU[0] + sideU[3] - ud1);  // node 2: sides 1,4
 7959:                Vector2 ufg2 = clampVelocity(sideU[0] + sideU[1] - ud2);  // node 3: sides 1,2
 7960:                Vector2 ufg3 = clampVelocity(sideU[1] + sideU[2] - ud1);  // node 4: sides 2,3
 7961:                const Vector2 ufg[4] = {ufg0, ufg1, ufg2, ufg3};
 7962:                #pragma unroll
 7963:                for (int j = 0; j < 4; j++) {
 7964:                   Node *node = elem->nodes[j];
 7965:                   if (node->isDry) continue;
 7966: 
 7967:                   if (k == kb) atomicAdd(&(node->tmp.i), 1);
 7968:                   atomicAdd(&(node->utmp[k].x), ufg[j].x);
 7969:                   atomicAdd(&(node->utmp[k].y), ufg[j].y);
 7970:                }
 7971:             }
 7972: 
 7973:          }
 7974: 
 7975:       }
 7976:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7977:       
 7978:    }
 7979: 
 7980: 
 7981:    __global__ void computeNodalHorizontalVelocities2(void) {
 7982:       NODE(node);
 7983: 
 7984:       const int nodeCount = node->tmp.i;
 7985: 
 7986:       if (nodeCount == 0) 
 7987:       {
 7988:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7989:          return;
 7990:       }
 7991: 
 7992:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7993:       
 7994:       const int kb = node->kb;
 7995: 
 7996:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7997:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7998:       
 7999:       
 8000:    }   
 8001: 
 8002:  
 8003: 
 8004:    __global__ void resetVelocityOpenBndNodes(void) {
 8005:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 8006: 
 8007:       NODE_BND(nodebnd);
 8008: // printf("DDDDDDDDDD\n");  // XXXXXXX
 8009:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 8010:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 8011:       }
 8012: 
 8013:    }
 8014: 
 8015: 
 8016:    __global__ void setVelocityOpenBndNodes(void) {
 8017:    // For open boundary nodes sets their velocity to the imposed values.
 8018: 
 8019:       SIDE_BND(sidebnd);
 8020: 
 8021:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 8022:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 8023:          // to its segment to the average of the side velocity.
 8024: 
 8025:          for (int k = 0; k < nvrt; k++) {
 8026:             Node *n1 = sidebnd->side->n1;
 8027:             Node *n2 = sidebnd->side->n2;
 8028: 
 8029: 
 8030:             Vector2 &n1_u2 = n1->u2[k];
 8031:             Vector2 &n2_u2 = n2->u2[k];
 8032: 
 8033:             if (n1->nodeBnd->segment == sidebnd->segment) {
 8034:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 8035:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 8036:             }
 8037:             if (n2->nodeBnd->segment == sidebnd->segment) {
 8038:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 8039:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 8040:             }
 8041: 
 8042:          }
 8043: 
 8044:       }
 8045: 
 8046:    }
 8047: 
 8048: 
 8049:    __global__ void computeVerticalVelocity(void) {
 8050:       // Computes the vertical velocity at the (2D) element's centroid.
 8051:       // In this function we will be considering volumetric elements, with side faces and a 
 8052:       // bottom and a top face. We will call them SFs, BF and TF.
 8053:       // It computes the flux coming from BF and the SFs.
 8054:       // If the bed is moving, it takes that into account.
 8055:       // Since water is incompressible, the integral of the velocity times the normal vector
 8056:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 8057:       // and the BF is equal to the flux going out from the TF.
 8058:       // TF = - BF - sum(SFs).
 8059:       // It then computes the horizontal velocity at the center of TF.
 8060:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 8061:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 8062:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 8063: 
 8064:       ELEM(elem);
 8065: 
 8066:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 8067: 
 8068:       if (elem->isDry) return;
 8069: 
 8070:       const int kb = elem->kb;
 8071:       const bool isTri = elem->isTri();
 8072: 
 8073:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 8074: 
 8075:       // Compute the bottom velocity
 8076:       if constexpr(imm != 0) {
 8077:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 8078:       }
 8079: 
 8080: 
 8081:       double bottomArea3D;
 8082:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 8083: 
 8084:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 8085: 
 8086:       double topArea3D;
 8087: 
 8088:       // Bottom face flux
 8089:       double bottomFlux = 0.0;
 8090:       Vector2 u2meanBottom = {0.0, 0.0};
 8091:       const Vector2 gradh = elem->grad2(&Node::depth);
 8092:       if constexpr(imm==2) {
 8093:          Vector3 ubed;
 8094: 
 8095:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 8096:          // updateBDEF(ubed);
 8097:      
 8098:          // const double bflux0 = dot(ubed, elem_bottom_n);
 8099: 
 8100:          // elem->w[kb] += ubed.z;
 8101:       }
 8102:       else {
 8103: 
 8104:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 8105:   
 8106:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 8107:          // in the direction of motion.
 8108:          const double bottomW = - dot(gradh, u2meanBottom);  
 8109:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 8110: 
 8111:          // VElocity associated to the bed deformation
 8112:          double bedVelocity = 0.0;
 8113:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 8114: 
 8115:          elem->w[kb] = bedVelocity + bottomW; 
 8116: 
 8117:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 8118:          
 8119:       } // if imm
 8120: 
 8121:       // Compute w for kb+1 to nvrt-1
 8122:       for (int l = kb; l < nvrt - 1; l++) {
 8123: 
 8124:          // normal vector to the top face of the "volumetric" element (3D)
 8125:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 8126: 
 8127:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 8128:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 8129: 
 8130:          // Compute the total flux at the sides
 8131:          double sideFlux = 0.0;
 8132: 
 8133:          for (int j = 0; j < elem->i34; j++) {
 8134:             const Side *side = elem->sides[j];
 8135:             const int kbs = side->kb;
 8136:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 8137:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 8138:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 8139: 
 8140:             // The area is "clamped" meaning that it takes kb into account.
 8141:             const double sideArea = side->areaClamped(l);
 8142: 
 8143:             const double sign = elem->ssign[j]; 
 8144: 
 8145:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 8146:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 8147:          }
 8148:          
 8149:          // Compute the horizontal velocity at the center of the top face as an average of the 
 8150:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 8151:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 8152: 
 8153:          // The flux at the top ace can be computed from the other flows.
 8154:          // All fluxes are in directions into the prism.
 8155:          const double topFlux = - sideFlux - bottomFlux;
 8156: 
 8157:          // Flux at the top face due to the horizontal velocities only
 8158:          // topFlux = topHorizontalFlux + topVerticalFlux
 8159:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 8160: 
 8161:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 8162:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 8163: 
 8164:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 8165: 
 8166:          bottomFlux = -topFlux;
 8167:          
 8168:       }
 8169: 
 8170:    }  
 8171: 
 8172: 
 8173: 
 8174: 
 8175: 
 8176: 
 8177: 
