 2972: 
 2973: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2974:    // Checks if a side in on the boundary
 2975:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2976: 
 2977:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2978:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2979: 
 2980:    // Indices of the nodes that form the side
 2981:    const int n1 = side.n1->idx;
 2982:    const int n2 = side.n2->idx;
 2983:    isLand = false;
 2984:    
 2985: 
 2986:    // Check if the side is on a land boundary
 2987:    for (int i = 0; i < nland; i++) {
 2988:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2989:          // Consecutive nodes in the land boundary segment
 2990:          const int b1 = ilnd[i + j*nland];
 2991:          const int b2 = ilnd[i + (j + 1)*nland];
 2992: 
 2993:          assert(b1 != -1 && b2 != -1);
 2994: 
 2995:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2996:             
 2997:             isLand = true;
 2998:             return i;
 2999:          }
 3000:       }
 3001:    }
 3002: 
 3003:    // Check if the side is on an open boundary
 3004:    for (int i = 0; i < nope; i++) {
 3005:       for (int j = 0; j < nond[i] - 1; j++) {
 3006:          // Consecutive nodes in the open boundary segment
 3007:          const int b1 = iond[i + j*nope];
 3008:          const int b2 = iond[i + (j + 1)*nope];
 3009: 
 3010:          assert(b1 != -1 && b2 != -1);
 3011: 
 3012:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3013:             isLand = false;
 3014:             return i;
 3015:          }
 3016:       }
 3017:    }
 3018: 
 3019:    return -1;
 3020: }
 3021: 
 3022: 
 3023: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3024:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3025:                                     double *wind_rotate_angle, 
 3026:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3027:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3028:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3029:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3030:                                     double *drag, double *roughness, double *rmanning) {
 3031: 
 3032:    NODE(pnode);  
 3033:    const int i = idx_node;
 3034:    Node &node(*pnode);
 3035: 
 3036:    node.idx = i;
 3037: 
 3038:    const int idxNodeStart = nodeNeighNodesStart[i];
 3039:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3040:    node.numNodes = idxNodeEnd - idxNodeStart;
 3041:    node.nodes = nodeNeighNodes + idxNodeStart;
 3042:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3043: 
 3044: 
 3045: 
 3046:    const int idxElemStart = nodeNeighElemsStart[i];
 3047:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3048:    node.numElements = idxElemEnd - idxElemStart;
 3049:    node.elements = nodeNeighElems + idxElemStart;
 3050: 
 3051: 
 3052:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3053:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3054:       const int partNode = localNodePart[idxNodeGlobal]; 
 3055:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3056: 
 3057:       Node *node_ptr = nodes[partNode] + idxNode;
 3058:       
 3059:       nodeNeighNodes[idx] = node_ptr;
 3060:    }
 3061: 
 3062: 
 3063:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3064:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3065:       const int partElem = localElemPart[idxElemGlobal];
 3066:       const int idxElem  = localElemIndices[idxElemGlobal];
 3067: 
 3068:       Element *elem_ptr = elems[partElem] + idxElem;
 3069: 
 3070:       nodeNeighElems[idx] = elem_ptr;
 3071:    }      
 3072: 
 3073:    node.wind_angle = wind_rotate_angle[i];
 3074: 
 3075: 
 3076:    node.p.x   = node_coords[i * 3];
 3077:    node.p.y   = node_coords[i * 3 + 1];
 3078:    node.depth = node_coords[i * 3 + 2];
 3079: 
 3080:    if (use_ll) {
 3081:    node.lon = node_coords_ll[i * 2    ]*deg2rad;
 3082:    node.lat = node_coords_ll[i * 2 + 1]*deg2rad;
 3083:    }
 3084: 
 3085: 
 3086:    node.numSides = 0;
 3087: 
 3088:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3089:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3090:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3091:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3092:    else assert(false && "populateNodes: selected nchi not implemented.");
 3093:    
 3094:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3095:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3096: 
 3097:    
 3098:    // Links the node to the boundary information
 3099:    if (isbnd[i] >= 0) {
 3100:      
 3101:       // Get the index of the node boundary
 3102:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3103: 
 3104:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3105:       node.nodeBnd->node = &node;
 3106: 
 3107:       node.nodeBnd->sideBnd1 = nullptr;
 3108:       node.nodeBnd->sideBnd2 = nullptr;
 3109: 
 3110:       if (isbnd[i]>=0) {
 3111: 
 3112:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3113:          
 3114:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; XXXXX KKKKK
 3115:          node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 3116: 
 3117:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3118:          node.nodeBnd->segment->clen  = nan("1");
 3119:          node.nodeBnd->segment->carea = nan("1");
 3120: 
 3121:       }
 3122:    } else {
 3123: 
 3124:       node.nodeBnd = nullptr; // For internal nodes
 3125: 
 3126:       if (isbnd[i] == landSegment) {
 3127:          node.nodeBnd = &landBoundaryNode;
 3128:          node.nodeBnd->segment = &landBoundarySegment;
 3129:       }
 3130:       
 3131:    }
 3132:    
 3133:    // XXXX GAUSSIAN HILL VELOCITIES
 3134: #ifdef GAUSSIAN_HILL_VELOCITIES
 3135:       if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3136:       constexpr double rot_per = 3000.0;
 3137:       constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3138:       for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3139:    // XXXXX
 3140: #endif
 3141: 
 3142: }
 3143: 
 3144: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3145:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3146:                                     double *wind_rotate_angle,   
 3147:                                     int *isdel, int *isidenode, int *isbnd,
 3148:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3149:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3150:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3151:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3152:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3153:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3154:                                     double *drag, double *roughness) {
 3155: 
 3156: 
 3157:    SIDE(pside);
 3158:    Side &side(*pside);
 3159:    const int i = idx_side;
 3160: 
 3161:    side.idx = i;  
 3162:    
 3163:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3164:    const double fc   = 2.0*omega_e*sin(sfea0);
 3165:    const double beta = 2.0*omega_e*cos(sfea0);
 3166: 
 3167:    // finding the pointer to the nodes that form the side
 3168:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3169:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3170: 
 3171:    const int locidx_n1 = localNodeIndices[idx_n1];
 3172:    const int locidx_n2 = localNodeIndices[idx_n2];
 3173:    const int part_n1 =   localNodePart[idx_n1];
 3174:    const int part_n2 =   localNodePart[idx_n2];
 3175: 
 3176:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3177:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3178: 
 3179:    // Counts the number of sides connected to each node
 3180:    side.n1->numSides++;
 3181:    side.n2->numSides++;
 3182: 
 3183:    // Normal, unitary vector to the side
 3184:    side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 3185:    side.n = normalize(side.n);
 3186: 
 3187:    // Side boundary type
 3188:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3189:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3190: 
 3191:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3192:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3193:    {
 3194:       bool isLand = false;
 3195:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3196:       
 3197:       if (isbs > -1) {
 3198:          // assert(isLand || isbs>=0);
 3199:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3200: 
 3201:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3202: 
 3203:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3204:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3205: 
 3206:          assert (isLand == side.sideBnd->segment->isLand);
 3207: 
 3208:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3209:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3210:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3211: 
 3212:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3213:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3214:          
 3215:          side.sideBnd->side = &side;
 3216: 
 3217:       }
 3218:       else {
 3219:          side.sideBnd = nullptr;
 3220:       }
 3221:    }
 3222:    else 
 3223:    {
 3224:       side.sideBnd = nullptr;
 3225:    }
 3226: 
 3227: 
 3228:    // finding the pointer to the elements that share the side
 3229:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3230:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3231: 
 3232:    if (idx_e1 > -1) {
 3233:       const int locidx_e1 = localElemIndices[idx_e1];
 3234:       const int part_e1 =  localElemPart[idx_e1];
 3235:       side.elems[0] = elems[part_e1] + locidx_e1;
 3236: 
 3237:    }
 3238:    else {
 3239:       side.elems[0] = nullptr;
 3240:    }
 3241: 
 3242:    if (idx_e2 > -1) {
 3243:       const int locidx_e2 = localElemIndices[idx_e2];
 3244:       const int part_e2 =  localElemPart[idx_e2];
 3245:       side.elems[1] = elems[part_e2] + locidx_e2;
 3246:    }
 3247:    else {
 3248:       side.elems[1] = nullptr;
 3249:    }
 3250: 
 3251:    // Compute the center of the side
 3252:    side.center = 0.5*(side.n1->p + side.n2->p);
 3253: 
 3254:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 3255:    side.shapiro = shapiro0;
 3256: 
 3257: #ifdef GAUSSIAN_HILL_VELOCITIES
 3258: // XXXX
 3259: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3260: constexpr double rot_per=3000.0;
 3261: constexpr double rot_f=0.0*2.0*pi/rot_per;
 3262: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 3263: // XXXXX      
 3264: #endif
 3265:    // Compute the z level at the center of the side
 3266:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 3267:    
 3268:    // Compute the length of the side
 3269:    const Vector2 vLen = side.n2->p - side.n1->p;
 3270:    side.len = sqrt(dot(vLen, vLen));
 3271: 
 3272: 
 3273:    // Compute the Coriolis coefficient
 3274: 
 3275:    if constexpr(ncor == -1 || ncor == 0) {
 3276:       side.coriolis = coricoef;
 3277:    }
 3278:    else {
 3279:       const double sphi = side.lat();  // Latitude at the center of the side
 3280: 
 3281: // XXXXXX ERROR WHEN use_ll is false??????
 3282:       if constexpr(ics == 1) {
 3283:          // XXXXXXX
 3284:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3285:       }
 3286:       else {
 3287:          side.coriolis = 2.0*omega_e*sin(sphi);
 3288:       }
 3289: 
 3290:    }
 3291: }
 3292: 
 3293: 
 3294: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 3295:    double *node_coords, double *node_coords_ll, bool use_ll,
 3296:    double *wind_rotate_angle,   
 3297:    int *isdel, int *isidenode, int *isbnd,
 3298:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3299:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3300:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3301:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3302:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3303:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 3304:    double *drag, double *roughness) {
 3305: 
 3306:    ELEM(pelem);
 3307:    Element &elem(*pelem);
 3308:    const int i = idx_elem;
 3309: 
 3310:    elem.idx = i;
 3311: 
 3312:    for (int j = 0; j < i34[i]; j++) {
 3313:       const int idxNode = elnode[i*4 + j];  
 3314:       const int idxSide = elside[i*4 + j];
 3315:       
 3316:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3317:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3318: 
 3319:       // Find the neighboring element  
 3320:       if (elem.sides[j]->elems[0] == &elem) {
 3321:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 3322:       }
 3323:       else {
 3324:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 3325:       }
 3326:       
 3327:    }
 3328: 
 3329:    elem.i34 = i34[i];
 3330: 
 3331:    // Compute the centroid of the element and its depth
 3332:    Vector2 center = {0.0, 0.0};
 3333:    elem.depth = 0.0;
 3334:    for (int j = 0; j < i34[i]; j++) {
 3335: 
 3336:       center += elem.nodes[j]->p/i34[i];
 3337:       elem.depth  += elem.nodes[j]->depth/i34[i];
 3338:    }
 3339:    elem.center = center;
 3340: 
 3341:    
 3342:    // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3343:    // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3344: 
 3345:    elem.area = elem.computeSignedArea(); 
 3346:    elem.radius = sqrt(elem.area)/pi; 
 3347:    
 3348:    // Determines which way the normal vector to each side is oriented.
 3349:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3350:    for (int j = 0; j < i34[i]; j++)  
 3351:    {
 3352:       if (elem.sides[j]->elems[0] == &elem) {
 3353:          elem.ssign[j] =  1.0;
 3354:       }
 3355:       else {
 3356:          elem.ssign[j] = -1.0;
 3357:       }
 3358: 
 3359:    }
 3360: 
 3361:    // Derivatives of shape functions
 3362:    //  For ics=2, this is done inside element/ll frame XXX
 3363:    //  For quads, the derivative is evaluated at centroid
 3364:    for (int j = 0; j < elem.i34; j++) {
 3365:       const double area = elem.area;
 3366:       const int id2 = elem.nxq(1 + j);
 3367:       const int id3 = elem.nxq(2 + j);
 3368:       const int id4 = elem.nxq(3 + j);
 3369:       if (elem.isTri()) {
 3370:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3371:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3372:          // da1/dx = (y1 - y2)/(2*area)
 3373:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3374:          const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3375:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3376:       }
 3377:       else  { // Quad; evaluate at centroid
 3378:          const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3379:          const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3380:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3381:       } // if Tri
 3382: 
 3383:    } // for j   
 3384:    
 3385:    
 3386: 
 3387: }
 3388: 
 3389: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 3390:                                             double *emo, double *efa, 
 3391:                                             double *umo, double *ufa, 
 3392:                                             double *vmo, double *vfa) {
 3393: 
 3394: 
 3395:    NODE_BND(nodeBnd);
 3396:    const int idx = idx_node_bnd;    
 3397: 
 3398:    nodeBnd->idx = idx;
 3399: 
 3400:    // Need to find the segment index and the index of the node on the segment
 3401:    int idxNode = -1;
 3402:    int iseg, i;
 3403:    for (iseg = 0; iseg < nope; iseg++) {
 3404:       // for each segment...
 3405:       for (i = 0; i < nond[iseg]; i++) {
 3406:          idxNode = iond[iseg + i*nope];
 3407:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 3408:          
 3409:       }
 3410:    }
 3411: 
 3412:    assert(iseg < nope && "iseg is out of bounds");
 3413: 
 3414: found: // Jumped here when the node was found
 3415: 
 3416:    nodeBnd->isEssentialBC = true;
 3417:    nodeBnd->elbc = 0.0;
 3418: 
 3419:    for (int jfr = 0; jfr < nbfr; jfr++) {
 3420: 
 3421:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 3422:       nodeBnd->efa[jfr] = efa[idx2];
 3423:       nodeBnd->emo[jfr] = emo[idx2];
 3424:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 3425:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 3426: 
 3427:    }
 3428:         
 3429: 
 3430: }
 3431: 
 3432: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3433:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3434:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3435:                 int *isdel, int *isidenode, int *isbnd,
 3436:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3437:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3438:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3439:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3440:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3441:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3442:                 double *drag, double *roughness,
 3443:                 double *emo, double *efa, 
 3444:                 double *umo, double *ufa, 
 3445:                 double *vmo, double *vfa) {
 3446: 
 3447:    // printf("Populating mesh for partition %d\n", partNum);
 3448: 
 3449:    // XXXXXX THIS function does almost nothing. 
 3450: 
 3451:    nbs = *sharedIdxSideBoundary + 1;
 3452:    nbp = *sharedIdxNodeBoundary + 1;
 3453: 
 3454:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3455: 
 3456: }
 3457: 
 3458: 
 3459: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3460:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3461:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3462: 
 3463: 
 3464:    NODE(node1);
 3465: 
 3466:  
 3467: // // Check bounds: ensure coeffMatrix is within allocated memory XXXX REMOVE
 3468: // const size_t max_elements = 63011136;
 3469: // const size_t offset = node1->coeffMatrix - mesh->coeffMatrixMem;
 3470: 
 3471: // if (offset < 0 || offset >= max_elements) {
 3472: 
 3473: //    printf("Offset is out of bounds: %llu, max_elements = %llu\n", 
 3474: //       (unsigned long long)offset, (unsigned long long)max_elements);
 3475: //    return;  // Out of bounds, skip
 3476: // }
 3477: 
 3478: // // Check if we have enough space for numNodes elements
 3479: // if (offset + node1->numNodes > max_elements) {
 3480: //    printf("Not enough space for numNodes elements: %llu, max_elements = %llu\n", 
 3481: //       (unsigned long long)(offset + node1->numNodes), (unsigned long long)max_elements);
 3482: //    return;  // Not enough space, skip
 3483: // }
 3484: 
 3485:    node1->clearMatrixRow();
 3486:    node1->qel = 0.0;
 3487: 
 3488:    // THIS IS FOR STRUCTURES XXX
 3489:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3490: 
 3491:    
 3492:    for (int j=0; j<node1->numElements; j++) {
 3493:       // For each element connected to the node...
 3494: 
 3495:       Element *elem = node1->elements[j];
 3496: 
 3497: 
 3498:       // Compute the average gravity
 3499:       const double grav3 = elem->mean(&Node::grav2);
 3500: 
 3501:       // Look at the documentation for the description of the terms in the following integrals
 3502: 
 3503:       // Integral I_1 
 3504:       // \bar{\breve{H}} 
 3505:       const double hhatb = elem->mean(&Side::hhat);        
 3506: 
 3507:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3508: 
 3509:       const int id1 = elem->nodeLocalIdx(node1); 
 3510:       const double area = elem->area;
 3511: 
 3512:       if (elem->isTri()) {
 3513: 
 3514:          // To clarify the notation in this section: 
 3515:          //   i stands for the node under consideration (node1)
 3516:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3517:          const int id2 = elem->nxq(1 + id1);
 3518:          const int id3 = elem->nxq(2 + id1);
 3519:          Node *node2 = elem->nodes[id2];
 3520:          Node *node3 = elem->nodes[id3];
 3521: 
 3522:          const Point2 x1 = node1->p;
 3523:          const Point2 x2 = node2->p;
 3524:          const Point2 x3 = node3->p;
 3525: 
 3526:          // integral of phi_i*phi_j
 3527:          const double ipp_ii = (1.0/6.0 )*area;
 3528:          const double ipp_ij = (1.0/12.0)*area;
 3529:          const double ipp_ik = (1.0/12.0)*area;
 3530: 
 3531:          // integral of [(grad phi_i) * (grad phi_j)]
 3532:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3533:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3534:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3535: 
 3536:          // Computes the different components of integral I_1 of each node with respect to node i.
 3537:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3538:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3539:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3540: 
 3541:          node1->addToSparseMatrix(node1, I1_ii);
 3542:          node1->addToSparseMatrix(node2, I1_ij); 
 3543:          node1->addToSparseMatrix(node3, I1_ik);
 3544: 
 3545:       }
 3546:       else { // Quad
 3547:          // XXX IMPLEMENT THIS
 3548:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3549: 
 3550:          // To clarify the notation in this section: 
 3551:          //   i stands for the node under consideration (node1)
 3552:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3553:          const int id2 = elem->nxq(1 + id1);
 3554:          const int id3 = elem->nxq(2 + id1);
 3555:          const int id4 = elem->nxq(3 + id1);
 3556:          Node *node2 = elem->nodes[id2];
 3557:          Node *node3 = elem->nodes[id3];
 3558:          Node *node4 = elem->nodes[id4];         
 3559: 
 3560:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3561:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3562:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3563:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3564:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3565: 
 3566:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3567:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3568:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3569:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3570:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3571: 
 3572:          // Computes the different components of integral I_1 of each node with respect to node i.
 3573:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3574:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3575:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3576:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3577: 
 3578:          node1->addToSparseMatrix(node1, I1_ii);
 3579:          node1->addToSparseMatrix(node2, I1_ij); 
 3580:          node1->addToSparseMatrix(node3, I1_ik);
 3581:          node1->addToSparseMatrix(node4, I1_il);
 3582:   
 3583: 
 3584: 
 3585:       
 3586:       } 
 3587: 
 3588:  
 3589:       // Integral I_4
 3590:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3591:       // Where
 3592:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3593: 
 3594:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3595:       // of U over the element.
 3596:       Vector2 Umean = {0.0, 0.0};
 3597:       for (int m=0; m<elem->i34; m++) {      
 3598:          const Side *side = elem->sides[m];
 3599: 
 3600:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3601:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3602:       }
 3603:       Umean = Umean/elem->i34;
 3604: 
 3605:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3606: 
 3607:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3608:       const double I_4_1 = dot(gradPhi_1, Umean);
 3609: 
 3610:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3611:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3612:      
 3613:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3614: 
 3615:       // Additional terms 
 3616:       double vnorm = 0.0;
 3617:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3618:          Vector3 ubed;
 3619:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3620: 
 3621:          Vector3 gradP = {0.0, 0.0, 1.0};
 3622:          for (int m=0; m < elem->i34; m++) {
 3623:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3624:            gradP += toVector3(gradP_2D, 0.0);
 3625:          }   
 3626:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3627:       } // imm==2
 3628: 
 3629:       if (elem->isTri()) {
 3630:          for (int l=0; l<3; l++) {
 3631:             double fac;
 3632: 
 3633:             Node *node = elem->nodes[l];
 3634: 
 3635:             fac = (node == node1) ? 2.0 : 1.0;
 3636:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3637:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3638:            
 3639:          }
 3640: 
 3641: 
 3642:          if (!elem->isDry) {
 3643:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3644: 
 3645:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3646: 
 3647:          }
 3648: 
 3649:       } // isTri
 3650:       else { // isQuad
 3651:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3652:          // for (int l=0; l<4; l++) {
 3653:          //   const Node *node = elem->nodes[l];
 3654: 
 3655:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3656:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3657: 
 3658:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3659:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3660:          // }
 3661: 
 3662:       } // isQuad
 3663: 
 3664: 
 3665:      node1->qel += (dt/elem->i34)*elem->vsource;
 3666:       
 3667: 
 3668:    } // for all elements connected to the node
 3669:    
 3670: 
 3671:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3672:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3673:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3674:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3675:       // If it is an open boundary node...
 3676: 
 3677:       // At least one open bnd side, maybe two
 3678:       for (int l=0; l<2; l++) { 
 3679: 
 3680:          // Gets each of the sides sharing the node. 
 3681:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3682: 
 3683:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3684:          
 3685: 
 3686:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3687:          if (sideBnd != nullptr) {
 3688:             // If the side is on a boundary...
 3689: 
 3690:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3691: 
 3692:             // Get the boundary segment
 3693:             const BoundarySegment *sideSegment = sideBnd->segment;
 3694:             const Side *side = sideBnd->side;
 3695: 
 3696:             // Integral I_3
 3697:             if (sideSegment->ifltype != 0) {
 3698:             // Natural or Flather b.c.
 3699: 
 3700:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3701:                // especially for Flather b.c.
 3702:                double ri3 = 0.0;
 3703:                if (!side->isDry) {
 3704:                   // If the side is not dry
 3705:                   
 3706:                   // Computes the side flux of (uth, vth)
 3707:                   double Vn = 0.0;
 3708:                   for (int k = side->kb; k<nvrt-1; k++) {
 3709:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3710:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3711: 
 3712:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3713:                   }
 3714: 
 3715:                   ri3 = 0.5*side->len*Vn;
 3716:                }
 3717: 
 3718:                if (sideSegment->ifltype == -1) { // Flather 1
 3719: 
 3720:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3721:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3722: 
 3723:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3724:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3725:                   
 3726:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3727:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3728: 
 3729:                } 
 3730:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3731:                   // Reset ri3
 3732:                   ri3 = 0.0;
 3733: 
 3734:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3735: 
 3736:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3737: 
 3738:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3739:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3740: 
 3741:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3742:                   node1->addToSparseMatrix(node1, con0*2.0);
 3743:                   node1->addToSparseMatrix(node2, con0);
 3744: 
 3745:                } // if Flather or Discharge
 3746: 
 3747:                node1->qel -= thetai*dt*ri3;
 3748: 
 3749: 
 3750:             } // I_3
 3751:           
 3752: 
 3753:             // Integral I_5
 3754:             if(!side->isDry) {
 3755: 
 3756:                const double Unbar = dot(side->U, side->n);
 3757:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3758: 
 3759:             } // I_5
 3760: 
 3761:          } // if is boundary side
 3762: 
 3763:       } // for l
 3764: 
 3765:    } // if isbnd
 3766: 
 3767: 
 3768: }
 3769: 
 3770: 
 3771: 
 3772: extern "C" {
 3773:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3774:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3775:                                   int* indices, int* indptr) {
 3776: 
 3777:       NODE(node);
 3778:       
 3779:       const int idx = node->idx;
 3780:       
 3781:       // Computes the index in the nzz array      
 3782:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3783: 
 3784: 
 3785:       indptr[idx] = nzzIdx;
 3786:       indices[nzzIdx] = idx;
 3787: 
 3788:       data_d[nzzIdx]    = node->coeffDiag;
 3789:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3790: 
 3791:       diag_d[idx] = 1.0/node->coeffDiag;
 3792:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3793: 
 3794:       b_d[idx] = node->qel;
 3795:       b_f[idx] = (float)node->qel;
 3796: 
 3797:       for (int k = 0; k < node->numNodes; ++k) {
 3798:          const Node* nb = node->nodes[k];
 3799: 
 3800:          const int j = nb->idx;
 3801: 
 3802:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3803:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3804: 
 3805:          indices[nzzIdx + k + 1] = j;
 3806:       }
 3807: 
 3808: 
 3809:    }
 3810: 
 3811: 
 3812: 
 3813:    __global__ void solverCopyResult(double* x) {
 3814:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3815:       NODE(node);
 3816:       const int idx = node->idx;
 3817: 
 3818:       node->mX = x[idx];
 3819:    }
 3820: 
 3821: 
 3822:    __global__ void rollUpElevation(void) {
 3823: 
 3824:       NODE(node);
 3825: 
 3826:       node->eta1 = node->eta2;
 3827: 
 3828:    }
 3829: 
 3830: 
 3831:    __global__ void backtrackAllNodes(void) {
 3832: 
 3833:       // max/min # of sub-divisions
 3834:       const int ndelt_max = max(1.0, dt/dtb_min);
 3835:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3836: 
 3837:       // Removed all references to swild98 XXX
 3838:       // swild98=0.d0 !init
 3839: 
 3840: 
 3841:       SIDE(side);
 3842: 
 3843:       const int kb = side->kb;
 3844: 
 3845: 
 3846:       // Initialize btrack velocities to the actual velocities at the side 
 3847:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3848: 
 3849:       if (side->isDry) return;
 3850: 
 3851: 
 3852:       // Checks that at least one element is not dry
 3853:       const Element *elem1 = side->elems[0];
 3854:       const Element *elem2 = side->elems[1];
 3855: 
 3856: 
 3857:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3858:       
 3859:       // XXXXXX
 3860:       // !swild_tmp to store global coord. of the starting side
 3861:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3862:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3863:       // !Use sframe2 
 3864:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3865: 
 3866: 
 3867:       for (int k = kb; k < nvrt; k++) {
 3868:       //  Initialize (xt,yt,zt), nnel and vel.
 3869:       //  For ics=2, the coordinates are in local frames
 3870:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3871: 
 3872: 
 3873:          const int iadvf = side->iadv();  // Advection flag
 3874: 
 3875:          Point3 xt;
 3876:          if constexpr(ics==1) {
 3877:             xt = side->center3D(k); 
 3878:          }
 3879:          else // lat/lon; in side lat/lon frame
 3880:          {
 3881:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3882:          // XXX IMPLEMENT THIS
 3883:       //          xt=0.d0
 3884:       //          yt=0.d0
 3885:       //          !centroid coord. for nudging
 3886:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3887:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3888:          }  // ics
 3889: 
 3890: 
 3891: 
 3892:          // If on land or open boundary...
 3893:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3894:          
 3895:          const double vmag = length(side->u2[k]);
 3896: 
 3897:          if (vmag <= velmin_btrack) {
 3898:             // No activity 
 3899: 
 3900:             side->btu[k] = side->u2[k];
 3901:             
 3902:          } else {  // do btrack
 3903: 
 3904:             // Compute number of sub-divisions based on local gradients 
 3905:             // XXX IS THIS NECESSARY?
 3906:             double suma = 0.0;
 3907:             int icount = 0;
 3908:             for (int ii=0; ii<2; ii++) {
 3909: 
 3910:                const Element *elem = side->elems[ii];
 3911:                  
 3912:                if (elem == nullptr) continue;
 3913: 
 3914:                icount++;
 3915: 
 3916:                // Not strictly along z; in ll frame for ics=2
 3917: 
 3918:                double utmp[4];
 3919:                double vtmp[4];
 3920:                for (int jj = 0; jj < elem->i34; jj++) {
 3921: 
 3922:                   const Node *node = elem->nodes[jj];
 3923: 
 3924:                   if constexpr(ics==1) {
 3925:                      utmp[jj] = node->u2[k].x;
 3926:                      vtmp[jj] = node->u2[k].y;  
 3927:                   } else {
 3928:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3929:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3930:                   }
 3931:                } // for jj
 3932: 
 3933:                const Vector2 grad_u = elem->grad2(utmp); 
 3934:                const Vector2 grad_v = elem->grad2(vtmp);
 3935: 
 3936:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3937:             } // for ii
 3938: 
 3939:             assert(icount > 0 && "Impossible 77");
 3940: 
 3941:             // '4' is somewhat arbitrary
 3942:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3943: 
 3944:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3945:          
 3946: 
 3947:             Vector3 u_int = {0.0, 0.0, 0.0};
 3948: 
 3949:             side->btrack(k, dt, dtbk, u_int);
 3950:             side->btu[k] = toVector2(u_int);
 3951:                
 3952:          } // if vmag (do backtrack)
 3953: 
 3954:       } // for k=kb,nvrt-1
 3955: 
 3956:    }
 3957: 
 3958: } // extern "C"
 3959: 
 3960: template<int nc>
 3961: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3962: 
 3963: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3964: //
 3965: // a,b,c,rhs: input vectors and are not modified by this program.
 3966: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3967: // rhs is the r.h.s.
 3968: // n: actual rank of the system.
 3969: // rows in u() and rhs();
 3970: // u: output with nc columns (transposed to rows)
 3971: // gam: a working array.
 3972: //
 3973: // NOTES:
 3974: // This is a template function that allows for different numbers of columns in the rhs vector.
 3975: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3976: 
 3977:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3978:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3979: 
 3980:    double bet = b[0];
 3981:    if constexpr (nc == 1) {
 3982:       u[0] = rhs[0]/bet;
 3983:    } else {
 3984:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3985:    }
 3986: 
 3987:    for (int j = 1; j < n; j++) {
 3988:       gam[j] = c[j - 1]/bet;
 3989:       bet = b[j] - a[j]*gam[j];
 3990: 
 3991:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3992: 
 3993:       if constexpr (nc == 1) {
 3994:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3995:       } else {
 3996:          for (int l = 0; l < nc; l++) {
 3997:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3998:          }
 3999:       }
 4000:    }
 4001: 
 4002:    // Back-substitution
 4003:    for (int j = n - 2; j >= 0; j--) {
 4004:       if constexpr (nc == 1) {
 4005:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4006:       } else {
 4007:          for (int l = 0; l < nc; l++) {
 4008:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4009:          }
 4010:       }
 4011:    }
 4012: }
 4013: 
 4014: 
 4015: 
 4016: // Helper function that contains the core algorithm
 4017: template<typename XAccessor, typename YAccessor>
 4018: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4019:                                     double  yp_top, double  yp_bot, 
 4020:                                     CubicSpline &spline) {
 4021:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4022:    // 
 4023:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4024:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4025:    //
 4026:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4027:    // 
 4028:    // Inputs: 
 4029:    //            n: dimension for x etc; # of data pts (>=2);
 4030:    //            getX, getY: functions to access x,y coordinates
 4031:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4032:    //     Output: 
 4033:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4034: 
 4035:    const int n = k2 - k1 + 1;
 4036:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4037: 
 4038:    // Allocate memory for the splines
 4039:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4040:    spline.x   = new double[n];
 4041:    spline.y   = new double[n];
 4042:    spline.yp  = new double[n];
 4043:    spline.ypp = new double[n];
 4044: 
 4045:    for (int k=k1; k<=k2; k++) {
 4046:       spline.x[k] = getX(k);
 4047:       spline.y[k] = getY(k);
 4048:    }
 4049: 
 4050:    // This is to simplify expressions later
 4051:    double *x = spline.x;
 4052:    double *y = spline.y;
 4053: 
 4054:    double *a = nullptr;
 4055:    double *b = nullptr;
 4056:    double *c = nullptr;
 4057:    double *gam = nullptr;
 4058:    double *rhs = nullptr;
 4059:    
 4060: 
 4061:       a = new double[n];   // Lower diagonal
 4062:       b = new double[n];   // Diagonal
 4063:       c = new double[n];   // Upper diagonal
 4064:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4065:       rhs = new double[n]; // Right-hand side
 4066: 
 4067:    for (int k=k1; k<=k2; k++) {
 4068:       if (k == k1) {
 4069:          // Bottom level
 4070:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4071:          b[k] = (x[k+1] - x[k])/3.0;
 4072:          c[k] = b[k]/2.0;
 4073:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4074:       } else if (k == n - 1) {
 4075:          // Top level (surface)
 4076:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4077:          b[k] = (x[k] - x[k-1])/3.0;
 4078:          a[k] = b[k]/2.0;
 4079:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4080:       } else {
 4081:          // Intermediate levels
 4082:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4083:          b[k] = (x[k+1] - x[k-1])/3.0;
 4084:          a[k] = (x[k  ] - x[k-1])/6.0;
 4085:          c[k] = (x[k+1] - x[k  ])/6.0;
 4086:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4087:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4088:       }
 4089:    }
 4090: 
 4091:    // Solve the tridiagonal system
 4092:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4093:    
 4094:    spline.yp[k1] = yp_bot;
 4095:    spline.yp[k2] = yp_top;
 4096: 
 4097:    // Compute rest of 1st derivatives using the splines
 4098:    for (int k=k1+1; k<k2; k++) {
 4099:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4100:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4101:    }
 4102:    
 4103:    delete[] a;
 4104:    delete[] b;
 4105:    delete[] c;
 4106:    delete[] gam;
 4107:    delete[] rhs;
 4108: 
 4109: }
 4110: 
 4111: // Array version
 4112: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4113:                                 double y_top, double y_bot, 
 4114:                                 CubicSpline &spline) {
 4115:    auto getX = [x] (int k) { return x[k]; };
 4116:    auto getY = [y] (int k) { return y[k]; };
 4117:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4118: }
 4119: 
 4120: // Lambda version - allows custom access patterns
 4121: template<typename XFunc, typename YFunc>
 4122: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4123:                                 double y_top, double y_bot,
 4124:                                 CubicSpline &spline) {
 4125:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4126: }
 4127: 
 4128: 
 4129: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4130: {
 4131:    assert("Not implemented");
 4132: 
 4133:    return 0.0;
 4134: }
