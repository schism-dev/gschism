 3752: 
 3753:    __global__ void scaleGravity(double loadtide_coef) {
 3754: 
 3755: 
 3756:       NODE(node);
 3757: 
 3758:       // SAL option: scale gravity
 3759:       if constexpr(iloadtide==2) {  // simple const
 3760:          node->grav2 = grav*(1.0 - loadtide_coef);
 3761: 
 3762:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3763:         
 3764:           const double depth = max(node->depth, 0.0);
 3765:           const double tmp1 = sqrt(depth);
 3766:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3767:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3768:                              2.6969e-13*depth*depth*depth*tmp1;
 3769:           
 3770:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3771:           
 3772: 
 3773: 
 3774:           node->grav2 = grav*(1.0 - beta_bar);
 3775: 
 3776:       } else {  // iloadtide=0,1
 3777:         node->grav2=grav;
 3778: 
 3779:       }
 3780: 
 3781:    }
 3782: 
 3783: 
 3784:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3785: 
 3786:       NODE_BND(nodeBnd);
 3787: 
 3788:       Node *node = nodeBnd->node;
 3789: 
 3790:       node->ETP = 0.0;
 3791: 
 3792:       for (int j=0; j<ntip; j++) {
 3793: 
 3794:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3795:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3796:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3797: 
 3798:          if constexpr(iloadtide==1) { // loading tide
 3799:             assert(false && "Loading tide not implemented");
 3800:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3801:          }
 3802:          
 3803:       }
 3804:       
 3805:    }
