 3780:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3781: 
 3782:       NODE_BND(nodeBnd);
 3783: 
 3784:       Node *node = nodeBnd->node;
 3785: 
 3786:       node->ETP = 0.0;
 3787: 
 3788:       for (int j=0; j<ntip; j++) {
 3789: 
 3790:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3791:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3792:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3793: 
 3794:          if constexpr(iloadtide==1) { // loading tide
 3795:             assert(false && "Loading tide not implemented");
 3796:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3797:          }
 3798:          
 3799:       }
 3800:       
 3801:    }
