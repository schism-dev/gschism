  838:    // ------------------------------------------------------------------------------------------------
  839:    // These are functions that work on all nodes/sides of the element.
  840:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  841:    //
  842:    // An example of how to use these functions is:
  843:    //   
  844:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  845:    // 
  846:    // Where L is the level at which the field is to be interpolated. The field can be either
  847:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  848:    // There are different versions of getNodalValues for each of these cases.
  849: 
  850:    template<typename T>
  851:    __device__ __forceinline__ void getNodalValues(T Node::* field, T res[4]) const;
  852: 
  853:    template<typename T>
  854:    __device__ __forceinline__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const;
  855:   
