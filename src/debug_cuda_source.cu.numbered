 9048: __global__ void getStructSizes(int* sizes)  {
 9049:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 9050:       printf(">>>>>*** C++ 3 getStructSizes, sizes = %p\n", sizes);
 9051:       sizes[0] = (int)sizeof(Node);
 9052:       sizes[1] = (int)sizeof(Element);
 9053:       sizes[2] = (int)sizeof(Side);
 9054:       sizes[3] = (int)sizeof(NodeBoundary);
 9055:       sizes[4] = (int)sizeof(SideBoundary);
 9056:       sizes[5] = (int)sizeof(BoundarySegment);
 9057: }
