 2185:    
 2186:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2187:    // Project the vectors from the node frame to the element frame
 2188: 
 2189:  
 2190:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2191:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2192:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2193:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2194:       else          v[3] = Vector2();
 2195:    }
 2196: 
 2197:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2198:    // Project the vectors from the side frame to the element frame
 2199: 
 2200:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2201:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2202:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2203:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2204:       else          v[3] = Vector2();
 2205:    }
