 2390: __device__ void lock(int *mutex) {
 2391:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2392: }
 2393: 
 2394: __device__ void unlock(int *mutex) {
 2395:     atomicExch(mutex, 0);
 2396: }
