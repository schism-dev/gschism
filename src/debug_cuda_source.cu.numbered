 4360:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4361:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4362:                 int *isdel, int *isidenode, int *isbnd,
