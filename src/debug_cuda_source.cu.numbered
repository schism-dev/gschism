 7352: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7353: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7354: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7355: //                     iweno=.false.
 7356: //                   endif
 7357: //                 else !land or open bnd side
 7358: //                   !skip land bnd and outflowing open bnd, 
 7359: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7360: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7361: //                     !For outflow open bnd side, estimate mass in (open
 7362: //                     !side cannot be interface side)
 7363: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
