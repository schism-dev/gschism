 6821: 
 6822: // !           Wet elements with 3 wet nodes
 6823: //             do k=kbe(i)+1,nvrt
 6824: 
 6825: 
 6826: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 6827: //               dtb_by_bigv = dtb/bigv
 6828:     
 6829: // !             Advective flux
 6830: //               if (ntd_weno==1 .or. itd_weno==1) then
 6831: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 6832: //               else
