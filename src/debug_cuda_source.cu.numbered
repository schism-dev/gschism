 8086:       case (int)VarCode::eta:
 8087:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8088:          *sizeType = sizeof(double);
 8089:          break;
 8090:       case (int)VarCode::x:
 8091:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8092:          *sizeType = sizeof(Vector2);
 8093:          break;
 8094:       case (int)VarCode::z:
 8095:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 8096:          *sizeType = sizeof(double);
 8097:          break;
 8098:       case (int)VarCode::kb:
 8099:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8100:          *sizeType = sizeof(int);
 8101:          break;
 8102:       case (int)VarCode::isdry:
 8103:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8104:          *sizeType = sizeof(int);
 8105:          break;         
 8106:       case (int)VarCode::w:
 8107:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8108:          *sizeType = sizeof(double);
 8109:          break;
 8110:       case (int)VarCode::u:
 8111:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8112:          *sizeType = sizeof(Vector2);
 8113:          break;         
 8114:       default:
 8115:          *offset = -1;    
 8116:    }  
 8117:    
 8118: }
