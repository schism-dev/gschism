 3772: 
 3773: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3774:    // Computes the z coordinate at level k.
 3775:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3776:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3777:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3778:    // used 
 3779: 
 3780:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3781:    
 3782:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3783: 
 3784:    if (isDry2()) return 0.0;  
 3785: 
 3786:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3787: 
 3788:    if constexpr(ivcor == 2) {
 3789: 
 3790:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3791:       const double h_c = mesh->h_c;
 3792:       const double theta_f = mesh->theta_f;
 3793:       const double sinh_theta_f = mesh->sinh_theta_f;
 3794: 
 3795: 
 3796:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3797:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3798:       // once per time step/node. XXXX
 3799:       // CHECK: updateZCoordData
 3800: 
 3801:       //  To simplify comparisons, I define index versions of count variables.
 3802:       if      (k == ivrt)     return eta2; 
 3803:       else if (k == izlev)    return -hmod2;
 3804:       else if (k == kb)       return -depth;
 3805:       else if (k < izlev)     return mesh->ztot[k];
 3806:       else if (k > izlev) {
 3807:          const int ksig = k - izlev;
 3808: 
 3809:          if (hmod2 <= h_c) {
 3810:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3811: 
 3812:          } 
 3813:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3814:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3815:             assert(false && "compZCoord: invalid h_c\n");
 3816:          } 
 3817:          else {
 3818:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3819:                    h_c * mesh->sigma[ksig] + 
 3820:                    (hmod2 - h_c) * mesh->cs[ksig];
 3821:          }
 3822:       } else { 
 3823:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3824:       }
 3825: 
 3826:    }
 3827:    else {  // if constexpr(ivcor == 1)
 3828:       if (k <= kb)        return -depth; 
 3829:       else if (k == ivrt) return eta2;
 3830:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3831: 
 3832:    }
 3833:    
 3834:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3835:    return 0.0;
 3836: }
 3837: 
 3838: 
 3839: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3840:    // Computes the bottom drag Cd based on the selected nchi
 3841: 
 3842:    if constexpr(nchi == 0) {
 3843:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3844:       Cd = drag;  // Read from drag file
 3845: 
 3846:    } else if constexpr(nchi == 1) {
 3847:       // 
 3848: 
 3849:       bool ltmp = false; // for WBL iteration
 3850: 
 3851:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3852:       if (isDry || (rough == 0.0)) {
 3853:          Cd = 0.0;
 3854: 
 3855:       } else { //roughness >0 
 3856:          
 3857:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3858: 
 3859:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3860: 
 3861:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3862: 
 3863:       } // if rough
 3864: 
 3865:    } else if constexpr(nchi == -1) {
 3866:    // Manning 
 3867:  
 3868:       const double htot = max(hmin_man, htot2()); 
 3869:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3870: 
 3871:    } else {
 3872:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3873:       
 3874:    } // if nchi
 3875: 
 3876: }
 3877: 
 3878: 
 3879: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3880:    // Checks if a side in on the boundary
 3881:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3882: 
 3883:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3884:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3885: 
 3886:    // Indices of the nodes that form the side
 3887:    //
 3888:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3889:    const int n1 = side.n1->idx;
 3890:    const int n2 = side.n2->idx;
 3891:    isLand = false;
 3892:    
 3893: 
 3894:    // Check if the side is on a land boundary
 3895:    for (int i = 0; i < nland; i++) {
 3896:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3897:          // Consecutive nodes in the land boundary segment
 3898:          const int b1 = ilnd[i + j*nland];
 3899:          const int b2 = ilnd[i + (j + 1)*nland];
 3900: 
 3901:          assert(b1 != -1 && b2 != -1);
 3902: 
 3903:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3904:             
 3905:             isLand = true;
 3906:             return i;
 3907:          }
 3908:       }
 3909:    }
 3910: 
 3911:    // Check if the side is on an open boundary
 3912:    for (int i = 0; i < nope; i++) {
 3913:       for (int j = 0; j < nond[i] - 1; j++) {
 3914:          // Consecutive nodes in the open boundary segment
 3915:          const int b1 = iond[i + j*nope];
 3916:          const int b2 = iond[i + (j + 1)*nope];
 3917: 
 3918:          assert(b1 != -1 && b2 != -1);
 3919: 
 3920:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3921:             isLand = false;
 3922:             return i;
 3923:          }
 3924:       }
 3925:    }
 3926: 
 3927:    // Check that the nodes are not both on the boundary
 3928:    assert( (side.n1->nodeBnd == nullptr || side.n2->nodeBnd == nullptr)
 3929:         && "side not in ilnd/iond but both nodes are boundary" );
 3930: 
 3931:    return -1;
 3932: }
 3933: 
 3934: 
 3935: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3936:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3937:                                     double *wind_rotate_angle, 
 3938:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3939:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3940:                                     int16_t *nodePermutationSort, 
 3941:                                     int *localNodeNeighNodesStart, int *localNodeNeighElemsStart, 
 3942:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3943:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3944:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3945:                                     double *crs_data, 
 3946:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3947: 
 3948:    NODE(pnode);  
 3949:    const int i = idx_node;
 3950:    const int iglobal = globalNodeIndices[i];
 3951:    Node &node(*pnode);
 3952: 
 3953:    node.idx = iglobal;
 3954:    node.part = localNodePart[iglobal];
 3955: 
 3956:    // It is important to differentiate between the global and local "start" indices because they
 3957:    // play different, but related, roles in this code. The global "start" indices are used
 3958:    // for the CSR-like indexing of the node and element neighbor arrays in the "global"
 3959:    // (unpartitioned) mesh. The local "start" indices are used for the CSR-like indexing of the 
 3960:    // node and element neighbor arrays in the "local" (partitioned) mesh.
 3961:    const int idxNodeStart = nodeNeighNodesStart[iglobal];
 3962:    const int idxNodeEnd   = nodeNeighNodesStart[iglobal + 1];
 3963:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 3964:    node.numNodes = idxNodeEnd - idxNodeStart;
 3965:    node.nodes = nodeNeighNodes + idxNodeLocalStart;
 3966: 
 3967:    const int rowStart = idxNodeLocalStart + i; // +i is to account for the diagonal element.
 3968:    node.coeffRow = crs_data + rowStart; 
 3969: 
 3970: 
 3971: 
 3972:    const int idxElemStart = nodeNeighElemsStart[iglobal];
 3973:    const int idxElemEnd   = nodeNeighElemsStart[iglobal + 1]; 
 3974:    const int idxElemLocalStart = localNodeNeighElemsStart[i];
 3975:    node.numElements = idxElemEnd - idxElemStart;
 3976:    node.elements = nodeNeighElems + idxElemLocalStart;
 3977: 
 3978: 
 3979:    for (int idx = idxNodeStart, idxLocal = idxNodeLocalStart; idx < idxNodeEnd; idx++, idxLocal++) {
 3980:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3981:       const int partNode = localNodePart[idxNodeGlobal]; 
 3982:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3983: 
 3984:       Node *node_ptr = nodes[partNode] + idxNode;
 3985:       
 3986:       nodeNeighNodes[idxLocal] = node_ptr;
 3987:    }
 3988: 
 3989: 
 3990:    for (int idx = idxElemStart, idxLocal = idxElemLocalStart; idx < idxElemEnd; idx++, idxLocal++) {
 3991:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3992:       const int partElem = localElemPart[idxElemGlobal];
 3993:       const int idxElem  = localElemIndices[idxElemGlobal];
 3994: 
 3995:       Element *elem_ptr = elems[partElem] + idxElem;
 3996: 
 3997:       nodeNeighElems[idxLocal] = elem_ptr;
 3998:    }      
 3999: 
 4000:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4001:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4002: 
 4003:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4004: 
 4005:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4006:    if constexpr(ics == 1) {
 4007:       node.p.x   = node_coords[i * 3];
 4008:       node.p.y   = node_coords[i * 3 + 1];
 4009:       node.gz = 0.0;
 4010: 
 4011:       if (use_ll) {                                    // <-- add
 4012:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 4013:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 4014:       }  
 4015: 
 4016:    } else {
 4017:       const double lon = deg2rad*node_coords[i * 3];
 4018:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4019: 
 4020:       Point3 p = computeXYZfromLatLon(lat, lon);
 4021:       node.p = toVector2(p);
 4022:       node.gz = p.z;
 4023:       node.lon = lon;
 4024:       node.lat = lat;
 4025: 
 4026:       #ifdef USE_FRAMES
 4027:       node.setFrame(lat, lon);
 4028:       #endif
 4029: 
 4030: 
 4031:    }
 4032: 
 4033:    node.depth = node_coords[i * 3 + 2];
 4034: 
 4035:    node.numSides = 0;
 4036: 
 4037:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4038:    if      constexpr(nchi ==  0) node.drag     = drag[iglobal];
 4039:    else if constexpr(nchi ==  1) node.rough    = roughness[iglobal];
 4040:    else if constexpr(nchi == -1) node.rmanning = rmanning[iglobal];
 4041:    else assert(false && "populateNodes: selected nchi not implemented.");
 4042: 
 4043:    if constexpr(ivcor == 1) 
 4044:    {  
 4045:       node.kb = kb[iglobal];
 4046: 
 4047:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + iglobal*nvrt];
 4048:    }
 4049: 
 4050:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4051:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4052:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4053: 
 4054:    
 4055:    // Links the node to the boundary information
 4056:    if (isbnd[iglobal] >= 0) {
 4057:      
 4058:       // Get the index of the node boundary
 4059:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4060: 
 4061:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4062:       node.nodeBnd->node = &node;
 4063: 
 4064:       node.nodeBnd->sideBnd1 = nullptr;
 4065:       node.nodeBnd->sideBnd2 = nullptr;
 4066: 
 4067:       if (isbnd[iglobal]>=0) {
 4068: 
 4069:          node.nodeBnd->segment = &(localSegmentMem[isbnd[iglobal]]);
 4070:          
 4071:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4072:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4073: 
 4074:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4075:          node.nodeBnd->segment->clen  = nan("1");
 4076:          node.nodeBnd->segment->carea = nan("1");
 4077: 
 4078:       }
 4079:    } else {
 4080: 
 4081:       node.nodeBnd = nullptr; // For internal nodes
 4082: 
 4083:       if (isbnd[iglobal] == landSegment) {
 4084:          node.nodeBnd = landBoundaryNode;
 4085:          node.nodeBnd->segment = landBoundarySegment;
 4086:       }
 4087:       
 4088:    }
 4089:    
 4090:    // XXXX GAUSSIAN HILL VELOCITIES
 4091:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4092:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4093:          constexpr double rot_per = 3000.0;
 4094:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4095:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4096:       // XXXXX
 4097:    #endif
 4098: 
 4099: }
 4100: 
 4101: __device__ void Mesh::populateNodes2(int *localNodeNeighNodesStart, int *crs_indices, int *crs_indptr) {
 4102:    NODE(node);
 4103: 
 4104: 
 4105:    // Computes csrSlot, the array of indices/slots of the neighbor nodes in the CRS matrix.
 4106:    int16_t *csrSlot = node->csrSlot;  
 4107: 
 4108:    // Simply count the number of nodes with a smaller global index than the current node.
 4109:    // It accounts for the diagonal element.
 4110:    for (int i = 0; i < node->numNodes; ++i) {
 4111:       const int col = node->nodes[i]->idx;
 4112:       int16_t idx = 0;
 4113: 
 4114:       //Takes care of the diagonal element.
 4115:       if (node->idx < col) ++idx;          
 4116: 
 4117:       for (int j = 0; j < node->numNodes; ++j) if (node->nodes[j]->idx < col) ++idx;
 4118:       csrSlot[i] = idx;
 4119:    }
 4120: 
 4121:    // Find the diagonal element in the CRS matrix.
 4122:    int16_t idxDiag = 0;
 4123:    for (int j = 0; j < node->numNodes; ++j)
 4124:       if (node->nodes[j]->idx < node->idx) ++idxDiag;
 4125: 
 4126:    node->coeffDiag = &(node->coeffRow[idxDiag]);
 4127: 
 4128:    // Fills the CRS indices and indptr arrays for the cupyz's crs matrix in the solver.
 4129:    const int idxNodeLocalStart = localNodeNeighNodesStart[i];
 4130: 
 4131:    const int rowStart = idxNodeLocalStart + i;  // +i is to account for the diagonal element.
 4132:    const int rowNNZ = node.numNodes + 1;        // +1 is to account for the diagonal element.
 4133:    crs_indptr[i] = rowStart;
 4134: 
 4135:    const int d = (int)(node->coeffDiag - node->coeffRow);
 4136:    crs_indices[rowStart + d] = node->idx;  
 4137:    for (int j = 0; j < node->numNodes; ++j) crs_indices[rowStart + node->csrSlot[j]] = node->nodes[j]->idx;
 4138: 
 4139: 
 4140: }
 4141: 
 4142: 
 4143: 
 4144: 
 4145: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4146:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4147:                                     double *wind_rotate_angle,   
 4148:                                     int *isdel, int *isidenode, int *isbnd,
 4149:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4150:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4151:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4152:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4153:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4154:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4155:                                     double *drag, double *roughness) {
 4156: 
 4157: 
 4158:    SIDE(pside);
 4159:    Side &side(*pside);
 4160:    const int i = idx_side;
 4161:    const int iglobal = globalSideIndices[i];
 4162:    side.idx = iglobal;  
 4163:    
 4164:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4165:    const double fc   = 2.0*omega_e*sin(sfea0);
 4166:    const double beta = 2.0*omega_e*cos(sfea0);
 4167: 
 4168:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4169: 
 4170:    // finding the pointer to the nodes that form the side
 4171:    const int idx_n1 = isidenode[iglobal*2];
 4172:    const int idx_n2 = isidenode[iglobal*2 + 1];
 4173: 
 4174: if (i % 100 == 0) printf("populateSides: iglobal = %d, idx_n1 = %d, idx_n2 = %d\n", iglobal, idx_n1, idx_n2);
 4175: 
 4176:    const int locidx_n1 = localNodeIndices[idx_n1];
 4177:    const int locidx_n2 = localNodeIndices[idx_n2];
 4178:    const int part_n1 =   localNodePart[idx_n1];
 4179:    const int part_n2 =   localNodePart[idx_n2];
 4180: 
 4181: if (i % 100 == 0) printf("populateSides: i = %d, part_n1 = %d, part_n2 = %d, locidx_n1 = %d, locidx_n2 = %d\n", i, part_n1, part_n2, locidx_n1, locidx_n2);
 4182: if (i % 100 == 0) printf("populateSides: i = %d, nodes[part_n1] = %p, nodes[part_n2] = %p\n", i, mesh->nodes[part_n1], mesh->nodes[part_n2]);
 4183: 
 4184:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4185:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4186: 
 4187: if (i % 100 == 0) printf("populateSides: 1, i = %d, side.n1 = %p, side.n2 = %p\n", i, side.n1, side.n2);
 4188: 
 4189:    // Counts the number of sides connected to each node
 4190:    atomicAddInt16Unsafe(&side.n1->numSides, 1);  // Unsafe here means that it doesn't check for overflow. This function is defined in this file.
 4191:    atomicAddInt16Unsafe(&side.n2->numSides, 1);
 4192: 
 4193:    // Side boundary type
 4194:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4195:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4196: if (i == 0) printf("populateSides: 2\n");
 4197: 
 4198:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4199:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4200:    {
 4201:       bool isLand = false;
 4202:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4203:       
 4204:       if (isbs > -1) {
 4205:          // assert(isLand || isbs>=0);
 4206:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4207: 
 4208:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4209: 
 4210:          if   (isLand) side.sideBnd->segment = landBoundarySegment;
 4211:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4212: 
 4213:          assert (isLand == side.sideBnd->segment->isLand);
 4214:          
 4215:          side.sideBnd->side = &side;
 4216: 
 4217:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4218:          n1bnd->linkSideBoundary(side.sideBnd);
 4219:          n2bnd->linkSideBoundary(side.sideBnd);
 4220: 
 4221:       }
 4222:       else {
 4223:          side.sideBnd = nullptr;
 4224:       }
 4225:    }
 4226:    else 
 4227:    {
 4228:       side.sideBnd = nullptr;
 4229:    }
 4230: 
 4231: if (i % 100 == 0) printf("populateSides: 3, i = %d\n", i);
 4232: 
 4233:    // finding the pointer to the elements that share the side
 4234:    const int idx_e1 = isdel[iglobal*2];
 4235:    const int idx_e2 = isdel[iglobal*2 + 1];
 4236: 
 4237:    if (idx_e1 > -1) {
 4238:       const int locidx_e1 = localElemIndices[idx_e1];
 4239:       const int part_e1 =  localElemPart[idx_e1];
 4240:       side.elems[0] = elems[part_e1] + locidx_e1;
 4241: 
 4242:    }
 4243:    else {
 4244:       side.elems[0] = nullptr;
 4245:    }
 4246: 
 4247: if (i % 100 == 0) printf("populateSides: 4, i = %d\n", i);
 4248: 
 4249:    if (idx_e2 > -1) {
 4250:       const int locidx_e2 = localElemIndices[idx_e2];
 4251:       const int part_e2 =  localElemPart[idx_e2];
 4252:       side.elems[1] = elems[part_e2] + locidx_e2;
 4253:    }
 4254:    else {
 4255:       side.elems[1] = nullptr;
 4256:    }
 4257: 
 4258: if (i % 100 == 0) printf("populateSides: 5, i = %d\n", i);
 4259: 
 4260:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4261:       
 4262:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4263:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4264:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4265:          
 4266:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4267:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4268:       // printf("sideBnd: %p\n", side.sideBnd);
 4269:       // assert(false && "Side has no elements and no boundary");
 4270:    }
 4271:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4272: 
 4273:    // Compute the center of the side
 4274:    side.center = 0.5*(side.n1->p + side.n2->p);
 4275: 
 4276:    #ifdef USE_FRAMES
 4277:    side.setFrame();
 4278:    #endif
 4279: 
 4280: if (i % 100 == 0) printf("populateSides: 6, i = %d\n", i);
 4281: 
 4282:    // Normal, unitary vector to the side
 4283:    if constexpr(ics == 1) {
 4284:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4285:       side.n = normalize(side.n);
 4286:    }
 4287:    else {
 4288:       // Unit side vector in 3D cartesian coordinates
 4289:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4290: 
 4291:       nSide = normalize(nSide);
 4292: 
 4293:       // Its cross product with the unit local z-axis vector (nUp) is the
 4294:       // normal vector we are looking for.
 4295:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4296: 
 4297:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4298:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4299:       side.n = -normalize(n2D); 
 4300: 
 4301:    }
 4302: 
 4303: if (i % 100 == 0) printf("populateSides: 7, i = %d\n", i);
 4304: 
 4305:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4306:    side.shapiro = shapiro0;
 4307: 
 4308:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4309:    // XXXX
 4310:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4311:    constexpr double rot_per=3000.0;
 4312:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4313:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4314:    // XXXXX      
 4315:    #endif
 4316:    // Compute the z level at the center of the side
 4317:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4318:    
 4319:    // Compute the length of the side
 4320:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4321: 
 4322: if (i % 100 == 0) printf("populateSides: 8, i = %d\n", i);
 4323: 
 4324:    // Compute the Coriolis coefficient
 4325: 
 4326:    if constexpr(ncor == -1 || ncor == 0) {
 4327:       side.coriolis = coricoef;
 4328:    }
 4329:    else {
 4330:       const double sphi = side.lat();  // Latitude at the center of the side
 4331: 
 4332:       assert(use_ll && "use_ll must be true when ncor > 0");
 4333: 
 4334:       if constexpr(ics == 1) {
 4335:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4336:       }
 4337:       else { // ics == 2
 4338:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4339:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4340:       }
 4341: 
 4342:    }
 4343: 
 4344: if (i % 100 == 0) printf("populateSides: 9, i = %d\n", i);
 4345: 
 4346: }
 4347: 
 4348: 
 4349: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4350:    double *node_coords, double *node_coords_ll, bool use_ll,
 4351:    double *wind_rotate_angle,   
 4352:    int *isdel, int *isidenode, int *isbnd,
 4353:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4354:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4355:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4356:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4357:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4358:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4359:    double *drag, double *roughness) {
 4360: 
 4361:    ELEM(pelem);
 4362:    Element &elem(*pelem);
 4363:    const int i = idx_elem;
 4364: 
 4365:    elem.idx = i;
 4366: 
 4367:    for (int j = 0; j < i34[i]; j++) {
 4368:       const int idxNode = elnode[i*4 + j];  
 4369:       const int idxSide = elside[i*4 + j];
 4370:       
 4371:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4372:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4373: 
 4374:       // Find the neighboring element  
 4375:       if (elem.sides[j]->elems[0] == &elem) {
 4376:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4377:       }
 4378:       else {
 4379:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4380:       }
 4381:       
 4382:    }
 4383: 
 4384:    elem.i34 = i34[i];
 4385: 
 4386:    // Compute the barycenter of the element and its depth
 4387:    elem.center = {0.0, 0.0};
 4388:    elem.depth = 1e10;
 4389:    for (int j = 0; j < i34[i]; j++) {
 4390: 
 4391:       elem.center += elem.nodes[j]->p/i34[i];
 4392:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4393:    }
 4394: 
 4395:    #ifdef USE_FRAMES
 4396:    elem.setFrame();
 4397:    #endif
 4398: 
 4399:    elem.area = elem.computeSignedArea(); 
 4400:    elem.radius = sqrt(elem.area)/pi; 
 4401:    
 4402:    // Determines which way the normal vector to each side is oriented.
 4403:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4404:    for (int j = 0; j < i34[i]; j++)  
 4405:    {
 4406:       if (elem.sides[j]->elems[0] == &elem) {
 4407:          elem.ssign[j] =  1.0;
 4408:       }
 4409:       else {
 4410:          elem.ssign[j] = -1.0;
 4411:       }
 4412: 
 4413:    }
 4414: 
 4415:   
 4416: 
 4417:    // Derivatives of shape functions
 4418:    //  For ics=2, this is done in the element frame
 4419:    //  For quads, the derivative is evaluated at centroid
 4420:    for (int j = 0; j < elem.i34; j++) {
 4421:       const double area = elem.area;
 4422:       const int id2 = elem.nxq(1 + j);
 4423:       const int id3 = elem.nxq(2 + j);
 4424:       const int id4 = elem.nxq(3 + j);
 4425:       if (elem.isTri()) {
 4426:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4427:          // phi_0 = (x2 - x0)^(x - x0)/((x2 - x0)^(x1 - x0)), where ^ is the cross product
 4428:          // phi_0 = (x2 - x0)^(x - x0)/(2*area)
 4429:          // dphi_0/dx = (x2.y - x0.y)/(2*area)
 4430:          // dphi_0/dy = (x0.x - x2.x)/(2*area)
 4431:          // And so on for the other shape functions.
 4432: 
 4433:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4434:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4435:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4436: 
 4437:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4438:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4439: 
 4440:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4441: 
 4442:       }
 4443:       else  { // Quad, the derivatives are evaluated at the centroid
 4444: 
 4445:          // The derivation is complicated, but it starts by defining the shape functions in terms of the local coordinates (eta, xi).
 4446:          // phi_0 = (1 + eta*eta_n(0))*(1 + xi*xi_n(0))/4
 4447:          // ...
 4448:          // and then the derivatives are computed at the centroid (eta = 0, xi = 0)
 4449: 
 4450:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4451:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4452:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4453: 
 4454:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4455:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4456: 
 4457:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4458: 
 4459:       } // if Tri/Quad
 4460: 
 4461:    } // for j   
 4462:    
 4463:    
 4464: 
 4465: }
 4466: 
 4467: 
 4468: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4469:                                             double *emo, double *efa, 
 4470:                                             double *umo, double *ufa, 
 4471:                                             double *vmo, double *vfa,
 4472:                                             int *ifltype, int *iettype) {
 4473: 
 4474:    NODE_BND(nodeBnd);
 4475:    const int idx = idx_node_bnd;    
 4476: 
 4477:    nodeBnd->idx = idx;
 4478: 
 4479:    // Need to find the segment index and the index of the node on the segment
 4480:    int idxNode = -1;
 4481:    int iseg, i;
 4482:    for (iseg = 0; iseg < nope; iseg++) {
 4483:       // for each segment...
 4484:       for (i = 0; i < nond[iseg]; i++) {
 4485:          idxNode = iond[iseg + i*nope];
 4486:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4487:          
 4488:       }
 4489:    }
 4490: 
 4491:    assert(iseg < nope && "iseg is out of bounds");
 4492: 
 4493: found: // Jumped here when the node was found
 4494: 
 4495:    nodeBnd->isEssentialBC = true;
 4496:    nodeBnd->elbc = 0.0;
 4497: 
 4498:    nodeBnd->segment->ifltype = ifltype[iseg];
 4499:    nodeBnd->segment->iettype = iettype[iseg];
 4500: 
 4501:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4502: 
 4503:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4504: 
 4505:       nodeBnd->efa[jfr] = efa[idx2];
 4506:       nodeBnd->emo[jfr] = emo[idx2];
 4507:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4508:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4509: 
 4510:    }
 4511:         
 4512: 
 4513: }
 4514: 
 4515: __device__ void Mesh::populateBoundarySideLinks(void) {
 4516: 
 4517:    SIDE_BND(sideBnd);
 4518: 
 4519:    const Side *side = sideBnd->side;
 4520: 
 4521:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4522:    // and the rightSide is the side s that has s->n1 == side->n2
 4523:    for (int i = 0; i < mesh->nbs; i++) {
 4524: 
 4525:       Side *s = &mesh->localSideData[i];
 4526: 
 4527:       if (s == side) continue;  // Do not link the side to itself
 4528:    
 4529:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4530:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4531:    }
 4532:    
 4533: }
