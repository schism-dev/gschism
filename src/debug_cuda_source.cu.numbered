 4496:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4497: 
 4498:       NODE_BND(nodeBnd);
 4499: 
 4500:       Node *node = nodeBnd->node;
 4501: 
 4502:       node->ETP = 0.0;
 4503: 
 4504:       for (int j=0; j<ntip; j++) {
 4505: 
 4506:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4507:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4508:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4509: 
 4510:          if constexpr(iloadtide==1) { // loading tide
 4511:             assert(false && "Loading tide not implemented");
 4512:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4513:          }
 4514:          
 4515:       }
 4516:       
 4517:    }
