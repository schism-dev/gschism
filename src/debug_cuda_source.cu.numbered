 8702: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8703:    // Get the value of a variable from an side
 8704:    // varName is the name of the variable to get
 8705:    // var is the array to store the value
 8706:    // k is the vertical level index of the variable to get
 8707:    SIDE_BND(sideBnd);   
 8708: 
 8709:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8710:    if (sideBnd->segment->isLand) idx = -7;
 8711: 
 8712:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8713:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8714: 
 8715: }
