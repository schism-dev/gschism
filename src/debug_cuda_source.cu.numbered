 7732: 
 7733: __global__ void computeMatrixProductAndDotProducts() {
 7734:    // Computes A*p, r'Mr and p'Ap
 7735: 
 7736:    // 1) shared buffer: first half for rMr, second for pAp
 7737:    __shared__ double sdata[2*BLOCK_SIZE];
 7738:    double* s_rMr = sdata;
 7739:    double* s_pAp = sdata + BLOCK_SIZE;
 7740: 
 7741:    const int tid = threadIdx.x;
 7742: 
 7743:    double l_pAp = 0.0;
 7744: 
 7745:    s_rMr[tid] = 0.0;
 7746:    s_pAp[tid] = 0.0;
 7747: 
 7748:    // 2) get your node pointer
 7749:    // NODE(node);   
 7750:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7751:    Node *node = &(mesh->localNodeData[idx_node]); 
 7752:       if (idx_node < mesh->np) {
 7753: 
 7754:       const double diag = node->coeffDiag;
 7755:       const double r    = node->mR;
 7756:       const double p    = node->mP;  
 7757: 
 7758:       // apply preconditioner on the fly:
 7759:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7760: 
 7761:       // 4) compute Ap = A.p
 7762:       double Ap = node->coeffDiag * node->mP;
 7763:       for (int j = 0; j < node->numNodes; ++j) {
 7764:          const Node *nbNode = node->nodes[j];
 7765:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7766: 
 7767:       }
 7768: 
 7769:       node->mAp = Ap;
 7770:       
 7771: 
 7772:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7773:       // const double l_rMr = r*Mr;  // r'Mr
 7774:       l_pAp = p*Ap;  // p'Ap
 7775: 
 7776: 
 7777:    }
 7778: 
 7779:    // 6) write into shared mem
 7780:    // s_rMr[tid] = l_rMr;
 7781:    s_pAp[tid] = l_pAp;
 7782: 
 7783:    __syncthreads();
 7784: 
 7785:    // 7) block-wide tree reduction
 7786:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7787:       if (tid < stride)  {
 7788:          s_pAp[tid] += s_pAp[tid + stride];
 7789:       }
 7790:       __syncthreads();
 7791:    }
 7792: 
 7793:    // 8) thread 0 atomically accumulates into the globals
 7794:    // XXX: This is slower than it needs to be, but it is simple and works
 7795:    if (tid == 0) {
 7796:       atomicAdd(pAp, s_pAp[0]);
 7797:    }
 7798: 
 7799: 
 7800: }
 7801: 
 7802: 
 7803: __global__ void updateSolutionAndDotProducts(void) {
 7804:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7805: 
 7806:    const int tid = threadIdx.x;
 7807: 
 7808:    s_rMr[tid] = 0.0;
 7809: 
 7810:    // get node & bounds-check:
 7811:    NODE(node);
 7812: 
 7813:    
 7814:    // Compute alpha
 7815:    const double alpha = (*rMr_old)/(*pAp); 
 7816: 
 7817: 
 7818:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7819: 
 7820: 
 7821:    // load scalars
 7822:    const double diag = node->coeffDiag;
 7823:    const double p    = node->mP;
 7824:    const double Ap   = node->mAp;
 7825:    const double x    = node->mX;
 7826:    const double r    = node->mR;
 7827:    
 7828:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7829: 
 7830:    // 1) update solution & residual
 7831:    const double x_new = x + alpha*p;
 7832:    const double r_new = r - alpha*Ap;
 7833:    node->mX = x_new;
 7834:    node->mR = r_new;
 7835: 
 7836:    // 2) apply Jacobi preconditioner on the fly
 7837:    const double Mr_new = r_new/diag;
 7838: 
 7839: 
 7840:    // 3) local contributions for the two dot-products
 7841:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7842: 
 7843:    // 4) write into shared-mem
 7844:    s_rMr[tid] = l_rMr;
 7845: 
 7846:    __syncthreads();
 7847: 
 7848: 
 7849:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7850:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7851:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7852:       __syncthreads();
 7853:    }
 7854: 
 7855:    // 6) thread 0 atomically folds into the global accumulators
 7856:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7857: 
 7858: 
 7859: }
 7860: 
 7861: 
 7862: __global__ void updateSearchDirection() {
 7863: 
 7864:     NODE(node);
 7865: 
 7866:     // recompute z on-the-fly
 7867:     const double z = node->mR / node->coeffDiag;
 7868:     const double p = node->mP;
 7869: 
 7870:     const double beta = (*rMr_new)/(*rMr_old);
 7871: 
 7872: 
 7873:     // p =z + beta*p
 7874:     node->mP = z + beta*p;
 7875: 
 7876: }
 7877: 
 7878: __global__ void initializeScalars(double *scalars) {
 7879: 
 7880:    // These point to a cupy array in the host code
 7881:    rMr_old = scalars + 0;
 7882:    rMr_new = scalars + 1;
 7883:    pAp     = scalars + 2;
 7884: }
 7885: 
 7886: __global__ void initializePreconditionedResidual(void) {
 7887: 
 7888:     __shared__ double s_rMr[BLOCK_SIZE];  
 7889: 
 7890:     s_rMr[threadIdx.x] = 0.0;
 7891: 
 7892:     NODE_ALL(node, valid);
 7893:     const int tid = threadIdx.x;
 7894:     // For the first iteration:
 7895:     // 1. Initial solution x = 0 (already set)
 7896:     // 2. Initial residual r = b (stored in qel)
 7897:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7898: 
 7899: // XXX we should use the guess solution here    
 7900: 
 7901:     double l_rMr = 0.0;
 7902:     if (valid) {
 7903:       // Set initial residual r = b (from qel)
 7904:       node->mR = node->qel;
 7905: 
 7906:       // Compute z = M^-1 * r (preconditioned residual)
 7907:       const double z = node->mR / node->coeffDiag;
 7908: 
 7909:       // Set initial search direction p = z
 7910:       node->mP = z;
 7911: 
 7912:       // Initialize other variables needed for CG
 7913:       node->mX = 0.0;  // Initial solution
 7914:       node->mAp = 0.0; // Will be computed in first iteration
 7915: 
 7916: 
 7917:       // Computes the first r'Mr (reduction)
 7918:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7919:     }
 7920:     // 4) write into shared-mem
 7921:     s_rMr[tid] = l_rMr;
 7922: 
 7923:     __syncthreads();
 7924: 
 7925: 
 7926:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7927:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7928:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7929:         __syncthreads();
 7930:     }
 7931: 
 7932:     // 6) thread 0 atomically folds into the global accumulators
 7933:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7934: 
 7935:     *rMr_old = 0.0;
 7936:     *pAp = 0.0;
 7937: }
 7938: 
 7939: 
 7940: 
 7941: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7942:    Element *elems = mesh->localElemData;
 7943: 
 7944:    *addr = elems;
 7945:    *sizeElement = sizeof(Element);
 7946:    switch (varCode) {
 7947:       case (int)VarCode::z:
 7948:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7949:          *sizeType = sizeof(double);
 7950:          break;
 7951:       case (int)VarCode::x:
 7952:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7953:          *sizeType = sizeof(Vector2);
 7954:          break;
 7955:       case (int)VarCode::area:
 7956:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7957:          *sizeType = sizeof(double);
 7958:          break;
 7959:       case (int)VarCode::depth:
 7960:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7961:          *sizeType = sizeof(double);
 7962:          break;
 7963:       case (int)VarCode::radius:
 7964:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7965:          *sizeType = sizeof(double);
 7966:          break;
 7967:       case (int)VarCode::lonlat:
 7968:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7969:          *sizeType = sizeof(double);
 7970:          break;
 7971:       case (int)VarCode::ghat:
 7972:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7973:          *sizeType = sizeof(Vector2);
 7974:          break;
 7975:       case (int)VarCode::kb:
 7976:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7977:          *sizeType = sizeof(int);
 7978:          break;
 7979:       case (int)VarCode::isdry:
 7980:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7981:          *sizeType = sizeof(int);
 7982:          break;            
 7983:       case (int)VarCode::w:
 7984:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7985:          *sizeType = sizeof(double);
 7986:          break;
 7987:       case (int)VarCode::FaceIndices:
 7988:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7989:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7990:          *sizeType = sizeof(Node);
 7991:          break;
 7992:       default:
 7993:          *offset = -1;
 7994:    }
 7995: }
 7996: 
