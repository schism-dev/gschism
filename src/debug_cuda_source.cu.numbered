  877: struct Side {
  878: 
  879:    // Geometry information
  880:    int idx;               // Index of the side
  881:    Node *n1, *n2;
  882:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  883: 
  884:    double len;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  885:    Vector2 center;        // Location of side center. 
  886:    double zc[nvrt];       // Side center z-coord at each vertical level
  887: 
  888:    Frame frame;
  889: 
  890:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  891:                           // this is nullptr
  892:    
  893:    int kb;                // Bottom index of the side
  894:    bool isDry;             // True if the side is dry
  895:  
  896:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  897: 
  898:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  899: 
  900:    // Physical information
  901:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  902:    double  w2[nvrt];            // Vertical velocity at each vertical level
  903:    Vector2 btu[nvrt];           // Back-tracked velocity
  904:    Vector2 U;                   // Vertically averaged velocity vector  
  905: 
  906:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  907: 
  908:    Vector2 bcc[nvrt];           // Baroclinic term
  909:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  910: 
  911:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  912:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  913:    Vector2 gradPr;               // Gradient of pressure
  914:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  915: 
  916: 
  917:    double hhat;                 // \breve{H} in notes
  918: 
  919:    double shapiro;
  920: 
  921:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  922: 
  923:    double coriolis;             // Coriolis parameter
  924: 
  925:    // Vegetation parameters
  926:    double veg_c2;
  927:    double veg_beta;
  928: 
  929:    // Bottom drag parameters.
  930:    double chi;
  931:    double chi2;
  932: 
  933:    __inline__ __device__ double x(double t) const;
  934:    __inline__ __device__ double y(double t) const;
  935:    __inline__ __device__ Point2 p_t(double t) const;
  936: 
  937:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  938:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  939:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  940:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  941: 
  942:    __inline__ __device__ Side* neigh(int index) const { 
  943:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  944:       assert(index >= 0 && index < 4); 
  945:       assert(elems[0] != nullptr && elems[1] != nullptr);
  946: 
  947:       const int ielem = index & 1;           // 0 or 1
  948:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  949: 
  950:       const Element* elem = elems[ielem];
  951: 
  952:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  953: 
  954:       return elem->sides[elem->nxq(locSideIdx + iside)];
  955: 
  956:    }
  957: 
  958:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  959: 
  960:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  961: 
  962:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  963:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  964:    __inline__ __device__ int iadv(void) const;
  965: 
  966:    __inline__ __device__ double grav3(void) const;
  967:    
  968:    __inline__ __device__ double eta2(void) const;
  969:    __inline__ __device__ double eta1(void) const;
  970:    __inline__ __device__ double depth(void) const;
  971:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  972:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  973: 
  974:    __inline__ __device__ double dfv(int k) const;
  975: 
  976:    __inline__ __device__ double veg_h(void)  const;
  977:    __inline__ __device__ double veg_nv(void) const;
  978:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  979:    __inline__ __device__ double veg_alpha3D(int k) const;
  980:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  981: 
  982:    __inline__ __device__ double etaMeanBnd(void) const;
  983: 
  984:    __inline__ __device__ double Cd(void) const;
  985: 
  986:    __inline__ __device__ Vector2 tau(void) const;
  987: 
  988:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  989:    
  990: 
  991:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  992:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  993:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  994:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  995:    } 
  996:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  997:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  998:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  999:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1000: 
 1001:    // Get valid starting element (for backtracking)
 1002:    __inline__ __device__ Element* getStartElement() {
 1003:       return elems[0] ? elems[0] : elems[1];
 1004:    }
 1005: 
 1006:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1007:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1008: 
 1009:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1010: 
 1011:       // Dot product of the negative velocity vector with the side normal vector
 1012:       const double dot_prod1 = -dot(u, n);
 1013: 
 1014:       // Vector from side center to element 0 centroid
 1015:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1016: 
 1017:       // Dot product of the vector with the side normal vector
 1018:       const double dot_prod2 = dot(v2, n);
 1019: 
 1020:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1021:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1022: 
 1023:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1024:       else                           return elems[1];
 1025: 
 1026:  
 1027:    }
 1028: 
 1029:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1030:       // Given an element, returns the other element that shares this side
 1031:       return (elems[0] == elem) ? elems[1] : elems[0];
 1032:    }
 1033: 
 1034:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1035:       // Given a node, returns the other node that shares this side
 1036:       return (n1 == node) ? n2 : n1;
 1037:    }
 1038:  
 1039:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1040: 
 1041: 
 1042: 
 1043: 
 1044: };
 1045: 
 1046: 
 1047: // This struct is used to store the boundary information for a node.
 1048: struct NodeBoundary {   
 1049:    BoundarySegment *segment;
 1050:    Node *node;
 1051:    
 1052:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1053:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1054: 
 1055:    bool isLand;
 1056: 
 1057:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1058:    double elbc;   // Elevation boundary condition
 1059:    double eth;    // Elevation time history
 1060: 
 1061:    double eta_mean; // Mean elevation at nodes
 1062: 
 1063:    bool isEssentialBC;
 1064: 
 1065:    Vector2 uth[nvrt];           // "Time history" velocity
 1066: 
 1067:    // Arrays for harmonic constituents (if needed)
 1068:    double  emo[nbfr];  // Elevation amplitude
 1069:    double  efa[nbfr];  // Elevation phase
 1070:    Vector2 umo[nbfr];  // velocity amplitude
 1071:    Vector2 ufa[nbfr];  // velocity phase
 1072: 
 1073: 
 1074:    NodeBoundary(void) {
 1075:       isLand = false;
 1076:    }
 1077:    NodeBoundary(bool _isLand) {
 1078:       isLand = _isLand;
 1079:    }
 1080: 
 1081:    
 1082:    __forceinline__ __device__ int numSidesForAverage() const {
 1083:    // Returns the number of sides that are connected to the node and have the same segment.
 1084:    // This is used to compute the average velocity at the node for open boundary nodes.
 1085:       int res = 0;
 1086:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1087:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1088:       return res;
 1089:    }
 1090: 
 1091: 
 1092:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1093:       assert(index == 0 || index == 1); 
 1094:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1095:    }
 1096: 
 1097: 
 1098: };
