  395: 
  396: 
  397: struct Frame {
  398:    double _t[9]; // t stands for tensor.
  399: 
  400:    // Access the tensor in Fortran order
  401:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  402: 
  403:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  404: 
  405:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  406: 
  407:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  408:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  409:       sincos(ar2, &sin_ar2, &cos_ar2);
  410: 
  411:       t(0,0) = -sin_ar1;
  412:       t(1,0) =  cos_ar1;
  413:       t(2,0) =  0.0;
  414:       t(0,1) = -cos_ar1*sin_ar2;
  415:       t(1,1) = -sin_ar1*sin_ar2;
  416: 
  417:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  418: 
  419:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  420:       assert (ar4!=0.0 && "GRID: ar4=0");
  421: 
  422:       const double ar4_inv = 1.0/ar4;
  423:       t(0,1) = t(0,1)*ar4_inv;
  424:       t(1,1) = t(1,1)*ar4_inv;
  425:       t(2,1) = t(2,1)*ar4_inv;
  426: 
  427:       // The third vector is the cross product of the first two
  428:       crossProduct(t(0,0), t(1,0), t(2,0), 
  429:                    t(0,1), t(1,1), t(2,1), 
  430:                    t(0,2), t(1,2), t(2,2));
  431:    }
  432: 
  433: 
  434:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  435:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  436:    // Inputs:
  437:    //        vec0: vel. in this frame;
  438:    //        frameout: Output frame;
  439:    // Output: 
  440:    //        vec1: vel. in new frame  
  441: 
  442:       auto const fo = frameout;
  443:       Vector2 vec1;
  444: 
  445:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  446:       // of t and fo.t are the same.
  447:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  448:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  449: 
  450:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  451:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  452: 
  453:       return vec1;
  454:    }
  455: 
  456:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  457:       // Transform a vector from global to local frame
  458:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  459:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  460:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  461:    }
  462: 
  463:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  464:       // Transform a vector from local to global frame
  465:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  466:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  467:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  468:    }   
  469: 
  470:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  471:    // Tranforms a point from global to local frame     
  472:       G2L(pi - origin0, po);
  473:    }
  474: 
  475:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  476:    // Transforms a point from local to global frame      
  477:       L2G(pi, po);
  478:       po = po + origin0;
  479:    }
  480: 
  481: };
