 6505: 
 6506: __global__ void computeMatrixProductAndDotProducts() {
 6507:    // Computes A*p, r'Mr and p'Ap
 6508: 
 6509:    // 1) shared buffer: first half for rMr, second for pAp
 6510:    __shared__ double sdata[2*BLOCK_SIZE];
 6511:    double* s_rMr = sdata;
 6512:    double* s_pAp = sdata + BLOCK_SIZE;
 6513: 
 6514:    s_rMr[threadIdx.x] = 0.0;
 6515:    s_pAp[threadIdx.x] = 0.0;
 6516: 
 6517:    // 2) get your node pointer
 6518:    NODE(node);  
 6519:    const int tid = threadIdx.x;
 6520: 
 6521:    const double diag = node->coeffDiag;
 6522:    const double r    = node->mR;
 6523:    const double p    = node->mP;  
 6524: 
 6525:    // apply preconditioner on the fly:
 6526:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6527: 
 6528:    // 4) compute Ap = A.p
 6529:    double Ap = node->coeffDiag * node->mP;
 6530:    for (int j = 0; j < node->numNodes; ++j) {
 6531:       const Node *nbNode = node->nodes[j];
 6532:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6533: 
 6534:    }
 6535:    node->mAp = Ap;
 6536:     
 6537: 
 6538:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6539:    const double l_rMr = r*Mr;  // r'Mr
 6540:    const double l_pAp = p*Ap;  // p'Ap
 6541: 
 6542:    // 6) write into shared mem
 6543:    s_rMr[tid] = l_rMr;
 6544:    s_pAp[tid] = l_pAp;
 6545: 
 6546:    __syncthreads();
 6547: 
 6548:    // 7) block-wide tree reduction
 6549:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6550:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6551:       __syncthreads();
 6552:    }
 6553: 
 6554:    // 8) thread 0 atomically accumulates into the globals
 6555:    // XXX: This is slower than it needs to be, but it is simple and works
 6556:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6557: 
 6558: 
 6559: }
 6560: 
 6561: 
 6562: __global__ void updateSolutionAndDotProducts(void) {
 6563:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6564: 
 6565:    s_rMr[threadIdx.x] = 0.0;
 6566: 
 6567: 
 6568:    // get node & bounds-check:
 6569:    NODE(node);
 6570:    const int tid = threadIdx.x;
 6571: 
 6572: 
 6573:    // Compute alpha
 6574:    const double alpha = (*rMr_old)/(*pAp);
 6575: 
 6576:    // load scalars
 6577:    const double diag = node->coeffDiag;
 6578:    const double p    = node->mP;
 6579:    const double Ap   = node->mAp;
 6580:    const double x    = node->mX;
 6581:    const double r    = node->mR;
 6582:    
 6583:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6584: 
 6585:    // 1) update solution & residual
 6586:    const double x_new = x + alpha*p;
 6587:    const double r_new = r - alpha*Ap;
 6588:    node->mX = x_new;
 6589:    node->mR = r_new;
 6590: 
 6591:    // 2) apply Jacobi preconditioner on the fly
 6592:    const double Mr_new = r_new/diag;
 6593: 
 6594: 
 6595:    // 3) local contributions for the two dot-products
 6596:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6597: 
 6598:    // 4) write into shared-mem
 6599:    s_rMr[tid] = l_rMr;
 6600: 
 6601:    __syncthreads();
 6602: 
 6603: 
 6604:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6605:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6606:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6607:       __syncthreads();
 6608:    }
 6609: 
 6610:    // 6) thread 0 atomically folds into the global accumulators
 6611:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6612: 
 6613: 
 6614: }
 6615: 
 6616: 
 6617: __global__ void updateSearchDirection() {
 6618:     NODE(node);
 6619: 
 6620:     // recompute z on-the-fly
 6621:     const double z = node->mR / node->coeffDiag;
 6622:     const double p = node->mP;
 6623: 
 6624:     const double beta = (*rMr_new)/(*rMr_old);
 6625: 
 6626: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6627: 
 6628:     // p =z + beta*p
 6629:     node->mP = z + beta*p;
 6630: 
 6631: }
 6632: 
 6633: __global__ void initializePreconditionedResidual(double *scalars) {
 6634: 
 6635:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6636: 
 6637:     s_rMr[threadIdx.x] = 0.0;
 6638: 
 6639:     NODE(node);
 6640:     const int tid = threadIdx.x;
 6641:     // For the first iteration:
 6642:     // 1. Initial solution x = 0 (already set)
 6643:     // 2. Initial residual r = b (stored in qel)
 6644:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6645: 
 6646: // XXX we should use the guess solution here    
 6647: 
 6648:     // Set initial residual r = b (from qel)
 6649:     node->mR = node->qel;
 6650: 
 6651:     // Compute z = M^-1 * r (preconditioned residual)
 6652:     const double z = node->mR / node->coeffDiag;
 6653: 
 6654:     // Set initial search direction p = z
 6655:     node->mP = z;
 6656: 
 6657:     // Initialize other variables needed for CG
 6658:     node->mX = 0.0;  // Initial solution
 6659:     node->mAp = 0.0; // Will be computed in first iteration
 6660: 
 6661:     // These point to a cupy array in the host code
 6662:     rMr_old = scalars + 0;
 6663:     rMr_new = scalars + 1;
 6664:     pAp     = scalars + 2;
 6665: 
 6666:     // Computes the first r'Mr (reduction)
 6667:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 6668: 
 6669:     // 4) write into shared-mem
 6670:     s_rMr[tid] = l_rMr;
 6671: 
 6672:     __syncthreads();
 6673: 
 6674: 
 6675:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6676:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6677:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6678:         __syncthreads();
 6679:     }
 6680: 
 6681:     // 6) thread 0 atomically folds into the global accumulators
 6682:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 6683: 
 6684:     *rMr_old = 0.0;
 6685:     *pAp = 0.0;
 6686: }
