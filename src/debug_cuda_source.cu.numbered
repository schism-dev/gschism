 3727:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3728:       NODE(node);
 3729:       const int idx = node->idx;
 3730: 
 3731:       node->mX = x[idx];
 3732:    }
