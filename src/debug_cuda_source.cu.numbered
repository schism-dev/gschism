  598: // ----------------------------- Turbulence -----------------------------
  599: 
  600: 
  601: 
  602: constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
  603: constexpr double veg_cfpsi = 0.16;
  604: 
  605: 
  606: template<TurbulenceModel Model>
  607: struct Turbulence {
  608:    __device__ void setDiffLimits(double, double) { assert(false && "setDiffLimits does not exist for this turbulence model"); }
  609: 
  610:    __device__ void init(Node *node) {
  611:       for (int k = 0; k < nvrt; k++) {
  612:          node->dfv[k] = dfv0;
  613:          node->dfh[k] = dfh0;
  614:       }
  615:    }
  616: };   
  617: 
  618: // GLS turbulence model
  619: template<>
  620: struct Turbulence<TurbulenceModel::GLS> {
  621:    using enum TurbulenceSubmodel;
  622:    using enum StabilityModel;
  623: 
  624:    double tke[nvrt];    // TKE
  625:    double mxl[nvrt];    // mixing length for GLS
  626:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  627:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  628: 
  629:    double diffmin;  // from diffmin.gr3
  630:    double diffmax;  // from diffmax.gr3
  631:    
  632:    __device__ void setDiffLimits(double lo, double hi) {
  633:       diffmin = lo;
  634:       diffmax = hi;
  635:    }
  636: 
  637:    // Fortran cold start: q2 = q2min, xl = xlmin2, dfq1 = dfq2 = diffmin.
  638:    // Call after setDiffLimits. depth is the node depth used by xlmin2.
  639:    __device__ void init(Node *node);
  640: 
  641: 
  642:    __device__ __forceinline__ constexpr double cpsi1() const {
  643:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  644:       else if constexpr (turbSubmodel == KL)             return 0.9;
  645:       else if constexpr (turbSubmodel == KE)             return 1.44;
  646:       else if constexpr (turbSubmodel == KW)             return 0.555;
  647:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  648:       else { assert(false && "unknown submodel"); return 0.0; }
  649:    }
  650: 
  651:    
  652:    __device__ __forceinline__ constexpr double cpsi2() const {
  653:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  654:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  655:       else if constexpr (turbSubmodel == KL)             return 0.5;
  656:       else if constexpr (turbSubmodel == KE)             return 1.92;
  657:       else if constexpr (turbSubmodel == KW)             return 0.833;
  658:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  659:       else { assert(false && "unknown submodel"); return 0.0; }
  660:    }
  661: 
  662: 
  663:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  664: 
  665:    __device__ __forceinline__ double cpsi3(double N2) const {
  666: 
  667:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  668:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  669: 
  670:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  671: 
  672:       if constexpr (turbSubmodel == MellorYamada) {
  673:          return 0.9;   
  674: 
  675:       } else { // Other GLS submodels
  676: 
  677: 
  678:          if (N2 > 0.0) { // unstable (inverse stratification)
  679:             return 1.0;   
  680: 
  681:          } else { // stable (regular stratification)
  682: 
  683:             if      constexpr (turbSubmodel == KL)             return 2.53;
  684:             else if constexpr (turbSubmodel == KE)             return -0.52;
  685:             else if constexpr (turbSubmodel == KW)             return -0.58;
  686:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  687:             else { assert(false && "unknown submodel"); return 0.0; }
  688:          }
  689: 
  690:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  691: 
  692:    }
  693: 
  694:    
  695:    __device__ __forceinline__ constexpr double rpub(void) const {
  696:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  697:       else if constexpr (turbSubmodel == KL)             return  0.0;
  698:       else if constexpr (turbSubmodel == KE)             return  3.0;
  699:       else if constexpr (turbSubmodel == KW)             return -1.0;
  700:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  701:       else { assert(false && "unknown submodel"); return 0.0; }
  702:    }
  703: 
  704: 
  705:    __device__ __forceinline__ constexpr double rmub(void) const {
  706:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  707:       else if constexpr (turbSubmodel == KL)             return 1.0;
  708:       else if constexpr (turbSubmodel == KE)             return 1.5;
  709:       else if constexpr (turbSubmodel == KW)             return 0.5;
  710:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  711:       else { assert(false && "unknown submodel"); return 0.0; }
  712:    }
  713: 
  714: 
  715:    __device__ __forceinline__ constexpr double rnub(void) const {
  716:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  717:       else if constexpr (turbSubmodel == KL)             return  1.0;
  718:       else if constexpr (turbSubmodel == KE)             return -1.0;
  719:       else if constexpr (turbSubmodel == KW)             return -1.0;
  720:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  721:       else { assert(false && "unknown submodel"); return 0.0; }
  722:    }
  723: 
  724: 
  725:    __device__ __forceinline__ constexpr double schk(void) const {
  726:       if      constexpr (turbSubmodel == KL)             return 2.44;
  727:       else if constexpr (turbSubmodel == KE)             return 1.0;
  728:       else if constexpr (turbSubmodel == KW)             return 2.0;
  729:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  730:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  731:    }
  732: 
  733: 
  734:    __device__ __forceinline__ constexpr double schpsi(void) const {
  735:       if      constexpr (turbSubmodel == KL)             return 2.44;
  736:       else if constexpr (turbSubmodel == KE)             return 1.3;
  737:       else if constexpr (turbSubmodel == KW)             return 2.0;
  738:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  739:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  740:    }
  741: 
  742: 
  743:    __device__ __forceinline__ constexpr double tkemin(void) const {
  744:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  745:          return 5.0e-6;
  746:       else
  747:          return 7.6e-6; // Warner et al., OM 2005
  748:    }
  749: 
  750: 
  751:    __device__ __forceinline__ constexpr double psimin(void) const {
  752:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  753:          return 1.0e-8;
  754:       else
  755:          return 1.0e-12; // Warner et al., OM 2005
  756:    }
  757: 
  758:    __device__ __forceinline__ constexpr double epsmin(void) const {
  759:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  760:    }
  761: 
  762:    __device__ __forceinline__ double mxlmin(double depth) const;
  763: 
  764:    
  765:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  766: 
  767:    __device__ __forceinline__ double N2(Node *node, int k) const;
  768: 
  769: 
  770:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  771: 
  772:    __device__ void computeDiffusivities(Node *node);
  773: 
  774:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  775: 
  776: 
  777:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  778:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  779:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  780:    }
  781: 
  782: 
  783:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  784:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  785:    }
  786: 
  787: };
  788: 
