 1563: // Helper functions for computing the local node index at a given offset from another.
 1564: __device__ __inline__ int nxq(int offset, int index, int size) {
 1565:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1566:    // to the index to make it positive
 1567:    assert(index + offset + 16*size >= 0);
 1568:    return (index + offset + 16*size) % size;  
 1569: }
 1570: 
 1571: __device__ __inline__ int nxq(int index, int size) {
 1572:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1573:    // to the index to make it positive
 1574:    assert(index + 16*size >= 0);
 1575:    return (index + 16*size) % size; 
 1576: }
