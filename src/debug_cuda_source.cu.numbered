  512:    Vector2 center;         // Element center coordinates
  513:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  514:    double depth;              // Depth at element (min of all nodes)
  515:    double z[nvrt];            // z-coord  (local frame - vertical up)
  516: 
  517:    // Physical information
  518:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  519: 
  520:    static const bool isblock = false;              // Always false
  521: 
  522:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  523:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  524: 
  525:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  526:    
  527: 
  528:    double vsource;            // Volumetric source/sink term [m^3/s]
  529: 
  530:    double rho[nvrt];          // Density at each prism center
  531:    double rho_mean[nvrt];     // Mean density at each prism center
  532:    CubicSpline rho_spl;
  533:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  534:    double rho_z[nvrt];        // First derivative of density at each prism center
  535:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  536:    
  537: 
  538:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  539: 
  540:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  541:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  542: 
  543:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  544:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  545: 
  546:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  547:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  548:       // Find the local index of the node in the element (0,1,2,3)
  549:       int res = __ffs((nodes[0] == node) | 
  550:                      ((nodes[1] == node) << 1) | 
  551:                      ((nodes[2] == node) << 2) | 
  552:                      ((nodes[3] == node) << 3)) - 1;
  553:       
  554:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  555:       return res;  
  556:    }
  557: 
  558:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  559:       // Find the local index of the side in the element (0,1,2,3)
  560:       int res = __ffs((sides[0] == side) | 
  561:                      ((sides[1] == side) << 1) | 
  562:                      ((sides[2] == side) << 2) | 
  563:                      ((sides[3] == side) << 3)) - 1;
  564:       
  565:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  566:       return res;
  567:    }
  568: 
  569: 
  570:    __inline__ __device__ int findLevel(double z1, int k) const {
  571:       // Starting at index k, find sequentially the level that contains z
  572: 
  573:       // For testing purposes, forgets k and performs a full search.
  574:       for (k = kb; k < nvrt - 1; k++) {
  575:          if (z1 >= z[k] && z1 < z[k + 1]) return k;
  576:       }
  577:       return nvrt - 2;
  578: 
  579: 
  580:       // if z is already betweeen z[k] and z[k+1], return k
  581:       if (z1 >= z[k] && z1 < z[k + 1]) return k;
  582:       else if (z1 <  z[k]) { 
  583:          // Search for increasing levels
  584:          for (int kk = k; kk < nvrt - 1; kk++) {
  585:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  586:          }
  587:          return nvrt - 1;
  588:       }
  589:       else {
  590:          // Search for decreasing levels
  591:          for (int kk = k; kk >= kb; kk--) {
  592:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  593:          }
  594:          return 0;
  595:       }
  596:    }
  597: 
  598:    __inline__ __device__ double z_prism(int k) const { assert(k < nvrt - 1); return 0.5*(z[k+1] + z[k]); }
  599:    __inline__ __device__ double Dz(int k)      const { assert(k < nvrt - 1); return z[k+1] - z[k]; }
  600: 
  601:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  602:    __device__ __forceinline__ Point2 GaussPoint(int idx) const {
  603:        constexpr double g = 0.5773502691896257; // 1/sqrt(3)
  604:        assert(idx >= 0 && idx < 4 && "GaussPoint: idx out of range");
  605:        const double eta = (idx & 1) ? +g : -g;
  606:        const double xi  = (idx & 2) ? +g : -g;
  607:        return {eta, xi};
  608:    }  
  609: 
  610:    // (eta,xi) coordinates of the Gauss-Legendre quadrature points (idx = 0,1,2,3)
  611:    __device__ __forceinline__ double etaSign(int idx) const {
  612:       // bit1: 0 -> -1, 1 -> +1
  613:       assert(idx >= 0 && idx < 4 && "etaSign: idx out of range");
  614:       return (idx & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  615:    }
  616: 
  617:    __device__ __forceinline__ double xiSign(int idx) const {
  618:       // +1 if (bit0 XOR bit1), else -1
  619:       assert(idx >= 0 && idx < 4 && "xiSign: idx out of range");
  620:       return ((idx & 1) ^ (idx >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  621: 
  622:    }
  623: 
  624:    // Shape function Phi_idx at a given point p = (eta,xi), idx = 0,1,2,3
  625:    __device__ __forceinline__ double Phi(int idx, Point2 p) const {
  626:       return 0.25*(1.0 + p.x*etaSign(idx))*(1.0 + p.y*xiSign(idx));
  627:    }
  628: 
  629:    // Derivative of shape function Phi_idx/dxi at a given point p = (eta,xi) 
  630:    __device__ __forceinline__ double dPhi_dxi(int idx, Point2 p) const {
  631:       return 0.25*xiSign(idx)*(1.0 + p.x*etaSign(idx));
  632:    }   
  633: 
  634:    // Derivative of shape function Phi_idx/deta at a given point p = (eta,xi) 
  635:    __device__ __forceinline__ double dPhi_deta(int idx, Point2 p) const {
  636:       return 0.25*(1.0 + p.y*xiSign(idx))*etaSign(idx);
  637:    }      
  638:    
  639:    __inline__ __device__ double detJ_eta(void) const;
  640: 
  641:    __inline__ __device__ double detJ_xi(void) const;
  642: 
  643:    __inline__ __device__ double jacobianDet(Point2 p) const { return area/4.0 + detJ_eta()*p.x + detJ_xi()*p.y; }
  644: 
  645:    // Check if the element is dry using the more up-to-date elevation.
  646:    __inline__ __device__ bool isDry2(void) const;
  647: 
  648:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  649: 
  650:    __inline__ __device__ double computeSignedArea(void) const;
  651: 
  652:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  653:       // Nudges the point (x,y) to the barycenter of the element
  654: 
  655:       p = (1.0 - btrack_nudge)*p + btrack_nudge*center;
  656:    }
  657: 
  658:    __device__ bool computeShapeCoords(Point2 &xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  659:    
  660:    __device__ void shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const;
  661: 
  662:    __device__ double intPhiPhi(int i1, int i2) const;
  663: 
  664:    __device__ double intGradPhiGradPhi(int i1, int i2) const;
  665: 
  666:    __device__ Vector2 grad2(double *a) const
  667:    {
  668:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  669:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  670:       if (isQuad()) {
  671:          gx += a[3]*gradPhi[3].x;
  672:          gy += a[3]*gradPhi[3].y;
  673:       }
  674:       return {gx, gy};
  675:    }
  676: 
  677:    __device__ Vector2 grad2(double Node::* field) const
  678:    {
  679:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  680:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  681:       if (isQuad()) {
  682:          gx += (nodes[3]->*field)*gradPhi[3].x;
  683:          gy += (nodes[3]->*field)*gradPhi[3].y;
  684:       }
  685:       return {gx, gy};
  686:    }
  687: 
  688:    __device__ __forceinline__ Vector3 n(int k, double &area3D) const;
  689:    __device__ __forceinline__ Vector3 n(int k) const {
  690:       double area3D;
  691:       return n(k, area3D);
  692:     }
