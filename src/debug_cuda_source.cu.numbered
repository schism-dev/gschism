 2552: 
 2553: 
 2554: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2555: 
 2556: 
 2557: __device__ void Node::updateKb(void) {
 2558: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2559: 
 2560:    if constexpr(ivcor == 1) return;
 2561: 
 2562: 
 2563:    // Check if node is wet
 2564:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2565: 
 2566:    if (isDry) return;
 2567: 
 2568:    if constexpr(ivcor == 2) {  // SZ coordinates
 2569:       
 2570:       // Compute bottom level index
 2571:       if (depth <= mesh->h_s) {
 2572:          kb = nzlev;
 2573:       } else {
 2574:          kb = -1;
 2575:          int L = 0;
 2576:          int R = nzlev; 
 2577:          
 2578:          while (L <= R) {
 2579:             int M = (R + L) / 2;
 2580: 
 2581: // printf("L = %d, R = %d, M = %d, depth = %f, ztot[L] = %f, ztot[R] = %f, ztot[M] = %f\n", L, R, M, depth, mesh->ztot[L], mesh->ztot[R], mesh->ztot[M]);
 2582:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2583:             
 2584:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2585:                R = M;
 2586:             } else {
 2587:                L = M;
 2588:             }
 2589: 
 2590:             if (R - L == 1) {
 2591:                kb = L;
 2592:                break;
 2593:             }
 2594:          }
 2595:       }
 2596:    } 
 2597: }
 2598: 
 2599: 
 2600: __device__ __inline__ void Node::updateZCoordData(void) {
 2601: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2602: 
 2603:    if (isDry2()) return;
 2604: 
 2605:    if constexpr(ivcor == 2) {  // SZ coordinates
 2606:       
 2607:       // Compute bottom level index
 2608:       if (depth <= mesh->h_s) {
 2609:             kb = nzlev - 1;
 2610:       } else {
 2611:          kb = -1;
 2612:          for (int i = 0; i < nzlev; i++) {
 2613:             // XXX Use binary search
 2614:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2615:                kb = i;
 2616:                break;
 2617:             }
 2618:          }
 2619:       }
 2620:    } 
 2621:    else if (ivcor == 1) {  // Localized sigma
 2622:       // Do nothing
 2623:    }
 2624: 
 2625: }
 2626: 
 2627: __device__ double Node::compZCoord(int k) const {
 2628:    // Computes the z coordinate at level k.
 2629:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2630:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2631:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2632:    // used 
 2633:    
 2634:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2635: 
 2636:   
 2637:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2638: 
 2639:    if constexpr(ivcor == 2) {
 2640: 
 2641:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2642:       const double h_c = mesh->h_c;
 2643:       const double theta_f = mesh->theta_f;
 2644:       const double sinh_theta_f = mesh->sinh_theta_f;
 2645: 
 2646:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2647:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2648:       // once per time step/node.
 2649:       // CHECK: updateZCoordData
 2650: 
 2651:       //  To simplify comparisons, I define index versions of count variables.
 2652:       if      (k == ivrt)           return eta2; 
 2653:       else if (k == izlev)          return -hmod2;
 2654:       else if (k == kb)             return -depth;
 2655:       else if (k < izlev && k >= 0) return mesh->ztot[k];
 2656:       else if (k > izlev) {
 2657:          const int ksig = k - izlev;
 2658: 
 2659:          if (hmod2 <= h_c) {
 2660: // printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2661:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2662:          } 
 2663:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2664:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2665:             assert(false && "ZCOOR: invalid h_c\n");
 2666:          } 
 2667:          else {
 2668: // printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2669:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2670:                          h_c * mesh->sigma[ksig] + 
 2671:                          (hmod2 - h_c) * mesh->cs[ksig];
 2672:          }
 2673:       } else { 
 2674:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2675:       }
 2676: 
 2677:    }
 2678:    else if constexpr(ivcor == 1) {
 2679:       if (k == kb) return -depth;
 2680:       else if (k == nvrt-1) return eta2;
 2681:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2682:    }
 2683:    
 2684:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2685:    return 0.0;
 2686: }
 2687: 
 2688: 
 2689: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2690:    // Checks if a side in on the boundary
 2691:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2692: 
 2693:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2694:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2695: 
 2696:    // Indices of the nodes that form the side
 2697:    const int n1 = side.n1->idx;
 2698:    const int n2 = side.n2->idx;
 2699: 
 2700:    // Check if the side is on a land boundary
 2701:    for (int i = 0; i < nland; i++) {
 2702:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2703:          // Consecutive nodes in the land boundary segment
 2704:          const int b1 = ilnd[i*mnlnd + j];
 2705:          const int b2 = ilnd[i*mnlnd + j + 1];
 2706: 
 2707:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2708:             isLand = true;
 2709:             return i;
 2710:          }
 2711:       }
 2712:    }
 2713: 
 2714:    // Check if the side is on an open boundary
 2715:    for (int i = 0; i < nope; i++) {
 2716:       for (int j = 0; j < nond[i] - 1; j++) {
 2717:          // Consecutive nodes in the open boundary segment
 2718:          const int b1 = iond[i*mnond + j];
 2719:          const int b2 = iond[i*mnond + j + 1];
 2720: 
 2721:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2722:             isLand = false;
 2723:             return i;
 2724:          }
 2725:       }
 2726:    }
 2727:    return -1;
 2728: }
 2729: 
 2730: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2731:                 double *node_coords, double *node_coords_ll, bool use_ll,
 2732:                 double *wind_rotate_angle, 
 2733:                 int *isdel, int *isidenode, int *isbnd,
 2734:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2735:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2736:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2737:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2738:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2739:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2740:                 double *drag, double *roughness,
 2741:                 double *emo, double *efa, 
 2742:                 double *umo, double *ufa, 
 2743:                 double *vmo, double *vfa) {
 2744: 
 2745:    printf("Populating mesh for partition %d\n", partNum);
 2746: 
 2747:    // Horizontal grid
 2748:    printf("Processing %d nodes\n", np);   
 2749: 
 2750:    
 2751:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 2752:    const double fc   = 2.0*omega_e*sin(sfea0);
 2753:    const double beta = 2.0*omega_e*cos(sfea0);
 2754: 
 2755: 
 2756:    int idxNodeBoundary = 0;  
 2757:    for (int i = 0; i < np; i++)
 2758:    {
 2759:       Node &node = localNodeData[i];
 2760: 
 2761:       node.idx = i;
 2762: 
 2763:       const int idxNodeStart = nodeNeighNodesStart[i];
 2764:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2765:       node.numNodes = idxNodeEnd - idxNodeStart;
 2766:       node.nodes = nodeNeighNodes + idxNodeStart;
 2767:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2768: 
 2769: 
 2770: 
 2771:       const int idxElemStart = nodeNeighElemsStart[i];
 2772:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2773:       node.numElements = idxElemEnd - idxElemStart;
 2774:       node.elements = nodeNeighElems + idxElemStart;
 2775: 
 2776: 
 2777:       
 2778:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2779:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2780:          const int partNode = localNodePart[idxNodeGlobal]; 
 2781:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2782: 
 2783: 
 2784:          Node *node_ptr = nodes[partNode] + idxNode;
 2785:          
 2786:          nodeNeighNodes[idx] = node_ptr;
 2787:       }
 2788: 
 2789:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2790:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2791:          const int partElem = localElemPart[idxElemGlobal];
 2792:          const int idxElem  = localElemIndices[idxElemGlobal];
 2793: 
 2794:          Element *elem_ptr = elems[partElem] + idxElem;
 2795: 
 2796:          nodeNeighElems[idx] = elem_ptr;
 2797:       }      
 2798: 
 2799: 
 2800:       node.wind_angle = wind_rotate_angle[i];
 2801: 
 2802:       // Element **elements; // pointer to the elements connected to this node
 2803:       // int numElements;   // number of elements shared by this node
 2804: 
 2805:       node.p.x   = node_coords[i * 3];
 2806:       node.p.y   = node_coords[i * 3 + 1];
 2807:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2808:       node.depth = node_coords[i * 3 + 2];
 2809: 
 2810:       node.numSides = 0;
 2811: 
 2812:       node.Cd = drag[i];
 2813:       node.rough = roughness[i];
 2814:       for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 2815: 
 2816:       // Links the node to the boundary information
 2817:       if (isbnd[i] >= 0) {
 2818:        
 2819:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2820:          node.nodeBnd->node = &node;
 2821: 
 2822:          node.nodeBnd->sideBnd1 = nullptr;
 2823:          node.nodeBnd->sideBnd2 = nullptr;
 2824: 
 2825:          if (isbnd[i]>=0) {
 2826: 
 2827:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2828:             
 2829:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2830:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2831: 
 2832:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2833:             node.nodeBnd->segment->clen  = nan("1");
 2834:             node.nodeBnd->segment->carea = nan("1");
 2835: 
 2836:          }
 2837: //          else {  XXXXXX
 2838: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2839: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2840: //          }
 2841:          
 2842:          idxNodeBoundary++;
 2843:       }
 2844:       else {
 2845:          node.nodeBnd = nullptr; // For internal nodes
 2846: 
 2847:          if (isbnd[i] == landSegment) {
 2848:             node.nodeBnd = &landBoundaryNode;
 2849:             node.nodeBnd->segment = &landBoundarySegment;
 2850:          }
 2851:          // node.nodeBnd->node = &node;
 2852:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2853:          // // node.nodeBnd = nullptr;
 2854:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2855:         
 2856:       }
 2857: 
 2858:       // XXXX GAUSSIAN HILL VELOCITIES
 2859: #ifdef GAUSSIAN_HILL_VELOCITIES
 2860:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2861:          constexpr double rot_per = 3000.0;
 2862:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2863:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2864:       // XXXXX
 2865: #endif
 2866:    }
 2867: 
 2868:    nbp = idxNodeBoundary;
 2869: 
 2870:    printf("Processing %d sides\n", ns);
 2871:    int idxSideBoundary = 0;
 2872:    for (int i = 0; i < ns; i++)
 2873:    {
 2874:       Side &side = localSideData[i];
 2875:       side.idx = i;
 2876:       // finding the pointer to the nodes that form the side
 2877:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2878:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2879: 
 2880:       const int locidx_n1 = localNodeIndices[idx_n1];
 2881:       const int locidx_n2 = localNodeIndices[idx_n2];
 2882:       const int part_n1 =   localNodePart[idx_n1];
 2883:       const int part_n2 =   localNodePart[idx_n2];
 2884: 
 2885:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2886:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2887: 
 2888:       // Counts the number of sides connected to each node
 2889:       side.n1->numSides++;
 2890:       side.n2->numSides++;
 2891: 
 2892:       // Normal, unitary vector to the side
 2893:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2894:       side.n = normalize(side.n);
 2895: 
 2896:       // Side boundary type
 2897:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2898:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2899: 
 2900:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2901:       // If both nodes are on the boundary, then the side may be on the boundary
 2902:       {
 2903:          bool isLand = false;
 2904:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2905: 
 2906:          if (isbs > -1) {
 2907:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2908:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2909:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2910: 
 2911:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2912:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2913:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2914: 
 2915:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2916:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2917:           
 2918:             side.sideBnd->side = &side;
 2919:             idxSideBoundary++;
 2920: 
 2921:          }
 2922:          
 2923: 
 2924:       // }
 2925:       // 
 2926: 
 2927: 
 2928: 
 2929: 
 2930: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2931: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2932: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2933: //       {
 2934: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2935: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2936: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2937: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2938: // if (side.sideBnd->segment == nullptr) continue;
 2939: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2940: //          else                  side.sideBnd->segment = n2bnd->segment;
 2941: //          side.sideBnd->side = &side;
 2942: //          idxSideBoundary++;
 2943: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2944:       }
 2945:       else side.sideBnd = nullptr;
 2946: 
 2947:       nbs = idxSideBoundary;
 2948: 
 2949:       // finding the pointer to the elements that share the side
 2950:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2951:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2952: 
 2953:       if (idx_e1 > -1) {
 2954:          const int locidx_e1 = localElemIndices[idx_e1];
 2955:          const int part_e1 =  localElemPart[idx_e1];
 2956:          side.elems[0] = elems[part_e1] + locidx_e1;
 2957: 
 2958:       }
 2959:       else {
 2960:          side.elems[0] = nullptr;
 2961:       }
 2962: 
 2963:       if (idx_e2 > -1) {
 2964:          const int locidx_e2 = localElemIndices[idx_e2];
 2965:          const int part_e2 =  localElemPart[idx_e2];
 2966:          side.elems[1] = elems[part_e2] + locidx_e2;
 2967:       }
 2968:       else {
 2969:          side.elems[1] = nullptr;
 2970:       }
 2971: 
 2972:       // Compute the center of the side
 2973:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2974: 
 2975:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2976:       side.shapiro = shapiro0;
 2977: 
 2978: #ifdef GAUSSIAN_HILL_VELOCITIES
 2979: // XXXX
 2980: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2981: constexpr double rot_per=3000.0;
 2982: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2983: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2984: // XXXXX      
 2985: #endif
 2986:       // Compute the z level at the center of the side
 2987:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2988: 
 2989:       // Compute the length of the side
 2990:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2991:       side.len = sqrt(dot(vLen, vLen));
 2992: 
 2993: 
 2994:       // Compute the Coriolis coefficient
 2995: 
 2996:       if constexpr(ncor == -1 || ncor == 0) {
 2997:          side.coriolis = coricoef;
 2998:       }
 2999:       else {
 3000:          const double sphi = side.lat();  // Latitude at the center of the side
 3001: 
 3002:          if constexpr(ics == 1) {
 3003:             side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 3004:          }
 3005:          else {
 3006:             side.coriolis = 2.0*omega_e*sin(sphi);
 3007:          }
 3008:       }
 3009: 
 3010: 
 3011:    }
 3012: 
 3013:    printf("Processing %d elements\n", ne);
 3014:    for (int i = 0; i < ne; i++)
 3015:    {
 3016:       Element &elem = localElemData[i];
 3017:       elem.idx = i;
 3018:       for (int j = 0; j < i34[i]; j++) {
 3019:          const int idxNode = elnode[i*4 + j];  
 3020:          const int idxSide = elside[i*4 + j];
 3021:          
 3022:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 3023:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 3024: 
 3025: 
 3026: 
 3027:          // Find the neighboring element  
 3028:          if (elem.sides[j]->elems[0] == &elem) {
 3029:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 3030:          }
 3031:          else {
 3032:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 3033:          }
 3034:          
 3035:       }
 3036: 
 3037:       elem.i34 = i34[i];
 3038: 
 3039:       // Compute the centroid of the element and its depth
 3040:       Vector2 center = {0.0, 0.0};
 3041:       elem.depth = 0.0;
 3042:       for (int j = 0; j < i34[i]; j++) {
 3043:          center += elem.nodes[j]->p2()/i34[i];
 3044:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3045:       }
 3046:       elem.center.x = center.x;
 3047:       elem.center.y = center.y;
 3048: 
 3049: 
 3050:       
 3051:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3052:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3053: 
 3054:       elem.area = elem.computeSignedArea(); 
 3055:       elem.radius = sqrt(elem.area)/pi; 
 3056:       
 3057:       // Determines which way the normal vector to each side is oriented.
 3058:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3059:       for (int j = 0; j < i34[i]; j++)  
 3060:       {
 3061:          if (elem.sides[j]->elems[0] == &elem) {
 3062:             elem.ssign[j] =  1.0;
 3063:          }
 3064:          else {
 3065:             elem.ssign[j] = -1.0;
 3066:          }
 3067: 
 3068:       }
 3069: 
 3070:       // Derivatives of shape functions
 3071:       //  For ics=2, this is done inside element/ll frame XXX
 3072:       //  For quads, the derivative is evaluated at centroid
 3073:       const int i34 = elem.i34;
 3074:       for (int j = 0; j < i34; j++) {
 3075:          const double area = elem.area;
 3076:          const int id2 = elem.nxq(1 + j);
 3077:          const int id3 = elem.nxq(2 + j);
 3078:          const int id4 = elem.nxq(3 + j);
 3079:          if (elem.isTri()) {
 3080:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3081:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3082:             // da1/dx = (y1 - y2)/(2*area)
 3083:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3084:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3085:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3086:          }
 3087:          else  { // Quad; evaluate at centroid
 3088:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3089:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3090:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3091:          } // if Tri
 3092: 
 3093:       } // for j
 3094: 
 3095:    }
 3096: 
 3097: 
 3098:    // Processing the boundary nodes
 3099:    int idx = 0;
 3100:    for (int iseg = 0; iseg < nope; iseg++) {
 3101:       // for each segment...
 3102:       
 3103:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3104:          // for each node on the segment...
 3105: 
 3106:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3107: 
 3108:          nodeBnd->isEssentialBC = true;
 3109:          nodeBnd->elbc = 0.0;
 3110: 
 3111:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3112: 
 3113:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3114:             nodeBnd->efa[jfr] = efa[idx];
 3115:             nodeBnd->emo[jfr] = emo[idx];
 3116:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3117:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3118: 
 3119:          }
 3120: 
 3121:          idx++;
 3122:       }
 3123: 
 3124:    }
 3125: 
 3126: }
 3127: 
 3128: 
 3129: 
 3130: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3131:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3132:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3133:    // 
 3134:    // This kernel is called for all nodes.
 3135: 
 3136: 
 3137:    NODE(node1);
 3138: 
 3139: 
 3140:    node1->clearMatrixRow();
 3141:    node1->qel = 0.0;
 3142: 
 3143:    // THIS IS FOR STRUCTURES XXX
 3144:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3145: 
 3146:    
 3147:    for (int j=0; j<node1->numElements; j++) {
 3148:       // For each element connected to the node...
 3149: 
 3150:       Element *elem = node1->elements[j];
 3151: 
 3152:       // Compute the average gravity
 3153:       const double grav3 = elem->mean(&Node::grav2);
 3154: 
 3155:       // Look at the documentation for the description of the terms in the following integrals
 3156: 
 3157:       // Integral I_1 
 3158:       // \bar{\breve{H}} 
 3159:       const double hhatb = elem->mean(&Side::hhat);        
 3160: 
 3161: 
 3162:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3163: 
 3164:       const int id1 = elem->nodeLocalIdx(node1); 
 3165:       const double area = elem->area;
 3166: 
 3167:       if (elem->isTri()) {
 3168: 
 3169:          // To clarify the notation in this section: 
 3170:          //   i stands for the node under consideration (node1)
 3171:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3172:          const int id2 = elem->nxq(1 + id1);
 3173:          const int id3 = elem->nxq(2 + id1);
 3174:          Node *node2 = elem->nodes[id2];
 3175:          Node *node3 = elem->nodes[id3];
 3176: 
 3177:          const Point2 x1 = node1->p2();
 3178:          const Point2 x2 = node2->p2();
 3179:          const Point2 x3 = node3->p2();
 3180: 
 3181:          // integral of phi_i*phi_j
 3182:          const double ipp_ii = (1.0/6.0 )*area;
 3183:          const double ipp_ij = (1.0/12.0)*area;
 3184:          const double ipp_ik = (1.0/12.0)*area;
 3185: 
 3186:          // integral of [(grad phi_i) * (grad phi_j)]
 3187:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3188:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3189:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3190: 
 3191:          // Computes the different components of integral I_1 of each node with respect to node i.
 3192:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3193:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3194:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3195: 
 3196:          node1->addToSparseMatrix(node1, I1_ii);
 3197:          node1->addToSparseMatrix(node2, I1_ij); 
 3198:          node1->addToSparseMatrix(node3, I1_ik);
 3199: 
 3200:       }
 3201:       else { // Quad
 3202:          // XXX IMPLEMENT THIS
 3203:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3204:       } 
 3205: 
 3206:  
 3207:       // Integral I_4
 3208:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3209:       // Where
 3210:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3211: 
 3212:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3213:       // of U over the element.
 3214:       Vector2 Umean = {0.0, 0.0};
 3215:       for (int m=0; m<elem->i34; m++) {      
 3216:          const Side *side = elem->sides[m];
 3217: 
 3218:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3219:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3220:       }
 3221:       Umean = Umean/elem->i34;
 3222: 
 3223:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3224: 
 3225:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3226:       const double I_4_1 = dot(gradPhi_1, Umean);
 3227: 
 3228:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3229:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3230:      
 3231: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3232: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3233:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3234: 
 3235:       // Additional terms 
 3236:       double vnorm = 0.0;
 3237:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3238:          Vector3 ubed;
 3239:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3240: 
 3241:          Vector3 gradP = {0.0, 0.0, 1.0};
 3242:          for (int m=0; m < elem->i34; m++) {
 3243:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3244:            gradP += toVector3(gradP_2D, 0.0);
 3245:          }   
 3246:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3247:       } // imm==2
 3248: 
 3249:       if (elem->isTri()) {
 3250:          for (int l=0; l<3; l++) {
 3251:             double fac;
 3252: 
 3253:             Node *node = elem->nodes[l];
 3254: 
 3255:             fac = (node == node1) ? 2.0 : 1.0;
 3256:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3257:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3258: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3259:            
 3260:          }
 3261: 
 3262: 
 3263:          if (!elem->isDry) {
 3264:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3265: 
 3266:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3267: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3268:          }
 3269: 
 3270:       } // isTri
 3271:       else { // isQuad
 3272:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3273:          // for (int l=0; l<4; l++) {
 3274:          //   const Node *node = elem->nodes[l];
 3275: 
 3276:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3277:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3278: 
 3279:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3280:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3281:          // }
 3282: 
 3283:       } // isQuad
 3284: 
 3285: 
 3286:       node1->qel += (dt/elem->i34)*elem->vsource;
 3287:       
 3288: 
 3289:    } // for all elements connected to the node
 3290:    
 3291: 
 3292: 
 3293:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3294:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3295:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3296:    if (nodeBnd != nullptr)  { 
 3297:       // If it is an open boundary node...
 3298: 
 3299:       // At least one open bnd side, maybe two
 3300:       for (int l=0; l<2; l++) { 
 3301: 
 3302:          // Gets each of the sides sharing the node. 
 3303:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3304: 
 3305:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3306: 
 3307:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3308: 
 3309:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3310:          if (sideBnd != nullptr) {
 3311:             // If the side is on a boundary...
 3312: 
 3313:             // Get the boundary segment
 3314:             const BoundarySegment *sideSegment = sideBnd->segment;
 3315:             const Side *side = sideBnd->side;
 3316: 
 3317:             // Integral I_3
 3318:             if (sideSegment->ifltype != 0) {
 3319:             // Natural or Flather b.c.
 3320: 
 3321:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3322:                // especially for Flather b.c.
 3323:                double ri3 = 0.0;
 3324:                if (!side->isDry) {
 3325:                   // If the side is not dry
 3326:                   
 3327:                   // Computes the side flux of (uth, vth)
 3328:                   double Vn = 0.0;
 3329:                   for (int k = side->kb; k<nvrt-1; k++) {
 3330:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3331:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3332: 
 3333:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3334:                   }
 3335: 
 3336:                   ri3 = 0.5*side->len*Vn;
 3337:                }
 3338: 
 3339:                if (sideSegment->ifltype == -1) { // Flather 1
 3340: 
 3341:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3342:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3343: 
 3344:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3345:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3346:                   
 3347:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3348:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3349: 
 3350:                } 
 3351:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3352:                   // Reset ri3
 3353:                   ri3 = 0.0;
 3354: 
 3355:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3356: 
 3357:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3358: 
 3359:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3360:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3361: 
 3362:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3363:                   node1->addToSparseMatrix(node1, con0*2.0);
 3364:                   node1->addToSparseMatrix(node2, con0);
 3365: 
 3366:                } // if Flather or Discharge
 3367: 
 3368:                node1->qel -= thetai*dt*ri3;
 3369: 
 3370:             } // I_3
 3371:           
 3372: 
 3373:             // Integral I_5
 3374:             if(!side->isDry) {
 3375: 
 3376:                const double Unbar = dot(side->U, side->n);
 3377:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3378: 
 3379:             } // I_5
 3380: 
 3381:          } // if is boundary side
 3382: 
 3383:       } // for l
 3384: 
 3385:    } // if isbnd
 3386: 
 3387: 
 3388: }
 3389: 
 3390: 
 3391: 
 3392: extern "C" {
 3393:    __global__ void rollUpElevation(void) {
 3394: 
 3395:       NODE(node);
 3396: 
 3397:       node->eta1 = node->eta2;
 3398: 
 3399:    }
 3400: 
 3401: 
 3402:    __global__ void backtrackAllNodes(void) {
 3403: 
 3404:       // max/min # of sub-divisions
 3405:       const int ndelt_max = max(1.0, dt/dtb_min);
 3406:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3407: 
 3408:       // Removed all references to swild98 XXX
 3409:       // swild98=0.d0 !init
 3410: 
 3411: 
 3412:       SIDE(side);
 3413: 
 3414:       const int kb = side->kb;
 3415: 
 3416: 
 3417:       // Initialize btrack velocities to the actual velocities at the side 
 3418:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3419: 
 3420:       if (side->isDry) return;
 3421: 
 3422: 
 3423:       // Checks that at least one element is not dry
 3424:       const Element *elem1 = side->elems[0];
 3425:       const Element *elem2 = side->elems[1];
 3426: 
 3427: 
 3428:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3429:       
 3430:       // XXXXXX
 3431:       // !swild_tmp to store global coord. of the starting side
 3432:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3433:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3434:       // !Use sframe2 
 3435:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3436: 
 3437: 
 3438:       for (int k = kb; k < nvrt; k++) {
 3439:       //  Initialize (xt,yt,zt), nnel and vel.
 3440:       //  For ics=2, the coordinates are in local frames
 3441:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3442: 
 3443: 
 3444:          const int iadvf = side->iadv();  // Advection flag
 3445: 
 3446:          Point3 xt;
 3447:          if constexpr(ics==1) {
 3448:             xt = side->center3D(k); 
 3449:          }
 3450:          else // lat/lon; in side lat/lon frame
 3451:          {
 3452:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3453:          // XXX IMPLEMENT THIS
 3454:       //          xt=0.d0
 3455:       //          yt=0.d0
 3456:       //          !centroid coord. for nudging
 3457:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3458:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3459:          }  // ics
 3460: 
 3461: 
 3462: 
 3463:          // If on land or open boundary...
 3464:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3465:          
 3466:          const double vmag = length(side->u2[k]);
 3467: 
 3468:          if (vmag <= velmin_btrack) {
 3469:             // No activity 
 3470: 
 3471:             side->btu[k] = side->u2[k];
 3472:             
 3473:          } else {  // do btrack
 3474: 
 3475:             // Compute number of sub-divisions based on local gradients 
 3476:             // XXX IS THIS NECESSARY?
 3477:             double suma = 0.0;
 3478:             int icount = 0;
 3479:             for (int ii=0; ii<2; ii++) {
 3480: 
 3481:                const Element *elem = side->elems[ii];
 3482:                  
 3483:                if (elem == nullptr) continue;
 3484: 
 3485:                icount++;
 3486: 
 3487:                // Not strictly along z; in ll frame for ics=2
 3488: 
 3489:                double utmp[4];
 3490:                double vtmp[4];
 3491:                for (int jj = 0; jj < elem->i34; jj++) {
 3492: 
 3493:                   const Node *node = elem->nodes[jj];
 3494: 
 3495:                   if constexpr(ics==1) {
 3496:                      utmp[jj] = node->u2[k].x;
 3497:                      vtmp[jj] = node->u2[k].y;  
 3498:                   } else {
 3499:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3500:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3501:                   }
 3502:                } // for jj
 3503: 
 3504:                const Vector2 grad_u = elem->grad2(utmp); 
 3505:                const Vector2 grad_v = elem->grad2(vtmp);
 3506: 
 3507:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3508:             } // for ii
 3509: 
 3510:             assert(icount > 0 && "Impossible 77");
 3511: 
 3512:             // '4' is somewhat arbitrary
 3513:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3514: 
 3515:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3516:          
 3517: 
 3518:             Vector3 u_int = {0.0, 0.0, 0.0};
 3519: 
 3520:             side->btrack(k, dt, dtbk, u_int);
 3521:             side->btu[k] = toVector2(u_int);
 3522:                
 3523:          } // if vmag (do backtrack)
 3524: 
 3525:       } // for j=jmin,nvrt-1
 3526: 
 3527:    }
 3528: } // extern "C"
 3529: 
 3530: template<int nc>
 3531: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3532: 
 3533: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3534: //
 3535: // a,b,c,rhs: input vectors and are not modified by this program.
 3536: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3537: // rhs is the r.h.s.
 3538: // n: actual rank of the system.
 3539: // rows in u() and rhs();
 3540: // u: output with nc columns (transposed to rows)
 3541: // gam: a working array.
 3542: //
 3543: // NOTES:
 3544: // This is a template function that allows for different numbers of columns in the rhs vector.
 3545: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3546: 
 3547:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3548:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3549: // printf("AAAAAA a[0] = %f, b[0] = %f, c[0] = %f, rhs[0] = %f\n", a[0], b[0], c[0], rhs[0]);   
 3550: 
 3551:    double bet = b[0];
 3552:    if constexpr (nc == 1) {
 3553:       u[0] = rhs[0]/bet;
 3554:    } else {
 3555:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3556:    }
 3557: 
 3558:    for (int j = 1; j < n; j++) {
 3559:       gam[j] = c[j - 1]/bet;
 3560:       bet = b[j] - a[j]*gam[j];
 3561: // printf("RRR bet = %f, b[%d] = %f, a[%d] = %f, gam[%d] = %f\n", bet, j, b[j], j, a[j], j, gam[j]);
 3562:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3563: 
 3564:       if constexpr (nc == 1) {
 3565:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3566:       } else {
 3567:          for (int l = 0; l < nc; l++) {
 3568:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3569:          }
 3570:       }
 3571:    }
 3572: 
 3573:    // Back-substitution
 3574:    for (int j=n-1; j>=0; j--) {
 3575:       if constexpr (nc == 1) {
 3576:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3577:       } else {
 3578:          for (int l = 0; l < nc; l++) {
 3579:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 3580:          }
 3581:       }
 3582:    }
 3583: }
 3584: 
 3585: 
 3586: 
 3587: // Helper function that contains the core algorithm
 3588: template<typename XAccessor, typename YAccessor>
 3589: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3590:                                     double  yp_top, double  yp_bot, 
 3591:                                     CubicSpline &spline) {
 3592:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3593:    // 
 3594:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3595:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3596:    //
 3597:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3598:    // 
 3599:    // Inputs: 
 3600:    //            n: dimension for x etc; # of data pts (>=2);
 3601:    //            getX, getY: functions to access x,y coordinates
 3602:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3603:    //     Output: 
 3604:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3605: 
 3606:    const int n = k2 - k1 + 1;
 3607:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3608: 
 3609:    // Allocate memory for the splines
 3610:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3611:    spline.x   = new double[n];
 3612:    spline.y   = new double[n];
 3613:    spline.yp  = new double[n];
 3614:    spline.ypp = new double[n];
 3615: 
 3616:    for (int k=k1; k<=k2; k++) {
 3617:       spline.x[k] = getX(k);
 3618:       spline.y[k] = getY(k);
 3619:    }
 3620: 
 3621:    // This is to simplify expressions later
 3622:    double *x = spline.x;
 3623:    double *y = spline.y;
 3624: 
 3625:    double *a = nullptr;
 3626:    double *b = nullptr;
 3627:    double *c = nullptr;
 3628:    double *gam = nullptr;
 3629:    double *rhs = nullptr;
 3630:    
 3631: 
 3632:       a = new double[n];   // Lower diagonal
 3633:       b = new double[n];   // Diagonal
 3634:       c = new double[n];   // Upper diagonal
 3635:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3636:       rhs = new double[n]; // Right-hand side
 3637: 
 3638:    for (int k=k1; k<=k2; k++) {
 3639:       if (k == k1) {
 3640:          // Bottom level
 3641:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3642:          b[k] = (x[k+1] - x[k])/3.0;
 3643:          c[k] = b[k]/2.0;
 3644:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3645:       } else if (k == n - 1) {
 3646:          // Top level (surface)
 3647:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3648:          b[k] = (x[k] - x[k-1])/3.0;
 3649:          a[k] = b[k]/2.0;
 3650:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3651:       } else {
 3652:          // Intermediate levels
 3653:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3654:          b[k] = (x[k+1] - x[k-1])/3.0;
 3655:          a[k] = (x[k  ] - x[k-1])/6.0;
 3656:          c[k] = (x[k+1] - x[k  ])/6.0;
 3657:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3658:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3659:       }
 3660:    }
 3661: 
 3662:    // Solve the tridiagonal system
 3663:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3664:    
 3665:    spline.yp[k1] = yp_bot;
 3666:    spline.yp[k2] = yp_top;
 3667: 
 3668:    // Compute rest of 1st derivatives using the splines
 3669:    for (int k=k1+1; k<k2; k++) {
 3670:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3671:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3672:    }
 3673:    
 3674:    delete[] a;
 3675:    delete[] b;
 3676:    delete[] c;
 3677:    delete[] gam;
 3678:    delete[] rhs;
 3679: 
 3680: }
 3681: 
 3682: // Array version
 3683: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3684:                                 double y_top, double y_bot, 
 3685:                                 CubicSpline &spline) {
 3686:    auto getX = [x] (int k) { return x[k]; };
 3687:    auto getY = [y] (int k) { return y[k]; };
 3688:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3689: }
 3690: 
 3691: // Lambda version - allows custom access patterns
 3692: template<typename XFunc, typename YFunc>
 3693: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3694:                                 double y_top, double y_bot,
 3695:                                 CubicSpline &spline) {
 3696:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3697: }
 3698: 
