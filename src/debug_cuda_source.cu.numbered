  494: 
  495: // Polynomial class
  496: template<int grade>
  497: struct Polynomial {
  498:     // Static assertion to give a clear error message at compile time
  499:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  500: };
  501: 
  502: 
  503: // Explicit specialization for grade 4
  504: template<>
  505: struct Polynomial<4> {
  506:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  507: 
  508:    // Constructor from coefficients
  509:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  510: 
  511:    __device__ __forceinline__ double eval(double x) const {
  512:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  513:    }
  514: };
