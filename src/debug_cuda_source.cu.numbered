 6522: 
 6523: __global__ void computeMatrixProductAndDotProducts() {
 6524:    // Computes A*p, r'Mr and p'Ap
 6525: 
 6526:    // 1) shared buffer: first half for rMr, second for pAp
 6527:    __shared__ double sdata[2*BLOCK_SIZE];
 6528:    double* s_rMr = sdata;
 6529:    double* s_pAp = sdata + BLOCK_SIZE;
 6530: 
 6531:    s_rMr[threadIdx.x] = 0.0;
 6532:    s_pAp[threadIdx.x] = 0.0;
 6533: 
 6534:    // 2) get your node pointer
 6535:    NODE(node);  
 6536:    const int tid = threadIdx.x;
 6537: 
 6538:    const double diag = node->coeffDiag;
 6539:    const double r    = node->mR;
 6540:    const double p    = node->mP;  
 6541: 
 6542:    // apply preconditioner on the fly:
 6543:    const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 6544: 
 6545:    // 4) compute Ap = A.p
 6546:    double Ap = node->coeffDiag * node->mP;
 6547:    for (int j = 0; j < node->numNodes; ++j) {
 6548:       const Node *nbNode = node->nodes[j];
 6549:       Ap += node->coeffMatrix[j] * nbNode->mP;
 6550: 
 6551:    }
 6552:    node->mAp = Ap;
 6553:     
 6554: 
 6555:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 6556:    const double l_rMr = r*Mr;  // r'Mr
 6557:    const double l_pAp = p*Ap;  // p'Ap
 6558: 
 6559:    // 6) write into shared mem
 6560:    s_rMr[tid] = l_rMr;
 6561:    s_pAp[tid] = l_pAp;
 6562: 
 6563:    __syncthreads();
 6564: 
 6565:    // 7) block-wide tree reduction
 6566:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6567:       if (tid < stride)  s_pAp[tid] += s_pAp[tid + stride];
 6568:       __syncthreads();
 6569:    }
 6570: 
 6571:    // 8) thread 0 atomically accumulates into the globals
 6572:    // XXX: This is slower than it needs to be, but it is simple and works
 6573:    if (tid == 0) atomicAdd(pAp, s_pAp[0]);
 6574: 
 6575: 
 6576: }
 6577: 
 6578: 
 6579: __global__ void updateSolutionAndDotProducts(void) {
 6580:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 6581: 
 6582:    s_rMr[threadIdx.x] = 0.0;
 6583: 
 6584: 
 6585:    // get node & bounds-check:
 6586:    NODE(node);
 6587:    const int tid = threadIdx.x;
 6588: 
 6589: 
 6590:    // Compute alpha
 6591:    const double alpha = (*rMr_old)/(*pAp);
 6592: 
 6593:    // load scalars
 6594:    const double diag = node->coeffDiag;
 6595:    const double p    = node->mP;
 6596:    const double Ap   = node->mAp;
 6597:    const double x    = node->mX;
 6598:    const double r    = node->mR;
 6599:    
 6600:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 6601: 
 6602:    // 1) update solution & residual
 6603:    const double x_new = x + alpha*p;
 6604:    const double r_new = r - alpha*Ap;
 6605:    node->mX = x_new;
 6606:    node->mR = r_new;
 6607: 
 6608:    // 2) apply Jacobi preconditioner on the fly
 6609:    const double Mr_new = r_new/diag;
 6610: 
 6611: 
 6612:    // 3) local contributions for the two dot-products
 6613:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 6614: 
 6615:    // 4) write into shared-mem
 6616:    s_rMr[tid] = l_rMr;
 6617: 
 6618:    __syncthreads();
 6619: 
 6620: 
 6621:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6622:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6623:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6624:       __syncthreads();
 6625:    }
 6626: 
 6627:    // 6) thread 0 atomically folds into the global accumulators
 6628:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 6629: 
 6630: 
 6631: }
 6632: 
 6633: 
 6634: __global__ void updateSearchDirection() {
 6635:     NODE(node);
 6636: 
 6637:     // recompute z on-the-fly
 6638:     const double z = node->mR / node->coeffDiag;
 6639:     const double p = node->mP;
 6640: 
 6641:     const double beta = (*rMr_new)/(*rMr_old);
 6642: 
 6643: // printf("ZZZ updateSearchDirection: beta = %f\n", beta);
 6644: 
 6645:     // p =z + beta*p
 6646:     node->mP = z + beta*p;
 6647: 
 6648: }
 6649: 
 6650: __global__ void initializePreconditionedResidual(double *scalars) {
 6651: 
 6652:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 6653: 
 6654:     s_rMr[threadIdx.x] = 0.0;
 6655: 
 6656:     NODE(node);
 6657:     const int tid = threadIdx.x;
 6658:     // For the first iteration:
 6659:     // 1. Initial solution x = 0 (already set)
 6660:     // 2. Initial residual r = b (stored in qel)
 6661:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 6662: 
 6663: // XXX we should use the guess solution here    
 6664: 
 6665:     // Set initial residual r = b (from qel)
 6666:     node->mR = node->qel;
 6667: 
 6668:     // Compute z = M^-1 * r (preconditioned residual)
 6669:     const double z = node->mR / node->coeffDiag;
 6670: 
 6671:     // Set initial search direction p = z
 6672:     node->mP = z;
 6673: 
 6674:     // Initialize other variables needed for CG
 6675:     node->mX = 0.0;  // Initial solution
 6676:     node->mAp = 0.0; // Will be computed in first iteration
 6677: 
 6678:     // These point to a cupy array in the host code
 6679:     rMr_old = scalars + 0;
 6680:     rMr_new = scalars + 1;
 6681:     pAp     = scalars + 2;
 6682: 
 6683:     // Computes the first r'Mr (reduction)
 6684:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 6685: 
 6686:     // 4) write into shared-mem
 6687:     s_rMr[tid] = l_rMr;
 6688: 
 6689:     __syncthreads();
 6690: 
 6691: 
 6692:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 6693:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 6694:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 6695:         __syncthreads();
 6696:     }
 6697: 
 6698:     // 6) thread 0 atomically folds into the global accumulators
 6699:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 6700: 
 6701:     *rMr_old = 0.0;
 6702:     *pAp = 0.0;
 6703: }
