 8597: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8598:    // Get the value of a variable from an side
 8599:    // varName is the name of the variable to get
 8600:    // var is the array to store the value
 8601:    // k is the vertical level index of the variable to get
 8602:    SIDE_BND(sideBnd);   
 8603: 
 8604:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8605:    if (sideBnd->segment->isLand) idx = -7;
 8606: 
 8607:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8608:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8609: 
 8610: }
