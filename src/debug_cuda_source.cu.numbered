 7716: __global__ void returnMatrix(double *res) {
 7717:    // Debugging: returns the matrix as a CuPy array
 7718: 
 7719:    const int size = mesh->np;
 7720:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7721:       const Node *node = mesh->localNodeData + idx_node;
 7722:       res[idx_node*size + idx_node] = node->coeffDiag;
 7723:       for (int j = 0; j < node->numNodes; j++) {
 7724:          Node* nbNode = node->nodes[j];
 7725:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7726:       }
 7727: 
 7728:    }
 7729:    
 7730: }
