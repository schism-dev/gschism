  362: 
  363: struct Frame {
  364:    double _t[9]; // t stands for tensor.
  365: 
  366:    // Access the tensor in Fortran order
  367:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  368: 
  369:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  370: 
  371:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  372: 
  373:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  374:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  375:       sincos(ar2, &sin_ar2, &cos_ar2);
  376: 
  377:       t(0,0) = -sin_ar1;
  378:       t(1,0) =  cos_ar1;
  379:       t(2,0) =  0.0;
  380:       t(0,1) = -cos_ar1*sin_ar2;
  381:       t(1,1) = -sin_ar1*sin_ar2;
  382: 
  383:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  384: 
  385:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  386:       assert (ar4!=0.0 && "GRID: ar4=0");
  387: 
  388:       const double ar4_inv = 1.0/ar4;
  389:       t(0,1) = t(0,1)*ar4_inv;
  390:       t(1,1) = t(1,1)*ar4_inv;
  391:       t(2,1) = t(2,1)*ar4_inv;
  392: 
  393:       // The third vector is the cross product of the first two
  394:       crossProduct(t(0,0), t(1,0), t(2,0), 
  395:                    t(0,1), t(1,1), t(2,1), 
  396:                    t(0,2), t(1,2), t(2,2));
  397:    }
  398: 
  399: 
  400:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  401:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  402:    // Inputs:
  403:    //        vec0: vel. in this frame;
  404:    //        frameout: Output frame;
  405:    // Output: 
  406:    //        vec1: vel. in new frame  
  407: 
  408:       auto const fo = frameout;
  409:       Vector2 vec1;
  410: 
  411:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  412:       // of t and fo.t are the same.
  413:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  414:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  415: 
  416:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  417:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  418: 
  419:       return vec1;
  420:    }
  421: 
  422:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  423:       // Transform a vector from global to local frame
  424:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  425:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  426:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  427:    }
  428: 
  429:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  430:       // Transform a vector from local to global frame
  431:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  432:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  433:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  434:    }   
  435: 
  436:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  437:    // Tranforms a point from global to local frame     
  438:       G2L(pi - origin0, po);
  439:    }
  440: 
  441:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  442:    // Transforms a point from local to global frame      
  443:       L2G(pi, po);
  444:       po = po + origin0;
  445:    }
  446: 
  447: };
