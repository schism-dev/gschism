 2594:    template<typename T>
 2595:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2596:       T values[4];
 2597:       getSideValues(field, values);
 2598:       
 2599:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2600:       if constexpr (IsVector2<T>::value && ics == 2) {
 2601: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2602:          projectSideVectorsToElementFrame(values);
 2603: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2604:       }
 2605: 
 2606:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2607:    }   
