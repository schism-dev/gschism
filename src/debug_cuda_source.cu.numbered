 8654: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8655:    // Get the value of a variable from an side
 8656:    // varName is the name of the variable to get
 8657:    // var is the array to store the value
 8658:    // k is the vertical level index of the variable to get
 8659:    SIDE_BND(sideBnd);   
 8660: 
 8661:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8662:    if (sideBnd->segment->isLand) idx = -7;
 8663: 
 8664:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8665:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8666: 
 8667: }
