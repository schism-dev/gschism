 1748: // Helper functions for computing the local node index at a given offset from another.
 1749: __device__ __inline__ int nxq(int offset, int index, int size) {
 1750:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1751:    // to the index to make it positive
 1752:    assert(index + offset + 16*size >= 0);
 1753:    return (index + offset + 16*size) % size;  
 1754: }
 1755: 
 1756: __device__ __inline__ int nxq(int index, int size) {
 1757:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1758:    // to the index to make it positive
 1759:    assert(index + 16*size >= 0);
 1760:    return (index + 16*size) % size; 
 1761: }
