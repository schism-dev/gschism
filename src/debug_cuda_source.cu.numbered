 9878: extern "C" __global__ void getElementVarFunc(int varCode, double *res) {
 9879: 
 9880:    ELEM(elem);
 9881: 
 9882:    switch (varCode) {
 9883:       case (int)VarCode::outputCoords:
 9884:          const Point2 coords = elem->outputCoords();
 9885:          res[elem->idx*2    ] = coords.x;
 9886:          res[elem->idx*2 + 1] = coords.y;
 9887:          break;
 9888:    }
 9889: }
