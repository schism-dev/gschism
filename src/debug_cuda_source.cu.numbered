 4122:    __global__ void scaleGravity(double loadtide_coef) {
 4123: 
 4124: 
 4125:       NODE(node);
 4126: 
 4127:       // SAL option: scale gravity
 4128:       if constexpr(iloadtide==2) {  // simple const
 4129:          node->grav2 = grav*(1.0 - loadtide_coef);
 4130: 
 4131:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4132:         
 4133:           const double depth = max(node->depth, 0.0);
 4134:           const double tmp1 = sqrt(depth);
 4135:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4136:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4137:                              2.6969e-13*depth*depth*depth*tmp1;
 4138:           
 4139:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4140:           
 4141: 
 4142: 
 4143:           node->grav2 = grav*(1.0 - beta_bar);
 4144: 
 4145:       } else {  // iloadtide=0,1
 4146:         node->grav2=grav;
 4147: 
 4148:       }
 4149: 
 4150:    }
