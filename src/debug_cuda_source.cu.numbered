 6747: #ifdef DONTCOMPILE
 6748: __device__ void computeVerticalAdvection(void) {
 6749:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6750: 
 6751:    sdbt(1:2,:,:)=0.d0
 6752: 
 6753:    const Side *side = FROM kernel;
 6754: 
 6755:    if(side->isDry) return;
 6756: 
 6757:    // If side is wet...
 6758: 
 6759: 
 6760:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6761:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6762:    double ws[nvrt] = {} // w @ side
 6763:    int icount = 0;
 6764:    for (int j=0; j<2; j++) {
 6765:       const Element *elem = side->elements[j];
 6766:        
 6767:       if(elem != nullptr) {
 6768:          icount++;
 6769:          for (int k=0; k<nvrt; k++) {
 6770:             ws[k] = ws[k] + elem->w[k];
 6771:          }
 6772:       }
 6773:    }  // for j
 6774: 
 6775:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6776:    ws = ws/icount;
 6777: 
 6778:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6779:    // Splines allow for a smooth transition between vertical levels.
 6780:    // Splines have continuity restrictions at the internal knots, but
 6781:    // we have to provide the 1st derivatives at the endpoints.
 6782:    const int kbs = side->kbs; 
 6783:    
 6784:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6785:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6786:    initCubicSpline(kbs, nvrt, side, ws, up)
 6787: 
 6788:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6789:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6790:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6791: 
 6792:    // Total advection (average onto side)
 6793:    const Node *node1 = side->nodes[0];
 6794:    const Node *node2 = side->nodes[1];
 6795:    for (int k=kbs(i); k<nvrt; k++) {
 6796: 
 6797:       if constexpr(ics==1) {
 6798:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6799:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6800:       } else {
 6801:          // XXX IMPLEMENT THIS
 6802:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6803:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6804:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6805:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6806:       }  // if ics
 6807: 
 6808: 
 6809:    }
 6810: }
 6811: #endif
