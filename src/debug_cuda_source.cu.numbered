 2162: __device__ __inline__ double min3(double a, double b, double c) {
 2163:    return min(a, min(b, c));
 2164: }
 2165: 
 2166: __device__ __inline__ double max3(double a, double b, double c) {
 2167:    return max(a, max(b, c));
 2168: }
 2169: 
 2170: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2171:    return min(a, min(b, min(c, d)));
 2172: }
