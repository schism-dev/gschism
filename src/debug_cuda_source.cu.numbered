 4014: 
 4015:    __global__ void computeFlowBcVelocities(double time) {
 4016: 
 4017:       SIDE_BND(sideBnd);
 4018: 
 4019:       const Side *side = sideBnd->side;
 4020:  
 4021:       const bool isDry = side->isDry;
 4022: 
 4023:       if (isDry) {
 4024:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4025:          return;
 4026:       }
 4027: 
 4028:       // For wet sides in open boundaries...
 4029:       const Vector2 n = side->n;
 4030:       const BoundarySegment *segment = sideBnd->segment;
 4031: 
 4032:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4033: 
 4034:       const int ifltype = segment->ifltype;
 4035:       const int iettype = segment->iettype;
 4036: 
 4037:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4038:       const Vector2 r_nuth0 = r_uth0*n;
 4039: 
 4040:       for (int k = 0; k < nvrt; k++) {
 4041:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4042:          Vector2 r_u1_bar = {0.0, 0.0};
 4043:       
 4044:          if (ifltype == 1 || ifltype == 2) {
 4045:          
 4046:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4047: 
 4048:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4049:             
 4050:             r_uth = unth0*n;  // This case has no ramp-up
 4051:             
 4052:          } else if (ifltype == -1) { // Flather 1
 4053: 
 4054:             // uth is the normal vel.; no ramp up
 4055:             const double uth = sideBnd->nuth(k);
 4056:             r_uth = uth*n;
 4057:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4058: 
 4059: 
 4060:          } else if (ifltype == 3 || ifltype == 5) {
 4061:             // vnth0=0 !normal vel.
 4062: 
 4063:             // Computes the contribution to the velocity from all tide frequencies
 4064:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4065: 
 4066:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4067:                const Vector2 umo  = sideBnd->umo(jfr); 
 4068: 
 4069:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4070:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4071:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4072:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4073:             }
 4074: 
 4075:          } // if (ifltype = 3 || ifltype == 5
 4076: 
 4077: 
 4078:          switch (iettype) {
 4079:             case 1:
 4080:             case 2:
 4081:             case 4:
 4082:                sideBnd->ubc[k] = r_uth;
 4083:                break;
 4084:             case 3:
 4085:                sideBnd->ubc[k] = r_u1_bar;
 4086:                break;
 4087:             case 5:
 4088:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4089:                break;
 4090:          } // switch
 4091: 
 4092:       } // for k
 4093:    }
 4094: 
 4095:    __global__ void computeElevationBoundaryConditions(double time) {
 4096:       // Compute elevation essential boundary conditions 
 4097: 
 4098:       NODE_BND(nodeBnd); // Each boundary node.
 4099: 
 4100:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4101: 
 4102:       const Node *node = nodeBnd->node;
 4103:       const BoundarySegment *segment = nodeBnd->segment;
 4104:       const int iettype = segment->iettype;
 4105:       
 4106: 
 4107:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4108:       double eic = 0.0;
 4109:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4110:       else                 eic = 0.0;
 4111: 
 4112:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4113:       const double r_eth = ramp*nodeBnd->eth;
 4114:       double r_eta1_bar = 0.0;
 4115: 
 4116: 
 4117:       // Compute tide elevation
 4118:       if (iettype == 3 || iettype == 5) {   
 4119: 
 4120:          if constexpr(iloadtide==1) { // loading tide
 4121:             assert(false && "Loading tide not implemented");
 4122:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4123:          }
 4124:          
 4125:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4126: 
 4127:             const double efa  = nodeBnd->efa[jfr]; 
 4128:             const double emo  = nodeBnd->emo[jfr]; 
 4129: 
 4130:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4131:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4132:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4133: 
 4134:          } // for jfr
 4135: 
 4136:       } // if iettype
 4137: 
 4138:       switch (iettype) {
 4139:          case 1:
 4140:          case 2:
 4141:          case 4:
 4142:             nodeBnd->elbc = r_eic + r_eth;
 4143:             break;
 4144:          case 3:
 4145:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4146:             break;
 4147:          case 5:
 4148:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4149:             break;
 4150:       } // switch
 4151: 
 4152: 
 4153:       //Add inverse barometric effects
 4154:       if (iettype != 0 && inv_atm_bnd == 1) {
 4155:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4156:       }
 4157: 
 4158:    }
 4159: 
 4160: 
 4161:    __global__ void computeHorizontalViscosity(void) { 
 4162: 
 4163:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4164: 
 4165:       SIDE(side);
 4166: 
 4167:       if (side->isDry) return;
 4168: 
 4169:       for (int k = 0; k < nvrt; k++) {
 4170:          side->nuGradU[k] = {0.0, 0.0};
 4171:       }
 4172: 
 4173:       if constexpr(ihorcon == 1) {
 4174:          for (int k = side->kb; k < nvrt - 1; k++) {
 4175:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4176:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4177:             // By Zhang and Baptista.
 4178: 
 4179:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4180:             // This is a standard discretization of the Laplacian operator.
 4181:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4182:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4183:             // Gamma is hvis_coef0 in the code.
 4184:             // The value of gamma needs to be < 0.5.
 4185: 
 4186:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4187:             // side under consideration in each of the two possible elements that share the side.
 4188:             Vector2 sumU = {0.0, 0.0};
 4189:             for (int l = 0; l < 2; l++) {
 4190:                const Element *elem = side->elems[l];
 4191: 
 4192:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4193: 
 4194:                // Find the local index of the side in the element
 4195:                const int idxSide = elem->sideLocalIdx(side);
 4196:                // Find the two sides that are connected to the side under consideration
 4197:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4198:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4199: 
 4200:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4201: 
 4202:             }
 4203: 
 4204:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4205:    
 4206:          }
 4207:       }
 4208:       else if constexpr(ihorcon == 2) {
 4209:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4210:       }
 4211: 
 4212: 
 4213:    }
 4214: 
 4215: 
 4216:    __global__ void setEssentialBC(void) {
 4217:       // Set essential boundary conditions 
 4218:       NODE(node); // Each boundary node
 4219:       NodeBoundary *nodeBnd = node->nodeBnd;
 4220:       
 4221: // nodeBnd->isEssentialBC = true;      
 4222:       // Check if this node has essential BC
 4223:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4224:          // Verify BC value is valid
 4225:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4226: 
 4227:        
 4228:          // Set diagonal to 1 and zero off-diagonals
 4229:          node->coeffDiag = 1.0;
 4230: 
 4231:          for (int j = 0; j < node->numNodes; j++) {
 4232:                node->coeffMatrix[j] = 0.0;
 4233:          }
 4234:          
 4235:          // Set solution and RHS to BC value
 4236:          node->mX  = nodeBnd->elbc;
 4237:          node->qel = nodeBnd->elbc;
 4238: 
 4239:       } else {
 4240:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4241: 
 4242:          for (int j = 0; j < node->numNodes; j++) {
 4243:                Node* nbNode = node->nodes[j];
 4244:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4245:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4246:                   // Verify neighbor's BC value
 4247:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4248: 
 4249:                   // Subtract contribution to RHS
 4250:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4251:                   node->coeffMatrix[j] = 0.0;  
 4252:                }
 4253:          }
 4254:       }
 4255:    }
 4256: 
 4257: 
 4258:    __global__ void updateElevation(void) {
 4259:       NODE(node);
 4260: 
 4261:       node->eta2 = node->mX;
 4262: 
 4263:       node->updateZCoordData();
 4264:    }
 4265: 
