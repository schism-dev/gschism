  505:    Vector2 gradPhi[4];        // Derivatives of shape functions
  506:    Vector2 gradEta;           // Gradient of free surface elevation
  507:    Vector2 gradPr;            // Gradient of pressure    
  508:    Vector2 gradETP;           // Gradient of Earth Tidal Potential    XXXXX Really used?
