 3906: 
 3907: extern "C" {
 3908: 
 3909:    __global__ void scaleGravity(double loadtide_coef) {
 3910: 
 3911: 
 3912:       NODE(node);
 3913: 
 3914:       // SAL option: scale gravity
 3915:       if constexpr(iloadtide==2) {  // simple const
 3916:          node->grav2 = grav*(1.0 - loadtide_coef);
 3917: 
 3918:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3919:         
 3920:           const double depth = max(node->depth, 0.0);
 3921:           const double tmp1 = sqrt(depth);
 3922:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3923:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3924:                              2.6969e-13*depth*depth*depth*tmp1;
 3925:           
 3926:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3927:           
 3928: 
 3929: 
 3930:           node->grav2 = grav*(1.0 - beta_bar);
 3931: 
 3932:       } else {  // iloadtide=0,1
 3933:         node->grav2=grav;
 3934: 
 3935:       }
 3936: 
 3937:    }
 3938: 
 3939: 
 3940:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3941: 
 3942:       NODE_BND(nodeBnd);
 3943: 
 3944:       Node *node = nodeBnd->node;
 3945: 
 3946:       node->ETP = 0.0;
 3947: 
 3948:       for (int j=0; j<ntip; j++) {
 3949: 
 3950:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3951:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3952:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3953: 
 3954:          if constexpr(iloadtide==1) { // loading tide
 3955:             assert(false && "Loading tide not implemented");
