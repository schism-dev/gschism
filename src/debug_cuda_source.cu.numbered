 2112: __device__ __forceinline__ void update_bdef(double time, double x0, double y0, double &dep, Vector3 &vel) {
 2113:    // For imm=2, user needs to update bottom depth and velocity
 2114: 
 2115:    dep = min(1.0, 7.0 - (x0 + time));
