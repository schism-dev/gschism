 6363:    __global__ void resetBoundaryAreas(void) {
 6364:       // Reset boundary areas and lengths for each segment.
 6365: 
 6366:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 6367:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 6368:       SIDE_BND(sideBnd);
 6369: 
 6370:       BoundarySegment *segment = sideBnd->segment;
 6371: 
 6372:       segment->carea = 0.0;
 6373:       segment->clen = 0.0;
 6374:  
 6375:    }
 6376: 
 6377:    __global__ void computeBoundaryAreas(void) {
 6378:    // Calculation of cross-section areas and lengths for flow b.c.
 6379: 
 6380:       SIDE_BND(sideBnd);
 6381: 
 6382:       const Side *side = sideBnd->side;
 6383:       BoundarySegment *segment = sideBnd->segment;
 6384: 
 6385:       if (segment->ifltype != 0) {
 6386: 
 6387:          const Node *n1 = side->n1;
 6388:          const Node *n2 = side->n2;
 6389: 
 6390:          const double htot = side->htot2();
 6391: 
 6392:          if (!side->isDry) {
 6393:             atomicAdd(&segment->carea, htot*side->len);
 6394:             atomicAdd(&segment->clen, side->len);
 6395:          }
 6396:       }
 6397: 
 6398:    }
 6399: 
 6400: 
 6401:    __global__ void computeFlowBcVelocities(double time) {
 6402: 
 6403:       SIDE_BND(sideBnd);
 6404: 
 6405:       const Side *side = sideBnd->side;
 6406:  
 6407:       const bool isDry = side->isDry;
 6408:       const bool isLand = sideBnd->segment->isLand;
 6409: 
 6410:    
 6411:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 6412: 
 6413:       if (isDry || isLand) return;
 6414: 
 6415:       // For wet sides in open boundaries...
 6416:       const Vector2 n = side->n;
 6417:       const BoundarySegment *segment = sideBnd->segment;
 6418: 
 6419:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 6420: 
 6421:       const int ifltype = segment->ifltype;
 6422: 
 6423:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 6424:       const Vector2 r_nuth0 = r_uth0*n;
 6425: 
 6426: 
 6427:       if (ifltype == 1 || ifltype == 2) {
 6428:       
 6429:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 6430: 
 6431:          const double unth0 = segment->qthcon*ramp/segment->carea;
 6432: printf("unth0: %f, qthcon: %f, ramp: %f, carea: %f\n", unth0, segment->qthcon, ramp, segment->carea);         
 6433:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 6434:          
 6435:       } else if (ifltype == -1) { // Flather 1
 6436: 
 6437:          for (int k = 0; k < nvrt; k++) {
 6438: 
 6439:             // uth is the normal vel.; no ramp up
 6440:             const double uth = sideBnd->nuth(k);
 6441:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 6442: 
 6443:             sideBnd->ubc[k] += uth*n;
 6444:          }
 6445: 
 6446:       } else if (ifltype == 3 || ifltype == 5) {
 6447:          // vnth0=0 !normal vel.
 6448: 
 6449:          Vector2 r_u1_bar = {0.0, 0.0};
 6450:          // Computes the contribution to the velocity from all tide frequencies
 6451:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6452: 
 6453:             const Vector2 ufa  = sideBnd->ufa[jfr]; 
 6454:             const Vector2 umo  = sideBnd->umo[jfr]; 
 6455: 
 6456:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6457:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 6458:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 6459:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 6460: 
 6461:          }
 6462: 
 6463: 
 6464:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 6465: 
 6466:       } // if (ifltype = 3 || ifltype == 5
 6467: 
 6468: 
 6469: 
 6470:    }
 6471: 
 6472:    __global__ void computeElevationBoundaryConditions(double time) {
 6473:       // Compute elevation essential boundary conditions 
 6474: 
 6475:       NODE_BND(nodeBnd); // Each boundary node.
 6476: 
 6477:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 6478: 
 6479:       const Node *node = nodeBnd->node;
 6480:       const BoundarySegment *segment = nodeBnd->segment;
 6481:       const int iettype = segment->iettype;
 6482:       
 6483: 
 6484:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 6485:       double eic = 0.0;
 6486:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 6487:       else                 eic = 0.0;
 6488: 
 6489:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 6490:       const double r_eth = ramp*nodeBnd->eth;
 6491:       double r_eta1_bar = 0.0;
 6492: 
 6493:       // Compute tide elevation
 6494:       if (iettype == 3 || iettype == 5) {   
 6495: 
 6496:          if constexpr(iloadtide==1) { // loading tide
 6497:             assert(false && "Loading tide not implemented");
 6498:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 6499:          }
 6500:          
 6501:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 6502: 
 6503:             const double efa  = nodeBnd->efa[jfr]; 
 6504:             const double emo  = nodeBnd->emo[jfr]; 
 6505: 
 6506:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 6507:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 6508:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 6509: 
 6510: 
 6511:          } // for jfr
 6512: 
 6513:       } // if iettype
 6514: 
 6515:       switch (iettype) {
 6516:          case 1:
 6517:          case 2:
 6518:          case 4:
 6519:             nodeBnd->elbc = r_eic + r_eth;
 6520:             break;
 6521:          case 3:
 6522:             nodeBnd->elbc = r_eic + r_eta1_bar;
 6523:             break;
 6524:          case 5:
 6525:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 6526:             break;
 6527:       } // switch
 6528: 
 6529: 
 6530:       //Add inverse barometric effects
 6531:       if (iettype != 0 && inv_atm_bnd == 1) {
 6532:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 6533:       }
 6534: 
 6535:    }
 6536: 
 6537: 
 6538:    __global__ void computeHorizontalViscosity(void) { 
 6539: 
 6540:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 6541: 
 6542:       SIDE(side);
 6543: 
 6544:       if (side->isDry) return;
 6545: 
 6546:       for (int k = 0; k < nvrt; k++) {
 6547:          side->nuGradU[k] = {0.0, 0.0};
 6548:       }
 6549: 
 6550:       if constexpr(ihorcon == 1) {
 6551:          for (int k = side->kb; k < nvrt - 1; k++) {
 6552:             // Computes the Laplacian by using the simplified formula presented in the paper:
 6553:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 6554:             // By Zhang and Baptista.
 6555: 
 6556:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 6557:             // This is a standard discretization of the Laplacian operator.
 6558:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 6559:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 6560:             // Gamma is hvis_coef0 in the code.
 6561:             // The value of gamma needs to be < 0.5.
 6562: 
 6563:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 6564:             // side under consideration in each of the two possible elements that share the side.
 6565:             Vector2 sumU = {0.0, 0.0};
 6566:             for (int l = 0; l < 2; l++) {
 6567:                const Element *elem = side->elems[l];
 6568: 
 6569:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 6570: 
 6571:                // Find the local index of the side in the element
 6572:                const int idxSide = elem->sideLocalIdx(side);
 6573: 
 6574:                // Find the two sides that are connected to the side under consideration
 6575:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 6576:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 6577: 
 6578:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 6579: 
 6580:             }
 6581: 
 6582:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 6583: 
 6584:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 6585:    
 6586:          }
 6587:       }
 6588:       else if constexpr(ihorcon == 2) {
 6589:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 6590:       }
 6591: 
 6592: 
 6593:    }
 6594: 
 6595: 
 6596:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 6597: 
 6598:       // Set essential boundary conditions 
 6599:       NODE(node); // Each boundary node
 6600:       NodeBoundary *nodeBnd = node->nodeBnd;
 6601:       
 6602:  
 6603:       // Check if this node has essential BC
 6604:       if (nodeBnd && nodeBnd->isEssentialBC) {
 6605: 
 6606:          // Verify BC value is valid
 6607:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6608: 
 6609:        
 6610:          // Set diagonal to 1 and zero off-diagonals
 6611:          for (int j = 0; j <= node->numNodes; j++) {
 6612:                node->coeffRow[j] = 0.0;
 6613:          }
 6614: 
 6615:          *(node->coeffDiag) = 1.0;
 6616: 
 6617: 
 6618:          // Set solution and RHS to BC value
 6619:          node->mX  = nodeBnd->elbc;
 6620:          node->qel = nodeBnd->elbc;
 6621: 
 6622:       } else {
 6623:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 6624: 
 6625:          for (int j = 0; j < node->numNodes; j++) {
 6626:                const Node* nbNode = node->nodes[j];
 6627:    	         assert(nbNode != nullptr && "setEssentialBC: nbNode is nullptr");
 6628: 
 6629:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 6630:                assert(nbNodeBnd != nullptr && "setEssentialBC: nbNodeBnd is nullptr");
 6631: 
 6632:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 6633:                   // Verify neighbor's BC value
 6634:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 6635: 
 6636:                   // Subtract contribution to RHS
 6637:                   node->qel -= node->coeffRow[node->csrSlot[j]]*nbNodeBnd->elbc;
 6638:                   node->coeffRow[node->csrSlot[j]] = 0.0;  
 6639:                }
 6640:          }
 6641: // printf("setEssentialBC: node->qel = nodeBnd->elbc - node->coeffMatrix[j]*nbNodeBnd->elbc\n");
 6642:       }
 6643:    }
 6644: 
