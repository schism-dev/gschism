 6844: extern "C" {
 6845:    __global__ void computeElemAverageGhat(void) {
 6846:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 6847: 
 6848:       ELEM(elem);
 6849:       
 6850:       elem->ghat1= {0.0, 0.0};  
 6851: 
 6852:       if constexpr(ihydraulics != 0) {
 6853:          if (nhtblocks > 0 && elem->isblock) return;
 6854:       }
 6855: 
 6856: 
 6857: 
 6858:       
 6859:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 6860:       // tidal potential, horizontal diffusion, and baroclinic etc
 6861:       // Remember to update both fb and F 
 6862:       // If ics=2, ghat1 are in eframe (ll)
 6863:       // cff1-3: coefficients for 2D/3D
 6864:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 6865:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 6866:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 6867: 
 6868:       if (elem->isDry) return;
 6869: 
 6870:       double av_cff1 = 0.0;  // av. for cff1
 6871:       double av_cff2 = 0.0;  // av. for cff2
 6872:       double av_cff3 = 0.0;  // av. for cff3
 6873:       double av_df = 0.0;  // av. for H^\alpha / H
 6874:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 6875:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 6876: 
 6877:       const int i34 = elem->i34;
 6878:       const int kb = elem->kb;
 6879: 
 6880:       for (int j=0; j<i34; j++) {
 6881:          // For each node and side in the element...
 6882: 
 6883:          const Node *node = elem->nodes[j];
 6884:          const Side *side = elem->sides[j];
 6885: 
 6886:          const double chi      = side->chi;
 6887:          const double veg_c2   = side->veg_c2;
 6888:          const double veg_beta = side->veg_beta;
 6889:          const double veg_h    = side->veg_h();
 6890:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 6891: 
 6892:          // Node - const in elem
 6893:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 6894:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 6895: 
 6896:          if (elem->depth >= tip_dp) {
 6897:            elem->gradETP += node->ETP*elem->gradPhi[j];
 6898:          }
 6899: 
 6900:          
 6901:          const double htot  = side->htot2();        // Total depth at the side
 6902:          const double zctr2 = side->zTopCanopy();  
 6903: 
 6904:          double cff1; 
 6905:          double cff2; 
 6906:          double cff3;   
 6907:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 6908:          // coefficients applied to 2D/3D case 
 6909:             cff1 = side->hhat/htot;
 6910:             cff2 = 0.0;
 6911:             cff3 = 0.0;
 6912:          } else { //3D
 6913:             //Init for no-veg case
 6914:             cff1 = 1.0;
 6915:             cff2 = 1.0;
 6916:             cff3 = 0.0;
 6917: 
 6918:             if constexpr(iveg != 0) {
 6919:                // Computes coefficients used with vegetation terms G1, G2
 6920:                // cff1, cff3 are used for the first two terms in G1, G2:
 6921:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 6922:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 6923:                // In general, cff1*Ustar - cff3*Ustar_alpha
 6924:                if(veg_h < 0.99*htot) { // submergent vegetation
 6925:                   cff1=1;
 6926:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 6927:                   cff3 = veg_c;
 6928: 
 6929:                } else { // emergent vegetation
 6930:                   cff1 = 1.0/(1.0 + veg_c2);
 6931:                   cff2 = cff1;
 6932:                   cff3 = 0.0;
 6933: 
 6934:                }
 6935:             } // if iveg
 6936:          } //  2D/3D
 6937: 
 6938:          av_cff1 += cff1/i34;
 6939:          av_cff2 += cff2/i34;
 6940:          av_cff3 += cff3/i34;
 6941:          av_cff2_chi += cff2*chi/i34;
 6942:          av_cff3_chi += cff3*chi/i34;
 6943:          av_df += min(htot, veg_h)/(htot*i34);
 6944: 
 6945: 
 6946:          // btrack values: U^\star, U^{\star\alpha}
 6947:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 6948:          Vector2 Ustar       = {0.0, 0.0}; 
 6949:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 6950: 
 6951:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 6952:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 6953:          } else { //3D
 6954:             for (int k = side->kb + 1; k < nvrt; k++) {
 6955:             
 6956:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 6957:                Ustar += w2;
 6958: 
 6959:                if constexpr(iveg != 0) {
 6960:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 6961:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 6962:                        Ustar_alpha += zrat*w2; // XXXX
 6963:                    }
 6964:                }  // if iveg
 6965:             }  // for k
 6966:          }  //2D/3D
 6967:          
 6968: 
 6969:          // Add btrack & surface stress terms to \breve{G} first
 6970:          if constexpr(ics==1) {
 6971: 
 6972:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 6973: 
 6974:          } else {
 6975:             assert(false && "computeElemAverageGhat: Not implemented");
 6976:             // XXX IMPLEMENT THIS
 6977:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 6978:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 6979:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 6980:          }  // if ics
 6981: 
 6982:          // Surface and bottom stress terms
 6983:          if constexpr(ics==1) {
 6984:             const Vector2 tau    = side->tau();
 6985:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 6986: 
 6987:             // Term for surface and bottom stress
 6988:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 6989: 
 6990:          } else {
 6991:             assert(false && "computeElemAverageGhat: Not implemented");
 6992:             // XXX IMPLEMENT THIS
 6993:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 6994:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 6995:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 6996:             // tau_x=(vn1+tt1)/2.d0
 6997:             // tau_y=(vn2+ss1)/2.d0
 6998:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 6999:          }  // if ics
 7000: 
 7001:          
 7002: 
 7003:          // All terms in F,F^\alpha,f_b except baroclinic
 7004:          // F, f_b: all explicit terms excluding vegetation 
 7005:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7006:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7007:          const double coriolis = side->coriolis;
 7008:          Vector2 F  =  coriolis*side->U;  // F_x
 7009:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7010:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7011: 
 7012:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7013:             
 7014:             for (int k = side->kb; k < nvrt; k++) {
 7015:                if (zctr2 > side->zc[k-1]) {
 7016:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7017:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7018:                    Fa +=  coriolis*w2*zrat;
 7019:                } // if zctr2
 7020:             } // k
 7021:          } // iveg
 7022: 
 7023:          // Integrate horizontal viscosity force vertically
 7024:          for (int k=side->kb + 1; k<nvrt; k++) {
 7025:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7026: 
 7027:             F += levelHorVisc;
 7028: 
 7029:             // Vegetation term
 7030:             if constexpr(iveg!=0) {
 7031:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7032:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7033:                   Fa += levelHorVisc*zrat;
 7034:                } 
 7035:             } // if iveg
 7036:          } // for k
 7037: 
 7038:          fb += side->nuGradU[side->kb];
 7039: 
 7040:          // Add to ghat1
 7041:          if constexpr(ics==2) {
 7042:             assert(false && "computeElemAverageGhat: Not implemented");
 7043:             // XXX IMPLEMENT THIS
 7044:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7045:             // bigf1=vn1; bigf2=vn2
 7046:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7047:             // botf1=vn1; botf2=vn2
 7048:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7049:             // bigfa1=vn1; bigfa2=vn2
 7050:          } // if ics
 7051: 
 7052:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7053:       } // for j (nodes and sides)
 7054: 
 7055:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7056:          
 7057:       // Finish off terms in F, F^\alpha and f_b
 7058:       const double grav3 = elem->mean(&Node::grav2);
 7059:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7060: 
 7061: 
 7062:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7063:       for (int j=1; j<i34; j++) { 
 7064:          // For each side in the element...
 7065:          const Side *side = elem->sides[j];
 7066:          const double chi = side->chi;
 7067: 
 7068:          const double htot = side->htot2();
 7069:          const double veg_h = side->veg_h();
 7070:          const Vector2 F  = htot*fb;
 7071:          const Vector2 Fa = min(htot, veg_h)*fb;
 7072: 
 7073:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7074:       } // for j
 7075: 
 7076:       //botf1 etc are already in elem frame
 7077:       elem->ghat1 += tmp/i34;
 7078: 
 7079:       // Baroclinic force
 7080:       if constexpr(ibc==0) {
 7081:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7082: 
 7083:          Vector2 Fa = {0.0, 0.0};
 7084:          Vector2 intGradRho = {0.0, 0.0};
 7085:          
 7086:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7087:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7088:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7089: 
 7090:             // \in F [m^2/s/s]
 7091:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7092:          }
 7093: 
 7094:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7095:          const Vector2 F = av_df*Fa; //approx
 7096:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7097: 
 7098:       } // if ibc
 7099: 
 7100: 
 7101: 
 7102:    }
 7103: 
 7104: } // extern "C"
 7105: 
 7106: 
 7107: 
 7108: #ifdef DONTCOMPILE
 7109: __global__ void checkMassConservation(Tracers* sumtr) {
 7110: 
 7111:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7112: 
 7113:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7114: 
 7115:    Element *elem = &(mesh->localElemData[i]);
 7116: 
 7117:    // Skip dry elements
 7118:    if (elem->isDry) return;
 7119: 
 7120:    // Local sum array for this thread
 7121:    double localSum[N_TRACERS] = {0.0};
 7122: 
 7123:    // Sum over vertical levels for this element
 7124:    const int kbe = elem->kbe;
 7125:    const double area = elem->area;
 7126: 
 7127:    for (int k = kbe; k < nvrt; k++) {
 7128:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7129:       
 7130:       // Accumulate tracer mass
 7131:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7132:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7133:       }
 7134:    }
 7135: 
 7136:    //  This function returns per element sums. A reduction must be done on the host side.
 7137: }
 7138: 
 7139: 
 7140: __global__ void transport(void) {
 7141: 
 7142:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7143: 
 7144:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7145: 
 7146:    Element *elem = &(mesh->localElemData[ie]);
 7147: 
 7148:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7149: 
 7150:                for (int m=0; m<ntr; m++) {
 7151:                   for (int k=kbe(ie); k<nvrt; k++) {
 7152:                      // Calculate each polynomial's weight 
 7153:                      wm=0.d0; sum1=0.d0; 
 7154:                      wm1=0.d0; wm2=0.d0; 
 7155:                      for (int i=0; i<elem->nweno2; i++) {
 7156:                   
 7157:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7158:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7159:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7160:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7161:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7162:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7163:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7164:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7165:                      // -----------------Hu and Shu (1999)'s method----------------
 7166:                      b4=b1+b2+b3
 7167: 
 7168: //Error: add PRODUCTION CPP
 7169: #ifdef DEBUG
 7170:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7171:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7172:                     call parallel_abort(errmsg)
 7173:                   }
 7174: #endif
 7175: 
 7176:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7177:                   // !----test-------------- 
 7178:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7179:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7180:                   // !wm(i)=wm1(i)*wm2(i)
 7181:                   // !---------------------- 
 7182:                   sum1=sum1+wm(i)
 7183:                 } // end for i
 7184: 
 7185:                 wm=wm/sum1
 7186: 
 7187:                 for (int j=0; j<elem->i34; j++) {
 7188: 
 7189:                   const Side *side  = elem->sides[j];
 7190:                   const Node *node1 = side->n1;
 7191:                   const Node *node2 = side->n2;
 7192: 
 7193:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7194:                      trsd=0.d0
 7195:                      for (int kk=0; kk<nquad; kk++) {
 7196:                         for (int i=0; i<elem->nweno2; i++) {
 7197:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7198:                         } // end for i   
 7199:                      } // end for kk
 7200:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7201:                   } // outward flux
 7202:                } // end for j=1,i34(ie) ! side
 7203:             }
 7204:          }
 7205:               
 7206: 
 7207: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7208: //             //   calculate each polynomial's weight 
 7209: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7210: //                 wm=0.d0; sum1=0.d0
 7211: //                 do i=1,nweno1(ie) !for each polynomial
 7212: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7213: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7214: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7215: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7216: //                   wm(i)=b2
 7217: //                   sum1=sum1+b2
 7218: //                   !wm(i)=1.d0
 7219: //                   !sum1=sum1+1.d0
 7220: 
 7221: // // Error: PRODUCTION
 7222: // #ifdef DEBUG
 7223: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7224: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7225: //                     call parallel_abort(errmsg)
 7226: //                   endif
 7227: // #endif
 7228: 
 7229: //                 enddo !i
 7230: //                 wm=wm/sum1 !final weight
 7231: 
 7232:                 for (int j=0; j<elem->i34; j++) { // side
 7233:                   const Side *side = elem->sides[j];
 7234:                   const Node *node1 = side->n1;
 7235:                   const Node *node2 = side->n2;
 7236: 
 7237:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7238:                     trsd=0.d0
 7239:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7240:                       for (int i=0; i<elem->nweno1; i++) {
 7241:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7242:                       }
 7243:                     enddo //kk
 7244:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7245:                   } // outward flux
 7246:                 } // end for j=1,i34(ie) ! side
 7247:               } // end for k; ntr 
 7248: 
 7249:             else !simple upwind method
 7250:               do j=1,i34(ie)
 7251:                 jsj=elside(j,ie)
 7252:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7253:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7254:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7255:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7256:                   endif
 7257:                 enddo  !vertical layers
 7258:               enddo !j=1,i34(ie) ! side
 7259:             endif !order of accuracy
 7260: 
 7261:          //  enddo !ie
 7262: // !$OMP     end do
 7263: 
 7264: // !$OMP     master
 7265: //           !message passing
 7266: //           if (nproc>1) then
 7267: //             !make a copy of side concentrations
 7268: //             trsd_tmp0=trsd_tmp 
 7269: 
 7270: //             !this exchange routine swaps interface concentration between two partitions
 7271: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7272: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7273: 
 7274: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7275: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7276: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7277: 
 7278: 
 7279: //             !This obtains final values for interface sides
 7280: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7281: //       :    endif !nproc>1
 7282: //           !message passing end
 7283: // !$OMP     end master
 7284: // !$OMP     barrier
 7285: 
 7286: 
 7287: // !         Do advection; conc @ dry elem will not be changed
 7288: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7289: // !$OMP     do reduction(+: h_mass_in)
 7290: //           do i=1,ne
 7291: //             if(idry_e(i)==1) cycle
 7292: 
 7293: 
 7294: // !           Wet elements with 3 wet nodes
 7295: //             do k=kbe(i)+1,nvrt
 7296: 
 7297: 
 7298: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7299: //               dtb_by_bigv = dtb/bigv
 7300:     
 7301: // !             Advective flux
 7302: //               if (ntd_weno==1 .or. itd_weno==1) then
 7303: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7304: //               else
 7305: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7306: //               endif
 7307: 
 7308: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7309: //               do j=1,i34(i)
 7310: //                 jsj=elside(j,i) !side
 7311: //                 iweno=.true. !use weno reconstruction as default
 7312: //                 iel=ic3(j,i) !neighboring elem
 7313: 
 7314: //                 if(iel/=0) then
 7315: //                   if(idry_e(iel)==1) cycle
 7316: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7317: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7318: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7319: //                     iweno=.false.
 7320: //                   endif
 7321: //                 else !land or open bnd side
 7322: //                   !skip land bnd and outflowing open bnd, 
 7323: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7324: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7325: //                     !For outflow open bnd side, estimate mass in (open
 7326: //                     !side cannot be interface side)
 7327: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7328: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7329: //                     endif
 7330: 
 7331: //                     cycle
 7332: //                   endif
