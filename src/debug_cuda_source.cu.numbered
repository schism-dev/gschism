 2135:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2136:    // Project the vectors from the node frame to the element frame
 2137: 
 2138:  
 2139:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2140:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2141:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2142:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2143:       else          v[3] = Vector2();
 2144:    }
 2145: 
 2146:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2147:    // Project the vectors from the side frame to the element frame
 2148: 
 2149:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2150:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2151:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2152:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2153:       else          v[3] = Vector2();
 2154:    }
