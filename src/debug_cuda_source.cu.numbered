 2299: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2300: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2301: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2302: // Only when ics == 2, the origin is at the element center.
 2303: 
 2304:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2305: 
 2306:    const Node *node = nodes[idxNode];
 2307: 
 2308:    if constexpr(ics==1) {
 2309:       return node->p;
 2310: 
 2311:    } else {
 2312:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2313: 
 2314:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2315: 
 2316:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2317:    }
 2318: 
 2319: }
 2320: 
 2321: 
 2322: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2323: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2324: 
 2325:    assert(isTri() && "getLocalHorizontalNodePositions only works for triangles");
 2326: 
 2327:    const int id1 = idx;
 2328:    const int id2 = nxq(1 + id1);
 2329:    const int id3 = nxq(2 + id1);
 2330: 
 2331:    if constexpr(ics==1) {
 2332:       x0 = nodes[id1]->p;
 2333:       x1 = nodes[id2]->p;
 2334:       x2 = nodes[id3]->p;
 2335: 
 2336:    } else {
 2337:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2338: 
 2339:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2340:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2341:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2342: 
 2343:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2344:       x1 = toVector2(frame.G2L(p1 - c));
 2345:       x2 = toVector2(frame.G2L(p2 - c));
 2346: 
 2347:    }
 2348: 
 2349: }
 2350: 
 2351: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3) const {
 2352: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2353: 
 2354:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2355: 
 2356:    if constexpr(ics==1) {
 2357:       x0 = nodes[0]->p;
 2358:       x1 = nodes[1]->p;
 2359:       x2 = nodes[2]->p;  
 2360:       x3 = nodes[3]->p;
 2361: 
 2362:    } else {
 2363:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2364: 
 2365:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2366:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2367:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2368:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2369: 
 2370:       x0 = toVector2(frame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2371:       x1 = toVector2(frame.G2L(p1 - c));
 2372:       x2 = toVector2(frame.G2L(p2 - c));
 2373:       x3 = toVector2(frame.G2L(p3 - c));
 2374:    }
 2375: 
 2376: }
 2377: 
 2378: 
 2379: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2380: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2381: // Returns the normal vector and the area of the element at this level
 2382:    
 2383:    double nx, ny, nz;
 2384: 
 2385:    if (isTri()) {
 2386:       // For triangles...
 2387: 
 2388:       // Indices of the nodes at level k, taking care of not going below the bed
 2389:       const int k0 = max(k, nodes[0]->kb);
 2390:       const int k1 = max(k, nodes[1]->kb);
 2391:       const int k2 = max(k, nodes[2]->kb);
 2392: 
 2393:       // Gets the element frame coordinates of the nodes at level k
 2394:       Point3 x0, x1, x2;
 2395:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2396:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2397:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2398:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2399: 
 2400:       } else {  // ics == 2
 2401:          Point2 h0, h1, h2;
 2402: 
 2403:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2404: 
 2405:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2406:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2407:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2408:       }
 2409: 
 2410:       const Vector3 n20 = x2 - x0;
 2411:       const Vector3 n10 = x1 - x0; 
 2412: 
 2413:       // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 2414:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2415:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2416:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2417:   
 2418:    }
 2419:    else {
 2420:       // For quads...
 2421:       Point2 h0, h1, h2, h3;
 2422: 
 2423:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2424: 
 2425:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2426:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2427:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2428:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2429: 
 2430:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2431:       nx = n20.y*n31.z - n20.z*n31.y;
 2432:       ny = n20.z*n31.x - n20.x*n31.z;
 2433:       nz = n20.x*n31.y - n20.y*n31.x;
 2434: 
 2435:    }
 2436: 
 2437:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2438:    area3D = 0.5*len;
 2439: 
 2440:    const double inv_len = 1.0/len;
 2441: 
 2442:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2443: 
 2444: }
 2445: 
 2446: /**
 2447:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 2448:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 2449:    If the segment is completely inside the element, then it returns true.
 2450: 
 2451:    This function assumes:
 2452:    - The initial point is on a side of the element. 
 2453:    - Its position is given by parameter t in the range [0,1].
 2454:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 2455:       intersects the element (elements are convex).
 2456: 
 2457:    To find the intersection point, this function does the following:
 2458:    - it finds the intersection of the line segment with all the element side lines,
 2459:       except for the one that contains the initial point.
 2460:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 2461:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 2462:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 2463:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 2464:       track segment is almost parallel to the element side line.
 2465: 
 2466:    Inputs:
 2467:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 2468:    @param x2, y2: other end of the line segment
 2469: 
 2470:    Outputs:
 2471:    @param side:  side that intersects the line segment (input and output)
 2472:    @param nextElement (output): element that contains the intersection point
 2473:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 2474:    @param zint (input/output): Vertical coordinate of the intersection point
 2475: 
 2476:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2477:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2478:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2479: 
 2480:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2481:    (Delta) being zero.
 2482: 
 2483:    The intersection2 point happens when:
 2484:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2485:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2486:    
 2487:    Assumption: the 4 points (including those of the side segment) are different.
 2488:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2489:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2490:    If true, (xIntersect,yIntersect) is the intersection.				
 2491:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2492: **/
 2493: 
