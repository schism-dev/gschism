 8621: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8622:    // Get the value of a variable from an side
 8623:    // varName is the name of the variable to get
 8624:    // var is the array to store the value
 8625:    // k is the vertical level index of the variable to get
 8626:    SIDE_BND(sideBnd);   
 8627: 
 8628:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8629:    if (sideBnd->segment->isLand) idx = -7;
 8630: 
 8631:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8632:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8633: 
 8634: }
