 7364: __global__ void returnMatrix(double *res) {
 7365:    // Debugging: returns the matrix as a CuPy array
 7366: 
 7367:    const int size = mesh->np;
 7368:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7369:       const Node *node = mesh->localNodeData + idx_node;
 7370:       res[idx_node*size + idx_node] = node->coeffDiag;
 7371:       for (int j = 0; j < node->numNodes; j++) {
 7372:          Node* nbNode = node->nodes[j];
 7373:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7374:       }
 7375: 
 7376:    }
 7377:    
 7378: }
