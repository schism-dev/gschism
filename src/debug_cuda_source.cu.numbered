  785: struct Side {
  786: 
  787:    // Geometry information
  788:    int idx;               // Index of the side
  789:    Node *n1, *n2;
  790:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  791: 
  792:    double length;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  793:    Vector2 center;        // Location of side center. 
  794:    double zc[nvrt];       // Side center z-coord at each vertical level
  795: 
  796:    Frame frame;
  797: 
  798:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  799:                           // this is nullptr
  800:    
  801:    int kb;                // Bottom index of the side
  802:    bool isDry;             // True if the side is dry
  803:  
  804:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  805: 
  806:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  807: 
  808:    // Physical information
  809:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  810:    double  w2[nvrt];            // Vertical velocity at each vertical level
  811:    Vector2 btu[nvrt];           // Back-tracked velocity
  812:    Vector2 uth[nvrt];           // "Time history" velocity
  813:    Vector2 U;                   // Vertically averaged velocity vector  
  814: 
  815:    Vector2 d2uv[nvrt];          // divergence of (nu*grad u) XXX COMPUTE!!
  816: 
  817:    Vector2 bcc[nvrt];           // Baroclinic term
  818:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  819: 
  820:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  821:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  822:    Vector2 gradPr;               // Gradient of pressure
  823:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  824: 
  825: 
  826:    double hhat;                 // \breve{H} in notes
  827: 
  828:    double shapiro;
  829: 
  830:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  831: 
  832:    double coriolis;             // Coriolis parameter
  833: 
  834:    // Vegetation parameters
  835:    double veg_c2;
  836:    double veg_beta;
  837: 
  838:    // Bottom drag parameters.
  839:    double chi;
  840:    double chi2;
  841: 
  842:    __inline__ __device__ double x(double t) const;
  843:    __inline__ __device__ double y(double t) const;
  844:    __inline__ __device__ Point2 p_t(double t) const;
  845: 
  846:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  847:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  848:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  849: 
  850:    __inline__ __device__ Side* neigh(int index) const { 
  851:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  852:       assert(index >= 0 && index < 4); 
  853:       assert(elems[0] != nullptr && elems[1] != nullptr);
  854: 
  855:       const int ielem = index & 1;           // 0 or 1
  856:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  857: 
  858:       const Element* elem = elems[ielem];
  859: 
  860:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  861: 
  862:       return elem->sides[elem->nxq(locSideIdx + iside)];
  863: 
  864:    }
  865: 
  866:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  867: 
  868:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  869: 
  870:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  871:    __inline__ __device__ bool isBnd2(void) const { return elems[0] == nullptr; } // This is a different type of being boundary. XXXXX CHECK IF THIS THE SAME
  872:    __inline__ __device__ int iadv(void) const;
  873: 
  874:    __inline__ __device__ double grav3(void) const;
  875:    
  876:    __inline__ __device__ double eta2(void) const;
  877:    __inline__ __device__ double eta1(void) const;
  878:    __inline__ __device__ double depth(void) const;
  879:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  880:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  881: 
  882:    __inline__ __device__ double dfv(int k) const;
  883: 
  884:    __inline__ __device__ double veg_h(void)  const;
  885:    __inline__ __device__ double veg_nv(void) const;
  886:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  887:    __inline__ __device__ double veg_alpha3D(int k) const;
  888:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  889: 
  890:    __inline__ __device__ double etaMeanBnd(void) const;
  891: 
  892:    __inline__ __device__ double Cd(void) const;
  893: 
  894:    __inline__ __device__ Vector2 tau(void) const;
  895: 
  896:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  897:    
  898: 
  899:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  900:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  901:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  902:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  903:    } 
  904:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  905:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
  906:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  907:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  908: 
  909:    // Get valid starting element (for backtracking)
  910:    __inline__ __device__ Element* getStartElement() {
  911:       return elems[0] ? elems[0] : elems[1];
  912:    }
  913: 
  914:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
  915:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
  916: 
  917:       // If one of the elements is null, return the other one
  918:       if      (elems[0] == nullptr) return elems[1];
  919:       else if (elems[1] == nullptr) return elems[0];
  920: 
  921: 
  922:       // Dot product of the negative velocity vector with the side normal vector
  923:       const double dot_prod1 = -dot(u, n);
  924:       
  925:       // Vector from side center to element 0 centroid
  926:       const Vector2 v2 = toVector2(elems[0]->center) - center;
  927: 
  928:       // Dot product of the vector with the side normal vector
  929:       const double dot_prod2 = dot(v2, n);
  930: 
  931:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
  932:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
  933: 
  934:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
  935:       else                           return elems[1];
  936: 
  937:  
  938:    }
  939: 
  940:    __forceinline__ __device__ Element* otherElem(const Element* elem) {
  941:       // Given an element, returns the other element that shares this side
  942:       return (elems[0] == elem) ? elems[1] : elems[0];
  943:    }
  944: 
  945:    __forceinline__ __device__ Node* otherNode(Node* node) {
  946:       // Given a node, returns the other node that shares this side
  947:       return (n1 == node) ? n2 : n1;
  948:    }
  949:  
  950:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
  951: 
  952: 
  953: 
  954: 
  955: };
  956: 
  957: 
  958: // This struct is used to store the boundary information for a node.
  959: struct NodeBoundary {   
  960:    BoundarySegment *segment;
  961:    Node *node;
  962:    
  963:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
  964:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
  965: 
  966:    double etaic;  // Elevation at nodes used for essential boundary conditions
  967:    double elbc;   // Elevation boundary condition
  968:    int iettype;   // Type of elevation boundary condition
  969:    double eth;    // Elevation time history
  970: 
  971:    double eta_mean; // Mean elevation at nodes
  972: 
  973:    bool isEssentialBC;
  974: 
  975: 
  976:    // Arrays for harmonic constituents (if needed)
  977:    double emo[nbfr];  // Elevation amplitude
  978:    double efa[nbfr];  // Elevation phase
  979:    double umo[nbfr];  // U-velocity amplitude
  980:    double ufa[nbfr];  // U-velocity phase
  981:    double vmo[nbfr];  // V-velocity amplitude
  982:    double vfa[nbfr];  // V-velocity phase 
  983: 
  984:    
  985:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
  986:       assert(index == 0 || index == 1); 
  987:       return (index == 0) ? sideBnd1 : sideBnd2; 
  988:    }
  989: 
  990: 
  991: };
  992: 
  993: struct Node {
  994: 
  995:    // Geometry information
  996:    int idx;        // Index of the node
  997:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
  998:    int numNodes;   // Number of nodes neighbors of this node
  999: 
 1000:    Element **elements; // Array of pointers to the elements that share this node
 1001:    int numElements;   // Number of elements that share this node
 1002: 
 1003:    Point3 p;
 1004:    Vector3 u2[nvrt];
 1005:    double z[nvrt];
 1006:    double lon, lat;
 1007:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1008:    double depth;
 1009: 
 1010:    int kb;       // Bottom index of the node
