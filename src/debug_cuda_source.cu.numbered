 7364: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7365:    // Get the value of a variable from an element
 7366:    // varName is the name of the variable to get
 7367:    // var is the array to store the value
 7368:    // k is the vertical level index of the variable to get
 7369: 
 7370:    ELEM(elem);
 7371:    
 7372:    int idx = elem->idx;
 7373:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7374: 
 7375:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7376:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7377:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7378:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7379:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7380:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7381:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7382:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7383:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7384:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7385:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7386:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7387:       
 7388:    
 7389: }
 7390: 
 7391: 
 7392: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7393:    // Get the value of a variable from an node
 7394:    // varName is the name of the variable to get
 7395:    // var is the array to store the value
 7396:    // k is the vertical level index of the variable to get
 7397: 
 7398:    NODE(node);
 7399:    
 7400:    int idx = node->idx;
 7401:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7402: 
 7403:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7404:    
 7405:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7406:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7407:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7408:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7409:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7410:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7411:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7412:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7413:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7414:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7415:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7416:       
 7417:    
 7418: }
 7419: 
 7420: 
 7421: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7422:    // Get the value of a variable from an side
 7423:    // varName is the name of the variable to get
 7424:    // var is the array to store the value
 7425:    // k is the vertical level index of the variable to get
 7426:    SIDE(side);
 7427:    
 7428:    int idx = side->idx;
 7429:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7430: 
 7431:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7432:    
 7433:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7434:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7435:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7436:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7437:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7438:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7439:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7440:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7441:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7442:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = side->eta2();
 7443:    else if (varCode == (int)VarCode::btu && k >= 0)     var[idx] = side->btu[k].x;
 7444:    else if (varCode == (int)VarCode::btv && k >= 0)     var[idx] = side->btu[k].y;
 7445:    else if (varCode == (int)VarCode::bccx && k >= 0)    var[idx] = side->bcc[k].x;
 7446:    else if (varCode == (int)VarCode::bccy && k >= 0)    var[idx] = side->bcc[k].y;
 7447:    else if (varCode == (int)VarCode::ubc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7448:    else if (varCode == (int)VarCode::vbc && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7449:    else if (varCode == (int)VarCode::uth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7450:    else if (varCode == (int)VarCode::vth && k >= 0)     var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7451:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7452: }
