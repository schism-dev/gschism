 1268: // This struct is used to store the boundary information for a node.
 1269: struct NodeBoundary {   
 1270:    int idx;
 1271:    BoundarySegment *segment;
 1272:    Node *node;
 1273:    
 1274:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1275:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1276: 
 1277:    bool isLand;
 1278: 
 1279:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1280:    double elbc;   // Elevation boundary condition
 1281:    double eth;    // Elevation time history
 1282: 
 1283:    double eta_mean; // Mean elevation at nodes
 1284: 
 1285:    bool isEssentialBC;
 1286: 
 1287:    Vector2 uth[nvrt];  // "Time history" velocity
 1288: 
 1289:    // Arrays for harmonic constituents (if needed)
 1290:    double  emo[nbfr];  // Elevation amplitude
 1291:    double  efa[nbfr];  // Elevation phase
 1292:    Vector2 umo[nbfr];  // velocity amplitude
 1293:    Vector2 ufa[nbfr];  // velocity phase
 1294: 
 1295: 
 1296:    NodeBoundary(void) {
 1297:       isLand = false;
 1298:    }
 1299:    NodeBoundary(bool _isLand) {
 1300:       isLand = _isLand;
 1301:    }
 1302: 
 1303:    
 1304:    __forceinline__ __device__ int numSidesForAverage() const {
 1305:    // Returns the number of sides that are connected to the node and have the same segment.
 1306:    // This is used to compute the average velocity at the node for open boundary nodes.
 1307:       int res = 0;
 1308:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1309:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1310: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1311:       return res;
 1312:    }
 1313: 
 1314: 
 1315:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1316:       assert(index == 0 || index == 1); 
 1317:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1318:    }
 1319: 
 1320: 
 1321: };
