  647: 
  648: template<TurbulenceModel Model>
  649: struct Turbulence {
  650:    __device__ void setDiffLimits(double, double) { assert(false && "setDiffLimits does not exist for this turbulence model"); }
  651: 
  652:    __device__ void init(Node *node) {
  653:       for (int k = 0; k < nvrt; k++) {
  654:          node->dfv[k] = dfv0;
  655:          node->dfh[k] = dfh0;
  656:       }
  657:    }
  658: };   
  659: 
  660: // GLS turbulence model
  661: template<>
  662: struct Turbulence<TurbulenceModel::GLS> {
  663:    using enum TurbulenceSubmodel;
  664:    using enum StabilityModel;
  665: 
  666:    double tke[nvrt];    // TKE
  667:    double mxl[nvrt];    // mixing length for GLS
  668:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  669:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  670: 
  671:    double diffmin;  // from diffmin.gr3
  672:    double diffmax;  // from diffmax.gr3
  673:    
  674:    __device__ void setDiffLimits(double lo, double hi) {
  675:       diffmin = lo;
  676:       diffmax = hi;
  677:    }
  678: 
  679:    // Fortran cold start: q2 = q2min, xl = xlmin2, dfq1 = dfq2 = diffmin.
  680:    // Call after setDiffLimits. depth is the node depth used by xlmin2.
  681:    __device__ void init(Node *node);
  682: 
  683: 
  684:    __device__ __forceinline__ constexpr double cpsi1() const {
  685:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  686:       else if constexpr (turbSubmodel == KL)             return 0.9;
  687:       else if constexpr (turbSubmodel == KE)             return 1.44;
  688:       else if constexpr (turbSubmodel == KW)             return 0.555;
  689:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  690:       else { assert(false && "unknown submodel"); return 0.0; }
  691:    }
  692: 
  693:    
  694:    __device__ __forceinline__ constexpr double cpsi2() const {
  695:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  696:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  697:       else if constexpr (turbSubmodel == KL)             return 0.5;
  698:       else if constexpr (turbSubmodel == KE)             return 1.92;
  699:       else if constexpr (turbSubmodel == KW)             return 0.833;
  700:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  701:       else { assert(false && "unknown submodel"); return 0.0; }
  702:    }
  703: 
  704: 
  705:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  706: 
  707:    __device__ __forceinline__ double cpsi3(double N2) const {
  708: 
  709:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  710:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  711: 
  712:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  713: 
  714:       if constexpr (turbSubmodel == MellorYamada) {
  715:          return 0.9;   
  716: 
  717:       } else { // Other GLS submodels
  718: 
  719: 
  720:          if (N2 > 0.0) { // unstable (inverse stratification)
  721:             return 1.0;   
  722: 
  723:          } else { // stable (regular stratification)
  724: 
  725:             if      constexpr (turbSubmodel == KL)             return 2.53;
  726:             else if constexpr (turbSubmodel == KE)             return -0.52;
  727:             else if constexpr (turbSubmodel == KW)             return -0.58;
  728:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  729:             else { assert(false && "unknown submodel"); return 0.0; }
  730:          }
  731: 
  732:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  733: 
  734:    }
  735: 
  736:    
  737:    __device__ __forceinline__ constexpr double rpub(void) const {
  738:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  739:       else if constexpr (turbSubmodel == KL)             return  0.0;
  740:       else if constexpr (turbSubmodel == KE)             return  3.0;
  741:       else if constexpr (turbSubmodel == KW)             return -1.0;
  742:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  743:       else { assert(false && "unknown submodel"); return 0.0; }
  744:    }
  745: 
  746: 
  747:    __device__ __forceinline__ constexpr double rmub(void) const {
  748:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  749:       else if constexpr (turbSubmodel == KL)             return 1.0;
  750:       else if constexpr (turbSubmodel == KE)             return 1.5;
  751:       else if constexpr (turbSubmodel == KW)             return 0.5;
  752:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  753:       else { assert(false && "unknown submodel"); return 0.0; }
  754:    }
  755: 
  756: 
  757:    __device__ __forceinline__ constexpr double rnub(void) const {
  758:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  759:       else if constexpr (turbSubmodel == KL)             return  1.0;
  760:       else if constexpr (turbSubmodel == KE)             return -1.0;
  761:       else if constexpr (turbSubmodel == KW)             return -1.0;
  762:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  763:       else { assert(false && "unknown submodel"); return 0.0; }
  764:    }
  765: 
  766: 
  767:    __device__ __forceinline__ constexpr double schk(void) const {
  768:       if      constexpr (turbSubmodel == KL)             return 2.44;
  769:       else if constexpr (turbSubmodel == KE)             return 1.0;
  770:       else if constexpr (turbSubmodel == KW)             return 2.0;
  771:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  772:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  773:    }
  774: 
  775: 
  776:    __device__ __forceinline__ constexpr double schpsi(void) const {
  777:       if      constexpr (turbSubmodel == KL)             return 2.44;
  778:       else if constexpr (turbSubmodel == KE)             return 1.3;
  779:       else if constexpr (turbSubmodel == KW)             return 2.0;
  780:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  781:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  782:    }
  783: 
  784: 
  785:    __device__ __forceinline__ constexpr double tkemin(void) const {
  786:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  787:          return 5.0e-6;
  788:       else
  789:          return 7.6e-6; // Warner et al., OM 2005
  790:    }
  791: 
  792: 
  793:    __device__ __forceinline__ constexpr double psimin(void) const {
  794:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  795:          return 1.0e-8;
  796:       else
  797:          return 1.0e-12; // Warner et al., OM 2005
  798:    }
  799: 
  800:    __device__ __forceinline__ constexpr double epsmin(void) const {
  801:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  802:    }
  803: 
  804:    __device__ __forceinline__ double mxlmin(double depth) const;
  805: 
  806:    
  807:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  808: 
  809:    __device__ __forceinline__ double N2(Node *node, int k) const;
  810: 
  811: 
  812:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  813: 
  814:    __device__ void computeDiffusivities(Node *node);
  815: 
  816:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  817: 
  818: 
  819:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  820:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  821:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  822:    }
  823: 
  824: 
  825:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  826:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  827:    }
  828: 
  829: };
