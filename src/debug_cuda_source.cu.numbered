 6151:    __global__ void resetVelocityOpenBndNodes(void) {
 6152:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6153: 
 6154:       NODE_BND(nodebnd);
 6155: 
 6156:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6157:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6158:       }
 6159: 
 6160:    }
 6161: 
 6162: 
 6163:    __global__ void setVelocityOpenBndNodes(void) {
 6164:    // For open boundary nodes sets their velocity to the imposed values.
 6165: 
 6166:       SIDE_BND(sidebnd);
 6167: 
 6168:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6169:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6170:          // to its segment to the average of the side velocity.
 6171: 
 6172:          for (int k = 0; k < nvrt; k++) {
 6173:             Node *n1 = sidebnd->side->n1;
 6174:             Node *n2 = sidebnd->side->n2;
 6175: 
 6176: 
 6177:             Vector2 n1_u2(n1->u2[k]);
 6178:             Vector2 n2_u2(n2->u2[k]);
 6179: 
 6180:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6181:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6182:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6183:             }
 6184:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6185:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6186:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6187:             }
 6188: 
 6189:          }
 6190: 
 6191:       }
 6192: 
 6193:    }
 6194: 
 6195: 
 6196:    __global__ void computeVerticalVelocity(void) {
 6197:       // Computes the vertical velocity at the (2D) element's centroid.
 6198:       // In this function we will be considering volumetric elements, with side faces and a 
 6199:       // bottom and a top face. We will call them SFs, BF and TF.
 6200:       // It computes the flux coming from BF and the SFs.
 6201:       // If the bed is moving, it takes that into account.
 6202:       // Since water is incompressible, the integral of the velocity times the normal vector
 6203:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 6204:       // and the BF is equal to the flux going out from the TF.
 6205:       // TF = - BF - sum(SFs).
 6206:       // It then computes the horizontal velocity at the center of TF.
 6207:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 6208:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 6209:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 6210: 
 6211:       ELEM(elem);
 6212: 
 6213:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 6214: 
 6215:       if (elem->isDry) return;
 6216: 
 6217:       const int kb = elem->kb;
 6218:       const bool isTri = elem->isTri();
 6219: 
 6220:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 6221: 
 6222:       // Compute the average (over the element) of the bottom deformation at the previous and current timesteps
 6223:       const double av_bdef1 = elem->mean(&Node::bdef1);
 6224:       const double av_bdef2 = elem->mean(&Node::bdef2);
 6225: 
 6226:       Vector3 elem_n1 = elem->n(kb); // normal vector to the bottom face of the "volumetric" element (3D)
 6227: 
 6228:       double area3D;
 6229: 
 6230:       // Bottom face flux
 6231:       double bottomFlux = 0.0;
 6232:       Vector2 u2meanBottom = {0.0, 0.0};
 6233:       const Vector2 gradh = elem->grad2(&Node::depth);
 6234:       if constexpr(imm==2) {
 6235:          Vector3 ubed;
 6236: 
 6237:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 6238:          // updateBDEF(ubed);
 6239:      
 6240:          // const double bflux0 = dot(ubed, elem_n1);
 6241: 
 6242:          // elem->w[kb] += ubed.z;
 6243:       }
 6244:       else {
 6245:          Vector2 umean;
 6246:          if constexpr(ics == 1) {
 6247:             u2meanBottom = elem->mean(kb, &Side::u2);
 6248:          }
 6249:          else {
 6250:             assert(false && "computeVerticalVelocity: ics==1 not implemented for imm==0 or 1");
 6251:          }
 6252: 
 6253:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)
 6254:          elem->w[kb] = (av_bdef2 - av_bdef1)/dt - dot(gradh, u2meanBottom); // XXXX Is the dot prod always 0?
 6255: 
 6256:          bottomFlux = - dot(gradh, u2meanBottom);
 6257:       } // if imm
 6258: 
 6259:       // Compute w for kb+1 to nvrt-1
 6260:       for (int l = kb; l < nvrt - 1; l++) {
 6261: 
 6262:          // normal vector to the top face of the "volumetric" element (3D)
 6263:          Vector3 elem_n2 = elem->n(l + 1, area3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 6264: 
 6265:          // Compute the total flux at the sides
 6266:          double sideFlux = 0.0;
 6267: 
 6268:          for (int j = 0; j < elem->i34; j++) {
 6269:             const Side *side = elem->sides[j];
 6270: 
 6271:             const double sideArea = side->area(l);
 6272:             const Vector2 u2c = 0.5*(side->u2[l] + side->u2[l + 1]); // velocity at the center of the side
 6273:             const double sign = elem->ssign[j]; 
 6274: 
 6275:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 6276:          }
 6277:          
 6278:          // Compute the horizontal velocity at the center of the top face as an average of the 
 6279:          //velocities at the centers of the sides
 6280:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2);
 6281: 
 6282:          // The flx at the top ace can be computed from the other flows.
 6283:          const double topFlux = - sideFlux - bottomFlux;
 6284:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_n2))*area3D; // Part of the flux related to the horizontal velocity
 6285: 
 6286:          elem->w[l + 1] = (-sideFlux - topHorizontalFlux - bottomFlux)/(elem_n2.z*area3D);
 6287: 
 6288:          elem_n1 = elem_n2;
 6289: 
 6290:          bottomFlux = - topFlux;
 6291:       }
 6292:    }  
 6293: 
 6294: 
 6295: 
 6296: 
 6297: 
 6298: 
 6299: 
