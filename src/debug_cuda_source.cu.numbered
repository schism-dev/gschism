 6593:    __global__ void resetVelocityOpenBndNodes(void) {
 6594:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6595: 
 6596:       NODE_BND(nodebnd);
 6597: 
 6598:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6599:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 6600:       }
 6601: 
 6602:    }
 6603: 
 6604: 
 6605:    __global__ void setVelocityOpenBndNodes(void) {
 6606:    // For open boundary nodes sets their velocity to the imposed values.
 6607: 
 6608:       SIDE_BND(sidebnd);
 6609: 
 6610:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6611:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6612:          // to its segment to the average of the side velocity.
 6613: 
 6614:          for (int k = 0; k < nvrt; k++) {
 6615:             Node *n1 = sidebnd->side->n1;
 6616:             Node *n2 = sidebnd->side->n2;
 6617: 
 6618: 
 6619:             Vector2 n1_u2(n1->u2[k]);
 6620:             Vector2 n2_u2(n2->u2[k]);
 6621: 
 6622:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6623:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6624:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6625:             }
 6626:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6627:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6628:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6629:             }
 6630: 
 6631:          }
 6632: 
 6633:       }
 6634: 
 6635:    }
