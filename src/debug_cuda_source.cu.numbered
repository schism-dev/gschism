  183: 
  184: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  185:     return make_double2(a.x + b.x, a.y + b.y);
  186: }
  187: 
  188: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  189:     a.x += b.x;
  190:     a.y += b.y;
  191:     return a;
  192: }
  193: 
  194: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  195:     return make_double2(a.x - b.x, a.y - b.y);
  196: }
  197: 
  198: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  199:     a.x -= b.x;
  200:     a.y -= b.y;
  201:     return a;
  202: }
  203: 
  204: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  205:     return make_double2(v.x * s, v.y * s);
  206: }
  207: 
  208: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  209:     return v * s;  // reuse the previous operator
  210: }
  211: 
  212: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  213:     return make_double2(v.x / s, v.y / s);
  214: }
  215: 
  216: __device__ __forceinline__ double norm2(const double2& v) {
  217:     return v.x*v.x + v.y*v.y;
  218: }
  219: 
  220: __device__ __forceinline__ double length(const double2& v) {
  221:     return sqrt(v.x*v.x + v.y*v.y);
  222: }
  223: 
  224: __device__ __forceinline__ double2 normalize(const double2& v) {
  225:     return v / length(v);
  226: }
  227: 
  228: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  229:     return v.x*w.x + v.y*w.y;
  230: }
  231: 
  232: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  233:     return v.x*w.y - v.y*w.x;
  234: }
  235: 
  236: __device__ __forceinline__ double2 rot90(const double2& a) {
  237:     return make_double2(a.y, -a.x);
  238: }
  239: 
  240: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  241:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  242: }
  243: 
  244: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  245:     a.x += b.x;
  246:     a.y += b.y;
  247:     a.z += b.z;
  248:     return a;
  249: }
  250: 
  251: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  252:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  253: }
  254: 
  255: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  256:     return make_double3(v.x * s, v.y * s, v.z * s);
  257: }
  258: 
  259: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
