  162: // VECTOR/POINT operations ---------------------------------------------------------------------------
  163: 
  164: using Vector2 = double2; 
  165: using Vector3 = double3;
  166: using Point2  = double2;
  167: using Point3  = double3;
  168: 
  169: __device__ __host__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  170:     return make_double2(a.x + b.x, a.y + b.y);
  171: }
  172: 
  173: __device__ __host__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  174:     a.x += b.x;
  175:     a.y += b.y;
  176:     return a;
  177: }
  178: 
  179: __device__ __host__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  180:     return make_double2(a.x - b.x, a.y - b.y);
  181: }
  182: 
  183: __device__ __host__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  184:     a.x -= b.x;
  185:     a.y -= b.y;
  186:     return a;
  187: }
  188: 
  189: __device__ __host__ __forceinline__ double2 operator*(const double2& v, const double s) {
  190:     return make_double2(v.x * s, v.y * s);
  191: }
  192: 
  193: __device__ __host__ __forceinline__ double2 operator*(const double s, const double2& v) {
  194:     return v * s;  // reuse the previous operator
  195: }
  196: 
  197: __device__ __host__ __forceinline__ double2 operator/(const double2& v, double s) {
  198:     return make_double2(v.x / s, v.y / s);
  199: }
  200: 
  201: __device__ __host__ __forceinline__ double length(const double2& v) {
  202:     return sqrt(v.x*v.x + v.y*v.y);
  203: }
  204: 
  205: __device__ __host__ __forceinline__ double2 normalize(const double2& v) {
  206:     return v / length(v);
  207: }
  208: 
  209: __device__ __host__ __forceinline__ double dot(const double2& v, const double2& w) {
  210:     return v.x*w.x + v.y*w.y;
  211: }
  212: 
  213: __device__ __host__ __forceinline__ double cross(const double2& v, const double2& w) {
  214:     return v.x*w.y - v.y*w.x;
  215: }
  216: 
  217: __device__ __host__ __forceinline__ double2 rot90(const double2& a) {
  218:     return make_double2(a.y, -a.x);
  219: }
  220: 
  221: __device__ __host__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  222:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  223: }
  224: 
  225: __device__ __host__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  226:     a.x += b.x;
  227:     a.y += b.y;
  228:     a.z += b.z;
  229:     return a;
  230: }
  231: 
  232: __device__ __host__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  233:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  234: }
  235: 
  236: __device__ __host__ __forceinline__ double3 operator*(const double3& v, double s) {
  237:     return make_double3(v.x * s, v.y * s, v.z * s);
  238: }
  239: 
  240: __device__ __host__ __forceinline__ double3 operator*(double s, const double3& v) {
  241:     return v * s;
  242: }
  243: 
  244: __device__ __host__ __forceinline__ double3 operator/(const double3& v, double s) {
  245:     return make_double3(v.x / s, v.y / s, v.z / s);
  246: }
  247: 
  248: __device__ __host__ __forceinline__ double dot(const double3& v, const double3& w) {
  249:     return v.x*w.x + v.y*w.y + v.z*w.z;
  250: }
  251: 
  252: __device__ __host__ __forceinline__ Vector2 toVector2(const double3& v) {
  253:     return make_double2(v.x, v.y);
  254: }
  255: 
  256: __device__ __host__ __forceinline__ double3 toVector3(const double2& v, double w) {
  257:     return make_double3(v.x, v.y, w);
  258: }
  259: 
  260: __device__ __host__ __forceinline__ Point2 toPoint2(const double3& p) {
  261:     return make_double2(p.x, p.y);
  262: }
  263: 
  264: __device__ __host__ __forceinline__ Point3 toPoint3(const double2& p, double z) {
  265:     return make_double3(p.x, p.y, z);
  266: }
