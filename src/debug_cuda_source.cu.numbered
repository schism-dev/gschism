  440: struct Element {
  441: 
  442:    // Geometry information
  443:    int idx;               // Index of the element
  444:    int i34;               // Number of sides for the element 
  445:    Side *sides[4];        // Sides of the element
  446:    Node *nodes[4];        // Nodes of the element
  447:    Element *nghbElems[4]; // Neighbors of the element
  448: 
  449:    int kb;                    // Bottom index of the element
  450:    double area;               // Area of the element
  451:    double ssign[4];           // Sign associated with each side of an element
  452:    double radius;             // Element equivalent radii
  453: 
  454:    Frame frame;
  455: 
  456:    Vector2 gradPhi[4];       // Derivatives of shape functions
  457:    Vector2 gradEta;          // Gradient of free surface elevation
  458:    Vector2 gradPr;           // Gradient of pressure    
  459:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  460: 
  461:    bool isDry;                  // True if the element is dry
  462:    int kbe;                   // Bottom index of the element
  463: 
  464:    Vector3 center;            // Element center coordinates
  465:    double xlon_el, ylat_el;   // Element center lat/lon coordinates in _degrees_
  466:    double depth;              // Depth at element (min of all nodes)
  467:    double z[nvrt];            // z-coord  (local frame - vertical up)
  468: 
  469:    // Physical information
  470:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  471: 
  472:    static const bool isblock = false;              // Always false
  473: 
  474:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  475:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  476: 
  477:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  478: 
  479:    
  480: 
  481:    double vsource;            // Volumetric source/sink term [m^3/s]
  482: 
  483:    double rho[nvrt];          // Density at each prism center
  484:    double rho_mean[nvrt];     // Mean density at each prism center
  485:    CubicSpline rho_spl;
  486:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  487:    double rho_z[nvrt];        // First derivative of density at each prism center
  488:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  489: 
  490:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  491: 
  492:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  493:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  494: 
  495:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  496:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  497: 
  498:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  499:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  500:       // Find the local index of the node in the element (0,1,2,3)
  501:       int res = __ffs((nodes[0] == node) | 
  502:                      ((nodes[1] == node) << 1) | 
  503:                      ((nodes[2] == node) << 2) | 
  504:                      ((nodes[3] == node) << 3)) - 1;
  505:       
  506:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  507:       return res;
  508:    }
  509: 
  510:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  511:       // Find the local index of the side in the element (0,1,2,3)
  512:       int res = __ffs((sides[0] == side) | 
  513:                      ((sides[1] == side) << 1) | 
  514:                      ((sides[2] == side) << 2) | 
  515:                      ((sides[3] == side) << 3)) - 1;
  516:       
  517:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  518:       return res;
  519:    }
  520: 
  521: 
  522:    __inline__ __device__ int findLevel(double z1, int k) const {
  523:       // Starting at index k, find sequentially the level that contains z
  524: 
  525:       // if z is already betweeen z[k] and z[k+1], return k
  526:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  527:       else if (z1 < z[k]) { 
  528:          // Search for increasing levels
  529:          for (int kk = k; kk < nvrt - 1; kk++) {
  530:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  531:          }
  532:          return nvrt - 1;
  533:       }
  534:       else {
  535:          // Search for decreasing levels
  536:          for (int kk = k; kk > 0; kk--) {
  537:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  538:          }
  539:          return 0;
  540:       }
  541:    }
  542: 
  543:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  544:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  545: 
  546:    // Check if the element is dry using the more up-to-date elevation.
  547:    __inline__ __device__ bool isDry2(void) const;
  548: 
  549:    __inline__ __device__ bool isEdgeBoundary(Side *side) const;
  550: 
  551:    __inline__ __device__ double computeSignedArea(void) const;
  552: 
  553:    __inline__ __device__ void nudgeToBarycenter(Point2 &p) const {
  554:       // Nudges the point (x,y) to the barycenter of the element
  555:       p = (1-eps)*p + eps*toVector2(center);
  556:    }
  557: 
  558:    __device__ bool computeShapeCoords(Point2 xt, double shpCoords[4], bool fixNegShapeCoords = false) const;
  559: 
  560:    __device__ Vector2 grad2(double *a) const
  561:    {
  562:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  563:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  564:       if (isQuad()) {
  565:          gx += a[3]*gradPhi[3].x;
  566:          gy += a[3]*gradPhi[3].y;
  567:       }
  568:       return {gx, gy};
  569:    }
  570: 
  571:    __device__ Vector2 grad2(double Node::* field) const
  572:    {
  573:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  574:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  575:       if (isQuad()) {
  576:          gx += (nodes[3]->*field)*gradPhi[3].x;
  577:          gy += (nodes[3]->*field)*gradPhi[3].y;
  578:       }
  579:       return {gx, gy};
  580:    }
  581: 
  582:    __device__ void setFrame(void) {
  583: 
  584:       double ar1, ar2;
  585:       computeLonLat(center, ar1, ar2);
  586: 
  587:       frame.update(ar1, ar2);        
  588:     }
  589: 
  590:    __device__ bool findNextIntersection(Point2 x2, Side *&side, Element *&nextElement, double &t, 
  591:                                         double& tIntersect);
  592:    __device__ bool findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement, double &t, 
  593:                                         double& tIntersect);
  594: 
  595:    __inline__ __device__ bool containsPoint(Vector2 xt) const { 
  596:       // Check if the point (xt,yt) is inside the element
  597:       double shpCoords[4];
  598:       bool res = computeShapeCoords(xt, shpCoords, false);
  599:       return res;
  600:    }
  601: 
  602:    __device__ double interpolate(const double shapeCoords[4], const double zAtNodes[4]) const
  603:    {
  604:       // Interpolate the value at the point (xt,yt) using the shape coordinates and the values at the nodes
  605:       // This function works for both triangular and quadrilateral elements, since shapeCoords[3] is always 0.0 for triangular elements
  606:       return shapeCoords[0]*zAtNodes[0] + shapeCoords[1]*zAtNodes[1] + shapeCoords[2]*zAtNodes[2] + shapeCoords[3]*zAtNodes[3];
  607:       
  608:    }
  609: 
  610:    __device__ void interpolateVelocities(Point3 xt, Vector3& u_int) const;
  611: 
  612:    // ------------------------------------------------------------------------------------------------
  613:    // These are functions that work on all nodes of the element.
  614:    // They use a standard, but not well known, way of accessing the fields of the nodes.
  615:    //
  616:    // An example of how to use these functions is:
  617:    //   
  618:    //    getNodalValues(L, &Node::compZCoord, zLAtNodes);
  619:    // 
  620:    // Where L is the level at which the field is to be interpolated. The field can be either
  621:    // a double (depth), an array (u[nvrt]), or a function that depends on the level (Node::compZCoord(int k)). 
  622:    // There are different versions of getNodalValues for each of these cases.
  623: 
  624:    template<typename T>
  625:    __device__ void getNodalValues(T Node::* field, T res[4]) const {
  626:       // Get the values of the field at the nodes of the element
  627:       res[0] = nodes[0]->*field;
  628:       res[1] = nodes[1]->*field;
  629:       res[2] = nodes[2]->*field;
  630:       if (isQuad()) res[3] = nodes[3]->*field;
  631:       else          res[3] = T();
  632:    }
  633: 
  634:    template<typename T>
  635:    __device__ void getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
  636:       // Get the values of the field at the nodes of the element
  637:       res[0] = (nodes[0]->*field)[level];
  638:       res[1] = (nodes[1]->*field)[level];
  639:       res[2] = (nodes[2]->*field)[level];
  640:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
  641:       else          res[3] = T();
  642:    }    
  643: 
  644:    template<typename T>
  645:    __device__ void getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
  646:       // Get the values of the func at the nodes of the element
  647:       res[0] = (nodes[0]->*func)(level);
  648:       res[1] = (nodes[1]->*func)(level);
  649:       res[2] = (nodes[2]->*func)(level);
  650:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
  651:       else          res[3] = T();  // This is 0.0 or a zero vector
  652: 
  653:    }      
  654: 
  655:    template<typename T>
  656:    __device__ void getSideValues(T Side::* field, T res[4]) const {
  657:       // Get the values of the field at the nodes of the element
  658:       res[0] = sides[0]->*field;
  659:       res[1] = sides[1]->*field;
  660:       res[2] = sides[2]->*field;
  661:       if (isQuad()) res[3] = sides[3]->*field;
  662:       else          res[3] = T();
  663:    }
  664: 
  665:    template<typename T>
  666:    __device__ void getSideValues(int level, T (Side::* field)[nvrt], T res[4]) const {
  667:       // Get the values of the field at the nodes of the element
  668:       res[0] = (sides[0]->*field)[level];
  669:       res[1] = (sides[1]->*field)[level];
  670:       res[2] = (sides[2]->*field)[level];
  671:       if (isQuad()) res[3] = (sides[3]->*field)[level];
  672:       else          res[3] = T();
  673:    }    
  674: 
  675:    template<typename T>
  676:    __device__ void getSideValues(int level, T (Side::*func)(int) const, T res[4]) const {
  677:       // Get the values of the func at the nodes of the element
  678:       res[0] = (sides[0]->*func)(level);
  679:       res[1] = (sides[1]->*func)(level);
  680:       res[2] = (sides[2]->*func)(level);
  681:       if (isQuad()) res[3] = (sides[3]->*func)(level);
  682:       else          res[3] = T();  // This is 0.0 or a zero vector
  683: 
  684:    }      
  685: 
  686: 
  687:    __device__ double interpolate(int level, const double shapeCoords[4], double (Node::*func)(int) const) const {
  688:       double values[4];
  689:       getNodalValues(level, func, values);
  690: 
  691:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  692:    }
  693: 
  694:    template<typename T>
  695:    __device__ T interpolate(const double shapeCoords[4], T Node::* field) const {
  696:       T values[4];
  697:       getNodalValues(field, values);
  698:       
  699:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  700:    }
  701: 
  702: 
  703:    template<typename T>
  704:    __device__ T interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
  705:       T values[4];
  706:       getNodalValues(level, field, values);
  707: 
  708:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  709:    }
  710: 
  711:    template<typename T>
  712:    __device__ T mean(T Node::* field) const {
  713:       T values[4];
  714:       getNodalValues(field, values);
  715: 
  716:       return (values[0] + values[1] + values[2] + values[3])/i34;
  717:    }
  718: 
  719:    template<typename T>
  720:    __device__ T mean(T Side::* field) const {
  721:       T values[4];
  722:       getSideValues(field, values);
  723:       
  724:       return (values[0] + values[1] + values[2] + values[3])/i34;
  725:    }   
  726: 
  727:    // __device__ double mean(double (Node::*func)(int) const) const {
  728:    //    double values[4];
  729:    //    getNodalValues(level, func, values);
  730:    //    return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
  731:    // }
  732:    // ------------------------------------------------------------------------------------------------
  733: 
  734:    __device__ bool globalToLocal(double xt, double yt, double &xlocal, double &ylocal) const {
  735:       // Convert global coordinates to local coordinates
  736:       printf("NOT IMPLEMENTED: globalToLocal\n");
  737:       return true;
  738:    }
  739: 
  740:    __inline__ __device__ bool localToGlobal(double xlocal, double ylocal, double &xt, double &yt) const {
  741:       // Convert local coordinates to global coordinates
  742:       printf("NOT IMPLEMENTED: localToGlobal\n");
  743:       return true;
  744:    }
  745: 
  746:    __device__ void trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
  747:                                        double &dt, Point3 &xt, double zint, Vector3 &u_int);
  748:     
  749:    __device__ bool trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
  750:                                                  Element *&nextElem, int &jlev, double &dt);
  751: 
  752: };
