 3956: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3957:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3958:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3959:                 int *isdel, int *isidenode, int *isbnd,
 3960:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3961:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3962:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3963:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3964:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3965:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3966:                 double *drag, double *roughness,
 3967:                 double *emo, double *efa, 
