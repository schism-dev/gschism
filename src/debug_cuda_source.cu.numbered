 1938: 
 1939: // Helper functions for computing the local node index at a given offset from another.
 1940: __device__ __inline__ int nxq(int offset, int index, int size) {
 1941:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1942:    // to the index to make it positive
 1943:    assert(index + offset + 16*size >= 0);
 1944:    return (index + offset + 16*size) % size;  
 1945: }
 1946: 
 1947: __device__ __inline__ int nxq(int index, int size) {
 1948:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1949:    // to the index to make it positive
 1950:    assert(index + 16*size >= 0);
 1951:    return (index + 16*size) % size; 
 1952: }
