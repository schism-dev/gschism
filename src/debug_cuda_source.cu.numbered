 5462:    __global__ void resetBoundaryAreas(void) {
 5463:       // Reset boundary areas and lengths for each segment.
 5464: 
 5465:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5466:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5467:       SIDE_BND(sideBnd);
 5468: 
 5469:       BoundarySegment *segment = sideBnd->segment;
 5470: 
 5471:       segment->carea = 0.0;
 5472:       segment->clen = 0.0;
 5473:  
 5474:    }
 5475: 
 5476:    __global__ void computeBoundaryAreas(void) {
 5477:    // Calculation of cross-section areas and lengths for flow b.c.
 5478: 
 5479:       SIDE_BND(sideBnd);
 5480: 
 5481:       const Side *side = sideBnd->side;
 5482:       BoundarySegment *segment = sideBnd->segment;
 5483: 
 5484:       if (segment->ifltype != 0) {
 5485: 
 5486:          const Node *n1 = side->n1;
 5487:          const Node *n2 = side->n2;
 5488: 
 5489:          const double htot = side->htot2();
 5490: 
 5491:          if (!side->isDry) {
 5492:             atomicAdd(&segment->carea, htot*side->len);
 5493:             atomicAdd(&segment->clen, side->len);
 5494:          }
 5495:       }
 5496: 
 5497:    }
 5498: 
 5499: 
 5500:    __global__ void computeFlowBcVelocities(double time) {
 5501: 
 5502:       SIDE_BND(sideBnd);
 5503: 
 5504:       const Side *side = sideBnd->side;
 5505:  
 5506:       const bool isDry = side->isDry;
 5507:       const bool isLand = sideBnd->segment->isLand;
 5508: 
 5509:    
 5510:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5511: 
 5512:       if (isDry || isLand) return;
 5513: 
 5514:       // For wet sides in open boundaries...
 5515:       const Vector2 n = side->n;
 5516:       const BoundarySegment *segment = sideBnd->segment;
 5517: 
 5518:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5519: 
 5520:       const int ifltype = segment->ifltype;
 5521: 
 5522:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5523:       const Vector2 r_nuth0 = r_uth0*n;
 5524: 
 5525: 
 5526:       if (ifltype == 1 || ifltype == 2) {
 5527:       
 5528:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5529: 
 5530:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5531:          
 5532:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5533:          
 5534:       } else if (ifltype == -1) { // Flather 1
 5535: 
 5536:          for (int k = 0; k < nvrt; k++) {
 5537: 
 5538:             // uth is the normal vel.; no ramp up
 5539:             const double uth = sideBnd->nuth(k);
 5540:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5541: 
 5542:             sideBnd->ubc[k] += uth*n;
 5543:          }
 5544: 
 5545:       } else if (ifltype == 3 || ifltype == 5) {
 5546:          // vnth0=0 !normal vel.
 5547: 
 5548:          Vector2 r_u1_bar = {0.0, 0.0};
 5549:          // Computes the contribution to the velocity from all tide frequencies
 5550:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5551: 
 5552:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5553:             const Vector2 umo  = sideBnd->umo(jfr); 
 5554: 
 5555:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5556:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5557:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5558:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5559: 
 5560:          }
 5561: 
 5562: 
 5563:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5564: 
 5565:       } // if (ifltype = 3 || ifltype == 5
 5566: 
 5567: 
 5568: 
 5569:    }
 5570: 
 5571:    __global__ void computeElevationBoundaryConditions(double time) {
 5572:       // Compute elevation essential boundary conditions 
 5573: 
 5574:       NODE_BND(nodeBnd); // Each boundary node.
 5575: 
 5576:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5577: 
 5578:       const Node *node = nodeBnd->node;
 5579:       const BoundarySegment *segment = nodeBnd->segment;
 5580:       const int iettype = segment->iettype;
 5581:       
 5582: 
 5583:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5584:       double eic = 0.0;
 5585:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5586:       else                 eic = 0.0;
 5587: 
 5588:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5589:       const double r_eth = ramp*nodeBnd->eth;
 5590:       double r_eta1_bar = 0.0;
 5591: 
 5592:       // Compute tide elevation
 5593:       if (iettype == 3 || iettype == 5) {   
 5594: 
 5595:          if constexpr(iloadtide==1) { // loading tide
 5596:             assert(false && "Loading tide not implemented");
 5597:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5598:          }
 5599:          
 5600:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5601: 
 5602:             const double efa  = nodeBnd->efa[jfr]; 
 5603:             const double emo  = nodeBnd->emo[jfr]; 
 5604: 
 5605:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5606:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5607:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5608: 
 5609: 
 5610:          } // for jfr
 5611: 
 5612:       } // if iettype
 5613: 
 5614:       switch (iettype) {
 5615:          case 1:
 5616:          case 2:
 5617:          case 4:
 5618:             nodeBnd->elbc = r_eic + r_eth;
 5619:             break;
 5620:          case 3:
 5621:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5622:             break;
 5623:          case 5:
 5624:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5625:             break;
 5626:       } // switch
 5627: 
 5628: 
 5629:       //Add inverse barometric effects
 5630:       if (iettype != 0 && inv_atm_bnd == 1) {
 5631:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5632:       }
 5633: 
 5634:    }
 5635: 
 5636: 
 5637:    __global__ void computeHorizontalViscosity(void) { 
 5638: 
 5639:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5640: 
 5641:       SIDE(side);
 5642: 
 5643:       if (side->isDry) return;
 5644: 
 5645:       for (int k = 0; k < nvrt; k++) {
 5646:          side->nuGradU[k] = {0.0, 0.0};
 5647:       }
 5648: 
 5649:       if constexpr(ihorcon == 1) {
 5650:          for (int k = side->kb; k < nvrt - 1; k++) {
 5651:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5652:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5653:             // By Zhang and Baptista.
 5654: 
 5655:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5656:             // This is a standard discretization of the Laplacian operator.
 5657:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5658:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5659:             // Gamma is hvis_coef0 in the code.
 5660:             // The value of gamma needs to be < 0.5.
 5661: 
 5662:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5663:             // side under consideration in each of the two possible elements that share the side.
 5664:             Vector2 sumU = {0.0, 0.0};
 5665:             for (int l = 0; l < 2; l++) {
 5666:                const Element *elem = side->elems[l];
 5667: 
 5668:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5669: 
 5670:                // Find the local index of the side in the element
 5671:                const int idxSide = elem->sideLocalIdx(side);
 5672: 
 5673:                // Find the two sides that are connected to the side under consideration
 5674:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5675:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5676: 
 5677:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5678: 
 5679:             }
 5680: 
 5681:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5682: 
 5683:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5684:    
 5685:          }
 5686:       }
 5687:       else if constexpr(ihorcon == 2) {
 5688:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5689:       }
 5690: 
 5691: 
 5692:    }
 5693: 
 5694: 
 5695:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5696: 
 5697:       // Set essential boundary conditions 
 5698:       NODE(node); // Each boundary node
 5699:       NodeBoundary *nodeBnd = node->nodeBnd;
 5700:       
 5701:  
 5702:       // Check if this node has essential BC
 5703:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5704:          // Verify BC value is valid
 5705:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5706: 
 5707:        
 5708:          // Set diagonal to 1 and zero off-diagonals
 5709:          node->coeffDiag = 1.0;
 5710: 
 5711:          for (int j = 0; j < node->numNodes; j++) {
 5712:                node->coeffMatrix[j] = 0.0;
 5713:          }
 5714:          
 5715:          // Set solution and RHS to BC value
 5716:          node->mX  = nodeBnd->elbc;
 5717:          node->qel = nodeBnd->elbc;
 5718: 
 5719:       } else {
 5720:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5721: 
 5722:          for (int j = 0; j < node->numNodes; j++) {
 5723:                Node* nbNode = node->nodes[j];
 5724:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5725:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5726:                   // Verify neighbor's BC value
 5727:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5728: 
 5729:                   // Subtract contribution to RHS
 5730:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5731:                   node->coeffMatrix[j] = 0.0;  
 5732:                }
 5733:          }
 5734:       }
 5735:    }
 5736: 
 5737: 
 5738:    __global__ void updateElevation(void) {
 5739:       NODE(node);
 5740: 
 5741: 
 5742:       node->eta2 = node->mX;
 5743: 
 5744:       node->updateZCoordData();
 5745:    }
 5746: 
 5747: 
 5748:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5749: 
 5750:       SIDE(side);
 5751: 
 5752:       side->U = {0.0, 0.0}; 
 5753:          
 5754:       if(side->isDry) return;
 5755: 
 5756:       // Vertically integrated velocity U
 5757:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5758:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5759:          side->U += side->Dz(k + 1)*uc;  
 5760:       }
 5761: 
 5762:    }
 5763: 
 5764:    __global__ void computeBottomDragVegetation(void) {
 5765:       // UNFINISHED. CHECK THIS:
 5766:       // How many kernels are needed? Why so many for loops?
 5767:       // Is the loop on sides needed?
 5768: 
 5769:       NODE(node);
 5770: 
 5771: 
 5772:       const int    kb      = node->kb;
 5773:       const double htot    = node->htot2(); 
 5774:       
 5775:       if (node->isDry) {
 5776:          // Default values for dry nodes
 5777:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5778:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5779: 
 5780:          return;
 5781:        
 5782:       }
 5783: 
 5784:       // Computes bottom drag Cd based on the selected nchi
 5785:       node->computeBottomDragCd();
 5786:       
 5787: 
 5788: 
 5789:       //   Bottom stress in m^2/s^2
 5790:       if (node->rho[kb + 1] >= -98.0)
 5791:       {
 5792:          const double mag_u = length(node->u2[kb + 1]);
 5793:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5794: 
 5795:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5796:          // !sediment erosion: this part needs more documentation
 5797:       }
 5798:     
 5799: 
 5800: 
 5801:       // Compute vegetation parameters
 5802:       //--------------------------------
 5803: 
 5804:       // SAV constants
 5805:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5806:       constexpr double veg_cfpsi = 0.16;
 5807: 
 5808:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5809:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5810: 
 5811:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5812:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5813:          int kbin = 0; // bin index
 5814:          for (int k = kb; k < nvrt; k++) {
 5815:             // Computes node height above the bottom level
 5816:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5817:             assert(false && "Vertical variation of vegetation not implemented");
 5818: 
 5819:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5820:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5821:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5822:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5823:             // } else {
 5824:             //    // Find the bin at which the current vertical level is
 5825:             //    while (kbin<nbins_veg_vert) {
 5826:             //       const double zn = node->z[kbin];
 5827:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5828:             //          break;
 5829:             //       } // if
 5830:             //       kbin++;
 5831:             //    } // while
 5832:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5833: 
 5834:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5835:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5836:                
 5837:             //    // Linear interpolation of the vegetation parameters
 5838:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5839:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5840:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5841:             // } // if rl10
 5842: 
 5843:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5844: 
 5845:          } // for k
 5846: 
 5847: 
 5848:       } else { // Ganthy (iveg==2)
 5849:       //  Modify canopy height, diameter, and density
 5850: 
 5851:          // Make sure there is vegetation on this node
 5852:          if (node->veg_h_unbent > 0.0) {
 5853:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5854: 
 5855:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5856:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5857:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5858: 
 5859:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5860:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5861:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5862:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5863:          } // if veg_h_unbent
 5864: 
 5865:          for (int k = 0; k < nvrt; k++) {
 5866:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5867:          } // for k
 5868:       
 5869: 
 5870:       } // if iveg
 5871:      
 5872: 
 5873:       // Compute vertical mean of veg_alpha3D
 5874:       if (iveg != 0) {
 5875:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5876:          double sum1=0.0;
 5877:          double sum2=0.0;
 5878:          // Integrate over each level under the canopy...
 5879:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5880:             const double Dz = node->Dz(k);
 5881: 
 5882:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5883:             sum2 += Dz;
 5884: 
 5885:          } // for k
 5886:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5887:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5888: 
 5889:       } // if iveg
 5890: 
 5891:    }
 5892: 
 5893:    __global__ void computeVegetationAndDragParameters(void) {
 5894:       // Computes the vegetation and drag model parameters:
 5895:       // chi, \tilde\chi, beta, \breve{H}
 5896:       
 5897:       SIDE(side);
 5898: 
 5899:       side->hhat = 0.0;
 5900:       side->chi2 = 0.0;
 5901:       side->chi = 0.0;
 5902:       side->veg_c2 = 0.0;
 5903:       side->veg_beta = 0.0;
 5904: 
 5905:       if (side->isDry) return;
 5906: 
 5907:       const double htot = side->htot2();
 5908:       const int    kb   = side->kb;
 5909: 
 5910:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5911: 
 5912:       const double veg_h     = side->veg_h();
 5913:       const double veg_nv    = side->veg_nv();
 5914:       const double veg_c     = side->veg_c();
 5915:       const double veg_beta  = side->veg_beta;
 5916:       const double veg_alpha = side->veg_alpha_vert_mean();
 5917: 
 5918:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5919:       // Velocity magnitude at the bottom level
 5920:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5921:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5922:       side->chi2 = side->Cd()*vmag1;
 5923:       side->chi  = side->chi2;
 5924:       if constexpr(iveg != 0) {
 5925:          const Node *n1 = side->n1;
 5926:          const Node *n2 = side->n2;
 5927:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5928:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5929:       }
 5930: 
 5931:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5932: 
 5933:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5934:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5935:       double magUa = 0.0;
 5936:       if constexpr(iveg != 0) {
 5937:          if (side->is3D() && veg_h > 0.0) {
 5938:             // 3D wet side with veg...
 5939: 
 5940:             double magUa = 0.0;
 5941:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5942:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5943: 
 5944:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5945:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5946:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5947: 
 5948:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5949:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5950: 
 5951:                   // Velocity magnitude at the bottom (l) of the level
 5952:                   const double ul = length(side->u2[k]);
 5953: 
 5954:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5955:                   magUa += Dz*0.5*(uh + ul);
 5956: 
 5957:                } // if HasVegetation
 5958:             } // for k
 5959:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5960: 
 5961:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5962:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5963:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5964:                const double zCpy = side->zTopCanopy();
 5965:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5966:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5967:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5968:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5969:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5970:             } // if isSubmerged
 5971:          } // if is3D
 5972:       } // if iveg   
 5973: 
 5974:       // Computes the friction modified depth, \breve{H} in notes
 5975:       if (side->is2D()) { // 2D
 5976: 
 5977:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5978:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5979: 
 5980:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5981: 
 5982:          side->hhat = htot*htot/fricH; 
 5983: 
 5984:       } else { // 3D
 5985:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5986: 
 5987:          if constexpr(iveg != 0) {
 5988:             
 5989:             if (side->isSubmerged()) { 
 5990:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5991:                side->hhat -= veg_c*Hhat_alpha;
 5992: 
 5993:             } else { // Emergent
 5994:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5995:             }
 5996:          } // if iveg
 5997: 
 5998:          // Enforce positivity for 3D model
 5999:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 6000:       } // if 3D
 6001: 
 6002:    }
 6003: 
 6004: 
 6005: 
 6006:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 6007:    // Computes the density gradient between two elements, e1 and e2.
 6008:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 6009:    // zero in the direction normal to the side. 
 6010:    // 
 6011:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 6012:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 6013:    //
 6014:    // Input:
 6015:    //    e1: Element
 6016:    //    e2: Neighbor element (or nullptr if boundary)
 6017:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 6018:    //    k: Index of the half-level at which the density is interpolated
 6019:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 6020:    // 
 6021:    // Output:
 6022:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 6023:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 6024: 
 6025:       if (e2 == nullptr || e2->isDry) {
 6026:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 6027: 
 6028:          Side *side = e1->sides[j];
 6029:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 6030:                  
 6031:          if constexpr(ics == 1) {
 6032:             vec = side->n; // Normal vector to the side
 6033:          } else {
 6034:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6035:             // IMPLEMENT THIS XXXXXX
 6036:             // !replace with xel, yel?
 6037:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 6038:             //      &eframe(:,:,i),xn1,yn1,tmp)
 6039:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 6040:             //      &eframe(:,:,i),xn2,yn2,tmp)
 6041:          } //ics
 6042:                    
 6043:          diffRho = 0.0;
 6044: 
 6045:       } else { //internal and wet
 6046:          if constexpr(ics==1) {
 6047:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 6048: 
 6049:             // Vector from e1 to e2
 6050:             vec = e2->center - e1->center;
 6051: 
 6052:          } else { 
 6053:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 6054:             // Remember that elem->center is in global coordinates
 6055:             // IMPLEMENT THIS XXXXXX
 6056:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 6057:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 6058:             //                   alow(j)=xctr2
 6059:             //                   bdia(j)=yctr2
 6060:          } // ics
 6061: 
 6062:          diffRho = rho2 - e1->demeanedDensity(k);
 6063:       }
 6064: 
 6065:    }
 6066: 
 6067:    __global__ void computeDensityCubicSplines(void) {
 6068:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 6069: 
 6070:       ELEM(elem);
 6071: 
 6072:       if (elem->isDry) return;
 6073: 
 6074:       const int kb = elem->kb;
 6075: 
 6076:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 6077:       if (elem->is2D()) {
 6078:          // In the 2D case, the density is constant at the prism level. 
 6079:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 6080:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 6081:       } else { //3D
 6082: 
 6083:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 6084:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 6085:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 6086:          ///// XXXX CHECK INDICES!!!!!
 6087:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 6088:       } // 2D/3D
 6089: 
 6090:    }
 6091: } // extern "C"
 6092: 
 6093: 
 6094: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 6095: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 6096: 
 6097:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 6098: 
 6099:    const int kb  = elem->kb;
 6100:    const int kb2 = elem2->kb;
 6101: 
 6102:    // z-coordinate of prism of elem
 6103:    const double zp = elem->z_prism(k);
 6104: 
 6105:    double rho = 0.0;
 6106: 
 6107:    if (elem2->is2D()) {
 6108:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6109: 
 6110:    } else {  // 3D
 6111: 
 6112:       // eta_min may be < zmax
 6113:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6114:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6115: 
 6116:       // (Extrapolate density below bottom, we will fix it later)
 6117:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6118:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6119:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6120:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6121:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6122:    } // 2D/3D
 6123:      
 6124: 
 6125:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6126:    // Now we need to fix it.
 6127:    if (elem->z[k] < elem2->z[kb2]) {
 6128:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6129: 
 6130:       // There are two methods to adjust the density at the bottom of the element.
 6131:       // iunder_deep=0: 
 6132:       const double depth1 = abs(elem->z[kb]); // larger depth
 6133: 
 6134:       if (iunder_deep==0) {
 6135: 
 6136:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6137: 
 6138:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6139: 
 6140:       } else { // iunder_deep != 0
 6141: 
 6142:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6143: 
 6144:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6145: 
 6146:          //   Demeaned density at the same z coordinate as
 6147:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6148:          }
 6149: 
 6150:       } // if iunder_deep
 6151:    } // if elem->z[kb] < elem2->z[kb]
 6152: 
 6153:    return rho;
 6154: }
 6155: 
 6156: 
 6157: extern "C" {
 6158:    __global__ void computeDensityGradient(void) {
 6159: 
 6160:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6161:       if constexpr(ibc != 0) return;
 6162: 
 6163:          // Compute the horizontal density gradient at each element.
 6164:       // It works in two steps:
 6165:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6166:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6167:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6168:       //             gradRho.r1 = rho1 - rho0
 6169:       //             gradRho.r2 = rho2 - rho0
 6170:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6171:       // 
 6172:       //  NOTE: We use de-meaned densities.
 6173: 
 6174:       ELEM(elem);
 6175: 
 6176:       if (elem->isDry) return;
 6177: 
 6178:       const int kb  = elem->kb;
 6179:       const int i34 = elem->i34;
 6180: 
 6181:       for (int k = kb + 1; k < nvrt; k++) {
 6182:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6183:          //             gradRho.r1 = rho1 - rho0
 6184:          //             gradRho.r2 = rho2 - rho0
 6185:          int icount = 0;
 6186:          double sumRx = 0.0;
 6187:          double sumRy = 0.0;
 6188:          for (int j1=0; j1<i34; j1++) { 
 6189: 
 6190:             const int j2 = elem->nxq(j1 + 1);
 6191: 
 6192:             // Pairs of consecutive neighbor elements of elem
 6193:             const Element *e1 = elem->nghbElems[j1];
 6194:             const Element *e2 = elem->nghbElems[j2];
 6195: 
 6196:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6197:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6198:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6199: 
 6200:             // Compute the density difference and the vector from elem to e1 and e2
 6201:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6202:             double diffRho1, diffRho2;
 6203:             Vector2 vec1, vec2;
 6204:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6205:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6206: 
 6207:             const double rl1 = length(vec1);
 6208:             const double rl2 = length(vec2);
 6209:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6210: 
 6211:             const double delta = cross(vec1, vec2);
 6212:             const double sintheta = abs(delta)/(rl1*rl2);
 6213: 
 6214:             // To avoid problems, avoid elements with small angle between vectors
 6215:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6216:             const bool validEq = (sintheta > sin_one_deg);
 6217: 
 6218:             if (validEq) {
 6219:                // Solve the system of equations to get the density gradient at elem
 6220:                icount++;
 6221:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6222:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6223:                sumRx += Rx;
 6224:                sumRy += Ry;
 6225:             }
 6226:          } // for j1
 6227: 
 6228:          // Compute the average density gradient at elem
 6229:          if (icount==0) {
 6230:            // Bad mesh quality; bail out with 0 b-cc
 6231:            elem->gradRho[k] = {0.0, 0.0};
 6232:          } else {
 6233:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6234:          }
 6235: 
 6236:       } // for k
 6237: 
 6238:    }
 6239: 
 6240:    __global__ void computeBaroclinicTerm(void) {
 6241:    // Computes the baroclinic term at sides (at half levels).
 6242:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6243:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6244: 
 6245:       if (ibc == 1) return;
 6246: 
 6247:       SIDE(side);
 6248: 
 6249:       if (side->isDry) return;
 6250: 
 6251:       const Element *e1 = side->elems[0];
 6252:       const Element *e2 = side->elems[1]; 
 6253:       const int kb = side->kb;
 6254:       
 6255:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6256: 
 6257:       // interpolates vertically the density gradient of the two elements at the half level/
 6258: 
 6259:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6260:       int k2 = max(kb, nvrt / 2);
 6261: 
 6262:       // Starts the integration at the surface and goes down to the bottom
 6263:       side->bcc[nvrt-1] = {0.0, 0.0};
 6264:       for (int k = nvrt - 2; k >= kb; k--) {
 6265:       // For each prism level (from surface to bottom)...
 6266: 
 6267:          // For both elements, interpolate density gradient at the side's half level.
 6268:          // The gradient at the side is the average of the gradients at the elements.
 6269:          // w1, w2 are used to take into account boundary sides, with just one element.
 6270:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6271:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6272:          const double wsum = w1 + w2;
 6273:          w1 = w1/wsum;
 6274:          w2 = w2/wsum;
 6275:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6276: 
 6277:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6278:          Vector2 gradRho = {0.0, 0.0};
 6279:          if (e1 != nullptr && k > kb) {
 6280:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6281:             
 6282:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6283:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6284:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6285: 
 6286:             // Grad(rho) vertically interpolated at the side's half level
 6287:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6288: 
 6289:             // Projects the element density gradient to the side frame if needed.
 6290:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6291: 
 6292:             // Adds the contribution of the density gradient at the side's half level
 6293:             gradRho += gradRho1*w1;
 6294:          }      
 6295:          if (e2 != nullptr && k > kb) {
 6296:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6297:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6298:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6299:             
 6300:             // Grad(rho) vertically interpolated at the side's half level
 6301:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6302: 
 6303:             // Projects the element density gradient to the side frame if needed.
 6304:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6305: 
 6306:             // Adds the contribution of the density gradient at the side's half level
 6307:             gradRho += gradRho2*w2;
 6308:          }
 6309: 
 6310:          
 6311:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6312:          // multiplied by -rampbc*(g/rho0) 
 6313:          const double grav3 = side->grav3();
 6314:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6315: 
 6316:       } // for
 6317: 
 6318:    }
 6319: 
 6320: 
 6321: 
 6322:    __global__ void computeHorGradientAtSide(void) {
 6323: 
 6324:       // Compute the horizontal density gradient at each element.
 6325:       // It works in two steps:
 6326:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6327:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6328:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6329:       //             gradRho.r1 = rho1 - rho0
 6330:       //             gradRho.r2 = rho2 - rho0
 6331:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6332:       // 
 6333:       //  NOTE: We use de-meaned densities.
 6334: 
 6335:       SIDE(side);
 6336: 
 6337: 
 6338:       if (side->isDry) return;
 6339: 
 6340:       // Computes the gradient of the variables at the side center.
 6341:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6342:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6343:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6344: 
 6345:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6346:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6347:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6348:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6349: 
 6350:    }
 6351: 
 6352: 
 6353:    __global__ void solveMomentumEquations(double time) {
 6354: 
 6355:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6356:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6357: 
 6358:       SIDE(side);
 6359: 
 6360:       if (side->isDry) 
 6361:       {
 6362:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6363: 
 6364:          return;
 6365:       }
 6366: 
 6367:       const Node *n1 = side->n1;
 6368:       const Node *n2 = side->n2;
 6369: 
 6370:       const int kb = side->kb;
 6371: 
 6372:       const double veg_h = side->veg_h();
 6373:       const double grav3 = side->grav3();
 6374: 
 6375:       if (side->is2D()) {
 6376:          // Remember: Do not use htot2, which is updated.
 6377:          const double htot = side->htot1();
 6378:          const double hhat = side->hhat;
 6379: 
 6380:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6381: 
 6382:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6383:          const Vector2 tau2 = side->tau();
 6384: 
 6385:          // hat_gam has units of m/s
 6386: 
 6387:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6388:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6389:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6390: 
 6391:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6392: 
 6393: 
 6394:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6395: 
 6396:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6397: 
 6398:       }
 6399:       else { // 3D
 6400: 
 6401:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6402:          // 
 6403:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6404:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6405:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6406:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6407:          // k+1 and k.
 6408: 
 6409: 
 6410:          const int ndim = nvrt - kb;
 6411:          const double zTopCanopy = side->zTopCanopy();
 6412: 
 6413:          // Initialize the tridiagonal system
 6414:          for (int k = kb + 1; k < nvrt; k++) {
 6415:             
 6416:             const int kin = k - (kb + 1);
 6417: 
 6418:             // Vertical viscosity at the face center
 6419:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6420: 
 6421:  
 6422:             alow[kin] = 0.0;
 6423:             cupp[kin] = 0.0;
 6424:             bdia[kin] = 0.0;
 6425: 
 6426:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6427:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6428: 
 6429:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6430:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6431:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6432: 
 6433:             // First part: layers k, k+1
 6434:             if (k < nvrt - 1) {
 6435:                              
 6436:                if constexpr(iveg != 0) {
 6437: 
 6438:                   // If there is vegetation at this level...
 6439:                   if (zTopCanopy > side->zc[k]) {
 6440:                      // If the canopy is above the k layer...
 6441:                      
 6442:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6443:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6444:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6445:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6446: 
 6447:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6448:                      const double vmag2 = length(ut2);
 6449:                      const double vmag1 = length(side->u2[k]);
 6450:                      const double vmag = 0.5*(vmag1 + vmag2);
 6451:                      
 6452:                      // Computes the vegetation alpha at the face center
 6453:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6454: 
 6455:                      cff1 += veg_alpha_sd*dt*vmag;
 6456: 
 6457:                   } // if (zTopCanopy
 6458:                } // if iveg
 6459: 
 6460:                const double dzz = side->Dz(k + 1);
 6461:                const double tmp = dt*dfz/dzz;
 6462:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6463: 
 6464:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6465:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6466:             }
 6467: 
 6468: 
 6469:             // Second part: layers k-1, k
 6470:             if (k > kb + 1) {
 6471: 
 6472:                double cff1 = 1.0; //init \bar{c^k}
 6473: 
 6474:                if constexpr(iveg != 0) {
 6475:                   // If there is vegetation at this level...
 6476:                   if (zTopCanopy > side->zc[k-1]) {
 6477:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6478:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6479: 
 6480:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6481: 
 6482:                      const double vmag2 = length(ut2);
 6483:                      const double vmag1 = length(side->u2[k-1]);
 6484:                      const double vmag = 0.5*(vmag1 + vmag2);
 6485: 
 6486:                      // Computes the vegetation alpha at the face center
 6487:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6488:                      cff1 += veg_alpha_sd*dt*vmag;
 6489:                   } // if zTopCanopy
 6490: 
 6491:                } // if iveg
 6492: 
 6493:                const double dzz = side->Dz(k);
 6494:                const double tmp = dt*dfz/dzz;
 6495:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6496: 
 6497:                alow[kin] += cff1*dzz/6.0 - tmp;
 6498:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6499: 
 6500:             } else { // Bottom boundary
 6501:                // This occurs at the bottom, where the bottom drag is applied.
 6502: 
 6503:                bdia[kin] += dt*side->chi2; // XXXX
 6504: 
 6505:             } // if (k > kb + 1)
 6506: 
 6507: 
 6508:          } // for (int k
 6509: 
 6510: 
 6511: 
 6512:          // Computes the RHS.
 6513:          // -----------------
 6514: 
 6515:          //	BC to be imposed at the end.
 6516: 
 6517:          const Vector2 gradETP  = side->gradETP;
 6518:          const Vector2 gradPr   = side->gradPr;
 6519:          const Vector2 gradEta1 = side->gradEta1;
 6520:          const Vector2 gradEta2 = side->gradEta2;
 6521: 
 6522:          const Vector2 *btu = side->btu;
 6523:          const Vector2 *u2  = side->u2;
 6524:          const double coriolis = side->coriolis;
 6525:          const Vector2 *nuGradU = side->nuGradU;
 6526: 
 6527:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6528:          for (int k = kb + 1; k < nvrt; k++) {
 6529:             const int kin = k - kb - 1;
 6530: 
 6531:             const double dz_0 = side->Dz(k);
 6532:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6533: 
 6534:             rrhs[kin] = {0.0, 0.0};
 6535:             double dz = 0.0;
 6536: 
 6537:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6538:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6539:             if (k < nvrt  ) dz += dz_1;
 6540:             if (k > kb + 1) dz += dz_0;
 6541: 
 6542:             // Elevation gradient, atmospheric pressure and tidal potential
 6543:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6544: 
 6545:             // Coriolis, advection, wind stress, and horizontal viscosity
 6546:             if (k < nvrt - 1) {
 6547: 
 6548: 
 6549:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6550:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6551:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6552:                                                 
 6553: 
 6554:                //diff stress tensors 1006
 6555:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6556:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6557:                   assert(false && "Not implemented: itur == 5");
 6558:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6559:                }
 6560:                // else assert(false && "itur # Not implemented");
 6561: 
 6562:             } else { // k == nvrt - 1 SURFACE
 6563:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6564:                const Vector2 tau2 = side->tau();
 6565: 
 6566:                rrhs[kin] += dt*tau2;          
 6567: 
 6568:             } // if k<nvrt
 6569: 
 6570: 
 6571:             if (k > kb + 1) {
 6572:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6573:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6574:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6575: 
 6576:                // diff stress tensors 1006
 6577:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6578:                   assert(false && "Not implemented: itur == 5");
 6579:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6580:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6581:                }
 6582:                // else assert(false && "itur # Not implemented");
 6583: 
 6584: 
 6585:             } // if k>kbs + 1
 6586: 
 6587:             // Baroclinic
 6588:             Vector2 *bcc = side->bcc;
 6589:             if constexpr(ibc == 0) {
 6590:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6591:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6592: 
 6593:             } // if ibc==0
 6594: 
 6595:          } // k=kb + 1,nvrt
 6596: 
 6597: 
 6598:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6599: 
 6600:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6601:             const int kin = k - kb - 1;
 6602:    
 6603:             // Velocity is always clamped to maximum values
 6604:             side->u2[k] = clampVelocity(soln[kin]);
 6605:          } // k
 6606: 
 6607:       } // if side->is2D()
 6608:       
 6609: 
 6610:       // Impose velocity boundary condition at the bottom
 6611:       if constexpr(imm == 2) { // 3D bed deformation model
 6612:          double dep;
 6613:          Vector2 vel;
 6614: 
 6615:          assert(false && "Not implemented: imm == 2");
 6616:          //update_bdef(time, x0, y0, dep, vel);
 6617:          // side->u2[kb] = vel;
 6618: 
 6619:       } else { // imm = 0 or 1
 6620:          if (side->Cd() == 0.0) {
 6621:             side->u2[kb] = side->u2[kb + 1];
 6622: 
 6623:          } else if (side->is3D()) { // 3D no slip bottom   
 6624:             side->u2[kb] = {0.0, 0.0};
 6625: 
 6626:          }
 6627:           
 6628:       } // if imm
 6629: 
 6630:       // The velocities below the bottom level are set to zero
 6631:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6632: 
 6633: 
 6634:    }
 6635: 
 6636: 
 6637:    __global__ void applyMomentumBC(void) {
 6638: 
 6639:       SIDE_BND(sideBnd);
 6640: 
 6641:       Side *side = sideBnd->side;
 6642:       const BoundarySegment *segment = sideBnd->segment;
 6643:       const Node *n1 = side->n1;
 6644:       const Node *n2 = side->n2;
 6645: 
 6646:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6647: 
 6648:       const bool isLand = segment->isLand;
 6649:       const int ifltype = segment->ifltype;
 6650: 
 6651:       const int kb = side->kb;
 6652: 
 6653: 
 6654:       if (!isLand && ifltype != 0) {
 6655:          const Vector2 *ubc = sideBnd->ubc;
 6656:   
 6657:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6658:             
 6659:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6660:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6661: 
 6662:             if (ifltype == -1) {
 6663:                // Flather 1
 6664: 
 6665:                const double depth = side->depth();
 6666: 
 6667:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6668: 
 6669:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6670: 
 6671:                side->u2[k] = vnorm*side->n;
 6672: 
 6673:             } else if (ifltype == -2) { // Discharge
 6674: 
 6675:                const double eta1 = side->eta1();
 6676:                const double eta2 = side->eta2();
 6677:                const double htot = side->htot2();
 6678: 
 6679:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6680:                assert(false && "Not implemented: Discharge bc");
 6681:                // const double dischrg = discharge(eta1);
 6682:                const double dischrg = 0.0; // XXX REMOVE
 6683:                
 6684: 
 6685:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6686: 
 6687:                const double vnorm = dischrg*eta2/htot;
 6688: 
 6689:                side->u2[k] = vnorm*side->n;
 6690: 
 6691:             }
 6692:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6693:                const double vnorm = dot(side->u2[k], side->n);
 6694: 
 6695:                double rat;
 6696:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6697:                else              rat = segment->vobc2; // outgoing
 6698: 
 6699:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6700: 
 6701:             }
 6702:             else { // not Flather or 3D radiation
 6703:                side->u2[k] = ubc[k];
 6704: 
 6705:             } // if (segment->ifltype...
 6706: 
 6707:          }
 6708: 
 6709:       }
 6710:       else if (isLand) { // if it is land boundary side
 6711: 
 6712:          if constexpr(islip == 0) { // free slip
 6713: 
 6714:             for (int k = kb; k < nvrt; k++) {
 6715: 
 6716:                const Vector2 t = side->t();
 6717:                const Vector2 n = side->n;
 6718: 
 6719:                double vnorm = 0.0; // for most cases
 6720:                const double vtan = dot(side->u2[k], t);
 6721:                
 6722:                side->u2[k] = vtan*t - vnorm*n;
 6723: 
 6724:             }
 6725: 
 6726:          } else { // no slip
 6727:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6728: 
 6729:          }
 6730:       } // if (side segment type...
 6731: 
 6732:    }
 6733: 
 6734: 
 6735:    __global__ void shapiroFilter1(void) {
 6736:       // First step of the Shapiro filter (normally used if indvel<=0)
 6737:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6738: 
 6739:       SIDE(side);
 6740: 
 6741:       // Only internal wet sides are processed
 6742:       if (side->isDry || !(side->isInternal())) return;
 6743: 
 6744:       const int kb = side->kb;
 6745: 
 6746:       for (int mm = 0; mm < niter_shap; mm++) {
 6747: 
 6748:          for (int k = kb + 1; k < nvrt; k++) {
 6749:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6750:             Vector2 suru = {0.0, 0.0};
 6751: 
 6752:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6753: 
 6754:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6755: 
 6756:                int kin = k;
 6757:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6758:                
 6759:                // Get the velocity at the neighbor's side.
 6760:                Vector2 nSideU2 = nSide->u2[kin];
 6761: 
 6762:                // Projects the velocity to the current side frame if needed.
 6763:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6764: 
 6765:                suru += nSideU2;
 6766:             }
 6767: 
 6768:             // Reusing bcc as a temporary array to store the suru values.
 6769:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6770: 
 6771:          }
 6772:       }
 6773:    }
 6774: 
 6775:    __global__ void shapiroFilter2(void) {
 6776:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6777: 
 6778:       SIDE(side);
 6779: 
 6780: 
 6781:       if (side->isDry || !(side->isInternal())) return;
 6782: 
 6783:       const int kb = side->kb;
 6784: 
 6785:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6786: 
 6787:       if (side->is2D()) {
 6788:          side->u2[kb + 1] = side->bcc[kb + 1];
 6789:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6790: 
 6791:       } else {
 6792:          // 3D
 6793:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6794:          
 6795:       }
 6796: 
 6797:    }
 6798: 
 6799: 
 6800:    __global__ void ul0UpdateZCoords(void) {
 6801:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6802:       
 6803:       NODE(node);      
 6804: 
 6805: 
 6806:       if (false) { //node->isDry) { XXXXXXX
 6807: 
 6808:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6809: 
 6810:          if constexpr(ivcor != 1) node->kb = 0;
 6811: 
 6812:       } else {
 6813: 
 6814:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6815:          node->updateKb();
 6816: 
 6817:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6818: 
 6819:       }
 6820: 
 6821:       // We use the temp.b field to store the previous state of isDry.
 6822:       node->tmp.b = node->isDry;
 6823: 
 6824:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6825:       node->isDry = true;
 6826: 
 6827:    }
 6828: 
 6829:    __global__ void ul0ComputeDryElements(void)
 6830:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6831:    {
 6832:       ELEM(elem);
 6833: 
 6834:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6835: 
 6836:       elem->kb = 0;
 6837: 
 6838:       if (elem->isDry) return;
 6839: 
 6840: 
 6841:    //    if(elem->isDry2()) { // XXXX
 6842:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6843:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6844:    //        call parallel_abort(errmsg)
 6845:    //    }
 6846: 
 6847:       const Node *n1 = elem->nodes[0];
 6848:       const Node *n2 = elem->nodes[1];
 6849:       const Node *n3 = elem->nodes[2];  
 6850:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6851: 
 6852:       // Computes element's kb as the minimum of the nodes' kb.
 6853:       const int kb1 = n1->kb;
 6854:       const int kb2 = n2->kb;
 6855:       const int kb3 = n3->kb;
 6856:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6857: 
 6858: 
 6859:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6860: 
 6861: 
 6862:       // Computes the element z as the mean of the nodes z.
 6863:       for (int k = elem->kb; k < nvrt; k++) {
 6864: 
 6865:          // Compute the element z as the mean of the nodes z.
 6866:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6867:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6868:          elem->z[k] /= elem->i34;
 6869: 
 6870:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6871:       }
 6872:                   
 6873:    }
 6874: 
 6875:    __global__ void ul0ComputeDryNodes(void)
 6876:    // Updates node's isDry based on the elements' isDry. 
 6877:    {
 6878:       NODE(node);
 6879: 
 6880:       node->isDry = true;
 6881: 
 6882:       // A node is wet if at least one of the elements sharing it is wet.
 6883:       for (int j = 0; j < node->numElements; j++) {
 6884:          const Element *elem = node->elements[j];
 6885:          if (!elem->isDry) {
 6886:             node->isDry = false;
 6887:             break;
 6888:          }
 6889:       }
 6890: 
 6891:        
 6892:    }
 6893: 
 6894: 
 6895:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6896:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6897:    // node->tmp.b is true if the node was previously dry.
 6898:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6899:    {
 6900:       NODE(node);
 6901:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6902: 
 6903:       // Avoid this the first time step.
 6904:       if (it == iths) return;  
 6905: 
 6906:       const bool wasDry = node->tmp.b;
 6907: 
 6908: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6909: 
 6910:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6911: 
 6912:          for (int k=0; k < nvrt; k++) {
 6913: 
 6914:             Vector3 utmp={0.0, 0.0, 0.0};
 6915: 
 6916:             double ttmp=0.0;
 6917:             double stmp=0.0;
 6918:             int icount=0;
 6919:             for (int j = 0; j < node->numNodes; j++) {
 6920: 
 6921:                const Node *nbrNode = node->nodes[j];
 6922:                
 6923:                const bool wasNbrDry = nbrNode->tmp.b;
 6924: 
 6925:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6926:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6927: 
 6928:                   icount++;
 6929: 
 6930:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6931:                   utmp += nbrNode->uvw2(k);
 6932:                   
 6933:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6934:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6935:                }
 6936:             }
 6937: 
 6938:             if (icount > 0) {
 6939:                const double inv_icount = 1.0/icount;
 6940:                utmp = inv_icount*utmp;
 6941:                node->u2[k]     = {utmp.x, utmp.y};
 6942:                node->w2[k]     = utmp.z;
 6943:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6944:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6945:             } else {
 6946:                node->u2[k] = {0.0, 0.0};
 6947:                node->w2[k] = 0.0;
 6948:                // Initialize tracers to 0.0??? XXXXX
 6949:             }
 6950:          }
 6951:       }
 6952:    }
 6953: 
 6954:   
 6955:    
 6956: 
 6957: 
 6958:    __global__ void ul0UpdateSides(int it, int iths) {
 6959:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6960:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6961:    // The dryness of the sides is updated in ul0UpdateSides2.
 6962: 
 6963:       SIDE(side);
 6964: 
 6965:       // A side is wet if and only if at least one of its elements is wet.
 6966:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6967:  
 6968:       const Node *n1 = side->n1;
 6969:       const Node *n2 = side->n2;
 6970:      
 6971:       const int kb1 = n1->kb;
 6972:       const int kb2 = n2->kb;
 6973: 
 6974:       side->kb = 0; // default when dry
 6975: 
 6976:       if (isWet) {
 6977: 
 6978:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6979: 
 6980:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6981: 
 6982:          side->kb = min(kb1, kb2);
 6983: 
 6984:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6985: 
 6986:          for (int k = side->kb; k < nvrt; k++) {
 6987:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6988: 
 6989:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6990: 
 6991:             // Compute velocity for re-wetted sides 
 6992:             if ((it != iths) && (side->isDry && isWet)) {
 6993: 
 6994:                Vector2 utmp={0.0, 0.0};
 6995: 
 6996:                int icount=0;
 6997: 
 6998:                // For all the sides on the two elements that share this side
 6999:                for (int j = 0; j < 2; j++) {
 7000:                   const Element *elem = side->elems[j];
 7001:                   if (elem == nullptr) continue;
 7002: 
 7003:                   for (int jj=0; jj < elem->i34; jj++) {
 7004:                      const Side *nSide = elem->sides[jj];
 7005:                      if (nSide->isDry) continue;
 7006: 
 7007:                      icount++;
 7008:                      utmp += nSide->u2[k];  
 7009:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 7010:                   }
 7011:                }
 7012:                   
 7013:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 7014:                if (icount > 0)  side->u2[k] = utmp/icount;
 7015:                else             side->u2[k] = {0.0, 0.0};
 7016:                   
 7017:             } // if ((it != iths) && (side->isDry && isWet))
 7018: 
 7019:          } // for k
 7020: 
 7021:       } // if isWet 
 7022:       
 7023: 
 7024: 
 7025:    }
 7026: 
 7027:    __global__ void ul0UpdateSides2(void) {
 7028:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 7029:    
 7030:          SIDE(side);
 7031:    
 7032:          const Element *e1 = side->elems[0];
 7033:          const Element *e2 = side->elems[1];
 7034: 
 7035:          // A side is wet if and only if at least one of its elements is wet.
 7036:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 7037: 
 7038:          // Update the side's dryness
 7039:          side->isDry = !isWet;
 7040: 
 7041:    }
 7042: 
 7043: 
 7044:    __global__ void zeroNodalVelocities(void) {
 7045:       NODE(node);
 7046: 
 7047:       for (int k = 0; k < nvrt; k++) {
 7048:          node->u2[k]   = {0.0, 0.0};
 7049:          node->w2[k]   = 0.0;
 7050:          node->utmp[k] = {0.0, 0.0};         
 7051:       }
 7052:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 7053:    }
 7054:  
 7055: 
 7056:    __global__ void computeNodalVerticalVelocities1(void) {
 7057:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7058:    // Adds the element's vertical velocity times the element's area.
 7059:       ELEM(elem);
 7060: 
 7061:       for (int j = 0; j < elem->i34; j++) {
 7062:          Node *node = elem->nodes[j];
 7063: 
 7064:          for (int k = node->kb; k < nvrt; k++) {
 7065:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 7066:          }
 7067:          atomicAdd(&(node->tmp.d), elem->area);
 7068:       }
 7069:    }
 7070: 
 7071:    __global__ void computeNodalVerticalVelocities2(void) {
 7072:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 7073:    // Divides by the total area of the elements sharing the    node.
 7074:       NODE(node);
 7075: 
 7076: 
 7077:       const double invArea = 1.0 / node->tmp.d;
 7078:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 7079: 
 7080:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 7081:    }
 7082: 
 7083: 
 7084:    __global__ void computeNodalHorizontalVelocities1(void) {
 7085: 
 7086:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 7087: 
 7088:       ELEM(elem);
 7089: 
 7090:       if (elem->isDry) return;
 7091: 
 7092:       const int kb = elem->kb;
 7093:       const bool isTri = elem->isTri();
 7094: 
 7095:       if constexpr(indvel <= 0) {
 7096:          // Assuming discontinous hvel.
 7097: 
 7098:          if (isTri) { // For triangles
 7099:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7100:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7101: 
 7102:             for (int j = 0; j < 3; j++) {
 7103:                // For every node of the triangle...
 7104:                Node *node = elem->nodes[j];
 7105: 
 7106:                if (node->isDry) continue;
 7107: 
 7108:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7109:                const Side *s2 = elem->sides[(j + 1) % 3];
 7110:                const Side *s3 = elem->sides[(j + 2) % 3];
 7111: 
 7112:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7113: 
 7114:                atomicAdd(&(node->tmp.i), 1);
 7115: 
 7116:                for (int k = kb; k < nvrt; k++)  {
 7117:                   Vector2 s1u2 = s1->u2[k];
 7118:                   Vector2 s2u2 = s2->u2[k];
 7119:                   Vector2 s3u2 = s3->u2[k];
 7120: 
 7121:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7122:                   if constexpr(ics == 2) {
 7123:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7124:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7125:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7126:                   }
 7127: 
 7128:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7129:                   u = clampVelocity(u);
 7130:                   atomicAdd(&(node->utmp[k].x), u.x);
 7131:                   atomicAdd(&(node->utmp[k].y), u.y);
 7132: 
 7133:                }
 7134: 
 7135:             }
 7136:          }
 7137:          else { // For quads
 7138:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7139: 
 7140:          }
 7141: 
 7142:       }
 7143:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7144:       
 7145:    }
 7146: 
 7147: 
 7148:    __global__ void computeNodalHorizontalVelocities2(void) {
 7149:       NODE(node);
 7150: 
 7151:       const int nodeCount = node->tmp.i;
 7152: 
 7153:       if (nodeCount == 0) 
 7154:       {
 7155:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7156:          return;
 7157:       }
 7158: 
 7159:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7160:       
 7161:       const int kb = node->kb;
 7162: 
 7163:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7164:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7165:       
 7166:       
 7167:    }   
 7168: 
 7169:  
