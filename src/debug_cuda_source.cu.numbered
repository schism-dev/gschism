 1070: struct Node {
 1071: 
 1072:    // Geometry information
 1073:    int idx;        // Index of the node
 1074:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1075:    int numNodes;   // Number of nodes neighbors of this node
 1076: 
 1077:    Element **elements; // Array of pointers to the elements that share this node
 1078:    int numElements;    // Number of elements that share this node
 1079: 
 1080:    int numSides;       // Number of sides that are connected to this node
 1081: 
 1082:    Point3 p;
 1083:    Vector3 u2[nvrt];
 1084:    double z[nvrt];
 1085:    double lon, lat;
 1086:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1087:    double depth;
 1088: 
 1089:    int kb;       // Bottom index of the node
 1090: 
 1091:    bool isDry;     // True if the node is dry
 1092: 
 1093:    int iadv;     // Advection flag
 1094: 
 1095:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1096:                           // this is nullptr
 1097: 
 1098:    TempVar tmp; // Temporary variable to store different types of variables
 1099: 
 1100:    // Physical information
 1101:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1102:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1103: 
 1104:    double rho[nvrt];     // Density
 1105:    double dfv[nvrt];     // Vertical viscosity
 1106: 
 1107:    double eta1; // Elevation at nodes at previous timestep
 1108:    double eta2; // Elevation at nodes at current timestep
 1109: 
 1110:    double ETP;  // Earth Tidal Potential
 1111: 
 1112:    double pr;    // Air pressure
 1113:    double grav2; // Gravity 
 1114:    
 1115:    Vector2 dav;  // Depth averaged velocity
 1116: 
 1117:    Vector2 tau; // Wind stress vector
 1118: 
 1119:    // Vegetation parameters
 1120:    double veg_h;
 1121:    double veg_nv;
 1122:    double veg_di;
 1123:    double veg_Cd;
 1124:    double veg_h_unbent;
 1125:    double veg_di_unbent;
 1126:    double veg_nv_unbent;
 1127:    double veg_alpha_vert_mean;
 1128:    double veg_alpha0;
 1129:    double veg_alpha3D[nvrt];
 1130: 
 1131:    // Bottom drag parameters
 1132:    double Cd;       // Bottom drag coefficient
 1133:    double rough;    // Bottom roughness length
 1134:    Vector2 tau_bot; // Bottom stress vector
 1135: 
 1136:    double bdef1; // Bottom deformation at previous timestep
 1137:    double bdef2; // Bottom deformation at current timestep
 1138: 
 1139:    double qel; // RHS
 1140:    double coeffDiag; // Diagonal coefficient of the matrix
 1141:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1142: 
 1143:    double mP; // Search direction for conjugate gradient method
 1144:    double mR; // Residual for conjugate gradient method
 1145:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1146:    double mX; // Solution for conjugate gradient method
 1147: 
 1148:    // Meteorological forcing
 1149:    Vector2 u_air;
 1150:    double p_air;
 1151:    double t_air;
 1152:    double q_air;
 1153:    double wind_angle;  // Wind rotation angle
 1154: 
 1155:    __device__ void setWind(Vector2 &u) {
 1156:    // Sets the wind vector taking into account the wind rotation angle
 1157:    
 1158:       const double dir = atan2(-u.x,-u.y);
 1159:       const double speed = length(u);
 1160: 
 1161:       // Calculate new u and v components with added rotation angle
 1162:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1163:    }
 1164: 
 1165:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1166:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1167: 
 1168:    __device__ double sigmaTransitionDepth(void) const;
 1169: 
 1170:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1171:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1172:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1173: 
 1174:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1175: 
 1176:    __device__ void clearMatrixRow(void) {
 1177:       // Clear the matrix row for this node
 1178:       coeffDiag = 0.0;
 1179:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1180: 
 1181:    }
 1182: 
 1183:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1184:       // Add the value to the sparse matrix for this node
 1185:       
 1186:       if (node == this) {
 1187:          coeffDiag += value;
 1188: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1189:       } else {
 1190:          // Search (linearly)the index of the node in the array of nodes
 1191:          // XXX: This is not efficient, see if we can improve this
 1192:          int i;
 1193:          for (i = 0; i < numNodes; i++) {
 1194:             if (nodes[i] == node) {
 1195:                break;
 1196:             }
 1197:          }
 1198:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1199:          coeffMatrix[i] += value;
 1200:       }
 1201:    }
 1202: 
 1203: #ifdef BACKTRACKING
 1204:    __device__ void updateZCoordData() {
 1205:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1206: 
 1207:       // Check if node is wet
 1208:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1209: 
 1210:       if (idry) return;
 1211: 
 1212:       if constexpr(ivcor == 2) {  // SZ coordinates
 1213:          
 1214:          // Compute bottom level index
 1215:          if (depth <= mesh->h_s) {
 1216:                kb = mesh->nzlevels;
 1217:          } else {
 1218:                kb = -1;
 1219:                for (int i = 0; i < mesh->kz-1; i++) {
 1220:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1221:                      kb = i;
 1222:                      break;
 1223:                   }
 1224:                }
 1225:          }
 1226:       } 
 1227:       else if (ivcor == 1) {  // Localized sigma
 1228:          // Do nothing
 1229:       }
 1230: 
 1231:    }
 1232: #endif   
 1233: 
 1234:    __device__ double compZCoord(int k) const;
 1235: 
 1236:    __device__ void updateKb(void);
 1237: 
 1238: 
 1239: 
 1240: };
