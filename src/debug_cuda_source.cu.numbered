 6520: #ifdef DONTCOMPILE
 6521: __global__ void checkMassConservation(Tracers* sumtr) {
 6522: 
 6523:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 6524: 
 6525:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 6526: 
 6527:    Element *elem = &(mesh->localElemData[i]);
 6528: 
 6529:    // Skip dry elements
 6530:    if (elem->isDry) return;
 6531: 
 6532:    // Local sum array for this thread
 6533:    double localSum[N_TRACERS] = {0.0};
 6534: 
 6535:    // Sum over vertical levels for this element
 6536:    const int kbe = elem->kbe;
 6537:    const double area = elem->area;
 6538: 
 6539:    for (int k = kbe; k < nvrt; k++) {
 6540:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 6541:       
 6542:       // Accumulate tracer mass
 6543:       for (int tr = 0; tr < N_TRACERS; tr++) {
 6544:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 6545:       }
 6546:    }
 6547: 
 6548:    //  This function returns per element sums. A reduction must be done on the host side.
 6549: }
 6550: 
 6551: 
 6552: __global__ void transport(void) {
 6553: 
 6554:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 6555: 
 6556:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 6557: 
 6558:    Element *elem = &(mesh->localElemData[ie]);
 6559: 
 6560:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 6561: 
 6562:                for (int m=0; m<ntr; m++) {
 6563:                   for (int k=kbe(ie); k<nvrt; k++) {
 6564:                      // Calculate each polynomial's weight 
 6565:                      wm=0.d0; sum1=0.d0; 
 6566:                      wm1=0.d0; wm2=0.d0; 
 6567:                      for (int i=0; i<elem->nweno2; i++) {
 6568:                   
 6569:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6570:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6571:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6572:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6573:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6574:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 6575:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 6576:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 6577:                      // -----------------Hu and Shu (1999)'s method----------------
 6578:                      b4=b1+b2+b3
 6579: 
 6580: //Error: add PRODUCTION CPP
 6581: #ifdef DEBUG
 6582:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 6583:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 6584:                     call parallel_abort(errmsg)
 6585:                   }
 6586: #endif
 6587: 
 6588:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 6589:                   // !----test-------------- 
 6590:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 6591:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 6592:                   // !wm(i)=wm1(i)*wm2(i)
 6593:                   // !---------------------- 
 6594:                   sum1=sum1+wm(i)
 6595:                 } // end for i
 6596: 
 6597:                 wm=wm/sum1
 6598: 
 6599:                 for (int j=0; j<elem->i34; j++) {
 6600: 
 6601:                   const Side *side  = elem->sides[j];
 6602:                   const Node *node1 = side->n1;
 6603:                   const Node *node2 = side->n2;
 6604: 
 6605:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 6606:                      trsd=0.d0
 6607:                      for (int kk=0; kk<nquad; kk++) {
 6608:                         for (int i=0; i<elem->nweno2; i++) {
 6609:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 6610:                         } // end for i   
 6611:                      } // end for kk
 6612:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6613:                   } // outward flux
 6614:                } // end for j=1,i34(ie) ! side
 6615:             }
 6616:          }
 6617:               
 6618: 
 6619: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 6620: //             //   calculate each polynomial's weight 
 6621: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 6622: //                 wm=0.d0; sum1=0.d0
 6623: //                 do i=1,nweno1(ie) !for each polynomial
 6624: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6625: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 6626: //                   b1=b1*b1+b2*b2 !smoothness indicator
 6627: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 6628: //                   wm(i)=b2
 6629: //                   sum1=sum1+b2
 6630: //                   !wm(i)=1.d0
 6631: //                   !sum1=sum1+1.d0
 6632: 
 6633: // // Error: PRODUCTION
 6634: // #ifdef DEBUG
 6635: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 6636: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 6637: //                     call parallel_abort(errmsg)
 6638: //                   endif
 6639: // #endif
 6640: 
 6641: //                 enddo !i
 6642: //                 wm=wm/sum1 !final weight
 6643: 
 6644:                 for (int j=0; j<elem->i34; j++) { // side
 6645:                   const Side *side = elem->sides[j];
 6646:                   const Node *node1 = side->n1;
 6647:                   const Node *node2 = side->n2;
 6648: 
 6649:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 6650:                     trsd=0.d0
 6651:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 6652:                       for (int i=0; i<elem->nweno1; i++) {
 6653:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 6654:                       }
 6655:                     enddo //kk
 6656:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 6657:                   } // outward flux
 6658:                 } // end for j=1,i34(ie) ! side
 6659:               } // end for k; ntr 
 6660: 
 6661:             else !simple upwind method
 6662:               do j=1,i34(ie)
 6663:                 jsj=elside(j,ie)
 6664:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 6665:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 6666:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 6667:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 6668:                   endif
 6669:                 enddo  !vertical layers
 6670:               enddo !j=1,i34(ie) ! side
 6671:             endif !order of accuracy
 6672: 
 6673:          //  enddo !ie
 6674: // !$OMP     end do
