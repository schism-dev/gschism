 2399: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2400: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2401: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2402: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2403:    Vector2 grad = {0.0, 0.0};
 2404:    int count = 0;
 2405: 
 2406:    if constexpr(ics == 2) assert(false && "computeHorGradientAtSide: ics = 2 not implemented");
 2407: 
 2408:    // First element
 2409:    if (elems[0] != nullptr && condition(elems[0])) {
 2410:       grad += elems[0]->grad2(field);
 2411:       count++;
 2412:    }
 2413: 
 2414:    // Second element
 2415:    if (elems[1] != nullptr && condition(elems[1])) {
 2416:       grad += elems[1]->grad2(field);
 2417:       count++;
 2418:    }
 2419: 
 2420:    if (count > 0) {
 2421:       grad = grad/count;
 2422:    }
 2423:    
 2424:    return grad;
 2425: }
 2426: 
 2427: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2428: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2429: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2430: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2431: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2432: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2433: 
 2434: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2435: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2436: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2437: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 2438: 
 2439: __inline__ __device__ double  Side::etaMeanBnd(void) const { assert(n1->nodeBnd != nullptr && n2->nodeBnd != nullptr && "etaMeanBnd not assigned"); 
 2440:                                                              assert(n1->nodeBnd->eta_mean >= -98 && n2->nodeBnd->eta_mean >= -98 && "Bad value for etaMeanBnd");
 2441:                                                              // XXXX Should I use something like getBoundaryArrayValueWeight here?
 2442:                                                              return 0.5*(n1->nodeBnd->eta_mean + n2->nodeBnd->eta_mean); }
 2443: 
 2444: 
 2445: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2446: 
 2447: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2448: 
 2449: /**
 2450:  * This method performs backtracking from the side center until a time -dt back in time 
 2451:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2452:  * intermediate point.
 2453:  *
 2454:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2455:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2456:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2457:  * remaining time.
 2458:  * 
 2459:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2460:  * 
 2461:  * @param uuint, vvint, wwint: Velocities at the final point
 2462:  * @param jlev: Level at which the backtracking is performed
 2463:  * @param dt, dtbk: Tracking timesteps
 2464:  * @return: True if the backtracking was successful, false otherwise
 2465:  */
 2466: __inline__ __device__ bool Side::btrack(
 2467:       int jlev,
 2468:       double dt,            // Tracking time
 2469:       double dtbk,          // Tracking timestep
 2470:       Vector3 &u_int        // Velocities at the initial point
 2471: ) const {
 2472: 
 2473:    // Start from side center
 2474:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2475:  
 2476: 
 2477:    double time_rm = dt; // Remaining time
 2478: 
 2479: 
 2480:    // // Initialize outputs XXX
 2481:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2482:    //    sclr[i] = 0.0;
 2483:    // }
 2484: 
 2485: 
 2486:    // Initial velocities
 2487:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2488: 
 2489:    // Find the element that is in the direction opposite to the velocity
 2490:    Element* curElem = findElementTowards(toVector2(u_int));
 2491: 
 2492:    // If it starts at a boundary side, we should start with a velocity parallel to the side.
 2493:    if (curElem == nullptr) {
 2494:       // Make velocity parallel to the side
 2495:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2496:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2497:       curElem = otherElem(curElem);
 2498:       
 2499:    }
 2500: 
 2501: 
 2502: 
 2503:    const int MAX_ITERATIONS = 1000; 
 2504:    Element* nextElem = curElem;
 2505:    int iter = 0;
 2506:    while(true) {
 2507: 
 2508:       // Calculate timestep
 2509:       double dtb = min(dtbk, time_rm);
 2510: 
 2511:       // Next point in the backtracking curve
 2512:       Point3 xt = x0 - dtb*u_int;
 2513: 
 2514: 
 2515:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb);
 2516:       assert(found && "Backtracking failed in btrack");
 2517: 
 2518:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2519:                       // then time_rm needs to be increased by the unused time.
 2520:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2521: 
 2522:       // The current point becomes the next segment's starting point.
 2523:       x0 = xt;
 2524:  
 2525:       curElem = nextElem;
 2526: 
 2527:       iter++;
 2528:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2529:    }
 2530: 
 2531: 
 2532: }
 2533: 
 2534: 
 2535: 
 2536: // /**
 2537: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2538: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2539: 
 2540: //    Inputs:
 2541: //    @param x1, y1: point inside the element
 2542: //    @param x2, y2: other end of the line segment
 2543: 
 2544: //    Outputs:
 2545: //    @param intersectingSide:  side that intersects the line segment
 2546: //    @param nextElement: element that contains the intersection point
 2547: //    @param xIntersect, yIntersect: intersection point  
 2548: 
 2549: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2550: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2551: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2552: 
 2553: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2554: //    (Delta) being zero.
 2555: 
 2556: //    The intersection point happens when:
 2557: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
