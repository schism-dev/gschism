 1776:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1777:       // Compute the different time ramps used in the code 
 1778:       // This function is performed by just one thread
 1779: 
 1780:       rampbc = 1.0;
 1781:       if constexpr(ibc == 0) {
 1782:          if (drampbc > 0.0) {
 1783:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1784:          } else {
 1785:             rampbc = 1.0;
 1786:          }
 1787:       }
 1788: 
 1789:       if (nws != 0) {
 1790:          if (drampwind > 0.0) {
 1791:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1792:          } else {
 1793:             rampwind = 1.0;
 1794:          }
 1795:       }
 1796: 
 1797:       if (drampwafo > 0.0) {
 1798:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1799:       } else {
 1800:          rampwafo = 1.0;
 1801:       }
 1802: 
 1803:       // For source/sinks
 1804:       if (if_source && dramp_ss > 0.0) {
 1805:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1806:       } else {
 1807:          ramp_ss = 1.0;
 1808:       }
 1809: 
 1810:       if (dramp > 0.0) {
 1811:          ramp = tanh(2.0*time/86400.0/dramp);
 1812:       } else {
 1813:          ramp = 1.0;
 1814:       }
 1815: 
 1816: 
 1817:    }
