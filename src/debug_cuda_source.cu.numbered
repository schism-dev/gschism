 7447:          break;
 7448:       case (int)VarCode::len:
 7449:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7450:          *sizeType = sizeof(double);
 7451:          break;
 7452:       case (int)VarCode::kb:
 7453:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7454:          *sizeType = sizeof(int);
 7455:          break;
 7456:       case (int)VarCode::isdry:
 7457:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7458:          *sizeType = sizeof(int);
 7459:          break;            
 7460:       case (int)VarCode::w:
 7461:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7462:          *sizeType = sizeof(double);
 7463:          break;
 7464:       case (int)VarCode::u:
 7465:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7466:          *sizeType = sizeof(Vector2);
 7467:          break;   
 7468:       case (int)VarCode::n1:
 7469:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7470:          *sizeType = sizeof(Node);
 7471:          break;
 7472:       case (int)VarCode::n2:
 7473:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7474:          *sizeType = sizeof(Node);
 7475:          break;                   
 7476:       default:
 7477:          *offset = -1;
 7478:    }
 7479: }
