 7035: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1) {
 7036:    // Get the value of a variable from an element
 7037:    // varName is the name of the variable to get
 7038:    // var is the array to store the value
 7039:    // k is the vertical level index of the variable to get
 7040: 
 7041:    ELEM(elem);
 7042:    
 7043:    int idx = elem->idx;
 7044:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7045: 
 7046:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7047:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7048:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7049:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7050:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7051:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7052:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7053:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7054:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7055:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7056:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7057:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7058:       
 7059:    
 7060: }
 7061: 
 7062: 
 7063: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7064:    // Get the value of a variable from an node
 7065:    // varName is the name of the variable to get
 7066:    // var is the array to store the value
 7067:    // k is the vertical level index of the variable to get
 7068: 
 7069:    NODE(node);
 7070:    
 7071:    int idx = node->idx;
 7072:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7073: 
 7074:    printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7075:    
 7076:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7077:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7078:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7079:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7080:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7081:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7082:       
 7083:    
 7084: }
 7085: 
 7086: 
 7087: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7088:    // Get the value of a variable from an side
 7089:    // varName is the name of the variable to get
 7090:    // var is the array to store the value
 7091:    // k is the vertical level index of the variable to get
 7092:    SIDE(side);
 7093:    
 7094:    int idx = side->idx;
 7095:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7096: 
 7097:    printf("getSideVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7098:    
 7099:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = side->zc[k];
 7100:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = side->center.x;
 7101:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = side->center.y;
 7102:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = side->u2[k].x;
 7103:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = side->u2[k].y;
 7104:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = side->depth();
 7105:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(side->kb);
 7106:    else if (varCode == (int)VarCode::n1 && k == -1)     var[idx] = side->n1->idx;
 7107:    else if (varCode == (int)VarCode::n2 && k == -1)     var[idx] = side->n2->idx;
 7108:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7109: }
