10507: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
10508:    Element *elems = mesh->localElemData;
10509: 
10510:    *addr = elems;
10511:    *sizeElement = sizeof(Element);
10512:    switch (varCode) {
10513:       case (int)VarCode::z:
10514:          *offset = (int)((char*)&elems[0].z - (char*)elems);
10515:          *sizeType = sizeof(double);
10516:          break;
10517:       case (int)VarCode::x:
10518:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
10519:          *sizeType = sizeof(Vector2);
10520:          break;
10521:       case (int)VarCode::gradETP:
10522:          *offset = (int)((char*)&elems[0].gradETP.x - (char*)elems);
10523:          *sizeType = sizeof(Vector2);
10524:          break;
10525:       case (int)VarCode::area:
10526:          *offset = (int)((char*)&elems[0].area - (char*)elems);
10527:          *sizeType = sizeof(double);
10528:          break;
10529:       case (int)VarCode::depth:
10530:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
10531:          *sizeType = sizeof(double);
10532:          break;
10533:       case (int)VarCode::radius:
10534:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
10535:          *sizeType = sizeof(double);
10536:          break;
10537:       case (int)VarCode::ghat:
10538:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
10539:          *sizeType = sizeof(Vector2);
10540:          break;
10541:       case (int)VarCode::kb:
10542:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
10543:          *sizeType = sizeof(int);
10544:          break;
10545:       case (int)VarCode::isdry:
10546:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
10547:          *sizeType = sizeof(int);
10548:          break;            
10549:       case (int)VarCode::w:
10550:          *offset = (int)((char*)&elems[0].w - (char*)elems);
10551:          *sizeType = sizeof(double);
10552:          break;
10553:       case (int)VarCode::FaceIndices:
10554:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
10555:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
10556:          *sizeType = sizeof(Node);
10557:          break;
10558:       default:
10559:          *offset = -1;
10560:    }
10561: }
