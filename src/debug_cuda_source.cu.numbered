 1455:    __device__ Mesh(int partNum,
 1456:                    int npgb, int negb, int nsgb, 
 1457:                    int np, int ne, int ns,
 1458:                    int max_np, int max_ne, int max_ns, int nseg,
 1459:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1460:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1461:                    Node    **localNodeNeighNodesMem,
