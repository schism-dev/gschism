  559: 
  560: // ----------------------------- Frames -----------------------------
  561: 
  562: // Frames are used to transform vectors between different coordinate systems.
  563: // They are templated in such a way that when ics==1, they have (most likely) no overhead.
  564: template<int ICS>
  565: struct Frame {};
  566: 
  567: template<>
  568: struct Frame<1> {
  569:    __forceinline__ __device__ void update(double, double) {}
  570:    __forceinline__ __device__ Vector3 G2L(Vector3 vi) const { return vi; }
  571:    __forceinline__ __device__ Vector3 L2G(Vector3 vi) const { return vi; }
  572:    __forceinline__ __device__ Vector2 projHorVec(Vector2 v, const Frame<1>&) const { return v; }
  573:    __forceinline__ __device__ Vector3 nUp(void)         const { return {0.0, 0.0, 0.0}; }
  574:    __forceinline__ __device__ Vector3 nZonal(void)      const { return {0.0, 0.0, 0.0}; }
  575:    __forceinline__ __device__ Vector3 nMeridional(void) const { return {0.0, 0.0, 0.0}; }
  576: };
  577: 
  578: template<>
  579: struct Frame<2> {
  580:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              - store 2 values, t20=0 implicit
  581:    // Column 1 (North): Normalized oblate ellipsoid vector  - store 3 values
  582:    // Column 2 (Up):    cross(col0, col1)                   - recomputed on demand
  583:     double t00, t10;        // col0 (t20=0 implicit)
  584:     double t01, t11, t21;   // col1
  585: 
  586:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  587: 
  588:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  589:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  590: 
  591:       double sin_lon, cos_lon, sin_lat, cos_lat;
  592:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  593:       sincos(lat, &sin_lat, &cos_lat);
  594: 
  595:       t00 = -sin_lon;
  596:       t10 =  cos_lon;
  597:       t01 = -cos_lon*sin_lat;
  598:       t11 = -sin_lon*sin_lat;
  599:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  600: 
  601:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  602:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  603: 
  604:       const double col1_norm_inv = 1.0/col1_norm;
  605:       t01 = t01*col1_norm_inv;
  606:       t11 = t11*col1_norm_inv;
  607:       t21 = t21*col1_norm_inv;
  608: 
  609:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  610: 
  611: 
  612:    }
  613: 
  614:    __forceinline__ __device__ void print(void) const {
  615:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  616:    }
  617: 
  618:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  619:       // cross(col0, col1), with t20=0 implicitly:
  620:       // |  i       j       k   |
  621:       // | t00     t10      0   |
  622:       // | t01     t11     t21  |
  623:       t02 =  t10*t21;
  624:       t12 = -t00*t21;
  625:       t22 =  t00*t11 - t10*t01;
  626:    }
  627: 
  628: 
  629:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame<2> const &frameout) const {
  630:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  631:    // Inputs:
  632:    //        vec0: vel. in this frame;
  633:    //        frameout: Output frame;
  634:    // Output: 
  635:    //        vel. in new frame  
  636:    //
  637:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  638:    // discarding the z-component of the result to keep only the local horizontal
  639:    // plane of frame 2.
  640:    //
  641:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  642:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  643:    // are orthogonal. This product is computed as dot products between columns of
  644:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  645:    // columns of F2.// 
  646: 
  647:       auto const fo = frameout; // Just an alias for the output frame.
  648:       Vector2 res;
  649: 
  650:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  651:       // of t and fo.t are the same.
  652:       const double d00 = t00*fo.t00 + t10*fo.t10;
  653:       const double d10 = t01*fo.t00 + t11*fo.t10;
  654: 
  655:       const double d01 = t00*fo.t01 + t10*fo.t11;
  656:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  657: 
  658:       res.x = vec0.x * d00 + vec0.y * d10;
  659:       res.y = vec0.x * d01 + vec0.y * d11;
  660: 
  661:       return res;
  662:    }
  663: 
  664:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  665:       Vector3 vo;
  666:       double t02, t12, t22;
  667: 
  668:       // Compute the 3rd column of the frame tensor
  669:       getCol2(t02, t12, t22);
  670: 
  671:       vo.x = vi.x*t00 + vi.y*t10;
  672:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  673:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  674: 
  675:       return vo;
  676:    
  677:    }
  678: 
  679:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  680:       Vector3 vo;
  681:       double t02, t12, t22;
  682: 
  683:    // Compute the 3rd column of the frame tensor
  684:       getCol2(t02, t12, t22);
  685: 
  686:       // F * vi (non-transposed, so we use rows of F)
  687:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  688:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  689:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  690: 
  691:       return vo;
  692:    }
  693: 
  694:    // Unit vectors that define the local frame
  695:    __forceinline__ __device__ Vector3 nUp(void) const {
  696:       // Column 2 = cross(column0, column1)
  697:       return { t10*t21, -t00*t21, t00*t11 - t10*t01 };
  698:    }
  699: 
  700:    __forceinline__ __device__ Vector3 nZonal(void) const {
  701:       // Column 0
  702:       return { t00, t10, 0.0 };
  703:    }
  704: 
  705:    __forceinline__ __device__ Vector3 nMeridional(void) const {
  706:       // Column 1
  707:       return { t01, t11, t21 };
  708:    }
  709: 
  710: };
  711: 
