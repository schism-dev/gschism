 9768: extern "C" __global__ void getSideVar(int varCode, void *res, int k) {
 9769:    SIDE(side);
 9770: 
 9771:    switch (varCode) {
 9772:       case (int)VarCode::outputCoords: {
 9773:          const Point2 coords = side->outputCoords();
 9774:          double *out = (double *)((char *)res + idx_side * 16);
 9775:          out[0] = coords.x;
 9776:          out[1] = coords.y;
 9777:          break;
 9778:       }
 9779:       case (int)VarCode::n1:
 9780:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n1 != nullptr) ? side->n1->idx + 1 : -1);
 9781:          break;
 9782:       case (int)VarCode::n2:
 9783:          *(uintptr_t *)((char *)res + idx_side * 8) = (uintptr_t)((side->n2 != nullptr) ? side->n2->idx + 1 : -1);
 9784:          break;
 9785:       case (int)VarCode::isdry:
 9786:          *(int *)((char *)res + idx_side * 4) = (int)side->isDry;
 9787:          break;
 9788:    }
 9789: }
 9790: 
 9791: 
 9792: extern "C" __global__ void getElementVar(int varCode, void *res, int k) {
 9793:    ELEM(elem);
 9794: 
 9795:    switch (varCode) {
 9796:       case (int)VarCode::outputCoords: {
 9797:          const Point2 coords = elem->outputCoords();
 9798:          double *out = (double *)((char *)res + idx_elem * 16);
 9799:          out[0] = coords.x;
 9800:          out[1] = coords.y;
 9801:          break;
 9802:       }
 9803:       case (int)VarCode::FaceIndices: {
 9804:          uintptr_t *out = (uintptr_t *)((char *)res + idx_elem * 32);
 9805:          for (int j = 0; j < 4; j++)
 9806:             out[j] = (j < elem->i34 && elem->nodes[j]) ? elem->nodes[j]->idx + 1 : -1;
 9807:          break;
 9808:       }
 9809:       case (int)VarCode::isdry:
 9810:          *(int *)((char *)res + idx_elem * 4) = (int)elem->isDry;
 9811:          break;
 9812:       case (int)VarCode::w: {
 9813:          double *out = (double *)((char *)res + idx_elem * nvrt * 8);
 9814:          if (k >= 0)
 9815:             out[0] = elem->w[k];
 9816:          else
 9817:             for (int lev = 0; lev < nvrt; lev++)
 9818:                out[lev] = elem->w[lev];
 9819:          break;
 9820:       }
 9821:    }
 9822: }
 9823: 
 9824: 
