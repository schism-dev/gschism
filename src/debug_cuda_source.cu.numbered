 1951: // Convenience macros for accessing the objects in kernels.
 1952: 
 1953: #define SIDE(side) const int idx_side = threadIdx.x + blockIdx.x * blockDim.x; \
 1954:                    Side *side = &(mesh->localSideData[idx_side]); \
 1955:                    if (idx_side >= mesh->ns) return;
 1956: 
 1957: #define ELEM(elem) const int idx_elem = threadIdx.x + blockIdx.x * blockDim.x; \
 1958:                    Element *elem = &(mesh->localElemData[idx_elem]); \
 1959:                    if (idx_elem >= mesh->ne) return;
 1960: 
 1961: #define NODE(node) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; \
 1962:                    Node *node = &(mesh->localNodeData[idx_node]); \
 1963:                    if (idx_node >= mesh->np) return;
 1964: 
 1965: #define NODE_ALL(node, valid) const int idx_node = threadIdx.x + blockIdx.x * blockDim.x;       \
 1966:                               Node *node = &(mesh->localNodeData[idx_node]); \
 1967:                               const bool valid = (idx_node < mesh->np);                   
 1968: 
 1969: 
 1970: #define NODE_BND(node_bnd) const int idx_node_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1971:                            NodeBoundary *node_bnd = &(mesh->localNodeBoundaryMem[idx_node_bnd]); \
 1972:                            if (idx_node_bnd >= mesh->nbp) return;
 1973: 
 1974: #define SIDE_BND(side_bnd) const int idx_side_bnd = threadIdx.x + blockIdx.x * blockDim.x; \
 1975:                            SideBoundary *side_bnd = &(mesh->localSideBoundaryMem[idx_side_bnd]); \
 1976:                            if (idx_side_bnd >= mesh->nbs) return;  
