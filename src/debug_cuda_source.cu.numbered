 2198:    template<typename T>
 2199:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 2200:       // Get the values of the field at the nodes of the element
 2201:       res[0] = nodes[0]->*field;
 2202:       res[1] = nodes[1]->*field;
 2203:       res[2] = nodes[2]->*field;
 2204:       if (isQuad()) res[3] = nodes[3]->*field;
 2205:       else          res[3] = T();
 2206:    }
 2207: 
 2208:    template<typename T>
 2209:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2210: 
 2211:       assert(level < nvrt && "Level is out of range");
 2212:       // Get the values of the field at the nodes of the element
 2213:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2214:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2215:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2216:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2217:       else          res[3] = T();
 2218:    }    
