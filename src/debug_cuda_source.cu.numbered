 1812:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1813:       // Compute the different time ramps used in the code 
 1814:       // This function is performed by just one thread
 1815: 
 1816:       rampbc = 1.0;
 1817:       if constexpr(ibc == 0) {
 1818:          if (drampbc > 0.0) {
 1819:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1820:          } else {
 1821:             rampbc = 1.0;
 1822:          }
 1823:       }
 1824: 
 1825:       if (nws != 0) {
 1826:          if (drampwind > 0.0) {
 1827:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1828:          } else {
 1829:             rampwind = 1.0;
 1830:          }
 1831:       }
 1832: 
 1833:       if (drampwafo > 0.0) {
 1834:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1835:       } else {
 1836:          rampwafo = 1.0;
 1837:       }
 1838: 
 1839:       // For source/sinks
 1840:       if (if_source && dramp_ss > 0.0) {
 1841:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1842:       } else {
 1843:          ramp_ss = 1.0;
 1844:       }
 1845: 
 1846:       if (dramp > 0.0) {
 1847:          ramp = tanh(2.0*time/86400.0/dramp);
 1848:       } else {
 1849:          ramp = 1.0;
 1850:       }
 1851: 
 1852: 
 1853:    }
