  837:    __device__ Vector2 grad2(double *a) const
  838:    {
  839:       double gx = a[0]*gradPhi[0].x + a[1]*gradPhi[1].x + a[2]*gradPhi[2].x;
  840:       double gy = a[0]*gradPhi[0].y + a[1]*gradPhi[1].y + a[2]*gradPhi[2].y;
  841:       if (isQuad()) {
  842:          gx += a[3]*gradPhi[3].x;
  843:          gy += a[3]*gradPhi[3].y;
  844:       }
  845:       return {gx, gy};
  846:    }
  847: 
  848:    __device__ Vector2 grad2(double Node::* field) const
  849:    {
  850:       double gx = (nodes[0]->*field)*gradPhi[0].x + (nodes[1]->*field)*gradPhi[1].x + (nodes[2]->*field)*gradPhi[2].x;
  851:       double gy = (nodes[0]->*field)*gradPhi[0].y + (nodes[1]->*field)*gradPhi[1].y + (nodes[2]->*field)*gradPhi[2].y;
  852:       if (isQuad()) {
  853:          gx += (nodes[3]->*field)*gradPhi[3].x;
  854:          gy += (nodes[3]->*field)*gradPhi[3].y;
  855:       }
  856:       return {gx, gy};
  857:    }
