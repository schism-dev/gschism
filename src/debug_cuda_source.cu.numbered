 1600:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1601:       // Compute the different time ramps used in the code 
 1602:       // This function is performed by just one thread
 1603: 
 1604:       rampbc = 1.0;
 1605:       if constexpr(ibc == 0) {
 1606:          if (drampbc > 0.0) {
 1607:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1608:          } else {
 1609:             rampbc = 1.0;
 1610:          }
 1611:       }
 1612: 
 1613:       if (nws != 0) {
 1614:          if (drampwind > 0.0) {
 1615:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1616:          } else {
 1617:             rampwind = 1.0;
 1618:          }
 1619:       }
 1620: 
 1621:       if (drampwafo > 0.0) {
 1622:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1623:       } else {
 1624:          rampwafo = 1.0;
 1625:       }
 1626: 
 1627:       // For source/sinks
 1628:       if (if_source && dramp_ss > 0.0) {
 1629:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1630:       } else {
 1631:          ramp_ss = 1.0;
 1632:       }
 1633: 
 1634:       if (dramp > 0.0) {
 1635:          ramp = tanh(2.0*time/86400.0/dramp);
 1636:       } else {
 1637:          ramp = 1.0;
 1638:       }
 1639: 
 1640: 
 1641:    }
