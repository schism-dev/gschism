 7240: __global__ void printMatrix(void) {
 7241:    // Debugging: print the matrix
 7242: 
 7243:    const int size = mesh->np;
 7244:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7245:       const Node *node = mesh->localNodeData + idx_node;
 7246:       printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7247:       for (int j = 0; j < node->numNodes; j++) {
 7248:          Node* nbNode = node->nodes[j];
 7249:          if (node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7250:       }
 7251:       printf("]\n");
 7252: 
 7253:    }
 7254: 
 7255: }
 7256: 
 7257: 
 7258: __global__ void returnMatrix(double *res) {
 7259:    // Debugging: returns the matrix as a CuPy array
 7260: 
 7261:    const int size = mesh->np;
 7262:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7263:       const Node *node = mesh->localNodeData + idx_node;
 7264:       res[idx_node*size + idx_node] = node->coeffDiag;
 7265:       for (int j = 0; j < node->numNodes; j++) {
 7266:          Node* nbNode = node->nodes[j];
 7267:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7268:       }
 7269: 
 7270:    }
 7271:    
 7272: }
