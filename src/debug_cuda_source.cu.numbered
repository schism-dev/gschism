  429: struct Tracers {
  430:     double tracer[N_TRACERS];
  431: };
  432: 
  433: 
  434: 
  435: struct Frame {
  436:    // Column 0 (East):  (-sin_lon, cos_lon, 0)              — store 2 values, t20=0 implicit
  437:    // Column 1 (North): Normalized oblate ellipsoid vector  — store 3 values
  438:    // Column 2 (Up):    cross(col0, col1)                   — recomputed on demand
  439:     double t00, t10;        // col0 (t20=0 implicit)
  440:     double t01, t11, t21;   // col1
  441: 
  442:    __device__ void update(double lat, double lon) { // XXX use lat, lon instead of ar1, ar2?
  443: 
  444:       assert(lat >= -pi/2.0 && lat <= pi/2.0 && "GRID: lat out of range");
  445:       assert(lon >= -pi     && lon <= pi     && "GRID: lon out of range");
  446: 
  447:       double sin_lon, cos_lon, sin_lat, cos_lat;
  448:       sincos(lon, &sin_lon, &cos_lon); // These functions are faster than sin(ar1) and cos(ar1).
  449:       sincos(lat, &sin_lat, &cos_lat);
  450: 
  451:       t00 = -sin_lon;
  452:       t10 =  cos_lon;
  453:       t01 = -cos_lon*sin_lat;
  454:       t11 = -sin_lon*sin_lat;
  455:       t21 = (rearth_pole/rearth_eq)*cos_lat;
  456: // printf("lat = %f, lon = %f, cos_lat = %f, sin_lat = %f, cos_lon = %f, sin_lon = %f\n", lat, lon, cos_lat, sin_lat, cos_lon, sin_lon);
  457: // printf("t00 = %f, t10 = %f, t01 = %f, t11 = %f, t21 = %f\n", t00, t10, t01, t11, t21);
  458: 
  459:       const double col1_norm = sqrt(t01*t01 + t11*t11 + t21*t21);
  460:       assert (col1_norm != 0.0 && "GRID: col1_norm=0");
  461: 
  462:       const double col1_norm_inv = 1.0/col1_norm;
  463:       t01 = t01*col1_norm_inv;
  464:       t11 = t11*col1_norm_inv;
  465:       t21 = t21*col1_norm_inv;
  466: 
  467:       // The 3rd column (col2) is the cross product of the first two and is computed when needed.
  468: 
  469:    }
  470: 
  471:    __forceinline__ __device__ void print(void) const {
  472:       printf("frame = [%.16f, %.16f, %.16f, %.16f, %.16f]\n", t00, t10, t01, t11, t21);
  473:    }
  474: 
  475:    __forceinline__ __device__ void getCol2(double &t02, double &t12, double &t22) const {
  476:       // cross(col0, col1), with t20=0 implicitly:
  477:       // |  i       j       k   |
  478:       // | t00     t10      0   |
  479:       // | t01     t11     t21  |
  480:       t02 =  t10*t21;
  481:       t12 = -t00*t21;
  482:       t22 =  t00*t11 - t10*t01;
  483:    }
  484: 
  485: 
  486:    __forceinline__ __device__ Vector2 projHorVec(Vector2 const &vec0, Frame const &frameout) const {
  487:    // Transforms a horizontal vector from one frame to another and projects it to the new local horizontal plane.
  488:    // Inputs:
  489:    //        vec0: vel. in this frame;
  490:    //        frameout: Output frame;
  491:    // Output: 
  492:    //        vel. in new frame  
  493:    //
  494:    // Projects a horizontal vector from frame 1 (this) to frame 2 (frameout),
  495:    // discarding the z-component of the result to keep only the local horizontal
  496:    // plane of frame 2.
  497:    //
  498:    // Since F1 and F2 are global-to-local rotation matrices, transforming from
  499:    // frame 1 to frame 2 requires F2 * F1^{-1} = F2 * F1^T, as rotation matrices
  500:    // are orthogonal. This product is computed as dot products between columns of
  501:    // F1 and columns of F2, which is equivalent to multiplying rows of F1^T by
  502:    // columns of F2.// 
  503: 
  504:       auto const fo = frameout; // Just an alias for the output frame.
  505:       Vector2 res;
  506: 
  507:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  508:       // of t and fo.t are the same.
  509:       const double d00 = t00*fo.t00 + t10*fo.t10;
  510:       const double d10 = t01*fo.t00 + t11*fo.t10;
  511: 
  512:       const double d01 = t00*fo.t01 + t10*fo.t11;
  513:       const double d11 = t01*fo.t01 + t11*fo.t11 + t21*fo.t21;
  514: 
  515:       res.x = vec0.x * d00 + vec0.y * d10;
  516:       res.y = vec0.x * d01 + vec0.y * d11;
  517: 
  518:       return res;
  519:    }
  520: 
  521:    __forceinline__ __device__ Vector3 G2L(Vector3 const &vi) const {
  522:       Vector3 vo;
  523:       double t02, t12, t22;
  524: 
  525:       // Compute the 3rd column of the frame tensor
  526:       getCol2(t02, t12, t22);
  527: 
  528:       vo.x = vi.x*t00 + vi.y*t10;
  529:       vo.y = vi.x*t01 + vi.y*t11 + vi.z*t21;
  530:       vo.z = vi.x*t02 + vi.y*t12 + vi.z*t22;
  531: 
  532:       return vo;
  533:    
  534:    }
  535: 
  536:    __forceinline__ __device__ Vector3 L2G(Vector3 const &vi) const {
  537:       Vector3 vo;
  538:       double t02, t12, t22;
  539: 
  540:    // Compute the 3rd column of the frame tensor
  541:       getCol2(t02, t12, t22);
  542: 
  543:       // F * vi (non-transposed, so we use rows of F)
  544:       vo.x = vi.x*t00 + vi.y*t01 + vi.z*t02;
  545:       vo.y = vi.x*t10 + vi.y*t11 + vi.z*t12;
  546:       vo.z =            vi.y*t21 + vi.z*t22;  // t20=0 term dropped
  547: 
  548:       return vo;
  549:    }
  550: 
  551: 
  552: 
  553: };
