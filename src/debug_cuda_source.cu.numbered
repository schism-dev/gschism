 1602:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1603:       // Compute the different time ramps used in the code 
 1604:       // This function is performed by just one thread
 1605: 
 1606:       rampbc = 1.0;
 1607:       if constexpr(ibc == 0) {
 1608:          if (drampbc > 0.0) {
 1609:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1610:          } else {
 1611:             rampbc = 1.0;
 1612:          }
 1613:       }
 1614: 
 1615:       if (nws != 0) {
 1616:          if (drampwind > 0.0) {
 1617:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1618:          } else {
 1619:             rampwind = 1.0;
 1620:          }
 1621:       }
 1622: 
 1623:       if (drampwafo > 0.0) {
 1624:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1625:       } else {
 1626:          rampwafo = 1.0;
 1627:       }
 1628: 
 1629:       // For source/sinks
 1630:       if (if_source && dramp_ss > 0.0) {
 1631:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1632:       } else {
 1633:          ramp_ss = 1.0;
 1634:       }
 1635: 
 1636:       if (dramp > 0.0) {
 1637:          ramp = tanh(2.0*time/86400.0/dramp);
 1638:       } else {
 1639:          ramp = 1.0;
 1640:       }
 1641: 
 1642: 
 1643:    }
