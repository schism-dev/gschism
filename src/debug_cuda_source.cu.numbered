 5757:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5758: 
 5759:       SIDE(side);
 5760: 
 5761:       side->U = {0.0, 0.0}; 
 5762:          
 5763:       if(side->isDry) return;
 5764: 
 5765:       // Vertically integrated velocity U
 5766:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5767:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5768:          side->U += side->Dz(k + 1)*uc;  
 5769:       }
 5770: 
 5771:    }
