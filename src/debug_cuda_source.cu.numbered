 1591: __device__ void lock(int *mutex) {
 1592:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 1593: }
 1594: 
 1595: __device__ void unlock(int *mutex) {
 1596:     atomicExch(mutex, 0);
