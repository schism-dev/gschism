 3477: 
 3478: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3479:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3480:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3481: 
 3482: 
 3483:    NODE(node1);
 3484: 
 3485:  
 3486: // Check bounds: ensure coeffMatrix is within allocated memory XXXX REMOVE
 3487: const size_t max_elements = 62903880;
 3488: const size_t offset = node1->coeffMatrix - mesh->coeffMatrixMem;
 3489: 
 3490: if (offset < 0 || offset >= max_elements) {
 3491: 
 3492:    printf("Offset is out of bounds: %llu, max_elements = %llu\n", 
 3493:       (unsigned long long)offset, (unsigned long long)max_elements);
 3494:    return;  // Out of bounds, skip
 3495: }
 3496: 
 3497: // Check if we have enough space for numNodes elements
 3498: if (offset + node1->numNodes > max_elements) {
 3499:    printf("Not enough space for numNodes elements: %llu, max_elements = %llu\n", 
 3500:       (unsigned long long)(offset + node1->numNodes), (unsigned long long)max_elements);
 3501:    return;  // Not enough space, skip
 3502: }
 3503: 
 3504:    node1->clearMatrixRow();
 3505:    node1->qel = 0.0;
 3506: 
 3507:    // THIS IS FOR STRUCTURES XXX
 3508:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3509: 
 3510:    
 3511:    for (int j=0; j<node1->numElements; j++) {
 3512:       // For each element connected to the node...
 3513: 
 3514:       Element *elem = node1->elements[j];
 3515: 
 3516: 
 3517:       // Compute the average gravity
 3518:       const double grav3 = elem->mean(&Node::grav2);
 3519: 
 3520:       // Look at the documentation for the description of the terms in the following integrals
 3521: 
 3522:       // Integral I_1 
 3523:       // \bar{\breve{H}} 
 3524:       const double hhatb = elem->mean(&Side::hhat);        
 3525: 
 3526:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3527: 
 3528:       const int id1 = elem->nodeLocalIdx(node1); 
 3529:       const double area = elem->area;
 3530: 
 3531:       if (elem->isTri()) {
 3532: 
 3533:          // To clarify the notation in this section: 
 3534:          //   i stands for the node under consideration (node1)
 3535:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3536:          const int id2 = elem->nxq(1 + id1);
 3537:          const int id3 = elem->nxq(2 + id1);
 3538:          Node *node2 = elem->nodes[id2];
 3539:          Node *node3 = elem->nodes[id3];
 3540: 
 3541:          const Point2 x1 = node1->p;
 3542:          const Point2 x2 = node2->p;
 3543:          const Point2 x3 = node3->p;
 3544: 
 3545:          // integral of phi_i*phi_j
 3546:          const double ipp_ii = (1.0/6.0 )*area;
 3547:          const double ipp_ij = (1.0/12.0)*area;
 3548:          const double ipp_ik = (1.0/12.0)*area;
 3549: 
 3550:          // integral of [(grad phi_i) * (grad phi_j)]
 3551:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3552:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3553:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3554: 
 3555:          // Computes the different components of integral I_1 of each node with respect to node i.
 3556:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3557:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3558:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3559: 
 3560:          node1->addToSparseMatrix(node1, I1_ii);
 3561:          node1->addToSparseMatrix(node2, I1_ij); 
 3562:          node1->addToSparseMatrix(node3, I1_ik);
 3563: 
 3564:       }
 3565:       else { // Quad
 3566:          // XXX IMPLEMENT THIS
 3567:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3568: 
 3569:          // To clarify the notation in this section: 
 3570:          //   i stands for the node under consideration (node1)
 3571:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3572:          const int id2 = elem->nxq(1 + id1);
 3573:          const int id3 = elem->nxq(2 + id1);
 3574:          const int id4 = elem->nxq(3 + id1);
 3575:          Node *node2 = elem->nodes[id2];
 3576:          Node *node3 = elem->nodes[id3];
 3577:          Node *node4 = elem->nodes[id4];         
 3578: 
 3579:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3580:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3581:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3582:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3583:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3584: 
 3585:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3586:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3587:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3588:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3589:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3590: 
 3591:          // Computes the different components of integral I_1 of each node with respect to node i.
 3592:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3593:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3594:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3595:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3596: 
 3597:          node1->addToSparseMatrix(node1, I1_ii);
 3598:          node1->addToSparseMatrix(node2, I1_ij); 
 3599:          node1->addToSparseMatrix(node3, I1_ik);
 3600:          node1->addToSparseMatrix(node4, I1_il);
 3601:   
 3602: 
 3603: 
 3604:       
 3605:       } 
 3606: 
 3607:  
 3608:       // Integral I_4
 3609:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3610:       // Where
 3611:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3612: 
 3613:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3614:       // of U over the element.
 3615:       Vector2 Umean = {0.0, 0.0};
 3616:       for (int m=0; m<elem->i34; m++) {      
 3617:          const Side *side = elem->sides[m];
 3618: 
 3619:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3620:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3621:       }
 3622:       Umean = Umean/elem->i34;
 3623: 
 3624:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3625: 
 3626:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3627:       const double I_4_1 = dot(gradPhi_1, Umean);
 3628: 
 3629:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3630:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3631:      
 3632:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3633: 
 3634:       // Additional terms 
 3635:       double vnorm = 0.0;
 3636:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3637:          Vector3 ubed;
 3638:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3639: 
 3640:          Vector3 gradP = {0.0, 0.0, 1.0};
 3641:          for (int m=0; m < elem->i34; m++) {
 3642:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3643:            gradP += toVector3(gradP_2D, 0.0);
 3644:          }   
 3645:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3646:       } // imm==2
 3647: 
 3648:       if (elem->isTri()) {
 3649:          for (int l=0; l<3; l++) {
 3650:             double fac;
 3651: 
 3652:             Node *node = elem->nodes[l];
 3653: 
 3654:             fac = (node == node1) ? 2.0 : 1.0;
 3655:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3656:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3657:            
 3658:          }
 3659: 
 3660: 
 3661:          if (!elem->isDry) {
 3662:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3663: 
 3664:           node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3665: 
 3666:          }
 3667: 
 3668:       } // isTri
 3669:       else { // isQuad
 3670:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3671:          // for (int l=0; l<4; l++) {
 3672:          //   const Node *node = elem->nodes[l];
 3673: 
 3674:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3675:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3676: 
 3677:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3678:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3679:          // }
 3680: 
 3681:       } // isQuad
 3682: 
 3683: 
 3684:      node1->qel += (dt/elem->i34)*elem->vsource;
 3685:       
 3686: 
 3687:    } // for all elements connected to the node
 3688:    
 3689: 
 3690:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3691:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3692:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3693:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3694:       // If it is an open boundary node...
 3695: 
 3696:       // At least one open bnd side, maybe two
 3697:       for (int l=0; l<2; l++) { 
 3698: 
 3699:          // Gets each of the sides sharing the node. 
 3700:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3701: 
 3702:          // if (sideBnd == nullptr) continue; // Skip if no boundary side
 3703:          
 3704: 
 3705:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3706:          if (sideBnd != nullptr) {
 3707:             // If the side is on a boundary...
 3708: 
 3709:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3710: 
 3711:             // Get the boundary segment
 3712:             const BoundarySegment *sideSegment = sideBnd->segment;
 3713:             const Side *side = sideBnd->side;
 3714: 
 3715:             // Integral I_3
 3716:             if (sideSegment->ifltype != 0) {
 3717:             // Natural or Flather b.c.
 3718: 
 3719:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3720:                // especially for Flather b.c.
 3721:                double ri3 = 0.0;
 3722:                if (!side->isDry) {
 3723:                   // If the side is not dry
 3724:                   
 3725:                   // Computes the side flux of (uth, vth)
 3726:                   double Vn = 0.0;
 3727:                   for (int k = side->kb; k<nvrt-1; k++) {
 3728:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3729:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3730: 
 3731:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3732:                   }
 3733: 
 3734:                   ri3 = 0.5*side->len*Vn;
 3735:                }
 3736: 
 3737:                if (sideSegment->ifltype == -1) { // Flather 1
 3738: 
 3739:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3740:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3741: 
 3742:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3743:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3744:                   
 3745:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3746:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3747: 
 3748:                } 
 3749:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3750:                   // Reset ri3
 3751:                   ri3 = 0.0;
 3752: 
 3753:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3754: 
 3755:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3756: 
 3757:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3758:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3759: 
 3760:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3761:                   node1->addToSparseMatrix(node1, con0*2.0);
 3762:                   node1->addToSparseMatrix(node2, con0);
 3763: 
 3764:                } // if Flather or Discharge
 3765: 
 3766: // printf("node1 = %p, thetai = %f, dt = %f, ri3 = %f\n", node1, thetai, dt, ri3);
 3767:                node1->qel -= thetai*dt*ri3;
 3768: 
 3769: 
 3770:             } // I_3
 3771:           
 3772: 
 3773:             // Integral I_5
 3774:             if(!side->isDry) {
 3775: 
 3776:                const double Unbar = dot(side->U, side->n);
 3777:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3778: 
 3779:             } // I_5
 3780: 
 3781:          } // if is boundary side
 3782: 
 3783:       } // for l
 3784: 
 3785:    } // if isbnd
 3786: 
 3787: 
 3788: }
 3789: 
 3790: 
 3791: 
 3792: extern "C" {
 3793:    __global__ void setupCGSolvers(double* diag_d, double* data_d, double* b_d, 
 3794:                                   float*  diag_f, float*  data_f, float*  b_f, 
 3795:                                   int* indices, int* indptr) {
 3796: 
 3797:       NODE(node);
 3798:       
 3799:       const int idx = node->idx;
 3800:       
 3801:       // Computes the index in the nzz array      
 3802:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3803: 
 3804: 
 3805:       indptr[idx] = nzzIdx;
 3806:       indices[nzzIdx] = idx;
 3807: 
 3808:       data_d[nzzIdx]    = node->coeffDiag;
 3809:       data_f[nzzIdx]    = (float)node->coeffDiag;
 3810: 
 3811:       diag_d[idx] = 1.0/node->coeffDiag;
 3812:       diag_f[idx] = (float)(1.0/node->coeffDiag);
 3813: 
 3814:       b_d[idx] = node->qel;
 3815:       b_f[idx] = (float)node->qel;
 3816: 
 3817:       for (int k = 0; k < node->numNodes; ++k) {
 3818:          const Node* nb = node->nodes[k];
 3819: 
 3820:          const int j = nb->idx;
 3821: 
 3822:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3823:          data_f[nzzIdx + k + 1]    = (float)node->coeffMatrix[k];
 3824: 
 3825:          indices[nzzIdx + k + 1] = j;
 3826:       }
 3827: 
 3828: 
 3829:    }
 3830: }
 3831: 
