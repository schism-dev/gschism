 1889:    template<typename T>
 1890:    __device__ __forceinline__ void Element::getNodalValues(T Node::* field, T res[4]) const {
 1891:       // Get the values of the field at the nodes of the element
 1892:       res[0] = nodes[0]->*field;
 1893:       res[1] = nodes[1]->*field;
 1894:       res[2] = nodes[2]->*field;
 1895:       if (isQuad()) res[3] = nodes[3]->*field;
 1896:       else          res[3] = T();
 1897:    }
 1898: 
 1899:    template<typename T>
 1900:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 1901:       // Get the values of the field at the nodes of the element
 1902:       res[0] = (nodes[0]->*field)[level];
 1903:       res[1] = (nodes[1]->*field)[level];
 1904:       res[2] = (nodes[2]->*field)[level];
 1905:       if (isQuad()) res[3] = (nodes[3]->*field)[level];
 1906:       else          res[3] = T();
 1907:    }    
 1908: 
 1909:    template<typename T>
 1910:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::*func)(int) const, T res[4]) const {
 1911:       // Get the values of the func at the nodes of the element
 1912:       res[0] = (nodes[0]->*func)(level);
 1913:       res[1] = (nodes[1]->*func)(level);
 1914:       res[2] = (nodes[2]->*func)(level);
 1915:       if (isQuad()) res[3] = (nodes[3]->*func)(level);
 1916:       else          res[3] = T();  // This is 0.0 or a zero vector
 1917: 
 1918:    }      
