 4813:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4814:       NODE(node);
 4815: 
 4816:       const int idx = node->idx;
 4817:       Vector2 wind = {xWind[idx], yWind[idx]};
 4818: 
 4819:       if constexpr(nws != 0 && iwindoff != 0) {
 4820:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4821:       }
 4822: 
 4823:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4824:       node->setWind(wind);
 4825: 
 4826:       node->pr = pressAir[idx];
 4827:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4828: 
 4829:    }
 4830: 
 4831:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 4832: 
 4833:       NODE_BND(nodeBnd);
 4834: 
 4835:       Node *node = nodeBnd->node;
 4836: 
 4837:       node->ETP = 0.0;
 4838: 
 4839:       for (int j=0; j<ntip; j++) {
 4840: 
 4841:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 4842:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 4843:    
 4844:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 4845: 
 4846:          if constexpr(iloadtide==1) { // loading tide
 4847:             assert(false && "Loading tide not implemented");
 4848:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4849:          }
 4850:          
 4851:       }
 4852:       
 4853:    }
 4854: 
 4855:    __global__ void getBoundaryConditions(double time) {
 4856:       // Get boundary conditions
 4857:       // XXX IMPLEMENT THIS
 4858:       // assert(true && "getBoundaryConditions not implemented");
 4859: 
 4860: 
 4861:       NODE_BND(nodeBnd);
 4862: 
 4863:       assert(nfltype <= 0 && nettype <= 0 && "getBoundaryConditions: Not implemented");
 4864:       return;
 4865: 
 4866:       const Node *node = nodeBnd->node;
 4867: 
 4868:     
 4869: 
