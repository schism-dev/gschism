 2728: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2729: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2730: 
 2731: //       if (delta != 0.0) {
 2732: //          // Solves the two linear equations for tt1 and tt2
 2733: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
