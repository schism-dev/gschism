 2310: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2311: // return;   
 2312:    // Lock the mutex
 2313:    lock(&debugPlotMutex);
 2314:  
 2315:    bool ok = true;
 2316:    if (debugPlotIdx == nullptr) ok = false;
 2317:    if (*debugPlotIdx >= 1000000) ok = false;
 2318:    if (ok) {
 2319:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2320:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2321:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2322:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2323:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2324:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2325:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2326:       (*debugPlotIdx)++;
 2327:    }
 2328: 
 2329:    __threadfence();               // ensure all above writes are visible
 2330:    // Unlock the mutex
 2331:    unlock(&debugPlotMutex);
 2332: 
 2333: }
