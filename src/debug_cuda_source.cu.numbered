 7636: 
 7637: __global__ void computeMatrixProductAndDotProducts() {
 7638:    // Computes A*p, r'Mr and p'Ap
 7639: 
 7640:    // 1) shared buffer: first half for rMr, second for pAp
 7641:    __shared__ double sdata[2*BLOCK_SIZE];
 7642:    double* s_rMr = sdata;
 7643:    double* s_pAp = sdata + BLOCK_SIZE;
 7644: 
 7645:    const int tid = threadIdx.x;
 7646: 
 7647:    double l_pAp = 0.0;
 7648: 
 7649:    s_rMr[tid] = 0.0;
 7650:    s_pAp[tid] = 0.0;
 7651: 
 7652:    // 2) get your node pointer
 7653:    // NODE(node);   
 7654:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7655:    Node *node = &(mesh->localNodeData[idx_node]); 
 7656:       if (idx_node < mesh->np) {
 7657: 
 7658:       const double diag = node->coeffDiag;
 7659:       const double r    = node->mR;
 7660:       const double p    = node->mP;  
 7661: 
 7662:       // apply preconditioner on the fly:
 7663:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7664: 
 7665:       // 4) compute Ap = A.p
 7666:       double Ap = node->coeffDiag * node->mP;
 7667:       for (int j = 0; j < node->numNodes; ++j) {
 7668:          const Node *nbNode = node->nodes[j];
 7669:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7670: 
 7671:       }
 7672: 
 7673:       node->mAp = Ap;
 7674:       
 7675: 
 7676:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7677:       // const double l_rMr = r*Mr;  // r'Mr
 7678:       l_pAp = p*Ap;  // p'Ap
 7679: 
 7680: 
 7681:    }
 7682: 
 7683:    // 6) write into shared mem
 7684:    // s_rMr[tid] = l_rMr;
 7685:    s_pAp[tid] = l_pAp;
 7686: 
 7687:    __syncthreads();
 7688: 
 7689:    // 7) block-wide tree reduction
 7690:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7691:       if (tid < stride)  {
 7692:          s_pAp[tid] += s_pAp[tid + stride];
 7693:       }
 7694:       __syncthreads();
 7695:    }
 7696: 
 7697:    // 8) thread 0 atomically accumulates into the globals
 7698:    // XXX: This is slower than it needs to be, but it is simple and works
 7699:    if (tid == 0) {
 7700:       atomicAdd(pAp, s_pAp[0]);
 7701:    }
 7702: 
 7703: 
 7704: }
 7705: 
 7706: 
 7707: __global__ void updateSolutionAndDotProducts(void) {
 7708:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7709: 
 7710:    const int tid = threadIdx.x;
 7711: 
 7712:    s_rMr[tid] = 0.0;
 7713: 
 7714:    // get node & bounds-check:
 7715:    NODE(node);
 7716: 
 7717:    
 7718:    // Compute alpha
 7719:    const double alpha = (*rMr_old)/(*pAp);
 7720: 
 7721:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7722: 
 7723: 
 7724:    // load scalars
 7725:    const double diag = node->coeffDiag;
 7726:    const double p    = node->mP;
 7727:    const double Ap   = node->mAp;
 7728:    const double x    = node->mX;
 7729:    const double r    = node->mR;
 7730:    
 7731:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7732: 
 7733:    // 1) update solution & residual
 7734:    const double x_new = x + alpha*p;
 7735:    const double r_new = r - alpha*Ap;
 7736:    node->mX = x_new;
 7737:    node->mR = r_new;
 7738: 
 7739:    // 2) apply Jacobi preconditioner on the fly
 7740:    const double Mr_new = r_new/diag;
 7741: 
 7742: 
 7743:    // 3) local contributions for the two dot-products
 7744:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7745: 
 7746:    // 4) write into shared-mem
 7747:    s_rMr[tid] = l_rMr;
 7748: 
 7749:    __syncthreads();
 7750: 
 7751: 
 7752:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7753:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7754:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7755:       __syncthreads();
 7756:    }
 7757: 
 7758:    // 6) thread 0 atomically folds into the global accumulators
 7759:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7760: 
 7761: 
 7762: }
 7763: 
 7764: 
 7765: __global__ void updateSearchDirection() {
 7766: 
 7767:     NODE(node);
 7768: 
 7769:     // recompute z on-the-fly
 7770:     const double z = node->mR / node->coeffDiag;
 7771:     const double p = node->mP;
 7772: 
 7773:     const double beta = (*rMr_new)/(*rMr_old);
 7774: 
 7775: 
 7776:     // p =z + beta*p
 7777:     node->mP = z + beta*p;
 7778: 
 7779: }
 7780: 
 7781: __global__ void initializeScalars(double *scalars) {
 7782: 
 7783:    // These point to a cupy array in the host code
 7784:    rMr_old = scalars + 0;
 7785:    rMr_new = scalars + 1;
 7786:    pAp     = scalars + 2;
 7787: }
 7788: 
 7789: __global__ void initializePreconditionedResidual(void) {
 7790: 
 7791:     __shared__ double s_rMr[BLOCK_SIZE];  
 7792: 
 7793:     s_rMr[threadIdx.x] = 0.0;
 7794: 
 7795:     NODE_ALL(node, valid);
 7796:     const int tid = threadIdx.x;
 7797:     // For the first iteration:
 7798:     // 1. Initial solution x = 0 (already set)
 7799:     // 2. Initial residual r = b (stored in qel)
 7800:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7801: 
 7802: // XXX we should use the guess solution here    
 7803: 
 7804:     double l_rMr = 0.0;
 7805:     if (valid) {
 7806:       // Set initial residual r = b (from qel)
 7807:       node->mR = node->qel;
 7808: 
 7809:       // Compute z = M^-1 * r (preconditioned residual)
 7810:       const double z = node->mR / node->coeffDiag;
 7811: 
 7812:       // Set initial search direction p = z
 7813:       node->mP = z;
 7814: 
 7815:       // Initialize other variables needed for CG
 7816:       node->mX = 0.0;  // Initial solution
 7817:       node->mAp = 0.0; // Will be computed in first iteration
 7818: 
 7819: 
 7820:       // Computes the first r'Mr (reduction)
 7821:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7822:     }
 7823:     // 4) write into shared-mem
 7824:     s_rMr[tid] = l_rMr;
 7825: 
 7826:     __syncthreads();
 7827: 
 7828: 
 7829:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7830:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7831:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7832:         __syncthreads();
 7833:     }
 7834: 
 7835:     // 6) thread 0 atomically folds into the global accumulators
 7836:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7837: 
 7838:     *rMr_old = 0.0;
 7839:     *pAp = 0.0;
 7840: }
 7841: 
 7842: 
 7843: 
 7844: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7845:    Element *elems = mesh->localElemData;
 7846: 
 7847:    *addr = elems;
 7848:    *sizeElement = sizeof(Element);
 7849:    switch (varCode) {
 7850:       case (int)VarCode::z:
 7851:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7852:          *sizeType = sizeof(double);
 7853:          break;
 7854:       case (int)VarCode::x:
 7855:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7856:          *sizeType = sizeof(Vector2);
 7857:          break;
 7858:       case (int)VarCode::area:
 7859:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7860:          *sizeType = sizeof(double);
 7861:          break;
 7862:       case (int)VarCode::depth:
 7863:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7864:          *sizeType = sizeof(double);
 7865:          break;
 7866:       case (int)VarCode::radius:
 7867:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7868:          *sizeType = sizeof(double);
 7869:          break;
 7870:       case (int)VarCode::lonlat:
 7871:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7872:          *sizeType = sizeof(double);
 7873:          break;
 7874:       case (int)VarCode::ghat:
 7875:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7876:          *sizeType = sizeof(Vector2);
 7877:          break;
 7878:       case (int)VarCode::kb:
 7879:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7880:          *sizeType = sizeof(int);
 7881:          break;
 7882:       case (int)VarCode::isdry:
 7883:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7884:          *sizeType = sizeof(int);
 7885:          break;            
 7886:       case (int)VarCode::w:
 7887:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7888:          *sizeType = sizeof(double);
 7889:          break;
 7890:       case (int)VarCode::FaceIndices:
 7891:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7892:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7893:          *sizeType = sizeof(Node);
 7894:          break;
 7895:       default:
 7896:          *offset = -1;
 7897:    }
 7898: }
