  316: // ------------------------------------------------------------------------------------------------
  317: 
  318: 
  319: __forceinline__ __device__ double signedArea(double x1, double x2, double x3, double y1, double y2, double y3) {
  320:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  321:   return 0.5*((x1-x3)*(y2-y3) - (x2-x3)*(y1-y3));
  322: }
  323: 
  324: __forceinline__ __device__ double signedArea(Point2 p1, Point2 p2, Point2 p3) {
  325:   // Compute signed area formed by pts 1,2,3 (positive counter-clockwise)
  326:   return 0.5*((p1.x-p3.x)*(p2.y-p3.y) - (p2.x-p3.x)*(p1.y-p3.y));
  327: }
  328: 
  329: 
  330: __forceinline__ __device__ void crossProduct(double x1, double y1, double z1, double x2, double y2, double z2, double &x3, double &y3, double &z3) {
  331:    x3 = y1*z2 - y2*z1;
  332:    y3 = x2*z1 - x1*z2;
  333:    z3 = x1*y2 - x2*y1;
  334: }
  335: 
  336: 
  337: __forceinline__ __device__ void computeLonLat(Point3 const &p, double &rlon, double &rlat) {
  338: // Given a 3D global point (may not be on surface of earth), find its longitude and latitude in radians
  339: 
  340:    const double radius2 = dot(p, p);
  341:    assert(radius2 != 0.0     && "computeLonLat: radius = 0");
  342:    assert(p.z*p.z <= radius2 && "computeLonLat: p.z <= radius");
  343: 
  344:    rlon = atan2(p.y, p.x); // (-pi,pi]
  345: 
  346:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  347:       rlat = asin(p.z/sqrt(radius2));
  348:    } else {
  349:       rlat = asin(p.z/rearth_pole);
  350:    }
  351:   
  352: }
  353: 
  354: __inline__ __device__ void Error(const char* msg) {
  355:    printf("Error: %s\n", msg);
  356:    assert(false);
  357: }
