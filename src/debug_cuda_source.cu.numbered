 2088: __device__ __inline__ double min3(double a, double b, double c) {
 2089:    return min(a, min(b, c));
 2090: }
 2091: 
 2092: __device__ __inline__ double max3(double a, double b, double c) {
 2093:    return max(a, max(b, c));
 2094: }
 2095: 
 2096: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2097:    return min(a, min(b, min(c, d)));
 2098: }
