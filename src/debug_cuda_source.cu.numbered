 7165: __global__ void getStructSizes(int* sizes)  {
 7166:    // Get the size of each struct. This is used to allocate memory for the structs in the host code.
 7167:       sizes[0] = (int)sizeof(Node);
 7168:       sizes[1] = (int)sizeof(Element);
 7169:       sizes[2] = (int)sizeof(Side);
 7170:       sizes[3] = (int)sizeof(NodeBoundary);
 7171:       sizes[4] = (int)sizeof(SideBoundary);
 7172:       sizes[5] = (int)sizeof(BoundarySegment);
 7173: }
