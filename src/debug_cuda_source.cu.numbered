 2462: // /**
 2463: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2464: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2465: 
 2466: //    Inputs:
 2467: //    @param x1, y1: point inside the element
 2468: //    @param x2, y2: other end of the line segment
 2469: 
 2470: //    Outputs:
 2471: //    @param intersectingSide:  side that intersects the line segment
 2472: //    @param nextElement: element that contains the intersection point
 2473: //    @param xIntersect, yIntersect: intersection point  
 2474: 
 2475: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2476: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2477: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2478: 
 2479: //    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 2480: //    (Delta) being zero.
 2481: 
 2482: //    The intersection point happens when:
 2483: //    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 2484: //    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 2485:    
 2486: //    Assumption: the 4 points (including those of the side segment) are different.
 2487: //    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 2488: //    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 2489: //    If true, (xIntersect,yIntersect) is the intersection.				
 2490: //    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 2491: // **/
 2492: // __inline__ __device__ bool Element::findPathIntersection(double x1, double y1, double x2, double y2, 
 2493: //                                                          Side& intersectingSide, Element& nextElement,
 2494: //                                                          double& xIntersect, double& yIntersect) {
 2495: //    for (int i = 0; i < i34; i++) {
 2496: //       const double x3 = nodes[i]->x;
 2497: //       const double y3 = nodes[i]->y;
 2498: //       const double x4 = nodes[nxq(i+1)]->x;
 2499: //       const double y4 = nodes[nxq(i+1)]->y;
 2500: 
 2501: //       const Side& side = sides[i];
 2502: 
 2503: //       xIntersect=-1.e25;
 2504: //       yIntersect=-1.e25;
 2505: 
 2506: //       const double delta  = (x2-x1)*(y3-y4)-(y2-y1)*(x3-x4);
 2507: //       const double delta1 = (x3-x1)*(y3-y4)-(y3-y1)*(x3-x4);
 2508: //       const double delta2 = (x2-x1)*(y3-y1)-(y2-y1)*(x3-x1); 
 2509: 
 2510: //       if (delta != 0.0) {
 2511: //          // Solves the two linear equations for tt1 and tt2
 2512: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 2513: //          const double tt2 = delta2/delta;
 2514: 
 2515: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 2516: //          // Similarly, we use tt2 to compute the intersection point.
 2517: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 2518: //             xIntersect = x3 + (x4 - x3)*tt2;
 2519: //             yIntersect = y3 + (y4 - y3)*tt2;
 2520: 
 2521: //             intersectingSide = side;
 2522: //             nextElement = nghbElems[i];
 2523: 
 2524: //             return true;
 2525: //          }
 2526:       
 2527: //       }
 2528: //       else {
 2529: //          // The two segments are parallel
 2530: //          return false;
 2531: //       }
 2532: 
 2533: //    }
 2534: 
 2535: //    return false;
 2536: 
 2537: // }
 2538: 
 2539: 
 2540: 
 2541: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 2542: 
 2543: 
 2544: __device__ void Node::updateKb(void) {
 2545: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2546: 
 2547:    if constexpr(ivcor == 1) return;
 2548: 
 2549: 
 2550:    // Check if node is wet
 2551:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2552: 
 2553:    if (isDry) return;
 2554: 
 2555:    if constexpr(ivcor == 2) {  // SZ coordinates
 2556:       
 2557:       // Compute bottom level index
 2558:       if (depth <= mesh->h_s) {
 2559:          kb = mesh->kz - 1;
 2560:       } else {
 2561:          kb = -1;
 2562:          int L = 0;
 2563:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2564:          
 2565:          while (L <= R) {
 2566:             int M = (R + L) / 2;
 2567: 
 2568:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2569:             
 2570:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2571:                R = M;
 2572:             } else {
 2573:                L = M;
 2574:             }
 2575: 
 2576:             if (R - L == 1) {
 2577:                kb = L;
 2578:                break;
 2579:             }
 2580:          }
 2581:       }
 2582:    } 
 2583: }
 2584: 
 2585: 
 2586: __device__ __inline__ void Node::updateZCoordData(void) {
 2587: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2588: 
 2589:    if (isDry2()) return;
 2590: 
 2591:    if constexpr(ivcor == 2) {  // SZ coordinates
 2592:       
 2593:       // Compute bottom level index
 2594:       if (depth <= mesh->h_s) {
 2595:             kb = mesh->kz;
 2596:       } else {
 2597:          kb = -1;
 2598:          for (int i = 0; i < mesh->kz; i++) {
 2599:             // XXX Use binary search
 2600:             if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 2601:                kb = i;
 2602:                break;
 2603:             }
 2604:          }
 2605:       }
 2606:    } 
 2607:    else if (ivcor == 1) {  // Localized sigma
 2608:       // Do nothing
 2609:    }
 2610: 
 2611: }
 2612: 
 2613: __device__ double Node::compZCoord(int k) const {
 2614:    // Computes the z coordinate at level k.
 2615:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 2616:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 2617:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 2618:    // used 
 2619:    
 2620:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 2621: 
 2622:   
 2623:    assert(htot2() > h0 && "ZCOOR: invalid depth\n");
 2624: 
 2625:    if constexpr(ivcor == 2) {
 2626: 
 2627:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 2628:       const int kz = mesh->kz;
 2629:       const double h_c = mesh->h_c;
 2630:       const double theta_f = mesh->theta_f;
 2631:       const double sinh_theta_f = mesh->sinh_theta_f;
 2632: 
 2633:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 2634:       // The FORTAN code computes it every time this function is called, but it should be done only 
 2635:       // once per time step/node.
 2636:       // CHECK: updateZCoordData
 2637: 
 2638:       if      (k == nvrt-1)      return eta2; 
 2639:       else if (k == kz)          return -hmod2;
 2640:       else if (k == kb)          return -depth;
 2641:       else if (k < kz && k >= 0) return mesh->ztot[k];
 2642:       else if (k > kz) {
 2643:          const int ksig = k - kz + 1;
 2644: 
 2645:          if (hmod2 <= h_c) {
 2646: printf("mesh->sigma[ksig] * (hmod2 + eta2) + eta2 = %e\n", mesh->sigma[ksig] * (hmod2 + eta2) + eta2);            
 2647:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 2648:          } 
 2649:          else if (eta2 <= - h_c - (depth - h_c) * theta_f/sinh_theta_f) {
 2650:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 2651:             assert(false && "ZCOOR: invalid h_c\n");
 2652:          } 
 2653:          else {
 2654: printf("eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig] = %e\n", eta2*(1.0 + mesh->sigma[ksig]) + h_c * mesh->sigma[ksig] + (hmod2 - h_c) * mesh->cs[ksig]);
 2655:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 2656:                          h_c * mesh->sigma[ksig] + 
 2657:                          (hmod2 - h_c) * mesh->cs[ksig];
 2658:          }
 2659:       } else { 
 2660:          assert(false && "ZCOOR: invalid level or coordinate system\n");
 2661:       }
 2662: 
 2663:    }
 2664:    else if constexpr(ivcor == 1) {
 2665:       if (k == kb) return -depth;
 2666:       else if (k == nvrt-1) return eta2;
 2667:       else if (k >= kb) return (eta2 + depth) * mesh->sigma_lcl[k] + eta2;
 2668:    }
 2669:    
 2670:    assert(false && "ZCOOR: invalid level or coordinate system\n");
 2671:    return 0.0;
 2672: }
 2673: 
 2674: 
 2675: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 2676:    // Checks if a side in on the boundary
 2677:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 2678: 
 2679:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 2680:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 2681: 
 2682:    // Indices of the nodes that form the side
 2683:    const int n1 = side.n1->idx;
 2684:    const int n2 = side.n2->idx;
 2685: 
 2686:    // Check if the side is on a land boundary
 2687:    for (int i = 0; i < nland; i++) {
 2688:       for (int j = 0; j < nlnd[i] - 1; j++) {
 2689:          // Consecutive nodes in the land boundary segment
 2690:          const int b1 = ilnd[i*mnlnd + j];
 2691:          const int b2 = ilnd[i*mnlnd + j + 1];
 2692: 
 2693:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2694:             isLand = true;
 2695:             return i;
 2696:          }
 2697:       }
 2698:    }
 2699: 
 2700:    // Check if the side is on an open boundary
 2701:    for (int i = 0; i < nope; i++) {
 2702:       for (int j = 0; j < nond[i] - 1; j++) {
 2703:          // Consecutive nodes in the open boundary segment
 2704:          const int b1 = iond[i*mnond + j];
 2705:          const int b2 = iond[i*mnond + j + 1];
 2706: 
 2707:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 2708:             isLand = false;
 2709:             return i;
 2710:          }
 2711:       }
 2712:    }
 2713:    return -1;
 2714: }
 2715: 
 2716: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 2717:                 double *node_coords, double *wind_rotate_angle, 
 2718:                 int *isdel, int *isidenode, int *isbnd,
 2719:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 2720:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 2721:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 2722:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 2723:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 2724:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 2725:                 double *emo, double *efa, 
 2726:                 double *umo, double *ufa, 
 2727:                 double *vmo, double *vfa) {
 2728: 
 2729:    printf("Populating mesh for partition %d\n", partNum);
 2730: 
 2731:    // Horizontal grid
 2732:    printf("Processing %d nodes\n", np);    
 2733: 
 2734: 
 2735:    int idxNodeBoundary = 0;  
 2736:    for (int i = 0; i < np; i++)
 2737:    {
 2738:       Node &node = localNodeData[i];
 2739: 
 2740:       node.idx = i;
 2741: 
 2742:       const int idxNodeStart = nodeNeighNodesStart[i];
 2743:       const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 2744:       node.numNodes = idxNodeEnd - idxNodeStart;
 2745:       node.nodes = nodeNeighNodes + idxNodeStart;
 2746:       node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 2747: 
 2748: 
 2749: 
 2750:       const int idxElemStart = nodeNeighElemsStart[i];
 2751:       const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 2752:       node.numElements = idxElemEnd - idxElemStart;
 2753:       node.elements = nodeNeighElems + idxElemStart;
 2754: 
 2755: 
 2756:       
 2757:       for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 2758:          const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 2759:          const int partNode = localNodePart[idxNodeGlobal]; 
 2760:          const int idxNode  = localNodeIndices[idxNodeGlobal];
 2761: 
 2762: 
 2763:          Node *node_ptr = nodes[partNode] + idxNode;
 2764:          
 2765:          nodeNeighNodes[idx] = node_ptr;
 2766:       }
 2767: 
 2768:       for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 2769:          const int idxElemGlobal = nodeNeighElemsIndices[idx];
 2770:          const int partElem = localElemPart[idxElemGlobal];
 2771:          const int idxElem  = localElemIndices[idxElemGlobal];
 2772: 
 2773:          Element *elem_ptr = elems[partElem] + idxElem;
 2774: 
 2775:          nodeNeighElems[idx] = elem_ptr;
 2776:       }      
 2777: 
 2778: 
 2779:       node.wind_angle = wind_rotate_angle[i];
 2780: 
 2781:       // Element **elements; // pointer to the elements connected to this node
 2782:       // int numElements;   // number of elements shared by this node
 2783: 
 2784:       node.p.x   = node_coords[i * 3];
 2785:       node.p.y   = node_coords[i * 3 + 1];
 2786:       node.p.z   = node_coords[i * 3 + 2];  // XXX this is probably wrong
 2787:       node.depth = node_coords[i * 3 + 2];
 2788: 
 2789:       node.numSides = 0;
 2790: 
 2791: 
 2792:       // Links the node to the boundary information
 2793:       if (isbnd[i] >= 0) {
 2794:        
 2795:          node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 2796:          node.nodeBnd->node = &node;
 2797: 
 2798:          node.nodeBnd->sideBnd1 = nullptr;
 2799:          node.nodeBnd->sideBnd2 = nullptr;
 2800: 
 2801:          if (isbnd[i]>=0) {
 2802: 
 2803:             node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 2804:             
 2805:             node.nodeBnd->segment->ifltype = (isbnd[i]==0)?3:0;
 2806:             node.nodeBnd->segment->iettype = 3; // XXXXXXXXX
 2807: 
 2808:             // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 2809:             node.nodeBnd->segment->clen  = nan("1");
 2810:             node.nodeBnd->segment->carea = nan("1");
 2811: 
 2812:          }
 2813: //          else {
 2814: //             node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2815: // printf("EEEEEPP isbnd[i] = %d, node.nodeBnd->segment = %p\n", isbnd[i], node.nodeBnd->segment);            
 2816: //          }
 2817:          
 2818:          idxNodeBoundary++;
 2819:       }
 2820:       else {
 2821:          node.nodeBnd = nullptr; // For internal nodes
 2822: 
 2823:          if (isbnd[i] == landSegment) {
 2824:             node.nodeBnd = &landBoundaryNode;
 2825:             node.nodeBnd->segment = &landBoundarySegment;
 2826:          }
 2827:          // node.nodeBnd->node = &node;
 2828:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2829:          // // node.nodeBnd = nullptr;
 2830:          // node.nodeBnd->segment = (BoundarySegment *)(isbnd[i]); // Hack, isbnd[i] will be -1 or -2 in this case
 2831:         
 2832:       }
 2833: 
 2834:       // XXXX GAUSSIAN HILL VELOCITIES
 2835: #ifdef GAUSSIAN_HILL_VELOCITIES
 2836:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2837:          constexpr double rot_per = 3000.0;
 2838:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 2839:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f, 0.0}; }
 2840:       // XXXXX
 2841: #endif
 2842:    }
 2843: 
 2844:    nbp = idxNodeBoundary;
 2845: 
 2846:    printf("Processing %d sides\n", ns);
 2847:    int idxSideBoundary = 0;
 2848:    for (int i = 0; i < ns; i++)
 2849:    {
 2850:       Side &side = localSideData[i];
 2851:       side.idx = i;
 2852:       // finding the pointer to the nodes that form the side
 2853:       const int idx_n1 = isidenode[globalSideIndices[i]*2];
 2854:       const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 2855: 
 2856:       const int locidx_n1 = localNodeIndices[idx_n1];
 2857:       const int locidx_n2 = localNodeIndices[idx_n2];
 2858:       const int part_n1 =   localNodePart[idx_n1];
 2859:       const int part_n2 =   localNodePart[idx_n2];
 2860: 
 2861:       side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 2862:       side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 2863: 
 2864:       // Counts the number of sides connected to each node
 2865:       side.n1->numSides++;
 2866:       side.n2->numSides++;
 2867: 
 2868:       // Normal, unitary vector to the side
 2869:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 2870:       side.n = normalize(side.n);
 2871: 
 2872:       // Side boundary type
 2873:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 2874:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 2875: 
 2876:       if (n1bnd != nullptr && n2bnd != nullptr) 
 2877:       // If both nodes are on the boundary, then the side may be on the boundary
 2878:       {
 2879:          bool isLand = false;
 2880:          int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 2881: 
 2882:          if (isbs > -1) {
 2883:             side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2884:             if      ( isLand) side.sideBnd->segment = &landBoundarySegment;
 2885:             else if (!isLand) side.sideBnd->segment = &(localSegmentMem[isbs]);
 2886: 
 2887:             // Links each node boundary to the side boundary using the first available side boundary pointer
 2888:             if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 2889:             else                            n1bnd->sideBnd2 = side.sideBnd;
 2890: 
 2891:             if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 2892:             else                            n2bnd->sideBnd2 = side.sideBnd;
 2893:           
 2894:             side.sideBnd->side = &side;
 2895:             idxSideBoundary++;
 2896: 
 2897:             printf("Here1.5: %d, isbs = %d, isLand = %d, side.sideBnd = %p\n", i, isbs, isLand, side.sideBnd);
 2898:          }
 2899:          
 2900: 
 2901:       // }
 2902:       // 
 2903: 
 2904: 
 2905: 
 2906: 
 2907: //       // XXXX YYYY NOTE: I'm chosing the boundary type of the first node. This may not be correct.
 2908: // printf("Here2: %d, idxSideBoundary = %d, side.n1->idx = %d, side.n2->idx = %d\n", i, idxSideBoundary, side.n1->idx, side.n2->idx);      
 2909: //       if (n1bnd != nullptr || n2bnd != nullptr) 
 2910: //       {
 2911: // printf("Here2.5: %d, idxSideBoundary = %d\n", i, idxSideBoundary);           
 2912: //          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 2913: // printf("Here2.6: %d, side.sideBnd = %p, n1bnd = %p, n2bnd = %p\n", i, side.sideBnd, n1bnd, n2bnd);           
 2914: // // printf("Here2.7: %d, side.sideBnd->segment = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", i, side.sideBnd->segment, n1bnd->segment, n2bnd->segment);      
 2915: // if (side.sideBnd->segment == nullptr) continue;
 2916: //          if (n1bnd != nullptr) side.sideBnd->segment = n1bnd->segment;
 2917: //          else                  side.sideBnd->segment = n2bnd->segment;
 2918: //          side.sideBnd->side = &side;
 2919: //          idxSideBoundary++;
 2920: // printf("EERRREEEE side.sideBnd = %p, n1bnd = %p, n2bnd = %p, n1bnd->segment = %p, n2bnd->segment = %p\n", side.sideBnd, n1bnd, n2bnd, n1bnd->segment, n2bnd->segment);
 2921:       }
 2922:       else side.sideBnd = nullptr;
 2923: 
 2924:       nbs = idxSideBoundary;
 2925: 
 2926:       // finding the pointer to the elements that share the side
 2927:       const int idx_e1 = isdel[globalSideIndices[i]*2];
 2928:       const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 2929: 
 2930:       if (idx_e1 > -1) {
 2931:          const int locidx_e1 = localElemIndices[idx_e1];
 2932:          const int part_e1 =  localElemPart[idx_e1];
 2933:          side.elems[0] = elems[part_e1] + locidx_e1;
 2934: 
 2935:       }
 2936:       else {
 2937:          side.elems[0] = nullptr;
 2938:       }
 2939: 
 2940:       if (idx_e2 > -1) {
 2941:          const int locidx_e2 = localElemIndices[idx_e2];
 2942:          const int part_e2 =  localElemPart[idx_e2];
 2943:          side.elems[1] = elems[part_e2] + locidx_e2;
 2944:       }
 2945:       else {
 2946:          side.elems[1] = nullptr;
 2947:       }
 2948: 
 2949:       // Compute the center of the side
 2950:       side.center = 0.5*(side.n1->p2() + side.n2->p2());
 2951: 
 2952:       assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 2953:       side.shapiro = shapiro0;
 2954: 
 2955: #ifdef GAUSSIAN_HILL_VELOCITIES
 2956: // XXXX
 2957: if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 2958: constexpr double rot_per=3000.0;
 2959: constexpr double rot_f=0.0*2.0*pi/rot_per;
 2960: for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 2961: // XXXXX      
 2962: #endif
 2963:       // Compute the z level at the center of the side
 2964:       for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);
 2965: 
 2966:       // Compute the length of the side
 2967:       const Vector2 vLen = side.n2->p2() - side.n1->p2();
 2968:       side.len = sqrt(dot(vLen, vLen));
 2969: 
 2970:    }
 2971: 
 2972:    printf("Processing %d elements\n", ne);
 2973:    for (int i = 0; i < ne; i++)
 2974:    {
 2975:       Element &elem = localElemData[i];
 2976:       elem.idx = i;
 2977:       for (int j = 0; j < i34[i]; j++) {
 2978:          const int idxNode = elnode[i*4 + j];  
 2979:          const int idxSide = elside[i*4 + j];
 2980:          
 2981:          elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 2982:          elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 2983: 
 2984: 
 2985: 
 2986:          // Find the neighboring element  
 2987:          if (elem.sides[j]->elems[0] == &elem) {
 2988:             elem.nghbElems[j] = elem.sides[j]->elems[1];
 2989:          }
 2990:          else {
 2991:             elem.nghbElems[j] = elem.sides[j]->elems[0];
 2992:          }
 2993:          
 2994:       }
 2995: 
 2996:       elem.i34 = i34[i];
 2997: 
 2998:       // Compute the centroid of the element and its depth
 2999:       Vector2 center = {0.0, 0.0};
 3000:       elem.depth = 0.0;
 3001:       for (int j = 0; j < i34[i]; j++) {
 3002:          center += elem.nodes[j]->p2()/i34[i];
 3003:          elem.depth  += elem.nodes[j]->p.z/i34[i];
 3004:       }
 3005:       elem.center.x = center.x;
 3006:       elem.center.y = center.y;
 3007: 
 3008: 
 3009:       
 3010:       // if constexpr(ics==2) elem.zc += elem.znd[j]/i34;   XXX Implement this?
 3011:       // if(dp(elnode(j,ie))<dpe(ie)) dpe(ie)=dp(elnode(j,ie))
 3012: 
 3013:       elem.area = elem.computeSignedArea(); 
 3014:       elem.radius = sqrt(elem.area)/pi; 
 3015:       
 3016:       // Determines which way the normal vector to each side is oriented.
 3017:       // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 3018:       for (int j = 0; j < i34[i]; j++)  
 3019:       {
 3020:          if (elem.sides[j]->elems[0] == &elem) {
 3021:             elem.ssign[j] =  1.0;
 3022:          }
 3023:          else {
 3024:             elem.ssign[j] = -1.0;
 3025:          }
 3026: 
 3027:       }
 3028: 
 3029:       // Derivatives of shape functions
 3030:       //  For ics=2, this is done inside element/ll frame XXX
 3031:       //  For quads, the derivative is evaluated at centroid
 3032:       const int i34 = elem.i34;
 3033:       for (int j = 0; j < i34; j++) {
 3034:          const double area = elem.area;
 3035:          const int id2 = elem.nxq(1 + j);
 3036:          const int id3 = elem.nxq(2 + j);
 3037:          const int id4 = elem.nxq(3 + j);
 3038:          if (elem.isTri()) {
 3039:             // This expression can be derived from the derivatives of the shape functions in area coordinates.
 3040:             // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 3041:             // da1/dx = (y1 - y2)/(2*area)
 3042:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id3]->p.y)/(2*area); 
 3043:             const double dPhi_j_dy = (elem.nodes[id3]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3044:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3045:          }
 3046:          else  { // Quad; evaluate at centroid
 3047:             const double dPhi_j_dx = (elem.nodes[id2]->p.y - elem.nodes[id4]->p.y)/(2*area); 
 3048:             const double dPhi_j_dy = (elem.nodes[id4]->p.x - elem.nodes[id2]->p.x)/(2*area); 
 3049:             elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 3050:          } // if Tri
 3051: 
 3052:       } // for j
 3053: 
 3054:    }
 3055: 
 3056: 
 3057:    // Processing the boundary nodes
 3058:    int idx = 0;
 3059:    for (int iseg = 0; iseg < nope; iseg++) {
 3060:       // for each segment...
 3061:       
 3062:       for (int ind = 0; ind < nlnd[iseg]; ind++) {
 3063:          // for each node on the segment...
 3064: 
 3065:          NodeBoundary *nodeBnd = &localNodeBoundaryMem[idx];
 3066: 
 3067:          nodeBnd->isEssentialBC = true;
 3068: ////nodeBnd->iettype = 3; // XXXXXXXXX
 3069:          nodeBnd->elbc = 0.0;
 3070: 
 3071:          for (int jfr = 0; jfr < nbfr; jfr++) {
 3072: 
 3073:             const int idx = iseg*mnond*nbfr + ind*nbfr + jfr;
 3074:             nodeBnd->efa[jfr] = efa[idx];
 3075:             nodeBnd->emo[jfr] = emo[idx];
 3076:             nodeBnd->umo[jfr] = {umo[idx], vmo[idx]};
 3077:             nodeBnd->ufa[jfr] = {ufa[idx], vfa[idx]};
 3078: 
 3079:          }
 3080: 
 3081:          idx++;
 3082:       }
 3083: 
 3084:    }
 3085: 
 3086: }
 3087: 
 3088: 
 3089: 
 3090: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3091:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3092:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3093:    // 
 3094:    // This kernel is called for all nodes.
 3095: 
 3096: 
 3097:    NODE(node1);
 3098: 
 3099: 
 3100:    node1->clearMatrixRow();
 3101:    node1->qel = 0.0;
 3102: 
 3103:    // THIS IS FOR STRUCTURES XXX
 3104:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3105: 
 3106:    
 3107:    for (int j=0; j<node1->numElements; j++) {
 3108:       // For each element connected to the node...
 3109: 
 3110:       Element *elem = node1->elements[j];
 3111: 
 3112:       // Compute the average gravity
 3113:       const double grav3 = elem->mean(&Node::grav2);
 3114: 
 3115:       // Look at the documentation for the description of the terms in the following integrals
 3116: 
 3117:       // Integral I_1 
 3118:       // \bar{\breve{H}} 
 3119:       const double hhatb = elem->mean(&Side::hhat);        
 3120: 
 3121: 
 3122:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3123: 
 3124:       const int id1 = elem->nodeLocalIdx(node1); 
 3125:       const double area = elem->area;
 3126: 
 3127:       if (elem->isTri()) {
 3128: 
 3129:          // To clarify the notation in this section: 
 3130:          //   i stands for the node under consideration (node1)
 3131:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3132:          const int id2 = elem->nxq(1 + id1);
 3133:          const int id3 = elem->nxq(2 + id1);
 3134:          Node *node2 = elem->nodes[id2];
 3135:          Node *node3 = elem->nodes[id3];
 3136: 
 3137:          const Point2 x1 = node1->p2();
 3138:          const Point2 x2 = node2->p2();
 3139:          const Point2 x3 = node3->p2();
 3140: 
 3141:          // integral of phi_i*phi_j
 3142:          const double ipp_ii = (1.0/6.0 )*area;
 3143:          const double ipp_ij = (1.0/12.0)*area;
 3144:          const double ipp_ik = (1.0/12.0)*area;
 3145: 
 3146:          // integral of [(grad phi_i) * (grad phi_j)]
 3147:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3148:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3149:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3150: 
 3151:          // Computes the different components of integral I_1 of each node with respect to node i.
 3152:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3153:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3154:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3155: 
 3156:          node1->addToSparseMatrix(node1, I1_ii);
 3157:          node1->addToSparseMatrix(node2, I1_ij); 
 3158:          node1->addToSparseMatrix(node3, I1_ik);
 3159: 
 3160:       }
 3161:       else { // Quad
 3162:          // XXX IMPLEMENT THIS
 3163:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3164:       } 
 3165: 
 3166:  
 3167:       // Integral I_4
 3168:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3169:       // Where
 3170:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3171: 
 3172:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3173:       // of U over the element.
 3174:       Vector2 Umean = {0.0, 0.0};
 3175:       for (int m=0; m<elem->i34; m++) {      
 3176:          const Side *side = elem->sides[m];
 3177: 
 3178:          if constexpr(ics == 1) Umean += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3179:          else                   Umean += side->frame.project_hvec(side->U, elem->frame);
 3180:       }
 3181:       Umean = Umean/elem->i34;
 3182: 
 3183:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3184: 
 3185:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3186:       const double I_4_1 = dot(gradPhi_1, Umean);
 3187: 
 3188:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3189:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3190:      
 3191: // printf(">>> k = %d, node idx = %d, elem->idx = %d, Umean = %.15e,%.15e, I_4_1 = %.15e, I_4_2 = %.15e, node1->qel = %.15e\n", j, node1->idx, elem->idx, Umean.x, Umean.y, I_4_1, I_4_2, dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2));
 3192: // printf(">>> k = %d, node idx = %d, elem->idx = %d, ghat1 = %.15e,%.15e, gradPhi = %.15e,%.15e\n", j, node1->idx, elem->idx, elem->ghat1.x, elem->ghat1.y, gradPhi_1.x, gradPhi_1.y);
 3193:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3194: 
 3195:       // Additional terms 
 3196:       double vnorm = 0.0;
 3197:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3198:          Vector3 ubed;
 3199:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3200: 
 3201:          Vector3 gradP = {0.0, 0.0, 1.0};
 3202:          for (int m=0; m < elem->i34; m++) {
 3203:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3204:            gradP += toVector3(gradP_2D, 0.0);
 3205:          }   
 3206:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3207:       } // imm==2
 3208: 
 3209:       if (elem->isTri()) {
 3210:          for (int l=0; l<3; l++) {
 3211:             double fac;
 3212: 
 3213:             Node *node = elem->nodes[l];
 3214: 
 3215:             fac = (node == node1) ? 2.0 : 1.0;
 3216:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3217:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3218: // printf("AAA>>>  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm) = %.15e\n",  (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm));
 3219:            
 3220:          }
 3221: 
 3222: 
 3223:          if (!elem->isDry) {
 3224:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3225: 
 3226:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3227: // printf("BBB>>>  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta) = %.15e\n",  elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta));
 3228:          }
 3229: 
 3230:       } // isTri
 3231:       else { // isQuad
 3232:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3233:          // for (int l=0; l<4; l++) {
 3234:          //   const Node *node = elem->nodes[l];
 3235: 
 3236:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3237:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3238: 
 3239:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3240:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3241:          // }
 3242: 
 3243:       } // isQuad
 3244: 
 3245: 
 3246:       node1->qel += (dt/elem->i34)*elem->vsource;
 3247:       
 3248: 
 3249:    } // for all elements connected to the node
 3250:    
 3251: 
 3252: 
 3253:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3254:    // I_2,6 are not needed if essential b.c. are enforced by elminating rows and columns
 3255:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3256:    if (nodeBnd != nullptr)  { 
 3257:       // If it is an open boundary node...
 3258: 
 3259:       // At least one open bnd side, maybe two
 3260:       for (int l=0; l<2; l++) { 
 3261: 
 3262:          // Gets each of the sides sharing the node. 
 3263:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3264: 
 3265:          if (sideBnd == nullptr) continue; // Skip if no boundary side
 3266: 
 3267:          const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3268: 
 3269:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3270:          if (sideBnd != nullptr) {
 3271:             // If the side is on a boundary...
 3272: 
 3273:             // Get the boundary segment
 3274:             const BoundarySegment *sideSegment = sideBnd->segment;
 3275:             const Side *side = sideBnd->side;
 3276: 
 3277:             // Integral I_3
 3278:             if (sideSegment->ifltype != 0) {
 3279:             // Natural or Flather b.c.
 3280: 
 3281:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3282:                // especially for Flather b.c.
 3283:                double ri3 = 0.0;
 3284:                if (!side->isDry) {
 3285:                   // If the side is not dry
 3286:                   
 3287:                   // Computes the side flux of (uth, vth)
 3288:                   double Vn = 0.0;
 3289:                   for (int k = side->kb; k<nvrt-1; k++) {
 3290:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3291:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3292: 
 3293:                      Vn += 0.5*(side->zc[k+1] - side->zc[k])*(vn1 + vn2);
 3294:                   }
 3295: 
 3296:                   ri3 = 0.5*side->len*Vn;
 3297:                }
 3298: 
 3299:                if (sideSegment->ifltype == -1) { // Flather 1
 3300: 
 3301:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3302:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3303: 
 3304:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3305:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3306:                   
 3307:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3308:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3309: 
 3310:                } 
 3311:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3312:                   // Reset ri3
 3313:                   ri3 = 0.0;
 3314: 
 3315:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3316: 
 3317:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3318: 
 3319:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3320:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3321: 
 3322:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3323:                   node1->addToSparseMatrix(node1, con0*2.0);
 3324:                   node1->addToSparseMatrix(node2, con0);
 3325: 
 3326:                } // if Flather or Discharge
 3327: 
 3328:                node1->qel -= thetai*dt*ri3;
 3329: 
 3330:             } // I_3
 3331:           
 3332: 
 3333:             // Integral I_5
 3334:             if(!side->isDry) {
 3335: 
 3336:                const double Unbar = dot(side->U, side->n);
 3337:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3338: 
 3339:             } // I_5
 3340: 
 3341:          } // if is boundary side
 3342: 
 3343:       } // for l
 3344: 
 3345:    } // if isbnd
 3346: 
 3347: 
 3348: }
 3349: 
 3350: 
 3351: 
 3352: extern "C" {
 3353:    __global__ void rollUpElevation(void) {
 3354: 
 3355:       NODE(node);
 3356: 
 3357:       node->eta1 = node->eta2;
 3358: 
 3359:    }
 3360: 
 3361: 
 3362:    __global__ void backtrackAllNodes(void) {
 3363: 
 3364:       // max/min # of sub-divisions
 3365:       const int ndelt_max = max(1.0, dt/dtb_min);
 3366:       const int ndelt_min = max(1.0, dt/dtb_max); 
 3367: 
 3368:       // Removed all references to swild98 XXX
 3369:       // swild98=0.d0 !init
 3370: 
 3371: 
 3372:       SIDE(side);
 3373: 
 3374:       const int kb = side->kb;
 3375: 
 3376: 
 3377: 
 3378:       // Initialize btrack velocities to the actual velocities at the side 
 3379:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3380: 
 3381:       if (side->isDry) return;
 3382: 
 3383: 
 3384:       // Checks that at least one element is not dry
 3385:       const Element *elem1 = side->elems[0];
 3386:       const Element *elem2 = side->elems[1];
 3387: 
 3388: 
 3389:       assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3390:       
 3391:       // XXXXXX
 3392:       // !swild_tmp to store global coord. of the starting side
 3393:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3394:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3395:       // !Use sframe2 
 3396:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3397: 
 3398: 
 3399:       for (int k = kb; k < nvrt; k++) {
 3400:       //  Initialize (xt,yt,zt), nnel and vel.
 3401:       //  For ics=2, the coordinates are in local frames
 3402:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3403: 
 3404: 
 3405:          const int iadvf = side->iadv();  // Advection flag
 3406: 
 3407:          Point3 xt;
 3408:          if constexpr(ics==1) {
 3409:             xt = side->center3D(k); 
 3410:          }
 3411:          else // lat/lon; in side lat/lon frame
 3412:          {
 3413:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3414:          // XXX IMPLEMENT THIS
 3415:       //          xt=0.d0
 3416:       //          yt=0.d0
 3417:       //          !centroid coord. for nudging
 3418:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3419:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3420:          }  // ics
 3421: 
 3422: 
 3423: 
 3424:          // If on land or open boundary...
 3425:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3426:          
 3427:          const double vmag = length(side->u2[k]);
 3428: 
 3429:          if (vmag <= velmin_btrack) {
 3430:             // No activity 
 3431: 
 3432:             side->btu[k] = side->u2[k];
 3433:             
 3434:          } else {  // do btrack
 3435: 
 3436:             // Compute number of sub-divisions based on local gradients 
 3437:             // XXX IS THIS NECESSARY?
 3438:             double suma = 0.0;
 3439:             int icount = 0;
 3440:             for (int ii=0; ii<2; ii++) {
 3441: 
 3442:                const Element *elem = side->elems[ii];
 3443:                  
 3444:                if (elem == nullptr) continue;
 3445: 
 3446:                icount++;
 3447: 
 3448:                // Not strictly along z; in ll frame for ics=2
 3449: 
 3450:                double utmp[4];
 3451:                double vtmp[4];
 3452:                for (int jj = 0; jj < elem->i34; jj++) {
 3453: 
 3454:                   const Node *node = elem->nodes[jj];
 3455: 
 3456:                   if constexpr(ics==1) {
 3457:                      utmp[jj] = node->u2[k].x;
 3458:                      vtmp[jj] = node->u2[k].y;  
 3459:                   } else {
 3460:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3461:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(jj),vtmp0(jj))
 3462:                   }
 3463:                } // for jj
 3464: 
 3465:                const Vector2 grad_u = elem->grad2(utmp); 
 3466:                const Vector2 grad_v = elem->grad2(vtmp);
 3467: 
 3468:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3469:             } // for ii
 3470: 
 3471:             assert(icount > 0 && "Impossible 77");
 3472: 
 3473:             // '4' is somewhat arbitrary
 3474:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3475: 
 3476:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3477:          
 3478: 
 3479:             Vector3 u_int = {0.0, 0.0, 0.0};
 3480: 
 3481:             side->btrack(k, dt, dtbk, u_int);
 3482:             side->btu[k] = toVector2(u_int);
 3483:                
 3484:          } // if vmag (do backtrack)
 3485: 
 3486:       } // for j=jmin,nvrt-1
 3487: 
 3488:    }
 3489: } // extern "C"
 3490: 
 3491: template<int nc>
 3492: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3493: 
 3494: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3495: //
 3496: // a,b,c,rhs: input vectors and are not modified by this program.
 3497: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3498: // rhs is the r.h.s.
 3499: // n: actual rank of the system.
 3500: // rows in u() and rhs();
 3501: // u: output with nc columns (transposed to rows)
 3502: // gam: a working array.
 3503: //
 3504: // NOTES:
 3505: // This is a template function that allows for different numbers of columns in the rhs vector.
 3506: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3507: 
 3508:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3509:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3510: 
 3511:    double bet = b[0];
 3512:    if constexpr (nc == 1) {
 3513:       u[0] = rhs[0]/bet;
 3514:    } else {
 3515:       for (int k = 0; k < nc; k++) u[k*nc] = rhs[k*nc]/bet;
 3516:    }
 3517: 
 3518:    for (int j = 1; j < n; j++) {
 3519:       gam[j] = c[j-1]/bet;
 3520:       bet = b[j] - a[j]*gam[j];
 3521: 
 3522:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3523: 
 3524:       if constexpr (nc == 1) {
 3525:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3526:       } else {
 3527:          for (int k = 0; k < nc; k++) {
 3528:             u[j + k*nc] = (rhs[j + k*nc] - a[j]*u[j - 1 + k*nc])/bet;
 3529:          }
 3530:       }
 3531:    }
 3532: 
 3533:    // Back-substitution
 3534:    for (int j=n-1; j>=1; j--) {
 3535:       if constexpr (nc == 1) {
 3536:          u[j] = u[j] - gam[j+1]*u[j-1];
 3537:       } else {
 3538:          for (int k = 0; k < nc; k++) {
 3539:             u[j + k*nc] = u[j + k*nc] - gam[j + 1]*u[j-1 + k*nc];
 3540:          }
 3541:       }
 3542:    }
 3543: }
 3544: 
 3545: 
 3546: 
 3547: // Helper function that contains the core algorithm
 3548: template<typename XAccessor, typename YAccessor>
 3549: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 3550:                                     double  yp_top, double  yp_bot, 
 3551:                                     CubicSpline &spline) {
 3552:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 3553:    // 
 3554:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 3555:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 3556:    //
 3557:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 3558:    // 
 3559:    // Inputs: 
 3560:    //            n: dimension for x etc; # of data pts (>=2);
 3561:    //            getX, getY: functions to access x,y coordinates
 3562:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 3563:    //     Output: 
 3564:    //            spline (CubicSpline): spline structure with x,y,y',y''
 3565: 
 3566:    const int n = k2 - k1 + 1;
 3567:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 3568: 
 3569:    // Allocate memory for the splines
 3570:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 3571:    spline.x   = new double[n];
 3572:    spline.y   = new double[n];
 3573:    spline.yp  = new double[n];
 3574:    spline.ypp = new double[n];
 3575: 
 3576:    for (int k=k1; k<=k2; k++) {
 3577:       spline.x[k] = getX(k);
 3578:       spline.y[k] = getY(k);
 3579:    }
 3580: 
 3581:    // This is to simplify expressions later
 3582:    double *x = spline.x;
 3583:    double *y = spline.y;
 3584: 
 3585:    double *a = nullptr;
 3586:    double *b = nullptr;
 3587:    double *c = nullptr;
 3588:    double *gam = nullptr;
 3589:    double *rhs = nullptr;
 3590:    
 3591: 
 3592:       a = new double[n];   // Lower diagonal
 3593:       b = new double[n];   // Diagonal
 3594:       c = new double[n];   // Upper diagonal
 3595:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 3596:       rhs = new double[n]; // Right-hand side
 3597: 
 3598:    for (int k=k1; k<=k2; k++) {
 3599:       if (k == k1) {
 3600:          // Bottom level
 3601:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 3602:          b[k] = (x[k+1] - x[k])/3.0;
 3603:          c[k] = b[k]/2.0;
 3604:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 3605:       } else if (k == n - 1) {
 3606:          // Top level (surface)
 3607:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 3608:          b[k] = (x[k] - x[k-1])/3.0;
 3609:          a[k] = b[k]/2.0;
 3610:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 3611:       } else {
 3612:          // Intermediate levels
 3613:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 3614:          b[k] = (x[k+1] - x[k-1])/3.0;
 3615:          a[k] = (x[k  ] - x[k-1])/6.0;
 3616:          c[k] = (x[k+1] - x[k  ])/6.0;
 3617:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 3618:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 3619:       }
 3620:    }
 3621: 
 3622:    // Solve the tridiagonal system
 3623:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 3624:    
 3625:    spline.yp[k1] = yp_bot;
 3626:    spline.yp[k2] = yp_top;
 3627: 
 3628:    // Compute rest of 1st derivatives using the splines
 3629:    for (int k=k1+1; k<k2; k++) {
 3630:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 3631:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 3632:    }
 3633:    
 3634:    delete[] a;
 3635:    delete[] b;
 3636:    delete[] c;
 3637:    delete[] gam;
 3638:    delete[] rhs;
 3639: 
 3640: }
 3641: 
 3642: // Array version
 3643: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 3644:                                 double y_top, double y_bot, 
 3645:                                 CubicSpline &spline) {
 3646:    auto getX = [x] (int k) { return x[k]; };
 3647:    auto getY = [y] (int k) { return y[k]; };
 3648:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3649: }
 3650: 
 3651: // Lambda version - allows custom access patterns
 3652: template<typename XFunc, typename YFunc>
 3653: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 3654:                                 double y_top, double y_bot,
 3655:                                 CubicSpline &spline) {
 3656:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 3657: }
