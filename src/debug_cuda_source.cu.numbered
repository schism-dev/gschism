 2000: __device__ void lock(int *mutex) {
 2001:     while (atomicCAS(mutex, 0, 1) != 0); // spin until lock acquired
 2002: }
 2003: 
 2004: __device__ void unlock(int *mutex) {
 2005:     atomicExch(mutex, 0);
 2006: }
