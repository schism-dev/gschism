 4241: 
 4242:    __global__ void scaleGravity(double loadtide_coef) {
 4243: 
 4244: 
 4245:       NODE(node);
 4246: 
 4247:       // SAL option: scale gravity
 4248:       if constexpr(iloadtide==2) {  // simple const
 4249:          node->grav2 = grav*(1.0 - loadtide_coef);
 4250: 
 4251:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4252:         
 4253:           const double depth = max(node->depth, 0.0);
 4254:           const double tmp1 = sqrt(depth);
 4255:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4256:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4257:                              2.6969e-13*depth*depth*depth*tmp1;
 4258:           
 4259:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4260:           
 4261: 
 4262: 
 4263:           node->grav2 = grav*(1.0 - beta_bar);
 4264: 
 4265:       } else {  // iloadtide=0,1
 4266:         node->grav2=grav;
 4267: 
 4268:       }
 4269: 
 4270:    }
 4271: 
