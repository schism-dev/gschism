 1973:    template<typename T>
 1974:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 1975:       T values[4];
 1976:       getNodalValues(level, func, values);
 1977: 
 1978:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1979:       if constexpr (IsVector2<T>::value && ics == 2) {
 1980: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 1981:          projectNodeVectorsToElementFrame(values);
 1982: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 1983:       }
 1984: 
 1985:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 1986:    }
 1987: 
 1988:    template<typename T>
 1989:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 1990:       T values[4];
 1991:       getNodalValues(field, values);
 1992: 
 1993:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 1994:       if constexpr (IsVector2<T>::value && ics == 2) {
 1995: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 1996:          projectNodeVectorsToElementFrame(values);
 1997: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 1998:       }
 1999:       
 2000:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2001:    }
 2002: 
 2003: 
 2004:    template<typename T>
 2005:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2006:       T values[4];
 2007:       getNodalValues(level, field, values);
 2008:       
 2009:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2010:       if constexpr (IsVector2<T>::value && ics == 2) {
 2011: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2012:          projectNodeVectorsToElementFrame(values);
 2013: // printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2014:       }
 2015: 
 2016:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2017:    }
 2018: 
 2019:    template<typename T>
 2020:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2021:       T values[4];
 2022:       getNodalValues(field, values);
 2023: 
 2024:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2025:       if constexpr (IsVector2<T>::value && ics == 2) {
 2026: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2027:          projectNodeVectorsToElementFrame(values);
 2028: // printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2029:       }
 2030: 
 2031:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2032:    }
 2033: 
