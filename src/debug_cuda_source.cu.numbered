 1265: struct Node {
 1266: 
 1267:    // Geometry information
 1268:    int idx;        // Index of the node
 1269:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1270:    int numNodes;   // Number of nodes neighbors of this node
 1271: 
 1272:    Element **elements; // Array of pointers to the elements that share this node
 1273:    int numElements;    // Number of elements that share this node
 1274: 
 1275:    int numSides;       // Number of sides that are connected to this node
 1276: 
 1277:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1278:    double gz;          // Global vertical coordinate at the node.
 1279:    Vector2 u2[nvrt];
 1280:    double  w2[nvrt];
 1281:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1282:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1283:    double lon, lat;
 1284:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1285:    double depth;
 1286: 
 1287:    #ifdef USE_FRAMES
 1288:    Frame frame;
 1289:    #endif
 1290: 
 1291:    #ifdef USE_LOCALIZED_SIGMA   
 1292:    double localSigma[nvrt];
 1293:    #endif
 1294: 
 1295:    int kb;       // Bottom index of the node
 1296: 
 1297:    bool isDry;     // True if the node is dry
 1298: 
 1299:    int iadv;     // Advection flag
 1300: 
 1301:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1302:                           // this is nullptr
 1303: 
 1304:    TempVar tmp; // Temporary variable to store different types of variables
 1305: 
 1306:    // Physical information
 1307:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1308:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1309: 
 1310:    double rho[nvrt];     // Density
 1311:    double dfv[nvrt];     // Vertical viscosity
 1312: 
 1313:    double eta1; // Elevation at nodes at previous timestep
 1314:    double eta2; // Elevation at nodes at current timestep
 1315: 
 1316:    double ETP;  // Earth Tidal Potential
 1317: 
 1318:    double pr;    // Air pressure
 1319:    double grav2; // Gravity 
 1320:    
 1321:    Vector2 dav;  // Depth averaged velocity
 1322: 
 1323:    Vector2 tau; // Wind stress vector
 1324: 
 1325:    // Vegetation parameters
 1326:    double veg_h;
 1327:    double veg_nv;
 1328:    double veg_di;
 1329:    double veg_Cd;
 1330:    double veg_h_unbent;
 1331:    double veg_di_unbent;
 1332:    double veg_nv_unbent;
 1333:    double veg_alpha_vert_mean;
 1334:    double veg_alpha0;
 1335:    double veg_alpha3D[nvrt];
 1336: 
 1337:    // Bottom drag parameters
 1338:    double Cd;       // Bottom drag coefficient   
 1339: 
 1340:    // These three are mutually exclusive
 1341:    union {
 1342:       double rmanning; // Bottom Manning's coefficient
 1343:       double rough;    // Bottom roughness length
 1344:       double drag;     // Bottom drag coefficient
 1345:    };
 1346:    Vector2 tau_bot; // Bottom stress vector
 1347: 
 1348:    // XXXX REMOVE FOR IMM>0???
 1349:    double bdef1; // Bottom deformation at previous timestep
 1350:    double bdef2; // Bottom deformation at current timestep
 1351: 
 1352:    double qel; // RHS
 1353:    double coeffDiag; // Diagonal coefficient of the matrix
 1354:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1355: 
 1356:    double mP; // Search direction for conjugate gradient method
 1357:    double mR; // Residual for conjugate gradient method
 1358:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1359:    double mX; // Solution for conjugate gradient method
 1360: 
 1361:    // Meteorological forcing
 1362:    Vector2 u_air;
 1363:    double p_air;  // XXXX is this the same as pr?
 1364:    double t_air;
 1365:    double q_air;
 1366:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1367: 
 1368:    __device__ void setWind(Vector2 &u) {
 1369:    // Sets the wind vector taking into account the mesh angle
 1370:    
 1371:       const double speed = length(u);
 1372: 
 1373:       // Rotate wind vector to the node frame
 1374:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1375: 
 1376:       // Sets the surface stress vector due to wind.
 1377:       if constexpr(nws == 0) {
 1378:          tau = {0.0, 0.0};
 1379: 
 1380:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1381:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1382: 
 1383:       } else {
 1384: 
 1385:          double dragcoef;
 1386: 
 1387:          if constexpr(iwind_form == -1) {
 1388:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1389:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1390: 
 1391:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1392:             tau = cff*u_air;
 1393:  
 1394:          } else if constexpr(iwind_form == 1) {
 1395:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1396:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1397: 
 1398:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1399:             tau = cff*u_air;
 1400: 
 1401:          } else {
 1402:             tau = {0.0, 0.0};
 1403:          }
 1404:       }
 1405:    }
 1406: 
 1407:    #ifdef USE_FRAMES
 1408:    __device__ void setFrame(double lat, double lon) {
 1409: 
 1410:       frame.update(lat, lon);        
 1411:     }
 1412:    #endif
 1413: 
 1414:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1415: 
 1416:    __device__ double sigmaTransitionDepth(void) const;
 1417: 
 1418:    __inline__ __device__ Point2 outputCoords(void) const {
 1419:       if constexpr(ics == 1)  return p;
 1420:       else                    return {rad2deg*lon, rad2deg*lat};
 1421:    }
 1422: 
 1423:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1424:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1425:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1426:    
 1427:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1428: 
 1429:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1430: 
 1431:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1432:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1433: 
 1434:    __device__ __forceinline__ void clearMatrixRow(void) {
 1435:       // Clear the matrix row for this node
 1436: 
 1437: 
 1438:       coeffDiag = 0.0;
 1439: 
 1440:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1441: 
 1442:    }
 1443: 
 1444:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1445:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1446:       
 1447:       if (node == this) {
 1448:          coeffDiag += value;
 1449:      
 1450:       } else {
 1451:          // Search (linearly)the index of the node in the array of nodes
 1452:          // XXX: This is not efficient, see if we can improve this
 1453:          int i;
 1454:          for (i = 0; i < numNodes; i++) {
 1455:             if (nodes[i] == node) {
 1456:                break;
 1457:             }
 1458:          }
 1459:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1460:          coeffMatrix[i] += value;
 1461:       }
 1462:    }
 1463: 
 1464: 
 1465:    __device__ __inline__ void updateZCoordData(void);
 1466: 
 1467:    __device__ __forceinline__ double compZCoord(int k) const;
 1468: 
 1469:    __device__ void updateKb(void);
 1470: 
 1471:    __device__ __forceinline__ void computeBottomDragCd(void);
 1472: 
 1473: 
 1474: 
 1475: };
