 1713: // Helper functions for computing the local node index at a given offset from another.
 1714: __device__ __inline__ int nxq(int offset, int index, int size) {
 1715:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1716:    // to the index to make it positive
 1717:    assert(index + offset + 16*size >= 0);
 1718:    return (index + offset + 16*size) % size;  
 1719: }
 1720: 
 1721: __device__ __inline__ int nxq(int index, int size) {
 1722:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1723:    // to the index to make it positive
 1724:    assert(index + 16*size >= 0);
 1725:    return (index + 16*size) % size; 
 1726: }
