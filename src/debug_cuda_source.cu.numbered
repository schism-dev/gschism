 5648:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5649: 
 5650:       SIDE(side);
 5651: 
 5652:       side->U = {0.0, 0.0}; 
 5653:          
 5654:       if(side->isDry) return;
 5655: 
 5656:       // Vertically integrated velocity U
 5657:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5658:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5659:          side->U += side->Dz(k + 1)*uc;  
 5660:       }
 5661: 
 5662:    }
 5663: 
 5664:    __global__ void computeBottomDragVegetation(void) {
 5665:       // UNFINISHED. CHECK THIS:
 5666:       // How many kernels are needed? Why so many for loops?
 5667:       // Is the loop on sides needed?
 5668: 
 5669:       NODE(node);
 5670: 
 5671: 
 5672:       const int    kb      = node->kb;
 5673:       const double htot    = node->htot2(); 
 5674:       
 5675:       if (node->isDry) {
 5676:          // Default values for dry nodes
 5677:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5678:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5679: 
 5680:          return;
 5681:        
 5682:       }
 5683: 
 5684:       // Computes bottom drag Cd based on the selected nchi
 5685:       node->computeBottomDragCd();
 5686:       
 5687: 
 5688: 
 5689:       //   Bottom stress in m^2/s^2
 5690:       if (node->rho[kb + 1] >= -98.0)
 5691:       {
 5692:          const double mag_u = length(node->u2[kb + 1]);
 5693:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5694: 
 5695:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5696:          // !sediment erosion: this part needs more documentation
 5697:       }
 5698:     
 5699: 
 5700: 
 5701:       // Compute vegetation parameters
 5702:       //--------------------------------
 5703: 
 5704:       // SAV constants
 5705:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5706:       constexpr double veg_cfpsi = 0.16;
 5707: 
 5708:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5709:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5710: 
 5711:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5712:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5713:          int kbin = 0; // bin index
 5714:          for (int k = kb; k < nvrt; k++) {
 5715:             // Computes node height above the bottom level
 5716:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5717:             assert(false && "Vertical variation of vegetation not implemented");
 5718: 
 5719:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5720:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5721:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5722:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5723:             // } else {
 5724:             //    // Find the bin at which the current vertical level is
 5725:             //    while (kbin<nbins_veg_vert) {
 5726:             //       const double zn = node->z[kbin];
 5727:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5728:             //          break;
 5729:             //       } // if
 5730:             //       kbin++;
 5731:             //    } // while
 5732:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5733: 
 5734:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5735:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5736:                
 5737:             //    // Linear interpolation of the vegetation parameters
 5738:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5739:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5740:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5741:             // } // if rl10
 5742: 
 5743:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5744: 
 5745:          } // for k
 5746: 
 5747: 
 5748:       } else { // Ganthy (iveg==2)
 5749:       //  Modify canopy height, diameter, and density
 5750: 
 5751:          // Make sure there is vegetation on this node
 5752:          if (node->veg_h_unbent > 0.0) {
 5753:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5754: 
 5755:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5756:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5757:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5758: 
 5759:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5760:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5761:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5762:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5763:          } // if veg_h_unbent
 5764: 
 5765:          for (int k = 0; k < nvrt; k++) {
 5766:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5767:          } // for k
 5768:       
 5769: 
 5770:       } // if iveg
 5771:      
 5772: 
 5773:       // Compute vertical mean of veg_alpha3D
 5774:       if (iveg != 0) {
 5775:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5776:          double sum1=0.0;
 5777:          double sum2=0.0;
 5778:          // Integrate over each level under the canopy...
 5779:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5780:             const double Dz = node->Dz(k);
 5781: 
 5782:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5783:             sum2 += Dz;
 5784: 
 5785:          } // for k
 5786:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5787:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5788: 
 5789:       } // if iveg
 5790: 
 5791:    }
 5792: 
 5793:    __global__ void computeVegetationAndDragParameters(void) {
 5794:       // Computes the vegetation and drag model parameters:
 5795:       // chi, \tilde\chi, beta, \breve{H}
 5796:       
 5797:       SIDE(side);
 5798: 
 5799:       side->hhat = 0.0;
 5800:       side->chi2 = 0.0;
 5801:       side->chi = 0.0;
 5802:       side->veg_c2 = 0.0;
 5803:       side->veg_beta = 0.0;
 5804: 
 5805:       if (side->isDry) return;
 5806: 
 5807:       const double htot = side->htot2();
 5808:       const int    kb   = side->kb;
 5809: 
 5810:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5811: 
 5812:       const double veg_h     = side->veg_h();
 5813:       const double veg_nv    = side->veg_nv();
 5814:       const double veg_c     = side->veg_c();
 5815:       const double veg_beta  = side->veg_beta;
 5816:       const double veg_alpha = side->veg_alpha_vert_mean();
 5817: 
 5818:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX recommended to change names, chi->chitilde, chi2->chi
 5819:       // Velocity magnitude at the bottom level
 5820:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0 - dt*swild2(k,1) to u2 (I think this only pertains to iupwind_mom \= 0)
 5821:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5822:       side->chi2 = side->Cd()*vmag1;
 5823:       side->chi  = side->chi2;
 5824:       if constexpr(iveg != 0) {
 5825:          const Node *n1 = side->n1;
 5826:          const Node *n2 = side->n2;
 5827:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5828:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5829:       }
 5830: 
 5831:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5832: 
 5833:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5834:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5835:       double magUa = 0.0;
 5836:       if constexpr(iveg != 0) {
 5837:          if (side->is3D() && veg_h > 0.0) {
 5838:             // 3D wet side with veg...
 5839: 
 5840:             double magUa = 0.0;
 5841:             for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5842:                if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5843: 
 5844:                   // Velocity magnitude must be computed at the center of each level to perform the integration.
 5845:                   // The tricky part is to compute that velocity at the level that may be partially submerged.
 5846:                   const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5847: 
 5848:                   // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5849:                   const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5850: 
 5851:                   // Velocity magnitude at the bottom (l) of the level
 5852:                   const double ul = length(side->u2[k]);
 5853: 
 5854:                   const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5855:                   magUa += Dz*0.5*(uh + ul);
 5856: 
 5857:                } // if HasVegetation
 5858:             } // for k
 5859:             const double ua = magUa/min(htot, veg_h); // Vertical average
 5860: 
 5861:             // Computes beta, used for computing the stress term at the top of the canopy.      
 5862:             side->veg_c2 = veg_alpha*dt*ua; // >=0
 5863:             if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5864:                const double zCpy = side->zTopCanopy();
 5865:                const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5866:                const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5867:                const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5868:                const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5869:                side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5870:             } // if isSubmerged
 5871:          } // if is3D
 5872:       } // if iveg   
 5873: 
 5874:       // Computes the friction modified depth, \breve{H} in notes
 5875:       if (side->is2D()) { // 2D
 5876: 
 5877:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5878:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5879: 
 5880:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5881: 
 5882:          side->hhat = htot*htot/fricH; 
 5883: 
 5884:       } else { // 3D
 5885:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5886: 
 5887:          if constexpr(iveg != 0) {
 5888:             
 5889:             if (side->isSubmerged()) { 
 5890:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5891:                side->hhat -= veg_c*Hhat_alpha;
 5892: 
 5893:             } else { // Emergent
 5894:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5895:             }
 5896:          } // if iveg
 5897: 
 5898:          // Enforce positivity for 3D model
 5899:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5900:       } // if 3D
 5901: 
 5902:    }
 5903: 
 5904: 
 5905: 
 5906:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5907:    // Computes the density gradient between two elements, e1 and e2.
 5908:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5909:    // zero in the direction normal to the side. 
 5910:    // 
 5911:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5912:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5913:    //
 5914:    // Input:
 5915:    //    e1: Element
 5916:    //    e2: Neighbor element (or nullptr if boundary)
 5917:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5918:    //    k: Index of the half-level at which the density is interpolated
 5919:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5920:    // 
 5921:    // Output:
 5922:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5923:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5924: 
 5925:       if (e2 == nullptr || e2->isDry) {
 5926:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5927: 
 5928:          Side *side = e1->sides[j];
 5929:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5930:                  
 5931:          if constexpr(ics == 1) {
 5932:             vec = side->n; // Normal vector to the side
 5933:          } else {
 5934:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5935:             // IMPLEMENT THIS XXXXXX
 5936:             // !replace with xel, yel?
 5937:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5938:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5939:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5940:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5941:          } //ics
 5942:                    
 5943:          diffRho = 0.0;
 5944: 
 5945:       } else { //internal and wet
 5946:          if constexpr(ics==1) {
 5947:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5948: 
 5949:             // Vector from e1 to e2
 5950:             vec = e2->center - e1->center;
 5951: 
 5952:          } else { 
 5953:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5954:             // Remember that elem->center is in global coordinates
 5955:             // IMPLEMENT THIS XXXXXX
 5956:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5957:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5958:             //                   alow(j)=xctr2
 5959:             //                   bdia(j)=yctr2
 5960:          } // ics
 5961: 
 5962:          diffRho = rho2 - e1->demeanedDensity(k);
 5963:       }
 5964: 
 5965:    }
 5966: 
 5967:    __global__ void computeDensityCubicSplines(void) {
 5968:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5969: 
 5970:       ELEM(elem);
 5971: 
 5972:       if (elem->isDry) return;
 5973: 
 5974:       const int kb = elem->kb;
 5975: 
 5976:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5977:       if (elem->is2D()) {
 5978:          // In the 2D case, the density is constant at the prism level. 
 5979:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5980:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5981:       } else { //3D
 5982: 
 5983:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5984:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5985:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5986:          ///// XXXX CHECK INDICES!!!!!
 5987:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5988:       } // 2D/3D
 5989: 
 5990:    }
 5991: } // extern "C"
 5992: 
 5993: 
 5994: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5995: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5996: 
 5997:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5998: 
 5999:    const int kb  = elem->kb;
 6000:    const int kb2 = elem2->kb;
 6001: 
 6002:    // z-coordinate of prism of elem
 6003:    const double zp = elem->z_prism(k);
 6004: 
 6005:    double rho = 0.0;
 6006: 
 6007:    if (elem2->is2D()) {
 6008:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 6009: 
 6010:    } else {  // 3D
 6011: 
 6012:       // eta_min may be < zmax
 6013:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 6014:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 6015: 
 6016:       // (Extrapolate density below bottom, we will fix it later)
 6017:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 6018:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 6019:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 6020:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 6021:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 6022:    } // 2D/3D
 6023:      
 6024: 
 6025:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 6026:    // Now we need to fix it.
 6027:    if (elem->z[k] < elem2->z[kb2]) {
 6028:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 6029: 
 6030:       // There are two methods to adjust the density at the bottom of the element.
 6031:       // iunder_deep=0: 
 6032:       const double depth1 = abs(elem->z[kb]); // larger depth
 6033: 
 6034:       if (iunder_deep==0) {
 6035: 
 6036:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 6037: 
 6038:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 6039: 
 6040:       } else { // iunder_deep != 0
 6041: 
 6042:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 6043: 
 6044:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 6045: 
 6046:          //   Demeaned density at the same z coordinate as
 6047:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 6048:          }
 6049: 
 6050:       } // if iunder_deep
 6051:    } // if elem->z[kb] < elem2->z[kb]
 6052: 
 6053:    return rho;
 6054: }
 6055: 
 6056: 
 6057: extern "C" {
 6058:    __global__ void computeDensityGradient(void) {
 6059: 
 6060:       assert(ibc == 1 && "baroclinic formulation is not implemented yet: ibc != 0");
 6061:       if constexpr(ibc != 0) return;
 6062: 
 6063:          // Compute the horizontal density gradient at each element.
 6064:       // It works in two steps:
 6065:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6066:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6067:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6068:       //             gradRho.r1 = rho1 - rho0
 6069:       //             gradRho.r2 = rho2 - rho0
 6070:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6071:       // 
 6072:       //  NOTE: We use de-meaned densities.
 6073: 
 6074:       ELEM(elem);
 6075: 
 6076:       if (elem->isDry) return;
 6077: 
 6078:       const int kb  = elem->kb;
 6079:       const int i34 = elem->i34;
 6080: 
 6081:       for (int k = kb + 1; k < nvrt; k++) {
 6082:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 6083:          //             gradRho.r1 = rho1 - rho0
 6084:          //             gradRho.r2 = rho2 - rho0
 6085:          int icount = 0;
 6086:          double sumRx = 0.0;
 6087:          double sumRy = 0.0;
 6088:          for (int j1=0; j1<i34; j1++) { 
 6089: 
 6090:             const int j2 = elem->nxq(j1 + 1);
 6091: 
 6092:             // Pairs of consecutive neighbor elements of elem
 6093:             const Element *e1 = elem->nghbElems[j1];
 6094:             const Element *e2 = elem->nghbElems[j2];
 6095: 
 6096:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 6097:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 6098:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 6099: 
 6100:             // Compute the density difference and the vector from elem to e1 and e2
 6101:             // getRhoDiffAndVec takes into account boundaries/dry elements
 6102:             double diffRho1, diffRho2;
 6103:             Vector2 vec1, vec2;
 6104:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 6105:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 6106: 
 6107:             const double rl1 = length(vec1);
 6108:             const double rl2 = length(vec2);
 6109:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 6110: 
 6111:             const double delta = cross(vec1, vec2);
 6112:             const double sintheta = abs(delta)/(rl1*rl2);
 6113: 
 6114:             // To avoid problems, avoid elements with small angle between vectors
 6115:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 6116:             const bool validEq = (sintheta > sin_one_deg);
 6117: 
 6118:             if (validEq) {
 6119:                // Solve the system of equations to get the density gradient at elem
 6120:                icount++;
 6121:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 6122:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 6123:                sumRx += Rx;
 6124:                sumRy += Ry;
 6125:             }
 6126:          } // for j1
 6127: 
 6128:          // Compute the average density gradient at elem
 6129:          if (icount==0) {
 6130:            // Bad mesh quality; bail out with 0 b-cc
 6131:            elem->gradRho[k] = {0.0, 0.0};
 6132:          } else {
 6133:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 6134:          }
 6135: 
 6136:       } // for k
 6137: 
 6138:    }
 6139: 
 6140:    __global__ void computeBaroclinicTerm(void) {
 6141:    // Computes the baroclinic term at sides (at half levels).
 6142:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 6143:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 6144: 
 6145:       if (ibc == 1) return;
 6146: 
 6147:       SIDE(side);
 6148: 
 6149:       if (side->isDry) return;
 6150: 
 6151:       const Element *e1 = side->elems[0];
 6152:       const Element *e2 = side->elems[1]; 
 6153:       const int kb = side->kb;
 6154:       
 6155:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 6156: 
 6157:       // interpolates vertically the density gradient of the two elements at the half level/
 6158: 
 6159:       int k1 = max(kb, nvrt / 2);  // Start the search for the half level at the bottom of the side
 6160:       int k2 = max(kb, nvrt / 2);
 6161: 
 6162:       // Starts the integration at the surface and goes down to the bottom
 6163:       side->bcc[nvrt-1] = {0.0, 0.0};
 6164:       for (int k = nvrt - 2; k >= kb; k--) {
 6165:       // For each prism level (from surface to bottom)...
 6166: 
 6167:          // For both elements, interpolate density gradient at the side's half level.
 6168:          // The gradient at the side is the average of the gradients at the elements.
 6169:          // w1, w2 are used to take into account boundary sides, with just one element.
 6170:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 6171:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 6172:          const double wsum = w1 + w2;
 6173:          w1 = w1/wsum;
 6174:          w2 = w2/wsum;
 6175:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 6176: 
 6177:          // Linear interpolation of both elements' density gradient at the shared side's level.
 6178:          Vector2 gradRho = {0.0, 0.0};
 6179:          if (e1 != nullptr && k > kb) {
 6180:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 6181:             
 6182:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 6183:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 6184:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6185: 
 6186:             // Grad(rho) vertically interpolated at the side's half level
 6187:             Vector2 gradRho1 = e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat;
 6188: 
 6189:             // Projects the element density gradient to the side frame if needed.
 6190:             if constexpr(ics==2) gradRho1 = e1->frame.projHorVec(gradRho1, side->frame);
 6191: 
 6192:             // Adds the contribution of the density gradient at the side's half level
 6193:             gradRho += gradRho1*w1;
 6194:          }      
 6195:          if (e2 != nullptr && k > kb) {
 6196:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 6197:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 6198:             assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 6199:             
 6200:             // Grad(rho) vertically interpolated at the side's half level
 6201:             Vector2 gradRho2 = e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat;
 6202: 
 6203:             // Projects the element density gradient to the side frame if needed.
 6204:             if constexpr(ics==2) gradRho2 = e2->frame.projHorVec(gradRho2, side->frame);
 6205: 
 6206:             // Adds the contribution of the density gradient at the side's half level
 6207:             gradRho += gradRho2*w2;
 6208:          }
 6209: 
 6210:          
 6211:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 6212:          // multiplied by -rampbc*(g/rho0) 
 6213:          const double grav3 = side->grav3();
 6214:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;  
 6215: 
 6216:       } // for
 6217: 
 6218:    }
 6219: 
 6220: 
 6221: 
 6222:    __global__ void computeHorGradientAtSide(void) {
 6223: 
 6224:       // Compute the horizontal density gradient at each element.
 6225:       // It works in two steps:
 6226:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 6227:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 6228:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 6229:       //             gradRho.r1 = rho1 - rho0
 6230:       //             gradRho.r2 = rho2 - rho0
 6231:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 6232:       // 
 6233:       //  NOTE: We use de-meaned densities.
 6234: 
 6235:       SIDE(side);
 6236: 
 6237: 
 6238:       if (side->isDry) return;
 6239: 
 6240:       // Computes the gradient of the variables at the side center.
 6241:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 6242:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 6243:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 6244: 
 6245:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 6246:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 6247:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 6248:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 6249: 
 6250:    }
 6251: 
 6252: 
 6253:    __global__ void solveMomentumEquations(double time) {
 6254: 
 6255:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 6256:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 6257: 
 6258:       SIDE(side);
 6259: 
 6260:       if (side->isDry) 
 6261:       {
 6262:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 6263: 
 6264:          return;
 6265:       }
 6266: 
 6267:       const Node *n1 = side->n1;
 6268:       const Node *n2 = side->n2;
 6269: 
 6270:       const int kb = side->kb;
 6271: 
 6272:       const double veg_h = side->veg_h();
 6273:       const double grav3 = side->grav3();
 6274: 
 6275:       if (side->is2D()) {
 6276:          // Remember: Do not use htot2, which is updated.
 6277:          const double htot = side->htot1();
 6278:          const double hhat = side->hhat;
 6279: 
 6280:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 6281: 
 6282:          // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6283:          const Vector2 tau2 = side->tau();
 6284: 
 6285:          // hat_gam has units of m/s
 6286: 
 6287:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 6288:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 6289:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 6290: 
 6291:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 6292: 
 6293: 
 6294:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 6295: 
 6296:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 6297: 
 6298:       }
 6299:       else { // 3D
 6300: 
 6301:          // For 3D it is necessary to solve an implicit tridiagonal system.
 6302:          // 
 6303:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 6304:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 6305:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 6306:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 6307:          // k+1 and k.
 6308: 
 6309: 
 6310:          const int ndim = nvrt - kb;
 6311:          const double zTopCanopy = side->zTopCanopy();
 6312: 
 6313:          // Initialize the tridiagonal system
 6314:          for (int k = kb + 1; k < nvrt; k++) {
 6315:             
 6316:             const int kin = k - (kb + 1);
 6317: 
 6318:             // Vertical viscosity at the face center
 6319:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 6320: 
 6321:  
 6322:             alow[kin] = 0.0;
 6323:             cupp[kin] = 0.0;
 6324:             bdia[kin] = 0.0;
 6325: 
 6326:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 6327:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 6328: 
 6329:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 6330:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 6331:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 6332: 
 6333:             // First part: layers k, k+1
 6334:             if (k < nvrt - 1) {
 6335:                              
 6336:                if constexpr(iveg != 0) {
 6337: 
 6338:                   // If there is vegetation at this level...
 6339:                   if (zTopCanopy > side->zc[k]) {
 6340:                      // If the canopy is above the k layer...
 6341:                      
 6342:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 6343:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 6344:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 6345:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 6346: 
 6347:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 6348:                      const double vmag2 = length(ut2);
 6349:                      const double vmag1 = length(side->u2[k]);
 6350:                      const double vmag = 0.5*(vmag1 + vmag2);
 6351:                      
 6352:                      // Computes the vegetation alpha at the face center
 6353:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 6354: 
 6355:                      cff1 += veg_alpha_sd*dt*vmag;
 6356: 
 6357:                   } // if (zTopCanopy
 6358:                } // if iveg
 6359: 
 6360:                const double dzz = side->Dz(k + 1);
 6361:                const double tmp = dt*dfz/dzz;
 6362:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6363: 
 6364:                cupp[kin] += cff1*dzz/6.0 - tmp;
 6365:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6366:             }
 6367: 
 6368: 
 6369:             // Second part: layers k-1, k
 6370:             if (k > kb + 1) {
 6371: 
 6372:                double cff1 = 1.0; //init \bar{c^k}
 6373: 
 6374:                if constexpr(iveg != 0) {
 6375:                   // If there is vegetation at this level...
 6376:                   if (zTopCanopy > side->zc[k-1]) {
 6377:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 6378:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 6379: 
 6380:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 6381: 
 6382:                      const double vmag2 = length(ut2);
 6383:                      const double vmag1 = length(side->u2[k-1]);
 6384:                      const double vmag = 0.5*(vmag1 + vmag2);
 6385: 
 6386:                      // Computes the vegetation alpha at the face center
 6387:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 6388:                      cff1 += veg_alpha_sd*dt*vmag;
 6389:                   } // if zTopCanopy
 6390: 
 6391:                } // if iveg
 6392: 
 6393:                const double dzz = side->Dz(k);
 6394:                const double tmp = dt*dfz/dzz;
 6395:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 6396: 
 6397:                alow[kin] += cff1*dzz/6.0 - tmp;
 6398:                bdia[kin] += cff1*dzz/3.0 + tmp;
 6399: 
 6400:             } else { // Bottom boundary
 6401:                // This occurs at the bottom, where the bottom drag is applied.
 6402: 
 6403:                bdia[kin] += dt*side->chi2; // XXXX
 6404: 
 6405:             } // if (k > kb + 1)
 6406: 
 6407: 
 6408:          } // for (int k
 6409: 
 6410: 
 6411: 
 6412:          // Computes the RHS.
 6413:          // -----------------
 6414: 
 6415:          //	BC to be imposed at the end.
 6416: 
 6417:          const Vector2 gradETP  = side->gradETP;
 6418:          const Vector2 gradPr   = side->gradPr;
 6419:          const Vector2 gradEta1 = side->gradEta1;
 6420:          const Vector2 gradEta2 = side->gradEta2;
 6421: 
 6422:          const Vector2 *btu = side->btu;
 6423:          const Vector2 *u2  = side->u2;
 6424:          const double coriolis = side->coriolis;
 6425:          const Vector2 *nuGradU = side->nuGradU;
 6426: 
 6427:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 6428:          for (int k = kb + 1; k < nvrt; k++) {
 6429:             const int kin = k - kb - 1;
 6430: 
 6431:             const double dz_0 = side->Dz(k);
 6432:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 6433: 
 6434:             rrhs[kin] = {0.0, 0.0};
 6435:             double dz = 0.0;
 6436: 
 6437:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 6438:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 6439:             if (k < nvrt  ) dz += dz_1;
 6440:             if (k > kb + 1) dz += dz_0;
 6441: 
 6442:             // Elevation gradient, atmospheric pressure and tidal potential
 6443:             rrhs[kin] = - (0.5*dz)*dt*grad2D;
 6444: 
 6445:             // Coriolis, advection, wind stress, and horizontal viscosity
 6446:             if (k < nvrt - 1) {
 6447: 
 6448: 
 6449:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 6450:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6451:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6452:                                                 
 6453: 
 6454:                //diff stress tensors 1006
 6455:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6456:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6457:                   assert(false && "Not implemented: itur == 5");
 6458:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6459:                }
 6460:                // else assert(false && "itur # Not implemented");
 6461: 
 6462:             } else { // k == nvrt - 1 SURFACE
 6463:                // tau() takes care of the projection to the side frame (ics==1 or ics==2)
 6464:                const Vector2 tau2 = side->tau();
 6465: 
 6466:                rrhs[kin] += dt*tau2;          
 6467: 
 6468:             } // if k<nvrt
 6469: 
 6470: 
 6471:             if (k > kb + 1) {
 6472:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6473:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6474:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6475: 
 6476:                // diff stress tensors 1006
 6477:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6478:                   assert(false && "Not implemented: itur == 5");
 6479:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6480:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6481:                }
 6482:                // else assert(false && "itur # Not implemented");
 6483: 
 6484: 
 6485:             } // if k>kbs + 1
 6486: 
 6487:             // Baroclinic
 6488:             Vector2 *bcc = side->bcc;
 6489:             if constexpr(ibc == 0) {
 6490:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6491:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6492: 
 6493:             } // if ibc==0
 6494: 
 6495:          } // k=kb + 1,nvrt
 6496: 
 6497: 
 6498:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6499: 
 6500:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6501:             const int kin = k - kb - 1;
 6502:    
 6503:             // Velocity is always clamped to maximum values
 6504:             side->u2[k] = clampVelocity(soln[kin]);
 6505:          } // k
 6506: 
 6507:       } // if side->is2D()
 6508:       
 6509: 
 6510:       // Impose velocity boundary condition at the bottom
 6511:       if constexpr(imm == 2) { // 3D bed deformation model
 6512:          double dep;
 6513:          Vector2 vel;
 6514: 
 6515:          assert(false && "Not implemented: imm == 2");
 6516:          //update_bdef(time, x0, y0, dep, vel);
 6517:          // side->u2[kb] = vel;
 6518: 
 6519:       } else { // imm = 0 or 1
 6520:          if (side->Cd() == 0.0) {
 6521:             side->u2[kb] = side->u2[kb + 1];
 6522: 
 6523:          } else if (side->is3D()) { // 3D no slip bottom   
 6524:             side->u2[kb] = {0.0, 0.0};
 6525: 
 6526:          }
 6527:           
 6528:       } // if imm
 6529: 
 6530:       // The velocities below the bottom level are set to zero
 6531:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6532: 
 6533: 
 6534:    }
 6535: 
 6536: 
 6537:    __global__ void applyMomentumBC(void) {
 6538: 
 6539:       SIDE_BND(sideBnd);
 6540: 
 6541:       Side *side = sideBnd->side;
 6542:       const BoundarySegment *segment = sideBnd->segment;
 6543:       const Node *n1 = side->n1;
 6544:       const Node *n2 = side->n2;
 6545: 
 6546:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6547: 
 6548:       const bool isLand = segment->isLand;
 6549:       const int ifltype = segment->ifltype;
 6550: 
 6551:       const int kb = side->kb;
 6552: 
 6553: 
 6554:       if (!isLand && ifltype != 0) {
 6555:          const Vector2 *ubc = sideBnd->ubc;
 6556:   
 6557:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1  XXXX
 6558:             
 6559:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6560:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6561: 
 6562:             if (ifltype == -1) {
 6563:                // Flather 1
 6564: 
 6565:                const double depth = side->depth();
 6566: 
 6567:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6568: 
 6569:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6570: 
 6571:                side->u2[k] = vnorm*side->n;
 6572: 
 6573:             } else if (ifltype == -2) { // Discharge
 6574: 
 6575:                const double eta1 = side->eta1();
 6576:                const double eta2 = side->eta2();
 6577:                const double htot = side->htot2();
 6578: 
 6579:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6580:                assert(false && "Not implemented: Discharge bc");
 6581:                // const double dischrg = discharge(eta1);
 6582:                const double dischrg = 0.0; // XXX REMOVE
 6583:                
 6584: 
 6585:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6586: 
 6587:                const double vnorm = dischrg*eta2/htot;
 6588: 
 6589:                side->u2[k] = vnorm*side->n;
 6590: 
 6591:             }
 6592:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6593:                const double vnorm = dot(side->u2[k], side->n);
 6594: 
 6595:                double rat;
 6596:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6597:                else              rat = segment->vobc2; // outgoing
 6598: 
 6599:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6600: 
 6601:             }
 6602:             else { // not Flather or 3D radiation
 6603:                side->u2[k] = ubc[k];
 6604: 
 6605:             } // if (segment->ifltype...
 6606: 
 6607:          }
 6608: 
 6609:       }
 6610:       else if (isLand) { // if it is land boundary side
 6611: 
 6612:          if constexpr(islip == 0) { // free slip
 6613: 
 6614:             for (int k = kb; k < nvrt; k++) {
 6615: 
 6616:                const Vector2 t = side->t();
 6617:                const Vector2 n = side->n;
 6618: 
 6619:                double vnorm = 0.0; // for most cases
 6620:                const double vtan = dot(side->u2[k], t);
 6621:                
 6622:                side->u2[k] = vtan*t - vnorm*n;
 6623: 
 6624:             }
 6625: 
 6626:          } else { // no slip
 6627:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6628: 
 6629:          }
 6630:       } // if (side segment type...
 6631: 
 6632:    }
 6633: 
 6634: 
 6635:    __global__ void shapiroFilter1(void) {
 6636:       // First step of the Shapiro filter (normally used if indvel<=0)
 6637:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6638: 
 6639:       SIDE(side);
 6640: 
 6641:       // Only internal wet sides are processed
 6642:       if (side->isDry || !(side->isInternal())) return;
 6643: 
 6644:       const int kb = side->kb;
 6645: 
 6646:       for (int mm = 0; mm < niter_shap; mm++) {
 6647: 
 6648:          for (int k = kb + 1; k < nvrt; k++) {
 6649:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6650:             Vector2 suru = {0.0, 0.0};
 6651: 
 6652:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6653: 
 6654:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6655: 
 6656:                int kin = k;
 6657:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6658:                
 6659:                // Get the velocity at the neighbor's side.
 6660:                Vector2 nSideU2 = nSide->u2[kin];
 6661: 
 6662:                // Projects the velocity to the current side frame if needed.
 6663:                if constexpr(ics==2) nSideU2 = nSide->frame.projHorVec(nSideU2, side->frame);
 6664: 
 6665:                suru += nSideU2;
 6666:             }
 6667: 
 6668:             // Reusing bcc as a temporary array to store the suru values.
 6669:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // All in the side frame if ics=2
 6670: 
 6671:          }
 6672:       }
 6673:    }
 6674: 
 6675:    __global__ void shapiroFilter2(void) {
 6676:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6677: 
 6678:       SIDE(side);
 6679: 
 6680: 
 6681:       if (side->isDry || !(side->isInternal())) return;
 6682: 
 6683:       const int kb = side->kb;
 6684: 
 6685:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6686: 
 6687:       if (side->is2D()) {
 6688:          side->u2[kb + 1] = side->bcc[kb + 1];
 6689:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6690: 
 6691:       } else {
 6692:          // 3D
 6693:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6694:          
 6695:       }
 6696: 
 6697:    }
 6698: 
 6699: 
 6700:    __global__ void ul0UpdateZCoords(void) {
 6701:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6702:       
 6703:       NODE(node);      
 6704: 
 6705: 
 6706:       if (false) { //node->isDry) { XXXXXXX
 6707: 
 6708:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6709: 
 6710:          if constexpr(ivcor != 1) node->kb = 0;
 6711: 
 6712:       } else {
 6713: 
 6714:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6715:          node->updateKb();
 6716: 
 6717:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6718: 
 6719:       }
 6720: 
 6721:       // We use the temp.b field to store the previous state of isDry.
 6722:       node->tmp.b = node->isDry;
 6723: 
 6724:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6725:       node->isDry = true;
 6726: 
 6727:    }
 6728: 
 6729:    __global__ void ul0ComputeDryElements(void)
 6730:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6731:    {
 6732:       ELEM(elem);
 6733: 
 6734:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6735: 
 6736:       elem->kb = 0;
 6737: 
 6738:       if (elem->isDry) return;
 6739: 
 6740: 
 6741:    //    if(elem->isDry2()) { // XXXX
 6742:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6743:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6744:    //        call parallel_abort(errmsg)
 6745:    //    }
 6746: 
 6747:       const Node *n1 = elem->nodes[0];
 6748:       const Node *n2 = elem->nodes[1];
 6749:       const Node *n3 = elem->nodes[2];  
 6750:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6751: 
 6752:       // Computes element's kb as the minimum of the nodes' kb.
 6753:       const int kb1 = n1->kb;
 6754:       const int kb2 = n2->kb;
 6755:       const int kb3 = n3->kb;
 6756:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;  // INT_MAX is never used (see below).
 6757: 
 6758: 
 6759:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6760: 
 6761: 
 6762:       // Computes the element z as the mean of the nodes z.
 6763:       for (int k = elem->kb; k < nvrt; k++) {
 6764: 
 6765:          // Compute the element z as the mean of the nodes z.
 6766:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6767:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6768:          elem->z[k] /= elem->i34;
 6769: 
 6770:          assert(k == elem->kb || (elem->z[k] > elem->z[k-1]) && "ivcor = 1: z must increase monotonically");
 6771:       }
 6772:                   
 6773:    }
 6774: 
 6775:    __global__ void ul0ComputeDryNodes(void)
 6776:    // Updates node's isDry based on the elements' isDry. 
 6777:    {
 6778:       NODE(node);
 6779: 
 6780:       node->isDry = true;
 6781: 
 6782:       // A node is wet if at least one of the elements sharing it is wet.
 6783:       for (int j = 0; j < node->numElements; j++) {
 6784:          const Element *elem = node->elements[j];
 6785:          if (!elem->isDry) {
 6786:             node->isDry = false;
 6787:             break;
 6788:          }
 6789:       }
 6790: 
 6791:        
 6792:    }
 6793: 
 6794: 
 6795:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6796:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6797:    // node->tmp.b is true if the node was previously dry.
 6798:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6799:    {
 6800:       NODE(node);
 6801:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6802: 
 6803:       // Avoid this the first time step.
 6804:       if (it == iths) return;  
 6805: 
 6806:       const bool wasDry = node->tmp.b;
 6807: 
 6808: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6809: 
 6810:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6811: 
 6812:          for (int k=0; k < nvrt; k++) {
 6813: 
 6814:             Vector3 utmp={0.0, 0.0, 0.0};
 6815: 
 6816:             double ttmp=0.0;
 6817:             double stmp=0.0;
 6818:             int icount=0;
 6819:             for (int j = 0; j < node->numNodes; j++) {
 6820: 
 6821:                const Node *nbrNode = node->nodes[j];
 6822:                
 6823:                const bool wasNbrDry = nbrNode->tmp.b;
 6824: 
 6825:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6826:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6827: 
 6828:                   icount++;
 6829: 
 6830:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6831:                   utmp += nbrNode->uvw2(k);
 6832:                   
 6833:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6834:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6835:                }
 6836:             }
 6837: 
 6838:             if (icount > 0) {
 6839:                const double inv_icount = 1.0/icount;
 6840:                utmp = inv_icount*utmp;
 6841:                node->u2[k]     = {utmp.x, utmp.y};
 6842:                node->w2[k]     = utmp.z;
 6843:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6844:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6845:             } else {
 6846:                node->u2[k] = {0.0, 0.0};
 6847:                node->w2[k] = 0.0;
 6848:                // Initialize tracers to 0.0??? XXXXX
 6849:             }
 6850:          }
 6851:       }
 6852:    }
 6853: 
 6854:   
 6855:    
 6856: 
 6857: 
 6858:    __global__ void ul0UpdateSides(int it, int iths) {
 6859:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6860:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6861:    // The dryness of the sides is updated in ul0UpdateSides2.
 6862: 
 6863:       SIDE(side);
 6864: 
 6865:       // A side is wet if and only if at least one of its elements is wet.
 6866:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6867:  
 6868:       const Node *n1 = side->n1;
 6869:       const Node *n2 = side->n2;
 6870:      
 6871:       const int kb1 = n1->kb;
 6872:       const int kb2 = n2->kb;
 6873: 
 6874:       side->kb = 0; // default when dry
 6875: 
 6876:       if (isWet) {
 6877: 
 6878:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6879: 
 6880:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6881: 
 6882:          side->kb = min(kb1, kb2);
 6883: 
 6884:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6885: 
 6886:          for (int k = side->kb; k < nvrt; k++) {
 6887:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6888: 
 6889:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6890: 
 6891:             // Compute velocity for re-wetted sides 
 6892:             if ((it != iths) && (side->isDry && isWet)) {
 6893: 
 6894:                Vector2 utmp={0.0, 0.0};
 6895: 
 6896:                int icount=0;
 6897: 
 6898:                // For all the sides on the two elements that share this side
 6899:                for (int j = 0; j < 2; j++) {
 6900:                   const Element *elem = side->elems[j];
 6901:                   if (elem == nullptr) continue;
 6902: 
 6903:                   for (int jj=0; jj < elem->i34; jj++) {
 6904:                      const Side *nSide = elem->sides[jj];
 6905:                      if (nSide->isDry) continue;
 6906: 
 6907:                      icount++;
 6908:                      utmp += nSide->u2[k];  
 6909:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6910:                   }
 6911:                }
 6912:                   
 6913:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6914:                if (icount > 0)  side->u2[k] = utmp/icount;
 6915:                else             side->u2[k] = {0.0, 0.0};
 6916:                   
 6917:             } // if ((it != iths) && (side->isDry && isWet))
 6918: 
 6919:          } // for k
 6920: 
 6921:       } // if isWet 
 6922:       
 6923: 
 6924: 
 6925:    }
 6926: 
 6927:    __global__ void ul0UpdateSides2(void) {
 6928:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6929:    
 6930:          SIDE(side);
 6931:    
 6932:          const Element *e1 = side->elems[0];
 6933:          const Element *e2 = side->elems[1];
 6934: 
 6935:          // A side is wet if and only if at least one of its elements is wet.
 6936:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6937: 
 6938:          // Update the side's dryness
 6939:          side->isDry = !isWet;
 6940: 
 6941:    }
 6942: 
 6943: 
 6944:    __global__ void zeroNodalVelocities(void) {
 6945:       NODE(node);
 6946: 
 6947:       for (int k = 0; k < nvrt; k++) {
 6948:          node->u2[k]   = {0.0, 0.0};
 6949:          node->w2[k]   = 0.0;
 6950:          node->utmp[k] = {0.0, 0.0};         
 6951:       }
 6952:       node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6953:    }
 6954:  
 6955: 
 6956:    __global__ void computeNodalVerticalVelocities1(void) {
 6957:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6958:    // Adds the element's vertical velocity times the element's area.
 6959:       ELEM(elem);
 6960: 
 6961:       for (int j = 0; j < elem->i34; j++) {
 6962:          Node *node = elem->nodes[j];
 6963: 
 6964:          for (int k = node->kb; k < nvrt; k++) {
 6965:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6966:          }
 6967:          atomicAdd(&(node->tmp.d), elem->area);
 6968:       }
 6969:    }
 6970: 
 6971:    __global__ void computeNodalVerticalVelocities2(void) {
 6972:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6973:    // Divides by the total area of the elements sharing the    node.
 6974:       NODE(node);
 6975: 
 6976: 
 6977:       const double invArea = 1.0 / node->tmp.d;
 6978:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = invArea*node->w2[k];  // node->tmp.d contains the total area of the elements sharing the node
 6979: 
 6980:       node->tmp.i = 0; // Reset the temporary integer value. It will be used to compute the number of elements sharing the node.
 6981:    }
 6982: 
 6983: 
 6984:    __global__ void computeNodalHorizontalVelocities1(void) {
 6985: 
 6986:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6987: 
 6988:       ELEM(elem);
 6989: 
 6990:       if (elem->isDry) return;
 6991: 
 6992:       const int kb = elem->kb;
 6993:       const bool isTri = elem->isTri();
 6994: 
 6995:       if constexpr(indvel <= 0) {
 6996:          // Assuming discontinous hvel.
 6997: 
 6998:          if (isTri) { // For triangles
 6999:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 7000:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 7001: 
 7002:             for (int j = 0; j < 3; j++) {
 7003:                // For every node of the triangle...
 7004:                Node *node = elem->nodes[j];
 7005: 
 7006:                if (node->isDry) continue;
 7007: 
 7008:                const Side *s1 = elem->sides[j];  // Side opposite to node j.
 7009:                const Side *s2 = elem->sides[(j + 1) % 3];
 7010:                const Side *s3 = elem->sides[(j + 2) % 3];
 7011: 
 7012:                assert(s1->n1 != node && s1->n2 != node && "s1 must not be connected to node");
 7013: 
 7014:                atomicAdd(&(node->tmp.i), 1);
 7015: 
 7016:                for (int k = kb; k < nvrt; k++)  {
 7017:                   Vector2 s1u2 = s1->u2[k];
 7018:                   Vector2 s2u2 = s2->u2[k];
 7019:                   Vector2 s3u2 = s3->u2[k];
 7020: 
 7021:                   // If ics == 2, project the velocity 2D vectors from the side frame to the element frame
 7022:                   if constexpr(ics == 2) {
 7023:                      s1u2 = s1->frame.projHorVec(s1u2, elem->frame);
 7024:                      s2u2 = s2->frame.projHorVec(s2u2, elem->frame);
 7025:                      s3u2 = s3->frame.projHorVec(s3u2, elem->frame);
 7026:                   }
 7027: 
 7028:                   Vector2 u = s2u2 + s3u2 - s1u2; // u interpolated linearly at node j.   
 7029:                   u = clampVelocity(u);
 7030:                   atomicAdd(&(node->utmp[k].x), u.x);
 7031:                   atomicAdd(&(node->utmp[k].y), u.y);
 7032: 
 7033:                }
 7034: 
 7035:             }
 7036:          }
 7037:          else { // For quads
 7038:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 7039: 
 7040:          }
 7041: 
 7042:       }
 7043:       else assert(false && "computeNodalHorizontalVelocities1: not implemented for indvel > 0");
 7044:       
 7045:    }
 7046: 
 7047: 
 7048:    __global__ void computeNodalHorizontalVelocities2(void) {
 7049:       NODE(node);
 7050: 
 7051:       const int nodeCount = node->tmp.i;
 7052: 
 7053:       if (nodeCount == 0) 
 7054:       {
 7055:          for (int k = 0; k < nvrt; k++) node->u2[k] = {0.0, 0.0};
 7056:          return;
 7057:       }
 7058: 
 7059:       assert(!node->isDry && "computeNodalHorizontalVelocities2: node is dry");
 7060:       
 7061:       const int kb = node->kb;
 7062: 
 7063:       for (int k = 0;  k < kb;   k++) node->u2[k] = {0.0, 0.0};
 7064:       for (int k = kb; k < nvrt; k++) node->u2[k] = node->utmp[k]*(1.0/nodeCount);
 7065:       
 7066:       
 7067:    }   
 7068: 
 7069:  
 7070: 
 7071:    __global__ void resetVelocityOpenBndNodes(void) {
 7072:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 7073: 
 7074:       NODE_BND(nodebnd);
 7075: printf("DDDDDDDDDD\n");
 7076:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 7077:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }  // XXXXXXX
 7078:       }
 7079: 
 7080:    }
 7081: 
 7082: 
 7083:    __global__ void setVelocityOpenBndNodes(void) {
 7084:    // For open boundary nodes sets their velocity to the imposed values.
 7085: 
 7086:       SIDE_BND(sidebnd);
 7087: 
 7088:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 7089:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 7090:          // to its segment to the average of the side velocity.
 7091: 
 7092:          for (int k = 0; k < nvrt; k++) {
 7093:             Node *n1 = sidebnd->side->n1;
 7094:             Node *n2 = sidebnd->side->n2;
 7095: 
 7096: 
 7097:             Vector2 n1_u2(n1->u2[k]);
 7098:             Vector2 n2_u2(n2->u2[k]);
 7099: 
 7100:             if (n1->nodeBnd->segment == sidebnd->segment) {
 7101:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 7102:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 7103:             }
 7104:             if (n2->nodeBnd->segment == sidebnd->segment) {
 7105:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 7106:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 7107:             }
 7108: 
 7109:          }
 7110: 
 7111:       }
 7112: 
 7113:    }
 7114: 
 7115: 
 7116:    __global__ void computeVerticalVelocity(void) {
 7117:       // Computes the vertical velocity at the (2D) element's centroid.
 7118:       // In this function we will be considering volumetric elements, with side faces and a 
 7119:       // bottom and a top face. We will call them SFs, BF and TF.
 7120:       // It computes the flux coming from BF and the SFs.
 7121:       // If the bed is moving, it takes that into account.
 7122:       // Since water is incompressible, the integral of the velocity times the normal vector
 7123:       // along the surface of the prism is zero. In other words, the flux coming from the SFs 
 7124:       // and the BF is equal to the flux going out from the TF.
 7125:       // TF = - BF - sum(SFs).
 7126:       // It then computes the horizontal velocity at the center of TF.
 7127:       // The vertical velocity W_TF at the center of TF is computed by knowing that:
 7128:       //    (U_TF, V_TF, W_TF) = TF*n_TF/area(TF)
 7129:       // where n_TF is the normal vector to TF (3D) and area(TF) is the area of TF (also 3D).
 7130: 
 7131:       ELEM(elem);
 7132: 
 7133:       for (int l = 0; l < nvrt; l++) elem->w[l] = 0.0; 
 7134: 
 7135:       if (elem->isDry) return;
 7136: 
 7137:       const int kb = elem->kb;
 7138:       const bool isTri = elem->isTri();
 7139: 
 7140:       assert(kb >= 0 && "computeVerticalVelocity: wrong kb");
 7141: 
 7142:       // Compute the bottom velocity
 7143:       if constexpr(imm != 0) {
 7144:          assert(false && "computeVerticalVelocity: not implemented yet for imm != 0");
 7145:       }
 7146: 
 7147: 
 7148:       double bottomArea3D;
 7149:       Vector3 elem_bottom_n = elem->n(kb, bottomArea3D); // normal vector to the bottom face of the "volumetric" element (3D)
 7150: 
 7151:       assert(elem_bottom_n.z > 0.0 && "computeVerticalVelocity: elem_bottom_n.z <= 0");
 7152: 
 7153:       double topArea3D;
 7154: 
 7155:       // Bottom face flux
 7156:       double bottomFlux = 0.0;
 7157:       Vector2 u2meanBottom = {0.0, 0.0};
 7158:       const Vector2 gradh = elem->grad2(&Node::depth);
 7159:       if constexpr(imm==2) {
 7160:          Vector3 ubed;
 7161: 
 7162:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 7163:          // updateBDEF(ubed);
 7164:      
 7165:          // const double bflux0 = dot(ubed, elem_bottom_n);
 7166: 
 7167:          // elem->w[kb] += ubed.z;
 7168:       }
 7169:       else {
 7170: 
 7171:          u2meanBottom = elem->mean(kb, &Side::u2Bottom);  // The mean computation includes the projection to the element frame if ics=2
 7172:   
 7173:          // Computes the vertical velocity such that a horizontal velocity of u2meanBottom has the same slope as the bed
 7174:          // in the direction of motion.
 7175:          const double bottomW = - dot(gradh, u2meanBottom);  
 7176:          // Error: /=0 for 2D (but OK b/cos fluxes are 0 below for transport)  XXXXX
 7177: 
 7178:          // VElocity associated to the bed deformation
 7179:          double bedVelocity = 0.0;
 7180:          if constexpr(imm == 1) assert (false && "computeVerticalVelocity: not implemented for imm==1"); //bedVelocity = (av_bdef2 - av_bdef1)/dt;
 7181: 
 7182:          elem->w[kb] = bedVelocity + bottomW; 
 7183: 
 7184:          bottomFlux = 0.0;  // No flux from the bed face. XXXX
 7185:          
 7186:       } // if imm
 7187: 
 7188:       // Compute w for kb+1 to nvrt-1
 7189:       for (int l = kb; l < nvrt - 1; l++) {
 7190: 
 7191:          // normal vector to the top face of the "volumetric" element (3D)
 7192:          Vector3 elem_top_n = elem->n(l + 1, topArea3D);  // Get the normal vector and the area of the top face (as a 3D surface)
 7193: 
 7194:          assert(topArea3D > 0.0 && "computeVerticalVelocity: topArea3D <= 0");
 7195:          assert(elem_top_n.z > 0.0 && "computeVerticalVelocity: elem_top_n.z >= 0");
 7196: 
 7197:          // Compute the total flux at the sides
 7198:          double sideFlux = 0.0;
 7199: 
 7200:          for (int j = 0; j < elem->i34; j++) {
 7201:             const Side *side = elem->sides[j];
 7202:             const int kbs = side->kb;
 7203:             const Vector2 u2_top = side->u2[max(l + 1, kbs)];
 7204:             const Vector2 u2_bot = side->u2[max(l,     kbs)];
 7205:             Vector2 u2c = 0.5*(u2_top + u2_bot); // velocity at the center of the side
 7206: 
 7207:             // The area is "clamped" meaning that it takes kb into account.
 7208:             const double sideArea = side->areaClamped(l);
 7209: 
 7210:             const double sign = elem->ssign[j]; 
 7211: 
 7212:             // sign is positive if the side is oriented in the direction of the normal vector to the element, negative otherwise
 7213:             sideFlux += sign*dot(u2c, side->n)*sideArea;
 7214:          }
 7215:          
 7216:          // Compute the horizontal velocity at the center of the top face as an average of the 
 7217:          // velocities at the centers of the sides (takes into account the projection to the element frame if ics=2)
 7218:          const Vector2 u2meanTop = elem->mean(l + 1, &Side::u2); 
 7219: 
 7220:          // The flux at the top ace can be computed from the other flows.
 7221:          // All fluxes are in directions into the prism.
 7222:          const double topFlux = - sideFlux - bottomFlux;
 7223: 
 7224:          // Flux at the top face due to the horizontal velocities only
 7225:          // topFlux = topHorizontalFlux + topVerticalFlux
 7226:          const double topHorizontalFlux = dot(u2meanTop, toVector2(elem_top_n))*topArea3D; // Part of the flux related to the horizontal velocity
 7227: 
 7228:          // From the flux balance, (topVerticalFlux + topHorizontalFlux) + sideFlux + bottomFlux = 0, so:
 7229:          const double topVerticalFlux = topFlux - topHorizontalFlux;  
 7230: 
 7231:          elem->w[l + 1] = topVerticalFlux/(elem_top_n.z*topArea3D);
 7232: 
 7233:          bottomFlux = -topFlux;
 7234:          
 7235:       }
 7236: 
 7237:    }  
 7238: 
 7239: 
 7240: 
 7241: 
 7242: 
 7243: 
 7244: 
