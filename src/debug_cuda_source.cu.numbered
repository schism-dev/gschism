 8715:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 8716:       //    *sizeType = sizeof(Vector2);
 8717:       //    break;   
 8718:       case (int)VarCode::hhat:
 8719:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 8720:          *sizeType = sizeof(Vector2);
 8721:          break;      
 8722:       case (int)VarCode::chi:
 8723:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 8724:          *sizeType = sizeof(double);
 8725:          break;
 8726:       case (int)VarCode::n1:
 8727:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 8728:          *sizeType = sizeof(Node);
 8729:          break;
 8730:       case (int)VarCode::n2:
 8731:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 8732:          *sizeType = sizeof(Node);
 8733:          break;                   
 8734:       default:
 8735:          *offset = -1;
 8736:    }
 8737: }
 8738: 
 8739: 
 8740: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8741:    Node *nodes = mesh->localNodeData;
 8742: 
 8743:    *addr = nodes;
 8744:    *sizeNode = sizeof(Node);
 8745: 
 8746:    switch (varCode) {
 8747:       case (int)VarCode::depth:
 8748:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8749:          *sizeType = sizeof(double);
 8750:          break;
 8751:       case (int)VarCode::eta:
 8752:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8753:          *sizeType = sizeof(double);
 8754:          break;
 8755:       case (int)VarCode::x:
 8756:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8757:          *sizeType = sizeof(Vector2);
 8758:          break;
 8759:       case (int)VarCode::z:
 8760:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8761:          *sizeType = sizeof(double);
 8762:          break;
 8763:       case (int)VarCode::kb:
 8764:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8765:          *sizeType = sizeof(int);
 8766:          break;
 8767:       case (int)VarCode::isdry:
 8768:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8769:          *sizeType = sizeof(int);
 8770:          break;         
 8771:       case (int)VarCode::w:
 8772:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8773:          *sizeType = sizeof(double);
 8774:          break;
 8775:       case (int)VarCode::u:
 8776:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8777:          *sizeType = sizeof(Vector2);
 8778:          break;  
 8779:       case (int)VarCode::u_air:
 8780:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8781:          *sizeType = sizeof(Vector2);
 8782:          break;
 8783:       default:
 8784:          *offset = -1;    
 8785:    }  
 8786:    
 8787: }
