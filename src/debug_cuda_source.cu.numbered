  289: // Polynomial class
  290: template<int grade>
  291: struct Polynomial {
  292:     // Static assertion to give a clear error message at compile time
  293:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  294: };
  295: 
  296: 
  297: // Explicit specialization for grade 4
  298: template<>
  299: struct Polynomial<4> {
  300:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  301: 
  302:    // Constructor from coefficients
  303:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  304: 
  305:    __device__ __forceinline__ double eval(double x) const {
  306:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  307:    }
  308: };
