 2399: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2400:    if constexpr(ics == 1)  {
 2401:       return center;
 2402: 
 2403:    } else {
 2404:       const Point2 p0 = nodes[0]->outputCoords();
 2405:       const Point2 p1 = nodes[1]->outputCoords();
 2406:       const Point2 p2 = nodes[2]->outputCoords();
 2407: 
 2408:       if (isTri()) {
 2409:          return (1.0/3.0)*(p0 + p1 + p2);
 2410: 
 2411:       } else {
 2412:          const Point2 p3 = nodes[3]->outputCoords();
 2413:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2414:       }
 2415: 
 2416:    }
 2417: }
