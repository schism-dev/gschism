 1100: struct Node {
 1101: 
 1102:    // Geometry information
 1103:    int idx;        // Index of the node
 1104:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1105:    int numNodes;   // Number of nodes neighbors of this node
 1106: 
 1107:    Element **elements; // Array of pointers to the elements that share this node
 1108:    int numElements;    // Number of elements that share this node
 1109: 
 1110:    int numSides;       // Number of sides that are connected to this node
 1111: 
 1112:    Point3 p;
 1113:    Vector3 u2[nvrt];
 1114:    double z[nvrt];
 1115:    double lon, lat;
 1116:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1117:    double depth;
 1118: 
 1119:    int kb;       // Bottom index of the node
 1120: 
 1121:    bool isDry;     // True if the node is dry
 1122: 
 1123:    int iadv;     // Advection flag
 1124: 
 1125:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1126:                           // this is nullptr
 1127: 
 1128:    TempVar tmp; // Temporary variable to store different types of variables
 1129: 
 1130:    // Physical information
 1131:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1132:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1133: 
 1134:    double rho[nvrt];     // Density
 1135:    double dfv[nvrt];     // Vertical viscosity
 1136: 
 1137:    double eta1; // Elevation at nodes at previous timestep
 1138:    double eta2; // Elevation at nodes at current timestep
 1139: 
 1140:    double ETP;  // Earth Tidal Potential
 1141: 
 1142:    double pr;    // Air pressure
 1143:    double grav2; // Gravity 
 1144:    
 1145:    Vector2 dav;  // Depth averaged velocity
 1146: 
 1147:    Vector2 tau; // Wind stress vector
 1148: 
 1149:    // Vegetation parameters
 1150:    double veg_h;
 1151:    double veg_nv;
 1152:    double veg_di;
 1153:    double veg_Cd;
 1154:    double veg_h_unbent;
 1155:    double veg_di_unbent;
 1156:    double veg_nv_unbent;
 1157:    double veg_alpha_vert_mean;
 1158:    double veg_alpha0;
 1159:    double veg_alpha3D[nvrt];
 1160: 
 1161:    // Bottom drag parameters
 1162:    double Cd;       // Bottom drag coefficient
 1163:    double rough;    // Bottom roughness length
 1164:    Vector2 tau_bot; // Bottom stress vector
 1165: 
 1166:    double bdef1; // Bottom deformation at previous timestep
 1167:    double bdef2; // Bottom deformation at current timestep
 1168: 
 1169:    double qel; // RHS
 1170:    double coeffDiag; // Diagonal coefficient of the matrix
 1171:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1172: 
 1173:    double mP; // Search direction for conjugate gradient method
 1174:    double mR; // Residual for conjugate gradient method
 1175:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1176:    double mX; // Solution for conjugate gradient method
 1177: 
 1178:    // Meteorological forcing
 1179:    Vector2 u_air;
 1180:    double p_air;
 1181:    double t_air;
 1182:    double q_air;
 1183:    double wind_angle;  // Wind rotation angle
 1184: 
 1185:    __device__ void setWind(Vector2 &u) {
 1186:    // Sets the wind vector taking into account the wind rotation angle
 1187:    
 1188:       const double dir = atan2(-u.x,-u.y);
 1189:       const double speed = length(u);
 1190: 
 1191:       // Calculate new u and v components with added rotation angle
 1192:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1193:    }
 1194: 
 1195:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1196:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1197: 
 1198:    __device__ double sigmaTransitionDepth(void) const;
 1199: 
 1200:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1201:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1202:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1203: 
 1204:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1205: 
 1206:    __device__ void clearMatrixRow(void) {
 1207:       // Clear the matrix row for this node
 1208:       coeffDiag = 0.0;
 1209:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1210: 
 1211:    }
 1212: 
 1213:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1214:       // Add the value to the sparse matrix for this node
 1215:       
 1216:       if (node == this) {
 1217:          coeffDiag += value;
 1218: printf("addToSparseMatrix: node == this, value = %f\n", coeffDiag);         
 1219:       } else {
 1220:          // Search (linearly)the index of the node in the array of nodes
 1221:          // XXX: This is not efficient, see if we can improve this
 1222:          int i;
 1223:          for (i = 0; i < numNodes; i++) {
 1224:             if (nodes[i] == node) {
 1225:                break;
 1226:             }
 1227:          }
 1228:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1229:          coeffMatrix[i] += value;
 1230:       }
 1231:    }
 1232: 
 1233: #ifdef BACKTRACKING
 1234:    __device__ void updateZCoordData() {
 1235:    // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 1236: 
 1237:       // Check if node is wet
 1238:       isDry = (depth + eta2 <= h0);  // XXX Check if we are doing this elsewhere
 1239: 
 1240:       if (idry) return;
 1241: 
 1242:       if constexpr(ivcor == 2) {  // SZ coordinates
 1243:          
 1244:          // Compute bottom level index
 1245:          if (depth <= mesh->h_s) {
 1246:                kb = mesh->nzlevels;
 1247:          } else {
 1248:                kb = -1;
 1249:                for (int i = 0; i < mesh->kz-1; i++) {
 1250:                   if (-depth >= mesh->ztot[i] && -depth < mesh->ztot[i+1]) {
 1251:                      kb = i;
 1252:                      break;
 1253:                   }
 1254:                }
 1255:          }
 1256:       } 
 1257:       else if (ivcor == 1) {  // Localized sigma
 1258:          // Do nothing
 1259:       }
 1260: 
 1261:    }
 1262: #endif   
 1263: 
 1264:    __device__ double compZCoord(int k) const;
 1265: 
 1266:    __device__ void updateKb(void);
 1267: 
 1268: 
 1269: 
 1270: };
