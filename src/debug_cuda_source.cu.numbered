 5197:    __global__ void computeVerticallyIntegratedVelocity(void) {
 5198: 
 5199:       SIDE(side);
 5200: 
 5201:       side->U = {0.0, 0.0}; 
 5202:          
 5203:       if(side->isDry) return;
 5204: 
 5205:       // Vertically integrated velocity U (in ll if ics=2)
 5206:       for (int k = side->kb; k < nvrt - 1; k++) { 
 5207:          const Vector2 uc = 0.5*(side->u2[k] + side->u2[k + 1]);
 5208:          side->U += side->Dz(k + 1)*uc;  
 5209:       }
 5210: 
 5211:    }
 5212: 
 5213:    __global__ void computeBottomDragVegetation(void) {
 5214:       // UNFINISHED. CHECK THIS:
 5215:       // How many kernels are needed? Why so many for loops?
 5216:       // Is the loop on sides needed?
 5217: 
 5218:       NODE(node);
 5219: 
 5220: 
 5221:       const int    kb      = node->kb;
 5222:       const double htot    = node->htot2(); 
 5223:       
 5224:       if (node->isDry) {
 5225:          // Default values for dry nodes
 5226:          node->veg_alpha_vert_mean = node->veg_alpha0;
 5227:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 5228: 
 5229:          return;
 5230:        
 5231:       }
 5232: 
 5233:       // Computes bottom drag Cd based on the selected nchi
 5234:       node->computeBottomDragCd();
 5235:       
 5236: 
 5237: 
 5238:       //   Bottom stress in m^2/s^2
 5239:       if (node->rho[kb + 1] >= -98.0)
 5240:       {
 5241:          const double mag_u = length(node->u2[kb + 1]);
 5242:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 5243: 
 5244:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 5245:          // !sediment erosion: this part needs more documentation
 5246:       }
 5247:     
 5248: 
 5249: 
 5250:       // Compute vegetation parameters
 5251:       //--------------------------------
 5252: 
 5253:       // SAV constants
 5254:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 5255:       constexpr double veg_cfpsi = 0.16;
 5256: 
 5257:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 5258:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 5259: 
 5260:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 5261:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 5262:          int kbin = 0; // bin index
 5263:          for (int k = kb; k < nvrt; k++) {
 5264:             // Computes node height above the bottom level
 5265:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 5266:             assert(false && "Vertical variation of vegetation not implemented");
 5267: 
 5268:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 5269:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 5270:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 5271:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 5272:             // } else {
 5273:             //    // Find the bin at which the current vertical level is
 5274:             //    while (kbin<nbins_veg_vert) {
 5275:             //       const double zn = node->z[kbin];
 5276:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 5277:             //          break;
 5278:             //       } // if
 5279:             //       kbin++;
 5280:             //    } // while
 5281:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 5282: 
 5283:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 5284:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 5285:                
 5286:             //    // Linear interpolation of the vegetation parameters
 5287:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 5288:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 5289:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 5290:             // } // if rl10
 5291: 
 5292:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 5293: 
 5294:          } // for k
 5295: 
 5296: 
 5297:       } else { // Ganthy (iveg==2)
 5298:       //  Modify canopy height, diameter, and density
 5299: 
 5300:          // Make sure there is vegetation on this node
 5301:          if (node->veg_h_unbent > 0.0) {
 5302:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 5303: 
 5304:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 5305:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 5306:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 5307: 
 5308:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 5309:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 5310:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 5311:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 5312:          } // if veg_h_unbent
 5313: 
 5314:          for (int k = 0; k < nvrt; k++) {
 5315:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 5316:          } // for k
 5317:       
 5318: 
 5319:       } // if iveg
 5320:      
 5321: 
 5322:       // Compute vertical mean of veg_alpha3D
 5323:       if (iveg != 0) {
 5324:          const double ztop = node->zTopCanopy(); // Top of the canopy
 5325:          double sum1=0.0;
 5326:          double sum2=0.0;
 5327:          // Integrate over each level under the canopy...
 5328:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 5329:             const double Dz = node->Dz(k);
 5330: 
 5331:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 5332:             sum2 += Dz;
 5333: 
 5334:          } // for k
 5335:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 5336:          else             node->veg_alpha_vert_mean = sum1/sum2;
 5337: 
 5338:       } // if iveg
 5339: 
 5340:    }
 5341: 
 5342:    __global__ void computeVegetationAndDragParameters(void) {
 5343:       // Computes the vegetation and drag model parameters:
 5344:       // chi, \tilde\chi, beta, \breve{H}
 5345:       
 5346:       SIDE(side);
 5347: 
 5348:       side->hhat = 0.0;
 5349:       side->chi2 = 0.0;
 5350:       side->chi = 0.0;
 5351:       side->veg_c2 = 0.0;
 5352:       side->veg_beta = 0.0;
 5353: 
 5354:       if (side->isDry) return;
 5355: 
 5356:       const double htot = side->htot2();
 5357:       const int    kb   = side->kb;
 5358: 
 5359:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 5360: 
 5361:       const double veg_h     = side->veg_h();
 5362:       const double veg_nv    = side->veg_nv();
 5363:       const double veg_c     = side->veg_c();
 5364:       const double veg_beta  = side->veg_beta;
 5365:       const double veg_alpha = side->veg_alpha_vert_mean();
 5366: 
 5367:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 5368:       // Velocity magnitude at the bottom level
 5369:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 5370:       const double vmag1 = length(side->btu[kb + 1]); //Backtracked velocity at the bottom level
 5371:       side->chi2 = side->Cd()*vmag1;
 5372:       side->chi  = side->chi2;
 5373:       if constexpr(iveg != 0) {
 5374:          const Node *n1 = side->n1;
 5375:          const Node *n2 = side->n2;
 5376:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 5377:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 5378:       }
 5379: 
 5380:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 5381: 
 5382:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 5383:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 5384:       double magUa = 0.0;
 5385:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 5386:          // 3D wet side with veg...
 5387: 
 5388:          double magUa = 0.0;
 5389:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 5390:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 5391: 
 5392:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 5393:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 5394:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 5395: 
 5396:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 5397:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 5398: 
 5399:                // Velocity magnitude at the bottom (l) of the level
 5400:                const double ul = length(side->u2[k]);
 5401: 
 5402:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 5403:                magUa += Dz*0.5*(uh + ul);
 5404: 
 5405:             } // if HasVegetation
 5406:          } // for k
 5407:          const double ua = magUa/min(htot, veg_h); // Vertical average
 5408: 
 5409:          // Computes beta, used for computing the stress term at the top of the canopy.      
 5410:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 5411:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 5412:             const double zCpy = side->zTopCanopy();
 5413:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 5414:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 5415:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 5416:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 5417:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 5418:          } // if isSubmerged
 5419:       } // if iveg   
 5420: 
 5421:       // Computes the friction modified depth, \breve{H} in notes
 5422:       if (side->is2D()) { // 2D
 5423: 
 5424:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5425:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5426: 
 5427:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5428: 
 5429:          side->hhat = htot*htot/fricH; 
 5430: 
 5431:       } else { // 3D
 5432:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes  
 5433: 
 5434:          if constexpr(iveg != 0) {
 5435:             
 5436:             if (side->isSubmerged()) { 
 5437:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5438:                side->hhat -= veg_c*Hhat_alpha;
 5439: 
 5440:             } else { // Emergent
 5441:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5442:             }
 5443:          } // if iveg
 5444: 
 5445:          // Enforce positivity for 3D model
 5446:          if constexpr(ihhat == 1) side->hhat = max(0.0, side->hhat);
 5447:       } // if 3D
 5448: 
 5449:    }
 5450: 
 5451: 
 5452: 
 5453:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5454:    // Computes the density gradient between two elements, e1 and e2.
 5455:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5456:    // zero in the direction normal to the side. 
 5457:    // 
 5458:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5459:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5460:    //
 5461:    // Input:
 5462:    //    e1: Element
 5463:    //    e2: Neighbor element (or nullptr if boundary)
 5464:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5465:    //    k: Index of the half-level at which the density is interpolated
 5466:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5467:    // 
 5468:    // Output:
 5469:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5470:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5471: 
 5472:       if (e2 == nullptr || e2->isDry) {
 5473:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5474: 
 5475:          Side *side = e1->sides[j];
 5476:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5477:                  
 5478:          if constexpr(ics == 1) {
 5479:             vec = side->n; // Normal vector to the side
 5480:          } else {
 5481:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5482:             // IMPLEMENT THIS XXXXXX
 5483:             // !replace with xel, yel?
 5484:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5485:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5486:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5487:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5488:          } //ics
 5489:                    
 5490:          diffRho = 0.0;
 5491: 
 5492:       } else { //internal and wet
 5493:          if constexpr(ics==1) {
 5494:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5495: 
 5496:             // Vector from e1 to e2
 5497:             vec = e2->center - e1->center;
 5498: 
 5499:          } else { 
 5500:             assert(false && "getRhoDiffAndVec: lat/lon not implemented");
 5501:             // IMPLEMENT THIS XXXXXX
 5502:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5503:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5504:             //                   alow(j)=xctr2
 5505:             //                   bdia(j)=yctr2
 5506:          } // ics
 5507: 
 5508:          diffRho = rho2 - e1->demeanedDensity(k);
 5509:       }
 5510: 
 5511:    }
 5512: 
 5513:    __global__ void computeDensityCubicSplines(void) {
 5514:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5515: 
 5516:       ELEM(elem);
 5517: 
 5518:       if (elem->isDry) return;
 5519: 
 5520:       const int kb = elem->kb;
 5521: 
 5522:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5523:       if (elem->is2D()) {
 5524:          // In the 2D case, the density is constant at the prism level. 
 5525:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5526:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5527:       } else { //3D
 5528: 
 5529:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5530:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5531:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5532:          ///// XXXX CHECK INDICES!!!!!
 5533:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5534:       } // 2D/3D
 5535: 
 5536:    }
 5537: } // extern "C"
 5538: 
 5539: 
 5540: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5541: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5542: 
 5543:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5544: 
 5545:    const int kb  = elem->kb;
 5546:    const int kb2 = elem2->kb;
 5547: 
 5548:    // z-coordinate of prism of elem
 5549:    const double zp = elem->z_prism(k);
 5550: 
 5551:    double rho = 0.0;
 5552: 
 5553:    if (elem2->is2D()) {
 5554:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5555: 
 5556:    } else {  // 3D
 5557: 
 5558:       // eta_min may be < zmax
 5559:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5560:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5561: 
 5562:       // (Extrapolate density below bottom, we will fix it later)
 5563:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5564:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5565:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5566:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5567:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5568:    } // 2D/3D
 5569:      
 5570: 
 5571:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5572:    // Now we need to fix it.
 5573:    if (elem->z[k] < elem2->z[kb2]) {
 5574:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5575: 
 5576:       // There are two methods to adjust the density at the bottom of the element.
 5577:       // iunder_deep=0: 
 5578:       const double depth1 = abs(elem->z[kb]); // larger depth
 5579: 
 5580:       if (iunder_deep==0) {
 5581: 
 5582:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5583: 
 5584:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5585: 
 5586:       } else { // iunder_deep != 0
 5587: 
 5588:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5589: 
 5590:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5591: 
 5592:          //   Demeaned density at the same z coordinate as
 5593:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5594:          }
 5595: 
 5596:       } // if iunder_deep
 5597:    } // if elem->z[kb] < elem2->z[kb]
 5598: 
 5599:    return rho;
 5600: }
 5601: 
 5602: 
 5603: extern "C" {
 5604:    __global__ void computeDensityGradient(void) {
 5605: 
 5606:       if constexpr(ibc != 0) return;
 5607: 
 5608:          // Compute the horizontal density gradient at each element.
 5609:       // It works in two steps:
 5610:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5611:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5612:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5613:       //             gradRho.r1 = rho1 - rho0
 5614:       //             gradRho.r2 = rho2 - rho0
 5615:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5616:       // 
 5617:       //  NOTE: We use de-meaned densities.
 5618: 
 5619:       ELEM(elem);
 5620: 
 5621:       if (elem->isDry) return;
 5622: 
 5623:       const int kb  = elem->kb;
 5624:       const int i34 = elem->i34;
 5625: 
 5626:       for (int k = kb + 1; k < nvrt; k++) {
 5627:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5628:          //             gradRho.r1 = rho1 - rho0
 5629:          //             gradRho.r2 = rho2 - rho0
 5630:          int icount = 0;
 5631:          double sumRx = 0.0;
 5632:          double sumRy = 0.0;
 5633:          for (int j1=0; j1<i34; j1++) { 
 5634: 
 5635:             const int j2 = elem->nxq(j1 + 1);
 5636: 
 5637:             // Pairs of consecutive neighbor elements of elem
 5638:             const Element *e1 = elem->nghbElems[j1];
 5639:             const Element *e2 = elem->nghbElems[j2];
 5640: 
 5641:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5642:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5643:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5644: 
 5645:             // Compute the density difference and the vector from elem to e1 and e2
 5646:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5647:             double diffRho1, diffRho2;
 5648:             Vector2 vec1, vec2;
 5649:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5650:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5651: 
 5652:             const double rl1 = length(vec1);
 5653:             const double rl2 = length(vec2);
 5654:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5655: 
 5656:             const double delta = cross(vec1, vec2);
 5657:             const double sintheta = abs(delta)/(rl1*rl2);
 5658: 
 5659:             // To avoid problems, avoid elements with small angle between vectors
 5660:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5661:             const bool validEq = (sintheta > sin_one_deg);
 5662: 
 5663:             if (validEq) {
 5664:                // Solve the system of equations to get the density gradient at elem
 5665:                icount++;
 5666:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5667:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5668:                sumRx += Rx;
 5669:                sumRy += Ry;
 5670:             }
 5671:          } // for j1
 5672: 
 5673:          // Compute the average density gradient at elem
 5674:          if (icount==0) {
 5675:            // Bad mesh quality; bail out with 0 b-cc
 5676:            elem->gradRho[k] = {0.0, 0.0};
 5677:          } else {
 5678:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5679:          }
 5680: 
 5681:       } // for k
 5682: 
 5683:    }
 5684: 
 5685:    __global__ void computeBaroclinicTerm(void) {
 5686:    // Computes the baroclinic term at sides (at half levels).
 5687:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5688:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5689: 
 5690:       if (ibc == 1) return;
 5691: 
 5692:       SIDE(side);
 5693: 
 5694:       if (side->isDry) return;
 5695: 
 5696:       const Element *e1 = side->elems[0];
 5697:       const Element *e2 = side->elems[1];      
 5698:       const int kb = side->kb;
 5699:       
 5700:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5701: 
 5702:       // interpolates vertically the density gradient of the two elements at the half level/
 5703: 
 5704:       int k1 = max(kb, nvrt / 2);
 5705:       int k2 = max(kb, nvrt / 2);
 5706: 
 5707:       // Starts the integration at the surface and goes down to the bottom
 5708:       side->bcc[nvrt-1] = {0.0, 0.0};
 5709:       for (int k = nvrt - 2; k >= kb; k--) {
 5710:       // For each prism level (from surface to bottom)...
 5711: 
 5712:          // For both elements, interpolate density gradient at the side's half level.
 5713:          // The gradient at the side is the average of the gradients at the elements.
 5714:          // w1, w2 are used to take into account boundary sides, with just one element.
 5715:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5716:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5717:          const double wsum = w1 + w2;
 5718:          w1 = w1/wsum;
 5719:          w2 = w2/wsum;
 5720:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5721: 
 5722:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5723:          Vector2 gradRho = {0.0, 0.0};
 5724:          if (e1 != nullptr && k > kb) {
 5725:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5726:             
 5727:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5728:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5729:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5730: 
 5731:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5732:          }      
 5733:          if (e2 != nullptr && k > kb) {
 5734:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5735:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5736:             
 5737:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5738:          }
 5739: 
 5740:          if constexpr(ics==2) {
 5741:             assert(false && "Not implemented: ics == 2");
 5742:             // IMPLEMENT THIS XXXXXX
 5743:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5744:             // swild(1)=tmp1
 5745:             // swild(2)=tmp2
 5746:          }
 5747:          
 5748:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5749:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5750:          // CHECK INDICES!!! XXX
 5751:          const double grav3 = side->grav3();
 5752:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5753: 
 5754:       } // for
 5755: 
 5756:    }
 5757: 
 5758: 
 5759: 
 5760:    __global__ void computeHorGradientAtSide(void) {
 5761: 
 5762:       // Compute the horizontal density gradient at each element.
 5763:       // It works in two steps:
 5764:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5765:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5766:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5767:       //             gradRho.r1 = rho1 - rho0
 5768:       //             gradRho.r2 = rho2 - rho0
 5769:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5770:       // 
 5771:       //  NOTE: We use de-meaned densities.
 5772: 
 5773:       SIDE(side);
 5774: 
 5775: 
 5776:       if (side->isDry) return;
 5777: 
 5778:       // Computes the gradient of the variables at the side center.
 5779:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5780:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5781:       auto isWet3 = [](const Element* e) { return (e->depth >= tip_dp) && !(e->isDry); };
 5782: 
 5783:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5784:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5785:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5786:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5787: 
 5788:    }
 5789: 
 5790: 
 5791:    __global__ void solveMomentumEquations(double time) {
 5792: 
 5793:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5794:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5795: 
 5796:       SIDE(side);
 5797: 
 5798:       if (side->isDry) 
 5799:       {
 5800:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};       // WHY {0,0}? Shouldn't be just the normal component?  The FORTRAN code also uses {0,0}  in line ~6462   
 5801: 
 5802:          return;
 5803:       }
 5804: 
 5805:       const Node *n1 = side->n1;
 5806:       const Node *n2 = side->n2;
 5807: 
 5808:       const int kb = side->kb;
 5809: 
 5810:       const double veg_h = side->veg_h();
 5811:       const double grav3 = side->grav3();
 5812: 
 5813:       if (side->is2D()) {
 5814:          // Remember: Do not use htot2, which is updated.
 5815:          const double htot = side->htot1();
 5816:          const double hhat = side->hhat;
 5817: 
 5818:          assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5819: 
 5820:          Vector2 tau2 = {0.0, 0.0};
 5821:           
 5822:          if constexpr(ics==1) {
 5823:             tau2 = side->tau();
 5824: 
 5825:          } else {
 5826:             assert(false && "Not implemented: ics == 2");
 5827:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5828:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5829:             // taux2=(vn1+tt1)*0.5d0
 5830:             // tauy2=(vn2+ss1)*0.5d0
 5831:          } // if ics         
 5832: 
 5833:          // hat_gam has units of m/s
 5834: 
 5835:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5836:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5837:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5838: 
 5839:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5840: 
 5841: 
 5842:          const Vector2 vel = clampVelocity(hat_gam*hhat/htot);
 5843: 
 5844:          for (int k = 0; k < nvrt; k++) side->u2[k] = vel;
 5845: 
 5846:       }
 5847:       else { // 3D
 5848: 
 5849:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5850:          // 
 5851:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5852:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5853:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5854:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5855:          // k+1 and k.
 5856: 
 5857: 
 5858:          const int ndim = nvrt - kb;
 5859:          const double zTopCanopy = side->zTopCanopy();
 5860: 
 5861:          // Initialize the tridiagonal system
 5862:          for (int k = kb + 1; k < nvrt; k++) {
 5863:             
 5864:             const int kin = k - (kb + 1);
 5865: 
 5866:             // Vertical viscosity at the face center
 5867:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); // Vertical average.
 5868: 
 5869:  
 5870:             alow[kin] = 0.0;
 5871:             cupp[kin] = 0.0;
 5872:             bdia[kin] = 0.0;
 5873: 
 5874:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5875:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5876: 
 5877:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5878:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5879:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5880: 
 5881:             // First part: layers k, k+1
 5882:             if (k < nvrt - 1) {
 5883:                              
 5884:                if constexpr(iveg != 0) {
 5885: 
 5886:                   // If there is vegetation at this level...
 5887:                   if (zTopCanopy > side->zc[k]) {
 5888:                      // If the canopy is above the k layer...
 5889:                      
 5890:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5891:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5892:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5893:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5894: 
 5895:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5896:                      const double vmag2 = length(ut2);
 5897:                      const double vmag1 = length(side->u2[k]);
 5898:                      const double vmag = 0.5*(vmag1 + vmag2);
 5899:                      
 5900:                      // Computes the vegetation alpha at the face center
 5901:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5902: 
 5903:                      cff1 += veg_alpha_sd*dt*vmag;
 5904: 
 5905:                   } // if (zTopCanopy
 5906:                } // if iveg
 5907: 
 5908:                const double dzz = side->Dz(k + 1);
 5909:                const double tmp = dt*dfz/dzz;
 5910:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5911: 
 5912:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5913:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5914:             }
 5915: 
 5916: 
 5917:             // Second part: layers k-1, k
 5918:             if (k > kb + 1) {
 5919: 
 5920:                double cff1 = 1.0; //init \bar{c^k}
 5921: 
 5922:                if constexpr(iveg != 0) {
 5923:                   // If there is vegetation at this level...
 5924:                   if (zTopCanopy > side->zc[k-1]) {
 5925:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5926:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5927: 
 5928:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5929: 
 5930:                      const double vmag2 = length(ut2);
 5931:                      const double vmag1 = length(side->u2[k-1]);
 5932:                      const double vmag = 0.5*(vmag1 + vmag2);
 5933: 
 5934:                      // Computes the vegetation alpha at the face center
 5935:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5936:                      cff1 += veg_alpha_sd*dt*vmag;
 5937:                   } // if zTopCanopy
 5938: 
 5939:                } // if iveg
 5940: 
 5941:                const double dzz = side->Dz(k);
 5942:                const double tmp = dt*dfz/dzz;
 5943:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5944: 
 5945:                alow[kin] += cff1*dzz/6.0 - tmp;
 5946:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5947: 
 5948:             } else { // Bottom boundary
 5949:                // This occurs at the bottom, where the bottom drag is applied.
 5950: 
 5951:                bdia[kin] += dt*side->chi2; // XXXX
 5952: 
 5953:             } // if (k > kb + 1)
 5954: 
 5955: 
 5956:          } // for (int k
 5957: 
 5958: 
 5959: 
 5960:          // Computes the RHS.
 5961:          // -----------------
 5962: 
 5963:          //	BC to be imposed at the end.
 5964: 
 5965:          const Vector2 gradETP  = side->gradETP;
 5966:          const Vector2 gradPr   = side->gradPr;
 5967:          const Vector2 gradEta1 = side->gradEta1;
 5968:          const Vector2 gradEta2 = side->gradEta2;
 5969: 
 5970:          const Vector2 *btu = side->btu;
 5971:          const Vector2 *u2  = side->u2;
 5972:          const double coriolis = side->coriolis;
 5973:          const Vector2 *nuGradU = side->nuGradU;
 5974: 
 5975: 
 5976:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5977:          for (int k = kb + 1; k < nvrt; k++) {
 5978:             const int kin = k - kb - 1;
 5979: 
 5980:             const double dz_0 = side->Dz(k);
 5981:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5982: 
 5983:             rrhs[kin] = {0.0, 0.0};
 5984:             double dz = 0.0;
 5985: 
 5986:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5987:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5988:             if (k < nvrt  ) dz += dz_1;
 5989:             if (k > kb + 1) dz += dz_0;
 5990: 
 5991:             // Elevation gradient, atmospheric pressure and tidal potential
 5992:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5993: 
 5994:             // Coriolis, advection, wind stress, and horizontal viscosity
 5995:             if (k < nvrt - 1) {
 5996: 
 5997: 
 5998:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5999:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 6000:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 6001:                                                 
 6002: 
 6003:                //diff stress tensors 1006
 6004:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 6005:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 6006:                   assert(false && "Not implemented: itur == 5");
 6007:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 6008:                }
 6009:                // else assert(false && "itur # Not implemented");
 6010: 
 6011:             } else { // k == nvrt - 1 SURFACE
 6012:                Vector2 tau2 = {0.0, 0.0};
 6013:                if constexpr(ics==1) {
 6014:                   tau2 = side->tau();
 6015:       
 6016:                } else {
 6017:                   assert(false && "Not implemented: ics == 2");
 6018:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 6019:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 6020:                   // taux2=(vn1+tt1)*0.5d0
 6021:                   // tauy2=(vn2+ss1)*0.5d0
 6022:                } // if ics
 6023: 
 6024:                rrhs[kin] += dt*tau2;
 6025:           
 6026: 
 6027:             } // if k<nvrt
 6028: 
 6029: 
 6030:             if (k > kb + 1) {
 6031:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 6032:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 6033:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 6034: 
 6035:                // diff stress tensors 1006
 6036:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 6037:                   assert(false && "Not implemented: itur == 5");
 6038:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 6039:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 6040:                }
 6041:                // else assert(false && "itur # Not implemented");
 6042: 
 6043: 
 6044:             } // if k>kbs + 1
 6045: 
 6046:             // Baroclinic
 6047:             Vector2 *bcc = side->bcc;
 6048:             if constexpr(ibc == 0) {
 6049:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 6050:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 6051: 
 6052:             } // if ibc==0
 6053: 
 6054:          } // k=kb + 1,nvrt
 6055: 
 6056: 
 6057:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 6058: 
 6059:          for (int k = kb; k < nvrt; k++) {  // XXXXX YYYYYYYYY can be kb 
 6060:             const int kin = k - kb - 1;
 6061:    
 6062:             // Velocity is always clamped to maximum values
 6063:             side->u2[k] = clampVelocity(soln[kin]);
 6064:          } // k
 6065: 
 6066:       } // if side->is2D()
 6067:       
 6068: 
 6069:       // Impose velocity boundary condition at the bottom
 6070:       if constexpr(imm == 2) { // 3D bed deformation model
 6071:          double dep;
 6072:          Vector2 vel;
 6073: 
 6074:          assert(false && "Not implemented: imm == 2");
 6075:          //update_bdef(time, x0, y0, dep, vel);
 6076:          // side->u2[kb] = vel;
 6077: 
 6078:       } else { // imm = 0 or 1
 6079:          if (side->Cd() == 0.0) {
 6080:             side->u2[kb] = side->u2[kb + 1];
 6081: 
 6082:          } else if (side->is3D()) { // 3D no slip bottom   
 6083:             side->u2[kb] = {0.0, 0.0};
 6084: 
 6085:          }
 6086:           
 6087:       } // if imm
 6088: 
 6089:       // The velocities below the bottom level are set to zero
 6090:       for (int k = 0; k < kb; k++) side->u2[k] = {0.0, 0.0};
 6091: 
 6092: 
 6093:    }
 6094: 
 6095: 
 6096:    __global__ void applyMomentumBC(void) {
 6097: 
 6098:       SIDE_BND(sideBnd);
 6099: 
 6100:       Side *side = sideBnd->side;
 6101:       const BoundarySegment *segment = sideBnd->segment;
 6102:       const Node *n1 = side->n1;
 6103:       const Node *n2 = side->n2;
 6104: 
 6105:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 6106: 
 6107:       const bool isLand = segment->isLand;
 6108:       const int ifltype = segment->ifltype;
 6109: 
 6110:       const int kb = side->kb;
 6111: 
 6112: 
 6113:       if (!isLand && ifltype != 0) {
 6114:          const Vector2 *ubc = sideBnd->ubc;
 6115:   
 6116:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 6117:             
 6118:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 6119:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 6120: 
 6121:             if (ifltype == -1) {
 6122:                // Flather 1
 6123: 
 6124:                const double depth = side->depth();
 6125: 
 6126:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 6127: 
 6128:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 6129: 
 6130:                side->u2[k] = vnorm*side->n;
 6131: 
 6132:             } else if (ifltype == -2) { // Discharge
 6133: 
 6134:                const double eta1 = side->eta1();
 6135:                const double eta2 = side->eta2();
 6136:                const double htot = side->htot2();
 6137: 
 6138:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 6139:                assert(false && "Not implemented: Discharge bc");
 6140:                // const double dischrg = discharge(eta1);
 6141:                const double dischrg = 0.0; // XXX REMOVE
 6142:                
 6143: 
 6144:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 6145: 
 6146:                const double vnorm = dischrg*eta2/htot;
 6147: 
 6148:                side->u2[k] = vnorm*side->n;
 6149: 
 6150:             }
 6151:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 6152:                const double vnorm = dot(side->u2[k], side->n);
 6153: 
 6154:                double rat;
 6155:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 6156:                else              rat = segment->vobc2; // outgoing
 6157: 
 6158:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 6159: 
 6160:             }
 6161:             else { // not Flather or 3D radiation
 6162:                side->u2[k] = ubc[k];
 6163: 
 6164:             } // if (segment->ifltype...
 6165: 
 6166:          }
 6167: 
 6168:       }
 6169:       else if (isLand) { // if it is land boundary side
 6170: 
 6171:          if constexpr(islip == 0) { // free slip
 6172: 
 6173:             for (int k = kb; k < nvrt; k++) {
 6174: 
 6175:                const Vector2 t = side->t();
 6176:                const Vector2 n = side->n;
 6177: 
 6178:                double vnorm = 0.0; // for most cases
 6179:                const double vtan = dot(side->u2[k], t);
 6180:                
 6181:                side->u2[k] = vtan*t - vnorm*n;
 6182: 
 6183:             }
 6184: 
 6185:          } else { // no slip
 6186:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 6187: 
 6188:          }
 6189:       } // if (side segment type...
 6190: 
 6191:    
 6192: 
 6193:    }
 6194: 
 6195: 
 6196:    __global__ void shapiroFilter1(void) {
 6197:       // First step of the Shapiro filter (normally used if indvel<=0)
 6198:       // Computes the filtered values and stores them in bcc (as a temporary array).
 6199: 
 6200:       SIDE(side);
 6201: 
 6202:       // Only internal wet sides are processed
 6203:       if (side->isDry || !(side->isInternal())) return;
 6204: 
 6205:       const int kb = side->kb;
 6206: 
 6207:       for (int mm = 0; mm < niter_shap; mm++) {
 6208: 
 6209:          for (int k = kb + 1; k < nvrt; k++) {
 6210:             // WARNING: reusing bcc as a temporary array to store the suru values.
 6211:             Vector2 suru = {0.0, 0.0};
 6212: 
 6213:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 6214: 
 6215:                const Side *nSide = side->neigh(j); // Each internal side has 4 neighbors. They are the closest sides to each of the two elements that share this side
 6216: 
 6217:                int kin = k;
 6218:                if (!(nSide->isDry)) kin = max(k, nSide->kb + 1);
 6219:                
 6220:                if constexpr(ics==1) {
 6221:                   suru += nSide->u2[kin];
 6222: 
 6223:                } else {
 6224:                   assert(false && "Not implemented: ics == 2");
 6225:                   // Vector2 vn1, vn2;
 6226:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 6227:                   // suru=suru+vn1;
 6228:                   // surv=surv+vn2;
 6229:                }
 6230:             }
 6231: 
 6232:             // Reusing bcc as a temporary array to store the suru values.
 6233:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 6234: 
 6235:          }
 6236:       }
 6237:    }
 6238: 
 6239:    __global__ void shapiroFilter2(void) {
 6240:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 6241: 
 6242:       SIDE(side);
 6243: 
 6244: 
 6245:       if (side->isDry || !(side->isInternal())) return;
 6246: 
 6247:       const int kb = side->kb;
 6248: 
 6249:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 6250: 
 6251:       if (side->is2D()) {
 6252:          side->u2[kb + 1] = side->bcc[kb + 1];
 6253:          side->u2[kb    ] = side->u2 [nvrt - 1];  // XXXXX isn't side->u2 [nvrt - 1] == side->bcc[kb + 1]?
 6254: 
 6255:       } else {
 6256:          // 3D
 6257:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 6258:          
 6259:       }
 6260: 
 6261:    }
 6262: 
 6263: 
 6264:    __global__ void ul0UpdateZCoords(void) {
 6265:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 6266:       
 6267:       NODE(node);      
 6268: 
 6269: 
 6270:       if (false) { //node->isDry) { XXXXXXX
 6271: 
 6272:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 6273: 
 6274:          if constexpr(ivcor != 1) node->kb = 0;
 6275: 
 6276:       } else {
 6277: 
 6278:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 6279:          node->updateKb();
 6280: 
 6281:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 6282: 
 6283:       }
 6284: 
 6285:       // We use the temp.b field to store the previous state of isDry.
 6286:       node->tmp.b = node->isDry;
 6287: 
 6288:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 6289:       node->isDry = true;
 6290: 
 6291:    }
 6292: 
 6293:    __global__ void ul0ComputeDryElements(void)
 6294:    // Updates isDry based on eta2 for the elements. Also computes kb and z.
 6295:    {
 6296:       ELEM(elem);
 6297: 
 6298:       elem->isDry = elem->isDry2(); // A element is dry if any of its nodes are dry (based on current eta2, not on isDry)
 6299: 
 6300:       elem->kb = 0;
 6301: 
 6302:       if (elem->isDry) return;
 6303: 
 6304: 
 6305:    //    if(elem->isDry2()) { // XXXX
 6306:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 6307:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 6308:    //        call parallel_abort(errmsg)
 6309:    //    }
 6310: 
 6311:       const Node *n1 = elem->nodes[0];
 6312:       const Node *n2 = elem->nodes[1];
 6313:       const Node *n3 = elem->nodes[2];  
 6314:       const Node *n4 = elem->nodes[3]; // nullptr for triangles      
 6315: 
 6316:       // Computes element's kb as the minimum of the nodes' kb.
 6317:       const int kb1 = n1->kb;
 6318:       const int kb2 = n2->kb;
 6319:       const int kb3 = n3->kb;
 6320:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 6321: 
 6322: 
 6323:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 6324: 
 6325: 
 6326:       // Computes the element z as the mean of the nodes z.
 6327:       for (int k = elem->kb; k < nvrt; k++) {
 6328: 
 6329:          // Compute the element z as the mean of the nodes z.
 6330:          elem->z[k] = n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)];
 6331:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 6332:          elem->z[k] /= elem->i34;
 6333: 
 6334:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 6335:       }
 6336:                   
 6337:    }
 6338: 
 6339:    __global__ void ul0ComputeDryNodes(void)
 6340:    // Updates node's isDry based on the elements' isDry. 
 6341:    {
 6342:       NODE(node);
 6343: 
 6344:       node->isDry = true;
 6345: 
 6346:       // A node is wet if at least one of the elements sharing it is wet.
 6347:       for (int j = 0; j < node->numElements; j++) {
 6348:          const Element *elem = node->elements[j];
 6349:          if (!elem->isDry) {
 6350:             node->isDry = false;
 6351:             break;
 6352:          }
 6353:       }
 6354: 
 6355:        
 6356:    }
 6357: 
 6358: 
 6359:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 6360:    // Obtains values of velocity, S, T for newly wet nodes. It uses the average of the previously wet surrounding nodes.
 6361:    // node->tmp.b is true if the node was previously dry.
 6362:    // This function avoids race conditions by only modifying nodes that just became wet and only using the values of the previously wet surrounding nodes.
 6363:    {
 6364:       NODE(node);
 6365:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 6366: 
 6367:       // Avoid this the first time step.
 6368:       if (it == iths) return;  
 6369: 
 6370:       const bool wasDry = node->tmp.b;
 6371: 
 6372: //  if (node->isDry && !wasDry) node->eta2 = max(node->eta2, -node->depth); // XXXX KKKKKK NOT IN THE ORIGINAL CODE
 6373: 
 6374:       if ((!node->isDry) && wasDry) {  // rewetted, remember that tmp.b is true if the node was previously dry.
 6375: 
 6376:          for (int k=0; k < nvrt; k++) {
 6377: 
 6378:             Vector3 utmp={0.0, 0.0, 0.0};
 6379: 
 6380:             double ttmp=0.0;
 6381:             double stmp=0.0;
 6382:             int icount=0;
 6383:             for (int j = 0; j < node->numNodes; j++) {
 6384: 
 6385:                const Node *nbrNode = node->nodes[j];
 6386:                
 6387:                const bool wasNbrDry = nbrNode->tmp.b;
 6388: 
 6389:                // Wet neighbors not affected by this part and so each sub-domain should use same values
 6390:                if (!wasNbrDry) { // Incluide only previously wet surrounding nodes
 6391: 
 6392:                   icount++;
 6393: 
 6394:                   // Assume small element size in wet/dry zone so pframes are close to each other
 6395:                   utmp += nbrNode->uvw2(k);
 6396:                   
 6397:                   ttmp += nbrNode->tracers[k].tracer[0]; 
 6398:                   stmp += nbrNode->tracers[k].tracer[1]; 
 6399:                }
 6400:             }
 6401: 
 6402:             if (icount > 0) {
 6403:                const double inv_icount = 1.0/icount;
 6404:                utmp = inv_icount*utmp;
 6405:                node->u2[k]     = toVector2(utmp);
 6406:                node->w2[k]     = utmp.z;
 6407:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 6408:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 6409:             } else {
 6410:                node->u2[k] = {0.0, 0.0};
 6411:                node->w2[k] = 0.0;
 6412:                // Initialize tracers to 0.0??? XXXXX
 6413:             }
 6414:          }
 6415:       }
 6416:    }
 6417: 
 6418:   
 6419:    
 6420: 
 6421: 
 6422:    __global__ void ul0UpdateSides(int it, int iths) {
 6423:    // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding sides.
 6424:    // Notice that, since we are only updating newly wetted side from sides that were previously wet, there is no race condition here.
 6425:    // The dryness of the sides is updated in ul0UpdateSides2.
 6426: 
 6427:       SIDE(side);
 6428: 
 6429:       // A side is wet if and only if at least one of its elements is wet.
 6430:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 6431:  
 6432:       const Node *n1 = side->n1;
 6433:       const Node *n2 = side->n2;
 6434:      
 6435:       const int kb1 = n1->kb;
 6436:       const int kb2 = n2->kb;
 6437: 
 6438:       side->kb = 0; // default when dry
 6439: 
 6440:       if (isWet) {
 6441: 
 6442:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 6443: 
 6444:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 6445: 
 6446:          side->kb = min(kb1, kb2);
 6447: 
 6448:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 6449: 
 6450:          for (int k = side->kb; k < nvrt; k++) {
 6451:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 6452: 
 6453:             assert(((k == side->kb ) || (side->zc[k] > side->zc[k-1])) && "Weird side (3)");
 6454: 
 6455:             // Compute velocity for re-wetted sides 
 6456:             if ((it != iths) && (side->isDry && isWet)) {
 6457: 
 6458:                Vector2 utmp={0.0, 0.0};
 6459: 
 6460:                int icount=0;
 6461: 
 6462:                // For all the sides on the two elements that share this side
 6463:                for (int j = 0; j < 2; j++) {
 6464:                   const Element *elem = side->elems[j];
 6465:                   if (elem == nullptr) continue;
 6466: 
 6467:                   for (int jj=0; jj < elem->i34; jj++) {
 6468:                      const Side *nSide = elem->sides[jj];
 6469:                      if (nSide->isDry) continue;
 6470: 
 6471:                      icount++;
 6472:                      utmp += nSide->u2[k];  
 6473:                      //  XXXXXX DO THE SAME FOR TRACERS????                   
 6474:                   }
 6475:                }
 6476:                   
 6477:                // assert(icount > 0 && "No wet sides around this side");    XXXX KKKKK
 6478:                if (icount > 0)  side->u2[k] = utmp/icount;
 6479:                else             side->u2[k] = {0.0, 0.0};
 6480:                   
 6481:             } // if ((it != iths) && (side->isDry && isWet))
 6482: 
 6483:          } // for k
 6484: 
 6485:       } // if isWet 
 6486:       
 6487: 
 6488: 
 6489:    }
 6490: 
 6491:    __global__ void ul0UpdateSides2(void) {
 6492:       // Obtains values of velocity for newly wet sides. It uses the average of the previously wet surrounding nodes.
 6493:    
 6494:          SIDE(side);
 6495:    
 6496:          const Element *e1 = side->elems[0];
 6497:          const Element *e2 = side->elems[1];
 6498: 
 6499:          // A side is wet if and only if at least one of its elements is wet.
 6500:          const bool isWet = (!e1->isDry) || (side->isInternal() && (!e2->isDry));
 6501: 
 6502:          // Update the side's dryness
 6503:          side->isDry = !isWet;
 6504: 
 6505:    }
