  203: using Vector2 = double2; 
  204: using Vector3 = double3;
  205: using Point2  = double2;
  206: using Point3  = double3;
  207: 
  208: __device__ __forceinline__ double2 operator+(const double2& a, const double2& b) {
  209:     return make_double2(a.x + b.x, a.y + b.y);
  210: }
  211: using Vector2 = double2; 
  212: using Vector3 = double3;
  213: __device__ __forceinline__ double2 operator+=(double2& a, const double2& b) {
  214:     a.x += b.x;
  215:     a.y += b.y;
  216:     return a;
  217: }
  218: 
  219: __device__ __forceinline__ double2 operator-(const double2& a, const double2& b) {
  220:     return make_double2(a.x - b.x, a.y - b.y);
  221: }
  222: 
  223: __device__ __forceinline__ double2 operator-=(double2& a, const double2& b) {
  224:     a.x -= b.x;
  225:     a.y -= b.y;
  226:     return a;
  227: }
  228: 
  229: __device__ __forceinline__ double2 operator*(const double2& v, const double s) {
  230:     return make_double2(v.x * s, v.y * s);
  231: }
  232: 
  233: __device__ __forceinline__ double2 operator*(const double s, const double2& v) {
  234:     return v * s;  // reuse the previous operator
  235: }
  236: 
  237: __device__ __forceinline__ double2 operator/(const double2& v, double s) {
  238:     return make_double2(v.x / s, v.y / s);
  239: }
  240: 
  241: __device__ __forceinline__ double norm2(const double2& v) {
  242:     return v.x*v.x + v.y*v.y;
  243: }
  244: 
  245: __device__ __forceinline__ double length(const double2& v) {
  246:     return sqrt(v.x*v.x + v.y*v.y);
  247: }
  248: 
  249: __device__ __forceinline__ double2 normalize(const double2& v) {
  250:     return v / length(v);
  251: }
  252: 
  253: __device__ __forceinline__ double dot(const double2& v, const double2& w) {
  254:     return v.x*w.x + v.y*w.y;
  255: }
  256: 
  257: __device__ __forceinline__ double cross(const double2& v, const double2& w) {
  258:     return v.x*w.y - v.y*w.x;
  259: }
  260: 
  261: __device__ __forceinline__ double2 rot90(const double2& a) {
  262:     return make_double2(a.y, -a.x);
  263: }
  264: 
  265: __device__ __forceinline__ double3 operator+(const double3& a, const double3& b) {
  266:     return make_double3(a.x + b.x, a.y + b.y, a.z + b.z);
  267: }
  268: 
  269: __device__ __forceinline__ double3 operator+=(double3& a, const double3& b) {
  270:     a.x += b.x;
  271:     a.y += b.y;
  272:     a.z += b.z;
  273:     return a;
  274: }
  275: 
  276: __device__ __forceinline__ double3 operator-(const double3& a, const double3& b) {
  277:     return make_double3(a.x - b.x, a.y - b.y, a.z - b.z);
  278: }
  279: 
  280: __device__ __forceinline__ double3 operator*(const double3& v, double s) {
  281:     return make_double3(v.x * s, v.y * s, v.z * s);
  282: }
  283: 
  284: __device__ __forceinline__ double3 operator*(double s, const double3& v) {
  285:     return v * s;
