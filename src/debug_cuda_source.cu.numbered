 7810: //             !this exchange routine swaps interface concentration between two partitions
 7811: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7812: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7813: 
 7814: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7815: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7816: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
