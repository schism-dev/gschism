 7467: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 7468:    Node *nodes = mesh->localNodeData;
 7469: 
 7470:    *addr = nodes;
 7471:    *sizeNode = sizeof(Node);
 7472: 
 7473:    switch (varCode) {
 7474:       case (int)VarCode::depth:
 7475:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 7476:          *sizeType = sizeof(double);
 7477:          break;
 7478:       case (int)VarCode::eta:
 7479:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 7480:          *sizeType = sizeof(double);
 7481:          break;
 7482:       case (int)VarCode::x:
 7483:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 7484:          *sizeType = sizeof(Vector2);
 7485:          break;
 7486:       case (int)VarCode::z:
 7487:          *offset = (int)((char*)&nodes[0].z[0] - (char*)nodes);
 7488:          *sizeType = sizeof(double);
 7489:          break;
 7490:       case (int)VarCode::kb:
 7491:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 7492:          *sizeType = sizeof(int);
 7493:          break;
 7494:       case (int)VarCode::isdry:
 7495:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 7496:          *sizeType = sizeof(int);
 7497:          break;         
 7498:       case (int)VarCode::w:
 7499:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 7500:          *sizeType = sizeof(double);
 7501:          break;
 7502:       case (int)VarCode::u:
 7503:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 7504:          *sizeType = sizeof(Vector2);
 7505:          break;         
 7506:       default:
 7507:          *offset = -1;    
 7508:    }  
 7509:    
 7510: }
