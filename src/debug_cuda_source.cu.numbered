 3795: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3796:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3797:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3798:                 int *isdel, int *isidenode, int *isbnd,
 3799:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3800:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3801:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3802:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3803:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3804:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3805:                 double *drag, double *roughness,
 3806:                 double *emo, double *efa, 
