 1853: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1854: // return;   
 1855:    // Lock the mutex
 1856:    lock(&debugPlotMutex);
 1857:  
 1858:    bool ok = true;
 1859:    if (debugPlotIdx == nullptr) ok = false;
 1860:    if (*debugPlotIdx >= 10000) ok = false;
 1861:    if (ok) {
 1862:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1863:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1864:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1865:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1866:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1867:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1868:       (*debugPlotIdx)++;
 1869:    }
 1870: 
 1871:    __threadfence();               // ensure all above writes are visible
 1872:    // Unlock the mutex
 1873:    unlock(&debugPlotMutex);
 1874: 
 1875: }
