 2187:       T values[4];
 2188:       getNodalValues(field, values);
 2189: 
 2190:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2191:       if constexpr (IsVector2<T>::value && ics == 2) {
 2192: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2193:          projectNodeVectorsToElementFrame(values);
 2194: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2195:       }
 2196:       
 2197:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2198:    }
