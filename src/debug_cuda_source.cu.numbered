 1108: struct Node {
 1109: 
 1110:    // Geometry information
 1111:    int idx;        // Index of the node
 1112:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1113:    int numNodes;   // Number of nodes neighbors of this node
 1114: 
 1115:    Element **elements; // Array of pointers to the elements that share this node
 1116:    int numElements;    // Number of elements that share this node
 1117: 
 1118:    int numSides;       // Number of sides that are connected to this node
 1119: 
 1120:    Point3 p;
 1121:    Vector3 u2[nvrt];
 1122:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1123:    double z[nvrt];
 1124:    double lon, lat;
 1125:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1126:    double depth;
 1127: 
 1128:    int kb;       // Bottom index of the node
 1129: 
 1130:    bool isDry;     // True if the node is dry
 1131: 
 1132:    int iadv;     // Advection flag
 1133: 
 1134:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1135:                           // this is nullptr
 1136: 
 1137:    TempVar tmp; // Temporary variable to store different types of variables
 1138: 
 1139:    // Physical information
 1140:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1141:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1142: 
 1143:    double rho[nvrt];     // Density
 1144:    double dfv[nvrt];     // Vertical viscosity
 1145: 
 1146:    double eta1; // Elevation at nodes at previous timestep
 1147:    double eta2; // Elevation at nodes at current timestep
 1148: 
 1149:    double ETP;  // Earth Tidal Potential
 1150: 
 1151:    double pr;    // Air pressure
 1152:    double grav2; // Gravity 
 1153:    
 1154:    Vector2 dav;  // Depth averaged velocity
 1155: 
 1156:    Vector2 tau; // Wind stress vector
 1157: 
 1158:    // Vegetation parameters
 1159:    double veg_h;
 1160:    double veg_nv;
 1161:    double veg_di;
 1162:    double veg_Cd;
 1163:    double veg_h_unbent;
 1164:    double veg_di_unbent;
 1165:    double veg_nv_unbent;
 1166:    double veg_alpha_vert_mean;
 1167:    double veg_alpha0;
 1168:    double veg_alpha3D[nvrt];
 1169: 
 1170:    // Bottom drag parameters
 1171:    double Cd;       // Bottom drag coefficient
 1172:    double rough;    // Bottom roughness length
 1173:    Vector2 tau_bot; // Bottom stress vector
 1174: 
 1175:    double bdef1; // Bottom deformation at previous timestep
 1176:    double bdef2; // Bottom deformation at current timestep
 1177: 
 1178:    double qel; // RHS
 1179:    double coeffDiag; // Diagonal coefficient of the matrix
 1180:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1181: 
 1182:    double mP; // Search direction for conjugate gradient method
 1183:    double mR; // Residual for conjugate gradient method
 1184:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1185:    double mX; // Solution for conjugate gradient method
 1186: 
 1187:    // Meteorological forcing
 1188:    Vector2 u_air;
 1189:    double p_air;
 1190:    double t_air;
 1191:    double q_air;
 1192:    double wind_angle;  // Wind rotation angle
 1193: 
 1194:    __device__ void setWind(Vector2 &u) {
 1195:    // Sets the wind vector taking into account the wind rotation angle
 1196:    
 1197:       const double dir = atan2(-u.x,-u.y);
 1198:       const double speed = length(u);
 1199: 
 1200:       // Calculate new u and v components with added rotation angle
 1201:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1202:    }
 1203: 
 1204:    __device__ Point2 p2(void) const { return {p.x, p.y}; }
 1205:    __device__ Point3 p3(int k) const { return {p.x, p.y, z[k]}; }
 1206: 
 1207:    __device__ double sigmaTransitionDepth(void) const;
 1208: 
 1209:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1210:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1211:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1212: 
 1213:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1214: 
 1215:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1216:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1217: 
 1218:    __device__ void clearMatrixRow(void) {
 1219:       // Clear the matrix row for this node
 1220:       coeffDiag = 0.0;
 1221:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1222: 
 1223:    }
 1224: 
 1225:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1226:       // Add the value to the sparse matrix for this node
 1227:       
 1228:       if (node == this) {
 1229:          coeffDiag += value;
 1230:      
 1231:       } else {
 1232:          // Search (linearly)the index of the node in the array of nodes
 1233:          // XXX: This is not efficient, see if we can improve this
 1234:          int i;
 1235:          for (i = 0; i < numNodes; i++) {
 1236:             if (nodes[i] == node) {
 1237:                break;
 1238:             }
 1239:          }
 1240:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1241:          coeffMatrix[i] += value;
 1242:       }
 1243:    }
 1244: 
 1245: 
 1246:    __device__ __inline__ void updateZCoordData(void);
 1247: 
 1248:    __device__ double compZCoord(int k) const;
 1249: 
 1250:    __device__ void updateKb(void);
 1251: 
 1252: 
 1253: 
 1254: };
