  960: struct Side {
  961: 
  962:    // Geometry information
  963:    int idx;               // Index of the side
  964:    Node *n1, *n2;
  965:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  966: 
  967:    double len;            // Length of the side. Used to be called distj; but I think this name is less clear now.
  968:    Vector2 center;        // Location of side center. 
  969:    double zc[nvrt];       // Side center z-coord at each vertical level
  970: 
  971:    Frame frame;
  972: 
  973:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  974:                           // this is nullptr
  975:    
  976:    int kb;                // Bottom index of the side
  977:    bool isDry;            // True if the side is dry
  978:  
  979:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  980: 
  981:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  982: 
  983:    // Physical information
  984:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  985:    double  w2[nvrt];            // Vertical velocity at each vertical level
  986:    Vector2 btu[nvrt];           // Back-tracked velocity
  987:    Vector2 U;                   // Vertically averaged velocity vector  
  988: 
  989:    Vector2 nuGradU[nvrt];          // nu*grad u
  990: 
  991:    Vector2 bcc[nvrt];           // Baroclinic term
  992:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  993: 
  994:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  995:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  996:    Vector2 gradPr;               // Gradient of pressure
  997:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  998: 
  999: 
 1000:    double hhat;                 // \breve{H} in notes
 1001: 
 1002:    double shapiro;
 1003: 
 1004:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
 1005: 
 1006:    double coriolis;             // Coriolis parameter
 1007: 
 1008:    // Vegetation parameters
 1009:    double veg_c2;
 1010:    double veg_beta;
 1011: 
 1012:    // Bottom drag parameters.
 1013:    double chi;
 1014:    double chi2;
 1015: 
 1016:    __inline__ __device__ double x(double t) const;
 1017:    __inline__ __device__ double y(double t) const;
 1018:    __inline__ __device__ double lon(void) const;
 1019:    __inline__ __device__ double lat(void) const;
 1020:    __inline__ __device__ Point2 p_t(double t) const;
 1021: 
 1022:    __inline__ __device__ Point3 center3D(int k) const { assert(k < nvrt); return {center.x, center.y, zc[k]}; }
 1023:    __inline__ __device__ double Dz(int k)       const { assert(k < nvrt); return zc[k] - zc[k - 1]; }
 1024:    __inline__ __device__ double area(int k)     const { assert(k < nvrt - 1); return len*Dz(k + 1); }
 1025: 
 1026:    __inline__ __device__ Side* neigh(int index) const { 
 1027:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
 1028:       assert(index >= 0 && index < 4); 
 1029:       assert(elems[0] != nullptr && elems[1] != nullptr);
 1030: 
 1031:       const int ielem = index & 1;           // 0 or 1
 1032:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
 1033: 
 1034:       const Element* elem = elems[ielem];
 1035: 
 1036:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
 1037: 
 1038:       return elem->sides[elem->nxq(locSideIdx + iside)];
 1039: 
 1040:    }
 1041: 
 1042:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
 1043: 
 1044:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
 1045: 
 1046:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
 1047:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
 1048:    __inline__ __device__ int iadv(void) const;
 1049: 
 1050:    __inline__ __device__ double grav3(void) const;
 1051:    
 1052:    __inline__ __device__ double eta2(void) const;
 1053:    __inline__ __device__ double eta1(void) const;
 1054:    __inline__ __device__ double depth(void) const;
 1055:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
 1056:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
 1057: 
 1058:    __inline__ __device__ double dfv(int k) const;
 1059: 
 1060:    __inline__ __device__ double veg_h(void)  const;
 1061:    __inline__ __device__ double veg_nv(void) const;
 1062:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
 1063:    __inline__ __device__ double veg_alpha3D(int k) const;
 1064:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
 1065: 
 1066:    __inline__ __device__ double Cd(void) const;
 1067: 
 1068:    __inline__ __device__ Vector2 tau(void) const;
 1069: 
 1070:    __inline__ __device__ double zb(void) const { return zc[kb]; }
 1071:    
 1072: 
 1073:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
 1074:    __inline__ __device__ double zLevelVegRatio(int k) const { 
 1075:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
 1076:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
 1077:    } 
 1078:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
 1079:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1080:    __inline__ __device__ bool is2D(void) const { assert(kb <= nvrt - 2); return kb == nvrt - 2; }
 1081:    __inline__ __device__ bool is3D(void) const { assert(kb <= nvrt - 2); return kb <  nvrt - 2; }
 1082: 
 1083:    // Get valid starting element (for backtracking)
 1084:    __inline__ __device__ Element* getStartElement() {
 1085:       return elems[0] ? elems[0] : elems[1];
 1086:    }
 1087: 
 1088:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1089:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1090: 
 1091:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1092: 
 1093:       // Dot product of the negative velocity vector with the side normal vector
 1094:       const double dot_prod1 = -dot(u, n);
 1095: 
 1096:       // Vector from side center to element 0 centroid
 1097:       const Vector2 v2 = elems[0]->center - center;
 1098: 
 1099:       // Dot product of the vector with the side normal vector
 1100:       const double dot_prod2 = dot(v2, n);
 1101: 
 1102:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1103:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1104: 
 1105:       const bool isDry0 = elems[0]==nullptr || elems[0]->isDry;
 1106:       const bool isDry1 = elems[1]==nullptr || elems[1]->isDry;
 1107:       if (dot_prod1*dot_prod2 > 0.0) return !isDry0 ? elems[0] : nullptr;
 1108:       else                           return !isDry1 ? elems[1] : nullptr;
 1109: 
 1110:  
 1111:    }
 1112: 
 1113:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1114:       // Given an element, returns the other element that shares this side
 1115:       return (elems[0] == elem) ? elems[1] : elems[0];
 1116:    }
 1117: 
 1118:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1119:       // Given a node, returns the other node that shares this side
 1120:       return (n1 == node) ? n2 : n1;
 1121:    }
 1122:  
 1123:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1124: 
 1125: 
 1126: 
 1127: 
 1128: };
