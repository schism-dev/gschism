 1612: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1613:    // Computes the 3D normal vector to the element at level k
 1614:    // Returns the normal vector and the area of the element
 1615: 
 1616:       if (isTri()) {
 1617:          // For triangles...
 1618: 
 1619:          // Gets the normal vector to the element (with a length equal to twice the area)
 1620:          if constexpr(ics==1) {
 1621:             const int kb0 = max(k, nodes[0]->kb);
 1622:             const int kb1 = max(k, nodes[1]->kb);
 1623:             const int kb2 = max(k, nodes[2]->kb);
 1624: 
 1625:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1626:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1627:             
 1628:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1629:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1630:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1631:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1632: 
 1633:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1634:             area3D = 0.5*len;
 1635: 
 1636:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1637: 
 1638:             return {nx/len, ny/len, nz/len};
 1639: 
 1640:            
 1641:          }
 1642:          else {  // lat/lon
 1643:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1644: 
 1645:          } // if ics
 1646:       }
 1647:       else {
 1648:          // For quads...
 1649: 
 1650:          assert(false && "Element normal vector: quads not yet implemented");
 1651: 
 1652: 
 1653:       }
 1654:    }
 1655: 
 1656: /**
 1657:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1658:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1659:    If the segment is completely inside the element, then it returns true.
 1660: 
 1661:    This function assumes:
 1662:    - The initial point is on a side of the element. 
 1663:    - Its position is given by parameter t in the range [0,1].
 1664:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1665:       intersects the element (elements are convex).
 1666: 
 1667:    To find the intersection point, this function does the following:
 1668:    - it finds the intersection of the line segment with all the element side lines,
 1669:       except for the one that contains the initial point.
 1670:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1671:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1672:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1673:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1674:       track segment is almost parallel to the element side line.
 1675: 
 1676:    Inputs:
 1677:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1678:    @param x2, y2: other end of the line segment
 1679: 
 1680:    Outputs:
 1681:    @param side:  side that intersects the line segment (input and output)
 1682:    @param nextElement (output): element that contains the intersection point
 1683:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1684:    @param zint (input/output): Vertical coordinate of the intersection point
 1685: 
 1686:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1687:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1688:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1689: 
 1690:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1691:    (Delta) being zero.
 1692: 
 1693:    The intersection2 point happens when:
 1694:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1695:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1696:    
 1697:    Assumption: the 4 points (including those of the side segment) are different.
 1698:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1699:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1700:    If true, (xIntersect,yIntersect) is the intersection.				
 1701:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1702: **/
 1703: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1704:                                               double &t, double& tIntersect) {
 1705: 
 1706:    double closest_intersect_t = 1e10;
 1707:    bool found_intersection = false;
 1708: 
 1709:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1710:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1711:    const Point2 x1 = side->point(t);
 1712:    
 1713: 
 1714:    Side *nextSide = nullptr;
 1715:    for (int i = 0; i < i34; i++) {
 1716: 
 1717:       // Element's i-th side 
 1718:       Side *side2 = sides[i];
 1719: 
 1720:       // Skip the side that contains the initial point
 1721:       if (side2 == side) continue;
 1722: 
 1723:       // (x3,y3)-(x4,y4) is the element side line
 1724:       const Point2 x3 = side2->n1->p2();
 1725:       const Point2 x4 = side2->n2->p2();
 1726: 
 1727:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1728:       const double delta = cross(x2 - x1, x3 - x4);
 1729: 
 1730:       if (delta != 0.0) {
 1731: 
 1732:          const double delta1 = cross(x3 - x1, x3 - x4);
 1733:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1734: 
 1735:          // Solves the two linear equations for tt1 and tt2
 1736:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1737:          const double tt2 = delta2/delta;
 1738: 
 1739:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1740:             closest_intersect_t = min(closest_intersect_t, tt1);
 1741:             nextSide = side2;
 1742: 
 1743:             nextElement = nextSide->otherElem(this);
 1744:             tIntersect = max(small, min(tt1, 1.0-small));
 1745:             t = tt2;
 1746: 
 1747:             found_intersection = true;
 1748:          }
 1749:       
 1750:       }
 1751: 
 1752:    }
 1753: 
 1754:    // found_intersection should always be true, since we checked all the sides.  
 1755:    side = nextSide;
 1756: 
 1757:    return found_intersection;
 1758: }
 1759: 
 1760: 
 1761: 
 1762: 
 1763: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1764:                                               double &t, double& tIntersect) {
 1765: 
 1766:    double closest_intersect_t = 1e10;
 1767:    bool found_intersection = false;
 1768: 
 1769:    for (int i = 0; i < i34; i++) {
 1770: 
 1771:       Side *side2 = sides[i];
 1772: 
 1773:       // (x3,y3)-(x4,y4) is the element side line
 1774:       const Point2 x3 = side2->n1->p2();
 1775:       const Point2 x4 = side2->n2->p2();
 1776: 
 1777:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1778:       const double delta = cross(x2 - x1, x3 - x4);
 1779: 
 1780:       if (abs(delta) > 0) {
 1781: 
 1782:          const double delta1 = cross(x3 - x1, x3 - x4);
 1783:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1784: 
 1785:          // Solves the two linear equations for tt1 and tt2
 1786:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1787:          const double tt2 = delta2/delta;
 1788: 
 1789:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1790:             closest_intersect_t = min(closest_intersect_t, tt1);
 1791:             side = side2;
 1792:             nextElement = side->otherElem(this);
 1793:             t = tt2;
 1794:             tIntersect = max(small, min(tt1, 1.0-small));
 1795:             found_intersection = true;
 1796:          }
 1797:       
 1798:       }
 1799:       else {  // parallel segments
 1800:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1801:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1802: 
 1803:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1804: 
 1805:          // const double dist = dot(x1 - x3, side2->n);
 1806:          // if (abs(dist) < small*length(x3 - x4)) {
 1807:          //    const double2 unitarySide = normalize(x4 - x3);
 1808:          //    const double len = dot(x2 - x1, unitarySide);
 1809:          //    t = t + len;
 1810:          //    t = max(0.0, min(t, 1.0));
 1811:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1812: 
 1813: 
 1814:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1815:          //    // t = tt2;
 1816:          //    found_intersection = true;
 1817:          // }
 1818:       }
 1819: 
 1820: 
 1821:    }
 1822: 
 1823:       
 1824:    assert(found_intersection && "No intersection found");
 1825: 
 1826:    // found_intersection should always be true, since we checked all the sides.  
 1827:    return found_intersection;
 1828: }
 1829: 
 1830: 
 1831: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1832:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1833: 
 1834:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1835: 
 1836:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1837:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1838:    // curElement.
 1839: 
 1840:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1841:    // And uses this velocity instead to continue the tracking.
 1842: 
 1843:    // computes the intersection point in cartesian coordinates
 1844:    Point2 intersection = nextSide->p_t(tt);
 1845: 
 1846:    // Nudges the point to the barycenter of the element. 
 1847:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1848:    // next segment intersects the element sides.  
 1849:    curElem->nudgeToBarycenter(intersection);
 1850: 
 1851:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1852:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1853:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1854:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1855: 
 1856:    // If the side is an open boundary, the tangential velocity is zero.
 1857:    if (nextSide->isBnd()) vtan = 0.0;
 1858: 
 1859:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1860:    const double us = vtan*nextSide->t().x;
 1861:    const double vs = vtan*nextSide->t().y;
 1862:    const double ws = 0.5*(nextSide->n1->u2[jlev].z + nextSide->n2->u2[jlev].z);
 1863: 
 1864:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1865:    const double len2 = norm2(intersection - toPoint2(xt));
 1866:    const double vel2 = dot(u_int, u_int);        
 1867:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1868:    else            dt = 0.0;
 1869: 
 1870:    // The end of this tracking segment is now the intersection point.
 1871:    xt = {intersection.x, intersection.y, zint};
 1872: 
 1873:    u_int = {us, vs, ws};
 1874:    
 1875: }
 1876: 
 1877: /**
 1878:  * Tracks a particle through elements and vertical levels in the mesh.
 1879:  * 
 1880:  * @param x0,y0,z0     Starting position coordinates
 1881:  * @param xt,yt,zt     Target position coordinates
 1882:  * @param dtb          Time step for tracking
 1883:  * @param uuint,vvint,wwint Initial velocity components
 1884:  * @param nextElem     Starting/resulting element index
 1885:  * 
 1886:  * @return Status code of type trackExitCodes
 1887:  * 
 1888:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 1889:  * of the details are different. The idea is that the code requires less branches and is better fit
 1890:  * for GPU execution.
 1891:  * 
 1892:  * The main ideas here are:
 1893:  * - The starting point is expected to be in the starting element.
 1894:  * - The end point is guaranteed to be inside an element.
 1895:  * - since the starting point is inside the element, there are only two cases: 
 1896:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 1897:  *     (b) it does not and (xt,yt) is already in the starting element.
 1898:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 1899:  *   of the segment with the *lines* (infinite length) that form the element sides.
 1900:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 1901:  * - tt1 can be positive or negative. We only consider the positive values.
 1902:  * - tt2 is the parametric value of the intersection point on the element side segment.
 1903:  * - The next intersection will occur at the smallest positive tt1.
 1904:  * - This intersection will be the next (x0,y0) position.
 1905:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 1906:  *   of getting stuck in a loop.
 1907:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 1908:  *   was found.
 1909:  */
 1910: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 1911:                                                        Element *&nextElem, int &jlev, double &dt,
 1912:                                                        const Side *origSide) {
 1913: 
 1914: 
 1915: 
 1916:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 1917:    // else to do.
 1918:    // If it is, nudges the point to be inside the element.
 1919:    const Element *curElem = nextElem;
 1920:    if (containsPoint(toPoint2(xt), true)) {
 1921: 
 1922:       curElem->interpolateVelocities(xt, u_int);
 1923: 
 1924: addDebugPlot(x0, xt);
 1925:       return true;
 1926:    }
 1927: 
 1928:    Side *side = nullptr;
 1929: 
 1930:    // 1. Initial checks
 1931:    // Verify starting element is valid (wet)
 1932:    assert(!curElem->isDry && "Starting element is dry");
 1933: 
 1934:    // Checks if track has a zero length.
 1935:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 1936:    // assert(len2 > 0.0 && "Zero length track"); 
 1937:    
 1938:    const int MAX_ITERATIONS = 1000;
 1939:    
 1940:    double t;
 1941:    Side *nextSide = nullptr;
 1942:    double tIntersect = 1e10;
 1943:    double zint = x0.z;
 1944: 
 1945:    // Horizontal tracking loop
 1946:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 1947:    // (x0,y0) is inside the element but the target point is not.
 1948: 
 1949:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1950: 
 1951:    assert(found_intersection && "No intersection found at %d");
 1952: 
 1953:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1954: 
 1955:    // if the tracking segment goes out of water (either dry or edge boundary)
 1956:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1957: 
 1958: addDebugPlot(x0, xt, 0x00A0FF);
 1959:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 1960: addDebugPlot(x0, xt, 0x00A0FF);      
 1961: 
 1962:       nextElem = this;
 1963:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 1964:       // In this case, the caller (btrack) needs to take into account the remaining time.
 1965:       return true;    
 1966:    }
 1967: 
 1968: 
 1969:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 1970:    int iterations = 0;
 1971:    while (iterations < MAX_ITERATIONS) {
 1972:       iterations++;
 1973:       
 1974:       Element *curElem = nextElem;
 1975: 
 1976:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 1977: addDebugPlot(x0, xt);
 1978:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 1979: 
 1980:       // If we are already in the target element, we are done.
 1981:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 1982:       if (!found_intersection) break;
 1983: 
 1984: 
 1985: 
 1986:       // if the tracking segment goes out of water (either dry or edge boundary).
 1987:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 1988: addDebugPlot(x0, xt, 0x00A0FF);
 1989:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 1990: addDebugPlot(x0, xt, 0x00A0FF);   
 1991:          nextElem = curElem;
 1992: 
 1993:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 1994:          // In this case, the caller (btrack) needs to take into account the remaining time.
 1995:          return true;
 1996:       }
 1997:       
 1998:       // Update position and element for next iteration
 1999:       side = nextSide;
 2000: 
 2001:    }
 2002: 
 2003:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2004: 
 2005:  
 2006:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2007:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2008: addDebugPlot(x0, xt);   
 2009:    nextElem->interpolateVelocities(xt, u_int); 
 2010: 
 2011:    return true;
 2012: }
 2013: 
 2014: 
 2015: __inline__ __device__ double Element::computeSignedArea(void) const {
 2016:    // Compute the area of the element
 2017: 
 2018:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2019: 
 2020:    // In the quad case we need to add the area of the other triangle.
 2021:    if (isQuad()) {
 2022:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2023:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2024:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2025:       if (ar1 < 0.0 || ar2 < 0.0 || ar3 < 0.0) {
 2026:          // XXX Aren't we computing a signed area? why is it not allowed to be negative?
 2027:          Error("Negative area found in quad element");
 2028:       }
 2029:       res += ar1;
 2030:    }
 2031: 
 2032:    return res;
 2033: }
 2034: 
 2035: 
 2036: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2037:                                                                 (nodes[1]->isDry2()) ||
 2038:                                                                 (nodes[2]->isDry2()) ||
 2039:                                                                 (i34==4 && nodes[3]->isDry2());
 2040: }
 2041: 
 2042: 
 2043: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2044:    // In boundary sides, the element 1 is nullptr
 2045:    return side->elems[1] == nullptr; 
 2046: }
 2047: 
 2048: 
 2049: 
 2050: /**
 2051:    Compute the shape coordinates of the point (xt,yt) in the element.
 2052:    @param xt (input): x-coordinate of the point
 2053:    @param shpCoords (output): shape coordinates of the point
 2054:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2055:    @return true if the point is inside the element, false otherwise
 2056: **/
 2057: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2058:                                             bool fixNegshpCoord) const {
 2059: 
 2060:    // Compute the shape coordinates of the point xt in the element.
 2061:    if (i34==3) {
 2062:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2063:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2064:       // and in this case, the pt will be nudged into the element
 2065:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2066:       // from the local frame, so use additional check.
 2067: 
 2068:       Point2 x0, x1, x2;
 2069: 
 2070:       if constexpr(ics==1) {
 2071:          x0 = nodes[0]->p2();
 2072:          x1 = nodes[1]->p2();
 2073:          x2 = nodes[2]->p2();
 2074:       }
 2075:       else // lat/lon
 2076:       {
 2077:          Error("Not implemented yet");
 2078: #ifdef ICS2
 2079:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2080:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2081:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2082: #endif
 2083:       }
 2084: 
 2085:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2086:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2087:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2088:       shpCoords[3] = 0.0;
 2089:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2090: 
 2091:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2092:       // then we fix the negative shape coordinates.
 2093:       if (fixNegshpCoord && tmpmin<=0.0) {
 2094: 
 2095:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2096:          // keeping the sum of the shape coordinates equal to 1.
 2097:          // I have tested and compared the new algorithm with the old one, and they give
 2098:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2099:          // The new algorithm should be faster since it is branchless.
 2100:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2101:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2102:          
 2103:          shpCoords[0] = (shpCoords[0] + a)*b;
 2104:          shpCoords[1] = (shpCoords[1] + a)*b;
 2105:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2106: 
 2107:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2108:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2109:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2110:          }
 2111: 
 2112:          // Update the point coordinates for the new shape coordinates
 2113:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2114:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2115:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2116: 
 2117:       }
 2118: 
 2119:       // Check if the point is inside the element
 2120:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2121:    }
 2122:    else {
 2123:       Error("Not implemented yet");
 2124: #ifdef QUADS
 2125:       // Reproject pt in eframe of nel for ics=2
 2126:       if constexpr(ics==1) {
 2127:          xn2 = xt; 
 2128:          yn2 = yt;
 2129:       }
 2130:       else {
 2131:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2132:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2133:       }
 2134: 
 2135:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2136: #endif
 2137:    }
 2138: 
 2139:    return false;  // Never reached
 2140: 
 2141: }
 2142: 
 2143: 
 2144: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2145: // Convert shape coordinates to cartesian coordinates
 2146: 
 2147:    if (i34 == 3) {
 2148:       // Triangular element
 2149:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2150:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2151:    }
 2152:    else {
 2153:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2154:    }
 2155: 
 2156: }
 2157: 
 2158: 
 2159: /**  Interpolate velocities at a given point (xt,yt,zt)
 2160: 
 2161:    @param xt, yt, zt: coordinates of the point to interpolate
 2162:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2163: 
 2164:    This is done in four steps:
 2165: 
 2166:    1. Find the shape coordinates for the final position in the element.
 2167:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2168:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2169:       z levels at xt, yt at each step.   
 2170:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2171:       horizontally and vertically.
 2172: **/
 2173: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2174:    // Interpolate the velocities at the point xt. 
 2175:    // This function works the same for triangular and quadrilateral elements.
 2176:    double shpCoord[4];
 2177: 
 2178:    // First step is to compute the shape coordinates of (xt,yt)
 2179:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2180:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2181: 
 2182:    // Second step is to find the level that contains zt
 2183:    // Uses a binary search to find the level
 2184:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2185:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2186:    int R = nvrt - 1;
 2187: 
 2188:    // Get the z coordinates at the nodes of the element at the levels L and R
 2189:    double zLAtNodes[4], zRAtNodes[4];
 2190:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2191:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2192: 
 2193:    double zL = interpolate(shpCoord, zLAtNodes);
 2194:    double zR = interpolate(shpCoord, zRAtNodes);
 2195:    
 2196:    // Interpolates vertically the velocities
 2197:    double wght1, wght2;
 2198:    if (xt.z<=zL) {
 2199:       wght1 = 1.0;
 2200:       wght2 = 0.0;
 2201:    }
 2202:    else if (xt.z>=zR) {
 2203:       wght1 = 0.0;
 2204:       wght2 = 1.0;
 2205:    }
 2206:    else {
 2207:       // Perform a binary search to find the levels between L and R that contain xt.z
 2208:       while (R - L > 1) {
 2209:          int M = (L + R) / 2;
 2210: 
 2211:          double zMAtNodes[4];
 2212:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2213:          double zM = interpolate(shpCoord, zMAtNodes);
 2214:          if (zM < xt.z) 
 2215:          {
 2216:             L = M;
 2217:             zL = zM;
 2218:          }
 2219:          else 
 2220:          {
 2221:             R = M;
 2222:             zR = zM;
 2223:          }
 2224:       }
 2225:       assert(L == R-1);
 2226:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2227: 
 2228:       wght2 = (xt.z - zL)/(zR - zL);
 2229:       wght1 = 1.0 - wght2;
 2230:    }
 2231: 
 2232:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2233:    u_int = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 2234: 
 2235:    // Neither of the interpolated velocities should be NaN
 2236:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2237: 
 2238: }
