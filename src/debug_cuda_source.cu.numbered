 2086: 
 2087: /**
 2088:    Compute the shape coordinates of the point (xt,yt) in the element.
 2089:    @param xt (input): x-coordinate of the point
 2090:    @param shpCoords (output): shape coordinates of the point
 2091:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2092:    @return true if the point is inside the element, false otherwise
 2093: **/
 2094: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2095:                                             bool fixNegshpCoord) const {
 2096: 
 2097:    // Compute the shape coordinates of the point xt in the element.
 2098:    if (i34==3) {
 2099:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2100:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2101:       // and in this case, the pt will be nudged into the element
 2102:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2103:       // from the local frame, so use additional check.
 2104: 
 2105:       Point2 x0, x1, x2;
 2106: 
 2107:       if constexpr(ics==1) {
 2108:          x0 = nodes[0]->p2();
 2109:          x1 = nodes[1]->p2();
 2110:          x2 = nodes[2]->p2();
 2111:       }
 2112:       else // lat/lon
 2113:       {
 2114:          Error("Not implemented yet");
 2115: #ifdef ICS2
 2116:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2117:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2118:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2119: #endif
 2120:       }
 2121: 
 2122:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2123:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2124:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2125:       shpCoords[3] = 0.0;
 2126:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2127: 
 2128:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2129:       // then we fix the negative shape coordinates.
 2130:       if (fixNegshpCoord && tmpmin<=0.0) {
 2131: 
 2132:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2133:          // keeping the sum of the shape coordinates equal to 1.
 2134:          // I have tested and compared the new algorithm with the old one, and they give
 2135:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2136:          // The new algorithm should be faster since it is branchless.
 2137:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2138:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2139:          
 2140:          shpCoords[0] = (shpCoords[0] + a)*b;
 2141:          shpCoords[1] = (shpCoords[1] + a)*b;
 2142:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2143: 
 2144:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2145:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2146:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2147:          }
 2148: 
 2149:          // Update the point coordinates for the new shape coordinates
 2150:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2151:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2152:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2153: 
 2154:       }
 2155: 
 2156:       // Check if the point is inside the element
 2157:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2158:    }
 2159:    else {
 2160:       Error("Not implemented yet");
 2161: #ifdef QUADS
 2162:       // Reproject pt in eframe of nel for ics=2
 2163:       if constexpr(ics==1) {
 2164:          xn2 = xt; 
 2165:          yn2 = yt;
 2166:       }
 2167:       else {
 2168:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2169:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2170:       }
 2171: 
 2172:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2173: #endif
 2174:    }
 2175: 
 2176:    return false;  // Never reached
 2177: 
 2178: }
 2179: 
 2180: 
 2181: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2182: // Convert shape coordinates to cartesian coordinates
 2183: 
 2184:    if (i34 == 3) {
 2185:       // Triangular element
 2186:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2187:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2188:    }
 2189:    else {
 2190:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2191:    }
 2192: 
 2193: }
