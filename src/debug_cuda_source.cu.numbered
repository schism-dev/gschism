  339: // Polynomial class
  340: template<int grade>
  341: struct Polynomial {
  342:     // Static assertion to give a clear error message at compile time
  343:     static_assert(grade == 4, "Only 4th order polynomials are implemented");
  344: };
  345: 
  346: 
  347: // Explicit specialization for grade 4
  348: template<>
  349: struct Polynomial<4> {
  350:    double a0, a1, a2, a3, a4; // Coefficients a0, a1, a2, a3, a4 for a4*x^4 + a3*x^3 + a2*x^2 + a1*x + a0
  351: 
  352:    // Constructor from coefficients
  353:    __device__ __forceinline__ Polynomial(double a0, double a1, double a2, double a3, double a4) : a0(a0), a1(a1), a2(a2), a3(a3), a4(a4) {}
  354: 
  355:    __device__ __forceinline__ double eval(double x) const {
  356:       return a0 + x*(a1 + x*(a2 + x*(a3 + x*a4)));
  357:    }
  358: };
