 7726: 
 7727: __global__ void computeMatrixProductAndDotProducts() {
 7728:    // Computes A*p, r'Mr and p'Ap
 7729: 
 7730:    // 1) shared buffer: first half for rMr, second for pAp
 7731:    __shared__ double sdata[2*BLOCK_SIZE];
 7732:    double* s_rMr = sdata;
 7733:    double* s_pAp = sdata + BLOCK_SIZE;
 7734: 
 7735:    const int tid = threadIdx.x;
 7736: 
 7737:    double l_pAp = 0.0;
 7738: 
 7739:    s_rMr[tid] = 0.0;
 7740:    s_pAp[tid] = 0.0;
 7741: 
 7742:    // 2) get your node pointer
 7743:    // NODE(node);   
 7744:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7745:    Node *node = &(mesh->localNodeData[idx_node]); 
 7746:       if (idx_node < mesh->np) {
 7747: 
 7748:       const double diag = node->coeffDiag;
 7749:       const double r    = node->mR;
 7750:       const double p    = node->mP;  
 7751: 
 7752:       // apply preconditioner on the fly:
 7753:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7754: 
 7755:       // 4) compute Ap = A.p
 7756:       double Ap = node->coeffDiag * node->mP;
 7757:       for (int j = 0; j < node->numNodes; ++j) {
 7758:          const Node *nbNode = node->nodes[j];
 7759:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7760: 
 7761:       }
 7762: 
 7763:       node->mAp = Ap;
 7764:       
 7765: 
 7766:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7767:       // const double l_rMr = r*Mr;  // r'Mr
 7768:       l_pAp = p*Ap;  // p'Ap
 7769: 
 7770: 
 7771:    }
 7772: 
 7773:    // 6) write into shared mem
 7774:    // s_rMr[tid] = l_rMr;
 7775:    s_pAp[tid] = l_pAp;
 7776: 
 7777:    __syncthreads();
 7778: 
 7779:    // 7) block-wide tree reduction
 7780:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7781:       if (tid < stride)  {
 7782:          s_pAp[tid] += s_pAp[tid + stride];
 7783:       }
 7784:       __syncthreads();
 7785:    }
 7786: 
 7787:    // 8) thread 0 atomically accumulates into the globals
 7788:    // XXX: This is slower than it needs to be, but it is simple and works
 7789:    if (tid == 0) {
 7790:       atomicAdd(pAp, s_pAp[0]);
 7791:    }
 7792: 
 7793: 
 7794: }
 7795: 
 7796: 
 7797: __global__ void updateSolutionAndDotProducts(void) {
 7798:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7799: 
 7800:    const int tid = threadIdx.x;
 7801: 
 7802:    s_rMr[tid] = 0.0;
 7803: 
 7804:    // get node & bounds-check:
 7805:    NODE(node);
 7806: 
 7807:    
 7808:    // Compute alpha
 7809:    const double alpha = (*rMr_old)/(*pAp); 
 7810: 
 7811: 
 7812:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7813: 
 7814: 
 7815:    // load scalars
 7816:    const double diag = node->coeffDiag;
 7817:    const double p    = node->mP;
 7818:    const double Ap   = node->mAp;
 7819:    const double x    = node->mX;
 7820:    const double r    = node->mR;
 7821:    
 7822:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7823: 
 7824:    // 1) update solution & residual
 7825:    const double x_new = x + alpha*p;
 7826:    const double r_new = r - alpha*Ap;
 7827:    node->mX = x_new;
 7828:    node->mR = r_new;
 7829: 
 7830:    // 2) apply Jacobi preconditioner on the fly
 7831:    const double Mr_new = r_new/diag;
 7832: 
 7833: 
 7834:    // 3) local contributions for the two dot-products
 7835:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7836: 
 7837:    // 4) write into shared-mem
 7838:    s_rMr[tid] = l_rMr;
 7839: 
 7840:    __syncthreads();
 7841: 
 7842: 
 7843:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7844:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7845:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7846:       __syncthreads();
 7847:    }
 7848: 
 7849:    // 6) thread 0 atomically folds into the global accumulators
 7850:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7851: 
 7852: 
 7853: }
 7854: 
 7855: 
 7856: __global__ void updateSearchDirection() {
 7857: 
 7858:     NODE(node);
 7859: 
 7860:     // recompute z on-the-fly
 7861:     const double z = node->mR / node->coeffDiag;
 7862:     const double p = node->mP;
 7863: 
 7864:     const double beta = (*rMr_new)/(*rMr_old);
 7865: 
 7866: 
 7867:     // p =z + beta*p
 7868:     node->mP = z + beta*p;
 7869: 
 7870: }
 7871: 
 7872: __global__ void initializeScalars(double *scalars) {
 7873: 
 7874:    // These point to a cupy array in the host code
 7875:    rMr_old = scalars + 0;
 7876:    rMr_new = scalars + 1;
 7877:    pAp     = scalars + 2;
 7878: }
 7879: 
 7880: __global__ void initializePreconditionedResidual(void) {
 7881: 
 7882:     __shared__ double s_rMr[BLOCK_SIZE];  
 7883: 
 7884:     s_rMr[threadIdx.x] = 0.0;
 7885: 
 7886:     NODE_ALL(node, valid);
 7887:     const int tid = threadIdx.x;
 7888:     // For the first iteration:
 7889:     // 1. Initial solution x = 0 (already set)
 7890:     // 2. Initial residual r = b (stored in qel)
 7891:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7892: 
 7893: // XXX we should use the guess solution here    
 7894: 
 7895:     double l_rMr = 0.0;
 7896:     if (valid) {
 7897:       // Set initial residual r = b (from qel)
 7898:       node->mR = node->qel;
 7899: 
 7900:       // Compute z = M^-1 * r (preconditioned residual)
 7901:       const double z = node->mR / node->coeffDiag;
 7902: 
 7903:       // Set initial search direction p = z
 7904:       node->mP = z;
 7905: 
 7906:       // Initialize other variables needed for CG
 7907:       node->mX = 0.0;  // Initial solution
 7908:       node->mAp = 0.0; // Will be computed in first iteration
 7909: 
 7910: 
 7911:       // Computes the first r'Mr (reduction)
 7912:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7913:     }
 7914:     // 4) write into shared-mem
 7915:     s_rMr[tid] = l_rMr;
 7916: 
 7917:     __syncthreads();
 7918: 
 7919: 
 7920:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7921:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7922:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7923:         __syncthreads();
 7924:     }
 7925: 
 7926:     // 6) thread 0 atomically folds into the global accumulators
 7927:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7928: 
 7929:     *rMr_old = 0.0;
 7930:     *pAp = 0.0;
 7931: }
 7932: 
 7933: 
