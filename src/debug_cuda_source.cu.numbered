 4242: 
 4243:    __global__ void scaleGravity(double loadtide_coef) {
 4244: 
 4245: 
 4246:       NODE(node);
 4247: 
 4248:       // SAL option: scale gravity
 4249:       if constexpr(iloadtide==2) {  // simple const
 4250:          node->grav2 = grav*(1.0 - loadtide_coef);
 4251: 
 4252:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4253:         
 4254:           const double depth = max(node->depth, 0.0);
 4255:           const double tmp1 = sqrt(depth);
 4256:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4257:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4258:                              2.6969e-13*depth*depth*depth*tmp1;
 4259:           
 4260:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4261:           
 4262: 
 4263: 
 4264:           node->grav2 = grav*(1.0 - beta_bar);
 4265: 
 4266:       } else {  // iloadtide=0,1
 4267:         node->grav2=grav;
 4268: 
 4269:       }
 4270: 
 4271:    }
 4272: 
