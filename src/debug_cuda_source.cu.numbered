  645: // ----------------------------- Turbulence -----------------------------
  646: 
  647: 
  648: 
  649: constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
  650: constexpr double veg_cfpsi = 0.16;
  651: 
  652: 
  653: template<TurbulenceModel Model>
  654: struct Turbulence {
  655:    __device__ void setDiffLimits(double, double) { assert(false && "setDiffLimits does not exist for this turbulence model"); }
  656: 
  657:    __device__ void init(Node *node) {
  658:       for (int k = 0; k < nvrt; k++) {
  659:          node->dfv[k] = dfv0;
  660:          node->dfh[k] = dfh0;
  661:       }
  662:    }
  663: };   
  664: 
  665: // GLS turbulence model
  666: template<>
  667: struct Turbulence<TurbulenceModel::GLS> {
  668:    using enum TurbulenceSubmodel;
  669:    using enum StabilityModel;
  670: 
  671:    double tke[nvrt];    // TKE
  672:    double mxl[nvrt];    // mixing length for GLS
  673:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  674:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  675: 
  676:    double diffmin;  // from diffmin.gr3
  677:    double diffmax;  // from diffmax.gr3
  678:    
  679:    __device__ void setDiffLimits(double lo, double hi) {
  680:       diffmin = lo;
  681:       diffmax = hi;
  682:    }
  683: 
  684:    // Fortran cold start: q2 = q2min, xl = xlmin2, dfq1 = dfq2 = diffmin.
  685:    // Call after setDiffLimits. depth is the node depth used by xlmin2.
  686:    __device__ void init(Node *node);
  687: 
  688: 
  689:    __device__ __forceinline__ constexpr double cpsi1() const {
  690:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  691:       else if constexpr (turbSubmodel == KL)             return 0.9;
  692:       else if constexpr (turbSubmodel == KE)             return 1.44;
  693:       else if constexpr (turbSubmodel == KW)             return 0.555;
  694:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  695:       else { assert(false && "unknown submodel"); return 0.0; }
  696:    }
  697: 
  698:    
  699:    __device__ __forceinline__ constexpr double cpsi2() const {
  700:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  701:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  702:       else if constexpr (turbSubmodel == KL)             return 0.5;
  703:       else if constexpr (turbSubmodel == KE)             return 1.92;
  704:       else if constexpr (turbSubmodel == KW)             return 0.833;
  705:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  706:       else { assert(false && "unknown submodel"); return 0.0; }
  707:    }
  708: 
  709: 
  710:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  711: 
  712:    __device__ __forceinline__ double cpsi3(double N2) const {
  713: 
  714:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  715:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  716: 
  717:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  718: 
  719:       if constexpr (turbSubmodel == MellorYamada) {
  720:          return 0.9;   
  721: 
  722:       } else { // Other GLS submodels
  723: 
  724: 
  725:          if (N2 > 0.0) { // unstable (inverse stratification)
  726:             return 1.0;   
  727: 
  728:          } else { // stable (regular stratification)
  729: 
  730:             if      constexpr (turbSubmodel == KL)             return 2.53;
  731:             else if constexpr (turbSubmodel == KE)             return -0.52;
  732:             else if constexpr (turbSubmodel == KW)             return -0.58;
  733:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  734:             else { assert(false && "unknown submodel"); return 0.0; }
  735:          }
  736: 
  737:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  738: 
  739:    }
  740: 
  741:    
  742:    __device__ __forceinline__ constexpr double rpub(void) const {
  743:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  744:       else if constexpr (turbSubmodel == KL)             return  0.0;
  745:       else if constexpr (turbSubmodel == KE)             return  3.0;
  746:       else if constexpr (turbSubmodel == KW)             return -1.0;
  747:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  748:       else { assert(false && "unknown submodel"); return 0.0; }
  749:    }
  750: 
  751: 
  752:    __device__ __forceinline__ constexpr double rmub(void) const {
  753:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  754:       else if constexpr (turbSubmodel == KL)             return 1.0;
  755:       else if constexpr (turbSubmodel == KE)             return 1.5;
  756:       else if constexpr (turbSubmodel == KW)             return 0.5;
  757:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  758:       else { assert(false && "unknown submodel"); return 0.0; }
  759:    }
  760: 
  761: 
  762:    __device__ __forceinline__ constexpr double rnub(void) const {
  763:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  764:       else if constexpr (turbSubmodel == KL)             return  1.0;
  765:       else if constexpr (turbSubmodel == KE)             return -1.0;
  766:       else if constexpr (turbSubmodel == KW)             return -1.0;
  767:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  768:       else { assert(false && "unknown submodel"); return 0.0; }
  769:    }
  770: 
  771: 
  772:    __device__ __forceinline__ constexpr double schk(void) const {
  773:       if      constexpr (turbSubmodel == KL)             return 2.44;
  774:       else if constexpr (turbSubmodel == KE)             return 1.0;
  775:       else if constexpr (turbSubmodel == KW)             return 2.0;
  776:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  777:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  778:    }
  779: 
  780: 
  781:    __device__ __forceinline__ constexpr double schpsi(void) const {
  782:       if      constexpr (turbSubmodel == KL)             return 2.44;
  783:       else if constexpr (turbSubmodel == KE)             return 1.3;
  784:       else if constexpr (turbSubmodel == KW)             return 2.0;
  785:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  786:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  787:    }
  788: 
  789: 
  790:    __device__ __forceinline__ constexpr double tkemin(void) const {
  791:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  792:          return 5.0e-6;
  793:       else
  794:          return 7.6e-6; // Warner et al., OM 2005
  795:    }
  796: 
  797: 
  798:    __device__ __forceinline__ constexpr double psimin(void) const {
  799:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  800:          return 1.0e-8;
  801:       else
  802:          return 1.0e-12; // Warner et al., OM 2005
  803:    }
  804: 
  805:    __device__ __forceinline__ constexpr double epsmin(void) const {
  806:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  807:    }
  808: 
  809:    __device__ __forceinline__ double mxlmin(double depth) const;
  810: 
  811:    
  812:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  813: 
  814:    __device__ __forceinline__ double N2(Node *node, int k) const;
  815: 
  816: 
  817:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  818: 
  819:    __device__ void computeDiffusivities(Node *node);
  820: 
  821:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  822: 
  823: 
  824:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  825:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  826:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  827:    }
  828: 
  829: 
  830:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  831:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  832:    }
  833: 
  834: };
  835: 
