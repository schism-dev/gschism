 2083:    template<typename T>
 2084:    __device__ __forceinline__ void Element::getNodalValues(int level, T (Node::* field)[nvrt], T res[4]) const {
 2085: 
 2086:       assert(level >= 0 && level < nvrt && "Level is out of range");
 2087:       // Get the values of the field at the nodes of the element
 2088:       res[0] = (nodes[0]->*field)[max(level, nodes[0]->kb)];
 2089:       res[1] = (nodes[1]->*field)[max(level, nodes[1]->kb)];
 2090:       res[2] = (nodes[2]->*field)[max(level, nodes[2]->kb)];
 2091:       if (isQuad()) res[3] = (nodes[3]->*field)[max(level, nodes[3]->kb)];
 2092:       else          res[3] = T();
 2093:    }    
