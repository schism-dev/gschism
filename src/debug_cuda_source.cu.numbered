 1303: // This struct is used to store the boundary information for a node.
 1304: struct NodeBoundary {   
 1305:    int idx;
 1306:    BoundarySegment *segment;
 1307:    Node *node;
 1308:    
 1309:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1310:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1311: 
 1312:    bool isLand;
 1313: 
 1314:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1315:    double elbc;   // Elevation boundary condition
 1316:    double eth;    // Elevation time history
 1317: 
 1318:    double eta_mean; // Mean elevation at nodes
 1319: 
 1320:    bool isEssentialBC;
 1321: 
 1322:    Vector2 uth[nvrt];  // "Time history" velocity
 1323: 
 1324:    // Arrays for harmonic constituents (if needed)
 1325:    double  emo[nbfr];  // Elevation amplitude
 1326:    double  efa[nbfr];  // Elevation phase
 1327:    Vector2 umo[nbfr];  // velocity amplitude
 1328:    Vector2 ufa[nbfr];  // velocity phase
 1329: 
 1330: 
 1331:    NodeBoundary(void) {
 1332:       isLand = false;
 1333:    }
 1334:    NodeBoundary(bool _isLand) {
 1335:       isLand = _isLand;
 1336:    }
 1337: 
 1338:    
 1339:    __forceinline__ __device__ int numSidesForAverage() const {
 1340:    // Returns the number of sides that are connected to the node and have the same segment.
 1341:    // This is used to compute the average velocity at the node for open boundary nodes.
 1342:       int res = 0;
 1343:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1344:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1345: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1346:       return res;
 1347:    }
 1348: 
 1349: 
 1350:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1351:       assert(index == 0 || index == 1); 
 1352:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1353:    }
 1354: 
 1355: 
 1356: };
