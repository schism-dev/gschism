 1588:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1589:       // Compute the different time ramps used in the code 
 1590:       // This function is performed by just one thread
 1591: 
 1592:       if constexpr(ibc == 0) {
 1593:          if (drampbc > 0.0) {
 1594:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1595:          } else {
 1596:             rampbc = 1.0;
 1597:          }
 1598: 
 1599:          if (nws != 0 && drampwind > 0.0) {
 1600:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1601:          } else {
 1602:             rampwind = 1.0;
 1603:          }
 1604:       }
 1605: 
 1606:       if (drampwafo > 0.0) {
 1607:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1608:       } else {
 1609:          rampwafo = 1.0;
 1610:       }
 1611: 
 1612:       // For source/sinks
 1613:       if (if_source && dramp_ss > 0.0) {
 1614:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1615:       } else {
 1616:          ramp_ss = 1.0;
 1617:       }
 1618: 
 1619:       if (dramp > 0.0) {
 1620:          ramp = tanh(2.0*time/86400.0/dramp);
 1621:       } else {
 1622:          ramp = 1.0;
 1623:       }
 1624: 
 1625:    }
