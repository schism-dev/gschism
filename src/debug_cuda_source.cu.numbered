 3771: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3772:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3773:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3774:                 int *isdel, int *isidenode, int *isbnd,
 3775:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3776:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3777:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3778:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3779:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3780:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3781:                 double *drag, double *roughness,
 3782:                 double *emo, double *efa, 
 3783:                 double *umo, double *ufa, 
 3784:                 double *vmo, double *vfa) {
 3785: 
 3786:    printf("Populating mesh for partition %d\n", partNum);
 3787: 
 3788:    // XXXXXX THIS function does almost nothing. 
 3789: 
 3790:    nbs = *sharedIdxSideBoundary + 1;
 3791:    nbp = *sharedIdxNodeBoundary + 1;
 3792: 
 3793:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3794: 
 3795: }
 3796: 
 3797: 
 3798: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3799:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3800:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3801: 
 3802: 
 3803:    NODE(node1);
 3804: 
 3805:    node1->clearMatrixRow();
 3806:    node1->qel = 0.0;
 3807: 
 3808:    // THIS IS FOR STRUCTURES XXX
 3809:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3810: 
 3811:    
 3812:    for (int j=0; j<node1->numElements; j++) {
 3813:       // For each element connected to the node...
 3814: 
 3815:       Element *elem = node1->elements[j];
 3816: 
 3817: 
 3818: 
 3819:       // Compute the average gravity
 3820:       const double grav3 = elem->mean(&Node::grav2);
 3821: 
 3822:       // Look at the documentation for the description of the terms in the following integrals
 3823: 
 3824:       // Integral I_1 
 3825:       // \bar{\breve{H}} 
 3826:       const double hhatb = elem->mean(&Side::hhat);        
 3827: 
 3828:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3829: 
 3830:       const int id1 = elem->nodeLocalIdx(node1); 
 3831:       const double area = elem->area;
 3832: 
 3833:       if (elem->isTri()) {
 3834: 
 3835:          // To clarify the notation in this section: 
 3836:          //   i stands for the node under consideration (node1)
 3837:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3838:          const int id2 = elem->nxq(1 + id1);
 3839:          const int id3 = elem->nxq(2 + id1);
 3840:          Node *node2 = elem->nodes[id2];
 3841:          Node *node3 = elem->nodes[id3];
 3842: 
 3843:          Point2 x1, x2, x3;
 3844:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3);
 3845: 
 3846:          // integral of phi_i*phi_j
 3847:          const double ipp_ii = (1.0/6.0 )*area;
 3848:          const double ipp_ij = (1.0/12.0)*area;
 3849:          const double ipp_ik = (1.0/12.0)*area;
 3850: 
 3851:          // integral of [(grad phi_i) * (grad phi_j)]
 3852:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3853:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3854:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3855: 
 3856:          // Computes the different components of integral I_1 of each node with respect to node i.
 3857:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3858:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3859:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3860: 
 3861:          node1->addToSparseMatrix(node1, I1_ii);
 3862:          node1->addToSparseMatrix(node2, I1_ij); 
 3863:          node1->addToSparseMatrix(node3, I1_ik);
 3864: 
 3865:       }
 3866:       else { // Quad
 3867:          // XXX IMPLEMENT THIS
 3868:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3869: 
 3870:          // To clarify the notation in this section: 
 3871:          //   i stands for the node under consideration (node1)
 3872:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3873:          const int id2 = elem->nxq(1 + id1);
 3874:          const int id3 = elem->nxq(2 + id1);
 3875:          const int id4 = elem->nxq(3 + id1);
 3876:          Node *node2 = elem->nodes[id2];
 3877:          Node *node3 = elem->nodes[id3];
 3878:          Node *node4 = elem->nodes[id4];         
 3879: 
 3880:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3881:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3882:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3883:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3884:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3885: 
 3886:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3887:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3888:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3889:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3890:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3891: 
 3892:          // Computes the different components of integral I_1 of each node with respect to node i.
 3893:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3894:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3895:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3896:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3897: 
 3898:          node1->addToSparseMatrix(node1, I1_ii);
 3899:          node1->addToSparseMatrix(node2, I1_ij); 
 3900:          node1->addToSparseMatrix(node3, I1_ik);
 3901:          node1->addToSparseMatrix(node4, I1_il);
 3902:   
 3903:       } 
 3904: 
 3905:  
 3906:       // Integral I_4
 3907:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3908:       // Where
 3909:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3910: 
 3911:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3912:       // of U over the element.
 3913:       Vector2 U = {0.0, 0.0};
 3914:       for (int m=0; m < elem->i34; m++) {      
 3915:          const Side *side = elem->sides[m];
 3916: 
 3917:          if constexpr(ics == 1) U += side->U; 
 3918:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 3919:       }
 3920:       U = U/elem->i34;
 3921: 
 3922: 
 3923:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3924: 
 3925: 
 3926:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3927:       const double I_4_1 = dot(gradPhi_1, U);
 3928: 
 3929: 
 3930:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3931:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3932: 
 3933:      
 3934:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3935: 
 3936:       // Additional terms 
 3937:       double vnorm = 0.0;
 3938:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3939:          Vector3 ubed = {0.0, 0.0, 0.0};
 3940:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3941: 
 3942:          Vector3 gradP = {0.0, 0.0, 1.0};
 3943:          for (int m=0; m < elem->i34; m++) {
 3944:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3945:            gradP += toVector3(gradP_2D, 0.0);
 3946:          }   
 3947:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3948:       } // imm==2
 3949: 
 3950:       if (elem->isTri()) {
 3951:          for (int l=0; l<3; l++) {
 3952: 
 3953:             Node *node = elem->nodes[l];
 3954: 
 3955:             double fac = (node == node1) ? 2.0 : 1.0;
 3956:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3957:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3958:            
 3959:          }
 3960: 
 3961: 
 3962:          if (!elem->isDry) {
 3963:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3964: 
 3965:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3966: 
 3967:          }
 3968: 
 3969:       } // isTri
 3970:       else { // isQuad
 3971:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3972:          // for (int l=0; l<4; l++) {
 3973:          //   const Node *node = elem->nodes[l];
 3974: 
 3975:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3976:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3977: 
 3978:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3979:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3980:          // }
 3981: 
 3982:       } // isQuad
 3983: 
 3984: 
 3985:      node1->qel += (dt/elem->i34)*elem->vsource;
 3986:       
 3987: 
 3988:    } // for all elements connected to the node
 3989:    
 3990: 
 3991:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3992:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3993:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3994:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3995:       // If it is an open boundary node...
 3996: 
 3997:       // At least one open bnd side, maybe two
 3998:       for (int l=0; l<2; l++) { 
 3999: 
 4000:          // Gets each of the sides sharing the node. 
 4001:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4002: 
 4003:        
 4004: 
 4005:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4006:          if (sideBnd != nullptr) {
 4007:             // If the side is on a boundary...
 4008: 
 4009:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4010: 
 4011:             // Get the boundary segment
 4012:             const BoundarySegment *sideSegment = sideBnd->segment;
 4013:             const Side *side = sideBnd->side;
 4014: 
 4015:             // Integral I_3
 4016:             if (sideSegment->ifltype != 0) {
 4017:             // Natural or Flather b.c.
 4018: 
 4019:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4020:                // especially for Flather b.c.
 4021:                double ri3 = 0.0;
 4022:                if (!side->isDry) {
 4023:                   // If the side is not dry
 4024:                   
 4025:                   // Computes the side flux of (uth, vth)
 4026:                   double Vn = 0.0;
 4027:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4028:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4029:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4030: 
 4031:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4032:                   }
 4033: 
 4034:                   ri3 = 0.5*side->len*Vn;
 4035:                }
 4036: 
 4037:                if (sideSegment->ifltype == -1) { // Flather 1
 4038: 
 4039:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4040:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4041: 
 4042:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4043:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4044:                   
 4045:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4046:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4047: 
 4048:                } 
 4049:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4050:                   // Reset ri3
 4051:                   ri3 = 0.0;
 4052: 
 4053:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4054: 
 4055:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4056: 
 4057:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4058:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4059: 
 4060:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4061:                   node1->addToSparseMatrix(node1, con0*2.0);
 4062:                   node1->addToSparseMatrix(node2, con0);
 4063: 
 4064:                } // if Flather or Discharge
 4065: 
 4066:                node1->qel -= thetai*dt*ri3;
 4067: 
 4068: 
 4069:             } // I_3
 4070:           
 4071: 
 4072:             // Integral I_5
 4073:             if(!side->isDry) {
 4074: 
 4075:                const double Unbar = dot(side->U, side->n);
 4076:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4077: 
 4078:             } // I_5
 4079: 
 4080:          } // if is boundary side
 4081: 
 4082:       } // for l
 4083: 
 4084:    } // if isbnd
 4085: 
 4086: 
 4087: }
 4088: 
 4089: 
 4090: 
 4091: extern "C" {
 4092:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4093:                                   int* indices, int* indptr) {
 4094: 
 4095:       NODE(node);
 4096:       
 4097:       const int idx = node->idx;
 4098:       
 4099:       // Computes the index in the nzz array      
 4100:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4101: 
 4102: 
 4103:       indptr[idx] = nzzIdx;
 4104:       indices[nzzIdx] = idx;
 4105: 
 4106:       data_d[nzzIdx]    = node->coeffDiag;
 4107: 
 4108:       b_d[idx] = node->qel;
 4109: 
 4110:       for (int k = 0; k < node->numNodes; ++k) {
 4111:          const Node* nb = node->nodes[k];
 4112: 
 4113:          const int j = nb->idx;
 4114: 
 4115:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4116: 
 4117:          indices[nzzIdx + k + 1] = j;
 4118:       }
 4119: 
 4120:  
 4121:    }
