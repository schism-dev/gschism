 1310: // This struct is used to store the boundary information for a node.
 1311: struct NodeBoundary {   
 1312:    int idx;
 1313:    BoundarySegment *segment;
 1314:    Node *node;
 1315:    
 1316:    SideBoundary *sideBnd1; // Pointer to the boundary side object (can be nullptr)
 1317:    SideBoundary *sideBnd2; // Pointer to the boundary side object (can be nullptr)
 1318: 
 1319:    bool isLand;
 1320: 
 1321:    double etaic;  // Elevation at nodes used for essential boundary conditions XXXX Where is this value set???
 1322:    double elbc;   // Elevation boundary condition
 1323:    double eth;    // Elevation time history
 1324: 
 1325:    double eta_mean; // Mean elevation at nodes
 1326: 
 1327:    bool isEssentialBC;
 1328: 
 1329:    Vector2 uth[nvrt];  // "Time history" velocity
 1330: 
 1331:    // Arrays for harmonic constituents (if needed)
 1332:    double  emo[nbfr];  // Elevation amplitude
 1333:    double  efa[nbfr];  // Elevation phase
 1334:    Vector2 umo[nbfr];  // velocity amplitude
 1335:    Vector2 ufa[nbfr];  // velocity phase
 1336: 
 1337: 
 1338:    NodeBoundary(void) {
 1339:       isLand = false;
 1340:    }
 1341:    NodeBoundary(bool _isLand) {
 1342:       isLand = _isLand;
 1343:    }
 1344: 
 1345:    
 1346:    __forceinline__ __device__ int numSidesForAverage() const {
 1347:    // Returns the number of sides that are connected to the node and have the same segment.
 1348:    // This is used to compute the average velocity at the node for open boundary nodes.
 1349:       int res = 0;
 1350:       if (sideBnd1 != nullptr && sideBnd1->segment == segment) res++;
 1351:       if (sideBnd2 != nullptr && sideBnd2->segment == segment) res++;
 1352: printf("numSidesForAverage: res = %d, segment = %p, sideBnd1 = %p, sideBnd2 = %p\n", res, segment, sideBnd1, sideBnd2);      
 1353:       return res;
 1354:    }
 1355: 
 1356: 
 1357:    __forceinline__ __device__ SideBoundary *sideBnd(int index) { 
 1358:       assert(index == 0 || index == 1); 
 1359:       return (index == 0) ? sideBnd1 : sideBnd2; 
 1360:    }
 1361: 
 1362:    __forceinline__ __device__ void linkSideBoundary(SideBoundary *sb) {
 1363:       if (isLand) return;  // land never uses these links
 1364:       SideBoundary *null = nullptr;
 1365:       if (atomicCAS((unsigned long long *)&sideBnd1,
 1366:                   (unsigned long long)null,
 1367:                   (unsigned long long)sb) == (unsigned long long)null)
 1368:          return;
 1369:       if (atomicCAS((unsigned long long *)&sideBnd2,
 1370:                   (unsigned long long)null,
 1371:                   (unsigned long long)sb) == (unsigned long long)null)
 1372:          return;
 1373:       // both slots taken — OK if this side was already linked
 1374:       assert(sideBnd1 == sb || sideBnd2 == sb);
 1375:    }
 1376: 
 1377: 
 1378: };
