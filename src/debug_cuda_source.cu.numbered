 5583:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5584:                                  int* indices, int* indptr) {
 5585:       // XXXXXXXXXXXX REMOVE!!!
 5586:       assert(false && "setupCGSolver has beed deprecated");
 5587: 
 5588:       // NODE(node);
 5589:       
 5590:       // const int idx = node->idx;
 5591:       
 5592:       // // Computes the index in the nzz array      
 5593:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5594: 
 5595: 
 5596:       // indptr[idx] = nzzIdx;
 5597:       // indices[nzzIdx] = idx;
 5598: 
