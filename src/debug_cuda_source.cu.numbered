 2379: 
 2380: __device__ __forceinline__ Point2 Element::getLocalHorizontalNodePosition(int idxNode) const {
 2381: // Local horizontal node position in the element frame. idxNode = 0,1,2,3
 2382: // "Local" here means that the coordinates are in the element frame where the element is horizontal.
 2383: // Only when ics == 2, the origin is at the element center.
 2384: 
 2385:    assert(idxNode < i34 && idxNode >= 0 && "getLocalHorizontalNodePosition: idxNode out of range");
 2386: 
 2387:    const Node *node = nodes[idxNode];
 2388: 
 2389:    if constexpr(ics==1) {
 2390:       return node->p;
 2391: 
 2392:    } else {
 2393:       const Vector3 c = {center.x, center.y, centerZ()}; // Element center
 2394: 
 2395:       const Point3 p = toPoint3(node->p, node->gz); // XXXXX use p3D or similar?
 2396: 
 2397:       return toVector2(frame.G2L(p - c));  // Vectors are implicitly cast into points (in this case at the local frame centered at c)
 2398:    }
 2399: 
 2400: }
 2401: 
 2402: 
 2403: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, 
 2404:                                                                             const Vector3& c, const Frame<ics>& dstFrame, int idx) const {
 2405: // Performs "getLocalHorizontalNodePosition" for the three nodes of the triangle.
 2406: 
 2407:    const int id1 = idx;
 2408:    const int id2 = nxq(1 + id1);
 2409:    const int id3 = nxq(2 + id1);
 2410: 
 2411:    if constexpr(ics==1) {
 2412:       x0 = nodes[id1]->p;
 2413:       x1 = nodes[id2]->p;
 2414:       x2 = nodes[id3]->p;
 2415: 
 2416:    } else {
 2417: 
 2418:       const Point3 p0 = toPoint3(nodes[id1]->p, nodes[id1]->gz); // XXXXX use p3D or similar?
 2419:       const Point3 p1 = toPoint3(nodes[id2]->p, nodes[id2]->gz);
 2420:       const Point3 p2 = toPoint3(nodes[id3]->p, nodes[id3]->gz);
 2421: 
 2422:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2423:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2424:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2425: 
 2426:    }
 2427: 
 2428: }
 2429: 
 2430: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsTri(Point2 &x0, Point2 &x1, Point2 &x2, int idx) const {
 2431:    getLocalHorizontalNodePositionsTri(x0, x1, x2, {center.x, center.y, centerZ()}, frame, idx);
 2432: }
 2433: 
 2434: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2435:             Point2 &x0, Point2 &x1, Point2 &x2, Point2 &x3,
 2436:             const Vector3& c, const Frame<ics>& dstFrame) const {
 2437: // Performs "getLocalHorizontalNodePosition" for the four nodes of the quad.
 2438: 
 2439:    assert(isQuad() && "getLocalHorizontalNodePositionsQuad only works for quads");
 2440: 
 2441: 
 2442: 
 2443:    if constexpr(ics==1) {
 2444:       x0 = nodes[0]->p;
 2445:       x1 = nodes[1]->p;
 2446:       x2 = nodes[2]->p;  
 2447:       x3 = nodes[3]->p;
 2448: 
 2449:    } else {
 2450: 
 2451:       const Point3 p0 = toPoint3(nodes[0]->p, nodes[0]->gz); // XXXXX use p3D or similar?
 2452:       const Point3 p1 = toPoint3(nodes[1]->p, nodes[1]->gz);
 2453:       const Point3 p2 = toPoint3(nodes[2]->p, nodes[2]->gz);
 2454:       const Point3 p3 = toPoint3(nodes[3]->p, nodes[3]->gz);
 2455: 
 2456:       x0 = toVector2(dstFrame.G2L(p0 - c));  // Vectors are implicitly cast into points at the local frame centered at c
 2457:       x1 = toVector2(dstFrame.G2L(p1 - c));
 2458:       x2 = toVector2(dstFrame.G2L(p2 - c));
 2459:       x3 = toVector2(dstFrame.G2L(p3 - c));
 2460:    }
 2461: 
 2462: }
 2463: 
 2464: __device__ __forceinline__ void Element::getLocalHorizontalNodePositionsQuad(
 2465:    Point2& x0, Point2& x1, Point2& x2, Point2& x3) const
 2466: {
 2467:    getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, {center.x, center.y, centerZ()}, frame);
 2468: }
 2469: 
 2470: 
 2471: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 2472: // Computes the *local* (element frame) 3D normal vector to the element at level k
 2473: // Returns the normal vector and the area of the element at this level
 2474:    
 2475:    double nx, ny, nz;
 2476: 
 2477:    if (isTri()) {
 2478:       // For triangles...
 2479: 
 2480:       // Indices of the nodes at level k, taking care of not going below the bed
 2481:       const int k0 = max(k, nodes[0]->kb);
 2482:       const int k1 = max(k, nodes[1]->kb);
 2483:       const int k2 = max(k, nodes[2]->kb);
 2484: 
 2485:       // Gets the element frame coordinates of the nodes at level k
 2486:       Point3 x0, x1, x2;
 2487:       if constexpr(ics==1) { // XXX/ I think that we can use always ics==2 because it is more general.
 2488:          x0 = toPoint3(nodes[0]->p, nodes[0]->z[k0]);
 2489:          x1 = toPoint3(nodes[1]->p, nodes[1]->z[k1]);
 2490:          x2 = toPoint3(nodes[2]->p, nodes[2]->z[k2]);
 2491: 
 2492:       } else {  // ics == 2
 2493:          Point2 h0, h1, h2;
 2494: 
 2495:          getLocalHorizontalNodePositionsTri(h0, h1, h2);
 2496: 
 2497:          x0 = toPoint3(h0, nodes[0]->z[k0]);
 2498:          x1 = toPoint3(h1, nodes[1]->z[k1]);
 2499:          x2 = toPoint3(h2, nodes[2]->z[k2]);
 2500:       }
 2501: 
 2502:       const Vector3 n20 = x2 - x0;
 2503:       const Vector3 n10 = x1 - x0; 
 2504: 
 2505:       // Computes the cross product of vectors n20 and n10. 
 2506:       nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 2507:       ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 2508:       nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 2509: 
 2510:   
 2511:    }
 2512:    else {
 2513:       // For quads...
 2514:       Point2 h0, h1, h2, h3;
 2515: 
 2516:       getLocalHorizontalNodePositionsQuad(h0, h1, h2, h3);
 2517: 
 2518:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2519:       // WARNING: For the vertical coordinate we are assuming that z = 0 in the element frame coincides with the 0 level of the ellipsoid.
 2520:       const Vector3 n20 = toVector3(h2 - h0, nodes[2]->z[k] - nodes[0]->z[k]);
 2521:       const Vector3 n31 = toVector3(h3 - h1, nodes[3]->z[k] - nodes[1]->z[k]);
 2522: 
 2523:       // Computes the cross product of the two diagonals (h2 - h0) and (h3 - h1). 
 2524:       nx = n20.y*n31.z - n20.z*n31.y;
 2525:       ny = n20.z*n31.x - n20.x*n31.z;
 2526:       nz = n20.x*n31.y - n20.y*n31.x;
 2527: 
 2528:    }
 2529: 
 2530:    const double len = sqrt(nx*nx + ny*ny + nz*nz);
 2531:    area3D = 0.5*len;
 2532: 
 2533:    const double inv_len = 1.0/len;
 2534: 
 2535:    return {nx*inv_len, ny*inv_len, nz*inv_len};
 2536: 
 2537: }
 2538: 
 2539: 
 2540: // Helper functions to get the 2D local node position for the Celestial walk
 2541: __device__ __forceinline__ Point2 Element::getLocalNodePosition(int idx, const Side* origSide) const {
 2542:    const int idx2 = (isTri() && idx == 3) ? 2 : idx;
 2543:    const Node *node = getNodeInOrder(idx2);
 2544: 
 2545:    double z = 0.0;
 2546:    if constexpr(ics == 2) z = node->gz;
 2547:    
 2548:    Point3 p = toPoint3(node->p, z);
 2549: 
 2550:    return toPoint2(origSide->toLocalFrame(p));
 2551: }
 2552: 
 2553: __device__ __forceinline__ Node *Element::getNodeInOrder(int idx) const {
 2554:    return (ssign[idx] > 0) ? sides[idx]->n1 : sides[idx]->n2;
 2555: }
 2556: 
 2557: __device__ __forceinline__ void Element::computePredicates(const Point2 x0, const Point2& xt, double &fac, const Side* origSide,
 2558:                                 Bool4& isLeft, Bool4& isObtuse, Bool4& isBisector, int jlev) const
 2559: // Computes the three per-side predicates needed for the celestial walk
 2560: // (Kuijper, Ermolaev, Devillers, JCGT 7(3), 2018, arXiv:1710.01620).
 2561: //
 2562: // xt is in local frame coordinates for origSide if ics == 2.
 2563: //
 2564: // All work is done unconditionally on 4 sides to keep CUDA threads uniform.
 2565: // For triangles, side 3 is a sentinel: getNode(3) returns getNode(2), making
 2566: // corners[3] == corners[2] and s3 == (0, 0). Predicates that would be
 2567: // meaningless on triangles are masked to a safe value (see comments below).
 2568: {
 2569:    // Project all 4 corner positions once into the local 2D frame.
 2570:    // For triangles, C[3] == C[2] (no garbage, but geometrically degenerate).
 2571:    // getLocalNodePosition only transforms/projects if ics == 2.
 2572:    const Point2 C[4] = {getLocalNodePosition(0, origSide), 
 2573:                         getLocalNodePosition(1, origSide), 
 2574:                         getLocalNodePosition(2, origSide), 
 2575:                         getLocalNodePosition(3, origSide)};
 2576: 
 2577:    // Computes the maximum distance from the starting point to the farthest element node projected on the segment x0xt.
 2578:    // This has nothing to do with the original celestial walk. It is used in the Leaded Celestial 
 2579:    //Walk algorithm to find a point on the segment x0xt that is as close as possible to the starting point,
 2580:    // But still farther towards the target point from the current point.
 2581:    const Vector2 vt0 = xt - x0;
 2582:    double maxProjDist = max(dot(vt0, C[0] - x0), dot(vt0, C[1] - x0));
 2583:    maxProjDist = max(maxProjDist, dot(vt0, C[2] - x0)); 
 2584:    maxProjDist = isQuad() ? max(maxProjDist, dot(vt0, C[3] - x0)) : maxProjDist;
 2585: 
 2586:    fac = max(1.00001*fac, min(1.0, (maxProjDist/dot(vt0, vt0))*1.00001));
 2587:    const Vector2 ixt = x0 + (xt - x0)*fac;
 2588: 
 2589: 
 2590: // if (origSide->idx == 2860848 && jlev == 46) {
 2591: // showPoints(toPoint3(x0,0.0), toPoint3(xt,0.0), jlev, origSide, 0xFF0000u, 'x', 1, 0, 0);
 2592: // showPoints(toPoint3(ixt,0.0), toPoint3(ixt,0.0), jlev, origSide, 0x00FF00u, 'o', 1, 0, 0);
 2593: // printf("this->idx = %d, origSide->idx = %d, ixt = (%.17f, %.17f), x0 = (%.17f, %.17f), xt = (%.17f, %.17f), fac = %.17f\n", this->idx, origSide->idx, ixt.x, ixt.y, x0.x, x0.y, xt.x, xt.y, fac);
 2594: // }
 2595:    // Side I goes from corners[I] to corners[nxq(I+1)] in CCW perimeter order.
 2596:    // (Note: with corners built from getNode in CCW order, no ssign factor is needed
 2597:    //  here the orientation is baked into the corners array.)
 2598:    const int i3 = nxq(3);
 2599:    const Vector2 s0 = C[ 1] - C[ 0];
 2600:    const Vector2 s1 = C[ 2] - C[ 1];
 2601:    const Vector2 s2 = C[i3] - C[ 2];
 2602:    const Vector2 s3 = C[ 0] - C[i3];
 2603:    
 2604:    // Side I goes from C[I] to C[nxq(I+1)] in CCW perimeter order.
 2605:    // The corners array is built from getNode in CCW order, so the orientation
 2606:    // is already correct and no ssign factor is needed in the formulas below.
 2607:    //
 2608:    // i3 = nxq(3): the index of the corner after side 2.
 2609:    //   Triangle: i3 == 0 (the closing corner of the triangle).
 2610:    //   Quad:     i3 == 3.
 2611:    //
 2612:    // The four side direction vectors. For triangles, s3 == (0, 0) since
 2613:    // C[i3] == C[0] (the perimeter has already closed by side 2).
 2614:    isLeft.set(0,  cross(s0, ixt - C[ 0]) > -small);
 2615:    isLeft.set(1,  cross(s1, ixt - C[ 1]) > -small);
 2616:    isLeft.set(2,  cross(s2, ixt - C[ 2]) > -small);
 2617:    isLeft.set(3, (cross(s3, ixt - C[i3]) > -small) || isTri());  
 2618: 
 2619: // printf("idx = %d, cross(s0, xt - C[ 0] ) = %.17f, cross(s1, xt - C[ 1] ) = %.17f, cross(s2, xt - C[ 2] ) = %.17f, cross(s3, xt - C[i3] ) = %.17f\n", idx, cross(s0, xt - C[ 0] ), cross(s1, xt - C[ 1] ), cross(s2, xt - C[ 2] ), cross(s3, xt - C[i3] ));
 2620: 
 2621:    // For triangles, the corner after side 2 is the closing corner where
 2622:    // side 2 meets side 0 (not side 3, which doesn't exist). The "next side
 2623:    // tangent" used by isObtuse and isBisector at that corner is therefore
 2624:    // s0 for triangles, s3 for quads.
 2625:    const Vector2 s3_tri = isTri() ? s0 : s3;
 2626: 
 2627:    // isObtuse.b[I]: true iff the internal face angle at the corner after
 2628:    // side I is obtuse. Equivalent to dot of consecutive side directions > 0
 2629:    // (acute "turn angle" along the perimeter = obtuse internal angle).
 2630:    //
 2631:    // isObtuse.b[3] for triangles: dot(s3, s0) = dot(0, s0) = 0, so the
 2632:    // result is false naturally. No sentinel needed.
 2633:    isObtuse.set(0, dot(s0, s1) > 0.0);
 2634:    isObtuse.set(1, dot(s1, s2) > 0.0);
 2635:    isObtuse.set(2, dot(s2, s3_tri) > 0.0);  // triangle: closes back to s0
 2636:    isObtuse.set(3, dot(s3, s0) > 0.0);  // Always false for triangles (s3=(0,0))
 2637: 
 2638:    // isBisector.b[I]: at the corner after side I, this tests whether xt is
 2639:    // on the "exit through side I" half of the corner cone, separated by the
 2640:    // approximate angular bisector of the celestial walk. The bisector is
 2641:    // perpendicular to the chord across the corner; the test is the sign of
 2642:    // (xt - corner_vertex) projected onto that chord.
 2643:    //
 2644:    // isBisector.b[3] is always masked out by isLeft.b[3] = true for triangles
 2645:    // (the validity rule sets valid_3 = false), so its computed value for
 2646:    // triangles doesn't matter. No sentinel needed.
 2647:    isBisector.set(0, dot(ixt - C[ 1], s0 + s1) < 0.0);
 2648:    isBisector.set(1, dot(ixt - C[ 2], s1 + s2) < 0.0);
 2649:    isBisector.set(2, dot(ixt - C[i3], s2 + s3_tri) < 0.0);
 2650:    isBisector.set(3, dot(ixt - C[ 0], s3 + s0) < 0.0);   
 2651: 
 2652: }
 2653: 
 2654: 
 2655: __inline__ __device__ double Element::computeSignedArea(void) const {
 2656:    // Compute the area of the element
 2657: 
 2658:    Point2 x0, x1, x2, x3;
 2659:    getLocalHorizontalNodePositionsTri(x0, x1, x2);
 2660: 
 2661: 
 2662:    double res = signedArea(x0, x1, x2);
 2663: 
 2664:    // In the quad case we need to add the area of the other triangle.
 2665:    if (isQuad()) {
 2666:       x3 = getLocalHorizontalNodePosition(3);
 2667:       double ar1 = signedArea(x0, x2, x3);
 2668:       double ar2 = signedArea(x0, x1, x3);
 2669:       double ar3 = signedArea(x1, x2, x3);
 2670:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2671: 
 2672:       res += ar1;
 2673: 
 2674:    }
 2675: 
 2676:    return res;
 2677: }
 2678: 
 2679: 
 2680: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2681:                                                                 (nodes[1]->isDry2()) ||
 2682:                                                                 (nodes[2]->isDry2()) ||
 2683:                                                                 (isQuad() && nodes[3]->isDry2());
 2684: }
 2685: 
 2686: __inline__ __device__ double Element::detJ_xi_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2687:    return (1.0/8.0)*((x1.x - x0.x)*(x2.y - x3.y) - (x2.x - x3.x)*(x1.y - x0.y));
 2688: }
 2689: 
 2690: __inline__ __device__ double Element::detJ_eta_quad(Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 2691:    return (1.0/8.0)*((x2.x - x1.x)*(x3.y - x0.y) - (x3.x - x0.x)*(x2.y - x1.y));
 2692: }
 2693: 
 2694: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2695:    // In boundary sides, the element 1 is nullptr
 2696:    return side->elems[1] == nullptr; 
 2697: }
 2698: 
 2699: __forceinline__ __device__ bool Element::inverseBilinearQuad(Point2 p, double &xi, double &eta, double shp[4]) const {
 2700:    // Given a point p in the quad element returns the bilinear coordinates (xi,eta) and the shape coordinates shp[4]
 2701:    // For ics == 2, this function uses local frame coordinates.
 2702: 
 2703:    assert(isQuad());
 2704: 
 2705:    // In bilinear coordinates, a point of coordinates (xi,eta) is given by: 
 2706:    // p = c + 0.25*(xi*vxi + eta*veta + xi*eta*vb)
 2707:    // where vxi, veta, vb are vectors and c is the center of the element.
 2708: 
 2709:    Point2 p0, p1, p2, p3;
 2710: 
 2711:    getLocalHorizontalNodePositionsQuad(p0, p1, p2, p3);
 2712: 
 2713:    // A point of bilinear coordinates (xi,eta) has cartesian coordinates given by:
 2714:    // p = c + 0.25 * (xi*vxi + eta*veta + xi*eta*vb)
 2715:    // vectors vxi and veta connect the centers of opposite sides
 2716:    // Vector vb is the vector from actual p3 to the p3 that would complete a parallelogram
 2717:    // vb is zero for parallelogram elements.
 2718:    const Point2 c = 0.25*(p0 + p1 + p2 + p3); // Center of the element (in local frame coordinates if ics == 2)
 2719: 
 2720:    //  The bilinear mapping is:
 2721:    //      P(s,t) = C + s*U + t*V + s*t*W
 2722:    //
 2723:    //  where:
 2724:    //    C = centroid (average of four vertices)
 2725:    //    U = half-vector connecting midpoints of opposite sides (s-direction)
 2726:    //    V = half-vector connecting midpoints of opposite sides (t-direction)
 2727:    //    W = bilinear correction; measures deviation from parallelogram
 2728:    //        +W at P0,P2 (where s*t=+1), -W at P1,P3 (where s*t=-1)
 2729:    //        W = 0 for parallelogram elements.
 2730:    //
 2731:    //  Key idea: project H = P - C onto a direction nb parallel to W.
 2732:    //
 2733:    //  cross(nb, W) = 0 because nb || W, so the cross product kills the
 2734:    //  nonlinear s*t*W term completely, giving a PURE LINEAR equation:
 2735:    //
 2736:    //      cross(nb, H) = s * cross(nb, U) + t * cross(nb, V)      (L)
 2737:    //
 2738:    //  Geometrically, (L) projects everything onto the direction
 2739:    //  perpendicular to W, where the mapping is purely affine.
 2740:    //
 2741:    //  The dot product with nb retains the nonlinear term:
 2742:    //
 2743:    //      dot(nb, H) = s*dot(nb,U) + t*dot(nb,V) + s*t*dot(nb,W)  (Q)
 2744:    //
 2745:    //  Geometrically, (Q) projects onto the W direction, where
 2746:    //  the nonlinearity lives.
 2747:    //
 2748:    //  We solve (L) for whichever variable has the larger coefficient
 2749:    //  (better conditioned back-substitution), substitute into (Q),
 2750:    //  and get a scalar quadratic in the other variable.
 2751:    // ================================================================
 2752: 
 2753:    // ---- Basis vectors ----
 2754:    // U: s-direction. 2*U connects midpoint(P0,P3) to midpoint(P1,P2).
 2755:    const Vector2 vxi  = (p1 + p2) - (p0 + p3);   // = 4*U
 2756:    // V: t-direction. 2*V connects midpoint(P0,P1) to midpoint(P2,P3).
 2757:    const Vector2 veta = (p2 + p3) - (p0 + p1);   // = 4*V
 2758:    // W: nonlinear correction. Difference between quad and parallelogram.
 2759:    // |vb|/max(|vxi|,|veta|) measures the "non-parallelogramness".
 2760:    const Vector2 vb   = (p0 + p2) - (p1 + p3);   // = 4*W
 2761: 
 2762:    // ---- H: displacement from centroid (scaled by 4 for convenience) ----
 2763:    // Working with 4*H avoids the 0.25 multiplications on U, V, W.
 2764:    // The equation becomes:  4*H = xi*(4*U) + eta*(4*V) + xi*eta*(4*W)
 2765:    // which is just:  4*dp = xi*vxi + eta*veta + xi*eta*vb
 2766:    const Vector2 dp4 = 4.0*(p - c);   // = 4*H
 2767: 
 2768:    // ---- nb: direction parallel to W, L1-normalized ----
 2769:    // We don't need a unit vector -- just a well-scaled direction parallel
 2770:    // to W.  L1 norm avoids sqrt entirely (exact to 1 ulp, no rounding
 2771:    // from sqrt).  When W ~ 0 (parallelogram), the quadratic coefficient
 2772:    // Qw ~ 0 and the solver's linear branch handles it correctly.
 2773:    //
 2774:    // Branchless: nb = vb / (|vb.x| + |vb.y| + tiny).
 2775:    // When vb ~ 0, nb ~ 0, all L/Q coefficients vanish proportionally,
 2776:    // and the quadratic solver takes its linear path (a ~ 0).
 2777:    const double wlen1 = fabs(vb.x) + fabs(vb.y) + 1e-30;
 2778:    const double inv_wlen = 1.0 / wlen1;
 2779:    const Vector2 nb = vb * inv_wlen;
 2780: 
 2781:    // ---- Linear equation (L): Lp = Ls*xi + Lt*eta ----
 2782:    // cross(nb, .) projects onto the direction PERPENDICULAR to W.
 2783:    // Since nb || W, cross(nb, vb) = 0 exactly, killing the xi*eta term.
 2784:    // What remains is a pure affine relationship between xi and eta.
 2785:    const double Lp = cross(nb, dp4);     // cross(nb, 4*H)
 2786:    const double Ls = cross(nb, vxi);     // cross(nb, 4*U)
 2787:    const double Lt = cross(nb, veta);    // cross(nb, 4*V)
 2788: 
 2789:    // ---- Quadratic equation (Q): Qp = Qs*xi + Qt*eta + Qw*xi*eta ----
 2790:    // dot(nb, .) projects onto the W direction, where the nonlinearity lives.
 2791:    // dot(nb, vb) = |vb|^2/(|vb.x|+|vb.y|) != 0 for non-parallelograms.
 2792:    const double Qp = dot(nb, dp4);       // dot(nb, 4*H)
 2793:    const double Qs = dot(nb, vxi);       // dot(nb, 4*U)
 2794:    const double Qt = dot(nb, veta);      // dot(nb, 4*V)
 2795:    const double Qw = dot(nb, vb);        // dot(nb, 4*W)
 2796: 
 2797:    // ---- Solve: pick the better-conditioned variable from (L) ----
 2798:    // Back-substitute from (L) dividing by the LARGER coefficient,
 2799:    // minimizing round-off amplification.
 2800:    //
 2801:    // Commented below is the original code. It is more clear, but is branched. Below is a faster versions
 2802:    // that uses predicated moves.
 2803:    //
 2804:    // if (fabs(Ls) > fabs(Lt)) {
 2805:    //    // Solve quadratic in eta, back-substitute for xi from (L).
 2806:    //    // From (L):  xi = (Lp - Lt*eta) / Ls
 2807:    //    // Substitute into (Q), multiply by Ls, group by eta:
 2808:    //    const double A = -Qw * Lt;
 2809:    //    const double B = -Qs * Lt + Qt * Ls + Qw * Lp;
 2810:    //    const double C =  Qs * Lp - Qp * Ls;
 2811: 
 2812:    //    double eta1, eta2;
 2813:    //    solveQuadratic(A, B, C, eta1, eta2);
 2814: 
 2815:    //    // Pick root with smaller |eta| (domain centered at 0).
 2816:    //    // Ternary-> predicated move, no branch divergence.
 2817:    //    eta = (fabs(eta1) < fabs(eta2)) ? eta1 : eta2;
 2818: 
 2819:    //    // Back-substitute: divides by |Ls| >= |Lt|, best conditioned.
 2820:    //    xi = (Lp - Lt * eta) / Ls;
 2821: 
 2822:    // } else {
 2823:    //    // Solve quadratic in xi, back-substitute for eta from (L).
 2824:    //    // From (L):  eta = (Lp - Ls*xi) / Lt
 2825:    //    // Substitute into (Q), multiply by Lt, group by xi:
 2826:    //    const double A = -Qw * Ls;
 2827:    //    const double B =  Qs * Lt - Qt * Ls + Qw * Lp;
 2828:    //    const double C =  Qt * Lp - Qp * Lt;
 2829: 
 2830:    //    double xi1, xi2;
 2831:    //    solveQuadratic(A, B, C, xi1, xi2);
 2832: 
 2833:    //    xi = (fabs(xi1) < fabs(xi2)) ? xi1 : xi2;
 2834: 
 2835:    //    eta = (Lp - Ls * xi) / Lt;
 2836:    // }
 2837:    const bool solve_s = fabs(Lt) >= fabs(Ls);   // true-> quadratic gives xi
 2838:    const double La = solve_s ? Lt : Ls;          // larger  |L|, for back-sub
 2839:    const double Lb = solve_s ? Ls : Lt;          // smaller |L|, in quadratic
 2840:    const double Qa = solve_s ? Qt : Qs;          // Q-coeff matching La
 2841:    const double Qb = solve_s ? Qs : Qt;          // Q-coeff matching Lb
 2842: 
 2843:    // Quadratic:  A*r^2 + B*r + C = 0
 2844:    // (same formula for both cases, just with swapped coefficients)
 2845:    const double A = -Qw * Lb;
 2846:    const double B = -Qa * Lb + Qb * La + Qw * Lp;
 2847:    const double C =  Qa * Lp - Qp * La;
 2848: 
 2849:    double r1, r2;
 2850:    solveQuadratic(A, B, C, r1, r2);
 2851: 
 2852:    // Pick root closer to 0 (domain is [-1,1] centered at origin)
 2853:    const double r = (fabs(r1) < fabs(r2)) ? r1 : r2;
 2854: 
 2855:    // Back-substitute into (L): other = (Lp - Lb*r) / La
 2856:    const double other = (Lp - Lb * r) / La;
 2857: 
 2858:    // Assign to (xi, eta) depending on which variable the quadratic solved
 2859:    xi  = solve_s ? r     : other;
 2860:    eta = solve_s ? other : r;
 2861: 
 2862: 
 2863:    // ---- Clamp to [-1, 1] (safety net for points slightly outside) ----
 2864:    xi  = clamp(xi,  -1.0, 1.0);
 2865:    eta = clamp(eta, -1.0, 1.0);
 2866: 
 2867:    // ---- Shape functions ----
 2868:    // N0 = (1-xi)(1-eta)/4  at P0 (xi=-1, eta=-1)
 2869:    // N1 = (1+xi)(1-eta)/4  at P1 (xi=+1, eta=-1)
 2870:    // N2 = (1+xi)(1+eta)/4  at P2 (xi=+1, eta=+1)
 2871:    // N3 = (1-xi)(1+eta)/4  at P3 (xi=-1, eta=+1)
 2872:    shp[0] = (1.0 - xi) * (1.0 - eta) * 0.25;
 2873:    shp[1] = (1.0 + xi) * (1.0 - eta) * 0.25;
 2874:    shp[2] = (1.0 + xi) * (1.0 + eta) * 0.25;
 2875:    shp[3] = (1.0 - xi) * (1.0 + eta) * 0.25;
 2876: 
 2877:    return true;
 2878: }
 2879: 
 2880: /**
 2881:    Compute the shape coordinates of the point (xt,yt) in the element.
 2882:    @param xt (input): x-coordinate of the point
 2883:    @param shpCoords (output): shape coordinates of the point
 2884:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2885:    @return true if the point is inside the element, false otherwise
 2886: **/
 2887: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4], EFixIf fixNegshpCoord, const Side *origSide) const {
 2888: 
 2889:    // Compute the shape coordinates of the point xt in the element.
 2890:    //   If fixNegshpCoord = fiOnlyInside, only fix the shape coordinates if the point is *almost*inside the element.
 2891:    //   If fixNegshpCoord = fiAnywhere, we fix the shape coordinates if they are negative.
 2892:    // It's not reliable to use the area coord for ics=2 when the pt is far away
 2893:    // from the local frame, so use additional check.
 2894: 
 2895: 
 2896:    Point3 origSideCenter = toPoint3(origSide->center, origSide->centerZ());
 2897: 
 2898:    if (isTri()) { // Triangular element
 2899: 
 2900:       // Horizontal local node coordinates. 
 2901:       Point2 x0, x1, x2;
 2902:       getLocalHorizontalNodePositionsTri(x0, x1, x2, origSideCenter, origSide->frame);
 2903: 
 2904:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2905:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2906:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2907:       shpCoords[3] = 0.0;
 2908: 
 2909:       double tmpmin = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2910:       const bool res = (tmpmin >= -small);  
 2911:       
 2912:       // When to fix the negative shape coordinates?
 2913:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2914: 
 2915:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2916:       // then we fix the negative shape coordinates.
 2917:       if ((tmpmin < 0) && fix) {
 2918: 
 2919:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2920:          // keeping the sum of the shape coordinates equal to 1.
 2921:          // I have tested and compared the new algorithm with the old one, and they give
 2922:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2923:          // The new algorithm should be faster since it is branchless.
 2924:          const double a = - tmpmin + 1.0e-8;  // XXX Is 1.0e-8 the best value?
 2925:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2926: 
 2927:          shpCoords[0] = (shpCoords[0] + a)*b;
 2928:          shpCoords[1] = (shpCoords[1] + a)*b;
 2929:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2930: 
 2931:          assert(!(shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2932:                   shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) &&
 2933:                 "Negative shape coordinates in computeShapeCoords, when fixNegshpCoord is true");
 2934: 
 2935:          // Update the point coordinates for the new shape coordinates
 2936:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2937:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2938: 
 2939:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2940: 
 2941:       }
 2942: 
 2943:       // Return true if the point is inside the element
 2944:       return res;      
 2945:    }
 2946:    else {
 2947:       assert(isQuad() && "computeShapeCoords");
 2948: 
 2949:       // Horizontal local node coordinates with respect to the original side.
 2950:       Point2 x0, x1, x2, x3;
 2951:       getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3, origSideCenter, origSide->frame);
 2952: 
 2953:       const double a0 = signedArea(x0, x1, xt);
 2954:       const double a1 = signedArea(x1, x2, xt);
 2955:       const double a2 = signedArea(x2, x3, xt);
 2956:       const double a3 = signedArea(x3, x0, xt);
 2957: 
 2958:       const double minArea = min4(a0, a1, a2, a3);
 2959:       
 2960:       const bool res = (minArea > -small*area);
 2961: 
 2962:       // When to fix the negative shape coordinates?
 2963:       const bool fix = (fixNegshpCoord == EFixIf::fiOnlyInside && res) || (fixNegshpCoord == EFixIf::fiAnywhere);
 2964: 
 2965:       double xi, eta;    
 2966: 
 2967:       // Converts the point xt to the element frame coordinates and then to bilinear+shape coordinates.
 2968:       // Does nothing if ics == 1.
 2969:       assert(origSide != nullptr);
 2970:       Point2 xt_elem = toPoint2(toLocalFrame(origSide->toGlobal(toPoint3(xt, 0.0))));
 2971: 
 2972:       inverseBilinearQuad(xt_elem, xi, eta, shpCoords);
 2973: 
 2974:       if (fix) {
 2975:          double xn[4] = {x0.x, x1.x, x2.x, x3.x};
 2976:          double yn[4] = {x0.y, x1.y, x2.y, x3.y};
 2977:          xt.x = interpolate(shpCoords, xn);
 2978:          xt.y = interpolate(shpCoords, yn);
 2979:       }
 2980: 
 2981:       return res;
 2982:    }
 2983: 
 2984: 
 2985:    assert(false && "computeShapeCoords: should never reach this point");
 2986:    return false;  // Never reached
 2987: 
 2988: }
 2989: 
 2990: 
 2991: __device__ __forceinline__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2992: // Convert shape coordinates to cartesian coordinates
 2993: 
 2994:    if (isTri()) {
 2995:       // Triangular element
 2996: assert(false && "shapeCoordsToXY: should it use local frame coordinates?");
 2997:       double xcoords[3] = {nodes[0]->p.x, nodes[1]->p.x, nodes[2]->p.x};
 2998:       double ycoords[3] = {nodes[0]->p.y, nodes[1]->p.y, nodes[2]->p.y};
 2999:    }
 3000:    else {
 3001:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 3002:    }
 3003: 
 3004: }
 3005: 
 3006: 
 3007: 
 3008: __device__ __forceinline__ double Element::intPhiPhiTri(int i, int j) const {
 3009:    // return \int \phi_i*\phi_j dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3010:    
 3011:    return ((i == j) ? (2.0/12.0) : (1.0/12.0))*area;
 3012: }
 3013: 
 3014: __device__ __forceinline__ double Element::intGradPhiGradPhiTri(int i, int j) const {
 3015:    // return \int (grad phi_i).(grad phi_j) dA for tris, where phi_i and phi_j are the shape functions of the nodes i and j.
 3016:    // gradPhi[i] is constant over a linear triangle, so the integral is area * dot(gradPhi[i], gradPhi[j]).
 3017:    assert(isTri() && i >= 0 && j >= 0 && i < 3 && j < 3);
 3018:    return area * dot(gradPhi[i], gradPhi[j]);
 3019: }
 3020: 
 3021: __device__ __forceinline__ double Element::intPhiPhiQuad(int i, int j, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3022:    // return \int \phi_i*\phi_j dA for quads, where phi_i and phi_j are the shape functions of the nodes i and j.
 3023:    // The integral can be computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 3024:    // The formula for the integral is:
 3025:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 3026:    
 3027:    const double xi_term  = 1.0 + (xi_n(i) * xi_n(j))/3.0;
 3028:    const double eta_term = 1.0 + (eta_n(i)*eta_n(j))/3.0;
 3029:    const double eta_sum  = eta_n(i) + eta_n(j);
 3030:    const double xi_sum   = xi_n(i)  + xi_n(j);
 3031: 
 3032:    const double detJ_xi  = detJ_xi_quad (x0, x1, x2, x3);  // XXXXX put the 8 inside the function??? xi derivative of the Jacobian determinant
 3033:    const double detJ_eta = detJ_eta_quad(x0, x1, x2, x3);  // eta derivative of the Jacobian determinant
 3034: 
 3035: 
 3036:    return (1.0/16.0)*area*xi_term*eta_term + (1.0/12.0)*(detJ_eta*xi_term*eta_sum + detJ_xi*eta_term*xi_sum);
 3037: }
 3038:    
 3039: 
 3040: __device__ __forceinline__ double Element::intGradPhiGradPhiQuad(int i1, int i2, Point2 const &x0, Point2 const &x1, Point2 const &x2, Point2 const &x3) const {
 3041:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 3042:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 3043:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 3044:    // The formula is also based on the identity:
 3045:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 3046:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 3047: 
 3048:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: bad ranges");
 3049: 
 3050: 
 3051: 
 3052:    double res = 0.0;
 3053:    
 3054:    // Quadrature points in xi and eta coordinates
 3055:    #pragma unroll
 3056:    for (int i = 0; i < 4; i++) {
 3057:       // For each quadrature point...
 3058: 
 3059:       const Point2 p = GaussPoint(i);  // Quadrature point in (eta,xi) coordinates
 3060:       const double eta = p.x;
 3061:       const double xi  = p.y;
 3062: 
 3063:       // Jacobian entries at the Gauss point p
 3064:       const double dx_dxi  = 0.25 * ( (x1.x + x2.x - x0.x - x3.x) + eta*(x0.x + x2.x - x1.x - x3.x) );
 3065:       const double dx_deta = 0.25 * ( (x2.x + x3.x - x0.x - x1.x) + xi *(x0.x + x2.x - x1.x - x3.x) );
 3066:       const double dy_dxi  = 0.25 * ( (x1.y + x2.y - x0.y - x3.y) + eta*(x0.y + x2.y - x1.y - x3.y) );
 3067:       const double dy_deta = 0.25 * ( (x2.y + x3.y - x0.y - x1.y) + xi *(x0.y + x2.y - x1.y - x3.y) );      
 3068: 
 3069:       const double detJ = detJ_quad(p, x0, x1, x2, x3);
 3070:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 3071: 
 3072:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 3073:       const double dPhi_dxi_1  = dPhi_dxi_quad (i1, p);
 3074:       const double dPhi_deta_1 = dPhi_deta_quad(i1, p);
 3075:       const double dPhi_dxi_2  = dPhi_dxi_quad (i2, p);
 3076:       const double dPhi_deta_2 = dPhi_deta_quad(i2, p);
 3077: 
 3078:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 3079:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 3080:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 3081:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 3082:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 3083: 
 3084:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 3085:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 3086:    }
 3087: 
 3088:    return res;
 3089: }
 3090: 
 3091: 
 3092: /**  Interpolate velocities at a given point (xt,yt,zt)
 3093: 
 3094:    @param xt, yt, zt: coordinates of the point to interpolate
 3095:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 3096: 
 3097:    This is done in four steps:
 3098: 
 3099:    1. Find the shape coordinates for the final position in the element.
 3100:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 3101:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 3102:       z levels at xt, yt at each step.   
 3103:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 3104:       horizontally and vertically.
 3105: **/
 3106: __device__ Vector3 Element::interpolateVelocities(Point3 xt, const Side *origSide) const {
 3107:    // Interpolate the velocities at the point xt. 
 3108:    // This function works the same for triangular and quadrilateral elements.
 3109:    double shpCoord[4];
 3110:    Vector3 u_int;
 3111: 
 3112: 
 3113:    // First step is to compute the shape coordinates of (xt,yt)
 3114: // printf("interpolateVelocities 1: xt = (%f, %f, %f)\n", xt.x, xt.y, xt.z);
 3115:    computeShapeCoords(toVector2(xt), shpCoord, fiAnywhere, origSide);
 3116: 
 3117:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 3118: 
 3119:    // Second step is to find the level that contains zt
 3120:    // Uses a binary search to find the level
 3121:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 3122:    // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 3123:    int L = kb - 1; // In some cases, the bottom level of the element is 1 more than the bottom level of the node XXXX (Check)
 3124:    int R = nvrt - 1;
 3125: 
 3126:    // Get the z coordinates at the nodes of the element at the levels L and R
 3127:    double zLAtNodes[4], zRAtNodes[4], zMAtNodes[4];
 3128:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 3129:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 3130: 
 3131: 
 3132:    double zL = interpolate(shpCoord, zLAtNodes);
 3133:    double zR = interpolate(shpCoord, zRAtNodes);
 3134: 
 3135:    // Interpolates vertically the velocities
 3136:    double wght1, wght2;
 3137:    if (xt.z <= zL) {
 3138:       wght1 = 1.0;
 3139:       wght2 = 0.0;
 3140:       xt.z = zL;
 3141:    }
 3142:    else if (xt.z >= zR) {
 3143:       wght1 = 0.0;
 3144:       wght2 = 1.0;
 3145:       xt.z = zR;
 3146:    }
 3147:    else {
 3148:       // Perform a binary search to find the levels between L and R that contain xt.z
 3149:       while (R - L > 1) {
 3150:          int M = (L + R) / 2.0;
 3151: 
 3152:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 3153:          double zM = interpolate(shpCoord, zMAtNodes);
 3154:          if (zM < xt.z) 
 3155:          {
 3156:             L = M;
 3157:             zL = zM;
 3158:          }
 3159:          else 
 3160:          {
 3161:             R = M;
 3162:             zR = zM;
 3163:          }
 3164:       }
 3165:       assert(L == R - 1 && "Binary search failed to find the levels containing zt");
 3166:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 3167: 
 3168:       wght2 = (xt.z - zL)/(zR - zL);
 3169:       wght1 = 1.0 - wght2;
 3170: 
 3171:    }
 3172: // printf("XXYYX element %d, L = %d, R = %d, zL = %.17f, zR = %.17f, xt.z = %.17f, wght1 = %.17f, wght2 = %.17f\n", idx, L, R, zL, zR, xt.z, wght1, wght2);
 3173: // printf("HEREEEEEE 3, wght1 = %.17f, wght2 = %.17f, shpCoord = (%.17f, %.17f, %.17f, %.17f)\n", wght1, wght2, shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]);
 3174:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 3175:    // Remember that interpolate takes frames into account for Vector2 fields and ics==2
 3176:    Vector2 uv = wght1*interpolate(L, shpCoord, &Node::u2) + wght2*interpolate(R, shpCoord, &Node::u2);
 3177:    double w   = wght1*interpolate(L, shpCoord, &Node::w2) + wght2*interpolate(R, shpCoord, &Node::w2);
 3178: 
 3179:    // Project the velocity from the local frame to the origSide frame
 3180:    if constexpr(ics == 2) uv = frame.projHorVec(uv, origSide->frame);
 3181:    u_int = {uv.x, uv.y, w};
 3182: 
 3183:    // Neither of the interpolated velocities should be NaN
 3184:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 3185: 
 3186:    return u_int;
 3187: 
 3188: }
 3189: 
 3190: 
 3191: 
 3192: 
 3193: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 3194: 
 3195:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 3196:    // compute the value at the side center. The one for n2 is computed from 1 - w
 3197:    const Node *n1 = side->n1;
 3198:    const Node *n2 = side->n2;
 3199: 
 3200:    bool n1_match = (n1->nodeBnd->segment == segment);
 3201:    bool n2_match = (n2->nodeBnd->segment == segment);
 3202: 
 3203:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 3204:    if (n1_match && n2_match) {
 3205:       return 0.5;
 3206:    } else if (n1_match) {
 3207:       return 1.0;
 3208:    } else if (n2_match) {
 3209:       return 0.0;
 3210:    }
 3211: 
 3212:    return 0.0;
 3213: }
 3214: 
 3215: __inline__ __device__ double  SideBoundary::etaMeanBnd(void) const { return 0.5*(side->n1->nodeBnd->eta_mean + side->n2->nodeBnd->eta_mean); }         // XXXX Should I use something like getBoundaryArrayValueWeight here?
 3216: 
 3217: 
 3218: __inline__ __device__ Vector2 SideBoundary::umo(int jfr) const {
 3219: 
 3220:    const double w1 = getBoundaryArrayValueWeight();
 3221:    const double w2 = 1.0 - w1;
 3222:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3223:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3224: 
 3225:    return w1*n1Bnd->umo[jfr] + w2*n2Bnd->umo[jfr];
 3226: }
 3227: 
 3228: 
 3229: __inline__ __device__ Vector2 SideBoundary::ufa(int jfr) const {
 3230:    const double w1 = getBoundaryArrayValueWeight();
 3231:    const double w2 = 1.0 - w1;
 3232:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3233:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3234: 
 3235:    return w1*n1Bnd->ufa[jfr] + w2*n2Bnd->ufa[jfr];
 3236: 
 3237: }
 3238: 
 3239: 
 3240: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3241:    // Returns the value of the velocity at the side center
 3242:    const double w1 = getBoundaryArrayValueWeight();
 3243:    const double w2 = 1.0 - w1;
 3244:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3245:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3246: 
 3247:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3248: }
 3249: 
 3250: 
 3251: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3252:    // Returns the value of the normal component of the velocity at the side center
 3253:    const double w1 = getBoundaryArrayValueWeight();
 3254:    const double w2 = 1.0 - w1;
 3255:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3256:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3257: 
 3258:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3259: }
 3260: 
 3261: 
 3262: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3263:    if constexpr(ics == 1) {
 3264:       return center;
 3265: 
 3266:    } else {
 3267:       const Point2 p0 = n1->outputCoords();
 3268:       const Point2 p1 = n2->outputCoords();
 3269:       return (1.0/2.0)*(p0 + p1);
 3270: 
 3271:    }
 3272: }
 3273: 
 3274: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3275: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3276: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3277: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3278: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3279: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3280: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3281: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3282: // Computes the gradient of the field at the side center.
 3283:    Vector2 grad = {0.0, 0.0};
 3284:    int count = 0;
 3285: 
 3286:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3287:    // as the average of the gradients at each element.
 3288:    // First element
 3289:    if (elems[0] != nullptr && condition(elems[0])) {
 3290:       Vector2 elemGrad = elems[0]->grad2(field);
 3291: 
 3292:       // For ics=2, projects the element gradient from its frame to the side frame
 3293:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3294: 
 3295:       grad += elemGrad;
 3296: 
 3297:       count++;
 3298:    }
 3299: 
 3300:    // Second element
 3301:    if (elems[1] != nullptr && condition(elems[1])) {
 3302: 
 3303:       Vector2 elemGrad = elems[1]->grad2(field);
 3304: 
 3305:       // For ics=2, projects the element gradient from its frame to the side frame
 3306:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3307: 
 3308:       grad += elemGrad;
 3309: 
 3310:       count++;
 3311:    }
 3312: 
 3313:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3314:    if (count > 0) {
 3315:       grad = grad*(1.0/count);
 3316:    }
 3317:    
 3318:    return grad;
 3319: }
 3320: 
 3321: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3322: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3323: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3324: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3325: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3326: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3327: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 3328: 
 3329: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 3330: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 3331: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 3332: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
 3333: 
 3334: 
 3335: __inline__ __device__ double  Side::Cd(void)     const { if (!isDry) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 3336: 
 3337: __inline__ __device__ Vector2 Side::tau(void)    const { 
 3338:    // Returns the value of the tau at the side center, taking care of the projection from the node frames to the side frame (ics==1 or ics==2)
 3339:    if constexpr(ics == 1) { 
 3340:       return 0.5*(n1->tau + n2->tau);
 3341: 
 3342:    } else {
 3343:       // Project the tau from the node frames to the side frame
 3344:       const Vector2 stau1 = n1->frame.projHorVec(n1->tau, frame);
 3345:       const Vector2 stau2 = n2->frame.projHorVec(n2->tau, frame);
 3346: 
 3347:       return 0.5*(stau1 + stau2);
 3348:    }
 3349: }
 3350: 
 3351: /**
 3352:  * This method performs backtracking from the side center until a time -dt back in time 
 3353:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 3354:  * intermediate point.
 3355:  *
 3356:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 3357:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 3358:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 3359:  * remaining time.
 3360:  * 
 3361:  * NOTE: Runge-Kutta is not implemented yet. XXX
 3362:  * 
 3363:  * @param uuint, vvint, wwint: Velocities at the final point
 3364:  * @param jlev: Level at which the backtracking is performed
 3365:  * @param dt, dtbk: Tracking timesteps
 3366:   */
 3367: __inline__ __device__ void Side::btrack(
 3368:       int jlev,             // Level at which the backtracking is performed XXX rename to k???
 3369:       double dt,            // Tracking time
 3370:       double dtbk,          // Tracking timestep
 3371:       Vector3 &u_int        // Velocities at the initial point
 3372: ) const {
 3373: 
 3374:    // Start from side center
 3375:    Point3 x0;
 3376: 
 3377:    if constexpr(ics == 1) x0 = {center.x, center.y, zc[jlev]};
 3378:    else                   x0 = {0.0, 0.0, zc[jlev]};  // for ics == 2, the origin is the side centern which is (0,0) at the local frame
 3379: 
 3380:  
 3381:    double time_rm = dt; // Remaining time
 3382:    double time_rm_1 = 1e10;
 3383:    double time_rm_2 = 2e10;
 3384:    double time_rm_3 = 3e10;
 3385: 
 3386: 
 3387:    // Initial velocities
 3388:    u_int = {u2[jlev].x, u2[jlev].y, w2(jlev)};
 3389: 
 3390:    // Find a non dry element for starting the backtracking. At this point there should be at least one.
 3391:    Element* curElem = (!elems[0]->isDry) ? elems[0] : elems[1];  // elems[0] is always non-null 
 3392: 
 3393:    assert(curElem != nullptr && !curElem->isDry && "Starting element is dry or boundary side");
 3394: 
 3395: // showPoints(x0, x0, jlev, this, 0xFF0000u, 'x', 1, 0, 0);
 3396: 
 3397: 
 3398:    constexpr int MAX_ITERATIONS = 100; 
 3399:    int iter = 0;
 3400:    Point3 xt = {-1.0e25, -1.0e25, -1.0e25};
 3401:    while(true) {
 3402: 
 3403:       // Calculate timestep
 3404:       const double dtb = min(dtbk, time_rm);
 3405: 
 3406:       // Next point in the backtracking curve
 3407:       xt = x0 - dtb*u_int;
 3408: 
 3409:       double t, s; // parameters for the line segments p0pt and p1p2
 3410:       Side *lastCrossSide = nullptr;
 3411:       const bool found = celestialWalk(curElem, x0, xt, this, lastCrossSide, jlev);
 3412: 
 3413: 
 3414:       if (time_rm_3 <= time_rm) {
 3415:       // If backtracking gets stuck, we stop the backtracking and use the velocity at the last x0.
 3416:          xt = x0;
 3417:          break;
 3418:       }
 3419: 
 3420: 
 3421:       if (!found) {
 3422:       // This means that the walk reached a boundary or a dry element.
 3423: 
 3424:          assert(lastCrossSide!=nullptr && "lastCrossSide is nullptr");
 3425: 
 3426:          // Finds the point at the boundary where the line segment x0xt intersects.
 3427:          // Here we will assume that it does intersect the boundary segment, even if in some cases,
 3428:          // due to floating point errors, it does not exactly intersect.
 3429:          // We call p1 and p2 the 2D points of the boundary segment. p0, pt are the 2D versions of x0 and xt.
 3430:          // v1 is the vector from p0 to pt, v2 is the vector from p1 to p2.
 3431:          // To compute the intersection point we start with the parametric equations.
 3432:          // p1 + t*v2 = p0 + s*v1,    t, s in [0,1]
 3433:          // We cross-prouct by v1 to cancel the s term:
 3434:          // cross(v2, v1)*t = cross(p0 - p1, v1)
 3435:          // t = cross(p0 - p1, v1) / cross(v2, v1)
 3436: 
 3437:          // Side coordinates in the origSide frame.
 3438:          const Point2 p1 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n1->p, lastCrossSide->n1->gz)));
 3439:          const Point2 p2 = toPoint2(toLocalFrame(toPoint3(lastCrossSide->n2->p, lastCrossSide->n2->gz)));
 3440: 
 3441:          Point2  p0 = {x0.x, x0.y};
 3442:          Point2  pt = {xt.x, xt.y};
 3443: 
 3444:          const Vector2 v1 = pt - p0;
 3445:          const Vector2 v2 = p2 - p1;
 3446: 
 3447: 
 3448: 
 3449:          // We are assuming intersection, so we clamp t to the range [0,1].
 3450:          const double denom = cross(v2, v1);
 3451:          
 3452: 
 3453: 
 3454: 
 3455:          if (abs(denom) < small) {
 3456:             // small denominators are fairly common. They occur when the line segment x0xt 
 3457:             // is parallel to the boundary segment. This occurs after a "collision" with the
 3458:             // boundary, where the backtracking curve startt sliding along the boundary.
 3459:             // In this case, we simply assume that the two lines are very close to each other
 3460:             // and simply compute the closest point to xt (s = 1.0) on the boundary segment (clamped to p1p2)
 3461:             t = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3462:             if (t<0.0000000001) t = 0.0;
 3463:             if (t>0.9999999999) t = 1.0;
 3464: 
 3465:             // s = clamp(dot(pt - p1, v2) / dot(v2, v2), 0.0, 1.0);
 3466:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3467: 
 3468:          }
 3469:          else {
 3470:             
 3471:             t = clamp(cross(p0 - p1, v1) / denom, 0.0, 1.0);
 3472:             if (t<0.0000000001) t = 0.0; // XXXXX use constants
 3473:             if (t>0.9999999999) t = 1.0;
 3474:             // From the originaL equation we can solve for s:
 3475:             // p1 + t*v2 = p0 + s*v1    =>   s*v1 = p1 + t*v2 - p0 
 3476:             // Computing the dot product by v1, we get:
 3477:             // s = dot((p1 + t*v2 - p0), v1) / dot(v1, v1)
 3478:             s = clamp(dot(p1 + t*v2 - p0, v1)/dot(v1, v1), 0.0, 1.0);
 3479:             if (s<0.0000000001) s = 0.0; // XXXXX use constants
 3480: 
 3481:          }
 3482: 
 3483:          assert(curElem!=nullptr && !curElem->isDry && "curElem is nullptr or dry");
 3484: 
 3485: 
 3486:          // We update the new target point to be right at the intersection point,
 3487:          // and the remaining time must include the time we haven't "used".
 3488:          time_rm -= s*dtb;
 3489:          xt = toPoint3(p1 + t*v2, x0.z + s*(xt.z - x0.z)); // I use p1,p2 to compute the intersection point to ensure that it is on the boundary, but the z-coordinate is the same as x0.z
 3490: 
 3491: 
 3492:          // If it is an open boundary, just exits the loop. No sliding along the boundary is performed.
 3493:          if (lastCrossSide->sideBnd!=nullptr && !lastCrossSide->sideBnd->segment->isLand) break;
 3494: 
 3495:          // If it is not an open boundary, the velocity for the next step is computed by interpolating the velocities at the intersection point.
 3496:          // but extracting only the component along the tangent vector v2.
 3497:          Vector2 tangent = normalize(v2);
 3498:          const Vector3 u = curElem->interpolateVelocities(xt, this);
 3499: 
 3500:          const Vector2 u2D = make_double2(u.x, u.y);
 3501:          u_int = toVector3(dot(u2D, tangent)*tangent, u.z);
 3502: 
 3503: 
 3504:       } else {
 3505: 
 3506:          assert(curElem!=nullptr && !curElem->isDry && "Final element is dry or boundary side");
 3507: 
 3508:          time_rm -= dtb; 
 3509: 
 3510:          u_int = curElem->interpolateVelocities(xt, this);
 3511: 
 3512:       }
 3513: 
 3514:       if (time_rm <= 0.0) break; 
 3515: 
 3516:       // If the velocity is too small, we stop the backtracking
 3517:       const double vmag2 = norm2(toVector2(u_int));
 3518:       if (vmag2 <= velmin_btrack_sq)  {
 3519:          time_rm = 0.0; 
 3520:          return; 
 3521:       }
 3522: 
 3523:       // The current point becomes the next segment's starting point.
 3524:       x0 = xt;
 3525:  
 3526:       iter++;
 3527: 
 3528: // XXXXXXXXXXXXXXXXX
 3529: if (iter == 38) {printf("*****iter = %d, time_rm = %.17f\n", iter, time_rm); return;}
 3530:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 3531: 
 3532:       assert(time_rm_3 > time_rm && "time_rm is not decreasing");
 3533:       time_rm_3 = time_rm_2;
 3534:       time_rm_2 = time_rm_1;
 3535:       time_rm_1 = time_rm;
 3536:    }
 3537: 
 3538:    assert(curElem != nullptr && "Final element is nullptr");
 3539:    assert(!curElem->isDry && "Final element is dry");
 3540:    
 3541: 
 3542: 
 3543:    // Interpolate the velocities at the final point with respect to the current side frame
 3544:    u_int = curElem->interpolateVelocities(xt, this);
 3545: 
 3546: 
 3547: }
 3548: 
 3549: 
