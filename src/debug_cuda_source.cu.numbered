  943:    // int  itrtype[natrm];    // Tracer boundary condition type
  944: 
  945:    BoundarySegment(bool _isLand) {
  946:       isLand = _isLand;
  947:       clen = 0.0;
  948:       carea = 0.0;
  949:       ifltype = 0;
  950:       iettype = 0;
  951:       eth = 0.0;
  952:    }
