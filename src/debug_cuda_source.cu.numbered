 7138: __global__ void printMatrix(bool full) {
 7139:    // Debugging: print the matrix
 7140: 
 7141:    const int size = mesh->np;
 7142:    double sum = 0.0;
 7143:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7144:       const Node *node = mesh->localNodeData + idx_node;
 7145:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7146:       for (int j = 0; j < node->numNodes; j++) {
 7147:          Node* nbNode = node->nodes[j];
 7148:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7149:          sum += node->coeffMatrix[j];
 7150:       }
 7151:       if (full) printf("]\n");
 7152: 
 7153: 
 7154:    }
 7155:    if (!full) printf("sum=%lf\n", sum);
 7156: }
