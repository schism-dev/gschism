 3918: 
 3919: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3920:    // Computes the z coordinate at level k.
 3921:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3922:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3923:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3924:    // used 
 3925: 
 3926:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3927:    
 3928:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3929: 
 3930:    if (isDry2()) return 0.0;  
 3931: 
 3932:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3933: 
 3934:    if constexpr(ivcor == 2) {
 3935: 
 3936:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3937:       const double h_c = mesh->h_c;
 3938:       const double theta_f = mesh->theta_f;
 3939:       const double sinh_theta_f = mesh->sinh_theta_f;
 3940: 
 3941: 
 3942:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3943:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3944:       // once per time step/node. XXXX
 3945:       // CHECK: updateZCoordData
 3946: 
 3947:       //  To simplify comparisons, I define index versions of count variables.
 3948:       if      (k == ivrt)     return eta2; 
 3949:       else if (k == izlev)    return -hmod2;
 3950:       else if (k == kb)       return -depth;
 3951:       else if (k < izlev)     return mesh->ztot[k];
 3952:       else if (k > izlev) {
 3953:          const int ksig = k - izlev;
 3954: 
 3955:          if (hmod2 <= h_c) {
 3956:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3957: 
 3958:          } 
 3959:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3960:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3961:             assert(false && "compZCoord: invalid h_c\n");
 3962:          } 
 3963:          else {
 3964:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3965:                    h_c * mesh->sigma[ksig] + 
 3966:                    (hmod2 - h_c) * mesh->cs[ksig];
 3967:          }
 3968:       } else { 
 3969:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3970:       }
 3971: 
 3972:    }
 3973:    else {  // if constexpr(ivcor == 1)
 3974:       if (k <= kb)        return -depth; 
 3975:       else if (k == ivrt) return eta2;
 3976:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3977: 
 3978:    }
 3979:    
 3980:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3981:    return 0.0;
 3982: }
 3983: 
 3984: 
 3985: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3986:    // Computes the bottom drag Cd based on the selected nchi
 3987: 
 3988:    if constexpr(nchi == 0) {
 3989:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3990:       Cd = drag;  // Read from drag file
 3991: 
 3992:    } else if constexpr(nchi == 1) {
 3993:       // 
 3994: 
 3995:       bool ltmp = false; // for WBL iteration
 3996: 
 3997:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3998:       if (isDry || (rough == 0.0)) {
 3999:          Cd = 0.0;
 4000: 
 4001:       } else { //roughness >0 
 4002:          
 4003:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 4004: 
 4005:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 4006: 
 4007:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 4008: 
 4009:       } // if rough
 4010: 
 4011:    } else if constexpr(nchi == -1) {
 4012:    // Manning 
 4013:  
 4014:       const double htot = max(hmin_man, htot2()); 
 4015:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 4016: 
 4017:    } else {
 4018:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 4019:       
 4020:    } // if nchi
 4021: 
 4022: }
 4023: 
 4024: 
 4025: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 4026:    // Checks if a side in on the boundary
 4027:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 4028: 
 4029:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 4030:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 4031: 
 4032:    // Indices of the nodes that form the side
 4033:    const int n1 = side.n1->idx;
 4034:    const int n2 = side.n2->idx;
 4035:    isLand = false;
 4036:    
 4037: 
 4038:    // Check if the side is on a land boundary
 4039:    for (int i = 0; i < nland; i++) {
 4040:       for (int j = 0; j < nlnd[i] - 1; j++) {
 4041:          // Consecutive nodes in the land boundary segment
 4042:          const int b1 = ilnd[i + j*nland];
 4043:          const int b2 = ilnd[i + (j + 1)*nland];
 4044: 
 4045:          assert(b1 != -1 && b2 != -1);
 4046: 
 4047:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4048:             
 4049:             isLand = true;
 4050:             return i;
 4051:          }
 4052:       }
 4053:    }
 4054: 
 4055:    // Check if the side is on an open boundary
 4056:    for (int i = 0; i < nope; i++) {
 4057:       for (int j = 0; j < nond[i] - 1; j++) {
 4058:          // Consecutive nodes in the open boundary segment
 4059:          const int b1 = iond[i + j*nope];
 4060:          const int b2 = iond[i + (j + 1)*nope];
 4061: 
 4062:          assert(b1 != -1 && b2 != -1);
 4063: 
 4064:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 4065:             isLand = false;
 4066:             return i;
 4067:          }
 4068:       }
 4069:    }
 4070: 
 4071:    return -1;
 4072: }
 4073: 
 4074: 
 4075: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 4076:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4077:                                     double *wind_rotate_angle, 
 4078:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4079:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4080:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4081:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4082:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 4083: 
 4084:    NODE(pnode);  
 4085:    const int i = idx_node;
 4086:    Node &node(*pnode);
 4087: 
 4088:    node.idx = i;
 4089: 
 4090:    const int idxNodeStart = nodeNeighNodesStart[i];
 4091:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 4092:    node.numNodes = idxNodeEnd - idxNodeStart;
 4093:    node.nodes = nodeNeighNodes + idxNodeStart;
 4094:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 4095: 
 4096: 
 4097: 
 4098:    const int idxElemStart = nodeNeighElemsStart[i];
 4099:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 4100:    node.numElements = idxElemEnd - idxElemStart;
 4101:    node.elements = nodeNeighElems + idxElemStart;
 4102: 
 4103: 
 4104:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 4105:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4106:       const int partNode = localNodePart[idxNodeGlobal]; 
 4107:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4108: 
 4109:       Node *node_ptr = nodes[partNode] + idxNode;
 4110:       
 4111:       nodeNeighNodes[idx] = node_ptr;
 4112:    }
 4113: 
 4114: 
 4115:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 4116:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4117:       const int partElem = localElemPart[idxElemGlobal];
 4118:       const int idxElem  = localElemIndices[idxElemGlobal];
 4119: 
 4120:       Element *elem_ptr = elems[partElem] + idxElem;
 4121: 
 4122:       nodeNeighElems[idx] = elem_ptr;
 4123:    }      
 4124: 
 4125:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4126:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4127:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4128: 
 4129:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4130:    if constexpr(ics == 1) {
 4131:       node.p.x   = node_coords[i * 3];
 4132:       node.p.y   = node_coords[i * 3 + 1];
 4133:       node.gz = 0.0;
 4134: 
 4135:    } else {
 4136:       const double lon = deg2rad*node_coords[i * 3];
 4137:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4138: 
 4139:       Point3 p = computeXYZfromLatLon(lat, lon);
 4140:       node.p = toVector2(p);
 4141:       node.gz = p.z;
 4142:       node.lon = lon;
 4143:       node.lat = lat;
 4144: 
 4145:       #ifdef USE_FRAMES
 4146:       node.setFrame(lat, lon);
 4147:       #endif
 4148: 
 4149: 
 4150:    }
 4151: 
 4152:    node.depth = node_coords[i * 3 + 2];
 4153: 
 4154:    node.numSides = 0;
 4155: 
 4156:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4157:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 4158:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 4159:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 4160:    else assert(false && "populateNodes: selected nchi not implemented.");
 4161:    
 4162:    if constexpr(ivcor == 1) 
 4163:    {  
 4164:       node.kb = kb[i];
 4165:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 4166:    }
 4167: 
 4168:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4169:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4170:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4171: 
 4172:    
 4173:    // Links the node to the boundary information
 4174:    if (isbnd[i] >= 0) {
 4175:      
 4176:       // Get the index of the node boundary
 4177:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4178: 
 4179:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4180:       node.nodeBnd->node = &node;
 4181: 
 4182:       node.nodeBnd->sideBnd1 = nullptr;
 4183:       node.nodeBnd->sideBnd2 = nullptr;
 4184: 
 4185:       if (isbnd[i]>=0) {
 4186: 
 4187:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 4188:          
 4189:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4190:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4191: 
 4192:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4193:          node.nodeBnd->segment->clen  = nan("1");
 4194:          node.nodeBnd->segment->carea = nan("1");
 4195: 
 4196:       }
 4197:    } else {
 4198: 
 4199:       node.nodeBnd = nullptr; // For internal nodes
 4200: 
 4201:       if (isbnd[i] == landSegment) {
 4202:          node.nodeBnd = &landBoundaryNode;
 4203:          node.nodeBnd->segment = &landBoundarySegment;
 4204:       }
 4205:       
 4206:    }
 4207:    
 4208:    // XXXX GAUSSIAN HILL VELOCITIES
 4209:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4210:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4211:          constexpr double rot_per = 3000.0;
 4212:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4213:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4214:       // XXXXX
 4215:    #endif
 4216: 
 4217: }
 4218: 
 4219: 
 4220: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4221:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4222:                                     double *wind_rotate_angle,   
 4223:                                     int *isdel, int *isidenode, int *isbnd,
 4224:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4225:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4226:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4227:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4228:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4229:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4230:                                     double *drag, double *roughness) {
 4231: 
 4232: 
 4233:    SIDE(pside);
 4234:    Side &side(*pside);
 4235:    const int i = idx_side;
 4236: 
 4237:    side.idx = i;  
 4238:    
 4239:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4240:    const double fc   = 2.0*omega_e*sin(sfea0);
 4241:    const double beta = 2.0*omega_e*cos(sfea0);
 4242: 
 4243:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4244: 
 4245:    // finding the pointer to the nodes that form the side
 4246:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4247:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4248: 
 4249:    const int locidx_n1 = localNodeIndices[idx_n1];
 4250:    const int locidx_n2 = localNodeIndices[idx_n2];
 4251:    const int part_n1 =   localNodePart[idx_n1];
 4252:    const int part_n2 =   localNodePart[idx_n2];
 4253: 
 4254:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4255:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4256: 
 4257: 
 4258:    // Counts the number of sides connected to each node
 4259:    side.n1->numSides++;
 4260:    side.n2->numSides++;
 4261: 
 4262:    // Side boundary type
 4263:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4264:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4265: 
 4266:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4267:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4268:    {
 4269:       bool isLand = false;
 4270:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4271:       
 4272:       if (isbs > -1) {
 4273:          // assert(isLand || isbs>=0);
 4274:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4275: 
 4276:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4277: 
 4278:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4279:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4280: 
 4281:          assert (isLand == side.sideBnd->segment->isLand);
 4282: 
 4283:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4284:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4285:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4286: 
 4287:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4288:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4289:          
 4290:          side.sideBnd->side = &side;
 4291: 
 4292:       }
 4293:       else {
 4294:          side.sideBnd = nullptr;
 4295:       }
 4296:    }
 4297:    else 
 4298:    {
 4299:       side.sideBnd = nullptr;
 4300:    }
 4301: 
 4302: 
 4303:    // finding the pointer to the elements that share the side
 4304:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4305:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4306: 
 4307:    if (idx_e1 > -1) {
 4308:       const int locidx_e1 = localElemIndices[idx_e1];
 4309:       const int part_e1 =  localElemPart[idx_e1];
 4310:       side.elems[0] = elems[part_e1] + locidx_e1;
 4311: 
 4312:    }
 4313:    else {
 4314:       side.elems[0] = nullptr;
 4315:    }
 4316: 
 4317:    if (idx_e2 > -1) {
 4318:       const int locidx_e2 = localElemIndices[idx_e2];
 4319:       const int part_e2 =  localElemPart[idx_e2];
 4320:       side.elems[1] = elems[part_e2] + locidx_e2;
 4321:    }
 4322:    else {
 4323:       side.elems[1] = nullptr;
 4324:    }
 4325: 
 4326:    // Compute the center of the side
 4327:    side.center = 0.5*(side.n1->p + side.n2->p);
 4328: 
 4329:    #ifdef USE_FRAMES
 4330:    side.setFrame();
 4331:    #endif
 4332: 
 4333:    // Normal, unitary vector to the side
 4334:    if constexpr(ics == 1) {
 4335:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4336:       side.n = normalize(side.n);
 4337:    }
 4338:    else {
 4339:       // Unit side vector in 3D cartesian coordinates
 4340:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4341:       nSide = normalize(nSide);
 4342: 
 4343:       // It cross product with the unit local z-axis vector (nUp) is the
 4344:       // normal vector we are looking for.
 4345:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4346: 
 4347:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4348:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4349:       side.n = normalize(n2D);      
 4350: 
 4351:    }
 4352: 
 4353:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4354:    side.shapiro = shapiro0;
 4355: 
 4356:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4357:    // XXXX
 4358:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4359:    constexpr double rot_per=3000.0;
 4360:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4361:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4362:    // XXXXX      
 4363:    #endif
 4364:    // Compute the z level at the center of the side
 4365:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4366:    
 4367:    // Compute the length of the side
 4368:    const Vector2 vLen = side.n2->p - side.n1->p;
 4369:    side.len = sqrt(dot(vLen, vLen));
 4370: 
 4371: 
 4372:    // Compute the Coriolis coefficient
 4373: 
 4374:    if constexpr(ncor == -1 || ncor == 0) {
 4375:       side.coriolis = coricoef;
 4376:    }
 4377:    else {
 4378:       const double sphi = side.lat();  // Latitude at the center of the side
 4379: 
 4380:       assert(use_ll && "use_ll must be true when ncor > 0");
 4381: 
 4382:       if constexpr(ics == 1) {
 4383:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4384:       }
 4385:       else { // ics == 2
 4386:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4387:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4388:       }
 4389: 
 4390:    }
 4391: 
 4392: }
 4393: 
 4394: 
 4395: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4396:    double *node_coords, double *node_coords_ll, bool use_ll,
 4397:    double *wind_rotate_angle,   
 4398:    int *isdel, int *isidenode, int *isbnd,
 4399:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4400:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4401:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4402:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4403:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4404:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4405:    double *drag, double *roughness) {
 4406: 
 4407:    ELEM(pelem);
 4408:    Element &elem(*pelem);
 4409:    const int i = idx_elem;
 4410: 
 4411:    elem.idx = i;
 4412: 
 4413:    for (int j = 0; j < i34[i]; j++) {
 4414:       const int idxNode = elnode[i*4 + j];  
 4415:       const int idxSide = elside[i*4 + j];
 4416:       
 4417:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4418:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4419: 
 4420:       // Find the neighboring element  
 4421:       if (elem.sides[j]->elems[0] == &elem) {
 4422:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4423:       }
 4424:       else {
 4425:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4426:       }
 4427:       
 4428:    }
 4429: 
 4430:    elem.i34 = i34[i];
 4431: 
 4432:    // Compute the barycenter of the element and its depth
 4433:    elem.center = {0.0, 0.0};
 4434:    elem.depth = 1e10;
 4435:    for (int j = 0; j < i34[i]; j++) {
 4436: 
 4437:       elem.center += elem.nodes[j]->p/i34[i];
 4438:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4439:    }
 4440: 
 4441:    #ifdef USE_FRAMES
 4442:    elem.setFrame();
 4443:    #endif
 4444: 
 4445:    elem.area = elem.computeSignedArea(); 
 4446:    elem.radius = sqrt(elem.area)/pi; 
 4447:    
 4448:    // Determines which way the normal vector to each side is oriented.
 4449:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4450:    for (int j = 0; j < i34[i]; j++)  
 4451:    {
 4452:       if (elem.sides[j]->elems[0] == &elem) {
 4453:          elem.ssign[j] =  1.0;
 4454:       }
 4455:       else {
 4456:          elem.ssign[j] = -1.0;
 4457:       }
 4458: 
 4459:    }
 4460: 
 4461:   
 4462: 
 4463:    // Derivatives of shape functions
 4464:    //  For ics=2, this is done in the element frame
 4465:    //  For quads, the derivative is evaluated at centroid
 4466:    for (int j = 0; j < elem.i34; j++) {
 4467:       const double area = elem.area;
 4468:       const int id2 = elem.nxq(1 + j);
 4469:       const int id3 = elem.nxq(2 + j);
 4470:       const int id4 = elem.nxq(3 + j);
 4471:       if (elem.isTri()) {
 4472:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4473:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4474:          // da1/dx = (y1 - y2)/(2*area)
 4475: 
 4476:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4477:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4478:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4479: 
 4480:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4481:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4482: 
 4483:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4484: 
 4485:       }
 4486:       else  { // Quad; evaluate at centroid
 4487: 
 4488:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4489:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4490:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4491: 
 4492:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4493:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4494: 
 4495:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4496:       } // if Tri
 4497: 
 4498:    } // for j   
 4499:    
 4500:    
 4501: 
 4502: }
 4503: 
 4504: 
 4505: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4506:                                             double *emo, double *efa, 
 4507:                                             double *umo, double *ufa, 
 4508:                                             double *vmo, double *vfa,
 4509:                                             int *ifltype, int *iettype) {
 4510: 
 4511:    NODE_BND(nodeBnd);
 4512:    const int idx = idx_node_bnd;    
 4513: 
 4514:    nodeBnd->idx = idx;
 4515: 
 4516:    // Need to find the segment index and the index of the node on the segment
 4517:    int idxNode = -1;
 4518:    int iseg, i;
 4519:    for (iseg = 0; iseg < nope; iseg++) {
 4520:       // for each segment...
 4521:       for (i = 0; i < nond[iseg]; i++) {
 4522:          idxNode = iond[iseg + i*nope];
 4523:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4524:          
 4525:       }
 4526:    }
 4527: 
 4528:    assert(iseg < nope && "iseg is out of bounds");
 4529: 
 4530: found: // Jumped here when the node was found
 4531: 
 4532:    nodeBnd->isEssentialBC = true;
 4533:    nodeBnd->elbc = 0.0;
 4534: 
 4535:    nodeBnd->segment->ifltype = ifltype[iseg];
 4536:    nodeBnd->segment->iettype = iettype[iseg];
 4537: 
 4538:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4539: 
 4540:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4541:       nodeBnd->efa[jfr] = efa[idx2];
 4542:       nodeBnd->emo[jfr] = emo[idx2];
 4543:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4544:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4545: 
 4546:    }
 4547:         
 4548: 
 4549: }
