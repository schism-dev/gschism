10108:          *sizeType = sizeof(Vector2);
10109:          break;
10110:       case (int)VarCode::gradEta2:
10111:          *offset = (int)((char*)&sides[0].gradEta2.x - (char*)sides);
10112:          *sizeType = sizeof(Vector2);
10113:          break;
10114:       // case (int)VarCode::ghat:
10115:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
10116:       //    *sizeType = sizeof(Vector2);
10117:       //    break;   
10118:       case (int)VarCode::hhat:
10119:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
10120:          *sizeType = sizeof(Vector2);
10121:          break;      
10122:       case (int)VarCode::chi:
10123:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
10124:          *sizeType = sizeof(double);
10125:          break;
10126:       case (int)VarCode::n1:
10127:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
10128:          *sizeType = sizeof(Node);
10129:          break;
10130:       case (int)VarCode::n2:
10131:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
10132:          *sizeType = sizeof(Node);
10133:          break;                   
10134:       default:
10135:          *offset = -1;
10136:    }
10137: }
