 1442:    __device__ Mesh(int partNum,
 1443:                    int npgb, int negb, int nsgb, 
 1444:                    int np, int ne, int ns,
 1445:                    int max_np, int max_ne, int max_ns, int nseg,
 1446:                    Node **nodesPtr, Element **elemsPtr, Side **sidesPtr,
 1447:                    Node *nodesMem, Element *elemsMem, Side *sidesMem,
 1448:                    Node    **localNodeNeighNodesMem,
