  901:    
  902:    // Elevation boundary condition
  903:    int iettype;  // Type of elevation boundary condition
  904:    double eth;   // Elevation time history
  905: 
  906:    // Flow boundary condition
  907:    double qthcon;  // Flow time history constant
  908:    double vobc1;   // Velocity coefficient 1
  909:    double vobc2;   // Velocity coefficient 2
  910: 
  911:    // Tracer boundary conditions
  912:    // double trobc[natrm];    // Tracer boundary condition nudging factor
  913:    // int  itrtype[natrm];    // Tracer boundary condition type
  914: 
  915:    BoundarySegment(bool _isLand) {
  916:       isLand = _isLand;
  917:       clen = 0.0;
  918:       carea = 0.0;
  919:       ifltype = 0;
  920:       iettype = 0;
  921:       eth = 0.0;
  922:    }
  923: 
