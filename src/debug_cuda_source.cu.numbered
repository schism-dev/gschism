 1606: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000) {
 1607:    // Lock the mutex
 1608:    lock(&debugPlotMutex);
 1609:  
 1610:    if (debugPlotIdx == nullptr) return;
 1611:    if (*debugPlotIdx >= 10000) return;
 1612: 
 1613:    debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1614:    debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1615:    debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1616:    debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1617:    debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1618:    (*debugPlotIdx)++;
 1619:    // Unlock the mutex
 1620:    unlock(&debugPlotMutex);
 1621: 
 1622: }
