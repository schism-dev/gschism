  664: 
  665: template<TurbulenceModel Model>
  666: struct Turbulence {
  667:    __device__ void setDiffLimits(double, double) { /* The default implementation does nothing */ };
  668: 
  669:    __device__ void init(Node *node) {
  670:       for (int k = 0; k < nvrt; k++) {
  671:          node->dfv[k] = dfv0;
  672:          node->dfh[k] = dfh0;
  673:       }
  674:    }
  675: };   
  676: 
  677: // GLS turbulence model
  678: template<>
  679: struct Turbulence<TurbulenceModel::GLS> {
  680:    using enum TurbulenceSubmodel;
  681:    using enum StabilityModel;
  682: 
  683:    double tke[nvrt];    // TKE
  684:    double mxl[nvrt];    // mixing length for GLS
  685:    double nu_tke[nvrt]; // Vertical diffusivity for TKE 
  686:    double nu_phi[nvrt]; // Vertical diffusivity for generic length scale variable (phi)
  687: 
  688:    double diffmin;  // from diffmin.gr3
  689:    double diffmax;  // from diffmax.gr3
  690:    
  691:    __device__ void setDiffLimits(double lo, double hi) {
  692:       diffmin = lo;
  693:       diffmax = hi;
  694:    }
  695: 
  696:    // Fortran cold start: q2 = q2min, xl = xlmin2, dfq1 = dfq2 = diffmin.
  697:    // Call after setDiffLimits. depth is the node depth used by xlmin2.
  698:    __device__ void init(Node *node);
  699: 
  700: 
  701:    __device__ __forceinline__ constexpr double cpsi1() const {
  702:       if      constexpr (turbSubmodel == MellorYamada)   return 0.9;
  703:       else if constexpr (turbSubmodel == KL)             return 0.9;
  704:       else if constexpr (turbSubmodel == KE)             return 1.44;
  705:       else if constexpr (turbSubmodel == KW)             return 0.555;
  706:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  707:       else { assert(false && "unknown submodel"); return 0.0; }
  708:    }
  709: 
  710:    
  711:    __device__ __forceinline__ constexpr double cpsi2() const {
  712:       // Returns coefficient cpsi2 for the dissipation term in the GLS turbulence model
  713:       if      constexpr (turbSubmodel == MellorYamada)   return 0.5;
  714:       else if constexpr (turbSubmodel == KL)             return 0.5;
  715:       else if constexpr (turbSubmodel == KE)             return 1.92;
  716:       else if constexpr (turbSubmodel == KW)             return 0.833;
  717:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.22;
  718:       else { assert(false && "unknown submodel"); return 0.0; }
  719:    }
  720: 
  721: 
  722:    __device__ __forceinline__ double Fwall(Node *node, int k, double mxl_c) const;
  723: 
  724:    __device__ __forceinline__ double cpsi3(double N2) const {
  725: 
  726:       // Returns coefficient cpsi3 for the buoyancy production/dissipation term in the GLS turbulence model
  727:       // Remember that N2 is the signed square of the Brunt-Väisälä frequency
  728: 
  729:       if constexpr(icompute_cpsi3 != 0) { assert(false && "compute_cpsi3 not implemented for icompute_cpsi3!=0"); return 0.0; }
  730: 
  731:       if constexpr (turbSubmodel == MellorYamada) {
  732:          return 0.9;   
  733: 
  734:       } else { // Other GLS submodels
  735: 
  736: 
  737:          if (N2 > 0.0) { // unstable (inverse stratification)
  738:             return 1.0;   
  739: 
  740:          } else { // stable (regular stratification)
  741: 
  742:             if      constexpr (turbSubmodel == KL)             return 2.53;
  743:             else if constexpr (turbSubmodel == KE)             return -0.52;
  744:             else if constexpr (turbSubmodel == KW)             return -0.58;
  745:             else if constexpr (turbSubmodel == UmlaufBurchard) return  0.1;
  746:             else { assert(false && "unknown submodel"); return 0.0; }
  747:          }
  748: 
  749:       } //if constexpr (turbSubmodel == TurbulenceSubmodel::MY)
  750: 
  751:    }
  752: 
  753:    
  754:    __device__ __forceinline__ constexpr double rpub(void) const {
  755:       if      constexpr (turbSubmodel == MellorYamada)   return  0.0;
  756:       else if constexpr (turbSubmodel == KL)             return  0.0;
  757:       else if constexpr (turbSubmodel == KE)             return  3.0;
  758:       else if constexpr (turbSubmodel == KW)             return -1.0;
  759:       else if constexpr (turbSubmodel == UmlaufBurchard) return  2.0;
  760:       else { assert(false && "unknown submodel"); return 0.0; }
  761:    }
  762: 
  763: 
  764:    __device__ __forceinline__ constexpr double rmub(void) const {
  765:       if      constexpr (turbSubmodel == MellorYamada)   return 1.0;
  766:       else if constexpr (turbSubmodel == KL)             return 1.0;
  767:       else if constexpr (turbSubmodel == KE)             return 1.5;
  768:       else if constexpr (turbSubmodel == KW)             return 0.5;
  769:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.0;
  770:       else { assert(false && "unknown submodel"); return 0.0; }
  771:    }
  772: 
  773: 
  774:    __device__ __forceinline__ constexpr double rnub(void) const {
  775:       if      constexpr (turbSubmodel == MellorYamada)   return  1.0;
  776:       else if constexpr (turbSubmodel == KL)             return  1.0;
  777:       else if constexpr (turbSubmodel == KE)             return -1.0;
  778:       else if constexpr (turbSubmodel == KW)             return -1.0;
  779:       else if constexpr (turbSubmodel == UmlaufBurchard) return -0.67;
  780:       else { assert(false && "unknown submodel"); return 0.0; }
  781:    }
  782: 
  783: 
  784:    __device__ __forceinline__ constexpr double schk(void) const {
  785:       if      constexpr (turbSubmodel == KL)             return 2.44;
  786:       else if constexpr (turbSubmodel == KE)             return 1.0;
  787:       else if constexpr (turbSubmodel == KW)             return 2.0;
  788:       else if constexpr (turbSubmodel == UmlaufBurchard) return 0.8;
  789:       else { assert(false && "schk not set for this submodel"); return 0.0; }
  790:    }
  791: 
  792: 
  793:    __device__ __forceinline__ constexpr double schpsi(void) const {
  794:       if      constexpr (turbSubmodel == KL)             return 2.44;
  795:       else if constexpr (turbSubmodel == KE)             return 1.3;
  796:       else if constexpr (turbSubmodel == KW)             return 2.0;
  797:       else if constexpr (turbSubmodel == UmlaufBurchard) return 1.07;
  798:       else { assert(false && "schpsi not set for this submodel"); return 0.0; }
  799:    }
  800: 
  801: 
  802:    __device__ __forceinline__ constexpr double tkemin(void) const {
  803:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL)
  804:          return 5.0e-6;
  805:       else
  806:          return 7.6e-6; // Warner et al., OM 2005
  807:    }
  808: 
  809: 
  810:    __device__ __forceinline__ constexpr double psimin(void) const {
  811:       if constexpr (turbSubmodel == MellorYamada || turbSubmodel == TurbulenceSubmodel::KL)
  812:          return 1.0e-8;
  813:       else
  814:          return 1.0e-12; // Warner et al., OM 2005
  815:    }
  816: 
  817:    __device__ __forceinline__ constexpr double epsmin(void) const {
  818:       return 1.0e-12;  // GOTM/SCHISM default; floor for dissipative length cap
  819:    }
  820: 
  821:    __device__ __forceinline__ double mxlmin(double depth) const;
  822: 
  823:    
  824:    __device__ __forceinline__ double N2_c(Node *node, int k) const;
  825: 
  826:    __device__ __forceinline__ double N2(Node *node, int k) const;
  827: 
  828: 
  829:    __device__ __forceinline__ double vegTurbProduction(Node *node, int k) const;
  830: 
  831:    __device__ void computeDiffusivities(Node *node);
  832: 
  833:    __device__ __forceinline__ double maxMixingLength(Node *node, int k) const;
  834: 
  835: 
  836:    // Conversions between the generic length-scale variable Phi and the mixing length mxl.
  837:    __device__ __forceinline__ double phiFromMxl(double tke, double mxl) const {
  838:       return pow(cmiu0, rpub()) * pow(tke, rmub()) * pow(mxl, rnub());
  839:    }
  840: 
  841: 
  842:    __device__ __forceinline__ double mxlFromPhi(double tke, double phi) const {
  843:       return pow(phi * pow(cmiu0, -rpub()) * pow(tke, -rmub()), 1.0/rnub());
  844:    }
  845: 
  846: };
