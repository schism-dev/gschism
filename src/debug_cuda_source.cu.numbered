 7397: extern "C" __global__ void getSideVarAddr(int varCode, void **addr, int *offset, int *sizeSide, int *sizeType) {
 7398:    Side *sides = mesh->localSideData;
 7399: 
 7400:    *addr = sides;
 7401:    *sizeSide = sizeof(Side);
 7402:    switch (varCode) {
 7403:       case (int)VarCode::z:
 7404:          *offset = (int)((char*)&sides[0].zc - (char*)sides);
 7405:          *sizeType = sizeof(double);
 7406:          break;
 7407:       // case (int)VarCode::depth:
 7408:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7409:       //    *sizeType = sizeof(double);
 7410:       //    break;         
 7411:       case (int)VarCode::x:
 7412:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
 7413:          *sizeType = sizeof(Vector2);
 7414:          break;
 7415:       case (int)VarCode::len:
 7416:          *offset = (int)((char*)&sides[0].len - (char*)sides);
 7417:          *sizeType = sizeof(double);
 7418:          break;
 7419:       case (int)VarCode::kb:
 7420:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7421:          *sizeType = sizeof(int);
 7422:          break;
 7423:       case (int)VarCode::isdry:
 7424:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7425:          *sizeType = sizeof(int);
 7426:          break;            
 7427:       case (int)VarCode::w:
 7428:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7429:          *sizeType = sizeof(double);
 7430:          break;
 7431:       case (int)VarCode::u:
 7432:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7433:          *sizeType = sizeof(Vector2);
 7434:          break;   
 7435:       case (int)VarCode::btu:
 7436:          *offset = (int)((char*)&sides[0].btu[0].x - (char*)sides);
 7437:          *sizeType = sizeof(Vector2);
 7438:          break;          
 7439:       case (int)VarCode::U:
 7440:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7441:          *sizeType = sizeof(Vector2);
 7442:          break;
 7443:       // case (int)VarCode::ghat:
 7444:       //    *offset = (int)((char*)&sides[0].ghat.x - (char*)sides);
 7445:       //    *sizeType = sizeof(Vector2);
 7446:       //    break;   
 7447:       case (int)VarCode::hhat:
 7448:          *offset = (int)((char*)&sides[0].hhat - (char*)sides);
 7449:          *sizeType = sizeof(Vector2);
 7450:          break;      
 7451:       case (int)VarCode::chi:
 7452:          *offset = (int)((char*)&sides[0].chi - (char*)sides);
 7453:          *sizeType = sizeof(double);
 7454:          break;
 7455:       case (int)VarCode::n1:
 7456:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7457:          *sizeType = sizeof(Node);
 7458:          break;
 7459:       case (int)VarCode::n2:
 7460:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7461:          *sizeType = sizeof(Node);
 7462:          break;                   
 7463:       default:
 7464:          *offset = -1;
 7465:    }
 7466: }
