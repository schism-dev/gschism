 6931: #ifdef DONTCOMPILE
 6932: __device__ void computeVerticalAdvection(void) {
 6933:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 6934: 
 6935:    sdbt(1:2,:,:)=0.d0
 6936: 
 6937:    const Side *side = FROM kernel;
 6938: 
 6939:    if(side->isDry) return;
 6940: 
 6941:    // If side is wet...
 6942: 
 6943: 
 6944:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 6945:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 6946:    double ws[nvrt] = {} // w @ side
 6947:    int icount = 0;
 6948:    for (int j=0; j<2; j++) {
 6949:       const Element *elem = side->elements[j];
 6950:        
 6951:       if(elem != nullptr) {
 6952:          icount++;
 6953:          for (int k=0; k<nvrt; k++) {
 6954:             ws[k] = ws[k] + elem->w[k];
 6955:          }
 6956:       }
 6957:    }  // for j
 6958: 
 6959:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 6960:    ws = ws/icount;
 6961: 
 6962:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 6963:    // Splines allow for a smooth transition between vertical levels.
 6964:    // Splines have continuity restrictions at the internal knots, but
 6965:    // we have to provide the 1st derivatives at the endpoints.
 6966:    const int kbs = side->kbs; 
 6967:    
 6968:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6969:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6970:    initCubicSpline(kbs, nvrt, side, ws, up)
 6971: 
 6972:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 6973:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 6974:    initCubicSpline(kbs, nvrt, side, ws, vp)
 6975: 
 6976:    // Total advection (average onto side)
 6977:    const Node *node1 = side->nodes[0];
 6978:    const Node *node2 = side->nodes[1];
 6979:    for (int k=kbs(i); k<nvrt; k++) {
 6980: 
 6981:       if constexpr(ics==1) {
 6982:          sdbt(1,k,i) = side->u2[k] - dt*(node1->bcc[1][k] + node2->bcc[1][k])/2.d0 - dt*side->u2p[k]
 6983:          sdbt(2,k,i) = side->v2[k] - dt*(node1->bcc[2][k] + node2->bcc[2][k])/2.d0 - dt*side->v2p[k]
 6984:       } else {
 6985:          // XXX IMPLEMENT THIS
 6986:          // call project_hvec(bcc(1,k,n1),bcc(2,k,n1),pframe(:,:,n1),sframe2(:,:,i),vn1,vn2)
 6987:          // call project_hvec(bcc(1,k,n2),bcc(2,k,n2),pframe(:,:,n2),sframe2(:,:,i),tt1,ss1)
 6988:          // sdbt(1,k,i)=su2(k,i)-dt*(vn1+tt1)/2.d0-dt*swild2(k,1)
 6989:          // sdbt(2,k,i)=sv2(k,i)-dt*(vn2+ss1)/2.d0-dt*swild2(k,2)
 6990:       }  // if ics
 6991: 
 6992: 
 6993:    }
 6994: }
 6995: #endif
 6996: 
 6997: 
 6998: extern "C" {
 6999:    __global__ void computeElemAverageGhat(void) {
 7000:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7001: 
 7002:       ELEM(elem);
 7003:       
 7004:       elem->ghat1= {0.0, 0.0};  
 7005: 
 7006:       if constexpr(ihydraulics != 0) {
 7007:          if (nhtblocks > 0 && elem->isblock) return;
 7008:       }
 7009: 
 7010:       if (elem->isDry) return;
 7011: 
 7012:       // Wet elements.
 7013:       // Warning: ghat1=elem average of \breve{G} must include all: Coriolis, atmo. pressure, 
 7014:       // tidal potential, horizontal diffusion, and baroclinic etc
 7015:       // Remember to update both fb and F 
 7016:       // If ics=2, ghat1 are in eframe (ll)
 7017:       // cff1-3: coefficients for 2D/3D
 7018:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7019:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7020:       elem->gradETP = {0.0, 0.0};  // \nabla etp
 7021: 
 7022:       double av_cff1 = 0.0;  // av. for cff1
 7023:       double av_cff2 = 0.0;  // av. for cff2
 7024:       double av_cff3 = 0.0;  // av. for cff3
 7025:       double av_df = 0.0;  // av. for H^\alpha / H
 7026:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7027:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7028: 
 7029:       const int i34 = elem->i34;
 7030:       const int kb = elem->kb;
 7031: 
 7032:       for (int j=0; j<i34; j++) {
 7033:          // For each node and side in the element...
 7034: 
 7035:          const Node *node = elem->nodes[j];
 7036:          const Side *side = elem->sides[j];
 7037: 
 7038:          const double chi      = side->chi;
 7039:          const double veg_c2   = side->veg_c2;
 7040:          const double veg_beta = side->veg_beta;
 7041:          const double veg_h    = side->veg_h();
 7042:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7043: 
 7044:          // Node - const in elem
 7045:          elem->gradEta += node->eta2*elem->gradPhi[j];  // in eframe if ics=2
 7046:          elem->gradPr  += node->pr  *elem->gradPhi[j];
 7047: 
 7048:          if (elem->depth >= tip_dp) {
 7049:            elem->gradETP += node->ETP*elem->gradPhi[j];
 7050:          }
 7051: 
 7052:          
 7053:          const double htot  = side->htot2();        // Total depth at the side
 7054:          const double zctr2 = side->zTopCanopy();  
 7055: 
 7056:          double cff1; 
 7057:          double cff2; 
 7058:          double cff3;   
 7059:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7060:          // coefficients applied to 2D/3D case 
 7061:             cff1 = side->hhat/htot;
 7062:             cff2 = 0.0;
 7063:             cff3 = 0.0;
 7064:          } else { //3D
 7065:             //Init for no-veg case
 7066:             cff1 = 1.0;
 7067:             cff2 = 1.0;
 7068:             cff3 = 0.0;
 7069: 
 7070:             if constexpr(iveg != 0) {
 7071:                // Computes coefficients used with vegetation terms G1, G2
 7072:                // cff1, cff3 are used for the first two terms in G1, G2:
 7073:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7074:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7075:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7076:                if(veg_h < 0.99*htot) { // submergent vegetation
 7077:                   cff1=1;
 7078:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7079:                   cff3 = veg_c;
 7080: 
 7081:                } else { // emergent vegetation
 7082:                   cff1 = 1.0/(1.0 + veg_c2);
 7083:                   cff2 = cff1;
 7084:                   cff3 = 0.0;
 7085: 
 7086:                }
 7087:             } // if iveg
 7088:          } //  2D/3D
 7089: 
 7090:          av_cff1 += cff1/i34;
 7091:          av_cff2 += cff2/i34;
 7092:          av_cff3 += cff3/i34;
 7093:          av_cff2_chi += cff2*chi/i34;
 7094:          av_cff3_chi += cff3*chi/i34;
 7095:          av_df += min(htot, veg_h)/(htot*i34);
 7096: 
 7097: 
 7098:          // btrack values: U^\star, U^{\star\alpha}
 7099:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7100:          Vector2 Ustar       = {0.0, 0.0}; 
 7101:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7102: 
 7103:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7104:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7105:          } else { //3D
 7106:             for (int k = side->kb; k < nvrt; k++) {
 7107:             
 7108:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7109:                Ustar += w2;
 7110: 
 7111:                if constexpr(iveg != 0) {
 7112:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7113:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7114:                        Ustar_alpha += zrat*w2; // XXXX
 7115:                    }
 7116:                }  // if iveg
 7117:             }  // for k
 7118:          }  //2D/3D
 7119:          
 7120: 
 7121:          // Add btrack & surface stress terms to \breve{G} first
 7122:          if constexpr(ics==1) {
 7123: 
 7124:             elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7125: 
 7126:          } else {
 7127:             // XXX IMPLEMENT THIS
 7128:             // call project_hvec(xtmp,ytmp,sframe2(:,:,isd),eframe(:,:,i),tt1,ss1)
 7129:             // elem->ghat1[0] += cff1*vn1 - cff3*tt1;
 7130:             // elem->ghat1[1] += cff1*vn2 - cff3*ss1;
 7131:          }  // if ics
 7132: 
 7133:          // Surface and bottom stress terms
 7134:          if constexpr(ics==1) {
 7135:             const Vector2 tau    = side->tau();
 7136:             const Vector2 ubstar = side->btu[side->kb + 1]; // XXX CHECK INDICES
 7137: 
 7138:             // Term for surface and bottom stress
 7139:             elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7140: 
 7141:          } else {
 7142:             assert(false && "computeElemAverageGhat: Not implemented");
 7143:             // XXX IMPLEMENT THIS
 7144:             // n1=isidenode(1,isd); n2=isidenode(2,isd)
 7145:             // call project_hvec(tau(1,n1),tau(2,n1),pframe(:,:,n1),eframe(:,:,i),vn1,vn2)
 7146:             // call project_hvec(tau(1,n2),tau(2,n2),pframe(:,:,n2),eframe(:,:,i),tt1,ss1)
 7147:             // tau_x=(vn1+tt1)/2.d0
 7148:             // tau_y=(vn2+ss1)/2.d0
 7149:             // call project_hvec(sdbt(1,kbs(isd)+1,isd),sdbt(2,kbs(isd)+1,isd),sframe2(:,:,isd),eframe(:,:,i),ubstar,vbstar)
 7150:          }  // if ics
 7151: 
 7152:          
 7153: 
 7154:          // All terms in F,F^\alpha,f_b except baroclinic
 7155:          // F, f_b: all explicit terms excluding vegetation 
 7156:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7157:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7158:          const double coriolis = side->coriolis;
 7159:          Vector2 F  =  coriolis*side->U;  // F_x
 7160:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7161:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7162: 
 7163:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7164:             
 7165:             for (int k = side->kb; k < nvrt; k++) {
 7166:                if (zctr2 > side->zc[k-1]) {
 7167:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7168:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7169:                    Fa +=  coriolis*w2*zrat;
 7170:                } // if zctr2
 7171:             } // k
 7172:          } // iveg
 7173: 
 7174:          // Integrate horizontal viscosity force vertically
 7175:          for (int k=side->kb + 1; k<nvrt; k++) {
 7176:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7177: 
 7178:             F += levelHorVisc;
 7179: 
 7180:             // Vegetation term
 7181:             if constexpr(iveg!=0) {
 7182:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7183:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7184:                   Fa += levelHorVisc*zrat;
 7185:                } 
 7186:             } // if iveg
 7187:          } // for k
 7188: 
 7189:          fb += side->nuGradU[side->kb];
 7190: 
 7191:          // Add to ghat1
 7192:          if constexpr(ics==2) {
 7193:             // XXX IMPLEMENT THIS
 7194:             // call project_hvec(bigf1,bigf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7195:             // bigf1=vn1; bigf2=vn2
 7196:             // call project_hvec(botf1,botf2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7197:             // botf1=vn1; botf2=vn2
 7198:             // call project_hvec(bigfa1,bigfa2,sframe2(:,:,isd),eframe(:,:,i),vn1,vn2)
 7199:             // bigfa1=vn1; bigfa2=vn2
 7200:          } // if ics
 7201: 
 7202:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7203:       } // for j (nodes and sides)
 7204: 
 7205:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7206:          
 7207:       // Finish off terms in F, F^\alpha and f_b
 7208:       const double grav3 = elem->mean(&Node::grav2);
 7209:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7210: 
 7211: 
 7212:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7213:       for (int j=1; j<i34; j++) { 
 7214:          // For each side in the element...
 7215:          const Side *side = elem->sides[j];
 7216:          const double chi = side->chi;
 7217: 
 7218:          const double htot = side->htot2();
 7219:          const double veg_h = side->veg_h();
 7220:          const Vector2 F  = htot*fb;
 7221:          const Vector2 Fa = min(htot, veg_h)*fb;
 7222: 
 7223:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7224:       } // for j
 7225: 
 7226:       //botf1 etc are already in elem frame
 7227:       elem->ghat1 += tmp/i34;
 7228: 
 7229:       // Baroclinic force
 7230:       if constexpr(ibc==0) {
 7231:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7232: 
 7233:          Vector2 Fa = {0.0, 0.0};
 7234:          Vector2 intGradRho = {0.0, 0.0};
 7235:          
 7236:          // \sum_{l=k}^N dr*dz; whole level (and eframe if ics=2)
 7237:          for (int k=nvrt-2; k > kb + 1; k--) { /// XXXX CHECK INDICES
 7238:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7239: 
 7240:             // \in F [m^2/s/s]
 7241:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7242:          }
 7243: 
 7244:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7245:          const Vector2 F = av_df*Fa; //approx
 7246:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7247: 
 7248:       } // if ibc
 7249: 
 7250: 
 7251: 
 7252:    }
 7253: 
 7254: } // extern "C"
 7255: 
 7256: 
 7257: 
 7258: #ifdef DONTCOMPILE
 7259: __global__ void checkMassConservation(Tracers* sumtr) {
 7260: 
 7261:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7262: 
 7263:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7264: 
 7265:    Element *elem = &(mesh->localElemData[i]);
 7266: 
 7267:    // Skip dry elements
 7268:    if (elem->isDry) return;
 7269: 
 7270:    // Local sum array for this thread
 7271:    double localSum[N_TRACERS] = {0.0};
 7272: 
 7273:    // Sum over vertical levels for this element
 7274:    const int kbe = elem->kbe;
 7275:    const double area = elem->area;
 7276: 
 7277:    for (int k = kbe; k < nvrt; k++) {
 7278:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7279:       
 7280:       // Accumulate tracer mass
 7281:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7282:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7283:       }
 7284:    }
 7285: 
 7286:    //  This function returns per element sums. A reduction must be done on the host side.
 7287: }
 7288: 
 7289: 
 7290: __global__ void transport(void) {
 7291: 
 7292:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7293: 
 7294:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7295: 
 7296:    Element *elem = &(mesh->localElemData[ie]);
 7297: 
 7298:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7299: 
 7300:                for (int m=0; m<ntr; m++) {
 7301:                   for (int k=kbe(ie); k<nvrt; k++) {
 7302:                      // Calculate each polynomial's weight 
 7303:                      wm=0.d0; sum1=0.d0; 
 7304:                      wm1=0.d0; wm2=0.d0; 
 7305:                      for (int i=0; i<elem->nweno2; i++) {
 7306:                   
 7307:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7308:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7309:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7310:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7311:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7312:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7313:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7314:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7315:                      // -----------------Hu and Shu (1999)'s method----------------
 7316:                      b4=b1+b2+b3
 7317: 
 7318: //Error: add PRODUCTION CPP
 7319: #ifdef DEBUG
 7320:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7321:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7322:                     call parallel_abort(errmsg)
 7323:                   }
 7324: #endif
 7325: 
 7326:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7327:                   // !----test-------------- 
 7328:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7329:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7330:                   // !wm(i)=wm1(i)*wm2(i)
 7331:                   // !---------------------- 
 7332:                   sum1=sum1+wm(i)
 7333:                 } // end for i
 7334: 
 7335:                 wm=wm/sum1
 7336: 
 7337:                 for (int j=0; j<elem->i34; j++) {
 7338: 
 7339:                   const Side *side  = elem->sides[j];
 7340:                   const Node *node1 = side->n1;
 7341:                   const Node *node2 = side->n2;
 7342: 
 7343:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7344:                      trsd=0.d0
 7345:                      for (int kk=0; kk<nquad; kk++) {
 7346:                         for (int i=0; i<elem->nweno2; i++) {
 7347:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7348:                         } // end for i   
 7349:                      } // end for kk
 7350:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7351:                   } // outward flux
 7352:                } // end for j=1,i34(ie) ! side
 7353:             }
 7354:          }
 7355:               
 7356: 
 7357: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7358: //             //   calculate each polynomial's weight 
 7359: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7360: //                 wm=0.d0; sum1=0.d0
 7361: //                 do i=1,nweno1(ie) !for each polynomial
 7362: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7363: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7364: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7365: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7366: //                   wm(i)=b2
 7367: //                   sum1=sum1+b2
 7368: //                   !wm(i)=1.d0
 7369: //                   !sum1=sum1+1.d0
 7370: 
 7371: // // Error: PRODUCTION
 7372: // #ifdef DEBUG
 7373: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7374: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7375: //                     call parallel_abort(errmsg)
 7376: //                   endif
 7377: // #endif
 7378: 
 7379: //                 enddo !i
 7380: //                 wm=wm/sum1 !final weight
 7381: 
 7382:                 for (int j=0; j<elem->i34; j++) { // side
 7383:                   const Side *side = elem->sides[j];
 7384:                   const Node *node1 = side->n1;
 7385:                   const Node *node2 = side->n2;
 7386: 
 7387:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7388:                     trsd=0.d0
 7389:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7390:                       for (int i=0; i<elem->nweno1; i++) {
 7391:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7392:                       }
 7393:                     enddo //kk
 7394:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7395:                   } // outward flux
 7396:                 } // end for j=1,i34(ie) ! side
 7397:               } // end for k; ntr 
 7398: 
 7399:             else !simple upwind method
 7400:               do j=1,i34(ie)
 7401:                 jsj=elside(j,ie)
 7402:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7403:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7404:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7405:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7406:                   endif
 7407:                 enddo  !vertical layers
 7408:               enddo !j=1,i34(ie) ! side
 7409:             endif !order of accuracy
 7410: 
 7411:          //  enddo !ie
 7412: // !$OMP     end do
 7413: 
 7414: // !$OMP     master
 7415: //           !message passing
 7416: //           if (nproc>1) then
 7417: //             !make a copy of side concentrations
 7418: //             trsd_tmp0=trsd_tmp 
 7419: 
 7420: //             !this exchange routine swaps interface concentration between two partitions
 7421: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7422: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7423: 
 7424: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7425: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7426: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7427: 
 7428: 
 7429: //             !This obtains final values for interface sides
 7430: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7431: //       :    endif !nproc>1
 7432: //           !message passing end
 7433: // !$OMP     end master
 7434: // !$OMP     barrier
 7435: 
 7436: 
 7437: // !         Do advection; conc @ dry elem will not be changed
 7438: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7439: // !$OMP     do reduction(+: h_mass_in)
 7440: //           do i=1,ne
 7441: //             if(idry_e(i)==1) cycle
 7442: 
 7443: 
 7444: // !           Wet elements with 3 wet nodes
 7445: //             do k=kbe(i)+1,nvrt
 7446: 
 7447: 
 7448: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7449: //               dtb_by_bigv = dtb/bigv
 7450:     
 7451: // !             Advective flux
 7452: //               if (ntd_weno==1 .or. itd_weno==1) then
 7453: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7454: //               else
 7455: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7456: //               endif
 7457: 
 7458: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7459: //               do j=1,i34(i)
 7460: //                 jsj=elside(j,i) !side
 7461: //                 iweno=.true. !use weno reconstruction as default
 7462: //                 iel=ic3(j,i) !neighboring elem
 7463: 
 7464: //                 if(iel/=0) then
 7465: //                   if(idry_e(iel)==1) cycle
 7466: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7467: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7468: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7469: //                     iweno=.false.
 7470: //                   endif
 7471: //                 else !land or open bnd side
 7472: //                   !skip land bnd and outflowing open bnd, 
 7473: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7474: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7475: //                     !For outflow open bnd side, estimate mass in (open
 7476: //                     !side cannot be interface side)
 7477: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7478: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7479: //                     endif
 7480: 
 7481: //                     cycle
 7482: //                   endif
 7483: 
 7484: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7485: //                   iweno=.false.  !reset to upwind
 7486: //                   ibnd=isbs(jsj) !global bnd #
 7487: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7488: //                   nwild(1:2)=0
 7489: //                   do ll=1,2 !nodes
 7490: //                     ndo=isidenode(ll,jsj)
 7491: //                     do lll=1,2 !2 possible bnds
 7492: //                       if(isbnd(lll,ndo)==ibnd) then
 7493: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7494: //                         exit
 7495: //                       endif
 7496: //                     enddo !lll
 7497: //                   enddo !ll
 7498: //                   ind1=nwild(1); ind2=nwild(2);
 7499: 
 7500: //                   do jj=1,natrm
 7501: //                     if(ntrs(jj)<=0) cycle
 7502: 
 7503: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7504: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7505: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7506: //                       enddo !ll
 7507: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7508: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7509: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7510: //                       enddo !ll
 7511: //                     else if(itrtype(jj,ibnd)==3) then
 7512: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7513: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7514: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7515: //                       enddo !ll
 7516: //                     else if(itrtype(jj,ibnd)==4) then
 7517: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7518: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7519: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7520: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7521: //                       enddo !ll
 7522: //                     else
 7523: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7524: //   !'
 7525: //                       call parallel_abort(errmsg)
 7526: //                     endif !itrtype
 7527: 
 7528: //                   enddo !jj
 7529: 
 7530: //                   !Tally horizontal mass in for inflow case
 7531: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 7532: //                 endif !iel
