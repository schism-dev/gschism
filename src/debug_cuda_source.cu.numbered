 4255:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 4256:       NODE(node);
 4257: 
 4258:       const int idx = node->idx;
 4259:       Vector2 wind = {xWind[idx], yWind[idx]};
 4260: 
 4261:       if constexpr(nws != 0 && iwindoff != 0) {
 4262:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 4263:       }
 4264: 
 4265:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 4266:       node->setWind(wind);
 4267: 
 4268:       node->pr = pressAir[idx];
 4269:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 4270: 
 4271:    }
