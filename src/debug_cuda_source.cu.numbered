 5584: 
 5585: 
 5586: 
 5587: 
 5588:    __global__ void solverCopyResult(double* x) {
 5589:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 5590:       NODE(node);
 5591:       const int idx = node->idx;
 5592: 
 5593:       node->mX = x[idx];
