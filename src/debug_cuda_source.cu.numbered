 3440: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3441:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3442:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3443:                 int *isdel, int *isidenode, int *isbnd,
 3444:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3445:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3446:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3447:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3448:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3449:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3450:                 double *drag, double *roughness,
 3451:                 double *emo, double *efa, 
 3452:                 double *umo, double *ufa, 
 3453:                 double *vmo, double *vfa) {
 3454: 
 3455:    printf("Populating mesh for partition %d\n", partNum);
 3456: 
 3457:    // XXXXXX THIS function does almost nothing. 
 3458: 
 3459:    nbs = *sharedIdxSideBoundary + 1;
 3460:    nbp = *sharedIdxNodeBoundary + 1;
 3461: 
 3462:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 3463: 
 3464: }
 3465: 
 3466: 
 3467: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 3468:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 3469:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 3470: 
 3471: 
 3472:    NODE(node1);
 3473: 
 3474:    node1->clearMatrixRow();
 3475:    node1->qel = 0.0;
 3476: 
 3477:    // THIS IS FOR STRUCTURES XXX
 3478:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 3479: 
 3480:    
 3481:    for (int j=0; j<node1->numElements; j++) {
 3482:       // For each element connected to the node...
 3483: 
 3484:       Element *elem = node1->elements[j];
 3485: 
 3486: 
 3487: 
 3488:       // Compute the average gravity
 3489:       const double grav3 = elem->mean(&Node::grav2);
 3490: 
 3491:       // Look at the documentation for the description of the terms in the following integrals
 3492: 
 3493:       // Integral I_1 
 3494:       // \bar{\breve{H}} 
 3495:       const double hhatb = elem->mean(&Side::hhat);        
 3496: 
 3497:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 3498: 
 3499:       const int id1 = elem->nodeLocalIdx(node1); 
 3500:       const double area = elem->area;
 3501: 
 3502:       if (elem->isTri()) {
 3503: 
 3504:          // To clarify the notation in this section: 
 3505:          //   i stands for the node under consideration (node1)
 3506:          //   j (node2) and k (node3) are the other nodes of the triangle.
 3507:          const int id2 = elem->nxq(1 + id1);
 3508:          const int id3 = elem->nxq(2 + id1);
 3509:          Node *node2 = elem->nodes[id2];
 3510:          Node *node3 = elem->nodes[id3];
 3511: 
 3512:          const Point2 x1 = node1->p;
 3513:          const Point2 x2 = node2->p;
 3514:          const Point2 x3 = node3->p;
 3515: 
 3516:          // integral of phi_i*phi_j
 3517:          const double ipp_ii = (1.0/6.0 )*area;
 3518:          const double ipp_ij = (1.0/12.0)*area;
 3519:          const double ipp_ik = (1.0/12.0)*area;
 3520: 
 3521:          // integral of [(grad phi_i) * (grad phi_j)]
 3522:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 3523:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 3524:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 3525: 
 3526:          // Computes the different components of integral I_1 of each node with respect to node i.
 3527:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3528:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3529:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3530: 
 3531:          node1->addToSparseMatrix(node1, I1_ii);
 3532:          node1->addToSparseMatrix(node2, I1_ij); 
 3533:          node1->addToSparseMatrix(node3, I1_ik);
 3534: 
 3535:       }
 3536:       else { // Quad
 3537:          // XXX IMPLEMENT THIS
 3538:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3539: 
 3540:          // To clarify the notation in this section: 
 3541:          //   i stands for the node under consideration (node1)
 3542:          //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 3543:          const int id2 = elem->nxq(1 + id1);
 3544:          const int id3 = elem->nxq(2 + id1);
 3545:          const int id4 = elem->nxq(3 + id1);
 3546:          Node *node2 = elem->nodes[id2];
 3547:          Node *node3 = elem->nodes[id3];
 3548:          Node *node4 = elem->nodes[id4];         
 3549: 
 3550:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 3551:          const double ipp_ii = elem->intPhiPhi(id1, id1);
 3552:          const double ipp_ij = elem->intPhiPhi(id1, id2);
 3553:          const double ipp_ik = elem->intPhiPhi(id1, id3);
 3554:          const double ipp_il = elem->intPhiPhi(id1, id4);
 3555: 
 3556:          // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 3557:          const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 3558:          const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 3559:          const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 3560:          const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 3561: 
 3562:          // Computes the different components of integral I_1 of each node with respect to node i.
 3563:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 3564:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 3565:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 3566:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 3567: 
 3568:          node1->addToSparseMatrix(node1, I1_ii);
 3569:          node1->addToSparseMatrix(node2, I1_ij); 
 3570:          node1->addToSparseMatrix(node3, I1_ik);
 3571:          node1->addToSparseMatrix(node4, I1_il);
 3572:   
 3573:       } 
 3574: 
 3575:  
 3576:       // Integral I_4
 3577:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 3578:       // Where
 3579:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 3580: 
 3581:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 3582:       // of U over the element.
 3583:       Vector2 U = {0.0, 0.0};
 3584:       for (int m=0; m < elem->i34; m++) {      
 3585:          const Side *side = elem->sides[m];
 3586: 
 3587:          if constexpr(ics == 1) U += side->U; // XXXXX IS THIS JUST ONE VALUE OR TWO????
 3588:          else                   U += side->frame.project_hvec(side->U, elem->frame);
 3589:       }
 3590:       U = U/elem->i34;
 3591: 
 3592: 
 3593:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 3594: 
 3595: 
 3596:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 3597:       const double I_4_1 = dot(gradPhi_1, U);
 3598: 
 3599: 
 3600:       // Integral of \nabla\phi_i \cdot \pmb{E}
 3601:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 3602: 
 3603:      
 3604:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 3605: 
 3606:       // Additional terms 
 3607:       double vnorm = 0.0;
 3608:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 3609:          Vector3 ubed = {0.0, 0.0, 0.0};
 3610:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 3611: 
 3612:          Vector3 gradP = {0.0, 0.0, 1.0};
 3613:          for (int m=0; m < elem->i34; m++) {
 3614:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 3615:            gradP += toVector3(gradP_2D, 0.0);
 3616:          }   
 3617:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 3618:       } // imm==2
 3619: 
 3620:       if (elem->isTri()) {
 3621:          for (int l=0; l<3; l++) {
 3622: 
 3623:             Node *node = elem->nodes[l];
 3624: 
 3625:             double fac = (node == node1) ? 2.0 : 1.0;
 3626:             if constexpr(imm==2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 3627:             else                 node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + node->bdef2 - node->bdef1);
 3628:            
 3629:          }
 3630: 
 3631: 
 3632:          if (!elem->isDry) {
 3633:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 3634: 
 3635:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 3636: 
 3637:          }
 3638: 
 3639:       } // isTri
 3640:       else { // isQuad
 3641:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 3642:          // for (int l=0; l<4; l++) {
 3643:          //   const Node *node = elem->nodes[l];
 3644: 
 3645:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 3646:          //   else        tmp2 = node->bdef2 - node->bdef1;
 3647: 
 3648:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 3649:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 3650:          // }
 3651: 
 3652:       } // isQuad
 3653: 
 3654: 
 3655:      node1->qel += (dt/elem->i34)*elem->vsource;
 3656:       
 3657: 
 3658:    } // for all elements connected to the node
 3659:    
 3660: 
 3661:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 3662:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 3663:    NodeBoundary *nodeBnd = node1->nodeBnd;
 3664:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 3665:       // If it is an open boundary node...
 3666: 
 3667:       // At least one open bnd side, maybe two
 3668:       for (int l=0; l<2; l++) { 
 3669: 
 3670:          // Gets each of the sides sharing the node. 
 3671:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 3672: 
 3673:        
 3674: 
 3675:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 3676:          if (sideBnd != nullptr) {
 3677:             // If the side is on a boundary...
 3678: 
 3679:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 3680: 
 3681:             // Get the boundary segment
 3682:             const BoundarySegment *sideSegment = sideBnd->segment;
 3683:             const Side *side = sideBnd->side;
 3684: 
 3685:             // Integral I_3
 3686:             if (sideSegment->ifltype != 0) {
 3687:             // Natural or Flather b.c.
 3688: 
 3689:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 3690:                // especially for Flather b.c.
 3691:                double ri3 = 0.0;
 3692:                if (!side->isDry) {
 3693:                   // If the side is not dry
 3694:                   
 3695:                   // Computes the side flux of (uth, vth)
 3696:                   double Vn = 0.0;
 3697:                   for (int k = side->kb; k < nvrt - 1; k++) {
 3698:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 3699:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 3700: 
 3701:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 3702:                   }
 3703: 
 3704:                   ri3 = 0.5*side->len*Vn;
 3705:                }
 3706: 
 3707:                if (sideSegment->ifltype == -1) { // Flather 1
 3708: 
 3709:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 3710:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 3711: 
 3712:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 3713:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 3714:                   
 3715:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 3716:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 3717: 
 3718:                } 
 3719:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 3720:                   // Reset ri3
 3721:                   ri3 = 0.0;
 3722: 
 3723:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 3724: 
 3725:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 3726: 
 3727:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 3728:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 3729: 
 3730:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 3731:                   node1->addToSparseMatrix(node1, con0*2.0);
 3732:                   node1->addToSparseMatrix(node2, con0);
 3733: 
 3734:                } // if Flather or Discharge
 3735: 
 3736:                node1->qel -= thetai*dt*ri3;
 3737: 
 3738: 
 3739:             } // I_3
 3740:           
 3741: 
 3742:             // Integral I_5
 3743:             if(!side->isDry) {
 3744: 
 3745:                const double Unbar = dot(side->U, side->n);
 3746:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 3747: 
 3748:             } // I_5
 3749: 
 3750:          } // if is boundary side
 3751: 
 3752:       } // for l
 3753: 
 3754:    } // if isbnd
 3755: 
 3756: 
 3757: }
 3758: 
 3759: 
 3760: 
 3761: extern "C" {
 3762:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 3763:                                   int* indices, int* indptr) {
 3764: 
 3765:       NODE(node);
 3766:       
 3767:       const int idx = node->idx;
 3768:       
 3769:       // Computes the index in the nzz array      
 3770:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 3771: 
 3772: 
 3773:       indptr[idx] = nzzIdx;
 3774:       indices[nzzIdx] = idx;
 3775: 
 3776:       data_d[nzzIdx]    = node->coeffDiag;
 3777: 
 3778:       b_d[idx] = node->qel;
 3779: 
 3780:       for (int k = 0; k < node->numNodes; ++k) {
 3781:          const Node* nb = node->nodes[k];
 3782: 
 3783:          const int j = nb->idx;
 3784: 
 3785:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 3786: 
 3787:          indices[nzzIdx + k + 1] = j;
 3788:       }
 3789: 
 3790:  
 3791:    }
 3792: 
 3793: 
 3794: 
 3795:    __global__ void solverCopyResult(double* x) {
 3796:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 3797:       NODE(node);
 3798:       const int idx = node->idx;
 3799: 
 3800:       node->mX = x[idx];
 3801:    }
 3802: 
 3803: 
 3804:    __global__ void rollUpElevation(void) {
 3805: 
 3806:       NODE(node);
 3807: 
 3808:       node->eta1 = node->eta2;
 3809: 
 3810:    }
 3811: 
 3812: 
 3813:    __global__ void backtrackAllNodes(void) {
 3814: 
 3815:       // max/min # of sub-divisions
 3816:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 3817:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 3818: 
 3819: 
 3820:       SIDE(side);
 3821: 
 3822:       const int kb = side->kb;
 3823: 
 3824: 
 3825:       // Initialize btrack velocities to the actual velocities at the side 
 3826:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 3827: 
 3828:   
 3829: 
 3830:       if (side->isDry) return;
 3831:       
 3832: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 3833: 
 3834:       // Checks that at least one element is not dry
 3835:       const Element *elem1 = side->elems[0];
 3836:       const Element *elem2 = side->elems[1];
 3837: 
 3838: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 3839: 
 3840:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 3841:       
 3842:       // XXXXXX
 3843:       // !swild_tmp to store global coord. of the starting side
 3844:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 3845:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 3846:       // !Use sframe2 
 3847:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 3848: 
 3849: 
 3850:       for (int k = kb; k < nvrt; k++) {
 3851:       //  Initialize (xt,yt,zt), nnel and vel.
 3852:       //  For ics=2, the coordinates are in local frames
 3853:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 3854: 
 3855: 
 3856:          const int iadvf = side->iadv();  // Advection flag   
 3857:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 3858: 
 3859:          Point3 xt;
 3860:          if constexpr(ics==1) {
 3861:             xt = side->center3D(k); 
 3862:          }
 3863:          else // lat/lon; in side lat/lon frame
 3864:          {
 3865:             assert(false && "lat/lon not implemented in backtrackAllNodes");
 3866:          // XXX IMPLEMENT THIS
 3867:       //          xt=0.d0
 3868:       //          yt=0.d0
 3869:       //          !centroid coord. for nudging
 3870:       //          call project_pt('g2l',xctr(ie0),yctr(ie0),zctr(ie0), &
 3871:       //   &(/xcj(isd0),ycj(isd0),zcj(isd0)/),swild10_tmp,xctr2,yctr2,tmp)
 3872:          }  // ics
 3873: 
 3874: 
 3875: 
 3876:          // If on land or open boundary...
 3877:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 3878:          
 3879:          const double vmag = length(side->u2[k]);
 3880: 
 3881:          if (vmag <= velmin_btrack) {
 3882:             // No activity 
 3883: 
 3884:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 3885: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 3886: 
 3887: 
 3888:             
 3889:          } else {  // do btrack
 3890: 
 3891:             // Compute number of sub-divisions based on local gradients of the velocity field
 3892: 
 3893:             // XXX IS THIS NECESSARY?
 3894:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 3895:             double suma = 0.0;
 3896:             int icount = 0;
 3897:             for (int l=0; l<2; l++) {
 3898:             // For each element sharing the side...
 3899: 
 3900:                const Element *elem = side->elems[l];
 3901:                  
 3902:                if (elem == nullptr) continue;
 3903: 
 3904:                icount++;
 3905: 
 3906:                // Not strictly along z; in ll frame for ics=2
 3907: 
 3908:                double utmp[4];
 3909:                double vtmp[4];
 3910:                for (int j = 0; j < elem->i34; j++) {
 3911: 
 3912:                   const Node *node = elem->nodes[j];
 3913: 
 3914:                   if constexpr(ics==1) {
 3915:                      utmp[j] = node->u2[k].x;
 3916:                      vtmp[j] = node->u2[k].y;  
 3917:                   } else {
 3918:                      assert(false && "lat/lon not implemented in backtrackAllNodes");
 3919:                      // call project_hvec(uu2(j,nd0),vv2(j,nd0),pframe(:,:,nd0),eframe(:,:,ie),utmp0(j),vtmp0(j))
 3920:                   }
 3921:                } // for j
 3922: 
 3923:                const Vector2 grad_u = elem->grad2(utmp); 
 3924:                const Vector2 grad_v = elem->grad2(vtmp);
 3925: 
 3926:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 3927:             } // for ii
 3928: 
 3929:             assert(icount > 0 && "Impossible 77");
 3930: 
 3931:             // '4' is somewhat arbitrary
 3932:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 3933: 
 3934:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 3935: 
 3936:             Vector3 u_int = {0.0, 0.0, 0.0};
 3937: 
 3938:             bool res =side->btrack(k, dt, dtbk, u_int);
 3939: 
 3940:             side->btu[k] = toVector2(u_int);
 3941:                
 3942:          } // if vmag (do backtrack)
 3943: 
 3944: 
 3945:       } // for k=kb,nvrt-1
 3946: 
 3947:    }
 3948: 
 3949: } // extern "C"
 3950: 
 3951: template<int nc>
 3952: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 3953: 
 3954: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 3955: //
 3956: // a,b,c,rhs: input vectors and are not modified by this program.
 3957: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 3958: // rhs is the r.h.s.
 3959: // n: actual rank of the system.
 3960: // rows in u() and rhs();
 3961: // u: output with nc columns (transposed to rows)
 3962: // gam: a working array.
 3963: //
 3964: // NOTES:
 3965: // This is a template function that allows for different numbers of columns in the rhs vector.
 3966: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 3967: 
 3968:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 3969:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 3970: 
 3971:    double bet = b[0];
 3972:    if constexpr (nc == 1) {
 3973:       u[0] = rhs[0]/bet;
 3974:    } else {
 3975:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 3976:    }
 3977: 
 3978:    for (int j = 1; j < n; j++) {
 3979:       gam[j] = c[j - 1]/bet;
 3980:       bet = b[j] - a[j]*gam[j];
 3981: 
 3982:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 3983: 
 3984:       if constexpr (nc == 1) {
 3985:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 3986:       } else {
 3987:          for (int l = 0; l < nc; l++) {
 3988:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 3989:          }
 3990:       }
 3991:    }
 3992: 
 3993:    // Back-substitution
 3994:    for (int j = n - 2; j >= 0; j--) {
 3995:       if constexpr (nc == 1) {
 3996:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 3997:       } else {
 3998:          for (int l = 0; l < nc; l++) {
 3999:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4000:          }
 4001:       }
 4002:    }
 4003: }
 4004: 
 4005: 
 4006: 
 4007: // Helper function that contains the core algorithm
 4008: template<typename XAccessor, typename YAccessor>
 4009: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4010:                                     double  yp_top, double  yp_bot, 
 4011:                                     CubicSpline &spline) {
 4012:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4013:    // 
 4014:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4015:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4016:    //
 4017:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4018:    // 
 4019:    // Inputs: 
 4020:    //            n: dimension for x etc; # of data pts (>=2);
 4021:    //            getX, getY: functions to access x,y coordinates
 4022:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4023:    //     Output: 
 4024:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4025: 
 4026:    const int n = k2 - k1 + 1;
 4027:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4028: 
 4029:    // Allocate memory for the splines
 4030:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4031:    spline.x   = new double[n];
 4032:    spline.y   = new double[n];
 4033:    spline.yp  = new double[n];
 4034:    spline.ypp = new double[n];
 4035: 
 4036:    for (int k=k1; k<=k2; k++) {
 4037:       spline.x[k] = getX(k);
 4038:       spline.y[k] = getY(k);
 4039:    }
 4040: 
 4041:    // This is to simplify expressions later
 4042:    double *x = spline.x;
 4043:    double *y = spline.y;
 4044: 
 4045:    double *a = nullptr;
 4046:    double *b = nullptr;
 4047:    double *c = nullptr;
 4048:    double *gam = nullptr;
 4049:    double *rhs = nullptr;
 4050:    
 4051: 
 4052:       a = new double[n];   // Lower diagonal
 4053:       b = new double[n];   // Diagonal
 4054:       c = new double[n];   // Upper diagonal
 4055:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4056:       rhs = new double[n]; // Right-hand side
 4057: 
 4058:    for (int k=k1; k<=k2; k++) {
 4059:       if (k == k1) {
 4060:          // Bottom level
 4061:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4062:          b[k] = (x[k+1] - x[k])/3.0;
 4063:          c[k] = b[k]/2.0;
 4064:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4065:       } else if (k == n - 1) {
 4066:          // Top level (surface)
 4067:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4068:          b[k] = (x[k] - x[k-1])/3.0;
 4069:          a[k] = b[k]/2.0;
 4070:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4071:       } else {
 4072:          // Intermediate levels
 4073:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4074:          b[k] = (x[k+1] - x[k-1])/3.0;
 4075:          a[k] = (x[k  ] - x[k-1])/6.0;
 4076:          c[k] = (x[k+1] - x[k  ])/6.0;
 4077:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4078:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4079:       }
 4080:    }
 4081: 
 4082:    // Solve the tridiagonal system
 4083:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4084:    
 4085:    spline.yp[k1] = yp_bot;
 4086:    spline.yp[k2] = yp_top;
 4087: 
 4088:    // Compute rest of 1st derivatives using the splines
 4089:    for (int k=k1+1; k<k2; k++) {
 4090:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4091:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4092:    }
 4093:    
 4094:    delete[] a;
 4095:    delete[] b;
 4096:    delete[] c;
 4097:    delete[] gam;
 4098:    delete[] rhs;
 4099: 
 4100: }
 4101: 
 4102: // Array version
 4103: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4104:                                 double y_top, double y_bot, 
 4105:                                 CubicSpline &spline) {
 4106:    auto getX = [x] (int k) { return x[k]; };
 4107:    auto getY = [y] (int k) { return y[k]; };
 4108:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4109: }
 4110: 
 4111: // Lambda version - allows custom access patterns
 4112: template<typename XFunc, typename YFunc>
 4113: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4114:                                 double y_top, double y_bot,
 4115:                                 CubicSpline &spline) {
 4116:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4117: }
 4118: 
 4119: 
 4120: __device__ double evalCubicSpline(CubicSpline spline, double z, bool extrapolate = false)
 4121: {
 4122:    assert("Not implemented");
 4123: 
 4124:    return 0.0;
 4125: }
