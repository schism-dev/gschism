 2582: /**
 2583:  * This method performs backtracking from the side center until a time -dt back in time 
 2584:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2585:  * intermediate point.
 2586:  *
 2587:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2588:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2589:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2590:  * remaining time.
 2591:  * 
 2592:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2593:  * 
 2594:  * @param uuint, vvint, wwint: Velocities at the final point
 2595:  * @param jlev: Level at which the backtracking is performed
 2596:  * @param dt, dtbk: Tracking timesteps
 2597:  * @return: True if the backtracking was successful, false otherwise
 2598:  */
 2599: __inline__ __device__ bool Side::btrack(
 2600:       int jlev,
 2601:       double dt,            // Tracking time
 2602:       double dtbk,          // Tracking timestep
 2603:       Vector3 &u_int        // Velocities at the initial point
 2604: ) const {
 2605: 
 2606:    // Start from side center
 2607:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2608: 
 2609:  
 2610:    double time_rm = dt; // Remaining time
 2611: 
 2612: 
 2613:    // // Initialize outputs XXX
 2614:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2615:    //    sclr[i] = 0.0;
 2616:    // }
 2617: 
 2618: 
 2619:    // Initial velocities
 2620:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->w2[jlev] + n2->w2[jlev])};
 2621: 
 2622:    // Find the element that is in the direction opposite to the velocity
 2623:    Element* curElem = findElementTowards(toVector2(u_int));
 2624: 
 2625: 
 2626:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2627:    if (curElem == nullptr) {
 2628:       // Make velocity parallel to the side
 2629:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2630:       // u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2631:       curElem = otherElem(curElem);
 2632:       
 2633:    }
 2634: 
 2635: // Nudges it towards the circumcenter
 2636: // printf("0{{jlev = %d}} side->idx = %d, x0 = %.15e,%.15e,%.15e\n", jlev, idx, x0.x, x0.y, x0.z);
 2637: Vector2 xcirc = {(curElem->nodes[0]->p.x + curElem->nodes[1]->p.x + curElem->nodes[2]->p.x)/3.0,
 2638:                  (curElem->nodes[0]->p.y + curElem->nodes[1]->p.y + curElem->nodes[2]->p.y)/3.0};
 2639: const double eps = 9.013e-3;                 
 2640: x0.x = xcirc.x*eps + (1 - eps)*x0.x;
 2641: x0.y = xcirc.y*eps + (1 - eps)*x0.y;
 2642: 
 2643: 
 2644: 
 2645:    const int MAX_ITERATIONS = 1000; 
 2646:    Element* nextElem = curElem;
 2647:    int iter = 0;
 2648:    while(true) {
 2649: 
 2650:       // Calculate timestep
 2651:       double dtb = min(dtbk, time_rm);
 2652: 
 2653:       // Next point in the backtracking curve
 2654:       Point3 xt = x0 - dtb*u_int;
 2655:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2656:       assert(found && "Backtracking failed in btrack");
 2657: 
 2658:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2659: 
 2660:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2661:                       // then time_rm needs to be increased by the unused time.
 2662: 
 2663:       // If the velocity is too small, we stop the backtracking
 2664:       const double vmag = length(toVector2(u_int));
 2665:       if (vmag <= velmin_btrack) break;
 2666: 
 2667:       // The current point becomes the next segment's starting point.
 2668:       x0 = xt;
 2669:  
 2670:       curElem = nextElem;
 2671: 
 2672:       iter++;
 2673:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2674:    }
 2675: 
 2676: 
 2677: }
 2678: 
 2679: 
 2680: 
 2681: // /**
 2682: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2683: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2684: 
 2685: //    Inputs:
 2686: //    @param x1, y1: point inside the element
 2687: //    @param x2, y2: other end of the line segment
 2688: 
 2689: //    Outputs:
 2690: //    @param intersectingSide:  side that intersects the line segment
 2691: //    @param nextElement: element that contains the intersection point
 2692: //    @param xIntersect, yIntersect: intersection point  
 2693: 
 2694: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2695: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2696: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 2697: 
