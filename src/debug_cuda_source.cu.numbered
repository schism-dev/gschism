 1779: // Helper functions for computing the local node index at a given offset from another.
 1780: __device__ __inline__ int nxq(int offset, int index, int size) {
 1781:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1782:    // to the index to make it positive
 1783:    assert(index + offset + 16*size >= 0);
 1784:    return (index + offset + 16*size) % size;  
 1785: }
 1786: 
 1787: __device__ __inline__ int nxq(int index, int size) {
 1788:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1789:    // to the index to make it positive
 1790:    assert(index + 16*size >= 0);
 1791:    return (index + 16*size) % size; 
 1792: }
