 5101: extern "C" {
 5102: 
 5103:    __global__ void scaleGravity(double loadtide_coef) {
 5104: 
 5105: 
 5106:       NODE(node);
 5107: 
 5108:       // SAL option: scale gravity
 5109:       if constexpr(iloadtide==2) {  // simple const
 5110:          node->grav2 = grav*(1.0 - loadtide_coef);
 5111: 
 5112:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 5113:         
 5114:           const double depth = max(node->depth, 0.0);
 5115:           const double tmp1 = sqrt(depth);
 5116:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 5117:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 5118:                              2.6969e-13*depth*depth*depth*tmp1;
 5119:           
 5120:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 5121:           
 5122: 
 5123: 
 5124:           node->grav2 = grav*(1.0 - beta_bar);
 5125: 
 5126:       } else {  // iloadtide=0,1
 5127:           node->grav2 = grav;
 5128: 
 5129:       }
 5130: 
 5131:    }
 5132: 
 5133: 
 5134:    __global__ void setWinds(double *xWind, double *yWind, double *pressAir) {
 5135:       NODE(node);
 5136: 
 5137:       const int idx = node->idx;
 5138:       Vector2 wind = {xWind[idx], yWind[idx]};
 5139: 
 5140:       if constexpr(nws != 0 && iwindoff != 0) {
 5141:          assert(false && "setWinds: windfactor not implemented (nws != 0 && iwindoff != 0)");
 5142:       }
 5143: 
 5144:       // Sets the wind speed (rotated to the mesh angle) and surface stress vector due to wind.
 5145:       node->setWind(wind);
 5146: 
 5147:       node->pr = pressAir[idx];
 5148:       node->p_air = pressAir[idx]; // XXXXXX is this the same as pr?
 5149: 
 5150:    }
