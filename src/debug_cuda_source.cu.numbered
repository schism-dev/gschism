 4781:    __global__ void computeVerticallyIntegratedVelocity(void) {
 4782: 
 4783:       SIDE(side);
 4784: 
 4785: 
 4786:       side->U = {0.0, 0.0}; 
 4787:          
 4788:       if(side->isDry) return;
 4789: 
 4790:       const Node *node1 = side->n1;
 4791:       const Node *node2 = side->n2;
 4792: 
 4793:       // Vertically integrated velocity U (in ll if ics=2)
 4794:       for (int k = side->kb; k < nvrt - 1; k++) { 
 4795:          side->U += side->Dz(k + 1)*0.5*(side->u2[k] + side->u2[k + 1]);  
 4796:       }
 4797: 
 4798:    }
 4799: 
 4800:    __global__ void computeBottomDragVegetation(void) {
 4801:       // UNFINISHED. CHECK THIS:
 4802:       // How many kernels are needed? Why so many for loops?
 4803:       // Is the loop on sides needed?
 4804: 
 4805:       NODE(node);
 4806: 
 4807: 
 4808:       const int    kb      = node->kb;
 4809:       const double htot    = node->htot2(); 
 4810:       
 4811:       if (node->isDry) {
 4812:          // Default values for dry nodes
 4813:          node->veg_alpha_vert_mean = node->veg_alpha0;
 4814:          if constexpr(iveg != 0) for (int k = kb; k < nvrt; k++) node->veg_alpha3D[k] = node->veg_alpha0;
 4815: 
 4816:          return;
 4817:        
 4818:       }
 4819: 
 4820:       // Computes bottom drag Cd based on the selected nchi
 4821:       node->computeBottomDragCd();
 4822:       
 4823: 
 4824: 
 4825:       //   Bottom stress in m^2/s^2
 4826:       if (node->rho[kb + 1] >= -98.0)
 4827:       {
 4828:          const double mag_u = length(node->u2[kb + 1]);
 4829:          node->tau_bot = node->rho[kb + 1]*node->Cd*mag_u*node->u2[kb + 1]; // units: kg/m/s^2 (Pa)
 4830: 
 4831:          // XXX In the original code there is an additional component of tau_bot, used in icm_sfm.F90 with this comment:
 4832:          // !sediment erosion: this part needs more documentation
 4833:       }
 4834:     
 4835: 
 4836: 
 4837:       // Compute vegetation parameters
 4838:       //--------------------------------
 4839: 
 4840:       // SAV constants
 4841:       constexpr double veg_cfk   = 0.07; //Shimizu & Tsujimoto (1994)
 4842:       constexpr double veg_cfpsi = 0.16;
 4843: 
 4844:       // Add vertical variation to veg_alpha and compute vertical mean etc.
 4845:       if constexpr(iveg == 1) { //  Vertical variation specified by functions
 4846: 
 4847:          // Compute the vegetation "density" \alpha = D*N*Cd/2
 4848:          // D, N and Cd are given as piecewise linear functions: veg_vert_scale_cd, veg_vert_scale_N, veg_vert_scale_D
 4849:          int kbin = 0; // bin index
 4850:          for (int k = kb; k < nvrt; k++) {
 4851:             // Computes node height above the bottom level
 4852:             const double tmp_h = node->z[k] - node->z[kb]; // >=0
 4853:             assert(false && "Vertical variation of vegetation not implemented");
 4854: 
 4855:             // if (tmp_h >= veg_vert_z[nbins_veg_vert]) {
 4856:             //    cff1 = veg_vert_scale_cd[nbins_veg_vert];
 4857:             //    cff2 = veg_vert_scale_N [nbins_veg_vert];
 4858:             //    cff3 = veg_vert_scale_D [nbins_veg_vert];
 4859:             // } else {
 4860:             //    // Find the bin at which the current vertical level is
 4861:             //    while (kbin<nbins_veg_vert) {
 4862:             //       const double zn = node->z[kbin];
 4863:             //       if (tmp_h >= veg_vert_z[kbin] && tmp_h <= veg_vert_z[kbin+1]) {
 4864:             //          break;
 4865:             //       } // if
 4866:             //       kbin++;
 4867:             //    } // while
 4868:             //    assert (kbin < nbins_veg_vert && "computeBottomDragVegetation: veg vert failed");
 4869: 
 4870:             //    // for linear interpolation, compute the ratio of the height above the bottom level to the bin width
 4871:             //    const double zrat = (tmp_h - veg_vert_z[kbin])/(veg_vert_z[kbin+1] - veg_vert_z[kbin]);
 4872:                
 4873:             //    // Linear interpolation of the vegetation parameters
 4874:             //    cff1 = veg_vert_scale_cd[kbin]*(1.0 - zrat) + veg_vert_scale_cd[kbin+1]*zrat;
 4875:             //    cff2 = veg_vert_scale_N [kbin]*(1.0 - zrat) + veg_vert_scale_N [kbin+1]*zrat;
 4876:             //    cff3 = veg_vert_scale_D [kbin]*(1.0 - zrat) + veg_vert_scale_D [kbin+1]*zrat;
 4877:             // } // if rl10
 4878: 
 4879:             // node->veg_alpha3D[k] = node->veg_alpha0*cff1*cff2*cff3;
 4880: 
 4881:          } // for k
 4882: 
 4883: 
 4884:       } else { // Ganthy (iveg==2)
 4885:       //  Modify canopy height, diameter, and density
 4886: 
 4887:          // Make sure there is vegetation on this node
 4888:          if (node->veg_h_unbent > 0.0) {
 4889:             const double wtmp2 = length(node->dav)*100.0; // cm/s
 4890: 
 4891:             node->veg_h = 0.72e-2*(4.657 - 0.158*wtmp2 + 0.262*veg_lai - 0.011*veg_lai*wtmp2 + 
 4892:                                    0.0022*wtmp2*wtmp2 + 0.048*veg_lai*veg_lai) - 0.00784;
 4893:             node->veg_h = max(node->veg_h, 1.0e-2);  //impose min of 1 cm
 4894: 
 4895:             const double phi_b = veg_cw*node->veg_di_unbent*node->veg_h_unbent/node->veg_h; // \phi_b
 4896:             node->veg_di = (node->veg_di_unbent + phi_b)*0.5;
 4897:             const double surpHeight = max(0.0, node->veg_h_unbent - node->veg_h); //surplus height
 4898:             node->veg_nv = node->veg_nv_unbent*(1.0 + surpHeight/node->veg_h);
 4899:          } // if veg_h_unbent
 4900: 
 4901:          for (int k = 0; k < nvrt; k++) {
 4902:             node->veg_alpha3D[k] = 0.5*node->veg_di*node->veg_nv*node->veg_Cd;
 4903:          } // for k
 4904:       
 4905: 
 4906:       } // if iveg
 4907:      
 4908: 
 4909:       // Compute vertical mean of veg_alpha3D
 4910:       if (iveg != 0) {
 4911:          const double ztop = node->zTopCanopy(); // Top of the canopy
 4912:          double sum1=0.0;
 4913:          double sum2=0.0;
 4914:          // Integrate over each level under the canopy...
 4915:          for (int k = kb; (k < nvrt - 1) || (node->z[k + 1] <= ztop); k++) { /// XXX CHECK INDICES
 4916:             const double Dz = node->Dz(k);
 4917: 
 4918:             sum1 += 0.5*(node->veg_alpha3D[k] + node->veg_alpha3D[k + 1])*Dz;
 4919:             sum2 += Dz;
 4920: 
 4921:          } // for k
 4922:          if (sum2 == 0.0) node->veg_alpha_vert_mean = node->veg_alpha3D[kb];
 4923:          else             node->veg_alpha_vert_mean = sum1/sum2;
 4924: 
 4925:       } // if iveg
 4926: 
 4927:    }
 4928: 
 4929:    __global__ void computeVegetationAndDragParameters(void) {
 4930:       // Computes the vegetation and drag model parameters:
 4931:       // chi, \tilde\chi, beta, \breve{H}
 4932:       
 4933:       SIDE(side);
 4934: 
 4935:       if (side->isDry) return;
 4936: 
 4937:       const double htot = side->htot2();
 4938:       const int    kb   = side->kb;
 4939: 
 4940:       assert(htot > 0.0 && "computeVegetationModelParameters: htot <= 0");
 4941: 
 4942:       const double veg_h     = side->veg_h();
 4943:       const double veg_nv    = side->veg_nv();
 4944:       const double veg_c     = side->veg_c();
 4945:       const double veg_beta  = side->veg_beta;
 4946:       const double veg_alpha = side->veg_alpha_vert_mean();
 4947: 
 4948:       // Compute the drag coefficients chi2 and chi (\tilde\chi in notes) // XXX change names, chi->chitilde, chi2->chi
 4949:       // Velocity magnitude at the bottom level
 4950:       // XXXX Check if we have added -dt*(bcc(1,k,n1)+bcc(1,k,n2))/2.d0-dt*swild2(k,1) to u2.
 4951:       const double vmag1 = length(side->btu[kb + 1]); //BACKTRACKED VELOCITY
 4952:       side->chi2 = side->Cd()*vmag1;
 4953:       side->chi  = side->chi2;
 4954:       if constexpr(iveg != 0) {
 4955:          const Node *n1 = side->n1;
 4956:          const Node *n2 = side->n2;
 4957:          const double veg_alpha_bot = 0.5*(n1->veg_alpha3D[n1->kb] + n2->veg_alpha3D[n2->kb]);
 4958:          side->chi = side->chi/(1.0 + veg_alpha_bot*vmag1*dt);
 4959:       }
 4960: 
 4961:       // Calc consts in SAV model; make sure veg_[c2,beta]=0 at 2D, dry side, and emergent side
 4962: 
 4963:       // Compute the vertically averaged velocity magnitude Ua up to the top of the canopy.
 4964:       // \int_{-h}^{z_v} |u|dz / H^\alpha = \bar{|u|}^\alpha
 4965:       double magUa = 0.0;
 4966:       if (iveg != 0 && side->is3D() && veg_h > 0.0) {
 4967:          // 3D wet side with veg...
 4968: 
 4969:          double magUa = 0.0;
 4970:          for (int k = kb; k < nvrt - 1; k++) { // XXX CHECK INDICES
 4971:             if (side->hasVegetation(k + 1)) { //partial or full SAV layer
 4972: 
 4973:                // Velocity magnitude must be computed at the center of each level to perform the integration.
 4974:                // The tricky part is to compute that velocity at the level that may be partially submerged.
 4975:                const double zrat = side->zLevelVegRatio(k + 1); // in (0,1]
 4976: 
 4977:                // Velocity magnitude at the top (h) of the level (may be partially submerged)
 4978:                const double uh = length((1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1]);
 4979: 
 4980:                // Velocity magnitude at the bottom (l) of the level
 4981:                const double ul = length(side->u2[k]);
 4982: 
 4983:                const double Dz = zrat*side->Dz(k);  // Takes into account the partially submerged level
 4984:                magUa += Dz*0.5*(uh + ul);
 4985: 
 4986:             } // if HasVegetation
 4987:          } // for k
 4988:          const double ua = magUa/min(htot, veg_h); // Vertical average
 4989: 
 4990:          // Computes beta, used for computing the stress term at the top of the canopy.      
 4991:          side->veg_c2 = veg_alpha*dt*ua; // >=0
 4992:          if (side->isSubmerged()) { // 3D wet submergent side with vegetation
 4993:             const double zCpy = side->zTopCanopy();
 4994:             const double I = max(1.0e-5, side->chi2*vmag1/(grav*htot)); // Energy gradient
 4995:             const double Dz_veg = veg_h - side->Dz(kb + 1); // Distance from the top of the canopy to the top of the bottom level (equal to side->topOfCanopy() - side->zc[kb + 1])
 4996:             const double beta2 = sqrt(sqrt(veg_nv)/veg_h)*(-0.32 - 0.85*log10((htot - veg_h)/veg_h*I));
 4997:             const double beta = exp(beta2*Dz_veg) - 1.0; /// XXX CHECK INDICES
 4998:             side->veg_beta = max(0.0, min(10.0, beta));  // Clamp to [0,10]
 4999:          } // if isSubmerged
 5000:       } // if iveg   
 5001: 
 5002:       // Computes the friction modified depth, \breve{H} in notes
 5003:       if (side->is2D()) { // 2D
 5004: 
 5005:          double fricH = htot + side->chi2*dt; // Depth enhanced by the bottom friction and form drag, \tilde{H} in notes
 5006:          if constexpr(iveg != 0) fricH += veg_alpha*vmag1*htot*dt;
 5007: 
 5008:          assert(fricH > 0.0 && "COMPUTE CONTINUITY EQUATION: Impossible dry 53");
 5009: 
 5010:          side->hhat = htot*htot/fricH; 
 5011: 
 5012:       } else { // 3D
 5013:          side->hhat = htot - side->chi*dt; // Friction modified depth, \hat{H} in notes
 5014: 
 5015:          if constexpr(iveg != 0) {
 5016:             
 5017:             if (side->isSubmerged()) { 
 5018:                const double Hhat_alpha = veg_h + veg_beta*side->chi*dt; 
 5019:                side->hhat -= veg_c*Hhat_alpha;
 5020: 
 5021:             } else { // Emergent
 5022:                side->hhat = side->hhat/(1.0 + side->veg_c2); // veg_c2 = alpha*|u|*dt
 5023:             }
 5024:          } // if iveg
 5025: 
 5026:          // Enforce positivity for 3D model
 5027:          if (ihhat == 1) side->hhat = max(0.0, side->hhat);
 5028:       } // if 3D
 5029: 
 5030:    }
 5031: 
 5032: 
 5033: 
 5034:    __global__ void getRhoDiffAndVec(const Element *e1, const Element *e2, const int j, const int k, const double rho2, Vector2 &vec, double &diffRho) {
 5035:    // Computes the density gradient between two elements, e1 and e2.
 5036:    // If the neighbor element (e2doesn't exist (boundary or dry element), the density gradient is assumed to be
 5037:    // zero in the direction normal to the side. 
 5038:    // 
 5039:    // NOTE: In fact it doesn't compute the gradient, but the difference in de-meaned density between e1 and e2 and
 5040:    // the vector from e1 to e2 (or normal to side if neighbor is dry or not present
 5041:    //
 5042:    // Input:
 5043:    //    e1: Element
 5044:    //    e2: Neighbor element (or nullptr if boundary)
 5045:    //    j: Index of the neighbor element (and the side of e1 that is shared with e2)
 5046:    //    k: Index of the half-level at which the density is interpolated
 5047:    //    rho2: De-meaned density at e2 interpolated at the k-th half-level of e1 (or zero if neighbor is dry or not present)
 5048:    // 
 5049:    // Output:
 5050:    //    vec: Vector from e1 to e2 (or normal to side if neighbor is dry or not present)
 5051:    //    diffRho: Difference in de-meaned density between e1 and e2 (or zero if neighbor is dry or not present)
 5052: 
 5053:       if (e2 == nullptr || e2->isDry) {
 5054:          // Neighbor doesn't exist or is dry, we assume the density gradient is zero in the direction normal to the side.
 5055: 
 5056:          Side *side = e1->sides[j];
 5057:          assert((side->otherElem(e1) == nullptr || side->otherElem(e1)->isDry) && "getRhoDiffAndVec: For boundary elements, side->otherElem(elem) must be nullptr or dry");
 5058:                  
 5059:          if constexpr(ics == 1) {
 5060:             vec = side->n; // Normal vector to the side
 5061:          } else {
 5062:             // IMPLEMENT THIS XXXXXX
 5063:             // !replace with xel, yel?
 5064:             //                   call project_pt('g2l',xnd(n1),ynd(n1),znd(n1),(/xctr(i),yctr(i),zctr(i)/), &
 5065:             //      &eframe(:,:,i),xn1,yn1,tmp)
 5066:             //                   call project_pt('g2l',xnd(n2),ynd(n2),znd(n2),(/xctr(i),yctr(i),zctr(i)/), &
 5067:             //      &eframe(:,:,i),xn2,yn2,tmp)
 5068:          } //ics
 5069:                    
 5070:          diffRho = 0.0;
 5071: 
 5072:       } else { //internal and wet
 5073:          if constexpr(ics==1) {
 5074:             assert(e2 != nullptr || e2->isDry && "getRhoDiffAndVec: neighbor element is nullptr or dry");
 5075: 
 5076:             // Vector from e1 to e2
 5077:             vec = e2->center - e1->center;
 5078: 
 5079:          } else { 
 5080:             // IMPLEMENT THIS XXXXXX
 5081:             //                   call project_pt('g2l',xctr(ie),yctr(ie),zctr(ie),(/xctr(i),yctr(i),zctr(i)/), &
 5082:             //      &eframe(:,:,i),xctr2,yctr2,tmp)
 5083:             //                   alow(j)=xctr2
 5084:             //                   bdia(j)=yctr2
 5085:          } // ics
 5086: 
 5087:          diffRho = rho2 - e1->demeanedDensity(k);
 5088:       }
 5089: 
 5090:    }
 5091: 
 5092:    __global__ void computeDensityCubicSplines(void) {
 5093:       // Computes cubic splines of de-meaned density (rho - rho_mean) for all elements
 5094: 
 5095:       ELEM(elem);
 5096: 
 5097:       if (elem->isDry) return;
 5098: 
 5099:       const int kb = elem->kb;
 5100: 
 5101:       // Computes the cubic splines of de-meaned density (rho - rho_mean) for all elements
 5102:       if (elem->is2D()) {
 5103:          // In the 2D case, the density is constant at the prism level. 
 5104:          // In this case, rho_z doesn't contain the z derivatives, but the actual de-meaned density value.
 5105:          elem->rho_z[nvrt-1] = elem->demeanedDensity(nvrt-1);
 5106:       } else { //3D
 5107: 
 5108:          // Lambda functions to access the function x,y points (x = z at element prism and y = de-meaned density)
 5109:          auto getX = [elem] (int k) { return elem->z_prism(k); };
 5110:          auto getY = [elem] (int k) { return elem->demeanedDensity(k); };
 5111:          ///// XXXX CHECK INDICES!!!!!
 5112:          initCubicSpline(kb, nvrt, getX, getY, 0.0, 0.0, elem->rho_spl);
 5113:       } // 2D/3D
 5114: 
 5115:    }
 5116: } // extern "C"
 5117: 
 5118: 
 5119: __device__ double interpolateDensityAtHalfLevel(const Element *elem, const Element *elem2, int k) {
 5120: // Interpolates the de-meaned density of elem2 at the same z coordinate as the k half-level of elem.
 5121: 
 5122:    if (elem2 == nullptr || elem2->isDry) return 0.0;
 5123: 
 5124:    const int kb  = elem->kb;
 5125:    const int kb2 = elem2->kb;
 5126: 
 5127:    // z-coordinate of prism of elem
 5128:    const double zp = elem->z_prism(k);
 5129: 
 5130:    double rho = 0.0;
 5131: 
 5132:    if (elem2->is2D()) {
 5133:       return elem->rho_z[nvrt - 1]; // Remember that we stored the de-meaned density in rho_z for the 2D case.
 5134: 
 5135:    } else {  // 3D
 5136: 
 5137:       // eta_min may be < zmax
 5138:       const double eta_min = min(elem->z[nvrt - 1], elem2->z[nvrt - 1]);
 5139:       const double zmax    = max(elem->z[kb   + 1], elem2->z[kb   + 1]);
 5140: 
 5141:       // (Extrapolate density below bottom, we will fix it later)
 5142:       // NOTE: interpolate densities at elem2 at coordinates from elem.
 5143:       rho = evalCubicSpline(elem->rho_spl, zp, true);
 5144:       // evalCubicSpline(nvrt-kbe(ie),swild2(kbe(ie)+1:nvrt,12), &
 5145:       //      &erho(kbe(ie)+1:nvrt,ie)-rho_mean(kbe(ie)+1:nvrt,ie), &
 5146:       //      &hp_int(kbe(ie)+1:nvrt,ie,1),nvrt-kbe(i),swild(kbe(i)+1:nvrt),ibot_fl,zmax,eta_min,swild2(kbe(i)+1:nvrt,j))
 5147:    } // 2D/3D
 5148:      
 5149: 
 5150:    // For the case where the elem is deeper than elem2, we extrapolated the density in evalCubicSpline.
 5151:    // Now we need to fix it.
 5152:    if (elem->z[k] < elem2->z[kb2]) {
 5153:       // We are at a z level that doesn't exist at elem2, so we need to adjust the density 
 5154: 
 5155:       // There are two methods to adjust the density at the bottom of the element.
 5156:       // iunder_deep=0: 
 5157:       const double depth1 = abs(elem->z[kb]); // larger depth
 5158: 
 5159:       if (iunder_deep==0) {
 5160: 
 5161:          const double weight = clamp((depth1 - h1_bcc)/(h2_bcc - h1_bcc), 0.0, 1.0); // weight
 5162: 
 5163:          rho = (1.0 - weight)*rho + weight*elem->demeanedDensity(k);
 5164: 
 5165:       } else { // iunder_deep != 0
 5166: 
 5167:          const double diffDepth = abs(elem->z[kb] - elem2->z[kb2]); // Change??? XXX Was like this in the original code
 5168: 
 5169:          if (depth1 >= hw_depth && diffDepth >= hw_ratio*depth1) {
 5170: 
 5171:          //   Demeaned density at the same z coordinate as
 5172:                rho = elem->demeanedDensity(k); // would make cupp() below=0
 5173:          }
 5174: 
 5175:       } // if iunder_deep
 5176:    } // if elem->z[kb] < elem2->z[kb]
 5177: 
 5178:    return rho;
 5179: }
 5180: 
 5181: 
 5182: extern "C" {
 5183:    __global__ void computeDensityGradient(void) {
 5184: 
 5185:       if constexpr(ibc != 0) return;
 5186: 
 5187:          // Compute the horizontal density gradient at each element.
 5188:       // It works in two steps:
 5189:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5190:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5191:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5192:       //             gradRho.r1 = rho1 - rho0
 5193:       //             gradRho.r2 = rho2 - rho0
 5194:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5195:       // 
 5196:       //  NOTE: We use de-meaned densities.
 5197: 
 5198:       ELEM(elem);
 5199: 
 5200:       if (elem->isDry) return;
 5201: 
 5202:       const int kb  = elem->kb;
 5203:       const int i34 = elem->i34;
 5204: 
 5205:       for (int k = kb + 1; k < nvrt; k++) {
 5206:          // Computes the density gradient at elem as average of the density gradients computed between elem and pairs of neighboring elements.
 5207:          //             gradRho.r1 = rho1 - rho0
 5208:          //             gradRho.r2 = rho2 - rho0
 5209:          int icount = 0;
 5210:          double sumRx = 0.0;
 5211:          double sumRy = 0.0;
 5212:          for (int j1=0; j1<i34; j1++) { 
 5213: 
 5214:             const int j2 = elem->nxq(j1 + 1);
 5215: 
 5216:             // Pairs of consecutive neighbor elements of elem
 5217:             const Element *e1 = elem->nghbElems[j1];
 5218:             const Element *e2 = elem->nghbElems[j2];
 5219: 
 5220:             // Using cubic splines, interpolate demeaned density difference at the same z half-levels as elem.
 5221:             const double rho1 = interpolateDensityAtHalfLevel(elem, e1, k);
 5222:             const double rho2 = interpolateDensityAtHalfLevel(elem, e2, k);
 5223: 
 5224:             // Compute the density difference and the vector from elem to e1 and e2
 5225:             // getRhoDiffAndVec takes into account boundaries/dry elements
 5226:             double diffRho1, diffRho2;
 5227:             Vector2 vec1, vec2;
 5228:             getRhoDiffAndVec(elem, e1, j1, k, rho1, vec1, diffRho1); // We could remove one of these calls, but it would make the code uglier.
 5229:             getRhoDiffAndVec(elem, e2, j2, k, rho2, vec2, diffRho2);
 5230: 
 5231:             const double rl1 = length(vec1);
 5232:             const double rl2 = length(vec2);
 5233:             assert(rl1 > 0.0 && rl2 > 0.0 && "computeDensityInterpolation: one of rl1 or rl2 is 0");
 5234: 
 5235:             const double delta = cross(vec1, vec2);
 5236:             const double sintheta = abs(delta)/(rl1*rl2);
 5237: 
 5238:             // To avoid problems, avoid elements with small angle between vectors
 5239:             constexpr double sin_one_deg = 0.01745240643728351; // sin(pi/180.0). We use 1 degree as threshold for well-conditioned system
 5240:             const bool validEq = (sintheta > sin_one_deg);
 5241: 
 5242:             if (validEq) {
 5243:                // Solve the system of equations to get the density gradient at elem
 5244:                icount++;
 5245:                const double Rx = (vec2.y*diffRho1 - vec1.y*diffRho2)/delta;
 5246:                const double Ry = (vec1.x*diffRho2 - vec2.x*diffRho1)/delta;
 5247:                sumRx += Rx;
 5248:                sumRy += Ry;
 5249:             }
 5250:          } // for j1
 5251: 
 5252:          // Compute the average density gradient at elem
 5253:          if (icount==0) {
 5254:            // Bad mesh quality; bail out with 0 b-cc
 5255:            elem->gradRho[k] = {0.0, 0.0};
 5256:          } else {
 5257:            elem->gradRho[k] = {sumRx/icount, sumRy/icount};
 5258:          }
 5259: 
 5260:       } // for k
 5261: 
 5262:    }
 5263: 
 5264:    __global__ void computeBaroclinicTerm(void) {
 5265:    // Computes the baroclinic term at sides (at half levels).
 5266:    // For this it has to compute the density gradient at the half-sides (face centers) and then integrate it vertically.
 5267:    // The baroclinic term is -(g/rho_0)*int_z^\eta grad(rho) dz
 5268: 
 5269:       if (ibc == 1) return;
 5270: 
 5271:       SIDE(side);
 5272: 
 5273:       if (side->isDry) return;
 5274: 
 5275:       const Element *e1 = side->elems[0];
 5276:       const Element *e2 = side->elems[1];      
 5277:       const int kb = side->kb;
 5278:       
 5279:       assert(e1 != nullptr || e2 != nullptr && "computeSideDensityGradient: side needs to have at least one element");
 5280: 
 5281:       // interpolates vertically the density gradient of the two elements at the half level/
 5282: 
 5283:       int k1 = max(kb, nvrt / 2);
 5284:       int k2 = max(kb, nvrt / 2);
 5285: 
 5286:       // Starts the integration at the surface and goes down to the bottom
 5287:       side->bcc[nvrt-1] = {0.0, 0.0};
 5288:       for (int k = nvrt - 2; k >= kb; k--) {
 5289:       // For each prism level (from surface to bottom)...
 5290: 
 5291:          // For both elements, interpolate density gradient at the side's half level.
 5292:          // The gradient at the side is the average of the gradients at the elements.
 5293:          // w1, w2 are used to take into account boundary sides, with just one element.
 5294:          double w1 = (e1!=nullptr) ? 1.0 : 0.0;
 5295:          double w2 = (e2!=nullptr) ? 1.0 : 0.0;
 5296:          const double wsum = w1 + w2;
 5297:          w1 = w1/wsum;
 5298:          w2 = w2/wsum;
 5299:          assert(w1 + w2 > 0.99 && w1 + w2 < 1.01 && "computeSideDensityGradient: w1 + w2 is not 1");
 5300: 
 5301:          // Linear interpolation of both elements' density gradient at the shared side's level.
 5302:          Vector2 gradRho = {0.0, 0.0};
 5303:          if (e1 != nullptr && k > kb) {
 5304:             // XXXX WHAT HAPPENS IF k1 < kb??? (check ibelow)
 5305:             
 5306:             k1 = e1->findLevel(side->zc[k], k1); // finds the index at the half level starting the search at k1
 5307:             const double zrat = (side->zc[k] - e1->z[k1])/(e1->z[k1 + 1] - e1->z[k1]);
 5308:             // assert(zrat >= 0.0 && zrat <= 1.0 && "computeSideDensityGradient: zrat is not in [0, 1]");
 5309: printf("###### k1 = %d, side->idx = %d, zc[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, z[%d] = %.16f, zrat = %.16f\n",
 5310:       k1, side->idx, k, side->zc[k], k1, e1->z[k1], k1 + 1, e1->z[k1 + 1], e1->gradRho[k1].x, e1->gradRho[k1].y, zrat);            
 5311:             gradRho += (e1->gradRho[k1]*(1.0 - zrat) + e1->gradRho[k1 + 1]*zrat)*w1;
 5312:          }      
 5313:          if (e2 != nullptr && k > kb) {
 5314:             k2 = e2->findLevel(side->zc[k], k2); // finds the index at the half level starting the search at k2
 5315:             const double zrat = (side->zc[k] - e2->z[k2])/(e2->z[k2 + 1] - e2->z[k2]);
 5316:             
 5317:             gradRho += (e2->gradRho[k2]*(1.0 - zrat) + e2->gradRho[k2 + 1]*zrat)*w2;
 5318:          }
 5319: 
 5320:          if constexpr(ics==2) {
 5321:             assert(false && "Not implemented: ics == 2");
 5322:             // IMPLEMENT THIS XXXXXX
 5323:             // call project_hvec(swild(1),swild(2),eframe(:,:,ie),sframe2(:,:,i),tmp1,tmp2)
 5324:             // swild(1)=tmp1
 5325:             // swild(2)=tmp2
 5326:          }
 5327:          
 5328:          // Integrate (using a central Gauss point) the density gradient from the surface to the bottom 
 5329:          // multiplied by -rampbc*(g/rho0)  (In ll if ics=2)
 5330:          // CHECK INDICES!!! XXX
 5331:          const double grav3 = side->grav3();
 5332:          side->bcc[k] = side->bcc[k + 1] - (rampbc*grav3/rho0)*side->Dz(k + 1)*gradRho;
 5333: 
 5334:       } // for
 5335: 
 5336:    }
 5337: 
 5338: 
 5339: 
 5340:    __global__ void computeHorGradientAtSide(void) {
 5341: 
 5342:       // Compute the horizontal density gradient at each element.
 5343:       // It works in two steps:
 5344:       // 1. Interpolate the density at the neighboring elements at the same zcor as the prism of element i.
 5345:       // 2. Compute the density gradient at elem by averaging the density gradients computed between elem and pairs of neighboring elements.
 5346:       //    To compute one of these gradients (that it later averages), it solves a 2nd rank linear system like:
 5347:       //             gradRho.r1 = rho1 - rho0
 5348:       //             gradRho.r2 = rho2 - rho0
 5349:       //    where r1, r2 are the vectors from the prism center to the neighboring prism centers.
 5350:       // 
 5351:       //  NOTE: We use de-meaned densities.
 5352: 
 5353:       SIDE(side);
 5354: 
 5355: // printf("side->isDry: %d\n", side->isDry);
 5356:       if (side->isDry) return;
 5357: 
 5358:       // Computes the gradient of the variables at the side center.
 5359:       auto isWet1 = [](const Element* e) { return !(e->isDry); };
 5360:       auto isWet2 = [](const Element* e) { return !(e->isDry2()); };
 5361:       auto isWet3 = [](const Element* e) { return !(e->depth >= tip_dp); };
 5362: 
 5363:       side->gradEta1 = side->grad2(&Node::eta1, isWet1);
 5364:       side->gradEta2 = side->grad2(&Node::eta2, isWet2);
 5365:       side->gradETP  = side->grad2(&Node::ETP,  isWet3);
 5366:       side->gradPr   = side->grad2(&Node::pr,   isWet1);
 5367: 
 5368: 
 5369:    }
 5370: 
 5371: 
 5372:    __global__ void solveMomentumEquations(double time) {
 5373: 
 5374:       double alow[nvrt], cupp[nvrt], bdia[nvrt];
 5375:       Vector2 rrhs[nvrt], u[nvrt], soln[nvrt], gam[nvrt];
 5376: 
 5377:       SIDE(side);
 5378: 
 5379:       if (side->isDry) 
 5380:       {
 5381:          for (int k=0; k<nvrt; k++) side->u2[k] = {0.0, 0.0};         
 5382: 
 5383:          return;
 5384:       }
 5385: 
 5386:       const Node *n1 = side->n1;
 5387:       const Node *n2 = side->n2;
 5388: 
 5389:       const int kb = side->kb;
 5390: 
 5391:       const double veg_h = side->veg_h();
 5392:       const double grav3 = side->grav3();
 5393: 
 5394:       if (side->is2D()) {
 5395:          // Warning: Do not use htot2, which is updated.
 5396:          const double htot = side->htot1();
 5397:          const double hhat = side->hhat;
 5398: 
 5399:          // assert(hhat > 0.0 && htot > 0.0 && "solveMomentumEquations: Impossible");
 5400: 
 5401:          Vector2 tau2 = {0.0, 0.0};
 5402:           
 5403:          if constexpr(ics==1) {
 5404:             tau2 = side->tau();
 5405: 
 5406:          } else {
 5407:             assert(false && "Not implemented: ics == 2");
 5408:             // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5409:             // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5410:             // taux2=(vn1+tt1)*0.5d0
 5411:             // tauy2=(vn2+ss1)*0.5d0
 5412:          } // if ics         
 5413: 
 5414:          // hat_gam has units of m/s
 5415: 
 5416:          const Vector2 coriolisTerm = side->coriolis*rot90(side->u2[nvrt-1]);
 5417: 
 5418:          Vector2 hat_gam = side->btu[nvrt-1] + dt*(coriolisTerm - side->gradPr/rho0 + grav3*side->gradETP +
 5419:                            side->bcc[kb] + tau2/htot - grav3*((1 - thetai)*side->gradEta1 + thetai*side->gradEta2));
 5420: 
 5421:          hat_gam += dt*side->nuGradU[nvrt-1];  // XXXX compute nuGradU
 5422: 
 5423: 
 5424:          const double ux = clamp(hat_gam.x*hhat/htot, -rmaxvelx, rmaxvelx);
 5425:          const double uy = clamp(hat_gam.y*hhat/htot, -rmaxvely, rmaxvely);
 5426: 
 5427:          for (int k = 0; k < nvrt; k++) side->u2[k] = {ux, uy};
 5428: 
 5429:       }
 5430:       else { // 3D
 5431: 
 5432:          // For 3D it is necessary to solve an implicit tridiagonal system.
 5433:          // 
 5434:          // Each line of the tridiagonal system include variables for layers k-1, k, k+1.
 5435:          // However, for the vegetation terms, the canopy complicates things, because the vertical 
 5436:          // integration is only done up to the canopy. In this case we use the notation "t" (top)
 5437:          // to indicate the "top" level, which may not coincide with a layer. "t" can stand for both
 5438:          // k+1 and k.
 5439: 
 5440: 
 5441:          const int ndim = nvrt - kb;
 5442:          const double zTopCanopy = side->zTopCanopy();
 5443: 
 5444:          // Initialize the tridiagonal system
 5445:          for (int k = kb + 1; k < nvrt; k++) {
 5446:             
 5447:             const int kin = k - (kb + 1);
 5448: 
 5449:             // Vertical viscosity at the face center
 5450:             const double dfz = 0.5*(side->dfv(k - 1) + side->dfv(k)); ///XXXXX
 5451:  
 5452:             alow[kin] = 0.0;
 5453:             cupp[kin] = 0.0;
 5454:             bdia[kin] = 0.0;
 5455: 
 5456:             double cff1 = 1.0; //init \bar{c^{k+1}}              
 5457:             // Vegetation term: alpha*|u^n|*dt*H(dv-d)*u^{n+1}
 5458: 
 5459:             // We divide the code into two parts, one (L) that deals with layers k, k+1, and another (R) that deals with k-1, k.
 5460:             // There is a special case when k is the bottom layer, where the bottom drag is applied.
 5461:             // Notice that the top boundary is not included implicitly, because it depends on tau, but not on u.
 5462: 
 5463:             // First part: layers k, k+1
 5464:             if (k < nvrt - 1) {
 5465:                              
 5466:                if constexpr(iveg != 0) {
 5467: 
 5468:                   // If there is vegetation at this level...
 5469:                   if (zTopCanopy > side->zc[k]) {
 5470:                      // If the canopy is above the k layer...
 5471:                      
 5472:                      // Computes the velocity at the level above (typically layer k+1, unless the canopy is below it)
 5473:                      const double zt = min(zTopCanopy, side->zc[k + 1]);
 5474:                      const double zrat = (zt - side->zc[k])/side->Dz(k + 1); // value in (0,1], 1 means that the canopy is above zt.
 5475:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k] + zrat*side->u2[k + 1];
 5476: 
 5477:                      // Computes the velocity magnitude at the face center (the section of the face covered by the vegetation)
 5478:                      const double vmag2 = length(ut2);
 5479:                      const double vmag1 = length(side->u2[k]);
 5480:                      const double vmag = 0.5*(vmag1 + vmag2);
 5481:                      
 5482:                      // Computes the vegetation alpha at the face center
 5483:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k+1));
 5484: 
 5485:                      cff1 += veg_alpha_sd*dt*vmag;
 5486: 
 5487:                   } // if (zTopCanopy
 5488:                } // if iveg
 5489: 
 5490:                const double dzz = side->Dz(k + 1);
 5491:                const double tmp = dt*dfz/dzz;
 5492:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5493: 
 5494:                cupp[kin] += cff1*dzz/6.0 - tmp;
 5495:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5496:             }
 5497: 
 5498: 
 5499:             // Second part: layers k-1, k
 5500:             if (k > kb + 1) {
 5501: 
 5502:                double cff1 = 1.0; //init \bar{c^k}
 5503: 
 5504:                if constexpr(iveg != 0) {
 5505:                   // If there is vegetation at this level...
 5506:                   if (zTopCanopy > side->zc[k-1]) {
 5507:                      const double zz1 = min(zTopCanopy, side->zc[k]);
 5508:                      const double zrat = (zz1 - side->zc[k-1])/side->Dz(k); // value in (0,1]
 5509: 
 5510:                      const Vector2 ut2 = (1.0 - zrat)*side->u2[k-1] + zrat*side->u2[k];
 5511: 
 5512:                      const double vmag2 = length(ut2);
 5513:                      const double vmag1 = length(side->u2[k-1]);
 5514:                      const double vmag = 0.5*(vmag1 + vmag2);
 5515: 
 5516:                      // Computes the vegetation alpha at the face center
 5517:                      const double veg_alpha_sd = 0.5*(side->veg_alpha3D(k) + side->veg_alpha3D(k-1));
 5518:                      cff1 += veg_alpha_sd*dt*vmag;
 5519:                   } // if zTopCanopy
 5520: 
 5521:                } // if iveg
 5522: 
 5523:                const double dzz = side->Dz(k);
 5524:                const double tmp = dt*dfz/dzz;
 5525:                assert(dzz > 0.0 && "STEP: dzz<=0 in momentum");
 5526: 
 5527:                alow[kin] += cff1*dzz/6.0 - tmp;
 5528:                bdia[kin] += cff1*dzz/3.0 + tmp;
 5529: 
 5530:             } else { // Bottom boundary
 5531:                // This occurs at the bottom, where the bottom drag is applied.
 5532: 
 5533:                bdia[kin] += dt*side->chi2; // XXXX
 5534: 
 5535:             } // if (k > kb + 1)
 5536: 
 5537: 
 5538:          } // for (int k
 5539: 
 5540: 
 5541: 
 5542:          // Computes the RHS.
 5543:          // -----------------
 5544: 
 5545:          //	BC to be imposed at the end.
 5546: 
 5547:          const Vector2 gradETP  = side->gradETP;
 5548:          const Vector2 gradPr   = side->gradPr;
 5549:          const Vector2 gradEta1 = side->gradEta1;
 5550:          const Vector2 gradEta2 = side->gradEta2;
 5551: 
 5552:          const Vector2 *btu = side->btu;
 5553:          const Vector2 *u2  = side->u2;
 5554:          const double coriolis = side->coriolis;
 5555:          const Vector2 *nuGradU = side->nuGradU;
 5556: 
 5557: 
 5558:          const Vector2 grad2D = grav3*(thetai*gradEta2 + (1.0-thetai)*gradEta1 - gradETP) + gradPr/rho0;
 5559: 
 5560:          for (int k = kb + 1; k < nvrt; k++) {
 5561:             const int kin = k - kb - 1;
 5562: 
 5563:             const double dz_0 = side->Dz(k);
 5564:             const double dz_1 = (k < nvrt - 1) ? side->Dz(k + 1) : 0.0;  // k always < nvrt - 1 when used.
 5565: 
 5566:             rrhs[kin] = {0.0, 0.0};
 5567:             double dz = 0.0;
 5568: 
 5569:             // dz is the distance between the center of the k-th layer and the center of the (k+1)-th layer
 5570:             // In the boundary layers, it is the distance between the center of the layer and the boundary.
 5571:             if (k < nvrt  ) dz += dz_1;
 5572:             if (k > kb + 1) dz += dz_0;
 5573: 
 5574:             // Elevation gradient, atmospheric pressure and tidal potential
 5575:             rrhs[kin] = - 0.5*dz*dt*grad2D;
 5576: 
 5577:             // Coriolis, advection, wind stress, and horizontal viscosity
 5578:             if (k < nvrt - 1) {
 5579: 
 5580: 
 5581:                rrhs[kin] += (dz_1/6.0)*(2.0*btu[k] + btu[k + 1] + 
 5582:                                         dt*(coriolis*rot90(2.0*u2[k] + u2[k + 1]) + 
 5583:                                             2.0*nuGradU[k] + nuGradU[k + 1]));
 5584:                                                 
 5585: 
 5586:                //diff stress tensors 1006
 5587:                if constexpr(itur==5) {  // 1018:itur==5 XXX What is itur?
 5588:                   // Does it make sense to have dz_1 multiplying and dividing? XXX
 5589:                   assert(false && "Not implemented: itur == 5");
 5590:                   // rrhs[kin] += 0.5*dt*dz_1*(side->TDz[k+1] - side->TDz[k])/dz_1
 5591:                }
 5592: 
 5593:             } else { // k == nvrt - 1 SURFACE
 5594:                Vector2 tau2 = {0.0, 0.0};
 5595:                if constexpr(ics==1) {
 5596:                   tau2 = side->tau();
 5597:       
 5598:                } else {
 5599:                   assert(false && "Not implemented: ics == 2");
 5600:                   // call project_hvec(tau(1,node1),tau(2,node1),pframe(:,:,node1),sframe2(:,:,j),vn1,vn2)
 5601:                   // call project_hvec(tau(1,node2),tau(2,node2),pframe(:,:,node2),sframe2(:,:,j),tt1,ss1)
 5602:                   // taux2=(vn1+tt1)*0.5d0
 5603:                   // tauy2=(vn2+ss1)*0.5d0
 5604:                } // if ics
 5605: 
 5606:                rrhs[kin] += dt*tau2;
 5607: 
 5608:             } // if k<nvrt
 5609: 
 5610:             if (k > kb + 1) {
 5611:                rrhs[kin] += (dz_0/6.0)*(2.0*btu[k] + btu[k - 1] + 
 5612:                                        dt*(coriolis*rot90(2.0*u2[k] + u2[k - 1]) + 
 5613:                                            2.0*nuGradU[k] + nuGradU[k - 1]));
 5614: 
 5615:                // diff stress tensors 1006
 5616:                if constexpr(itur==5) { // 1018:itur==5 XXX What is itur?
 5617:                   assert(false && "Not implemented: itur == 5");
 5618:                   // Does it make sense to have dz_0 multiplying and dividing? XXXX
 5619:                   // rrhs[kin] += 0.5*dt*dz_0*(side->TDz[k] - side->TDz[k-1])/dz_0;
 5620:                }
 5621: 
 5622:             } // if k>kbs + 1
 5623: 
 5624:             // Baroclinic
 5625:             Vector2 *bcc = side->bcc;
 5626:             if constexpr(ibc == 0) {
 5627:                if (k < nvrt  ) rrhs[kin] += (dz_1*dt/6.0)*(2.0*bcc[k] + bcc[k+1]);
 5628:                if (k > kb + 1) rrhs[kin] += (dz_0*dt/6.0)*(2.0*bcc[k] + bcc[k-1]);
 5629: 
 5630:             } // if ibc==0
 5631: 
 5632:          } // k=kb + 1,nvrt
 5633: 
 5634: 
 5635:          tridag_sch<2>(nvrt - kb - 1, alow, bdia, cupp, (double *)rrhs, (double *)soln, (double *)gam);
 5636: 
 5637:          for (int k = kb + 1; k < nvrt; k++) {  // YYYYYYYYY can be kb 
 5638:             const int kin = k - kb - 1;
 5639: 
 5640:             // Velocity is always clamped to maximum values
 5641:             side->u2[k] = make_double2(clamp(soln[kin].x, -rmaxvelx, rmaxvelx), clamp(soln[kin].y, -rmaxvely, rmaxvely));
 5642:          } // k
 5643: 
 5644:       } // if side->is2D()
 5645:       
 5646: 
 5647:       // Impose velocity boundary condition at the bottom
 5648:       if constexpr(imm == 2) { // 3D bed deformation model
 5649:          double dep;
 5650:          Vector2 vel;
 5651: 
 5652:          assert(false && "Not implemented: imm == 2");
 5653:          //update_bdef(time, x0, y0, dep, vel);
 5654:          // side->u2[kb] = vel;
 5655: 
 5656:       } else { // imm = 0 or 1
 5657:          if (side->Cd() == 0.0) {
 5658:             side->u2[kb] = side->u2[kb + 1];
 5659: 
 5660:          } else if (side->is3D()) { // 3D no slip bottom   
 5661:             side->u2[kb] = {0.0, 0.0};
 5662:          }
 5663:           
 5664:       } // if imm
 5665: 
 5666:       // The velocities below the bottom level are set to zero
 5667:       for (int k = 0; k <= kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5668: 
 5669: 
 5670:    }
 5671: 
 5672: 
 5673:    __global__ void applyMomentumBC(void) {
 5674: 
 5675:       SIDE_BND(sideBnd);
 5676: 
 5677:       Side *side = sideBnd->side;
 5678:       const BoundarySegment *segment = sideBnd->segment;
 5679:       const Node *n1 = side->n1;
 5680:       const Node *n2 = side->n2;
 5681: 
 5682:       assert(segment != nullptr && "applyMomentumBC: segment is nullptr");
 5683: 
 5684:       const bool isLand = segment->isLand;
 5685:       const int ifltype = segment->ifltype;
 5686: 
 5687:       const int kb = side->kb;
 5688: 
 5689:       if (!isLand && ifltype != 0) {
 5690:          const Vector2 *ubc = sideBnd->ubc;
 5691:   
 5692:          for (int k = kb; k < nvrt; k++) { // YYYYYYYYY can be kb + 1
 5693:             
 5694:             assert(ifltype == -2 || ((ubc[k].x >= -98 && ubc[k].y >= -98) 
 5695:                    && (ubc[k].x <= 98 && ubc[k].y <= 98)) && "Momentum BC: Side has no velocity boundary conditions");
 5696: 
 5697:             if (ifltype == -1) {
 5698:                // Flather 1
 5699: 
 5700:                const double depth = side->depth();
 5701: 
 5702:                assert(depth > 0.0 && "Flather bnd has 0 or negative depth");
 5703: 
 5704:                const double vnorm = sqrt(grav/depth)*(side->eta2() - sideBnd->etaMeanBnd()) + dot(ubc[k], side->n);
 5705: 
 5706:                side->u2[k] = vnorm*side->n;
 5707: 
 5708:             } else if (ifltype == -2) { // Discharge
 5709: 
 5710:                const double eta1 = side->eta1();
 5711:                const double eta2 = side->eta2();
 5712:                const double htot = side->htot2();
 5713: 
 5714:                // Discharge is a polynomial. See disch_coef in readTides. We must implement this.
 5715:                assert(false && "Not implemented: Discharge bc");
 5716:                // const double dischrg = discharge(eta1);
 5717:                const double dischrg = 0.0; // XXX REMOVE
 5718:                
 5719: 
 5720:                assert(htot > 0.0 && "Discharge bc has 0 or negative htot");
 5721: 
 5722:                const double vnorm = dischrg*eta2/htot;
 5723: 
 5724:                side->u2[k] = vnorm*side->n;
 5725: 
 5726:             }
 5727:             else if (ifltype == -4 || ifltype == -5) { // 3D radiation
 5728:                const double vnorm = dot(side->u2[k], side->n);
 5729: 
 5730:                double rat;
 5731:                if (vnorm <= 0.0) rat = segment->vobc1; // incoming
 5732:                else              rat = segment->vobc2; // outgoing
 5733: 
 5734:                side->u2[k] = (1.0 - rat)*side->u2[k] + rat*ubc[k];
 5735: 
 5736:             }
 5737:             else { // not Flather or 3D radiation
 5738:                side->u2[k] = ubc[k];
 5739: 
 5740:             } // if (segment->ifltype...
 5741: 
 5742:          }
 5743: 
 5744:       }
 5745:       else if (isLand) { // if it is land boundary side
 5746: 
 5747:          if constexpr(islip == 0) { // free slip
 5748: 
 5749:             for (int k = kb; k < nvrt; k++) {
 5750: 
 5751:                const Vector2 t = side->t();
 5752:                const Vector2 n = side->n;
 5753: 
 5754:                double vnorm = 0.0; // for most cases
 5755:                const double vtan = dot(side->u2[k], t);
 5756:                
 5757:                side->u2[k] = vtan*t - vnorm*n;
 5758: 
 5759:             }
 5760: 
 5761:          } else { // no slip
 5762:             for (int k=kb; k < nvrt; k++) side->u2[k] = {0.0, 0.0};
 5763: 
 5764:          }
 5765:       } // if (side segment type...
 5766: 
 5767:    
 5768: 
 5769:    }
 5770: 
 5771: 
 5772:    __global__ void shapiroFilter1(void) {
 5773:       // First step of the Shapiro filter (normally used if indvel<=0)
 5774:       // Computes the filtered values and stores them in bcc (as a temporary array).
 5775: 
 5776:       SIDE(side);
 5777: 
 5778:       // Only internal wet sides are processed
 5779:       if (side->isDry || !(side->isInternal())) return;
 5780: 
 5781:       const int kb = side->kb;
 5782: 
 5783:       for (int mm = 0; mm < niter_shap; mm++) {
 5784: 
 5785:          for (int k = kb + 1; k < nvrt; k++) {
 5786:             // WARNING: reusing bcc as a temporary array to store the suru values.
 5787:             Vector2 suru = {0.0, 0.0};
 5788: 
 5789:             for (int j = 0; j < 4; j++) { // 4 neighbors per side
 5790: 
 5791:                const Side *nSide = side->neigh(j); // Every internal side has 4 neighbors
 5792: 
 5793:                int kin = k;
 5794:                if (!(nSide->isDry)) kin = max(k, kb + 1);
 5795:                
 5796:                if constexpr(ics==1) {
 5797:                   suru += nSide->u2[kin];
 5798: 
 5799:                } else {
 5800:                   assert(false && "Not implemented: ics == 2");
 5801:                   // Vector2 vn1, vn2;
 5802:                   // project_hvec(side->u2[kin], side->v2[kin], nSide->sframe, side->sframe, vn1, vn2);
 5803:                   // suru=suru+vn1;
 5804:                   // surv=surv+vn2;
 5805:                }
 5806:             }
 5807: 
 5808: 
 5809:             side->bcc[k] = side->u2[k] + side->shapiro*(0.25*suru - side->u2[k]); // sframe2 if ics=2
 5810: 
 5811:          }
 5812:       }
 5813:    }
 5814: 
 5815:    __global__ void shapiroFilter2(void) {
 5816:       // Second step of the Shapiro filter. Assigns to u2 the values stored in bcc.
 5817: 
 5818:       SIDE(side);
 5819: 
 5820:       if (side->isDry || !(side->isInternal())) return;
 5821: 
 5822:       const int kb = side->kb;
 5823: 
 5824:       for (int k = 0; k < kb - 1; k++) side->u2[k] = {0.0, 0.0};
 5825: 
 5826:       if (side->is2D()) {
 5827:          side->u2[kb + 1] = side->bcc[kb + 1];
 5828:          side->u2[kb    ] = side->u2 [nvrt - 1];
 5829: 
 5830:       } else {
 5831:          // 3D
 5832:          for (int k = kb + 1; k < nvrt; k++) side->u2[k] = side->bcc[k];
 5833:          
 5834:       }
 5835: 
 5836:    }
 5837: 
 5838: 
 5839:    __global__ void ul0UpdateZCoords(void) {
 5840:    // For wet nodes updates the nodes z-coordinates and bottom index, kb.
 5841:       
 5842:       NODE(node);      
 5843: 
 5844: 
 5845:       if (node->isDry2()) { 
 5846: 
 5847:          assert((ivcor != 2) || (node->depth < mesh->h_s) && "Deep depth dry");
 5848: 
 5849:          if constexpr(ivcor != 1) node->kb = 0;
 5850: 
 5851:       } else {
 5852: 
 5853:          // Compute the updated node's kb index. This must be done before compZCoord() is called.
 5854:          node->updateKb();
 5855: 
 5856:          for (int k = node->kb; k < nvrt; k++) node->z[k] = node->compZCoord(k); 
 5857: 
 5858:       }
 5859: 
 5860:       // We use the temp.b field to store the previous state of isDry.
 5861:       node->tmp.b = node->isDry;
 5862: 
 5863:       // In the next step we will compute which nodes are wet, so we first assume that all nodes are dry.
 5864:       node->isDry = true;
 5865: 
 5866:    }
 5867: 
 5868:    __global__ void ul0ComputeDryElementsAndNodes(void)
 5869:    // Updates isDry based on eta2 for the nodes. Also computes the element's kb and z.
 5870:    {
 5871:       ELEM(elem);
 5872: 
 5873:       elem->isDry = elem->isDry2(); // Element is dry if any of its nodes are dry (based on eta2, not on isDry)
 5874: 
 5875:       // All the nodes of a wet element are wet.
 5876:       if (!elem->isDry) {
 5877:          elem->nodes[0]->isDry = false;
 5878:          elem->nodes[1]->isDry = false;
 5879:          elem->nodes[2]->isDry = false;
 5880:          if (elem->isQuad()) elem->nodes[3]->isDry = false;
 5881: 
 5882:       }
 5883: 
 5884: 
 5885:       elem->kb = 0;
 5886: 
 5887:       if (elem->isDry) return;
 5888: 
 5889:       // Wet
 5890:       const Node *n1 = elem->nodes[0];
 5891:       const Node *n2 = elem->nodes[1];
 5892:       const Node *n3 = elem->nodes[2];  
 5893:       const Node *n4 = elem->nodes[3]; // nullptr for triangles
 5894: 
 5895:    //    if(elem->isDry2()) { // XXXX
 5896:    //        write(errmsg,*)'level0: Element-node inconsistency (0):',ielg(i),idry_e2(i), &
 5897:    //   &iplg(elnode(1:i34(i),i)),idry2(elnode(1:i34(i),i)),idry(elnode(1:i34(i),i))
 5898:    //        call parallel_abort(errmsg)
 5899:    //    }
 5900: 
 5901: 
 5902:       // Computes element's kb as the minimum of the nodes' kb.
 5903:       const int kb1 = n1->kb;
 5904:       const int kb2 = n2->kb;
 5905:       const int kb3 = n3->kb;
 5906:       const int kb4 = (elem->isQuad()) ? n4->kb : INT_MAX;
 5907: 
 5908: 
 5909:       elem->kb = min(min(kb1, kb2), min(kb3, kb4));
 5910: 
 5911: 
 5912:       // Computes the element z as the mean of the nodes z.
 5913:       for (int k = elem->kb; k < nvrt; k++) {
 5914: 
 5915:          // Compute the element z as the mean of the nodes z.
 5916:          elem->z[k] = (n1->z[max(k, kb1)] + n2->z[max(k, kb2)] + n3->z[max(k, kb3)]);
 5917:          if (elem->isQuad()) elem->z[k] += n4->z[max(k, kb4)];          
 5918:          elem->z[k] /= elem->i34;
 5919: 
 5920:          assert(((k < elem->kb + 1)  || (elem->z[k] - elem->z[k-1] > 0.0)) && "Weird element z");
 5921:       }
 5922:                   
 5923:    }
 5924: 
 5925:    __global__ void ul0UpdateRewettedNodes(int it, int iths)
 5926:    {
 5927:       NODE(node);
 5928:       // Compute velocity, S, T for re-wetted nodes (q2 and xl are fine)
 5929: 
 5930:       if (it == iths) return;
 5931: 
 5932: 
 5933:       if(!node->isDry && node->tmp.b) { // rewetted
 5934:          for (int k=0; k < nvrt; k++) {
 5935: 
 5936:             Vector3 utmp={0.0, 0.0, 0.0};
 5937: 
 5938:             double ttmp=0.0;
 5939:             double stmp=0.0;
 5940:             int icount=0;
 5941:             for (int j = 0; j < node->numNodes; j++) {
 5942: 
 5943: 
 5944:                // Wet nbrs not affected by this part and so each sub-domain should use same values
 5945:                if (!node->isDry) { // all indices extended
 5946:                   icount++;
 5947: 
 5948:                   // Assume small element size in wet/dry zone so pframes are close to each other
 5949:                   utmp += node->uvw2(k);
 5950:                   
 5951:                   ttmp += node->tracers[k].tracer[0]; 
 5952:                   stmp += node->tracers[k].tracer[1]; 
 5953:                }
 5954:             }
 5955: 
 5956:             if(icount > 0) {
 5957:                const double inv_icount = 1.0/icount;
 5958:                node->u2[k]     = {inv_icount*utmp.x, inv_icount*utmp.y};
 5959:                node->w2[k]     = inv_icount*utmp.z;
 5960:                node->tracers[k].tracer[0]   = inv_icount*ttmp;
 5961:                node->tracers[k].tracer[1]   = inv_icount*stmp;
 5962:             }
 5963:          }
 5964:       }
 5965:    }
 5966: 
 5967: 
 5968:    __global__ void ul0UpdateSides(int it, int iths) {
 5969: 
 5970:       SIDE(side);
 5971: 
 5972:       // A side is wet if and only if at least one of its elements is wet.
 5973:       const bool isWet = !side->elems[0]->isDry || (side->isInternal() && !side->elems[1]->isDry);
 5974:  
 5975:       const Node *n1 = side->n1;
 5976:       const Node *n2 = side->n2;
 5977:      
 5978:       const int kb1 = n1->kb;
 5979:       const int kb2 = n2->kb;
 5980: 
 5981:       side->kb = 0; // dry
 5982: 
 5983:       if (isWet) {
 5984: 
 5985:          assert(~(n1->isDry || n2->isDry) && "Side-node inconsistency. At least one node of a wet side is dry.");
 5986: 
 5987:          assert(side->htot2() > h0 && "Weird side. Total depth is smaller than h0.");
 5988: 
 5989:          side->kb = min(kb1, kb2);
 5990: 
 5991:          for (int k = 0; k < side->kb; k++) side->zc[k] = 0.0;  // XXXX NECESSARY???
 5992: 
 5993:          for (int k = side->kb; k < nvrt; k++) {
 5994:             side->zc[k] = 0.5*(n1->z[max(k, kb1)] + n2->z[max(k, kb2)]);
 5995: 
 5996:          
 5997:             assert(((k < side->kb + 1) || (side->zc[k] - side->zc[k-1] > 0.0)) && "Weird side (3)");
 5998: 
 5999:             // Compute velocity for re-wetted sides 
 6000:             if ((it != iths) && (side->isDry && isWet)) {
 6001:             
 6002:                Vector2 utmp={0.0, 0.0};
 6003: 
 6004:                int icount=0;
 6005: 
 6006:                // For all the sides on the two elements that share this side
 6007:                for (int j=0; j < 2; j++) {
 6008:                   const Element *elem = side->elems[j];
 6009:                   if (elem == nullptr) continue;
 6010: 
 6011:                   for (int jj=0; jj < elem->i34; jj++) {
 6012:                      const Side *nSide = elem->sides[jj];
 6013:                      if (nSide->isDry) continue;
 6014: 
 6015:                      icount++;
 6016:                      utmp += nSide->u2[k];                     
 6017:                   }
 6018:                }
 6019:                   
 6020:                assert(icount > 0 && "No wet sides around this side");
 6021:                if (icount > 0)  side->u2[k] = utmp/icount;
 6022:                   
 6023:             } // if ((it != iths) && (side->isDry && isWet))
 6024: 
 6025:          } // for k
 6026: 
 6027:       } // if isWet
 6028:    
 6029:       side->isDry = !isWet;
 6030: 
 6031:    }
 6032: 
 6033: 
 6034:    __global__ void zeroNodalVelocities(void) {
 6035:       NODE(node);
 6036: 
 6037:       for (int k = 0; k < nvrt; k++) {
 6038:          node->u2[k]   = {0.0, 0.0};
 6039:          node->w2[k]   = 0.0;
 6040:          node->utmp[k] = {0.0, 0.0};
 6041:          node->tmp.d = 0.0;  // reset the temporary real value. It will be used to compute the area-averaged vertical velocity
 6042:       }
 6043:    }
 6044: 
 6045:  
 6046: 
 6047:    __global__ void computeNodalVerticalVelocities1(void) {
 6048:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6049:    // Adds the element's vertical velocity times the element's area.
 6050:       ELEM(elem);
 6051: 
 6052:       for (int j = 0; j < elem->i34; j++) {
 6053:          Node *node = elem->nodes[j];
 6054: 
 6055:          for (int k = node->kb; k < nvrt; k++) {
 6056:             atomicAdd(&(node->w2[k]), elem->w[k]*elem->area);
 6057:          }
 6058:          atomicAdd(&(node->tmp.d), elem->area);
 6059:       }
 6060:    }
 6061: 
 6062:    __global__ void computeNodalVerticalVelocities2(void) {
 6063:    // Compute node's vertical velocities from element's vertical velocities at WHOLE levels.
 6064:    // Divides by the total area of the elements sharing the    node.
 6065:       NODE(node);
 6066: 
 6067:       for (int k = node->kb; k < nvrt; k++) node->w2[k] = node->w2[k] / node->tmp.d;  // node->tmp.d contains the total area of the elements sharing the node
 6068:    }
 6069: 
 6070: 
 6071:    __global__ void computeNodalHorizontalVelocities1(void) {
 6072:       assert(indvel == 0 && "computeNodalVelocities only works for indvel <= 0. IMPLEMENT THIS FOR INDVEL = 1");
 6073:       assert(ics == 1 && "computeNodalVelocities only works for ics = 1. IMPLEMENT THIS FOR other ics");
 6074: 
 6075:       ELEM(elem);
 6076: 
 6077:       const int kb = elem->kb;
 6078:       const bool isTri = elem->isTri();
 6079: 
 6080:       if constexpr(indvel <= 0) {
 6081:          // Assuming discontinoius hvel.
 6082: 
 6083: 
 6084:          if (isTri) { // For triangles
 6085:          // Interpolates the side velocities at the nodes. A magnitude defined at the sides and interpolated (extrapolated) at one node can be
 6086:          // computed as the sum of the adjacent side magnitudes minus the side magnitude that is not adjacent to the node.
 6087: 
 6088:             for (int j = 0; j < 3; j++) {
 6089:                // For every node of the triangle...
 6090:                Node *node = elem->nodes[j];
 6091: 
 6092:                const Side *s1 = elem->sides[j];
 6093:                const Side *s2 = elem->sides[(j + 1) % 3];
 6094:                const Side *s3 = elem->sides[(j + 2) % 3];
 6095: 
 6096:                const int numElements = node->numElements;
 6097:                const double inv_numElements = 1.0/numElements;
 6098: 
 6099:                for (int k = kb; k < nvrt; k++)  {
 6100:                   Vector2 u = s2->u2[k] + s3->u2[k] - s1->u2[k]; // u interpolated at the node   
 6101:                   u.x = clamp(u.x, -rmaxvelx, rmaxvelx);
 6102:                   u.y = clamp(u.y, -rmaxvely, rmaxvely);
 6103:                   // node->utmp[k] = node->utmp[k] + (1.0/numElements) * u; 
 6104:                   atomicAdd(&(node->utmp[k].x), inv_numElements * u.x);
 6105:                   atomicAdd(&(node->utmp[k].y), inv_numElements * u.y);
 6106: 
 6107:                }
 6108: 
 6109:             }
 6110:          }
 6111:          else { // For quads
 6112:             assert(false && "computeNodalHorizontalVelocities1: not implemented for quads");
 6113: 
 6114:          }
 6115: 
 6116:       }
 6117:       
 6118:    }
 6119: 
 6120: 
 6121:    __global__ void computeNodalHorizontalVelocities2(void) {
 6122:       NODE(node);
 6123: 
 6124:       for (int k = 0; k < nvrt; k++) {
 6125:          node->u2[k] = node->utmp[k];
 6126:          node->w2[k] = node->w2[k];
 6127:       }
 6128:       
 6129:    }   
 6130: 
 6131:    __global__ void computeNodalHorizontalVelocitiesOLD(void) {
 6132:    // XXXX I'm not sure where I got this function from. 
 6133:    // Compute node's horizonal velocities from side velocities at WHOLE levels.
 6134:    // It goes for each side and adds to the nodes the velocity divided by the number of sides.
 6135:    // It does it for all nodes, including boundary nodes. Afterwards, the open boundary nodes are set to a different value.
 6136:    // It uses the utmp array as a temporary array to store the velocities.
 6137: 
 6138:       assert(indvel == 0 && "computeNodalVelocities only works with indvel = 0. IMPLEMENT THIS FOR INDVEL <= 0");
 6139: 
 6140:       SIDE(side);
 6141: 
 6142:       const int kb = side->kb;
 6143: 
 6144:       Node *n1 = side->n1;
 6145:       Node *n2 = side->n2;
 6146: 
 6147:       for (int k = kb; k < nvrt; k++) {
 6148: 
 6149:          // Cast the u2 vector into a Vector2 
 6150:          Vector2& n1_u2 = *reinterpret_cast<Vector2*>(&(n1->utmp[k]));
 6151:          Vector2& n2_u2 = *reinterpret_cast<Vector2*>(&(n2->utmp[k]));
 6152: 
 6153:          n1_u2 = side->u2[k]/n1->numSides;
 6154:          n2_u2 = side->u2[k]/n2->numSides;
 6155: 
 6156:       }
 6157: 
 6158: 
 6159:    }
 6160: 
 6161:    __global__ void resetVelocityOpenBndNodes(void) {
 6162:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6163: 
 6164:       NODE_BND(nodebnd);
 6165: 
 6166:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6167:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6168:       }
 6169: 
 6170:    }
 6171: 
 6172: 
 6173:    __global__ void setVelocityOpenBndNodes(void) {
 6174:    // For open boundary nodes sets their velocity to the imposed values.
 6175: 
 6176:       SIDE_BND(sidebnd);
 6177: 
 6178:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6179:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6180:          // to its segment to the average of the side velocity.
 6181: 
 6182:          for (int k = 0; k < nvrt; k++) {
 6183:             Node *n1 = sidebnd->side->n1;
 6184:             Node *n2 = sidebnd->side->n2;
 6185: 
 6186: 
 6187:             Vector2 n1_u2(n1->u2[k]);
 6188:             Vector2 n2_u2(n2->u2[k]);
 6189: 
 6190:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6191:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6192:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6193:             }
 6194:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6195:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6196:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6197:             }
 6198: 
 6199:          }
 6200: 
 6201:       }
 6202: 
 6203:    }
