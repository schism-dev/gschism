 1730: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o') {
 1731: // return;   
 1732:    // Lock the mutex
 1733:    lock(&debugPlotMutex);
 1734:  
 1735:    bool ok = true;
 1736:    if (debugPlotIdx == nullptr) ok = false;
 1737:    if (*debugPlotIdx >= 10000) ok = false;
 1738:    if (ok) {
 1739:       debugPlot[(*debugPlotIdx) + 0*10000] = x1.x;
 1740:       debugPlot[(*debugPlotIdx) + 1*10000] = x1.y;
 1741:       debugPlot[(*debugPlotIdx) + 2*10000] = x2.x;
 1742:       debugPlot[(*debugPlotIdx) + 3*10000] = x2.y;
 1743:       debugPlot[(*debugPlotIdx) + 4*10000] = (double)color;
 1744:       debugPlot[(*debugPlotIdx) + 5*10000] = (double)marker;
 1745:       (*debugPlotIdx)++;
 1746:    }
 1747: 
 1748:    __threadfence();               // ensure all above writes are visible
 1749:    // Unlock the mutex
 1750:    unlock(&debugPlotMutex);
 1751: 
 1752: }
