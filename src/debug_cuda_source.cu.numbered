  135: // eta coordinates of the nodes (idxNode = 0,1,2,3)
  136: __device__ __forceinline__ double eta_n(int idxNode) {
  137:    // bit1: 0 -> -1, 1 -> +1
  138:    assert(idxNode >= 0 && idxNode < 4 && "etaSign: idxNode out of range");
  139:    return (idxNode & 2) ? 1.0 : -1.0;     // [-1,-1,+1,+1]
  140: }
  141: 
  142: // xi coordinates of the nodes (idxNode = 0,1,2,3)
  143: __device__ __forceinline__ double xi_n(int idxNode) {
  144:    // +1 if (bit0 XOR bit1), else -1
  145:    assert(idxNode >= 0 && idxNode < 4 && "xiSign: idxNode out of range");
  146:    return ((idxNode & 1) ^ (idxNode >> 1)) ? 1.0 : -1.0;   // [-1,+1,+1,-1]
  147: 
  148: }
