 7170:                                  
 7171:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 7172:                    double *node_coords, double *node_coords_ll, bool use_ll,
 7173:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 7174:                    int *isdel, int *isidenode, int *isbnd,
 7175:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 7176:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 7177:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 7178:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 7179:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 7180:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 7181:                    double *drag, double *roughness,
 7182:                    double *emo, double *efa, 
 7183:                    double *umo, double *ufa, 
 7184:                    double *vmo, double *vfa) {
 7185: 
 7186:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 7187:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 7188:                        isdel, isidenode, isbnd,
 7189:                        nond, nlnd, iond, ilnd, 
 7190:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 7191:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 7192:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 7193:                        localNodeIndices, localElemIndices, localSideIndices,
 7194:                        localNodePart, localElemPart, localSidePart,
 7195:                        drag, roughness,
 7196:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 7197:   }
