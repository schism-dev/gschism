 8485: 
 8486:    switch (varCode) {
 8487:       case (int)VarCode::outputCoords:
 8488:          const Point2 coords = elem->outputCoords();
 8489:          res[elem->idx*2    ] = coords.x;
 8490:          res[elem->idx*2 + 1] = coords.y;
 8491:          break;
 8492:    }
 8493: }
