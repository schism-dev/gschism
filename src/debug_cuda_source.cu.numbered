 5362:    __global__ void resetBoundaryAreas(void) {
 5363:       // Reset boundary areas and lengths for each segment.
 5364: 
 5365:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5366:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5367:       SIDE_BND(sideBnd);
 5368: 
 5369:       BoundarySegment *segment = sideBnd->segment;
 5370: 
 5371:       segment->carea = 0.0;
 5372:       segment->clen = 0.0;
 5373:  
 5374:    }
 5375: 
 5376:    __global__ void computeBoundaryAreas(void) {
 5377:    // Calculation of cross-section areas and lengths for flow b.c.
 5378: 
 5379:       SIDE_BND(sideBnd);
 5380: 
 5381:       const Side *side = sideBnd->side;
 5382:       BoundarySegment *segment = sideBnd->segment;
 5383: 
 5384:       if (segment->ifltype != 0) {
 5385: 
 5386:          const Node *n1 = side->n1;
 5387:          const Node *n2 = side->n2;
 5388: 
 5389:          const double htot = side->htot2();
 5390: 
 5391:          if (!side->isDry) {
 5392:             atomicAdd(&segment->carea, htot*side->len);
 5393:             atomicAdd(&segment->clen, side->len);
 5394:          }
 5395:       }
 5396: 
 5397:    }
 5398: 
 5399: 
 5400:    __global__ void computeFlowBcVelocities(double time) {
 5401: 
 5402:       SIDE_BND(sideBnd);
 5403: 
 5404:       const Side *side = sideBnd->side;
 5405:  
 5406:       const bool isDry = side->isDry;
 5407:       const bool isLand = sideBnd->segment->isLand;
 5408: 
 5409:    
 5410:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5411: 
 5412:       if (isDry || isLand) return;
 5413: 
 5414:       // For wet sides in open boundaries...
 5415:       const Vector2 n = side->n;
 5416:       const BoundarySegment *segment = sideBnd->segment;
 5417: 
 5418:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5419: 
 5420:       const int ifltype = segment->ifltype;
 5421: 
 5422:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5423:       const Vector2 r_nuth0 = r_uth0*n;
 5424: 
 5425: 
 5426:       if (ifltype == 1 || ifltype == 2) {
 5427:       
 5428:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5429: 
 5430:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5431:          
 5432:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5433:          
 5434:       } else if (ifltype == -1) { // Flather 1
 5435: 
 5436:          for (int k = 0; k < nvrt; k++) {
 5437: 
 5438:             // uth is the normal vel.; no ramp up
 5439:             const double uth = sideBnd->nuth(k);
 5440:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5441: 
 5442:             sideBnd->ubc[k] += uth*n;
 5443:          }
 5444: 
 5445:       } else if (ifltype == 3 || ifltype == 5) {
 5446:          // vnth0=0 !normal vel.
 5447: 
 5448:          Vector2 r_u1_bar = {0.0, 0.0};
 5449:          // Computes the contribution to the velocity from all tide frequencies
 5450:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5451: 
 5452:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5453:             const Vector2 umo  = sideBnd->umo(jfr); 
 5454: 
 5455:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5456:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5457:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5458:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5459: 
 5460:          }
 5461: 
 5462: 
 5463:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5464: 
 5465:       } // if (ifltype = 3 || ifltype == 5
 5466: 
 5467: 
 5468: 
 5469:    }
 5470: 
 5471:    __global__ void computeElevationBoundaryConditions(double time) {
 5472:       // Compute elevation essential boundary conditions 
 5473: 
 5474:       NODE_BND(nodeBnd); // Each boundary node.
 5475: 
 5476:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5477: 
 5478:       const Node *node = nodeBnd->node;
 5479:       const BoundarySegment *segment = nodeBnd->segment;
 5480:       const int iettype = segment->iettype;
 5481:       
 5482: 
 5483:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5484:       double eic = 0.0;
 5485:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5486:       else                 eic = 0.0;
 5487: 
 5488:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5489:       const double r_eth = ramp*nodeBnd->eth;
 5490:       double r_eta1_bar = 0.0;
 5491: 
 5492:       // Compute tide elevation
 5493:       if (iettype == 3 || iettype == 5) {   
 5494: 
 5495:          if constexpr(iloadtide==1) { // loading tide
 5496:             assert(false && "Loading tide not implemented");
 5497:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5498:          }
 5499:          
 5500:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5501: 
 5502:             const double efa  = nodeBnd->efa[jfr]; 
 5503:             const double emo  = nodeBnd->emo[jfr]; 
 5504: 
 5505:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5506:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5507:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5508: 
 5509: 
 5510:          } // for jfr
 5511: 
 5512:       } // if iettype
 5513: 
 5514:       switch (iettype) {
 5515:          case 1:
 5516:          case 2:
 5517:          case 4:
 5518:             nodeBnd->elbc = r_eic + r_eth;
 5519:             break;
 5520:          case 3:
 5521:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5522:             break;
 5523:          case 5:
 5524:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5525:             break;
 5526:       } // switch
 5527: 
 5528: 
 5529:       //Add inverse barometric effects
 5530:       if (iettype != 0 && inv_atm_bnd == 1) {
 5531:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5532:       }
 5533: 
 5534:    }
 5535: 
 5536: 
 5537:    __global__ void computeHorizontalViscosity(void) { 
 5538: 
 5539:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5540: 
 5541:       SIDE(side);
 5542: 
 5543:       if (side->isDry) return;
 5544: 
 5545:       for (int k = 0; k < nvrt; k++) {
 5546:          side->nuGradU[k] = {0.0, 0.0};
 5547:       }
 5548: 
 5549:       if constexpr(ihorcon == 1) {
 5550:          for (int k = side->kb; k < nvrt - 1; k++) {
 5551:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5552:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5553:             // By Zhang and Baptista.
 5554: 
 5555:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5556:             // This is a standard discretization of the Laplacian operator.
 5557:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5558:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5559:             // Gamma is hvis_coef0 in the code.
 5560:             // The value of gamma needs to be < 0.5.
 5561: 
 5562:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5563:             // side under consideration in each of the two possible elements that share the side.
 5564:             Vector2 sumU = {0.0, 0.0};
 5565:             for (int l = 0; l < 2; l++) {
 5566:                const Element *elem = side->elems[l];
 5567: 
 5568:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5569: 
 5570:                // Find the local index of the side in the element
 5571:                const int idxSide = elem->sideLocalIdx(side);
 5572: 
 5573:                // Find the two sides that are connected to the side under consideration
 5574:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5575:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5576: 
 5577:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5578: 
 5579:             }
 5580: 
 5581:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5582: 
 5583:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5584:    
 5585:          }
 5586:       }
 5587:       else if constexpr(ihorcon == 2) {
 5588:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5589:       }
 5590: 
 5591: 
 5592:    }
 5593: 
 5594: 
 5595:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5596: 
 5597:       // Set essential boundary conditions 
 5598:       NODE(node); // Each boundary node
 5599:       NodeBoundary *nodeBnd = node->nodeBnd;
 5600:       
 5601:  
 5602:       // Check if this node has essential BC
 5603:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5604:          // Verify BC value is valid
 5605:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5606: 
 5607:        
 5608:          // Set diagonal to 1 and zero off-diagonals
 5609:          node->coeffDiag = 1.0;
 5610: 
 5611:          for (int j = 0; j < node->numNodes; j++) {
 5612:                node->coeffMatrix[j] = 0.0;
 5613:          }
 5614:          
 5615:          // Set solution and RHS to BC value
 5616:          node->mX  = nodeBnd->elbc;
 5617:          node->qel = nodeBnd->elbc;
 5618: 
 5619:       } else {
 5620:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5621: 
 5622:          for (int j = 0; j < node->numNodes; j++) {
 5623:                Node* nbNode = node->nodes[j];
 5624:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5625:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5626:                   // Verify neighbor's BC value
 5627:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5628: 
 5629:                   // Subtract contribution to RHS
 5630:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5631:                   node->coeffMatrix[j] = 0.0;  
 5632:                }
 5633:          }
 5634:       }
 5635:    }
 5636: 
