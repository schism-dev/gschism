 2489:    __forceinline__ __device__ void Element::projectNodeVectorsToElementFrame(Vector2 *v) const {
 2490:    // Project the vectors from the node frame to the element frame
 2491: 
 2492:  
 2493:       v[0] = nodes[0]->frame.projHorVec(v[0], frame);
 2494:       v[1] = nodes[1]->frame.projHorVec(v[1], frame);
 2495:       v[2] = nodes[2]->frame.projHorVec(v[2], frame);
 2496:       if (isQuad()) v[3] = nodes[3]->frame.projHorVec(v[3], frame);
 2497:       else          v[3] = Vector2();
 2498:    }
 2499: 
 2500:    __forceinline__ __device__ void Element::projectSideVectorsToElementFrame(Vector2 *v) const {
 2501:    // Project the vectors from the side frame to the element frame
 2502: 
 2503:       v[0] = sides[0]->frame.projHorVec(v[0], frame);
 2504:       v[1] = sides[1]->frame.projHorVec(v[1], frame);
 2505:       v[2] = sides[2]->frame.projHorVec(v[2], frame);
 2506:       if (isQuad()) v[3] = sides[3]->frame.projHorVec(v[3], frame);
 2507:       else          v[3] = Vector2();
 2508:    }
