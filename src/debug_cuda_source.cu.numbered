 7473: 
 7474: __global__ void computeMatrixProductAndDotProducts() {
 7475:    // Computes A*p, r'Mr and p'Ap
 7476: 
 7477:    // 1) shared buffer: first half for rMr, second for pAp
 7478:    __shared__ double sdata[2*BLOCK_SIZE];
 7479:    double* s_rMr = sdata;
 7480:    double* s_pAp = sdata + BLOCK_SIZE;
 7481: 
 7482:    const int tid = threadIdx.x;
 7483: 
 7484:    double l_pAp = 0.0;
 7485: 
 7486:    s_rMr[tid] = 0.0;
 7487:    s_pAp[tid] = 0.0;
 7488: 
 7489:    // 2) get your node pointer
 7490:    // NODE(node);   
 7491:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7492:    Node *node = &(mesh->localNodeData[idx_node]); 
 7493:       if (idx_node < mesh->np) {
 7494: 
 7495:       const double diag = node->coeffDiag;
 7496:       const double r    = node->mR;
 7497:       const double p    = node->mP;  
 7498: 
 7499:       // apply preconditioner on the fly:
 7500:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7501: 
 7502:       // 4) compute Ap = A.p
 7503:       double Ap = node->coeffDiag * node->mP;
 7504:       for (int j = 0; j < node->numNodes; ++j) {
 7505:          const Node *nbNode = node->nodes[j];
 7506:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7507: 
 7508:       }
 7509: 
 7510:       node->mAp = Ap;
 7511:       
 7512: 
 7513:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7514:       // const double l_rMr = r*Mr;  // r'Mr
 7515:       l_pAp = p*Ap;  // p'Ap
 7516: 
 7517: 
 7518:    }
 7519: 
 7520:    // 6) write into shared mem
 7521:    // s_rMr[tid] = l_rMr;
 7522:    s_pAp[tid] = l_pAp;
 7523: 
 7524:    __syncthreads();
 7525: 
 7526:    // 7) block-wide tree reduction
 7527:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7528:       if (tid < stride)  {
 7529:          s_pAp[tid] += s_pAp[tid + stride];
 7530:       }
 7531:       __syncthreads();
 7532:    }
 7533: 
 7534:    // 8) thread 0 atomically accumulates into the globals
 7535:    // XXX: This is slower than it needs to be, but it is simple and works
 7536:    if (tid == 0) {
 7537:       atomicAdd(pAp, s_pAp[0]);
 7538:    }
 7539: 
 7540: 
 7541: }
 7542: 
 7543: 
 7544: __global__ void updateSolutionAndDotProducts(void) {
 7545:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7546: 
 7547:    const int tid = threadIdx.x;
 7548: 
 7549:    s_rMr[tid] = 0.0;
 7550: 
 7551:    // get node & bounds-check:
 7552:    NODE(node);
 7553: 
 7554:    
 7555:    // Compute alpha
 7556:    const double alpha = (*rMr_old)/(*pAp); 
 7557: 
 7558: 
 7559:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7560: 
 7561: 
 7562:    // load scalars
 7563:    const double diag = node->coeffDiag;
 7564:    const double p    = node->mP;
 7565:    const double Ap   = node->mAp;
 7566:    const double x    = node->mX;
 7567:    const double r    = node->mR;
 7568:    
 7569:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7570: 
 7571:    // 1) update solution & residual
 7572:    const double x_new = x + alpha*p;
 7573:    const double r_new = r - alpha*Ap;
 7574:    node->mX = x_new;
 7575:    node->mR = r_new;
 7576: 
 7577:    // 2) apply Jacobi preconditioner on the fly
 7578:    const double Mr_new = r_new/diag;
 7579: 
 7580: 
 7581:    // 3) local contributions for the two dot-products
 7582:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7583: 
 7584:    // 4) write into shared-mem
 7585:    s_rMr[tid] = l_rMr;
 7586: 
 7587:    __syncthreads();
 7588: 
 7589: 
 7590:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7591:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7592:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7593:       __syncthreads();
 7594:    }
 7595: 
 7596:    // 6) thread 0 atomically folds into the global accumulators
 7597:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7598: 
 7599: 
 7600: }
 7601: 
 7602: 
 7603: __global__ void updateSearchDirection() {
 7604: 
 7605:     NODE(node);
 7606: 
 7607:     // recompute z on-the-fly
 7608:     const double z = node->mR / node->coeffDiag;
 7609:     const double p = node->mP;
 7610: 
 7611:     const double beta = (*rMr_new)/(*rMr_old);
 7612: 
 7613: 
 7614:     // p =z + beta*p
 7615:     node->mP = z + beta*p;
 7616: 
 7617: }
 7618: 
 7619: __global__ void initializeScalars(double *scalars) {
 7620: 
 7621:    // These point to a cupy array in the host code
 7622:    rMr_old = scalars + 0;
 7623:    rMr_new = scalars + 1;
 7624:    pAp     = scalars + 2;
 7625: }
 7626: 
 7627: __global__ void initializePreconditionedResidual(void) {
 7628: 
 7629:     __shared__ double s_rMr[BLOCK_SIZE];  
 7630: 
 7631:     s_rMr[threadIdx.x] = 0.0;
 7632: 
 7633:     NODE_ALL(node, valid);
 7634:     const int tid = threadIdx.x;
 7635:     // For the first iteration:
 7636:     // 1. Initial solution x = 0 (already set)
 7637:     // 2. Initial residual r = b (stored in qel)
 7638:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7639: 
 7640: // XXX we should use the guess solution here    
 7641: 
 7642:     double l_rMr = 0.0;
 7643:     if (valid) {
 7644:       // Set initial residual r = b (from qel)
 7645:       node->mR = node->qel;
 7646: 
 7647:       // Compute z = M^-1 * r (preconditioned residual)
 7648:       const double z = node->mR / node->coeffDiag;
 7649: 
 7650:       // Set initial search direction p = z
 7651:       node->mP = z;
 7652: 
 7653:       // Initialize other variables needed for CG
 7654:       node->mX = 0.0;  // Initial solution
 7655:       node->mAp = 0.0; // Will be computed in first iteration
 7656: 
 7657: 
 7658:       // Computes the first r'Mr (reduction)
 7659:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7660:     }
 7661:     // 4) write into shared-mem
 7662:     s_rMr[tid] = l_rMr;
 7663: 
 7664:     __syncthreads();
 7665: 
 7666: 
 7667:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7668:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7669:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7670:         __syncthreads();
 7671:     }
 7672: 
 7673:     // 6) thread 0 atomically folds into the global accumulators
 7674:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7675: 
 7676:     *rMr_old = 0.0;
 7677:     *pAp = 0.0;
 7678: }
 7679: 
 7680: 
