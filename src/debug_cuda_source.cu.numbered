 8644: extern "C" __global__ void getNodeVarAddr(int varCode, void **addr, int *offset, int *sizeNode, int *sizeType) {
 8645:    Node *nodes = mesh->localNodeData;
 8646: 
 8647:    *addr = nodes;
 8648:    *sizeNode = sizeof(Node);
 8649: 
 8650:    switch (varCode) {
 8651:       case (int)VarCode::depth:
 8652:          *offset = (int)((char*)&nodes[0].depth - (char*)nodes);
 8653:          *sizeType = sizeof(double);
 8654:          break;
 8655:       case (int)VarCode::eta:
 8656:          *offset = (int)((char*)&nodes[0].eta2 - (char*)nodes);
 8657:          *sizeType = sizeof(double);
 8658:          break;
 8659:       case (int)VarCode::x:
 8660:          *offset = (int)((char*)&nodes[0].p.x - (char*)nodes);
 8661:          *sizeType = sizeof(Vector2);
 8662:          break;
 8663:       case (int)VarCode::z:
 8664:          *offset = (int)((char*)&nodes[0].z - (char*)nodes);
 8665:          *sizeType = sizeof(double);
 8666:          break;
 8667:       case (int)VarCode::kb:
 8668:          *offset = (int)((char*)&nodes[0].kb - (char*)nodes);
 8669:          *sizeType = sizeof(int);
 8670:          break;
 8671:       case (int)VarCode::isdry:
 8672:          *offset = (int)((char*)&nodes[0].isDry - (char*)nodes);
 8673:          *sizeType = sizeof(int);
 8674:          break;         
 8675:       case (int)VarCode::w:
 8676:          *offset = (int)((char*)&nodes[0].w2 - (char*)nodes);
 8677:          *sizeType = sizeof(double);
 8678:          break;
 8679:       case (int)VarCode::u:
 8680:          *offset = (int)((char*)&nodes[0].u2[0].x - (char*)nodes);
 8681:          *sizeType = sizeof(Vector2);
 8682:          break;  
 8683:       case (int)VarCode::u_air:
 8684:          *offset = (int)((char*)&nodes[0].u_air - (char*)nodes);
 8685:          *sizeType = sizeof(Vector2);
 8686:          break;
 8687:       default:
 8688:          *offset = -1;    
 8689:    }  
 8690:    
 8691: }
 8692: 
 8693: 
 8694: 
 8695: 
 8696: extern "C" __global__ void getSideBndVar(int varCode, double *var, int k = -1) {
 8697:    // Get the value of a variable from an side
 8698:    // varName is the name of the variable to get
 8699:    // var is the array to store the value
 8700:    // k is the vertical level index of the variable to get
 8701:    SIDE_BND(sideBnd);   
 8702: 
 8703:    int idx = sideBnd->side!=nullptr?sideBnd->side->idx:-1;
 8704:    if (sideBnd->segment->isLand) idx = -7;
 8705: 
 8706:    if      (varCode == (int)VarCode::idx     && k == -1)   var[idx_side_bnd] = idx;
 8707:    else if (varCode == (int)VarCode::ifltype && k == -1)   var[idx_side_bnd] = (sideBnd->segment!=nullptr)?sideBnd->segment->ifltype:-1.1;
 8708: 
 8709: }
