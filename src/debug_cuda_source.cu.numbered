 3498: 
 3499: __inline__ __device__ Vector2 SideBoundary::uth(int k) const {
 3500:    // Returns the value of the velocity at the side center
 3501:    const double w1 = getBoundaryArrayValueWeight();
 3502:    const double w2 = 1.0 - w1;
 3503:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3504:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3505: 
 3506:    return w1*n1Bnd->uth[k] + w2*n2Bnd->uth[k];
 3507: }
 3508: 
 3509: 
 3510: __inline__ __device__ double  SideBoundary::nuth(int k) const {
 3511:    // Returns the value of the normal component of the velocity at the side center
 3512:    const double w1 = getBoundaryArrayValueWeight();
 3513:    const double w2 = 1.0 - w1;
 3514:    const NodeBoundary *n1Bnd = side->n1->nodeBnd;
 3515:    const NodeBoundary *n2Bnd = side->n2->nodeBnd;
 3516: 
 3517:    return w1*n1Bnd->uth[k].x + w2*n2Bnd->uth[k].x;
 3518: }
