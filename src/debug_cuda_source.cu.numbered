 3802:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 3803: 
 3804:       NODE_BND(nodeBnd);
 3805: 
 3806:       Node *node = nodeBnd->node;
 3807: 
 3808:       node->ETP = 0.0;
 3809: 
 3810:       for (int j=0; j<ntip; j++) {
 3811: 
 3812:          const double ncyc = int(tfreq[j]*time/(2.0*pi));
 3813:          const double arg = tfreq[j]*time - ncyc*2.0*pi + jspc[j]*node->lon + tear[j];
 3814:          node->ETP += 0.69*ramp*tamp[j]*tnf[j]*node->fun_lat[jspc[j]]*cos(arg);
 3815: 
 3816:          if constexpr(iloadtide==1) { // loading tide
 3817:             assert(false && "Loading tide not implemented");
 3818:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 3819:          }
 3820:          
 3821:       }
 3822:       
 3823:    }
