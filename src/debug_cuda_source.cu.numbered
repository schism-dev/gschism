 2071: __device__ __inline__ double min3(double a, double b, double c) {
 2072:    return min(a, min(b, c));
 2073: }
 2074: 
 2075: __device__ __inline__ double max3(double a, double b, double c) {
 2076:    return max(a, max(b, c));
 2077: }
 2078: 
 2079: __device__ __inline__ double min4(double a, double b, double c, double d) {
 2080:    return min(a, min(b, min(c, d)));
 2081: }
