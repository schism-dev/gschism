  634:    __inline__ __device__ bool containsPoint(Vector2 &xt, bool fixCoords) const { 
  635:       // Check if the point (xt,yt) is inside the element
  636:       double shpCoords[4];
  637: 
  638:       Vector2 tmp_xt = xt;
  639:       bool res = computeShapeCoords(tmp_xt, shpCoords, fixCoords);
  640: 
  641:       if (fixCoords && res) xt = tmp_xt;
