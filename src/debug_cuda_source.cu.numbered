 3382: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 3383:                 double *node_coords, double *node_coords_ll, bool use_ll,
 3384:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 3385:                 int *isdel, int *isidenode, int *isbnd,
 3386:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 3387:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3388:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3389:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3390:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3391:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 3392:                 double *drag, double *roughness,
 3393:                 double *emo, double *efa, 
 3394:                 double *umo, double *ufa, 
 3395:                 double *vmo, double *vfa) {
 3396: 
 3397:    // printf("Populating mesh for partition %d\n", partNum);
 3398: 
 3399:    // XXXXXX THIS function does almost nothing. 
