  880: 
  881: struct Side {
  882: 
  883:    // Geometry information
  884:    int idx;               // Index of the side
  885:    Node *n1, *n2;
  886:    Element *elems[2];     // Elements that share this side XXX (why not e1,e2?)
  887: 
  888:    double len;         // Length of the side. Used to be called distj; but I think this name is less clear now.
  889:    Vector2 center;        // Location of side center. 
  890:    double zc[nvrt];       // Side center z-coord at each vertical level
  891: 
  892:    Frame frame;
  893: 
  894:    SideBoundary *sideBnd; // Pointer to additional boundary information. For non-boundary sides, 
  895:                           // this is nullptr
  896:    
  897:    int kb;                // Bottom index of the side
  898:    bool isDry;             // True if the side is dry
  899:  
  900:    Vector2 n;             // Side unit normal vector (for ics=2: these are done inside local lon/lat frame)
  901: 
  902:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
  903: 
  904:    // Physical information
  905:    Vector2 u2[nvrt];            // Unit normal vector (for ics=2: these are done inside local lon/lat frame)
  906:    double  w2[nvrt];            // Vertical velocity at each vertical level
  907:    Vector2 btu[nvrt];           // Back-tracked velocity
  908:    Vector2 U;                   // Vertically averaged velocity vector  
  909: 
  910:    Vector2 nuGradU[nvrt];          // nu*grad u
  911: 
  912:    Vector2 bcc[nvrt];           // Baroclinic term
  913:    Vector2 bcc_TDz[nvrt];       // Baroclinic term at previous timestep
  914: 
  915:    Vector2 gradEta1;             // Gradient of elevation at previous timestep
  916:    Vector2 gradEta2;             // Gradient of elevation at current timestep
  917:    Vector2 gradPr;               // Gradient of pressure
  918:    Vector2 gradETP;              // Gradient of Earth Tidal Potential
  919: 
  920: 
  921:    double hhat;                 // \breve{H} in notes
  922: 
  923:    double shapiro;
  924: 
  925:    double flux_adv_hface[nvrt]; // Flux of horizontal advection at each vertical level
  926: 
  927:    double coriolis;             // Coriolis parameter
  928: 
  929:    // Vegetation parameters
  930:    double veg_c2;
  931:    double veg_beta;
  932: 
  933:    // Bottom drag parameters.
  934:    double chi;
  935:    double chi2;
  936: 
  937:    __inline__ __device__ double x(double t) const;
  938:    __inline__ __device__ double y(double t) const;
  939:    __inline__ __device__ Point2 p_t(double t) const;
  940: 
  941:    __inline__ __device__ Point3 center3D(int k) const { return {center.x, center.y, zc[k]}; }
  942:    __inline__ __device__ Point2 point(double t) const { return {x(t), y(t)}; }
  943:    __inline__ __device__ double Dz(int k)       const { return zc[k] - zc[k-1]; }
  944:    __inline__ __device__ double area(int k)     const { return len*Dz(k + 1); }
  945: 
  946:    __inline__ __device__ Side* neigh(int index) const { 
  947:       // Each internal side has 4 neighbors, they are the closest sides to each of the two elements that share this side
  948:       assert(index >= 0 && index < 4); 
  949:       assert(elems[0] != nullptr && elems[1] != nullptr);
  950: 
  951:       const int ielem = index & 1;           // 0 or 1
  952:       const int iside = 2*(index >> 1) - 1;  // -1 or 1
  953: 
  954:       const Element* elem = elems[ielem];
  955: 
  956:       const int locSideIdx = elem->sideLocalIdx(this); // Local index of this side in the element
  957: 
  958:       return elem->sides[elem->nxq(locSideIdx + iside)];
  959: 
  960:    }
  961: 
  962:    __device__ Vector2 grad2(double Node::* field, bool (*condition)(const Element*)) const;
  963: 
  964:    __forceinline__ __device__ Vector2 t(void) const { return {-n.y, n.x}; } // Tangent vector
  965: 
  966:    __inline__ __device__ bool isBnd(void) const { return sideBnd != nullptr; } // True if the side is a boundary side
  967:    __inline__ __device__ bool isInternal(void) const { return elems[1] != nullptr; } // Internal side
  968:    __inline__ __device__ int iadv(void) const;
  969: 
  970:    __inline__ __device__ double grav3(void) const;
  971:    
  972:    __inline__ __device__ double eta2(void) const;
  973:    __inline__ __device__ double eta1(void) const;
  974:    __inline__ __device__ double depth(void) const;
  975:    __inline__ __device__ double htot2(void) const { return eta2() + depth(); }
  976:    __inline__ __device__ double htot1(void) const { return zc[nvrt - 1] - zc[kb]; }
  977: 
  978:    __inline__ __device__ double dfv(int k) const;
  979: 
  980:    __inline__ __device__ double veg_h(void)  const;
  981:    __inline__ __device__ double veg_nv(void) const;
  982:    __inline__ __device__ double veg_alpha_vert_mean(void) const;
  983:    __inline__ __device__ double veg_alpha3D(int k) const;
  984:    __inline__ __device__ double veg_c(void)  const { return veg_c2/(1.0 + veg_c2); }
  985: 
  986:    __inline__ __device__ double Cd(void) const;
  987: 
  988:    __inline__ __device__ Vector2 tau(void) const;
  989: 
  990:    __inline__ __device__ double zb(void) const { return zc[kb]; }
  991:    
  992: 
  993:    __inline__ __device__ double zTopCanopy(void) const { return zc[kb] + veg_h(); } 
  994:    __inline__ __device__ double zLevelVegRatio(int k) const { 
  995:       // Ratio ocupied by the vegetation at vertical level k. It is 1.0 if the canopy is fully above the level k and 0.0 if it is fully below the level k
  996:       return max(0.0, min(1.0, (zTopCanopy() - zc[k-1])/Dz(k))); 
  997:    } 
  998:    __inline__ __device__ bool hasVegetation(int k) const { return zTopCanopy() > zc[k]; }
  999:    __inline__ __device__ bool isSubmerged(void)    const { return veg_h() < 0.99*htot2(); }
 1000:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
 1001:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
 1002: 
 1003:    // Get valid starting element (for backtracking)
 1004:    __inline__ __device__ Element* getStartElement() {
 1005:       return elems[0] ? elems[0] : elems[1];
 1006:    }
 1007: 
 1008:    __inline__ __device__ Element* findElementTowards(Vector2 u) const {
 1009:       // From the elements that share this side, find the one that is in the direction of the target point (xt,yt)
 1010: 
 1011:       assert(elems[0] != nullptr && "elems[0] is nullptr in findElementTowards");
 1012: 
 1013:       // Dot product of the negative velocity vector with the side normal vector
 1014:       const double dot_prod1 = -dot(u, n);
 1015: 
 1016:       // Vector from side center to element 0 centroid
 1017:       const Vector2 v2 = toVector2(elems[0]->center) - center;
 1018: 
 1019:       // Dot product of the vector with the side normal vector
 1020:       const double dot_prod2 = dot(v2, n);
 1021: 
 1022:       // If the dot product is positive, returns the element whose vector to the centroid is in the same direction as the target point
 1023:       // Otherwise, returns the other element (otherwise includes dot_prod1 == 0)
 1024: 
 1025:       if (dot_prod1*dot_prod2 > 0.0) return elems[0];
 1026:       else                           return elems[1];
 1027: 
 1028:  
 1029:    }
 1030: 
 1031:    __forceinline__ __device__ Element* otherElem(const Element* elem) const {
 1032:       // Given an element, returns the other element that shares this side
 1033:       return (elems[0] == elem) ? elems[1] : elems[0];
 1034:    }
 1035: 
 1036:    __forceinline__ __device__ Node* otherNode(Node* node) {
 1037:       // Given a node, returns the other node that shares this side
 1038:       return (n1 == node) ? n2 : n1;
 1039:    }
 1040:  
 1041:    __inline__ __device__ bool btrack(int jlev, double dt, double dtbk, Vector3 &u_int) const;
 1042: 
 1043: 
 1044: 
 1045: 
 1046: };
 1047: 
