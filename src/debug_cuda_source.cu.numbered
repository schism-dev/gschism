 7380: 
 7381: __global__ void computeMatrixProductAndDotProducts() {
 7382:    // Computes A*p, r'Mr and p'Ap
 7383: 
 7384:    // 1) shared buffer: first half for rMr, second for pAp
 7385:    __shared__ double sdata[2*BLOCK_SIZE];
 7386:    double* s_rMr = sdata;
 7387:    double* s_pAp = sdata + BLOCK_SIZE;
 7388: 
 7389:    const int tid = threadIdx.x;
 7390: 
 7391:    double l_pAp = 0.0;
 7392: 
 7393:    s_rMr[tid] = 0.0;
 7394:    s_pAp[tid] = 0.0;
 7395: 
 7396:    // 2) get your node pointer
 7397:    // NODE(node);   
 7398:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7399:    Node *node = &(mesh->localNodeData[idx_node]); 
 7400:    if (idx_node < mesh->np) {
 7401: 
 7402: 
 7403:    const double diag = node->coeffDiag;
 7404:    const double r    = node->mR;
 7405:    const double p    = node->mP;  
 7406: 
 7407:    // apply preconditioner on the fly:
 7408:    // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7409: 
 7410:    // 4) compute Ap = A.p
 7411:    double Ap = node->coeffDiag * node->mP;
 7412:    for (int j = 0; j < node->numNodes; ++j) {
 7413:       const Node *nbNode = node->nodes[j];
 7414:       Ap += node->coeffMatrix[j] * nbNode->mP;
 7415: 
 7416:    }
 7417: 
 7418:    node->mAp = Ap;
 7419:     
 7420: 
 7421:    // 5) dot-products individual products (r'Mr, p'Ap) (REDUCTION)
 7422:    // const double l_rMr = r*Mr;  // r'Mr
 7423:    l_pAp = p*Ap;  // p'Ap
 7424: 
 7425: 
 7426:    }
 7427: 
 7428:    // 6) write into shared mem
 7429:    // s_rMr[tid] = l_rMr;
 7430:    s_pAp[tid] = l_pAp;
 7431: 
 7432:    __syncthreads();
 7433: 
 7434:    // 7) block-wide tree reduction
 7435:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7436:       if (tid < stride)  {
 7437:          s_pAp[tid] += s_pAp[tid + stride];
 7438:       }
 7439:       __syncthreads();
 7440:    }
 7441: 
 7442:    // 8) thread 0 atomically accumulates into the globals
 7443:    // XXX: This is slower than it needs to be, but it is simple and works
 7444:    if (tid == 0) {
 7445:       atomicAdd(pAp, s_pAp[0]);
 7446:    }
 7447: 
 7448: 
 7449: }
 7450: 
 7451: 
 7452: __global__ void updateSolutionAndDotProducts(void) {
 7453:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7454: 
 7455:    const int tid = threadIdx.x;
 7456: 
 7457:    s_rMr[tid] = 0.0;
 7458: 
 7459:    // get node & bounds-check:
 7460:    NODE(node);
 7461: 
 7462:    
 7463:    // Compute alpha
 7464:    const double alpha = (*rMr_old)/(*pAp);
 7465: 
 7466:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7467: 
 7468: 
 7469:    // load scalars
 7470:    const double diag = node->coeffDiag;
 7471:    const double p    = node->mP;
 7472:    const double Ap   = node->mAp;
 7473:    const double x    = node->mX;
 7474:    const double r    = node->mR;
 7475:    
 7476:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7477: 
 7478:    // 1) update solution & residual
 7479:    const double x_new = x + alpha*p;
 7480:    const double r_new = r - alpha*Ap;
 7481:    node->mX = x_new;
 7482:    node->mR = r_new;
 7483: 
 7484:    // 2) apply Jacobi preconditioner on the fly
 7485:    const double Mr_new = r_new/diag;
 7486: 
 7487: 
 7488:    // 3) local contributions for the two dot-products
 7489:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7490: 
 7491:    // 4) write into shared-mem
 7492:    s_rMr[tid] = l_rMr;
 7493: 
 7494:    __syncthreads();
 7495: 
 7496: 
 7497:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7498:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7499:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7500:       __syncthreads();
 7501:    }
 7502: 
 7503:    // 6) thread 0 atomically folds into the global accumulators
 7504:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7505: 
 7506: 
 7507: }
 7508: 
 7509: 
 7510: __global__ void updateSearchDirection() {
 7511: 
 7512:     NODE(node);
 7513: 
 7514:     // recompute z on-the-fly
 7515:     const double z = node->mR / node->coeffDiag;
 7516:     const double p = node->mP;
 7517: 
 7518:     const double beta = (*rMr_new)/(*rMr_old);
 7519: 
 7520: 
 7521:     // p =z + beta*p
 7522:     node->mP = z + beta*p;
 7523: 
 7524: }
 7525: 
 7526: __global__ void initializePreconditionedResidual(double *scalars) {
 7527: 
 7528:     extern __shared__ double s_rMr[BLOCK_SIZE];  
 7529: 
 7530:     s_rMr[threadIdx.x] = 0.0;
 7531: 
 7532:     NODE(node);
 7533:     const int tid = threadIdx.x;
 7534:     // For the first iteration:
 7535:     // 1. Initial solution x = 0 (already set)
 7536:     // 2. Initial residual r = b (stored in qel)
 7537:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7538: 
 7539: // XXX we should use the guess solution here    
 7540: 
 7541:     // Set initial residual r = b (from qel)
 7542:     node->mR = node->qel;
 7543: 
 7544:     // Compute z = M^-1 * r (preconditioned residual)
 7545:     const double z = node->mR / node->coeffDiag;
 7546: 
 7547:     // Set initial search direction p = z
 7548:     node->mP = z;
 7549: 
 7550:     // Initialize other variables needed for CG
 7551:     node->mX = 0.0;  // Initial solution
 7552:     node->mAp = 0.0; // Will be computed in first iteration
 7553: 
 7554:     // These point to a cupy array in the host code
 7555:     rMr_old = scalars + 0;
 7556:     rMr_new = scalars + 1;
 7557:     pAp     = scalars + 2;
 7558: 
 7559:     // Computes the first r'Mr (reduction)
 7560:     const double l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7561: 
 7562:     // 4) write into shared-mem
 7563:     s_rMr[tid] = l_rMr;
 7564: 
 7565:     __syncthreads();
 7566: 
 7567: 
 7568:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7569:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7570:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7571:         __syncthreads();
 7572:     }
 7573: 
 7574:     // 6) thread 0 atomically folds into the global accumulators
 7575:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7576: 
 7577:     *rMr_old = 0.0;
 7578:     *pAp = 0.0;
 7579: }
 7580: 
 7581: 
 7582: 
 7583: 
 7584: extern "C" __global__ void getElementVar(int varCode, double *var, int k = -1, int j = -1) {
 7585:    // Get the value of a variable from an element
 7586:    // varName is the name of the variable to get
 7587:    // var is the array to store the value
 7588:    // k is the vertical level index of the variable to get
 7589: 
 7590:    ELEM(elem);
 7591:    
 7592:    int idx = elem->idx;
 7593:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7594: 
 7595:    // printf("getElementVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7596:    if      (varCode == (int)VarCode::w && k >= 0)       var[idx] = elem->w[k];
 7597:    else if (varCode == (int)VarCode::z && k >= 0)       var[idx] = elem->z[k];
 7598:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = elem->center.x;
 7599:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = elem->center.y;
 7600:    else if (varCode == (int)VarCode::area && k == -1)   var[idx] = elem->area;
 7601:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = elem->depth;
 7602:    else if (varCode == (int)VarCode::radius && k == -1) var[idx] = elem->radius;
 7603:    else if (varCode == (int)VarCode::xlon && k == -1)   var[idx] = elem->xlon;
 7604:    else if (varCode == (int)VarCode::ylat && k == -1)   var[idx] = elem->ylat;
 7605:    else if (varCode == (int)VarCode::ghatx && k == -1)  var[idx] = elem->ghat1.x;
 7606:    else if (varCode == (int)VarCode::ghaty && k == -1)  var[idx] = elem->ghat1.y;
 7607:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(elem->kb);
 7608:    else if (varCode == (int)VarCode::ssign && k == -1 && j > -1)  var[idx] = (double)(elem->ssign[j]);
 7609:    else if (i==0) printf("getElementVar: varCode = %d, k = %d not found\n", varCode, k);
 7610:       
 7611:    
 7612: }
 7613: 
 7614: 
 7615: extern "C" __global__ void getNodeVar(int varCode, double *var, int k = -1) {
 7616:    // Get the value of a variable from an node
 7617:    // varName is the name of the variable to get
 7618:    // var is the array to store the value
 7619:    // k is the vertical level index of the variable to get
 7620: 
 7621:    NODE(node);
 7622:    
 7623:    int idx = node->idx;
 7624:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7625: 
 7626:    // printf("getNodeVar: varCode = %d, k = %d, idx = %d, i = %d\n", varCode, k, idx, i);
 7627:    
 7628:    if      (varCode == (int)VarCode::z && k >= 0)       var[idx] = node->z[k];
 7629:    else if (varCode == (int)VarCode::x && k == -1)      var[idx] = node->p.x;
 7630:    else if (varCode == (int)VarCode::y && k == -1)      var[idx] = node->p.y;
 7631:    else if (varCode == (int)VarCode::depth && k == -1)  var[idx] = node->depth;
 7632:    else if (varCode == (int)VarCode::htot && k == -1)   var[idx] = node->htot2();
 7633:    else if (varCode == (int)VarCode::kb && k == -1)     var[idx] = (double)(node->kb);
 7634:    else if (varCode == (int)VarCode::elbc && k == -1)   var[idx] = node->nodeBnd!=nullptr?node->nodeBnd->elbc:0.0;
 7635:    else if (varCode == (int)VarCode::eta && k == -1)    var[idx] = node->eta2;   
 7636:    else if (varCode == (int)VarCode::qel && k == -1)    var[idx] = node->qel;
 7637:    else if (varCode == (int)VarCode::u && k >= 0)       var[idx] = node->u2[k].x;
 7638:    else if (varCode == (int)VarCode::v && k >= 0)       var[idx] = node->u2[k].y;
 7639:    else if (varCode == (int)VarCode::w && k >= 0)       var[idx] = node->u2[k].z;
 7640:    
 7641:    else if (i==0) printf("getNodeVar: varCode = %d, k = %d not found\n", varCode, k);
 7642:       
 7643:    
 7644: }
 7645: 
 7646: 
 7647: extern "C" __global__ void getSideVar(int varCode, double *var, int k = -1) {
 7648:    // Get the value of a variable from an side
 7649:    // varName is the name of the variable to get
 7650:    // var is the array to store the value
 7651:    // k is the vertical level index of the variable to get
 7652:    SIDE(side);
 7653:    
 7654:    int idx = side->idx;
 7655:    int i = threadIdx.x + blockIdx.x * blockDim.x;
 7656: 
 7657:    if      (varCode == (int)VarCode::z && k >= 0)        var[idx] = side->zc[k];
 7658:    else if (varCode == (int)VarCode::x && k == -1)       var[idx] = side->center.x;
 7659:    else if (varCode == (int)VarCode::y && k == -1)       var[idx] = side->center.y;
 7660:    else if (varCode == (int)VarCode::nx && k == -1)      var[idx] = side->n.x;
 7661:    else if (varCode == (int)VarCode::ny && k == -1)      var[idx] = side->n.y;
 7662:    else if (varCode == (int)VarCode::u && k >= 0)        var[idx] = side->u2[k].x;
 7663:    else if (varCode == (int)VarCode::v && k >= 0)        var[idx] = side->u2[k].y;
 7664:    else if (varCode == (int)VarCode::U && k == -1)       var[idx] = side->U.x;
 7665:    else if (varCode == (int)VarCode::V && k == -1)       var[idx] = side->U.y;   
 7666:    else if (varCode == (int)VarCode::depth && k == -1)   var[idx] = side->depth();
 7667:    else if (varCode == (int)VarCode::kb && k == -1)      var[idx] = (double)(side->kb);
 7668:    else if (varCode == (int)VarCode::n1 && k == -1)      var[idx] = side->n1->idx;
 7669:    else if (varCode == (int)VarCode::n2 && k == -1)      var[idx] = side->n2->idx;
 7670:    else if (varCode == (int)VarCode::eta && k == -1)     var[idx] = side->eta2();
 7671:    else if (varCode == (int)VarCode::btu && k >= 0)      var[idx] = side->btu[k].x;
 7672:    else if (varCode == (int)VarCode::btv && k >= 0)      var[idx] = side->btu[k].y;
 7673:    else if (varCode == (int)VarCode::bccx && k >= 0)     var[idx] = side->bcc[k].x;
 7674:    else if (varCode == (int)VarCode::bccy && k >= 0)     var[idx] = side->bcc[k].y;
 7675:    else if (varCode == (int)VarCode::ubc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].x:0.0;
 7676:    else if (varCode == (int)VarCode::vbc && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->ubc[k].y:0.0;
 7677:    else if (varCode == (int)VarCode::uth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).x:0.0;
 7678:    else if (varCode == (int)VarCode::vth && k >= 0)      var[idx] = side->sideBnd!=nullptr?side->sideBnd->uth(k).y:0.0;
 7679:    else if (varCode == (int)VarCode::ifltype && k == -1) var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->ifltype:0.0;
 7680:    else if (varCode == (int)VarCode::island && k == -1)  var[idx] = side->sideBnd!=nullptr?side->sideBnd->segment->isLand:0.0;
 7681:    else if (varCode == (int)VarCode::hhat && k == -1)    var[idx] = side->hhat;
 7682:    else if (varCode == (int)VarCode::gradEta1x   && k == -1)    var[idx] = side->gradEta1.x;
 7683:    else if (varCode == (int)VarCode::gradEta1y   && k == -1)    var[idx] = side->gradEta1.y;
 7684:    else if (varCode == (int)VarCode::gradEta2x   && k == -1)    var[idx] = side->gradEta2.x;
 7685:    else if (varCode == (int)VarCode::gradEta2y   && k == -1)    var[idx] = side->gradEta2.y;
 7686:    else if (varCode == (int)VarCode::gradETPx   && k == -1)    var[idx] = side->gradETP.x;
 7687:    else if (varCode == (int)VarCode::gradETPy   && k == -1)    var[idx] = side->gradETP.y;
 7688:    else if (varCode == (int)VarCode::gradPrx   && k == -1)    var[idx] = side->gradPr.x;
 7689:    else if (varCode == (int)VarCode::gradPry   && k == -1)    var[idx] = side->gradPr.y;
 7690:    else if (i==0) printf("getSideVar: varCode = %d, k = %d not found\n", varCode, k);
 7691: }
