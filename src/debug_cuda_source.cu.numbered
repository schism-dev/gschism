 5272:    __global__ void resetBoundaryAreas(void) {
 5273:       // Reset boundary areas and lengths for each segment.
 5274: 
 5275:       // This should be done per segment, not per boundary side (each segment has multiple sides),
 5276:       // However we don't have a way to access the segments by themselves and this is simple and fast enough.
 5277:       SIDE_BND(sideBnd);
 5278: 
 5279:       BoundarySegment *segment = sideBnd->segment;
 5280: 
 5281:       segment->carea = 0.0;
 5282:       segment->clen = 0.0;
 5283:  
 5284:    }
 5285: 
 5286:    __global__ void computeBoundaryAreas(void) {
 5287:    // Calculation of cross-section areas and lengths for flow b.c.
 5288: 
 5289:       SIDE_BND(sideBnd);
 5290: 
 5291:       const Side *side = sideBnd->side;
 5292:       BoundarySegment *segment = sideBnd->segment;
 5293: 
 5294:       if (segment->ifltype != 0) {
 5295: 
 5296:          const Node *n1 = side->n1;
 5297:          const Node *n2 = side->n2;
 5298: 
 5299:          const double htot = side->htot2();
 5300: 
 5301:          if (!side->isDry) {
 5302:             atomicAdd(&segment->carea, htot*side->len);
 5303:             atomicAdd(&segment->clen, side->len);
 5304:          }
 5305:       }
 5306: 
 5307:    }
 5308: 
 5309: 
 5310:    __global__ void computeFlowBcVelocities(double time) {
 5311: 
 5312:       SIDE_BND(sideBnd);
 5313: 
 5314:       const Side *side = sideBnd->side;
 5315:  
 5316:       const bool isDry = side->isDry;
 5317:       const bool isLand = sideBnd->segment->isLand;
 5318: 
 5319:    
 5320:       for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 5321: 
 5322:       if (isDry || isLand) return;
 5323: 
 5324:       // For wet sides in open boundaries...
 5325:       const Vector2 n = side->n;
 5326:       const BoundarySegment *segment = sideBnd->segment;
 5327: 
 5328:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 5329: 
 5330:       const int ifltype = segment->ifltype;
 5331: 
 5332:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 5333:       const Vector2 r_nuth0 = r_uth0*n;
 5334: 
 5335: 
 5336:       if (ifltype == 1 || ifltype == 2) {
 5337:       
 5338:          assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 5339: 
 5340:          const double unth0 = segment->qthcon*ramp/segment->carea;
 5341:          
 5342:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += unth0*n;  // This case has no ramp-up
 5343:          
 5344:       } else if (ifltype == -1) { // Flather 1
 5345: 
 5346:          for (int k = 0; k < nvrt; k++) {
 5347: 
 5348:             // uth is the normal vel.; no ramp up
 5349:             const double uth = sideBnd->nuth(k);
 5350:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 5351: 
 5352:             sideBnd->ubc[k] += uth*n;
 5353:          }
 5354: 
 5355:       } else if (ifltype == 3 || ifltype == 5) {
 5356:          // vnth0=0 !normal vel.
 5357: 
 5358:          Vector2 r_u1_bar = {0.0, 0.0};
 5359:          // Computes the contribution to the velocity from all tide frequencies
 5360:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5361: 
 5362:             const Vector2 ufa  = sideBnd->ufa(jfr); 
 5363:             const Vector2 umo  = sideBnd->umo(jfr); 
 5364: 
 5365:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5366:             const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 5367:             const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 5368:             r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 5369: 
 5370:          }
 5371: 
 5372: 
 5373:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] += r_u1_bar;
 5374: 
 5375:       } // if (ifltype = 3 || ifltype == 5
 5376: 
 5377: 
 5378: 
 5379:    }
 5380: 
 5381:    __global__ void computeElevationBoundaryConditions(double time) {
 5382:       // Compute elevation essential boundary conditions 
 5383: 
 5384:       NODE_BND(nodeBnd); // Each boundary node.
 5385: 
 5386:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 5387: 
 5388:       const Node *node = nodeBnd->node;
 5389:       const BoundarySegment *segment = nodeBnd->segment;
 5390:       const int iettype = segment->iettype;
 5391:       
 5392: 
 5393:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 5394:       double eic = 0.0;
 5395:       if (nramp_elev == 1) eic = nodeBnd->etaic;  // XXXX is etaic ever set?  
 5396:       else                 eic = 0.0;
 5397: 
 5398:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 5399:       const double r_eth = ramp*nodeBnd->eth;
 5400:       double r_eta1_bar = 0.0;
 5401: 
 5402:       // Compute tide elevation
 5403:       if (iettype == 3 || iettype == 5) {   
 5404: 
 5405:          if constexpr(iloadtide==1) { // loading tide
 5406:             assert(false && "Loading tide not implemented");
 5407:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5408:          }
 5409:          
 5410:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 5411: 
 5412:             const double efa  = nodeBnd->efa[jfr]; 
 5413:             const double emo  = nodeBnd->emo[jfr]; 
 5414: 
 5415:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 5416:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 5417:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 5418: 
 5419: 
 5420:          } // for jfr
 5421: 
 5422:       } // if iettype
 5423: 
 5424:       switch (iettype) {
 5425:          case 1:
 5426:          case 2:
 5427:          case 4:
 5428:             nodeBnd->elbc = r_eic + r_eth;
 5429:             break;
 5430:          case 3:
 5431:             nodeBnd->elbc = r_eic + r_eta1_bar;
 5432:             break;
 5433:          case 5:
 5434:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 5435:             break;
 5436:       } // switch
 5437: 
 5438: 
 5439:       //Add inverse barometric effects
 5440:       if (iettype != 0 && inv_atm_bnd == 1) {
 5441:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 5442:       }
 5443: 
 5444:    }
 5445: 
 5446: 
 5447:    __global__ void computeHorizontalViscosity(void) { 
 5448: 
 5449:       assert(ihorcon == 0 || ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 5450: 
 5451:       SIDE(side);
 5452: 
 5453:       if (side->isDry) return;
 5454: 
 5455:       for (int k = 0; k < nvrt; k++) {
 5456:          side->nuGradU[k] = {0.0, 0.0};
 5457:       }
 5458: 
 5459:       if constexpr(ihorcon == 1) {
 5460:          for (int k = side->kb; k < nvrt - 1; k++) {
 5461:             // Computes the Laplacian by using the simplified formula presented in the paper:
 5462:             // SELFE: A semi-implicit Eulerian-Lagrangian finite-element model for cross-scale ocean circulation
 5463:             // By Zhang and Baptista.
 5464: 
 5465:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 5466:             // This is a standard discretization of the Laplacian operator.
 5467:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 5468:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 5469:             // Gamma is hvis_coef0 in the code.
 5470:             // The value of gamma needs to be < 0.5.
 5471: 
 5472:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 5473:             // side under consideration in each of the two possible elements that share the side.
 5474:             Vector2 sumU = {0.0, 0.0};
 5475:             for (int l = 0; l < 2; l++) {
 5476:                const Element *elem = side->elems[l];
 5477: 
 5478:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 5479: 
 5480:                // Find the local index of the side in the element
 5481:                const int idxSide = elem->sideLocalIdx(side);
 5482: 
 5483:                // Find the two sides that are connected to the side under consideration
 5484:                const Side *s1 = elem->sides[elem->nxq(idxSide + 1)];
 5485:                const Side *s2 = elem->sides[elem->nxq(idxSide - 1)];
 5486: 
 5487:                sumU += s1->u2[k] + s2->u2[k] - 2*side->u2[k];   // XXXX Is this correct?
 5488: 
 5489:             }
 5490: 
 5491:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 5492: 
 5493:             assert(false && "computeHorizontalViscosity: Check if the above is correct");
 5494:    
 5495:          }
 5496:       }
 5497:       else if constexpr(ihorcon == 2) {
 5498:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 5499:       }
 5500: 
 5501: 
 5502:    }
 5503: 
 5504: 
 5505:    __global__ void setEssentialBC(void) {  // XXXXXXX CONVERT TO NODE_BND????????
 5506: 
 5507:       // Set essential boundary conditions 
 5508:       NODE(node); // Each boundary node
 5509:       NodeBoundary *nodeBnd = node->nodeBnd;
 5510:       
 5511:  
 5512:       // Check if this node has essential BC
 5513:       if (nodeBnd && nodeBnd->isEssentialBC) {
 5514:          // Verify BC value is valid
 5515:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5516: 
 5517:        
 5518:          // Set diagonal to 1 and zero off-diagonals
 5519:          node->coeffDiag = 1.0;
 5520: 
 5521:          for (int j = 0; j < node->numNodes; j++) {
 5522:                node->coeffMatrix[j] = 0.0;
 5523:          }
 5524:          
 5525:          // Set solution and RHS to BC value
 5526:          node->mX  = nodeBnd->elbc;
 5527:          node->qel = nodeBnd->elbc;
 5528: 
 5529:       } else {
 5530:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 5531: 
 5532:          for (int j = 0; j < node->numNodes; j++) {
 5533:                Node* nbNode = node->nodes[j];
 5534:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 5535:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 5536:                   // Verify neighbor's BC value
 5537:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 5538: 
 5539:                   // Subtract contribution to RHS
 5540:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 5541:                   node->coeffMatrix[j] = 0.0;  
 5542:                }
 5543:          }
 5544:       }
 5545:    }
 5546: 
 5547: 
 5548:    __global__ void updateElevation(void) {
 5549:       NODE(node);
 5550: 
 5551: 
 5552:       node->eta2 = node->mX;
 5553: 
 5554:       node->updateZCoordData();
 5555:    }
