 2208:    template<typename T>
 2209:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::*func)(int) const) const {
 2210:       T values[4];
 2211:       getNodalValues(level, func, values);
 2212: 
 2213:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2214:       if constexpr (IsVector2<T>::value && ics == 2) {
 2215: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2216:          projectNodeVectorsToElementFrame(values);
 2217: printf("interpolate 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2218:       }
 2219: 
 2220:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2221:    }
 2222: 
 2223:    template<typename T>
 2224:    __device__ __forceinline__ T Element::interpolate(const double shapeCoords[4], T Node::* field) const {
 2225:       T values[4];
 2226:       getNodalValues(field, values);
 2227: 
 2228:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2229:       if constexpr (IsVector2<T>::value && ics == 2) {
 2230: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2231:          projectNodeVectorsToElementFrame(values);
 2232: printf("interpolate 3: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2233:       }
 2234:       
 2235:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2236:    }
 2237: 
 2238: 
 2239:    template<typename T>
 2240:    __device__ __forceinline__ T Element::interpolate(int level, const double shapeCoords[4], T (Node::* field)[nvrt]) const {
 2241:       T values[4];
 2242:       getNodalValues(level, field, values);
 2243:       
 2244: if (shapeCoords[0] > 1.1 || shapeCoords[1] > 1.1 || shapeCoords[2] > 1.1 || 
 2245:     shapeCoords[0] < -0.1 || shapeCoords[1] < -0.1 || shapeCoords[2] < -0.1) printf("XXX shapeCoords = (%.17f, %.17f, %.17f, %.17f)\n", shapeCoords[0], shapeCoords[1], shapeCoords[2], shapeCoords[3]);
 2246:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2247:       if constexpr (IsVector2<T>::value && ics == 2) {
 2248: // printf("interpolate 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2249:          projectNodeVectorsToElementFrame(values);
 2250: // printf("interpolate 4: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2251:       }
 2252: 
 2253:       return shapeCoords[0]*values[0] + shapeCoords[1]*values[1] + shapeCoords[2]*values[2] + shapeCoords[3]*values[3];
 2254:    }
 2255: 
 2256:    template<typename T>
 2257:    __device__ __forceinline__ T Element::mean(T Node::* field) const {
 2258:       T values[4];
 2259:       getNodalValues(field, values);
 2260: 
 2261:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2262:       if constexpr (IsVector2<T>::value && ics == 2) {
 2263: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2264:          projectNodeVectorsToElementFrame(values);
 2265: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2266:       }
 2267: 
 2268:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2269:    }
 2270: 
 2271:    template<typename T>
 2272:    __device__ __forceinline__ T Element::mean(T Side::* field) const {
 2273:       T values[4];
 2274:       getSideValues(field, values);
 2275:       
 2276:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2277:       if constexpr (IsVector2<T>::value && ics == 2) {
 2278: // printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2279:          projectSideVectorsToElementFrame(values);
 2280: printf("mean 2: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2281:       }
 2282: 
 2283:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2284:    }   
 2285: 
 2286:    template<typename T>
 2287:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2288: 
 2289:       T values[4];
 2290: 
 2291: 
 2292:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2293:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2294:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2295:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2296:       else          values[3] = T();
 2297: 
 2298:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2299: 
 2300:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2301:    }
 2302: 
