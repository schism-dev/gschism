 1184: struct Node {
 1185: 
 1186:    // Geometry information
 1187:    int idx;        // Index of the node
 1188:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1189:    int numNodes;   // Number of nodes neighbors of this node
 1190: 
 1191:    Element **elements; // Array of pointers to the elements that share this node
 1192:    int numElements;    // Number of elements that share this node
 1193: 
 1194:    int numSides;       // Number of sides that are connected to this node
 1195: 
 1196:    Point2 p;
 1197:    Vector2 u2[nvrt];
 1198:    double  w2[nvrt];
 1199:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1200:    double z[nvrt];
 1201:    double lon, lat;
 1202:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1203:    double depth;
 1204: 
 1205:    int kb;       // Bottom index of the node
 1206: 
 1207:    bool isDry;     // True if the node is dry
 1208: 
 1209:    int iadv;     // Advection flag
 1210: 
 1211:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1212:                           // this is nullptr
 1213: 
 1214:    TempVar tmp; // Temporary variable to store different types of variables
 1215: 
 1216:    // Physical information
 1217:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1218:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1219: 
 1220:    double rho[nvrt];     // Density
 1221:    double dfv[nvrt];     // Vertical viscosity
 1222: 
 1223:    double eta1; // Elevation at nodes at previous timestep
 1224:    double eta2; // Elevation at nodes at current timestep
 1225: 
 1226:    double ETP;  // Earth Tidal Potential
 1227: 
 1228:    double pr;    // Air pressure
 1229:    double grav2; // Gravity 
 1230:    
 1231:    Vector2 dav;  // Depth averaged velocity
 1232: 
 1233:    Vector2 tau; // Wind stress vector
 1234: 
 1235:    // Vegetation parameters
 1236:    double veg_h;
 1237:    double veg_nv;
 1238:    double veg_di;
 1239:    double veg_Cd;
 1240:    double veg_h_unbent;
 1241:    double veg_di_unbent;
 1242:    double veg_nv_unbent;
 1243:    double veg_alpha_vert_mean;
 1244:    double veg_alpha0;
 1245:    double veg_alpha3D[nvrt];
 1246: 
 1247:    // Bottom drag parameters
 1248:    double Cd;       // Bottom drag coefficient   
 1249: 
 1250:    // These three are mutually exclusive
 1251:    union {
 1252:       double rmanning; // Bottom Manning's coefficient
 1253:       double rough;    // Bottom roughness length
 1254:       double drag;     // Bottom drag coefficient
 1255:    };
 1256:    Vector2 tau_bot; // Bottom stress vector
 1257: 
 1258:    double bdef1; // Bottom deformation at previous timestep
 1259:    double bdef2; // Bottom deformation at current timestep
 1260: 
 1261:    double qel; // RHS
 1262:    double coeffDiag; // Diagonal coefficient of the matrix
 1263:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1264: 
 1265:    double mP; // Search direction for conjugate gradient method
 1266:    double mR; // Residual for conjugate gradient method
 1267:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1268:    double mX; // Solution for conjugate gradient method
 1269: 
 1270:    // Meteorological forcing
 1271:    Vector2 u_air;
 1272:    double p_air;
 1273:    double t_air;
 1274:    double q_air;
 1275:    double wind_angle;  // Wind rotation angle
 1276: 
 1277:    __device__ void setWind(Vector2 &u) {
 1278:    // Sets the wind vector taking into account the wind rotation angle
 1279:    
 1280:       const double dir = atan2(-u.x,-u.y);
 1281:       const double speed = length(u);
 1282: 
 1283:       // Calculate new u and v components with added rotation angle
 1284:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1285:    }
 1286: 
 1287: 
 1288:    __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1289: 
 1290:    __device__ double sigmaTransitionDepth(void) const;
 1291: 
 1292:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1293:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1294:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1295:    
 1296:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1297: 
 1298:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1299: 
 1300:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1301:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1302: 
 1303:    __device__ __forceinline__ void clearMatrixRow(void) {
 1304:       // Clear the matrix row for this node
 1305: 
 1306: 
 1307:       coeffDiag = 0.0;
 1308: 
 1309:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1310: 
 1311:    }
 1312: 
 1313:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1314:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1315:       
 1316:       if (node == this) {
 1317:          coeffDiag += value;
 1318:      
 1319:       } else {
 1320:          // Search (linearly)the index of the node in the array of nodes
 1321:          // XXX: This is not efficient, see if we can improve this
 1322:          int i;
 1323:          for (i = 0; i < numNodes; i++) {
 1324:             if (nodes[i] == node) {
 1325:                break;
 1326:             }
 1327:          }
 1328:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1329:          coeffMatrix[i] += value;
 1330:       }
 1331:    }
 1332: 
 1333: 
 1334:    __device__ __inline__ void updateZCoordData(void);
 1335: 
 1336:    __device__ double compZCoord(int k) const;
 1337: 
 1338:    __device__ void updateKb(void);
 1339: 
 1340:    __device__ __forceinline__ void computeBottomDragCd(void);
 1341: 
 1342: 
 1343: 
 1344: };
