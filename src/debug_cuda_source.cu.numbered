 3625: __device__ __inline__ void Node::updateZCoordData(void) {
 3626: // XXX: To be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3627: 
 3628:    // assert(!isDry2() && "updateZCoordData: node is dry");
 3629:    // if (isDry2()) {
 3630:    //    kb = -1;  // XXXXXXXX KKKKK
 3631:    //    return;
 3632:    // }
 3633: 
 3634: 
 3635:    if constexpr(ivcor == 2) {  // SZ coordinates
 3636:       
 3637:       // Compute bottom level index
 3638:       if (!isDry) updateKb();  // Why is this call repeated? XXXXXXXX It is also called in ul0UpdateZCoords
 3639:    } 
 3640:    else {  // if (ivcor == 1) Localized sigma
 3641:       // Do nothing
 3642:    }
 3643: 
 3644: 
 3645: }
