 3604:    __global__ void scaleGravity(double loadtide_coef) {
 3605: 
 3606: 
 3607:       NODE(node);
 3608: 
 3609:       // SAL option: scale gravity
 3610:       if constexpr(iloadtide==2) {  // simple const
 3611:          node->grav2 = grav*(1.0 - loadtide_coef);
 3612: 
 3613:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 3614:         
 3615:           const double depth = max(node->depth, 0.0);
 3616:           const double tmp1 = sqrt(depth);
 3617:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 3618:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 3619:                              2.6969e-13*depth*depth*depth*tmp1;
 3620:           
 3621:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 3622:           
 3623: 
 3624: 
 3625:           node->grav2 = grav*(1.0 - beta_bar);
 3626: 
 3627:       } else {  // iloadtide=0,1
 3628:         node->grav2=grav;
 3629: 
 3630:       }
 3631: 
 3632:       printf("scaleGravity: node(%d)->grav2 = %f\n", node->idx, node->grav2);
 3633:    }
