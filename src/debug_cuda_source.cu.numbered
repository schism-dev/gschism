 6857: //                     swild4(1,1)=0.5d0*(tr_nd(jj,k,n1)+tr_nd(jj,k,n2))
 6858: //                     swild4(2,1)=0.5d0*(tr_nd(jj,k-1,n1)+tr_nd(jj,k-1,n2))
 6859:   
 6860: //                     swild4(1,1)=swild4(1,1)*rat+sdbt(2+jj,max(k,kbs(jsj)),jsj)*(1-rat)
 6861: //                     swild4(2,1)=swild4(2,1)*rat+sdbt(2+jj,max(k-1,kbs(jsj)),jsj)*(1-rat)
 6862: //                     psumtr(jj)=psumtr(jj)+0.5d0*(swild4(1,1)+swild4(2,1)) 
 6863: //                   enddo !j
 6864: //                 enddo !jj
 6865: //                 tr_el(1:ntr,k,i)=psumtr(:)/dble(i34(i))
 6866: //               enddo !k
 6867: //             endif !ielem_elm(i)/=0
 6868: 
 6869: 
 6870: // !           Extend
 6871: //             do k=1,kbe(i)
 6872: //               tr_el(1:ntr,k,i)=tr_el(1:ntr,kbe(i)+1,i)
 6873: //             enddo !k
 6874: //           enddo !i=1,ne
 6875: // !$OMP     end do 
 6876: 
 6877: // !$OMP     master
 6878: // !         Update ghosts
 6879: // #ifdef INCLUDE_TIMING
 6880: //           cwtmp=mpi_wtime()
 6881: //           timer_ns(1)=timer_ns(1)+cwtmp-cwtmp2
 6882: // #endif
