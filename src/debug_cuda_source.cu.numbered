 4488: extern "C" {
 4489: 
 4490:    __global__ void scaleGravity(double loadtide_coef) {
 4491: 
 4492: 
 4493:       NODE(node);
 4494: 
 4495:       // SAL option: scale gravity
 4496:       if constexpr(iloadtide==2) {  // simple const
 4497:          node->grav2 = grav*(1.0 - loadtide_coef);
 4498: 
 4499:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4500:         
 4501:           const double depth = max(node->depth, 0.0);
 4502:           const double tmp1 = sqrt(depth);
 4503:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4504:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4505:                              2.6969e-13*depth*depth*depth*tmp1;
 4506:           
 4507:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4508:           
 4509: 
 4510: 
 4511:           node->grav2 = grav*(1.0 - beta_bar);
 4512: 
 4513:       } else {  // iloadtide=0,1
 4514:         node->grav2=grav;
 4515: 
 4516:       }
 4517: 
 4518:    }
 4519: 
