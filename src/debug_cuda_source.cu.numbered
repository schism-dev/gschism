 4003:    //          do j=1,nond_global(k)
 4004:    //            icount2=icount2+1
 4005:    //            if(icount2>nnode_fl) call parallel_abort('STEP: wrong counting vel')
 4006: 
 4007:    //            uthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(1,1:nvrt,icount2,1,2)+rat*ath2(1,1:nvrt,icount2,2,2) !ll frame if ics=2
 4008:    //            vthnd(1:nvrt,j,k)=(1.d0-rat)*ath2(2,1:nvrt,icount2,1,2)+rat*ath2(2,1:nvrt,icount2,2,2)
 4009:    //          enddo !j
 4010:    //        endif
 4011:    //      enddo !k
 4012:    //    endif !nfltype2
 4013:    }
 4014: 
 4015: 
 4016:    __global__ void computeFlowBcVelocities(double time) {
 4017: 
 4018:       SIDE_BND(sideBnd);
 4019: 
 4020:       const Side *side = sideBnd->side;
 4021:  
 4022:       const bool isDry = side->isDry;
 4023: 
 4024:       if (isDry) {
 4025:          for (int k = 0; k < nvrt; k++) sideBnd->ubc[k] = {0.0, 0.0};
 4026:          return;
 4027:       }
 4028: 
 4029:       // For wet sides in open boundaries...
 4030:       const Vector2 n = side->n;
 4031:       const BoundarySegment *segment = sideBnd->segment;
 4032: 
 4033:       assert(segment != nullptr && "computeFlowBcVelocities: segment is nullptr");
 4034: 
 4035:       const int ifltype = segment->ifltype;
 4036:       const int iettype = segment->iettype;
 4037: 
 4038:       const double r_uth0 = ramp*segment->qthcon/segment->carea;  // r_ stands for ramp-up
 4039:       const Vector2 r_nuth0 = r_uth0*n;
 4040: 
 4041:       for (int k = 0; k < nvrt; k++) {
 4042:          Vector2 r_uth    = {0.0, 0.0};    // r_ stands for ramp-up
 4043:          Vector2 r_u1_bar = {0.0, 0.0};
 4044:       
 4045:          if (ifltype == 1 || ifltype == 2) {
 4046:          
 4047:             assert(segment->carea > 0.0 && "computeFlowBcVelocities: dry bnd side");
 4048: 
 4049:             const double unth0 = segment->qthcon*ramp/segment->carea;
 4050:             
 4051:             r_uth = unth0*n;  // This case has no ramp-up
 4052:             
 4053:          } else if (ifltype == -1) { // Flather 1
 4054: 
 4055:             // uth is the normal vel.; no ramp up
 4056:             const double uth = sideBnd->nuth(k);
 4057:             r_uth = uth*n;
 4058:             assert(uth >= -98.0 && uth <=  98.0 && "computeFlowBcVelocities: wrong velocity b.c. at side");
 4059: 
 4060: 
 4061:          } else if (ifltype == 3 || ifltype == 5) {
 4062:             // vnth0=0 !normal vel.
 4063: 
 4064:             // Computes the contribution to the velocity from all tide frequencies
 4065:             for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4066: 
 4067:                const Vector2 ufa  = sideBnd->ufa(jfr); 
 4068:                const Vector2 umo  = sideBnd->umo(jfr); 
 4069: 
 4070:                const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4071:                const double argx = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.x;
 4072:                const double argy = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - ufa.y;
 4073:                r_u1_bar += ramp*ff[jfr]*Vector2{umo.x*cos(argx), umo.y*cos(argy)};
 4074:             }
 4075: 
 4076:          } // if (ifltype = 3 || ifltype == 5
 4077: 
 4078: 
 4079:          switch (iettype) {
 4080:             case 1:
 4081:             case 2:
 4082:             case 4:
 4083:                sideBnd->ubc[k] = r_uth;
 4084:                break;
 4085:             case 3:
 4086:                sideBnd->ubc[k] = r_u1_bar;
 4087:                break;
 4088:             case 5:
 4089:                sideBnd->ubc[k] = r_uth + r_u1_bar;
 4090:                break;
 4091:          } // switch
 4092: 
 4093:       } // for k
 4094:    }
 4095: 
 4096:    __global__ void computeElevationBoundaryConditions(double time) {
 4097:       // Compute elevation essential boundary conditions 
 4098: 
 4099:       NODE_BND(nodeBnd); // Each boundary node.
 4100: 
 4101:       assert(nodeBnd->segment != nullptr && "computeElevationBoundaryConditions: nodeBnd->segment is nullptr");
 4102: 
 4103:       const Node *node = nodeBnd->node;
 4104:       const BoundarySegment *segment = nodeBnd->segment;
 4105:       const int iettype = segment->iettype;
 4106:       
 4107: 
 4108:       // Elevation initial condition at boundary nodes. It is ramped down to zero
 4109:       double eic = 0.0;
 4110:       if (nramp_elev == 1) eic = nodeBnd->etaic;
 4111:       else                 eic = 0.0;
 4112: 
 4113:       const double r_eic = (1.0 - ramp)*eic;   // r_ stands for ramp
 4114:       const double r_eth = ramp*nodeBnd->eth;
 4115:       double r_eta1_bar = 0.0;
 4116: 
 4117: 
 4118:       // Compute tide elevation
 4119:       if (iettype == 3 || iettype == 5) {   
 4120: 
 4121:          if constexpr(iloadtide==1) { // loading tide
 4122:             assert(false && "Loading tide not implemented");
 4123:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 4124:          }
 4125:          
 4126:          for (int jfr = 0; jfr < nbfr; jfr++) { // For all tide frequencies
 4127: 
 4128:             const double efa  = nodeBnd->efa[jfr]; 
 4129:             const double emo  = nodeBnd->emo[jfr]; 
 4130: 
 4131:             const int ncyc = int(amig[jfr]*time/(2.0*pi));
 4132:             const double arg = amig[jfr]*time - (2.0*pi)*ncyc + face[jfr] - efa;
 4133:             r_eta1_bar += ramp*ff[jfr]*emo*cos(arg);
 4134: 
 4135:          } // for jfr
 4136: 
 4137:       } // if iettype
 4138: 
 4139:       switch (iettype) {
 4140:          case 1:
 4141:          case 2:
 4142:          case 4:
 4143:             nodeBnd->elbc = r_eic + r_eth;
 4144:             break;
 4145:          case 3:
 4146:             nodeBnd->elbc = r_eic + r_eta1_bar;
 4147:             break;
 4148:          case 5:
 4149:             nodeBnd->elbc = r_eic + r_eta1_bar + r_eth;
 4150:             break;
 4151:       } // switch
 4152: 
 4153: 
 4154:       //Add inverse barometric effects
 4155:       if (iettype != 0 && inv_atm_bnd == 1) {
 4156:          nodeBnd->elbc += ramp*(prmsl_ref - node->pr)/grav/rho0;
 4157:       }
 4158: 
 4159:    }
 4160: 
 4161: 
 4162:    __global__ void computeHorizontalViscosity(void) { 
 4163: 
 4164:       assert(ics == 1 && "computeHorizontalViscosity: implemented only for ics=1");
 4165: 
 4166:       SIDE(side);
 4167: 
 4168:       if (side->isDry) return;
 4169: 
 4170:       for (int k = 0; k < nvrt; k++) {
 4171:          side->nuGradU[k] = {0.0, 0.0};
 4172:       }
 4173: 
 4174:       if constexpr(ihorcon == 1) {
 4175:          for (int k = side->kb; k < nvrt - 1; k++) {
 4176:             // Computes the Laplacian by using the simplified formula presented in the paper:
 4177:             // SELFE: A semi-implicit Eulerian–Lagrangian finite-element model for cross-scale ocean circulation
 4178:             // By Zhang and Baptista.
 4179: 
 4180:             // sum(nu*(u_i - u_c))/area, where u_i is the velocity at the i-th surrounding side and u_c is the velocity at the side under consideration.
 4181:             // This is a standard discretization of the Laplacian operator.
 4182:             // Following the paper, nu is estimated as: gamma*area/dt, where gamma is a non-dimensional parameter.
 4183:             // The area is the area of the cell we use for this calculation (it's not the area of an element). However, since it is in the numerator and the denominator, it cancels out.
 4184:             // Gamma is hvis_coef0 in the code.
 4185:             // The value of gamma needs to be < 0.5.
 4186: 
 4187:             // For the computation at the side center, we use the velocities at the two sides that are connected to the 
 4188:             // side under consideration in each of the two possible elements that share the side.
 4189:             Vector2 sumU = {0.0, 0.0};
 4190:             for (int l = 0; l < 2; l++) {
 4191:                const Element *elem = side->elems[l];
 4192: 
 4193:                if (elem == nullptr) continue;  // This happens at the domain boundaries
 4194: 
 4195:                // Find the local index of the side in the element
 4196:                const int idxSide = elem->sideLocalIdx(side);
 4197:                // Find the two sides that are connected to the side under consideration
 4198:                const Side *side1 = elem->sides[elem->nxq(idxSide + 1)];
 4199:                const Side *side2 = elem->sides[elem->nxq(idxSide - 1)];
 4200: 
 4201:                sumU += side1->u2[k] + side2->u2[k] - 2*side->u2[k];
 4202: 
 4203:             }
 4204: 
 4205:             side->nuGradU[k] = hvis_coef0*sumU/dt;
 4206:    
 4207:          }
 4208:       }
 4209:       else if constexpr(ihorcon == 2) {
 4210:          assert(false && "computeHorizontalViscosity: implemented only for ihorcon == 1");
 4211:       }
 4212: 
 4213: 
 4214:    }
 4215: 
 4216: 
 4217:    __global__ void setEssentialBC(void) {
 4218:       // Set essential boundary conditions 
 4219:       NODE(node); // Each boundary node
 4220:       NodeBoundary *nodeBnd = node->nodeBnd;
 4221:       
 4222: // nodeBnd->isEssentialBC = true;      
 4223:       // Check if this node has essential BC
 4224:       if (nodeBnd && nodeBnd->isEssentialBC) {
 4225:          // Verify BC value is valid
 4226:          assert(nodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4227: 
 4228:        
 4229:          // Set diagonal to 1 and zero off-diagonals
 4230:          node->coeffDiag = 1.0;
 4231: 
 4232:          for (int j = 0; j < node->numNodes; j++) {
 4233:                node->coeffMatrix[j] = 0.0;
 4234:          }
 4235:          
 4236:          // Set solution and RHS to BC value
 4237:          node->mX  = nodeBnd->elbc;
 4238:          node->qel = nodeBnd->elbc;
 4239: 
 4240:       } else {
 4241:          // Not an essential BC node. Still need to modify RHS and columns that belong to neighbors with essential BCs
 4242: 
 4243:          for (int j = 0; j < node->numNodes; j++) {
 4244:                Node* nbNode = node->nodes[j];
 4245:                const NodeBoundary* nbNodeBnd = nbNode->nodeBnd;
 4246:                if (nbNodeBnd && nbNodeBnd->isEssentialBC) {
 4247:                   // Verify neighbor's BC value
 4248:                   assert(nbNodeBnd->elbc >= -9998.0 && "setEssentialBC: wrong b.c. at node");
 4249: 
 4250:                   // Subtract contribution to RHS
 4251:                   node->qel -= node->coeffMatrix[j]*nbNodeBnd->elbc;
 4252:                   node->coeffMatrix[j] = 0.0;  
 4253:                }
 4254:          }
 4255:       }
 4256:    }
 4257: 
 4258: 
 4259:    __global__ void updateElevation(void) {
 4260:       NODE(node);
 4261: 
 4262:       node->eta2 = node->mX;
 4263: 
 4264:       node->updateZCoordData();
 4265:    }
