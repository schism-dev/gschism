 4385: 
 4386: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4387:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4388:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4389: 
 4390: 
 4391:    NODE(node1);
 4392: 
 4393:    node1->clearMatrixRow();
 4394:    node1->qel = 0.0;
 4395: 
 4396:    // THIS IS FOR STRUCTURES XXX
 4397:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4398: 
 4399:    
 4400:    for (int j=0; j<node1->numElements; j++) {
 4401:       // For each element connected to the node...
 4402: 
 4403:       Element *elem = node1->elements[j];
 4404: 
 4405: 
 4406: 
 4407:       // Compute the average gravity
 4408:       const double grav3 = elem->mean(&Node::grav2);
 4409: 
 4410:       // Look at the documentation for the description of the terms in the following integrals
 4411: 
 4412:       // Integral I_1 
 4413:       // \bar{\breve{H}} 
 4414:       const double hhatb = elem->mean(&Side::hhat);        
 4415: 
 4416:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4417: 
 4418:       const int id1 = elem->nodeLocalIdx(node1); 
 4419:       const double area = elem->area;
 4420: 
 4421:       if (elem->isTri()) {
 4422: 
 4423:          // To clarify the notation in this section: 
 4424:          //   i stands for the node under consideration (node1)
 4425:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4426:          const int id2 = elem->nxq(1 + id1);
 4427:          const int id3 = elem->nxq(2 + id1);
 4428:          Node *node2 = elem->nodes[id2];
 4429:          Node *node3 = elem->nodes[id3];
 4430: 
 4431:          Point2 x1, x2, x3;
 4432:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4433: 
 4434: 
 4435:          // integral of phi_i*phi_j
 4436:          const double ipp_ii = (1.0/6.0 )*area;
 4437:          const double ipp_ij = (1.0/12.0)*area;
 4438:          const double ipp_ik = (1.0/12.0)*area;
 4439: 
 4440:          // integral of [(grad phi_i) * (grad phi_j)]
 4441:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4442:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4443:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4444: 
 4445:          // Computes the different components of integral I_1 of each node with respect to node i.
 4446:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4447:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4448:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4449: 
 4450:          node1->addToSparseMatrix(node1, I1_ii);
 4451:          node1->addToSparseMatrix(node2, I1_ij); 
 4452:          node1->addToSparseMatrix(node3, I1_ik);
 4453: 
 4454:       }
 4455:       else { // Quad
 4456:          // XXX IMPLEMENT THIS
 4457:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4458: 
 4459:          // // To clarify the notation in this section: 
 4460:          // //   i stands for the node under consideration (node1)
 4461:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4462:          // const int id2 = elem->nxq(1 + id1);
 4463:          // const int id3 = elem->nxq(2 + id1);
 4464:          // const int id4 = elem->nxq(3 + id1);
 4465:          // Node *node2 = elem->nodes[id2];
 4466:          // Node *node3 = elem->nodes[id3];
 4467:          // Node *node4 = elem->nodes[id4];         
 4468: 
 4469:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4470:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4471:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4472:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4473:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4474: 
 4475:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4476:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4477:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4478:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4479:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4480: 
 4481:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4482:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4483:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4484:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4485:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4486: 
 4487:          // node1->addToSparseMatrix(node1, I1_ii);
 4488:          // node1->addToSparseMatrix(node2, I1_ij); 
 4489:          // node1->addToSparseMatrix(node3, I1_ik);
 4490:          // node1->addToSparseMatrix(node4, I1_il);
 4491:   
 4492:       } 
 4493: 
 4494:  
 4495:       // Integral I_4
 4496:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4497:       // Where
 4498:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4499: 
 4500:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4501:       // of U over the element.
 4502:       Vector2 U = {0.0, 0.0};
 4503:       for (int m=0; m < elem->i34; m++) {      
 4504:          const Side *side = elem->sides[m];
 4505: 
 4506:          if constexpr(ics == 1) U += side->U; 
 4507:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4508: 
 4509:       }
 4510:       U = U/elem->i34;
 4511: 
 4512: 
 4513:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4514: 
 4515: 
 4516:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4517:       const double I_4_1 = dot(gradPhi_1, U);
 4518: 
 4519: 
 4520:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4521:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4522: 
 4523:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4524: 
 4525:       // Additional terms 
 4526:       double vnorm = 0.0;
 4527:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4528:          Vector3 ubed = {0.0, 0.0, 0.0};
 4529:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4530:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4531: 
 4532:          Vector3 gradP = {0.0, 0.0, 1.0};
 4533:          for (int m=0; m < elem->i34; m++) {
 4534:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4535:            gradP += toVector3(gradP_2D, 0.0);
 4536:          }   
 4537:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4538:       } // imm==2
 4539: 
 4540:       if (elem->isTri()) {
 4541:          for (int l=0; l<3; l++) {
 4542: 
 4543:             Node *node = elem->nodes[l];
 4544: 
 4545:             double fac = (node == node1) ? 2.0 : 1.0;
 4546:    
 4547:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4548:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4549:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4550:            
 4551:          }
 4552: 
 4553: 
 4554:          if (!elem->isDry) {
 4555:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4556: 
 4557:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4558: 
 4559:          }
 4560: 
 4561:       } // isTri
 4562:       else { // isQuad
 4563:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4564:          // for (int l=0; l<4; l++) {
 4565:          //   const Node *node = elem->nodes[l];
 4566: 
 4567:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4568:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4569: 
 4570:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4571:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4572:          // }
 4573: 
 4574:       } // isQuad
 4575: 
 4576: 
 4577:      node1->qel += (dt/elem->i34)*elem->vsource;
 4578:       
 4579: 
 4580:    } // for all elements connected to the node
 4581:    
 4582: 
 4583:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4584:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4585:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4586:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4587:       // If it is an open boundary node...
 4588: 
 4589:       // At least one open bnd side, maybe two
 4590:       for (int l=0; l<2; l++) { 
 4591: 
 4592:          // Gets each of the sides sharing the node. 
 4593:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4594: 
 4595:        
 4596: 
 4597:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4598:          if (sideBnd != nullptr) {
 4599:             // If the side is on a boundary...
 4600: 
 4601:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4602: 
 4603:             // Get the boundary segment
 4604:             const BoundarySegment *sideSegment = sideBnd->segment;
 4605:             const Side *side = sideBnd->side;
 4606: 
 4607:             // Integral I_3
 4608:             if (sideSegment->ifltype != 0) {
 4609:             // Natural or Flather b.c.
 4610: 
 4611:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4612:                // especially for Flather b.c.
 4613:                double ri3 = 0.0;
 4614:                if (!side->isDry) {
 4615:                   // If the side is not dry
 4616:                   
 4617:                   // Computes the side flux of (uth, vth)
 4618:                   double Vn = 0.0;
 4619:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4620:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4621:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4622: 
 4623:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4624:                   }
 4625: 
 4626:                   ri3 = 0.5*side->len*Vn;
 4627:                }
 4628: 
 4629:                if (sideSegment->ifltype == -1) { // Flather 1
 4630: 
 4631:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4632:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4633: 
 4634:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4635:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4636:                   
 4637:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4638:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4639: 
 4640:                } 
 4641:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4642:                   // Reset ri3
 4643:                   ri3 = 0.0;
 4644: 
 4645:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4646:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4647: 
 4648:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4649: 
 4650:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4651:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4652: 
 4653:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4654:                   node1->addToSparseMatrix(node1, con0*2.0);
 4655:                   node1->addToSparseMatrix(node2, con0);
 4656: 
 4657:                } // if Flather or Discharge
 4658: 
 4659:                node1->qel -= thetai*dt*ri3;
 4660: 
 4661: 
 4662:             } // I_3
 4663:           
 4664: 
 4665:             // Integral I_5
 4666:             if(!side->isDry) {
 4667: 
 4668:                const double Unbar = dot(side->U, side->n);
 4669:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4670: 
 4671:             } // I_5
 4672: 
 4673:          } // if is boundary side
 4674: 
 4675:       } // for l
 4676: 
 4677:    } // if isbnd
 4678: 
 4679: 
 4680: }
 4681: 
 4682: 
 4683: 
 4684: extern "C" {
 4685:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4686:                                   int* indices, int* indptr) {
 4687: 
 4688:       NODE(node);
 4689:       
 4690:       const int idx = node->idx;
 4691:       
 4692:       // Computes the index in the nzz array      
 4693:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4694: 
 4695: 
 4696:       indptr[idx] = nzzIdx;
 4697:       indices[nzzIdx] = idx;
 4698: 
 4699:       data_d[nzzIdx]    = node->coeffDiag;
 4700: 
 4701:       b_d[idx] = node->qel;
 4702: 
 4703:       for (int k = 0; k < node->numNodes; ++k) {
 4704:          const Node* nb = node->nodes[k];
 4705: 
 4706:          const int j = nb->idx;
 4707: 
 4708:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4709: 
 4710:          indices[nzzIdx + k + 1] = j;
 4711:       }
 4712: 
 4713:  
 4714:    }
 4715: 
 4716: 
 4717: 
 4718:    __global__ void solverCopyResult(double* x) {
 4719:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4720:       NODE(node);
 4721:       const int idx = node->idx;
 4722: 
 4723:       node->mX = x[idx];
 4724:    }
 4725: 
 4726: 
 4727:    __global__ void rollUpElevation(void) {
 4728: 
 4729:       NODE(node);
 4730: 
 4731:       node->eta1 = node->eta2;
 4732: 
 4733:    }
 4734: 
 4735: 
 4736:    __global__ void backtrackAllNodes(void) {
 4737: 
 4738:       // max/min # of sub-divisions
 4739:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4740:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4741: 
 4742: 
 4743:       SIDE(side);
 4744: 
 4745:       const int kb = side->kb;
 4746: 
 4747: 
 4748:       // Initialize btrack velocities to the actual velocities at the side 
 4749:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4750: 
 4751:   
 4752: 
 4753:       if (side->isDry) return;
 4754:      
 4755: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4756: 
 4757:       // Checks that at least one element is not dry
 4758:       const Element *elem1 = side->elems[0];
 4759:       const Element *elem2 = side->elems[1];
 4760: 
 4761: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4762: 
 4763:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4764:       
 4765:       // XXXXXX
 4766:       // !swild_tmp to store global coord. of the starting side
 4767:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4768:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4769:       // !Use sframe2 
 4770:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4771: 
 4772: 
 4773:       for (int k = kb; k < nvrt; k++) {
 4774:       //  Initialize (xt,yt,zt), nnel and vel.
 4775:       //  For ics=2, the coordinates are all in the side's local frame
 4776:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4777: 
 4778:          const int iadvf = side->iadv();  // Advection flag   
 4779:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4780: 
 4781:          // If on land or open boundary...
 4782:          const bool ifl_bnd =  (side->sideBnd != nullptr);
 4783:          
 4784:          const double vmag = length(side->u2[k]);
 4785: 
 4786:          if (vmag <= velmin_btrack) {
 4787:             // No activity 
 4788: 
 4789:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4790: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4791: 
 4792:             
 4793:          } else {  // do btrack
 4794: 
 4795:             // Compute number of sub-divisions based on local gradients of the velocity field
 4796: 
 4797:             // XXX IS THIS NECESSARY?
 4798:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4799:             double suma = 0.0;
 4800:             int icount = 0;
 4801:             for (int l=0; l<2; l++) {
 4802:             // For each element sharing the side...
 4803: 
 4804:                const Element *elem = side->elems[l];
 4805:                  
 4806:                if (elem == nullptr) continue;
 4807: 
 4808:                icount++;
 4809: 
 4810:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4811:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4812:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4813: 
 4814:                double utmp[4];
 4815:                double vtmp[4];
 4816:                for (int j = 0; j < elem->i34; j++) {
 4817: 
 4818:                   const Node *node = elem->nodes[j];
 4819: 
 4820:                   if constexpr(ics==1) {
 4821:                      utmp[j] = node->u2[k].x;
 4822:                      vtmp[j] = node->u2[k].y;  
 4823: 
 4824:                   } else {
 4825:                      // 'Project' the velocity from the node frame to the element frame
 4826:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4827:                      utmp[j] = tmp_u2.x;
 4828:                      vtmp[j] = tmp_u2.y;
 4829: 
 4830:                   }
 4831:                } // for j
 4832: 
 4833:                const Vector2 grad_u = elem->grad2(utmp); 
 4834:                const Vector2 grad_v = elem->grad2(vtmp);
 4835:    
 4836:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4837:             } // for ii
 4838: 
 4839:             assert(icount > 0 && "Impossible 77");
 4840: 
 4841:             // '4' is somewhat arbitrary
 4842:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4843:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4844:             Vector3 u_int = {0.0, 0.0, 0.0};
 4845: 
 4846:             bool res =side->btrack(k, dt, dtbk, u_int);
 4847: 
 4848:             side->btu[k] = toVector2(u_int);
 4849:                
 4850:          } // if vmag (do backtrack)
 4851: 
 4852: 
 4853:       } // for k=kb,nvrt-1
 4854: 
 4855:    }
 4856: 
 4857: } // extern "C"
 4858: 
 4859: template<int nc>
 4860: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4861: 
 4862: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4863: //
 4864: // a,b,c,rhs: input vectors and are not modified by this program.
 4865: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4866: // rhs is the r.h.s.
 4867: // n: actual rank of the system.
 4868: // rows in u() and rhs();
 4869: // u: output with nc columns (transposed to rows)
 4870: // gam: a working array.
 4871: //
 4872: // NOTES:
 4873: // This is a template function that allows for different numbers of columns in the rhs vector.
 4874: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4875: 
 4876:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4877:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4878: 
 4879:    double bet = b[0];
 4880:    if constexpr (nc == 1) {
 4881:       u[0] = rhs[0]/bet;
 4882:    } else {
 4883:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4884:    }
 4885: 
 4886:    for (int j = 1; j < n; j++) {
 4887:       gam[j] = c[j - 1]/bet;
 4888:       bet = b[j] - a[j]*gam[j];
 4889: 
 4890:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4891: 
 4892:       if constexpr (nc == 1) {
 4893:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4894:       } else {
 4895:          for (int l = 0; l < nc; l++) {
 4896:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4897:          }
 4898:       }
 4899:    }
 4900: 
 4901:    // Back-substitution
 4902:    for (int j = n - 2; j >= 0; j--) {
 4903:       if constexpr (nc == 1) {
 4904:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4905:       } else {
 4906:          for (int l = 0; l < nc; l++) {
 4907:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4908:          }
 4909:       }
 4910:    }
 4911: }
 4912: 
 4913: 
 4914: 
 4915: // Helper function that contains the core algorithm
 4916: template<typename XAccessor, typename YAccessor>
 4917: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4918:                                     double  yp_top, double  yp_bot, 
 4919:                                     CubicSpline &spline) {
 4920:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4921:    // 
 4922:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4923:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4924:    //
 4925:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4926:    // 
 4927:    // Inputs: 
 4928:    //            n: dimension for x etc; # of data pts (>=2);
 4929:    //            getX, getY: functions to access x,y coordinates
 4930:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4931:    //     Output: 
 4932:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4933: 
 4934:    const int n = k2 - k1 + 1;
 4935:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4936: 
 4937:    // Allocate memory for the splines
 4938:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4939:    spline.x   = new double[n];
 4940:    spline.y   = new double[n];
 4941:    spline.yp  = new double[n];
 4942:    spline.ypp = new double[n];
 4943: 
 4944:    for (int k=k1; k<=k2; k++) {
 4945:       spline.x[k] = getX(k);
 4946:       spline.y[k] = getY(k);
 4947:    }
 4948: 
 4949:    // This is to simplify expressions later
 4950:    double *x = spline.x;
 4951:    double *y = spline.y;
 4952: 
 4953:    double *a = nullptr;
 4954:    double *b = nullptr;
 4955:    double *c = nullptr;
 4956:    double *gam = nullptr;
 4957:    double *rhs = nullptr;
 4958:    
 4959: 
 4960:       a = new double[n];   // Lower diagonal
 4961:       b = new double[n];   // Diagonal
 4962:       c = new double[n];   // Upper diagonal
 4963:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4964:       rhs = new double[n]; // Right-hand side
 4965: 
 4966:    for (int k=k1; k<=k2; k++) {
 4967:       if (k == k1) {
 4968:          // Bottom level
 4969:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4970:          b[k] = (x[k+1] - x[k])/3.0;
 4971:          c[k] = b[k]/2.0;
 4972:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4973:       } else if (k == n - 1) {
 4974:          // Top level (surface)
 4975:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4976:          b[k] = (x[k] - x[k-1])/3.0;
 4977:          a[k] = b[k]/2.0;
 4978:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4979:       } else {
 4980:          // Intermediate levels
 4981:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4982:          b[k] = (x[k+1] - x[k-1])/3.0;
 4983:          a[k] = (x[k  ] - x[k-1])/6.0;
 4984:          c[k] = (x[k+1] - x[k  ])/6.0;
 4985:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4986:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4987:       }
 4988:    }
 4989: 
 4990:    // Solve the tridiagonal system
 4991:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4992:    
 4993:    spline.yp[k1] = yp_bot;
 4994:    spline.yp[k2] = yp_top;
 4995: 
 4996:    // Compute rest of 1st derivatives using the splines
 4997:    for (int k=k1+1; k<k2; k++) {
 4998:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4999:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5000:    }
 5001:    
 5002:    delete[] a;
 5003:    delete[] b;
 5004:    delete[] c;
 5005:    delete[] gam;
 5006:    delete[] rhs;
 5007: 
 5008: }
 5009: 
 5010: // Array version
 5011: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5012:                                 double y_top, double y_bot, 
 5013:                                 CubicSpline &spline) {
 5014:    auto getX = [x] (int k) { return x[k]; };
 5015:    auto getY = [y] (int k) { return y[k]; };
 5016:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5017: }
 5018: 
 5019: // Lambda version - allows custom access patterns
 5020: template<typename XFunc, typename YFunc>
 5021: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5022:                                 double y_top, double y_bot,
 5023:                                 CubicSpline &spline) {
 5024:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5025: }
