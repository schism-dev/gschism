 3304: 
 3305: __inline__ __device__ Point2 Side::outputCoords(void) const {
 3306:    if constexpr(ics == 1) {
 3307:       return center;
 3308: 
 3309:    } else {
 3310:       const Point2 p0 = n1->outputCoords();
 3311:       const Point2 p1 = n2->outputCoords();
 3312:       return (1.0/2.0)*(p0 + p1);
 3313: 
 3314:    }
 3315: }
 3316: 
 3317: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 3318: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 3319: __inline__ __device__ double  Side::z(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->gz  + t*n2->gz; }
 3320: __inline__ __device__ double  Side::lon(void)     const { return 0.5*(n1->lon + n2->lon); }
 3321: __inline__ __device__ double  Side::lat(void)     const { return 0.5*(n1->lat + n2->lat); }
 3322: __inline__ __device__ Point2  Side::p2_t(double t) const { return {x(t), y(t)}; }
 3323: __inline__ __device__ Point3  Side::p3_t(double t) const { return {x(t), y(t), z(t)}; }
 3324: __inline__ __device__ double  Side::centerZ(void) const { return 0.5*(n1->gz + n2->gz); }
 3325: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 3326: // Computes the gradient of the field at the side center.
 3327:    Vector2 grad = {0.0, 0.0};
 3328:    int count = 0;
 3329: 
 3330:    // Goes over the two elements that share this side, computes the gradient of the field at the side center,
 3331:    // as the average of the gradients at each element.
 3332:    // First element
 3333:    if (elems[0] != nullptr && condition(elems[0])) {
 3334:       Vector2 elemGrad = elems[0]->grad2(field);
 3335: 
 3336:       // For ics=2, projects the element gradient from its frame to the side frame
 3337:       if constexpr(ics == 2) elemGrad = elems[0]->frame.projHorVec(elemGrad, frame);
 3338: 
 3339:       grad += elemGrad;
 3340: 
 3341:       count++;
 3342:    }
 3343: 
 3344:    // Second element
 3345:    if (elems[1] != nullptr && condition(elems[1])) {
 3346: 
 3347:       Vector2 elemGrad = elems[1]->grad2(field);
 3348: 
 3349:       // For ics=2, projects the element gradient from its frame to the side frame
 3350:       if constexpr(ics == 2) elemGrad = elems[1]->frame.projHorVec(elemGrad, frame);
 3351: 
 3352:       grad += elemGrad;
 3353: 
 3354:       count++;
 3355:    }
 3356: 
 3357:    // If there are valid elements, returns the average of the gradients at the side's frame.
 3358:    if (count > 0) {
 3359:       grad = grad*(1.0/count);
 3360:    }
 3361:    
 3362:    return grad;
 3363: }
 3364: 
 3365: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2  + n2->grav2); }
 3366: __inline__ __device__ int     Side::iadv(void)    const { return  min(n1->iadv,    n2->iadv); }   
 3367: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2   + n2->eta2); }
 3368: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1   + n2->eta1); }
 3369: __inline__ __device__ double  Side::w2(int k)     const { return 0.5*(n1->w2[k]  + n2->w2[k]); }
 3370: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth  + n2->depth); } 
 3371: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
