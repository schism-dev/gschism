 4843: 
 4844:    __global__ void backtrackAllNodes(void) {
 4845: 
 4846:       // max/min # of sub-divisions
 4847:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4848:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4849: 
 4850:       SIDE(side);
 4851: 
 4852:       const int kb = side->kb;
 4853: 
 4854: 
 4855:       // Initialize btrack velocities to the actual velocities at the side 
 4856:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4857:   
 4858:       if (side->isDry) return;
 4859:      
 4860: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4861: 
 4862:       // Checks that at least one element is not dry
 4863:       const Element *elem1 = side->elems[0];
 4864:       const Element *elem2 = side->elems[1];
 4865: 
 4866: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4867: 
 4868:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4869:       
 4870:       // XXXXXX
 4871:       // !swild_tmp to store global coord. of the starting side
 4872:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4873:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4874:       // !Use sframe2 
 4875:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4876: 
 4877: 
 4878:       for (int k = kb; k < nvrt; k++) {
 4879:       //  For ics=2, the coordinates are all in the side's local frame
 4880: 
 4881:          const int iadvf = side->iadv();  // Advection flag   
 4882:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4883: 
 4884:          const double vmag2 = norm2(side->u2[k]);
 4885: 
 4886:          if (vmag2 <= velmin_btrack_sq) {  
 4887:             // No activity 
 4888: 
 4889:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4890:             
 4891:          } else {  // do btrack
 4892: 
 4893:             // Compute number of sub-divisions based on local gradients of the velocity field
 4894: 
 4895:             // XXX IS THIS NECESSARY?
 4896:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4897:             double suma = 0.0;
 4898:             int icount = 0;
 4899:             #pragma unroll
 4900:             for (int l=0; l<2; l++) {
 4901:             // For each element sharing the side...
 4902: 
 4903:                const Element *elem = side->elems[l];
 4904:                  
 4905:                if (elem == nullptr) continue;
 4906: 
 4907:                icount++;
 4908: 
 4909:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4910:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4911:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4912: 
 4913:                double utmp[4];
 4914:                double vtmp[4];
 4915:                #pragma unroll
 4916:                for (int j = 0; j < elem->i34; j++) {
 4917: 
 4918:                   const Node *node = elem->nodes[j];
 4919: 
 4920:                   if constexpr(ics==1) {
 4921:                      utmp[j] = node->u2[k].x;
 4922:                      vtmp[j] = node->u2[k].y;  
 4923: 
 4924:                   } else {
 4925:                      // 'Project' the velocity from the node frame to the element frame
 4926:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4927:                      utmp[j] = tmp_u2.x;
 4928:                      vtmp[j] = tmp_u2.y;
 4929: 
 4930:                   }
 4931:                } // for j
 4932: 
 4933:                const Vector2 grad_u = elem->grad2(utmp); 
 4934:                const Vector2 grad_v = elem->grad2(vtmp);
 4935:    
 4936:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4937:             } // for l
 4938: 
 4939:             assert(icount > 0 && "Impossible 77");
 4940: 
 4941:             // '4' is somewhat arbitrary
 4942:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4943: 
 4944:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4945:             Vector3 u_int = {0.0, 0.0, 0.0};
 4946: 
 4947:             side->btrack(k, dt, dtbk, u_int);
 4948: 
 4949: 
 4950:             side->btu[k] = {u_int.x, u_int.y};
 4951:                
 4952:          } // if vmag (do backtrack)
 4953: 
 4954: 
 4955:       } // for k=kb,nvrt-1
 4956: 
 4957:    }
 4958: 
 4959: } // extern "C"
 4960: 
 4961: template<int nc>
 4962: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4963: 
 4964: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4965: //
 4966: // a,b,c,rhs: input vectors and are not modified by this program.
 4967: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4968: // rhs is the r.h.s.
 4969: // n: actual rank of the system.
 4970: // rows in u() and rhs();
 4971: // u: output with nc columns (transposed to rows)
 4972: // gam: a working array.
 4973: //
 4974: // NOTES:
 4975: // This is a template function that allows for different numbers of columns in the rhs vector.
 4976: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4977: 
 4978:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4979:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4980: 
 4981:    double bet = b[0];
 4982:    if constexpr (nc == 1) {
 4983:       u[0] = rhs[0]/bet;
 4984:    } else {
 4985:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4986:    }
 4987: 
 4988:    for (int j = 1; j < n; j++) {
 4989:       gam[j] = c[j - 1]/bet;
 4990:       bet = b[j] - a[j]*gam[j];
 4991: 
 4992:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4993: 
 4994:       if constexpr (nc == 1) {
 4995:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4996:       } else {
 4997:          for (int l = 0; l < nc; l++) {
 4998:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4999:          }
 5000:       }
 5001:    }
 5002: 
 5003:    // Back-substitution
 5004:    for (int j = n - 2; j >= 0; j--) {
 5005:       if constexpr (nc == 1) {
 5006:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 5007:       } else {
 5008:          for (int l = 0; l < nc; l++) {
 5009:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 5010:          }
 5011:       }
 5012:    }
 5013: }
 5014: 
 5015: 
 5016: 
 5017: // Helper function that contains the core algorithm
 5018: template<typename XAccessor, typename YAccessor>
 5019: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 5020:                                     double  yp_top, double  yp_bot, 
 5021:                                     CubicSpline &spline) {
 5022:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 5023:    // 
 5024:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 5025:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 5026:    //
 5027:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 5028:    // 
 5029:    // Inputs: 
 5030:    //            n: dimension for x etc; # of data pts (>=2);
 5031:    //            getX, getY: functions to access x,y coordinates
 5032:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 5033:    //     Output: 
 5034:    //            spline (CubicSpline): spline structure with x,y,y',y''
 5035: 
 5036:    const int n = k2 - k1 + 1;
 5037:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 5038: 
 5039:    // Allocate memory for the splines
 5040:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 5041:    spline.x   = new double[n];
 5042:    spline.y   = new double[n];
 5043:    spline.yp  = new double[n];
 5044:    spline.ypp = new double[n];
 5045: 
 5046:    for (int k=k1; k<=k2; k++) {
 5047:       spline.x[k] = getX(k);
 5048:       spline.y[k] = getY(k);
 5049:    }
 5050: 
 5051:    // This is to simplify expressions later
 5052:    double *x = spline.x;
 5053:    double *y = spline.y;
 5054: 
 5055:    double *a = nullptr;
 5056:    double *b = nullptr;
 5057:    double *c = nullptr;
 5058:    double *gam = nullptr;
 5059:    double *rhs = nullptr;
 5060:    
 5061: 
 5062:       a = new double[n];   // Lower diagonal
 5063:       b = new double[n];   // Diagonal
 5064:       c = new double[n];   // Upper diagonal
 5065:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 5066:       rhs = new double[n]; // Right-hand side
 5067: 
 5068:    for (int k=k1; k<=k2; k++) {
 5069:       if (k == k1) {
 5070:          // Bottom level
 5071:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 5072:          b[k] = (x[k+1] - x[k])/3.0;
 5073:          c[k] = b[k]/2.0;
 5074:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 5075:       } else if (k == n - 1) {
 5076:          // Top level (surface)
 5077:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 5078:          b[k] = (x[k] - x[k-1])/3.0;
 5079:          a[k] = b[k]/2.0;
 5080:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 5081:       } else {
 5082:          // Intermediate levels
 5083:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 5084:          b[k] = (x[k+1] - x[k-1])/3.0;
 5085:          a[k] = (x[k  ] - x[k-1])/6.0;
 5086:          c[k] = (x[k+1] - x[k  ])/6.0;
 5087:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 5088:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 5089:       }
 5090:    }
 5091: 
 5092:    // Solve the tridiagonal system
 5093:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 5094:    
 5095:    spline.yp[k1] = yp_bot;
 5096:    spline.yp[k2] = yp_top;
 5097: 
 5098:    // Compute rest of 1st derivatives using the splines
 5099:    for (int k=k1+1; k<k2; k++) {
 5100:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 5101:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 5102:    }
 5103:    
 5104:    delete[] a;
 5105:    delete[] b;
 5106:    delete[] c;
 5107:    delete[] gam;
 5108:    delete[] rhs;
 5109: 
 5110: }
 5111: 
 5112: // Array version
 5113: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 5114:                                 double y_top, double y_bot, 
 5115:                                 CubicSpline &spline) {
 5116:    auto getX = [x] (int k) { return x[k]; };
 5117:    auto getY = [y] (int k) { return y[k]; };
 5118:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5119: }
 5120: 
 5121: // Lambda version - allows custom access patterns
 5122: template<typename XFunc, typename YFunc>
 5123: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 5124:                                 double y_top, double y_bot,
 5125:                                 CubicSpline &spline) {
 5126:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 5127: }
