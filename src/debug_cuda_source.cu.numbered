 2176: // Helper functions for computing the local node index at a given offset from another.
 2177: __device__ __inline__ int nxq(int offset, int index, int size) {
 2178:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2179:    // to the index to make it positive
 2180:    assert(index + offset + 16*size >= 0);
 2181:    return (index + offset + 16*size) % size;  
 2182: }
 2183: 
 2184: __device__ __inline__ int nxq(int index, int size) {
 2185:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 2186:    // to the index to make it positive
 2187:    assert(index + 16*size >= 0);
 2188:    return (index + 16*size) % size; 
 2189: }
