 8944:                                  
 8945:   __global__ void populateMesh(int *i34, int *elnode, int *elside,
 8946:                    double *node_coords, double *node_coords_ll, bool use_ll,
 8947:                    double *wind_rotate_angle,  int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 8948:                    int *isdel, int *isidenode, int *isbnd,
 8949:                    int *nond, int *nlnd, int *iond, int *ilnd, 
 8950:                    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 8951:                    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 8952:                    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 8953:                    int *localNodeIndices, int *localElemIndices, int *localSideIndices,
 8954:                    int *localNodePart,    int *localElemPart,    int *localSidePart,
 8955:                    double *drag, double *roughness,
 8956:                    double *emo, double *efa, 
 8957:                    double *umo, double *ufa, 
 8958:                    double *vmo, double *vfa) {
 8959: 
 8960:     mesh->populateMesh(i34, elnode, elside, node_coords, node_coords_ll, use_ll, wind_rotate_angle, 
 8961:                        sharedIdxNodeBoundary, sharedIdxSideBoundary,
 8962:                        isdel, isidenode, isbnd,
 8963:                        nond, nlnd, iond, ilnd, 
 8964:                        nodeNeighNodesStart, nodeNeighNodesIndices,
 8965:                        nodeNeighElemsStart, nodeNeighElemsIndices,
 8966:                        globalNodeIndices, globalElemIndices, globalSideIndices,
 8967:                        localNodeIndices, localElemIndices, localSideIndices,
 8968:                        localNodePart, localElemPart, localSidePart,
 8969:                        drag, roughness,
 8970:                        emo, efa, umo, ufa, vmo, vfa);  // XXXXX Remember to refactor this, removing the parameters that are not used.
 8971:   }
