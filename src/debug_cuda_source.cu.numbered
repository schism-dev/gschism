 3819: 
 3820: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3821:    // Computes the z coordinate at level k.
 3822:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3823:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3824:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3825:    // used 
 3826: 
 3827:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3828:    
 3829:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3830: 
 3831:    if (isDry2()) return 0.0;  
 3832: 
 3833:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3834: 
 3835:    if constexpr(ivcor == 2) {
 3836: 
 3837:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3838:       const double h_c = mesh->h_c;
 3839:       const double theta_f = mesh->theta_f;
 3840:       const double sinh_theta_f = mesh->sinh_theta_f;
 3841: 
 3842: 
 3843:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3844:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3845:       // once per time step/node. XXXX
 3846:       // CHECK: updateZCoordData
 3847: 
 3848:       //  To simplify comparisons, I define index versions of count variables.
 3849:       if      (k == ivrt)     return eta2; 
 3850:       else if (k == izlev)    return -hmod2;
 3851:       else if (k == kb)       return -depth;
 3852:       else if (k < izlev)     return mesh->ztot[k];
 3853:       else if (k > izlev) {
 3854:          const int ksig = k - izlev;
 3855: 
 3856:          if (hmod2 <= h_c) {
 3857:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3858: 
 3859:          } 
 3860:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3861:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3862:             assert(false && "compZCoord: invalid h_c\n");
 3863:          } 
 3864:          else {
 3865:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3866:                    h_c * mesh->sigma[ksig] + 
 3867:                    (hmod2 - h_c) * mesh->cs[ksig];
 3868:          }
 3869:       } else { 
 3870:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3871:       }
 3872: 
 3873:    }
 3874:    else {  // if constexpr(ivcor == 1)
 3875:       if (k <= kb)        return -depth; 
 3876:       else if (k == ivrt) return eta2;
 3877:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3878: 
 3879:    }
 3880:    
 3881:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3882:    return 0.0;
 3883: }
 3884: 
 3885: 
 3886: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3887:    // Computes the bottom drag Cd based on the selected nchi
 3888: 
 3889:    if constexpr(nchi == 0) {
 3890:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3891:       Cd = drag;  // Read from drag file
 3892: 
 3893:    } else if constexpr(nchi == 1) {
 3894:       // 
 3895: 
 3896:       bool ltmp = false; // for WBL iteration
 3897: 
 3898:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3899:       if (isDry || (rough == 0.0)) {
 3900:          Cd = 0.0;
 3901: 
 3902:       } else { //roughness >0 
 3903:          
 3904:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3905: 
 3906:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3907: 
 3908:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3909: 
 3910:       } // if rough
 3911: 
 3912:    } else if constexpr(nchi == -1) {
 3913:    // Manning 
 3914:  
 3915:       const double htot = max(hmin_man, htot2()); 
 3916:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3917: 
 3918:    } else {
 3919:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3920:       
 3921:    } // if nchi
 3922: 
 3923: }
 3924: 
 3925: 
 3926: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3927:    // Checks if a side in on the boundary
 3928:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3929: 
 3930:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3931:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3932: 
 3933:    // Indices of the nodes that form the side
 3934:    const int n1 = side.n1->idx;
 3935:    const int n2 = side.n2->idx;
 3936:    isLand = false;
 3937:    
 3938: 
 3939:    // Check if the side is on a land boundary
 3940:    for (int i = 0; i < nland; i++) {
 3941:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3942:          // Consecutive nodes in the land boundary segment
 3943:          const int b1 = ilnd[i + j*nland];
 3944:          const int b2 = ilnd[i + (j + 1)*nland];
 3945: 
 3946:          assert(b1 != -1 && b2 != -1);
 3947: 
 3948:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3949:             
 3950:             isLand = true;
 3951:             return i;
 3952:          }
 3953:       }
 3954:    }
 3955: 
 3956:    // Check if the side is on an open boundary
 3957:    for (int i = 0; i < nope; i++) {
 3958:       for (int j = 0; j < nond[i] - 1; j++) {
 3959:          // Consecutive nodes in the open boundary segment
 3960:          const int b1 = iond[i + j*nope];
 3961:          const int b2 = iond[i + (j + 1)*nope];
 3962: 
 3963:          assert(b1 != -1 && b2 != -1);
 3964: 
 3965:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3966:             isLand = false;
 3967:             return i;
 3968:          }
 3969:       }
 3970:    }
 3971: 
 3972:    return -1;
 3973: }
 3974: 
 3975: 
 3976: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3977:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3978:                                     double *wind_rotate_angle, 
 3979:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3980:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3981:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3982:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3983:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3984: 
 3985:    NODE(pnode);  
 3986:    const int i = idx_node;
 3987:    Node &node(*pnode);
 3988: 
 3989:    node.idx = i;
 3990: 
 3991:    const int idxNodeStart = nodeNeighNodesStart[i];
 3992:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3993:    node.numNodes = idxNodeEnd - idxNodeStart;
 3994:    node.nodes = nodeNeighNodes + idxNodeStart;
 3995:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3996: 
 3997: 
 3998: 
 3999:    const int idxElemStart = nodeNeighElemsStart[i];
 4000:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 4001:    node.numElements = idxElemEnd - idxElemStart;
 4002:    node.elements = nodeNeighElems + idxElemStart;
 4003: 
 4004: 
 4005:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 4006:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 4007:       const int partNode = localNodePart[idxNodeGlobal]; 
 4008:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 4009: 
 4010:       Node *node_ptr = nodes[partNode] + idxNode;
 4011:       
 4012:       nodeNeighNodes[idx] = node_ptr;
 4013:    }
 4014: 
 4015: 
 4016:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 4017:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 4018:       const int partElem = localElemPart[idxElemGlobal];
 4019:       const int idxElem  = localElemIndices[idxElemGlobal];
 4020: 
 4021:       Element *elem_ptr = elems[partElem] + idxElem;
 4022: 
 4023:       nodeNeighElems[idx] = elem_ptr;
 4024:    }      
 4025: 
 4026:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 4027:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 4028:    sincosf((float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 4029: 
 4030:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 4031:    if constexpr(ics == 1) {
 4032:       node.p.x   = node_coords[i * 3];
 4033:       node.p.y   = node_coords[i * 3 + 1];
 4034:       node.gz = 0.0;
 4035: 
 4036:    } else {
 4037:       const double lon = deg2rad*node_coords[i * 3];
 4038:       const double lat = deg2rad*node_coords[i * 3 + 1];
 4039: 
 4040:       Point3 p = computeXYZfromLatLon(lat, lon);
 4041:       node.p = toVector2(p);
 4042:       node.gz = p.z;
 4043:       node.lon = lon;
 4044:       node.lat = lat;
 4045: 
 4046:       #ifdef USE_FRAMES
 4047:       node.setFrame(lat, lon);
 4048:       #endif
 4049: 
 4050: 
 4051:    }
 4052: 
 4053:    node.depth = node_coords[i * 3 + 2];
 4054: 
 4055:    node.numSides = 0;
 4056: 
 4057:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 4058:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 4059:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 4060:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 4061:    else assert(false && "populateNodes: selected nchi not implemented.");
 4062:    
 4063:    if constexpr(ivcor == 1) 
 4064:    {  
 4065:       node.kb = kb[i];
 4066:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 4067:    }
 4068: 
 4069:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 4070:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 4071:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 4072: 
 4073:    
 4074:    // Links the node to the boundary information
 4075:    if (isbnd[i] >= 0) {
 4076:      
 4077:       // Get the index of the node boundary
 4078:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 4079: 
 4080:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 4081:       node.nodeBnd->node = &node;
 4082: 
 4083:       node.nodeBnd->sideBnd1 = nullptr;
 4084:       node.nodeBnd->sideBnd2 = nullptr;
 4085: 
 4086:       if (isbnd[i]>=0) {
 4087: 
 4088:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 4089:          
 4090:          node.nodeBnd->segment->ifltype = 0 ; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 4091:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 4092: 
 4093:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 4094:          node.nodeBnd->segment->clen  = nan("1");
 4095:          node.nodeBnd->segment->carea = nan("1");
 4096: 
 4097:       }
 4098:    } else {
 4099: 
 4100:       node.nodeBnd = nullptr; // For internal nodes
 4101: 
 4102:       if (isbnd[i] == landSegment) {
 4103:          node.nodeBnd = &landBoundaryNode;
 4104:          node.nodeBnd->segment = &landBoundarySegment;
 4105:       }
 4106:       
 4107:    }
 4108:    
 4109:    // XXXX GAUSSIAN HILL VELOCITIES
 4110:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4111:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4112:          constexpr double rot_per = 3000.0;
 4113:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 4114:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 4115:       // XXXXX
 4116:    #endif
 4117: 
 4118: }
 4119: 
 4120: 
 4121: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 4122:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 4123:                                     double *wind_rotate_angle,   
 4124:                                     int *isdel, int *isidenode, int *isbnd,
 4125:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4126:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4127:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4128:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4129:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4130:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 4131:                                     double *drag, double *roughness) {
 4132: 
 4133: 
 4134:    SIDE(pside);
 4135:    Side &side(*pside);
 4136:    const int i = idx_side;
 4137: 
 4138:    side.idx = i;  
 4139:    
 4140:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 4141:    const double fc   = 2.0*omega_e*sin(sfea0);
 4142:    const double beta = 2.0*omega_e*cos(sfea0);
 4143: 
 4144:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 4145: 
 4146:    // finding the pointer to the nodes that form the side
 4147:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 4148:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 4149: 
 4150:    const int locidx_n1 = localNodeIndices[idx_n1];
 4151:    const int locidx_n2 = localNodeIndices[idx_n2];
 4152:    const int part_n1 =   localNodePart[idx_n1];
 4153:    const int part_n2 =   localNodePart[idx_n2];
 4154: 
 4155:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 4156:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 4157: 
 4158: 
 4159:    // Counts the number of sides connected to each node
 4160:    side.n1->numSides++;
 4161:    side.n2->numSides++;
 4162: 
 4163:    // Side boundary type
 4164:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 4165:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 4166: 
 4167:    if (n1bnd != nullptr && n2bnd != nullptr) 
 4168:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 4169:    {
 4170:       bool isLand = false;
 4171:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 4172:       
 4173:       if (isbs > -1) {
 4174:          // assert(isLand || isbs>=0);
 4175:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 4176: 
 4177:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 4178: 
 4179:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 4180:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 4181: 
 4182:          assert (isLand == side.sideBnd->segment->isLand);
 4183: 
 4184:          // Links each node boundary to the side boundary using the first available side boundary pointer
 4185:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 4186:          else                            n1bnd->sideBnd2 = side.sideBnd;
 4187: 
 4188:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 4189:          else                            n2bnd->sideBnd2 = side.sideBnd;
 4190:          
 4191:          side.sideBnd->side = &side;
 4192: 
 4193:       }
 4194:       else {
 4195:          side.sideBnd = nullptr;
 4196:       }
 4197:    }
 4198:    else 
 4199:    {
 4200:       side.sideBnd = nullptr;
 4201:    }
 4202: 
 4203: 
 4204:    // finding the pointer to the elements that share the side
 4205:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 4206:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 4207: 
 4208:    if (idx_e1 > -1) {
 4209:       const int locidx_e1 = localElemIndices[idx_e1];
 4210:       const int part_e1 =  localElemPart[idx_e1];
 4211:       side.elems[0] = elems[part_e1] + locidx_e1;
 4212: 
 4213:    }
 4214:    else {
 4215:       side.elems[0] = nullptr;
 4216:    }
 4217: 
 4218:    if (idx_e2 > -1) {
 4219:       const int locidx_e2 = localElemIndices[idx_e2];
 4220:       const int part_e2 =  localElemPart[idx_e2];
 4221:       side.elems[1] = elems[part_e2] + locidx_e2;
 4222:    }
 4223:    else {
 4224:       side.elems[1] = nullptr;
 4225:    }
 4226:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4227:       
 4228:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4229:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4230:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4231:          
 4232:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4233:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4234:       // printf("sideBnd: %p\n", side.sideBnd);
 4235:       // assert(false && "Side has no elements and no boundary");
 4236:    }
 4237:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4238: 
 4239:    // Compute the center of the side
 4240:    side.center = 0.5*(side.n1->p + side.n2->p);
 4241: 
 4242:    #ifdef USE_FRAMES
 4243:    side.setFrame();
 4244:    #endif
 4245: 
 4246:    // Normal, unitary vector to the side
 4247:    if constexpr(ics == 1) {
 4248:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4249:       side.n = normalize(side.n);
 4250:    }
 4251:    else {
 4252:       // Unit side vector in 3D cartesian coordinates
 4253:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4254: 
 4255:       nSide = normalize(nSide);
 4256: 
 4257:       // Its cross product with the unit local z-axis vector (nUp) is the
 4258:       // normal vector we are looking for.
 4259:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4260: 
 4261:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4262:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4263:       side.n = -normalize(n2D); 
 4264: 
 4265:    }
 4266: 
 4267:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4268:    side.shapiro = shapiro0;
 4269: 
 4270:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4271:    // XXXX
 4272:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4273:    constexpr double rot_per=3000.0;
 4274:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4275:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4276:    // XXXXX      
 4277:    #endif
 4278:    // Compute the z level at the center of the side
 4279:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4280:    
 4281:    // Compute the length of the side
 4282:    side.len = length(side.n2->p - side.n1->p);
 4283: 
 4284: 
 4285:    // Compute the Coriolis coefficient
 4286: 
 4287:    if constexpr(ncor == -1 || ncor == 0) {
 4288:       side.coriolis = coricoef;
 4289:    }
 4290:    else {
 4291:       const double sphi = side.lat();  // Latitude at the center of the side
 4292: 
 4293:       assert(use_ll && "use_ll must be true when ncor > 0");
 4294: 
 4295:       if constexpr(ics == 1) {
 4296:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4297:       }
 4298:       else { // ics == 2
 4299:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4300:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4301:       }
 4302: 
 4303:    }
 4304: 
 4305: }
 4306: 
 4307: 
 4308: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4309:    double *node_coords, double *node_coords_ll, bool use_ll,
 4310:    double *wind_rotate_angle,   
 4311:    int *isdel, int *isidenode, int *isbnd,
 4312:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4313:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4314:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4315:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4316:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4317:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4318:    double *drag, double *roughness) {
 4319: 
 4320:    ELEM(pelem);
 4321:    Element &elem(*pelem);
 4322:    const int i = idx_elem;
 4323: 
 4324:    elem.idx = i;
 4325: 
 4326:    for (int j = 0; j < i34[i]; j++) {
 4327:       const int idxNode = elnode[i*4 + j];  
 4328:       const int idxSide = elside[i*4 + j];
 4329:       
 4330:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4331:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4332: 
 4333:       // Find the neighboring element  
 4334:       if (elem.sides[j]->elems[0] == &elem) {
 4335:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4336:       }
 4337:       else {
 4338:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4339:       }
 4340:       
 4341:    }
 4342: 
 4343:    elem.i34 = i34[i];
 4344: 
 4345:    // Compute the barycenter of the element and its depth
 4346:    elem.center = {0.0, 0.0};
 4347:    elem.depth = 1e10;
 4348:    for (int j = 0; j < i34[i]; j++) {
 4349: 
 4350:       elem.center += elem.nodes[j]->p/i34[i];
 4351:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4352:    }
 4353: 
 4354:    #ifdef USE_FRAMES
 4355:    elem.setFrame();
 4356:    #endif
 4357: 
 4358:    elem.area = elem.computeSignedArea(); 
 4359:    elem.radius = sqrt(elem.area)/pi; 
 4360:    
 4361:    // Determines which way the normal vector to each side is oriented.
 4362:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4363:    for (int j = 0; j < i34[i]; j++)  
 4364:    {
 4365:       if (elem.sides[j]->elems[0] == &elem) {
 4366:          elem.ssign[j] =  1.0;
 4367:       }
 4368:       else {
 4369:          elem.ssign[j] = -1.0;
 4370:       }
 4371: 
 4372:    }
 4373: 
 4374:   
 4375: 
 4376:    // Derivatives of shape functions
 4377:    //  For ics=2, this is done in the element frame
 4378:    //  For quads, the derivative is evaluated at centroid
 4379:    for (int j = 0; j < elem.i34; j++) {
 4380:       const double area = elem.area;
 4381:       const int id2 = elem.nxq(1 + j);
 4382:       const int id3 = elem.nxq(2 + j);
 4383:       const int id4 = elem.nxq(3 + j);
 4384:       if (elem.isTri()) {
 4385:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4386:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4387:          // da1/dx = (y1 - y2)/(2*area)
 4388: 
 4389:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4390:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4391:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4392: 
 4393:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4394:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4395: 
 4396:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4397: 
 4398:       }
 4399:       else  { // Quad; evaluate at centroid
 4400: 
 4401:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4402:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4403:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4404: 
 4405:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4406:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4407: 
 4408:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4409:       } // if Tri
 4410: 
 4411:    } // for j   
 4412:    
 4413:    
 4414: 
 4415: }
 4416: 
 4417: 
 4418: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4419:                                             double *emo, double *efa, 
 4420:                                             double *umo, double *ufa, 
 4421:                                             double *vmo, double *vfa,
 4422:                                             int *ifltype, int *iettype) {
 4423: 
 4424:    NODE_BND(nodeBnd);
 4425:    const int idx = idx_node_bnd;    
 4426: 
 4427:    nodeBnd->idx = idx;
 4428: 
 4429:    // Need to find the segment index and the index of the node on the segment
 4430:    int idxNode = -1;
 4431:    int iseg, i;
 4432:    for (iseg = 0; iseg < nope; iseg++) {
 4433:       // for each segment...
 4434:       for (i = 0; i < nond[iseg]; i++) {
 4435:          idxNode = iond[iseg + i*nope];
 4436:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4437:          
 4438:       }
 4439:    }
 4440: 
 4441:    assert(iseg < nope && "iseg is out of bounds");
 4442: 
 4443: found: // Jumped here when the node was found
 4444: 
 4445:    nodeBnd->isEssentialBC = true;
 4446:    nodeBnd->elbc = 0.0;
 4447: 
 4448:    nodeBnd->segment->ifltype = ifltype[iseg];
 4449:    nodeBnd->segment->iettype = iettype[iseg];
 4450: 
 4451:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4452: 
 4453:       const int idx2 = iseg*mnond*nbfr + i + jfr*mnond; //XXXXX CHECK
 4454:       nodeBnd->efa[jfr] = efa[idx2];
 4455:       nodeBnd->emo[jfr] = emo[idx2];
 4456:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4457:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4458: 
 4459:    }
 4460:         
 4461: 
 4462: }
 4463: 
 4464: __device__ void Mesh::populateBoundarySideLinks(void) {
 4465: 
 4466:    SIDE_BND(sideBnd);
 4467: 
 4468:    const Side *side = sideBnd->side;
 4469: 
 4470:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4471:    // and the rightSide is the side s that has s->n1 == side->n2
 4472:    for (int i = 0; i < mesh->nbs; i++) {
 4473: 
 4474:       Side *s = &mesh->localSideData[i];
 4475: 
 4476:       if (s == side) continue;  // Do not link the side to itself
 4477:    
 4478:       if (s->n1 == side->n2) sideBnd->leftSide = s;
 4479:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4480:    }
 4481:    
 4482: }
 4483: 
 4484: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4485:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4486:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4487:                 int *isdel, int *isidenode, int *isbnd,
 4488:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4489:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4490:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4491:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4492:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4493:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4494:                 double *drag, double *roughness,
 4495:                 double *emo, double *efa, 
 4496:                 double *umo, double *ufa, 
 4497:                 double *vmo, double *vfa) {
 4498: 
 4499:    printf("Populating mesh for partition %d\n", partNum);
 4500: 
 4501:    // XXXXXX THIS function does almost nothing. 
 4502: 
 4503:    nbs = *sharedIdxSideBoundary + 1;
 4504:    nbp = *sharedIdxNodeBoundary + 1;
 4505: 
 4506:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4507: 
 4508: }
 4509: 
 4510: 
 4511: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4512:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4513:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4514: 
 4515: 
 4516:    NODE(node1);
 4517: 
 4518:    node1->clearMatrixRow();
 4519:    node1->qel = 0.0;
 4520: 
 4521:    // THIS IS FOR STRUCTURES XXX
 4522:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4523: 
 4524:    
 4525:    for (int j=0; j<node1->numElements; j++) {
 4526:       // For each element connected to the node...
 4527: 
 4528:       Element *elem = node1->elements[j];
 4529: 
 4530: 
 4531: 
 4532:       // Compute the average gravity
 4533:       const double grav3 = elem->mean(&Node::grav2);
 4534: 
 4535:       // Look at the documentation for the description of the terms in the following integrals
 4536: 
 4537:       // Integral I_1 
 4538:       // \bar{\breve{H}} 
 4539:       const double hhatb = elem->mean(&Side::hhat);        
 4540: 
 4541:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4542: 
 4543:       const int id1 = elem->nodeLocalIdx(node1); 
 4544:       const double area = elem->area;
 4545: 
 4546:       if (elem->isTri()) {
 4547: 
 4548:          // To clarify the notation in this section: 
 4549:          //   i stands for the node under consideration (node1)
 4550:          //   j (node2) and k (node3) are the other nodes of the triangle.
 4551:          const int id2 = elem->nxq(1 + id1);
 4552:          const int id3 = elem->nxq(2 + id1);
 4553:          Node *node2 = elem->nodes[id2];
 4554:          Node *node3 = elem->nodes[id3];
 4555: 
 4556:          Point2 x1, x2, x3;
 4557:          elem->getLocalHorizontalNodePositionsTri(x1, x2, x3, id1);
 4558: 
 4559: 
 4560:          // integral of phi_i*phi_j
 4561:          const double ipp_ii = (1.0/6.0 )*area;
 4562:          const double ipp_ij = (1.0/12.0)*area;
 4563:          const double ipp_ik = (1.0/12.0)*area;
 4564: 
 4565:          // integral of [(grad phi_i) * (grad phi_j)]
 4566:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x3-x2, x3-x2);
 4567:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x3-x2, x1-x3);
 4568:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a*c = a*(a+b+c-c) = a*a + a*b.
 4569: 
 4570:          // Computes the different components of integral I_1 of each node with respect to node i.
 4571:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4572:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4573:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4574: 
 4575:          node1->addToSparseMatrix(node1, I1_ii);
 4576:          node1->addToSparseMatrix(node2, I1_ij); 
 4577:          node1->addToSparseMatrix(node3, I1_ik);
 4578: 
 4579:       }
 4580:       else { // Quad
 4581:          // XXX IMPLEMENT THIS
 4582:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4583: 
 4584:          // // To clarify the notation in this section: 
 4585:          // //   i stands for the node under consideration (node1)
 4586:          // //   j (node2), k (node3), l (node4) are the other nodes of the quad.
 4587:          // const int id2 = elem->nxq(1 + id1);
 4588:          // const int id3 = elem->nxq(2 + id1);
 4589:          // const int id4 = elem->nxq(3 + id1);
 4590:          // Node *node2 = elem->nodes[id2];
 4591:          // Node *node3 = elem->nodes[id3];
 4592:          // Node *node4 = elem->nodes[id4];         
 4593: 
 4594:          // // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4595:          // const double ipp_ii = elem->intPhiPhi(id1, id1);
 4596:          // const double ipp_ij = elem->intPhiPhi(id1, id2);
 4597:          // const double ipp_ik = elem->intPhiPhi(id1, id3);
 4598:          // const double ipp_il = elem->intPhiPhi(id1, id4);
 4599: 
 4600:          // // integrals of (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4601:          // const double igpgp_ii = elem->intGradPhiGradPhi(id1, id1);
 4602:          // const double igpgp_ij = elem->intGradPhiGradPhi(id1, id2);
 4603:          // const double igpgp_ik = elem->intGradPhiGradPhi(id1, id3);
 4604:          // const double igpgp_il = elem->intGradPhiGradPhi(id1, id4);
 4605: 
 4606:          // // Computes the different components of integral I_1 of each node with respect to node i.
 4607:          // const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4608:          // const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4609:          // const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4610:          // const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4611: 
 4612:          // node1->addToSparseMatrix(node1, I1_ii);
 4613:          // node1->addToSparseMatrix(node2, I1_ij); 
 4614:          // node1->addToSparseMatrix(node3, I1_ik);
 4615:          // node1->addToSparseMatrix(node4, I1_il);
 4616:   
 4617:       } 
 4618: 
 4619:  
 4620:       // Integral I_4
 4621:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4622:       // Where
 4623:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4624: 
 4625:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4626:       // of U over the element.
 4627:       Vector2 U = {0.0, 0.0};
 4628:       for (int m=0; m < elem->i34; m++) {      
 4629:          const Side *side = elem->sides[m];
 4630: 
 4631:          if constexpr(ics == 1) U += side->U; 
 4632:          else                   U += side->frame.projHorVec(side->U, elem->frame);  // In global coordinates, we must project the side velocity to the element frame
 4633: 
 4634:       }
 4635:       U = U/elem->i34;
 4636: 
 4637: 
 4638:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4639: 
 4640: 
 4641:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4642:       const double I_4_1 = dot(gradPhi_1, U);
 4643: 
 4644: 
 4645:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4646:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4647: 
 4648:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4649: 
 4650:       // Additional terms 
 4651:       double vnorm = 0.0;
 4652:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4653:          Vector3 ubed = {0.0, 0.0, 0.0};
 4654:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4655:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4656: 
 4657:          Vector3 gradP = {0.0, 0.0, 1.0};
 4658:          for (int m=0; m < elem->i34; m++) {
 4659:            const Vector2 gradP_2D = elem->nodes[m]->depth*elem->gradPhi[m];
 4660:            gradP += toVector3(gradP_2D, 0.0);
 4661:          }   
 4662:          vnorm = dot(ubed, gradP)/sqrt(dot(gradP, gradP));
 4663:       } // imm==2
 4664: 
 4665:       if (elem->isTri()) {
 4666:          for (int l=0; l<3; l++) {
 4667: 
 4668:             Node *node = elem->nodes[l];
 4669: 
 4670:             double fac = (node == node1) ? 2.0 : 1.0;
 4671:    
 4672:             if      constexpr(imm == 2) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + dt*vnorm);
 4673:             else if constexpr(imm == 1) node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2 + (node->bdef2 - node->bdef1)); 
 4674:             else                        node1->qel += (1.0/12.0)*elem->area*fac*(node->eta2); 
 4675:            
 4676:          }
 4677: 
 4678: 
 4679:          if (!elem->isDry) {
 4680:            const Vector2 gradEta = elem->grad2(&Node::eta2);
 4681: 
 4682:            node1->qel -= elem->area*grav3*dt*dt*thetai*(1.0 - thetai)*hhatb*dot(elem->gradPhi[id1], gradEta);
 4683: 
 4684:          }
 4685: 
 4686:       } // isTri
 4687:       else { // isQuad
 4688:          assert(false && "Quad not implemented in setupCoefficientMatrix");
 4689:          // for (int l=0; l<4; l++) {
 4690:          //   const Node *node = elem->nodes[l];
 4691: 
 4692:          //   if (imm==2) tmp2 = dt*vnorm; // b_t*dt
 4693:          //   else        tmp2 = node->bdef2 - node->bdef1;
 4694: 
 4695:          //   node1->qel += (node->eta2 + tmp2)*quad_int(1,ie,id,l) - 
 4696:          //                  node->eta2*grav3*thetai*(1.0 - thetai)*dt*dt*hhatb*quad_int(2,ie,id,l)
 4697:          // }
 4698: 
 4699:       } // isQuad
 4700: 
 4701: 
 4702:      node1->qel += (dt/elem->i34)*elem->vsource;
 4703:       
 4704: 
 4705:    } // for all elements connected to the node
 4706:    
 4707: 
 4708:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4709:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4710:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4711:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4712:       // If it is an open boundary node...
 4713: 
 4714:       // At least one open bnd side, maybe two
 4715:       for (int l=0; l<2; l++) { 
 4716: 
 4717:          // Gets each of the sides sharing the node. 
 4718:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4719: 
 4720:        
 4721: 
 4722:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4723:          if (sideBnd != nullptr) {
 4724:             // If the side is on a boundary...
 4725: 
 4726:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4727: 
 4728:             // Get the boundary segment
 4729:             const BoundarySegment *sideSegment = sideBnd->segment;
 4730:             const Side *side = sideBnd->side;
 4731: 
 4732:             // Integral I_3
 4733:             if (sideSegment->ifltype != 0) {
 4734:             // Natural or Flather b.c.
 4735: 
 4736:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4737:                // especially for Flather b.c.
 4738:                double ri3 = 0.0;
 4739:                if (!side->isDry) {
 4740:                   // If the side is not dry
 4741:                   
 4742:                   // Computes the side flux of (uth, vth)
 4743:                   double Vn = 0.0;
 4744:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4745:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4746:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4747: 
 4748:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4749:                   }
 4750: 
 4751:                   ri3 = 0.5*side->len*Vn;
 4752:                }
 4753: 
 4754:                if (sideSegment->ifltype == -1) { // Flather 1
 4755: 
 4756:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4757:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4758: 
 4759:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4760:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4761:                   
 4762:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4763:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4764: 
 4765:                } 
 4766:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4767:                   // Reset ri3
 4768:                   ri3 = 0.0;
 4769: 
 4770:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4771:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4772: 
 4773:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4774: 
 4775:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4776:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4777: 
 4778:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4779:                   node1->addToSparseMatrix(node1, con0*2.0);
 4780:                   node1->addToSparseMatrix(node2, con0);
 4781: 
 4782:                } // if Flather or Discharge
 4783: 
 4784:                node1->qel -= thetai*dt*ri3;
 4785: 
 4786: 
 4787:             } // I_3
 4788:           
 4789: 
 4790:             // Integral I_5
 4791:             if(!side->isDry) {
 4792: 
 4793:                const double Unbar = dot(side->U, side->n);
 4794:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar;
 4795: 
 4796:             } // I_5
 4797: 
 4798:          } // if is boundary side
 4799: 
 4800:       } // for l
 4801: 
 4802:    } // if isbnd
 4803: 
 4804: 
 4805: }
 4806: 
 4807: 
 4808: 
 4809: extern "C" {
 4810:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4811:                                   int* indices, int* indptr) {
 4812: 
 4813:       NODE(node);
 4814:       
 4815:       const int idx = node->idx;
 4816:       
 4817:       // Computes the index in the nzz array      
 4818:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4819: 
 4820: 
 4821:       indptr[idx] = nzzIdx;
 4822:       indices[nzzIdx] = idx;
 4823: 
 4824:       data_d[nzzIdx]    = node->coeffDiag;
 4825: 
 4826:       b_d[idx] = node->qel;
 4827: 
 4828:       for (int k = 0; k < node->numNodes; ++k) {
 4829:          const Node* nb = node->nodes[k];
 4830: 
 4831:          const int j = nb->idx;
 4832: 
 4833:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4834: 
 4835:          indices[nzzIdx + k + 1] = j;
 4836:       }
 4837: 
 4838:  
 4839:    }
 4840: 
 4841: 
 4842: 
 4843:    __global__ void solverCopyResult(double* x) {
 4844:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4845:       NODE(node);
 4846:       const int idx = node->idx;
 4847: 
 4848:       node->mX = x[idx];
 4849:    }
