  471: 
  472: __forceinline__ __device__ void computeLatLon(Point3 const &p, double &rlat, double &rlon) {
  473: // Given a 3D global point (may not be on the surface of the Earth), find its longitude and latitude in radians
  474: //
  475: 
  476:    const double radius2 = dot(p, p);
  477:    const double radius = sqrt(radius2);
  478:  
  479:    assert(radius != 0.0      && "computeLatLon: radius = 0");
  480:    assert(p.z*p.z <= radius2 && "computeLatLon: p.z <= radius");
  481: 
  482:    rlon = atan2(p.y, p.x); // (-pi,pi]
  483: 
  484:    if (abs(rearth_pole - rearth_eq) < 1.0e-2) { // for backward compatibility
  485:       rlat = asin(p.z/radius);
  486:    } else {
  487:       rlat = asin(p.z/rearth_pole);
  488:    }
  489:   
  490: }
  491: 
  492: 
  493: __forceinline__ __device__ Point3 computeXYZfromLatLon(double lat, double lon) {
  494: // Compute the 3D Cartesian coordinates from the latitude and longitude
  495: // Inputs:
  496: //        lat: latitude in radians
  497: //        lon: longitude in radians
  498: // Output:
  499: //        x, y, z: 3D Cartesian coordinates
  500: 
  501:    double sin_lat, cos_lat, sin_lon, cos_lon;
  502: 
  503:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeXYZfromLatLon: lat out of range");
  504:    assert(lon >= -pi     && lon <= pi &&     "computeXYZfromLatLon: lon out of range");
  505: 
  506:    sincos(lat, &sin_lat, &cos_lat);
  507:    sincos(lon, &sin_lon, &cos_lon);
  508: 
  509:    const double x = rearth_eq*cos_lat*cos_lon;
  510:    const double y = rearth_eq*cos_lat*sin_lon;
  511:    const double z = rearth_pole*sin_lat;
  512: 
  513:    return make_double3(x, y, z);
  514: }
