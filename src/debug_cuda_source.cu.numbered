 5401:    __global__ void computeTidalPotential(double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) {
 5402: 
 5403:       NODE(node);
 5404: 
 5405:       node->ETP = 0.0;
 5406: 
 5407:       if constexpr(ntip == 0) return;
 5408: 
 5409:       // For all tidal potential components
 5410:       for (int j=0; j<ntip; j++) {
 5411: 
 5412:          const double nodeETP = node->computeETP(j, time, tfreq, tamp, tnf, tear, jspc);
 5413: 
 5414:          node->ETP += nodeETP;
 5415: 
 5416:          if constexpr(iloadtide==1) { // loading tide
 5417:             assert(false && "Loading tide not implemented");
 5418:             // node->ETP += node->rloadtide[0,j]*cos(tfreq[j]*time - node->rloadtide[1,j]);
 5419:          }
 5420:          
 5421:       }
 5422: 
 5423:      
 5424:    }
