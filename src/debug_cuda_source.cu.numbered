 2578: __inline__ __device__ bool Element::containsPoint(Vector2 xt, const Side *origSide) const { 
 2579:    // Check if the point (xt,yt) is inside the element.
 2580:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2581:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (2)");
 2582: 
 2583:    double shpCoords[4];
 2584:    bool res = computeShapeCoords(xt, shpCoords, fiNo, origSide);
 2585: 
 2586:    return res;
 2587: }
 2588: 
 2589: __inline__ __device__ bool Element::containsPoint(Vector2 &xt, bool fixCoords, const Side *origSide) const { 
 2590:    // Check if the point (xt,yt) is inside the element.
 2591:    // If fixCoords is true, and *the point is inside the element*, the point is nudged to be inside the element.
 2592:    // if ics==2, origSide is used to convert the point to the starting point's frame.
 2593:    assert((ics==2 || origSide==nullptr) && "origSide must be nullptr if ics == 1 and vice versa (3)");
 2594: 
 2595:    double shpCoords[4];
 2596:    Vector2 tmp_xt = xt;
 2597:    const EFixIf fixIfCoords = fixCoords ? fiOnlyInside : fiNo;
 2598: printf("HEREEEEEE\n");
 2599:    bool res = computeShapeCoords(tmp_xt, shpCoords, fixIfCoords, origSide);
 2600: 
 2601:    if (fixCoords && res) xt = tmp_xt;
 2602: 
 2603:    return res;
 2604: }
