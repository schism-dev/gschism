 3601: 
 3602: __device__ __forceinline__ double Node::compZCoord(int k) const {
 3603:    // Computes the z coordinate at level k.
 3604:    // Depending on the vertical coordinate system, the z coordinate is computed differently.
 3605:    // When ivcor=1, the z coordinate is computed using the localized sigma levels.
 3606:    // When ivcor=2, the z coordinate is computed using the zeta/sigma levels. Z levels are
 3607:    // used 
 3608: 
 3609:    assert(k >= 0 && k < nvrt && "compZCoord: invalid level\n");
 3610:    
 3611:    // NOTE: Assumes that updateZCoordData() has been called before this function.
 3612: 
 3613:    if (isDry2()) return 0.0;  
 3614: 
 3615:    assert(htot2() > h0 && "compZCoord: invalid depth\n");
 3616: 
 3617:    if constexpr(ivcor == 2) {
 3618: 
 3619:       const double hmod2 = sigmaTransitionDepth(); // Depth transition between z and sigma levels
 3620:       const double h_c = mesh->h_c;
 3621:       const double theta_f = mesh->theta_f;
 3622:       const double sinh_theta_f = mesh->sinh_theta_f;
 3623: 
 3624: 
 3625:       // TODO: Here we are assuming that the bottom level, kbpl, was found in a previous step.
 3626:       // The FORTAN code computes it every time this function is called, but it should be done only 
 3627:       // once per time step/node. XXXX
 3628:       // CHECK: updateZCoordData
 3629: 
 3630:       //  To simplify comparisons, I define index versions of count variables.
 3631:       if      (k == ivrt)     return eta2; 
 3632:       else if (k == izlev)    return -hmod2;
 3633:       else if (k == kb)       return -depth;
 3634:       else if (k < izlev)     return mesh->ztot[k];
 3635:       else if (k > izlev) {
 3636:          const int ksig = k - izlev;
 3637: 
 3638:          if (hmod2 <= h_c) {
 3639:             return mesh->sigma[ksig] * (hmod2 + eta2) + eta2;
 3640: 
 3641:          } 
 3642:          else if (eta2 <= - h_c - (depth - h_c)*theta_f/sinh_theta_f) {
 3643:             printf("Please choose larger h_c: %f %f\n", eta2, h_c);
 3644:             assert(false && "compZCoord: invalid h_c\n");
 3645:          } 
 3646:          else {
 3647:             return eta2*(1.0 + mesh->sigma[ksig]) + 
 3648:                    h_c * mesh->sigma[ksig] + 
 3649:                    (hmod2 - h_c) * mesh->cs[ksig];
 3650:          }
 3651:       } else { 
 3652:          assert(false && "compZCoord: invalid level or coordinate system\n");
 3653:       }
 3654: 
 3655:    }
 3656:    else {  // if constexpr(ivcor == 1)
 3657:       if (k <= kb)        return -depth; 
 3658:       else if (k == ivrt) return eta2;
 3659:       else if (k > kb)    return (eta2 + depth)*localSigma[k] + eta2;
 3660: 
 3661:    }
 3662:    
 3663:    assert(false && "compZCoord: invalid level or coordinate system\n");
 3664:    return 0.0;
 3665: }
 3666: 
 3667: 
 3668: __device__ __forceinline__ void Node::computeBottomDragCd(void) {
 3669:    // Computes the bottom drag Cd based on the selected nchi
 3670: 
 3671:    if constexpr(nchi == 0) {
 3672:       // This line is repeated over and over again every time step, but it is very short, so it is not worth optimizing.
 3673:       Cd = drag;  // Read from drag file
 3674: 
 3675:    } else if constexpr(nchi == 1) {
 3676:       // 
 3677: 
 3678:       bool ltmp = false; // for WBL iteration
 3679: 
 3680:       assert(rough >= 0.0 && "computeBottomDragVegetation: rough < 0");
 3681:       if (isDry || (rough == 0.0)) {
 3682:          Cd = 0.0;
 3683: 
 3684:       } else { //roughness >0 
 3685:          
 3686:          const double bthick = max(dzb_min, z[kb + 1] - z[kb]); // thickness of bottom bnd layer 
 3687: 
 3688:          assert(bthick > rough && "computeBottomDragVegetation: bthick <= rough");
 3689: 
 3690:          Cd = 1.0/pow<2>((2.5*log(bthick/rough)));       
 3691: 
 3692:       } // if rough
 3693: 
 3694:    } else if constexpr(nchi == -1) {
 3695:    // Manning 
 3696:  
 3697:       const double htot = max(hmin_man, htot2()); 
 3698:       Cd = isDry ? 0.0 : grav2*rmanning*rmanning/pow(htot, 0.333);
 3699: 
 3700:    } else {
 3701:       assert(false && "computeBottomDragVegetation:selected nchi not implemented.");
 3702:       
 3703:    } // if nchi
 3704: 
 3705: }
 3706: 
 3707: 
 3708: __device__ int findSideBoundaryType(Side &side, int *iond, int *nond, int *ilnd, int *nlnd, bool &isLand) {
 3709:    // Checks if a side in on the boundary
 3710:    // For this it checks if it belongs to any of the boundary segments. They can be either land or open boundary segments.
 3711: 
 3712:    // Returns -1 if the side is not on the boundary, otherwise returns the index of the boundary segment.
 3713:    // isLand is set to true if the side is on a land boundary, otherwise it is set to false.
 3714: 
 3715:    // Indices of the nodes that form the side
 3716:    //
 3717:    // NOTE: This function is slow. It's to be called from "populate" functions, not from the main loop.
 3718:    const int n1 = side.n1->idx;
 3719:    const int n2 = side.n2->idx;
 3720:    isLand = false;
 3721:    
 3722: 
 3723:    // Check if the side is on a land boundary
 3724:    for (int i = 0; i < nland; i++) {
 3725:       for (int j = 0; j < nlnd[i] - 1; j++) {
 3726:          // Consecutive nodes in the land boundary segment
 3727:          const int b1 = ilnd[i + j*nland];
 3728:          const int b2 = ilnd[i + (j + 1)*nland];
 3729: 
 3730:          assert(b1 != -1 && b2 != -1);
 3731: 
 3732:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3733:             
 3734:             isLand = true;
 3735:             return i;
 3736:          }
 3737:       }
 3738:    }
 3739: 
 3740:    // Check if the side is on an open boundary
 3741:    for (int i = 0; i < nope; i++) {
 3742:       for (int j = 0; j < nond[i] - 1; j++) {
 3743:          // Consecutive nodes in the open boundary segment
 3744:          const int b1 = iond[i + j*nope];
 3745:          const int b2 = iond[i + (j + 1)*nope];
 3746: 
 3747:          assert(b1 != -1 && b2 != -1);
 3748: 
 3749:          if ((b1 == n1 && b2 == n2) || (b1 == n2 && b2 == n1)) {
 3750:             isLand = false;
 3751:             return i;
 3752:          }
 3753:       }
 3754:    }
 3755: 
 3756:    return -1;
 3757: }
 3758: 
 3759: 
 3760: __device__ void Mesh::populateNodes(int *i34, int *isbnd, int *sharedIdxNodeBoundary,
 3761:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3762:                                     double *wind_rotate_angle, 
 3763:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3764:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3765:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3766:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3767:                                     double *drag, double *roughness, double *rmanning, int *kb, double *localSigma) {
 3768: 
 3769:    NODE(pnode);  
 3770:    const int i = idx_node;
 3771:    Node &node(*pnode);
 3772: 
 3773:    node.idx = i;
 3774: 
 3775:    const int idxNodeStart = nodeNeighNodesStart[i];
 3776:    const int idxNodeEnd   = nodeNeighNodesStart[i+1];
 3777:    node.numNodes = idxNodeEnd - idxNodeStart;
 3778:    node.nodes = nodeNeighNodes + idxNodeStart;
 3779:    node.coeffMatrix = coeffMatrixMem + idxNodeStart;
 3780: 
 3781: 
 3782: 
 3783:    const int idxElemStart = nodeNeighElemsStart[i];
 3784:    const int idxElemEnd   = nodeNeighElemsStart[i+1];      
 3785:    node.numElements = idxElemEnd - idxElemStart;
 3786:    node.elements = nodeNeighElems + idxElemStart;
 3787: 
 3788: 
 3789:    for (int idx = idxNodeStart; idx < idxNodeEnd; idx++) {
 3790:       const int idxNodeGlobal = nodeNeighNodesIndices[idx];
 3791:       const int partNode = localNodePart[idxNodeGlobal]; 
 3792:       const int idxNode  = localNodeIndices[idxNodeGlobal];
 3793: 
 3794:       Node *node_ptr = nodes[partNode] + idxNode;
 3795:       
 3796:       nodeNeighNodes[idx] = node_ptr;
 3797:    }
 3798: 
 3799: 
 3800:    for (int idx = idxElemStart; idx < idxElemEnd; idx++) {
 3801:       const int idxElemGlobal = nodeNeighElemsIndices[idx];
 3802:       const int partElem = localElemPart[idxElemGlobal];
 3803:       const int idxElem  = localElemIndices[idxElemGlobal];
 3804: 
 3805:       Element *elem_ptr = elems[partElem] + idxElem;
 3806: 
 3807:       nodeNeighElems[idx] = elem_ptr;
 3808:    }      
 3809: 
 3810:    // Compute the cosine and sine of the mesh rotation angle. We use float here because memory efficiency is more important than precision in this case.
 3811:    assert(wind_rotate_angle[i] >= -pi && wind_rotate_angle[i] <= pi && "wind_rotate_angle out of range");
 3812: 
 3813:    sincosf(-(float)wind_rotate_angle[i], &node.sRot, &node.cRot);
 3814: 
 3815:    // Fills the node coordinates. If ics == 1, the coordinates are in the local frame. If ics == 2, the coordinates are in the global frame.
 3816:    if constexpr(ics == 1) {
 3817:       node.p.x   = node_coords[i * 3];
 3818:       node.p.y   = node_coords[i * 3 + 1];
 3819:       node.gz = 0.0;
 3820: 
 3821:       if (use_ll) {                                    // <-- add
 3822:          node.lon = node_coords_ll[i * 2    ]*deg2rad; // <-- add
 3823:          node.lat = node_coords_ll[i * 2 + 1]*deg2rad; // <-- add
 3824:       }  
 3825: 
 3826:    } else {
 3827:       const double lon = deg2rad*node_coords[i * 3];
 3828:       const double lat = deg2rad*node_coords[i * 3 + 1];
 3829: 
 3830:       Point3 p = computeXYZfromLatLon(lat, lon);
 3831:       node.p = toVector2(p);
 3832:       node.gz = p.z;
 3833:       node.lon = lon;
 3834:       node.lat = lat;
 3835: 
 3836:       #ifdef USE_FRAMES
 3837:       node.setFrame(lat, lon);
 3838:       #endif
 3839: 
 3840: 
 3841:    }
 3842: 
 3843:    node.depth = node_coords[i * 3 + 2];
 3844: 
 3845:    node.numSides = 0;
 3846: 
 3847:    // drag, rough, and manning are actually stored in the same memory location. This is just sugar to make the code more readable without using unnecessary memory.
 3848:    if      constexpr(nchi ==  0) node.drag     = drag[i];
 3849:    else if constexpr(nchi ==  1) node.rough    = roughness[i];
 3850:    else if constexpr(nchi == -1) node.rmanning = rmanning[i];
 3851:    else assert(false && "populateNodes: selected nchi not implemented.");
 3852:    
 3853:    if constexpr(ivcor == 1) 
 3854:    {  
 3855:       node.kb = kb[i];
 3856: 
 3857:       for (int k = 0; k < nvrt; k++) node.localSigma[k] = localSigma[k + i*nvrt];
 3858:    }
 3859: 
 3860:    for (int k = 0; k < nvrt; k++) node.rho[k] = rho0;
 3861:    for (int k = 0; k < nvrt; k++) node.z[k] = 0.0;
 3862:    for (int k = 0; k < nvrt; k++) node.dfv[k] = dfv0;   // XXXX 
 3863: 
 3864:    
 3865:    // Links the node to the boundary information
 3866:    if (isbnd[i] >= 0) {
 3867:      
 3868:       // Get the index of the node boundary
 3869:       const int idxNodeBoundary = atomicAdd(sharedIdxNodeBoundary, 1) + 1;
 3870: 
 3871:       node.nodeBnd = &(localNodeBoundaryMem[idxNodeBoundary]);
 3872:       node.nodeBnd->node = &node;
 3873: 
 3874:       node.nodeBnd->sideBnd1 = nullptr;
 3875:       node.nodeBnd->sideBnd2 = nullptr;
 3876: 
 3877:       if (isbnd[i]>=0) {
 3878: 
 3879:          node.nodeBnd->segment = &(localSegmentMem[isbnd[i]]);
 3880:          
 3881:          node.nodeBnd->segment->ifltype = 0; //(isbnd[i]==0)?3:0; // XXXXX KKKKK
 3882:          node.nodeBnd->segment->iettype = 0; // XXXXXXXXX
 3883: 
 3884:          // Initialize the length and area of the segment to nan to indicate that they are not yet computed
 3885:          node.nodeBnd->segment->clen  = nan("1");
 3886:          node.nodeBnd->segment->carea = nan("1");
 3887: 
 3888:       }
 3889:    } else {
 3890: 
 3891:       node.nodeBnd = nullptr; // For internal nodes
 3892: 
 3893:       if (isbnd[i] == landSegment) {
 3894:          node.nodeBnd = &landBoundaryNode;
 3895:          node.nodeBnd->segment = &landBoundarySegment;
 3896:       }
 3897:       
 3898:    }
 3899:    
 3900:    // XXXX GAUSSIAN HILL VELOCITIES
 3901:    #ifdef GAUSSIAN_HILL_VELOCITIES
 3902:          if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 3903:          constexpr double rot_per = 3000.0;
 3904:          constexpr double rot_f = 0.0*2.0*pi/rot_per;
 3905:          for (int k = 0; k < nvrt; k++) { node.u2[k] = {-node.p.y*rot_f, node.p.x*rot_f}; node.w2[k] = 0.0; }
 3906:       // XXXXX
 3907:    #endif
 3908: 
 3909: }
 3910: 
 3911: 
 3912: __device__ void Mesh::populateSides(int *i34, int *sharedIdxSideBoundary,
 3913:                                     double *node_coords, double *node_coords_ll, bool use_ll,
 3914:                                     double *wind_rotate_angle,   
 3915:                                     int *isdel, int *isidenode, int *isbnd,
 3916:                                     int *nond, int *nlnd, int *iond, int *ilnd,                                  
 3917:                                     int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 3918:                                     int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 3919:                                     int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 3920:                                     int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 3921:                                     int *localNodePart,     int *localElemPart,     int *localSidePart,
 3922:                                     double *drag, double *roughness) {
 3923: 
 3924: 
 3925:    SIDE(pside);
 3926:    Side &side(*pside);
 3927:    const int i = idx_side;
 3928: 
 3929:    side.idx = i;  
 3930:    
 3931:    // Parameters used to compute a linear approximation of the Coriolis coefficient around the reference latitude sfea0
 3932:    const double fc   = 2.0*omega_e*sin(sfea0);
 3933:    const double beta = 2.0*omega_e*cos(sfea0);
 3934: 
 3935:    assert(sfea0 >= -pi/2.0 && sfea0 <= pi/2.0 && "GRID: sfea0 out of range");
 3936: 
 3937:    // finding the pointer to the nodes that form the side
 3938:    const int idx_n1 = isidenode[globalSideIndices[i]*2];
 3939:    const int idx_n2 = isidenode[globalSideIndices[i]*2 + 1];
 3940: 
 3941:    const int locidx_n1 = localNodeIndices[idx_n1];
 3942:    const int locidx_n2 = localNodeIndices[idx_n2];
 3943:    const int part_n1 =   localNodePart[idx_n1];
 3944:    const int part_n2 =   localNodePart[idx_n2];
 3945: 
 3946:    side.n1 = (Node *)&(mesh->nodes[part_n1][locidx_n1]);
 3947:    side.n2 = (Node *)&(mesh->nodes[part_n2][locidx_n2]);
 3948: 
 3949: 
 3950:    // Counts the number of sides connected to each node
 3951:    side.n1->numSides++;
 3952:    side.n2->numSides++;
 3953: 
 3954:    // Side boundary type
 3955:    NodeBoundary *n1bnd = side.n1->nodeBnd;
 3956:    NodeBoundary *n2bnd = side.n2->nodeBnd;
 3957: 
 3958:    if (n1bnd != nullptr && n2bnd != nullptr) 
 3959:    // If both nodes are on the boundary, then the side may be on the boundary (Notice that there are cases where the side is not on the boundary, but both nodes are on the boundary)
 3960:    {
 3961:       bool isLand = false;
 3962:       int isbs = findSideBoundaryType(side, iond, nond, ilnd, nlnd, isLand);
 3963:       
 3964:       if (isbs > -1) {
 3965:          // assert(isLand || isbs>=0);
 3966:          const int idxSideBoundary = atomicAdd(sharedIdxSideBoundary, 1) + 1;
 3967: 
 3968:          side.sideBnd = &(localSideBoundaryMem[idxSideBoundary]);
 3969: 
 3970:          if   (isLand) side.sideBnd->segment = &landBoundarySegment;
 3971:          else          side.sideBnd->segment = &(localSegmentMem[isbs]);
 3972: 
 3973:          assert (isLand == side.sideBnd->segment->isLand);
 3974: 
 3975:          // Links each node boundary to the side boundary using the first available side boundary pointer
 3976:          if (n1bnd->sideBnd1 == nullptr) n1bnd->sideBnd1 = side.sideBnd;
 3977:          else                            n1bnd->sideBnd2 = side.sideBnd;
 3978: 
 3979:          if (n2bnd->sideBnd1 == nullptr) n2bnd->sideBnd1 = side.sideBnd;
 3980:          else                            n2bnd->sideBnd2 = side.sideBnd;
 3981:          
 3982:          side.sideBnd->side = &side;
 3983: 
 3984:       }
 3985:       else {
 3986:          side.sideBnd = nullptr;
 3987:       }
 3988:    }
 3989:    else 
 3990:    {
 3991:       side.sideBnd = nullptr;
 3992:    }
 3993: 
 3994: 
 3995:    // finding the pointer to the elements that share the side
 3996:    const int idx_e1 = isdel[globalSideIndices[i]*2];
 3997:    const int idx_e2 = isdel[globalSideIndices[i]*2 + 1];
 3998: 
 3999:    if (idx_e1 > -1) {
 4000:       const int locidx_e1 = localElemIndices[idx_e1];
 4001:       const int part_e1 =  localElemPart[idx_e1];
 4002:       side.elems[0] = elems[part_e1] + locidx_e1;
 4003: 
 4004:    }
 4005:    else {
 4006:       side.elems[0] = nullptr;
 4007:    }
 4008: 
 4009:    if (idx_e2 > -1) {
 4010:       const int locidx_e2 = localElemIndices[idx_e2];
 4011:       const int part_e2 =  localElemPart[idx_e2];
 4012:       side.elems[1] = elems[part_e2] + locidx_e2;
 4013:    }
 4014:    else {
 4015:       side.elems[1] = nullptr;
 4016:    }
 4017:    if (side.elems[1] == nullptr && side.sideBnd == nullptr) {
 4018:       
 4019:       NodeBoundary *n1bnd = side.n1->nodeBnd;
 4020:       NodeBoundary *n2bnd = side.n2->nodeBnd;
 4021:       printf("Side %d has no elements and no boundary. Types = %p, %p\n", i, n1bnd, n2bnd);
 4022:          
 4023:       // printf("idx_e1: %d, idx_e2: %d\n", idx_e1, idx_e2);
 4024:       // printf("elems[0]: %p, elems[1]: %p\n", side.elems[0], side.elems[1]);
 4025:       // printf("sideBnd: %p\n", side.sideBnd);
 4026:       // assert(false && "Side has no elements and no boundary");
 4027:    }
 4028:    // assert(side.elems[1] != nullptr || side.sideBnd != nullptr);
 4029: 
 4030:    // Compute the center of the side
 4031:    side.center = 0.5*(side.n1->p + side.n2->p);
 4032: 
 4033:    #ifdef USE_FRAMES
 4034:    side.setFrame();
 4035:    #endif
 4036: 
 4037:    // Normal, unitary vector to the side
 4038:    if constexpr(ics == 1) {
 4039:       side.n = { -(side.n1->p.y - side.n2->p.y), (side.n1->p.x - side.n2->p.x)};
 4040:       side.n = normalize(side.n);
 4041:    }
 4042:    else {
 4043:       // Unit side vector in 3D cartesian coordinates
 4044:       Vector3 nSide = { side.n1->p.x - side.n2->p.x, side.n1->p.y - side.n2->p.y, side.n1->gz - side.n2->gz };
 4045: 
 4046:       nSide = normalize(nSide);
 4047: 
 4048:       // Its cross product with the unit local z-axis vector (nUp) is the
 4049:       // normal vector we are looking for.
 4050:       Vector3 n3D = normalize(cross(nSide, side.frame.nUp()));  
 4051: 
 4052:       // The 2D components can be obtained by projecting the 3D normal vector to the plane defined by the unit vectors nZonal and nMeridional
 4053:       const Vector2 n2D = {dot(n3D, side.frame.nZonal()), dot(n3D, side.frame.nMeridional())};
 4054:       side.n = -normalize(n2D); 
 4055: 
 4056:    }
 4057: 
 4058:    assert(ishapiro == 1 && "Only shapiro = 1 is implemented");
 4059:    side.shapiro = shapiro0;
 4060: 
 4061:    #ifdef GAUSSIAN_HILL_VELOCITIES
 4062:    // XXXX
 4063:    if (i == 0) printf("GAUSSIAN HILL VELOCITIES!!!\n");
 4064:    constexpr double rot_per=3000.0;
 4065:    constexpr double rot_f=0.0*2.0*pi/rot_per;/// XXXX
 4066:    for (int k = 0; k < nvrt; k++) side.u2[k] = {-side.center.y*rot_f , side.center.x*rot_f};
 4067:    // XXXXX      
 4068:    #endif
 4069:    // Compute the z level at the center of the side
 4070:    for (int k = 0; k < nvrt; k++) side.zc[k] = 0.5*(side.n1->z[k] + side.n2->z[k]);  // XXXX substitute by computation?
 4071:    
 4072:    // Compute the length of the side
 4073:    side.len = length(toPoint3(side.n2->p, side.n2->gz) - toPoint3(side.n1->p, side.n1->gz));
 4074: 
 4075: 
 4076:    // Compute the Coriolis coefficient
 4077: 
 4078:    if constexpr(ncor == -1 || ncor == 0) {
 4079:       side.coriolis = coricoef;
 4080:    }
 4081:    else {
 4082:       const double sphi = side.lat();  // Latitude at the center of the side
 4083: 
 4084:       assert(use_ll && "use_ll must be true when ncor > 0");
 4085: 
 4086:       if constexpr(ics == 1) {
 4087:          side.coriolis = fc + beta*(sphi - sfea0);  // First order Taylor expansion of the Coriolis coefficient around the reference latitude sfea0
 4088:       }
 4089:       else { // ics == 2
 4090:          assert(sphi >= -pi/2.0 && sphi <= pi/2.0 && "GRID: sphi out of range");
 4091:          side.coriolis = 2.0*omega_e*sin(sphi);  
 4092:       }
 4093: 
 4094:    }
 4095: 
 4096: }
 4097: 
 4098: 
 4099: __device__ void Mesh::populateElements(int *i34, int *elnode, int *elside,
 4100:    double *node_coords, double *node_coords_ll, bool use_ll,
 4101:    double *wind_rotate_angle,   
 4102:    int *isdel, int *isidenode, int *isbnd,
 4103:    int *nond, int *nlnd, int *iond, int *ilnd,                                  
 4104:    int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4105:    int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4106:    int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4107:    int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4108:    int *localNodePart,     int *localElemPart,     int *localSidePart,
 4109:    double *drag, double *roughness) {
 4110: 
 4111:    ELEM(pelem);
 4112:    Element &elem(*pelem);
 4113:    const int i = idx_elem;
 4114: 
 4115:    elem.idx = i;
 4116: 
 4117:    for (int j = 0; j < i34[i]; j++) {
 4118:       const int idxNode = elnode[i*4 + j];  
 4119:       const int idxSide = elside[i*4 + j];
 4120:       
 4121:       elem.nodes[j] = (Node *)&(nodes[localNodePart[idxNode]][localNodeIndices[idxNode]]);
 4122:       elem.sides[j] = (Side *)&(sides[localSidePart[idxSide]][localSideIndices[idxSide]]);
 4123: 
 4124:       // Find the neighboring element  
 4125:       if (elem.sides[j]->elems[0] == &elem) {
 4126:          elem.nghbElems[j] = elem.sides[j]->elems[1];
 4127:       }
 4128:       else {
 4129:          elem.nghbElems[j] = elem.sides[j]->elems[0];
 4130:       }
 4131:       
 4132:    }
 4133: 
 4134:    elem.i34 = i34[i];
 4135: 
 4136:    // Compute the barycenter of the element and its depth
 4137:    elem.center = {0.0, 0.0};
 4138:    elem.depth = 1e10;
 4139:    for (int j = 0; j < i34[i]; j++) {
 4140: 
 4141:       elem.center += elem.nodes[j]->p/i34[i];
 4142:       elem.depth  = min(elem.depth, elem.nodes[j]->depth);
 4143:    }
 4144: 
 4145:    #ifdef USE_FRAMES
 4146:    elem.setFrame();
 4147:    #endif
 4148: 
 4149:    elem.area = elem.computeSignedArea(); 
 4150:    elem.radius = sqrt(elem.area)/pi; 
 4151:    
 4152:    // Determines which way the normal vector to each side is oriented.
 4153:    // The orientation means that for each side, elems[0] points to elems[1]. In the boundary this guarantees that the normal vector is pointing outwards.
 4154:    for (int j = 0; j < i34[i]; j++)  
 4155:    {
 4156:       if (elem.sides[j]->elems[0] == &elem) {
 4157:          elem.ssign[j] =  1.0;
 4158:       }
 4159:       else {
 4160:          elem.ssign[j] = -1.0;
 4161:       }
 4162: 
 4163:    }
 4164: 
 4165:   
 4166: 
 4167:    // Derivatives of shape functions
 4168:    //  For ics=2, this is done in the element frame
 4169:    //  For quads, the derivative is evaluated at centroid
 4170:    for (int j = 0; j < elem.i34; j++) {
 4171:       const double area = elem.area;
 4172:       const int id2 = elem.nxq(1 + j);
 4173:       const int id3 = elem.nxq(2 + j);
 4174:       const int id4 = elem.nxq(3 + j);
 4175:       if (elem.isTri()) {
 4176:          // This expression can be derived from the derivatives of the shape functions in area coordinates.
 4177:          // a_1 = [(x2 - x)(y1 - y) - (x1 - x)(y2 - y)]/(2*area)
 4178:          // da1/dx = (y1 - y2)/(2*area)
 4179: 
 4180:          // Get the horizontal coordinates of the nodes id2 and id3 in the local frame
 4181:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4182:          const Point2 p3 = elem.getLocalHorizontalNodePosition(id3);
 4183: 
 4184:          const double dPhi_j_dx = (p2.y - p3.y)/(2*area); 
 4185:          const double dPhi_j_dy = (p3.x - p2.x)/(2*area); 
 4186: 
 4187:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4188: 
 4189:       }
 4190:       else  { // Quad; evaluate at centroid
 4191: 
 4192:          // Get the horizontal coordinates of the nodes id2 and id4 in the local frame
 4193:          const Point2 p2 = elem.getLocalHorizontalNodePosition(id2);
 4194:          const Point2 p4 = elem.getLocalHorizontalNodePosition(id4);
 4195: 
 4196:          const double dPhi_j_dx = (p2.y - p4.y)/(2*area); 
 4197:          const double dPhi_j_dy = (p4.x - p2.x)/(2*area); 
 4198: 
 4199:          elem.gradPhi[j] = {dPhi_j_dx, dPhi_j_dy};
 4200:       } // if Tri/Quad
 4201: 
 4202:    } // for j   
 4203:    
 4204:    
 4205: 
 4206: }
 4207: 
 4208: 
 4209: __device__ void Mesh::populateBoundaryNodes(int *nond, int *iond,
 4210:                                             double *emo, double *efa, 
 4211:                                             double *umo, double *ufa, 
 4212:                                             double *vmo, double *vfa,
 4213:                                             int *ifltype, int *iettype) {
 4214: 
 4215:    NODE_BND(nodeBnd);
 4216:    const int idx = idx_node_bnd;    
 4217: 
 4218:    nodeBnd->idx = idx;
 4219: 
 4220:    // Need to find the segment index and the index of the node on the segment
 4221:    int idxNode = -1;
 4222:    int iseg, i;
 4223:    for (iseg = 0; iseg < nope; iseg++) {
 4224:       // for each segment...
 4225:       for (i = 0; i < nond[iseg]; i++) {
 4226:          idxNode = iond[iseg + i*nope];
 4227:          if (idxNode == nodeBnd->node->idx) goto found; // Cleanest way to exit the double loop
 4228:          
 4229:       }
 4230:    }
 4231: 
 4232:    assert(iseg < nope && "iseg is out of bounds");
 4233: 
 4234: found: // Jumped here when the node was found
 4235: 
 4236:    nodeBnd->isEssentialBC = true;
 4237:    nodeBnd->elbc = 0.0;
 4238: 
 4239:    nodeBnd->segment->ifltype = ifltype[iseg];
 4240:    nodeBnd->segment->iettype = iettype[iseg];
 4241: 
 4242:    for (int jfr = 0; jfr < nbfr; jfr++) {
 4243: 
 4244:       const int idx2 = iseg + i*nope + jfr*nope*mnond; 
 4245: 
 4246:       nodeBnd->efa[jfr] = efa[idx2];
 4247:       nodeBnd->emo[jfr] = emo[idx2];
 4248:       nodeBnd->umo[jfr] = {umo[idx2], vmo[idx2]};
 4249:       nodeBnd->ufa[jfr] = {ufa[idx2], vfa[idx2]};
 4250: 
 4251:    }
 4252:         
 4253: 
 4254: }
 4255: 
 4256: __device__ void Mesh::populateBoundarySideLinks(void) {
 4257: 
 4258:    SIDE_BND(sideBnd);
 4259: 
 4260:    const Side *side = sideBnd->side;
 4261: 
 4262:    // We assume that the leftSide is the side s that has s->n2 == side->n1
 4263:    // and the rightSide is the side s that has s->n1 == side->n2
 4264:    for (int i = 0; i < mesh->nbs; i++) {
 4265: 
 4266:       Side *s = &mesh->localSideData[i];
 4267: 
 4268:       if (s == side) continue;  // Do not link the side to itself
 4269:    
 4270:       if (s->n1 == side->n2) sideBnd->leftSide  = s;
 4271:       if (s->n2 == side->n1) sideBnd->rightSide = s;
 4272:    }
 4273:    
 4274: }
 4275: 
 4276: __device__ void Mesh::populateMesh(int *i34, int *elnode, int *elside,
 4277:                 double *node_coords, double *node_coords_ll, bool use_ll,
 4278:                 double *wind_rotate_angle, int *sharedIdxNodeBoundary, int *sharedIdxSideBoundary,
 4279:                 int *isdel, int *isidenode, int *isbnd,
 4280:                 int *nond, int *nlnd, int *iond, int *ilnd, 
 4281:                 int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 4282:                 int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 4283:                 int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 4284:                 int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 4285:                 int *localNodePart,     int *localElemPart,     int *localSidePart,
 4286:                 double *drag, double *roughness,
 4287:                 double *emo, double *efa, 
 4288:                 double *umo, double *ufa, 
 4289:                 double *vmo, double *vfa) {
 4290: 
 4291:    printf("Populating mesh for partition %d\n", partNum);
 4292: 
 4293:    // XXXXXX THIS function does almost nothing. 
 4294: 
 4295:    nbs = *sharedIdxSideBoundary + 1;
 4296:    nbp = *sharedIdxNodeBoundary + 1;
 4297: 
 4298:    nEntries = (nodeNeighNodesStart[nbp] - nodeNeighNodesStart[0]) + nbp;
 4299: 
 4300: }
 4301: 
 4302: 
 4303: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 4304:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 4305:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 4306: 
 4307: 
 4308:    NODE(node1);
 4309: 
 4310:    node1->clearMatrixRow();
 4311:    node1->qel = 0.0;
 4312: 
 4313:    // THIS IS FOR STRUCTURES XXX
 4314:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 4315: 
 4316:    
 4317:    for (int j=0; j<node1->numElements; j++) {
 4318:       // For each element connected to the node...
 4319: 
 4320:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 4321: 
 4322:       Element *elem = node1->elements[j];
 4323: 
 4324:       // Compute the average gravity
 4325:       const double grav3 = elem->mean(&Node::grav2);
 4326: 
 4327:       // Look at the documentation for the description of the terms in the following integrals
 4328: 
 4329:       // Integral I_1 
 4330:       // \bar{\breve{H}} 
 4331:       const double hhatb = elem->mean(&Side::hhat);        
 4332: 
 4333:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 4334: 
 4335:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 4336:       const double area = elem->area;
 4337: 
 4338:       // Integral I_4
 4339:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 4340:       // Where
 4341:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 4342: 
 4343:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 4344:       // of U over the element.
 4345:       const Vector2 U = elem->mean(&Side::U);
 4346: 
 4347:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 4348: 
 4349:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 4350:       const double I_4_1 = dot(gradPhi_1, U);
 4351: 
 4352: 
 4353:       // Integral of \nabla\phi_i \cdot \pmb{E}
 4354:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 4355: 
 4356:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 4357: 
 4358: 
 4359:       // Normal component of the bed velocity
 4360:       double ubedNormalComp = 0.0;
 4361:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 4362:          Vector3 ubed = {0.0, 0.0, 0.0};
 4363:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 4364:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 4365: 
 4366:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 4367:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 4368:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 4369: 
 4370:          // Computes the normal component of the bed velocity
 4371:          ubedNormalComp = dot(ubed, N);
 4372:       } // imm==2
 4373: 
 4374:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 4375: 
 4376:       if (elem->isTri()) {
 4377: 
 4378:          // To clarify the notation in this section: 
 4379:          //   In formulas, we use the following notation:
 4380:          //       i stands for the node under consideration (node1)
 4381:          //       j (node2) and k (node3) are the other nodes of the triangle.
 4382:          //   However, in the code, we use the following notation:
 4383:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 4384:          const int id2 = elem->nxq(1 + id1);
 4385:          const int id3 = elem->nxq(2 + id1);
 4386:          Node *node2 = elem->nodes[id2];
 4387:          Node *node3 = elem->nodes[id3];
 4388: 
 4389:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 4390: 
 4391:          // integral of phi_i*phi_j
 4392:          const double ipp_ii = (1.0/6.0 )*area;
 4393:          const double ipp_ij = (1.0/12.0)*area;
 4394:          const double ipp_ik = (1.0/12.0)*area;
 4395: 
 4396:          // integral of [(grad phi_i) * (grad phi_j)]
 4397:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 4398:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 4399:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 4400: 
 4401:          // Computes the different components of integral I_1 of each node with respect to node i.
 4402:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4403:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4404:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4405: 
 4406:          node1->addToSparseMatrix(node1, I1_ii);
 4407:          node1->addToSparseMatrix(node2, I1_ij); 
 4408:          node1->addToSparseMatrix(node3, I1_ik);
 4409: 
 4410:          #pragma unroll
 4411:          for (int l=0; l<3; l++) {
 4412: 
 4413:             Node *node = elem->nodes[l];
 4414: 
 4415:             // Additional variation in eta due to bed deformation or vertical velocity
 4416:             double extraEta = 0.0;
 4417:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4418:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 4419: 
 4420: 
 4421:             const double ipp   = elem->intPhiPhiTri(id1, l);
 4422:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 4423: 
 4424:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 4425: 
 4426:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 4427:            
 4428:          }
 4429: 
 4430: 
 4431:       }
 4432:       else { // Quad
 4433:          // To clarify the notation in this section: 
 4434:          //   In formulas, we use the following notation:
 4435:          //       i stands for the node under consideration (node1)
 4436:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 4437:          //   However, in the code, we use the following notation:
 4438:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 4439:          const int id2 = elem->nxq(1 + id1);
 4440:          const int id3 = elem->nxq(2 + id1);
 4441:          const int id4 = elem->nxq(3 + id1);
 4442:          Node *node2 = elem->nodes[id2];
 4443:          Node *node3 = elem->nodes[id3];
 4444:          Node *node4 = elem->nodes[id4];   
 4445:          
 4446:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 4447: 
 4448:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 4449:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 4450:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 4451:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 4452:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 4453: 
 4454:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 4455:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 4456:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 4457:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 4458:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 4459: 
 4460: 
 4461:          // Computes the different components of integral I_1 of each node with respect to node i.
 4462:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 4463:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 4464:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 4465:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 4466: 
 4467:          node1->addToSparseMatrix(node1, I1_ii);
 4468:          node1->addToSparseMatrix(node2, I1_ij); 
 4469:          node1->addToSparseMatrix(node3, I1_ik);
 4470:          node1->addToSparseMatrix(node4, I1_il);
 4471:   
 4472:          #pragma unroll
 4473:          for (int l=0; l<4; l++) {
 4474: 
 4475:             const Node *node = elem->nodes[l];
 4476: 
 4477:             // Additional variation in eta due to bed deformation or vertical velocity
 4478:             double extraEta = 0.0;
 4479:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 4480:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 4481: 
 4482:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 4483:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 4484:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 4485: 
 4486:          }         
 4487:       } 
 4488: 
 4489: 
 4490:      node1->qel += (dt/elem->i34)*elem->vsource;
 4491:       
 4492: 
 4493:    } // for all elements connected to the node
 4494:    
 4495: 
 4496:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 4497:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 4498:    NodeBoundary *nodeBnd = node1->nodeBnd;
 4499:    if (nodeBnd != nullptr && nodeBnd != &(mesh->landBoundaryNode))  { 
 4500:       // If it is an open boundary node...
 4501: 
 4502:       // At least one open bnd side, maybe two
 4503:       for (int l=0; l<2; l++) { 
 4504: 
 4505:          // Gets each of the sides sharing the node. 
 4506:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 4507: 
 4508:        
 4509: 
 4510:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 4511:          if (sideBnd != nullptr) {
 4512:             // If the side is on a boundary...
 4513: 
 4514:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 4515: 
 4516:             // Get the boundary segment
 4517:             const BoundarySegment *sideSegment = sideBnd->segment;
 4518:             const Side *side = sideBnd->side;
 4519: 
 4520:             // Integral I_3
 4521:             if (sideSegment->ifltype != 0) {
 4522:             // Natural or Flather b.c.
 4523: 
 4524:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 4525:                // especially for Flather b.c.
 4526:                double ri3 = 0.0;
 4527:                if (!side->isDry) {
 4528:                   // If the side is not dry
 4529:                   
 4530:                   // Computes the side flux of (uth, vth)
 4531:                   double Vn = 0.0;
 4532:                   for (int k = side->kb; k < nvrt - 1; k++) {
 4533:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 4534:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 4535: 
 4536:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 4537:                   }
 4538: 
 4539:                   ri3 = 0.5*side->len*Vn;
 4540:                }
 4541: 
 4542:                if (sideSegment->ifltype == -1) { // Flather 1
 4543: 
 4544:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 4545:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 4546: 
 4547:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 4548:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 4549:                   
 4550:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 4551:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 4552: 
 4553:                } 
 4554:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 4555:                   // Reset ri3
 4556:                   ri3 = 0.0;
 4557: 
 4558:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 4559:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 4560: 
 4561:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 4562: 
 4563:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 4564:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 4565: 
 4566:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 4567:                   node1->addToSparseMatrix(node1, con0*2.0);
 4568:                   node1->addToSparseMatrix(node2, con0);
 4569: 
 4570:                } // if Flather or Discharge
 4571: 
 4572:                node1->qel -= thetai*dt*ri3;  
 4573: 
 4574: 
 4575:             } // I_3
 4576:           
 4577: 
 4578:             // Integral I_5
 4579:             if(!side->isDry) {
 4580: 
 4581:                const double Unbar = dot(side->U, side->n);
 4582:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 4583: 
 4584:             } // I_5
 4585: 
 4586:          } // if is boundary side
 4587: 
 4588:       } // for l
 4589: 
 4590:    } // if isbnd
 4591: 
 4592: 
 4593: }
 4594: 
 4595: 
 4596: 
 4597: extern "C" {
 4598:    __global__ void setupCGSolvers(double* data_d, double* b_d, 
 4599:                                   int* indices, int* indptr) {
 4600: 
 4601:       NODE(node);
 4602:       
 4603:       const int idx = node->idx;
 4604:       
 4605:       // Computes the index in the nzz array      
 4606:       const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx;
 4607: 
 4608: 
 4609:       indptr[idx] = nzzIdx;
 4610:       indices[nzzIdx] = idx;
 4611: 
 4612:       data_d[nzzIdx]    = node->coeffDiag;
 4613: 
 4614:       b_d[idx] = node->qel;
 4615: 
 4616:       for (int k = 0; k < node->numNodes; ++k) {
 4617:          const Node* nb = node->nodes[k];
 4618: 
 4619:          const int j = nb->idx;
 4620: 
 4621:          data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 4622: 
 4623:          indices[nzzIdx + k + 1] = j;
 4624:       }
 4625: 
 4626:  
 4627:    }
 4628: 
 4629: 
 4630: 
 4631:    __global__ void solverCopyResult(double* x) {
 4632:       // Copies a solution vector to the member variable mX. XXXX It might be possible to remove all the unnecessary references to mX, mR, mP, mAp, etc.
 4633:       NODE(node);
 4634:       const int idx = node->idx;
 4635: 
 4636:       node->mX = x[idx];
 4637:    }
 4638: 
 4639: 
 4640:    __global__ void rollUpElevation(void) {
 4641: 
 4642:       NODE(node);
 4643: 
 4644:       node->eta1 = node->eta2;
 4645: 
 4646:    }
 4647: 
 4648: 
 4649:    __global__ void backtrackAllNodes(void) {
 4650: 
 4651:       // max/min # of sub-divisions
 4652:       const int ndelt_max = (int)max(1.0, dt/dtb_min);
 4653:       const int ndelt_min = (int)max(1.0, dt/dtb_max); 
 4654: 
 4655:       SIDE(side);
 4656: 
 4657:       const int kb = side->kb;
 4658: 
 4659: 
 4660:       // Initialize btrack velocities to the actual velocities at the side 
 4661:       for (int k = 0; k < nvrt; k++) side->btu[k] = side->u2[k];
 4662:   
 4663:       if (side->isDry) return;
 4664:      
 4665: // addDebugPlot(side->center, side->center, 0xFF001F, 'x');    
 4666: 
 4667:       // Checks that at least one element is not dry
 4668:       const Element *elem1 = side->elems[0];
 4669:       const Element *elem2 = side->elems[1];
 4670: 
 4671: // if (!((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)))) return;      
 4672: 
 4673:       // assert ((elem1 != nullptr && !(elem1->isDry)) || (elem2 != nullptr && !(elem2->isDry)) && "backtrackAllNodes: non dry side without two dry elements.");
 4674:       
 4675:       // XXXXXX
 4676:       // !swild_tmp to store global coord. of the starting side
 4677:       // swild_tmp(1)=xcj(isd0); swild_tmp(2)=ycj(isd0); swild_tmp(3)=zcj(isd0)
 4678:       // !swild10_tmp to store frame at starting pt for ics=2 (not used for ics=1)
 4679:       // !Use sframe2 
 4680:       // swild10_tmp(1:3,1:3)=sframe2(:,:,i) !pframe(:,:,isidenode(1,isd0)) 
 4681: 
 4682: 
 4683:       for (int k = kb; k < nvrt; k++) {
 4684:       //  Initialize (xt,yt,zt), nnel and vel.
 4685:       //  For ics=2, the coordinates are all in the side's local frame
 4686:       //  Caution! nnel must be initialized inside this loop as it is updated inside.
 4687: 
 4688:          const int iadvf = side->iadv();  // Advection flag   
 4689:          assert(nadv == 1 && "Advection flag is only implemented for nadv = 1");
 4690: 
 4691:          const double vmag2 = norm2(side->u2[k]);
 4692: 
 4693:          if (vmag2 <= velmin_btrack_sq) {  // XXXXXX REPEATED?
 4694:             // No activity 
 4695: 
 4696:             side->btu[k] = side->u2[k];  // I don't think this is necessary because it has already been set to this value XXXX
 4697: // addDebugPlot(side->center, side->center, 0x00000F, '+');     
 4698: 
 4699:             
 4700:          } else {  // do btrack
 4701: 
 4702:             // Compute number of sub-divisions based on local gradients of the velocity field
 4703: 
 4704:             // XXX IS THIS NECESSARY?
 4705:             // The gradient at a side is the average of the gradients at the elements sharing the side.
 4706:             double suma = 0.0;
 4707:             int icount = 0;
 4708:             for (int l=0; l<2; l++) {
 4709:             // For each element sharing the side...
 4710: 
 4711:                const Element *elem = side->elems[l];
 4712:                  
 4713:                if (elem == nullptr) continue;
 4714: 
 4715:                icount++;
 4716: 
 4717:                // Original Fortran code comment: "Not strictly along z; in local frame for ics=2"
 4718:                // I understand it to mean that u2[k] is assumed to be horizontal-only when transformed to
 4719:                // the local frame. This is not strictly true, but it is a reasonable approximation.
 4720: 
 4721:                double utmp[4];
 4722:                double vtmp[4];
 4723:                for (int j = 0; j < elem->i34; j++) {
 4724: 
 4725:                   const Node *node = elem->nodes[j];
 4726: 
 4727:                   if constexpr(ics==1) {
 4728:                      utmp[j] = node->u2[k].x;
 4729:                      vtmp[j] = node->u2[k].y;  
 4730: 
 4731:                   } else {
 4732:                      // 'Project' the velocity from the node frame to the element frame
 4733:                      const Vector2 tmp_u2 = node->frame.projHorVec(node->u2[k], elem->frame);
 4734:                      utmp[j] = tmp_u2.x;
 4735:                      vtmp[j] = tmp_u2.y;
 4736: 
 4737:                   }
 4738:                } // for j
 4739: 
 4740:                const Vector2 grad_u = elem->grad2(utmp); 
 4741:                const Vector2 grad_v = elem->grad2(vtmp);
 4742:    
 4743:                suma += dt*sqrt(dot(grad_u, grad_u) + dot(grad_v, grad_v));
 4744:             } // for ii
 4745: 
 4746:             assert(icount > 0 && "Impossible 77");
 4747: 
 4748:             // '4' is somewhat arbitrary
 4749:             const int ndelt = clamp(int(suma/icount)*4, ndelt_min, ndelt_max); 
 4750: 
 4751:             const double dtbk = dt/ndelt; // Target btrack step; may be smaller sometimes
 4752:             Vector3 u_int = {0.0, 0.0, 0.0};
 4753: 
 4754:             side->btrack(k, dt, dtbk, u_int);
 4755: 
 4756: 
 4757:             side->btu[k] = {u_int.x, u_int.y};
 4758:                
 4759:          } // if vmag (do backtrack)
 4760: 
 4761: 
 4762:       } // for k=kb,nvrt-1
 4763: 
 4764:    }
 4765: 
 4766: } // extern "C"
 4767: 
 4768: template<int nc>
 4769: __device__ void tridag_sch(int n, double *a, double *b, double *c, double *rhs, double *u, double *gam) {
 4770: 
 4771: // Solves a tridiagonal system. It was adapted from "Numerical Recipes in FORTRAN (pp.43 ).
 4772: //
 4773: // a,b,c,rhs: input vectors and are not modified by this program.
 4774: // b is the main diagonal, a below and c above. a(1) and c(n) are not used.
 4775: // rhs is the r.h.s.
 4776: // n: actual rank of the system.
 4777: // rows in u() and rhs();
 4778: // u: output with nc columns (transposed to rows)
 4779: // gam: a working array.
 4780: //
 4781: // NOTES:
 4782: // This is a template function that allows for different numbers of columns in the rhs vector.
 4783: // [n, nc] is the shape of Fortran-type arrays rhs and u.
 4784: 
 4785:    assert(n >= 1       && "TRIDAG: n must be >= 1");
 4786:    assert(b[0] != 0.0  && "TRIDAG: b[0]=0");
 4787: 
 4788:    double bet = b[0];
 4789:    if constexpr (nc == 1) {
 4790:       u[0] = rhs[0]/bet;
 4791:    } else {
 4792:       for (int l = 0; l < nc; l++) u[l] = rhs[l]/bet;
 4793:    }
 4794: 
 4795:    for (int j = 1; j < n; j++) {
 4796:       gam[j] = c[j - 1]/bet;
 4797:       bet = b[j] - a[j]*gam[j];
 4798: 
 4799:       assert (bet != 0.0 && "TRIDIAGONAL SOLVER: bet=0");
 4800: 
 4801:       if constexpr (nc == 1) {
 4802:          u[j] = (rhs[j] - a[j]*u[j - 1])/bet;
 4803:       } else {
 4804:          for (int l = 0; l < nc; l++) {
 4805:             u[j*nc + l] = (rhs[j*nc + l] - a[j]*u[(j - 1)*nc + l])/bet;
 4806:          }
 4807:       }
 4808:    }
 4809: 
 4810:    // Back-substitution
 4811:    for (int j = n - 2; j >= 0; j--) {
 4812:       if constexpr (nc == 1) {
 4813:          u[j] = u[j] - gam[j + 1]*u[j + 1];
 4814:       } else {
 4815:          for (int l = 0; l < nc; l++) {
 4816:             u[j*nc + l] = u[j*nc + l] - gam[j + 1]*u[(j + 1)*nc + l];
 4817:          }
 4818:       }
 4819:    }
 4820: }
 4821: 
 4822: 
 4823: 
 4824: // Helper function that contains the core algorithm
 4825: template<typename XAccessor, typename YAccessor>
 4826: __device__ void initCubicSplineImpl(int k1, int k2, XAccessor getX, YAccessor getY, 
 4827:                                     double  yp_top, double  yp_bot, 
 4828:                                     CubicSpline &spline) {
 4829:    // Compute the 1st and 2nd derivatives of y = f(x) using continuous cubic splines.
 4830:    // 
 4831:    // This function uses the General expression for a C2 interpolating cubic spline (search for "C2 interpolating cubic spline" in Wikipedia)
 4832:    // This method uses the 2nd derivatives and the y values at the endpoints to generate the polynomial coefficients for each level.
 4833:    //
 4834:    // NOTE: (x,y) here are just any function y=f(x). In fact we use these splines for vertical interpolation.
 4835:    // 
 4836:    // Inputs: 
 4837:    //            n: dimension for x etc; # of data pts (>=2);
 4838:    //            getX, getY: functions to access x,y coordinates
 4839:    //            yp_top and yp_bot: 1st derivatives at x[0] and x[n-1];
 4840:    //     Output: 
 4841:    //            spline (CubicSpline): spline structure with x,y,y',y''
 4842: 
 4843:    const int n = k2 - k1 + 1;
 4844:    assert(n >= 2 && "CUBIC SPLINE: n < 2");
 4845: 
 4846:    // Allocate memory for the splines
 4847:    assert(spline.x == nullptr && spline.y == nullptr && spline.yp == nullptr && spline.ypp == nullptr && "CUBIC SPLINE: x,y,yp,ypp already allocated");
 4848:    spline.x   = new double[n];
 4849:    spline.y   = new double[n];
 4850:    spline.yp  = new double[n];
 4851:    spline.ypp = new double[n];
 4852: 
 4853:    for (int k=k1; k<=k2; k++) {
 4854:       spline.x[k] = getX(k);
 4855:       spline.y[k] = getY(k);
 4856:    }
 4857: 
 4858:    // This is to simplify expressions later
 4859:    double *x = spline.x;
 4860:    double *y = spline.y;
 4861: 
 4862:    double *a = nullptr;
 4863:    double *b = nullptr;
 4864:    double *c = nullptr;
 4865:    double *gam = nullptr;
 4866:    double *rhs = nullptr;
 4867:    
 4868: 
 4869:       a = new double[n];   // Lower diagonal
 4870:       b = new double[n];   // Diagonal
 4871:       c = new double[n];   // Upper diagonal
 4872:       gam = new double[n]; // Gamma, used by the tridiagonal solver
 4873:       rhs = new double[n]; // Right-hand side
 4874: 
 4875:    for (int k=k1; k<=k2; k++) {
 4876:       if (k == k1) {
 4877:          // Bottom level
 4878:          assert(x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: bottom problem");
 4879:          b[k] = (x[k+1] - x[k])/3.0;
 4880:          c[k] = b[k]/2.0;
 4881:          rhs[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - yp_bot;
 4882:       } else if (k == n - 1) {
 4883:          // Top level (surface)
 4884:          assert(x[k] - x[k-1] != 0.0 && "CUBIC SPLINE: surface problem");
 4885:          b[k] = (x[k] - x[k-1])/3.0;
 4886:          a[k] = b[k]/2.0;
 4887:          rhs[k] = -(y[k] - y[k-1])/(x[k] - x[k-1]) + yp_top;
 4888:       } else {
 4889:          // Intermediate levels
 4890:          assert(x[k] - x[k-1] != 0.0 && x[k+1] - x[k] != 0.0 && "CUBIC SPLINE: middle problem");
 4891:          b[k] = (x[k+1] - x[k-1])/3.0;
 4892:          a[k] = (x[k  ] - x[k-1])/6.0;
 4893:          c[k] = (x[k+1] - x[k  ])/6.0;
 4894:          rhs[k] = (y[k+1] - y[k  ])/(x[k+1] - x[k  ]) - 
 4895:                   (y[k  ] - y[k-1])/(x[k  ] - x[k-1]);
 4896:       }
 4897:    }
 4898: 
 4899:    // Solve the tridiagonal system
 4900:    tridag_sch<1>(n, a, b, c, rhs, spline.ypp, gam);
 4901:    
 4902:    spline.yp[k1] = yp_bot;
 4903:    spline.yp[k2] = yp_top;
 4904: 
 4905:    // Compute rest of 1st derivatives using the splines
 4906:    for (int k=k1+1; k<k2; k++) {
 4907:       spline.yp[k] = (y[k+1] - y[k])/(x[k+1] - x[k]) - 
 4908:                      (x[k+1] - x[k])/6.0*(2.0*spline.ypp[k] + spline.ypp[k+1]);
 4909:    }
 4910:    
 4911:    delete[] a;
 4912:    delete[] b;
 4913:    delete[] c;
 4914:    delete[] gam;
 4915:    delete[] rhs;
 4916: 
 4917: }
 4918: 
 4919: // Array version
 4920: __device__ void initCubicSpline(int k1, int k2, double *x, double *y, 
 4921:                                 double y_top, double y_bot, 
 4922:                                 CubicSpline &spline) {
 4923:    auto getX = [x] (int k) { return x[k]; };
 4924:    auto getY = [y] (int k) { return y[k]; };
 4925:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4926: }
 4927: 
 4928: // Lambda version - allows custom access patterns
 4929: template<typename XFunc, typename YFunc>
 4930: __device__ void initCubicSpline(int k1, int k2, XFunc getX, YFunc getY,
 4931:                                 double y_top, double y_bot,
 4932:                                 CubicSpline &spline) {
 4933:    initCubicSplineImpl(k1, k2, getX, getY, y_top, y_bot, spline);
 4934: }
