 1679:    __global__ void computeTimeRamps(double time, int nws, bool if_source, double drampbc, double drampwind, double drampwafo, double dramp_ss, double dramp) {
 1680:       // Compute the different time ramps used in the code 
 1681:       // This function is performed by just one thread
 1682: 
 1683:       rampbc = 1.0;
 1684:       if constexpr(ibc == 0) {
 1685:          if (drampbc > 0.0) {
 1686:             rampbc = tanh(2.0*time/86400.0/drampbc);
 1687:          } else {
 1688:             rampbc = 1.0;
 1689:          }
 1690:       }
 1691: 
 1692:       if (nws != 0) {
 1693:          if (drampwind > 0.0) {
 1694:             rampwind = tanh(2.0*time/86400.0/drampwind);
 1695:          } else {
 1696:             rampwind = 1.0;
 1697:          }
 1698:       }
 1699: 
 1700:       if (drampwafo > 0.0) {
 1701:          rampwafo = tanh(2.0*time/86400.0/drampwafo);
 1702:       } else {
 1703:          rampwafo = 1.0;
 1704:       }
 1705: 
 1706:       // For source/sinks
 1707:       if (if_source && dramp_ss > 0.0) {
 1708:          ramp_ss = tanh(2.0*time/86400.0/dramp_ss);
 1709:       } else {
 1710:          ramp_ss = 1.0;
 1711:       }
 1712: 
 1713:       if (dramp > 0.0) {
 1714:          ramp = tanh(2.0*time/86400.0/dramp);
 1715:       } else {
 1716:          ramp = 1.0;
 1717:       }
 1718: 
 1719: 
 1720:    }
