 2711: 
 2712:       // If the field is a horizontal vector and the ics is 2, project the vector from the node frame to the element frame
 2713:       if constexpr (IsVector2<T>::value && ics == 2) {
 2714: // XXXXX printf("mean 1: values = (%f, %f), (%f, %f), (%f, %f), (%f, %f)\n", values[0].x, values[0].y, values[1].x, values[1].y, values[2].x, values[2].y, values[3].x, values[3].y);
 2715:          projectSideVectorsToElementFrame(values);
