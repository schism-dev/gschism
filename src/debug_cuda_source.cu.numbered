 4111:    __global__ void scaleGravity(double loadtide_coef) {
 4112: 
 4113: 
 4114:       NODE(node);
 4115: 
 4116:       // SAL option: scale gravity
 4117:       if constexpr(iloadtide==2) {  // simple const
 4118:          node->grav2 = grav*(1.0 - loadtide_coef);
 4119: 
 4120:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4121:         
 4122:           const double depth = max(node->depth, 0.0);
 4123:           const double tmp1 = sqrt(depth);
 4124:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4125:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4126:                              2.6969e-13*depth*depth*depth*tmp1;
 4127:           
 4128:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4129:           
 4130: 
 4131: 
 4132:           node->grav2 = grav*(1.0 - beta_bar);
 4133: 
 4134:       } else {  // iloadtide=0,1
 4135:         node->grav2=grav;
 4136: 
 4137:       }
 4138: 
 4139:    }
 4140: 
