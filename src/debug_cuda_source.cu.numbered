 2488: __device__ void Node::updateKb(void) {
 2489: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 2490: 
 2491:    if constexpr(ivcor == 1) return;
 2492: 
 2493: 
 2494:    // Check if node is wet
 2495:    const bool isDry = (htot2() <= h0);  // XXX Check if we are doing this elsewhere
 2496: 
 2497:    if (isDry) return;
 2498: 
 2499:    if constexpr(ivcor == 2) {  // SZ coordinates
 2500:       
 2501:       // Compute bottom level index
 2502:       if (depth <= mesh->h_s) {
 2503:          kb = mesh->kz - 1;
 2504:       } else {
 2505:          kb = -1;
 2506:          int L = 0;
 2507:          int R = mesh->kz - 2;  // We check up to kz-2 since we access i+1
 2508:          
 2509:          while (L <= R) {
 2510:             int M = (R + L) / 2;
 2511: 
 2512:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 2513:             
 2514:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 2515:                R = M;
 2516:             } else {
 2517:                L = M;
 2518:             }
 2519: 
 2520:             if (R - L == 1) {
 2521:                kb = L;
 2522:                break;
 2523:             }
 2524:          }
 2525:       }
 2526:    } 
 2527: }
