 7481:       case (int)VarCode::kb:
 7482:          *offset = (int)((char*)&sides[0].kb - (char*)sides);
 7483:          *sizeType = sizeof(int);
 7484:          break;
 7485:       case (int)VarCode::isdry:
 7486:          *offset = (int)((char*)&sides[0].isDry - (char*)sides);
 7487:          *sizeType = sizeof(int);
 7488:          break;            
 7489:       case (int)VarCode::w:
 7490:          *offset = (int)((char*)&sides[0].w2 - (char*)sides);
 7491:          *sizeType = sizeof(double);
 7492:          break;
 7493:       case (int)VarCode::u:
 7494:          *offset = (int)((char*)&sides[0].u2[0].x - (char*)sides);
 7495:          *sizeType = sizeof(Vector2);
 7496:          break;   
 7497:       case (int)VarCode::U:
 7498:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7499:          *sizeType = sizeof(Vector2);
 7500:          break;
 7501:       case (int)VarCode::ghat:
 7502:          *offset = (int)((char*)&sides[0].U.x - (char*)sides);
 7503:          *sizeType = sizeof(Vector2);
 7504:          break;                        
 7505:       case (int)VarCode::n1:
 7506:          *offset = (int)((char*)&sides[0].n1 - (char*)sides);
 7507:          *sizeType = sizeof(Node);
 7508:          break;
 7509:       case (int)VarCode::n2:
 7510:          *offset = (int)((char*)&sides[0].n2 - (char*)sides);
 7511:          *sizeType = sizeof(Node);
 7512:          break;                   
 7513:       default:
 7514:          *offset = -1;
 7515:    }
 7516: }
