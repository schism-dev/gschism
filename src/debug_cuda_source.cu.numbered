 1323: struct Node {
 1324: 
 1325:    // Geometry information
 1326:    int idx;        // Index of the node
 1327:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1328:    int numNodes;   // Number of nodes neighbors of this node
 1329: 
 1330:    Element **elements; // Array of pointers to the elements that share this node
 1331:    int numElements;    // Number of elements that share this node
 1332: 
 1333:    int numSides;       // Number of sides that are connected to this node
 1334: 
 1335:    Point2 p;           // Horizontal coordinates at the node. (if ics == 2, this are the x,y coordinates of the 3d global cartesian coordinates. Together with gz, they form the 3D global cartesian coordinates.)
 1336:    double gz;          // Global vertical coordinate at the node.
 1337:    Vector2 u2[nvrt];
 1338:    double  w2[nvrt];
 1339:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1340:    double z[nvrt];      // Local vertical coordinate at each vertical level. 
 1341:    double lon, lat;
 1342:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1343:    double depth;
 1344: 
 1345:    #ifdef USE_FRAMES
 1346:    Frame frame;
 1347:    #endif
 1348: 
 1349:    #ifdef USE_LOCALIZED_SIGMA   
 1350:    double localSigma[nvrt];
 1351:    #endif
 1352: 
 1353:    int kb;       // Bottom index of the node
 1354: 
 1355:    bool isDry;     // True if the node is dry
 1356: 
 1357:    int iadv;     // Advection flag
 1358: 
 1359:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1360:                           // this is nullptr
 1361: 
 1362:    TempVar tmp; // Temporary variable to store different types of variables
 1363: 
 1364:    // Physical information
 1365:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1366:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1367: 
 1368:    double rho[nvrt];     // Density
 1369:    double dfv[nvrt];     // Vertical viscosity
 1370: 
 1371:    double eta1; // Elevation at nodes at previous timestep
 1372:    double eta2; // Elevation at nodes at current timestep
 1373: 
 1374:    double ETP;  // Earth Tidal Potential
 1375: 
 1376:    double pr;    // Air pressure
 1377:    double grav2; // Gravity 
 1378:    
 1379:    Vector2 dav;  // Depth averaged velocity
 1380: 
 1381:    Vector2 tau; // Wind stress vector
 1382: 
 1383:    // Vegetation parameters
 1384:    double veg_h;
 1385:    double veg_nv;
 1386:    double veg_di;
 1387:    double veg_Cd;
 1388:    double veg_h_unbent;
 1389:    double veg_di_unbent;
 1390:    double veg_nv_unbent;
 1391:    double veg_alpha_vert_mean;
 1392:    double veg_alpha0;
 1393:    double veg_alpha3D[nvrt];
 1394: 
 1395:    // Bottom drag parameters
 1396:    double Cd;       // Bottom drag coefficient   
 1397: 
 1398:    // These three are mutually exclusive
 1399:    union {
 1400:       double rmanning; // Bottom Manning's coefficient
 1401:       double rough;    // Bottom roughness length
 1402:       double drag;     // Bottom drag coefficient
 1403:    };
 1404:    Vector2 tau_bot; // Bottom stress vector
 1405: 
 1406:    // XXXX REMOVE FOR IMM>0???
 1407:    double bdef1; // Bottom deformation at previous timestep
 1408:    double bdef2; // Bottom deformation at current timestep
 1409: 
 1410:    double qel; // RHS
 1411:    double coeffDiag; // Diagonal coefficient of the matrix
 1412:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1413: 
 1414:    // This was used by a previous version of the conjugate gradient method
 1415:    // double mP; // Search direction for conjugate gradient method
 1416:    // double mR; // Residual for conjugate gradient method
 1417:    // double mAp; // Product of matrix and search direction for conjugate gradient method
 1418: 
 1419:    double mX; // Solution of the FEM system
 1420: 
 1421:    // Meteorological forcing
 1422:    Vector2 u_air;
 1423:    double p_air;  // XXXX is this the same as pr?
 1424:    double t_air;
 1425:    double q_air;
 1426:    float cRot, sRot;  // Cosine and sine of the mesh rotation matrix
 1427: 
 1428:    __device__ void setWind(Vector2 &u) {
 1429:    // Sets the wind vector taking into account the mesh angle
 1430:    
 1431:       const double speed = length(u);
 1432: 
 1433:       // Rotate wind vector to the node frame
 1434:       u_air = {u.x*cRot - u.y*sRot, u.x*sRot + u.y*cRot};
 1435: 
 1436:       // Sets the surface stress vector due to wind.
 1437:       if constexpr(nws == 0) {
 1438:          tau = {0.0, 0.0};
 1439: 
 1440:       } else if constexpr(nws == 2 && ihconsv == 1 && iwind_form == 0) {
 1441:          assert(false && "setWinds: nws==2, ihconsv==1, iwind_form==0 (tauxz/tauyz) not supported");
 1442: 
 1443:       } else {
 1444: 
 1445:          double dragcoef;
 1446: 
 1447:          if constexpr(iwind_form == -1) {
 1448:             const double speed_clamp = clamp(speed, 6.0, 50.0);
 1449:             dragcoef = 1.0e-3 * (0.61 + 0.063*speed_clamp);
 1450: 
 1451:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1452:             tau = cff*u_air;
 1453:  
 1454:          } else if constexpr(iwind_form == 1) {
 1455:             if (speed <= 35.0) dragcoef = 1.00e-4 * (-0.016*speed*speed + 0.967*speed + 8.058);
 1456:             else               dragcoef = 2.23e-3 * 35.0/speed;
 1457: 
 1458:             const double cff = 0.001293*dragcoef*speed*rampwind;
 1459:             tau = cff*u_air;
 1460: 
 1461:          } else {
 1462:             tau = {0.0, 0.0};
 1463:          }
 1464:       }
 1465:    }
 1466: 
 1467:    #ifdef USE_FRAMES
 1468:    __device__ void setFrame(double lat, double lon) {
 1469: 
 1470:       frame.update(lat, lon);        
 1471:     }
 1472:    #endif
 1473: 
 1474:    //__device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }   // XXXX can this be confused with 3D as in ics=2???
 1475: 
 1476:    __device__ double sigmaTransitionDepth(void) const;
 1477: 
 1478:    __device__ double computeETP(int idxTidalPotential, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const;
 1479: 
 1480:    __inline__ __device__ Point2 outputCoords(void) const {
 1481:       if constexpr(ics == 1)  return p;
 1482:       else                    return {rad2deg*lon, rad2deg*lat};
 1483:    }
 1484: 
 1485:    __device__ __forceinline__ Point3 toLocalFrame(Point3 const& p) const {
 1486:    // If ics == 2, convert the global point to the local frame
 1487:       
 1488:       if constexpr (ics == 1) {
 1489:          return p;
 1490:       } else {
 1491:          const Point3 c = {p.x, p.y, gz};
 1492:          const Point3 local = frame.G2L(p - c);
 1493:          return local;
 1494:       }
 1495:    }
 1496: 
 1497:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1498:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1499:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1500:    
 1501:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1502: 
 1503:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1504: 
 1505:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1506:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1507: 
 1508:    __device__ __forceinline__ void clearMatrixRow(void) {
 1509:       // Clear the matrix row for this node
 1510: 
 1511: 
 1512:       coeffDiag = 0.0;
 1513: 
 1514:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1515: 
 1516:    }
 1517: 
 1518:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1519:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1520:       
 1521:       if (node == this) {
 1522:          coeffDiag += value;
 1523:      
 1524:       } else {
 1525:          // Search (linearly)the index of the node in the array of nodes
 1526:          // XXX: This is not efficient, see if we can improve this
 1527:          int i;
 1528:          for (i = 0; i < numNodes; i++) {
 1529:             if (nodes[i] == node) {
 1530:                break;
 1531:             }
 1532:          }
 1533:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1534:          coeffMatrix[i] += value;
 1535:       }
 1536:    }
 1537: 
