 3817: 
 3818: __device__ double Node::sigmaTransitionDepth(void) const { return min(depth, mesh->h_s); }  
 3819: 
 3820: __device__ double Node::computeETP(int idxComp, double time, double* tfreq, double* tamp, double* tnf, double* tear, int* jspc) const {
 3821: 
 3822:    assert(lat >= -pi/2.0 && lat <= pi/2.0 && "computeETP: lat out of range");
 3823:    assert(lon >= -pi && lon <= pi         && "computeETP: lon out of range");
 3824: 
 3825:    const int ncyc = int(tfreq[idxComp]*time/(2.0*pi));
 3826:    const double arg = tfreq[idxComp]*time - ncyc*(2.0*pi) + jspc[idxComp]*lon + tear[idxComp];
 3827: 
 3828:    double fun_lat = 0.0;
 3829:    switch (jspc[idxComp]) {
 3830:       case 0:
 3831:          fun_lat = 3.0*pow<2>(sin(lat)) - 1.0;
 3832:          break;
 3833:       case 1:
 3834:          fun_lat = sin(2.0*lat);
 3835:          break;
 3836:       case 2:
 3837:          fun_lat = pow<2>(cos(lat));
 3838:          break;
 3839:       default:
 3840:          assert(false && "computeETP: invalid jspc");
 3841:    }
 3842:    
 3843:    return 0.69*ramp*tamp[idxComp]*tnf[idxComp]*fun_lat*cos(arg);
 3844: 
 3845: }
 3846: 
 3847: __device__ void Node::updateKb(void) {
 3848: // Updates the node's kb index. Must be called before compZCoord(), preferibly right after Depth and/or eta2 are updated
 3849: 
 3850:    if constexpr(ivcor == 1) return; // When ivcor=1, the kb index is fixed and read from the vgrid file  XXXX What if the bed changes???
 3851: 
 3852: 
 3853:    // assert(!isDry && "ZCOOR: node is dry"); XXXX
 3854: 
 3855:    if constexpr(ivcor == 2) {  // SZ coordinates
 3856:       
 3857:       // Compute bottom level index
 3858:       if (depth <= mesh->h_s) {
 3859:          kb = izlev;   
 3860:          
 3861:       } else {
 3862:          kb = -1;
 3863:          int L = 0;
 3864:          int R = nzlev; 
 3865:          
 3866:          while (L <= R) {
 3867:             int M = (R + L) / 2;
 3868: 
 3869: 
 3870:             assert((-depth >= mesh->ztot[L] && -depth < mesh->ztot[R]) && "ZCOOR: invalid depth\n");
 3871:             
 3872:             if (-depth >= mesh->ztot[L] && -depth < mesh->ztot[M]) {
 3873:                R = M;
 3874:             } else {
 3875:                L = M;
 3876:             }
 3877: 
 3878:             if (R - L == 1) {
 3879:                kb = L;
 3880:                break;
 3881:             }
 3882:          }
 3883: 
 3884:          // Checks that the binary search was successful
 3885:          assert(-depth >= mesh->ztot[kb] && -depth < mesh->ztot[kb + 1]);
 3886:        
 3887:       }
 3888:    } 
 3889: }
 3890: 
