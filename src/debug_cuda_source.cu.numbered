 1778: // Helper functions for computing the local node index at a given offset from another.
 1779: __device__ __inline__ int nxq(int offset, int index, int size) {
 1780:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1781:    // to the index to make it positive
 1782:    assert(index + offset + 16*size >= 0);
 1783:    return (index + offset + 16*size) % size;  
 1784: }
 1785: 
 1786: __device__ __inline__ int nxq(int index, int size) {
 1787:    // In c++, the % operator can return negative numbers, for this reason we add 16*size 
 1788:    // to the index to make it positive
 1789:    assert(index + 16*size >= 0);
 1790:    return (index + 16*size) % size; 
 1791: }
