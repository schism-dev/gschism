 1408:       : x({0.0, 0.0, 0.0}), u({0.0, 0.0, 0.0}), dt(0.0), t(0.0), 
 1409:         elem(nullptr), side(nullptr), node(nullptr), type(BTPointType::btElement) {}
 1410:    
 1411:    __device__ BTPoint(Point3 x_, BTPointType type_, Element *elem_ = nullptr, Side *side_ = nullptr, Node *node_ = nullptr, double t_ = 0.0, double dt_ = 0.0, Vector3 u_ = {0.0, 0.0, 0.0})
 1412:       : x(x_), u(u_), dt(dt_), type(type_), elem(elem_), side(side_), node(node_), t(t_) {}
