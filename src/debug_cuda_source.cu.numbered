  462: struct Element {
  463: 
  464:    // Geometry information
  465:    int idx;               // Index of the element
  466:    int i34;               // Number of sides for the element 
  467:    Side *sides[4];        // Sides of the element
  468:    Node *nodes[4];        // Nodes of the element
  469:    Element *nghbElems[4]; // Neighbors of the element
  470: 
  471:    int kb;                    // Bottom index of the element
  472:    double area;               // Area of the element
  473:    double ssign[4];           // Sign associated with each side of an element
  474:    double radius;             // Element equivalent radii
  475: 
  476:    Frame frame;
  477: 
  478:    Vector2 gradPhi[4];       // Derivatives of shape functions
  479:    Vector2 gradEta;          // Gradient of free surface elevation
  480:    Vector2 gradPr;           // Gradient of pressure    
  481:    Vector2 gradETP;          // Gradient of Earth Tidal Potential    XXXXX Really used?
  482: 
  483:    bool isDry;                // True if the element is dry
  484: 
  485:    Vector3 center;            // Element center coordinates
  486:    double xlon, ylat;         // Element center lat/lon coordinates in _degrees_
  487:    double depth;              // Depth at element (min of all nodes)
  488:    double z[nvrt];            // z-coord  (local frame - vertical up)
  489: 
  490:    // Physical information
  491:    Tracers tracers[nvrt];     // Tracer values at each vertical level  
  492: 
  493:    static const bool isblock = false;              // Always false
  494: 
  495:    double w[nvrt];            // Vertical velocity at element centers & whole levels, calculated using F.V.M. 
  496:                               // For hydrostatic model, this is the same as we(); for non-hydrostatic model, this is only used in upwind transport
  497: 
  498:    Vector2 ghat1;             // Element averaged ghat (\breve{G} in notes)
  499: 
  500:    
  501: 
  502:    double vsource;            // Volumetric source/sink term [m^3/s]
  503: 
  504:    double rho[nvrt];          // Density at each prism center
  505:    double rho_mean[nvrt];     // Mean density at each prism center
  506:    CubicSpline rho_spl;
  507:    double rho_zz[nvrt];       // Second derivative of density at each prism center
  508:    double rho_z[nvrt];        // First derivative of density at each prism center
  509:    Vector2 gradRho[nvrt];     // Gradient of de-meaned density at each prism center
  510: 
  511:    __inline__ __device__ double demeanedDensity(int k) const { return rho[k] - rho_mean[k]; }   
  512: 
  513:    __inline__ __device__ bool isTri (void) const { return i34 == 3; }
  514:    __inline__ __device__ bool isQuad(void) const { return i34 == 4; }
  515: 
  516:    __inline__ __device__ bool is2D(void) const { return kb == nvrt - 2; }
  517:    __inline__ __device__ bool is3D(void) const { return kb <  nvrt - 2; }
  518: 
  519:    __inline__ __device__ int nxq(int index) const { assert(index + 16*i34 >= 0); return (index + 16*i34) % i34; }
  520:    __inline__ __device__ int nodeLocalIdx(Node *node) const {
  521:       // Find the local index of the node in the element (0,1,2,3)
  522:       int res = __ffs((nodes[0] == node) | 
  523:                      ((nodes[1] == node) << 1) | 
  524:                      ((nodes[2] == node) << 2) | 
  525:                      ((nodes[3] == node) << 3)) - 1;
  526:       
  527:       assert(res >= 0 && res < i34 && nodes[res] == node && "nodeLocalIdx: node not found in element");
  528:       return res;
  529:    }
  530: 
  531:    __inline__ __device__ int sideLocalIdx(const Side *side) const {
  532:       // Find the local index of the side in the element (0,1,2,3)
  533:       int res = __ffs((sides[0] == side) | 
  534:                      ((sides[1] == side) << 1) | 
  535:                      ((sides[2] == side) << 2) | 
  536:                      ((sides[3] == side) << 3)) - 1;
  537:       
  538:       assert(res >= 0 && res < i34 && sides[res] == side && "sideLocalIdx: side not found in element");
  539:       return res;
  540:    }
  541: 
  542: 
  543:    __inline__ __device__ int findLevel(double z1, int k) const {
  544:       // Starting at index k, find sequentially the level that contains z
  545: 
  546:       // if z is already betweeen z[k] and z[k+1], return k
  547:       if (z1 >= z[k] && z1 < z[k+1]) return k;
  548:       else if (z1 < z[k]) { 
  549:          // Search for increasing levels
  550:          for (int kk = k; kk < nvrt - 1; kk++) {
  551:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  552:          }
  553:          return nvrt - 1;
  554:       }
  555:       else {
  556:          // Search for decreasing levels
  557:          for (int kk = k; kk > 0; kk--) {
  558:             if (z1 >= z[kk] && z1 < z[kk + 1]) return kk;
  559:          }
  560:          return 0;
  561:       }
  562:    }
  563: 
  564:    __inline__ __device__ double z_prism(int k) const { return 0.5*(z[k+1] + z[k]); }
  565:    __inline__ __device__ double Dz(int k)      const { return z[k+1] - z[k]; }
  566: 
