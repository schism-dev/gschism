 7063: __global__ void printMatrix(bool full) {
 7064:    // Debugging: print the matrix
 7065: 
 7066:    const int size = mesh->np;
 7067:    double sum = 0.0;
 7068:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7069:       const Node *node = mesh->localNodeData + idx_node;
 7070:       if (full) printf("idx_node = %d [%d] diag=%lf, [", idx_node, node->numNodes, node->coeffDiag);
 7071:       for (int j = 0; j < node->numNodes; j++) {
 7072:          Node* nbNode = node->nodes[j];
 7073:          if (full && node->coeffMatrix[j] != 0.0) printf("%d:%f,  ", nbNode->idx, node->coeffMatrix[j]);
 7074:          sum += node->coeffMatrix[j];
 7075:       }
 7076:       if (full) printf("]\n");
 7077: 
 7078: 
 7079:    }
 7080:    if (!full) printf("sum=%lf\n", sum);
 7081: }
