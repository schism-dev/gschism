 4574: 
 4575:    __global__ void scaleGravity(double loadtide_coef) {
 4576: 
 4577: 
 4578:       NODE(node);
 4579: 
 4580:       // SAL option: scale gravity
 4581:       if constexpr(iloadtide==2) {  // simple const
 4582:          node->grav2 = grav*(1.0 - loadtide_coef);
 4583: 
 4584:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4585:         
 4586:           const double depth = max(node->depth, 0.0);
 4587:           const double tmp1 = sqrt(depth);
 4588:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4589:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4590:                              2.6969e-13*depth*depth*depth*tmp1;
 4591:           
 4592:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4593:           
 4594: 
 4595: 
 4596:           node->grav2 = grav*(1.0 - beta_bar);
 4597: 
 4598:       } else {  // iloadtide=0,1
 4599:           node->grav2 = grav;
 4600: 
 4601:       }
 4602: 
 4603:    }
 4604: 
