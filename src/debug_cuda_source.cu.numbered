 7633: __global__ void returnMatrix(double *res) {
 7634:    // Debugging: returns the matrix as a CuPy array
 7635: 
 7636:    const int size = mesh->np;
 7637:    for (int idx_node = 0; idx_node < size; idx_node++) {
 7638:       const Node *node = mesh->localNodeData + idx_node;
 7639:       res[idx_node*size + idx_node] = node->coeffDiag;
 7640:       for (int j = 0; j < node->numNodes; j++) {
 7641:          Node* nbNode = node->nodes[j];
 7642:          if (node->coeffMatrix[j] != 0.0) res[nbNode->idx*size + idx_node] =  node->coeffMatrix[j];
 7643:       }
 7644: 
 7645:    }
 7646:    
 7647: }
 7648: 
 7649: 
 7650: __global__ void computeMatrixProductAndDotProducts() {
 7651:    // Computes A*p, r'Mr and p'Ap
 7652: 
 7653:    // 1) shared buffer: first half for rMr, second for pAp
 7654:    __shared__ double sdata[2*BLOCK_SIZE];
 7655:    double* s_rMr = sdata;
 7656:    double* s_pAp = sdata + BLOCK_SIZE;
 7657: 
 7658:    const int tid = threadIdx.x;
 7659: 
 7660:    double l_pAp = 0.0;
 7661: 
 7662:    s_rMr[tid] = 0.0;
 7663:    s_pAp[tid] = 0.0;
 7664: 
 7665:    // 2) get your node pointer
 7666:    // NODE(node);   
 7667:    const int idx_node = threadIdx.x + blockIdx.x * blockDim.x; 
 7668:    Node *node = &(mesh->localNodeData[idx_node]); 
 7669:       if (idx_node < mesh->np) {
 7670: 
 7671:       const double diag = node->coeffDiag;
 7672:       const double r    = node->mR;
 7673:       const double p    = node->mP;  
 7674: 
 7675:       // apply preconditioner on the fly:
 7676:       // const double Mr   = r/diag;   // M is the preconditioner (inverse of the diagonal)
 7677: 
 7678:       // 4) compute Ap = A.p
 7679:       double Ap = node->coeffDiag * node->mP;
 7680:       for (int j = 0; j < node->numNodes; ++j) {
 7681:          const Node *nbNode = node->nodes[j];
 7682:          Ap += node->coeffMatrix[j] * nbNode->mP;
 7683: 
 7684:       }
 7685: 
 7686:       node->mAp = Ap;
 7687:       
 7688: 
 7689:       // 5) dot-products individual products (r'Mr, p'Ap) (Will be reduced later)
 7690:       // const double l_rMr = r*Mr;  // r'Mr
 7691:       l_pAp = p*Ap;  // p'Ap
 7692: 
 7693: 
 7694:    }
 7695: 
 7696:    // 6) write into shared mem
 7697:    // s_rMr[tid] = l_rMr;
 7698:    s_pAp[tid] = l_pAp;
 7699: 
 7700:    __syncthreads();
 7701: 
 7702:    // 7) block-wide tree reduction
 7703:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7704:       if (tid < stride)  {
 7705:          s_pAp[tid] += s_pAp[tid + stride];
 7706:       }
 7707:       __syncthreads();
 7708:    }
 7709: 
 7710:    // 8) thread 0 atomically accumulates into the globals
 7711:    // XXX: This is slower than it needs to be, but it is simple and works
 7712:    if (tid == 0) {
 7713:       atomicAdd(pAp, s_pAp[0]);
 7714:    }
 7715: 
 7716: 
 7717: }
 7718: 
 7719: 
 7720: __global__ void updateSolutionAndDotProducts(void) {
 7721:    extern __shared__ double s_rMr[BLOCK_SIZE];       
 7722: 
 7723:    const int tid = threadIdx.x;
 7724: 
 7725:    s_rMr[tid] = 0.0;
 7726: 
 7727:    // get node & bounds-check:
 7728:    NODE(node);
 7729: 
 7730:    
 7731:    // Compute alpha
 7732:    const double alpha = (*rMr_old)/(*pAp); 
 7733: 
 7734: 
 7735:    assert(*pAp != 0.0 && "updateSolutionAndDotProducts: pAp = 0.0");
 7736: 
 7737: 
 7738:    // load scalars
 7739:    const double diag = node->coeffDiag;
 7740:    const double p    = node->mP;
 7741:    const double Ap   = node->mAp;
 7742:    const double x    = node->mX;
 7743:    const double r    = node->mR;
 7744:    
 7745:    assert(diag != 0.0 && "updateSolutionAndDotProducts: diag = 0.0");
 7746: 
 7747:    // 1) update solution & residual
 7748:    const double x_new = x + alpha*p;
 7749:    const double r_new = r - alpha*Ap;
 7750:    node->mX = x_new;
 7751:    node->mR = r_new;
 7752: 
 7753:    // 2) apply Jacobi preconditioner on the fly
 7754:    const double Mr_new = r_new/diag;
 7755: 
 7756: 
 7757:    // 3) local contributions for the two dot-products
 7758:    const double l_rMr = r_new*Mr_new;  // r'M^-1r
 7759: 
 7760:    // 4) write into shared-mem
 7761:    s_rMr[tid] = l_rMr;
 7762: 
 7763:    __syncthreads();
 7764: 
 7765: 
 7766:    // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7767:    for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7768:       if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7769:       __syncthreads();
 7770:    }
 7771: 
 7772:    // 6) thread 0 atomically folds into the global accumulators
 7773:    if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);
 7774: 
 7775: 
 7776: }
 7777: 
 7778: 
 7779: __global__ void updateSearchDirection() {
 7780: 
 7781:     NODE(node);
 7782: 
 7783:     // recompute z on-the-fly
 7784:     const double z = node->mR / node->coeffDiag;
 7785:     const double p = node->mP;
 7786: 
 7787:     const double beta = (*rMr_new)/(*rMr_old);
 7788: 
 7789: 
 7790:     // p =z + beta*p
 7791:     node->mP = z + beta*p;
 7792: 
 7793: }
 7794: 
 7795: __global__ void initializeScalars(double *scalars) {
 7796: 
 7797:    // These point to a cupy array in the host code
 7798:    rMr_old = scalars + 0;
 7799:    rMr_new = scalars + 1;
 7800:    pAp     = scalars + 2;
 7801: }
 7802: 
 7803: __global__ void initializePreconditionedResidual(void) {
 7804: 
 7805:     __shared__ double s_rMr[BLOCK_SIZE];  
 7806: 
 7807:     s_rMr[threadIdx.x] = 0.0;
 7808: 
 7809:     NODE_ALL(node, valid);
 7810:     const int tid = threadIdx.x;
 7811:     // For the first iteration:
 7812:     // 1. Initial solution x = 0 (already set)
 7813:     // 2. Initial residual r = b (stored in qel)
 7814:     // 3. Initial search direction p = M^-1 * r = M^-1 * b
 7815: 
 7816: // XXX we should use the guess solution here    
 7817: 
 7818:     double l_rMr = 0.0;
 7819:     if (valid) {
 7820:       // Set initial residual r = b (from qel)
 7821:       node->mR = node->qel;
 7822: 
 7823:       // Compute z = M^-1 * r (preconditioned residual)
 7824:       const double z = node->mR / node->coeffDiag;
 7825: 
 7826:       // Set initial search direction p = z
 7827:       node->mP = z;
 7828: 
 7829:       // Initialize other variables needed for CG
 7830:       node->mX = 0.0;  // Initial solution
 7831:       node->mAp = 0.0; // Will be computed in first iteration
 7832: 
 7833: 
 7834:       // Computes the first r'Mr (reduction)
 7835:       l_rMr = node->mR*node->mR/node->coeffDiag;  // r'M^-1r
 7836:     }
 7837:     // 4) write into shared-mem
 7838:     s_rMr[tid] = l_rMr;
 7839: 
 7840:     __syncthreads();
 7841: 
 7842: 
 7843:     // 5) block-wide tree reduction (O(log BLOCK_SIZE))
 7844:     for (int stride = BLOCK_SIZE/2; stride > 0; stride >>= 1) {
 7845:         if (tid < stride) s_rMr[tid] += s_rMr[tid + stride];
 7846:         __syncthreads();
 7847:     }
 7848: 
 7849:     // 6) thread 0 atomically folds into the global accumulators
 7850:     if (tid == 0) atomicAdd(rMr_new, s_rMr[0]);        
 7851: 
 7852:     *rMr_old = 0.0;
 7853:     *pAp = 0.0;
 7854: }
 7855: 
 7856: 
 7857: 
 7858: extern "C" __global__ void getElementVarAddr(int varCode, void **addr, int *offset, int *sizeElement, int *sizeType) {
 7859:    Element *elems = mesh->localElemData;
 7860: 
 7861:    *addr = elems;
 7862:    *sizeElement = sizeof(Element);
 7863:    switch (varCode) {
 7864:       case (int)VarCode::z:
 7865:          *offset = (int)((char*)&elems[0].z - (char*)elems);
 7866:          *sizeType = sizeof(double);
 7867:          break;
 7868:       case (int)VarCode::x:
 7869:          *offset = (int)((char*)&elems[0].center.x - (char*)elems);
 7870:          *sizeType = sizeof(Vector2);
 7871:          break;
 7872:       case (int)VarCode::area:
 7873:          *offset = (int)((char*)&elems[0].area - (char*)elems);
 7874:          *sizeType = sizeof(double);
 7875:          break;
 7876:       case (int)VarCode::depth:
 7877:          *offset = (int)((char*)&elems[0].depth - (char*)elems);
 7878:          *sizeType = sizeof(double);
 7879:          break;
 7880:       case (int)VarCode::radius:
 7881:          *offset = (int)((char*)&elems[0].radius - (char*)elems);
 7882:          *sizeType = sizeof(double);
 7883:          break;
 7884:       case (int)VarCode::lonlat:
 7885:          *offset = (int)((char*)&elems[0].xlon - (char*)elems);
 7886:          *sizeType = sizeof(double);
 7887:          break;
 7888:       case (int)VarCode::ghat:
 7889:          *offset = (int)((char*)&elems[0].ghat1.x - (char*)elems);
 7890:          *sizeType = sizeof(Vector2);
 7891:          break;
 7892:       case (int)VarCode::kb:
 7893:          *offset = (int)((char*)&elems[0].kb - (char*)elems);
 7894:          *sizeType = sizeof(int);
 7895:          break;
 7896:       case (int)VarCode::isdry:
 7897:          *offset = (int)((char*)&elems[0].isDry - (char*)elems);
 7898:          *sizeType = sizeof(int);
 7899:          break;            
 7900:       case (int)VarCode::w:
 7901:          *offset = (int)((char*)&elems[0].w - (char*)elems);
 7902:          *sizeType = sizeof(double);
 7903:          break;
 7904:       case (int)VarCode::FaceIndices:
 7905:          // Notice that this returns pointers to the nodes of the element, some arithmetic is needed to get the actual indices
 7906:          *offset = (int)((char*)&elems[0].nodes[0] - (char*)elems);
 7907:          *sizeType = sizeof(Node);
 7908:          break;
 7909:       default:
 7910:          *offset = -1;
 7911:    }
 7912: }
