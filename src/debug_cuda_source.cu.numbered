 8777: //                 !  enddo
 8778: //                 !endif
 8779: //                 !!weno correction
 8780: //                 !if (iweno) then
 8781: //                 !  if(k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)<0) then !inflow
