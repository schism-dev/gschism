 4849: 
 4850: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2_c(Node *node, int k) const {
 4851:    // Brunt-Väisälä frequency at the center of the layer between levels k-1 and k.
 4852:    const double rho_c = 0.5*(node->rho[k] + node->rho[k-1]);
 4853:    return (grav/rho_c)*(node->rho[k] - node->rho[k-1])/node->Dz(k);
 4854: }
 4855: 
 4856: 
 4857: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::N2(Node *node, int k) const {
 4858:    // Brunt-Väisälä frequency at level k.
 4859:    if (k <= node->kb || k >= ivrt) return 0.0;
 4860:    return (grav/node->rho[k])*(node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4861: }
 4862: 
 4863: 
 4864: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::Fwall(Node *node, int k, double mxl_c) const {
 4865: 
 4866:    
 4867:    // Returns wall proximity function F_wall for the dissipation term in the GLS turbulence model.
 4868:    // k is the layer bottom index.
 4869: 
 4870: 
 4871: 
 4872:    if constexpr (turbSubmodel == MellorYamada || turbSubmodel == KL) {
 4873: 
 4874:       const double z_c = 0.5*(node->z[k] + node->z[k+1]);
 4875:       const double eta2 = node->eta2;
 4876:       const double depth = node->depth;
 4877: 
 4878:       // Distances from the layer midpoint to the surface and bottom
 4879:       const double dist_s = eta2 - z_c;
 4880:       const double dist_b = z_c + depth;
 4881: 
 4882:       assert(dist_s != 0.0 && dist_b != 0.0 && "Zero in proximity function");         
 4883: 
 4884:       return 1.0 + 1.33*pow<2>((1.0/kappa)*mxl_c/dist_b) + 0.25*pow<2>((1.0/kappa)*mxl_c/dist_s);
 4885: 
 4886: 
 4887:    } else {
 4888:       return 1.0; // Other GLS submodels
 4889: 
 4890:    }
 4891: }
 4892: 
 4893: 
 4894: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::mxlmin(double depth) const {
 4895:    // Minimum mixing length for levels below the surface.
 4896:    // Independent of psimin(); do not invert one to get the other.
 4897:    return 2.0 * tkemin() * 0.1 * max(h0, depth);
 4898: }
 4899: 
 4900: 
 4901: __device__ void Turbulence<TurbulenceModel::GLS>::init(Node *node) {
 4902:    // Whole column, including levels below kb. Matches the Fortran cold start.
 4903:    for (int k = 0; k < nvrt; k++) {
 4904:       tke[k]    = tkemin();
 4905:       mxl[k]    = mxlmin(node->depth);
 4906:       nu_tke[k] = diffmin;
 4907:       nu_phi[k] = diffmin;
 4908: 
 4909:       node->dfv[k] = 0.0;
 4910:       node->dfh[k] = 0.0;
 4911:    }
 4912: }
 4913: 
 4914: 
 4915: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::vegTurbProduction(Node *node, int k) const {
 4916: 
 4917:    // Returns the turbulence production due to vegetation averaged over the current layer.
 4918: 
 4919:    if constexpr(iveg == 1) {
 4920:       
 4921:       const double zbot = node->z[k-1]; // Bottom of the current layer.
 4922:       const double zTopCanopy = node->zTopCanopy();
 4923: 
 4924:       if (zbot < zTopCanopy) { // This means that the current level is within the vegetation layer, either partially or fully
 4925: 
 4926:          const double ztop = node->z[k];   // Top of the current layer.
 4927: 
 4928:          // Fraction of the current layer that is within the vegetation layer. zrat \in (0,1]
 4929:          // Where 1 means that the current level is fully within the vegetation layer.
 4930:          const double zrat = (min(zTopCanopy, ztop) - zbot)/(ztop - zbot);
 4931: 
 4932:          // Velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4933:          const Vector2 ub2_top = (1.0 - zrat)*node->u2[k-1] + zrat*node->u2[k]; // @top of canopy
 4934: 
 4935:          // Magnitude of the velocity at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4936:          // and at the bottom of the layer.
 4937:          const double vmag_top = length(ub2_top);
 4938:          const double vmag_bot = length(node->u2[k-1]);
 4939: 
 4940:          // Volume-averaged velocity cubed.
 4941:          const double vmag3 = 0.5*(pow<3>(vmag_top) + pow<3>(vmag_bot));
 4942: 
 4943:          // Vegetation alpha at the top of the layer (or the top of the vegetation layer if the current level is partially within the vegetation layer).
 4944:          // and at the bottom of the layer.
 4945:          const double veg_alpha3D_top = (1.0 - zrat)*node->veg_alpha3D[k-1] + zrat*node->veg_alpha3D[k];
 4946:          const double veg_alpha3D_bot = node->veg_alpha3D[k-1];
 4947: 
 4948:          // Volume-averaged vegetation alpha cubed.
 4949:          const double veg_alpha3D = 0.5*(veg_alpha3D_top + veg_alpha3D_bot);
 4950: 
 4951:          return veg_alpha3D*vmag3;
 4952:       } 
 4953:       else {
 4954:          // The current level is not within the vegetation layer, so the production is 0.
 4955:          return 0.0;
 4956:       }
 4957:    } else {
 4958: 
 4959:       // If no vegetation, the production is 0.
 4960:       return 0.0;
 4961:    }
 4962: 
 4963: }
 4964: 
 4965: 
 4966: __device__ void Turbulence<TurbulenceModel::GLS>::computeDiffusivities(Node *node) {
 4967:    // Eddy viscosity/diffusivity from the algebraic stability functions (stabilityModel).
 4968:    // Writes node->dfv, node->dfh (diffusivities for momentum/tracers) and nu_tke, nu_phi (diffusivities for TKE/phi).
 4969: 
 4970:    const int kb = node->kb;
 4971: 
 4972:    for (int k = kb; k < nvrt; k++) {
 4973:       const double tke = this->tke[k];
 4974:       const double mxl = this->mxl[k];
 4975:       const double u = sqrt(tke);  // Characteristic velocity
 4976:       const double lu = mxl*u;     // Characteristic diffusivity 
 4977: 
 4978:       // vertical gradient of density (homogeneous Neumann boundary conditions at the surface and bottom).
 4979:       double drho_dz = 0.0;
 4980:       if (k > kb && k < ivrt) {
 4981:          drho_dz = (node->rho[k+1] - node->rho[k-1])/(node->z[k+1] - node->z[k-1]);
 4982:       }
 4983: 
 4984:       const double N2 =this->N2(node, k); // Brunt-Väisälä frequency
 4985: 
 4986:       // Tsinghua group       
 4987:       const double Gh = clamp(0.5*mxl*mxl*N2/tke, -0.28, 0.0233);
 4988: 
 4989:       double sh, sm, cmiu, cmiup, cmiu1, cmiu2;
 4990:       if constexpr (stabilityModel == Galperin) {
 4991:          sh = 0.49393/(1.0-34.676*Gh);
 4992:          sm = (0.39327-3.0858*Gh)/(1.0-34.676*Gh)/(1.0-6.1272*Gh);
 4993:          cmiu  = sqrt(2.0)*sm;
 4994:          cmiup = sqrt(2.0)*sh;
 4995:          cmiu1 = sqrt(2.0)*0.2;
 4996:          cmiu2 = sqrt(2.0)*0.2;
 4997: 
 4998:       } else if constexpr (stabilityModel == KanthaClayson) {  // Kantha and Clayson
 4999:          // Warner's paper has problem
 5000:          //  Ghp=(Gh-(Gh-0.02)**2)/(Gh+0.0233-0.04) !smoothing
 5001:          const double Ghp = Gh;  /// XXXXX needed?
 5002:          sh = 0.4939/(1.0 - 30.19*Ghp);
 5003:          sm = (0.392 + 17.07*sh*Ghp)/(1.0-6.127*Ghp);
 5004:          cmiu  = sqrt(2.0)*sm;
 5005:          cmiup = sqrt(2.0)*sh;
 5006:          cmiu1 = cmiu/schk();
 5007:          cmiu2 = cmiu/schpsi();
 5008: 
 5009:       } else {
 5010:          assert(false && "Unknown ASM");
 5011: 
 5012:       }
 5013: 
 5014:       node->dfv[k] = clamp(cmiu  * lu, diffmin, diffmax);
 5015:       node->dfh[k] = clamp(cmiup * lu, diffmin, diffmax);
 5016:       nu_tke[k]    = clamp(cmiu1 * lu, diffmin, diffmax);
 5017:       nu_phi[k]    = clamp(cmiu2 * lu, diffmin, diffmax);
 5018:    }
 5019: }
 5020: 
 5021: 
 5022: __device__ __forceinline__ double Turbulence<TurbulenceModel::GLS>::maxMixingLength(Node *node, int k) const {
 5023: // Compute upper bound for the turbulent mixing length based on the distance to the closest "wall" (either surface or bottom).
 5024: 
 5025:    const double z = node->z[k];
 5026:    const double eta2 = node->eta2;
 5027:    const double depth = node->depth;
 5028: 
 5029:    // Distances to the surface and bottom
 5030:    const double dist_s = eta2 - z;
 5031:    const double dist_b = z + depth;
 5032: 
 5033:    // Distance to the closest "wall" (either surface or bottom).  
 5034:    // In the top layer, it is the size of the layer.
 5035:    const double min_dist = (k==ivrt)?node->Dz(ivrt):min(dist_s, dist_b); 
 5036:    assert(min_dist > 0.0 && "Invalid minimum distance");
 5037: 
 5038:    // The limit of the mixing length is the maximum eddy that the closest "wall" allows.
 5039:    return kappa*min_dist;
 5040: }
 5041: 
 5042: 
 5043: 
 5044: template<TurbulenceModel turbulenceModel>
 5045: __device__ __forceinline__ void computeTurbulenceModel(Node *node);
 5046: 
 5047: 
 5048: template<>
 5049: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::Constant>(Node *node) { 
 5050:    // Constant turbulence model
 5051:    // Does nothing since dfv and dfh are already set  in the initialization.
 5052: }
 5053: 
 5054: template<>
 5055: __device__ __forceinline__ void computeTurbulenceModel<TurbulenceModel::GLS>(Node *node) { 
 5056:    // Mellor-Yamada-Galperin & Umlauf-Burchard scheme
 5057: 
 5058:    // Solves the following PDEs:
 5059:    //
 5060:    //    dK/dt = d/dz(nu_q2*dK/dz) + 2*(Prod - diss + Buoy)
 5061:    //    dPhi/dt = d/dz(nu_xl*dPhi/dz) + 2*(l/q2)*(cpsi1*Prod - cpsi2*Fw*diss + cpsi3*Buoy)
 5062:    //
 5063:    // Where K is TKE and Phi is the GLS generic length-scale variable, and Fw is the wall proximity function.
 5064:    // In the code we call them tke and phi. However, we don't store phi, we store mxl (mixing length).
 5065:    // They are related by the equation: Phi = cpsi2*Fw*sqrt(K/cpsi3), but it can be confusing, so be careful.
 5066:    //
 5067:    // The equations are solved using a linear *vertical* FEM formulation.
 5068:    // Elements are linear functions defined on a layer (the interval between two vertical levels).
 5069:    // The shape functions are triangular functions composed of two linear functions over consecutive intervals.
 5070:    
 5071:    
 5072:    // Get the turbulence model
 5073:    // reinterpret_cast is used to avoid stupid compiler errors.
 5074:    Turbulence<TurbulenceModel::GLS> &turb = reinterpret_cast<Turbulence<TurbulenceModel::GLS>&>(node->turb);
 5075:      
 5076:    const int kb = node->kb;
 5077:    const int nqrows = nvrt - kb - 1; // Number of rows of the tridiagonal system
 5078: 
 5079:    double alow_tke[nvrt], alow_phi[nvrt];
 5080:    double bdia_tke[nvrt], bdia_phi[nvrt];
 5081:    double cupp_tke[nvrt], cupp_phi[nvrt];
 5082:    double rhs_tke [nvrt], rhs_phi [nvrt];
 5083:    
 5084:    // Initialize the tridiagonal system
 5085:    for (int kin = 0; kin < nqrows; kin++) {
 5086:       alow_tke[kin]=0.0;
 5087:       bdia_tke[kin]=0.0;
 5088:       cupp_tke[kin]=0.0;
 5089:       rhs_tke [kin]=0.0; 
 5090:       alow_phi[kin]=0.0;
 5091:       bdia_phi[kin]=0.0;
 5092:       cupp_phi[kin]=0.0;
 5093:       rhs_phi [kin]=0.0; 
 5094:    }
 5095: 
 5096: 
 5097: 
 5098:    // For dry or 2D nodes, vertical viscosity and diffusivity are set to their minimum values.
 5099:    if (node->isDry || node->is2D()) {
 5100: 
 5101:       // Minimum diffusivity at each node. In some cases, it is node-dependent (read from file).
 5102:       const double diffmin = turb.diffmin;
 5103: 
 5104:       for (int k = 0; k < nvrt; k++) {
 5105:          turb.tke[k]    = turb.tkemin();
 5106:          turb.mxl[k]    = turb.mxlmin(node->depth);
 5107:          node->dfv[k]   = diffmin;
 5108:          node->dfh[k]   = diffmin;
 5109:          turb.nu_tke[k] = diffmin;
 5110:          turb.nu_phi[k] = diffmin;
 5111:       }
 5112: 
 5113:       return;
 5114:    }
 5115: 
 5116:    assert(node->rho[0] >= -98.0 && "Impossible: dry 2"); /// XXX JMG: Do I need to fill these centinel values?
 5117:    
 5118:    // After here we know that the node is wet and has at least 2 layers.
 5119: 
 5120:    double solution[nvrt], gam[nvrt];
 5121:    
 5122:    const double eta2       = node->eta2;
 5123:    const double depth      = node->depth;
 5124:    const double Cd         = node->Cd; // Drag coefficient
 5125: 
 5126:    constexpr double c0 = 6.50736836993; //pow(16.6, 2.0/3.0); 
 5127:    
 5128:    const double sqU2 = norm2(node->u2[kb + 1]);
 5129:    const double modTau = length(node->tau);
 5130: 
 5131:  
 5132: 
 5133:    const double cpsi1 = turb.cpsi1();
 5134:    const double cpsi2 = turb.cpsi2();
 5135:    // cpsi3 is computed later because it depends on k
 5136: 
 5137: 
 5138:    // Assemble the tridiagonal system
 5139:    // -------------------------------
 5140: 
 5141:    // Loop over each vertical layer (interval between two vertical levels)
 5142:    // Each interval is an element of the vertical FEM formulation.
 5143:    // Two shape functions are defined over each interval. In this function we well call them
 5144:    // p1 and p2. The derivatives of the shape functions are called d1 and d2.
 5145:    // In general, inside the loops, 1 refers to the lower level and 2 refers to the upper level.
 5146:    //
 5147:    // Each interval contributes to two rows (vertical levels) of the tridiagonal system.
 5148:    // Both systems of equations are assembled in the same loop.
 5149:    for (int k = kb + 1, kin = 0; k < ivrt; k++, kin++) {
 5150: 
 5151:       // Indices for the *rows* of the tridiagonal system.
 5152:       const int k1 = k - kb - 1; // Zero at k = kb + 1
 5153:       const int k2 = k - kb;     // One at k = kb + 1
 5154: 
 5155:       // Get the properties of the current interval.
 5156:       const double z  = node->z[k]; // bottom level of the interval
 5157:       const double dz = node->Dz(k + 1);
 5158:       
 5159:       const Vector2 du_dz_c   = (node->u2[k+1] - node->u2[k])/dz;
 5160: 
 5161:       // Turbulence production/dissipation terms (at the center of the interval).
 5162:       
 5163:       const double M2 = norm2(du_dz_c);              // Shear production term
 5164: 
 5165:       const double N2 = turb.N2_c(node, k + 1);      // Brunt-Väisälä frequency (squared, kind of... this is signed), production or dissipation term
 5166: 
 5167:       const double vegProd = turb.vegTurbProduction(node, k + 1);
 5168: 
 5169:       const double cpsi3 = turb.cpsi3(N2); 
 5170: 
 5171: 
 5172:       // Turbulence quantities at half levels (cell [c]enter)
 5173:       const double tke_1     = turb.tke[k];
 5174:       const double tke_2     = turb.tke[k+1];
 5175:       const double mxl_1     = turb.mxl[k];
 5176:       const double mxl_2     = turb.mxl[k+1];
 5177:       const double tke_c     = 0.5*(tke_1 + tke_2);
 5178:       const double mxl_c     = 0.5*(mxl_1 + mxl_2);
 5179:       const double nu_tke_c  = 0.5*(turb.nu_tke[k] + turb.nu_tke[k+1]);
 5180:       const double nu_phi_c  = 0.5*(turb.nu_phi[k] + turb.nu_phi[k+1]);
 5181:       const double dfv_c     = 0.5*(node->dfv[k]   + node->dfv[k+1]);
 5182:       const double dfh_c     = 0.5*(node->dfh[k]   + node->dfh[k+1]);
 5183:       const double Fwall_c   = turb.Fwall(node, k, mxl_c);
 5184: 
 5185:       // Integral of the shape function products:
 5186:       // integral of (phi_i*phi_i)dz = dz/3.0,   integral of (phi_i*phi_i+1)dz = dz/6.0
 5187:       // integral of (phi_i'*phi_i+1')dz = 1/dz, integral of (phi_i'*phi_i+1')dz = -1/dz
 5188:       const double p1p1 = dz/3.0;
 5189:       const double p1p2 = dz/6.0;
 5190:       const double d1d1 =  1.0/dz;
 5191:       const double d1d2 = -1.0/dz;
 5192: 
 5193:       // Production/dissipation related terms
 5194:       const double prod = dfv_c*M2 + veg_cfk*vegProd;
 5195:       const double buoy = dfh_c*N2;
 5196:       const double diss = pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5197: 
 5198: 
 5199: 
 5200:       // Equation for tke
 5201:       // ---------------
 5202: 
 5203:       // First row (of the two rows that the interval contributes to)
 5204:       bdia_tke[k1] += p1p1 + dt*d1d1*nu_tke_c;
 5205:       cupp_tke[k1] += p1p2 + dt*d1d2*nu_tke_c;
 5206:       rhs_tke [k1] += p1p1*tke_1 + p1p2*tke_2;
 5207: 
 5208: 
 5209:       if(prod + buoy >= 0.0) { // Net production
 5210:          rhs_tke[k1] += dt*dz/2.0*(prod + buoy);
 5211:       } else { // Net dissipation
 5212:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5213:          bdia_tke[k1] -= 2.0*tmp;
 5214:          cupp_tke[k1] -= tmp;
 5215:       }      
 5216:       
 5217:       bdia_tke[k1] += 2.0*dt*diss;
 5218:       cupp_tke[k1] += dt*diss;
 5219:       
 5220:   
 5221:       // Second row (of the two rows that the interval contributes to)
 5222:       bdia_tke[k2] += p1p1 + dt*d1d1*nu_tke_c;
 5223:       alow_tke[k2] += p1p2 + dt*d1d2*nu_tke_c;
 5224:       rhs_tke [k2] += p1p1*tke_2 + p1p2*tke_1;
 5225: 
 5226:       if (prod + buoy >= 0.0) { // Net production
 5227:          rhs_tke[k2] += dt*dz/2.0*(prod+buoy);
 5228:       } else { // Net dissipation
 5229:          const double tmp = dt*dz/6.0*(prod + buoy)/tke_c;
 5230:          bdia_tke[k2] -= 2.0*tmp;
 5231:          alow_tke[k2] -= tmp;
 5232:       }
 5233:       
 5234:       bdia_tke[k2] += 2.0*dt*diss;
 5235:       alow_tke[k2] += dt*diss;
 5236: 
 5237: 
 5238:       // Equation for xl
 5239:       // ---------------
 5240: 
 5241:       const double rpub = turb.rpub();
 5242:       const double rmub = turb.rmub();
 5243:       const double rnub = turb.rnub();
 5244:       const double psi_1 = turb.phiFromMxl(tke_1, mxl_1); 
 5245:       const double psi_2 = turb.phiFromMxl(tke_2, mxl_2); 
 5246:       const double psi_c = 0.5*(psi_1 + psi_2);
 5247: 
 5248:       // Production/dissipation related terms
 5249:       const double prod_phi = cpsi1*dfv_c*M2 + veg_cfpsi*vegProd;
 5250:       const double buoy_phi = cpsi3*dfh_c*N2;
 5251:       const double diss_phi = cpsi2*Fwall_c*pow<3>(cmiu0)*sqrt(tke_c)/mxl_c*dz/6.0; //diss/k
 5252: 
 5253:       bdia_phi[k1] += p1p1 + dt*d1d1*nu_phi_c;
 5254:       cupp_phi[k1] += p1p2 + dt*d1d2*nu_phi_c;
 5255:       rhs_phi [k1] += p1p1*psi_1 + p1p2*psi_2;
 5256: 
 5257:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5258:          rhs_phi[k1] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5259:       } else { // Net dissipation
 5260:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5261:          bdia_phi[k1] -= 2.0*tmp;
 5262:          cupp_phi[k1] -= tmp;
 5263:       }
 5264: 
 5265:       // Production/dissipation terms
 5266:       bdia_phi[k1] += 2.0*dt*diss_phi;
 5267:       cupp_phi[k1] += dt*diss_phi;
 5268:  
 5269: 
 5270:       // row k2 (upper)
 5271:       bdia_phi[k2] += p1p1 + dt*d1d1*nu_phi_c;
 5272:       alow_phi[k2] += p1p2 + dt*d1d2*nu_phi_c;
 5273:       rhs_phi [k2] += p1p1*psi_2 + p1p2*psi_1;
 5274: 
 5275:       if (prod_phi + buoy_phi >= 0.0) { // Net production
 5276:          rhs_phi[k2] += dt*dz/2.0*(prod_phi + buoy_phi)*psi_c/tke_c;
 5277:       } else { // Net dissipation
 5278:          const double tmp = dt*dz/6.0*(prod_phi + buoy_phi)/tke_c;
 5279:          bdia_phi[k2] -= 2.0*tmp;
 5280:          alow_phi[k2] -= tmp;
 5281:       }
 5282: 
 5283:       // Production/dissipation terms
 5284:       bdia_phi[k2] += 2.0*dt*diss_phi;
 5285:       alow_phi[k2] += dt*diss_phi;
 5286: 
 5287:    }
 5288: 
 5289:    // BC
 5290:    bdia_phi[0]          += kappa * turb.rnub() * dt * turb.nu_phi[kb + 1] / turb.mxl[kb + 1];
 5291:    bdia_phi[nqrows - 1] += kappa * turb.rnub() * dt * turb.nu_phi[ivrt]   / turb.mxl[ivrt];
 5292: 
 5293: 
 5294:    // Solves for tke.
 5295:    tridag_sch<1>(nqrows, alow_tke, bdia_tke, cupp_tke, rhs_tke, solution, gam);
 5296: 
 5297: 
 5298:    // B.C. (computed using values from previous time except wind)
 5299:    const double tkesrf = max(0.5*c0*modTau,  turb.tkemin()); // Eq. (10) of Zhang & Baptista (2008)
 5300:    const double tkebot = max(0.5*c0*Cd*sqU2, turb.tkemin());
 5301: 
 5302: 
 5303:    // Update TKE.
 5304:    turb.tke[kb]     = tkebot;
 5305:    turb.tke[kb + 1] = tkebot;
 5306:    turb.tke[ivrt]   = tkesrf;
 5307:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5308:       turb.tke[k] = max(solution[kin], turb.tkemin());
 5309: // printf("tke[%d]: %f, solution[%d]: %f\n", k, turb.tke[k], kin, solution[kin]);   
 5310:    }
 5311: 
 5312: 
 5313: 
 5314:  
 5315:    // Solves for phi.
 5316:    tridag_sch<1>(nqrows, alow_phi, bdia_phi, cupp_phi, rhs_phi, solution, gam);
 5317: 
 5318: 
 5319:    // B.C. for the mixing lengths: Bottom and surface (T. Guérin)
 5320:    const double mxlbot = max(turb.mxlmin(depth), kappa*min(2.5, xlsc0*node->Dz(kb + 1))); //"2.5" to prevent over-mixing
 5321:    const double mxlsrf = max(turb.mxlmin(depth), xlsc0*node->Dz(ivrt)*kappa);
 5322: 
 5323:    turb.mxl[kb+1] = mxlbot;
 5324:    turb.mxl[ivrt] = mxlsrf;
 5325:    for (int k = kb + 2, kin = 1; k < ivrt; k++, kin++) {
 5326:       turb.mxl[k] = turb.mxlFromPhi(turb.tke[k], max(solution[kin], turb.psimin()));
 5327: 
 5328:       const double N2 = turb.N2_c(node, k);      // Brunt-Väisälä frequency 
 5329: 
 5330:       // Galperin's clipping
 5331:       if (N2 < 0.0) {
 5332:          const double upper = sqrt(-0.56*turb.tke[k]/N2);
 5333:          turb.mxl[k] = min(turb.mxl[k], upper);
 5334:       }   
 5335: 
 5336: 
 5337: 
 5338:       // Max. mixing length based on dissipation; mxlmin prevails
 5339:       const double mxlmax_dissip = pow<3>(cmiu0*sqrt(turb.tke[k]))/turb.epsmin();
 5340: 
 5341:       // Combined max. mixing length including geometric limit
 5342:       const double mxlmax = min(turb.maxMixingLength(node, k), mxlmax_dissip);
 5343: 
 5344:       // Clamp the mixing length between the minimum and maximum values
 5345:       turb.mxl[k] = clamp(turb.mxl[k], turb.mxlmin(depth), mxlmax);
 5346: 
 5347:       assert(turb.tke[k] >= 0 && "Negative TKE");
 5348: 
 5349: 
 5350:    } // for k
 5351: 
 5352: 
 5353:    // Extrapolate q2, xl to bottom mainly for diffusivities
 5354:    turb.tke[kb] = turb.tke[kb + 1];
 5355:    turb.mxl[kb] = turb.mxl[kb + 1];
 5356: 
 5357: 
 5358:    // Compute vertical diffusivities at new time
 5359:    turb.computeDiffusivities(node);
 5360: 
 5361:    // make all the variables uniform below the bottom level kb
 5362:    for (int k = 0; k < kb; k++) {
 5363:       node->dfv[k] = node->dfv[kb];
 5364:       node->dfh[k] = node->dfh[kb];
 5365:       turb.tke[k] = turb.tke[kb];
 5366:       turb.mxl[k] = turb.mxl[kb];
 5367:       turb.nu_tke[k] = turb.nu_tke[kb];
 5368:       turb.nu_phi[k] = turb.nu_phi[kb];
 5369:    }
 5370: 
 5371:       
 5372: 
 5373: }
 5374: 
 5375: 
 5376: 
 5377: 
 5378: extern "C" __global__ void setupCoefficientMatrixAndRHS(double time) {
 5379:    // Setup coefficient matrix, sparsem, for the shallow water wave equation
 5380:    // No elevation essential b.c. are imposed yet but other b.c. is imposed
 5381: 
 5382: 
 5383:    NODE(node1);
 5384: 
 5385:    node1->clearMatrixRow();
 5386:    node1->qel = 0.0;
 5387: 
 5388:    // THIS IS FOR STRUCTURES XXX
 5389:    // if ((ihydraulics!=0 && nhtblocks>0) && isblock_el(ie)>0) cycle //active block
 5390: 
 5391:    
 5392:    for (int j=0; j<node1->numElements; j++) {
 5393:       // For each element connected to the node...
 5394: 
 5395:       Point2 x0, x1, x2, x3; // Local horizontal node positions
 5396: 
 5397:       Element *elem = node1->elements[j];
 5398: 
 5399:       // Compute the average gravity
 5400:       const double grav3 = elem->mean(&Node::grav2);
 5401: 
 5402:       // Look at the documentation for the description of the terms in the following integrals
 5403: 
 5404:       // Integral I_1 
 5405:       // \bar{\breve{H}} 
 5406:       const double hhatb = elem->mean(&Side::hhat);        
 5407: 
 5408:       assert((hhatb >= 0.0 || ihhat != 1) && "Invalid hhat");
 5409: 
 5410:       const int id1 = elem->nodeLocalIdx(node1);  // Index of node1 in element->nodes[]
 5411:       const double area = elem->area;
 5412: 
 5413:       // Integral I_4
 5414:       // I_4 = \int_\Omega \left[ \phi_i\eta^n + \theta\Delta t \nabla\phi_i\cdot\pmb{E} + (1-\theta)\Delta t \nabla\phi_i \cdot\pmb{U}^n \right]d\Omega
 5415:       // Where
 5416:       // U is pmb{U}^{n+1} = \pmb{E} - g\theta\breve{H}\Delta t\nabla\eta^{n+1}
 5417: 
 5418:       // Since \nabla\phi_i is constant over the element, for the integral of U we can compute the mean value
 5419:       // of U over the element.
 5420:       const Vector2 U = elem->mean(&Side::U);
 5421: 
 5422:       const Vector2 gradPhi_1 = elem->gradPhi[id1];
 5423: 
 5424:       // Integral of \nabla\phi_i \cdot \pmb{U}^n
 5425:       const double I_4_1 = dot(gradPhi_1, U);
 5426: 
 5427: 
 5428:       // Integral of \nabla\phi_i \cdot \pmb{E}
 5429:       const double I_4_2 = dot(gradPhi_1, elem->ghat1);
 5430: 
 5431:       node1->qel += dt*area*((1 - thetai)*I_4_1 + thetai*I_4_2);      
 5432: 
 5433: 
 5434:       // Normal component of the bed velocity
 5435:       double ubedNormalComp = 0.0;
 5436:       if constexpr(imm == 2)  { // Pre-compute vnorm on the element
 5437:          Vector3 ubed = {0.0, 0.0, 0.0};
 5438:          // update_bdef(time, elem->center, elem->depth, ubed); XXX
 5439:          assert(false && "computeVerticalVelocity: not implemented for imm==2");
 5440: 
 5441:          // Computes a unit vector perpendicular to the bottom face. It is computed as the unit vector parallel to (grad(h), 1)
 5442:          const Vector2 gradDepth = elem->grad2(&Node::depth);
 5443:          const Vector3 N = normalize(toVector3(gradDepth, 1.0));
 5444: 
 5445:          // Computes the normal component of the bed velocity
 5446:          ubedNormalComp = dot(ubed, N);
 5447:       } // imm==2
 5448: 
 5449:       const double fricCoeff = grav3*thetai*(1.0 - thetai)*dt*dt*hhatb;
 5450: 
 5451:       if (elem->isTri()) {
 5452: 
 5453:          // To clarify the notation in this section: 
 5454:          //   In formulas, we use the following notation:
 5455:          //       i stands for the node under consideration (node1)
 5456:          //       j (node2) and k (node3) are the other nodes of the triangle.
 5457:          //   However, in the code, we use the following notation:
 5458:          //       id1 is the node under consideration (node1), id2, id3 are the local indices of the other nodes (node2, node3)
 5459:          const int id2 = elem->nxq(1 + id1);
 5460:          const int id3 = elem->nxq(2 + id1);
 5461:          Node *node2 = elem->nodes[id2];
 5462:          Node *node3 = elem->nodes[id3];
 5463: 
 5464:          elem->getLocalHorizontalNodePositionsTri(x0, x1, x2, id1);
 5465: 
 5466:          // integral of phi_i*phi_j
 5467:          const double ipp_ii = (1.0/6.0 )*area;
 5468:          const double ipp_ij = (1.0/12.0)*area;
 5469:          const double ipp_ik = (1.0/12.0)*area;
 5470: 
 5471:          // integral of [(grad phi_i) * (grad phi_j)]
 5472:          const double igpgp_ii = ((1.0/4.0)/area)*dot(x2-x1, x2-x1);
 5473:          const double igpgp_ij = ((1.0/4.0)/area)*dot(x2-x1, x0-x2);
 5474:          const double igpgp_ik = - igpgp_ii - igpgp_ij; // This comes from the fact that if a,b,c are vectors forming a triangle (in order), then a+b+c = 0, hence: -a.c = a.(a+b+c-c) = a.a + a.b
 5475: 
 5476:          // Computes the different components of integral I_1 of each node with respect to node i.
 5477:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5478:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5479:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5480: 
 5481:          node1->addToSparseMatrix(node1, I1_ii);
 5482:          node1->addToSparseMatrix(node2, I1_ij); 
 5483:          node1->addToSparseMatrix(node3, I1_ik);
 5484: 
 5485:          #pragma unroll
 5486:          for (int l=0; l<3; l++) {
 5487: 
 5488:             Node *node = elem->nodes[l];
 5489: 
 5490:             // Additional variation in eta due to bed deformation or vertical velocity
 5491:             double extraEta = 0.0;
 5492:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5493:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1;
 5494: 
 5495: 
 5496:             const double ipp   = elem->intPhiPhiTri(id1, l);
 5497:             const double igpgp = elem->intGradPhiGradPhiTri(id1, l);
 5498: 
 5499:             const double isElemWet = elem->isDry ? 0.0 : 1.0;  // XXXXX I added this to replicate Fortran's code, but Joseph is going to check if it is needed.
 5500: 
 5501:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp*isElemWet;
 5502:            
 5503:          }
 5504: 
 5505: 
 5506:       }
 5507:       else { // Quad
 5508:          // To clarify the notation in this section: 
 5509:          //   In formulas, we use the following notation:
 5510:          //       i stands for the node under consideration (node1)
 5511:          //       j (node2), k (node3), l (node4) are the other nodes of the quad.
 5512:          //   However, in the code, we use the following notation:
 5513:          //       id1 is the node under consideration (node1), id2, id3, id4 are the local indices of the other nodes (node2, node3, node4)
 5514:          const int id2 = elem->nxq(1 + id1);
 5515:          const int id3 = elem->nxq(2 + id1);
 5516:          const int id4 = elem->nxq(3 + id1);
 5517:          Node *node2 = elem->nodes[id2];
 5518:          Node *node3 = elem->nodes[id3];
 5519:          Node *node4 = elem->nodes[id4];   
 5520:          
 5521:          elem->getLocalHorizontalNodePositionsQuad(x0, x1, x2, x3);
 5522: 
 5523:          // integrals of phi_i*phi_j, phi_i*phi_k, phi_i*phi_l
 5524:          const double ipp_ii = elem->intPhiPhiQuad(id1, id1, x0, x1, x2, x3);
 5525:          const double ipp_ij = elem->intPhiPhiQuad(id1, id2, x0, x1, x2, x3);
 5526:          const double ipp_ik = elem->intPhiPhiQuad(id1, id3, x0, x1, x2, x3);
 5527:          const double ipp_il = elem->intPhiPhiQuad(id1, id4, x0, x1, x2, x3);
 5528: 
 5529:          // integrals of (grad phi_i) * (grad phi_i), (grad phi_i) * (grad phi_j), (grad phi_i) * (grad phi_k), (grad phi_i) * (grad phi_l)
 5530:          const double igpgp_ii = elem->intGradPhiGradPhiQuad(id1, id1, x0, x1, x2, x3);
 5531:          const double igpgp_ij = elem->intGradPhiGradPhiQuad(id1, id2, x0, x1, x2, x3);
 5532:          const double igpgp_ik = elem->intGradPhiGradPhiQuad(id1, id3, x0, x1, x2, x3);
 5533:          const double igpgp_il = elem->intGradPhiGradPhiQuad(id1, id4, x0, x1, x2, x3);
 5534: 
 5535: 
 5536:          // Computes the different components of integral I_1 of each node with respect to node i.
 5537:          const double I1_ii = ipp_ii + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ii;
 5538:          const double I1_ij = ipp_ij + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ij;
 5539:          const double I1_ik = ipp_ik + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_ik;
 5540:          const double I1_il = ipp_il + (grav3*thetai*thetai*dt*dt*hhatb)*igpgp_il;
 5541: 
 5542:          node1->addToSparseMatrix(node1, I1_ii);
 5543:          node1->addToSparseMatrix(node2, I1_ij); 
 5544:          node1->addToSparseMatrix(node3, I1_ik);
 5545:          node1->addToSparseMatrix(node4, I1_il);
 5546:   
 5547:          #pragma unroll
 5548:          for (int l=0; l<4; l++) {
 5549: 
 5550:             const Node *node = elem->nodes[l];
 5551: 
 5552:             // Additional variation in eta due to bed deformation or vertical velocity
 5553:             double extraEta = 0.0;
 5554:             if      constexpr(imm == 2) extraEta = dt*ubedNormalComp;
 5555:             else if constexpr(imm == 1) extraEta = node->bdef2 - node->bdef1; 
 5556: 
 5557:             const double ipp = elem->intPhiPhiQuad(id1, l, x0, x1, x2, x3);
 5558:             const double igpgp = elem->intGradPhiGradPhiQuad(id1, l, x0, x1, x2, x3);
 5559:             node1->qel += (node->eta2 + extraEta)*ipp - node->eta2*fricCoeff*igpgp;
 5560: 
 5561:          }         
 5562:       } 
 5563: 
 5564: 
 5565:      node1->qel += (dt/elem->i34)*elem->vsource;
 5566:       
 5567: 
 5568:    } // for all elements connected to the node
 5569:    
 5570: 
 5571:    // Boundary integrals I_{2,3,5,6}; they all vanish at land boundaries
 5572:    // I_2 and I_6 are not needed if essential b.c. are enforced by elminating rows and columns
 5573:    NodeBoundary *nodeBnd = node1->nodeBnd;
 5574:    if (nodeBnd != nullptr && !nodeBnd->isLand) {
 5575:    // If it is an open boundary node...
 5576: 
 5577:    // XXXXX DO THIS MORE NATURALLY IN A SideBnd kernel?
 5578: 
 5579:       // At least one open bnd side, maybe two
 5580:       for (int l=0; l<2; l++) { 
 5581: 
 5582:          // Gets each of the sides sharing the node. 
 5583:          SideBoundary *sideBnd = nodeBnd->sideBnd(l);
 5584: 
 5585:     
 5586: 
 5587:          // XXXX CAN WE DO THIS MORE NATURALLY IN A SideBnd Loop?
 5588:          if (sideBnd != nullptr) {
 5589:             // If the side is on a boundary...
 5590: 
 5591:             const Node *node2 = sideBnd->side->otherNode(node1); // Other node of the side
 5592: 
 5593:             // Get the boundary segment
 5594:             const BoundarySegment *sideSegment = sideBnd->segment;
 5595:             const Side *side = sideBnd->side;
 5596: 
 5597:             // Integral I_3
 5598:             if (sideSegment->ifltype != 0) {
 5599:             // Natural or Flather b.c.
 5600: 
 5601:                // Calculate I_3 even if i is on essential b.c. so as to check symmetry later
 5602:                // especially for Flather b.c.
 5603:                double ri3 = 0.0;
 5604:                if (!side->isDry) {
 5605:                   // If the side is not dry
 5606:                   
 5607:                   // Computes the side flux of (uth, vth)
 5608:                   double Vn = 0.0;
 5609:                   for (int k = side->kb; k < nvrt - 1; k++) {
 5610:                      const double vn1 = dot(sideBnd->ubc[k  ], side->n); // outer normal
 5611:                      const double vn2 = dot(sideBnd->ubc[k+1], side->n);
 5612: 
 5613:                      Vn += 0.5*(vn1 + vn2)*(side->zc[k+1] - side->zc[k]);
 5614:                   }
 5615: 
 5616:                   ri3 = 0.5*side->len*Vn;
 5617:                }
 5618: 
 5619:                if (sideSegment->ifltype == -1) { // Flather 1
 5620: 
 5621:                   assert(node1->eta2 >= -98.0 && node2->eta2 >= -98.0 && "Mismatch 1") ;
 5622:                   assert(side->depth() > 0.0 && "Negative depth at Flather boundary");
 5623: 
 5624:                   const double con0 = (1.0/6.0)*side->len*sqrt(grav*side->depth()); // For coefficient matrix
 5625:                   ri3 -= con0*(2.0*node1->eta2 + node2->eta2);
 5626:                   
 5627:                   node1->addToSparseMatrix(node1, (thetai*dt*con0)*2.0);
 5628:                   node1->addToSparseMatrix(node2, (thetai*dt*con0));
 5629: 
 5630:                } 
 5631:                else if (sideSegment->ifltype == -2) { // Discharge relation (outgoing only)
 5632:                   // Reset ri3
 5633:                   ri3 = 0.0;
 5634: 
 5635:                   assert(polyDischarge != nullptr && "polyDischarge is not initialized. This part might not even be implemented.");
 5636:                   assert(sideSegment->clen != 0.0 && "clen is 0.0, this means that the segment is completely wetted");
 5637: 
 5638:                   const double etam = 0.5*(node1->eta2 + node2->eta2);
 5639: 
 5640:                   const double tmp = polyDischarge->eval(etam)/sideSegment->clen; // XXXX IMPLEMENT Poly. It may need the grade (4 in this case)
 5641:                   assert(tmp >= 0.0 && "bar{f} < 0 at discharge boundary");
 5642: 
 5643:                   const double con0 = (1.0/6.0)*side->len*tmp*thetai*dt;
 5644:                   node1->addToSparseMatrix(node1, con0*2.0);
 5645:                   node1->addToSparseMatrix(node2, con0);
 5646: 
 5647:                } // if Flather or Discharge
 5648: 
 5649:                node1->qel -= thetai*dt*ri3;  
 5650: 
 5651: 
 5652:             } // I_3
 5653:           
 5654: 
 5655:             // Integral I_5
 5656:             if(!side->isDry) {
 5657: 
 5658:                const double Unbar = dot(side->U, side->n);
 5659:                node1->qel -= 0.5*(1.0 - thetai)*dt*side->len*Unbar; 
 5660: 
 5661:             } // I_5
 5662: 
 5663:          } // if is boundary side
 5664: 
 5665:       } // for l
 5666: 
 5667:    } // if isbnd
 5668: 
 5669: 
 5670: }
 5671: 
 5672: 
 5673: 
 5674: extern "C" {
 5675: 
 5676:    __global__ void gatherBFromMesh(double* b) {
 5677:       // b[local] <- qel  (local = idx_node on this device)
 5678:       NODE(node);
 5679:       b[idx_node] = node->qel;
 5680:    }
 5681: 
 5682:    
 5683:    __global__ void scatterXToMesh(double* x) {
 5684:       // mX <- x[local]
 5685:       NODE(node);
 5686:       node->mX = x[idx_node];
 5687:    }
 5688: 
 5689:    __global__ void setupCGSolver(double* data_d, double* b_d, 
 5690:                                  int* indices, int* indptr) {
 5691:       // XXXXXXXXXXXX REMOVE!!!
 5692:       assert(false && "setupCGSolver has beed deprecated");
 5693: 
 5694:       // NODE(node);
 5695:       
 5696:       // const int idx = node->idx;
 5697:       
 5698:       // // Computes the index in the nzz array      
 5699:       // const int nzzIdx = (node->nodes - mesh->nodeNeighNodes) + idx; // idx is there to account for the diagonal element that is not stored in the nodeNeighNodes array
 5700: 
 5701: 
 5702:       // indptr[idx] = nzzIdx;
 5703:       // indices[nzzIdx] = idx;
 5704: 
 5705:       // data_d[nzzIdx]    = node->coeffDiag;
 5706: 
 5707:       // b_d[idx] = node->qel;
 5708: 
 5709:       // for (int k = 0; k < node->numNodes; ++k) {
 5710:       //    const Node* nb = node->nodes[k];
 5711: 
 5712:       //    const int j = nb->idx;
 5713: 
 5714:       //    data_d[nzzIdx + k + 1]    = node->coeffMatrix[k];
 5715: 
 5716:       //    indices[nzzIdx + k + 1] = j;
 5717:       // }
 5718: 
 5719:    }
 5720: 
