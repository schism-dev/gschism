 3595: 
 3596: //       if (delta != 0.0) {
 3597: //          // Solves the two linear equations for tt1 and tt2
 3598: //          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 3599: //          const double tt2 = delta2/delta;
 3600: 
 3601: //          // It is enough to check tt2, since the range [0,1] is the same for both tt1 and tt2.
 3602: //          // Similarly, we use tt2 to compute the intersection point.
 3603: //          if (tt2 >= -small && tt2 <= 1.0 + small) {
 3604: //             xIntersect = x3 + (x4 - x3)*tt2;
