 1742: __device__ __forceinline__ Vector3 Element::n(int k, double &area3D) const {
 1743:    // Computes the 3D normal vector to the element at level k
 1744:    // Returns the normal vector and the area of the element
 1745: 
 1746:       if (isTri()) {
 1747:          // For triangles...
 1748: 
 1749:          // Gets the normal vector to the element (with a length equal to twice the area)
 1750:          if constexpr(ics==1) {
 1751:             const int kb0 = max(k, nodes[0]->kb);
 1752:             const int kb1 = max(k, nodes[1]->kb);
 1753:             const int kb2 = max(k, nodes[2]->kb);
 1754: 
 1755:             const Vector3 n20 = nodes[2]->p3(k) - nodes[0]->p3(k);
 1756:             const Vector3 n10 = nodes[1]->p3(k) - nodes[0]->p3(k);
 1757:             
 1758:             // Computes the cross product of vectors (n2 - n0) and (n1 - n0). 
 1759:             const double nx = (n10.y)*(n20.z) - (n20.y)*(n10.z);
 1760:             const double ny = (n20.x)*(n10.z) - (n10.x)*(n20.z);
 1761:             const double nz = 2.0*area; // = (n10.x)*(n20.y) - (n20.x)*(n10.y);
 1762: 
 1763:             const double len = sqrt(nx*nx + ny*ny + nz*nz);
 1764:             area3D = 0.5*len;
 1765: 
 1766:             assert(area3D > 0.0 && "Element normal vector: area3D is negative");
 1767: 
 1768:             return {nx/len, ny/len, nz/len};
 1769: 
 1770:            
 1771:          }
 1772:          else {  // lat/lon
 1773:             assert(false && "Element normal vector: lat/lon not implemented for triangles");
 1774: 
 1775:          } // if ics
 1776:       }
 1777:       else {
 1778:          // For quads...
 1779: 
 1780:          assert(false && "Element normal vector: quads not yet implemented");
 1781: 
 1782: 
 1783:       }
 1784:    }
 1785: 
 1786: /**
 1787:    For a point on a side of an element and a line segment starting at that point and ending at (x2,y2), 
 1788:    find the intersection point (given by parameter tIntersect) and the side (intersectingSide) that it intersects.
 1789:    If the segment is completely inside the element, then it returns true.
 1790: 
 1791:    This function assumes:
 1792:    - The initial point is on a side of the element. 
 1793:    - Its position is given by parameter t in the range [0,1].
 1794:    - The line segment starting at that point and ending at (x2,y2) is either completely inside the element or it 
 1795:       intersects the element (elements are convex).
 1796: 
 1797:    To find the intersection point, this function does the following:
 1798:    - it finds the intersection of the line segment with all the element side lines,
 1799:       except for the one that contains the initial point.
 1800:    - Because we do the interection with the lines (not the segments), the t parameter is not ncessearily in the range [0,1].
 1801:    - let's call t1i the t parameter for the track segment and t2i the t parameter for the element side line.
 1802:    - We want the closest intersection point, for which t1i > 0 and t2i in [0,1].
 1803:    - From construction, we know that this intersection point *must* exist, even in extreme cases, like when the
 1804:       track segment is almost parallel to the element side line.
 1805: 
 1806:    Inputs:
 1807:    @param t: t*side.n1 + (1-t)*side.n2 is the point on the side
 1808:    @param x2, y2: other end of the line segment
 1809: 
 1810:    Outputs:
 1811:    @param side:  side that intersects the line segment (input and output)
 1812:    @param nextElement (output): element that contains the intersection point
 1813:    @param tIntersect (output): New intersection point tIntersect*side.n1 + (1-tIntersect)*side.n2
 1814:    @param zint (input/output): Vertical coordinate of the intersection point
 1815: 
 1816:    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 1817:    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 1818:    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
 1819: 
 1820:    If the two segments are parallel, they do not intersect. This is checked by the determinant of the two vectors
 1821:    (Delta) being zero.
 1822: 
 1823:    The intersection2 point happens when:
 1824:    tt1(x2-x1) - tt2(x4-x3) = x3-x1
 1825:    tt1(y2-y1) - tt2(y4-y3) = y3-y1
 1826:    
 1827:    Assumption: the 4 points (including those of the side segment) are different.
 1828:    The eqs. for the 2 lines are: X=X1+(X2-X1)*tt1 and X=X3+(X4-X3)*tt2.	
 1829:    Output: false: no intersection or colinear; true: exactly 1 intersection.	
 1830:    If true, (xIntersect,yIntersect) is the intersection.				
 1831:    Modified to only check tt2, assuming 0<=tt1<=1 is already assured. 
 1832: **/
 1833: __device__ bool Element::findNextIntersection(Point2 x2, Side *&side, Element *&nextElement,
 1834:                                               double &t, double& tIntersect) {
 1835: 
 1836:    double closest_intersect_t = 1e10;
 1837:    bool found_intersection = false;
 1838: 
 1839:    // (x1,y1)-(x2,y2) is the track line segment. Every step we move (x1,y1) to the next
 1840:    // intersection point, at position t on "side". The final position is (x2,y2)=(xt,yt).
 1841:    const Point2 x1 = side->point(t);
 1842:    
 1843: 
 1844:    Side *nextSide = nullptr;
 1845:    for (int i = 0; i < i34; i++) {
 1846: 
 1847:       // Element's i-th side 
 1848:       Side *side2 = sides[i];
 1849: 
 1850:       // Skip the side that contains the initial point
 1851:       if (side2 == side) continue;
 1852: 
 1853:       // (x3,y3)-(x4,y4) is the element side line
 1854:       const Point2 x3 = side2->n1->p2();
 1855:       const Point2 x4 = side2->n2->p2();
 1856: 
 1857:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1858:       const double delta = cross(x2 - x1, x3 - x4);
 1859: 
 1860:       if (delta != 0.0) {
 1861: 
 1862:          const double delta1 = cross(x3 - x1, x3 - x4);
 1863:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1864: 
 1865:          // Solves the two linear equations for tt1 and tt2
 1866:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1867:          const double tt2 = delta2/delta;
 1868: 
 1869:          if (tt1 > 0.0 && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0) {
 1870:             closest_intersect_t = min(closest_intersect_t, tt1);
 1871:             nextSide = side2;
 1872: 
 1873:             nextElement = nextSide->otherElem(this);
 1874:             tIntersect = max(small, min(tt1, 1.0-small));
 1875:             t = tt2;
 1876: 
 1877:             found_intersection = true;
 1878:          }
 1879:       
 1880:       }
 1881: 
 1882:    }
 1883: 
 1884:    // found_intersection should always be true, since we checked all the sides.  
 1885:    side = nextSide;
 1886: 
 1887:    return found_intersection;
 1888: }
 1889: 
 1890: 
 1891: 
 1892: 
 1893: __device__ bool Element::findNextIntersection(Point2 x1, Point2 x2, Side *&side, Element *&nextElement,
 1894:                                               double &t, double& tIntersect) {
 1895: 
 1896:    double closest_intersect_t = 1e10;
 1897:    bool found_intersection = false;
 1898: 
 1899:    for (int i = 0; i < i34; i++) {
 1900: 
 1901:       Side *side2 = sides[i];
 1902: 
 1903:       // (x3,y3)-(x4,y4) is the element side line
 1904:       const Point2 x3 = side2->n1->p2();
 1905:       const Point2 x4 = side2->n2->p2();
 1906: 
 1907:       // delta is 0 if the two lines are parallel. In this case, they do not intersect.
 1908:       const double delta = cross(x2 - x1, x3 - x4);
 1909: 
 1910:       if (abs(delta) > 0) {
 1911: 
 1912:          const double delta1 = cross(x3 - x1, x3 - x4);
 1913:          const double delta2 = cross(x2 - x1, x3 - x1); 
 1914: 
 1915:          // Solves the two linear equations for tt1 and tt2
 1916:          const double tt1 = delta1/delta; // delta is not zero, so we can divide
 1917:          const double tt2 = delta2/delta;
 1918: 
 1919:          if (tt1 >= -small && tt2 >= -small && tt2 <= 1.0 + small && tt1 <= 1.0 + small) {
 1920:             closest_intersect_t = min(closest_intersect_t, tt1);
 1921:             side = side2;
 1922:             nextElement = side->otherElem(this);
 1923:             t = tt2;
 1924:             tIntersect = max(small, min(tt1, 1.0-small));
 1925:             found_intersection = true;
 1926:          }
 1927:       
 1928:       }
 1929:       else {  // parallel segments
 1930:          assert(false && "Parallel segments");
 1931:          // // In this case, we theck if they are colinear. if they are, we compute the intersection point as:
 1932:          // // tt2 += length(x1 - x2) * sign(dot(x1 - x2, x3 - x4)) in {0, 1}
 1933: 
 1934:          // // Check if the segments are colinear. It is enough to check if x1 is on the line of the side segment.
 1935: 
 1936:          // const double dist = dot(x1 - x3, side2->n);
 1937:          // if (abs(dist) < small*length(x3 - x4)) {
 1938:          //    const double2 unitarySide = normalize(x4 - x3);
 1939:          //    const double len = dot(x2 - x1, unitarySide);
 1940:          //    t = t + len;
 1941:          //    t = max(0.0, min(t, 1.0));
 1942:          //    printf("BEEEEEBB t = %.17e, dist = %.17e, len = %.17e, x1 = (%e,%e), x2 = (%e,%e), x3 = (%e,%e), x4 = (%e,%e)\n", t, dist, len, x1.x, x1.y, x2.x, x2.y, x3.x, x3.y, x4.x, x4.y);
 1943: 
 1944: 
 1945:          //    // tIntersect = max(small, min(tt1, 1.0-small));
 1946:          //    // t = tt2;
 1947:          //    found_intersection = true;
 1948:          // }
 1949:       }
 1950: 
 1951: 
 1952:    }
 1953: 
 1954:       
 1955:    assert(found_intersection && "No intersection found");
 1956: 
 1957:    // found_intersection should always be true, since we checked all the sides.  
 1958:    return found_intersection;
 1959: }
 1960: 
 1961: 
 1962: __device__ void Element::trackGoesOutOfWater(Side *nextSide, Element *curElem, double tt, int jlev,
 1963:                                              double &dt, Point3 &xt, double zint, Vector3 &u_int) {
 1964: 
 1965:    printf("Tracking segment goes out of water at element %i, nextSide = %i, xt = %.17g, yt = %.17g, ux = %.17g, uy = %.17g\n", curElem->idx, nextSide->idx, xt.x, xt.y, u_int.x, u_int.y);
 1966: 
 1967:    // When this happens, we stop our algorithm that usually assumes that we move to the next element.
 1968:    // Instead, we nudge the intersection point to the barycenter of the element, and nextElement becomes
 1969:    // curElement.
 1970: 
 1971:    // Then it finds the tangential velocity at the element side (the side where the intersection was found),
 1972:    // And uses this velocity instead to continue the tracking.
 1973: 
 1974:    // computes the intersection point in cartesian coordinates
 1975:    Point2 intersection = nextSide->p_t(tt);
 1976: 
 1977:    // Nudges the point to the barycenter of the element. 
 1978:    // This ensures that the point is inside the element and hence, we will find an intersection if the
 1979:    // next segment intersects the element sides.  
 1980:    curElem->nudgeToBarycenter(intersection);
 1981: 
 1982:    // Computes the tangential velocity at the side. Note that we are not using the x,y,z location
 1983:    // of the intersection point. We are approximating it by the velocity at the side center at jlev.
 1984:    // NOTE: With the new code it will be easy to compute the tangential velocity at the intersection point.
 1985:    double vtan = dot(nextSide->t(), nextSide->u2[jlev]);
 1986: 
 1987:    // If the side is an open boundary, the tangential velocity is zero.
 1988:    if (nextSide->isBnd()) vtan = 0.0;
 1989: 
 1990:    // The new velocity components are computed from the tangential velocity and the tangent vector.
 1991:    const double us = vtan*nextSide->t().x;
 1992:    const double vs = vtan*nextSide->t().y;
 1993:    const double ws = 0.5*(nextSide->n1->w2[jlev] + nextSide->n2->w2[jlev]);
 1994: 
 1995:    // Compute the new "tracked" time based on the remaining segment length and the original velocity.
 1996:    const double len2 = norm2(intersection - toPoint2(xt));
 1997:    const double vel2 = dot(u_int, u_int);        
 1998:    if (vel2 > 0.0) dt = dt - sqrt(len2/vel2); 
 1999:    else            dt = 0.0;
 2000: 
 2001:    // The end of this tracking segment is now the intersection point.
 2002:    xt = {intersection.x, intersection.y, zint};
 2003: 
 2004:    u_int = {us, vs, ws};
 2005:    
 2006: }
 2007: 
 2008: /**
 2009:  * Tracks a particle through elements and vertical levels in the mesh.
 2010:  * 
 2011:  * @param x0,y0,z0     Starting position coordinates
 2012:  * @param xt,yt,zt     Target position coordinates
 2013:  * @param dtb          Time step for tracking
 2014:  * @param uuint,vvint,wwint Initial velocity components
 2015:  * @param nextElem     Starting/resulting element index
 2016:  * 
 2017:  * @return Status code of type trackExitCodes
 2018:  * 
 2019:  * This function uses the same ideas as the original Fortran code (function QuickSearch), but some
 2020:  * of the details are different. The idea is that the code requires less branches and is better fit
 2021:  * for GPU execution.
 2022:  * 
 2023:  * The main ideas here are:
 2024:  * - The starting point is expected to be in the starting element.
 2025:  * - The end point is guaranteed to be inside an element.
 2026:  * - since the starting point is inside the element, there are only two cases: 
 2027:  *     (a) segment (x0,y0)-(xt,yt) intersects the element sides, or 
 2028:  *     (b) it does not and (xt,yt) is already in the starting element.
 2029:  * - If (xt,yt) is not inside the element, we know that an interection must exist. We compute the intersection
 2030:  *   of the segment with the *lines* (infinite length) that form the element sides.
 2031:  * - The intersection is computed as the parametric value tt1 of the intersection point on the segment (x0,y0)-(xt,yt).
 2032:  * - tt1 can be positive or negative. We only consider the positive values.
 2033:  * - tt2 is the parametric value of the intersection point on the element side segment.
 2034:  * - The next intersection will occur at the smallest positive tt1.
 2035:  * - This intersection will be the next (x0,y0) position.
 2036:  * - Proceeding this way it is guaranteed that we are always moving forward, so there is no chance
 2037:  *   of getting stuck in a loop.
 2038:  * - Additionally, this function never finds intersections with the side segment where the last intersection
 2039:  *   was found.
 2040:  */
 2041: __device__ bool Element::trackThroughElementsAndLevels(Point3 x0, Point3 &xt, Vector3 &u_int, 
 2042:                                                        Element *&nextElem, int &jlev, double &dt,
 2043:                                                        const Side *origSide) {
 2044: 
 2045: 
 2046: 
 2047:    // First thing is to check if the target point is inside the element. If it is, there is nothing
 2048:    // else to do.
 2049:    // If it is, nudges the point to be inside the element.
 2050:    const Element *curElem = nextElem;
 2051:    if (containsPoint(toPoint2(xt), true)) {
 2052: 
 2053:       curElem->interpolateVelocities(xt, u_int);
 2054: 
 2055: addDebugPlot(x0, xt);
 2056:       return true;
 2057:    }
 2058: 
 2059:    Side *side = nullptr;
 2060: 
 2061:    // 1. Initial checks
 2062:    // Verify starting element is valid (wet)
 2063:    assert(!curElem->isDry && "Starting element is dry");
 2064: 
 2065:    // Checks if track has a zero length.
 2066:    const double len2 = (xt.x - x0.x)*(xt.x - x0.x) + (xt.y - x0.y)*(xt.y - x0.y);   
 2067:    // assert(len2 > 0.0 && "Zero length track"); 
 2068:    
 2069:    const int MAX_ITERATIONS = 1000;
 2070:    
 2071:    double t;
 2072:    Side *nextSide = nullptr;
 2073:    double tIntersect = 1e10;
 2074:    double zint = x0.z;
 2075: 
 2076:    // Horizontal tracking loop
 2077:    // Finds the first intersection with the element sides. It is guaranteed to exist because
 2078:    // (x0,y0) is inside the element but the target point is not.
 2079: 
 2080:    bool found_intersection = findNextIntersection(toPoint2(x0), toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2081: 
 2082:    assert(found_intersection && "No intersection found at %d");
 2083: 
 2084:    zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2085: 
 2086:    // if the tracking segment goes out of water (either dry or edge boundary)
 2087:    if (isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2088: 
 2089: addDebugPlot(x0, xt, 0x00A0FF);
 2090:       trackGoesOutOfWater(nextSide, this, t, jlev, dt, xt, zint, u_int);
 2091: addDebugPlot(x0, xt, 0x00A0FF);      
 2092: 
 2093:       nextElem = this;
 2094:       // Returns "early", meaning that we stopped before we were able to reach the target point.
 2095:       // In this case, the caller (btrack) needs to take into account the remaining time.
 2096:       return true;    
 2097:    }
 2098: 
 2099: 
 2100:    // Keeps searching for the next intersection until we find xt, yt inside nextElem.
 2101:    int iterations = 0;
 2102:    while (iterations < MAX_ITERATIONS) {
 2103:       iterations++;
 2104:       
 2105:       Element *curElem = nextElem;
 2106: 
 2107:       bool found_intersection = curElem->findNextIntersection(toPoint2(xt), nextSide, nextElem, t, tIntersect);
 2108: addDebugPlot(x0, xt);
 2109:       zint = (1 - tIntersect)*zint + tIntersect*xt.z;
 2110: 
 2111:       // If we are already in the target element, we are done.
 2112:       // Remember that, if we are here, the point (xt,yt) is inside curElem.
 2113:       if (!found_intersection) break;
 2114: 
 2115: 
 2116: 
 2117:       // if the tracking segment goes out of water (either dry or edge boundary).
 2118:       if (curElem->isEdgeBoundary(nextSide) || (nextElem == nullptr || nextElem->isDry)) {
 2119: addDebugPlot(x0, xt, 0x00A0FF);
 2120:          trackGoesOutOfWater(nextSide, curElem, t, jlev, dt, xt, zint, u_int);
 2121: addDebugPlot(x0, xt, 0x00A0FF);   
 2122:          nextElem = curElem;
 2123: 
 2124:          // Returns "early", meaning that we stopped before we were able to reach the target point.
 2125:          // In this case, the caller (btrack) needs to take into account the remaining time.
 2126:          return true;
 2127:       }
 2128:       
 2129:       // Update position and element for next iteration
 2130:       side = nextSide;
 2131: 
 2132:    }
 2133: 
 2134:    assert(iterations < MAX_ITERATIONS && "Iteration limit reached");  
 2135: 
 2136:  
 2137:    // Interpolate velocities at the final position. This is a conceptually simple step,
 2138:    // but the function is not simple, because it has to search for the vertical level containing zt.
 2139: addDebugPlot(x0, xt);   
 2140:    nextElem->interpolateVelocities(xt, u_int); 
 2141: 
 2142:    return true;
 2143: }
 2144: 
 2145: 
 2146: __inline__ __device__ double Element::computeSignedArea(void) const {
 2147:    // Compute the area of the element
 2148: 
 2149:    double res = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[2]->p2());
 2150: 
 2151:    // In the quad case we need to add the area of the other triangle.
 2152:    if (isQuad()) {
 2153:       double ar1 = signedArea(nodes[0]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2154:       double ar2 = signedArea(nodes[0]->p2(), nodes[1]->p2(), nodes[3]->p2());
 2155:       double ar3 = signedArea(nodes[1]->p2(), nodes[2]->p2(), nodes[3]->p2());
 2156:       assert (ar1 >= 0.0 && ar2 >= 0.0 && ar3 >= 0.0 && "Negative area found in quad element");
 2157: 
 2158:       res += ar1;
 2159:    }
 2160: 
 2161:    return res;
 2162: }
 2163: 
 2164: 
 2165: __inline__ __device__ bool Element::isDry2(void) const { return (nodes[0]->isDry2()) ||
 2166:                                                                 (nodes[1]->isDry2()) ||
 2167:                                                                 (nodes[2]->isDry2()) ||
 2168:                                                                 (i34==4 && nodes[3]->isDry2());
 2169: }
 2170: 
 2171: __inline__ __device__ double Element::detJ_eta(void) const {
 2172:    return (nodes[1]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[3]->p.y) 
 2173:         - (nodes[2]->p.x - nodes[3]->p.x)*(nodes[1]->p.y - nodes[0]->p.y);
 2174: }
 2175: 
 2176: __inline__ __device__ double Element::detJ_xi(void) const {
 2177:    return (nodes[2]->p.x - nodes[1]->p.x)*(nodes[3]->p.y - nodes[0]->p.y) 
 2178:         - (nodes[3]->p.x - nodes[0]->p.x)*(nodes[2]->p.y - nodes[1]->p.y);
 2179: }
 2180: 
 2181: __inline__ __device__ bool Element::isEdgeBoundary(Side *side) const { 
 2182:    // In boundary sides, the element 1 is nullptr
 2183:    return side->elems[1] == nullptr; 
 2184: }
 2185: 
 2186: 
 2187: 
 2188: /**
 2189:    Compute the shape coordinates of the point (xt,yt) in the element.
 2190:    @param xt (input): x-coordinate of the point
 2191:    @param shpCoords (output): shape coordinates of the point
 2192:    @param fixNegshpCoord (input): if true, fix negative shape coordinates
 2193:    @return true if the point is inside the element, false otherwise
 2194: **/
 2195: __device__ bool Element::computeShapeCoords(Point2 &xt, double shpCoords[4],
 2196:                                             bool fixNegshpCoord) const {
 2197: 
 2198:    // Compute the shape coordinates of the point xt in the element.
 2199:    if (i34==3) {
 2200:       // Compute area coordinates for a given pt w.r.t. to a triangular element
 2201:       // If ifl=1, will fix 0 or negative area coord. (assuming it's not too negative)
 2202:       // and in this case, the pt will be nudged into the element
 2203:       // It's not reliable to use the area coord for ics=2 when the pt is far away
 2204:       // from the local frame, so use additional check.
 2205: 
 2206:       Point2 x0, x1, x2;
 2207: 
 2208:       if constexpr(ics==1) {
 2209:          x0 = nodes[0]->p2();
 2210:          x1 = nodes[1]->p2();
 2211:          x2 = nodes[2]->p2();
 2212:       }
 2213:       else // lat/lon
 2214:       {
 2215:          Error("Not implemented yet");
 2216: #ifdef ICS2
 2217:          globalToLocal(nodes[0]->x, nodes[0]->y, nodes[0]->z, x0, y0, z0);
 2218:          globalToLocal(nodes[1]->x, nodes[1]->y, nodes[1]->z, x1, y1, z1);
 2219:          globalToLocal(nodes[2]->x, nodes[2]->y, nodes[2]->z, x2, y2, z2);
 2220: #endif
 2221:       }
 2222: 
 2223:       shpCoords[0] = signedArea(xt,x1,x2)/area;
 2224:       shpCoords[1] = signedArea(x0,xt,x2)/area; 
 2225:       shpCoords[2] = 1.0 - shpCoords[0] - shpCoords[1];
 2226:       shpCoords[3] = 0.0;
 2227:       double tmpmin  = min3(shpCoords[0], shpCoords[1], shpCoords[2]);
 2228: 
 2229:       // If at least one of the shape coordinates is negative, and we have the flag fixNegshpCoord set,
 2230:       // then we fix the negative shape coordinates.
 2231:       if (fixNegshpCoord && tmpmin<=0.0) {
 2232: 
 2233:          // NOTE: I have changed this algorithm. Now it scales and offsets all the shape coordinates by the same factor,
 2234:          // keeping the sum of the shape coordinates equal to 1.
 2235:          // I have tested and compared the new algorithm with the old one, and they give
 2236:          // very similar results in terms of how close the "fixed" point is to the original point in cartesian coordinates.
 2237:          // The new algorithm should be faster since it is branchless.
 2238:          const double a = - tmpmin + 1.0e-4;  // XXX it used to be 1.0e-4 in the comments of the original code
 2239:          const double b = 1.0/(shpCoords[0] + shpCoords[1] + shpCoords[2] + 3.0*a);
 2240:          
 2241:          shpCoords[0] = (shpCoords[0] + a)*b;
 2242:          shpCoords[1] = (shpCoords[1] + a)*b;
 2243:          shpCoords[2] = (shpCoords[2] + a)*b;          
 2244: 
 2245:          if (shpCoords[0] < 0.0 || shpCoords[1] < 0.0 || shpCoords[2] < 0.0 ||
 2246:              shpCoords[0] > 1.0 || shpCoords[1] > 1.0 || shpCoords[2] > 1.0) {
 2247:             Error("Negative shape coordinates in computeshpCoord, when fixNegshpCoord is true");
 2248:          }
 2249: 
 2250:          // Update the point coordinates for the new shape coordinates
 2251:          double xcoords[3] = {x0.x, x1.x, x2.x};
 2252:          double ycoords[3] = {x0.y, x1.y, x2.y};
 2253:          xt = {dotprod3(xcoords, shpCoords), dotprod3(ycoords, shpCoords)};
 2254: 
 2255:       }
 2256: 
 2257:       // Check if the point is inside the element
 2258:       return min(min(shpCoords[0], shpCoords[1]), shpCoords[2]) > -small;      
 2259:    }
 2260:    else {
 2261:       Error("Not implemented yet");
 2262: #ifdef QUADS
 2263:       // Reproject pt in eframe of nel for ics=2
 2264:       if constexpr(ics==1) {
 2265:          xn2 = xt; 
 2266:          yn2 = yt;
 2267:       }
 2268:       else {
 2269:          localToGlobal(xt, yt, gcor0, xcg2, ycg2, zcg2)
 2270:          globalToLocal(xcg2, ycg2, zcg2, xctr, yctr, zctr, xn2, yn2, zn2)
 2271:       }
 2272: 
 2273:       return quad_shape(1,6,nnel,xn2,yn2,inside2,arco)
 2274: #endif
 2275:    }
 2276: 
 2277:    return false;  // Never reached
 2278: 
 2279: }
 2280: 
 2281: 
 2282: __device__ void Element::shapeCoordsToXY(double shpCoords[4], Vector2 &xt) const {
 2283: // Convert shape coordinates to cartesian coordinates
 2284: 
 2285:    if (i34 == 3) {
 2286:       // Triangular element
 2287:       double xcoords[3] = {nodes[0]->p2().x, nodes[1]->p2().x, nodes[2]->p2().x};
 2288:       double ycoords[3] = {nodes[0]->p2().y, nodes[1]->p2().y, nodes[2]->p2().y};
 2289:    }
 2290:    else {
 2291:       assert(false && "shapeCoordsToXY: quadrilateral element not implemented");
 2292:    }
 2293: 
 2294: }
 2295: 
 2296: __device__ double Element::intPhiPhi(int i1, int i2) const {
 2297:    // return \int \phi_i1*\phi_i2 dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2298:    // The integral is computed analytically, using the shape functions in xi and eta coordinates and the Jacobian.
 2299:    // The formula for the integral is:
 2300:    // (area/16)(1+\xi_i\xi_j/3)(1+\eta_i\eta_j/3) + (detJ_xi/12)(1+\eta_i\eta_j/3)(\xi_i+\xi_j) + (detJ_eta/12)(1+\xi_i\xi_j/3)(\eta_i+\eta_j)\]
 2301: 
 2302:    printf("intPhiPhi: TEST\n");
 2303: 
 2304:    const Node *n0 = nodes[0];
 2305:    const Node *n1 = nodes[1];
 2306:    const Node *n2 = nodes[2];
 2307:    const Node *n3 = nodes[3];
 2308: 
 2309:    const Vector2 p0 = n0->p2();
 2310:    const Vector2 p1 = n1->p2();
 2311:    const Vector2 p2 = n2->p2();
 2312:    const Vector2 p3 = n3->p2();
 2313: 
 2314:    double xi_term  = 1.0 + (ixi_n[i1]*ixi_n[i2])/3.0;
 2315:    double eta_term = 1.0 + (iet_n[i1]*iet_n[i2])/3.0;
 2316:    double eta_sum  = iet_n[i1] + iet_n[i2];
 2317:    double xi_sum   = ixi_n[i1] + ixi_n[i2];
 2318: 
 2319:    return (1.0/16.0)*area*xi_term*eta_term + (detJ_xi()/12.0)*xi_term*eta_sum + (detJ_eta()/12.0)*eta_term*xi_sum;
 2320: }
 2321:    
 2322: 
 2323: __device__ double Element::intGradPhiGradPhi(int i1, int i2) const {
 2324:    // return \int (grad phi_i1).(grad phi_i2) dA, where phi_i1 and phi_i2 are the shape functions of the nodes i1 and i2.
 2325:    // The integral is computed by using the 2x2 Gauss-Legendre quadrature points in xi and eta coordinates.
 2326:    // Again, it uses the determinant of the Jacobian to compute the integral in x,y coordinates.
 2327:    // The formula is also based on the identity:
 2328:    //   dPhi/dx = (1/det J) * [ (dPhi/dxi)*(dy/deta) - (dPhi/deta)*(dy/dxi)]
 2329:    //   dPhi/dy = (1/det J) * [-(dPhi/dxi)*(dx/deta) + (dPhi/deta)*(dx/dxi)]
 2330: 
 2331:    printf("intGradPhiGradPhi: TEST\n");   
 2332: 
 2333:    assert(isQuad() && i1 >= 0 && i2 >= 0 && i1 < 4 && i2 < 4 && "intGradPhiGradPhi: not quad");
 2334: 
 2335:    const double x0 = nodes[0]->p.x;
 2336:    const double y0 = nodes[0]->p.y;
 2337:    const double x1 = nodes[1]->p.x;
 2338:    const double y1 = nodes[1]->p.y;
 2339:    const double x2 = nodes[2]->p.x;
 2340:    const double y2 = nodes[2]->p.y;
 2341:    const double x3 = nodes[3]->p.x;
 2342:    const double y3 = nodes[3]->p.y;
 2343: 
 2344:    double res = 0.0;
 2345:    
 2346:    // Quadrature points in xi and eta coordinates
 2347:    #pragma unroll
 2348:    for (int i = 0; i < 4; i++) {
 2349:       // For each quadrature point...
 2350: 
 2351:       const Point2 p = GaussPoint(i);
 2352:       const double eta = p.x;
 2353:       const double xi  = p.y;
 2354: 
 2355:       // Jacobian entries at the Gauss point p
 2356:       const double dx_dxi  = 0.25 * ( (x1 + x2 - x0 - x3) + xi *(x0 + x2 - x1 - x3) );
 2357:       const double dx_deta = 0.25 * ( (x2 + x3 - x0 - x1) + eta*(x0 + x2 - x1 - x3) );
 2358:       const double dy_dxi  = 0.25 * ( (y1 + y2 - y0 - y3) + xi *(y0 + y2 - y1 - y3) );
 2359:       const double dy_deta = 0.25 * ( (y2 + y3 - y0 - y1) + eta*(y0 + y2 - y1 - y3) );      
 2360: 
 2361:       const double detJ = jacobianDet(p);
 2362:       assert(detJ > 0.0 && "Negative or zero determinant of the Jacobian in intGradPhiGradPhi");
 2363: 
 2364:       // Derivatives of the shape functions i1, i2 at the Gauss point p
 2365:       const double dPhi_dxi_1  = dPhi_dxi (i1, p);
 2366:       const double dPhi_deta_1 = dPhi_deta(i1, p);
 2367:       const double dPhi_dxi_2  = dPhi_dxi (i2, p);
 2368:       const double dPhi_deta_2 = dPhi_deta(i2, p);
 2369: 
 2370:       // Transform the derivatives of the shape functions to x,y coordinates (this formula leaves a multiplicative factor detJ)
 2371:       const double dPhi_dx_1_detJ =  dy_deta * dPhi_dxi_1 - dy_dxi * dPhi_deta_1;
 2372:       const double dPhi_dy_1_detJ = -dx_deta * dPhi_dxi_1 + dx_dxi * dPhi_deta_1;
 2373:       const double dPhi_dx_2_detJ =  dy_deta * dPhi_dxi_2 - dy_dxi * dPhi_deta_2;
 2374:       const double dPhi_dy_2_detJ = -dx_deta * dPhi_dxi_2 + dx_dxi * dPhi_deta_2;
 2375: 
 2376:       // Contribution to the integral from the Gauss point for grad(phi_i1).grad(phi_i2)
 2377:       res += (dPhi_dx_1_detJ*dPhi_dx_2_detJ + dPhi_dy_1_detJ*dPhi_dy_2_detJ)/detJ;
 2378:    }
 2379: 
 2380:    return res;
 2381: }
 2382: 
 2383: 
 2384: /**  Interpolate velocities at a given point (xt,yt,zt)
 2385: 
 2386:    @param xt, yt, zt: coordinates of the point to interpolate
 2387:    @param uuint: velocity interpolated at the final position (xt,yt,zt)
 2388: 
 2389:    This is done in four steps:
 2390: 
 2391:    1. Find the shape coordinates for the final position in the element.
 2392:    2. Interpolate the z level of the top and bottom levels at xt, yt. 
 2393:    3. Perform a binary search to find the vertical level containing zt. It will have to interpolate the 
 2394:       z levels at xt, yt at each step.   
 2395:    4. Interpolate the velocities at the final position (xt,yt,zt). This is done by interpolating the velocities
 2396:       horizontally and vertically.
 2397: **/
 2398: __device__ void Element::interpolateVelocities(Point3 xt, Vector3& u_int) const {
 2399:    // Interpolate the velocities at the point xt. 
 2400:    // This function works the same for triangular and quadrilateral elements.
 2401:    double shpCoord[4];
 2402: 
 2403:    // First step is to compute the shape coordinates of (xt,yt)
 2404:    computeShapeCoords(toVector2(xt), shpCoord, false);
 2405:    assert((min4(shpCoord[0], shpCoord[1], shpCoord[2], shpCoord[3]) >= -small) && "Invalid shape coordinates");
 2406: 
 2407:    // Second step is to find the level that contains zt
 2408:    // Uses a binary search to find the level
 2409:    // Note that z coordinates are interpolated from their values at the nodes of the element.
 2410:    int L = kb;   // I use L(eft) and R(ight) as usual, but here L is the bottom level and R is the top level
 2411:    int R = nvrt - 1;
 2412: 
 2413:    // Get the z coordinates at the nodes of the element at the levels L and R
 2414:    double zLAtNodes[4], zRAtNodes[4];
 2415:    getNodalValues(L, &Node::compZCoord, zLAtNodes);
 2416:    getNodalValues(R, &Node::compZCoord, zRAtNodes);
 2417: 
 2418:    double zL = interpolate(shpCoord, zLAtNodes);
 2419:    double zR = interpolate(shpCoord, zRAtNodes);
 2420:    
 2421:    // Interpolates vertically the velocities
 2422:    double wght1, wght2;
 2423:    if (xt.z<=zL) {
 2424:       wght1 = 1.0;
 2425:       wght2 = 0.0;
 2426:    }
 2427:    else if (xt.z>=zR) {
 2428:       wght1 = 0.0;
 2429:       wght2 = 1.0;
 2430:    }
 2431:    else {
 2432:       // Perform a binary search to find the levels between L and R that contain xt.z
 2433:       while (R - L > 1) {
 2434:          int M = (L + R) / 2;
 2435: 
 2436:          double zMAtNodes[4];
 2437:          getNodalValues(M, &Node::compZCoord, zMAtNodes);
 2438:          double zM = interpolate(shpCoord, zMAtNodes);
 2439:          if (zM < xt.z) 
 2440:          {
 2441:             L = M;
 2442:             zL = zM;
 2443:          }
 2444:          else 
 2445:          {
 2446:             R = M;
 2447:             zR = zM;
 2448:          }
 2449:       }
 2450:       assert(L == R-1);
 2451:       // At this point, L and R are the two levels that contain zt, and zL and zR are the z coordinates at the nodes of the element at these levels
 2452: 
 2453:       wght2 = (xt.z - zL)/(zR - zL);
 2454:       wght1 = 1.0 - wght2;
 2455:    }
 2456: 
 2457:    // Interpolate horizontally and vertically the velocities at the two levels L, R
 2458:    u_int = wght1*interpolate(L, shpCoord, &Node::uvw2) + wght2*interpolate(R, shpCoord, &Node::uvw2);
 2459: 
 2460:    // Neither of the interpolated velocities should be NaN
 2461:    assert(!isnan(u_int.x) && !isnan(u_int.y) && !isnan(u_int.z) && "NaN velocities in interpolateVelocities");
 2462: 
 2463: }
 2464: 
 2465: 
 2466: 
 2467: 
 2468: __inline__ __device__ double SideBoundary::getBoundaryArrayValueWeight(void) const {
 2469: 
 2470:    // For a side boundary, computes the weight w for which the value at node n1 is weighted by to
 2471:    // compute the value at the side center. The one for n2 is computed from 1 - w
 2472:    const Node *n1 = side->n1;
 2473:    const Node *n2 = side->n2;
 2474: 
 2475:    bool n1_match = (n1->nodeBnd->segment == segment);
 2476:    bool n2_match = (n2->nodeBnd->segment == segment);
 2477: 
 2478:    assert(n1_match || n2_match && "getBoundaryArrayValue: side with no segment boundary");
 2479:    if (n1_match && n2_match) {
 2480:       return 0.5;
 2481:    } else if (n1_match) {
 2482:       return 1.0;
 2483:    } else if (n2_match) {
 2484:       return 0.0;
 2485:    }
 2486:    return 0.0;
 2487: }
