 1228: struct Node {
 1229: 
 1230:    // Geometry information
 1231:    int idx;        // Index of the node
 1232:    Node **nodes;   // Array of pointers to the nodes that are neighbors of this node (there is no guarantee that they are connected)
 1233:    int numNodes;   // Number of nodes neighbors of this node
 1234: 
 1235:    Element **elements; // Array of pointers to the elements that share this node
 1236:    int numElements;    // Number of elements that share this node
 1237: 
 1238:    Side **sides;       // Array of pointers to the sides that are connected to this node.
 1239:    int numSides;       // Number of sides that are connected to this node
 1240: 
 1241: 
 1242:    // XXXXXX I want to keep sides and nodes as separate arrays, for the time being. I have already implemented function nodes2(idx), that should become nodes() eventually.
 1243: 
 1244:    Point2 p;
 1245:    Vector2 u2[nvrt];
 1246:    double  w2[nvrt];
 1247:    Vector2 utmp[nvrt];  // Temporary array to store velocities
 1248:    double z[nvrt];
 1249:    double lon, lat;
 1250:    double fun_lat[ntip + 1]; // XXXXX CHECK IF THIS MAKES SENSE. Also, the +1 is only to avoid erros when ntip ==1
 1251:    double depth;
 1252: 
 1253:    int kb;       // Bottom index of the node
 1254: 
 1255:    bool isDry;     // True if the node is dry
 1256: 
 1257:    int iadv;     // Advection flag
 1258: 
 1259:    NodeBoundary *nodeBnd; // Pointer to additional boundary information. For non-boundary nodes, 
 1260:                           // this is nullptr
 1261: 
 1262:    TempVar tmp; // Temporary variable to store different types of variables
 1263: 
 1264:    // Physical information
 1265:    Tracers tr0[nvrt];       // Initial tracer conc. at nodes
 1266:    Tracers tracers[nvrt];   // Tracer concentrations at nodes
 1267: 
 1268:    double rho[nvrt];     // Density
 1269:    double dfv[nvrt];     // Vertical viscosity
 1270: 
 1271:    double eta1; // Elevation at nodes at previous timestep
 1272:    double eta2; // Elevation at nodes at current timestep
 1273: 
 1274:    double ETP;  // Earth Tidal Potential
 1275: 
 1276:    double pr;    // Air pressure
 1277:    double grav2; // Gravity 
 1278:    
 1279:    Vector2 dav;  // Depth averaged velocity
 1280: 
 1281:    Vector2 tau; // Wind stress vector
 1282: 
 1283:    // Vegetation parameters
 1284:    double veg_h;
 1285:    double veg_nv;
 1286:    double veg_di;
 1287:    double veg_Cd;
 1288:    double veg_h_unbent;
 1289:    double veg_di_unbent;
 1290:    double veg_nv_unbent;
 1291:    double veg_alpha_vert_mean;
 1292:    double veg_alpha0;
 1293:    double veg_alpha3D[nvrt];
 1294: 
 1295:    // Bottom drag parameters
 1296:    double Cd;       // Bottom drag coefficient   
 1297: 
 1298:    // These three are mutually exclusive
 1299:    union {
 1300:       double rmanning; // Bottom Manning's coefficient
 1301:       double rough;    // Bottom roughness length
 1302:       double drag;     // Bottom drag coefficient
 1303:    };
 1304:    Vector2 tau_bot; // Bottom stress vector
 1305: 
 1306:    double bdef1; // Bottom deformation at previous timestep
 1307:    double bdef2; // Bottom deformation at current timestep
 1308: 
 1309:    double qel; // RHS
 1310:    double coeffDiag; // Diagonal coefficient of the matrix
 1311:    double *coeffMatrix; // Matrix coefficients for neighbors. [0..numNodes-1]
 1312: 
 1313:    double mP; // Search direction for conjugate gradient method
 1314:    double mR; // Residual for conjugate gradient method
 1315:    double mAp; // Product of matrix and search direction for conjugate gradient method
 1316:    double mX; // Solution for conjugate gradient method
 1317: 
 1318:    // Meteorological forcing
 1319:    Vector2 u_air;
 1320:    double p_air;
 1321:    double t_air;
 1322:    double q_air;
 1323:    double wind_angle;  // Wind rotation angle
 1324: 
 1325:    __device__ void setWind(Vector2 &u) {
 1326:    // Sets the wind vector taking into account the wind rotation angle
 1327:    
 1328:       const double dir = atan2(-u.x,-u.y);
 1329:       const double speed = length(u);
 1330: 
 1331:       // Calculate new u and v components with added rotation angle
 1332:       u_air = {-speed*sin(dir + wind_angle), -speed*cos(dir + wind_angle)};
 1333:    }
 1334: 
 1335: 
 1336:    __inline__ __device__ Node *nodes2(int index) const { index = index % numSides; const Side *side = sides[index]; return side->n1 == this ? side->n2 : side->n1; }
 1337: 
 1338:    __inline__ __device__ Point3 p3D(int k) const { return {p.x, p.y, z[k]}; }
 1339: 
 1340:    __device__ double sigmaTransitionDepth(void) const;
 1341: 
 1342:    __inline__ __device__ double Dz(int k) const { return z[k] - z[k-1]; }
 1343:    __inline__ __device__ double htot2(void) const { return eta2 + depth; }
 1344:    __inline__ __device__ double zTopCanopy(void) const { return z[kb] + veg_h; } 
 1345:    
 1346:    __inline__ __device__ Vector3 uvw2(int k) const { return {u2[k].x, u2[k].y, w2[k]}; }
 1347: 
 1348:    __inline__ __device__ bool isDry2(void) const { return htot2() <= h0; } // isDry, but updated to use eta2
 1349: 
 1350:    __inline__ __device__ bool isBnd(void) const { return nodeBnd != nullptr; } // True if the node is a boundary node
 1351:    // __inline__ __device__ int numElements(void) const { return isNbd() ? numElements - 1 : numElements; } // Number of elements that are connected to this node
 1352: 
 1353:    __device__ __forceinline__ void clearMatrixRow(void) {
 1354:       // Clear the matrix row for this node
 1355: 
 1356: 
 1357:       coeffDiag = 0.0;
 1358: 
 1359:       for (int i = 0; i < numNodes; i++) coeffMatrix[i] = 0.0;
 1360: 
 1361:    }
 1362: 
 1363:    __device__ void addToSparseMatrix(Node const *node, double value) {
 1364:    // Add the value to the sparse matrix for this node that corresponds to the file of node *this and the column of node *node
 1365:       
 1366:       if (node == this) {
 1367:          coeffDiag += value;
 1368:      
 1369:       } else {
 1370:          // Search (linearly)the index of the node in the array of nodes
 1371:          // XXX: This is not efficient, see if we can improve this
 1372:          int i;
 1373:          for (i = 0; i < numNodes; i++) {
 1374:             if (nodes[i] == node) {
 1375:                break;
 1376:             }
 1377:          }
 1378:          assert(i < numNodes && "addToSparseMatrix: node not found in array of nodes");
 1379:          coeffMatrix[i] += value;
 1380:       }
 1381:    }
 1382: 
 1383: 
 1384:    __device__ __inline__ void updateZCoordData(void);
 1385: 
 1386:    __device__ double compZCoord(int k) const;
 1387: 
 1388:    __device__ void updateKb(void);
 1389: 
 1390:    __device__ __forceinline__ void computeBottomDragCd(void);
 1391: 
 1392: 
 1393: 
 1394: };
