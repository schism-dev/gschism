 2351: 
 2352: __inline__ __device__ double  Side::Cd(void)      const { if constexpr(nchi != 0) return 0.5*(n1->Cd + n2->Cd); else return 0.0; }
 2353: 
 2354: __inline__ __device__ Vector2 Side::tau(void)    const { return 0.5*(n1->tau + n2->tau); }
 2355: 
 2356: /**
 2357:  * This method performs backtracking from the side center until a time -dt back in time 
 2358:  * from the current time. The backtracking is performed using the velocities (u,v,w) at each
 2359:  * intermediate point.
 2360:  *
 2361:  * We approximate the backtracking curve as a piecewise linear curve. Each segment has
 2362:  * a length dtb*vel_step, where vel_step is the module of the velocity at that step and dtb is 
 2363:  * the timestep (of the backtracking). dtb is computed as the minimum of dtbk and the 
 2364:  * remaining time.
 2365:  * 
 2366:  * NOTE: Runge-Kutta is not implemented yet. XXX
 2367:  * 
 2368:  * @param uuint, vvint, wwint: Velocities at the final point
 2369:  * @param jlev: Level at which the backtracking is performed
 2370:  * @param dt, dtbk: Tracking timesteps
 2371:  * @return: True if the backtracking was successful, false otherwise
 2372:  */
 2373: __inline__ __device__ bool Side::btrack(
 2374:       int jlev,
 2375:       double dt,            // Tracking time
 2376:       double dtbk,          // Tracking timestep
 2377:       Vector3 &u_int        // Velocities at the initial point
 2378: ) const {
 2379: 
 2380:    // Start from side center
 2381:    Point3 x0 = {center.x, center.y, zc[jlev]};
 2382:  
 2383: 
 2384:    double time_rm = dt; // Remaining time
 2385: 
 2386: 
 2387:    // // Initialize outputs XXX
 2388:    // for(int i = 0; i < 4 + N_TRACERS; i++) {
 2389:    //    sclr[i] = 0.0;
 2390:    // }
 2391: 
 2392: 
 2393:    // Initial velocities
 2394:    u_int = {u2[jlev].x, u2[jlev].y, 0.5*(n1->u2[jlev].z + n2->u2[jlev].z)};
 2395: 
 2396:    // Find the element that is in the direction opposite to the velocity
 2397:    Element* curElem = findElementTowards(toVector2(u_int));
 2398: 
 2399:    // If it starts at a boundary side, we must start with a velocity parallel to the side.
 2400:    if (curElem == nullptr) {
 2401:       // Make velocity parallel to the side
 2402:       const Vector2 u2parallel = dot(toVector2(u_int), t())*t();
 2403:       u_int = {u2parallel.x, u2parallel.y, u_int.z};
 2404:       curElem = otherElem(curElem);
 2405:       
 2406:    }
 2407: 
 2408: 
 2409: 
 2410:    const int MAX_ITERATIONS = 1000; 
 2411:    Element* nextElem = curElem;
 2412:    int iter = 0;
 2413:    while(true) {
 2414: 
 2415:       // Calculate timestep
 2416:       double dtb = min(dtbk, time_rm);
 2417: 
 2418:       // Next point in the backtracking curve
 2419:       Point3 xt = x0 - dtb*u_int;
 2420: 
 2421:       bool found = curElem->trackThroughElementsAndLevels(x0, xt, u_int, nextElem, jlev, dtb, this);
 2422:       assert(found && "Backtracking failed in btrack");
 2423: 
 2424:       time_rm -= dtb; // if trackThroughElementsAndLevels terminates early (if it intersects a boundary or a dry element),
 2425:                       // then time_rm needs to be increased by the unused time.
 2426:       if (time_rm == 0.0) break; // from the definition of dtb, time_rm will reach exactly 0.0
 2427: 
 2428: 
 2429:       // If the velocity is too small, we stop the backtracking
 2430:       const double vmag = length(toVector2(u_int));
 2431:       if (vmag <= velmin_btrack) break;
 2432: 
 2433:       // The current point becomes the next segment's starting point.
 2434:       x0 = xt;
 2435:  
 2436:       curElem = nextElem;
 2437: 
 2438:       iter++;
 2439:       assert(iter < MAX_ITERATIONS && "Max iterations reached in btrack");
 2440:    }
 2441: 
 2442: 
 2443: }
 2444: 
 2445: 
 2446: 
 2447: // /**
 2448: //    For a point (x1,y1) inside the element and a line segment (x1,y1)-(x2,y2), find the intersection point 
 2449: //    (xIntersect,yIntersect) and the side (intersectingSide) that it intersects.
 2450: 
 2451: //    Inputs:
 2452: //    @param x1, y1: point inside the element
 2453: //    @param x2, y2: other end of the line segment
 2454: 
 2455: //    Outputs:
 2456: //    @param intersectingSide:  side that intersects the line segment
 2457: //    @param nextElement: element that contains the intersection point
 2458: //    @param xIntersect, yIntersect: intersection point  
 2459: 
 2460: //    The equations for the two segments (the one we are considering and one of the sides of the element) are:
 2461: //    P1(tt1) = (x1,y1) + tt1*(x2-x1, y2-y1)  where 0 <= tt1 <= 1
 2462: //    P2(tt2) = (x3,y3) + tt2*(x4-x3, y4-y3)  where 0 <= tt2 <= 1
