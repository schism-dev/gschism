 9093: __global__ void returnMatrix(double *res) {
 9094:    // Debugging: dense local matrix, row-major, size = mesh->np
 9095:    // Assumes single-partition / local indexing (see note below).
 9096: 
 9097:    const int size = mesh->np;
 9098: 
 9099:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9100:       const Node *node = mesh->localNodeData + idx_node;
 9101: 
 9102:       res[idx_node * size + idx_node] = *(node->coeffDiag);
 9103: 
 9104:       for (int j = 0; j < node->numNodes; j++) {
 9105:          const Node *nbNode = node->nodes[j];
 9106:          // Only dump neighbors that live on this partition
 9107:          if (nbNode->part != mesh->partNum) continue;
 9108: 
 9109:          const int jlocal = (int)(nbNode - mesh->nodes[nbNode->part]);
 9110:          const double aij = node->coeffRow[node->csrSlot[j]];
 9111:          if (aij != 0.0)
 9112:             res[jlocal * size + idx_node] = aij;
 9113:       }
 9114:    }
 9115: }
 9116: 
 9117: 
 9118: __global__ void returnX(double *res) {
 9119:    // Debugging: returns the matrix as a CuPy array
 9120: 
 9121:    const int size = mesh->np;
 9122:    for (int idx_node = 0; idx_node < size; idx_node++) {
 9123:       const Node *node = mesh->localNodeData + idx_node;
 9124: 
 9125:       res[idx_node] = node->mX;
 9126: 
 9127:    }
 9128:    
 9129: }
