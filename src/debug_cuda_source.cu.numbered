 6114:    __global__ void resetVelocityOpenBndNodes(void) {
 6115:    // Set velocity to zero for open boundary nodes where the velocity is imposed.
 6116: 
 6117:       NODE_BND(nodebnd);
 6118: 
 6119:       if (nodebnd->segment != nullptr && nodebnd->segment->ifltype != 0) {
 6120:          for (int k = 0; k < nvrt; k++) { nodebnd->node->u2[k] = {0.0, 0.0}; nodebnd->node->w2[k] = 0.0; }
 6121:       }
 6122: 
 6123:    }
 6124: 
 6125: 
 6126:    __global__ void setVelocityOpenBndNodes(void) {
 6127:    // For open boundary nodes sets their velocity to the imposed values.
 6128: 
 6129:       SIDE_BND(sidebnd);
 6130: 
 6131:       if (sidebnd->segment != nullptr && sidebnd->segment->ifltype != 0) {
 6132:          // If the sidebnd is an open boundary, set the velocity of the nodes that belong
 6133:          // to its segment to the average of the side velocity.
 6134: 
 6135:          for (int k = 0; k < nvrt; k++) {
 6136:             Node *n1 = sidebnd->side->n1;
 6137:             Node *n2 = sidebnd->side->n2;
 6138: 
 6139: 
 6140:             Vector2 n1_u2(n1->u2[k]);
 6141:             Vector2 n2_u2(n2->u2[k]);
 6142: 
 6143:             if (n1->nodeBnd->segment == sidebnd->segment) {
 6144:                atomicAdd(&(n1_u2.x), sidebnd->side->u2[k].x/n1->nodeBnd->numSidesForAverage());
 6145:                atomicAdd(&(n1_u2.y), sidebnd->side->u2[k].y/n1->nodeBnd->numSidesForAverage());
 6146:             }
 6147:             if (n2->nodeBnd->segment == sidebnd->segment) {
 6148:                atomicAdd(&(n2_u2.x), sidebnd->side->u2[k].x/n2->nodeBnd->numSidesForAverage());
 6149:                atomicAdd(&(n2_u2.y), sidebnd->side->u2[k].y/n2->nodeBnd->numSidesForAverage());
 6150:             }
 6151: 
 6152:          }
 6153: 
 6154:       }
 6155: 
 6156:    }
