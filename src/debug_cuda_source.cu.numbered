 2398: __device__ void addDebugPlot(Vector3 x1, Vector3 x2, unsigned int color = 0xFF0000, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2399: // return;   
 2400:    // Lock the mutex
 2401:    lock(&debugPlotMutex);
 2402:  
 2403:    bool ok = true;
 2404:    if (debugPlotIdx == nullptr) ok = false;
 2405:    if (*debugPlotIdx >= 1000000) ok = false;
 2406:    if (ok) {
 2407:       debugPlot[(*debugPlotIdx) + 0*1000000] = x1.x;
 2408:       debugPlot[(*debugPlotIdx) + 1*1000000] = x1.y;
 2409:       debugPlot[(*debugPlotIdx) + 2*1000000] = x2.x;
 2410:       debugPlot[(*debugPlotIdx) + 3*1000000] = x2.y;
 2411:       debugPlot[(*debugPlotIdx) + 4*1000000] = (double)color;
 2412:       debugPlot[(*debugPlotIdx) + 5*1000000] = (double)(((int)(unsigned char)marker & 0xFF) | ((dashLen & 0xFF) << 8) | ((width & 0xFF) << 16));
 2413:       debugPlot[(*debugPlotIdx) + 6*1000000] = (double)label;
 2414:       (*debugPlotIdx)++;
 2415:    }
 2416: 
 2417:    __threadfence();               // ensure all above writes are visible
 2418:    // Unlock the mutex
 2419:    unlock(&debugPlotMutex);
 2420: 
 2421: }
 2422: 
 2423: __device__ void addDebugPlot(Vector2 x1, Vector2 x2, unsigned int color = 0xA0A0A0, char marker = 'o', int width = 1, int dashLen = 0, int label = -1) {
 2424:    addDebugPlot(toPoint3(x1, 0.0), toPoint3(x2, 0.0), color, marker, width, dashLen, label);
 2425: }
