 2327: 
 2328: __inline__ __device__ double  Side::x(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.x + t*n2->p.x; }
 2329: __inline__ __device__ double  Side::y(double t)   const { assert(t >= 0.0 && t <= 1.0); return (1-t)*n1->p.y + t*n2->p.y; }
 2330: __inline__ __device__ double  Side::lon(void) const { return 0.5*(n1->lon + n2->lon); }
 2331: __inline__ __device__ double  Side::lat(void) const { return 0.5*(n1->lat + n2->lat); }
 2332: __inline__ __device__ Point2  Side::p_t(double t) const { return {x(t), y(t)}; }
 2333: __inline__ __device__ Vector2 Side::grad2(double Node::* field, bool (*condition)(const Element*)) const {
 2334:    Vector2 grad = {0.0, 0.0};
 2335:    int count = 0;
 2336: 
 2337:    if constexpr(ics == 2) assert(false && "grad2: ics = 2 not implemented");
 2338: 
 2339:    // First element
 2340:    if (elems[0] != nullptr && condition(elems[0])) {
 2341:       grad += elems[0]->grad2(field);
 2342:       count++;
 2343:    }
 2344: 
 2345:    // Second element
 2346:    if (elems[1] != nullptr && condition(elems[1])) {
 2347:       grad += elems[1]->grad2(field);
 2348:       count++;
 2349:    }
 2350: 
 2351:    if (count > 0) {
 2352:       grad = grad/count;
 2353:    }
 2354:    
 2355:    return grad;
 2356: }
 2357: 
 2358: __inline__ __device__ double  Side::grav3(void)   const { return 0.5*(n1->grav2 + n2->grav2); }
 2359: __inline__ __device__ int     Side::iadv(void)    const { return min(n1->iadv, n2->iadv); }   
 2360: __inline__ __device__ double  Side::eta2(void)    const { return 0.5*(n1->eta2 + n2->eta2); }
 2361: __inline__ __device__ double  Side::eta1(void)    const { return 0.5*(n1->eta1 + n2->eta1); }
 2362: __inline__ __device__ double  Side::depth(void)   const { return 0.5*(n1->depth + n2->depth); } 
 2363: __inline__ __device__ double  Side::dfv(int k)    const { return 0.5*(n1->dfv[k] + n2->dfv[k]); }
 2364: 
 2365: __inline__ __device__ double  Side::veg_h(void)   const { return 0.5*(n1->veg_h  + n2->veg_h); }
 2366: __inline__ __device__ double  Side::veg_nv(void)  const { return 0.5*(n1->veg_nv + n2->veg_nv); }
 2367: __inline__ __device__ double  Side::veg_alpha_vert_mean(void) const { return 0.5*(n1->veg_alpha_vert_mean + n2->veg_alpha_vert_mean); }
 2368: __inline__ __device__ double  Side::veg_alpha3D(int k) const { return 0.5*(n1->veg_alpha3D[k] + n2->veg_alpha3D[k]); }
