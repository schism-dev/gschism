 2372: 
 2373: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2374:    if constexpr(ics == 1)  {
 2375:       return center;
 2376: 
 2377:    } else {
 2378:       const Point2 p0 = nodes[0]->outputCoords();
 2379:       const Point2 p1 = nodes[1]->outputCoords();
 2380:       const Point2 p2 = nodes[2]->outputCoords();
 2381: 
 2382:       if (isTri()) {
 2383:          return (1.0/3.0)*(p0 + p1 + p2);
 2384: 
 2385:       } else {
 2386:          const Point2 p3 = nodes[3]->outputCoords();
 2387:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2388:       }
 2389: 
 2390:    }
 2391: }
 2392: 
 2393: 
 2394: __device__ __forceinline__ double Element::centerZ(void) const { 
 2395: // Z coordinate of the element center in the global cartesian coordinates.
 2396: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2397: 
 2398:    if constexpr(ics==1) { 
 2399:       return 0.0; 
 2400: 
 2401:    } else { 
 2402: 
 2403:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2404:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2405:    } 
 2406: }
