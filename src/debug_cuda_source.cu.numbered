 7246: // !===============================================================================
 7247: 
 7248: } // extern "C"
 7249: 
 7250: #ifdef DONTCOMPILE
 7251: __device__ void computeVerticalAdvection(void) {
 7252:    // Compute the vertical advection term d(uw)/dz and d(vw)/dz, using cubic splines.
 7253: 
 7254:    sdbt(1:2,:,:)=0.d0
 7255: 
 7256:    const Side *side = FROM kernel;
 7257: 
 7258:    if(side->isDry) return;
 7259: 
 7260:    // If side is wet...
 7261: 
 7262: 
 7263:    // Computes the vertical velocity at the side using the average of the velocities at the element centers
 7264:    // XXX WHY DOES IT USE THIS METHOD? IN OTHER PLACES, IT INTERPOLATES FROM W AT THE NODES
 7265:    double ws[nvrt] = {} // w @ side
 7266:    int icount = 0;
 7267:    for (int j=0; j<2; j++) {
 7268:       const Element *elem = side->elements[j];
 7269:        
 7270:       if(elem != nullptr) {
 7271:          icount++;
 7272:          for (int k=0; k<nvrt; k++) {
 7273:             ws[k] = ws[k] + elem->w[k];
 7274:          }
 7275:       }
 7276:    }  // for j
 7277: 
 7278:    assert(icount > 0 && "STEP: Wet side has no wet elements");
 7279:    ws = ws/icount;
 7280: 
 7281:    // Computes the vertical advection term d(uw)/dz, using cubic splines.
 7282:    // Splines allow for a smooth transition between vertical levels.
 7283:    // Splines have continuity restrictions at the internal knots, but
 7284:    // we have to provide the 1st derivatives at the endpoints.
 7285:    const int kbs = side->kbs; 
 7286:    
 7287:    double top_duw_dz = (ws[nvrt - 1]*side->u2[nvrt] - ws[nvrt - 1]*side->u2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7288:    double bot_duw_dz = (ws[kbs     ]*side->u2[kbs ] - ws[kbs     ]*side->u2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7289:    initCubicSpline(kbs, nvrt, side, ws, up)
 7290: 
 7291:    double top_dvw_dz = (ws[nvrt - 1]*side->v2[nvrt] - ws[nvrt - 1]*side->v2[nvrt - 1])/(side->z[nvrt - 1] - side->z[nvrt - 2])
 7292:    double bot_dvw_dz = (ws[kbs     ]*side->v2[kbs ] - ws[kbs     ]*side->v2[kbs  - 1])/(side->z[kbs ] - side->z[kbs  - 1])
 7293:    initCubicSpline(kbs, nvrt, side, ws, vp)
 7294: 
 7295:    // Total advection (average onto side)
 7296:    const Node *node1 = side->nodes[0];
 7297:    const Node *node2 = side->nodes[1];
 7298:    for (int k=kbs(i); k<nvrt; k++) {
 7299: 
 7300:       Vector2 bcc1 = node1->bcc[k];
 7301:       Vector2 bcc2 = node2->bcc[k];
 7302:       if constexpr(ics == 2) {
 7303:          // Project the velocities from the node frames to the side frame
 7304:          bcc1 = node1->frame.projHorVec(bcc1, side->frame);
 7305:          bcc2 = node2->frame.projHorVec(bcc2, side->frame);
 7306:       }
 7307: 
 7308:       sdbt(1,k,i) = side->u2[k] - dt*(bcc1.x + bcc2.x)/2.d0 - dt*side->u2p[k]
 7309:       sdbt(2,k,i) = side->v2[k] - dt*(bcc1.y + bcc2.y)/2.d0 - dt*side->v2p[k]
 7310: 
 7311:    }
 7312: }
 7313: #endif
 7314: 
 7315: 
 7316: extern "C" {
 7317:    __global__ void computeElemAverageGhat(void) {
 7318:       // Element average ghat1 (in eframe if ics=2; \breve{G} in notes). Dimensions: m^2/s.
 7319: 
 7320:       ELEM(elem);
 7321:       
 7322:       elem->ghat1= {0.0, 0.0};  
 7323: 
 7324:       if constexpr(ihydraulics != 0) {
 7325:          if (nhtblocks > 0 && elem->isblock) return;
 7326:       }
 7327: 
 7328:       
 7329:       // ghat1=elem average of \breve{G} includes: Coriolis, atmospheric pressure, tidal potential, horizontal diffusion, and baroclinic etc
 7330:       // cff1-3: coefficients for 2D/3D
 7331: 
 7332:       elem->gradEta = {0.0, 0.0};  // \nabla \eta
 7333:       elem->gradPr  = {0.0, 0.0};  // \nabla pressure
 7334:       elem->gradETP = {0.0, 0.0};  // \nabla Earth Tidal Potential
 7335: 
 7336:       if (elem->isDry) return;
 7337: 
 7338:       // Average of the coefficients
 7339:       double av_cff1 = 0.0;  // av. for cff1
 7340:       double av_cff2 = 0.0;  // av. for cff2
 7341:       double av_cff3 = 0.0;  // av. for cff3
 7342:       double av_df = 0.0;  // av. for H^\alpha / H
 7343:       double av_cff2_chi = 0.0;  // av. for cff2*chi
 7344:       double av_cff3_chi = 0.0;  // av. for cff3*chi
 7345: 
 7346:       const int i34 = elem->i34;
 7347:       const int kb  = elem->kb;
 7348: 
 7349:       for (int j=0; j<i34; j++) {
 7350:          // For each node and side in the element...
 7351: 
 7352:          const Node *node = elem->nodes[j];
 7353:          const Side *side = elem->sides[j];
 7354: 
 7355:          const double chi      = side->chi;
 7356:          const double veg_c2   = side->veg_c2;
 7357:          const double veg_beta = side->veg_beta;
 7358:          const double veg_h    = side->veg_h();
 7359:          const double veg_c    = veg_c2/(1.0 + veg_c2);  // veg_c2 = \alpha*|u|*dt
 7360: 
 7361:          const Vector2 gradPhi = elem->gradPhi[j];
 7362: 
 7363:          // Node - const in elem
 7364:          elem->gradEta += node->eta2*gradPhi;  // gradPhi is always in the element frame
 7365:          elem->gradPr  += node->pr  *gradPhi;
 7366: 
 7367:          if (elem->depth >= tip_dp) elem->gradETP += node->ETP*gradPhi;
 7368: 
 7369:         
 7370:          const double htot  = side->htot2();        // Total depth at the side
 7371:          const double zctr2 = side->zTopCanopy();  
 7372: 
 7373:          double cff1; 
 7374:          double cff2; 
 7375:          double cff3;   
 7376:          if (side->is2D()) {  // XXX Check indices, it used to have a +1
 7377:          // coefficients applied to 2D/3D case 
 7378:             cff1 = side->hhat/htot;
 7379:             cff2 = 0.0;
 7380:             cff3 = 0.0;
 7381:          } else { //3D
 7382:             //Init for no-veg case
 7383:             cff1 = 1.0;
 7384:             cff2 = 1.0;
 7385:             cff3 = 0.0;
 7386: 
 7387:             if constexpr(iveg != 0) {
 7388:                // Computes coefficients used with vegetation terms G1, G2
 7389:                // cff1, cff3 are used for the first two terms in G1, G2:
 7390:                // Emergent vegetation:   G1 = Ustar/(\alpha*|u|*dt)
 7391:                // Submergent vegetation: G2 = Ustar - c*Ustar_alpha + ..., with c = \alpha*|u|*dt/(1+\alpha*|u|*dt)
 7392:                // In general, cff1*Ustar - cff3*Ustar_alpha
 7393:                if(veg_h < 0.99*htot) { // submergent vegetation
 7394:                   cff1 = 1.0;
 7395:                   cff2 = 1.0 + veg_beta*veg_c;          // Term (1 + beta*c) in G2.
 7396:                   cff3 = veg_c;
 7397: 
 7398:                } else { // emergent vegetation
 7399:                   cff1 = 1.0/(1.0 + veg_c2);
 7400:                   cff2 = cff1;
 7401:                   cff3 = 0.0;
 7402: 
 7403:                }
 7404:             } // if iveg
 7405:          } //  2D/3D
 7406: 
 7407:          av_cff1 += cff1/i34;
 7408:          av_cff2 += cff2/i34;
 7409:          av_cff3 += cff3/i34;
 7410:          av_cff2_chi += cff2*chi/i34;
 7411:          av_cff3_chi += cff3*chi/i34;
 7412:          av_df += min(htot, veg_h)/(htot*i34);
 7413: 
 7414: 
 7415:          // btrack values: U^\star, U^{\star\alpha}
 7416:          // Computes the backtracked velocity integrated vertically (full depth and to the top of the canopy)
 7417:          Vector2 Ustar       = {0.0, 0.0}; 
 7418:          Vector2 Ustar_alpha = {0.0, 0.0}; 
 7419: 
 7420:          if (side->is2D()) {  //2D; no need to compute U^{\star\alpha}
 7421:                Ustar += side->btu[nvrt - 1]*side->Dz(nvrt - 1);
 7422:          } else { //3D
 7423:             for (int k = side->kb + 1; k < nvrt; k++) {
 7424:             
 7425:                Vector2 w2 = (side->btu[k] + side->btu[k-1])/2.0*side->Dz(k);
 7426:                Ustar += w2;
 7427: 
 7428:                if constexpr(iveg != 0) {
 7429:                    if (zctr2 > side->zc[k-1]) {  // XXX CHECK INDICES!!! 
 7430:                        const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0); // For the top of the canopy, ratio of the level that is below the canopy
 7431:                        Ustar_alpha += zrat*w2; // XXXX
 7432:                    }
 7433:                }  // if iveg
 7434:             }  // for k
 7435:          }  //2D/3D
 7436: 
 7437:          // If needed, project the side velocities to the element frame
 7438:          if constexpr(ics==2) {
 7439:             Ustar       = side->frame.projHorVec(Ustar,       elem->frame);
 7440:             Ustar_alpha = side->frame.projHorVec(Ustar_alpha, elem->frame);
 7441:          }
 7442:         
 7443: 
 7444:          // Add btrack & surface stress terms to \breve{G} first
 7445:          elem->ghat1 += cff1*Ustar - cff3*Ustar_alpha;
 7446: 
 7447: 
 7448:          // Both tau and ubstar are in the side frame (for both ics==1 and ics==2)
 7449:          Vector2 tau    = side->tau();  
 7450:          Vector2 ubstar = side->btu[side->kb + 1];  
 7451: 
 7452:          // If needed, project tau and ubstar to the element frame
 7453:          if constexpr(ics==2) {
 7454:             tau    = side->frame.projHorVec(tau,    elem->frame);  // Here we are doing two projections: from the node frame to the side frame, and from the side frame to the element frame. This is different from the original code where they only did one projection.
 7455:             ubstar = side->frame.projHorVec(ubstar, elem->frame);
 7456:          }
 7457: 
 7458:          // Term for surface and bottom stress
 7459:          elem->ghat1 -= chi*dt*cff2*ubstar + dt*cff1*tau;
 7460: 
 7461: 
 7462:          // All terms in F,F^\alpha,f_b except baroclinic
 7463:          // F, f_b: all explicit terms excluding vegetation 
 7464:          // F^\alpha=\int_{-h}^z_v f dz (f ncludes all explicit terms except for vegetation)
 7465:          // Only need to calculate F^\alpha for 3D sides (but init=0) 
 7466:          const double coriolis = side->coriolis;
 7467:          Vector2 F  =  coriolis*side->U;  // F_x
 7468:          Vector2 fb =  coriolis*side->u2[side->kb + 1];  // f_b_x
 7469:          Vector2 Fa = {0.0, 0.0};  // F^\alpha, vertically forcing terms baroclinic gradient, horizontal viscosity, Coriolis, earth tidal potential, atmospheric pressure, radiation stress)
 7470: 
 7471:          if (iveg != 0 && nvrt > side->kb) {  // 3D
 7472:             
 7473:             for (int k = side->kb; k < nvrt; k++) {
 7474:                if (zctr2 > side->zc[k-1]) {
 7475:                    const Vector2 w2 = side->Dz(k)*(side->u2[k] + side->u2[k-1])/2.0;
 7476:                    const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7477:                    Fa +=  coriolis*w2*zrat;
 7478:                } // if zctr2
 7479:             } // k
 7480:          } // iveg
 7481: 
 7482:          // Integrate horizontal viscosity force vertically
 7483:          for (int k=side->kb + 1; k<nvrt; k++) {
 7484:             const Vector2 levelHorVisc = side->Dz(k)*(side->nuGradU[k] + side->nuGradU[k-1])/2.0; 
 7485: 
 7486:             F += levelHorVisc;
 7487: 
 7488:             // Vegetation term
 7489:             if constexpr(iveg!=0) {
 7490:                if (nvrt > side->kb + 1 && zctr2 > side->zc[k-1]) { // 3D
 7491:                   const double zrat = clamp((zctr2 - side->zc[k-1])/side->Dz(k), 0.0, 1.0);
 7492:                   Fa += levelHorVisc*zrat;
 7493:                } 
 7494:             } // if iveg
 7495:          } // for k
 7496: 
 7497:          // Get nu*grad(U) at the side's bottom level
 7498:          Vector2 nuGradU = side->nuGradU[side->kb];
 7499: 
 7500:          fb += nuGradU;
 7501: 
 7502:          // If needed, project vectorsF, fb and Fa to the element frame
 7503:          if constexpr(ics==2) {
 7504:             F    = side->frame.projHorVec(F,    elem->frame);
 7505:             fb   = side->frame.projHorVec(fb,   elem->frame);
 7506:             Fa   = side->frame.projHorVec(Fa,   elem->frame);
 7507:          } // if ics
 7508: 
 7509:          elem->ghat1 += cff1*dt*F - cff2*chi*dt*dt*fb - cff3*dt*Fa;
 7510:       } // for j (nodes and sides)
 7511: 
 7512:       elem->ghat1 = (1.0/i34)*elem->ghat1;
 7513: 
 7514: 
 7515:       // Finish off terms in F, F^\alpha and f_b
 7516:       const double grav3 = elem->mean(&Node::grav2);
 7517:       const Vector2 fb = grav3*elem->gradETP - elem->gradPr/rho0; //const in each elem
 7518:       Vector2 tmp = {0.0, 0.0}; //elem average of all terms; into ghat1
 7519:       for (int j=0; j<i34; j++) { 
 7520:          // For each side in the element...
 7521:          const Side *side = elem->sides[j];
 7522:          const double chi = side->chi;
 7523: 
 7524:          const double htot = side->htot2();
 7525:          const double veg_h = side->veg_h();
 7526:          const Vector2 F  = htot*fb;
 7527:          const Vector2 Fa = min(htot, veg_h)*fb;
 7528: 
 7529:          tmp += dt*(av_cff1*F - av_cff2*chi*dt*fb - av_cff3*Fa);
 7530:       } // for j
 7531: 
 7532:       // tmp is already in elem frame
 7533:       elem->ghat1 += tmp/i34;
 7534: 
 7535:       // Baroclinic force
 7536:       if constexpr(ibc==0) {
 7537:          assert(elem->nodes[0]->rho[0] >= -98.0 && elem->nodes[1]->rho[0] >= -98.0 && elem->nodes[2]->rho[0] >= -98.0 && "computeElemAverageGhat1: Impossible dry");
 7538: 
 7539:          Vector2 Fa = {0.0, 0.0};
 7540:          Vector2 intGradRho = {0.0, 0.0};
 7541:          
 7542:          // Computes \sum_{l=k}^N dr*dz for the k level at trhe element frame
 7543:          for (int k=nvrt-2; k >= kb + 1; k--) { /// XXXX CHECK INDICES
 7544:             intGradRho += elem->gradRho[k+1]*elem->Dz(k+1); 
 7545: 
 7546:             // \in F [m^2/s/s]
 7547:             Fa -= grav3/rho0*elem->Dz(k)*(2.0*intGradRho + elem->gradRho[k]*elem->Dz(k));
 7548:          }
 7549: 
 7550:          const Vector2 fb = -grav3/rho0*intGradRho; //[m/s/s]; elem average
 7551:          const Vector2 F = av_df*Fa; //approx
 7552:          elem->ghat1 += rampbc*dt*(av_cff1*F - dt*av_cff2_chi*fb - av_cff3*Fa);
 7553: 
 7554:       } // if ibc
 7555: 
 7556: 
 7557: 
 7558:    }
 7559: 
 7560: } // extern "C"
 7561: 
 7562: 
 7563: 
 7564: #ifdef DONTCOMPILE
 7565: __global__ void checkMassConservation(Tracers* sumtr) {
 7566: 
 7567:    int i = blockIdx.x * blockDim.x + threadIdx.x;
 7568: 
 7569:    if (i >= mesh->ne) return;  // Guard against out-of-bounds access
 7570: 
 7571:    Element *elem = &(mesh->localElemData[i]);
 7572: 
 7573:    // Skip dry elements
 7574:    if (elem->isDry) return;
 7575: 
 7576:    // Local sum array for this thread
 7577:    double localSum[N_TRACERS] = {0.0};
 7578: 
 7579:    // Sum over vertical levels for this element
 7580:    const int kbe = elem->kbe;
 7581:    const double area = elem->area;
 7582: 
 7583:    for (int k = kbe; k < nvrt; k++) {
 7584:       const double vol = (elem->z[k] - elem->z[k-1]) * area;
 7585:       
 7586:       // Accumulate tracer mass
 7587:       for (int tr = 0; tr < N_TRACERS; tr++) {
 7588:          sumtr[i].tracer[tr] += vol * elem->tracers[k].tracer[tr];
 7589:       }
 7590:    }
 7591: 
 7592:    //  This function returns per element sums. A reduction must be done on the host side.
 7593: }
 7594: 
 7595: 
 7596: __global__ void transport(void) {
 7597: 
 7598:    int ie = blockIdx.x * blockDim.x + threadIdx.x;
 7599: 
 7600:    if (ie >= mesh->ne) return;  // Guard against out-of-bounds access
 7601: 
 7602:    Element *elem = &(mesh->localElemData[ie]);
 7603: 
 7604:    if (ip_weno==2 && nweno2(ie)>0 && isten_qual2(ie) && isbe(ie)==0)  // p2 weno method
 7605: 
 7606:                for (int m=0; m<ntr; m++) {
 7607:                   for (int k=kbe(ie); k<nvrt; k++) {
 7608:                      // Calculate each polynomial's weight 
 7609:                      wm=0.d0; sum1=0.d0; 
 7610:                      wm1=0.d0; wm2=0.d0; 
 7611:                      for (int i=0; i<elem->nweno2; i++) {
 7612:                   
 7613:                      const double b1 = dot_product(elem->wts2(:,1,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7614:                      const double b2 = dot_product(elem->wts2(:,2,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7615:                      const double b3 = dot_product(elem->wts2(:,3,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7616:                      const double b4 = dot_product(elem->wts2(:,4,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7617:                      const double b5 = dot_product(elem->wts2(:,5,i),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7618:                      b1 = b1*b1+b2*b2+(4.d0*b1*b3+2*b2*b4)*fwts2(1,ie)+(4.d0*b2*b5+2*b1*b4)*fwts2(2,ie)
 7619:                      b2 = (4.d0*b3*b3+b4*b4)*fwts2(3,ie)+4.d0*b4*(b3+b5)*fwts2(4,ie)+(4.d0*b5*b5+b4*b4)*fwts2(5,ie)
 7620:                      b3 = (4.d0*b3*b3+b4*b4+4.d0*b5*b5)*area(ie)
 7621:                      // -----------------Hu and Shu (1999)'s method----------------
 7622:                      b4=b1+b2+b3
 7623: 
 7624: //Error: add PRODUCTION CPP
 7625: #ifdef DEBUG
 7626:                   if(b4<0.d0 && abs(b4)>1.0d-50) {
 7627:                     write(errmsg,*)'b4<0',b1,b2,b3,b4
 7628:                     call parallel_abort(errmsg)
 7629:                   }
 7630: #endif
 7631: 
 7632:                   wm(i) = 1.0d0/((elem->epsilon2+b4)*(elem->epsilon2+b4))
 7633:                   // !----test-------------- 
 7634:                   // !wm1(i)=1.0/((epsilon2_elem(ie)+b1+b2)*(epsilon2_elem(ie)+b1+b2)); ! sum1=sum1+wm1(i)
 7635:                   // !wm2(i)=1.0/((epsilon3+b3)*(epsilon3+b3)); 
 7636:                   // !wm(i)=wm1(i)*wm2(i)
 7637:                   // !---------------------- 
 7638:                   sum1=sum1+wm(i)
 7639:                 } // end for i
 7640: 
 7641:                 wm=wm/sum1
 7642: 
 7643:                 for (int j=0; j<elem->i34; j++) {
 7644: 
 7645:                   const Side *side  = elem->sides[j];
 7646:                   const Node *node1 = side->n1;
 7647:                   const Node *node2 = side->n2;
 7648: 
 7649:                   if (elem->ssign[j]*side->flux_adv_hface[k] >= 0.d0) { // outflow face or bnd face
 7650:                      trsd=0.d0
 7651:                      for (int kk=0; kk<nquad; kk++) {
 7652:                         for (int i=0; i<elem->nweno2; i++) {
 7653:                            trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat2(1:6,i,kk,j),elem->tr_el(m,k,elem->isten2(1:6,i)))
 7654:                         } // end for i   
 7655:                      } // end for kk
 7656:                      trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7657:                   } // outward flux
 7658:                } // end for j=1,i34(ie) ! side
 7659:             }
 7660:          }
 7661:               
 7662: 
 7663: //             elseif((ip_weno==1.or.ip_weno==2).and.nweno1(ie)>0.and.isbe(ie)==0) then !p1 weno method
 7664: //             //   calculate each polynomial's weight 
 7665: //               do m=1,ntr; do k=kbe(ie)+1,nvrt!!!possible optimization
 7666: //                 wm=0.d0; sum1=0.d0
 7667: //                 do i=1,nweno1(ie) !for each polynomial
 7668: //                   b1=dot_product(wts1(:,1,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7669: //                   b2=dot_product(wts1(:,2,i,ie),tr_el(m,k,isten1(1:3,i,ie)))
 7670: //                   b1=b1*b1+b2*b2 !smoothness indicator
 7671: //                   b2=1.d0/((epsilon1+b1)*(epsilon1+b1))
 7672: //                   wm(i)=b2
 7673: //                   sum1=sum1+b2
 7674: //                   !wm(i)=1.d0
 7675: //                   !sum1=sum1+1.d0
 7676: 
 7677: // // Error: PRODUCTION
 7678: // #ifdef DEBUG
 7679: //                   if(.not.(wm(i)>=0.d0.or.wm(i)<0.d0)) then
 7680: //                     write(errmsg,*)'wm(i)=nan',wts1(:,:,i,ie),tr_el(m,k,isten1(1:3,i,ie))
 7681: //                     call parallel_abort(errmsg)
 7682: //                   endif
 7683: // #endif
 7684: 
 7685: //                 enddo !i
 7686: //                 wm=wm/sum1 !final weight
 7687: 
 7688:                 for (int j=0; j<elem->i34; j++) { // side
 7689:                   const Side *side = elem->sides[j];
 7690:                   const Node *node1 = side->n1;
 7691:                   const Node *node2 = side->n2;
 7692: 
 7693:                   if ((elem->ssign[j]*side->flux_adv_hface[k]>=0.d0) .or. side->isbs != 0) {  outflow face or bnd face
 7694:                     trsd=0.d0
 7695:                     for (int kk=0; kk<nquad; kk++) { //1 or 2 quadrature points
 7696:                       for (int i=0; i<elem->nweno1; i++) {
 7697:                         trsd(kk)=trsd(kk)+wm(i)*dot_product(elem->wmat1(1:3,i,kk,j),elem->tr_el(m,k,elem->isten1(1:3,i)))
 7698:                       }
 7699:                     enddo //kk
 7700:                     trsd_tmp(m,k,jsj)=sum(trsd(1:nquad))/real(nquad,rkind) //mean value of the two quadrature points
 7701:                   } // outward flux
 7702:                 } // end for j=1,i34(ie) ! side
 7703:               } // end for k; ntr 
 7704: 
 7705:             else !simple upwind method
 7706:               do j=1,i34(ie)
 7707:                 jsj=elside(j,ie)
 7708:                 n1=isidenode(1,jsj);   n2=isidenode(2,jsj)
 7709:                 do k=kbe(ie)+1,nvrt !!!possible optimization
 7710:                   if(ssign(j,ie)*flux_adv_hface(k,jsj)>=0.d0) then !outflow face
 7711:                     trsd_tmp(:,k,jsj)=tr_el(:,k,ie) 
 7712:                   endif
 7713:                 enddo  !vertical layers
 7714:               enddo !j=1,i34(ie) ! side
 7715:             endif !order of accuracy
 7716: 
 7717:          //  enddo !ie
 7718: // !$OMP     end do
 7719: 
 7720: // !$OMP     master
 7721: //           !message passing
 7722: //           if (nproc>1) then
 7723: //             !make a copy of side concentrations
 7724: //             trsd_tmp0=trsd_tmp 
 7725: 
 7726: //             !this exchange routine swaps interface concentration between two partitions
 7727: //             !trsd_tmp0 receives neighboring info, while trsd_tmp remains the same
 7728: //             call exchange_s3d_tr3(trsd_tmp0,trsd_tmp) 
 7729: 
 7730: //             !Two sets of concentrations: before message-passing (trsd_tmp) and after (trsd_tmp0).
 7731: //             !(1) trsd_tmp0 is the same as trsd_tmp everywhere except on interface sides;
 7732: //             !(2) For an interface side, non-0 concentration can not be present in both trsd_tmp and trsd_tmp0;
 7733: 
 7734: 
 7735: //             !This obtains final values for interface sides
 7736: //             trsd_tmp(:,:,iside_table)= trsd_tmp(:,:,iside_table)+trsd_tmp0(:,:,iside_table)
 7737: //       :    endif !nproc>1
 7738: //           !message passing end
 7739: // !$OMP     end master
 7740: // !$OMP     barrier
 7741: 
 7742: 
 7743: // !         Do advection; conc @ dry elem will not be changed
 7744: // !         Follows the style of explicit TVD, but using WENO correction instead of TVD correction
 7745: // !$OMP     do reduction(+: h_mass_in)
 7746: //           do i=1,ne
 7747: //             if(idry_e(i)==1) cycle
 7748: 
 7749: 
 7750: // !           Wet elements with 3 wet nodes
 7751: //             do k=kbe(i)+1,nvrt
 7752: 
 7753: 
 7754: //               bigv=area(i)*(ze(k,i)-ze(k-1,i)) !volume
 7755: //               dtb_by_bigv = dtb/bigv
 7756:     
 7757: // !             Advective flux
 7758: //               if (ntd_weno==1 .or. itd_weno==1) then
 7759: //                 adv_tr(1:ntr)=trel_tmp(1:ntr,k,i) 
 7760: //               else
 7761: //                 adv_tr(1:ntr)=(1.d0-rk_coef(itd_weno))*trel_tmp0(1:ntr,k,i)+rk_coef(itd_weno)*trel_tmp(1:ntr,k,i) 
 7762: //               endif
 7763: 
 7764: //               !psum=0.d0 !sum of modified fluxes for all inflow bnds
 7765: //               do j=1,i34(i)
 7766: //                 jsj=elside(j,i) !side
 7767: //                 iweno=.true. !use weno reconstruction as default
 7768: //                 iel=ic3(j,i) !neighboring elem
 7769: 
 7770: //                 if(iel/=0) then
 7771: //                   if(idry_e(iel)==1) cycle
 7772: //                   trel_tmp_outside(:)=trel_tmp(:,k,iel)
 7773: //                   !reset to upwind; if Element i uses ELM, it will be overwritten by ELM value eventually
 7774: //                   if(iupwind_e(i)+iupwind_e(iel)>0) then
 7775: //                     iweno=.false.
 7776: //                   endif
 7777: //                 else !land or open bnd side
 7778: //                   !skip land bnd and outflowing open bnd, 
 7779: //                   !in this case iweno is not changed from initial value (.true.), but won't be used
 7780: //                   if(isbs(jsj)<=0.or.k>=kbs(jsj)+1.and.ssign(j,i)*flux_adv_hface(k,jsj)>=0.d0) then
 7781: //                     !For outflow open bnd side, estimate mass in (open
 7782: //                     !side cannot be interface side)
 7783: //                     if(max_iadjust_mass_consv>0.and.isbs(jsj)>0) then !outflow @open bnd
 7784: //                       h_mass_in(:)=h_mass_in(:)-trel_tmp(1:ntr,k,i)*flux_adv_hface(k,jsj)*dtb
 7785: //                     endif
 7786: 
 7787: //                     cycle
 7788: //                   endif
 7789: 
 7790: //                   !Open bnd side with inflow (must be wet elem) or k<kbs(jsj)+1
 7791: //                   iweno=.false.  !reset to upwind
 7792: //                   ibnd=isbs(jsj) !global bnd #
 7793: //                   !Find node indices on bnd segment for the 2 nodes (for type 4 b.c.)
 7794: //                   nwild(1:2)=0
 7795: //                   do ll=1,2 !nodes
 7796: //                     ndo=isidenode(ll,jsj)
 7797: //                     do lll=1,2 !2 possible bnds
 7798: //                       if(isbnd(lll,ndo)==ibnd) then
 7799: //                         nwild(ll)=isbnd(-lll,ndo) !global index
 7800: //                         exit
 7801: //                       endif
 7802: //                     enddo !lll
 7803: //                   enddo !ll
 7804: //                   ind1=nwild(1); ind2=nwild(2);
 7805: 
 7806: //                   do jj=1,natrm
 7807: //                     if(ntrs(jj)<=0) cycle
 7808: 
 7809: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 7810: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7811: //                         trel_tmp_outside(ll)=trel_tmp(ll,k,i)
 7812: //                       enddo !ll
 7813: //                     else if(itrtype(jj,ibnd)==1.or.itrtype(jj,ibnd)==2) then
 7814: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7815: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*trth(ll,1,1,ibnd)+(1-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7816: //                       enddo !ll
 7817: //                     else if(itrtype(jj,ibnd)==3) then
 7818: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7819: //                         tmp=sum(tr_nd0(ll,k,elnode(1:i34(i),i))+tr_nd0(ll,k-1,elnode(1:i34(i),i)))/2.d0/real(i34(i),rkind)
 7820: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)*tmp+(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7821: //                       enddo !ll
 7822: //                     else if(itrtype(jj,ibnd)==4) then
 7823: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
 7824: //                         trel_tmp_outside(ll)=trobc(jj,ibnd)* &
 7825: //        &(trth(ll,k,ind1,ibnd)+trth(ll,k,ind2,ibnd)+trth(ll,k-1,ind1,ibnd)+trth(ll,k-1,ind2,ibnd))/4.d0+ &
 7826: //        &(1.d0-trobc(jj,ibnd))*trel_tmp(ll,k,i)
 7827: //                       enddo !ll
 7828: //                     else
 7829: //                       write(errmsg,*)'TRASNPORT: INVALID VALUE FOR ITRTYPE:',jj,ibnd
 7830: //   !'
 7831: //                       call parallel_abort(errmsg)
 7832: //                     endif !itrtype
 7833: 
 7834: //                   enddo !jj
 7835: 
 7836: //                   !Tally horizontal mass in for inflow case
 7837: //                   if(max_iadjust_mass_consv>0) h_mass_in(:)=h_mass_in(:)-trel_tmp_outside(1:ntr)*flux_adv_hface(k,jsj)*dtb
 7838: //                 endif !iel
