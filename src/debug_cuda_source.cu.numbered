  386: 
  387: struct Frame {
  388:    double _t[9]; // t stands for tensor.
  389: 
  390:    // Access the tensor in Fortran order
  391:    __device__ __forceinline__ double& t(int i, int j) { return _t[i + 3*j]; }
  392: 
  393:    __device__ __forceinline__ double t(int i, int j) const { return _t[i + 3*j]; }
  394: 
  395:    __device__ void update(double ar1, double ar2) { // XXX use lat, lon instead of ar1, ar2?
  396: 
  397:       double sin_ar1, cos_ar1, sin_ar2, cos_ar2;
  398:       sincos(ar1, &sin_ar1, &cos_ar1); // These functions are faster than sin(ar1) and cos(ar1).
  399:       sincos(ar2, &sin_ar2, &cos_ar2);
  400: 
  401:       t(0,0) = -sin_ar1;
  402:       t(1,0) =  cos_ar1;
  403:       t(2,0) =  0.0;
  404:       t(0,1) = -cos_ar1*sin_ar2;
  405:       t(1,1) = -sin_ar1*sin_ar2;
  406: 
  407:       t(2,1) = (rearth_pole/rearth_eq)*cos_ar2;
  408: 
  409:       const double ar4 = sqrt(t(0,1)*t(0,1) + t(1,1)*t(1,1) + t(2,1)*t(2,1));
  410:       assert (ar4!=0.0 && "GRID: ar4=0");
  411: 
  412:       const double ar4_inv = 1.0/ar4;
  413:       t(0,1) = t(0,1)*ar4_inv;
  414:       t(1,1) = t(1,1)*ar4_inv;
  415:       t(2,1) = t(2,1)*ar4_inv;
  416: 
  417:       // The third vector is the cross product of the first two
  418:       crossProduct(t(0,0), t(1,0), t(2,0), 
  419:                    t(0,1), t(1,1), t(2,1), 
  420:                    t(0,2), t(1,2), t(2,2));
  421:    }
  422: 
  423: 
  424:    __forceinline__ __device__ Vector2 project_hvec(Vector2 const &vec0, Frame const &frameout) const {
  425:    // Do plane rotation of a vector (i.e., assuming z-axes are same)
  426:    // Inputs:
  427:    //        vec0: vel. in this frame;
  428:    //        frameout: Output frame;
  429:    // Output: 
  430:    //        vec1: vel. in new frame  
  431: 
  432:       auto const fo = frameout;
  433:       Vector2 vec1;
  434: 
  435:       // Since frame tensors are orthogonal, the transpose is the inverse. That's why the indices
  436:       // of t and fo.t are the same.
  437:       vec1.x = vec0.x*(t(0,0)*fo.t(0,0) + t(1,0)*fo.t(1,0) + t(2,0)*fo.t(2,0)) +
  438:                vec0.y*(t(0,1)*fo.t(0,0) + t(1,1)*fo.t(1,0) + t(2,1)*fo.t(2,0));
  439: 
  440:       vec1.y = vec0.x*(t(0,0)*fo.t(0,1) + t(1,0)*fo.t(1,1) + t(2,0)*fo.t(2,1)) +
  441:                vec0.y*(t(0,1)*fo.t(0,1) + t(1,1)*fo.t(1,1) + t(2,1)*fo.t(2,1));
  442: 
  443:       return vec1;
  444:    }
  445: 
  446:    __forceinline__ __device__ void G2L(Vector3 const &vi, Vector3 &vo) const {
  447:       // Transform a vector from global to local frame
  448:       vo.x = vi.x*t(0,0) + vi.y*t(1,0) + vi.z*t(2,0);
  449:       vo.y = vi.x*t(0,1) + vi.y*t(1,1) + vi.z*t(2,1);
  450:       vo.z = vi.x*t(0,2) + vi.y*t(1,2) + vi.z*t(2,2);
  451:    }
  452: 
  453:    __forceinline__ __device__ void L2G(Vector3 const &vi, Vector3 &vo) const {
  454:       // Transform a vector from local to global frame
  455:       vo.x = vi.x*t(0,0) + vi.y*t(0,1) + vi.z*t(0,2);
  456:       vo.y = vi.x*t(1,0) + vi.y*t(1,1) + vi.z*t(1,2);
  457:       vo.z = vi.x*t(2,0) + vi.y*t(2,1) + vi.z*t(2,2);
  458:    }   
  459: 
  460:    __forceinline__ __device__ void G2L(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  461:    // Tranforms a point from global to local frame     
  462:       G2L(pi - origin0, po);
  463:    }
  464: 
  465:    __forceinline__ __device__ void L2G(Point3 const &pi, Point3 const &origin0, Point3 &po) const {
  466:    // Transforms a point from local to global frame      
  467:       L2G(pi, po);
  468:       po = po + origin0;
  469:    }
  470: 
  471: };
