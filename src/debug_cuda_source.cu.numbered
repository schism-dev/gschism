 6927: 
 6928: //                   do jj=1,natrm
 6929: //                     if(ntrs(jj)<=0) cycle
 6930: 
 6931: //                     if(itrtype(jj,ibnd)==0) then !set to be same as interior (so cancel out below)
 6932: //                       do ll=irange_tr(1,jj),irange_tr(2,jj)
