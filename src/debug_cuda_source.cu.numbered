 2119: 
 2120: __inline__ __device__ Point2 Element::outputCoords(void) const {
 2121:    if constexpr(ics == 1)  {
 2122:       return center;
 2123: 
 2124:    } else {
 2125:       const Point2 p0 = nodes[0]->outputCoords();
 2126:       const Point2 p1 = nodes[1]->outputCoords();
 2127:       const Point2 p2 = nodes[2]->outputCoords();
 2128: 
 2129:       if (isTri()) {
 2130:          return (1.0/3.0)*(p0 + p1 + p2);
 2131: 
 2132:       } else {
 2133:          const Point2 p3 = nodes[3]->outputCoords();
 2134:          return (1.0/4.0)*(p0 + p1 + p2 + p3);
 2135:       }
 2136: 
 2137:    }
 2138: }
 2139: 
 2140: 
 2141: __device__ __forceinline__ double Element::centerZ(void) const { 
 2142: // Z coordinate of the element center in the global cartesian coordinates.
 2143: // This works because we also compute the average of the x,y coordinates of the nodes to compute the 3D center.
 2144: 
 2145:    if constexpr(ics==1) { 
 2146:       return 0.0; 
 2147: 
 2148:    } else { 
 2149: 
 2150:       if (isTri())  return (1.0/3.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz);
 2151:       else          return (1.0/4.0)*(nodes[0]->gz + nodes[1]->gz + nodes[2]->gz + nodes[3]->gz);
 2152:    } 
 2153: }
