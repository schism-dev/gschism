 4221:    __global__ void scaleGravity(double loadtide_coef) {
 4222: 
 4223: 
 4224:       NODE(node);
 4225: 
 4226:       // SAL option: scale gravity
 4227:       if constexpr(iloadtide==2) {  // simple const
 4228:          node->grav2 = grav*(1.0 - loadtide_coef);
 4229: 
 4230:       } else if constexpr(iloadtide==3) {  // Stepanov & Hughes (2004)
 4231:         
 4232:           const double depth = max(node->depth, 0.0);
 4233:           const double tmp1 = sqrt(depth);
 4234:           double beta_bar = -9.8169e-3 + 1.8289e-3*tmp1 + 4.3787e-4*depth - 2.9042e-5*depth*tmp1 + 
 4235:                              6.6038e-7*depth*depth - 4.7393e-9*depth*depth*tmp1 - 1.9354e-11*depth*depth*depth + 
 4236:                              2.6969e-13*depth*depth*depth*tmp1;
 4237:           
 4238:           beta_bar=max(0.0, min(loadtide_coef, beta_bar));
 4239:           
 4240: 
 4241: 
 4242:           node->grav2 = grav*(1.0 - beta_bar);
 4243: 
 4244:       } else {  // iloadtide=0,1
 4245:         node->grav2=grav;
 4246: 
 4247:       }
 4248: 
 4249:    }
 4250: 
