 7440:       // case (int)VarCode::depth:
 7441:       //    *offset = (int)((char*)&sides[0].depth - (char*)sides);
 7442:       //    *sizeType = sizeof(double);
 7443:       //    break;         
 7444:       case (int)VarCode::x:
 7445:          *offset = (int)((char*)&sides[0].center.x - (char*)sides);
