 2600:    template<typename T>
 2601:    __device__ __forceinline__ T Element::mean(int level,  T (Side::*func)(int) const) const {
 2602: 
 2603:       T values[4];
 2604: 
 2605: 
 2606:       values[0] = (sides[0]->*func)(max(level, sides[0]->kb));
 2607:       values[1] = (sides[1]->*func)(max(level, sides[1]->kb));
 2608:       values[2] = (sides[2]->*func)(max(level, sides[2]->kb));
 2609:       if (isQuad()) values[3] = (sides[3]->*func)(max(level, sides[3]->kb));
 2610:       else          values[3] = T();
 2611: 
 2612:       if constexpr (IsVector2<T>::value && ics == 2) projectSideVectorsToElementFrame(values);
 2613: 
 2614:       return (values[0] + values[1] + values[2] + values[3])/i34;
 2615:    }
