 9061: extern "C" __global__ void populateSides(int *i34, int *sharedIdxSideBoundary,
 9062:                                          double *node_coords, double *node_coords_ll, bool use_ll,
 9063:                                          double *wind_rotate_angle,   
 9064:                                          int *isdel, int *isidenode, int *isbnd,
 9065:                                          int *nond, int *nlnd, int *iond, int *ilnd,                                  
 9066:                                          int *nodeNeighNodesStart, int *nodeNeighNodesIndices,
 9067:                                          int *nodeNeighElemsStart, int *nodeNeighElemsIndices,
 9068:                                          int *globalNodeIndices, int *globalElemIndices, int *globalSideIndices,
 9069:                                          int *localNodeIndices,  int *localElemIndices,  int *localSideIndices,
 9070:                                          int *localNodePart,     int *localElemPart,     int *localSidePart,
 9071:                                          double *drag, double *roughness) {
 9072:    mesh->populateSides(i34, sharedIdxSideBoundary,
 9073:                        node_coords, node_coords_ll, use_ll,
 9074:                        wind_rotate_angle,   
 9075:                        isdel, isidenode, isbnd,
 9076:                        nond, nlnd, iond, ilnd,                                  
